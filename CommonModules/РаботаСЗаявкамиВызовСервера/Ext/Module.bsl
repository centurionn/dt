//БИТ Белинский Д.А. 11.04.2023 -начало
Функция ЭтоЗаявкаНаАвтоРейс(Заявка) Экспорт
	
	Результат = Ложь;
	
	ЕстьАвтоРейсы = Ложь;
	ЕстьДругиеРейсы = Ложь;
	
	Для Каждого СтрокаРейс Из Заявка.ПереченьРейсов Цикл
		Если ТипЗнч(СтрокаРейс.Рейс) = Тип("СправочникСсылка.РейсыАвто") Тогда
			ЕстьАвтоРейсы = Истина;
		Иначе     
			ЕстьДругиеРейсы = Истина;
			Прервать;	
		КонецЕсли;
	КонецЦикла;       
	
	Если ЕстьАвтоРейсы И Не ЕстьДругиеРейсы Тогда
		Результат = Истина;
	КонецЕсли;  
	
	Возврат Результат;
	
КонецФункции
//БИТ Белинский Д.А. 11.04.2023 -начало

// Евросиб(ДИТ) BUG 95213 ТА 95214 Сержантова А.С. 17.12.2024    
//ДатаВозвратаКлиентом берется из поля ДатаСдачиКТКНаТерминал по первой миле при выполнении следующих условий:
//1. Если заявка служебная (Контрагент ДКП и создана изначально из ПСЦ и Калькуляции с видом "Межсервисные расходы"
//2. Если в такой Заявке для конкретного КТК есть авторейс по Первой Миле
//3. Если для такого КТК при этом нет авторейса по Последней миле
//4. Если для такого КТК в Заявке нет ЖД или Морского рейса, где есть данный контейнер 
//(Состав рейса и состав Коносамента, связанного с Морским рейсом)
Функция Проверка_ДатаВозвратаИзПервойМили(Контейнер, ЗаявкаСсылка) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Заявка.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_ПроверкаЗаявки
		|ИЗ
		|	Документ.Заявка КАК Заявка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПСЦ КАК ПСЦДокумент
		|		ПО Заявка.ПСЦ = ПСЦДокумент.Ссылка
		|ГДЕ
		|	Заявка.Ссылка = &Заявка
		|	И Заявка.Контрагент = &КонтрагентДКП
		|	И ПСЦДокумент.ТипКалькуляции В(&МежсервисныеРасходы)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаявкаПереченьРейсов.Рейс КАК Рейс,
		|	ЗаявкаПереченьРейсов.Ссылка КАК Заявка
		|ПОМЕСТИТЬ ВТ_РейсыЗаявки
		|ИЗ
		|	Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
		|ГДЕ
		|	ЗаявкаПереченьРейсов.Ссылка = &Заявка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗапросНаАвтоперевозкуКонтейнеры.Ссылка.Заявка КАК Заявка,
		|	ЗапросНаАвтоперевозкуКонтейнеры.Ссылка КАК ЗапросНаАвто
		|ПОМЕСТИТЬ ВТ_ПроверкаПерваяМиля
		|ИЗ
		|	Документ.ЗапросНаАвтоперевозку.Контейнеры КАК ЗапросНаАвтоперевозкуКонтейнеры
		|ГДЕ
		|	ЗапросНаАвтоперевозкуКонтейнеры.Ссылка.Заявка = &Заявка
		|	И ЗапросНаАвтоперевозкуКонтейнеры.РейсАвто В
		|			(ВЫБРАТЬ
		|				Т.Рейс
		|			ИЗ
		|				ВТ_РейсыЗаявки КАК Т)
		|	И ЗапросНаАвтоперевозкуКонтейнеры.КлючАналитикиПеревозки.Контейнер = &Контейнер
		|	И ЗапросНаАвтоперевозкуКонтейнеры.Ссылка.ЭтапПеревозки = ЗНАЧЕНИЕ(Перечисление.ЭтапыПеревозки.ПерваяМиля)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗапросНаАвтоперевозкуКонтейнеры.Ссылка.Заявка КАК Заявка,
		|	ЗапросНаАвтоперевозкуКонтейнеры.Ссылка КАК ЗапросНаАвто,
		|	ЗапросНаАвтоперевозкуКонтейнеры.РейсАвто КАК РейсАвто
		|ПОМЕСТИТЬ ВТ_ПроверкаПоследняяМиля
		|ИЗ
		|	Документ.ЗапросНаАвтоперевозку.Контейнеры КАК ЗапросНаАвтоперевозкуКонтейнеры
		|ГДЕ
		|	ЗапросНаАвтоперевозкуКонтейнеры.Ссылка.Заявка = &Заявка
		|	И ЗапросНаАвтоперевозкуКонтейнеры.КлючАналитикиПеревозки.Контейнер = &Контейнер
		|	И ЗапросНаАвтоперевозкуКонтейнеры.Ссылка.ЭтапПеревозки = ЗНАЧЕНИЕ(Перечисление.ЭтапыПеревозки.ПоследняяМиля)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ 
		|	ЕСТЬNULL(РейсыЖДФактическийСоставПоезда.Ссылка, ЗНАЧЕНИЕ(Справочник.РейсыЖД.ПустаяСсылка)) КАК РейсЖД_Море,
		|	ВТ_РейсыЗаявки.Заявка КАК Заявка,
		|	ЕСТЬNULL(ТЕ.Ссылка, ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)) КАК Контейнер
		|ПОМЕСТИТЬ ВТ_ПроверкаЖДиМорскихРейсов
		|ИЗ
		|	ВТ_РейсыЗаявки КАК ВТ_РейсыЗаявки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РейсыЖД.ФактическийСоставПоезда КАК РейсыЖДФактическийСоставПоезда
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТЕ КАК ТЕ
		|			ПО (ТЕ.Наименование = РейсыЖДФактическийСоставПоезда.НомерКонтейнера)
		|				И (ТЕ.Ссылка = &Контейнер)
		|		ПО ВТ_РейсыЗаявки.Рейс = РейсыЖДФактическийСоставПоезда.Ссылка
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ 
		|	ЕСТЬNULL(РеестрКонтейнеров.Ссылка, ЗНАЧЕНИЕ(Справочник.РейсыЖД.ПустаяСсылка)),
		|	ВТ_РейсыЗаявки.Заявка,
		|	ЕСТЬNULL(ТЕ.Ссылка, ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка))
		|ИЗ
		|	ВТ_РейсыЗаявки КАК ВТ_РейсыЗаявки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РейсыЖД.РеестрКонтейнеров КАК РеестрКонтейнеров
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТЕ КАК ТЕ
		|			ПО (ТЕ.Наименование = РеестрКонтейнеров.НомерКонтейнера)
		|				И (ТЕ.Ссылка = &Контейнер)
		|		ПО ВТ_РейсыЗаявки.Рейс = РеестрКонтейнеров.Ссылка
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ТранспортныйДокумент.Ссылка, ЗНАЧЕНИЕ(Справочник.РейсыЖД.ПустаяСсылка)),
		|	ВТ_РейсыЗаявки.Заявка,
		|	ЕСТЬNULL(ТранспортныйДокументКоносаменты.НомерКТК, ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка))
		|ИЗ
		|	ВТ_РейсыЗаявки КАК ВТ_РейсыЗаявки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент.Коносаменты КАК ТранспортныйДокументКоносаменты
		|			ПО ТранспортныйДокумент.Ссылка = ТранспортныйДокументКоносаменты.Ссылка
		|				И (ТранспортныйДокументКоносаменты.НомерКТК = &Контейнер)
		|		ПО (ТранспортныйДокумент.МорскойРейс = ВТ_РейсыЗаявки.Рейс)
		|			И (ТранспортныйДокумент.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийТранспортныхДокументов.Коносамент))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ПроверкаЗаявки.Ссылка КАК Ссылка
		|ИЗ
		|	ВТ_ПроверкаЗаявки КАК ВТ_ПроверкаЗаявки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПроверкаПерваяМиля КАК ВТ_ПроверкаПерваяМиля
		|		ПО ВТ_ПроверкаЗаявки.Ссылка = ВТ_ПроверкаПерваяМиля.Заявка
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПроверкаПоследняяМиля КАК ВТ_ПроверкаПоследняяМиля
		|		ПО ВТ_ПроверкаЗаявки.Ссылка = ВТ_ПроверкаПоследняяМиля.Заявка
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПроверкаЖДиМорскихРейсов КАК ВТ_ПроверкаЖДиМорскихРейсов
		|		ПО ВТ_ПроверкаЗаявки.Ссылка = ВТ_ПроверкаЖДиМорскихРейсов.Заявка
		|			И (ВТ_ПроверкаЖДиМорскихРейсов.РейсЖД_Море <> ЗНАЧЕНИЕ(Справочник.РейсыЖД.ПустаяСсылка))
		|ГДЕ
		|	ЕСТЬNULL(ВТ_ПроверкаПерваяМиля.ЗапросНаАвто, ЗНАЧЕНИЕ(Документ.ЗапросНаАвтоперевозку.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Документ.ЗапросНаАвтоперевозку.ПустаяСсылка)
		|	И ЕСТЬNULL(ВТ_ПроверкаПоследняяМиля.РейсАвто, ЗНАЧЕНИЕ(Справочник.РейсыАвто.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.РейсыАвто.ПустаяСсылка)
		|	И ЕСТЬNULL(ВТ_ПроверкаЖДиМорскихРейсов.Контейнер, ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("Заявка", ЗаявкаСсылка);
	Запрос.УстановитьПараметр("Контейнер", Контейнер);  
	
	ТипыКалькуляцийМежсервисныеРасходы = Новый Массив;
	ТипыКалькуляцийМежсервисныеРасходы.Добавить(Перечисления.ТипыКалькуляций.МежсервисныеРасходы);
	ТипыКалькуляцийМежсервисныеРасходы.Добавить(Перечисления.ТипыКалькуляций.МежсервисныеРасходыРеф);
	Запрос.УстановитьПараметр("МежсервисныеРасходы", ТипыКалькуляцийМежсервисныеРасходы);  
	
	КонтрагентДКП = ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьЗначениеКонстанты("КонтрагентДирекцияКонтейнерныхПеревозок");
	Запрос.УстановитьПараметр("КонтрагентДКП", КонтрагентДКП);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если не РезультатЗапроса.Пустой() Тогда
		Возврат Истина;
	Иначе	
	    Возврат Ложь;
	КонецЕсли;	

КонецФункции 
