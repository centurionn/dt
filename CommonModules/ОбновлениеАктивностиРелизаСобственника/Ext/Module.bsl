Процедура ОбновитьАктивностьРелизаСобственника() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РелизСобственника.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РелизСобственника КАК РелизСобственника
	|ГДЕ
	|	РелизСобственника.Проведен
	|	И РелизСобственника.Активность = ЗНАЧЕНИЕ(Перечисление.СтатусАктивностиРелиза.Активен)
	|	И РелизСобственника.ОкончаниеДействия <= &ТекущаяДата"; 
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда   
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл 
			
			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			Если ДокОбъект.Реализованность = ПредопределенноеЗначение("Перечисление.СтатусыЗаполненностиРелиза.Открыт") Тогда
				ДокОбъект.Активность = ПредопределенноеЗначение("Перечисление.СтатусАктивностиРелиза.Просрочен");
			Иначе
				ДокОбъект.Активность = ПредопределенноеЗначение("Перечисление.СтатусАктивностиРелиза.Закрыт");
			КонецЕсли;
			
			Попытка  
				ДокОбъект.Записать();	
			Исключение    
				
			КонецПопытки;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры 	//ДИТ Авдеева В.С. 48934 21.04.2022 Конец
