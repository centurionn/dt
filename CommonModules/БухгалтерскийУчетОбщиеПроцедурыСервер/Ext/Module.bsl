			СтрокаМоре.ПортПогрузки = СтрокаРасшифровки.Коносамент.СтанцияОтправления;
			СтрокаМоре.СтранаПогрузки = СтрокаРасшифровки.Коносамент.СтанцияОтправления.Страна;
