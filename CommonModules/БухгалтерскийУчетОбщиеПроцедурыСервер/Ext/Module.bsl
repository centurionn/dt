		СтруктураПодписантов.Вставить("ЗаРуководителя", ЗаРуководителя.ПодписантРуководитель);
		СтруктураПодписантов.Вставить("ДолжностьЗаРуководителя", ЗаРуководителя.ДолжностьЗаРуководителя);
		СтруктураПодписантов.Вставить("ОснованиеНаРук", ЗаРуководителя.ОснованиеЗаРуководителя);
	КонецЕсли;
	
	Если ЗаГлБух.Следующий() Тогда
