//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 112113 15.05.2025  //US 90779 ТА 114194 + ИзменятьТипСФ   
Процедура ЗаполнитьТаблицыЧастичногоПодтвержденияНДС0(СчФ, ДанныеЗаполненияСсылка, ИзменятьТипСФ = Истина) Экспорт

	//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 114194 Начало 17.07.2025  
	//Счф.Фрахт = Ложь;
	Если  ИзменятьТипСФ = Истина Тогда
		Счф.Фрахт = Ложь;
	КонецЕсли;
	//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 114194 Конец 17.07.2025
	УслугаФрахт = Константы.УслугаФрахтаДляКалькуляции.Получить();
	
	РаспределяемаяСуммаСФ = СчФ.СуммаДокумента; 
	Если ТипЗнч(ДанныеЗаполненияСсылка) = Тип("ДокументСсылка.КорректировкаРеализации") 
		и ДанныеЗаполненияСсылка.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение Тогда  
		//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 114194 Начало 22.07.2025
		//РаспределяемаяСуммаСФ = СчФ.СуммаУвеличение - СчФ.СуммаУменьшение;
		Если СчФ.ДокументыОснования.Количество() > 0 Тогда
			РаспределяемаяСуммаСФ = СчФ.ДокументыОснования[0].СуммаУвеличение - СчФ.ДокументыОснования[0].СуммаУменьшение;
		КонецЕсли;	
		//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 114194 Конец 22.07.2025
	КонецЕсли; 
	
	КоэффициентыРаспределения = Новый Массив;
	СтрокиРаспределения = Новый Массив; 
	
	//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 114194 Начало 22.07.2025
	ПодтверждающиеДокументыЗаполнение = СчФ.ПодтверждающиеДокументы.Выгрузить();
	ПодтверждающиеДокументыЗаполнение.Очистить();  
	МорскойТранспортЗаполнение = СчФ.МорскойТранспорт.Выгрузить();
	МорскойТранспортЗаполнение.Очистить();
	//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 114194 Конец 22.07.2025
	
	Для каждого СтрокаРасшифровки Из ДанныеЗаполненияСсылка.РасшифровкаУслугПоТС Цикл
	
		Если СтрокаРасшифровки.Сумма <= 0 Тогда
			Продолжить;
		КонецЕсли;  
		
		СтруктураПоиска = Новый Структура("ЖДН, Вагон, Контейнер");
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаРасшифровки);
		СтрокиПодтверждающихДокументов = ПодтверждающиеДокументыЗаполнение.НайтиСтроки(СтруктураПоиска);
		Если СтрокиПодтверждающихДокументов.Количество() > 0 Тогда    
			СтрокаЖДН = СтрокиПодтверждающихДокументов[0];  
			//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 114194 Начало 22.07.2025
			КлючСтроки = СтрокаЖДН.КлючСтроки;
			//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 114194 Конец 22.07.2025
		Иначе     
			СтрокаЖДН = ПодтверждающиеДокументыЗаполнение.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаЖДН, СтрокаРасшифровки);
			КлючСтроки = Новый УникальныйИдентификатор;
			СтрокаЖДН.КлючСтроки = КлючСтроки;          
			
			//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 114194 Начало 17.07.2025
			//СчФ.ВидПеревозки = СтрокаРасшифровки.ВидПеревозки;
			//СчФ.Фрахт = СчФ.Фрахт ИЛИ СтрокаРасшифровки.Услуга = УслугаФрахт;
			Если  ИзменятьТипСФ = Истина Тогда                        
				СчФ.ВидПеревозки = СтрокаРасшифровки.ВидПеревозки;
				СчФ.Фрахт = СчФ.Фрахт ИЛИ СтрокаРасшифровки.Услуга = УслугаФрахт;
			КонецЕсли;
			//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 114194 Конец 17.07.2025
			
			Если СтрокаРасшифровки.ВидПеревозки = Справочники.ВидыПеревозок.Транзит Тогда
				СтрокаЖДН.ВходнаяСтанция = ?(ЗначениеЗаполнено(СтрокаЖДН.ЖДН), СтрокаЖДН.ЖДН.СтанцияОтправления, Неопределено);
				СтрокаЖДН.ВыходнаяСтанция = ?(ЗначениеЗаполнено(СтрокаЖДН.ЖДН), СтрокаЖДН.ЖДН.СтанцияНазначения, Неопределено);
			Иначе	
				Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Сделка", СчФ.ДокументОснование.Метаданные()) 
										И ЗначениеЗаполнено(СчФ.ДокументОснование.Сделка) 
										И ТипЗнч(СчФ.ДокументОснование.Сделка) = Тип("ДокументСсылка.Сделка") Тогда
					СтрокаЖДН.СтанцияНазначения = ?(ЗначениеЗаполнено(СчФ.ДокументОснование.Сделка), СчФ.ДокументОснование.Сделка.СтанцияНазначения, Неопределено);
					СтрокаЖДН.СтанцияОтправления = ?(ЗначениеЗаполнено(СчФ.ДокументОснование.Сделка), СчФ.ДокументОснование.Сделка.СтанцияОтправления, Неопределено);
				КонецЕсли;
				СтрокаЖДН.СтранаНазначения = ?(ЗначениеЗаполнено(СтрокаЖДН.СтанцияНазначения), СтрокаЖДН.СтанцияНазначения.Страна, ?(СтрокаРасшифровки.ВидПеревозки = Справочники.ВидыПеревозок.Импорт Или СтрокаРасшифровки.ВидПеревозки = Справочники.ВидыПеревозок.ИмпортМоре, Справочники.СтраныМира.Россия, Неопределено));	
				СтрокаЖДН.СтранаОтправления = ?(ЗначениеЗаполнено(СтрокаЖДН.СтанцияОтправления), СтрокаЖДН.СтанцияОтправления.Страна, ?(СтрокаРасшифровки.ВидПеревозки = Справочники.ВидыПеревозок.Экспорт Или СтрокаРасшифровки.ВидПеревозки = Справочники.ВидыПеревозок.ЭкспортМоре, Справочники.СтраныМира.Россия, Неопределено));
			КонецЕсли;
			Если ТипЗнч(СтрокаЖДН.ЖДН) = Тип("ДокументСсылка.ТранспортныйДокумент") Тогда
				Если СтрокаЖДН.ЖДН.ВидОперации = Перечисления.ВидыОперацийТранспортныхДокументов.ЖДНакладная Тогда
					Если СтрокаЖДН.ЖДН.НакладнаяЭТРАН.ГрузыЖД.Количество()>0 Тогда
						СтрокаЖДН.НомерГТД = СтрокаЖДН.ЖДН.НакладнаяЭТРАН.ГрузыЖД[0].НомерГТД;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;    
		
		//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 114194 Начало 22.07.2025
		КоэффициентыРаспределения.Добавить(СтрокаРасшифровки.Сумма);
		СтрокиРаспределения.Добавить(Строка(КлючСтроки));
		//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 114194 Конец 22.07.2025
		
		Если ЗначениеЗаполнено(СтрокаРасшифровки.Коносамент) Тогда 
			СтруктураПоиска = Новый Структура("Коносамент, КлючСтроки");
			СтруктураПоиска.Коносамент = СтрокаРасшифровки.Коносамент;
			СтруктураПоиска.КлючСтроки = СтрокаЖДН.КлючСтроки;
			Если МорскойТранспортЗаполнение.НайтиСтроки(СтруктураПоиска).Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;

			СтрокаЖДН.Транспорт = 1;
			СтрокаМоре = МорскойТранспортЗаполнение.Добавить();
			СтрокаМоре.КлючСтроки = СтрокаЖДН.КлючСтроки;
			СтрокаМоре.Коносамент = СтрокаРасшифровки.Коносамент;  
			СтрокаМоре.Контейнер = СтрокаЖДН.Контейнер;
			СтрокаМоре.НомерДокумента = СтрокаРасшифровки.Коносамент.НомерТранспортногоДокумента;
			СтрокаМоре.ДатаДокумента = СтрокаРасшифровки.Коносамент.ДатаТранспортногоДокумента;
			СтрокаМоре.Судно = СтрокаРасшифровки.Коносамент.МорскойРейс.Судно;
			СтрокаМоре.ПортРазгрузки = СтрокаРасшифровки.Коносамент.СтанцияНазначения;
			СтрокаМоре.СтранаРазгрузки = СтрокаРасшифровки.Коносамент.СтанцияНазначения.Страна;
			СтрокаМоре.ПортПогрузки = СтрокаРасшифровки.Коносамент.СтанцияОтправления;
			СтрокаМоре.СтранаПогрузки = СтрокаРасшифровки.Коносамент.СтанцияОтправления.Страна;
		КонецЕсли;
	
	КонецЦикла;
	
	МассивРезультатРаспределения = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(РаспределяемаяСуммаСФ, КоэффициентыРаспределения);
	Если МассивРезультатРаспределения <> Неопределено Тогда    
		СчетчикСтрок = 0;
		Для каждого КлючСтроки Из СтрокиРаспределения Цикл 
			
			СуммаПоКТК = МассивРезультатРаспределения[СчетчикСтрок];
			
			СтрокаПоКлючу = ПодтверждающиеДокументыЗаполнение.Найти(КлючСтроки, "КлючСтроки");
			//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 114194  Начало 22.07.2025
			//СтрокаПоКлючу.СуммаПоКТК = СуммаПоКТК;
			СтрокаПоКлючу.СуммаПоКТК = СтрокаПоКлючу.СуммаПоКТК + СуммаПоКТК;
			//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 114194  Конец 22.07.2025
			
			СтрокиМорскогоТранспорта = МорскойТранспортЗаполнение.НайтиСтроки(Новый Структура("КлючСтроки", КлючСтроки));  
			КолвоСтрок = СтрокиМорскогоТранспорта.Количество();
			НомерСтроки = 1;
			Для каждого СтрМорскТрансп Из СтрокиМорскогоТранспорта Цикл
				
				Если НомерСтроки = КолвоСтрок Тогда
					СтрМорскТрансп.СуммаПоКТК = СтрокаПоКлючу.СуммаПоКТК - (Окр(СтрокаПоКлючу.СуммаПоКТК / КолвоСтрок, 2))*(КолвоСтрок-1);
				Иначе
					СтрМорскТрансп.СуммаПоКТК = Окр(СтрокаПоКлючу.СуммаПоКТК / КолвоСтрок, 2);
				КонецЕсли;
				
				НомерСтроки = НомерСтроки + 1;
			КонецЦикла;
			
			СчетчикСтрок = СчетчикСтрок + 1;
		
		КонецЦикла;	
	КонецЕсли;  
	
	//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 114194 Начало 22.07.2025
	Для каждого стрГТД Из ПодтверждающиеДокументыЗаполнение Цикл
		НС = СчФ.ПодтверждающиеДокументы.Добавить();	
		ЗаполнитьЗначенияСвойств(НС, стрГТД);
	КонецЦикла; 
	
	Для каждого стрФрахт Из МорскойТранспортЗаполнение Цикл
		НС = СчФ.МорскойТранспорт.Добавить();	
		ЗаполнитьЗначенияСвойств(НС, стрФрахт);
	КонецЦикла;   
	
	Если СчФ.Фрахт и СчФ.МорскойТранспорт.Количество() > 0 
		и СчФ.МорскойТранспорт.Итог("СуммаПоКТК") <> РаспределяемаяСуммаСФ Тогда
		РазницаСумм = РаспределяемаяСуммаСФ - СчФ.МорскойТранспорт.Итог("СуммаПоКТК");  
		СтрокаКорректировки = СчФ.МорскойТранспорт[0];
		СтрокаКорректировки.СуммаПоКТК = СтрокаКорректировки.СуммаПоКТК + РазницаСумм;
	ИначеЕсли не СчФ.Фрахт и не СчФ.Авто и СчФ.ПодтверждающиеДокументы.Количество() > 0 
		и СчФ.ПодтверждающиеДокументы.Итог("СуммаПоКТК") <> РаспределяемаяСуммаСФ Тогда	
		РазницаСумм = РаспределяемаяСуммаСФ - СчФ.ПодтверждающиеДокументы.Итог("СуммаПоКТК");  
		СтрокаКорректировки = СчФ.ПодтверждающиеДокументы[0];
		СтрокаКорректировки.СуммаПоКТК = СтрокаКорректировки.СуммаПоКТК + РазницаСумм;
	КонецЕсли;
	//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 114194 Конец 22.07.2025
	
КонецПроцедуры

//++ДИТ_Коробов_Task 46790_24.02.22
Процедура ИСФАктуализацияВыгрузкиДляФНС(ДокОбъект = Неопределено, СтатусДействие = "НоваяИСФ", ИСФ = Неопределено) Экспорт
	
	Если ДокОбъект = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	Если Нрег(СтатусДействие) = Нрег("НоваяИСФ") Тогда 
		ПодчиненнаяИСФ = НайтиПодчиненныйСчетФактуру(ДокОбъект.ДокументРеализации);
		Если НЕ ЗначениеЗаполнено(ПодчиненнаяИСФ) Тогда 
			Возврат;
		КонецЕсли;
		Если ПодчиненнаяИСФ.Фрахт Тогда
			ИСФ.Фрахт = Истина;	
		КонецЕсли;  
		// Евросиб(ДИТ) US 90779 ТА 99010 Сержантова А.С. Начало: 09.01.2025
		// Реквизиты перенесены в ТЧ по ГТД, таблицы скопированы ранее
		// Было:
		//Если ПодчиненнаяИСФ.УдалитьВключатьВОтчетДляФНС Тогда 
		//	ИСФ.УдалитьВключатьВОтчетДляФНС = Истина;
		//	ИСФ.УдалитьДатаПолногоПодтвержденияНДС0 = ПодчиненнаяИСФ.УдалитьДатаПолногоПодтвержденияНДС0;
		//	ИСФ.УдалитьДатаОтчетаДляФНС = ПодчиненнаяИСФ.УдалитьДатаОтчетаДляФНС;
		//	Если ДокОбъект.ВидОперации <> Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение Тогда
		//		УправлениеВыгрузкойДляФНС(ПодчиненнаяИСФ, Ложь, Истина);
		//	Иначе
		//		ИСФ.УдалитьДатаПолногоПодтвержденияНДС0 = ТекущаяДата();	
		//	КонецЕсли; 
		//КонецЕсли; 
		//Стало:
		Если ДокОбъект.ВидОперации <> Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение Тогда
			УправлениеВыгрузкойДляФНС(ПодчиненнаяИСФ, Ложь, Истина);
		Иначе   
			Для каждого СтрПодтверждающихДок Из ИСФ.ПодтверждающиеДокументы Цикл
				СтрПодтверждающихДок.ДатаПодтвержденияНДС0 = ТекущаяДата();
			КонецЦикла;
			Для каждого СтрМорскойТранспорт Из ИСФ.МорскойТранспорт Цикл
				СтрМорскойТранспорт.ДатаПодтвержденияНДС0 = ТекущаяДата();
			КонецЦикла;	
		КонецЕсли;
		// Евросиб(ДИТ) US 90779 ТА 99010 Сержантова А.С. Конец: 09.01.2025
		
	ИначеЕсли Нрег(СтатусДействие) = Нрег("УдалитьИСФ") Тогда
		УправлениеВыгрузкойДляФНС(НайтиПодчиненныйСчетФактуру(ДокОбъект.ДокументРеализации), Истина, Ложь);
		УправлениеВыгрузкойДляФНС(НайтиПодчиненныйСчетФактуру(ДокОбъект), Ложь, Ложь);
	ИначеЕсли Нрег(СтатусДействие) = Нрег("ВыключитьОтчетФНСДляВсехИСФ") Тогда
		СписокРТУ = Новый Массив;
		СписокРТУ.Добавить(ДокОбъект);
		ДокРеализации = ДокОбъект;
		Если НЕ ЗначениеЗаполнено(ДокРеализации) Тогда 
			Возврат;	
		КонецЕсли;	 
		Пока Истина Цикл		
			ДокРеализации = ДокРеализации.ДокументРеализации;
			УправлениеВыгрузкойДляФНС(НайтиПодчиненныйСчетФактуру(ДокРеализации), Ложь, Истина);
			ОтключитьОтчетФНСДляВсехПодчиненныхИСФ(ДокРеализации, СписокРТУ);
			Если ТипЗнч(ДокРеализации)<>Тип("ДокументСсылка.КорректировкаРеализации")
				ИЛИ ДокРеализации.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла
	КонецЕсли;		
КонецПроцедуры

Процедура СкопироватьТЧГТДИзСФ(ДокКорректировки, ИСФ) Экспорт;
	//ПО ФТ 46263, требуют полное копирования таблиц ГТД из предыдущей фактуры.
	ДокОснования = ДокКорректировки.ДокументРеализации;
	ПодчиненнаяИСФ = НайтиПодчиненныйСчетФактуру(ДокОснования);
	Если НЕ ЗначениеЗаполнено(ПодчиненнаяИСФ) Тогда 
		Возврат;
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(ИСФ, ПодчиненнаяИСФ,"ВидПеревозки"); 
	Для Каждого стр ИЗ ПодчиненнаяИСФ.ПодтверждающиеДокументы.Выгрузить() Цикл
		строкаТЧ = ИСФ.ПодтверждающиеДокументы.Добавить();
		ЗаполнитьЗначенияСвойств(строкаТЧ, стр);
	КонецЦикла;
	Для Каждого стр ИЗ ПодчиненнаяИСФ.МорскойТранспорт.Выгрузить() Цикл
		строкаТЧ = ИСФ.МорскойТранспорт.Добавить();
		ЗаполнитьЗначенияСвойств(строкаТЧ, стр);
	КонецЦикла;      
КонецПроцедуры 

Процедура ОтключитьОтчетФНСДляВсехПодчиненныхИСФ(ДокСсылка, СписокПросмотренных)
	ТЗСсылок = КорректировкиРТУСервер.ПолучитьКорректировкуПоОснованию(ДокСсылка.Ссылка);
	Если ТЗСсылок.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	Для каждого стрСсылка из ТЗСсылок Цикл		
		ОтключитьОтчетФНСДляВсехПодчиненныхИСФ(стрСсылка, СписокПросмотренных);
		Если СписокПросмотренных.Найти(стрСсылка) <> Неопределено Тогда 
			Продолжить;
		КонецЕсли; 
		СписокПросмотренных.Добавить(стрСсылка);
		УправлениеВыгрузкойДляФНС(НайтиПодчиненныйСчетФактуру(стрСсылка), Ложь, Истина);	
	КонецЦикла;
КонецПроцедуры

Процедура УправлениеВыгрузкойДляФНС(ТекущаяИСФ, Включить = Истина, Оповещение = Ложь)
	Если НЕ ЗначениеЗаполнено(ТекущаяИСФ) Тогда 
		Возврат;
	КонецЕсли;  
	// Евросиб(ДИТ) US 90779 ТА 99010 Сержантова А.С. Начало: 09.01.2025
	// Было:
	//Если ТекущаяИСФ.УдалитьВключатьВОтчетДляФНС = Включить Тогда 
	//	Возврат;
	//КонецЕсли; 
	// Евросиб(ДИТ) US 90779 ТА 99010 Сержантова А.С. Конец: 09.01.2025
	
	ТекущаяИСФ = ТекущаяИСФ.Получитьобъект();	 
	// Евросиб(ДИТ) US 90779 ТА 99010 Сержантова А.С. Начало: 09.01.2025
	//Реквизит перенесен в ТЧ ПодтверждающиеДокументы и МорскойТранспорт
	// Было:
	//ТекущаяИСФ.УдалитьВключатьВОтчетДляФНС = Включить; 
	//Стало:
	Для каждого СтрПодтверждающихДок Из ТекущаяИСФ.ПодтверждающиеДокументы Цикл
		СтрПодтверждающихДок.ВключатьВОтчетДляФНС = Включить;
	КонецЦикла;
	Для каждого СтрМорскойТранспорт Из ТекущаяИСФ.МорскойТранспорт Цикл
		СтрМорскойТранспорт.ВключатьВОтчетДляФНС = Включить;
	КонецЦикла;	
	// Евросиб(ДИТ) US 90779 ТА 99010 Сержантова А.С. Конец: 09.01.2025
	
	Попытка
		ТекущаяИСФ.Записать();
		Если Оповещение Тогда
			Если НЕ Включить Тогда 
				сообщ = "исключен из отчета";          
			Иначе     
				сообщ = "включен в отчет";
			КонецЕсли;
			Сообщить("Документ " + ТекущаяИСФ + ", "+сообщ+" для ФНС");
		КонецЕсли;
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры
