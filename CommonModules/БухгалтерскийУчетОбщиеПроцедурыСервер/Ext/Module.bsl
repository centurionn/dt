
&НаСервере
Функция СоздатьСчетФактуру(ВидСчетаФактуры, ДанныеЗаполнения, Партия = Неопределено) Экспорт
	ОбъектСчетФактуры = Документы[ВидСчетаФактуры].СоздатьДокумент();
	//ОбъектСчетФактуры.Дата = ДанныеЗаполнения.Дата;
	//ОбъектСчетФактуры.Записать();
	ОбъектСчетФактуры.Заполнить(ДанныеЗаполнения);
//	БухгалтерскийУчетОбщиеПроцедурыСервер.ЗаполнитьРеквизитыСчФПоОснованию(ДанныеЗаполнения,ОбъектСчетФактуры, Партия);
	Возврат Истина;// ОбъектСчетФактуры.Ссылка;
КонецФункции

&НаСервере
Функция НайтиПодчиненныйСчетФактуру(Знач ДокументСсылка, ВидСчетаФактуры = "СчетФактураВыданный",Партия = неопределено,Отбор = Неопределено,Покупатель = Неопределено)  Экспорт
	
	Если Не ЗначениеЗаполнено(ДокументСсылка.Ссылка) Тогда
		
		Возврат Неопределено;
		
	Иначе
		
		Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг") или ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
			
			Запрос = Новый Запрос("ВЫБРАТЬ
			                      |	СчетФактураВыданный.Ссылка КАК Ссылка
			                      |ИЗ
			                      |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
			                      |ГДЕ
			                      |	СчетФактураВыданный.ДокументОснование = &ДокументОснование");
			Запрос.УстановитьПараметр("ДокументОснование",ДокументСсылка);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				НайденныйДокумент = Выборка.Ссылка;
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") 
			или ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.КорректировкаПоступления")  
			или (ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ОтчетКомиссионераОПродажах") и ВидСчетаФактуры = "СчетФактураПолученный") тогда
			
			Запрос = Новый Запрос("ВЫБРАТЬ
			                      |	СчетФактураПолученный.Ссылка КАК Ссылка
			                      |ИЗ
			                      |	Документ.СчетФактураПолученный КАК СчетФактураПолученный
			                      |ГДЕ
			                      |	СчетФактураПолученный.ДокументОснование = &ДокументОснование");
			Запрос.УстановитьПараметр("ДокументОснование",ДокументСсылка);
			// Шейко О.Е. (25.01.2021) Добавлен отбор помеченных на удаление для Корр ПТУ
			Если Отбор <> Неопределено И ТипЗнч(Отбор) = Тип("Структура") Тогда
				
				Для каждого КлЗн Из Отбор Цикл
				
					Запрос.Текст = Запрос.Текст + " И СчетФактураПолученный."+КлЗн.Ключ + " = &" + КлЗн.Ключ;
					Запрос.УстановитьПараметр(КлЗн.Ключ, КлЗн.Значение);
				
				КонецЦикла; 
				
			КонецЕсли; 
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				НайденныйДокумент = Выборка.Ссылка;
			КонецЕсли;
			
		ИначеЕсли  ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") и ВидСчетаФактуры = "СчетФактураВыданный" тогда
			
			Если Партия <> Неопределено Тогда
				
				Запрос = Новый Запрос("ВЫБРАТЬ
				                      |	СчетФактураВыданный.Ссылка КАК Ссылка
				                      |ИЗ
				                      |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
				                      |ГДЕ
				                      |	СчетФактураВыданный.ДокументОснование = &ДокументОснование
				                      |	И СчетФактураВыданный.Продавец = &Продавец");
				Запрос.УстановитьПараметр("ДокументОснование",ДокументСсылка);
				Запрос.УстановитьПараметр("Продавец", Партия.Контрагент);
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					НайденныйДокумент = Выборка.Ссылка;
				КонецЕсли;
				
			Иначе
				
				Запрос = Новый Запрос("ВЫБРАТЬ
				                      |	СчетФактураВыданный.Ссылка КАК Ссылка
				                      |ИЗ
				                      |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
				                      |ГДЕ
				                      |	СчетФактураВыданный.ДокументОснование = &ДокументОснование
				                      |	И СчетФактураВыданный.Продавец = &Продавец");
				Запрос.УстановитьПараметр("ДокументОснование",ДокументСсылка);
				Запрос.УстановитьПараметр("Продавец",Справочники.Контрагенты.ПустаяСсылка());
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					НайденныйДокумент = Выборка.Ссылка;
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли  ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") и ВидСчетаФактуры = "СчетФактураПолученный" тогда
			
			Запрос = Новый Запрос("ВЫБРАТЬ
			                      |	СчетФактураПолученный.Ссылка КАК Ссылка
			                      |ИЗ
			                      |	Документ.СчетФактураПолученный КАК СчетФактураПолученный
			                      |ГДЕ
			                      |	СчетФактураПолученный.ДокументОснование = &ДокументОснование");
			Запрос.УстановитьПараметр("ДокументОснование",ДокументСсылка);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				НайденныйДокумент = Выборка.Ссылка;
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ОтчетКомиссионераОПродажах") и Покупатель <> Неопределено Тогда
			
			Запрос = Новый Запрос("ВЫБРАТЬ
			                      |	СчетФактураВыданный.Ссылка КАК Ссылка
			                      |ИЗ
			                      |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
			                      |ГДЕ
			                      |	СчетФактураВыданный.ДокументОснование = &ДокументОснование
			                      |	И СчетФактураВыданный.Контрагент = &Покупатель");
			Запрос.УстановитьПараметр("ДокументОснование",ДокументСсылка);
			Запрос.УстановитьПараметр("Покупатель",Покупатель);
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				НайденныйДокумент = Выборка.Ссылка;
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
			НайденныйДокумент = ДокументСсылка;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат НайденныйДокумент;
	
КонецФункции

Функция ПолучитьРеквизитыСчетФактуры(Знач ДокументОбъект, ВидСчетаФактуры, Отбор=Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(ДокументОбъект.Ссылка) тогда
		
		СчФ = НайтиПодчиненныйСчетФактуру(ДокументОбъект.Ссылка, ВидСчетаФактуры,,Отбор); // Шейко О.Е. (25.01.2021) Не работаем с помеченной на удаление счет фактурой
		Если СчФ <> Неопределено Тогда
			//Евросиб Гудкова( 02.01.2021 Ticket№ 0218691
			//было
			//РеквизитыСФ = Новый Структура;
			//РеквизитыСф.Вставить("Номер",СчФ.Номер);
			//РеквизитыСФ.Вставить("Дата",СчФ.Дата);
			//РеквизитыСф.Вставить("ПометкаУдаления",СчФ.ПометкаУдаления);
			Если ВидСчетаФактуры = "СчетФактураВыданный" Тогда
				СписокРеквизитов = "Номер,Дата,ПометкаУдаления,НомерДляПечати,ДатаДокумента";
			Иначе
				СписокРеквизитов = "Номер,Дата,ПометкаУдаления,НомерВходящегоДокумента,ДатаВходящегоДокумента";
			КонецЕсли; 
			РеквизитыСФ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчФ, СписокРеквизитов);
			// Евросиб Гудкова) 			
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	Иначе 
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат РеквизитыСФ;
	
КонецФункции

