Функция ПолучитьСтавкуНДС(СтавкаНДС) Экспорт
	Если СтавкаНДС = Перечисления.СтавкиНДС.НДС20 ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС20_120 Тогда
		Возврат 20;
		
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС10 ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС10_110 Тогда
		Возврат 10;
		
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС18 ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС18_118 Тогда
		Возврат 18;
		
	// Евросиб(ДИТ) US 96051 ТА 96052 Сержантова А.С. Начало: 25.12.2024
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС5 ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС5_105 Тогда
		Возврат 5;
		
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС7 ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС7_107 Тогда
		Возврат 7;
	// Евросиб(ДИТ) US 96051 ТА 96052 Сержантова А.С. Конец: 25.12.2024 
	//Евросиб СубботинВ #125845 09.12.2025 Начало
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС22 ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС22_122 Тогда
		Возврат 22;
	//Евросиб СубботинВ #125845 09.12.2025 Конец

	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция ПолучитьНомерИсправления(СсылкаКорректировки, ВидСчетФактуры, ТекСФ = неопределено)
	НомерТекущегоИсправления = 0;
	НомерПредыдущегоИсправления = 0;
	
	Запрос = Новый Запрос;
	Если ВидСчетФактуры = "СчетФактураВыданный" Тогда
		Запрос.УстановитьПараметр("ТекСФ", ТекСФ);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЕСТЬNULL(СчетФактураВыданный.НомерИсправления, 0) КАК НомерИсправления
		               |ИЗ
		               |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
		               |ГДЕ
		               |	СчетФактураВыданный.ДокументОснование = &Ссылка
		               |	И СчетФактураВыданный.Ссылка <> &ТекСФ";
	ИначеЕсли ВидСчетФактуры = "СчетФактураПолученный" Тогда
		Запрос.Текст = "ВЫБРАТЬ
		|	ЕСТЬNULL(СчетФактураПолученный.НомерИсправления, 0) КАК НомерИсправления
		|ИЗ
		|	Документ.СчетФактураПолученный КАК СчетФактураПолученный
		|ГДЕ
		|	СчетФактураПолученный.ДокументОснование = &Ссылка";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Ссылка",СсылкаКорректировки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		НомерПредыдущегоИсправления = Выборка.НомерИсправления;
	КонецЕсли;
	
	НомерТекущегоИсправления = НомерПредыдущегоИсправления + 1;
	
	Возврат НомерТекущегоИсправления;
КонецФункции

// Стандартная для данной конфигурации функция форматирования сумм
//
// Параметры:
//  Сумма  - число, которое мы хотим форматировать,
//  Валюта - ссылка на элемент справочника валют, если задан, то к в результирующую строку
//           будет добавлено представление валюты
//  ЧН     - строка, представляющая нулевое значение числа,
//  ЧРГ    - символ-разделитель групп целой части числа.
//
// Возвращаемое значение:
//  Отформатированная должным образом строковое представление суммы.
//
Функция ФорматСумм(Сумма, Валюта = Неопределено, ЧН = "", ЧРГ = "") Экспорт
	
	ФорматнаяСтрока = "ЧЦ=15;ЧДЦ=2"
					+ ?(НЕ ЗначениеЗаполнено(ЧН), "", ";" + "ЧН=" + ЧН)
					+ ?(НЕ ЗначениеЗаполнено(ЧРГ),"", ";" + "ЧРГ=" + ЧРГ);
	
	РезультирующаяСтрока = СокрЛ(Формат(Сумма, ФорматнаяСтрока));
	
	Если ЗначениеЗаполнено(Валюта) Тогда
		РезультирующаяСтрока = РезультирующаяСтрока + " " + СокрП(Валюта);
	КонецЕсли;
	
	Возврат РезультирующаяСтрока;
	
КонецФункции

Функция ПолучитьСчетДоговорПоУмолчанию(Контрагент) Экспорт
	ОсновныеДанные = Новый Структура;
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Контрагенты.ОсновнойБанковскийСчет КАК ОсновнойБанковскийСчет,
	                      |	Контрагенты.ОсновнойДоговорКонтрагента КАК ОсновнойДоговорКонтрагента
	                      |ИЗ
	                      |	Справочник.Контрагенты КАК Контрагенты
	                      |ГДЕ
	                      |	Контрагенты.Ссылка = &Ссылка
	                      |	И НЕ Контрагенты.ПометкаУдаления");
	Запрос.УстановитьПараметр("Ссылка", Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ОснДоговор = Выборка.ОсновнойДоговорКонтрагента;
		ОснСчет = Выборка.ОсновнойБанковскийСчет;
	КонецЕсли;
	ОсновныеДанные.Вставить("Договор",ОснДоговор);
	ОсновныеДанные.Вставить("Счет",ОснСчет);
	
	Возврат ОсновныеДанные;
КонецФункции

Функция НайтиДействующиеДоверенностиНаПодпись(Дата, ТипДокумента = "", ЦФО = неопределено) Экспорт
	
	СтруктураПодписантов = Новый Структура ("ДоверенностьЗаРуководителя,ЗаРуководителя, ДолжностьЗаРуководителя, ДоверенностьЗаГБ, ОснованиеНаРук, ЗаГлавБуха, ДолжностьЗаГлавБуха, ОснованиеЗаГБ, ФаксимильЗаРук, ПечатьЗаРук, ФаксимильЗаГБ, ПечатьЗаГБ");
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Доверенности.ФИОПодписанта КАК ПодписантРуководитель,
	                      |	Доверенности.ОснованиеДляПодписания КАК ОснованиеЗаРуководителя,
	                      |	Доверенности.Должность КАК ДолжностьЗаРуководителя,
	                      |	Доверенности.Ссылка КАК ДоверенностьЗаРук
	                      |ИЗ
	                      |	Справочник.Доверенности КАК Доверенности
	                      |ГДЕ
	                      |	Доверенности.ДатаНачалаДействия <= &Дата
	                      |	И Доверенности.ДатаОкончанияДейставия >= &Дата
	                      |	И Доверенности.ДоверенностьДляПодписанта = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизации.Руководитель)
	                      |	И Доверенности.ИспользоватьДляДокументов ПОДОБНО &ТипДокумента
	                      |	И НЕ Доверенности.ПометкаУдаления
	                      |	И (Доверенности.ЦФУ = &ЦФУ
						  //Евросиб - АСуслов 08.10.2020 15:11:14 #
						  //(
	                      //|			ИЛИ &ЦФУ = ЗНАЧЕНИЕ(Справочник.ЦентрыФинансовойОтветственности.ПустаяСсылка)
						  
						  //)
						  //Евросиб - АСуслов 08.10.2020 15:11:14 #
						  |   )
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	Доверенности.ФИОПодписанта КАК ПодписантГлБух,
	                      |	Доверенности.Должность КАК ОснованиеЗаГлБуха,
	                      |	Доверенности.ОснованиеДляПодписания КАК ДолжностьЗаГлБуха,
	                      |	Доверенности.Ссылка КАК ДоверенностьЗаГБ
	                      |ИЗ
	                      |	Справочник.Доверенности КАК Доверенности
	                      |ГДЕ
	                      |	Доверенности.ДатаНачалаДействия <= &Дата
	                      |	И Доверенности.ДатаОкончанияДейставия >= &Дата
	                      |	И Доверенности.ДоверенностьДляПодписанта = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизации.ГлавныйБухгалтер)
	                      |	И Доверенности.ИспользоватьДляДокументов ПОДОБНО &ТипДокумента
	                      |	И НЕ Доверенности.ПометкаУдаления
	                      |	И (Доверенности.ЦФУ = &ЦФУ
						  //Евросиб - АСуслов 08.10.2020 15:11:25 #
						  //(
	                      //|			ИЛИ &ЦФУ = ЗНАЧЕНИЕ(Справочник.ЦентрыФинансовойОтветственности.ПустаяСсылка)
						  |   )");
						  
						  //)
						  //Евросиб - АСуслов 08.10.2020 15:11:25 #
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ЦФУ", ?(ЦФО=Неопределено, Справочники.ЦентрыФинансовойОтветственности.ПустаяСсылка(), ЦФО));
	Запрос.УстановитьПараметр("ТипДокумента","%"+ТипДокумента+"%");

	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ЗаРуководителя = РезультатЗапроса[0].Выбрать();
	ЗаГлБух = РезультатЗапроса[1].Выбрать();
	
	Если ЗаРуководителя.Следующий() Тогда
