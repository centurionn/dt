	               |	И ПланПродажПродукты.Ссылка.Проведен
	               |	И (&ПланПродаж = НЕОПРЕДЕЛЕНО
	               |			ИЛИ &ПланПродаж = ПланПродажПродукты.Ссылка)";
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		// сначала в план оплат вносим авансы от клиентов
		Если Ответ.Количество20*Ответ.СуммаАванса20+Ответ.Количество40*Ответ.СуммаАванса40 > 0 Тогда
			СуммаВал = Ответ.Количество20*Ответ.СуммаАванса20+Ответ.Количество40*Ответ.СуммаАванса40;
			СуммаРуб = Валюта_сервер.ПересчитатьПоКурсу(СуммаВал, Ответ.Валюта, Справочники.Валюты.Рубль, Ответ.ПлановаяДатаУслуги);
			
			Результат.Добавить(Новый Структура("Номенклатура,Контрагент,ДоговорКонтрагента,ДатаДвижения,Сумма,Валюта, СтатьяДвиженияДенежныхСредств, СуммаРуб", Ответ.Номенклатура, Ответ.Клиент, Ответ.Договор, Ответ.ПлановаяДатаУслуги, СуммаВал, Ответ.Валюта, Ответ.СтатьяДДС, СуммаРуб));
		КонецЕсли;
		
		// затем в план оплат вносим закрывающие оплаты от клиентов
		Если Ответ.Количество20*Ответ.СуммаОплаты20+Ответ.Количество40*Ответ.СуммаОплаты40 > 0 Тогда
			СуммаВал = Ответ.Количество20*Ответ.СуммаОплаты20+Ответ.Количество40*Ответ.СуммаОплаты40;
			СуммаРуб = Валюта_сервер.ПересчитатьПоКурсу(СуммаВал, Ответ.Валюта, Справочники.Валюты.Рубль, Ответ.ПлановаяДатаУслуги+Ответ.СрокОплаты*24*3600);
			
			Результат.Добавить(Новый Структура("Номенклатура,Контрагент,ДоговорКонтрагента,ДатаДвижения,Сумма,Валюта, СтатьяДвиженияДенежныхСредств, СуммаРуб", Ответ.Номенклатура, Ответ.Клиент, Ответ.Договор, Ответ.ПлановаяДатаУслуги+Ответ.СрокОплаты*24*3600, СуммаВал, Ответ.Валюта, Ответ.СтатьяДДС, СуммаРуб));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЗаполнитьПоступленияПоПлануПродаж(ПланПродаж, СДопУслугами = Истина) Экспорт
	
	Возврат ПолучитьТаблицуПлановыхПоступленийЗаСделкиПериода(ПланПродаж.ДатаНачала, ПланПродаж.ДатаОкончания, ПланПродаж, СДопУслугами);
	
КонецФункции

Функция ЗаполнитьСписанияПоПлануПродаж(ПланПродаж) Экспорт
	
	Возврат ПолучитьТаблицуПлановыхСписанийЗаСделкиПериода(ПланПродаж.ДатаНачала, ПланПродаж.ДатаОкончания, ПланПродаж);
	
КонецФункции