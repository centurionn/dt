Функция ПолучитьТаблицуПлановыхПоступленийЗаСделкиПериода(Дата1, Дата2, ПланПродаж = неопределено, СДопУслугами = Истина) Экспорт
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата1", Дата1);
	Запрос.УстановитьПараметр("Дата2", Дата2);
	Запрос.УстановитьПараметр("ПланПродаж", ПланПродаж);
	Запрос.УстановитьПараметр("СДопУслугами", СДопУслугами);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПланПродажПродукты.ПлановаяДатаУслуги КАК ПлановаяДатаУслуги,
	               |	ПланПродажПродукты.Клиент КАК Клиент,
	               |	КалькуляцияПланПродаж_Доходы.Номенклатура КАК Номенклатура,
	               |	КалькуляцияПланПродаж_Доходы.СрокОплаты КАК СрокОплаты,
	               |	КалькуляцияПланПродаж_Доходы.СуммаАванса20 КАК СуммаАванса20,
	               |	КалькуляцияПланПродаж_Доходы.СуммаОплаты20 КАК СуммаОплаты20,
	               |	КалькуляцияПланПродаж_Доходы.СуммаАванса40 КАК СуммаАванса40,
	               |	КалькуляцияПланПродаж_Доходы.СуммаОплаты40 КАК СуммаОплаты40,
	               |	ПланПродажПродукты.Количество20 КАК Количество20,
	               |	ПланПродажПродукты.Количество40 КАК Количество40,
	               |	ПланПродажПродукты.Количество КАК Количество,
	               |	ПланПродажПродукты.СтавкаЗаТЕУ КАК СтавкаЗаТЕУ,
	               |	КалькуляцияПланПродаж_Доходы.Валюта КАК Валюта,
	               |	ПланПродажПродукты.Договор КАК Договор,
	               |	КалькуляцияПланПродаж_Доходы.Номенклатура.СтатьяДДС КАК СтатьяДДС
	               |ИЗ
	               |	Документ.ПланПродаж.Продукты КАК ПланПродажПродукты
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Калькуляция.ПланПродаж_Доходы КАК КалькуляцияПланПродаж_Доходы
	               |		ПО ПланПродажПродукты.Калькуляция = КалькуляцияПланПродаж_Доходы.Ссылка
	               |ГДЕ
	               |	ПланПродажПродукты.ПлановаяДатаУслуги МЕЖДУ &Дата1 И &Дата2
	               |	И ПланПродажПродукты.Ссылка.Проведен
	               |	И (&ПланПродаж = НЕОПРЕДЕЛЕНО
	               |			ИЛИ &ПланПродаж = ПланПродажПродукты.Ссылка)
	               |	И ВЫБОР
	               |			КОГДА &СДопУслугами
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ КалькуляцияПланПродаж_Доходы.ДопУслуга = ЛОЖЬ
	               |		КОНЕЦ";
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		// сначала в план оплат вносим авансы от клиентов
		Если Ответ.Количество20*Ответ.СуммаАванса20+Ответ.Количество40*Ответ.СуммаАванса40 > 0 Тогда
			СуммаВал = Ответ.Количество20*Ответ.СуммаАванса20+Ответ.Количество40*Ответ.СуммаАванса40;
			СуммаРуб = Валюта_сервер.ПересчитатьПоКурсу(СуммаВал, Ответ.Валюта, Справочники.Валюты.Рубль, Ответ.ПлановаяДатаУслуги);
			
			Результат.Добавить(Новый Структура("Номенклатура,Контрагент,ДоговорКонтрагента,ДатаДвижения,Сумма,Валюта,СтатьяДвиженияДенежныхСредств,СуммаРуб", Ответ.Номенклатура, Ответ.Клиент, Ответ.Договор, Ответ.ПлановаяДатаУслуги, СуммаВал, Ответ.Валюта, Ответ.СтатьяДДС, СуммаРуб));
		КонецЕсли;
		
		// затем в план оплат вносим закрывающие оплаты от клиентов
		Если Ответ.Количество20*Ответ.СуммаОплаты20+Ответ.Количество40*Ответ.СуммаОплаты40 > 0 Тогда
			СуммаВал = Ответ.Количество20*Ответ.СуммаОплаты20+Ответ.Количество40*Ответ.СуммаОплаты40;
			СуммаРуб = Валюта_сервер.ПересчитатьПоКурсу(СуммаВал, Ответ.Валюта, Справочники.Валюты.Рубль, Ответ.ПлановаяДатаУслуги+Ответ.СрокОплаты*24*3600);
			
			Результат.Добавить(Новый Структура("Номенклатура,Контрагент,ДоговорКонтрагента,ДатаДвижения,Сумма,Валюта,СтатьяДвиженияДенежныхСредств,СуммаРуб", Ответ.Номенклатура, Ответ.Клиент, Ответ.Договор, Ответ.ПлановаяДатаУслуги+Ответ.СрокОплаты*24*3600, СуммаВал, Ответ.Валюта, Ответ.СтатьяДДС, СуммаРуб));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТаблицуПлановыхСписанийЗаСделкиПериода(Дата1, Дата2, ПланПродаж = неопределено) Экспорт
	
