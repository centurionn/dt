
Функция ПолучитьEMAILПользователя(Контрагент) 
	
	Результат = "";
	Для каждого Стр из Контрагент.КонтактнаяИнформация Цикл
		Если ЗначениеЗаполнено(Стр.АдресЭП) тогда
			Результат = Стр.Представление;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Процедура РассылкаПоЛичнымЦелямПользователям() Экспорт
	
	// первичная проверка на то, что мы вообще можем что-то отправить
	УчетнаяЗаписьПоУмолчанию = РаботаСПочтовымиСообщениями.ПроверитьСистемнаяУчетнаяЗаписьДоступна();
	
	Если не УчетнаяЗаписьПоУмолчанию Тогда 
		возврат; 
	КонецЕсли;
	
	СистемнаяУчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	ПрефиксНС = Константы["АдресПубликацииИнформационнойБазыВЛокальнойСети"+?(ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована, "Тестовый", "")].Получить() + "#";
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛичныеЦелиЪ.Ссылка КАК ДокументЛичныеЦели,
		|	ЛичныеЦелиЪ.СрокДостижения КАК СрокДостижения,
		|	ЛичныеЦелиЪ.КонтактДляУведомлений КАК КонтактДляУведомлений,
		|	ИСТИНА КАК СрокДостигнут,
		|	NULL КАК ИнформироватьДоОкончанияЗаДней
		|ПОМЕСТИТЬ СписокУведомляемых
		|ИЗ
		|	Документ.ЛичныеЦели КАК ЛичныеЦелиЪ
		|ГДЕ
		|	(ЛичныеЦелиЪ.СрокДостижения = &ТекДата
		|				И ЛичныеЦелиЪ.УведомитьОРезультатах
		|			ИЛИ ДОБАВИТЬКДАТЕ(ЛичныеЦелиЪ.СрокДостижения, ДЕНЬ, ЛичныеЦелиЪ.ИнформироватьДоОкончанияЗаДней) = &ТекДата
		|				И ЛичныеЦелиЪ.ИнформироватьДоОкончанияЗаДней = 0)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЛичныеЦелиЪ.Ссылка,
		|	ЛичныеЦелиЪ.СрокДостижения,
		|	ЛичныеЦелиЪ.Сотрудник,
		|	ЛОЖЬ,
		|	ЛичныеЦелиЪ.ИнформироватьДоОкончанияЗаДней
		|ИЗ
		|	Документ.ЛичныеЦели КАК ЛичныеЦелиЪ
		|ГДЕ
		|	ДОБАВИТЬКДАТЕ(ЛичныеЦелиЪ.СрокДостижения, ДЕНЬ, -ЛичныеЦелиЪ.ИнформироватьДоОкончанияЗаДней) = &ТекДата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СписокУведомляемых.ДокументЛичныеЦели КАК ДокументЛичныеЦели,
		|	СписокУведомляемых.СрокДостижения КАК СрокДостижения,
		|	СписокУведомляемых.КонтактДляУведомлений КАК КонтактДляУведомлений,
		|	СписокУведомляемых.ИнформироватьДоОкончанияЗаДней КАК ИнформироватьДоОкончанияЗаДней,
		|	СписокУведомляемых.СрокДостигнут КАК СрокДостигнут
		|ИЗ
		|	СписокУведомляемых КАК СписокУведомляемых
		|ИТОГИ ПО
		|	КонтактДляУведомлений,
		|	СрокДостигнут";
	
	Запрос.УстановитьПараметр("ТекДата", НачалоДня(ТекущаяДата()));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаКонтактДляУведомлений = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаКонтактДляУведомлений.Следующий() Цикл
		
		// получаем пользователей. рассылка для каждого отдельная
		ПользователиДляРассылки = ВыборкаКонтактДляУведомлений.КонтактДляУведомлений;
		
		Тема = "DATACore: информация по личным целям и задачам";
		ТекстПисьма = "Уважаемые коллеги,<br/>";
		ПолучателиПисьма = Новый Массив;
		
		ПараметрыОтправкиПисьма = новый Структура;
		ПараметрыОтправкиПисьма.Вставить("ТипТекста", "HTML");
		
		Если ТипЗнч(ПользователиДляРассылки) = Тип("СправочникСсылка.Пользователи") Тогда
			EMAIL = ПолучитьEMAILПользователя(ПодобратьЗамещение(ПользователиДляРассылки, ТекущаяДата()));
			Если ЗначениеЗаполнено(EMAIL) Тогда
				ПолучателиПисьма.Добавить(Новый Структура("Представление, Адрес", Строка(ПользователиДляРассылки), EMAIL));
			КонецЕсли;
		Иначе
			ПользователиГруппы = Пользователи_sd_сервер.ПолучитьПользователейГруппы(ПользователиДляРассылки);
			Для каждого ПользовательЪ из ПользователиГруппы Цикл
				EMAIL = ПолучитьEMAILПользователя(ПодобратьЗамещение(ПользовательЪ, ТекущаяДата()));
				Если ЗначениеЗаполнено(EMAIL) Тогда
					ПолучателиПисьма.Добавить(Новый Структура("Представление, Адрес", Строка(ПользовательЪ), EMAIL));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		ВыборкаСрокДостигнут = ВыборкаКонтактДляУведомлений.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСрокДостигнут.Следующий() Цикл
	
			ВыборкаДетальныеЗаписи = ВыборкаСрокДостигнут.Выбрать();
			
			Если ВыборкаСрокДостигнут.СрокДостигнут Тогда
				ТекстПисьма = ТекстПисьма + "<br/><b>По следующим задачам завершен плановый срок исполнения:</b><br/><br/>";
			Иначе
				ТекстПисьма = ТекстПисьма + "<br/><b>По следующим задачам наступил срок напоминания:</b><br/><br/>";
			КонецЕсли;
			
			ТекстПисьма = ТекстПисьма + "<table border=1><tr><td>Карточка личной цели</td><td>Ссылка</td></tr>";
		
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				ТекстНС = "<a target=""_blank"" href="""+ПрефиксНС+ПолучитьНавигационнуюСсылку(ВыборкаДетальныеЗаписи.ДокументЛичныеЦели)+""">"+ПолучитьНавигационнуюСсылку(ВыборкаДетальныеЗаписи.ДокументЛичныеЦели)+"</a>";
				ТекстПисьма = ТекстПисьма + "<tr><td>"+ВыборкаДетальныеЗаписи.ДокументЛичныеЦели+"</td><td>"+ТекстНС+"</td></tr>";
				
			КонецЦикла;
		
			ТекстПисьма = ТекстПисьма + "</table>";	
		КонецЦикла;
		
		ПараметрыОтправкиПисьма.Вставить("Тема", Тема);
		ПараметрыОтправкиПисьма.Вставить("Тело", ТекстПисьма);
		
		ПараметрыОтправкиПисьма.Вставить("Кому", ПолучателиПисьма);
		
		
		РЕЗУЛЬТАТ = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(СистемнаяУчетнаяЗапись, ПараметрыОтправкиПисьма);

		
	КонецЦикла;
	
КонецПроцедуры


Функция ПодобратьЗамещение(Пользователь, ДатаЗамещения) Экспорт
	
	Результат = Пользователь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗамещениеЪ.Замещение КАК Замещение
	               |ИЗ
	               |	Документ.Замещение КАК ЗамещениеЪ
	               |ГДЕ
	               |	ЗамещениеЪ.Проведен
	               |	И ЗамещениеЪ.РежимДокумента = 0
	               |	И ЗамещениеЪ.ИсходныйПользователь = &ИсходныйПользователь
	               |	И &ДатаДокумента МЕЖДУ ЗамещениеЪ.НачалоПериодаЗамещения И ЗамещениеЪ.КонецПериодаЗамещения";
	Запрос.УстановитьПараметр("ИсходныйПользователь", Пользователь);
	Запрос.УстановитьПараметр("ДатаДокумента", ДатаЗамещения);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Замещение;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Шейко ОЕ [Ticket#0204385] Личные сообщения пользователям
Процедура СформироватьЛичноеСообщение(ГУИДТемы, ОписаниеТемы="", Контекст, ДатаСообщения, АвторСообщения, ТекстСообщения, Файл=Неопределено, ГУИДСообщения, Получатель) Экспорт
	
	Если ОписаниеТемы = "" ИЛИ ОписаниеТемы = Неопределено Тогда
	
		ОписаниеТемы = "ЛС:"+АвторСообщения+":"+Лев(ТекстСообщения, 100);
	
	КонецЕсли; 
	
	Строка_ГУИДТемы = Строка(ГУИДТемы);
	Диалоги_сервер.СоздатьТему(Строка_ГУИДТемы, ОписаниеТемы, Контекст);
	
	ГУИДСообщения = Строка(Новый УникальныйИдентификатор());
	
	Диалоги_сервер.ДобавитьСообщение(Строка_ГУИДТемы, ГУИДСообщения, АвторСообщения, ДатаСообщения, ТекстСообщения, Файл, Получатель);

КонецПроцедуры

