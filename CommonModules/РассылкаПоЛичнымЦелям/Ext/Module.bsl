Процедура РассылкаНаступленияСНП() Экспорт
	
	Если НЕ РаботаСПочтовымиСообщениями.ПроверитьСистемнаяУчетнаяЗаписьДоступна() Тогда 
		ЗаписьЖурналаРегистрации("Ошибка отправки списка непрочитанных", УровеньЖурналаРегистрации.Ошибка,,, "Недоступна системная учетная запись");
		Возврат; 
	КонецЕсли;
	
	ТекДата = ТекущаяДата();
	НачалоТекущегоДня = НачалоДня(ТекДата);
	СекундВСутках = 86400;
	ПустаяДата = '00010101';
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РасчетСНП.КлючАналитикиПеревозки.Заявка КАК Заявка,
	|	РасчетСНП.КлючАналитикиПеревозки.Контейнер КАК Контейнер,
	|	0 КАК ДнейДоНаступленияСНП
	|ПОМЕСТИТЬ НаступающиеСНП
	|ИЗ
	|	Документ.РасчетСНП КАК РасчетСНП
	|ГДЕ
	|	РасчетСНП.Проведен
	|	И РасчетСНП.ПредполагаемаяДатаНачалаСНП = &ТекущаяДата
	|	И РасчетСНП.ФактическаяДатаОкончания = &ПустаяДата
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РасчетСНП.КлючАналитикиПеревозки.Заявка,
	|	РасчетСНП.КлючАналитикиПеревозки.Контейнер,
	|	5
	|ИЗ
	|	Документ.РасчетСНП КАК РасчетСНП
	|ГДЕ
	|	РасчетСНП.Проведен
	|	И РасчетСНП.ПредполагаемаяДатаНачалаСНП = &ДатаЧерез5Дней
	|	И РасчетСНП.ФактическаяДатаОкончания = &ПустаяДата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НаступающиеСНП.Заявка КАК Заявка,
	|	НаступающиеСНП.Заявка.Автор КАК Получатель,
	|	ПользователиКонтактнаяИнформация.АдресЭП КАК АдресЭП,
	|	НаступающиеСНП.Заявка.Номер КАК НомерЗаявки,
	|	НаступающиеСНП.Заявка.Дата КАК ДатаЗаявки,
	|	НаступающиеСНП.Заявка.Автор.Представление КАК ПредставлениеПолучателя,
	|	НаступающиеСНП.Заявка.Представление КАК ПредставлениеЗаявки,
	|	НаступающиеСНП.Контейнер КАК Контейнер,
	|	НаступающиеСНП.Контейнер.Наименование КАК НомерКонтейнера,
	|	НаступающиеСНП.ДнейДоНаступленияСНП КАК ДнейДоНаступленияСНП,
	|	НаступающиеСНП.Заявка.Контрагент.Наименование КАК НаименованиеКонтрагента
	|ИЗ
	|	НаступающиеСНП КАК НаступающиеСНП
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
	|		ПО НаступающиеСНП.Заявка.Автор = ПользователиКонтактнаяИнформация.Ссылка
	|			И (ПользователиКонтактнаяИнформация.Тип = &ТипАдресЭлектроннойПочты)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Получатель,
	|	ДнейДоНаступленияСНП,
	|	Заявка,
	|	Контейнер";
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РасчетСНП.КлючАналитикиПеревозки.Заявка КАК Заявка,
	|	РасчетСНП.КлючАналитикиПеревозки.Контейнер КАК Контейнер,
	|	0 КАК ДнейДоНаступленияСНП,
	|	РасчетСНП.КлючАналитикиПеревозки.Заявка.Автор КАК АвторЗаявки,
	|	РасчетСНП.Автор КАК Автор
	|ПОМЕСТИТЬ НаступающиеСНП
	|ИЗ
	|	Документ.РасчетСНП КАК РасчетСНП
	|ГДЕ
	|	РасчетСНП.Проведен
	|	И РасчетСНП.ПредполагаемаяДатаНачалаСНП = &ТекущаяДата
	|	И РасчетСНП.ФактическаяДатаОкончания = &ПустаяДата
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РасчетСНП.КлючАналитикиПеревозки.Заявка,
	|	РасчетСНП.КлючАналитикиПеревозки.Контейнер,
	|	5,
	|	РасчетСНП.КлючАналитикиПеревозки.Заявка.Автор,
	|	РасчетСНП.Автор
	|ИЗ
	|	Документ.РасчетСНП КАК РасчетСНП
	|ГДЕ
	|	РасчетСНП.Проведен
	|	И РасчетСНП.ПредполагаемаяДатаНачалаСНП = &ДатаЧерез5Дней
	|	И РасчетСНП.ФактическаяДатаОкончания = &ПустаяДата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НаступающиеСНП.Заявка КАК Заявка,
	|	НаступающиеСНП.Контейнер КАК Контейнер,
	|	НаступающиеСНП.АвторЗаявки КАК Получатель,
	|	НаступающиеСНП.ДнейДоНаступленияСНП КАК ДнейДоНаступленияСНП
	|ПОМЕСТИТЬ НаступающиеСНПпоПолучателям
	|ИЗ
	|	НаступающиеСНП КАК НаступающиеСНП
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НаступающиеСНП.Заявка,
	|	НаступающиеСНП.Контейнер,
	|	НаступающиеСНП.Автор,
	|	НаступающиеСНП.ДнейДоНаступленияСНП
	|ИЗ
	|	НаступающиеСНП КАК НаступающиеСНП
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НаступающиеСНП.Заявка КАК Заявка,
	|	НаступающиеСНП.Получатель КАК Получатель,
	|	ПользователиКонтактнаяИнформация.АдресЭП КАК АдресЭП,
	|	НаступающиеСНП.Заявка.Номер КАК НомерЗаявки,
	|	НаступающиеСНП.Заявка.Дата КАК ДатаЗаявки,
	|	НаступающиеСНП.Получатель.Представление КАК ПредставлениеПолучателя,
	|	НаступающиеСНП.Заявка.Представление КАК ПредставлениеЗаявки,
	|	НаступающиеСНП.Контейнер КАК Контейнер,
	|	НаступающиеСНП.Контейнер.Наименование КАК НомерКонтейнера,
	|	НаступающиеСНП.ДнейДоНаступленияСНП КАК ДнейДоНаступленияСНП,
	|	НаступающиеСНП.Заявка.Контрагент.Наименование КАК НаименованиеКонтрагента
	|ИЗ
	|	НаступающиеСНПпоПолучателям КАК НаступающиеСНП
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
	|		ПО НаступающиеСНП.Получатель = ПользователиКонтактнаяИнформация.Ссылка
	|			И (ПользователиКонтактнаяИнформация.Тип = &ТипАдресЭлектроннойПочты)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Получатель,
	|	ДнейДоНаступленияСНП,
	|	Заявка,
	|	Контейнер";
	
	Запрос.УстановитьПараметр("ТекущаяДата", НачалоТекущегоДня);
	ДатаЧерез5Дней = НачалоТекущегоДня + 5 * СекундВСутках; 
	Запрос.УстановитьПараметр("ДатаЧерез5Дней", ДатаЧерез5Дней);
	Запрос.УстановитьПараметр("ТипАдресЭлектроннойПочты", Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
	Запрос.УстановитьПараметр("ПустаяДата", ПустаяДата);
	Выборка = Запрос.Выполнить().Выбрать();
	
	СистемнаяУчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	ШаблонЗаголовкаЗадачи = "Начало СНП КТК №%1 по заявке %2";
	
	//ШаблонТекстаПисьмаНаступилСНП = "По вашей заявке %1 появились КТК  с наступившим сроком <b>СНП</b>.<br/>";
	
	ШаблонТемыПисьмаСНП = "Уведомление о начале СНП";
	ШаблонТекстаПисьмаНаступилСНП = 
	"Появились контейнеры с наступившим сроком <b>СНП</b> по вашим заявкам:<br/>
	|%1";
	
	ШаблонТемыПисьмаСНП5 = "Уведомление о начале СНП через 5 суток";
	ШаблонТекстаПисьмаНаступитСНП5 = 
	"Появились контейнеры, у которых через 5 суток наступит <b>СНП</b>, по вашим заявкам:<br/>
	|%1";
	
	Пока Выборка.СледующийПоЗначениюПоля("Получатель") Цикл
		
		Если Не ЗначениеЗаполнено(Выборка.АдресЭП) Тогда
			ЗаписьЖурналаРегистрации("Ошибка отправки списка непрочитанных", УровеньЖурналаРегистрации.Ошибка,,, "Не задан электронный адрес получателя " + Выборка.ПредставлениеПользователя);
			Продолжить;
		КонецЕсли;
		
		АдресЭП = Выборка.АдресЭП;
		ПредставлениеПолучателя = Выборка.ПредставлениеПолучателя;
		
		Пока Выборка.СледующийПоЗначениюПоля("ДнейДоНаступленияСНП") Цикл
			
			
			Заявки = Новый Массив;
			Пока Выборка.СледующийПоЗначениюПоля("Заявка") Цикл
				
				НомерЗаявки = Выборка.НомерЗаявки;
				ДатаЗаявки = Выборка.ДатаЗаявки;				
				ПредставлениеЗаявки = СтрШаблон("Заявка %1 от %2. Контрагент - %3", НомерЗаявки, Формат(ДатаЗаявки, "ДФ=dd.MM.yyyy"), Выборка.НаименованиеКонтрагента);
				
				Заявки.Добавить(ПредставлениеЗаявки);
				
				//НомераКонтейнеров = Новый Массив;
				//Пока Выборка.СледующийПоЗначениюПоля("Контейнер") Цикл
				//	НомераКонтейнеров.Добавить(Выборка.НомерКонтейнера);
				//КонецЦикла;
				//НомераКонтейнеров = СтрСоединить(НомераКонтейнеров, ", ");
				
			КонецЦикла;
			
			Заявки = СтрСоединить(Заявки, "<br/>" + Символы.ПС);
			
			Если Выборка.ДнейДоНаступленияСНП = 0 Тогда
				Тема = ШаблонТемыПисьмаСНП;
				ТекстПисьма = СтрШаблон(ШаблонТекстаПисьмаНаступилСНП, Заявки);				
			ИначеЕсли Выборка.ДнейДоНаступленияСНП = 5 Тогда
				Тема = ШаблонТемыПисьмаСНП5;
				ТекстПисьма = СтрШаблон(ШаблонТекстаПисьмаНаступитСНП5, Заявки);
			КонецЕсли;
			
			//Отправка сообщения по эл. почте
			ПолучателиПисьма = Новый Массив;
			ПолучателиПисьма.Добавить(Новый Структура("Представление, Адрес", Строка(ПредставлениеПолучателя), АдресЭП));
			
			ПараметрыОтправкиПисьма = новый Структура;
			ПараметрыОтправкиПисьма.Вставить("Тема", Тема);
			ПараметрыОтправкиПисьма.Вставить("Тело", ТекстПисьма);
			ПараметрыОтправкиПисьма.Вставить("ТипТекста", "HTML");
			ПараметрыОтправкиПисьма.Вставить("Кому", ПолучателиПисьма);
			
			Если ПолучателиПисьма.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Результат = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(СистемнаяУчетнаяЗапись, ПараметрыОтправкиПисьма);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры
