
Процедура СформироватьЗадачуИПисьмо(ОбъектДокумент) Экспорт
	
	Если ТипЗнч(ОбъектДокумент) = Тип("ДокументОбъект.РеестрПлатежей") Тогда
		СтруктураПоиска = Новый Структура("Статус",Перечисления.СтатусыЭтапов.НаВыполнение);
		НайденнаяСтрока = ОбъектДокумент.Состояния.НайтиСтроки(СтруктураПоиска); 
		Если НайденнаяСтрока.Количество() =1 Тогда				
			Если НайденнаяСтрока = Справочники.Состояния.РедактированиеДокумента Тогда
				Возврат;
			КонецЕсли;
			НайденнаяСтрока = НайденнаяСтрока[0];
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЗадачаИсполнителя.Ссылка КАК Ссылка
			|ИЗ
			|	Задача.ЗадачаИсполнителя КАК ЗадачаИсполнителя
			|ГДЕ
			|	ЗадачаИсполнителя.Состояние = &Состояние
			|	И ЗадачаИсполнителя.ОбъектЗадачи = &ОбъектЗадачи
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ГруппыПользователейСостав.Ссылка КАК ГруппаПользователей,
			|	ГруппыПользователейСостав.Пользователь КАК Пользователь
			|ИЗ
			|	Справочник.ГруппыПользователей.Состав КАК ГруппыПользователейСостав
			|ГДЕ
			|	ГруппыПользователейСостав.Ссылка = &Ссылка";
			
			Запрос.УстановитьПараметр("Ссылка", НайденнаяСтрока.Исполнитель);
			Запрос.УстановитьПараметр("Состояние", НайденнаяСтрока.Состояние);
			Запрос.УстановитьПараметр("ОбъектЗадачи", ОбъектДокумент.Ссылка);
			РезультатЗапроса = Запрос.ВыполнитьПакет();
			
			СуществующиеЗадачи =  РезультатЗапроса[0].Выбрать();			
			Если СуществующиеЗадачи.Количество()>0 Тогда
				Возврат
			КонецЕсли;	
				
            ПолучателиУведомления = Новый Массив;
			Если ТипЗнч(НайденнаяСтрока.Исполнитель) = Тип("СправочникСсылка.ГруппыПользователей") и ЗначениеЗаполнено(НайденнаяСтрока.Исполнитель) Тогда 
				//СтруктураОтбора = Новый Структура("ГруппаПользователей", НайденнаяСтрока.Исполнитель);		
				//Исполнители =  РезультатЗапроса.НайтиСтроки(СтруктураОтбора);
				Выборка = РезультатЗапроса[1].Выбрать();
				Пока Выборка.Следующий() Цикл
					ПолучателиУведомления.Добавить(Выборка.Пользователь); 
				КонецЦикла;
				
			ИначеЕсли ТипЗнч(НайденнаяСтрока.Исполнитель) = Тип("СправочникСсылка.Пользователи") и ЗначениеЗаполнено(НайденнаяСтрока.Исполнитель) Тогда
				//Исполнители = Новый Массив;
				//Исполнители.Добавить(Новый Структура("Пользователь",НайденнаяСтрока.Исполнитель));
				ПолучателиУведомления.Добавить(НайденнаяСтрока.Исполнитель);
			КонецЕсли;
			
			
			//Для Каждого Исполнитель из Исполнители Цикл 		
			//	ПолучателиУведомления.Добавить(Исполнитель.Пользователь);  
			//КонецЦикла;

				НаименованиеЗадачи = "Выполнить " + НайденнаяСтрока.Состояние;
				
				Задача = Задачи.ЗадачаИсполнителя.СоздатьЗадачу(); 
				Задача.Исполнитель = НайденнаяСтрока.Исполнитель;
				Задача.Дата			= ТекущаяДата();
				//	ЗадачаИсполнителя.ВидЗадачи		= Справочники.ВидыЗадачПользователей.ПроизводственныйКалендарь;
				Задача.ОбъектЗадачи	= ОбъектДокумент.Ссылка;
				Задача.Состояние	= НайденнаяСтрока.Состояние;			
				Задача.Наименование	= НаименованиеЗадачи;			
				//ЗаписатьАдресациюЗадачи(ЗадачаИсполнителя, Справочники.Организации.ПустаяСсылка(), Справочники.РолиИсполнителей.ПустаяСсылка());
				Задача.Записать();
			//КонецЦикла;	
			
			РассылкаУведомленийПользователям.ОтправитьУведомленияПоПочте(Задача.Ссылка, ПолучателиУведомления, ОбъектДокумент.Ссылка);
		КонецЕсли;
		// Евросиб US 90342 Рыбьяков К.А. 14.12.2025 ((
	ИначеЕсли ТипЗнч(ОбъектДокумент) = Тип("ДокументОбъект.РеестрСпециальныхСтавок") Тогда
		СтруктураПоиска = Новый Структура("Статус", Перечисления.СтатусыЭтапов.НаВыполнение);
		НайденнаяСтрока = ОбъектДокумент.Состояния.НайтиСтроки(СтруктураПоиска); 
		
		МассивИсполнителей = Новый Массив;
		МассивСостояний = Новый Массив;
		
		Для Каждого Строка Из НайденнаяСтрока Цикл
			МассивИсполнителей.Добавить(Строка.Исполнитель);
			МассивСостояний.Добавить(Строка.Состояние);
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗадачаИсполнителя.Ссылка КАК Ссылка
		|ИЗ
		|	Задача.ЗадачаИсполнителя КАК ЗадачаИсполнителя
		|ГДЕ
		|	ЗадачаИсполнителя.Состояние В(&Состояние)
		|	И ЗадачаИсполнителя.ОбъектЗадачи = &ОбъектЗадачи
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ГруппыПользователейСостав.Ссылка КАК ГруппаПользователей,
		|	ГруппыПользователейСостав.Пользователь КАК Пользователь
		|ИЗ
		|	Справочник.ГруппыПользователей.Состав КАК ГруппыПользователейСостав
		|ГДЕ
		|	ГруппыПользователейСостав.Ссылка В(&Ссылка)";
		
		Запрос.УстановитьПараметр("Ссылка", МассивИсполнителей);
		Запрос.УстановитьПараметр("Состояние", МассивСостояний);
		Запрос.УстановитьПараметр("ОбъектЗадачи", ОбъектДокумент.Ссылка);
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		
		СуществующиеЗадачи =  РезультатЗапроса[0].Выбрать();
		Если СуществующиеЗадачи.Количество() > 0 Тогда
			Возврат
		КонецЕсли;
		ПолучателиУведомления = Новый Массив;
		
		ЗадачиСогласования = Новый Массив;
		
		Для Каждого СтрокаСостояние Из МассивСостояний Цикл
			СтруктураПоиска = Новый Структура("Состояние", СтрокаСостояние);
			НайденнаяСтрока = ОбъектДокумент.Состояния.НайтиСтроки(СтруктураПоиска); 
			Если ТипЗнч(НайденнаяСтрока[0].Исполнитель) = Тип("СправочникСсылка.ГруппыПользователей") И ЗначениеЗаполнено(НайденнаяСтрока[0].Исполнитель) Тогда 
				Выборка = РезультатЗапроса[1].Выбрать();
				Пока Выборка.Следующий() Цикл
					ПолучателиУведомления.Добавить(Выборка.Пользователь);
				КонецЦикла;
			ИначеЕсли ТипЗнч(НайденнаяСтрока[0].Исполнитель) = Тип("СправочникСсылка.Пользователи") И ЗначениеЗаполнено(НайденнаяСтрока[0].Исполнитель) Тогда
				ПолучателиУведомления.Добавить(НайденнаяСтрока[0].Исполнитель);
			КонецЕсли;
			
			НаименованиеЗадачи = "Выполнить " + СтрокаСостояние;
			
			Задача = Задачи.ЗадачаИсполнителя.СоздатьЗадачу();
			Задача.Исполнитель  = НайденнаяСтрока[0].Исполнитель;
			Задача.Дата			= ТекущаяДата();
			Задача.ОбъектЗадачи	= ОбъектДокумент.Ссылка;
			Задача.Состояние	= СтрокаСостояние;
			Задача.Наименование	= НаименованиеЗадачи;
			Задача.Записать();
			ЗадачиСогласования.Добавить(Задача.Ссылка);
		КонецЦикла;
		
		ПолучателиУведомления = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ПолучателиУведомления);
		
		РассылкаУведомленийПользователям.ОтправитьУведомленияПоПочте(ЗадачиСогласования, ПолучателиУведомления, ОбъектДокумент.Ссылка);
		// Евросиб Рыбьяков К.А. 14.12.2025 ))
	КонецЕсли;
		
КонецПроцедуры