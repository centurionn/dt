
Процедура СозданиеОтчетовДляАРМ(ЭтаФорма) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОтчетыВ_АРМахСписокОтчетов.НаименованиеОтчета КАК НаименованиеОтчета,
	               |	ОтчетыВ_АРМахСписокОтчетов.НаименованиеОтчетаВСистеме КАК НаименованиеОтчетаВСистеме
	               |ИЗ
	               |	Справочник.ОтчетыВ_АРМах.СписокОтчетов КАК ОтчетыВ_АРМахСписокОтчетов
	               |ГДЕ
	               |	ОтчетыВ_АРМахСписокОтчетов.Ссылка.НаименованиеАРМаВСистеме = &НаименованиеАРМаВСистеме
	               |	И ОтчетыВ_АРМахСписокОтчетов.Ссылка.Пользователь = &Пользователь
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ОтчетыВ_АРМахСписокОтчетов.НомерСтроки";
	Запрос.УстановитьПараметр("НаименованиеАРМаВСистеме",СтрЗаменить(ЭтаФорма.ИмяФормы,"ОбщаяФорма.",""));
	Запрос.УстановитьПараметр("Пользователь",Пользователи.ТекущийПользователь());
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ОтчетыВ_АРМахСписокОтчетов.НаименованиеОтчета КАК НаименованиеОтчета,
		               |	ОтчетыВ_АРМахСписокОтчетов.НаименованиеОтчетаВСистеме КАК НаименованиеОтчетаВСистеме
		               |ИЗ
		               |	Справочник.ОтчетыВ_АРМах.СписокОтчетов КАК ОтчетыВ_АРМахСписокОтчетов
		               |ГДЕ
		               |	ОтчетыВ_АРМахСписокОтчетов.Ссылка.НаименованиеАРМаВСистеме = &НаименованиеАРМаВСистеме
		               |	И ОтчетыВ_АРМахСписокОтчетов.Ссылка.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	               	   |
		               |УПОРЯДОЧИТЬ ПО
		               |	ОтчетыВ_АРМахСписокОтчетов.НомерСтроки";
		Запрос.УстановитьПараметр("НаименованиеАРМаВСистеме",СтрЗаменить(ЭтаФорма.ИмяФормы,"ОбщаяФорма.",""));
		РезультатЗапроса = Запрос.Выполнить();
		
	КонецЕсли;	
		
	ТЗ = РезультатЗапроса.Выгрузить();
	
	Для Каждого Стр Из ТЗ Цикл
		
		Элемент = ЭтаФорма.Элементы.Добавить(Стр.НаименованиеОтчетаВСистеме,Тип("ДекорацияФормы"), ЭтаФорма.Элементы.ГруппаОтчеты);  

		Элемент.Гиперссылка = Истина;
		Элемент.Заголовок = Стр.НаименованиеОтчета; 

		Элемент.Подсказка = "Сформировать отчет " + Стр.НаименованиеОтчета;
		Элемент.УстановитьДействие("ОбработкаНавигационнойСсылки", "ОтчетОбработкаНавигационнойСсылки" );
	    Элемент.УстановитьДействие("Нажатие", "ОтчетОбработкаНавигационнойСсылки");
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьЗначениеПоказателя(Показатель, Отборы) Экспорт
	
	Результат = 88;
	
	// таблица показателей
	
	Если Показатель = "ВходящиеЗадачи" Тогда
		Результат = ПолучитьВходящиеЗадачиКонтекста(Отборы.Контекст);
	ИначеЕсли Показатель = "ИсходящиеЗадачи" Тогда
		Результат = ПолучитьИсходящиеЗадачиКонтекста(Отборы.Контекст);
	ИначеЕсли Показатель = Перечисления.ПоказателиОперативные.КоличествоОтправок Тогда
		Результат = ПолучитьКолвоОтправок(Отборы.Контекст);
	ИначеЕсли Показатель = Перечисления.ПоказателиОперативные.Простой Тогда
		Результат = ПолучитьПростой(Отборы.Контекст);
	ИначеЕсли Показатель = Перечисления.ПоказателиОперативные.ПодтвержденныйНДС Тогда
		Результат = ПолучитьПодтвержденныйНДС(Отборы.Контекст);
	ИначеЕсли Показатель = Перечисления.ПоказателиОперативные.ПоступленияИОплаты Тогда
		Результат = ПолучитьПоступленияИОплаты(Отборы.Контекст);
	ИначеЕсли Показатель = Перечисления.ПоказателиОперативные.НеподтвержденныеРасходы Тогда
		Результат = ПолучитьНеподтвержденныеРасходы(Отборы.Контекст);
	ИначеЕсли Показатель = Перечисления.ПоказателиОперативные.НРП Тогда
		Результат = ПолучитьНРП(Отборы.Контекст);
	ИначеЕсли Показатель = Перечисления.ПоказателиОперативные.ВидыРемонтов Тогда
		Результат = ПолучитьПлановыйРемонт(Отборы.Контекст);
	КонецЕсли;
	
	
	Возврат Результат;
	
КонецФункции

/// БЛОК РАСЧЕТА ПОКАЗАТЕЛЕЙ ///

Функция ПолучитьВходящиеЗадачиКонтекста(Контекст)
	
	Результат = Новый Массив;
	ЗамПользователя = Пользователи_sd_сервер.ПодобратьЗамещениеОбратное(Контекст, текущаяДата());
	СписокМоихГрупп = Пользователи_sd_сервер.ПолучитьСписокМоихГрупп(Контекст, ЗамПользователя);
	// ДИТ Поморцева Т.П. 238786 20.08.2021 начало
	//СписокМоихГрупп.Добавить(Контекст);
	//СписокМоихГрупп.Добавить(ЗамПользователя);
	Для Каждого Элемент ИЗ ЗамПользователя Цикл
		СписокМоихГрупп.Добавить(Элемент);
	КонецЦикла;
	// ДИТ Поморцева Т.П. 238786 20.08.2021 конец
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛичныеЦелиЪ.Ссылка КАК Ссылка,
	               |	ЛичныеЦелиЪ.Автор КАК Автор,
	               |	ЛичныеЦелиСостояния.Статус КАК Статус,
	               |	ЛичныеЦелиЪ.ОписаниеЦели КАК ОписаниеЦели,
	               |	ЛичныеЦелиЪ.СрокДостижения КАК СрокДостижения,
	               |	ЛичныеЦелиЪ.НачалоРаботы КАК НачалоРаботы
	               |ИЗ
	               |	Документ.ЛичныеЦели КАК ЛичныеЦелиЪ
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЛичныеЦели.Состояния КАК ЛичныеЦелиСостояния
	               |		ПО ЛичныеЦелиЪ.Ссылка = ЛичныеЦелиСостояния.Ссылка
	               |			И ЛичныеЦелиЪ.ТекущееСостояние = ЛичныеЦелиСостояния.Состояние
	               |ГДЕ
	               |	ЛичныеЦелиЪ.Проведен
	               |	И ЛичныеЦелиЪ.Сотрудник В(&Сотрудник)";
	Запрос.УстановитьПараметр("Сотрудник", Контекст);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		Результат.Добавить(Новый Структура("Задача,Статус,Постановщик,ДатаПостановки,СрокИсполнения", Ответ.ОписаниеЦели, Ответ.Статус, Ответ.Автор, Ответ.НачалоРаботы, Ответ.СрокДостижения));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьИсходящиеЗадачиКонтекста(Контекст)
	
	Результат = Новый Массив;
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛичныеЦелиЪ.Ссылка КАК Ссылка,
	               |	ЛичныеЦелиЪ.Автор КАК Автор,
	               |	ЛичныеЦелиСостояния.Статус КАК Статус,
	               |	ЛичныеЦелиЪ.ОписаниеЦели КАК ОписаниеЦели,
	               |	ЛичныеЦелиЪ.СрокДостижения КАК СрокДостижения,
	               |	ЛичныеЦелиЪ.НачалоРаботы КАК НачалоРаботы
	               |ИЗ
	               |	Документ.ЛичныеЦели КАК ЛичныеЦелиЪ
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЛичныеЦели.Состояния КАК ЛичныеЦелиСостояния
	               |		ПО ЛичныеЦелиЪ.Ссылка = ЛичныеЦелиСостояния.Ссылка
	               |			И ЛичныеЦелиЪ.ТекущееСостояние = ЛичныеЦелиСостояния.Состояние
	               |ГДЕ
	               |	ЛичныеЦелиЪ.Проведен
				   // ДИТ Поморцева Т.П. Задача 238786 16.08.21. начало
	               //|	И (ЛичныеЦелиЪ.Автор = &Автор ИЛИ ЛичныеЦелиЪ.Автор = &Замещение)";
				   |	И (ЛичныеЦелиЪ.Автор = &Автор ИЛИ ЛичныеЦелиЪ.Автор в (&Замещение))";
				   // ДИТ Поморцева Т.П. Задача 238786 16.08.21. конец
				   
	Запрос.УстановитьПараметр("Автор", Контекст);
	Запрос.УстановитьПараметр("Замещение", Пользователи_sd_сервер.ПодобратьЗамещениеОбратное(Контекст, текущаяДата()));
		
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		Результат.Добавить(Новый Структура("Задача,Статус,Постановщик,ДатаПостановки,СрокИсполнения", Ответ.ОписаниеЦели, Ответ.Статус, Ответ.Автор, Ответ.НачалоРаботы, Ответ.СрокДостижения));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьКолвоОтправок(Контекст)
	
	КолвоОпераций = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОперацииВСделках.Операция) КАК Операция
	               |ИЗ
	               |	РегистрСведений.ОперацииВСделках КАК ОперацииВСделках
	               |ГДЕ
	               |	ОперацииВСделках.ДатаОтправленияФакт МЕЖДУ &ДатаНач И &ДатаКон";
	Запрос.УстановитьПараметр("ДатаНач",Контекст.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКон",Контекст.ДатаОкончания);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() ТОгда
		КолвоОпераций = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Операция")[0];
	КонецЕсли;
	
	Возврат КолвоОпераций;
	
КонецФункции

Функция ПолучитьПростой(Контекст)
	
	КолвоПростоя = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДислокацияВагоновСрезПоследних.Вагон КАК Вагон
	               |ПОМЕСТИТЬ ВагоныПростой
	               |ИЗ
	               |	РегистрСведений.ДислокацияВагонов.СрезПоследних(&ДатаКон, ) КАК ДислокацияВагоновСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналогиЛокаций КАК АналогиЛокаций
	               |		ПО ДислокацияВагоновСрезПоследних.СтанцияОперации = АналогиЛокаций.Локация
	               |ГДЕ
	               |	(ДислокацияВагоновСрезПоследних.СтанцияОперации = ДислокацияВагоновСрезПоследних.СтанцияНазначения
	               |			ИЛИ ДислокацияВагоновСрезПоследних.СтанцияНазначения = АналогиЛокаций.Аналог)
	               |	И РАЗНОСТЬДАТ(ДислокацияВагоновСрезПоследних.Период, &ДатаКон, ДЕНЬ) > 3
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДислокацияКонтейнеровСрезПоследних.Контейнер КАК Контейнер
	               |ПОМЕСТИТЬ КонтейнерыПростой
	               |ИЗ
	               |	РегистрСведений.ДислокацияКонтейнеров.СрезПоследних(&ДатаКон, ) КАК ДислокацияКонтейнеровСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналогиЛокаций КАК АналогиЛокаций
	               |		ПО ДислокацияКонтейнеровСрезПоследних.СтанцияОперации = АналогиЛокаций.Локация
	               |ГДЕ
	               |	(ДислокацияКонтейнеровСрезПоследних.СтанцияОперации = ДислокацияКонтейнеровСрезПоследних.СтанцияНазначения
	               |			ИЛИ ДислокацияКонтейнеровСрезПоследних.СтанцияНазначения = АналогиЛокаций.Аналог)
	               |	И РАЗНОСТЬДАТ(ДислокацияКонтейнеровСрезПоследних.Период, &ДатаКон, ДЕНЬ) > 3
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВагоныПростой.Вагон) КАК КоличествоТСТЕ
	               |ИЗ
	               |	ВагоныПростой КАК ВагоныПростой
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КонтейнерыПростой.Контейнер)
	               |ИЗ
	               |	КонтейнерыПростой КАК КонтейнерыПростой";
	Запрос.УстановитьПараметр("ДатаКон",Контекст.ДатаОкончания);
	
	РезультатЗапроса = Запрос.Выполнить();
	ТЗ = РезультатЗапроса.Выгрузить();
	Если ТЗ.Количество() = 1 Тогда
		КолвоПростоя = ТЗ[0].КоличествоТСТЕ;
	ИначеЕсли ТЗ.Количество() = 2 Тогда
		КолвоПростоя = Строка(ТЗ[0].КоличествоТСТЕ) + "/" + Строка(ТЗ[1].КоличествоТСТЕ);
	КонецЕсли;
	
	Возврат КолвоПростоя;
	
КонецФункции

