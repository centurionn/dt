Функция ОпределитьПринадлежностьПоВидуСобственности(ВидСобственности) Экспорт
	
	Результат = неопределено;
	
	СписокКлиентские = Новый Массив;
	// ДИТ 65580 Давудов М.А. Начало: 23.02.2023
	//Было:
	//СписокКлиентские.Добавить(Перечисления.ВариантыСобственности.Прочее);
	//Стало:
	СписокКлиентские.Добавить(Перечисления.ВариантыСобственности.Клиентский);
	// ДИТ 65580 Давудов М.А. Конец: 23.02.2023
	
	СписокСобственные = Новый Массив;
	СписокСобственные.Добавить(Перечисления.ВариантыСобственности.Собственный);
	// ДИТ 65580 Давудов М.А. Начало: 23.02.2023
	//Было:
	//СписокСобственные.Добавить(Перечисления.ВариантыСобственности.Арендованный);
	//СписокСобственные.Добавить(Перечисления.ВариантыСобственности.Доплатные);
	//СписокСобственные.Добавить(Перечисления.ВариантыСобственности.Море);
	//Стало:
	СписокСобственные.Добавить(Перечисления.ВариантыСобственности.АрендаДлительная);
	СписокСобственные.Добавить(Перечисления.ВариантыСобственности.СпотДоплатный);
	СписокСобственные.Добавить(Перечисления.ВариантыСобственности.СпотМорской);
	// ДИТ 65580 Давудов М.А. Конец: 23.02.2023
	СписокСобственные.Добавить(Перечисления.ВариантыСобственности.Спот);
	
	Если СписокКлиентские.Найти(ВидСобственности) <> неопределено Тогда
		Результат = Перечисления.ПринадлежностьТЕ.КТКлиента;
	ИначеЕсли СписокСобственные.Найти(ВидСобственности) <> неопределено Тогда
		Результат = Перечисления.ПринадлежностьТЕ.КТЕвросиба;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьВидСобственностиПоПринадлежности(ПринадлежностьКТК) Экспорт
	
	Результат = Новый Массив;
	
	Если ПринадлежностьКТК = Перечисления.ПринадлежностьТЕ.КТКлиента Тогда
		// ДИТ 65580 Давудов М.А. Начало: 23.02.2023
		//Было:
		//Результат.Добавить(Перечисления.ВариантыСобственности.Прочее);
		//Стало:
		Результат.Добавить(Перечисления.ВариантыСобственности.Клиентский);
		// ДИТ 65580 Давудов М.А. Конец: 23.02.2023
	ИначеЕсли ПринадлежностьКТК = Перечисления.ПринадлежностьТЕ.КТЕвросиба Тогда
		Результат.Добавить(Перечисления.ВариантыСобственности.Собственный);
		// ДИТ 65580 Давудов М.А. Начало: 23.02.2023
		//Было:
		//Результат.Добавить(Перечисления.ВариантыСобственности.Арендованный);
		//Результат.Добавить(Перечисления.ВариантыСобственности.Доплатные);
		//Результат.Добавить(Перечисления.ВариантыСобственности.Море);
		//Стало:
		Результат.Добавить(Перечисления.ВариантыСобственности.АрендаДлительная);
		Результат.Добавить(Перечисления.ВариантыСобственности.СпотДоплатный);
		Результат.Добавить(Перечисления.ВариантыСобственности.СпотМорской);
		// ДИТ 65580 Давудов М.А. Конец: 23.02.2023
		Результат.Добавить(Перечисления.ВариантыСобственности.Спот);
	КонецЕсли;
	
	Возврат Результат;
	
