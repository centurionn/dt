Функция ПолучитьВзаимодействиеДоплаты(Клиент)
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗапланированноеВзаимодействие.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ЗапланированноеВзаимодействие КАК ЗапланированноеВзаимодействие
	               |ГДЕ
	               |	ЗапланированноеВзаимодействие.ЗадачаПоДоплатнымКТК = &ЗадачаПоДоплатнымКТК
	               |	И НЕ ЗапланированноеВзаимодействие.ПометкаУдаления";
	Запрос.УстановитьПараметр("ЗадачаПоДоплатнымКТК", Клиент);
