Функция ПолучитьПоступленияИОплаты(Контекст)
	
	ПоступленияСписания = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВзаиморасчетыСПоставщикамиОстаткиИОбороты.СуммаСНДСОборот + ВзаиморасчетыСПокупателямиОстатки.СуммаСНДСОстаток КАК ПоступленияНаРС
	               |ПОМЕСТИТЬ Поступления
	               |ИЗ
	               |	РегистрНакопления.ВзаиморасчетыСПокупателями.Остатки(&ДатаКон, ДокументВзаиморасчетов ССЫЛКА Документ.ПоступлениеНаРасчетныйСчет) КАК ВзаиморасчетыСПокупателямиОстатки,
	               |	РегистрНакопления.ВзаиморасчетыСПоставщиками.ОстаткиИОбороты(, &ДатаКон, Авто, , ) КАК ВзаиморасчетыСПоставщикамиОстаткиИОбороты
	               |ГДЕ
	               |	ВзаиморасчетыСПоставщикамиОстаткиИОбороты.Регистратор ССЫЛКА Документ.ПоступлениеНаРасчетныйСчет
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВзаиморасчетыСПоставщикамиОстаткиИОбороты.СуммаСНДСОборот + ВзаиморасчетыСПокупателямиОстатки.СуммаСНДСОстаток КАК СписанияСРС
	               |ПОМЕСТИТЬ Списания
	               |ИЗ
	               |	РегистрНакопления.ВзаиморасчетыСПокупателями.Остатки(&ДатаКон, ДокументВзаиморасчетов ССЫЛКА Документ.СписаниеСРасчетногоСчета) КАК ВзаиморасчетыСПокупателямиОстатки,
	               |	РегистрНакопления.ВзаиморасчетыСПоставщиками.ОстаткиИОбороты(, &ДатаКон, Авто, , ) КАК ВзаиморасчетыСПоставщикамиОстаткиИОбороты
	               |ГДЕ
	               |	ВзаиморасчетыСПоставщикамиОстаткиИОбороты.Регистратор ССЫЛКА Документ.СписаниеСРасчетногоСчета
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Поступления.ПоступленияНаРС КАК ПоступленияСписания
	               |ИЗ
	               |	Поступления КАК Поступления
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	Списания.СписанияСРС
	               |ИЗ
	               |	Списания КАК Списания";
	
	Запрос.УстановитьПараметр("ДатаКон",Контекст.ДатаОкончания);
	
	РезультатЗапроса = Запрос.Выполнить();
	ТЗ = РезультатЗапроса.Выгрузить();
	Если ТЗ.Количество() = 1 Тогда
		ПоступленияСписания = ТЗ[0].ПоступленияСписания;
	ИначеЕсли ТЗ.Количество() = 2 Тогда
		ПоступленияСписания = Строка(ТЗ[0].ПоступленияСписания) + "/" + Строка(ТЗ[1].ПоступленияСписания);
	КонецЕсли;
	
	Возврат ПоступленияСписания;
	
КонецФункции

