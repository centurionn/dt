// Функции ЧТЗ "Циклы аренды КТК"

Функция ПоКТКЕстьУказаннаяДатаВозвратаКлиентом(КТК, УказаннаяДата) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	стоки_КлиентскоеОперирование.ГУИДЗаписи КАК ГУИДЗаписи
	               |ИЗ
	               |	РегистрСведений.стоки_КлиентскоеОперирование КАК стоки_КлиентскоеОперирование
	               |ГДЕ
	               |	стоки_КлиентскоеОперирование.КТК = &КТК
	               |	И НАЧАЛОПЕРИОДА(стоки_КлиентскоеОперирование.кл_ДатаВозврата, ДЕНЬ) = &ИскомаяДата";
	Запрос.УстановитьПараметр("КТК", КТК);
	Запрос.УстановитьПараметр("ИскомаяДата", НачалоДня(УказаннаяДата));
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

