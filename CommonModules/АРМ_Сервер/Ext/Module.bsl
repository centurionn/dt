Функция ПолучитьНРП(Контекст)
	
	КолвоНРП = "";
	
	Запрос = Новый Запрос;
	
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(ВЫБОР
	               |			КОГДА ПризнакСобственностиВагонаСрезПоследних.ПризнакСобственности = ЗНАЧЕНИЕ(Перечисление.ВариантыСобственности.Спот)
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК СпотНРП,
	               |	СУММА(ВЫБОР
	               |			КОГДА ПризнакСобственностиВагонаСрезПоследних.ПризнакСобственности = ЗНАЧЕНИЕ(Перечисление.ВариантыСобственности.Собственный)
				   // ДИТ 65580 Давудов М.А. Начало: 23.02.2023
				   //Было:
	               //|					ИЛИ ПризнакСобственностиВагонаСрезПоследних.ПризнакСобственности = ЗНАЧЕНИЕ(Перечисление.ВариантыСобственности.Арендованный)
				   //Стало:
	               |					ИЛИ ПризнакСобственностиВагонаСрезПоследних.ПризнакСобственности = ЗНАЧЕНИЕ(Перечисление.ВариантыСобственности.АрендаДлительная)
				   // ДИТ 65580 Давудов М.А. Конец: 23.02.2023
				   |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК АрСобНРП
	               |ИЗ
	               |	РегистрСведений.ВагоныНаСлежении.СрезПоследних(&ДатаКон, ) КАК ВагоныНаСлеженииСрезПоследних
	               |		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакСобственностиВагона.СрезПоследних(&ДатаКон, ) КАК ПризнакСобственностиВагонаСрезПоследних
	               |		ПО ВагоныНаСлеженииСрезПоследних.Вагон = ПризнакСобственностиВагонаСрезПоследних.Вагон
	               |ГДЕ
	               |	НЕ ПризнакСобственностиВагонаСрезПоследних.ВЭксплуатации";
	Запрос.УстановитьПараметр("ДатаКон",Контекст.ДатаОкончания);
	
	РезультатЗапроса = Запрос.Выполнить();
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() ТОгда
		СпотНРП = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("СпотНРП")[0];
		АрСобНРП = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("АрСобНРП")[0];
		КолвоНРП = Строка(СпотНРП) + "/" + Строка(АрСобНРП);
	КонецЕсли;
	
	Возврат КолвоНРП;
	
КонецФункции

Функция ПолучитьПлановыйРемонт(Контекст)
	
	КолвоПланРем = "";
	
	Запрос = Новый Запрос;
	
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(ВЫБОР
	               |			КОГДА РемонтныеВедомости.ВидРемонта В (&Кап)
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК Капитальный,
	               |	СУММА(ВЫБОР
	               |			КОГДА РемонтныеВедомости.ВидРемонта В (&Деп)
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК Деповской,
	               |	СУММА(ВЫБОР
	               |			КОГДА РемонтныеВедомости.ВидРемонта В (&Тек)
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК Текущий
	               |ИЗ
	               |	Документ.РемонтныеВедомости КАК РемонтныеВедомости
	               |ГДЕ
	               |	РемонтныеВедомости.ВидРемонта В(&ВидРемонта)
	               |	И РемонтныеВедомости.ДатаНачалаРемонта < &ДатаКон
	               |			И РемонтныеВедомости.ДатаНачалаРемонта > &ДатаНач
	               |			И (РемонтныеВедомости.ДатаОкончанияРемонта = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |				ИЛИ РемонтныеВедомости.ДатаОкончанияРемонта > &ДатаКон)";
	СписокВидовРемонта = Новый СписокЗначений;
	СписокВидовРемонта.Добавить(Перечисления.ВидыРемонтов.Деповской);
	СписокВидовРемонта.Добавить(Перечисления.ВидыРемонтов.ДеповскойПоПробегу);
	СписокВидовРемонта.Добавить(Перечисления.ВидыРемонтов.Капитальный);
	СписокВидовРемонта.Добавить(Перечисления.ВидыРемонтов.КапитальныйПоПробегу);
	СписокВидовРемонта.Добавить(Перечисления.ВидыРемонтов.ТекущийТР1);
	СписокВидовРемонта.Добавить(Перечисления.ВидыРемонтов.ТекущийТР2);
	
	СписокДеп = Новый СписокЗначений;
	СписокДеп.Добавить(Перечисления.ВидыРемонтов.Деповской);
	СписокДеп.Добавить(Перечисления.ВидыРемонтов.ДеповскойПоПробегу);
	
	СписокКап = Новый СписокЗначений;
	СписокКап.Добавить(Перечисления.ВидыРемонтов.Капитальный);
	СписокКап.Добавить(Перечисления.ВидыРемонтов.КапитальныйПоПробегу);
	
	СписокТек = Новый СписокЗначений;
	СписокТек.Добавить(Перечисления.ВидыРемонтов.ТекущийТР1);
	СписокТек.Добавить(Перечисления.ВидыРемонтов.ТекущийТР2);
	
	
	Запрос.УстановитьПараметр("ВидРемонта",СписокВидовРемонта);
	Запрос.УстановитьПараметр("Кап",СписокКап);
	Запрос.УстановитьПараметр("Деп",СписокДеп);
	Запрос.УстановитьПараметр("Тек",СписокТек);
	Запрос.УстановитьПараметр("ДатаКон",Контекст.ДатаОкончания);
	Запрос.УстановитьПараметр("ДатаНач",Контекст.ДатаНачала);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() ТОгда
		КолвоТек = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Текущий")[0];
		КолвоДеп = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Деповской")[0];
		КолвоКап = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Капитальный")[0];
		КолвоПланРем = Строка(КолвоТек) + "/" + Строка(КолвоДеп) + "/" +Строка(КолвоКап);
	КонецЕсли;
	
	Возврат КолвоПланРем;
	
КонецФункции

Процедура ОбновитьЗадачиПоДоплатнымКТК() Экспорт
	
	МассивКлиентовСАктивнымиЗадачами = Новый Массив;
	
	// 1. Определяем, по каким клиентам должны быть задачи
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	стоки_КлиентскоеОперированиеСрезПоследних.допл_Клиент КАК допл_Клиент,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.допл_Договор КАК допл_Договор,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.допл_Калькуляция КАК допл_Калькуляция,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.допл_ПСЦ КАК допл_ПСЦ,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.КТК КАК КТК
	               |ИЗ
	               |	РегистрСведений.стоки_КлиентскоеОперирование.СрезПоследних КАК стоки_КлиентскоеОперированиеСрезПоследних
	               |ГДЕ
	               |	стоки_КлиентскоеОперированиеСрезПоследних.допл_Клиент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)";
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		Если ЗначениеЗаполнено(Ответ.допл_Клиент) И НЕ ЗначениеЗаполнено(Ответ.допл_ПСЦ) И МассивКлиентовСАктивнымиЗадачами.Найти(Ответ.допл_Клиент) = неопределено Тогда
			МассивКлиентовСАктивнымиЗадачами.Добавить(Ответ.допл_Клиент);
		КонецЕсли;
	КонецЦикла;
	
	// 2. Закрываем все прочие задачи
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗапланированноеВзаимодействие.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ЗапланированноеВзаимодействие КАК ЗапланированноеВзаимодействие
	               |ГДЕ
	               |	ЗапланированноеВзаимодействие.ПометкаУдаления = ЛОЖЬ
	               |	И НЕ ЗапланированноеВзаимодействие.ЗадачаПоДоплатнымКТК В (&ЗадачаПоДоплатнымКТК)
	               |	И ЗапланированноеВзаимодействие.ЗадачаПоДоплатнымКТК <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)";
	Запрос.УстановитьПараметр("ЗадачаПоДоплатнымКТК", МассивКлиентовСАктивнымиЗадачами);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		ВзаимО = Ответ.Ссылка.ПолучитьОбъект();
		ВзаимО.Статус = Перечисления.СтатусыЭтапов.Выполнен;
		ВзаимО.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
	
	// 3. Формируем задачи менеджерам в разрезе клиентов
	Для каждого Кл из МассивКлиентовСАктивнымиЗадачами Цикл
		
		ВзО = Документы.ЗапланированноеВзаимодействие.СоздатьДокумент();
		Вз = ПолучитьВзаимодействиеДоплаты(Кл);
		Если Вз <> неопределено Тогда
			ВзО = Вз.ПолучитьОбъект();
		КонецЕсли;
		ВзО.ПометкаУдаления = Ложь;
		//ВзО.Участники.Очистить();
		ВзО.Автор = Пользователи.ТекущийПользователь();
		ВзО.Важность = Перечисления.ВариантыВажностиВзаимодействия.Обычная;
		
		ВзО.ДатаНачала = ТекущаяДата();
		ВзО.ДатаОкончания = ТекущаяДата()+24*3600;
		
		ТабличкаКТК = ПолучитьСписокКТКСтолбикомКлиента(Кл);
		
		ВзО.Описание = "Необходимо оформить протоколы по клиенту " + Кл + " по следующим доплатным КТК:" + Символы.ПС + ТабличкаКТК;
		ОтвИсполнитель = ПолучитьОтветственногоПользователя(Кл);
		Если ВзО.Участники.НайтиСтроки(Новый Структура("Контакт", ОтвИсполнитель)).Количество() = 0 Тогда
			НСтр = ВзО.Участники.Добавить();
			НСтр.Контакт = ОтвИсполнитель;
			НСтр.ПредставлениеКонтакта = ОтвИсполнитель;
			НСтр.КакСвязаться = ОтвИсполнитель;
			ВзО.Ответственный = ОтвИсполнитель;
			ВзО.СписокУчастников = ОтвИсполнитель;
		КонецЕсли;
		ВзО.Тема = "Ввести ПСЦ по допл. клиенту: " + Кл;
		ВзО.Комментарий = "Задача обновлена " + ТекущаяДата();
		ВзО.СоздатьПроизводственнуюЗадачу = Истина;
		ВзО.Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
		ВзО.ЗадачаПоДоплатнымКТК = Кл;
		ВзО.Дата = ТекущаяДата();
		ВзО.Записать(РежимЗаписиДокумента.Проведение);
		
		Для каждого Исп из ВзО.Участники Цикл
			МЗ = РегистрыСведений.УведомленияПользователейОЗадачах.СоздатьМенеджерЗаписи();
			МЗ.Документ = ВзО.Ссылка;
			МЗ.Пользователь = Исп.Контакт;
			МЗ.Состояние = Справочники.Состояния.Выполнение;
			МЗ.Период = ТекущаяДата();
			Если ЗначениеЗаполнено(МЗ.Пользователь) Тогда
				МЗ.Записать(Истина);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьОтветственногоПользователя(Клиент)
	
	Результат = Пользователи.ТекущийПользователь();
	
	Конст = Константы.ЕдиныйОтветственныйЗаОформлениеПСЦПоДоплатам.Получить();
	Если ЗначениеЗаполнено(Конст) Тогда
		Результат = Конст;
	КонецЕсли;
	
	Возврат Результат;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	стоки_КлиентскоеОперированиеСрезПоследних.КТК КАК КТК,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.кл_Договор КАК кл_Договор,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.кл_Клиент КАК кл_Клиент,
	               |	ВложенныйЗапрос.Ссылка КАК СлучайныйДоговор
	               |ИЗ
	               |	РегистрСведений.стоки_КлиентскоеОперирование.СрезПоследних КАК стоки_КлиентскоеОперированиеСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ДоговорыКонтрагентов.Владелец КАК Владелец,
	               |			МАКСИМУМ(ДоговорыКонтрагентов.Ссылка) КАК Ссылка
	               |		ИЗ
	               |			Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	               |		ГДЕ
	               |			ДоговорыКонтрагентов.ПометкаУдаления = ЛОЖЬ
	               |			И ДоговорыКонтрагентов.ВидДоговора = &ВидДоговора
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ДоговорыКонтрагентов.Владелец) КАК ВложенныйЗапрос
	               |		ПО стоки_КлиентскоеОперированиеСрезПоследних.допл_Клиент = ВложенныйЗапрос.Владелец
	               |ГДЕ
	               |	стоки_КлиентскоеОперированиеСрезПоследних.допл_Клиент = &допл_Клиент
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	кл_Договор УБЫВ";
	Запрос.УстановитьПараметр("допл_Клиент", Клиент);
	Запрос.УстановитьПараметр("ВидДоговора", Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		// ДИТ US 51951 TA 61497 Евсенкин М.А. Начало: 30.11.2022
		// Было:
		//Если ЗначениеЗаполнено(Ответ.кл_Договор) И ЗначениеЗаполнено(Ответ.кл_Договор.ОтветственныйЗаСопровождение) Тогда
		//	Результат = Ответ.кл_Договор.ОтветственныйЗаСопровождение;
		//ИначеЕсли ЗначениеЗаполнено(Ответ.СлучайныйДоговор) И ЗначениеЗаполнено(Ответ.СлучайныйДоговор.ОтветственныйЗаСопровождение) Тогда
		//	Результат = Ответ.СлучайныйДоговор.ОтветственныйЗаСопровождение;
		//КонецЕсли; 
		//Стало: 
		//ДоговорОтветственныйЗаСопровождение = Справочники.ДоговорыКонтрагентов.ПолучитьОтветственного(Ответ.кл_Договор,"ОтветственныйЗаСопровождение");
		//СлучайныйДоговорОтветственныйЗаСопровождение = Справочники.ДоговорыКонтрагентов.ПолучитьОтветственного(Ответ.СлучайныйДоговор,"ОтветственныйЗаСопровождение");
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Договор",				Ответ.кл_Договор);
		СтруктураПараметров.Вставить("ЦФО",					Справочники.ЦентрыФинансовойОтветственности.ОсновнойЦФО);
		СтруктураПараметров.Вставить("ТипОтветственного",	Перечисления.ТипыОтветственных.ОтветственныйЗаСопровождениеыйЗаУчет);  
		ДоговорОтветственныйЗаСопровождение = Справочники.ДоговорыКонтрагентов.ПолучитьОтветственного(СтруктураПараметров);
		СтруктураПараметров.Вставить("Договор",				Ответ.СлучайныйДоговор);
		СлучайныйДоговорОтветственныйЗаСопровождение =  Справочники.ДоговорыКонтрагентов.ПолучитьОтветственного(СтруктураПараметров);	
		Если ЗначениеЗаполнено(Ответ.кл_Договор) И ЗначениеЗаполнено(ДоговорОтветственныйЗаСопровождение) Тогда
			Результат = ДоговорОтветственныйЗаСопровождение;
		ИначеЕсли ЗначениеЗаполнено(Ответ.СлучайныйДоговор) И ЗначениеЗаполнено(СлучайныйДоговорОтветственныйЗаСопровождение) Тогда
			Результат = СлучайныйДоговорОтветственныйЗаСопровождение;
		КонецЕсли;
		// ДИТ US 51951 TA 61497 Евсенкин М.А. Конец: 30.11.2022
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСписокКТКСтолбикомКлиента(Клиент)
	
	Описание = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	стоки_КлиентскоеОперированиеСрезПоследних.КТК КАК КТК,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.допл_ПунктОтправления КАК допл_ПунктОтправления,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.допл_ПунктНазначения КАК допл_ПунктНазначения,
	               |	стоки_ТекущиеДанныеСрезПоследних.комм_Ставка КАК комм_Ставка,
	               |	стоки_ТекущиеДанныеСрезПоследних.комм_Валюта КАК комм_Валюта,
	               |	стоки_ТекущиеДанныеСрезПоследних.тек_ДатаПриемаВПользование КАК тек_ДатаПриемаВПользование
	               |ИЗ
	               |	РегистрСведений.стоки_КлиентскоеОперирование.СрезПоследних КАК стоки_КлиентскоеОперированиеСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.стоки_ТекущиеДанные.СрезПоследних КАК стоки_ТекущиеДанныеСрезПоследних
	               |		ПО стоки_КлиентскоеОперированиеСрезПоследних.КТК = стоки_ТекущиеДанныеСрезПоследних.КТК
	               |ГДЕ
	               |	стоки_КлиентскоеОперированиеСрезПоследних.допл_Клиент = &допл_Клиент
	               |	И стоки_КлиентскоеОперированиеСрезПоследних.допл_ПСЦ = &допл_ПСЦ";
	Запрос.УстановитьПараметр("допл_Клиент", Клиент);
