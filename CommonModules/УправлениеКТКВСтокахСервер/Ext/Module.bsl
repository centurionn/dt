Процедура КонтейнерыВСтоках_ДобавитьПриход(НаборДвижений, НомерКТК, Сток, Назначение, Контрагент, ДатаПриемаВПользованиеПередПоставщиком, СрокВозврата) Экспорт
	
	Если НЕ ЗначениеЗаполнено(НомерКТК) ИЛИ НЕ ЗначениеЗаполнено(Контрагент) Тогда Возврат; КонецЕсли;
	
	СторнироватьПредыдущееМестоположение(НаборДвижений, НомерКТК, ДатаПриемаВПользованиеПередПоставщиком);
	
	Движение = НаборДвижений.КонтейнерыВСтоках.ДобавитьПриход();
	Движение.Контейнер = НомерКТК;
	Движение.Сток = Сток;
	Движение.Назначение = Назначение;
	Движение.Контрагент = Контрагент;
	Движение.ДатаПриемаВСток = ДатаПриемаВПользованиеПередПоставщиком;
	Движение.СрокВозврата = СрокВозврата;
	Движение.Количество = 1;
	Движение.Период = ДатаПриемаВПользованиеПередПоставщиком;
	
	Движение = НаборДвижений.СтатусыКТК.Добавить();
	Движение.Период = ДатаПриемаВПользованиеПередПоставщиком;
	Движение.Контейнер = НомерКТК;
	Движение.Количество = 1;
	Движение.Сток = Сток;
	Движение.Направление = Назначение;
	Движение.Контрагент = Контрагент;
	Движение.Статус = Перечисления.СтатусыКТК.Свободен;
	
КонецПроцедуры

Процедура КонтейнерыВСтоках_СнятьСУчета(НаборДвижений, НомерКТК, ДатаСнятияСУчета) Экспорт
	
	Если НЕ ЗначениеЗаполнено(НомерКТК) ИЛИ НЕ ЗначениеЗаполнено(ДатаСнятияСУчета) Тогда Возврат; КонецЕсли;
	
	СторнироватьПредыдущееМестоположение(НаборДвижений, НомерКТК, ДатаСнятияСУчета+1);
	
	СоответствиеПараметры = Новый Соответствие;
	СоответствиеПараметры.Вставить("ВозвратВСток", ДатаСнятияСУчета);
	СоответствиеПараметры.Вставить("ВозвратОтКлиента", ДатаСнятияСУчета);
	УправлениеКТКВСтокахСервер.ДобавитьЗаписьИспользованияКонтейнера(ДатаСнятияСУчета, НомерКТК, СоответствиеПараметры, Ложь);
	
КонецПроцедуры

Процедура СторнироватьПредыдущееМестоположение(НаборДвижений, НомерКТК, ДатаПриемаВПользованиеПередПоставщиком)
	
	Ответ = ПолучитьПредыдущиеДанныеСтока(НомерКТК, ДатаПриемаВПользованиеПередПоставщиком-1);
	
	Если Ответ.Количество() > 0 Тогда
		Движение = НаборДвижений.КонтейнерыВСтоках.ДобавитьРасход();
		ЗаполнитьЗначенияСвойств(Движение, Ответ[0]);
		Движение.Период = ДатаПриемаВПользованиеПередПоставщиком-1;
		Движение.Количество = Ответ[0].КоличествоОстаток;
	КонецЕсли;
	
	Для каждого Стр из НаборДвижений.КонтейнерыВСтоках Цикл
		Если Стр.Контейнер = НомерКТК И Стр.ВидДвижения = ВидДвиженияНакопления.Приход Тогда 
			
			Движение = НаборДвижений.КонтейнерыВСтоках.ДобавитьРасход();
			ЗаполнитьЗначенияСвойств(Движение, Стр);
			Движение.Период = ДатаПриемаВПользованиеПередПоставщиком;
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьЗаписьИспользованияКонтейнера(ПериодЗаписи, Контейнер, СтруктураИзменяемыхРеквизитов, Удалить = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	*
	               |ИЗ
	               |	РегистрСведений.СрокиИспользованияКонтейнеров.СрезПоследних(&Период, Контейнер = &Контейнер) КАК СрокиИспользованияКонтейнеровСрезПоследних";
	Запрос.УстановитьПараметр("Период", ПериодЗаписи);
	Запрос.УстановитьПараметр("Контейнер", Контейнер);
	Ответ = запрос.Выполнить().Выбрать();
	
	МЗ = РегистрыСведений.СрокиИспользованияКонтейнеров.СоздатьМенеджерЗаписи();
	
	Если Ответ.Следующий() И ПериодЗаписи = Ответ.Период Тогда
		ЗаполнитьЗначенияСвойств(МЗ, Ответ);
		Если Удалить Тогда
			МЗ.Удалить();
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	МЗ.Период = ПериодЗаписи;
	МЗ.Контейнер = Контейнер;
	Для каждого стр из СтруктураИзменяемыхРеквизитов Цикл
		МЗ[стр.Ключ] = стр.Значение;
	КонецЦикла;
	МЗ.Записать();
	
КонецПроцедуры

Процедура ОтметитьВДокументеСтокКТКДатуСдачиКТК(КТК, ДатаСдачи) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	СтокКонтейнеровКонтейнеры.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.СтокКонтейнеров.Контейнеры КАК СтокКонтейнеровКонтейнеры
	               |ГДЕ
	               |	СтокКонтейнеровКонтейнеры.Ссылка.Проведен
	               |	И СтокКонтейнеровКонтейнеры.Контейнер = &Контейнер
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СтокКонтейнеровКонтейнеры.Ссылка.Дата УБЫВ";
	Запрос.УстановитьПараметр("Контейнер", КТК);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() ТОгда
		
		СтокОбъект = Ответ.Ссылка.ПолучитьОбъект();
		НайдСтрока = СтокОбъект.Контейнеры.НайтиСтроки(Новый Структура("Контейнер", КТК))[0];
		
		Если НЕ ЗначениеЗаполнено(НайдСтрока.ДатаСдачиКТКПоставщику) Тогда НайдСтрока.ДатаСдачиКТКПоставщику = ДатаСдачи; СтокОбъект.Записать(); КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

