	               |	стоки_ТекущиеДанныеСрезПоследних.тек_Собственник КАК тек_Собственник,
	               |	стоки_ТекущиеДанныеСрезПоследних.тек_Сток КАК тек_Сток,
	               |	стоки_ТекущиеДанныеСрезПоследних.тек_СтокСдачи КАК тек_СтокСдачи,
	               |	стоки_ТекущиеДанныеСрезПоследних.тек_ИнструкцияПоСдаче КАК тек_ИнструкцияПоСдаче,
	               |	стоки_ТекущиеДанныеСрезПоследних.тек_ДатаВзятияИзСтока КАК тек_ДатаВзятияИзСтока,
	               |	стоки_ТекущиеДанныеСрезПоследних.тек_ДатаПриемаВПользование КАК тек_ДатаПриемаВПользование,
	               |	стоки_ТекущиеДанныеСрезПоследних.тек_Релиз КАК тек_Релиз,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.кл_НомерТСЗабор КАК кл_НомерТСЗабор,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.кл_ВодительЗабор КАК кл_ВодительЗабор,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.кл_ДатаВыдачи КАК кл_ДатаВыдачи,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.кл_СрокПользования КАК кл_СрокПользования,
	               |	стоки_ТекущиеДанныеСрезПоследних.тек_Релиз.НомерДокумента КАК тек_РелизНомерДокумента,
	               |	стоки_ТекущиеДанныеСрезПоследних.тек_СрокВозврата КАК тек_СрокВозврата,
	               // ДИТ 89973 Давудов М.А. Начало: 21.08.2024
	               //ок(
	               //|	стоки_ТекущиеДанныеСрезПоследних.тек_СобственностьКТК КАК тек_СобственностьКТК,
	               //ок)
	               |	стоки_ТекущиеДанныеСрезПоследних.Удалитьтек_СобственностьКТК КАК Удалитьтек_СобственностьКТК,
	               |	стоки_ТекущиеДанныеСрезПоследних.тек_ПринадлежностьТЕ КАК тек_ПринадлежностьТЕ,
	               // ДИТ 89973 Давудов М.А. Конец: 21.08.2024
	               |	стоки_КлиентскоеОперированиеСрезПоследних.кл_ДатаВозврата КАК кл_ДатаВозврата,
	               |	стоки_ТекущиеДанныеСрезПоследних.комм_Ставка КАК комм_Ставка,
	               |	стоки_ТекущиеДанныеСрезПоследних.комм_Валюта КАК комм_Валюта,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.допл_Клиент КАК допл_Клиент,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.допл_Договор КАК допл_Договор,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.допл_Калькуляция КАК допл_Калькуляция,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.допл_ПСЦ КАК допл_ПСЦ,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.кл_ЗаявкаНаВыдачу КАК кл_ЗаявкаНаВыдачу
	               |ИЗ
	               |	Справочник.ТЕ КАК ТЕ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.стоки_ТекущиеДанные.СрезПоследних КАК стоки_ТекущиеДанныеСрезПоследних
	               |		ПО ТЕ.Ссылка = стоки_ТекущиеДанныеСрезПоследних.КТК
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.стоки_КлиентскоеОперирование.СрезПоследних КАК стоки_КлиентскоеОперированиеСрезПоследних
	               |		ПО ТЕ.Ссылка = стоки_КлиентскоеОперированиеСрезПоследних.КТК
	               |ГДЕ
	               |	ТЕ.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", НомерКТК);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТекущиеПараметрыСНП(КТК) Экспорт
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	стоки_ТекущиеДанные_СНП.ГУИДЗаписи КАК ГУИДЗаписи
	               |ПОМЕСТИТЬ ВТ
	               |ИЗ
	               |	РегистрСведений.стоки_КлиентскоеОперирование КАК стоки_КлиентскоеОперирование
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.стоки_ТекущиеДанные_СНП КАК стоки_ТекущиеДанные_СНП
	               |		ПО стоки_КлиентскоеОперирование.ГУИДЗаписи = стоки_ТекущиеДанные_СНП.ГУИДЗаписи
	               |ГДЕ
	               |	стоки_КлиентскоеОперирование.КТК = &КТК
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	стоки_КлиентскоеОперирование.Период УБЫВ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	стоки_ТекущиеДанные_СНП.ГУИДЗаписи КАК ГУИДЗаписи,
	               |	стоки_ТекущиеДанные_СНП.От КАК От,
	               |	стоки_ТекущиеДанные_СНП.До КАК До,
	               |	стоки_ТекущиеДанные_СНП.Сумма КАК Сумма
	               |ИЗ
	               |	РегистрСведений.стоки_ТекущиеДанные_СНП КАК стоки_ТекущиеДанные_СНП
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ КАК ВТ
	               |		ПО стоки_ТекущиеДанные_СНП.ГУИДЗаписи = ВТ.ГУИДЗаписи
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	От";
	Запрос.УстановитьПараметр("КТК", КТК);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		Результат.Добавить(Новый Структура("От, До, Стоимость", Ответ.От, Ответ.До, Ответ.Сумма));
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Евросиб Фролов (06.12.2021 TASK№ №42618, РелизКлиента
Процедура ПроверитьРелизыКлиентов()   
	
	// Рег. задание выбирает релизы, у которых:
	// - имеется установленная галка "Номерная выдача" 
	// - текущая дата больше конечной даты из поля "Период действия релиза" на 5 суток
	// В отобранном списке релизов необходимо по контейнерам у которых пустое поле "Дата взятия"
	// устанавливать статус "Свободен" в АРМ КТК.	
	
	
	#Область СтарыйЗапрос
	//ТекстЗапроса =
	//"ВЫБРАТЬ РАЗЛИЧНЫЕ
	//|	РелизКлиентаКонтейнеры.Контейнер КАК КТК
	//|ИЗ
	//|	Документ.РелизКлиента.Контейнеры КАК РелизКлиентаКонтейнеры
	//// ++ ДИТ_Агафонов_task 56709 11.09.2022
	//|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.стоки_ТекущиеДанные.СрезПоследних КАК стоки_ТекущиеДанныеСрезПоследних
	//|	ПО РелизКлиентаКонтейнеры.Контейнер = стоки_ТекущиеДанныеСрезПоследних.КТК
	//// -- ДИТ_Агафонов_task 56709 11.09.2022
	//|ГДЕ
	//|	РелизКлиентаКонтейнеры.Ссылка.НомернаяВыдача
	//|	И РелизКлиентаКонтейнеры.Ссылка.Проведен
	//// Евросиб Фролов (23.03.2022 Ticket №0265008
	//// Текущая дата больше конечной даты из поля "Период действия релиза" не на 5, а на 1 сутки.
	////|	И НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ТекущаяДата, ДЕНЬ, -5), ДЕНЬ) >= РелизКлиентаКонтейнеры.Ссылка.ДействиеРелизаОкончание
	//|	И НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ТекущаяДата, ДЕНЬ, -1), ДЕНЬ) >= РелизКлиентаКонтейнеры.Ссылка.ДействиеРелизаОкончание
	//// Евросиб Фролов)
	//// ++ ДИТ_Агафонов_task 56709 11.09.2022
	//|	И стоки_ТекущиеДанныеСрезПоследних.тек_Статус В (Значение(Перечисление.СтатусыКТК.Зарезервирован),Значение(Перечисление.СтатусыКТК.ПредварительныйРезерв))
	//// -- ДИТ_Агафонов_task 56709 11.09.2022
	//|	И РелизКлиентаКонтейнеры.ДатаВывоза = ДАТАВРЕМЯ(1, 1, 1)";
	#КонецОбласти
	
	 ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РелизКлиентаКонтейнеры.КлючАналитикиПеревозки.Контейнер КАК КТК
	|ИЗ
	|	Документ.РелизКлиента.Контейнеры КАК РелизКлиентаКонтейнеры
    // ++ ДИТ_Агафонов_task 56709 11.09.2022
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.стоки_ТекущиеДанные.СрезПоследних КАК стоки_ТекущиеДанныеСрезПоследних
	|	ПО РелизКлиентаКонтейнеры.КлючАналитикиПеревозки.Контейнер = стоки_ТекущиеДанныеСрезПоследних.КТК
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозки 
	|		ПО КлючиАналитикиПеревозки.Ссылка = РелизКлиентаКонтейнеры.КлючАналитикиПеревозки
	|			И КлючиАналитикиПеревозки.ЭтапПеревозки = Значение(Перечисление.ЭтапыПеревозки.ПерваяМиля)
	// -- ДИТ_Агафонов_task 56709 11.09.2022
	|ГДЕ
	|	РелизКлиентаКонтейнеры.Ссылка.НомернаяВыдача
	|	И РелизКлиентаКонтейнеры.Ссылка.Проведен
	// Евросиб Фролов (23.03.2022 Ticket №0265008
	// Текущая дата больше конечной даты из поля "Период действия релиза" не на 5, а на 1 сутки.
	//|	И НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ТекущаяДата, ДЕНЬ, -5), ДЕНЬ) >= РелизКлиентаКонтейнеры.Ссылка.ДействиеРелизаОкончание
    |	И НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ТекущаяДата, ДЕНЬ, -1), ДЕНЬ) >= РелизКлиентаКонтейнеры.Ссылка.ДействиеРелизаОкончание
	// Евросиб Фролов)
	// ++ ДИТ_Агафонов_task 56709 11.09.2022
	|	И стоки_ТекущиеДанныеСрезПоследних.тек_Статус В (Значение(Перечисление.СтатусыКТК.Зарезервирован),Значение(Перечисление.СтатусыКТК.ПредварительныйРезерв))
	// -- ДИТ_Агафонов_task 56709 11.09.2022
	|	И ЕстьNULL(КлючиАналитикиПеревозки.ДатаВыдачиКТКСТерминала,ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
	|	И РелизКлиентаКонтейнеры.КлючАналитикиПеревозки.Контейнер <> Значение(Справочник.КлючиАналитикиПеревозки.ПустаяСсылка)";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		МассивИзмЗначений = Новый Соответствие;
		МассивИзмЗначений.Вставить("тек_Статус", Перечисления.СтатусыКТК.Свободен);
		МассивИзмЗначений.Вставить("ИсточникЗаписи", "Добавлено рег. заданием " + ТекущаяДата());
		
		РегистрыСведений.стоки_ТекущиеДанные.ДобавитьЗапись(Выборка.КТК, МассивИзмЗначений);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьКТКСПредварительнымРезервом()
	
	Если НЕ РаботаСПочтовымиСообщениями.ПроверитьСистемнаяУчетнаяЗаписьДоступна() Тогда 
		ЗаписьЖурналаРегистрации("Ошибка отправки писем об ожидании резервирования КТК", УровеньЖурналаРегистрации.Ошибка,,,"Недоступна системная учетная запись");
		Возврат; 
	КонецЕсли;
	
	// Для КТК, у которых в текущих данных установлен статус "Предварительный резерв" и "В эксплуатации",
	// и с момент установки этого статуса прошло более 24 часов, необходимо отправить письмо автору релиза клиента
	// (на каждый релиз отдельное письмо).
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	стоки_ТекущиеДанныеСрезПоследних.КТК КАК КТК
	|ПОМЕСТИТЬ втКТК
	|ИЗ
	|	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних КАК стоки_ТекущиеДанныеСрезПоследних
	|ГДЕ
	|	стоки_ТекущиеДанныеСрезПоследних.тек_ВЭксплуатации
	|	И стоки_ТекущиеДанныеСрезПоследних.тек_Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыКТК.ПредварительныйРезерв)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РелизКлиентаКонтейнеры.Ссылка.Автор КАК Автор,
	|	РелизКлиентаКонтейнеры.Ссылка.НомерРелиза КАК НомерРелиза
	|ИЗ
	|	втКТК КАК втКТК
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РелизКлиента.Контейнеры КАК РелизКлиентаКонтейнеры 
	//ДИТ Шевченко А.В. US 62421 TA 64343 27.02.2023 -начало
	//|		ПО втКТК.КТК = РелизКлиентаКонтейнеры.Контейнер
	|		ПО втКТК.КТК = РелизКлиентаКонтейнеры.КлючАналитикиПеревозки.Контейнер
	//ДИТ Шевченко А.В. US 62421 TA 64343 27.02.2023 -конец
	|			И (РелизКлиентаКонтейнеры.Ссылка.НомернаяВыдача)
	|			И (РелизКлиентаКонтейнеры.Ссылка.СтатусСогласованияСпискаКТК = ЗНАЧЕНИЕ(Перечисление.СтатусыСогласованияСпискаКТКСТерминалами.НеСогласован))
	|ГДЕ
	|	НЕ РелизКлиентаКонтейнеры.ДатаПредварительногоРезерва ЕСТЬ NULL
	|	И РАЗНОСТЬДАТ(РелизКлиентаКонтейнеры.ДатаПредварительногоРезерва, &ТекущаяДата, ЧАС) > 24
	|ИТОГИ ПО
	|	Автор";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаАвтор = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	СУЗ = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	УстановитьПривилегированныйРежим(Истина);
	Пароли = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(СУЗ, "ПарольSMTP");
	УстановитьПривилегированныйРежим(Ложь);
	
	Попытка
		
		Пока ВыборкаАвтор.Следующий() Цикл
			
			ВыборкаРелизы = ВыборкаАвтор.Выбрать();
			Пока ВыборкаРелизы.Следующий() Цикл
				
				АдресаАвтораДокумента = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаАвтор.Автор, Справочники.ВидыКонтактнойИнформации.EmailПользователя,, Ложь);
				
				ТекстПисьма = СтрШаблон("Необходимо подтвердить/отменить резервирование контейнеров в релизе %1.
									|Контейнеры находятся в статусе предварительного резервирования более суток.", ВыборкаРелизы.НомерРелиза);
				
				ИПП = Новый ИнтернетПочтовыйПрофиль;
				ИПП.АдресСервераSMTP = СУЗ.СерверИсходящейПочты;
				ИПП.АутентификацияSMTP = СпособSMTPАутентификации.ПоУмолчанию;
				ИПП.ПарольSMTP = Пароли;
				ИПП.ПользовательSMTP = СУЗ.ПользовательSMTP;
				ИПП.ПортSMTP = СУЗ.ПортСервераИсходящейПочты;
				
				ИС = Новый ИнтернетПочтовоеСообщение;
				ИС.ИмяОтправителя = СУЗ.ИмяПользователя;
				ИС.Отправитель.Адрес = СУЗ.АдресЭлектроннойПочты;
				Для Каждого ТекПолучатель Из АдресаАвтораДокумента Цикл
					Если Не ПустаяСтрока(ТекПолучатель.Представление) Тогда
						ИС.Получатели.Добавить(ТекПолучатель.Представление);
					КонецЕсли;
				КонецЦикла;
				ИС.Тема = СтрШаблон("Ожидание подтверждения резервирования КТК по релизу %1", ВыборкаРелизы.НомерРелиза);
				ИС.Тексты.Добавить(ТекстПисьма, ТипТекстаПочтовогоСообщения.ПростойТекст);
				ИС.ОбработатьТексты();
				ИП = Новый ИнтернетПочта;
				ИП.Подключиться(ИПП);
				ИП.Послать(ИС);
				ИП.Отключиться()
				
			КонецЦикла;
		КонецЦикла;	
		
	Исключение
		ЗаписьЖурналаРегистрации("Ошибка отправки результатов исполнения личных целей", УровеньЖурналаРегистрации.Ошибка,,,ОписаниеОшибки());
