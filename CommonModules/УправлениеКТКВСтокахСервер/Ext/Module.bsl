Функция ПолучитьПредыдущиеДанныеСтока(НомерКТК, ДатаПолучения) Экспорт
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтейнерыВСтокахОстатки.Контейнер КАК Контейнер,
	               |	КонтейнерыВСтокахОстатки.Сток КАК Сток,
	               |	КонтейнерыВСтокахОстатки.Назначение КАК Назначение,
	               |	КонтейнерыВСтокахОстатки.Контрагент КАК Контрагент,
	               |	КонтейнерыВСтокахОстатки.ДатаПриемаВСток КАК ДатаПриемаВСток,
	               |	КонтейнерыВСтокахОстатки.СрокВозврата КАК СрокВозврата,
	               |	КонтейнерыВСтокахОстатки.КоличествоОстаток КАК КоличествоОстаток,
	               |	ПризнакСобственностиКонтейнераСрезПоследних.ПризнакСобственности КАК ПризнакСобственности,
	               |	ПризнакСобственностиКонтейнераСрезПоследних.ВладелецКТК КАК ВладелецКТК
	               |ИЗ
	               |	РегистрНакопления.КонтейнерыВСтоках.Остатки(, Контейнер = &Контейнер) КАК КонтейнерыВСтокахОстатки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакСобственностиКонтейнера.СрезПоследних КАК ПризнакСобственностиКонтейнераСрезПоследних
	               |		ПО КонтейнерыВСтокахОстатки.Контейнер = ПризнакСобственностиКонтейнераСрезПоследних.Контейнер";
	Запрос.УстановитьПараметр("ПериодПроверки", ДатаПолучения);
	Запрос.УстановитьПараметр("Контейнер", НомерКТК);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		СледующийСток = неопределено;
		ИнструкцииПоСдачеПорожнего = "";
		
		
		ЗапросИзДокумента = Новый Запрос;
		ЗапросИзДокумента.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		                          |	СтокКонтейнеровКонтейнеры.Контейнер КАК Контейнер,
		                          |	СтокКонтейнеровКонтейнеры.СледующийСток КАК СледующийСток,
		                          |	СтокКонтейнеровКонтейнеры.ИнструкцииПоСдачеПорожнего КАК ИнструкцииПоСдачеПорожнего
		                          |ИЗ
		                          |	Документ.СтокКонтейнеров.Контейнеры КАК СтокКонтейнеровКонтейнеры
		                          |ГДЕ
		                          |	СтокКонтейнеровКонтейнеры.Контейнер = &Контейнер
		                          |	И СтокКонтейнеровКонтейнеры.Ссылка.Сток = &Сток
		                          |
		                          |УПОРЯДОЧИТЬ ПО
		                          |	СтокКонтейнеровКонтейнеры.Ссылка.Дата УБЫВ";
		ЗапросИзДокумента.УстановитьПараметр("Контейнер", Ответ.Контейнер);
		ЗапросИзДокумента.УстановитьПараметр("Сток", Ответ.Сток);
		ОтветИзДокумента = ЗапросИзДокумента.Выполнить().Выбрать();
		Если ОтветИзДокумента.Следующий() Тогда
			СледующийСток 				= ОтветИзДокумента.СледующийСток;
			ИнструкцииПоСдачеПорожнего 	= ОтветИзДокумента.ИнструкцииПоСдачеПорожнего;
		КонецЕсли;
		
		Результат.Добавить(Новый Структура("Контейнер,Сток,Назначение,Контрагент,ДатаПриемаВСток,СрокВозврата,КоличествоОстаток,СледующийСток,ИнструкцииПоСдачеПорожнего,ПризнакСобственностиЪ,ВладелецКТКЪ", Ответ.Контейнер,Ответ.Сток,Ответ.Назначение,?(ЗначениеЗаполнено(Ответ.Контрагент), Ответ.Контрагент, Ответ.ВладелецКТК),Ответ.ДатаПриемаВСток,Ответ.СрокВозврата,Ответ.КоличествоОстаток,СледующийСток,ИнструкцииПоСдачеПорожнего,Ответ.ПризнакСобственности,Ответ.ВладелецКТК));
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

