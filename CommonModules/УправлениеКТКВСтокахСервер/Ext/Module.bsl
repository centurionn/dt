Функция ПолучитьМультилокацию(ОписаниеМультилокации) Экспорт
	
	Результат = неопределено;
	
	Если ЗначениеЗаполнено(ОписаниеМультилокации) Тогда
		
		МассивЛокаций = Новый Массив;
		СтрМ = СтрРазделить(ОписаниеМультилокации, ";", Ложь);
		//++ Зубов 39480 29.09.2021
		//НЭлемент = справочники.Мультилокации.СоздатьЭлемент();
		Локации = Новый СписокЗначений;
		Для каждого Стр из СтрМ Цикл
			
			НайдЛ = Локации_сервер.ПолучитьЛокациюПоНечеткомуПоиску(СокрЛП(Стр), Истина);
		//	Если ЗначениеЗаполнено(НайдЛ) Тогда НЭлемент.Локации.Добавить().Локация = НайдЛ; КонецЕсли;
			Если ЗначениеЗаполнено(НайдЛ) Тогда Локации.Добавить(НайдЛ); КонецЕсли;
		//	
		КонецЦикла;
		//
		//Если НЭлемент.Локации.Количество() > 0 Тогда
		//	
		//	НЭлемент.Записать();
		//	Результат = НЭлемент.Ссылка;
		//	
		//КонецЕсли;
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	Мультилокации.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Мультилокации КАК Мультилокации
			|ГДЕ
			|	НЕ Мультилокации.ПометкаУдаления
			|	И Мультилокации.Локации.Локация В(&ЛокацияСписок)
			|
			|УПОРЯДОЧИТЬ ПО
			|	Мультилокации.Код";
		
		Запрос.УстановитьПараметр("ЛокацияСписок", Локации);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Результат = Неопределено;
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если Локации.Количество() = ВыборкаДетальныеЗаписи.Ссылка.Локации.Количество() Тогда
				НайденныеЛокации = 0;
				Для каждого Лок из Локации Цикл
					Если НЕ ВыборкаДетальныеЗаписи.Ссылка.Локации.Найти(Лок.Значение)=Неопределено Тогда
						НайденныеЛокации = НайденныеЛокации+1;
					Иначе
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если НайденныеЛокации = Локации.Количество() Тогда
					Результат = ВыборкаДетальныеЗаписи.Ссылка;
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

		Если Результат = Неопределено Тогда
			Результат = Справочники.Мультилокации.СоздатьЭлемент();
			Для каждого Лок из Локации Цикл
				СтрокаРезультата = Результат.Локации.Добавить();
				СтрокаРезультата.Локация = Лок.Значение;
			КонецЦикла;
			Результат.Записать();
		КонецЕсли;
			//-- Зубов 39480 29.09.2021
	КонецЕсли;
	
	Возврат Результат;
	
