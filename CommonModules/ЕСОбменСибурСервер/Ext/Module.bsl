Функция ПодтвердитьЗаявку(ОбъектXDTO) Экспорт
	
	ИдентификаторЗаявки = ОбъектXDTO.RFQ_ID;
	КодСтатусаЗаявки = ОбъектXDTO.RESP_STATUS_RFQ;
	//Евросиб Каблов 25.10.2021 ( Ticket#0243051
	НомерПоездаКлиента = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ОбъектXDTO, "NUMBER_RW",, "");
	КомментарийКлиента = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ОбъектXDTO, "COMMENT",, "");
	//Евросиб Каблов 25.10.2021 )
	
	Запрос = Новый Запрос;
	// ДИТ US 60810 TA 66664 Евсенкин М.А. Начало: 29.03.2023
	// Было:
	//Запрос.УстановитьПараметр("RFQ_ID", ИдентификаторЗаявки); 
	//Стало:
	RFQ_ID = "";
	НомерЛота = "";
	МассивСтрок = СтрРазделить(ИдентификаторЗаявки,"/");
	Если МассивСтрок.Количество() = 2 Тогда 
		RFQ_ID = МассивСтрок[0];
		НомерЛота = МассивСтрок[1];
	КонецЕсли;	
	Запрос.УстановитьПараметр("RFQ_ID", RFQ_ID);
	Запрос.УстановитьПараметр("НомерЛота", НомерЛота);
	// ДИТ US 60810 TA 66664 Евсенкин М.А. Конец: 29.03.2023	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДокЗаявка.Ссылка КАК Заявка,
	|	ДокЗаявка.ВнешнийНомер КАК RFQ_ID,
	|	ДокЗаявка.Номер КАК EXT_RFQ_ID,
	|	ЗаявкаПереченьРейсов.Рейс КАК Рейс,
	|	ЗаявкаПереченьРейсов.Рейс.НомерПоездаКлиента КАК РейсНомерПоездаКлиента
	|ПОМЕСТИТЬ ВТРазмещенныеЗаявки
	|ИЗ
	|	Документ.Заявка КАК ДокЗаявка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СибурРазмещенныеЗаявки КАК СибурРазмещенныеЗаявки
	|		ПО ДокЗаявка.Ссылка = СибурРазмещенныеЗаявки.Заявка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
	|		ПО ДокЗаявка.Ссылка = ЗаявкаПереченьРейсов.Ссылка
	|			И (ЗаявкаПереченьРейсов.Рейс ССЫЛКА Справочник.РейсыЖД)
	// ДИТ US 60810 TA 66664 Евсенкин М.А. Начало: 29.03.2023
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка.НомераЛотов КАК ЗаявкаНомераЛотов
	|		ПО (ДокЗаявка.Ссылка = ЗаявкаНомераЛотов.Ссылка)	
	// ДИТ US 60810 TA 66664 Евсенкин М.А. Конец: 29.03.2023
	|ГДЕ
	|	ДокЗаявка.ВнешнийНомер = &RFQ_ID 
	// ДИТ US 60810 TA 66664 Евсенкин М.А. Начало: 29.03.2023 
	|	И ЗаявкаНомераЛотов.НомерЛота = &НомерЛота
	|	И НЕ ДокЗаявка.ПометкаУдаления
    // ДИТ US 60810 TA 66664 Евсенкин М.А. Конец: 29.03.2023
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТРазмещенныеЗаявки.Заявка КАК Заявка,
	|	ВТРазмещенныеЗаявки.RFQ_ID КАК RFQ_ID,
	|	ВТРазмещенныеЗаявки.EXT_RFQ_ID КАК EXT_RFQ_ID,
	|	СибурСтатусыЗаявокСрезПоследних.СтатусЗаявки КАК СтатусЗаявки,
	|	СибурСтатусыЗаявокСрезПоследних.Период КАК Период,
	|	СибурСтатусыЗаявокСрезПоследних.СтатусЗаявки.КодСтатуса КАК СтатусЗаявкиКод,
	|	ВТРазмещенныеЗаявки.Рейс КАК Рейс,
	|	ВТРазмещенныеЗаявки.РейсНомерПоездаКлиента КАК РейсНомерПоездаКлиента
	|ИЗ
	|	ВТРазмещенныеЗаявки КАК ВТРазмещенныеЗаявки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СибурСтатусыЗаявок.СрезПоследних(
	|				,
	|				Заявка В
	|					(ВЫБРАТЬ
	|						ВТРазмещенныеЗаявки.Заявка КАК Заявка
	|					ИЗ
	|						ВТРазмещенныеЗаявки КАК ВТРазмещенныеЗаявки)) 
	|												КАК СибурСтатусыЗаявокСрезПоследних
	|		ПО ВТРазмещенныеЗаявки.Заявка = СибурСтатусыЗаявокСрезПоследних.Заявка";
	
	Ответ = ПолучитьОбъектXDTO("urn:sibur:po:a:LP:RFQ", "RFQuotConfirm");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		ДатаСтатуса = ТекущаяДатаСеанса();
		СтатусЗаявки = ПолучитьСтатусЗаявки(Перечисления.ВидыЗаявокСибура.ЗаявкаЖД, КодСтатусаЗаявки);
		
		ЗаявкаОбъект = Выборка.Заявка.ПолучитьОбъект();
		ЗаявкаОбъект.СтатусЗаявкиСибур = СтатусЗаявки; 
		//Евросиб Каблов 25.10.2021 ( Ticket#0243051
		ЗаявкаОбъект.КомментарийКлиента = КомментарийКлиента;		
		//Евросиб Каблов 25.10.2021 )
		//Установка дополнительных свойств для изменения Состояния заявки
		УстановитьДопСвойстваСостоянияЗаявки(ЗаявкаОбъект, СтатусЗаявки, ДатаСтатуса);		
		ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
		//Евросиб Каблов 25.10.2021 ( Ticket#0243051
		Если ЗначениеЗаполнено(Выборка.Рейс) И ЗначениеЗаполнено(НомерПоездаКлиента) И Выборка.РейсНомерПоездаКлиента <> НомерПоездаКлиента Тогда
			Рейс = Выборка.Рейс.ПолучитьОбъект();
			Рейс.НомерПоездаКлиента = НомерПоездаКлиента;
			Рейс.Записать();
		КонецЕсли;
		//Евросиб Каблов 25.10.2021 )
		
		//Уведомление ответственного по e-mail об изменении заявки
		ОтборУведомлений = Новый Структура;
		ОтборУведомлений.Вставить("Документ", ЗаявкаОбъект.Ссылка);
		ОтборУведомлений.Вставить("Состояние", Справочники.Состояния.ПроверкаИКонтрольИзмененийДокумента);	
		Пользователи_sd_сервер.УведомитьПользователяОЕгоЗадачах(ОтборУведомлений);
		
		// ДИТ US 60810 TA 66664 Евсенкин М.А. Начало: 29.03.2023  аналогичная запись происходит в модуле объекта заявки. исключил дубли
		// Было:
		//Если ЗначениеЗаполнено(КодСтатусаЗаявки) И Выборка.СтатусЗаявкиКод <> КодСтатусаЗаявки Тогда						
		//	
		//	Запись = РегистрыСведений.СибурСтатусыЗаявок.СоздатьМенеджерЗаписи();
		//	Запись.Период = ДатаСтатуса;
		//	Запись.Заявка = Выборка.Заявка;
		//	Запись.СтатусЗаявки = СтатусЗаявки;
		//	Запись.Записать();
		//	
		//КонецЕсли;
		// ДИТ US 60810 TA 66664 Евсенкин М.А. Конец: 29.03.2023
				
		Ответ.RFQ_ID = Выборка.RFQ_ID;
		Ответ.EXT_RFQ_ID = Выборка.EXT_RFQ_ID;
		Ответ.STATUS_DATE = ДатаСтатуса;
		
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции


Процедура УстановитьСостояниеЗаявкиСИБУР(ЗаявкаОбъект, ПараметрыСтатуса)
	
	//TODO//
	//ЗаявкаОбъект = Документы.Заявка.СоздатьДокумент();
	
	Если ЗаявкаОбъект.ДополнительныеСвойства.Свойство("ДобавляемыеСостояния") Тогда
		ДобавляемыеСостояния = ЗаявкаОбъект.ДополнительныеСвойства.ДобавляемыеСостояния;
	Иначе
		ДобавляемыеСостояния = Новый Массив;
		ЗаявкаОбъект.ДополнительныеСвойства.Вставить("ДобавляемыеСостояния", ДобавляемыеСостояния);
	КонецЕсли;
	
	Состояния = ЗаявкаОбъект.Состояния;
	СостояниеПроверкаИКонтроль = Справочники.Состояния.ПроверкаИКонтрольИзмененийДокумента;
	
	Для Каждого СтрокаСостояния Из ДобавляемыеСостояния Цикл
		Если СтрокаСостояния.Состояние = СостояниеПроверкаИКонтроль Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	СтрокаСостояния = Новый Структура("Состояние, ПримечаниеЗадачаИсполнителю", СостояниеПроверкаИКонтроль, Истина);
	
	Статус = Неопределено;
	ПараметрыСтатуса.Свойство("Статус", Статус);
	Комментарий = Неопределено;
	ПараметрыСтатуса.Свойство("Комментарий", Комментарий);
	ТекстКомментария = СтрШаблон("СИБУР установил статус заявки: %1. Комментарий: %2", Статус, Комментарий);
	СтрокаСостояния.Вставить("Комментарий", ТекстКомментария);
	
	ДатаСтатуса = Неопределено;
	Если ПараметрыСтатуса.Свойство("ДатаСтатуса", ДатаСтатуса) И ЗначениеЗаполнено(ДатаСтатуса) Тогда
		СтрокаСостояния.Вставить("НачалоРаботы", ДатаСтатуса);
	Иначе
		СтрокаСостояния.Вставить("НачалоРаботы", ТекущаяДатаСеанса());
	КонецЕсли;
	ДобавляемыеСостояния.Добавить(СтрокаСостояния);
	
КонецПроцедуры

