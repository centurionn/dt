
////////////////
//4.1.2. Инфообмен «Предложение по заявкам»

Функция СоздатьЗаявку(ОбъектXDTO) Экспорт
	
	ДатаРазмещенияЗаявки = ТекущаяДатаСеанса();
	
	ИдентификаторЗаявки = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ОбъектXDTO, "RFQ_ID");
	// ДИТ US 60810 TA 66664 Евсенкин М.А. Начало: 30.03.2023
	RFQ_ID = "";
	НомерЛота = "";
	МассивСтрок = СтрРазделить(ИдентификаторЗаявки,"/");
	Если МассивСтрок.Количество() = 2 Тогда 
		RFQ_ID = МассивСтрок[0];
		НомерЛота = МассивСтрок[1];
	КонецЕсли;
	// ДИТ US 60810 TA 66664 Евсенкин М.А. Конец: 30.03.2023	
		
	КодСтатусаЗаявки = ПолучитьЗначениеПоляОбъектаXDTO(ОбъектXDTO.RESP_STATUS_RFQ);
	НаименованиеСтатусаЗаявки = ПолучитьЗначениеПоляОбъектаXDTO(ОбъектXDTO.RESP_STATUS_RFQ_D);
	СтатусЗаявки = ПолучитьСтатусЗаявки(Перечисления.ВидыЗаявокСибура.ЗаявкаЖД, КодСтатусаЗаявки);
	
	Комментарий = ПолучитьЗначениеПоляОбъектаXDTO(ОбъектXDTO.COMMENT);
	
	КодКонечнойСтанцииНазначенияПриСухопутье = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ОбъектXDTO, "EXT_POINT", Тип("Строка"));
	КодПритерминальнойЖДСтанции = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ОбъектXDTO, "TERM_LOC", Тип("Строка"));
	КодСтанцииОтправкиГруженого = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ОбъектXDTO, "DEST_LOC", Тип("Строка"));
	КодСтанцииНазначенияГруженого = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ОбъектXDTO, "DEST_POINT", Тип("Строка"));
	
	ПлановаяДатаОтгрузкиГруженогоСостава = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ОбъектXDTO, "ETD_PLANT", Тип("Дата"));
	НеобходимаяДатаПодачиПорожнегоСостава = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ОбъектXDTO, "ETA_CONT", Тип("Дата"));	
	
	КодГрузоотправителя = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ОбъектXDTO, "SHIPPER_ID");
	Грузоотправитель = Справочники.Контрагенты.НайтиПоРеквизиту("КодПоОКПО", КодГрузоотправителя);
	
	НомерДоговора = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ОбъектXDTO, "FAG_ID_DESR");
	
	//Поиск среди размещенных заявок
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СибурРазмещенныеЗаявки.RFQ_ID КАК RFQ_ID,
	|	СибурРазмещенныеЗаявки.EXT_RFQ_ID КАК EXT_RFQ_ID,
	|	СибурРазмещенныеЗаявки.Заявка КАК ДокументЗаявка,
	|	СибурРазмещенныеЗаявки.ЗаявкаНаОтправкуГруженых КАК ЗаявкаНаОтправкуГруженых
	|ПОМЕСТИТЬ ВТЗаявка
	|ИЗ
	|	РегистрСведений.СибурРазмещенныеЗаявки КАК СибурРазмещенныеЗаявки
	|ГДЕ
	|	СибурРазмещенныеЗаявки.RFQ_ID В(&ИдентификаторыЗаявок)
	// ДИТ US 60810 TA 66664 Евсенкин М.А. Начало: 31.03.2023
	|	ИЛИ СибурРазмещенныеЗаявки.RFQ_ID ПОДОБНО &ИдентификаторыЗаявок2
	// ДИТ US 60810 TA 66664 Евсенкин М.А. Конец: 31.03.2023
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СибурСтатусыЗаявокСрезПоследних.Заявка КАК Заявка,
	|	СибурСтатусыЗаявокСрезПоследних.СтатусЗаявки КАК СтатусЗаявки,
	|	СибурСтатусыЗаявокСрезПоследних.СтатусЗаявки.Код КАК СтатусЗаявкиКод,
	|	СибурСтатусыЗаявокСрезПоследних.СтатусЗаявки.Наименование КАК СтатусЗаявкиНаименование
	|ПОМЕСТИТЬ ВТСтатусыЗаявок
	|ИЗ
	|	РегистрСведений.СибурСтатусыЗаявок.СрезПоследних(
	|			,
	|			Заявка В
	|				(ВЫБРАТЬ
	|					ВТЗаявка.ДокументЗаявка КАК ДокументЗаявка
	|				ИЗ
	|					ВТЗаявка КАК ВТЗаявка)) КАК СибурСтатусыЗаявокСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТЗаявка.RFQ_ID КАК RFQ_ID,
	|	ВТЗаявка.EXT_RFQ_ID КАК EXT_RFQ_ID,
	|	ВТЗаявка.ДокументЗаявка КАК ДокументЗаявка,
	|	ВТЗаявка.ЗаявкаНаОтправкуГруженых КАК ЗаявкаНаОтправкуГруженых,
	|	ВТСтатусыЗаявок.СтатусЗаявки КАК СтатусЗаявки,
	|	ВТСтатусыЗаявок.СтатусЗаявкиКод КАК СтатусЗаявкиКод,
	|	ВТСтатусыЗаявок.СтатусЗаявкиНаименование КАК СтатусЗаявкиНаименование
	|ИЗ
	|	ВТЗаявка КАК ВТЗаявка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСтатусыЗаявок КАК ВТСтатусыЗаявок
	|		ПО ВТЗаявка.ДокументЗаявка = ВТСтатусыЗаявок.Заявка";
	Запрос.УстановитьПараметр("ИдентификаторыЗаявок", ОбъектXDTO.RFQ_ID);
	// ДИТ US 60810 TA 66664 Евсенкин М.А. Начало: 31.03.2023
	Запрос.УстановитьПараметр("ИдентификаторыЗаявок2", "%"+RFQ_ID+"%");
	
	// ДИТ US 60810 TA 66664 Евсенкин М.А. Конец: 31.03.2023
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	НайденнаяЗаявка = Неопределено;
	
	Если Выборка.Следующий() Тогда
		ЗаявкаПорожних = Выборка.ДокументЗаявка;
		ЗаявкаПорожнихОбъект = ЗаявкаПорожних.ПолучитьОбъект();
		ЗаявкаГруженых = Выборка.ЗаявкаНаОтправкуГруженых;
		//ЗаявкаГруженыхОбъект = ЗаявкаГруженых.ПолучитьОбъект();
	Иначе
		ЗаявкаГруженых = Неопределено;
		//ЗаявкаГруженыхОбъект = Документы.Заявка.СоздатьДокумент();
		//Попытка
		//	ЗаявкаГруженыхОбъект.Заполнить(Неопределено);
		//Исключение
		//КонецПопытки;
		//ЗаявкаГруженыхОбъект.Дата = ДатаРазмещенияЗаявки;
		
		ЗаявкаПорожнихОбъект = Документы.Заявка.СоздатьДокумент();
		ЗаявкаПорожнихОбъект.Заполнить(Неопределено);
		ЗаявкаПорожнихОбъект.Дата = ДатаРазмещенияЗаявки;
		
	КонецЕсли;
	
	//Грузоотправитель порожних контейнеров (Евросиб)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Контрагент
	|ИЗ
	|	Справочник.Организации КАК Организации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО (ЕСТЬNULL(Организации.ГоловнаяОрганизация.ОКПО, Организации.ОКПО) = Контрагенты.КодПоОКПО)
	|ГДЕ
	|	Организации.Ссылка = &Организация";
	Запрос.УстановитьПараметр("Организация", ЗаявкаПорожнихОбъект.Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	ГрузоотправительПорожних = Неопределено;
	Если Выборка.Следующий() Тогда
		ГрузоотправительПорожних = Выборка.Контрагент;
	КонецЕсли;
	
	//Получение станций по кодам
	КодыСтанций = Новый Массив;
	Если ЗначениеЗаполнено(КодСтанцииОтправкиГруженого) Тогда
		КодыСтанций.Добавить(КодСтанцииОтправкиГруженого);
	КонецЕсли;
	Если ЗначениеЗаполнено(КодСтанцииНазначенияГруженого) Тогда
		КодыСтанций.Добавить(КодСтанцииНазначенияГруженого);
	КонецЕсли;
	Если ЗначениеЗаполнено(КодПритерминальнойЖДСтанции) Тогда
		КодыСтанций.Добавить(КодПритерминальнойЖДСтанции);
	КонецЕсли;
	СтанцииПоКодам = Новый Соответствие;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Локации.КодЖДСтанции КАК Код,
	|	Локации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Локации КАК Локации
	|ГДЕ
	|	Локации.КодЖДСтанции В(&КодыСтанций)";
	Запрос.УстановитьПараметр("КодыСтанций", КодыСтанций);	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтанцииПоКодам.Вставить(Выборка.Код, Выборка.Ссылка);
	КонецЦикла;
	
	СтанцияОтправкиГруженого = СтанцииПоКодам.Получить(КодСтанцииОтправкиГруженого);
	СтанцияНазначенияГруженого = СтанцииПоКодам.Получить(КодСтанцииНазначенияГруженого);
	ПритерминальнаяСтанция = СтанцииПоКодам.Получить(КодПритерминальнойЖДСтанции);
	
	//Типоразмеры ТЕ
	ТипКонтейнераСтрокой = ПолучитьТипКонтейнераСтрокойПоКодуСибур(ОбъектXDTO.CONTAINER_MOT);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТипоразмерыТЕ.Наименование КАК Наименование,
	|	ТипоразмерыТЕ.Ссылка КАК Типоразмер,
	|	ТипоразмерыТЕ.РазмерКТК КАК РазмерКТК
	|ИЗ
	|	Справочник.ТипоразмерыТЕ КАК ТипоразмерыТЕ
	|ГДЕ
	|	ТипоразмерыТЕ.Наименование = &НаименованиеТипаКонтейнера
	|	И НЕ ТипоразмерыТЕ.ПометкаУдаления";
	Запрос.УстановитьПараметр("НаименованиеТипаКонтейнера", ТипКонтейнераСтрокой);
	Выборка = Запрос.Выполнить().Выбрать();	
	
	Если Выборка.Следующий() Тогда
		ТипКонтейнера = Выборка.Типоразмер;
		РазмерКонтейнера = Выборка.РазмерКТК;
	Иначе
		
		ТипКонтейнера = Неопределено;
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	РазмерыКТК.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.РазмерыКТК КАК РазмерыКТК
		|ГДЕ
		|	РазмерыКТК.Наименование = &Наименование
		|	И НЕ РазмерыКТК.ПометкаУдаления";
		РазмерКонтейнераСтрокой = Лев(ТипКонтейнераСтрокой, 2);
		Запрос.УстановитьПараметр("Наименование", РазмерКонтейнераСтрокой);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			РазмерКонтейнера = Выборка.Ссылка;
		Иначе
			РазмерКонтейнера = Неопределено;
		КонецЕсли;
		
	КонецЕсли;	
	
	Контрагент = ПолучитьКонтрагентаСибур();
	
	Если ТипЗнч(НомерДоговора) = Тип("Строка") И ЗначениеЗаполнено(НомерДоговора) Тогда
		Договор = Справочники.ДоговорыКонтрагентов.НайтиПоРеквизиту("Номер", НомерДоговора,, Контрагент);
	Иначе
		НомерДоговора = "";
		Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	КонецЕсли;
			
	ВесПродукции = Число(ОбъектXDTO.WEIGHT);
	КоличествоКонтейнеров = Число(ОбъектXDTO.ALL_CONTAINER_QUANT);
	
	//Заявка на подсыл порожнего
	ЗаявкаПорожнихОбъект.ГруженыйРейс = Ложь;
	
	Если Не ЗначениеЗаполнено(ЗаявкаПорожнихОбъект.ВнешнийНомер) Тогда
		// ДИТ US 60810 TA 66664 Евсенкин М.А. Начало: 30.03.2023
		// Было:
		//ЗаявкаПорожнихОбъект.ВнешнийНомер = ИдентификаторЗаявки; 
		//Стало:
		ЗаявкаПорожнихОбъект.ВнешнийНомер = RFQ_ID;
		// ДИТ US 60810 TA 66664 Евсенкин М.А. Конец: 30.03.2023
	КонецЕсли;

	
	Если Не ЗначениеЗаполнено(ЗаявкаПорожнихОбъект.ВнешняяДата) Тогда
		ЗаявкаПорожнихОбъект.ВнешняяДата = ДатаРазмещенияЗаявки;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗаявкаПорожнихОбъект.Контрагент) Тогда
		ЗаявкаПорожнихОбъект.Контрагент = Контрагент;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗаявкаПорожнихОбъект.Договор) Тогда
		ЗаявкаПорожнихОбъект.Договор = Договор;
	КонецЕсли;
	ЗаявкаПорожнихОбъект.СтатусЗаявкиСибур = СтатусЗаявки;

	// ДИТ US 60810 TA 66664 Евсенкин М.А. Начало: 30.03.2023
	МассивСтрок = ЗаявкаПорожнихОбъект.НомераЛотов.НайтиСтроки(Новый Структура("НомерЛота",НомерЛота));  
	Если Не МассивСтрок.Количество() Тогда  
		НоваяСтрока = ЗаявкаПорожнихОбъект.НомераЛотов.Добавить();
		НоваяСтрока.НомерЛота = НомерЛота;
	КонецЕсли;	
	// ДИТ US 60810 TA 66664 Евсенкин М.А. Конец: 30.03.2023
		
	
	Если Не ЗначениеЗаполнено(ЗаявкаПорожнихОбъект.ПритерминальнаяСтанция) Тогда
		ЗаявкаПорожнихОбъект.ПритерминальнаяСтанция = ПритерминальнаяСтанция;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗаявкаПорожнихОбъект.Грузоотправитель) Тогда
		ЗаявкаПорожнихОбъект.Грузоотправитель = ГрузоотправительПорожних;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗаявкаПорожнихОбъект.СтанцияОтправленияГруженого) Тогда
		ЗаявкаПорожнихОбъект.СтанцияОтправленияГруженого = СтанцияОтправкиГруженого;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗаявкаПорожнихОбъект.СтанцияНазначенияГруженого) Тогда
		ЗаявкаПорожнихОбъект.СтанцияНазначенияГруженого = СтанцияНазначенияГруженого;
	КонецЕсли;
	
	ДанныеПоКалькуляции = ПолучитьКалькуляциюИПротокол(Контрагент, Договор, , СтанцияОтправкиГруженого);
	Калькуляция = ДанныеПоКалькуляции.Калькуляция;
	Протокол = ДанныеПоКалькуляции.Протокол;
	
	Если Не ЗначениеЗаполнено(ЗаявкаПорожнихОбъект.ПСЦ) Тогда
		ЗаявкаПорожнихОбъект.ПСЦ = Протокол;
	КонецЕсли;
	
	ЗаявкаПорожнихОбъект.Прибытие = НеобходимаяДатаПодачиПорожнегоСостава;
	
	Если ЗаявкаПорожнихОбъект.СоставУслуги.Количество() = 0 Тогда
		Для ПорядковыйНомер = 1 По КоличествоКонтейнеров Цикл
			НоваяСтрока = ЗаявкаПорожнихОбъект.СоставУслуги.Добавить();
			НоваяСтрока.ГУИДСтроки = Новый УникальныйИдентификатор;
			НоваяСтрока.ТипКТК = ТипКонтейнера;
			НоваяСтрока.РазмерКТК = РазмерКонтейнера;
			НоваяСтрока.Калькуляция = ДанныеПоКалькуляции.Калькуляция;
			НоваяСтрока.Грузоотправитель = ГрузоотправительПорожних;
			НоваяСтрока.Грузополучатель = Грузоотправитель; //Грузополучатель порожних это грузоотправитель груженых
			НоваяСтрока.СтанцияОтправления = ПритерминальнаяСтанция;
			НоваяСтрока.СтанцияНазначения = СтанцияОтправкиГруженого;
			НоваяСтрока.Груженый = Ложь;
		КонецЦикла;
	КонецЕсли;
	
	//Установка дополнительных свойств для изменения Состояния заявки
	УстановитьДопСвойстваСостоянияЗаявки(ЗаявкаПорожнихОбъект, СтатусЗаявки, ДатаРазмещенияЗаявки, Комментарий);
	
	//Запись заявки
	Попытка
		ЗаявкаПорожнихОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ЗаявкаПорожнихОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецПопытки;
	ЗаявкаПорожних = ЗаявкаПорожнихОбъект.Ссылка;
	НомерЗаявкиПорожних = ЗаявкаПорожнихОбъект.Номер;
	
	//Уведомление ответственного по e-mail об изменении заявки
	ОтборУведомлений = Новый Структура;
	ОтборУведомлений.Вставить("Документ", ЗаявкаПорожних);
	ОтборУведомлений.Вставить("Состояние", Справочники.Состояния.ПроверкаИКонтрольИзмененийДокумента);	
	Пользователи_sd_сервер.УведомитьПользователяОЕгоЗадачах(ОтборУведомлений);	
	
	//Заявка на отправку груженого
	Если ЗначениеЗаполнено(ЗаявкаГруженых) Тогда		
		ЗаявкаГруженыхОбъект = ЗаявкаГруженых.ПолучитьОбъект();
	Иначе		
		ЗаявкаГруженыхОбъект = Документы.Заявка.СоздатьДокумент();
		Попытка
			ЗаявкаГруженыхОбъект.Заполнить(Неопределено);
		Исключение
		КонецПопытки;
		ЗаявкаГруженыхОбъект.Дата = ДатаРазмещенияЗаявки;		
	КонецЕсли;
	
	ЗаявкаГруженыхОбъект.ГруженыйРейс = Истина;
	
	Если Не ЗначениеЗаполнено(ЗаявкаГруженыхОбъект.ВнешнийНомер) Тогда
		// ДИТ US 60810 TA 66664 Евсенкин М.А. Начало: 30.03.2023
		// Было:
		//ЗаявкаГруженыхОбъект.ВнешнийНомер = ИдентификаторЗаявки; 
		//Стало:
		ЗаявкаГруженыхОбъект.ВнешнийНомер = RFQ_ID;
		// ДИТ US 60810 TA 66664 Евсенкин М.А. Конец: 30.03.2023
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗаявкаГруженыхОбъект.ВнешняяДата) Тогда
		ЗаявкаГруженыхОбъект.ВнешняяДата = ДатаРазмещенияЗаявки;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗаявкаГруженыхОбъект.Контрагент) Тогда
		ЗаявкаГруженыхОбъект.Контрагент = Контрагент;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗаявкаГруженыхОбъект.Договор) Тогда
		ЗаявкаГруженыхОбъект.Договор = Договор;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЗаявкаГруженыхОбъект.СтатусЗаявкиСибур) Тогда
		ЗаявкаГруженыхОбъект.СтатусЗаявкиСибур = СтатусЗаявки;
	КонецЕсли;
	
	// ДИТ US 60810 TA 66664 Евсенкин М.А. Начало: 30.03.2023
	МассивСтрок = ЗаявкаГруженыхОбъект.НомераЛотов.НайтиСтроки(Новый Структура("НомерЛота",НомерЛота));  
	Если МассивСтрок.Количество() = 0 Тогда  
		НоваяСтрока = ЗаявкаГруженыхОбъект.НомераЛотов.Добавить();
		НоваяСтрока.НомерЛота = НомерЛота;
	КонецЕсли;
	// ДИТ US 60810 TA 66664 Евсенкин М.А. Конец: 30.03.2023
		
	Если Не ЗначениеЗаполнено(ЗаявкаГруженыхОбъект.ПритерминальнаяСтанция) Тогда
		ЗаявкаГруженыхОбъект.ПритерминальнаяСтанция = ПритерминальнаяСтанция;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗаявкаГруженыхОбъект.Грузоотправитель) Тогда
		ЗаявкаГруженыхОбъект.Грузоотправитель = Грузоотправитель;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗаявкаГруженыхОбъект.СтанцияОтправленияГруженого) Тогда
		ЗаявкаГруженыхОбъект.СтанцияОтправленияГруженого = СтанцияОтправкиГруженого;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗаявкаГруженыхОбъект.СтанцияНазначенияГруженого) Тогда
		ЗаявкаГруженыхОбъект.СтанцияНазначенияГруженого = СтанцияНазначенияГруженого;
	КонецЕсли;
	
	ДанныеПоКалькуляции = ПолучитьКалькуляциюИПротокол(Контрагент, Договор, СтанцияОтправкиГруженого, СтанцияНазначенияГруженого);
	Калькуляция = ДанныеПоКалькуляции.Калькуляция;
	Протокол = ДанныеПоКалькуляции.Протокол;
	
	Если Не ЗначениеЗаполнено(ЗаявкаГруженыхОбъект.ПСЦ) Тогда
		ЗаявкаГруженыхОбъект.ПСЦ = Протокол;
	КонецЕсли;
	
	//Евросиб Каблов 02.02.2021 ( Ticket#0220444	
	//Если Не ЗначениеЗаполнено(ЗаявкаГруженыхОбъект.Отправка) Тогда
	//	ЗаявкаГруженыхОбъект.Отправка = ПлановаяДатаОтгрузкиГруженогоСостава;
	//КонецЕсли;
	ЗаявкаГруженыхОбъект.Отправка = ПлановаяДатаОтгрузкиГруженогоСостава;
	//Евросиб Каблов 02.02.2021 ) 
	
	//Данные по нескольким направлениям
	ЗаявкаГруженыхОбъект.НаправленияОтправки.Очистить();
	СвойствоITEM = ОбъектXDTO.Свойства().Получить("ITEM");
	Если СвойствоITEM <> Неопределено Тогда
		
		ЭлементITEM = ОбъектXDTO.ITEM;
		СвойствоRFQuotItem = ЭлементITEM.Свойства().Получить("RFQuotItem");
		Если СвойствоRFQuotItem <> Неопределено Тогда
			
			ДанныеПоНаправлениям = ЭлементITEM.RFQuotItem;
			Если ТипЗнч(ДанныеПоНаправлениям) = Тип("СписокXDTO") Тогда
				Направления = ДанныеПоНаправлениям;
			Иначе
				Направления = Новый Массив;
				Если ТипЗнч(ДанныеПоНаправлениям) = Тип("ОбъектXDTO") Тогда
					Направления.Добавить(ДанныеПоНаправлениям);
				КонецЕсли;
			КонецЕсли;
			
			Для Каждого Направление Из Направления Цикл
				НоваяСтрока = ЗаявкаГруженыхОбъект.НаправленияОтправки.Добавить();
				НоваяСтрока.КодСтраныНазначения = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(Направление, "FIN_LOC");
				НоваяСтрока.НаименованиеСтраныНазначения = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(Направление, "FIN_LOC_DESCR");
				НоваяСтрока.КоличествоКонтейнеров = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(Направление, "CONTAINER_QUANT");
				НоваяСтрока.ТипУпаковки = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(Направление, "PACK");
				НоваяСтрока.НаименованиеТипаУпаковки = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(Направление, "PACK_D");
				НоваяСтрока.СтранаНазначения = Справочники.СтраныМира.НайтиПоРеквизиту("КодАльфа2", НоваяСтрока.КодСтраныНазначения);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	//Данные по грузам
	ЗаявкаГруженыхОбъект.ОтправляемыеГрузы.Очистить();
	СвойствоPRODUCT = ОбъектXDTO.Свойства().Получить("PRODUCT");
	Если СвойствоPRODUCT <> Неопределено Тогда
		
		ЭлементPRODUCT = ОбъектXDTO.PRODUCT;
		СвойствоRFQuotProduct = ЭлементPRODUCT.Свойства().Получить("RFQuotProduct");
		Если СвойствоRFQuotProduct <> Неопределено Тогда
		
			ДанныеПоГрузам = ЭлементPRODUCT.RFQuotProduct;
			Если ТипЗнч(ДанныеПоГрузам) = Тип("СписокXDTO") Тогда
				Грузы = ДанныеПоНаправлениям;
			Иначе
				Грузы = Новый Массив;
				Если ТипЗнч(ДанныеПоГрузам) = Тип("ОбъектXDTO") Тогда
					Грузы.Добавить(ДанныеПоГрузам);
				КонецЕсли;
			КонецЕсли;
			
			Для Каждого Груз Из Грузы Цикл
				НоваяСтрока = ЗаявкаГруженыхОбъект.ОтправляемыеГрузы.Добавить();
				НоваяСтрока.КодГрузаЕТСНГ = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(Груз, "CARGO");
				НоваяСтрока.НаименованиеГрузаЕТСНГ = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(Груз, "CARGO_DESCR");
				НоваяСтрока.КодГрузаГНГ = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(Груз, "GNG_CODE");
				НоваяСтрока.НаименованиеГрузаГНГ = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(Груз, "GNG_DESCR");
				
				Если ЗначениеЗаполнено(НоваяСтрока.КодГрузаЕТСНГ) Тогда
					НоваяСтрока.Груз = Справочники.Грузы.НайтиПоРеквизиту("ЕТСНГ", НоваяСтрока.КодГрузаЕТСНГ);
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(НоваяСтрока.Груз) И ЗначениеЗаполнено(НоваяСтрока.КодГрузаГНГ) Тогда
					НоваяСтрока.Груз = Справочники.Грузы.НайтиПоРеквизиту("ГНГ", НоваяСтрока.КодГрузаГНГ);
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;		
	КонецЕсли;
	
	Груз = Неопределено;
	КодЕТСНГ = "";
	Если ЗаявкаГруженыхОбъект.ОтправляемыеГрузы.Количество() = 1 Тогда
		СтрокаТЧ = ЗаявкаГруженыхОбъект.ОтправляемыеГрузы[0];
		Груз = СтрокаТЧ.Груз;
		КодЕТСНГ = СтрокаТЧ.КодГрузаЕТСНГ;
	КонецЕсли;
	
	Если ЗаявкаГруженыхОбъект.СоставУслуги.Количество() = 0 Тогда
		Для ПорядковыйНомер = 1 По КоличествоКонтейнеров Цикл
			НоваяСтрока = ЗаявкаГруженыхОбъект.СоставУслуги.Добавить();
			НоваяСтрока.ГУИДСтроки = Новый УникальныйИдентификатор;
			НоваяСтрока.ТипКТК = ТипКонтейнера;
			НоваяСтрока.РазмерКТК = РазмерКонтейнера;
			НоваяСтрока.Калькуляция = ДанныеПоКалькуляции.Калькуляция;
			НоваяСтрока.Грузоотправитель = Грузоотправитель;
			НоваяСтрока.СтанцияОтправления = СтанцияОтправкиГруженого;
			НоваяСтрока.СтанцияНазначения = СтанцияНазначенияГруженого;
			НоваяСтрока.Груженый = Истина;
			// ДИТ US 62421 TA 64346 Евсенкин М.А. Начало: 31.03.2023
			// Было:
			//НоваяСтрока.Груз = Груз; 
			//Стало:
			СтруктураКлючаАналитикиПеревозки = Справочники.КлючиАналитикиПеревозки.СтруктураКлючаАналитикиПеревозки(); 
			СтруктураКлючаАналитикиПеревозки.Груз = Груз;
			КлючАналитикиПеревозки = Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлючаАналитикиПеревозки);
			НоваяСтрока.КлючАналитикиПеревозки = КлючАналитикиПеревозки;
			// ДИТ US 62421 TA 64346 Евсенкин М.А. Конец: 31.03.2023
			НоваяСтрока.КодГруза = КодЕТСНГ;
		КонецЦикла;
	КонецЕсли;
	
	//Запись заявки
	Попытка
		ЗаявкаГруженыхОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ЗаявкаГруженыхОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецПопытки;
	ЗаявкаГруженых = ЗаявкаГруженыхОбъект.Ссылка;
		
	ЗаписьРазмещенияЗаявки = РегистрыСведений.СибурРазмещенныеЗаявки.СоздатьМенеджерЗаписи();
	ЗаписьРазмещенияЗаявки.Заявка = ЗаявкаПорожних;
	// ДИТ US 60810 TA 66664 Евсенкин М.А. Начало: 07.04.2023
	ЗаписьРазмещенияЗаявки.НомерЛота = НомерЛота;
	// ДИТ US 60810 TA 66664 Евсенкин М.А. Конец: 07.04.2023
	ЗаписьРазмещенияЗаявки.ЗаявкаНаОтправкуГруженых = ЗаявкаГруженых;
	ЗаписьРазмещенияЗаявки.RFQ_ID = ИдентификаторЗаявки;
	ЗаписьРазмещенияЗаявки.EXT_RFQ_ID = НомерЗаявкиПорожних;
	ЗаписьРазмещенияЗаявки.КодОКПОГрузоотправителяПоЖД = КодГрузоотправителя;
	ЗаписьРазмещенияЗаявки.НаименованиеГрузоотправителяПоЖД = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ОбъектXDTO, "SHIPPER_DESCR");
	ЗаписьРазмещенияЗаявки.КодКонечнойСтанцииНазначенияПриСухопутье = ПолучитьЗначениеПоляОбъектаXDTO(ОбъектXDTO.EXT_POINT);
	ЗаписьРазмещенияЗаявки.НазваниеКонечнойСтанцииНазначенияПриСухопутье = ПолучитьЗначениеПоляОбъектаXDTO(ОбъектXDTO.EXT_POINT_D);
	ЗаписьРазмещенияЗаявки.КодПритерминальнойЖДСтанции = КодПритерминальнойЖДСтанции;
	ЗаписьРазмещенияЗаявки.НазваниеПритерминальнойЖДСтанции = ПолучитьЗначениеПоляОбъектаXDTO(ОбъектXDTO.TERM_LOC_DESCR);
	ЗаписьРазмещенияЗаявки.ДатаКрайнегоСрокаОтветаЭкспедитора = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ОбъектXDTO, "EST_END_DATETIME", Тип("Дата"));
	ЗаписьРазмещенияЗаявки.ВидЗакупкиКод = ПолучитьЗначениеПоляОбъектаXDTO(ОбъектXDTO.RFQ_ITM_TYPE);
	ЗаписьРазмещенияЗаявки.ВидЗакупкиНаименование = ПолучитьЗначениеПоляОбъектаXDTO(ОбъектXDTO.RFQ_ITM_TYPE_D);
	ЗаписьРазмещенияЗаявки.ВидОтправкиКод = ПолучитьЗначениеПоляОбъектаXDTO(ОбъектXDTO.TRADE_TYPE);
	ЗаписьРазмещенияЗаявки.ВидОтправкиНаименование = ПолучитьЗначениеПоляОбъектаXDTO(ОбъектXDTO.TRADE_TYPE_D);
	ЗаписьРазмещенияЗаявки.НомерДоговора = НомерДоговора;
	ЗаписьРазмещенияЗаявки.НеобходимаяДатаПодачиПорожнегоСостава = НеобходимаяДатаПодачиПорожнегоСостава;
	ЗаписьРазмещенияЗаявки.ПлановаяДатаОтгрузкиГруженогоСостава = ПлановаяДатаОтгрузкиГруженогоСостава;
	ЗаписьРазмещенияЗаявки.КодСтанцииОтправкиГруженого = КодСтанцииОтправкиГруженого;
	ЗаписьРазмещенияЗаявки.НазваниеСтанцииОтправкиГруженого = ПолучитьЗначениеПоляОбъектаXDTO(ОбъектXDTO.DEST_LOC_DESCR);
	ЗаписьРазмещенияЗаявки.МаршрутСледованияГруженогоПоезда = ПолучитьЗначениеПоляОбъектаXDTO(ОбъектXDTO.DEST_LOAD);
	ЗаписьРазмещенияЗаявки.КодСтанцииНазначенияГруженого = КодСтанцииНазначенияГруженого;
	ЗаписьРазмещенияЗаявки.НазваниеСтанцииНазначенияГруженого = ПолучитьЗначениеПоляОбъектаXDTO(ОбъектXDTO.DEST_POINT_D);
	ЗаписьРазмещенияЗаявки.ОбщееКоличествоЗапрашиваемыхКонтейнеров = ПолучитьЗначениеПоляОбъектаXDTO(ОбъектXDTO.ALL_CONTAINER_QUANT);
	ЗаписьРазмещенияЗаявки.ЕдиницаИзмеренияКоличестваКонтейнеров = ПолучитьЗначениеПоляОбъектаXDTO(ОбъектXDTO.CONTAINER_QUANT_UOM);
	ЗаписьРазмещенияЗаявки.КодТипаКонтейнеров = ПолучитьЗначениеПоляОбъектаXDTO(ОбъектXDTO.CONTAINER_MOT);
	ЗаписьРазмещенияЗаявки.ВесПродукции = ПолучитьЗначениеПоляОбъектаXDTO(ОбъектXDTO.WEIGHT);
	ЗаписьРазмещенияЗаявки.ЕдиницаИзмеренияВесаПродукции = ПолучитьЗначениеПоляОбъектаXDTO(ОбъектXDTO.WEIGHT_UOM);
	ЗаписьРазмещенияЗаявки.Комментарий = Комментарий;
	ЗаписьРазмещенияЗаявки.ИмяМенеджера = ПолучитьЗначениеПоляОбъектаXDTO(ОбъектXDTO.TEND_MANAGER_DESCR);
	ЗаписьРазмещенияЗаявки.КонтактныйТелефонМенеджера = ПолучитьЗначениеПоляОбъектаXDTO(ОбъектXDTO.TEND_MANAGER_TEL);
	ЗаписьРазмещенияЗаявки.АдресЭлектроннойПочтыМенеджера = ПолучитьЗначениеПоляОбъектаXDTO(ОбъектXDTO.TEND_MANAGER_MAIL);	
	ЗаписьРазмещенияЗаявки.Записать();
	
	ЗаписьСтатусаЗаявки = РегистрыСведений.СибурСтатусыЗаявок.СоздатьМенеджерЗаписи();
	ЗаписьСтатусаЗаявки.Период = ДатаРазмещенияЗаявки;
	ЗаписьСтатусаЗаявки.Заявка = ЗаявкаПорожних; 
	ЗаписьСтатусаЗаявки.СтатусЗаявки = СтатусЗаявки;
	ЗаписьСтатусаЗаявки.Записать();	
	
	//Ответ на запрос
	Ответ = ПолучитьОбъектXDTO("urn:sibur:po:a:LP:RFQ", "RFQuot");
	Ответ.RFQ_ID = ОбъектXDTO.RFQ_ID;
	Ответ.EXT_RFQ_ID = НомерЗаявкиПорожних;
	Ответ.STATUS_DATE = ДатаРазмещенияЗаявки;
	
	Возврат Ответ;
	
КонецФункции

Функция ПолучитьПредложениеПоЗаявке(ОбъектXDTO) Экспорт
			
	RFQ_ID = ОбъектXDTO.RFQ_ID;	
	
	Выборка = ПолучитьРезультатЗапросаПоЗаявке(RFQ_ID).Выбрать();
	
	Ответ = ПолучитьОбъектXDTO("urn:sibur:po:a:LP:RFQ", "RFQuotNotif");
	ДатаОтвета = ТекущаяДатаСеанса();	
	Если Выборка.Следующий() Тогда				
		
		//КоличествоКонтейнеров = Выборка.КоличествоКТК20 + Выборка.КоличествоКТК40 * 2;
		КоличествоКонтейнеров = Выборка.КоличествоКонтейнеров20 + Выборка.КоличествоКонтейнеров40 + Выборка.КоличествоКонтейнеров45;
				
		// ДИТ US 60810 TA 66664 Евсенкин М.А. Начало: 11.05.2023
		// Было:
		//Ответ.RFQ_ID = Выборка.RFQ_ID; 
		//Стало:
		Ответ.RFQ_ID = RFQ_ID;
		// ДИТ US 60810 TA 66664 Евсенкин М.А. Конец: 11.05.2023
		Ответ.EXT_RFQ_ID = Выборка.EXT_RFQ_ID;
		Ответ.RESP_STATUS_RFQ = Выборка.СтатусЗаявкиКод;
		Ответ.RESP_STATUS_RFQ_D = Выборка.СтатусЗаявкиНаименование;
		//Ответ.ETA_CONT = Выборка.НеобходимаяДатаПодачиПорожнегоСостава;
		Ответ.ETA_CONT = Выборка.ДатаПрибытияПорожнихКонтейнеров;
		//Евросиб Каблов 25.10.2021 ( Ticket#0243051
		//Ответ.ETA_SOURCE = Выборка.ПлановаяДатаОтправленияПорожнего;
		Если ЗначениеЗаполнено(Выборка.ФактическаяДатаОтправленияПорожнегоРейса) Тогда
			Ответ.ETA_SOURCE = Выборка.ФактическаяДатаОтправленияПорожнегоРейса;
		Иначе
			Ответ.ETA_SOURCE = Выборка.ПлановаяДатаОтправленияПорожнего;
		КонецЕсли;
		//Евросиб Каблов 25.10.2021 )
		
		//Экспедитор исполнитель
