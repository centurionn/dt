Функция ПолучитьДислокациюКонтейнеров(XMLRequest) Экспорт
	
	//ФорматДаты = "ДФ=yyyy-MM-ddTHH:mm:ss+03:00";
	ФорматДаты = "ДФ=yyyy-MM-ddTHH:mm:ss";
	//ТаблицаСтатусов = ПолучитьТаблицуДислокационныхСтатусов();
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(XMLRequest);
	
	ОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(Чтение);
		
	Если ОбъектXDTO.Свойства().Получить("CREATED_ON_START") <> Неопределено Или ОбъектXDTO.Свойства().Получить("CREATED_ON_END") <> Неопределено Тогда
		ДатаНачала = XMLЗначение(Тип("Дата"), ОбъектXDTO.CREATED_ON_START);
		//ДатаНачала = МестноеВремя(ДатаНачала); //Преобразование выполняется в вызывающем сервисе
		ДатаОкончания = XMLЗначение(Тип("Дата"), ОбъектXDTO.CREATED_ON_END);
		//ДатаОкончания = МестноеВремя(ДатаОкончания); //Преобразование выполняется в вызывающем сервисе
	Иначе
		Возврат "";
	КонецЕсли;
	
	Если ОбъектXDTO.Свойства().Получить("CONTAINER_ID") <> Неопределено Тогда
		ИдентификаторКонтейнера = ОбъектXDTO.CONTAINER_ID;
		Если ТипЗнч(ИдентификаторКонтейнера) <> Тип("Строка") Тогда
			ИдентификаторКонтейнера = "";
		КонецЕсли;
	Иначе
		ИдентификаторКонтейнера = "";
	КонецЕсли;
	
	Выборка = ПолучитьВыборкуДислокационныхДанныхПоИдентификаторуКонтейнераЗаПериод(ДатаНачала, ДатаОкончания, ИдентификаторКонтейнера);
	
	Запись = Новый ЗаписьXML;
		
	Запись.УстановитьСтроку("UTF-8");
	//Запись.ЗаписатьОбъявлениеXML();
	//
	Запись.ЗаписатьНачалоЭлемента("DislocationContData");
	//
	//ЕСОбменСервер.ДобавитьАтрибутВФайл(Запись, "xmlns:n0", "urn:sibur:po:a:TM:Railway");
	
	Если Выборка.Количество() > 0 Тогда
		Пока Выборка.Следующий() Цикл
			
			//Запись.ЗаписатьНачалоЭлемента("ROW");
			Запись.ЗаписатьНачалоЭлемента("ContPlat");
		
			ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "WAYBILL_INV_NUM", Выборка.НомерНакладной);
			ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "PARENT_KEY_WBINVNUM", ""); //Номер досылочной накладной, если имеется
			ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "INDEX_RW", Выборка.ИндексПоезда); //Индекс поезда
			
			НомерПоезда = "";
			Если ЗначениеЗаполнено(Выборка.ИндексПоезда) Тогда
				НомерПоезда = Сред(Выборка.ИндексПоезда, 7, 3);
			КонецЕсли;
			ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "NUMBER_RW", НомерПоезда);			//Номер поезда
