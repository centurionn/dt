Функция ПолучитьСвойстваЗаявки(ОбъектXDTO)
	
	СвойстваЗаявки = Новый Структура;	
	//												Наименование поля	Тип данных	Описание	"Обязательное поле?"
	//Запрос (СИБУР -> ЛП):	Отправка заявки 		
	СвойстваЗаявки.Вставить("RFQ_ID");				//RFQ_ID	CHAR 21	Идентификатор заявки на перевозку из SAP TM  конкретному ЛП	Да
	СвойстваЗаявки.Вставить("EXT_RFQ_ID");			//EXT_RFQ_ID	CHAR 20	Идентификатор внешней заявки в ИС ЛП. 	
	СвойстваЗаявки.Вставить("RESP_STATUS_RFQ");		//RESP_STATUS_RFQ	CHAR 2	Код статуса заявки из справочника RESP_STATUS_RFQ	Да
	СвойстваЗаявки.Вставить("RESP_STATUS_RFQ_D");	//RESP_STATUS_RFQ_D	CHAR 20	Описание статуса заявки из справочника RESP_STATUS_RFQ	
	СвойстваЗаявки.Вставить("EST_END_DATETIME");	//EST_END_DATETIME	DATE(RUS03)	Дата крайнего срока ответа экспедитора 	Да
	СвойстваЗаявки.Вставить("RFQ_ITM_TYPE");		//RFQ_ITM_TYPE	CHAR 5	Вид закупки из справочника RFQ_ITM_TYPE 	Да
	СвойстваЗаявки.Вставить("RFQ_ITM_TYPE_D");		//RFQ_ITM_TYPE_D	CHAR 30	Описание вида закупки	
	СвойстваЗаявки.Вставить("TRADE_TYPE");			//TRADE_TYPE	CHAR 1	Вид отправки из справочника TRADE_TYPE	
	СвойстваЗаявки.Вставить("TRADE_TYPE_D");		//TRADE_TYPE_D	CHAR 15	Описание вида отправки	
	СвойстваЗаявки.Вставить("FAG_ID_DESR");			//FAG_ID_DESR	CHAR 60	Регистрационный номер договора с ЛП	
	СвойстваЗаявки.Вставить("ETA_CONT");			//ETA_CONT	DATE(RUS03)	Дата, к которой необходима подача порожнего состава на завод	Да
	СвойстваЗаявки.Вставить("ETD_PLANT");			//ETD_PLANT	DATE(RUS03)	Плановая дата отгрузки гружёного состава с завода	Да
	СвойстваЗаявки.Вставить("DEST_LOC");			//DEST_LOC	CHAR 20	Код станции назначения порожнего  (она же станция отправления груженого)	Да
	СвойстваЗаявки.Вставить("DEST_LOC_DESCR");		//DEST_LOC_DESCR	CHAR 255	Название станции назначения порожнего/станции отправления груженого	
	СвойстваЗаявки.Вставить("SHIPPER_ID");			//SHIPPER_ID	CHAR 20	Код ОКПО грузоотправителя по ЖД	Да
	СвойстваЗаявки.Вставить("SHIPPER_DESCR");		//SHIPPER_DESCR	CHAR 255	Описание грузоотправителя по ЖД	Да
	СвойстваЗаявки.Вставить("DEST_LOAD");			//DEST_LOAD	CHAR 255	Маршрут следования груженого поезда	Да		
	СвойстваЗаявки.Вставить("DEST_POINT");			//DEST_POINT	CHAR 20	Код станции назначения (конечная станция ж/д перевозки) .	
	СвойстваЗаявки.Вставить("DEST_POINT_D");		//DEST_POINT_D	CHAR 255	Описание станции назначения 	
	СвойстваЗаявки.Вставить("EXT_POINT");			//EXT_POINT	CHAR 20	Код конечной станции назначения при сухопутье	
	СвойстваЗаявки.Вставить("EXT_POINT_D");			//EXT_POINT_D	CHAR 255	Описание конечной станции назначения при сухопутье	
	СвойстваЗаявки.Вставить("TERM_LOC");			//TERM_LOC	CHAR 20	Код притерминальной ж/д станции. Сток ктк. 	
	СвойстваЗаявки.Вставить("TERM_LOC_DESCR");		//TERM_LOC_DESCR	CHAR 255	Название притерминальной ж/д станции. Сток ктк	
	СвойстваЗаявки.Вставить("ALL_CONTAINER_QUANT");	//ALL_CONTAINER_QUANT	QUAN 5	Общее кол-во запрашиваемых контейнеров в рамках одной заявки 	Да
	СвойстваЗаявки.Вставить("CONTAINER_QUANT_UOM");	//CONTAINER_QUANT_UOM	UNIT 6	ЕИ количества контейнеров из справочника QUANT_UOM	Да
	СвойстваЗаявки.Вставить("CONTAINER_MOT");		//CONTAINER_MOT	CHAR 4	Тип контейнеров из справочника CONTAINER_MOT	Да
	СвойстваЗаявки.Вставить("WEIGHT");				//WEIGHT	QUAN 31	Вес продукции (в расчете на один ктк)	Да
	СвойстваЗаявки.Вставить("WEIGHT_UOM");			//WEIGHT_UOM	UNIT 3	ЕИ Вес продукции  из справочника WEIGHT_UOM	Да		
	СвойстваЗаявки.Вставить("COMMENT");				//COMMENT	CHAR 255	Комментарий	
	СвойстваЗаявки.Вставить("TEND_MANAGER_DESCR");	//TEND_MANAGER_DESCR	CHAR 60	Контактное лицо со стороны Сибур	
	СвойстваЗаявки.Вставить("TEND_MANAGER_TEL");	//TEND_MANAGER_TEL	CHAR 20	Контактный телефон (лицо со стороны Сибур)	
	СвойстваЗаявки.Вставить("TEND_MANAGER_MAIL");	//TEND_MANAGER_MAIL	CHAR 50	Электронная почта почта (лицо со стороны Сибур)
	//Массив данных по нескольким направлениям
	СвойстваЗаявки.Вставить("FIN_LOC");				//FIN_LOC	CHAR 10	Страна назначения	
	СвойстваЗаявки.Вставить("FIN_LOC_DESCR");		//FIN_LOC_DESCR	CHAR 255	Описание направления/страна назначения
	СвойстваЗаявки.Вставить("CONTAINER_QUANT");		//CONTAINER_QUANT	QUAN 5	Общее кол-во запрашиваемых контейнеров в рамках одной заявки 	Да
	СвойстваЗаявки.Вставить("PACK");				//PACK	UNIT 2	Тип упаковки продукции из справочника PACK	
	СвойстваЗаявки.Вставить("PACK_D");				//PACK_D	CHAR 70	Описание типа упаковки
	//Массив данных по нескольким продуктам
	СвойстваЗаявки.Вставить("CARGO");				//CARGO	CHAR 20	Код груза (ЕТСНГ)	Да
	СвойстваЗаявки.Вставить("CARGO_DESCR");			//CARGO_DESCR	CHAR 60	Наименование груза (ЕТСНГ)	
	СвойстваЗаявки.Вставить("GNG_CODE");			//GNG_CODE	CHAR 8	Код груза (ГНГ) 	Да
	СвойстваЗаявки.Вставить("GNG_DESCR");			//GNG_DESCR	CHAR 50	Наименование груза (ГНГ)
	
	ЗаполнитьЗначенияСвойств(СвойстваЗаявки, ОбъектXDTO);
	
	Возврат СвойстваЗаявки;
	
КонецФункции

