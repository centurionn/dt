//3. Букинги

Функция БронированиеМестНаСудне(ДанныеПоБукингу) Экспорт
	
	//Заглушка
	//Процедура на стадии тестирования. Может выполняться только на тестовых базах.
	Если Не ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДатаРазмещения = ПолучитьЗначениеПоляОбъектаXDTO(ДанныеПоБукингу.CHANGED_ON, Тип("Дата"));
	ИДБукинга = ПолучитьЗначениеПоляОбъектаXDTO(ДанныеПоБукингу.TOR_ID);
	НомерБукинга = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоБукингу, "REF_BOOKING_ID",, "0");
	КодМорскойЛинии = ПолучитьЗначениеПоляОбъектаXDTO(ДанныеПоБукингу.CARRIER_ID);
	Комментарий = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоБукингу, "COMMENT",, "");
	
	ПустаяДата = '00010101';
	ПлановаяДатаПрибытияВПортОтправления = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоБукингу, "ETA_TO_POL", Тип("Дата"), ПустаяДата);
	ПлановаяДатаОтправленияНачало = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоБукингу, "ETD_START", Тип("Дата"), ПустаяДата);
	ПлановаяДатаОтправленияОкончание = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоБукингу, "ETD_END", Тип("Дата"), ПустаяДата);
	ПлановаяДатаПрибытияВПортНазначенияНачало = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоБукингу, "ETA_TO_POD_I", Тип("Дата"), ПустаяДата);
	ПлановаяДатаПрибытияВПортНазначенияОкончание = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоБукингу, "ETA_TO_POD_O", Тип("Дата"), ПустаяДата);
	
	КодСтатусаЗаявки = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоБукингу, "FB_STATUS",, "");
	СтатусЗаявки = ПолучитьСтатусЗаявки(Перечисления.ВидыЗаявокСибура.ЗаявкаБукинг, КодСтатусаЗаявки);
		
	//Получение соответствия локаций кодам портов
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Локации.КодПортаUNLOCODE КАК КодПортаUNLOCODE,
		|	Локации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Локации КАК Локации
		|ГДЕ
		|	Локации.КодПортаUNLOCODE В(&Коды)";
	
	КодыПортов = Новый Массив;
	
	КодПортаОтправления = ПолучитьЗначениеПоляОбъектаXDTO(ДанныеПоБукингу.POL);
	Если ЗначениеЗаполнено(КодПортаОтправления) Тогда
		КодыПортов.Добавить(КодПортаОтправления);
	КонецЕсли;
	
	КодПортаНазначения = ПолучитьЗначениеПоляОбъектаXDTO(ДанныеПоБукингу.POD);
	Если ЗначениеЗаполнено(КодПортаНазначения) Тогда
		КодыПортов.Добавить(КодПортаНазначения);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Коды", КодыПортов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	ПортыПоКодам = Новый Соответствие;
	Если Выборка.Следующий() Тогда
		ПортыПоКодам.Вставить(Выборка.КодПортаUNLOCODE, Выборка.Ссылка);
	КонецЕсли;
	
	//Получение рейса
	Линия = Справочники.МорскиеЛинии.НайтиПоРеквизиту("КодСибур", КодМорскойЛинии);
	НазваниеСудна = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоБукингу, "VESSEL_NUM",, "");
	НомерРейса = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоБукингу, "VOYAGE",, "");
	//Евросиб Каблов 30.01.2021 (	
	//Рейс = ПолучитьМорскойРейс(НомерРейса, НазваниеСудна, Линия);
	Судно = ПолучитьСудно(НазваниеСудна);
	Рейс = ПолучитьМорскойРейс(НомерРейса, Судно, Линия);	
	//Евросиб Каблов 30.01.2021 ) 
	
	//Получение букинга
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Букинг.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Букинг КАК Букинг
	|ГДЕ
	|	Букинг.ИДБукинга = &ИдентификаторБукинга";	
	Запрос.УстановитьПараметр("ИдентификаторБукинга", ИДБукинга);	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда		
		БукингОбъект = Выборка.Ссылка.ПолучитьОбъект();
	Иначе
		БукингОбъект = Документы.Букинг.СоздатьДокумент();
		БукингОбъект.Заполнить(Неопределено);
		БукингОбъект.ИДБукинга = ИДБукинга;
		БукингОбъект.Дата = ДатаРазмещения;
		БукингОбъект.НомерБукинга = НомерБукинга;
		//++ Зубов 0228547 20.09.2021
		БукингОбъект.Контрагент = Константы.СибурКонтрагент.Получить();
		//-- Зубов 0228547 20.09.2021
	КонецЕсли;
		
	БукингОбъект.СтатусЗаявки = СтатусЗаявки;	
	БукингОбъект.КоличествоЗапрошенныхКонтейнеров = ПолучитьЗначениеПоляОбъектаXDTO(ДанныеПоБукингу.QUANT, Тип("Число"));
	БукингОбъект.Линия = Линия;
	БукингОбъект.ПортОтправления = ПортыПоКодам.Получить(КодПортаНазначения);
	БукингОбъект.ПортНазначения = ПортыПоКодам.Получить(КодПортаОтправления);
	БукингОбъект.ПлановаяДатаПрибытияВПортОтправления = ПлановаяДатаПрибытияВПортОтправления;
	БукингОбъект.ПлановаяДатаОтправленияНачало = ПлановаяДатаОтправленияНачало;
	БукингОбъект.ПлановаяДатаОтправленияОкончание = ПлановаяДатаОтправленияОкончание;
	БукингОбъект.ПлановаяДатаПрибытияВПортНазначенияНачало = ПлановаяДатаПрибытияВПортНазначенияНачало;
	БукингОбъект.ПлановаяДатаПрибытияВПортНазначенияОкончание = ПлановаяДатаПрибытияВПортНазначенияОкончание;
	БукингОбъект.Рейс = Рейс;
	БукингОбъект.Грузоотправитель = ПолучитьКонтрагентаСибур();
	БукингОбъект.Комментарий = ПолучитьЗначениеПоляОбъектаXDTO(ДанныеПоБукингу.COMMENT);
	
	ТаблицаКонтейнеров = ПолучитьТаблицуКонтейнеровБукинга(ДанныеПоБукингу.ITEM);
	БукингОбъект.Контейнеры.Загрузить(ТаблицаКонтейнеров);
	
	//Установка дополнительных свойств для изменения Состояния заявки
	УстановитьДопСвойстваСостоянияЗаявки(БукингОбъект, СтатусЗаявки, ДатаРазмещения, Комментарий);
	
	БукингОбъект.Записать(РежимЗаписиДокумента.Запись);
	БукингСсылка = БукингОбъект.Ссылка;
	
	//Уведомление ответственного по e-mail об изменении заявки
	ОтборУведомлений = Новый Структура;
	ОтборУведомлений.Вставить("Документ", БукингСсылка);
	ОтборУведомлений.Вставить("Состояние", Справочники.Состояния.ПроверкаИКонтрольИзмененийДокумента);	
	Пользователи_sd_сервер.УведомитьПользователяОЕгоЗадачах(ОтборУведомлений);
	
	ИДБукингаУПеревозчика = Строка(БукингСсылка.УникальныйИдентификатор());
	
	//Запись данных о размещенном букинге
	ЗаписьБукинга = РегистрыСведений.СибурРазмещенныеБукинги.СоздатьМенеджерЗаписи();
	ЗаписьБукинга.Букинг = БукингСсылка;
	ЗаписьБукинга.ИдентификаторБукинга = ИДБукинга;
	//ЗаписьБукинга.ИдентификаторЗаявкиУПеревозчика = ПолучитьЗначениеПоляОбъектаXDTO(ДанныеПоБукингу.EXT_TOR_ID);
	ЗаписьБукинга.НомерБукинга = НомерБукинга;
	ЗаписьБукинга.КоличествоКонтейнеровПоЗаявкеНаБукинг = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоБукингу, "QUANT", Тип("Число"), 0);
	ЗаписьБукинга.МорскаяЛиния = КодМорскойЛинии;
	ЗаписьБукинга.ОписаниеМорскойЛинии = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоБукингу, "CARRIER_ID_DESC",, "");
	ЗаписьБукинга.ПортОтправления = КодПортаОтправления;
	ЗаписьБукинга.ОписаниеПортаОтправления = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоБукингу, "POL_DESCR",, "");
	ЗаписьБукинга.ПортНазначения = КодПортаНазначения;
	ЗаписьБукинга.ОписаниеПортаНазначения = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоБукингу, "POD_DESCR",, "");
	ЗаписьБукинга.ПлановаяДатаПрибытияВПортОтправления = ПлановаяДатаПрибытияВПортОтправления;
	ЗаписьБукинга.ПлановаяДатаОтправленияНачало = ПлановаяДатаОтправленияНачало;
	ЗаписьБукинга.ПлановаяДатаОтправленияОкончание = ПлановаяДатаОтправленияОкончание;
	ЗаписьБукинга.ПлановаяДатаПрибытияВПортНазначенияНачало = ПлановаяДатаПрибытияВПортНазначенияНачало;
	ЗаписьБукинга.ПлановаяДатаПрибытияВПортНазначенияОкончание = ПлановаяДатаПрибытияВПортНазначенияОкончание;
	ЗаписьБукинга.НазваниеСудна = НазваниеСудна;
	ЗаписьБукинга.НомерРейса = НомерРейса;
	ЗаписьБукинга.НаименованиеГрузоотправителя = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоБукингу, "SHIPPER_DESCR",, "");
	ЗаписьБукинга.КонтактноеЛицо = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоБукингу, "TEND_MANAGER_DESCR",, "");
	ЗаписьБукинга.КонтактныйТелефон = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоБукингу, "TEND_MANAGER_TEL",, "");
	ЗаписьБукинга.ЭлектроннаяПочта = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоБукингу, "TEND_MANAGER_MAIL",, "");
	ЗаписьБукинга.Комментарий = Комментарий;
	ЗаписьБукинга.Записать();
	
	//Запись данных о статусе букинга
	ЗаписьСтатусаБукинга = РегистрыСведений.СибурСтатусыБукингов.СоздатьМенеджерЗаписи();
	ЗаписьСтатусаБукинга.Период = ДатаРазмещения;
	ЗаписьСтатусаБукинга.Букинг = БукингСсылка;
	ЗаписьСтатусаБукинга.СтатусЗаявкиНаБукинг = СтатусЗаявки;
	ЗаписьСтатусаБукинга.Записать();
	
	//Формирование ответа на запрос
	Ответ = ПолучитьОбъектXDTO("urn:sibur:po:a:LP:Bookings", "Booking");
	Ответ.TOR_ID = ИДБукинга;
	Ответ.REF_BOOKING_ID = НомерБукинга;
	Ответ.EXT_TOR_ID = ИДБукингаУПеревозчика;
	Ответ.STATUS_DATE = ДатаРазмещения;
	
	Возврат Ответ;
	
КонецФункции

Функция ПодтверждениеБронированияМестНаСудне(ДанныеЗапроса) Экспорт
	
	//Заглушка
	//Процедура на стадии тестирования. Может выполняться только на тестовых базах.
	Если Не ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДатаПодтверждения = ТекущаяДатаСеанса();
	
	ИДБукинга = ПолучитьЗначениеПоляОбъектаXDTO(ДанныеЗапроса.TOR_ID);
	НомерБукинга = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "REF_BOOKING_ID",, "");
	ИДБукингаУПеревозчика = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "EXT_TOR_ID",, "");
	КодСтатусаСогласования = ПолучитьЗначениеПоляОбъектаXDTO(ДанныеЗапроса.FB_STATUS);
	ОписаниеСтатусаСогласования = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "FB_STATUS_DESCR",, "");
	СтатусЗаявки = ПолучитьСтатусЗаявки(Перечисления.ВидыЗаявокСибура.ЗаявкаБукинг, КодСтатусаСогласования);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДокументБукинг.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Букинг КАК ДокументБукинг
		|ГДЕ
		|	ДокументБукинг.ИДБукинга = &ИДБукинга";	
	Запрос.УстановитьПараметр("ИДБукинга", ИДБукинга);	
	Выборка = Запрос.Выполнить().Выбрать();
		
	Если Выборка.Следующий() Тогда
		
		БукингСсылка = Выборка.Ссылка;
		БукингОбъект = БукингСсылка.ПолучитьОбъект();
		БукингОбъект.СтатусЗаявки = СтатусЗаявки;
		
		//Установка дополнительных свойств для изменения Состояния заявки
		УстановитьДопСвойстваСостоянияЗаявки(БукингОбъект, СтатусЗаявки, ДатаПодтверждения);
		
		БукингОбъект.Записать(РежимЗаписиДокумента.Запись);
		
		//Уведомление ответственного по e-mail об изменении заявки
		ОтборУведомлений = Новый Структура;
		ОтборУведомлений.Вставить("Документ", БукингСсылка);
		ОтборУведомлений.Вставить("Состояние", Справочники.Состояния.ПроверкаИКонтрольИзмененийДокумента);	
		Пользователи_sd_сервер.УведомитьПользователяОЕгоЗадачах(ОтборУведомлений);
		
		ЗаписьСтатуса = РегистрыСведений.СибурСтатусыБукингов.СоздатьМенеджерЗаписи();
		ЗаписьСтатуса.Период = ДатаПодтверждения;
		ЗаписьСтатуса.Букинг = Выборка.Ссылка;
		ЗаписьСтатуса.СтатусЗаявкиНаБукинг = СтатусЗаявки;
		ЗаписьСтатуса.Записать();
		
		ИДБукингаУПеревозчика = Строка(Выборка.Ссылка.УникальныйИдентификатор());
		
	КонецЕсли;	
	
	Ответ = ПолучитьОбъектXDTO("urn:sibur:po:a:LP:Bookings", "BookingConfirm");
	Ответ.TOR_ID = ИДБукинга;
	Ответ.REF_BOOKING_ID = НомерБукинга;
	Ответ.EXT_TOR_ID = ИДБукингаУПеревозчика;
	Ответ.STATUS_DATE = ДатаПодтверждения;
	
	Возврат Ответ;
	
КонецФункции

Функция УведомлениеОБронированииМестНаСудне(ДанныеЗапроса) Экспорт
	
	//Заглушка
	//Процедура на стадии тестирования. Может выполняться только на тестовых базах.
	Если Не ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДатаУведомления = ТекущаяДатаСеанса();
	
	ИДБукинга = ПолучитьЗначениеПоляОбъектаXDTO(ДанныеЗапроса.TOR_ID);
	НомерБукинга = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "REF_BOOKING_ID",, "");
	ИДБукингаУПеревозчика = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "EXT_TOR_ID",, "");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Букинг.Ссылка КАК Ссылка,
	|	Букинг.Редактор КАК Редактор,
	|	Букинг.Линия КАК Линия,
	|	ЕСТЬNULL(Букинг.Линия.КодСибур, """") КАК ЛинияКодСибур,
	|	ЕСТЬNULL(Букинг.Линия.Наименование, """") КАК ЛинияНаименование,
	|	Букинг.ДедлайнСогласованияБукингаГрузоотправителем КАК ДедлайнСогласованияБукингаГрузоотправителем,
	|	Букинг.ДатаЗакрытияСудна КАК ДатаЗакрытияСудна,
	|	Букинг.ДатаОтправленияПоРасписанию КАК ДатаОтправленияПоРасписанию,
	|	Букинг.ДатаПрибытияПоРасписанию КАК ДатаПрибытияПоРасписанию,
	|	Букинг.КоличествоПодтвержденныхКонтейнеров КАК КоличествоПодтвержденныхКонтейнеров,
	|	Букинг.НомерБукинга КАК НомерБукинга,
	|	ЕСТЬNULL(Букинг.ПортТрансшипмента.КодПортаUNLOCODE, """") КАК ПортТрансшипментаКод,
	|	ЕСТЬNULL(Букинг.ПортТрансшипмента.Наименование, """") КАК ПортТрансшипментаНаименование,
	|	Букинг.ПлановаяДатаПрибытияВПортТрансшипмента КАК ПлановаяДатаПрибытияВПортТрансшипмента,
	|	Букинг.ПлановаяДатаОтправленияИзПортаТрансшипмента КАК ПлановаяДатаОтправленияИзПортаТрансшипмента
	|ПОМЕСТИТЬ ВТБукинг
	|ИЗ
	|	Документ.Букинг КАК Букинг
	|ГДЕ
	|	Букинг.ИДБукинга = &ИДБукинга
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТБукинг.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(Пользователи.Наименование, """") КАК ИмяМенеджера,
	|	ЕСТЬNULL(КонтактнаяИнформацияТелефон.Представление, """") КАК ТелефонМенеджера,
	|	ЕСТЬNULL(КонтактнаяИнформацияАдресЭлПочты.Представление, """") КАК АдресЭлПочтыМенеджера
	|ПОМЕСТИТЬ ВТКонтактыМенеджера
	|ИЗ
	|	ВТБукинг КАК ВТБукинг
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи.КонтактнаяИнформация КАК КонтактнаяИнформацияТелефон
	|			ПО Пользователи.Ссылка = КонтактнаяИнформацияТелефон.Ссылка
	|				И (КонтактнаяИнформацияТелефон.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонПользователя))
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи.КонтактнаяИнформация КАК КонтактнаяИнформацияАдресЭлПочты
	|			ПО Пользователи.Ссылка = КонтактнаяИнформацияАдресЭлПочты.Ссылка
	|				И (КонтактнаяИнформацияАдресЭлПочты.Ссылка = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailПользователя))
	|		ПО ВТБукинг.Редактор = Пользователи.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТБукинг.Ссылка КАК Букинг,
	|	СибурСтатусыБукинговСрезПоследних.СтатусЗаявкиНаБукинг КАК СтатусЗаявкиНаБукинг,
	|	ЕСТЬNULL(СибурСтатусыБукинговСрезПоследних.СтатусЗаявкиНаБукинг.КодСтатуса, """") КАК СтатусЗаявкиНаБукингКод,
	|	ЕСТЬNULL(СибурСтатусыБукинговСрезПоследних.СтатусЗаявкиНаБукинг.Наименование, """") КАК СтатусЗаявкиНаБукингНаименование,
	|	СибурСтатусыБукинговСрезПоследних.ПричинаОтклоненияЗаявки КАК ПричинаОтклоненияЗаявки,
	|	СибурСтатусыБукинговСрезПоследних.ПричинаОтклоненияЗаявки.Код КАК ПричинаОтклоненияЗаявкиКод,
	|	СибурСтатусыБукинговСрезПоследних.ПричинаОтклоненияЗаявки.Наименование КАК ПричинаОтклоненияЗаявкиНаименование,
	|	ВТБукинг.НомерБукинга КАК НомерБукинга,
	|	ВТБукинг.Линия КАК Линия,
	|	ВТБукинг.ЛинияКодСибур КАК ЛинияКодСибур,
	|	ВТБукинг.ЛинияНаименование КАК ЛинияНаименование,
	|	СибурРазмещенныеБукинги.НазваниеСудна КАК НазваниеСудна,
	|	СибурРазмещенныеБукинги.НомерРейса КАК НомерРейса,
	|	ВТБукинг.ДедлайнСогласованияБукингаГрузоотправителем КАК ДедлайнСогласованияБукингаГрузоотправителем,
	|	ВТБукинг.ДатаЗакрытияСудна КАК ДатаЗакрытияСудна,
	|	ВТБукинг.ДатаОтправленияПоРасписанию КАК ДатаОтправленияПоРасписанию,
	|	ВТБукинг.ДатаПрибытияПоРасписанию КАК ДатаПрибытияПоРасписанию,
	|	ВТБукинг.КоличествоПодтвержденныхКонтейнеров КАК КоличествоПодтвержденныхКонтейнеров,
	|	ВТБукинг.ПортТрансшипментаКод КАК ПортТрансшипментаКод,
	|	ВТБукинг.ПортТрансшипментаНаименование КАК ПортТрансшипментаНаименование,
	|	ВТБукинг.ПлановаяДатаПрибытияВПортТрансшипмента КАК ПлановаяДатаПрибытияВПортТрансшипмента,
	|	ВТБукинг.ПлановаяДатаОтправленияИзПортаТрансшипмента КАК ПлановаяДатаОтправленияИзПортаТрансшипмента,
	|	ВТКонтактыМенеджера.ИмяМенеджера КАК ИмяМенеджера,
	|	ВТКонтактыМенеджера.ТелефонМенеджера КАК ТелефонМенеджера,
	|	ВТКонтактыМенеджера.АдресЭлПочтыМенеджера КАК АдресЭлПочтыМенеджера
	|ИЗ
	|	ВТБукинг КАК ВТБукинг
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СибурСтатусыБукингов.СрезПоследних(
	|				,
	|				Букинг В
	|					(ВЫБРАТЬ
	|						ВТБукинг.Ссылка КАК Ссылка
	|					ИЗ
	|						ВТБукинг КАК ВТБукинг)) КАК СибурСтатусыБукинговСрезПоследних
	|		ПО ВТБукинг.Ссылка = СибурСтатусыБукинговСрезПоследних.Букинг
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СибурРазмещенныеБукинги КАК СибурРазмещенныеБукинги
	|		ПО ВТБукинг.Ссылка = СибурРазмещенныеБукинги.Букинг
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКонтактыМенеджера КАК ВТКонтактыМенеджера
	|		ПО ВТБукинг.Ссылка = ВТКонтактыМенеджера.Ссылка";
	Запрос.УстановитьПараметр("ИДБукинга", ИДБукинга);	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Ответ = ПолучитьОбъектXDTO("urn:sibur:po:a:LP:Bookings", "BookingNotify");
	
	Если Выборка.Следующий() Тогда
		
		НомерБукинга = Выборка.НомерБукинга;
		ИДБукингаУПеревозчика = Строка(Выборка.Букинг.УникальныйИдентификатор());
		
		Ответ.FB_STATUS = Выборка.СтатусЗаявкиНаБукингКод;
		Ответ.FB_STATUS_DESCR = Выборка.СтатусЗаявкиНаБукингНаименование;
		Ответ.QUANT = Выборка.КоличествоПодтвержденныхКонтейнеров;
		Ответ.CARRIER_ID = Выборка.ЛинияКодСибур;
		Ответ.CARRIER_ID_DESC = Выборка.ЛинияНаименование;
		Ответ.VESSEL_NUM = Выборка.НазваниеСудна;
		Ответ.VOY_NUM = Выборка.НомерРейса;
		Ответ.DEADLINE_BOOK = Выборка.ДедлайнСогласованияБукингаГрузоотправителем;
		Ответ.VESSEL_CUTOFF = Выборка.ДатаЗакрытияСудна;
		Ответ.ETD = Выборка.ДатаОтправленияПоРасписанию;
		Ответ.ETA = Выборка.ДатаПрибытияПоРасписанию;
		
		Ответ.POT = Выборка.ПортТрансшипментаКод;
		Ответ.POT_DESCR = Выборка.ПортТрансшипментаНаименование;
		Ответ.ETA_TR = Выборка.ПлановаяДатаПрибытияВПортТрансшипмента;
		Ответ.ETD_TR = Выборка.ПлановаяДатаОтправленияИзПортаТрансшипмента;
		
		//Контактное лицо перевозчика
		Ответ.EXP_MANAGER_DESCR = Выборка.ИмяМенеджера;
		Ответ.EXP_MANAGER_TEL = Выборка.ТелефонМенеджера;		
		Ответ.EXP_MANAGER_MAIL = Выборка.АдресЭлПочтыМенеджера;
		
	КонецЕсли;
	
	Ответ.TOR_ID = ИДБукинга;
	Ответ.REF_BOOKING_ID = НомерБукинга;
	Ответ.EXT_TOR_ID = ИДБукингаУПеревозчика;
	Ответ.STATUS_DATE = ДатаУведомления;
	
	Возврат Ответ;
	
КонецФункции

//Коносаменты

Функция ЗаписатьИнструкцию(ДанныеЗапроса) Экспорт
	
	//Заглушка
	//Процедура на стадии тестирования. Может выполняться только на тестовых базах.
	Если Не ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДатаПолученияИнструкции = ТекущаяДатаСеанса();
	
	ДанныеИнструкции = Новый Структура;
	ДанныеИнструкции.Вставить("ДатаОтправкиИнструкции", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "INSTR_DATE", Тип("Дата")));
	ДанныеИнструкции.Вставить("ИдентификаторБукинга", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "TOR_ID"));
	ДанныеИнструкции.Вставить("НомерБукинга", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "REF_BOOKING_ID",, "0"));
	ДанныеИнструкции.Вставить("ИдентификаторУПеревозчика", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "EXT_TOR_ID"));
	ДанныеИнструкции.Вставить("НомерКоносамента", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "BL_NUMBER",, "0"));
	ДанныеИнструкции.Вставить("УсловияПоставки", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "DELIVERY_TERM"));
	ДанныеИнструкции.Вставить("СпособВыпуска", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "TYPE_OF_ISSUE"));
	ДанныеИнструкции.Вставить("НаименованиеМестаФормированияКоносамента", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "CREATED_PLACE_DESCR"));
	ДанныеИнструкции.Вставить("КоличествоВыпускаемыхКоносаментов", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "NUMBER_BILL_OF_LADING"));
	ДанныеИнструкции.Вставить("КоличествоКопийКоносаментов", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "COUNT_BL"));
	ДанныеИнструкции.Вставить("ОписаниеМестаОтправления", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "POL_DESCR"));
	ДанныеИнструкции.Вставить("МестоПолученияГруза", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "PLACE_OF_RECEIPT"));
	ДанныеИнструкции.Вставить("ОписаниеМестаНазначения", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "POD_DESCR"));
	ДанныеИнструкции.Вставить("МестоПоставкиГруза", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "PLACE_OF_DELIEVERY"));
	ДанныеИнструкции.Вставить("НаименованиеСудна", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "VESSEL_NUM"));
	ДанныеИнструкции.Вставить("НомерРейса", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "VOY_NUM"));
	ДанныеИнструкции.Вставить("МорскаяЛиния", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "CARRIER_ID"));
	ДанныеИнструкции.Вставить("ОписаниеМорскойЛинии", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "CARRIER_DESCR"));
	ДанныеИнструкции.Вставить("НаименованиеГрузоотправителя", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "SHIPPER_DESCR"));
	ДанныеИнструкции.Вставить("НаименованиеГрузополучателя", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "CONSIGNEE_DESCR"));
	ДанныеИнструкции.Вставить("РегНомерГрузополучателя", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "CONSIGNEE_REG_NUMBER"));
	ДанныеИнструкции.Вставить("ЭлектроннаяПочтаГрузополучателя", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "CONSIGNEE_EMAIL"));
	ДанныеИнструкции.Вставить("ТелефонГрузополучателя", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "CONSIGNEE_TEL"));
	ДанныеИнструкции.Вставить("АдресГрузополучателя", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "CONSIGNEE_ADDRESS"));
	ДанныеИнструкции.Вставить("УведомлениеНаименование", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "NOTIFY_DESCR"));
	ДанныеИнструкции.Вставить("УведомлениеРегистрационныйНомер", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "NOTIFY_REG"));
	ДанныеИнструкции.Вставить("УведомлениеЭлектроннаяПочта", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "NOTIFY_EMAIL"));
	ДанныеИнструкции.Вставить("УведомлениеТелефон", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "NOTIFY_PHONE"));
	ДанныеИнструкции.Вставить("УведомлениеАдрес", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "NOTIFY_ADDRESS"));
	ДанныеИнструкции.Вставить("Комментарий", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "COMMENT"));
	ДанныеИнструкции.Вставить("ПрисоединенныйФайл", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "ADD_FILE"));
	ДанныеИнструкции.Вставить("Описание", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "DESCRIPTION"));
	
	ТаблицаКонтейнеров = ПолучитьТаблицуКонтейнеровКоносамента(ДанныеЗапроса.ITEM);
	
	//Поиск Букинга и Коносамента (транспортного документа)
	Запрос = Новый Запрос;
	//Евросиб Каблов 24.11.2020 ( Ticket#0215031 
	//Запрос.Текст =
	//"ВЫБРАТЬ
	//|	ДокБукинг.Ссылка КАК Букинг,
	//|	ТранспортныйДокумент.Ссылка КАК Коносамент
	//|ИЗ
	//|	Документ.Букинг КАК ДокБукинг
	//|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	//|		ПО ДокБукинг.Ссылка = ТранспортныйДокумент.Букинг
	//|ГДЕ
	//|	ДокБукинг.ИДБукинга = &ИдентификаторБукинга";
	//Запрос.УстановитьПараметр("ИдентификаторБукинга", ДанныеИнструкции.ИдентификаторБукинга);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТранспортныйДокумент.Ссылка КАК Коносамент,
	|	ДокБукинг.Ссылка КАК Букинг
	|ИЗ
	|	Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	|		ПОЛНОЕ СОЕДИНЕНИЕ Документ.Букинг КАК ДокБукинг
	|		ПО ТранспортныйДокумент.НомерБукинга = ДокБукинг.НомерБукинга
	|ГДЕ
	|	ТранспортныйДокумент.НомерБукинга = &НомерБукинга
	|	И ДокБукинг.НомерБукинга = &НомерБукинга";
	Запрос.УстановитьПараметр("НомерБукинга", ДанныеИнструкции.НомерБукинга);
	//Евросиб Каблов 24.11.2020 )
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Букинг = Выборка.Букинг;
		Коносамент = Выборка.Коносамент;		
	Иначе
		Букинг = Неопределено;
		Коносамент = Неопределено;
	КонецЕсли;
	
	//Заполнение коносамента (транспортного документа)
	Если ЗначениеЗаполнено(Коносамент) Тогда
		КоносаментОбъект = Коносамент.ПолучитьОбъект();
	Иначе
		КоносаментОбъект = Документы.ТранспортныйДокумент.СоздатьДокумент();
		КоносаментОбъект.Заполнить(Неопределено);
		КоносаментОбъект.Контрагент = Константы.СибурКонтрагент.Получить();
		КоносаментОбъект.ВидОперации = Перечисления.ВидыОперацийТранспортныхДокументов.Коносамент;
		КоносаментОбъект.Дата = ДанныеИнструкции.ДатаОтправкиИнструкции;
		КоносаментОбъект.НомерТранспортногоДокумента = ДанныеИнструкции.НомерКоносамента;		
	КонецЕсли;
	
	КоносаментОбъект.Коносаменты.Загрузить(ТаблицаКонтейнеров);
	
	Если Не ЗначениеЗаполнено(КоносаментОбъект.НомерБукинга) Тогда
		КоносаментОбъект.НомерБукинга = ДанныеИнструкции.НомерБукинга;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КоносаментОбъект.Букинг) Тогда
		КоносаментОбъект.Букинг = Букинг;	
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(КоносаментОбъект.УсловияПеревозкиПоПортам) Тогда
		Попытка
			УсловияПеревозкиПоПортам = Перечисления.УсловияПеревозкиПоПортам[ДанныеИнструкции.УсловияПоставки];
		Исключение
			УсловияПеревозкиПоПортам = Неопределено;
		КонецПопытки;
		КоносаментОбъект.УсловияПеревозкиПоПортам = УсловияПеревозкиПоПортам;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КоносаментОбъект.СпособВыпуска) Тогда
		КоносаментОбъект.СпособВыпуска = ДанныеИнструкции.СпособВыпуска;
	КонецЕсли;
	
	//Локации
	Локации = Новый Соответствие;
	НаименованияЛокаций = Новый Массив;
	
	Если ЗначениеЗаполнено(ДанныеИнструкции.НаименованиеМестаФормированияКоносамента) Тогда
		НаименованияЛокаций.Добавить(ДанныеИнструкции.НаименованиеМестаФормированияКоносамента);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеИнструкции.ОписаниеМестаОтправления) Тогда
		НаименованияЛокаций.Добавить(ДанныеИнструкции.ОписаниеМестаОтправления);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеИнструкции.ОписаниеМестаНазначения)Тогда
		НаименованияЛокаций.Добавить(ДанныеИнструкции.ОписаниеМестаНазначения);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеИнструкции.МестоПолученияГруза) Тогда
		НаименованияЛокаций.Добавить(ДанныеИнструкции.МестоПолученияГруза);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеИнструкции.МестоПоставкиГруза) Тогда
		НаименованияЛокаций.Добавить(ДанныеИнструкции.МестоПоставкиГруза);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НаименованияЛокаций", НаименованияЛокаций);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Локации.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА Локации.Наименование В (&НаименованияЛокаций)
	|			ТОГДА Локации.Наименование
	|		ИНАЧЕ Локации.НаименованиеАнгл
	|	КОНЕЦ КАК Наименование
	|ИЗ
	|	Справочник.Локации КАК Локации
	|ГДЕ
	|	(Локации.Наименование В (&НаименованияЛокаций)
	|			ИЛИ Локации.НаименованиеАнгл В (&НаименованияЛокаций))";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Локации.Вставить(Выборка.Наименование, Выборка.Ссылка);
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(КоносаментОбъект.МестоФормированияКоносамента) Тогда
		КоносаментОбъект.МестоФормированияКоносамента = Локации.Получить(ДанныеИнструкции.НаименованиеМестаФормированияКоносамента);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КоносаментОбъект.СтанцияОтправления) Тогда
		КоносаментОбъект.СтанцияОтправления = Локации.Получить(ДанныеИнструкции.ОписаниеМестаОтправления);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КоносаментОбъект.СтанцияНазначения) Тогда
		КоносаментОбъект.СтанцияНазначения = Локации.Получить(ДанныеИнструкции.ОписаниеМестаНазначения);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КоносаментОбъект.МестоПолученияГруза) Тогда
		КоносаментОбъект.МестоПолученияГруза = Локации.Получить(ДанныеИнструкции.МестоПолученияГруза);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КоносаментОбъект.МестоПоставкиГруза) Тогда
		КоносаментОбъект.МестоПоставкиГруза = Локации.Получить(ДанныеИнструкции.МестоПоставкиГруза);
	КонецЕсли;
	
	//Поиск Судна
	//Евросиб Каблов 30.01.2021 (
	//Запрос = Новый Запрос;
	//Запрос.Текст =
	//"ВЫБРАТЬ
	//|	ТС.Ссылка КАК Ссылка
	//|ИЗ
	//|	Справочник.ТС КАК ТС
	//|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТипоразмерыТС КАК ТипоразмерыТС
	//|		ПО ТС.ТипТС = ТипоразмерыТС.Ссылка
	//|ГДЕ
	//|	ТС.Наименование = &Наименование
	//|	И ТипоразмерыТС.Судно";
	//Запрос.УстановитьПараметр("Наименование", ДанныеИнструкции.НаименованиеСудна);
	//Выборка = Запрос.Выполнить().Выбрать();
	//Если Выборка.Следующий() Тогда	
	//	КоносаментОбъект.Судно = Выборка.Ссылка;
	//КонецЕсли;
	Судно = ПолучитьСудно(ДанныеИнструкции.НаименованиеСудна);
	КоносаментОбъект.Судно = Судно;	
	//Евросиб Каблов 30.01.2021 )
	
	Если Не ЗначениеЗаполнено(КоносаментОбъект.МорскойРейс) Тогда
		КоносаментОбъект.МорскойРейс = ПолучитьМорскойРейс(ДанныеИнструкции.НомерРейса, Судно);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КоносаментОбъект.МорскаяЛиния) Тогда
		КоносаментОбъект.МорскаяЛиния = Справочники.МорскиеЛинии.НайтиПоРеквизиту("КодСибур", ДанныеИнструкции.МорскаяЛиния);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КоносаментОбъект.Комментарий) Тогда
		КоносаментОбъект.Комментарий = ДанныеИнструкции.Комментарий;
	КонецЕсли;
	
	//Получение статуса коносамента
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СибурСтатусыЗаявок.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СибурСтатусыЗаявок КАК СибурСтатусыЗаявок
	|ГДЕ
	|	СибурСтатусыЗаявок.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокСибура.ЗаявкаКоносамент)
	|	И СибурСтатусыЗаявок.КодСтатуса = ""2""";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СтатусКоносамента = Выборка.Ссылка;
	Иначе
		СтатусКоносамента = Неопределено;
	КонецЕсли;
	КоносаментОбъект.СтатусКоносаментаСибур = СтатусКоносамента;
	
	//Установка дополнительных свойств для изменения Состояния заявки
	УстановитьДопСвойстваСостоянияЗаявки(КоносаментОбъект, СтатусКоносамента, ДанныеИнструкции.ДатаОтправкиИнструкции, ДанныеИнструкции.Комментарий);
	
	//Запись заявки
	КоносаментОбъект.Записать();
	Коносамент = КоносаментОбъект.Ссылка;
	ДанныеИнструкции.Вставить("ИдентификаторУПеревозчика", Строка(Коносамент.УникальныйИдентификатор()));
	
	//Уведомление ответственного по e-mail об изменении заявки
	ОтборУведомлений = Новый Структура;
	ОтборУведомлений.Вставить("Документ", Коносамент);
	ОтборУведомлений.Вставить("Состояние", Справочники.Состояния.ПроверкаИКонтрольИзмененийДокумента);	
	Пользователи_sd_сервер.УведомитьПользователяОЕгоЗадачах(ОтборУведомлений);
	
	//Запись в регистр Размещенные коносаменты
	ЗаписьКоносамента = РегистрыСведений.СибурРазмещенныеКоносаменты.СоздатьМенеджерЗаписи();
	ЗаписьКоносамента.ТранспортныйДокумент = Коносамент;
	ЗаполнитьЗначенияСвойств(ЗаписьКоносамента, ДанныеИнструкции);
	ЗаписьКоносамента.Записать();
	
	Если ЗначениеЗаполнено(ДанныеИнструкции.ПрисоединенныйФайл) Тогда
		
		ДвоичныеДанныеФайла = Base64Значение(ДанныеИнструкции.ПрисоединенныйФайл);
		АдресХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла);
		
		ПараметрыФайла = Новый Структура;
		ПараметрыФайла.Вставить("Автор", ПользователиКлиентСервер.ТекущийПользователь());
		ПараметрыФайла.Вставить("ВладелецФайлов", Коносамент);
		ПараметрыФайла.Вставить("ИмяБезРасширения", "Инструкция");
		ПараметрыФайла.Вставить("РасширениеБезТочки", "pdf");
		ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное", Неопределено);
		Файл = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресХранилища);
		
		УдалитьИзВременногоХранилища(АдресХранилища);
		
		КоносаментОбъект.ФайлИнструкции = Файл;
		КоносаментОбъект.Записать();
		
	КонецЕсли;
	
	ЗаписьСтатуса = РегистрыСведений.СибурСтатусыКоносаментов.СоздатьМенеджерЗаписи();
	ЗаписьСтатуса.ТранспортныйДокумент = Коносамент;
	ЗаписьСтатуса.Период = ДанныеИнструкции.ДатаОтправкиИнструкции;
	ЗаписьСтатуса.СтатусЗаявки = СтатусКоносамента;
	ЗаписьСтатуса.Комментарий = ДанныеИнструкции.Комментарий;
	ЗаписьСтатуса.Записать();
	
	Ответ = ПолучитьОбъектXDTO("urn:sibur:po:a:LP:BillOfLading", "BLInstruction");
	Ответ.TOR_ID = ДанныеИнструкции.ИдентификаторБукинга;
	Ответ.REF_BOOKING_ID = ДанныеИнструкции.НомерБукинга;
	Ответ.EXT_TOR_ID = ДанныеИнструкции.ИдентификаторУПеревозчика;
	Ответ.REC_DATE = ДатаПолученияИнструкции;
		
	Возврат Ответ;
	
КонецФункции

Функция ДрафтКоносамента(ДанныеЗапроса) Экспорт
	
	//Заглушка
	//Процедура на стадии тестирования. Может выполняться только на тестовых базах.
	Если Не ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДанныеЗапросаДрафта =  Новый Структура;
	ДанныеЗапросаДрафта.Вставить("ИдентификаторБукинга", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "TOR_ID"));
	ДанныеЗапросаДрафта.Вставить("НомерБукинга", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "REF_BOOKING_ID",, "0"));
	ДанныеЗапросаДрафта.Вставить("ИдентификаторУПеревозчика", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "EXT_TOR_ID"));
	ДанныеЗапросаДрафта.Вставить("НомерКоносамента", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеЗапроса, "BL_NUMBER",, "0"));
	
	ВидИнфообмена = "Драфт коносамента";
	НовыйСтатус = Неопределено;
	
	СвойстваОбъекта = ДанныеЗапроса.Свойства();
	Если СвойстваОбъекта.Получить("STATUS_BLOCK") <> Неопределено Тогда
		БлокСтатуса = ДанныеЗапроса.STATUS_BLOCK;
		ДанныеЗапросаДрафта.Вставить("КодСтатуса", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(БлокСтатуса, "BL_STATUS",, ""));
		ДанныеЗапросаДрафта.Вставить("ОписаниеСтатуса", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(БлокСтатуса, "BL_STATUS_D",, ""));
		Если ДанныеЗапросаДрафта.КодСтатуса = "6" Тогда
			ВидИнфообмена = "Запрос оригинала";
		КонецЕсли;
	КонецЕсли;
	
	СвойстваОбъекта = ДанныеЗапроса.Свойства();
	Если СвойстваОбъекта.Получить("COMMENT_BLOCK") <> Неопределено Тогда
		БлокКомментария = ДанныеЗапроса.COMMENT_BLOCK;
		ДанныеЗапросаДрафта.Вставить("Комментарий", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(БлокКомментария, "COMMENT"));
		ВидИнфообмена = "Комментарии к драфту";
		НовыйСтатус = ПолучитьСтатусЗаявки(Перечисления.ВидыЗаявокСибура.ЗаявкаКоносамент, "4"); // 4 - Комментарий к драфту
	КонецЕсли;
	
	СвойстваОбъекта = ДанныеЗапроса.Свойства();
	Если СвойстваОбъекта.Получить("DATE_BLOCK") <> Неопределено Тогда
		БлокПодтвержденияДрафта = ДанныеЗапроса.DATE_BLOCK;
		ДанныеЗапросаДрафта.Вставить("ДатаСогласования", ПолучитьЗначениеПоляОбъектаXDTOПоИмени(БлокПодтвержденияДрафта, "DATE_DRAFT"));
		ВидИнфообмена = "Подтверждение драфта";
		НовыйСтатус = ПолучитьСтатусЗаявки(Перечисления.ВидыЗаявокСибура.ЗаявкаКоносамент, "5"); // 5 - Драфт подтвержден
	КонецЕсли;
	
	//Получение данных Букинга и Коносамента (транспортного документа)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДокБукинг.Ссылка КАК Букинг,
	|	ДокБукинг.НомерБукинга КАК НомерБукинга,
	|	ДокБукинг.ИДБукинга КАК ИДБукинга,
	|	ДокТранспортныйДокумент.Ссылка КАК Коносамент,
	|	ДокТранспортныйДокумент.НомерТранспортногоДокумента КАК НомерТранспортногоДокумента,
	|	ДокТранспортныйДокумент.ДатаОтправкиДрафтаКоносамента КАК ДатаОтправкиДрафтаКоносамента,
	|	ДокТранспортныйДокумент.Комментарий КАК Комментарий,
	|	ДокТранспортныйДокумент.Автор КАК Автор,
	|	ДокТранспортныйДокумент.ФайлОригинала КАК ФайлОригинала,
	|	ДокТранспортныйДокумент.ФайлДрафта КАК ФайлДрафта,
	|	СибурРазмещенныеКоносаменты.ОтветственныйМенеджер КАК Менеджер,
	|	СибурРазмещенныеКоносаменты.ОтветственныйМенеджер.Наименование КАК ИмяМенеджера
	|ПОМЕСТИТЬ ВТКоносамент
	|ИЗ
	|	Документ.Букинг КАК ДокБукинг
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент КАК ДокТранспортныйДокумент
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СибурРазмещенныеКоносаменты КАК СибурРазмещенныеКоносаменты
	|			ПО ДокТранспортныйДокумент.Ссылка = СибурРазмещенныеКоносаменты.ТранспортныйДокумент
	|		ПО (ДокБукинг.Ссылка = СибурРазмещенныеКоносаменты.ТранспортныйДокумент.Букинг)
	|ГДЕ
	|	ДокБукинг.ИДБукинга = &ИдентификаторБукинга
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТКоносамент.Букинг КАК Букинг,
	|	ВТКоносамент.НомерБукинга КАК НомерБукинга,
	|	ВТКоносамент.ИДБукинга КАК ИДБукинга,
	|	ВТКоносамент.Коносамент КАК Коносамент,
	|	ВТКоносамент.НомерТранспортногоДокумента КАК НомерТранспортногоДокумента,
	|	ВТКоносамент.ДатаОтправкиДрафтаКоносамента КАК ДатаОтправкиДрафтаКоносамента,
	|	ВТКоносамент.Комментарий КАК Комментарий,
	|	СибурСтатусыКоносаментовСрезПоследних.СтатусЗаявки КАК СтатусЗаявки,
	|	СибурСтатусыКоносаментовСрезПоследних.СтатусЗаявки.КодСтатуса КАК СтатусЗаявкиКод,
	|	СибурСтатусыКоносаментовСрезПоследних.СтатусЗаявки.Наименование КАК СтатусЗаявкиНаименование,
	|	СибурСтатусыКоносаментовСрезПоследних.Комментарий КАК КомментарийКСтатусу,
	|	ВТКоносамент.ИмяМенеджера КАК ИмяМенеджера,
	|	ЕСТЬNULL(КонтактнаяИнформацияТелефон.Представление, """") КАК ТелефонМенеджера,
	|	ЕСТЬNULL(КонтактнаяИнформацияАдресЭлПочты.Представление, """") КАК АдресЭлПочтыМенеджера,
	|	ВТКоносамент.ФайлОригинала КАК ФайлОригинала,
	|	ВТКоносамент.ФайлДрафта КАК ФайлДрафта
	|ИЗ
	|	ВТКоносамент КАК ВТКоносамент
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СибурСтатусыКоносаментов.СрезПоследних(
	|				,
	|				ТранспортныйДокумент В
	|					(ВЫБРАТЬ
	|						ВТКоносамент.Коносамент КАК Коносамент
	|					ИЗ
	|						ВТКоносамент КАК ВТКоносамент)) КАК СибурСтатусыКоносаментовСрезПоследних
	|		ПО ВТКоносамент.Коносамент = СибурСтатусыКоносаментовСрезПоследних.ТранспортныйДокумент
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи.КонтактнаяИнформация КАК КонтактнаяИнформацияТелефон
	|		ПО ВТКоносамент.Менеджер = КонтактнаяИнформацияТелефон.Ссылка
	|			И (КонтактнаяИнформацияТелефон.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонПользователя))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи.КонтактнаяИнформация КАК КонтактнаяИнформацияАдресЭлПочты
	|		ПО ВТКоносамент.Менеджер = КонтактнаяИнформацияАдресЭлПочты.Ссылка
	|			И (КонтактнаяИнформацияАдресЭлПочты.Ссылка = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailПользователя))";
	Запрос.УстановитьПараметр("ИдентификаторБукинга", ДанныеЗапросаДрафта.ИдентификаторБукинга);	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Ответ = ПолучитьОбъектXDTO("urn:sibur:po:a:LP:BillOfLading", "BillOfLading");		
	
	Если Выборка.Следующий() Тогда
		
		Коносамент = Выборка.Коносамент;
		
		Ответ.TOR_ID = Выборка.ИДБукинга;
		Ответ.REF_BOOKING_ID = Выборка.НомерБукинга;
		Ответ.EXT_TOR_ID = Строка(Коносамент.УникальныйИдентификатор());
		Ответ.BL_NUMBER = Выборка.НомерТранспортногоДокумента;
		
		БлокДрафта = ПолучитьОбъектXDTO("urn:sibur:po:a:LP:BillOfLading", "DRAFT_BLOCK");
		БлокДрафта.BL_STATUS = Выборка.СтатусЗаявкиКод;
		БлокДрафта.BL_STATUS_D = Выборка.СтатусЗаявкиНаименование;		
		
		БлокКомментария = ПолучитьОбъектXDTO("urn:sibur:po:a:LP:BillOfLading", "COMMENT_BLOCK");
		БлокДатыПодтверждения = ПолучитьОбъектXDTO("urn:sibur:po:a:LP:BillOfLading", "DATE_BLOCK");
		
		//Запись в регистр Размещенные коносаменты
		ЗаписьКоносамента = РегистрыСведений.СибурРазмещенныеКоносаменты.СоздатьМенеджерЗаписи();
		ЗаписьКоносамента.ТранспортныйДокумент = Коносамент;
		ЗаписьКоносамента.Прочитать();
		Если Не ЗаписьКоносамента.Выбран() Тогда
			ЗаписьКоносамента.ТранспортныйДокумент = Коносамент;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ЗаписьКоносамента, ДанныеЗапросаДрафта);
		ЗаписьКоносамента.Записать();
		
		Если ЗначениеЗаполнено(НовыйСтатус) Тогда
			
			КоносаментОбъект = Коносамент.ПолучитьОбъект();
			КоносаментОбъект.СтатусКоносаментаСибур = НовыйСтатус;
			
			//Установка дополнительных свойств для изменения Состояния заявки
			Комментарий = Неопределено;
			Если Не ДанныеЗапросаДрафта.Свойство("Комментарий", Комментарий) Тогда
				Комментарий = "";
			КонецЕсли;
			
			УстановитьДопСвойстваСостоянияЗаявки(КоносаментОбъект, НовыйСтатус, ТекущаяДатаСеанса(), Комментарий);
			
			//Запись заявки
			КоносаментОбъект.Записать();
						
			//Уведомление ответственного по e-mail об изменении заявки
			ОтборУведомлений = Новый Структура;
			ОтборУведомлений.Вставить("Документ", Коносамент);
			ОтборУведомлений.Вставить("Состояние", Справочники.Состояния.ПроверкаИКонтрольИзмененийДокумента);	
			Пользователи_sd_сервер.УведомитьПользователяОЕгоЗадачах(ОтборУведомлений)
			
		КонецЕсли;
		
		Если ВидИнфообмена = "Драфт коносамента" Тогда
			
			БлокДрафта.CREATED_ON_DRAFT = Выборка.ДатаОтправкиДрафтаКоносамента;
			//Файл
			ДополнительныеПараметры = Новый Структура("ВызыватьИсключение, ПолучатьСсылкуНаДвоичныеДанные", Ложь, Истина);			
			ДанныеФайла = РаботаСФайлами.ДанныеФайла(Выборка.ФайлДрафта, ДополнительныеПараметры);
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
			УдалитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
			БлокДрафта.PDF_CONTENT = Base64Строка(ДвоичныеДанные);			
			Ответ.DRAFT_BLOCK = БлокДрафта;
			
			БлокКомментария.COMMENT = Выборка.КомментарийКСтатусу;			
			БлокКомментария.EXP_MANAGER_DESCR = Выборка.ИмяМенеджера;
			БлокКомментария.EXP_MANAGER_TEL = Выборка.ТелефонМенеджера;
			БлокКомментария.EXP_MANAGER_MAIL = Выборка.АдресЭлПочтыМенеджера;			
			Ответ.COMMENT_BLOCK = БлокКомментария;
			
		ИначеЕсли ВидИнфообмена = "Комментарии к драфту" Тогда
			
			БлокДрафта.CREATED_ON_DRAFT = Выборка.ДатаОтправкиДрафтаКоносамента;
			//Файл
			ДополнительныеПараметры = Новый Структура("ВызыватьИсключение, ПолучатьСсылкуНаДвоичныеДанные", Ложь, Истина);			
			ДанныеФайла = РаботаСФайлами.ДанныеФайла(Выборка.ФайлДрафта, ДополнительныеПараметры);
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
			УдалитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
			БлокДрафта.PDF_CONTENT = Base64Строка(ДвоичныеДанные);			
			Ответ.DRAFT_BLOCK = БлокДрафта;
			
			БлокКомментария.COMMENT = Выборка.КомментарийКСтатусу;	
			Ответ.COMMENT_BLOCK = БлокКомментария;
			
		ИначеЕсли ВидИнфообмена = "Подтверждение драфта" Тогда
			
			//БлокДатыПодтверждения.REC_DATE = ?;
			
		ИначеЕсли ВидИнфообмена = "Запрос оригинала" Тогда
			
			//Файл
			ДополнительныеПараметры = Новый Структура("ВызыватьИсключение, ПолучатьСсылкуНаДвоичныеДанные", Ложь, Истина);			
			ДанныеФайла = РаботаСФайлами.ДанныеФайла(Выборка.ФайлОригинала, ДополнительныеПараметры);
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
			УдалитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
			БлокДрафта.PDF_CONTENT = Base64Строка(ДвоичныеДанные);			
			Ответ.DRAFT_BLOCK = БлокДрафта;
			//Комментарий
			БлокКомментария.COMMENT = Выборка.КомментарийКСтатусу;	
			Ответ.COMMENT_BLOCK = БлокКомментария;
			
			//CREATED_ON_ORIG???
			//STATUS_PROC???
			//STATUS_PROC_DESC???
			
		КонецЕсли;
		
	Иначе		
		Ответ.TOR_ID = ДанныеЗапросаДрафта.ИдентификаторБукинга;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

Функция ПолучитьТаблицуКонтейнеровКоносамента(ДанныеПоКонтейнерам)
	
	ТаблицаКонтейнеров = Новый ТаблицаЗначений;
	ТаблицаКонтейнеров.Колонки.Добавить("НомерКонтейнера", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(11)));
	ТаблицаКонтейнеров.Колонки.Добавить("ТипКонтейнера", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(4)));
	ТаблицаКонтейнеров.Колонки.Добавить("ТипКТК", Новый ОписаниеТипов("СправочникСсылка.ТипоразмерыТЕ"));
	ТаблицаКонтейнеров.Колонки.Добавить("НомерКТК", Новый ОписаниеТипов("СправочникСсылка.ТЕ"));
	ТаблицаКонтейнеров.Колонки.Добавить("ТипУпаковки", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(20)));
	ТаблицаКонтейнеров.Колонки.Добавить("КоличествоЕдиницУпаковки", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15, 3)));
	ТаблицаКонтейнеров.Колонки.Добавить("ВесБрутто", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15, 3)));
	ТаблицаКонтейнеров.Колонки.Добавить("КодЕдиницыИзмеренияВесаБрутто", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(3)));
	ТаблицаКонтейнеров.Колонки.Добавить("ЕдиницаИзмеренияВесаБрутто", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ТаблицаКонтейнеров.Колонки.Добавить("ВесНетто", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15, 3)));
	ТаблицаКонтейнеров.Колонки.Добавить("КодЕдиницыИзмеренияВесаНетто", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(3)));
	ТаблицаКонтейнеров.Колонки.Добавить("ЕдиницаИзмеренияВесаНетто", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ТаблицаКонтейнеров.Колонки.Добавить("Объем", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15, 3)));
	ТаблицаКонтейнеров.Колонки.Добавить("КодЕдиницыИзмеренияОбъема", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(3)));
	ТаблицаКонтейнеров.Колонки.Добавить("ЕдиницаИзмеренияОбъема", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ТаблицаКонтейнеров.Колонки.Добавить("НомерПломбы", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(60)));
	
	Если ДанныеПоКонтейнерам.Свойства().Получить("BLInstructionItem") <> Неопределено Тогда 
		СписокКонтейнеров = ДанныеПоКонтейнерам.BLInstructionItem;
	Иначе
		СписокКонтейнеров = Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(СписокКонтейнеров) = Тип("ОбъектXDTO") Тогда
		Контейнеры = Новый Массив;
		Контейнеры.Добавить(СписокКонтейнеров);
	ИначеЕсли ТипЗнч(СписокКонтейнеров) = Тип("СписокXDTO") Тогда
		Контейнеры = СписокКонтейнеров;
	Иначе
		Возврат ТаблицаКонтейнеров;
	КонецЕсли;
	
	Для Каждого ДанныеПоКонтейнеру Из Контейнеры Цикл
		НоваяСтрока = ТаблицаКонтейнеров.Добавить();
		НоваяСтрока.НомерКонтейнера = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоКонтейнеру, "CONTAINER_ID");
		НоваяСтрока.ТипКонтейнера = ПолучитьТипКонтейнераСтрокойПоКодуСибур(ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоКонтейнеру, "CONTAINER_MOT"));
		НоваяСтрока.ТипУпаковки = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоКонтейнеру, "PACKAGE");
		НоваяСтрока.КоличествоЕдиницУпаковки = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоКонтейнеру, "PACKAGE_COUNT", Тип("Число"), 0);
		НоваяСтрока.ВесБрутто = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоКонтейнеру, "VGM_GRO_WEI_VAL", Тип("Число"), 0);		
		НоваяСтрока.КодЕдиницыИзмеренияВесаБрутто = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоКонтейнеру, "VGM_GRO_WEI_UNI");
		НоваяСтрока.ВесНетто = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоКонтейнеру, "NET_WEIGHT", Тип("Число"), 0);		
		НоваяСтрока.КодЕдиницыИзмеренияВесаНетто = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоКонтейнеру, "NET_WEIGHT_UOM");
		НоваяСтрока.Объем = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоКонтейнеру, "MEASURMENT", Тип("Число"), 0);		
		НоваяСтрока.КодЕдиницыИзмеренияОбъема = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоКонтейнеру, "MEASURMENT_OUM");		
		НоваяСтрока.НомерПломбы = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ДанныеПоКонтейнеру, "SEAL_NUM");
	КонецЦикла;	
	
	//Поиск контейнеров по номерам
	КонтейнерыПоНомерам = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТЕ.Ссылка КАК Ссылка,
	|	ТЕ.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ТЕ КАК ТЕ
	|ГДЕ
	|	ТЕ.Наименование В(&НомераКонтейнеров)";
	Запрос.УстановитьПараметр("НомераКонтейнеров", ТаблицаКонтейнеров.ВыгрузитьКолонку("НомерКонтейнера"));
	Выборка = Запрос.Выполнить().Выбрать();	
	Пока Выборка.Следующий() Цикл
		КонтейнерыПоНомерам.Вставить(Выборка.Наименование, Выборка.Ссылка);
	КонецЦикла;
	
	//Поиск типоразмеров контейнеров
	ТипоразмерыПоКодам = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТипоразмерыТЕ.Ссылка КАК Ссылка,
	|	ТипоразмерыТЕ.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ТипоразмерыТЕ КАК ТипоразмерыТЕ
	|ГДЕ
	|	ТипоразмерыТЕ.Наименование В(&ТипыКонтейнеров)";
	Запрос.УстановитьПараметр("ТипыКонтейнеров", ТаблицаКонтейнеров.ВыгрузитьКолонку("ТипКонтейнера"));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТипоразмерыПоКодам.Вставить(Выборка.Наименование, Выборка.Ссылка);
	КонецЦикла;	
	
	//Поиск единиц измерения
	ЕдиницыИзмеренияПоКодам = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КлассификаторЕдиницИзмерения.Ссылка КАК Ссылка,
	|	КлассификаторЕдиницИзмерения.Наименование КАК Наименование
	|ИЗ
	|	Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
	|ГДЕ
	|	КлассификаторЕдиницИзмерения.Наименование В(&КодыЕдиницИзмерения)";
	КодыЕдиницИзмерения = ТаблицаКонтейнеров.ВыгрузитьКолонку("КодЕдиницыИзмеренияВесаБрутто");
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(КодыЕдиницИзмерения, ТаблицаКонтейнеров.ВыгрузитьКолонку("КодЕдиницыИзмеренияВесаНетто"), Истина);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(КодыЕдиницИзмерения, ТаблицаКонтейнеров.ВыгрузитьКолонку("КодЕдиницыИзмеренияОбъема"), Истина);
	Запрос.УстановитьПараметр("КодыЕдиницИзмерения", КодыЕдиницИзмерения);
	Выборка = Запрос.Выполнить().Выбрать();	
	Пока Выборка.Следующий() Цикл
		ЕдиницыИзмеренияПоКодам.Вставить(Выборка.Наименование, Выборка.Ссылка);
	КонецЦикла;
	
	//Заполнение таблицы найденными ссылками
	Для Каждого СтрокаТаблицы Из ТаблицаКонтейнеров Цикл
		
		СтрокаТаблицы.ТипКТК = ТипоразмерыПоКодам.Получить(СтрокаТаблицы.ТипКонтейнера);		
		
		СтрокаТаблицы.НомерКТК = КонтейнерыПоНомерам.Получить(СтрокаТаблицы.НомерКонтейнера);
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.НомерКТК) И СтрДлина(СтрокаТаблицы.НомерКонтейнера) = 11 Тогда
			//НовыйКонтейнер = Справочники.ТЕ.СоздатьЭлемент();
			//НовыйКонтейнер.Наименование = СтрокаТаблицы.НомерКонтейнера;
			//НовыйКонтейнер.Префикс = Сред(СтрокаТаблицы.НомерКонтейнера, 1, 4);
			//НовыйКонтейнер.Номер = Сред(СтрокаТаблицы.НомерКонтейнера, 5, 6);
			//НовыйКонтейнер.КонтрольноеЧисло = Сред(СтрокаТаблицы.НомерКонтейнера, 11, 1);
			//НовыйКонтейнер.ТипТЕ = СтрокаТаблицы.ТипКТК;
			//НовыйКонтейнер.Записать();
			
			НомерКТК = СтрокаТаблицы.НомерКонтейнера;
			ТипТЕ = СтрокаТаблицы.ТипКТК;
			Контейнер = РаботаСКонтейнерамиСервер.СоздатьКТК(НомерКТК, ТипТЕ);
			СтрокаТаблицы.НомерКТК = Контейнер;
		КонецЕсли;
		
		СтрокаТаблицы.ЕдиницаИзмеренияВесаБрутто = ЕдиницыИзмеренияПоКодам.Получить(СтрокаТаблицы.КодЕдиницыИзмеренияВесаБрутто);
		СтрокаТаблицы.ЕдиницаИзмеренияВесаНетто = ЕдиницыИзмеренияПоКодам.Получить(СтрокаТаблицы.КодЕдиницыИзмеренияВесаНетто);
		СтрокаТаблицы.ЕдиницаИзмеренияОбъема = ЕдиницыИзмеренияПоКодам.Получить(СтрокаТаблицы.КодЕдиницыИзмеренияОбъема);
		
	КонецЦикла;
	
	Возврат ТаблицаКонтейнеров;
	
КонецФункции

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьДопСвойстваСостоянияЗаявки(ДокОбъект, СтатусЗаявки, ДатаРазмещенияЗаявки, Комментарий = "")
	
	ИзмененияЗаявки = Новый Структура;
	ИзмененияЗаявки.Вставить("Статус", СтатусЗаявки);
	ИзмененияЗаявки.Вставить("ДатаСтатуса", ДатаРазмещенияЗаявки);
	Если ЗначениеЗаполнено(Комментарий) Тогда
		КомментарийДляСтатуса = СтрШаблон("СИБУР установил статус заявки: %1. Комментарий СИБУР: %2", СтатусЗаявки, Комментарий);
	Иначе
		КомментарийДляСтатуса = СтрШаблон("СИБУР установил статус заявки: %1", СтатусЗаявки);
	КонецЕсли;
	ИзмененияЗаявки.Вставить("Комментарий", КомментарийДляСтатуса);
	ДокОбъект.ДополнительныеСвойства.Вставить("СибурИзмененияЗаявки", ИзмененияЗаявки);
	
КонецПроцедуры

Функция ПолучитьМорскойРейс(НомерРейса, Судно, Линия = Неопределено)
	
	Рейс = Неопределено;	
	Если ЗначениеЗаполнено(НомерРейса) Тогда
		
		Запрос = Новый Запрос;
		
		Если ЗначениеЗаполнено(Судно) Тогда
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	РейсыМоре.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.РейсыМоре КАК РейсыМоре
			|ГДЕ
			|	РейсыМоре.НомерРейса = &НомерРейса
			|	И РейсыМоре.Судно = &Судно";	
			Запрос.УстановитьПараметр("Судно", Судно);
		Иначе
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	РейсыМоре.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.РейсыМоре КАК РейсыМоре
			|ГДЕ
			|	РейсыМоре.НомерРейса = &НомерРейса";
		КонецЕсли;
		
		Запрос.УстановитьПараметр("НомерРейса", НомерРейса);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Рейс = Выборка.Ссылка;
		Иначе
			
			РейсОбъект = Справочники.РейсыМоре.СоздатьЭлемент();
			РейсОбъект.НомерРейса = НомерРейса;
			РейсОбъект.Судно = Судно;
			РейсОбъект.Линия = Линия;
			НазваниеСудна = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Судно, "Наименование");
			РейсОбъект.Наименование = СтрШаблон("%1 %2", НазваниеСудна, НомерРейса); 
			РейсОбъект.Записать();
			
			Рейс = РейсОбъект.Ссылка;
		
		КонецЕсли;
	КонецЕсли;
	
	Возврат Рейс;
	
КонецФункции

Функция ПолучитьСудно(НазваниеСудна)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ТС.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ТС КАК ТС
	|ГДЕ
	|	ТС.ТипТС.Судно
	|	И ТС.Наименование = &НазваниеСудна";
	Запрос.УстановитьПараметр("НазваниеСудна", НазваниеСудна);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
	    Судно = Выборка.Ссылка;
	Иначе
		СудноОбъект = Справочники.ТС.СоздатьЭлемент();
		СудноОбъект.Наименование = НазваниеСудна;
		СудноОбъект.ТипТС = Справочники.ТипоразмерыТС.НайтиПоРеквизиту("Судно", Истина);;
		СудноОбъект.Записать();
		Судно = СудноОбъект.Ссылка;
	КонецЕсли;
	
	Возврат Судно;
	
КонецФункции

Функция ПолучитьСтатусЗаявки(ВидЗаявки, КодСтатуса) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СибурСтатусыЗаявок.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СибурСтатусыЗаявок КАК СибурСтатусыЗаявок
	|ГДЕ
	|	СибурСтатусыЗаявок.ВидЗаявки = &ВидЗаявки
	|	И СибурСтатусыЗаявок.КодСтатуса = &КодСтатуса";
	Запрос.УстановитьПараметр("ВидЗаявки", ВидЗаявки);
	Запрос.УстановитьПараметр("КодСтатуса", КодСтатуса);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		СтатусЗаявки = Выборка.Ссылка;
	Иначе
		СтатусЗаявки = Справочники.СибурСтатусыЗаявок.ПустаяСсылка();
	КонецЕсли;
	
	Возврат СтатусЗаявки;
	
КонецФункции

Функция ПолучитьТаблицуКонтейнеровБукинга(ДанныеПоКонтейнерам)
	
	ТаблицаКонтейнеров = Новый ТаблицаЗначений;
	ТаблицаКонтейнеров.Колонки.Добавить("НомерКонтейнера", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(11)));
	ТаблицаКонтейнеров.Колонки.Добавить("ТипКонтейнера", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(4)));
	ТаблицаКонтейнеров.Колонки.Добавить("НаименованиеСобственника", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(255)));
	ТаблицаКонтейнеров.Колонки.Добавить("НаименованиеГруза", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(255)));
	ТаблицаКонтейнеров.Колонки.Добавить("КодГрузаТНВЭД", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(20)));
	ТаблицаКонтейнеров.Колонки.Добавить("ПодтверждённыйВесБрутто", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15, 3)));
	ТаблицаКонтейнеров.Колонки.Добавить("КодЕдиницыИзмерения", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(3)));
	
	Если ДанныеПоКонтейнерам.Свойства().Получить("BookingItem") <> Неопределено Тогда 
		СписокКонтейнеров = ДанныеПоКонтейнерам.BookingItem;
	Иначе
		СписокКонтейнеров = Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(СписокКонтейнеров) = Тип("ОбъектXDTO") Тогда
		Контейнеры = Новый Массив;
		Контейнеры.Добавить(СписокКонтейнеров);
	ИначеЕсли ТипЗнч(СписокКонтейнеров) = Тип("СписокXDTO") Тогда
		Контейнеры = СписокКонтейнеров;
	Иначе
		Возврат ТаблицаКонтейнеров;
	КонецЕсли;
	
	Для Каждого ДанныеПоКонтейнеру Из Контейнеры Цикл
		НоваяСтрока = ТаблицаКонтейнеров.Добавить();
		НоваяСтрока.НомерКонтейнера = ПолучитьЗначениеПоляОбъектаXDTO(ДанныеПоКонтейнеру.CONTAINER_ID);
		НоваяСтрока.ТипКонтейнера = ПолучитьТипКонтейнераСтрокойПоКодуСибур(ПолучитьЗначениеПоляОбъектаXDTO(ДанныеПоКонтейнеру.CONTAINER_MOT));
		НоваяСтрока.НаименованиеСобственника = ПолучитьЗначениеПоляОбъектаXDTO(ДанныеПоКонтейнеру.CONTAINER_OWNER_DESCR);
		НоваяСтрока.НаименованиеГруза = ПолучитьЗначениеПоляОбъектаXDTO(ДанныеПоКонтейнеру.CARGO_DESC);
		НоваяСтрока.КодГрузаТНВЭД = ПолучитьЗначениеПоляОбъектаXDTO(ДанныеПоКонтейнеру.HS_CODE);		
		НоваяСтрока.ПодтверждённыйВесБрутто = ПолучитьЗначениеПоляОбъектаXDTO(ДанныеПоКонтейнеру.VGM_GRO_WEI_VAL);
		НоваяСтрока.КодЕдиницыИзмерения = ПолучитьЗначениеПоляОбъектаXDTO(ДанныеПоКонтейнеру.VGM_GRO_WEI_UNI);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаКонтейнеров.НомерКонтейнера КАК НомерКонтейнера,
	|	ТаблицаКонтейнеров.ТипКонтейнера КАК ТипКонтейнера,
	|	ТаблицаКонтейнеров.НаименованиеСобственника КАК НаименованиеСобственника,
	|	ТаблицаКонтейнеров.НаименованиеГруза КАК НаименованиеГруза,
	|	ТаблицаКонтейнеров.КодГрузаТНВЭД КАК КодГрузаТНВЭД,
	|	ТаблицаКонтейнеров.ПодтверждённыйВесБрутто КАК ПодтверждённыйВесБрутто,
	|	ТаблицаКонтейнеров.КодЕдиницыИзмерения КАК КодЕдиницыИзмерения
	|ПОМЕСТИТЬ ВТКонтейнеры
	|ИЗ
	|	&ТаблицаКонтейнеров КАК ТаблицаКонтейнеров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТКонтейнеры.НомерКонтейнера КАК НомерКонтейнера,
	|	ВТКонтейнеры.ТипКонтейнера КАК ТипКонтейнера,
	|	ВТКонтейнеры.НаименованиеСобственника КАК НаименованиеСобственника,
	|	ВТКонтейнеры.НаименованиеГруза КАК НаименованиеГруза,
	|	ВТКонтейнеры.КодГрузаТНВЭД КАК КодГрузаТНВЭД,
	|	ВТКонтейнеры.ПодтверждённыйВесБрутто КАК ПодтверждённыйВесБрутто,
	|	ВТКонтейнеры.КодЕдиницыИзмерения КАК КодЕдиницыИзмерения,
	|	ТЕ.Ссылка КАК Контейнер,
	|	КлассификаторЕдиницИзмерения.Ссылка КАК ЕдиницаИзмерения,
	|	Грузы.Ссылка КАК Груз,
	|	Грузы.ТНВЭД КАК КодНайденногоГрузаТНВЭД,
	|	ТипоразмерыТЕ.Ссылка КАК ТипТЕ
	|ИЗ
	|	ВТКонтейнеры КАК ВТКонтейнеры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТЕ КАК ТЕ
	|		ПО ВТКонтейнеры.НомерКонтейнера = ТЕ.Наименование
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
	|		ПО ВТКонтейнеры.КодЕдиницыИзмерения = КлассификаторЕдиницИзмерения.Наименование
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Грузы КАК Грузы
	|		ПО (ВЫБОР
	|				КОГДА ВТКонтейнеры.НаименованиеГруза = Грузы.Наименование
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ВТКонтейнеры.КодГрузаТНВЭД <> """" И ВТКонтейнеры.КодГрузаТНВЭД = Грузы.ТНВЭД
	|			КОНЕЦ)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТипоразмерыТЕ КАК ТипоразмерыТЕ
	|		ПО ВТКонтейнеры.ТипКонтейнера = ТипоразмерыТЕ.Наименование";
	Запрос.УстановитьПараметр("ТаблицаКонтейнеров", ТаблицаКонтейнеров);
	ТаблицаКонтейнеров = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТаблицы Из ТаблицаКонтейнеров Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Контейнер) И СтрДлина(СтрокаТаблицы.НомерКонтейнера) = 11 Тогда
			//НовыйКонтейнер = Справочники.ТЕ.СоздатьЭлемент();
			//НовыйКонтейнер.Наименование = СтрокаТаблицы.НомерКонтейнера;
			//НовыйКонтейнер.Префикс = Сред(СтрокаТаблицы.НомерКонтейнера, 1, 4);
			//НовыйКонтейнер.Номер = Сред(СтрокаТаблицы.НомерКонтейнера, 5, 6);
			//НовыйКонтейнер.КонтрольноеЧисло = Сред(СтрокаТаблицы.НомерКонтейнера, 11, 1);
			//НовыйКонтейнер.ТипТЕ = СтрокаТаблицы.ТипТЕ;
			//НовыйКонтейнер.Записать();
			
			НомерКТК = СтрокаТаблицы.НомерКонтейнера;
			ТипТЕ = СтрокаТаблицы.ТипТЕ;
			Контейнер = РаботаСКонтейнерамиСервер.СоздатьКТК(НомерКТК, ТипТЕ);
			СтрокаТаблицы.Контейнер = Контейнер;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Груз) И ЗначениеЗаполнено(СтрокаТаблицы.НаименованиеГруза) Тогда
			НовыйЭлемент = Справочники.Грузы.СоздатьЭлемент();
			НовыйЭлемент.Наименование = СтрокаТаблицы.НаименованиеГруза;
			НовыйЭлемент.ТНВЭД = СтрокаТаблицы.КодГрузаТНВЭД;
			НовыйЭлемент.Записать();
			СтрокаТаблицы.Груз = НовыйЭлемент.Ссылка;
		ИначеЕсли ЗначениеЗаполнено(СтрокаТаблицы.Груз) 
				И ЗначениеЗаполнено(СтрокаТаблицы.КодГрузаТНВЭД) 
				И СтрокаТаблицы.КодГрузаТНВЭД <> СтрокаТаблицы.КодНайденногоГрузаТНВЭД Тогда
			ГрузОбъект = СтрокаТаблицы.Груз.ПолучитьОбъект();
			ГрузОбъект.ТНВЭД = СтрокаТаблицы.КодГрузаТНВЭД;
			ГрузОбъект.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаКонтейнеров;
	
КонецФункции

