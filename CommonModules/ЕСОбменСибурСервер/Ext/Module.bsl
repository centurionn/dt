Функция ПолучитьЗначениеПоляОбъектаXDTO(ПолеОбъекта, ТипЗначения = Неопределено, ПустоеЗначение = Неопределено)
		
	Если ТипЗнч(ПолеОбъекта) = Тип("ОбъектXDTO") Тогда
		ЗначениеПоля = ПустоеЗначение;
	ИначеЕсли ТипЗначения <> Неопределено Тогда
		Попытка
			ЗначениеПоля = XMLЗначение(ТипЗначения, ПолеОбъекта);
		Исключение
			Если ТипЗначения = Тип("Дата") И ТипЗнч(ПолеОбъекта) = Тип("Строка") Тогда
				Если СтрДлина(ПолеОбъекта) = 17 Тогда
					СтрокаДаты = СтрЗаменить(ПолеОбъекта, " ", "");
					СтрокаДаты = СтрЗаменить(СтрокаДаты, ":", "");
					ОписаниеТипа = Новый ОписаниеТипов("Дата");
					ЗначениеПоля = ОписаниеТипа.ПривестиЗначение(СтрокаДаты);
				КонецЕсли;			
			КонецЕсли;
		КонецПопытки;
	Иначе
		ЗначениеПоля = ПолеОбъекта;
	КонецЕсли;
	
	Возврат ЗначениеПоля;
	
КонецФункции

Функция ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ОбъектXDTO, ИмяПоля, ТипЗначения = Неопределено, ПустоеЗначение = Неопределено)
	
	Если ОбъектXDTO.Свойства().Получить(ИмяПоля) <> Неопределено Тогда
		ПолеОбъекта = ОбъектXDTO[ИмяПоля];
	Иначе
		ПолеОбъекта = ПустоеЗначение;
	КонецЕсли;
		
	Если ТипЗнч(ПолеОбъекта) = Тип("ОбъектXDTO") Тогда
		ЗначениеПоля = ПустоеЗначение;
	ИначеЕсли ТипЗначения <> Неопределено Тогда
		Попытка
			ЗначениеПоля = XMLЗначение(ТипЗначения, ПолеОбъекта);
		Исключение
			Если ТипЗначения = Тип("Дата") И ТипЗнч(ПолеОбъекта) = Тип("Строка") Тогда
				Если СтрДлина(ПолеОбъекта) = 17 Тогда
					СтрокаДаты = СтрЗаменить(ПолеОбъекта, " ", "");
					СтрокаДаты = СтрЗаменить(СтрокаДаты, ":", "");
					ОписаниеТипа = Новый ОписаниеТипов("Дата");
					ЗначениеПоля = ОписаниеТипа.ПривестиЗначение(СтрокаДаты);
				КонецЕсли;			
			КонецЕсли;
		КонецПопытки;
	Иначе
		ЗначениеПоля = ПолеОбъекта;
	КонецЕсли;
	
	Возврат ЗначениеПоля;
	
КонецФункции

Функция УдалитьПолучитьСтатусЗаявкиПоКоду(КодСтатуса, НаименованиеСтатуса)
	
	Если ЗначениеЗаполнено(КодСтатуса) Тогда		
		СтатусЗаявки = Справочники.СибурСтатусыЗаявок.НайтиПоКоду(КодСтатуса);
		Если Не ЗначениеЗаполнено(СтатусЗаявки) Тогда
			НовыйЭлемент = Справочники.СибурСтатусыЗаявок.СоздатьЭлемент();
			НовыйЭлемент.Код = КодСтатуса;
			НовыйЭлемент.Наименование = НаименованиеСтатуса;
			НовыйЭлемент.Записать();
			СтатусЗаявки = НовыйЭлемент.Ссылка;
		КонецЕсли;		
	Иначе
		СтатусЗаявки = Справочники.СибурСтатусыЗаявок.ПустаяСсылка();
	КонецЕсли;
	
	Возврат СтатусЗаявки;
	
КонецФункции

Функция ПолучитьКалькуляциюИПротокол(Контрагент, Договор, СтанцияОтправления, СтанцияНазначения)
	
	Результат = Новый Структура("Калькуляция, Протокол");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Калькуляция.Ссылка КАК Ссылка,
	|	Калькуляция.Дата КАК Дата
	|ПОМЕСТИТЬ ВТКалькуляции
	|ИЗ
	|	Документ.Калькуляция КАК Калькуляция
	|ГДЕ
	|	Калькуляция.Контрагент = &Контрагент
	|	И Калькуляция.Договор = &Договор
	|	И Калькуляция.Проведен
	|	И Калькуляция.Суша_ПунктОтправления = &СтанцияОтправления
	|	И Калькуляция.Суша_ПунктНазначения = &СтанцияНазначения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТКалькуляции.Ссылка КАК Калькуляция
	|ПОМЕСТИТЬ ВТПоследниеКалькуляции
	|ИЗ
	|	(ВЫБРАТЬ
	|		МАКСИМУМ(ВТКалькуляции.Дата) КАК Дата
	|	ИЗ
	|		ВТКалькуляции КАК ВТКалькуляции) КАК ДатаПоследнейКалькуляции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКалькуляции КАК ВТКалькуляции
	|		ПО ДатаПоследнейКалькуляции.Дата = ВТКалькуляции.Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПоследниеКалькуляции.Калькуляция КАК Калькуляция,
	|	ПСЦКалькуляции.Ссылка КАК Протокол
	|ИЗ
	|	ВТПоследниеКалькуляции КАК ВТПоследниеКалькуляции
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПСЦ.Калькуляции КАК ПСЦКалькуляции
	|		ПО ВТПоследниеКалькуляции.Калькуляция = ПСЦКалькуляции.Калькуляция";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Договор", Договор);
	
	Если ЗначениеЗаполнено(СтанцияОтправления) Тогда
		Запрос.УстановитьПараметр("СтанцияОтправления", СтанцияОтправления);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Калькуляция.Суша_ПунктОтправления = &СтанцияОтправления", "");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтанцияНазначения) Тогда
		Запрос.УстановитьПараметр("СтанцияНазначения", СтанцияНазначения);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Калькуляция.Суша_ПунктНазначения = &СтанцияНазначения", "");
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда	
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
	
