		Запрос.УстановитьПараметр("ДатаНачалаИспользованияИзРегистра202506", Дата(2025, 6, 1)); //чтобы за предыдущие периоды не насыпало уведомлений пользователям
		Запрос.УстановитьПараметр("ТипДокумента", СписокТиповДокументов);

КонецПроцедуры 	
	
Процедура ДобавитьТекстЗапросаОтказаноВАннулированииДиадок(МассивТекстовЗапросов, Запрос)	
	
		СписокТиповДокументов = Новый СписокЗначений;
		СписокТиповДокументов.Добавить(Тип("ДокументСсылка.РеализацияТоваровУслуг"));
		СписокТиповДокументов.Добавить(Тип("ДокументСсылка.ОтчетКомитентуОПродажах"));
		СписокТиповДокументов.Добавить(Тип("ДокументСсылка.КорректировкаРеализации"));
		
		ЗапросСтатусы = Новый Запрос;
		ЗапросСтатусы.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|Диадок_Документы.Статус КАК Статус
			|ИЗ
			|		Справочник.Диадок_Документы КАК Диадок_Документы
			|ГДЕ  Диадок_Документы.Статус ПОДОБНО ""%Отказано в аннулировании%""";
		МассивСтатусов = ЗапросСтатусы.Выполнить().Выгрузить().ВыгрузитьКолонку("Статус");
		
		
		МассивТекстовЗапросов.Добавить("ВЫБРАТЬ
		                               |	Диадок_Документы.Ссылка КАК Ссылка,
		                               |	Диадок_Документы.ДатаДокумента КАК ДатаДокумента,
		                               |	ЗНАЧЕНИЕ(Справочник.СобытияОтправкиДокументов.ОтказаноВАннулированииДиадок) КАК Алгоритм,
		                               |	Диадок_Документы.Подписант КАК Подписант,
		                               |	0 КАК ЦиклРаботыСДокументом
		                               |ИЗ
		                               |	Справочник.Диадок_Документы КАК Диадок_Документы
		                               |ГДЕ
		                               |	ТИПЗНАЧЕНИЯ(Диадок_Документы.Документ) = ТИП(Документ.ОтчетКомитентуОПродажах)
		                               |	И НЕ Диадок_Документы.ПометкаУдаления
		                               |	И Диадок_Документы.Статус В(&МассивСтатусов)
		                               |
		                               |ОБЪЕДИНИТЬ
		                               |
		                               |ВЫБРАТЬ
		                               |	СостоянияДокументовВДиадоке.Документ,
		                               |	СостоянияДокументовВДиадоке.ДатаДокумента,
		                               |	ЗНАЧЕНИЕ(Справочник.СобытияОтправкиДокументов.ОтказаноВАннулированииДиадок),
		                               |	СостоянияДокументовВДиадоке.Подписант,
		                               |	0
		                               |ИЗ
		                               |	РегистрСведений.СостоянияДокументовВДиадоке КАК СостоянияДокументовВДиадоке
		                               |ГДЕ
		                               |	СостоянияДокументовВДиадоке.ДатаОбновленияСостояния >= &ДатаНачалаИспользованияИзРегистра202506
		                               |	И ТИПЗНАЧЕНИЯ(СостоянияДокументовВДиадоке.Документ) В (&ТипДокумента)
		                               |	И СостоянияДокументовВДиадоке.СостояниеДокументооборота В(&МассивСтатусов)");

		//Запрос.УстановитьПараметр("ДатаНачалаИспользованияИзРегистра", Дата(2025, 6, 1)); //чтобы за предыдущие периоды не насыпало уведомлений пользователям
		//Евросиб(ДИТ), Беляев СЮ, Ticket#0406825, 14-07-2025, начало
		Запрос.УстановитьПараметр("ДатаНачалаИспользованияИзРегистра202506", Дата(2025, 6, 1)); //чтобы за предыдущие периоды не насыпало уведомлений пользователям
		//Евросиб(ДИТ), Беляев СЮ, Ticket#0406825, 14-07-2025, конец
		Запрос.УстановитьПараметр("ТипДокумента", СписокТиповДокументов);
		Запрос.УстановитьПараметр("МассивСтатусов", МассивСтатусов);
		
КонецПроцедуры


