Функция ПолучитьСписокДокументов() Экспорт 
	
	Запрос = Новый Запрос; 
	Запрос.Текст = ""; 
	
	//Евросиб СубботинВ #129659 04.02.2026 Начало//
	
	//		В рамках задачи начал оптимизацию кода, каждый запрос перенесен в отдельную процедуру,
	//		вместе с параметрами, которые необходимы для основного собранного запроса
	
	//Евросиб СубботинВ #129659 04.02.2026 Конец//

	
	МассивТекстовЗапросов = новый Массив;
	
	Если Справочники.СобытияОтправкиДокументов.СозданиеДокумента.ОтправкаПисемПоСобытию Тогда		
		ДобавитьТекстЗапросаСозданиеДокументов(МассивТекстовЗапросов, Запрос);	   
	КонецЕсли; 
	
	//Если Справочники.СобытияОтправкиДокументов.ИзменениеДатыРТУ.ОтправкаПисемПоСобытию Тогда
    	//ДобавитьТекстЗапросаИзменениеДатыРТУ(МассивТекстовЗапросов, Запрос)
    //КонецЕсли;
	
	Если Справочники.СобытияОтправкиДокументов.ОтказаноВПодписиДиадок.ОтправкаПисемПоСобытию Тогда		
		ДобавитьТекстЗапросаОтказаноВПодписиДиадок(МассивТекстовЗапросов, Запрос);
	КонецЕсли;
	
	//Евросиб СубботинВ #89527 30.10.2024 Начало// рассылка уведомлений по отклонению заявок
	Если Справочники.СобытияОтправкиДокументов.ОтклонениеЗаявкиНаОплатуВУПП.ОтправкаПисемПоСобытию Тогда		
		ДобавитьТекстЗапросаОтклонениеЗаявкиНаОплатуВУПП(МассивТекстовЗапросов, Запрос);
	КонецЕсли;
	
	// рассылка уведомлений по не согласованию реестра
	Если Справочники.СобытияОтправкиДокументов.НеСогласованРеестрПлатежей.ОтправкаПисемПоСобытию Тогда		
		ДобавитьТекстЗапросаНеСогласованРеестрПлатежей(МассивТекстовЗапросов, Запрос);
	КонецЕсли;
	
	// рассылка уведомлений по не утверждению реестра	
	Если Справочники.СобытияОтправкиДокументов.НеУтвержденРеестрПлатежей.ОтправкаПисемПоСобытию Тогда 		
		ДобавитьТекстЗапросаНеУтвержденРеестрПлатежей(МассивТекстовЗапросов, Запрос);		
	КонецЕсли;
	
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0382126, 15-01-2025, начало
	Если Справочники.СобытияОтправкиДокументов.ТребуетсяАннулирование.ОтправкаПисемПоСобытию Тогда 
		ДобавитьТекстЗапросаТребуетсяАннулирование(МассивТекстовЗапросов, Запрос);
	КонецЕсли; 
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0382126, 15-01-2025, конец

	//Евросиб СубботинВ #89527 30.10.2024 Конец
	
	//Евросиб СубботинВ #102687 14.02.2025 Начало // рассылка по выводу ктк из оперирования
	Если Справочники.СобытияОтправкиДокументов.ВыводКткИзОперирования.ОтправкаПисемПоСобытию Тогда
	    ДобавитьТекстЗапросаВыводКткИзОперирования(МассивТекстовЗапросов, Запрос);
	КонецЕсли;
	//Евросиб СубботинВ #102687 14.02.2025 Конец
	
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0389212, 30-06-2025, начало
	Если Справочники.СобытияОтправкиДокументов.ТребуетсяУточнениеДиадок.ОтправкаПисемПоСобытию Тогда 
		ДобавитьТекстЗапросаТребуетсяУточнениеДиадок(МассивТекстовЗапросов, Запрос);
	КонецЕсли;
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0389212, 30-06-2025, конец
	
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0389212, 30-06-2025, начало
	Если Справочники.СобытияОтправкиДокументов.ОтказаноВАннулированииДиадок.ОтправкаПисемПоСобытию Тогда 
		ДобавитьТекстЗапросаОтказаноВАннулированииДиадок(МассивТекстовЗапросов, Запрос);
	КонецЕсли;
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0389212, 30-06-2025, конец

	Если МассивТекстовЗапросов.Количество()> 0 Тогда
		Запрос.Текст = СтрСоединить(МассивТекстовЗапросов, " ОБЪЕДИНИТЬ ВСЕ ");
		Возврат Запрос.Выполнить().Выгрузить();		
	ИначеЕсли МассивТекстовЗапросов.Количество()= 0
		и (Справочники.СобытияОтправкиДокументов.ВыводКткИзОперирования.ОтправкаПисемПоСобытию
		или Справочники.СобытияОтправкиДокументов.ОшибкаПередачиЗаявкиВУПП.ОтправкаПисемПоСобытию) Тогда
		ТЗ = Новый ТаблицаЗначений;
		ТЗ.Колонки.Добавить("Алгоритм");
		Возврат ТЗ
	Иначе ВызватьИсключение("Нет включенных для обработки событий");	
	КонецЕсли;
	
	
КонецФункции

Процедура СоздатьКлючевыеПоляСобытийОтправкиДокументов(СпискиДокументовИСобытий, НеОтправлятьПисьма = Ложь) Экспорт  
	
	ТЗСтрокДокументов = СпискиДокументовИСобытий;
	Отбор = Новый Структура();
	Отбор.Вставить("Алгоритм", Справочники.СобытияОтправкиДокументов.СозданиеДокумента);
	СпискиДокументовСоздание = ТЗСтрокДокументов.Скопировать(Отбор);	
	Если СпискиДокументовСоздание.Количество() >0 Тогда 	
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ 
		|	РтуСобытиеСоздания.Ссылка КАК РТУ,
		|	РтуСобытиеСоздания.ДатаДокумента КАК ДатаДокумента,
		|	РтуСобытиеСоздания.Алгоритм КАК Событие
		//Евросиб СубботинВ #102687 14.02.2025 Начало//
		|	,РтуСобытиеСоздания.ЦиклРаботыСДокументом КАК Цикл
		//Евросиб СубботинВ #102687 14.02.2025 Конец// 
		|ПОМЕСТИТЬ ВТ_СозданиеРТУ
		|ИЗ
		|	&РтуСобытиеСоздания КАК РтуСобытиеСоздания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СозданиеРТУ.РТУ КАК РТУ,
		|	ВТ_СозданиеРТУ.ДатаДокумента КАК ДатаДокумента,
		|	ВТ_СозданиеРТУ.Событие КАК Событие
		|ИЗ
		|	ВТ_СозданиеРТУ КАК ВТ_СозданиеРТУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючевыеПоляСобытийОтправкиДокументов КАК КлючевыеПоляСобытийОтправкиДокументов
		|		ПО ВТ_СозданиеРТУ.РТУ = КлючевыеПоляСобытийОтправкиДокументов.Документ
		|			И ВТ_СозданиеРТУ.Событие = КлючевыеПоляСобытийОтправкиДокументов.Событие 
		//Евросиб СубботинВ #102687 14.02.2025 Начало//
