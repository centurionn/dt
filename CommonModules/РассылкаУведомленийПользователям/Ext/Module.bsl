
//БСП создание письма не использовал, т.к по результату выполнения нужна ссылка
//Функция СоздатьПисьмоУведомление(Получатель = Неопределено, ПочтаПолучателя = Неопределено, Тема, ТипТекста, Текст = Неопределено,
//									ПолучательКопии = Неопределено, ПочтаПолучателяКопии = Неопределено,) Экспорт
Функция СоздатьПисьмоУведомление(МассивПолучателей, Тема, ТипТекста, Текст = Неопределено, МассивПолучателейКопии = Неопределено, ВыполнениеЗадач = Ложь) Экспорт
	
	НовоеПисьмо = Документы.ЭлектронноеПисьмоИсходящее.СоздатьДокумент();
		//Евросиб СубботинВ #104841 07.05.2025 Начало
	Если ВыполнениеЗадач Тогда
		УчетнаяЗапись = Справочники.УчетныеЗаписиЭлектроннойПочты.УчетнаяЗаписьДляРассылкиЗадач;
	Иначе
		УчетнаяЗапись = УправлениеЭлектроннойПочтой.ПолучитьУчетнуюЗаписьДляОтправкиПоУмолчанию();		
	КонецЕсли;
	//Евросиб СубботинВ #104841 07.05.2025 Конец
	
		
	НовоеПисьмо.ТипТекста = ТипТекста;
	
	Если ТипТекста = Перечисления.ТипыТекстовЭлектронныхПисем.ПростойТекст Тогда
		НовоеПисьмо.Текст = Текст;
	Иначе
		НовоеПисьмо.ТекстHTML = Текст;
	КонецЕсли;
	
	НовоеПисьмо.Тема = Тема; 
	НовоеПисьмо.СтатусПисьма = Перечисления.СтатусыИсходящегоЭлектронногоПисьма.Исходящее;
	НовоеПисьмо.УчетнаяЗапись = УчетнаяЗапись;
	НовоеПисьмо.Дата = ТекущаяДата();
	НовоеПисьмо.ДатаОтправления = ТекущаяДата();
	НовоеПисьмо.ОтправительПредставление =  УчетнаяЗапись.ИмяПользователя;
	НовоеПисьмо.УдалятьПослеОтправки = Ложь;
	
	//Евросиб СубботинВ #104841 07.05.2025 Конец
	Если ТипЗнч(МассивПолучателей) = Тип("Массив") Тогда
		
		//Евросиб СубботинВ #104218 13.03.2025 Начало
		ВидыСправочнойИнформации = Новый Массив;
		ВидыСправочнойИнформации.Добавить(Справочники.ВидыКонтактнойИнформации.EmailПользователя);
		
		ПочтыПолучателейПисьма = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъектов(МассивПолучателей,, ВидыСправочнойИнформации);
		
		//Евросиб СубботинВ #105221 19.03.2025 Начало
		
		//ДобавитьПолучатель = НовоеПисьмо.ПолучателиПисьма.Добавить();
		//ДобавитьПолучатель.Адрес = ПочтаПолучателя;
		//ДобавитьПолучатель.Представление = Получатель;
		Для Каждого ПолучательПисьма из ПочтыПолучателейПисьма Цикл 
			ДобавитьПолучателя = НовоеПисьмо.ПолучателиПисьма.Добавить();
			ДобавитьПолучателя.Адрес = ПолучательПисьма.Представление;
			ДобавитьПолучателя.Представление = ПолучательПисьма.Объект;
		КонецЦикла;
	ИначеЕсли ТипЗнч(МассивПолучателей) = Тип("Строка") Тогда
		МассивФИОПочтаПоПользователю = СтрРазделить(МассивПолучателей," ");
		Почта = МассивФИОПочтаПоПользователю[МассивФИОПочтаПоПользователю.Количество()-1];
		Почта = СтрЗаменить(Почта,"<","");
		Почта = СтрЗаменить(Почта,">","");
		ДобавитьПолучателя = НовоеПисьмо.ПолучателиПисьма.Добавить();
		ДобавитьПолучателя.Адрес = Почта;
	КонецЕсли;	
		
	//Евросиб СубботинВ #104841 07.05.2025 Конец

	
	//Если ЗначениеЗаполнено(ПолучательКопии) и ЗначениеЗаполнено(ПочтаПолучателяКопии) Тогда
	//	ДобавитьПолучателяКопии = НовоеПисьмо.ПолучателиКопий.Добавить();
	//	ДобавитьПолучателяКопии.Адрес = ПочтаПолучателяКопии; 
	//	ДобавитьПолучателяКопии.Представление = ПолучательКопии;
	//КонецЕсли;
	Если НЕ МассивПолучателейКопии = Неопределено и МассивПолучателейКопии.Количество()>0 Тогда 
		ПочтыПолучателейКопииПисьма = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъектов(МассивПолучателейКопии,, ВидыСправочнойИнформации);
		Для Каждого ПолучательКопии из ПочтыПолучателейКопииПисьма Цикл 
			ДобавитьПолучателяКопии = НовоеПисьмо.ПолучателиКопий.Добавить();
			ДобавитьПолучателяКопии.Адрес = ПолучательКопии.Представление;
			ДобавитьПолучателяКопии.Представление = ПолучательКопии.Объект;
		КонецЦикла;
	КонецЕсли; 
	//Евросиб СубботинВ #104218 13.03.2025 Конец
	
	Попытка	
		НовоеПисьмо.Записать();
	Исключение
		ТекстОшибки = ОписаниеОшибки(); 
		//Евросиб СубботинВ #104218 13.03.2025 Начало //перевел на универсальный формат
		//ЗаписьЖурналаРегистрации("Ошибка отправки уведомлений о выставлении РТУ по доп. услугам", УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		ЗаписьЖурналаРегистрации("Ошибка отправки уведомления: " + Тема, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		//Евросиб СубботинВ #104218 13.03.2025 Конец
		Возврат Документы.ЭлектронноеПисьмоИсходящее.ПустаяСсылка();
	КонецПопытки;
	
	Возврат НовоеПисьмо.Ссылка;

КонецФункции 

Функция СформироватьТекстШапкиСообщенияУведомленияСозданиеРТУ(ДанныеЗаполнения)
		 
	ТекстПисьма = СтрШаблон("<p>Обращаем Ваше внимание, что %1 клиенту %2 по договору %3 оформлены документы по дополнительным услугам</p>",
				  ДанныеЗаполнения.Документ.Создано, ДанныеЗаполнения.Контрагент, ДанныеЗаполнения.Договор);
	
	ТекстПисьма = ТекстПисьма + Символы.ПС + "<table border=""1""><tbody><th>Сделка/Заказ</th><th>Номер/Дата документа</th>
	|<th>Сумма </th><th>Валюта</th><th>Услуга</th>";
	
	Возврат ТекстПисьма	
	
КонецФункции

