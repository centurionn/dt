Функция СформироватьТекстШапкиСообщенияУведомленияСозданиеРТУ_Премия(ДанныеЗаполнения)
	
	ТекстПисьма = СтрШаблон("<p>Обращаем Ваше внимание, что %1 клиенту %2 по договору %3 оформлены документы по премиям</p>",
				  ДанныеЗаполнения.Документ.Создано, ДанныеЗаполнения.Контрагент, ДанныеЗаполнения.Договор);
	
	ТекстПисьма = ТекстПисьма + Символы.ПС + "<table border=""1""><tbody><th>Сделка/Заказ</th><th>Номер/Дата документа</th>
	|<th>Сумма </th><th>Валюта</th><th>Услуга</th>";
	
	Возврат ТекстПисьма
	
КонецФункции
//Евросиб(ДИТ), Беляев СЮ, US 111184 / TA 111245, 11-06-2025, конец

Функция СформироватьТекстСтрокиСообщенияУведомленияРТУ(ДанныеЗаполнения)
		 
	ТекстПисьма = Символы.ПС + "<tr>";
	ТекстПисьма = ТекстПисьма + "<td>" + ДанныеЗаполнения.Сделка.Номер + "/" + СтрЗаменить(Год(ДанныеЗаполнения.Сделка.Дата),Символы.НПП,"") +"г"+ "</td>";
	ТекстПисьма = ТекстПисьма + "<td>" + ДанныеЗаполнения.Документ.Номер + "/" + Формат(ДанныеЗаполнения.Документ.ДатаДокумента,"ДФ=dd.MM.yyyy") + "</td>";
	ТекстПисьма = ТекстПисьма + "<td>" + ДанныеЗаполнения.Документ.СуммаДокумента + "</td>";
	ТекстПисьма = ТекстПисьма + "<td>" + ДанныеЗаполнения.Документ.ВалютаДокумента + "</td>";
	ТекстПисьма = ТекстПисьма + "<td>" + ДанныеЗаполнения.Услуга + "</td>";
	ТекстПисьма = ТекстПисьма + "</tr>";    
		
	Возврат ТекстПисьма	
	
КонецФункции	

Процедура ДобавитьЗаписьПоРассылкеДокументов(Источник, Письмо) Экспорт
	
	РегистрыСведений.РассылкаПоДокументам.ДобавитьЗапись(Источник, Письмо);
		
КонецПроцедуры

//Функция СформироватьЗаписиСобытийИзменений(Документ, Событие, ДатаДокумента, ОтправкаПисьма = Ложь) Экспорт
//Евросиб(ДИТ), Беляев СЮ, BUG 92593 / TA 92595, 07-10-2024, добавил параметр "Подписант"
Функция СформироватьЗаписиСобытийИзменений(Документ, Событие, ДатаДокумента = Неопределено, ОтправкаПисьма = Ложь, Подписант = Неопределено, ЦиклРаботы = Неопределено) Экспорт
	
	НовоеСобытие = Справочники.КлючевыеПоляСобытийОтправкиДокументов.СоздатьЭлемент();
	//Евросиб СубботинВ #102687 20.02.2025 Начало
	Гуид = Новый УникальныйИдентификатор();
	НоваяСсылка = Справочники.КлючевыеПоляСобытийОтправкиДокументов.ПолучитьСсылку(Гуид);
	НовоеСобытие.УстановитьСсылкуНового(НоваяСсылка);
	НовоеСобытие.Наименование = Гуид;
	//Евросиб СубботинВ #102687 20.02.2025 Конец
    НовоеСобытие.Документ = Документ;
	НовоеСобытие.ДатаДокумента = ДатаДокумента;
	НовоеСобытие.НеОтравлятьПисьмо = ОтправкаПисьма;
	НовоеСобытие.Событие = Событие; 
	//Евросиб(ДИТ), Беляев СЮ, BUG 92593 / TA 92595, 07-10-2024, начало
	НовоеСобытие.Подписант = Подписант;
	//Евросиб(ДИТ), Беляев СЮ, BUG 92593 / TA 92595, 07-10-2024, конец
	//Евросиб СубботинВ #102687 14.02.2025 Начало// 
	Если НЕ ЦиклРаботы = Неопределено тогда
		НовоеСобытие.Цикл = ЦиклРаботы;
	КонецЕсли;	
	//Евросиб СубботинВ #102687 14.02.2025 Конец// 
	НовоеСобытие.Записать(); 
	Возврат НовоеСобытие.Ссылка;
	
КонецФункции

