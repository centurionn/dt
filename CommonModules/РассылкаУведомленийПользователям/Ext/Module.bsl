Функция ЧисловойИдентификаторВариантаВыполнения(ВариантВыполнения)
	
	ЧисловойИдентификатор = "0";	
	Если ВариантВыполнения = Перечисления.СтатусыСогласования.СогласованоБезЗамечаний Тогда		
		ЧисловойИдентификатор = "1";
		
	ИначеЕсли ВариантВыполнения = Перечисления.СтатусыСогласования.ОтклоненоБезЗамечаний Тогда		
		ЧисловойИдентификатор = "2";
	// Евросиб US 90342 Рыбьяков К.А. 05.03.2026 ((
	ИначеЕсли ВариантВыполнения = Перечисления.СтатусыСогласования.СогласованоСЗамечаниями Тогда
		ЧисловойИдентификатор = "3";
	// Евросиб Рыбьяков К.А. 05.03.2026 ))
	КонецЕсли;
	
	Возврат ЧисловойИдентификатор;
	
