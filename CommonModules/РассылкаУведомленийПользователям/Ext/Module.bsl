// Евросиб US 90342 Рыбьяков К.А. 14.12.2025 ((
Функция ПодобратьПодходящуюСтроку(Запись, ТаблицаРезультат)
	
	СтрокаПоиска = Запись.ПараметрПеревозки.РазмерКТК.Наименование 
		+ ?(Запись.ПараметрПеревозки.ВидТранспортногоСообщения = Перечисления.ВидыТранспортныхСообщений.ЖД, "ЖД", "Фрахт")
		+ ?(Запись.ПараметрПеревозки.ПринадлежностьТЕ = Перечисления.ПринадлежностьТЕ.КТЕвросиба, "COC", "SOC");
		
	Ставка = "";
	
	Если Запись.ТипСтавки = Перечисления.ТипыСтавок.СпециальнаяСтавка Тогда
		Ставка = "Ставка" + СтрокаПоиска
	ИначеЕсли Запись.ТипСтавки = Перечисления.ТипыСтавок.Скидка 
			Или Запись.ТипСтавки = Перечисления.ТипыСтавок.Надбавка Тогда
		Ставка = "НадбавкаСкидка" + СтрокаПоиска;
	КонецЕсли;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Контрагент", Запись.Контрагент);
	СтруктураОтбора.Вставить("ПлановыйОбъемTEU", Запись.ПлановыйОбъемTEU);
	СтруктураОтбора.Вставить("ТипСтавки", Запись.ТипСтавки);
	СтруктураОтбора.Вставить(Ставка, 0);
	
	НайденнаяСтрока = ТаблицаРезультат.НайтиСтроки(СтруктураОтбора);
	
	Возврат ?(НайденнаяСтрока.Количество() > 0, НайденнаяСтрока[0], Неопределено);
	
КонецФункции // Евросиб Рыбьяков К.А. 14.12.2025 ))

