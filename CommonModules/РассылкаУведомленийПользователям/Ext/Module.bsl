Процедура ДобавитьТекстЗапросаТребуетсяАннулирование(МассивТекстовЗапросов, Запрос)
	
	    СписокТиповДокументов = Новый СписокЗначений;
		СписокТиповДокументов.Добавить(Тип("ДокументСсылка.РеализацияТоваровУслуг"));
		СписокТиповДокументов.Добавить(Тип("ДокументСсылка.ОтчетКомитентуОПродажах"));
		СписокТиповДокументов.Добавить(Тип("ДокументСсылка.КорректировкаРеализации"));

	
		МассивТекстовЗапросов.Добавить("ВЫБРАТЬ
		|	Диадок_Документы.Ссылка КАК Ссылка,
		|	Диадок_Документы.ДатаДокумента КАК ДатаДокумента,
		|	ЗНАЧЕНИЕ(Справочник.СобытияОтправкиДокументов.ТребуетсяАннулирование) КАК Алгоритм,
		|	Диадок_Документы.Подписант КАК Подписант
		 //Евросиб СубботинВ #102687 14.02.2025 Начало// 
	   	|	,0 КАК ЦиклРаботыСДокументом
	   	//Евросиб СубботинВ #102687 14.02.2025 Конец//
		|ИЗ
		|	Справочник.Диадок_Документы КАК Диадок_Документы
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(Диадок_Документы.Документ) = ТИП(Документ.ОтчетКомитентуОПродажах)
		|	И НЕ Диадок_Документы.ПометкаУдаления
		|	И Диадок_Документы.Статус = ""Требуется аннулирование""
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	СостоянияДокументовВДиадоке.Документ,
		|	СостоянияДокументовВДиадоке.ДатаДокумента,
		|	ЗНАЧЕНИЕ(Справочник.СобытияОтправкиДокументов.ТребуетсяАннулирование),
		|	СостоянияДокументовВДиадоке.Подписант
		//Евросиб СубботинВ #102687 14.02.2025 Начало// 
	   	|	,0 КАК ЦиклРаботыСДокументом
	   	//Евросиб СубботинВ #102687 14.02.2025 Конец//
		|ИЗ
		|	РегистрСведений.СостоянияДокументовВДиадоке КАК СостоянияДокументовВДиадоке
		|ГДЕ
		|	СостоянияДокументовВДиадоке.ДатаДокумента >= &ДатаНачалаИспользованияИзРегистра
		|	И ТИПЗНАЧЕНИЯ(СостоянияДокументовВДиадоке.Документ) В (&ТипДокумента)
		|	И СостоянияДокументовВДиадоке.СостояниеДокументооборота = ""Требуется аннулирование""");
		
		Запрос.УстановитьПараметр("ДатаНачалаИспользованияИзРегистра", Дата(2024, 10, 1)); //чтобы за предыдущие периоды не насыпало уведомлений пользователям
		Запрос.УстановитьПараметр("ТипДокумента", СписокТиповДокументов);
		
КонецПроцедуры		

Процедура ДобавитьТекстЗапросаВыводКткИзОперирования(МассивТекстовЗапросов, Запрос)

	МассивТекстовЗапросов.Добавить("ВЫБРАТЬ РАЗЛИЧНЫЕ
       |	РелизСобственникаНоминации.КлючАналитики КАК Ссылка,
       |	НАЧАЛОПЕРИОДА(РелизСобственникаНоминации.Ссылка.Дата, ДЕНЬ) КАК ДатаДокумента,
       |	ЗНАЧЕНИЕ(Справочник.СобытияОтправкиДокументов.ВыводКткИзОперирования) КАК Алгоритм,
       |	РелизСобственникаНоминации.Ссылка.Автор КАК Подписант
	   	//Евросиб СубботинВ #102687 14.02.2025 Начало// 
	   |	,0 КАК ЦиклРаботыСДокументом
	   //Евросиб СубботинВ #102687 14.02.2025 Конец//
       |ИЗ
       |	Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
       |ГДЕ
       |	РелизСобственникаНоминации.Ссылка.Проведен
       |	И РелизСобственникаНоминации.тек_СобственностьКТК В(&тек_СобственностьКТК)
       |	И РелизСобственникаНоминации.ДатаВозвратаСобственнику = ДАТАВРЕМЯ(1, 1, 1)
       |	И ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(РелизСобственникаНоминации.ДатаВзятия, ДЕНЬ), ДЕНЬ, РелизСобственникаНоминации.НормативВозврата) <= НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ)
       |	И НЕ РелизСобственникаНоминации.Контейнер = ЗНАЧЕНИЕ(Справочник.Те.ПустаяСсылка)");
	   
	   	ВидыСобственности = Новый СписокЗначений;
		ВидыСобственности.Добавить(Перечисления.ВариантыСобственности.Спот);
		ВидыСобственности.Добавить(Перечисления.ВариантыСобственности.СпотДоплатный);
		
		Запрос.УстановитьПараметр("тек_СобственностьКТК", ВидыСобственности);
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());


