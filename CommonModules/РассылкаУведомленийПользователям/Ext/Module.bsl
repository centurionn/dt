Функция СформироватьТекстШапкиСообщенияВыводИзОперирования(Автор)
		 
	ТекстПисьма = СтрШаблон("Уважаемый %1, на сегодня в системе присутствуют контейнеры, которые не выведены из оперирования.
		 					|По данным контейнерам начался период СНП. Прошу закрыть цикл пользования контейнера", Автор);
	
	ТекстПисьма = ТекстПисьма + Символы.ПС + "<table border=""1""><tbody><th>Контейнер</th><th>Номер 1С Релиза</th>
	|<th>Дата релиза </th><th>НомерДокумента</th><th>Итого</th><th>Осталось к возврату</th><th>Автор</th>";
	
	Возврат ТекстПисьма	
	
КонецФункции
 
Функция СформироватьТекстСтрокиСообщенияВыводИзОперирования(ДанныеЗаполнения)
		 
	ТекстПисьма = Символы.ПС + "<tr>";
	ТекстПисьма = ТекстПисьма + "<td>" + ДанныеЗаполнения.Контейнер + "</td>";
	ТекстПисьма = ТекстПисьма + "<td>" + ДанныеЗаполнения.Номер + "</td>";
	ТекстПисьма = ТекстПисьма + "<td>" + ДанныеЗаполнения.Дата + "</td>";
	ТекстПисьма = ТекстПисьма + "<td>" + ДанныеЗаполнения.НомерДокумента + "</td>";
	ТекстПисьма = ТекстПисьма + "<td>" + ДанныеЗаполнения.ОбщееКоличествоВРелизе + "</td>";
	ТекстПисьма = ТекстПисьма + "<td>" + ДанныеЗаполнения.ОсталосьКВыдаче + "</td>";
	ТекстПисьма = ТекстПисьма + "<td>" + ДанныеЗаполнения.Автор + "</td>";
	ТекстПисьма = ТекстПисьма + "</tr>";    
		
	Возврат ТекстПисьма	
	
КонецФункции 

