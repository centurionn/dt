Функция ПринятьДанныеВходящихПисем(ДанныеВходящихПисем) Экспорт 
	
	РезультатОбработки = Новый Массив;
	
	Для каждого ДанныеПисьма Из ДанныеВходящихПисем Цикл  
		
		Если не ЗначениеЗаполнено(ДанныеПисьма.ИдентификаторПисьма) Тогда
			Продолжить;
		КонецЕсли;     
		
		Сообщение = Новый Структура("ИдентификаторПисьма, ТемаПисьма, ТекстПисьма, ДатаОтправки, Отправитель"); 
		ЗаполнитьЗначенияСвойств(Сообщение, ДанныеПисьма); 
		
		РегистрыСведений.ПротоколВыполненияЗадачПоПочте.ЗаписатьРезультатВыполненияПоСообщению(
				Сообщение, 
				Перечисления.РезультатыВыполненияЗадачПоПочте.КОбработке, 
				Задачи.ЗадачаИсполнителя.ПустаяСсылка());
		РезультатОбработки.Добавить(Сообщение.ИдентификаторПисьма);
	КонецЦикла;
	
	//Запуск обработки задач из почтовых сообщений     
	ИдентификаторФоновогоЗадания = Новый УникальныйИдентификатор;
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(ИдентификаторФоновогоЗадания);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Выполнение задач из почтовых сообщений'");

	ДлительныеОперации.ВыполнитьВФоне(, "РассылкаУведомленийПользователям.ВыполнитьЗадачиПоПочте",ПараметрыВыполнения);

    Возврат РезультатОбработки;

КонецФункции  

// Считывает записи с РС ПротоколВыполненияЗадачПоПочте, которые еще не были обработаны и выполняет задачи по ним, если это возможно
Процедура ВыполнитьЗадачиПоПочте(Параметр1 = Неопределено, Параметр2 = Неопределено) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	
	"ВЫБРАТЬ
	|	МАКСИМУМ(ПротоколВыполненияЗадачПоПочтеСрезПоследних.Период) КАК Период,
	|	ПротоколВыполненияЗадачПоПочтеСрезПоследних.ИдентификаторПисьма КАК ИдентификаторПисьма
	|ПОМЕСТИТЬ ВТ_ПоследниеЗаписиПоПисьмам
	|ИЗ
	|	РегистрСведений.ПротоколВыполненияЗадачПоПочте.СрезПоследних КАК ПротоколВыполненияЗадачПоПочтеСрезПоследних
	|
	|СГРУППИРОВАТЬ ПО
	|	ПротоколВыполненияЗадачПоПочтеСрезПоследних.ИдентификаторПисьма
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПротоколВыполненияЗадачПоПочтеСрезПоследних.Период КАК Период,
	|	ПротоколВыполненияЗадачПоПочтеСрезПоследних.ИдентификаторПисьма КАК ИдентификаторПисьма,
	|	ПротоколВыполненияЗадачПоПочтеСрезПоследних.РезультатВыполнения КАК РезультатВыполнения,
	|	ПротоколВыполненияЗадачПоПочтеСрезПоследних.Задача КАК Задача,
	|	ПротоколВыполненияЗадачПоПочтеСрезПоследних.ДатаОтправки КАК ДатаОтправки,
	|	ПротоколВыполненияЗадачПоПочтеСрезПоследних.Отправитель КАК Отправитель,
	|	ПротоколВыполненияЗадачПоПочтеСрезПоследних.ТемаПисьма КАК ТемаПисьма,
	|	ПротоколВыполненияЗадачПоПочтеСрезПоследних.ТекстПисьма КАК ТекстПисьма,
	|	ПротоколВыполненияЗадачПоПочтеСрезПоследних.ОписаниеОшибки КАК ОписаниеОшибки
	|ИЗ
	|	ВТ_ПоследниеЗаписиПоПисьмам КАК ВТ_ПоследниеЗаписиПоПисьмам
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколВыполненияЗадачПоПочте.СрезПоследних(
	|				,
	|				ИдентификаторПисьма В
	|					(ВЫБРАТЬ
	|						Т.ИдентификаторПисьма
	|					ИЗ
	|						ВТ_ПоследниеЗаписиПоПисьмам КАК Т)) КАК ПротоколВыполненияЗадачПоПочтеСрезПоследних
	|		ПО ВТ_ПоследниеЗаписиПоПисьмам.Период = ПротоколВыполненияЗадачПоПочтеСрезПоследних.Период
	|			И ВТ_ПоследниеЗаписиПоПисьмам.ИдентификаторПисьма = ПротоколВыполненияЗадачПоПочтеСрезПоследних.ИдентификаторПисьма
	|			И (ПротоколВыполненияЗадачПоПочтеСрезПоследних.РезультатВыполнения = ЗНАЧЕНИЕ(Перечисление.РезультатыВыполненияЗадачПоПочте.КОбработке))";
	
	
	РезультатЗапроса = Запрос.Выполнить();

	Сообщение = РезультатЗапроса.Выбрать();
	
	Пока Сообщение.Следующий() Цикл
		
		НачатьТранзакцию();
		
		ЗадачаСсылка = ПредопределенноеЗначение("Задача.ЗадачаИсполнителя.ПустаяСсылка");
		
		Попытка
			
			КодЯзыкаИсполнителя = ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка();
			
			// Определяем задачу и вариант ее исполнения по теме и тексту сообщения.
			ЗадачаИВариантВыполнения = ЗадачаИВариантВыполненияПоТемеСообщения(Сообщение.ТемаПисьма);   
			ЗадачаСсылка = ЗадачаИВариантВыполнения.Задача;
			ВариантВыполненияЗадачи = ЗадачаИВариантВыполнения.ВариантВыполнения; 
			
			Если Не ЗначениеЗаполнено(ЗадачаИВариантВыполнения.Задача) Тогда
				
				
				РегистрыСведений.ПротоколВыполненияЗадачПоПочте.ЗаписатьРезультатВыполненияПоСообщению(
					Сообщение,
					Перечисления.РезультатыВыполненияЗадачПоПочте.ВСообщенииНеУказанИдентификаторЗадачи,
					ЗадачаСсылка);
				
				ОтправитьУведомлениеОбОшибке(
					Сообщение,
					Перечисления.РезультатыВыполненияЗадачПоПочте.ВСообщенииНеУказанИдентификаторЗадачи,
					ЗадачаСсылка,
					КодЯзыкаИсполнителя);
				
				ЗафиксироватьТранзакцию();
				Продолжить;
				
			КонецЕсли;
			
			Если Не ОбщегоНазначения.СсылкаСуществует(ЗадачаИВариантВыполнения.Задача) Тогда
				
				РегистрыСведений.ПротоколВыполненияЗадачПоПочте.ЗаписатьРезультатВыполненияПоСообщению(
					Сообщение, Перечисления.РезультатыВыполненияЗадачПоПочте.ЗадачаНеНайдена,
					ЗадачаСсылка);
				
				ОтправитьУведомлениеОбОшибке(
					Сообщение,
					Перечисления.РезультатыВыполненияЗадачПоПочте.ЗадачаНеНайдена,
					ЗадачаСсылка,
					КодЯзыкаИсполнителя);
				
				ЗафиксироватьТранзакцию();
				Продолжить;
				
			КонецЕсли;
			
			Если ЗадачаИВариантВыполнения.ВариантВыполнения = Неопределено Тогда
				
				РегистрыСведений.ПротоколВыполненияЗадачПоПочте.ЗаписатьРезультатВыполненияПоСообщению(
					Сообщение,
					Перечисления.РезультатыВыполненияЗадачПоПочте.ВСообщенииНеУказанИдентификаторОтвета,
					ЗадачаСсылка);
				
				ОтправитьУведомлениеОбОшибке(
					Сообщение,
					Перечисления.РезультатыВыполненияЗадачПоПочте.ВСообщенииНеУказанИдентификаторОтвета,
					ЗадачаСсылка,
					КодЯзыкаИсполнителя);
				
				ЗафиксироватьТранзакцию();
				Продолжить;
				
			КонецЕсли;    
			
			// Получаем реквизиты задачи в базе.
			РеквизитыЗадачи = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗадачаСсылка, "Выполнена, ПометкаУдаления, ОбъектЗадачи, Состояние");
			
			//Проверяем активна ли задача         
			Если РеквизитыЗадачи.Выполнена или РеквизитыЗадачи.ПометкаУдаления Тогда
				
				РегистрыСведений.ПротоколВыполненияЗадачПоПочте.ЗаписатьРезультатВыполненияПоСообщению(
					Сообщение,
					Перечисления.РезультатыВыполненияЗадачПоПочте.ЗадачаНеАктивна,
					ЗадачаСсылка);
				
				ОтправитьУведомлениеОбОшибке(
					Сообщение,
					Перечисления.РезультатыВыполненияЗадачПоПочте.ЗадачаНеАктивна,
					ЗадачаСсылка,
					КодЯзыкаИсполнителя);
				
				ЗафиксироватьТранзакцию();
				Продолжить;
			
			КонецЕсли;
			
			// Проверяем соответствие результата выполнения и задачи.
			Если Не ПроверитьСоответствиеРезультатВыполненияИЗадачи(
				РеквизитыЗадачи.Состояние,
				ВариантВыполненияЗадачи, РеквизитыЗадачи.ОбъектЗадачи) Тогда
				
				РегистрыСведений.ПротоколВыполненияЗадачПоПочте.ЗаписатьРезультатВыполненияПоСообщению(
					Сообщение,
					Перечисления.РезультатыВыполненияЗадачПоПочте.ЗадачеНеСоответствуетЗначениеОтвета,
					ЗадачаСсылка);
				
				ОтправитьУведомлениеОбОшибке(
					Сообщение,
					Перечисления.РезультатыВыполненияЗадачПоПочте.ЗадачеНеСоответствуетЗначениеОтвета,
					ЗадачаСсылка,
					КодЯзыкаИсполнителя);
				
				ЗафиксироватьТранзакцию();
				Продолжить;
				
			КонецЕсли;
			
			// Определяем исполнителя задачи по отправителю сообщения.
			ПараметрыОтправителя = РазложитьПредставлениеАдресаЭлектроннойПочты(Сообщение.Отправитель);   
			
			ЗапросОтправитель = Новый Запрос;
			ЗапросОтправитель.Текст =			
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ПользователиКонтактнаяИнформация.Ссылка КАК Пользователь
			|ИЗ
			|	Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация 
			| ГДЕ
			|	ПользователиКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
			|	И ПользователиКонтактнаяИнформация.Представление ПОДОБНО &АдресЭП
			|	И НЕ ПользователиКонтактнаяИнформация.Ссылка.ПометкаУдаления";
	
			ЗапросОтправитель.УстановитьПараметр("АдресЭП", ПараметрыОтправителя.Адрес);
			ВыборкаОтправитель = ЗапросОтправитель.Выполнить().Выбрать();
			
			Если ВыборкаОтправитель.Следующий() Тогда
				ИсполнительЗадачиПоЭлАдресу = ВыборкаОтправитель.Пользователь;
			Иначе
				ИсполнительЗадачиПоЭлАдресу = Неопределено;
			КонецЕсли;
			
			Если ВыборкаОтправитель.Количество() > 1 Тогда
				
				РегистрыСведений.ПротоколВыполненияЗадачПоПочте.ЗаписатьРезультатВыполненияПоСообщению(
					Сообщение,
					Перечисления.РезультатыВыполненияЗадачПоПочте.ПоАдресуОтправителяНайденоНесколькоИсполнителей,
					ЗадачаСсылка);
				
				ОтправитьУведомлениеОбОшибке(
					Сообщение,
					Перечисления.РезультатыВыполненияЗадачПоПочте.ПоАдресуОтправителяНайденоНесколькоИсполнителей,
					ЗадачаСсылка,
					КодЯзыкаИсполнителя);
				
				ЗафиксироватьТранзакцию();
				Продолжить;
				
			ИначеЕсли ВыборкаОтправитель.Количество() = 0 Тогда
				
				РегистрыСведений.ПротоколВыполненияЗадачПоПочте.ЗаписатьРезультатВыполненияПоСообщению(
					Сообщение,
					Перечисления.РезультатыВыполненияЗадачПоПочте.ПоАдресуОтправителяНеНайденИсполнительЗадачи,
					ЗадачаСсылка);
				
				ОтправитьУведомлениеОбОшибке(
					Сообщение,
					Перечисления.РезультатыВыполненияЗадачПоПочте.ПоАдресуОтправителяНеНайденИсполнительЗадачи,
					ЗадачаСсылка,
					КодЯзыкаИсполнителя);
				
				ЗафиксироватьТранзакцию();
				Продолжить;
				
			КонецЕсли;
			
			//Если новое состояние - отклонен, то должна быть заполнена причина 
			Комментарий = "";
			// Евросиб US 90342 Рыбьяков К.А. 06.03.2026 ((
			Если ЗадачаИВариантВыполнения.ВариантВыполнения = Перечисления.СтатусыСогласования.ОтклоненоБезЗамечаний
				Или ЗадачаИВариантВыполнения.ВариантВыполнения = Перечисления.СтатусыСогласования.СогласованоСЗамечаниями Тогда
			//Если ЗадачаИВариантВыполнения.ВариантВыполнения = Перечисления.СтатусыСогласования.ОтклоненоБезЗамечаний Тогда
			// Евросиб Рыбьяков К.А. 06.03.2026 ))
				
				ТекстОшибкиРазбораПричины = "";
				МассивПодстрок = СтрРазделить(Сообщение.ТекстПисьма, ":");
				// Евросиб US 90342 Рыбьяков К.А. 05.03.2026 ((
				Если МассивПодстрок.Количество() >= 2 и (МассивПодстрок[0] = "Причина отказа" Или МассивПодстрок[0] = "Причина отклонения") Тогда
				//Если МассивПодстрок.Количество() >= 2 и МассивПодстрок[0] = "Причина отказа" Тогда
				// Евросиб Рыбьяков К.А. 05.03.2026 ))
				    МассивСтрок = СтрРазделить(СокрЛП(МассивПодстрок[1]), Символы.ПС);
					Если МассивСтрок.Количество() > 0 и НЕ МассивСтрок[0] = "" Тогда
					    Комментарий = МассивСтрок[0];
					Иначе
						Комментарий = "Согласование отклонено в Outlook. Причина отказа не указана. Обратитесь к согласующему";
						
					//	ТекстОшибкиРазбораПричины = "Не найдена причина отказа в ответном сообщении.
					//								|Необходимо повторить действия и указать причину отказа";
					КонецЕсли;
				Иначе	
					ТекстОшибкиРазбораПричины = "Не найдена причина отказа в ответном сообщении.
												|Необходимо повторить действия и указать причину отказа";	
				КонецЕсли;
				
				Если ТекстОшибкиРазбораПричины <> "" Тогда
					РегистрыСведений.ПротоколВыполненияЗадачПоПочте.ЗаписатьРезультатВыполненияПоСообщению(
						Сообщение,
						Перечисления.РезультатыВыполненияЗадачПоПочте.НеЗаполненаПричинаОтказа,
						ЗадачаСсылка);
					
					ОтправитьУведомлениеОбОшибке(
						Сообщение,
						Перечисления.РезультатыВыполненияЗадачПоПочте.НеЗаполненаПричинаОтказа,
						ЗадачаСсылка,
						КодЯзыкаИсполнителя,
						ТекстОшибкиРазбораПричины);
					
					ЗафиксироватьТранзакцию();
					Продолжить;
				КонецЕсли; 
			Иначе
				Комментарий = "Согласовано по эл. почте"; 			
			КонецЕсли;
			
			РеквизитыЗадачи.Вставить("Комментарий", Комментарий);
			// определеяем по типу документа
			ЗаполнитьЗначенияПараметровСогласованияЗаявки(РеквизитыЗадачи);
			
			//структура результата универсальная 
			РезультатПроверки = ПровериьВозможностьВыполнения(РеквизитыЗадачи);			
			
			Если РезультатПроверки.ЗакрытиеЗадачиНевозможно Тогда							
				РегистрыСведений.ПротоколВыполненияЗадачПоПочте.ЗаписатьРезультатВыполненияПоСообщению(
					Сообщение,
					Перечисления.РезультатыВыполненияЗадачПоПочте.Ошибка,
					ЗадачаСсылка,
					РезультатПроверки.Описание);    
					
				ОтправитьУведомлениеОбОшибке(
					Сообщение,
					Перечисления.РезультатыВыполненияЗадачПоПочте.Ошибка,
					ЗадачаСсылка,
					КодЯзыкаИсполнителя, 
					РезультатПроверки.Описание);
				
				ЗафиксироватьТранзакцию();
				Продолжить;
			КонецЕсли;	
				
			Если РеквизитыЗадачи.ПометкаНаУдалениеОбъектаЗадачи Тогда
				
				РегистрыСведений.ПротоколВыполненияЗадачПоПочте.ЗаписатьРезультатВыполненияПоСообщению(
					Сообщение,
					Перечисления.РезультатыВыполненияЗадачПоПочте.Ошибка,
					ЗадачаСсылка,
					"Документ помечен на удаление");    
					
				ОтправитьУведомлениеОбОшибке(
					Сообщение,
					Перечисления.РезультатыВыполненияЗадачПоПочте.Ошибка,
					ЗадачаСсылка,
					КодЯзыкаИсполнителя, 
					"Документ помечен на удаление");
                ЗафиксироватьТранзакцию();
				Продолжить;

			Иначе   
				ЗадачаВыполнена = Ложь; 
				ОтметитьВыполнениеЗадачПоСсылке(РеквизитыЗадачи.ОбъектЗадачи, РеквизитыЗадачи.Состояние, ИсполнительЗадачиПоЭлАдресу, Комментарий, ВариантВыполненияЗадачи); 
				ЗадачаВыполнена = Истина;
				
			КонецЕсли;
				
				Если ЗадачаВыполнена Тогда
					РегистрыСведений.ПротоколВыполненияЗадачПоПочте.ЗаписатьРезультатВыполненияПоСообщению(
						Сообщение, 
						Перечисления.РезультатыВыполненияЗадачПоПочте.Выполнена,
						ЗадачаСсылка,
						Строка(ВариантВыполненияЗадачи)); 
						
				Иначе
				    РегистрыСведений.ПротоколВыполненияЗадачПоПочте.ЗаписатьРезультатВыполненияПоСообщению(
						Сообщение, 
						Перечисления.РезультатыВыполненияЗадачПоПочте.Ошибка,
						ЗадачаСсылка,
						"Произошла ошибка при согласовании заявки (реестра)"); 
						
					ОтправитьУведомлениеОбОшибке(
					Сообщение,
					Перечисления.РезультатыВыполненияЗадачПоПочте.Ошибка,
					ЗадачаСсылка,
					КодЯзыкаИсполнителя, 
					"Произошла ошибка при согласовании заявки (реестра)");
					
					Если ТранзакцияАктивна() Тогда
						ОтменитьТранзакцию();
					КонецЕсли;
					
					Продолжить;						
				КонецЕсли;							
			ЗафиксироватьТранзакцию();
			
		Исключение
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;

			РегистрыСведений.ПротоколВыполненияЗадачПоПочте.ЗаписатьРезультатВыполненияПоСообщению(
				Сообщение, 
				Перечисления.РезультатыВыполненияЗадачПоПочте.Ошибка,
				ЗадачаСсылка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));  
				
			ОтправитьУведомлениеОбОшибке(
					Сообщение,
					Перечисления.РезультатыВыполненияЗадачПоПочте.Ошибка,
					ЗадачаСсылка,
					КодЯзыкаИсполнителя, 
					"Не удалось выполнить " + РеквизитыЗадачи.Состояние + ". Подробности в журнале регистрации.");
			Продолжить;
		КонецПопытки;
	
	КонецЦикла; 
	
	РегистрыСведений.ПротоколВыполненияЗадачПоПочте.ОчиститьРегистрОтУстаревшихЗаписей();

КонецПроцедуры 

// Заполняет текущие значения согласования заявки или реестра (объекта задачи)
//
// Параметры:
//  РеквизитыЗадачи  - Структура - структура, содержащая реквизиты задачи к выполнению
//
Процедура ЗаполнитьЗначенияПараметровСогласованияЗаявки(РеквизитыЗадачи)
	
	Состояние = РеквизитыЗадачи.Состояние;	
	ПометкаНаУдаление = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыЗадачи.ОбъектЗадачи, "ПометкаУдаления");
	РеквизитыЗадачи.Вставить("ПометкаНаУдалениеОбъектаЗадачи", ПометкаНаУдаление);
	
	Если ТипЗнч(РеквизитыЗадачи.ОбъектЗадачи) = Тип("ДокументСсылка.РеестрПлатежей") Тогда 
		ТаблицаСостояний = РеквизитыЗадачи.ОбъектЗадачи.Состояния;
		СтруктураПоиска = Новый Структура("Состояние",Состояние);
		НайденнаяСтрока = ТаблицаСостояний.НайтиСтроки(СтруктураПоиска);
		
		Если НайденнаяСтрока.Количество()>0 Тогда
			ТекущееСостояние = НайденнаяСтрока[0].Состояние;
			ТекущийСтатусСогласования = НайденнаяСтрока[0].СтатусСогласования;
			СостояниеДокумента = РегистрыСведений.СтатусыОбъектов.ПолучитьПоследнее(ТекущаяДата(), Новый Структура("Объект", РеквизитыЗадачи.ОбъектЗадачи));
			РеквизитыЗадачи.Вставить("ТекущееСостояние", ТекущееСостояние);
			РеквизитыЗадачи.Вставить("ТекущийСтатусСогласования", ТекущийСтатусСогласования); 
			СостояниеДокумента = СостояниеДокумента.Статус;
			РезультатВыполненияСостояния = НайденнаяСтрока[0].Статус;
			//РегистрыСведений.СтатусыОбъектов.ПолучитьПоследнееЗначениеСтатуса(РеквизитыЗадачи.ОбъектЗадачи).Статус;
			РеквизитыЗадачи.Вставить("СостояниеДокумента", СостояниеДокумента);
			РеквизитыЗадачи.Вставить("РезультатВыполненияСостояния", РезультатВыполненияСостояния);
		Иначе	
			РеквизитыЗадачи.Вставить("ТекущееСостояние", Неопределено);
			РеквизитыЗадачи.Вставить("ТекущийСтатусСогласования", Неопределено);
			РеквизитыЗадачи.Вставить("СостояниеДокумента", Неопределено);
			РеквизитыЗадачи.Вставить("РезультатВыполненияСостояния", Неопределено);
		КонецЕсли;
	// Евросиб US 90342 TA 90342 Рыбьяков К.А. 13.02.2026 ((
	ИначеЕсли ТипЗнч(РеквизитыЗадачи.ОбъектЗадачи) = Тип("ДокументСсылка.РеестрСпециальныхСтавок") Тогда
		ТаблицаСостояний = РеквизитыЗадачи.ОбъектЗадачи.Состояния;
		СтруктураПоиска = Новый Структура("Состояние",Состояние);
		НайденнаяСтрока = ТаблицаСостояний.НайтиСтроки(СтруктураПоиска);
		
		Если НайденнаяСтрока.Количество()>0 Тогда
			ТекущееСостояние = НайденнаяСтрока[0].Состояние;
			ТекущийСтатусСогласования = НайденнаяСтрока[0].СтатусСогласования;
			СостояниеДокумента = РегистрыСведений.СтатусыОбъектов.ПолучитьПоследнее(ТекущаяДата(), Новый Структура("Объект", РеквизитыЗадачи.ОбъектЗадачи));
			РеквизитыЗадачи.Вставить("ТекущееСостояние", ТекущееСостояние);
			РеквизитыЗадачи.Вставить("ТекущийСтатусСогласования", ТекущийСтатусСогласования); 
			СостояниеДокумента = СостояниеДокумента.Статус;
			РезультатВыполненияСостояния = НайденнаяСтрока[0].Статус;
			РеквизитыЗадачи.Вставить("СостояниеДокумента", СостояниеДокумента);
			РеквизитыЗадачи.Вставить("РезультатВыполненияСостояния", РезультатВыполненияСостояния);
		Иначе	
			РеквизитыЗадачи.Вставить("ТекущееСостояние", Неопределено);
			РеквизитыЗадачи.Вставить("ТекущийСтатусСогласования", Неопределено);
			РеквизитыЗадачи.Вставить("СостояниеДокумента", Неопределено);
			РеквизитыЗадачи.Вставить("РезультатВыполненияСостояния", Неопределено);
		КонецЕсли;
	// Евросиб Рыбьяков К.А. 13.02.2026 ))
	Иначе	
		РеквизитыЗадачи.Вставить("ТекущееСостояние", Неопределено);
		РеквизитыЗадачи.Вставить("ТекущийСтатусСогласования", Неопределено);
		РеквизитыЗадачи.Вставить("СостояниеДокумента", Неопределено);		
		РеквизитыЗадачи.Вставить("РезультатВыполненияСостояния", Неопределено);
	КонецЕсли;
	
КонецПроцедуры 


// Принимает строку почтового адреса в виде
// "name <addr@dom>"
// Возвращает:
// Результат (Структура)
// - Адрес (Строка) - addr@dom
// - ОтображаемоеИмя (Строка) - name
// - Пользователь (Строка)-  addr
// - Домен (Строка) - dom
//
Функция РазложитьПредставлениеАдресаЭлектроннойПочты(Знач АдресЭлектроннойПочтыСтр) Экспорт
	
	Результат = Новый Структура("Адрес, ОтображаемоеИмя, Пользователь, Домен, ФИО", "", "", "", "", "");
	
	АдресЭлектроннойПочтыСтр = СокрЛП(АдресЭлектроннойПочтыСтр);
	
	Поз = Найти(АдресЭлектроннойПочтыСтр, "@");
	Если Поз = 0 Тогда
		Результат.ФИО = АдресЭлектроннойПочтыСтр;
		Возврат Результат;
	КонецЕсли;
	
	СтрокаАдреса = "";
	ПозицияПервогоСимволаАдреса = 0;
	ПозицияПоследнегоСимволаАдреса = 0;
	
	// Идем влево от @
	Для Индекс = 0 По Поз - 1 Цикл
		
		ИндексВСтроке = Поз - Индекс;
		СтрокаАдресаПроверка = Сред(АдресЭлектроннойПочтыСтр, ИндексВСтроке, 1) + СтрокаАдреса;
		
		Если СтрокаСодержитТолькоДопустимыеСимволы(СтрокаАдресаПроверка) Тогда
			СтрокаАдреса = СтрокаАдресаПроверка;
			ПозицияПервогоСимволаАдреса = ИндексВСтроке;
		Иначе
			Прервать;
		КонецЕсли;	
		
	КонецЦикла;	
	
	// Идем вправо от @
	Для ИндексВСтроке = Поз + 1 По СтрДлина(АдресЭлектроннойПочтыСтр) Цикл
		
		СтрокаАдресаПроверка = СтрокаАдреса + Сред(АдресЭлектроннойПочтыСтр, ИндексВСтроке, 1);
		
		Если СтрокаСодержитТолькоДопустимыеСимволы(СтрокаАдресаПроверка) Тогда
			СтрокаАдреса = СтрокаАдресаПроверка;
			ПозицияПоследнегоСимволаАдреса = ИндексВСтроке;
		Иначе
			Прервать;
		КонецЕсли;	
		
	КонецЦикла;	
	
	Результат.Адрес = СтрокаАдреса;
	// слева от адреса берем представление
	Результат.ОтображаемоеИмя = Лев(АдресЭлектроннойПочтыСтр, ПозицияПервогоСимволаАдреса - 2);
	Результат.ОтображаемоеИмя = СокрЛП(Результат.ОтображаемоеИмя);
	
	Если Не ЭтоАдресЭлектроннойПочты(Результат.Адрес) Тогда
		Результат.Адрес = "";
	Иначе
		Поз = Найти(Результат.Адрес, "@");
		Результат.Пользователь = Лев(Результат.Адрес, Поз - 1);
		Результат.Домен = Сред(Результат.Адрес, Поз + 1);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает задачу и вариант выполнения по теме сообщения.
//
// Параметры:
//  ТемаСообщения - Строка - тема сообщения.
//
// Возвращаемое значение:
//  Струкутра:
//   * Задача - ЗадачаСсылка.ЗадачаИсполнителя
//   * ВариантВыполнения - ПеречисленияСсылка.ВариантыВыполненияПроцессовИЗадач
//
Функция ЗадачаИВариантВыполненияПоТемеСообщения(ТемаСообщения)
	
	Результат = Новый Структура("Задача, ВариантВыполнения");
	
	Если Не ЗначениеЗаполнено(ТемаСообщения) Тогда
		Возврат Результат;
	КонецЕсли;
	
	//СлужебнаяИнформацияСтрокой = Прав(ТемаСообщения, 39);
	
	СлужебнаяИнформация = СтрРазделить(ТемаСообщения, "$", Ложь);
	
	КоличествоСлужебнойИнформации = СлужебнаяИнформация.Количество();
	Если КоличествоСлужебнойИнформации < 4 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИдентификаторЗадачиСтрокой = СлужебнаяИнформация[СлужебнаяИнформация.Количество() - 3];
	НомерОтвета = СлужебнаяИнформация[СлужебнаяИнформация.Количество() - 2];
	
	ИдентификаторЗадачи = Неопределено;
	Попытка
		ИдентификаторЗадачи = Новый УникальныйИдентификатор(ИдентификаторЗадачиСтрокой);
	Исключение
		// Ничего не делаем.
		// Считаем, что не удалось определить ссылку на задачу по теме сообщения.
		// При необходимости этот факт будет зафиксирован отдельно в протоколе
		// выполнения задач по почте в вызывающем коде.
	КонецПопытки;
	Если ЗначениеЗаполнено(ИдентификаторЗадачи) Тогда
		Результат.Задача = Задачи.ЗадачаИсполнителя.ПолучитьСсылку(ИдентификаторЗадачи);
	КонецЕсли;
	
	Результат.ВариантВыполнения = ВариантВыполненияПоПоЧисловомуИдентификатору(НомерОтвета);
	
	Возврат Результат;
	
КонецФункции

// Отправляем уведомление об ошибке, возникшей при обработке сообщения.
//
// Параметры:
//  Сообщение - Структура - см. ЛегкаяПочтаКлиентСервер.СформироватьСтруктуруСообщения
//  РезультатВыполненияЗадачиПоПочте - ПеречислениеСсылка.РезультатВыполненияЗадачиПоПочте - результат обработки сообщения.
//  КодЯзыка - Строка - код языки для формирования текстов уведомления.
//  Описание - Строка - дополнительное описание ошибки.
//
Процедура ОтправитьУведомлениеОбОшибке(Сообщение,
	РезультатВыполненияЗадачиПоПочте,
	Задача,
	КодЯзыка,
	Описание = "")
	
	Если ТипЗнч(РезультатВыполненияЗадачиПоПочте) <>
		Тип("ПеречислениеСсылка.РезультатыВыполненияЗадачПоПочте") Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Сообщение.Отправитель) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ТипЗнч(Задача) <> Тип("ЗадачаСсылка.ЗадачаИсполнителя") Тогда
		Возврат;
	КонецЕсли;

	ТемаУведомления = НСтр("ru = 'Ошибка исполнения задачи по почте: '", КодЯзыка);

	Если ЗначениеЗаполнено(Задача) и ЗначениеЗаполнено(Задача.Состояние) Тогда
		ТемаУведомления = ТемаУведомления + Строка(Задача.Состояние);
	Иначе
		ТемаУведомления = ТемаУведомления + Строка(Сообщение.ТемаПисьма);
	КонецЕсли;
	
	Если РезультатВыполненияЗадачиПоПочте =
		Перечисления.РезультатыВыполненияЗадачПоПочте.ЗадачаНеНайдена Тогда
		
		ТекстУведомления = 
			НСтр("ru = 'При обработке письма об исполнении задачи возникла ошибка.
			|Не найдена задача в базе данных.
			|Обратитесь к автору задачи или администратору.'", КодЯзыка);
			
	ИначеЕсли РезультатВыполненияЗадачиПоПочте =
			Перечисления.РезультатыВыполненияЗадачПоПочте.ПоАдресуОтправителяНайденоНесколькоИсполнителей
		ИЛИ РезультатВыполненияЗадачиПоПочте =
			Перечисления.РезультатыВыполненияЗадачПоПочте.ПоАдресуОтправителяНеНайденИсполнительЗадачи Тогда
		
		ТекстУведомления = 
			НСтр("ru = 'При обработке письма об исполнении задачи возникла ошибка.
			|По вашему адресу не удалось определить исполнителя задачи.
			|Обратитесь к администратору.'", КодЯзыка);
			
	ИначеЕсли РезультатВыполненияЗадачиПоПочте =
			Перечисления.РезультатыВыполненияЗадачПоПочте.ДляЗадачиОпределенДругойИсполнитель Тогда
			
		ТекстУведомления = 
			НСтр("ru = 'При обработке письма об исполнении задачи возникла ошибка.
			|Для задачи определен другой исполнитель.
			|Обратитесь к автору задачи.'", КодЯзыка);
		
	ИначеЕсли РезультатВыполненияЗадачиПоПочте =
			Перечисления.РезультатыВыполненияЗадачПоПочте.ЗадачаНеАктивна Тогда
			
		ТекстУведомления = 
			НСтр("ru = 'При обработке письма об исполнении задачи возникла ошибка.
			|Задача не активна и могла быть выполнена другим исполнителем.'", КодЯзыка);
		
	ИначеЕсли Описание <> "" Тогда 
		
		ТекстУведомления = Описание;
		
	Иначе
		
		ТекстУведомления = 
			НСтр("ru = 'При обработке письма об исполнении задачи возникла ошибка.
			|Возможно в вашем письме (ответе) отсутствовал текст служебной информации
			|или ответное письмо было сформировано не по ссылкам в уведомлении.
			|Попробуйте исполнить задачу еще раз.'", КодЯзыка);
		
	КонецЕсли; 
	
	ПараметрыПисьма = Новый Структура;
	ПараметрыПисьма.Вставить("Тема", ТемаУведомления);
	ПараметрыПисьма.Вставить("Тело", ТекстУведомления);
	ПараметрыПисьма.Вставить("Кому", Сообщение.Отправитель);
	ПараметрыПисьма.Вставить("ТипТекста", "ПростойТекст");     
	ПараметрыПисьма.Вставить("ТипТекста", "HTML");
//	ПараметрыПисьма.Вставить("ПоляЗаголовка", ПоляЗаголовка);
	
	ОтправитьСообщение(АдресЭлектроннойПочтыОтправителя(), ПараметрыПисьма);
	
КонецПроцедуры

Функция СтрокаСодержитТолькоДопустимыеСимволы(АдресЭлектроннойПочты)
	
	ДопустимыеСимволы = "-.0123456789@ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz";
	Для НомерСимвола = 1 По СтрДлина(АдресЭлектроннойПочты) Цикл
		Если Найти(ДопустимыеСимволы, Сред(АдресЭлектроннойПочты, НомерСимвола, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла; 
	
	Возврат Истина;
	
КонецФункции

// Проверяет строку на формат адреса электронной почты
// проверка не точная но основные элементы на месте
//
Функция ЭтоАдресЭлектроннойПочты(АдресЭлектроннойПочты) Экспорт
	
	Поз = Найти(АдресЭлектроннойПочты, "@");
	Если Поз = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрЧислоВхождений(АдресЭлектроннойПочты, "@") <> 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Прав(АдресЭлектроннойПочты, 1) = "."
		Или Лев(АдресЭлектроннойПочты, 1) = "." Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Найти(АдресЭлектроннойПочты, "..") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДопустимыеСимволы = "-.0123456789@ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz";
	Для НомерСимвола = 1 По СтрДлина(АдресЭлектроннойПочты) Цикл
		Если Найти(ДопустимыеСимволы, Сред(АдресЭлектроннойПочты, НомерСимвола, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Пользователь = Лев(АдресЭлектроннойПочты, Поз - 1);
	Если СтрДлина(Пользователь) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Сервер = Сред(АдресЭлектроннойПочты, Поз + 1);
	Если СтрДлина(Сервер) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Поз = Найти(Сервер, ".");
	Если Поз = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Проверяет соответствие результата выполнения и задачи.
//
// Параметры:
//  ЗадачаСсылка - ЗадачаСсылка.ЗадачаИсполнителя - ссылка на задачу.
//  РезультатВыполнения - ПеречислениеСсылка.ВариантыВыполненияПроцессовИЗадач - результат выполнения задачи.
//
// Возвращаемое значение:
//  Булево:
//   * Истина - если результат допустим для задачи.
//   * Ложь - если результат не допустим.
//
Функция ПроверитьСоответствиеРезультатВыполненияИЗадачи(ЗадачаСсылка, РезультатВыполнения, Документ)
	
	Результат = Истина;
	
	ВозможныеВариантыВыполнения = ПолучитьСписокВариантовВыполненияЗадачи(ЗадачаСсылка, Документ);
	
	Если ВозможныеВариантыВыполнения.СписокВариантовОтветов.НайтиПоЗначению(
			РезультатВыполнения) = Неопределено Тогда
			
		Результат = Ложь;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции  

 Функция ВариантВыполненияПоПоЧисловомуИдентификатору(ИдентификаторОтвета)
	
	Если ИдентификаторОтвета = "" Тогда
		ВариантВыполнения = Неопределено;
	ИначеЕсли ИдентификаторОтвета = "1" Тогда
		ВариантВыполнения = Перечисления.СтатусыСогласования.СогласованоБезЗамечаний;
	ИначеЕсли ИдентификаторОтвета = "2" Тогда
		ВариантВыполнения = Перечисления.СтатусыСогласования.ОтклоненоБезЗамечаний;
	// Евросиб US 90342 Рыбьяков К.А. 05.03.2026 ((
	ИначеЕсли ИдентификаторОтвета = "3" Тогда
		ВариантВыполнения = Перечисления.СтатусыСогласования.СогласованоСЗамечаниями;
	// Евросиб Рыбьяков К.А. 05.03.2026 ))
	Иначе
		ВариантВыполнения = Перечисления.СтатусыСогласования.ПустаяСсылка();
	КонецЕсли;
	
	Возврат ВариантВыполнения;
	
КонецФункции

Функция ПровериьВозможностьВыполнения(РеквизитыЗадачи)

	РезультатВыполнения = Новый Структура("ЗакрытиеЗадачиНевозможно, Описание");	
	Если ТипЗнч(РеквизитыЗадачи.ОбъектЗадачи) =	Тип("ДокументСсылка.РеестрПлатежей") Тогда		
		ЗакрытиеЗадачиНевозможно = Ложь;
		Описание = "";
		Если РеквизитыЗадачи.РезультатВыполненияСостояния = Перечисления.СтатусыЭтапов.Выполнен Тогда
			ЗакрытиеЗадачиНевозможно = Истина;
			Описание = "Задача уже выполнена.";
		ИначеЕсли РеквизитыЗадачи.СостояниеДокумента = Справочники.СтатусыДокументов.РеестрУтвержден
			и РеквизитыЗадачи.Состояние = Справочники.Состояния.Согласование Тогда 
			ЗакрытиеЗадачиНевозможно = Истина;
			Описание = "Реестр уже был утвержден, повторное согласование невозможно."; 
		ИначеЕсли (РеквизитыЗадачи.СостояниеДокумента = Справочники.СтатусыДокументов.РеестрНеСогласован
			или РеквизитыЗадачи.СостояниеДокумента = Справочники.СтатусыДокументов.РеестрНеУтвержден) Тогда 
			ЗакрытиеЗадачиНевозможно = Истина;
			Описание = "Реестр был не утвержден или не согласован, выполнение согласования/утверждения невозможно.";
			
		ИначеЕсли РеквизитыЗадачи.СостояниеДокумента = Справочники.СтатусыДокументов.РеестрПодготовлен Тогда 
			ЗакрытиеЗадачиНевозможно = Истина;
			Описание = "Реестр находится в статусе ""подготовлен"", выполнение согласования/утверждения невозможно.";

		КонецЕсли;
	// Евросиб US 90342 TA 90342 Рыбьяков К.А. 13.02.2026 ((
	ИначеЕсли ТипЗнч(РеквизитыЗадачи.ОбъектЗадачи) =Тип("ДокументСсылка.РеестрСпециальныхСтавок") Тогда
		ЗакрытиеЗадачиНевозможно = Ложь;
		Описание = "";
		Если РеквизитыЗадачи.РезультатВыполненияСостояния = Перечисления.СтатусыЭтапов.Выполнен Тогда
			ЗакрытиеЗадачиНевозможно = Истина;
			Описание = "Задача уже выполнена.";
		ИначеЕсли (РеквизитыЗадачи.СостояниеДокумента = Перечисления.СтатусыСогласования.ОтклоненоБезЗамечаний
			Или РеквизитыЗадачи.СостояниеДокумента = Перечисления.СтатусыСогласования.ОтклоненоСЗамечаниями) Тогда
			ЗакрытиеЗадачиНевозможно = Истина;
			Описание = "Документ специальные ставки был не отклонен, выполнение согласования/утверждения невозможно.";
		ИначеЕсли РеквизитыЗадачи.СостояниеДокумента = Перечисления.СтатусыСогласования.Планируется Тогда
			ЗакрытиеЗадачиНевозможно = Истина;
			Описание = "Документ специальные ставки находится в статусе ""Планируется"", выполнение согласования/утверждения невозможно.";
		КонецЕсли;
	// Евросиб Рыбьяков К.А. 13.02.2026 ))
	КонецЕсли;
	РезультатВыполнения.ЗакрытиеЗадачиНевозможно = ЗакрытиеЗадачиНевозможно;
	РезультатВыполнения.Описание = Описание;
		
	Возврат РезультатВыполнения;
	
КонецФункции 

Процедура ОтметитьВыполнениеЗадачПоСсылке(Ссылка, Состояние, Исполнитель, Комментарий, СтатусСогласования) Экспорт
	
	Объект = Ссылка.ПолучитьОбъект();
	СтатусВыполнен = Перечисления.СтатусыЭтапов.Выполнен;
	СтатусОтклонен = Перечисления.СтатусыЭтапов.Отклонен;
	
	ДатаВыполнения = ТекущаяДата();
	Для Каждого СтрокаТЧ Из Объект.Состояния Цикл
		Если Состояние = СтрокаТЧ.Состояние Тогда
			СтрокаТЧ.Статус = СтатусВыполнен;
			СтрокаТЧ.СтатусСогласования = СтатусСогласования ;
			СтрокаТЧ.Исполнитель = Исполнитель;
			СтрокаТЧ.ЗавершениеРаботы = ДатаВыполнения;
			СтрокаТЧ.Комментарий = Комментарий;
		КонецЕсли;
	КонецЦикла; 
	
	// Евросиб US 90342 TA 90342 Рыбьяков К.А. 13.02.2026 ((
	Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.РеестрСпециальныхСтавок") Тогда
		// для этого документа не заполняем
	Иначе
		Объект.Комментарий = Комментарий;
	КонецЕсли;
	//Объект.Комментарий = Комментарий;
	// Евросиб Рыбьяков К.А. 24.03.2026 ))
	
	Если Объект.Модифицированность() Тогда
		Объект.Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;
	
КонецПроцедуры

