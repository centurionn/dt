Функция ПолучитьСписокВариантовВыполненияЗадачи(Состояние, Документ)
	
	ВозможныеВариантыВыполнения = Новый Структура;
	ВозможныеВариантыВыполнения.Вставить("ИспользоватьКомментарий", Ложь);  
	
	СписокВариантовОтветов = Новый СписокЗначений;
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.РеестрПлатежей") Тогда
		Если Состояние = Справочники.Состояния.Согласование Тогда
			СписокВариантовОтветов.Добавить(Перечисления.СтатусыСогласования.СогласованоБезЗамечаний, "Согласовать");
			СписокВариантовОтветов.Добавить(Перечисления.СтатусыСогласования.ОтклоненоБезЗамечаний, "Отклонить");
		ИначеЕсли Состояние = Справочники.Состояния.Утверждение Тогда
			СписокВариантовОтветов.Добавить(Перечисления.СтатусыСогласования.СогласованоБезЗамечаний, "Утвердить");
			СписокВариантовОтветов.Добавить(Перечисления.СтатусыСогласования.ОтклоненоБезЗамечаний, "Отклонить");
		КонецЕсли;
		// Евросиб US 90342 Рыбьяков К.А. 14.12.2025 ((
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.РеестрСпециальныхСтавок") Тогда
		СписокВариантовОтветов.Добавить(Перечисления.СтатусыСогласования.СогласованоБезЗамечаний, "Согласован");
		//СписокВариантовОтветов.Добавить(Перечисления.СтатусыСогласования.СогласованоСЗамечаниями, "Согласован с замечаниями");
		//СписокВариантовОтветов.Добавить(Перечисления.СтатусыСогласования.СогласованСКомментариями, "Согласован с комментариями");
		СписокВариантовОтветов.Добавить(Перечисления.СтатусыСогласования.ОтклоненоБезЗамечаний, "Не согласован");
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 14.12.2025 ))
	
	ВозможныеВариантыВыполнения.Вставить("СписокВариантовОтветов", СписокВариантовОтветов);
	
	Возврат ВозможныеВариантыВыполнения;
	
КонецФункции

Функция ПолучитьОтветыВВидеСсылокMailto(Задача, Документ) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Текст", "");
	Результат.Вставить("КоличествоОтветов", 0);
	
	ВариантыОтветовДляВыполненияЗадачи = ПолучитьСписокВариантовВыполненияЗадачи(Задача.Состояние, Документ);
	
	ВозможныеВариантыВыполнения = ВариантыОтветовДляВыполненияЗадачи.СписокВариантовОтветов;
	
	Результат.КоличествоОтветов = ВозможныеВариантыВыполнения.Количество();
		
	АдресЭлектроннойПочты = АдресЭлектроннойПочтыОтправителя();
	
	КодЯзыкаПолучателя = ТекущийКодЛокализации();
	
	ТекстОтвета = "";
	Разделитель = "";
	
	Для Каждого ВариантОтвета Из ВозможныеВариантыВыполнения Цикл
		
		ТемаПисьма = ТемаСообщенияДляССылкиMailTo(
			Задача,ВариантОтвета.Значение, ВариантОтвета.Представление);
		ТекстОтветаДляРезультата = ТекстОтвета; 
		
		Если ВариантОтвета.Представление = "Отклонить" Тогда
			ТекстОтветаДляРезультата = "Причина отказа:";
		// Евросиб US 90342 Рыбьяков К.А. 15.12.2025 ((
		ИначеЕсли ВариантОтвета.Представление = "Согласован с замечаниями"
				Или ВариантОтвета.Представление = "Согласован с комментариями" 
				Или ВариантОтвета.Представление = "Не согласован" Тогда
			ТекстОтветаДляРезультата = "Причина отклонения:";
		// Евросиб Рыбьяков К.А. 15.12.2025 ))
		КонецЕсли;
		
		СсылкаНаОтвет = СформироватьСсылкуMailto(
			АдресЭлектроннойПочты,,,
			ТемаПисьма,
			ТекстОтветаДляРезультата,
			ПредопределенноеЗначение("Перечисление.ТипыТекстовЭлектронныхПисем.HTML"),
			ВариантОтвета.Представление + "...");
			
		Результат.Текст = Результат.Текст + Разделитель + СсылкаНаОтвет;
		
		Разделитель = " / ";
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции  

Функция ТемаСообщенияДляССылкиMailTo(Задача, ВариантВыполнения, ПредставлениеВариантаВыполнения)

	// Формируем служебную информацию.
	СлужебнаяИнформация = Строка("$" + Задача.УникальныйИдентификатор()
		+ "$" + ЧисловойИдентификаторВариантаВыполнения(ВариантВыполнения) + "$" + СтрокаСоединенияИнформационнойБазы());
    // Формируем служебную информацию.

	ТемаПисьма = ПредставлениеВариантаВыполнения + ": " + Строка(Задача.ОбъектЗадачи);    
	Если ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована  Тогда
		ТемаПисьма = "ТЕСТИРОВАНИЕ - " + ТемаПисьма;
	КонецЕсли;
	
	Возврат ТемаПисьма + СлужебнаяИнформация;
	
КонецФункции  

Функция СформироватьТекстУведомления(Задача, Документ, Тема)
	
	//ОбъектУведомления = Задача
	
	СсылкиОтветов = ПолучитьОтветыВВидеСсылокMailto(Задача, Документ);
	
	Если СсылкиОтветов.КоличествоОтветов > 1 Тогда
		Комментарий = НСтр("ru = 'Не отвечайте на это письмо. Для выполнения задачи нажмите на одну из ссылок.'");
	ИначеЕсли СсылкиОтветов.КоличествоОтветов = 1 Тогда
		Комментарий = НСтр("ru = 'Не отвечайте на это письмо. Для выполнения задачи нажмите на ссылку.'");
	КонецЕсли;
	
	ТекстПисьма = "";	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.РеестрПлатежей") Тогда
		СформироватьТекстУведомленияРеестрПлатежей(ТекстПисьма, Задача, Документ, Комментарий, СсылкиОтветов, Тема);
	// Евросиб US 90342 Рыбьяков К.А. 14.12.2025 ((
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.РеестрСпециальныхСтавок") Тогда
		СформироватьТекстУведомленияРеестрСпециальныхСтавок(ТекстПисьма, Задача, Документ, Комментарий, СсылкиОтветов, Тема);
	// Евросиб Рыбьяков К.А. 14.12.2025 ))
	КонецЕсли;
	
	Возврат ТекстПисьма;
	
КонецФункции      

Процедура ДобавитьУведомлениеПоЗадаче(ОбъектУведомления, ПолучательУведомления, СформированныеУведомления, Документ) Экспорт
	

	АдресПолучателя = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ПолучательУведомления, Справочники.ВидыКонтактнойИнформации.EmailПользователя);	
  
	Если АдресПолучателя = "" Тогда 
		ТекстОшибки = СтрШаблон(
		НСтр("ru = 'Уведомление не отправлено, так как не указан почтовый адрес у пользователя %1.'",
				ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
				Строка(ПолучательУведомления)); 
		ЗаписьЖурналаРегистрации(
				"Отправка уведомлений о согласовании заявки по почте",
				УровеньЖурналаРегистрации.Предупреждение,,,
				ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ДанныеУведомления = ДанныеУведомления();
	
	//ДанныеУведомления.ТемаУведомления = Строка(ОбъектУведомления.Состояние) + " реестра платежей";
	
	ДанныеУведомления.ТекстУведомления = СформироватьТекстУведомления(ОбъектУведомления, Документ, ДанныеУведомления.ТемаУведомления);
	
	ИнформацияОбОшибке = ИнформацияОбОшибке();
	ПодробноеПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
	КомментарийЖурналаРегистрации = СтрШаблон(
		"%1:
		|%2",
		НСтр("ru = 'Не удалось сформировать файлы для уведомления'",
		ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
		ПодробноеПредставлениеОшибки);
	
	ЗаписьЖурналаРегистрации(
		"Отправка уведомлений о согласовании заявки по почте",
		УровеньЖурналаРегистрации.Ошибка,,,
		КомментарийЖурналаРегистрации);
	

	СформированноеУведомление = СформированныеУведомления.Добавить(); 
	СформированноеУведомление.АдресОтправки = АдресПолучателя;
	ЗаполнитьЗначенияСвойств(СформированноеУведомление, ДанныеУведомления);
	СформированноеУведомление.Пользователь = ПолучательУведомления;
	СформированноеУведомление.ОбъектУведомления = ОбъектУведомления;
	
КонецПроцедуры 

