Функция ПолучитьПолучателейУведомленийРТУнаПремии()
	
	Участники = Константы.ГруппаПолучателейПоРассылкеРТУнаПремии.Получить();
	ПолучателиПисьма = Новый Массив;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Вид", Справочники.ВидыКонтактнойИнформации.EmailПользователя);
	
	Если ТипЗнч(Участники) = Тип("СправочникСсылка.Пользователи") Тогда
		ПолучателиПисьма.Добавить(Участники);
	Иначе
		Участники = Пользователи_sd_сервер.ПолучитьПользователейГруппы(Участники);
		Для Каждого Участник из Участники Цикл
			ПолучателиПисьма.Добавить(Участник);
		КонецЦикла;
	КонецЕсли;
	
	Возврат ПолучателиПисьма;
	
