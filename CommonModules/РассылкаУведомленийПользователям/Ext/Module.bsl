// Евросиб US 90342 Рыбьяков К.А. 14.12.2025 ((
Процедура ДобавитьВТекстПисьмаПереченьРейса(Документ, ТекстПисьма)
	
	ТекстПисьма = ТекстПисьма + Символы.ПС + "Перечень рейсов:" + Символы.ПС ;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АВТОНОМЕРЗАПИСИ() КАК НомерСтроки,
	|	ПРЕДСТАВЛЕНИЕ(РеестрСпециальныхСтавокРейсы.Рейс) КАК Рейс
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Документ.РеестрСпециальныхСтавок.Рейсы КАК РеестрСпециальныхСтавокРейсы
	|ГДЕ
	|	РеестрСпециальныхСтавокРейсы.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.НомерСтроки КАК НомерСтроки,
	|	ВТ.Рейс КАК Рейс
	|ИЗ
	|	ВТ КАК ВТ";
	
	Запрос.УстановитьПараметр("Ссылка", Документ);
	
	РезультатЗапроса = Запрос.Выполнить();
		
	Выборка = РезультатЗапроса.Выбрать();
	
	НомерСтроки = 1;
	
	Пока Выборка.Следующий() Цикл
		ТекстПисьма = ТекстПисьма + Строка(Выборка.НомерСтроки) + ". " + Выборка.Рейс + Символы.ПС;
	КонецЦикла;
	
КонецПроцедуры

