					ОтправитьСообщение("Переход клиента в зону среднего риска", ТекстПисьма, Получатели);
					
				КонецЕсли;
				
			ИначеЕсли Выборка.НовыйУровеньРиска = УровеньРискаВысокий Тогда
				
				Если Правило.УведомитьОКраснойЗоне Тогда
					
					АдресаПолучателей = ТаблицаПолучателейУведомлений.Скопировать(Новый Структура("Критерий, УровеньРиска", Критерий, Выборка.НовыйУровеньРиска), "АдресЭлектроннойПочты").ВыгрузитьКолонку("АдресЭлектроннойПочты");
				
					Если АдресаПолучателей.Количество() > 0 тогда
						
						Получатели = СтрСоединить(АдресаПолучателей, "; ");					
						ТекстПисьма = СтрШаблон("Клиенту %1 установлен высокий уровень риска по критерию %2", Выборка.КонтрагентНаименование, Критерий);
						ОтправитьСообщение("Переход клиента в зону высокого риска", ТекстПисьма, Получатели);
						
					КонецЕсли;					
					
				КонецЕсли;
				
				Если Правило.АвтоматическийПереводВСтопЛистВКраснойЗоне Тогда
						
					КонтрагентДляСтопЛиста = ТаблицаКонтрагентовДляСтопЛиста.Найти(Выборка.Контрагент, "Контрагент");
					Если КонтрагентДляСтопЛиста <> Неопределено Тогда
						КонтрагентДляСтопЛиста.Комментарий = КонтрагентДляСтопЛиста.Комментарий + СтрШаблон("; Установлен высокий уровень риска по критерию %1", Критерий);
					Иначе
						КонтрагентДляСтопЛиста = ТаблицаКонтрагентовДляСтопЛиста.Добавить();
						КонтрагентДляСтопЛиста.Контрагент = Выборка.Контрагент;
						КонтрагентДляСтопЛиста.Комментарий = СтрШаблон("Установлен высокий уровень риска по критерию %1", Критерий);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЕсли;
	
	//3. Количество дней от счета на оплату
	
	Критерий = Перечисления.АналитикиРейтингаКлиентов.КоличествоДнейОтСчетаНаОплату;
	Правило = ТаблицаПравил.Найти(Критерий, "Критерий");
	
	Если Правило <> Неопределено Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТекущаяДата", ТекДата);
		Запрос.УстановитьПараметр("Критерий", Критерий);
		Запрос.УстановитьПараметр("ПределНизкогоУровняРиска", Правило.ЗеленыйПо);
		Запрос.УстановитьПараметр("ПределСреднегоУровняРиска", Правило.ЖелтыйПо);
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.Контрагент КАК Контрагент,
		|	МАКСИМУМ(РАЗНОСТЬДАТ(РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.СчетПокупателю.ДатаДокумента, &ТекущаяДата, ДЕНЬ)) КАК ДнейПросрочки
		|ПОМЕСТИТЬ ВТДнейПросрочки
		|ИЗ
		|	РегистрНакопления.РазнесениеСчетовПокупателейПоВходящимПлатежам.Остатки КАК РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.Контрагент
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	Контрагенты.Ссылка,
		|	0
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ТипКонтрагента_Клиент
		|	И НЕ Контрагенты.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ВТДнейПросрочки.Контрагент, РейтингиКлиентовСрезПоследних.Контрагент) КАК Контрагент,
		|	ЕСТЬNULL(ВТДнейПросрочки.Контрагент.Наименование, РейтингиКлиентовСрезПоследних.Контрагент.Наименование) КАК КонтрагентНаименование,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТДнейПросрочки.ДнейПросрочки, 0) <= &ПределНизкогоУровняРиска
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СПАРКЗначенияРисков.Низкий)
		|		КОГДА ВТДнейПросрочки.ДнейПросрочки <= &ПределСреднегоУровняРиска
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СПАРКЗначенияРисков.Средний)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СПАРКЗначенияРисков.Высокий)
		|	КОНЕЦ КАК НовыйУровеньРиска,
		|	РейтингиКлиентовСрезПоследних.УровеньРиска КАК СтарыйУровеньРиска
		|ИЗ
		|	ВТДнейПросрочки КАК ВТДнейПросрочки
		|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.РейтингиКлиентов.СрезПоследних(, Критерий = &Критерий) КАК РейтингиКлиентовСрезПоследних
		|		ПО ВТДнейПросрочки.Контрагент = РейтингиКлиентовСрезПоследних.Контрагент
		|ГДЕ
		|	ЕСТЬNULL(РейтингиКлиентовСрезПоследних.УровеньРиска, НЕОПРЕДЕЛЕНО) <> ВЫБОР
		|			КОГДА ЕСТЬNULL(ВТДнейПросрочки.ДнейПросрочки, 0) <= &ПределНизкогоУровняРиска
		|				ТОГДА ЗНАЧЕНИЕ(Перечисление.СПАРКЗначенияРисков.Низкий)
		|			КОГДА ВТДнейПросрочки.ДнейПросрочки <= &ПределСреднегоУровняРиска
		|				ТОГДА ЗНАЧЕНИЕ(Перечисление.СПАРКЗначенияРисков.Средний)
		|			ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СПАРКЗначенияРисков.Высокий)
		|		КОНЕЦ";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			МенеджерЗаписи = РегистрыСведений.РейтингиКлиентов.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Контрагент = Выборка.Контрагент;
			МенеджерЗаписи.Критерий = Критерий;
			МенеджерЗаписи.Период = ТекДата;
			МенеджерЗаписи.УровеньРиска = Выборка.НовыйУровеньРиска;
			МенеджерЗаписи.Записать();
			
			Если Правило.УведомитьОЖелтойЗоне И Выборка.НовыйУровеньРиска = УровеньРискаСредний И Выборка.СтарыйУровеньРиска <> УровеньРискаВысокий Тогда
				
				АдресаПолучателей = ТаблицаПолучателейУведомлений.Скопировать(Новый Структура("Критерий, УровеньРиска", Критерий, Выборка.НовыйУровеньРиска), "АдресЭлектроннойПочты").ВыгрузитьКолонку("АдресЭлектроннойПочты");
				
				Если АдресаПолучателей.Количество() > 0 тогда
					
					Получатели = СтрСоединить(АдресаПолучателей, "; ");					
					ТекстПисьма = СтрШаблон("Клиенту %1 установлен средний уровень риска по критерию %2", Выборка.КонтрагентНаименование, Критерий);
					ОтправитьСообщение("Переход клиента в зону среднего риска", ТекстПисьма, Получатели);
					
				КонецЕсли;
				
			ИначеЕсли Правило.УведомитьОКраснойЗоне И Выборка.НовыйУровеньРиска = УровеньРискаВысокий Тогда
				
				АдресаПолучателей = ТаблицаПолучателейУведомлений.Скопировать(Новый Структура("Критерий, УровеньРиска", Критерий, Выборка.НовыйУровеньРиска), "АдресЭлектроннойПочты").ВыгрузитьКолонку("АдресЭлектроннойПочты");
				
				Если АдресаПолучателей.Количество() > 0 тогда
					
					Получатели = СтрСоединить(АдресаПолучателей, "; ");					
					ТекстПисьма = СтрШаблон("Клиенту %1 установлен высокий уровень риска по критерию %2", Выборка.КонтрагентНаименование, Критерий);
					ОтправитьСообщение("Переход клиента в зону высокого риска", ТекстПисьма, Получатели);
					
				КонецЕсли;
				
				Если Правило.АвтоматическийПереводВСтопЛистВКраснойЗоне Тогда
						
					КонтрагентДляСтопЛиста = ТаблицаКонтрагентовДляСтопЛиста.Найти(Выборка.Контрагент, "Контрагент");
					Если КонтрагентДляСтопЛиста <> Неопределено Тогда
						КонтрагентДляСтопЛиста.Комментарий = КонтрагентДляСтопЛиста.Комментарий + СтрШаблон("; Установлен высокий уровень риска по критерию %1", Критерий);
					Иначе
						КонтрагентДляСтопЛиста = ТаблицаКонтрагентовДляСтопЛиста.Добавить();
						КонтрагентДляСтопЛиста.Контрагент = Выборка.Контрагент;
						КонтрагентДляСтопЛиста.Комментарий = СтрШаблон("Установлен высокий уровень риска по критерию %1", Критерий);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	//Помещение клиентов в стоп-лист по критериям и исключение клиентов из стоп-листа по отсутствию дебиторской задолженности
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КонтрагентыДляСтопЛиста", ТаблицаКонтрагентовДляСтопЛиста);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекДата);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтрагентыВСтопЛист.Контрагент КАК Контрагент,
	|	КонтрагентыВСтопЛист.Комментарий КАК Комментарий
	|ПОМЕСТИТЬ ВТКонтрагентыДляСтопЛиста
	|ИЗ
	|	&КонтрагентыДляСтопЛиста КАК КонтрагентыВСтопЛист
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтопЛистКонтрагентовСрезПоследних.Период КАК Период,
	|	ЕСТЬNULL(СтопЛистКонтрагентовСрезПоследних.Контрагент, ВТКонтрагентыДляСтопЛиста.Контрагент) КАК Контрагент,
	|	ЕСТЬNULL(СтопЛистКонтрагентовСрезПоследних.ВСтопЛисте, ЛОЖЬ) КАК ВСтопЛисте,
	|	СтопЛистКонтрагентовСрезПоследних.Пользователь КАК Пользователь,
	|	ЕСТЬNULL(СтопЛистКонтрагентовСрезПоследних.ДатаОграниченияАвтоматическогоИзмененияСостояния, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОграниченияАвтоматическогоИзмененияСостояния,
	|	ВЫБОР
	|		КОГДА ВТКонтрагентыДляСтопЛиста.Контрагент ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ПоместитьВСтопЛист,
	|	ЕСТЬNULL(ВТКонтрагентыДляСтопЛиста.Комментарий, """") КАК КомментарийПомещенияВСтопЛист
	|ПОМЕСТИТЬ ВТСтопЛистКонтрагентов
	|ИЗ
	|	РегистрСведений.СтопЛистКонтрагентов.СрезПоследних КАК СтопЛистКонтрагентовСрезПоследних
	|		ПОЛНОЕ СОЕДИНЕНИЕ ВТКонтрагентыДляСтопЛиста КАК ВТКонтрагентыДляСтопЛиста
	|		ПО СтопЛистКонтрагентовСрезПоследних.Контрагент = ВТКонтрагентыДляСтопЛиста.Контрагент
	|ГДЕ
	|	(ЕСТЬNULL(СтопЛистКонтрагентовСрезПоследних.ВСтопЛисте, ЛОЖЬ)
	|			ИЛИ НЕ ВТКонтрагентыДляСтопЛиста.Контрагент ЕСТЬ NULL)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСтопЛистКонтрагентов.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ВТСтопЛистКонтрагентов.ПоместитьВСтопЛист
	|				И НЕ ВТСтопЛистКонтрагентов.ВСтопЛисте
	|				И ВТСтопЛистКонтрагентов.ДатаОграниченияАвтоматическогоИзмененияСостояния < &ТекущаяДата
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПоместитьВСтопЛист,
	|	ВЫБОР
	|		КОГДА ВТСтопЛистКонтрагентов.ВСтопЛисте
	|				И НЕ ВТСтопЛистКонтрагентов.ПоместитьВСтопЛист
	|				И -ЕСТЬNULL(ВзаиморасчетыСПокупателямиОстатки.СуммаСНДСОстаток, 0) = 0
	|				И ВТСтопЛистКонтрагентов.ДатаОграниченияАвтоматическогоИзмененияСостояния < &ТекущаяДата
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ИсключитьИзСтопЛиста,
	|	ВТСтопЛистКонтрагентов.КомментарийПомещенияВСтопЛист КАК КомментарийПомещенияВСтопЛист
	|ИЗ
	|	ВТСтопЛистКонтрагентов КАК ВТСтопЛистКонтрагентов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВзаиморасчетыСПокупателями.Остатки(
	|				,
	|				Контрагент В
	|					(ВЫБРАТЬ
	|						СтопЛистКонтрагентов.Контрагент
	|					ИЗ
	|						ВТСтопЛистКонтрагентов КАК СтопЛистКонтрагентов)) КАК ВзаиморасчетыСПокупателямиОстатки
	|		ПО ВТСтопЛистКонтрагентов.Контрагент = ВзаиморасчетыСПокупателямиОстатки.Контрагент
	|ГДЕ
	|	(ВТСтопЛистКонтрагентов.ПоместитьВСтопЛист
	|				И НЕ ВТСтопЛистКонтрагентов.ВСтопЛисте
	|				И ВТСтопЛистКонтрагентов.ДатаОграниченияАвтоматическогоИзмененияСостояния < &ТекущаяДата
	|			ИЛИ ВТСтопЛистКонтрагентов.ВСтопЛисте
	|				И НЕ ВТСтопЛистКонтрагентов.ПоместитьВСтопЛист
	|				И -ЕСТЬNULL(ВзаиморасчетыСПокупателямиОстатки.СуммаСНДСОстаток, 0) = 0
	|				И ВТСтопЛистКонтрагентов.ДатаОграниченияАвтоматическогоИзмененияСостояния < &ТекущаяДата)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Запись = РегистрыСведений.СтопЛистКонтрагентов.СоздатьМенеджерЗаписи();
		Запись.Период = ТекДата;
		Запись.Контрагент = Выборка.Контрагент;
		
		Если Выборка.ПоместитьВСтопЛист Тогда
			Запись.ВСтопЛисте = Истина;
			Запись.Комментарий = Выборка.КомментарийПомещенияВСтопЛист;
		Иначе
			Запись.ВСтопЛисте = Ложь;
		КонецЕсли;
		
		Запись.Записать();
		
	КонецЦикла;	
	
КонецПроцедуры

//Евросиб Каблов 26.02.2020 ( Ticket#0182095
Процедура РассчитатьПлановуюКатегориюКонтрагентов(ПериодРасчета) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДатаНачала = НачалоМесяца(ПериодРасчета);
	ДатаОкончания = КонецМесяца(ДобавитьМесяц(ПериодРасчета, 5));
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтрагентыПлановыеПоказателиРаботыСКлиентом.Ссылка КАК Контрагент,
	|	КонтрагентыПлановыеПоказателиРаботыСКлиентом.МесяцНачалаРаботы КАК МесяцНачалаРаботы,
	|	КонтрагентыПлановыеПоказателиРаботыСКлиентом.КонтрибуцияБезНДС КАК КонтрибуцияБезНДС,
	|	КонтрагентыПлановыеПоказателиРаботыСКлиентом.Погрузка КАК Погрузка
	|ИЗ
	|	Справочник.Контрагенты.ПлановыеПоказателиРаботыСКлиентом КАК КонтрагентыПлановыеПоказателиРаботыСКлиентом
	|ГДЕ
	|	КонтрагентыПлановыеПоказателиРаботыСКлиентом.МесяцНачалаРаботы МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И НЕ КонтрагентыПлановыеПоказателиРаботыСКлиентом.Ссылка.ПометкаУдаления";
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);	
	
	ТаблицаПоказателей = Запрос.Выполнить().Выгрузить();
	
	ТаблицаКонтрагентов = ТаблицаПоказателей.Скопировать(, "Контрагент, КонтрибуцияБезНДС");
	ТаблицаКонтрагентов.Свернуть("Контрагент", "КонтрибуцияБезНДС");
	ТаблицаКонтрагентов.Колонки.Добавить("ПроцентКонтрибуции", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 2)));
	ТаблицаКонтрагентов.Колонки.Добавить("КатегорияABC", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(1)));
	ТаблицаКонтрагентов.Колонки.Добавить("КатегорияXYZ", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(1)));
	
	ОбщаяСуммаКонтрибуции = ТаблицаПоказателей.Итог("КонтрибуцияБезНДС");
	
	Если ОбщаяСуммаКонтрибуции <> 0 Тогда
		
		Для Каждого СтрокаКонтрагента Из ТаблицаКонтрагентов Цикл
			СтрокаКонтрагента.ПроцентКонтрибуции = Окр(СтрокаКонтрагента.КонтрибуцияБезНДС / ОбщаяСуммаКонтрибуции * 100, 2);
		КонецЦикла;
		
		ТаблицаКонтрагентов.Сортировать("ПроцентКонтрибуции Убыв");
		
		НакопленныйПроцент = 0;		
		Для Каждого СтрокаКонтрагента Из ТаблицаКонтрагентов Цикл
			НакопленныйПроцент = НакопленныйПроцент + СтрокаКонтрагента.ПроцентКонтрибуции;
			Если НакопленныйПроцент < 80 Тогда
				СтрокаКонтрагента.КатегорияABC = "A";
			ИначеЕсли НакопленныйПроцент < 95 Тогда
				СтрокаКонтрагента.КатегорияABC = "B";
			Иначе
				СтрокаКонтрагента.КатегорияABC = "C";
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;	
	
	Для Каждого СтрокаКонтрагента Из ТаблицаКонтрагентов Цикл
				
		Показатели = ТаблицаПоказателей.НайтиСтроки(Новый Структура("Контрагент", СтрокаКонтрагента.Контрагент));
		Количество = Показатели.Количество();
		
		Если Количество = 0 Или Количество = 1 Тогда
			Продолжить;
		КонецЕсли;
		
		Сумма = 0;
		Для Каждого СтрокаПоказателя Из Показатели Цикл
			Сумма = Сумма + СтрокаПоказателя.Погрузка;
		КонецЦикла;
		ПогрузкаСреднееЗначение = Окр(Сумма / Количество, 2);
		
		Если ПогрузкаСреднееЗначение = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Дисперсия = 0;
		Для Каждого СтрокаПоказателя Из Показатели Цикл
			Дисперсия = Дисперсия + Pow(СтрокаПоказателя.Погрузка - ПогрузкаСреднееЗначение, 2);
		КонецЦикла;
		
		СреднеквадратическоеОтклонение = Sqrt(Дисперсия / (Количество - 1));
		КоэффициентВариации = СреднеквадратическоеОтклонение / ПогрузкаСреднееЗначение * 100;
		
		Если КоэффициентВариации <= 10 Тогда
		    СтрокаКонтрагента.КатегорияXYZ = "X";
		ИначеЕсли КоэффициентВариации <= 25 Тогда
			СтрокаКонтрагента.КатегорияXYZ = "Y";
		Иначе
			СтрокаКонтрагента.КатегорияXYZ = "Z";
		КонецЕсли;
		
	КонецЦикла;
	
	ОбщиеСвойстваЗаписей = Новый Структура();
	ОбщиеСвойстваЗаписей.Вставить("Период", ДатаНачала);
	ОбщиеСвойстваЗаписей.Вставить("ТипКонтрагента", Перечисления.ТипыКонтрагентов.Клиент);
	ОбщиеСвойстваЗаписей.Вставить("ПлановаяФактическая", Перечисления.ПланФакт.План);
	
	Для Каждого СтрокаКонтрагента Из ТаблицаКонтрагентов Цикл		
		Если ЗначениеЗаполнено(СтрокаКонтрагента.КатегорияABC) И ЗначениеЗаполнено(СтрокаКонтрагента.КатегорияXYZ) Тогда
			Запись = РегистрыСведений.КатегорииКонтрагентов.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись, ОбщиеСвойстваЗаписей);
			Запись.Контрагент = СтрокаКонтрагента.Контрагент;
			Запись.Категория = СтрокаКонтрагента.КатегорияABC + СтрокаКонтрагента.КатегорияXYZ;
			Запись.Записать();
		КонецЕсли;		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры
