		Попытка
			ИДПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(Справочники.УчетныеЗаписиЭлектроннойПочты.СистемнаяУчетнаяЗаписьЭлектроннойПочты, ПараметрыСообщения);
		Исключение
			ОписаниеОшибки = ОписаниеОшибки();
			//ЗаписьЖурналаРегистрации("Письмо не отправлено по причине: " + ОписаниеОшибки, УровеньЖурналаРегистрации.Ошибка,,, "Рассылка об изменении рейтинга клиентов");
			//ДИТ, Беляев СЮ, Ticket#0272756, 25-07-2022, начало
			ЗаписьЖурналаРегистрации(РаботаСПочтовымиСообщениями.СобытиеЖурналаРегистрацииОшибка(), УровеньЖурналаРегистрации.Ошибка,,, "Рассылка об изменении рейтинга клиентов. Письмо не отправлено по причине: "+ОписаниеОшибки);
            //ДИТ, Беляев СЮ, Ticket#0272756, 25-07-2022, конец
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

