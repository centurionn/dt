Функция ПолучитьРуководителяКонтрагента(Контрагент, ДатаДокумента) Экспорт

	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
				   |	ДанныеРуководителяКонтрагентовСрезПоследних.Руководитель КАК Руководитель,
				   |	ДанныеРуководителяКонтрагентовСрезПоследних.ОкончаниеДействия КАК ОкончаниеДействия
				   |ИЗ
				   |	РегистрСведений.ДанныеРуководителяКонтрагентов.СрезПоследних(&ДатаДокумента, Контрагент = &Контрагент) КАК ДанныеРуководителяКонтрагентовСрезПоследних";
				   
	Запрос.УстановитьПараметр("ДатаДокумента", ДатаДокумента);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Ответ = Запрос.Выполнить().Выбрать();
	
	Если Ответ.Следующий() тогда             
		Если НЕ ЗначениеЗаполнено(Ответ.ОкончаниеДействия) ИЛИ Ответ.ОкончаниеДействия > ДатаДокумента Тогда
			Результат = Ответ.Руководитель;
		КонецЕсли;
	КонецЕсли; 
	
	Возврат Результат;
	
