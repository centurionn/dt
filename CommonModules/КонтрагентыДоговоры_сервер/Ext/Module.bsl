		|	ДоговорыКонтрагентовОтветственные.Ссылка.Дата КАК Дата,
		|	ДоговорыКонтрагентовОтветственные.Ссылка.СрокДействия КАК СрокДействия,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ДоговорыКонтрагентовОтветственные.Ответственный) = ТИП(Справочник.ГруппыПользователей)
		|			ТОГДА ГруппыПользователейСостав.Пользователь
		|		ИНАЧЕ ДоговорыКонтрагентовОтветственные.Ответственный
		|	КОНЕЦ КАК Ответственный
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов.Ответственные КАК ДоговорыКонтрагентовОтветственные
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыПользователей.Состав КАК ГруппыПользователейСостав
		|		ПО ДоговорыКонтрагентовОтветственные.Ответственный = ГруппыПользователейСостав.Ссылка
		|ГДЕ
		|	ДоговорыКонтрагентовОтветственные.Ссылка.Владелец = &Клиент
		|	И ДоговорыКонтрагентовОтветственные.ЦФО = &ЦФО
		|	И ДоговорыКонтрагентовОтветственные.ТипОтветственного = &ТипОтветственного
		|	И ВЫБОР
		|			КОГДА ДоговорыКонтрагентовОтветственные.Ссылка.Автопролонгация
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ДоговорыКонтрагентовОтветственные.Ссылка.СрокДействия > &ТекущаяДата
		|		КОНЕЦ
		|	И ДоговорыКонтрагентовОтветственные.Ссылка.Активный = ИСТИНА
		|	И ДоговорыКонтрагентовОтветственные.Ответственный <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	СрокДействия УБЫВ,
		|	Дата УБЫВ";
	
	//Евросиб СубботинВ #117990 20.01.2026 Конец

		
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("ТипОтветственного", ТипОтветственного);
	Запрос.УстановитьПараметр("ЦФО", ЦФО);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Ответственный    = ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка");
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Ответственный = ВыборкаДетальныеЗаписи.Ответственный;
	КонецЦикла;

	Возврат Ответственный;

КонецФункции	

// ++ Евросиб Дудоров С.В. US 57543 30.01.2023
Процедура АктуализацияОтветственныхПоДоговорамКлиента(ДоговорСсылка, ЦФО = Неопределено
			, ОтветственныйВФормеДоговора = Неопределено, ТипОтветственного = Неопределено, Клиент) Экспорт
	
	Если ТипОтветственного = Неопределено Тогда
		ТипОтветственного = ПредопределенноеЗначение("Перечисление.ТипыОтветственных.ОтветственныйЗаСопровождение");
	КонецЕсли;
	Если ОтветственныйВФормеДоговора = Неопределено 
		или ОтветственныйВФормеДоговора = ПредопределенноеЗначение("Справочник.ДоговорыКонтрагентов.ПустаяСсылка") Тогда
		Возврат;
	КонецЕсли;   
	
	СтарыйОтветственный = ПолучитьОтветственногоПоДоговору(ДоговорСсылка, ЦФО, ТипОтветственного);
	
	Если СтарыйОтветственный <> ОтветственныйВФормеДоговора Тогда
		
		Если не ЕстьНаличиеАктуальногоДоговораПоЦФОКлиентуПериодуСНовымОтветственным(
			ЦФО, Клиент, ТипОтветственного, ОтветственныйВФормеДоговора) Тогда
			АктуализацияОтветственныхВДокументах(ДоговорСсылка, ЦФО
				,ОтветственныйВФормеДоговора, ТипОтветственного, Клиент, СтарыйОтветственный);		
		КонецЕсли;	
			
	КонецЕсли;	

КонецПроцедуры 

Функция ЕстьНаличиеАктуальногоДоговораПоЦФОКлиентуПериодуСНовымОтветственным(
	ЦФО, Клиент, ТипОтветственного, ОтветственныйВФормеДоговора) 
	
	Возврат ПолучитьОтветственногоДействующегоДоговораКлиента(Клиент, ТипОтветственного, ЦФО)
		= ОтветственныйВФормеДоговора;

КонецФункции	

Процедура АктуализацияОтветственныхВДокументах(ДоговорСсылка, ЦФО = Неопределено
			, ОтветственныйВФормеДоговора = Неопределено, ТипОтветственного = Неопределено
			, Клиент = Неопределено, СтарыйОтветственный)
	
	ВыборкаДокументовРефСцепов = ПолучитьАктуальныеРефСцепыПоКлиентам(ДоговорСсылка, Клиент); 
	
	Пока ВыборкаДокументовРефСцепов.Следующий() Цикл 
		
		ОтложенноеИзменениеСервер.ПоставитьРефСцепВОчередьИзменения(ВыборкаДокументовРефСцепов.РефСцеп, ДоговорСсылка);
			
	КонецЦикла;
		
КонецПроцедуры	

Функция ПолучитьАктуальныеРефСцепыПоКлиентам(ДоговорСсылка, Клиент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РефСцепВагоныРефСцепа.Ссылка КАК РефСцеп
		|ИЗ
		|	Документ.РефСцеп.ВагоныРефСцепа КАК РефСцепВагоныРефСцепа
		|ГДЕ
		|	РефСцепВагоныРефСцепа.Ссылка.РейсЗавершен = ЛОЖЬ
		|	И РефСцепВагоныРефСцепа.Ссылка.ПометкаУдаления = ЛОЖЬ
		|	И РефСцепВагоныРефСцепа.Клиент = &Клиент
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РефСцепКонтейнеры.Ссылка
		|ИЗ
		|	Документ.РефСцеп.Контейнеры КАК РефСцепКонтейнеры
		|ГДЕ
		|	РефСцепКонтейнеры.Ссылка.РейсЗавершен = ЛОЖЬ
		|	И РефСцепКонтейнеры.Клиент = &Клиент
		|	И РефСцепКонтейнеры.Ссылка.ПометкаУдаления = ЛОЖЬ";
	
	
	Запрос.УстановитьПараметр("Ложь", Ложь);
	Запрос.УстановитьПараметр("Клиент", Клиент);
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

// ++ Евросиб Дудоров С.В. US 61271 30.01.2023
Функция ПОлучитьЕдинственныйДоговорКонтрагента(Контрагент) Экспорт
	мДоговоров = ПолучитьВсеДоговорыКонтрагента(Контрагент);
	Если мДоговоров.Количество() = 1 Тогда
		Возврат мДоговоров[0];
	КонецЕсли;
	Возврат	Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
КонецФункции	

