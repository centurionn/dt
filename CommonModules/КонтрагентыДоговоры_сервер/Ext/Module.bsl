Функция ПолучитьВсеДоговорыКонтрагента(Контрагент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Договоры.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ДоговорыКонтрагентов КАК Договоры
	               |ГДЕ
	               |	Договоры.Владелец = &Владелец
	               |	И НЕ Договоры.ПометкаУдаления";
	Запрос.УстановитьПараметр("Владелец", Контрагент);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция ПолучитьДоговорКонтрагента(Контрагент, НомерДоговора) Экспорт
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Договоры.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ДоговорыКонтрагентов КАК Договоры
	               |ГДЕ
	               |	Договоры.Владелец = &Владелец
	               |	И НЕ Договоры.ПометкаУдаления
	               |	И Договоры.Номер = &Номер
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Договоры.Дата УБЫВ";
	Запрос.УстановитьПараметр("Владелец", Контрагент);
	Запрос.УстановитьПараметр("Номер", НомерДоговора);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДействующиеДоговорыКонтрагента(Контрагент, Знач ИскомаяДата = неопределено, ТолькоДоговорыПокупателя = Ложь) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ИскомаяДата) Тогда
		ИскомаяДата = ТекущаяДата();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Договоры.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ДоговорыКонтрагентов КАК Договоры
	               |ГДЕ
	               |	Договоры.Владелец = &Владелец
	               |	И НЕ Договоры.ПометкаУдаления
	               |	И &ИскомаяДата МЕЖДУ Договоры.Дата И Договоры.СрокДействия
	               |	И ВЫБОР
	               |			КОГДА &ТолькоДоговорыПокупателей
	               |				ТОГДА Договоры.ВидДоговора = &СПокупателем
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ";
	Запрос.УстановитьПараметр("Владелец", Контрагент);
	Запрос.УстановитьПараметр("ИскомаяДата", ИскомаяДата);
	Запрос.УстановитьПараметр("ТолькоДоговорыПокупателей", ТолькоДоговорыПокупателя);
	Запрос.УстановитьПараметр("СПокупателем", Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");	
	
КонецФункции

Функция ПолучитьВалютуДоговора(Договор, Знач ДатаДокумента = неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДатаДокумента) Тогда ДатаДокумента = ТекущаяДата(); КонецЕсли;
	
	РезультатВалюта = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Договор.ВалютаВзаиморасчетов, ДатаДокумента);
	КратностьВзаиморасчетов = РезультатВалюта.Кратность;
	КурсВзаиморасчетов = РезультатВалюта.Курс;
	
	Возврат Новый Структура("Валюта, Курс, Кратность", Договор.ВалютаВзаиморасчетов, КурсВзаиморасчетов, КратностьВзаиморасчетов);
	
КонецФункции

Функция НайтиКонтрагентаПоНечеткомуУсловию(Условие) Экспорт
	
	Если Условие = "" Тогда Возврат неопределено; КОнецЕсли;
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	КонтрагентыСинонимыДляПоиска.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Контрагенты.СинонимыДляПоиска КАК КонтрагентыСинонимыДляПоиска
	               |ГДЕ
	               |	КонтрагентыСинонимыДляПоиска.СинонимКонтрагента = &СинонимКонтрагента
	               |	И НЕ КонтрагентыСинонимыДляПоиска.Ссылка.ПометкаУдаления";
	Запрос.УстановитьПараметр("СинонимКонтрагента", Условие);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

