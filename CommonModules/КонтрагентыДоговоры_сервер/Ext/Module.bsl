			ВызватьИсключение;
		КонецПопытки;
		
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Калькуляция.Договор КАК ДоговорКонтрагента
		|ИЗ
		|	Документ.Калькуляция КАК Калькуляция
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов.Состояния КАК СпрДоговорыКонтрагентов
