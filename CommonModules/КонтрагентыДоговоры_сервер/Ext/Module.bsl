Функция ДоговорЗарегистрированВБФ(Договор) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПротоколОбменов.УИДИсточника КАК УИДИсточника
	               |ИЗ
	               |	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	               |ГДЕ
	               |	ПротоколОбменов.Объект = &Объект
	               |	И ПротоколОбменов.УзелОбмена = &УзелОбмена";
	Запрос.УстановитьПараметр("Объект", Договор);
	Запрос.УстановитьПараметр("УзелОбмена", Перечисления.УзлыОбмена.БитФинанс);
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура ПроверкаПроведенияДоговораВБФПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	ВыбранныйДоговор = неопределено;
	Попытка
		ВыбранныйДоговор = Источник.Договор;
	Исключение
		Возврат;
	КонецПопытки;
	
	Если ЗначениеЗаполнено(ВыбранныйДоговор) И НЕ ДоговорЗарегистрированВБФ(ВыбранныйДоговор) И Не ВыбранныйДоговор.НеПроверятьРегистрациюВБИТФИНАНС Тогда
		
		Отказ = Истина;
		Сообщить("Создавать документы можно только с договором, зарегистрированным в БИТ.Финанс!");
		
	КонецЕсли;
	
