Процедура СтопЛистОбновление() Экспорт
	
	// Сначала заносим в стоп-лист всех контрагентов с задолженностью
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.Текст =  "ВЫБРАТЬ
	                |	ЦентрыФинансовойОтветственностиОтключениеСтопЛиста.Ссылка КАК Ссылка
	                |ИЗ
	                |	Справочник.ЦентрыФинансовойОтветственности.ОтключениеСтопЛиста КАК ЦентрыФинансовойОтветственностиОтключениеСтопЛиста
	                |ГДЕ
	                |	&ТекущаяДата МЕЖДУ ЦентрыФинансовойОтветственностиОтключениеСтопЛиста.НачалоПериода И ЦентрыФинансовойОтветственностиОтключениеСтопЛиста.КонецПериода";
	СписокЗаблокированныхЦФО = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВзаиморасчетыСПокупателямиОстатки.Контрагент КАК Контрагент,
	               |	ВзаиморасчетыСПокупателямиОстатки.Договор КАК Договор,
	               |	МИНИМУМ(ВзаиморасчетыСПокупателямиОстатки.ДокументВзаиморасчетов) КАК ДокументВзаиморасчетов,
	               |	ВзаиморасчетыСПокупателямиОстатки.ВалютаРасчетов КАК ВалютаРасчетов,
	               |	МИНИМУМ(ВзаиморасчетыСПокупателямиОстатки.ДатаРасчетов) КАК ДатаРасчетов,
	               |	СУММА(ВзаиморасчетыСПокупателямиОстатки.СуммаБезНДСОстаток) КАК СуммаБезНДСОстаток,
	               |	МАКСИМУМ(ЕСТЬNULL(Кредитка.ОтсрочкаПоДоговору_Факт, ВзаиморасчетыСПокупателямиОстатки.Договор.СрокОплаты)) КАК ДоговорСрокОплаты,
	               |	МАКСИМУМ(ДОБАВИТЬКДАТЕ(ВзаиморасчетыСПокупателямиОстатки.ДатаРасчетов, ДЕНЬ, ЕСТЬNULL(Кредитка.ОтсрочкаПоДоговору_Факт, ВзаиморасчетыСПокупателямиОстатки.Договор.СрокОплаты))) КАК ДедлайнОплаты,
	               |	МАКСИМУМ(Кредитка.Ссылка) КАК Ссылка,
	               |	МАКСИМУМ(Кредитка.ОтсрочкаПоДоговору_Факт) КАК ОтсрочкаПоДоговору_Факт,
	               |	СтопЛистКонтрагентовСрезПоследних.ВСтопЛисте КАК ВСтопЛисте,
	               |	МАКСИМУМ(РАЗНОСТЬДАТ(ДОБАВИТЬКДАТЕ(ВзаиморасчетыСПокупателямиОстатки.ДатаРасчетов, ДЕНЬ, ЕСТЬNULL(Кредитка.ОтсрочкаПоДоговору_Факт, ВзаиморасчетыСПокупателямиОстатки.Договор.СрокОплаты)), &ТекущаяДата, ДЕНЬ)) КАК ДнейПросрочки,
	               |	ВзаиморасчетыСПокупателямиОстатки.ДокументВзаиморасчетов.ЦФО КАК ЦФО,
	               |	МАКСИМУМ(ЕСТЬNULL(Кредитка.ЛимитДЗ_План, ВзаиморасчетыСПокупателямиОстатки.Договор.ЛимитДебиторскойЗадолженности)) КАК ЛимитПДЗ
	               |ИЗ
	               |	РегистрНакопления.ВзаиморасчетыСПокупателями.Остатки КАК ВзаиморасчетыСПокупателямиОстатки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			КредитнаяЗаявка.ДоговорКонтрагента КАК ДоговорКонтрагента,
	               |			МАКСИМУМ(КредитнаяЗаявка.Ссылка) КАК Ссылка,
	               |			МАКСИМУМ(КредитнаяЗаявка.ОтсрочкаПоДоговору_План) КАК ОтсрочкаПоДоговору_Факт,
	               |			МАКСИМУМ(КредитнаяЗаявка.ЛимитДЗ_План) КАК ЛимитДЗ_План
	               |		ИЗ
	               |			Документ.КредитнаяЗаявка КАК КредитнаяЗаявка
	               |		ГДЕ
	               |			КредитнаяЗаявка.Проведен и 1 = 2
	               |			И &ТекущаяДата МЕЖДУ КредитнаяЗаявка.ДатаНачала И КредитнаяЗаявка.ДатаОкончания
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			КредитнаяЗаявка.ДоговорКонтрагента) КАК Кредитка
	               |		ПО ВзаиморасчетыСПокупателямиОстатки.Договор = Кредитка.ДоговорКонтрагента
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтопЛистКонтрагентов.СрезПоследних КАК СтопЛистКонтрагентовСрезПоследних
	               |		ПО ВзаиморасчетыСПокупателямиОстатки.Контрагент = СтопЛистКонтрагентовСрезПоследних.Контрагент
	               |ГДЕ
	               |	ВзаиморасчетыСПокупателямиОстатки.СуммаБезНДСОстаток + ЕСТЬNULL(Кредитка.ЛимитДЗ_План, ВзаиморасчетыСПокупателямиОстатки.Договор.ЛимитДебиторскойЗадолженности) < 0
	               |	И ДОБАВИТЬКДАТЕ(ВзаиморасчетыСПокупателямиОстатки.ДатаРасчетов, ДЕНЬ, ЕСТЬNULL(Кредитка.ОтсрочкаПоДоговору_Факт, ВзаиморасчетыСПокупателямиОстатки.Договор.СрокОплаты)) < &ТекущаяДата
	               |	И СтопЛистКонтрагентовСрезПоследних.ДатаОграниченияАвтоматическогоИзмененияСостояния < &ТекущаяДата
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВзаиморасчетыСПокупателямиОстатки.Контрагент,
	               |	ВзаиморасчетыСПокупателямиОстатки.Договор,
	               |	ВзаиморасчетыСПокупателямиОстатки.ВалютаРасчетов,
	               |	СтопЛистКонтрагентовСрезПоследних.ВСтопЛисте,
	               |	ВзаиморасчетыСПокупателямиОстатки.ДокументВзаиморасчетов.ЦФО";
	Ответ = Запрос.Выполнить().Выбрать();
	
	МассивЗаблокированных = Новый Массив;
	КоличествоКонтрагентов = 0;
	СписокКонтрагентов = "";
	СписокПричин = "";
	МассивКонтрагентовСЗадолженностью = Новый Массив;
	
	Пока Ответ.Следующий() Цикл

		МассивКонтрагентовСЗадолженностью.Добавить(Ответ.Контрагент);	
		Если МассивЗаблокированных.Найти(Ответ.Контрагент) = неопределено И Ответ.ВСтопЛисте <> Истина И СписокЗаблокированныхЦФО.Найти(Ответ.ЦФО) = неопределено Тогда
			
			Причина = "Просрочка оплаты на сумму " + Ответ.СуммаБезНДСОстаток + " по договору " + Ответ.Договор + " на дней " + Ответ.ДнейПросрочки;
			
			МЗ = РегистрыСведений.СтопЛистКонтрагентов.СоздатьМенеджерЗаписи();
			МЗ.ВСтопЛисте = Истина;
			МЗ.Комментарий = "Отнесено автоматически " + ТекущаяДата() + " " + Причина;
			МЗ.Пользователь = Пользователи.ТекущийПользователь();
			МЗ.Период = ТекущаяДата();
			МЗ.Контрагент = Ответ.Контрагент;
			МЗ.Записать(Истина);
			
			КоличествоКонтрагентов = КоличествоКонтрагентов + 1;
			СписокКонтрагентов = СписокКонтрагентов + ", " + Ответ.Контрагент;
			СписокПричин = СписокПричин + ", " + Причина;
			МассивЗаблокированных.Добавить(Ответ.Контрагент);
		КонецЕсли;
		
	КонецЦикла;
	
	Сообщить("Заблокировано " + КоличествоКонтрагентов + " контрагентов: " + СписокКонтрагентов);
	
	// 2. Выводим из стоп-листа контрагентов, чья задолженность не является просрочкой
	
	КоличествоКонтрагентов = 0;
	СписокКонтрагентов = "";
	Запрос.УстановитьПараметр("ЗаблокированныеКонтрагенты", МассивКонтрагентовСЗадолженностью);
	Запрос.Текст = "ВЫБРАТЬ
	               |	СтопЛистКонтрагентовСрезПоследних.Контрагент КАК Контрагент
	               |ИЗ
	               |	РегистрСведений.СтопЛистКонтрагентов.СрезПоследних КАК СтопЛистКонтрагентовСрезПоследних
	               |ГДЕ
	               |	НЕ СтопЛистКонтрагентовСрезПоследних.Контрагент В (&ЗаблокированныеКонтрагенты)
	               |	И СтопЛистКонтрагентовСрезПоследних.ВСтопЛисте
	               |	И СтопЛистКонтрагентовСрезПоследних.ДатаОграниченияАвтоматическогоИзмененияСостояния < &ТекущаяДата";
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		МЗ = РегистрыСведений.СтопЛистКонтрагентов.СоздатьМенеджерЗаписи();
		МЗ.ВСтопЛисте = Ложь;
		МЗ.Комментарий = "Исключено из стоп-листа в связи с отсутствием задолженности сверх срока оплаты: " + ТекущаяДата();
		МЗ.Пользователь = Пользователи.ТекущийПользователь();
		МЗ.Период = ТекущаяДата();
		МЗ.Контрагент = Ответ.Контрагент;
		МЗ.Записать(Истина);
		
		КоличествоКонтрагентов = КоличествоКонтрагентов + 1;
		СписокКонтрагентов = СписокКонтрагентов + ", " + Ответ.Контрагент;
		
	КонецЦикла;
	
	Сообщить("Разблокировано " + КоличествоКонтрагентов + " контрагентов: " + СписокКонтрагентов);
	
КонецПроцедуры

