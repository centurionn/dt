		|	Калькуляция.Проведен
		|	И Калькуляция.Договор.СрокДействия < Калькуляция.Дата
		|	И НЕ Калькуляция.Договор.ПометкаУдаления
		|	И НЕ Калькуляция.Договор.Автопролонгация
		|	И СпрДоговорыКонтрагентов.Ссылка ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РеализацияТоваровУслуг.ДоговорКонтрагента
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов.Состояния КАК СпрДоговорыКонтрагентов
		|		ПО РеализацияТоваровУслуг.ДоговорКонтрагента = СпрДоговорыКонтрагентов.Ссылка
		|			И (СпрДоговорыКонтрагентов.Состояние = ЗНАЧЕНИЕ(Справочник.Состояния.НеобходимаПролонгацияДоговора))
		|			И (СпрДоговорыКонтрагентов.Статус В (&Статусы))
		|ГДЕ
		|	РеализацияТоваровУслуг.Проведен
		|	И РеализацияТоваровУслуг.ДоговорКонтрагента.СрокДействия < РеализацияТоваровУслуг.Дата
		|	И НЕ РеализацияТоваровУслуг.ДоговорКонтрагента.ПометкаУдаления
		|	И НЕ РеализацияТоваровУслуг.ДоговорКонтрагента.Автопролонгация
		|	И СпрДоговорыКонтрагентов.Ссылка ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ОтчетКомитентуОПродажах.ДоговорКонтрагента
		|ИЗ
		|	Документ.ОтчетКомитентуОПродажах КАК ОтчетКомитентуОПродажах
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов.Состояния КАК СпрДоговорыКонтрагентов
		|		ПО ОтчетКомитентуОПродажах.ДоговорКонтрагента = СпрДоговорыКонтрагентов.Ссылка
		|			И (СпрДоговорыКонтрагентов.Состояние = ЗНАЧЕНИЕ(Справочник.Состояния.НеобходимаПролонгацияДоговора))
		|			И (СпрДоговорыКонтрагентов.Статус В (&Статусы))		
		|ГДЕ
		|	ОтчетКомитентуОПродажах.Проведен
		|	И ОтчетКомитентуОПродажах.ДоговорКонтрагента.СрокДействия < ОтчетКомитентуОПродажах.Дата
		|	И НЕ ОтчетКомитентуОПродажах.ДоговорКонтрагента.ПометкаУдаления
		|	И НЕ ОтчетКомитентуОПродажах.ДоговорКонтрагента.Автопролонгация
		|	И СпрДоговорыКонтрагентов.Ссылка ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СчетФактураВыданный.ДоговорКонтрагента
		|ИЗ
		|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов.Состояния КАК СпрДоговорыКонтрагентов
		|		ПО СчетФактураВыданный.ДоговорКонтрагента = СпрДоговорыКонтрагентов.Ссылка
		|			И (СпрДоговорыКонтрагентов.Состояние = ЗНАЧЕНИЕ(Справочник.Состояния.НеобходимаПролонгацияДоговора))
		|			И (СпрДоговорыКонтрагентов.Статус В (&Статусы))
		|ГДЕ
		|	СчетФактураВыданный.Проведен
		|	И СчетФактураВыданный.ДоговорКонтрагента.СрокДействия < СчетФактураВыданный.Дата
		|	И НЕ СчетФактураВыданный.ДоговорКонтрагента.ПометкаУдаления
		|	И НЕ СчетФактураВыданный.ДоговорКонтрагента.Автопролонгация
		|	И СпрДоговорыКонтрагентов.Ссылка ЕСТЬ NULL";
	
	
	МассивСтатусов = Новый Массив;
	МассивСтатусов.Добавить(Перечисления.СтатусыЭтапов.ВРаботе);
	МассивСтатусов.Добавить(Перечисления.СтатусыЭтапов.НаВыполнение);
	МассивСтатусов.Добавить(Перечисления.СтатусыЭтапов.Отклонен);
	МассивСтатусов.Добавить(Перечисления.СтатусыЭтапов.Новый);
	Запрос.УстановитьПараметр("Статусы", МассивСтатусов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДоговорОбъект = ВыборкаДетальныеЗаписи.ДоговорКонтрагента.ПолучитьОбъект();
		
		СтруктураПоиска = Новый Структура();
		СтруктураПоиска.Вставить("Состояние",Справочники.Состояния.НеобходимаПролонгацияДоговора);
		МассивСтрок = ДоговорОбъект.Состояния.НайтиСтроки(СтруктураПоиска);
		
		Если МассивСтрок.Количество() = 0 Тогда
			НСтр = ДоговорОбъект.Состояния.Добавить();
			НСтр.Состояние = Справочники.Состояния.НеобходимаПролонгацияДоговора;
			НСтр.Исполнитель = ДоговорОбъект.ОтветственныйЗаДоговор;
			НСтр.Наблюдатель = ДоговорОбъект.ОтветственныйЗаДоговор;
			НСтр.Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
			НСтр.НормативИсполненияСМоментаСоздания = 2;
		Иначе
			МассивСтрок[0].Исполнитель = ДоговорОбъект.ОтветственныйЗаДоговор;
			МассивСтрок[0].Наблюдатель = ДоговорОбъект.ОтветственныйЗаДоговор;
			МассивСтрок[0].Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
			МассивСтрок[0].НормативИсполненияСМоментаСоздания = 2;
		КонецЕсли;
		
		Попытка
			ДоговорОбъект.Записать();
		Исключение
			ЗаписьЖурналаРегистрации("Данные.Изменение",УровеньЖурналаРегистрации.Ошибка,,ДоговорОбъект.Ссылка,"Ошибка записи договора. Регламент УведомлениеОПролонгацииДоговоров");
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;
	//ДИТ Шевченко А.В. 63100 20.12.2022 -конец

	// ДИТ 0304081 Евсенкин М.А. Начало: 24.03.2023
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗадачиСотрудника.Документ КАК Документ,
		|	ЗадачиСотрудника.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.ЗадачиСотрудника КАК ЗадачиСотрудника
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|		ПО ЗадачиСотрудника.Документ = ДоговорыКонтрагентов.Ссылка
		|			И (ДоговорыКонтрагентов.СрокДействия >= ДОБАВИТЬКДАТЕ(&ТекущаяДата, ДЕНЬ, ДоговорыКонтрагентов.СрокПредупрежденияАвтопролонгацииДней))
		|ГДЕ
		|	ЗадачиСотрудника.Документ ССЫЛКА Справочник.ДоговорыКонтрагентов
		|	И ЗадачиСотрудника.Статус В (ЗНАЧЕНИЕ(Перечисление.СтатусыЭтапов.Новый), ЗНАЧЕНИЕ(Перечисление.СтатусыЭтапов.НаВыполнение), ЗНАЧЕНИЕ(Перечисление.СтатусыЭтапов.ВРаботе))
		|	И ЗадачиСотрудника.Состояние = ЗНАЧЕНИЕ(Справочник.Состояния.НеобходимаПролонгацияДоговора)";
		
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДоговорОбъект = ВыборкаДетальныеЗаписи.Документ.ПолучитьОбъект();
		МассивНайденныхСтрок = ДоговорОбъект.Состояния.НайтиСтроки(Новый Структура("Состояние",Справочники.Состояния.НеобходимаПролонгацияДоговора));
		Для Каждого Стр Из МассивНайденныхСтрок Цикл 
			Стр.Статус = Перечисления.СтатусыЭтапов.Выполнен;
		КонецЦикла;	
		ДоговорОбъект.Записать();	
	КонецЦикла;  
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДоговорОбъект = ВыборкаДетальныеЗаписи.Документ.ПолучитьОбъект();
		МассивНайденныхСтрок = ДоговорОбъект.Состояния.НайтиСтроки(Новый Структура("Состояние",Справочники.Состояния.НеобходимаПролонгацияДоговора));
		Для Каждого Стр Из МассивНайденныхСтрок Цикл 
			ДоговорОбъект.Состояния.Удалить(Стр);
		КонецЦикла;	
		ДоговорОбъект.Записать();	
	КонецЦикла;	

	// ДИТ 0304081 Евсенкин М.А. Конец: 24.03.2023
	
КонецПроцедуры

Процедура ЗанесениеВЧерныйСписокКонтрагентовСЗадолженностью() Экспорт
	
	СрокДляБана = Константы.СрокЗадолженностиДляОтнесенияПокупателяВСтопЛист.Получить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.Контрагент КАК Контрагент,
	               |	РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.Договор КАК Договор,
	               |	РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.СчетПокупателю КАК СчетПокупателю,
	               |	РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.НеразнесеннаяСуммаОстаток КАК НеразнесеннаяСуммаОстаток,
	               |	РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.СчетПокупателю.ДоговорКонтрагента.СрокОплаты КАК СрокОплаты,
	               |	РАЗНОСТЬДАТ(РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.СчетПокупателю.ДатаДокумента, &ТекущаяДата, ДЕНЬ) КАК ПрошлоВремени,
	               |	ВЫБОР
	               |		КОГДА РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.СчетПокупателю.ДоговорКонтрагента.СрокОплаты > РАЗНОСТЬДАТ(РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.СчетПокупателю.ДатаДокумента, &ТекущаяДата, ДЕНЬ)
	               |			ТОГДА 0
	               |		ИНАЧЕ РАЗНОСТЬДАТ(РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.СчетПокупателю.ДатаДокумента, &ТекущаяДата, ДЕНЬ) - РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.СчетПокупателю.ДоговорКонтрагента.СрокОплаты
	               |	КОНЕЦ КАК ПросрочкаПлатежа,
	               |	СтопЛистКонтрагентовСрезПоследних.ВСтопЛисте КАК ВСтопЛисте,
	               |	РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.Договор.Номер КАК НомерДоговора
	               |ИЗ
	               |	РегистрНакопления.РазнесениеСчетовПокупателейПоВходящимПлатежам.Остатки КАК РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтопЛистКонтрагентов.СрезПоследних КАК СтопЛистКонтрагентовСрезПоследних
	               |		ПО РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.Контрагент = СтопЛистКонтрагентовСрезПоследних.Контрагент";
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Ответ = Запрос.Выполнить().Выбрать();
	МассивЗаблокированныхКлиентов = Новый Массив;
	СписокПричин = "";
	КоличествоКонтрагентов = 0;
	СписокКонтрагентов = "";
	Пока Ответ.Следующий() Цикл
		Если МассивЗаблокированныхКлиентов.Найти(Ответ.Контрагент) = неопределено И Ответ.ПросрочкаПлатежа > 0 И Ответ.ВСтопЛисте <> Истина Тогда
			
			Причина = "Просрочка оплаты на сумму " + Ответ.НеразнесеннаяСуммаОстаток + " по договору " + Ответ.НомерДоговора + " на дней " + Ответ.ПросрочкаПлатежа;
			
			МЗ = РегистрыСведений.СтопЛистКонтрагентов.СоздатьМенеджерЗаписи();
			МЗ.ВСтопЛисте = Истина;
			МЗ.Комментарий = "Отнесено автоматически при проверке задолженностей " + ТекущаяДата() + " " + Причина;
			МЗ.Пользователь = Пользователи.ТекущийПользователь();
			МЗ.Период = ТекущаяДата();
			МЗ.Контрагент = Ответ.Контрагент;
			МЗ.Записать(Истина);
			
			КоличествоКонтрагентов = КоличествоКонтрагентов + 1;
			СписокКонтрагентов = СписокКонтрагентов + ", " + Ответ.Контрагент;
			СписокПричин = СписокПричин + ", " + Причина;
			МассивЗаблокированныхКлиентов.Добавить(Ответ.Контрагент);
			
		КонецЕсли;
	КонецЦикла;
	
	Сообщить("Заблокировано: " + КоличествоКонтрагентов + " список: " + СписокКонтрагентов + " причины: " + СписокПричин);
	
КонецПроцедуры

Процедура РассчитатьРейтингКлиентов() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(ПравилаВычисленияРейтингаКлиента.Ссылка) КАК Ссылка
	|ПОМЕСТИТЬ ВТПравило
	|ИЗ
	|	(ВЫБРАТЬ
	|		МАКСИМУМ(ПравилаВычисленияРейтингаКлиента.ДействуетС) КАК ДействуетС
	|	ИЗ
	|		Справочник.ПравилаВычисленияРейтингаКлиента КАК ПравилаВычисленияРейтингаКлиента
	|	ГДЕ
	|		НЕ ПравилаВычисленияРейтингаКлиента.ПометкаУдаления) КАК ВложенныйЗапрос
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПравилаВычисленияРейтингаКлиента КАК ПравилаВычисленияРейтингаКлиента
	|		ПО ВложенныйЗапрос.ДействуетС = ПравилаВычисленияРейтингаКлиента.ДействуетС
	|ГДЕ
	|	НЕ ПравилаВычисленияРейтингаКлиента.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПравилаВычисленияРейтингаКлиентаПараметрыРейтинга.Ссылка КАК Ссылка,
	|	ПравилаВычисленияРейтингаКлиентаПараметрыРейтинга.ЗеленыйС КАК ЗеленыйС,
	|	ПравилаВычисленияРейтингаКлиентаПараметрыРейтинга.ЗеленыйПо КАК ЗеленыйПо,
	|	ПравилаВычисленияРейтингаКлиентаПараметрыРейтинга.ЖелтыйС КАК ЖелтыйС,
	|	ПравилаВычисленияРейтингаКлиентаПараметрыРейтинга.ЖелтыйПо КАК ЖелтыйПо,
	|	ПравилаВычисленияРейтингаКлиентаПараметрыРейтинга.КрасныйС КАК КрасныйС,
	|	ПравилаВычисленияРейтингаКлиентаПараметрыРейтинга.КрасныйПо КАК КрасныйПо,
	|	ПравилаВычисленияРейтингаКлиентаПараметрыРейтинга.Аналитика КАК Критерий,
	|	ПравилаВычисленияРейтингаКлиентаПараметрыРейтинга.АвтоматическийПереводВСтопЛистВКраснойЗоне КАК АвтоматическийПереводВСтопЛистВКраснойЗоне,
	|	ПравилаВычисленияРейтингаКлиентаПараметрыРейтинга.УведомитьОЖелтойЗоне КАК УведомитьОЖелтойЗоне,
	|	ПравилаВычисленияРейтингаКлиентаПараметрыРейтинга.УведомитьОКраснойЗоне КАК УведомитьОКраснойЗоне
	|ИЗ
	|	ВТПравило КАК ВТПравило
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПравилаВычисленияРейтингаКлиента.ПараметрыРейтинга КАК ПравилаВычисленияРейтингаКлиентаПараметрыРейтинга
	|		ПО ВТПравило.Ссылка = ПравилаВычисленияРейтингаКлиентаПараметрыРейтинга.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.Аналитика КАК Критерий,
	|	ВложенныйЗапрос.УровеньРиска КАК УровеньРиска,
	|	ВложенныйЗапрос.Пользователь КАК Пользователь,
	|	ПользователиКонтактнаяИнформация.Представление КАК АдресЭлектроннойПочты
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПравилаВычисленияРейтингаКлиентаПолучателиУведомлений.Аналитика КАК Аналитика,
	|		ПравилаВычисленияРейтингаКлиентаПолучателиУведомлений.УровеньРиска КАК УровеньРиска,
	|		ЕСТЬNULL(ГруппыПользователейСостав.Пользователь, ПравилаВычисленияРейтингаКлиентаПолучателиУведомлений.ПолучательУведомления) КАК Пользователь
	|	ИЗ
	|		ВТПравило КАК ВТПравило
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПравилаВычисленияРейтингаКлиента.ПолучателиУведомлений КАК ПравилаВычисленияРейтингаКлиентаПолучателиУведомлений
	|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыПользователей.Состав КАК ГруппыПользователейСостав
	|				ПО ПравилаВычисленияРейтингаКлиентаПолучателиУведомлений.ПолучательУведомления = ГруппыПользователейСостав.Ссылка
	|			ПО ВТПравило.Ссылка = ПравилаВычисленияРейтингаКлиентаПолучателиУведомлений.Ссылка) КАК ВложенныйЗапрос
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
	|		ПО ВложенныйЗапрос.Пользователь = ПользователиКонтактнаяИнформация.Ссылка
	|			И (ПользователиКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailПользователя))";
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	ТаблицаПравил = РезультатыЗапроса[1].Выгрузить();
	ТаблицаПолучателейУведомлений = РезультатыЗапроса[2].Выгрузить();
	
	ТаблицаКонтрагентовДляСтопЛиста = Новый ТаблицаЗначений;
	ТаблицаКонтрагентовДляСтопЛиста.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаКонтрагентовДляСтопЛиста.Колонки.Добавить("НаименованиеКонтрагента", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	ТаблицаКонтрагентовДляСтопЛиста.Колонки.Добавить("ПоместитьВСтопЛист", Новый ОписаниеТипов("Булево"));
	ТаблицаКонтрагентовДляСтопЛиста.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	
	УровеньРискаСредний = Перечисления.СПАРКЗначенияРисков.Средний;
	УровеньРискаВысокий = Перечисления.СПАРКЗначенияРисков.Высокий;
	
	ТекДата = ТекущаяДатаСеанса();
	
	ПараметрыКурсаРегл = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Константы.ВалютаРегламентированногоУчета.Получить(), ТекДата);
	
	//1. Сумма дебиторской задолженности
	
	Критерий = Перечисления.АналитикиРейтингаКлиентов.СуммаДебиторскойЗадолженности;
	Правило = ТаблицаПравил.Найти(Критерий, "Критерий");
	
	Если Правило <> Неопределено Тогда
	
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТекущаяДата", ТекДата);
