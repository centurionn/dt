	Если НовоеЗадание = неопределено Тогда Возврат; КонецЕсли;
	
	Задание = РегламентныеЗадания.НайтиПредопределенное(Метаданные.РегламентныеЗадания.СтопЛистОбновление);
	Задание.Расписание = НовоеЗадание;
	Задание.Записать();
		
