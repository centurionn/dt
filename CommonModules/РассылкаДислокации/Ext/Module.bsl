
Процедура РассылкаДислокацииВагоновКТККлиентам() Экспорт
	
	// 1. дислокация по вагонам
	ВыборкаВагонов = ДислокацияПоВагонам();
	
	ЗапросРеквизитов = Новый Запрос;
	ЗапросРеквизитов.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	                         |	РассылкаДислокацийРеквизитыВагонов.Клиент КАК Клиент,
	                         |	РассылкаДислокацийРеквизитыВагонов.РеквизитКлиентаВСистеме КАК РеквизитКлиентаВСистеме,
	                         |	РассылкаДислокацийРеквизитыВагонов.РеквизитКлиента КАК РеквизитКлиента
	                         |ИЗ
	                         |	Справочник.РассылкаДислокаций.РеквизитыВагонов КАК РассылкаДислокацийРеквизитыВагонов
	                         |ГДЕ
	                         |	РассылкаДислокацийРеквизитыВагонов.Использование
	                         |	И РассылкаДислокацийРеквизитыВагонов.Ссылка.ДатаНачала <= &ТекДата
	                         |	И РассылкаДислокацийРеквизитыВагонов.Ссылка.ДатаОкончания >= &ТекДата
	                         |	И НЕ РассылкаДислокацийРеквизитыВагонов.Ссылка.ПометкаУдаления";
	ЗапросРеквизитов.УстановитьПараметр("ТекДата", ТекущаяДата());
	ТЗРеквизитов = ЗапросРеквизитов.Выполнить().Выгрузить();
	
	ФормированиеПисьма(ВыборкаВагонов,ТЗРеквизитов,"Вагоны");
	
	// 2. дислокация по контейнерам
	ВыборкаКТК = ДислокацияПоКТК();
	ЗапросРеквизитов = Новый Запрос;
	ЗапросРеквизитов.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	                         |	РассылкаДислокацийРеквизитыКТК.Клиент КАК Клиент,
	                         |	РассылкаДислокацийРеквизитыКТК.РеквизитКлиентаВСистеме КАК РеквизитКлиентаВСистеме,
	                         |	РассылкаДислокацийРеквизитыКТК.РеквизитКлиента КАК РеквизитКлиента
	                         |ИЗ
	                         |	Справочник.РассылкаДислокаций.РеквизитыКТК КАК РассылкаДислокацийРеквизитыКТК
	                         |ГДЕ
	                         |	РассылкаДислокацийРеквизитыКТК.Использование
	                         |	И РассылкаДислокацийРеквизитыКТК.Ссылка.ДатаНачала <= &ТекДата
	                         |	И РассылкаДислокацийРеквизитыКТК.Ссылка.ДатаОкончания >= &ТекДата
	                         |	И НЕ РассылкаДислокацийРеквизитыКТК.Ссылка.ПометкаУдаления";
	ЗапросРеквизитов.УстановитьПараметр("ТекДата", ТекущаяДата());
	ТЗРеквизитов = ЗапросРеквизитов.Выполнить().Выгрузить();
	
	ФормированиеПисьма(ВыборкаКТК,ТЗРеквизитов,"КТК");
	
КонецПроцедуры

Функция ДислокацияПоВагонам()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	РассылкаДислокацийРеквизитыВагонов.Клиент КАК Клиент
	               |ПОМЕСТИТЬ РеквизитыКлиентаВагоны
	               |ИЗ
	               |	Справочник.РассылкаДислокаций.РеквизитыВагонов КАК РассылкаДислокацийРеквизитыВагонов
	               |ГДЕ
	               |	РассылкаДислокацийРеквизитыВагонов.Использование
	               |	И РассылкаДислокацийРеквизитыВагонов.Ссылка.ДатаНачала <= &ТекДата
	               |	И РассылкаДислокацийРеквизитыВагонов.Ссылка.ДатаОкончания >= &ТекДата
	               |	И НЕ РассылкаДислокацийРеквизитыВагонов.Ссылка.ПометкаУдаления
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	СделкаСвязьУчетныхЕдиниц.Вагон КАК Вагон,
	               |	СделкаСвязьУчетныхЕдиниц.Клиент КАК Клиент,
	               |	СделкаСвязьУчетныхЕдиниц.Ссылка КАК Сделка
	               |ПОМЕСТИТЬ ДанныеИзСделки
	               |ИЗ
	               |	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	               |ГДЕ
	               |	(СделкаСвязьУчетныхЕдиниц.Ссылка.ПоследняяОперация >= &ТекДата
	               |			ИЛИ СделкаСвязьУчетныхЕдиниц.Ссылка.ПоследняяОперация = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
	               |	И СделкаСвязьУчетныхЕдиниц.Клиент В
	               |			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |				РеквизитыКлиентаВагоны.Клиент
	               |			ИЗ
	               |				РеквизитыКлиентаВагоны КАК РеквизитыКлиентаВагоны)
	               |	И НЕ СделкаСвязьУчетныхЕдиниц.Вагон = ЗНАЧЕНИЕ(Справочник.ТС.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МАКСИМУМ(ДислокацияВагоновСрезПоследних.Период) КАК Период,
	               |	ДислокацияВагоновСрезПоследних.Вагон КАК Вагон
	               |ПОМЕСТИТЬ МаксПериодДисл
	               |ИЗ
	               |	РегистрСведений.ДислокацияВагонов.СрезПоследних(
	               |			,
	               |			Вагон В
	               |				(ВЫБРАТЬ
	               |					ДанныеИзСделки.Вагон
	               |				ИЗ
	               |					ДанныеИзСделки КАК ДанныеИзСделки)) КАК ДислокацияВагоновСрезПоследних
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ДислокацияВагоновСрезПоследних.Вагон
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДислокацияВагоновСрезПоследних.Период КАК Период,
	               |	ДислокацияВагоновСрезПоследних.Вагон КАК Вагон,
	               |	ДислокацияВагоновСрезПоследних.ОперацияСВагоном КАК ОперацияСВагоном,
	               |	ДислокацияВагоновСрезПоследних.РабочийПарк КАК РабочийПарк,
	               |	ДислокацияВагоновСрезПоследних.Груженый КАК Груженый,
	               |	ДислокацияВагоновСрезПоследних.НомерПоезда КАК НомерПоезда,
	               |	ДислокацияВагоновСрезПоследних.ИндексПоезда КАК ИндексПоезда,
	               |	ДислокацияВагоновСрезПоследних.КодГрузоотправителя КАК КодГрузоотправителя,
	               |	ДислокацияВагоновСрезПоследних.КодГрузополучателя КАК КодГрузополучателя,
	               |	ДислокацияВагоновСрезПоследних.Собственник КАК Собственник,
	               |	ДислокацияВагоновСрезПоследних.КодГрузаЕТСНГ КАК КодГрузаЕТСНГ,
	               |	ДислокацияВагоновСрезПоследних.Груз КАК Груз,
	               |	ДислокацияВагоновСрезПоследних.ВесГруза КАК ВесГруза,
	               |	ДислокацияВагоновСрезПоследних.СтанцияОперации КАК СтанцияОперации,
	               |	ДислокацияВагоновСрезПоследних.СтанцияНазначения КАК СтанцияНазначения,
	               |	ДанныеИзСделки.Клиент КАК Клиент,
	               |	ДанныеИзСделки.Сделка КАК Сделка
	               |ИЗ
	               |	РегистрСведений.ДислокацияВагонов.СрезПоследних(
	               |			,
	               |			(Вагон, Период) В
	               |				(ВЫБРАТЬ
	               |					МаксПериодДисл.Вагон,
	               |					МаксПериодДисл.Период
	               |				ИЗ
	               |					МаксПериодДисл КАК МаксПериодДисл)) КАК ДислокацияВагоновСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеИзСделки КАК ДанныеИзСделки
	               |		ПО ДислокацияВагоновСрезПоследних.Вагон = ДанныеИзСделки.Вагон
	               |ИТОГИ ПО
	               |	Клиент";
	
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДата());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаКлиент = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Возврат ВыборкаКлиент;
	
КонецФункции

Функция ДислокацияПоКТК()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	РассылкаДислокацийРеквизитыКТК.Клиент КАК Клиент
	               |ПОМЕСТИТЬ РеквизитыКлиентаКТК
	               |ИЗ
	               |	Справочник.РассылкаДислокаций.РеквизитыКТК КАК РассылкаДислокацийРеквизитыКТК
	               |ГДЕ
	               |	РассылкаДислокацийРеквизитыКТК.Использование
	               |	И РассылкаДислокацийРеквизитыКТК.Ссылка.ДатаНачала <= &ТекДата
	               |	И РассылкаДислокацийРеквизитыКТК.Ссылка.ДатаОкончания >= &ТекДата
	               |	И НЕ РассылкаДислокацийРеквизитыКТК.Ссылка.ПометкаУдаления
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	СделкаСвязьУчетныхЕдиниц.Контейнер КАК Контейнер,
	               |	СделкаСвязьУчетныхЕдиниц.Клиент КАК Клиент,
	               |	СделкаСвязьУчетныхЕдиниц.Ссылка КАК Сделка
	               |ПОМЕСТИТЬ ДанныеИзСделки
	               |ИЗ
	               |	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	               |ГДЕ
	               |	(СделкаСвязьУчетныхЕдиниц.Ссылка.ПоследняяОперация >= &ТекДата
	               |			ИЛИ СделкаСвязьУчетныхЕдиниц.Ссылка.ПоследняяОперация = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
	               |	И СделкаСвязьУчетныхЕдиниц.Клиент В
	               |			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |				РеквизитыКлиентаКТК.Клиент
	               |			ИЗ
	               |				РеквизитыКлиентаКТК КАК РеквизитыКлиентаКТК)
	               |	И НЕ СделкаСвязьУчетныхЕдиниц.Контейнер = ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МАКСИМУМ(ДислокацияКонтейнеровСрезПоследних.Период) КАК Период,
	               |	ДислокацияКонтейнеровСрезПоследних.Контейнер КАК Контейнер
	               |ПОМЕСТИТЬ МаксПериодДисл
	               |ИЗ
	               |	РегистрСведений.ДислокацияКонтейнеров.СрезПоследних(
	               |			,
	               |			Контейнер В
	               |				(ВЫБРАТЬ
	               |					ДанныеИзСделки.Контейнер
	               |				ИЗ
	               |					ДанныеИзСделки КАК ДанныеИзСделки)) КАК ДислокацияКонтейнеровСрезПоследних
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ДислокацияКонтейнеровСрезПоследних.Контейнер
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДислокацияКонтейнеровСрезПоследних.Период КАК Период,
	               |	ДислокацияКонтейнеровСрезПоследних.Контейнер КАК Контейнер,
	               |	ДислокацияКонтейнеровСрезПоследних.ОперацияСВагоном КАК ОперацияСВагоном,
	               |	ДислокацияКонтейнеровСрезПоследних.ТипКонтейнера КАК ТипКонтейнера,
	               |	ДислокацияКонтейнеровСрезПоследних.Груженый КАК Груженый,
	               |	ДислокацияКонтейнеровСрезПоследних.СтранаОтправления КАК СтранаОтправления,
	               |	ДислокацияКонтейнеровСрезПоследних.СтранаНазначения КАК СтранаНазначения,
	               |	ДислокацияКонтейнеровСрезПоследних.НомерНакладной КАК НомерНакладной,
	               |	ДислокацияКонтейнеровСрезПоследних.Груз КАК Груз,
	               |	ДислокацияКонтейнеровСрезПоследних.КодГрузаЕТСНГ КАК КодГрузаЕТСНГ,
	               |	ДислокацияКонтейнеровСрезПоследних.ВесГруза КАК ВесГруза,
	               |	ДислокацияКонтейнеровСрезПоследних.ИндексПоезда КАК ИндексПоезда,
	               |	ДислокацияКонтейнеровСрезПоследних.Вагон КАК Вагон,
	               |	ДислокацияКонтейнеровСрезПоследних.НомерППВ КАК НомерППВ,
	               |	ДислокацияКонтейнеровСрезПоследних.СтанцияПогрузкиКонтейнера КАК СтанцияПогрузкиКонтейнера,
	               |	ДислокацияКонтейнеровСрезПоследних.СтанцияПогрузкиВагона КАК СтанцияПогрузкиВагона,
	               |	ДислокацияКонтейнеровСрезПоследних.СтанцияОперации КАК СтанцияОперации,
	               |	ДислокацияКонтейнеровСрезПоследних.СтанцияНазначения КАК СтанцияНазначения,
	               |	ДанныеИзСделки.Клиент КАК Клиент,
	               |	ДанныеИзСделки.Сделка КАК Сделка
	               |ИЗ
	               |	РегистрСведений.ДислокацияКонтейнеров.СрезПоследних(
	               |			,
	               |			(Контейнер, Период) В
	               |				(ВЫБРАТЬ
	               |					МаксПериодДисл.Контейнер,
	               |					МаксПериодДисл.Период
	               |				ИЗ
	               |					МаксПериодДисл КАК МаксПериодДисл)) КАК ДислокацияКонтейнеровСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеИзСделки КАК ДанныеИзСделки
	               |		ПО ДислокацияКонтейнеровСрезПоследних.Контейнер = ДанныеИзСделки.Контейнер
	               |ИТОГИ ПО
	               |	Клиент";
	
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДата());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаКлиент = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Возврат ВыборкаКлиент;

КонецФункции

Процедура ФормированиеПисьма(ВыборкаКлиент,ТЗРеквизитов,ТипДислокации)
	
	// первичная проверка на то, что мы вообще можем что-то отправить
	УчетнаяЗаписьПоУмолчанию = РаботаСПочтовымиСообщениями.ПроверитьСистемнаяУчетнаяЗаписьДоступна();
	
	Если не УчетнаяЗаписьПоУмолчанию Тогда 
		возврат; 
	КонецЕсли;
	СистемнаяУчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	Пока ВыборкаКлиент.Следующий() Цикл
		
		ГУИДОтправки = Новый УникальныйИдентификатор;
		
		ТабРеквизитов = Новый ТаблицаЗначений;
		ТабРеквизитов.Колонки.Добавить("ИмяРеквизита");
		
		Если ТипДислокации = "КТК" Тогда
			Тема = "Дислокация контейнеров";
		Иначе
			Тема = "Дислокация вагонов";
		КонецЕсли;
		
		ТекстПисьма = "";
		ПолучателиПисьма = Новый Массив;
		
		ПараметрыОтправкиПисьма = новый Структура;
		ПараметрыОтправкиПисьма.Вставить("Тема", Тема);
		ПараметрыОтправкиПисьма.Вставить("Тело", ТекстПисьма);
		ПараметрыОтправкиПисьма.Вставить("ТипТекста", "HTML");
		EMAIL = ПолучитьEMAILПользователя(ВыборкаКлиент.Клиент);
		Если ЗначениеЗаполнено(EMAIL) Тогда
			Для каждого ЭлПочты из СтрРазделить(EMAIL, ";", Ложь) Цикл
				ПолучателиПисьма.Добавить(Новый Структура("Представление, Адрес", Строка(ВыборкаКлиент.Клиент), ЭлПочты));
			КонецЦикла;
		КонецЕсли;
		ПараметрыОтправкиПисьма.Вставить("Кому", ПолучателиПисьма);

		ТабДок = Новый ТабличныйДокумент;
		ТабДок.АвтоМасштаб = Истина;
			
		Макет = Справочники.РассылкаДислокаций.ПолучитьМакет("МакетРассылки");
		ТабДок.НачатьАвтогруппировкуКолонок();
		
		Для Каждого Стр Из ТЗРеквизитов Цикл
			ТекИмя = Стр.РеквизитКлиента;
				
			ШапкаТаб = Макет.ПолучитьОбласть("R1C1");
			ШапкаТаб.Область("R1C1").Текст = ТекИмя;
			ТабДок.Присоединить(ШапкаТаб);
		КонецЦикла;
		
		ВыборкаДетальныеЗаписи = ВыборкаКлиент.Выбрать();
	
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			// получить таблицу ТОЛЬКО с нужными реквизитами
			НомерСтр = 1;
			НомерСтолбца = 1;
			СтрокаТаб = Макет.ПолучитьОбласть("R"+НомерСтр+"C1");
			Для Каждого Стр Из ТЗРеквизитов Цикл
				Попытка
					ТекДанные = ВыборкаДетальныеЗаписи[Стр.РеквизитКлиентаВСистеме];
					
					СтрокаТаб = Макет.ПолучитьОбласть("R"+НомерСтр+"C1");
					СтрокаТаб.Область("R"+НомерСтр+"C1").Текст = ТекДанные;
					Если НомерСтолбца = 1 Тогда
						ТабДок.Вывести(СтрокаТаб);
					Иначе
						ТабДок.Присоединить(СтрокаТаб);
					КонецЕсли;
				Исключение
				КонецПопытки;
				НомерСтолбца = НомерСтолбца + 1;
			КонецЦикла;
			НомерСтр = НомерСтр + 1;
			
			// внести данные в регистр, после отправки по почте, обновить сведения по дате отправки
			МЗ = РегистрыСведений.РассылкаДислокаций.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(МЗ,ВыборкаДетальныеЗаписи);
			МЗ.ГУИДОтправки = Строка(ГУИДОтправки);
			МЗ.Записать(Истина);

			
		КонецЦикла;
		
		// сформировать табличный документ
		ТабДок.ЗакончитьАвтогруппировкуКолонок();
		ТабДок.ОтображатьСетку = Истина;
		ТабДок.Защита = Ложь;
		ТабДок.ТолькоПросмотр = Истина;		
		ИмяФайла = ПолучитьИмяВременногоФайла("xlsx");
		ТабДок.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.XLSX);
		
		ФайлВложения = Новый ДвоичныеДанные(ИмяФайла);
		Соответствие = Новый Соответствие();
		Соответствие.Вставить("Дислокация для клиента.xlsx",ФайлВложения);

		ПараметрыОтправкиПисьма.Вставить("Вложения", Соответствие);

		РЕЗУЛЬТАТ = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(СистемнаяУчетнаяЗапись, ПараметрыОтправкиПисьма);
		
		// по ГУИД отправки находим все записи, которые отправили клиенту и проставляем по ним дату отправки и признак отправки
		Если ЗначениеЗаполнено(РЕЗУЛЬТАТ) Тогда
			НаборЗаписей = РегистрыСведений.РассылкаДислокаций.СоздатьНаборЗаписей();  			
			НаборЗаписей.Отбор.ГУИДОтправки.Установить(ГУИДОтправки);
			НаборЗаписей.Прочитать();
			Для Каждого Запись Из НаборЗаписей Цикл 
				Запись.ДатаОтправки = ТекущаяДата();
				Запись.Отправлено = Истина;
			КонецЦикла;
			НаборЗаписей.Записать();
		КонецЕсли;
		
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьEMAILПользователя(Контрагент) 
	
	Результат = "";
	Для каждого Стр из Контрагент.КонтактнаяИнформация Цикл
		Если ЗначениеЗаполнено(Стр.АдресЭП) тогда
			Результат = Стр.Представление;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Процедура РассылкаДислокацииКлиентам() Экспорт
	
	РассылкаДислокацииВагоновКТККлиентам();
	
КонецПроцедуры

Процедура РассылкаПоОперациям() Экспорт
	
	РассылкаПоОперациямПользователям();
	
КонецПроцедуры

Процедура РассылкаПоОперациямПользователям() Экспорт
	
	// первичная проверка на то, что мы вообще можем что-то отправить
	УчетнаяЗаписьПоУмолчанию = РаботаСПочтовымиСообщениями.ПроверитьСистемнаяУчетнаяЗаписьДоступна();
	
	Если не УчетнаяЗаписьПоУмолчанию Тогда 
		возврат; 
	КонецЕсли;
	СистемнаяУчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РассылкаПоОперациям.Период КАК Период,
		|	РассылкаПоОперациям.Вагон КАК Вагон,
		|	РассылкаПоОперациям.Контейнер КАК Контейнер,
		|	РассылкаПоОперациям.Операция КАК Операция,
		|	ВЫБОР
		|		КОГДА РассылкаПоОперациям.Контейнер = ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяССылка)
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ВагоннаяДислокация
		|ПОМЕСТИТЬ ДислокацияТСТЕ
		|ИЗ
		|	РегистрСведений.РассылкаПоОперациям КАК РассылкаПоОперациям
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДислокацияТСТЕ.Период КАК Период,
		|	ДислокацияТСТЕ.Вагон КАК Вагон,
		|	ДислокацияТСТЕ.Контейнер КАК Контейнер,
		|	ДислокацияТСТЕ.Операция КАК Операция,
		|	ДислокацияТСТЕ.ВагоннаяДислокация КАК ВагоннаяДислокация,
		|	ОперацииСВагонамиСписокПользователей.Пользователь КАК Пользователь
		|ИЗ
		|	ДислокацияТСТЕ КАК ДислокацияТСТЕ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОперацииСВагонами.СписокПользователей КАК ОперацииСВагонамиСписокПользователей
		|		ПО ДислокацияТСТЕ.Операция = ОперацииСВагонамиСписокПользователей.Ссылка
		|ИТОГИ ПО
		|	Пользователь,
		|	ВагоннаяДислокация";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаПользователь = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПользователь.Следующий() Цикл
		ВыборкаВагоннаяДислокация = ВыборкаПользователь.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		// одно письмо для каждого пользователя
		Тема = "Контролируемые операции";
		ТекстПисьма = "";
		ПолучателиПисьма = Новый Массив;
		
		ПараметрыОтправкиПисьма = новый Структура;
		ПараметрыОтправкиПисьма.Вставить("Тема", Тема);
		ПараметрыОтправкиПисьма.Вставить("Тело", ТекстПисьма);
		ПараметрыОтправкиПисьма.Вставить("ТипТекста", "HTML");
		EMAIL = ПолучитьEMAILПользователя(ВыборкаПользователь.Пользователь);
		Если ЗначениеЗаполнено(EMAIL) Тогда
			Для каждого ЭлПисьма из СтрРазделить(EMAIL, ";", Ложь) Цикл
				ПолучателиПисьма.Добавить(Новый Структура("Представление, Адрес", Строка(ВыборкаПользователь.Пользователь), ЭлПисьма));
			КонецЦикла;
		КонецЕсли;
		ПараметрыОтправкиПисьма.Вставить("Кому", ПолучателиПисьма);
		// для вложений
		Соответствие = Новый Соответствие();
		
		Пока ВыборкаВагоннаяДислокация.Следующий() Цикл
			ВыборкаДетальныеЗаписи = ВыборкаВагоннаяДислокация.Выбрать();
			
			// в зависсимости от того, вагонная или контейнерная дислокация, формируются разные макеты
			ТабДок = Новый ТабличныйДокумент;
			ТабДок.АвтоМасштаб = Истина;
			
			Если ВыборкаВагоннаяДислокация.ВагоннаяДислокация = 1 Тогда
				Макет = РегистрыСведений.РассылкаПоОперациям.ПолучитьМакет("МакетРассылкиВагоны");
			Иначе
				Макет = РегистрыСведений.РассылкаПоОперациям.ПолучитьМакет("МакетРассылкиКТК");
			КонецЕсли;
			
			ТабДок.НачатьАвтогруппировкуКолонок();
			
			// заполнение таблицы макета
			Область = Макет.ПолучитьОбласть("ОбластьШапка"); 
			ТабДок.Вывести(Область);
			
			НомерСтр = 1;
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				Область = Макет.ПолучитьОбласть("ОбластьСтроки"); 
				Область.Параметры.Заполнить(ВыборкаДетальныеЗаписи);
				Область.Параметры.НомерПП = НомерСтр;
				ТабДок.Вывести(Область);
				
				НомерСтр = НомерСтр+1;
				
			КонецЦикла;
			
			// сформировать табличный документ
			ТабДок.ЗакончитьАвтогруппировкуКолонок();
			ТабДок.ОтображатьСетку = Истина;
			ТабДок.Защита = Ложь;
			ТабДок.ТолькоПросмотр = Истина;		
			ИмяФайла = ПолучитьИмяВременногоФайла("xlsx");
			ТабДок.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.XLSX);
			
			ФайлВложения = Новый ДвоичныеДанные(ИмяФайла);
			Если ВыборкаВагоннаяДислокация.ВагоннаяДислокация = 1 Тогда
				Соответствие.Вставить("Операции по вагонам.xlsx",ФайлВложения);
			Иначе
				Соответствие.Вставить("Операции по контейнерам.xlsx",ФайлВложения);
			КонецЕсли;

			ПараметрыОтправкиПисьма.Вставить("Вложения", Соответствие);

		КонецЦикла;
		
		РЕЗУЛЬТАТ = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(СистемнаяУчетнаяЗапись, ПараметрыОтправкиПисьма);

	КонецЦикла;

	// очистить данные регистра
	НаборЗаписей = РегистрыСведений.РассылкаПоОперациям.СоздатьНаборЗаписей();  			
	НаборЗаписей.Записать();
	
КонецПроцедуры

