Функция ПолучитьПараметрыРасчетаДлительностиУслуги(Номенклатура) Экспорт
	
	Возврат Новый Структура("ДлительностьСчитаетсяПоНормативуПерегонаПорожнего,ДлительностьСчитаетсяПоНормативуПерегонаГруженого, Пробег", Номенклатура.ДлительностьСчитаетсяПоНормативуПерегонаПорожнего,Номенклатура.ДлительностьСчитаетсяПоНормативуПерегонаГруженого, Номенклатура.ДляУслугиУказываетсяПробег);
	
КонецФункции

Функция ПолучитьУслугуПоКоду(КодУслуги) Экспорт
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Номенклатура.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |ГДЕ
	               |	Номенклатура.Код = &Код";
	Запрос.УстановитьПараметр("Код", КодУслуги);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСуммуАРМКонтроляСписаний(Сделка, ГУИД, СписокКТКСтрокой, Услуга) Экспорт
	
	РезультатСумма = 0;
	
	// 1. Ищем данные строки по ГУИДу. Это вариант по-умолчанию;
	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ
	                |	СУММА(ФактическиеСуммыНакладныхОтнесенныеНаЗатратыСделок.ОтнесеннаяСумма) КАК ОтнесеннаяСумма
	                |ИЗ
	                |	РегистрСведений.ФактическиеСуммыНакладныхОтнесенныеНаЗатратыСделок КАК ФактическиеСуммыНакладныхОтнесенныеНаЗатратыСделок
	                |ГДЕ
	                |	ФактическиеСуммыНакладныхОтнесенныеНаЗатратыСделок.Сделка = &Сделка
	                |	И ФактическиеСуммыНакладныхОтнесенныеНаЗатратыСделок.ГУИДРасходов = &ГУИДРасходов" ;
	Запрос.УстановитьПараметр("Сделка", Сделка);
	Запрос.УстановитьПараметр("ГУИДРасходов", ГУИД);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		
		РезультатСумма = Ответ.ОтнесеннаяСумма;
		
	Иначе
		
		// 2. Если данных по ГУИДу нет, то, возможно, после разнесения расходы были перезаполнены. Это нежелательный вариант, но мы должны его отработать;
		
		Запрос2 = Новый Запрос;
		Запрос2.Текст = "ВЫБРАТЬ
		                |	ФактическиеСуммыНакладныхОтнесенныеНаЗатратыСделок.Сделка КАК Сделка,
		                |	ФактическиеСуммыНакладныхОтнесенныеНаЗатратыСделок.Услуга КАК Услуга,
		                |	ФактическиеСуммыНакладныхОтнесенныеНаЗатратыСделок.КТК КАК КТК,
		                |	ФактическиеСуммыНакладныхОтнесенныеНаЗатратыСделок.ГУИДРасходов КАК ГУИДРасходов,
		                |	ФактическиеСуммыНакладныхОтнесенныеНаЗатратыСделок.ОтнесеннаяСумма КАК ОтнесеннаяСумма
		                |ИЗ
		                |	РегистрСведений.ФактическиеСуммыНакладныхОтнесенныеНаЗатратыСделок КАК ФактическиеСуммыНакладныхОтнесенныеНаЗатратыСделок
		                |ГДЕ
		                |	ФактическиеСуммыНакладныхОтнесенныеНаЗатратыСделок.Сделка = &Сделка
		                |	И ФактическиеСуммыНакладныхОтнесенныеНаЗатратыСделок.Услуга = &Услуга";
		Запрос2.УстановитьПараметр("Сделка", Сделка);
		Запрос2.УстановитьПараметр("Услуга", Услуга);
		Ответ2 = Запрос2.Выполнить().Выбрать();
		Пока Ответ2.Следующий() Цикл
			Если Найти(Ответ2.КТК, СписокКТКСтрокой) <> 0 Тогда
				РезультатСумма = РезультатСумма + Ответ2.ОтнесеннаяСумма;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат РезультатСумма;
	
КонецФункции