Функция ПолучитьСтрокуXMLТаблицыЗначенийДляФорматаСтороннейСистемы(ТЗизТабличногоДокумента)

	ЗаписьXML = Новый ЗаписьXML; 
	ЗаписьXML.УстановитьСтроку();
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("ТаблицаДанных");
	
	Для счетчикСтрок = 0 По ТЗизТабличногоДокумента.Количество()-1 Цикл
		ЗаписьXML.ЗаписатьНачалоЭлемента("Строка");
		Для Каждого Колонка Из ТЗизТабличногоДокумента.Колонки Цикл
			ИмяАтрибута = Колонка.Заголовок;
			ЗначениеАтрибута = ТЗизТабличногоДокумента[счетчикСтрок][Колонка.Имя];
			ЗаписьXML.ЗаписатьАтрибут(ИмяАтрибута,Строка(ЗначениеАтрибута));
		КонецЦикла;
		ЗаписьXML.ЗаписатьКонецЭлемента();
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	СтрокаXML = ЗаписьXML.Закрыть();
	
	Возврат СтрокаXML;
	
КонецФункции
//Евросиб(ДИТ), Беляев СЮ, US 84787 / TA 93129, 24-10-2024, конец

