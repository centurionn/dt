Функция ПолучитьОтчетПоТокену(XMLParams) Экспорт
	
	Если СтрНайти(XMLParams, "ЗапросОтчетаDataCore") > 0 Тогда
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("ТокенПолученияОтчета", "");
		
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(XMLParams);
		Пока Чтение.Прочитать() Цикл
			Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И Чтение.Имя = "ТокенПолученияОтчета" Тогда
				Чтение.Прочитать();
				СтруктураПараметров.Вставить("ТокенПолученияОтчета", Чтение.Значение);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	Иначе 
		
		СтруктураПараметров = ОбщегоНазначения.ЗначениеИзСтрокиXML(XMLParams);
		
	КонецЕсли;
	
	ОписаниеОшибки = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОчередьФормированияОтчетовПоЗапросу.Токен КАК Токен,
		|	ОчередьФормированияОтчетовПоЗапросу.НастройкаОтчетаПоЗапросу КАК НастройкаОтчетаПоЗапросу,
		|	ОчередьФормированияОтчетовПоЗапросу.РезультатФормирования КАК РезультатФормирования,
		|	ОчередьФормированияОтчетовПоЗапросу.Сформирован КАК Сформирован
		|ИЗ
		|	РегистрСведений.ОчередьФормированияОтчетовПоЗапросу КАК ОчередьФормированияОтчетовПоЗапросу
		|ГДЕ
		|	ОчередьФормированияОтчетовПоЗапросу.Токен = &Токен";
	
	Запрос.УстановитьПараметр("Токен", СтруктураПараметров.ТокенПолученияОтчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Если Выборка.Сформирован Тогда
			СтрокаXML = Выборка.РезультатФормирования.Получить();
			РегистрыСведений.ОчередьФормированияОтчетовПоЗапросу.ЗафиксироватьОтправкуОтчета(Выборка.Токен, Выборка.НастройкаОтчетаПоЗапросу);	
		Иначе
			ОписаниеОшибки = "Отчет не сформирован";
		КонецЕсли;
	Иначе 
		ОписаниеОшибки = "Не найден запрос по токену - "+СтруктураПараметров.ТокенПолученияОтчета;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		ЗаписьXML = Новый ЗаписьXML; 
		ЗаписьXML.УстановитьСтроку();
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		ЗаписьXML.ЗаписатьНачалоЭлемента("Ответ");
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Ошибка");
		ЗаписьXML.ЗаписатьТекст(XMLСтрока(ОписаниеОшибки));
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		ЗаписьXML.ЗаписатьКонецЭлемента();
		СтрокаXML = ЗаписьXML.Закрыть()
	КонецЕсли;
	
	Возврат СтрокаXML;
КонецФункции
//Евросиб(ДИТ), Беляев СЮ, US 84787 / TA 93129, 24-10-2024, конец

//Евросиб(ДИТ), Беляев СЮ, US 84787 / TA 93129, 24-10-2024, начало
Функция ОбразецВходящегоЗапросаНаСервере(Ссылка) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ЗапросФормированияОтчета","");
	Результат.Вставить("ЗапросОтчетаПоТокену","");
	
	ПараметрыОтчета = Новый Структура;
	ОтчетПоЗапросу = "";
	ФорматДанныхОбмена = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиОтчетовПоЗапросуПараметрыОтчета.НаименованиеПараметраВходного КАК НаименованиеПараметраВходного,
		|	НастройкиОтчетовПоЗапросуПараметрыОтчета.Ссылка.Наименование КАК Наименование,
		|	НастройкиОтчетовПоЗапросуПараметрыОтчета.ПримерЗначения КАК ПримерЗначения,
		|	НастройкиОтчетовПоЗапросуПараметрыОтчета.Ссылка.ФорматДанныхОбмена КАК ФорматДанныхОбмена
		|ИЗ
		|	Справочник.НастройкиОтчетовПоЗапросу.ПараметрыОтчета КАК НастройкиОтчетовПоЗапросуПараметрыОтчета
		|ГДЕ
		|	НастройкиОтчетовПоЗапросуПараметрыОтчета.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ОтчетПоЗапросу = ВыборкаДетальныеЗаписи.Наименование;
		ФорматДанныхОбмена = ВыборкаДетальныеЗаписи.ФорматДанныхОбмена;
		ПараметрыОтчета.Вставить(ВыборкаДетальныеЗаписи.НаименованиеПараметраВходного, ВыборкаДетальныеЗаписи.ПримерЗначения);
	КонецЦикла;
	
	Если ФорматДанныхОбмена = Справочники.НастройкиОтчетовПоЗапросу.КодФорматаДанныхДля1С() Тогда
		
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("ИмяОтчета", СокрЛП(ОтчетПоЗапросу));
		СтруктураДанных.Вставить("ПараметрыОтчета", ПараметрыОтчета);
		Результат.ЗапросФормированияОтчета =  ПолучитьСтрокуXMLдляФормата1С(СтруктураДанных);
		
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("ТокенПолученияОтчета", Строка(Новый УникальныйИдентификатор));
		Результат.ЗапросОтчетаПоТокену =  ПолучитьСтрокуXMLдляФормата1С(СтруктураДанных);
		
	ИначеЕсли ФорматДанныхОбмена = Справочники.НастройкиОтчетовПоЗапросу.КодФорматаДанныхДляСтороннейСистемы() Тогда
		
		ЗаписьXML = Новый ЗаписьXML; 
		ЗаписьXML.УстановитьСтроку();
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		ЗаписьXML.ЗаписатьНачалоЭлемента("ЗапросОтчетаDataCore");
		ЗаписьXML.ЗаписатьАтрибут("ИмяОтчета", ОтчетПоЗапросу);
		ЗаписьXML.ЗаписатьНачалоЭлемента("Параметры");
		Для Каждого Параметр Из ПараметрыОтчета Цикл
			ЗаписьXML.ЗаписатьАтрибут(Параметр.Ключ, XMLСтрока(Параметр.Значение));
		КонецЦикла;
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
		Результат.ЗапросФормированияОтчета = ЗаписьXML.Закрыть();
		
		ЗаписьXML = Новый ЗаписьXML; 
		ЗаписьXML.УстановитьСтроку();
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		ЗаписьXML.ЗаписатьНачалоЭлемента("ЗапросОтчетаDataCore");
		ЗаписьXML.ЗаписатьНачалоЭлемента("ТокенПолученияОтчета");
		ЗаписьXML.ЗаписатьТекст(XMLСтрока(Новый УникальныйИдентификатор));
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
		Результат.ЗапросОтчетаПоТокену = ЗаписьXML.Закрыть();
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
//Евросиб(ДИТ), Беляев СЮ, US 84787 / TA 93129, 24-10-2024, конец

