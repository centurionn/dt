Процедура ОчисткаОчередиФормированияОтчетовПоЗапросу() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОчередьФормированияОтчетовПоЗапросу.Токен КАК Токен,
		|	ОчередьФормированияОтчетовПоЗапросу.НастройкаОтчетаПоЗапросу КАК НастройкаОтчетаПоЗапросу
		|ИЗ
		|	РегистрСведений.ОчередьФормированияОтчетовПоЗапросу КАК ОчередьФормированияОтчетовПоЗапросу
		|ГДЕ
		|	ОчередьФормированияОтчетовПоЗапросу.Сформирован
		|	И ОчередьФормированияОтчетовПоЗапросу.ДатаХраненияРезультата <= &ТекущаяДата
		|	И ОчередьФормированияОтчетовПоЗапросу.ДатаХраненияРезультата <> ДАТАВРЕМЯ(1, 1, 1)";
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		МенеджерЗаписи = РегистрыСведений.ОчередьФормированияОтчетовПоЗапросу.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Токен = ВыборкаДетальныеЗаписи.Токен;
		МенеджерЗаписи.НастройкаОтчетаПоЗапросу = ВыборкаДетальныеЗаписи.НастройкаОтчетаПоЗапросу;
		
		МенеджерЗаписи.Прочитать();
		МенеджерЗаписи.РезультатФормирования = Неопределено;
		МенеджерЗаписи.Записать();
		
	КонецЦикла;

КонецПроцедуры
//Евросиб(ДИТ), Беляев СЮ, US 84787 / TA 93129, 24-10-2024, конец