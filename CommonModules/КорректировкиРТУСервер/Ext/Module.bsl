		ИмяТаблицыДанных = "КорректировкаРеализации.Услуги";
	КонецЕсли;
	
	
	//ДИТ Шевченко А.В. TASK 53499 04.07.2022 -Добавил в запрос поле "Всего" 
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеализацияТоваровУслугУслуги.Номенклатура КАК Номенклатура,
	               |	РеализацияТоваровУслугУслуги.Содержание КАК Содержание,
	               |	РеализацияТоваровУслугУслуги.Количество КАК Количество,
	               |	РеализацияТоваровУслугУслуги.СтавкаНДС КАК СтавкаНДС,
	               |	РеализацияТоваровУслугУслуги.Цена КАК Цена,
	               |	РеализацияТоваровУслугУслуги.Сумма КАК Сумма,
				   |	ВЫБОР
		           |		КОГДА РеализацияТоваровУслугУслуги.Ссылка.СуммаВключаетНДС
		           |			ТОГДА РеализацияТоваровУслугУслуги.Сумма
		           |		ИНАЧЕ РеализацияТоваровУслугУслуги.Сумма + РеализацияТоваровУслугУслуги.СуммаНДС
		           |	КОНЕЦ КАК Всего,
	               |	РеализацияТоваровУслугУслуги.СуммаНДС КАК СуммаНДС,
	               |	РеализацияТоваровУслугУслуги.СтрокаДоходовСделки КАК СтрокаДоходовСделки
	               |ИЗ
	               |	Документ."+ИмяТаблицыДанных+" КАК РеализацияТоваровУслугУслуги
	               |ГДЕ
	               |	РеализацияТоваровУслугУслуги.Ссылка = &Ссылка";
		
	Запрос.УстановитьПараметр("Ссылка", ДокументЪ);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		//НовСтрКорр = Новый Структура("ПунктОтправления,ПунктНазначения,ЕдиницаИзмерения,КлючСтроки,СтрокаДоходовСделкиДоИзменения,Номенклатура,Содержание,Количество,Цена,Сумма,СтавкаНДС,СуммаНДС,СодержаниеДоИзменения,КоличествоДоИзменения,ЦенаДоИзменения,СуммаДоИзменения,СуммаНДСДоИзменения,СтавкаНДСДоИзменения,КоличествоДоКорректировки,ЦенаДоКорректировки,СуммаДоКорректировки,СуммаНДСДоКорректировки,СписокТС,СписокТЕ,СписокТД,СтрокаДоходовСделки,ЕстьВДокументеРеализации,ВсегоДоКорректировки,ВсегоДоИзменения,Всего,ПериодВО,СтавкаНДСДоКорректировки");
		//Евросиб(ДИТ), Беляев СЮ, US 115224 / TA 115264, 25-07-2025, начало
		НовСтрКорр = Новый Структура("ПунктОтправления,ПунктНазначения,ЕдиницаИзмерения,КлючСтроки,СтрокаДоходовСделкиДоИзменения,Номенклатура,Содержание,Количество,Цена,Сумма,СтавкаНДС,СуммаНДС,СодержаниеДоИзменения,КоличествоДоИзменения,ЦенаДоИзменения,СуммаДоИзменения,СуммаНДСДоИзменения,СтавкаНДСДоИзменения,КоличествоДоКорректировки,ЦенаДоКорректировки,СуммаДоКорректировки,СуммаНДСДоКорректировки,СписокТС,СписокТЕ,СписокТД,СтрокаДоходовСделки,ЕстьВДокументеРеализации,ВсегоДоКорректировки,ВсегоДоИзменения,Всего,ПериодВО,СтавкаНДСДоКорректировки,ДатаОказанияУслуги");
		//Евросиб(ДИТ), Беляев СЮ, US 115224 / TA 115264, 25-07-2025, конец
		ДанныеПервичногоДокумента = КорректировкиРТУСервер.ПолучитьДанныеПервичногоДокумента(ДокументЪ, Ответ.СтрокаДоходовСделки);
		ЗаполнитьЗначенияСвойств(НовСтрКорр, ДанныеПервичногоДокумента);
		
		НовСтрКорр.Номенклатура = Ответ.Номенклатура;
		НовСтрКорр.ПериодВО = ПериодБлокировки8;
		НовСтрКорр.Содержание = Ответ.Содержание;
		НовСтрКорр.КоличествоДоКорректировки = Ответ.Количество;
		НовСтрКорр.ЦенаДоКорректировки = Ответ.Цена;
		НовСтрКорр.СуммаДоКорректировки = Ответ.Сумма;
		НовСтрКорр.СуммаНДСДоКорректировки = Ответ.СуммаНДС;
		//ДИТ Шевченко А.В. TASK 53499 04.07.2022 - Начало
		НовСтрКорр.ВсегоДоКорректировки = Ответ.Всего; //Ответ.Сумма;
		//ДИТ Шевченко А.В. TASK 53499 04.07.2022 - Конец
		//ДИТ Шевченко А.В. TASK 56137 04.07.2022 - Начало
		НовСтрКорр.СтавкаНДСДоКорректировки = Ответ.СтавкаНДС;
		//ДИТ Шевченко А.В. TASK 56137 04.07.2022 - Конец
		НовСтрКорр.ЕстьВДокументеРеализации = Истина;
		НовСтрКорр.СтрокаДоходовСделкиДоИзменения = Ответ.СтрокаДоходовСделки;
		МассивКорректируемыхСтрок.Добавить(НовСтрКорр);
		
	КонецЦикла;

	МасУчЕд = Неопределено;
	Рез = КорректировкиРТУСервер.СоздатьКоррРТУПоПараметрам(ДокументЪ, МассивКорректируемыхСтрок, МасУчЕд, ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование"));

	Возврат Рез;
	
КонецФункции

Функция СоздатьАннулированиеВознагражденияИзСписка(ДокументЪ) Экспорт
	
	// Проверим, что на указанный документ нет другого аннулирования
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КорректировкаРеализации.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.КорректировкаРеализации КАК КорректировкаРеализации
	               |ГДЕ
	               |	КорректировкаРеализации.ПометкаУдаления = ЛОЖЬ
	               |	И КорректировкаРеализации.ДокументРеализации = &ДокументРеализации
	               |	И КорректировкаРеализации.ЭтоИзменениеВознаграждения = ИСТИНА";
	Запрос.УстановитьПараметр("ДокументРеализации", ДокументЪ);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Сообщить("На указанный документ уже введено аннулирование вознаграждения " + Ответ.Ссылка);
		Возврат неопределено;
	КонецЕсли;
	
	//Евросиб Каблов 09.04.2025 ( #105407
	//ПериодБлокировки8 = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериод(ДокументЪ.Организация);
	ПериодБлокировки8 = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериодДоходов(ДокументЪ.Организация);
	//Евросиб Каблов 09.04.2025 )
	
	ПредыдущееВознаграждение = Новый Структура("Сумма, СтавкаНДС, СуммаНДС", 0, неопределено, 0);
	Если ТипЗнч(ДокументЪ) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
		ПредыдущееВознаграждение = КорректировкиРТУСервер.ПолучитьПредыдущееВознаграждение(ДокументЪ);
	КонецЕсли;
	
	Если ПредыдущееВознаграждение.Сумма = 0 Тогда
		
		Сообщить("Не найдено предыдущее вознаграждение по отчету комитенту. Аннулировать вознаграждение невозможно.");
		Возврат неопределено;
		
	КонецЕсли;
	
	УсловияВознагражденияОтчета = КорректировкиРТУСервер.ПолучитьУсловияВознагражденияОтчета(ДокументЪ);
	
	Если НЕ ЗначениеЗаполнено(УсловияВознагражденияОтчета.СпособРасчетаКомиссионногоВознаграждения) Тогда
		Сообщить("Не удалось получить настройки Отчета агента. Обратитесь в техподдержку.");
		Возврат неопределено;
	КонецЕсли;
	
	МассивКорректируемыхСтрок = Новый массив;
	
	//НовСтрКорр = Новый Структура("НДСВклВСтоимость,СтрокаДоходовСделкиДоИзменения,Номенклатура,Содержание,Количество,Цена,Сумма,СтавкаНДС,СуммаНДС,СодержаниеДоИзменения,КоличествоДоИзменения,ЦенаДоИзменения,СуммаДоИзменения,СуммаНДСДоИзменения,СтавкаНДСДоИзменения,КоличествоДоКорректировки,ЦенаДоКорректировки,СуммаДоКорректировки,СуммаНДСДоКорректировки,СписокТС,СписокТЕ,СписокТД,СтрокаДоходовСделки,ЕстьВДокументеРеализации,ВсегоДоКорректировки,ВсегоДоИзменения,Всего,ПериодВО");
	//Евросиб(ДИТ), Беляев СЮ, US 115224 / TA 115264, 25-07-2025, начало
	НовСтрКорр = Новый Структура("НДСВклВСтоимость,СтрокаДоходовСделкиДоИзменения,Номенклатура,Содержание,Количество,Цена,Сумма,СтавкаНДС,СуммаНДС,СодержаниеДоИзменения,КоличествоДоИзменения,ЦенаДоИзменения,СуммаДоИзменения,СуммаНДСДоИзменения,СтавкаНДСДоИзменения,КоличествоДоКорректировки,ЦенаДоКорректировки,СуммаДоКорректировки,СуммаНДСДоКорректировки,СписокТС,СписокТЕ,СписокТД,СтрокаДоходовСделки,ЕстьВДокументеРеализации,ВсегоДоКорректировки,ВсегоДоИзменения,Всего,ПериодВО,ДатаОказанияУслуги");
	//Евросиб(ДИТ), Беляев СЮ, US 115224 / TA 115264, 25-07-2025, конец
	НовСтрКорр.Номенклатура = УсловияВознагражденияОтчета.УслугаПоВознаграждению;
	
	НовСтрКорр.ПериодВО = ПериодБлокировки8;
	
	НовСтрКорр.Содержание = УсловияВознагражденияОтчета.ОписаниеУслуги;
	НовСтрКорр.Количество = 0;
	НовСтрКорр.Цена = 0;
	НовСтрКорр.Сумма = НовСтрКорр.Цена;
	НовСтрКорр.СтавкаНДС = УсловияВознагражденияОтчета.СтавкаНДСВознаграждения;
	НовСтрКорр.СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(НовСтрКорр.Сумма, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(НовСтрКорр.СтавкаНДС) , Истина, УсловияВознагражденияОтчета.СуммаВознагражденияВключаетНДС);
	НовСтрКорр.Всего = ?(УсловияВознагражденияОтчета.СуммаВознагражденияВключаетНДС, НовСтрКорр.Сумма, НовСтрКорр.Сумма+НовСтрКорр.СуммаНДС);
	
	НовСтрКорр.ЕстьВДокументеРеализации = Истина;
	НовСтрКорр.НДСВклВСтоимость = ДокументЪ.СуммаВознагражденияВключаетНДС;
		
	НовСтрКорр.КоличествоДоИзменения = 1; //Стр.Количество;
	НовСтрКорр.ЦенаДоИзменения = ПредыдущееВознаграждение.Сумма; //Стр.Ставка;
	НовСтрКорр.СуммаДоИзменения = ПредыдущееВознаграждение.Сумма; //Стр.СуммаИтого;
	НовСтрКорр.СуммаНДСДоИзменения = ПредыдущееВознаграждение.СуммаНДС; //Стр.СтавкаНДС;
	НовСтрКорр.ВсегоДоИзменения = ПредыдущееВознаграждение.Сумма + ?(ДокументЪ.СуммаВознагражденияВключаетНДС, 0, ПредыдущееВознаграждение.СуммаНДС); //Стр.СуммаИтого;
	НовСтрКорр.СтавкаНДСДоИзменения = УсловияВознагражденияОтчета.СтавкаНДСВознаграждения;
	
	НовСтрКорр.КоличествоДоКорректировки = 1; //Стр.Количество;
