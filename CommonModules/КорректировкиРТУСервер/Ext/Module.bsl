Процедура УстановитьРазрешениеВводаКорректировок(ДокументЪ, Корректировка, Исправление, Аннулирование, Знач ПериодЪ = неопределено) Экспорт
	
	Если ПериодЪ = неопределено Тогда
		ПериодЪ = ТекущаяДата();
	КонецЕсли;
	
	 //ДИТ, Беляев СЮ, Ticket#0258445, 14-03-2022, начало
	ТекущееСостояниеСреза = КорректировкиРТУСервер.ПолучитьСтатусРазрешенияКорректировки(ДокументЪ);   
	Если ТекущееСостояниеСреза.Корректировка = Корректировка И
			ТекущееСостояниеСреза.Исправление = Исправление И
			ТекущееСостояниеСреза.Аннулирование = Аннулирование Тогда
		Возврат;
	КонецЕсли;
	//ДИТ, Беляев СЮ, Ticket#0258445, 14-03-2022, конец

	МЗ = РегистрыСведений.РазрешениеВводаКорректировок.СоздатьМенеджерЗаписи();
	МЗ.Период = ПериодЪ;
	МЗ.ОбъектКорректировки = ДокументЪ;
	МЗ.РазрешенаКорректировка = Корректировка;
	МЗ.РазрешеноИсправление = Исправление;
	МЗ.РазрешеноАннулирование = Аннулирование;
	МЗ.КтоРазрешил = Пользователи.ТекущийПользователь();
	МЗ.Записать(Истина);
	
	// Евросиб Фролов (24.03.2022 US №40767, Task №40768
	// При открытии РТУ на корректировку необходимо отправлять письмо ответственному за сделку сотрудника ОРК.
	Если Корректировка
		И ТипЗнч(ДокументЪ) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		//И Не БлокировкаРаботыСВнешнимиРесурсами.РаботаСВнешнимиРесурсамиЗаблокирована() Тогда
		
		УчетнаяЗаписьДоступна = РаботаСПочтовымиСообщениями.ПроверитьСистемнаяУчетнаяЗаписьДоступна();
		Если УчетнаяЗаписьДоступна = Ложь Тогда
			Возврат;
		КонецЕсли;	
		//Евросиб СубботинВ #84453 16.06.2025 Начало 
		//РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументЪ, "Сделка, Контрагент, НомерДляПечати, Сделка.ЕдиныйОтветственныйОтОРК, Сделка.Номер");
		
		//Евросиб Каблов 28.11.2025 ( #111016
		//РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументЪ, "Контрагент, НомерДляПечати");
		//Сделка = ДокументЪ.СчетаНаОплатуПокупателям[0].Сделка;
		//РеквизитыСделки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Сделка, "Ссылка, ЕдиныйОтветственныйОтОРК, Номер");		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	РеализацияТоваровУслуг.Контрагент КАК Контрагент,
		|	РеализацияТоваровУслуг.НомерДляПечати КАК НомерДляПечати,
		|	РеализацияТоваровУслугУслуги.Сделка КАК Сделка,
		|	ДокСделка.ЕдиныйОтветственныйОтОРК КАК ЕдиныйОтветственныйОтОРК,
		|	ДокСделка.Номер КАК Номер
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Услуги КАК РеализацияТоваровУслугУслуги
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка КАК ДокСделка
		|			ПО РеализацияТоваровУслугУслуги.Сделка = ДокСделка.Ссылка
		|		ПО РеализацияТоваровУслуг.Ссылка = РеализацияТоваровУслугУслуги.Ссылка
		|			И (РеализацияТоваровУслугУслуги.НомерСтроки = 1)
		|ГДЕ
		|	РеализацияТоваровУслуг.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", ДокументЪ);
		
		РеквизитыДокумента = Новый Структура("Контрагент, НомерДляПечати");
		РеквизитыСделки = Новый Структура("Ссылка, ЕдиныйОтветственныйОтОРК, Номер");
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(РеквизитыДокумента, Выборка);
			ЗаполнитьЗначенияСвойств(РеквизитыСделки, Выборка);
		КонецЕсли;
		//Евросиб Каблов 28.11.2025 ) #111016

		//Евросиб СубботинВ #84453 16.06.2025 Конец
		//Если Не ЗначениеЗаполнено(РеквизитыДокумента.СделкаЕдиныйОтветственныйОтОРК) Тогда
		//	Возврат;
		//КонецЕсли;
		Если Не ЗначениеЗаполнено(РеквизитыСделки.ЕдиныйОтветственныйОтОРК) Тогда
			Возврат;
		КонецЕсли;	
		
		//ЭлАдресПользователя = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(РеквизитыДокумента.СделкаЕдиныйОтветственныйОтОРК, Справочники.ВидыКонтактнойИнформации.EmailПользователя, ";");
		ЭлАдресПользователя = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(РеквизитыСделки.ЕдиныйОтветственныйОтОРК, Справочники.ВидыКонтактнойИнформации.EmailПользователя, ";");
		//Евросиб СубботинВ #84453 16.06.2025 Конец
		Если ПустаяСтрока(ЭлАдресПользователя) Тогда
			Возврат;
		КонецЕсли;	
		
		//Евросиб СубботинВ #84453 16.06.2025 Начало
		//НомерСделки 		= ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(РеквизитыДокумента.СделкаНомер);
		НомерСделки 		= ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(РеквизитыСделки.Номер);
		//Евросиб СубботинВ #84453 16.06.2025 Конец
		ТемаПисьма 			= СтрШаблон("Открытие РТУ на корректировку по сделке №%1 клиента ""%2""", НомерСделки, РеквизитыДокумента.Контрагент);
		ТекстПисьма			= СтрШаблон("Реализация №%1 (Клиент: %2) по сделке №%3 открыта на корректировку. Доступно удаление заявок/исключение контейнеров из сделки.", РеквизитыДокумента.НомерДляПечати, РеквизитыДокумента.Контрагент, НомерСделки);
		
		ПараметрыОтправкиПисьма = новый Структура;
		ПараметрыОтправкиПисьма.Вставить("Тема", 		ТемаПисьма);
		ПараметрыОтправкиПисьма.Вставить("Тело", 		ТекстПисьма);
		ПараметрыОтправкиПисьма.Вставить("ТипТекста", 	Перечисления.ТипыТекстовЭлектронныхПисем.ПростойТекст);
		ПараметрыОтправкиПисьма.Вставить("Кому", 		ЭлАдресПользователя);
		
		УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
		
		Результат = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыОтправкиПисьма)
	КонецЕсли;	
	// Евросиб Фролов)
	
КонецПроцедуры

Процедура УстановитьРазрешениеВводаКорректировокНесколькихДокументов(Документы, Корректировка, Исправление, Аннулирование) Экспорт
	
	Для каждого Док из Документы Цикл
		УстановитьРазрешениеВводаКорректировок(Док, Корректировка, Исправление, Аннулирование);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСтатусРазрешенияКорректировки(Документ) Экспорт
	
	Результат = Новый Структура("Корректировка, Исправление, Аннулирование, Описание", Ложь, Ложь, Ложь, "");
	
	Если НЕ ЗначениеЗаполнено(Документ) Тогда Возврат Результат; КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РазрешениеВводаКорректировокСрезПоследних.РазрешенаКорректировка КАК РазрешенаКорректировка,
	               |	РазрешениеВводаКорректировокСрезПоследних.РазрешеноИсправление КАК РазрешеноИсправление,
	               |	РазрешениеВводаКорректировокСрезПоследних.РазрешеноАннулирование КАК РазрешеноАннулирование,
	               |	РазрешениеВводаКорректировокСрезПоследних.Период КАК Период,
	               |	РазрешениеВводаКорректировокСрезПоследних.КтоРазрешил КАК КтоРазрешил
	               |ИЗ
	               |	РегистрСведений.РазрешениеВводаКорректировок.СрезПоследних(, ОбъектКорректировки = &ДокументЪ) КАК РазрешениеВводаКорректировокСрезПоследних";
	Запрос.УстановитьПараметр("ДокументЪ", Документ);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат.Корректировка = Ответ.РазрешенаКорректировка;
		Результат.Исправление = Ответ.РазрешеноИсправление;
		Результат.Аннулирование = Ответ.РазрешеноАннулирование;
		Результат.Описание = "Разрешил: " + Ответ.КтоРазрешил + " " + Ответ.Период;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСведенияКорректировок(СписокИсхДокументов)
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РазрешениеВводаКорректировокСрезПоследних.РазрешенаКорректировка КАК РазрешенаКорректировка,
	               |	РазрешениеВводаКорректировокСрезПоследних.РазрешеноИсправление КАК РазрешеноИсправление,
	               |	РазрешениеВводаКорректировокСрезПоследних.РазрешеноАннулирование КАК РазрешеноАннулирование,
	               |	РазрешениеВводаКорректировокСрезПоследних.ОбъектКорректировки КАК ОбъектКорректировки
	               |ИЗ
	               |	РегистрСведений.РазрешениеВводаКорректировок.СрезПоследних(, ОбъектКорректировки В (&ОбъектКорректировки)) КАК РазрешениеВводаКорректировокСрезПоследних";
	Запрос.УстановитьПараметр("ОбъектКорректировки", СписокИсхДокументов);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		Результат.Вставить(Ответ.ОбъектКорректировки, Новый Структура("КорректировкаРазрешена,ИсправлениеРазрешено,АннулированиеРазрешено", Ответ.РазрешенаКорректировка, Ответ.РазрешеноИсправление, Ответ.РазрешеноАннулирование));
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

