Процедура ОповеститьПользователяОбОшибкеИЗаписатьВЖурналРегистрации(Ссылка)
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ " + Ссылка + " не проведен!"  + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Проведение документа'"),
	УровеньЖурналаРегистрации.Ошибка, Ссылка.ПолучитьОбъект().Метаданные(), Ссылка,
	НСтр("ru = 'Во время проведения документа возникла ошибка: '") + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

КонецПроцедуры //--ДИТ Гаузер А.В. Ticket#0286685 22.09.2022

Процедура УдалитьКорректировкуРТУ(Ссылка) Экспорт
    //++ДИТ_Коробов_Task 46790_24.02.22
	БухгалтерскийУчетОбщиеПроцедурыСервер.ИСФАктуализацияВыгрузкиДляФНС(Ссылка, "УдалитьИСФ");
	//--ДИТ_Коробов_Task 46790_24.02.22
	КРТУО = Ссылка.ПолучитьОбъект();
	КРТУО.ПометкаУдаления = Истина;
	КРТУО.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	
