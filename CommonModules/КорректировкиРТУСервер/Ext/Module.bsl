	Запрос.Текст = "ВЫБРАТЬ
	               |	КорректировкаРеализации.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.КорректировкаРеализации КАК КорректировкаРеализации
	               |ГДЕ
	               |	КорректировкаРеализации.ПометкаУдаления = ЛОЖЬ
	               |	И КорректировкаРеализации.ДокументРеализации = &ДокументРеализации
	               |	И КорректировкаРеализации.ЭтоИзменениеВознаграждения = ЛОЖЬ";
	Запрос.УстановитьПараметр("ДокументРеализации", ДокументЪ);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
