	Если НЕ ЗначениеЗаполнено(ДокументЪ) тогда Возврат Новый Массив; КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КорректировкаРеализации.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.КорректировкаРеализации КАК КорректировкаРеализации
	               |ГДЕ
	               |	КорректировкаРеализации.ПометкаУдаления = ЛОЖЬ
	               |	И КорректировкаРеализации.ИсходныйДокументРеализации = &ДокументЪ";
	Запрос.УстановитьПараметр("ДокументЪ", ДокументЪ);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
