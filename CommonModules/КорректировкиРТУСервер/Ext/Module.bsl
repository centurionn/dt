	//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 114152, 04-08-2025, конец
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КорректировкаПоступленияУслуги.Количество КАК Количество,
	               |	КорректировкаПоступленияУслуги.Цена КАК Цена,
	               |	КорректировкаПоступленияУслуги.Сумма КАК Сумма,
	               |	КорректировкаПоступленияУслуги.СтавкаНДС КАК СтавкаНДС,
	               |	КорректировкаПоступленияУслуги.СуммаНДС КАК СуммаНДС,
	               |	КорректировкаПоступленияУслуги.Ссылка.СуммаВключаетНДС КАК СуммаВключаетНДС,
	               |	КорректировкаПоступленияУслуги.Ссылка.Контрагент КАК Контрагент
	               |ИЗ
	               |	Документ.КорректировкаПоступления.Услуги КАК КорректировкаПоступленияУслуги
	               |ГДЕ
	               |	КорректировкаПоступленияУслуги.Ссылка.Проведен
	               |	И КорректировкаПоступленияУслуги.Ссылка.ДокументПоступления = &ДокументПоступления
	               |	И КорректировкаПоступленияУслуги.ГУИДПТУ В
	               |			(ВЫБРАТЬ
	               |				АкцептУслуги.ИдентификаторСтрокиПоступления КАК ИдентификаторСтрокиПоступления
	               |			ИЗ
	               |				Документ.Акцепт.Услуги КАК АкцептУслуги
	               |			ГДЕ
	               |				АкцептУслуги.Ссылка.Поступление = &ДокументПоступления
	               |				И АкцептУслуги.ИдентификаторСтрокиРасходовВСделке = &ИдентификаторСтрокиРасходовВСделке)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	КорректировкаПоступленияУслуги.Ссылка.Дата УБЫВ";
	Запрос.УстановитьПараметр("ДокументПоступления", ПТУ);
	Запрос.УстановитьПараметр("ИдентификаторСтрокиРасходовВСделке", ИдентификаторСтрокиРасходовВСделке);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат.Себестоимость = Ответ.Цена;
		Результат.Вознаграждение = 0;
		Результат.Ставка = Ответ.Цена;
		Результат.Количество = Ответ.Количество;
		Результат.СебестоимостьИтого = Ответ.Сумма;
		Результат.ВознаграждениеИтого = 0;
		Результат.СтавкаИтого = Ответ.Сумма;
		Результат.СтавкаНДС = Ответ.СтавкаНДС;
		Результат.СуммаНДС = Ответ.СуммаНДС;
		Результат.НДСВключенВСтоимость = Ответ.СуммаВключаетНДС;
		Результат.СуммаИтого = Ответ.Сумма;
		Результат.Поставщик = Ответ.Контрагент;
		//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 114152, 04-08-2025, начало
		Результат.ЕстьДанныеКоррПТУ = Истина;
		//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 114152, 04-08-2025, конец
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПредыдущееВознаграждение(ОтчетАгента) Экспорт
	
	//Результат = Новый Структура("Сумма, СтавкаНДС, СуммаНДС");
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0373648, 31-10-2024, начало
	Результат = Новый Структура("Сумма, СтавкаНДС, СуммаНДС", 0, Неопределено, 0);
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0373648, 31-10-2024, конец
	
	СчФ = БухгалтерскийУчетОбщиеПроцедурыСервер.НайтиПодчиненныйСчетФактуру(ОтчетАгента, "СчетФактураВыданный"); 
	
	Если ЗначениеЗаполнено(СчФ) Тогда
		// Евросиб US 125402 TA 125421 Рыбьяков К.А. 01.12.2025 ((
		//Результат.Сумма = ?(ОтчетАгента.СуммаВознагражденияВключаетНДС, СчФ.СуммаДокумента - СчФ.СуммаНДСДокумента, СчФ.СуммаДокумента);
		Результат.Сумма = ?(ОтчетАгента.СуммаВознагражденияВключаетНДС, СчФ.СуммаДокумента, СчФ.СуммаДокумента - СчФ.СуммаНДСДокумента);
		// Евросиб Рыбьяков К.А. 01.12.2025 ))
		Результат.СуммаНДС = СчФ.СуммаНДСДокумента;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СоздатьАннулированиеРТУИзСписка(ДокументЪ) Экспорт
	
	// Проверим, что на указанный документ нет другого аннулирования
