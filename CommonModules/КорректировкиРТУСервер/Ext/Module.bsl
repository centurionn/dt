	|		КОГДА СделкаДоходы1.КорректировкаДокумента.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ИсправлениеВыполнено,
	|	ВЫБОР
	|		КОГДА СделкаДоходы.КорректировкаДокумента.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК АннулированиеВыполнено,
	|	ВЫБОР
	|		КОГДА СделкаДоходы1.КорректировкаДокумента.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК КорректировкаВыполнена
	//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 114152, 31-07-2025, начало
	|	,СделкаДоходы1.ГУИД КАК ГУИДКорректирущейСтроки
	//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 114152, 31-07-2025, конец
	|ПОМЕСТИТЬ ВТ_Результат
	|ИЗ
	|	ВТ_Доходы КАК СделкаДоходы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РазрешениеКорректировок КАК ВТ_РазрешениеКорректировок
	|		ПО СделкаДоходы.УчДокумент = ВТ_РазрешениеКорректировок.ОбъектКорректировки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Доходы КАК СделкаДоходы1
	|		ПО СделкаДоходы.ГУИД = СделкаДоходы1.ГУИДИсправляемойСтроки
	//|			И СделкаДоходы.Ссылка = СделкаДоходы1.Ссылка
	//|ГДЕ
	//|	СделкаДоходы.Ссылка = &Сделка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Результат.ГУИД КАК ГУИД,
	//|	ВТ_Результат.РазрешенаКорректировка КАК РазрешенаКорректировка,
	//|	ВТ_Результат.РазрешеноИсправление КАК РазрешеноИсправление,
	//|	ВТ_Результат.РазрешеноАннулирование КАК РазрешеноАннулирование,
	//ДИТ, Беляев СЮ, Ticket#0346396, 26-03-2024, начало
	|	ВТ_Результат.РазрешенаКорректировка КАК КорректировкаРазрешена,
	|	ВТ_Результат.РазрешеноИсправление КАК ИсправлениеРазрешено,
	|	ВТ_Результат.РазрешеноАннулирование КАК АннулированиеРазрешено,
	//ДИТ, Беляев СЮ, Ticket#0346396, 26-03-2024, конец
	|	ВТ_Результат.ИсправлениеВыполнено КАК ИсправлениеВыполнено,
	|	ВТ_Результат.АннулированиеВыполнено КАК АннулированиеВыполнено,
	|	ВТ_Результат.КорректировкаВыполнена КАК КорректировкаВыполнена
	//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 114152, 31-07-2025, начало
	|	,ВТ_Результат.ГУИДКорректирущейСтроки КАК ГУИДКорректирущейСтроки
	//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 114152, 31-07-2025, конец
	|ИЗ
	|	ВТ_Результат КАК ВТ_Результат
	|ГДЕ
	|	(ВТ_Результат.РазрешенаКорректировка
	|			ИЛИ ВТ_Результат.РазрешеноИсправление
	|			ИЛИ ВТ_Результат.РазрешеноАннулирование
	|			ИЛИ ВТ_Результат.ИсправлениеВыполнено
	|			ИЛИ ВТ_Результат.АннулированиеВыполнено
	|			ИЛИ ВТ_Результат.КорректировкаВыполнена)";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Сделка.Доходы КАК СделкаДоходы", "&Доходы КАК СделкаДоходы");
	Запрос.УстановитьПараметр("Доходы", ЭтаФорма.Объект.Доходы.Выгрузить());
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаРезультатаЗапроса = РезультатЗапроса.Выбрать();
		РезультатВидимости = Истина;
		Пока ВыборкаРезультатаЗапроса.Следующий() Цикл
			СтрокиДоход = ЭтаФорма.Объект.Доходы.НайтиСтроки(Новый Структура("ГУИД", ВыборкаРезультатаЗапроса.ГУИД));
			Для каждого СтрокаДоход Из СтрокиДоход Цикл
				ЗаполнитьЗначенияСвойств(СтрокаДоход, ВыборкаРезультатаЗапроса);
			КонецЦикла;
			//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 114152, 31-07-2025, начало
			СтрокиДоход = ЭтаФорма.Объект.Доходы.НайтиСтроки(Новый Структура("ГУИД", ВыборкаРезультатаЗапроса.ГУИДКорректирущейСтроки));
			Для каждого СтрокаДоход Из СтрокиДоход Цикл
				СтрокаДоход.КорректировкаРазрешенаУсловноеОформление = ВыборкаРезультатаЗапроса.КорректировкаРазрешена;
				СтрокаДоход.ИсправлениеРазрешеноУсловноеОформление = ВыборкаРезультатаЗапроса.ИсправлениеРазрешено;
			КонецЦикла;
			//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 114152, 31-07-2025, конец
		КонецЦикла;
	КонецЕсли;
	
	
	ЭтаФорма.Элементы.ДоходыГруппаКорректировка.Видимость = РезультатВидимости;
	ЭтаФорма.Элементы.ДоходыГруппаИсправление.Видимость = РезультатВидимости;
	ЭтаФорма.Элементы.ДоходыГруппаАннулирование.Видимость = РезультатВидимости;
	ЭтаФорма.Элементы.ДоходыГруппа24.Видимость = РезультатВидимости;
	ЭтаФорма.Элементы.Доходыкорр_СоздатьДокументКорректировки.Видимость = РезультатВидимости;
	ЭтаФорма.Элементы.Доходыкорр_СоздатьКорректировкуВознаграждения.Видимость = РезультатВидимости;
	ЭтаФорма.Элементы.Доходыкорр_УдалитьДокументКорректировки.Видимость = РезультатВидимости;
	
	ЭтаФорма.Элементы.Доходыкорр_АннулироватьРеализацию.Видимость = Ложь;
	
	РольПолныеПрава = РольПолныеПраваДоступна();
	
	ЭтаФорма.Элементы.ДоходыГруппаКорректировка.ТолькоПросмотр = НЕ РольПолныеПрава;
	ЭтаФорма.Элементы.ДоходыГруппаИсправление.ТолькоПросмотр = НЕ РольПолныеПрава;
	ЭтаФорма.Элементы.ДоходыГруппаАннулирование.ТолькоПросмотр = НЕ РольПолныеПрава;
	
КонецПроцедуры

Функция ПолучитьДанныеПервичногоДокумента(ДокументОснование, ГУИДСтроки, ИскатьДанныеВознаграждения = Ложь) Экспорт
	
	Результат = Новый Структура("СписокТС,СписокТЕ,СписокТД,ПунктОтправления,ПунктНазначения,ЕдиницаИзмерения,СодержаниеДоИзменения,КлючСтроки,КоличествоДоИзменения,ЦенаДоИзменения,СуммаДоИзменения,СуммаНДСДоИзменения,СтавкаНДСДоИзменения,ВсегоДоИзменения");
	
	Если НЕ ЗначениеЗаполнено(ДокументОснование) Тогда возврат Результат; КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	Запрос.УстановитьПараметр("СтрокаДоходовСделки", ГУИДСтроки);
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		Запрос.Текст = "ВЫБРАТЬ
		               |	КорректировкаРеализацииУслуги.СодержаниеДоИзменения КАК СодержаниеДоИзменения,
		               |	КорректировкаРеализацииУслуги.КоличествоДоИзменения КАК КоличествоДоИзменения,
		               |	КорректировкаРеализацииУслуги.ЦенаДоИзменения КАК ЦенаДоИзменения,
		               |	КорректировкаРеализацииУслуги.СуммаДоИзменения КАК СуммаДоИзменения,
		               |	КорректировкаРеализацииУслуги.СуммаНДСДоИзменения КАК СуммаНДСДоИзменения,
		               |	КорректировкаРеализацииУслуги.СтавкаНДСДоИзменения КАК СтавкаНДСДоИзменения,
		               |	КорректировкаРеализацииУслуги.ВсегоДоИзменения КАК ВсегоДоИзменения,
		               |	КорректировкаРеализацииУслуги.СписокТС КАК СписокТС,
		               |	КорректировкаРеализацииУслуги.СписокТЕ КАК СписокТЕ,
		               |	КорректировкаРеализацииУслуги.СписокТД КАК СписокТД,
		               |	КорректировкаРеализацииУслуги.ПунктОтправления КАК ПунктОтправления,
		               |	КорректировкаРеализацииУслуги.ПунктНазначения КАК ПунктНазначения,
		               |	КорректировкаРеализацииУслуги.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		               |	КорректировкаРеализацииУслуги.КлючСтроки КАК КлючСтроки
		               |ИЗ
		               |	Документ.КорректировкаРеализации.Услуги КАК КорректировкаРеализацииУслуги
		               |ГДЕ
		               |	КорректировкаРеализацииУслуги.Ссылка = &Ссылка
		               |	И КорректировкаРеализацииУслуги.СтрокаДоходовСделки = &СтрокаДоходовСделки";
		
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		Запрос.Текст = "ВЫБРАТЬ
		               |	РеализацияТоваровУслугУслуги.Содержание КАК СодержаниеДоИзменения,
		               |	РеализацияТоваровУслугУслуги.Количество КАК КоличествоДоИзменения,
		               |	РеализацияТоваровУслугУслуги.Цена КАК ЦенаДоИзменения,
		               |	РеализацияТоваровУслугУслуги.Сумма КАК СуммаДоИзменения,
		               |	РеализацияТоваровУслугУслуги.СтавкаНДС КАК СтавкаНДСДоИзменения,
		               |	РеализацияТоваровУслугУслуги.СуммаНДС КАК СуммаНДСДоИзменения,
		               |	ВЫБОР
		               |		КОГДА РеализацияТоваровУслугУслуги.Ссылка.СуммаВключаетНДС
		               |			ТОГДА РеализацияТоваровУслугУслуги.Сумма
		               |		ИНАЧЕ РеализацияТоваровУслугУслуги.Сумма + РеализацияТоваровУслугУслуги.СуммаНДС
		               |	КОНЕЦ КАК ВсегоДоИзменения,
		               |	РеализацияТоваровУслугУслуги.ПунктОтправления КАК ПунктОтправления,
		               |	РеализацияТоваровУслугУслуги.ПунктНазначения КАК ПунктНазначения,
		               |	РеализацияТоваровУслугУслуги.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		               |	РеализацияТоваровУслугУслуги.СписокТС КАК СписокТС,
		               |	РеализацияТоваровУслугУслуги.СписокТЕ КАК СписокТЕ,
		               |	РеализацияТоваровУслугУслуги.СписокТД КАК СписокТД
		               |ИЗ
		               |	Документ.РеализацияТоваровУслуг.Услуги КАК РеализацияТоваровУслугУслуги
		               |ГДЕ
		               |	РеализацияТоваровУслугУслуги.Ссылка = &Ссылка
		               |	И РеализацияТоваровУслугУслуги.СтрокаДоходовСделки = &СтрокаДоходовСделки";
		
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
		
		Запрос.Текст = "ВЫБРАТЬ
		               |	ОтчетКомитентуОПродажахТовары.Содержание КАК СодержаниеДоИзменения,
		               |	ОтчетКомитентуОПродажахТовары.Количество КАК КоличествоДоИзменения,
		               |	ОтчетКомитентуОПродажахТовары.Цена КАК ЦенаДоИзменения,
		               |	ОтчетКомитентуОПродажахТовары.Сумма КАК СуммаДоИзменения,
		               |	ОтчетКомитентуОПродажахТовары.СтавкаНДС КАК СтавкаНДСДоИзменения,
		               |	ОтчетКомитентуОПродажахТовары.СуммаНДС КАК СуммаНДСДоИзменения,
		               |	ВЫБОР
		               |		КОГДА ОтчетКомитентуОПродажахТовары.Ссылка.СуммаВключаетНДС
		               |			ТОГДА ОтчетКомитентуОПродажахТовары.Сумма
		               |		ИНАЧЕ ОтчетКомитентуОПродажахТовары.Сумма + ОтчетКомитентуОПродажахТовары.СуммаНДС
		               |	КОНЕЦ КАК ВсегоДоИзменения,
		               |	ОтчетКомитентуОПродажахТовары.КлючСтроки КАК КлючСтроки,
		               |	ОтчетКомитентуОПродажахТовары.СписокТС КАК СписокТС,
		               |	ОтчетКомитентуОПродажахТовары.СписокТЕ КАК СписокТЕ,
		               |	ОтчетКомитентуОПродажахТовары.СписокТД КАК СписокТД
		               |ИЗ
		               |	Документ.ОтчетКомитентуОПродажах.Товары КАК ОтчетКомитентуОПродажахТовары
		               |ГДЕ
		               |	ОтчетКомитентуОПродажахТовары.Ссылка = &Ссылка
		               |	И ОтчетКомитентуОПродажахТовары.СтрокаДоходовСделки = &СтрокаДоходовСделки";
		
	КонецЕсли;
	
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

