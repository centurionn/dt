Функция ПолучитьДействующиеЦелиДляРучнойОтметки(ОбъектЛичнойЦели) экспорт
	
	ИмяОбъектаМетаданного = Метаданные.НайтиПоТипу(ТипЗнч(ОбъектЛичнойЦели)).ПолноеИмя();
	Если НЕ ПравоДоступа("Редактирование", Метаданные.НайтиПоПолномуИмени(ИмяОбъектаМетаданного)) Тогда Возврат Новый Массив; КонецЕсли; 
	
	МассивНедопустимыхЛичныхЦелей = Новый Массив;
	Если ЗначениеЗаполнено(ОбъектЛичнойЦели) Тогда
		МассивНедопустимыхЛичныхЦелей = ОбъектЛичнойЦели.ЛичныеЦели.ВыгрузитьКолонку("Цель");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛичныеЦелиЪ.Ссылка КАК Ссылка,
	               |	ЛичныеЦелиЪ.Сотрудник КАК Сотрудник
	               |ИЗ
	               |	Документ.ЛичныеЦели КАК ЛичныеЦелиЪ
	               |ГДЕ
	               |	НЕ ЛичныеЦелиЪ.ПометкаУдаления
	               |	И ЛичныеЦелиЪ.НачалоРаботы <= &ТекДата
	               |	И ЛичныеЦелиЪ.КонтрольныйПоказатель = &КонтрольныйПоказатель
	               |	И ЛичныеЦелиЪ.СрокДостижения >= &ТекДата
	               |	И НЕ ЛичныеЦелиЪ.Ссылка В (&МассивНедопустимыхЛичныхЦелей)";
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДата());
	Запрос.УстановитьПараметр("КонтрольныйПоказатель", Перечисления.ЛичныеЦели_СписокКонтрольныхПоказателей.РучныеОперацииРучнаяОтметка);
	Запрос.УстановитьПараметр("МассивНедопустимыхЛичныхЦелей", МассивНедопустимыхЛичныхЦелей);
	Результат = Новый Массив;
	
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		Результат.Добавить(Новый Структура("Цель, Исполнитель", Ответ.Ссылка, Ответ.Сотрудник));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

