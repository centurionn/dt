
// основные и служебные функции

Функция ПолучитьЗначениеПоказателя(Организация, Показатель, Отборы, ДатаНачала, ДатаПроверки, Цель = неопределено) Экспорт
	
	Результат = 0;
	
	Если Показатель = Перечисления.ЛичныеЦели_СписокКонтрольныхПоказателей.ДебиторкаКоличествоКонтрагентовСПДЗ Тогда
		
		ДанныеДебиторки = ПолучитьДанныеДебиторки(Организация, Отборы, ДатаПроверки);
		
		Результат = Новый Структура("Результат, Детализация", ДанныеДебиторки.Результат.КоличествоКонтрагентов, ДанныеДебиторки.ДетализацияКоличестваРезультат);
		
	ИначеЕсли Показатель = Перечисления.ЛичныеЦели_СписокКонтрольныхПоказателей.ДебиторкаОбщаяСуммаПДЗ Тогда
		
		ДанныеДебиторки = ПолучитьДанныеДебиторки(Организация, Отборы, ДатаПроверки);
		
		//Результат = ДанныеДебиторки.ОбщаяСумма;
		Результат = Новый Структура("Результат, Детализация", ДанныеДебиторки.Результат.ОбщаяСумма, ДанныеДебиторки.ДетализацияСуммыРезультат);
		
	ИначеЕсли Показатель = Перечисления.ЛичныеЦели_СписокКонтрольныхПоказателей.ДоговорыКоличествоНовыхДоговоров Тогда
			
		Результат = КоличествоНовыхДоговоров(Организация, Отборы, ДатаНачала, ДатаПроверки);	
		
	ИначеЕсли Показатель = Перечисления.ЛичныеЦели_СписокКонтрольныхПоказателей.ДоговорыКоличествоНовыхПСЦ Тогда
			
		Результат = КоличествоНовыхПСЦ(Организация, Отборы, ДатаНачала, ДатаПроверки);	
		
	ИначеЕсли Показатель = Перечисления.ЛичныеЦели_СписокКонтрольныхПоказателей.ДоговорыКоличествоНовыхТарифовВСистеме Тогда
			
		Результат = КоличествоНовыхТарифов(Организация, Отборы, ДатаНачала, ДатаПроверки);	
		
	ИначеЕсли Показатель = Перечисления.ЛичныеЦели_СписокКонтрольныхПоказателей.ДоговорыРазницаМеждуМаксимальнымиТарифамиЗаПериод Тогда
		
		ЦенаТарифаВПервыйДень = ВычисленнаяЦенаТарифа(Организация, Отборы, ДатаНачала, ДатаНачала+24*3600);
		ЦенаТарифаВПоследнийДень = ВычисленнаяЦенаТарифа(Организация, Отборы, ДатаПроверки, ДатаПроверки+24*3600);
		Результат = ЦенаТарифаВПервыйДень - ЦенаТарифаВПоследнийДень;

	ИначеЕсли Показатель = Перечисления.ЛичныеЦели_СписокКонтрольныхПоказателей.ДоговорыРазницаМеждуСамымДорогимИСамымДешевым Тогда
		
		МаксТарифВПервыйДень = ВычисленнаяЦенаТарифа(Организация, Отборы, ДатаНачала, ДатаНачала+24*3600);
		МинТарифВПервыйДень = ВычисленнаяЦенаТарифа(Организация, Отборы, ДатаНачала, ДатаНачала+24*3600, Ложь);
		
		МаксТарифВПоследнийДень = ВычисленнаяЦенаТарифа(Организация, Отборы, ДатаПроверки, ДатаПроверки+24*3600);
		МинТарифВПоследнийДень = ВычисленнаяЦенаТарифа(Организация, Отборы, ДатаПроверки, ДатаПроверки+24*3600, Ложь);
		
		Результат = (МаксТарифВПервыйДень - МинТарифВПервыйДень) - (МаксТарифВПоследнийДень - МинТарифВПоследнийДень);
		
	ИначеЕсли Показатель = Перечисления.ЛичныеЦели_СписокКонтрольныхПоказателей.ДокументыКлиентуКоличествоСделокБезДокументов Тогда
		
		СделкиИнфо = СобратьЭкономикуПоСделкам(Организация, Отборы, ДатаНачала, ДатаПроверки);
		//Результат = СделкиИнфо.КоличествоСделкиБезРеализаций;
		
		Результат = Новый Структура("Результат, Детализация", СделкиИнфо.Результат.КоличествоСделкиБезРеализаций, СделкиИнфо.ДетализацияКоличествоСделкиБезРеализаций);
		
	ИначеЕсли Показатель = Перечисления.ЛичныеЦели_СписокКонтрольныхПоказателей.ДокументыКлиентуКоличествоСделокБезОплат Тогда
		
		СделкиИнфо = СобратьЭкономикуПоСделкам(Организация, Отборы, ДатаНачала, ДатаПроверки);
		//Результат = СделкиИнфо.КоличествоСделокБезОплаты;
		
		Результат = Новый Структура("Результат, Детализация", СделкиИнфо.Результат.КоличествоСделокБезОплаты, СделкиИнфо.ДетализацияКоличествоСделокБезОплаты);		
		
	ИначеЕсли Показатель = Перечисления.ЛичныеЦели_СписокКонтрольныхПоказателей.ДокументыКлиентуСуммаСНПЗаПериод Тогда
		
		СделкиИнфо = СобратьЭкономикуПоСделкам(Организация, Отборы, ДатаНачала, ДатаПроверки);
		//Результат = СделкиИнфо.СуммаСНПЗаПериод;
		
		Результат = Новый Структура("Результат, Детализация", СделкиИнфо.Результат.СуммаСНПЗаПериод, СделкиИнфо.ДетализацияСуммаСНПЗаПериод);
		
	ИначеЕсли Показатель = Перечисления.ЛичныеЦели_СписокКонтрольныхПоказателей.ПеревозкиКоличествоСделокЗаПериод Тогда
		
		СделкиИнфо = СобратьЭкономикуПоСделкам(Организация, Отборы, ДатаНачала, ДатаПроверки);
		//Результат = СделкиИнфо.КоличествоСделок;
		
		Результат = Новый Структура("Результат, Детализация", СделкиИнфо.Результат.КоличествоСделок, СделкиИнфо.ДетализацияКоличествоСделок);
		
	ИначеЕсли Показатель = Перечисления.ЛичныеЦели_СписокКонтрольныхПоказателей.ПеревозкиСуммаКонтрибуцииЗаПериод Тогда
		
		СделкиИнфо = СобратьЭкономикуПоСделкам(Организация, Отборы, ДатаНачала, ДатаПроверки);
		//Результат = СделкиИнфо.СуммаКонтрибуцииЗаПериод;
		
		Результат = Новый Структура("Результат, Детализация", СделкиИнфо.Результат.СуммаКонтрибуцииЗаПериод, СделкиИнфо.ДетализацияСуммаКонтрибуцииЗаПериод);
		
	ИначеЕсли Показатель = Перечисления.ЛичныеЦели_СписокКонтрольныхПоказателей.ПеревозкиСуммаРеализацийЗаПериод Тогда
		
		СделкиИнфо = СобратьЭкономикуПоСделкам(Организация, Отборы, ДатаНачала, ДатаПроверки);
		//Результат = СделкиИнфо.СуммаРеализацийЗаПериод;
		
		Результат = Новый Структура("Результат, Детализация", СделкиИнфо.Результат.СуммаРеализацийЗаПериод, СделкиИнфо.ДетализацияСуммаРеализацийЗаПериод);
		
	ИначеЕсли Показатель = Перечисления.ЛичныеЦели_СписокКонтрольныхПоказателей.ОтклоненияКоличествоОтменПоездов Тогда
		
		РейсИнфо = СобратьИнформациюПоОтправкам(Отборы, ДатаНачала, ДатаПроверки);
		//Результат = РейсИнфо.ОтменПоездов;
		
		Результат = Новый Структура("Результат, Детализация", РейсИнфо.Результат.ОтменПоездов, РейсИнфо.ДетализацияОтменПоездовРезультат);
		
	ИначеЕсли Показатель = Перечисления.ЛичныеЦели_СписокКонтрольныхПоказателей.ПеревозкиКоличествоПоездовУшедшихВовремя Тогда
		
		РейсИнфо = СобратьИнформациюПоОтправкам(Отборы, ДатаНачала, ДатаПроверки);
		//Результат = РейсИнфо.ПоездовВовремя;

		Результат = Новый Структура("Результат, Детализация", РейсИнфо.Результат.ПоездовВовремя, РейсИнфо.ДетализацияПоездовВовремяРезультат);
		
	ИначеЕсли Показатель = Перечисления.ЛичныеЦели_СписокКонтрольныхПоказателей.ПеревозкиКоличествоПоездовНЕУшедшихВовремя Тогда
		
		РейсИнфо = СобратьИнформациюПоОтправкам(Отборы, ДатаНачала, ДатаПроверки);
		//Результат = РейсИнфо.ПоездовНеВовремя;
		
		Результат = Новый Структура("Результат, Детализация", РейсИнфо.Результат.ПоездовНеВовремя, РейсИнфо.ДетализацияПоездовНеВовремяРезультат);
		
	ИначеЕсли Показатель = Перечисления.ЛичныеЦели_СписокКонтрольныхПоказателей.КонтейнерыОбщееКоличествоКТКВЗаявках Тогда
		
		Результат = ПолучитьКоличествоКТКВЗаявках(Организация, Отборы, ДатаНачала, ДатаПроверки);
		
	ИначеЕсли Показатель = Перечисления.ЛичныеЦели_СписокКонтрольныхПоказателей.РучныеОперацииКоличествоЗагруженныхФайловПоТипам Тогда
		
		Результат = ПолучитьКоличествоЗагруженныхФайлов(Организация, Отборы, ДатаНачала, ДатаПроверки);
		
	ИначеЕсли Показатель = Перечисления.ЛичныеЦели_СписокКонтрольныхПоказателей.РучныеОперацииРучнаяОтметка Тогда
		
		Результат = ПолучитьКоличествоРучныхОтметокЗаПериод(Цель, ДатаНачала, ДатаПроверки);
		
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

Функция ПолучитьРасходыРУР(Сделка, ГУИДДоходов, РУР)
	
	СуммаРасходов = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СделкаРасходы.СуммаИтого КАК СуммаИтого,
	               |	СделкаРасходы.Валюта КАК Валюта,
	               |	СделкаРасходы.Ссылка.Дата КАК ДатаДокумента
	               |ИЗ
	               |	Документ.Сделка.Расходы КАК СделкаРасходы
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьДоходовИРасходов КАК СделкаСвязьДоходовИРасходов
	               |		ПО СделкаРасходы.Ссылка = СделкаСвязьДоходовИРасходов.Ссылка
	               |			И СделкаРасходы.ГУИД = СделкаСвязьДоходовИРасходов.Расходы
	               |ГДЕ
	               |	СделкаСвязьДоходовИРасходов.Доходы = &Доходы
	               |	И СделкаСвязьДоходовИРасходов.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Доходы", ГУИДДоходов);
	Запрос.УстановитьПараметр("Ссылка", Сделка);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		СуммаРасходов = СуммаРасходов + РаботаСКурсамиВалют.ПересчитатьВВалюту(Ответ.СуммаИтого, Ответ.Валюта, РУР, Ответ.ДатаДокумента);
	КонецЦикла;
	
	Возврат СуммаРасходов;
	
КонецФункции

Функция РегионСоответствует(РегионДоговора, ОтборПоРегионам)
	
	Результат = Ложь;
	
	Если ОтборПоРегионам.Количество() = 0 Тогда Возврат Истина; КонецЕсли;
	
	МассивРегионаДоговора = Локации_сервер.ПолучитьМассивРодителей(РегионДоговора, Истина);
	
	Для каждого Стр из ОтборПоРегионам ЦИкл
		
		Результат = Результат ИЛИ МассивРегионаДоговора.Найти(Стр) <> неопределено;
		
	КонецЦикла;
	
	Возврат результат;
	
КонецФункции

Процедура ОчиститьЗаписиЛичныхЦелей(ОбъектЪ) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ОбъектЪ) тогда Возврат; КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	*
	               |ИЗ
	               |	РегистрСведений.РучнаяОтметкаЛичныхЦелей КАК РучнаяОтметкаЛичныхЦелей
	               |ГДЕ
	               |	РучнаяОтметкаЛичныхЦелей.ОбъектЛичнойЦели = &ОбъектЛичнойЦели";
	Запрос.УстановитьПараметр("ОбъектЛичнойЦели", ОбъектЪ);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		МЗ = РегистрыСведений.РучнаяОтметкаЛичныхЦелей.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МЗ, Ответ);
		МЗ.Удалить();
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьЗаписиЛичныхЦелей(ОбъектЪ) Экспорт
	
	Если ОбъектЪ.ПометкаУдаления Тогда Возврат; КонецЕсли;
	Для каждого Стр из ОбъектЪ.ЛичныеЦели Цикл
		
		Если НЕ Стр.Отметка Тогда Продолжить; КонецЕсли;
		
		МЗ = РегистрыСведений.РучнаяОтметкаЛичныхЦелей.СоздатьМенеджерЗаписи();
		МЗ.Исполнитель = Стр.Исполнитель;
		МЗ.ОбъектЛичнойЦели = ОбъектЪ;
		МЗ.Отметка = Стр.Отметка;
		МЗ.Цель = Стр.Цель;
		МЗ.ПериодЪ = Стр.ДатаОтметки;
		МЗ.Период = Стр.ДатаОтметки;
		МЗ.Отметка = ?(Стр.Отметка, 1, 0);
		МЗ.Записать(Истина);
		
	КонецЦикла;
	
КонецПроцедуры

