Функция ПодобратьНоменклатурнуюГруппуПоНаборуПараметров(ТипЗаказа, Знач Вагон) Экспорт
	
	Результат = неопределено;
	КоличествоСовпадений = 0;
	
	// ДИТ 65580 Давудов М.А. Начало: 23.02.2023
	//Было:
	//ВидСобственности = Перечисления.ВариантыСобственности.Неизвестно;
	//Стало:
	ВидСобственности = Перечисления.ВариантыСобственности.ПустаяСсылка();
	// ДИТ 65580 Давудов М.А. Конец: 23.02.2023
	
	// Если сюда передали список вагонов, то берем первый из них и пытаемся на его основе определить признак собственности
	Если ТипЗнч(Вагон) = Тип("Строка") Тогда
		СписокВагонов = СтрРазделить(Вагон, "", Ложь);
		Если СписокВагонов.Количество() > 0 Тогда
			 Вагон = Грузы_сервер.НайтиВагон(СписокВагонов[0]);
		 Иначе
			 Вагон = Грузы_сервер.НайтиВагон(Вагон);
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПризнакСобственностиВагонаСрезПоследних.ПризнакСобственности КАК ПризнакСобственности
	               |ИЗ
	               |	РегистрСведений.ПризнакСобственностиВагона.СрезПоследних(, Вагон = &Вагон) КАК ПризнакСобственностиВагонаСрезПоследних";
	Запрос.УстановитьПараметр("Вагон", Вагон);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		ВидСобственности = Ответ.ПризнакСобственности;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОпределениеНоменклатурнойГруппы.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	               |	ОпределениеНоменклатурнойГруппы.ТипЗаказа КАК ТипЗаказа,
	               |	ОпределениеНоменклатурнойГруппы.ВидСобственности КАК ВидСобственности
	               |ИЗ
	               |	РегистрСведений.ОпределениеНоменклатурнойГруппы КАК ОпределениеНоменклатурнойГруппы
	               |ГДЕ
	               |	(ОпределениеНоменклатурнойГруппы.ТипЗаказа = &ТипЗаказа
	               |			ИЛИ ОпределениеНоменклатурнойГруппы.ТипЗаказа = ЗНАЧЕНИЕ(Справочник.ТипыЗаказов.ПустаяСсылка))
	               |	И (ОпределениеНоменклатурнойГруппы.ВидСобственности = &ВидСобственности
	               |			ИЛИ ОпределениеНоменклатурнойГруппы.ВидСобственности = ЗНАЧЕНИЕ(Перечисление.ВариантыСобственности.ПустаяСсылка)
	               // ДИТ 65580 Давудов М.А. Начало: 23.02.2023
	               //Было:
	               //|			ИЛИ ОпределениеНоменклатурнойГруппы.ВидСобственности = ЗНАЧЕНИЕ(Перечисление.ВариантыСобственности.Неизвестно))
	               //Стало:
	               |)";
	               // ДИТ 65580 Давудов М.А. Конец: 23.02.2023
	Запрос.УстановитьПараметр("ТипЗаказа", ТипЗаказа);
	Запрос.УстановитьПараметр("ВидСобственности", ВидСобственности);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		ОценкаСовпадений = 0;
		Если ЗначениеЗаполнено(Ответ.ТипЗаказа) Тогда ОценкаСовпадений = ОценкаСовпадений + 1; КонецЕсли;
		// ДИТ 65580 Давудов М.А. Начало: 23.02.2023
		//Было:
		//Если ЗначениеЗаполнено(Ответ.ВидСобственности) И Ответ.ВидСобственности <> Перечисления.ВариантыСобственности.Неизвестно Тогда ОценкаСовпадений = ОценкаСовпадений + 1; КонецЕсли;
		//Стало:
		Если ЗначениеЗаполнено(Ответ.ВидСобственности) 
		   И Ответ.ВидСобственности <> Перечисления.ВариантыСобственности.ПустаяСсылка() Тогда
			ОценкаСовпадений = ОценкаСовпадений + 1;
		КонецЕсли;
		// ДИТ 65580 Давудов М.А. Конец: 23.02.2023
		Если КоличествоСовпадений < ОценкаСовпадений Тогда
			КоличествоСовпадений = ОценкаСовпадений;
			Результат = Ответ.НоменклатурнаяГруппа;
		КонецЕсли;
		
	КонецЦикла;
	Если Результат = Неопределено Тогда
		ЗаписьЖурналаРегистрации("Определение номенклатурной группы",
								 УровеньЖурналаРегистрации.Ошибка,
								 ,
								 ,
								 СтрШаблон("Номенклатурная группа не определена:
								 |Тип заказа: %1
								 |Вагон: %2", ТипЗаказа, Вагон));
								 
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции
