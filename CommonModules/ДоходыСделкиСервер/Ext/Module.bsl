		КлючиСоставаПоезда = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("КлючАналитикиСоставаПоезда");
		ЗаполнитьДанныеРелизаСобственника(КлючиСоставаПоезда, , , РелизСобственника, ДанныеРелизаСобственника);
	КонецЕсли;
