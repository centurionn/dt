//ДИТ, Беляев СЮ, BUG 59400/TA 59404, 21-10-2022, начало (перенесено из модуля менеджера Сделки)
Процедура СкорректироватьСуммыРасшифровки(Объект) Экспорт
	//исправим суммы в расшифровке, чтобы суммы по строкам услуг совпадали с суммами их расшифровок
	//получим строки с суммами
//Евросиб Гудкова( 03.10.2021
//	ТЗСуммыУслуги = Объект.Услуги.Выгрузить(,"СтрокаДоходовСделки, Сумма, СуммаНДС");
	ЭтоКоррРТУ = Ложь;
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.ОтчетКомитентуОПродажах") Тогда
		ТЗСуммыУслуги = Объект.Товары.Выгрузить(,"СтрокаДоходовСделки, Сумма, СуммаНДС");
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.КорректировкаРеализации") Тогда 
		ЭтоКоррРТУ = Истина;
		ТЗСуммыУслуги = Объект.Услуги.Выгрузить(,"СтрокаДоходовСделки, Сумма, СуммаНДС, СтрокаДоходовСделкиДоИзменения, СуммаДоИзменения, СуммаНДСДоИзменения");
	Иначе
		ТЗСуммыУслуги = Объект.Услуги.Выгрузить(,"СтрокаДоходовСделки, Сумма, СуммаНДС");
	КонецЕсли; 
// Евросиб Гудкова) 	
	Если ЭтоКоррРТУ Тогда
		ТЗСуммыУслуги.Свернуть("СтрокаДоходовСделки, СтрокаДоходовСделкиДоИзменения", "Сумма, СуммаНДС,СуммаДоИзменения, СуммаНДСДоИзменения");
	Иначе	
		ТЗСуммыУслуги.Свернуть("СтрокаДоходовСделки", "Сумма, СуммаНДС");
	КонецЕсли; 
	//получим расшифровки с суммами
	Если ЭтоКоррРТУ Тогда
		//ТЗСуммыРасшифровки = Объект.РасшифровкаУслугПоТС.Выгрузить(,"СтрокаДоходовСделки, СтрокаДоходовСделкиДоИзменения, СуммаДоИзменения, СуммаНДСДоИзменения");
		//ТЗСуммыРасшифровки.Свернуть("СтрокаДоходовСделки, СтрокаДоходовСделкиДоИзменения, СуммаДоИзменения, СуммаНДСДоИзменения");     
		//ДИТ Беляев СЮ, Ticket#0248427, Ticket#0249386 09-11-2021 ++
		ТЗСуммыРасшифровки = Объект.РасшифровкаУслугПоТС.Выгрузить(,"СтрокаДоходовСделки, СтрокаДоходовСделкиДоИзменения, СуммаДоИзменения, СуммаНДСДоИзменения, Сумма, СуммаНДС");
		ТЗСуммыРасшифровки.Свернуть("СтрокаДоходовСделки, СтрокаДоходовСделкиДоИзменения","СуммаДоИзменения, СуммаНДСДоИзменения, Сумма, СуммаНДС");
		//ДИТ Беляев СЮ, Ticket#0248427, Ticket#0249386 09-11-2021 --
	Иначе
		ТЗСуммыРасшифровки = Объект.РасшифровкаУслугПоТС.Выгрузить(,"СтрокаДоходовСделки, Сумма, СуммаНДС");
		ТЗСуммыРасшифровки.Свернуть("СтрокаДоходовСделки", "Сумма, СуммаНДС");
	КонецЕсли; 
	//сверим суммы
	Для каждого СтрокаСуммаУслуги Из ТЗСуммыУслуги Цикл
		СтрокаСуммаРасшифровки = ТЗСуммыРасшифровки.Найти(СтрокаСуммаУслуги.СтрокаДоходовСделки);
		Если СтрокаСуммаРасшифровки <> Неопределено Тогда
			Если СтрокаСуммаУслуги.Сумма <> СтрокаСуммаРасшифровки.Сумма
				ИЛИ СтрокаСуммаУслуги.СуммаНДС <> СтрокаСуммаРасшифровки.СуммаНДС Тогда
				//перезаполним суммы
				СтрокиРасшифровки = Объект.РасшифровкаУслугПоТС.НайтиСтроки(Новый Структура("СтрокаДоходовСделки", СтрокаСуммаУслуги.СтрокаДоходовСделки));
				СуммаПоСтроке = СтрокаСуммаУслуги.Сумма / СтрокиРасшифровки.Количество();
				СуммаНДСПоСтроке = СтрокаСуммаУслуги.СуммаНДС / СтрокиРасшифровки.Количество();
				ОстатокСумма = СтрокаСуммаУслуги.Сумма;
				ОстатокСуммаНДС = СтрокаСуммаУслуги.СуммаНДС;
				Для каждого СтрокаРасшифровки Из СтрокиРасшифровки Цикл
					СтрокаРасшифровки.Цена = СуммаПоСтроке;
					СтрокаРасшифровки.Сумма = СуммаПоСтроке;
					СтрокаРасшифровки.СуммаНДС = СуммаНДСПоСтроке;
					ОстатокСумма = ОстатокСумма - СтрокаРасшифровки.Сумма;
					ОстатокСуммаНДС = ОстатокСуммаНДС - СтрокаРасшифровки.СуммаНДС;
				КонецЦикла; 
				Если ОстатокСумма <> 0 Тогда
					СтрокаРасшифровки.Сумма = СтрокаРасшифровки.Сумма + ОстатокСумма;
					СтрокаРасшифровки.Цена = СтрокаРасшифровки.Сумма;
				КонецЕсли; 
				Если ОстатокСуммаНДС <> 0 Тогда
					СтрокаРасшифровки.СуммаНДС = СтрокаРасшифровки.СуммаНДС + ОстатокСуммаНДС;
				КонецЕсли; 
			КонецЕсли;
			Если ЭтоКоррРТУ Тогда
				Если СтрокаСуммаУслуги.СуммаДоИзменения <> СтрокаСуммаРасшифровки.СуммаДоИзменения
					ИЛИ СтрокаСуммаУслуги.СуммаНДСДоИзменения <> СтрокаСуммаРасшифровки.СуммаНДСДоИзменения Тогда
					//перезаполним суммы
					//Евросиб - АСуслов 05.03.2022 10:53:51 #
					//
					//(
					//СтрокиРасшифровки = Объект.РасшифровкаУслугПоТС.НайтиСтроки(Новый Структура("СтрокаДоходовСделкиДоИзменения", СтрокаСуммаУслуги.СтрокаДоходовСделкиДоИзменения));
					СтрокиРасшифровки = Объект.РасшифровкаУслугПоТС.НайтиСтроки(Новый Структура("СтрокаДоходовСделкиДоИзменения", ?(СтрокаСуммаУслуги.СтрокаДоходовСделкиДоИзменения = "", СтрокаСуммаУслуги.СтрокаДоходовСделки, СтрокаСуммаУслуги.СтрокаДоходовСделкиДоИзменения)));
					//)
					//Евросиб - АСуслов 05.03.2022 10:53:52 #
					СуммаПоСтроке = СтрокаСуммаУслуги.СуммаДоИзменения / СтрокиРасшифровки.Количество();
					СуммаНДСПоСтроке = СтрокаСуммаУслуги.СуммаНДСДоИзменения / СтрокиРасшифровки.Количество();
					ОстатокСумма = СтрокаСуммаУслуги.СуммаДоИзменения;
					ОстатокСуммаНДС = СтрокаСуммаУслуги.СуммаНДСДоИзменения;
					Для каждого СтрокаРасшифровки Из СтрокиРасшифровки Цикл
						СтрокаРасшифровки.ЦенаДоИзменения = СуммаПоСтроке;
						СтрокаРасшифровки.СуммаДоИзменения = СуммаПоСтроке;
						СтрокаРасшифровки.СуммаНДСДоИзменения = СуммаНДСПоСтроке;
						ОстатокСумма = ОстатокСумма - СтрокаРасшифровки.СуммаДоИзменения;
						ОстатокСуммаНДС = ОстатокСуммаНДС - СтрокаРасшифровки.СуммаНДСДоИзменения;
					КонецЦикла; 
					Если ОстатокСумма <> 0 Тогда
						СтрокаРасшифровки.СуммаДоИзменения = СтрокаРасшифровки.СуммаДоИзменения + ОстатокСумма;
						СтрокаРасшифровки.ЦенаДоИзменения = СтрокаРасшифровки.СуммаДоИзменения;
					КонецЕсли; 
					Если ОстатокСуммаНДС <> 0 Тогда
						СтрокаРасшифровки.СуммаНДСДоИзменения = СтрокаРасшифровки.СуммаНДСДоИзменения + ОстатокСуммаНДС;
					КонецЕсли; 
				КонецЕсли;
			КонецЕсли; 
		КонецЕсли; 
	КонецЦикла; 
КонецПроцедуры
//ДИТ, Беляев СЮ, BUG 59400/TA 59404, 21-10-2022, конец

// Евросиб US 82073 TA 114490 Рыбьяков К.А. 17.03.2026 ((
Процедура ЗаполнитьДанныеРелизаСобственника(КлючиСоставаПоезда = Неопределено, Сделка, ГуидДоходнойСтроки, РелизСобственника, СтруктураОтвет) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	РелизСобственникаНоминации.Контейнер КАК Контейнер,
	|	РелизСобственникаНоминации.Ссылка.Сток КАК Сток,
	|	РелизСобственникаНоминации.КлючАналитики.КлючАналитикиСоставаПоезда КАК КлючАналитикиСоставаПоезда
	|ПОМЕСТИТЬ ВТ_ДанныеРелиза
	|ИЗ
	|	Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	|ГДЕ
	|	РелизСобственникаНоминации.Ссылка В(&Релизы)
	|	И РелизСобственникаНоминации.КлючАналитики.КлючАналитикиСоставаПоезда В(&КлючиАналитикиСоставаПоезда)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	стоки_ТекущиеДанныеСрезПоследних.КТК КАК КТК,
	|	стоки_ТекущиеДанныеСрезПоследних.тек_СтокСдачи КАК СтокСдачи,
	|	стоки_ТекущиеДанныеСрезПоследних.тек_ДатаСдачиВСток КАК тек_ДатаСдачиВСток
	|ПОМЕСТИТЬ ВТ_ТекущиеДанные
	|ИЗ
	|	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних(
	|			&Дата,
	|			тек_Релиз В (&Релизы)
	|				И КТК В
	|					(ВЫБРАТЬ
	|						ВТ_ДанныеРелиза.Контейнер
	|					ИЗ
	|						ВТ_ДанныеРелиза)
	|				И тек_СтокСдачи <> ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка)) КАК стоки_ТекущиеДанныеСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	//|	ВТ_ДанныеРелиза.Контейнер КАК Контейнер,
	|	ВТ_ДанныеРелиза.Сток КАК ПунктОтправления,
	//|	ВТ_ДанныеРелиза.КлючАналитикиСоставаПоезда КАК КлючАналитикиСоставаПоезда,
	|	ВТ_ТекущиеДанные.СтокСдачи КАК ПунктНазначения,
	|	МАКСИМУМ(ВТ_ТекущиеДанные.тек_ДатаСдачиВСток) КАК ДатаОтправки,
	|	ЗНАЧЕНИЕ(Справочник.Грузы.КонтейнерыУниверсальныеПорожниеСобственные) КАК Груз
	|ИЗ
	|	ВТ_ДанныеРелиза КАК ВТ_ДанныеРелиза
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТекущиеДанные КАК ВТ_ТекущиеДанные
	|		ПО ВТ_ДанныеРелиза.Контейнер = ВТ_ТекущиеДанные.КТК
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ТекущиеДанные.СтокСдачи,
	//|	ВТ_ТекущиеДанные.тек_ДатаСдачиВСток,
	//|	ВТ_ДанныеРелиза.КлючАналитикиСоставаПоезда,
	|	ВТ_ДанныеРелиза.Сток
	//|	ВТ_ДанныеРелиза.Контейнер
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаОтправки УБЫВ";
	
	Если ЗначениеЗаполнено(ГуидДоходнойСтроки) Тогда
		МассивКонтейнеров = ПолучитьКонтейнерыДоходнойСтроки(Сделка, ГуидДоходнойСтроки);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И РелизСобственникаНоминации.КлючАналитики.КлючАналитикиСоставаПоезда В(&КлючиАналитикиСоставаПоезда)"
												, "И РелизСобственникаНоминации.Контейнер В(&Контейнеры)");
		Запрос.УстановитьПараметр("Контейнеры", МассивКонтейнеров);
	Иначе
		Запрос.УстановитьПараметр("КлючиАналитикиСоставаПоезда", КлючиСоставаПоезда);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Релизы", РелизСобственника);
	
	Выгрузка = Запрос.Выполнить().Выгрузить();
	
	СтруктураОтвет.ТаблицаДанных = Выгрузка;
	//СтруктураОтвет.ДатаДокумента = ?(Выгрузка.Количество() > 0, Выгрузка[0].ДатаОтправки, Дата("00010101"));
	
КонецПроцедуры // Евросиб Рыбьяков К.А. 17.03.2026 ))

// Евросиб US 82073 TA 114490 Рыбьяков К.А. 18.03.2026 ((
Функция ПолучитьКонтейнерыДоходнойСтроки(Сделка, ГуидДоходнойСтроки)
	
	МассивКонтейнеров = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СделкаДоходыКТК.КТК КАК КТК
		|ИЗ
		|	Документ.Сделка.ДоходыКТК КАК СделкаДоходыКТК
		|ГДЕ
		|	СделкаДоходыКТК.ГУИД = &ГУИД
		|	И СделкаДоходыКТК.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("ГУИД", ГуидДоходнойСтроки);
	Запрос.УстановитьПараметр("Ссылка", Сделка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		МассивКонтейнеровСтрокой = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Выборка.КТК, ";", Истина);
		Для Каждого КТКСтрокой Из МассивКонтейнеровСтрокой Цикл
			Контейнер = РаботаСКонтейнерамиСервер.НайтиКТК(Выборка.КТК, Ложь);
			Если Контейнер <> Неопределено Тогда
				МассивКонтейнеров.Добавить(Контейнер);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат МассивКонтейнеров;
	
КонецФункции
