Функция ПолучитьСвязиПоОсновнымУслугам(СделкаОбъект)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СделкаСвязьДоходовИРасходов.НомерСтроки КАК НомерСтроки,
	|	СделкаСвязьДоходовИРасходов.Доходы КАК Доходы,
	|	СделкаСвязьДоходовИРасходов.Расходы КАК Расходы,
	|	СделкаСвязьДоходовИРасходов.СвязьУчетныхЕдиниц КАК СвязьУчетныхЕдиниц,
	|	СделкаСвязьДоходовИРасходов.Услуга КАК Услуга
	|ПОМЕСТИТЬ ВТ_СвязьДоходовИРасходов
	|ИЗ
	|	Документ.Сделка.СвязьДоходовИРасходов КАК СделкаСвязьДоходовИРасходов  
	//ДИТ, Беляев СЮ, Ticket#0272761, 24-05-2022, начало
	|ГДЕ
	|	СделкаСвязьДоходовИРасходов.Услуга = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
    //ДИТ, Беляев СЮ, Ticket#0272761, 24-05-2022, конец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СделкаДоходы.ГУИД КАК ГУИД
	|ПОМЕСТИТЬ ВТ_Доходы
	|ИЗ
	|	Документ.Сделка.Доходы КАК СделкаДоходы
	|ГДЕ
	|	СделкаДоходы.УслугаВнеСтавки = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СделкаСвязьДоходовИРасходов.Доходы КАК Доходы,
	|	СделкаСвязьДоходовИРасходов.СвязьУчетныхЕдиниц КАК СвязьУчетныхЕдиниц
	|ИЗ
	|	ВТ_СвязьДоходовИРасходов КАК СделкаСвязьДоходовИРасходов
	|ГДЕ
	|	СделкаСвязьДоходовИРасходов.Доходы В
	|			(ВЫБРАТЬ
	|				т.ГУИД
	|			ИЗ
	|				ВТ_Доходы КАК т)";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Сделка.СвязьДоходовИРасходов", "&СвязьДоходовИРасходов");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Сделка.Доходы", "&Доходы");
	Запрос.УстановитьПараметр("Доходы", СделкаОбъект.Доходы.Выгрузить());
	Запрос.УстановитьПараметр("СвязьДоходовИРасходов", СделкаОбъект.СвязьДоходовИРасходов.Выгрузить());
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьМассивКонтейнеровПоРеестру(Объект, СписокРеестров) 
	
	Если Не ЗначениеЗаполнено(СписокРеестров) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаявкаСоставУслуги.НомерКТК КАК Контейнер
	|ИЗ
	|	Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
	|ГДЕ
	|	ЗаявкаСоставУслуги.Ссылка В(&СписокЗаявок)
	|	И ЗаявкаСоставУслуги.РеестрКлиента В(&РеестрКлиента)";
	Запрос.УстановитьПараметр("СписокЗаявок", Объект.СвязьУчетныхЕдиниц.Выгрузить(,"Заявка"));
	Запрос.УстановитьПараметр("РеестрКлиента", СписокРеестров);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Контейнер");
		
КонецФункции

