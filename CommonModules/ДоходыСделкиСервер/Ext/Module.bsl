			//												ВыборкаДетальныеЗаписи.КлючАналитикиСоставаПоезда));
			//Если НайденныеСтроки.Количество() = 1 Тогда
				ЗаполнитьЗначенияСвойств(НовСтрТЗ, ДанныеРелизаСобственника.ТаблицаДанных[0]);
				НовСтрТЗ.ФактическийВес = 0;
				НовСтрТЗ.РасчетныйВес = 0;
				НовСтрТЗ.НомерЖДН = Неопределено;
				НовСтрТЗ.ЖДН = Неопределено;
			//КонецЕсли;
		КонецЕсли;
		// Евросиб Рыбьяков К.А. 17.03.2026 ))
	КонецЦикла;
	
	Если ОбъектДляЗаполнения.РасшифровкаУслугПоТС.Количество() = 0 Тогда
		ОбъектДляЗаполнения.РасшифровкаУслугПоТС.Загрузить(РасшифровкаУслугПоТС_ДоЗаполнения);
	КонецЕсли;
	
	СкорректироватьСуммыРасшифровки(ОбъектДляЗаполнения);
	
КонецПроцедуры
