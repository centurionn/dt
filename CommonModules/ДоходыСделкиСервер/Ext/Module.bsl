		ТЗУслугиРТУ.Колонки.Добавить("СуммаВознаграждения", Новый ОписаниеТипов("Число"));
		ТЗУслугиРТУ.Колонки.Добавить("СуммаНДСВознаграждения", Новый ОписаниеТипов("Число"));
