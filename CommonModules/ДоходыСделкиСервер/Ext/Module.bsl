Процедура ДобавитьВагонВДоходы(Объект, ГУИДДоходов, СписокВагонов, Замещать = Истина)
	ПараметрыПоиска = Новый Структура("ГУИД", ГУИДДоходов);
	СтрокиВагоны = Объект.ДоходыВагоны.НайтиСтроки(ПараметрыПоиска);
	Если СтрокиВагоны.Количество() = 0 Тогда
		нСтрока = Объект.ДоходыВагоны.Добавить();
		нСтрока.ГУИД = ГУИДДоходов;
	Иначе
		нСтрока = СтрокиВагоны[0];
	КонецЕсли; 
	Если Замещать Тогда
		нСтрока.Вагон = СписокВагонов;
	Иначе
		нСтрока.Вагон = нСтрока.Вагон + ?(нСтрока.Вагон = "", "", ";") + СписокВагонов; 
	КонецЕсли;
КонецПроцедуры

