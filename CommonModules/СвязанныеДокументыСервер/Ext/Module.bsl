
Процедура ПроверитьСвязьСРелизом(Документ) Экспорт

	Если ТипЗнч(Документ) = Тип("ДокументОбъект.Акцепт") 
		Или ТипЗнч(Документ) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг") Тогда
		СвязьРелизПоступление_Акцепт(Документ);	
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументОбъект.Заявка") Тогда
		СвязьРелизЗаявка(Документ);
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		СвязьРелизРеализация(Документ);
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументОбъект.СчетНаОплатуПокупателю") 
		Или ТипЗнч(Документ) = Тип("ДокументОбъект.ПоступлениеНаРасчетныйСчет") Тогда
		СвязьРелизСчетНаОплатуПокупателя_ПоступлениеНаСчет(Документ);
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументОбъект.Сделка") Тогда
		СвязьРелизСделка(Документ);
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументОбъект.ПСЦ") Тогда
		СвязьРелизПротокол(Документ);
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументОбъект.Калькуляция") Тогда
		СвязьРелизКалькуляция(Документ);
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументОбъект.РелизКлиента") Тогда
		ЗаполнитьРегистрСвязанныеОбъектыПоРелизуКлиента(Документ);
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументОбъект.РелизСобственника") Тогда
		ЗаполнитьРегистрСвязанныеОбъектыПоРелизуСобственника(Документ);
	КонецЕсли;	
	
КонецПроцедуры

Процедура СвязьРелизПоступление_Акцепт(ИмяДокумента)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	//"ВЫБРАТЬ РАЗЛИЧНЫЕ
	//|	РелизСобственникаНоминации.Ссылка КАК Основание,
	//|	ПоступлениеТоваровУслуг.Ссылка КАК ПТУСсылка,
	//|	АкцептУслуги.Ссылка КАК АкцептСсылка
	//|ПОМЕСТИТЬ вт_ПТУиАкцепты
	//|ИЗ
	//|	Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	//|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	//|		ПО (РелизСобственникаНоминации.Ссылка.СобственныеКТК
	//|			ИЛИ (РелизСобственникаНоминации.Ссылка.МорскиеКТК
	//|				ИЛИ НЕ РелизСобственникаНоминации.Ссылка.МорскиеКТК
	//|					И НЕ РелизСобственникаНоминации.Ссылка.СобственныеКТК
	//|					И НЕ РелизСобственникаНоминации.Ссылка.ДоплатныеКТК)
	//|				И РелизСобственникаНоминации.Ссылка.Договор = ПоступлениеТоваровУслуг.ДоговорКонтрагента
	//|				И РелизСобственникаНоминации.Ссылка.Контрагент = ПоступлениеТоваровУслуг.Контрагент)
	//|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Акцепт.Услуги КАК АкцептУслуги
	//|		ПО (АкцептУслуги.Ссылка.Поступление = ПоступлениеТоваровУслуг.Ссылка)
	//|			И (АкцептУслуги.Контейнер = РелизСобственникаНоминации.Контейнер)
	//|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.стоки_ТекущиеДанные КАК стоки_ТекущиеДанные
	//|		ПО РелизСобственникаНоминации.Контейнер = стоки_ТекущиеДанные.КТК
	//|			И РелизСобственникаНоминации.Ссылка = стоки_ТекущиеДанные.тек_Релиз
	//|			И РелизСобственникаНоминации.ДатаВзятия = стоки_ТекущиеДанные.тек_ДатаПриемаВПользование
	//|		И АкцептУслуги.НачалоОказанияУслуги МЕЖДУ стоки_ТекущиеДанные.тек_ДатаПриемаВПользование И ВЫБОР
	//|			КОГДА стоки_ТекущиеДанные.тек_ДатаСдачиВСток = ДАТАВРЕМЯ(1, 1, 1)
	//|				ТОГДА &ТекущаяДата
	//|			ИНАЧЕ стоки_ТекущиеДанные.тек_ДатаСдачиВСток
	//|		КОНЕЦ
	//|		И АкцептУслуги.ОкончаниеОказанияУслуги МЕЖДУ стоки_ТекущиеДанные.тек_ДатаПриемаВПользование И ВЫБОР
	//|			КОГДА стоки_ТекущиеДанные.тек_ДатаСдачиВСток = ДАТАВРЕМЯ(1, 1, 1)
	//|				ТОГДА &ТекущаяДата
	//|			ИНАЧЕ стоки_ТекущиеДанные.тек_ДатаСдачиВСток
	//|		КОНЕЦ
	//|		И АкцептУслуги.Ссылка = &Документ
	//|		
	//|;
	//|////////////////////////////////////////////////////////////////////////////////
	//|ВЫБРАТЬ
	//|	вт_ПТУиАкцепты.Основание КАК Основание,
	//|	вт_ПТУиАкцепты.ПТУСсылка КАК Ссылка
	//|ИЗ
	//|	вт_ПТУиАкцепты КАК вт_ПТУиАкцепты
	//|
	//|ОБЪЕДИНИТЬ
	//|
	//|ВЫБРАТЬ
	//|	вт_ПТУиАкцепты.Основание,
	//|	вт_ПТУиАкцепты.АкцептСсылка
	//|ИЗ
	//|	вт_ПТУиАкцепты КАК вт_ПТУиАкцепты"; 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РелизСобственникаНоминации.Ссылка КАК Основание,
	|	АкцептУслуги.Ссылка.Поступление КАК ПТУСсылка,
	|	АкцептУслуги.Ссылка КАК АкцептСсылка,
	|	АкцептУслуги.Контейнер КАК Контейнер,
	|	АкцептУслуги.НачалоОказанияУслуги КАК НачалоОказанияУслуги,
	|	АкцептУслуги.ОкончаниеОказанияУслуги КАК ОкончаниеОказанияУслуги,
	|	РелизСобственникаНоминации.ДатаВзятия КАК ДатаВзятия
	|ПОМЕСТИТЬ вт_ПТУиАкцепты_строки
	|ИЗ
	|	Документ.Акцепт.Услуги КАК АкцептУслуги
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	|		ПО (АкцептУслуги.Контейнер = РелизСобственникаНоминации.Контейнер)
	|			И (РелизСобственникаНоминации.Ссылка.Договор = АкцептУслуги.Ссылка.Поступление.ДоговорКонтрагента)
	|			И (РелизСобственникаНоминации.Ссылка.Контрагент = АкцептУслуги.Ссылка.Поступление.Контрагент)
	|			И (АкцептУслуги.Ссылка = &Документ)
	|			И (РелизСобственникаНоминации.Ссылка.СобственныеКТК
	|				ИЛИ (РелизСобственникаНоминации.Ссылка.МорскиеКТК
	|					ИЛИ НЕ РелизСобственникаНоминации.Ссылка.МорскиеКТК
	|						И НЕ РелизСобственникаНоминации.Ссылка.СобственныеКТК
	|						И НЕ РелизСобственникаНоминации.Ссылка.ДоплатныеКТК))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	вт_ПТУиАкцепты_строки.Основание КАК Основание,
	|	вт_ПТУиАкцепты_строки.ПТУСсылка КАК ПТУСсылка,
	|	вт_ПТУиАкцепты_строки.АкцептСсылка КАК АкцептСсылка
	|ПОМЕСТИТЬ вт_ПТУиАкцепты
	|ИЗ
	|	вт_ПТУиАкцепты_строки КАК вт_ПТУиАкцепты_строки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.стоки_ТекущиеДанные КАК стоки_ТекущиеДанные
	|		ПО (вт_ПТУиАкцепты_строки.Контейнер = стоки_ТекущиеДанные.КТК
	|				И вт_ПТУиАкцепты_строки.Основание = стоки_ТекущиеДанные.тек_Релиз
	|				И вт_ПТУиАкцепты_строки.ДатаВзятия = стоки_ТекущиеДанные.тек_ДатаПриемаВПользование
	|				И (вт_ПТУиАкцепты_строки.НачалоОказанияУслуги МЕЖДУ стоки_ТекущиеДанные.тек_ДатаПриемаВПользование И ВЫБОР
	|					КОГДА стоки_ТекущиеДанные.тек_ДатаСдачиВСток = ДАТАВРЕМЯ(1, 1, 1)
	|						ТОГДА &ТекущаяДата
	|					ИНАЧЕ стоки_ТекущиеДанные.тек_ДатаСдачиВСток
	|				КОНЕЦ)
	|				И (вт_ПТУиАкцепты_строки.ОкончаниеОказанияУслуги МЕЖДУ стоки_ТекущиеДанные.тек_ДатаПриемаВПользование И ВЫБОР
	|					КОГДА стоки_ТекущиеДанные.тек_ДатаСдачиВСток = ДАТАВРЕМЯ(1, 1, 1)
	|						ТОГДА &ТекущаяДата
	|					ИНАЧЕ стоки_ТекущиеДанные.тек_ДатаСдачиВСток
	|				КОНЕЦ))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_ПТУиАкцепты.Основание КАК Основание,
	|	вт_ПТУиАкцепты.ПТУСсылка КАК Ссылка
	|ИЗ
	|	вт_ПТУиАкцепты_строки КАК вт_ПТУиАкцепты
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	вт_ПТУиАкцепты.Основание,
	|	вт_ПТУиАкцепты.АкцептСсылка
	|ИЗ
	|	вт_ПТУиАкцепты_строки КАК вт_ПТУиАкцепты";
	
	
	Если ТипЗнч(ИмяДокумента) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "АкцептУслуги.Ссылка = ", "ПоступлениеТоваровУслуг.Ссылка = ");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Документ", ИмяДокумента.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();

	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();	
		Пока Выборка.Следующий() Цикл
			ЗаписатьСвязи(Выборка.Основание, Выборка.Ссылка);
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры

Процедура СвязьРелизЗаявка(ИмяДокумента)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РелизСобственникаНоминации.Ссылка КАК РелизСсылка,
	|	ЗаявкаСоставУслуги.Ссылка КАК ЗаявкаСсылка
	|ПОМЕСТИТЬ вт_ЗаявкиСРейсамиССоответствиемПоКТК
	|ИЗ
	|	Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
	|		ПО (ЗаявкаСоставУслуги.Ссылка = &СсылкаЗаявка)
	|			И (РелизСобственникаНоминации.Ссылка.ПСЦ = ЗНАЧЕНИЕ(Документ.ПСЦ.ПустаяСсылка))
	|			И (РелизСобственникаНоминации.Ссылка.Договор = ЗаявкаСоставУслуги.Ссылка.Договор)
	|			И (РелизСобственникаНоминации.Ссылка.Контрагент = ЗаявкаСоставУслуги.Ссылка.Контрагент)
	|			И (РелизСобственникаНоминации.Контейнер = ЗаявкаСоставУслуги.НомерКТК)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
	|		ПО (ЗаявкаСоставУслуги.Ссылка = ЗаявкаПереченьРейсов.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РейсыЖД.ФактическийСоставПоезда КАК РейсыЖДФактическийСоставПоезда
	|		ПО (ЗаявкаПереченьРейсов.Рейс = РейсыЖДФактическийСоставПоезда.Ссылка)
	|			И (НЕ ЗаявкаПереченьРейсов.Рейс ЕСТЬ NULL)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.стоки_ТекущиеДанные КАК стоки_ТекущиеДанные
	|		ПО (РелизСобственникаНоминации.Контейнер = стоки_ТекущиеДанные.КТК)
	|			И (РелизСобственникаНоминации.Ссылка = стоки_ТекущиеДанные.тек_Релиз)
	|			И (РелизСобственникаНоминации.ДатаВзятия = стоки_ТекущиеДанные.тек_ДатаПриемаВПользование)
	|			И (ЗаявкаПереченьРейсов.Рейс.ДатаОтправления МЕЖДУ стоки_ТекущиеДанные.тек_ДатаПриемаВПользование И ВЫБОР
	|				КОГДА стоки_ТекущиеДанные.тек_ДатаСдачиВСток = ДАТАВРЕМЯ(1, 1, 1)
	|					ТОГДА &ТекущаяДата
	|				ИНАЧЕ стоки_ТекущиеДанные.тек_ДатаСдачиВСток
	|			КОНЕЦ)
	|			И (ЗаявкаПереченьРейсов.Рейс.ДатаПрибытия МЕЖДУ стоки_ТекущиеДанные.тек_ДатаПриемаВПользование И ВЫБОР
	|				КОГДА стоки_ТекущиеДанные.тек_ДатаСдачиВСток = ДАТАВРЕМЯ(1, 1, 1)
	|					ТОГДА &ТекущаяДата
	|				ИНАЧЕ стоки_ТекущиеДанные.тек_ДатаСдачиВСток
	|			КОНЕЦ)
	|			И (РейсыЖДФактическийСоставПоезда.НомерКонтейнера = РелизСобственникаНоминации.Контейнер.Наименование)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РелизСобственникаНоминации.Ссылка КАК РелизСсылка
	|ПОМЕСТИТЬ вт_ЗаявкиСРейсамиБезСоответствияПоКТК
	|ИЗ
	|	Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
	|		ПО (ЗаявкаСоставУслуги.Ссылка = &СсылкаЗаявка)
	|			И (РелизСобственникаНоминации.Ссылка.ПСЦ = ЗНАЧЕНИЕ(Документ.ПСЦ.ПустаяСсылка))
	|			И РелизСобственникаНоминации.Ссылка.Договор = ЗаявкаСоставУслуги.Ссылка.Договор
	|			И РелизСобственникаНоминации.Ссылка.Контрагент = ЗаявкаСоставУслуги.Ссылка.Контрагент
	|			И РелизСобственникаНоминации.Контейнер = ЗаявкаСоставУслуги.НомерКТК
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
	|		ПО (ЗаявкаСоставУслуги.Ссылка = ЗаявкаПереченьРейсов.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РейсыЖД.ФактическийСоставПоезда КАК РейсыЖДФактическийСоставПоезда
	|		ПО (ЗаявкаПереченьРейсов.Рейс = РейсыЖДФактическийСоставПоезда.Ссылка)
	|			И (НЕ ЗаявкаПереченьРейсов.Рейс ЕСТЬ NULL)
	|			И (РейсыЖДФактическийСоставПоезда.НомерКонтейнера = РелизСобственникаНоминации.Контейнер.Наименование)
	|		ЛЕВОЕ СОЕДИНЕНИЕ вт_ЗаявкиСРейсамиССоответствиемПоКТК КАК вт_ЗаявкиСРейсамиССоответствиемПоКТК
	|		ПО (вт_ЗаявкиСРейсамиССоответствиемПоКТК.ЗаявкаСсылка = ЗаявкаСоставУслуги.Ссылка)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.стоки_ТекущиеДанные КАК стоки_ТекущиеДанные
	|		ПО РелизСобственникаНоминации.Контейнер = стоки_ТекущиеДанные.КТК
	|			И РелизСобственникаНоминации.Ссылка = стоки_ТекущиеДанные.тек_Релиз
	|			И РелизСобственникаНоминации.ДатаВзятия = стоки_ТекущиеДанные.тек_ДатаПриемаВПользование
	|			И (ЗаявкаПереченьРейсов.Рейс.ДатаОтправления МЕЖДУ стоки_ТекущиеДанные.тек_ДатаПриемаВПользование И ВЫБОР
	|				КОГДА стоки_ТекущиеДанные.тек_ДатаСдачиВСток = ДАТАВРЕМЯ(1, 1, 1)
	|					ТОГДА &ТекущаяДата
	|				ИНАЧЕ стоки_ТекущиеДанные.тек_ДатаСдачиВСток
	|			КОНЕЦ)
	|			И (ЗаявкаПереченьРейсов.Рейс.ДатаПрибытия МЕЖДУ стоки_ТекущиеДанные.тек_ДатаПриемаВПользование И ВЫБОР
	|				КОГДА стоки_ТекущиеДанные.тек_ДатаСдачиВСток = ДАТАВРЕМЯ(1, 1, 1)
	|					ТОГДА &ТекущаяДата
	|				ИНАЧЕ стоки_ТекущиеДанные.тек_ДатаСдачиВСток
	|			КОНЕЦ)
	|			И (РейсыЖДФактическийСоставПоезда.НомерКонтейнера ЕСТЬ NULL)
	|			И (вт_ЗаявкиСРейсамиССоответствиемПоКТК.ЗаявкаСсылка ЕСТЬ NULL)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РелизСобственникаНоминации.Ссылка КАК РелизСсылка
	|ПОМЕСТИТЬ вт_ЗаявкиБезРейсов
	|ИЗ
	|	Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
	|		ПО (ЗаявкаСоставУслуги.Ссылка = &СсылкаЗаявка)
	|			И (РелизСобственникаНоминации.Ссылка.ПСЦ = ЗНАЧЕНИЕ(Документ.ПСЦ.ПустаяСсылка))
	|			И РелизСобственникаНоминации.Ссылка.Договор = ЗаявкаСоставУслуги.Ссылка.Договор
	|			И РелизСобственникаНоминации.Ссылка.Контрагент = ЗаявкаСоставУслуги.Ссылка.Контрагент
	|			И РелизСобственникаНоминации.Контейнер = ЗаявкаСоставУслуги.НомерКТК
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
	|		ПО (ЗаявкаСоставУслуги.Ссылка = ЗаявкаПереченьРейсов.Ссылка)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.стоки_ТекущиеДанные КАК стоки_ТекущиеДанные
	|		ПО РелизСобственникаНоминации.Контейнер = стоки_ТекущиеДанные.КТК
	|			И РелизСобственникаНоминации.Ссылка = стоки_ТекущиеДанные.тек_Релиз
	|			И РелизСобственникаНоминации.ДатаВзятия = стоки_ТекущиеДанные.тек_ДатаПриемаВПользование
	|			И (ЗаявкаСоставУслуги.ДатаВыдачи МЕЖДУ стоки_ТекущиеДанные.тек_ДатаПриемаВПользование И ВЫБОР
	|				КОГДА стоки_ТекущиеДанные.тек_ДатаСдачиВСток = ДАТАВРЕМЯ(1, 1, 1)
	|					ТОГДА &ТекущаяДата
	|				ИНАЧЕ стоки_ТекущиеДанные.тек_ДатаСдачиВСток
	|			КОНЕЦ)
	|			И (ЗаявкаПереченьРейсов.Рейс ЕСТЬ NULL)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ  
	|	вт_ЗаявкиСРейсамиССоответствиемПоКТК.РелизСсылка КАК РелизСсылка,
	|	&СсылкаЗаявка КАК Ссылка
	|ПОМЕСТИТЬ вт_Заявки
	|ИЗ
	|	вт_ЗаявкиСРейсамиССоответствиемПоКТК КАК вт_ЗаявкиСРейсамиССоответствиемПоКТК
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ    
	|	вт_ЗаявкиСРейсамиБезСоответствияПоКТК.РелизСсылка,
	|	&СсылкаЗаявка
	|ИЗ
	|	вт_ЗаявкиСРейсамиБезСоответствияПоКТК КАК вт_ЗаявкиСРейсамиБезСоответствияПоКТК
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	вт_ЗаявкиБезРейсов.РелизСсылка,
	|	&СсылкаЗаявка
	|ИЗ
	|	вт_ЗаявкиБезРейсов КАК вт_ЗаявкиБезРейсов
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РелизСобственникаНоминации.Ссылка,
	|	&СсылкаЗаявка
	|ИЗ
	|	Документ.Заявка КАК Заявка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	|		ПО (Заявка.Ссылка = &СсылкаЗаявка)
	|			И (РелизСобственникаНоминации.Ссылка.ДоплатныеКТК)
	|			И (РелизСобственникаНоминации.Ссылка.ПСЦ.ПротоколНаДоплатныеКТК)
	|			И (РелизСобственникаНоминации.Ссылка.ПСЦ = Заявка.ПСЦ)
	|			И (Заявка.Проведен)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ 
	|	РелизСобственникаНоминации.Ссылка,
	|	&СсылкаЗаявка
	|ИЗ
	|	Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	|		ПО (ЗаявкаСоставУслуги.Ссылка = &СсылкаЗаявка)
	|			И (РелизСобственникаНоминации.Ссылка.ДоплатныеКТК)
	|			И (РелизСобственникаНоминации.Ссылка.ПСЦ.ПротоколНаДоплатныеКТК)
	|			И (РелизСобственникаНоминации.Ссылка.ПСЦ = ЗаявкаСоставУслуги.ПСЦ)
	|			И (РелизСобственникаНоминации.Контейнер = ЗаявкаСоставУслуги.НомерКТК)
	|			И (ЗаявкаСоставУслуги.ПеренесенВЗаявку = ЗНАЧЕНИЕ(Документ.Заявка.ПустаяСсылка))
	|			И (ЗаявкаСоставУслуги.Ссылка.Проведен)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ  
	|	вт_Заявки.РелизСсылка КАК Основание,
	|	вт_Заявки.Ссылка КАК Ссылка
	|ИЗ
	|	вт_Заявки КАК вт_Заявки";

	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("СсылкаЗаявка", ИмяДокумента.Ссылка);
		
	РезультатЗапроса = Запрос.Выполнить();
		
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();	
		Пока Выборка.Следующий() Цикл
			ЗаписатьСвязи(Выборка.Основание, Выборка.Ссылка);
		КонецЦикла;	
	КонецЕсли;	
	
КонецПроцедуры

Процедура СвязьРелизРеализация(ИмяДокумента)
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ 
	|	РелизСобственникаНоминации.Ссылка КАК Основание,
	|	РТУРасшифровкаПоТС.Ссылка КАК РТУСсылка
	|ПОМЕСТИТЬ ВТ_РТУ
	|ИЗ
	|	Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.РасшифровкаУслугПоТС КАК РТУРасшифровкаПоТС
	|		ПО (РТУРасшифровкаПоТС.Ссылка = &Ссылка)
	|			И (РелизСобственникаНоминации.Ссылка.ДоплатныеКТК)
	|			И РелизСобственникаНоминации.Ссылка.Договор = РТУРасшифровкаПоТС.Ссылка.ДоговорКонтрагента
	|			И РелизСобственникаНоминации.Ссылка.Контрагент = РТУРасшифровкаПоТС.Ссылка.Контрагент
	|			И РелизСобственникаНоминации.Контейнер = РТУРасшифровкаПоТС.Контейнер
	|			И (РТУРасшифровкаПоТС.Ссылка.Проведен)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.стоки_ТекущиеДанные КАК стоки_ТекущиеДанные
	|		ПО РелизСобственникаНоминации.Контейнер = стоки_ТекущиеДанные.КТК
	|			И РелизСобственникаНоминации.Ссылка = стоки_ТекущиеДанные.тек_Релиз
	|			И РелизСобственникаНоминации.ДатаВзятия = стоки_ТекущиеДанные.тек_ДатаПриемаВПользование
	|			И (РТУРасшифровкаПоТС.ДатаОтправки МЕЖДУ стоки_ТекущиеДанные.тек_ДатаПриемаВПользование И ВЫБОР
	|				КОГДА стоки_ТекущиеДанные.тек_ДатаСдачиВСток = ДАТАВРЕМЯ(1, 1, 1)
	|					ТОГДА &ТекущаяДата
	|				ИНАЧЕ стоки_ТекущиеДанные.тек_ДатаСдачиВСток
	|			КОНЕЦ)
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ 
	|	ВТ_РТУ.Основание,
	|	&Ссылка КАК Ссылка
	|ИЗ
	|	ВТ_РТУ КАК ВТ_РТУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.СчетаНаОплатуПокупателям КАК РеализацияТоваровУслугСчетаНаОплатуПокупателям
	|		ПО ВТ_РТУ.РТУСсылка = РеализацияТоваровУслугСчетаНаОплатуПокупателям.Ссылка";

	Запрос.УстановитьПараметр("Ссылка", ИмяДокумента.Ссылка);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
		
	РезультатЗапроса = Запрос.Выполнить();
		
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();	
		Пока Выборка.Следующий() Цикл
			ЗаписатьСвязи(Выборка.Основание, Выборка.Ссылка);
		КонецЦикла;	
	КонецЕсли;	
	
