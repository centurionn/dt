////////////////////////////////////////////////////////////////////////////////
// Содержит процедуры для подсвечивания полей на формах 
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

Процедура ВыполнитьДвиженияПодсветкаФормДокументов(Ссылка, ЭтотОбъект, ДополнительныеСвойства, Движения, Отказ, РежимПроведения) Экспорт
	
	// Получим предыдущие записи в новые движения
	ТаблицаДвижений = ПолучитьРанееДобавленныеЗаписи(Ссылка, ЭтотОбъект);
	
	// 1. Найти правило подсветки
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ПравилаПодсветкиИзмененийОбъектов.Ссылка КАК Ссылка,
	|	ПравилаПодсветкиИзмененийОбъектов.СравниватьВерсииОдногоОбъекта КАК СравниватьВерсииОдногоОбъекта,
	|	ПравилаПодсветкиИзмененийОбъектов.ВидОбъекта.Имя КАК ВидОбъектаИмя,
	|	ПравилаПодсветкиИзмененийОбъектов.ВидОбъекта.Родитель.Имя КАК ВидОбъектаРодительИмя,
	|	ПравилаПодсветкиИзмененийОбъектов.ВидОбъекта.ПолноеИмя КАК ВидОбъектаПолноеИмя,
	|	ПравилаПодсветкиИзмененийОбъектов.УсловияСравнения КАК УсловияСравнения,
	|	ПравилаПодсветкиИзмененийОбъектов.Правила.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		РеквизитФормы КАК РеквизитФормы,
	|		РеквизитДокумента КАК РеквизитДокумента,
	|		РеквизитИсточника КАК РеквизитИсточника
	|	) КАК Правила
	|ИЗ
	|	Справочник.ПравилаПодсветкиИзмененийОбъектов КАК ПравилаПодсветкиИзмененийОбъектов
	|ГДЕ
	|	ПравилаПодсветкиИзмененийОбъектов.ВидОбъекта = &ВидОбъекта";
	
	ВидОбъекта = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Ссылка));
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ВидОбъекта", ВидОбъекта);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		// Нет правил подсветки полей. Движения не делаем.
		Возврат;
	КонецЕсли;	
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		ДополнитьТаблицуДвиженийПоТекущемуПравилу(ДополнительныеСвойства, Ссылка, Выборка, ТаблицаДвижений);		
	КонецЦикла;
	
	Движения.ПодсветкаФормДокументов.Записывать = Истина;	
	
	ТаблицаДвижений.Свернуть("ГУИДСтроки, РеквизитФормы, ПравилоПодсветки");
	Для Каждого ТекСтрока Из ТаблицаДвижений Цикл			
		Движение = Движения.ПодсветкаФормДокументов.Добавить();
		Движение.Период 				= ТекущаяДата();
		Движение.ОформляемыйДокумент 	= Ссылка;
		Движение.ГУИДСтроки 			= ТекСтрока.ГУИДСтроки;
		Движение.РеквизитФормы 			= ТекСтрока.РеквизитФормы;
		Движение.ПравилоПодсветки 		= ТекСтрока.ПравилоПодсветки;
	КонецЦикла;
	
КонецПроцедуры		

Функция ПолучитьРанееДобавленныеЗаписи(Ссылка, ДокументОбъект) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ПодсветкаФормДокументов.ГУИДСтроки КАК ГУИДСтроки,
	|	ПодсветкаФормДокументов.РеквизитФормы КАК РеквизитФормы,
	|	ПодсветкаФормДокументов.ПравилоПодсветки КАК ПравилоПодсветки
	|ИЗ
	|	РегистрСведений.ПодсветкаФормДокументов КАК ПодсветкаФормДокументов
	|ГДЕ
	|	ПодсветкаФормДокументов.Регистратор = &Регистратор";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Регистратор", Ссылка);
	РезультатЗапроса = Запрос.Выполнить();

	ТаблицаДанных = РезультатЗапроса.Выгрузить();
	
	// Строки в табличных частях могли быть удадены,
	// поэтому удалим сведения по таким строкам чтобы не записывать из заново.	
	Индекс = ТаблицаДанных.Количество() - 1;
	Пока Индекс >= 0 Цикл
		
		ТекущаяСтрока = ТаблицаДанных[Индекс];
		
		Если ЗначениеЗаполнено(ТекущаяСтрока.ГУИДСтроки) Тогда
			
			ЧастиИмениРеквизита = СтрРазделить(ТекущаяСтрока.РеквизитФормы, ".");
			ИмяТабличнойЧасти = ЧастиИмениРеквизита[0];
			
			НайденныеСтроки = ДокументОбъект[ИмяТабличнойЧасти].НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущаяСтрока.ГУИДСтроки));
			
			Если НайденныеСтроки.Количество() = 0 Тогда
				ТаблицаДанных.Удалить(Индекс);
			КонецЕсли;
			
		КонецЕсли;
		
		Индекс = Индекс - 1;
	КонецЦикла;	
	
	Возврат ТаблицаДанных;
	
КонецФункции

Процедура ДополнитьТаблицуДвиженийПоТекущемуПравилу(ДополнительныеСвойства, Ссылка, Выборка, ТаблицаДвижений) Экспорт
	
	НастройкаПодсветки = Выборка.Ссылка;

	Если Выборка.СравниватьВерсииОдногоОбъекта Тогда
		СравниваемыйОбъект = ДополнительныеСвойства.ОбъектДоЗаписи;
	Иначе		
		СхемаПравилаОтбора = Справочники.ПравилаПодсветкиИзмененийОбъектов.ПолучитьМакет("СхемаОтбора");
		
		// Сформируем текст запроса
		СписокРеквизитов = Выборка.ВидОбъектаИмя + ".Ссылка";
		//РеквизитыСправочника = Метаданные[Выборка.ВидОбъектаРодительИмя][Выборка.ВидОбъектаИмя].Реквизиты;
		//Для Каждого ТекРеквизит Из РеквизитыСправочника Цикл
		//	СписокРеквизитов = СписокРеквизитов + ?(ПустаяСтрока(СписокРеквизитов), "", ", ") + Выборка.ВидОбъектаИмя + "." + ТекРеквизит.Имя;
		//КонецЦикла;
		ТекстЗапроса = "ВЫБРАТЬ %СписокРеквизитов% ИЗ " + Выборка.ВидОбъектаПолноеИмя + " КАК " + Выборка.ВидОбъектаИмя;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%СписокРеквизитов%", СписокРеквизитов);
		СхемаПравилаОтбора.НаборыДанных.ОсновнойНаборДанных.Запрос = ТекстЗапроса;
				
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
		КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
		КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаПравилаОтбора));
		КомпоновщикНастроек.ЗагрузитьНастройки(Выборка.УсловияСравнения.Получить());
		КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
		
		// Почему-то не копируется структура из макета. Добавим вручную
		Группировка = КомпоновщикНастроек.Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));     
		ПолеГруппировки = Группировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
		ПолеГруппировки.Использование = Истина;
		ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("Ссылка");
		ВыбранноеПоле = Группировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
		ВыбранноеПоле.Использование = Истина;
				
		МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(СхемаПравилаОтбора, КомпоновщикНастроек.ПолучитьНастройки(),,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		
		ТекстЗапроса = МакетКомпоновкиДанных.НаборыДанных.ОсновнойНаборДанных.Запрос;
		ЗапросПравило = Новый Запрос(ТекстЗапроса);
		Для Каждого Параметр Из МакетКомпоновкиДанных.ЗначенияПараметров Цикл
			ЗапросПравило.Параметры.Вставить(Параметр.Имя, Параметр.Значение);
		КонецЦикла;
		
		РезультатОтбораПоПравилу = ЗапросПравило.Выполнить();
		Если Не РезультатОтбораПоПравилу.Пустой() Тогда
			
			ВыборкаСравниваемогоОбъекта = РезультатОтбораПоПравилу.Выбрать();
			ВыборкаСравниваемогоОбъекта.Следующий();
			
			СравниваемыйОбъект = ВыборкаСравниваемогоОбъекта.Ссылка;
			
		Иначе
			// Нет объекта для сравнения.
			Возврат;
		КонецЕсли;
		
	КонецЕсли;

	// Определяем реквизиты, значения которых нужно получить для сравнения
	Правила = Выборка.Правила.Выгрузить();
	СписокРеквизитовШапкиТекущегоОбъекта = "";
	СписокРеквизитовШапкиСравниваемогоОбъекта = "";
	
	МассивТабличныйЧастейТекущегоОбъекта = Новый Массив;
	МассивТабличныхЧастейСравниваемогоОбъекта = Новый Массив;
	
	Для Каждого ТекСтрока Из Правила Цикл
		Если СтрНайти(ТекСтрока.РеквизитДокумента, ".") = 0 Тогда //это шапка документа
			СписокРеквизитовШапкиТекущегоОбъекта = СписокРеквизитовШапкиТекущегоОбъекта + ?(ПустаяСтрока(СписокРеквизитовШапкиТекущегоОбъекта), "", ",") + ТекСтрока.РеквизитДокумента;
		Иначе
			ИмяТабличнойЧасти = СтрРазделить(ТекСтрока.РеквизитДокумента, ".", Ложь);
			Если МассивТабличныйЧастейТекущегоОбъекта.Найти(ИмяТабличнойЧасти[0]) = Неопределено Тогда
				МассивТабличныйЧастейТекущегоОбъекта.Добавить(ИмяТабличнойЧасти[0]);
			КонецЕсли;	
		КонецЕсли;
		
		Если Выборка.СравниватьВерсииОдногоОбъекта И ПустаяСтрока(ТекСтрока.РеквизитИсточника) Тогда
			ТекСтрока.РеквизитИсточника = ТекСтрока.РеквизитДокумента;
		КонецЕсли;
		Если СтрНайти(ТекСтрока.РеквизитИсточника, ".") = 0 Тогда //это шапка документа
			СписокРеквизитовШапкиСравниваемогоОбъекта = СписокРеквизитовШапкиСравниваемогоОбъекта + ?(ПустаяСтрока(СписокРеквизитовШапкиСравниваемогоОбъекта), "", ",") + ТекСтрока.РеквизитИсточника;
		Иначе
			ИмяТабличнойЧасти = СтрРазделить(ТекСтрока.РеквизитИсточника, ".", Ложь);
			Если МассивТабличныхЧастейСравниваемогоОбъекта.Найти(ИмяТабличнойЧасти[0]) = Неопределено Тогда
				МассивТабличныхЧастейСравниваемогоОбъекта.Добавить(ИмяТабличнойЧасти[0]);
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;	
	
	Если МассивТабличныйЧастейТекущегоОбъекта.Количество() > 0 Тогда
		СписокРеквизитовШапкиТекущегоОбъекта = СписокРеквизитовШапкиТекущегоОбъекта
											+ ?(ПустаяСтрока(СписокРеквизитовШапкиТекущегоОбъекта), "", ",")
											+ СтрСоединить(МассивТабличныйЧастейТекущегоОбъекта, ",");
	КонецЕсли;
	Если МассивТабличныхЧастейСравниваемогоОбъекта.Количество() > 0 Тогда
		СписокРеквизитовШапкиСравниваемогоОбъекта = СписокРеквизитовШапкиСравниваемогоОбъекта
												+ ?(ПустаяСтрока(СписокРеквизитовШапкиСравниваемогоОбъекта), "", ",") 
												+ СтрСоединить(МассивТабличныхЧастейСравниваемогоОбъекта, ",");
	КонецЕсли;
	
	// Получаем значения сравниваемых реквизитов, указанных в правиле подсветки
	ЗначенияРеквизитовТекущегоОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, СписокРеквизитовШапкиТекущегоОбъекта);
	Если ТипЗнч(СравниваемыйОбъект) = Тип("Структура") Тогда
		ЗначенияРеквизитовИсточника = СравниваемыйОбъект;
	Иначе	
		ЗначенияРеквизитовИсточника = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СравниваемыйОбъект, СписокРеквизитовШапкиСравниваемогоОбъекта);
	КонецЕсли;	
	
	ТабличныеЧастиТекущегоОбъекта = Новый Соответствие;
	Для Каждого ТекущаяТЧ Из МассивТабличныйЧастейТекущегоОбъекта Цикл
		ТабличныеЧастиТекущегоОбъекта.Вставить(ТекущаяТЧ, ЗначенияРеквизитовТекущегоОбъекта[ТекущаяТЧ].Выгрузить());
	КонецЦикла;
	ТабличныеЧастиИсточника = Новый Соответствие;
	Для Каждого ТекущаяТЧ Из МассивТабличныхЧастейСравниваемогоОбъекта Цикл
		Если ТипЗнч(ЗначенияРеквизитовИсточника[ТекущаяТЧ]) = Тип("ТаблицаЗначений") Тогда
			ТабличныеЧастиИсточника.Вставить(ТекущаяТЧ, ЗначенияРеквизитовИсточника[ТекущаяТЧ]);
		Иначе	
			ТабличныеЧастиИсточника.Вставить(ТекущаяТЧ, ЗначенияРеквизитовИсточника[ТекущаяТЧ].Выгрузить());
		КонецЕсли;	
	КонецЦикла;
	
	ТипЧисло5 		= ОбщегоНазначения.ОписаниеТипаЧисло(5);
	ТипСтрока150 	= ОбщегоНазначения.ОписаниеТипаСтрока(150);
	ТипСтрока36 	= ОбщегоНазначения.ОписаниеТипаСтрока(36);
	ТипСтрока1000 	= ОбщегоНазначения.ОписаниеТипаСтрока(1000);
	
	ТаблицаРеквизитовТекущегоОбъекта = Новый ТаблицаЗначений;
	ТаблицаРеквизитовТекущегоОбъекта.Колонки.Добавить("НомерСтрокиПравила", ТипЧисло5);
	ТаблицаРеквизитовТекущегоОбъекта.Колонки.Добавить("РеквизитФормы", 		ТипСтрока150);
	ТаблицаРеквизитовТекущегоОбъекта.Колонки.Добавить("НомерСтрокиТЧ", 		ТипЧисло5);
	ТаблицаРеквизитовТекущегоОбъекта.Колонки.Добавить("ГУИДСтроки", 		ТипСтрока36);
	ТаблицаРеквизитовТекущегоОбъекта.Колонки.Добавить("ЗначениеРеквизита", 	ТипСтрока1000);
	
	ТаблицаРеквизитовИсточника = Новый ТаблицаЗначений;
	ТаблицаРеквизитовИсточника.Колонки.Добавить("НомерСтрокиПравила",	ТипЧисло5);
	ТаблицаРеквизитовИсточника.Колонки.Добавить("РеквизитФормы", 		ТипСтрока150);
	ТаблицаРеквизитовИсточника.Колонки.Добавить("НомерСтрокиТЧ", 		ТипЧисло5);
	ТаблицаРеквизитовИсточника.Колонки.Добавить("ЗначениеРеквизита",	ТипСтрока1000);
	
	Для Каждого ТекРеквизит Из Правила Цикл
		
		// Подготовим таб. часть текущего объекта
		Если СтрНайти(ТекРеквизит.РеквизитДокумента, ".") = 0 Тогда //указан реквизит шапка
			НоваяСтрокаТекущегоОбъекта = ТаблицаРеквизитовТекущегоОбъекта.Добавить();
			НоваяСтрокаТекущегоОбъекта.НомерСтрокиПравила = ТекРеквизит.НомерСтроки;
			НоваяСтрокаТекущегоОбъекта.РеквизитФормы = ТекРеквизит.РеквизитФормы;
			ДобавитьЗначениВСтрокуТаблицы(НоваяСтрокаТекущегоОбъекта, ЗначенияРеквизитовТекущегоОбъекта[ТекРеквизит.РеквизитДокумента]);	
		Иначе // указан реквизит табличной части
			ЧастиИмениРеквизита = СтрРазделить(ТекРеквизит.РеквизитДокумента, ".", Ложь);
			ИмяТабличнойЧасти = ЧастиИмениРеквизита[0];
			ИмяРеквизитаТабличнойЧасти = ЧастиИмениРеквизита[1];
			ТабличнаяЧастьТекущегоДокумента = ТабличныеЧастиТекущегоОбъекта.Получить(ИмяТабличнойЧасти);
			Для Каждого ТекСтрока Из ТабличнаяЧастьТекущегоДокумента Цикл
				НоваяСтрокаТекущегоОбъекта = ТаблицаРеквизитовТекущегоОбъекта.Добавить();
				НоваяСтрокаТекущегоОбъекта.НомерСтрокиПравила = ТекРеквизит.НомерСтроки;
				НоваяСтрокаТекущегоОбъекта.РеквизитФормы = ТекРеквизит.РеквизитФормы;
				НоваяСтрокаТекущегоОбъекта.НомерСтрокиТЧ = ТекСтрока.НомерСтроки;
				НоваяСтрокаТекущегоОбъекта.ГУИДСтроки = ТекСтрока.ИдентификаторСтроки;
				ДобавитьЗначениВСтрокуТаблицы(НоваяСтрокаТекущегоОбъекта, ТекСтрока[ИмяРеквизитаТабличнойЧасти]);
			КонецЦикла;	
		КонецЕсли;	
		
		// Подготовим таб часть источника
		Если Выборка.СравниватьВерсииОдногоОбъекта И ПустаяСтрока(ТекРеквизит.РеквизитИсточника) Тогда
			ТекРеквизит.РеквизитИсточника = ТекРеквизит.РеквизитДокумента;
		КонецЕсли;	
		Если СтрНайти(ТекРеквизит.РеквизитИсточника, ".") = 0 Тогда //указан реквизит шапка
			НоваяСтрокаИсточника = ТаблицаРеквизитовИсточника.Добавить();
			НоваяСтрокаИсточника.НомерСтрокиПравила = ТекРеквизит.НомерСтроки;
			НоваяСтрокаИсточника.РеквизитФормы = ТекРеквизит.РеквизитФормы;
			ДобавитьЗначениВСтрокуТаблицы(НоваяСтрокаИсточника, ЗначенияРеквизитовИсточника[ТекРеквизит.РеквизитИсточника]);
		Иначе // указан реквизит табличной части
			ЧастиИмениРеквизита = СтрРазделить(ТекРеквизит.РеквизитИсточника, ".", Ложь);
			ИмяТабличнойЧасти = ЧастиИмениРеквизита[0];
			ИмяРеквизитаТабличнойЧасти = ЧастиИмениРеквизита[1];
			ТабличнаяЧастьИсточника = ТабличныеЧастиИсточника.Получить(ИмяТабличнойЧасти);
			Для Каждого ТекСтрока Из ТабличнаяЧастьИсточника Цикл
				НоваяСтрокаИсточника = ТаблицаРеквизитовИсточника.Добавить();
				НоваяСтрокаИсточника.НомерСтрокиПравила = ТекРеквизит.НомерСтроки;
				НоваяСтрокаИсточника.РеквизитФормы = ТекРеквизит.РеквизитФормы;
				НоваяСтрокаИсточника.НомерСтрокиТЧ = ТекСтрока.НомерСтроки;
				ДобавитьЗначениВСтрокуТаблицы(НоваяСтрокаИсточника, ТекСтрока[ИмяРеквизитаТабличнойЧасти]);
			КонецЦикла;	
		КонецЕсли;
		
	КонецЦикла;	
	
	// сравниваем полученные таблицы
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаРеквизитовТекущегоОбъекта.НомерСтрокиПравила КАК НомерСтрокиПравила,
	|	ТаблицаРеквизитовТекущегоОбъекта.РеквизитФормы КАК РеквизитФормы,
	|	ТаблицаРеквизитовТекущегоОбъекта.НомерСтрокиТЧ КАК НомерСтрокиТЧ,
	|	ТаблицаРеквизитовТекущегоОбъекта.ЗначениеРеквизита КАК ЗначениеРеквизита,
	|	ТаблицаРеквизитовТекущегоОбъекта.ГУИДСтроки КАК ГУИДСтроки
	|ПОМЕСТИТЬ втТекущийОбъект
	|ИЗ
	|	&ТаблицаРеквизитовТекущегоОбъекта КАК ТаблицаРеквизитовТекущегоОбъекта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаРеквизитовИсточника.НомерСтрокиПравила КАК НомерСтрокиПравила,
	|	ТаблицаРеквизитовИсточника.РеквизитФормы КАК РеквизитФормы,
	|	ТаблицаРеквизитовИсточника.НомерСтрокиТЧ КАК НомерСтрокиТЧ,
	|	ТаблицаРеквизитовИсточника.ЗначениеРеквизита КАК ЗначениеРеквизита
	|ПОМЕСТИТЬ втИсточник
	|ИЗ
	|	&ТаблицаРеквизитовИсточника КАК ТаблицаРеквизитовИсточника
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТекущийОбъект.НомерСтрокиПравила КАК НомерСтрокиПравила,
	|	втТекущийОбъект.РеквизитФормы КАК РеквизитФормы,
	|	втТекущийОбъект.ГУИДСтроки КАК ГУИДСтроки
	|ИЗ
	|	втТекущийОбъект КАК втТекущийОбъект
	|		ЛЕВОЕ СОЕДИНЕНИЕ втИсточник КАК втИсточник
	|		ПО втТекущийОбъект.НомерСтрокиПравила = втИсточник.НомерСтрокиПравила
	|			И втТекущийОбъект.НомерСтрокиТЧ = втИсточник.НомерСтрокиТЧ
	|ГДЕ
	|	втТекущийОбъект.ЗначениеРеквизита <> ЕСТЬNULL(втИсточник.ЗначениеРеквизита, """")";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("ТаблицаРеквизитовТекущегоОбъекта", ТаблицаРеквизитовТекущегоОбъекта);
	Запрос.УстановитьПараметр("ТаблицаРеквизитовИсточника", ТаблицаРеквизитовИсточника);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		ВыборкаПолей = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаПолей.Следующий() Цикл			
			
			ПараметрыПоиска = Новый Структура();
			ПараметрыПоиска.Вставить("ГУИДСтроки", 		ВыборкаПолей.ГУИДСтроки);
			ПараметрыПоиска.Вставить("РеквизитФормы", 	ВыборкаПолей.РеквизитФормы);
			
			Если ТаблицаДвижений.НайтиСтроки(ПараметрыПоиска).Количество() = 0 Тогда
				СтрокаТаблицы = ТаблицаДвижений.Добавить();
				СтрокаТаблицы.ГУИДСтроки 		= ВыборкаПолей.ГУИДСтроки;
				СтрокаТаблицы.РеквизитФормы 	= ВыборкаПолей.РеквизитФормы;
				СтрокаТаблицы.ПравилоПодсветки 	= НастройкаПодсветки;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСтруктуруРеквизитовОбъекта(ДокументОбъект) Экспорт
    Структура = Новый Структура(); /// реквизиты     
    Для каждого Реквизит из ДокументОбъект.Метаданные().Реквизиты Цикл
        Структура.Вставить(Реквизит.Имя, ДокументОбъект[Реквизит.Имя]);
    КонецЦикла; /// таблицы     
    Для каждого ТабличнаяЧасть из ДокументОбъект.Метаданные().ТабличныеЧасти Цикл
        Структура.Вставить(ТабличнаяЧасть.Имя, ДокументОбъект[ТабличнаяЧасть.Имя].Выгрузить());
    КонецЦикла;
    
    Возврат Структура;
КонецФункции

Процедура НастроитьПодсвечиваниеПолей(ДокументОбъект, ИмяФормы, Форма, УсловноеОформление) Экспорт
	
	// Процедура вызывается из модуля формы: ПриЧтенииНаСервере, ПослеЗаписиНаСервере
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ПодсветкаФормДокументовСрезПоследних.ГУИДСтроки КАК ГУИДСтроки,
	|	ПодсветкаФормДокументовСрезПоследних.РеквизитФормы КАК РеквизитФормы,
	|	ПодсветкаФормДокументовСрезПоследних.ПравилоПодсветки КАК ПравилоПодсветки,
	|	ПодсветкаФормДокументовСрезПоследних.ПравилоПодсветки.ЦветПодсветки КАК ЦветПодсветки
	|ИЗ
	|	РегистрСведений.ПодсветкаФормДокументов.СрезПоследних(
	|			,
	|			Регистратор = &ТекущийДокумент
	|				И ПравилоПодсветки.ФормаОбъекта = &ИмяТекущейФормы) КАК ПодсветкаФормДокументовСрезПоследних";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("ТекущийДокумент", ДокументОбъект.Ссылка);
	ЧастиИмени = СтрРазделить(ИмяФормы, ".");
	Запрос.УстановитьПараметр("ИмяТекущейФормы", ЧастиИмени[ЧастиИмени.Количество() - 1]);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;	
	
	ДанныеРегистра = РезультатЗапроса.Выгрузить();
	
	ЦветаПодсветки = Новый Массив; // все цвета подсветки для формы
	
	// Подготовим список полей табличной части, для которых нужно выполнить подсвечивание.
	МассивОформляемыхПолейТЧ = Новый Соответствие;
	Для Каждого ТекущаяСтрока Из ДанныеРегистра Цикл
		
		Если ЦветаПодсветки.Найти(ТекущаяСтрока.ЦветПодсветки) = Неопределено Тогда
			ЦветаПодсветки.Добавить(ТекущаяСтрока.ЦветПодсветки);
		КонецЕсли;	
		
		Если СтрНайти(ТекущаяСтрока.РеквизитФормы, ".") = 0 Тогда
			// Для шапки условное оформление не делаем.
			Продолжить;
		КонецЕсли;
		
		ИмяПоля = СтрЗаменить(ТекущаяСтрока.РеквизитФормы, ".", "_");
		Если МассивОформляемыхПолейТЧ.Получить(ИмяПоля) = Неопределено Тогда
			МассивОформляемыхПолейТЧ.Вставить(ИмяПоля, ТекущаяСтрока.ЦветПодсветки);
		КонецЕсли;	
	КонецЦикла;
		
	// Добавим на форме реквизиты, в которых будем хранить значения для условного оформления табличных частей.
	МассивРеквизитовФормы = Форма.ПолучитьРеквизиты();
	
	МассивИменРеквизитовФормы = Новый Массив;
	Для Каждого ТекРеквизит Из МассивРеквизитовФормы Цикл
		МассивИменРеквизитовФормы.Добавить(ТекРеквизит.Имя);
	КонецЦикла;
	
	ДобавляемыеРеквизиты = Новый Массив;
	Для Каждого ТекОформляемоеПоле Из МассивОформляемыхПолейТЧ Цикл 
		
		// Если у формы уже есть реквизит с указанным именем, то не будем его добавлять.
		Если МассивИменРеквизитовФормы.Найти(ТекОформляемоеПоле.Ключ) <> Неопределено Тогда
			Форма[ТекОформляемоеПоле.Ключ].Очистить();
			Продолжить;
		КонецЕсли;
		
		// Создадим реквизит формы.
		ТипыРеквизита = Новый Массив;
		ТипыРеквизита.Добавить(Тип("СписокЗначений"));
		ОписаниеТиповДляРеквизита = Новый ОписаниеТипов(ТипыРеквизита);
		НовыйРеквизит = Новый РеквизитФормы(ТекОформляемоеПоле.Ключ, ОписаниеТиповДляРеквизита); // добавляем поле с именем такого типа "ТабличнаяЧасть_ИмяПоля"
		
		ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);							
	КонецЦикла;
	Если ДобавляемыеРеквизиты.Количество() > 0 Тогда
		Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	КонецЕсли;
	
	ПараметрыЦветовПодсветки = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ЦветаПодсветки, "Цвет_R, Цвет_G, Цвет_B");
	
	// Добавляем условное оформление табличных частей для формы.
	Для Каждого ТекОформляемоеПоле Из МассивОформляемыхПолейТЧ Цикл 
				
		ИмяОформляемогоЭлемента = СтрЗаменить(ТекОформляемоеПоле.Ключ, "_", "");
		ЧастиИмениПоля = СтрРазделить(ТекОформляемоеПоле.Ключ, "_");
		ИмяПоляТЧ = ЧастиИмениПоля[0] + ".ИдентификаторСтроки";
		
		Если Форма.Элементы.Найти(ЧастиИмениПоля[0] + "ИдентификаторСтроки") = Неопределено Тогда
			ИмяПоляТЧ = ЧастиИмениПоля[0] + ".ГУИДСтроки";	
		КонецЕсли;	
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ПолеЭлемента = ЭлементУО.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяОформляемогоЭлемента); 
		
		ОтборЭлемента = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяПоляТЧ);
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		ОтборЭлемента.ПравоеЗначение = Форма[ТекОформляемоеПоле.Ключ];
		
		ЗначенияЦвета = ПараметрыЦветовПодсветки.Получить(ТекОформляемоеПоле.Значение);
		ЦветПодсветки = Новый Цвет(ЗначенияЦвета.Цвет_R, ЗначенияЦвета.Цвет_G, ЗначенияЦвета.Цвет_B);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветПодсветки);
		
	КонецЦикла;
	
	// Выполняем подсвечивание реквизитов шапки и заполняем ранее созданные
	// реквизиты данными из регистра для срабатывания условного оформления.
	Для Каждого ТекущаяСтрока Из ДанныеРегистра Цикл	
		
		Если СтрНайти(ТекущаяСтрока.РеквизитФормы, ".") = 0 Тогда
			ЗначенияЦвета = ПараметрыЦветовПодсветки.Получить(ТекущаяСтрока.ЦветПодсветки);
			ЦветПодсветки = Новый Цвет(ЗначенияЦвета.Цвет_R, ЗначенияЦвета.Цвет_G, ЗначенияЦвета.Цвет_B);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, ТекущаяСтрока.РеквизитФормы, "ЦветФона", ЦветПодсветки);			
		Иначе
			ИмяПоля = СтрЗаменить(ТекущаяСтрока.РеквизитФормы, ".", "_");
			Форма[ИмяПоля].Добавить(ТекущаяСтрока.ГУИДСтроки);
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры	

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьЗначениВСтрокуТаблицы(СтрокаТаблицы, ЗначениеРеквизита)	
	Если Перечисления.ТипВсеСсылки().СодержитТип(ТипЗнч(ЗначениеРеквизита)) Тогда
		// Если это перечисление, то сравнивать будем его строковое представление.
		СтрокаТаблицы.ЗначениеРеквизита = Строка(ЗначениеРеквизита);
	ИначеЕсли ОбщегоНазначения.ЗначениеСсылочногоТипа(ЗначениеРеквизита) Тогда
		СтрокаТаблицы.ЗначениеРеквизита = ЗначениеРеквизита.УникальныйИдентификатор();
	Иначе
		СтрокаТаблицы.ЗначениеРеквизита = ЗначениеРеквизита;
	КонецЕсли;
КонецПроцедуры	

#КонецОбласти