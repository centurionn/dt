				НовСтрКорр.СтавкаНДСДоИзменения = УсловияВознагражденияОтчета.СтавкаНДСВознаграждения;
				
				НовСтрКорр.КоличествоДоКорректировки = 1; //Стр.Количество;
				НовСтрКорр.ЦенаДоКорректировки = ПредыдущееВознаграждение.Сумма; //Стр.Ставка;
				НовСтрКорр.СуммаДоКорректировки = ПредыдущееВознаграждение.Сумма; //Стр.СуммаИтого;
				НовСтрКорр.СуммаНДСДоКорректировки = ПредыдущееВознаграждение.СуммаНДС; //Стр.СтавкаНДС;
				НовСтрКорр.ВсегоДоКорректировки = ПредыдущееВознаграждение.Сумма; //Стр.СуммаИтого;
				
				//НовСтрКорр.Содержание = НовСтрКорр.СодержаниеДоИзменения;
				//Евросиб(ДИТ), Беляев СЮ, US 115224 / TA 115264, 25-07-2025, начало
				НовСтрКорр.ДатаОказанияУслуги = Стр2.ДатаОказанияУслуги;
