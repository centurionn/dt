	МасУчЕдиниц = Новый Массив;
	Для каждого Стр Из ЭтаФорма.Объект.СвязьУчетныхЕдиниц Цикл
		
		Дан = Новый Структура("Контейнер,Вагон,Калькуляция,НомерЖДН,ЖДН,Коносамент,Груз,СтанцияОтправления,СтанцияНазначения,ГУИД,Ссылка,ВесГрузаНетто,Заявка") ;
