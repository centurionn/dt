Процедура корр_СоздатьДокументКорректировки(ЭтаФорма, СоздатьCreditNote = Ложь, СоздатьСчет = Истина) Экспорт
	
	ТекД = ЭтаФорма.Элементы.Доходы.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекД.КорректировкаДокумента) Тогда
		
		ОпОп = Новый ОписаниеОповещения("корр_СоздатьДокументКорректировки_ВопросОткрытияДа", КорректировкиРТУКлиент, ЭтаФорма);
		ПоказатьВопрос(ОпОп, "На выбранную строку уже созданы документы корректировки. Открыть их?", РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	
	ТрансляцияГУИДовСтрокДоходов = Новый Соответствие;
	РежимДокумента = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение");
	ИсходныйДокумент = неопределено;     
	//Евросиб Дубская 01.03.2022 ( Ticket#0256935
	Корректировка = Неопределено;    
	ГУИД_Корректировка = "";  
	МассивКорректируемыхСтрок = Новый Массив;
	//Евросиб Дубская 01.03.2022 )
	//Евросиб СубботинВ #122887 14.11.2025 Начало
	Если Не ЗначениеЗаполнено(ТекД.КурсВалюты) и Не ЗначениеЗаполнено(ТекД.ДатаКурсаВалюты) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Введите дату или курс валюты в доходной строке"); 
		Возврат;
    КонецЕсли;
	КурсВалюты = Неопределено;
	ДатаКурса = Неопределено; 
	//Евросиб СубботинВ #122887 14.11.2025 Конец 
	
	
	//Евросиб Дубская 02.03.2022 ( Ticket#0256935
	//Для каждого Стр из ЭтаФорма.Объект.Доходы Цикл
	//	Если Стр.ГУИД = ТекД.ГУИДИсправляемойСтроки Тогда
	//		ИсходныйДокумент = Стр.УчДокумент;    
	//		ТрансляцияГУИДовСтрокДоходов.Вставить(ТекД.ГУИДИсправляемойСтроки, ТекД.ГУИД);
	//		РежимДокумента = ?(Стр.КорректировкаРазрешена, 
	//			ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение"),
	//			ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки")
	//			);
	//	КонецЕсли;
	//КонецЦикла;
	ГУИДИсправляемойСтроки = ТекД.ГУИДИсправляемойСтроки;   
	НеНашлиИсходныйДокумент = Истина;
	Пока НеНашлиИсходныйДокумент Цикл
		Для каждого Стр из ЭтаФорма.Объект.Доходы Цикл
			Если Стр.ГУИД = ГУИДИсправляемойСтроки Тогда 
				Если ЗначениеЗаполнено(Стр.КорректировкаДокумента) Тогда
					ГУИДИсправляемойСтроки = Стр.ГУИДИсправляемойСтроки; 
					Для каждого Стр2 из ЭтаФорма.Объект.Доходы Цикл
						Если Стр2.ГУИДИсправляемойСтроки = Стр.ГУИД Тогда
							ТрансляцияГУИДовСтрокДоходов.Вставить(Стр2.ГУИДИсправляемойСтроки, Стр2.ГУИД);
							//ДИТ Авдеева В.С. 47522 Начало 18.08.2022
							//НовСтрКорр = Новый Структура("СтрокаДоходовСделкиДоИзменения,Номенклатура,КлючСтроки,Содержание,Количество,Цена,Сумма,СтавкаНДС,СуммаНДС,СодержаниеДоИзменения,КоличествоДоИзменения,ЦенаДоИзменения,СуммаДоИзменения,СуммаНДСДоИзменения,СтавкаНДСДоИзменения,КоличествоДоКорректировки,ЦенаДоКорректировки,СуммаДоКорректировки,СуммаНДСДоКорректировки,СписокТС,СписокТЕ,СписокТД,СтрокаДоходовСделки,ЕстьВДокументеРеализации,ВсегоДоКорректировки,ВсегоДоИзменения,Всего,ПериодВО");
							//НовСтрКорр = Новый Структура("СтрокаДоходовСделкиДоИзменения,Номенклатура,КлючСтроки,Содержание,Количество,Цена,Сумма,СтавкаНДС,СуммаНДС,СодержаниеДоИзменения,КоличествоДоИзменения,ЦенаДоИзменения,СуммаДоИзменения,СуммаНДСДоИзменения,СтавкаНДСДоИзменения,КоличествоДоКорректировки,ЦенаДоКорректировки,СуммаДоКорректировки,СуммаНДСДоКорректировки,СписокТС,СписокТЕ,СписокТД,СтрокаДоходовСделки,ЕстьВДокументеРеализации,ВсегоДоКорректировки,ВсегоДоИзменения,Всего,ПериодВО,Валюта");
							//ДИТ, Беляев СЮ, Ticket#0324963, 15-09-2023, начало
							НовСтрКорр = ПолучитьСтруктуруПараметровСтрокиКорректировки();
							НовСтрКорр.НДСВклВСтоимость = Стр2.НДСВключенВСтоимость;
							//ДИТ, Беляев СЮ, Ticket#0324963, 15-09-2023, конец
							НовСтрКорр.Валюта = Стр2.Валюта;
							//ДИТ Авдеева В.С. 47522 Конец 18.08.2022
							НовСтрКорр.Номенклатура = Стр2.Услуга;
							НовСтрКорр.ПериодВО = Стр2.ПериодВО;
							НовСтрКорр.Содержание = "";
							НовСтрКорр.Количество = Стр2.Количество;
							НовСтрКорр.Цена = Стр2.Ставка;
							НовСтрКорр.Сумма = Стр2.СтавкаИтого;
							НовСтрКорр.СтавкаНДС = Стр2.СтавкаНДС;
							НовСтрКорр.СуммаНДС = Стр2.СуммаНДС;
							НовСтрКорр.Всего = Стр2.СуммаИтого;
							НовСтрКорр.СписокТС = Стр2.СписокВагонов;
							НовСтрКорр.СписокТЕ = Стр2.СписокКТК;
							НовСтрКорр.СписокТД = Стр2.СписокТД;
							НовСтрКорр.СтрокаДоходовСделки = Стр2.ГУИД;
							НовСтрКорр.ЕстьВДокументеРеализации = Истина; 
							НовСтрКорр.СтрокаДоходовСделкиДоИзменения = Стр.ГУИД;   
							Если ЗначениеЗаполнено(Стр.КорректировкаДокумента) Тогда
								Корректировка = Стр.КорректировкаДокумента;    
								ГУИД_Корректировка = Стр.ГУИД;
							КонецЕсли;
							ДокументОснование = ?(ЗначениеЗаполнено(Стр.УчДокумент), Стр.УчДокумент, Стр.КорректировкаДокумента);
							ДанныеПервичногоДокумента = КорректировкиРТУСервер.ПолучитьДанныеПервичногоДокумента(ДокументОснование, Стр.ГУИД);
							ЗаполнитьЗначенияСвойств(НовСтрКорр, ДанныеПервичногоДокумента,, "СписокТС, СписокТЕ, СписокТД");
							НовСтрКорр.КоличествоДоКорректировки = Стр.Количество;
							НовСтрКорр.ЦенаДоКорректировки = Стр.Ставка;
							НовСтрКорр.СуммаДоКорректировки = Стр.СуммаИтого;
							НовСтрКорр.СуммаНДСДоКорректировки = Стр.СтавкаНДС;
							НовСтрКорр.ВсегоДоКорректировки = Стр.СуммаИтого;
