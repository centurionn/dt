	ПоказатьВопрос(ОпОп, "Созданы документы корректировок. Открыть их?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

Функция НайтиПервичныйГУИД(КоррГУИД, Доходы)
	
	Результат = КоррГУИД;
	НайденБолееРаннийГУИД = Истина;
	БолееРаннийГУИД = "";
	Пока НайденБолееРаннийГУИД = Истина Цикл
		НайденБолееРаннийГУИД = Ложь;
		Для каждого Стр из Доходы Цикл
			Если Стр.ГУИД = Результат И ЗначениеЗаполнено(Стр.ГУИДИсправляемойСтроки) Тогда
				Результат = Стр.ГУИДИсправляемойСтроки;
				НайденБолееРаннийГУИД = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Процедура корр_СоздатьДокументКорректировки_ВопросОткрытияДа(П1 = неопределено, ЭтаФорма = неопределено) Экспорт
	
	Если П1 <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;
	
	ТекД = ЭтаФорма.Элементы.Доходы.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекД.КорректировкаДокумента) Тогда
		ПоказатьЗначение(, ТекД.КорректировкаДокумента);
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ТекД.КорректировкаВознаграждения) Тогда
		ПоказатьЗначение(, ТекД.КорректировкаВознаграждения);
	КонецЕсли;
		
КонецПроцедуры

Процедура корр_СоздатьДокументКорректировки_ВопросОткрытияДа2(П1 = неопределено, РТУ = неопределено) Экспорт
	
	Если П1 <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;
	
	ПоказатьЗначение(, РТУ);
		
КонецПроцедуры

Процедура корр_УдалитьДокументКорректировки(ЭтаФорма) Экспорт
	
	ТекД = ЭтаФорма.Элементы.Доходы.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекД.КорректировкаДокумента) ИЛИ ЗначениеЗаполнено(ТекД.КорректировкаВознаграждения) Тогда
		
		ОпОп = Новый ОписаниеОповещения("корр_УдалитьДокументКорректировки_ВопросУдаленияДа", КорректировкиРТУКлиент, ЭтаФорма);
		ПоказатьВопрос(ОпОп, "Вы действительно хотите удалить созданные корректировки РТУ?", РежимДиалогаВопрос.ДаНет);
		Возврат;
		
	Иначе
		
		ПоказатьПредупреждение(, "Нет корректировок РТУ для удаления.");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура корр_УдалитьДокументКорректировки_ВопросУдаленияДа(П1 = неопределено, ЭтаФорма = неопределено) Экспорт
	
	Если П1 <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;
	
	ТекД = ЭтаФорма.Элементы.Доходы.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекД.КорректировкаДокумента) Тогда
		КорректировкиРТУСервер.УдалитьКорректировкуРТУ(ТекД.КорректировкаДокумента);
		ТекД.КорректировкаДокумента = неопределено;		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекД.КорректировкаВознаграждения) Тогда
		КорректировкиРТУСервер.УдалитьКорректировкуРТУ(ТекД.КорректировкаВознаграждения);
		ТекД.КорректировкаВознаграждения = неопределено;		
	КонецЕсли;
	
КонецПроцедуры

Процедура корр_СоздатьАннулированиеРеализации(ЭтаФорма) Экспорт
	
	ТекД = ЭтаФорма.Элементы.Доходы.ТекущиеДанные;
	
	Если ТекД = неопределено Тогда Возврат; КонецЕсли;
	
	Если ТекД.АннулированиеРазрешено = ЛОЖЬ И НЕ КорректировкиРТУСервер.РольБухгалтераДоступна() И НЕ КорректировкиРТУСервер.РольПолныеПраваДоступна() Тогда
		ПоказатьПредупреждение(, "Для данной строки не разрешено аннулирование.");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТекД.УчДокумент) И НЕ ЗначениеЗаполнено(ТекД.КорректировкаДокумента) И НЕ ЗначениеЗаполнено(ТекД.КорректировкаВознаграждения) Тогда
		ПоказатьПредупреждение(, "Нет документов для аннулирования.");
		Возврат;
	КонецЕсли;
	
	УжеНайденаСтрока = Ложь;
	НомерСтрокиКорректировки = 0;
	Для каждого Стр из ЭтаФорма.Объект.Доходы Цикл
		Если Стр.ГУИДИсправляемойСтроки = ТекД.ГУИД Тогда
			УжеНайденаСтрока = Истина;
			НомерСтрокиКорректировки = Стр.НомерСтроки;
		КонецЕсли;
	КонецЦикла;
	Если УжеНайденаСтрока Тогда
		ПоказатьПредупреждение(, "На данную строку уже введена корректировка в строке № " + НомерСтрокиКорректировки);
		Возврат;
	КонецЕсли;
	
	//Евросиб Каблов 09.04.2025 ( #105407
	//ПериодБлокировки8 = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериод(ЭтаФорма.Объект.Организация);
	ПериодБлокировки8 = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериодДоходов(ЭтаФорма.Объект.Организация);
	//Евросиб Каблов 09.04.2025 )
	
	НовД = ЭтаФорма.Объект.Доходы.Вставить(ТекД.НомерСтроки);
	ЗаполнитьЗначенияСвойств(НовД, ТекД,, "УчДокумент,ГУИД,ГУИДСтрокиДохода,ГУИДИсправляемойСтроки,КорректировкаДокумента,КорректировкаВознаграждения,Себестоимость,Вознаграждение,Ставка,Количество,СебестоимостьИтого,ВознаграждениеИтого,СтавкаИтого,Рентабельность,СуммаНДС,СуммаИтого,ЗадачаГотовностиКВыставлению");
	НовД.ГУИДИсправляемойСтроки = ТекД.ГУИД;
	НовД.ГУИД = Строка(Новый УникальныйИдентификатор);
	НовД.КорректировкаРазрешена = Ложь;
	НовД.ИсправлениеРазрешено = Ложь;
	НовД.КорректировкаВыполнена = Ложь;
	НовД.ИсправлениеВыполнено = Ложь;
	НовД.ПериодВО = ПериодБлокировки8;
	Если ТекД.АннулированиеРазрешено Тогда ТекД.АннулированиеВыполнено = Истина; КонецЕсли;
	
	///////////////
	
	МассивКорректируемыхСтрок = Новый массив;
	
	//НовСтрКорр = Новый Структура("СтрокаДоходовСделкиДоИзменения,Номенклатура,Содержание,Количество,Цена,Сумма,СтавкаНДС,СуммаНДС,СодержаниеДоИзменения,КоличествоДоИзменения,ЦенаДоИзменения,СуммаДоИзменения,СуммаНДСДоИзменения,СтавкаНДСДоИзменения,КоличествоДоКорректировки,ЦенаДоКорректировки,СуммаДоКорректировки,СуммаНДСДоКорректировки,СписокТС,СписокТЕ,СписокТД,СтрокаДоходовСделки,ЕстьВДокументеРеализации,ВсегоДоКорректировки,ВсегоДоИзменения,Всего,ПериодВО");
	//Евросиб(ДИТ), Беляев СЮ, US 115224 / TA 115264, 25-07-2025, начало
	НовСтрКорр = ПолучитьСтруктуруПараметровСтрокиКорректировки();
	НовСтрКорр.ДатаОказанияУслуги = НовД.ДатаОказанияУслуги;
	//Евросиб(ДИТ), Беляев СЮ, US 115224 / TA 115264, 25-07-2025, конец
	НовСтрКорр.Номенклатура = НовД.Услуга;
	
	НовСтрКорр.ПериодВО = НовД.ПериодВО;
	
	НовСтрКорр.Содержание = "";
	НовСтрКорр.Количество = НовД.Количество;
	НовСтрКорр.Цена = НовД.Ставка;
	НовСтрКорр.Сумма = НовД.СуммаИтого;
	НовСтрКорр.СтавкаНДС = НовД.СтавкаНДС;
	НовСтрКорр.СуммаНДС = НовД.СуммаНДС;
	НовСтрКорр.Всего = НовД.СуммаИтого;
	
	НовСтрКорр.СписокТС = НовД.СписокВагонов;
	НовСтрКорр.СписокТЕ = НовД.СписокКТК;
	НовСтрКорр.СписокТД = НовД.СписокТД;
	НовСтрКорр.СтрокаДоходовСделки = НовД.ГУИД;
	НовСтрКорр.ЕстьВДокументеРеализации = Истина;
	НовСтрКорр.СтрокаДоходовСделкиДоИзменения = НайтиПервичныйГУИД(ТекД.ГУИД, ЭтаФорма.Объект.Доходы);
	
	ДокументОснование = ?(ЗначениеЗаполнено(ТекД.УчДокумент), ТекД.УчДокумент, ТекД.КорректировкаДокумента);
	ДанныеПервичногоДокумента = КорректировкиРТУСервер.ПолучитьДанныеПервичногоДокумента(ДокументОснование, ТекД.ГУИД);
	
	ЗаполнитьЗначенияСвойств(НовСтрКорр, ДанныеПервичногоДокумента);
	
	НовСтрКорр.КоличествоДоКорректировки = ТекД.Количество;
	НовСтрКорр.ЦенаДоКорректировки = ТекД.Ставка;
	НовСтрКорр.СуммаДоКорректировки = ТекД.СуммаИтого;
	НовСтрКорр.СуммаНДСДоКорректировки = ТекД.СтавкаНДС;
	НовСтрКорр.ВсегоДоКорректировки = ТекД.СуммаИтого;
	
	НовСтрКорр.Содержание = НовСтрКорр.СодержаниеДоИзменения;
	
