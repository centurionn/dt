	НоваяРТУ = КорректировкиРТУСервер.СоздатьКоррРТУПоПараметрам(ИсходныйДокумент, МассивКорректируемыхСтрок, МасУчЕдиниц, РежимДокумента, Истина, ТрансляцияГУИДовСтрокДоходов);
	
