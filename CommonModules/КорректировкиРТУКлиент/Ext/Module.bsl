				ДокументОснование = ?(ЗначениеЗаполнено(Стр.УчДокумент), Стр.УчДокумент, Стр.КорректировкаВознаграждения);
				ДанныеПервичногоДокумента = КорректировкиРТУСервер.ПолучитьДанныеПервичногоДокумента(ДокументОснование, Стр.ГУИД);
				
				//ЗаполнитьЗначенияСвойств(НовСтрКорр, ДанныеПервичногоДокумента);
				
				НовСтрКорр.КоличествоДоИзменения = 1; //Стр.Количество;
