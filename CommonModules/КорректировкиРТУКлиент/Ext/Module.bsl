Процедура корр_ВвестиКорректировку(ЭтаФорма) Экспорт
	
	ТекД = ЭтаФорма.Элементы.Доходы.ТекущиеДанные;
	
	Если ТекД = неопределено Тогда Возврат; КонецЕсли;
	
	Если ТекД.КорректировкаРазрешена = ЛОЖЬ И ТекД.ИсправлениеРазрешено = ЛОЖЬ Тогда
		ПоказатьПредупреждение(, "Для данной строки не разрешена корректировка или исправление.");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТекД.УчДокумент) И НЕ ЗначениеЗаполнено(ТекД.КорректировкаДокумента) Тогда
		ПоказатьПредупреждение(, "Вводить корректировку можно только на строку с реализацией.");
		Возврат;
	КонецЕсли;
	
	//Евросиб Каблов 09.04.2025 ( #105407
	//ПериодБлокировки8 = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериод(ЭтаФорма.Объект.Организация);
	ПериодБлокировки8 = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериодДоходов(ЭтаФорма.Объект.Организация);
	//Евросиб Каблов 09.04.2025 )
	
	Если ТекД.ПериодВО >= ПериодБлокировки8 Тогда
		ПоказатьПредупреждение(, "Запрещен ввод корректировки на документы открытого периода!");
		Возврат;
	КонецЕсли;
	
	УжеНайденаСтрока = Ложь;
	НомерСтрокиКорректировки = 0;
	ВидОперацииАннулирование = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование");
	Для каждого Стр из ЭтаФорма.Объект.Доходы Цикл
		Если Стр.ГУИДИсправляемойСтроки = ТекД.ГУИД 
			//)
			//Евросиб - АСуслов 24.03.2022 14:40:56 #47182
			И НЕ ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(Стр.КорректировкаДокумента, "ВидОперации") = ВидОперацииАннулирование Тогда
			//)
			//Евросиб - АСуслов 24.03.2022 14:40:56 #47182
			УжеНайденаСтрока = Истина;
			НомерСтрокиКорректировки = Стр.НомерСтроки;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если УжеНайденаСтрока Тогда
		ПоказатьПредупреждение(, "На данную строку уже введена корректировка в строке № " + НомерСтрокиКорректировки);
		Возврат;
	КонецЕсли;
	
	НовД = ЭтаФорма.Объект.Доходы.Вставить(ТекД.НомерСтроки);
	ЗаполнитьЗначенияСвойств(НовД, ТекД,, "УчДокумент, ГУИД, ГУИДСтрокиДохода, ГУИДИсправляемойСтроки, КорректировкаДокумента, КорректировкаВознаграждения");
	НовД.ГУИДИсправляемойСтроки = ТекД.ГУИД;
	НовД.ГУИД = Строка(Новый УникальныйИдентификатор);
	НовД.КорректировкаРазрешена = Ложь;
	НовД.ИсправлениеРазрешено = Ложь;
	НовД.КорректировкаВыполнена = Ложь;
	НовД.ИсправлениеВыполнено = Ложь;
	НовД.АннулированиеРазрешено = Ложь;
	НовД.АннулированиеВыполнено = Ложь;
	НовД.ПериодВО = ПериодБлокировки8;
	
	//Евросиб СубботинВ #122887 14.11.2025 Начало 
	//Евросиб СубботинВ #130097 13.02.2026 Начало
	КурсФрахт = Неопределено;
	Если 
		//ТекД.Услуга = ПредопределенноеЗначение("Справочник.Номенклатура.Фрахт")
		ЗначениеЗаполнено(ТекД.УчДокумент)
		и ТипЗнч(ТекД.УчДокумент) = Тип("ДокументСсылка.РеализацияТоваровУслуг")и не ТекД.Валюта = ПредопределенноеЗначение("Справочник.Валюты.Рубль") Тогда
		КурсФрахт = КорректировкиРТУСервер.ПолучитьДанныеКурсаВалютыФрахтСтрокиРТУПоГуиду(ТекД.УчДокумент, ТекД.ГУИД);		
	КонецЕсли; 
	Если НЕ КурсФрахт = Неопределено Тогда
		НовД.ДатаКурсаВалюты = Неопределено;
		НовД.КурсВалюты = КурсФрахт;
   // Если ТекД.Валюта = ПредопределенноеЗначение("Справочник.Валюты.Рубль") Тогда
	ИначеЕсли ТекД.Валюта = ПредопределенноеЗначение("Справочник.Валюты.Рубль") Тогда 
	//Евросиб СубботинВ #130097 13.02.2026 Конец
		НовД.ДатаКурсаВалюты = Неопределено;
		НовД.КурсВалюты = 1;
		//Евросиб СубботинВ #130097 13.02.2026 Начало
	ИначеЕсли НЕ ТекД.Валюта = ПредопределенноеЗначение("Справочник.Валюты.Рубль")
		и НЕ ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(ТекД.Договор, "ВалютаВзаиморасчетов") = ТекД.Валюта Тогда
		НовД.ДатаКурсаВалюты = ?(ЗначениеЗаполнено(ТекД.УчДокумент), ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(ТекД.УчДокумент, "ДатаКурса"), ТекД.ДатаКурсаВалюты);
		НовД.КурсВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ТекД.Валюта, НовД.ДатаКурсаВалюты).Курс;
		//Евросиб СубботинВ #130097 13.02.2026 Конец
	Иначе
		Если ЗначениеЗаполнено(ТекД.УчДокумент) Тогда 
			РеквизитыУчДокумента = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(ТекД.УчДокумент,"КурсВзаиморасчетов, ДатаКурса");
			НовД.ДатаКурсаВалюты = РеквизитыУчДокумента.ДатаКурса;
			НовД.КурсВалюты = РеквизитыУчДокумента.КурсВзаиморасчетов;
		Иначе 
			НовД.ДатаКурсаВалюты = ТекД.ДатаКурсаВалюты;
			НовД.КурсВалюты = ТекД.КурсВалюты;
		КонецЕсли;
	КонецЕсли;
	//Евросиб СубботинВ #122887 14.11.2025 Конец
	
	Если ТекД.КорректировкаРазрешена Тогда ТекД.КорректировкаВыполнена = Истина; КонецЕсли;
	Если ТекД.ИсправлениеРазрешено Тогда ТекД.ИсправлениеВыполнено = Истина; КонецЕсли;
	
	Если ТипЗнч(ТекД.УчДокумент) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") И ТекД.Перевыставляемая И ЗначениеЗаполнено(ТекД.УчДокумент) Тогда
		
		ПТУ = неопределено;
		ГУИДРасходов = неопределено;
		Для каждого Стр из ЭтаФорма.Объект.СвязьДоходовИРасходов Цикл
			Если ТекД.ГУИД = Стр.Доходы Тогда
				
				Для каждого СтрР из ЭтаФорма.Объект.Расходы Цикл
					
					Если Стр.Расходы = СтрР.ГУИД Тогда
						ПТУ = СтрР.УчДокумент;
						ГУИДРасходов = СтрР.ГУИД;
					КонецЕсли;
						
				КонецЦикла;
				
			КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ПТУ) Тогда
			
			НовыеДанныеПоступления = КорректировкиРТУСервер.ПолучитьНовыеДанныеПоступления(ПТУ, ГУИДРасходов);
			//ЗаполнитьЗначенияСвойств(НовД, НовыеДанныеПоступления);
			//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 114152, 04-08-2025, начало
			Если НовыеДанныеПоступления.ЕстьДанныеКоррПТУ Тогда
				ЗаполнитьЗначенияСвойств(НовД, НовыеДанныеПоступления);
			КонецЕсли;
			//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 114152, 04-08-2025, конец
			
		Иначе
			ПоказатьПредупреждение(, "Не удалось получить данные корректировки ПТУ. Укажите новые значения Поступления вручную или обратитесь в техподдержку.");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура корр_ОтменитьКорректировку(ЭтаФорма) Экспорт
	
	ТекД = ЭтаФорма.Элементы.Доходы.ТекущиеДанные;
	
	Если НЕ ЗначениеЗаполнено(ТекД.ГУИДИсправляемойСтроки) Тогда
		ПоказатьПредупреждение(, "Для отмены корректировки выберите корректировочную строку.");
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекД.КорректировкаДокумента) ИЛИ ЗначениеЗаполнено(ТекД.КорректировкаВознаграждения) Тогда
		ПоказатьПредупреждение(, "Перед удалением корректировочной строки необходимо удалить созданные документы корректировки.");
		Возврат;
	КонецЕсли;
	
	ОпОп = Новый ОписаниеОповещения("корр_ОтменитьКорректировку_ОтветДа", КорректировкиРТУКлиент, ЭтаФорма);
	ПоказатьВопрос(ОпОп, "Вы действительно хотите удалить корректировочную строку?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

Процедура корр_ОтменитьКорректировку_ОтветДа(П1 = неопределено, ЭтаФорма = неопределено) Экспорт
	
	Если П1 <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;
	
	ТекД = ЭтаФорма.Элементы.Доходы.ТекущиеДанные;
	
	ГУИДРодителяУдаляемойСтроки = ТекД.ГУИДИсправляемойСтроки;
	
	ЭтаФорма.Объект.Доходы.Удалить(ТекД);
	
	Для каждого Стр из ЭтаФорма.Объект.Доходы Цикл
		Если Стр.ГУИД = ГУИДРодителяУдаляемойСтроки Тогда
			Стр.КорректировкаВыполнена = Ложь;
			Стр.ИсправлениеВыполнено = Ложь;
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

//ДИТ Давудов М.А. Task32744 03.07.2021 Начало
