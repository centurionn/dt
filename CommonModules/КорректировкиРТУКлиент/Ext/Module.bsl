Процедура корр_СоздатьКорректировкуВознаграждения(ЭтаФорма) Экспорт
	
	ТекД = ЭтаФорма.Элементы.Доходы.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекД.КорректировкаВознаграждения) Тогда
		
		ОпОп = Новый ОписаниеОповещения("корр_СоздатьДокументКорректировки_ВопросОткрытияДа", КорректировкиРТУКлиент, ЭтаФорма);
		ПоказатьВопрос(ОпОп, "На выбранную строку уже созданы документы корректировки. Открыть их?", РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	
	ТрансляцияГУИДовСтрокДоходов = Новый Соответствие;
	РежимДокумента = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение");
	ИсходныйДокумент = неопределено;
	Для каждого Стр из ЭтаФорма.Объект.Доходы Цикл
		Если Стр.ГУИД = ТекД.ГУИДИсправляемойСтроки Тогда
			ИсходныйДокумент = Стр.УчДокумент;
			ТрансляцияГУИДовСтрокДоходов.Вставить(ТекД.ГУИДИсправляемойСтроки, ТекД.ГУИД);
			РежимДокумента = ?(Стр.КорректировкаРазрешена, 
				ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение"),
				ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки")
				);
		КонецЕсли;
	КонецЦикла;
	
	ПредыдущееВознаграждение = Новый Структура("Сумма, СтавкаНДС, СуммаНДС", 0, неопределено, 0);
	Если ТипЗнч(ИсходныйДокумент) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
		ПредыдущееВознаграждение = КорректировкиРТУСервер.ПолучитьПредыдущееВознаграждение(ИсходныйДокумент);
	КонецЕсли;
	
	УсловияВознагражденияОтчета = КорректировкиРТУСервер.ПолучитьУсловияВознагражденияОтчета(ИсходныйДокумент);
	
	Если НЕ ЗначениеЗаполнено(УсловияВознагражденияОтчета.СпособРасчетаКомиссионногоВознаграждения) Тогда
		ПоказатьПредупреждение(, "Не удалось получить настройки Отчета агента. Обратитесь в техподдержку.");
		Возврат;
	КонецЕсли;
	
	МассивКорректируемыхСтрок = Новый массив;
	
	Для каждого Стр из ЭтаФорма.Объект.Доходы.НайтиСтроки(Новый Структура("УчДокумент", ИсходныйДокумент)) Цикл
		Для каждого Стр2 из ЭтаФорма.Объект.Доходы Цикл
			Если Стр2.ГУИДИсправляемойСтроки = Стр.ГУИД Тогда
				//++ДИТ_Коробов_Task 48097_02.03.22
				ТрансляцияГУИДовСтрокДоходов.Вставить(Стр2.ГУИДИсправляемойСтроки, Стр2.ГУИД);
				//--ДИТ_Коробов_Task 48097_02.03.22
				//НовСтрКорр = Новый Структура("СтрокаДоходовСделкиДоИзменения,Номенклатура,Содержание,Количество,Цена,Сумма,СтавкаНДС,СуммаНДС,СодержаниеДоИзменения,КоличествоДоИзменения,ЦенаДоИзменения,СуммаДоИзменения,СуммаНДСДоИзменения,СтавкаНДСДоИзменения,КоличествоДоКорректировки,ЦенаДоКорректировки,СуммаДоКорректировки,СуммаНДСДоКорректировки,СписокТС,СписокТЕ,СписокТД,СтрокаДоходовСделки,ЕстьВДокументеРеализации,ВсегоДоКорректировки,ВсегоДоИзменения,Всего,ПериодВО");
				//Евросиб(ДИТ), Беляев СЮ, US 115224 / TA 115264, 25-07-2025, начало
