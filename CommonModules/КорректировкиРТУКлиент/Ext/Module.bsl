				НовСтрКорр.СуммаДоИзменения = ПредыдущееВознаграждение.Сумма; //Стр.СуммаИтого;
				НовСтрКорр.СуммаНДСДоИзменения = ПредыдущееВознаграждение.СуммаНДС; //Стр.СтавкаНДС;
				// Евросиб US 130623 TA 130624 Рыбьяков К.А. 10.02.2026 ((
				НовСтрКорр.ВсегоДоИзменения = ?(УсловияВознагражденияОтчета.СуммаВознагражденияВключаетНДС, 
								ПредыдущееВознаграждение.Сумма, ПредыдущееВознаграждение.Сумма + ПредыдущееВознаграждение.СуммаНДС);
