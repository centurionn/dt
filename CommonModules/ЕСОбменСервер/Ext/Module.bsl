		ИЛИ МенеджерЗаписи.ВЭксплуатации <> ВЭксплуатации ИЛИ МенеджерЗаписи.СданВАренду <> СданВАренду) Тогда
		МенеджерЗаписи.ПризнакСобственности = ПризнакСобственности;
		МенеджерЗаписи.СданВАренду = СданВАренду;
		МенеджерЗаписи.ВЭксплуатации = ВЭксплуатации;
		МенеджерЗаписи.Записать();
	Иначе
		МенеджерЗаписи.Период = ДатаНачалаСобственности;
		МенеджерЗаписи.Вагон = Вагон;
		МенеджерЗаписи.СданВАренду = СданВАренду;
		МенеджерЗаписи.ПризнакСобственности = ПризнакСобственности;
		МенеджерЗаписи.ВЭксплуатации = ВЭксплуатации;
		МенеджерЗаписи.Записать();
	КонецЕсли; 
