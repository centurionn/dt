		Если Не ЗначениеЗаполнено(Дислокация.Период) Тогда
			МассивОшибок.Добавить("Не указан период для дислокации контейнера " + Дислокация.containerNumber);
			Продолжить;
		КонецЕсли;
		
		Запись = РегистрыСведений.ДислокацияКонтейнеровМоре.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, Дислокация);
