Процедура ЗагрузитьИСФизРИТМаЗаПериод(Организация, ПериодЗагрузки)

	//Инициализация обработки загрузки
	ОбработкаЗагрузки = Обработки.ЗагрузкаИСФизРИТМа.Создать();
	ОбработкаЗагрузки.Организация = Организация;
	ОбработкаЗагрузки.ПериодВО = ПериодЗагрузки.ДатаНачала;
	ОбработкаЗагрузки.ПериодЗагрузки = ПериодЗагрузки;
	
	Попытка
		//Загрузка данных
		ОбработкаЗагрузки.ПолучитьСписокИСФ(ОбработкаЗагрузки.ПериодЗагрузки.ДатаНачала, ОбработкаЗагрузки.ПериодЗагрузки.ДатаОкончания, ОбработкаЗагрузки.Организация);
		//Евросиб СубботинВ #106299 19.06.2025 Начало
		// добавил признак рег задания
		//ОбработкаЗагрузки.ПолучитьДанныеПоИСФ();
		ОбработкаЗагрузки.ПолучитьДанныеПоИСФ(Истина);
		//Евросиб СубботинВ #106299 19.06.2025 Конец

	Исключение
		// Евросиб Фролов (26.04.2022
		Тема = "Рег. задание: Загрузка ИСФ из РИТМа";
		ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()); 
		ТекстСообщения = "Ошибки и уведомления при выполнении рег. задания:
					|" + ПредставлениеОшибки;
		РаботаСоСделкамиСервер.ВыполнитьОтправкуУведомлений(Тема, ТекстСообщения, Метаданные.РегламентныеЗадания.ЗагрузкаИСФизРИТМа);
		// Евросиб Фролов)
	КонецПопытки;
	СписокЗагруженныхИСФ = Новый Массив;
	СтрокиСОшибками = Новый Массив;
	//Евросиб СубботинВ #101004 28.01.2025 Начало
	ЛогинПользователя = Пользователи.ТекущийПользователь().ЛогинAD;
	ЛогинПользователя = СтрЗаменить(ЛогинПользователя, "\", Символы.ПС);
	ЛогинПользователя = СтрПолучитьСтроку(ЛогинПользователя, СтрЧислоСтрок(ЛогинПользователя));
	//Евросиб СубботинВ #101004 28.01.2025 Конец	

	Для Каждого Строка Из ОбработкаЗагрузки.СписокДокументов Цикл
		Если Строка.СтатусЗагрузки = ПредопределенноеЗначение("Перечисление.СтатусыЗагрузки.ОтработаноБезОшибок") 
			Или Строка.СтатусЗагрузки = ПредопределенноеЗначение("Перечисление.СтатусыЗагрузки.НеЗагружать")
			Тогда
			//Евросиб СубботинВ #101004 28.01.2025 Начало 
			//СписокЗагруженныхИСФ.Добавить(Новый Структура("invRfCode, TypeRec, invoiceVersion, dtUnloadDC", Строка.КодИСФ, Строка.ТипИСФ, Строка.ВерсияИСФ, ТекущаяДата()));
			// добавил атрибут с логином текущего пользователя для подтверждения в ритме
            СписокЗагруженныхИСФ.Добавить(Новый Структура("invRfCode, TypeRec, invoiceVersion, dtUnloadDC, login", Строка.КодИСФ, Строка.ТипИСФ, Строка.ВерсияИСФ, ТекущаяДата(), ЛогинПользователя));
			//Евросиб СубботинВ #101004 28.01.2025 Конец 

		КонецЕсли;
		Если Строка.СтатусЗагрузки = ПредопределенноеЗначение("Перечисление.СтатусыЗагрузки.ОшибкаПриАнализе")
			Или Строка.СтатусЗагрузки = ПредопределенноеЗначение("Перечисление.СтатусыЗагрузки.ОшибкаПриЗагрузке") Тогда
			СтрокиСОшибками.Добавить(Строка);
		КонецЕсли;			
	КонецЦикла;
	
	//Отправка подтверждения
	Если СписокЗагруженныхИСФ.Количество() > 0 Тогда
		Обработки.ЗагрузкаИСФизРИТМа.ОтправитьПодтверждениеЗагрузки(СписокЗагруженныхИСФ);
	КонецЕсли;
	
	//Оповещение об ошибках
	Если СтрокиСОшибками.Количество() > 0 Тогда
		
		//Формирование заголовка письма
		Заголовок = СтрШаблон("Загрузка ИСФ из РИТМа в DC за период с %1 по %2", ОбработкаЗагрузки.ПериодЗагрузки.ДатаНачала, ОбработкаЗагрузки.ПериодЗагрузки.ДатаОкончания);
		
		//Формирование таблицы ошибок
		ТаблицаОшибок = ОбработкаЗагрузки.СписокДокументов.Выгрузить(СтрокиСОшибками);
		СтрокиТаблицы = Новый Массив;
		ШаблонСтрокиТаблицы = "<TR><TD>%1</TD><TD>%2</TD><TD>%3</TD><TD>%4</TD><TD>%5</TD><TD>%6</TD><TD>%7</TD><TD>%8</TD><TD>%9</TD></TR>";
		//Формирование заголовка таблицы
		ТекстСтроки = СтрШаблон(ШаблонСтрокиТаблицы, "Код ИСФ", "Тип ИСФ", "Версия ИСФ", "Вид ИСФ", "Номер ИСФ", "Дата ИСФ", "СсылкаИСФ", "Статус загрузки", "Комментарий");
		СтрокиТаблицы.Добавить(ТекстСтроки);
		//Формирование строк таблицы
		Для Каждого СтрокаТаблицы Из ТаблицаОшибок Цикл
			ТекстСтроки = СтрШаблон(ШаблонСтрокиТаблицы, СтрокаТаблицы.КодИСФ, СтрокаТаблицы.ТипИСФ, СтрокаТаблицы.ВерсияИСФ, СтрокаТаблицы.ВидИСФ, СтрокаТаблицы.НомерИСФ, СтрокаТаблицы.ДатаИСФ, СтрокаТаблицы.СсылкаИСФ, СтрокаТаблицы.СтатусЗагрузки, СтрокаТаблицы.Комментарий);
			СтрокиТаблицы.Добавить(ТекстСтроки);
		КонецЦикла;
		ТекстСтрокТаблицы = СтрСоединить(СтрокиТаблицы, Символы.ПС);
		ТекстТаблицы = СтрШаблон("<TABLE><TBODY>%1</TBODY></TABLE>", ТекстСтрокТаблицы);
		
		ТекстСообщения = СтрШаблон("<HTML><BODY>%1%2</BODY></HTML>", Заголовок, ТекстТаблицы);
		
		Получатели = НайтиПолучателейВПравилахОповещения(Перечисления.УзлыОбмена.РИТМ);
		ОтправитьСообщениеВФорматеHTML(Получатели, "Ошибки при загрузке ИСФ из РИТМа", ТекстСообщения);
		
	КонецЕсли;

КонецПроцедуры
 
Процедура ЗагрузитьИСФИзРИТМа() Экспорт
	
	Организация = Константы.ОсновнаяОрганизация.Получить();
	ПериодЗагрузки = Новый СтандартныйПериод;
	//Евросиб СубботинВ #106299 19.06.2025 Начало
	////Евросиб Каблов 09.04.2025 ( #105407
	////ПериодЗагрузки.ДатаНачала = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериод(Организация);
	//ПериодЗагрузки.ДатаНачала = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериодДоходов(Организация);
	////Евросиб Каблов 09.04.2025 )
	
	КоличествоМесяцевПрошлогоПериодаДляЗагрузкиИзРитма = Константы.КоличествоМесяцевПрошлогоПериодаДляЗагрузкиИзРитма.Получить();
	ОткрытыйПериод = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериодДоходов(Организация);

	Если КоличествоМесяцевПрошлогоПериодаДляЗагрузкиИзРитма > 0 Тогда 
		ПериодЗагрузки.ДатаНачала = ДобавитьМесяц(НачалоМесяца(ОткрытыйПериод), КоличествоМесяцевПрошлогоПериодаДляЗагрузкиИзРитма*-1);
	Иначе
		ПериодЗагрузки.ДатаНачала = ОткрытыйПериод;
	КонецЕсли;
	//ПериодЗагрузки.ДатаОкончания = КонецМесяца(ПериодЗагрузки.ДатаНачала);	
	ПериодЗагрузки.ДатаОкончания = КонецМесяца(ОткрытыйПериод);
	//Евросиб СубботинВ #106299 19.06.2025 Конец

	ЗагрузитьИСФизРИТМаЗаПериод(Организация, ПериодЗагрузки);

	
	Если ПериодЗагрузки.ДатаНачала < НачалоМесяца(ТекущаяДата()) Тогда
		ПериодЗагрузки.ДатаНачала = НачалоМесяца(ТекущаяДата());
		ПериодЗагрузки.ДатаОкончания = КонецМесяца(ПериодЗагрузки.ДатаНачала);
		ЗагрузитьИСФизРИТМаЗаПериод(Организация, ПериодЗагрузки);
	КонецЕсли; 
	
КонецПроцедуры

Процедура ВыгрузитьВРИТМСостояниеКопияВСФ(Поступление, Копия) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПротоколОбменов.УИДИсточника КАК УИДИсточника
	|ИЗ
	|	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	|ГДЕ
	|	ПротоколОбменов.ДействиеПриОбмене = &ДействиеПриОбмене_Загрузка
	|	И ПротоколОбменов.УзелОбмена = &УзелОбмена_РИТМ
	|	И ПротоколОбменов.Объект = &Объект_Ссылка";
	Запрос.УстановитьПараметр("ДействиеПриОбмене_Загрузка", Перечисления.ДействияПриОбмене.ЗагрузкаДанных);
	Запрос.УстановитьПараметр("УзелОбмена_РИТМ", Перечисления.УзлыОбмена.РИТМ);
	Запрос.УстановитьПараметр("Объект_Ссылка", Поступление);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Запись = Новый ЗаписьXML;
		Запись.УстановитьСтроку();
		Запись.ЗаписатьНачалоЭлемента("Список_ВСФ");
		Запись.ЗаписатьНачалоЭлемента("ВСФ");
		ДобавитьЭлементВФайл(Запись, "Ссылочный_код_ВСФ", Выборка.УИДИсточника);
		ДобавитьЭлементВФайл(Запись, "isCopy", Формат(Копия, "БЛ=0; БИ=1"));
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьКонецЭлемента();
		ОтправляемыеДанные = Запись.Закрыть();
		
		РЕЗ = ВебСервисы_сервер.ЗапроситьРИТМ("DCUpdateIsCopyVSF", ОтправляемыеДанные);
	КонецЕсли;
	
КонецПроцедуры

