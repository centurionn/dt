Функция СоздатьПланыПоступленийСписаний(XMLParams) Экспорт
	
	ТаблицаОшибок = Новый ТаблицаЗначений;	
	ТаблицаОшибок.Колонки.Добавить("ГУИДПланаУПП");
	ТаблицаОшибок.Колонки.Добавить("ПредставлениеПлана");
	ТаблицаОшибок.Колонки.Добавить("Комментарий");
	
	СтруктураДанных = ОбщегоНазначения.ЗначениеИзСтрокиXML(XMLParams);
	
	Планы = СтруктураДанных.Планы;
	СтрокиПланов = СтруктураДанных.СтрокиПланов;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Планы.ГУИДПланаУПП КАК ГУИДПланаУПП,
	|	Планы.ОрганизацияКод КАК ОрганизацияКод,
	|	Планы.Дата КАК Дата,
	|	Планы.Номер КАК Номер,
	|	Планы.Проведен КАК Проведен,
	|	Планы.ПодразделениеКод КАК ПодразделениеКод,
	|	Планы.ДатаНачала КАК ДатаНачала,
	|	Планы.ДатаОкончания КАК ДатаОкончания,
	|	Планы.СценарийНаименование КАК СценарийНаименование,
	|	Планы.ОтветственныйНаименование КАК ОтветственныйНаименование
	|ПОМЕСТИТЬ Планы
	|ИЗ
	|	&Планы КАК Планы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Строки.ГУИДПланаУПП КАК ГУИДПланаУПП,
	|	Строки.ВидДвижения КАК ВидДвижения,
	|	Строки.СтатьяДвиженияДенежныхСредствКод КАК СтатьяДвиженияДенежныхСредствКод,
	|	Строки.УИДКонтрагента КАК УИДКонтрагента,
	|	Строки.УИДДоговораКонтрагента КАК УИДДоговораКонтрагента,
	|	Строки.ДатаДвижения КАК ДатаДвижения,
	|	Строки.ВалютаКод КАК ВалютаКод,
	|	Строки.Сумма КАК Сумма,
	|	Строки.КонтрагентПредставление КАК КонтрагентПредставление,
	|	Строки.ДоговорПредставление КАК ДоговорПредставление
	|ПОМЕСТИТЬ Строки
	|ИЗ
	|	&Строки КАК Строки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Планы.ГУИДПланаУПП КАК ГУИДПланаУПП,
	|	Планы.Дата КАК Дата,
	|	Планы.Номер КАК Номер,
	|	Планы.Проведен КАК Проведен,
	|	Планы.ПодразделениеКод КАК ПодразделениеКод,
	|	Планы.ДатаНачала КАК ДатаНачала,
	|	Планы.ДатаОкончания КАК ДатаОкончания,
	|	Планы.СценарийНаименование КАК СценарийНаименование,
	|	ЗагруженныеПланы.Объект КАК ПланСсылка,
	|	Организации.Ссылка КАК Организация,
	|	ЦентрыФинансовойОтветственности.Ссылка КАК ЦФО,
	|	ЦентрыФинансовойОтветственности.Подразделение КАК Подразделение,
	|	ВариантыПланаПродаж.Ссылка КАК ВариантПланаПродаж,
	|	Пользователи.Ссылка КАК Ответственный
	|ИЗ
	|	Планы КАК Планы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ЗагруженныеПланы
	|		ПО Планы.ГУИДПланаУПП = ЗагруженныеПланы.УИДИсточника
	|			И (ЗагруженныеПланы.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УПП))
	|			И (ЗагруженныеПланы.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЦентрыФинансовойОтветственности КАК ЦентрыФинансовойОтветственности
	|		ПО Планы.ПодразделениеКод = ЦентрыФинансовойОтветственности.Код
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыПланаПродаж КАК ВариантыПланаПродаж
	|		ПО Планы.СценарийНаименование = ВариантыПланаПродаж.Наименование
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО Планы.ОрганизацияКод = Организации.Код
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	|		ПО Планы.ОтветственныйНаименование = Пользователи.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Строки.ГУИДПланаУПП КАК ГУИДПланаУПП,
	|	Строки.ВидДвижения КАК ВидДвижения,
	|	Строки.СтатьяДвиженияДенежныхСредствКод КАК СтатьяДвиженияДенежныхСредствКод,
	|	Строки.УИДКонтрагента КАК УИДКонтрагента,
	|	Строки.УИДДоговораКонтрагента КАК УИДДоговораКонтрагента,
	|	НАЧАЛОПЕРИОДА(Строки.ДатаДвижения, ДЕНЬ) КАК ДатаДвижения,
	|	Строки.ВалютаКод КАК ВалютаКод,
	|	Строки.Сумма КАК Сумма,
	|	Контрагенты.Объект КАК Контрагент,
	|	ДоговорыКонтрагентов.Объект КАК ДоговорКонтрагента,
	|	Статьи.Ссылка КАК СтатьяДвиженияДенежныхСредств,
	|	Валюты.Ссылка КАК Валюта,
	|	Строки.КонтрагентПредставление КАК КонтрагентПредставление,
	|	Строки.ДоговорПредставление КАК ДоговорПредставление
	|ПОМЕСТИТЬ СтрокиСсылки
	|ИЗ
	|	Строки КАК Строки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК Контрагенты
	|		ПО Строки.УИДКонтрагента = Контрагенты.УИДИсточника
	|			И (Контрагенты.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
	|			И (Контрагенты.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.БитФинанс))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ДоговорыКонтрагентов
	|		ПО Строки.УИДДоговораКонтрагента = ДоговорыКонтрагентов.УИДИсточника
	|			И (ДоговорыКонтрагентов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
	|			И (ДоговорыКонтрагентов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.БитФинанс))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтатьиДвиженияДенежныхСредств КАК Статьи
	|		ПО Строки.СтатьяДвиженияДенежныхСредствКод = Статьи.Код
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
	|		ПО Строки.ВалютаКод = Валюты.Код
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтрокиСсылки.ГУИДПланаУПП КАК ГУИДПланаУПП,
	|	СтрокиСсылки.ВидДвижения КАК ВидДвижения,
	|	СтрокиСсылки.СтатьяДвиженияДенежныхСредствКод КАК СтатьяДвиженияДенежныхСредствКод,
	|	СтрокиСсылки.УИДКонтрагента КАК УИДКонтрагента,
	|	СтрокиСсылки.УИДДоговораКонтрагента КАК УИДДоговораКонтрагента,
	|	СтрокиСсылки.ДатаДвижения КАК ДатаДвижения,
	|	СтрокиСсылки.Сумма КАК Сумма,
	|	СтрокиСсылки.Контрагент КАК Контрагент,
	|	СтрокиСсылки.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	СтрокиСсылки.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
	|	СтрокиСсылки.Валюта КАК Валюта,
	|	ВЫБОР
	|		КОГДА СтрокиСсылки.Валюта = &ВалютаРубль
	|			ТОГДА СтрокиСсылки.Сумма
	|		ИНАЧЕ СтрокиСсылки.Сумма * КурсыВалют.Курс / КурсыВалют.Кратность
	|	КОНЕЦ КАК СуммаРуб,
	|	СтрокиСсылки.КонтрагентПредставление КАК КонтрагентПредставление,
	|	СтрокиСсылки.ДоговорПредставление КАК ДоговорПредставление,
	|	СтрокиСсылки.ВалютаКод КАК ВалютаКод
	|ИЗ
	|	СтрокиСсылки КАК СтрокиСсылки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
	|		ПО СтрокиСсылки.Валюта = КурсыВалют.Валюта
	|			И СтрокиСсылки.ДатаДвижения = КурсыВалют.Период";
	
	Запрос.УстановитьПараметр("Планы", Планы);
	Запрос.УстановитьПараметр("Строки", СтрокиПланов);
	Запрос.УстановитьПараметр("ВалютаРубль", Справочники.Валюты.Рубль);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	Планы = РезультатыЗапроса[2].Выгрузить();
	СтрокиПланов = РезультатыЗапроса[4].Выгрузить();
	
	ОсновнаяОрганизация = Константы.ОсновнаяОрганизация.Получить();
	ТекДата = ТекущаяДата();
	КоличествоЗагруженныхПланов = 0;
	
	Для Каждого СтрокаТаблицыПланов Из Планы Цикл
		
		ЕстьОшибки = Ложь;
		
		НомерДатаВБУ = СтрШаблон("%1 от %2", СтрокаТаблицыПланов.Номер, Формат(СтрокаТаблицыПланов.Дата, "ДФ=dd.MM.yyyy"));
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицыПланов.Организация) Тогда
			СтрокаТЗРезультата = ТаблицаОшибок.Добавить();
			СтрокаТЗРезультата.Комментарий = "Не найдена организация!";
			СтрокаТЗРезультата.ПредставлениеПлана = НомерДатаВБУ;
			СтрокаТЗРезультата.ГУИДПланаУПП = СтрокаТаблицыПланов.ГУИДПланаУПП;
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицыПланов.ВариантПланаПродаж) Тогда
			СтрокаТЗРезультата = ТаблицаОшибок.Добавить();
			СтрокаТЗРезультата.Комментарий = СтрШаблон("Не найден Вариант плана продаж (Сценарий в УПП) %1!", СтрокаТаблицыПланов.СценарийНаименование);
			СтрокаТЗРезультата.ПредставлениеПлана = НомерДатаВБУ;
			СтрокаТЗРезультата.ГУИДПланаУПП = СтрокаТаблицыПланов.ГУИДПланаУПП;
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицыПланов.ЦФО) Тогда
			СтрокаТЗРезультата = ТаблицаОшибок.Добавить();
			СтрокаТЗРезультата.Комментарий = "Не найден ЦФО!";
			СтрокаТЗРезультата.ПредставлениеПлана = НомерДатаВБУ;
			СтрокаТЗРезультата.ГУИДПланаУПП = СтрокаТаблицыПланов.ГУИДПланаУПП;
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТаблицыПланов.ПланСсылка) Тогда
			ПланОбъект = СтрокаТаблицыПланов.ПланСсылка.ПолучитьОбъект();
		Иначе
			ПланОбъект = Документы.ПланПоступленийСписаний.СоздатьДокумент();
			ПланОбъект.Дата = ТекущаяДата();
		КонецЕсли;
		
		ПланОбъект.Поступления.Очистить();
		ПланОбъект.Списания.Очистить();
		
		ПланОбъект.Организация = ОсновнаяОрганизация;
		ЗаполнитьЗначенияСвойств(ПланОбъект, СтрокаТаблицыПланов, "Дата, ДатаНачала, ДатаОкончания, ВариантПланаПродаж, ЦФО, Подразделение");
		
		СтрокиПлана = СтрокиПланов.НайтиСтроки(Новый Структура("ГУИДПланаУПП", СтрокаТаблицыПланов.ГУИДПланаУПП));		
		Для Каждого СтрокаТЧ Из СтрокиПлана Цикл
			
			Если СтрокаТЧ.ВидДвижения = "Приход" Тогда
				НоваяСтрока = ПланОбъект.Поступления.Добавить();
			Иначе
				НоваяСтрока = ПланОбъект.Списания.Добавить();
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(СтрокаТЧ.СтатьяДвиженияДенежныхСредств) Тогда
				СтрокаТЗРезультата = ТаблицаОшибок.Добавить();
				СтрокаТЗРезультата.Комментарий = СтрШаблон("Не найдена Статья ДДС с кодом %1!", СтрокаТЧ.СтатьяДвиженияДенежныхСредствКод);
				СтрокаТЗРезультата.ПредставлениеПлана = НомерДатаВБУ;
				СтрокаТЗРезультата.ГУИДПланаУПП = СтрокаТаблицыПланов.ГУИДПланаУПП;
				ЕстьОшибки = Истина;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(СтрокаТЧ.Валюта) Тогда
				СтрокаТЗРезультата = ТаблицаОшибок.Добавить();
				СтрокаТЗРезультата.Комментарий = СтрШаблон("Не найдена Валюта с кодом %1!", СтрокаТЧ.ВалютаКод);
				СтрокаТЗРезультата.ПредставлениеПлана = НомерДатаВБУ;
				СтрокаТЗРезультата.ГУИДПланаУПП = СтрокаТаблицыПланов.ГУИДПланаУПП;
				ЕстьОшибки = Истина;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаТЧ.УИДКонтрагента) И Не ЗначениеЗаполнено(СтрокаТЧ.Контрагент) Тогда
				СтрокаТЗРезультата = ТаблицаОшибок.Добавить();
				СтрокаТЗРезультата.Комментарий = СтрШаблон("Не найден Контрагент %1 (%2)!", СтрокаТЧ.КонтрагентПредставление, СтрокаТЧ.УИДКонтрагента);
				СтрокаТЗРезультата.ПредставлениеПлана = НомерДатаВБУ;
				СтрокаТЗРезультата.ГУИДПланаУПП = СтрокаТаблицыПланов.ГУИДПланаУПП;
				ЕстьОшибки = Истина;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаТЧ.УИДДоговораКонтрагента) И Не ЗначениеЗаполнено(СтрокаТЧ.ДоговорКонтрагента) Тогда
				СтрокаТЗРезультата = ТаблицаОшибок.Добавить();
				СтрокаТЗРезультата.Комментарий = СтрШаблон("Не найден Договор %1 (%2)!", СтрокаТЧ.ДоговорПредставление, СтрокаТЧ.УИДДоговораКонтрагента);
				СтрокаТЗРезультата.ПредставлениеПлана = НомерДатаВБУ;
				СтрокаТЗРезультата.ГУИДПланаУПП = СтрокаТаблицыПланов.ГУИДПланаУПП;
				ЕстьОшибки = Истина;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ, "СтатьяДвиженияДенежныхСредств, Контрагент, ДоговорКонтрагента, ДатаДвижения, Сумма, Валюта, СуммаРуб");
			
		КонецЦикла;
		
		Если ЕстьОшибки Тогда
			Продолжить;
		КонецЕсли;
		
		ИтогоПоступления = ПланОбъект.Поступления.Итог("Сумма");
		ИтогоСписания = ПланОбъект.Списания.Итог("Сумма");
		СуммаВБУ = ИтогоПоступления - ИтогоСписания;
		
		НачатьТранзакцию();
		
		СтруктураПоиска = Новый Структура("ДействиеПриОбмене, УзелОбмена", Перечисления.ДействияПриОбмене.ЗагрузкаДанных, Перечисления.УзлыОбмена.УПП);
		
		Если Не ПланОбъект.ЭтоНовый() Тогда
			
			СтруктураПоиска.Вставить("Объект", ПланОбъект.Ссылка);
					
			ЗаписьВПротоколеОбменов = РегистрыСведений.ПротоколОбменов.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(ЗаписьВПротоколеОбменов, СтруктураПоиска);
			ЗаписьВПротоколеОбменов.Прочитать();
			Если ЗаписьВПротоколеОбменов.Выбран() Тогда
				ЗаписьВПротоколеОбменов.Удалить();
			КонецЕсли;
			
		КонецЕсли;
		
		ПланОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
		Если Не СтруктураПоиска.Свойство("Объект") Тогда
			СтруктураПоиска.Вставить("Объект", ПланОбъект.Ссылка);
		КонецЕсли;
		
		СтруктураДанных = Новый Структура("УИДИсточника, Ответственный, ПроведенВБУ, СуммаВБУ, ДатаДокументаВнешнейИС, ДатаОбмена, НомерДатаВБУ", СтрокаТаблицыПланов.ГУИДПланаУПП,  СтрокаТаблицыПланов.Ответственный, СтрокаТаблицыПланов.Проведен, СуммаВБУ, СтрокаТаблицыПланов.Дата, ТекДата, НомерДатаВБУ);
		РегистрыСведений.ПротоколОбменов.ЗафиксироватьИнформациюОЗагрузке(СтруктураПоиска, СтруктураДанных);
		
		ЗафиксироватьТранзакцию();
		
		КоличествоЗагруженныхПланов = КоличествоЗагруженныхПланов + 1;
		
	КонецЦикла;
	
	СтруктураРезультат = Новый Структура;
	СтруктураРезультат.Вставить("КоличествоЗагруженныхПланов", КоличествоЗагруженныхПланов);
	СтруктураРезультат.Вставить("ТаблицаОшибок", ТаблицаОшибок);
	
	Возврат ОбщегоНазначения.ЗначениеВСтрокуXML(СтруктураРезультат);
	
КонецФункции

//записывает дерево значений в XML
Функция ЗаписатьДеревоВXML(ДЗ) Экспорт
	
	Запись = Новый ЗаписьXML();
	Запись.УстановитьСтроку();
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьНачалоЭлемента("Корневой");
	Запись.ЗаписатьНачалоЭлемента("Структура");
	Для каждого Колонка ИЗ ДЗ.Колонки Цикл
		Запись.ЗаписатьАтрибут(Колонка.Имя,Колонка.Имя);
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента();
	Для каждого СтрокиДЗ из ДЗ.Строки Цикл
		УровеньГруппировки = 1;
		ЗаписатьСтрокиДереваВXML(СтрокиДЗ,Запись,ДЗ,УровеньГруппировки);
	КонецЦикла;	
	Запись.ЗаписатьКонецЭлемента();
	СтрокаXML = Запись.Закрыть();
	Возврат СтрокаXML;
	
КонецФункции	
//рекурсия для ЗаписатьДеревоВXML()
Процедура ЗаписатьСтрокиДереваВXML(СтрокиДерева,Запись,ДЗ,УровеньГруппировки)
	
	Запись.ЗаписатьНачалоЭлемента("Элемент"+УровеньГруппировки);
	Для каждого Колонка из ДЗ.Колонки Цикл
		Если НЕ СтрокиДерева[Колонка.Имя] = NULL Тогда
			Запись.ЗаписатьАтрибут(Колонка.Имя,Строка(СтрокиДерева[Колонка.Имя]));
		КонецЕсли;
	КонецЦикла;
	Для каждого СтрокаДерева Из СтрокиДерева.Строки Цикл
		ЗаписатьСтрокиДереваВXML(СтрокаДерева,Запись,ДЗ,УровеньГруппировки+1);
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента();
	
КонецПроцедуры	

Функция ПолучитьСписокКатегорийДоговоров(xmlParam) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КатегорииДоговоров.Код КАК Код,
	|	КатегорииДоговоров.Наименование КАК Наименование
	|ИЗ
	|	Справочник.КатегорииДоговоров КАК КатегорииДоговоров
	|ГДЕ
	|	НЕ КатегорииДоговоров.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	
	ТаблицаКатегорий = Запрос.Выполнить().Выгрузить();
	
	Возврат ОбщегоНазначения.ЗначениеВСтрокуXML(ТаблицаКатегорий);
	
КонецФункции

//Евросиб Дубская 24.04.2023 ( Для отчета НЗП
Функция ПередатьСписокАкцептовДляОтчетаНЗП(XMLParams) Экспорт 
	
	ГУИДДокументов =  ОбщегоНазначения.ЗначениеИзСтрокиXML(XMLParams);
	СсылкиНаДокументы = Новый ТаблицаЗначений;
	СсылкиНаДокументы.Колонки.Добавить("ГУИД",Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(36)));
	СсылкиНаДокументы.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.Акцепт"));
	СсылкиНаДокументы.Колонки.Добавить("ГУИД_СторнируемогоАкцепта", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(36)));
	СсылкиНаДокументы.Колонки.Добавить("СторнируемыйАкцепт", Новый ОписаниеТипов("ДокументСсылка.Акцепт"));
	
	Для Каждого СтрокаГУИД Из ГУИДДокументов Цикл
		Строка = СсылкиНаДокументы.Добавить();
		Строка.ГУИД = СтрокаГУИД;
		Строка.Ссылка = Документы.Акцепт.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.ГУИД));
 		Строка.ГУИД_СторнируемогоАкцепта = ?(ЗначениеЗаполнено(Строка.Ссылка.СторнируемыйАкцепт), Строка.Ссылка.СторнируемыйАкцепт.УникальныйИдентификатор(), "");
 		Строка.СторнируемыйАкцепт = ?(ЗначениеЗаполнено(Строка.Ссылка.СторнируемыйАкцепт), Строка.Ссылка.СторнируемыйАкцепт, Документы.Акцепт.ПустаяСсылка());
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СсылкиНаДокументы.ГУИД КАК ГУИД,
	|	СсылкиНаДокументы.Ссылка КАК Ссылка,
	|	СсылкиНаДокументы.СторнируемыйАкцепт КАК СторнируемыйАкцепт,
	|	СсылкиНаДокументы.ГУИД_СторнируемогоАкцепта КАК ГУИД_СторнируемогоАкцепта
	|ПОМЕСТИТЬ СсылкиНаДокументы
	|ИЗ
	|	&СсылкиНаДокументы КАК СсылкиНаДокументы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Акцепт.Ссылка КАК Ссылка,
	|	Акцепт.Поступление КАК Поступление,
	|	МИНИМУМ(Акцепт_СледующийЗаСторно.Дата) КАК Дата
	|ПОМЕСТИТЬ Акцепты_Следующие_Дата
	|ИЗ
