		РейсОбъект.ПунктОтправления	= ПолучитьПортТерминалПоГуид(ДанныеРейса.ПортПогрузкиID);
		РейсОбъект.ПунктНазначения	= ПолучитьПортТерминалПоГуид(ДанныеРейса.ПортНазначенияID);
		РейсОбъект.МестоПогрузки	= ПолучитьПортТерминалПоГуид(ДанныеРейса.ТерминалПогрузкиID);
		РейсОбъект.МестоРазгрузки	= ПолучитьПортТерминалПоГуид(ДанныеРейса.ТерминалНазначенияID);
	Иначе
		РейсОбъект.ПунктОтправления	= ПараметрыПроверкиДублей.ПунктОтправления; 
		РейсОбъект.ПунктНазначения	= ПараметрыПроверкиДублей.ПунктНазначения;
		РейсОбъект.МестоПогрузки	= ПолучитьТерминал(ДанныеРейса.ТерминалПогрузкиКод);
		РейсОбъект.МестоРазгрузки	= ПолучитьТерминал(ДанныеРейса.ТерминалНазначенияКод);
	КонецЕсли;
	//Евросиб Шевченко А.В. US 108007 TA 108027 05.06.2025
	
	РейсОбъект.ДатаОтправления	= ПараметрыПроверкиДублей.ДатаОтправления;
	РейсОбъект.ДатаПрибытия	= ПараметрыПроверкиДублей.ДатаПрибытия;
	//Евросиб(ДИТ), Беляев СЮ, US 104074 / TA 104682, 11-03-2025, конец
	
	Если ДанныеРейса.ПризнакУдаления <>"0" Тогда
		РейсОбъект.ПометкаУдаления = Истина;
	Иначе 
		РейсОбъект.ПометкаУдаления = Ложь;
	КонецЕсли;

	Попытка
		//РейсОбъект.Записать(); 
		//Евросиб(ДИТ), Беляев СЮ, BUG 102524 / TA 103699, 25-02-2025, начало
		Если ЗначениеЗаполнено(РейсОбъект.Ссылка) Тогда
			ИмяИзмененногоРеквизита = "";
			Если ДокументИзменен(РейсОбъект, , ,ИмяИзмененногоРеквизита) Тогда
				РейсОбъект.УстановитьКомментарийВерсииИсторииДанных("Проверка измененния данных. Изменен реквизит - " + ИмяИзмененногоРеквизита);
				РейсОбъект.Записать();
			КонецЕсли;
		Иначе
			РейсОбъект.Записать();
		КонецЕсли;
		//Евросиб(ДИТ), Беляев СЮ, BUG 102524 / TA 103699, 25-02-2025, конец
		
		ГУИД = РейсОбъект.Ссылка.УникальныйИдентификатор();
		Результат.Вставить("ГУИД", ГУИД );
		Результат.Вставить("Error", "");
		Если ЭтоНовый Тогда
			СтруктураПоискаВПротоколах.МодульРС.ЗаписатьУИДИсточника(ГУИД, СтруктураПоискаВПротоколах.ЗагрузкаДанных, СтруктураПоискаВПротоколах.УзелОбмена, РейсОбъект.Ссылка);
		КонецЕсли;  
	Исключение	
		Результат.Вставить("ГУИД", ДанныеРейса.ГУИД_DX);
		Результат.Вставить("Error", ОписаниеОшибки());
		Возврат Результат
	КонецПопытки; 
	
	Возврат Результат

КонецФункции

Функция ПолучитьПорт (Порт) экспорт 
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Локации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Локации КАК Локации
		|ГДЕ
		|	Локации.КодПортаUNLOCODE = &КодПортаUNLOCODE
		|	И НЕ Локации.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("КодПортаUNLOCODE", Порт);	
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		НайденоПортов = ВыборкаДетальныеЗаписи.Количество();
		Если НайденоПортов = 1 Тогда
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда 		
				Возврат ВыборкаДетальныеЗаписи.Ссылка;
			КонецЕсли;
		Иначе 
			Возврат Справочники.Локации.ПустаяСсылка();	
		КонецЕсли;
		
КонецФункции  

Функция ПолучитьКТК (СтрокаДокумента) экспорт  //поиск +создание
	
	СтруктураДанныеКТК = Новый Структура("КТК, ТипТЕ");	
	Попытка	
		Ктк = РаботаСКонтейнерамиСервер.СоздатьКТК(СтрокаДокумента.НомерКонтейнера,РаботаСКонтейнерамиСервер.ПолучитьТипТЕПоСтроке(СтрокаДокумента.Типоразмер));	
		Если Ктк <> Неопределено тогда
			Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КТК,"Ссылка,ТипТЕ");
			СтруктураДанныеКТК.Вставить("КТК", Реквизиты.Ссылка);
			СтруктураДанныеКТК.Вставить("ТипТЕ", Реквизиты.ТипТЕ);
