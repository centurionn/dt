// Евросиб TA 118382 Рыбьяков К.А. 06.01.2026 ((
Функция ПреобразоватьРезультатВПредставления(Запрос)
	
	Выгрузка = Запрос.Выполнить().Выгрузить();
	
	НаименованияКолонок = Новый Массив;
	
	Для Каждого Колонка Из Выгрузка.Колонки Цикл
		НаименованияКолонок.Добавить(Колонка.Имя);
	КонецЦикла;
	
	Для Каждого Колонка Из НаименованияКолонок Цикл
		
		НовоеИмя = Колонка + "_";
		Выгрузка.Колонки.Добавить(НовоеИмя, Новый ОписаниеТипов("Строка"));
		
		Для Каждого СтрокаВыгрузки Из Выгрузка Цикл
			СтрокаВыгрузки[НовоеИмя] = Строка(СтрокаВыгрузки[Колонка]);
		КонецЦикла;
		Выгрузка.Колонки.Удалить(Колонка);
		
	КонецЦикла;
	
	Возврат Выгрузка;
	
КонецФункции // Евросиб Рыбьяков К.А. 06.01.2026 ))

