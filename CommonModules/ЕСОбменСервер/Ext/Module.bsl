Функция ОбновитьДанныеПоМониторингу(ТекстЗапроса) Экспорт
	
	Запрос = Новый Запрос;
	
	Если СтрНайти(ТекстЗапроса, "[ТекущаяДата]") > 0 Тогда
		Запрос.Текст = СтрЗаменить(ТекстЗапроса, "[ТекущаяДата]", "&Период");
		Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
	Иначе
		Запрос.Текст = ТекстЗапроса;
	КонецЕсли;
	
	Результат = ПреобразоватьРезультатВПредставления(Запрос);
	
	//Выгрузка = Запрос.Выполнить().Выгрузить();
	
	Возврат СериализаторXDTO.ЗаписатьXDTO(Результат);

КонецФункции
