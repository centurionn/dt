				//Запись.ПризнакСобственности = Перечисления.ВариантыСобственности.Неизвестно;
				//Стало:
				Запись.ПризнакСобственности = Перечисления.ВариантыСобственности.ПустаяСсылка();
				// ДИТ 65580 Давудов М.А. Конец: 23.02.2023
				Запись.Записать();
			КонецЕсли;
			
			Если НЕ Выборка.НаСлежении Тогда				
				Запись = РегистрыСведений.ВагоныНаСлежении.СоздатьМенеджерЗаписи();
				Запись.Вагон = Вагон;
				Запись.Период = ДатаЗаписей;
				Запись.НаСлежении = Истина;
