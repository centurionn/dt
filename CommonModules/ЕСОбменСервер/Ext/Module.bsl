		|	И ПСЦ.Проведен
		|	И ПСЦ.ПСЦПоставщика
		|	И ПСЦ.СсылкаНаВнутреннийДокументДО = """"
		|
		|ОБЪЕДИНИТЬ ВСЕ		
		|
		|ВЫБРАТЬ
		|	ПСЦ.Ссылка
		|ИЗ
		|	Документ.ПСЦ КАК ПСЦ
		|ГДЕ
		|	(НАЧАЛОПЕРИОДА(ПСЦ.ДатаПереводаВСтатусПодписан, ДЕНЬ) = НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ)
		|			ИЛИ НАЧАЛОПЕРИОДА(ПСЦ.ДатаСогласования, ДЕНЬ) = НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ))
		|	И ПСЦ.Проведен
		|	И НЕ ПСЦ.ПСЦПоставщика
		|	И ПСЦ.СсылкаНаВнутреннийДокументДО = """"
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПротоколОбменов.Объект
		|ИЗ
		|	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
		|ГДЕ
		|	ПротоколОбменов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных)
		|	И ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.ДО)
		|	И ПротоколОбменов.ДатаОбмена >= &НачалоВчерашнегоДня
		|	И НЕ ПротоколОбменов.ЗагрузкаПодтверждена
		|	И ТИПЗНАЧЕНИЯ(ПротоколОбменов.Объект) = ЗНАЧЕНИЕ(Документ.ПСЦ)
		//Евросиб Каблов 17.12.2024 ( #98275
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПСЦПоставщика.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПСЦПоставщика КАК ПСЦПоставщика
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(ПСЦПоставщика.ДатаПереводаВСтатусПодписан, ДЕНЬ) = НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ)
		|	И ПСЦПоставщика.Проведен
		|	И ПСЦПоставщика.СсылкаНаВнутреннийДокументДО = """"
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПротоколОбменов.Объект
		|ИЗ
		|	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
		|ГДЕ
		|	ПротоколОбменов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных)
		|	И ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.ДО)
		|	И ПротоколОбменов.ДатаОбмена >= &НачалоВчерашнегоДня
		|	И НЕ ПротоколОбменов.ЗагрузкаПодтверждена
		|	И ТИПЗНАЧЕНИЯ(ПротоколОбменов.Объект) = ЗНАЧЕНИЕ(Документ.ПСЦПоставщика)
		//Евросиб Каблов 17.12.2024 )
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_Переотправка.Ссылка КАК Ссылка
		|ИЗ
		|	ВТ_Переотправка КАК ВТ_Переотправка";
	
	Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ДатаЗапускаРЗ));    
	Запрос.УстановитьПараметр("НачалоВчерашнегоДня", НачалоДня(ДатаЗапускаРЗ) - 24*3600); 
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();  
	ВыборкаДляСверки = РезультатыЗапроса[0].Выбрать();
	
	// 1.1. Берем те, которые отправлялись ранее, проверяем соответствие вложений
	// - ПСЦ с клиентом (с текущей датой подписания или датой согласования)
	// - ПСЦ с поставщиком (с текущей датой подписания)
	// В этом блоке, если нашли расхождение в составе вложенных файлов, то добавим в массив для переотправки
	Пока ВыборкаДляСверки.Следующий() Цикл 
		Если не ЗначениеЗаполнено(ВыборкаДляСверки.СсылкаНаВнутреннийДокументДО) Тогда
			Продолжить;
		КонецЕсли;
		НС = ТаблицаПСЦДляСверкиФайлов.Добавить();
		НС.Ссылка = ВыборкаДляСверки.Ссылка;
		НС.GUIDProtocol = ВыборкаДляСверки.СсылкаНаВнутреннийДокументДО;  
		НС.ДатаНачала = ВыборкаДляСверки.ДатаНачала; 
		НС.ДатаОкончания = ВыборкаДляСверки.ДатаОкончания;
	КонецЦикла; 
	
	Если ТаблицаПСЦДляСверкиФайлов.Количество() Тогда
		Результат = Новый Структура("Успешно", Ложь);
		ЗапроситьВложенияПСЦвДОиСверить(ТаблицаПСЦДляСверкиФайлов, МассивДляПереотправки, Результат);
		
		Если не Результат.Успешно Тогда
			ЗаписьЖурналаРегистрации(НСтр("ru = 'РЗ. Переотправка ПСЦ в ДО'"),
						УровеньЖурналаРегистрации.Ошибка,,,
						"Не удалось сверить файлы отправленных ПСЦ за дату " + ДатаЗапускаРЗ);
		КонецЕсли;
	КонецЕсли;
	
	// 1.2. Берем те, которые не отправлялись или отправились с ошибкой
	// - об этом есть отметка в регистре Протокол обменов (вчера и сегодня)
	// - или ПСЦ с клиентом (с текущей датой подписания или датой согласования), где не заполнена ссылка на ПСЦ в ДО
	// - или ПСЦ с поставщиком (с текущей датой подписания), где не заполнена ссылка на ПСЦ в ДО
	ВыборкаДляПереотправки = РезультатыЗапроса[2].Выбрать();
	Пока ВыборкаДляПереотправки.Следующий() Цикл    
		Если МассивДляПереотправки.Найти(ВыборкаДляПереотправки.Ссылка) = Неопределено Тогда
			МассивДляПереотправки.Добавить(ВыборкаДляПереотправки.Ссылка);
		КонецЕсли;
	КонецЦикла;
	//Евросиб Каблов 17.12.2024 ( #98275
	МассивДляПереотправки = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивДляПереотправки);
	//Евросиб Каблов 17.12.2024 )
	ТаблицаДляОтправки = ПодготовитьТаблицуПСЦдляОтправкиДО(МассивДляПереотправки);
	СоздатьКарточкуПСЦвДО(ТаблицаДляОтправки, Истина); 
	
	Для каждого СтрокаПротокола Из ТаблицаДляОтправки Цикл
		Если ЗначениеЗаполнено(СтрокаПротокола.Ссылка_В_ДО) Тогда
			ПротоколОбъект = СтрокаПротокола.Ссылка.ПолучитьОбъект();
			ПротоколОбъект.СсылкаНаВнутреннийДокументДО = СтрокаПротокола.Ссылка_В_ДО;
			ПротоколОбъект.ОбменДанными.Загрузка = Истина;
		    ПротоколОбъект.Записать();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// ДИТ BUG 79699 ТА 81720 Сержантова А.С. 01.03.2024
Процедура ЗапроситьВложенияПСЦвДОиСверить(ТаблицаПСЦДляСверкиФайлов, МассивДляПереотправки, Результат)
	
	Прокси = ВебСервисы_сервер.ПолучитьПрокси("ВебСервисОбменаСДО");
	
	// отправляем состояние в веб-сервис 1С:ДО
	ИмяМетода = "FileAndDocumentData";
	ИмяОперации = "GetDocumentsFile"; 
	
	Попытка
		//Получаем параметры метода
		ТипWSПараметра = Прокси.ФабрикаXDTO.Пакеты.Получить(ИмяМетода).Получить(ИмяОперации);
	Исключение
		Возврат; // нет подключения к веб-сервису	
	КонецПопытки;
	
	Для каждого СтрДокумента Из ТаблицаПСЦДляСверкиФайлов Цикл   
		
		Запись = Новый ЗаписьXML;
		
		Запись.УстановитьСтроку("UTF-8"); 
		Запись.ЗаписатьОбъявлениеXML();
		
		Запись.ЗаписатьНачалоЭлемента("Protocols"); 
		
		Запись.ЗаписатьНачалоАтрибута("xmlns");		
		Запись.ЗаписатьТекст(XMLСтрока("XMLDocuments"));		
		Запись.ЗаписатьКонецАтрибута(); //xmlns
		
		Запись.ЗаписатьНачалоАтрибута("xmlns:xs");		
		Запись.ЗаписатьТекст(XMLСтрока("http://www.w3.org/2001/XMLSchema"));		
		Запись.ЗаписатьКонецАтрибута(); //xmlns:xs
		
		Запись.ЗаписатьНачалоАтрибута("xmlns:xsi");		
		Запись.ЗаписатьТекст(XMLСтрока("http://www.w3.org/2001/XMLSchema-instance"));		
		Запись.ЗаписатьКонецАтрибута(); //xmlns:xsi 
		
		Запись.ЗаписатьНачалоЭлемента("Protocol");   
		
		Запись.ЗаписатьНачалоЭлемента("DateStart");
		Запись.ЗаписатьТекст(XMLСтрока(НачалоДня(СтрДокумента.ДатаНачала)));		
		Запись.ЗаписатьКонецЭлемента();
		
		Запись.ЗаписатьНачалоЭлемента("DateEnd");
		Запись.ЗаписатьТекст(XMLСтрока(КонецДня(СтрДокумента.ДатаОкончания)));		
		Запись.ЗаписатьКонецЭлемента(); 
		
		Запись.ЗаписатьНачалоЭлемента("GUIDProtocol");
		Запись.ЗаписатьТекст(XMLСтрока(СтрДокумента.GUIDProtocol));		
		Запись.ЗаписатьКонецЭлемента();
		
		Запись.ЗаписатьНачалоЭлемента("NoBinaryData");
		Запись.ЗаписатьТекст(XMLСтрока(Ложь));		
		Запись.ЗаписатьКонецЭлемента();  
		
		Запись.ЗаписатьНачалоЭлемента("AllFiles");    
		Запись.ЗаписатьТекст(XMLСтрока(Истина));		
		Запись.ЗаписатьКонецЭлемента();
		
		Запись.ЗаписатьКонецЭлемента(); //Protocol    
		
		Запись.ЗаписатьКонецЭлемента(); //Protocols
		
		ЗапросXML = Запись.Закрыть();
		
		ОтветВебСервиса = "out";
		
		Попытка
			//Вызываем метод веб-сервиса
			ОтветXML = Прокси.GetDocumentsFile(
			ЗапросXML,
			ОтветВебСервиса);
		Исключение
			//Сообщить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Подключение к вебсервису 1С:ДО'"),
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())); 
		КонецПопытки;
		
		Если НЕ ОтветXML = Истина Тогда  
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Подключение к вебсервису 1С:ДО'"),
			УровеньЖурналаРегистрации.Ошибка,,СтрДокумента.Ссылка,
			"При запросе:
			|"+ЗапросXML+"
			|не удалось получить успешный ответ.
			|"+ОтветВебСервиса); 
			
			//письмо не отправляем, добавим автоматически в массив для переотправки 
			//ТаблицаДанных = ВебСервисы_сервер.УниверсальныйПарсерXML(ОтветВебСервиса, "Protocol"); 
			//ТекстОшибки = "";
			//Для каждого СтрОтвета Из ТаблицаДанных Цикл
			//	ТекстОшибки = ТекстОшибки + ?(ТекстОшибки <> "", Символы.ПС, "") + СтрОтвета.Comment; 	
			//КонецЦикла;  
			//Если ТекстОшибки <> "" Тогда
			//	ОтправитьПисьмоОбОшибкахОбменаДКДО(ТекстОшибки, СтрДокумента.Ссылка);
			//КонецЕсли;
            МассивДляПереотправки.Добавить(СтрДокумента.Ссылка);
		Иначе        
			Результат.Успешно = Истина;
			ТаблицаДанных = ВебСервисы_сервер.УниверсальныйПарсерXML(ОтветВебСервиса, "Protocol");   
			
			ПереченьВложенныхФайлов = СформироватьВложенныеФайлыДляПСЦ(СтрДокумента.Ссылка);    
			Если ПереченьВложенныхФайлов.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли; 
			
			Если ТаблицаДанных.Количество() = 0 и ПереченьВложенныхФайлов.Количество() <> 0 Тогда
				МассивДляПереотправки.Добавить(СтрДокумента.Ссылка);  
			Иначе
				Для каждого СтрокаВложенногоФайла Из ПереченьВложенныхФайлов Цикл
					СтруктураПоиска = Новый Структура("GUIDProtocol, Name, Extension", 
					СтрДокумента.GUIDProtocol, СтрокаВложенногоФайла.Имя, СтрокаВложенногоФайла.Расширение); 
					СтрокаФайлаДО = ТаблицаДанных.НайтиСтроки(СтруктураПоиска); 
					Если СтрокаФайлаДО.Количество() = 0 или 
						(СтрокаФайлаДО.Количество() <> 0 и СтрокаФайлаДО[0].BinaryData <> СтрокаВложенногоФайла.Файл) Тогда
						МассивДляПереотправки.Добавить(СтрДокумента.Ссылка);
					КонецЕсли;
				КонецЦикла; 	
			КонецЕсли;
			
		КонецЕсли; 
	КонецЦикла;
	
КонецПроцедуры

// ДИТ BUG 79699 ТА 81720 Сержантова А.С. 04.04.2024
Процедура ОтправитьПисьмоОбОшибкахОбменаДКДО(ТекстОшибки, СсылкаПротокол)
	
	Если ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована Тогда
		Возврат;
	КонецЕсли;
	
	ПолучателиУведомлений = Константы.ПолучателиУведомленийОРегЗаданиях.Получить();
	Если Не ЗначениеЗаполнено(ПолучателиУведомлений) Тогда
		Возврат;
	КонецЕсли;	
	УчетнаяЗаписьПоУмолчаниюДоступна = РаботаСПочтовымиСообщениями.ПроверитьСистемнаяУчетнаяЗаписьДоступна();	
	Если УчетнаяЗаписьПоУмолчаниюДоступна = Ложь Тогда
		Возврат;
	КонецЕсли;	
	СистемнаяУчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	ПолучателиПисьма = Новый Массив;
	Если ТипЗнч(ПолучателиУведомлений) = Тип("СправочникСсылка.Пользователи") Тогда
		ЭлАдресПользователя = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ПолучателиУведомлений, Справочники.ВидыКонтактнойИнформации.EmailПользователя, , Истина);
		ПолучателиПисьма.Добавить(Новый Структура("Представление, Адрес", ПолучателиУведомлений, ЭлАдресПользователя));
	Иначе	
		Для Каждого ТекущийПользователь Из ПолучателиУведомлений.Состав Цикл								
			ЭлАдресПользователя = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ТекущийПользователь.Пользователь, Справочники.ВидыКонтактнойИнформации.EmailПользователя, , Истина);
			ПолучателиПисьма.Добавить(Новый Структура("Представление, Адрес", ТекущийПользователь.Пользователь, ЭлАдресПользователя));
		КонецЦикла;
	КонецЕсли;
	
	ТекстПисьма = "ДОКУМЕНТ " + СсылкаПротокол;
	ТекстПисьма = ТекстПисьма + Символы.ПС + " ТЕКСТ ОШИБКИ: " + ТекстОшибки + Символы.ПС + Символы.ПС;
	
	ПараметрыОтправкиПисьма = Новый Структура;
	ПараметрыОтправкиПисьма.Вставить("ТипТекста", 	Перечисления.ТипыТекстовЭлектронныхПисем.ПростойТекст);
	ПараметрыОтправкиПисьма.Вставить("Тема", 		"Ошибка отправки Протокола из ДК в ДО");
	ПараметрыОтправкиПисьма.Вставить("Тело", 		ТекстПисьма);		
	ПараметрыОтправкиПисьма.Вставить("Кому", 		ПолучателиПисьма);
	
	Попытка
		РезультатОтправки = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(СистемнаяУчетнаяЗапись, ПараметрыОтправкиПисьма);
	Исключение
		ЗаписьЖурналаРегистрации("ОтправкаПисьмаОбОшибкахОбменаДК_ДО",
							УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры	

// Евросиб(ДИТ) US 85722 ТА 86908 Сержантова А.С. 23.07.2024  

// Получает ссылку на договор контрагента в ДО
//
// Параметры:
// 	РеквизитыДоговора - Структура - Структура, содержащая поля ВидДоговора, ДатаНачала, ДатаОкончания, ИдентификаторМСД 
//
Функция ПолучитьСсылкуИзДОдляДоговораКонтрагента(РеквизитыДоговора) Экспорт

	Прокси = ВебСервисы_сервер.ПолучитьПрокси("ВебСервисОбменаСДО");
	
	ИмяМетода = "FileAndDocumentData";
	ИмяОперации = "GetDocuments"; 
	
	Попытка
		//Получаем параметры метода
		ТипWSПараметра = Прокси.ФабрикаXDTO.Пакеты.Получить(ИмяМетода).Получить(ИмяОперации);
	Исключение
		Возврат Неопределено; // нет подключения к веб-сервису	
	КонецПопытки;
			
	//Создаем параметр на основе типа и заполняем значение параметров
	WSПараметр = Прокси.ФабрикаXDTO.Создать(ТипWSПараметра);       
	
	Если РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда
		ТипДокумента = "Договор с клиентом";	
	Иначе 	
		ТипДокумента = "Договор с подрядчиком"; 
	КонецЕсли;          
	
	Запись = Новый ЗаписьXML;
	
	Запись.УстановитьСтроку("UTF-8"); 
	Запись.ЗаписатьОбъявлениеXML();
	
	Запись.ЗаписатьНачалоЭлемента("DocumentData");
	
	Запись.ЗаписатьНачалоАтрибута("xmlns:xsi");		
	Запись.ЗаписатьТекст(XMLСтрока("http://www.w3.org/2001/XMLSchema-instance"));		
	Запись.ЗаписатьКонецАтрибута(); //xmlns:xsi 
	
	Запись.ЗаписатьНачалоАтрибута("xmlns:xs");		
	Запись.ЗаписатьТекст(XMLСтрока("http://www.w3.org/2001/XMLSchema"));		
	Запись.ЗаписатьКонецАтрибута(); //xmlns:xs
	
	Запись.ЗаписатьНачалоАтрибута("xmlns");		
	Запись.ЗаписатьТекст(XMLСтрока("XMLDocuments"));		
	Запись.ЗаписатьКонецАтрибута(); //xmlns
	
	Запись.ЗаписатьНачалоЭлемента("ApplicationType");
	Запись.ЗаписатьТекст(XMLСтрока(ТипДокумента));		
	Запись.ЗаписатьКонецЭлемента(); //ApplicationType – описывает тип документа
	
	Запись.ЗаписатьНачалоЭлемента("DateStart");
	Запись.ЗаписатьТекст(XMLСтрока(РеквизитыДоговора.ДатаНачала));		
	Запись.ЗаписатьКонецЭлемента(); //DateStart – дата начала действия
	
	Запись.ЗаписатьНачалоЭлемента("DateEnd");
	Запись.ЗаписатьТекст(XMLСтрока(РеквизитыДоговора.ДатаОкончания));		
	Запись.ЗаписатьКонецЭлемента(); //DateEnd – дата окончания действия   
	
	Запись.ЗаписатьНачалоЭлемента("ExternalSystemID");
	Запись.ЗаписатьТекст(XMLСтрока("Data Core"));		
	Запись.ЗаписатьКонецЭлемента(); //ExternalSystemID 
	
	Запись.ЗаписатьНачалоЭлемента("GUIDContract");
	Запись.ЗаписатьТекст(XMLСтрока(РеквизитыДоговора.ИдентификаторМСД));		
	Запись.ЗаписатьКонецЭлемента(); //GUIDContract – идентификатор договора(идентификатор объекта 1с), строка длинной 36, по шаблону в XML схеме 
	
	Запись.ЗаписатьКонецЭлемента(); //DocumentData
	
	ЗапросXML = Запись.Закрыть();
	
	ОтветВебСервиса = "out";
	
	Попытка
		//Вызываем метод веб-сервиса
		ОтветXML = Прокси.GetDocuments(
		ЗапросXML,
		ОтветВебСервиса);
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Подключение к вебсервису 1С:ДО'"),
		УровеньЖурналаРегистрации.Ошибка,,,
		ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Если НЕ ОтветXML = Истина Тогда  
		// ответ не успешен
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Подключение к вебсервису 1С:ДО'"),
		УровеньЖурналаРегистрации.Ошибка,,,
		"При запросе:
		|"+ЗапросXML+"
		|не удалось получить успешный ответ.
		|"+ОтветВебСервиса);   
	Иначе
		ТаблицаДанных = ВебСервисы_сервер.УниверсальныйПарсерXML(ОтветВебСервиса, "Protocol"); 
		Если ТаблицаДанных.Количество() Тогда
			Если ЗначениеЗаполнено(ТаблицаДанных[0].ExternalLink) Тогда
				Возврат ТаблицаДанных[0].ExternalLink;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат "";
		
КонецФункции 

//Евросиб(ДИТ), Беляев СЮ, US 89714 / TA 89717, 06-12-2024, начало
Функция ПолучитьПрисоединенныеФайлыИзДО(Документ, ГУИДДокумента = Неопределено) Экспорт
	
	ТаблицаФайлов = Новый ТаблицаЗначений;
	ТаблицаФайлов.Колонки.Добавить("Doc_Name", Новый ОписаниеТипов("Строка"));
	ТаблицаФайлов.Колонки.Добавить("File_GUID", Новый ОписаниеТипов("Строка"));
	ТаблицаФайлов.Колонки.Добавить("File_Name", Новый ОписаниеТипов("Строка"));
	ТаблицаФайлов.Колонки.Добавить("File_Type", Новый ОписаниеТипов("Строка"));
	ТаблицаФайлов.Колонки.Добавить("Original", Новый ОписаниеТипов("Булево"));
	ТаблицаФайлов.Колонки.Добавить("АдресВременногоХранилища");
	
	Если ЗначениеЗаполнено(Документ) И НЕ ЗначениеЗаполнено(ГУИДДокумента) Тогда
		
		Заголовок = Строка(Документ);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПротоколОбменов.УИДИсточника КАК УИДИсточника
			|ИЗ
			|	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
			|ГДЕ
			|	ПротоколОбменов.Объект = &Объект
			|	И ПротоколОбменов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных)
			|	И ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.ДО)";
		
		Запрос.УстановитьПараметр("Объект", Документ);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
			ГУИДДокумента = ВыборкаДетальныеЗаписи.УИДИсточника;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ГУИДДокумента) Тогда 
		
		// получим список актуальных файлов из 1С:ДО
		ИмяМетода = "FileAndDocumentData";
		ИмяОперации = "Get_FileInformation";
		
		//Прокси = ВебСервисы_сервер.ПолучитьПрокси("ВебСервисОбменаСДО");
		Прокси = ВебСервисы_сервер.ПолучитьПрокси("ВебСервисОбменаСДО");
		
		//Получаем тип параметра, который передается в метод Get_FileInformation.
		ТипWSПараметра = Прокси.ФабрикаXDTO.Пакеты.Получить(ИмяМетода).Получить(ИмяОперации);
		
		//Создаем параметр на основе типа и заполняем значение параметров
		WSПараметр = Прокси.ФабрикаXDTO.Создать(ТипWSПараметра);
		WSПараметр.Document_GUID 			= ГУИДДокумента;
		WSПараметр.Related_Docs_Required 	= "true"; // получаем файлы связанных документов в 1С:ДО
		
		Попытка
			//Вызываем метод веб-сервиса
			ОбъектXDTO = Прокси.Get_FileInformation(
				WSПараметр.Document_GUID,
				WSПараметр.Related_Docs_Required);
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Подключение к вебсервису 1С:ДО'"),
			   УровеньЖурналаРегистрации.Ошибка,,,
			   ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат ТаблицаФайлов;
		КонецПопытки;
		
		Если ТипЗнч(ОбъектXDTO) <> Тип("ОбъектXDTO")
				ИЛИ ОбъектXDTO.Свойства().Получить("FileInfo") = Неопределено Тогда
			Возврат ТаблицаФайлов;
		КонецЕсли;
		
		Для Каждого СтрокаОбъектаXDTO Из ОбъектXDTO.FileInfo Цикл
			
			СтрокаТаблицыФайлов = ТаблицаФайлов.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицыФайлов, СтрокаОбъектаXDTO);

		КонецЦикла;
		
	КонецЕсли;
	
	Если ТаблицаФайлов.Количество()>0 Тогда
		//Получаем параметры метода
		ИмяМетода = "FileAndDocumentData";
		ИмяОперации = "Get_File";
		ТипWSПараметра = Прокси.ФабрикаXDTO.Пакеты.Получить(ИмяМетода).Получить(ИмяОперации);
		
		Для Каждого СтрокаТаблицыФайлов Из ТаблицаФайлов Цикл
			
			//Создаем параметр на основе типа и заполняем значение параметров
			WSПараметр = Прокси.ФабрикаXDTO.Создать(ТипWSПараметра);
			WSПараметр.File_GUID 	= СтрокаТаблицыФайлов.File_GUID;
			
			Попытка
				//Вызываем метод веб-сервиса
				ОбъектXDTO = Прокси.Get_File(
				WSПараметр.File_GUID);
			Исключение
				ЗаписьЖурналаРегистрации(НСтр("ru = 'Подключение к вебсервису 1С:ДО'"),
				УровеньЖурналаРегистрации.Ошибка,,,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
			
			Если ТипЗнч(ОбъектXDTO) <> Тип("ОбъектXDTO")
				ИЛИ ОбъектXDTO.Свойства().Получить("Extension") = Неопределено
				ИЛИ ОбъектXDTO.Свойства().Получить("BinaryData") = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Попытка
				АдресВременногоХранилища = ПоместитьВоВременноеХранилище(ОбъектXDTO.BinaryData, Новый УникальныйИдентификатор);
				СтрокаТаблицыФайлов.АдресВременногоХранилища = АдресВременногоХранилища;
			Исключение
				ЗаписьЖурналаРегистрации(НСтр("ru = 'Подключение к вебсервису 1С:ДО'"),
				УровеньЖурналаРегистрации.Ошибка,,,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
			
		КонецЦикла;
	КонецЕсли;
	
	Возврат ТаблицаФайлов;
КонецФункции

// ДИТ Ticket 115001 Дедуник Д.О. Начало: 11.08.2025
Процедура ВыполнитьОтправкуПСЦвДО() Экспорт

	УзлыПланаОбмена = ПланыОбмена.ВыгрузкаДанных.ПолучитьУзелОбмена(Перечисления.УзлыОбмена.ДО);
	
	Если Не ЗначениеЗаполнено(УзлыПланаОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	НомерСообщения = 1;
	УзелПланаОбмена = УзлыПланаОбмена[0];
	ПланыОбмена.ВыбратьИзменения(УзелПланаОбмена, НомерСообщения);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПСЦИзменения.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПСЦ.Изменения КАК ПСЦИзменения
	|ГДЕ
	|	ПСЦИзменения.Узел.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.ДО)
	|	И ПСЦИзменения.НомерСообщения = &НомерСообщения
	|	И ПСЦИзменения.Ссылка.Проведен
	|	И ПСЦИзменения.Ссылка.ДатаСогласования <> &ПустаяДата
	|	И ВЫБОР
	|			КОГДА ПСЦИзменения.Ссылка.ПСЦПоставщика
	|				ТОГДА ПСЦИзменения.Ссылка.ПодписанСДвухСторон
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И НЕ (ПСЦИзменения.Ссылка.Организация = &Организация
	|	И ПСЦИзменения.Ссылка.ТипКалькуляции В(&ИсключаемыеТипыКалькуляции))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПСЦПоставщикаИзменения.Ссылка
	|ИЗ
	|	Документ.ПСЦПоставщика.Изменения КАК ПСЦПоставщикаИзменения
	|ГДЕ
	|	ПСЦПоставщикаИзменения.Узел.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.ДО)
	|	И ПСЦПоставщикаИзменения.НомерСообщения = &НомерСообщения
	|	И ПСЦПоставщикаИзменения.Ссылка.Проведен
	|	И ПСЦПоставщикаИзменения.Ссылка.ПодписанСДвухСторон
	|	И ПСЦПоставщикаИзменения.Ссылка.ДатаСогласования <> &ПустаяДата";
	
	ИсключаемыеТипыКалькуляции = Новый Массив;
	ИсключаемыеТипыКалькуляции.Добавить(Перечисления.ТипыКалькуляций.МежсервисныеРасходы);
	ИсключаемыеТипыКалькуляции.Добавить(Перечисления.ТипыКалькуляций.МежсервисныеРасходыРеф);
	Запрос.УстановитьПараметр("ИсключаемыеТипыКалькуляции", ИсключаемыеТипыКалькуляции);
	Запрос.УстановитьПараметр("Узел", УзелПланаОбмена);
	Запрос.УстановитьПараметр("НомерСообщения", НомерСообщения);
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	Запрос.УстановитьПараметр("Организация", Константы.ОсновнаяОрганизация.Получить());
	 
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
	    Возврат;
	КонецЕсли;
	
	Протоколы = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	ТаблицаДляОтправки = ПодготовитьТаблицуПСЦдляОтправкиДО(Протоколы);
	СоздатьКарточкуПСЦвДО(ТаблицаДляОтправки, Ложь);
	
	ПротоколыСОшибками = Новый Массив;
	
	Для Каждого Стр Из ТаблицаДляОтправки Цикл
		Если СтрНайти(Стр.Сообщение, "ОК") <> 0 Тогда
			ОбъектПСЦ = Стр.Ссылка.ПолучитьОбъект();
			ОбъектПСЦ.СсылкаНаВнутреннийДокументДО = Стр.Ссылка_В_ДО; 
			ОбъектПСЦ.Записать();
		Иначе
			ПротоколыСОшибками.Добавить(Стр.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	НачатьТранзакцию();
	
	ПланыОбмена.УдалитьРегистрациюИзменений(УзелПланаОбмена, НомерСообщения);
	
	Если ЗначениеЗаполнено(ПротоколыСОшибками) Тогда
		УзлыПланаОбмена = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(УзелПланаОбмена);
		ПланыОбмена.ЗарегистрироватьИзменения(УзлыПланаОбмена, ПротоколыСОшибками);
	КонецЕсли;
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

#КонецОбласти    

//Евросиб Каблов 12.10.2022 58752
Функция ПолучитьТаблицуТарифовПоставщиков() Экспорт
	
	ОписаниеТиповСтрока36 = Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(36));
	ОписаниеТиповСтрока30 = Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(30));
	ОписаниеТиповСтрока = Новый ОписаниеТипов("Строка");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТарифыПоставщиков.Код КАК Код,
	|	ТарифыПоставщиков.Наименование КАК Наименование,
	|	ТарифыПоставщиков.Родитель.Код КАК КодРодителя,
	|	ТарифыПоставщиков.ЭтоГруппа КАК ЭтоГруппа,
	|	ТарифыПоставщиков.ПунктОтправления.Тип.Наименование КАК ТипЛокацииОтправления,
	|	ВЫБОР
	|		КОГДА ТарифыПоставщиков.ПунктОтправления.Тип = ЗНАЧЕНИЕ(Справочник.ТипыЛокаций.СтанцияЖД)
	|			ТОГДА ПОДСТРОКА(ТарифыПоставщиков.ПунктОтправления.КодЖДСтанции, 1, 5)
	|		КОГДА ТарифыПоставщиков.ПунктОтправления.Тип = ЗНАЧЕНИЕ(Справочник.ТипыЛокаций.Порт)
	|			ТОГДА ТарифыПоставщиков.ПунктОтправления.КодПортаUNLOCODE
	|		КОГДА ТарифыПоставщиков.ПунктОтправления.Тип = ЗНАЧЕНИЕ(Справочник.ТипыЛокаций.Терминал)
	|			ТОГДА ТарифыПоставщиков.ПунктОтправления.ПредставлениеВCodeco
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КодЛокацииОтправления,
	|	ТарифыПоставщиков.ПунктНазначения.Тип.Наименование КАК ТипЛокацииНазначения,
	|	ВЫБОР
	|		КОГДА ТарифыПоставщиков.ПунктНазначения.Тип = ЗНАЧЕНИЕ(Справочник.ТипыЛокаций.СтанцияЖД)
	|			ТОГДА ПОДСТРОКА(ТарифыПоставщиков.ПунктНазначения.КодЖДСтанции, 1, 5)
	|		КОГДА ТарифыПоставщиков.ПунктНазначения.Тип = ЗНАЧЕНИЕ(Справочник.ТипыЛокаций.Порт)
	|			ТОГДА ТарифыПоставщиков.ПунктНазначения.КодПортаUNLOCODE
	|		КОГДА ТарифыПоставщиков.ПунктНазначения.Тип = ЗНАЧЕНИЕ(Справочник.ТипыЛокаций.Терминал)
	|			ТОГДА ТарифыПоставщиков.ПунктНазначения.ПредставлениеВCodeco
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КодЛокацииНазначения,
	|	ТарифыПоставщиков.Поставщик.Код КАК ПоставщикКод,
	|	ТарифыПоставщиков.Поставщик.Наименование КАК ПоставщикНаименование,
	|	ТарифыПоставщиков.ЕИНормативнойДлительности КАК ТипДлительности,
	|	ТарифыПоставщиков.НормативнаяДлительность КАК НормаДлительности,
	|	ТарифыПоставщиков.Валюта.Код КАК ВалютаКод,
	|	ТарифыПоставщиков.ЕстьУслугиЭкспедитора КАК ЕстьУслугиЭкспедитора,
	|	ТарифыПоставщиков.ЕстьПредоставлениеКТК КАК ЕстьПредоставлениеКТК,
	|	ТарифыПоставщиков.ЕстьПредоставлениеВагона КАК ЕстьПредоставлениеВагона,
	|	ТарифыПоставщиков.ЕстьСкидка КАК ЕстьСкидка,
	// ДИТ 89973 Давудов М.А. Начало: 21.08.2024
	//ок(
	//|	ПРЕДСТАВЛЕНИЕ(ТарифыПоставщиков.СобственностьПеревозимогоКТК) КАК COC_SOC,
	//ок)
	|	ПРЕДСТАВЛЕНИЕ(ТарифыПоставщиков.ПринадлежностьТЕ) КАК COC_SOC,
	// ДИТ 89973 Давудов М.А. Конец: 21.08.2024
	|	ТарифыПоставщиков.РазмерЛота КАК РазмерЛота,
	|	ТарифыПоставщиков.ПропускнаяСпособность КАК ПропускнаяСпособность,
	|	ТарифыПоставщиков.РазмерыКТК.(
	|		РазмерКТК.Размер КАК Размер
	|	) КАК РазмерыКТК,
	|	ТарифыПоставщиков.Ссылка КАК Ссылка,
	|	ТарифыПоставщиков.Родитель КАК Родитель,
	|	ТарифыПоставщиков.ТаблицаСтоимость.(
	|		От КАК От,
	|		До КАК До,
	|		Стоимость КАК Стоимость
	|	) КАК ТаблицаСтоимость
	|ИЗ
	|	Справочник.ТарифыПоставщиков КАК ТарифыПоставщиков
	|ГДЕ
	|	НЕ ТарифыПоставщиков.ПометкаУдаления
	|ИТОГИ ПО
	|	Ссылка ТОЛЬКО ИЕРАРХИЯ";
	
	ДеревоТарифов = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ТаблицаТарифов = Новый ТаблицаЗначений;	
	Для Каждого Колонка Из ДеревоТарифов.Колонки Цикл		
		ТаблицаТарифов.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);		
	КонецЦикла;
	
	СкопироватьДеровоВТаблицу(ДеревоТарифов, ТаблицаТарифов);
	
	ТаблицаТарифов.Колонки.Вставить(1, "УИД", ОписаниеТиповСтрока36);	
	ТаблицаТарифов.Колонки.Вставить(4, "УИДРодителя", ОписаниеТиповСтрока36);
	ТаблицаТарифов.Колонки.Добавить("РазмерКТК", ОписаниеТиповСтрока);
	
	Для Каждого Стр Из ТаблицаТарифов Цикл
		
		Стр.УИД = Стр.Ссылка.УникальныйИдентификатор();
		
		Если ЗначениеЗаполнено(Стр.Родитель) Тогда
			Стр.УИДРодителя = Стр.Родитель.УникальныйИдентификатор();
		КонецЕсли;
		
		Если Не Стр.ЭтоГруппа Тогда
			РазмерыКТК = Стр.РазмерыКТК.ВыгрузитьКолонку("Размер");
			Стр.РазмерКТК = СтрСоединить(РазмерыКТК, "; ");
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаТарифов.Колонки.Удалить("РазмерыКТК");
	ТаблицаТарифов.Колонки.Удалить("Ссылка");
	ТаблицаТарифов.Колонки.Удалить("Родитель");
	
	Возврат ТаблицаТарифов;
	
КонецФункции

