	               |	ВТ_Шапка.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
	               |	Организации.Ссылка КАК Организация,
	               |	ЦентрыФинансовойОтветственности.Ссылка КАК ЦФО,
	               |	Пользователи.Ссылка КАК Автор,
	               |	Пользователи.Подразделение КАК ПодразделениеОрганизации,
	               |	Контрагенты.Объект КАК Контрагент,
	               |	Договоры.Объект КАК ДоговорКонтрагента,
	               |	Валюты.Ссылка КАК ВалютаДокумента
	               |ИЗ
	               |	ВТ_Шапка КАК ВТ_Шапка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	               |		ПО ВТ_Шапка.ОрганизацияКод = Организации.Код
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЦентрыФинансовойОтветственности КАК ЦентрыФинансовойОтветственности
	               |		ПО ВТ_Шапка.ПодразделениеКод = ЦентрыФинансовойОтветственности.Код
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	               |		ПО ВТ_Шапка.ОтветственныйНаименование = Пользователи.Наименование
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК Контрагенты
	               |		ПО ВТ_Шапка.УИДКонтрагента = Контрагенты.УИДИсточника
	               |			И (Контрагенты.УзелОбмена = ЗНАЧЕНИЕ(перечисление.УзлыОбмена.БитФинанс))
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК Договоры
	               |		ПО ВТ_Шапка.УИДДоговораКонтаргента = Договоры.УИДИсточника
	               |			И (Договоры.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.БитФинанс))
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
	               |		ПО ВТ_Шапка.ВалютаДокументаКод = Валюты.Код
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Услуги.НомерСтроки КАК НомерСтроки,
	               |	ВТ_Услуги.Содержание КАК Содержание,
	               |	ВТ_Услуги.Количество КАК Количество,
	               |	ВТ_Услуги.Цена КАК Цена,
	               |	ВТ_Услуги.Сумма КАК Сумма,
	               |	ВТ_Услуги.СтавкаНДС КАК СтавкаНДС,
	               |	ВТ_Услуги.СуммаНДС КАК СуммаНДС,
	               |	ВТ_Услуги.НоменклатураКод КАК НоменклатураКод,
				   //Евросиб Каблов 24.11.2020 (
	               //|	Номенклатура.Объект КАК Номенклатура
				   |	ЕСТЬNULL(Номенклатура.Объект, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПредоставлениеПлатформ)) КАК Номенклатура
				   //Евросиб Каблов 24.11.2020 )
	               |ИЗ
	               |	ВТ_Услуги КАК ВТ_Услуги
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК Номенклатура
	               |		ПО ВТ_Услуги.НоменклатураКод = Номенклатура.УИДИсточника
	               |			И (Номенклатура.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УПП))
				   //Евросиб Каблов 17.06.2021 ( Ticket#0235050
				   |			И Номенклатура.НУИНУ = 0";
				   //Евросиб Каблов 17.06.2021 ) 
				   
	Запрос.УстановитьПараметр("Шапка", СтруктураЗаказа.Шапка);
	Запрос.УстановитьПараметр("Услуги", СтруктураЗаказа.Услуги);
	Результат = Запрос.ВыполнитьПакет();
#КонецОбласти 	
	СтруктураЗаказа.Шапка = Результат[2].Выгрузить();
	СтруктураЗаказа.Услуги = Результат[3].Выгрузить();
	
	СтруктураОтвета = Новый Структура("Сообщение, ГУИД", "", "");
	Попытка
		СчетОбъект = Документы.СчетНаОплатуПоставщика.СоздатьДокумент();
		СчетОбъект.Заполнить(СтруктураЗаказа);
		СчетОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Ссылка = СчетОбъект.Ссылка;
		СтруктураОтвета.ГУИД = Ссылка.УникальныйИдентификатор();
		СтруктураПоиска = Новый Структура("ДействиеПриОбмене, УзелОбмена, Объект", Перечисления.ДействияПриОбмене.ВыгрузкаДанных, Перечисления.УзлыОбмена.УППЗаказ, Ссылка);
		СтруктураДанных = Новый Структура("УИДИсточника, ПроведенВБУ, НомерДатаВБУ, Ответственный", СтруктураОтвета.ГУИД, Истина, СтруктураЗаказа.Шапка[0].НомерУПП + " от " + СтруктураЗаказа.Шапка[0].ДатаУПП, СтруктураЗаказа.Шапка[0].ОтветственныйНаименование);
		РегистрыСведений.ПротоколОбменов.ЗафиксироватьИнформациюОЗагрузке(СтруктураПоиска, СтруктураДанных, СтруктураОтвета.Сообщение);
	Исключение
		СтруктураОтвета.Сообщение = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат ОбщегоНазначения.ЗначениеВСтрокуXML(СтруктураОтвета);

КонецФункции // СоздатьСчетПоставщика()

//Евросиб Гудкова( 20.09.2020 Ticket№ 0207320
Функция СоздатьКДНаОстаток(XMLParams) Экспорт

	ТЗРезультат = Новый ТаблицаЗначений;	
	ТЗРезультат.Колонки.Добавить("ГУИДПП");
	ТЗРезультат.Колонки.Добавить("Комментарий");
	
	СтруктураДанных = ОбщегоНазначения.ЗначениеИзСтрокиXML(XMLParams);
	Организация = Справочники.Организации.НайтиПоКоду(СтруктураДанных.ОрганизацияКод);
	Ошибки = "";
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Ошибки = "Не найдена организация!";
				СтрокаТЗРезультата = ТЗРезультат.Добавить();
				СтрокаТЗРезультата.Комментарий = Ошибки;
				СтрокаТЗРезультата.ГУИДПП = СтруктураДанных.ТабТЧКД[0].ГУИДППУПП;
		Возврат ТЗРезультат;
	КонецЕсли; 
	
	СсылкаПП = РегистрыСведений.ПротоколОбменов.СсылкаПоУИД(СтруктураДанных.ГУИДППУПП, Перечисления.ДействияПриОбмене.ЗагрузкаДанных, Перечисления.УзлыОбмена.УПП);
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КорректировкаДолгаДебиторскаяЗадолженность.Ссылка КАК СсылкаКД,
	               |	КорректировкаДолгаДебиторскаяЗадолженность.Ссылка.Проведен КАК Проведен
	               |ИЗ
	               |	Документ.КорректировкаДолга.ДебиторскаяЗадолженность КАК КорректировкаДолгаДебиторскаяЗадолженность
	               |ГДЕ
	               |	КорректировкаДолгаДебиторскаяЗадолженность.Сделка = &Сделка";
	Запрос.УстановитьПараметр("Сделка", СсылкаПП);
	ТЗРез = Запрос.Выполнить().Выгрузить();
	Если ТЗРез.Количество() > 0 Тогда
		Если ТЗРез[0].Проведен Тогда
			СтрокаТЗРезультата = ТЗРезультат.Добавить();
			СтрокаТЗРезультата.ГУИДПП = СтруктураДанных.ГУИДППУПП;
			СтрокаТЗРезультата.Комментарий = "В Датакоре уже проведена " + ТЗРез[0].СсылкаКД + ". Повторная выгрузка невозможна.";
			Возврат ОбщегоНазначения.ЗначениеВСтрокуXML(ТЗРезультат);
		Иначе
			КДОбъект = ТЗРез[0].СсылкаКД.ПолучитьОбъект();
			КДОбъект.ПометкаУдаления = Ложь;
			КДОбъект.ДебиторскаяЗадолженность.Очистить();
			КДОбъект.КредиторскаяЗадолженность.Очистить();
		КонецЕсли;
	Иначе
		КДОбъект = Документы.КорректировкаДолга.СоздатьДокумент();
	КонецЕсли; 
	Отказ = Ложь;
		
	КДОбъект.Дата = Дата("20201001");
	ЗаполнитьЗначенияСвойств(КДОбъект, СсылкаПП, ,"Номер, Дата");
	КДОбъект.ВидОперации = Перечисления.ВидыОперацийКорректировкаДолга.ФормированиеЗадолженности;
	КДОбъект.КонтрагентДебитор = СсылкаПП.Контрагент;
	КДОбъект.КонтрагентКредитор = СсылкаПП.Контрагент;
	КДОбъект.Комментарий = "Загружено из УПП для остатка. " + СсылкаПП.Комментарий;
	КДОбъект.ВидАвансаЗадолженности = Перечисления.ВидыАвансаЗадолженности.АвансыПоставщику;
			
	НСтр = КДОбъект.ДебиторскаяЗадолженность.Добавить();
	ЗаполнитьЗначенияСвойств(НСтр, СсылкаПП.РасшифровкаПлатежа[0], "ДоговорКонтрагента, КурсВзаиморасчетов, КратностьВзаиморасчетов, СтавкаНДС");
	НСтр.ДатаВзаиморасчетов = СсылкаПП.ДатаВзаиморасчетов;
	НСтр.КорДоговорКонтрагента = НСтр.ДоговорКонтрагента;
	Нстр.Сумма = СтруктураДанных.ОстатокСумма;
	Нстр.СуммаВзаиморасчетов = НСтр.Сумма * Нстр.КурсВзаиморасчетов / Нстр.КратностьВзаиморасчетов;
	НСтр.НДСВключая = Истина;
	НСтр.Сделка = СсылкаПП;

	НачатьТранзакцию();
	Попытка
		КДОбъект.Записать(РежимЗаписиДокумента.Проведение);
		//добавляем историю в регистр загрузок
		//СтруктураПоиска = Новый Структура("ДействиеПриОбмене, УзелОбмена, Объект", Перечисления.ДействияПриОбмене.ЗагрузкаДанных, Перечисления.УзлыОбмена.УПП, ППСсылка);
		//СтруктураДанных = Новый Структура("УИДИсточника, НомерДатаВБУ, ПроведенВБУ, Ответственный", СтруктураДанных.ТабТЧКД[0].ГУИДППУПП,  СтруктураДанных.ТабТЧКД[0].НомерПП + " от " + СтруктураДанных.ТабТЧКД[0].ДатаПП, Истина, Пользователи.ТекущийПользователь());
		//РегистрыСведений.ПротоколОбменов.ЗафиксироватьИнформациюОЗагрузке(СтруктураПоиска, СтруктураДанных);
		
		ЗафиксироватьТранзакцию();
	Исключение
		Ошибки = Ошибки + "Не удалось записать документ " + ОписаниеОшибки();
		ОтменитьТранзакцию();
		Отказ = Истина;
	КонецПопытки;
		
	Если ЗначениеЗаполнено(Ошибки) Тогда
		СтрокаТЗРезультата = ТЗРезультат.Добавить();
		СтрокаТЗРезультата.ГУИДПП = СтруктураДанных.ТабТЧКД[0].ГУИДППУПП;
		СтрокаТЗРезультата.Комментарий = Ошибки;
	КонецЕсли;
		
	Возврат ОбщегоНазначения.ЗначениеВСтрокуXML(ТЗРезультат);
	
КонецФункции // СоздатьКДНаОстаток()
 
// Евросиб Гудкова))

