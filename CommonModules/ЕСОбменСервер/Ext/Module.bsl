Функция ВыгрузитьКалькуляции(ИмяУзла, ДатаНачала, ДатаОкончания) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ИмяУзла) Тогда
		Возврат "<xml><error>Пустое значение параметра RequestingSystem!</error></xml>";
	КонецЕсли;  
	
	УзелОбмена = Неопределено;
	Для каждого ЗначПеречисления Из Метаданные.Перечисления.УзлыОбмена.ЗначенияПеречисления Цикл
		Если ЗначПеречисления.Имя = ИмяУзла Тогда
			УзелОбмена = Перечисления.УзлыОбмена[ЗначПеречисления.Имя];  
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	
	Если УзелОбмена = Неопределено Тогда
		Возврат "<xml><error>Не найден узел обмена по входному параметру RequestingSystem!</error></xml>";
	КонецЕсли;
	
	//Евросиб Каблов 20.05.2025 ( #110106
	НастройкаОбмена = Справочники.НастройкиОбменов.ПолучитьНастройкуОбмена(УзелОбмена, "GetCalculation");
	
	КоличествоЗаписейВПорцииДанных = НастройкаОбмена.КоличествоЗаписейВПорцииДанных;
	Если ЗначениеЗаполнено(КоличествоЗаписейВПорцииДанных) Тогда
		КоличествоЗаписейВПорцииДанныхПлюсОдин = КоличествоЗаписейВПорцииДанных + 1;
		ТекстОграниченияПорции = СтрШаблон("ПЕРВЫЕ %1", Формат(КоличествоЗаписейВПорцииДанныхПлюсОдин, "ЧГ=0"));
	Иначе
		ТекстОграниченияПорции = "";
	КонецЕсли;
	//Евросиб Каблов 20.05.2025 )
	
	ВремяВыгрузки = ТекущаяДата();
	
	Запрос = Новый Запрос;
	Если ЗначениеЗаполнено(ДатаНачала) и ЗначениеЗаполнено(ДатаОкончания) Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 11
		|	Калькуляция.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_УникальныеКалькуляции
		|ИЗ
		|	Документ.Калькуляция КАК Калькуляция
		|ГДЕ
		|	Калькуляция.Проведен
		|	И Калькуляция.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания";
		Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
		
	Иначе
		
		УзлыПланаОбмена = ПланыОбмена.ВыгрузкаДанных.ПолучитьУзелОбмена(УзелОбмена);
		Если Не ЗначениеЗаполнено(УзлыПланаОбмена) Тогда
			Возврат "<xml><error>Не настроен узел плана обмена по входному параметру RequestingSystem!</error></xml>";
		КонецЕсли;
		
		УзелПланаОбмена = УзлыПланаОбмена[0];
				
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 11
		|	КалькуляцияИзменения.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_УникальныеКалькуляции
		|ИЗ
		|	Документ.Калькуляция.Изменения КАК КалькуляцияИзменения
		|ГДЕ
		|	КалькуляцияИзменения.Ссылка.Проведен
		|	И КалькуляцияИзменения.Узел = &УзелПланаОбмена";
		Запрос.УстановитьПараметр("УзелПланаОбмена", УзелПланаОбмена);
		
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + "
	|;";
	
	Запрос.Текст = Запрос.Текст + 
	"ВЫБРАТЬ
	|	ВТ_УникальныеКалькуляции.Ссылка КАК СсылкаКалькуляции,
	|	КалькуляцияСписокСтанцийОтправления.Станция КАК Локация
	|ИЗ
	|	ВТ_УникальныеКалькуляции КАК ВТ_УникальныеКалькуляции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Калькуляция.СписокСтанцийОтправления КАК КалькуляцияСписокСтанцийОтправления
	|		ПО ВТ_УникальныеКалькуляции.Ссылка = КалькуляцияСписокСтанцийОтправления.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_УникальныеКалькуляции.Ссылка,
	|	КалькуляцияСписокСтанцийОтправления.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_УникальныеКалькуляции.Ссылка КАК СсылкаКалькуляции,
