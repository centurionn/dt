				Вагон = НовыйВагонОбъект.Ссылка;
//Евросиб Гудкова( 06.10.2020 
			ИначеЕсли Вагон.ПометкаУдаления Тогда
				ВагонОбъект = Вагон.ПолучитьОбъект();
				ВагонОбъект.УстановитьПометкуУдаления(Ложь);
