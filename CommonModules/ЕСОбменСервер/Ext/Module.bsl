Процедура ЗаписатьРемонты(ОбъектXDTO, МассивОшибок, ЭтоТест)
	
	ЕстьОшибка = Ложь; // Евросиб Фролов, 24.02.2022
	
	СписокОбязательныхПолей = Новый СписокЗначений;
	СписокОбязательныхПолей.Добавить("carNum");
	СписокОбязательныхПолей.Добавить("rpDoc23_No");
	СписокОбязательныхПолей.Добавить("rpDT_put");
	Для каждого ЗначениеРеквизита Из СписокОбязательныхПолей Цикл
		Если ОбъектXDTO.Свойства().Получить(ЗначениеРеквизита.Значение) = Неопределено Тогда
			МассивОшибок.Добавить("В одной из ВУ не заполнено обязательное поле " + ЗначениеРеквизита.Значение);
			ЕстьОшибка = Истина; // Евросиб Фролов, 24.02.2022
		КонецЕсли;
	КонецЦикла; 
	Если ОбъектXDTO.Свойства().Получить("carNum") <> Неопределено Тогда 
		Вагон = Справочники.ТС.НайтиПоНаименованию(ОбъектXDTO.carNum, Истина); 	
		Если Вагон.Пустая() Тогда
			Если ЭтоТест Тогда
				ВагонОбъект = Справочники.ТС.СоздатьЭлемент();
				ВагонОбъект.Наименование = ОбъектXDTO.carNum;
				ВагонОбъект.Записать();
				Вагон = ВагонОбъект.Ссылка;
			Иначе
				МассивОшибок.Добавить("В справочнике ТС не найден вагон с номером " + ОбъектXDTO.carNum);
				ЕстьОшибка = Истина; // Евросиб Фролов, 24.02.2022
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	// Евросиб Фролов, 24.02.2022 (Яна просила исправить ошибку)
	// Если при загрузке появилась ошибка, то нужно прервать выполнение процедуры.
	// Файл при этом перемещается в каталог ошибочных. Возврат был закомментирован и
	// из-за этого при выполнении процедуры появлялась ошибка в момент установки параметров
	// запроса "ОбъектXDTO.rpDoc23_No". Раскомментировал.
	//Если МассивОшибок.Количество() > 0 Тогда
	Если ЕстьОшибка Тогда // Евросиб Фролов, 24.02.2022
		Возврат;
	КонецЕсли;
	ДатаПереводаВНерабочийПарк = XMLЗначение(Тип("Дата"), ОбъектXDTO.rpDT_put);
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	РемонтныеВедомости.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.РемонтныеВедомости КАК РемонтныеВедомости
	               |ГДЕ
	               |	РемонтныеВедомости.НомерВУ23 = &НомерВУ23
	               |	И РемонтныеВедомости.ДатаПереводаВНерабочийПарк = &ДатаПереводаВНерабочийПарк
	               |	И РемонтныеВедомости.Вагон = &Вагон";
	Запрос.УстановитьПараметр("НомерВУ23", ОбъектXDTO.rpDoc23_No);
	Запрос.УстановитьПараметр("ДатаПереводаВНерабочийПарк", ДатаПереводаВНерабочийПарк);
	Запрос.УстановитьПараметр("Вагон", Вагон);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		РемонтнаяВедомость = Результат.Ссылка.ПолучитьОбъект();
		РемонтнаяВедомость.Неисправности.Очистить();
		РемонтнаяВедомость.ПроведенныеРаботы.Очистить();
		РемонтнаяВедомость.Комментарий = "";
	Иначе
		РемонтнаяВедомость = Документы.РемонтныеВедомости.СоздатьДокумент();
		РемонтнаяВедомость.Заполнить(неопределено); // Иван 15.08.19
		РемонтнаяВедомость.РежимРемонтнойВедомости = Перечисления.РежимРемонтнойВедомости.ЗагруженаАвтоматически; // Иван 15.08.19
	КонецЕсли; 	
	
	РемонтнаяВедомость.НомерВУ23 = ОбъектXDTO.rpDoc23_No;
	РемонтнаяВедомость.ДатаПереводаВНерабочийПарк = ДатаПереводаВНерабочийПарк;
	РемонтнаяВедомость.Вагон = Вагон;
	
	Если ОбъектXDTO.Свойства().Получить("rpRepType") <> Неопределено Тогда
		РемонтнаяВедомость.ВидРемонта = Перечисления.ВидыРемонтов.Получить(Число(ОбъектXDTO.rpRepType) - 1);
	КонецЕсли;
	Если ОбъектXDTO.Свойства().Получить("stCode") <> Неопределено Тогда
		РемонтнаяВедомость.СтанцияОтцепки = ЛокацияПоКодуСтанции(ОбъектXDTO.stCode);
		Если Не ЗначениеЗаполнено(РемонтнаяВедомость.СтанцияОтцепки) Тогда
			РемонтнаяВедомость.Комментарий = "Код станции отцепки: " + ОбъектXDTO.stCode;
		КонецЕсли; 
	КонецЕсли;
	Если ОбъектXDTO.Свойства().Получить("rwCode") <> Неопределено Тогда
		РемонтнаяВедомость.ДорогаПереводаВНерабочийПарк = Справочники.ЖелезныеДороги.НайтиПоКоду(ОбъектXDTO.rwCode);
		Если Не ЗначениеЗаполнено(РемонтнаяВедомость.ДорогаПереводаВНерабочийПарк) Тогда
			РемонтнаяВедомость.Комментарий = РемонтнаяВедомость.Комментарий + " Код дороги: " + ОбъектXDTO.rwCode;
		КонецЕсли; 
	КонецЕсли;
	Если ОбъектXDTO.Свойства().Получить("shCode") <> Неопределено Тогда
		РемонтнаяВедомость.ДепоРемонта = Справочники.Депо.НайтиПоКоду(ОбъектXDTO.shCode);
		Если Не ЗначениеЗаполнено(РемонтнаяВедомость.ДепоРемонта) Тогда
			РемонтнаяВедомость.Комментарий = РемонтнаяВедомость.Комментарий + " Депо ремонта: " + ОбъектXDTO.shCode;
		КонецЕсли; 
	КонецЕсли;
	Если ОбъектXDTO.Свойства().Получить("flCode1") <> Неопределено Тогда
		НоваяСтрока = РемонтнаяВедомость.Неисправности.Добавить();
		НоваяСтрока.ПричинаНеисправности = Справочники.ПричиныНеисправностейТС.НайтиПоКоду(ОбъектXDTO.flCode1);
		НоваяСтрока.КодПричиныНеисправности = ОбъектXDTO.flCode1;
	КонецЕсли;
	Если ОбъектXDTO.Свойства().Получить("flCode2") <> Неопределено Тогда
		НоваяСтрока = РемонтнаяВедомость.Неисправности.Добавить();
		НоваяСтрока.ПричинаНеисправности = Справочники.ПричиныНеисправностейТС.НайтиПоКоду(ОбъектXDTO.flCode2);
		НоваяСтрока.КодПричиныНеисправности = ОбъектXDTO.flCode2;
	КонецЕсли;
	Если ОбъектXDTO.Свойства().Получить("flCode3") <> Неопределено Тогда
		НоваяСтрока = РемонтнаяВедомость.Неисправности.Добавить();
		НоваяСтрока.ПричинаНеисправности = Справочники.ПричиныНеисправностейТС.НайтиПоКоду(ОбъектXDTO.flCode3);
		НоваяСтрока.КодПричиныНеисправности = ОбъектXDTO.flCode3;
	КонецЕсли;
	Если ОбъектXDTO.Свойства().Получить("productionDate") <> Неопределено Тогда
		РемонтнаяВедомость.ДатаПостройки = XMLЗначение(Тип("Дата"), ОбъектXDTO.productionDate);
	КонецЕсли;
	Если ОбъектXDTO.Свойства().Получить("depoDep") <> Неопределено Тогда
		РемонтнаяВедомость.ДепоДеповскогоРемонта = Справочники.Депо.НайтиПоКоду(ОбъектXDTO.depoDep);
		Если Не ЗначениеЗаполнено(РемонтнаяВедомость.ДепоДеповскогоРемонта) Тогда
			РемонтнаяВедомость.Комментарий = РемонтнаяВедомость.Комментарий + " Депо деповского ремонта: " + ОбъектXDTO.depoDep;
		КонецЕсли; 
	КонецЕсли;
	Если ОбъектXDTO.Свойства().Получить("lastDepotRepairDate") <> Неопределено Тогда
		РемонтнаяВедомость.ДатаДеповскогоРемонта = XMLЗначение(Тип("Дата"), ОбъектXDTO.lastDepotRepairDate);
	КонецЕсли;
	Если ОбъектXDTO.Свойства().Получить("depoCap") <> Неопределено Тогда
		РемонтнаяВедомость.ДепоКапитальногоРемонта = Справочники.Депо.НайтиПоКоду(ОбъектXDTO.depoCap);
		Если Не ЗначениеЗаполнено(РемонтнаяВедомость.ДепоКапитальногоРемонта) Тогда
			РемонтнаяВедомость.Комментарий = РемонтнаяВедомость.Комментарий + " Депо кап. ремонта: " + ОбъектXDTO.depoCap;
		КонецЕсли; 
	КонецЕсли;
	Если ОбъектXDTO.Свойства().Получить("lastCapitalRepairDate") <> Неопределено Тогда
		РемонтнаяВедомость.ДатаКапитальногоРемонта = XMLЗначение(Тип("Дата"), ОбъектXDTO.lastCapitalRepairDate);
	КонецЕсли;
	Если ОбъектXDTO.Свойства().Получить("rpDoc36_No") <> Неопределено Тогда
		РемонтнаяВедомость.НомерВУ36 = ОбъектXDTO.rpDoc36_No;
	КонецЕсли;
	Если ОбъектXDTO.Свойства().Получить("rpDT_Start") <> Неопределено Тогда
		РемонтнаяВедомость.ДатаНачалаРемонта = XMLЗначение(Тип("Дата"), ОбъектXDTO.rpDT_Start);
	КонецЕсли;
	Если ОбъектXDTO.Свойства().Получить("rpDT_End") <> Неопределено Тогда
		РемонтнаяВедомость.ДатаОкончанияРемонта = XMLЗначение(Тип("Дата"), ОбъектXDTO.rpDT_End);
	КонецЕсли;
	Если ОбъектXDTO.Свойства().Получить("moderRem") <> Неопределено Тогда
		МассивРабот = новый Массив;
		Строкаработ = СокрЛП(ОбъектXDTO.moderRem);
		Пока ЗначениеЗаполнено(Строкаработ) Цикл
			Если Лев(Строкаработ, 4) <> "0000" Тогда
				МассивРабот.Добавить(Лев(Строкаработ, 4));
			КонецЕсли; 
			Строкаработ = Сред(Строкаработ, 5);
		КонецЦикла;
		МассивРаботБезПовторов = Новый Массив;
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивРаботБезПовторов, МассивРабот, Истина);
		Для каждого Работа Из МассивРаботБезПовторов Цикл
			НоваяСтрокаРабот = РемонтнаяВедомость.ПроведенныеРаботы.Добавить();
			НоваяСтрокаРабот.КодРаботы = Работа;
			НоваяСтрокаРабот.Работа = Справочники.ПроведенныеРемонтныеРаботы.НайтиПоКоду(Работа);
		КонецЦикла; 
	КонецЕсли;
	Если ОбъектXDTO.Свойства().Получить("psCarTState") <> Неопределено Тогда
		РемонтнаяВедомость.ВРемонте = ?(ОбъектXDTO.psCarTState = "R", Истина, Ложь);
	КонецЕсли;
	РемонтнаяВедомость.Дата = ДатаПереводаВНерабочийПарк;
	Попытка
		РемонтнаяВедомость.Записать();
	Исключение
		МассивОшибок.Добавить(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

// Евросиб Фролов (21.10.2021 Ticket№ 0243986
// Для вагонной дислокации локация теперь ищется не только по коду станции, но и по коду дороги.
//Функция ЛокацияПоКодуСтанции(КодЖДСтанции)
Функция ЛокацияПоКодуСтанции(КодЖДСтанции, КодДороги = Неопределено)
// Евросиб Фролов)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Локации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Локации КАК Локации
	|ГДЕ
	|	Локации.КодЖДСтанции ПОДОБНО &КодЖДСтанции";
	
	// Евросиб Фролов (21.10.2021 Ticket№ 0243986
	// Если передан параметр "КодДороги", то поиск выполняется для вагонной дислокации.
	// Для вагонной дислокации к поиску по коду станции добавляется поиск по коду дороги.
	// Если локация с необходимым кодом станции и дороги не найдена,
	// то пытаемся искать просто по коду станции, т.к. возможно, что такая станция была создана
	// в системе, но код дороги указан неверно.
	Если КодДороги <> Неопределено Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Локации.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ втЛокации
		|ИЗ
		|	Справочник.Локации КАК Локации
		|ГДЕ
		|	Локации.КодЖДСтанции ПОДОБНО &КодЖДСтанции
		|	И Локации.ЖелезнаяДорога.Код ПОДОБНО &КодДороги
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	Локации.Ссылка
		|ИЗ
		|	Справочник.Локации КАК Локации
		|ГДЕ
		|	Локации.КодЖДСтанции ПОДОБНО &КодЖДСтанции
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	втЛокации.Ссылка КАК Ссылка
		|ИЗ
		|	втЛокации КАК втЛокации
		|УПОРЯДОЧИТЬ ПО
		|	втЛокации.Ссылка.ЖелезнаяДорога.Код УБЫВ";
		
		Запрос.УстановитьПараметр("КодДороги", КодДороги + "%");
	КонецЕсли;	
	// Евросиб Фролов
	
	Запрос.УстановитьПараметр("КодЖДСтанции", ""+КодЖДСтанции+"%");	 // Иван. 25-09-19. Фоновое задание выдавало ошибку, я переписал этот кусок, перенес % из запроса в параметр
	Выборка = Запрос.Выполнить().Выбрать();	
	Если Выборка.Следующий() Тогда
		Локация = Выборка.Ссылка;
	Иначе
		Локация = Неопределено;
	КонецЕсли;
	
	Возврат Локация;
	
КонецФункции

Процедура ЗагрузитьСпискиНаСлеженииВагоновКонтейнеров(ЭтоТест = Ложь) Экспорт

	ЭтоТест = ЭтоТест или ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована;
	МассивФайлов = НайтиФайлы(Константы.КаталогДислокацииРФ.Получить() + "\Дислокации для загрузки в DC\" + "Список на слежении", "*.xml");
	СписокФайлов = Новый СписокЗначений;
	Для Каждого Файл Из МассивФайлов Цикл
		СписокФайлов.Добавить(Файл, Файл.ИмяБезРасширения);		
	КонецЦикла;
	СписокФайлов.СортироватьПоПредставлению();
	
	Для Каждого Файл Из СписокФайлов Цикл
		МассивОшибок = Новый Массив;
		Отказ = Ложь;
		
		Чтение = Новый ЧтениеXML;
		Чтение.ОткрытьФайл(Файл.Значение.ПолноеИмя);
		КорневойОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(Чтение);
		Чтение.Закрыть();
		
		Если Найти(Файл.Значение.Имя, "DataCore_TRACKITEM_WAG") > 0 Тогда
			
			ТаблицаВагонов = Новый ТаблицаЗначений;
			ТаблицаВагонов.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(10, ДопустимаяДлина.Переменная)));
	
			Если ТипЗнч(КорневойОбъектXDTO.ROW) = Тип("СписокXDTO") Тогда				
				Для Каждого Элемент Из КорневойОбъектXDTO.ROW Цикл
					Номер = Элемент.VAG_NUMBER;
					Если ЗначениеЗаполнено(Номер) Тогда
						Вагон = ТаблицаВагонов.Добавить();
						Вагон.Номер = Номер;
					КонецЕсли;
				КонецЦикла;				
			ИначеЕсли ТипЗнч(КорневойОбъектXDTO.ROW) = Тип("ОбъектXDTO") Тогда
				Элемент = КорневойОбъектXDTO;
				Номер = Элемент.VAG_NUMBER;
				Если ЗначениеЗаполнено(Номер) Тогда
					Вагон = ТаблицаВагонов.Добавить();
					Вагон.Номер = Номер;
				КонецЕсли;
			КонецЕсли;
			
			ЗагрузитьСписокВагоновНаСлежении(ТаблицаВагонов);
			
			Если НЕ ЭтоТест Тогда
				ПереместитьФайл(Файл.Значение.ПолноеИмя, Константы.КаталогДислокацииРФ.Получить() +"\Дислокации для загрузки в DC\Обработанные файлы\Успешно\" + Файл.Значение.Имя);
			КонецЕсли;
			
		ИначеЕсли Найти(Файл.Значение.Имя, "DataCore_TRACKITEM_CONT") > 0 Тогда
			
			ТаблицаКонтейнеров = Новый ТаблицаЗначений;
			ТаблицаКонтейнеров.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(6, ДопустимаяДлина.Переменная)));
			ТаблицаКонтейнеров.Колонки.Добавить("Префикс", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(6, ДопустимаяДлина.Переменная)));
			ТаблицаКонтейнеров.Колонки.Добавить("КонтрольноеЧисло", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(1, 0, ДопустимыйЗнак.Неотрицательный)));
			ТаблицаКонтейнеров.Колонки.Добавить("Тип", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(10, ДопустимаяДлина.Переменная)));
			
			Если ТипЗнч(КорневойОбъектXDTO.ROW) = Тип("СписокXDTO") Тогда				
				
				Для Каждого Элемент Из КорневойОбъектXDTO.ROW Цикл
					
					Номер = Элемент.CONT_NUMBER;					
					Если ЗначениеЗаполнено(Номер) Тогда
						
						Контейнер = ТаблицаКонтейнеров.Добавить();
						Контейнер.Номер = Номер;
						
						Если Элемент.Свойства().Получить("CONT_SER") <> Неопределено Тогда
							Контейнер.Префикс = Элемент.CONT_SER;
						КонецЕсли;
						
						Если Элемент.Свойства().Получить("CONT_NUMBER_KEY") <> Неопределено Тогда
							Контейнер.КонтрольноеЧисло = Элемент.CONT_NUMBER_KEY;
						КонецЕсли;
						
						Если Элемент.Свойства().Получить("CONT_TYPE") <> Неопределено Тогда
							Контейнер.Тип = Элемент.CONT_TYPE;
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
				
			ИначеЕсли ТипЗнч(КорневойОбъектXDTO.ROW) = Тип("ОбъектXDTO") Тогда
				
				Элемент = КорневойОбъектXDTO;
				Номер = Элемент.CONT_NUMBER;					
				Если ЗначениеЗаполнено(Номер) Тогда
					
					Контейнер = ТаблицаКонтейнеров.Добавить();
					Контейнер.Номер = Номер;
					
					Если Элемент.Свойства().Получить("CONT_SER") <> Неопределено Тогда
						Контейнер.Префикс = Элемент.CONT_SER;
					КонецЕсли;
					
					Если Элемент.Свойства().Получить("CONT_NUMBER_KEY") <> Неопределено Тогда
						Контейнер.КонтрольноеЧисло = Элемент.CONT_NUMBER_KEY;
					КонецЕсли;
					
					Если Элемент.Свойства().Получить("CONT_TYPE") <> Неопределено Тогда
						Контейнер.Тип = Элемент.CONT_TYPE;
					КонецЕсли;
					
				КонецЕсли;
					
			КонецЕсли;
			
			ЗагрузитьСписокКонтейнеровНаСлежении(ТаблицаКонтейнеров, ЭтоТест);
			
			Если НЕ ЭтоТест Тогда
				ПереместитьФайл(Файл.Значение.ПолноеИмя, Константы.КаталогДислокацииРФ.Получить() +"\Дислокации для загрузки в DC\Обработанные файлы\Успешно\" + Файл.Значение.Имя); 
			КонецЕсли;
			
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры // ЗагрузитьСписокНаСлежении()

Процедура ЗагрузитьСписокВагоновНаСлежении(ТаблицаВагонов)
	
	ДатаЗаписей = НачалоДня(ТекущаяДатаСеанса());
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаВагонов", ТаблицаВагонов);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаВагонов.Номер КАК Номер
	|ПОМЕСТИТЬ ВТНомераВагонов
	|ИЗ
	|	&ТаблицаВагонов КАК ТаблицаВагонов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТНомераВагонов.Номер КАК Номер,
	|	ТС.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТВагоны
	|ИЗ
	|	ВТНомераВагонов КАК ВТНомераВагонов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТС КАК ТС
	|		ПО ВТНомераВагонов.Номер = ТС.Наименование
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПризнакСобственностиВагонаСрезПоследних.Вагон КАК Вагон,
	|	ПризнакСобственностиВагонаСрезПоследних.ВЭксплуатации КАК ВЭксплуатации
	|ПОМЕСТИТЬ ВТПризнакиСобственности
	|ИЗ
	|	РегистрСведений.ПризнакСобственностиВагона.СрезПоследних(
	|			,
	|			Вагон В
	|				(ВЫБРАТЬ
	|					Вагоны.Ссылка
	|				ИЗ
	|					ВТВагоны КАК Вагоны
	|				ГДЕ
	|					НЕ Вагоны.Ссылка ЕСТЬ NULL)) КАК ПризнакСобственностиВагонаСрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Вагон
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВагоныНаСлеженииСрезПоследних.Вагон КАК Вагон,
	|	ВагоныНаСлеженииСрезПоследних.НаСлежении КАК НаСлежении
	|ПОМЕСТИТЬ ВТВагоныНаСлежении
	|ИЗ
	|	РегистрСведений.ВагоныНаСлежении.СрезПоследних КАК ВагоныНаСлеженииСрезПоследних
	|ГДЕ
	|	ВагоныНаСлеженииСрезПоследних.НаСлежении
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Вагон
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТВагоны.Номер КАК Номер,
	|	ВТВагоны.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(ВТПризнакиСобственности.ВЭксплуатации, ЛОЖЬ) КАК ВЭксплуатации,
	|	ЕСТЬNULL(ВТВагоныНаСлежении.НаСлежении, ЛОЖЬ) КАК НаСлежении,
	|	ЛОЖЬ КАК СнятьПризнакНаСлежении
	|ИЗ
	|	ВТВагоны КАК ВТВагоны
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПризнакиСобственности КАК ВТПризнакиСобственности
	|		ПО ВТВагоны.Ссылка = ВТПризнакиСобственности.Вагон
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТВагоныНаСлежении КАК ВТВагоныНаСлежении
	|		ПО ВТВагоны.Ссылка = ВТВагоныНаСлежении.Вагон
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	NULL,
	|	ВТВагоныНаСлежении.Вагон,
	|	NULL,
	|	NULL,
	|	ИСТИНА
	|ИЗ
	|	ВТВагоныНаСлежении КАК ВТВагоныНаСлежении
	|ГДЕ
	|	НЕ ВТВагоныНаСлежении.Вагон В
	|				(ВЫБРАТЬ
	|					Вагоны.Ссылка
	|				ИЗ
	|					ВТВагоны КАК Вагоны
	|				ГДЕ
	|					НЕ Вагоны.Ссылка ЕСТЬ NULL)";
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
