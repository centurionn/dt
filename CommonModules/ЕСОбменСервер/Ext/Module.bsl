	КонецЕсли;
	//ЗаполнитьЗначениеВТаблицу(ТекущийВладелец, ТекущееСвойство, ТаблицаДополнительнойИнформации);
	Если ТипЗнч(Менеджеры.Менеджер) = Тип("СписокXDTO") Тогда
