Функция ПолучитьДанныеЧерезМакетСКД(МакетСКД, Параметры, СписокОтборов="",ВыводВДерево = Ложь, ВыводимыеПоля = Неопределено) Экспорт

	МассивСписокОтборов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СписокОтборов);
	СхемаКомпоновкиДанных = Справочники.Макеты.ПолучитьМакет(МакетСКД);
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	КомпоновкаДанныхКлиентСервер.УстановитьКоллекциюПараметров(Настройки, Параметры);
	Для каждого элОтбор Из МассивСписокОтборов Цикл
		Если Параметры.Свойство(элОтбор) И ЗначениеЗаполнено(Параметры[элОтбор]) Тогда
			КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(Настройки, элОтбор, Параметры[элОтбор], ВидСравненияКомпоновкиДанных.Равно);
		КонецЕсли; 
	КонецЦикла; 
	//Если Параметры.Свойство("УИДКонтрагента") И ЗначениеЗаполнено(Параметры.УИДКонтрагента) Тогда
	//	КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(Настройки, "УИДКонтрагента", Параметры.УИДКонтрагента, ВидСравненияКомпоновкиДанных.Равно);
	//КонецЕсли; 
	//Если Параметры.Свойство("УИДДоговораКонтрагента") И ЗначениеЗаполнено(Параметры.УИДДоговораКонтрагента) Тогда
	//	КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(Настройки, "УИДДоговора", Параметры.УИДДоговораКонтрагента, ВидСравненияКомпоновкиДанных.Равно);
	//КонецЕсли;          
	//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 107705 Начало 20.05.2025
	Если ВыводимыеПоля <> Неопределено Тогда
		КомпоновкаДанныхКлиентСервер.УстановитьВыбранныеПоляКомпоновкиДанных(Настройки, ВыводимыеПоля);	
	КонецЕсли;
	//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 107705 Конец 20.05.2025
	МакетКомпоновкиДанных = КомпоновкаДанныхСервер.ПолучитьМакетКомпоновки(СхемаКомпоновкиДанных, Настройки);
	Результат = КомпоновкаДанныхСервер.ВыгрузитьРезультатСКД(СхемаКомпоновкиДанных, Настройки,,ВыводВДерево);
	Возврат Результат;
	
КонецФункции
 
Функция ПолучитьЗначениеПоляОбъектаXDTOПоИмени(ОбъектXDTO, ИмяПоля, ТипЗначения = Неопределено, ПустоеЗначение = Неопределено)
	
	Если ОбъектXDTO.Свойства().Получить(ИмяПоля) <> Неопределено Тогда
		ПолеОбъекта = ОбъектXDTO[ИмяПоля];
	Иначе
		ПолеОбъекта = ПустоеЗначение;
	КонецЕсли;
		
	Если ТипЗнч(ПолеОбъекта) = Тип("ОбъектXDTO") Тогда
		ЗначениеПоля = ПустоеЗначение;
	ИначеЕсли ТипЗначения <> Неопределено Тогда
		Попытка
			ЗначениеПоля = XMLЗначение(ТипЗначения, ПолеОбъекта);
		Исключение
			Если ТипЗначения = Тип("Дата") И ТипЗнч(ПолеОбъекта) = Тип("Строка") Тогда
				Если СтрДлина(ПолеОбъекта) = 17 Тогда
					СтрокаДаты = СтрЗаменить(ПолеОбъекта, " ", "");
					СтрокаДаты = СтрЗаменить(СтрокаДаты, ":", "");
					ОписаниеТипа = Новый ОписаниеТипов("Дата");
					ЗначениеПоля = ОписаниеТипа.ПривестиЗначение(СтрокаДаты);
				КонецЕсли;			
			КонецЕсли;
		КонецПопытки;
	Иначе
		ЗначениеПоля = ПолеОбъекта;
	КонецЕсли;
	
	Возврат ЗначениеПоля;
	
КонецФункции

//Евросиб Каблов 12.10.2022 58752
Процедура СкопироватьДеровоВТаблицу(Дерево, Таблица) Экспорт
	
	СкопированныеСсылки = Новый Массив;
	Для Каждого СтрокаДерева Из Дерево.Строки Цикл
		
		Если ЗначениеЗаполнено(СтрокаДерева.ЭтоГруппа) И СкопированныеСсылки.Найти(СтрокаДерева.Ссылка) = Неопределено Тогда
			СтрокаТаблицы = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаДерева);
			СкопированныеСсылки.Добавить(СтрокаДерева.Ссылка);
		КонецЕсли;
		
		Если СтрокаДерева.Строки.Количество() Тогда
			СкопироватьСтрокиДереваВТаблицу(СтрокаДерева, Таблица);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

//Евросиб Каблов 12.10.2022 58752
Процедура СкопироватьСтрокиДереваВТаблицу(Группа, Таблица) Экспорт
	
	Для Каждого СтрокаДерева Из Группа.Строки Цикл
		
		Если СтрокаДерева.Ссылка = Группа.Ссылка Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаДерева);
		
		Если СтрокаДерева.ЭтоГруппа Тогда
			СкопироватьСтрокиДереваВТаблицу(СтрокаДерева, Таблица);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

