Функция ЗаписатьТаблицуВXML(Таблица, ИмяТаблицы = Неопределено) Экспорт
	
	ТипТаблицаЗначений = Тип("ТаблицаЗначений");
	
	Если Не ЗначениеЗаполнено(ИмяТаблицы) Тогда
		ИмяТаблицы = "Таблица";
	КонецЕсли;
	
	Запись = Новый ЗаписьXML();
	Запись.УстановитьСтроку();
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьНачалоЭлемента(ИмяТаблицы);
	Для каждого СтрокаТаблицы из Таблица Цикл
		Запись.ЗаписатьНачалоЭлемента("СтрокаТаблицы");
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Если ТипЗнч(СтрокаТаблицы[Колонка.Имя]) = ТипТаблицаЗначений Тогда
				ДобавитьТаблицуВXML(Запись, СтрокаТаблицы[Колонка.Имя], Колонка.Имя);
			Иначе
				Запись.ЗаписатьАтрибут(Колонка.Имя, XMLСтрока(СтрокаТаблицы[Колонка.Имя]));
			КонецЕсли;
		КонецЦикла;
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	СтрокаXML = Запись.Закрыть();
	Возврат СтрокаXML;
	
КонецФункции

