			//РеквизитыПСЦ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументПСЦ, 
			//"Автор,ОтветственныйМенеджер,Договор,НачалоДействия,ОкончаниеДействия,ДействуетДоСогласованияНовыхУсловий,ПСЦПоставщика,НомерПСЦ,ДатаПСЦ,ПодписанСДвухСторон,НетиповойПротокол");
			Если ТипЗнч(ДокументПСЦ) = Тип("ДокументСсылка.ПСЦПоставщика") Тогда
				РеквизитыПСЦ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументПСЦ, 
