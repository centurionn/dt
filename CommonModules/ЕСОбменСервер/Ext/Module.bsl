	// ДИТ BUG 79699 ТА 81720 Сержантова А.С. Конец: 04.03.2024
		
	Для каждого СтрДокумента Из СписокДокументовПСЦ Цикл
		
		Попытка
			
			ДокументПСЦ = СтрДокумента.Ссылка; 
			// ДИТ BUG 79699 ТА 81720 Сержантова А.С. Начало: 04.04.2024
