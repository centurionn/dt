Функция ВыгрузитьКЗПвУПП(МассивСсылок, ТипДокументов) Экспорт
	
	//ГУИД = Новый Массив;
	//Для Каждого Ссылка Из МассивСсылок Цикл
	//	ГУИД.Добавить(Ссылка.УникальныйИдентификатор());
	//КонецЦикла;
	//
	Прокси = ВебСервисы_сервер.ПолучитьПрокси("ВебСервисЗаказовУПП");
	//XMLParams = ЕСОбменСервер.ПередатьДанныеПоЗаявкеНаОплатуДляЗаказа(ОбщегоНазначения.ЗначениеВСтрокуXML(ГУИД));  
	XMLParams = ЕСОбменСервер.ПередатьДанныеПоКорректировкеЗаказаПоставщику(МассивСсылок);
	ОтветУПП = Прокси.SubmitOrderChanges(XMLParams);
	ТаблицаОтвета = ОбщегоНазначения.ЗначениеИзСтрокиXML(ОтветУПП);
	
	Для Каждого СтрокаОтвета Из ТаблицаОтвета Цикл
		Если ЗначениеЗаполнено(СтрокаОтвета.Комментарий) Тогда
			ОбщегоНазначения.СообщитьПользователю("Документ не выгружен. Ошибки: " + СтрокаОтвета.Комментарий);			
			СсылкаФиксации = Справочники.ФиксацияИзмененийСчетаПоступления.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаОтвета.ГУИД));			
			РегистрыСведений.ОшибкиПриОбменах.ЗафиксироватьОшибку(СсылкаФиксации, Перечисления.УзлыОбмена.УППЗаказ, СтрокаОтвета.Комментарий);
		Иначе	
			СсылкаФиксации = Справочники.ФиксацияИзмененийСчетаПоступления.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаОтвета.ГУИД));
			СтруктураПоиска = Новый Структура("ДействиеПриОбмене, УзелОбмена, Объект", Перечисления.ДействияПриОбмене.ВыгрузкаДанных, 
			Перечисления.УзлыОбмена.УППЗаказ, СсылкаФиксации);
			СтруктураДанных = Новый Структура("УИДИсточника, Ответственный, НомерДатаВБУ, Статус",
							  СтрокаОтвета.СсылкаВходящегоДокумента,  Пользователи.АвторизованныйПользователь(), СтрокаОтвета.ПредставлениеЗаказаПоставщику, СтрокаОтвета.Статус);
			Сообщение = РегистрыСведений.ПротоколОбменов.ЗафиксироватьИнформациюОЗагрузке(СтруктураПоиска, СтруктураДанных, "Создана КЗП " + СтрокаОтвета.ПредставлениеЗаказаПоставщику);
			ОбщегоНазначения.СообщитьПользователю(Сообщение.Текст);
			ПланыОбмена.ВыгрузкаДанных.УдалитьРегистрациюИзменений(СсылкаФиксации, Перечисления.УзлыОбмена.УПП);
		КонецЕсли; 
	КонецЦикла;
	
КонецФункции 

Функция ПередатьДанныеПоКорректировкеЗаказаПоставщику(МассивДокументов) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ФиксацияИзмененийСчетаПоступленияИзменения.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_СсылкиИзменений
		|ИЗ
		|	Справочник.ФиксацияИзмененийСчетаПоступления.Изменения КАК ФиксацияИзмененийСчетаПоступленияИзменения
		|ГДЕ
		|	ФиксацияИзмененийСчетаПоступленияИзменения.Узел В (&Узел)
		|	И ФиксацияИзмененийСчетаПоступленияИзменения.Ссылка.ИзменяемыйДокумент В(&Объект)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ФиксацияИзмененийСчетаПоступленияИзмененияДокумента.Ссылка) КАК ГуидИзменений,
		|	ФиксацияИзмененийСчетаПоступленияИзмененияДокумента.Содержание КАК Содержание,
		|	ФиксацияИзмененийСчетаПоступленияИзмененияДокумента.Количество КАК Количество,
		|	ФиксацияИзмененийСчетаПоступленияИзмененияДокумента.Цена КАК Цена,
		|	ФиксацияИзмененийСчетаПоступленияИзмененияДокумента.Сумма КАК Сумма,
		|	ФиксацияИзмененийСчетаПоступленияИзмененияДокумента.СтавкаНДС КАК СтавкаНДС,
		|	ФиксацияИзмененийСчетаПоступленияИзмененияДокумента.СуммаНДС КАК СуммаНДС,
		|	ФиксацияИзмененийСчетаПоступленияИзмененияДокумента.Ссылка.ДатаИзменения КАК ДатаИзменения,
		|	ПротоколОбменов.УИДИсточника КАК Номенклатура,
		|	ПротоколОбменов1.УИДИсточника КАК ГуидЗаказа
		|ИЗ
		|	ВТ_СсылкиИзменений КАК ВТ_СсылкиИзменений
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ФиксацияИзмененийСчетаПоступления.ИзмененияДокумента КАК ФиксацияИзмененийСчетаПоступленияИзмененияДокумента
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
		|			ПО ФиксацияИзмененийСчетаПоступленияИзмененияДокумента.Номенклатура = ПротоколОбменов.Объект
		|				И (ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УПП))
		|				И ФиксацияИзмененийСчетаПоступленияИзмененияДокумента.Номенклатура = ПротоколОбменов.Объект
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменов1
		|			ПО ФиксацияИзмененийСчетаПоступленияИзмененияДокумента.Ссылка.ИзменяемыйДокумент = ПротоколОбменов1.Объект
		|				И (ПротоколОбменов1.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УППЗаказ))
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменов2
		|			ПО ФиксацияИзмененийСчетаПоступленияИзмененияДокумента.Ссылка = ПротоколОбменов2.Объект
		|				И (ПротоколОбменов2.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УППЗаказ))
		|		ПО ВТ_СсылкиИзменений.Ссылка = ФиксацияИзмененийСчетаПоступленияИзмененияДокумента.Ссылка
		|ГДЕ
		|	ФиксацияИзмененийСчетаПоступленияИзмененияДокумента.Ссылка.ИзменяемыйДокумент В(&Объект)
		|	И НЕ ФиксацияИзмененийСчетаПоступленияИзмененияДокумента.Ссылка.ПометкаУдаления
		|	И ПротоколОбменов2.Объект ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Объект", МассивДокументов);
	УзлыОбмена = ПланыОбмена.ВыгрузкаДанных.ПолучитьУзелОбмена(Перечисления.УзлыОбмена.УПП);
	Запрос.УстановитьПараметр("Узел", УзлыОбмена);

	
	Товары = Запрос.Выполнить().Выгрузить(); 
	Шапки = Товары.Скопировать(,"ГуидЗаказа, ГуидИзменений, ДатаИзменения");
