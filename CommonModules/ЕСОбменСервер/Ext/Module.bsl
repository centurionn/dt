// Формирует структуру, в которой определяется источник загрузки документа.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - ссылка на документ
// Возвращаемое значение:
//  Структура: 
//		* ДокументЗагруженИзВнешнегоИсточника - Булево
//		* УзелОбмена - ПеречислениеСсылка.УзлыОбмена 
Функция ДокументЗагруженИзВнешнегоИсточника(ДокументСсылка) Экспорт        
	
	СтруктураРезультата = Новый Структура("ДокументЗагруженИзВнешнегоИсточника, УзелОбмена", Ложь, Неопределено);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПротоколОбменов.УзелОбмена КАК УзелОбмена
	|ИЗ
	|	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	|ГДЕ
	|	ПротоколОбменов.ДействиеПриОбмене = Значение(Перечисление.ДействияПриОбмене.ЗагрузкаДанных)
	|	И ПротоколОбменов.Объект = &Документ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.Диадок)
	|ИЗ
	|	Справочник.Диадок_Документы КАК Диадок_Документы
	|ГДЕ
	|	Диадок_Документы.Документ = &Документ";

	Запрос.УстановитьПараметр("Документ", ДокументСсылка);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		СтруктураРезультата.ДокументЗагруженИзВнешнегоИсточника = Истина;
		СтруктураРезультата.УзелОбмена = Выборка.УзелОбмена;
	КонецЕсли; 
	Возврат СтруктураРезультата;
	
КонецФункции

 //Субботин 75158 27.09.2023 начало
Функция ОбработатьКоносамент(ДанныеКоносамента, СтруктураПоискаВПротоколах, ОбъектXDTO, ТипыДокументов) Экспорт 
	
	СсылкаПоУИД = СтруктураПоискаВПротоколах.МодульРС.СсылкаПоУИД(ДанныеКоносамента.ГУИД_DX, СтруктураПоискаВПротоколах.ЗагрузкаДанных, СтруктураПоискаВПротоколах.УзелОбмена, ТипыДокументов);
	Результат = Новый Структура("ГУИД, Error");
	Если СсылкаПоУИД = Неопределено Тогда	
		КоносаментОбъект = Документы.ТранспортныйДокумент.СоздатьДокумент();
		КоносаментОбъект.Заполнить(Неопределено);
		ЭтоНовый = Истина;
		//Евросиб(ДИТ), Беляев СЮ, US 104074 / TA 104682, 11-03-2025, начало
		РезультатПроверки = Документы.ТранспортныйДокумент.НайтиДублирующийДокумент(Документы.ТранспортныйДокумент.ПустаяСсылка(), ДанныеКоносамента.НомерДокумента, Истина);
		Если РезультатПроверки.ЕстьДубль Тогда
			КоносаментОбъект = РезультатПроверки.Ссылка.ПолучитьОбъект();
			Результат.Вставить("ГУИД", РезультатПроверки.УИДИсточника);
			ЭтоНовый = Ложь;
		КонецЕсли;
		//Евросиб(ДИТ), Беляев СЮ, US 104074 / TA 104682, 11-03-2025, конец
	Иначе 
		КоносаментОбъект = СсылкаПоУИД.ПолучитьОбъект();
		ЭтоНовый = Ложь;
	КонецЕсли;
	
	КоносаментОбъект.ОбменДанными.Загрузка = Истина;
		
	КоносаментОбъект.ВидОперации 					= Перечисления.ВидыОперацийТранспортныхДокументов.Коносамент;
	КоносаментОбъект.Дата 							= ДанныеКоносамента.ДатаВыпускаДокумента;
	КоносаментОбъект.НомерТранспортногоДокумента 	= ДанныеКоносамента.НомерДокумента;
	КоносаментОбъект.ДатаТранспортногоДокумента 	= ДанныеКоносамента.ДатаВыпускаДокумента;
	КоносаментОбъект.ДатаОтправленияПлан 			= ДанныеКоносамента.ДатаОтправленияПлан;
	КоносаментОбъект.ДатаПрибытияПлан 				= ДанныеКоносамента.ДатаПрибытияПлан;
	КоносаментОбъект.ДатаОтправления 				= ДанныеКоносамента.ДатаОтправленияФакт;
	КоносаментОбъект.ДатаПрибытия 					= ДанныеКоносамента.ДатаПрибытияФакт; 
	КоносаментОбъект.Грузоотправитель 				= СтрЗаменить(ДанныеКоносамента.Грузоотправитель, Символы.ПС, " ");
	КоносаментОбъект.Грузополучатель 				= СтрЗаменить(ДанныеКоносамента.Грузополучатель, Символы.ПС, " ");
	КоносаментОбъект.Изменено 	 					= ТекущаяДата(); 
	//Евросиб СубботинВ #88129 18.07.2024 Начало// поменял заполнение и добавил реквизит Ответственный
	//КоносаментОбъект.Автор 	 						= Справочники.Пользователи.ПолучитьПользователяПоЛогинуAD(ДанныеКоносамента.Сотрудник);
	КоносаментОбъект.Автор 	 						= Пользователи.ТекущийПользователь();
    КоносаментОбъект.Ответственный 	 				= Справочники.Пользователи.ПолучитьПользователяПоЛогинуAD(ДанныеКоносамента.Сотрудник); 
	//Евросиб СубботинВ #88129 18.07.2024 Конец
	
	МассивУведомляемыхСторон = Новый Массив;
	МассивУведомляемыхСторон.Добавить(ДанныеКоносамента.УведомляемаяСторона);
	МассивУведомляемыхСторон.Добавить(ДанныеКоносамента.ДругиеУведомляемыеСтороны);
	КоносаментОбъект.УведомляемыеСтороны = СтрЗаменить(СтрСоединить(МассивУведомляемыхСторон, ", "), Символы.ПС, " ");
		
	ТипСправочника = Новый СписокЗначений;
