						?(ВыборкаШапка.ЭтоПоступлениеДС, СтруктураОбязательныхРеквизитовШапкиПоступление, СтруктураОбязательныхРеквизитовШапкиСписание),
						Отказ, Ошибки, Ложь);
				ЗаполнениеДокументов.ПроверитьЗаполнениеТабличнойЧасти(ППОбъект, "РасшифровкаПлатежа", 
						СтруктураОбязательныхРеквизитовТЧ, Отказ, Ошибки, Ложь);
			КонецЕсли;
					
			//Евросиб Каблов 26.08.2022 ( Ticket#0280983
			Если Не ППОбъект.ЭтоНовый() И ТипЗнч(ППОбъект) = Тип("ДокументОбъект.ПоступлениеНаРасчетныйСчет") Тогда
				
				Запрос = Новый Запрос;
            	Запрос.Текст =
				"ВЫБРАТЬ
				|	СУММА(РасшифровкаПлатежа.СуммаВзаиморасчетов) КАК СуммаВзаиморасчетов
				|ИЗ
				|	Документ.ПоступлениеНаРасчетныйСчет.РасшифровкаПлатежа КАК РасшифровкаПлатежа
				|ГДЕ
				|	РасшифровкаПлатежа.Ссылка = &Ссылка";
				Запрос.УстановитьПараметр("Ссылка", ППОбъект.Ссылка);
				
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.СуммаВзаиморасчетов) Тогда
					ПрежняяСумма = Выборка.СуммаВзаиморасчетов;
				Иначе
					ПрежняяСумма = 0;
				КонецЕсли;
				
				ТекСумма = ППОбъект.РасшифровкаПлатежа.Итог("СуммаВзаиморасчетов");
				
				Если ПрежняяСумма <> ТекСумма Тогда
					ППОбъект.РазнесениеНаСчетаПокупателям.Очистить();
					ППОбъект.ВыполненаПопыткаРазнесения = Ложь;
					ППОбъект.УспешноРазнесенаВсяСумма = Ложь;
				КонецЕсли;
					
			КонецЕсли;
			//Евросиб Каблов 26.08.2022 )
			
			Если Не Отказ Тогда
				НачатьТранзакцию();
				Попытка
					Если ППОбъект.ПометкаУдаления Тогда
						ППОбъект.ПометкаУдаления = Ложь;
					КонецЕсли;
					//Евросиб Каблов 12.08.2020 (
					//ППОбъект.Записать(РежимЗаписиДокумента.Проведение);
					//ДИТ, Беляев СЮ, BUG 82027 / TA 82906, 25-03-2024, начало (если документ есть в базе и он проведён, то обязательно перепроводим)
					Если ППОбъект.Проведен Тогда
						Проводить = Истина;
					КонецЕсли;
					//ДИТ, Беляев СЮ, BUG 82027 / TA 82906, 25-03-2024, конец
					Если Проводить Тогда
						ППОбъект.Записать(РежимЗаписиДокумента.Проведение);
					Иначе
						ППОбъект.Записать(РежимЗаписиДокумента.Запись);
					КонецЕсли;
					//Евросиб Каблов 12.08.2020 )
					//добавляем историю в регистр загрузок
					СтруктураПоиска = Новый Структура("ДействиеПриОбмене, УзелОбмена, Объект", Перечисления.ДействияПриОбмене.ЗагрузкаДанных, 
													Перечисления.УзлыОбмена.УПП, ППОбъект.Ссылка);
					СтруктураДанных = Новый Структура("УИДИсточника, Ответственный", ВыборкаШапка.ГУИДППУПП,  ППОбъект.Автор);
					РегистрыСведений.ПротоколОбменов.ЗафиксироватьИнформациюОЗагрузке(СтруктураПоиска, СтруктураДанных);
					
					СтруктураПоиска = Новый Структура("ДействиеПриОбмене, УзелОбмена, Объект", Перечисления.ДействияПриОбмене.ЗагрузкаДанных, 
													Перечисления.УзлыОбмена.БитФинанс, ППОбъект.Ссылка);
					СтруктураДанных = Новый Структура("УИДИсточника, Ответственный", ВыборкаШапка.ГУИДППБФ,  ППОбъект.Автор);
					РегистрыСведений.ПротоколОбменов.ЗафиксироватьИнформациюОЗагрузке(СтруктураПоиска, СтруктураДанных);
					
					ЗафиксироватьТранзакцию();
				Исключение
					Ошибки = Ошибки + "Не удалось записать документ " + ОписаниеОшибки();
					ОтменитьТранзакцию();
					Отказ = Истина;
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
		//Евросиб Каблов 07.08.2020 (
		Если ЗначениеЗаполнено(Ошибки) Тогда
		//Евросиб Каблов 07.08.2020 )
			СтрокаТЗРезультата = ТЗРезультат.Добавить();
			СтрокаТЗРезультата.ГУИДППБФ = ВыборкаШапка.ГУИДППБФ;
			СтрокаТЗРезультата.Комментарий = Ошибки;
			СтрокаТЗРезультата.НомерСтроки = ВыборкаШапка.ПорядковыйНомерПП;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОбщегоНазначения.ЗначениеВСтрокуXML(ТЗРезультат);
	
КонецФункции // СоздатьБанковскиеВыписки(XMLParams)

Функция ЗаписатьКомментарийБухгалтерии(ИдентификаторДокумента, Комментарий) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗагруженныеПП.Объект КАК Объект
	|ИЗ
	|	РегистрСведений.ПротоколОбменов КАК ЗагруженныеПП
	|ГДЕ
	|	ЗагруженныеПП.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных)
	|	И ЗагруженныеПП.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УПП)
	|	И ЗагруженныеПП.УИДИсточника = &ИдентификаторДокумента";
	Запрос.УстановитьПараметр("ИдентификаторДокумента", ИдентификаторДокумента);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Ложь;
	Если Выборка.Следующий() Тогда
		ДокОбъект = Выборка.Объект.ПолучитьОбъект();
		ДокОбъект.КомментарийБухгалтерии = Комментарий;
		ДокОбъект.ОбменДанными.Загрузка = Истина;
		ДокОбъект.Записать();
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

