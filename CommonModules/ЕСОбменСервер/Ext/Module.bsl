//Евросиб Каблов 14.11.2024 #93051
Функция ПодтвердитьЗагрузкуДокумента(ОбъектХ, МенеджерОбъекта, ИмяОбъекта, УзелОбмена, УзелПланаОбмена, ТекстРезультат)
	
	ВыгрузкаДанных = Перечисления.ДействияПриОбмене.ВыгрузкаДанных;
	
	ПроизошлаОшибка = Ложь;
	Попытка
		СсылкаНаОбъект = МенеджерОбъекта.ПолучитьСсылку(Новый УникальныйИдентификатор(ОбъектХ.ГУИД));
		Если Не ОбщегоНазначения.СсылкаСуществует(СсылкаНаОбъект) Тогда
			ПроизошлаОшибка = Истина;
		КонецЕсли;
	Исключение
	    ПроизошлаОшибка = Истина;
	КонецПопытки;		
	
	Если ПроизошлаОшибка Тогда
		ТекстРезультат = СтрШаблон("<xml><error>Не найден документ %1 по ГУИДу %2</error></xml>", ИмяОбъекта, ОбъектХ.ГУИД);
		Возврат Ложь;
	КонецЕсли;
	
	ВремяВыгрузки = РегистрыСведений.ПротоколОбменов.ДатаВыгрузкиОбъекта(УзелОбмена, ВыгрузкаДанных, СсылкаНаОбъект);
	ВремяПоследнегоИзменения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаОбъект, "Изменено");
	
	Если ВремяПоследнегоИзменения <> Неопределено И ВремяВыгрузки > ВремяПоследнегоИзменения Тогда
		ПланыОбмена.УдалитьРегистрациюИзменений(УзелПланаОбмена, СсылкаНаОбъект);	
	КонецЕсли;
		
	ПодтвердитьЗагрузкуОбъектаПоГУИДБезПроведения(ОбъектХ.ГУИД, ВыгрузкаДанных, УзелОбмена, СсылкаНаОбъект);
	
	Возврат Истина;
			
КонецФункции

//Евросиб Каблов 14.11.2024 #93051 перенес из модуля веб-сервиса DataCoreWS
// Евросиб(ДИТ) US 86002 ТА 87080 Сержантова А.С. 08.08.2024
Процедура ПодтвердитьЗагрузкуОбъектаПоГУИДБезПроведения(ГУИД, Действие, УзелОбмена, СсылкаНаОбъект = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		СсылкаНаОбъект = РегистрыСведений.ПротоколОбменов.СсылкаПоУИД(ГУИД, Действие, УзелОбмена);
	КонецЕсли;
	
	Если СсылкаНаОбъект <> Неопределено Тогда
		
		//Объект = СсылкаНаОбъект.Получитьобъект();
		
		НаборЗаписей = РегистрыСведений.ПротоколОбменов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДействиеПриОбмене.Установить(Действие);
		НаборЗаписей.Отбор.УзелОбмена.Установить(УзелОбмена);
		НаборЗаписей.Отбор.Объект.Установить(СсылкаНаОбъект);
		
		НаборЗаписей.Прочитать();
		Для Каждого Запись Из НаборЗаписей Цикл
			Запись.ЗагрузкаПодтверждена = Истина; 
		КонецЦикла;
		НаборЗаписей.Записать();
		
	КонецЕсли;	

КонецПроцедуры

