Функция ПолучитьСудно (ДанныеСудна, СтруктураПоискаВПротоколах) экспорт // поиск по ид ДХ в протоколах обмена, по ИМО в справочнике, и создание 
	
	ТипыДокументов = Новый СписокЗначений;
	ТипыДокументов.Добавить(Тип("СправочникСсылка.ТС"));
	Результат = СтруктураПоискаВПротоколах.МодульРС.СсылкаПоУИД(ДанныеСудна.ID_DX, СтруктураПоискаВПротоколах.ЗагрузкаДанных, СтруктураПоискаВПротоколах.УзелОбмена, ТипыДокументов);
	Если Результат = Неопределено Тогда
		НовЭлем = Справочники.ТС.СоздатьЭлемент();
		НовЭлем.Наименование 	= ДанныеСудна.Судно;
		НовЭлем.buildDate 		= Дата(Строка(?(ЗначениеЗаполнено(ДанныеСудна.СудноГодПостройки), ДанныеСудна.СудноГодПостройки, "0001") + "0101"));
		НовЭлем.imoNumber 		= ДанныеСудна.СудноКодIMO;
		НовЭлем.capacityTeu		= ДанныеСудна.СудноНоминальнаяКонтейнеровместимость;
		НовЭлем.flag 			= ДанныеСудна.СудноСтранаКод ; 
		НовЭлем.ТипТС 			= Справочники.ТипоразмерыТС.СудноКонтейнеровоз;  
		//	НовЭлем.ТипТС.Судно     = Истина;		
		НовЭлем.Записать();
		Результат = НовЭлем.Ссылка;				
		СтруктураПоискаВПротоколах.МодульРС.ЗаписатьУИДИсточника(ДанныеСудна.ID_DX, СтруктураПоискаВПротоколах.ЗагрузкаДанных, СтруктураПоискаВПротоколах.УзелОбмена, Результат);
	КонецЕсли;
	
	Возврат Результат 
КонецФункции

