	МенеджерЗаписи.Вагон = Вагон;
	МенеджерЗаписи.Прочитать();
	//ДИТ Шевченко А.В. 54982 09.08.2022 -Начало //Добавил СданВАренду
 	Если МенеджерЗаписи.Выбран() 
