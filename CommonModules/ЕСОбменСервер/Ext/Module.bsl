	|				ПО ОтчетКомитентуОПродажахТовары.Ссылка = Счет.УдалитьДокументОснование
	|					И (ОтчетКомитентуОПродажахТовары.Ссылка.СуммаВознаграждения = ОтчетКомитентуОПродажахТовары.СчетНаОплатуПокупателю.СуммаДокумента)
	|					И (ОтчетКомитентуОПродажахТовары.СчетНаОплатуПокупателю.Проведен)
	|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	|				ПО ОтчетКомитентуОПродажахТовары.Ссылка.УслугаПоВознаграждению = ПротоколОбменов.Объект
	|					И (ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УПП))
	|					И (ПротоколОбменов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных))
	|			ПО СсылкиНаДокументы.Ссылка = ОтчетКомитентуОПродажахТовары.Ссылка
	|	ГДЕ
	|		ОтчетКомитентуОПродажахТовары.Ссылка.СпособРасчетаКомиссионногоВознаграждения <> ЗНАЧЕНИЕ(Перечисление.СпособыРасчетаКомиссионногоВознаграждения.НеРассчитывается)";
	//Евросиб Шевченко А.В. US 112687 TA 126873 26.12.2025
	#КонецОбласти 	
	Запрос.УстановитьПараметр("СсылкиНаДокументы", СсылкиНаДокументы);
	
	Результаты = Запрос.ВыполнитьПакет();
	
	//Евросиб Шевченко А.В. US 112687 TA 126873 26.12.2025
	Шапки = Результаты[3].Выгрузить(); 
	ТЧАгентскиеУслуги = Результаты[4].Выгрузить();
	ТЧКомиссия = Результаты[5].Выгрузить();
	//Евросиб Шевченко А.В. US 112687 TA 126873 26.12.2025
	
	СтруктураШапкиИТЧУслуги = Новый Структура;
	СтруктураШапкиИТЧУслуги.Вставить("Шапки", Шапки);
	СтруктураШапкиИТЧУслуги.Вставить("ТЧАгентскиеУслуги", ТЧАгентскиеУслуги);	
	СтруктураШапкиИТЧУслуги.Вставить("ТЧКомиссия", ТЧКомиссия);	
	
	ПередаваемаяСтрокаXML = ОбщегоНазначения.ЗначениеВСтрокуXML(СтруктураШапкиИТЧУслуги); 
	
	Возврат ПередаваемаяСтрокаXML;		

КонецФункции // ПолучитьДанныеПоИСФ(XMLParams)

Функция ЗаписатьОплаты(XMLParams) Экспорт

	СтруктураДанных =  ОбщегоНазначения.ЗначениеИзСтрокиXML(XMLParams);
	Организация = Справочники.Организации.НайтиПоКоду(СтруктураДанных.ОрганизацияКод);
	ТЗОплат = СтруктураДанных.ТаблицаОплат;
	ТЗРезультат = Новый ТаблицаЗначений;
	ТЗРезультат.Колонки.Добавить("НомерСтроки");
	ТЗРезультат.Колонки.Добавить("Комментарий");
	ТЗРезультат.Колонки.Добавить("НеобходимоеДействие", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100)));
	Запрос = Новый Запрос;
#Область Запрос
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗОплат.НомерСтроки КАК НомерСтрокиОплаты,
	|	ТЗОплат.ДатаОплаты КАК ДатаОплаты,
	|	ТЗОплат.ДатаРеализации КАК ДатаРеализации,
	|	ТЗОплат.СуммаОплаты КАК СуммаОплаты,
	|	ТЗОплат.УИДДокументаРеализации КАК УИДДокументаРеализации,
	|	ТЗОплат.ВерсияИСФ КАК ВерсияИСФ,
	|	ТЗОплат.УИДПоступленияНаРасчетныйСчет КАК УИДПоступленияНаРасчетныйСчет,
	|	ТЗОплат.ЭтоВР КАК ЭтоВР
	|ПОМЕСТИТЬ ТЗОплат
	|ИЗ
	|	&ТЗОплат КАК ТЗОплат
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументыРеализацииРИТМ.УИДИсточника КАК УИДИсточника,
	|	ДокументыРеализацииРИТМ.НУИНУ КАК НУИНУ,
	|	ДокументыРеализацииРИТМ.ДействиеПриОбмене КАК ДействиеПриОбмене,
	|	ДокументыРеализацииРИТМ.УзелОбмена КАК УзелОбмена,
	|	ДокументыРеализацииРИТМ.Объект КАК Объект
	|ПОМЕСТИТЬ ДокументыРеализацииРИТМ
	|ИЗ
	|	РегистрСведений.ПротоколОбменов КАК ДокументыРеализацииРИТМ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТЗОплат КАК ТЗОплат
	|		ПО ДокументыРеализацииРИТМ.УИДИсточника = ТЗОплат.УИДДокументаРеализации
	|			И (ДокументыРеализацииРИТМ.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
	|			И (ДокументыРеализацииРИТМ.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.РИТМ))
	|			И ДокументыРеализацииРИТМ.НУИНУ = ТЗОплат.ВерсияИСФ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЗОплат.НомерСтрокиОплаты КАК НомерСтрокиОплаты,
	|	ДокументыПоступленияДС.Объект КАК ПоступлениеДС,
	//|	ВЫБОР
	//|		КОГДА НАЧАЛОПЕРИОДА(ТЗОплат.ДатаОплаты, МЕСЯЦ) >= ТЗОплат.ДатаРеализации
	//|				И НАЧАЛОПЕРИОДА(ТЗОплат.ДатаОплаты, МЕСЯЦ) >= ЕСТЬNULL(ДокументыРеализации.Объект.ПериодВО, ДокументыРеализацииРИТМ.Объект.ПериодВО)
	//|				И НАЧАЛОПЕРИОДА(ТЗОплат.ДатаОплаты, МЕСЯЦ) >= ЕСТЬNULL(ДокументыПоступленияДС.Объект.ДатаВзаиморасчетов, ДокументыПоступленияДС.Объект.Дата)
	//|			ТОГДА НАЧАЛОПЕРИОДА(ТЗОплат.ДатаОплаты, МЕСЯЦ)
	//|		КОГДА ТЗОплат.ДатаРеализации >= ЕСТЬNULL(ДокументыРеализации.Объект.ПериодВО, ДокументыРеализацииРИТМ.Объект.ПериодВО)
	//|				И ТЗОплат.ДатаРеализации >= ДокументыПоступленияДС.Объект.ДатаВзаиморасчетов
	//|			ТОГДА ТЗОплат.ДатаРеализации
	//|		КОГДА ЕСТЬNULL(ДокументыРеализации.Объект.ПериодВО, ДокументыРеализацииРИТМ.Объект.ПериодВО) >= ДокументыПоступленияДС.Объект.ДатаВзаиморасчетов
	//|			ТОГДА ЕСТЬNULL(ДокументыРеализации.Объект.ПериодВО, ДокументыРеализацииРИТМ.Объект.ПериодВО)
	//|		ИНАЧЕ ЕСТЬNULL(ДокументыПоступленияДС.Объект.ДатаВзаиморасчетов, ДокументыПоступленияДС.Объект.Дата)
	//|	КОНЕЦ КАК ДатаОплаты,
	//Евросиб(ДИТ), Беляев СЮ, BUG 91902 / TA 92400, 02-10-2024, начало
	//Изменена логика определения "Даты оплаты" согласно условиям:
	//Необходимо выбирать максимальную дату из: "ДатаОплаты", "ДатаРеализации", "ПериодВО" в реализации, "ДатаВзаиморасчетов" ("Дата" для КорректировкиДолга)
	//1) Если входящая "ДатаОплаты" 
	//					больше "ДатаРеализации" 
	//					и больше "ПериодВО" в реализации 
	//					и больше "ДатаВзаиморасчетов" ("Дата" для КорректировкиДолга), тогда устанавливаем "ДатаОплаты"
	//2) Если входящая "ДатаРеализации" 
	//					и больше "ПериодВО" в реализации 
	//					и больше "ДатаВзаиморасчетов" ("Дата" для КорректировкиДолга), тогда устанавливаем "ДатаРеализации"
	//3) Если входящая  "ПериодВО" в реализации 
	//					и больше "ДатаВзаиморасчетов" ("Дата" для КорректировкиДолга), тогда устанавливаем "ПериодВО"
	//4) Устанавливаем "ДатаВзаиморасчетов" ("Дата" для КорректировкиДолга), если другие условия не выполнены 
	|	ВЫБОР
	|		КОГДА ТЗОплат.ДатаОплаты >= ТЗОплат.ДатаРеализации
	|				И НАЧАЛОПЕРИОДА(ТЗОплат.ДатаОплаты, МЕСЯЦ) >= ЕСТЬNULL(ДокументыРеализации.Объект.ПериодВО, ДокументыРеализацииРИТМ.Объект.ПериодВО)
	|				И НАЧАЛОПЕРИОДА(ТЗОплат.ДатаОплаты, МЕСЯЦ) >= ЕСТЬNULL(ДокументыПоступленияДС.Объект.ДатаВзаиморасчетов, ДокументыПоступленияДС.Объект.Дата)
	//|			ТОГДА ТЗОплат.ДатаОплаты
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0370271, 15-10-2024, начало (в УПП создают документы будущей датой, некорректно такие данные загружать в ДК)
	|			ТОГДА НАЧАЛОПЕРИОДА(ТЗОплат.ДатаОплаты, МЕСЯЦ)
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0370271, 15-10-2024, конец
	|		КОГДА ТЗОплат.ДатаРеализации >= ЕСТЬNULL(ДокументыРеализации.Объект.ПериодВО, ДокументыРеализацииРИТМ.Объект.ПериодВО)
	|				И ТЗОплат.ДатаРеализации >= ЕСТЬNULL(ДокументыПоступленияДС.Объект.ДатаВзаиморасчетов, ДокументыПоступленияДС.Объект.Дата)
	|			ТОГДА ТЗОплат.ДатаРеализации
	|		КОГДА ЕСТЬNULL(ДокументыРеализации.Объект.ПериодВО, ДокументыРеализацииРИТМ.Объект.ПериодВО) >= ЕСТЬNULL(ДокументыПоступленияДС.Объект.ДатаВзаиморасчетов, ДокументыПоступленияДС.Объект.Дата)
	|			ТОГДА ЕСТЬNULL(ДокументыРеализации.Объект.ПериодВО, ДокументыРеализацииРИТМ.Объект.ПериодВО)
	|		ИНАЧЕ ЕСТЬNULL(ДокументыПоступленияДС.Объект.ДатаВзаиморасчетов, ДокументыПоступленияДС.Объект.Дата)
	|	КОНЕЦ КАК ДатаОплаты,	
	//Евросиб(ДИТ), Беляев СЮ, BUG 91902 / TA 92400, 02-10-2024, конец
	|	ТЗОплат.СуммаОплаты КАК СуммаОплаты,
	|	ТЗОплат.УИДПоступленияНаРасчетныйСчет КАК УИДПоступленияНаРасчетныйСчет,
	|	ТЗОплат.УИДДокументаРеализации КАК УИДДокументаРеализации,
	|	ТЗОплат.ВерсияИСФ КАК ВерсияИСФ,
	|	ЕСТЬNULL(ДокументыРеализации.Объект, ДокументыРеализацииРИТМ.Объект) КАК ДокументРеализации,
	|	ТЗОплат.ДатаРеализации КАК ДатаРеализации,
	|	ТЗОплат.ЭтоВР КАК ЭтоВР
	|ПОМЕСТИТЬ ВТОплатыРеализации
	|ИЗ
	|	ТЗОплат КАК ТЗОплат
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ДокументыРеализацииРИТМ
	|		ПО ТЗОплат.УИДДокументаРеализации = ДокументыРеализацииРИТМ.УИДИсточника
	|			И ТЗОплат.ВерсияИСФ = ДокументыРеализацииРИТМ.НУИНУ
	|			И (ДокументыРеализацииРИТМ.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
	|			И (ДокументыРеализацииРИТМ.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.РИТМ))
	|			И (ДокументыРеализацииРИТМ.Объект ССЫЛКА Документ.РеализацияТоваровУслуг)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ДокументыПоступленияДС
	|		ПО ТЗОплат.УИДПоступленияНаРасчетныйСчет = ДокументыПоступленияДС.УИДИсточника
	|			И (ДокументыПоступленияДС.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
	|			И (ДокументыПоступленияДС.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УПП))
	|			И (ДокументыПоступленияДС.Объект ССЫЛКА Документ.ПоступлениеНаРасчетныйСчет
	|				ИЛИ ДокументыПоступленияДС.Объект ССЫЛКА Документ.КорректировкаДолга)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ДокументыРеализации
	|		ПО ТЗОплат.УИДДокументаРеализации = ДокументыРеализации.УИДИсточника
	|			И ТЗОплат.ВерсияИСФ = ДокументыРеализации.НУИНУ
	|			И (ДокументыРеализации.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных))
	|			И (ДокументыРеализации.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УПП))
	|;
	|
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.ПоступлениеДС КАК ПоступлениеДС,
	|	ВложенныйЗапрос.ДатаОплаты КАК ДатаОплаты,
	|	ВложенныйЗапрос.СуммаОплаты КАК СуммаОплаты,
	|	ВложенныйЗапрос.ДокументРеализации КАК ДокументРеализации,
	|	ВложенныйЗапрос.КорректировкаДолга КАК КорректировкаДолга
	|ПОМЕСТИТЬ ВТКорректировкиДолга
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВТОплатыРеализации.ПоступлениеДС КАК ПоступлениеДС,
	|		ВТОплатыРеализации.ДатаОплаты КАК ДатаОплаты,
	//Евросиб Каблов 08.02.2022 ( Ticket#0259323
	//|		ВТОплатыРеализации.СуммаОплаты КАК СуммаОплаты,
