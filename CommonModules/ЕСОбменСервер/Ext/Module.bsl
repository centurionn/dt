Функция ПолучитьМассивСсылокПСЦ(МассивГУИДов)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПСЦИзменения.Узел КАК Узел,
	|	ПСЦИзменения.Ссылка КАК Ссылка,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ПСЦИзменения.Ссылка) КАК УникальныйИдентификатор
	|ИЗ
	|	Документ.ПСЦ.Изменения КАК ПСЦИзменения
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ПСЦПоставщикаИзменения.Узел,
	|	ПСЦПоставщикаИзменения.Ссылка КАК Ссылка,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ПСЦПоставщикаИзменения.Ссылка)
	|ИЗ
	|	Документ.ПСЦПоставщика.Изменения КАК ПСЦПоставщикаИзменения";
	
	ТаблицаЗарегистрированных = Запрос.Выполнить().Выгрузить();
	
	ПараметрыОтбора = Новый Структура;
	
	МассивСсылокКлючей = Новый Массив;
	
	Для Каждого ГУИД Из МассивГУИДов Цикл
		ПараметрыОтбора.Вставить("УникальныйИдентификатор", Новый УникальныйИдентификатор(ГУИД));
		НайденныеСтроки = ТаблицаЗарегистрированных.НайтиСтроки(ПараметрыОтбора);
		Для Каждого Строка Из НайденныеСтроки Цикл
			МассивСсылокКлючей.Добавить(Строка.Ссылка);
		КонецЦикла;
	КонецЦикла;
	
	Возврат МассивСсылокКлючей;

КонецФункции

Функция ЗагрузитьДоговорыИзТЛ(XMLParams) Экспорт
	
	ПараметрыXml = ОбщегоНазначения.ЗначениеИзСтрокиXML(XMLParams);
	
	МассивГуидов = ПараметрыXml.ВыгрузитьКолонку("ГУИД");
	
	ТаблицаОтвета = Новый ТаблицаЗначений;
	ТаблицаОтвета.Колонки.Добавить("ГУИД");
	
	Если МассивГуидов.Количество() > 0 Тогда
		
		УзлыПланаОбмена = ПланыОбмена.ВыгрузкаДанных.ПолучитьУзелОбмена(Перечисления.УзлыОбмена.ТЛ);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПротоколОбменов.Объект КАК Ссылка,
		|	ПротоколОбменов.УИДИсточника КАК УИДИсточника
		|ИЗ
		|	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
		|ГДЕ
		|	ПротоколОбменов.УзелОбмена = &УзелОбмена
		|	И ПротоколОбменов.УИДИсточника В(&УИДИсточника)";
		
		Запрос.УстановитьПараметр("УзелОбмена", Перечисления.УзлыОбмена.БитФинанс);
		Запрос.УстановитьПараметр("УИДИсточника", МассивГуидов);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			СтруктураЗаписи = Новый Структура;
			СтруктураЗаписи.Вставить("УзелИнформационнойБазы", УзлыПланаОбмена[0]);
			СтруктураЗаписи.Вставить("Ссылка", Выборка.Ссылка);
			СтруктураЗаписи.Вставить("Идентификатор", Выборка.УИДИсточника);
			РегистрыСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов.ДобавитьЗапись(СтруктураЗаписи);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ОбщегоНазначения.ЗначениеВСтрокуXML(ТаблицаОтвета);
		
КонецФункции
