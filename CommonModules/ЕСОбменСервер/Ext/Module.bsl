	Запрос.УстановитьПараметр("СсылкиНаДокументы", СсылкиНаДокументы);
	
	Результаты = Запрос.ВыполнитьПакет();		
	Шапки = Результаты[1].Выгрузить(); 
	ТЧУслуги = Результаты[2].Выгрузить();     
	Файлы = Результаты[3].Выгрузить();
	//Евросиб СубботинВ #89541 16.10.2024 Начало
	СвязанныеПТУ = Результаты[4].Выгрузить();
	//Евросиб СубботинВ #89541 16.10.2024 Конец	

	// Евросиб(ДИТ) US 89517 ТА 91085 Сержантова А.С. Начало: 09.09.2024
	ЗаполнитьВебСсылкуНаЗаявку(Шапки);
	// Евросиб(ДИТ) US 89517 ТА 91085 Сержантова А.С. Конец: 09.09.2024
	
	СтруктураШапкиИТЧУслуги = Новый Структура;
	СтруктураШапкиИТЧУслуги.Вставить("Шапки", Шапки);
	СтруктураШапкиИТЧУслуги.Вставить("ТЧУслуги", ТЧУслуги);
	СтруктураШапкиИТЧУслуги.Вставить("Файлы", Файлы);
	//Евросиб СубботинВ #89541 16.10.2024 Начало
	СтруктураШапкиИТЧУслуги.Вставить("СвязанныеПТУ",СвязанныеПТУ);
	//Евросиб СубботинВ #89541 16.10.2024 Конец	

	
	ПередаваемаяСтрокаXML = ОбщегоНазначения.ЗначениеВСтрокуXML(СтруктураШапкиИТЧУслуги); 
	
	Возврат ПередаваемаяСтрокаXML;		


КонецФункции // ПолучитьДанныеПоСчетам(XMLParams) 

// Евросиб(ДИТ) US 89517 ТА 91085 Сержантова А.С. 09.09.2024
Процедура ЗаполнитьВебСсылкуНаЗаявку(Шапки)

	Для каждого СтрокаШапки Из Шапки Цикл  
		ЗаявкаСсылка = Документы.ЗаявкаНаОплату.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаШапки.ГУИД));
		СтрокаШапки.ВебСсылка = ПолучитьСсылкуWebСсылку(ЗаявкаСсылка);
	КонецЦикла;	

КонецПроцедуры    

// Евросиб(ДИТ) US 89517 ТА 91085 Сержантова А.С. 09.09.2024
Функция ПолучитьСсылкуWebСсылку(СсылкаНаОбъект) Экспорт 

	Результат = ПолучитьНавигационнуюСсылку(СсылкаНаОбъект);

	
	СтрокаСоединенияСБД = СтрокаСоединенияИнформационнойБазы();
	знСоединенияСБД		= Врег(СтрокаСоединенияСБД);
	
	ПозицияПоиска		= Найти(знСоединенияСБД, "SRVR=");
	Если ПозицияПоиска = 1 тогда
		знСоединенияСБД	= СтрЗаменить(знСоединенияСБД, "SRVR=""", "http://");
		знСоединенияСБД	= СтрЗаменить(знСоединенияСБД, """;REF=""", "/");
		знСоединенияСБД	= СтрЗаменить(знСоединенияСБД, """;", "#");
		
		Результат = знСоединенияСБД + СокрЛП(Результат);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ПередатьДанныеПоСФДляЗаказа(XMLParams) Экспорт

	ГУИДДокументов =  ОбщегоНазначения.ЗначениеИзСтрокиXML(XMLParams);
	СсылкиНаДокументы = Новый ТаблицаЗначений;
	СсылкиНаДокументы.Колонки.Добавить("ГУИД",Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(36)));
	СсылкиНаДокументы.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.СчетФактураПолученный"));
	Для Каждого СтрокаГУИД Из ГУИДДокументов Цикл
		Строка = СсылкиНаДокументы.Добавить();
		Строка.ГУИД = СтрокаГУИД;
		Строка.Ссылка = Документы.СчетФактураПолученный.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.ГУИД));		
