//Евросиб Каблов 14.02.2024 Ticket#0317695
Функция ПолучитьНеурегулированныеРасходы(XMLParams) Экспорт 
	
	Параметры = ОбщегоНазначения.ЗначениеИзСтрокиXML(XMLParams);
	
	ПериодБУ = Неопределено;
	Если Не Параметры.Свойство("ПериодБУ", ПериодБУ) Тогда
		ПериодБУ = КонецМесяца(ТекущаяДата());
	КонецЕсли;
	
	КодКонтрагента = Неопределено;
	Если Параметры.Свойство("КодКонтрагента", КодКонтрагента) И ЗначениеЗаполнено(КодКонтрагента) Тогда
		Контрагент = Справочники.Контрагенты.НайтиПоКоду(КодКонтрагента);
	Иначе
		Контрагент = Неопределено;
	КонецЕсли;
	
	КодОрганизации = Неопределено;
	Если Параметры.Свойство("КодОрганизации", КодОрганизации) И ЗначениеЗаполнено(КодОрганизации) Тогда
		Организация = Справочники.Организации.НайтиПоКоду(КодОрганизации);
	Иначе
		Организация = Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Акцепт.Поступление КАК Поступление,
	|	Акцепт.Ссылка КАК Акцепт
	|ПОМЕСТИТЬ АктуальныеАкцепты
	|ИЗ
	|	Документ.Акцепт КАК Акцепт
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Акцепт КАК Акцепт1
	|		ПО Акцепт.Ссылка = Акцепт1.СторнируемыйАкцепт
	|			И (Акцепт1.ПериодБУ <= &ПериодБУ)
	|			И (Акцепт1.Проведен)
	|ГДЕ
	|	Акцепт.Проведен
	|	И Акцепт.ПериодБУ <= &ПериодБУ
	|	И Акцепт.СторнируемыйАкцепт = ЗНАЧЕНИЕ(Документ.Акцепт.ПустаяСсылка)
	|	И Акцепт1.Ссылка ЕСТЬ NULL
	|	И Акцепт.Поступление.Проведен
	|	И Акцепт.Поступление.Контрагент = &Контрагент
	|	И Акцепт.Организация = &Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АктуальныеАкцепты.Поступление КАК Поступление,
	|	АктуальныеАкцепты.Акцепт КАК Акцепт,
	|	СУММА(АкцептУслуги.ПоступлениеСумма - АкцептУслуги.Сумма) КАК НеакцептованнаяСумма,
	|	СУММА(ВЫБОР
	|			КОГДА АкцептУслуги.ВидРасходов = ЗНАЧЕНИЕ(Перечисление.ВидыРасходов.Возмещаемые)
	|					И &ВыводитьАкцептыБезВСФНаВР
	|					И АкцептУслуги.УчДокумент.Ссылка ЕСТЬ NULL
	|				ТОГДА АкцептУслуги.Сумма
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаНеПеревыставленныхВР
	|ПОМЕСТИТЬ НеурегулированныеРасходы
	|ИЗ
	|	АктуальныеАкцепты КАК АктуальныеАкцепты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Акцепт.Услуги КАК АкцептУслуги
	|		ПО АктуальныеАкцепты.Акцепт = АкцептУслуги.Ссылка
	|ГДЕ
	|	АкцептУслуги.Неурег <> ЗНАЧЕНИЕ(Справочник.ПричиныНеурегулированныхРасходов.ОтработкаВРитм)
	|	И (АкцептУслуги.ПоступлениеСумма <> АкцептУслуги.Сумма
	|			ИЛИ АкцептУслуги.ВидРасходов = ЗНАЧЕНИЕ(Перечисление.ВидыРасходов.Возмещаемые)
	|				И &ВыводитьАкцептыБезВСФНаВР
	|				И АкцептУслуги.УчДокумент.Ссылка ЕСТЬ NULL
	|				И АкцептУслуги.Сумма <> 0)
	|
	|СГРУППИРОВАТЬ ПО
	|	АктуальныеАкцепты.Акцепт,
	|	АктуальныеАкцепты.Поступление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НеурегулированныеРасходы.Поступление КАК Поступление,
	|	NULL КАК КорПТУ,
	|	НеурегулированныеРасходы.Акцепт КАК Акцепт,
	|	НеурегулированныеРасходы.НеакцептованнаяСумма КАК НеакцептованнаяСумма,
	|	НеурегулированныеРасходы.СуммаНеПеревыставленныхВР КАК СуммаНеПеревыставленныхВР,
	|	ПоступлениеТоваровУслуг.Организация КАК Организация,
	|	ПоступлениеТоваровУслуг.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ПоступлениеТоваровУслуг.КратностьВзаиморасчетов <> 0
	|			ТОГДА ПоступлениеТоваровУслуг.КурсВзаиморасчетов / ПоступлениеТоваровУслуг.КратностьВзаиморасчетов
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Курс
	|ПОМЕСТИТЬ ПоступленияИКорректировки
	|ИЗ
	|	НеурегулированныеРасходы КАК НеурегулированныеРасходы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|		ПО НеурегулированныеРасходы.Поступление = ПоступлениеТоваровУслуг.Ссылка
	|ГДЕ
	|	НеурегулированныеРасходы.Поступление ССЫЛКА Документ.ПоступлениеТоваровУслуг
	|	И (НеурегулированныеРасходы.НеакцептованнаяСумма <> 0
	|			ИЛИ НеурегулированныеРасходы.СуммаНеПеревыставленныхВР <> 0)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НеурегулированныеРасходы.Поступление.ДокументПоступления,
	|	НеурегулированныеРасходы.Поступление,
	|	НеурегулированныеРасходы.Акцепт,
	|	НеурегулированныеРасходы.НеакцептованнаяСумма,
	|	НеурегулированныеРасходы.СуммаНеПеревыставленныхВР,
	|	КорректировкаПоступления.Организация,
	|	КорректировкаПоступления.Контрагент,
	|	ВЫБОР
	|		КОГДА КорректировкаПоступления.КратностьВзаиморасчетов <> 0
	|			ТОГДА КорректировкаПоступления.КурсВзаиморасчетов / КорректировкаПоступления.КратностьВзаиморасчетов
	|		ИНАЧЕ 0
	|	КОНЕЦ
	|ИЗ
	|	НеурегулированныеРасходы КАК НеурегулированныеРасходы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КорректировкаПоступления КАК КорректировкаПоступления
	|		ПО НеурегулированныеРасходы.Поступление = КорректировкаПоступления.Ссылка
	|ГДЕ
	|	НеурегулированныеРасходы.Поступление ССЫЛКА Документ.КорректировкаПоступления
	|	И (НеурегулированныеРасходы.НеакцептованнаяСумма <> 0
	|			ИЛИ НеурегулированныеРасходы.СуммаНеПеревыставленныхВР <> 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоступленияИКорректировки.Организация.Код КАК КодОрганизации,
	|	ПоступленияИКорректировки.Контрагент.Код КАК КодКонтрагента,
	|	ВыгруженныеПоступления.УИДИсточника КАК УИДПТУ,
	|	ВыгруженныеКорПТУ.УИДИсточника КАК УИДКорПТУ,
	|	ВыгруженныеАкцепты.УИДИсточника КАК УИДАкцепта,
	|	ВЫБОР
	|		КОГДА НЕ КорректировкаПоступления.Ссылка ЕСТЬ NULL
	|			ТОГДА ЕСТЬNULL(ВыгруженныеКорПТУ.ПроведенВБУ, ЛОЖЬ)
	|		ИНАЧЕ ЕСТЬNULL(ВыгруженныеПоступления.ПроведенВБУ, ЛОЖЬ)
	|	КОНЕЦ КАК ПТУПроведенВБУ,
	|	ВыгруженныеАкцепты.ПроведенВБУ КАК АкцептПроведенВБУ,
	|	ПоступленияИКорректировки.Поступление.Номер КАК НомерПТУ,
	|	ПоступленияИКорректировки.Поступление.Дата КАК ДатаПТУ,
	|	КорректировкаПоступления.Номер КАК НомерКорПТУ,
	|	КорректировкаПоступления.Дата КАК ДатаКорПТУ,
	|	ПоступленияИКорректировки.Поступление.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
	|	ПоступленияИКорректировки.Поступление.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
	|	КорректировкаПоступления.НомерВходящегоДокумента КАК НомерВходящегоКорПТУ,
	|	КорректировкаПоступления.ДатаВходящегоДокумента КАК ДатаВходящегоКорПТУ,
	|	СчетФактураПолученный.НомерВходящегоДокумента КАК НомерВСФ,
	|	СчетФактураПолученный.ДатаВходящегоДокумента КАК ДатаВСФ,
	|	КорректировочныйСФ.НомерВходящегоДокумента КАК НомерКорВСФ,
	|	КорректировочныйСФ.ДатаВходящегоДокумента КАК ДатаКорВСФ,
	|	ВЫРАЗИТЬ(ПоступленияИКорректировки.НеакцептованнаяСумма КАК ЧИСЛО(15, 2)) КАК НеакцептованнаяСумма,
	|	ВЫРАЗИТЬ(ПоступленияИКорректировки.СуммаНеПеревыставленныхВР КАК ЧИСЛО(15, 2)) КАК СуммаНеПеревыставленныхВР,
	|	ВЫРАЗИТЬ(ПоступленияИКорректировки.НеакцептованнаяСумма * ПоступленияИКорректировки.Курс КАК ЧИСЛО(15, 2)) КАК НеакцептованнаяСуммаРуб,
	|	ВЫРАЗИТЬ(ПоступленияИКорректировки.СуммаНеПеревыставленныхВР * ПоступленияИКорректировки.Курс КАК ЧИСЛО(15, 2)) КАК СуммаНеПеревыставленныхВРРуб
	|ИЗ
	|	ПоступленияИКорректировки КАК ПоступленияИКорректировки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ВыгруженныеПоступления
	|		ПО ПоступленияИКорректировки.Поступление = ВыгруженныеПоступления.Объект
	|			И (ВыгруженныеПоступления.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УПП))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураПолученный КАК СчетФактураПолученный
	|		ПО ПоступленияИКорректировки.Поступление = СчетФактураПолученный.ДокументОснование
	|			И (СчетФактураПолученный.Проведен)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КорректировкаПоступления КАК КорректировкаПоступления
	|		ПО ПоступленияИКорректировки.КорПТУ = КорректировкаПоступления.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураПолученный КАК КорректировочныйСФ
	|		ПО (КорректировкаПоступления.Ссылка = КорректировочныйСФ.ДокументОснование)
	|			И (КорректировочныйСФ.Проведен)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ВыгруженныеКорПТУ
	|		ПО ПоступленияИКорректировки.КорПТУ = ВыгруженныеКорПТУ.Объект
	|			И (ВыгруженныеКорПТУ.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УПП))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ВыгруженныеАкцепты
	|		ПО ПоступленияИКорректировки.Акцепт = ВыгруженныеАкцепты.Объект
	|			И (ВыгруженныеАкцепты.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УПП))";
	
	Запрос.УстановитьПараметр("ПериодБУ", ПериодБУ);
	Запрос.УстановитьПараметр("ВыводитьАкцептыБезВСФНаВР", Истина);
	
	Если Контрагент <> Неопределено Тогда
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Акцепт.Поступление.Контрагент = &Контрагент", "");
	КонецЕсли;
	
	Если Организация <> Неопределено Тогда
		Запрос.УстановитьПараметр("Организация", Организация);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Акцепт.Организация = &Организация", "");
	КонецЕсли;
	
	НеакцептованныеРасходы = Запрос.Выполнить().Выгрузить();
	
	ПередаваемаяСтрокаXML = ОбщегоНазначения.ЗначениеВСтрокуXML(НеакцептованныеРасходы);
	
	Возврат ПередаваемаяСтрокаXML;
	
КонецФункции

// Евросиб(ДИТ) US 73033 ТА 88304 Сержантова А.С. 17.07.2024
Функция ПередатьСтатусЗаявкиНаОплатуВУПП(ЗаявкаНаОплатуСсылка, НовыйСтатус) Экспорт

	Прокси = ВебСервисы_сервер.ПолучитьПрокси("ВебСервисЗаказовУПП");

	ДанныеДляПередачи = Новый Структура("ГУИД, Состояние, ОрганизацияКод");
	ДанныеДляПередачи.ГУИД = Строка(ЗаявкаНаОплатуСсылка.УникальныйИдентификатор());
	ДанныеДляПередачи.Состояние = НовыйСтатус; 
	ОрганизацияДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаявкаНаОплатуСсылка, "Организация"); 
	ДанныеДляПередачи.ОрганизацияКод = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОрганизацияДокумента, "Код"); 
	
	ПередаваемаяСтрокаXML = ОбщегоНазначения.ЗначениеВСтрокуXML(ДанныеДляПередачи); 

	ОтветУПП = Прокси.PutDocumentStatus(ПередаваемаяСтрокаXML);
	СтрокаОтвета = ОбщегоНазначения.ЗначениеИзСтрокиXML(ОтветУПП);
	Если ЗначениеЗаполнено(СтрокаОтвета.Комментарий) Тогда
		ОбщегоНазначения.СообщитьПользователю(СтрокаОтвета.Комментарий);
		Если ЗначениеЗаполнено(СтрокаОтвета.Состояние) Тогда
			ОбщегоНазначения.СообщитьПользователю("Состояние документа в УПП не изменено - " + СтрокаОтвета.Состояние);
			СтруктураПоиска = Новый Структура("ДействиеПриОбмене, УзелОбмена, Объект", Перечисления.ДействияПриОбмене.ВыгрузкаДанных, 
												Перечисления.УзлыОбмена.УПП, ЗаявкаНаОплатуСсылка);
			СтруктураДанных = Новый Структура("УИДИсточника,Статус", ДанныеДляПередачи.ГУИД, СтрокаОтвета.Состояние);
			РегистрыСведений.ПротоколОбменов.ЗафиксироватьИнформациюОЗагрузке(СтруктураПоиска, СтруктураДанных,,Истина); 
		КонецЕсли;
		Возврат Ложь;
	Иначе	 
		СтруктураПоиска = Новый Структура("ДействиеПриОбмене, УзелОбмена, Объект", Перечисления.ДействияПриОбмене.ВыгрузкаДанных, 
		Перечисления.УзлыОбмена.УПП, ЗаявкаНаОплатуСсылка);
		СтруктураДанных = Новый Структура("УИДИсточника,Статус", ДанныеДляПередачи.ГУИД, НовыйСтатус);
		РегистрыСведений.ПротоколОбменов.ЗафиксироватьИнформациюОЗагрузке(СтруктураПоиска, СтруктураДанных,,Истина); 
		
		ОбщегоНазначения.СообщитьПользователю("Состояние заявки изменено в УПП");    
		Возврат Истина;
	КонецЕсли; 
	
КонецФункции 

//Евросиб Каблов 25.09.2025 ( #104972
Функция ПолучитьНЗП(XMLParams) Экспорт
	
	Параметры = ОбщегоНазначения.ЗначениеИзСтрокиXML(XMLParams);
	
	ДатаОтчета = Неопределено;
	Если Не Параметры.Свойство("ДатаОтчета", ДатаОтчета) Тогда
		ДатаОтчета = КонецМесяца(ТекущаяДата());
	КонецЕсли;
	
	НаименованиеВалюты = Неопределено;
	Если Параметры.Свойство("НаименованиеВалюты", НаименованиеВалюты) И ЗначениеЗаполнено(НаименованиеВалюты) Тогда
		Валюта = Справочники.Валюты.НайтиПоНаименованию(НаименованиеВалюты);
		Если Не ЗначениеЗаполнено(Валюта) Тогда
			Валюта = NULL;
		КонецЕсли;
	Иначе
		Валюта = Неопределено;
	КонецЕсли;
	
	КодыОрганизаций = Неопределено;
	Организации = Новый Массив;
	Если Параметры.Свойство("КодыОрганизаций", КодыОрганизаций) И ЗначениеЗаполнено(КодыОрганизаций) Тогда
		Для Каждого КодОрганизации Из КодыОрганизаций Цикл
			Организации.Добавить(Справочники.Организации.НайтиПоКоду(КодОрганизации));
		КонецЦикла;
	КонецЕсли;
	
	КодКонтрагента = Неопределено;
	Если Параметры.Свойство("КодКонтрагента", КодКонтрагента) И ЗначениеЗаполнено(КодКонтрагента) Тогда
		Контрагент = Справочники.Контрагенты.НайтиПоКоду(КодКонтрагента);
	Иначе
		Контрагент = Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НезавершенноеПроизводствоРасширенныйОстатки.Поступление.Организация КАК Организация,
	|	НезавершенноеПроизводствоРасширенныйОстатки.Поступление КАК Поступление,
	|	НезавершенноеПроизводствоРасширенныйОстатки.Поступление.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
	|	НезавершенноеПроизводствоРасширенныйОстатки.Поступление.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
	|	НезавершенноеПроизводствоРасширенныйОстатки.Валюта КАК Валюта,
	|	НезавершенноеПроизводствоРасширенныйОстатки.Поступление.Контрагент КАК ПоступлениеКонтрагент,
	|	НезавершенноеПроизводствоРасширенныйОстатки.Акцепт КАК Акцепт,
	|	НезавершенноеПроизводствоРасширенныйОстатки.СуммаОстаток КАК СуммаОстаток,
	|	НезавершенноеПроизводствоРасширенныйОстатки.СуммаРубОстаток КАК СуммаРубОстаток,
	|	НезавершенноеПроизводствоРасширенныйОстатки.СуммаНДСОстаток КАК СуммаНДСОстаток,
	|	НезавершенноеПроизводствоРасширенныйОстатки.СуммаНДСРубОстаток КАК СуммаНДСРубОстаток
	|ПОМЕСТИТЬ НЗП
	|ИЗ
	|	РегистрНакопления.НезавершенноеПроизводствоРасширенный.Остатки(
	|			&ДатаОтчета,
	|			Выгружен
	|				И Поступление.Организация В (&Организации)
	|				И Валюта = &Валюта
	|				И Поступление.Контрагент = &Контрагент) КАК НезавершенноеПроизводствоРасширенныйОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Организации.Код КАК КодОрганизации,
	|	Контрагенты.Код КАК КодКонтрагента,
	|	ВыгруженныеПоступления.УИДИсточника КАК УИДПТУ,
	|	НЗП.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
	|	НЗП.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
	|	СчетФактураПолученный.НомерВходящегоДокумента КАК НомерВСФ,
	|	СчетФактураПолученный.ДатаВходящегоДокумента КАК ДатаВСФ,
	|	ДокументАкцепт.Номер КАК НомерАкцепта,
	|	ВыгруженныеАкцепты.УИДИсточника КАК УИДАкцепта,
	|	Валюты.Наименование КАК НаименованиеВалюты,
	|	НЗП.СуммаОстаток - НЗП.СуммаНДСОстаток КАК Сумма,
	|	НЗП.СуммаРубОстаток - НЗП.СуммаНДСРубОстаток КАК СуммаРуб,
	|	НЗП.СуммаНДСОстаток КАК СуммаНДС,
	|	НЗП.СуммаНДСРубОстаток КАК СуммаНДСРуб
	|ИЗ
	|	НЗП КАК НЗП
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО НЗП.Организация = Организации.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО НЗП.ПоступлениеКонтрагент = Контрагенты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураПолученный КАК СчетФактураПолученный
	|		ПО НЗП.Поступление = СчетФактураПолученный.ДокументОснование
	|			И (СчетФактураПолученный.Проведен)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ВыгруженныеПоступления
	|		ПО НЗП.Поступление = ВыгруженныеПоступления.Объект
	|			И (ВыгруженныеПоступления.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УПП))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
	|		ПО НЗП.Валюта = Валюты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Акцепт КАК ДокументАкцепт
	|		ПО НЗП.Акцепт = ДокументАкцепт.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ВыгруженныеАкцепты
	|		ПО НЗП.Акцепт = ВыгруженныеАкцепты.Объект
	|			И (ВыгруженныеАкцепты.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УПП))";
	
	Запрос.УстановитьПараметр("ДатаОтчета", ДатаОтчета);
	
	Если Валюта <> Неопределено Тогда
		Запрос.УстановитьПараметр("Валюта", Валюта);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Валюта = &Валюта", "");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Организации) Тогда
		Запрос.УстановитьПараметр("Организации", Организации);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Поступление.Организация В (&Организации)", "");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Контрагент) Тогда
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Поступление.Контрагент = &Контрагент", "");
	КонецЕсли;
	
	НЗП = Запрос.Выполнить().Выгрузить();
	
	ПередаваемаяСтрокаXML = ОбщегоНазначения.ЗначениеВСтрокуXML(НЗП);
	
	Возврат ПередаваемаяСтрокаXML;
	
КонецФункции

