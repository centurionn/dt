Процедура ЗаписатьПризнакСобственностиКонтейнера(Контейнер, Собственность, ДатаНачалаСобственности)
	
	Если Собственность = "own" Тогда
		ПризнакСобственности = Перечисления.ВариантыСобственности.Собственный;
		ВЭксплуатации = Истина;
	ИначеЕсли Собственность = "spot" Тогда
		ПризнакСобственности = Перечисления.ВариантыСобственности.Спот;
		ВЭксплуатации = Истина;
	ИначеЕсли Собственность = "other" Тогда
		// ДИТ 65580 Давудов М.А. Начало: 23.02.2023
		//Было:
		//ПризнакСобственности = Перечисления.ВариантыСобственности.Прочее;
		//Стало:
		ПризнакСобственности = Перечисления.ВариантыСобственности.Клиентский;
		// ДИТ 65580 Давудов М.А. Конец: 23.02.2023
		ВЭксплуатации = Ложь;
	ИначеЕсли Собственность = "leased" Тогда
		// ДИТ 65580 Давудов М.А. Начало: 23.02.2023
		//Было:
		//ПризнакСобственности = Перечисления.ВариантыСобственности.Арендованный;
		//Стало:
		ПризнакСобственности = Перечисления.ВариантыСобственности.АрендаДлительная;
		// ДИТ 65580 Давудов М.А. Конец: 23.02.2023
		ВЭксплуатации = Истина;
	Иначе
		// ДИТ 65580 Давудов М.А. Начало: 23.02.2023
		//Было:
		//ПризнакСобственности = Перечисления.ВариантыСобственности.Неизвестно;
		//Стало:
		ПризнакСобственности = Перечисления.ВариантыСобственности.ПустаяСсылка();
		// ДИТ 65580 Давудов М.А. Конец: 23.02.2023
		ВЭксплуатации = Ложь;
	КонецЕсли; 
	МенеджерЗаписи = РегистрыСведений.ПризнакСобственностиКонтейнера.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = ДатаНачалаСобственности;
	МенеджерЗаписи.Контейнер = Контейнер;
	МенеджерЗаписи.ПризнакСобственности = ПризнакСобственности;
	МенеджерЗаписи.ВЭксплуатации = ВЭксплуатации;
	МенеджерЗаписи.Записать();
	
КонецПроцедуры
	
Процедура ЗаписатьПризнакСобственностиВагона(Вагон, Собственность, ДатаНачалаСобственности,СданВАренду)
	
	Если Собственность = "own" Тогда
		ПризнакСобственности = Перечисления.ВариантыСобственности.Собственный;
		ВЭксплуатации = Истина;
	ИначеЕсли Собственность = "spot" Тогда
		ПризнакСобственности = Перечисления.ВариантыСобственности.Спот;
		ВЭксплуатации = Истина;
