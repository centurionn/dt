			ИмяФайла = КаталогВременныхФайлов() + ИмяФайлаПФ + ".pdf";
			ТабДокПротокола.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.PDF);    
			ПрикрепленныйФайл = РаботаСФайлами.ДобавитьФайлСДиска(ДокументПСЦ, ИмяФайла);
			ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ИмяФайла);   
			СтрокаПФ = Base64Строка(ДвоичныеДанныеФайла); 
			НС = ТЗФайлы.Добавить();
