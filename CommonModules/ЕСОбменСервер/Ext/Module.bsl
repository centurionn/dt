	Запрос.УстановитьПараметр("ДатаПо", ДатаОкончания);
	МассивВидовПеревозок= Новый Массив;
	МассивВидовПеревозок.Добавить(Справочники.ВидыПеревозок.Транзит);
	МассивВидовПеревозок.Добавить(Справочники.ВидыПеревозок.ТранзитМоре);
	Запрос.УстановитьПараметр("СписокТранзит", МассивВидовПеревозок);
	Запрос.УстановитьПараметр("СписокЭкспортИмпорт", МассивВидовПеревозок);
	
	Результат = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Возврат ОбщегоНазначения.ЗначениеВСтрокуXML(Результат);	

КонецФункции // ПередатьРеестрНДСЭкспортИмпорт()

Функция ПередатьРеестрНДС(xmlParams) Экспорт
	
	Параметры = ОбщегоНазначения.ЗначениеИзСтрокиXML(XMLParams);
	//++ Глеков Д.В. Ticket#0257625  21.01.2022  
	//для экспорта/импорта как временная заплатка
	Если Параметры.ТипПеревозки = 1 Тогда
	
		Возврат ПередатьРеестрНДСЭкспортИмпорт(Параметры.НачалоПериода, Параметры.КонецПериода);
	
	КонецЕсли;
	//-- Глеков Д.В. Ticket#0257625  21.01.2022
	ТекстЗапроса = ПолучитьТекстЗапросаРеестрНДС(Параметры.ТипПеревозки);    
	
	//Евросиб(ДИТ) Антонова А.С. US 87497 ТА 104723 Начало 22.05.2025
	Если ТекстЗапроса = "" Тогда
		Возврат "";
	КонецЕсли;
	//Евросиб(ДИТ) Антонова А.С. US 87497 ТА 104723 Конец 22.05.2025   
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("НачалоПериода", Параметры.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", Параметры.КонецПериода);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	Для каждого СтрокаСФ Из РезультатЗапроса.Строки Цикл
		СуммаРаспределения = СтрокаСФ.НалоговаяБаза / СтрокаСФ.Номер;
	    ИтоговаяСумма = СтрокаСФ.НалоговаяБаза;
		Для каждого СтрокаНакладная Из СтрокаСФ.Строки Цикл
			СтрокаНакладная.НалоговаяБаза = СуммаРаспределения;
			ИтоговаяСумма = ИтоговаяСумма - СуммаРаспределения;
		КонецЦикла; 
		Если ИтоговаяСумма <> 0 Тогда
			СтрокаНакладная.НалоговаяБаза = СтрокаНакладная.НалоговаяБаза + ИтоговаяСумма;
		КонецЕсли; 
	КонецЦикла;   

	Возврат ОбщегоНазначения.ЗначениеВСтрокуXML(РезультатЗапроса);
	
КонецФункции

Функция ПолучитьТекстЗапросаРеестрНДС(ТипПеревозки)
	
	ТекстЗапроса = "";
	Если ТипПеревозки = 1 Тогда
		
		ТекстЗапроса = 
		
//Евросиб Литвинов КВТ ( 22.10.2021 #0247507
		"ВЫБРАТЬ
		|	СчетФактураВыданный.Ссылка КАК СчетФактура
		|ПОМЕСТИТЬ АннулированныеСчетаФактуры
		|ИЗ
		|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации КАК КорректировкаРеализации
		|		ПО (КорректировкаРеализации.ДокументРеализации = СчетФактураВыданный.ДокументОснование)
		|ГДЕ
		|	КорректировкаРеализации.Проведен
		|	И СчетФактураВыданный.Проведен
		|	И КорректировкаРеализации.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА СчетФактураВыданный.СуммаУвеличение > 0
		|			ТОГДА СчетФактураВыданный.СуммаУвеличение
		|		ИНАЧЕ СчетФактураВыданный.СуммаУменьшение
		|	КОНЕЦ КАК СуммаКорректировки,
		|	СчетФактураВыданный.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_СуммыКорректировок
		|ИЗ
		|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданный
