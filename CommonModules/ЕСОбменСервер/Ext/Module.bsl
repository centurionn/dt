Функция ПолучитьТерминал(КодСправочникаЛокаций)      
	
	НайденыйТерминал = Справочники.Локации.ПустаяСсылка();

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Локации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Локации КАК Локации
		|ГДЕ
		|	Локации.Код = &Код
		|	И Локации.Тип = &Тип
		|	И НЕ Локации.ПометкаУдаления
		|	И Локации.ТипПодрядчика = ЗНАЧЕНИЕ(Перечисление.ТипПодрядчикаТерминал.Порт)";
	
	Запрос.УстановитьПараметр("Код", КодСправочникаЛокаций);
	Запрос.УстановитьПараметр("Тип", Справочники.ТипыЛокаций.Терминал);   
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
        НайденыйТерминал = Выборка.Ссылка;
	КонецЕсли;
		
	Возврат НайденыйТерминал;
	
КонецФункции

Функция ПолучитьПортТерминалПоГуид(ГУИД) //Евросиб Шевченко А.В. US 108007 TA 108027 05.06.2025
	
	УИД = Новый УникальныйИдентификатор(ГУИД);
	
	Локация = Справочники.Локации.ПолучитьСсылку(УИД);
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|    Локации.Ссылка
	|ИЗ
	|    Справочник.Локации КАК Локации
	|ГДЕ
	|    Локации.Ссылка = &Ссылка
	|";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", Локация);
       	
	Если НЕ Запрос.Выполнить().Пустой() Тогда
		Возврат Локация;
	КонецЕсли;	
	
	Возврат Справочники.Локации.ПустаяСсылка();	
	
КонецФункции	

