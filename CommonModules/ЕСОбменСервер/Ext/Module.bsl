Процедура ЗаписатьДислокациюВагона(ДислокацияXDTO, МассивОшибок, ЭтоТест)
	
	Если ДислокацияXDTO.Свойства().Получить("AKT_NINV") <> Неопределено Тогда 
		Вагон = Справочники.ТС.НайтиПоНаименованию(ДислокацияXDTO.AKT_NINV, Истина); 	
		Если Вагон.Пустая() Тогда
			Если ЭтоТест Тогда
				ВагонОбъект = Справочники.ТС.СоздатьЭлемент();
				ВагонОбъект.Наименование = ДислокацияXDTO.AKT_NINV;
				ВагонОбъект.Записать();
				Вагон = ВагонОбъект.Ссылка;
			Иначе
				МассивОшибок.Добавить("В справочнике DataCore не найден вагон с номером " + ДислокацияXDTO.AKT_NINV);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	Иначе
		МассивОшибок.Добавить("В одной из дислокаций не заполнено обязательное поле AKT_NINV");
		Возврат;
	КонецЕсли;
	
	//Если МассивОшибок.Количество() > 0 Тогда
	//	Возврат;
	//КонецЕсли;
		
	МенеджерЗаписи = РегистрыСведений.ДислокацияВагонов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Вагон = Вагон;
	
	Если ДислокацияXDTO.Свойства().Получить("AKT_AKT_KOP") <> Неопределено И ДислокацияXDTO.Свойства().Получить("AKT_PR_KOP") <> Неопределено Тогда
//Евросиб Гудкова( 10.10.2019 
//было 		ОперацияСВагоном = Справочники.ОперацииСВагонами.НайтиПоКоду(ДислокацияXDTO.AKT_PR_KOP + ДислокацияXDTO.AKT_AKT_KOP);
		ОперацияСВагоном = Неопределено;
		ОперацииСВагономВыборка = Справочники.ОперацииСВагонами.Выбрать(,, Новый Структура("Код", ДислокацияXDTO.AKT_PR_KOP + ДислокацияXDTO.AKT_AKT_KOP));
		Пока ОперацииСВагономВыборка.Следующий() Цикл
			Если Не ОперацииСВагономВыборка.ОперацияСКТК Тогда
				ОперацияСВагоном = ОперацииСВагономВыборка.Ссылка;
				Прервать;
			КонецЕсли; 
		КонецЦикла; 
// Евросиб Гудкова) 		
		Если Не ЗначениеЗаполнено(ОперацияСВагоном) Тогда
			НоваяОперацияСВагоном = Справочники.ОперацииСВагонами.СоздатьЭлемент();
			НоваяОперацияСВагоном.Наименование = ДислокацияXDTO.AKT_PR_KOP + ДислокацияXDTO.AKT_AKT_KOP;
			НоваяОперацияСВагоном.Код = ДислокацияXDTO.AKT_PR_KOP + ДислокацияXDTO.AKT_AKT_KOP; 
			Попытка
				НоваяОперацияСВагоном.Записать();
			Исключение
				МассивОшибок.Добавить(ОписаниеОшибки());
				Возврат;
			КонецПопытки;
			ОперацияСВагоном = НоваяОперацияСВагоном.Ссылка;	
		КонецЕсли;
		МенеджерЗаписи.ОперацияСВагоном = ОперацияСВагоном;
	КонецЕсли;
	
	Если ДислокацияXDTO.Свойства().Получить("AKT_AKT_KSTN") <> Неопределено Тогда
		//Евросиб Каблов 21.09.2020 (
		//МенеджерЗаписи.СтанцияОперации = ЛокацияПоКодуСтанции(ДислокацияXDTO.AKT_AKT_KSTN);
		КодСтанции = ДислокацияXDTO.AKT_AKT_KSTN;
		
		// Евросиб Фролов (21.10.2021 Ticket№ 0243986
		//МенеджерЗаписи.СтанцияОперации = ЛокацияПоКодуСтанции(КодСтанции);
		КодДороги = Неопределено;
		Если ДислокацияXDTO.Свойства().Получить("AKT_AKT_KDOR") <> Неопределено Тогда
			КодДороги = ДислокацияXDTO.AKT_AKT_KDOR;
		КонецЕсли;
		МенеджерЗаписи.СтанцияОперации = ЛокацияПоКодуСтанции(КодСтанции, КодДороги);
		// Евросиб Фролов)
		
		Если Не ЗначениеЗаполнено(МенеджерЗаписи.СтанцияОперации) Тогда
