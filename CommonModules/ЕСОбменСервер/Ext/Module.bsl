Функция ПолучитьТаблицуОбязательныхОперацийПеревозок() Экспорт
	
	ОписаниеТиповСтрока36 = Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(36));
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОбязательныеОперацииПеревозок.ТипУчастка1.Ссылка КАК ТипУчастка1Ссылка,
	|	ОбязательныеОперацииПеревозок.ТипУчастка1.Код КАК ТипУчастка1Код,
	|	ОбязательныеОперацииПеревозок.ТипУчастка2.Ссылка КАК ТипУчастка2Ссылка,
	|	ОбязательныеОперацииПеревозок.ТипУчастка2.Код КАК ТипУчастка2Код,
	|	ОбязательныеОперацииПеревозок.ОбязательнаяОперация.Ссылка КАК ОбязательнаяОперацияСсылка,
	|	ОбязательныеОперацииПеревозок.ОбязательнаяОперация.Код КАК ОбязательнаяОперацияКод
	|ИЗ
	|	РегистрСведений.ОбязательныеОперацииПеревозок КАК ОбязательныеОперацииПеревозок
	|ГДЕ
	|	НЕ ОбязательныеОперацииПеревозок.ТипУчастка1.ПометкаУдаления
	|	И НЕ ОбязательныеОперацииПеревозок.ТипУчастка2.ПометкаУдаления
	|	И НЕ ОбязательныеОперацииПеревозок.ОбязательнаяОперация.ПометкаУдаления";
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Таблица.Колонки.Вставить(2, "ТипУчастка1УИД", ОписаниеТиповСтрока36);
	Таблица.Колонки.Вставить(5, "ТипУчастка2УИД", ОписаниеТиповСтрока36);
	Таблица.Колонки.Добавить("ОбязательнаяОперацияУИД", ОписаниеТиповСтрока36);
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.ТипУчастка1Ссылка) Тогда
			СтрокаТаблицы.ТипУчастка1УИД = СтрокаТаблицы.ТипУчастка1Ссылка.УникальныйИдентификатор();
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.ТипУчастка2Ссылка) Тогда
			СтрокаТаблицы.ТипУчастка2УИД = СтрокаТаблицы.ТипУчастка2Ссылка.УникальныйИдентификатор();
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.ОбязательнаяОперацияСсылка) Тогда
			СтрокаТаблицы.ОбязательнаяОперацияУИД = СтрокаТаблицы.ОбязательнаяОперацияСсылка.УникальныйИдентификатор();
		КонецЕсли;		
		
	КонецЦикла;
	
	Таблица.Колонки.Удалить("ТипУчастка1Ссылка");
	Таблица.Колонки.Удалить("ТипУчастка2Ссылка");
	Таблица.Колонки.Удалить("ОбязательнаяОперацияСсылка");
	
	Возврат Таблица;
	
КонецФункции

