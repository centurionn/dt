				КонецПопытки;
				
			Иначе
				Если ВыборкаДанныеДляЗагрузки.РефСцепаПометкаУдаления Тогда
					РефСцепаОбъект = РефСцеп.ПолучитьОбъект();
					РефСцепаОбъект.ПометкаУдаления = Ложь;
					Попытка
						РефСцепаОбъект.Записать();
					Исключение
						Тема = "Рег. задание: Загрузка вагонов в реф сцепах из РИТМа";
						ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()); 
						ТекстСообщения = "Ошибки и уведомления при выполнении рег. задания:
						|" + ПредставлениеОшибки;
						РаботаСоСделкамиСервер.ВыполнитьОтправкуУведомлений(Тема, ТекстСообщения, Метаданные.РегламентныеЗадания.ЗагрузкаИзИРСВагоновВРефСцепах);
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		//проверяем есть ли Контейнер в бд, если нет, то создаем новый. Если есть, проверяем пометку удаления	
		Если Не ЗначениеЗаполнено(ВыборкаДанныеДляЗагрузки.Контейнер) И ЗагруженныеКонтейнеры.Получить(ВыборкаДанныеДляЗагрузки.НомерКонтейнера) = Неопределено Тогда
			
			Контейнер = Справочники.ТЕ.СоздатьЭлемент();
			Контейнер.Префикс = "ETSN";
			Контейнер.Номер = ВыборкаДанныеДляЗагрузки.НомерКонтейнера;
			
			Попытка
				Контейнер.Записать();
				
				ЗагруженныеКонтейнеры.Вставить(ВыборкаДанныеДляЗагрузки.НомерКонтейнера, Контейнер.Ссылка);
				
				ЗаписьКонтейнер = РегистрыСведений.ИсточникСозданияКонтейнеров.СоздатьМенеджерЗаписи();
