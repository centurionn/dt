			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;	
		
	// прикрепляем лист согласования и скан-копию подписанного ПСЦ    
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Файлы.Ссылка КАК Файл,
		|	Файлы.Наименование КАК Имя,
		|	Файлы.Расширение КАК Расширение,
		|	Файлы.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.Файлы КАК Файлы
		|ГДЕ
		|	Файлы.ВладелецФайла = &ВладелецФайла
		|	И Файлы.Наименование ПОДОБНО ""%Лист согласования%""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Файлы.Ссылка,
		|	Файлы.Наименование,
		|	Файлы.Расширение,
		|	Файлы.ПометкаУдаления
		|ИЗ
		|	Справочник.Файлы КАК Файлы
		|ГДЕ
		|	Файлы.ВладелецФайла = &ВладелецФайла
		|	И Файлы.ЭтоСканКопия";
	
	Запрос.УстановитьПараметр("ВладелецФайла", ДокументПСЦ);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ДвоичныеДанныеЛС = РаботаСФайлами.ДвоичныеДанныеФайла(Выборка.Файл,Ложь); 
