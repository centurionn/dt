	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	|			ПО РеализацияТоваровУслугУслуги.Номенклатура = ПротоколОбменов.Объект
	|				И (ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УПП))
	|				И (ПротоколОбменов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных))
	|		ПО СсылкиНаДокументы.Ссылка = РеализацияТоваровУслугУслуги.Ссылка";
	
#КонецОбласти 	
	Запрос.УстановитьПараметр("СсылкиНаДокументы", СсылкиНаДокументы);
	
	Результаты = Запрос.ВыполнитьПакет();		
	Шапки = Результаты[1].Выгрузить(); 
	ТЧУслуги = Результаты[2].Выгрузить();
//	ТЧАгентскиеУслуги = Результаты[3].Выгрузить();
	
	СтруктураШапкиИТЧУслуги = Новый Структура;
	СтруктураШапкиИТЧУслуги.Вставить("Шапки", Шапки);
	СтруктураШапкиИТЧУслуги.Вставить("ТЧУслуги", ТЧУслуги);
	
	ПередаваемаяСтрокаXML = ОбщегоНазначения.ЗначениеВСтрокуXML(СтруктураШапкиИТЧУслуги); 
	
	Возврат ПередаваемаяСтрокаXML;		

КонецФункции // ПолучитьДанныеПоИСФ(XMLParams)

Функция ПередатьДанныеПоКоррИСФ(XMLParams) Экспорт

	ГУИДДокументов =  ОбщегоНазначения.ЗначениеИзСтрокиXML(XMLParams);
	СсылкиНаДокументы = Новый ТаблицаЗначений;
	СсылкиНаДокументы.Колонки.Добавить("ГУИД",Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(36)));
	СсылкиНаДокументы.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.КорректировкаРеализации"));
	
	Для Каждого СтрокаГУИД Из ГУИДДокументов Цикл
		Строка = СсылкиНаДокументы.Добавить();
		Строка.ГУИД = СтрокаГУИД;
		Строка.Ссылка = Документы.КорректировкаРеализации.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.ГУИД));
	КонецЦикла;
#Область Запрос
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СсылкиНаДокументы.ГУИД КАК ГУИД,
	|	СсылкиНаДокументы.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ СсылкиНаДокументы
	|ИЗ
	|	&СсылкиНаДокументы КАК СсылкиНаДокументы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СсылкиНаДокументы.ГУИД КАК ГУИД,
	|	Контрагенты.УИДИсточника КАК УИДКонтрагента,
	|	ДоговорыКонтрагентов.УИДИсточника КАК УИДДоговораКонтрагента,
	|	ПОДСТРОКА(КорректировкаРеализации.Комментарий, 1, 1000) КАК Комментарий,
	|	КорректировкаРеализации.КратностьВзаиморасчетов КАК КратностьВзаиморасчетов,
	|	КорректировкаРеализации.КурсВзаиморасчетов КАК КурсВзаиморасчетов,
	|	ПРЕДСТАВЛЕНИЕ(КорректировкаРеализации.Ответственный) КАК ОтветственныйНаименование,
	|	КорректировкаРеализации.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	КорректировкаРеализации.СуммаДокумента КАК СуммаДокумента,
	|	КорректировкаРеализации.УчитыватьНДС КАК УчитыватьНДС,
	|	ПРЕДСТАВЛЕНИЕ(КорректировкаРеализации.Автор) КАК АвторНаименование,
	|	Грузополучатели.УИДИсточника КАК УИДГрузополучателя,
	|	Грузоотправители.УИДИсточника КАК УИДГрузоотправителя,
	|	ПоставщикиВУ.УИДИсточника КАК УИДПоставщикаВУ,
	|	ПокупателиВУ.УИДИсточника КАК УИДПокупателяВУ,
	|	Продавцы.УИДИсточника КАК УИДПродавца,
	|	ЛОЖЬ КАК ЭЦП,
	|	ВЫБОР
	|		КОГДА КорректировкаРеализации.ДатаДокумента = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА КорректировкаРеализации.Дата
	|		ИНАЧЕ КорректировкаРеализации.ДатаДокумента
	|	КОНЕЦ КАК ДатаАкта,  
	// Евросиб(ДИТ) US 98305 ТА 99114 Сержантова А.С. Начало: 21.01.2025
	|	КорректировкаРеализации.ПериодВО КАК ПериодВО,
	// Евросиб(ДИТ) US 98305 ТА 99114 Сержантова А.С. Конец: 21.01.2025
	|	ВЫБОР
	|		КОГДА КорректировкаРеализации.ДокументРеализации.ДатаДокумента = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА КорректировкаРеализации.ДокументРеализации.Дата
	|		ИНАЧЕ КорректировкаРеализации.ДокументРеализации.ДатаДокумента
	|	КОНЕЦ КАК ДатаКорректируемогоАкта,
	|	КорректировкаРеализации.НомерДляПечати КАК НомерАкта,
	|	КорректировкаРеализации.Организация.Код КАК ОрганизацияКод,
	|	КорректировкаРеализации.ПодразделениеОрганизации.Код КАК ПодразделениеОрганизацииКод,
	|	КорректировкаРеализации.ЦФО.Код КАК ЦФОКод,
	|	КорректировкаРеализации.ВалютаДокумента.Код КАК ВалютаДокументаКод,
	|	ВЫБОР
	|		КОГДА СчетФактураВыданный.ДатаДокумента = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА СчетФактураВыданный.Дата
	|		ИНАЧЕ СчетФактураВыданный.ДатаДокумента
	|	КОНЕЦ КАК ДатаИСФ,
	|	СчетФактураВыданный.НомерДляПечати КАК НомерИСФ,
	|	СчетНаОплатуДокументыОснования.Ссылка.НомерДляПечати КАК НомерСчета,
	|	ВЫБОР
	|		КОГДА СчетНаОплатуДокументыОснования.Ссылка.ДатаДокумента = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА СчетНаОплатуДокументыОснования.Ссылка.Дата
	|		ИНАЧЕ СчетНаОплатуДокументыОснования.Ссылка.ДатаДокумента
	|	КОНЕЦ КАК ДатаСчета,
	|	КорректировкаРеализации.БанковскийСчетОрганизации.НомерСчета КАК БанковскийСчетОрганизацииНомерСчета,
	|	КорректировкаРеализации.ВидОперации КАК ВидОперации,
	|	ДокументыРеализации.УИДИсточника КАК ГУИДДокументаРеализации,
