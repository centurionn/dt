				СтрокаПФ = Base64Строка(ДвоичныеДанныеЛС);   
				НС = ТЗФайлы.Добавить();
				НС.Файл 			= СтрокаПФ;  
				НС.Расширение 		= Выборка.Расширение; 
				НС.ПометкаУдаления	= Выборка.ПометкаУдаления;
				НС.Имя 				= Выборка.Имя;   
				НС.ГуидФайла 		= Выборка.Файл.УникальныйИдентификатор();
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли; 
	
	Возврат ТЗФайлы;
	
КонецФункции 
	
// ДИТ US 64822 Сержантова А.С. Начало: 30.06.2023
Функция ПодготовитьТаблицуПСЦдляОтправкиДО(СсылкиПСЦ) Экспорт
	
	Если ТипЗнч(СсылкиПСЦ) <> Тип("Массив") Тогда
		МассивСсылокПСЦ = Новый Массив;
		МассивСсылокПСЦ.Добавить(СсылкиПСЦ);
	Иначе
		МассивСсылокПСЦ = СсылкиПСЦ;
	КонецЕсли;   
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Ссылка");
	ТЗ.Колонки.Добавить("Номер");
	ТЗ.Колонки.Добавить("Ссылка_В_ДО");
	ТЗ.Колонки.Добавить("Сообщение");
	// ДИТ Ticket 0390645 ТА 112121 Дедуник Д.О. Начало: 17.07.2025
	ТЗ.Колонки.Добавить("УИД");
	// ДИТ Ticket 0390645 ТА 112121 Дедуник Д.О. Конец: 17.07.2025
	
	Для каждого Стр  Из МассивСсылокПСЦ Цикл
		НС = ТЗ.Добавить();
		НС.Ссылка = Стр;
		НС.Номер = Стр.НомерПСЦ;
		// ДИТ Ticket 0390645 ТА 112121 Дедуник Д.О. Начало: 17.07.2025
		НС.УИД = Строка(Стр.УникальныйИдентификатор());
		// ДИТ Ticket 0390645 ТА 112121 Дедуник Д.О. Конец: 17.07.2025
	КонецЦикла;

	Возврат ТЗ;
	
КонецФункции // ПодготовитьТаблицуПСЦдляОтправкиДО()

