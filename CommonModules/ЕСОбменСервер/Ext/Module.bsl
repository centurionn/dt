		|ВЫБРАТЬ
		|	РелизСобственникаНоминации.Ссылка КАК Ссылка,
		|	РелизСобственникаНоминации.ГУИДСтроки КАК ГУИДСтроки,
		|	РелизСобственникаНоминации.Контейнер КАК Контейнер,
		|	РелизСобственникаНоминации.тек_СобственностьКТК КАК ВидСобственности,
		|	РелизСобственникаНоминации.ДатаВзятия КАК ДатаВзятия,
		|	РелизСобственникаНоминации.Ставка КАК Ставка,
		|	ЕСТЬNULL(РелизСобственникаНоминации.Валюта.Код, """") КАК Валюта,
		|	РелизСобственникаНоминации.СтавкаНДС КАК СтавкаНДС,
		|	РелизСобственникаНоминации.НДСВключая КАК НДСВключая,
		|	РелизСобственникаНоминации.ДатаВозвратаСобственнику КАК ДатаВозвратаСобственнику
		|ИЗ
		|	ВТ_РелизыСобственника КАК ВТ_РелизыСобственника
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
		|		ПО ВТ_РелизыСобственника.Ссылка = РелизСобственникаНоминации.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_РелизыСобственника.Ссылка КАК Ссылка,
		|	РелизСобственникаСНП.НомерСтроки КАК НомерСтроки,
		|	РелизСобственникаСНП.ГУИДСтроки КАК ГУИДСтроки,
		|	РелизСобственникаСНП.От КАК От,
		|	РелизСобственникаСНП.До КАК До,
		|	РелизСобственникаСНП.Стоимость КАК Стоимость
		|ИЗ
		|	ВТ_РелизыСобственника КАК ВТ_РелизыСобственника
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РелизСобственника.СНП КАК РелизСобственникаСНП
		|		ПО ВТ_РелизыСобственника.Ссылка = РелизСобственникаСНП.Ссылка";
		
		//Евросиб Каблов 20.05.2025 ( #110106
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 11", ТекстОграниченияПорции);
		//Евросиб Каблов 20.05.2025 )
		
		//Евросиб Шевченко А.В. US 106313 TA 109960 22.05.2025
		Запрос.УстановитьПараметр("УзелБФ", Перечисления.УзлыОбмена.БитФинанс);
		//Евросиб Шевченко А.В. US 106313 TA 109960 22.05.2025
		Запрос.УстановитьПараметр("УзелОбмена", УзелОбмена);
		РезультатЗапросаПакет = Запрос.ВыполнитьПакет();
	
	КонецЕсли; 
	
	Возврат ВыгрузитьРелизыСобственника(РезультатЗапросаПакет, УзелОбмена, НастройкаОбмена);
	
КонецФункции
//Евросиб(ДИТ), Беляев СЮ, BUG 95529 / TA 95530, 18-11-2024, конец

//Евросиб(ДИТ), Беляев СЮ, BUG 95529 / TA 95530, 18-11-2024, начало
Функция ВыгрузитьРелизыСобственника(РезультатЗапросаПакет, УзелОбмена, НастройкаОбмена)
	
	ВыборкаИзменений = РезультатЗапросаПакет[2].Выбрать();
	ТаблицаКонтейнеров = РезультатЗапросаПакет[3].Выгрузить();
	ТаблицаСНП = РезультатЗапросаПакет[4].Выгрузить();
	
	Если ТаблицаКонтейнеров.Количество()>1000 Тогда
		ТаблицаКонтейнеров.Индексы.Добавить("Ссылка");
	КонецЕсли;
	Если ТаблицаСНП.Количество()>1000 Тогда
		ТаблицаСНП.Индексы.Добавить("Ссылка");
	КонецЕсли;

	РелизСобственникаТип 	= ФабрикаXDTO.Тип("XMLOwnerRelease", "РелизСобственника"); 
	РелизыСобственникаТип 	= ФабрикаXDTO.Тип("XMLOwnerRelease", "РелизыСобственника");
	ЛокацияТип 				= ФабрикаXDTO.Тип("XMLOwnerRelease", "Локация"); 
	СписокЛокацийТип		= ФабрикаXDTO.Тип("XMLOwnerRelease", "СписокЛокаций");
	КонтейнерТип 			= ФабрикаXDTO.Тип("XMLOwnerRelease", "Контейнер"); 
	СписокКонтейнеровТип 	= ФабрикаXDTO.Тип("XMLOwnerRelease", "СписокКонтенеров");
	СНПСтрокаТип 			= ФабрикаXDTO.Тип("XMLOwnerRelease", "СНПСтрока"); 
	СНПСписокТип 			= ФабрикаXDTO.Тип("XMLOwnerRelease", "СНПСписок");
	//Евросиб Шевченко А.В. US 106313 TA 109960 22.05.2025
	ДоговорТип				= ФабрикаXDTO.Тип("XMLOwnerRelease", "Договор");
	//Евросиб Шевченко А.В. US 106313 TA 109960 22.05.2025
	
	Релизы = ФабрикаXDTO.Создать(РелизыСобственникаТип);
	
	ТабОтправки = Новый ТаблицаЗначений;
	ТабОтправки.Колонки.Добавить("ГУИД");  
	ТабОтправки.Колонки.Добавить("РелизСобственника");
	
	//Евросиб Каблов 20.05.2025 ( #110106
	Счетчик = 0;
	ОсталисьДанныеДляВыгрузки = Ложь;
	КоличествоЗаписейВПорцииДанных = НастройкаОбмена.КоличествоЗаписейВПорцииДанных;
	Если ЗначениеЗаполнено(КоличествоЗаписейВПорцииДанных) Тогда
		ОграничиватьПорцию = Истина;
	Иначе
		ОграничиватьПорцию = Ложь;
	КонецЕсли;
	//Евросиб Каблов 20.05.2025 )
	
	Пока ВыборкаИзменений.Следующий() Цикл
		
		//Евросиб Каблов 20.05.2025 ( #110106
		Счетчик = Счетчик + 1;
		Если ОграничиватьПорцию И Счетчик > КоличествоЗаписейВПорцииДанных Тогда
			ОсталисьДанныеДляВыгрузки = Истина;
			Прервать;
		КонецЕсли;
		//Евросиб Каблов 20.05.2025 )
		
		Релиз = ФабрикаXDTO.Создать(РелизСобственникаТип);
		ЗаполнитьЗначенияСвойств(Релиз, ВыборкаИзменений, "Дата, Номер, Проведен, ПометкаУдаления");
		Релиз.ГУИД = Строка(ВыборкаИзменений.ГУИД);
		
		ЛокацияВзятия = ЗаполнитьЛокациюXDTO(ВыборкаИзменений.ЛокацияНаименование, ВыборкаИзменений.ЛокацияТип, ВыборкаИзменений.ЛокацияКод, 
											 ВыборкаИзменений.ЛокацияКодПорта, ВыборкаИзменений.ЛокацияКодЖДСтанции); 
		Релиз.ЛокацияВзятия = ЛокацияВзятия;
		
		//Евросиб Шевченко А.В. US 106313 TA 109960 22.05.2025
		Договор 				= ФабрикаXDTO.Создать(ДоговорТип);
		Договор.ГУИД 			= ВыборкаИзменений.ДоговорГУИД;
		Договор.Наименование 	= ВыборкаИзменений.ДоговорНаименование;
		Релиз.Договор			= Договор;
		//Евросиб Шевченко А.В. US 106313 TA 109960 22.05.2025
		
		СписокЛокацийСдачи = ФабрикаXDTO.Создать(СписокЛокацийТип);
		Если ТипЗнч(ВыборкаИзменений.ЛокацияСдачи) = Тип("СправочникСсылка.Мультилокации") Тогда
		    РезультатЛокацииСдачи = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыборкаИзменений.ЛокацияСдачи, "Локации");
			Если РезультатЛокацииСдачи <> Неопределено Тогда //Евросиб(ДИТ), Беляев СЮ, US 86002/TA 89992, 15-08-2024, добавил проверку
				ВыборкаЛокаций = РезультатЛокацииСдачи.Выбрать();
				Пока ВыборкаЛокаций.Следующий() Цикл
					РеквизитыЛокации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаЛокаций.Локация, 
					"Наименование, Код, Тип, КодПортаUNLOCODE, КодЖДСтанции"); 
					ЛокацияСдачи = ЗаполнитьЛокациюXDTO(РеквизитыЛокации.Наименование, РеквизитыЛокации.Тип, 
					РеквизитыЛокации.Код, РеквизитыЛокации.КодПортаUNLOCODE, РеквизитыЛокации.КодЖДСтанции);
					СписокЛокацийСдачи.ЛокацияСдачи.Добавить(ЛокацияСдачи);
				КонецЦикла;
			КонецЕсли;
		Иначе
			ЛокацияСдачи = ЗаполнитьЛокациюXDTO(ВыборкаИзменений.ЛокацияСдачиНаименование, ВыборкаИзменений.ЛокацияСдачиТип, 
											ВыборкаИзменений.ЛокацияСдачиКод, 
											ВыборкаИзменений.ЛокацияСдачиКодПорта, ВыборкаИзменений.ЛокацияСдачиКодЖДСтанции);
			СписокЛокацийСдачи.ЛокацияСдачи.Добавить(ЛокацияСдачи);
		КонецЕсли; 
		Релиз.ЛокацииСдачи = СписокЛокацийСдачи;  
		
		СписокКонтейнеров = ФабрикаXDTO.Создать(СписокКонтейнеровТип);
		
		ПоискНоминацийРелиза = Новый Структура("Ссылка", ВыборкаИзменений.РелизСобственника);
		СтрокиПоРелизу = ТаблицаКонтейнеров.НайтиСтроки(ПоискНоминацийРелиза);
		Для Каждого ВыборкаКонтейнеры Из СтрокиПоРелизу Цикл
			СтрокаКонтейнеров = ФабрикаXDTO.Создать(КонтейнерТип); 
			ЗаполнитьЗначенияСвойств(СтрокаКонтейнеров, ВыборкаКонтейнеры, "ДатаВзятия, ДатаВозвратаСобственнику, Валюта, НДСВключая, Ставка"); 
			Если ЗначениеЗаполнено(ВыборкаКонтейнеры.Контейнер) Тогда
				РеквизитыКонтенера = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаКонтейнеры.Контейнер, "Префикс,Номер,КонтрольноеЧисло");
				СтрокаКонтейнеров.НомерКонтейнера = РеквизитыКонтенера.Префикс + РеквизитыКонтенера.Номер + РеквизитыКонтенера.КонтрольноеЧисло;
			Иначе
				СтрокаКонтейнеров.НомерКонтейнера = "";
			КонецЕсли;           
			СтрокаКонтейнеров.ВидСобственности = Строка(ВыборкаКонтейнеры.ВидСобственности);
			СтрокаКонтейнеров.СтавкаНДС = Строка(ВыборкаКонтейнеры.СтавкаНДС);
			ПоискСтроки = Новый Структура("Ссылка, ГУИДСтроки", ВыборкаИзменений.РелизСобственника, ВыборкаКонтейнеры.ГУИДСтроки);
			СтрокиСНП = ТаблицаСНП.НайтиСтроки(ПоискСтроки);
			
			СписокСНП = ФабрикаXDTO.Создать(СНПСписокТип); 
			Для Каждого СтрокаСНП Из СтрокиСНП Цикл
				СНПСтрока = ФабрикаXDTO.Создать(СНПСтрокаТип);
				ЗаполнитьЗначенияСвойств(СНПСтрока, СтрокаСНП);
				СписокСНП.СтрокаСНП.Добавить(СНПСтрока);
			КонецЦикла;  
			СтрокаКонтейнеров.СНП = СписокСНП;  
			СписокКонтейнеров.Контейнер.Добавить(СтрокаКонтейнеров);
		КонецЦикла;
		
		Релиз.Контейнеры = СписокКонтейнеров;
		Релизы.РелизСобственника.Добавить(Релиз);
		
		НС = ТабОтправки.Добавить();
		НС.ГУИД = Строка(ВыборкаИзменений.ГУИД);
		НС.РелизСобственника = ВыборкаИзменений.РелизСобственника;
	КонецЦикла;
	
	//Евросиб Каблов 20.05.2025 ( #110106
	Релизы.ОсталисьДанныеДляВыгрузки = ОсталисьДанныеДляВыгрузки;
	//Евросиб Каблов 20.05.2025 )
	
	ЗаписьXML = Новый ЗаписьXML;
    ЗаписьXML.УстановитьСтроку();
    ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, Релизы);
    ТекстОбъектаXDTO = ЗаписьXML.Закрыть(); 
	
	//Фиксируем информацию об отправке
	ВремяВыгрузки = ТекущаяДата();
	Для каждого СтрокаОтправки Из ТабОтправки Цикл
		СтруктураПоиска = Новый Структура("ДействиеПриОбмене, УзелОбмена, Объект", Перечисления.ДействияПриОбмене.ВыгрузкаДанных,УзелОбмена,СтрокаОтправки.РелизСобственника);
		СтруктураДанных = Новый Структура("УИДИсточника, ЗагрузкаПодтверждена, ДатаОбмена",СтрокаОтправки.ГУИД,Ложь,ВремяВыгрузки);
		РегистрыСведений.ПротоколОбменов.ЗафиксироватьИнформациюОЗагрузке(СтруктураПоиска, СтруктураДанных);
	КонецЦикла;
	
	Возврат ТекстОбъектаXDTO;

КонецФункции
//Евросиб(ДИТ), Беляев СЮ, BUG 95529 / TA 95530, 18-11-2024, конец

//Евросиб(ДИТ), Беляев СЮ, BUG 95529 / TA 95530, 18-11-2024, начало
Функция ЗаполнитьЛокациюXDTO(Наименование, Тип, Код, КодПорта, КодЖДСтанции)
	
	ЛокацияТип = ФабрикаXDTO.Тип("XMLOwnerRelease", "Локация"); 
	
	Локация = ФабрикаXDTO.Создать(ЛокацияТип);
	
	Если СокрЛП(Наименование) <> "" ИЛИ СокрЛП(Тип) <> "" Тогда //Евросиб(ДИТ), Беляев СЮ, US 86002/TA 89992, 15-08-2024, добавил проверку на пустые поля
		Локация.ТипЛокации = Строка(Тип);
		Локация.Наименование = Строка(Наименование);
		Если Тип = Справочники.ТипыЛокаций.Терминал Тогда
			Локация.Код = Строка(Код);
		ИначеЕсли Тип = Справочники.ТипыЛокаций.Порт Тогда 
			Локация.Код = Строка(КодПорта);
		ИначеЕсли Тип = Справочники.ТипыЛокаций.СтанцияЖД Тогда	
			Локация.Код = Строка(КодЖДСтанции);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Локация;

КонецФункции
//Евросиб(ДИТ), Беляев СЮ, BUG 95529 / TA 95530, 18-11-2024, конец

Функция СоздатьРейс(XMLParams) Экспорт
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(XMLParams);
	
	Фабрика = Новый ФабрикаXDTO;
	ОбъектXDTO = Фабрика.ПрочитатьXML(Чтение);
	
	НомерПоезда = 0;
	ПунктОтправления = Справочники.Локации.ПустаяСсылка();
	ПунктНазначения = Справочники.Локации.ПустаяСсылка(); 
	// Евросиб(ДИТ) US 85377 ТА 85380 Сержантова А.С. Начало: 09.07.2024
	// Было:
	//ДатаОтправления = '00010101';
	//ДатаПрибытия = '00010101'; 
	//Стало:
	ДатаОтправленияПлан = '00010101'; 
	ДатаОтправленияФакт = '00010101';
	ДатаОтправленияЖДН = '00010101';
	ДатаПрибытияПлан = '00010101'; 
	ДатаПрибытияФакт = '00010101'; 
	ДатаПрибытияЖДН = '00010101';
	// Евросиб(ДИТ) US 85377 ТА 85380 Сержантова А.С. Конец: 09.07.2024
	
	//ДИТ Шевченко А.В. US 66360 ТА 72965 26.07.2023
	//Сервис = Справочники.Продукты.ПустаяСсылка();
	Сервис = Справочники.СервисыУчетноеНаправление.ПустаяСсылка();
	Примечание = "";
	//Продукт = Справочники.Продукты.ПустаяСсылка();
	УчетноеНаправление = Справочники.СервисыУчетноеНаправление.ПустаяСсылка();
	//ДИТ Шевченко А.В. US 66360 ТА 72965 26.07.2023
	УсловнаяДлинаСостава = 0;
	РейсОтменен = Ложь;
	Автор = Справочники.Пользователи.ПустаяСсылка();
	Клиент = Справочники.Контрагенты.ПустаяСсылка();
	ГУИД_DX = "";
	
	//ДИТ, Беляев СЮ, US 68290 / TA 68860, 21-04-2023, начало
	ТаблицаРеестрКонтейнеров = Новый ТаблицаЗначений;
	ТаблицаФактическийСоставПоезда = Новый ТаблицаЗначений;
	//ДИТ, Беляев СЮ, US 68290 / TA 68860, 21-04-2023, конец
	
	//ДИТ Шевченко А.В. US 66360 ТА 73009 01.08.2023
	ТаблицаРеестрПродуктов = Новый ТаблицаЗначений;
	СхемаПеревозки = Справочники.СхемыПеревозки.ПустаяСсылка();
	ОтрезокСхемыПеревозки = Справочники.ОтрезкиСхемПеревозок.ПустаяСсылка();
	СхемаНаименование = "";
	СхемаКод = "";
	ОтрезокСхемыНаименование = "";
	ОтрезокСхемыКод = "";
	//ДИТ Шевченко А.В. US 66360 ТА 73009 01.08.2023 
	
	//ДИТ Шевченко А.В. US 102893 ТА 111601 11.07.2025
	Перегруз = 0;
	ПредыдущаяОтправка = 0;
	Входящий = 0;
	РеестрКонтейнеровСвязанногоРейса = Новый ТаблицаЗначений;
	//ДИТ Шевченко А.В. US 102893 ТА 111601 11.07.2025
	
	//Субботин 75866 начало 05.10.2023
	ПунктОтправленияКод = "";
	ПунктНазначенияКод = "";
	//Субботин 75866 конец  05.10.2023
	
	//Евросиб Каблов 09.10.2024 ( Ticket#0367291
	НомерЛота = "";
	//Евросиб Каблов 09.10.2024 )
	
	//Евросиб(ДИТ), Беляев СЮ, US 87368 / TA 91097, 14-10-2024, начало
	КТК_DX = "";
	ПлановаяВыручка_DX = 0;
	//Евросиб(ДИТ), Беляев СЮ, US 87368 / TA 91097, 14-10-2024, конец
	
