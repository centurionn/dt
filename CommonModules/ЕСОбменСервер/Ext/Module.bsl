	Исключение 
		СтруктураДанныеКТК.Вставить("КТК", Справочники.ТЕ.ПустаяСсылка());
		СтруктураДанныеКТК.Вставить("ТипТЕ", Справочники.ТипоразмерыТЕ.ПустаяСсылка());		
	КонецПопытки;
	
	Возврат СтруктураДанныеКТК 
	
КонецФункции

