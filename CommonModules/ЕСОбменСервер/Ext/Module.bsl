Функция ТипизироватьТаблицуВагонов(ТаблицаВагонов)

	//ДИТ Моисеенко Ю.В. 03.11.2022 59323 -начало
	ТЗ = Новый ТаблицаЗначений;
	
	Для Каждого Колонка Из ТаблицаВагонов.Колонки Цикл
		Если Колонка.Имя = "hitchNum" Тогда 
			Тип = ОбщегоНазначения.ОписаниеТипаЧисло(2, 0);
		Иначе
			Тип = ОбщегоНазначения.ОписаниеТипаСтрока(60);
		КонецЕсли;
		
		ТЗ.Колонки.Добавить(Колонка.Имя, Тип);
	КонецЦикла;
	
	ТЗ.Колонки.Добавить("НомерКонтейнера", ОбщегоНазначения.ОписаниеТипаСтрока(60));
	ДлинаНомераКонтейнера = 6;
	
	Для Каждого СтрокаВагон Из ТаблицаВагонов Цикл
		НоваяСтрока = ТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаВагон);
		
		НоваяСтрока.НомерКонтейнера = НоваяСтрока.refHitch;
		
		Пока СтрДлина(НоваяСтрока.НомерКонтейнера) < 6 Цикл
			НоваяСтрока.НомерКонтейнера = "0" + НоваяСтрока.НомерКонтейнера;	
		КонецЦикла;
		
	КонецЦикла; 
	
	Возврат ТЗ;
	//ДИТ Моисеенко Ю.В. 03.11.2022 59323 -конец
	
