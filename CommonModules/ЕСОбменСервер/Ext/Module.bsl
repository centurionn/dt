//Евросиб Каблов 03.02.2025 #100569
Функция ПолучитьЕдиницыИзмерения(ИмяУзла, ТолькоИзменения) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ИмяУзла) Тогда
		Возврат "<xml><error>Пустое значение параметра RequestingSystem!</error></xml>";
	КонецЕсли;  
	
	УзелОбмена = Неопределено;
	Для каждого ЗначПеречисления Из Метаданные.Перечисления.УзлыОбмена.ЗначенияПеречисления Цикл
		Если ЗначПеречисления.Имя = ИмяУзла Тогда
			УзелОбмена = Перечисления.УзлыОбмена[ЗначПеречисления.Имя];  
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	
	Если УзелОбмена = Неопределено Тогда
		Возврат "<xml><error>Не найден узел обмена по входному параметру RequestingSystem!</error></xml>";
	КонецЕсли;
	
	ВремяВыгрузки = ТекущаяДата();
	
	Запрос = Новый Запрос;
	
	Если ТолькоИзменения Тогда
		
		УзлыПланаОбмена = ПланыОбмена.ВыгрузкаДанных.ПолучитьУзелОбмена(УзелОбмена);
		Если Не ЗначениеЗаполнено(УзлыПланаОбмена) Тогда
			Возврат "<xml><error>Не настроен узел плана обмена по входному параметру RequestingSystem!</error></xml>";
		КонецЕсли;
		
		УзелПланаОбмена = УзлыПланаОбмена[0];
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КлассификаторЕдиницИзмерения.Ссылка КАК Ссылка,
		|	КлассификаторЕдиницИзмерения.Родитель КАК Родитель,
		|	КлассификаторЕдиницИзмерения.Код КАК Код,
		|	КлассификаторЕдиницИзмерения.Наименование КАК Наименование,
		|	КлассификаторЕдиницИзмерения.НаименованиеПолное КАК НаименованиеПолное,
		|	КлассификаторЕдиницИзмерения.Родитель.Наименование КАК РодительНаименование
		|ИЗ
		|	Справочник.КлассификаторЕдиницИзмерения.Изменения КАК КлассификаторЕдиницИзмеренияИзменения
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
		|		ПО КлассификаторЕдиницИзмеренияИзменения.Ссылка = КлассификаторЕдиницИзмерения.Ссылка
		|ГДЕ
		|	КлассификаторЕдиницИзмеренияИзменения.Узел = &УзелПланаОбмена
		|	И НЕ КлассификаторЕдиницИзмерения.ЭтоГруппа
		|	И НЕ КлассификаторЕдиницИзмерения.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Родитель,
		|	Ссылка";
		
		Запрос.УстановитьПараметр("УзелПланаОбмена", УзелПланаОбмена);
		
	Иначе		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КлассификаторЕдиницИзмерения.Ссылка КАК Ссылка,
		|	КлассификаторЕдиницИзмерения.Родитель КАК Родитель,
		|	КлассификаторЕдиницИзмерения.Код КАК Код,
		|	КлассификаторЕдиницИзмерения.Наименование КАК Наименование,
		|	КлассификаторЕдиницИзмерения.НаименованиеПолное КАК НаименованиеПолное,
		|	КлассификаторЕдиницИзмерения.Родитель.Наименование КАК РодительНаименование
		|ИЗ
		|	Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
		|ГДЕ
		|	НЕ КлассификаторЕдиницИзмерения.ЭтоГруппа
		|	И НЕ КлассификаторЕдиницИзмерения.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Родитель,
		|	Ссылка";		
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Запись = Новый ЗаписьXML; 
	Запись.УстановитьСтроку();
	Запись.ЗаписатьОбъявлениеXML(); //
	Запись.ЗаписатьНачалоЭлемента("Root");
	
	Пока Выборка.Следующий() Цикл
		
		ГУИД = XMLСтрока(Выборка.Ссылка);
		
		Запись.ЗаписатьНачалоЭлемента("ЕдиницаИзмерения");
		Запись.ЗаписатьАтрибут("ГУИД",					ГУИД);
		Запись.ЗаписатьАтрибут("КраткоеНаименование",	XMLСтрока(Выборка.Наименование));
		Запись.ЗаписатьАтрибут("ПолноеНаименование",	XMLСтрока(Выборка.НаименованиеПолное));
		Запись.ЗаписатьАтрибут("Категория",				XMLСтрока(Выборка.РодительНаименование));
		Запись.ЗаписатьКонецЭлемента();
		
		СтруктураПоиска = Новый Структура("ДействиеПриОбмене, УзелОбмена, Объект", Перечисления.ДействияПриОбмене.ВыгрузкаДанных, УзелОбмена, Выборка.Ссылка);
		СтруктураДанных = Новый Структура("УИДИсточника, ЗагрузкаПодтверждена, ДатаОбмена", ГУИД, Ложь, ВремяВыгрузки);
		РегистрыСведений.ПротоколОбменов.ЗафиксироватьИнформациюОЗагрузке(СтруктураПоиска, СтруктураДанных);
			
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	
	Возврат Запись.Закрыть();
	
КонецФункции

//Евросиб Шевченко А.В. 07.05.2025 US 94035 TA 104217
Функция ПолучитьДанныеТранспортнойАналитики(XMLParams, Данные = Неопределено) Экспорт  
		
	Если Данные = Неопределено Тогда //данные через веб-сервис
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(XMLParams);
	
		Фабрика = Новый ФабрикаXDTO;
		ОбъектXDTO = Фабрика.ПрочитатьXML(Чтение);
	Иначе //данные через внешнюю обработку из файла
		ОбъектXDTO = Данные;
	КонецЕсли;
	
	МассивВхДокументов = Новый Массив;
									                             
	Если ТипЗнч(ОбъектXDTO.Шапка)= Тип("СписокXDTO") Тогда //в XML-файле несколько документов	
		Для каждого ДанныеДокумента из ОбъектXDTO.Шапка цикл
			МассивВхДокументов.Добавить(ДанныеДокумента);
		КонецЦикла;
	ИначеЕсли ТипЗнч(ОбъектXDTO.Шапка)= ТИП("ОбъектXDTO") Тогда  //в XML-файле один документ   
		ДанныеДокумента = ОбъектXDTO.Шапка; 
		МассивВхДокументов.Добавить(ДанныеДокумента);
	КонецЕсли;  
	
	МассивГУИДовДляОтвета = Новый Массив;
	МассивДанных = Новый Массив;
	
	//записываем в регистр ДанныеПакетовОбмена с использованием НабораЗаписей
	ПериодОбмена = ТекущаяДата();
	НаборЗаписей = РегистрыСведений.ДанныеПакетовОбмена.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ПериодОбмена.Установить(ПериодОбмена);
	Для Каждого Док Из МассивВхДокументов Цикл
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.ПериодОбмена = ПериодОбмена;
		Если Док.ГУИД_ДК = "" Тогда
			ИдентификаторСтрокиПакетаДанных = Строка(Новый УникальныйИдентификатор);
		Иначе
			ИдентификаторСтрокиПакетаДанных = Док.ГУИД_ДК;
		КонецЕсли;
	    НоваяЗапись.ИдентификаторСтрокиПакетаДанных = ИдентификаторСтрокиПакетаДанных;
	    НоваяЗапись.ВнешнийИдентификаторСтрокиПакетаДанных = Док.ID_DX;
		//Евросиб Коханенко Н.А. 04.03.2026 (( #117279
		//не перенесено, в рабочей пока старое значение ПолучениеДанныхОСреднейМиле
		НоваяЗапись.ИсточникПакетаДанных = ПредопределенноеЗначение("Справочник.ИсточникиПакетовДанных.ПолучениеДанныхТранспортнойАналитики");
		//Евросиб Коханенко Н.А. 04.03.2026 )) #117279 
		НоваяЗапись.СтруктураДанных = Новый ХранилищеЗначения(ОбщегоНазначения.ОбъектXDTOВСтрокуXML(Док), Новый СжатиеДанных(9));
		НоваяЗапись.ОбъектДанных = Неопределено;
		НоваяЗапись.Обработано = Ложь;
		НоваяЗапись.ДатаОбработки = Дата(1,1,1);
		НоваяЗапись.ЕстьОшибки = Ложь;
		НоваяЗапись.ОписаниеОшибки = "";
		МассивГУИДовДляОтвета.Добавить(Новый Структура("ID_DX, ГУИД_ДК", Док.ID_DX, ИдентификаторСтрокиПакетаДанных));
		МассивДанных.Добавить(Новый Структура("ПериодОбмена, ГУИД_ДК, СтруктураДанных", ПериодОбмена, ИдентификаторСтрокиПакетаДанных, НоваяЗапись.СтруктураДанных)); 
	КонецЦикла; 
	НаборЗаписей.Записать(); 
	
	Если Данные = Неопределено Тогда //формируем ответ для веб-сервиса
		Запись = Новый ЗаписьXML;
		Запись.УстановитьСтроку();
		Запись.ЗаписатьОбъявлениеXML();
		Запись.ЗаписатьНачалоЭлемента("Документ");
		Для Каждого ВхДанные Из МассивГУИДовДляОтвета Цикл
			Запись.ЗаписатьНачалоЭлемента("Шапка");
			Запись.ЗаписатьАтрибут("ID_DX", ВхДанные.ID_DX);
			Запись.ЗаписатьАтрибут("ГУИД_ДК", ВхДанные.ГУИД_ДК);
			Запись.ЗаписатьКонецЭлемента();
		КонецЦикла;
		Запись.ЗаписатьКонецЭлемента();
		ОтветXML = Запись.Закрыть();
		Результат = ОтветXML;
