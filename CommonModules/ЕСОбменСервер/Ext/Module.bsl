Функция ЗагрузитьКурсыВалютСЦБРФ(ДатаЗагрузки) Экспорт
	
	//Создаем прокси для обращения к внешнему веб-сервису,
	// передаем в функцию URI пространства имен, имя сервиса, имя порта.
	Прокси = WSСсылки.ЦБРФ.СоздатьWSПрокси(
	"http://web.cbr.ru/", "DailyInfo", "DailyInfoSoap");
	
	//Получаем тип параметра, который передается в метод GetCursOnDate.
	ТипWSПараметра = Прокси.ФабрикаXDTO.Пакеты.Получить(
	"http://web.cbr.ru/").Получить("GetCursOnDate");
	//Создаем параметр на основе типа и заполняем значение параметра On_Date.
	WSПараметр                  = Прокси.ФабрикаXDTO.Создать(ТипWSПараметра);
	WSПараметр.On_Date           = ДатаЗагрузки;
	
	//Вызываем метод веб-сервиса, записываем результат в переменную КурсыВалют.
	КурсыВалют = Прокси.GetCursOnDate(WSПараметр);
	
	// Перебираем таблицу ValuteCursOnDate, каждое значение таблицы
	// добавляем в таблицу на форме (колонки заполняем соответствующими значениями).
	
	Результат = Новый ТаблицаЗначений ;
	Результат.Колонки.Добавить("НазваниеВалюты") ;
	Результат.Колонки.Добавить("Номинал") ;
	Результат.Колонки.Добавить("ЦифровойКодВалюты") ;
	Результат.Колонки.Добавить("СимвольныйКодВалюты") ;
	Результат.Колонки.Добавить("КурсВалюты") ;
	
	
	Для Каждого Элемент Из КурсыВалют.GetCursOnDateResult.diffgram.ValuteData.ValuteCursOnDate Цикл 
		Строка = Результат.Добавить();
		Строка.НазваниеВалюты      = Элемент.Vname;
		Строка.Номинал             = Элемент.Vnom;
		Строка.ЦифровойКодВалюты   = Элемент.Vcode;
		Строка.СимвольныйКодВалюты = Элемент.VChCode;
		Строка.КурсВалюты          = Элемент.Vcurs;
	КонецЦикла;
	
	Возврат Результат ;
	
КонецФункции

Процедура РассылкаПриПроверкеНаличияЗаписиКурсовНаТекущуюДату() Экспорт  
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КурсыВалют.Валюта КАК Валюта
	|ИЗ
	|	РегистрСведений.КурсыВалют КАК КурсыВалют
	|ГДЕ
	|	КурсыВалют.Период = &Период";   
	ДатаПроверки = НачалоДня(ТекущаяДата());
	Запрос.УстановитьПараметр("Период", ДатаПроверки);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		
		Тема = СтрШаблон("Отсутствуют курсы валют в DataCore на %1", Формат(ДатаПроверки, "ДФ=dd.MM.yyyy"));
		ТекстПисьма = "";
		ПолучателиПисьма = Новый Массив;
		
		СистемнаяУчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
		ПараметрыОтправкиПисьма = новый Структура;
		ПараметрыОтправкиПисьма.Вставить("Тема", Тема);
		ПараметрыОтправкиПисьма.Вставить("Тело", ТекстПисьма);
		ПараметрыОтправкиПисьма.Вставить("ТипТекста", "HTML");
		ПолучателиПисьма.Добавить(Новый Структура("Представление, Адрес", "datacore@eurosib.biz", "datacore@eurosib.biz"));
		ПараметрыОтправкиПисьма.Вставить("Кому", ПолучателиПисьма);
		ПараметрыОтправкиПисьма.Вставить("Важность", ВажностьИнтернетПочтовогоСообщения.Высокая);
		
		Результат = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(СистемнаяУчетнаяЗапись, ПараметрыОтправкиПисьма);
		
	КонецЕсли;
	
КонецПроцедуры

