Функция НайтиПолучателейВПравилахОповещения(ВидЗагрузки, ПолнаяСтрокаУсловий = "") Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НастройкаПравилОповещений.ГруппаПользователей,
	|	НастройкаПравилОповещений.УсловияОтбора
	|ИЗ
	|	РегистрСведений.НастройкаПравилОповещений КАК НастройкаПравилОповещений
	|ГДЕ
	|	НастройкаПравилОповещений.Вкл
	|	И НастройкаПравилОповещений.ВидЗагрузки = &ВидЗагрузки";
	
	Запрос.УстановитьПараметр("ВидЗагрузки", ВидЗагрузки);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Новый Массив();
	КонецЕсли; 
	
	ТаблицаНастроек = Результат.Выгрузить();
	МассивКудалению = Новый Массив;
	Для каждого СтрокаНастройки Из ТаблицаНастроек Цикл
		УсловиеОтбора = СокрЛП(СтрокаНастройки.УсловияОтбора);
		МассивУсловий = _СтрРазделить(УсловиеОтбора, "#");
		//проверяем полную строку на вхождения услвоий отбора по частям
		Для каждого КонечноеУсловие Из МассивУсловий Цикл
			Если Найти(ПолнаяСтрокаУсловий, КонечноеУсловие) = 0 Тогда
				МассивКудалению.Добавить(СтрокаНастройки);
				Прервать;
			КонецЕсли;
		КонецЦикла; 
	КонецЦикла; 
	Если МассивКУдалению.Количество() > 0 Тогда //удаляем лишние настройки
		Для каждого СтрокаУдалить Из МассивКУдалению Цикл
			ТаблицаНастроек.Удалить(СтрокаУдалить);
		КонецЦикла; 
	КонецЕсли;
	Если ТаблицаНастроек.Количество() = 0 Тогда
		Возврат Новый Массив();
	КонецЕсли;
	
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПользователиКонтактнаяИнформация.АдресЭП КАК Адрес
	|ИЗ
	|	Справочник.ГруппыПользователей.Состав КАК ГруппыПользователейСостав
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
	|		ПО ГруппыПользователейСостав.Пользователь = ПользователиКонтактнаяИнформация.Ссылка
	|ГДЕ
	|	ГруппыПользователейСостав.Ссылка В(&ГруппаПользователей)
	|	И ПользователиКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)";
	
	Запрос.УстановитьПараметр("ГруппаПользователей", ТаблицаНастроек.ВыгрузитьКолонку("ГруппаПользователей"));
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Новый Массив();
	Иначе
		Возврат Результат.Выгрузить().ВыгрузитьКолонку("Адрес");
	КонецЕсли; 
КонецФункции

Процедура ОтправитьСообщение(Тип, Имя, Ошибка, ИмяФайла, Получатели) Экспорт
	
	Профиль = Новый ИнтернетПочтовыйПрофиль;
	Профиль.АдресСервераSMTP = "esxexch";
	Профиль.ПортSMTP = "25";
	Профиль.АутентификацияSMTP = Ложь;
	Почта = Новый ИнтернетПочта;
	Попытка
		Почта.Подключиться(Профиль);
	Исключение
	КонецПопытки;
	Письмо = Новый ИнтернетПочтовоеСообщение;
	Для каждого Получатель Из Получатели Цикл
		Письмо.Получатели.Добавить(Получатель);
	КонецЦикла; 
	Письмо.Отправитель.Адрес = "tpdper@eurosib.biz";
	ТекстСообщения = Письмо.Тексты.Добавить();
	ТекстСообщения.ТипТекста = ТипТекстаПочтовогоСообщения.ПростойТекст;
	ТекстСообщения.Текст = ""+Тип+"
	|"+Имя+"
	|"+Ошибка+"
	|"""+ИмяФайла+"""";
	Письмо.Тема = Тип;
	Попытка
		Почта.Послать(Письмо);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

Функция _СтрРазделить(Строка, Разделитель, ВключатьПустые = Ложь)
	МассивЗначений = Новый Массив();
	Символ = Найти(Строка, Разделитель);
	Пока Символ > 0 Цикл
		Если ВключатьПустые или (СтрДлина(Лев(Строка, Символ - 1)) > 0) Тогда
			МассивЗначений.Добавить(Лев(Строка, Символ - 1));
		КонецЕсли;
		Строка = Прав(Строка, СтрДлина(Строка) - Символ);
		Символ = Найти(Строка, Разделитель);
	КонецЦикла;
	Если (ВключатьПустые или СтрДлина(Строка) > 0) Тогда
		МассивЗначений.Добавить(Строка);
	КонецЕсли;
	Возврат МассивЗначений;
КонецФункции
 
Процедура ОтправитьСообщенияОбОшибках(СтатусТаблица, Тип, Имя, Ссылка = "", Ошибка = "", ИмяФайла = "", ВидЗагрузки) Экспорт
	
	СтрокаСтатусТаблица					=	СтатусТаблица.Добавить();
	СтрокаСтатусТаблица.Тип				=	Тип;
	СтрокаСтатусТаблица.Имя				=	Имя;
	СтрокаСтатусТаблица.Ссылка			=	Ссылка;
	СтрокаСтатусТаблица.Ошибка			=	Ошибка;
	СтрокаСтатусТаблица.ИмяФайла		= 	ИмяФайла;	
	СтатусТаблица.Очистить();
	Получатели = НайтиПолучателейВПравилахОповещения(ВидЗагрузки, "" + Тип + Имя + Ошибка + ИмяФайла);
	Если Получатели.Количество() > 0 Тогда
		Если СтрНайти(ИмяФайла, "ESContra") > 0 Или СтрНайти(ИмяФайла, "FACT_PAYMENT") > 0 Тогда
			Тип = "Загрузка из Бит.Финанс в Datacore: " + Тип; //тема письма
		КонецЕсли; 	
		ОтправитьСообщение(Тип, Имя, Ошибка, ИмяФайла, Получатели);
	КонецЕсли;  
КонецПроцедуры

