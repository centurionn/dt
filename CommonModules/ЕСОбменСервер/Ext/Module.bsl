				Если ЗначениеЗаполнено(ЗначенияПолейЗаписи.vessel) Тогда
					ЗначенияПолейЗаписи.Судно = Справочники.ТС.НайтиПоНаименованию(ЗначенияПолейЗаписи.vessel);
