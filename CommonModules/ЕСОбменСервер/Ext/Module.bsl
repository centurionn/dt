Процедура ЗагрузитьПроверенныеДанные(ВыборкаДанныеДляЗагрузки)
	
	//ДИТ Моисеенко Ю.В. 03.11.2022 59323 -начало
	НомерБезСцепа = 1;
	
	ЗагруженныеРефСцепы 	= Новый Соответствие;
	ЗагруженныеКонтейнеры 	= Новый Соответствие;
	ЗагруженныеВагоны 		= Новый Соответствие;
	
	Пока ВыборкаДанныеДляЗагрузки.Следующий() Цикл
		
		//проверяем есть ли рефсцепа в бд, если нет, то создаем новую. Если есть, проверяем пометку удаления
		РефСцеп = ВыборкаДанныеДляЗагрузки.РефСцепа;
		Если Не ЗначениеЗаполнено(РефСцеп) Тогда
			РефСцеп = ЗагруженныеРефСцепы.Получить(ВыборкаДанныеДляЗагрузки.refHitch);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаДанныеДляЗагрузки.refHitch) Тогда
			Если Не ЗначениеЗаполнено(РефСцеп) Тогда
				РефСцепаОбъект = Справочники.РефСцепы.СоздатьЭлемент();
				РефСцепаОбъект.Наименование = ВыборкаДанныеДляЗагрузки.refHitch;
				Попытка
					РефСцепаОбъект.Записать();
					РефСцеп = РефСцепаОбъект.Ссылка;
					ЗагруженныеРефСцепы.Вставить(ВыборкаДанныеДляЗагрузки.refHitch, РефСцеп);
				Исключение
					Тема = "Рег. задание: Загрузка вагонов в реф сцепах из РИТМа";
					ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()); 
					ТекстСообщения = "Ошибки и уведомления при выполнении рег. задания:
					|" + ПредставлениеОшибки;
