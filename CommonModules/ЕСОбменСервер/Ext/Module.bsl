КонецПроцедуры

Процедура ОтправитьПисьмаСОшибкамиЗаполнения(ВыборкаОшибкиЗаполнения)
	
	//ДИТ Моисеенко Ю.В. 03.11.2022 59323 -начало
	СоответствиеПолейСинонимов = Новый Соответствие;
	СоответствиеПолейСинонимов.Вставить("wagonNumber", 		"Вагон");
	СоответствиеПолейСинонимов.Вставить("hitchPossible", 	"Признак вагона");
	
	Пока ВыборкаОшибкиЗаполнения.Следующий() Цикл
		
		Email = ВыборкаОшибкиЗаполнения.email;
		
		Тема 			= "В систему ИРС внесены некорректные данные по вагонам: ";
		СписокВагонов 	= "";
		Тело 		= "";
		
		Выборка = ВыборкаОшибкиЗаполнения.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			СписокВагонов = СписокВагонов + ?(ЗначениеЗаполнено(СписокВагонов), ", ", "") + Выборка.wagonNumber;
			Шаблон = "Вагон %1: не заполнены обязательные поля: %2";
			ПустыеПоля = "";
			
			Для Каждого Поле Из СоответствиеПолейСинонимов Цикл
				Если Не ЗначениеЗаполнено(Выборка[Поле.Ключ]) Тогда 
					ПустыеПоля = ПустыеПоля + ?(ЗначениеЗаполнено(ПустыеПоля), ", ", "") + Поле.Значение;
				КонецЕсли;
			КонецЦикла;
			
			Тело = Тело + ?(ЗначениеЗаполнено(Тело), "<br>", "") + СтрШаблон(Шаблон, Выборка.wagonNumber, ПустыеПоля);
			
		КонецЦикла;
		
		Тема = Тема + СписокВагонов;
		ПолучателиПисьма = Новый Массив;
		
		СистемнаяУчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
		ПараметрыОтправкиПисьма = Новый Структура;
		ПараметрыОтправкиПисьма.Вставить("Тема", Тема);
		ПараметрыОтправкиПисьма.Вставить("Тело", Тело);
		ПараметрыОтправкиПисьма.Вставить("ТипТекста", Перечисления.ТипыТекстовЭлектронныхПисем.HTML);
		ПолучателиПисьма.Добавить(Новый Структура("Представление, Адрес", Email, Email));
		ПараметрыОтправкиПисьма.Вставить("Кому", ПолучателиПисьма);
		ПараметрыОтправкиПисьма.Вставить("Важность", ВажностьИнтернетПочтовогоСообщения.Высокая);
		
		Результат = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(СистемнаяУчетнаяЗапись, ПараметрыОтправкиПисьма);
		
	КонецЦикла;
	//ДИТ Моисеенко Ю.В. 03.11.2022 59323 -конец
	
КонецПроцедуры

Процедура ОтправитьПисьмаСОшибкамиДублирования(ВыборкаДубли)
	
	//ДИТ Моисеенко Ю.В. 03.11.2022 59323 -начало
    Пока ВыборкаДубли.Следующий() Цикл
		
		Email = ВыборкаДубли.email;
		
		Тема 			= "В систему ИРС внесены некорректные данные по вагонам: ";
		Тело 			= "";
		
		ВыборкаСцепы = ВыборкаДубли.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаСцепы.Следующий() Цикл
			
			ТекстСцепы = "Реф. сцеп %1: есть дубли порядковых номеров вагонов: ";
			ТекстСцепы = СтрШаблон(ТекстСцепы, ВыборкаСцепы.refHitch);

			ВыборкаНомера = ВыборкаСцепы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаНомера.Следующий() Цикл
				
				Выборка = ВыборкаНомера.Выбрать();
				СписокВагонов 	= "";
				
				Пока Выборка.Следующий() Цикл
					СписокВагонов = СписокВагонов + ?(ЗначениеЗаполнено(СписокВагонов), ", ", "") + Выборка.wagonNumber;
				КонецЦикла;
				
				ШаблонНомер = " - порядковый номер в сцепе: %1 вагоны: %2";
				ШаблонНомер = СтрШаблон(ШаблонНомер, ВыборкаНомера.hitchNum, СписокВагонов);
				ТекстСцепы = ТекстСцепы + "<br>" + ШаблонНомер;
				
			КонецЦикла;
			
			Тело = Тело + ?(ЗначениеЗаполнено(Тело), "<br>", "") + ТекстСцепы;
			
		КонецЦикла;
		
		Тема = Тема + СписокВагонов;
		ПолучателиПисьма = Новый Массив;
		
		СистемнаяУчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
		ПараметрыОтправкиПисьма = Новый Структура;
		ПараметрыОтправкиПисьма.Вставить("Тема", Тема);
		ПараметрыОтправкиПисьма.Вставить("Тело", Тело);
		ПараметрыОтправкиПисьма.Вставить("ТипТекста", Перечисления.ТипыТекстовЭлектронныхПисем.HTML);
		ПолучателиПисьма.Добавить(Новый Структура("Представление, Адрес", Email, Email));
		ПараметрыОтправкиПисьма.Вставить("Кому", ПолучателиПисьма);
		ПараметрыОтправкиПисьма.Вставить("Важность", ВажностьИнтернетПочтовогоСообщения.Высокая);
		
		Результат = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(СистемнаяУчетнаяЗапись, ПараметрыОтправкиПисьма);

	КонецЦикла;
	//ДИТ Моисеенко Ю.В. 03.11.2022 59323 -конец
	
КонецПроцедуры

