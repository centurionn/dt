	|		ПО ВТКонтейнеры.Ссылка = ВТПризнакиСобственности.Контейнер
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТТипыТЕ КАК ВТТипыТЕ
	|		ПО ВТКонтейнеры.Тип = ВТТипыТЕ.Наименование
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКонтейнерыНаСлежении КАК ВТКонтейнерыНаСлежении
	|		ПО ВТКонтейнеры.Ссылка = ВТКонтейнерыНаСлежении.Контейнер
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	NULL,
	|	NULL,
	|	NULL,
	|	ВТКонтейнерыНаСлежении.Контейнер,
	|	NULL,
	|	NULL,
	|	NULL,
	|	NULL,
	|	ИСТИНА
	|ИЗ
	|	ВТКонтейнерыНаСлежении КАК ВТКонтейнерыНаСлежении
	|ГДЕ
	|	НЕ ВТКонтейнерыНаСлежении.Контейнер В
	|				(ВЫБРАТЬ
	|					Контейнеры.Ссылка
	|				ИЗ
	|					ВТКонтейнеры КАК Контейнеры
	|				ГДЕ
	|					НЕ Контейнеры.Ссылка ЕСТЬ NULL)";
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Контейнер = Выборка.Ссылка;
//Евросиб Гудкова( 30.09.2020 Ticket№ 
			Если НЕ (ЭтоТест Или ЗначениеЗаполнено(Контейнер)) Тогда
				Продолжить;
			КонецЕсли;
// Евросиб Гудкова) 		
		
