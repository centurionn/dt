					ТекстСообщения = "Ошибки и уведомления при выполнении рег. задания:
					|" + ПредставлениеОшибки;
					РаботаСоСделкамиСервер.ВыполнитьОтправкуУведомлений(Тема, ТекстСообщения, Метаданные.РегламентныеЗадания.ЗагрузкаИзИРСВагоновВРефСцепах);
				КонецПопытки;
			КонецЕсли;
			
		КонецЕсли;
		
		//проверяем есть ли вагон в бд, если нет, то создаем новый. Если есть, проверяем пометку удаления
		Вагон = ВыборкаДанныеДляЗагрузки.Вагон;
		
		Если Не ЗначениеЗаполнено(Вагон) Тогда 
			Вагон = ЗагруженныеВагоны.Получить(ВыборкаДанныеДляЗагрузки.wagonNumber);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Вагон) Тогда
			ВагонОбъект = Справочники.ТС.СоздатьЭлемент();
			ВагонОбъект.Наименование = ВыборкаДанныеДляЗагрузки.wagonNumber;
			ВагонОбъект.ТипТС = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ТипоразмерыТС.РефСцПлатформа");
			Попытка
				ВагонОбъект.ЗаписьИсторииДанных.КомментарийВерсии = "Создан регламентом Загрузка из ИРС вагонов в реф сцепах"; //ДИТ Шевченко US 63491 TA 74038 18.09.2023
				ВагонОбъект.Записать();
				Вагон = ВагонОбъект.Ссылка;
				
				ЗагруженныеВагоны.Вставить(ВыборкаДанныеДляЗагрузки.wagonNumber, Вагон);
			Исключение
				Тема = "Рег. задание: Загрузка вагонов в реф сцепах из РИТМа";
				ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()); 
				ТекстСообщения = "Ошибки и уведомления при выполнении рег. задания:
				|" + ПредставлениеОшибки;
				РаботаСоСделкамиСервер.ВыполнитьОтправкуУведомлений(Тема, ТекстСообщения, Метаданные.РегламентныеЗадания.ЗагрузкаИзИРСВагоновВРефСцепах);
			КонецПопытки;
		Иначе
			Если ВыборкаДанныеДляЗагрузки.ВагонПометкаУдаления Тогда
				ВагонОбъект = Вагон.ПолучитьОбъект();
				ВагонОбъект.ПометкаУдаления = Ложь;
				Попытка
					ВагонОбъект.Записать();
				Исключение
					Тема = "Рег. задание: Загрузка вагонов в реф сцепах из РИТМа";
					ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()); 
					ТекстСообщения = "Ошибки и уведомления при выполнении рег. задания:
					|" + ПредставлениеОшибки;
					РаботаСоСделкамиСервер.ВыполнитьОтправкуУведомлений(Тема, ТекстСообщения, Метаданные.РегламентныеЗадания.ЗагрузкаИзИРСВагоновВРефСцепах);
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаДанныеДляЗагрузки.refHitch) Тогда
			ПорядковыйНомерВСцепе = ВыборкаДанныеДляЗагрузки.hitchNum;
		Иначе
			ПорядковыйНомерВСцепе = НомерБезСцепа;
			НомерБезСцепа = НомерБезСцепа + 1;
		КонецЕсли;
		
		Если ВыборкаДанныеДляЗагрузки.hitchPossible = "Годен для реф. сцепа" Тогда 
			ПризнакВагона = 1;
		ИначеЕсли ВыборкаДанныеДляЗагрузки.hitchPossible = "Монтирован ДГК" Тогда
			ПризнакВагона = 2;
		Иначе
			ПризнакВагона = 0;
		КонецЕсли;
		
		Запись = РегистрыСведений.ВагоныВРефСцепах.СоздатьМенеджерЗаписи();
		Запись.РефСцеп = РефСцеп;
		Запись.ПорядковыйНомерВСцепе = ПорядковыйНомерВСцепе;
		Запись.Вагон = Вагон;
		Запись.ПризнакВагона = ПризнакВагона;
		ЗаполнитьЗначенияСвойств(Запись, ВыборкаДанныеДляЗагрузки, "Номер1Контроллера,Номер2Контроллера,EmailОтвтетственного");
		
		Запись.Записать();
		
	КонецЦикла;
