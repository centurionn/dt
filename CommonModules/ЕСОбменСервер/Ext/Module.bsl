//ДИТ Шевченко А.В. 55131 01.08.2022 -начало
Процедура ОтправитьПисьмоОбОшибкахОбменаДКТЛ(МассивОшибок,СсылкаЗапросНаАвтоперевозку)
	
	ПолучателиУведомлений = Константы.ПолучателиУведомленийОРегЗаданиях.Получить();
	Если Не ЗначениеЗаполнено(ПолучателиУведомлений) Тогда
		Возврат;
	КонецЕсли;	
	УчетнаяЗаписьПоУмолчаниюДоступна = РаботаСПочтовымиСообщениями.ПроверитьСистемнаяУчетнаяЗаписьДоступна();	
	Если УчетнаяЗаписьПоУмолчаниюДоступна = Ложь Тогда
		Возврат;
	КонецЕсли;	
	СистемнаяУчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	ПолучателиПисьма = Новый Массив;
	Если ТипЗнч(ПолучателиУведомлений) = Тип("СправочникСсылка.Пользователи") Тогда
		ЭлАдресПользователя = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ПолучателиУведомлений, Справочники.ВидыКонтактнойИнформации.EmailПользователя, , Истина);
		ПолучателиПисьма.Добавить(Новый Структура("Представление, Адрес", ПолучателиУведомлений, ЭлАдресПользователя));
	Иначе	
		Для Каждого ТекущийПользователь Из ПолучателиУведомлений.Состав Цикл								
			ЭлАдресПользователя = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ТекущийПользователь.Пользователь, Справочники.ВидыКонтактнойИнформации.EmailПользователя, , Истина);
			ПолучателиПисьма.Добавить(Новый Структура("Представление, Адрес", ТекущийПользователь.Пользователь, ЭлАдресПользователя));
		КонецЦикла;
	КонецЕсли;
	
	ТекстПисма = "ДОКУМЕНТ " + СсылкаЗапросНаАвтоперевозку;
	Для Каждого ЗнчМассива Из МассивОшибок Цикл
		ТекстПисма = ТекстПисма + "ТЕКСТ ОШИБКИ:" + Символы.ПС + ЗнчМассива.Комментарий + Символы.ПС + Символы.ПС;
		ТекстПисма = ТекстПисма + "ГУИДЫ СТРОК ДОКУМЕНТА ОТПРАВЛЯЕМЫХ В ЗАПРОСЕ:" + Символы.ПС;
		ТекстПисма = ТекстПисма + ЗнчМассива.ГУИД;
