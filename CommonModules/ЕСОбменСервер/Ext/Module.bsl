				ГУИДвДО = Мт[0].УИДИсточника;
			КонецЕсли;    
			
			// ДИТ BUG 79699 ТА 81720 Сержантова А.С. Начало: 04.04.2024
			Если не ЗначениеЗаполнено(ГУИДДоговора) Тогда
				
