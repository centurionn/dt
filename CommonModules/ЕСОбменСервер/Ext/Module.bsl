			|ГДЕ
			|	АдресаВНаселенныхПунктахИзменения.Узел = &УзелОбмена";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 999", ТекстОграниченияПорции);
