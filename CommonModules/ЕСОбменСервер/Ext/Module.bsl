	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОперацияГрузы.Ссылка.Номер КАК НомерЖДОтправки,
	|	ОперацияГрузы.Ссылка.РейсЖД.Наименование КАК НаименованиеРейсаЖД,
	|	ОперацияГрузы.ТС.Наименование КАК НомерВагона,
	|	ОперацияГрузы.Ссылка.ПунктНазначения.КодЖДСтанции КАК КодЖДСтанции,
	|	ОперацияГрузы.Ссылка.РейсЖД.ИРС_Грузоотправитель КАК ИРС_Грузоотправитель,
	|	ОперацияГрузы.Ссылка.ДатаОтправления КАК ДатаОтправления,
	|	ОперацияГрузы.Ссылка.ДатаНазначения КАК ДатаНазначения,
	|	ОперацияГрузы.Ссылка.Примечание КАК Примечание,
	|	ЕСТЬNULL(ПротоколОбменов.УИДИсточника, """") КАК КодНазначенияИРС
	|ИЗ
	|	Документ.Операция.Грузы КАК ОперацияГрузы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	|		ПО ОперацияГрузы.Ссылка = ПротоколОбменов.Объект
	|			И (ПротоколОбменов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных))
	|			И (ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.ИРС))
	|ГДЕ
	|	ОперацияГрузы.Ссылка = &ОперацияНазначение";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ТекущийПользовательОС = ПользователиИнформационнойБазы.ТекущийПользователь().ПользовательОС;
		Пока СтрНачинаетсяС(ТекущийПользовательОС, "\") Цикл
			ТекущийПользовательОС = Прав(ТекущийПользовательОС, СтрДлина(ТекущийПользовательОС) - 1);
		КонецЦикла;
		
		Запись = Новый ЗаписьXML;
		
		//Запись.УстановитьСтроку("UTF-8");
		Запись.УстановитьСтроку("windows-1251"); 
		Запись.ЗаписатьОбъявлениеXML();
		
		Запись.ЗаписатьНачалоЭлемента("root");
		
		ДобавитьЭлементВФайл(Запись, "R", "", Новый Структура("nmParams, valueParams", "templateId", ТипНазначения));
		ДобавитьЭлементВФайл(Запись, "R", "", Новый Структура("nmParams, valueParams", "carNum", Выборка.НомерВагона));
		ДобавитьЭлементВФайл(Запись, "R", "", Новый Структура("nmParams, valueParams", "stCode", Выборка.КодЖДСтанции));
		ДобавитьЭлементВФайл(Запись, "R", "", Новый Структура("nmParams, valueParams", "receiverId", Грузоотправитель));
		ДобавитьЭлементВФайл(Запись, "R", "", Новый Структура("nmParams, valueParams", "loginName", ТекущийПользовательОС));
		ДобавитьЭлементВФайл(Запись, "R", "", Новый Структура("nmParams, valueParams", "notes", Выборка.Примечание));
		ДобавитьЭлементВФайл(Запись, "R", "", Новый Структура("nmParams, valueParams", "receiveDateFrom", Формат(Выборка.ДатаОтправления, "ДФ='ггггММдд чч:мм'")));
		ДобавитьЭлементВФайл(Запись, "R", "", Новый Структура("nmParams, valueParams", "receiveDateTo", Формат(Выборка.ДатаНазначения, "ДФ='ггггММдд чч:мм'")));
		
		Запись.ЗаписатьКонецЭлемента();
		
		ДанныеДляОтправки = Запись.Закрыть();
		
		ОтветXML = ВебСервисы_сервер.ЗапроситьРИТМ("CreateFleeAssignmentToIRS", ДанныеДляОтправки);
		
		//Разбор ответа
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(ОтветXML);
		
		Фабрика = Новый ФабрикаXDTO;
		ОбъектXDTO = Фабрика.ПрочитатьXML(Чтение);
		СтруктураОтвета = Новый Структура("errorCode,errorMsg,Error,ErrorMessage","","","",""); 
		Если ОбъектXDTO.Свойства().Получить("errorCode") <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтруктураОтвета, ОбъектXDTO);
			КодОтвета = СтруктураОтвета.errorCode;
			СообщениеОтвета = СтруктураОтвета.errorMsg;
		ИначеЕсли ОбъектXDTO.Свойства().Получить("Error") <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтруктураОтвета, ОбъектXDTO.Error);
			Ошибка = СтруктураОтвета.Error;
			КодОтвета = СтруктураОтвета.ErrorCode;
			СообщениеОтвета = СтруктураОтвета.ErrorMessage;
		Иначе
			КодОтвета = "-";
			СообщениеОтвета = ОтветXML;
		КонецЕсли;
		
		Если КодОтвета = "0" Тогда //назначение успешно создано и СообщениеОтвета содержит код созданного назначения
				
			ЗаписьПротоколаОбменов = РегистрыСведений.ПротоколОбменов.СоздатьМенеджерЗаписи();
			ЗаписьПротоколаОбменов.Объект = ОперацияНазначение;
			ЗаписьПротоколаОбменов.УзелОбмена = Перечисления.УзлыОбмена.ИРС;
			ЗаписьПротоколаОбменов.ДействиеПриОбмене = Перечисления.ДействияПриОбмене.ВыгрузкаДанных;
			ЗаписьПротоколаОбменов.УИДИсточника = СообщениеОтвета;
			ЗаписьПротоколаОбменов.Ответственный = Пользователи.ТекущийПользователь();
			ЗаписьПротоколаОбменов.ДатаОбмена = ТекущаяДатаСеанса();
			ЗаписьПротоколаОбменов.Записать();
			
			Успешно = Истина;
			ТекстСообщения = "Назначение успешно создано в ИРС";
			
		ИначеЕсли КодОтвета = "4" Тогда //назначение в ИРС уже есть, в строке СообщениеОтвета есть код назначения
			
			СтрокаПоискаНомера = "код назначения в ИРС=";
			Цифры = "0123456789";
			НомерНайденногоСимвола = СтрНайти(СообщениеОтвета, СтрокаПоискаНомера);
			СимволыКода = Новый Массив;
			Если НомерНайденногоСимвола > 0 Тогда
				Для НомерСимвола = НомерНайденногоСимвола + СтрДлина(СтрокаПоискаНомера) По СтрДлина(СообщениеОтвета) Цикл
					ТекСимвол = Сред(СообщениеОтвета, НомерСимвола, 1);
					Если СтрНайти(Цифры, ТекСимвол) > 0 Тогда
						СимволыКода.Добавить(ТекСимвол);
					КонецЕсли;
				КонецЦикла;			
			КонецЕсли;		
			КодНазначения = СтрСоединить(СимволыКода);
			
			Если ЗначениеЗаполнено(КодНазначения) Тогда
				
				Если Не ЗначениеЗаполнено(Выборка.КодНазначенияИРС) Тогда
					ЗаписьПротоколаОбменов = РегистрыСведений.ПротоколОбменов.СоздатьМенеджерЗаписи();
					ЗаписьПротоколаОбменов.Объект = ОперацияНазначение;
					ЗаписьПротоколаОбменов.УзелОбмена = Перечисления.УзлыОбмена.ИРС;
					ЗаписьПротоколаОбменов.ДействиеПриОбмене = Перечисления.ДействияПриОбмене.ВыгрузкаДанных;				
					ЗаписьПротоколаОбменов.УИДИсточника = КодНазначения;
					ЗаписьПротоколаОбменов.Ответственный = Пользователи.ТекущийПользователь();
					ЗаписьПротоколаОбменов.ДатаОбмена = ТекущаяДатаСеанса();
					ЗаписьПротоколаОбменов.Записать();
				КонецЕсли;

			КонецЕсли;
			
			Успешно = Ложь;				
			ТекстСообщения = СтрШаблон("При выгрузке в ИРС ЖД отправки №%1 (вагон %2 рейс %3), произошла ошибка: %4 Код ошибки(%5)", 
										Выборка.НомерЖДОтправки, Выборка.НомерВагона, Выборка.НаименованиеРейсаЖД, СообщениеОтвета, КодОтвета);
										
			ЗаписьЖурналаРегистрации("Выгрузка назначенных вагонов в ИРС",
									УровеньЖурналаРегистрации.Ошибка,
									,
									ОперацияНазначение,
									ТекстСообщения);
			Сообщить(ТекстСообщения);
			
		Иначе
			
			Успешно = Ложь;				
			ТекстСообщения = СтрШаблон("При выгрузке в ИРС ЖД отправки №%1 (вагон %2 рейс %3), произошла ошибка: %4 Код ошибки(%5)", 
										Выборка.НомерЖДОтправки, Выборка.НомерВагона, Выборка.НаименованиеРейсаЖД, СообщениеОтвета, КодОтвета);
										
			ЗаписьЖурналаРегистрации("Выгрузка назначенных вагонов в ИРС",
									УровеньЖурналаРегистрации.Ошибка,
									,
									ОперацияНазначение,
									ТекстСообщения);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьАтрибутВФайл(Файл, ИмяЭлемента, Значение) Экспорт
	
	Файл.ЗаписатьНачалоАтрибута(ИмяЭлемента);		
	Файл.ЗаписатьТекст(XMLСтрока(Значение));		
	Файл.ЗаписатьКонецАтрибута();
	
КонецПроцедуры

Процедура ДобавитьЭлементВФайл(Файл, ИмяЭлемента, Значение, Атрибуты = Неопределено) Экспорт
	
	Файл.ЗаписатьНачалоЭлемента(ИмяЭлемента);
	
	Если Атрибуты <> Неопределено Тогда
		Для Каждого Атрибут Из Атрибуты Цикл
			ДобавитьАтрибутВФайл(Файл, Атрибут.Ключ, Атрибут.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Файл.ЗаписатьТекст(XMLСтрока(Значение));		
	Файл.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Функция ПолучитьПланОтправок(ДатаНачала = Неопределено, ДатаКонца = Неопределено) Экспорт
	Запрос = Новый  Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РейсыЖД.ПунктОтправления.КодЖДСтанции КАК КодЖДСтанцииОтправления,
	|	РейсыЖД.ПунктНазначения.КодЖДСтанции КАК КодЖДСтанцииНазначения,
	|	РейсыЖД.ДатаОтправления КАК ДатаОтправления,
	|	РейсыЖД.ДатаПрибытия КАК ДатаПрибытия,
	|	РейсыЖД.УсловнаяДлинаСостава КАК УсловнаяДлинаСостава,
	|	24 КАК ДлительностьВыгрузки,
	|	РейсыЖД.КоличествоТЕУ КАК КоличествоТЕУ,
	|	РейсыЖД.Сервис.Наименование КАК Сервис,
	|	РейсыЖД.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(ЗапрЗарезервирТЕУ.ЗарезервированоТЕУ, 0) КАК ЗарезервированоТЭУ,
	|	РейсыЖД.Автор.Представление КАК Автор
	|ИЗ
	|	Справочник.РейсыЖД КАК РейсыЖД
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ЗаявкаПереченьРейсов.Рейс КАК Рейс,
	|			СУММА(ЗаявкаПереченьРейсов.Ссылка.КоличествоКТК20 + ЗаявкаПереченьРейсов.Ссылка.КоличествоКТК40 * 2) КАК ЗарезервированоТЕУ
	|		ИЗ
	|			Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
	|		ГДЕ
	|			НЕ ЗаявкаПереченьРейсов.Ссылка.ПометкаУдаления
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ЗаявкаПереченьРейсов.Рейс) КАК ЗапрЗарезервирТЕУ
	|		ПО РейсыЖД.Ссылка = ЗапрЗарезервирТЕУ.Рейс
	|ГДЕ
	|	НЕ РейсыЖД.РейсОтменен
	|	И ВЫБОР
	|			КОГДА &ДатаНачала = НЕОПРЕДЕЛЕНО
	|				ТОГДА РейсыЖД.ДатаОтправления >= &ДатаОтправления
	|			ИНАЧЕ РейсыЖД.ДатаОтправления МЕЖДУ &ДатаНачала И &ДатаКонца
	|		КОНЕЦ
	|	И НЕ РейсыЖД.ПометкаУдаления";
	ДлинаСутокВСекундах = 60*60*24;
	ДатаОтправки = НачалоДня(ТекущаяДата()) + ДлинаСутокВСекундах;
	Запрос.УстановитьПараметр("ДатаОтправления", ДатаОтправки);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКонца", ?(ДатаКонца <> Неопределено, КонецДня(ДатаКонца), ДатаКонца));
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПолучитьИнформациюПоВагонам(СписокВагоновСтрокой) Экспорт
	МассивНомеровВагонов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СписокВагоновСтрокой);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ПробегиВагоновСрезПоследних.ПолныйПробег, 0) КАК FullRun,
	|	ЕСТЬNULL(ПробегиВагоновСрезПоследних.ОстаточныйПробег, 0) КАК LeftRun,
	|	ЕСТЬNULL(ПробегиВагоновСрезПоследних.ПорогПробега, 0) КАК YellowLimit,
	|	ЕСТЬNULL(ПробегиВагоновСрезПоследних.НормативныйПробег, 0) КАК RedLimit,
	|	ТС.ТипТС.УсловнаяДлина КАК Length,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ОграниченияИспользования.ПоказательОграничения, ЛОЖЬ) = ИСТИНА
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ExportDeny,
	|	ТС.Наименование КАК CarNumber
	|ИЗ
	|	Справочник.ТС КАК ТС
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПробегиВагонов.СрезПоследних КАК ПробегиВагоновСрезПоследних
	|		ПО (ПробегиВагоновСрезПоследних.Вагон = ТС.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОграниченияИспользования КАК ОграниченияИспользования
	|		ПО (ОграниченияИспользования.УчетнаяЕдиница = ТС.Ссылка)
	|			И (ОграниченияИспользования.Ограничение = ЗНАЧЕНИЕ(Справочник.ОграниченияУчетныхЕдиниц.РазрешенПогранПереход))
	|			И (ОграниченияИспользования.ПоказательОграничения = ЛОЖЬ)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакСобственностиВагона.СрезПоследних КАК ПризнакСобственностиВагонаСрезПоследних
	|		ПО ТС.Ссылка = ПризнакСобственностиВагонаСрезПоследних.Вагон
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ЗаданСписокВагонов
	|				ТОГДА ТС.Наименование В (&МассивНомеровВагонов)
	|			ИНАЧЕ ЕСТЬNULL(ПризнакСобственностиВагонаСрезПоследних.ВЭксплуатации, ЛОЖЬ) = ИСТИНА
	|		КОНЕЦ
	|	И ТС.ТипТС.Вагон";
	Запрос.УстановитьПараметр("ЗаданСписокВагонов", МассивНомеровВагонов.Количество() > 0);
	Запрос.УстановитьПараметр("МассивНомеровВагонов", МассивНомеровВагонов);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура ЗагрузкаИзИРСВагоновВРефСцепах() Экспорт
	
	//ДИТ Моисеенко Ю.В. 03.11.2022 59323 -начало	
	ОтветXML = ВебСервисы_сервер.ЗапроситьРИТМ("ListRefHitch");
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ОтветXML);
	ОбъектДанных = ФабрикаXDTO.ПрочитатьXML(Чтение);
	СвойстваОбъекта = ОбъектДанных.Свойства();
	СвойствоОшибка = СвойстваОбъекта.Получить("error");
	
	Если СвойствоОшибка <> Неопределено Тогда
		
		Ошибка = ОбъектДанных.error;
		
		Если ТипЗнч(Ошибка) = Тип("Строка") Тогда
			КодОшибки = "";
			Описание = Ошибка;
		Иначе
			КодОшибки = Ошибка.ErrorCode;
			Описание = Ошибка.ErrorMessage;
		КонецЕсли;
		
		ТекстОшибки = СтрШаблон("При запросе данных из РИТМа, произошла ошибка(%1): %2", КодОшибки, Описание); 
		ЗаписьЖурналаРегистрации("ИРС.ЗагрузкаВагоновВРефСцепах", УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		ВызватьИсключение ТекстОшибки;

		Возврат;
		
	КонецЕсли;
	
	ТаблицаВагонов = ВебСервисы_сервер.УниверсальныйПарсерXML(ОтветXML, "refHitch");
	ЗагрузитьВагоныВРефСцепах(ТаблицаВагонов);
	//ДИТ Моисеенко Ю.В. 03.11.2022 59323 -конец
	
КонецПроцедуры

Процедура ЗагрузитьВагоныВРефСцепах(ТаблицаДанных)
	
	//ДИТ Моисеенко Ю.В. 03.11.2022 59323 -начало
	ТаблицаВагонов = ТипизироватьТаблицуВагонов(ТаблицаДанных);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаВагонов", ТаблицаВагонов);
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаВагонов.refHitch КАК refHitch,
	|	ТаблицаВагонов.hitchNum КАК hitchNum,
	|	ТаблицаВагонов.wagonNumber КАК wagonNumber,
	|	ТаблицаВагонов.hitchPossible КАК hitchPossible,
	|	ТаблицаВагонов.controller1 КАК controller1,
	|	ТаблицаВагонов.Controller2 КАК Controller2,
	|	ТаблицаВагонов.email КАК email,
	|	ТаблицаВагонов.НомерКонтейнера КАК НомерКонтейнера
	|ПОМЕСТИТЬ ВТТЗВагоны
	|ИЗ
	|	&ТаблицаВагонов КАК ТаблицаВагонов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТТЗВагоны.refHitch КАК refHitch,
	|	ВТТЗВагоны.hitchNum КАК hitchNum,
	|	ВТТЗВагоны.wagonNumber КАК wagonNumber,
	|	ВТТЗВагоны.hitchPossible КАК hitchPossible,
	|	ВТТЗВагоны.controller1 КАК controller1,
	|	ВТТЗВагоны.Controller2 КАК Controller2,
	|	ВТТЗВагоны.email КАК email,
	|	АВТОНОМЕРЗАПИСИ() КАК НомерСтроки
	|ПОМЕСТИТЬ ВТВагоныНумерация
	|ИЗ
	|	ВТТЗВагоны КАК ВТТЗВагоны
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
