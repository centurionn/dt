			РегистрыСведений.СтатусыОбъектов.ЗафиксироватьМассивСтатусов(ТаблицаСтатусов, СсылкаДокумента);
			//Евросиб СубботинВ #128763 04.02.2026 Конец
		КонецЕсли;
		//Евросиб СубботинВ #111466 09.06.2025 Конец
	КонецЕсли;
	//Евросиб СубботинВ #89527 30.10.2024 Конец	
	Возврат Сообщение.Текст;
	
КонецФункции // ОтметитьПроведениеДокументаВБухУчете(XMLParams)

// Евросиб(ДИТ) US 73033 ТА 88304 Сержантова А.С. 29.07.2024
Функция ПолучитьСтатусДокумента(XMLParams) Экспорт

	СтрокиЗапроса = ОбщегоНазначения.ЗначениеИзСтрокиXML(XMLParams);
	
	Для каждого Строка Из СтрокиЗапроса Цикл
		ЗаявкаСсылка = Документы.ЗаявкаНаОплату.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.ГУИД)); 	
		ЗначениеСтатуса = РегистрыСведений.СтатусыОбъектов.ПолучитьПоследнее(ТекущаяДата(), Новый Структура("Объект", ЗаявкаСсылка));
	    Строка.Вставить("Состояние", ЗначениеСтатуса.Статус.Наименование);
	КонецЦикла;      
	
	Возврат ОбщегоНазначения.ЗначениеВСтрокуXML(СтрокиЗапроса);

КонецФункции 

Функция ЗаписатьИзмененияВПланДДС(XMLParams) Экспорт

	СтруктураПлана = ОбщегоНазначения.ЗначениеИзСтрокиXML(XMLParams);
	ПланДДССсылка = РегистрыСведений.ПротоколОбменов.СсылкаПоУИД(СтруктураПлана.ГУИД, Перечисления.ДействияПриОбмене.ВыгрузкаДанных, Перечисления.УзлыОбмена.УПП);
	Если Не ЗначениеЗаполнено(ПланДДССсылка) Тогда
		Возврат ОбщегоНазначения.ЗначениеВСтрокуXML("План ДДС с ГУИД "  + СтруктураПлана.ГУИД + " не найден. Данные не записаны.");
	КонецЕсли;
	Запрос = Новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТЗДДС.ТЧДокумента КАК ТЧДокумента,
	               |	ТЗДДС.СтатьяДДСНаименование КАК СтатьяДДСНаименование,
	               |	ТЗДДС.Сумма КАК Сумма,
	               |	ТЗДДС.ДатаДвижения КАК ДатаДвижения,
	               |	ТЗДДС.КлючСтроки КАК КлючСтроки,
	               |	ТЗДДС.ВалютаДокументаКод КАК ВалютаДокументаКод,
	               |	ТЗДДС.УИДДоговораКонтаргента КАК УИДДоговораКонтаргента,
	               |	ТЗДДС.УИДКонтрагента КАК УИДКонтрагента
	               |ПОМЕСТИТЬ ТЗДДС
	               |ИЗ
	               |	&ТЗДДС КАК ТЗДДС
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТЗДДС.ТЧДокумента КАК ТЧДокумента,
	               |	СтатьиДвиженияДенежныхСредств.Ссылка КАК СтатьяДвиженияДенежныхСредств,
	               |	Валюты.Ссылка КАК Валюта,
	               |	ТЗДДС.Сумма КАК Сумма,
	               |	ТЗДДС.ДатаДвижения КАК ДатаДвижения,
	               |	ТЗДДС.КлючСтроки КАК КлючСтроки,
	               |	Контрагенты.Объект КАК Контрагент,
	               |	ДоговорыКонтрагентов.Объект КАК ДоговорКонтрагента
	               |ИЗ
	               |	ТЗДДС КАК ТЗДДС
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтатьиДвиженияДенежныхСредств КАК СтатьиДвиженияДенежныхСредств
	               |		ПО ТЗДДС.СтатьяДДСНаименование = СтатьиДвиженияДенежныхСредств.Код
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
	               |		ПО ТЗДДС.ВалютаДокументаКод = Валюты.Код
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК Контрагенты
	               |		ПО ТЗДДС.УИДКонтрагента = Контрагенты.УИДИсточника
	               |			И (Контрагенты.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
	               |			И (Контрагенты.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.БитФинанс))
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ДоговорыКонтрагентов
	               |		ПО ТЗДДС.УИДДоговораКонтаргента = ДоговорыКонтрагентов.УИДИсточника
	               |			И (ДоговорыКонтрагентов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
	               |			И (ДоговорыКонтрагентов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.БитФинанс))";
	Запрос.УстановитьПараметр("ПланДДССсылка", ПланДДССсылка);
	Запрос.УстановитьПараметр("ТЗДДС", СтруктураПлана.ТЗДДС);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	ПланДДСОбъект = ПланДДССсылка.ПолучитьОбъект();
	Пока Выборка.Следующий() Цикл
		Строка = ПланДДСОбъект[Выборка.ТЧДокумента].Найти(Выборка.КлючСтроки, "КлючСтроки");
		Если Строка = Неопределено Тогда
			Строка = ПланДДСОбъект[Выборка.ТЧДокумента].Добавить();
		КонецЕсли; 
		ЗаполнитьЗначенияСвойств(Строка, Выборка);
	КонецЦикла;
	
	ПланДДСОбъект.ОбменДанными.Загрузка = Истина;
	ПланДДСОбъект.Записать();
	Возврат ОбщегоНазначения.ЗначениеВСтрокуXML("План ДДС обновлён");

КонецФункции // ЗаписатьИзмененияВПланДДС(XMLParams)

