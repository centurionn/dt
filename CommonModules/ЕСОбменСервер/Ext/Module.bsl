Процедура ОбработкаФайловАсуИнформ(ИмяПапки, ЭтоТест) Экспорт
	
	МассивФайлов = НайтиФайлы(Константы.КаталогДислокацииРФ.Получить() + "\Дислокации для загрузки в DC\" + ИмяПапки, "*.xml");
	СписокФайлов = Новый СписокЗначений;
	Для Каждого Файл Из МассивФайлов Цикл
		СписокФайлов.Добавить(Файл, Файл.ИмяБезРасширения);		
	КонецЦикла;
	СписокФайлов.СортироватьПоПредставлению();
	
	Для Каждого Файл Из СписокФайлов Цикл
		ЗаписьЖурналаРегистрации("Загрузка дислокаций", 
								УровеньЖурналаРегистрации.Информация,
								,
								,
								СтрШаблон("Начало загрузки файла дислокаций (%1) %2 %3",ИмяПапки, Файл.Значение.Имя, ТекущаяДата()));
		МассивОшибок = Новый Массив;
		Отказ = Ложь;
		
		//Евросиб Каблов 22.06.2020 (
		Если ИмяПапки = "Контейнеры море" Тогда
			ЗаписатьМорскиеДислокацииКонтейнеров(Файл.Значение.ПолноеИмя, МассивОшибок, ЭтоТест);
		Иначе		
		//Евросиб Каблов 22.06.2020 )		
			Чтение = Новый ЧтениеXML;
			Чтение.ОткрытьФайл(Файл.Значение.ПолноеИмя);
			КорневойОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(Чтение);
			Чтение.Закрыть();
			ТаблицаДислокации = ПолучитьТаблицуДислокации();
			
			Если ТипЗнч(КорневойОбъектXDTO.ROW) = Тип("СписокXDTO") Тогда
				Для Каждого Элемент Из КорневойОбъектXDTO.ROW Цикл
					Если ИмяПапки = "Вагоны" Тогда
						нСтрокаДислокации = ТаблицаДислокации.Добавить();
						ПрочитатьДислокациюВагона(Элемент, МассивОшибок, нСтрокаДислокации, ЭтоТест);
					ИначеЕсли ИмяПапки = "Контейнеры" Тогда
						ЗаписатьДислокациюКонтейнера(Элемент, МассивОшибок, ЭтоТест);
					ИначеЕсли ИмяПапки = "Пробеги" Тогда
						ЗаписатьПробегиВагонов(Элемент, МассивОшибок, Файл.Представление, ЭтоТест);
					ИначеЕсли ИмяПапки = "Ремонты" Тогда
						ЗаписатьРемонты(Элемент, МассивОшибок, ЭтоТест);
					ИначеЕсли ИмяПапки = "ПаспортаВагонов" Тогда
						ЗаписатьПаспортаВагонов(Элемент, МассивОшибок, ЭтоТест);
					КонецЕсли;
				КонецЦикла;
				Если ИмяПапки = "Вагоны" Тогда
					ТаблицаДислокации.Сортировать("Вагон, Период");
					ЗаполнитьДатыОтправления(ТаблицаДислокации);
					Для каждого СтрокаДислокации Из ТаблицаДислокации Цикл
						мз = РегистрыСведений.ДислокацияВагонов.СоздатьМенеджерЗаписи();
						ЗаполнитьЗначенияСвойств(мз, СтрокаДислокации);
						мз.Записать();
					КонецЦикла; 
				КонецЕсли; 
			ИначеЕсли ТипЗнч(КорневойОбъектXDTO.ROW) = Тип("ОбъектXDTO") Тогда
				Если ИмяПапки = "Вагоны" Тогда
					ЗаписатьДислокациюВагона(КорневойОбъектXDTO.ROW, МассивОшибок, ЭтоТест);
				ИначеЕсли ИмяПапки = "Контейнеры" Тогда
					ЗаписатьДислокациюКонтейнера(КорневойОбъектXDTO.ROW, МассивОшибок, ЭтоТест);
				ИначеЕсли ИмяПапки = "Пробеги" Тогда
					ЗаписатьПробегиВагонов(КорневойОбъектXDTO.ROW, МассивОшибок, Файл.Представление, ЭтоТест);
				ИначеЕсли ИмяПапки = "Ремонты" Тогда
					ЗаписатьРемонты(КорневойОбъектXDTO.ROW, МассивОшибок, ЭтоТест);
				ИначеЕсли ИмяПапки = "ПаспортаВагонов" Тогда
					ЗаписатьПаспортаВагонов(КорневойОбъектXDTO.ROW, МассивОшибок, ЭтоТест);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если МассивОшибок.Количество() > 0 Тогда
			ЗаписьЖурналаРегистрации("Загрузка дислокаций", 
									УровеньЖурналаРегистрации.Ошибка,
									,
									,
									СтрШаблон("При загрузке файла %1 произошли следующие ошибки %2", Файл.Значение.Имя, СтрСоединить(МассивОшибок, Символы.ПС)));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При загрузке файла " + Файл.Значение.ПолноеИмя + " произошли следующие ошибки:" + Символы.ПС + СтрСоединить(МассивОшибок, Символы.ПС));	
			Если Не ЭтоТест Тогда
				Попытка
					ПереместитьФайл(Файл.Значение.ПолноеИмя, Константы.КаталогДислокацииРФ.Получить() + "\Дислокации для загрузки в DC\Обработанные файлы\Ошибки\" + Файл.Значение.Имя); 
				Исключение
					ЗаписьЖурналаРегистрации("Загрузка дислокаций", 
											УровеньЖурналаРегистрации.Ошибка,
											,
											,
											СтрШаблон("При перемещении файла %1 произошла ошибка %2", Файл.Значение.Имя, ОписаниеОшибки()));
				КонецПопытки;
			КонецЕсли;
			//Евросиб Коханенко Н.А. 28.12.2023 (( #79320 
			ОтправлениеЭлектронногоСообщенияОбОшибкахЗагрузкиЛокаций(МассивОшибок);
			//Евросиб Коханенко Н.А. 28.12.2023 )) #79320 
		Иначе
			Если Не ЭтоТест Тогда
				Попытка
					ПереместитьФайл(Файл.Значение.ПолноеИмя, Константы.КаталогДислокацииРФ.Получить() +"\Дислокации для загрузки в DC\Обработанные файлы\Успешно\" + Файл.Значение.Имя); 
				Исключение
					ЗаписьЖурналаРегистрации("Загрузка дислокаций", 
											УровеньЖурналаРегистрации.Ошибка,
											,
											,
											СтрШаблон("При перемещении файла %1 произошла ошибка %2", Файл.Значение.Имя, ОписаниеОшибки()));
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		ЗаписьЖурналаРегистрации("Загрузка дислокаций", 
							УровеньЖурналаРегистрации.Информация,
							,
							,
							СтрШаблон("Конец загрузки файла дислокаций (%1) %2 %3",ИмяПапки, Файл.Значение.Имя, ТекущаяДата()));
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура ЗаписатьПробегиВагонов(ДислокацияXDTO, МассивОшибок, ИмяФайла, ЭтоТест)
	
	Если СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Прав(ИмяФайла, 14)) Тогда
		Попытка
			Период = Дата(Прав(ИмяФайла, 14));
		Исключение
			МассивОшибок.Добавить("Неверный формат даты в имени файла");
			Возврат;
		КонецПопытки;
	Иначе
		МассивОшибок.Добавить("Неверный формат даты в имени файла");
		Возврат;
	КонецЕсли;
	
	Если ДислокацияXDTO.Свойства().Получить("carNum") <> Неопределено Тогда 
		Вагон = Справочники.ТС.НайтиПоНаименованию(ДислокацияXDTO.carNum, Истина); 	
		Если Вагон.Пустая() Тогда
			Если ЭтоТест Тогда
				ВагонОбъект = Справочники.ТС.СоздатьЭлемент();
				ВагонОбъект.Наименование = ДислокацияXDTO.carNum;
				ВагонОбъект.Записать();
				Вагон = ВагонОбъект.Ссылка;
			Иначе
				МассивОшибок.Добавить("В справочнике ""ТС"" не найден вагон с номером " + ДислокацияXDTO.carNum);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	Иначе
		МассивОшибок.Добавить("В одном из пробегов не заполнено обязательное поле carNum");
		Возврат;
	КонецЕсли;
	
	//Если МассивОшибок.Количество() > 0 Тогда
	//	Возврат;
	//КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.ПробегиВагонов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = Период; 	
	МенеджерЗаписи.Вагон = Вагон;
	Если ДислокацияXDTO.Свойства().Получить("totalRun") <> Неопределено Тогда
		МенеджерЗаписи.ПолныйПробег = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ДислокацияXDTO.totalRun);	
	КонецЕсли;
	Если ДислокацияXDTO.Свойства().Получить("restRun") <> Неопределено Тогда
		МенеджерЗаписи.ОстаточныйПробег = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ДислокацияXDTO.restRun);	
	КонецЕсли;
	Если ДислокацияXDTO.Свойства().Получить("brdRun") <> Неопределено Тогда
		МенеджерЗаписи.ПорогПробега = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ДислокацияXDTO.brdRun);	
	КонецЕсли;
	Если ДислокацияXDTO.Свойства().Получить("nrmRun") <> Неопределено Тогда
		МенеджерЗаписи.НормативныйПробег = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ДислокацияXDTO.nrmRun);	
	КонецЕсли;
	
	Попытка
		МенеджерЗаписи.Записать();
	Исключение
		МассивОшибок.Добавить(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьТаблицуДислокации()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДислокацияВагонов.Период КАК Период,
	|	ДислокацияВагонов.Вагон КАК Вагон,
	|	ДислокацияВагонов.ОперацияСВагоном КАК ОперацияСВагоном,
	|	ДислокацияВагонов.РабочийПарк КАК РабочийПарк,
	|	ДислокацияВагонов.Груженый КАК Груженый,
	|	ДислокацияВагонов.НомерПоезда КАК НомерПоезда,
	|	ДислокацияВагонов.ИндексПоезда КАК ИндексПоезда,
	|	ДислокацияВагонов.КодГрузоотправителя КАК КодГрузоотправителя,
	|	ДислокацияВагонов.КодГрузополучателя КАК КодГрузополучателя,
	|	ДислокацияВагонов.Собственник КАК Собственник,
	|	ДислокацияВагонов.КодГрузаЕТСНГ КАК КодГрузаЕТСНГ,
	|	ДислокацияВагонов.Груз КАК Груз,
	|	ДислокацияВагонов.ВесГруза КАК ВесГруза,
	|	ДислокацияВагонов.СтанцияОперации КАК СтанцияОперации,
	|	ДислокацияВагонов.СтанцияНазначения КАК СтанцияНазначения,
	|	ДислокацияВагонов.СтанцияОтправления КАК СтанцияОтправления,
	|	ДислокацияВагонов.ДатаПрибытияНаСтанцию КАК ДатаПрибытияНаСтанцию,
	|	ДислокацияВагонов.ПростойНаСтанции КАК ПростойНаСтанции,
	|	ДислокацияВагонов.ДатаОтправленияСоСтанции КАК ДатаОтправленияСоСтанции,
	|	ДислокацияВагонов.ОстаточноеРасстояниеКМ КАК ОстаточноеРасстояниеКМ
	|ИЗ
	|	РегистрСведений.ДислокацияВагонов КАК ДислокацияВагонов";
	ТЗ = Запрос.Выполнить().Выгрузить();
	ТЗ.Очистить();
	Возврат ТЗ;
	
	
КонецФункции

Процедура ЗаполнитьДатыОтправления(ТаблицаДислокации)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДислокацияВагонов.Период КАК Период,
	|	ДислокацияВагонов.Вагон КАК Вагон,
	|	ДислокацияВагонов.ОперацияСВагоном КАК ОперацияСВагоном,
	|	ДислокацияВагонов.РабочийПарк КАК РабочийПарк,
	|	ДислокацияВагонов.Груженый КАК Груженый,
	|	ДислокацияВагонов.НомерПоезда КАК НомерПоезда,
	|	ДислокацияВагонов.ИндексПоезда КАК ИндексПоезда,
	|	ДислокацияВагонов.КодГрузоотправителя КАК КодГрузоотправителя,
	|	ДислокацияВагонов.КодГрузополучателя КАК КодГрузополучателя,
	|	ДислокацияВагонов.Собственник КАК Собственник,
	|	ДислокацияВагонов.КодГрузаЕТСНГ КАК КодГрузаЕТСНГ,
	|	ДислокацияВагонов.Груз КАК Груз,
	|	ДислокацияВагонов.ВесГруза КАК ВесГруза,
	|	ДислокацияВагонов.СтанцияОперации КАК СтанцияОперации,
	|	ДислокацияВагонов.СтанцияНазначения КАК СтанцияНазначения,
	|	ДислокацияВагонов.СтанцияОтправления КАК СтанцияОтправления,
	|	ДислокацияВагонов.ДатаПрибытияНаСтанцию КАК ДатаПрибытияНаСтанцию,
	|	ДислокацияВагонов.ПростойНаСтанции КАК ПростойНаСтанции,
	|	ДислокацияВагонов.ДатаОтправленияСоСтанции КАК ДатаОтправленияСоСтанции,
	|	ДислокацияВагонов.ОстаточноеРасстояниеКМ КАК ОстаточноеРасстояниеКМ
	|ПОМЕСТИТЬ ВремТЧ
	|ИЗ
	|	&ДислокацияВагонов КАК ДислокацияВагонов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВремТЧ.Период КАК Период,
	|	ВремТЧ.Вагон КАК Вагон,
	|	ВремТЧ.ОперацияСВагоном КАК ОперацияСВагоном,
	|	ВремТЧ.РабочийПарк КАК РабочийПарк,
	|	ВремТЧ.Груженый КАК Груженый,
	|	ВремТЧ.НомерПоезда КАК НомерПоезда,
	|	ВремТЧ.ИндексПоезда КАК ИндексПоезда,
	|	ВремТЧ.КодГрузоотправителя КАК КодГрузоотправителя,
	|	ВремТЧ.КодГрузополучателя КАК КодГрузополучателя,
	|	ВремТЧ.Собственник КАК Собственник,
	|	ВремТЧ.КодГрузаЕТСНГ КАК КодГрузаЕТСНГ,
	|	ВремТЧ.Груз КАК Груз,
	|	ВремТЧ.ВесГруза КАК ВесГруза,
	|	ВремТЧ.СтанцияОперации КАК СтанцияОперации,
	|	ВремТЧ.СтанцияНазначения КАК СтанцияНазначения,
	|	ВремТЧ.СтанцияОтправления КАК СтанцияОтправления,
	|	ВремТЧ.ДатаПрибытияНаСтанцию КАК ДатаПрибытияНаСтанцию,
	|	ВремТЧ.ПростойНаСтанции КАК ПростойНаСтанции,
	|	ВЫБОР
	|		КОГДА ВремТЧ.СтанцияОперации = ВремТЧ.СтанцияОтправления
	|			ТОГДА ВремТЧ.Период
	|		ИНАЧЕ ВложенныйЗапрос.ДатаОтправленияСоСтанции
	|	КОНЕЦ КАК ДатаОтправленияСоСтанции,
	|	ВремТЧ.ОстаточноеРасстояниеКМ КАК ОстаточноеРасстояниеКМ
	|ИЗ
	|	ВремТЧ КАК ВремТЧ
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
	|			ДислокацияВагоновСрезПоследних.Вагон КАК Вагон,
	|			МАКСИМУМ(ДислокацияВагоновСрезПоследних.ДатаОтправленияСоСтанции) КАК ДатаОтправленияСоСтанции
	|		ИЗ
	|			РегистрСведений.ДислокацияВагонов.СрезПоследних КАК ДислокацияВагоновСрезПоследних
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|					ДислокацияВагонов.Вагон КАК Вагон,
	|					МАКСИМУМ(ДислокацияВагонов.Период) КАК Период
	|				ИЗ
	|					РегистрСведений.ДислокацияВагонов КАК ДислокацияВагонов
	|						ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВремТЧ КАК ВремТЧ
	|						ПО ДислокацияВагонов.Вагон = ВремТЧ.Вагон
	|							И ДислокацияВагонов.Период <= ВремТЧ.Период
	|				
	|				СГРУППИРОВАТЬ ПО
	|					ДислокацияВагонов.Вагон) КАК ВложенныйЗапрос
	|				ПО ДислокацияВагоновСрезПоследних.Вагон = ВложенныйЗапрос.Вагон
	|					И ДислокацияВагоновСрезПоследних.Период = ВложенныйЗапрос.Период
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ДислокацияВагоновСрезПоследних.Вагон) КАК ВложенныйЗапрос
	|		ПО ВремТЧ.Вагон = ВложенныйЗапрос.Вагон";
	Запрос.УстановитьПараметр("ДислокацияВагонов", ТаблицаДислокации);
	ТаблицаДислокации = Запрос.Выполнить().Выгрузить();
	
КонецПроцедуры

Процедура ЗаписатьДислокациюКонтейнера(ДислокацияXDTO, МассивОшибок, ЭтоТест)
	
	Если ДислокацияXDTO.Свойства().Получить("NOM_KON") <> Неопределено Тогда 
		//Евросиб Каблов 06.10.2020 (
		//Контейнер = РаботаСКонтейнерамиСервер.НайтиКТК(ДислокацияXDTO.NOM_KON); // Справочники.ТЕ.НайтиПоНаименованию(ДислокацияXDTO.NOM_KON, Истина);
		//Если Контейнер.Пустая() Тогда
		Контейнер = РаботаСКонтейнерамиСервер.НайтиКТК(ДислокацияXDTO.NOM_KON, Ложь);				
		Если Не ЗначениеЗаполнено(Контейнер) Тогда
		//Евросиб Каблов 06.10.2020 )
			Если ЭтоТест Тогда
				//КонтейнерОбъект = Справочники.ТЕ.СоздатьЭлемент();
				//КонтейнерОбъект.Префикс = Лев(ДислокацияXDTO.NOM_KON, 4); 
				//КонтейнерОбъект.Номер =  Сред(ДислокацияXDTO.NOM_KON, 5, 6); 
				//КонтейнерОбъект.КонтрольноеЧисло = Прав(ДислокацияXDTO.NOM_KON, 1);			
				//КонтейнерОбъект.Записать();
				//Контейнер = КонтейнерОбъект.Ссылка;
				Префикс = Лев(ДислокацияXDTO.NOM_KON, 4); 
				Номер =  Сред(ДислокацияXDTO.NOM_KON, 5, 6); 
				КонтрольноеЧисло = Прав(ДислокацияXDTO.NOM_KON, 1);			
				НомерКТК = "" + Префикс + Номер + КонтрольноеЧисло;
				Контейнер = РаботаСКонтейнерамиСервер.СоздатьКТК(НомерКТК);
			Иначе
				МассивОшибок.Добавить("В справочнике DataCore не найден контейнер с номером " + ДислокацияXDTO.NOM_KON);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	Иначе
		МассивОшибок.Добавить("В одной из дислокаций не заполнено обязательное поле NOM_KON");
		Возврат;
	КонецЕсли;
	
	//Если МассивОшибок.Количество() > 0 Тогда
	//	Возврат;
	//КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.ДислокацияКонтейнеров.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Контейнер = Контейнер;
		
	Если ДислокацияXDTO.Свойства().Получить("KOP_KMD") <> Неопределено И ДислокацияXDTO.Свойства().Получить("PR_KOP_KMD") <> Неопределено Тогда
//Евросиб Гудкова( 10.10.2019 
//было		ОперацияСВагоном = Справочники.ОперацииСВагонами.НайтиПоКоду(ДислокацияXDTO.PR_KOP_KMD + ДислокацияXDTO.KOP_KMD);
		ОперацияСВагоном = Неопределено;
		ОперацииСВагономВыборка = Справочники.ОперацииСВагонами.Выбрать(,, Новый Структура("Код", ДислокацияXDTO.PR_KOP_KMD + ДислокацияXDTO.KOP_KMD));
		Пока ОперацииСВагономВыборка.Следующий() Цикл
			Если ОперацииСВагономВыборка.ОперацияСКТК Тогда
				ОперацияСВагоном = ОперацииСВагономВыборка.Ссылка;
				Прервать;
			КонецЕсли; 
		КонецЦикла; 
// Евросиб Гудкова) 		
		Если Не ЗначениеЗаполнено(ОперацияСВагоном) Тогда
			НоваяОперацияСВагоном = Справочники.ОперацииСВагонами.СоздатьЭлемент();
			НоваяОперацияСВагоном.Наименование = ДислокацияXDTO.PR_KOP_KMD + ДислокацияXDTO.KOP_KMD;
			НоваяОперацияСВагоном.Код = ДислокацияXDTO.PR_KOP_KMD + ДислокацияXDTO.KOP_KMD;
			НоваяОперацияСВагоном.ОперацияСКТК = Истина;
			Попытка
				НоваяОперацияСВагоном.Записать();
			Исключение
				МассивОшибок.Добавить(ОписаниеОшибки());
				Возврат;
			КонецПопытки;
			ОперацияСВагоном = НоваяОперацияСВагоном.Ссылка;	
		КонецЕсли;
		МенеджерЗаписи.ОперацияСВагоном = ОперацияСВагоном;
	КонецЕсли;	
	
	Если ДислокацияXDTO.Свойства().Получить("TIP_KON") <> Неопределено Тогда
		МенеджерЗаписи.ТипКонтейнера = ДислокацияXDTO.TIP_KON;
	КонецЕсли;	
	Если ДислокацияXDTO.Свойства().Получить("PPK_POR") <> Неопределено Тогда
		МенеджерЗаписи.Груженый = XMLЗначение(Тип("Булево"), ДислокацияXDTO.PPK_POR);
	КонецЕсли;	
	Если ДислокацияXDTO.Свойства().Получить("STR_OTPRV") <> Неопределено Тогда
		МенеджерЗаписи.СтранаОтправления = Справочники.СтраныМира.НайтиПоКоду(ДислокацияXDTO.STR_OTPRV)
	КонецЕсли;
	Если ДислокацияXDTO.Свойства().Получить("STR_NAZN") <> Неопределено Тогда
		МенеджерЗаписи.СтранаНазначения = Справочники.СтраныМира.НайтиПоКоду(ДислокацияXDTO.STR_NAZN);
	КонецЕсли;	
	Если ДислокацияXDTO.Свойства().Получить("NOM_OTPRK") <> Неопределено Тогда
		МенеджерЗаписи.НомерНакладной = ДислокацияXDTO.NOM_OTPRK;
	КонецЕсли;	
	Если ДислокацияXDTO.Свойства().Получить("KOD_GRZ_ETSNG") <> Неопределено Тогда
		МенеджерЗаписи.КодГрузаЕТСНГ = ДислокацияXDTO.KOD_GRZ_ETSNG;
		МенеджерЗаписи.Груз = Справочники.Грузы.НайтиПоРеквизиту("ЕТСНГ", ДислокацияXDTO.KOD_GRZ_ETSNG);
	КонецЕсли;
	Если ДислокацияXDTO.Свойства().Получить("KOD_GRZ_GNG") <> Неопределено И МенеджерЗаписи.Груз.Пустая() Тогда
		МенеджерЗаписи.Груз = Справочники.Грузы.НайтиПоРеквизиту("ГНГ", ДислокацияXDTO.KOD_GRZ_GNG);
	КонецЕсли;
	Если ДислокацияXDTO.Свойства().Получить("MAS_GRZ") <> Неопределено Тогда
		МенеджерЗаписи.ВесГруза = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ДислокацияXDTO.MAS_GRZ);
	КонецЕсли;
	Если ДислокацияXDTO.Свойства().Получить("DATE_OP") <> Неопределено Тогда
		МенеджерЗаписи.Период = XMLЗначение(Тип("Дата"), ДислокацияXDTO.DATE_OP);
	КонецЕсли;
	Если ДислокацияXDTO.Свойства().Получить("INDEX_POEZD") <> Неопределено Тогда
		МенеджерЗаписи.ИндексПоезда = ДислокацияXDTO.INDEX_POEZD;
	КонецЕсли;
	Если ДислокацияXDTO.Свойства().Получить("NOM_VAG") <> Неопределено Тогда
		МенеджерЗаписи.Вагон = Справочники.ТС.НайтиПоНаименованию(ДислокацияXDTO.NOM_VAG, Истина);
	КонецЕсли;
	Если ДислокацияXDTO.Свойства().Получить("NOM_PPV") <> Неопределено Тогда
		МенеджерЗаписи.НомерППВ = ДислокацияXDTO.NOM_PPV; 
	КонецЕсли;
	Если ДислокацияXDTO.Свойства().Получить("STAN_POGR_OTPRK") <> Неопределено Тогда
		МенеджерЗаписи.СтанцияПогрузкиКонтейнера = ЛокацияПоКодуСтанции(ДислокацияXDTO.STAN_POGR_OTPRK);
	КонецЕсли;
	Если ДислокацияXDTO.Свойства().Получить("STAN_NAZN_VAG") <> Неопределено Тогда
		МенеджерЗаписи.СтанцияНазначения = ЛокацияПоКодуСтанции(ДислокацияXDTO.STAN_NAZN_VAG);
	КонецЕсли;
	Если ДислокацияXDTO.Свойства().Получить("STAN_POGR_VAG") <> Неопределено Тогда
		МенеджерЗаписи.СтанцияПогрузкиВагона = ЛокацияПоКодуСтанции(ДислокацияXDTO.STAN_POGR_VAG);
	КонецЕсли;
	Если ДислокацияXDTO.Свойства().Получить("STAN_OP") <> Неопределено Тогда
		МенеджерЗаписи.СтанцияОперации = ЛокацияПоКодуСтанции(ДислокацияXDTO.STAN_OP);
	КонецЕсли;	
	
	// siv 08/07/20 добавлю пробег
	МенеджерЗаписи.ОстаточноеРасстояниеКМ = ПолучитьОстаточноеРасстояниеМеждуСтанциями(МенеджерЗаписи.СтанцияОперации, МенеджерЗаписи.СтанцияНазначения);
	
	//Евросиб Каблов 07.12.2020 (
	МенеджерЗаписи.ДатаЗаписи = ТекущаяДата();
	//Евросиб Каблов 07.12.2020 )
	
	Попытка
		МенеджерЗаписи.Записать();
	Исключение
		МассивОшибок.Добавить(ОписаниеОшибки());
	КонецПопытки;
	
	Если ДислокацияXDTO.Свойства().Получить("OWN") <> Неопределено Тогда
		ЗаписатьПризнакСобственностиКонтейнера(Контейнер, ДислокацияXDTO.OWN, XMLЗначение(Тип("Дата"),ДислокацияXDTO.OWN_DATE_START));	
	КонецЕсли; 
		
КонецПроцедуры	

//Евросиб Каблов 22.06.2020
Процедура ЗаписатьМорскиеДислокацииКонтейнеров(ИмяФайла, МассивОшибок, ЭтоТест)
	
	ЗначенияПолейЗаписи = Новый Структура;
	ЗначенияПолейЗаписи.Вставить("Период");
	ЗначенияПолейЗаписи.Вставить("Контейнер");
	ЗначенияПолейЗаписи.Вставить("Линия");
	ЗначенияПолейЗаписи.Вставить("Порт");
	ЗначенияПолейЗаписи.Вставить("Судно");
	ЗначенияПолейЗаписи.Вставить("Рейс");
	ЗначенияПолейЗаписи.Вставить("Событие");
	ЗначенияПолейЗаписи.Вставить("containerNumber");
	ЗначенияПолейЗаписи.Вставить("sealine");
	ЗначенияПолейЗаписи.Вставить("id");
	ЗначенияПолейЗаписи.Вставить("name");
	ЗначенияПолейЗаписи.Вставить("lat");
	ЗначенияПолейЗаписи.Вставить("lng");
	ЗначенияПолейЗаписи.Вставить("country");
	ЗначенияПолейЗаписи.Вставить("distTo");
	ЗначенияПолейЗаписи.Вставить("type");
	ЗначенияПолейЗаписи.Вставить("voyage");
	ЗначенияПолейЗаписи.Вставить("vessel");
	ЗначенияПолейЗаписи.Вставить("pathTo"); 
	ЗначенияПолейЗаписи.Вставить("status");
	
	ТаблицаДислокаций = Новый ТаблицаЗначений;
	ТаблицаДислокаций.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТаблицаДислокаций.Колонки.Добавить("Контейнер", Новый ОписаниеТипов("СправочникСсылка.ТЕ"));
	ТаблицаДислокаций.Колонки.Добавить("Линия", Новый ОписаниеТипов("СправочникСсылка.МорскиеЛинии"));
	ТаблицаДислокаций.Колонки.Добавить("Порт", Новый ОписаниеТипов("СправочникСсылка.Локации"));
	ТаблицаДислокаций.Колонки.Добавить("Судно", Новый ОписаниеТипов("СправочникСсылка.ТС"));
	ТаблицаДислокаций.Колонки.Добавить("Рейс", Новый ОписаниеТипов("СправочникСсылка.РейсыМоре"));
	ТаблицаДислокаций.Колонки.Добавить("Событие", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(255)));
	ТаблицаДислокаций.Колонки.Добавить("containerNumber", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(11)));
	ТаблицаДислокаций.Колонки.Добавить("sealine", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(10)));
	ТаблицаДислокаций.Колонки.Добавить("id", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(10)));
	ТаблицаДислокаций.Колонки.Добавить("name", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(255)));
	ТаблицаДислокаций.Колонки.Добавить("lat", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15, 5)));
	ТаблицаДислокаций.Колонки.Добавить("lng", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15, 5)));
	ТаблицаДислокаций.Колонки.Добавить("country", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(2)));
	ТаблицаДислокаций.Колонки.Добавить("distTo", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(10, 0)));
	ТаблицаДислокаций.Колонки.Добавить("type", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(3)));
	ТаблицаДислокаций.Колонки.Добавить("voyage", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(255)));
	ТаблицаДислокаций.Колонки.Добавить("vessel", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(255)));
	ТаблицаДислокаций.Колонки.Добавить("pathTo", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(0)));
	
	МорскиеЛинии = Новый Соответствие;
	Локации = Новый Соответствие;
	РейсыМоре = Новый Соответствие;
	Суда = Новый Соответствие;
	
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ИмяФайла);
	
	ДанныеФайла = ФабрикаXDTO.ПрочитатьXML(Чтение);
	
	СтрокиДислокации = ДанныеФайла.row;
	Если ТипЗнч(СтрокиДислокации) = Тип("ОбъектXDTO") Тогда
		МассивСтрок = Новый Массив;
		МассивСтрок.Добавить(СтрокиДислокации);
		СтрокиДислокации = МассивСтрок;
	КонецЕсли;
	
	Для Каждого СтрокаДислокации Из СтрокиДислокации Цикл
		
		НомерКонтейнера = ПолучитьЗначениеПоляОбъектаXDTOПоИмени(СтрокаДислокации, "containerNumber");
		Если Не ЗначениеЗаполнено(НомерКонтейнера) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ЗначенияПолейЗаписи, СтрокаДислокации);
		
		//Евросиб Каблов 06.10.2020 (
		//ЗначенияПолейЗаписи.Контейнер = РаботаСКонтейнерамиСервер.НайтиКТК(ЗначенияПолейЗаписи.containerNumber); // Справочники.ТЕ.НайтиПоНаименованию(ЗначенияПолейЗаписи.containerNumber);
		ЗначенияПолейЗаписи.Контейнер = РаботаСКонтейнерамиСервер.НайтиКТК(НомерКонтейнера, Ложь);
		Если Не ЗначениеЗаполнено(ЗначенияПолейЗаписи.Контейнер) Тогда
			Если ЭтоТест Тогда
				//КонтейнерОбъект = Справочники.ТЕ.СоздатьЭлемент();
				//КонтейнерОбъект.Префикс = Лев(НомерКонтейнера, 4); 
				//КонтейнерОбъект.Номер =  Сред(НомерКонтейнера, 5, 6); 
				//КонтейнерОбъект.КонтрольноеЧисло = Прав(НомерКонтейнера, 1);			
				//КонтейнерОбъект.Записать();
				//ЗначенияПолейЗаписи.Контейнер = КонтейнерОбъект.Ссылка;
				Префикс = Лев(НомерКонтейнера, 4); 
				Номер =  Сред(НомерКонтейнера, 5, 6); 
				КонтрольноеЧисло = Прав(НомерКонтейнера, 1);			
				НомерКТК = "" + Префикс + Номер + КонтрольноеЧисло;
				Контейнер = РаботаСКонтейнерамиСервер.СоздатьКТК(НомерКТК);
				ЗначенияПолейЗаписи.Контейнер = Контейнер;
			Иначе
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		//Евросиб Каблов 06.10.2020 )
		
		МорскаяЛинияСсылка = МорскиеЛинии.Получить(ЗначенияПолейЗаписи.sealine);
		Если ЗначениеЗаполнено(МорскаяЛинияСсылка) Тогда
			ЗначенияПолейЗаписи.Линия = МорскаяЛинияСсылка;
		Иначе
			ЗначенияПолейЗаписи.Линия = Справочники.МорскиеЛинии.НайтиПоРеквизиту("КодSearates", ЗначенияПолейЗаписи.sealine);
			МорскиеЛинии.Вставить(ЗначенияПолейЗаписи.sealine, ЗначенияПолейЗаписи.Линия);
		КонецЕсли;
		
		СписокТочек = СтрокаДислокации.points;
		Точки = СписокТочек.point;
		Если ТипЗнч(Точки) = Тип("ОбъектXDTO") Тогда
			МассивСтрок = Новый Массив;
			МассивСтрок.Добавить(Точки);
			Точки = МассивСтрок;
		КонецЕсли;
		
		Для Каждого Точка Из Точки Цикл
			
			ЗаполнитьЗначенияСвойств(ЗначенияПолейЗаписи, Точка);
			//ИД = Точка.id;
			//Имя = Точка.name;
			//ПорядковыйНомер = Точка.orderNo;
			Если НЕ ЗначениеЗаполнено(ЗначенияПолейЗаписи.name) Тогда
				Продолжить;
			КонецЕсли; 
			
			ЛокацияСсылка = Локации.Получить(ЗначенияПолейЗаписи.name);
			Если ЗначениеЗаполнено(ЛокацияСсылка) Тогда
				ЗначенияПолейЗаписи.Порт = ЛокацияСсылка;
			Иначе				
				ЗначенияПолейЗаписи.Порт = Справочники.Локации.НайтиПоРеквизиту("НаименованиеАнгл", ЗначенияПолейЗаписи.name);
				Локации.Вставить(ЗначенияПолейЗаписи.name, ЗначенияПолейЗаписи.Порт);
			КонецЕсли;
			
			//Точки следования до порта
			Если Точка.Свойства().Получить("pathTo") <> Неопределено Тогда
				
				Путь = Точка.pathTo;
				ТочкиПути = Путь.row;
				Если ТипЗнч(ТочкиПути) = Тип("ОбъектXDTO") Тогда
					МассивСтрок = Новый Массив;
					МассивСтрок.Добавить(ТочкиПути);
					ТочкиПути = МассивСтрок;
				КонецЕсли;
				
				ТочкиСледованияДоПорта = Новый Массив;
				Для Каждого ТочкаПути Из ТочкиПути Цикл
					
					ДанныеТочки = Новый Структура;
					ДанныеТочки.Вставить("lattitude");
					ДанныеТочки.Вставить("longtitude");
					ДанныеТочки.Вставить("orderNo");
									
					ЗаполнитьЗначенияСвойств(ДанныеТочки, ТочкаПути);
									
					ТочкаСледоования = СтрШаблон("%1:%2:%3", ДанныеТочки.orderNo, ДанныеТочки.lattitude, ДанныеТочки.longtitude);
					ТочкиСледованияДоПорта.Добавить(ТочкаСледоования);
					
				КонецЦикла;
				
				ЗначенияПолейЗаписи.pathTo = СтрСоединить(ТочкиСледованияДоПорта, ";");
				
			Иначе
				
				ЗначенияПолейЗаписи.pathTo = "";
				
			КонецЕсли;
			
			//События			
