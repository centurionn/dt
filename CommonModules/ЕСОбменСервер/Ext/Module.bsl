Функция СформироватьВложенныеФайлыДляПСЦ(ДокументПСЦ) 
	
	ТЗФайлы = Новый ТаблицаЗначений;   
	ТЗФайлы.Колонки.Добавить("Имя");
	ТЗФайлы.Колонки.Добавить("Расширение"); 
	ТЗФайлы.Колонки.Добавить("ПометкаУдаления");
	ТЗФайлы.Колонки.Добавить("Файл"); 
	ТЗФайлы.Колонки.Добавить("ГуидФайла");
	
	// прикрепляем ПФ Протокола для ПСЦ клиента
	// ДИТ BUG 79699 ТА 82943 Сержантова А.С. Начало: 03.04.2024
	// Было:
	//Если не ДокументПСЦ.ПСЦПоставщика Тогда //и ЗначениеЗаполнено(ДокументПСЦ.ФорматПротокола)
	//Стало:
	//Евросиб Коханенко Н.А. 03.04.2025 (( #102319
	//если это Типовой ПСЦПоставщика с типом Автоперевозки, то тоже ищем прикрепленный файл
	//Если ЗначениеЗаполнено(ДокументПСЦ.ФорматПротокола) Тогда 
	Если ЗначениеЗаполнено(ДокументПСЦ.ФорматПротокола)
		//Евросиб Коханенко Н.А. 24.07.2025 (( #115134 
		//ИЛИ (ДокументПСЦ.Типовой
		ИЛИ (ТипЗнч(ДокументПСЦ) = Тип("ДокументСсылка.ПСЦПоставщика") //реквизит Типовой есть только у ПСЦПоставщика
			И ДокументПСЦ.Типовой
		//Евросиб Коханенко Н.А. 24.07.2025 )) #115134 
			И ДокументПСЦ.ВидУслугПоставщика = ПредопределенноеЗначение("Справочник.ВидыУслугПоставщиков.Автоперевозки")) Тогда
	//Евросиб Коханенко Н.А. 03.04.2025 )) #102319 
	// ДИТ BUG 79699 ТА 82943 Сержантова А.С. Конец: 03.04.2024	
		
		ИмяФайлаПФ = "Протокол " + СтрЗаменить(ДокументПСЦ.НомерПСЦ,"/","-") + " от " + Формат(ДокументПСЦ.ДатаПСЦ, "ДФ=dd.MM.yyyy");  
		
		Запрос = Новый Запрос;
		Запрос.Текст =    
		// ДИТ BUG 82479 ТА 84966 Сержантова А.С. Начало: 23.05.2024
		// Было:
		//"ВЫБРАТЬ ПЕРВЫЕ 1 
		//Стало:
		"ВЫБРАТЬ 
		// ДИТ BUG 82479 ТА 84966 Сержантова А.С. Конец: 23.05.2024
		|	Файлы.Ссылка КАК Файл,
		|	Файлы.Наименование КАК Имя,
		|	Файлы.Расширение КАК Расширение,
		|	Файлы.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.Файлы КАК Файлы
