	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТС КАК ТС
	|		ПО ВТДислокации.vessel = ТС.Наименование";
	 
	ТаблицаДислокаций = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Дислокация Из ТаблицаДислокаций Цикл
		
		Если Не ЗначениеЗаполнено(Дислокация.Контейнер) Тогда
			Если ЭтоТест Тогда
				//КонтейнерОбъект = Справочники.ТЕ.СоздатьЭлемент();
