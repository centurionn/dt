//Функция ДокументИзменен(КоносаментОбъект, ПроверятьТабличныеЧасти = Истина, ПроверятьСтандартные = Истина) //ДИТ Шевченко А.В. US 102524 TA 102526 13.02.2025
Функция ДокументИзменен(КоносаментОбъект, ПроверятьТабличныеЧасти = Истина, ПроверятьСтандартные = Истина, ИмяИзмененногоРеквизита = "") //Евросиб(ДИТ), Беляев СЮ, BUG 102524 / TA 103699, 25-02-2025, добавлен параметр ИмяИзмененногоРеквизита
	
	Объект = КоносаментОбъект;
	
	рез = Ложь;
    Ссылка = Объект.Ссылка;
    Метаданное = Ссылка.Метаданные();
    
    Для каждого Реквизит из Метаданное.Реквизиты Цикл
		Если Объект[Реквизит.Имя] <> Ссылка[Реквизит.Имя] Тогда
			Если Реквизит.Имя = "Изменено" Тогда
				Продолжить;
			КонецЕсли;	
			//Евросиб(ДИТ), Беляев СЮ, BUG 102524 / TA 103699, 25-02-2025, начало
			ИмяИзмененногоРеквизита = Реквизит.Имя;
			//Евросиб(ДИТ), Беляев СЮ, BUG 102524 / TA 103699, 25-02-2025, конец
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    
    Если ПроверятьСтандартные Тогда
    Для каждого Реквизит из Метаданное.СтандартныеРеквизиты Цикл
		Если Объект[Реквизит.Имя] <> Ссылка[Реквизит.Имя] Тогда
			//Евросиб(ДИТ), Беляев СЮ, BUG 102524 / TA 103699, 25-02-2025, начало
			ИмяИзмененногоРеквизита = Реквизит.Имя;
			//Евросиб(ДИТ), Беляев СЮ, BUG 102524 / TA 103699, 25-02-2025, конец
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    КонецЕсли;
    
    
    Если ПроверятьТабличныеЧасти Тогда
        Для каждого ТЧ из Метаданное.ТабличныеЧасти Цикл
            
			Если Объект[ТЧ.Имя].Количество() <> Ссылка[ТЧ.Имя].Количество() Тогда
				//Евросиб(ДИТ), Беляев СЮ, BUG 102524 / TA 103699, 25-02-2025, начало
				ИмяИзмененногоРеквизита = ТЧ.Имя;
				//Евросиб(ДИТ), Беляев СЮ, BUG 102524 / TA 103699, 25-02-2025, конец
                рез = истина;
            КонецЕсли;
            
            Для Индекс = 0 по Объект[ТЧ.Имя].Количество()-1 Цикл
                ОбъектСтрокаТЧ = Объект[ТЧ.Имя][Индекс];
                СсылкаСтрокаТЧ = Ссылка[ТЧ.Имя][Индекс];    
                
                Для каждого РеквизитТЧ из ТЧ.Реквизиты Цикл
					Если ОбъектСтрокаТЧ[РеквизитТЧ.Имя] <> СсылкаСтрокаТЧ[РеквизитТЧ.Имя] Тогда
						Если РеквизитТЧ.Имя = "ГУИДСтроки" Тогда
							Продолжить;
						КонецЕсли;
						Если РеквизитТЧ.Имя = "ГУИД" Тогда
							Продолжить;
						КонецЕсли;
						//Евросиб(ДИТ), Беляев СЮ, BUG 102524 / TA 103699, 25-02-2025, начало
						ИмяИзмененногоРеквизита = РеквизитТЧ.Имя;
						//Евросиб(ДИТ), Беляев СЮ, BUG 102524 / TA 103699, 25-02-2025, конец
                        рез =  Истина; 
                    КонецЕсли;
                КонецЦикла;
            КонецЦикла;
            
        КонецЦикла;        
    КонецЕсли;
    
    Возврат рез;
    
КонецФункции

