Процедура ПередатьПланыДДСВУПП(МассивСсылок) Экспорт

	Прокси = ВебСервисы_сервер.ПолучитьПрокси("ВебСервисПлановДДСУПП");

	СсылкиНаДокументы = Новый ТаблицаЗначений;
	СсылкиНаДокументы.Колонки.Добавить("ГУИД",Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(36)));
	СсылкиНаДокументы.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.ПланПоступленийСписаний"));
	
	Для каждого Ссылка Из МассивСсылок Цикл
		Строка = СсылкиНаДокументы.Добавить();
		Строка.ГУИД = Ссылка.УникальныйИдентификатор();
		Строка.Ссылка = Ссылка;
	КонецЦикла;
	
#Область Запрос
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СсылкиНаДокументы.ГУИД КАК ГУИД,
	|	СсылкиНаДокументы.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ СсылкиНаДокументы
	|ИЗ
	|	&СсылкиНаДокументы КАК СсылкиНаДокументы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПланПоступленийСписаний.Дата КАК Дата,
	|	СсылкиНаДокументы.ГУИД КАК ГУИД,
	|	ПланПоступленийСписаний.Комментарий КАК Комментарий,
	|	ПРЕДСТАВЛЕНИЕ(ПланПоступленийСписаний.Автор) КАК Автор,
	|	ПланПоступленийСписаний.Номер КАК Номер,
	|	ПланПоступленийСписаний.ВариантПланаПродаж.Наименование КАК ВариантПланаПродажНаименование,
	|	ПланПоступленийСписаний.ДатаНачала КАК ДатаНачала,
	|	ПланПоступленийСписаний.ДатаОкончания КАК ДатаОкончания,
	|	ПланПоступленийСписаний.ЦФО.Код КАК ЦФОКод
	|ИЗ
	|	СсылкиНаДокументы КАК СсылкиНаДокументы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПланПоступленийСписаний КАК ПланПоступленийСписаний
	|		ПО СсылкиНаДокументы.Ссылка = ПланПоступленийСписаний.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СсылкиНаДокументы.ГУИД КАК ГУИД,
	|	""Приход"" КАК ВидДвижения,
	|	ВЫРАЗИТЬ(ПланПоступленийСписанийПоступления.Сумма КАК ЧИСЛО(15, 2)) КАК Сумма,
	|	ПланПоступленийСписанийПоступления.ДатаДвижения КАК ДатаДвижения,
	|	ПланПоступленийСписанийПоступления.Валюта.Код КАК ВалютаКод,
	|	ПланПоступленийСписанийПоступления.СтатьяДвиженияДенежныхСредств.Код КАК СтатьяДвиженияДенежныхСредствКод,
	|	Контрагенты.УИДИсточника КАК УИДКонтрагента,
	|	ДоговорыКонтрагентов.УИДИсточника КАК УИДДоговораКонтрагента,
	|	ВЫРАЗИТЬ(ПланПоступленийСписанийПоступления.КлючСтроки КАК Строка(36)) КАК КлючСтроки
	|ИЗ
	|	СсылкиНаДокументы КАК СсылкиНаДокументы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПланПоступленийСписаний.Поступления КАК ПланПоступленийСписанийПоступления
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК Контрагенты
	|			ПО ПланПоступленийСписанийПоступления.Контрагент = Контрагенты.Объект
	|				И (Контрагенты.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
	|				И (Контрагенты.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.БитФинанс))
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ДоговорыКонтрагентов
	|			ПО ПланПоступленийСписанийПоступления.ДоговорКонтрагента = ДоговорыКонтрагентов.Объект
	|				И (ДоговорыКонтрагентов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
	|				И (ДоговорыКонтрагентов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.БитФинанс))
	|		ПО СсылкиНаДокументы.Ссылка = ПланПоступленийСписанийПоступления.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СсылкиНаДокументы.ГУИД,
	|	""Расход"",
	|	ВЫРАЗИТЬ(ПланПоступленийСписанийСписания.Сумма КАК ЧИСЛО(15, 2)),
	|	ПланПоступленийСписанийСписания.ДатаДвижения,
	|	ПланПоступленийСписанийСписания.Валюта.Код,
	|	ПланПоступленийСписанийСписания.СтатьяДвиженияДенежныхСредств.Код,
	|	Контрагенты.УИДИсточника,
	|	ДоговорыКонтрагентов.УИДИсточника,
	|	ВЫРАЗИТЬ(ПланПоступленийСписанийСписания.КлючСтроки КАК Строка(36))
	|ИЗ
	|	СсылкиНаДокументы КАК СсылкиНаДокументы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПланПоступленийСписаний.Списания КАК ПланПоступленийСписанийСписания
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК Контрагенты
	|			ПО (Контрагенты.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
	|				И (Контрагенты.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.БитФинанс))
	|				И ПланПоступленийСписанийСписания.Контрагент = Контрагенты.Объект
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ДоговорыКонтрагентов
	|			ПО ПланПоступленийСписанийСписания.ДоговорКонтрагента = ДоговорыКонтрагентов.Объект
	|				И (ДоговорыКонтрагентов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
	|				И (ДоговорыКонтрагентов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.БитФинанс))
	|		ПО СсылкиНаДокументы.Ссылка = ПланПоступленийСписанийСписания.Ссылка";
	
#КонецОбласти 	
	Запрос.УстановитьПараметр("СсылкиНаДокументы", СсылкиНаДокументы);
	
	Результаты = Запрос.ВыполнитьПакет();		
	Шапки = Результаты[1].Выгрузить(); 
	ТЧДвижений = Результаты[2].Выгрузить();
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Шапки", Шапки);
	СтруктураДанных.Вставить("ТЧДвижений", ТЧДвижений);	
	
	ПередаваемаяСтрокаXML = ОбщегоНазначения.ЗначениеВСтрокуXML(СтруктураДанных); 

	ОтветУПП = Прокси.CreateCashFlowPlanFromDC(ПередаваемаяСтрокаXML);
	ТаблицаОтвета = ОбщегоНазначения.ЗначениеИзСтрокиXML(ОтветУПП);
	Для каждого СтрокаОтвета Из ТаблицаОтвета Цикл
		Если ЗначениеЗаполнено(СтрокаОтвета.Комментарий) Тогда
			ОбщегоНазначения.СообщитьПользователю("Документ не выгружен. Ошибки: " + СтрокаОтвета.Комментарий);
		Иначе	
			СтруктураПоиска = Новый Структура("ДействиеПриОбмене, УзелОбмена, Объект", Перечисления.ДействияПриОбмене.ВыгрузкаДанных, Перечисления.УзлыОбмена.УПП,
											Документы.ПланПоступленийСписаний.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаОтвета.ГУИД)));
			СтруктураДанных = Новый Структура("УИДИсточника, Ответственный, НомерДатаВБУ", СтрокаОтвета.ГУИД,  Пользователи.АвторизованныйПользователь(), СтрокаОтвета.ПредставлениеПланаДДС);
			Сообщение = РегистрыСведений.ПротоколОбменов.ЗафиксироватьИнформациюОЗагрузке(СтруктураПоиска, СтруктураДанных, "Создан План ДДС: " + СтрокаОтвета.ПредставлениеПланаДДС);
			Сообщение.Сообщить();
		КонецЕсли; 
	КонецЦикла; 

КонецПроцедуры

Функция ПередатьДанныеПоПТУ(XMLParams) Экспорт

	ГУИДДокументов =  ОбщегоНазначения.ЗначениеИзСтрокиXML(XMLParams);
	СсылкиНаДокументы = Новый ТаблицаЗначений;
	СсылкиНаДокументы.Колонки.Добавить("ГУИД",Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(36)));
	СсылкиНаДокументы.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.ПоступлениеТоваровУслуг"));
	
	Для Каждого СтрокаГУИД Из ГУИДДокументов Цикл
		Строка = СсылкиНаДокументы.Добавить();
		Строка.ГУИД = СтрокаГУИД;
		Строка.Ссылка = Документы.ПоступлениеТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.ГУИД));
	КонецЦикла;
	
#Область Запрос
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СсылкиНаДокументы.ГУИД КАК ГУИД,
	|	СсылкиНаДокументы.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ СсылкиНаДокументы
	|ИЗ
	|	&СсылкиНаДокументы КАК СсылкиНаДокументы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СсылкиНаДокументы.ГУИД КАК ГУИД,
	|	ПоступлениеТоваровУслуг.ДатаВходящегоДокумента КАК Дата,
	//Евросиб Литвинов ( 30.12.21 #44592 Ticket#0254477 #44587 
	|	ПоступлениеТоваровУслуг.ДатаСФХЖ КАК ДатаСФХЖ,
