//Евросиб Каблов 30.01.2025 #100571
Функция ПолучитьТарифы(ИмяУзла, ДатаНачала, ДатаОкончания) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ИмяУзла) Тогда
		Возврат "<xml><error>Пустое значение параметра RequestingSystem!</error></xml>";
	КонецЕсли;  
	
	УзелОбмена = Неопределено;
	Для каждого ЗначПеречисления Из Метаданные.Перечисления.УзлыОбмена.ЗначенияПеречисления Цикл
		Если ЗначПеречисления.Имя = ИмяУзла Тогда
			УзелОбмена = Перечисления.УзлыОбмена[ЗначПеречисления.Имя];  
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	
	Если УзелОбмена = Неопределено Тогда
		Возврат "<xml><error>Не найден узел обмена по входному параметру RequestingSystem!</error></xml>";
	КонецЕсли;
	
	//Евросиб Каблов 20.05.2025 ( #110106 
	//Евросиб СубботинВ #131884 02.03.2026 Начало
	Если УзелОбмена = Перечисления.УзлыОбмена.BI ТОгда
		НастройкаОбмена = Справочники.НастройкиОбменов.ПолучитьНастройкуОбмена(УзелОбмена, "GetSupplierTariff");
		Если не ЗначениеЗаполнено(ДатаНачала) Тогда
			ДатаНачала = Дата("19000101");
		КонецЕсли;
	Иначе 
	//Евросиб СубботинВ #131884 02.03.2026 Конец
		НастройкаОбмена = Справочники.НастройкиОбменов.ПолучитьНастройкуОбмена(УзелОбмена, "GetTariff");
	//Евросиб СубботинВ #131884 02.03.2026 Начало
	КонецЕсли;
	//Евросиб СубботинВ #131884 02.03.2026 Конец

	КоличествоЗаписейВПорцииДанных = НастройкаОбмена.КоличествоЗаписейВПорцииДанных;
	Если ЗначениеЗаполнено(КоличествоЗаписейВПорцииДанных) Тогда
		КоличествоЗаписейВПорцииДанныхПлюсОдин = КоличествоЗаписейВПорцииДанных + 1;
		ТекстОграниченияПорции = СтрШаблон("ПЕРВЫЕ %1", Формат(КоличествоЗаписейВПорцииДанныхПлюсОдин, "ЧГ=0"));
	Иначе
		ТекстОграниченияПорции = "";
	КонецЕсли;
	//Евросиб Каблов 20.05.2025 )
	
	ТипСправочникСсылкаМультилокации = Тип("СправочникСсылка.Мультилокации");
	ЛокацияПустаяСсылка = Справочники.Локации.ПустаяСсылка();
	ТипЛокацииГород = Справочники.ТипыЛокаций.НаселенныйПункт;
	ТипЛокацииСтрана = Справочники.ТипыЛокаций.Страна;	
	ТипИерархииГород = Перечисления.ТипыИерархииЛокации.НаселенныйПункт;
	ТипИерархииСтрана = Перечисления.ТипыИерархииЛокации.Страна;
	СтатусСогласоваанПоПСЦ = Перечисления.СтатусыТарифовПоставщиков.СогласованПоПСЦ;
	//Евросиб Шевченко А.В. US 100317 TA 121250 24.10.2025
	СтатусПроведенПоПСЦ    = Перечисления.СтатусыТарифовПоставщиков.ПроведенПоПСЦ;
	НоменклатураКатегорииРасходов = Новый Массив;
	НоменклатураКатегорииРасходов.Добавить(Справочники.Номенклатура.РелокацияКонтейнерПорожний);
	НоменклатураКатегорииРасходов.Добавить(Справочники.Номенклатура.ПредоставлениеКТК);
	НоменклатураКатегорииРасходов.Добавить(Справочники.Номенклатура.ПредоставлениеПлатформ);
	//Евросиб Шевченко А.В. US 100317 TA 121250 24.10.2025
	КлючСтрокиПротоколаПустаяСсылка = Справочники.КлючиАналитикиСтрокПротокола.ПустаяСсылка();
	ВремяВыгрузки = ТекущаяДата();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЛокацияПустаяСсылка", ЛокацияПустаяСсылка);
	Запрос.УстановитьПараметр("ТипИерархииГород", ТипИерархииГород);
	Запрос.УстановитьПараметр("ТипИерархииСтрана", ТипИерархииСтрана);
	Запрос.УстановитьПараметр("ТипЛокацииГород", ТипЛокацииГород);
	Запрос.УстановитьПараметр("ТипЛокацииСтрана", ТипЛокацииСтрана);
	Запрос.УстановитьПараметр("СтатусСогласоваанПоПСЦ", СтатусСогласоваанПоПСЦ);
	Запрос.УстановитьПараметр("КлючСтрокиПротоколаПустаяСсылка", КлючСтрокиПротоколаПустаяСсылка);
	//Евросиб Шевченко А.В. US 100317 TA 121250 24.10.2025
	Запрос.УстановитьПараметр("НоменклатураКатегорииРасходов", НоменклатураКатегорииРасходов);
	Запрос.УстановитьПараметр("СтатусПроведенПоПСЦ", СтатусПроведенПоПСЦ);
	//Евросиб Шевченко А.В. US 100317 TA 121250 24.10.2025 
	
	//Евросиб СубботинВ #131884 02.03.2026 Начало
	Запрос.УстановитьПараметр("ОбменBi", УзелОбмена = Перечисления.УзлыОбмена.BI);
//	Если УзелОбмена = Перечисления.УзлыОбмена.BI Тогда
		ВидыУслугПоставщиков = Новый Массив;
		ВидыУслугПоставщиков.Добавить(Справочники.ВидыУслугПоставщиков.Автоперевозки);
		ВидыУслугПоставщиков.Добавить(Справочники.ВидыУслугПоставщиков.Контейнеры);
		ВидыУслугПоставщиков.Добавить(Справочники.ВидыУслугПоставщиков.Вагоны);
		Запрос.УстановитьПараметр("ВидыУслугПоставщиков", ВидыУслугПоставщиков);
		Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	//КонецЕсли; 
		//Евросиб СубботинВ #131884 02.03.2026 Конец
		
	
	Если ЗначениеЗаполнено(ДатаНачала) и ЗначениеЗаполнено(ДатаОкончания) Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 11
		|	ТарифыПоставщиков.Период КАК Период,
		|	ТарифыПоставщиков.Регистратор КАК Регистратор,
		|	ПРЕДСТАВЛЕНИЕ(ТарифыПоставщиков.Регистратор) КАК РегистраторПредставление,
		|	ТарифыПоставщиков.Критерий КАК Критерий,
		|	ТарифыПоставщиков.СтоимостьСНДС КАК СтоимостьСНДС,
		|	ТарифыПоставщиков.СтоимостьБезНДС КАК СтоимостьБезНДС,
		|	ТарифыПоставщиков.ОкончаниеДействия КАК ОкончаниеДействия,
		|	ТарифыПоставщиков.Статус КАК Статус,
		|	ТарифыПоставщиков.Регистратор.Автор КАК РегистраторАвтор,
		|	ТарифыПоставщиков.КлючАналитикиСтрокиПротокола КАК КлючАналитикиСтрокиПротокола
		|ПОМЕСТИТЬ Тарифы
		|ИЗ
		|	РегистрСведений.ТарифыПоставщиков КАК ТарифыПоставщиков
		|ГДЕ
		//Евросиб Шевченко А.В. US 100317 TA 121250 24.10.2025
		|	ВЫБОР
		|			КОГДА ТарифыПоставщиков.Критерий.Номенклатура В (&НоменклатураКатегорииРасходов)
		//Евросиб Шевченко А.В. US 132191 TA 132193 27.02.2026
		//|				ТОГДА ТарифыПоставщиков.Статус = &СтатусПроведенПоПСЦ
		|				ТОГДА ТарифыПоставщиков.Статус = &СтатусПроведенПоПСЦ ИЛИ ТарифыПоставщиков.Статус = &СтатусСогласоваанПоПСЦ
		//Евросиб Шевченко А.В. US 132191 TA 132193 27.02.2026
		|			ИНАЧЕ ТарифыПоставщиков.Статус = &СтатусСогласоваанПоПСЦ
		|		КОНЕЦ
		//|	ТарифыПоставщиков.Статус = &СтатусСогласоваанПоПСЦ
		//Евросиб Шевченко А.В. US 100317 TA 121250 24.10.2025
		|	И ТарифыПоставщиков.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ТарифыПоставщиков.КлючАналитикиСтрокиПротокола <> &КлючСтрокиПротоколаПустаяСсылка";
		
		Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
		
	Иначе
		
		УзлыПланаОбмена = ПланыОбмена.ВыгрузкаДанных.ПолучитьУзелОбмена(УзелОбмена);
		Если Не ЗначениеЗаполнено(УзлыПланаОбмена) Тогда
			Возврат "<xml><error>Не настроен узел плана обмена по входному параметру RequestingSystem!</error></xml>";
		КонецЕсли;
		
		УзелПланаОбмена = УзлыПланаОбмена[0];
				
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 11
		|	ТарифыПоставщиков.Период КАК Период,
		|	ТарифыПоставщиков.Регистратор КАК Регистратор,
		|	ПРЕДСТАВЛЕНИЕ(ТарифыПоставщиков.Регистратор) КАК РегистраторПредставление,
		|	ТарифыПоставщиков.Критерий КАК Критерий,
		|	ТарифыПоставщиков.СтоимостьСНДС КАК СтоимостьСНДС,
		|	ТарифыПоставщиков.СтоимостьБезНДС КАК СтоимостьБезНДС,
		|	ТарифыПоставщиков.ОкончаниеДействия КАК ОкончаниеДействия,
		|	ТарифыПоставщиков.Статус КАК Статус,
		|	ТарифыПоставщиков.Регистратор.Автор КАК РегистраторАвтор,
		|	КлючиАналитикиСтрокПротоколаИзменения.Ссылка КАК КлючАналитикиСтрокиПротокола
		|ПОМЕСТИТЬ Тарифы
		|ИЗ
		|	Справочник.КлючиАналитикиСтрокПротокола.Изменения КАК КлючиАналитикиСтрокПротоколаИзменения
