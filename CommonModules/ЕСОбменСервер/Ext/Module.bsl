			Запись.Период = ДатаЗаписей;
			Запись.НаСлежении = Ложь;
			Запись.Записать();
			
		Иначе
		
			Контейнер = Выборка.Ссылка;
			Если Не ЗначениеЗаполнено(Контейнер) Тогда
				//КонтейнерОбъект = Справочники.ТЕ.СоздатьЭлемент();
				//КонтейнерОбъект.Наименование = Выборка.Префикс + Выборка.Номер + Строка(Выборка.КонтрольноеЧисло);
				//КонтейнерОбъект.Номер = Выборка.Номер;
				//КонтейнерОбъект.Префикс = Выборка.Префикс;
				//КонтейнерОбъект.КонтрольноеЧисло = Выборка.КонтрольноеЧисло;
				//КонтейнерОбъект.ТипТЕ = Выборка.ТипТЕ;
				//КонтейнерОбъект.Записать();
				НомерКТК = Выборка.Префикс + Выборка.Номер + Строка(Выборка.КонтрольноеЧисло);
				ТипТЕ = Выборка.ТипТЕ;
				Контейнер = РаботаСКонтейнерамиСервер.СоздатьКТК(НомерКТК, ТипТЕ);
