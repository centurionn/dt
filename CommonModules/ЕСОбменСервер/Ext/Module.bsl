Функция ПолучитьОстаточноеРасстояниеМеждуСтанциями(СтанцияОтправления, СтанцияНазначения) Экспорт
	
	Результат = РегистрыСведений.РасстоянияМеждуЛокациями.ПолучитьРасстояние(СтанцияОтправления, СтанцияНазначения);
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Если НЕ ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьЗначениеКонстанты("СохранятьРасстояниеМеждуСтанциямиПриПолученииДислокации") = Истина Тогда
			Возврат 0;	
		КонецЕсли; 
		РЕЗ_РТ = РейлТариф_сервер.ПолучитьРасстояние(СтанцияОтправления.КодЖДСтанции, СтанцияНазначения.КодЖДСтанции);
		Если РЕЗ_РТ > 0 Тогда
			Результат = РЕЗ_РТ;
			РейлТариф_сервер.СохранитьРасстояниеМеждуЛокациями(СтанцияОтправления.КодЖДСтанции, СтанцияНазначения.КодЖДСтанции, РЕЗ_РТ);
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

