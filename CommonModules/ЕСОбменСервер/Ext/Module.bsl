Функция ПоискЗаявкиПоВнешнемуНомеру(Номер)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Заявка.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.Заявка КАК Заявка
	               |ГДЕ
	               |	НЕ Заявка.ПометкаУдаления
	               |	И Заявка.ВнешнийНомер = &ВнешнийНомер"; 
	Запрос.УстановитьПараметр("ВнешнийНомер", Номер);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции

Функция НайтиЛокацию(Наименование, Получатель)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Локации.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Локации КАК Локации
	               |ГДЕ
	               |	Локации.Наименование ПОДОБНО &Наименование
	               |	И НЕ Локации.ПометкаУдаления";  
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Выборка = Запрос.Выполнить().Выбрать();   
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;      
	//отправляем сообщение, что нет такой локации   
	УчетнаяЗаписьПоУмолчанию = РаботаСПочтовымиСообщениями.ПроверитьСистемнаяУчетнаяЗаписьДоступна();
	Если УчетнаяЗаписьПоУмолчанию Тогда 
		СистемнаяУчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
		МассивПисем = новый Массив;
		ТекстПисьма = "Не найдена локация - " + Наименование;
		ПолучателиПисьма = Новый Массив;
		ПолучателиПисьма.Добавить(Новый Структура("Представление, Адрес", "Адрес отслеживания", Пользователи_sd_сервер.ПолучитьEMAILПользователя(Получатель)));
		ПараметрыОтправкиПисьма = новый Структура;
		ПараметрыОтправкиПисьма.Вставить("Тема", "Озон. Не найдена локация");
		ПараметрыОтправкиПисьма.Вставить("Тело", ТекстПисьма);
		ПараметрыОтправкиПисьма.Вставить("ТипТекста", "HTML");
		ПараметрыОтправкиПисьма.Вставить("Кому", ПолучателиПисьма);
		МассивПисем.Добавить(ПараметрыОтправкиПисьма);
		РЕЗУЛЬТАТ = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(СистемнаяУчетнаяЗапись, ПараметрыОтправкиПисьма);
	КонецЕсли;
	ЗаписьЖурналаРегистрации("Озон.НеНайденаЛокация", УровеньЖурналаРегистрации.Предупреждение,,,Наименование);
	Возврат Неопределено;
		
КонецФункции

Процедура СохранитьФайлВЗаявке(Заявка, ДанныеПФ, Наименование) 
	
	ДвоичныеДанные = Base64Значение(ДанныеПФ);
	АдресХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанные);     
	
	ПараметрыФайла = Новый Структура;
	ПараметрыФайла.Вставить("Автор", ПользователиКлиентСервер.ТекущийПользователь());
	ПараметрыФайла.Вставить("ВладелецФайлов", Заявка);
	ПараметрыФайла.Вставить("ИмяБезРасширения", Наименование);
	ПараметрыФайла.Вставить("РасширениеБезТочки", "pdf");
	ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное", Неопределено); 
	ПараметрыФайла.Вставить("ХранитьВерсии", Истина);
	Файл = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресХранилища);
	
	УдалитьИзВременногоХранилища(АдресХранилища);
	
КонецПроцедуры  

Функция ОтправитьДатуПрибытияОзон(ВнешнийНомер, ПлановаяДатаПрибытия) Экспорт
	
	ДанныеПодключения = ?(ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована, 
							Справочники.НастройкиПрограммы.Озон_тестовый, Справочники.НастройкиПрограммы.Озон); 
	АдресСервиса = ДанныеПодключения.АдресСервиса;
	userName = ДанныеПодключения.userName;
	password = ДанныеПодключения.password;
	contractId = ДанныеПодключения.contractId;
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("userName", userName);
	СтруктураДанных.Вставить("password", password);
	
	РезультатData = ПолучитьОтвет(АдресСервиса, Заголовки, "/v1/token", СтруктураДанных, "Озон.ПолучениеТокена");
	
	Если РезультатData <> Неопределено Тогда
		Токен = РезультатData.access_token;     
	Иначе
		Возврат "Не удалось выполнить передачу данных. Подробности в журнале регистрации.";
	КонецЕсли;    
	
	Попытка
		Номер = Число(ВнешнийНомер);
	Исключение
		Возврат "Внешний номер не корректен";
	КонецПопытки;
	
	//Установка даты поставки на все отправления из перевозки 
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("contractId", contractId);
	СтруктураДанных.Вставить("carriageId", Номер);   
	moment = Формат(ПлановаяДатаПрибытия, "ДФ=yyyy-MM-ddTHH:mm:ssZ"); 
	СтруктураДанных.Вставить("moment", moment); 
	РезультатData = ПолучитьОтвет(АдресСервиса, Заголовки, "/v1/carriage/carriage-content-transfer-date-set", СтруктураДанных, "Озон.УстановкаДатыПоставки");
	
	Если РезультатData <> Неопределено Тогда
		Если РезультатData.resultCode <> 0 Тогда
			Возврат "Не удалось выполнить передачу данных. " + РезультатData.resultMessage; 
		Иначе
			Возврат "Данные переданы";
		КонецЕсли;
	Иначе   
		Возврат "Не удалось выполнить передачу данных. Подробности в журнале регистрации.";
	КонецЕсли;   
	
КонецФункции
