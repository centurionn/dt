//Евросиб(ДИТ) Антонова А.С. US 90779 19.05.2025   
Функция ПередатьДанныеПоРеестрамНДС(xmlParams) Экспорт   
	
	Параметры = ОбщегоНазначения.ЗначениеИзСтрокиXML(XMLParams); 
	
	//ТипПеревозки = 1 - Реестр НДС Приложение 7  (КНД 1155112) - Экспорт/Импорт
	Если Параметры.ТипПеревозки = 1 Тогда
		ФормаРеестра = "ЭкспортИмпорт";
		СтрокаВыводимыхПолей = "Номер,НомерГТД,КодСтанцииОтправления,СтранаОтправления,НаименованиеСудна,ДатаПогрузкиРазрешена,ПортРазгрузки,"
		+ "Примечание,Ссылка,НалоговаяБаза,ВходнаяСтанция,КодВходнойСтанции,КодСтанцииНазначения,СтранаНазначения,Вид,НомерДокумента,ДатаДокумента,"
		+ "РегНомерТранзитнойДекларации,КодСтраны";
		
	//ТипПеревозки = 2 - Реестр НДС Приложение 11 (КНД 1155122) - Транзит
	ИначеЕсли Параметры.ТипПеревозки = 2 Тогда
		ФормаРеестра = "Транзит";  
		СтрокаВыводимыхПолей = "Номер,СтанцияОтправления,КодСтанцииОтправления,СтранаСтанцииОтправления,ВходнаяСтанция,КодВходнойСтанции,"
		+ "НалоговаяБаза,Примечание,СтанцияНазначения,КодСтанцииНазначения,СтранаСтанцииНазначения,НомерГТД,ВыходнаяСтанция,КодВыходнойСтанции";
		
	//ТипПеревозки = 3 - Реестр НДС Приложение 10 (КНД 1155115) - Фрахт
	ИначеЕсли Параметры.ТипПеревозки = 3 Тогда
		ФормаРеестра = "Фрахт"; 
		СтрокаВыводимыхПолей = "НалоговаяБаза,Примечание,Вид,Номер,Дата,НаименованиеСудна,КодСтраныСудна,КодСтраныПортаРазгрузки,"
		+ "НаименованиеПортаРазгрузки,ДатаПогрузкаРазрешена,ДатаВыгрузкаРазрешена,НомерГТД,КодСтраныПортаПогрузки,НаименованиеПортаПогрузки,Ссылка";
		
	//ТипПеревозки = 4 - Реестр НДС Приложение 8  (КНД 1155113) - Авто
	ИначеЕсли Параметры.ТипПеревозки = 4 Тогда
	    ФормаРеестра = "Авто";   
		СтрокаВыводимыхПолей = "НомерДокумента,ДатаДокумента,Код,НомерТаможеннойНакладной,НомерГТД,Отправитель_ИНН,Отправитель_Наименование,"
		+ "Отправитель_Адрес,Получатель_ИНН,Получатель_Наименование,Получатель_Адрес,Перевозчик_ИНН,Перевозчик_Наименование,Перевозчик_Адрес,"
		+ "РегНомерАвто,РегНомерПрицепа,СтранаРазгрузки,СтранаПогрузки,НалоговаяБаза,Примечание,Ссылка";
		
	КонецЕсли;  
	
	ВыводимыеПоля = СтрРазделить(СтрокаВыводимыхПолей, ",", Ложь);
	
	Параметры.Вставить("ФормаРеестра", ФормаРеестра);
	
	Период = Новый СтандартныйПериод(Параметры.НачалоПериода, Параметры.КонецПериода); 
	Параметры.Вставить("Период", Период);
	
	Данные = ПолучитьДанныеЧерезМакетСКД("ДанныеРеестровНДСдляУПП", Параметры,,Истина,ВыводимыеПоля);  
	
	Возврат ОбщегоНазначения.ЗначениеВСтрокуXML(Данные);

КонецФункции 

