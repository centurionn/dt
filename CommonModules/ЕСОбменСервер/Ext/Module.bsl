	СтруктураПоискаВПротоколах.ЗагрузкаДанных, Перечисления.УзлыОбмена.БитФинанс, ТипСправочника);
	
	КоносаментОбъект.ФрахтНадбавки		= ДанныеКоносамента.Фрахт;
	КоносаментОбъект.МорскаяЛиния 		= ПолучитьМорскуюЛинию(ДанныеКоносамента.МорскаяЛинияID, ДанныеКоносамента.МорскаяЛиния, СтруктураПоискаВПротоколах); 
	КоносаментОбъект.СтанцияОтправления	= ПолучитьПорт(ДанныеКоносамента.ПортПогрузкиКод);
	КоносаментОбъект.СтанцияНазначения 	= ПолучитьПорт(ДанныеКоносамента.ПортНазначенияКод); 
	
	СпособВыпускаДокумента = ДанныеКоносамента.СпособВыпускаКоносамента ;
	СпособВыпускаДок = Перечисления.СпособыВыпускаДокумента;
	Если СпособВыпускаДокумента = Строка(СпособВыпускаДок.Original)   Тогда
		КоносаментОбъект.СпособВыпускаДокумента = СпособВыпускаДок.Original;
	ИначеЕсли СпособВыпускаДокумента = Строка(СпособВыпускаДок.SWB)  Тогда
		КоносаментОбъект.СпособВыпускаДокумента = СпособВыпускаДок.SWB; 
	ИначеЕсли СпособВыпускаДокумента = Строка(СпособВыпускаДок.Telex)  Тогда
		КоносаментОбъект.СпособВыпускаДокумента = СпособВыпускаДок.Telex;
	КонецЕсли;
	
	//данные по судну++
	СтруктураДанныеПоСудну = Новый Структура("Судно,СудноГодПостройки,СудноКодIMO,СудноНоминальнаяКонтейнеровместимость,СудноСтранаКод");
	СтруктураДанныеПоСудну.Вставить("Судно",ДанныеКоносамента.Судно);
	СтруктураДанныеПоСудну.Вставить("СудноГодПостройки", ДанныеКоносамента.СудноГодПостройки);
	СтруктураДанныеПоСудну.Вставить("СудноКодIMO", ДанныеКоносамента.СудноКодIMO);
	СтруктураДанныеПоСудну.Вставить("СудноНоминальнаяКонтейнеровместимость", ДанныеКоносамента.СудноНоминальнаяКонтейнеровместимость);
	СтруктураДанныеПоСудну.Вставить("СудноСтранаКод", ДанныеКоносамента.СудноСтранаКод ); 
	СтруктураДанныеПоСудну.Вставить("ID_DX", ДанныеКоносамента.СудноID); 
	КоносаментОбъект.Судно = ПолучитьСудно(СтруктураДанныеПоСудну, СтруктураПоискаВПротоколах); 
	//данные по судну --
	
	КоносаментОбъект.МорскойРейс = ПолучитьМорскойРейс(ДанныеКоносамента.НомерРейса, ДанныеКоносамента.ГУИДРейса, СтруктураПоискаВПротоколах);
	
	// Евросиб(ДИТ) BUG 95403 ТА 95433 Сержантова А.С. Начало: 14.11.2024
	//Стало:
	Если ЗначениеЗаполнено(КоносаментОбъект.МорскойРейс) Тогда
		СтрокаРеквизитов = "ПунктОтправления, ПунктНазначения, МестоПогрузки, МестоРазгрузки, ДатаОтправления, ДатаПрибытия";
		РеквизитыМорскогоРейса = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КоносаментОбъект.МорскойРейс, СтрокаРеквизитов);						 
		КоносаментОбъект.СтанцияОтправления	= РеквизитыМорскогоРейса.ПунктОтправления; 
