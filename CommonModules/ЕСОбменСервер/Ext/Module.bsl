				СтруктураДанных.Вставить("ЗагрузкаПодтверждена", Ложь);
				Сообщение = РегистрыСведений.ПротоколОбменов.ЗафиксироватьИнформациюОЗагрузке(СтруктураПоиска, СтруктураДанных, "");
				
				//Евросиб Каблов 18.08.2025 ( #112391
				РегистрыСведений.ИсторияОбменов.ЗафиксироватьИнформациюОбИсторииОбмена(ДокументПСЦ, Перечисления.УзлыОбмена.ДО, Истина, ТекстОшибки);
