&НаСервере
Процедура ЗагрузитьАктуальныеКодыТНВЭДНаСервере() Экспорт 
	
	Попытка
		ADOConnection    				= Новый COMОбъект("ADODB.Connection");
		ADOConnection.provider			= "SQLOLEDB";		
		ДанныеПодключенияДляЗагрузкиТНВЭД = Константы.ДанныеПодключенияСервер.Получить();
		Если НЕ ЗначениеЗаполнено(ДанныеПодключенияДляЗагрузкиТНВЭД) Тогда
			ОбщегоНазначения.СообщитьПользователю("Не заполнены данные подключения для Загруки ТНВЭД");
			Возврат;
		КонецЕсли; 			
		ADOConnection.ConnectionString	= ДанныеПодключенияДляЗагрузкиТНВЭД; 
		ADOConnection.open();
		ADOCommand						= Новый COMObject("ADODB.Command");
		ADOCommand.ActiveConnection 	= ADOConnection;
	Исключение
		ОбщегоНазначения.СообщитьПользователю("Не удалось установить соединение с сервером:"+ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	АдресSQLТаблицыДляЗагрузкиТНВЭД = Константы.АдресSQLТаблицыДляЗагрузкиТНВЭД.Получить();
	Если не ЗначениеЗаполнено(АдресSQLТаблицыДляЗагрузкиТНВЭД) Тогда
			ОбщегоНазначения.СообщитьПользователю("Не заполнены данные Таблицы для Загруки ТНВЭД");
		Возврат;
	КонецЕсли; 			

	SQLQuery = " SELECT * FROM "+ АдресSQLТаблицыДляЗагрузкиТНВЭД +" where version = 2";			
			
	ADOCommand.CommandText = SQLQuery;
	ADORecordSet = ADOCommand.Execute();
	КоличествоПолей = ADORecordSet.Fields().Count-1;
	ТЗ = Новый ТаблицаЗначений;
	//Евросиб Шевченко А.В. US 124456 TA 125854 10.12.2025
	ТЗ.Колонки.Добавить("parentid",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(15)));
	ТЗ.Колонки.Добавить("id",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(15)));
	ТЗ.Колонки.Добавить("level",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(3,0)));
	ТЗ.Колонки.Добавить("code",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(20)));
	ТЗ.Колонки.Добавить("version",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10)));
	ТЗ.Колонки.Добавить("value",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(150)));
	//Евросиб Шевченко А.В. US 124456 TA 125854 10.12.2025
	Пока НЕ ADORecordSet.EOF Цикл
		НоваяСтрока = ТЗ.Добавить();
		Для Инд = 0 По КоличествоПолей Цикл
			ИмяПоля = СтрЗаменить(ADORecordSet.Fields(Инд).Name," ","");
			НоваяСтрока[ИмяПоля] = ADORecordSet.Fields(Инд).Value;
		КонецЦикла;
		ADORECORDSET.MoveNext();
	КонецЦикла;
	
	ADOConnection.Close();
	ADOConnection 	= Неопределено;
	ADOCommand		= Неопределено;
	
	//Евросиб Шевченко А.В. US 124456 TA 125854 10.12.2025	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(СТРЗАМЕНИТЬ(ТЗ.parentid, &НПП, """") КАК СТРОКА(20)) КАК parentid,
		|	ВЫРАЗИТЬ(СТРЗАМЕНИТЬ(ТЗ.id, &НПП, """") КАК СТРОКА(20)) КАК id,
		|	ТЗ.level КАК level,
		|	ТЗ.code КАК code,
		|	ТЗ.version КАК version,
		|	ТЗ.value КАК value
		|ПОМЕСТИТЬ Вт_Выгрузка
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Вт_Выгрузка.parentid КАК parentid,
		|	Вт_Выгрузка.id КАК id,
		|	Вт_Выгрузка.level КАК level,
		|	Вт_Выгрузка.code КАК code,
		|	Вт_Выгрузка.version КАК version,
		|	Вт_Выгрузка.value КАК value,
		|	ЕСТЬNULL(ПротоколОбменов.Объект, НЕОПРЕДЕЛЕНО) КАК ОбъектСсылка,
		|	ЕСТЬNULL(ПротоколОбменовРодитель.Объект, НЕОПРЕДЕЛЕНО) КАК Родитель
		|ИЗ
		|	Вт_Выгрузка КАК Вт_Выгрузка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
		|		ПО Вт_Выгрузка.id = ПротоколОбменов.УИДИсточника
		|			И (ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.NSI))
		|			И (ПротоколОбменов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменовРодитель
		|		ПО Вт_Выгрузка.parentid = ПротоколОбменовРодитель.УИДИсточника
		|			И (ПротоколОбменовРодитель.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.NSI))
		|			И (ПротоколОбменовРодитель.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))";
	Запрос.УстановитьПараметр("ТЗ",ТЗ);
	Запрос.УстановитьПараметр("НПП",Символы.НПП);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТЗ Из РезультатЗапроса цикл
		
		СпрСсылка = Справочники.ГрузыПоТНВЭД.СоздатьАктуализироватьКарточкуТНВЭД(СтрокаТЗ);
		
		Если НЕ ЗначениеЗаполнено(СтрокаТЗ.ОбъектСсылка) Тогда	
			СтруктураПоиска = Новый Структура("ДействиеПриОбмене, УзелОбмена, Объект", Перечисления.ДействияПриОбмене.ЗагрузкаДанных, Перечисления.УзлыОбмена.NSI, СпрСсылка);
			СтруктураДанных = Новый Структура("УИДИсточника, ЗагрузкаПодтверждена, ДатаОбмена", СтрокаТЗ.id, Ложь, ТекущаяДата());
			РегистрыСведений.ПротоколОбменов.ЗафиксироватьИнформациюОЗагрузке(СтруктураПоиска, СтруктураДанных);			
		КонецЕсли;	
		
	КонецЦикла;
