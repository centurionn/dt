	|						КОГДА КорректировкаПоступленияСвязьУслугИСчетов.СчетПоставщика ССЫЛКА Документ.КорректировкаПоступления
	|							ТОГДА КорректировкаПоступленияСвязьУслугИСчетов.Ссылка = Счета.Объект
	|									И Счета.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УПП)
	|						ИНАЧЕ КорректировкаПоступленияСвязьУслугИСчетов.СчетПоставщика = Счета.Объект
	|								И Счета.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УППЗаказ)
	|					КОНЕЦ)
	|			ПО КорректировкаПоступленияУслуги.Ссылка = КорректировкаПоступленияСвязьУслугИСчетов.Ссылка
	|				И КорректировкаПоступленияУслуги.ГУИДПТУ = КорректировкаПоступленияСвязьУслугИСчетов.ГУИДПТУ
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.СвязьУслугИСчетов КАК ПоступлениеТоваровУслугСвязьУслугИСчетов
	|			ПО (КорректировкаПоступленияСвязьУслугИСчетов.Ссылка.ДокументПоступления = ПоступлениеТоваровУслугСвязьУслугИСчетов.Ссылка)
	|				И (КорректировкаПоступленияСвязьУслугИСчетов.ГУИДПТУ = ПоступлениеТоваровУслугСвязьУслугИСчетов.ГУИДПТУ)
	|				И (КорректировкаПоступленияСвязьУслугИСчетов.СчетПоставщика = ПоступлениеТоваровУслугСвязьУслугИСчетов.СчетПоставщика)
	|		ПО СсылкиНаДокументы.Ссылка = КорректировкаПоступленияУслуги.Ссылка
	|   
	|УПОРЯДОЧИТЬ ПО
	|	ЕСТЬNULL(ПоступлениеТоваровУслугСвязьУслугИСчетов.НомерСтроки, 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СсылкиНаДокументы.ГУИД КАК ГУИД,
	|	ЕСТЬNULL(ПротоколОбменов.УИДИсточника, ЕСТЬNULL(ПротоколОбменовСФ.УИДИсточника, """")) КАК ГУИДЗаказа,
	|	КорректировкаПоступленияСвязанныеСчетаПоставщиков.СуммаНаПТУ КАК СуммаНаПТУ,
	|	ВЫБОР
	|		КОГДА КорректировкаПоступленияСвязанныеСчетаПоставщиков.СчетПоставщика ССЫЛКА Документ.ПоступлениеТоваровУслуг
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЭтоСчетНаоплатуПоставщика,
	|	ВЫБОР
	|		КОГДА КорректировкаПоступленияСвязанныеСчетаПоставщиков.СчетПоставщика ССЫЛКА Документ.ПоступлениеТоваровУслуг
	|			ТОГДА ЕСТЬNULL(СчетФактураПолученный.Номер, КорректировкаПоступленияСвязанныеСчетаПоставщиков.СчетПоставщика.Номер)
	|		ИНАЧЕ КорректировкаПоступленияСвязанныеСчетаПоставщиков.СчетПоставщика.Номер
	|	КОНЕЦ КАК СчетПоставщикаНомер,
	|	ВЫБОР
	|		КОГДА КорректировкаПоступленияСвязанныеСчетаПоставщиков.СчетПоставщика ССЫЛКА Документ.ПоступлениеТоваровУслуг
	|			ТОГДА ЕСТЬNULL(СчетФактураПолученный.Дата, КорректировкаПоступленияСвязанныеСчетаПоставщиков.СчетПоставщика.Дата)
	|		ИНАЧЕ КорректировкаПоступленияСвязанныеСчетаПоставщиков.СчетПоставщика.Дата
	|	КОНЕЦ КАК СчетПоставщикаДата,
	|	ПротоколОбменовДоговоры.УИДИсточника КАК ГУИДДоговора
	|ИЗ
	|	СсылкиНаДокументы КАК СсылкиНаДокументы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаПоступления.СвязанныеСчетаПоставщиков КАК КорректировкаПоступленияСвязанныеСчетаПоставщиков
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	|			ПО КорректировкаПоступленияСвязанныеСчетаПоставщиков.СчетПоставщика = ПротоколОбменов.Объект
	|				И (ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УППЗаказ))
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменовДоговоры
	|			ПО КорректировкаПоступленияСвязанныеСчетаПоставщиков.Ссылка.ДоговорКонтрагента = ПротоколОбменовДоговоры.Объект
	|				И (ПротоколОбменовДоговоры.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
	|				И (ПротоколОбменовДоговоры.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.БитФинанс))
	|		ПО СсылкиНаДокументы.Ссылка = КорректировкаПоступленияСвязанныеСчетаПоставщиков.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураПолученный КАК СчетФактураПолученный
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменовСФ
	|			ПО СчетФактураПолученный.Ссылка = ПротоколОбменовСФ.Объект
	|				И (ПротоколОбменовСФ.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УППЗаказ))
	|		ПО СсылкиНаДокументы.Ссылка = СчетФактураПолученный.ДокументОснование";
#КонецОбласти 	
	Запрос.УстановитьПараметр("СсылкиНаДокументы", СсылкиНаДокументы);
	
	Результаты = Запрос.ВыполнитьПакет();		
	Шапки 		= Результаты[1].Выгрузить(); 
	ТЧУслуги 	= Результаты[2].Выгрузить();
	ТЧЗаказы 	= Результаты[3].Выгрузить(); 
	
	СтруктураШапкиИТЧУслуги = Новый Структура;
	СтруктураШапкиИТЧУслуги.Вставить("Шапки", Шапки);
	СтруктураШапкиИТЧУслуги.Вставить("ТЧУслуги", ТЧУслуги);	
	СтруктураШапкиИТЧУслуги.Вставить("ТЧЗаказы", ТЧЗаказы);	
	
	ПередаваемаяСтрокаXML = ОбщегоНазначения.ЗначениеВСтрокуXML(СтруктураШапкиИТЧУслуги); 
	
	Возврат ПередаваемаяСтрокаXML;		

КонецФункции // ПолучитьДанныеПоПТУ(XMLParams)

Функция ПередатьДанныеПоВСФ(XMLParams) Экспорт

	ГУИДДокументов =  ОбщегоНазначения.ЗначениеИзСтрокиXML(XMLParams);
	СсылкиНаДокументы = Новый ТаблицаЗначений;
	СсылкиНаДокументы.Колонки.Добавить("ГУИД",Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(36)));
	СсылкиНаДокументы.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.СчетФактураПолученный"));
	СсылкиНаДокументы.Колонки.Добавить("ГУИД_ПТУ", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(36)));
	
	Для Каждого СтрокаГУИД Из ГУИДДокументов Цикл
		Строка = СсылкиНаДокументы.Добавить();
		Строка.ГУИД = СтрокаГУИД;
		Строка.Ссылка = Документы.СчетФактураПолученный.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.ГУИД));
		Строка.ГУИД_ПТУ = Строка.Ссылка.ДокументОснование.УникальныйИдентификатор();
	КонецЦикла;
	
#Область Запрос
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СсылкиНаДокументы.ГУИД КАК ГУИД,
	|	СсылкиНаДокументы.ГУИД_ПТУ КАК ГУИД_ПТУ,
	|	СсылкиНаДокументы.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ СсылкиНаДокументы
	|ИЗ
	|	&СсылкиНаДокументы КАК СсылкиНаДокументы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СсылкиНаДокументы.ГУИД КАК ГУИД,
	|	СсылкиНаДокументы.ГУИД_ПТУ КАК ГУИДДокументаОснования,
	|	СчетФактураПолученный.ДатаВходящегоДокумента КАК Дата,
	|	СчетФактураПолученный.ДатаИсправления КАК ДатаИсправления,
//Евросиб Литвинов ( 30.12.21 #44592 Ticket#0254477 #44587 
	|	ДокПоступлениеТоваровУслуг.ДатаСФХЖ КАК ДатаСФХЖ,
//Евросиб Литвинов) 	
	|	СчетФактураПолученный.ВидСчетаФактуры КАК ВидСчетаФактуры,
	|	СчетФактураПолученный.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
	|	СчетФактураПолученный.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
	|	СчетФактураПолученный.НомерИсходногоДокумента КАК НомерИсходногоДокумента,
	|	СчетФактураПолученный.ДатаИсходногоДокумента КАК ДатаИсходногоДокумента,
	|	СчетФактураПолученный.КодВидаОперации КАК КодВидаОперации,
	|	Контрагенты.УИДИсточника КАК УИДКонтрагента,
	|	ДоговорыКонтрагентов.УИДИсточника КАК УИДДоговораКонтрагента,
	|	СчетФактураПолученный.Исправление КАК Исправление,
	|	ИсправляемыеСФ.УИДИсточника КАК ГУИДИсправляемогоСФ,
	|	СчетФактураПолученный.НомерИсправления КАК НомерИсправления,
	|	Продавцы.УИДИсточника КАК УИДПродавца,
	|	СчетФактураПолученный.Организация.Код КАК ОрганизацияКод,
	|	СчетФактураПолученный.КодСпособаПолучения КАК КодСпособаПолучения,
	|	СчетФактураПолученный.СуммаДокумента КАК СуммаДокумента,
	|	СчетФактураПолученный.СуммаУвеличение КАК СуммаУвеличение,
	|	СчетФактураПолученный.СуммаУменьшение КАК СуммаУменьшение,
	|	СчетФактураПолученный.СуммаНДСДокумента КАК СуммаНДСДокумента,
	|	СчетФактураПолученный.СуммаНДСУвеличение КАК СуммаНДСУвеличение,
	|	СчетФактураПолученный.СуммаНДСУменьшение КАК СуммаНДСУменьшение,
	|	СчетФактураПолученный.ВалютаДокумента.Код КАК ВалютаДокументаКод,
	|	СчетФактураПолученный.Ответственный.Наименование КАК ОтветственныйНаименование,
	|	СчетФактураПолученный.Комментарий КАК Комментарий,
	|	СчетФактураПолученный.СводныйКорректировочный КАК СводныйКорректировочный,
	|	СчетФактураПолученный.СводныйКомиссионный КАК СводныйКомиссионный,
	|	СФВыданныеПокупателю.УИДИсточника КАК ГУИДСФВыданногоПокупателю,
	|	Комитенты.УИДИсточника КАК УИДКомитента,
	|	ДоговорыКомитентов.УИДИсточника КАК УИДДоговораКомитента,
	|	СчетФактураПолученный.ДатаПолучения КАК ДатаПолучения,
	|	СчетФактураПолученный.Получен КАК Получен,
	|	СчетФактураПолученный.Автор.Наименование КАК АвторНаименование
	|ИЗ
	|	СсылкиНаДокументы КАК СсылкиНаДокументы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураПолученный КАК СчетФактураПолученный
//Евросиб Литвинов ( 30.12.21 #44592 Ticket#0254477 #44587 
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг КАК ДокПоступлениеТоваровУслуг
	|			ПО СчетФактураПолученный.ДокументОснование = ДокПоступлениеТоваровУслуг.Ссылка
//Евросиб Литвинов) 	
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ИсправляемыеСФ
	|			ПО СчетФактураПолученный.ИсправляемыйСчетФактура = ИсправляемыеСФ.Объект
	|				И (ИсправляемыеСФ.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных))
	|				И (ИсправляемыеСФ.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УПП))
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ДокументыОснованияСФ
	|			ПО СчетФактураПолученный.ДокументОснование = ДокументыОснованияСФ.Объект
	|				И (ДокументыОснованияСФ.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УПП))
	|				И (ДокументыОснованияСФ.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных))
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК СФВыданныеПокупателю
	|			ПО СчетФактураПолученный.СчетФактураВыданныйПокупателю = СФВыданныеПокупателю.Объект
	|				И (СФВыданныеПокупателю.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УПП))
	|				И (СФВыданныеПокупателю.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных))
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК Контрагенты
	|			ПО СчетФактураПолученный.Контрагент = Контрагенты.Объект
	|				И (Контрагенты.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.БитФинанс))
	|				И (Контрагенты.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ДоговорыКонтрагентов
	|			ПО СчетФактураПолученный.ДоговорКонтрагента = ДоговорыКонтрагентов.Объект
	|				И (ДоговорыКонтрагентов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
	|				И (ДоговорыКонтрагентов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.БитФинанс))
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК Продавцы
	|			ПО СчетФактураПолученный.Продавец = Продавцы.Объект
	|				И (Продавцы.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.БитФинанс))
	|				И (Продавцы.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК Комитенты
	|			ПО СчетФактураПолученный.Комитент = Комитенты.Объект
	|				И (Комитенты.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.БитФинанс))
	|				И (Комитенты.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ДоговорыКомитентов
	|			ПО СчетФактураПолученный.ДоговорКомитента = ДоговорыКомитентов.Объект
	|				И (ДоговорыКомитентов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.БитФинанс))
	|				И (ДоговорыКомитентов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
	|		ПО СсылкиНаДокументы.Ссылка = СчетФактураПолученный.Ссылка";	
#КонецОбласти 	

	Запрос.УстановитьПараметр("СсылкиНаДокументы", СсылкиНаДокументы);
	
	Результат = Запрос.Выполнить();		
	Шапки = Результат.Выгрузить(); 
	
	ПередаваемаяСтрокаXML = ОбщегоНазначения.ЗначениеВСтрокуXML(Шапки); 
	
	Возврат ПередаваемаяСтрокаXML;		

КонецФункции // ПолучитьДанныеПоСчетам(XMLParams)

Функция ПередатьСписокАкцептов(XMLParams) Экспорт
	
	Параметры = ОбщегоНазначения.ЗначениеИзСтрокиXML(XMLParams);
	Данные = ПолучитьДанныеЧерезМакетСКД("СписокАкцептов1", Параметры, "УИДКонтрагента, УИДДоговора");
	Возврат ОбщегоНазначения.ЗначениеВСтрокуXML(ОбщегоНазначения.ТаблицаЗначенийВМассив(Данные));
	
КонецФункции

Функция ПередатьДанныеПоАкцептам(XMLParams) Экспорт
	
	ГУИДДокументов =  ОбщегоНазначения.ЗначениеИзСтрокиXML(XMLParams);
	СсылкиНаДокументы = Новый ТаблицаЗначений;
	СсылкиНаДокументы.Колонки.Добавить("ГУИД",Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(36)));
	СсылкиНаДокументы.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.Акцепт"));
	СсылкиНаДокументы.Колонки.Добавить("ГУИД_ПТУ", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(36)));
	СсылкиНаДокументы.Колонки.Добавить("ГУИД_СторнируемогоАкцепта", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(36)));
	
	Для Каждого СтрокаГУИД Из ГУИДДокументов Цикл
		Строка = СсылкиНаДокументы.Добавить();
		Строка.ГУИД = СтрокаГУИД;
		Строка.Ссылка = Документы.Акцепт.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.ГУИД));
		Строка.ГУИД_ПТУ = Строка.Ссылка.Поступление.УникальныйИдентификатор();
 		Строка.ГУИД_СторнируемогоАкцепта = ?(ЗначениеЗаполнено(Строка.Ссылка.СторнируемыйАкцепт), Строка.Ссылка.СторнируемыйАкцепт.УникальныйИдентификатор(), "");
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СсылкиНаДокументы.ГУИД КАК ГУИД,
	|	СсылкиНаДокументы.ГУИД_ПТУ КАК ГУИД_ПТУ,
	|	СсылкиНаДокументы.Ссылка КАК Ссылка,
	|	СсылкиНаДокументы.ГУИД_СторнируемогоАкцепта КАК ГУИД_СторнируемогоАкцепта
	|ПОМЕСТИТЬ СсылкиНаДокументы
	|ИЗ
	|	&СсылкиНаДокументы КАК СсылкиНаДокументы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Акцепт.Организация.Код КАК ОрганизацияКод,
	|	ПротоколОбменовКонтрагенты.УИДИсточника КАК КонтрагентУИД,
	|	Акцепт.Поступление.НомерВходящегоДокумента КАК НомерВСФ,
	|	ВЫБОР
	|		КОГДА Акцепт.Поступление.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.РЖД)
	|			ТОГДА СчетФактураПолученный.ДатаВходящегоДокумента
	|		ИНАЧЕ Акцепт.Поступление.ДатаВходящегоДокумента
	|	КОНЕЦ КАК ДатаВСФ,
	|	Акцепт.ПометкаУдаления КАК ПометкаУдаления,
	|	Акцепт.Поступление.ВалютаДокумента.Код КАК ВалютаКод,
	|	Акцепт.СуммаАкцепта КАК СуммаАкцепта,
	|	Акцепт.Дата КАК ДатаАкцепта,
	|	СсылкиНаДокументы.ГУИД КАК ГУИД,
	|	СсылкиНаДокументы.ГУИД_ПТУ КАК ГУИД_ПТУ,
	|	СсылкиНаДокументы.ГУИД_СторнируемогоАкцепта КАК СторнируемыйАкцепт,
	|	Акцепт.Поступление.ДатаВходящегоДокумента КАК Дата,
	|	Акцепт.Поступление.Штраф КАК Штраф,
	//Евросиб Дубская 08.11.2023 ( Ticket#0330957
	|	ВЫБОР
	|		КОГДА Акцепт.Поступление ССЫЛКА Документ.ПоступлениеТоваровУслуг
	|			ТОГДА ВЫРАЗИТЬ(Акцепт.Поступление КАК Документ.ПоступлениеТоваровУслуг).Претензия
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Претензия,    
	//Евросиб Дубская 08.11.2023 )
	|	Акцепт.Номер КАК Номер
	|ИЗ
	|	Документ.Акцепт КАК Акцепт
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СсылкиНаДокументы КАК СсылкиНаДокументы
	|		ПО (СсылкиНаДокументы.Ссылка = Акцепт.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменовКонтрагенты
	|		ПО Акцепт.Поступление.Контрагент = ПротоколОбменовКонтрагенты.Объект
	|			И (ПротоколОбменовКонтрагенты.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
	|			И (ПротоколОбменовКонтрагенты.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.БитФинанс))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураПолученный КАК СчетФактураПолученный
	|		ПО (Акцепт.Поступление = СчетФактураПолученный.ДокументОснование)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СсылкиНаДокументы.ГУИД КАК ГУИД,
	|	ПротоколОбменовНоменклатура.УИДИсточника КАК НоменклатураУИД, 
//Евросиб Дубская( 28.04.2022 Ticket№50512
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(АкцептУслуги.НоменклатураСделки) КАК НоменклатураНаименование, 
// Евросиб Дубская)  
//Евросиб Дубская( 17.07.2022 TASK 72316
	|	АкцептУслуги.РасходыЗаСчетЧП КАК РасходыЗаСчетЧП, 
// Евросиб Дубская)
	|	АкцептУслуги.НоменклатурнаяГруппа.Код КАК НоменклатурнаяГруппаКод,
	|	АкцептУслуги.ПоступлениеСтавкаНДС КАК СтавкаНДС,
	|	АкцептУслуги.НоменклатураСделки.КатегорияРасходов.Код КАК СтатьяЗатратКод,
	|	АкцептУслуги.Сделка.ЦФО.Код КАК ПодразделениеКод,
	|	АкцептУслуги.Сделка.Подразделение.Код КАК ПодразделениеОрганизацииКод,
	|	ВЫБОР
	|		КОГДА АкцептУслуги.ВидРасходов = ЗНАЧЕНИЕ(Перечисление.ВидыРасходов.Возмещаемые)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Возмещаемые,
	|	СУММА(АкцептУслуги.Сумма) КАК Сумма,
	|	СУММА(АкцептУслуги.СуммаНДС) КАК СуммаНДС,
	|	СУММА(АкцептУслуги.СуммаПретензии) КАК СуммаПретензии,
	|	ПротоколОбменовКлиент.УИДИсточника КАК УИДКлиента,
//Евросиб Гудкова( 01.03.2022 Ticket№ 0234066
	|	АкцептУслуги.УчДокумент.ДатаДокумента как ДатаИСФ,
// Евросиб Гудкова)
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(АкцептУслуги.УчДокумент) КАК УчДокумент,
	|	ПротоколОбменовИСФ.УИДИсточника КАК УИДУчДокумента,
	|	ВЫБОР
	|		КОГДА ВЫБОР
	|				КОГДА АкцептУслуги.Ссылка.Поступление.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.РЖД)
	|					ТОГДА СчетФактураПолученный.ДатаВходящегоДокумента
	|				ИНАЧЕ АкцептУслуги.Ссылка.Поступление.ДатаВходящегоДокумента
	|			КОНЕЦ < ДАТАВРЕМЯ(2021, 1, 1)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ПРЕДСТАВЛЕНИЕССЫЛКИ(АкцептУслуги.ВидЗатрат)
	|	КОНЕЦ КАК ВидЗатрат   
	//Евросиб(ДИТ), Беляев СЮ, US 88214 / TA 93126, 21-10-2024, начало
	|	,УНИКАЛЬНЫЙИДЕНТИФИКАТОР(АкцептУслуги.УчДокумент) КАК СистемныйИдентификаторУчДокумента
	//Евросиб(ДИТ), Беляев СЮ, US 88214 / TA 93126, 21-10-2024, конец
	|ИЗ
	|	СсылкиНаДокументы КАК СсылкиНаДокументы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Акцепт.Услуги КАК АкцептУслуги
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменовНоменклатура
	|			ПО АкцептУслуги.НоменклатураСделки = ПротоколОбменовНоменклатура.Объект
	|				И (ПротоколОбменовНоменклатура.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УПП))
	|				И (ПротоколОбменовНоменклатура.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных))
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменовИСФ
	|			ПО АкцептУслуги.УчДокумент = ПротоколОбменовИСФ.Объект
	|				И (ПротоколОбменовИСФ.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УПП))
	|				И (ПротоколОбменовИСФ.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных))
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменовКлиент
	|			ПО АкцептУслуги.УчДокумент.Контрагент = ПротоколОбменовКлиент.Объект
	|				И (ПротоколОбменовКлиент.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
	|				И (ПротоколОбменовКлиент.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.БитФинанс))
	|		ПО СсылкиНаДокументы.Ссылка = АкцептУслуги.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураПолученный КАК СчетФактураПолученный
	|		ПО (АкцептУслуги.Ссылка.Поступление = СчетФактураПолученный.ДокументОснование)
	|ГДЕ
	|	(АкцептУслуги.Сделка <> ЗНАЧЕНИЕ(Документ.Сделка.ПустаяСсылка)
	|		ИЛИ АкцептУслуги.ПричинаНеакцепта <> ЗНАЧЕНИЕ(Справочник.Претензии.ПустаяСсылка) И АкцептУслуги.СтатусПричины <> ЗНАЧЕНИЕ(Перечисление.СтатусыПричинНеакцепта.Откз))
	|	И ВЫБОР
	|			КОГДА АкцептУслуги.ВидРасходов = ЗНАЧЕНИЕ(Перечисление.ВидыРасходов.Возмещаемые)
	|				ТОГДА АкцептУслуги.УчДокумент ССЫЛКА Документ.ОтчетКомитентуОПродажах
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|   И (АкцептУслуги.Сумма <> 0 ИЛИ АкцептУслуги.СуммаПретензии <> 0)
	|
	|СГРУППИРОВАТЬ ПО
	|	СсылкиНаДокументы.ГУИД,
	|	ПротоколОбменовНоменклатура.УИДИсточника, 
//Евросиб Дубская( 28.04.2022 Ticket№50512
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(АкцептУслуги.НоменклатураСделки), 
// Евросиб Дубская)                  
//Евросиб Дубская( 17.07.2022 TASK 72316
	|	АкцептУслуги.РасходыЗаСчетЧП, 
// Евросиб Дубская)
	|	АкцептУслуги.НоменклатурнаяГруппа.Код,
	|	АкцептУслуги.ПоступлениеСтавкаНДС,
	|	АкцептУслуги.НоменклатураСделки.КатегорияРасходов.Код,
	|	АкцептУслуги.Сделка.ЦФО.Код,
	|	АкцептУслуги.Сделка.Подразделение.Код,
	|	ВЫБОР
	|		КОГДА АкцептУслуги.ВидРасходов = ЗНАЧЕНИЕ(Перечисление.ВидыРасходов.Возмещаемые)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ,
	|	ПротоколОбменовИСФ.УИДИсточника,
	|	ПротоколОбменовКлиент.УИДИсточника,
//Евросиб Гудкова( 01.03.2022 Ticket№ 0234066
	|	АкцептУслуги.УчДокумент.ДатаДокумента,
// Евросиб Гудкова)
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(АкцептУслуги.УчДокумент),
	|	ВЫБОР
	|		КОГДА ВЫБОР
	|				КОГДА АкцептУслуги.Ссылка.Поступление.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.РЖД)
	|					ТОГДА СчетФактураПолученный.ДатаВходящегоДокумента
	|				ИНАЧЕ АкцептУслуги.Ссылка.Поступление.ДатаВходящегоДокумента
	|			КОНЕЦ < ДАТАВРЕМЯ(2021, 1, 1)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ПРЕДСТАВЛЕНИЕССЫЛКИ(АкцептУслуги.ВидЗатрат)
	|	КОНЕЦ
	//Евросиб(ДИТ), Беляев СЮ, US 88214 / TA 93126, 21-10-2024, начало
	|	,УНИКАЛЬНЫЙИДЕНТИФИКАТОР(АкцептУслуги.УчДокумент)";
	//Евросиб(ДИТ), Беляев СЮ, US 88214 / TA 93126, 21-10-2024, конец
	
	Запрос.УстановитьПараметр("СсылкиНаДокументы", СсылкиНаДокументы);
	
	Результаты = Запрос.ВыполнитьПакет();		
	Шапки = Результаты[1].Выгрузить(); 
	ТЧУслуги = Результаты[2].Выгрузить();
	
	СтруктураШапкиИТЧУслуги = Новый Структура;
	СтруктураШапкиИТЧУслуги.Вставить("Шапки", Шапки);
	СтруктураШапкиИТЧУслуги.Вставить("ТЧУслуги", ТЧУслуги);	
	
	ПередаваемаяСтрокаXML = ОбщегоНазначения.ЗначениеВСтрокуXML(СтруктураШапкиИТЧУслуги); 
	
	Возврат ПередаваемаяСтрокаXML;		
	
КонецФункции

Функция ПередатьДанныеПоИСФ(XMLParams) Экспорт

	ГУИДДокументов =  ОбщегоНазначения.ЗначениеИзСтрокиXML(XMLParams);
	СсылкиНаДокументы = Новый ТаблицаЗначений;
	СсылкиНаДокументы.Колонки.Добавить("ГУИД",Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(36)));
	СсылкиНаДокументы.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.РеализацияТоваровУслуг"));
	
	Для Каждого СтрокаГУИД Из ГУИДДокументов Цикл
		Строка = СсылкиНаДокументы.Добавить();
		Строка.ГУИД = СтрокаГУИД;
		Строка.Ссылка = Документы.РеализацияТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.ГУИД));
	КонецЦикла;
	
#Область Запрос
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СсылкиНаДокументы.ГУИД КАК ГУИД,
	|	СсылкиНаДокументы.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ СсылкиНаДокументы
	|ИЗ
	|	&СсылкиНаДокументы КАК СсылкиНаДокументы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	//Евросиб СубботинВ #84453 02.07.2024 Начало //Поменял запрос на работу только с ТЧ СчетаНаОплатуПокупателям 
	//|ВЫБРАТЬ
	//|	СсылкиНаДокументы.ГУИД КАК ГУИД,
	//|	Контрагенты.УИДИсточника КАК УИДКонтрагента,
	//|	ДоговорыКонтрагентов.УИДИсточника КАК УИДДоговораКонтрагента,
	//|	ПОДСТРОКА(РеализацияТоваровУслуг.Комментарий, 1, 1000) КАК Комментарий,
	//|	РеализацияТоваровУслуг.КратностьВзаиморасчетов КАК КратностьВзаиморасчетов,
	//|	РеализацияТоваровУслуг.КурсВзаиморасчетов КАК КурсВзаиморасчетов,
	//|	ПРЕДСТАВЛЕНИЕ(РеализацияТоваровУслуг.Ответственный) КАК ОтветственныйНаименование,
	//|	РеализацияТоваровУслуг.СуммаВключаетНДС КАК СуммаВключаетНДС,
	//|	РеализацияТоваровУслуг.СуммаДокумента КАК СуммаДокумента,
