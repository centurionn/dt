			СтрокаКТККоносаментОбъект.ТипУпаковки = СтрокаКТК.ТипУпаковки; //уточнить длину типа в DX
			
			//Субботин 80722 07.02.2024 Начало// добавил чтение массива кодов для заполнения тч детализации груза
			МассивКодовТНВЭД = СтрРазделить(СтрокаКТК.КодHS,";", Ложь);
			Если НЕ МассивКодовТНВЭД.Количество() = 0 Тогда
				//Евросиб Шевченко А.В. US 124456 TA 125854 10.12.2025
