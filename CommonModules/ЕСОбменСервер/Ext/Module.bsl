				КонтейнерОбъект = Контейнер.ПолучитьОбъект();
				КонтейнерОбъект.ТипТЕ = Выборка.ТипТЕ;
				КонтейнерОбъект.Записать();
			КонецЕсли;
			
			Если Не Выборка.ВЭксплуатации Тогда
				Запись = РегистрыСведений.ПризнакСобственностиКонтейнера.СоздатьМенеджерЗаписи();
				Запись.Период = ДатаЗаписей;
				Запись.Контейнер = Контейнер;
				Запись.ВЭксплуатации = Истина;
				// ДИТ 65580 Давудов М.А. Начало: 23.02.2023
				//Было:
				//Запись.ПризнакСобственности = Перечисления.ВариантыСобственности.Неизвестно;
				//Стало:
				Запись.ПризнакСобственности = Перечисления.ВариантыСобственности.ПустаяСсылка();
				// ДИТ 65580 Давудов М.А. Конец: 23.02.2023
				Запись.Записать();
			КонецЕсли;
			
			Если Не Выборка.НаСлежении Тогда
				Запись = РегистрыСведений.КонтейнерыНаСлежении.СоздатьМенеджерЗаписи();
				Запись.Контейнер = Контейнер;
				Запись.Период = ДатаЗаписей;
				Запись.НаСлежении = Истина;
				Запись.Записать();
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
