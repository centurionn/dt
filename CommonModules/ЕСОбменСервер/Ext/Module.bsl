Процедура ВыгрузитьКонтейнерыДляПостановкиНаСлежениеПоМорю() Экспорт
	
	ДатаДислокации = ТекущаяДата();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТранспортныйДокументКоносаменты.НомерКТК КАК НомерКТК,
	|	ТранспортныйДокументКоносаменты.НомерКТК.Наименование КАК НомерКТКНаименование,
	|	ЕСТЬNULL(ТранспортныйДокументКоносаменты.Ссылка.МорскаяЛиния.КодSearates, """") КАК МорскаяЛинияКодSearates,
	|	ЕСТЬNULL(ТранспортныйДокументКоносаменты.Ссылка.МорскаяЛиния.Наименование, """") КАК МорскаяЛинияНаименование
	|ИЗ
	|	Документ.ТранспортныйДокумент.Коносаменты КАК ТранспортныйДокументКоносаменты
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ТранспортныйДокументКоносаменты.Ссылка.ДатаПрибытия <> &ПустаяДата
	|				ТОГДА ТранспортныйДокументКоносаменты.Ссылка.ДатаПрибытия
	|			ИНАЧЕ ТранспортныйДокументКоносаменты.Ссылка.ДатаПрибытияПлан
	|		КОНЕЦ >= &ДатаДислокации
	|	И ВЫБОР
	|			КОГДА ТранспортныйДокументКоносаменты.Ссылка.ДатаОтправления <> &ПустаяДата
	|				ТОГДА ТранспортныйДокументКоносаменты.Ссылка.ДатаОтправления
	|			ИНАЧЕ ТранспортныйДокументКоносаменты.Ссылка.ДатаОтправленияПлан
	|		КОНЕЦ <= &ДатаДислокации
	|	И ТранспортныйДокументКоносаменты.Ссылка.Проведен";
	
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	Запрос.УстановитьПараметр("ДатаДислокации", ДатаДислокации);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Запись = Новый ЗаписьXML;
	
	//ИмяФайла = Константы.КаталогДислокацииРФ.Получить() + "\RequestFromDC\DataCore_SeaDislocation_" + Формат(ДатаДислокации, "ДФ=yyyyMMddччммсс")+ ".xml";
	ИмяФайла = Константы.КаталогДислокацииРФ.Получить() + "\RequestFromDC\DataCore_SeaDislocation.xml";
	//Запись.УстановитьСтроку("UTF-8");
	//Запись.УстановитьСтроку("windows-1251");
	Запись.ОткрытьФайл(ИмяФайла);
	Запись.ЗаписатьОбъявлениеXML();
	
	Запись.ЗаписатьНачалоЭлемента("SeaDislocation");
	
	Пока Выборка.Следующий() Цикл
		ДобавитьЭлементВФайл(Запись, "Container", "", Новый Структура("Number, CodeSearates, SeaLineName", Выборка.НомерКТКНаименование, Выборка.МорскаяЛинияКодSearates, Выборка.МорскаяЛинияНаименование));
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
		
	СтрокаXML = Запись.Закрыть();
	
КонецПроцедуры

