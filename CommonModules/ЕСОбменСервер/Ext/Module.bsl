
#Область УПП
Функция ПередатьСписокВходящихДокументов(XMLParams) Экспорт
	
	Параметры = ОбщегоНазначения.ЗначениеИзСтрокиXML(XMLParams);
	Данные = ПолучитьДанныеЧерезМакетСКД("СписокВходящихДокументов", Параметры, "УИДКонтрагента,УИДДоговора");
	Возврат ОбщегоНазначения.ЗначениеВСтрокуXML(ОбщегоНазначения.ТаблицаЗначенийВМассив(Данные));
	
КонецФункции

Функция ПередатьСписокПодтвержденийИСФНДС0(XMLParams) Экспорт
	
	Параметры = ОбщегоНазначения.ЗначениеИзСтрокиXML(XMLParams);
	// Евросиб(ДИТ) US 90779 ТА 99010 Сержантова А.С. Начало: 14.01.2025
	// Было:
	//Данные = ПолучитьДанныеЧерезМакетСКД("СписокПодтвержденийИСФНДС0", Параметры); 
	//Стало:
	Данные = ПолучитьДанныеЧерезМакетСКД("СписокПодтвержденийИСФНДСПострочно", Параметры);
	// Евросиб(ДИТ) US 90779 ТА 99010 Сержантова А.С. Конец: 14.01.2025
	Возврат ОбщегоНазначения.ЗначениеВСтрокуXML(Данные);
	
КонецФункции

Функция ПередатьСписокИсходящихДокументов(XMLParams, ВидОбъекта) Экспорт

	Параметры = ОбщегоНазначения.ЗначениеИзСтрокиXML(XMLParams);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	&ВидОбъекта.Ссылка КАК СсылкаИСФ,
	|	ВЫБОР КОГДА &ВидОбъекта.НомерДляПечати = """" ТОГДА &ВидОбъекта.Номер ИНАЧЕ &ВидОбъекта.НомерДляПечати КОНЕЦ КАК НомерИСФ,
	|	ВЫБОР КОГДА &ВидОбъекта.ДатаДокумента = ДАТАВРЕМЯ(1,1,1) ТОГДА &ВидОбъекта.Дата ИНАЧЕ &ВидОбъекта.ДатаДокумента КОНЕЦ КАК ДатаИСФ,
	|	ВЫБОР КОГДА ТИПЗНАЧЕНИЯ(&ВидОбъекта.Ссылка) = ТИП(Документ.РеализацияТоваровУслуг) ТОГДА ""Б""
	|		КОГДА ТИПЗНАЧЕНИЯ(&ВидОбъекта.Ссылка) = ТИП(Документ.КорректировкаРеализации) ТОГДА ""К"" ИНАЧЕ ""О"" КОНЕЦ КАК ТипИСФ,
	|	НЕ ПротоколОбменов.Объект ЕСТЬ NULL КАК ЗагрузкаПодтверждена
	|ИЗ
	|	Документ.&ВидОбъекта КАК &ВидОбъекта
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	|		ПО &ВидОбъекта.Ссылка = ПротоколОбменов.Объект
	|			И (ПротоколОбменов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных))
	|			И (ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УПП))
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО &ВидОбъекта.Организация = Организации.Ссылка
	|			И (Организации.Код = &КодОрганизации)
	|			И (&ВидОбъекта.Проведен)
	|			//&УсловиеПоКонтрагенту
	|			//&УсловиеПоДоговоруКонтрагента
	|ГДЕ
  	|	&ВидОбъекта.ПериодВО МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ПротоколОбменов.Объект ЕСТЬ NULL
	//ДИТ Шевченко А.В. US 59973 ТА 71435 29.08.2023
	|	//&УсловиеПоСубсидии
	//ДИТ Шевченко А.В. US 59973 ТА 71435 29.08.2023
	|   ";
	Запрос.УстановитьПараметр("НачалоПериода",				Параметры.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",				Параметры.КонецПериода);
	Запрос.УстановитьПараметр("КодОрганизации",				Параметры.КодОрганизации);
	Если ВидОбъекта = "ОтчетКомитентуОПродажах" Тогда
		Запрос.Текст = Запрос.Текст + "
	 	|И ОтчетКомитентуОПродажах.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОтчетКомитентуОПродажах.ОтчетОЗакупках)
		|ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ
		|	ОтчетКомитентуОПродажах.Ссылка КАК Ссылка,
		|   ОтчетКомитентуОПродажах.НомерДляПечатиВознаграждение,
		|   ОтчетКомитентуОПродажах.ДатаДокумента,
		|	""Б"",
		|	НЕ ПротоколОбменов.Объект ЕСТЬ NULL КАК ЗагрузкаПодтверждена
		|ИЗ
		|	Документ.ОтчетКомитентуОПродажах КАК ОтчетКомитентуОПродажах
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|		ПО ОтчетКомитентуОПродажах.Ссылка = СчетФактураВыданный.ДокументОснование
		|			И (СчетФактураВыданный.Продавец = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
		|		ПО ОтчетКомитентуОПродажах.Ссылка = ПротоколОбменов.Объект
		|			И (ПротоколОбменов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных))
		|			И (ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УПП))	
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|		ПО ОтчетКомитентуОПродажах.Организация = Организации.Ссылка
		|			И (Организации.Код = &КодОрганизации)
		|			И (ОтчетКомитентуОПродажах.Проведен)
		|			//&УсловиеПоКонтрагенту
		|			//&УсловиеПоДоговоруКонтрагента
		|ГДЕ ОтчетКомитентуОПродажах.СпособРасчетаКомиссионногоВознаграждения <> ЗНАЧЕНИЕ(Перечисление.СпособыРасчетаКомиссионногоВознаграждения.НеРассчитывается)
		|	И ОтчетКомитентуОПродажах.ПериодВО МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ПротоколОбменов.Объект ЕСТЬ NULL
		|   ";
	КонецЕсли; 
	Если ЗначениеЗаполнено(Параметры.УИДКонтрагента) Тогда
		Запрос.УстановитьПараметр("УИДКонтрагента",				Параметры.УИДКонтрагента);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//&УсловиеПоКонтрагенту","
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК Контрагенты
	|		ПО &ВидОбъекта.Контрагент = Контрагенты.Объект
	|			И (Контрагенты.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
	|			И (Контрагенты.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.БитФинанс))
	|			И (Контрагенты.УИДИсточника = &УИДКонтрагента)");
	КонецЕсли; 
	Если ЗначениеЗаполнено(Параметры.УИДДоговораКонтрагента) Тогда
		Запрос.УстановитьПараметр("УИДДоговораКонтрагента",		Параметры.УИДДоговораКонтрагента);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//&УсловиеПоДоговоруКонтрагента","
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ДоговорыКонтрагентов
	|		ПО &ВидОбъекта.ДоговорКонтрагента = ДоговорыКонтрагентов.Объект
	|			И (ДоговорыКонтрагентов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
	|			И (ДоговорыКонтрагентов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.БитФинанс))
	|			И (ДоговорыКонтрагентов.УИДИсточника = &УИДДоговораКонтрагента)");
	КонецЕсли;
	
	//ДИТ Шевченко А.В. US 59973 ТА 71435 29.08.2023
	Если ВидОбъекта = "РеализацияТоваровУслуг" Тогда	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//&УсловиеПоСубсидии","
		|	И &ВидОбъекта.Субсидии = " + XMLСтрока(Параметры.Субсидии) + "");
	КонецЕсли;	
	//ДИТ Шевченко А.В. US 59973 ТА 71435 29.08.2023
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВидОбъекта", ВидОбъекта);
	
	Выборка = Запрос.Выполнить().Выбрать();
	ДокументыКВыгрузке = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		СтруктураДокумента = Новый Структура;
		СтруктураДокумента.Вставить("ГУИД", Выборка.СсылкаИСФ.УникальныйИдентификатор()); 
		СтруктураДокумента.Вставить("НомерИСФ", Выборка.НомерИСФ); 
		СтруктураДокумента.Вставить("ДатаИСФ", Выборка.ДатаИСФ);
		СтруктураДокумента.Вставить("ТипИСФ", Выборка.ТипИСФ);
		СтруктураДокумента.Вставить("ЗагрузкаПодтверждена", Выборка.ЗагрузкаПодтверждена);
		ДокументыКВыгрузке.Добавить(СтруктураДокумента);
	КонецЦикла;	
	
	Возврат ОбщегоНазначения.ЗначениеВСтрокуXML(ДокументыКВыгрузке);		


КонецФункции // ПолучитьСписокИсходящихДокументов(XMLParams, ВидОбъекта)

Функция ПередатьДанныеПоСчетамДляЗаказа(XMLParams) Экспорт

	ГУИДДокументов =  ОбщегоНазначения.ЗначениеИзСтрокиXML(XMLParams);
	СсылкиНаДокументы = Новый ТаблицаЗначений;
	СсылкиНаДокументы.Колонки.Добавить("ГУИД",Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(36)));
	СсылкиНаДокументы.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.СчетНаОплатуПоставщика"));
	Для Каждого СтрокаГУИД Из ГУИДДокументов Цикл
		Строка = СсылкиНаДокументы.Добавить();
		Строка.ГУИД = СтрокаГУИД;
		Строка.Ссылка = Документы.СчетНаОплатуПоставщика.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.ГУИД));		
	КонецЦикла;
	
#Область Запрос
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СсылкиНаДокументы.ГУИД КАК ГУИД,
	|	СсылкиНаДокументы.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ СсылкиНаДокументы
	|ИЗ
	|	&СсылкиНаДокументы КАК СсылкиНаДокументы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|  ""Счет""  КАК ТипДокумента,  
	// Евросиб(ДИТ) US 73033 ТА 88304 Сержантова А.С. Начало: 18.07.2024  
	//реквизиты были добавлены для Заявки, здесь для того, чтобы на стороне УПП не выходила ошибка
	|	СчетНаОплатуПоставщика.Проведен КАК Проведен,
	|	СчетНаОплатуПоставщика.ПометкаУдаления КАК ПометкаУдаления,
	// Евросиб(ДИТ) US 73033 ТА 88304 Сержантова А.С. Конец: 18.07.2024   
	// Евросиб(ДИТ) US 89517 ТА 91085 Сержантова А.С. Начало: 17.09.2024
	|	Выразить("""" КАК Строка(150)) КАК ВебСсылка,  
	// Евросиб(ДИТ) US 89517 ТА 91085 Сержантова А.С. Конец: 17.09.2024
	|	СчетНаОплатуПоставщика.Дата КАК Дата,
	|	СчетНаОплатуПоставщика.Организация.Код КАК ОрганизацияКод,
	|	СчетНаОплатуПоставщика.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
	|	ПОДСТРОКА(СчетНаОплатуПоставщика.Комментарий, 1, 1000) КАК Комментарий,
	|	СчетНаОплатуПоставщика.КратностьВзаиморасчетов КАК КратностьВзаиморасчетов,
	|	СчетНаОплатуПоставщика.КурсВзаиморасчетов КАК КурсВзаиморасчетов,
	|	СчетНаОплатуПоставщика.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
	|	ПРЕДСТАВЛЕНИЕ(СчетНаОплатуПоставщика.Ответственный) КАК Ответственный,
	|	СчетНаОплатуПоставщика.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	СчетНаОплатуПоставщика.СуммаДокумента КАК СуммаДокумента,
	|	СчетНаОплатуПоставщика.УчитыватьНДС КАК УчитыватьНДС,
	|	СчетНаОплатуПоставщика.ПодразделениеОрганизации.Код КАК ПодразделениеОрганизацииКод,
	|	СчетНаОплатуПоставщика.ЦФО.Код КАК ЦФОКод,
	|	СчетНаОплатуПоставщика.ВалютаДокумента.Код КАК ВалютаДокументаКод,
	|	СсылкиНаДокументы.ГУИД КАК ГУИД,
	//Евросиб - АСуслов 06.02.2024 17:33:35 #78327
	//(
	|	"""" КАК ГУИДЗаявка,
	|	СсылкиНаДокументы.ГУИД КАК ГУИДЗаказ,
	//)
	//Евросиб - АСуслов 06.02.2024 17:33:39 #78327
	|	ПРЕДСТАВЛЕНИЕ(СчетНаОплатуПоставщика.Автор) КАК Автор,
	|	Контрагенты.УИДИсточника КАК УИДКонтрагента,
	|	ДоговорыКонтрагентов.УИДИсточника КАК УИДДоговораКонтрагента,
	|	"""" КАК УИДДоговораОплаты,
	|	СчетНаОплатуПоставщика.БанковскийСчетКонтрагента.НомерСчета КАК БанковскийСчетКонтрагентаНомерСчета,
	|	СчетНаОплатуПоставщика.БанковскийСчетОрганизации.НомерСчета КАК БанковскийСчетОрганизацииНомерСчета,
	|	СчетНаОплатуПоставщика.ДатаПоступления КАК ДатаПоступления,
	|	СчетНаОплатуПоставщика.ДатаОплаты КАК ДатаОплаты,
	|	Ложь КАК ОплатаВИнойВалюте,
	|	"""" КАК ВалютаОплатыКод,
	//Евросиб СубботинВ #89541 16.10.2024 Начало
    |	Выразить("""" КАК Строка(150)) как ВидОперации	
	//Евросиб СубботинВ #89541 16.10.2024 Конец
	|ИЗ
	|	СсылкиНаДокументы КАК СсылкиНаДокументы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетНаОплатуПоставщика КАК СчетНаОплатуПоставщика
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК Контрагенты
	|			ПО СчетНаОплатуПоставщика.Контрагент = Контрагенты.Объект
	|				И (Контрагенты.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
	|				И (Контрагенты.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.БитФинанс))
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ДоговорыКонтрагентов
	|			ПО СчетНаОплатуПоставщика.ДоговорКонтрагента = ДоговорыКонтрагентов.Объект
	|				И (ДоговорыКонтрагентов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
	|				И (ДоговорыКонтрагентов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.БитФинанс))  
	|		ПО СсылкиНаДокументы.Ссылка = СчетНаОплатуПоставщика.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СсылкиНаДокументы.ГУИД КАК ГУИД,
	//Евросиб - АСуслов 06.02.2024 17:33:35 #78327
	//(
	|	"""" КАК ГУИДЗаявка,
	|	СсылкиНаДокументы.ГУИД КАК ГУИДЗаказ,
	|	"""" ТипДокумента,
	|   """" КАК НомерВходящегоДокумента,
	|   """" КАК ДатаВходящегоДокумента,
	//)
	//Евросиб - АСуслов 06.02.2024 17:33:39 #78327
	|	СчетНаОплатуПоставщикаТовары.НомерСтроки КАК НомерСтроки,
	|	ПОДСТРОКА(СчетНаОплатуПоставщикаТовары.Содержание, 1, 1000) КАК Содержание,
	|	СчетНаОплатуПоставщикаТовары.Количество КАК Количество,
	|	СчетНаОплатуПоставщикаТовары.СтавкаНДС КАК СтавкаНДС,
