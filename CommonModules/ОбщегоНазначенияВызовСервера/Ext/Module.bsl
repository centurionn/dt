Функция ПривестиСтрокуУчетныхЕдиницКТребуемомуФормату(Знач ВходнаяСтрока) Экспорт
	//меняем разделитель
	ВходнаяСтрока = СтрЗаменить(ВходнаяСтрока,",",";");		
	
	//ДИТ, Беляев СЮ, Рефакторинг после ревью кода, 08-09-2022, начало
	//убираем пробелы
	ВходнаяСтрока = СтрЗаменить(ВходнаяСтрока," ","");
	//убираем пустые элементы, т.е. подряд ;;    
	Пока СтрНайти(ВходнаяСтрока,";;")>0 Цикл
		ВходнаяСтрока = СтрЗаменить(ВходнаяСтрока,";;",";");
	КонецЦикла;
	//убираем крайний правый разделитель
	Если СтрЗаканчиваетсяНа(ВходнаяСтрока,";") Тогда
		ВходнаяСтрока = Сред(ВходнаяСтрока, 1, СтрДлина(ВходнаяСтрока)-1);
	КонецЕсли;
	Возврат ВходнаяСтрока;
	//ДИТ, Беляев СЮ, Рефакторинг после ревью кода, 08-09-2022, конец
	
КонецФункции             
