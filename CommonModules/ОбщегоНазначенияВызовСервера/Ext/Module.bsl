Функция НайтиНакладнуюПоНомеру(НомерЖДН,ДатаНачалаПоискаНакладных = Неопределено,ДатаОкончанияПоискаНакладных = Неопределено) Экспорт
	
	Результат = неопределено;
	//ДИТ Шевченко А.В 26.07.2022 54378 -Начало //Добавил в запрос условие по периоду
	ПериодНеЗадан = НЕ ЗначениеЗаполнено(ДатаНачалаПоискаНакладных) или НЕ ЗначениеЗаполнено(ДатаОкончанияПоискаНакладных);	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	э_Накладная.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.э_Накладная КАК э_Накладная
	               |ГДЕ
	               |	НЕ э_Накладная.ПометкаУдаления
	               |	И э_Накладная.НакладнаяНомер = &НакладнаяНомер
	               |	И (&ПериодНеЗадан
	               |			ИЛИ э_Накладная.Дата МЕЖДУ &ДатаНач И &ДатаКон)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	э_Накладная.Дата УБЫВ";
	Запрос.УстановитьПараметр("ПериодНеЗадан", ПериодНеЗадан);
	Запрос.УстановитьПараметр("ДатаНач", ДатаНачалаПоискаНакладных);
	Запрос.УстановитьПараметр("ДатаКон", ДатаОкончанияПоискаНакладных);
	//ДИТ Шевченко А.В 26.07.2022 54378 -Конец
	Запрос.УстановитьПараметр("НакладнаяНомер", НомерЖДН);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		результат = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат результат;
	
КонецФункции

// ДИТ BUG 81321 ТА 81636 Сержантова А.С. 17.04.2024  
Функция НайтиНакладнуюПоНомеруДатеКТК(НомерЖДН, ДатаЖДН, НомерКТК) Экспорт

	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	э_Накладная.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.э_Накладная КАК э_Накладная
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.э_Накладная.Контейнеры КАК э_НакладнаяКонтейнеры
	               |		ПО (э_НакладнаяКонтейнеры.Ссылка = э_Накладная.Ссылка)
	               |ГДЕ
	               |	НЕ э_Накладная.ПометкаУдаления
	               |	И э_Накладная.НакладнаяНомер = &НакладнаяНомер
				   //ДИТ, Беляев СЮ, Ticket#0352198, 20-05-2024, начало (закомментировал условие по дате)
	               //|	И э_Накладная.Дата = &ДатаЖДН
				   //ДИТ, Беляев СЮ, Ticket#0352198, 20-05-2024, конец
				   //Евросиб(ДИТ), Беляев СЮ, BUG 89957/TA 89962, 16-08-2024, начало
				   |	И (НАЧАЛОПЕРИОДА(э_Накладная.Дата, ГОД) = НАЧАЛОПЕРИОДА(&ДатаЖДН, ГОД)
				   |			ИЛИ э_Накладная.Дата Между НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаЖДН, МЕСЯЦ, -1), МЕСЯЦ) И &ДатаЖДН)
				   //Евросиб(ДИТ), Беляев СЮ, BUG 89957/TA 89962, 16-08-2024, конец
	               |	И э_НакладнаяКонтейнеры.НомерКонтейнера = &НомерКонтейнера
	               |	И э_Накладная.Проведен
	               |	И э_Накладная.ТекущееСостояниеНакладнойДействующийСтатус
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	э_Накладная.Дата УБЫВ";
	//Запрос.УстановитьПараметр("НакладнаяНомер", НомерЖДН);  
	//Евросиб(ДИТ), Беляев СЮ, BUG 111369 / TA 111533, 16-06-2025, начало
	Запрос.УстановитьПараметр("НакладнаяНомер", СокрЛП(НомерЖДН));
	//Евросиб(ДИТ), Беляев СЮ, BUG 111369 / TA 111533, 16-06-2025, конец
	Запрос.УстановитьПараметр("ДатаЖДН", ДатаЖДН);
	Запрос.УстановитьПараметр("НомерКонтейнера", НомерКТК);
	РезультатПоиска = Запрос.Выполнить();   
	Если не РезультатПоиска.Пустой() Тогда
		ЖДНДействующая = РезультатПоиска.Выбрать();
		Если ЖДНДействующая.Следующий() Тогда
			результат = ЖДНДействующая.Ссылка; 
		КонецЕсли;
	КонецЕсли;
	
	Возврат результат;	

КонецФункции 

