// Евросиб 89887 TA 89889 Рыбьяков К.А. 18.11.2024 ((
Функция НайтиСозданныеНаОснованииРелизы(Знач ДокументОбъект) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПСЦПоставщика.Организация КАК Организация,
	|	ПСЦПоставщика.ЦФО КАК ЦФО,
	|	ПСЦПоставщика.Подразделение КАК Подразделение,
	|	ПСЦПоставщика.Контрагент КАК Контрагент,
	|	ПСЦПоставщика.Договор КАК Договор,
	|	ПСЦПоставщика.НачалоДействия КАК НачалоДействия,
	|	ПСЦПоставщика.ОкончаниеДействия КАК ОкончаниеДействия,
	|	ПСЦПоставщика.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ПСЦПоставщика.ВидУслугПоставщика КАК ВидУслугПоставщика,
	|	ПСЦПоставщика.СтатусДокумента КАК СтатусДокумента,
	|	ПСЦПоставщика.Проведен КАК Проведен,
	|	ДокументРелиз.Ссылка КАК РелизСобственника
	|ИЗ
	|	Документ.ПСЦПоставщика КАК ПСЦПоставщика
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РелизСобственника КАК ДокументРелиз 
	|		ПО ПСЦПоставщика.Ссылка = ДокументРелиз.ПСЦ
	|ГДЕ
	|	ПСЦПоставщика.Ссылка = &Документ
	|	И ДокументРелиз.НаОсновании
	|	И НЕ ДокументРелиз.ПометкаУдаления";

	Запрос.УстановитьПараметр("Документ", ДокументОбъект.Ссылка);
	
	Выгрузка = Запрос.Выполнить().Выгрузить();
	
	СписокРелизовКИзменению = Новый Массив;
	
	ЕстьИзмененияВОсновныхРеквизитах = Ложь;
	
	Если Выгрузка.Количество() > 0 Тогда
		Если Выгрузка[0].Организация <> ДокументОбъект.Организация
			ИЛИ Выгрузка[0].ЦФО <> ДокументОбъект.ЦФО
			ИЛИ Выгрузка[0].Подразделение <> ДокументОбъект.Подразделение
			ИЛИ Выгрузка[0].Контрагент <> ДокументОбъект.Контрагент
			ИЛИ Выгрузка[0].Договор <> ДокументОбъект.Договор
			ИЛИ Выгрузка[0].НачалоДействия <> ДокументОбъект.НачалоДействия
			ИЛИ Выгрузка[0].ОкончаниеДействия <> ДокументОбъект.ОкончаниеДействия
			ИЛИ Выгрузка[0].СуммаВключаетНДС <> ДокументОбъект.СуммаВключаетНДС
			ИЛИ Выгрузка[0].ВидУслугПоставщика <> ДокументОбъект.ВидУслугПоставщика
			ИЛИ Выгрузка[0].СтатусДокумента <> ДокументОбъект.СтатусДокумента
			ИЛИ Выгрузка[0].Проведен <> ДокументОбъект.Проведен Тогда
			ЕстьИзмененияВОсновныхРеквизитах = Истина;
		КонецЕсли;
		Если ЕстьИзмененияВОсновныхРеквизитах Тогда
			Для Каждого Строка Из Выгрузка Цикл
				СписокРелизовКИзменению.Добавить(Строка.РелизСобственника);
			КонецЦикла;
		КонецЕсли;
	Иначе 
		Возврат СписокРелизовКИзменению;
	КонецЕсли;

	ЗапросТекущиеДанные = Новый Запрос;
	ЗапросТекущиеДанные.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПСЦПоставщикаУслуги.ПунктОтправления КАК ПунктОтправления,
	|	ПСЦПоставщикаУслуги.ПунктНазначенияСтрана КАК ЛокацияСдачи,
	|	ПСЦПоставщикаУслуги.Количество КАК КоличествоКТК,
	|	ПСЦПоставщикаУслуги.Валюта КАК Валюта,
	|	ПСЦПоставщикаУслуги.НормаПользования КАК НормативВозврата,
	|	ПСЦПоставщикаУслуги.СтоимостьБезНДС КАК Ставка,
	|	ПСЦПоставщикаУслуги.СтавкаНДС КАК СтавкаНДС,
	|	ПСЦПоставщикаУслуги.ВидСобственности КАК тек_СобственностьКТК,
	|	ПСЦПоставщикаУслуги.Комментарий КАК тек_Примечание,
	|	ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ПСЦПоставщикаУслуги.ПунктОтправленияСтрана КАК Локация,
	|	ПСЦПоставщикаУслуги.ПунктОтправленияГород КАК Сток,
	|	ПСЦПоставщикаУслуги.ПунктНазначенияГород КАК ВозможныеСтокиСдачи,
	|	ПСЦПоставщикаУслуги.ИнструкцииПоСдаче КАК ИнструкцииПоСдаче
	|ПОМЕСТИТЬ ВТ_ПСЦУслуги
	|ИЗ
	|	&ПСЦПоставщикаУслуги КАК ПСЦПоставщикаУслуги
	|
	|ГДЕ
	|	ПСЦПоставщикаУслуги.Номенклатура В(&Номенклатура)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КритерииУслуг.ТипоразмерКТК КАК ТипоразмерКТК,
	|	КритерииУслуг.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг
	|ПОМЕСТИТЬ ВТ_КритерииУслуг
	|ИЗ
	|	&КритерииУслуг КАК КритерииУслуг
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПСЦПоставщикаУслуги.ПунктОтправления КАК ПунктОтправления,
	|	ПСЦПоставщикаУслуги.ЛокацияСдачи КАК ЛокацияСдачи,
	|	ПСЦПоставщикаУслуги.КоличествоКТК КАК КоличествоКТК,
	|	ПСЦПоставщикаУслуги.Валюта КАК Валюта,
	|	ПСЦПоставщикаУслуги.НормативВозврата КАК НормативВозврата,
	|	ПСЦПоставщикаУслуги.Ставка КАК Ставка,
	|	ПСЦПоставщикаУслуги.СтавкаНДС КАК СтавкаНДС,
	|	ПСЦПоставщикаУслуги.тек_СобственностьКТК КАК тек_СобственностьКТК,
	|	ПСЦПоставщикаУслуги.тек_Примечание КАК тек_Примечание,
	|	ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ПСЦПоставщикаУслуги.Локация КАК Локация,
	|	ПСЦПоставщикаУслуги.Сток КАК Сток,
	|	ПСЦПоставщикаУслуги.ВозможныеСтокиСдачи КАК ВозможныеСтокиСдачи,
	|	ПСЦПоставщикаУслуги.ИнструкцииПоСдаче КАК ИнструкцииПоСдаче,
	|	ВТ_КритерииУслуг.ТипоразмерКТК КАК ТипКТК,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ПСЦПоставщикаУслуги.ПунктОтправления) = ТИП(Справочник.Мультилокации)
	|			ТОГДА Мультилокации.Локация
	|		ИНАЧЕ ПСЦПоставщикаУслуги.ПунктОтправления
	|	КОНЕЦ КАК ЛокацияВзятияТерминал
	|ИЗ
	|	ВТ_ПСЦУслуги КАК ПСЦПоставщикаУслуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Мультилокации.Локации КАК Мультилокации
	|		ПО ПСЦПоставщикаУслуги.ПунктОтправления = Мультилокации.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КритерииУслуг КАК ВТ_КритерииУслуг
	|		ПО ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг = ВТ_КритерииУслуг.ИдентификаторСтрокиУслуг";
	
	МассивНоменклатур = Новый Массив;
	МассивНоменклатур.Добавить(Справочники.Номенклатура.АрендаКонтейнеров);
	МассивНоменклатур.Добавить(Справочники.Номенклатура.ПредоставлениеКТК);
	
	ЗапросТекущиеДанные.УстановитьПараметр("Номенклатура", МассивНоменклатур);
	ЗапросТекущиеДанные.УстановитьПараметр("ПСЦПоставщикаУслуги", ДокументОбъект.Услуги.Выгрузить());
	ЗапросТекущиеДанные.УстановитьПараметр("КритерииУслуг", ДокументОбъект.КритерииУслуг.Выгрузить());
	
	ВыгрузкаДанныеОбъекта = ЗапросТекущиеДанные.Выполнить().Выгрузить();
	
	ЗапросСтарыеДанные = Новый Запрос;
	ЗапросСтарыеДанные.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПСЦПоставщикаУслуги.ПунктОтправления,
	|	ПСЦПоставщикаУслуги.ПунктНазначенияСтрана КАК ЛокацияСдачи,
