Функция ПолучитьСсылкуНаДанныеПечатнойФормы(НакладнаяИД, ИмяСохраняемогоФайла) Экспорт
	
	ИмяОперации = "EtranInvoiceGetTemplateName";
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("invoiceID", НакладнаяИД);
		
	ЗапросXML = ТранспортныеДокументы_сервер.ПолучитьТекстЗапросаВебСервису(СтруктураПараметров);
	
