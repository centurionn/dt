	Если СтрДлина(ОтветXML) < 48 Тогда
		Возврат "";
	КонецЕсли;
	
	ТаблицаДанных = ВебСервисы_сервер.УниверсальныйПарсерXML(ОтветXML, "ReportURL");
	Если ТаблицаДанных.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(ОтветXML);
		Возврат "";
	КонецЕсли;
	
	Возврат ТаблицаДанных[0].ReportURL;
	
