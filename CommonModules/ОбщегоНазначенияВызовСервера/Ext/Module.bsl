Функция ПривестиСтрокуСписокПредыдущихЭтаповКТребуемомуФормату(Знач ВходнаяСтрока) Экспорт
	//меняем разделитель
	СтрокаПослеЗаменыСимволов = ВходнаяСтрока;
	Для Позиция = 1 По СтрДлина(ВходнаяСтрока) Цикл
		ТекСимвол = Сред(ВходнаяСтрока, Позиция, 1);
		ТекущийКодСимвола = КодСимвола(ТекСимвол);
		ЭтоЦифра = (ТекущийКодСимвола >= КодСимвола("0") И ТекущийКодСимвола <= КодСимвола("9"));
		Если НЕ ЭтоЦифра Тогда
			СтрокаПослеЗаменыСимволов = Лев(СтрокаПослеЗаменыСимволов,Позиция-1)+","+Сред(СтрокаПослеЗаменыСимволов,Позиция+1);
		КонецЕсли;
	КонецЦикла;	
	//убираем пустые элементы, т.е. подряд ;;    
	Пока СтрНайти(СтрокаПослеЗаменыСимволов,",,")>0 Цикл
		СтрокаПослеЗаменыСимволов = СтрЗаменить(СтрокаПослеЗаменыСимволов,",,",",");
	КонецЦикла;
	//убираем крайний правый разделитель
	Если СтрЗаканчиваетсяНа(СтрокаПослеЗаменыСимволов,",") Тогда
		СтрокаПослеЗаменыСимволов = Сред(СтрокаПослеЗаменыСимволов, 1, СтрДлина(СтрокаПослеЗаменыСимволов)-1);
	КонецЕсли;
	Возврат СтрокаПослеЗаменыСимволов;	
КонецФункции
