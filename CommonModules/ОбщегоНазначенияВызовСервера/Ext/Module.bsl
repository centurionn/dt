	|ИЗ
	|	Документ.ПСЦПоставщика.Услуги КАК ПСЦПоставщикаУслуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Мультилокации.Локации КАК Мультилокации
	|		ПО ПСЦПоставщикаУслуги.ПунктОтправления = Мультилокации.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПСЦПоставщика.КритерииУслуг КАК КритерииУслуг
	|		ПО ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг = КритерииУслуг.ИдентификаторСтрокиУслуг
	|ГДЕ
	|	ПСЦПоставщикаУслуги.Ссылка = &Документ
	|	И ПСЦПоставщикаУслуги.Номенклатура В(&Номенклатура)";
	
	МассивНоменклатур = Новый Массив;
	МассивНоменклатур.Добавить(Справочники.Номенклатура.АрендаКонтейнеров);
	МассивНоменклатур.Добавить(Справочники.Номенклатура.ПредоставлениеКТК);
	
	ЗапросСтарыеДанные.УстановитьПараметр("Номенклатура", МассивНоменклатур);
	ЗапросСтарыеДанные.УстановитьПараметр("Документ", ДокументОбъект.Ссылка);
	
	ВыгрузкаДанныеСсылки = ЗапросСтарыеДанные.Выполнить().Выгрузить();
	
	СоответствиеСтрокСсылки = Новый Соответствие;
	Для Каждого СтрокаСсылки Из ВыгрузкаДанныеСсылки Цикл
		СоответствиеСтрокСсылки.Вставить(СтрокаСсылки.ИдентификаторСтрокиУслуг, СтрокаСсылки);
	КонецЦикла;
	
	ИдентификаторыСтрок = Новый Массив;
	ИдентификаторыНовыхСтрок = Новый Массив;
	
	Для Каждого СтрокаОбъекта Из ВыгрузкаДанныеОбъекта Цикл
		
		СтрокаСсылки = СоответствиеСтрокСсылки.Получить(СтрокаОбъекта.ИдентификаторСтрокиУслуг);
		
		Если СтрокаСсылки = Неопределено Тогда
			ИдентификаторыНовыхСтрок.Добавить(СтрокаОбъекта);
			Продолжить;
		КонецЕсли;
		
		ЕстьИзменение = Ложь;
		ЕстьИзменение = ЕстьИзменение Или (СтрокаОбъекта.Локация <> СтрокаСсылки.Локация);
		ЕстьИзменение = ЕстьИзменение Или (СтрокаОбъекта.ЛокацияСдачи <> СтрокаСсылки.ЛокацияСдачи);
		ЕстьИзменение = ЕстьИзменение Или (СтрокаОбъекта.ВозможныеСтокиСдачи <> СтрокаСсылки.ВозможныеСтокиСдачи);
		ЕстьИзменение = ЕстьИзменение Или (СтрокаОбъекта.ЛокацияВзятияТерминал <> СтрокаСсылки.ЛокацияВзятияТерминал);
		ЕстьИзменение = ЕстьИзменение Или (СтрокаОбъекта.Сток <> СтрокаСсылки.Сток);
		ЕстьИзменение = ЕстьИзменение Или (СтрокаОбъекта.КоличествоКТК <> СтрокаСсылки.Количество);
		ЕстьИзменение = ЕстьИзменение Или (СтрокаОбъекта.Валюта <> СтрокаСсылки.Валюта);
		ЕстьИзменение = ЕстьИзменение Или (СтрокаОбъекта.НормативВозврата <> СтрокаСсылки.НормаПользования);
		ЕстьИзменение = ЕстьИзменение Или (СтрокаОбъекта.Ставка <> СтрокаСсылки.СтоимостьБезНДС);
		ЕстьИзменение = ЕстьИзменение Или (СтрокаОбъекта.СтавкаНДС <> СтрокаСсылки.СтавкаНДС);
		ЕстьИзменение = ЕстьИзменение Или (СтрокаОбъекта.тек_СобственностьКТК <> СтрокаСсылки.ВидСобственности);
		ЕстьИзменение = ЕстьИзменение Или (СтрокаОбъекта.тек_Примечание <> СтрокаСсылки.Комментарий);
		ЕстьИзменение = ЕстьИзменение Или (СтрокаОбъекта.ИнструкцииПоСдаче <> СтрокаСсылки.ИнструкцииПоСдаче);
		//ЕстьИзменение = ЕстьИзменение Или ЕстьИзмененияВКонтейнерах(СтрокаОбъекта, СтрокаСсылки);
		
		Если ЕстьИзменение Тогда
			ИдентификаторыСтрок.Добавить(СтрокаОбъекта.ИдентификаторСтрокиУслуг);
		КонецЕсли;
		
	КонецЦикла;
	
	СтрокиСИзмененнымиСтавками = ЕстьИзмененияВСтавках(ДокументОбъект);
	
	СтрокиСИзменненнымиКонтейнерами = ЕстьИзмененияВКонтейнерах(ДокументОбъект);
	
	Для Каждого СтрокаСсылки Из СтрокиСИзменненнымиКонтейнерами Цикл
		ИдентификаторыСтрок.Добавить(СтрокаСсылки);
	КонецЦикла;
	
	Для Каждого ИдентификаторСтрокиГдеИзменитсяСтавка Из СтрокиСИзмененнымиСтавками Цикл
		ИдентификаторыСтрок.Добавить(ИдентификаторСтрокиГдеИзменитсяСтавка);
	КонецЦикла;
	
	// Строки к удалению
	Для Каждого СтрокаСсылки Из ВыгрузкаДанныеСсылки Цикл
		НайденныеСтроки = ВыгрузкаДанныеОбъекта.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", СтрокаСсылки.ИдентификаторСтрокиУслуг));
		Если НайденныеСтроки.Количество() = 0 Тогда
			ИдентификаторыСтрок.Добавить(СтрокаСсылки.ИдентификаторСтрокиУслуг);
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РелизСобственникаНоминации.Ссылка КАК РелизСобственника,
	|	РелизСобственникаНоминации.ИдентификаторСтрокиПСЦПоставщика КАК ИдентификаторСтрокиПСЦПоставщика
	|ИЗ
	|	Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	|ГДЕ
	|	РелизСобственникаНоминации.ИдентификаторСтрокиПСЦПоставщика В(&ИдентификаторСтрокиПСЦПоставщика)
	|	И НЕ РелизСобственникаНоминации.Ссылка.ПометкаУдаления
	|	И РелизСобственникаНоминации.Ссылка.НаОсновании
	|	И РелизСобственникаНоминации.Ссылка.ПСЦ = &ПСЦ";
	
	Запрос.УстановитьПараметр("ИдентификаторСтрокиПСЦПоставщика", ИдентификаторыСтрок);
	Запрос.УстановитьПараметр("ПСЦ", ДокументОбъект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	// Релизы которые будут изменены
	Пока Выборка.Следующий() Цикл
		СписокРелизовКИзменению.Добавить(Выборка.РелизСобственника);
	КонецЦикла;
	
	// Новая строка которая подходит по параметрам к определенному релизу, если не найдется подходящий создастся новый
	Для Каждого Строка Из ИдентификаторыНовыхСтрок Цикл
		ПараметрыПоиска = Новый Структура;
		ПараметрыПоиска.Вставить("Контрагент", ДокументОбъект.Контрагент);
		ПараметрыПоиска.Вставить("Договор", ДокументОбъект.Договор);
		ПараметрыПоиска.Вставить("Организация", ДокументОбъект.Организация);
		ПараметрыПоиска.Вставить("ЦФО", ДокументОбъект.ЦФО);
		Если НЕ ЗначениеЗаполнено(Строка.ТипКТК) Тогда
			НайденнаяСтрока = ДокументОбъект.Услуги.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", Строка.ИдентификаторСтрокиУслуг));
			ТипоразмерыКТК = НайденнаяСтрока[0].ТипоразмерыКТК.ВыгрузитьЗначения();
			ПараметрыПоиска.Вставить("ТипКТК", ТипоразмерыКТК[0].Ссылка);
		Иначе
			ПараметрыПоиска.Вставить("ТипКТК", Строка.ТипКТК);
		КонецЕсли;
		Если ЗначениеЗаполнено(Строка.Сток) Тогда
			ПараметрыПоиска.Вставить("ЛокацияГород", Строка.Сток);
		Иначе
			ПараметрыПоиска.Вставить("ЛокацияСтрана", Строка.Локация);
		КонецЕсли;
		ПараметрыПоиска.Вставить("ЛокацияСдачи", Строка.ЛокацияСдачи);
		ПараметрыПоиска.Вставить("ВозможныеСтокиСдачи", Строка.ВозможныеСтокиСдачи);
		ПараметрыПоиска.Вставить("Сток", Строка.ПунктОтправления);
		ПараметрыПоиска.Вставить("тек_СобственностьКТК", Строка.тек_СобственностьКТК);
		Релиз = Документы.РелизСобственника.НайтиРелизПоПараметрам(ПараметрыПоиска, ДокументОбъект.Ссылка);
		Если Релиз <> Неопределено Тогда
			СписокРелизовКИзменению.Добавить(Релиз);
		Иначе
			СписокРелизовКИзменению.Добавить("Будут созданы дополнительные релизы");
		КонецЕсли;
	КонецЦикла;
	
	СписокРелизовКИзменению = ОбщегоНазначенияКлиентСервер.СвернутьМассив(СписокРелизовКИзменению);
	
	Возврат СписокРелизовКИзменению;
	
КонецФункции

Функция ЕстьИзмененияВСтавках(ДокументОбъект)
	
	Результат = Новый Массив;
	
	ЗапросТекущиеДанныеСтавкиСНП = Новый Запрос;
	ЗапросТекущиеДанныеСтавкиСНП.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПСЦПоставщикаШкалаСтавок.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ПСЦПоставщикаШкалаСтавок.От КАК От,
	|	ПСЦПоставщикаШкалаСтавок.До КАК До,
	|	ПСЦПоставщикаШкалаСтавок.СтоимостьБезНДС КАК СтоимостьБезНДС
	|ПОМЕСТИТЬ ВТ_ПСЦПоставщикаШкалаСтавок
	|ИЗ
	|	&ПСЦПоставщикаШкалаСтавок КАК ПСЦПоставщикаШкалаСтавок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ПСЦПоставщикаУслуги.СтоимостьБезНДС КАК СтоимостьБезНДС,
	|	ПСЦПоставщикаУслуги.СтавкаПрогрессивная КАК СтавкаПрогрессивная,
	|	ПСЦПоставщикаУслуги.Номенклатура КАК Номенклатура,
	|	ПСЦПоставщикаУслуги.ПунктОтправленияСтрана КАК ПунктОтправленияСтрана,
	|	ПСЦПоставщикаУслуги.ПунктОтправленияГород КАК ПунктОтправленияГород,
	|	ПСЦПоставщикаУслуги.ПунктНазначенияСтрана КАК ПунктНазначенияСтрана,
	|	ПСЦПоставщикаУслуги.ПунктНазначенияГород КАК ПунктНазначенияГород,
	|	ПСЦПоставщикаУслуги.ПунктОтправления КАК ПунктОтправления
	|ПОМЕСТИТЬ ВТ_ПСЦПоставщикаУслуги
	|ИЗ
	|	&ПСЦПоставщикаУслуги КАК ПСЦПоставщикаУслуги
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПСЦПоставщикаКритерииУслуг.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ПСЦПоставщикаКритерииУслуг.ТипоразмерКТК КАК ТипоразмерКТК
	|ПОМЕСТИТЬ ВТ_ПСЦПоставщикаКритерииУслуг
	|ИЗ
	|	&ПСЦПоставщикаКритерииУслуг КАК ПСЦПоставщикаКритерииУслуг
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	1 КАК Идентификатор,
	|	ВТ_ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ВТ_ПСЦПоставщикаУслуги.СтоимостьБезНДС КАК СтоимостьБезНДС,
	|	ПСЦПоставщикаШкалаСтавок.От КАК От,
	|	ПСЦПоставщикаШкалаСтавок.До КАК До,
	|	ПСЦПоставщикаШкалаСтавок.СтоимостьБезНДС КАК ШкалаСтоимостьБезНДС,
	|	ВТ_ПСЦПоставщикаУслуги.СтавкаПрогрессивная КАК СтавкаПрогрессивная,
	|	ВТ_ПСЦПоставщикаКритерииУслуг.ТипоразмерКТК КАК ТипоразмерКТК,
	|	ВТ_ПСЦПоставщикаУслуги.ПунктОтправленияСтрана КАК ПунктОтправленияСтрана,
	|	ВТ_ПСЦПоставщикаУслуги.ПунктОтправленияГород КАК ПунктОтправленияГород,
	|	ВТ_ПСЦПоставщикаУслуги.ПунктНазначенияСтрана КАК ПунктНазначенияСтрана,
	|	ВТ_ПСЦПоставщикаУслуги.ПунктНазначенияГород КАК ПунктНазначенияГород,
	|	ВТ_ПСЦПоставщикаУслуги.ПунктОтправления КАК ПунктОтправления
	|ПОМЕСТИТЬ ВТ_ПСЦПоставщикаДанные
	|ИЗ
	|	ВТ_ПСЦПоставщикаУслуги КАК ВТ_ПСЦПоставщикаУслуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПСЦПоставщикаШкалаСтавок КАК ПСЦПоставщикаШкалаСтавок
	|		ПО (ПСЦПоставщикаШкалаСтавок.ИдентификаторСтрокиУслуг = ВТ_ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПСЦПоставщикаКритерииУслуг КАК ВТ_ПСЦПоставщикаКритерииУслуг
	|		ПО (ВТ_ПСЦПоставщикаКритерииУслуг.ИдентификаторСтрокиУслуг = ВТ_ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг)
	|ГДЕ
	|	ВТ_ПСЦПоставщикаУслуги.Номенклатура В(&Номенклатура)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	-1,
	|	ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг,
	|	ПСЦПоставщикаУслуги.СтоимостьБезНДС,
	|	ПСЦПоставщикаШкалаСтавок.От,
	|	ПСЦПоставщикаШкалаСтавок.До,
	|	ПСЦПоставщикаШкалаСтавок.СтоимостьБезНДС,
	|	ПСЦПоставщикаУслуги.СтавкаПрогрессивная,
	|	ПСЦПоставщикаКритерииУслуг.ТипоразмерКТК,
	|	ПСЦПоставщикаУслуги.ПунктОтправленияСтрана КАК ПунктОтправленияСтрана,
	|	ПСЦПоставщикаУслуги.ПунктОтправленияГород КАК ПунктОтправленияГород,
	|	ПСЦПоставщикаУслуги.ПунктНазначенияСтрана КАК ПунктНазначенияСтрана,
	|	ПСЦПоставщикаУслуги.ПунктНазначенияГород КАК ПунктНазначенияГород,
	|	ПСЦПоставщикаУслуги.ПунктОтправления КАК ПунктОтправления
	|ИЗ
	|	Документ.ПСЦПоставщика.Услуги КАК ПСЦПоставщикаУслуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПСЦПоставщика.ШкалаСтавок КАК ПСЦПоставщикаШкалаСтавок
	|		ПО (ПСЦПоставщикаШкалаСтавок.ИдентификаторСтрокиУслуг = ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПСЦПоставщика.КритерииУслуг КАК ПСЦПоставщикаКритерииУслуг
	|		ПО (ПСЦПоставщикаКритерииУслуг.ИдентификаторСтрокиУслуг = ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг)
	|ГДЕ
	|	ПСЦПоставщикаУслуги.Номенклатура В(&Номенклатура)
	|	И ПСЦПоставщикаУслуги.Ссылка = &Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СУММА(ВТ_ПСЦПоставщикаДанные.Идентификатор) КАК Идентификатор,
	|	ВТ_ПСЦПоставщикаДанные.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ВТ_ПСЦПоставщикаДанные.СтоимостьБезНДС КАК СтоимостьБезНДС,
	|	ВТ_ПСЦПоставщикаДанные.От КАК От,
	|	ВТ_ПСЦПоставщикаДанные.До КАК До,
	|	ВТ_ПСЦПоставщикаДанные.СтоимостьБезНДС КАК ШкалаСтоимостьБезНДС,
	|	ВТ_ПСЦПоставщикаДанные.СтавкаПрогрессивная КАК СтавкаПрогрессивная,
	|	ВТ_ПСЦПоставщикаДанные.ТипоразмерКТК КАК ТипоразмерКТК,
	|	ВТ_ПСЦПоставщикаДанные.ПунктОтправленияСтрана КАК ПунктОтправленияСтрана,
	|	ВТ_ПСЦПоставщикаДанные.ПунктОтправленияГород КАК ПунктОтправленияГород,
	|	ВТ_ПСЦПоставщикаДанные.ПунктНазначенияСтрана КАК ПунктНазначенияСтрана,
	|	ВТ_ПСЦПоставщикаДанные.ПунктНазначенияГород КАК ПунктНазначенияГород,
	|	ВТ_ПСЦПоставщикаДанные.ПунктОтправления КАК ПунктОтправления
	|ИЗ
	|	ВТ_ПСЦПоставщикаДанные КАК ВТ_ПСЦПоставщикаДанные
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПСЦПоставщикаДанные.ИдентификаторСтрокиУслуг,
	|	ВТ_ПСЦПоставщикаДанные.СтоимостьБезНДС,
	|	ВТ_ПСЦПоставщикаДанные.От,
	|	ВТ_ПСЦПоставщикаДанные.До,
	|	ВТ_ПСЦПоставщикаДанные.СтавкаПрогрессивная,
	|	ВТ_ПСЦПоставщикаДанные.ТипоразмерКТК,
	|	ВТ_ПСЦПоставщикаДанные.СтоимостьБезНДС,
	|	ВТ_ПСЦПоставщикаДанные.ПунктОтправленияСтрана,
	|	ВТ_ПСЦПоставщикаДанные.ПунктОтправленияГород,
	|	ВТ_ПСЦПоставщикаДанные.ПунктНазначенияСтрана,
	|	ВТ_ПСЦПоставщикаДанные.ПунктНазначенияГород,
	|	ВТ_ПСЦПоставщикаДанные.ПунктОтправления
	|
	|ИМЕЮЩИЕ
	|	СУММА(ВТ_ПСЦПоставщикаДанные.Идентификатор) <> 0";
	
	МассивНоменклатур = Новый Массив;
	МассивНоменклатур.Добавить(Справочники.Номенклатура.СНПКонтейнеров);
	
	ПСЦУслуги = ДокументОбъект.Услуги.Выгрузить();
	
	ЗапросТекущиеДанныеСтавкиСНП.УстановитьПараметр("Документ", ДокументОбъект.Ссылка);
	ЗапросТекущиеДанныеСтавкиСНП.УстановитьПараметр("Номенклатура", МассивНоменклатур);
	ЗапросТекущиеДанныеСтавкиСНП.УстановитьПараметр("ПСЦПоставщикаКритерииУслуг", ДокументОбъект.КритерииУслуг.Выгрузить());
	ЗапросТекущиеДанныеСтавкиСНП.УстановитьПараметр("ПСЦПоставщикаШкалаСтавок", ДокументОбъект.ШкалаСтавок.Выгрузить());
	ЗапросТекущиеДанныеСтавкиСНП.УстановитьПараметр("ПСЦПоставщикаУслуги", ПСЦУслуги);
	
	ВыгрузкаДанныеПСЦ = ЗапросТекущиеДанныеСтавкиСНП.Выполнить().Выгрузить();
	
	ТипоразмерыКТК = Новый Массив;
	
	Для Каждого СтрокаПСЦ Из ВыгрузкаДанныеПСЦ Цикл
		Если ЗначениеЗаполнено(СтрокаПСЦ.ТипоразмерКТК) Тогда
			РезультатПоиска = ТипоразмерыКТК.Найти(СтрокаПСЦ.ТипоразмерКТК);
			Если РезультатПоиска = Неопределено Тогда
				ТипоразмерыКТК.Добавить(СтрокаПСЦ.ТипоразмерКТК);
			КонецЕсли;
		Иначе
			Для Каждого СтрокаУслуг Из ПСЦУслуги Цикл
				Если СтрокаУслуг.ИдентификаторСтрокиУслуг = СтрокаПСЦ.ИдентификаторСтрокиУслуг 
					И СтрокаУслуг.ТипоразмерыКТК.Количество() > 0 Тогда
					МассивТипоразмеровСтроки = СтрокаУслуг.ТипоразмерыКТК.ВыгрузитьЗначения();
					Для Каждого Типоразмер Из МассивТипоразмеровСтроки Цикл
						РезультатПоиска = ТипоразмерыКТК.Найти(Типоразмер);
						Если РезультатПоиска = Неопределено Тогда
							ТипоразмерыКТК.Добавить(Типоразмер);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	ЗапросДанныеСтавкиСНПВРелизах = Новый Запрос;
	ЗапросДанныеСтавкиСНПВРелизах.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РелизСобственникаНоминации.ИдентификаторСтрокиПСЦПоставщика КАК ИдентификаторСтрокиПСЦПоставщика
	|ИЗ
	|	Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РелизСобственника КАК РелизСобственника
	|		ПО РелизСобственникаНоминации.Ссылка = РелизСобственника.Ссылка
	|ГДЕ
	|	РелизСобственникаНоминации.ТипКТК В(&ТипоразмерыКТК)
	|	И РелизСобственника.ПСЦ = &Документ
	|	И НЕ РелизСобственника.ПометкаУдаления";
	
	ЗапросДанныеСтавкиСНПВРелизах.УстановитьПараметр("Документ", ДокументОбъект.Ссылка);
	ЗапросДанныеСтавкиСНПВРелизах.УстановитьПараметр("ТипоразмерыКТК", ТипоразмерыКТК);
	
	РезультатЗапроса = ЗапросДанныеСтавкиСНПВРелизах.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.ИдентификаторСтрокиПСЦПоставщика);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция НаОснованииДокументаСозданыРелизы(ДокументСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РелизСобственника.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РелизСобственника КАК РелизСобственника
	|ГДЕ
	|	РелизСобственника.ПСЦ = &ПСЦ
	|	И РелизСобственника.Проведен
	|	И НЕ РелизСобственника.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ПСЦ", ДокументСсылка);

	Ответ = Ложь;
	
	Если НЕ Запрос.Выполнить().Пустой() Тогда
		Ответ = Истина;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

Функция ЕстьИзмененияВКонтейнерах(ДокументОбъект) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг
	|ПОМЕСТИТЬ ВТ_ПСЦУслуги
	|ИЗ
	|	&ПСЦПоставщикаУслуги КАК ПСЦПоставщикаУслуги
	|ГДЕ
	|	ПСЦПоставщикаУслуги.Номенклатура В(&Номенклатура)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	УчетныеЕдиницы.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	УчетныеЕдиницы.УчетнаяЕдиница КАК УчетнаяЕдиница
	|ПОМЕСТИТЬ ВТ_УчетнаяЕдиницы
	|ИЗ
	|	&УчетныеЕдиницы КАК УчетныеЕдиницы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КритерииУслуг.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	КритерииУслуг.ТипоразмерКТК КАК ТипоразмерКТК
	|ПОМЕСТИТЬ ВТ_КритерииУслуг
	|ИЗ
	|	&КритерииУслуг КАК КритерииУслуг
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	1 КАК Идентификатор,
	|	ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ПСЦПоставщикаУчетныеЕдиницы.УчетнаяЕдиница КАК УчетнаяЕдиница,
	|	ПСЦПоставщикаКритерииУслуг.ТипоразмерКТК
	|ПОМЕСТИТЬ ВТ_ВременнаяТаблица
	|ИЗ
	|	ВТ_ПСЦУслуги КАК ПСЦПоставщикаУслуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_УчетнаяЕдиницы КАК ПСЦПоставщикаУчетныеЕдиницы
	|		ПО ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг = ПСЦПоставщикаУчетныеЕдиницы.ИдентификаторСтрокиУслуг
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КритерииУслуг КАК ПСЦПоставщикаКритерииУслуг
	|		ПО ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг = ПСЦПоставщикаКритерииУслуг.ИдентификаторСтрокиУслуг
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	-1,
	|	ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг,
	|	ПСЦПоставщикаУчетныеЕдиницы.УчетнаяЕдиница,
	|	ПСЦПоставщикаКритерииУслуг.ТипоразмерКТК
	|ИЗ
	|	Документ.ПСЦПоставщика.Услуги КАК ПСЦПоставщикаУслуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПСЦПоставщика.УчетныеЕдиницы КАК ПСЦПоставщикаУчетныеЕдиницы
	|		ПО ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг = ПСЦПоставщикаУчетныеЕдиницы.ИдентификаторСтрокиУслуг
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПСЦПоставщика.КритерииУслуг КАК ПСЦПоставщикаКритерииУслуг
	|		ПО ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг = ПСЦПоставщикаКритерииУслуг.ИдентификаторСтрокиУслуг
	|ГДЕ
	|	ПСЦПоставщикаУслуги.Ссылка = &Документ
	|	И ПСЦПоставщикаУслуги.Номенклатура В(&Номенклатура)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ВременнаяТаблица.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ВТ_ВременнаяТаблица.УчетнаяЕдиница КАК УчетнаяЕдиница, 
	|	ВТ_ВременнаяТаблица.ТипоразмерКТК КАК ТипоразмерКТК
	|ИЗ
	|	ВТ_ВременнаяТаблица КАК ВТ_ВременнаяТаблица
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ВременнаяТаблица.ИдентификаторСтрокиУслуг,
	|	ВТ_ВременнаяТаблица.УчетнаяЕдиница,
	|    ВТ_ВременнаяТаблица.ТипоразмерКТК
	|ИМЕЮЩИЕ
	|	СУММА(ВТ_ВременнаяТаблица.Идентификатор) <> 0";
	
	МассивНоменклатур = Новый Массив;
	МассивНоменклатур.Добавить(Справочники.Номенклатура.АрендаКонтейнеров);
	МассивНоменклатур.Добавить(Справочники.Номенклатура.ПредоставлениеКТК);
	
	Запрос.УстановитьПараметр("Номенклатура", МассивНоменклатур);
	Запрос.УстановитьПараметр("Документ", ДокументОбъект.Ссылка);
	Запрос.УстановитьПараметр("ПСЦПоставщикаУслуги", ДокументОбъект.Услуги.Выгрузить());
	Запрос.УстановитьПараметр("УчетныеЕдиницы", ДокументОбъект.УчетныеЕдиницы.Выгрузить());
	Запрос.УстановитьПараметр("КритерииУслуг", ДокументОбъект.КритерииУслуг.Выгрузить());
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Ответ = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		Элемент = Ответ.Найти(Выборка.ИдентификаторСтрокиУслуг);
		Если Элемент = Неопределено Тогда
			Ответ.Добавить(Выборка.ИдентификаторСтрокиУслуг);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ответ;
	
КонецФункции

Функция ЕстьРелизСобственника(ДокументОснование) Экспорт
	
	Ответ = Ложь;
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РелизСобственника.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РелизСобственника КАК РелизСобственника
		|ГДЕ
		|	РелизСобственника.ПСЦ = &Документ
		|	И НЕ РелизСобственника.ПометкаУдаления
		|	И РелизСобственника.НаОсновании";
		
		Запрос.УстановитьПараметр("Документ", ДокументОснование);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Ответ = Истина;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции
