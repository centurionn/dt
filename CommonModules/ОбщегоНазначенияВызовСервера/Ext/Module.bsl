//ДИТ, Беляев СЮ, TA48059, 12-04-2022, начало
Функция РасчетныйСчетПоДоговору(Договор, Знач ПроверяемаяДата = неопределено) Экспорт
	Результат = Справочники.БанковскиеСчета.ПустаяСсылка();  
	
	Если НЕ ЗначениеЗаполнено(Договор) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ПроверяемаяДата = неопределено Тогда 
		ПроверяемаяДата = ТекущаяДата(); 
	КонецЕсли;	
	
	//1) если в договоре контрагента выбран счет, то используем его
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДоговорыКонтрагентовБанковскиеРеквизитыДляОплаты.РасчетныйСчет КАК РасчетныйСчет
	               |ИЗ
	               |	Справочник.ДоговорыКонтрагентов.БанковскиеРеквизитыДляОплаты КАК ДоговорыКонтрагентовБанковскиеРеквизитыДляОплаты
	               |ГДЕ
	               |	ДоговорыКонтрагентовБанковскиеРеквизитыДляОплаты.Ссылка = &Ссылка
	               |	И ДоговорыКонтрагентовБанковскиеРеквизитыДляОплаты.ДействуетС <= &ПроверяемаяДата
	               |	И (ДоговорыКонтрагентовБанковскиеРеквизитыДляОплаты.ДействуетПо > &ПроверяемаяДата
	               |			ИЛИ ДоговорыКонтрагентовБанковскиеРеквизитыДляОплаты.ДействуетПо = ДАТАВРЕМЯ(1, 1, 1))
	               |	И ДоговорыКонтрагентовБанковскиеРеквизитыДляОплаты.РасчетныйСчет.ВалютаДенежныхСредств = ДоговорыКонтрагентовБанковскиеРеквизитыДляОплаты.Ссылка.ВалютаВзаиморасчетов
	               |	И НЕ ДоговорыКонтрагентовБанковскиеРеквизитыДляОплаты.РасчетныйСчет.ПометкаУдаления";
	Запрос.УстановитьПараметр("Ссылка", Договор);
	Запрос.УстановитьПараметр("ПроверяемаяДата", ПроверяемаяДата);  
	МассивСчетовИзДоговора = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("РасчетныйСчет");
	Если МассивСчетовИзДоговора.Количество() = 1 Тогда 
		//нашли по валюте, дублей нет
		Результат = МассивСчетовИзДоговора[0];
	КонецЕсли;
	
	//2) поиск в счетах Организации 
	//идём в договор берём валюту расчёта (с учетом галки "УЕ", если "УЕ", то берем рубли),
	//по ней берём основной банк. счёт  этой валюты и его автоматически подставляем в документ счёт на оплату клиента.
	Если Результат = Справочники.БанковскиеСчета.ПустаяСсылка() Тогда	 
		РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор,"РасчетыВУсловныхЕдиницах, ВалютаВзаиморасчетов, Организация");
		РасчетыВУсловныхЕдиницах = РеквизитыДоговора.РасчетыВУсловныхЕдиницах;
		Валюта = Справочники.Валюты.Рубль; //установим сразу РУБ.
		Если НЕ РасчетыВУсловныхЕдиницах Тогда //галки РасчетыВУсловныхЕдиницах нет, берем валюту из договора
			Валюта = РеквизитыДоговора.ВалютаВзаиморасчетов;
		КонецЕсли;
		Организация = РеквизитыДоговора.Организация; 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	БанковскиеСчета.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.БанковскиеСчета КАК БанковскиеСчета
		|ГДЕ
		|	БанковскиеСчета.Владелец = &Организация
		|	И БанковскиеСчета.ВалютаДенежныхСредств = &Валюта
		|	И НЕ БанковскиеСчета.ПометкаУдаления
		|	И БанковскиеСчета.Основной";
		Запрос.УстановитьПараметр("Валюта", Валюта);
		Запрос.УстановитьПараметр("Организация", Организация);
		РезультатЗапроса = Запрос.Выполнить();
		МассивСчетовОрганизации = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");    
		Если МассивСчетовОрганизации.Количество() = 1 Тогда 
			//нашли по валюте, дублей нет
			Результат = МассивСчетовОрганизации[0];
		КонецЕсли;  
  	КонецЕсли;   
	
	Возврат Результат;
КонецФункции    
