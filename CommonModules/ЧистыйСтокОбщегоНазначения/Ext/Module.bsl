		|	ВТ_ПоискПредыдущегоПрихода.Статус КАК Статус,
		|	ВТ_ПоискПредыдущегоПрихода.ДатаОперацииПрихода КАК ДатаОперацииПрихода,
		|	МестонахождениеЧистыйСтокОстаткиИОбороты.КоличествоКонечныйОстаток КАК КоличествоОстаток,
		|	ДанныеПоОперациямЧистыйСток.Состояние КАК СостояниеПриход,
		|	ДанныеПоОперациямЧистыйСток.ДатаОбновленияИнформации КАК ДатаОбновленияИнформации,
		|	ДанныеПоОперациямЧистыйСток.ТерминальнаяУслуга КАК ТерминальнаяУслуга,
		|	ДанныеПоОперациямЧистыйСток.НаличиеПодвреждения КАК НаличиеПодвреждения,
		|	ДанныеПоОперациямЧистыйСток.ЗаявкаНаВыдачу КАК ЗаявкаНаВыдачу,
		|	ДанныеПоОперациямЧистыйСток.КомментарийТерминала КАК КомментарийТерминала,
		|	ДанныеПоОперациямЧистыйСток.ЗаявкаНаСдачу КАК ЗаявкаНаСдачу,
		|	ДанныеПоОперациямЧистыйСток.КомментарийСотрудника КАК КомментарийСотрудника,
		|	ДанныеПоОперациямЧистыйСток.ИсточникДобавленияДанных КАК ИсточникДобавленияДанных,
		|	ДанныеПоОперациямЧистыйСток.ВидТранспортаУбытия КАК ВидТранспортаУбытия,
		|	ДанныеПоОперациямЧистыйСток.ФИОВодителя КАК ФИОВодителя,
		|	ДанныеПоОперациямЧистыйСток.НомерТранспорта КАК НомерТранспорта,
		|	ДанныеПоОперациямЧистыйСток.ВидТранспорта КАК ВидТранспорта,
		|	ДанныеПоОперациямЧистыйСток.ОтветственныйЗаЗагрузку КАК ОтветственныйЗаЗагрузку,
		|	ДанныеПоОперациямЧистыйСток.Станция КАК Станция,
		|	ДанныеПоОперациямЧистыйСток.Контрагент КАК Контрагент,
		|	ДанныеПоОперациямЧистыйСток.Комбинированная КАК Комбинированная
		|ИЗ
		|	ВТ_ПоискПредыдущегоПрихода КАК ВТ_ПоискПредыдущегоПрихода
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеПоОперациямЧистыйСток КАК ДанныеПоОперациямЧистыйСток
		|		ПО (ДанныеПоОперациямЧистыйСток.Контейнер = ВТ_ПоискПредыдущегоПрихода.Контейнер)
		|			И (ДанныеПоОперациямЧистыйСток.ДатаОперации = ВТ_ПоискПредыдущегоПрихода.ДатаОперацииПрихода)
		//|			И (ДанныеПоОперациямЧистыйСток.ИсточникДобавленияДанных = ЗНАЧЕНИЕ(Справочник.ИсточникиДанныхЧистогоСтока.ИнформацияОтАвтоподрядчиков))
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.МестонахождениеЧистыйСток.ОстаткиИОбороты(
		|				,
		|				,
		|				Регистратор,
		|				,
		|				(Контейнер, Терминал) В
		|					(ВЫБРАТЬ
		|						Т.Контейнер,
		|						Т.Терминал
		|					ИЗ
		|						ВТ_ПоискПредыдущегоПрихода КАК Т)) КАК МестонахождениеЧистыйСтокОстаткиИОбороты
		|		ПО (МестонахождениеЧистыйСтокОстаткиИОбороты.Контейнер = ВТ_ПоискПредыдущегоПрихода.Контейнер)
		|			И ВТ_ПоискПредыдущегоПрихода.Терминал = МестонахождениеЧистыйСтокОстаткиИОбороты.Терминал
		|			И (МестонахождениеЧистыйСтокОстаткиИОбороты.Период = ВТ_ПоискПредыдущегоПрихода.ДатаОперацииПрихода)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.МестонахождениеЧистыйСток КАК МестонахождениеЧистыйСток
		|		ПО (МестонахождениеЧистыйСток.Контейнер = ВТ_ПоискПредыдущегоПрихода.Контейнер)
		|			И ВТ_ПоискПредыдущегоПрихода.Терминал = МестонахождениеЧистыйСток.Терминал
		|			И (МестонахождениеЧистыйСток.Период = ВТ_ПоискПредыдущегоПрихода.ДатаОперации)
		|			И (МестонахождениеЧистыйСток.ИсточникДобавленияДанных = ЗНАЧЕНИЕ(Справочник.ИсточникиДанныхЧистогоСтока.ТехническаяЗапись))
		|ГДЕ
		|	МестонахождениеЧистыйСтокОстаткиИОбороты.КоличествоКонечныйОстаток > 0
		|	И МестонахождениеЧистыйСток.ИсточникДобавленияДанных ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("СрокПодтверждения", СрокПодтвержденияИнформации);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	РезультатыЗапросов = Запрос.ВыполнитьПакет();
	
	ВыборкаНеподтвержденныеЗавоз = РезультатыЗапросов[6].Выбрать(); 
	ВыборкаНеподтвержденныеВывоз = РезультатыЗапросов[9].Выбрать();
	ВыборкаПодтвержденные = РезультатыЗапросов[7].Выбрать(); 
	ВыборкаСтрокиИсключения = РезультатыЗапросов[8].Выбрать(); 
	
	Пока ВыборкаСтрокиИсключения.Следующий() Цикл  
		
		//в РС ИнформацияОтАвтоподрядчиковПоТерминалам делаем пометку, что не требуется подтверждение
		НЗ = РегистрыСведений.ИнформацияОтАвтоподрядчиковПоТерминалам.СоздатьНаборЗаписей();
		НЗ.Отбор.ДатаОперации.Установить(ВыборкаСтрокиИсключения.ДатаОперации); 
		НЗ.Отбор.Терминал.Установить(ВыборкаСтрокиИсключения.Терминал);
		НЗ.Отбор.Контейнер.Установить(ВыборкаСтрокиИсключения.Контейнер);   
		НЗ.Прочитать();
		Для каждого СтрокаНЗ Из НЗ Цикл
			СтрокаНЗ.ТребуетсяПодтверждениеОперацииАвтоподрядчика = Ложь;
		КонецЦикла;
		НЗ.ОбменДанными.Загрузка = Истина;
		НЗ.Записать();
		
		//информацию по завозу убираем из РС ДанныеПоОперациямЧистыйСтокАктуальный
		НЗ = РегистрыСведений.ДанныеПоОперациямЧистыйСтокАктуальный.СоздатьНаборЗаписей();
		НЗ.Отбор.ДатаОперации.Установить(ВыборкаСтрокиИсключения.ДатаОперации); 
		НЗ.Отбор.Терминал.Установить(ВыборкаСтрокиИсключения.Терминал);
		НЗ.Отбор.Контейнер.Установить(ВыборкаСтрокиИсключения.Контейнер);  
		НЗ.Прочитать(); 
		Если НЗ.Количество() > 0 и НЗ[0].Количество > 1 Тогда
			НЗ[0].Количество = НЗ[0].Количество - 1;
		Иначе
			НЗ.Очистить();	
		КонецЕсли;
		НЗ.Записать();
	КонецЦикла;
	
	Пока ВыборкаПодтвержденные.Следующий() Цикл
		//в РС ИнформацияОтАвтоподрядчиковПоТерминалам делаем пометку, что не требуется подтверждение
		НЗ = РегистрыСведений.ИнформацияОтАвтоподрядчиковПоТерминалам.СоздатьНаборЗаписей();
		НЗ.Отбор.ДатаОперации.Установить(ВыборкаПодтвержденные.ДатаОперации); 
		НЗ.Отбор.Терминал.Установить(ВыборкаПодтвержденные.Терминал);
		НЗ.Отбор.Контейнер.Установить(ВыборкаПодтвержденные.Контейнер);   
		НЗ.Прочитать();
		Для каждого СтрокаНЗ Из НЗ Цикл
			СтрокаНЗ.ТребуетсяПодтверждениеОперацииАвтоподрядчика = Ложь;
		КонецЦикла;
		НЗ.ОбменДанными.Загрузка = Истина;
		НЗ.Записать(); 
		
		//Убираем ошибку при загрузке информации от терминалов из записей от автоперевозчика
		НаборИсточника = РегистрыСведений.ИнформацияОтАвтоподрядчиковПоТерминалам.СоздатьНаборЗаписей();
		НаборИсточника.Отбор.Контейнер.Установить(ВыборкаПодтвержденные.Контейнер);
		НаборИсточника.Отбор.ДатаОперации.Установить(ВыборкаПодтвержденные.ДатаОперации);
		НаборИсточника.Отбор.Терминал.Установить(ВыборкаПодтвержденные.Терминал);
		НаборИсточника.Прочитать();
		
		Если НаборИсточника.Количество() = 1 Тогда
			СтрокаИсточника = НаборИсточника[0];  
			Если ЗначениеЗаполнено(СтрокаИсточника.ОшибкиПриЗагрузкеИнформацииОтТерминалов) Тогда 
				ОбъектОшибки = СтрокаИсточника.ОшибкиПриЗагрузкеИнформацииОтТерминалов.ПолучитьОбъект();  
				КоличествоСтрокИсправлено = 0;
				Для каждого СтрОшибки Из ОбъектОшибки.ОшибкиПриЗагрузке Цикл
					Если СтрОшибки.ТипОшибки = Перечисления.ОшибкиЗагрузкиСтоков.ИнформацияОтАвтоподрядчика Тогда
						СтрОшибки.Комментарий = "Запись подтверждена информацией от терминала";  
						КоличествоСтрокИсправлено = КоличествоСтрокИсправлено + 1;
					КонецЕсли;
				КонецЦикла; 
				Если КоличествоСтрокИсправлено = ОбъектОшибки.ОшибкиПриЗагрузке.Количество() Тогда
					ОбъектОшибки.ВсеОшибкиИсправлены = Истина; 
				КонецЕсли;
				ОбъектОшибки.Записать();
			КонецЕсли;
		КонецЕсли; 

	КонецЦикла;

	Пока ВыборкаНеподтвержденныеЗавоз.Следующий() Цикл 
		
		//Сторнируем местонахождение по завозу
		Параметры = Новый Структура("Контейнер,Терминал,ДатаОперации,КоличествоОстаток,ИсточникДобавленияДанных");  
		ЗаполнитьЗначенияСвойств(Параметры, ВыборкаНеподтвержденныеЗавоз); 
		Параметры.ИсточникДобавленияДанных = Справочники.ИсточникиДанныхЧистогоСтока.ТехническаяЗапись;
		Отказ = Ложь;  
		
		Попытка
			ДокументРедактирования = Документы.РедактированиеДанныхЧистогоСтока.ВвестиДокументСторно(Параметры,Отказ);
		Исключение
			ШаблонОшибки = СтрШаблон("Не удалось сформировать сторно Контейнер:%1 ,Терминал:%2, ДатаОперации:%3, КоличествоОстаток:%4",
			ВыборкаНеподтвержденныеЗавоз.Контейнер,ВыборкаНеподтвержденныеЗавоз.Терминал,
			ВыборкаНеподтвержденныеЗавоз.ДатаОперации,ВыборкаНеподтвержденныеЗавоз.КоличествоОстаток);
			ВызватьИсключение(ШаблонОшибки);
		КонецПопытки;
		
		//Запись ошибки
		НаборИсточника = РегистрыСведений.ИнформацияОтАвтоподрядчиковПоТерминалам.СоздатьНаборЗаписей();
		НаборИсточника.Отбор.Контейнер.Установить(ВыборкаНеподтвержденныеЗавоз.Контейнер);
		НаборИсточника.Отбор.ДатаОперации.Установить(ВыборкаНеподтвержденныеЗавоз.ДатаОперации);
		НаборИсточника.Отбор.Терминал.Установить(ВыборкаНеподтвержденныеЗавоз.Терминал);
		НаборИсточника.Прочитать();
		
		Если НаборИсточника.Количество() = 1 Тогда
			СтрокаИсточника = НаборИсточника[0];  
			Если Не ЗначениеЗаполнено(СтрокаИсточника.ОшибкиПриЗагрузкеИнформацииОтТерминалов) Тогда
				СправочникОшибки = Документы.ПереносДанныхВЧистыйСток.СоздатьСправочникОшибки(Перечисления.ОшибкиЗагрузкиСтоков.ИнформацияОтАвтоподрядчика, Истина);	
				СтрокаИсточника.ОшибкиПриЗагрузкеИнформацииОтТерминалов = СправочникОшибки;
				НаборИсточника.ОбменДанными.Загрузка = Истина;
				НаборИсточника.Записать();
			Иначе
				СтрокиОшибок = СтрокаИсточника.ОшибкиПриЗагрузкеИнформацииОтТерминалов.ОшибкиПриЗагрузке; 
				СтрокиОшибокАвтоподрядчиков = СтрокиОшибок.НайтиСтроки(Новый Структура("ТипОшибки", Перечисления.ОшибкиЗагрузкиСтоков.ИнформацияОтАвтоподрядчика)); 
				Если СтрокиОшибокАвтоподрядчиков.Количество() = 0 Тогда
					Документы.ПереносДанныхВЧистыйСток.ДополнитьСправочникОшибки(СтрокаИсточника.ОшибкиПриЗагрузкеИнформацииОтТерминалов,
					Перечисления.ОшибкиЗагрузкиСтоков.ИнформацияОтАвтоподрядчика, Истина);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли; 
		
		//убираем из РС ДанныеПоОперациямЧистыйСтокАктуальный
		ПараметрыЗаполненияРегистраАктуальный = Новый Структура("Терминал, Контейнер", 
															ВыборкаНеподтвержденныеЗавоз.Терминал,
															ВыборкаНеподтвержденныеЗавоз.Контейнер);
		Документы.ПереносДанныхВЧистыйСток.ЗаполнитьРегистрАктуальный(Неопределено, ПараметрыЗаполненияРегистраАктуальный);
		
	КонецЦикла;  
	
	Пока ВыборкаНеподтвержденныеВывоз.Следующий() Цикл  
		
		//Сторнируем местонахождение по вывозу
		Параметры = Новый Структура("Контейнер,Терминал,ДатаОперации,КоличествоОстаток,ИсточникДобавленияДанных");  
		ЗаполнитьЗначенияСвойств(Параметры, ВыборкаНеподтвержденныеВывоз); 
		Параметры.ИсточникДобавленияДанных = Справочники.ИсточникиДанныхЧистогоСтока.ТехническаяЗапись;
		Отказ = Ложь;  
		
		Попытка
			ДокументРедактирования = Документы.РедактированиеДанныхЧистогоСтока.ВвестиДокументСторно(Параметры,Отказ);
		Исключение
			ШаблонОшибки = СтрШаблон("Не удалось сформировать сторно Контейнер:%1 ,Терминал:%2, ДатаОперации:%3, КоличествоОстаток:%4",
			ВыборкаНеподтвержденныеВывоз.Контейнер,ВыборкаНеподтвержденныеВывоз.Терминал,
			ВыборкаНеподтвержденныеВывоз.ДатаОперации,ВыборкаНеподтвержденныеВывоз.КоличествоОстаток);
			ВызватьИсключение(ШаблонОшибки);
		КонецПопытки;
		
		//Запись ошибки
		НаборИсточника = РегистрыСведений.ИнформацияОтАвтоподрядчиковПоТерминалам.СоздатьНаборЗаписей();
		НаборИсточника.Отбор.Контейнер.Установить(ВыборкаНеподтвержденныеВывоз.Контейнер);
		НаборИсточника.Отбор.ДатаОперации.Установить(ВыборкаНеподтвержденныеВывоз.ДатаОперации);
		НаборИсточника.Отбор.Терминал.Установить(ВыборкаНеподтвержденныеВывоз.Терминал);
		НаборИсточника.Прочитать();
		
		Если НаборИсточника.Количество() = 1 Тогда
			СтрокаИсточника = НаборИсточника[0];  
			Если Не ЗначениеЗаполнено(СтрокаИсточника.ОшибкиПриЗагрузкеИнформацииОтТерминалов) Тогда
				СправочникОшибки = Документы.ПереносДанныхВЧистыйСток.СоздатьСправочникОшибки(Перечисления.ОшибкиЗагрузкиСтоков.ИнформацияОтАвтоподрядчика, Истина);	
				СтрокаИсточника.ОшибкиПриЗагрузкеИнформацииОтТерминалов = СправочникОшибки;
				НаборИсточника.ОбменДанными.Загрузка = Истина;
				НаборИсточника.Записать();
			Иначе
				СтрокиОшибок = СтрокаИсточника.ОшибкиПриЗагрузкеИнформацииОтТерминалов.ОшибкиПриЗагрузке; 
				СтрокиОшибокАвтоподрядчиков = СтрокиОшибок.НайтиСтроки(Новый Структура("ТипОшибки", Перечисления.ОшибкиЗагрузкиСтоков.ИнформацияОтАвтоподрядчика)); 
				Если СтрокиОшибокАвтоподрядчиков.Количество() = 0 Тогда
					Документы.ПереносДанныхВЧистыйСток.ДополнитьСправочникОшибки(СтрокаИсточника.ОшибкиПриЗагрузкеИнформацииОтТерминалов,
					Перечисления.ОшибкиЗагрузкиСтоков.ИнформацияОтАвтоподрядчика, Истина);
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;   
		
		//Восстановление наличия в актуальном, если был приход на Терминал до вывоза    
		ПараметрыЗаполненияРегистраАктуальный = Новый Структура("Терминал, Контейнер", 
															ВыборкаНеподтвержденныеВывоз.Терминал,
															ВыборкаНеподтвержденныеВывоз.Контейнер);
		Документы.ПереносДанныхВЧистыйСток.ЗаполнитьРегистрАктуальный(Неопределено, ПараметрыЗаполненияРегистраАктуальный);
		
	КонецЦикла;	
	
КонецПроцедуры
