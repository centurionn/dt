Процедура СформироватьДвиженияРазнесенияЗатратПТУ(ОбъектСделка) Экспорт 
	
	ОбъектСделка.Движения.РазнесениеЗатратПТУ.Записывать = Истина;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СделкаРасходы.ГУИД КАК ГУИД,
//	|	СделкаРасходы.ПериодВО КАК ПериодВО,
	|	ЕСТЬNULL(ТЕ.Ссылка, НЕОПРЕДЕЛЕНО) КАК Контейнер,
	|	ВЫБОР
	|		КОГДА СделкаРасходы.Количество <> 0
	|			ТОГДА СделкаРасходы.СуммаИтого / СделкаРасходы.Количество
	|		ИНАЧЕ СделкаРасходы.СуммаИтого
	|	КОНЕЦ КАК СуммаПодлежащаяРазнесению,
	|	СделкаРасходы.Регламентный КАК Регламентный
	|ИЗ
	|	Документ.Сделка.Расходы КАК СделкаРасходы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|		ПО СделкаРасходы.Ссылка = СделкаСвязьУчетныхЕдиниц.Ссылка
	|			И СделкаРасходы.СтрокаСвязьУчетныхЕдиниц = СделкаСвязьУчетныхЕдиниц.ГУИД
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.ДоходыКТК КАК СделкаДоходыКТК
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТЕ КАК ТЕ
	|			ПО (ПОДСТРОКА(СделкаДоходыКТК.КТК, 1, 11) = ТЕ.Наименование)
	|				И (НЕ ТЕ.ПометкаУдаления)
	|		ПО СделкаРасходы.ГУИД = СделкаДоходыКТК.ГУИД
	|ГДЕ
	|	СделкаРасходы.Ссылка = &Ссылка
	|	И СделкаРасходы.УслугаОтключена = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	СделкаРасходы.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", ОбъектСделка.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Движение = ОбъектСделка.Движения.РазнесениеЗатратПТУ.ДобавитьПриход();
		Движение.ГУИДРасходов = Выборка.ГУИД;
		Движение.КТК = Выборка.Контейнер;
		Движение.Период = ОбъектСделка.Дата;
		//Движение.ПериодВО = Выборка.ПериодВО;
		Движение.ПодлежащаяРазнесению = Выборка.СуммаПодлежащаяРазнесению;
		Движение.Регистратор = ОбъектСделка.Ссылка;
		Движение.Сделка = ОбъектСделка.Ссылка;
		Движение.Регламентный = Выборка.Регламентный;
		Движение.ПолностьюРазнесено = -1;
	КонецЦикла;
		
КонецПроцедуры

