		УсловиеСтанцииСоблюдено = Ложь;
		
		УсловиеСтанцииСоблюдено = ВсеКодыВсехАналоговСтанции.Найти(Ответ.Ссылка.СтанцияНазначенияКод) <> неопределено;
		Для каждого Стр из Ответ.Ссылка.ГрузыЖД Цикл
			УсловиеГрузаСоблюдено = УсловиеГрузаСоблюдено ИЛИ КодыЕТСНГПорожниеКТК.Найти(Стр.КодЕТСНГ) <> неопределено;
		КонецЦикла;
		
		Если УсловиеГрузаСоблюдено И УсловиеСтанцииСоблюдено Тогда 
			Результат.НакладнаяКТК = Ответ.НакладнаяНомер; 
			Результат.ВагонПорожнегоКТК = Ответ.НомерВагона;
			Результат.ВагонПорожнегоКТКСсылка = Ответ.ВагонСсылка;
			Результат.СтанцияПогрузкиКТК = Ответ.СтанцияОтправленияКод;
			Результат.РаскредитацияКТК = Ответ.РаскредитацияКТК;
			Результат.НакладнаяКТКСсылка = Ответ.Ссылка;
			//Прервать;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТДПоНомеруЖДН(ЖДНПодсылВагонов)
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТранспортныйДокумент.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	               |ГДЕ
	               |	ТранспортныйДокумент.ПометкаУдаления = ЛОЖЬ
	               |	И ТранспортныйДокумент.НомерТранспортногоДокумента = &НомерТранспортногоДокумента
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ТранспортныйДокумент.Создано УБЫВ";
	Запрос.УстановитьПараметр("НомерТранспортногоДокумента", ЖДНПодсылВагонов);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
