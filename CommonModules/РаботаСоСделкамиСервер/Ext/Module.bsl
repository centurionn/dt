			Пока ВыборкаУслуги.СледующийПоЗначениюПоля("ГУИД") Цикл    
				СтрокаРасход = Расходы.Найти(ВыборкаУслуги.ГУИД, "ГУИД");
				Если ВыборкаУслуги.Контейнер = Контейнер Тогда
					СтрокаРасход.УслугаОтключена = Ложь;
					СтрокаРасход.Контейнер = Справочники.ТЕ.ПустаяСсылка();
					СуммаПоВагону = СуммаПоВагону + СтрокаРасход.СуммаИтого;
					СуммаНДСПоВагону = СуммаНДСПоВагону + СтрокаРасход.СуммаНДС;
					ВключеннаяСтрокаРасход = СтрокаРасход;
