						КонецЕсли; 
					КонецЕсли; 
				КонецЕсли; 
			КонецЦикла;
			ВключеннаяСтрокаРасход.СуммаИтого = СуммаПоВагону;
			ВключеннаяСтрокаРасход.СуммаНДС = СуммаНДСПоВагону;
