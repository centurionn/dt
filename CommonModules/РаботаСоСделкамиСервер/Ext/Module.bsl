//Функция НайтиНомерГруженойПорожнимиВагонамиНакладнойПоЭТРАНПоКТК(КТК, НачалоПериода, КонецПериода, СтанцияПогрузки, СтанцияВыгрузки)
//ДИТ, Беляев СЮ, US 68284/ TA 68289, 11-05-2023, начало
Функция НайтиНомерГруженойПорожнимиВагонамиНакладнойПоЭТРАНПоКТК(КТК, НачалоПериода, КонецПериода, МассивСтанцийОтправления, МассивСтанцийНазначений)
//ДИТ, Беляев СЮ, US 68284/ TA 68289, 11-05-2023, конец
	
	Результат = Новый Структура("НомерЖДН, СсылкаЖДН, Вагон");
	ПорожниеВагоныЕТСНГ = э_ОбщиеСервер.МассивКодовЕТСНГ_ПорожниеВагоны();
	ПорожниеКТКЕТСНГ = э_ОбщиеСервер.МассивКодовЕТСНГ_ПорожниеКТК();
	
	//ВсеКодыВсехАналоговСтанцииОтправления = Локации_сервер.ПолучитьКодыАналоговСтанцииПоКоду(СтанцияПогрузки.КодЖДСтанции);
	//ВсеКодыВсехАналоговСтанцииПрибытия = Локации_сервер.ПолучитьКодыАналоговСтанцииПоКоду(СтанцияВыгрузки.КодЖДСтанции);
	//ДИТ, Беляев СЮ, US 68284/ TA 68289, 11-05-2023, начало
	ВсеКодыВсехАналоговСтанцииОтправления = Локации_сервер.ПолучитьКодыАналоговСтанций(МассивСтанцийОтправления);
	ВсеКодыВсехАналоговСтанцииПрибытия = Локации_сервер.ПолучитьКодыАналоговСтанций(МассивСтанцийНазначений);
	//ДИТ, Беляев СЮ, US 68284/ TA 68289, 11-05-2023, конец
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	э_НакладнаяКонтейнеры.Ссылка КАК ЖДН_Ссылка,
	               |	ВЫБОР
	               |		КОГДА э_НакладнаяКонтейнеры.Ссылка.ДатаИВремяРаскредитованияГруза <> ДАТАВРЕМЯ(1, 1, 1)
	               |			ТОГДА э_НакладнаяКонтейнеры.Ссылка.ДатаИВремяРаскредитованияГруза
	               |		ИНАЧЕ э_НакладнаяКонтейнеры.Ссылка.ДатаИВремяОтправленияГруза
	               |	КОНЕЦ КАК Период,
	               |	э_НакладнаяКонтейнеры.НомерКонтейнера КАК НомерКонтейнера,
	               |	э_НакладнаяКонтейнеры.Ссылка.Вагон КАК Вагон,
	               |	э_НакладнаяКонтейнеры.Ссылка.НакладнаяНомер КАК НакладнаяНомер,
	               |	ТранспортныйДокумент.Ссылка КАК ТД_Ссылка,
	               |	э_НакладнаяКонтейнеры.НомерВагонаДляКонтейнерногоПоезда КАК НомерВагонаДляКонтейнерногоПоезда,
	               |	э_НакладнаяВагоны.НомерВагона КАК НомерВагона,
	               |	ТС.Ссылка КАК ТС_Ссылка
	               |ИЗ
	               |	Документ.э_Накладная.Контейнеры КАК э_НакладнаяКонтейнеры
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.э_Накладная.ГрузыЖД КАК э_НакладнаяГрузыЖД
	               |		ПО э_НакладнаяКонтейнеры.Ссылка = э_НакладнаяГрузыЖД.Ссылка
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	               |		ПО э_НакладнаяКонтейнеры.Ссылка = ТранспортныйДокумент.НакладнаяЭТРАН
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.э_Накладная.Вагоны КАК э_НакладнаяВагоны
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТС КАК ТС
	               |			ПО э_НакладнаяВагоны.НомерВагона = ТС.Наименование
	               |				И (НЕ ТС.ПометкаУдаления)
	               |		ПО э_НакладнаяКонтейнеры.Ссылка = э_НакладнаяВагоны.Ссылка
	               |			И (э_НакладнаяКонтейнеры.НомерВагонаДляКонтейнерногоПоезда = э_НакладнаяВагоны.ПорядковыйНомерВагонаВОтправке
	               |				ИЛИ э_НакладнаяКонтейнеры.НомерВагонаДляКонтейнерногоПоезда = 0)
	               |ГДЕ
	               |	э_НакладнаяКонтейнеры.Ссылка.Дата МЕЖДУ &Дата1 И &Дата2
	               |	И НЕ э_НакладнаяКонтейнеры.Ссылка.ПометкаУдаления
	               |	И э_НакладнаяКонтейнеры.НомерКонтейнера = &Контейнер
	               |	И э_НакладнаяКонтейнеры.Ссылка.ТекущееСостояниеНакладнойДействующийСтатус
	               |	И э_НакладнаяКонтейнеры.Ссылка.СтанцияНазначенияКод В(&СтанцияНазначенияКод)
	               |	И э_НакладнаяКонтейнеры.Ссылка.СтанцияОтправленияКод В(&СтанцияОтправленияКод)
				   |	И э_НакладнаяКонтейнеры.Ссылка.ТипНакладной <> &ДосылочнаяНакладная
	               |	И (э_НакладнаяГрузыЖД.КодЕТСНГ В (&ПорожниеВагоныЕТСНГ)
	               |			ИЛИ э_НакладнаяГрузыЖД.КодЕТСНГ В (&ПорожниеКТКЕТСНГ))
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерВагона УБЫВ";
	Запрос.УстановитьПараметр("Контейнер", КТК.Наименование);
	Запрос.УстановитьПараметр("СтанцияОтправленияКод", ВсеКодыВсехАналоговСтанцииОтправления);
	Запрос.УстановитьПараметр("СтанцияНазначенияКод", ВсеКодыВсехАналоговСтанцииПрибытия);
	Запрос.УстановитьПараметр("Дата1", НачалоПериода);
	Запрос.УстановитьПараметр("Дата2", КонецПериода);
	Запрос.УстановитьПараметр("ПорожниеВагоныЕТСНГ", ПорожниеВагоныЕТСНГ);
	Запрос.УстановитьПараметр("ПорожниеКТКЕТСНГ", ПорожниеКТКЕТСНГ);
	//ДИТ Шевченко А.В 01.08.2022 53548 -Начало
	Запрос.УстановитьПараметр("ДосылочнаяНакладная", Справочники.э_ОбщиеПоказатели.ДосылочнаяНакладная);
	//ДИТ Шевченко А.В 01.08.2022 53548 -Конец
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		
		Результат.НомерЖДН = Ответ.НакладнаяНомер;
		Результат.СсылкаЖДН = Ответ.ТД_Ссылка;
		Результат.Вагон = Ответ.ТС_Ссылка;
		
	КонецЕсли;
	
	Возврат Результат;
	
