			СтрокаРасходов.ПричинаОтключенияСтроки = Перечисления.ПричиныОтключенияСтрокиРасходовСделки.ИзменениеЗаявки;
		Иначе
			СтрокаРасходов.ПричинаОтключенияСтроки = Перечисления.ПричиныОтключенияСтрокиРасходовСделки.ИзменениеКалькуляции;
