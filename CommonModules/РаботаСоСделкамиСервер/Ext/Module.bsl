Функция ПолучитьДанныеПоЗаявке(Выборка, Сделка)
	КТКСписок = Сделка.ДоходыКТК.Найти(Выборка.ГУИД,"ГУИД");	
	Если КТКСписок <> Неопределено Тогда
		// для набора контейнеров нужно получить список Гос номеров
		Запрос = Новый Запрос;
		Запрос.Текст =		
		"ВЫБРАТЬ
		|	ЗаявкаСоставУслуги.НомерАвто КАК НомерАвто,
		// ДИТ Поморцева Т.П. Задача 37404(36099) 01.09.2021.
		//|	ЗаявкаСоставУслуги.ДатаВзятия КАК ДатаВзятия,
		|	ЗаявкаСоставУслуги.АдресПогрузки КАК АдресПогрузки,
		|	ЗаявкаСоставУслуги.АдресВыгрузки КАК АдресВыгрузки,
		|	ЗаявкаСоставУслуги.ПунктОтправления.Наименование КАК ПунктОтправленияСуша,
		|	ЗаявкаСоставУслуги.ПунктНазначения.Наименование КАК ПунктНазначенияСуша,
		|	ЗаявкаСоставУслуги.РеестрКлиента КАК РеестрКлиента,
		|	ЗаявкаСоставУслуги.ДатаПодачиАвтоПодПогрузку КАК ДатаПодачиАвтоПодПогрузку,
		// Евросиб Фролов (11.03.2022 Task №44976 
		|	ЕСТЬNULL(СделкаСвязьУчетныхЕдиниц.Коносамент.НомерТранспортногоДокумента, """") КАК Коносамент
		// Евросиб Фролов)
		|ИЗ
		|	Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
		// Евросиб Фролов (11.03.2022 Task №44976
		|	ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
		|		ПО ЗаявкаСоставУслуги.ГУИДСтроки = СделкаСвязьУчетныхЕдиниц.ГУИДСтрокиЗаявки
		|			И ЗаявкаСоставУслуги.Ссылка = СделкаСвязьУчетныхЕдиниц.Заявка
