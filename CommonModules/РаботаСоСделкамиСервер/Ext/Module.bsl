//Функция ПолучитьРеквизитыНакладной( ЖДН ) 
Функция ПолучитьРеквизитыНакладной( ЖДН, КонтейнерСсылка ) //ДИТ, Беляев СЮ, Ticket#0339735, 26-01-2024, добавлен параметр КонтейнерСсылка
	Результат = Новый Структура("НомерЖДН, СсылкаЖДН, Вагон, Охрана");
	
	Запрос = Новый Запрос;
	//Запрос.Текст = 
	//	"ВЫБРАТЬ
	//	|	э_НакладнаяВагоны.Ссылка.НакладнаяНомер КАК НакладнаяНомер,
	//	|	э_НакладнаяВагоны.НомерВагона КАК НомерВагона,
	//	|	э_НакладнаяВагоны.Ссылка.Охрана КАК Охрана,
	//	|	ТС.Ссылка КАК ВагонСсылка,
	//	|	ТранспортныйДокумент.Ссылка КАК ТД_Ссылка
	//	|ИЗ
	//	|	Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	//	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.э_Накладная.Вагоны КАК э_НакладнаяВагоны
	//	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТС КАК ТС
	//	|			ПО э_НакладнаяВагоны.НомерВагона = ТС.Наименование
	//	|		ПО ТранспортныйДокумент.НакладнаяЭТРАН = э_НакладнаяВагоны.Ссылка
	//	|ГДЕ
	//	|	ТранспортныйДокумент.Ссылка = &ЖДН";
	//ДИТ, Беляев СЮ, Ticket#0339735, 26-01-2024, начало
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	э_Накладная.НакладнаяНомер КАК НакладнаяНомер,
		|	ТранспортныйДокументУчетныеЕдиницы.НомерВагона КАК НомерВагона,
		|	э_Накладная.Охрана КАК Охрана,
		|	ТранспортныйДокументУчетныеЕдиницы.Вагон КАК ВагонСсылка,
		|	ТранспортныйДокумент.Ссылка КАК ТД_Ссылка
		|ИЗ
		|	Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.э_Накладная КАК э_Накладная
		|		ПО ТранспортныйДокумент.НакладнаяЭТРАН = э_Накладная.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент.УчетныеЕдиницы КАК ТранспортныйДокументУчетныеЕдиницы
		|		ПО ТранспортныйДокумент.Ссылка = ТранспортныйДокументУчетныеЕдиницы.Ссылка
		|			И (ТранспортныйДокументУчетныеЕдиницы.Контейнер = &КонтейнерСсылка)
		|			И (ТранспортныйДокументУчетныеЕдиницы.Вагон.Наименование <> """")
		|ГДЕ
		|	ТранспортныйДокумент.Ссылка = &ЖДН";
	//ДИТ, Беляев СЮ, Ticket#0339735, 26-01-2024, конец
	
	Запрос.УстановитьПараметр("ЖДН", ЖДН);
	//ДИТ, Беляев СЮ, Ticket#0339735, 26-01-2024, начало
	Запрос.УстановитьПараметр("КонтейнерСсылка", КонтейнерСсылка); 
	//ДИТ, Беляев СЮ, Ticket#0339735, 26-01-2024, конец
	
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		
		Результат.НомерЖДН = Ответ.НакладнаяНомер;
		Результат.СсылкаЖДН = Ответ.ТД_Ссылка;
		Результат.Вагон = Ответ.ВагонСсылка;
		Если НЕ ЗначениеЗаполнено(Ответ.ВагонСсылка) И ЗначениеЗаполнено(Ответ.НомерВагона) Тогда
			Результат.Вагон = РаботаСКонтейнерамиСервер.ПолучитьВагонПоНомеру(Ответ.НомерВагона);
		КонецЕсли;
		Результат.Охрана = Ответ.Охрана;
		
	КонецЕсли;
	
	Возврат Результат;
КонецФункции
