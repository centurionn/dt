	|	ВремТЧ_Расходы.ИсточникПоявленияСтрокиЭкономики КАК ИсточникПоявленияСтрокиЭкономики,
	|	ВремТЧ_Расходы.Услуга КАК Услуга,
	|	ВремТЧ_СУЕ.НомерЖДН КАК НомерЖДН,
	|	ВремТЧ_СУЕ.НомерВагоннойЖДН КАК НомерВагоннойЖДН,
	|	ВремТЧ_СУЕ.НомерПорожнейВагоннойЖДН КАК НомерПорожнейВагоннойЖДН,
	|	ВремТЧ_СУЕ.НомерПорожнейЖДНКТК КАК НомерПорожнейЖДНКТК,
	|	ВремТЧ_СУЕ.Коносамент.НомерТранспортногоДокумента КАК КоносаментНомерТранспортногоДокумента
	|ИЗ
	|	ВремТЧ_Расходы КАК ВремТЧ_Расходы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВремТЧ_СУЕ КАК ВремТЧ_СУЕ
	|		ПО ВремТЧ_Расходы.СтрокаСвязьУчетныхЕдиниц = ВремТЧ_СУЕ.ГУИД";
	Запрос.УстановитьПараметр("ТЧРасходы", Сделка.Расходы.Выгрузить(,"СтрокаСвязьУчетныхЕдиниц, ГУИД, ЕдиницаИзмерения, ИсточникПоявленияСтрокиЭкономики, Услуга, ГруппаУслуг, Подсыл"));
	Запрос.УстановитьПараметр("ТЧСУЕ", Сделка.СвязьУчетныхЕдиниц.Выгрузить(,"Контейнер, Вагон, НомерЖДН, ГУИД, НомерВагоннойЖДН, НомерПорожнейЖДНКТК, НомерПорожнейВагоннойЖДН, Коносамент, НакладнаяПослеГруженогоПлеча,ЖДНПерестановкиДоГружКТК,ЖДНПерестановкиДоПорКТК"));
	Запрос.УстановитьПараметр("УслугаФрахт", ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьЗначениеКонстанты("УслугаФрахтаДляКалькуляции"));
	РезультатЗапроса = Запрос.Выполнить();
	Стр = РезультатЗапроса.Выбрать();
	
	Пока Стр.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Стр.СписокВагонов) Тогда
			Если НЕ Стр.ИсточникПоявленияСтрокиЭкономики = Перечисления.ИсточникПоявленияСтрокиЭкономики.ЖДНПодсылаКТК Тогда
				//эти вагоны добавляются при добавлении основных услуг
				НСтр = Сделка.ДоходыВагоны.Найти(Стр.ГУИД, "ГУИД");
				Если НСтр = Неопределено Тогда
					НСтр = Сделка.ДоходыВагоны.Добавить(); 
				КонецЕсли; 
				НСтр.ГУИД = Стр.ГУИД; 
				НСтр.Вагон = Стр.СписокВагонов; 
			КонецЕсли; 
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.СписокКТК) Тогда 
			//эти ктк добавляются при добавлении основных услуг
			Если НЕ Стр.ИсточникПоявленияСтрокиЭкономики = Перечисления.ИсточникПоявленияСтрокиЭкономики.ЖДНВозврата Тогда
				НСтр = Сделка.ДоходыКТК.Найти(Стр.ГУИД, "ГУИД");
				Если НСтр = Неопределено Тогда
					НСтр = Сделка.ДоходыКТК.Добавить(); 
				КонецЕсли;
				НСтр.ГУИД = Стр.ГУИД; 
				НСтр.КТК = Стр.СписокКТК; 
			КонецЕсли; 
		КонецЕсли;
		//Если ЗначениеЗаполнено(Стр.СписокТД) Тогда 
			НСтр = Сделка.ДоходыТД.Найти(Стр.ГУИД, "ГУИД");
			Если НСтр = Неопределено Тогда
				НСтр = Сделка.ДоходыТД.Добавить(); 
			КонецЕсли;
			НСтр.ГУИД = Стр.ГУИД; 
			НСтр.ТД = Стр.СписокТД; 
		//КонецЕсли;
		
	КонецЦикла;
КонецПроцедуры

Процедура ОтработатьАктивностьСтрокРасходов(Сделка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СделкаРасходы.ГУИД КАК ГУИД,
	|	ВЫРАЗИТЬ(СделкаРасходы.Услуга КАК Справочник.Номенклатура) КАК Услуга,
	|	СделкаРасходы.ГруппаУслуг КАК ГруппаУслуг,
	|	СделкаРасходы.УслугаОтключена КАК УслугаОтключена,
	|	СделкаРасходы.СтрокаСвязьУчетныхЕдиниц КАК СтрокаСвязьУчетныхЕдиниц,
	|	СделкаРасходы.ОсновнаяУслугаГруппы КАК ОсновнаяУслугаГруппы,
	|	СделкаРасходы.УчДокумент КАК УчДокумент,
	//Евросиб - АСуслов 06.09.2022 13:05:59 #
	//(
	|   СделкаРасходы.УслугаОтключенаУсловно КАК УслугаОтключенаУсловно
	//)
	//Евросиб - АСуслов 06.09.2022 13:06:00 #
	|ПОМЕСТИТЬ ВТ_Расходы
	|ИЗ
	|	&Расходы КАК СделкаРасходы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СделкаСвязьУчетныхЕдиниц.ГУИД КАК ГУИД,
	|	СделкаСвязьУчетныхЕдиниц.НакладнаяПослеГруженогоПлеча КАК НакладнаяПослеГруженогоПлеча,
	|	СделкаСвязьУчетныхЕдиниц.НакладнаяПослеГружКТК КАК НакладнаяПослеГружКТК
	|ПОМЕСТИТЬ ВТ_СвязьУчетныхЕдиниц
	|ИЗ
	|	&СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СделкаРасходы.ГУИД КАК ГУИД,
	|	СделкаРасходы.Услуга КАК Услуга,
	|	ВЫБОР КОГДА СделкаРасходы.ОсновнаяУслугаГруппы Тогда -1 ИНАЧЕ СделкаРасходы.Услуга.УслугаРасходовВыбираетсяПриУсловии КОНЕЦ КАК ВидУслуги,
	|	СделкаРасходы.ГруппаУслуг КАК ГруппаУслуг,
	|	СделкаРасходы.УслугаОтключена КАК УслугаОтключена,
	|	СделкаРасходы.СтрокаСвязьУчетныхЕдиниц КАК СтрокаСвязьУчетныхЕдиниц,
	|	ВЫБОР
	|		КОГДА СделкаРасходы.УчДокумент = ЗНАЧЕНИЕ(Документ.ПоступлениеТоваровУслуг.ПустаяСсылка)
	|				И СделкаРасходы.УслугаОтключена
	|			ТОГДА 2
	|		КОГДА СделкаРасходы.УчДокумент = ЗНАЧЕНИЕ(Документ.ПоступлениеТоваровУслуг.ПустаяСсылка)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК УчДокумент,
	|	ВЫБОР
	|		КОГДА СделкаСвязьУчетныхЕдиниц.НакладнаяПослеГруженогоПлеча = ЗНАЧЕНИЕ(Документ.ТранспортныйДокумент.ПустаяСсылка)
	|				И СделкаСвязьУчетныхЕдиниц.НакладнаяПослеГружКТК = ЗНАЧЕНИЕ(Документ.ТранспортныйДокумент.ПустаяСсылка)
	|				И СделкаРасходы.ОсновнаяУслугаГруппы
	|			ТОГДА ИСТИНА
	|		КОГДА НЕ СделкаСвязьУчетныхЕдиниц.НакладнаяПослеГруженогоПлеча = ЗНАЧЕНИЕ(Документ.ТранспортныйДокумент.ПустаяСсылка)
	|				И СделкаРасходы.Услуга.УслугаРасходовВыбираетсяПриУсловии = 1
	|			ТОГДА ИСТИНА
	|		КОГДА НЕ СделкаСвязьУчетныхЕдиниц.НакладнаяПослеГружКТК = ЗНАЧЕНИЕ(Документ.ТранспортныйДокумент.ПустаяСсылка)
	|				И СделкаРасходы.Услуга.УслугаРасходовВыбираетсяПриУсловии = 2
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Включить,
	|	СделкаСвязьУчетныхЕдиниц.НакладнаяПослеГружКТК КАК НакладнаяПослеГружКТК
	|ИЗ
	|	ВТ_Расходы КАК СделкаРасходы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|		ПО СделкаРасходы.СтрокаСвязьУчетныхЕдиниц = СделкаСвязьУчетныхЕдиниц.ГУИД
	|ГДЕ
	|	СделкаРасходы.ГруппаУслуг > 0 
	//Евросиб - АСуслов 06.09.2022 13:05:31 #
	//(
	|	И ВЫБОР КОГДА СделкаРасходы.УслугаОтключена ТОГДА СделкаРасходы.УслугаОтключенаУсловно ИНАЧЕ ИСТИНА КОНЕЦ
	//)
	//Евросиб - АСуслов 06.09.2022 13:05:32 #
	|  
	|
	|УПОРЯДОЧИТЬ ПО
	|	СтрокаСвязьУчетныхЕдиниц,
	|	ГруппаУслуг,
	|	ВидУслуги,
	|	УчДокумент";
	Запрос.УстановитьПараметр("Расходы", Сделка.Расходы.Выгрузить());
	Запрос.УстановитьПараметр("СвязьУчетныхЕдиниц", Сделка.СвязьУчетныхЕдиниц.Выгрузить());
	РезультатЗапроса = Запрос.Выполнить();                            
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.СледующийПоЗначениюПоля("СтрокаСвязьУчетныхЕдиниц") Цикл
		Пока Выборка.СледующийПоЗначениюПоля("ГруппаУслуг") Цикл
			Пока Выборка.СледующийПоЗначениюПоля("ВидУслуги") Цикл
				ПерваяСтрока = Истина;
				Пока Выборка.СледующийПоЗначениюПоля("УчДокумент") Цикл
					СтрокаРасход = Сделка.Расходы.Найти(Выборка.ГУИД);
					СтрокаРасход.УслугаОтключена = НЕ ПерваяСтрока ИЛИ НЕ Выборка.Включить;
					//Евросиб - АСуслов 06.09.2022 13:06:55 #
					//(
					СтрокаРасход.УслугаОтключенаУсловно = СтрокаРасход.УслугаОтключена;
					//)
					//Евросиб - АСуслов 06.09.2022 13:06:55 #
					//Евросиб - АСуслов 27.11.2022 13:23:53 #62636
					//дубли строк
					//(
					//СтрокаРасход.ОсновнаяУслугаГруппы = ПерваяСтрока И Выборка.Включить;
					//)
					//Евросиб - АСуслов 27.11.2022 13:23:55 #62636
					ПерваяСтрока = Ложь;
				КонецЦикла;
			КонецЦикла;	
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтключитьДублиВагонныхУслуг_СтарыйАлгоритм(Сделка, МассивПТУДляОтвязки)
