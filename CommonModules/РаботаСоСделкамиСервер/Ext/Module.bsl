Процедура ОтключитьСтрокиРасходовПоОтмеченнымКТК(Сделка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СделкаСвязьУчетныхЕдиниц.ГУИД КАК ГУИД
	|ПОМЕСТИТЬ втСвязьУчетныхЕдиниц
	|ИЗ
	|	&СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|ГДЕ
	|	СделкаСвязьУчетныхЕдиниц.ОтключитьРасходы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СделкаРасходы.ГУИД КАК ГУИД,
	|	СделкаРасходы.СтрокаСвязьУчетныхЕдиниц КАК СтрокаСвязьУчетныхЕдиниц
	|ПОМЕСТИТЬ втРасходы
	|ИЗ
	|	&Расходы КАК СделкаРасходы
	|ГДЕ
	|	СделкаРасходы.УслугаОтключена = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СделкаРасходы.ГУИД КАК ГУИД
	|ИЗ
	|	втСвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втРасходы КАК СделкаРасходы
	|		ПО СделкаСвязьУчетныхЕдиниц.ГУИД = СделкаРасходы.СтрокаСвязьУчетныхЕдиниц";

	Запрос.УстановитьПараметр("Расходы", Сделка.Расходы.Выгрузить());
	Запрос.УстановитьПараметр("СвязьУчетныхЕдиниц", Сделка.СвязьУчетныхЕдиниц.Выгрузить());
	РезультатЗапроса = Запрос.Выполнить();                            
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаРасход = Сделка.Расходы.Найти(Выборка.ГУИД, "ГУИД");
		СтрокаРасход.УслугаОтключена = Истина;
		СтрокаРасход.ПричинаОтключенияСтроки = Перечисления.ПричиныОтключенияСтрокиРасходовСделки.РучноеОтключениеСтрокиСоставаПоезда;
	КонецЦикла;
	
КонецПроцедуры

