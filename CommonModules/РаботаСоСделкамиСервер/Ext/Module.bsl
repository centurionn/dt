Процедура ДополнитьПомеченныеРасходыПлановойЦенойИзЖДН(Сделка)
	
	Для каждого Стр из Сделка.Расходы Цикл
		
		МассивИсточников = Новый Массив;
		МассивИсточников.Добавить(Перечисления.ИсточникПоявленияСтрокиЭкономики.ЖДНПодсылаВагонов);
		МассивИсточников.Добавить(Перечисления.ИсточникПоявленияСтрокиЭкономики.ЖДНПодсылаКТК);
		МассивИсточников.Добавить(Перечисления.ИсточникПоявленияСтрокиЭкономики.ПорожняяЖДН);
		МассивИсточников.Добавить(Перечисления.ИсточникПоявленияСтрокиЭкономики.ЖДНВозврата);
		МассивИсточников.Добавить(Перечисления.ИсточникПоявленияСтрокиЭкономики.ЖДНПерестановкиВагонов);
		Если Стр.ПлановаяСтоимостьИзЖДН = Истина 
			И МассивИсточников.Найти(Стр.ИсточникПоявленияСтрокиЭкономики) = Неопределено Тогда
			
			СтрокаСУЕ = Сделка.СвязьУчетныхЕдиниц.Найти(Стр.СтрокаСвязьУчетныхЕдиниц,"ГУИД");
			Если СтрокаСУЕ <> Неопределено И ЗначениеЗаполнено(СтрокаСУЕ.ЖДН) Тогда
				Стр.Себестоимость = РаботаСоСделкамиСервер.ПолучитьСуммуНакладнойПоПараметрам(
											ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаСУЕ.ЖДН,"НакладнаяЭТРАН"),
											СтрокаСУЕ.Вагон,
											СтрокаСУЕ.Контейнер);
				Стр.СебестоимостьИтого		= Стр.Себестоимость * Стр.Количество;
				Стр.СуммаНДС 				= БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(Стр.СебестоимостьИтого, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Стр.СтавкаНДС), Истина, Стр.НДСВключенВСтоимость);
				Стр.СуммаИтого 				= Стр.СебестоимостьИтого + ?(Стр.НДСВключенВСтоимость, 0, Стр.СуммаНДС);

			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

