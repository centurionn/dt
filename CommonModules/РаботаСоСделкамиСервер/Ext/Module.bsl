	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаСделки = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаСделки.Следующий() Цикл
		//обСделка = ВыборкаСделки.Ссылка.ПолучитьОбъект();
		ВыборкаСтроки = ВыборкаСделки.Выбрать();
		Пока ВыборкаСтроки.Следующий() Цикл
			СтрокиСвязей = ОбъектСделка.СвязьДоходовИРасходов.НайтиСтроки(Новый Структура("Доходы, СвязьУчетныхЕдиниц, Услуга", "", ВыборкаСтроки.СвязьУчетныхЕдиниц, ВыборкаСтроки.Услуга));
			Если СтрокиСвязей.Количество() > 0 Тогда
				Для каждого СтрокаСвязи Из СтрокиСвязей Цикл
					СтрокаСвязи.Доходы = ВыборкаСтроки.Доходы;
				КонецЦикла;
			Иначе
				нСтрока = ОбъектСделка.СвязьДоходовИРасходов.Добавить();
				ЗаполнитьЗначенияСвойств(нСтрока, ВыборкаСтроки);
			КонецЕсли; 
		КонецЦикла; 
	КонецЦикла; 
	
КонецПроцедуры

Функция ЕстьПроведенныеРТУКСделке(Сделка) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РеализацияТоваровУслугУслуги.Ссылка КАК Ссылка,
	|	ИсторияКорректировокРеализацийСрезПоследних.ВидОперации КАК ВидОперации
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Услуги КАК РеализацияТоваровУслугУслуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияКорректировокРеализаций.СрезПоследних КАК ИсторияКорректировокРеализацийСрезПоследних
	|		ПО РеализацияТоваровУслугУслуги.Ссылка = ИсторияКорректировокРеализацийСрезПоследних.ПервичныйДокумент
	|ГДЕ
	|	РеализацияТоваровУслугУслуги.Сделка = &Сделка
	|	И РеализацияТоваровУслугУслуги.Ссылка.Проведен
	|	И НЕ ЕСТЬNULL(ИсторияКорректировокРеализацийСрезПоследних.ВидОперации, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОтчетКомитентуОПродажах.Ссылка,
	|	ИсторияКорректировокРеализацийСрезПоследних.ВидОперации
	|ИЗ
	|	Документ.ОтчетКомитентуОПродажах КАК ОтчетКомитентуОПродажах
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияКорректировокРеализаций.СрезПоследних КАК ИсторияКорректировокРеализацийСрезПоследних
	|		ПО ОтчетКомитентуОПродажах.Ссылка = ИсторияКорректировокРеализацийСрезПоследних.ПервичныйДокумент
	|ГДЕ
	|	ОтчетКомитентуОПродажах.Сделка = &Сделка
	|	И ОтчетКомитентуОПродажах.Ссылка.Проведен
	|	И НЕ ЕСТЬNULL(ИсторияКорректировокРеализацийСрезПоследних.ВидОперации, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование)";
	Запрос.УстановитьПараметр("Сделка", Сделка);
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ЕстьАктуальныеАкцептыКСделке(Сделка) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Акцепт.Поступление КАК Поступление,
	|	Акцепт.Ссылка КАК Акцепт
	|ПОМЕСТИТЬ ВТАктуальныеАкцепты
	|ИЗ
	// Евросиб US 83437 TA 83438 Рыбьяков К.А. 11.06.2024 ((
	|	РегистрСведений.АктуальныеАкцепты КАК АктуальныеАкцепты
	//|	Документ.Акцепт КАК Акцепт
	// Евросиб Рыбьяков К.А. 11.06.2024 ))
	|ГДЕ
	|	Акцепт.Проведен
	|	И Акцепт.СторнируемыйАкцепт = ЗНАЧЕНИЕ(Документ.Акцепт.ПустаяСсылка)
	|	И НЕ Акцепт.Ссылка В
	|				(ВЫБРАТЬ
	|					Акцепт.СторнируемыйАкцепт КАК СторнируемыйАкцепт
	|				ИЗ
	|					Документ.Акцепт КАК Акцепт
	|				ГДЕ
	|					Акцепт.Проведен)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АкцептУслуги.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Акцепт.Услуги КАК АкцептУслуги
	|ГДЕ
	|	АкцептУслуги.Сделка = &Сделка
	|	И АкцептУслуги.Ссылка В (ВЫБРАТЬ т.Акцепт ИЗ ВТАктуальныеАкцепты КАК т)";
	Запрос.УстановитьПараметр("Сделка", Сделка);
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции


