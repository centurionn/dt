	СоответствиеПолейВагоновиЖДН.Вставить("ЖДН","СделкаСвязьУчетныхЕдиниц.Вагон");
	СоответствиеПолейВагоновиЖДН.Вставить("НакладнаяПослеГружКТК","СделкаСвязьУчетныхЕдиниц.ВагонПодсылаПорКТК");
	СоответствиеПолейВагоновиЖДН.Вставить("ПорожняяЖДНКТК","СделкаСвязьУчетныхЕдиниц.ВагонПодсылаПорКТК");
	СоответствиеПолейВагоновиЖДН.Вставить("ВагоннаяЖДН","СделкаСвязьУчетныхЕдиниц.Вагон");
	СоответствиеПолейВагоновиЖДН.Вставить("НакладнаяПослеГруженогоПлеча","СделкаСвязьУчетныхЕдиниц.Вагон");
	СоответствиеПолейВагоновиЖДН.Вставить("ЖДНПерестановкиДоГружКТК","СделкаСвязьУчетныхЕдиниц.Вагон");
	СоответствиеПолейВагоновиЖДН.Вставить("ЖДНПерестановкиДоПорКТК","СделкаСвязьУчетныхЕдиниц.Вагон");
	СоответствиеПолейВагоновиЖДН.Вставить("ПорожняяВагоннаяЖДН","СделкаСвязьУчетныхЕдиниц.ВагонПодсылаПорКТК");
	
	СписокПолейСТипомНакладная = ПолучитьСписокПолейСТипомНакладная(ОбъектСделка); 
	ШаблонЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	&Дата КАК Период,
	|	&ПолеЖДН КАК ЖДН,
	|	&ПолеКТК КАК Контейнер,
	|	&ПолеВагон КАК Вагон,
	|	&ПолеКлиент КАК Клиент,
	|	&ПолеДоговор КАК Договор,
	|	1 КАК Наличие
	|ИЗ
	|	ВТ_СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|ГДЕ
	|	НЕ &ПолеЖДН = ЗНАЧЕНИЕ(Документ.ТранспортныйДокумент.ПустаяСсылка)";
	ТекстЗапросаОбщий = "";                                  
	ВсегоЗапросов = 0;
	Для каждого ПолеНакладная Из СписокПолейСТипомНакладная Цикл
		ВсегоЗапросов = ВсегоЗапросов + 1;
		ТекстЗапроса = СтрЗаменить(ШаблонЗапроса, "&ПолеЖДН", СтрШаблон("СделкаСвязьУчетныхЕдиниц.%1",ПолеНакладная));
		
		ИмяПоляКонтейнера = СоответствиеПолейКТКиЖДН.Получить(ПолеНакладная);
		Если ИмяПоляКонтейнера = Неопределено Тогда
			ИмяПоляКонтейнера = "Контейнер";
		КонецЕсли;	
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеКТК", ИмяПоляКонтейнера);
		
		ИмяПоляВагона = СоответствиеПолейВагоновиЖДН.Получить(ПолеНакладная);
		Если ИмяПоляВагона = Неопределено Тогда
			ИмяПоляВагона = "Вагон";
		КонецЕсли;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеВагон", ИмяПоляВагона);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеКлиент", СтрШаблон("СделкаСвязьУчетныхЕдиниц.%1","Клиент"));
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеДоговор", СтрШаблон("СделкаСвязьУчетныхЕдиниц.%1","Договор"));
		Если ВсегоЗапросов > 1 Тогда
			ТекстЗапросаОбщий = ТекстЗапросаОбщий + "
			|ОБЪЕДИНИТЬ
			|";
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ ВТ_Накладные", "");
		КонецЕсли;
		ТекстЗапросаОбщий = ТекстЗапросаОбщий + ТекстЗапроса;
	КонецЦикла;
	
	ТекстЗапросаРасходыЖДН = 	"
	|ОБЪЕДИНИТЬ
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	&Дата КАК Период,
	|	СделкаРасходы.ТранспортныйДокумент КАК ЖДН,
	|	СделкаРасходы.Контейнер КАК Контейнер,
	|	СделкаРасходы.Вагон КАК Вагон,
	|	ЕстьNULL(СвязьУчетныхЕдиниц.Клиент,ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Клиент,
	|	ЕстьNULL(СвязьУчетныхЕдиниц.Договор,ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)) КАК Договор,
	|	1 КАК Наличие
	|ИЗ
	|	ВТ_Расходы КАК СделкаРасходы
	|	ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СвязьУчетныхЕдиниц КАК СвязьУчетныхЕдиниц
	|		ПО СвязьУчетныхЕдиниц.ГУИД = СделкаРасходы.СтрокаСвязьУчетныхЕдиниц
	|				И НЕ СделкаРасходы.ОтнестиНаЗатраты
	|ГДЕ
	|	НЕ СделкаРасходы.ТранспортныйДокумент = ЗНАЧЕНИЕ(Документ.ТранспортныйДокумент.ПустаяСсылка)
	|	И НЕ СделкаРасходы.УслугаОтключена
	|	И НЕ СделкаРасходы.ТранспортныйДокумент.ПометкаУдаления
	|	И СделкаРасходы.ИсточникПоявленияСтрокиЭкономики = Значение(Перечисление.ИсточникПоявленияСтрокиЭкономики.ДобавленоИзАкцепта)
	|	СГРУППИРОВАТЬ ПО
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	|	&Дата,
	|	СделкаРасходы.ТранспортныйДокумент,
	|	СделкаРасходы.Контейнер,
	|	СделкаРасходы.Вагон,
	|	ЕстьNULL(СвязьУчетныхЕдиниц.Клиент,ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)),
	|	ЕстьNULL(СвязьУчетныхЕдиниц.Договор,ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка))";
	
	ТекстЗапросаОбщий = ТекстЗапросаОбщий + ТекстЗапросаРасходыЖДН;
	
	ТекстЗапросаВТРасходы = 
	"ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_Расходы ИЗ &Расходы КАК Расходы;";
	
	
	ТекстЗапросаВТ = 
	"ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_СвязьУчетныхЕдиниц ИЗ &СвязьУчетныхЕдиниц КАК СвязьУчетныхЕдиниц;";
	МВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;        
	Запрос.МенеджерВременныхТаблиц = МВТ;

	Запрос.Текст = ТекстЗапросаВТРасходы +"
	|"+ТекстЗапросаВТ+"
	|"+ТекстЗапросаОбщий;
	Запрос.УстановитьПараметр("СвязьУчетныхЕдиниц", ОбъектСделка.СвязьУчетныхЕдиниц.Выгрузить());
	Запрос.УстановитьПараметр("Расходы", ОбъектСделка.Расходы.Выгрузить());
	Запрос.УстановитьПараметр("Дата", ОбъектСделка.Дата);
	ОбъектСделка.Движения.АктуальныеЖДН.Записывать = Истина;
	ОбъектСделка.Движения.АктуальныеЖДН.Загрузить(Запрос.Выполнить().Выгрузить());
	//ДИТ Шевченко А.В. 59063 02.03.2023 -конец
КонецПроцедуры

