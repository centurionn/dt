	КонецЦикла;   
	
	//Евросиб Каблов 03.03.2026 ( Ticket#0427865
	ИсточникПоявленияСтрокиЭкономикиЖДН = Перечисления.ИсточникПоявленияСтрокиЭкономики.ЖДН;
