Функция ПолучитьМассивНеобработанныхСтрок(Сделка)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СделкаРасходы.ГУИД КАК ГУИД
	|ПОМЕСТИТЬ ВТ_Расходы
	|ИЗ
	|	Документ.Сделка.Расходы КАК СделкаРасходы
	|ГДЕ
	|	НЕ СделкаРасходы.УслугаОтключена
	|	И СделкаРасходы.ИсточникПоявленияСтрокиЭкономики В(&ИсточникПоявленияСтрокиЭкономики)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СделкаСвязьУчетныхЕдиниц.ГУИД КАК ГУИД
	|ПОМЕСТИТЬ ВТ_СвязьУчетныхЕдиниц
	|ИЗ
	|	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|ГДЕ
	|	НЕ СделкаСвязьУчетныхЕдиниц.Удалена
	|	И НЕ СделкаСвязьУчетныхЕдиниц.ОтключитьРасходы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Расходы.ГУИД КАК ГУИД
	|ИЗ
	|	ВТ_Расходы КАК ВТ_Расходы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СвязьУчетныхЕдиниц.ГУИД КАК ГУИД
	|ИЗ
	|	ВТ_СвязьУчетныхЕдиниц КАК ВТ_СвязьУчетныхЕдиниц";                              
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Сделка.Расходы", "&Расходы");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Сделка.СвязьУчетныхЕдиниц", "&СвязьУчетныхЕдиниц");
	Запрос.УстановитьПараметр("Расходы", Сделка.Расходы.Выгрузить());
	Запрос.УстановитьПараметр("СвязьУчетныхЕдиниц", Сделка.СвязьУчетныхЕдиниц.Выгрузить());
	МассивИсточниковПоявленияСтрокиЭкономики = Новый Массив;
	МассивИсточниковПоявленияСтрокиЭкономики.Добавить(Перечисления.ИсточникПоявленияСтрокиЭкономики.ОсновнаяУслугаАвтоматически);
	МассивИсточниковПоявленияСтрокиЭкономики.Добавить(Перечисления.ИсточникПоявленияСтрокиЭкономики.ДопУслугаАвтоматически);
	МассивИсточниковПоявленияСтрокиЭкономики.Добавить(Перечисления.ИсточникПоявленияСтрокиЭкономики.ФрахтИзКалькуляции);
	МассивИсточниковПоявленияСтрокиЭкономики.Добавить(Перечисления.ИсточникПоявленияСтрокиЭкономики.ЖДН);
	Запрос.УстановитьПараметр("ИсточникПоявленияСтрокиЭкономики", МассивИсточниковПоявленияСтрокиЭкономики);
	Пакеты = Запрос.ВыполнитьПакет();
	КоличествоПакетов = Пакеты.Количество();
	СтруктураРезультата = Новый Структура;
	СтруктураРезультата.Вставить("Расходы",Пакеты[КоличествоПакетов-2].Выгрузить().ВыгрузитьКолонку("ГУИД"));
	СтруктураРезультата.Вставить("СвязьУчетныхЕдиниц",Пакеты[КоличествоПакетов-1].Выгрузить().ВыгрузитьКолонку("ГУИД"));
	Возврат СтруктураРезультата;
	
КонецФункции

Процедура ИсключитьПоляСравненияЗаполненныеИзЖДН(МассивПолейДляСравнения, СтарыеДанныеВСтроке, НовыеДанныеВСтроке)
	
	ПоляДляУдаления = Новый Массив;
	УслугаФрахтаДляКалькуляции = ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьЗначениеКонстанты("УслугаФрахтаДляКалькуляции");
	//костыль для фрахта
	Если НовыеДанныеВСтроке.Услуга = УслугаФрахтаДляКалькуляции Тогда
		Если НовыеДанныеВСтроке.КалькуляцияФрахтИмпорт Тогда
			МассивПолейДляСравнения.Добавить("ПунктОтправления");
		Иначе
			МассивПолейДляСравнения.Добавить("ПунктНазначения");
		КонецЕсли;
	КонецЕсли;
	Для каждого ПолеДляСравнения Из МассивПолейДляСравнения Цикл
		Если //НовыеДанныеВСтроке.ЗаполнятьВагонИзЖДН 
			//ИЛИ
			НЕ ЗначениеЗаполнено(НовыеДанныеВСтроке.ТранспортныйДокумент)
			И ЗначениеЗаполнено(СтарыеДанныеВСтроке.ТранспортныйДокумент)
			//И СтарыеДанныеВСтроке.ЗаполнятьВагонИзЖДН)
			Тогда
			Если СтрНайти(ПолеДляСравнения, "Вагон") > 0 Тогда
				ПоляДляУдаления.Добавить(ПолеДляСравнения);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Если НовыеДанныеВСтроке.ЗаполнятьСтанциюОтправленияИзЖДН 
			ИЛИ (НЕ ЗначениеЗаполнено(НовыеДанныеВСтроке.ТранспортныйДокумент)
			И ЗначениеЗаполнено(СтарыеДанныеВСтроке.ТранспортныйДокумент)
			И СтарыеДанныеВСтроке.ЗаполнятьСтанциюОтправленияИзЖДН) Тогда
			Если СтрНайти(ПолеДляСравнения, "ПунктОтправления") > 0 Тогда
				ПоляДляУдаления.Добавить(ПолеДляСравнения);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Если НовыеДанныеВСтроке.ЗаполнятьСтанциюНазначенияИзЖДН 
			ИЛИ (НЕ ЗначениеЗаполнено(НовыеДанныеВСтроке.ТранспортныйДокумент)
			И ЗначениеЗаполнено(СтарыеДанныеВСтроке.ТранспортныйДокумент)
			И СтарыеДанныеВСтроке.ЗаполнятьСтанциюНазначенияИзЖДН) Тогда
			Если СтрНайти(ПолеДляСравнения, "ПунктНазначения") > 0 Тогда
				ПоляДляУдаления.Добавить(ПолеДляСравнения);
				Продолжить;
			КонецЕсли;
		КонецЕсли; 
		//Евросиб - АСуслов 13.09.2023 16:58:41 #74879
		//(
		Если НЕ НовыеДанныеВСтроке.ТранспортныйДокумент = Документы.ТранспортныйДокумент.ПустаяСсылка() 
			И НовыеДанныеВСтроке.ИсточникПоявленияСтрокиЭкономики = Перечисления.ИсточникПоявленияСтрокиЭкономики.ОсновнаяУслугаАвтоматически
			И НовыеДанныеВСтроке.Услуга = УслугаФрахтаДляКалькуляции Тогда
			Если СтрНайти(ПолеДляСравнения, "Пункт") > 0 Тогда
				ПоляДляУдаления.Добавить(ПолеДляСравнения);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		//)
		//Евросиб - АСуслов 13.09.2023 16:59:15 #74879
	КонецЦикла;       
	Для каждого ПолеДляУдаления Из ПоляДляУдаления Цикл
		МассивПолейДляСравнения.Удалить(МассивПолейДляСравнения.Найти(ПолеДляУдаления));
	КонецЦикла;
	
КонецПроцедуры


