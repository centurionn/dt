	|	СделкаРасходы.ГУИД КАК ГУИД,
	|	СделкаРасходы.Контейнер КАК Контейнер,
	|	СделкаРасходы.Вагон КАК Вагон,
	|	СделкаРасходы.ИсточникПоявленияСтрокиЭкономики КАК ИсточникПоявленияСтрокиЭкономики
	|ПОМЕСТИТЬ ВТ_РасходыДляОпределенияПричин
	|ИЗ
	|	ВТ_РасходыВсе КАК СделкаРасходы
	|ГДЕ
	|	НЕ СделкаРасходы.УслугаОтключена
	|	И (СделкаРасходы.ИсточникПоявленияСтрокиЭкономики = ЗНАЧЕНИЕ(Перечисление.ИсточникПоявленияСтрокиЭкономики.ДобавленоИзАкцепта)
	|			ИЛИ СделкаРасходы.ИсточникПоявленияСтрокиЭкономики = ЗНАЧЕНИЕ(Перечисление.ИсточникПоявленияСтрокиЭкономики.ПроизвольнаяУслугаВручную))
	|	И СделкаРасходы.СтрокаСвязьУчетныхЕдиниц <> """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СделкаРасходы.СтрокаСвязьУчетныхЕдиниц КАК СтрокаСвязьУчетныхЕдиниц,
	|	СделкаРасходы.ГУИД КАК ГУИД,
	|	СделкаРасходы.Контейнер КАК Контейнер,
	|	СделкаРасходы.Вагон КАК Вагон,
	|	СделкаРасходы.ИсточникПоявленияСтрокиЭкономики КАК ИсточникПоявленияСтрокиЭкономики
	|ПОМЕСТИТЬ ВТ_ВСЕРасходыНеОтключенные
	|ИЗ
	|	ВТ_РасходыВсе КАК СделкаРасходы
	|ГДЕ
	|	НЕ СделкаРасходы.УслугаОтключена
	|	И СделкаРасходы.СтрокаСвязьУчетныхЕдиниц <> """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_РасходыДляОпределенияПричин.ГУИД КАК ГУИД,
	|	ВТ_РасходыДляОпределенияПричин.СтрокаСвязьУчетныхЕдиниц КАК СтрокаСвязьУчетныхЕдиниц,
	|	ЗНАЧЕНИЕ(Перечисление.ПричиныОтключенияСтрокиРасходовСделки.ОтсутствуетСтрокаСоставаПоезда) КАК ПричинаОтключенияСтроки,
	|	ВТ_СделкаСвязьУчетныхЕдиницБезОтбора.СтрокаОтключена КАК СтрокаСУЕОтключена
	|ПОМЕСТИТЬ ВТ_РасходыДляОтключения
	|ИЗ
	|	ВТ_РасходыДляОпределенияПричин КАК ВТ_РасходыДляОпределенияПричин
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СделкаСвязьУчетныхЕдиницБезОтбора КАК ВТ_СделкаСвязьУчетныхЕдиницБезОтбора
	|		ПО ВТ_РасходыДляОпределенияПричин.СтрокаСвязьУчетныхЕдиниц = ВТ_СделкаСвязьУчетныхЕдиницБезОтбора.ГУИД
	|ГДЕ
	|	ВТ_СделкаСвязьУчетныхЕдиницБезОтбора.ГУИД ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_РасходыДляОпределенияПричин.ГУИД,
	|	ВТ_РасходыДляОпределенияПричин.СтрокаСвязьУчетныхЕдиниц,
	|	ЗНАЧЕНИЕ(Перечисление.ПричиныОтключенияСтрокиРасходовСделки.ОтключенаСтрокаСоставаПоезда),
	|	ВТ_СделкаСвязьУчетныхЕдиницБезОтбора.СтрокаОтключена
	|ИЗ
	|	ВТ_РасходыДляОпределенияПричин КАК ВТ_РасходыДляОпределенияПричин
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СделкаСвязьУчетныхЕдиницБезОтбора КАК ВТ_СделкаСвязьУчетныхЕдиницБезОтбора
	|		ПО ВТ_РасходыДляОпределенияПричин.СтрокаСвязьУчетныхЕдиниц = ВТ_СделкаСвязьУчетныхЕдиницБезОтбора.ГУИД
	|ГДЕ
	|	ВТ_СделкаСвязьУчетныхЕдиницБезОтбора.СтрокаОтключена
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_РасходыДляОпределенияПричин.ГУИД,
	|	ВТ_РасходыДляОпределенияПричин.СтрокаСвязьУчетныхЕдиниц,
	|	ЗНАЧЕНИЕ(Перечисление.ПричиныОтключенияСтрокиРасходовСделки.ОтличаетсяВагонВСтрокеСоставаПоезда),
	|	ВТ_СделкаСвязьУчетныхЕдиницБезОтбора.СтрокаОтключена
	|ИЗ
	|	ВТ_РасходыДляОпределенияПричин КАК ВТ_РасходыДляОпределенияПричин
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СделкаСвязьУчетныхЕдиницБезОтбора КАК ВТ_СделкаСвязьУчетныхЕдиницБезОтбора
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаПоСсылкеСвязьУчетныхЕдиниц
	|			ПО ВТ_СделкаСвязьУчетныхЕдиницБезОтбора.ГУИД = СделкаПоСсылкеСвязьУчетныхЕдиниц.ГУИД
	|				И (СделкаПоСсылкеСвязьУчетныхЕдиниц.Ссылка = &Сделка)
	|		ПО ВТ_РасходыДляОпределенияПричин.СтрокаСвязьУчетныхЕдиниц = ВТ_СделкаСвязьУчетныхЕдиницБезОтбора.ГУИД
	|ГДЕ
	|	НЕ ЕСТЬNULL(ВТ_СделкаСвязьУчетныхЕдиницБезОтбора.СтрокаОтключена, ИСТИНА)
	|	И ВТ_РасходыДляОпределенияПричин.ИсточникПоявленияСтрокиЭкономики = ЗНАЧЕНИЕ(Перечисление.ИсточникПоявленияСтрокиЭкономики.ДобавленоИзАкцепта)
	|	И ВЫБОР
	|			КОГДА &ПовагонныеОтправки
	|				ТОГДА ВЫБОР
	|						КОГДА ВТ_РасходыДляОпределенияПричин.Вагон = ЗНАЧЕНИЕ(Справочник.ТС.ПустаяСсылка)
	|							ТОГДА ЛОЖЬ
	|						ИНАЧЕ ВТ_РасходыДляОпределенияПричин.Вагон <> ВТ_СделкаСвязьУчетныхЕдиницБезОтбора.Вагон
	|					КОНЕЦ
	|		КОНЕЦ
	|	И ВТ_СделкаСвязьУчетныхЕдиницБезОтбора.Вагон <> СделкаПоСсылкеСвязьУчетныхЕдиниц.Вагон
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_РасходыДляОпределенияПричин.ГУИД,
	|	ВТ_РасходыДляОпределенияПричин.СтрокаСвязьУчетныхЕдиниц,
	|	ЗНАЧЕНИЕ(Перечисление.ПричиныОтключенияСтрокиРасходовСделки.ОтличаетсяКонтейнерВСтрокеСоставаПоезда),
	|	ВТ_СделкаСвязьУчетныхЕдиницБезОтбора.СтрокаОтключена
	|ИЗ
	|	ВТ_РасходыДляОпределенияПричин КАК ВТ_РасходыДляОпределенияПричин
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СделкаСвязьУчетныхЕдиницБезОтбора КАК ВТ_СделкаСвязьУчетныхЕдиницБезОтбора
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаПоСсылкеСвязьУчетныхЕдиниц
	|			ПО ВТ_СделкаСвязьУчетныхЕдиницБезОтбора.ГУИД = СделкаПоСсылкеСвязьУчетныхЕдиниц.ГУИД
	|				И (СделкаПоСсылкеСвязьУчетныхЕдиниц.Ссылка = &Сделка)
	|		ПО ВТ_РасходыДляОпределенияПричин.СтрокаСвязьУчетныхЕдиниц = ВТ_СделкаСвязьУчетныхЕдиницБезОтбора.ГУИД
	|ГДЕ
	|	НЕ ЕСТЬNULL(ВТ_СделкаСвязьУчетныхЕдиницБезОтбора.СтрокаОтключена, ИСТИНА)
	|	И ВТ_РасходыДляОпределенияПричин.ИсточникПоявленияСтрокиЭкономики = ЗНАЧЕНИЕ(Перечисление.ИсточникПоявленияСтрокиЭкономики.ДобавленоИзАкцепта)
	|	И ВЫБОР
	|			КОГДА НЕ &ПовагонныеОтправки
	|				ТОГДА ВЫБОР
	|						КОГДА ВТ_РасходыДляОпределенияПричин.Контейнер = ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
	|							ТОГДА ЛОЖЬ
	|						ИНАЧЕ ВТ_РасходыДляОпределенияПричин.Контейнер <> ВТ_СделкаСвязьУчетныхЕдиницБезОтбора.Контейнер
	|					КОНЕЦ
	|		КОНЕЦ
	|	И ВТ_СделкаСвязьУчетныхЕдиницБезОтбора.Контейнер <> СделкаПоСсылкеСвязьУчетныхЕдиниц.Контейнер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_РасходыДляОтключения.ГУИД КАК ГУИД,
	|	ВТ_РасходыДляОтключения.СтрокаСвязьУчетныхЕдиниц КАК СтрокаСвязьУчетныхЕдиниц,
	|	ВТ_РасходыДляОтключения.ПричинаОтключенияСтроки КАК ПричинаОтключенияСтроки,
	|	ВТ_РасходыДляОтключения.СтрокаСУЕОтключена КАК СтрокаСУЕОтключена
	|ИЗ
	|	ВТ_РасходыДляОтключения КАК ВТ_РасходыДляОтключения
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ВСЕРасходыНеОтключенные.ГУИД,
	|	ВТ_ВСЕРасходыНеОтключенные.СтрокаСвязьУчетныхЕдиниц,
	|	ЗНАЧЕНИЕ(Перечисление.ПричиныОтключенияСтрокиРасходовСделки.РучноеОтключениеСтрокиСоставаПоезда),
	|	ВТ_СделкаСвязьУчетныхЕдиницБезОтбора.СтрокаОтключена
	|ИЗ
	|	ВТ_ВСЕРасходыНеОтключенные КАК ВТ_ВСЕРасходыНеОтключенные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СделкаСвязьУчетныхЕдиницБезОтбора КАК ВТ_СделкаСвязьУчетныхЕдиницБезОтбора
	|		ПО ВТ_ВСЕРасходыНеОтключенные.СтрокаСвязьУчетныхЕдиниц = ВТ_СделкаСвязьУчетныхЕдиницБезОтбора.ГУИД
	|			И (ВТ_СделкаСвязьУчетныхЕдиницБезОтбора.ОтключитьРасходы)
	|ГДЕ
	|	НЕ ВТ_ВСЕРасходыНеОтключенные.ГУИД В
	|				(ВЫБРАТЬ
	|					ВТ_РасходыДляОтключения.ГУИД
	|				ИЗ
	|					ВТ_РасходыДляОтключения КАК ВТ_РасходыДляОтключения)";
	//ДИТ, Беляев СЮ, BUG 82454, 16-04-2024, конец
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц", "&СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Сделка.Расходы", "&Расходы");
	
	Запрос.УстановитьПараметр("СвязьУчетныхЕдиниц", Сделка.СвязьУчетныхЕдиниц.Выгрузить());
	Запрос.УстановитьПараметр("Расходы", Сделка.Расходы.Выгрузить());
	Запрос.УстановитьПараметр("СвязьДоходовИРасходов", Сделка.СвязьДоходовИРасходов.Выгрузить());        
	Запрос.УстановитьПараметр("ПовагонныеОтправки", Сделка.ПовагонныеОтправки);
	Запрос.УстановитьПараметр("Сделка", Сделка.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтрокаРасхода = Сделка.Расходы.Найти(ВыборкаДетальныеЗаписи.ГУИД, "ГУИД");
		СтрокаРасхода.УслугаОтключена = Истина;
		//Евросиб Каблов 06.10.2023 ( Ticket#0327386
		//СтрокаРасхода.ПричинаОтключенияСтроки = Перечисления.ПричиныОтключенияСтрокиРасходовСделки.ОтвязываниеСтрокиАкцептаОтСделки;
		СтрокаРасхода.ПричинаОтключенияСтроки = ВыборкаДетальныеЗаписи.ПричинаОтключенияСтроки;
		//Евросиб Каблов 06.10.2023 )
	КонецЦикла;
	
КонецПроцедуры
