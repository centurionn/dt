		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 1", "");
	Иначе	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 1", СтрШаблон("ПЕРВЫЕ %1", КоличествоСделок));
	КонецЕсли;
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;       
	Выборка = РезультатЗапроса.Выбрать();
	МассивОтработанныхСделок = Новый Массив;
	ВсегоСделок = Выборка.Количество();     
	Итератор = 0;
	// Евросиб Фролов (03.03.2022
	МассивОшибок = Новый Массив;
	// Евросиб Фролов)
	Пока Выборка.Следующий() Цикл           
		Итератор = Итератор + 1;
		обСделка = Выборка.Сделка.ПолучитьОбъект();                
		ГоризонтПоискаНакладных = ?(обСделка.ГоризонтПоискаНакладных = 0, 40, обСделка.ГоризонтПоискаНакладных);
		
		//РаботаСоСделкамиСервер.ПодобратьНакладныеВСделку(обСделка, ГоризонтПоискаНакладных, МассивОшибок);		
		//ДИТ, Беляев СЮ, Ticket#0269524, 27-04-2022, начало //результат функции ПодобратьНакладныеВСделку() не используем, есть неточности    
		ТаблицаСУЕдоИзменений = обСделка.СвязьУчетныхЕдиниц.Выгрузить();
		РаботаСоСделкамиСервер.ПодобратьНакладныеВСделку(обСделка, ГоризонтПоискаНакладных, МассивОшибок); 
		ТаблицаСУЕпослеИзменений = обСделка.СвязьУчетныхЕдиниц.Выгрузить();
		ФлагНаличияИзменений = НЕ ОбщегоНазначения.КоллекцииИдентичны(ТаблицаСУЕдоИзменений, ТаблицаСУЕпослеИзменений,,, Истина); 
		//ДИТ, Беляев СЮ, Ticket#0269524, 27-04-2022, конец
		
		// Евросиб Фролов (03.03.2022
		// Добавил проведение в попытку, т.к. мог возникать конфликт блокировок.
		// Ошибки собираем в массив, чтобы после выполнения задания отправить их на почту.
		Попытка 
			//обСделка.Записать(РежимЗаписиДокумента.Проведение);
			//ДИТ, Беляев СЮ, Ticket#0269524, 27-04-2022, начало
			Если ФлагНаличияИзменений Тогда
				обСделка.Записать(РежимЗаписиДокумента.Проведение);
			КонецЕсли;
			//ДИТ, Беляев СЮ, Ticket#0269524, 27-04-2022, конец
			МассивОтработанныхСделок.Добавить(Выборка.Сделка);
			РегистрыСведений.ПротоколАвтоподбораЖДНВСделки.ДобавитьЗапись(Выборка.Сделка);
		Исключение
			ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации("ПодборЖДННакладныхВСделки.Проведение сделки",
    												УровеньЖурналаРегистрации.Предупреждение,, Выборка.Сделка, ПредставлениеОшибки);
			МассивОшибок.Добавить("" + Выборка.Сделка + ": " + ПредставлениеОшибки);
		КонецПопытки;
		// Евросиб Фролов)			
		ДлительныеОперации.СообщитьПрогресс(Итератор/ВсегоСделок * 100, Выборка.Сделка); 
	КонецЦикла;                                           
	ПоместитьВоВременноеХранилище(МассивОтработанныхСделок, АдресРезультата);
	// Евросиб Фролов (03.03.2022
	Если МассивОшибок.Количество() > 0 Тогда
		Тема = "Рег. задание: Подбор ЖДН накладных в сделки";
		ТекстСообщения = "Во время выполнения рег. задания произошли следующие ошибки:
						|" + СтрСоединить(МассивОшибок, Символы.ПС);
		ВыполнитьОтправкуУведомлений(Тема, ТекстСообщения, Метаданные.РегламентныеЗадания.ПодборЖДННакладныхВСделки);
	КонецЕсли;
	// Евросиб Фролов)
КонецПроцедуры

