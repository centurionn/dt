Функция ПерезаполнениеРейсовВЗаявке(Сделка,Заявка,НадоЗаписатьРейсыЗаявки = Ложь) Экспорт // Евросиб(ДИТ) Bug 96219 ТА 96254 Шевченко А.В. 26.11.2024
	
	ЗСсылка = Заявка.Ссылка;
	//ДИТ, Беляев СЮ, BUG 51934\TASK 57123, 05-04-2023, начало
	НадоЗаписать_РеестрКлиента = Ложь;
	НадоЗаписать_ВремяПрибытияНаТерминал = Ложь;    
	// Евросиб(ДИТ) US 88359 ТА 88360 Сержантова А.С. Начало: 16.07.2024 
	//Если по заявке из строки состава поезда удалили рейс, то удалим рейс из заявки  
	СтрокиСоставаПоезда = Сделка.СвязьУчетныхЕдиниц.НайтиСтроки(Новый Структура("Заявка", ЗСсылка)); 
	РейсыЗаявкиДоЗаписи = Новый Массив;
	
	МассивСтрокКУдалению = Новый Массив;
	Для Каждого СтрокаПереченьРейсов Из Заявка.ПереченьРейсов Цикл
		//Евросиб(ДИТ), Беляев СЮ, Ticket#0380056, 17-12-2024, начало
		Если ТипЗнч(СтрокаПереченьРейсов.Рейс) <> Тип("СправочникСсылка.РейсыЖД") Тогда
			Продолжить;
		КонецЕсли;
		//Евросиб(ДИТ), Беляев СЮ, Ticket#0380056, 17-12-2024, конец
		Если ЗначениеЗаполнено(СтрокаПереченьРейсов.Рейс) И СтрокаПереченьРейсов.Пользователь = Справочники.Пользователи.ПустаяСсылка() Тогда
			Если  Сделка.СвязьУчетныхЕдиниц.НайтиСтроки(Новый Структура("Заявка,ЖДРейс", ЗСсылка, СтрокаПереченьРейсов.Рейс)).Количество() = 0 Тогда
				МассивСтрокКУдалению.Добавить(СтрокаПереченьРейсов);	
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	
	Если МассивСтрокКУдалению.Количество() > 0 Тогда	
		Для Каждого СтрокаКУдалению Из МассивСтрокКУдалению Цикл
			Если ТипЗнч(Заявка) = Тип("ДокументОбъект.Заявка") Тогда
				Заявка.ПереченьРейсов.Удалить(СтрокаКУдалению);
			КонецЕсли;
			НадоЗаписатьРейсыЗаявки = Истина;
		КонецЦикла;				
	КонецЕсли;	
	
	// Евросиб(ДИТ) US 88359 ТА 88360 Сержантова А.С. Конец: 16.07.2024
	Для каждого СтрокаСУЕ из Сделка.СвязьУчетныхЕдиниц.НайтиСтроки(Новый Структура("Заявка", ЗСсылка)) Цикл 
		// Евросиб(ДИТ) US 88359 ТА 88360 Сержантова А.С. Начало: 16.07.2024
		// Добавляем рейсы в заявку
		Если ЗначениеЗаполнено(СтрокаСУЕ.ЖДРейс) и Сделка.Рейсы.Найти(СтрокаСУЕ.ЖДРейс) <> Неопределено 
			и Заявка.ПереченьРейсов.Найти(СтрокаСУЕ.ЖДРейс, "Рейс") = Неопределено Тогда
			Если ТипЗнч(Заявка) = Тип("ДокументОбъект.Заявка") Тогда
				СтрокаРейса = Заявка.ПереченьРейсов.Добавить(); 
				СтрокаРейса.Рейс = СтрокаСУЕ.ЖДРейс;  
				СтрокаРейса.Продукт = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаСУЕ.ЖДРейс, "Продукт");
			КонецЕсли;
			НадоЗаписатьРейсыЗаявки = Истина;
		КонецЕсли;
		// Евросиб(ДИТ) US 88359 ТА 88360 Сержантова А.С. Конец: 16.07.2024
		Если НЕ ЗначениеЗаполнено(СтрокаСУЕ.Коносамент) И НЕ ЗначениеЗаполнено(СтрокаСУЕ.ВремяПрибытияНаТерминал) Тогда 
			Продолжить; 
		КонецЕсли;
		Для каждого СтрокаЗаявки из Заявка.СоставУслуги.НайтиСтроки(Новый Структура("ГУИДСтроки", СтрокаСУЕ.ГУИДСтрокиЗаявки)) Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаЗаявки.НомерКТК) Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(СтрокаЗаявки.РеестрКлиента) И ЗначениеЗаполнено(СтрокаСУЕ.Коносамент.НомерТранспортногоДокумента) Тогда
				Если ТипЗнч(Заявка) = Тип("ДокументОбъект.Заявка") Тогда
					СтрокаЗаявки.РеестрКлиента = СтрокаСУЕ.Коносамент.НомерТранспортногоДокумента;
				КонецЕсли;
				НадоЗаписать_РеестрКлиента = Истина;					
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(СтрокаЗаявки.ВремяПрибытияНаТерминал) И ЗначениеЗаполнено(СтрокаСУЕ.ВремяПрибытияНаТерминал) Тогда
				Если ТипЗнч(Заявка) = Тип("ДокументОбъект.Заявка") Тогда
					СтрокаЗаявки.ВремяПрибытияНаТерминал = СтрокаСУЕ.ВремяПрибытияНаТерминал;
				КонецЕсли;
				НадоЗаписать_ВремяПрибытияНаТерминал = Истина;					
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если НадоЗаписать_РеестрКлиента ИЛИ НадоЗаписать_ВремяПрибытияНаТерминал 
		// Евросиб(ДИТ) US 88359 ТА 88360 Сержантова А.С. Начало: 16.07.2024
		ИЛИ НадоЗаписатьРейсыЗаявки Тогда
		// Евросиб(ДИТ) US 88359 ТА 88360 Сержантова А.С. Конец: 16.07.2024
		Возврат Истина;
	КонецЕсли;
	//ДИТ, Беляев СЮ, BUG 51934\TASK 57123, 05-04-2023, конец
	
	Возврат Ложь;
	
КонецФункции	

//Евросиб Шевченко А.В. 15.05.2025 US 95275 TA 106445
Функция ПолучитьДополнениеУслугиСчета(НовСчет, ПараметрыФФД, ВыводитьКурс, РасчетСНП, Валюта) Экспорт
	
	Результат = "";
	
	Если ПараметрыФФД = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = ПараметрыФФД.ТекстДополненияУслугиРТУ;
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтрокаКурса = "";
	
	Если ВыводитьКурс Тогда
		
		КурсВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Валюта, НовСчет.ДатаКурса);
		
		СтрокаКурса = "Курс " + НовСчет.ВалютаДокумента + " / " + Валюта + " " + Формат(НовСчет.ДатаКурса,"ДФ=dd.MM.yyyy") + " " + КурсВалюты.Курс;
	КонецЕсли;
	
	СтрокаДатыСНП = "";
	
	Если ЗначениеЗаполнено(РасчетСНП) Тогда
		
		ДатаНачала = Дата(1,1,1);
		ДатаОкончания = Дата(1,1,1);
		
		Если ЗначениеЗаполнено(РасчетСНП.ДатаНачалаСНПРед) Тогда			
			ДатаНачала = РасчетСНП.ДатаНачалаСНПРед + (РасчетСНП.НормативныйСрок * 86400);			
		ИначеЕсли ЗначениеЗаполнено(РасчетСНП.ФактическаяДатаНачалаПоДаннымКлиента) Тогда			
			ДатаНачала = РасчетСНП.ФактическаяДатаНачалаПоДаннымКлиента + (РасчетСНП.НормативныйСрок * 86400);	
		ИначеЕсли ЗначениеЗаполнено(РасчетСНП.ФактическаяДатаНачалаПоДаннымПодрядчика) Тогда
			ДатаНачала = РасчетСНП.ФактическаяДатаНачалаПоДаннымПодрядчика + (РасчетСНП.НормативныйСрок * 86400);
		КонецЕсли;	
			
		Если ЗначениеЗаполнено(РасчетСНП.ДатаОкончанияСНПРед) Тогда			
			ДатаОкончания = РасчетСНП.ДатаОкончанияСНПРед;			
		ИначеЕсли ЗначениеЗаполнено(РасчетСНП.ФактическаяДатаОкончанияПоДаннымКлиента) Тогда			
			ДатаОкончания = РасчетСНП.ФактическаяДатаОкончанияПоДаннымКлиента;	
		ИначеЕсли ЗначениеЗаполнено(РасчетСНП.ФактическаяДатаОкончанияПоДаннымПодрядчика) Тогда
			ДатаОкончания = РасчетСНП.ФактическаяДатаОкончанияПоДаннымПодрядчика;
		КонецЕсли;
		
		СтрокаДатыСНП = "Даты СНП: " + Формат(ДатаНачала,"ДФ=dd.MM.yyyy") + " - " + Формат(ДатаОкончания,"ДФ=dd.MM.yyyy");			
	КонецЕсли;	
	
	ЗаменаСоответствие = Новый Соответствие;
	ЗаменаСоответствие.Вставить("##КурсВалютыДляСНП", СтрокаКурса);
	ЗаменаСоответствие.Вставить("##ДатыСНП", СтрокаДатыСНП);
	
	Для каждого Замена Из ЗаменаСоответствие Цикл
		Результат = СтрЗаменить(Результат, Замена.Ключ, Замена.Значение);	
	КонецЦикла;
	
	Результат = Символы.ПС + Результат; //добавим пробел
	
	Возврат Результат;
	
КонецФункции
//Евросиб Шевченко А.В. 15.05.2025 US 95275 TA 106445

//Евросиб(ДИТ), Беляев СЮ, US 93521 / TA 94125, 13-12-2024, начало
Функция ПолучитьДополнениеУслугиОтчетаКомитенту(НовОтчет, ПараметрыФФД) Экспорт
	
	Результат = "";
	
	Если ПараметрыФФД = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = ПараметрыФФД.ТекстДополненияУслугиОтчетКомитенту;
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтрокаТЧПоставщики = НовОтчет.Поставщики[0];
	
	ЗаменаСоответствие = Новый Соответствие;
	ЗаменаСоответствие.Вставить("##ДатаСФ", Формат(СтрокаТЧПоставщики.ДатаСФ,"ДФ=dd.MM.yyyy"));
	
	Для каждого Замена Из ЗаменаСоответствие Цикл
		Результат = СтрЗаменить(Результат, Замена.Ключ, Замена.Значение);	
	КонецЦикла;
	
	Результат = " "+Результат; //добавим пробел
	
	Возврат Результат;
	
КонецФункции
