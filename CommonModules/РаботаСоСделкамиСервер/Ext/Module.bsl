Функция ВнестиДанныеНакладныхВСделку(СписокНакладных, Сделка, ДобавитьВДоходы, ДобавитьВРасходы) Экспорт
	
	Если Сделка = ИСТИНА Тогда
		Сделка = СоздатьСлужебнуюСделкуДляНакладных();
	КонецЕсли;
	
	СделкаОбъект = Сделка.ПолучитьОбъект();
	
	// Евросиб Фролов (26.10.2021 Ticket№ 41408
	МассивСозданныхКТК = Новый Массив;
	// Евросиб Фролов)
	
	Для каждого Стр из СписокНакладных Цикл
		
		НСтр = СделкаОбъект.СвязьУчетныхЕдиниц.Добавить();
		
		КТКСсылка = РаботаСКонтейнерамиСервер.СоздатьКТК(Стр.Контейнер, Справочники.ТипоразмерыТЕ.ПустаяСсылка());
		НСтр.Контейнер = КТКСсылка;
		НСтр.РазмерКТК = КТКСсылка.ТипТЕ.РазмерКТК;
		
		НСтр.Груз = Справочники.Грузы.НайтиПоРеквизиту("ЕТСНГ", Стр.Груз.Код);
		
		ВагонСсылка = РаботаСКонтейнерамиСервер.ПолучитьВагонПоНомеру(Стр.Вагон, Истина);
		НСтр.Вагон = ВагонСсылка;
		
		//Евросиб - АСуслов 19.01.2022 10:17:57 #0257100
		//(
		РеквизитыЖДН = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Стр.ЖДН,"НакладнаяНомер, Дата, СтанцияОтправления, СтанцияНазначения");
		НСтр.НомерЖДН = РеквизитыЖДН.НакладнаяНомер; 
		//НСтр.ЖДН = ТранспортныеДокументы_сервер.НайтиТранспортныйДокумент(НСтр.НомерЖДН, НСтр.ДатаЖДН, Перечисления.ВидыОперацийТранспортныхДокументов.ЖДНакладная);		
		НСтр.ЖДН = ТранспортныеДокументы_сервер.НайтиТранспортныйДокумент(НСтр.НомерЖДН, РеквизитыЖДН.Дата, Перечисления.ВидыОперацийТранспортныхДокументов.ЖДНакладная);		
		
		СделкаОбъект.СтанцияОтправления = РеквизитыЖДН.СтанцияОтправления;
		СделкаОбъект.СтанцияНазначения = РеквизитыЖДН.СтанцияНазначения;
		//)
		//Евросиб - АСуслов 19.01.2022 10:17:57 #0257100
					
		НСтр.ПравилоГотовностиКВыставлению = Перечисления.ПравилоГотовностиКВыставлению.Вручную;
		НСтр.ВесГрузаНетто = Стр.ВесГруза;
		НСтр.Груженый = (НСтр.ВесГрузаНетто > 0);
		
		// Евросиб Фролов (26.10.2021 Ticket№ 41408
		МассивСозданныхКТК.Добавить(КТКСсылка);
		// Евросиб Фролов)
		
	КонецЦикла;
	
	// Евросиб Фролов (26.10.2021 Ticket№ 41408
	Если МассивСозданныхКТК.Количество() > 0 Тогда
		РаботаСКонтейнерамиСервер.ДобавитьИнформациюОбИсточникеСозднияКонтейнеров(МассивСозданныхКТК, НСтр("ru = 'АРМ ""Накладные""'"));
	КонецЕсли;	
	// Евросиб Фролов)
	
	Если СделкаОбъект.Рейсы.Количество() = 0 Тогда
		СделкаОбъект.Рейсы.Добавить().Рейс = Справочники.РейсыЖД.БезРейса;
	КонецЕсли;
	
	СделкаОбъект.Записать();
	Возврат СделкаОбъект.Ссылка;
	
КонецФункции

Функция ВнестиДанныеАкцептаВСделку(СписокВыбранныхСтрок, Сделка, ДобавитьВДоходы, ДобавитьВРасходы) Экспорт
	
	Если Сделка = ИСТИНА Тогда
		Сделка = СоздатьСлужебнуюСделкуДляНакладных();
	КонецЕсли;
	
	СделкаОбъект = Сделка.ПолучитьОбъект();
	
	РезультатРазнесения = новый Массив;
	
	Для каждого Стр из СписокВыбранныхСтрок Цикл
		
		СтрокаРасхода = СделкаОбъект.Расходы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРасхода, Стр);
		СтрокаРасхода.ГУИД = Строка(Новый УникальныйИдентификатор());
		Если ТипЗнч(Стр.ТипВагонов) = Тип("СправочникСсылка.ТС") Тогда СтрокаРасхода.ТипВагонов = Стр.ТипВагонов.ТипТС; КонецЕсли;
		Если ТипЗнч(Стр.ТипКТК) = Тип("СправочникСсылка.ТЕ") Тогда СтрокаРасхода.ТипКТК = Стр.ТипКТК.ТипТЕ; КонецЕсли;
		СтрокаРасхода.ВнутренняяСебестоимость = НЕ ДобавитьВДоходы;
		СтрокаРасхода.Перевыставляемая = ДобавитьВДоходы;
		
		СтрокаРасхода.СебестоимостьИтого	= СтрокаРасхода.Себестоимость * СтрокаРасхода.Количество;
		СтрокаРасхода.СуммаНДС 				= БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(СтрокаРасхода.СебестоимостьИтого, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(СтрокаРасхода.СтавкаНДС), Истина, СтрокаРасхода.НДСВключенВСтоимость);
		СтрокаРасхода.СуммаИтого 			= СтрокаРасхода.СебестоимостьИтого + ?(СтрокаРасхода.НДСВключенВСтоимость, 0, СтрокаРасхода.СуммаНДС);
		
		Если ЗначениеЗаполнено(Стр.Контейнер) Тогда
			СтрокаКТК = СделкаОбъект.ДоходыКТК.Добавить();
			СтрокаКТК.ГУИД = СтрокаРасхода.ГУИД;
			СтрокаКТК.КТК = Стр.Контейнер;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.Вагон) Тогда
			СтрокаКТК = СделкаОбъект.ДоходыВагоны.Добавить();
			СтрокаКТК.ГУИД = СтрокаРасхода.ГУИД;
			СтрокаКТК.Вагон = Стр.Вагон;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.ТД) Тогда
			СтрокаКТК = СделкаОбъект.ДоходыТД.Добавить();
			СтрокаКТК.ГУИД = СтрокаРасхода.ГУИД;
			СтрокаКТК.ТД = Стр.ТД.НомерТранспортногоДокумента;
		КонецЕсли;
		
		РезультатРазнесения.Добавить(Новый Структура("ИсхНомерСтроки, Сделка, ГУИДРасходов", Стр.НомерИсходнойСтроки, Сделка, СтрокаРасхода.ГУИД));
		
		Если ДобавитьВДоходы Тогда
			
			СтрокаДохода = СделкаОбъект.Доходы.Добавить();
			//ДИТ, Беляев СЮ, ТА48688, 28-03-2022, начало 
			СтрокаДохода.ДатаПоявленияСтрокиЭкономики = ТекущаяДата();
			//ДИТ, Беляев СЮ, ТА48688, 28-03-2022, конец
			ЗаполнитьЗначенияСвойств(СтрокаДохода, Стр,,"Договор");
			СтрокаДохода.ГУИД = Строка(Новый УникальныйИдентификатор());
			Если ТипЗнч(Стр.ТипВагонов) = Тип("СправочникСсылка.ТС") Тогда СтрокаДохода.ТипВагонов = Стр.ТипВагонов.ТипТС; КонецЕсли;
			Если ТипЗнч(Стр.ТипКТК) = Тип("СправочникСсылка.ТЕ") Тогда СтрокаДохода.ТипКТК = Стр.ТипКТК.ТипТЕ; КонецЕсли;
			СтрокаДохода.Перевыставляемая = ДобавитьВДоходы;
			СтрокаДохода.Ставка = СтрокаДохода.Себестоимость;
			СтрокаДохода.РазмерКТК = СтрокаДохода.ТипКТК.РазмерКТК;
			
			Если ЗначениеЗаполнено(Стр.Контейнер) Тогда
				СтрокаКТК = СделкаОбъект.ДоходыКТК.Добавить();
				СтрокаКТК.ГУИД = СтрокаДохода.ГУИД;
				СтрокаКТК.КТК = Стр.Контейнер;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Стр.Вагон) Тогда
				СтрокаКТК = СделкаОбъект.ДоходыВагоны.Добавить();
				СтрокаКТК.ГУИД = СтрокаДохода.ГУИД;
				СтрокаКТК.Вагон = Стр.Вагон;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Стр.ТД) Тогда
				СтрокаКТК = СделкаОбъект.ДоходыТД.Добавить();
				СтрокаКТК.ГУИД = СтрокаДохода.ГУИД;
				СтрокаКТК.ТД = Стр.ТД.НомерТранспортногоДокумента;
			КонецЕсли;
			
			//Евросиб Каблов 01.04.2021 (
			//СтрСвязь = СделкаОбъект.СвязьДоходовИРасходов.Добавить();
			//СтрСвязь.Доходы = СтрокаДохода.ГУИД;
			//СтрСвязь.Расходы = СтрокаРасхода.ГУИД;
			
			ПараметрыОтбораСУЕ = Новый Структура;
			ПараметрыОтбораСУЕ.Вставить("Контейнер", Стр.ТД);
			ПараметрыОтбораСУЕ.Вставить("Вагон", Стр.Вагон);
			ПараметрыОтбораСУЕ.Вставить("Накладная", Стр.Накладная);
			ДобавитьСвязьДоходыРасходы(СделкаОбъект, СтрокаДохода.ГУИД, СтрокаРасхода.ГУИД, Неопределено, СтрокаДохода.Услуга, ПараметрыОтбораСУЕ);
			//Евросиб Каблов 01.04.2021 )
			
		КонецЕсли;
		
	КонецЦикла;
	
	
	СделкаОбъект.Записать();
	Возврат Новый Структура("Сделка, РезультатРазнесения", СделкаОбъект.Ссылка, РезультатРазнесения);
	
КонецФункции

//Евросиб Каблов 01.04.2021 
Функция ДобавитьСвязьДоходыРасходы(СделкаОбъект, ГУИДДоходы, ГУИДРасходы, Знач ГУИДСУЕ, Услуга, ПараметрыОтбораСУЕ) Экспорт
	
	Если Не ЗначениеЗаполнено(ГУИДСУЕ) Тогда
		
		ВсеПараметрыОтбора = Новый Структура;
		
		ЗначениеПараметра = Неопределено;
		Если ПараметрыОтбораСУЕ.Свойство("Контейнер", ЗначениеПараметра) И ЗначениеЗаполнено(ЗначениеПараметра) Тогда
			ВсеПараметрыОтбора.Вставить("Контейнер", ЗначениеПараметра);
		КонецЕсли;
		
		Если ПараметрыОтбораСУЕ.Свойство("Вагон", ЗначениеПараметра) И ЗначениеЗаполнено(ЗначениеПараметра) Тогда
			ВсеПараметрыОтбора.Вставить("Вагон", ЗначениеПараметра);
		КонецЕсли;
		
		Если ПараметрыОтбораСУЕ.Свойство("Накладная", ЗначениеПараметра) И ЗначениеЗаполнено(ЗначениеПараметра) Тогда
			ВсеПараметрыОтбора.Вставить("Накладная", ЗначениеПараметра);
		КонецЕсли;
				
		ПараметрыОтбора = ОбщегоНазначенияКлиентСервер.СкопироватьРекурсивно(ВсеПараметрыОтбора);		
		Если ПараметрыОтбора.Количество() > 0 Тогда
		
			НайденныеСтроки = СделкаОбъект.СвязьУчетныхЕдиниц.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() > 0 Тогда
				ГУИДСУЕ = НайденныеСтроки[0].ГУИД;
			КонецЕсли;			
		
		КонецЕсли; 
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ГУИДДоходы) Тогда
		//Евросиб - АСуслов 21.09.2021 18:13:02 #
		//(
		//СделкаОбъект.СвязатьДоходыРасходыСУЕ(ГУИДДоходы, Неопределено, ГУИДСУЕ, Услуга);
		Документы.Сделка.СвязатьДоходыРасходыСУЕ(СделкаОбъект, ГУИДДоходы, Неопределено, ГУИДСУЕ, Услуга);
		//)
		//Евросиб - АСуслов 21.09.2021 18:13:03 #
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ГУИДРасходы) Тогда
		Документы.Сделка.СвязатьДоходыРасходыСУЕ(СделкаОбъект, Неопределено, ГУИДРасходы, ГУИДСУЕ, Услуга);
	КонецЕсли;
	
КонецФункции

Функция СоздатьСлужебнуюСделкуДляНакладных(ТипЗаказа = неопределено) Экспорт
	
	Если ТипЗаказа = неопределено Тогда
		ТипЗаказа = Справочники.ТипыЗаказов.КонтейнерныйПоезд;
	КонецЕсли;
	
	НДок = Документы.Сделка.СоздатьДокумент();
	НДок.Заполнить(неопределено);
	НДок.ТипЗаказа = ТипЗаказа;
	НДок.СтанцияОтправления = Справочники.Локации.ВСЕ;
	НДок.СтанцияНазначения = Справочники.Локации.ВСЕ;
	НДок.Дата = ТекущаяДата();
	Ндок.Рейсы.Добавить().Рейс = Справочники.РейсыЖД.БезРейса;
	//Евросиб Каблов 10.03.2021 (
	НДок.Служебная = Истина;
	//Евросиб Каблов 10.03.2021 )
	НДок.Записать(РежимЗаписиДокумента.Проведение);
	Возврат НДок.Ссылка;
	
КонецФункции

Функция ПолучитьСуммуНакладнойПоПараметрам(э_Накладная, Вагон, Контейнер) Экспорт
	
	Результат = 0;
	
	Если Результат = 0 Тогда
		Для каждого Стр из э_Накладная.ПровозныеПлатежиИСборыПоОтправлению Цикл
			Если (НЕ ЗначениеЗаполнено(Стр.НомерВагона) ИЛИ Стр.НомерВагона = Строка(Вагон)) И (НЕ ЗначениеЗаполнено(Стр.НомерКонтейнера) ИЛИ Стр.НомерКонтейнера = Строка(Контейнер)) Тогда Результат = Результат + Стр.СуммаВРублях; КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Результат = 0 Тогда
		Для каждого Стр из э_Накладная.ПровозныеПлатежиИСборыПоПрибытию Цикл
			Если (НЕ ЗначениеЗаполнено(Стр.НомерВагона) ИЛИ Стр.НомерВагона = Строка(Вагон)) И (НЕ ЗначениеЗаполнено(Стр.НомерКонтейнера) ИЛИ Стр.НомерКонтейнера = Строка(Контейнер)) Тогда Результат = Результат + Стр.СуммаВРублях; КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Результат = 0 Тогда
		Для каждого Стр из э_Накладная.ПровозныеПлатежиИСборыПоВходу Цикл
			Если (НЕ ЗначениеЗаполнено(Стр.НомерВагона) ИЛИ Стр.НомерВагона = Строка(Вагон)) И (НЕ ЗначениеЗаполнено(Стр.НомерКонтейнера) ИЛИ Стр.НомерКонтейнера = Строка(Контейнер)) Тогда Результат = Результат + Стр.СуммаВРублях; КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ПодборВСделкиНакладныеПослеГруженого() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ПотребностьПоискаНакладнойПослеГруженогоПлечаОстатки.Сделка КАК Сделка
	               |ИЗ
	               |	РегистрНакопления.ПотребностьПоискаНакладнойПослеГруженогоПлеча.Остатки КАК ПотребностьПоискаНакладнойПослеГруженогоПлечаОстатки
	               |ГДЕ
	               |	ПотребностьПоискаНакладнойПослеГруженогоПлечаОстатки.ПоискОстаток > 0";
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		СделкаОбъект = Ответ.Сделка.ПолучитьОбъект();
		РЕЗЗапуска = СделкаОбъект.ПодобратьНакладныеВСделку(40);
		Если РЕЗЗапуска = 1 Тогда		
			Попытка
				СделкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ОО = ОписаниеОшибки();
				Сообщить("Ошибка: " + ОО, СтатусСообщения.ОченьВажное);
				ЗаписьЖурналаРегистрации("ОшибкаЗаписиСделки",УровеньЖурналаРегистрации.Ошибка,Метаданные.Документы.Сделка, Ответ.Сделка,ОО);
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьНомераТДдляНакладных(СписокНакладных) Экспорт
	
	Результат = Новый Соответствие;
	
	РазрешенныеКВыборкеДокументыИД = Новый Массив;
	РазрешенныеКВыборкеДокументыИД.Добавить(1323); // Электронная транзитная декларация (ЭТД)
	РазрешенныеКВыборкеДокументыИД.Добавить(1204); // Транзитная декларация (ТД)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	э_НакладнаяПрилагаемыеДокументы.НомерДокумента КАК НомерДокумента,
	               |	ТранспортныйДокумент.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.э_Накладная.ПрилагаемыеДокументы КАК э_НакладнаяПрилагаемыеДокументы
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	               |		ПО э_НакладнаяПрилагаемыеДокументы.Ссылка = ТранспортныйДокумент.НакладнаяЭТРАН
	               |ГДЕ
	               |	ТранспортныйДокумент.Ссылка В(&Ссылка)
	               |	И э_НакладнаяПрилагаемыеДокументы.ПрилагаемыеДокументыИД В(&ПрилагаемыеДокументыИД)";
	Запрос.УстановитьПараметр("Ссылка", СписокНакладных);
	Запрос.УстановитьПараметр("ПрилагаемыеДокументыИД", РазрешенныеКВыборкеДокументыИД);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		Результат.Вставить(Ответ.Ссылка, Ответ.НомерДокумента);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// SIV 29-04-21 Фоновое задание ищет и очищает недействительные накладные по сделкам, рисует задачи, пишет комментарии и т.п.
Процедура ОчисткаАннулированныхНакладныхИзСделок() Экспорт
	
//	1. По настраиваемому расписанию запускается и выполняет алгоритм;
//2. Для Груженой ЖДН выполняет следующее:
//2.1. Ищет прописанные в составе поезда груженые ЖДН с недействительным статусом (не только аннулировано, а с ЛЮБЫМ недействительным. Например, «Сторнировано по назначению»). 
// Удаляет ее из состава поезда. Пытается найти вместо нее действительную.
//2.1.1. Если замена нашлась и она отличается по реквизитам из Отгрузочной информации от предыдущей И по этой накладной уже есть РТУ, то помечать такие строки светло-желтым и ставить задачу менеджеру Ответственному за сделку от бэк-офиса на проверку документов. Написать комментарий, какие конкретно значения поменялись, чтобы человек понял, в чем проблема.
//2.1.2. Если замена нашлась и она не отличается по реквизитам отгрузочной информации от предыдущей, то никаких задач не ставить и никак не помечать эту строчку. Заменили и заменили.
//2.1.3. Если замена не нашлась, то помечать такие строки светло-красным и ставить задачу ответственному менеджеру за сделку от ОРК на подбор накладной. После подбора действуем по сценарию 2.1.1.
//3. Для всех прочих накладных (а именно этих пяти: подсыл вагона под подсыл ктк, подсыл КТК, подсыл вагона, накладная на возврат вагона, накладная на возврат КТК) выполнять алгоритм 2.1 без проверки разницы с предыдущей и без выдачи заданий. Просто заменяем номера и ссылки этих накладных молча. Если же замены нет, то хотя бы удаляем накладную, которая висит аннулированной.
//4. Вопрос к Александру: как система будет работать с расходами, по которым привязан акцепт к удаленной строке подсыльной накладной. Т.е. была накладная подсыла, сделали акцепт, потом накладная удаляется. Что произойдет? Как не потерять привязанные расходы?

	Сообщить("Начало: " + ТекущаяДата());
	
	// Евросиб Фролов (03.03.2022
	МассивСообщений = Новый Массив;
	// Евросиб Фролов)
	
	ОбрРаботыСАннЖДН = Обработки.РаботаСАннулированнымиЖДН.Создать();
	ДОК = ТекущаяДата();
	ДНА = ДобавитьМесяц(ДОК, -12);
	//ДИТ Авдеева В.С. 47101 29.09.2022 Начало
	//ТаблицаВсехАннулированныхЖДН = ОбрРаботыСАннЖДН.ПолучитьВсеАннулированныеЖДНВСделках(ДНА, ДОК);
	ТаблицаВсехАннулированныхЖДН = ОбрРаботыСАннЖДН.ПолучитьВсеАннулированныеЖДНВСделках(ДНА, ДОК, Истина);
	//ДИТ Авдеева В.С. 47101 29.09.2022 Конец
	
	МассивУникальныхСделок = Новый Массив;
	Для каждого Стр из ТаблицаВсехАннулированныхЖДН Цикл
		Если МассивУникальныхСделок.Найти(Стр.Сделка) = неопределено Тогда
			МассивУникальныхСделок.Добавить(Стр.Сделка);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого УнСделка из МассивУникальныхСделок Цикл
		
		СделкаО = УнСделка.ПолучитьОбъект();
		
		СоответствиеУдаленныхЖДНГруж = Новый Соответствие;
		СоответствиеВозвратныхВагон = Новый Соответствие;
		СоответствиеВозвратныхКТК = Новый Соответствие;
		СоответствиеЖДНПодсылаКТК = Новый Соответствие;
		СоответствиеЖДНПодсылаВагонаПодКТК = Новый Соответствие;
		СоответствиеЖДНПодсылаВагоны = Новый Соответствие;
		
		Для каждого Стр из ТаблицаВсехАннулированныхЖДН Цикл
			
			// Груженые (ЖДН)
			Если Стр.Сделка = УнСделка И ЗначениеЗаполнено(Стр.ЖДНГруженая) И Стр.ЖДНГруженаяДействующая = Ложь Тогда
				Для каждого СтрСоставПоезда из СделкаО.СвязьУчетныхЕдиниц Цикл
					Если СтрСоставПоезда.ЖДН = Стр.ЖДНГруженая Тогда
						СоответствиеУдаленныхЖДНГруж.Вставить(Стр.ГУИДСоставПоезда, Стр.ЖДНГруженая);
						СтрСоставПоезда.ЖДН = неопределено;
						СтрСоставПоезда.НомерЖДН = неопределено;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			// Возвратные на вагоны (НакладнаяПослеГруженогоПлеча)
			Если Стр.Сделка = УнСделка И ЗначениеЗаполнено(Стр.ЖДНПослеГруж) И Стр.ЖДНПослеГружДействующая = Ложь Тогда
				Для каждого СтрСоставПоезда из СделкаО.СвязьУчетныхЕдиниц Цикл
					Если СтрСоставПоезда.НакладнаяПослеГруженогоПлеча = Стр.ЖДНПослеГруж Тогда
						СоответствиеВозвратныхВагон.Вставить(Стр.ГУИДСоставПоезда, Стр.ЖДНПослеГруж);
						СтрСоставПоезда.НакладнаяПослеГруженогоПлеча = неопределено;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			// Возвратные на КТК (НакладнаяПослеГружКТК)
			Если Стр.Сделка = УнСделка И ЗначениеЗаполнено(Стр.ЖДНПослеГружКТК) И Стр.ЖДНПослеГружКТКДействующая = Ложь Тогда
				Для каждого СтрСоставПоезда из СделкаО.СвязьУчетныхЕдиниц Цикл
					Если СтрСоставПоезда.НакладнаяПослеГружКТК = Стр.ЖДНПослеГружКТК Тогда
						СоответствиеВозвратныхВагон.Вставить(Стр.ГУИДСоставПоезда, Стр.ЖДНПослеГружКТК);
						СтрСоставПоезда.НакладнаяПослеГружКТК = неопределено;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			// Подсыл КТК (ПорожняяЖДНКТК)
			Если Стр.Сделка = УнСделка И ЗначениеЗаполнено(Стр.ЖДНПодсылКТК) И Стр.ЖДНПодсылКТКДействующая = Ложь Тогда
				Для каждого СтрСоставПоезда из СделкаО.СвязьУчетныхЕдиниц Цикл
					Если СтрСоставПоезда.НомерПорожнейЖДНКТК = Стр.ЖДНПодсылКТК.НакладнаяЭТРАН.НакладнаяНомер Тогда
						СоответствиеВозвратныхВагон.Вставить(Стр.ГУИДСоставПоезда, Стр.ЖДНПодсылКТК);
						СтрСоставПоезда.НомерПорожнейЖДНКТК = неопределено;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			// Подсыл вагона (ВагоннаяЖДН)  
			//ДИТ Авдеева В.С. 47101 29.09.2022 Начало
			//Если Стр.Сделка = УнСделка И ЗначениеЗаполнено(Стр.ЖДНПодсылВагона) И Стр.ЖДНПодсылВагонаДействующая = Ложь Тогда
			Если Стр.Сделка = УнСделка И (ЗначениеЗаполнено(Стр.ЖДНПодсылВагона) 
				И Стр.ЖДНПодсылВагонаДействующая = Ложь 
					Или Стр.ОчищатьВагоннуюЖДН = Истина) Тогда
			//ДИТ Авдеева В.С. 47101 29.09.2022 Конец
				Для каждого СтрСоставПоезда из СделкаО.СвязьУчетныхЕдиниц Цикл
					//ДИТ Авдеева В.С. 47101 29.09.2022 Начало  
					//Если СтрСоставПоезда.НомерВагоннойЖДН = Стр.ЖДНПодсылВагона.НакладнаяЭТРАН.НакладнаяНомер Тогда 
					Если Стр.ОчищатьВагоннуюЖДН И СтрСоставПоезда.НомерВагоннойЖДН = Стр.НомерВагоннойЖДН
						Или ЗначениеЗаполнено(Стр.ЖДНПодсылВагона) И 
						СтрСоставПоезда.НомерВагоннойЖДН = Стр.ЖДНПодсылВагона.НакладнаяЭТРАН.НакладнаяНомер Тогда 
					//ДИТ Авдеева В.С. 47101 29.09.2022 Конец  
						   
						 
						СоответствиеВозвратныхВагон.Вставить(Стр.ГУИДСоставПоезда, Стр.ЖДНПодсылВагона);
						СтрСоставПоезда.НомерВагоннойЖДН = неопределено;
						//ДИТ Авдеева В.С. 47101 29.09.2022 Начало
						Если Стр.ОчищатьВагоннуюЖДН Тогда
							СтрСоставПоезда.ВагоннаяЖДН = неопределено;
						КонецЕсли;
						//ДИТ Авдеева В.С. 47101 29.09.2022 Конец
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			// Подсыл вагона под КТК (ПорожняяВагоннаяЖДН)
			Если Стр.Сделка = УнСделка И ЗначениеЗаполнено(Стр.ЖДНПодсылВагонаПодКТК) И Стр.ЖДНПодсылВагонаПодКТКДействующая = Ложь Тогда
				Для каждого СтрСоставПоезда из СделкаО.СвязьУчетныхЕдиниц Цикл
					Если СтрСоставПоезда.НомерПорожнейВагоннойЖДН = Стр.ЖДНПодсылВагонаПодКТК.НакладнаяЭТРАН.НакладнаяНомер Тогда
						СоответствиеВозвратныхВагон.Вставить(Стр.ГУИДСоставПоезда, Стр.ЖДНПодсылВагонаПодКТК);
						СтрСоставПоезда.НомерПорожнейВагоннойЖДН = неопределено;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
		
		// Евросиб Фролов (03.03.2022
		//СделкаО.ПодобратьНакладныеВСделку();
		РаботаСоСделкамиСервер.ПодобратьНакладныеВСделку(СделкаО,, МассивСообщений);	
		// Евросиб Фролов)
		
		// груженые ЖДН
		Для каждого Стр из СоответствиеУдаленныхЖДНГруж Цикл
			
			ПредрешенноеСостояние = неопределено;
			КомментарийЗаменыЖДН = "";
			НайдСтрСделки = СделкаО.СвязьУчетныхЕдиниц.Найти(Стр.Ключ, "ГУИД");
			Если НайдСтрСделки <> неопределено И ЗначениеЗаполнено(НайдСтрСделки.ЖДН) Тогда
				// Вариант - замена накладной обнаружена
				НайдСтрСделки.КомментарийЗаменыЖДН = ЕстьРазницаВНакладных(Стр.Значение, НайдСтрСделки.ЖДН);
				Если НайдСтрСделки.КомментарийЗаменыЖДН = "" ИЛИ ЖДННеСодержитсяВВыставленныхДоходах(СделкаО, Стр.Значение) Тогда
					// Вариант - накладные идентичны
					// В этом варианте ничего не делаем, т.к. никто не заметит подмены
				Иначе
					// Вариант - накладные отличаются
					ПредрешенноеСостояние = Справочники.Состояния.ЖДНЗамененаПроверитьРТУ;
					НайдСтрСделки.ЖДНГруженаяЗаменена = Истина;
				КонецЕсли;
			Иначе
				// Вариант - замены для удаленной накладной не нашлось
				ПредрешенноеСостояние = Справочники.Состояния.ЖДНАннулированаПодобратьЗамену;
				НайдСтрСделки.ЖДНГруженаяУдаленаИНеЗаменена = Истина;
			КонецЕсли;
			Если ПредрешенноеСостояние <> неопределено Тогда
				НайдСтр = СделкаО.Состояния.Найти(ПредрешенноеСостояние, "Состояние");
				Если НайдСтр = неопределено Тогда
					НСтрСостояния = СделкаО.Состояния.Добавить();
					НСтрСостояния.Состояние = ПредрешенноеСостояние;
					НСтрСостояния.Статус = Перечисления.СтатусыЭтапов.ВРаботе;
					// Евросиб Фролов (04.03.2022 Ticket №0262470
					// Если ЖДН очищается, то задачу нужно сразу закрыть.
					Если НайдСтрСделки <> Неопределено И Не ЗначениеЗаполнено(НайдСтрСделки.ЖДН) Тогда
						НСтрСостояния.Статус = Перечисления.СтатусыЭтапов.Выполнен;	
					КонецЕсли;	
					// Евросиб Фролов)					
					НСтрСостояния.Комментарий = КомментарийЗаменыЖДН;
					// ДИТ US 51951 TA 61497 Евсенкин М.А. 28.11.2022 
					//Ответственный = ?(СделкаО.КомуСтавитсяЗадачаПоДокументам = 0, СделкаО.ЕдиныйОтветственныйОтУчета, НайдСтрСделки.Договор.ОтветственныйЗаУчет);
					СтруктураПараметров = Новый Структура;
					СтруктураПараметров.Вставить("Договор",				НайдСтрСделки.Договор);
					СтруктураПараметров.Вставить("ЦФО",					Справочники.ЦентрыФинансовойОтветственности.ОсновнойЦФО);
					СтруктураПараметров.Вставить("ТипОтветственного",	Перечисления.ТипыОтветственных.ОтветственныйЗаУчет);  
					ОтветственныйЗаУчет = Справочники.ДоговорыКонтрагентов.ПолучитьОтветственного(СтруктураПараметров);
					 
					Ответственный = ?(СделкаО.КомуСтавитсяЗадачаПоДокументам = 0, СделкаО.ЕдиныйОтветственныйОтУчета, ОтветственныйЗаУчет);
					// ДИТ US 51951 TA 61497 Евсенкин М.А. 28.11.2022
					НСтрСостояния.Исполнитель = ?(ПредрешенноеСостояние = Справочники.Состояния.ЖДНАннулированаПодобратьЗамену, СделкаО.ЕдиныйОтветственныйОтОРК, Ответственный);
					НСтрСостояния.Наблюдатель = НСтрСостояния.Исполнитель;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		Попытка
			СделкаО.УстановитьКомментарийВерсииИсторииДанных("Очистка аннулированных накладных (ОчисткаАннулированныхНакладныхИзСделок)");
			СделкаО.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ОО = ОписаниеОшибки();
			// Евросиб Фролов (03.03.2022
			// Сообщения в рег. заданиях некуда посылать
			//Сообщить("Ошибка по сделке: " + СделкаО.Ссылка);
			//Сообщить(ОО);
			ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()); 
			МассивСообщений.Добавить("Ошибка при проведении сделки. " + СделкаО.Ссылка + ": " + ПредставлениеОшибки);
			ЗаписьЖурналаРегистрации("ОчисткаАннулированныхНакладных.Проведение сделки",
    			УровеньЖурналаРегистрации.Ошибка,, УнСделка.Ссылка, ПредставлениеОшибки);
			// Евросиб Фролов)	
		КонецПопытки;
		
	КонецЦикла;
	
	// Евросиб Фролов (03.03.2022
	Если МассивСообщений.Количество() > 0 Тогда
		Тема = "Рег. задание: Очистка аннулированных накладных из сделок";
		ТекстСообщения = "Ошибки и уведомления при выполнении рег. задания:
						|" + СтрСоединить(МассивСообщений, Символы.ПС);
		ВыполнитьОтправкуУведомлений(Тема, ТекстСообщения, Метаданные.РегламентныеЗадания.ОчисткаАннулированныхНакладныхИзСделок);
	КонецЕсли;
	// Евросиб Фролов)
	
	Сообщить("Окончание: " + ТекущаяДата());
	
КонецПроцедуры

Функция ЕстьРазницаВНакладных(Знач Накл1, Знач Накл2)
	
	Результат = "";
	
	// 1. НомерЖДН
	// 2. Вагон
	// 3. Груз
	// 4. Станция отправления
	// 5. Станция назначения
	// 6. Дата раскредитации
	
	Накл1 = ?(ТипЗнч(Накл1) = Тип("ДокументСсылка.ТранспортныйДокумент"), Накл1.НакладнаяЭТРАН, Накл1);
	Накл2 = ?(ТипЗнч(Накл2) = Тип("ДокументСсылка.ТранспортныйДокумент"), Накл2.НакладнаяЭТРАН, Накл2);
	
	НомерЖДН_1 = Накл1.НакладнаяНомер;
	НомерЖДН_2 = Накл2.НакладнаяНомер;
	Вагон_1 = ?(Накл1.Вагоны.Количество() > 0, Накл1.Вагоны[0].НомерВагона, "");
	Вагон_2 = ?(Накл2.Вагоны.Количество() > 0, Накл2.Вагоны[0].НомерВагона, "");
	Груз_1 = ?(Накл1.ГрузыЖД.Количество() > 0, Накл1.ГрузыЖД[0].НаименованиеГруза, "");
	Груз_2 = ?(Накл2.ГрузыЖД.Количество() > 0, Накл2.ГрузыЖД[0].НаименованиеГруза, "");
	СтОтправления_1 = Накл1.СтанцияОтправленияКод;
	СтОтправления_2 = Накл2.СтанцияОтправленияКод;
	СтНазначения_1 = Накл1.СтанцияНазначенияКод;
	СтНазначения_2 = Накл2.СтанцияНазначенияКод;
	ДатаРаскр_1 = НачалоДня(Накл1.ДатаИВремяРаскредитованияГруза);
	ДатаРаскр_2 = НачалоДня(Накл2.ДатаИВремяРаскредитованияГруза);
	
	Если НомерЖДН_1 <> НомерЖДН_2 Тогда Результат = Результат + ?(Результат = "", "", "; ") + "ЖДН1: " + НомерЖДН_1 + " ЖДН2: " + НомерЖДН_2 КонецЕсли;
	Если Вагон_1 <> Вагон_2 Тогда Результат = Результат + ?(Результат = "", "", "; ") + "Вагон1: " + Вагон_1 + " Вагон2: " + Вагон_2 КонецЕсли;
	Если Груз_1 <> Груз_2 Тогда Результат = Результат + ?(Результат = "", "", "; ") + "Груз1: " + Груз_1 + " Груз2: " + Груз_2 КонецЕсли;
	Если СтОтправления_1 <> СтОтправления_2 Тогда Результат = Результат + ?(Результат = "", "", "; ") + "Ст. отпр1: " + СтОтправления_1 + " Ст. отпр2: " + СтОтправления_2 КонецЕсли;
	Если СтНазначения_1 <> СтНазначения_2 Тогда Результат = Результат + ?(Результат = "", "", "; ") + "Ст. назн1: " + СтНазначения_1 + " Ст. назн2: " + СтНазначения_2 КонецЕсли;
	Если ДатаРаскр_1 <> ДатаРаскр_2 Тогда Результат = Результат + ?(Результат = "", "", "; ") + "Дата раскр.1: " + ДатаРаскр_1 + " Дата раскр.2: " + ДатаРаскр_2 КонецЕсли;
	
	Возврат Результат;
		
КонецФункции

Функция ЖДННеСодержитсяВВыставленныхДоходах(СделкаО, ЖДН)
	
	НеСодержится = Истина;
	
	Для каждого СтрДоходы из СделкаО.Доходы Цикл
		Если ЗначениеЗаполнено(СтрДоходы.УчДокумент) ТОгда
			СтрТД = СделкаО.ДоходыТД.Найти(СтрДоходы.ГУИД, "ГУИД");
			Если СтрТД <> неопределено И Найти(СтрТД.ТД, ЖДН.Номер) <> неопределено Тогда
				НеСодержится = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат НеСодержится;
	
КонецФункции

