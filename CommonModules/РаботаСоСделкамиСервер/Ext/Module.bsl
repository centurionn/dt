	//|////////////////////////////////////////////////////////////////////////////////
	//|ВЫБРАТЬ
	//|	МАКСИМУМ(ВТ.ДатаОтправления) КАК ДатаОтправления,
	//|	МАКСИМУМ(ВТ.ДатаПрибытия) КАК ДатаПрибытия
	//|ИЗ
	//|	ВТ КАК ВТ
	//|;
	//|
	//|////////////////////////////////////////////////////////////////////////////////
	//|ВЫБРАТЬ РАЗЛИЧНЫЕ
	//|	ВТ.ПунктОтправления КАК ПунктОтправления,
	//|	ВТ.ПунктНазначения КАК ПунктНазначения
	//|ИЗ
	//|	ВТ КАК ВТ
	//|ГДЕ
	//|	ВТ.ПунктОтправления <> ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка)
	//|	И ВТ.ПунктНазначения <> ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка)";
	 
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РейсыЖД.ДатаПрибытия КАК ДатаПрибытия,
	|	РейсыЖД.ПунктНазначения КАК ПунктНазначения,
	|	РейсыЖД.СвязанныйРейс КАК СвязанныйРейс
	|ПОМЕСТИТЬ ВТ_ПерегрузИсхВСделке
	|ИЗ
	|	Справочник.РейсыЖД КАК РейсыЖД
	|ГДЕ
	|	РейсыЖД.Ссылка В(&РейсыСделки)
	|	И РейсыЖД.Перегруз
	|	И НЕ РейсыЖД.Входящий
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РейсыЖДВхд.ДатаОтправления КАК ДатаОтправления,
	|	РейсыЖДВхд.ПунктОтправления КАК ПунктОтправления,
	|	ВТ_ПерегрузИсхВСделке.ДатаПрибытия КАК ДатаПрибытия,
	|	ВТ_ПерегрузИсхВСделке.ПунктНазначения КАК ПунктНазначения
	|ПОМЕСТИТЬ ВТ_ПерегрузВхдИсх
	|ИЗ
	|	ВТ_ПерегрузИсхВСделке КАК ВТ_ПерегрузИсхВСделке
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РейсыЖД КАК РейсыЖДВхд
	|		ПО (РейсыЖДВхд.Ссылка = ВТ_ПерегрузИсхВСделке.СвязанныйРейс)
	|			И (РейсыЖДВхд.Входящий)
	|			И (РейсыЖДВхд.Перегруз)
	|;
	|
	|ВЫБРАТЬ
	|	РейсыЖД.ДатаОтправления КАК ДатаОтправления,
	|	РейсыЖД.ПунктОтправления КАК ПунктОтправления,
	|	РейсыЖД.СвязанныйРейс КАК СвязанныйРейс
	|ПОМЕСТИТЬ ВТ_ПерегрузВхдВСделке
	|ИЗ
	|	Справочник.РейсыЖД КАК РейсыЖД
	|ГДЕ
	|	РейсыЖД.Ссылка В(&РейсыСделки)
	|	И РейсыЖД.Перегруз
	|	И РейсыЖД.Входящий
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПерегрузВхдВСделке.ДатаОтправления КАК ДатаОтправления,
	|	ВТ_ПерегрузВхдВСделке.ПунктОтправления КАК ПунктОтправления,
	|	РейсыЖДИсх.ДатаПрибытия КАК ДатаПрибытия,
	|	РейсыЖДИсх.ПунктНазначения КАК ПунктНазначения
	|ПОМЕСТИТЬ ВТ_ПерегрузИсхВхд
	|ИЗ
	|	ВТ_ПерегрузВхдВСделке КАК ВТ_ПерегрузВхдВСделке
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РейсыЖД КАК РейсыЖДИсх
	|		ПО (РейсыЖДИсх.Ссылка = ВТ_ПерегрузВхдВСделке.СвязанныйРейс)
	|			И (НЕ РейсыЖДИсх.Входящий)
	|			И (РейсыЖДИсх.Перегруз)
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПерегрузВхдИсх.ДатаОтправления КАК ДатаОтправления,
	|	ВТ_ПерегрузВхдИсх.ДатаПрибытия КАК ДатаПрибытия,
	|	ВТ_ПерегрузВхдИсх.ПунктОтправления КАК ПунктОтправления,
	|	ВТ_ПерегрузВхдИсх.ПунктНазначения КАК ПунктНазначения
	|ПОМЕСТИТЬ ВТ_Перегруз
	|ИЗ
	|	ВТ_ПерегрузВхдИсх КАК ВТ_ПерегрузВхдИсх
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВТ_ПерегрузИсхВхд.ДатаОтправления,
	|	ВТ_ПерегрузИсхВхд.ДатаПрибытия,
	|	ВТ_ПерегрузИсхВхд.ПунктОтправления,
	|	ВТ_ПерегрузИсхВхд.ПунктНазначения
	|ИЗ
	|	ВТ_ПерегрузИсхВхд КАК ВТ_ПерегрузИсхВхд
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РейсыЖД.ДатаОтправления КАК ДатаОтправления,
	|	РейсыЖД.ДатаПрибытия КАК ДатаПрибытия,
	|	РейсыЖД.ПунктОтправления КАК ПунктОтправления,
	|	РейсыЖД.ПунктНазначения КАК ПунктНазначения
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Справочник.РейсыЖД КАК РейсыЖД
	|ГДЕ
	|	РейсыЖД.Ссылка В(&РейсыСделки)
	|	И НЕ РейсыЖД.Перегруз
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_Перегруз.ДатаОтправления,
	|	ВТ_Перегруз.ДатаПрибытия,
	|	ВТ_Перегруз.ПунктОтправления,
	|	ВТ_Перегруз.ПунктНазначения
	|ИЗ
	|	ВТ_Перегруз КАК ВТ_Перегруз
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВТ.ДатаОтправления) КАК ДатаОтправления,
	|	МАКСИМУМ(ВТ.ДатаПрибытия) КАК ДатаПрибытия
	|ИЗ
	|	ВТ КАК ВТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ.ПунктОтправления КАК ПунктОтправления,
	|	ВТ.ПунктНазначения КАК ПунктНазначения
	|ИЗ
	|	ВТ КАК ВТ
	|ГДЕ
	|	ВТ.ПунктОтправления <> ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка)
	|	И ВТ.ПунктНазначения <> ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка)";
	
	//Евросиб Шевченко А.В. US 102893 TA 114464 14.07.2025
	
	Запрос.УстановитьПараметр("РейсыСделки", МассивРейсов);
	РезультатЗапросаПакет = Запрос.ВыполнитьПакет();
	ВыборкаПериода = РезультатЗапросаПакет[РезультатЗапросаПакет.Количество()-2].Выбрать();
	Если ВыборкаПериода.Следующий() Тогда
		Результат.ДатаМин = ВыборкаПериода.ДатаОтправления;
		Результат.ДатаМакс = ВыборкаПериода.ДатаПрибытия;
	КонецЕсли;
	ТаблицаСтанций = РезультатЗапросаПакет[РезультатЗапросаПакет.Количество()-1].Выгрузить();
	Результат.МассивСтанцийОтправления  = ТаблицаСтанций.ВыгрузитьКолонку("ПунктОтправления");
	Результат.МассивСтанцийНазначений = ТаблицаСтанций.ВыгрузитьКолонку("ПунктНазначения");
	
	Возврат Результат;

КонецФункции
//ДИТ, Беляев СЮ, US 68284/ TA 68289, 11-05-2023, конец

Функция НайтиПорожнююНакладнуюПослеГруженогоЭТРАН_поискВАГОН(Вагон, ДатаНачалаПоиска, СтанцияОтправления, ГоризонтПоискаНакладныхПодсыла, ИсключаяНакладную = "") Экспорт
	
	НакладнаяПодсылаВагона = неопределено;
	
	КодыЕТСНГПорожниеВагоны = э_ОбщиеСервер.МассивКодовЕТСНГ_ПорожниеВагоны();
	//КодыЕТСНГПорожниеКТК = э_ОбщиеСервер.МассивКодовЕТСНГ_ПорожниеКТК();
	
	//ВсеКодыВсехАналоговСтанции = Локации_сервер.ПолучитьКодыАналоговСтанцииПоКоду(СтанцияОтправления.КодЖДСтанции);
	//ДИТ, Беляев СЮ, US 68284/ TA 68289, 11-05-2023, начало
	Если ТипЗнч(СтанцияОтправления) = Тип("Массив") Тогда
		ВсеКодыВсехАналоговСтанции = Локации_сервер.ПолучитьКодыАналоговСтанций(СтанцияОтправления);	
	Иначе
		ВсеКодыВсехАналоговСтанции = Локации_сервер.ПолучитьКодыАналоговСтанцииПоКоду(СтанцияОтправления.КодЖДСтанции);
	КонецЕсли;
	//ДИТ, Беляев СЮ, US 68284/ TA 68289, 11-05-2023, конец
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ первые 1
				   |	э_НакладнаяВагоны.Ссылка.ДатаИВремяОтправленияГруза КАК УчетнаяДата,
	               |	э_НакладнаяВагоны.Ссылка КАК Ссылка,
	               |	э_НакладнаяВагоны.Ссылка.НакладнаяНомер КАК НакладнаяНомер
	               |ИЗ
	               |	Документ.э_Накладная.Вагоны КАК э_НакладнаяВагоны
	               |ГДЕ
	               |	э_НакладнаяВагоны.НомерВагона = &НомерВагона
	               |	И НЕ э_НакладнаяВагоны.Ссылка.ПометкаУдаления
	               |	И э_НакладнаяВагоны.Ссылка.ТекущееСостояниеНакладнойДействующийСтатус
	               |	И э_НакладнаяВагоны.Ссылка.ДатаИВремяОтправленияГруза МЕЖДУ &ДатаНачалаПоиска И &ГоризонтПоискаНакладныхПодсыла
	               |	И э_НакладнаяВагоны.Ссылка.НакладнаяНомер <> &ИсключаяНакладную
				   |	И э_НакладнаяВагоны.Ссылка.ТипНакладной <> &ДосылочнаяНакладная
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	УчетнаяДата ВОЗР";
	Запрос.УстановитьПараметр("НомерВагона", Вагон);
	Запрос.УстановитьПараметр("ДатаНачалаПоиска", ДатаНачалаПоиска);
	Запрос.УстановитьПараметр("ИсключаяНакладную", ИсключаяНакладную);
	Запрос.УстановитьПараметр("ГоризонтПоискаНакладныхПодсыла", ДатаНачалаПоиска+ГоризонтПоискаНакладныхПодсыла*24*3600);
	//ДИТ Шевченко А.В 01.08.2022 53548 -Начало
	Запрос.УстановитьПараметр("ДосылочнаяНакладная", Справочники.э_ОбщиеПоказатели.ДосылочнаяНакладная);
	//ДИТ Шевченко А.В 01.08.2022 53548 -Конец
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		
		УсловиеГрузаСоблюдено = Ложь;
		УсловиеСтанцииСоблюдено = Ложь;
		
		УсловиеСтанцииСоблюдено = ВсеКодыВсехАналоговСтанции.Найти(Ответ.Ссылка.СтанцияОтправленияКод) <> неопределено;
		Для каждого Стр из Ответ.Ссылка.ГрузыЖД Цикл
			УсловиеГрузаСоблюдено = УсловиеГрузаСоблюдено ИЛИ КодыЕТСНГПорожниеВагоны.Найти(Стр.ЕТСНГ.Код) <> неопределено;
		КонецЦикла;
		
		Если УсловиеГрузаСоблюдено И УсловиеСтанцииСоблюдено Тогда 
			
			НакладнаяПодсылаВагона = Связь_ЭТРАН_DC.ПолучитьТрДокПоЭ_Накладной(Ответ.Ссылка);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат НакладнаяПодсылаВагона;
	
КонецФункции

Функция НайтиПорожнююНакладнуюПослеГруженогоЭТРАН_поискКТК(КТК, ДатаНачалаПоиска, СтанцияОтправления, ГоризонтПоискаНакладныхПодсыла, ИсключаяНакладную = "") Экспорт
	
	НакладнаяПодсылаВагона = неопределено;
	ВагонСсылка = Неопределено;
	
	//КодыЕТСНГПорожниеВагоны = э_ОбщиеСервер.МассивКодовЕТСНГ_ПорожниеВагоны();
	КодыЕТСНГПорожниеКТК = э_ОбщиеСервер.МассивКодовЕТСНГ_ПорожниеКТК();
	
	//ВсеКодыВсехАналоговСтанции = Локации_сервер.ПолучитьКодыАналоговСтанцииПоКоду(СтанцияОтправления.КодЖДСтанции);
	//ДИТ, Беляев СЮ, US 68284/ TA 68289, 11-05-2023, начало
	Если ТипЗнч(СтанцияОтправления) = Тип("Массив") Тогда
		ВсеКодыВсехАналоговСтанции = Локации_сервер.ПолучитьКодыАналоговСтанций(СтанцияОтправления);	
	Иначе
		ВсеКодыВсехАналоговСтанции = Локации_сервер.ПолучитьКодыАналоговСтанцииПоКоду(СтанцияОтправления.КодЖДСтанции);
	КонецЕсли;
	//ДИТ, Беляев СЮ, US 68284/ TA 68289, 11-05-2023, конец
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	э_НакладнаяКонтейнеры.Ссылка.ДатаИВремяОтправленияГруза КАК УчетнаяДата,
	|	э_НакладнаяКонтейнеры.Ссылка КАК Ссылка,
	|	э_НакладнаяКонтейнеры.Ссылка.НакладнаяНомер КАК НакладнаяНомер,
	|	ТС.Ссылка КАК ВагонСсылка
	|ИЗ
	|	Документ.э_Накладная.Контейнеры КАК э_НакладнаяКонтейнеры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.э_Накладная.Вагоны КАК э_НакладнаяВагоны
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТС КАК ТС
	|			ПО (э_НакладнаяВагоны.НомерВагона = ТС.Наименование)
	|				И (НЕ ТС.ПометкаУдаления)
	|		ПО э_НакладнаяКонтейнеры.Ссылка = э_НакладнаяВагоны.Ссылка
	|			И (э_НакладнаяКонтейнеры.НомерВагонаДляКонтейнерногоПоезда = э_НакладнаяВагоны.ПорядковыйНомерВагонаВОтправке
	|				ИЛИ э_НакладнаяКонтейнеры.НомерВагонаДляКонтейнерногоПоезда = 0)
	|ГДЕ
	|	НЕ э_НакладнаяКонтейнеры.Ссылка.ПометкаУдаления
	|	И э_НакладнаяКонтейнеры.Ссылка.ТекущееСостояниеНакладнойДействующийСтатус
	|	И э_НакладнаяКонтейнеры.Ссылка.ДатаИВремяОтправленияГруза МЕЖДУ &ДатаНачалаПоиска И &ГоризонтПоискаНакладныхПодсыла
	|	И э_НакладнаяКонтейнеры.Ссылка.НакладнаяНомер <> &ИсключаяНакладную
	|	И э_НакладнаяКонтейнеры.НомерКонтейнера = &НомерКонтейнера
	|	И э_НакладнаяКонтейнеры.Ссылка.ТипНакладной <> &ДосылочнаяНакладная
	|
	|УПОРЯДОЧИТЬ ПО
	|	УчетнаяДата";
	Запрос.УстановитьПараметр("НомерКонтейнера", КТК);
	Запрос.УстановитьПараметр("ДатаНачалаПоиска", ДатаНачалаПоиска);
	Запрос.УстановитьПараметр("ИсключаяНакладную", ИсключаяНакладную);
	Запрос.УстановитьПараметр("ГоризонтПоискаНакладныхПодсыла", ДатаНачалаПоиска+ГоризонтПоискаНакладныхПодсыла*24*3600);
	//ДИТ Шевченко А.В 01.08.2022 53548 -Начало
	Запрос.УстановитьПараметр("ДосылочнаяНакладная", Справочники.э_ОбщиеПоказатели.ДосылочнаяНакладная);
	//ДИТ Шевченко А.В 01.08.2022 53548 -Конец
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		
		УсловиеГрузаСоблюдено = Ложь;
		УсловиеСтанцииСоблюдено = Ложь;
		
		УсловиеСтанцииСоблюдено = ВсеКодыВсехАналоговСтанции.Найти(Ответ.Ссылка.СтанцияОтправленияКод) <> неопределено;
		Для каждого Стр из Ответ.Ссылка.ГрузыЖД Цикл
			УсловиеГрузаСоблюдено = УсловиеГрузаСоблюдено ИЛИ КодыЕТСНГПорожниеКТК.Найти(Стр.ЕТСНГ.Код) <> неопределено;
		КонецЦикла;
		
		Если УсловиеГрузаСоблюдено И УсловиеСтанцииСоблюдено Тогда 
			
			НакладнаяПодсылаВагона = Связь_ЭТРАН_DC.ПолучитьТрДокПоЭ_Накладной(Ответ.Ссылка);
			ВагонСсылка = Ответ.ВагонСсылка;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Новый Структура("НакладнаяПодсылаВагона, ВагонСсылка", НакладнаяПодсылаВагона, ВагонСсылка);
	
КонецФункции

//ДИТ Авдеева В.С. 47101 05.09.2022 Начало
//Функция НайтиПодсылПорожнегоВагонаПоЭТРАН(Вагон, ДатаОтправления, СтанцияОтправления, ГоризонтПоискаНакладныхПодсыла, ИсключаяНакладную = "", СтанцияОтправленияСтрогоСоответствуетСтанцииПрибытия = Ложь, ИскатьПоДатеПрибытия = Ложь) Экспорт
Функция НайтиПодсылПорожнегоВагонаПоЭТРАН(Вагон, 
										ДатаОтправления, 
										СтанцияОтправления, 
										ГоризонтПоискаНакладныхПодсыла, 
										ИсключаяНакладную = "", 
										СтанцияОтправленияСтрогоСоответствуетСтанцииПрибытия = Ложь, 
										ИскатьПоДатеПрибытия = Ложь, 
										ИсключатьРемонт = Истина) Экспорт
