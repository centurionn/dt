				//Стр.НакладнаяПослеГружКТК = НайтиПорожнююНакладнуюПослеГруженогоЭТРАН_поискКТК(Стр.Контейнер.Наименование, Стр.ждн.ДатаПрибытия, ОбъектСделка.СтанцияНазначения, 90, "");
