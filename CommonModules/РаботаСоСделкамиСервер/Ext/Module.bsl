	ДатаМакс = Дата("00010101");
	
    ДанныеИзРейсовСделки = ПолучитьДанныеИзРейсовСделки(ОбъектСделка);
	ДатаМин = ДанныеИзРейсовСделки.ДатаМин;
	ДатаМакс = ДанныеИзРейсовСделки.ДатаМакс;
	МассивСтанцийНазначений = ДанныеИзРейсовСделки.МассивСтанцийНазначений;
    МассивСтанцийОтправления = ДанныеИзРейсовСделки.МассивСтанцийОтправления;
	

	
	Если ОбъектСделка.Рейсы.Количество() = 0 ИЛИ НЕ ЗначениеЗаполнено(ДатаМакс) ИЛИ НЕ ЗначениеЗаполнено(ДатаМин) Тогда		
		ОбщегоНазначения.СообщитьПользователю("Не подобран Документ ЖДН порожний, из-за отсутствия рейса после перегруза. Обратитесь к ответственному менеджеру для установления связи между рейсами с перегрузом в системе DX.");
		Для Каждого Стр из ТаблицаУЕ Цикл //Евросиб СубботинВ #128108 19.01.2026 Начало // поправил нейминг
			Если ЗначениеЗаполнено(Стр.ПорожняяЖДНПослеПерегруза) Тогда
				Стр.ПорожняяЖДНПослеПерегруза = Неопределено;
			КонецЕсли;	
		КонецЦикла;                            
		
		Возврат;
	КонецЕсли; 
	
	// определение маршрута
	ПунктОтправленияЪ = ?(ЗначениеЗаполнено(ОбъектСделка.ПогранпереходИзСтраныОтправления), ОбъектСделка.ПогранпереходИзСтраныОтправления, ОбъектСделка.СтанцияОтправления);
	ПунктНазначенияЪ = ?(ЗначениеЗаполнено(ОбъектСделка.ПогранпереходВСтрануНазначения), ОбъектСделка.ПогранпереходВСтрануНазначения, ОбъектСделка.СтанцияНазначения);
	МассивСтанцийОтправления.Добавить(ПунктОтправленияЪ);
	МассивСтанцийНазначений.Добавить(ПунктНазначенияЪ);
	
	МинДатаЪ = ДатаМин - ГоризонтПоискаНакладныхПодсыла*24*3600;
	МаксДатаЪ = ДатаМакс + ГоризонтПоискаНакладныхПодсыла*24*3600;

	Для Каждого Стр из ТаблицаУЕ Цикл //Евросиб СубботинВ #128108 19.01.2026 Начало // поправил нейминг
		Если ЗначениеЗаполнено(Стр.ЖДН) Тогда
			ДатаОтпр = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Стр.ЖДН, "ДатаОтправления");
			МаксДатаЪ = ДатаОтпр - 1; 
			МинДатаЪ = МаксДатаЪ - ГоризонтПоискаНакладныхПодсыла*24*3600;
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(Стр.ФТГПослеПерегруза) Тогда 
			ДатаИВремяРаскредитованияГруза = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Стр.ЖДН.НакладнаяЭТРАН, "ДатаИВремяРаскредитованияГруза");
			СтруктураЖДНПодсылВагонов = НайтиПодсылПорожнегоВагонаПоЭТРАННовыйАлгоритм(Стр.ФТГПослеПерегруза.Наименование, МаксДатаЪ, МассивСтанцийНазначений, ГоризонтПоискаНакладныхПодсыла,,,,,ДатаИВремяРаскредитованияГруза );
			ЖДНПослеПерегруз = СтруктураЖДНПодсылВагонов.НакладнаяПодсылаВагонаСсылка;
			Если ЗначениеЗаполнено(ЖДНПослеПерегруз) Тогда
				Стр.ПорожняяЖДНПослеПерегруза = ПолучитьТДПоНакладнойЭтран(ЖДНПослеПерегруз); 
			КонецЕсли; 
		Иначе
		    Стр.ПорожняяЖДНПослеПерегруза = Неопределено;
		КонецЕсли;
	КонецЦикла;	
		
КонецПроцедуры
