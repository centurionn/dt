			КонецЕсли;
			ЗаполнитьЗначенияСвойств(нСтрокаРасход, Выборка,,"ГУИД");
			нСтрокаРасход.НоменклатурнаяГруппа = РазнесениеЗатратСервер.ПодобратьНоменклатурнуюГруппуПоНаборуПараметров(Сделка.ТипЗаказа, Выборка.Вагон);
			нСтрокаРасход.НеВключатьВПлановыеРасходы = Истина;
			нСтрокаРасход.Договор = Выборка.Договор;
			нСтрокаРасход.СтрокаСвязьУчетныхЕдиниц = Выборка.СтрокаСУЕ;
			нСтрокаРасход.СебестоимостьИтого	= нСтрокаРасход.Себестоимость * нСтрокаРасход.Количество;
			нСтрокаРасход.СуммаНДС 				= БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСуммуНДС(нСтрокаРасход.СебестоимостьИтого, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(нСтрокаРасход.СтавкаНДС), Истина, нСтрокаРасход.НДСВключенВСтоимость);
			нСтрокаРасход.СуммаИтого 			= нСтрокаРасход.СебестоимостьИтого + ?(нСтрокаРасход.НДСВключенВСтоимость, 0, нСтрокаРасход.СуммаНДС);
			нСтрокаРасход.ИсточникПоявленияСтрокиЭкономики_Старая = Перечисления.ИсточникПоявленияСтрокиЭкономики.ДопУслугаАвтоматически;
			Документы.Сделка.СвязатьДоходыРасходыСУЕ(Сделка,,ИдентификаторРасходов,Выборка.СтрокаСУЕ, Выборка.Услуга);
			
			//Если Выборка.ФормироватьСтрокиДокументовНаКаждыйКонтейнерОтдельно Тогда
			//	МассивКТК = Новый Массив;
			//	МассивВагоны = Новый Массив;
			//	МассивТД = Новый Массив;
			//	МассивКТК.Добавить(Выборка.Контейнер);
			//	МассивВагоны.Добавить(Выборка.Вагон);
			//	МассивТД.Добавить(Выборка.ЖДН);
			//	ДобавитьДоходыНевключенныеВСтавку(Выборка, МассивКТК, МассивВагоны, МассивТД);
			//Иначе
			//	МассивКТК.Добавить(Выборка.Контейнер);
			//	МассивВагоны.Добавить(Выборка.Вагон);
			//	МассивТД.Добавить(Выборка.ЖДН);
			//КонецЕсли; 
			
		КонецЦикла;
		//Выборка.Сбросить();
		//Выборка.Следующий();
		//ДобавитьДоходыНевключенныеВСтавку(Выборка, МассивКТК, МассивВагоны, МассивТД);
		
	КонецЦикла;
	
	////найдем все перевыставляемые и заполним доходные суммы
	//ЗаполнитьСуммыДоходовПоПеревыставляемымРасходам();
	
КонецПроцедуры

Процедура УдалитьСтрокиРасходов_СтарыйАлгоритм(Сделка, МассивСтрокКУдалению, ОтключатьУслуги = Истина, ОтвязыватьПривязанные = Ложь, ЗаписыватьАкцепт = Истина) Экспорт
	
	Расходы = Сделка.Расходы;
	Доходы = Сделка.Доходы;
	ДоходыВагоны = Сделка.ДоходыВагоны;
	ДоходыКТК = Сделка.ДоходыКТК;
	ДоходыТД = Сделка.ДоходыТД;
	
	ТаблицаСтрокДляОтвязкиАкцептов = Расходы.Выгрузить(,"УчДокумент, ГУИД, Калькуляция, Услуга");
	ТаблицаСтрокДляОтвязкиАкцептов.Очистить();
	МассивПТУДляОтвязки = Новый Массив;
	МассивУдаляемыхСтрок = Новый Массив;
	МассивУдаляемыхСтрокД = Новый Массив;
	//Евросиб Каблов 17.01.2022 ( Ticket#0246698
	ОтвязываемыеСтроки = Новый Массив;
	//Евросиб Каблов 17.01.2022 )
	Для каждого СтрокаКУдалению Из МассивСтрокКУдалению Цикл
		Если СтрокаКУдалению.ЕстьОтчетКомитенту Тогда
			//сразу нет, если док проведен
			//ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("По строке расходов %1 выставлен отчет комитенту", ТекС.НомерСтроки));
			Продолжить;
		КонецЕсли; 
		Если ЗначениеЗаполнено(СтрокаКУдалению.УчДокумент) Тогда
			Если МассивПТУДляОтвязки.Найти(СтрокаКУдалению.УчДокумент) = Неопределено Тогда
				МассивПТУДляОтвязки.Добавить(СтрокаКУдалению.УчДокумент);
			КонецЕсли; 
			нСтрокаОтвязки = ТаблицаСтрокДляОтвязкиАкцептов.Добавить();
			нСтрокаОтвязки.УчДокумент = СтрокаКУдалению.УчДокумент;
			нСтрокаОтвязки.ГУИД = СтрокаКУдалению.ГУИД;
			нСтрокаОтвязки.Калькуляция = СтрокаКУдалению.Калькуляция;
			нСтрокаОтвязки.Услуга = СтрокаКУдалению.Услуга;
		КонецЕсли;
		//Евросиб Каблов 17.01.2022 ( Ticket#0246698
		УдалитьСтрокуРасходов = Истина;
		//Евросиб Каблов 17.01.2022 )
		НайдСтроки = Сделка.СвязьДоходовИРасходов.НайтиСтроки(Новый Структура("Расходы", СтрокаКУдалению.ГУИД));
		Если СтрокаКУдалению.ИсточникПоявленияСтрокиЭкономики = Перечисления.ИсточникПоявленияСтрокиЭкономики.ДобавленоИзАкцепта Тогда
			//в этом случае удалим доходы
			Для каждого ТекС Из НайдСтроки Цикл
				
				//Евросиб Каблов 06.07.2021 (
				НайденнаяСтрокаДоходов = Доходы.Найти(ТекС.Доходы, "ГУИД");
				Если НайденнаяСтрокаДоходов <> Неопределено И НайденнаяСтрокаДоходов.ИсточникПоявленияСтрокиЭкономики <> Перечисления.ИсточникПоявленияСтрокиЭкономики.ДобавленоИзАкцепта Тогда
					Продолжить;
				КонецЕсли;	
				//Евросиб Каблов 06.07.2021 )
				
				//Евросиб Каблов 17.01.2022 ( Ticket#0246698
				Если НайденнаяСтрокаДоходов <> Неопределено И ЗначениеЗаполнено(НайденнаяСтрокаДоходов.УчДокумент) Тогда					
					УчДокПроведен = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НайденнаяСтрокаДоходов.УчДокумент, "Проведен");
					Если УчДокПроведен Тогда
						УдалитьСтрокуРасходов = Ложь;
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				//Евросиб Каблов 17.01.2022 )
				
				НайдСтрокиД = ДоходыВагоны.НайтиСтроки(Новый Структура("ГУИД", ТекС.Доходы));
				Для каждого НайдСтрД из НайдСтрокиД Цикл ДоходыВагоны.Удалить(НайдСтрД); КонецЦикла;
				
				НайдСтрокиД = ДоходыКТК.НайтиСтроки(Новый Структура("ГУИД", ТекС.Доходы));
				Для каждого НайдСтрД из НайдСтрокиД Цикл ДоходыКТК.Удалить(НайдСтрД); КонецЦикла;
				
				НайдСтрокиД = ДоходыТД.НайтиСтроки(Новый Структура("ГУИД", ТекС.Доходы));
				Для каждого НайдСтрД из НайдСтрокиД Цикл ДоходыТД.Удалить(НайдСтрД); КонецЦикла;
				
				МассивУдаляемыхСтрокД.Добавить(Доходы.Найти(ТекС.Доходы, "ГУИД"));
			КонецЦикла;
			Для каждого УдаляемаяСтрока Из МассивУдаляемыхСтрокД Цикл
				Если УдаляемаяСтрока <> Неопределено Тогда
					Доходы.Удалить(УдаляемаяСтрока);
				КонецЕсли; 
			КонецЦикла; 
		КонецЕсли;
		
		//Евросиб Каблов 17.01.2022 ( Ticket#0246698
		Если УдалитьСтрокуРасходов Тогда
		//Евросиб Каблов 17.01.2022 )
			Для каждого НайдСтр из НайдСтроки Цикл 
				НайдСтр.Расходы = "";
			КонецЦикла;
			
			НайдСтроки = Сделка.ДоходыВагоны.НайтиСтроки(Новый Структура("ГУИД", СтрокаКУдалению.ГУИД));
			Для каждого НайдСтр из НайдСтроки Цикл Сделка.ДоходыВагоны.Удалить(НайдСтр); КонецЦикла;
			
			НайдСтроки = ДоходыКТК.НайтиСтроки(Новый Структура("ГУИД", СтрокаКУдалению.ГУИД));
			Для каждого НайдСтр из НайдСтроки Цикл ДоходыКТК.Удалить(НайдСтр); КонецЦикла;
			
			НайдСтроки = ДоходыТД.НайтиСтроки(Новый Структура("ГУИД", СтрокаКУдалению.ГУИД));
			Для каждого НайдСтр из НайдСтроки Цикл ДоходыТД.Удалить(НайдСтр); КонецЦикла;
			МассивУдаляемыхСтрок.Добавить(СтрокаКУдалению);
		//Евросиб Каблов 17.01.2022 ( Ticket#0246698
		Иначе
			ОтвязываемыеСтроки.Добавить(СтрокаКУдалению);
		КонецЕсли;
		//Евросиб Каблов 17.01.2022 )
		
	КонецЦикла;
	Для каждого УдаляемаяСтрока Из МассивУдаляемыхСтрок Цикл
		Если ЗначениеЗаполнено(УдаляемаяСтрока.УчДокумент) И НЕ ОтвязыватьПривязанные Тогда
			Продолжить;
		КонецЕсли; 
		Если ОтключатьУслуги 
			И Не УдаляемаяСтрока.ИсточникПоявленияСтрокиЭкономики = Перечисления.ИсточникПоявленияСтрокиЭкономики.ДобавленоИзАкцепта Тогда
			УдаляемаяСтрока.УслугаОтключена = Истина;
		Иначе
			Расходы.Удалить(УдаляемаяСтрока);
		КонецЕсли;
	КонецЦикла;
	//Евросиб Каблов 17.01.2022 ( Ticket#0246698
	Для Каждого ОтвязываемаяСтрока Из ОтвязываемыеСтроки Цикл
		ОтвязываемаяСтрока.УчДокумент = Неопределено;
	КонецЦикла;
	//Евросиб Каблов 17.01.2022 )
	
	// Евросиб Фролов (14.04.2022 Task №50195
	Если Не Сделка.ДополнительныеСвойства.Свойство("ЗаписьСвязанныхОбъектов") Тогда
		ЗаписыватьАкцепт = Ложь;
	КонецЕсли;
	// Евросиб Фролов)	
	
	Если Не ЗаписыватьАкцепт Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаРассылки = Новый ТаблицаЗначений;
	ТаблицаРассылки = Новый ТаблицаЗначений;
	ТаблицаРассылки.Колонки.Добавить("Сделка");
	ТаблицаРассылки.Колонки.Добавить("ГУИД");
	ТаблицаРассылки.Колонки.Добавить("ГУИДАкцепт");
	ТаблицаРассылки.Колонки.Добавить("Калькуляция");
	ТаблицаРассылки.Колонки.Добавить("Номенклатура");
	ТаблицаРассылки.Колонки.Добавить("Вагон");
	ТаблицаРассылки.Колонки.Добавить("КТК");
	ТаблицаРассылки.Колонки.Добавить("ТД");
	ТаблицаРассылки.Колонки.Добавить("ПТУ");
	НужноОтправлятьПисьмо = Ложь;	
	Для каждого ПТУДляОтвязки Из МассивПТУДляОтвязки Цикл
		обАкцепт = Документы.Акцепт.НайтиСоздатьАктуальныйАкцепт(ПТУДляОтвязки,Ложь);
		//Субботин 75883 10.10.2023 начало
        ТаблицаДанныхДляОтвязкиАкцепта = Документы.Акцепт.СоставитьТЗДанныхДляОтвязкиАкцепта(обАкцепт.Услуги);
		//Субботин 75883 10.10.2023 Конец 
		АкцептИзменен = Ложь;
		СтрокиУслуг = ТаблицаСтрокДляОтвязкиАкцептов.НайтиСтроки(Новый Структура("УчДокумент", ПТУДляОтвязки));
		Для каждого СтрокаУслуг из СтрокиУслуг Цикл
			СтрокиАкцепта = обАкцепт.Услуги.НайтиСтроки(Новый Структура("ИдентификаторСтрокиРасходовВСделке", СтрокаУслуг.ГУИД));
			Для каждого Стр Из СтрокиАкцепта Цикл
				АкцептИзменен = Истина;
				
				СтрокаРассылки = ТаблицаРассылки.Добавить();
				СтрокаРассылки.Сделка = Сделка.Ссылка;
				СтрокаРассылки.ГУИД = СтрокаУслуг.ГУИД;
				СтрокаРассылки.ГУИДАкцепт = Стр.ИдентификаторСтрокиПоступления;
				СтрокаРассылки.Калькуляция = СтрокаУслуг.Калькуляция;
				СтрокаРассылки.Номенклатура = СтрокаУслуг.Услуга;
				СтрокаРассылки.ПТУ = ПТУДляОтвязки;
				СтрокаРассылки.Вагон = ?(ЗначениеЗаполнено(Стр.Вагон),ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Стр.Вагон,"Наименование"),"");
				СтрокаРассылки.КТК = ?(ЗначениеЗаполнено(Стр.Контейнер),ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Стр.Контейнер,"Наименование"),"");
				СтрокаРассылки.ТД = ?(ЗначениеЗаполнено(Стр.ТранспортныйДокумент),ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Стр.ТранспортныйДокумент,"НомерТранспортногоДокумента"),"");
				
				Если Не ОтключатьУслуги Тогда //если мы не удаляем услуги, то в акцепте ничего не трогаем
					Если ОтвязыватьПривязанные Тогда //если удаляем, то проверяем режим работы с привязанными строками
						//Евросиб Каблов 17.01.2022 ( Task 41630
						//Стр.ИдентификаторСтрокиРасходовВСделке = неопределено;
						//Стр.Сделка = неопределено;
						//Стр.ПолностьюРазнесено = Ложь;
						//Стр.НоменклатурнаяГруппа = Неопределено;
						//Стр.СделкаСумма = 0;
						//Стр.СделкаСтавкаНДС = Неопределено;
						//Стр.СделкаСуммаНДС = 0;
						//Стр.НоменклатураСделки = Неопределено;
						//Стр.ВидРасходов = Неопределено;
						//Стр.Сумма = 0;
						//Стр.СуммаНДС = 0;
						//Стр.УчДокумент = Неопределено;
						//Стр.Количество = 0;
						//Стр.Цена = 0;
						//Стр.ПривязалПользователь = Неопределено;
						
						//Субботин 75883 10.10.2023 начало
						СтрокаТаблицыДанныхДляОтвязки = ТаблицаДанныхДляОтвязкиАкцепта.НайтиСтроки(Новый Структура("ГУИД", Стр.Гуид));
						//Было
						//Документы.Акцепт.ОтвязатьСтрокуАкцептаОтСделки(Стр, обАкцепт, Перечисления.СобытияОтвязкиПоступления.ЗаписьСделки);
						//Стало
						Документы.Акцепт.ОтвязатьСтрокуАкцептаОтСделки(СтрокаТаблицыДанныхДляОтвязки[0], обАкцепт, Перечисления.СобытияОтвязкиПоступления.ЗаписьСделки);
						ЗаполнитьЗначенияСвойств(Стр, СтрокаТаблицыДанныхДляОтвязки[0]);
						//Субботин 75883 10.10.2023 Конец 
						//Евросиб Каблов 17.01.2022 )
					КонецЕсли; 
				КонецЕсли; 
			КонецЦикла;
		КонецЦикла; 
		Если АкцептИзменен Тогда
			обАкцепт.ДополнительныеСвойства.Вставить("ЗаписьИзСделки");
			НужноОтправлятьПисьмо = Истина;
			Если Не ОтключатьУслуги Тогда
				Если ОтвязыватьПривязанные Тогда
					//Евросиб Каблов 02.12.2021 ( Ticket#0244590
					//обАкцепт.Записать();
					Попытка // Евросиб Фролов (14.04.2022 Task №50195
						обАкцепт.Записать(РежимЗаписиДокумента.Проведение);
					// Евросиб Фролов (14.04.2022 Task №50195	
					Исключение
						ЗаписьЖурналаРегистрации(НСтр("ru = 'Отвязка строк акцепта от сделки'", Метаданные.ОсновнойЯзык.КодЯзыка),
											УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.Акцепт, обАкцепт, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
							
						ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось отвязать строки акцепта №%1 от %2 от сделки.
                                                         |Ошибка: %3'"),
															обАкцепт.Номер,
															обАкцепт.Дата,
															КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));				
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, обАкцепт);				
					КонецПопытки;
					// Евросиб Фролов)							
					//Евросиб Каблов 02.12.2021 )
				КонецЕсли; 
			КонецЕсли; 
		КонецЕсли; 
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры


Процедура ЗаполнитьРасходы(Сделка) Экспорт
	//ЗаполнитьГУИДыСУЕ
	Для каждого СтрокаСУЕ Из Сделка.СвязьУчетныхЕдиниц Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаСУЕ.ГУИД) Тогда
			СтрокаСУЕ.ГУИД = Новый УникальныйИдентификатор;
