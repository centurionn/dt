	Если ТипЗнч(э_Накладная) = Тип("ДокументСсылка.ТранспортныйДокумент") Тогда
		э_Накладная = э_Накладная.НакладнаяЭТРАН;
	ИначеЕсли ТипЗнч(э_Накладная) = Тип("Строка") Тогда
