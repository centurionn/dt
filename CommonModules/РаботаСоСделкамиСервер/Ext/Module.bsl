	|	СделкаРасходы.ГУИД,
	|	ВЫБОР
	|		КОГДА СделкаРасходы.УчДокумент = ЗНАЧЕНИЕ(Документ.ПоступлениеТоваровУслуг.ПустаяСсылка)
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ,
	|	СделкаРасходы.НомерСтроки
	|ИЗ
	|	ВТ_Расходы КАК СделкаРасходы
	|ГДЕ
	|	СделкаРасходы.ГруппаУслуг > 0
	|И СделкаРасходы.Услуга.УслугаРасходовВыбираетсяПриУсловии = 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Полный.ИсточникПоявленияСтрокиЭкономики КАК ИсточникПоявленияСтрокиЭкономики,
	|	ВТ_Полный.Вагон КАК Вагон,
	|	ВТ_Полный.Контейнер КАК Контейнер,
	|	ВТ_Полный.СтрокаСвязьУчетныхЕдиниц КАК СтрокаСвязьУчетныхЕдиниц,
	|	ВТ_Полный.Поле1 КАК Поле1,
	|	ВТ_Полный.ГУИД КАК ГУИД,
	|	ВТ_Полный.ЕстьУчДокумент КАК ЕстьУчДокумент,
	|	ВТ_Полный.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	ВТ_Полный КАК ВТ_Полный
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИсточникПоявленияСтрокиЭкономики,
	|	Вагон,
	|	Контейнер,
	|	ЕстьУчДокумент УБЫВ,
	|	НомерСтроки";
	МассивИсточниковВагонныхЖДН = Новый Массив;
	МассивИсточниковВагонныхЖДН.Добавить(Перечисления.ИсточникПоявленияСтрокиЭкономики.ЖДНПодсылаВагонов);
	МассивИсточниковВагонныхЖДН.Добавить(Перечисления.ИсточникПоявленияСтрокиЭкономики.ПорожняяЖДН);
	МассивИсточниковВагонныхЖДН.Добавить(Перечисления.ИсточникПоявленияСтрокиЭкономики.ЖДНВозврата);
	МассивИсточниковВагонныхЖДН.Добавить(Перечисления.ИсточникПоявленияСтрокиЭкономики.ЖДНПерестановкиВагонов);
