//ДИТ, Беляев СЮ, Ticket#0252121, 22-12-2021 ++                 
//функция возвращает одну из табличных частей элемента справочника "ФормированиеФинДокументов", исходя из принятых параметров 
Функция ПолучитьТЗнастроекФормированияОписанияУслуг(Знач ТипДокумента, ПараметрыФФД)
	ТЗ = Новый ТаблицаЗначений; 
	Если ПараметрыФФД = Неопределено Тогда 
		Возврат ТЗ;
	КонецЕсли;
	
	ФормированиеФинДокументовСсылка = ПараметрыФФД.ФормированиеФинДокументовСсылка;
	Если ФормированиеФинДокументовСсылка = Справочники.ФормированиеФинДокументов.ПустаяСсылка() Тогда
		Возврат ТЗ;
	КонецЕсли; 
	ФормированиеФинДокументовОбъект = ФормированиеФинДокументовСсылка.ПолучитьОбъект();
	ПараметрыОтбора = Новый Структура("Использование",Истина);
	Если ТипДокумента = "Счет" Тогда
		ТЗ = ФормированиеФинДокументовОбъект.ОписаниеУслугиСчет.Выгрузить(ПараметрыОтбора);
	ИначеЕсли ТипДокумента = "Акт" Тогда
		ТЗ = ФормированиеФинДокументовОбъект.ОписаниеУслугиАкт.Выгрузить(ПараметрыОтбора);
	Иначе
		ТЗ = ФормированиеФинДокументовОбъект.ОписаниеУслугиСчФ.Выгрузить(ПараметрыОтбора);
	КонецЕсли;                                                                            
	Возврат ТЗ;
КонецФункции 
