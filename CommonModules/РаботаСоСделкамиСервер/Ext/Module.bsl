	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СделкаРасходы.СтрокаСвязьУчетныхЕдиниц КАК СтрокаСвязьУчетныхЕдиниц
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&Расходы КАК СделкаРасходы
	|ГДЕ
	|	СделкаРасходы.СтрокаСвязьУчетныхЕдиниц = &ГУИД
	|	И СделкаРасходы.УслугаОтключена = ЛОЖЬ
