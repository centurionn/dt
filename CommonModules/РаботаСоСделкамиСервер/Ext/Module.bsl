Процедура ДобавитьСтрокиРасходовВСделку(СделкаОбъект, ТаблицаДанных, ДанныеИзСП = Ложь) Экспорт
	
	//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 113659, 03-07-2025, начало
	МассивИдентификаторовГруппировкиКорректировокВР = Новый Массив;
	МассивГУИДРасходовПеревязатьНаСтрокиКорректировки = Новый Массив;
	ЕстьКолонкаИдентификаторСтрокиДоходовВСделкеКорректируемый = Ложь;
	Если ТипЗнч(ТаблицаДанных) = Тип("Массив") И ТаблицаДанных.Количество() > 0 Тогда
		//Евросиб Каблов 18.08.2025 ( #117204
		//ТабЗначений = ТаблицаДанных[0].Владелец();
		//ЕстьКолонкаИдентификаторСтрокиДоходовВСделкеКорректируемый = ТабЗначений.Колонки.Найти("ИдентификаторСтрокиДоходовВСделкеКорректируемый") <> Неопределено;
		СтрокаТаблицыДанных = ТаблицаДанных[0];
		Если ТипЗнч(СтрокаТаблицыДанных) = Тип("СтрокаТаблицыЗначений") Тогда
			ТабЗначений = ТаблицаДанных[0].Владелец();
			ЕстьКолонкаИдентификаторСтрокиДоходовВСделкеКорректируемый = ТабЗначений.Колонки.Найти("ИдентификаторСтрокиДоходовВСделкеКорректируемый") <> Неопределено;
		ИначеЕсли ТипЗнч(СтрокаТаблицыДанных) = Тип("Структура") Тогда
			ЕстьКолонкаИдентификаторСтрокиДоходовВСделкеКорректируемый = СтрокаТаблицыДанных.Свойство("ИдентификаторСтрокиДоходовВСделкеКорректируемый");
		КонецЕсли;
		//Евросиб Каблов 18.08.2025 )
	КонецЕсли;
	//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 113659, 03-07-2025, конец
	
	Для каждого Стр из ТаблицаДанных Цикл
		
		// Евросиб US 83437 TA 83438 Рыбьяков К.А. 03.07.2024 ((
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Стр, "ДанныеИзСП") Тогда
			ДанныеИзСП = Стр.ДанныеИзСп;
		КонецЕсли; 
		// Евросиб Рыбьяков К.А. 03.07.2024 ))
		
		Если Стр.Доходы = Истина Тогда
			
			НДоходы = неопределено;
			Для каждого ДСтр из СделкаОбъект.Доходы Цикл
				Если ДСтр.ГУИД = Стр.ГУИДСтрокиДоходов Тогда НДоходы = ДСтр; Прервать; КонецЕсли;
			КонецЦикла;
			
			Если НДоходы = неопределено Тогда
				НДоходы = СделкаОбъект.Доходы.Добавить();
				//ДИТ, Беляев СЮ, ТА48688, 28-03-2022, начало 
				НДоходы.ДатаПоявленияСтрокиЭкономики = ТекущаяДата();
				//ДИТ, Беляев СЮ, ТА48688, 28-03-2022, конец  
								
				ЗаполнитьЗначенияСвойств(НДоходы, Стр, "Клиент, Договор, Услуга, Калькуляция, Себестоимость, Вознаграждение, Ставка, Количество, СебестоимостьИтого, ВознаграждениеИтого, СтавкаИтого, Рентабельность, СтавкаНДС, СуммаНДС, НДСВключенВСтоимость, СуммаИтого, Груз, РазмерКТК, Валюта, Перевыставляемая, НоменклатурнаяГруппа, ПСЦ, Подсыл, Комментарий, НеВыставлятьКлиенту, УслугаВнеСтавки, ПроцентВознаграждения, СтавкаНДСВознаграждения, ВознаграждениеВключаетНДС, ЕдиницаИзмерения, ИсточникПоявленияСтрокиЭкономики");
				нДоходы.ГотовоКВыставлению = Истина;
				
				Если СделкаОбъект.СтанцияОтправления = Справочники.Локации.ВСЕ Тогда
					СделкаОбъект.СтанцияОтправления = Стр.ПунктОтправления;
					СделкаОбъект.СтанцияНазначения = Стр.ПунктНазначения;
				КонецЕсли;
				
				//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 113659, 03-07-2025, начало
				Если ЕстьКолонкаИдентификаторСтрокиДоходовВСделкеКорректируемый И ЗначениеЗаполнено(Стр.ИдентификаторСтрокиДоходовВСделкеКорректируемый) Тогда
						НДоходы.ГУИДИсправляемойСтроки = Стр.ИдентификаторСтрокиДоходовВСделкеКорректируемый;
						СтрокаДоходаИсправляемая = СделкаОбъект.Доходы.Найти(НДоходы.ГУИДИсправляемойСтроки,"ГУИД");
						Если Стр.ВидОперацииКорректировки = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение Тогда
							НДоходы.Себестоимость = СтрокаДоходаИсправляемая.Себестоимость + Стр.Себестоимость;
							НДоходы.СебестоимостьИтого = СтрокаДоходаИсправляемая.СебестоимостьИтого + Стр.СебестоимостьИтого;
							НДоходы.Ставка = СтрокаДоходаИсправляемая.Ставка + Стр.Ставка;
							НДоходы.СтавкаИтого = СтрокаДоходаИсправляемая.СтавкаИтого + Стр.СтавкаИтого;
							НДоходы.СуммаИтого = СтрокаДоходаИсправляемая.СуммаИтого + Стр.СуммаИтого;
							НДоходы.СуммаНДС = СтрокаДоходаИсправляемая.СуммаНДС + Стр.СуммаНДС;
						Иначе
							НДоходы.Себестоимость = Стр.Себестоимость;
							НДоходы.СебестоимостьИтого = Стр.СебестоимостьИтого;
							НДоходы.Ставка = Стр.Ставка;
							НДоходы.СтавкаИтого = Стр.СтавкаИтого;
							НДоходы.СуммаИтого = Стр.СуммаИтого;
							НДоходы.СуммаНДС = Стр.СуммаНДС;
							МассивГУИДРасходовПеревязатьНаСтрокиКорректировки.Добавить(Стр.ГУИДРасходов);
						КонецЕсли;
						НДоходы.ПроцентВознаграждения = СтрокаДоходаИсправляемая.ПроцентВознаграждения;
						НДоходы.СтавкаНДСВознаграждения = СтрокаДоходаИсправляемая.СтавкаНДСВознаграждения;
						НДоходы.ВознаграждениеВключаетНДС = СтрокаДоходаИсправляемая.ВознаграждениеВключаетНДС;
						НДоходы.ДобавленаКорректировкаИзАкцепта = Истина;
						МассивИдентификаторовГруппировкиКорректировокВР.Добавить(СтрокаДоходаИсправляемая.ИдентификаторГруппировки);
				КонецЕсли;
				//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 113659, 03-07-2025, конец
				
				//Евросиб - АСуслов 08.11.2023 13:04:41 #77057
				//(
				Стр.ГуидСтрокиДоходов = Новый УникальныйИдентификатор;
				//)
				//Евросиб - АСуслов 08.11.2023 13:04:46 #77057
				НДоходы.ГУИД = Стр.ГУИДСтрокиДоходов;
				НДоходыСписокКТК = СтрСоединить(Стр.СписокКТК.ВыгрузитьЗначения(), ";");
				Если ЗначениеЗаполнено(НДоходыСписокКТК) Тогда
					НДоходыКТКСтр = СделкаОбъект.ДоходыКТК.Добавить();
					НДоходыКТКСтр.ГУИД = НДоходы.ГУИД;
					НДоходыКТКСтр.КТК = НДоходыСписокКТК;
				КонецЕсли;
				НДоходыСписокВагонов = СтрСоединить(Стр.СписокВагонов.ВыгрузитьЗначения(), ";");
				Если ЗначениеЗаполнено(НДоходыСписокВагонов) Тогда
					НДоходыКТКСтр = СделкаОбъект.ДоходыВагоны.Добавить();
					НДоходыКТКСтр.ГУИД = НДоходы.ГУИД;
					НДоходыКТКСтр.Вагон = НДоходыСписокВагонов;
				КонецЕсли;
				НДоходыСписокТД = СтрСоединить(Стр.СписокТД.ВыгрузитьЗначения(), ";");
				Если ЗначениеЗаполнено(НДоходыСписокТД) Тогда
					НДоходыКТКСтр = СделкаОбъект.ДоходыТД.Добавить();
					НДоходыКТКСтр.ГУИД = НДоходы.ГУИД;
					НДоходыКТКСтр.ТД = НДоходыСписокТД;
				КонецЕсли;
				НДоходы.РеестрКлиента = Стр.НомерРеестра;
				НДоходы.ПериодВО = неопределено;
				
				ОбработатьСтрокуДоходов(НДоходы);
			Иначе
				//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 114152, 06-08-2025, начало
				Если НДоходы.ГУИДИсправляемойСтроки <> "" И НДоходы.ИсточникПоявленияСтрокиЭкономики = Перечисления.ИсточникПоявленияСтрокиЭкономики.ДобавленоИзАкцепта Тогда
					ЗаполнитьЗначенияСвойств(НДоходы, Стр, "Себестоимость, СебестоимостьИтого, Ставка, СтавкаИтого, СуммаИтого, СуммаНДС, СтавкаНДС");
					Если НЕ Стр.НДСВключенВСтоимость Тогда //в строках дохода с ВР всегда сумма включает НДС
						НДоходы.Себестоимость = НДоходы.Себестоимость + НДоходы.СуммаНДС;
					КонецЕсли;
					ОбработатьСтрокуДоходов(НДоходы);
				КонецЕсли;
				//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 114152, 06-08-2025, конец
			КонецЕсли;  
			
		КонецЕсли;
		
		Если Стр.Расходы = Истина Тогда
			
			НРасходы = неопределено;
			Для каждого ДСтр из СделкаОбъект.Расходы Цикл
				Если ДСтр.ГУИД = Стр.ГУИДРасходов Тогда НРасходы = ДСтр; Прервать; КонецЕсли;
			КонецЦикла;
			
			Если НРасходы = неопределено Тогда
				НРасходы = СделкаОбъект.Расходы.Добавить();
			//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 113659, 03-07-2025, начало
			Иначе
				Если МассивГУИДРасходовПеревязатьНаСтрокиКорректировки.Найти(НРасходы.ГУИД) <> Неопределено Тогда
					НайденоСвязьДоходовИРасходов = СделкаОбъект.СвязьДоходовИРасходов.НайтиСтроки(Новый Структура("Расходы", НРасходы.ГУИД));
					Если НайденоСвязьДоходовИРасходов.Количество()>0 Тогда
						СделкаОбъект.СвязьДоходовИРасходов.Удалить(НайденоСвязьДоходовИРасходов[0]);
					КонецЕсли;
				КонецЕсли;
			//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 113659, 03-07-2025, конец
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(НРасходы, Стр, "Услуга, Калькуляция, Себестоимость, Количество, СебестоимостьИтого, Груз, ВознаграждениеИтого, ВнутренняяСебестоимость, Валюта, Перевыставляемая, НоменклатурнаяГруппа, Подсыл, Комментарий, НеВключатьВПлановыеРасходы, ПунктОтправления, ПунктНазначения, ИсточникПоявленияСтрокиЭкономики, ЕдиницаИзмерения, ОтнестиНаЗатраты, АвтоматическиПривязыватьРасходКДоходу");			
			НРасходы.Услуга = Стр.УслугаРасхода;
			
			НРасходы.Поставщик = Стр.Расходы_Поставщик;
