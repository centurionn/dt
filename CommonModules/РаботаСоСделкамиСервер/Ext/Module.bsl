	Пакеты = Запрос.ВыполнитьПакет();
	Ответ = Пакеты[Пакеты.Количество()-2].Выбрать();
	ГрузыЖД = Пакеты[Пакеты.Количество()-1].Выгрузить();
	
	Если ГрузыЖД.Количество() > 1000 Тогда
		ГрузыЖД.Индексы.Добавить("Ссылка");
	КонецЕсли;
	
	Пока Ответ.Следующий() Цикл
		
		УсловиеГрузаСоблюдено = Ложь;
		УсловиеСтанцииСоблюдено = Ложь;
		УсловиеРемонтаСоблюдено = Истина;
		ВтороеУсловиеСтанцииСоблюдено = Истина;
		
		Если ДатаРаскредитацииИзГрЖДН <> '00010101' Тогда
			ВтороеУсловиеСтанцииСоблюдено = ПроверитьСтанцииОтправленияИНазначения(Ответ.СтанцияНазначенияКод, Ответ.СтанцияОтправленияКод);
		КонецЕсли;
		
		Если ДатаРаскредитацииИзГрЖДН <> '00010101' Тогда
			УсловиеСтанцииСоблюдено = ВсеКодыВсехАналоговСтанции.Найти(Ответ.СтанцияОтправленияКод) <> неопределено;
		КонецЕсли;
		
		СтрокиГрузыЖД = ГрузыЖД.НайтиСтроки(Новый Структура("Ссылка", Ответ.Ссылка));
		Для каждого Стр из СтрокиГрузыЖД Цикл
			УсловиеГрузаСоблюдено = УсловиеГрузаСоблюдено ИЛИ КодыЕТСНГПорожниевагоны.Найти(Стр.ЕТСНГКод) <> неопределено; 
			Если ИсключатьРемонт
				И (Стр.ЕТСНГКод = "421195" 
				И Ответ.ЭтоНакладнаяВРемонт 
				Или Ответ.ЭтоНакладнаяПередРемонтом) Тогда
				УсловиеРемонтаСоблюдено = Ложь;
			КонецЕсли;
		КонецЦикла;

		Если УсловиеГрузаСоблюдено 
			И УсловиеСтанцииСоблюдено 
			И УсловиеРемонтаСоблюдено
			И ВтороеУсловиеСтанцииСоблюдено Тогда 
			НакладнаяПодсылаВагона = Ответ.НакладнаяНомер;
			НакладнаяПодсылаСсылка = Ответ.Ссылка;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(НакладнаяПодсылаСсылка) И СтанцияОтправленияСтрогоСоответствуетСтанцииПрибытия = Истина И НакладнаяПодсылаСсылка.СтанцияОтправленияКод <> НакладнаяПодсылаСсылка.СтанцияНазначенияКод Тогда
		НакладнаяПодсылаВагона = "";
		НакладнаяПодсылаСсылка = Неопределено;
	КонецЕсли;
	
	СтруктураРезультат = Новый Структура("НакладнаяПодсылаВагона, НакладнаяПодсылаВагонаСсылка", НакладнаяПодсылаВагона, НакладнаяПодсылаСсылка);
	
	Возврат СтруктураРезультат;
	
