Функция СведенияКорректировочногоАкцепта(АкцептОбъект, Сделка) Экспорт
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("ЭтоКорректировочныйАкцепт", Ложь);
	СтруктураОтвета.Вставить("СтрокиКорректировкиПоступления", Неопределено);
	
	Если ТипЗнч(АкцептОбъект.Поступление) = Тип("ДокументСсылка.КорректировкаПоступления") Тогда
		
		СтруктураОтвета.ЭтоКорректировочныйАкцепт = Истина;
		
		ТаблицаОтвязываемыхСтрок = АкцептОбъект.Услуги.Выгрузить(Новый Структура("Сделка", Сделка), "ИдентификаторСтрокиПоступления, ИдентификаторСтрокиРасходовВСделке, ГУИД");
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТаблицаАкцепта.ИдентификаторСтрокиПоступления КАК ИдентификаторСтрокиПоступления,
		|	ТаблицаАкцепта.ИдентификаторСтрокиРасходовВСделке КАК ИдентификаторСтрокиРасходовВСделке,
		|	ТаблицаАкцепта.ГУИД КАК ГУИД
