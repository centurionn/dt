Функция ПолучитьСписокПолейСТипомНакладная(Сделка) Экспорт
	МассивПолей = Новый Массив;
	ТипТранспортныйДокумент = Новый ОписаниеТипов("ДокументСсылка.ТранспортныйДокумент");
	Для каждого РеквизитТЧ Из Сделка.Метаданные().ТабличныеЧасти.СвязьУчетныхЕдиниц.Реквизиты Цикл
		Если РеквизитТЧ.Тип = ТипТранспортныйДокумент Тогда
			МассивПолей.Добавить(РеквизитТЧ.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат МассивПолей;
КонецФункции

Функция СравнитьДанные(Источник1, Источник2, ПоляСравнения)
	СтруктураИсточник1 = Новый Структура(ПоляСравнения);
	СтруктураИсточник2 = Новый Структура(ПоляСравнения);
	ЗаполнитьЗначенияСвойств(СтруктураИсточник1, Источник1);
	ЗаполнитьЗначенияСвойств(СтруктураИсточник2, Источник2);            
	Возврат ОбщегоНазначения.КоллекцииИдентичны(СтруктураИсточник1, СтруктураИсточник2);
КонецФункции

