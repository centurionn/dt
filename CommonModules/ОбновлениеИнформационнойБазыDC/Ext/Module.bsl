	ВидыПеревозокПустаяСсылка = Справочники.ВидыПеревозок.ПустаяСсылка();
	
	Если Справочники.ВидыПеревозок.НайтиПоНаименованию("Вне территории РФ") = ВидыПеревозокПустаяСсылка Тогда
		ВидыПеревозокОбъект = Справочники.ВидыПеревозок.СоздатьЭлемент();
