Процедура ЗаполнитьТаблицыМаршрутовИзРеквизитов() Экспорт
	
	//В справочнике Маршрутизация заменяем реквизиты Контрагент и Договор на таблицу КонтрагентыИДоговоры,
	//реквизит ВидПеревозки на таблицу ВидыПеревозок 
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Маршрутизация.Ссылка КАК Ссылка,
		|	Маршрутизация.УдалитьКонтрагент КАК УдалитьКонтрагент,
		|	Маршрутизация.УдалитьДоговор КАК УдалитьДоговор,
		|	Маршрутизация.УдалитьВидПеревозки КАК УдалитьВидПеревозки
		|ИЗ
		|	Справочник.Маршрутизация КАК Маршрутизация
		|ГДЕ
		|	(Маршрутизация.УдалитьКонтрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|			ИЛИ Маршрутизация.УдалитьДоговор <> ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
		|			ИЛИ Маршрутизация.УдалитьВидПеревозки <> ЗНАЧЕНИЕ(Справочник.ВидыПеревозок.ПустаяСсылка))";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		МаршрутОбъект = Выборка.Ссылка.ПолучитьОбъект();  
		Если ЗначениеЗаполнено(Выборка.УдалитьВидПеревозки) Тогда
			НС = МаршрутОбъект.ВидыПеревозок.Добавить();
			НС.ВидПеревозки = Выборка.УдалитьВидПеревозки;
		КонецЕсли;   
		
		Если ЗначениеЗаполнено(Выборка.УдалитьКонтрагент) или ЗначениеЗаполнено(Выборка.УдалитьДоговор) Тогда
			НС = МаршрутОбъект.КонтрагентыИДоговоры.Добавить();
			НС.Договор = Выборка.УдалитьДоговор;
			НС.Контрагент = Выборка.УдалитьКонтрагент;	
		КонецЕсли; 
		МаршрутОбъект.Записать();
		
	КонецЦикла;	

КонецПроцедуры  
#КонецОбласти

