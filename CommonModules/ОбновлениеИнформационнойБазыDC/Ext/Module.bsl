Процедура ЗаполнениеПризнаковПоставщикКлиентКонтрагентовСервисаДиадок() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВложенныйЗапрос.КонтрагентСервиса КАК КонтрагентСервиса,
		|	ВложенныйЗапрос.Контрагент КАК Контрагент,
		|	ЕСТЬNULL(ВложенныйЗапрос.Контрагент.ТипКонтрагента_Подрядчик, ЛОЖЬ) КАК Поставщик,
		|	ЕСТЬNULL(ВложенныйЗапрос.Контрагент.ТипКонтрагента_Клиент, ЛОЖЬ) КАК Клиент
		|ИЗ
		|	(ВЫБРАТЬ
		|		Диадок_ЮрФизЛица.Ссылка КАК КонтрагентСервиса,
		|		Диадок_ЮрФизЛица.СвязанныйСправочник1 КАК Контрагент
		|	ИЗ
		|		Справочник.Диадок_ЮрФизЛица КАК Диадок_ЮрФизЛица
		|	ГДЕ
		|		Диадок_ЮрФизЛица.СвязанныйСправочник1 ССЫЛКА Справочник.Контрагенты) КАК ВложенныйЗапрос
		|ГДЕ
		|	(ЕСТЬNULL(ВложенныйЗапрос.Контрагент.ТипКонтрагента_Подрядчик, ЛОЖЬ)
		|			ИЛИ ЕСТЬNULL(ВложенныйЗапрос.Контрагент.ТипКонтрагента_Клиент, ЛОЖЬ))";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		КонтрагентДиадокОбъект = Выборка.КонтрагентСервиса.ПолучитьОбъект();
		КонтрагентДиадокОбъект.Клиент = Выборка.Клиент;
		КонтрагентДиадокОбъект.Поставщик = Выборка.Поставщик;
		КонтрагентДиадокОбъект.Записать();
		
	КонецЦикла;
	
