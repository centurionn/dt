Процедура ЗаполнитьРегиональныйЦФОВСделках() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Сделка.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Сделка КАК Сделка
	|ГДЕ
	|	Сделка.РегиональныйЦФО = &РегиональныйЦФО";
	Запрос.УстановитьПараметр("РегиональныйЦФО", Справочники.РегиональныеЦФО.ПустаяСсылка());
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		обСделка = Выборка.Ссылка.ПолучитьОбъект();
		Если обСделка.Служебная Тогда                                              
			РегиональныйЦФОРасходыДКП = Справочники.РегиональныеЦФО.РасходыДКП;
			обСделка.РегиональныйЦФО = РегиональныйЦФОРасходыДКП;
		ИначеЕсли НЕ ЗначениеЗаполнено(обСделка.РегиональныйЦФО) Тогда 
			ДорогаСтанцииОтправления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(обСделка.СтанцияОтправления,"ЖелезнаяДорога");
			Если ЗначениеЗаполнено(ДорогаСтанцииОтправления) Тогда
				обСделка.РегиональныйЦФО = Справочники.РегиональныеЦФО.ПолучитьРегиональныйЦФОПоДороге(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(обСделка.СтанцияОтправления,"ЖелезнаяДорога"));	
			КонецЕсли;
		КонецЕсли;           
		Если ЗначениеЗаполнено(обСделка.РегиональныйЦФО) Тогда
			обСделка.ОбменДанными.Загрузка = Истина;
			обСделка.Записать();
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

