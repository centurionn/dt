	обВидЖДН.СвязанныеУслуги.Очистить();
	нУслуга = обВидЖДН.СвязанныеУслуги.Добавить();
	нУслуга.Услуга = Справочники.Номенклатура.НайтиПоНаименованию("ПорожнийТарифПодПогрузкуРФ", Истина);
	нУслуга = обВидЖДН.СвязанныеУслуги.Добавить();
	нУслуга.Услуга = Справочники.Номенклатура.НайтиПоНаименованию("Порожний ТарифПодПогрузкуПрочТерритории", Истина);
	обВидЖДН.Записать();
		
	//Порожняя ЖДН (КТК)
	ссВидЖДН = Справочники.ВидыЖДН.ПорожняяЖДН_КТК;
