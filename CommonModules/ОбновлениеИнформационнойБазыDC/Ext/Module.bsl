Процедура СоздатьПредопределенныйЭлементИсточникиПакетовДанныхПолучениеДанныхГеокодера() Экспорт
	
	НаименованиеЭлемента = "Получение данных геокодера";
	НайденныйЭлемент = Справочники.ИсточникиПакетовДанных.НайтиПоНаименованию(НаименованиеЭлемента); 
	
	Если ЗначениеЗаполнено(НайденныйЭлемент) Тогда
		СостояниеОбъект = НайденныйЭлемент.ПолучитьОбъект();
	Иначе
		СостояниеОбъект = Справочники.ИсточникиПакетовДанных.СоздатьЭлемент();
		СостояниеОбъект.Наименование = НаименованиеЭлемента;
	КонецЕсли;
	
	СостояниеОбъект.ИмяПредопределенныхДанных = "ПолучениеДанныхГеокодера";
	СостояниеОбъект.ОбменДанными.Загрузка = Истина;
	СостояниеОбъект.Записать();

КонецПроцедуры //Евросиб Коханенко Н.А. 19.12.2025 )) #125251
