//ДИТ Авдеева В. 43126 04.04.2022 начало      
Процедура ОбновитьПредопределеннуюНоменклатуруТЭУ() Экспорт
	НоменклатураТЭУ = Справочники.Номенклатура.НайтиПоКоду("Z00000063");
	Если ЗначениеЗаполнено(НоменклатураТЭУ) Тогда
		НоменклатураОбъект = НоменклатураТЭУ.ПолучитьОбъект();
		НоменклатураОбъект.ИмяПредопределенныхДанных = "ТЭУ";
		НоменклатураОбъект.ОбменДанными.Загрузка = Истина;
		НоменклатураОбъект.Записать();
	КонецЕсли;
     
КонецПроцедуры
