#Область ОбработчикиПереходаНаВерсию_1_0_0_28
Процедура ОбновитьДанныеВидовЖДН() Экспорт

	Выборка = Справочники.ВидыЖДН.Выбрать();
	Пока Выборка.Следующий() Цикл
		обВидЖДН = Выборка.ПолучитьОбъект();       
		//Груженая ЖДН
		//Груженая ЖДН порожний КТК
		//ЖДН перестановки до груж. КТК
		//ЖДН после груж. (вагон)
		//Порожняя ЖДН (ваг)
		Если обВидЖДН.Ссылка = Справочники.ВидыЖДН.ГруженаяЖДН 
			ИЛИ обВидЖДН.Ссылка = Справочники.ВидыЖДН.ГруженаяЖДН_ПорожнийКТК
			ИЛИ обВидЖДН.Ссылка = Справочники.ВидыЖДН.ЖДН_ПерестановкиДоГружКТК
			ИЛИ обВидЖДН.Ссылка = Справочники.ВидыЖДН.ЖДН_ПослеГружВагон
			ИЛИ обВидЖДН.Ссылка = Справочники.ВидыЖДН.ПорожняяЖДН_Ваг
			Тогда
			обВидЖДН.ИмяРеквизитаВагонВСоставеПоезда = "Вагон";
		КонецЕсли;
		//ЖДН перестановки до пор. КТК
		//Порожняя ЖДН (КТК)
		//ЖДН подсыла под порожний КТК
		Если обВидЖДН.Ссылка = Справочники.ВидыЖДН.ЖДН_ПерестановкиДоПорКТК 
			ИЛИ обВидЖДН.Ссылка = Справочники.ВидыЖДН.ПорожняяЖДН_КТК
			ИЛИ обВидЖДН.Ссылка = Справочники.ВидыЖДН.ЖДН_ПодсылПодПорожнийКТК
			Тогда
			обВидЖДН.ИмяРеквизитаВагонВСоставеПоезда = "ВагонПодсылаПорКТК";
		КонецЕсли;
		//из реквизита "ВагонПересылаПорКТК " для накладных вида:
		//ЖДН после груж. (КТК)
		Если обВидЖДН.Ссылка = Справочники.ВидыЖДН.ЖДН_ПослеГружКТК 
			Тогда
			обВидЖДН.ИмяРеквизитаВагонВСоставеПоезда = "ВагонПересылаПорКТК";
		КонецЕсли;
		//установить в Истина "ЭтоВагоннаяЖДН" для всех текущих видов ЖДН кроме тех, 
		//у кого "имя реквизита в составе поезда" = НакладнаяПослеГружКТК, ПорожняяЖДНКТК или ЖДН	
		Если обВидЖДН.ИмяРеквизитаЖДНВСоставеПоезда = "ЖДН"
			ИЛИ обВидЖДН.ИмяРеквизитаЖДНВСоставеПоезда = "НакладнаяПослеГружКТК" 
			ИЛИ обВидЖДН.ИмяРеквизитаЖДНВСоставеПоезда = "ПорожняяЖДНКТК" 
			Тогда
			обВидЖДН.ЭтоВагоннаяЖДН = Ложь;
		Иначе
			обВидЖДН.ЭтоВагоннаяЖДН = Истина;
		КонецЕсли;                          
		обВидЖДН.Записать();
	КонецЦикла;
	
КонецПроцедуры
#КонецОбласти

