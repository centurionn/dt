			Запись = Движения.Добавить();
			Запись.Период = Выборка.ПериодБлокировки;
			Запись.Организация = Выборка.Организация;
			Запись.Регистратор = Выборка.Закрытие;
			
			Движения.Записать();
			
		КонецЕсли;		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗакрытыеПериодыБУ.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрСведений.ЗакрытыеПериодыБУ КАК ЗакрытыеПериодыБУ";
	
