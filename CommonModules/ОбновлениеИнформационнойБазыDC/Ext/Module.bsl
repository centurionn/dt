//Евросиб Каблов 27.12.2019 ( Ticket#0183004
Процедура ЗаполнитьВопросыОтветыАнкетКонтрагентов() Экспорт
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обработка вопросов анкет");
	
	//Характеристика структуры рынка
	Попытка
		ВопросОбъект = ПланыВидовХарактеристик.ВопросыАнкетКонтрагентов.ХарактеристикаСтруктурыРынкаТоваровУслуг.ПолучитьОбъект();
	Исключение
		ВопросОбъект = ПланыВидовХарактеристик.ВопросыАнкетКонтрагентов.СоздатьЭлемент();
		ВопросОбъект.ИмяПредопределенныхДанных = "ХарактеристикаСтруктурыРынкаТоваровУслуг";
	КонецПопытки;	
	ВопросОбъект.Наименование = "Характеристика структуры рынка товаров и услуг";
	ВопросОбъект.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.ОтветыНаВопросыАнкет");
	ВопросОбъект.ТипКонтрагента_Подрядчик = Истина;
	ВопросОбъект.Записать();

	Попытка
		ОтветОбъект = Справочники.ОтветыНаВопросыАнкет.ХарактеристикаСтруктурыРынкаТоваровУслуг_Монополия.ПолучитьОбъект();
	Исключение
		ОтветОбъект = Справочники.ОтветыНаВопросыАнкет.СоздатьЭлемент();
		ОтветОбъект.ИмяПредопределенныхДанных = "ХарактеристикаСтруктурыРынкаТоваровУслуг_Монополия";
	КонецПопытки;
	ОтветОбъект.Наименование = "Монополия";
	ОтветОбъект.ВопросАнкеты = ВопросОбъект.Ссылка;
