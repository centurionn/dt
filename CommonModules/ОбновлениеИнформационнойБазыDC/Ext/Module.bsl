	ИменаНовыхЭлементов.Добавить(Новый Структура("Наименование, Имя", "teu", "TEU"));
	
	Для Каждого Элемент Из ИменаНовыхЭлементов Цикл
		ЭлементСсылка = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию(Элемент.Наименование, Истина);
		Если ЗначениеЗаполнено(ЭлементСсылка) Тогда
			ЭлементОбъект = ЭлементСсылка.ПолучитьОбъект();
			ЭлементОбъект.ИмяПредопределенныхДанных = Элемент.Имя;
			ЭлементОбъект.ОбменДанными.Загрузка = Истина;
			ЭлементОбъект.Записать();
		Иначе
			ЭлементОбъект = Справочники.КлассификаторЕдиницИзмерения.СоздатьЭлемент();
			ЭлементОбъект.ИмяПредопределенныхДанных = Элемент.Имя;
			ЭлементОбъект.Наименование = Элемент.Наименование;
			ЭлементОбъект.ОбменДанными.Загрузка = Истина;
			ЭлементОбъект.Записать();
		КонецЕсли;
	КонецЦикла;
	
