Процедура ЗаполнитьТЭО()
	обТЭО = СПравочники.ВидыУслугПоставщиков.ТЭО.ПолучитьОбъект();
	
	сПоиск = Новый Структура("ИмяТаблицы","ПротоколСНормативнымиСтавкамиНаУслугиПоставщиков.Услуги");
	
	НайденныеСтроки = обТЭО.ПоляТаблицыУслуг.НайтиСтроки(сПоиск);
	ТЗВрем = обТЭО.ПоляТаблицыУслуг.Выгрузить(НайденныеСтроки);
	обТЭО.ПоляТаблицыУслуг.Очистить();
	обТЭО.ПоляТаблицыУслуг.Загрузить(ТЗВрем);
	
	НайденныеСтроки = обТЭО.СпискиВыбора.НайтиСтроки(сПоиск);
	ТЗВрем = обТЭО.СпискиВыбора.Выгрузить(НайденныеСтроки);
	обТЭО.СпискиВыбора.Очистить();
	обТЭО.СпискиВыбора.Загрузить(ТЗВрем);
	
	НайденныеСтроки = обТЭО.ОграниченияТипов.НайтиСтроки(сПоиск);
	ТЗВрем = обТЭО.ОграниченияТипов.Выгрузить(НайденныеСтроки);
	обТЭО.ОграниченияТипов.Очистить();
	обТЭО.ОграниченияТипов.Загрузить(ТЗВрем);
	
	НайденныеСтроки = обТЭО.ПараметрыВыбора.НайтиСтроки(сПоиск);
	ТЗВрем = обТЭО.ПараметрыВыбора.Выгрузить(НайденныеСтроки);
	обТЭО.ПараметрыВыбора.Очистить();
	обТЭО.ПараметрыВыбора.Загрузить(ТЗВрем);
	
	НайденныеСтроки = обТЭО.ПоляПоиска.НайтиСтроки(сПоиск);
	ТЗВрем = обТЭО.ПоляПоиска.Выгрузить(НайденныеСтроки);
	обТЭО.ПоляПоиска.Очистить();
	обТЭО.ПоляПоиска.Загрузить(ТЗВрем);
	
	обТЭО.ТипУчетныхЕдиницДетализации = "";
	
	ЗаполнитьПоляУслугиТЭО(обТЭО);
	
	ЗаполнитьОграниченияТипаТЭО(обТЭО);
	
	ЗаполнитьОтборыТЭО(обТЭО);
	
	ЗаполнитьСпискиВыбораТЭО(обТЭО);
	
	обТЭО.Записать();
КонецПроцедуры

