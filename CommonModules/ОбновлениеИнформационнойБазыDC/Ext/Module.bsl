Процедура СоздатьЭлементыСтатусыЗаявок() Экспорт
	МассивСтатусов = Новый Массив;
	МассивСтатусов.Вставить(50,"Не Отправлен");
	МассивСтатусов.Вставить(51,"Отправлен");
	МассивСтатусов.Вставить(52,"Частично отправлен");
	МассивСтатусов.Вставить(53,"Частично отправлен, без ответа");
	МассивСтатусов.Вставить(54,"Отправлен, без ответа");
	МассивСтатусов.Вставить(55,"Частично принят");
	МассивСтатусов.Вставить(56,"Принят");
	МассивСтатусов.Вставить(57,"Не принят");
	МассивСтатусов.Вставить(58,"Версия отправки устарела");
	МассивСтатусов.Вставить(59,"Удалено");
	
	МассивСтатусовПред = Новый Массив;
	МассивСтатусовПред.Вставить(50,"НеОтправлен");
	МассивСтатусовПред.Вставить(51,"Отправлен");
	МассивСтатусовПред.Вставить(52,"ЧастичноОтправлен");
	МассивСтатусовПред.Вставить(53,"ЧастичноОтправленБезОтвета");
	МассивСтатусовПред.Вставить(54,"ОтправленБезОтвета");
	МассивСтатусовПред.Вставить(55,"ЧастичноПринят");
	МассивСтатусовПред.Вставить(56,"Принят");
	МассивСтатусовПред.Вставить(57,"НеПринят");
	МассивСтатусовПред.Вставить(58,"ВерсияОтправкиУстарела");
	МассивСтатусовПред.Вставить(59,"Удалено");
	
	Для инд = 50 По 59 Цикл
		
		НайденыйЭлемент = Справочники.СибурСтатусыЗаявок.НайтиПоРеквизиту("КодСтатуса",СокрЛП(инд));
		Если НЕ ЗначениеЗаполнено(НайденыйЭлемент) Тогда
			НовЭлемент = Справочники.СибурСтатусыЗаявок.СоздатьЭлемент();
			НовЭлемент.Наименование = МассивСтатусов.Получить(инд);
			НовЭлемент.КодСтатуса = инд;
			НовЭлемент.ВидЗаявки = Перечисления.ВидыЗаявокСибура.РелизКлиента;
			НовЭлемент.ИмяПредопределенныхДанных = МассивСтатусовПред.Получить(инд);
			НовЭлемент.Записать();
		Иначе
			СпрНайд = НайденыйЭлемент.ПолучитьОбъект();
			СпрНайд.ИмяПредопределенныхДанных = МассивСтатусовПред.Получить(инд);
			СпрНайд.Записать();
		КонецЕсли;	
	КонецЦикла;	
	
