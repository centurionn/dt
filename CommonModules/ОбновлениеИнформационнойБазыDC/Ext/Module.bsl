Процедура ОбновитьЗаписиМорскихРейсовВРегистре()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РейсыМоре.ПунктОтправления КАК МестоПогрузки,
		|	РейсыМоре.ПунктНазначения КАК МестоРазгрузки,
		|	РейсыМоре.МестоПогрузки КАК ПунктОтправления,
		|	РейсыМоре.МестоРазгрузки КАК ПунктНазначения,
		|	РейсыМоре.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.РейсыМоре КАК РейсыМоре
		|ГДЕ
		|	(РейсыМоре.МестоПогрузки.Тип = &ТипПорт
		|			ИЛИ РейсыМоре.МестоРазгрузки.Тип = &ТипПорт)
		|	И (РейсыМоре.ПунктОтправления.Тип = &ТипТерминал
		|			ИЛИ РейсыМоре.ПунктНазначения.Тип = &ТипТерминал)
		|	И РейсыМоре.ДатаОтправления >= ДАТАВРЕМЯ(2024, 1, 1, 0, 0, 0)";
	
	Запрос.УстановитьПараметр("ТипПорт", Справочники.ТипыЛокаций.Порт);
	Запрос.УстановитьПараметр("ТипТерминал", Справочники.ТипыЛокаций.Терминал);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		РейсОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(РейсОбъект, Выборка);
		РейсОбъект.Записать();
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РейсыМоре.Ссылка КАК Ссылка,
		|	РейсыМоре.ПунктОтправления КАК ПунктОтправления,
		|	РейсыМоре.ПунктНазначения КАК ПунктНазначения,
		|	РейсыМоре.МестоПогрузки КАК МестоПогрузки,
		|	РейсыМоре.МестоРазгрузки КАК МестоРазгрузки,
		|	РейсыМоре.ДатаОтправления КАК ДатаОтправления,
		|	РейсыМоре.ДатаПрибытия КАК ДатаПрибытия
		|ИЗ
		|	Справочник.РейсыМоре КАК РейсыМоре
		|ГДЕ
		|	НЕ РейсыМоре.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	КоличествоЗаписей = 0;
	Пока Выборка.Следующий() Цикл
		ДобавитьОбновитьЗаписьДанныхМорскогоРейса(Выборка, КоличествоЗаписей);
