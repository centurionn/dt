Процедура ЗаполнитьСправочникиВидыЖДН() Экспорт
	
	//груженая ждн
	ссВидЖДН = Справочники.ВидыЖДН.ГруженаяЖДН;
	обВидЖДН = ссВидЖДН.ПолучитьОбъект();
	обВидЖДН.ИмяРеквизитаВСоставеПоезда = "ЖДН";
	обВидЖДН.ЕстьДопРазделениеКТКПорожний = Истина;
	обВидЖДН.ВсегдаДобавлятьУслугу = Ложь;
	обВидЖДН.ИсточникПоявленияСтрокиЭкономики = Перечисления.ИсточникПоявленияСтрокиЭкономики.ЖДН;
	обВидЖДН.СвязанныеУслуги.Очистить();
	нУслуга = обВидЖДН.СвязанныеУслуги.Добавить();
	нУслуга.Услуга = Справочники.Номенклатура.НайтиПоНаименованию("ГруженыйЖДтарифРФ", Истина);
	нУслуга = обВидЖДН.СвязанныеУслуги.Добавить();
	нУслуга.Услуга = Справочники.Номенклатура.НайтиПоНаименованию("ПорожнийТарифКонтейнерРФ", Истина);
	обВидЖДН.Записать();
	
	//Порожняя ЖДН (ваг)
	ссВидЖДН = Справочники.ВидыЖДН.ПорожняяЖДН_Ваг;
