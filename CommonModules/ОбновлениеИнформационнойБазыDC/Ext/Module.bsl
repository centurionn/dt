Процедура СоздатьШаблоныКлючейАналитикиСтрокКалькуляции() Экспорт 
	
	Константы.ОтвязыватьАкцептыОтОтключенныхСтрок.Установить(Истина);
	
	Ключ = Справочники.КлючиАналитикиСтрокКалькуляции.СоздатьЭлемент();
	Ключ.РазделКалькуляции = Перечисления.РазделыКалькуляции.КалькуляцияМультимодальнойЦепочки;
	Ключ.ИспользуетсяКакШаблон = Истина;
	КлючевыеПоля = Ключ.КлючевыеПоля;
	КлючевоеПоле = КлючевыеПоля.Добавить();
	КлючевоеПоле.ИмяПоля = "Услуга";
	КлючевоеПоле = КлючевыеПоля.Добавить();
	КлючевоеПоле.ИмяПоля = "ВнутренняяСебестоимость";
	КлючевоеПоле = КлючевыеПоля.Добавить();
	КлючевоеПоле.ИмяПоля = "ПунктОтправления.Родитель";
	КлючевоеПоле = КлючевыеПоля.Добавить();
	КлючевоеПоле.ИмяПоля = "ПунктНазначения.Родитель";
	КлючевоеПоле = КлючевыеПоля.Добавить();
	КлючевоеПоле.ИмяПоля = "ГруппаУслуг";
	КлючевоеПоле = КлючевыеПоля.Добавить();
	КлючевоеПоле.ИмяПоля = "ОсновнаяУслугаГруппы";
	КлючевоеПоле = КлючевыеПоля.Добавить();
	КлючевоеПоле.ИмяПоля = "ПодсылПорожних";
	КлючевоеПоле.ИмяПоляСделка = "Подсыл";
	Ключ.Записать();
	
	Ключ = Справочники.КлючиАналитикиСтрокКалькуляции.СоздатьЭлемент();
	Ключ.РазделКалькуляции = Перечисления.РазделыКалькуляции.КалькуляцияУслугВнеСтавки;
	Ключ.ИспользуетсяКакШаблон = Истина;
	КлючевыеПоля = Ключ.КлючевыеПоля;
	КлючевоеПоле = КлючевыеПоля.Добавить();
	КлючевоеПоле.ИмяПоля = "Услуга";
	Ключ.Записать();
КонецПроцедуры	

Процедура ЗаполнитьКлючиАналитикиВКалькуляциях() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Калькуляция.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Калькуляция КАК Калькуляция
	|ГДЕ
	|	(Калькуляция.ММ_КалькуляцияМультимодальнойЦепочки.КлючАналитикиСтрокиКалькуляции = &ПустойКлюч
	|			ИЛИ Калькуляция.ЖД_УслугиВнеСтавки.КлючАналитикиСтрокиКалькуляции = &ПустойКлюч)";
	Запрос.УстановитьПараметр("ПустойКлюч", Справочники.КлючиАналитикиСтрокКалькуляции.ПустаяСсылка());
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		обКалькуляция = Выборка.Ссылка.ПолучитьОбъект();
		обКалькуляция.ЗаполнитьКлючиАналитикиСтрокКалькуляции(Перечисления.РазделыКалькуляции.КалькуляцияМультимодальнойЦепочки);
		обКалькуляция.ЗаполнитьКлючиАналитикиСтрокКалькуляции(Перечисления.РазделыКалькуляции.КалькуляцияУслугВнеСтавки);
		Попытка
			обКалькуляция.ОбменДанными.Загрузка = Истина;
			обКалькуляция.Записать();
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

