Процедура СоздатьДопРеквизитГруппаОРК() Экспорт   

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НаборыДополнительныхРеквизитовИСведений.Ссылка КАК Ссылка


	|ИЗ
	|	Справочник.НаборыДополнительныхРеквизитовИСведений КАК НаборыДополнительныхРеквизитовИСведений
	|ГДЕ
	|	НаборыДополнительныхРеквизитовИСведений.Наименование = &Наименование
	|	И НЕ НаборыДополнительныхРеквизитовИСведений.Предопределенный"; 
	
	Запрос.УстановитьПараметр("Наименование", "Пользователи");

	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();       
		
		Пока Выборка.Следующий() Цикл
		
			ДопРеквизитОбъект = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.СоздатьЭлемент();
			ДопРеквизитОбъект.Заголовок = "Группа ОРК";
			ДопРеквизитОбъект.НаборСвойств = Выборка.Ссылка;
			ДопРеквизитОбъект.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.ЗначенияСвойствОбъектов");
			ДопРеквизитОбъект.Наименование = ДопРеквизитОбъект.Заголовок + " ("+ДопРеквизитОбъект.НаборСвойств+")";
			ДопРеквизитОбъект.Виден = Истина;
			ДопРеквизитОбъект.Доступен = Истина;
			ДопРеквизитОбъект.ДополнительныеЗначенияИспользуются = Истина;
			ДопРеквизитОбъект.Имя = "ГруппаОРК";
			ДопРеквизитОбъект.Записать();
			ДопРеквизитСсылка = ДопРеквизитОбъект.Ссылка;		
			
			НаборДополнительныхРеквизитовПользователи = Выборка.Ссылка.ПолучитьОбъект();
			Если НаборДополнительныхРеквизитовПользователи.ДополнительныеРеквизиты.Найти(ДопРеквизитСсылка, "Свойство") = Неопределено Тогда
				Стр = НаборДополнительныхРеквизитовПользователи.ДополнительныеРеквизиты.Добавить();
