Процедура ПеренестиДанныеСВВ() Экспорт
	
	Константы.МинимальнаяДлинаПоследнегоБлокаСимволовНомераТДТ.Установить(7);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	стоки_ТекущиеДанныеСрезПоследних.КТК КАК КТК,
		|	стоки_ТекущиеДанныеСрезПоследних.тек_СВВ КАК СВВ,
		|	стоки_ТекущиеДанныеСрезПоследних.тек_НомерТДТ КАК НомерТДТ,
		|	стоки_ТекущиеДанныеСрезПоследних.тек_КомментарийСВВ КАК КомментарийСВВ,
		|	стоки_ТекущиеДанныеСрезПоследних.тек_СправкаЦФТО КАК СправкаЦФТО,
		|	стоки_ТекущиеДанныеСрезПоследних.тек_РешениеТО КАК РешениеТО
		|ИЗ
		|	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних КАК стоки_ТекущиеДанныеСрезПоследних
		|ГДЕ
		|	(стоки_ТекущиеДанныеСрезПоследних.тек_СВВ <> ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ стоки_ТекущиеДанныеСрезПоследних.тек_НомерТДТ <> """"
		|			ИЛИ стоки_ТекущиеДанныеСрезПоследних.тек_КомментарийСВВ <> """"
		|			ИЛИ стоки_ТекущиеДанныеСрезПоследних.тек_СправкаЦФТО <> """"
		|			ИЛИ стоки_ТекущиеДанныеСрезПоследних.тек_РешениеТО <> """")";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		обКТК = ВыборкаДетальныеЗаписи.КТК.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(обКТК, ВыборкаДетальныеЗаписи);
		обКТК.Записать();
	КонецЦикла;
	
КонецПроцедуры
