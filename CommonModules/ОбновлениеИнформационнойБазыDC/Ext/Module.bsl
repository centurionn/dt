			или СтрНайти(Выборка.ТекстАвансовогоСчета, "##ПунктОтправленияКС") <> 0
			или СтрНайти(Выборка.ТекстАвансовогоСчета, "##ПунктНазначенияКС") <> 0 
			
			или СтрНайти(Выборка.ТекстРеализацииИИСФ, "##Пункт_ОтправленияКСENG") <> 0
			или СтрНайти(Выборка.ТекстРеализацииИИСФ, "##Пункт_НазначенияКСENG") <> 0
			или СтрНайти(Выборка.ТекстРеализацииИИСФ, "##ПунктОтправленияКС") <> 0
			или СтрНайти(Выборка.ТекстРеализацииИИСФ, "##ПунктНазначенияКС") <> 0
			
			или СтрНайти(Выборка.ТекстАвансовогоСчетаФрахт, "##Пункт_ОтправленияКСENG") <> 0
			или СтрНайти(Выборка.ТекстАвансовогоСчетаФрахт, "##Пункт_НазначенияКСENG") <> 0
			или СтрНайти(Выборка.ТекстАвансовогоСчетаФрахт, "##ПунктОтправленияКС") <> 0
			или СтрНайти(Выборка.ТекстАвансовогоСчетаФрахт, "##ПунктНазначенияКС") <> 0 
			
			или СтрНайти(Выборка.ТекстРеализацииИИСФФрахт, "##Пункт_ОтправленияКСENG") <> 0
			или СтрНайти(Выборка.ТекстРеализацииИИСФФрахт, "##Пункт_НазначенияКСENG") <> 0
			или СтрНайти(Выборка.ТекстРеализацииИИСФФрахт, "##ПунктОтправленияКС") <> 0
			или СтрНайти(Выборка.ТекстРеализацииИИСФФрахт, "##ПунктНазначенияКС") <> 0 Тогда    
			
