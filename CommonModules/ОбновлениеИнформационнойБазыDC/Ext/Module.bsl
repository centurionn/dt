Процедура ОбработатьКатегорииКонтрагентов() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КатегорииКонтрагентов.Период КАК Период,
		|	КатегорииКонтрагентов.Контрагент КАК Контрагент,
		|	КатегорииКонтрагентов.ТипКонтрагента КАК ТипКонтрагента,
		|	КатегорииКонтрагентов.УдалитьКатегорияФактическая КАК УдалитьКатегорияФактическая
		|ИЗ
		|	РегистрСведений.КатегорииКонтрагентов КАК КатегорииКонтрагентов
		|ГДЕ
		|	КатегорииКонтрагентов.ПлановаяФактическая = ЗНАЧЕНИЕ(Перечисление.ПланФакт.ПустаяСсылка)
		|	И КатегорииКонтрагентов.УдалитьКатегорияФактическая <> """"
		|	И КатегорииКонтрагентов.Категория = """"";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	НачатьТранзакцию();
		
	Пока Выборка.Следующий() Цикл		
		
		ЗаписьРегистра = РегистрыСведений.КатегорииКонтрагентов.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(ЗаписьРегистра, Выборка, "Период, Контрагент, ТипКонтрагента");
		ЗаписьРегистра.ПлановаяФактическая = Перечисления.ПланФакт.Факт;
		ЗаписьРегистра.Категория = Выборка.УдалитьКатегорияФактическая;
		ЗаписьРегистра.Записать();		
		
	КонецЦикла;
	
	СтарыеЗаписи = РегистрыСведений.КатегорииКонтрагентов.СоздатьНаборЗаписей();
	СтарыеЗаписи.Отбор.ПлановаяФактическая.Значение = Перечисления.ПланФакт.ПустаяСсылка();
	СтарыеЗаписи.Отбор.ПлановаяФактическая.Использование = Истина;
	СтарыеЗаписи.Записать();
	
	ЗафиксироватьТранзакцию();
	
