Процедура ЗаполнитьТипОтветственногоПДЗвРегистре() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КомментарииПользователейВОтчетеПДЗ.Договор КАК Договор,
		|	КомментарииПользователейВОтчетеПДЗ.ДатаКомментария КАК ДатаКомментария,
		|	КомментарииПользователейВОтчетеПДЗ.ТипОтветственногоПДЗ КАК ТипОтветственногоПДЗ
		|ИЗ
		|	РегистрСведений.КомментарииПользователейВОтчетеПДЗ КАК КомментарииПользователейВОтчетеПДЗ
		|ГДЕ
		|	КомментарииПользователейВОтчетеПДЗ.ТипОтветственногоПДЗ = ЗНАЧЕНИЕ(Перечисление.ТипыОтветственныхПДЗ.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаписьРегистра = РегистрыСведений.КомментарииПользователейВОтчетеПДЗ.СоздатьМенеджерЗаписи();
		ЗаписьРегистра.Договор = ВыборкаДетальныеЗаписи.Договор;
		ЗаписьРегистра.ДатаКомментария = ВыборкаДетальныеЗаписи.ДатаКомментария;
		ЗаписьРегистра.ТипОтветственногоПДЗ = ВыборкаДетальныеЗаписи.ТипОтветственногоПДЗ;
		ЗаписьРегистра.Прочитать();
		
		ЗаписьРегистра.ТипОтветственногоПДЗ = Перечисления.ТипыОтветственныхПДЗ.Менеджер;
		ЗаписьРегистра.Записать();
	КонецЦикла;
	
КонецПроцедуры
