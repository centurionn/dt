Процедура ЗаписатьДанныеВИсториюРазнесенияПоступлений() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Акцепт.Поступление КАК Поступление,
	|	Акцепт.Ссылка КАК Акцепт
	|ПОМЕСТИТЬ ВТАктуальныеАкцепты
	|ИЗ
	|	Документ.Акцепт КАК Акцепт
	|ГДЕ
	|	Акцепт.Проведен
	|	И Акцепт.СторнируемыйАкцепт = ЗНАЧЕНИЕ(Документ.Акцепт.ПустаяСсылка)
	|	И НЕ Акцепт.Ссылка В
	|				(ВЫБРАТЬ
	|					Акцепт.СторнируемыйАкцепт КАК СторнируемыйАкцепт
	|				ИЗ
	|					Документ.Акцепт КАК Акцепт
	|				ГДЕ
	|					Акцепт.Проведен)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДокАкцепт.Ссылка КАК Ссылка
	|ИЗ
	|	ВТАктуальныеАкцепты КАК ВТАктуальныеАкцепты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Акцепт КАК ДокАкцепт
	|		ПО ВТАктуальныеАкцепты.Акцепт = ДокАкцепт.Ссылка
	|			И (НЕ ДокАкцепт.Услуги.Сделка = ЗНАЧЕНИЕ(Документ.Сделка.ПустаяСсылка))";
	Запрос.УстановитьПараметр("", );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		обАкцепт = Выборка.Ссылка.ПолучитьОбъект();
		обАкцепт.ЗаписатьИсториюРазнесения();
	КонецЦикла;
	
