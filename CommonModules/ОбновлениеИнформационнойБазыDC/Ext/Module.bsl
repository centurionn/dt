Процедура СоздатьПредопределенныеЭлементыСправочникаСостоянияДляРелизаСобственника() Экспорт
	
	Группа_СлужебныеСостоянияРелизаСобственника = Справочники.Состояния.НайтиПоНаименованию("Служебные состояния релиза собственника");
	Если Не ЗначениеЗаполнено(Группа_СлужебныеСостоянияРелизаСобственника) Тогда
		СостояниеОбъект = Справочники.Состояния.СоздатьГруппу();
		СостояниеОбъект.Наименование = "Служебные состояния релиза собственника";
		СостояниеОбъект.ИмяПредопределенныхДанных = "СлужебныеСостоянияРелизаСобственника";
		СостояниеОбъект.ОбменДанными.Загрузка = Истина;
		СостояниеОбъект.Записать();
		Группа_СлужебныеСостоянияРелизаСобственника = СостояниеОбъект.Ссылка;
	ИначеЕсли Не Группа_СлужебныеСостоянияРелизаСобственника.ИмяПредопределенныхДанных = "СлужебныеСостоянияРелизаСобственника" Тогда
		СостояниеОбъект = Группа_СлужебныеСостоянияРелизаСобственника.ПолучитьОбъект();	
		СостояниеОбъект.ИмяПредопределенныхДанных = "СлужебныеСостоянияРелизаСобственника";
		СостояниеОбъект.ОбменДанными.Загрузка = Истина;
		СостояниеОбъект.Записать();
	КонецЕсли;
	
	КорректировкаКоличестваКТК = Справочники.Состояния.НайтиПоНаименованию("Корректировка количества КТК и связанных док-тов (при необходимости)");
	Если Не ЗначениеЗаполнено(КорректировкаКоличестваКТК) Тогда
		СостояниеОбъект = Справочники.Состояния.СоздатьЭлемент();
		СостояниеОбъект.ИмяПредопределенныхДанных = "КорректировкаКоличестваКТК";
		СостояниеОбъект.Родитель = Группа_СлужебныеСостоянияРелизаСобственника;
		СостояниеОбъект.Наименование = "Корректировка количества КТК и связанных док-тов (при необходимости)";
		СостояниеОбъект.Процессное = Истина;
		//СостояниеОбъект.Согласование = Истина;
		//СостояниеОбъект.ВариантПерезапуска = Перечисления.ВариантыПерезапускаЗадачи.ВсегдаПерезапускать;
		СостояниеОбъект.ОбменДанными.Загрузка = Истина;
		СостояниеОбъект.Записать();
	ИначеЕсли Не КорректировкаКоличестваКТК.ИмяПредопределенныхДанных = "КорректировкаКоличестваКТК" Тогда
			СостояниеОбъект = КорректировкаКоличестваКТК.ПолучитьОбъект();
			СостояниеОбъект.ИмяПредопределенныхДанных = "КорректировкаКоличестваКТК";
			СостояниеОбъект.Родитель = Группа_СлужебныеСостоянияРелизаСобственника;
			СостояниеОбъект.ОбменДанными.Загрузка = Истина;
			СостояниеОбъект.Записать();
	КонецЕсли;
	
	КорректировкаТипоразмераКТК = Справочники.Состояния.НайтиПоНаименованию("Корректировка типоразмера КТК");
	Если Не ЗначениеЗаполнено(КорректировкаТипоразмераКТК) Тогда
		СостояниеОбъект = Справочники.Состояния.СоздатьЭлемент();
		СостояниеОбъект.ИмяПредопределенныхДанных = "КорректировкаТипоразмераКТК";
		СостояниеОбъект.Родитель = Группа_СлужебныеСостоянияРелизаСобственника;
		СостояниеОбъект.Наименование = "Корректировка типоразмера КТК";
		СостояниеОбъект.Процессное = Истина;
		//СостояниеОбъект.Согласование = Истина;
		//СостояниеОбъект.ВариантПерезапуска = Перечисления.ВариантыПерезапускаЗадачи.ВсегдаПерезапускать;
		СостояниеОбъект.ОбменДанными.Загрузка = Истина;
		СостояниеОбъект.Записать();
	ИначеЕсли Не КорректировкаТипоразмераКТК.ИмяПредопределенныхДанных = "КорректировкаТипоразмераКТК" Тогда
			СостояниеОбъект = КорректировкаТипоразмераКТК.ПолучитьОбъект();
			СостояниеОбъект.ИмяПредопределенныхДанных = "КорректировкаТипоразмераКТК";
			СостояниеОбъект.Родитель = Группа_СлужебныеСостоянияРелизаСобственника;
			СостояниеОбъект.ОбменДанными.Загрузка = Истина;
			СостояниеОбъект.Записать();
	КонецЕсли;
		
КонецПроцедуры
// -- ДИТ_Агафонов_task 50388 08.07.2022

#КонецОбласти

