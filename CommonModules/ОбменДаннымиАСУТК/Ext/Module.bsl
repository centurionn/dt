	               |	ФактОтпрСостЗаявки.ИндексПоезда КАК ИндексПоезда,
	               |	ФактОтпрСостЗаявки.ВыгруженоВАСУТК КАК ВыгруженоВАСУТК,
	               |	ФактОтпрСостЗаявки.Контейнер КАК Контейнер,
	               |	ФактОтпрСостЗаявки.ЗаявкаРегистратор КАК ЗаявкаРегистратор,
	               |	ФактОтпрСостЗаявки.Сделка КАК Сделка,
	               |	ФактОтпрСостЗаявки.ПлановаяДатаПрибытия КАК ПлановаяДатаПрибытия,
	               |	ФактОтпрСостЗаявки.НомерКонтейнера КАК НомерКонтейнера,
	               |	ФактОтпрСостЗаявки.ТипоРазмер КАК ТипоРазмер,
	               |	ФактОтпрСостЗаявки.РазмерКТК КАК РазмерКТК,
	               |	ФактОтпрСостЗаявки.Груженый КАК Груженый,
	               |	ФактОтпрСостЗаявки.ГрузЕТСНГ КАК ГрузЕТСНГ,
	               |	ПРЕДСТАВЛЕНИЕ(ФактОтпрСостЗаявки.Клиент) КАК Клиент,
	               |	ПРЕДСТАВЛЕНИЕ(ФактОтпрСостЗаявки.Договор) КАК Договор,
	               |	ФактОтпрСостЗаявки.СтанцияОтправленияКод КАК СтанцияОтправленияКод,
	               |	ФактОтпрСостЗаявки.СтанцияНазначения КАК СтанцияНазначения,
	               |	ФактОтпрСостЗаявки.СтанцияНазначенияКод КАК СтанцияНазначенияКод,
	               |	ФактОтпрСостЗаявки.ОсобыеОтметки КАК ОсобыеОтметки,
	               |	ФактОтпрСостЗаявки.ИнструкцииПоСдачеПорожнего КАК ИнструкцииПоСдачеПорожнего,
	               |	ФактОтпрСостЗаявки.ФИОВодителяВыгрузка КАК ФИОВодителяВыгрузка,
	               |	ФактОтпрСостЗаявки.НомерАвтоВыгрузка КАК НомерАвтоВыгрузка,
	               |	ФактОтпрСостЗаявки.УИД_Клиента КАК УИД_Клиента,
	               |	ФактОтпрСостЗаявки.УИД_Договора КАК УИД_Договора,
	               |	ЕСТЬNULL(ПодрОГрузе.КоличествоМест, 0) КАК КоличествоМест,
	               |	ЕСТЬNULL(ПодрОГрузе.ВесГруза, 0) КАК ВесГруза,
	               |	ЕСТЬNULL(ВернутьВСток.ПослеРастаркиВернуть_в_СтокЕС, ЛОЖЬ) КАК ПослеРастаркиВернуть_в_СтокЕС,
	               |	ФактОтпрСостЗаявки.ВладелецКТК КАК ВладелецКТК_ИНН,
	               |	ФактОтпрСостЗаявки.ВладелецКТК_ДоОбр КАК ВладелецКТК_ДоОбр,
	               |	ФактОтпрСостЗаявки.РейсЖДПродукт.Наименование КАК РейсЖДПродукт,
	               |	ФактОтпрСостЗаявки.СделкаНомер КАК СделкаНомер,
	               |	ФактОтпрСостЗаявки.КлиентКод КАК КлиентКод,
	               |	ФактОтпрСостЗаявки.ДоговорКод КАК ДоговорКод,
	               |	ФактОтпрСостЗаявки.Авто_АдресПогрузки КАК Авто_АдресПогрузки,
	               |	ФактОтпрСостЗаявки.Авто_АдресВыгрузки КАК Авто_АдресВыгрузки,
	               |	ФактОтпрСостЗаявки.Авто_АдресВыгрузки.Адрес КАК Авто_АдресВыгрузкиАдрес
	               |ИЗ
	               |	ФактОтпрСостЗаявки КАК ФактОтпрСостЗаявки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПодрОГрузе КАК ПодрОГрузе
	               |		ПО ФактОтпрСостЗаявки.ГУИДСтроки = ПодрОГрузе.ГУИДСтроки
	               |			И ФактОтпрСостЗаявки.ЗаявкаРегистратор = ПодрОГрузе.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПоискTerminalka КАК ПоискTerminalka
	               |		ПО ФактОтпрСостЗаявки.Калькуляция = ПоискTerminalka.Калькуляция
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВернутьВСток КАК ВернутьВСток
	               |		ПО ФактОтпрСостЗаявки.Сделка = ВернутьВСток.Сделка
	               |			И ФактОтпрСостЗаявки.Контейнер = ВернутьВСток.ТЕ
	               |ИТОГИ
	               |	МАКСИМУМ(РейсЖДПродукт)
	               |ПО
	               |	СделкаНомер";
	                          
	Запрос.УстановитьПараметр("РейсыЖД", ЖДРейсы);
	Запрос.УстановитьПараметр("ИспВАСУТК", ИспВАСУТК);
	Запрос.УстановитьПараметр("ИмяИняВосточная", "Иня-Восточная");
	
	// Резы = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	Резы = Запрос.ВыполнитьПакет();
	
	ТЗВладелельцы = Резы[9].Выгрузить();
	ТЗВладелельцы.Индексы.Добавить("ВладелецКТК");
	ВыборкаСделка = Резы[10].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	//Дата отправления
	//Станция отправления (код)
	//Плановая дата прибытия
	//Станция назначения (код)
	//НомерКТК
	//ТипоразмерКТК
	//РазмерКТК
	//ВладелецКТК (ИНН/КПП)
	//Груженый
	//Груз ЕТСНГ
	//Вес
	//КолвоМест
	//ТерминалкаПоПрибытию
	//ОсобыеОтметки
	//ИнструкцииПоСдаче
	//Клиент
	//ГУИД Клиента БФ
	//Договор
	//ГУИД Договора БФ
	//Водитель авто выгрузки
	//Номер Авто выгрузки
	//ПРИЗНАК - после растарки вернуть в сток ЕС
	
	МасФиксацОтправок = Новый Массив;
	
	Если ВыборкаСделка.Количество() > 0 Тогда
	
		edc = "urn:DC:to:ASUTK";
		ListOfDeals_Type = ФабрикаXDTO.Тип(edc, "ListOfDeals");
		Deal_Type = ФабрикаXDTO.Тип(edc, "Deal");
		ListContainers_Type = ФабрикаXDTO.Тип(edc, "ListContainers");
		Obj_Type 			= ФабрикаXDTO.Тип(edc, "Obj");
		
		ListOfDeals = ФабрикаXDTO.Create(ListOfDeals_Type);
		
		ПапкаОбменаDC_TO_ASUTK = Константы.ПапкаОбменаDC_TO_ASUTK.Получить();
		Если Прав(ПапкаОбменаDC_TO_ASUTK, 1) <> "\" Тогда
		
			ПапкаОбменаDC_TO_ASUTK = ПапкаОбменаDC_TO_ASUTK + "\";
		
		КонецЕсли; 
		
		ЗаписьXML = Новый ЗаписьXML;
		ИмяФайла = "DCtoASUTK_" + Формат(ТекущаяДата(), "ДФ=yyyy_MM_dd_HH_mm_ss")+".xml";
		ПолноеИмяФайла = ПапкаОбменаDC_TO_ASUTK + ИмяФайла;
		//Сообщить("Записываю в : " + ИмяФайла);
		ЗаписьXML.ОткрытьФайл(ПолноеИмяФайла);
		
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		
		Пока ВыборкаСделка.Следующий() Цикл
			
			Deal = ФабрикаXDTO.Create(Deal_Type);
			Deal.NumberDeal		= ВыборкаСделка.СделкаНомер;
			Deal.NameProduct 	= ВыборкаСделка.РейсЖДПродукт;
			
			ListContainers = ФабрикаXDTO.Create(ListContainers_Type);
			Deal.ListContainers = ListContainers;
			
			ЗафиксироватьОтправку = Истина;
			
			Выборка = ВыборкаСделка.Выбрать();
			
			Пока Выборка.Следующий() Цикл
			
				Obj = ФабрикаXDTO.Create(Obj_Type);
				
				Obj.DepartureDate		= Выборка.ФактическоеНачало;
				Obj.StationDeparture	= ?(Выборка.СтанцияОтправленияКод=NULL, "", Выборка.СтанцияОтправленияКод);
				Obj.PlannedArrivalDate	= Выборка.ПлановаяДатаПрибытия;
				Obj.StationDestination	= ?(Выборка.СтанцияНазначенияКод=NULL, "", Выборка.СтанцияНазначенияКод);
				Obj.NumberContainer		= ?(Выборка.НомерКонтейнера=NULL, "", Выборка.НомерКонтейнера);
				Obj.TypeSize			= ?(Выборка.ТипоРазмер=NULL, "", Выборка.ТипоРазмер);
				Obj.Size				= ?(Выборка.РазмерКТК=NULL, "", Выборка.РазмерКТК);
				ИскМасВлад = ТЗВладелельцы.НайтиСтроки(Новый Структура("ВладелецКТК", Выборка.ВладелецКТК_ДоОбр) );
				СтрВладелец = "";
				Для каждого ТекСтрВл Из ИскМасВлад Цикл
					СтрВладелец = СтрВладелец + ?(СтрВладелец="", "", ";") + ТекСтрВл.СинонимКонтрагента;
				КонецЦикла; 
				Obj.Owner				= "" + ?(Выборка.ВладелецКТК_ИНН="/", "", Выборка.ВладелецКТК_ИНН) + ?(Выборка.ВладелецКТК_ИНН="/", "", ";") + СтрВладелец;
				Obj.loaded				= ?(Выборка.Груженый=NULL, "", Выборка.Груженый);
				Obj.CargoETSNG			= ?(Выборка.ГрузЕТСНГ=NULL, "", Выборка.ГрузЕТСНГ);
				Obj.Weight				= ?(Выборка.ВесГруза=NULL, "", Выборка.ВесГруза);
				Obj.QuantityOfPlaces	= ?(Выборка.КоличествоМест=NULL, "", Выборка.КоличествоМест);
				Obj.Terminalka          = Выборка.TerminalkaASUTKtoDC;
				Obj.SpecialMarks		= ?(Выборка.ОсобыеОтметки=NULL, "", СтрЗаменить(Выборка.ОсобыеОтметки, Символы.ПС, " ") );
				Obj.InstructionsForSubmission = ?(Выборка.ИнструкцииПоСдачеПорожнего=NULL, "", СтрЗаменить(Выборка.ИнструкцииПоСдачеПорожнего, Символы.ПС, " ") );
				Obj.Client				= ?(Выборка.Клиент=NULL, "", Выборка.Клиент);
				Obj.UID_Client          = ?(Выборка.УИД_Клиента=NULL, "", Выборка.УИД_Клиента);
				Obj.COD_Client          = ?(Выборка.КлиентКод=NULL, "", Выборка.КлиентКод);
				Obj.Contract			= ?(Выборка.Договор=NULL, "", Выборка.Договор);
				Obj.UID_Contract        = ?(Выборка.УИД_Договора=NULL, "", Выборка.УИД_Договора);
				Obj.COD_Contract        = ?(Выборка.ДоговорКод=NULL, "", Выборка.ДоговорКод);
				Obj.DriverCarUnloading	= ?(Выборка.ФИОВодителяВыгрузка=NULL, "", Выборка.ФИОВодителяВыгрузка);
				Obj.NumberCarsUnloading = ?(Выборка.НомерАвтоВыгрузка=NULL, "", Выборка.НомерАвтоВыгрузка);
				Obj.AfterStrippingBackToStoke = Выборка.ПослеРастаркиВернуть_в_СтокЕС;
				Obj.AddressDischarge	= ?(Выборка.Авто_АдресВыгрузкиАдрес=NULL, "", Выборка.Авто_АдресВыгрузкиАдрес);
				
				ListContainers.Object.Добавить(Obj);
				
				Если ЗафиксироватьОтправку Тогда
					
					МЗ = РегистрыСведений.ОтметкаФактНачалаРейсов.СоздатьМенеджерЗаписи();
					ЗаполнитьЗначенияСвойств(МЗ, Выборка);
					МЗ.ВыгруженоВАСУТК = Истина;
					
					МасФиксацОтправок.Добавить(МЗ);
					
					ЗафиксироватьОтправку = Ложь;
					
				КонецЕсли; 
				
			КонецЦикла; 
			
			ListOfDeals.Deal.Добавить(Deal);
			
		КонецЦикла; 
		
		Попытка
		
			ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ListOfDeals, "ListOfDeals");
			
			Для каждого Стр Из МасФиксацОтправок Цикл
			
				Стр.Записать();
			
			КонецЦикла; 
			
		Исключение
			ОпОш = ОписаниеОшибки();
			Описание = ОпОш;
		КонецПопытки; 
		
		ЗаписьXML.Закрыть();
	
	КонецЕсли; 
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры 

Процедура ФактОтправкиЖД_АСУТК() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Описание = "";
	ЖДРейсы = Новый Массив;
	// Собираем проверяемые ЖД рейсы за 15 последних суток
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Локации.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ ЛокацИня
	               |ИЗ
	               |	Справочник.Локации КАК Локации
	               |ГДЕ
	               |	Локации.Тип = ЗНАЧЕНИЕ(Справочник.ТипыЛокаций.СтанцияЖД)
	               |	И Локации.Наименование = &ИмяИняВосточная
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	АналогиЛокаций.Аналог КАК Локация
	               |ПОМЕСТИТЬ ПроверЛокации
	               |ИЗ
	               |	ЛокацИня КАК ЛокацИня
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналогиЛокаций КАК АналогиЛокаций
	               |		ПО ЛокацИня.Ссылка = АналогиЛокаций.Локация
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЛокацИня.Ссылка
	               |ИЗ
	               |	ЛокацИня КАК ЛокацИня
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОтметкаФактНачалаРейсов.РейсЖД КАК РейсЖД,
	               |	МИНИМУМ(ОтметкаФактНачалаРейсов.ФактическоеНачало) КАК ФактическоеНачало,
	               |	ОтметкаФактНачалаРейсов.ИндексПоезда КАК ИндексПоезда,
	               |	МИНИМУМ(ОтметкаФактНачалаРейсов.ВыгруженоВАСУТК) КАК ВыгруженоВАСУТК
	               |ПОМЕСТИТЬ ОтправленныеРейсыЗаПериод
	               |ИЗ
	               |	РегистрСведений.ОтметкаФактНачалаРейсов КАК ОтметкаФактНачалаРейсов
	               |ГДЕ
	               |	ОтметкаФактНачалаРейсов.ФактическоеНачало МЕЖДУ &ДатаНач И &ДатаОк
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОтметкаФактНачалаРейсов.РейсЖД,
	               |	ОтметкаФактНачалаРейсов.ИндексПоезда
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОтправленныеРейсыЗаПериод.РейсЖД КАК РейсЖД,
	               |	ОтправленныеРейсыЗаПериод.ФактическоеНачало КАК ФактическоеНачало,
	               |	ОтправленныеРейсыЗаПериод.ИндексПоезда КАК ИндексПоезда,
	               |	ОтправленныеРейсыЗаПериод.ВыгруженоВАСУТК КАК ВыгруженоВАСУТК
	               |ИЗ
	               |	ОтправленныеРейсыЗаПериод КАК ОтправленныеРейсыЗаПериод
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПроверЛокации КАК ПроверЛокации
	               |		ПО ОтправленныеРейсыЗаПериод.РейсЖД.ПунктНазначения = ПроверЛокации.Локация";
	
	Запрос.УстановитьПараметр("ДатаНач", ТекущаяДата()-15*24*3600);
	Запрос.УстановитьПараметр("ДатаОк", ТекущаяДата());
	Запрос.УстановитьПараметр("ИмяИняВосточная", "Иня-Восточная");
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
	
		ЖДРейсы.Добавить( Выборка.РейсЖД );
	
	КонецЦикла;
	
	АСУТК_ПроверитьФактОтправленияПоездов(ЖДРейсы, , Описание);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Описание <> "" Тогда
	
		ВызватьИсключение Описание;
	
	КонецЕсли; 
	
КонецПроцедуры
 
