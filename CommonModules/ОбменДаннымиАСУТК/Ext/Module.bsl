
Процедура ОбменДаннымиАСУТК(УдалитьФайлПослеЗагрузки=Истина, ВсегоЗагружено=0) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПапкаОбменаASUTK_TO_DC = СокрЛП(Константы.ПапкаОбменаASUTK_TO_DC.Получить());
	ПапкаОбменаDC_TO_ASUTK = СокрЛП(Константы.ПапкаОбменаDC_TO_ASUTK.Получить());
	
	Если Прав(ПапкаОбменаDC_TO_ASUTK, 1) <> "\" Тогда
	
		ПапкаОбменаDC_TO_ASUTK = ПапкаОбменаDC_TO_ASUTK + "\";
	
	КонецЕсли; 
	
	ИскМасФайлов = НайтиФайлы(ПапкаОбменаASUTK_TO_DC, "*.xml");
	
	ОпОш = "";
	
	ВсегоЗагружено = 0;
	
	// Евросиб Фролов (26.10.2021 Ticket№ 41408
	МассивСозданныхКТК = Новый Массив;
	// Евросиб Фролов)
		
	Для каждого ТекФайл Из ИскМасФайлов Цикл
			
		ОшибкаЗагрузки = Ложь;
		МасДанных = Новый Массив;
		МасКонтр = Новый Массив; 
		ОбщКол = 0;
		Терминал = ""; // Если значение не заполнено, то 
		
		ЧтениеФайл = Новый ЧтениеТекста(ТекФайл.ПолноеИмя);
		
		Этоxml = Ложь;
		ПерваяСтрочкаВерная = Истина;
		
		НомСтр = 0;
		ТекСтр = ЧтениеФайл.ПрочитатьСтроку();
		Пока ТекСтр <> Неопределено Цикл
			
			Если НомСтр > ОбщКол Тогда // аварийный выход
			
				Прервать;
			
			КонецЕсли;
			
			Если Лев(ТекСтр, 19) = "<?xml version=""1.0""" Тогда
				
				Этоxml = Истина;
				ПерваяСтрочкаВерная = Истина;
				ТекСтр = ЧтениеФайл.ПрочитатьСтроку();
				Продолжить;
				
			Иначе
				
				Если НЕ Этоxml Тогда
					
					ПерваяСтрочкаВерная = Ложь;
					Прервать;
				
				КонецЕсли; 
				
			КонецЕсли; 
			
			Если Лев(ТекСтр, 11) = "<Количество" Тогда // Число КТ
				
				ТекСтр = СтрЗаменить(ТекСтр, "<Количество", "");
				ТекСтр = СтрЗаменить(ТекСтр, "Количество=""", "");
				ТекСтр = СтрЗаменить(ТекСтр, """ Терминал=""", Символы.ПС);
				ТекСтр = СтрЗаменить(ТекСтр, """/>", "");
				
				Зн1 = СтрПолучитьСтроку(ТекСтр, 1);
				Зн2 = СтрПолучитьСтроку(ТекСтр, 2);
				
				ОпЗн = Новый ОписаниеТипов("Число");
				ОбщКол = ОпЗн.ПривестиЗначение( СокрЛП(Зн1) );
				Терминал = Зн2;
				
				ТекСтр = ЧтениеФайл.ПрочитатьСтроку();
				Продолжить;
				
			Иначе
				
				ОпЗнДата = Новый ОписаниеТипов("Дата");
				
				РезЧтенияКТ = Новый Структура;
				// Это КТ: <CAXU8231756 Типоразмер="HC" Размер="40" ДатаСдачи="22.08.2020 9:42:21" СВВ="12.10.2020 0:00:00" Собственник="АДЛ МСК "/> 
				ТекСтр = СтрЗаменить(ТекСтр, "Типоразмер", Символы.ПС+"Типоразмер");
				ТекСтр = СтрЗаменить(ТекСтр, "Размер", Символы.ПС+"Размер");
				ТекСтр = СтрЗаменить(ТекСтр, "ДатаСдачи", Символы.ПС+"ДатаСдачи");
				ТекСтр = СтрЗаменить(ТекСтр, "СВВ", Символы.ПС+"СВВ");
				ТекСтр = СтрЗаменить(ТекСтр, "Собственник", Символы.ПС+"Собственник");
				
				Для Сч = 1 По СтрЧислоСтрок(ТекСтр) Цикл
				
					ТекСтрКТ = СокрЛП(СтрПолучитьСтроку(ТекСтр, Сч));
					
					Если Лев(ТекСтрКТ, 10) = "Типоразмер" Тогда
					
						Типоразмер = СтрЗаменить(ТекСтрКТ, "Типоразмер=", "");
						Типоразмер = СтрЗаменить(Типоразмер, """", "");
						РезЧтенияКТ.Вставить("Типоразмер", Типоразмер);
						Продолжить;
					
					КонецЕсли; 
					
					Если Лев(ТекСтрКТ, 6) = "Размер" Тогда
					
						Размер = СтрЗаменить(ТекСтрКТ, "Размер=", "");
						Размер = СтрЗаменить(Размер, """", "");
						РезЧтенияКТ.Вставить("Размер", Размер);
						Продолжить;
					
					КонецЕсли;
					
					Если Лев(ТекСтрКТ, 9) = "ДатаСдачи" Тогда
					    
						ДатаСдачи = СтрЗаменить(ТекСтрКТ, "ДатаСдачи=", "");
						ДатаСдачи = СтрЗаменить(ДатаСдачи, """", "");
						РезЧтенияКТ.Вставить("ДатаСдачи", ОпЗнДата.ПривестиЗначение(ДатаСдачи) );
						Продолжить;
					
					КонецЕсли;
					
					Если Лев(ТекСтрКТ, 3) = "СВВ" Тогда
					
						СВВ = СтрЗаменить(ТекСтрКТ, "СВВ=", "");
						СВВ = СтрЗаменить(СВВ, """", "");
						РезЧтенияКТ.Вставить("СВВ", ОпЗнДата.ПривестиЗначение(СВВ) );
						Продолжить;
					
					КонецЕсли;
					
					Если Лев(ТекСтрКТ, 11) = "Собственник" Тогда
						
						Собственник = СтрЗаменить(ТекСтрКТ, "Собственник=", "");
						Собственник = СтрЗаменить(Собственник, """", "");
						Собственник = СтрЗаменить(Собственник, "/", "");
						Собственник = СтрЗаменить(Собственник, ">", "");
						РезЧтенияКТ.Вставить("Собственник", СокрЛП(Собственник));
						МасКонтр.Добавить(СокрЛП(Собственник));
						Продолжить;
					
					КонецЕсли;
					
					// Это номер КТ:
					КТ = Сред(ТекСтрКТ, 2);
					РезЧтенияКТ.Вставить("Контейнер", КТ);
					
				КонецЦикла; 
				
				МасДанных.Добавить( РезЧтенияКТ );
				
				ТекСтр = ЧтениеФайл.ПрочитатьСтроку();
				НомСтр = НомСтр + 1;
				Продолжить;
				
			КонецЕсли; 
			
		КонецЦикла; 
		
		ЧтениеФайл.Закрыть();
		
		Если МасДанных.Количество() > 0 Тогда
			
			Терминал = ВРег(СокрЛП(Терминал));
			
			Если Терминал = "NOV" Тогда
			    ИспСиноним = Истина;
			ИначеЕсли Терминал = "MSK" Тогда
			    ИспСиноним = Истина;
			Иначе
				ИспСиноним = Ложь;
			КонецЕсли; 
			
			Сток = Неопределено;
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	Локации.Ссылка КАК Ссылка
			               |ПОМЕСТИТЬ Выб_Сток
			               |ИЗ
			               |	Справочник.Локации КАК Локации
			               |ГДЕ
			               |	НЕ &ИспСиноним
			               |	И Локации.Наименование = &Наименование
			               |	И Локации.Тип = ЗНАЧЕНИЕ(Справочник.ТипыЛокаций.Сток)
			               |
			               |ОБЪЕДИНИТЬ ВСЕ
			               |
			               |ВЫБРАТЬ
			               |	ЛокацииТаблицаСинонимов.Ссылка
			               |ИЗ
			               |	Справочник.Локации.ТаблицаСинонимов КАК ЛокацииТаблицаСинонимов
			               |ГДЕ
			               |	&ИспСиноним
			               |	И ЛокацииТаблицаСинонимов.СинонимЛокации = &СинонимЛокации
			               |	И ЛокацииТаблицаСинонимов.Ссылка.Тип = ЗНАЧЕНИЕ(Справочник.ТипыЛокаций.Сток)
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	Выб_Сток.Ссылка КАК Ссылка
			               |ИЗ
			               |	Выб_Сток КАК Выб_Сток
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ ПЕРВЫЕ 1
			               |	СтокКонтейнеров.Ссылка КАК Ссылка
			               |ИЗ
			               |	Документ.СтокКонтейнеров КАК СтокКонтейнеров
			               |ГДЕ
			               |	СтокКонтейнеров.Сток В
			               |			(ВЫБРАТЬ
			               |				Выб_Сток.Ссылка КАК Ссылка
			               |			ИЗ
			               |				Выб_Сток КАК Выб_Сток)
			               |
			               |УПОРЯДОЧИТЬ ПО
			               |	СтокКонтейнеров.Дата УБЫВ
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	ТипоразмерыТЕ.Код КАК Код,
			               |	ТипоразмерыТЕ.Наименование КАК Наименование,
			               |	ТипоразмерыТЕ.РазмерКТК КАК РазмерКТК,
			               |	ТипоразмерыТЕ.Ссылка КАК Ссылка,
			               |	ТипоразмерыТЕ.КодISO КАК КодISO
			               |ИЗ
			               |	Справочник.ТипоразмерыТЕ КАК ТипоразмерыТЕ
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	КонтрагентыСинонимыДляПоиска.Ссылка КАК Ссылка,
			               |	КонтрагентыСинонимыДляПоиска.СинонимКонтрагента КАК СинонимКонтрагента
			               |ИЗ
			               |	Справочник.Контрагенты.СинонимыДляПоиска КАК КонтрагентыСинонимыДляПоиска
			               |ГДЕ
			               |	КонтрагентыСинонимыДляПоиска.СинонимКонтрагента В(&МасКонтр)";
			                         
			Запрос.УстановитьПараметр("ИспСиноним", ИспСиноним);
			Запрос.УстановитьПараметр("СинонимЛокации", Терминал);
			Запрос.УстановитьПараметр("Наименование", "Евросиб");
			Запрос.УстановитьПараметр("Сток", Сток);
			Запрос.УстановитьПараметр("МасКонтр", МасКонтр);
			
			Резы = Запрос.ВыполнитьПакет();
			ТипыТЕ = Резы[3].Выгрузить();
			ТЗ_Контрагенты = Резы[4].Выгрузить();
			
			Выборка = Резы[1].Выбрать();
			
			Пока Выборка.Следующий() Цикл
			
				Сток = Выборка.Ссылка;
			
			КонецЦикла;
			
			Если Сток = Неопределено Тогда
				
				ВызватьИсключение "Сток " + "Евросиб" + " не найден!";
				
			КонецЕсли; 
			
			//ДокОб = Документы.СтокКонтейнеров.СоздатьДокумент();
			//ДокОб.Дата = ТекущаяДата();
			//ДокОб.Заполнить("");
			//ДокОб.Сток = Сток;
			
			//ТЗ = Резы[2].Выгрузить();
			//Если ТЗ.Количество()>0 Тогда
			//	СсылкаНаДок = ТЗ[0].Ссылка;
			//	ДокОб.Контейнеры.Загрузить(СсылкаНаДок.Контейнеры.Выгрузить());
			//КонецЕсли;
			
			Для каждого СтрДан Из МасДанных Цикл
				
				Тип = Неопределено;
				ИскТип = ТипыТЕ.НайтиСтроки(Новый Структура("Наименование", ""+СтрДан.Размер+СтрДан.ТипоРазмер) );
				
				Если ИскТип.Количество() > 0 Тогда
				
					Тип = ИскТип[0].Ссылка;
				Иначе
					ОпОш = ОпОш + "Тип " + ""+СтрДан.Размер+СтрДан.ТипоРазмер + " не найден!";
					ОшибкаЗагрузки = Истина;
					Прервать;
				КонецЕсли; 
				
				КТК = РаботаСКонтейнерамиСервер.СоздатьКТК(СтрДан.Контейнер, Тип);
								
				Если КТК = Неопределено Тогда
					ОпОш = ОпОш + "Контейнер " + СтрДан.Контейнер + " не найден!";
					ОшибкаЗагрузки = Истина;
					Прервать;
				Иначе
					// Евросиб Фролов (26.10.2021 Ticket№ 41408
					МассивСозданныхКТК.Добавить(КТК);
					// Евросиб Фролов)
				КонецЕсли; 
				
				Если ЗначениеЗаполнено(КТК) И Не ЗначениеЗаполнено(КТК.ТипТЕ) Тогда
				
					об = КТК.ПолучитьОбъект();
					об.ТипТЕ = Тип;
					об.Записать();
				
				КонецЕсли; 
				
				Контр = Неопределено;
				ИскКонтр = ТЗ_Контрагенты.НайтиСтроки(Новый Структура("СинонимКонтрагента", СтрДан.Собственник) );
				Если ИскКонтр.Количество() > 0 Тогда
					Контр = ИскКонтр[0].Ссылка;
				Иначе
					ОпОш = ОпОш + "Контрагент " + СтрДан.Собственник + " не найден!";
					//ОшибкаЗагрузки = Истина;
					//Прервать;
				КонецЕсли; 
				
				//Если ДокОб.Контейнеры.НайтиСтроки(Новый Структура("Контейнер", КТК) ).Количество() = 0 Тогда
				//
				//	НовСтрТЧ = ДокОб.Контейнеры.Добавить();
				//	НовСтрТЧ.Контейнер = КТК;
				//	НовСтрТЧ.ТипКонтейнера = Тип;
				//	НовСтрТЧ.КоличествоБНКонтейнеров = 1;
				//	НовСтрТЧ.Контрагент = Контр;
				//	НовСтрТЧ.Статус = Перечисления.СтатусыКТК.Свободен;
				//	Если СтрДан.Свойство("СВВ") Тогда
				//		НовСтрТЧ.СВВ = СтрДан.СВВ;
				//	КонецЕсли;
				//	НовСтрТЧ.ДатаПриемаВСток = СтрДан.ДатаСдачи;
				//
				//КонецЕсли; 
				
				// SIV 26-10-2020 добавлю обновление данных КТК в АРМ КТК
				Если Константы.ИспользоватьАРМКТК.Получить() = Истина Тогда
					МассивИзмЗначений = Новый Соответствие;
					МассивИзмЗначений.Вставить("тек_ВЭксплуатации", Истина);
					Если ЗначениеЗаполнено(Контр) Тогда
						МассивИзмЗначений.Вставить("тек_Собственник", Контр);
					КонецЕсли;
					МассивИзмЗначений.Вставить("тек_Статус", Перечисления.СтатусыКТК.Свободен);
					Если СтрДан.Свойство("СВВ") Тогда
						МассивИзмЗначений.Вставить("тек_СВВ", СтрДан.СВВ);
					КонецЕсли;
					МассивИзмЗначений.Вставить("тек_ДатаПриемаВСток", СтрДан.ДатаСдачи);
					МассивИзмЗначений.Вставить("тек_Сток", Сток);
					
					Если МассивИзмЗначений.Количество() > 0 Тогда
						МассивИзмЗначений.Вставить("ИсточникЗаписи", "Добавлено из загрузки АСУТК " + ТекущаяДата());
						РегистрыСведений.стоки_ТекущиеДанные.ДобавитьЗапись(КТК, МассивИзмЗначений);
					КонецЕсли;
				КонецЕсли;
				
				ВсегоЗагружено = ВсегоЗагружено + 1;
				        
			КонецЦикла; 
			
			Если НЕ ОшибкаЗагрузки Тогда
			
				Попытка
					опОшДок = "";
					//ДокОб.Записать(РежимЗаписиДокумента.Проведение);
				Исключение
					опОшДок = ОписаниеОшибки();
					ОпОш = ОпОш + Символы.ПС + опОшДок;
				КонецПопытки; 
				
				Если опОшДок = "" Тогда
					
					Если УдалитьФайлПослеЗагрузки Тогда
					
						УдалитьФайлы(ТекФайл.ПолноеИмя);
					
					КонецЕсли; 
					
					// Здесь можно кинуть сообщение обмена!
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЦикла;
	
	// Евросиб Фролов (26.10.2021 Ticket№ 41408
	Если МассивСозданныхКТК.Количество() > 0 Тогда
		РаботаСКонтейнерамиСервер.ДобавитьИнформациюОбИсточникеСозднияКонтейнеров(МассивСозданныхКТК, "Обмен данными АСУТК");
	КонецЕсли;	
	// Евросиб Фролов)
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ОпОш <> "" Тогда
	
		Сообщить(ОпОш);
		
		//ВсегоЗагружено = 0;
		
	КонецЕсли; 
	
КонецПроцедуры

Процедура АСУТК_ПроверитьФактОтправленияПоездов(ЖДРейсы, ИспВАСУТК=Истина, Описание) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Локации.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ ЛокацИня
	               |ИЗ
	               |	Справочник.Локации КАК Локации
	               |ГДЕ
	               |	Локации.Тип = ЗНАЧЕНИЕ(Справочник.ТипыЛокаций.СтанцияЖД)
	               |	И Локации.Наименование = &ИмяИняВосточная
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	АналогиЛокаций.Аналог КАК Локация
	               |ПОМЕСТИТЬ ПроверЛокации
	               |ИЗ
	               |	ЛокацИня КАК ЛокацИня
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналогиЛокаций КАК АналогиЛокаций
	               |		ПО ЛокацИня.Ссылка = АналогиЛокаций.Локация
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЛокацИня.Ссылка
	               |ИЗ
	               |	ЛокацИня КАК ЛокацИня
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОтметкаФактНачалаРейсов.РейсЖД КАК РейсЖД,
	               |	ОтметкаФактНачалаРейсов.ФактическоеНачало КАК ФактическоеНачало,
	               |	ОтметкаФактНачалаРейсов.ЗарегистрированоПоВагону КАК ЗарегистрированоПоВагону,
