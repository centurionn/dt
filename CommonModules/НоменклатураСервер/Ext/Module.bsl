Функция ПолучитьСоответствиеДоступныхТиповЛокацийНоменклатуре(СписокНоменклатуры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НоменклатураДоступныеТипыЛокаций.Ссылка КАК Номенклатура,
	|	НоменклатураДоступныеТипыЛокаций.ТипЛокации КАК ТипЛокации
	|ИЗ
	|	Справочник.Номенклатура.ДоступныеТипыЛокаций КАК НоменклатураДоступныеТипыЛокаций
	|ГДЕ
	|	НоменклатураДоступныеТипыЛокаций.Ссылка В(&Номенклатура)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура,
	|	ТипЛокации";	
	Запрос.УстановитьПараметр("Номенклатура", СписокНоменклатуры);	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТипыЛокацийНоменклатуры = Новый Соответствие;
	Пока Выборка.СледующийПоЗначениюПоля("Номенклатура") Цикл
		ТипыЛокаций = Новый Массив;
		Пока Выборка.СледующийПоЗначениюПоля("ТипЛокации") Цикл
			ТипыЛокаций.Добавить(Выборка.ТипЛокации);
		КонецЦикла;
		ТипыЛокацийНоменклатуры.Вставить(Выборка.Номенклатура, ТипыЛокаций);
	КонецЦикла;
	
	Возврат ТипыЛокацийНоменклатуры;
	
КонецФункции

 //Субботин TASK 70840 20.06.2023 Начало
 Процедура ПроверитьРеквизитИспользованиеНоменклатуры(Номенклатура, СтандартнаяОбработка = Неопределено, Отказ = Неопределено,
	 ДатаСозданияДокумента = Неопределено) Экспорт
	 
	 Если ДатаСозданияДокумента <> Неопределено тогда 
		 Если ОбщегоНазначенияВызовСервера.ЗначениеРеквизитаОбъекта(Номенклатура,"НеИспользовать") = истина
			 и ОбщегоНазначенияВызовСервера.ЗначениеРеквизитаОбъекта(Номенклатура,"ДатаНеИспользовать") <= ДатаСозданияДокумента тогда
			 ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Номенклатура: " + Номенклатура + " недоступна для использования. Необходимо заменить номенклатуру.",,,);
			 Если СтандартнаяОбработка <> Неопределено тогда
				 СтандартнаяОбработка = НЕ Номенклатура.НеИспользовать; 
			 КонецЕсли;
			 Если Отказ <> Неопределено тогда
				 Отказ = Истина;
			 КонецЕсли;
		 КонецЕсли;
	 Иначе
		 Если ОбщегоНазначенияВызовСервера.ЗначениеРеквизитаОбъекта(Номенклатура,"НеИспользовать") = истина тогда
			 ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Номенклатура: " + Номенклатура + " недоступна для использования. Необходимо заменить номенклатуру.",,,);
			 Если СтандартнаяОбработка <> Неопределено тогда
				 СтандартнаяОбработка = НЕ Номенклатура.НеИспользовать; 
			 КонецЕсли;
			 Если Отказ <> Неопределено тогда
				 Отказ = Истина;
			 КонецЕсли;
		 КонецЕсли;
	 КонецЕсли;
		  
КонецПроцедуры

