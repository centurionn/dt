
Процедура ОбработкаПотокаВходящейКорреспонденции() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	*
	               |ИЗ
	               |	РегистрСведений.ОчередьВходящихФайлов КАК ОчередьВходящихФайлов
	               |ГДЕ
	               |	ОчередьВходящихФайлов.Обработано = &ПустаяДата
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ОчередьВходящихФайлов.ПолучениеФайла";
	Запрос.УстановитьПараметр("ПустаяДата", Дата("00010101"));
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		РезультатОбработки = Новый Структура("Успешно", Ложь);
		
		Если Ответ.ТипФайла = Перечисления.ТипыВходящихФайлов.ЗапросEXCEL Тогда
			
			РезультатОбработки = Документы.Запрос.ЗагрузитьEXCELЗапрос(Ответ.Файл);
			
		ИначеЕсли Ответ.ТипФайла = Перечисления.ТипыВходящихФайлов.ЗаявкаEXCEL Тогда
			
			РезультатОбработки = Документы.Заявка.ЗагрузитьEXCELЗаявка(Ответ.Файл);
			
		КонецЕсли;
		
		МЗ = РегистрыСведений.ОчередьВходящихФайлов.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МЗ, Ответ);
		МЗ.Обработано = ТекущаяДата();
		МЗ.Успешно = РезультатОбработки.Успешно;
		МЗ.Записать(Истина);
		
	КонецЦикла;
	
КонецПроцедуры


