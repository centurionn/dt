Функция ЗагрузкаДанных_НайтиГрузоотправителяПолучателя(Строка) Экспорт
	
	Результат = неопределено;
	
	Если НЕ ЗначениеЗаполнено(Строка) Тогда Возврат Результат; КонецЕсли;
	
	ПерваяТЗ = СтрНайти(Строка, ";");
	
	КодКонтрагента = "";
	НаименованиеКонтрагента = "";
	
	Если ПерваяТЗ > 0 Тогда
		
		КодКонтрагента = СокрЛП(лев(Строка, ПерваяТЗ-1));
		НаименованиеКонтрагента = СокрЛП(Сред(Строка, ПерваяТЗ+1));
		
	КонецЕсли;
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Контрагенты.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Контрагенты КАК Контрагенты
	               |ГДЕ
	               |	(Контрагенты.ИНН = &ИНН
	               |			ИЛИ &ИНН = """")
	               |	И ВЫБОР
	               |			КОГДА &ИНН = """"
	               |				ТОГДА Контрагенты.Наименование = &Наименование
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И НЕ Контрагенты.ПометкаУдаления";
	Запрос.УстановитьПараметр("ИНН", КодКонтрагента);
	Запрос.УстановитьПараметр("Наименование", НаименованиеКонтрагента);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

