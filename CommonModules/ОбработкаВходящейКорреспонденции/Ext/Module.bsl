Функция ЗагрузкаДанных_ПолучитьКонтакноеЛицо(ФИО) Экспорт
	
	Результат = неопределено;
	
	Если НЕ ЗначениеЗаполнено(ФИО) Тогда Возврат Результат; КонецЕсли;
	
	Фамилия = "";
	Имя = "";
	Отчество = "";
	
	ФИОМассив = СтрРазделить(ФИО, " .", Ложь);
	Если ФИОМассив.Количество() = 3 Тогда
		Фамилия = ФИОМассив[0];
		Имя = ФИОМассив[1];
		Отчество = ФИОМассив[2];
	ИначеЕсли ФИОМассив.Количество() > 1 Тогда
		Фамилия = ФИОМассив[0];
		Имя = ФИОМассив[1];
	Иначе
		Фамилия = ФИО;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ФизическиеЛица.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ФизическиеЛица КАК ФизическиеЛица
	               |ГДЕ
	               |	НЕ ФизическиеЛица.ПометкаУдаления
	               |	И ФизическиеЛица.Фамилия = &Фамилия
	               |	И (ФизическиеЛица.Имя ПОДОБНО &Имя
	               |			ИЛИ &Имя = """")
	               |	И (ФизическиеЛица.Отчество ПОДОБНО &Отчество
	               |			ИЛИ &Отчество ПОДОБНО """")";
	Запрос.УстановитьПараметр("Фамилия", Фамилия);
	Запрос.УстановитьПараметр("Имя", Имя+"%");
	Запрос.УстановитьПараметр("Отчество", Отчество+"%");
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗагрузкаДанных_ОбработатьДату(Дата) Экспорт
	
	Результат = неопределено;
	
	// формат ##.##.####
	Если СтрДлина(Дата) = 10 И Сред(дата, 3, 1) = "." И Сред(дата, 6, 1) = "." Тогда
		Результат = Дата(""+Прав(Дата, 4)+Сред(Дата, 4, 2)+Лев(Дата, 2));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗагрузкаДанных_НайтиЛокацию_Слитно(КодСлитно) Экспорт
	
	Если НЕ ЗначениеЗаполнено(КодСлитно) Тогда Возврат неопределено; КонецЕсли;
	
	ПерваяТЗ = СтрНайти(КодСлитно, ";");
	
	КодКонтрагента = "";
	НаименованиеКонтрагента = "";
	
	Если ПерваяТЗ > 0 Тогда
		
		КодКонтрагента = СокрЛП(лев(КодСлитно, ПерваяТЗ-1));
		НаименованиеКонтрагента = СокрЛП(Сред(КодСлитно, ПерваяТЗ+1));
		
		Возврат ЗагрузкаДанных_НайтиЛокацию(КодКонтрагента, НаименованиеКонтрагента);
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

