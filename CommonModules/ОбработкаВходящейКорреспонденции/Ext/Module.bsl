Функция ЗагрузкаДанных_ПолучитьКонтрагента(ИНН, КПП, ОГРН, Наименование) Экспорт
	
	Результат = неопределено;
	
	Если НЕ ЗначениеЗаполнено(ИНН) ИЛИ НЕ ЗначениеЗаполнено(Наименование) Тогда Возврат Результат; КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Контрагенты.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Контрагенты КАК Контрагенты
	               |ГДЕ
	               |	НЕ Контрагенты.ПометкаУдаления
	               |	И Контрагенты.ИНН = &ИНН
	               |	И (Контрагенты.КПП = &КПП
	               |			ИЛИ Контрагенты.КПП = """")";
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("КПП", КПП);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	Иначе
		
		НЭлемент = Справочники.Контрагенты.СоздатьЭлемент();
		НЭлемент.Наименование = Наименование;
		НЭлемент.ИНН = ИНН;
		НЭлемент.КПП = КПП;
		НЭлемент.ОГРН = ОГРН;
		НЭлемент.Записать();
		Результат = НЭлемент.Ссылка;
		
	КонецЕсли;
	
	
	Возврат Результат;
	
КонецФункции

