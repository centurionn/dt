	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СпрЭтрана", СсылкаАТК);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Связь_ЭТРАН_DC_Сопоставление.СпрДатакор КАК СпрДатакор
	               |ИЗ
	               |	РегистрСведений.Связь_ЭТРАН_DC_Сопоставление КАК Связь_ЭТРАН_DC_Сопоставление
	               |ГДЕ
	               |	Связь_ЭТРАН_DC_Сопоставление.СпрЭтрана = &СпрЭтрана";
	Ответ = запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.СпрДатакор;
	КонецЕсли;
	
	Возврат Результат;
	
