		НЭлемент.Наименование = ЭлементАТК.Наименование;
		НЭлемент.ЕТСНГ = Формат(ЭлементАТК.Код, "ЧГ=");
		НЭлемент.Записать();
		
		МЗ = РегистрыСведений.Связь_ЭТРАН_DC_Сопоставление.СоздатьМенеджерЗаписи();
