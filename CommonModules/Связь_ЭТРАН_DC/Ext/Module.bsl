
Процедура Связь_ЭТРАН_DC_ПриЗаписиПриЗаписи(Источник, Отказ) Экспорт
	
	НайтиСоздатьЭлементДЦ(Источник.Ссылка);
		
КонецПроцедуры

Функция НайтиСоздатьЭлементДЦ(ЭлементАТК) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ЭлементАТК) Тогда Возврат неопределено; КонецЕсли;
	
	//СопостЭлемент = ПолучитьСопоставлениеДляСпрАТК(ЭлементАТК);
	//Если ЗначениеЗаполнено(СопостЭлемент) Тогда Возврат СопостЭлемент; КонецЕсли;
	
	// э_Контейнеры
	Если ТипЗнч(ЭлементАТК) = Тип("СправочникСсылка.э_Контейнеры") Тогда
		
		КТКДейств = неопределено;
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	ТЕ.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.ТЕ КАК ТЕ
		               |ГДЕ
		               |	НЕ ТЕ.ПометкаУдаления
//		               |	И ТЕ.ВЭксплуатации
		               |	И ТЕ.Наименование ПОДОБНО &Наименование";
		Запрос.УстановитьПараметр("Наименование", ЭлементАТК.НомерКонтейнера);
		Ответ = запрос.Выполнить().Выбрать();
		Если Ответ.Следующий() Тогда
			КТКДейств = Ответ.Ссылка;
		КонецЕсли;

		Если ЗначениеЗаполнено(КТКДейств) Тогда
			МЗ = РегистрыСведений.Связь_ЭТРАН_DC_Сопоставление.СоздатьМенеджерЗаписи();
			МЗ.Период = ТекущаяДата();
			МЗ.СпрДатакор = КТКДейств;
			МЗ.СпрЭтрана = ЭлементАТК.Ссылка;
			МЗ.Записать(Истина);
			Возврат КТКДейств;
		КонецЕсли;
		
//		НЭлемент = Справочники.ТЕ.СоздатьЭлемент();
//		НЭлемент.ТипТЕ = НайтиСоздатьЭлементДЦ(ЭлементАТК.ТипКонтейнера);
//		НЭлемент.Наименование = ЭлементАТК.НомерКонтейнера;
////		НЭлемент.ВЭксплуатации = Истина;
//		НЭлемент.Префикс = Лев(ЭлементАТК.НомерКонтейнера, 4);
//		НЭлемент.Номер = Сред(ЭлементАТК.НомерКонтейнера, 5, 6);
//		НЭлемент.КонтрольноеЧисло = Прав(ЭлементАТК.НомерКонтейнера, 1);
//		НЭлемент.Записать();

		ссЭлемент = РаботаСКонтейнерамиСервер.СоздатьКТК(ЭлементАТК.НомерКонтейнера, НайтиСоздатьЭлементДЦ(ЭлементАТК.ТипКонтейнера));
		
		// Евросиб Фролов (26.10.2021 Ticket№ 41408
		МассивСозданныхКТК = Новый Массив;
		МассивСозданныхКТК.Добавить(ссЭлемент);
		РаботаСКонтейнерамиСервер.ДобавитьИнформациюОбИсточникеСозднияКонтейнеров(МассивСозданныхКТК, "ЭТРАН");
