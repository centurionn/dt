			МЗ = РегистрыСведений.Связь_ЭТРАН_DC_Сопоставление.СоздатьМенеджерЗаписи();
			МЗ.Период = ТекущаяДата();
			МЗ.СпрДатакор = ГрузДейств;
			МЗ.СпрЭтрана = ЭлементАТК;
			МЗ.Записать(Истина);
			Возврат ГрузДейств;
		КонецЕсли;
		
