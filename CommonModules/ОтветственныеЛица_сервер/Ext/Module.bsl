	//		И НЕ ПСЦПоставщика Тогда
	//	Ответ = Пакет[1].Выбрать();
	//Иначе
	//	Ответ = Пакет[0].Выбрать();
	//КонецЕсли;
	//Евросиб Коханенко Н.А. 15.11.2024 )) #95589 
	//Евросиб(ДИТ), Беляев СЮ, BUG 110167 / TA 110622, 29-05-2025, начало
	Если ТипОбъекта = Тип("ДокументСсылка.ПСЦ") Тогда
		Если НЕ Пакет[1].Пустой() И НЕ ПСЦПоставщика Тогда
			Ответ = Пакет[1].Выбрать();
		Иначе
			Ответ = Пакет[0].Выбрать();
		КонецЕсли;
	Иначе
		Если Пакет[0].Пустой() 
			И НЕ ПСЦПоставщика Тогда
			Ответ = Пакет[1].Выбрать();
		Иначе
			Ответ = Пакет[0].Выбрать();
		КонецЕсли;
