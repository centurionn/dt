				|	ДанныеПодписантовКонтрагентов.Должность КАК ДолжностьРус,
				|	ДанныеПодписантовКонтрагентов.ДолжностьАнгл КАК ДолжностьАнгл,
				|	ДанныеПодписантовКонтрагентов.СканДоверенности КАК СканДоверенности,
				|	ДанныеПодписантовКонтрагентов.Подписант.Наименование КАК ФИОРус,
	            |	ДанныеПодписантовКонтрагентов.Подписант.НаименованиеДляПечатиВРПАнгл КАК ФИОАнгл,
				|	ДанныеПодписантовКонтрагентов.Доверенность КАК Основание,
				|	ДанныеПодписантовКонтрагентов.НаОсновании КАК ОснованиеРус,
			    |	ВЫБОР
			    |		КОГДА ДанныеПодписантовКонтрагентов.ФИОВРодительномПадеже = """"
			    |			ТОГДА ДанныеПодписантовКонтрагентов.Подписант.НаименованиеДляПечатиВРП
			    |		ИНАЧЕ ДанныеПодписантовКонтрагентов.ФИОВРодительномПадеже
			    |	КОНЕЦ КАК ФИОРПРус,
			    |	ВЫБОР
			    |		КОГДА ДанныеПодписантовКонтрагентов.ДолжностьВРодительномПадеже = """"
			    |			ТОГДА ДанныеПодписантовКонтрагентов.Подписант.ДолжностьРП
			    |		ИНАЧЕ ДанныеПодписантовКонтрагентов.ДолжностьВРодительномПадеже
			    |	КОНЕЦ КАК ДолжностьРП,
				|	ЕСТЬNULL(ФизическиеЛицаПереводыНаименований.ФИО, """") КАК ФИОВал,
				|	ЕСТЬNULL(ФизическиеЛицаПереводыНаименований.Должность, """") КАК ДолжностьВал,
				|	ЕСТЬNULL(ФизическиеЛицаПереводыНаименований.Основание, """") КАК НаОснованииВал
				|ИЗ
				|	РегистрСведений.ДанныеПодписантовКонтрагентов КАК ДанныеПодписантовКонтрагентов
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица.ПереводыНаименований КАК ФизическиеЛицаПереводыНаименований
				|		ПО (ФизическиеЛицаПереводыНаименований.Валюта = &Валюта)
				|ГДЕ
				|	ДанныеПодписантовКонтрагентов.Период <= &Период
				|	И ДанныеПодписантовКонтрагентов.Контрагент = &Контрагент
				|	И ДанныеПодписантовКонтрагентов.Подписант = &Подписант
				|	И ВЫБОР
				|			КОГДА ДанныеПодписантовКонтрагентов.ОкончаниеДействия = &ПустаяДата
				|				ТОГДА ИСТИНА
				|			ИНАЧЕ ДанныеПодписантовКонтрагентов.ОкончаниеДействия >= &Период
				|		КОНЕЦ
				|
				|УПОРЯДОЧИТЬ ПО
				|	ДанныеПодписантовКонтрагентов.Период УБЫВ";
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	
	Если ЗначениеЗаполнено(ВыбранныйРуководитель) Тогда
		Запрос.УстановитьПараметр("Подписант", ВыбранныйРуководитель);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ДанныеПодписантовКонтрагентов.Подписант = &Подписант", "");
	КонецЕсли;
	//Евросиб Коханенко Н.А. 15.11.2024 )) #95589 

	//Евросиб Коханенко Н.А. 15.11.2024 (( #95589 
