Функция ПолучитьПодписанта(Контрагент, Период, Подписант = неопределено, Валюта = Неопределено) Экспорт
	
	//Евросиб Коханенко Н.А. 06.12.2024 (( #89893 
	//Результат = Новый Структура("Подписант, ДолжностьРус, ДолжностьАнгл, НачалоДействия, ОкончаниеДействия, Доверенность, СканДоверенности, ДолжностьВРодительномПадеже, ФИОВРодительномПадеже, ГлавныйБухгалтер, ФИОВал, ДолжностьВал, НаОснованииВал");
	Результат = Новый Структура("Подписант, ДолжностьРус, ДолжностьАнгл, НачалоДействия, ОкончаниеДействия, Доверенность, СканДоверенности, ДолжностьВРодительномПадеже, ФИОВРодительномПадеже, ГлавныйБухгалтер, ФИОВал, ДолжностьВал, НаОснованииВал, НаОсновании");
	//Евросиб Коханенко Н.А. 06.12.2024 )) #89893 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеПодписантовКонтрагентов.Подписант КАК Подписант,
	|	ДанныеПодписантовКонтрагентов.Должность КАК ДолжностьРус,
	|	ДанныеПодписантовКонтрагентов.ДолжностьАнгл КАК ДолжностьАнгл,
	|	ДанныеПодписантовКонтрагентов.СканДоверенности КАК СканДоверенности,
	|	ДанныеПодписантовКонтрагентов.Период КАК НачалоДействия,
	|	ДанныеПодписантовКонтрагентов.ОкончаниеДействия КАК ОкончаниеДействия,
	|	ДанныеПодписантовКонтрагентов.ДолжностьВРодительномПадеже КАК ДолжностьВРодительномПадеже,
	|	ДанныеПодписантовКонтрагентов.Фамилия КАК Фамилия,
	//Евросиб Коханенко Н.А. 06.12.2024 (( #89893 
	|	ДанныеПодписантовКонтрагентов.НаОсновании КАК НаОсновании,
	//Евросиб Коханенко Н.А. 06.12.2024 )) #89893 
	|	ДанныеПодписантовКонтрагентов.Имя КАК Имя,
	|	ДанныеПодписантовКонтрагентов.Отчество КАК Отчество,
	|	ДанныеПодписантовКонтрагентов.ФИОВРодительномПадеже КАК ФИОВРодительномПадеже,
	|	ДанныеПодписантовКонтрагентов.Доверенность КАК Доверенность,
	|	ДанныеПодписантовКонтрагентов.ГлавныйБухгалтер КАК ГлавныйБухгалтер,
	|	ЕСТЬNULL(ФизическиеЛицаПереводыНаименований.ФИО, """") КАК ФИОВал,
	|	ЕСТЬNULL(ФизическиеЛицаПереводыНаименований.Должность, """") КАК ДолжностьВал,
	|	ЕСТЬNULL(ФизическиеЛицаПереводыНаименований.Основание, """") КАК НаОснованииВал
	|ИЗ
	|	РегистрСведений.ДанныеПодписантовКонтрагентов КАК ДанныеПодписантовКонтрагентов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица.ПереводыНаименований КАК ФизическиеЛицаПереводыНаименований
	|		ПО (ФизическиеЛицаПереводыНаименований.Валюта = &Валюта)
	|ГДЕ
	|	ДанныеПодписантовКонтрагентов.Период <= &Период
	|	И ДанныеПодписантовКонтрагентов.Контрагент = &Контрагент
	|	И ДанныеПодписантовКонтрагентов.Подписант = &Подписант
	|	И ВЫБОР
	|			КОГДА ДанныеПодписантовКонтрагентов.ОкончаниеДействия = &ПустаяДата
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ДанныеПодписантовКонтрагентов.ОкончаниеДействия >= &Период
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДанныеПодписантовКонтрагентов.Период УБЫВ";
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	Запрос.УстановитьПараметр("Период", Период);	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);  
	Запрос.УстановитьПараметр("Валюта", Валюта);
	
	Если ЗначениеЗаполнено(Подписант) Тогда
		Запрос.УстановитьПараметр("Подписант", Подписант);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ДанныеПодписантовКонтрагентов.Подписант = &Подписант", "");
	КонецЕсли;

	Ответ = запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда		
		ЗаполнитьЗначенияСвойств(результат, Ответ);		
	КонецЕсли;
	
	Возврат результат;
	
КонецФункции

Функция ПолучитьГлБухгалтера(Контрагент, Дата) Экспорт
	
	Результат = Новый Структура("ГлавныйБухгалтер, ГлавныйБухгалтерНаименование, ГлавныйБухгалтерНаименованиеДляПечатиВРП, ДолжностьРус, ОснованиеРус, ГлавныйБухгалтерНаименованиеДляПечатиВРПАнгл, ДолжностьАнгл, ОснованиеАнгл");

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДанныеРуководителяКонтрагентовСрезПоследних.ГлавныйБухгалтер КАК ГлавныйБухгалтер,
	               |	ДанныеРуководителяКонтрагентовСрезПоследних.ГлавныйБухгалтер.Наименование КАК ГлавныйБухгалтерНаименование,
	               |	ДанныеРуководителяКонтрагентовСрезПоследних.ГлавныйБухгалтер.НаименованиеДляПечатиВРП КАК ГлавныйБухгалтерНаименованиеДляПечатиВРП,
	               |	ДанныеРуководителяКонтрагентовСрезПоследних.ГлавныйБухгалтер.НаименованиеДляПечатиВРПАнгл КАК ГлавныйБухгалтерНаименованиеДляПечатиВРПАнгл 
	               |ИЗ
	               |	РегистрСведений.ДанныеРуководителяКонтрагентов.СрезПоследних(&Период, Контрагент = &Контрагент) КАК ДанныеРуководителяКонтрагентовСрезПоследних";
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("Контрагент", Контрагент); 
	Ответ = запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		
		Результат.ГлавныйБухгалтер = Ответ.ГлавныйБухгалтер;
		Результат.ГлавныйБухгалтерНаименование = Ответ.ГлавныйБухгалтерНаименование;
		Результат.ГлавныйБухгалтерНаименованиеДляПечатиВРП = Ответ.ГлавныйБухгалтерНаименованиеДляПечатиВРП;
		Результат.ДолжностьРус = "Главный бухгалтер";
		Результат.ОснованиеРус = "";
		Результат.ГлавныйБухгалтерНаименованиеДляПечатиВРПАнгл = Ответ.ГлавныйБухгалтерНаименованиеДляПечатиВРПАнгл;
		Результат.ДолжностьАнгл = "";
		Результат.ОснованиеАнгл = "";  
		
	КонецЕсли;
	
	Возврат результат;
	
КонецФункции