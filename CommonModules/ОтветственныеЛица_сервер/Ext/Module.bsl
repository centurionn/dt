	               |	И ДанныеРуководителяКонтрагентов.Контрагент = &Контрагент
				   //Евросиб(ДИТ), Беляев СЮ, BUG 110167 / TA 110622, 29-05-2025, начало
				   |	И ВЫБОР
				   |			КОГДА ДанныеРуководителяКонтрагентов.ОкончаниеДействия = &ПустаяДата
				   |				ТОГДА ИСТИНА
				   |			ИНАЧЕ ДанныеРуководителяКонтрагентов.ОкончаниеДействия >= &Период
				   |		КОНЕЦ
				   //Евросиб(ДИТ), Беляев СЮ, BUG 110167 / TA 110622, 29-05-2025, конец
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДанныеРуководителяКонтрагентов.Период УБЫВ";				   
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("ВыбранныйРуководитель", ?(ЗначениеЗаполнено(ВыбранныйРуководитель), ВыбранныйРуководитель, Неопределено));
	Запрос.УстановитьПараметр("Контрагент", Контрагент);  
