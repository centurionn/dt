	Результат = Новый Структура("Ссылка, ФИОРус, ФИОРПРус, ДолжностьРус, ДолжностьРП, Основание, ОснованиеРус, ФИОАнгл, ДолжностьАнгл, ОснованиеАнгл, ФИОВал, ДолжностьВал, НаОснованииВал, СканДоверенности");
