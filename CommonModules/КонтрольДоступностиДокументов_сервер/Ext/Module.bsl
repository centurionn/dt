	МассивБлокируемыхЭлементов.Добавить("ФормаДокументРеализацияТоваровУслугСоздатьНаОсновании"); 
	МассивБлокируемыхЭлементов.Добавить("СписокКонтекстноеМенюДокументРеализацияТоваровУслугСоздатьНаОсновании"); 
	Для Каждого Элемент Из Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("КнопкаФормы") Тогда 
			Если МассивБлокируемыхЭлементов.Найти(Элемент.Имя) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Элемент.Доступность Тогда
				Элемент.Доступность = Ложь; 
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
