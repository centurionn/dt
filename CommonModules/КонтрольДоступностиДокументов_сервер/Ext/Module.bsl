Процедура УдалитьЗаписиПротоколовОбменов(СписокДоков) Экспорт
	
	Если НЕ РольДоступна("ПолныеПрава") Тогда Возврат; КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПротоколОбменов.ДействиеПриОбмене КАК ДействиеПриОбмене,
	               |	ПротоколОбменов.УзелОбмена КАК УзелОбмена,
	               |	ПротоколОбменов.Объект КАК Объект,
	               |	ПротоколОбменов.НУИНУ КАК НУИНУ,
	               |	ПротоколОбменов.УИДИсточника КАК УИДИсточника,
	               |	ПротоколОбменов.ПроведенВБУ КАК ПроведенВБУ,
	               |	ПротоколОбменов.Ответственный КАК Ответственный,
	               |	ПротоколОбменов.ДатаОбмена КАК ДатаОбмена,
	               |	ПротоколОбменов.НомерДатаВБУ КАК НомерДатаВБУ
	               |ИЗ
	               |	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	               |ГДЕ
	               |	ПротоколОбменов.Объект В(&Объект)";
	Запрос.УстановитьПараметр("Объект", СписокДоков);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока ОТвет.Следующий() Цикл
		МЗ =РегистрыСведений.ПротоколОбменов.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МЗ, Ответ);
		МЗ.Удалить();
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьИзмененияРеквизитовОбъекта(Объект, Отказ, ПроверятьВсе = Ложь, Исключения = Неопределено, ИзмененныеРеквизиты = Неопределено) Экспорт
	
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Если Исключения = Неопределено Тогда
		Если Не ПроверятьВсе Тогда
			Возврат;
		КонецЕсли;
		Исключения = Новый Массив;
	КонецЕсли;
	
	МетаданныеОбъекта = Объект.Метаданные();
	ПолноеИмяОбъекта = МетаданныеОбъекта.ПолноеИмя();
	
	ИсключенияСтандартныхРеквизитов = Новый Массив;
	ИсключенияСтандартныхРеквизитов.Добавить("Ссылка");
	ИсключенияСтандартныхРеквизитов.Добавить("Проведен");
	ИсключенияСтандартныхРеквизитов.Добавить("ПометкаУдаления");
	
	ПроверяемыеРеквизиты = Новый Массив;
	ПроверяемыеТабличныеЧасти = Новый Массив;
	ПроверяемыеРеквизитыТЧ = Новый Структура;
	ТипХранилищеЗначения = Тип("ХранилищеЗначения");
	Если ПроверятьВсе Тогда
		Исключения.Добавить("ТекущееСостояние");
		Исключения.Добавить("Состояния");
		Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
			Если Исключения.Найти(Реквизит.Имя) = Неопределено И Не Реквизит.Тип.СодержитТип(ТипХранилищеЗначения) Тогда
				ПроверяемыеРеквизиты.Добавить(Реквизит);
			КонецЕсли;			
		КонецЦикла;
		Для Каждого Реквизит Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
			Если Исключения.Найти(Реквизит.Имя) = Неопределено
					И ИсключенияСтандартныхРеквизитов.Найти(Реквизит.Имя) = Неопределено Тогда
				ПроверяемыеРеквизиты.Добавить(Реквизит);
			КонецЕсли;			
		КонецЦикла;
		Для Каждого ТабличнаяЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
			Если Исключения.Найти(ТабличнаяЧасть.Имя) = Неопределено Тогда
				ПроверяемыеТабличныеЧасти.Добавить(ТабличнаяЧасть);
				//Реквизиты табличной части
				ПроверяемыеРеквизитыТЧ.Вставить(ТабличнаяЧасть.Имя, Новый Массив);
				Для Каждого РеквизитТЧ Из ТабличнаяЧасть.Реквизиты Цикл
					Если Не РеквизитТЧ.Тип.СодержитТип(ТипХранилищеЗначения) Тогда
						ПолноеИмяРеквизита = ТабличнаяЧасть.Имя + "." + РеквизитТЧ.Имя;
						Если Исключения.Найти(ПолноеИмяРеквизита) = Неопределено Тогда
							ПроверяемыеРеквизитыТЧ[ТабличнаяЧасть.Имя].Добавить(РеквизитТЧ);
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;				
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого ИмяРеквизита Из Исключения Цикл
			
			Реквизит = МетаданныеОбъекта.Реквизиты.Найти(ИмяРеквизита);
			Если Реквизит <> Неопределено Тогда
				ПроверяемыеРеквизиты.Добавить(Реквизит);
			Иначе				
				Для Каждого СтандартныйРеквизит Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
					Если СтандартныйРеквизит.Имя = ИмяРеквизита Тогда
						Реквизит = СтандартныйРеквизит;
						Прервать;
					КонецЕсли;
				КонецЦикла;				
				Если Реквизит <> Неопределено Тогда
					ПроверяемыеРеквизиты.Добавить(Реквизит);
				Иначе
					ТабличнаяЧасть = МетаданныеОбъекта.ТабличныеЧасти.Найти(ИмяРеквизита);					
					Если ТабличнаяЧасть <> Неопределено Тогда
						ПроверяемыеТабличныеЧасти.Добавить(ТабличнаяЧасть);
						//Реквизиты табличной части
						ПроверяемыеРеквизитыТЧ.Вставить(ТабличнаяЧасть.Имя, Новый Массив);
						Для Каждого РеквизитТЧ Из ТабличнаяЧасть.Реквизиты Цикл
							Если Не РеквизитТЧ.Тип.СодержитТип(ТипХранилищеЗначения) Тогда
								ПолноеИмяРеквизита = ТабличнаяЧасть.Имя + "." + РеквизитТЧ.Имя;
								ПроверяемыеРеквизитыТЧ[ТабличнаяЧасть.Имя].Добавить(РеквизитТЧ);
							КонецЕсли;
						КонецЦикла;
					Иначе					
						//Реквизит табличной части
						Если СтрНайти(ИмяРеквизита, ".") > 0 Тогда
							Строки = СтрРазделить(ИмяРеквизита, ".");
							Если Строки.Количество() = 2 Тогда
								ИмяТЧ = Строки[0];
								ИмяРеквизитаТЧ = Строки[1];
								ТабличнаяЧасть = МетаданныеОбъекта.ТабличныеЧасти.Найти(ИмяТЧ);
								Если ТабличнаяЧасть <> Неопределено Тогда
									РеквизитТЧ = ТабличнаяЧасть.Реквизиты.Найти(ИмяРеквизитаТЧ);
									Если РеквизитТЧ <> Неопределено И Не РеквизитТЧ.Тип.СодержитТип(ТипХранилищеЗначения) Тогда 
										Если Не ПроверяемыеРеквизитыТЧ.Свойство(ИмяТЧ) Тогда
											ПроверяемыеТабличныеЧасти.Добавить(ТабличнаяЧасть);
											ПроверяемыеРеквизитыТЧ.Вставить(ИмяТЧ, Новый Массив);
										КонецЕсли;
										ПроверяемыеРеквизитыТЧ[ИмяТЧ].Добавить(РеквизитТЧ);
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Если ПроверяемыеРеквизиты.Количество() = 0 И ПроверяемыеТабличныеЧасти.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекстыПакетаЗапросов = Новый Массив;
	ШаблонПоляЗапроса = "	Таблица.%1 КАК %1";
	ШаблонТекстаЗапроса =
	"ВЫБРАТЬ
	|	%2	
	|ИЗ
	|	%1 КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка = &Ссылка";
	
	Если ПроверяемыеРеквизиты.Количество() > 0 Тогда
		
		ТекстыПолейЗапроса = Новый Массив;		
		Для Каждого Реквизит Из ПроверяемыеРеквизиты Цикл			
			ТекстПоляЗапроса = СтрШаблон(ШаблонПоляЗапроса, Реквизит.Имя);
			ТекстыПолейЗапроса.Добавить(ТекстПоляЗапроса);
		КонецЦикла;
		ТекстПолейЗапроса = СтрСоединить(ТекстыПолейЗапроса, "," + Символы.ПС);
		
		ТекстЗапроса = СтрШаблон(ШаблонТекстаЗапроса, ПолноеИмяОбъекта, ТекстПолейЗапроса);
		ТекстыПакетаЗапросов.Добавить(ТекстЗапроса);
		
	КонецЕсли;
	
	Для Каждого ТабличнаяЧасть Из ПроверяемыеТабличныеЧасти Цикл
		
		РеквизитыТЧ = ПроверяемыеРеквизитыТЧ[ТабличнаяЧасть.Имя];
		ТекстыПолейЗапроса = Новый Массив;		
		Для Каждого Реквизит Из РеквизитыТЧ Цикл
			ТекстПоляЗапроса = СтрШаблон(ШаблонПоляЗапроса, Реквизит.Имя);
			ТекстыПолейЗапроса.Добавить(ТекстПоляЗапроса);			
		КонецЦикла;
		ТекстПолейЗапроса = СтрСоединить(ТекстыПолейЗапроса, "," + Символы.ПС);
		
		ТаблицаЗапроса = ПолноеИмяОбъекта + "." + ТабличнаяЧасть.Имя;
		ТекстЗапроса = СтрШаблон(ШаблонТекстаЗапроса, ТаблицаЗапроса, ТекстПолейЗапроса);
		ТекстыПакетаЗапросов.Добавить(ТекстЗапроса);
		
	КонецЦикла;
	
	ТекстПакетаЗапросов = СтрСоединить(ТекстыПакетаЗапросов, Символы.ПС + ";" + Символы.ПС);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстПакетаЗапросов;	
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ИндексТаблицы = 0;
	Если ПроверяемыеРеквизиты.Количество() > 0 Тогда
		
		Выборка = РезультатыЗапроса[ИндексТаблицы].Выбрать();
		Если Выборка.Следующий() Тогда
			ИзмененныеРеквизиты = Новый Массив;
			Для Каждого Реквизит Из ПроверяемыеРеквизиты Цикл
				Если Выборка[Реквизит.Имя] <> Объект[Реквизит.Имя] Тогда
					Отказ = Истина;
					Если ЗначениеЗаполнено(Реквизит.Синоним) Тогда
						СинонимРеквизита = Реквизит.Синоним;
					Иначе
						СинонимРеквизита = Реквизит.Имя;
					КонецЕсли;
					ИзмененныеРеквизиты.Добавить(СинонимРеквизита);			
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		ИндексТаблицы = ИндексТаблицы + 1;
	КонецЕсли;
	
	Для Каждого ТабличнаяЧасть Из ПроверяемыеТабличныеЧасти Цикл
		
		ТаблицаЗаписанныхДанных = РезультатыЗапроса[ИндексТаблицы].Выгрузить();
		
		РеквизитыТЧ = ПроверяемыеРеквизитыТЧ[ТабличнаяЧасть.Имя];
		ИменаРеквизитов = Новый Массив;
		Для Каждого РеквизитТЧ Из РеквизитыТЧ Цикл
			ИменаРеквизитов.Добавить(РеквизитТЧ.Имя);
		КонецЦикла;
		СтрокаРеквизитовТЧ = СтрСоединить(ИменаРеквизитов, ",");
		ТаблицаДанныхОбъекта = Объект[ТабличнаяЧасть.Имя].Выгрузить(, СтрокаРеквизитовТЧ);
		
		ТаблицыИдентичны = ОбщегоНазначения.КоллекцииИдентичны(ТаблицаЗаписанныхДанных, ТаблицаДанныхОбъекта);
		Если Не ТаблицыИдентичны Тогда
			Отказ = Истина;
			ИзмененныеРеквизиты.Добавить(ТабличнаяЧасть.Синоним);
		КонецЕсли;
		
		ИндексТаблицы = ИндексТаблицы + 1;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработатьБлокировкуЭлементовФормы(Ссылка, Элементы, Объект = Неопределено) Экспорт
	
	//Евросиб Каблов 07.07.2021 ( Ticket#0236692 Добавлен запрет редактирования поля документа Номер
	//Если ЗначениеЗаполнено(Ссылка) Тогда
	//Евросиб Каблов 07.07.2021 )
	
		//Евросиб Каблов 22.01.2021 ( Ticket#0217261
		//СтруктураБлокировки = КонтрольДоступностиДокументов_сервер.ПолучитьБлокируемыеПоля(Ссылка);
		СтруктураБлокировки = КонтрольДоступностиДокументов_сервер.ПолучитьБлокируемыеПоля(Ссылка,, Истина, Объект);
		//Евросиб Каблов 22.01.2021 )
		
		//Евросиб Каблов 07.07.2021 ( Ticket#0236692 Добавлен запрет редактирования поля документа Номер
		////Евросиб Каблов 29.06.2021 (
		////Элементы.ПредупреждениеРедактирования.Видимость = СтруктураБлокировки.Заблокирован;
		////Элементы.ПредупреждениеРедактирования.Заголовок = СтруктураБлокировки.ОписаниеБлокировки;
		//Если Элементы.Найти("ПредупреждениеРедактирования") <> Неопределено Тогда
		//	Элементы.ПредупреждениеРедактирования.Видимость = СтруктураБлокировки.Заблокирован;
		//	Элементы.ПредупреждениеРедактирования.Заголовок = СтруктураБлокировки.ОписаниеБлокировки;
		//КонецЕсли;
		////Евросиб Каблов 29.06.2021 )
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Если Элементы.Найти("ПредупреждениеРедактирования") <> Неопределено Тогда     
				//ДИТ, Беляев СЮ, ТА44280, 27-12-2021, ++
				ВидимостьПредупреждениеРедактирования = СтруктураБлокировки.Заблокирован ИЛИ НЕ ПустаяСтрока(СокрЛП(СтруктураБлокировки.ОписаниеБлокировки)); 
				//ДИТ, Беляев СЮ, ТА44280, 27-12-2021, --
				Элементы.ПредупреждениеРедактирования.Видимость = ВидимостьПредупреждениеРедактирования;
				Элементы.ПредупреждениеРедактирования.Заголовок = СтруктураБлокировки.ОписаниеБлокировки;
			КонецЕсли;
			//Евросиб - АСуслов 06.01.2023 10:10:41 #63243
			//(
		ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.Акцепт") Тогда
			ВидимостьПредупреждениеРедактирования = НЕ ПустаяСтрока(СокрЛП(СтруктураБлокировки.ОписаниеБлокировки)); 
			Элементы.ПредупреждениеРедактирования.Видимость = ВидимостьПредупреждениеРедактирования;
			Элементы.ПредупреждениеРедактирования.Заголовок = СтруктураБлокировки.ОписаниеБлокировки;
			//)
			//Евросиб - АСуслов 06.01.2023 10:10:59 #63243
		Иначе
			Если Элементы.Найти("ПредупреждениеРедактирования") <> Неопределено Тогда
				Элементы.ПредупреждениеРедактирования.Видимость = Ложь;
			КонецЕсли;
		КонецЕсли;
		//Евросиб Каблов 07.07.2021 )
				
		Блокировать = СтруктураБлокировки.БлокироватьВсеПоля;
		
		Если Блокировать Тогда
			СтруктураБлокировки.ПоляИсключения.Добавить("ФормаПеречитать");
			СтруктураБлокировки.ПоляИсключения.Добавить("ФормаСкопировать"); 
			СтруктураБлокировки.ПоляИсключения.Добавить("ФормаПоказатьВСписке");
			СтруктураБлокировки.ПоляИсключения.Добавить("ФормаИсторияИзменений");
			СтруктураБлокировки.ПоляИсключения.Добавить("ФормаИзменитьФорму");
			СтруктураБлокировки.ПоляИсключения.Добавить("ФормаСправка");
			СтруктураБлокировки.ПоляИсключения.Добавить("СтруктураПодчиненности");
			//Евросиб Каблов 29.10.2024 ( #67092
			СтруктураБлокировки.ПоляИсключения.Добавить("ФормаЖурналДокументовВзаимодействия");
			СтруктураБлокировки.ПоляИсключения.Добавить("ОткрытьОкноСИнструкциями");
			//Евросиб Каблов 29.10.2024 )
			СтруктураБлокировки.ПоляИсключения.Добавить("ФормаОбщаяКомандаНапомнить");
			СтруктураБлокировки.ПоляИсключения.Добавить("ФормаОбщаяКомандаСоздатьЗаметкуПоПредмету");
			СтруктураБлокировки.ПоляИсключения.Добавить("ФормаЗаменитьИсполнителя");
			//Евросиб Каблов 12.04.2021 ( Ticket#0229073
			СтруктураБлокировки.ПоляИсключения.Добавить("ПодменюОтчетыСмТакже_Авто");
			СтруктураБлокировки.ПоляИсключения.Добавить("ПодменюПечать");
			//Евросиб Каблов 12.04.2021 ) 
			//СтруктураБлокировки.ПоляИсключения.Добавить("ПодписанСДвухСторон"); //Евросиб Каблов 05.03.2021 Ticket#0219054
			
			// SIV 19-02-21 Блин! Добавил в исключения для РТУ в ПолучитьБлокируемыеПоля, а оно там как-то переназначается и все равно блокирует.
			// Слишком сложно, чтобы разобраться )))
			СтруктураБлокировки.ПоляИсключения.Добавить("ФормаРегистрСведенийРазрешениеВводаКорректировокАннулироватьДокумент");
			СтруктураБлокировки.ПоляИсключения.Добавить("ФормаРегистрСведенийРазрешениеВводаКорректировокАннулироватьВознаграждение");
			СтруктураБлокировки.ПоляИсключения.Добавить("ФормаРегистрСведенийРазрешениеВводаКорректировокОткрытьКорректировку");
			СтруктураБлокировки.ПоляИсключения.Добавить("ФормаРегистрСведенийРазрешениеВводаКорректировокОтменитьРазрешение");
			СтруктураБлокировки.ПоляИсключения.Добавить("ФормаРегистрСведенийРазрешениеВводаКорректировокРазрешитьИсправление");
			СтруктураБлокировки.ПоляИсключения.Добавить("ФормаРегистрСведенийРазрешениеВводаКорректировокРазрешитьКорректировку");
			СтруктураБлокировки.ПоляИсключения.Добавить("ГруппаКорректировкиДокумента");
			СтруктураБлокировки.ПоляИсключения.Добавить("КорректировкиДокумента");
			СтруктураБлокировки.ПоляИсключения.Добавить("КалькуляцииОткрытьКалькуляцию");
			СтруктураБлокировки.ПоляИсключения.Добавить("ЗаполнятьПоПервойСтроке");
			
		КонецЕсли;
		
 		Для Каждого Элемент Из Элементы Цикл
			Если ТипЗнч(Элемент) = Тип("ПолеФормы") Тогда
				Если Не Элемент.ТолькоПросмотр Тогда
					ИмяРеквизита = СтрЗаменить(Элемент.ПутьКДанным, "Объект.", "");
					ИндексЗначения = СтруктураБлокировки.ПоляИсключения.Найти(ИмяРеквизита);
					Если ИндексЗначения = Неопределено Тогда
						Элемент.ТолькоПросмотр = Блокировать;
						//Когда поле принадлежит таблице, которая в исключениях 
						НомерТочки = СтрНайти(ИмяРеквизита, ".");
						Если НомерТочки > 0 Тогда						
							ИмяТаблицы = Лев(ИмяРеквизита, НомерТочки - 1);
							ИндексЗначения = СтруктураБлокировки.ПоляИсключения.Найти(ИмяТаблицы);
							Если ИндексЗначения = Неопределено Тогда
								Элемент.ТолькоПросмотр = Блокировать;
							Иначе
								Элемент.ТолькоПросмотр = Не Блокировать;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли; 
					//Субботин 75703 09.10.2023 начало// вторая проверка добавлена для возможности
					//блокировки элементов формы отдельно от реквизита
					Если ИндексЗначения = Неопределено Тогда						
						ИмяРеквизита = Элемент.Имя;
						ИндексЗначения = СтруктураБлокировки.ПоляИсключения.Найти(ИмяРеквизита);
						Если ИндексЗначения = Неопределено Тогда
							Элемент.ТолькоПросмотр = Блокировать;
							//Когда поле принадлежит таблице, которая в исключениях 
							НомерТочки = СтрНайти(ИмяРеквизита, ".");
							Если НомерТочки > 0 Тогда						
								ИмяТаблицы = Лев(ИмяРеквизита, НомерТочки - 1);
								ИндексЗначения = СтруктураБлокировки.ПоляИсключения.Найти(ИмяТаблицы);
								Если ИндексЗначения = Неопределено Тогда
									Элемент.ТолькоПросмотр = Блокировать;
								Иначе
									Элемент.ТолькоПросмотр = Не Блокировать;
								КонецЕсли;
							КонецЕсли;
						Иначе 
							Элемент.ТолькоПросмотр = Не Блокировать;
						КонецЕсли;
					Иначе 
						Элемент.ТолькоПросмотр = Не Блокировать;
					КонецЕсли;
					//Субботин 75703 09.10.2023 Конец 
				КонецЕсли; 
				
			ИначеЕсли ТипЗнч(Элемент) = Тип("ТаблицаФормы") Тогда
				Если Не Элемент.ТолькоПросмотр Тогда
					ИмяРеквизита = СтрЗаменить(Элемент.ПутьКДанным, "Объект.", "");
					ИндексЗначения = СтруктураБлокировки.ПоляИсключения.Найти(ИмяРеквизита);
					Если ИндексЗначения = Неопределено Тогда
						//Если разрешено редактировать поле табличной части, то блокировать всю таблицу нельзя
						УстановитьЗначениеТолькоПросмотр = Истина;
						Если Блокировать Тогда
							Для Каждого ИмяПоляИсключения Из СтруктураБлокировки.ПоляИсключения Цикл
								Если СтрНайти(ИмяПоляИсключения, ".") > 0 Тогда
									Строки = СтрРазделить(ИмяПоляИсключения, ".");
									Если Строки.Количество() = 2 Тогда
										ИмяТЧ = Строки[0];
										Если ИмяТЧ = ИмяРеквизита Тогда
											УстановитьЗначениеТолькоПросмотр = Ложь;
											Прервать;
										КонецЕсли;
									КонецЕсли;
								КонецЕсли;
							КонецЦикла;
						КонецЕсли;
						Если УстановитьЗначениеТолькоПросмотр Тогда
							Элемент.ТолькоПросмотр = Блокировать;
						КонецЕсли;
					Иначе
						Элемент.ТолькоПросмотр = Не Блокировать;
					КонецЕсли; 
				КонецЕсли;
			ИначеЕсли ТипЗнч(Элемент) = Тип("КнопкаФормы") Тогда
				Если Элемент.Доступность Тогда
					ИмяЭлемента = Элемент.Имя;
					Если ИмяЭлемента = "ОбновитьДатыДокумента" 
						ИЛИ ИмяЭлемента = "ОбновитьОткрытыйПериод" Тогда
						ИндексЗначения = СтруктураБлокировки.ПоляИсключения.Найти("ПериодВО");
						Если ИндексЗначения = Неопределено Тогда
							Элемент.Доступность = Не Блокировать;
						Иначе
							Элемент.Доступность = Блокировать;
						Конецесли;						
					Иначе
						НайденВИсключениях = Ложь;
						Для Каждого ПолеИсключение Из СтруктураБлокировки.ПоляИсключения Цикл
							ДлинаИмени = СтрДлина(ПолеИсключение);
							Если Лев(ИмяЭлемента, ДлинаИмени) = ПолеИсключение Тогда
								НайденВИсключениях = Истина;
								Прервать;
							КонецЕсли;
						КонецЦикла;
						
						Если НайденВИсключениях Тогда
							Элемент.Доступность = Блокировать;
						Иначе
							Элемент.Доступность = Не Блокировать;
						Конецесли; 
						
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли ТипЗнч(Элемент) = Тип("ГруппаФормы") 
				И НЕ Блокировать Тогда
				НайденВИсключениях = Ложь;
				Для Каждого ПолеИсключение Из СтруктураБлокировки.ПоляИсключения Цикл
					Если Элемент.Имя = ПолеИсключение Тогда
						НайденВИсключениях = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если НайденВИсключениях Тогда
					Элемент.Доступность = Блокировать;
				Конецесли;
			КонецЕсли;
		КонецЦикла; 
		
	//Евросиб Каблов 07.07.2021 ( Ticket#0236692 Добавлен запрет редактирования поля документа Номер. Разместил этот код выше.	
	//Иначе
	//	//Евросиб Каблов 07.07.2021 (
	//	//Элементы.ПредупреждениеРедактирования.Видимость = Ложь;
	//	Если Элементы.Найти("ПредупреждениеРедактирования") <> Неопределено Тогда
	//		Элементы.ПредупреждениеРедактирования.Видимость = Ложь;
	//	КонецЕсли;
	//	//Евросиб Каблов 07.07.2021 )
	//КонецЕсли;
	//Евросиб Каблов 07.07.2021 )
	
КонецПроцедуры

