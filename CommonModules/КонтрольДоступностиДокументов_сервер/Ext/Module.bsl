Функция ПолучитьСписокРодительскихОбъектов(ТекущийОбъект) Экспорт

	МетаданныеОбъекта = ТекущийОбъект.Метаданные();
	СписокРеквизитов = Новый СписокЗначений;
	
	Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
		
		Если Не Метаданные.КритерииОтбора.СвязанныеДокументы.Состав.Содержит(Реквизит) Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ТекущийТип Из Реквизит.Тип.Типы() Цикл
			
			МетаданныеРеквизита = Метаданные.НайтиПоТипу(ТекущийТип);
			Если МетаданныеРеквизита = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Если Не Метаданные.Документы.Содержит(МетаданныеРеквизита) Тогда
				Продолжить;
			КонецЕсли;
				
			ЗначениеРеквизита = ТекущийОбъект[Реквизит.Имя];
			Если ЗначениеЗаполнено(ЗначениеРеквизита)
				И ТипЗнч(ЗначениеРеквизита) = ТекущийТип
				И ЗначениеРеквизита <> ТекущийОбъект
				И СписокРеквизитов.НайтиПоЗначению(ЗначениеРеквизита) = Неопределено Тогда
				
				ЯвляетсяДокументом  = ОбщегоНазначения.ЭтоДокумент(МетаданныеРеквизита);
				
				Если ЯвляетсяДокументом Тогда
					СписокРеквизитов.Добавить(ЗначениеРеквизита,
						Формат(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначениеРеквизита, "Дата", Истина), "ДЛФ=DT"));
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;

	Для Каждого ТЧ Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		
		ИменаРеквизитов = "";
		СодержимоеТЧ = ТекущийОбъект[ТЧ.Имя].Выгрузить();
		Для Каждого Реквизит Из ТЧ.Реквизиты Цикл

			Если Не Метаданные.КритерииОтбора.СвязанныеДокументы.Состав.Содержит(Реквизит) Тогда
				Продолжить;
			КонецЕсли;
				
			Для Каждого ТекущийТип Из Реквизит.Тип.Типы() Цикл
				
				МетаданныеРеквизита = Метаданные.НайтиПоТипу(ТекущийТип);
				Если МетаданныеРеквизита = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				Если Не Метаданные.Документы.Содержит(МетаданныеРеквизита) Тогда
					Продолжить;
				КонецЕсли;
				
				ИменаРеквизитов = ИменаРеквизитов + ?(ИменаРеквизитов = "", "", ", ") + Реквизит.Имя;
				Прервать;
					
			КонецЦикла;
			
		КонецЦикла;

		СодержимоеТЧ.Свернуть(ИменаРеквизитов);
		Для Каждого КолонкаТЧ Из СодержимоеТЧ.Колонки Цикл

			Для Каждого СтрокаТЧ Из СодержимоеТЧ Цикл

				ЗначениеРеквизита = СтрокаТЧ[КолонкаТЧ.Имя];
				МетаданныеЗначения = Метаданные.НайтиПоТипу(ТипЗнч(ЗначениеРеквизита));
				Если МетаданныеЗначения = Неопределено Тогда
					Продолжить;
				КонецЕсли;

				Если ЗначениеРеквизита = ТекущийОбъект
					Или СписокРеквизитов.НайтиПоЗначению(ЗначениеРеквизита) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				ЯвляетсяДокументом  = ОбщегоНазначения.ЭтоДокумент(МетаданныеЗначения);
				Если Не ЯвляетсяДокументом Тогда
					Продолжить;
				КонецЕсли;
				
				СписокРеквизитов.Добавить(ЗначениеРеквизита,
						Формат(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначениеРеквизита, "Дата", Истина), "ДЛФ=DT"));
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Возврат СписокРеквизитов;
	
КонецФункции	

Функция ПолучитьВыборкуПодчиненныхДокументов(Ссылка) Экспорт	
	Таблица = ОбъектыПоКритериюОтбора(Ссылка);
	Если Таблица = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	КэшПоТипамОбъектов   = Новый Соответствие;
	КэшРеквизитовОбъекта = Новый Соответствие;

	Для Каждого СтрокаТаблицы Из Таблица Цикл
				
		МетаданныеОбъекта = СтрокаТаблицы.Ссылка.Метаданные();
		
		ЯвляетсяДокументом = ОбщегоНазначения.ЭтоДокумент(МетаданныеОбъекта);
		Если Не ЯвляетсяДокументом Тогда
			Продолжить;
		КонецЕсли;	

		ПолноеИмяОбъекта = МетаданныеОбъекта.ПолноеИмя();
		ДополнитьКэшМетаданных(МетаданныеОбъекта, ПолноеИмяОбъекта, КэшРеквизитовОбъекта);

		МассивСсылок = КэшПоТипамОбъектов[ПолноеИмяОбъекта];
		Если МассивСсылок = Неопределено Тогда

			МассивСсылок = Новый Массив;
			КэшПоТипамОбъектов.Вставить(ПолноеИмяОбъекта, МассивСсылок);

		КонецЕсли;

		МассивСсылок.Добавить(СтрокаТаблицы.Ссылка);

	КонецЦикла;
	
	Если КэшПоТипамОбъектов.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТекстЗапросаНачало = "ВЫБРАТЬ РАЗРЕШЕННЫЕ * ИЗ (";
	ТекстЗапросаКонец = ") КАК ПодчиненныеОбъекты УПОРЯДОЧИТЬ ПО ПодчиненныеОбъекты.Дата";

	Запрос = Новый Запрос;
	ТекстЗапроса = "";
	Для Каждого КлючИЗначение Из КэшПоТипамОбъектов Цикл
		
		МассивИмениОбъекта = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(КлючИЗначение.Ключ, ".");
		Если МассивИмениОбъекта.Количество() = 2 Тогда
			ИмяОбъекта = МассивИмениОбъекта[1];
		Иначе
			Продолжить;
		КонецЕсли;

		ТекстПоТипуОбъекта = "
		|" + КэшРеквизитовОбъекта[КлючИЗначение.Ключ]["Дата"] + "           КАК Дата,
		|	Ссылка,
		|" + КэшРеквизитовОбъекта[КлючИЗначение.Ключ]["Проведен"] + "       КАК Проведен,
		|" + КэшРеквизитовОбъекта[КлючИЗначение.Ключ]["СуммаДокумента"] + " КАК СуммаДокумента,
		|" + КэшРеквизитовОбъекта[КлючИЗначение.Ключ]["Валюта"] + "         КАК Валюта,
		|	Представление КАК Представление
		|ИЗ
		|	" + КлючИЗначение.Ключ + "
		|ГДЕ
		|	Ссылка В (&" + ИмяОбъекта + ")
		|	И " + КэшРеквизитовОбъекта[КлючИЗначение.Ключ]["Проведен"];
		
		// Евросиб Фролов (06.05.2022 Task №51110
		// Исключим из проверки корректировки реализаций с видом операции "Аннулирование",
		// а также авансовые счета
		Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.Сделка") Тогда
			Если ИмяОбъекта = "КорректировкаРеализации" Тогда
				ТекстПоТипуОбъекта = ТекстПоТипуОбъекта + "
							|	И ВидОперации <> ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование)";
			ИначеЕсли ИмяОбъекта = "СчетНаОплатуПокупателю" Тогда
				ТекстПоТипуОбъекта = ТекстПоТипуОбъекта + "
							|	И АвансовыйСчет = ИСТИНА";
				
			КонецЕсли;	
		КонецЕсли;
		// Евросиб Фролов)
		
		Запрос.УстановитьПараметр(ИмяОбъекта, КлючИЗначение.Значение);
				
		ТекстЗапроса = ТекстЗапроса + ?(ТекстЗапроса = "", " ВЫБРАТЬ ", " ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ ") + ТекстПоТипуОбъекта;

	КонецЦикла;

	Запрос.Текст = ТекстЗапросаНачало + ТекстЗапроса + ТекстЗапросаКонец;
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка;

КонецФункции

Функция ОбъектыПоКритериюОтбора(ЗначениеКритерияОтбора)
	
	Если Не Метаданные.КритерииОтбора.СвязанныеДокументы.Тип.СодержитТип(ТипЗнч(ЗначениеКритерияОтбора))  Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СвязанныеДокументы.Ссылка КАК Ссылка
	|ИЗ
	|	КритерийОтбора.СвязанныеДокументы(&ЗначениеКритерияОтбора) КАК СвязанныеДокументы
	|ГДЕ
	|	ИСТИНА";
	
	Если ТипЗнч(ЗначениеКритерияОтбора) = Тип("ДокументСсылка.Сделка") Тогда
		// Для сделки нужны только актуальные акцепты (добавим ниже).
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИСТИНА", "НЕ СвязанныеДокументы.Ссылка ССЫЛКА Документ.Акцепт");
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("ЗначениеКритерияОтбора", ЗначениеКритерияОтбора);
	
	ТаблицаДокументов = Запрос.Выполнить().Выгрузить();
	
	МассивАктуальныхАкцептов = Новый Массив;
	Если ТипЗнч(ЗначениеКритерияОтбора) = Тип("ДокументСсылка.Сделка") Тогда
		
		// Для сделки дополним таблицу акутальными акцептами.
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	АкцептУслуги.Ссылка.Поступление КАК Поступление
		|ИЗ
		|	Документ.Акцепт.Услуги КАК АкцептУслуги
		|ГДЕ
		|	АкцептУслуги.Ссылка.СторнируемыйАкцепт = ЗНАЧЕНИЕ(Документ.Акцепт.ПустаяСсылка)
		|	И АкцептУслуги.Ссылка.Проведен
		|	И АкцептУслуги.Сделка = &Сделка
		|	И НЕ АкцептУслуги.Ссылка В
		|				(ВЫБРАТЬ
		|					Акцепт.СторнируемыйАкцепт КАК СторнируемыйАкцепт
		|				ИЗ
		|					Документ.Акцепт КАК Акцепт
		|				ГДЕ
		|					Акцепт.Проведен)";
		
		Запрос.УстановитьПараметр("Сделка", ЗначениеКритерияОтбора);
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			АктуальныйАкцепт = Документы.Акцепт.ПолучитьАктуальныйАкцепт(Выборка.Поступление);
		    МассивАктуальныхАкцептов.Добавить(АктуальныйАкцепт);
		КонецЦикла;
		
		// Из всех актуальных акцептов получим только те, которые связаны со сделкой.
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	АкцептУслуги.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Акцепт.Услуги КАК АкцептУслуги
		|ГДЕ
		|	АкцептУслуги.Ссылка В(&МассивАкцептов)
		|	И АкцептУслуги.Сделка = &Сделка
		|
		|УПОРЯДОЧИТЬ ПО
		|	АкцептУслуги.Ссылка.Дата";
		
		ЗапросСвязанныхАкцептов = Новый Запрос;
		ЗапросСвязанныхАкцептов.Текст = ТекстЗапроса;
		ЗапросСвязанныхАкцептов.УстановитьПараметр("МассивАкцептов", МассивАктуальныхАкцептов);
		ЗапросСвязанныхАкцептов.УстановитьПараметр("Сделка", ЗначениеКритерияОтбора);
		
		ВыборкаСвязанныеАкцепты = ЗапросСвязанныхАкцептов.Выполнить().Выбрать();
		Пока ВыборкаСвязанныеАкцепты.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(ТаблицаДокументов.Добавить(), ВыборкаСвязанныеАкцепты);
		КонецЦикла;	
		
	КонецЕсли;
		
	Возврат ТаблицаДокументов;
	
КонецФункции

Процедура ДополнитьКэшМетаданных(МетаданныеОбъекта, ИмяОбъекта, КэшРеквизитовОбъекта)

	РеквизитыДокумента = КэшРеквизитовОбъекта[ИмяОбъекта];
	Если РеквизитыДокумента = Неопределено Тогда
		
		РеквизитыДокумента = Новый Соответствие;
			
		Если МетаданныеОбъекта.Реквизиты.Найти("СуммаДокумента") <> Неопределено Тогда
			РеквизитыДокумента.Вставить("СуммаДокумента", "СуммаДокумента");
		ИначеЕсли МетаданныеОбъекта.Реквизиты.Найти("СуммаАкцепта") <> Неопределено Тогда
			РеквизитыДокумента.Вставить("СуммаДокумента", "СуммаАкцепта");
		Иначе
			РеквизитыДокумента.Вставить("СуммаДокумента", "NULL");
		КонецЕсли;
						
		Если МетаданныеОбъекта.Реквизиты.Найти("Валюта") <> Неопределено Тогда
			РеквизитыДокумента.Вставить("Валюта", "Валюта");
		Иначе
			РеквизитыДокумента.Вставить("Валюта", "NULL");
		КонецЕсли;
		
		РеквизитыДокумента.Вставить("Проведен", "Проведен");
		РеквизитыДокумента.Вставить("Дата", "Дата");

		КэшРеквизитовОбъекта.Вставить(ИмяОбъекта, РеквизитыДокумента);
		
	КонецЕсли;
	
КонецПроцедуры
