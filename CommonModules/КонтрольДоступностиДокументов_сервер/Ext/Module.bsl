Функция ПолучитьДанныеБлокировкиДокумента(ДокументСсылка) Экспорт
	
	Результат = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПротоколОбменов.Объект КАК Объект
	               |ИЗ
	               |	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	               |ГДЕ
	               |	ПротоколОбменов.Объект = &Документ
	               |	И ВЫБОР
	               |			КОГДА ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(перечисление.узлыобмена.Диадок)
	               |				ТОГДА ПротоколОбменов.ДействиеПриОбмене <> ЗНАЧЕНИЕ(перечисление.ДействияприОбмене.ЗагрузкаДанных)
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ";
	Запрос.УстановитьПараметр("Документ", ДокументСсылка);
	ЗапросВыполнить = Запрос.Выполнить();
	КолонкиЗапроса = ЗапросВыполнить.Колонки;
	Ответ = ЗапросВыполнить.Выбрать();
	Если Ответ.Следующий() Тогда
		
		Для каждого Колонка из КолонкиЗапроса Цикл
			
			Результат.Вставить(Колонка.Имя, Ответ[Колонка.Имя]);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументЗаблокирован(ДокументСсылка) Экспорт
	
	Результат = Ложь;
	
	Если Строка(ДокументСсылка) <> "" Тогда
		СтатусДокумента = КонтрольДоступностиДокументов_сервер.ПолучитьДанныеБлокировкиДокумента(ДокументСсылка);
		Если СтатусДокумента.Количество() > 0 Тогда Результат = Истина; КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура КонтрольДоступностиДокументовПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если Отказ Или Источник.ОбменДанными.Загрузка Или ПривилегированныйРежим() Тогда
		Возврат;
	КонецЕсли;
	
	//Евросиб Каблов 05.02.2021 ( Проведение непроведенного / отмена проведения проведенного
	ЭтоИСФ = ТипЗнч(Источник) = Тип("ДокументОбъект.РеализацияТоваровУслуг") 
				Или ТипЗнч(Источник) = Тип("ДокументОбъект.ОтчетКомиссионераОПродажах")
				//Или ТипЗнч(Источник) = Тип("ДокументОбъект.СчетНаОплатуПокупателю") //Евросиб Каблов 23.03.2021 Ticket#0227211 
				Или ТипЗнч(Источник) = Тип("ДокументОбъект.ОтчетКомитентуОПродажах")
				Или ТипЗнч(Источник) = Тип("ДокументОбъект.КорректировкаРеализации");
				
	Если ЭтоИСФ Тогда
		
		МетаданныеДокумента = Источник.Метаданные();
		РеквизитыДокумента = МетаданныеДокумента.Реквизиты;
		
		Если РеквизитыДокумента.Найти("ПериодВО") <> Неопределено Тогда
			
			Если (Не Источник.Проведен И РежимЗаписи = РежимЗаписиДокумента.Проведение
					Или РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения) Тогда
			
				РазрешеноРедактированиеИСФ = ПроверитьДоступностьРоли("dc_РазрешитьРедактированиеИСФ");
				
				Если Не РазрешеноРедактированиеИСФ Тогда
					//Евросиб Каблов 09.04.2025 ( #105407
					//ДокументВЗакрытомПериоде = ДатаПопадаетВЗакрытыйПериодВыполненныхОбъемов(Источник.ПериодВО, Источник.Организация);
					ДокументВЗакрытомПериоде = ДатаПопадаетВЗакрытыйПериодДоходов(Источник.ПериодВО, Источник.Организация);
					//Евросиб Каблов 09.04.2025 )
					Если ДокументВЗакрытомПериоде Тогда
						ТекстСообщения = СтрШаблон("Период ВО %1 закрыт! Проведение/отмена проведения документа %2 №%3 от %4 запрещены.", Формат(Источник.ПериодВО, "ДФ='MMMM yyyy'"), МетаданныеДокумента.Синоним, Источник.Номер, Источник.Дата);
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
						Возврат;
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
			
			Если Источник.Проведен Тогда
				ПериодВО = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка, "ПериодВО");
				//Евросиб Каблов 09.04.2025 ( #105407
				//ДокументВЗакрытомПериоде = ДатаПопадаетВЗакрытыйПериодВыполненныхОбъемов(ПериодВО, Источник.Организация);
				ДокументВЗакрытомПериоде = ДатаПопадаетВЗакрытыйПериодДоходов(ПериодВО, Источник.Организация);
				//Евросиб Каблов 09.04.2025 )
				Если ДокументВЗакрытомПериоде И Источник.ПериодВО <> ПериодВО Тогда
					ТекстСообщения = СтрШаблон("Период ВО %1 закрыт! Его изменение в документе %2 №%3 от %4 запрещено.", Формат(ПериодВО, "ДФ='MMMM yyyy'"), МетаданныеДокумента.Синоним, Источник.Номер, Источник.Дата);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
					Возврат;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;	
	КонецЕсли;
		
	Если Источник.ДополнительныеСвойства.Свойство("ИзмененыТолькоРазрешенныеПоля") Тогда
		Возврат;
	КонецЕсли;
	//Евросиб Каблов 05.02.2021 )
	
	ДополнительныеПараметры = Новый Структура;
	
	РеквизитВыставлен = Источник.Метаданные().Реквизиты.Найти("Выставлен");
	Если РеквизитВыставлен <> Неопределено Тогда
		
		ЕстьДоступСниматьПризнак = РольДоступна("dc_РазрешитьРедактированиеИСФ") Или РольДоступна("ПолныеПрава")
			Или РольДоступна("dc_РедактированиеДатыДокумента");// Евросиб US 89967 TA 91565 Рыбьяков К.А. 24.10.2024 (( добавил роль dc_РедактированиеДатыДокумента
		
		РазрешенаЗаписьВыставленного = Неопределено;
		Если Не Источник.ДополнительныеСвойства.Свойство("РазрешенаЗаписьВыставленного", РазрешенаЗаписьВыставленного) Тогда
			РазрешенаЗаписьВыставленного = Ложь;
		КонецЕсли;
		
		//Евросиб Каблов 18.11.2020 (
		//Если Источник.Выставлен И (ЕстьДоступСниматьПризнак Или РазрешенаЗаписьВыставленного) Тогда
		Если ЕстьДоступСниматьПризнак Или РазрешенаЗаписьВыставленного Тогда
		//Евросиб Каблов 18.11.2020 )
			ДополнительныеПараметры.Вставить("РазрешенаЗаписьВыставленного", Истина);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Источник.ДополнительныеСвойства.Свойство("РазрешеноПроведениеВОбходБлокировок") Тогда
		ДополнительныеПараметры.Вставить("РазрешеноПроведениеВОбходБлокировок", Истина);
	КонецЕсли;
	
	ДанныеОБлокировке = КонтрольДоступностиДокументов_сервер.ПолучитьДанныеОБлокировке(Источник.Ссылка, ДополнительныеПараметры);	
	Если ДанныеОБлокировке.Заблокирован Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(ДанныеОБлокировке.ОписаниеБлокировки);
	КонецЕсли;
	
КонецПроцедуры

//Евросиб Каблов 18.09.2020
Процедура ПроверитьДоступностьПолейДляИзменения(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	//Евросиб Каблов 02.12.2020 ( Далее есть проверки, которые должны работать и для полных прав (например по Периоду ВО)
	//Если Отказ Или Источник.ЭтоНовый() Или ПривилегированныйРежим() Или РольДоступна("ПолныеПрава") Тогда
	Если Отказ Или Источник.ЭтоНовый() Или ПривилегированныйРежим() Тогда
	//Евросиб Каблов 02.12.2020 )
		Возврат;
	КонецЕсли;
	
	Если Источник.ДополнительныеСвойства.Свойство("ВызванИзЗаписиПС") Тогда
		Возврат;
	КонецЕсли;
	
	ТипЗначенияИсточника = ТипЗнч(Источник);
	
	ПрограммноеИзменение = Источник.ДополнительныеСвойства.Свойство("ПрограммноеИзменение");
		
	СтруктураБлокировки = ПолучитьБлокируемыеПоля(Источник.Ссылка, ПрограммноеИзменение);
	ИзмененныеПоля = Новый Массив;
	ПроверитьИзмененияРеквизитовОбъекта(Источник, Отказ, СтруктураБлокировки.БлокироватьВсеПоля, СтруктураБлокировки.ПоляИсключения, ИзмененныеПоля);
	
	Если ИзмененныеПоля.Количество() > 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запрещено изменение полей: " + СтрСоединить(ИзмененныеПоля, ", "));
	//Евросиб Каблов 02.12.2020 ( Ticket#0215459
	Иначе
	    Источник.ДополнительныеСвойства.Вставить("ИзмененыТолькоРазрешенныеПоля", Истина);
		//Евросиб Дубская 27.10.2022 ( Ticket#0287875
		Если СтруктураБлокировки.Свойство("ИзменитьСФ") Тогда
			ИзменитьСФ = СтруктураБлокировки.ИзменитьСФ;
		Иначе
			ИзменитьСФ = Ложь;
		КонецЕсли;
		//Евросиб Дубская 27.10.2022 )
		Если (ТипЗначенияИсточника = Тип("ДокументОбъект.РеализацияТоваровУслуг")
				Или ТипЗначенияИсточника = Тип("ДокументОбъект.ОтчетКомиссионераОПродажах"))   
				//Евросиб Дубская 27.10.2022 ( Ticket#0287875
				//И СтруктураБлокировки.Заблокирован Тогда	
				И СтруктураБлокировки.Заблокирован 
				И НЕ ИзменитьСФ
				Тогда
				//Евросиб Дубская 27.10.2022 )
			Источник.ДополнительныеСвойства.Вставить("ЗапретитьЗаписыватьСчетФактуру", Истина);
		КонецЕсли;
		
	КонецЕсли;
	//Евросиб Каблов 02.12.2020
	
//Евросиб Гудкова( 18.10.2020 Ticket№ 0210719
	//Евросиб Каблов 05.07.2021 ( Task 36231
	//Если ТипЗнч(Источник) = Тип("ДокументОбъект.Калькуляция") И Не РольДоступна("ПолныеПрава") Тогда 
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.Калькуляция") И Не ПроверитьДоступностьРоли("dc_РазрешитьРедактированиеКалькуляций") Тогда
	//Евросиб Каблов 05.07.2021 )
		ПСЦ = Документы.Калькуляция.КалькуляцияНаходитсяВСогласованномПСЦ(Источник.Ссылка);
		Если ПСЦ <> неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данная калькуляция зафиксирована ПСЦ " + ПСЦ,,,,Отказ);
		КонецЕсли; 
	КонецЕсли;
// Евросиб Гудкова) 	
			
КонецПроцедуры

//Евросиб Каблов 18.09.2020
Функция ПолучитьБлокируемыеПоля(Ссылка, ПрограммноеИзменение = Ложь, БлокировкаЭлементовФормы = Ложь, Объект = Неопределено) Экспорт
	
	СтруктураБлокировки = Новый Структура("Заблокирован, ОписаниеБлокировки, БлокироватьВсеПоля, ПоляИсключения", Ложь, "", Ложь, Новый Массив);  
	//Евросиб Дубская 03.11.2022 ( Ticket#0287875
	СтруктураБлокировки.Вставить("ИзменитьСФ", Ложь);
	//Евросиб Дубская 03.11.2022 )
	
	//Евросиб Каблов 02.12.2020 ( Далее есть проверки, которые должны работать и для полных прав (например по Периоду ВО)
	
	// SIV 04-12-20 в резултате отключения этой проверки у нас заблокировалось редактирование Состояний в ПСЦ.
	// прошу более внимательно отнестись к доступу для администраторов. сейчас мы не сможем делать свою работу без доступа к данным.
	
	//Евросиб Каблов 04.12.2020 Перенёс проверку ниже, что бы работала именно для ПСЦ, как для калькуляций
	//Если РольДоступна("ПолныеПрава") Тогда
	//	Возврат СтруктураБлокировки;
	//КонецЕсли;
	//Евросиб Каблов 02.12.2020 )
	
	ДействующиеБлокировки = Новый Массив;
	УсловияБлокировки = Новый Структура;   
	
	//ДИТ ДИТ, Беляев СЮ, ТА44280, 27-12-2021, ++
	ДоступностиЭлементовПоВидуКорректировки  = Новый Структура;
	//ДИТ ДИТ, Беляев СЮ, ТА44280, 27-12-2021, --
	
	//Евросиб Каблов 07.07.2021 ( Ticket#0236692 Добавлен запрет редактирования поля документа Номер
	//Если Не РольДоступна("ПолныеПрава") Тогда
	//	УсловиеБлокировки = Новый Структура;
	//	УсловиеБлокировки.Вставить("БлокироватьВсеПоля", Ложь);
	//	
	//	ПоляИсключения = Новый Массив;
	//	ПоляИсключения.Добавить("Номер");
	//	УсловиеБлокировки.Вставить("ПоляИсключения", ПоляИсключения);
	//	ДействующиеБлокировки.Добавить(УсловиеБлокировки);
	//КонецЕсли;
	//Евросиб Каблов 07.07.2021 )   
	
	//ДИТ, Беляев СЮ, ТА44280, 27-12-2021, ++      
	ПоляОбязательнойБлокировки = Новый Массив;
	//(1) Запрет редактирования поля документа Номер
	Если Не РольДоступна("ПолныеПрава") Тогда
		ПоляОбязательнойБлокировки.Добавить("Номер");
	КонецЕсли;   
	//(2) Запрет редактирования реквизитов СчетФактураВыданный
	#Область СчетФактураВыданный
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ДоступностиЭлементовПоВидуКорректировки = ПолучитьДоступностьЭлементовПоВидуКорректировкиРеализации(Ссылка);    
		Если ДоступностиЭлементовПоВидуКорректировки.ВыполнитьБлокировкуРеквизитов Тогда   
			ПоляОбязательнойБлокировки.Добавить("ПереченьГТДкИСФ");
			ПоляОбязательнойБлокировки.Добавить("УдалитьВключатьВОтчетДляФНС");
		Иначе   
			//++ДИТ_Коробов_Task 46790_24.02.22
			//Проверить корневую фактуру на аннулирование
			ДокКорректировка = Ссылка.ДокументОснование;
			ВключитьБлокировку = 0;
			Пока Истина Цикл
				Если НЕ ЗначениеЗаполнено(ДокКорректировка) Тогда
					Прервать;
				КонецЕсли;
				Если ТипЗнч(ДокКорректировка)<>Тип("ДокументСсылка.КорректировкаРеализации") Тогда
					ДокИСФ = БухгалтерскийУчетОбщиеПроцедурыСервер.НайтиПодчиненныйСчетФактуру(ДокКорректировка);
					Если НЕ ЗначениеЗаполнено(ДокИСФ) Тогда 
						Прервать;
					КонецЕсли;
					Если Ссылка <> ДокИСФ Тогда 
						ПроверитьПоВидуКорректировки = ПолучитьДоступностьЭлементовПоВидуКорректировкиРеализации(ДокИСФ);
						Если (Найти(ПроверитьПоВидуКорректировки.ОписаниеПричиныБлокировкиРеквизитов, "аннулирован") > 0) Тогда
							ВключитьБлокировку = ВключитьБлокировку + 1;
						КонецЕсли;
					КонецЕсли;    
					Прервать;
				Иначе
					Если ДокКорректировка.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение Тогда 
						ДокИСФ = БухгалтерскийУчетОбщиеПроцедурыСервер.НайтиПодчиненныйСчетФактуру(ДокКорректировка.ДокументРеализации);
						Если ЗначениеЗаполнено(ДокИСФ) Тогда 
							ПроверитьПоВидуКорректировки = ПолучитьДоступностьЭлементовПоВидуКорректировкиРеализации(ДокИСФ);
							Если (Найти(ПроверитьПоВидуКорректировки.ОписаниеПричиныБлокировкиРеквизитов, "аннулирован") > 0) Тогда
								ВключитьБлокировку = ВключитьБлокировку + 1;
								Прервать;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли; 
				КонецЕсли;
				ДокКорректировка = ДокКорректировка.ДокументРеализации;
			КонецЦикла;					
			Если (ВключитьБлокировку > 0) Тогда
				ДоступностиЭлементовПоВидуКорректировки = ПроверитьПоВидуКорректировки;
				ПоляОбязательнойБлокировки.Добавить("ПереченьГТДкИСФ");
				ПоляОбязательнойБлокировки.Добавить("УдалитьВключатьВОтчетДляФНС");
			КонецЕсли;
			//--ДИТ_Коробов_Task 46790_24.02.22
		КонецЕсли;
	КонецЕсли;
	#КонецОбласти
	
	////ДИТ, Беляев СЮ, BUG48279, 05-04-2022, начало - блок перенесен вниз
	//Если ПоляОбязательнойБлокировки.Количество()>0 Тогда
	//	УсловиеБлокировки = Новый Структура;
	//	УсловиеБлокировки.Вставить("БлокироватьВсеПоля", Ложь);	
	//	УсловиеБлокировки.Вставить("ПоляИсключения", ПоляОбязательнойБлокировки);
	//	ДействующиеБлокировки.Добавить(УсловиеБлокировки);
	//КонецЕсли; 
	//ДИТ, Беляев СЮ, BUG48279, 05-04-2022, конец - блок перенесен вниз
	//ДИТ, Беляев СЮ, ТА44280, 27-12-2021, --
