	#КонецОбласти
	
	Иначе
	//--Евросиб Дудоров С.В. USER STORY 57543 30.01.2023  

		//ДИТ, Беляев СЮ, BUG48279, 05-04-2022, начало
		Если НЕ РольДоступна("ПолныеПрава") Тогда
			ПоляОбязательнойБлокировки.Добавить("ФормаДокументКорректировкаРеализацииСоздатьНаОсновании");
			ПоляОбязательнойБлокировки.Добавить("ФормаДокументРеализацияТоваровУслугСоздатьНаОсновании");
		КонецЕсли; 
		//ДИТ, Беляев СЮ, BUG48279, 05-04-2022, конец
		
		//ДИТ, Беляев СЮ, BUG48279, 05-04-2022, начало
