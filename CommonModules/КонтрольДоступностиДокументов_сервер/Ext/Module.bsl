Функция ПолучитьДоступностьЭлементовПоВидуКорректировкиРеализации(Ссылка)    
	РезультатСтруктура = Новый Структура;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СчетФактураВыданныйДокументыОснования.ДокументОснование КАК ДокументОснование
		|ПОМЕСТИТЬ ТаблицаДокументовОснования
		|ИЗ
		|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
		|ГДЕ
		|	СчетФактураВыданныйДокументыОснования.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИсторияКорректировокРеализацийСрезПоследних.Регистратор КАК Регистратор,
		|	ИсторияКорректировокРеализацийСрезПоследних.ВидОперации КАК ВидОперации
		|ИЗ
		|	РегистрСведений.ИсторияКорректировокРеализаций.СрезПоследних(
		|			,
		|			КорректируемыйДокумент В
		|				(ВЫБРАТЬ
		|					ТаблицаДокументовОснования.ДокументОснование
		|				ИЗ
		|					ТаблицаДокументовОснования КАК ТаблицаДокументовОснования)) КАК ИсторияКорректировокРеализацийСрезПоследних";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);	
	РезультатЗапроса = Запрос.Выполнить();	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ФлагВыполнитьБлокировкуРеквизитов = Ложь;  
	СтрокаОписанияПричины = "";            
	СтрокаИнформированияОПеречнеГТДиИСФ = "";
	Если Ссылка.СуммаНДСДокумента = 0 Тогда
		СтрокаИнформированияОПеречнеГТДиИСФ = " Внесение изменений в перечень ГТД и ИСФ заблокировано!";
	КонецЕсли;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки Тогда
			ФлагВыполнитьБлокировкуРеквизитов = Истина;                                                                            
			СтрокаОписанияПричины = "Внесены исправления в первичный документ. "+ВыборкаДетальныеЗаписи.Регистратор+"."+СтрокаИнформированияОПеречнеГТДиИСФ;
		ИначеЕсли ВыборкаДетальныеЗаписи.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование Тогда
			ФлагВыполнитьБлокировкуРеквизитов = Истина;  
			СтрокаОписанияПричины = "Документ аннулирован. "+ВыборкаДетальныеЗаписи.Регистратор+"."+СтрокаИнформированияОПеречнеГТДиИСФ;
		КонецЕсли;
	КонецЦикла;                              
	РезультатСтруктура.Вставить("ВыполнитьБлокировкуРеквизитов", ФлагВыполнитьБлокировкуРеквизитов);
	РезультатСтруктура.Вставить("ОписаниеПричиныБлокировкиРеквизитов", СтрокаОписанияПричины);	
	Возврат РезультатСтруктура;	
КонецФункции 
