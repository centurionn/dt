		КонецЕсли;
		
	КонецЕсли;
	//Евросиб Каблов 29.10.2024 )
#КонецОбласти

    //Евросиб СубботинВ #89527 30.10.2024 Начало 
    	#Область РеестрПлатежей
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.РеестрПлатежей") Тогда

		Если РольДоступна("ПолныеПрава") Тогда
			Возврат СтруктураБлокировки;
		КонецЕсли;
		
		Если РольДоступна("dc_СогласованиеРеестраПлатежей") 
			или РольДоступна("dc_УтверждениеРеестраПлатежей") Тогда 
			УсловиеБлокировки = Новый Структура;
			УсловиеБлокировки.Вставить("БлокироватьВсеПоля", Истина);
			
			ПоляИсключения = Новый Массив;
			ПоляИсключения.Добавить("ФормаПерейтиКСогласованию");
			ПоляИсключения.Добавить("Комментарий");
			ПоляИсключения.Добавить("ФормаЗаписать");
			ПоляИсключения.Добавить("ФормаПровести");
			ПоляИсключения.Добавить("ТекущийИсполнитель_Статус");
			УсловиеБлокировки.Вставить("ПоляИсключения", ПоляИсключения);		
			ДействующиеБлокировки.Добавить(УсловиеБлокировки);
		КонецЕсли;
    КонецЕсли;
	#КонецОбласти 
	//Евросиб СубботинВ #89527 30.10.2024 Конец 
	
	//Проверка условий блокировки
	Если УсловияБлокировки.Свойство("ЗарегистрированВОбмене") Или УсловияБлокировки.Свойство("Выставлен") Или УсловияБлокировки.Свойство("ВЗакрытомПериоде") Тогда
		ДанныеОБлокировке = ПолучитьДанныеОБлокировке(Ссылка);
		ЗаполнитьЗначенияСвойств(СтруктураБлокировки, ДанныеОБлокировке, "Заблокирован, ОписаниеБлокировки");
		//Евросиб Дубская 03.11.2022 ( Ticket#0287875   
		Если ДанныеОБлокировке.Свойство("ИзменитьСФ") Тогда
			СтруктураБлокировки.ИзменитьСФ = ДанныеОБлокировке.ИзменитьСФ;
		КонецЕсли;
		//Евросиб Дубская 03.11.2022 )
 		Для Каждого ПричинаБлокировки Из ДанныеОБлокировке.ПричиныБлокировки Цикл
			Блокировка = Неопределено;
			Если УсловияБлокировки.Свойство(ПричинаБлокировки, Блокировка) Тогда
				ДействующиеБлокировки.Добавить(Блокировка);
			КонецЕсли;
		КонецЦикла; 
		//ДИТ, Беляев СЮ, ТА44280, 27-12-2021, ++     
		Если ДоступностиЭлементовПоВидуКорректировки.Свойство("ОписаниеПричиныБлокировкиРеквизитов") Тогда
			СтруктураБлокировки.ОписаниеБлокировки = СтруктураБлокировки.ОписаниеБлокировки +" "+ДоступностиЭлементовПоВидуКорректировки.ОписаниеПричиныБлокировкиРеквизитов; 
		КонецЕсли;
		//ДИТ, Беляев СЮ, ТА44280, 27-12-2021, --
	КонецЕсли;
	
	ПричинаБлокировки = "НетПолныхПрав";
	Если УсловияБлокировки.Свойство(ПричинаБлокировки) Тогда
		Если Не РольДоступна("ПолныеПрава") И Не ПрограммноеИзменение Тогда
			Блокировка = Неопределено;
			Если УсловияБлокировки.Свойство(ПричинаБлокировки, Блокировка) Тогда
				ДействующиеБлокировки.Добавить(Блокировка);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ДействующиеБлокировки.Количество() = 0 Тогда
		Возврат СтруктураБлокировки;
	КонецЕсли;
	
	//Определение списка блокируемых полей
	
	ПоляУсловийБлокировки = Новый Массив;
	Для Каждого Блокировка Из ДействующиеБлокировки Цикл
		Для Каждого Поле Из Блокировка.ПоляИсключения Цикл
			Если ПоляУсловийБлокировки.Найти(Поле) = Неопределено Тогда
				ПоляУсловийБлокировки.Добавить(Поле);
			КонецЕсли;
		КонецЦикла;			
	КонецЦикла;
	
	ТаблицаБлокируемыхПолей = Новый ТаблицаЗначений;
	СоответствиеПолейКолонкам = Новый Соответствие;
	ИменаКолонокТаблицы = Новый Массив;
	ТипЗначенияКолонки = Новый ОписаниеТипов("Число");	
	Для Каждого Поле Из ПоляУсловийБлокировки Цикл
		ИмяКолонки = СтрЗаменить(Поле, ".", "_");
		СоответствиеПолейКолонкам.Вставить(Поле, ИмяКолонки);
		ИменаКолонокТаблицы.Добавить(ИмяКолонки);
		ТаблицаБлокируемыхПолей.Колонки.Добавить(ИмяКолонки, ТипЗначенияКолонки);
	КонецЦикла;
	
	БлокироватьВсеПоля = Ложь;
	Для Каждого Блокировка Из ДействующиеБлокировки Цикл
		
		Если Блокировка.БлокироватьВсеПоля Тогда
			ЗначениеДляВсех = 1;
			ЗначениеДляИсключений = 0;
			БлокироватьВсеПоля = Истина;
		Иначе
			ЗначениеДляВсех = 0;
			ЗначениеДляИсключений = 1;
		КонецЕсли;
		
		СтрокаТаблицы = ТаблицаБлокируемыхПолей.Добавить();			
		Для Каждого Поле Из ПоляУсловийБлокировки Цикл
			ИмяКолонки = СоответствиеПолейКолонкам.Получить(Поле);
			Если Блокировка.ПоляИсключения.Найти(Поле) = Неопределено Тогда
				СтрокаТаблицы[ИмяКолонки] = ЗначениеДляВсех;
			Иначе
				СтрокаТаблицы[ИмяКолонки] = ЗначениеДляИсключений;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	//Поля, по которым значение > 0, блокируются.
	//Поля, по которым значение = 0, не блокируются.
	КолонкиТаблицы = СтрСоединить(ИменаКолонокТаблицы, ",");
	ТаблицаБлокируемыхПолей.Свернуть(, КолонкиТаблицы);
	СтрокаТаблицы = ТаблицаБлокируемыхПолей[0];
	
	ПоляИсключения = Новый Массив;
	Если БлокироватьВсеПоля Тогда
		Для Каждого Поле Из ПоляУсловийБлокировки Цикл
			ИмяКолонки = СоответствиеПолейКолонкам.Получить(Поле);
 			Значение = СтрокаТаблицы[ИмяКолонки];
			Если Значение = 0 Тогда
				ПоляИсключения.Добавить(Поле);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого Поле Из ПоляУсловийБлокировки Цикл
			ИмяКолонки = СоответствиеПолейКолонкам.Получить(Поле);
			Значение = СтрокаТаблицы[ИмяКолонки];
			Если Значение > 0 Тогда
				ПоляИсключения.Добавить(Поле);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	СтруктураБлокировки.БлокироватьВсеПоля = БлокироватьВсеПоля;
	СтруктураБлокировки.ПоляИсключения = ПоляИсключения;
	
	Возврат СтруктураБлокировки;
	
КонецФункции

Функция ПолучитьОписаниеБлокировки() Экспорт
	
	Возврат "Документ зарегистрирован в обмене с внешней системой и заблокирован от изменения! Вы не сможете изменить этот документ!";
	
КонецФункции

//Евросиб Каблов 11.07.2020 TASK 23506
Функция ПолучитьДанныеОБлокировке(ДокументСсылка, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ДополнительныеПараметры = Неопределено Тогда
		ДополнительныеПараметры = Новый Структура;
	КонецЕсли;
	
	Результат = Новый Структура("Заблокирован, ОписаниеБлокировки, ПричиныБлокировки", Ложь, "", Новый Массив);
	НаименованияПричинБлокировки = Новый Массив;	
	
	СписокТиповНеПроверяемыхОбъектов = Новый Массив; // SIV 20-09-24 (;,;)
	СписокТиповНеПроверяемыхОбъектов.Добавить(Тип("ДокументСсылка.СписаниеСРасчетногоСчета"));
	СписокТиповНеПроверяемыхОбъектов.Добавить(Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет"));
	
	//Евросиб Каблов 09.04.2025 ( #105407
	//Если СписокТиповНеПроверяемыхОбъектов.Найти(ТипЗнч(ДокументСсылка)) <> неопределено Тогда Возврат Результат; КонецЕсли;
	ТипДокумента = ТипЗнч(ДокументСсылка);
	Если СписокТиповНеПроверяемыхОбъектов.Найти(ТипДокумента) <> неопределено Тогда Возврат Результат; КонецЕсли;
	//Евросиб Каблов 09.04.2025 )
	
	Если ЗначениеЗаполнено(ДокументСсылка) Тогда
		
		ПометкаУдаления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ПометкаУдаления");
		Если ПометкаУдаления Тогда
			Возврат Результат;
		КонецЕсли;
		
		//Проверка доступности документа по периоду
		Если ТипДокумента <> Тип("ДокументСсылка.СчетНаОплатуПокупателю") Тогда
			РеквизитыДокумента = ДокументСсылка.Метаданные().Реквизиты;
			Если РеквизитыДокумента.Найти("ПериодВО") <> Неопределено Тогда			
				ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Проведен, ПериодВО, Организация");
				Если ЗначенияРеквизитов.Проведен Тогда
					//Евросиб Каблов 09.04.2025 ( #105407
					//ДокументВЗакрытомПериоде = ДатаПопадаетВЗакрытыйПериодВыполненныхОбъемов(ЗначенияРеквизитов.ПериодВО, ЗначенияРеквизитов.Организация);
					Если ТипДокумента = Тип("ДокументСсылка.РеализацияТоваровУслуг")
							Или ТипДокумента = Тип("ДокументСсылка.КорректировкаРеализации")
							Или ТипДокумента = Тип("ДокументСсылка.ОтчетКомитентуОПродажах")
							Или ТипДокумента = Тип("ДокументСсылка.ОтчетКомиссионераОПродажах")
							Или ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
						ДокументВЗакрытомПериоде = ДатаПопадаетВЗакрытыйПериодДоходов(ЗначенияРеквизитов.ПериодВО, ЗначенияРеквизитов.Организация);
					Иначе
						ДокументВЗакрытомПериоде = ДатаПопадаетВЗакрытыйПериодВыполненныхОбъемов(ЗначенияРеквизитов.ПериодВО, ЗначенияРеквизитов.Организация);
					КонецЕсли;
					//Евросиб Каблов 09.04.2025 )
					Если ДокументВЗакрытомПериоде Тогда
						Результат.ПричиныБлокировки.Добавить("ВЗакрытомПериоде");
						НаименованияПричинБлокировки.Добавить("в закрытом периоде");
					КонецЕсли;
 				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	
		//Проверка регистрации в обмене с внешней системой
//		Если Не РольДоступна("ПолныеПрава") Тогда
			СтатусДокумента = КонтрольДоступностиДокументов_сервер.ПолучитьДанныеБлокировкиДокумента(ДокументСсылка);
			Если СтатусДокумента.Количество() > 0 Тогда
				Результат.ПричиныБлокировки.Добавить("ЗарегистрированВОбмене");
				НаименованияПричинБлокировки.Добавить("зарегистрирован в обмене с внешней системой");
			КонецЕсли;
//		КонецЕсли;

		//Признак "Выставлен"		
		РазрешенаЗаписьВыставленного = Ложь;
		Если Не ДополнительныеПараметры.Свойство("РазрешенаЗаписьВыставленного", РазрешенаЗаписьВыставленного) Тогда
			РазрешенаЗаписьВыставленного = Ложь;
		КонецЕсли;
		
		Если Не РазрешенаЗаписьВыставленного Тогда
		
			ТипДокумента = ТипЗнч(ДокументСсылка);
			Если ТипДокумента = Тип("ДокументСсылка.РеализацияТоваровУслуг")
					Или ТипДокумента = Тип("ДокументСсылка.КорректировкаРеализации")
					Или ТипДокумента = Тип("ДокументСсылка.ОтчетКомитентуОПродажах")
//Евросиб Гудкова( 05.11.2020 Ticket№ 0209113 Или ТипДокумента = Тип("ДокументСсылка.СчетНаОплатуПокупателю")
					Или ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
					
				Выставлен = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Выставлен");  
				
				//Евросиб Дубская 27.10.2022 ( Ticket#0287875	
				Если ТипДокумента = Тип("ДокументСсылка.РеализацияТоваровУслуг")   
					И Документы.РеализацияТоваровУслуг.ЕстьПривязанныеОплаты(ДокументСсылка) Тогда  
					
					Результат.ПричиныБлокировки.Добавить("ЕстьПривязанныеОплаты");
					НаименованияПричинБлокировки.Добавить("имеет привязанные оплаты"); 
					Результат.Вставить("ИзменитьСФ", Истина);
				КонецЕсли;
				//Евросиб Дубская 27.10.2022 )	
				
				Если Выставлен Тогда
					Результат.ПричиныБлокировки.Добавить("Выставлен");
					НаименованияПричинБлокировки.Добавить("выставлен клиенту");
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЗаявкаНаОплату") Тогда
		НаименованияПричинБлокировки.Добавить("не в статусе «Подготовлен»");
	КонецЕсли;
	
	Если НаименованияПричинБлокировки.Количество() > 0 И НЕ ДополнительныеПараметры.Свойство("РазрешеноПроведениеВОбходБлокировок") Тогда
		Результат.Заблокирован = Истина;
		ПричиныБлокировкиТекст = СтрСоединить(НаименованияПричинБлокировки, ", ");
