&НаСервере
функция ПоискЕТСНГНаСервере(ЕТСНГ)
	
	ЕТСНГСсылка = Справочники.э_ЕТСНГ.ПустаяСсылка();
	
	Если НЕ ЗначениеЗаполнено(ЕТСНГ) Тогда
		Возврат ЕТСНГСсылка;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	э_ЕТСНГ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.э_ЕТСНГ КАК э_ЕТСНГ
		|ГДЕ
		|	э_ЕТСНГ.Код ПОДОБНО &ЕТСНГ + ""%""
		|	И НЕ э_ЕТСНГ.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ЕТСНГ", ЕТСНГ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	//ДИТ Шевченко А.В. 60929 21.12.22 -начало
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Грузы.ЕТСНГ КАК ЕТСНГ,
		|	Грузы.Наименование КАК Наименование,
		|	Грузы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Грузы КАК Грузы
		|ГДЕ
		|	Грузы.ЕТСНГ ПОДОБНО &ЕТСНГ + ""%""
		|	И НЕ Грузы.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ЕТСНГ", ЕТСНГ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат СоздатьЭ_ЕТСНГ(ВыборкаДетальныеЗаписи.Ссылка,ВыборкаДетальныеЗаписи.ЕТСНГ,ВыборкаДетальныеЗаписи.Наименование);	
	КонецЦикла;
	//ДИТ Шевченко А.В. 60929 21.12.22 -конец
	
	Возврат ЕТСНГСсылка;
КонецФункции

&НаСервере
Функция СоздатьЭ_ЕТСНГ(Груз,ЕТСНГ,Наименование) //ДИТ Шевченко А.В. 60929 21.12.22
	
	НачатьТранзакцию();
	Попытка
		Спр = Справочники.э_ЕТСНГ.СоздатьЭлемент();
		Спр.Код = ЕТСНГ;
		Спр.Наименование 	   = Наименование;
		Спр.НаименованиеПолное = Наименование;
		Спр.Записать();
		
		МЗ = РегистрыСведений.Связь_ЭТРАН_DC_Сопоставление.СоздатьМенеджерЗаписи();
		МЗ.Период = ТекущаяДата();
		МЗ.СпрДатакор = Груз;
		МЗ.СпрЭтрана = Спр.Ссылка;
		МЗ.Записать(Истина);
		ЗафиксироватьТранзакцию();
		Возврат Спр.Ссылка;
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Возврат Справочники.э_ЕТСНГ.ПустаяСсылка();
	КонецПопытки;
	
КонецФункции

//ДИТ Шевченко А.В. 62104 06.11.22 -конец