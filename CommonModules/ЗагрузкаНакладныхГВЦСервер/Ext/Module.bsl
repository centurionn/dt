//ДИТ Шевченко А.В. 55332 10.08.2022 -начало
Процедура НайтиИПерезаполнитьНакладныеЭТРАНБезВагонов(ТаблицаДанныхИзФайла,МассивСообщений,МассивНакладныхДляПометкиНаУдаление)
	
	
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаДляОбработки.УнифицированныйНомерНакладной КАК УнифицированныйНомерНакладной,
	|	ТаблицаДляОбработки.НомерНакладной КАК НомерНакладной,
	|	ТаблицаДляОбработки.НомерВагона КАК НомерВагона,
	|	ТаблицаДляОбработки.НомерКТК КАК НомерКонтейнера
	|ПОМЕСТИТЬ ВТ_ТаблицаДляОбработки
	|ИЗ
	|	&ТаблицаДляОбработки КАК ТаблицаДляОбработки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	э_Накладная.Ссылка КАК Ссылка,
	|	ВТ_ТаблицаДляОбработки.УнифицированныйНомерНакладной КАК УнифицированныйНомерНакладной,
	|	ВТ_ТаблицаДляОбработки.НомерНакладной КАК НомерНакладной,
	|	ВТ_ТаблицаДляОбработки.НомерВагона КАК НомерВагона,
	|	ВТ_ТаблицаДляОбработки.НомерКонтейнера КАК НомерКонтейнера
	|ПОМЕСТИТЬ ВТНакладныеЭтран
	|ИЗ
	|	Документ.э_Накладная КАК э_Накладная
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТаблицаДляОбработки КАК ВТ_ТаблицаДляОбработки
	|		ПО э_Накладная.УнифицированныйНомерНакладной = ВТ_ТаблицаДляОбработки.УнифицированныйНомерНакладной
	|ГДЕ
	|	э_Накладная.ИсточникНакладной = &ЭТРАН
	|	И э_Накладная.ТекущееСостояниеНакладнойДействующийСтатус
	|	И НЕ э_Накладная.ПометкаУдаления
	//ДИТ, Беляев СЮ, BUG 80970/ TA 81089, 27-02-2024, начало
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТНакладныеЭтран.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТНакладныеЭтранСВагонами
	|ИЗ
	|	ВТНакладныеЭтран КАК ВТНакладныеЭтран
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.э_Накладная.Вагоны КАК э_НакладнаяВагоныЗаполнены
	|		ПО ВТНакладныеЭтран.Ссылка = э_НакладнаяВагоныЗаполнены.Ссылка
	|			И (э_НакладнаяВагоныЗаполнены.НомерВагона <> """")
	//ДИТ, Беляев СЮ, BUG 80970/ TA 81089, 27-02-2024, конец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТНакладныеЭтран.Ссылка КАК Ссылка,
	|	ВТНакладныеЭтран.УнифицированныйНомерНакладной КАК УнифицированныйНомерНакладной,
	//ДИТ, Беляев СЮ, BUG 80970/ TA 81089, 27-02-2024, начало
	|	ВЫБОР
	|		КОГДА ВТНакладныеЭтранСВагонами.Ссылка ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьНомераВагоновВНакладной
	//ДИТ, Беляев СЮ, BUG 80970/ TA 81089, 27-02-2024, конец
	|ИЗ
	|	ВТНакладныеЭтран КАК ВТНакладныеЭтран
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.э_Накладная.Вагоны КАК э_НакладнаяВагоны
	|		ПО ВТНакладныеЭтран.Ссылка = э_НакладнаяВагоны.Ссылка
	|			И (э_НакладнаяВагоны.НомерВагона = ВТНакладныеЭтран.НомерВагона)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.э_Накладная.Контейнеры КАК э_НакладнаяКонтейнеры
	|		ПО ВТНакладныеЭтран.Ссылка = э_НакладнаяКонтейнеры.Ссылка
	|			И (э_НакладнаяКонтейнеры.НомерКонтейнера = ВТНакладныеЭтран.НомерКонтейнера)
	//ДИТ, Беляев СЮ, BUG 80970/ TA 81089, 27-02-2024, начало
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТНакладныеЭтранСВагонами КАК ВТНакладныеЭтранСВагонами
	|		ПО ВТНакладныеЭтран.Ссылка = ВТНакладныеЭтранСВагонами.Ссылка
	//ДИТ, Беляев СЮ, BUG 80970/ TA 81089, 27-02-2024, конец
	|ГДЕ
	|	э_НакладнаяВагоны.Ссылка ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТНакладныеЭтран.УнифицированныйНомерНакладной,
	|	ВТНакладныеЭтран.Ссылка,
	//ДИТ, Беляев СЮ, BUG 80970/ TA 81089, 27-02-2024, начало
	|	ВЫБОР
	|		КОГДА ВТНакладныеЭтранСВагонами.Ссылка ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ";
	//ДИТ, Беляев СЮ, BUG 80970/ TA 81089, 27-02-2024, конец
	
	Запрос.УстановитьПараметр("ЭТРАН", Перечисления.ИсточникЖДН.ЭТРАН);
	Запрос.УстановитьПараметр("ТаблицаДляОбработки", ТаблицаДанныхИзФайла);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл    
		
		//ДИТ, Беляев СЮ, BUG 80970/ TA 81089, 27-02-2024, начало
		Если Выборка.ЕстьНомераВагоновВНакладной Тогда
			МассивНакладныхДляПометкиНаУдаление.Добавить(Выборка.УнифицированныйНомерНакладной);
			Продолжить;
		КонецЕсли;
		//ДИТ, Беляев СЮ, BUG 80970/ TA 81089, 27-02-2024, конец
		
		НакладнаяЭТРАН = Выборка.Ссылка.ПолучитьОбъект();
		Отбор = Новый Структура;
		Отбор.Вставить("УнифицированныйНомерНакладной", Выборка.УнифицированныйНомерНакладной);
		СтрокиПоНакладной = ТаблицаДанныхИзФайла.НайтиСтроки(Отбор);
			
		НомерВагонаВНакладной = 0; //ДИТ Шевченко А.В. 55599 17.01.23
		СоответсвиеНомераВагонов = Новый Соответствие;
		Для Каждого СтрокаПоНакладной Из СтрокиПоНакладной Цикл  
			Если СтрокаПоНакладной.НомерВагона <> "00000000" Тогда
				МассивКонтейнеров = НакладнаяЭТРАН.Контейнеры.НайтиСтроки(Новый Структура("НомерКонтейнера", СтрокаПоНакладной.НомерКТК)); //ДИТ Шевченко А.В. 55599 17.01.23
				Если НакладнаяЭТРАН.Вагоны.НайтиСтроки(Новый Структура("НомерВагона", СтрокаПоНакладной.НомерВагона)).Количество() = 0 Тогда
					
					СтруктураПоиска = Новый Структура("НомерВагона","");
					МассвиСтрокПустыхВагонов = НакладнаяЭТРАН.Вагоны.НайтиСтроки(СтруктураПоиска);
					
					Если МассвиСтрокПустыхВагонов.Количество() > 0 Тогда
						МассвиСтрокПустыхВагонов[0].НомерВагона	= СтрокаПоНакладной.НомерВагона;
					    МассвиСтрокПустыхВагонов[0].ТипСобственностиИД = СтрокаПоНакладной.ПринадлежностьВагонов;
						МассвиСтрокПустыхВагонов[0].ТипСобственностиНаименование = ?(СтрокаПоНакладной.ПринадлежностьВагонов = "1", "МПС", "Собственный");
						//МассвиСтрокПустыхВагонов[0].МассыВКгНетто = СтрокаПоНакладной.ФактВесГруза;
						//ДИТ Шевченко А.В. 55599 17.01.23 -начало
						НомерВагонаВНакладной = НомерВагонаВНакладной + 1;
						МассвиСтрокПустыхВагонов[0].ПорядковыйНомерВагонаВОтправке = НомерВагонаВНакладной;
						
						Если МассивКонтейнеров.Количество() > 0 Тогда
							МассивКонтейнеров[0].НомерВагонаДляКонтейнерногоПоезда = НомерВагонаВНакладной;	
						КонецЕсли;
						СоответсвиеНомераВагонов.Вставить(СтрокаПоНакладной.НомерВагона,НомерВагонаВНакладной);
						//ДИТ Шевченко А.В. 55599 17.01.23 -конец
						Продолжить;
					КонецЕсли;	
					
					СтрокаВагон = НакладнаяЭТРАН.Вагоны.Добавить();
					СтрокаВагон.НомерВагона = СтрокаПоНакладной.НомерВагона;
					СтрокаВагон.ТипСобственностиИД = СтрокаПоНакладной.ПринадлежностьВагонов;
					СтрокаВагон.ТипСобственностиНаименование = ?(СтрокаПоНакладной.ПринадлежностьВагонов = "1", "МПС", "Собственный");
					//СтрокаВагон.МассыВКгНетто = СтрокаПоНакладной.ФактВесГруза;
					//ДИТ Шевченко А.В. 55599 17.01.23 -начало
					НомерВагонаВНакладной = НомерВагонаВНакладной + 1;
					СтрокаВагон.ПорядковыйНомерВагонаВОтправке = НомерВагонаВНакладной;
					Если МассивКонтейнеров.Количество() > 0 Тогда
						МассивКонтейнеров[0].НомерВагонаДляКонтейнерногоПоезда = НомерВагонаВНакладной;	
					КонецЕсли;
					СоответсвиеНомераВагонов.Вставить(СтрокаПоНакладной.НомерВагона,НомерВагонаВНакладной);
				Иначе
					Если СоответсвиеНомераВагонов.Получить(СтрокаПоНакладной.НомерВагона) <> Неопределено Тогда
						Если МассивКонтейнеров.Количество() > 0 Тогда
							МассивКонтейнеров[0].НомерВагонаДляКонтейнерногоПоезда = СоответсвиеНомераВагонов.Получить(СтрокаПоНакладной.НомерВагона);
						КонецЕсли;
					КонецЕсли;
					//ДИТ Шевченко А.В. 55599 17.01.23 -конец
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Попытка
			НакладнаяЭТРАН.Записать(РежимЗаписиДокумента.Запись);
			НакладнаяЭТРАН.Записать(РежимЗаписиДокумента.Проведение);
			МассивНакладныхДляПометкиНаУдаление.Добавить(Выборка.УнифицированныйНомерНакладной);
		Исключение
			ОО = ОписаниеОшибки();
			ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()); 
			МассивСообщений.Добавить("Ошибка при проведении ЖДН ЭТРАН в рег. задании ""Загрузка накладных ГВЦ"". " + НакладнаяЭТРАН.Ссылка + ": " + ПредставлениеОшибки);
			ЗаписьЖурналаРегистрации("ЗагрузкаНакладныхГВЦ.Проведение ЖДН ЭТРАН", УровеньЖурналаРегистрации.Ошибка,, НакладнаяЭТРАН.Ссылка, ПредставлениеОшибки);
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры
//ДИТ Шевченко А.В. 55332 10.08.2022 -конец

//ДИТ, Беляев СЮ, TA51481, 03-06-2022, начало
Процедура УбратьИзТаблицыНакладныеПоДаннымЭТРАН(ТаблицаДанныхИзФайла)
	ПустойНомерКТК = "00000000000"; //11 знаков  - примеров в файлах данных не было, установлено из предположения
	МассивНакладныхНаУдаление = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаДляОбработки.УнифицированныйНомерНакладной КАК УнифицированныйНомерНакладной,
	|	ТаблицаДляОбработки.НомерНакладной КАК НомерНакладной,
	|	ТаблицаДляОбработки.НомерВагона КАК НомерВагона,
	|	ТаблицаДляОбработки.НомерКТК КАК НомерКонтейнера
	|ПОМЕСТИТЬ ВТ_ТаблицаДляОбработки
	|ИЗ
	|	&ТаблицаДляОбработки КАК ТаблицаДляОбработки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	э_Накладная.Ссылка КАК Ссылка,
	|	ВТ_ТаблицаДляОбработки.УнифицированныйНомерНакладной КАК УнифицированныйНомерНакладной,
	|	ВТ_ТаблицаДляОбработки.НомерНакладной КАК НомерНакладной,
	|	ВТ_ТаблицаДляОбработки.НомерВагона КАК НомерВагона,
	|	ВТ_ТаблицаДляОбработки.НомерКонтейнера КАК НомерКонтейнера
	|ПОМЕСТИТЬ ВТНакладныеЭтран
	|ИЗ
	|	Документ.э_Накладная КАК э_Накладная
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТаблицаДляОбработки КАК ВТ_ТаблицаДляОбработки
	|		ПО (э_Накладная.УнифицированныйНомерНакладной = ВТ_ТаблицаДляОбработки.УнифицированныйНомерНакладной)
	|ГДЕ
	|	э_Накладная.ИсточникНакладной = &ЭТРАН
	|	И э_Накладная.ТекущееСостояниеНакладнойДействующийСтатус
	|	И НЕ э_Накладная.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТНакладныеЭтран.Ссылка КАК Ссылка,
	|	ВТНакладныеЭтран.УнифицированныйНомерНакладной КАК УнифицированныйНомерНакладной
	|ИЗ
	|	ВТНакладныеЭтран КАК ВТНакладныеЭтран
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.э_Накладная.Вагоны КАК э_НакладнаяВагоны
	|		ПО ВТНакладныеЭтран.Ссылка = э_НакладнаяВагоны.Ссылка
	|			И (э_НакладнаяВагоны.НомерВагона = ВТНакладныеЭтран.НомерВагона)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.э_Накладная.Контейнеры КАК э_НакладнаяКонтейнеры
	|		ПО ВТНакладныеЭтран.Ссылка = э_НакладнаяКонтейнеры.Ссылка
	|			И (э_НакладнаяКонтейнеры.НомерКонтейнера = ВТНакладныеЭтран.НомерКонтейнера)
	|ГДЕ
	|	(ВТНакладныеЭтран.НомерКонтейнера = &ПустойНомерКТК
	|			ИЛИ НЕ э_НакладнаяКонтейнеры.Ссылка ЕСТЬ NULL)";
	
	Запрос.УстановитьПараметр("ЭТРАН", Перечисления.ИсточникЖДН.ЭТРАН);
	Запрос.УстановитьПараметр("ТаблицаДляОбработки", ТаблицаДанныхИзФайла);
	Запрос.УстановитьПараметр("ПустойНомерКТК", ПустойНомерКТК);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл    
		МассивНакладныхНаУдаление.Добавить(Выборка.УнифицированныйНомерНакладной); //Есть аналогичная ЖДН из ЭТРАН, загрузка не требуется    
	КонецЦикла;
	
	//УДАЛЕНИЕ ЛИШНИХ СТРОК
	Для Каждого ЭлементМассива Из МассивНакладныхНаУдаление Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("УнифицированныйНомерНакладной",ЭлементМассива);
		НайденныеСтроки = ТаблицаДанныхИзФайла.НайтиСтроки(Отбор);
		Для Каждого СтрТЗ из НайденныеСтроки Цикл
			ТаблицаДанныхИзФайла.Удалить(СтрТЗ);
		КонецЦикла;
	КонецЦикла; 
КонецПроцедуры    
//ДИТ, Беляев СЮ, TA51481, 03-06-2022, конец

//ДИТ, Беляев СЮ, TA51481, 03-06-2022, начало
Процедура ОбработатьНакладную(УнифицированныйНомерНакладной, ТаблицаДанныхИзФайла, МассивСообщений,МассивНакладныхДляПометкиНаУдаление)  
	
	// производим поиск и заполнение ЖДН	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	э_Накладная.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.э_Накладная КАК э_Накладная
	|ГДЕ
	|	НЕ э_Накладная.ПометкаУдаления
	|	И э_Накладная.УнифицированныйНомерНакладной = &УнифицированныйНомерНакладной
	|	И э_Накладная.ИсточникНакладной = &ГВЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	э_Накладная.Дата УБЫВ";
	Запрос.УстановитьПараметр("УнифицированныйНомерНакладной", УнифицированныйНомерНакладной);
	Запрос.УстановитьПараметр("ГВЦ", Перечисления.ИсточникЖДН.ГВЦ);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		НоваяНакладнаяЖД = Ответ.Ссылка.ПолучитьОбъект();
		//++ [US 58841] Denis Isadchenko, 07.03.2023
		РанееЗагружен = Истина;
		//-- [US 58841] Denis Isadchenko, 07.03.2023
	Иначе
		НоваяНакладнаяЖД = Документы.э_Накладная.СоздатьДокумент();
		//++ [US 58841] Denis Isadchenko, 07.03.2023
		РанееЗагружен = Ложь;
		//-- [US 58841] Denis Isadchenko, 07.03.2023
	КонецЕсли;
	
	НоваяНакладнаяЖД.ИсточникНакладной = Перечисления.ИсточникЖДН.ГВЦ;
	НоваяНакладнаяЖД.Дата = ТекущаяДата();
		
	Отбор = Новый Структура;
	Отбор.Вставить("УнифицированныйНомерНакладной", УнифицированныйНомерНакладной);
	СтрокиПоНакладной = ТаблицаДанныхИзФайла.НайтиСтроки(Отбор);
	
	//ДИТ Шевченко А.В. 55599 17.01.23 -начало
	НомерВагонаВНакладной = 0;
	СоответсвиеНомераВагонов = Новый Соответствие;
	//ДИТ Шевченко А.В. 55599 17.01.23 -конец
	
	//ДИТ Давудов М.А. 0310599 23.05.23 -начало
	Для Каждого СтрокаПоНакладной Из СтрокиПоНакладной Цикл
		Если СтрокаПоНакладной.НомерВагона <> "00000000" Тогда
			Если НоваяНакладнаяЖД.Вагоны.НайтиСтроки(Новый Структура("НомерВагона", СтрокаПоНакладной.НомерВагона)).Количество() = 0 Тогда
				Если НоваяНакладнаяЖД.Вагоны.Количество() > 0 Тогда
					НоваяНакладнаяЖД.Вагоны.Очистить();
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаПоНакладной.НомерКТК <> "00000000000" Тогда
			Если НоваяНакладнаяЖД.Контейнеры.НайтиСтроки(Новый Структура("НомерКонтейнера", СтрокаПоНакладной.НомерКТК)).Количество() = 0 Тогда
				Если НоваяНакладнаяЖД.Контейнеры.Количество() > 0 Тогда
					НоваяНакладнаяЖД.Контейнеры.Очистить();
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаПоНакладной.ПровознаяПлата <> "000000.00" Тогда
			Если НоваяНакладнаяЖД.ПровозныеПлатежиИСборыПоПрибытию.НайтиСтроки(Новый Структура("НомерВагона, НомерКонтейнера", СтрокаПоНакладной.НомерВагона, СтрокаПоНакладной.НомерКТК)).Количество() = 0 Тогда
				Если НоваяНакладнаяЖД.ПровозныеПлатежиИСборыПоПрибытию.Количество() > 0 Тогда
					НоваяНакладнаяЖД.ПровозныеПлатежиИСборыПоПрибытию.Очистить();
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаПоНакладной.КодЕТСНГ <> "00000" ИЛИ СтрокаПоНакладной.КодГНГ <> "000000" Тогда
			Если СтрокаПоНакладной.КодГНГ <> "000000" Тогда
				Если НоваяНакладнаяЖД.Грузы.НайтиСтроки(Новый Структура("НомерКонтейнера, КодГНГ", СтрокаПоНакладной.НомерКТК, СтрокаПоНакладной.КодГНГ)).Количество() = 0 Тогда
					Если НоваяНакладнаяЖД.Грузы.Количество() > 0 Тогда
						НоваяНакладнаяЖД.Грузы.Очистить();
					КонецЕсли;
				КонецЕсли;
				Если НоваяНакладнаяЖД.ГрузыЖД.НайтиСтроки(Новый Структура("КодГНГ", СтрокаПоНакладной.КодГНГ)).Количество() = 0 Тогда
					Если НоваяНакладнаяЖД.ГрузыЖД.Количество() > 0 Тогда
						НоваяНакладнаяЖД.ГрузыЖД.Очистить();
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли СтрокаПоНакладной.КодЕТСНГ <> "00000" Тогда
				Если НоваяНакладнаяЖД.Грузы.НайтиСтроки(Новый Структура("НомерКонтейнера, КодЕТСНГ", СтрокаПоНакладной.НомерКТК, СтрокаПоНакладной.КодЕТСНГ)).Количество() = 0 Тогда
					Если НоваяНакладнаяЖД.Грузы.Количество() > 0 Тогда
						НоваяНакладнаяЖД.Грузы.Очистить();
					КонецЕсли;
				КонецЕсли;
				Если НоваяНакладнаяЖД.ГрузыЖД.НайтиСтроки(Новый Структура("КодЕТСНГ", СтрокаПоНакладной.КодЕТСНГ)).Количество() = 0 Тогда
					Если НоваяНакладнаяЖД.ГрузыЖД.Количество() > 0 Тогда
						НоваяНакладнаяЖД.ГрузыЖД.Очистить();
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	//ДИТ Давудов М.А. 0310599 23.05.23 -конец
	
	Для Каждого СтрокаПоНакладной Из СтрокиПоНакладной Цикл  
		НоваяНакладнаяЖД.Номер = СтрокаПоНакладной.НомерНакладной;
		НоваяНакладнаяЖД.НакладнаяНомер = СтрокаПоНакладной.НомерНакладной;
		Если СтрокаПоНакладной.НомерВагона <> "00000000" Тогда
			Если НоваяНакладнаяЖД.Вагоны.НайтиСтроки(Новый Структура("НомерВагона", СтрокаПоНакладной.НомерВагона)).Количество() = 0 Тогда
				СтрокаВагон = НоваяНакладнаяЖД.Вагоны.Добавить();
				СтрокаВагон.НомерВагона = СтрокаПоНакладной.НомерВагона;
				СтрокаВагон.ТипСобственностиИД = СтрокаПоНакладной.ПринадлежностьВагонов;
				СтрокаВагон.ТипСобственностиНаименование = ?(СтрокаПоНакладной.ПринадлежностьВагонов = "1", "МПС", "Собственный");
				СтрокаВагон.МассыВКгНетто = СтрокаПоНакладной.ФактВесГруза;
				//ДИТ Шевченко А.В. 55599 17.01.23 -начало
				НомерВагонаВНакладной = НомерВагонаВНакладной + 1;
				СтрокаВагон.ПорядковыйНомерВагонаВОтправке = НомерВагонаВНакладной;
				СоответсвиеНомераВагонов.Вставить(СтрокаПоНакладной.НомерВагона,НомерВагонаВНакладной);
				//ДИТ Шевченко А.В. 55599 17.01.23 -конец
			КонецЕсли;
		КонецЕсли;
		Если СтрокаПоНакладной.НомерКТК <> "00000000000" Тогда
			Если НоваяНакладнаяЖД.Контейнеры.НайтиСтроки(Новый Структура("НомерКонтейнера", СтрокаПоНакладной.НомерКТК)).Количество() = 0 Тогда
				СтрокаКТК = НоваяНакладнаяЖД.Контейнеры.Добавить();
				//СтрокаКТК.Контейнер = НомерКТК;
				СтрокаКТК.НомерКонтейнера = СтрокаПоНакладной.НомерКТК;
				СтрокаКТК.ТипСобственностиИД = СтрокаПоНакладной.ПринадлежностьКТК;
				СтрокаКТК.ТипСобственностиНаименование = ?(СтрокаПоНакладной.ПринадлежностьКТК = "1", "МПС", "Собственный");
				СтрокаКТК.ГрузоподКонтТн = СтрокаПоНакладной.ГрузоподъемностьВагонаКТК;
				СтрокаКТК.МассыВКгНетто = СтрокаПоНакладной.ФактВесГруза;
				//ДИТ Шевченко А.В. 55599 17.01.23 -начало
				СтрокаКТК.НомерВагонаДляКонтейнерногоПоезда = 0;
				Если СоответсвиеНомераВагонов.Получить(СтрокаПоНакладной.НомерВагона) <> Неопределено Тогда
					СтрокаКТК.НомерВагонаДляКонтейнерногоПоезда = СоответсвиеНомераВагонов.Получить(СтрокаПоНакладной.НомерВагона);
				КонецЕсли;                                                                                                     
				//ДИТ Шевченко А.В. 55599 17.01.23 -конец
			КонецЕсли;
		КонецЕсли;
		НоваяНакладнаяЖД.ДатаИВремяОтправленияГруза = СтрокаПоНакладной.ДатаОтправки;
