//ДИТ, Беляев СЮ, TA51481, 03-06-2022, начало
Процедура ЗагрузитьНакладнуюГВЦ(ИмяФайла, КодировкаТекста)
	
	ЧТ = Новый ЧтениеТекста(ИмяФайла,КодировкаТекста);
	ТекстФ = ЧТ.Прочитать();
	ЧТ.Закрыть();   
	
	РаздМассив = СтрРазделить(ТекстФ, Символы.ПС);
	
	// Евросиб Фролов (26.04.2022
	МассивСообщений = Новый Массив;
	// Евросиб Фролов)
	
	ТипСтрока11 = Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(11));
	ТипСтрока8 = Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(8));
	//ДИТ, Беляев СЮ, US 80800/TA 81609, 05-03-2024, начало
	ТипСтрока10 = Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(э_ОбщиеСервер.ДлинаНомераНакладной()));
	//ДИТ, Беляев СЮ, US 80800/TA 81609, 05-03-2024, конец

	ТаблицаДанныхИзФайла = Новый ТаблицаЗначений;
	ТаблицаДанныхИзФайла.Колонки.Добавить("НомерНакладной",ТипСтрока8);
	ТаблицаДанныхИзФайла.Колонки.Добавить("ДеньОтправки");
	ТаблицаДанныхИзФайла.Колонки.Добавить("МесяцОтправки");
	ТаблицаДанныхИзФайла.Колонки.Добавить("ВремяОтправленияЧасы");
	ТаблицаДанныхИзФайла.Колонки.Добавить("ВремяОтправленияМинуты");
	ТаблицаДанныхИзФайла.Колонки.Добавить("ДеньПрибытия");
	ТаблицаДанныхИзФайла.Колонки.Добавить("МесяцПрибытия");
	ТаблицаДанныхИзФайла.Колонки.Добавить("ГодПрибытия");  
	ТаблицаДанныхИзФайла.Колонки.Добавить("ГодОтправки");
	ТаблицаДанныхИзФайла.Колонки.Добавить("ДатаОтправки");
	ТаблицаДанныхИзФайла.Колонки.Добавить("КодЭкспедитора");
	ТаблицаДанныхИзФайла.Колонки.Добавить("ПодкодЭкспедитора");
	ТаблицаДанныхИзФайла.Колонки.Добавить("КатегорияОтправки");
	ТаблицаДанныхИзФайла.Колонки.Добавить("КоличествоВагоновКТК");
	ТаблицаДанныхИзФайла.Колонки.Добавить("ОтчетныйМесяц");
	ТаблицаДанныхИзФайла.Колонки.Добавить("ФактВесГруза");
	ТаблицаДанныхИзФайла.Колонки.Добавить("ПризнакМаршрута");
	ТаблицаДанныхИзФайла.Колонки.Добавить("ВидПеревозки");
	ТаблицаДанныхИзФайла.Колонки.Добавить("НомерВагона",ТипСтрока8);

	ТаблицаДанныхИзФайла.Колонки.Добавить("ПринадлежностьВагонов");
	ТаблицаДанныхИзФайла.Колонки.Добавить("НомерКТК",ТипСтрока11);
	ТаблицаДанныхИзФайла.Колонки.Добавить("ПринадлежностьКТК");
	ТаблицаДанныхИзФайла.Колонки.Добавить("ГрузоподъемностьВагонаКТК");
	ТаблицаДанныхИзФайла.Колонки.Добавить("ДатаПрибытия");
	ТаблицаДанныхИзФайла.Колонки.Добавить("КодЗагрСтОтправления");
	
	ТаблицаДанныхИзФайла.Колонки.Добавить("КодЗагрСтНазначения");
	ТаблицаДанныхИзФайла.Колонки.Добавить("КодСтОтправления");
	ТаблицаДанныхИзФайла.Колонки.Добавить("КодСтНазначения");
	ТаблицаДанныхИзФайла.Колонки.Добавить("СтанцияОтправления");
	ТаблицаДанныхИзФайла.Колонки.Добавить("СтанцияПрибытия");
	ТаблицаДанныхИзФайла.Колонки.Добавить("КодЕТСНГ");
	ТаблицаДанныхИзФайла.Колонки.Добавить("КодГНГ");
	ТаблицаДанныхИзФайла.Колонки.Добавить("КодИсключительногоТарифа");
	ТаблицаДанныхИзФайла.Колонки.Добавить("КодВалюты");
	ТаблицаДанныхИзФайла.Колонки.Добавить("ПровознаяПлата");
	ТаблицаДанныхИзФайла.Колонки.Добавить("ПризнакИсключения");
	ТаблицаДанныхИзФайла.Колонки.Добавить("ПризнакЗаписи");
	ТаблицаДанныхИзФайла.Колонки.Добавить("ГрузополучательОКПО");
	ТаблицаДанныхИзФайла.Колонки.Добавить("ГрузополучательАСУ");
	ТаблицаДанныхИзФайла.Колонки.Добавить("ГрузоотправительОКПО");
	ТаблицаДанныхИзФайла.Колонки.Добавить("ГрузоотправительАСУ"); 
	//ТаблицаДанныхИзФайла.Колонки.Добавить("УнифицированныйНомерНакладной",ТипСтрока8); 
	//ДИТ, Беляев СЮ, US 80800/TA 81609, 05-03-2024, начало
	ТаблицаДанныхИзФайла.Колонки.Добавить("УнифицированныйНомерНакладной",ТипСтрока10);
	//ДИТ, Беляев СЮ, US 80800/TA 81609, 05-03-2024, конец
	
	Для каждого СтрокаФ из РаздМассив Цикл
		Если Не ЗначениеЗаполнено(СтрокаФ) Тогда  
			Продолжить;
		КонецЕсли;
		
		НомерНакладной = Сред(СтрокаФ, 49, 8); // +
		
		Если НомерНакладной = "00000000" Тогда 
			Продолжить;
		КонецЕсли;
		
		ДеньОтправки = Сред(СтрокаФ, 57, 2); // +
		МесяцОтправки = Сред(СтрокаФ, 59, 2); // +
		ВремяОтправленияЧасы = "00";
		ВремяОтправленияМинуты = "00";
		ДеньПрибытия = "01";
		МесяцПрибытия = "01";
		ГодПрибытия = "0001";
		Если СтрНайти(ИмяФайла,"inv_sending") Тогда
			ВремяОтправленияЧасы = Сред(СтрокаФ, 61, 2); // +
			ВремяОтправленияМинуты = Сред(СтрокаФ, 63, 2); // +
		Иначе
			ДеньПрибытия = Сред(СтрокаФ, 61, 2); // +
			МесяцПрибытия = Сред(СтрокаФ, 63, 2); // +
			ГодПрибытия = Формат(?(Число(МесяцПрибытия) > Месяц(ТекущаяДата()), Год(ТекущаяДата())-1, Год(ТекущаяДата())),"ЧГ="); // +
		КонецЕсли; 
		ГодОтправки = Формат(?(Число(МесяцОтправки) > Месяц(ТекущаяДата()), Год(ТекущаяДата())-1, Год(ТекущаяДата())),"ЧГ="); // +
		ДатаОтправки = Дата(ГодОтправки+МесяцОтправки+ДеньОтправки+ВремяОтправленияЧасы+ВремяОтправленияМинуты); // +
			
		КодЭкспедитора = Сред(СтрокаФ, 1, 10); // -
		
		ПодкодЭкспедитора = Сред(СтрокаФ, 11, 12); // -
				
