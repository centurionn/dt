
Процедура РазнесениеДанных() Экспорт
	
	РазнесениеДанныхНакладныхПоСделкам();
	
КонецПроцедуры

Процедура РазнесениеДанныхНакладныхПоСделкам() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НакладныеИСделки.Период КАК Период,
	               |	НакладныеИСделки.Накладная КАК Накладная,
	               |	НакладныеИСделки.Сделка КАК Сделка,
	               |	НакладныеИСделки.Контейнер КАК Контейнер,
	               |	НакладныеИСделки.Вагон КАК Вагон,
	               |	НакладныеИСделки.Занесено КАК Занесено,
	               |	НакладныеИСделки.ЖДНВагон КАК ЖДНВагон,
	               |	НакладныеИСделки.ЖДНКТК КАК ЖДНКТК,
	               |	НакладныеИСделки.ЖДНПорожнийВагон КАК ЖДНПорожнийВагон
	               |ИЗ
	               |	РегистрСведений.НакладныеИСделки КАК НакладныеИСделки
	               |ГДЕ
	               |	НЕ НакладныеИСделки.Занесено";
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Стр Из ТЗ Цикл
		ПОлучОб = Стр.Сделка.ПолучитьОбъект();
		УстановитьЖДН = Истина;
		Попытка
			ПОлучОб.Заблокировать();
		Исключение
			// в случае блокировки - не выполнять изменение объекта
			УстановитьЖДН = Ложь;
		КонецПопытки;

		// Пропустить обработку объекта, если он заблокирован.
		Если УстановитьЖДН Тогда
			ТЧ = ПолучОб.СвязьУчетныхЕдиниц;
			Для Каждого Стр_ТЧ Из ТЧ Цикл
				Если Стр_ТЧ.Контейнер = Стр.Контейнер Тогда
					Стр_ТЧ.Вагон = Стр.Вагон;
					Стр_ТЧ.НомерЖДН = Стр.Накладная.НакладнаяНомер;
					Стр_ТЧ.НомерВагоннойЖДН = Стр.ЖДНВагон;
					Стр_ТЧ.НомерПорожнейЖДНКТК = Стр.ЖДНКТК;
					Стр_ТЧ.НомерПорожнейВагоннойЖДН = Стр.ЖДНПорожнийВагон;
					ТранспДок = Документы.ТранспортныйДокумент.НайтиПоРеквизиту("НакладнаяЭТРАН",Стр.Накладная);
					Если НЕ ТранспДок.Пустая() И НЕ ТранспДок.ПометкаУдаления Тогда
						Стр_ТЧ.ЖДН = ТранспДок;
					КонецЕсли;
				КонецЕсли;			
			КонецЦикла;
			ПОлучОб.Записать();
			
			// изменяем регистр
			МенеджерЗаписи = РегистрыСведений.НакладныеИСделки.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(МенеджерЗаписи,Стр,,"Занесено");
			МенеджерЗаписи.Занесено = Истина;
			МенеджерЗаписи.Записать();
			
		КонецЕсли; 

		
	КонецЦикла;
	
КонецПроцедуры

