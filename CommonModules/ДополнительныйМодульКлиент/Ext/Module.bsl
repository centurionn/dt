Функция ВыполнитьКомандуПечати(ОписаниеКоманды) Экспорт
	
	Если ОписаниеКоманды.Свойство("ЗаголовокФормы") И ЗначениеЗаполнено(ОписаниеКоманды.ЗаголовокФормы) Тогда
		ПараметрыПечати = Новый Структура("ЗаголовокФормы", ОписаниеКоманды.ЗаголовокФормы);
	Иначе
		ПараметрыПечати = ПолучитьЗаголовокПечатнойФормы(ОписаниеКоманды.ОбъектыПечати);
	КонецЕсли;
	
	Если ОписаниеКоманды.Свойство("ДополнительныеПараметры") Тогда
		ПараметрыПечати.Вставить("ДополнительныеПараметры", ОписаниеКоманды.ДополнительныеПараметры);
	КонецЕсли; 
	
	//НачатьЗамерВремени(ОписаниеКоманды.Форма, ОписаниеКоманды.Идентификатор, ОписаниеКоманды.ОбъектыПечати);

	УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(ОписаниеКоманды.МенеджерПечати, ОписаниеКоманды.Идентификатор, ОписаниеКоманды.ОбъектыПечати,
		ОписаниеКоманды.Форма, ПараметрыПечати);
		
КонецФункции

Функция ПолучитьЗаголовокПечатнойФормы(ПараметрКоманды) Экспорт 
	
	Если Тип(ПараметрКоманды) = Тип("Массив") И ПараметрКоманды.Количество() = 1 Тогда 
		Возврат Новый Структура("ЗаголовокФормы", ПараметрКоманды[0]);
	Иначе
		Возврат Новый Структура;
	КонецЕсли;
	
КонецФункции

Функция ВыполнитьКомандуПечатиСчетовФактур(ОписаниеКоманды) Экспорт
	СписокМакетов = ПечатьБухгалтерскихДокументов.ПолучитьСписокМакетов(ОписаниеКоманды.ОбъектыПечати);

	//СписокМакетов = "СчетФактура981,КорректировочныйСчетФактура981";//ПечатьБухгалтерскихДокументов.ПолучитьСписокМакетов(ОписаниеКоманды.ОбъектыПечати);
	Если СписокМакетов <> "" Тогда 
	Если ОписаниеКоманды.Свойство("ЗаголовокФормы") И ЗначениеЗаполнено(ОписаниеКоманды.ЗаголовокФормы) Тогда
		ПараметрыПечати = Новый Структура("ЗаголовокФормы", ОписаниеКоманды.ЗаголовокФормы);
	Иначе
		ПараметрыПечати = ПолучитьЗаголовокПечатнойФормы(ОписаниеКоманды.ОбъектыПечати);
	КонецЕсли;
	
	Если ОписаниеКоманды.Свойство("ДополнительныеПараметры") Тогда
		ПараметрыПечати.Вставить("ДополнительныеПараметры", ОписаниеКоманды.ДополнительныеПараметры);
	КонецЕсли; 
	
		
		УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(
			"Документ.СчетФактураВыданный",
			СписокМакетов,
			ОписаниеКоманды.ОбъектыПечати,
			ОписаниеКоманды.Форма,
			ПараметрыПечати);
			
	КонецЕсли;
	
КонецФункции

Функция ВыполнитьКомандуПечатиУПД(ОписаниеКоманды) Экспорт
	ЭтоОснование = Ложь;
	
	Для каждого Эл Из ОписаниеКоманды.ОбъектыПечати Цикл
		МассивДок = Новый Массив;
		Если ТипЗнч(Эл) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
			ЭтоОснование = Ложь;
		Иначе
			ЭтоОснование = Истина;
			МассивДок.Добавить(Эл);
		КонецЕсли;
		
		ДокументыДляМакетов = ?(не ЭтоОснование, Эл,МассивДок);
		СписокМакетов = ПечатьБухгалтерскихДокументов.ПолучитьСписокМакетовУПД(ДокументыДляМакетов,ЭтоОснование);
		Если СписокМакетов <> "" Тогда 
			СчФМассив = Новый Массив;
			СчФМассив.Добавить(?(ЭтоОснование,БухгалтерскийУчетОбщиеПроцедурыСервер.НайтиПодчиненныйСчетФактуру(Эл,"СчетФактураВыданный"),Эл));
			Если ОписаниеКоманды.Свойство("ЗаголовокФормы") И ЗначениеЗаполнено(ОписаниеКоманды.ЗаголовокФормы) Тогда
				ПараметрыПечати = Новый Структура("ЗаголовокФормы", ОписаниеКоманды.ЗаголовокФормы);
			Иначе
				//ПараметрыПечати = ПолучитьЗаголовокПечатнойФормы(ОписаниеКоманды.ОбъектыПечати);
				
				ПараметрыПечати = ПолучитьЗаголовокПечатнойФормы(СчФМассив);
			КонецЕсли;
			
			Если ОписаниеКоманды.Свойство("ДополнительныеПараметры") Тогда
				ПараметрыПечати.Вставить("ДополнительныеПараметры", ОписаниеКоманды.ДополнительныеПараметры);
			КонецЕсли; 
			
			
			//УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(
			//	"Документ.СчетФактураВыданный",
			//	СписокМакетов,
			//	ОписаниеКоманды.ОбъектыПечати,
			//	ОписаниеКоманды.Форма,
			//	ПараметрыПечати);
			УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(
			"Документ.СчетФактураВыданный",
			СписокМакетов,
			СчФМассив,
			ОписаниеКоманды.Форма,
			ПараметрыПечати);
			//Документ-основание без СчетФактуры
		Иначе
			СписокМакетов = ПечатьБухгалтерскихДокументов.ПолучитьСписокМакетовУПДБезСчетФактуры(ДокументыДляМакетов);
			Для каждого Эл Из ДокументыДляМакетов Цикл
			Если ТипЗнч(Эл) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
				МенеджерПечати = "Документ.РеализацияТоваровУслуг";
			ИначеЕсли  ТипЗнч(Эл) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
				МенеджерПечати = "Документ.ОтчетКомитентуОПродажах";
			ИначеЕсли ТипЗнч(Эл) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
				МенеджерПечати = "Документ.КорректировкаРеализации";
			КонецЕсли;

			УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(
			МенеджерПечати,//"Документ.СчетФактураВыданный",
			СписокМакетов,
			ДокументыДляМакетов,
			ОписаниеКоманды.Форма,
			ПараметрыПечати);
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;	
	

КонецФункции

// Евросиб Фролов (08.04.2022 Task №48889, 21.12.2021 TASK №43345
Процедура ВыполнитьПолучениеФайлаЖДН(НакладнаяИД) Экспорт	
	ИмяСохраняемогоФайла = ПолучитьИмяВременногоФайла("pdf");
	
	СсылкаНаДанныеФайла = ОбщегоНазначенияВызовСервера.ПолучитьСсылкуНаДанныеПечатнойФормы(НакладнаяИД, ИмяСохраняемогоФайла);
	
	Если ПустаяСтрока(СсылкаНаДанныеФайла) Тогда
		ПоказатьПредупреждение(, "Не удалось получить печатную форму ЖДН из ЭТРАН");
	Иначе	
		
		ЗагруженныйФайл = ЗагрузитьФайлНаКлиенте(СсылкаНаДанныеФайла, ИмяСохраняемогоФайла);
		
		Если Не ЗагруженныйФайл.Статус Тогда
			ПоказатьПредупреждение(, "Не удалось получить печатную форму ЖДН из ЭТРАН");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ЗагруженныйФайл.СообщениеОбОшибке);
		Иначе
			ФайловаяСистемаКлиент.ОткрытьФайл(ЗагруженныйФайл.Путь);			
		КонецЕсли;
	КонецЕсли;	
	ОбщегоНазначенияВызовСервера.УдалитьВременныйФайл(ИмяСохраняемогоФайла);
	
КонецПроцедуры

Функция ЗагрузитьФайлНаКлиенте(СсылкаНаДанныеФайла, ИмяСохраняемогоФайла)
	ПараметрыПолучения = Новый Структура;
	
	ПараметрыПолучения.Вставить("ПутьДляСохранения", ИмяСохраняемогоФайла);
	ПараметрыПолучения.Вставить("ИспользоватьАутентификациюОС", Истина);
	
	Возврат ПолучениеФайловИзИнтернетаКлиент.СкачатьФайлНаКлиенте(СсылкаНаДанныеФайла, ПараметрыПолучения);
КонецФункции
