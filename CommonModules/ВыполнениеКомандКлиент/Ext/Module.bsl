Процедура Подключаемый_ПроверитьВыполнениеЗадания(Результат = "", ДопПараметры = "") Экспорт
	Попытка
		РезультатДлительнойОперации = ДопПараметры.РезультатДлительнойОперации;
		Если РезультатДлительнойОперации.Статус = "Выполнено" 
			Или ВыполнениеКомандСервер.ЗаданиеВыполнено(РезультатДлительнойОперации.ИдентификаторЗадания) Тогда
			//РезультатВыполнения = ПолучитьИзВременногоХранилища(РезультатДлительнойОперации.АдресРезультата);
			//Если РезультатВыполнения = Неопределено Тогда 
			//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Однократное разнесение ПТУ завершено");
			//	ПоказатьПредупреждение(, "Разнесение ПТУ не выполнено");
			//Иначе

				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Однократное разнесение ПТУ завершено");
			//КонецЕсли;
		Иначе
			ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ДопПараметры.Источник);
			ПараметрыОжидания.ВыводитьПрогрессВыполнения = Ложь;
			ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
			ДопПараметры.Свойство("ВыводитьОкноОжидания", ПараметрыОжидания.ВыводитьОкноОжидания);
			ПараметрыОжидания.Интервал = 1;
			ОписаниеОповещения = Новый ОписаниеОповещения("Подключаемый_ПроверитьВыполнениеЗадания", ЭтотОбъект, ДопПараметры);
			ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатДлительнойОперации, ОписаниеОповещения, ПараметрыОжидания);
		КонецЕсли;
	Исключение        
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

Процедура ВыполнитьКомандуОднократноеРазнесениеНовыйАлгоритм(ПараметрКоманды, ПараметрыВыполненияКоманды, УИДЗамера) Экспорт
	
	ОткрытьФорму("ОбщаяФорма.ФормаАвторазнесения", Новый Структура("Поступление, УИДЗамера, НовыйАлгоритм", ПараметрКоманды[0], УИДЗамера, Истина),,Новый УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.Независимый);

КонецПроцедуры

