
Функция ПолучитьСтавкуНДС(СтавкаНДС) Экспорт
	
	Если СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20") ИЛИ СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20_120") Тогда
		Возврат 20;		
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10") ИЛИ СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10_110") Тогда
		Возврат 10;		
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18") ИЛИ СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18_118") Тогда
		Возврат 18;	
	// Евросиб(ДИТ) US 96051 ТА 96052 Сержантова А.С. Начало: 25.12.2024
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС5") ИЛИ СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС5_105") Тогда
		Возврат 5;
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС7") ИЛИ СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС7_107") Тогда
		Возврат 7;
		// Евросиб(ДИТ) US 96051 ТА 96052 Сержантова А.С. Конец: 25.12.2024
		//Евросиб СубботинВ #125845 09.12.2025 Начало
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22") ИЛИ СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22_122") Тогда
		Возврат 22;
		//Евросиб СубботинВ #125845 09.12.2025 Конец
		
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Процедура ПересчитатьСуммыНДС(СТрТЧ, УчитыватьНДС, СуммаВключаетНДС) Экспорт
	
	СТрТЧ.СуммаНДС = ПолучитьСуммуНДС(СТрТЧ.Сумма, ПолучитьСтавкуНДС(СТрТЧ.СтавкаНДС), УчитыватьНДС, СуммаВключаетНДС);
	
Конецпроцедуры

Функция ПолучитьСуммуНДС(Сумма, СтавкаНДС, УчитыватьНДС, СуммаВключаетНДС) Экспорт
	
	Если (УчитыватьНДС) и (СуммаВключаетНДС) Тогда
		СуммаБезНДС = 100 * Сумма / (100 + СтавкаНДС);
		СуммаНДС = Сумма - СуммаБезНДС;
	Иначе
		СуммаБезНДС = Сумма;
	КонецЕсли;
	
	Если УчитыватьНДС Тогда 
		Если НЕ СуммаВключаетНДС Тогда
			СуммаНДС = СуммаБезНДС * СтавкаНДС / 100;
		КонецЕсли;
	Иначе
		СуммаНДС = 0;
	КонецЕсли;
	
	Возврат СуммаНДС;
	
КонецФункции

Процедура РассчитатьСуммуСтрокиТабличнойЧасти(СтрТЧ) Экспорт
	 СтрТЧ.Сумма = СтрТЧ.Цена * СтрТЧ.Количество;
КонецПроцедуры

Функция РассчитатьСуммуВсегоПоСтроке(СтрТЧ, СуммаВключаетНДС) Экспорт
	СтрТЧ.Всего = СтрТЧ.Сумма + ?(СуммаВключаетНДС,0,СтрТЧ.СуммаНДС);
		
КонецФункции

//Евросиб Каблов 07.06.2023 68187
Процедура РассчитатьСНП(ДанныеСНП, Ставки) Экспорт
	
	Если ДанныеСНП <> Неопределено Тогда
		
		ПустаяДата = '00010101';
		ТекДата = ТекущаяДата();
		ТекущийДень = НачалоДня(ТекДата);
		КоличествоСекундВЧасе = 3600;
		КоличествоСекундВСутках = 86400;
		
		Если ЗначениеЗаполнено(ДанныеСНП.ФактическаяДатаНачалаПоДаннымПодрядчика) Тогда
			ДатаНачала = ДанныеСНП.ФактическаяДатаНачалаПоДаннымПодрядчика;			
		Иначе
			ДатаНачала = ДанныеСНП.ФактическаяДатаНачалаПоДаннымКлиента;			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеСНП.ФактическаяДатаОкончанияПоДаннымПодрядчика) Тогда
			ДатаОкончания = ДанныеСНП.ФактическаяДатаОкончанияПоДаннымПодрядчика;
		Иначе
			ДатаОкончания = ДанныеСНП.ФактическаяДатаОкончанияПоДаннымКлиента;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДатаНачала) И ЗначениеЗаполнено(ДатаОкончания) И ДатаНачала < ДатаОкончания Тогда
			
			//Расчет количества суток/часов пользования
			Если ДанныеСНП.ЕдиницаИзмеренияРасчетаСНП = ПредопределенноеЗначение("Перечисление.ЕдиницыИзмеренияВремениРасчетаСНП.Часы") Тогда
				КоличествоЧасов = (ДатаОкончания - ДатаНачала) / КоличествоСекундВЧасе;
				ЦелаяЧасть = Цел(КоличествоЧасов);
				ДробнаяЧасть = КоличествоЧасов - ЦелаяЧасть;
				Если ДробнаяЧасть > 0 Тогда
					КоличествоЧасов = ЦелаяЧасть + 1;				
				КонецЕсли;			
				ДанныеСНП.ПользованиеВсего = КоличествоЧасов;
			Иначе
				КоличествоСуток = Цел((ДатаОкончания - ДатаНачала) / КоличествоСекундВСутках) + 1;
				ДанныеСНП.ПользованиеВсего = КоличествоСуток;
			КонецЕсли;
			
			Если ДанныеСНП.НормативныйСрок > ДанныеСНП.ПользованиеВПредыдущихРасчетах Тогда
				ОстатокНормативногоСрока = ДанныеСНП.НормативныйСрок - ДанныеСНП.ПользованиеВПредыдущихРасчетах;
			Иначе
				ОстатокНормативногоСрока = 0;
			КонецЕсли;
			
			Если ДанныеСНП.ПользованиеВсего > ОстатокНормативногоСрока Тогда
				ДанныеСНП.КоличествоСНПвЕдиницеИзмерения = ДанныеСНП.ПользованиеВсего - ОстатокНормативногоСрока;
			Иначе
				ДанныеСНП.КоличествоСНПвЕдиницеИзмерения = 0;
			КонецЕсли;
			
		Иначе
			ДанныеСНП.ПользованиеВсего = 0;
			ДанныеСНП.КоличествоСНПвЕдиницеИзмерения = 0;
		КонецЕсли;
		
		Если ДанныеСНП.КоличествоСНПвЕдиницеИзмерения > 0 Тогда
			
			//Расчет суммы
			//Ставки = ПрогрессивнаяШкалаСНП.НайтиСтроки(Новый Структура("ПСЦ, ГУИДСтроки", ДанныеСНП.ПСЦ, ДанныеСНП.ГУИДСтрокиПротокола));
			Если ДанныеСНП.СтавкаПрогрессивная Тогда
				
				КоличествоСНП = ДанныеСНП.КоличествоСНПвЕдиницеИзмерения;
				КоличествоСНПОстаток = КоличествоСНП;
				СуммаСНП = 0;
				
				//ТаблицаСтавок = Объект.ПрогрессивнаяШкалаСНП.Выгрузить(Ставки);
				//ТаблицаСтавок.Сортировать("НомерСтроки");
				
				Для Каждого СтрокаСтавки Из Ставки Цикл
					
					Если СтрокаСтавки.От = 0 И СтрокаСтавки.До = 0 Тогда
						КоличествоПоСтавке = КоличествоСНПОстаток;
					ИначеЕсли СтрокаСтавки.От = 0 И СтрокаСтавки.До > 0 Тогда
						КоличествоПоСтавке = СтрокаСтавки.До;
					ИначеЕсли СтрокаСтавки.От > 0 И СтрокаСтавки.До > СтрокаСтавки.От Тогда
						КоличествоПоСтавке = СтрокаСтавки.До - СтрокаСтавки.От + 1;
					ИначеЕсли СтрокаСтавки.От > 0 И строкаСтавки.До = 0 Тогда
						КоличествоПоСтавке = КоличествоСНПОстаток;
					Иначе
						КоличествоПоСтавке = 0;
					КонецЕсли;
						
					КоличествоПоСтавке = Мин(КоличествоСНПОстаток, КоличествоПоСтавке);
					СуммаПоСтавке = КоличествоПоСтавке * СтрокаСтавки.Стоимость;
					
					СтрокаСтавки.Количество = КоличествоПоСтавке;
					СтрокаСтавки.Сумма = СуммаПоСтавке;
					
					СуммаСНП = СуммаСНП + СуммаПоСтавке;
					КоличествоСНПОстаток = КоличествоСНПОстаток - КоличествоПоСтавке;
					Если КоличествоСНПОстаток = 0 Тогда
						Прервать;
					КонецЕсли;
					
				КонецЦикла;
				
				СтавкаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСтавкуНДС(ДанныеСНП.СтавкаНДС);
				СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСуммуНДС(СуммаСНП, СтавкаНДС, Истина, ДанныеСНП.СтавкаВключаетНДС); 
				ДанныеСНП.ОбщаяСуммаСНП = ?(ДанныеСНП.СтавкаВключаетНДС, СуммаСНП, СуммаСНП + СуммаНДС);
					
			Иначе
				
				Если Ставки.Количество() = 1 Тогда
					СтрокаСтавки = Ставки[0];
					СуммаСНП = ДанныеСНП.КоличествоСНПвЕдиницеИзмерения * СтрокаСтавки.Стоимость;
					
					СтрокаСтавки.Количество = ДанныеСНП.КоличествоСНПвЕдиницеИзмерения;
					СтрокаСтавки.Сумма = СуммаСНП;
					
					СтавкаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСтавкуНДС(ДанныеСНП.СтавкаНДС);
					СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСуммуНДС(СуммаСНП, СтавкаНДС, Истина, ДанныеСНП.СтавкаВключаетНДС); 
					ДанныеСНП.ОбщаяСуммаСНП = ?(ДанныеСНП.СтавкаВключаетНДС, СуммаСНП, СуммаСНП + СуммаНДС);
				Иначе
					ДанныеСНП.ОбщаяСуммаСНП = 0;
					//Путь = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Список", ДанныеСНП.НомерСтроки, "Ставка");
					//ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось получить ставку по строке " + ДанныеСНП.НомерСтроки,,, Путь);					
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			Для Каждого Стр Из Ставки Цикл
				Стр.Количество = 0;
				Стр.Сумма = 0;
			КонецЦикла;
			
			ДанныеСНП.ОбщаяСуммаСНП = 0;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДатаНачала) Тогда
		
			Если ДанныеСНП.ЕдиницаИзмеренияРасчетаСНП = ПредопределенноеЗначение("Перечисление.ЕдиницыИзмеренияВремениРасчетаСНП.Часы") Тогда
				
				КоличествоЧасовДоНаступленияСНП = ДанныеСНП.НормативныйСрок - ДанныеСНП.ПользованиеВПредыдущихРасчетах;
				Если КоличествоЧасовДоНаступленияСНП >= 0 Тогда
					ДанныеСНП.ПредполагаемаяДатаНачалаСНП = ДатаНачала + КоличествоЧасовДоНаступленияСНП * КоличествоСекундВЧасе;
					Если ЗначениеЗаполнено(ДатаОкончания) Тогда
						Если ДанныеСНП.ПредполагаемаяДатаНачалаСНП > ДатаОкончания Тогда
							ДанныеСНП.ПредполагаемаяДатаНачалаСНП = ПустаяДата;
						КонецЕсли;
					КонецЕсли;
				Иначе
					ДанныеСНП.ПредполагаемаяДатаНачалаСНП = ПустаяДата;
				КонецЕсли;
				
			Иначе
				
				КоличествоДнейДоНаступленияСНП = ДанныеСНП.НормативныйСрок - ДанныеСНП.ПользованиеВПредыдущихРасчетах;
				Если КоличествоДнейДоНаступленияСНП >= 0 Тогда
					ДанныеСНП.ПредполагаемаяДатаНачалаСНП = ДатаНачала + КоличествоДнейДоНаступленияСНП * КоличествоСекундВСутках;
					Если ЗначениеЗаполнено(ДатаОкончания) Тогда
						Если ДанныеСНП.ПредполагаемаяДатаНачалаСНП > ДатаОкончания Тогда
							ДанныеСНП.ПредполагаемаяДатаНачалаСНП = ПустаяДата;
						КонецЕсли;
					КонецЕсли;
				Иначе
					ДанныеСНП.ПредполагаемаяДатаНачалаСНП = ПустаяДата;
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			ДанныеСНП.ПредполагаемаяДатаНачалаСНП = ПустаяДата;
		КонецЕсли;
		
		ДополнительныеПоказатели = Новый Структура;
		ДополнительныеПоказатели.Вставить("СНПнаТекущуюДату");		
		//Если ДанныеСНП.ПредполагаемаяДатаНачалаСНП <> ПустаяДата И ДанныеСНП.ПредполагаемаяДатаНачалаСНП <= ТекущийДень Тогда
			//Если ЗначениеЗаполнено(ДатаОкончания) И ДатаОкончания < ТекущийДень Тогда
			//	ДополнительныеПоказатели.СНПнаТекущуюДату = (ДатаОкончания - ДанныеСНП.ПредполагаемаяДатаНачалаСНП) / КоличествоСекундВСутках + 1;
			//Иначе
			//	ДополнительныеПоказатели.СНПнаТекущуюДату = (ТекущийДень - ДанныеСНП.ПредполагаемаяДатаНачалаСНП) / КоличествоСекундВСутках + 1;
			//КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеСНП.ПредполагаемаяДатаНачалаСНП) И ДанныеСНП.ПредполагаемаяДатаНачалаСНП <= ТекущийДень И Не ЗначениеЗаполнено(ДатаОкончания) Тогда
			ДополнительныеПоказатели.СНПнаТекущуюДату = (ТекущийДень - ДанныеСНП.ПредполагаемаяДатаНачалаСНП) / КоличествоСекундВСутках + 1;
		Иначе
			ДополнительныеПоказатели.СНПнаТекущуюДату = 0;
		КонецЕсли;
		
		ДополнительныеПоказатели.Вставить("ОсталосьДоНаступленияСНП");		
		Если ЗначениеЗаполнено(ДанныеСНП.ПредполагаемаяДатаНачалаСНП) И ДанныеСНП.ПредполагаемаяДатаНачалаСНП > ТекущийДень И (Не ЗначениеЗаполнено(ДатаОкончания) Или ДатаОкончания > ДанныеСНП.ПредполагаемаяДатаНачалаСНП) Тогда
			ДополнительныеПоказатели.ОсталосьДоНаступленияСНП = (ДанныеСНП.ПредполагаемаяДатаНачалаСНП - ТекущийДень) / КоличествоСекундВСутках;
		Иначе
			ДополнительныеПоказатели.ОсталосьДоНаступленияСНП = 0;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ДанныеСНП, ДополнительныеПоказатели);
			
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьТекстСтавки(СтрокиШкалы) Экспорт
	
	ТекстСтавки = "";
	Для каждого Стр из СтрокиШкалы Цикл
			
		Если Стр.От = 0 И Стр.До = 0 Тогда
			ТекстСтавки = Строка(Стр.Стоимость);
		ИначеЕсли Стр.От = 0 И Стр.До <> 0 Тогда
			ТекстСтавки = "От 0 до "+Стр.До+" - "+Стр.Стоимость+Символы.ПС;
		ИначеЕсли Стр.От <> 0 И Стр.До <> 0 Тогда
			ТекстСтавки = ТекстСтавки+"С "+Стр.От+" до "+Стр.До+" - "+Стр.Стоимость+Символы.ПС;
		ИначеЕсли Стр.От <> 0 И Стр.До = 0 Тогда
			ТекстСТавки = ТекстСтавки+"С "+Стр.От+" и далее - "+Стр.Стоимость;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТекстСтавки;
	
КонецФункции
