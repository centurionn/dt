	               |		
	               |				ОБЪЕДИНИТЬ ВСЕ
	               |		
	               |				ВЫБРАТЬ
	               |					АналогиЛокаций.Локация
	               |				ИЗ
	               |					РегистрСведений.АналогиЛокаций КАК АналогиЛокаций
	               |				ГДЕ
	               |					АналогиЛокаций.Аналог = &ПунктНазначения))";
	
	Запрос.УстановитьПараметр("Вагоны", Вагоны);
	Запрос.УстановитьПараметр("ПунктОтправления", 	ПунктОтправления);
