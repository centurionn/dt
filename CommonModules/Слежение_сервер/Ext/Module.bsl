Функция ПолучитьЖДНПоВагонуИКТК(Вагон, КТК) Экспорт
	
	Результат = Новый Структура("ЖДН, ЖДНСсылка");//Гудкова"";
	
	Запрос = Новый Запрос;
//Евросиб Гудкова( 02.01.2020
//было
	//Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	//               |	ДислокацияКонтейнеров.НомерНакладной КАК НомерНакладной
	//               |ИЗ
	//               |	РегистрСведений.ДислокацияКонтейнеров КАК ДислокацияКонтейнеров
	//               |ГДЕ
	//               |	ДислокацияКонтейнеров.Контейнер = &Контейнер
	//               |	И ДислокацияКонтейнеров.Вагон = &Вагон
	//               |
	//               |УПОРЯДОЧИТЬ ПО
	//               |	ДислокацияКонтейнеров.Период УБЫВ";
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДислокацияКонтейнеров.НомерНакладной КАК ЖДН,
	               |	ТранспортныйДокумент.Ссылка КАК ЖДНСсылка,
	               |	ДислокацияКонтейнеров.Период КАК Период
	               |ИЗ
	               |	РегистрСведений.ДислокацияКонтейнеров КАК ДислокацияКонтейнеров
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.э_Накладная КАК э_Накладная
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	               |			ПО э_Накладная.Ссылка = ТранспортныйДокумент.НакладнаяЭТРАН
	               |		ПО ДислокацияКонтейнеров.НомерНакладной = э_Накладная.Номер
	               |			И (э_Накладная.Дата МЕЖДУ &МесяцНазад И &МесяцВперед)
	               |ГДЕ
	               |	ДислокацияКонтейнеров.Контейнер = &Контейнер
	               |	И ДислокацияКонтейнеров.Вагон = &Вагон
	               |	И ДислокацияКонтейнеров.Период МЕЖДУ &МесяцНазад И &МесяцВперед
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	э_НакладнаяВагоны.Ссылка.Номер,
	               |	ТранспортныйДокумент.Ссылка,
	               |	э_НакладнаяВагоны.Ссылка.Дата
	               |ИЗ
	               |	Справочник.ТЕ КАК ТЕ
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.э_Накладная.Контейнеры КАК э_НакладнаяКонтейнеры
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.э_Накладная.Вагоны КАК э_НакладнаяВагоны
	               |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТС КАК ТС
	               |				ПО (ТС.Наименование = э_НакладнаяВагоны.НомерВагона)
	               |			ПО э_НакладнаяКонтейнеры.Ссылка = э_НакладнаяВагоны.Ссылка
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	               |			ПО э_НакладнаяКонтейнеры.Ссылка = ТранспортныйДокумент.НакладнаяЭТРАН
	               |		ПО ТЕ.Наименование = э_НакладнаяКонтейнеры.НомерКонтейнера
	               |ГДЕ
	               |	ТЕ.Ссылка = &Контейнер
	               |	И ТС.Ссылка = &Вагон
	               |	И э_НакладнаяКонтейнеры.Ссылка.Дата МЕЖДУ &МесяцНазад И &МесяцВперед
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период УБЫВ";

	Запрос.УстановитьПараметр("МесяцНазад", ДобавитьМесяц(ТекущаяДата(), -1)); //хотя бы так, но алгоритм надо в обеих процедурах исправлять
	Запрос.УстановитьПараметр("МесяцВперед", ДобавитьМесяц(ТекущаяДата(), 1));
// Евросиб Гудкова) 	
	Запрос.УстановитьПараметр("Контейнер", КТК);
	Запрос.УстановитьПараметр("Вагон", Вагон);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		//было Результат = Ответ.НомерНакладной;
		ЗаполнитьЗначенияСвойств(Результат, Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// блок движения статусов операций по слежению

Процедура ДвижениеОперацийПоСлежению() Экспорт
	
	МинусИзКонстант = Константы.ДвижениеОперацийПоСлежениюДельтаМинусДней.Получить();
	ПлюсИзКонстант = Константы.ДвижениеОперацийПоСлежениюДельтаПлюсДней.Получить();
	
	ДельтаМинусДней = ?(МинусИзКонстант = 0,5,МинусИзКонстант);
	ДельтаПлюсДней = ?(ПлюсИзКонстант = 0,30,ПлюсИзКонстант);
	
	// сначала отрабатываем операции, которые закончились
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОперацииДляДвиженияПоСлежению.Операция КАК Операция,
	               |	ОперацииДляДвиженияПоСлежению.ДатаНачала КАК ДатаНачала,
	               |	ОперацииДляДвиженияПоСлежению.ДатаОкончания КАК ДатаОкончания,
	               |	ОперацииДляДвиженияПоСлежению.СписокТС КАК СписокТС,
	               |	ОперацииДляДвиженияПоСлежению.СписокТЕ КАК СписокТЕ,
	               |	ОперацииДляДвиженияПоСлежению.ОперацияНачата КАК ОперацияНачата,
	               |	ОперацииДляДвиженияПоСлежению.Операция.ПунктНазначения КАК ОперацияПунктНазначения,
	               |	ОперацииДляДвиженияПоСлежению.Операция.ПунктОтправления КАК ОперацияПунктОтправления
	               |ИЗ
	               |	РегистрСведений.ОперацииДляДвиженияПоСлежению КАК ОперацииДляДвиженияПоСлежению
	               |ГДЕ
	               |	ОперацииДляДвиженияПоСлежению.ОперацияНачата";
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		РандТЕ = неопределено;
		РандТС = неопределено;
		Для каждого Стр из Ответ.Операция.Грузы Цикл
			Если ЗначениеЗаполнено(Стр.ТС) Тогда РандТС = Стр.ТС; КонецЕсли;
			Если ЗначениеЗаполнено(Стр.ТЕ) Тогда РандТЕ = Стр.ТЕ; КонецЕсли;
			Если ЗначениеЗаполнено(Стр.ТС) И ЗначениеЗаполнено(Стр.ТЕ) Тогда Прервать; КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(РандТЕ) Тогда
			ПериодПрохождения = ПоКонтейнеруСуществуетПрохождениеСтанцииЗаПериод(Ответ.ДатаОкончания-ДельтаМинусДней*24*3600, Ответ.ДатаОкончания+ДельтаПлюсДней*24*3600, Ответ.ОперацияПунктНазначения, РандТЕ);
			Если ПериодПрохождения <> неопределено Тогда
				ОтметитьВыполнениеОперацииДатой(Ответ.Операция, ПериодПрохождения);
			Иначе
				ПериодПрохождения = ПоВагонуСуществуетПрохождениеСтанцииЗаПериод(Ответ.ДатаОкончания-ДельтаМинусДней*24*3600, Ответ.ДатаОкончания+ДельтаПлюсДней*24*3600, Ответ.ОперацияПунктНазначения, РандТС);
				Если ПериодПрохождения <> неопределено Тогда
					ОтметитьВыполнениеОперацииДатой(Ответ.Операция, ПериодПрохождения);
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(РандТС) Тогда
			ПериодПрохождения = ПоВагонуСуществуетПрохождениеСтанцииЗаПериод(Ответ.ДатаОкончания-ДельтаМинусДней*24*3600, Ответ.ДатаОкончания+ДельтаПлюсДней*24*3600, Ответ.ОперацияПунктНазначения, РандТС);
			Если ПериодПрохождения <> неопределено Тогда
				ОтметитьВыполнениеОперацииДатой(Ответ.Операция, ПериодПрохождения);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	// теперь отработаем операции, которые еще не запустились. может быть, они первые или локации идут с разрывом
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОперацииДляДвиженияПоСлежению.Операция КАК Операция,
	               |	ОперацииДляДвиженияПоСлежению.ДатаНачала КАК ДатаНачала,
	               |	ОперацииДляДвиженияПоСлежению.ДатаОкончания КАК ДатаОкончания,
	               |	ОперацииДляДвиженияПоСлежению.СписокТС КАК СписокТС,
	               |	ОперацииДляДвиженияПоСлежению.СписокТЕ КАК СписокТЕ,
	               |	ОперацииДляДвиженияПоСлежению.ОперацияНачата КАК ОперацияНачата,
	               |	ОперацииДляДвиженияПоСлежению.Операция.ПунктНазначения КАК ОперацияПунктНазначения,
	               |	ОперацииДляДвиженияПоСлежению.Операция.ПунктОтправления КАК ОперацияПунктОтправления
	               |ИЗ
	               |	РегистрСведений.ОперацииДляДвиженияПоСлежению КАК ОперацииДляДвиженияПоСлежению
	               |ГДЕ
	               |	НЕ ОперацииДляДвиженияПоСлежению.ОперацияНачата";
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		РандТЕ = неопределено;
		РандТС = неопределено;
		Для каждого Стр из Ответ.Операция.Грузы Цикл
			Если ЗначениеЗаполнено(Стр.ТС) Тогда РандТС = Стр.ТС; КонецЕсли;
			Если ЗначениеЗаполнено(Стр.ТЕ) Тогда РандТЕ = Стр.ТЕ; КонецЕсли;
			Если ЗначениеЗаполнено(Стр.ТС) И ЗначениеЗаполнено(Стр.ТЕ) Тогда Прервать; КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(РандТЕ) Тогда
			ПериодПрохождения = ПоКонтейнеруСуществуетПрохождениеСтанцииЗаПериод(Ответ.ДатаНачала-ДельтаМинусДней*24*3600, Ответ.ДатаНачала+ДельтаПлюсДней*24*3600, Ответ.ОперацияПунктОтправления, РандТЕ);
			Если ПериодПрохождения <> неопределено Тогда
				ОтметитьНачалоОперацииДатой(Ответ.Операция, ПериодПрохождения);
			Иначе
				ПериодПрохождения = ПоВагонуСуществуетПрохождениеСтанцииЗаПериод(Ответ.ДатаНачала-ДельтаМинусДней*24*3600, Ответ.ДатаНачала+ДельтаПлюсДней*24*3600, Ответ.ОперацияПунктОтправления, РандТС);
				Если ПериодПрохождения <> неопределено Тогда
					ОтметитьНачалоОперацииДатой(Ответ.Операция, ПериодПрохождения);
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(РандТС) Тогда
			ПериодПрохождения = ПоВагонуСуществуетПрохождениеСтанцииЗаПериод(Ответ.ДатаНачала-ДельтаМинусДней*24*3600, Ответ.ДатаНачала+ДельтаПлюсДней*24*3600, Ответ.ОперацияПунктОтправления, РандТС);
			Если ПериодПрохождения <> неопределено Тогда
				ОтметитьНачалоОперацииДатой(Ответ.Операция, ПериодПрохождения);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтметитьВыполнениеОперацииДатой(Операция, Дата)
	
	ОперацииСервер.ОтметитьВыполнениеОперацииИЗапуститьСледующиеЕслиОниВСтык(Операция, дата);
	
	Сообщить("Обновлена операция " + Операция + " указана дата выполнения" + Дата);
	
КонецПроцедуры

Процедура ОтметитьНачалоОперацииДатой(Операция, Дата)
	
	ОперацииСервер.ЗапуститьВРаботуИОтметитьДатуНачала(Операция, Дата);
	
	Сообщить("Обновлена операция " + Операция + " указана дата начала" + Дата);
	
КонецПроцедуры

Функция ПоКонтейнеруСуществуетПрохождениеСтанцииЗаПериод(Дата1, Дата2, СтанцияОперации, Контейнер)
	
	Результат = неопределено;
	
	МассивЛокаций = новый Массив;
	ЗапросЛокаций = Новый Запрос;
	ЗапросЛокаций.Текст = "ВЫБРАТЬ
	                      |	АналогиЛокаций.Локация КАК Локация,
	                      |	АналогиЛокаций.Аналог КАК Аналог
	                      |ИЗ
	                      |	РегистрСведений.АналогиЛокаций КАК АналогиЛокаций
	                      |ГДЕ
	                      |	(АналогиЛокаций.Локация = &Локация
	                      |			ИЛИ АналогиЛокаций.Аналог = &Локация)";
	ЗапросЛокаций.УстановитьПараметр("Локация", СтанцияОперации);
	ОтветЛокаций = ЗапросЛокаций.Выполнить().Выбрать();
	Пока ОтветЛокаций.Следующий() Цикл
		МассивЛокаций.Добавить(ОтветЛокаций.Локация);
		МассивЛокаций.Добавить(ОтветЛокаций.Аналог);
	КонецЦикла;
	МассивЛокаций.Добавить(СтанцияОперации);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДислокацияКонтейнеров.Период КАК Период,
	               |	ДислокацияКонтейнеров.ОперацияСВагоном КАК ОперацияСВагоном
	               |ИЗ
	               |	РегистрСведений.ДислокацияКонтейнеров КАК ДислокацияКонтейнеров
	               |ГДЕ
	               |	ДислокацияКонтейнеров.Контейнер = &Контейнер
	               |	И ДислокацияКонтейнеров.Период МЕЖДУ &Период1 И &Период2
	               |	И ДислокацияКонтейнеров.СтанцияОперации В(&СтанцияОперации)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период";
	Запрос.УстановитьПараметр("Период1", Дата1);
	Запрос.УстановитьПараметр("Период2", Дата2);
	Запрос.УстановитьПараметр("Контейнер", Контейнер);
	Запрос.УстановитьПараметр("СтанцияОперации", МассивЛокаций);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Период;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

