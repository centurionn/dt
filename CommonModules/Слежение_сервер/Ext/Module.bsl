Функция ПолучитьПодходящийРейс(ПунктОтправления, ПунктНазначения, ПлановаяДатаОтправления, Вагон) Экспорт
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВагоныВОтправке.Отправка КАК Отправка
	               |ИЗ
	               |	РегистрСведений.ВагоныВОтправке КАК ВагоныВОтправке
	               |ГДЕ
	               |	ВагоныВОтправке.Вагон = &Вагон
	               |	И (ВагоныВОтправке.Отправка.ПунктОтправления = &ПунктОтправления
	               |			ИЛИ ВагоныВОтправке.Отправка.ПунктОтправления В
	               |				(ВЫБРАТЬ
	               |					АналогиЛокаций.Аналог КАК Локация
	               |				ИЗ
	               |					РегистрСведений.АналогиЛокаций КАК АналогиЛокаций
	               |				ГДЕ
	               |					АналогиЛокаций.Локация = &ПунктОтправления
	               |		
	               |				ОБЪЕДИНИТЬ ВСЕ
	               |		
	               |				ВЫБРАТЬ
	               |					АналогиЛокаций.Локация
	               |				ИЗ
	               |					РегистрСведений.АналогиЛокаций КАК АналогиЛокаций
	               |				ГДЕ
	               |					АналогиЛокаций.Аналог = &ПунктОтправления))
	               |	И ВагоныВОтправке.Отправка.ДатаОтправления МЕЖДУ &ДатаОтправления1 И &ДатаОтправления2
	               |	И (ВагоныВОтправке.Отправка.ПунктНазначения = &ПунктНазначения
	               |			ИЛИ ВагоныВОтправке.Отправка.ПунктНазначения В
	               |				(ВЫБРАТЬ
	               |					АналогиЛокаций.Аналог КАК Локация
	               |				ИЗ
	               |					РегистрСведений.АналогиЛокаций КАК АналогиЛокаций
	               |				ГДЕ
	               |					АналогиЛокаций.Локация = &ПунктНазначения
	               |		
	               |				ОБЪЕДИНИТЬ ВСЕ
	               |		
	               |				ВЫБРАТЬ
	               |					АналогиЛокаций.Локация
	               |				ИЗ
	               |					РегистрСведений.АналогиЛокаций КАК АналогиЛокаций
	               |				ГДЕ
	               |					АналогиЛокаций.Аналог = &ПунктНазначения))";
	Запрос.УстановитьПараметр("Вагон", Вагон);
	Запрос.УстановитьПараметр("ПунктОтправления", 	ПунктОтправления);
	Запрос.УстановитьПараметр("ПунктНазначения", 	ПунктНазначения);
	Запрос.УстановитьПараметр("ДатаОтправления1", 	ПлановаяДатаОтправления - 2*24*3600);
	Запрос.УстановитьПараметр("ДатаОтправления2", 	ПлановаяДатаОтправления + 2*24*3600);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		
		Результат = Ответ.Отправка;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

