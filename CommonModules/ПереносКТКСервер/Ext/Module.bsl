Функция НайтиСвязаннуюСделку(ЗаявкаСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СделкаЗаявки.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Сделка.Заявки КАК СделкаЗаявки
		|ГДЕ
		|	СделкаЗаявки.Заявка = &ЗаявкаСсылка
		|	И СделкаЗаявки.Ссылка.Проведен";
	
	Запрос.УстановитьПараметр("ЗаявкаСсылка", ЗаявкаСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = ?(РезультатЗапроса.Пустой(), Неопределено, РезультатЗапроса.Выгрузить()[0].Ссылка);
	
	Возврат Результат;

КонецФункции //Евросиб Коханенко Н.А. 22.08.2024 )) #89741 
