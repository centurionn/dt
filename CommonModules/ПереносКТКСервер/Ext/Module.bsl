			СтруктураОтвета = Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлючаАналитикиПеревозки); 
			КлючАналитикиЗаявкиПриемника = СтруктураОтвета.КлючАналитикиПеревозки;  
			//добавим пару ключей в соответствие для последующей подмены в запросе-источнике
