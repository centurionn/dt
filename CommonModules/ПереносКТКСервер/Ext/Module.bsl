
#Область ПеренесеноИзМодуля_УдалениеКТКИзСделки_Сервер
Процедура ПостановкаЗадачиВСлучаеИсключенияКТКИзСделкиПриНаличииРТУ_Сделка(ЭтотОбъект) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.Ссылка) Тогда Возврат; КонецЕсли;
	
	ЕстьХотьОднаУдаленнаяСтрока = Ложь;
	МассивОставшихсяКТК = Новый Массив;
	
	Для каждого Стр из ЭтотОбъект.СвязьУчетныхЕдиниц Цикл
		
		//Евросиб - АСуслов 24.05.2022 12:51:31 #
		//(
		//синхронизация с хранилищем, взял с рабочей
		Если Стр.Удалена = Ложь Тогда 
		//)
		//Евросиб - АСуслов 24.05.2022 12:51:37 #
			МассивОставшихсяКТК.Добавить(Стр.Контейнер);
		Иначе
			ЕстьХотьОднаУдаленнаяСтрока = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ЕстьХотьОднаУдаленнаяСтрока Тогда Возврат; КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	КлючевыеСобытияСделки.КТК КАК КТК,
	               |	КлючевыеСобытияСделки.Документ КАК Документ
	               |ИЗ
	               |	РегистрСведений.КлючевыеСобытияСделки КАК КлючевыеСобытияСделки
	               |ГДЕ
	               |	КлючевыеСобытияСделки.Сделка = &Сделка
	               |	И ТИПЗНАЧЕНИЯ(КлючевыеСобытияСделки.Документ) = ТИП(Документ.РеализацияТоваровУслуг)
	               |	И НЕ КлючевыеСобытияСделки.КТК В (&КТК)";
	Запрос.УстановитьПараметр("Сделка", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("КТК", МассивОставшихсяКТК);
	МассивУдаленныхКТК = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("КТК");
	
	Если МассивУдаленныхКТК.Количество() > 0 Тогда
		
		ИскСост = Справочники.Состояния.ТребуетсяИсключитьКонтейнерыИзРТУ;
		
		НайдСтр = ЭтотОбъект.Состояния.Найти(ИскСост, "Состояние");
		
		Если НайдСтр <> неопределено Тогда
			НСтр = НайдСтр;
		Иначе
			НСтр = ЭтотОбъект.Состояния.Добавить();
		КонецЕсли;
		
		НСтр.Состояние = ИскСост;
		НСтр.Исполнитель = ЭтотОбъект.Автор;
		НСтр.Наблюдатель = НСтр.Исполнитель;
		НСтр.ПримечаниеЗадачаИсполнителю = Истина;
		НСтр.Статус = Перечисления.СтатусыЭтапов.ВРаботе;              
		//Евросиб - АСуслов 17.01.2022 18:02:03 #45645
		//(
		СтрокаСписокКТК = СтрСоединить(МассивУдаленныхКТК, ", ");
		НСтр.Комментарий = "Исключить удаленные контейнеры из РТУ: " + СтрокаСписокКТК;
		ТекстСообщения = СтрШаблон("По сделке %1 необходимо исключить удаленные контейнеры из РТУ: %2",
									ЭтотОбъект,
									СтрокаСписокКТК);
		Сообщить(ТекстСообщения, СтатусСообщения.ОченьВажное);
		//)
		//Евросиб - АСуслов 17.01.2022 18:02:03 #45645
		
	КонецЕсли;
	
	
КонецПроцедуры

