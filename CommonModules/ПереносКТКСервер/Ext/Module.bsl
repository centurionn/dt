							КонецЕсли;  
							СтруктураОтвета = Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлючаАналитикиПеревозки); 
							Запись.КлючАналитикиПеревозки = СтруктураОтвета.КлючАналитикиПеревозки; 
							//обновляем Идентификатор строки услуги (из новой заявки)
							НовыйГУИДСтрокиУслуги = СписокКлючейИГУИДовСтрокЗаявкиПриемника.Найти(Запись.КлючАналитикиПеревозки, "КлючАналитикиПеревозки");
							Если НовыйГУИДСтрокиУслуги <> Неопределено Тогда
								Запись.ИдентификаторСтрокиУслуги = НовыйГУИДСтрокиУслуги.ГУИДСтроки; 
							КонецЕсли; 
							//выставляем чек-бокс "Обновлены исходные данные" перенесенного КТК
							Запись.ОбновленыИсходныеДанные = Истина;
						КонецЕсли;
        				ИндексСтроки = ИндексСтроки - 1;
    				КонецЦикла;					

					ЗапросИсточникОбъект.Записать(); 
					Если ЗапросПриемникОбъект.Контейнеры.Количество() > 0 Тогда
						ЗапросПриемникОбъект.Записать(РежимЗаписиДокумента.Проведение);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ОтложенноеИзменениеСервер.ПоставитьСвязанныеОбъектыВОчередьИзменения(ЗаявкаИсточникСсылка);
		
	//Евросиб Коханенко Н.А. 14.08.2024 (( #89741 
	ПривязатьАвансовыеСчетаКНовойЗаявке(Запрос, НоваяЗаявка, Документы.Сделка.ПустаяСсылка(), ЗаявкаИсточникСсылка);
	//Евросиб Коханенко Н.А. 14.08.2024 )) #89741  
	
	КонецЦикла;
	
	Возврат НоваяЗаявка.Ссылка;
	
