&НаСервере
Процедура ПеренестиКТКНаСервере(Параметры, АдресРезультата = Неопределено) Экспорт
	
	ЦелеваяЗаявка = Параметры.ЦелеваяЗаявка;
	ЗаявкаИсточникСсылка = Параметры.ЗаявкаИсточникСсылка;
	МассивГУИДов = Параметры.ЗаявкаИсточникМассивГУИДов;
	
	// Все операции по переносу КТК выполняем в одной транзакции
	// чтобы в случае ошибки отменились все созданные документы.
	НачатьТранзакцию();
	Попытка
		ПереносВыполненУспешно = Истина;
		ЗаявкаПриемникСсылка = ВыполнитьПереносКТКвДругуюЗаявку(ЦелеваяЗаявка, ПереносВыполненУспешно, ЗаявкаИсточникСсылка, МассивГУИДов);
		
		Если ПереносВыполненУспешно Тогда
			ЗафиксироватьТранзакцию();
			СтруктураРезультата = Новый Структура; 
			СтруктураРезультата.Вставить("ЕстьРезультат", Истина);
			СтруктураРезультата.Вставить("ЗаявкаПриемникСсылка", ЗаявкаПриемникСсылка);
			ПоместитьВоВременноеХранилище(СтруктураРезультата, АдресРезультата);
		Иначе
			ОтменитьТранзакцию();
		КонецЕсли;
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации("Перенос КТК в другую заявку",
									УровеньЖурналаРегистрации.Ошибка, 
									Метаданные.Документы.Заявка, 
									ЗаявкаИсточникСсылка, 
									ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ТекстСообщения = СтрШаблон("Не удалось выполнить перенос КТК в другую заявку. Ошибка: %1", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение ТекстСообщения;							
		ПереносВыполненУспешно = Ложь;
	КонецПопытки;
	
КонецПроцедуры //Евросиб Коханенко Н.А. 20.05.2024 )) #83866

