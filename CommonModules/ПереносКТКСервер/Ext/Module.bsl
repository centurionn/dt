			//старый ключ аналитики переносим в новую заявку, а в старой заявке создаем копию ключа
			НовыйКлючАналитикиПеревозки = ВыборкаДетальныеЗаписи.КлючАналитикиПеревозки.Скопировать();
			НовыйКлючАналитикиПеревозки.Записать();
			//и сохраняем ссылку скопированного ключа в строке Контейнеры запроса-источника
			СтрокаЗаявкиИсточника = ИсходнаяЗаявкаОбъект.СоставУслуги.Найти(ВыборкаДетальныеЗаписи.ГУИДСтроки, "ГУИДСтроки");
			Если СтрокаЗаявкиИсточника <> Неопределено Тогда
				СтрокаЗаявкиИсточника.КлючАналитикиПеревозки = НовыйКлючАналитикиПеревозки.Ссылка;
				//СтрокаЗаявкиИсточника.Релиз = ПредопределенноеЗначение("Документ.РелизКлиента.ПустаяСсылка");
			КонецЕсли;
			//обновим данные в перенесенном ключе аналитики	
			СтруктураКлючаАналитикиПеревозки = Справочники.КлючиАналитикиПеревозки.СтруктураКлючаАналитикиПеревозки();
