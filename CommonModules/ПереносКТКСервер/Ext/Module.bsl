			//ДИТ, Беляев СЮ, ТА55631, 10-08-2022, конец
			//Евросиб Каблов 16.11.2022 ( 52045
			НовСтр.ГУИДСтроки = Новый УникальныйИдентификатор;
			СоответствиеСтрокЗаявок.Вставить(ВыборкаДетальныеЗаписи.ГУИДСтроки, НовСтр.ГУИДСтроки);
