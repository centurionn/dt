							СтруктураКлючаАналитикиПеревозки = Справочники.КлючиАналитикиПеревозки.СтруктураКлючаАналитикиПеревозки();
							СтруктураКлючаАналитикиПеревозки.КлючАналитики = Запись.КлючАналитикиПеревозки;
							ЗапросПриемникСсылка = ?(ЗначениеЗаполнено(ЗапросПриемникОбъект.Ссылка), ЗапросПриемникОбъект.Ссылка, НоваяСсылка);
