							МеняемаяСтрокаЗапроса.СписокКТК = ЭТС;
							МеняемаяСтрокаЗапроса.КоличествоКТК = МассивКТК.Количество(); 
						КонецЦикла;
						Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяСсылка,"ЗапросНаКТК") тогда
							ОбщегоНазначения.СообщитьПользователю("Необходимо открыть " + НоваяСсылка + " для добавления перенесенного контейнера в запрос на КТК");
						КонецЕсли;	
					КонецЕсли;
				КонецЕсли;	
				//Субботин 77659 24.11.2023 Конец 
			КонецЦикла;
			
		КонецЦикла;
		
		ИсходнаяЗаявкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
		НоваяЗаявка.ДополнительныеСвойства.Вставить("ОтключитьВыводСообщений");
		НоваяЗаявка.Записать(РежимЗаписиДокумента.Проведение);
	
		//Евросиб Коханенко Н.А. 10.06.2024 (( #83866
		//получим структуру запросов на авто по первой и последней миле из заявки-источника, если есть
		СсылкиНаЗапросыНаАвтоИсхЗаявки = Документы.Заявка.ПолучитьСсылкиНаЗапросыНаАвтоперевозку(ИсходнаяЗаявкаОбъект.Ссылка);
		//получаем список ключей всех исключаемых (перенесенных) ктк по заявке-источнику
		МассивКлючейИсключаемыхКТК = РезультатЗаявки.Выгрузить().ВыгрузитьКолонку("КлючАналитикиПеревозки");
		//этот список нужен для подмены ГУИДов строк услуг в запросах на автоперевозку
		СписокКлючейИГУИДовСтрокЗаявкиПриемника = НоваяЗаявка.СоставУслуги.Выгрузить(, "КлючАналитикиПеревозки, ГУИДСтроки");  
		//для каждого запроса на авто смотрим, все ли ктк из запроса в таблице исключаемых 
		Для Каждого СсылкаНаЗапрос Из СсылкиНаЗапросыНаАвтоИсхЗаявки Цикл
			
			ЗапросИсточникСсылка = СсылкаНаЗапрос.Значение;
			//если запрос на авто существовал, то есть работа
			Если ЗапросИсточникСсылка <> ПредопределенноеЗначение("Документ.ЗапросНаАвтоперевозку.ПустаяСсылка") Тогда
				
				тз_КлючиКТКИзЗапроса = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗапросИсточникСсылка, "Контейнеры.КлючАналитикиПеревозки").Выгрузить();
				
				//составляем массив переносимых ктк по запросу на авто
				МассивПереносимыхКлючейКТКПоЗапросуНаАвто = Новый Массив;
				Для Каждого КлючАналитикиКТКИзЗапроса Из тз_КлючиКТКИзЗапроса Цикл
					РезультатПоискаВТаблицеИсключаемыхКТК = МассивКлючейИсключаемыхКТК.Найти(КлючАналитикиКТКИзЗапроса.КлючАналитикиПеревозки);
					Если РезультатПоискаВТаблицеИсключаемыхКТК <> Неопределено Тогда
						МассивПереносимыхКлючейКТКПоЗапросуНаАвто.Добавить(КлючАналитикиКТКИзЗапроса.КлючАналитикиПеревозки);
					КонецЕсли;
				КонецЦикла;
				
				Если МассивПереносимыхКлючейКТКПоЗапросуНаАвто.Количество() > 0 Тогда
					
					//получаем ЗапросНаАвто-источник
					ЗапросИсточникОбъект = ЗапросИсточникСсылка.ПолучитьОбъект();
					
					//формируем массив переносимых КТК
					Для Каждого СтрокаКТК из ЗапросИсточникОбъект.Контейнеры Цикл
						НомерКлючаВМассиве = МассивПереносимыхКлючейКТКПоЗапросуНаАвто.Найти(СтрокаКТК.КлючАналитикиПеревозки);
						Если НомерКлючаВМассиве <> Неопределено Тогда
							//если имеется информация о дате и времени вывоза
							//либо о дате завершения операции на складе 
							//в ТЧ "По данным из ИС "Транспортная логистика" - то нельзя переносить такую строку в новый запрос
							Если ЗначениеЗаполнено(СтрокаКТК.ДатаИВремяВывоза) 
								ИЛИ ЗначениеЗаполнено(СтрокаКТК.ДатаЗавершенияОперацииНаСкладеКлиента) Тогда
								//в ключе такого ктк очистим ссылку на запрос на автоперевозку и номер заказа на тс
								СтруктураКлючаАналитикиПеревозки = Справочники.КлючиАналитикиПеревозки.СтруктураКлючаАналитикиПеревозки();
								СтруктураКлючаАналитикиПеревозки.КлючАналитики = СоответствиеКлючейАналитики[МассивПереносимыхКлючейКТКПоЗапросуНаАвто[НомерКлючаВМассиве]];
								Если ЗапросИсточникОбъект.ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПерваяМиля Тогда 
									СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиПерваяМиляКлючаАналитики.ЗапросНаАвто = Документы.ЗапросНаАвтоперевозку.ПустаяСсылка();	
									СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиПерваяМиляКлючаАналитики.НомерЗаказаНаТС = "";
								Иначе
									СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиПоследняяМиляКлючаАналитики.ЗапросНаАвто = Документы.ЗапросНаАвтоперевозку.ПустаяСсылка(); 	
									СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиПоследняяМиляКлючаАналитики.НомерЗаказаНаТС = "";
								КонецЕсли;
								Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлючаАналитикиПеревозки);
