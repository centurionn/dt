Функция ПолучитьНомераКонтейнеровСНезакрытымСНП(МассивСтрокИсключаемыхКТК) Экспорт
	
	ПустаяДата = '00010101';
	
	ТаблицаЗаявок = Новый ТаблицаЗначений;
	ТаблицаЗаявок.Колонки.Добавить("Заявка", Новый ОписаниеТипов("ДокументСсылка.Заявка"));
	ТаблицаЗаявок.Колонки.Добавить("ГУИДСтрокиЗаявки", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(36)));
	
	Для Каждого Стр Из МассивСтрокИсключаемыхКТК Цикл
		НоваяСтрока = ТаблицаЗаявок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр, "Заявка, ГУИДСтрокиЗаявки");
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаЗаявок.Заявка КАК Заявка,
	|	ТаблицаЗаявок.ГУИДСтрокиЗаявки КАК ГУИДСтрокиЗаявки
	|ПОМЕСТИТЬ СтрокиЗаявки
	|ИЗ
	|	&ТаблицаЗаявок КАК ТаблицаЗаявок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасчетСНП.Ссылка КАК Расчет,
	|	РасчетСНП.КлючАналитикиПеревозки.Контейнер КАК Контейнер,
	|	РасчетСНП.КлючАналитикиПеревозки.Контейнер.Наименование КАК НомерКонтейнера
	|ИЗ
	|	СтрокиЗаявки КАК СтрокиЗаявки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РасчетСНП КАК РасчетСНП
	|			ПО ЗаявкаСоставУслуги.КлючАналитикиПеревозки = РасчетСНП.КлючАналитикиПеревозки
	|		ПО СтрокиЗаявки.Заявка = ЗаявкаСоставУслуги.Ссылка
	|			И СтрокиЗаявки.ГУИДСтрокиЗаявки = ЗаявкаСоставУслуги.ГУИДСтроки
	|ГДЕ
	|	РасчетСНП.Проведен
	|	И НЕ РасчетСНП.СНПЗакрыто
	|	И РасчетСНП.ФактическаяДатаНачала <> &ПустаяДата";
	
	Запрос.УстановитьПараметр("ТаблицаЗаявок", ТаблицаЗаявок);
	Запрос.УстановитьПараметр("ПустаяДата", ПустаяДата);	
	
	КонтейнерыСНезакрытымСНП = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("НомерКонтейнера");
	
	Возврат КонтейнерыСНезакрытымСНП;
	
КонецФункции
#КонецОбласти

