		//НоваяСсылка = Документы.Заявка.ПолучитьСсылку(); //ДИТ, Беляев СЮ, Ticket#0308622, 25-04-2023, закомментировал, перенесено выше
		//НоваяЗаявка.УстановитьСсылкуНового(НоваяСсылка); //ДИТ, Беляев СЮ, Ticket#0308622, 25-04-2023, закомментировал, перенесено выше
		//Евросиб Каблов 26.12.2022 )

		//Евросиб Каблов 16.11.2022 ( 52045
		СоответствиеСтрокЗаявок = Новый Соответствие;
		//Евросиб Каблов 16.11.2022 )  
		
		//Евросиб Коханенко Н.А. 08.07.2024 (( #83866
		СоответствиеКлючейАналитики = Новый Соответствие;
		//Евросиб Коханенко Н.А. 08.07.2024 )) #83866 
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			НовСтр = ТЧЗаявка.Добавить();
			//ЗаполнитьЗначенияСвойств(НовСтр,ВыборкаДетальныеЗаписи); 
