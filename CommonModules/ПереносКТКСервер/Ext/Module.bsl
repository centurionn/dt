&НаСервере
Функция ВыполнитьПереносКТКвДругуюЗаявку(ЦелеваяЗаявка, ПереносВыполненУспешно, ЗаявкаИсточникСсылка, МассивГУИДов)
	
	ЗапросДляВТ = Новый Запрос;
	ЗапросДляВТ.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	                    |	ИСТИНА КАК БезЖДН,
	                    |	ВЫРАЗИТЬ(&ЗаявкаИсточник КАК Документ.Заявка) КАК Заявка,
	                    |	ЗаявкаСоставУслуги.ГУИДСтроки КАК ГУИДСтрокиЗаявки,
	                    |	ЗаявкаСоставУслуги.НомерКТК КАК Контейнер
	                    |ИЗ
	                    |	Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
	                    |ГДЕ
	                    |	ЗаявкаСоставУслуги.Ссылка = &ЗаявкаИсточник
	                    |	И ЗаявкаСоставУслуги.ГУИДСтроки В(&МассивГУИДов)";
	ЗапросДляВТ.УстановитьПараметр("ЗаявкаИсточник", ЗаявкаИсточникСсылка);
	ЗапросДляВТ.УстановитьПараметр("МассивГУИДов", МассивГУИДов);
	РезультатЗапросаДляВТ = ЗапросДляВТ.Выполнить().Выгрузить();

	Запрос = Новый Запрос; 
	
	// Евросиб Фролов (18.02.2022 Task №46889
	// Для поиска счетов потребуется таблица ВТ.
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;	
	// Евросиб Фролов)

	
	Запрос.Текст = ПолучитьТекстЗапросаДанныхПоЗаявкамРелизам();
	Запрос.УстановитьПараметр("ВремТЧ", РезультатЗапросаДляВТ);
	
	//Субботин 77659 24.11.2023 Начало // переделал на пакеты
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	РезультатЗаявки = РезультатЗапроса[1];
	РезультатРелизы = РезультатЗапроса[2].Выгрузить();
	ВыборкаЗаявка = РезультатЗаявки.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	//Субботин 77659 24.11.2023 Конец
	Пока ВыборкаЗаявка.Следующий() Цикл
	
		ВыборкаДетальныеЗаписи = ВыборкаЗаявка.Выбрать();
		
		Если ЦелеваяЗаявка = Истина //перенос в новую заявку
			Или ТипЗнч(ЦелеваяЗаявка) = Тип("ДокументСсылка.Сделка") Тогда
			НоваяЗаявка = ВыборкаЗаявка.Заявка.Скопировать();
			НоваяЗаявка.СоставУслуги.Очистить();
			//Евросиб Каблов 26.12.2022 ( 62514
		    НоваяЗаявка.ЗапросНаКТК = Ложь;
			НоваяЗаявка.ДокументОснование = ВыборкаЗаявка.Заявка;
			//Евросиб Каблов 26.12.2022 )
			//ДИТ, Беляев СЮ, Ticket#0308622, 25-04-2023, начало
			НоваяСсылка = Документы.Заявка.ПолучитьСсылку();
			НоваяЗаявка.УстановитьСсылкуНового(НоваяСсылка);
			//ДИТ, Беляев СЮ, Ticket#0308622, 25-04-2023, конец
			//Евросиб Коханенко Н.А. 10.06.2024 (( #83866 
			НоваяЗаявка.УстановитьНовыйНомер();
			НоваяЗаявка.Дата = ТекущаяДата(); //для новой заявки устанавливаем новую дату
			ЭтоНоваяЗаявка = Истина;
			//Евросиб Коханенко Н.А. 10.06.2024 )) #83866 
		Иначе //перенос в существующую заявку
			НоваяЗаявка = ЦелеваяЗаявка.ПолучитьОбъект();
			//ДИТ, Беляев СЮ, Ticket#0308622, 25-04-2023, начало
			НоваяСсылка = НоваяЗаявка.Ссылка;
			//ДИТ, Беляев СЮ, Ticket#0308622, 25-04-2023, конец
			//Евросиб Коханенко Н.А. 10.06.2024 (( #83866
			ЭтоНоваяЗаявка = Ложь;
			//получим структуру запросов на авто по первой и последней миле из заявки-приемника, если есть
			СсылкиНаЗапросыНаАвтоЗаявкиПриемника = Документы.Заявка.ПолучитьСсылкиНаЗапросыНаАвтоперевозку(НоваяСсылка);
			//Евросиб Коханенко Н.А. 10.06.2024 )) #83866 
		КонецЕсли;
		
		ИсходнаяЗаявкаОбъект = ВыборкаЗаявка.Заявка.ПолучитьОбъект();
		
		ТЧЗаявка = НоваяЗаявка.СоставУслуги;

		//Евросиб Каблов 26.12.2022 ( 62514
		//// записать,чтобы получить ссылку, но не проводить. провести только после проведения старой заявки
		//НоваяЗаявка.Записать(РежимЗаписиДокумента.Запись);
