Функция ПоЭтойЗаявкеЕстьОплаченныйАвансСчет(Заявка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СчетНаОплатуПокупателю.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ПоступлениеНаРасчетныйСчет.РазнесениеНаСчетаПокупателям КАК ПоступлениеНаРасчетныйСчетРазнесениеНаСчетаПокупателям
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю
	               |		ПО ПоступлениеНаРасчетныйСчетРазнесениеНаСчетаПокупателям.СчетПокупателю = СчетНаОплатуПокупателю.Ссылка
	               |ГДЕ
	               |	СчетНаОплатуПокупателю.ДокументыОснования.Документ = &Заявка
	               |	И СчетНаОплатуПокупателю.ПометкаУдаления = ЛОЖЬ
	               |	И ПоступлениеНаРасчетныйСчетРазнесениеНаСчетаПокупателям.Ссылка.ПометкаУдаления = ЛОЖЬ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СчетНаОплатуПокупателюДокументыОснования.Ссылка
	               |ИЗ
	               |	Документ.СчетНаОплатуПокупателю.ДокументыОснования КАК СчетНаОплатуПокупателюДокументыОснования
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеНаРасчетныйСчет.РазнесениеНаСчетаПокупателям КАК ПоступлениеНаРасчетныйСчетРазнесениеНаСчетаПокупателям
	               |		ПО СчетНаОплатуПокупателюДокументыОснования.Ссылка = ПоступлениеНаРасчетныйСчетРазнесениеНаСчетаПокупателям.СчетПокупателю
	               |ГДЕ
	               |	СчетНаОплатуПокупателюДокументыОснования.Документ = &Заявка
	               |	И СчетНаОплатуПокупателюДокументыОснования.Ссылка.ПометкаУдаления = ЛОЖЬ
	               |	И ПоступлениеНаРасчетныйСчетРазнесениеНаСчетаПокупателям.Ссылка.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("Заявка", Заявка);
	Возврат НЕ Запрос.Выполнить().Пустой();
	
