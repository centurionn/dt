Процедура УведомлениеОНеобходимостиНаполнитьПоезда() Экспорт
	
	ИнформироватьОНеполнойЗагрузкеРейсаЗа = Константы.ИнформироватьОНеполнойЗагрузкеРейсаЗа.Получить();
	
	Если ИнформироватьОНеполнойЗагрузкеРейсаЗа = 0 Тогда Возврат; КонецЕсли;
	
	АдресаИнформированияОНеполнойЗагрузкеРейсов = Константы.АдресаИнформированияОНеполнойЗагрузкеРейсов.Получить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПродажиРейсов.Рейс КАК Рейс,
	               |	МАКСИМУМ(ПродажиРейсов.ДоступноТЕУ) КАК ДоступноТЕУ,
	               |	СУММА(ПродажиРейсов.ПроданоТЕУ) КАК ПроданоТЕУ,
	               |	ПродажиРейсов.Рейс.ПунктОтправления КАК РейсПунктОтправления,
	               |	ПродажиРейсов.Рейс.ПунктНазначения КАК РейсПунктНазначения,
	               |	ПродажиРейсов.Рейс.ДатаОтправления КАК РейсДатаОтправления,
	               |	ПродажиРейсов.Рейс.ДатаПрибытия КАК РейсДатаПрибытия,
	               |	ПродажиРейсов.Рейс.Сервис КАК РейсСервис,
	               |	ПродажиРейсов.Рейс.Продукт КАК РейсПродукт
	               |ИЗ
	               |	РегистрСведений.ПродажиРейсов КАК ПродажиРейсов
	               |ГДЕ
	               |	ПродажиРейсов.Рейс.ДатаОтправления < ДОБАВИТЬКДАТЕ(&Сегодня, ДЕНЬ, &КоличествоДнейПлюс)
	               |	И ПродажиРейсов.Рейс.ДатаОтправления > &Сегодня
	               |	И НЕ ПродажиРейсов.Рейс.ТехРейс
	               |	И НЕ ПродажиРейсов.Рейс.ПовагоннаяОтправка
	               |	И НЕ ПродажиРейсов.Рейс.РейсОтменен
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПродажиРейсов.Рейс,
	               |	ПродажиРейсов.Рейс.ПунктОтправления,
	               |	ПродажиРейсов.Рейс.ПунктНазначения,
	               |	ПродажиРейсов.Рейс.ДатаОтправления,
	               |	ПродажиРейсов.Рейс.ДатаПрибытия,
	               |	ПродажиРейсов.Рейс.Сервис,
	               |	ПродажиРейсов.Рейс.Продукт
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	РейсДатаОтправления";
	Запрос.УстановитьПараметр("Сегодня", ТекущаяДата());
	Запрос.УстановитьПараметр("КоличествоДнейПлюс", ИнформироватьОНеполнойЗагрузкеРейсаЗа);
	Ответ = Запрос.Выполнить().Выбрать();
	ТекстТаблицы = "";
	Пока Ответ.Следующий() Цикл
		ТекстТаблицы = ТекстТаблицы + "<tr><td>"+Ответ.Рейс+"</td><td>"+Ответ.РейсДатаОтправления+"</td><td>"+Ответ.РейсДатаПрибытия+"</td><td>"+Ответ.РейсПунктОтправления+"</td><td>"+Ответ.РейсПунктНазначения+"</td><td>"+Ответ.РейсПродукт+"</td><td>"+Ответ.ДоступноТЕУ+"</td><td>"+Ответ.ПроданоТЕУ+"</td></tr>";
	КонецЦикла;
	
	Если ТекстТаблицы = "" Тогда Возврат; КонецЕсли;
	
	ТекстТаблицы = "По указанным поездам наблюдается недозаполненность: <br/><br/> <table border=1>" + "<tr><td>Рейс</td><td>Дата отправления</td><td>Дата прибытия</td><td>Пункт отправления</td><td>Пункт назначения</td><td>Продукт</td><td>Запланировано ТЕУ</td><td>ТЕУ по заявкам</td></tr>" + ТекстТаблицы + "</table>";
	
	//////////////////////////////////////////////////////////
	
	// первичная проверка на то, что мы вообще можем что-то отправить
	УчетнаяЗаписьПоУмолчанию = РаботаСПочтовымиСообщениями.ПроверитьСистемнаяУчетнаяЗаписьДоступна();
	
	Если не УчетнаяЗаписьПоУмолчанию Тогда возврат; КонецЕсли;
	СистемнаяУчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	АдресДублированияУведомлений = Константы.АдресДублированияОповещенийОЗадачах.Получить();
	
	Тема = "[DC рейсы] Рейсы, по которым не полная загрузка";
	
	ПолучателиПисьма = Новый Массив;
	Для каждого Адрес из СтрРазделить(АдресаИнформированияОНеполнойЗагрузкеРейсов,";", Ложь) Цикл
		ПолучателиПисьма.Добавить(Новый Структура("Представление, Адрес", "Адрес отслеживания", Адрес));
	КонецЦикла;
	Если ЗначениеЗаполнено(АдресДублированияУведомлений) Тогда
		Для каждого Адрес из СтрРазделить(АдресДублированияУведомлений, ";", Ложь) Цикл
			ПолучателиПисьма.Добавить(Новый Структура("Представление, Адрес", "Адрес отслеживания", Адрес));
		КонецЦикла;
	КонецЕсли;
	
	ПараметрыОтправкиПисьма = новый Структура;
	ПараметрыОтправкиПисьма.Вставить("Тема", Тема);
	ПараметрыОтправкиПисьма.Вставить("Тело", ТекстТаблицы);
	ПараметрыОтправкиПисьма.Вставить("ТипТекста", "HTML");
	ПараметрыОтправкиПисьма.Вставить("Кому", ПолучателиПисьма);
	
	РЕЗУЛЬТАТ = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(СистемнаяУчетнаяЗапись, ПараметрыОтправкиПисьма);
	
КонецПроцедуры

Процедура УдалитьДвиженияРегистраПродажиРейсов(ОбъектРегистратор) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	*
	               |ИЗ
	               |	РегистрСведений.ПродажиРейсов КАК ПродажиРейсов
	               |ГДЕ
				   |ПродажиРейсов.ОбъектРегистратор = &ОбъектРегистратор";
	
	Запрос.УстановитьПараметр("ОбъектРегистратор", ОбъектРегистратор);
