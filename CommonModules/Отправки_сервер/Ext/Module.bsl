	Пока Ответ.Следующий() Цикл
		МЗ = РегистрыСведений.ПродажиРейсов.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МЗ, Ответ);
		МЗ.Удалить();
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьТабельноеРасписаниеПоПараметрам(ПунктОтправления, ПунктНазначения) Экспорт
	
	Результат = Новый Структура("Расписание, ДобавитьКНачалу, ДобавитьКОкончанию, ТочноеВремяПрибытия");
	
	Если НЕ ЗначениеЗаполнено(ПунктОтправления) ИЛИ НЕ ЗначениеЗаполнено(ПунктНазначения) Тогда Возврат Результат; КонецЕсли;
	
	МассивПунктовОтправления = Локации_сервер.ПолучитьАналогиИСтанцииБлижеЧемУказано(ПунктОтправления, -1);
	МассивПунктовОтправления.Добавить(ПунктОтправления);
	МассивПунктовНазначения = Локации_сервер.ПолучитьАналогиИСтанцииБлижеЧемУказано(ПунктНазначения, -1);
	МассивПунктовНазначения.Добавить(ПунктНазначения);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТабельныеРасписанияРЖД.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ТабельныеРасписанияРЖД КАК ТабельныеРасписанияРЖД
	               |ГДЕ
	               |	ТабельныеРасписанияРЖД.ПунктОтправления В (&ПунктОтправления)
	               |	И ТабельныеРасписанияРЖД.ПунктНазначения В (&ПунктНазначения)
	               |	И НЕ ТабельныеРасписанияРЖД.ПометкаУдаления";
	Запрос.УстановитьПараметр("ПунктОтправления", МассивПунктовОтправления);
	Запрос.УстановитьПараметр("ПунктНазначения", МассивПунктовНазначения);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат.Расписание = Ответ.Ссылка;
		Результат.ДобавитьКНачалу = Ответ.Ссылка.Расписание[0].ВремяОтправления-Дата("00010101");
		Результат.ДобавитьКОкончанию = Ответ.Ссылка.ВсегоВПутиЧ*3600;
		Результат.ТочноеВремяПрибытия = Ответ.Ссылка.Расписание[Ответ.Ссылка.Расписание.Количество()-1].ВремяПрибытия-Дата("00010101");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
