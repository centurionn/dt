Функция ПолучитьМассивДочернихОтправок(отправка) Экспорт
	
	МассивНайденныхОтправок = Новый Массив;
	
	МассивНайденныхОтправок.Добавить(отправка);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РейсыЖД.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.РейсыЖД КАК РейсыЖД
	               |ГДЕ
	               |	НЕ РейсыЖД.ПометкаУдаления
	               |	И РейсыЖД.ПредыдущаяОтправка В(&МассивТекущих)
	               |	И НЕ РейсыЖД.Ссылка В (&МассивТекущих)";
	Запрос.УстановитьПараметр("МассивТекущих", МассивНайденныхОтправок);
	ЗапросВыполнить = Запрос.Выполнить();
	ЗащитаЦикла = 10;
	СчетчикЦикла = 1;
	Пока НЕ ЗапросВыполнить.Пустой() Цикл
		Если СчетчикЦикла > ЗащитаЦикла Тогда Прервать; КонецЕсли;
		Ответ = ЗапросВыполнить.Выбрать();
		Пока Ответ.Следующий() Цикл
			МассивНайденныхОтправок.Добавить(Ответ.Ссылка);
		КонецЦикла;
		Запрос.УстановитьПараметр("МассивТекущих", МассивНайденныхОтправок);
		ЗапросВыполнить = Запрос.Выполнить();
		СчетчикЦикла = СчетчикЦикла + 1;
	КонецЦикла;
	
	МассивНайденныхОтправок.Удалить(МассивНайденныхОтправок.Найти(отправка));
	
	Возврат МассивНайденныхОтправок;
	
КонецФункции

