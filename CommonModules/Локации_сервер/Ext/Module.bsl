Функция ПолучитьМассивРодителей(Локация, ВключаяТекущий) Экспорт
	
	Результат = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(Локация) Тогда Возврат Результат; КонецЕсли;
	
	ТекРодитель = Локация.Родитель;
	Пока ЗначениеЗаполнено(ТекРодитель) Цикл
		Результат.Добавить(ТекРодитель);
		ТекРодитель = ТекРодитель.Родитель;
	КонецЦикла;
	
	Если ВключаяТекущий = Истина Тогда Результат.Добавить(Локация); КОнецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьМассивПодчиненных(Локация, ВключаяТекущий) Экспорт
	
	Результат = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(Локация) Тогда Возврат Результат; КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Локации.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Локации КАК Локации
	               |ГДЕ
	               |	Локации.ПометкаУдаления = ЛОЖЬ
	               |	И Локации.Ссылка В ИЕРАРХИИ(&Ссылка)
	               |	И Локации.Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Локация);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		Результат.Добавить(Ответ.Ссылка);
		
	КонецЦикла;
	
	Если ВключаяТекущий = Истина Тогда Результат.Добавить(Локация); КОнецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьАналогиИСтанцииБлижеЧемУказано(Локация, Радиус) Экспорт
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	АналогиЛокаций.Локация КАК Локация,
	               |	АналогиЛокаций.Аналог КАК Аналог
	               |ИЗ
	               |	РегистрСведений.АналогиЛокаций КАК АналогиЛокаций
	               |ГДЕ
	               |	(АналогиЛокаций.Локация = &Локация
	               |			ИЛИ АналогиЛокаций.Аналог = &Локация)";
	Запрос.УстановитьПараметр("Локация", Локация);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		Если результат.Найти(Ответ.Локация) = неопределено Тогда Результат.Добавить(Ответ.Локация); КонецЕсли;
		Если результат.Найти(Ответ.Аналог) = неопределено Тогда Результат.Добавить(Ответ.Аналог); КонецЕсли;
	КонецЦикла;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	РасстоянияМеждуЛокациями.Локация1 КАК Локация1,
	               |	РасстоянияМеждуЛокациями.Локация2 КАК Локация2
	               |ИЗ
	               |	РегистрСведений.РасстоянияМеждуЛокациями КАК РасстоянияМеждуЛокациями
	               |ГДЕ
	               |	РасстоянияМеждуЛокациями.РасстояниеКМ <= &РасстояниеКМ
	               |	И (РасстоянияМеждуЛокациями.Локация1 = &Локация
	               |			ИЛИ РасстоянияМеждуЛокациями.Локация2 = &Локация)";
	Запрос.УстановитьПараметр("РасстояниеКМ", Радиус);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		Если результат.Найти(Ответ.Локация1) = неопределено Тогда Результат.Добавить(Ответ.Локация1); КонецЕсли;
		Если результат.Найти(Ответ.Локация2) = неопределено Тогда Результат.Добавить(Ответ.Локация2); КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьКодыАналоговСтанцииПоКоду(КодЛокации) Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить(КодЛокации);
	Если СтрДлина(КодЛокации) = 6 Тогда Результат.Добавить(Лев(КодЛокации, 5)); КонецЕсли;
	
	ИскЛокация = НайтиСтанциюПоНеполномуКоду(КодЛокации);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	АналогиЛокаций.Локация.КодЖДСтанции КАК Локация,
	               |	АналогиЛокаций.Аналог.КодЖДСтанции КАК Аналог
	               |ИЗ
	               |	РегистрСведений.АналогиЛокаций КАК АналогиЛокаций
	               |ГДЕ
	               |	(АналогиЛокаций.Локация = &Локация
	               |			ИЛИ АналогиЛокаций.Аналог = &Локация)";
	Запрос.УстановитьПараметр("Локация", ИскЛокация);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		Если результат.Найти(Ответ.Локация) = неопределено Тогда 
			Результат.Добавить(Ответ.Локация); 
			Если СтрДлина(Ответ.Локация) = 6 Тогда Результат.Добавить(Лев(Ответ.Локация, 5)); КонецЕсли;
		КонецЕсли;
		Если результат.Найти(Ответ.Аналог) = неопределено Тогда 
			Результат.Добавить(Ответ.Аналог); 
			Если СтрДлина(Ответ.Аналог) = 6 Тогда Результат.Добавить(Лев(Ответ.Аналог, 5)); КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

//ДИТ, Беляев СЮ, US 68284/ TA 68289, 11-05-2023, начало
Функция ПолучитьКодыАналоговСтанций(МассивСтанций) Экспорт
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	АналогиЛокаций.Локация.КодЖДСтанции КАК Локация,
	               |	АналогиЛокаций.Аналог.КодЖДСтанции КАК Аналог
	               |ИЗ
	               |	РегистрСведений.АналогиЛокаций КАК АналогиЛокаций
	               |ГДЕ
	               |	(АналогиЛокаций.Локация В (&Локации)
	               |			ИЛИ АналогиЛокаций.Аналог В (&Локации))
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Локации.КодЖДСтанции КАК Локация
	               |ИЗ
	               |	Справочник.Локации КАК Локации
	               |ГДЕ
	               |	Локации.Ссылка В(&Локации)";
	Запрос.УстановитьПараметр("Локации", МассивСтанций);
	РезультатПакет = Запрос.ВыполнитьПакет();
	//Аналоги локаций
	Ответ = РезультатПакет[0].Выбрать();
	Пока Ответ.Следующий() Цикл
		Если результат.Найти(Ответ.Локация) = неопределено Тогда 
			Результат.Добавить(Ответ.Локация); 
			Если СтрДлина(Ответ.Локация) = 6 Тогда Результат.Добавить(Лев(Ответ.Локация, 5)); КонецЕсли;
		КонецЕсли;
		Если результат.Найти(Ответ.Аналог) = неопределено Тогда 
			Результат.Добавить(Ответ.Аналог); 
			Если СтрДлина(Ответ.Аналог) = 6 Тогда Результат.Добавить(Лев(Ответ.Аналог, 5)); КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	//Добавим станции из параметра, на случай отсутствия записей в РС АналогиЛокаций
	Ответ = РезультатПакет[1].Выбрать();
	Пока Ответ.Следующий() Цикл
		Если результат.Найти(Ответ.Локация) = неопределено Тогда 
			Результат.Добавить(Ответ.Локация); 
			Если СтрДлина(Ответ.Локация) = 6 Тогда Результат.Добавить(Лев(Ответ.Локация, 5)); КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции
//ДИТ, Беляев СЮ, US 68284/ TA 68289, 11-05-2023, конец

Функция ПолучитьРасстояниеМеждуСтанциями(Локация1,Локация2) Экспорт
	
	Расстояние = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РасстоянияМеждуЛокациями.Локация1 КАК Локация1,
	               |	РасстоянияМеждуЛокациями.Локация2 КАК Локация2,
	               |	РасстоянияМеждуЛокациями.РасстояниеКМ КАК РасстояниеКМ
	               |ИЗ
	               |	РегистрСведений.РасстоянияМеждуЛокациями КАК РасстоянияМеждуЛокациями
	               |ГДЕ
	               |	РасстоянияМеждуЛокациями.Локация1 = &Локация1
	               |	И РасстоянияМеждуЛокациями.Локация2 = &Локация2";
	Запрос.УстановитьПараметр("Локация1",Локация1);
	Запрос.УстановитьПараметр("Локация2",Локация2);
	Ответ = Запрос.Выполнить().Выбрать();
	
