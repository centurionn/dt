Процедура УстановитьАналогСтанции(Станция1, Станция2) Экспорт
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	АналогиЛокаций.Локация КАК Локация,
	               |	АналогиЛокаций.Аналог КАК Аналог
	               |ИЗ
	               |	РегистрСведений.АналогиЛокаций КАК АналогиЛокаций
	               |ГДЕ
	               |	(АналогиЛокаций.Локация = &Л1
	               |				И АналогиЛокаций.Аналог = &Л2
	               |			ИЛИ АналогиЛокаций.Локация = &Л2
	               |				И АналогиЛокаций.Аналог = &Л1)";
	Запрос.УстановитьПараметр("Л1", Станция1);
	Запрос.УстановитьПараметр("Л2", Станция2);
	Если Запрос.Выполнить().Пустой() Тогда 
		
		МЗ = РегистрыСведений.АналогиЛокаций.СоздатьМенеджерЗаписи();
		МЗ.Аналог = Станция2;
		МЗ.Локация = Станция1;
		МЗ.Период = ТекущаяДата();
		МЗ.Записать(Истина);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьGPSСтанции(Станция, LON, LAT) Экспорт
	
	СОбъект = Станция.ПолучитьОбъект();
	СОбъект.Широта = LAT;
	СОбъект.Долгота = LON;
	СОбъект.Записать();
	
КонецПроцедуры

Функция ПолучитьЛокациюПоНечеткомуПоиску(СтрокаПоиска, ПолноеСовпадение = Ложь, ТолькоСток = Ложь) Экспорт
	
	Если СтрокаПоиска = "" Тогда Возврат неопределено; КонецЕсли;
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ЛокацииТаблицаСинонимов.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Локации.ТаблицаСинонимов КАК ЛокацииТаблицаСинонимов
	               |ГДЕ
	               |	(ЛокацииТаблицаСинонимов.СинонимЛокации ПОДОБНО &СинонимЛокации
	               |			ИЛИ ЛокацииТаблицаСинонимов.Ссылка.Наименование ПОДОБНО &СинонимЛокации)
	               |	И НЕ ЛокацииТаблицаСинонимов.Ссылка.ПометкаУдаления
	               |	И ВЫБОР
	               |			КОГДА &ТолькоСток
	               |				ТОГДА ЛокацииТаблицаСинонимов.Ссылка.Тип = &Сток
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ";
	
	Запрос.УстановитьПараметр("СинонимЛокации", ?(ПолноеСовпадение, Строкапоиска, "%"+Строкапоиска+"%"));
	Запрос.УстановитьПараметр("ТолькоСток", ТолькоСток);
	Запрос.УстановитьПараметр("Сток", Справочники.ТипыЛокаций.Сток);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

