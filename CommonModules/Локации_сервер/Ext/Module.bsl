	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Локации.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Локации КАК Локации
	               |ГДЕ
	               |	НЕ Локации.ПометкаУдаления
	               |	И Локации.Родитель = &Родитель
	               |	И Локации.Тип = &ТипСток
	               |	И Локации.СтокРегионаПоУмолчанию";
	Запрос.УстановитьПараметр("Родитель", ПунктНазначения);
	Запрос.УстановитьПараметр("ТипСток", Справочники.ТипыЛокаций.Сток);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
