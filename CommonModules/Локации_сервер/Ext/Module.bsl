
Процедура СоздатьЛокациюПриЗаписиСтраныПриЗаписи(Источник, Отказ) Экспорт
	
	Если НЕ Источник.ПометкаУдаления Тогда
		
		Если Источник.Ссылка = Справочники.СтраныМира.Россия и НЕ ЗначениеЗаполнено(Справочники.Локации.РОССИЯ.Страна) Тогда
			РО = Справочники.Локации.РОССИЯ.ПолучитьОбъект();
			РО.Тип = Справочники.ТипыЛокаций.Страна;
			РО.Страна = Справочники.СтраныМира.Россия;
			РО.Записать();
		Иначе
			РО = ПолучитьЛокациюПоСтране(Источник.Ссылка);
			Если РО = неопределено Тогда
				РО = Справочники.Локации.СоздатьЭлемент();
				РО.Родитель = Справочники.Локации.ВСЕ;
				РО.Наименование = Источник.Наименование;
				РО.Тип = Справочники.ТипыЛокаций.Страна;
				РО.Страна = Источник.Ссылка;
				РО.Записать();
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьЛокациюПоСтране(Страна) Экспорт
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Локации.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Локации КАК Локации
	               |ГДЕ
	               |	НЕ Локации.ПометкаУдаления
	               |	И Локации.Страна = &Страна
	               |	И Локации.Тип = &Тип";
	Запрос.УстановитьПараметр("Страна", Страна);
	Запрос.УстановитьПараметр("Тип", Справочники.ТипыЛокаций.Страна);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьЖелезнуюДорогуПоКоду(КодЖД, Наименование = неопределено) Экспорт
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ЖелезныеДороги.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ЖелезныеДороги КАК ЖелезныеДороги
	               |ГДЕ
	               |	ЖелезныеДороги.Код = &Код
	               |	И НЕ ЖелезныеДороги.ПометкаУдаления";
	Запрос.УстановитьПараметр("Код", КодЖД);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		
		Результат = Ответ.Ссылка;
		
	Иначе
		
		РезультатЪ = Справочники.ЖелезныеДороги.СоздатьЭлемент();
		РезультатЪ.Код = КодЖД;
		Если Наименование <> неопределено Тогда
			РезультатЪ.Наименование = Наименование;
		Иначе
			РезультатЪ.Наименование = КодЖД;
		КонецЕсли;
		РезультатЪ.Записать();
		Результат = РезультатЪ.Ссылка;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
 
Функция НайтиСтанциюПоНеполномуКоду(Код) Экспорт
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Локации.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Локации КАК Локации
	               |ГДЕ
	               |	НЕ Локации.ПометкаУдаления
	               |	И ПОДСТРОКА(Локации.КодЖДСтанции, 1, 5) = &КодЖДСтанции";
//	               |	И Локации.Тип = &Тип";
	//Запрос.УстановитьПараметр("Тип", Справочники.ТипыЛокаций.СтанцияЖД);
	ЧастьКода = Лев(СокрЛП(Код), 5);
	Запрос.УстановитьПараметр("КодЖДСтанции", ЧастьКода);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

