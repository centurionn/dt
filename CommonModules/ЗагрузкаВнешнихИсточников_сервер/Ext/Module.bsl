			Если НЕ ЗначениеЗаполнено(Стр.Вагон) Тогда Продолжить; КонецЕсли;
			МЗ = РегистрыСведений.ДислокацияВагонов.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(МЗ, Стр);
			МЗ.Период = Стр.ДатаОперации;
			МЗ.Записать(Истина);
		КонецЦикла;
		
		Для каждого Стр из ДислокацияКонтейнеров Цикл
			Если НЕ ЗначениеЗаполнено(Стр.Контейнер) Тогда Продолжить; КонецЕсли;
			МЗ = РегистрыСведений.ДислокацияКонтейнеров.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(МЗ, Стр);
			МЗ.Период = Стр.ДатаОперации;
			МЗ.Записать(Истина);
		КонецЦикла;
		
	КонецЕсли;
	
	
	Возврат РезультатУспешно;
	
КонецФункции

Процедура РазборИностраннойДислокации() Экспорт
	
	ПапкаВх = Константы.КаталогИностраннойДислокации.Получить() + "\in";;
	ПапкаУсп = Константы.КаталогИностраннойДислокации.Получить() + "\success";
	ПапкаНеус = Константы.КаталогИностраннойДислокации.Получить() + "\errors";
	УчЗаписьДислокации = Константы.ПочтовыйПрофильСлеженияИнТерриторий.Получить();
	
	// + получаю почту из профиля ин терр

	Если ЗначениеЗаполнено(УчЗаписьДислокации) Тогда
		Почта_сервер.СкачатьВсеВложенияИСохранитьВПапку(УчЗаписьДислокации, ПапкаВх);
	КонецЕсли;
	
	// -
	
	Если ЗначениеЗаполнено(ПапкаВх) Тогда
		СписокФайлов = НайтиФайлы(ПапкаВх, "*.xlsx", Ложь);
		Для каждого Стр из СписокФайлов Цикл
			
			РезультатЗагрузки = ЗагрузитьДислокациюПоФорматуМонголииExcel(Стр.ПолноеИмя);
			
			Если РезультатЗагрузки = Истина Тогда
				ПереместитьФайл(Стр.ПолноеИмя, ПапкаУсп+"\"+Стр.Имя);
			Иначе
				ПереместитьФайл(Стр.ПолноеИмя, ПапкаНеус+"\"+Стр.Имя);
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

