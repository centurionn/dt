Функция ПреобразоватьДатуВ1С(ДатаНеВ1С, РежимПредставленияДаты) Экспорт
	
	Результат = ДатаНеВ1С;
	
	Если Результат = "" тогда Возврат Результат; КонецЕсли;
	
	МассивЗаменСимволов = Новый Массив;
	
	Если РежимПредставленияДаты = 1 Тогда // это вариант, когда год-месяц-день чч:мм:сс
		
		МассивЗаменСимволов.Добавить("-");
		МассивЗаменСимволов.Добавить(":");
		МассивЗаменСимволов.Добавить(" ");
		
	ИначеЕсли РежимПредставленияДаты = 2 Тогда // это вариант, когда 2019-08-03T05:00:00.000
		
		Результат = лев(Результат, 19);
		МассивЗаменСимволов.Добавить("-");
		МассивЗаменСимволов.Добавить(":");
		МассивЗаменСимволов.Добавить("T");
		МассивЗаменСимволов.Добавить(" ");
		
	ИначеЕсли РежимПредставленияДаты = 5 Тогда // это вариант, когда 11.12.2020 12:23
		
		Результат = "" + Сред(Результат, 7, 4) + Сред(Результат, 4, 2) + Лев(результат, 2) + ?(Сред(Результат, 13, 1) = ":", "0", "") +  Сред(Результат, 12);
		МассивЗаменСимволов.Добавить(":");
		
	ИначеЕсли РежимПредставленияДаты = 3 Тогда // это вариант, когда 2019-08-03T05:00:00.000
		
		ВремяКоротко = СтрЗаменить(Сред(Результат, 12), ":", "");
		Если СтрДлина(ВремяКоротко) = 5 Тогда ВремяКоротко = "0" + ВремяКоротко; КонецЕсли;
		
		Результат = "" + Сред(Результат, 7, 4) + Сред(Результат, 4, 2) + Лев(Результат, 2) + ВремяКоротко;
		
	КонецЕсли;
	
	Для каждого Стр из МассивЗаменСимволов Цикл
		Результат = СтрЗаменить(Результат, Стр, "");
	КонецЦикла;
	
	Попытка
		Результат = Дата(Результат);
	Исключение
		Сообщить("Преобразование даты не удалось: " + Результат);
		Возврат неопределено;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

