Функция СкачатьСтраничку(Домен, Подссылка)
	
	Результат = "";
	
	ХТТП = новый HTTPСоединение(Домен,,,,,,Новый ЗащищенноеСоединениеOpenSSL());
	ИмяФайла = ПолучитьИмяВременногоФайла();
	Попытка
		ОтветСервера = ХТТП.Получить(Подссылка, ИмяФайла, Новый Соответствие);
	Исключение
		ОО = ОписаниеОшибки();
		Сообщить("Ошибка получения данных по коду " + Подссылка + " : " + ОО);
		Возврат "";
	КонецПопытки;
	Если ОтветСервера.КодСостояния = 200 Тогда
		ЧТ = новый ЧтениеТекста(ИмяФайла);
		Результат = ЧТ.Прочитать();
		ЧТ.Закрыть();
	КонецЕсли;
	
	УдалитьФайлы(ИмяФайла);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьЛокациюПоИдентификаторуMAERSK(ИдентификаторMAERSK) Экспорт
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	Локации.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Справочник.Локации КАК Локации
	                      |ГДЕ
	                      |	НЕ Локации.ПометкаУдаления
	                      |	И Локации.ИдентификаторMAERSK = &ИдентификаторMAERSK");
	Запрос.УстановитьПараметр("ИдентификаторMAERSK", ИдентификаторMAERSK);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

