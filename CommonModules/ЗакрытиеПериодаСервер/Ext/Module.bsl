Процедура ВыгрузкаЗакрытогоПериода() Экспорт
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.ВыгрузкаАнализаДеятаельностиЗакрытогоПериода);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиВыгрузкиОАД.ИмяТаблицыВыгрузки КАК ИмяТаблицыВыгрузки,
		|	НастройкиВыгрузкиОАД.Организация КАК Организация,
		|	НастройкиВыгрузкиОАД.ИсключитьПланФактВПериоде КАК ИсключитьПланФактВПериоде,
		|	НастройкиВыгрузкиОАД.Активна КАК Активна,
		|	ЗакрытыеПериоды.Период КАК Период,
		|	НастройкиВыгрузкиОАД.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВсеПериодыВыгрузки
		|ИЗ
		|	Справочник.НастройкиВыгрузкиОАД КАК НастройкиВыгрузкиОАД
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗакрытыеПериоды КАК ЗакрытыеПериоды
		|		ПО НастройкиВыгрузкиОАД.Организация = ЗакрытыеПериоды.Организация
		|			И НастройкиВыгрузкиОАД.НачалоПериода <= ЗакрытыеПериоды.Период
		|ГДЕ
		|	НастройкиВыгрузкиОАД.Активна = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВсеПериодыВыгрузки.ИмяТаблицыВыгрузки КАК ИмяТаблицыВыгрузки,
		|	ВсеПериодыВыгрузки.Организация КАК Организация,
		|	ВсеПериодыВыгрузки.ИсключитьПланФактВПериоде КАК ИсключитьПланФактВПериоде,
		|	ВсеПериодыВыгрузки.Период КАК Период,
		|	ВсеПериодыВыгрузки.Ссылка КАК ТаблицаВыгрузкиСсылка,
		|	ВыгруженныеАнализыДеятельностиПоЗакрытымПериодам.ЗакрытиеПериода КАК ЗакрытиеПериода
		|ИЗ
		|	ВсеПериодыВыгрузки КАК ВсеПериодыВыгрузки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВыгруженныеАнализыДеятельностиПоЗакрытымПериодам КАК ВыгруженныеАнализыДеятельностиПоЗакрытымПериодам
		|		ПО ВсеПериодыВыгрузки.ИмяТаблицыВыгрузки = ВыгруженныеАнализыДеятельностиПоЗакрытымПериодам.ТаблицаВыгрузки.ИмяТаблицыВыгрузки
		|			И ВсеПериодыВыгрузки.Организация = ВыгруженныеАнализыДеятельностиПоЗакрытымПериодам.Организация
		|			И ВсеПериодыВыгрузки.Период = ВыгруженныеАнализыДеятельностиПоЗакрытымПериодам.ВыгруженныйПериод
		|			И ВыгруженныеАнализыДеятельностиПоЗакрытымПериодам.ЗакрытиеПериода = ИСТИНА
		|ГДЕ
		|	ВыгруженныеАнализыДеятельностиПоЗакрытымПериодам.Организация ЕСТЬ NULL";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НачалоПериода = ВыборкаДетальныеЗаписи.Период;
		КонецПериода = КонецМесяца(НачалоПериода);
		
		Если БлокировкаРаботыСВнешнимиРесурсами.РаботаСВнешнимиРесурсамиЗаблокирована() Тогда	
			КоличествоЗаписей = ВыгрузкаОтчётаАнализДеятельности(НачалоПериода, КонецПериода, ВыборкаДетальныеЗаписи.ИсключитьПланФактВПериоде, "AnalisysActivityReportDataTest2", ВыборкаДетальныеЗаписи.Организация);
			СоздатьЗаписьВРегистре(НачалоПериода, Истина, ВыборкаДетальныеЗаписи.ТаблицаВыгрузкиСсылка, КоличествоЗаписей, ВыборкаДетальныеЗаписи.Организация);
			Продолжить;		
		КонецЕсли;
 
		КоличествоЗаписей = ВыгрузкаОтчётаАнализДеятельности(НачалоПериода, КонецПериода, ВыборкаДетальныеЗаписи.ИсключитьПланФактВПериоде, ВыборкаДетальныеЗаписи.ИмяТаблицыВыгрузки, ВыборкаДетальныеЗаписи.Организация);
		СоздатьЗаписьВРегистре(НачалоПериода, Истина, ВыборкаДетальныеЗаписи.ТаблицаВыгрузкиСсылка, КоличествоЗаписей, ВыборкаДетальныеЗаписи.Организация);
		
	КонецЦикла;
