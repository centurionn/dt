// Процедура выгрузки отчёта
Функция ВыгрузкаОтчётаАнализДеятельности(НачалоПериода, КонецПериода, ИсключитьПланФактВПериоде, ИмяТаблицы, Организация = "")
	
    Период = Новый СтандартныйПериод();
	Период.ДатаНачала = НачалоПериода;
	Период.ДатаОкончания = КонецПериода;

	ОтчетОбъект = Отчеты.АнализДеятельности.Создать();
	
	НастройкиДляВыгрузки = Неопределено;
    Для Каждого Вариант Из ОтчетОбъект.СхемаКомпоновкиДанных.ВариантыНастроек Цикл
		Если Вариант.Имя = "АнализДеятельностиВыгрузка" Тогда
			НастройкиДляВыгрузки = Вариант.Настройки;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	АдресВоВременноеХранилище = ПоместитьВоВременноеХранилище(ОтчетОбъект.СхемаКомпоновкиДанных);
    ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресВоВременноеХранилище);	
	ОтчетОбъект.КомпоновщикНастроек.Инициализировать(ИсточникНастроек);
	ОтчетОбъект.КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиДляВыгрузки);

	
    КомпоновкаДанныхКлиентСервер.УстановитьПараметр(ОтчетОбъект.КомпоновщикНастроек, "Период", Период);
	
	ПараметрыУстановкиОтбора = Новый Структура;
	ПараметрыУстановкиОтбора.Вставить("ЗаменятьСуществующий", Истина);
	ПараметрыУстановкиОтбора.Вставить("ВПользовательскиеНастройки", Истина);
	ИспользованиеОтбораПланФактВПериоде = ИсключитьПланФактВПериоде;
	ДобавитьОтбор(ОтчетОбъект.КомпоновщикНастроек, "ПланФактВПериоде", Ложь, ВидСравненияКомпоновкиДанных.Равно, ИспользованиеОтбораПланФактВПериоде, ПараметрыУстановкиОтбора);
	
	Настройки = ОтчетОбъект.КомпоновщикНастроек.ПолучитьНастройки();
	
	ПараметрКоманды = Новый Структура;
	ПараметрКоманды.Вставить("СхемаКомпоновкиДанных", ОтчетОбъект.СхемаКомпоновкиДанных);
	ПараметрКоманды.Вставить("Настройки", Настройки);
	ПараметрКоманды.Вставить("ИмяТаблицы", ИмяТаблицы);
	ПараметрКоманды.Вставить("ВыгружатьЧастями", Истина);
	Возврат РегистрыСведений.ОчередьЗаписиДанныхПоОтправлениям.ОбработкаДанныхДляОАД(ПараметрКоманды);
	
КонецФункции

