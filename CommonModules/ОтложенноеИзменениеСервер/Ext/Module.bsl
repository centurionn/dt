Функция ОбработчикИзменения_КоносаментПоМорскомуРейсу(ДокументОбъект)
	
	Ошибка = Ложь;
	СообщениеРезультатаВыполнения = ""; 
	НеобходимаЗаписьОбъекта = Ложь;   
	
	Если не ЗначениеЗаполнено(ДокументОбъект.МорскойРейс) Тогда
		Возврат Новый Структура("НеобходимаЗаписьОбъекта, ЗаписываемыйОбъект, Ошибка, СообщениеРезультатаВыполнения", 
							 НеобходимаЗаписьОбъекта, ДокументОбъект, Ошибка, СообщениеРезультатаВыполнения);
	Иначе
		СтрокаРеквизитов = "ПунктОтправления, ПунктНазначения, МестоПогрузки, МестоРазгрузки, ДатаОтправления, ДатаПрибытия";
		РеквизитыМорскогоРейса = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОбъект.МорскойРейс, СтрокаРеквизитов);						 
		ДокументОбъект.СтанцияОтправления	= РеквизитыМорскогоРейса.ПунктОтправления; 
		ДокументОбъект.СтанцияНазначения 	= РеквизитыМорскогоРейса.ПунктНазначения; 
		ДокументОбъект.МестоПолученияГруза 	= РеквизитыМорскогоРейса.МестоПогрузки; 
		ДокументОбъект.МестоПоставкиГруза 	= РеквизитыМорскогоРейса.МестоРазгрузки; 
		ДокументОбъект.ДатаОтправления 		= РеквизитыМорскогоРейса.ДатаОтправления; 
		ДокументОбъект.ДатаПрибытия 		= РеквизитыМорскогоРейса.ДатаПрибытия; 
		НеобходимаЗаписьОбъекта = Истина;
	КонецЕсли;

	Возврат Новый Структура("НеобходимаЗаписьОбъекта, ЗаписываемыйОбъект, Ошибка, СообщениеРезультатаВыполнения", 
							 НеобходимаЗаписьОбъекта, ДокументОбъект, Ошибка, СообщениеРезультатаВыполнения);

