Функция ОбработчикИзменения_СделкаПоАкцепту(обСделка, ИсточникИзменения = Неопределено) 
	Ошибка = Ложь;  
	СообщениеРезультатаВыполнения = "";
	//проверим актуальность учетных документов и заменим на актуальные, если они изменились
	Запрос = Новый Запрос;
	//Субботин 69649 24.08.2023 Начало
	Запрос.Текст = ТекстЗапросаПолучениеГуидовСтрок();
	// получение текста запроса вынес в отдельную функцию 
	//Субботин 69649 24.08.2023 Конец --
	Запрос.УстановитьПараметр("Сделка", обСделка.Ссылка);
	МассивРезультатов = Запрос.ВыполнитьПакет();
	КоличествоРезультатов = МассивРезультатов.Количество();
	НеобходимаЗаписьОбъекта = Ложь;
	
	//Евросиб Каблов 06.01.2024 ( #78949
	ТаблицаДобавляемыхУслугВнеСтавки = обСделка.СвязьДоходовИРасходов.ВыгрузитьКолонки("СвязьУчетныхЕдиниц, Услуга, Доходы, Расходы");
	//Евросиб Каблов 06.01.2024 )
	
	Если НЕ МассивРезультатов[КоличествоРезультатов-2].Пустой() 
		ИЛИ НЕ МассивРезультатов[КоличествоРезультатов-1].Пустой() Тогда
		
		//Евросиб(ДИТ), Беляев СЮ, Ticket#0366378, 18-09-2024, начало
		ТаблицаДоходовДляОбработки = ПолучитьТаблицуДоходовКРасходам(обСделка.Ссылка, МассивРезультатов[КоличествоРезультатов-2].Выгрузить().ВыгрузитьКолонку("ГУИД"));
		//Евросиб(ДИТ), Беляев СЮ, Ticket#0366378, 18-09-2024, конец
		
		ВыборкаСтрокРасходов = МассивРезультатов[КоличествоРезультатов-2].Выбрать();
		Пока ВыборкаСтрокРасходов.СледующийПоЗначениюПоля("ГУИД") Цикл
			Если ВыборкаСтрокРасходов.ЕстьСовпадение Тогда
				Продолжить;
			Иначе
				СтрокаРасход = обСделка.Расходы.Найти(ВыборкаСтрокРасходов.ГУИД, "ГУИД");
				//Евросиб Каблов 14.08.2023 ( Ticket#0319898
				//СтрокаРасход.УчДокумент = ВыборкаСтрокРасходов.Поступление;
				Если ТипЗнч(ВыборкаСтрокРасходов.Поступление) = Тип("ДокументСсылка.КорректировкаПоступления") Тогда
					СтрокаРасход.УчДокумент = БухгалтерскийУчетПереопределяемый.ПолучитьИсправляемыйДокументПоступления(ВыборкаСтрокРасходов.Поступление, Истина);
				Иначе
					СтрокаРасход.УчДокумент = ВыборкаСтрокРасходов.Поступление;
				КонецЕсли;
				//Евросиб Каблов 14.08.2023 )
				////Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 113659, 03-07-2025, начало
				//СтрокаРасход.УчДокумент = ВыборкаСтрокРасходов.Поступление;
				////Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 113659, 03-07-2025, конец
				
				//Евросиб - АСуслов 07.03.2023 16:28:28 #66486
				//(
				СтрокаРасход.УслугаОтключена = Ложь; 
				СтрокаРасход.ПричинаОтключенияСтроки = Неопределено;
				//)
				//Евросиб - АСуслов 07.03.2023 16:28:30 #66486
				
				//Евросиб Каблов 06.10.2023 ( Ticket#0327386
				СтрокиСоставаПоезда = обСделка.СвязьУчетныхЕдиниц.НайтиСтроки(Новый Структура("ГУИД", СтрокаРасход.СтрокаСвязьУчетныхЕдиниц));
				Для Каждого СтрокаСП Из СтрокиСоставаПоезда Цикл
					Если СтрокаСП.НеАктивна Тогда
						СтрокаСП.НеАктивна = Ложь;
					КонецЕсли;
					Если СтрокаСП.Удалена Тогда
						СтрокаСП.Удалена = Ложь;
					КонецЕсли;
				КонецЦикла;
				//Евросиб Каблов 06.10.2023 )
				
				//Евросиб Каблов 06.01.2024 ( #78949
				Если ЗначениеЗаполнено(СтрокаРасход.СтрокаСвязьУчетныхЕдиниц) Тогда
					
					//Для добавления новой строки, если она отсутствует
					СтрокаУслугиВнеСтавки = ТаблицаДобавляемыхУслугВнеСтавки.Добавить();
					СтрокаУслугиВнеСтавки.СвязьУчетныхЕдиниц = СтрокаРасход.СтрокаСвязьУчетныхЕдиниц;
					СтрокаУслугиВнеСтавки.Услуга = СтрокаРасход.Услуга;
					СтрокаУслугиВнеСтавки.Расходы = СтрокаРасход.ГУИД;
					
					//Снятие флажка "Не выставлять" у найденной строки дохода
					//ЕстьВыставляемая = Ложь;
					//СтрокиСвязиДоходов = обСделка.СвязьДоходовИРасходов.НайтиСтроки(Новый Структура("СвязьУчетныхЕдиниц, Услуга", СтрокаРасход.СтрокаСвязьУчетныхЕдиниц, СтрокаРасход.Услуга));
					//Для Каждого СтрокаСвязиДоходов Из СтрокиСвязиДоходов Цикл
					//	Если ЗначениеЗаполнено(СтрокаСвязиДоходов.Доходы) Тогда
					//		СтрокаДоход = обСделка.Доходы.Найти(СтрокаСвязиДоходов.Доходы, "ГУИД");
					//		Если СтрокаДоход <> Неопределено И СтрокаДоход.Услуга = СтрокаРасход.Услуга И СтрокаДоход.НеВыставлятьКлиенту = Ложь Тогда
					//			ЕстьВыставляемая = Истина;
					//			Прервать;
					//		КонецЕсли;
					//	КонецЕсли;
					//КонецЦикла;
					//
					//Если Не ЕстьВыставляемая Тогда
					//	Для Каждого СтрокаСвязиДоходов Из СтрокиСвязиДоходов Цикл
					//		Если ЗначениеЗаполнено(СтрокаСвязиДоходов.Доходы) Тогда
					//			СтрокаДоход = обСделка.Доходы.Найти(СтрокаСвязиДоходов.Доходы, "ГУИД");
					//			Если СтрокаДоход <> Неопределено И СтрокаДоход.Услуга = СтрокаРасход.Услуга И СтрокаДоход.НеВыставлятьКлиенту Тогда
					//				СтрокаДоход.НеВыставлятьКлиенту = Ложь;
					//				СтрокаУслугиВнеСтавки.Доходы = СтрокаДоход.ГУИД;
					//				Прервать;
					//			КонецЕсли;
					//		КонецЕсли;
					//	КонецЦикла;
					//КонецЕсли;
					//Евросиб(ДИТ), Беляев СЮ, Ticket#0366378, 18-09-2024, начало
					СтрокиСопоставленныхДоходов = ТаблицаДоходовДляОбработки.НайтиСтроки(Новый Структура("СвязьУчетныхЕдиниц, Услуга, Расходы", СтрокаРасход.СтрокаСвязьУчетныхЕдиниц, СтрокаРасход.Услуга, СтрокаРасход.ГУИД));
					Если СтрокиСопоставленныхДоходов.Количество() > 0 Тогда
						СтрокаСопоставленногоДоходов = СтрокиСопоставленныхДоходов[0];
						СтрокаСопоставленногоДоходов.НеВыставлятьКлиенту = Ложь;
						Если СтрокаСопоставленногоДоходов.ТребуетсяУстановитьСвязь Тогда
							Документы.Сделка.СвязатьДоходыРасходыСУЕ(обСделка, СтрокаСопоставленногоДоходов.Доходы, СтрокаРасход.ГУИД, СтрокаРасход.СтрокаСвязьУчетныхЕдиниц, СтрокаРасход.Услуга);
