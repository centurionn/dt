Процедура ВыполнитьОбработчикиОтложенногоИзмененияПоОбъекту(ОбрабатываемыйОбъект) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОчередьОтложенногоИзмененияВзаимосвязанныхОбъектов.ОбрабатываемыйОбъект КАК ОбрабатываемыйОбъект,
	|	ОчередьОтложенногоИзмененияВзаимосвязанныхОбъектов.ИсточникИзменения КАК ИсточникИзменения
	|ИЗ
	|	РегистрСведений.ОчередьОтложенногоИзмененияВзаимосвязанныхОбъектов КАК ОчередьОтложенногоИзмененияВзаимосвязанныхОбъектов
	|ГДЕ
	|	ОчередьОтложенногоИзмененияВзаимосвязанныхОбъектов.ОбрабатываемыйОбъект = &ОбрабатываемыйОбъект
	|	И НЕ ОчередьОтложенногоИзмененияВзаимосвязанныхОбъектов.Обработано
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОбрабатываемыйОбъект,
	|	ИсточникИзменения";
	Запрос.УстановитьПараметр("ОбрабатываемыйОбъект", ОбрабатываемыйОбъект.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	Выборка = РезультатЗапроса.Выбрать();
	МассивОбрабатываемыхОбъектов = ПолучитьМассивСтруктурОбработчиковОбрабатываемыхОбъектов(Выборка);
	Для каждого СтруктураОбрабатываемыйОбъект Из МассивОбрабатываемыхОбъектов Цикл
		Ошибка = Ложь;
		МассивЗаписываемыхДокументов = Новый Массив;
		обДокумент = ОбрабатываемыйОбъект;
		//Попытка
		//	обДокумент.Заблокировать();
		//Исключение
		//	ЗаписьЖурналаРегистрации("Обработка очереди отложенного изменения", УровеньЖурналаРегистрации.Ошибка, обДокумент.Метаданные(), обДокумент.Ссылка, ОписаниеОшибки()); 
		//	Продолжить;	
		//КонецПопытки;
		Для каждого СтруктураОбработчик Из СтруктураОбрабатываемыйОбъект.Обработчики Цикл
			// ++ Евросиб Дудоров С.В. US 57543 30.01.2023 
				Результат = Вычислить(СтрШаблон("%1(%2,%3)"
					,СтруктураОбработчик.ИмяОбработчика
					, "обДокумент"
					, "СтруктураОбработчик.ИсточникиОбработчика"));
			// ++ Евросиб Дудоров С.В. US 57543 30.01.2023 
			// -- Евросиб Дудоров С.В. US 57543 30.01.2023 
				//Результат = Вычислить(СтрШаблон("%1(%2)",СтруктураОбработчик.ИмяОбработчика, "обДокумент"));
			// -- Евросиб Дудоров С.В. US 57543 30.01.2023 
			Если Результат.Ошибка = Истина Тогда
				Ошибка = Истина;
				Прервать;
			КонецЕсли;   
			Если Результат.НеобходимаЗаписьОбъекта Тогда
				МассивЗаписываемыхДокументов.Добавить(Результат.ЗаписываемыйОбъект);
			КонецЕсли;
		КонецЦикла;      
		Если Ошибка Тогда
			Для каждого ИсточникИзменения Из СтруктураОбработчик.ИсточникиОбработчика Цикл
				мз = РегистрыСведений.ОчередьОтложенногоИзмененияВзаимосвязанныхОбъектов.СоздатьМенеджерЗаписи();
				мз.ОбрабатываемыйОбъект = СтруктураОбрабатываемыйОбъект.ОбрабатываемыйОбъект;
				мз.ИсточникИзменения = ИсточникИзменения;
				мз.Прочитать();
				Если мз.Выбран() Тогда
					//мз.Удалить();
					мз.ОшибкаПриОбработке = Истина;
					мз.ДатаОбработки = ТекущаяДата();
					мз.Записать();
				КонецЕсли;
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		НачатьТранзакцию();
		Попытка
			Для каждого ЗаписываемыйДокумент Из МассивЗаписываемыхДокументов Цикл
				ЗаписываемыйДокумент.УстановитьКомментарийВерсииИсторииДанных("Очередь отложенного изменения");
				Если ЗаписываемыйДокумент.Проведен Тогда
					ЗаписываемыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
				Иначе
					ЗаписываемыйДокумент.Записать(РежимЗаписиДокумента.Запись);
				КонецЕсли;
			КонецЦикла;
			обДокумент.Разблокировать();
			Для каждого СтруктураОбработчик Из СтруктураОбрабатываемыйОбъект.Обработчики Цикл
				Для каждого ИсточникИзменения Из СтруктураОбработчик.ИсточникиОбработчика Цикл
					мз = РегистрыСведений.ОчередьОтложенногоИзмененияВзаимосвязанныхОбъектов.СоздатьМенеджерЗаписи();
					мз.ОбрабатываемыйОбъект = СтруктураОбрабатываемыйОбъект.ОбрабатываемыйОбъект;
					мз.ИсточникИзменения = ИсточникИзменения;
					мз.Прочитать();
					Если мз.Выбран() Тогда
						мз.Обработано = Истина;
						мз.ДатаОбработки = ТекущаяДата();
						мз.Записать();
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			ЗафиксироватьТранзакцию();
			ЗаписьЖурналаРегистрации("Обработка очереди отложенного изменения", УровеньЖурналаРегистрации.Информация, обДокумент.Метаданные(), обДокумент.Ссылка, "Очередь обработана"); 
		Исключение         
			обДокумент.Разблокировать();
			ОтменитьТранзакцию();
			Для каждого ИсточникИзменения Из СтруктураОбработчик.ИсточникиОбработчика Цикл
				мз = РегистрыСведений.ОчередьОтложенногоИзмененияВзаимосвязанныхОбъектов.СоздатьМенеджерЗаписи();
				мз.ОбрабатываемыйОбъект = СтруктураОбрабатываемыйОбъект.ОбрабатываемыйОбъект;
				мз.ИсточникИзменения = ИсточникИзменения;
				мз.Прочитать();
				Если мз.Выбран() Тогда
					мз.ОшибкаПриОбработке = Истина;
					мз.ДатаОбработки = ТекущаяДата();
					мз.Записать();
				КонецЕсли;
			КонецЦикла;
			ЗаписьЖурналаРегистрации("Обработка очереди отложенного изменения"
				, УровеньЖурналаРегистрации.Ошибка, обДокумент.Метаданные(), обДокумент.Ссылка, ОписаниеОшибки()); 
		КонецПопытки;	
	КонецЦикла;
	
	
КонецПроцедуры

Функция ПолучитьМассивСтруктурОбработчиковОбрабатываемыхОбъектов(Выборка)
    МассивОбрабатываемыхОбъектов = Новый Массив;
	Пока Выборка.СледующийПоЗначениюПоля("ОбрабатываемыйОбъект") Цикл
		СтруктураОбработкиОбъекта = Новый Структура("ОбрабатываемыйОбъект, Обработчики");
		СтруктураСписокИсточниковОбработчика = Новый Структура();
		МассивОбработчиковОбрабатываемогоОбъекта = Новый Массив;
		ТаблицаОбработчиковОбрабатываемогоОбъекта = ПолучитьТаблицуОбработчиковОбрабатываемогоОбъекта();
		МассивИсточниковИзменения = Новый Массив;
		Пока Выборка.СледующийПоЗначениюПоля("ИсточникИзменения") Цикл
			//ИмяОбработчика = ПолучитьИмяОбработчика(Выборка.ОбрабатываемыйОбъект, Выборка.ИсточникИзменения); 
			СтруктураОбработчика = ПолучитьСтруктуруОбработчика(Выборка.ОбрабатываемыйОбъект, Выборка.ИсточникИзменения); 
			Если НЕ ЗначениеЗаполнено(СтруктураОбработчика.ИмяОбработчика) Тогда
				Продолжить;
			КонецЕсли;
			//Если МассивОбработчиковОбрабатываемогоОбъекта.Найти(СтруктураОбработчика) = Неопределено Тогда
			//	МассивОбработчиковОбрабатываемогоОбъекта.Добавить(СтруктураОбработчика);
			//КонецЕсли;                                                                                    
			Если ТаблицаОбработчиковОбрабатываемогоОбъекта.НайтиСтроки(СтруктураОбработчика).Количество()=0 Тогда
				ЗаполнитьЗначенияСвойств(ТаблицаОбработчиковОбрабатываемогоОбъекта.Добавить(), СтруктураОбработчика);
			КонецЕсли;
			МассивИсточниковОбработчика = Неопределено;
			Если СтруктураСписокИсточниковОбработчика.Свойство(СтруктураОбработчика.ИмяОбработчика, МассивИсточниковОбработчика) Тогда
				МассивИсточниковОбработчика.Добавить(Выборка.ИсточникИзменения);
			Иначе
				МассивИсточниковОбработчика = Новый Массив;
				СтруктураСписокИсточниковОбработчика.Вставить(СтруктураОбработчика.ИмяОбработчика, МассивИсточниковОбработчика);
				МассивИсточниковОбработчика.Добавить(Выборка.ИсточникИзменения);
			КонецЕсли;
		КонецЦикла;
		СтруктураПараметрыОбработки = Новый Структура("ИмяОбработчика, КоличествоПараметров, МассивИсточников");
		//Для каждого ОбработчикОбрабатываемогоОбъекта Из МассивОбработчиковОбрабатываемогоОбъекта Цикл
		//	СтруктураПараметрыОбработки.Вставить(ОбработчикОбрабатываемогоОбъекта, СтруктураСписокИсточниковОбработчика[ОбработчикОбрабатываемогоОбъекта]);
		//КонецЦикла;
		Для каждого ОбработчикОбрабатываемогоОбъекта Из ТаблицаОбработчиковОбрабатываемогоОбъекта Цикл
			СтруктураПараметрыОбработки.ИмяОбработчика = ОбработчикОбрабатываемогоОбъекта.ИмяОбработчика;
			СтруктураПараметрыОбработки.КоличествоПараметров = ОбработчикОбрабатываемогоОбъекта.КоличествоПараметров;
			СтруктураПараметрыОбработки.МассивИсточников = СтруктураСписокИсточниковОбработчика[ОбработчикОбрабатываемогоОбъекта.ИмяОбработчика];
		КонецЦикла;
		СтруктураОбработкиОбъекта.ОбрабатываемыйОбъект = Выборка.ОбрабатываемыйОбъект;
		МассивОбработчиковСПараметрами = Новый Массив;
		Для каждого Обработчик Из ТаблицаОбработчиковОбрабатываемогоОбъекта Цикл
			СтруктураОбработки = Новый Структура("ИмяОбработчика, КоличествоПараметров, ИсточникиОбработчика", Обработчик.ИмяОбработчика, Обработчик.КоличествоПараметров, СтруктураСписокИсточниковОбработчика[Обработчик.ИмяОбработчика]);	
			МассивОбработчиковСПараметрами.Добавить(СтруктураОбработки);
		КонецЦикла;
		СтруктураОбработкиОбъекта.Обработчики = МассивОбработчиковСПараметрами;
		МассивОбрабатываемыхОбъектов.Добавить(СтруктураОбработкиОбъекта);
	КонецЦикла;
	Возврат МассивОбрабатываемыхОбъектов;
КонецФункции   

Функция ПолучитьТаблицуОбработчиковОбрабатываемогоОбъекта()
	
	ТаблицаОбработчиковОбрабатываемогоОбъекта = Новый ТаблицаЗначений;
	ТаблицаОбработчиковОбрабатываемогоОбъекта.Колонки.Добавить("ИмяОбработчика");
	ТаблицаОбработчиковОбрабатываемогоОбъекта.Колонки.Добавить("КоличествоПараметров", ОбщегоНазначения.ОписаниеТипаЧисло(1));
	Возврат ТаблицаОбработчиковОбрабатываемогоОбъекта;
	
КонецФункции

