// Евросиб US 88683 TA 108959 Рыбьяков К.А. 15.04.2025 ((
Функция ОбработчикИзменения_СделкаПоКлючуАналитикиНоминаций(СделкаОбъект, Источник = Неопределено)
	
	Ошибка = Ложь;
	СообщениеРезультатаВыполнения = "";
	НеобходимаЗаписьОбъекта = Ложь;
	
	Попытка
		
		НайденныеСтроки = СделкаОбъект.СвязьУчетныхЕдиниц.НайтиСтроки(Новый Структура("Контейнер, ВидТранспортногоСообщения", Источник.Контейнер, Перечисления.ВидыТранспортныхСообщений.ЖД));
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			Если Источник.Сделка = СделкаОбъект.Ссылка Тогда
				РеквизитыРелиза = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник.РелизСобственника, "Договор, Контрагент, ПСЦ");
				НайденныеСтроки[0].Доплата_Клиент = РеквизитыРелиза.Контрагент;
				НайденныеСтроки[0].Доплата_Договор = РеквизитыРелиза.Договор;
				НайденныеСтроки[0].Доплата_ПСЦ = РеквизитыРелиза.ПСЦ;
				НайденныеСтроки[0].Доплата_Калькуляция = Источник.Калькуляция;
				НайденныеСтроки[0].Доплата_Доплата = Источник.Ставка;
				НайденныеСтроки[0].Доплата_Валюта = Источник.Валюта;
				НайденныеСтроки[0].Доплата_РелизСобственника = Источник.РелизСобственника;
				НайденныеСтроки[0].Доплата_Пользователь = Источник.Редактор;
			Иначе
				Документы.Сделка.УдалитьДоходнуюСтрокуСвязаннуюСДоплатнымиДанными(СделкаОбъект, Источник.Контейнер);
				НайденныеСтроки[0].Доплата_Клиент = Неопределено;
				НайденныеСтроки[0].Доплата_Договор = Неопределено;
				НайденныеСтроки[0].Доплата_ПСЦ = Неопределено;
				НайденныеСтроки[0].Доплата_Калькуляция = Неопределено;
				НайденныеСтроки[0].Доплата_Доплата = Неопределено;
				НайденныеСтроки[0].Доплата_Валюта = Неопределено;
				НайденныеСтроки[0].Доплата_РелизСобственника = Неопределено;
				НайденныеСтроки[0].Доплата_Пользователь = Неопределено;
			КонецЕсли;
			НеобходимаЗаписьОбъекта = Истина;
		КонецЕсли;
	Исключение
		СообщениеРезультатаВыполнения = ОписаниеОшибки();
		НеобходимаЗаписьОбъекта = Ложь;
		Ошибка = Истина;
	КонецПопытки;
	
	Возврат Новый Структура("НеобходимаЗаписьОбъекта, ЗаписываемыйОбъект, Ошибка, СообщениеРезультатаВыполнения", НеобходимаЗаписьОбъекта, СделкаОбъект, Ошибка, СообщениеРезультатаВыполнения);

КонецФункции
