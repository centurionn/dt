Функция ОбработчикИзменения_РефСцепаЗаявкиСделкиПоРефСцепу(ДокументОбъект, РефСцепСсылка)
	Если ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.Заявка") Тогда
		НеобходимаЗаписьОбъекта  = Документы.Заявка.ИзменитьЗаявкуПоРефСцепу(ДокументОбъект, РефСцепСсылка);
		Возврат Новый Структура("НеобходимаЗаписьОбъекта, ЗаписываемыйОбъект, Ошибка, СообщениеРезультатаВыполнения"
								, НеобходимаЗаписьОбъекта, ДокументОбъект, Ложь, "");
	ИначеЕсли ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.Сделка") Тогда
		НеобходимаЗаписьОбъекта  = Документы.Сделка.ИзменитьСделкуПоРефСцепу(ДокументОбъект, РефСцепСсылка);
		Возврат Новый Структура("НеобходимаЗаписьОбъекта, ЗаписываемыйОбъект, Ошибка, СообщениеРезультатаВыполнения"
								, НеобходимаЗаписьОбъекта, ДокументОбъект, Ложь, "");
	ИначеЕсли ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.РефСцеп") Тогда
		НеобходимаЗаписьОбъекта  = Документы.РефСцеп.ДобавитьКонтейнерИзДругогоРефСцепа(ДокументОбъект, РефСцепСсылка);
		Возврат Новый Структура("НеобходимаЗаписьОбъекта, ЗаписываемыйОбъект, Ошибка, СообщениеРезультатаВыполнения"
								, НеобходимаЗаписьОбъекта, ДокументОбъект, Ложь, "");
	КонецЕсли;							
КонецФункции
