Функция ОбработчикИзменения_ИзменитьИсполнителейВМаршрутахПСЦ(ДокументОбъект,Источник)
	
	Ошибка = Ложь;
	СообщениеРезультатаВыполнения = ""; 
	НеобходимаЗаписьОбъекта = Ложь;   
	мСтатус = Новый Массив;
	мСтатус.Добавить(Перечисления.СтатусыЭтапов.ВРаботе);
	мСтатус.Добавить(Перечисления.СтатусыЭтапов.НаВыполнение);
	мСтатус.Добавить(Перечисления.СтатусыЭтапов.Новый);
	
	СтруктураРезультата = МаршрутизацияСервер.НайтиГотовыеКВыставлениюСтрокиВСделкахПоПСЦ(ДокументОбъект.Ссылка);
	Если СтруктураРезультата.МассивСделокВыставленныеДокументы.Количество() = 0 И СтруктураРезультата.МассивСделокГотовоКВыставлению.Количество() = 0 Тогда
		
		//ПараметрыЗапроса = МаршрутизацияСервер.ПолучитьПараметрыМаршрутизации(ДокументОбъект);
		//РезультатЗапроса = МаршрутизацияСервер.МаршрутизироватьПСЦ(ПараметрыЗапроса, ДокументОбъект.Дата);
		
		РезультатЗапроса = Новый Массив;
		Для каждого Стр из Источник.Состояния Цикл
			Статус = ?(РезультатЗапроса.Количество() = 0, Источник.НачальныйСтатус, Перечисления.СтатусыЭтапов.Новый);
			РезультатЗапроса.Добавить(Новый Структура("Состояние, Исполнитель, Наблюдатель, Статус, Ссылка, ПредыдущиеЭтапы, ОРКПоДоговору, ОтветственныйЗаУчет, ОтветственныйЗаДоговор, НормативИсполненияСМоментаСоздания, ТребуетсяУказатьНаблюдателя, ТребуетсяУказатьИсполнителя, ВидНормативаИсполнения,ИсполнительКакРуководительПоНаправлению,НаблюдательКакРуководительПоНаправлению, ОтветственныйМенеджерПСЦ, РуководительСотрудника, ВыбиратьИсполнителяЕслиНеЗаполненРуководительСотрудника", Стр.Состояние, Стр.Исполнитель, Стр.Наблюдатель, Статус, Источник, Стр.ПредыдущиеЭтапы, Стр.СопровождениеПоДоговору, Стр.ОтветственныйЗаУчет, Стр.ОтветственныйЗаДоговор, Стр.НормативИсполненияСМоментаСоздания, Стр.ТребуетсяУказатьНаблюдателя, Стр.ТребуетсяУказатьИсполнителя, Стр.ВидНормативаИсполнения,Стр.ИсполнительКакРуководительПоНаправлению,Стр.НаблюдательКакРуководительПоНаправлению, Стр.ОтветственныйМенеджерПСЦ, Стр.РуководительСотрудника, Стр.ВыбиратьИсполнителяЕслиНеЗаполненРуководительСотрудника));
		КонецЦикла;
		МаршрутизацияСервер.ОтработатьЗамещениеДелегирование(РезультатЗапроса, Перечисления.МаршрутизируемыеОбъекты.ПротоколСогласованияЦены, ДокументОбъект.Дата, ДокументОбъект.Договор);
		МаршрутизацияСервер.ОтработатьЗамещениеДелегирование(РезультатЗапроса, Перечисления.МаршрутизируемыеОбъекты.ПротоколСогласованияЦены, ДокументОбъект.Дата, ДокументОбъект.ВидПеревозки);
		
		ПроцессСогласования = СогласованиеСервер.ПолучитьПроцессСогласованияОбъекта(ДокументОбъект.Ссылка);
		обПроцессСогласования = Неопределено;
		Если ЗначениеЗаполнено(ПроцессСогласования.Ссылка) Тогда
			обПроцессСогласования = ПроцессСогласования.Ссылка.ПолучитьОбъект();
		КонецЕсли;
		
		Для Каждого СтрокаРезультат Из РезультатЗапроса Цикл
			
			Если Не ЗначениеЗаполнено(СтрокаРезультат.Исполнитель) Тогда
				Продолжить;
			КонецЕсли;
			
			СтруктураПоиска = Новый Структура("Состояние",СтрокаРезультат.Состояние);
			НайденныеСтроки = ДокументОбъект.Состояния.НайтиСтроки(СтруктураПоиска);
			
			Если НайденныеСтроки.Количество() Тогда
				Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл	
					Если НайденнаяСтрока.Исполнитель <> СтрокаРезультат.Исполнитель Тогда
						Если мСтатус.Найти(НайденнаяСтрока.Статус) <> Неопределено Тогда
							
							Если ЗначениеЗаполнено(ПроцессСогласования.Ссылка) Тогда
								
								ВремТЧ = обПроцессСогласования.Состояния.Выгрузить();
								ВремТЧ.Сортировать("ШагЦикла УБЫВ, ЗавершениеРаботы УБЫВ");
								ПоследнееЗначениеЦикла = ВремТЧ[0].ШагЦикла;
								ТекущийЦикл = ПоследнееЗначениеЦикла;
								
								пПоиска = Новый Структура("Состояние,Исполнитель,ШагЦикла",СтрокаРезультат.Состояние,НайденнаяСтрока.Исполнитель,ТекущийЦикл);
								НайденныеСтроки = обПроцессСогласования.Состояния.НайтиСтроки(пПоиска);
								
								Для Каждого СтрокаСпр Из НайденныеСтроки Цикл
									СтрокаСпр.Исполнитель = СтрокаРезультат.Исполнитель;
								КонецЦикла;	
								
							КонецЕсли;
							
							НайденнаяСтрока.Исполнитель = СтрокаРезультат.Исполнитель;
							НеобходимаЗаписьОбъекта = Истина;	
							
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если НеобходимаЗаписьОбъекта Тогда
				Если ЗначениеЗаполнено(ПроцессСогласования.Ссылка) Тогда
					обПроцессСогласования.Записать();
				КонецЕсли;
			КонецЕсли;	
			
		КонецЦикла;	
		
	КонецЕсли;	
	
	Возврат Новый Структура("НеобходимаЗаписьОбъекта, ЗаписываемыйОбъект, Ошибка, СообщениеРезультатаВыполнения", 
							 НеобходимаЗаписьОбъекта, ДокументОбъект, Ошибка, СообщениеРезультатаВыполнения);
	
КонецФункции
