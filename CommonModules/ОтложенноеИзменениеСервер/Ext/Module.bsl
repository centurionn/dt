// Евросиб(ДИТ) US 84968 ТА 93711 Сержантова А.С. 13.11.2024
Функция ОбработчикИзменения_МорскойРейс(ДокументОбъект, ИсточникИзменения = Неопределено)
	
	Ошибка = Ложь;
	СообщениеРезультатаВыполнения = ""; 
	НеобходимаЗаписьОбъекта = Ложь;
	
	Если не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "Состояния") Тогда
		НеобходимаЗаписьОбъекта = Ложь;
		Ошибка = Ложь;
		Возврат Новый Структура("НеобходимаЗаписьОбъекта, ЗаписываемыйОбъект, Ошибка, СообщениеРезультатаВыполнения", 
							 НеобходимаЗаписьОбъекта, ДокументОбъект, Ошибка, СообщениеРезультатаВыполнения);
	КонецЕсли;	
	
	СостояниеДляЗадачи = Справочники.Состояния.УдаленМорскойРейс;
	ЗадачаОбновленияДобавлена = Ложь;
	Для каждого СтрСостояния Из ДокументОбъект.Состояния Цикл
		Если СтрСостояния.Состояние = СостояниеДляЗадачи Тогда
			СтрСостояния.Статус = Перечисления.СтатусыЭтапов.ВРаботе;
			СтрСостояния.НачалоРаботы = ТекущаяДата();  
			СтрСостояния.Комментарий = "Морской рейс " + ?(ИсточникИзменения<>Неопределено, ИсточникИзменения, "") + " удален";
			ЗадачаОбновленияДобавлена = Истина; 
			Прервать;
		КонецЕсли;
	КонецЦикла;  
	Если не ЗадачаОбновленияДобавлена Тогда
		НС = ДокументОбъект.Состояния.Добавить();	
		НС.Состояние = СостояниеДляЗадачи;
		НС.Статус = Перечисления.СтатусыЭтапов.ВРаботе; 
		НС.Исполнитель = ДокументОбъект.Автор;  
		НС.Наблюдатель = ДокументОбъект.Автор;
		НС.ПредыдущиеЭтапы = "1";  
		НС.НачалоРаботы = ТекущаяДата(); 
		//СтрСостояния.Комментарий = "Морской рейс " + ?(ИсточникИзменения<>Неопределено, ИсточникИзменения, "") + " удален";
		//Евросиб(ДИТ), Беляев СЮ, Ticket#0394272, 09-04-2025, начало
		НС.Комментарий = "Морской рейс " + ?(ИсточникИзменения<>Неопределено, ИсточникИзменения, "") + " удален";
		//Евросиб(ДИТ), Беляев СЮ, Ticket#0394272, 09-04-2025, конец
		ЗадачаОбновленияДобавлена = Истина;
	КонецЕсли;   
	
	НеобходимаЗаписьОбъекта = Истина;

	Возврат Новый Структура("НеобходимаЗаписьОбъекта, ЗаписываемыйОбъект, Ошибка, СообщениеРезультатаВыполнения", 
							 НеобходимаЗаписьОбъекта, ДокументОбъект, Ошибка, СообщениеРезультатаВыполнения);

КонецФункции 

