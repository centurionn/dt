	СообщениеРезультатаВыполнения = "";
	Попытка
		Документы.Сделка.ЗаполнитьУчетныеДокументыВДоходах(обСделка);
		ПоставитьСвязанныеОбъектыВОчередьИзмененияПоИсточникуДокументСделка(обСделка);
	Исключение
		СообщениеРезультатаВыполнения = ОписаниеОшибки(); 
