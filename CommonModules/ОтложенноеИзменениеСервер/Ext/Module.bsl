Функция ПолучитьТаблицуДоходовКРасходам(СделкаСсылка, МассивГУИДРасходов)
	Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СделкаРасходы.ГУИД КАК ГУИД,
		|	СделкаРасходы.СтрокаСвязьУчетныхЕдиниц КАК СтрокаСвязьУчетныхЕдиниц,
		|	СделкаРасходы.Услуга КАК Услуга,
		|	СделкаРасходы.ИсточникПоявленияСтрокиЭкономики КАК ИсточникПоявленияСтрокиЭкономики,
		|	СделкаРасходы.Перевыставляемая КАК Перевыставляемая,
		|	СделкаРасходы.ОтнестиНаЗатраты КАК ОтнестиНаЗатраты,
		|	СделкаРасходы.АвтоматическиПривязыватьРасходКДоходу КАК АвтоматическиПривязыватьРасходКДоходу,
		|	СделкаРасходы.СтрокаРасходовВСделкеИсточник КАК СтрокаРасходовВСделкеИсточник,
		|	СделкаРасходы.ПеренесеннаяСделкаИсточник КАК ПеренесеннаяСделкаИсточник,
		|	СделкаРасходы.СтрокаКалькуляции КАК СтрокаКалькуляции
		|ПОМЕСТИТЬ ВТ_Расходы
		|ИЗ
		|	Документ.Сделка.Расходы КАК СделкаРасходы
		|ГДЕ
		|	СделкаРасходы.Ссылка = &Ссылка
		|	И СделкаРасходы.ГУИД В(&МассивГУИДРасходов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СделкаСвязьДоходовИРасходов.Доходы КАК Доходы,
		|	СделкаСвязьДоходовИРасходов.Расходы КАК Расходы,
		|	СделкаСвязьДоходовИРасходов.СвязьУчетныхЕдиниц КАК СвязьУчетныхЕдиниц,
		|	СделкаСвязьДоходовИРасходов.Услуга КАК Услуга
		|ПОМЕСТИТЬ ВТ_СвязьДоходовИРасходов
		|ИЗ
		|	Документ.Сделка.СвязьДоходовИРасходов КАК СделкаСвязьДоходовИРасходов
		|ГДЕ
		|	СделкаСвязьДоходовИРасходов.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СделкаДоходы.ГУИД КАК ГУИД,
		|	СделкаДоходы.Услуга КАК Услуга,
		|	СделкаДоходы.Перевыставляемая КАК Перевыставляемая,
		|	СделкаДоходы.УслугаВнеСтавки КАК УслугаВнеСтавки,
		|	СделкаДоходы.ДоплатныеКТК КАК ДоплатныеКТК,
		|	СделкаДоходы.ИсточникПоявленияСтрокиЭкономики КАК ИсточникПоявленияСтрокиЭкономики,
		|	ВЫРАЗИТЬ(СделкаДоходы.КорректировкаДокумента КАК Документ.КорректировкаРеализации) КАК КорректировкаДокумента,
		|	СделкаДоходы.СтрокаКалькуляции КАК СтрокаКалькуляции,
		|	СделкаДоходы.НеВыставлятьКлиенту КАК НеВыставлятьКлиенту
		|ПОМЕСТИТЬ ВТ_Доходы
		|ИЗ
		|	Документ.Сделка.Доходы КАК СделкаДоходы
		|ГДЕ
		|	СделкаДоходы.Ссылка = &Ссылка
		|	И (СделкаДоходы.УчДокумент = НЕОПРЕДЕЛЕНО
		|			ИЛИ СделкаДоходы.УчДокумент.Ссылка ЕСТЬ NULL)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СделкаСвязьУчетныхЕдиниц.ГУИД КАК ГУИД,
		|	СделкаСвязьУчетныхЕдиниц.ВидТранспортногоСообщения КАК ВидТранспортногоСообщения
		|ПОМЕСТИТЬ ВТ_СвязьУчетныхЕдиниц
		|ИЗ
		|	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
		|ГДЕ
		|	СделкаСвязьУчетныхЕдиниц.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СделкаДоходы.ГУИД КАК ГУИД,
		|	СделкаДоходы.Услуга КАК Услуга,
		|	СделкаДоходы.Перевыставляемая КАК Перевыставляемая,
		|	СделкаДоходы.УслугаВнеСтавки КАК УслугаВнеСтавки,
		|	СделкаДоходы.ИсточникПоявленияСтрокиЭкономики КАК ИсточникПоявленияСтрокиЭкономики,
		|	СделкаСвязьДоходовИРасходов.СвязьУчетныхЕдиниц КАК СвязьУчетныхЕдиниц,
		|	СделкаСвязьУчетныхЕдиниц.ВидТранспортногоСообщения КАК ВидТранспортногоСообщения,
		|	СделкаДоходы.НеВыставлятьКлиенту КАК НеВыставлятьКлиенту,
		|	СделкаДоходы.СтрокаКалькуляции КАК СтрокаКалькуляции
		|ПОМЕСТИТЬ ВТ_СвязьДоходыСУЕ
		|ИЗ
		|	ВТ_Доходы КАК СделкаДоходы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СвязьДоходовИРасходов КАК СделкаСвязьДоходовИРасходов
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
		|			ПО СделкаСвязьДоходовИРасходов.СвязьУчетныхЕдиниц = СделкаСвязьУчетныхЕдиниц.ГУИД
		|		ПО СделкаДоходы.ГУИД = СделкаСвязьДоходовИРасходов.Доходы
		|			И (СделкаДоходы.ИсточникПоявленияСтрокиЭкономики = ЗНАЧЕНИЕ(Перечисление.ИсточникПоявленияСтрокиЭкономики.ДопУслугаАвтоматически))
		|			И (НЕ ЕСТЬNULL(СделкаДоходы.КорректировкаДокумента.ВидОперации, ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СвязьДоходыСУЕ.ГУИД КАК Доходы,
		|	ВТ_Расходы.ГУИД КАК Расходы,
		|	ВТ_Расходы.СтрокаСвязьУчетныхЕдиниц КАК СвязьУчетныхЕдиниц,
		|	ВТ_СвязьДоходыСУЕ.НеВыставлятьКлиенту КАК НеВыставлятьКлиенту,
		|	ВТ_Расходы.Услуга КАК Услуга
		|ПОМЕСТИТЬ ВТ_Итоговая
		|ИЗ
		|	ВТ_Расходы КАК ВТ_Расходы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СвязьДоходыСУЕ КАК ВТ_СвязьДоходыСУЕ
		|		ПО ВТ_Расходы.СтрокаСвязьУчетныхЕдиниц = ВТ_СвязьДоходыСУЕ.СвязьУчетныхЕдиниц
		|			И ВТ_Расходы.Услуга = ВТ_СвязьДоходыСУЕ.Услуга
		|			И (ВТ_СвязьДоходыСУЕ.УслугаВнеСтавки = ИСТИНА)
		|			И (ВЫБОР
		|				КОГДА ВТ_СвязьДоходыСУЕ.СтрокаКалькуляции <> """"
		|					ТОГДА ВТ_Расходы.СтрокаКалькуляции = ВТ_СвязьДоходыСУЕ.СтрокаКалькуляции
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_Итоговая.Доходы КАК Доходы,
		|	ВТ_Итоговая.Расходы КАК Расходы,
		|	ВТ_Итоговая.СвязьУчетныхЕдиниц КАК СвязьУчетныхЕдиниц,
		|	ВТ_Итоговая.Услуга КАК Услуга,
		|	ВТ_Итоговая.НеВыставлятьКлиенту КАК НеВыставлятьКлиенту,
		|	ВТ_Итоговая.Доходы <> ЕСТЬNULL(СделкаСвязьДоходовИРасходов.Доходы, """") КАК ТребуетсяУстановитьСвязь
		|ИЗ
		|	ВТ_Итоговая КАК ВТ_Итоговая
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СвязьДоходовИРасходов КАК СделкаСвязьДоходовИРасходов
		|		ПО ВТ_Итоговая.Расходы = СделкаСвязьДоходовИРасходов.Расходы
		|			И ВТ_Итоговая.СвязьУчетныхЕдиниц = СделкаСвязьДоходовИРасходов.СвязьУчетныхЕдиниц";
		
		Запрос.УстановитьПараметр("Ссылка", СделкаСсылка);
		Запрос.УстановитьПараметр("МассивГУИДРасходов", МассивГУИДРасходов);
		Возврат Запрос.Выполнить().Выгрузить();
КонецФункции
