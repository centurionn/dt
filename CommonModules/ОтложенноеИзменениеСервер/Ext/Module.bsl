		|	РелизКлиентаКонтейнеры.Ссылка КАК РелизКлиента
		|ИЗ
		|	Документ.РелизКлиента.Контейнеры КАК РелизКлиентаКонтейнеры
		|ГДЕ
		|	РелизКлиентаКонтейнеры.КлючАналитикиПеревозки = &КлючАналитикиПеревозки";
	
	Запрос.УстановитьПараметр("КлючАналитикиПеревозки", КлючАналитикиПеревозки.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ПоставитьОбъектВОчередьИзменения(Выборка.РелизКлиента, КлючАналитикиПеревозки.Ссылка);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры
