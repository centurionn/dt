
Процедура ПоставитьСвязанныеОбъектыВОчередьИзменения(ИсточникИзменения) Экспорт
	Если ТипЗнч(ИсточникИзменения) = Тип("СправочникОбъект.Пользователи") Тогда
		ПоставитьСвязанныеОбъектыВОчередьИзмененияПоИсточникуСправочникПользователи(ИсточникИзменения);
	ИначеЕсли ТипЗнч(ИсточникИзменения) = Тип("СправочникОбъект.ДоговорыКонтрагентов") Тогда
		ПоставитьСвязанныеОбъектыВОчередьИзмененияПоИсточникуСправочникДоговорыКонтрагентов(ИсточникИзменения);
	ИначеЕсли ТипЗнч(ИсточникИзменения) = Тип("ДокументОбъект.Сделка") Тогда
		ПоставитьСвязанныеОбъектыВОчередьИзмененияПоИсточникуДокументСделка(ИсточникИзменения);
	ИначеЕсли ТипЗнч(ИсточникИзменения) = Тип("РегистрСведенийНаборЗаписей.ИнформацияОтТерминалов") Тогда
		ПоставитьСвязанныеОбъектыВОчередьИзмененияПоИсточникуРегистрСведенийИнформацияОтТерминалов(ИсточникИзменения);
	//Евросиб Каблов 07.06.2023 ( 68187
	ИначеЕсли ТипЗнч(ИсточникИзменения) = Тип("ДокументОбъект.РасчетСНП") Тогда
		ПоставитьСвязанныеОбъектыВОчередьИзмененияПоИсточникуСверхнормативы(ИсточникИзменения);
	//Евросиб Каблов 07.06.2023 )
	//Евросиб Коханенко Н.А. 15.02.2024 (( #80981 
	ИначеЕсли ТипЗнч(ИсточникИзменения) = Тип("ДокументОбъект.Калькуляция") Тогда
		ПоставитьСвязанныеОбъектыВОчередьИзмененияПоИсточникуКалькуляция(ИсточникИзменения);
	//Евросиб Коханенко Н.А. 15.02.2024 )) #80981
	// ДИТ US 79304 ТА 79312 Сержантова А.С. Начало: 17.04.2024
	ИначеЕсли ТипЗнч(ИсточникИзменения) = Тип("РегистрСведенийМенеджерЗаписи.стоки_ТекущиеДанные") Тогда
		ПоставитьСвязанныеОбъектыВОчередьИзмененияПоИсточникуРегистрСведенийТекущиеДанныеКТК(ИсточникИзменения);
	// ДИТ US 79304 ТА 79312 Сержантова А.С. Конец: 17.04.2024
	// Евросиб BUG 85420 TA 86264 Рыбьяков К.А. 09.07.2024 ((
	ИначеЕсли ТипЗнч(ИсточникИзменения) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		ПоставитьСвязанныеОбъектыВОчередьИзмененияПоИсточникуРеализацияТоваровУслуг(ИсточникИзменения);
	// Евросиб Рыбьяков К.А. 09.07.2024 )) 
	// Евросиб(ДИТ) US 84968 ТА 93711 Сержантова А.С. Начало: 13.11.2024
	ИначеЕсли ТипЗнч(ИсточникИзменения) = Тип("СправочникОбъект.РейсыМоре") Тогда
		ПоставитьСвязанныеОбъектыВОчередьИзмененияПоИсточникуМорскиеРейсы(ИсточникИзменения);
	// Евросиб(ДИТ) US 84968 ТА 93711 Сержантова А.С. Конец: 13.11.2024	
	//Евросиб Каблов 10.06.2025 ( #111512
	ИначеЕсли ТипЗнч(ИсточникИзменения) = Тип("СправочникОбъект.РейсыЖД") Тогда
		ПоставитьСвязанныеОбъектыВОчередьИзмененияПоИсточникуЖДРейсы(ИсточникИзменения);
	//Евросиб Каблов 10.06.2025 )	
	// Евросиб US 91362 TA 104075 Рыбьяков К.А. 15.04.2025 ((
	ИначеЕсли ТипЗнч(ИсточникИзменения) = Тип("ДокументОбъект.РасчетДополнительныеРасходы") Тогда
		ПоставитьСвязанныеОбъектыВОчередьИзмененияПоИсточникуДополнительныеРасходы(ИсточникИзменения);
	// Евросиб Рыбьяков К.А. 15.04.2025 ))
	// Евросиб US 88683 TA 108959 Рыбьяков К.А. 25.05.2025 ((
	ИначеЕсли ТипЗнч(ИсточникИзменения) = Тип("СправочникОбъект.КлючиАналитикиНоминацийРелиза") Тогда
		ПоставитьСвязанныеОбъектыВОчередьИзмененияПоИсточникуКлючАналитикиНоминации(ИсточникИзменения);
	// Евросиб Рыбьяков К.А. 25.05.2025 ))    
	//Евросиб(ДИТ) Антонова А.С. US 77172 ТА 110410 Начало 26.05.2025
	ИначеЕсли ТипЗнч(ИсточникИзменения) = Тип("СправочникОбъект.КлючиАналитикиПеревозки") Тогда
		ПоставитьСвязанныеОбъектыВОчередьИзмененияПоИсточникуКлючАналитикиПеревозки(ИсточникИзменения);
	//Евросиб(ДИТ) Антонова А.С. US 77172 ТА 110410 Конец 26.05.2025
	//Евросиб Шевченко А.В. 03.06.2025 US 97974 TA 111305
	ИначеЕсли ТипЗнч(ИсточникИзменения) = Тип("ДокументСсылка.НормативКонтрибуции") Тогда
		ПоставитьСвязанныеОбъектыВОчередьИзмененияПоИсточникуНормативКонтрибуции(ИсточникИзменения);
	//Евросиб Шевченко А.В. 03.06.2025 US 97974 TA 111305
	//Евросиб Шевченко А.В. US 110215 TA 128335 17.03.2026
	ИначеЕсли ТипЗнч(ИсточникИзменения) = Тип("ДокументСсылка.ТранспортныйДокумент") Тогда
		ПоставитьСвязанныеОбъектыВОчередьИзмененияПоИсточникуТранспортныйДокумент(ИсточникИзменения);
	//Евросиб Шевченко А.В. US 110215 TA 128335 17.03.2026
	КонецЕсли;
КонецПроцедуры                                                       

Процедура ПоставитьСвязанныеОбъектыВОчередьИзмененияПоИсточникуТранспортныйДокумент(ТранспортныйДокумент) //Евросиб Шевченко А.В. US 110215 TA 128335 17.03.2026
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПСЦПоставщикаУслуги.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПСЦПоставщика.Услуги КАК ПСЦПоставщикаУслуги
		|ГДЕ
		|	НЕ ПСЦПоставщикаУслуги.Ссылка.ПометкаУдаления
		|	И ПСЦПоставщикаУслуги.Ссылка.ВидУслугПоставщика В(&ВидыУслугПоставщика)
		|	И ПСЦПоставщикаУслуги.Коносамент = &Коносамент";
	
	ВидыУслугПоставщика = Новый Массив;
	ВидыУслугПоставщика.Добавить(Справочники.ВидыУслугПоставщиков.Фрахт);
	ВидыУслугПоставщика.Добавить(Справочники.ВидыУслугПоставщиков.ТЭО);
	
	Запрос.УстановитьПараметр("ВидыУслугПоставщика", ВидыУслугПоставщика);
	Запрос.УстановитьПараметр("Коносамент", ТранспортныйДокумент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПоставитьОбъектВОчередьИзменения(ВыборкаДетальныеЗаписи.Ссылка, ТранспортныйДокумент);
	КонецЦикла;
				
КонецПроцедуры

Процедура ПоставитьСвязанныеОбъектыВОчередьИзмененияПоИсточникуНормативКонтрибуции(НормативКонтрибуции) //Евросиб Шевченко А.В. 03.06.2025 US 97974 TA 111305
	
	ВыборкаПодчиненныхДокументов=КонтрольДоступностиДокументов_сервер.ПолучитьВыборкуПодчиненныхДокументов(НормативКонтрибуции);
	Если ВыборкаПодчиненныхДокументов <> Неопределено Тогда
		Пока ВыборкаПодчиненныхДокументов.Следующий() Цикл
			Если ТипЗнч(ВыборкаПодчиненныхДокументов.Ссылка) = Тип("ДокументСсылка.Калькуляция") Тогда
				ПоставитьОбъектВОчередьИзменения(ВыборкаПодчиненныхДокументов.Ссылка, НормативКонтрибуции);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры

Процедура ПоставитьОбъектВОчередьИзменения(ОбрабатываемыйОбъект, ИсточникИзменения) Экспорт
	
	Если Не ЗначениеЗаполнено(ОбрабатываемыйОбъект)
		ИЛИ Не ЗначениеЗаполнено(ИсточникИзменения) Тогда
		Возврат;
	КонецЕсли;
	
	мз = РегистрыСведений.ОчередьОтложенногоИзмененияВзаимосвязанныхОбъектов.СоздатьМенеджерЗаписи();
	мз.ИсточникИзменения = ИсточникИзменения;
	мз.ОбрабатываемыйОбъект = ОбрабатываемыйОбъект;
	мз.ДатаЗаписи = ТекущаяДата();
	мз.Пользователь = Пользователи.ТекущийПользователь();
	мз.Записать();
	
КонецПроцедуры

Процедура ПоставитьСвязанныеОбъектыВОчередьИзмененияПоИсточникуРеализацияТоваровУслуг(РеализацияОбъект)
	
	// Евросиб BUG 85420 TA 86264 Рыбьяков К.А. 09.07.2024 ((
	//Евросиб Каблов 22.05.2025 ( #110248
	//ПрошлаяДатаДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеализацияОбъект.Ссылка, "ДатаДокумента");
	//Если ЗначениеЗаполнено(РеализацияОбъект.Ссылка) И РеализацияОбъект.ДатаДокумента <> ПрошлаяДатаДокумента Тогда
	ПрошлыеЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеализацияОбъект.Ссылка, "ДатаДокумента,ПериодВО");
	Если ЗначениеЗаполнено(РеализацияОбъект.Ссылка) И (РеализацияОбъект.ДатаДокумента <> ПрошлыеЗначенияРеквизитов.ДатаДокумента 
		 											Или РеализацияОбъект.ПериодВО <> ПрошлыеЗначенияРеквизитов.ПериодВО) Тогда
	//Евросиб Каблов 22.05.2025 )
		Запрос = Новый Запрос;
		//Евросиб Каблов 28.11.2025 ( #111016
		//Запрос.Текст = 
		//"ВЫБРАТЬ РАЗЛИЧНЫЕ
		//|	РеализацияТоваровУслугСчетаНаОплатуПокупателям.Сделка КАК Сделка
		//|ИЗ
		//|	Документ.РеализацияТоваровУслуг.СчетаНаОплатуПокупателям КАК РеализацияТоваровУслугСчетаНаОплатуПокупателям
		//|ГДЕ
		//|	РеализацияТоваровУслугСчетаНаОплатуПокупателям.Ссылка = &Ссылка 
		//|	И РеализацияТоваровУслугСчетаНаОплатуПокупателям.Сделка <> ЗНАЧЕНИЕ(Документ.Сделка.ПустаяСсылка)";
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РеализацияТоваровУслугУслуги.Сделка КАК Сделка
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.Услуги КАК РеализацияТоваровУслугУслуги
		|ГДЕ
		|	РеализацияТоваровУслугУслуги.Ссылка = &Ссылка
		|	И РеализацияТоваровУслугУслуги.Сделка <> ЗНАЧЕНИЕ(Документ.Сделка.ПустаяСсылка)";
		//Евросиб Каблов 28.11.2025 ) #111016
		
		Запрос.УстановитьПараметр("Ссылка", РеализацияОбъект.Ссылка);
			
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				ПоставитьОбъектВОчередьИзменения(Выборка.Сделка, РеализацияОбъект.Ссылка);
			КонецЦикла;	
		КонецЕсли;
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 09.07.2024 ))
	
КонецПроцедуры

Процедура ПоставитьСвязанныеОбъектыВОчередьИзмененияПоИсточникуСправочникПользователи(ПользовательОбъект)
	
	//уволенный сотрудник ответственный за договоры
	//найдем все договоры, в которых источник является ответственным за договор и он недействителен
	//и все сделки где ответственный не выполнил свою задачу по выставлению документов
	Если ПользовательОбъект.Недействителен Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДоговорыКонтрагентовОтветственные.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов.Ответственные КАК ДоговорыКонтрагентовОтветственные
		|ГДЕ
		|	ДоговорыКонтрагентовОтветственные.ТипОтветственного = &ТипОтветственного
		|	И ДоговорыКонтрагентовОтветственные.Ответственный = &Ответственный
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СделкаСвязьУчетныхЕдиниц.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.Состояния КАК СделкаСостояния
		|		ПО СделкаСвязьУчетныхЕдиниц.Ссылка = СделкаСостояния.Ссылка
		|			И СделкаСвязьУчетныхЕдиниц.ЗадачаГотовностиКВыставлению = СделкаСостояния.Состояние
		|			И (СделкаСостояния.Статус = &Статус)
		|ГДЕ
		|	СделкаСвязьУчетныхЕдиниц.ОтветственныйЗаУчет = &Ответственный
		|	И СделкаСостояния.Статус ЕСТЬ NULL
		//ДИТ, Беляев СЮ, BUG 78729/ TASK 78731, 13-12-2023, начало
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ 
		|	СделкаСвязьУчетныхЕдиниц.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьДоходовИРасходов КАК СделкаСвязьДоходовИРасходов
		|       	ПО СделкаСвязьУчетныхЕдиниц.Ссылка = СделкаСвязьДоходовИРасходов.Ссылка
		|				И СделкаСвязьУчетныхЕдиниц.ГУИД = СделкаСвязьДоходовИРасходов.СвязьУчетныхЕдиниц
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.Доходы КАК СделкаДоходы
		|       	ПО СделкаДоходы.Ссылка = СделкаСвязьДоходовИРасходов.Ссылка
		|           	И СделкаДоходы.ГУИД = СделкаСвязьДоходовИРасходов.Доходы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.Состояния КАК СделкаСостояния
		|		ПО СделкаДоходы.Ссылка = СделкаСостояния.Ссылка
		|			И СделкаДоходы.ЗадачаГотовностиКВыставлению = СделкаСостояния.Состояние
		|           И СделкаСостояния.Исполнитель = &Ответственный
		|           И СделкаСостояния.Состояние В ИЕРАРХИИ (&ТипыЗадач)
		|			И (СделкаСостояния.Статус <> &Статус)";
		МассивТиповЗадач = Новый Массив;
		МассивТиповЗадач.Добавить(Справочники.Состояния.ЗадачиСозданияКомплектаДокументов);
		МассивТиповЗадач.Добавить(Справочники.Состояния.ЗадачиТребуетсяПеревыставитьРасходы);
		Запрос.УстановитьПараметр("ТипыЗадач", МассивТиповЗадач);
		//ДИТ, Беляев СЮ, BUG 78729/ TASK 78731, 13-12-2023, конец
		Запрос.УстановитьПараметр("Ответственный", ПользовательОбъект.Ссылка);
		Запрос.УстановитьПараметр("ТипОтветственного", Перечисления.ТипыОтветственных.ОтветственныйЗаУчет);
		Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыЭтапов.Выполнен);
		РезультатыЗапроса = Запрос.ВыполнитьПакет();
		ВыборкаДоговоров = РезультатыЗапроса[0].Выбрать();
		Пока ВыборкаДоговоров.Следующий() Цикл
			ПоставитьОбъектВОчередьИзменения(ВыборкаДоговоров.Ссылка, ПользовательОбъект.Ссылка);		
		КонецЦикла;                           
		ВыборкаСделок = РезультатыЗапроса[1].Выбрать();
		Пока ВыборкаСделок.Следующий() Цикл
			ПоставитьОбъектВОчередьИзменения(ВыборкаСделок.Ссылка, ПользовательОбъект.Ссылка);		
		КонецЦикла;                           
	КонецЕсли;
	
КонецПроцедуры

Процедура ПоставитьСвязанныеОбъектыВОчередьИзмененияПоИсточникуСправочникДоговорыКонтрагентов(ДоговорКонтрагентаОбъект)
	//сделки по ответственным за учет
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЧСвязьУчетныхЕдиниц.ГУИД КАК ГУИД,
	|	ТЧСвязьУчетныхЕдиниц.Заявка КАК Заявка,
	|	ТЧСвязьУчетныхЕдиниц.Договор КАК Договор,
	|	ТЧСвязьУчетныхЕдиниц.Ссылка.ЦФО КАК ЦФОСделки,
	|	ТЧСвязьУчетныхЕдиниц.Ссылка КАК Сделка,
	|	ТЧСвязьУчетныхЕдиниц.ЗадачаГотовностиКВыставлению КАК ЗадачаГотовностиКВыставлению,
	|	ТЧСвязьУчетныхЕдиниц.ОтветственныйЗаУчет КАК ОтветственныйЗаУчет
	|ПОМЕСТИТЬ ВТСвязьУчетныхЕдиниц
	|ИЗ
	|	Документ.Сделка.СвязьУчетныхЕдиниц КАК ТЧСвязьУчетныхЕдиниц
	|ГДЕ
	|	ТЧСвязьУчетныхЕдиниц.Договор = &Договор
