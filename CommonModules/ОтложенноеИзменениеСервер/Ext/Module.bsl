Процедура ПоставитьСвязанныеОбъектыВОчередьИзмененияПоИсточникуРегистрСведенийТекущиеДанныеКТК(ИсточникИзменения)

	Если ЗначениеЗаполнено(ИсточникИзменения.ГУИДЗаписиПредыдущегоЦикла) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	стоки_ТекущиеДанные.тек_Релиз КАК Релиз
		|ИЗ
		|	РегистрСведений.стоки_ТекущиеДанные КАК стоки_ТекущиеДанные
		|ГДЕ
		|	стоки_ТекущиеДанные.ГУИДЗаписи = &ГУИДЗаписи";
		
		Запрос.УстановитьПараметр("ГУИДЗаписи", ИсточникИзменения.ГУИДЗаписиПредыдущегоЦикла);
		
		РезультатЗапроса = Запрос.Выполнить();
		Если не РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий(); 
			Если ЗначениеЗаполнено(Выборка.Релиз) Тогда
				ПоставитьОбъектВОчередьИзменения(Выборка.Релиз, 
					Перечисления.ТипыИсточниковОтложеннойЗаписиВзаимосвязанныхОбъектов.РегистрСведенийСтокиТекущиеДанные);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;		

	//Евросиб(ДИТ), Беляев СЮ, BUG 95529 / TA 95530, 18-11-2024, начало
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	стоки_ТекущиеДанные.тек_Релиз КАК Релиз
	|ИЗ
	|	РегистрСведений.стоки_ТекущиеДанные КАК стоки_ТекущиеДанные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	|		ПО стоки_ТекущиеДанные.тек_Релиз = РелизСобственникаНоминации.Ссылка
	|			И стоки_ТекущиеДанные.КТК = РелизСобственникаНоминации.Контейнер
	|			И стоки_ТекущиеДанные.тек_ДатаСдачиВСток <> РелизСобственникаНоминации.ДатаВозвратаСобственнику
	|ГДЕ
	|	стоки_ТекущиеДанные.ГУИДЗаписи = &ГУИДЗаписи";
	
	Запрос.УстановитьПараметр("ГУИДЗаписи", ИсточникИзменения.ГУИДЗаписи);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ПоставитьОбъектВОчередьИзменения(Выборка.Релиз, 
					Перечисления.ТипыИсточниковОтложеннойЗаписиВзаимосвязанныхОбъектов.РегистрСведенийСтокиТекущиеДанные);
	КонецЕсли;
	//Евросиб(ДИТ), Беляев СЮ, BUG 95529 / TA 95530, 18-11-2024, конец
	
КонецПроцедуры

// Евросиб(ДИТ) US 84968 ТА 93711 Сержантова А.С. 13.11.2024
Процедура ПоставитьСвязанныеОбъектыВОчередьИзмененияПоИсточникуМорскиеРейсы(ИсточникИзменения)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаявкаПереченьРейсов.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
		|ГДЕ
		|	ЗаявкаПереченьРейсов.Рейс = &Рейс
		|	И не ЗаявкаПереченьРейсов.Ссылка.ПометкаУдаления   
		// Евросиб(ДИТ) BUG 95403 ТА 95433 Сержантова А.С. Начало: 14.11.2024
		|	И ЗаявкаПереченьРейсов.Рейс.ПометкаУдаления
		// Евросиб(ДИТ) BUG 95403 ТА 95433 Сержантова А.С. Конец: 14.11.2024
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СделкаРейсы.Ссылка
		|ИЗ
		|	Документ.Сделка.Рейсы КАК СделкаРейсы
		|ГДЕ
		|	не СделкаРейсы.Ссылка.ПометкаУдаления
		|	И СделкаРейсы.Рейс = &Рейс
		// Евросиб(ДИТ) BUG 95403 ТА 95433 Сержантова А.С. Начало: 14.11.2024    
		|	И СделкаРейсы.Рейс.ПометкаУдаления
		|	
		|ОБЪЕДИНИТЬ ВСЕ 
		|
		|ВЫБРАТЬ
		|	Коносамент.Ссылка
		|ИЗ
		|	Документ.ТранспортныйДокумент КАК Коносамент
		|ГДЕ
		|	не Коносамент.ПометкаУдаления
		|	И Коносамент.МорскойРейс = &Рейс
		|	И не Коносамент.МорскойРейс.ПометкаУдаления";
		// Евросиб(ДИТ) BUG 95403 ТА 95433 Сержантова А.С. Конец: 14.11.2024
	
	Запрос.УстановитьПараметр("Рейс", ИсточникИзменения.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл 
			ПоставитьОбъектВОчередьИзменения(Выборка.Ссылка, ИсточникИзменения.Ссылка);
		КонецЦикла;
	КонецЕсли;	

КонецПроцедуры

//Евросиб Каблов 10.06.2025 #111512
Процедура ПоставитьСвязанныеОбъектыВОчередьИзмененияПоИсточникуЖДРейсы(ИсточникИзменения)
	
	Если ЗначениеЗаполнено(ИсточникИзменения.Ссылка) Тогда
		ИсточникИзмененияСсылка = ИсточникИзменения.Ссылка;
	Иначе
		ИсточникИзмененияСсылка = ИсточникИзменения.ПолучитьСсылкуНового();
		Если Не ЗначениеЗаполнено(ИсточникИзмененияСсылка) Тогда
			ИсточникИзмененияСсылка = Справочники.РейсыЖД.ПолучитьСсылку();
			ИсточникИзменения.УстановитьСсылкуНового(ИсточникИзмененияСсылка);
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РейсыЖДФактическийСоставПоезда.НомерКонтейнера КАК НомерКонтейнера,
	|	РейсыЖДФактическийСоставПоезда.НомерНакладной КАК НомерНакладной,
	|	ТЕ.Ссылка КАК Контейнер,
	|	ТранспортныйДокумент.Ссылка КАК Накладная
	|ПОМЕСТИТЬ ФактическийСостав
	|ИЗ
	|	Справочник.РейсыЖД.ФактическийСоставПоезда КАК РейсыЖДФактическийСоставПоезда
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТЕ КАК ТЕ
	|		ПО РейсыЖДФактическийСоставПоезда.НомерКонтейнера = ТЕ.Наименование
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	|		ПО РейсыЖДФактическийСоставПоезда.НомерНакладной = ТранспортныйДокумент.НомерТранспортногоДокумента
	|ГДЕ
	|	РейсыЖДФактическийСоставПоезда.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СделкаСвязьУчетныхЕдиниц.Ссылка КАК Ссылка
	|ИЗ
	|	ФактическийСостав КАК ФактическийСостав
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|		ПО ФактическийСостав.Контейнер = СделкаСвязьУчетныхЕдиниц.Контейнер
	|			И ФактическийСостав.Накладная = СделкаСвязьУчетныхЕдиниц.ЖДН
	|ГДЕ
	|	СделкаСвязьУчетныхЕдиниц.Ссылка.Проведен";
	Запрос.УстановитьПараметр("Ссылка", ИсточникИзмененияСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПоставитьОбъектВОчередьИзменения(Выборка.Ссылка, ИсточникИзмененияСсылка);
	КонецЦикла;
	
КонецПроцедуры

