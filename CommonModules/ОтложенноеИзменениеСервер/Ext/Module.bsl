Процедура ПоставитьСвязанныеОбъектыВОчередьИзмененияПоИсточникуРегистрСведенийИнформацияОтТерминалов(ИнформацияОтТерминаловНаборЗаписей)
	
	//получим все релизы для заполнения контейнерами
	Если НЕ ИнформацияОтТерминаловНаборЗаписей.Отбор.Контейнер.Значение = Справочники.ТЕ.ПустаяСсылка() Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РелизКлиента.Ссылка КАК РелизКлиента
		|ИЗ
		|	РегистрСведений.ИнформацияОтТерминалов КАК ИнформацияОтТерминалов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РелизКлиента КАК РелизКлиента
		|		ПО ИнформацияОтТерминалов.НомерРелиза = РелизКлиента.НомерРелиза
		|			И (ИнформацияОтТерминалов.Период = &Период)
		|			И (ИнформацияОтТерминалов.Контейнер = &Контейнер)
		|			И (ИнформацияОтТерминалов.НомерКонтейнера = &НомерКонтейнера)
		//|			И (ИнформацияОтТерминалов.КодТерминала = &КодТерминала) //ДИТ, Беляев СЮ, BUG 67625/TA 72362, 07-07-2023, закомментировал
		|			И (НЕ ИнформацияОтТерминалов.НомерРелиза = """")";
		Запрос.УстановитьПараметр("Период", ИнформацияОтТерминаловНаборЗаписей.Отбор.Период.Значение);
		Запрос.УстановитьПараметр("Контейнер", ИнформацияОтТерминаловНаборЗаписей.Отбор.Контейнер.Значение);
		Запрос.УстановитьПараметр("НомерКонтейнера", ИнформацияОтТерминаловНаборЗаписей.Отбор.НомерКонтейнера.Значение);
		//Запрос.УстановитьПараметр("КодТерминала", ИнформацияОтТерминаловНаборЗаписей.Отбор.КодТерминала.Значение); //ДИТ, Беляев СЮ, BUG 67625/TA 72362, 07-07-2023, закомментировал
		РезультатЗапроса = Запрос.Выполнить(); 
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				ПоставитьОбъектВОчередьИзменения(Выборка.РелизКлиента, Перечисления.ТипыИсточниковОтложеннойЗаписиВзаимосвязанныхОбъектов.РегистрСведенийИнформацияОтТерминалов);
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	
КонецПроцедуры

