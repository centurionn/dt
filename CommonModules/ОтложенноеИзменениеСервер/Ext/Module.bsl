Функция ОбработчикИзменения_ПересчетНормативаКонтрибуцииВКалькуляции(ДокументОбъект,Источник) //Евросиб Шевченко А.В. 03.06.2025 US 97974 TA 111305
	
	Ошибка = Ложь;
	СообщениеРезультатаВыполнения = ""; 
	НеобходимаЗаписьОбъекта = Ложь;   
	
	Попытка
		
		ГУИДСтрокиНормативаКонтрибуции = ДокументОбъект.ГУИДСтрокиНормативыКонтрибуции;
		НормативнаяКонтрибуция = РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ПолучитьНормативнуюКонтрибуциюПоДокументу(ДокументОбъект.Ссылка);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтавкиНормативовКонтрибуции.НормативнаяСтавка КАК НормативнаяСтавка
		|ИЗ
		|	РегистрСведений.СтавкиНормативовКонтрибуции КАК СтавкиНормативовКонтрибуции
		|ГДЕ
		|	СтавкиНормативовКонтрибуции.Регистратор = &Ссылка
		|	И СтавкиНормативовКонтрибуции.ГУИД = &ГУИД";
		
		Запрос.УстановитьПараметр("ГУИД", ГУИДСтрокиНормативаКонтрибуции);
		Запрос.УстановитьПараметр("Ссылка", Источник);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если ВыборкаДетальныеЗаписи.НормативнаяСтавка <> НормативнаяКонтрибуция Тогда
				РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ЗаписатьНормативнуюКонтрибуциюпоДокументу(ДокументОбъект.Ссылка, ВыборкаДетальныеЗаписи.НормативнаяСтавка);
			КонецЕсли;
		КонецЦикла;		
	Исключение
		СообщениеРезультатаВыполнения = ОписаниеОшибки();
		НеобходимаЗаписьОбъекта = Ложь;
		Ошибка = Истина;
	КонецПопытки;
	
	Возврат Новый Структура("НеобходимаЗаписьОбъекта, ЗаписываемыйОбъект, Ошибка, СообщениеРезультатаВыполнения", 
							 НеобходимаЗаписьОбъекта, ДокументОбъект, Ошибка, СообщениеРезультатаВыполнения);
	
КонецФункции
						 
Функция  ОбработчикИзменения_ЗаполнениеУчетныхЕдиницИПунктовВПСЦПоставщика(ДокументОбъект, Источник) //Евросиб Шевченко А.В. US 110215 TA 128335 17.03.2026
	Ошибка = Ложь;
	СообщениеРезультатаВыполнения = ""; 
	НеобходимаЗаписьОбъекта = Ложь;   
	
	Попытка
		
		ВыборкаКоносамент = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник,"СтанцияОтправления, СтанцияНазначения, Коносаменты, МестоПолученияГруза, МестоПоставкиГруза");
			
		Если ДокументОбъект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Фрахт ИЛИ ДокументОбъект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.ТЭО Тогда
			
			Для Каждого СтрУслуги из ДокументОбъект.Услуги Цикл
				
				Если СтрУслуги.Коносамент <> Источник Тогда
					Продолжить;
				КонецЕсли;	
				
				Если СтрУслуги.ПунктОтправления <> ВыборкаКоносамент.СтанцияОтправления Тогда
					СтрУслуги.ПунктОтправления = ВыборкаКоносамент.СтанцияОтправления;
					
					СтрУслуги.ПунктОтправленияСтрана = Локации_сервер.ПолучитьЛокациюВышестоящегоУровняИТипу(СтрУслуги.ПунктОтправления, Перечисления.ТипыИерархииЛокации.Страна);
										
					Если Не ЗначениеЗаполнено(СтрУслуги.ПунктОтправления) Тогда
						ЛокацияПустаяСсылка = Справочники.Локации.ПустаяСсылка();
						СтрУслуги.ПунктОтправленияГород = ЛокацияПустаяСсылка;
						СтрУслуги.ПунктОтправленияСтрана = ЛокацияПустаяСсылка;
					КонецЕсли;
						
					НеобходимаЗаписьОбъекта = Истина;
				КонецЕсли;	
				Если СтрУслуги.ПунктНазначения <> ВыборкаКоносамент.СтанцияНазначения Тогда
					СтрУслуги.ПунктНазначения = ВыборкаКоносамент.СтанцияНазначения;
					
					СтрУслуги.ПунктНазначенияСтрана = Локации_сервер.ПолучитьЛокациюВышестоящегоУровняИТипу(СтрУслуги.ПунктНазначения, Перечисления.ТипыИерархииЛокации.Страна);
					
					Если Не ЗначениеЗаполнено(СтрУслуги.ПунктНазначения) Тогда
						ЛокацияПустаяСсылка = Справочники.Локации.ПустаяСсылка();
						СтрУслуги.ПунктНазначенияГород = ЛокацияПустаяСсылка;
						СтрУслуги.ПунктНазначенияСтрана = ЛокацияПустаяСсылка;
					КонецЕсли;
					
					НеобходимаЗаписьОбъекта = Истина;
				КонецЕсли;
				
				Если СтрУслуги.ТерминалОтправления <> ВыборкаКоносамент.МестоПолученияГруза Тогда
					СтрУслуги.ТерминалОтправления = ВыборкаКоносамент.МестоПолученияГруза;						
					НеобходимаЗаписьОбъекта = Истина;
				КонецЕсли;	
				Если СтрУслуги.ТерминалНазначения <> ВыборкаКоносамент.МестоПоставкиГруза Тогда
					СтрУслуги.ТерминалНазначения = ВыборкаКоносамент.МестоПоставкиГруза;					
					НеобходимаЗаписьОбъекта = Истина;
				КонецЕсли;
				
				СписокКТК = ВыборкаКоносамент.Коносаменты.Выгрузить().ВыгрузитьКолонку("НомерКТК");
				
				СтрокиДляВыгрузкиУЕ = ДокументОбъект.УчетныеЕдиницы.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг",СтрУслуги.ИдентификаторСтрокиУслуг));
				
				СписокУчетныхЕдиниц = ДокументОбъект.УчетныеЕдиницы.Выгрузить(СтрокиДляВыгрузкиУЕ).ВыгрузитьКолонку("УчетнаяЕдиница");
				
				Если НЕ ОбщегоНазначения.КоллекцииИдентичны(СписокКТК, СписокУчетныхЕдиниц,,,Истина) Тогда
					
					НеобходимаЗаписьОбъекта = Истина;
					
					СтрУслуги.СпособВводаУчетныхЕдиниц = Перечисления.СпособыВводаУчетныхЕдиниц.Построчно;
					
					УчетныеЕдиницы = СписокКТК;
					
					СтрокиКУдалению = Новый Массив;
					СтрокиУчетныхЕдиниц = ДокументОбъект.УчетныеЕдиницы.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", СтрУслуги.ИдентификаторСтрокиУслуг));
					Для Каждого СтрокаУчетнойЕдиницы Из СтрокиУчетныхЕдиниц Цикл
						ИндексНайденнойУчетнойЕдиницы =  ДокументОбъект.УчетныеЕдиницы.Найти(СтрокаУчетнойЕдиницы.УчетнаяЕдиница);
						Если ИндексНайденнойУчетнойЕдиницы = Неопределено Тогда
							СтрокиКУдалению.Добавить(СтрокаУчетнойЕдиницы);
						Иначе
							ДокументОбъект.УчетныеЕдиницы.Удалить(ИндексНайденнойУчетнойЕдиницы);
						КонецЕсли;
					КонецЦикла;
					
					Для Каждого Стр Из СтрокиКУдалению Цикл
						ДокументОбъект.УчетныеЕдиницы.Удалить(Стр);
					КонецЦикла;
					
					Для Каждого УчетнаяЕдиница Из СписокКТК Цикл
						Если ЗначениеЗаполнено(УчетнаяЕдиница) Тогда
							СтрокаУчетнойЕдиницы = ДокументОбъект.УчетныеЕдиницы.Добавить();
							СтрокаУчетнойЕдиницы.ИдентификаторСтрокиУслуг = СтрУслуги.ИдентификаторСтрокиУслуг;
							СтрокаУчетнойЕдиницы.УчетнаяЕдиница = УчетнаяЕдиница;
						КонецЕсли;
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Если НеобходимаЗаписьОбъекта Тогда
				Документы.ПСЦПоставщика.СоздатьСтрокиКритериевУслуг(ДокументОбъект);
			КонецЕсли;	
			
		КонецЕсли;
		
	Исключение
		СообщениеРезультатаВыполнения = ОписаниеОшибки();
		НеобходимаЗаписьОбъекта = Ложь;
		Ошибка = Истина;
	КонецПопытки;
	
	Возврат Новый Структура("НеобходимаЗаписьОбъекта, ЗаписываемыйОбъект, Ошибка, СообщениеРезультатаВыполнения", 
	НеобходимаЗаписьОбъекта, ДокументОбъект, Ошибка, СообщениеРезультатаВыполнения);	
КонецФункции

// Евросиб Рыбьяков К.А. 15.04.2025 ))

#КонецОбласти

Процедура ЗаполнитьЕслиЗаполнено(Приемник, Источник)
	Если ЗначениеЗаполнено(Источник) Тогда
		Приемник = Источник;
	КонецЕсли;
КонецПроцедуры
