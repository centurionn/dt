				КонецЦикла;
				Если мз.ДатаЗаписи < ДатаНачалаОбработкиОчереди Тогда
					мз.Обработано = СтрокаТаблицыФиксацииРезультата.Обработано;
				КонецЕсли;
				мз.Записать();
			КонецЕсли;
		КонецЦикла;
