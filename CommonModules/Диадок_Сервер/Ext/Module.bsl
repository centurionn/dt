
Функция ВыполнитьЗапросДокументовПакетовДиадок(Документ1С) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Диадок_Документы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Диадок_Документы КАК Диадок_Документы
	|ГДЕ
	|	Диадок_Документы.Документ = &Документ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Диадок_ПакетыДокументов.Ссылка
	|ИЗ
	|	Справочник.Диадок_ПакетыДокументов КАК Диадок_ПакетыДокументов
	|ГДЕ
	|	Диадок_ПакетыДокументов.Документ = &Документ";
	Запрос.УстановитьПараметр("Документ", Документ1С);
	
	Возврат Запрос.Выполнить();
	
КонецФункции

Процедура ОтвязатьДокумент1СОтДокументовПакетовДиадок(Документ1С) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВыборкаДокументовДиадок = ВыполнитьЗапросДокументовПакетовДиадок(Документ1С).Выбрать();
	Пока ВыборкаДокументовДиадок.Следующий() Цикл
		ДиадокДокумент = ВыборкаДокументовДиадок.Ссылка.ПолучитьОбъект();
		ДиадокДокумент.Документ = Неопределено;
		ДиадокДокумент.ПометкаУдаления = Истина;
		ДиадокДокумент.Записать();
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры