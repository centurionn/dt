//Евросиб Каблов 08.01.2025 #97984
Функция ПолучитьПроцессСогласованияОбъекта(ОбъектСогласования) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПроцессСогласования.Ссылка КАК Ссылка,
	|	МАКСИМУМ(ПроцессСогласованияСостояния.ШагЦикла) КАК ШагЦикла,
	|	ПроцессСогласования.ДокументСогласования.СтатусДокумента КАК СтатусДокумента
	|ИЗ
	|	Справочник.ПроцессСогласования КАК ПроцессСогласования
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПроцессСогласования.Состояния КАК ПроцессСогласованияСостояния
	|		ПО ПроцессСогласования.Ссылка = ПроцессСогласованияСостояния.Ссылка
	|ГДЕ
	|	ПроцессСогласования.ДокументСогласования = &ОбъектСогласования
	|	И НЕ ПроцессСогласования.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	ПроцессСогласования.Ссылка,
	|	ПроцессСогласования.ДокументСогласования.СтатусДокумента";
	
	Запрос.УстановитьПараметр("ОбъектСогласования", ОбъектСогласования);
	
	Выборка = Запрос.Выполнить().Выбрать();
	ДанныеПроцесса = Новый Структура("Ссылка, ШагЦикла, СтатусДокумента");
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ДанныеПроцесса, Выборка);
	КонецЕсли;
	
	Возврат ДанныеПроцесса;
	
КонецФункции

