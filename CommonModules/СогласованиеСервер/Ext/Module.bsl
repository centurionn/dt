// ++ Дудоров С.В. Ticket# 09.12.2022 при создании шаблона документа.
Функция ПолучитьДанныеПоСостояниямОбъектаИзБазы(ОбъектСсылка)

	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(ОбъектСсылка));
	Если Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		ТипОбъекта = "Справочник." + ОбъектМетаданных.Имя;
	ИначеЕсли Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
		ТипОбъекта = "Документ." + ОбъектМетаданных.Имя;
	КонецЕсли;	

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ *
	               |ИЗ
	               |	" + ТипОбъекта + ".Состояния КАК СостоянияОбъекта
	               |ГДЕ
	               |	СостоянияОбъекта.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",ОбъектСсылка);
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции
// -- Дудоров С.В. Ticket# 09.12.2022

// ++ Дудоров С.В. Ticket# 09.12.2022 при создании шаблона документа.
Функция ЕстьДублиСостояний(Состояния) Экспорт
	
	Для Сч = 0 По Состояния.Количество() - 2 Цикл
		ТекСостояние = Состояния[Сч].Состояние;
		Для ТекСч = Сч + 1 По Состояния.Количество() - 1 Цикл
			Если Состояния[ТекСч].Состояние = ТекСостояние Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла; 
	Возврат Ложь;
	
КонецФункции
