//Функция ПересчитатьПоКурсу(Сумма, ВалютаИз, ВалютаВ, ДатаКурса) Экспорт
//ДИТ, Беляев СЮ, BUG 76518 / TA 76823, 03-11-2023, добавлен параметр "ОкруглениеКурса"
Функция ПересчитатьПоКурсу(Сумма, ВалютаИз, ВалютаВ, ДатаКурса, ОкруглениеКурса = Неопределено) Экспорт
	
	Результат = Сумма;
	Если НЕ ЗначениеЗаполнено(ВалютаИз) ИЛИ НЕ ЗначениеЗаполнено(ВалютаВ) ИЛИ ВалютаИз = ВалютаВ Тогда Возврат Результат; КонецЕсли;
	
	КурсВалюты1 = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаИз, ДатаКурса);
	КурсВалюты2 = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаВ, ДатаКурса);
	//Результат =  РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Сумма, КурсВалюты1, КурсВалюты2);
	//ДИТ, Беляев СЮ, BUG 76518 / TA 76823, 03-11-2023, начало
	Результат =  РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Сумма, КурсВалюты1, КурсВалюты2, ,ОкруглениеКурса);
	//ДИТ, Беляев СЮ, BUG 76518 / TA 76823, 03-11-2023, конец
	
	Возврат Результат;
	
КонецФункции

//ДИТ, Беляев СЮ, US 83120/TA 83233, 01-04-2024, начало
Функция ПолучитьМассивОсновныхВалют() Экспорт
	СпособыУстановкиКурса = Новый Массив;
	СпособыУстановкиКурса.Добавить(Перечисления.СпособыУстановкиКурсаВалюты.ЗагрузкаИзИнтернета);
	СпособыУстановкиКурса.Добавить(Перечисления.СпособыУстановкиКурсаВалюты.РучнойВвод);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Валюты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Валюты КАК Валюты
		|ГДЕ
		|	Валюты.СпособУстановкиКурса В(&СпособыУстановкиКурса)";
	
	Запрос.УстановитьПараметр("СпособыУстановкиКурса", СпособыУстановкиКурса);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");	
КонецФункции
//ДИТ, Беляев СЮ, US 83120/TA 83233, 01-04-2024, конец

// Евросиб US 90342 TA 124063 Рыбьяков К.А. 29.11.2025 (( 
//перенес из формы псц чтобы вызывать еще из другого места
Функция ПолучитьВалюту(НаименВалюты) Экспорт
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Валюты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Валюты КАК Валюты
	|ГДЕ
	|	Валюты.Наименование ПОДОБНО &Наименование";
	Запрос.УстановитьПараметр("Наименование", НаименВалюты);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции