		НовСтр = ОперацииДляИзменения.Добавить();
		НовСтр.Операция = Стр.Операция;
		НовСтр.ДатаНазначенияФакт = ДатаОтпр;
		
	КонецЦикла;
	
	// проверяем, что у следующей операции есть признак ОтмечатьНачалоКакФактОкончанияПредыдущей.
	// если у следующей операции дата отправления равна дате назначения текущей операции, то такие 
	// записи не выбирать, чтобы не перезаписывать операцию
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТехнологическаяСхемаТЧ.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ ВТ
	               |ИЗ
	               |	Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
	               |ГДЕ
	               |	ТехнологическаяСхемаТЧ.Операция = &Операция
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТехнологическаяСхемаТЧ.Операция.Ссылка КАК Операция
	               |ИЗ
	               |	ВТ КАК ВТ
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
	               |		ПО ВТ.Ссылка = ТехнологическаяСхемаТЧ.Ссылка
	               |ГДЕ
	               |	ТехнологическаяСхемаТЧ.ГУИД В(&ГУИД)
	               |	И ТехнологическаяСхемаТЧ.Операция.Услуга.ОтмечатьНачалоКакФактОкончанияПредыдущей
	               |	И НЕ ТехнологическаяСхемаТЧ.Операция.ДатаОтправленияФакт = &ДатаОтправленияФакт";
	Запрос.УстановитьПараметр("Операция",Операция.Ссылка);
	Запрос.УстановитьПараметр("ДатаОтправленияФакт",ДатаНазн);
	Запрос.УстановитьПараметр("ГУИД",МассивГУИДПодчиненных);
	ТЗ2 = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Стр Из ТЗ2 Цикл
		
		НовСтр = ОперацииДляИзменения.Добавить();
		НовСтр.Операция = Стр.Операция;
		НовСтр.ДатаОтправленияФакт = ДатаНазн;
		
	КонецЦикла;
	
	
	Возврат ОперацииДляИзменения;
	
	
КонецФункции

Функция ЕстьГруженыеКТК(Операция)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОперацияГрузы.ТЕ КАК ТЕ
	               |ИЗ
	               |	Документ.Операция.Грузы КАК ОперацияГрузы
	               |ГДЕ
	               |	НЕ ОперацияГрузы.ТЕ = ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
	               |	И ОперацияГрузы.ГруженоеТЕ
	               |	И ОперацияГрузы.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",Операция.Ссылка);
	РЗ = Запрос.Выполнить();
	
	ЕстьГруженые = НЕ РЗ.Пустой();
		
	Возврат ЕстьГруженые;
	
КонецФункции