	КонецЕсли;
		
	// 8. если изменилась операция с признаком ОтмечатьОкончаниеКакФактНачалаПоследующей
	// то нужно проверить операцию после нее и проставить для текущей операции дату окончанию из даты начала следующей	
	Если Операция.Услуга.ОтмечатьОкончаниеКакФактНачалаПоследующей Тогда
		
		МассивГУИДПодчиненных = РаботаСМаршрутизациейДокументов.ПолучитьМассивРодителей(Операция.Ссылка,Ложь,1);
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ТехнологическаяСхемаТЧ.Ссылка КАК Ссылка
		               |ПОМЕСТИТЬ ВТ
		               |ИЗ
		               |	Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
		               |ГДЕ
		               |	ТехнологическаяСхемаТЧ.Операция = &Операция
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ТехнологическаяСхемаТЧ.Операция.Ссылка КАК Операция,
		               |	ТехнологическаяСхемаТЧ.Операция.ДатаНазначенияФакт КАК ДатаОтправленияФакт
		               |ИЗ
		               |	ВТ КАК ВТ
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
		               |		ПО ВТ.Ссылка = ТехнологическаяСхемаТЧ.Ссылка
		               |ГДЕ
		               |	ТехнологическаяСхемаТЧ.ГУИД В(&ГУИД)
		               |	И НЕ ТехнологическаяСхемаТЧ.Операция.ДатаОтправленияФакт = &ДатаОтправленияФакт";
		Запрос.УстановитьПараметр("Операция",Операция.Ссылка);
