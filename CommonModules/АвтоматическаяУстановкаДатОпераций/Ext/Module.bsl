	// проверяем, что у предыдущей операции есть признак ОтмечатьОкончаниеКакФактНачалаПоследующей.
	// если у предыдущей операции дата назначения равна дате отправления текущей операции, то такие 
	// записи не выбирать, чтобы не перезаписывать операцию
	Запрос = Новый Запрос;
