	Если Операция.Услуга.КомплекснаяУслугаПоТерминaльнойОбработке Тогда
		
		// 6.1. то нужно проверить операции с признаком КрановыеОперации ИЛИ ХранениеНаТерминалеГруженогоКонтейнера вокруг нее	
		
		// проверяем, что операция - КрановыеОперации ИЛИ ХранениеНаТерминалеГруженогоКонтейнера и проставляем 
		// дату назначения в нее по дате отправления КомплекснаяУслугаПоТерминaльнойОбработке
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ТехнологическаяСхемаТЧ.Ссылка КАК Ссылка
		               |ПОМЕСТИТЬ ВТ
		               |ИЗ
		               |	Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
		               |ГДЕ
		               |	ТехнологическаяСхемаТЧ.Операция = &Операция
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ТехнологическаяСхемаТЧ.Операция.Ссылка КАК Операция,
		               |	ТехнологическаяСхемаТЧ.Операция.ДатаОтправленияФакт КАК ДатаОтправленияФакт
		               |ИЗ
		               |	ВТ КАК ВТ
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
		               |		ПО ВТ.Ссылка = ТехнологическаяСхемаТЧ.Ссылка
		               |ГДЕ
		               |	(ТехнологическаяСхемаТЧ.Операция.Услуга.КрановыеОперации
		               |			ИЛИ ТехнологическаяСхемаТЧ.Операция.Услуга.ХранениеНаТерминалеГруженогоКонтейнера)
		               |	И НЕ ТехнологическаяСхемаТЧ.Операция.ДатаОтправленияФакт = &ДатаОтправленияФакт";
		Запрос.УстановитьПараметр("Операция",Операция.Ссылка);
