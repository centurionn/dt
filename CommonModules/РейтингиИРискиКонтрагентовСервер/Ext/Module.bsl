Функция ПолучитьЗначениеИзМакета(НомерСтроки, НомерКолонки) Экспорт
	
	Макет = ПолучитьОбщийМакет("МакетЗначенийРисковДляПолитикиКлиентов");
	ЗначениеПоля = Макет.Область("R"+НомерСтроки+"C"+НомерКолонки).Текст;
	Результат = 0;
	Попытка
		Результат = Число(ЗначениеПоля);
	Исключение
	КонецПопытки;
	Возврат Результат;
	
КонецФункции
