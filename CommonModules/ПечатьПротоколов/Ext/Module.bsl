
Процедура ВывестиЗаголовокПунктаПСЦ(ТабличныйДокумент, ОбластьПроверки, ОбластьПодвал, НомерСтроки, ВсегоПунктов) Экспорт
	
	//Проверяем последний пункт, если он помещается вместе с подвалом, то выводим его, иначе выводим разделитель
	Если НомерСтроки = ВсегоПунктов Тогда 
		СтрокаСПодвалом = Новый Массив;
		СтрокаСПодвалом.Добавить(ОбластьПроверки);
		СтрокаСПодвалом.Добавить(ОбластьПодвал);
		РезультатПроверкиВывода = ПечатьБухгалтерскихДокументов.ПроверитьВыводТабличногоДокумента(ТабличныйДокумент, СтрокаСПодвалом);
		
		Если Не РезультатПроверкиВывода Тогда 
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(ОбластьПроверки);	
	
КонецПроцедуры

Функция НапечататьНотисВРП_Рефы_ММ(Протоколы, ДопПараметры = Неопределено, ЭтоНотисВРП_Рефы = Истина) Экспорт
	
	Результат = Новый ТабличныйДокумент;
	Результат.АвтоМасштаб = Истина;
	
	// Евросиб US 90342 Рыбьяков К.А. 02.03.2026 ((
	ПечатьСпецСтавок = Ложь;
	ДокументСпецСтавкиСсылка = Неопределено;
	Если ДопПараметры <> Неопределено И ДопПараметры.Свойство("СпецСтавки") Тогда
		ПечатьСпецСтавок = Истина;
		ДокументСпецСтавкиСсылка = ДопПараметры.СпецСтавки;
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 02.03.2026 ))
	
	Первый = Истина;
	Для каждого Протокол из Протоколы Цикл
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ПСЦ.ПФ_MXL_Нотис", Протокол.Контрагент, Протокол.Договор);
		
		Если НЕ Первый Тогда Результат.ВывестиГоризонтальныйРазделительСтраниц(); КонецЕсли;
		
		Если ЭтоНотисВРП_Рефы Тогда
			ОбластьШапка = Макет.ПолучитьОбласть("ШапкаНотисВРПРефы");
			ДатаПротокола = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Протокол, "ДатаПСЦ"); 
			ДатаПротоколаСтрока = Формат(ДатаПротокола, "ДФ=dd.MM.yyyy") + "г.";
			ОбластьШапка.Параметры.ДатаПротокола = ДатаПротоколаСтрока;
		Иначе
			ОбластьШапка = Макет.ПолучитьОбласть("ШапкаНотисММ");
		КонецЕсли;
		Результат.Вывести(ОбластьШапка);
	
		ОбластьРаздел = Макет.ПолучитьОбласть("Раздел");
		ОбластьРазделБезОтступа = Макет.ПолучитьОбласть("РазделБезОтступа");
		
		// Евросиб US 90342 Рыбьяков К.А. 02.03.2026 ((
		Запрос = Новый Запрос;
		
		Если ПечатьСпецСтавок Тогда
			
			ТекстЗапроса = ТекстЗапросаПунктовПечатиСпецСтавок();
			Запрос.Текст = ТекстЗапроса
			
		Иначе
			
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ПСЦПунктыПСЦ.Ссылка КАК Ссылка,
			|	ПСЦПунктыПСЦ.НомерСтроки КАК НомерСтроки,
			|	ПСЦПунктыПСЦ.Заголовок КАК Заголовок,
			|	ПСЦПунктыПСЦ.НомерПункта КАК НомерПункта,
			|	ПСЦПунктыПСЦ.ТекстПунктаРус КАК ТекстПунктаРус,
			|	ПСЦПунктыПСЦ.ТекстПунктаАнгл КАК ТекстПунктаАнгл,
			|	ПСЦПунктыПСЦ.Отредактировано КАК Отредактировано,
			|	ПСЦПунктыПСЦ.ПроверяющийИзменениеДанногоПункта КАК ПроверяющийИзменениеДанногоПункта,
			|	ПСЦПунктыПСЦ.Предопределенный КАК Предопределенный,
			|	ПСЦПунктыПСЦ.ПередТаблицей КАК ПередТаблицей,
			|	ПСЦПунктыПСЦ.ВложенныйСписок КАК ВложенныйСписок,
			|	ПСЦПунктыПСЦ.ЭтоТаблица КАК ЭтоТаблица,
			|	ПСЦПунктыПСЦ.ЭлементПечатнойФормы КАК ЭлементПечатнойФормы,
			|	ПСЦПунктыПСЦ.Отступ КАК Отступ,
			|	ПСЦПунктыПСЦ.Макет КАК Макет
			|ИЗ
			|	Документ.ПСЦ.ПунктыПСЦ КАК ПСЦПунктыПСЦ
			|ГДЕ
			|	ПСЦПунктыПСЦ.Ссылка = &Ссылка
			|
			|УПОРЯДОЧИТЬ ПО
			|	НомерСтроки";
			
		КонецЕсли;
		// Евросиб Рыбьяков К.А. 02.03.2026 ))	
		
		// Евросиб US 90342 Рыбьяков К.А. 02.03.2026 ((
		Если ПечатьСпецСтавок Тогда
			Запрос.УстановитьПараметр("Ссылка", ДокументСпецСтавкиСсылка);
		Иначе
			Запрос.УстановитьПараметр("Ссылка", Протокол);
		КонецЕсли;
		//Запрос.УстановитьПараметр("Ссылка", Протокол);
		// Евросиб Рыбьяков К.А. 02.03.2026 ))
		
		Пункты = Запрос.Выполнить().Выгрузить();
		КоличествоПунктов = Пункты.Количество();
		ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
		
		Для ИндексСтроки = 0 По КоличествоПунктов - 1 Цикл
			Пункт = Пункты[ИндексСтроки];
			Если Пункт.ЭлементПечатнойФормы = Справочники.ЭлементыПечатнойФормыПротокола.ТаблицаДоговорнаяЦена Тогда
				Если ЭтоНотисВРП_Рефы Тогда
					ВывестиТаблицуНотисВРПРефы(Результат, Макет, Протокол, Пункт.ЭлементПечатнойФормы);
			//Евросиб Коханенко Н.А. 12.02.2025 (( #102614 
			//	Иначе
			//		ВывестиТаблицуНотисММ(Результат, Макет, Протокол, Пункт.ЭлементПечатнойФормы);
				КонецЕсли;
			ИначеЕсли (Пункт.ЭлементПечатнойФормы = Справочники.ЭлементыПечатнойФормыПротокола.ТаблицаДоговорнаяЦенаCOC)
					ИЛИ (Пункт.ЭлементПечатнойФормы = Справочники.ЭлементыПечатнойФормыПротокола.ТаблицаДоговорнаяЦенаSOC) Тогда
				// Евросиб US 90342 Рыбьяков К.А. 16.12.2025 ((
				Если ПечатьСпецСтавок Тогда
					ВывестиТаблицуНотисММ(Результат, Макет, Протокол, Пункт.ЭлементПечатнойФормы, ПечатьСпецСтавок);
				// Евросиб Рыбьяков К.А. 16.12.2025 ))
				Иначе
					ВывестиТаблицуНотисММ(Результат, Макет, Протокол, Пункт.ЭлементПечатнойФормы);
				КонецЕсли;
			//Евросиб Коханенко Н.А. 12.02.2025 )) #102614 
			//Евросиб Коханенко Н.А. 28.03.2025 (( #105938 
			ИначеЕсли Пункт.ЭлементПечатнойФормы = Справочники.ЭлементыПечатнойФормыПротокола.ШапкаНотисаММ Тогда
				Результат.ВывестиГоризонтальныйРазделительСтраниц();
				ОбластьШапка = Макет.ПолучитьОбласть("ШапкаНотисММ");
				Результат.Вывести(ОбластьШапка);
			//Евросиб Коханенко Н.А. 28.03.2025 )) #105938 
			ИначеЕсли Пункт.ЭлементПечатнойФормы = Справочники.ЭлементыПечатнойФормыПротокола.ТаблицаДоговорнаяЦенаЖД
					И НЕ ЭтоНотисВРП_Рефы Тогда
				ВывестиТаблицуНотисММ(Результат, Макет, Протокол, Пункт.ЭлементПечатнойФормы);				
			ИначеЕсли Пункт.ЭлементПечатнойФормы = Справочники.ЭлементыПечатнойФормыПротокола.ТаблицаКонтактныеДанные Тогда
				ВывестиТаблицуКонтактныеДанные(Результат, Макет, Протокол);	
			Иначе
				ОбластьРаздел.Область().Отступ = Пункт.Отступ;
				ОбластьРазделБезОтступа.Область().Отступ = Пункт.Отступ;
				ТекстПункта = Документы.ПСЦ.ОтработатьШаблоны(Протокол, Пункт.ТекстПунктаРус);
				НомерПункта = СокрЛП(Пункт.НомерПункта);
				Если ЗначениеЗаполнено(НомерПункта) Тогда
					Если СтрНайти(НомерПункта, ".") = 0 Тогда
						НомерПункта = НомерПункта + ".";
					КонецЕсли;					                                      
				КонецЕсли;
				МассивСтрок = СтрРазделить(ТекстПункта,Символы.ПС);
				ПерваяСтрока = Истина;
				Для каждого Строка из МассивСтрок Цикл
					Если ПерваяСтрока Тогда							
						Строка = НомерПункта +" "+ Строка;
						ПерваяСтрока = Ложь;
						ОбластьРаздел.Параметры.Текст = Строка;
						ВывестиЗаголовокПунктаПСЦ(Результат, ОбластьРаздел, ОбластьПодвал, ИндексСтроки, КоличествоПунктов - 2);
					Иначе
						ОбластьРазделБезОтступа.Параметры.Текст = Строка;
						ВывестиЗаголовокПунктаПСЦ(Результат, ОбластьРазделБезОтступа, ОбластьПодвал, ИндексСтроки, КоличествоПунктов - 2);
					КонецЕсли;					
				КонецЦикла;
			КонецЕсли; 
			
			ВывестиТаблицуИзХранилища(Результат, Пункт.Макет);
						
		КонецЦикла;

		Результат.Присоединить(ОбластьПодвал);
				
	КонецЦикла;
	
	Возврат Результат;

КонецФункции //Евросиб Коханенко Н.А. 22.10.2024 )) #92915

