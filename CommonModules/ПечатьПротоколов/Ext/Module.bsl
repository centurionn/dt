Процедура ВывестиТаблицуКонтактныеДанные(ТабДок, Макет, Протокол) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПСЦКонтактныеДанные.Должность КАК Должность,
		|	ПСЦКонтактныеДанные.Ответственный КАК Ответственный,
		|	ПользователиКонтактнаяИнформацияАдресЭП.АдресЭП КАК АдресЭП,
		|	ПользователиКонтактнаяИнформацияНомерТелефона.Представление КАК Телефон
		|ИЗ
		|	Документ.ПСЦ.КонтактныеДанные КАК ПСЦКонтактныеДанные
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформацияАдресЭП
		|		ПО ПСЦКонтактныеДанные.Ответственный = ПользователиКонтактнаяИнформацияАдресЭП.Ссылка
		|			И (ПользователиКонтактнаяИнформацияАдресЭП.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты))
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформацияНомерТелефона
		|		ПО ПСЦКонтактныеДанные.Ответственный = ПользователиКонтактнаяИнформацияНомерТелефона.Ссылка
		|			И (ПользователиКонтактнаяИнформацияНомерТелефона.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
		|			И (ПользователиКонтактнаяИнформацияНомерТелефона.НомерСтроки = 2)
		|ГДЕ
		|	ПСЦКонтактныеДанные.Ссылка = &ПСЦСсылка";
	
	Запрос.УстановитьПараметр("ПСЦСсылка", Протокол.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("СтрокаДолжностиКонтактныхДанных");
		ОбластьШапкаТаблицы.Параметры.Должность = Выборка.Должность;
		ОбластьСтрокаТаблицы = Макет.ПолучитьОбласть("СтрокаКонтактныхДанных");
		ЗаполнитьЗначенияСвойств(ОбластьСтрокаТаблицы.Параметры, Выборка);
		ТабДок.Присоединить(ОбластьШапкаТаблицы);
		ТабДок.Присоединить(ОбластьСтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры //Евросиб Коханенко Н.А. 17.10.2024 )) #92915

