
Процедура СозданиеСделок() Экспорт
	
	СозданиеСделокПоПлановомуОтправлениюРейса();
	
КонецПроцедуры

Процедура СозданиеСделокПоПлановомуОтправлениюРейса() Экспорт
	
	// рейсы не должны быть в сделках!
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РейсыЖД.Ссылка КАК Ссылка,
		|	РейсыЖД.ПунктОтправления КАК ПунктОтправления,
		|	РейсыЖД.ПунктНазначения КАК ПунктНазначения,
		|	РейсыЖД.ДатаОтправления КАК ДатаОтправления,
		|	РейсыЖД.ДатаПрибытия КАК ДатаПрибытия,
		|	ЗаявкаПереченьРейсов.Ссылка КАК Заявка
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РейсыЖД КАК РейсыЖД
		|		ПО ЗаявкаПереченьРейсов.Рейс = РейсыЖД.Ссылка
		|ГДЕ
		|	РейсыЖД.ДатаОтправления МЕЖДУ &ДатаНач И &ДатаКон
		|	И НЕ РейсыЖД.РейсОтменен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Ссылка КАК Ссылка,
		|	ВТ.ПунктОтправления КАК ПунктОтправления,
		|	ВТ.ПунктНазначения КАК ПунктНазначения,
		|	ВТ.ДатаОтправления КАК ДатаОтправления,
		|	ВТ.ДатаПрибытия КАК ДатаПрибытия,
		|	ВТ.Заявка КАК Заявка,
		|	СделкаРейсы.Ссылка КАК Сделка
		|ПОМЕСТИТЬ Итоговая
		|ИЗ
		|	ВТ КАК ВТ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.Рейсы КАК СделкаРейсы
		|		ПО ВТ.Ссылка = СделкаРейсы.Рейс
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Итоговая.Ссылка КАК Ссылка,
		|	Итоговая.ПунктОтправления КАК ПунктОтправления,
		|	Итоговая.ПунктНазначения КАК ПунктНазначения,
		|	Итоговая.ДатаОтправления КАК ДатаОтправления,
		|	Итоговая.ДатаПрибытия КАК ДатаПрибытия,
		|	Итоговая.Заявка КАК Заявка,
		|	Итоговая.Сделка КАК Сделка
		|ИЗ
		|	Итоговая КАК Итоговая
		|ГДЕ
		|	ЕСТЬNULL(Итоговая.Сделка, 0) = 0
		|ИТОГИ ПО
		|	Ссылка";
	
	Запрос.УстановитьПараметр("ДатаНач",ТекущаяДата()-1*3600*24);
	Запрос.УстановитьПараметр("ДатаКон",ТекущаяДата()+2*3600*24);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаСсылка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСсылка.Следующий() Цикл

		///////////// Создать СДЕЛКУ ///////////////////
		НоваяСделка = Документы.Сделка.СоздатьДокумент();
		
		НоваяСделка.Дата = ТекущаяДата();
		НоваяСделка.Автор = Пользователи.ТекущийПользователь();
		//НоваяСделка.ЦФО = НоваяСделка.Автор.ЦФО;
		НоваяСделка.Создано = ТекущаяДата();
		//НоваяСделка.Организация = Константы.ОсновнаяОрганизация.Получить();
		НоваяСделка.Маршрутизировать = Константы.МаршрутизироватьСделку.Получить();
		НоваяСделка.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
		
		НоваяСделка.ЖДОтправка = ВыборкаСсылка.Ссылка.ПунктОтправления;
		НоваяСделка.ЖДПрибытие = ВыборкаСсылка.Ссылка.ПунктНазначения;
		НоваяСделка.ПерваяОперация = ВыборкаСсылка.Ссылка.ДатаОтправления;
		НоваяСделка.ПоследняяОперация = ВыборкаСсылка.Ссылка.ДатаПрибытия;
		НоваяСделка.СтанцияОтправления = ВыборкаСсылка.Ссылка.ПунктОтправления;
		НоваяСделка.СтанцияНазначения = ВыборкаСсылка.Ссылка.ПунктНазначения;
		
		// добавить рейс в сделку
		ТЧРейсы = НоваяСделка.Рейсы.Добавить();
		ТЧРейсы.Рейс = ВыборкаСсылка.Ссылка;
		

		ВыборкаДетальныеЗаписи = ВыборкаСсылка.Выбрать();
	
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			НоваяСделка.Организация = ВыборкаДетальныеЗаписи.Заявка.Организация;
			НоваяСделка.Подразделение = ВыборкаДетальныеЗаписи.Заявка.Подразделение;
			//Евросиб - АСуслов 07.01.2021 13:37:59 #0213891 
			//(
			//НоваяСделка.ЦФО = ВыборкаДетальныеЗаписи.Заявка.ЦФО;
			НоваяСделка.ЦФО = Справочники.ЦентрыФинансовойОтветственности.ОсновнойЦФО;
			//)
			//Евросиб - АСуслов 07.01.2021 13:38:00 #0213891 
			/////////////////////////////////////////////////
			
			// добавляем заявку и калькуляцию
			ТЧЗаявки = НоваяСделка.Заявки.Добавить();
			ТЧЗаявки.Заявка = ВыборкаДетальныеЗаписи.Заявка;
			Если ВыборкаДетальныеЗаписи.Заявка.СоставУслуги.Количество()>0 Тогда
				ТЧЗаявки.Калькуляция = ВыборкаДетальныеЗаписи.Заявка.СоставУслуги[0].Калькуляция;
				НоваяСделка.ТипЗаказа = ТЧЗаявки.Калькуляция.ТипЗаказа;
			Иначе
				НоваяСделка.ТипЗаказа = ?(ВыборкаДетальныеЗаписи.КП,Справочники.ТипыЗаказов.КонтейнерныйПоезд,Справочники.ТипыЗаказов.Прочее);
			КонецЕсли;
			
			// заполнить ТЧ СвязьУчетныхЕдиниц
			Для каждого Стр2 из ВыборкаДетальныеЗаписи.Заявка.СоставУслуги Цикл
				Если ЗначениеЗаполнено(Стр2.НомерКТК) ИЛИ ЗначениеЗаполнено(Стр2.Вагон) Тогда
					НСтр = НоваяСделка.СвязьУчетныхЕдиниц.Добавить();
					НСтр.Заявка = ВыборкаДетальныеЗаписи.Заявка;
					НСтр.Контейнер = Стр2.НомерКТК;
					НСтр.Клиент = ВыборкаДетальныеЗаписи.Заявка.Контрагент;
					НСтр.Договор = ВыборкаДетальныеЗаписи.Заявка.Договор;
					НСтр.Груз = Стр2.Груз;
					НСтр.УсловияПеревозки = Стр2.УсловияПеревозки;
					НСтр.УсловияПеревозкиНазначение = Стр2.УсловияПеревозкиНазначение;
					НСтр.Калькуляция = Стр2.Калькуляция;
					НСтр.РазмерКТК = Стр2.РазмерКТК;
					Если ЗначениеЗаполнено(Стр2.Калькуляция) тогда
						НСтр.Калькуляция = Стр2.Калькуляция;
					КонецЕсли;
					НСтр.Вагон = Стр2.Вагон;
					
					// Евросиб Фролов (26.12.2021 TASK №44663
					НСтр.ГУИДСтрокиЗаявки = Стр2.ГУИДСтроки;
					// Евросиб Фролов)
					
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
		
		НоваяСделка.ФоновоеСоздание = Истина;
		
		НоваяСделка.Записать(РежимЗаписиДокумента.Запись);
		
		СохраненннаяСделкаОбъект = НоваяСделка.Ссылка.ПолучитьОбъект();
		доходы_ЗаполнитьПоЗаявкам2(СохраненннаяСделкаОбъект);

		Попытка
			СохраненннаяСделкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			СохраненннаяСделкаОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецПопытки;
		
		
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СозданиеСделокПоРейсам(ТекРейс) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РейсыЖД.Ссылка КАК Ссылка,
		|	РейсыЖД.ПунктОтправления КАК ПунктОтправления,
		|	РейсыЖД.ПунктНазначения КАК ПунктНазначения,
		|	РейсыЖД.ДатаОтправления КАК ДатаОтправления,
		|	РейсыЖД.ДатаПрибытия КАК ДатаПрибытия,
		|	ЗаявкаПереченьРейсов.Ссылка КАК Заявка
		|ИЗ
		|	Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РейсыЖД КАК РейсыЖД
		|		ПО ЗаявкаПереченьРейсов.Рейс = РейсыЖД.Ссылка
		|ГДЕ
		|	РейсыЖД.Ссылка = &Ссылка
		|ИТОГИ ПО
		|	Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка",ТекРейс);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаСсылка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСсылка.Следующий() Цикл

		///////////// Создать СДЕЛКУ ///////////////////
