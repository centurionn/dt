	Если СписокРеквизитовДляСравнения = "" Тогда
		СписокРеквизитовДляСравнения = ПолучитьСписокРеквизитовДляСравнения(Объект);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЗначенияРеквизитовКалькуляцииСсылка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Ссылка, СписокРеквизитовДляСравнения);
		ЗначенияРеквизитовКалькуляцииОбъект = Новый Структура(СписокРеквизитовДляСравнения);
		ЗаполнитьЗначенияСвойств(ЗначенияРеквизитовКалькуляцииОбъект, Объект)
	КонецЕсли;
	ДляДанногоОбъектаТребуетсяПеремаршрутизация = Не ЗначениеЗаполнено(Объект.Ссылка) 
									ИЛИ Не ОбщегоНазначения.КоллекцииИдентичны(ЗначенияРеквизитовКалькуляцииОбъект, ЗначенияРеквизитовКалькуляцииСсылка)
									ИЛИ Объект.Состояния.Количество() = 0;
	Возврат ДляДанногоОбъектаТребуетсяПеремаршрутизация;									
КонецФункции

Функция ПолучитьСписокРеквизитовДляСравнения(Объект)
	СписокРеквизитовДляСравнения = "";
	Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.Заявка") Тогда
		
		СписокРеквизитовДляСравнения = "Организация, Контрагент, ВидПеревозки, Договор, ИсточникЗаявки,
										|НаМоментЗаписиБылаЗадолженность, ЗапросНаКТК, Отправка, ВидПеревозки";

		// Евросиб Фролов (22.02.2022 Task №47608
		// Исключить из перечня ключевых поле "Отправка" из шапки Заявки (только для запроса на КТК).
		Если Объект.ЗапросНаКТК Тогда
			СписокРеквизитовДляСравнения = СтрЗаменить(СписокРеквизитовДляСравнения, ", Отправка" ,"");
		КонецЕсли;	
		// Евросиб Фролов)
		
	ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ПСЦ") Тогда
		
		СписокРеквизитовДляСравнения = "Организация, Контрагент, ВидПеревозки, Валюта, СогласованоВDV,
							   |ВидПСЦ, СодержитВР, ПротоколНаДоплатныеКТК, НетиповойПротокол,
							   |ЦФО, КатегорияУслуг, МестоОказанияУслуг, Договор, ТипКалькуляции";
		
	//Евросиб Каблов 20.05.2024 ( #67092
	ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ПСЦПоставщика") Тогда
		
		СписокРеквизитовДляСравнения = "Организация, Контрагент, ВидПеревозки, Валюта, СогласованоВDV,
							   |ВидПСЦ, СодержитВР, ПротоколНаДоплатныеКТК, НетиповойПротокол,
							   |ЦФО, КатегорияУслуг, МестоОказанияУслуг, Договор, ТипКалькуляции";
	//Евросиб Каблов 20.05.2024 )
		
	ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.Калькуляция") Тогда
		
		СписокРеквизитовДляСравнения = "Организация, Контрагент, Договор, ПС_ВидПеревозки,
											|ММ_ИтогоРентабельность, ММ_ИтогоРентабельность20,
											|ЖД_ПринадлежностьПС, ТипКалькуляции";
		
	ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		
		//Евросиб Каблов 12.08.2022 ( Task 55578
		//СписокРеквизитовДляСравнения = "Организация, Штраф, Претензия, ЦФО, Контрагент, ДоговорКонтрагента";
		СписокРеквизитовДляСравнения = "Организация, Штраф, Претензия, ЦФО, Контрагент, ДоговорКонтрагента, ВидУслуг";
		//Евросиб Каблов 12.08.2022 )
		
	//Евросиб Каблов 12.08.2022 ( Task 55578
	ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.КорректировкаПоступления") Тогда
		
		СписокРеквизитовДляСравнения = "Организация, Контрагент, ДоговорКонтрагента, Штраф, ВидУслуг";
	//Евросиб Каблов 12.08.2022 )
		
	// ++ ДИТ_Агафонов_task 50388 06.07.2022
	ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.РелизСобственника") Тогда
		
		СписокРеквизитовДляСравнения = "Организация, ЦФО, Контрагент, Договор";
	// -- ДИТ_Агафонов_task 50388 06.07.2022
	КонецЕсли;
	Возврат СписокРеквизитовДляСравнения;
КонецФункции

