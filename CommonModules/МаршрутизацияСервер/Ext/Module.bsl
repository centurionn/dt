Процедура УстановитьСтатусыЗадачПоОснованию(Объект, Основание) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СостоянияОбъекта.Состояние КАК Состояние,
	|	СостоянияОбъекта.Статус КАК Статус
	|ИЗ
	|	Документ.Заявка.Состояния КАК СостоянияОбъекта
	|ГДЕ
	|	СостоянияОбъекта.Ссылка = &Ссылка
	|	И СостоянияОбъекта.Состояние.ОтмечатьВыполнениеВРодительскомДокументеАвтоматически
	|	И СостоянияОбъекта.Состояние <> &СостояниеВводЗаявкиВыборРейса";
	
	ПолноеИмяОбъекта = Объект.Метаданные().ПолноеИмя();
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Заявка", ПолноеИмяОбъекта);
	
	Запрос.УстановитьПараметр("Ссылка", Основание);
	Запрос.УстановитьПараметр("СостояниеВводЗаявкиВыборРейса", Справочники.Состояния.ВводЗаявкиВыборРейса);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтрокаСостояния = Объект.Состояния.Найти(Выборка.Состояние, "Состояние");
		Если СтрокаСостояния <> Неопределено Тогда
			СтрокаСостояния.Статус = Выборка.Статус;
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

