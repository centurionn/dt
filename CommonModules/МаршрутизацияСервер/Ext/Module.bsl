// Евросиб(ДИТ) US 84968 ТА 85632 Сержантова А.С. 12.09.2024   
//ДокументСсылка - Ссылка на Заявку или Сделку, куда добавляется задача
//УдаленныеРейсы - Массив с морскими рейсами, помеченными на удаление (планируемая дата отправления больше текущей даты)
Процедура СформироватьЗадачуОбработкиУдаленияМорскогоРейса(ДокументСсылка, Состояния, Автор, УдаленныеРейсы) Экспорт
	
	СтрокаСостояния = Состояния.НайтиСтроки(Новый Структура("Состояние", Справочники.Состояния.УдаленМорскойРейс));
	Если СтрокаСостояния.Количество() <> 0 Тогда
		НС = СтрокаСостояния[0];
	Иначе
		НС = Состояния.Добавить();	
	КонецЕсли;
	
	НС.Исполнитель = Автор;
	Если Состояния.Количество() Тогда
		НС.Наблюдатель = Автор;
	КонецЕсли;
	НС.Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
	НС.Состояние = Справочники.Состояния.УдаленМорскойРейс;     
	Если УдаленныеРейсы.Количество() = 1 Тогда
		ТекстКомментария = СтрШаблон("Выбранный в документе %1 морской рейс %2 помечен на удаление. Выберите другой актуальный рейс.",
						ДокументСсылка, УдаленныеРейсы[0]);
	Иначе
		ТекстКомментария = СтрШаблон("Выбранные в документе %1 морские рейсы (%2) помечены на удаление. Выберите другие актуальные рейсы.",
						ДокументСсылка, СтрСоединить(УдаленныеРейсы));
	КонецЕсли;
	НС.Комментарий = ТекстКомментария;  
	НС.НачалоРаботы = ТекущаяДата(); 
	
КонецПроцедуры

