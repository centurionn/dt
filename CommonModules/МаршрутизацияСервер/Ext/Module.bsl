	Если ЗначениеЗаполнено(СсылкаОбъектМаршрутизации) Тогда //Евросиб Гудкова( 26.10.2020 Ticket№ 
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ПротоколОбменов.ДействиеПриОбмене КАК ДействиеПриОбмене,
		               |	ПротоколОбменов.УзелОбмена КАК УзелОбмена,
		               |	ПротоколОбменов.Объект КАК Объект,
		               |	ПротоколОбменов.УИДИсточника КАК УИДИсточника,
		               |	ПротоколОбменов.ПроведенВБУ КАК ПроведенВБУ,
		               |	ПротоколОбменов.Ответственный КАК Ответственный,
		               |	ПротоколОбменов.ДатаОбмена КАК ДатаОбмена,
		               |	ПротоколОбменов.НомерДатаВБУ КАК НомерДатаВБУ
		               |ИЗ
		               |	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
		               |ГДЕ
		               |	ПротоколОбменов.Объект = &Объект
			           |	И ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.РИТМ)
		               |	И ПротоколОбменов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных)";
		Запрос.УстановитьПараметр("Объект", СсылкаОбъектМаршрутизации);
		Ответ = Запрос.Выполнить().Выбрать();
		Если Ответ.Следующий() Тогда
			ЗагруженИзРИТМ = Истина; //Гудкова Ticket#0203030 ЗагруженИзРИТМ ИЛИ Ответ.УзелОбмена = Перечисления.УзлыОбмена.РИТМ;
		КонецЕсли;
	
		// проверяем наличие загрузки этого ПТУ из Диадока //Гудкова Ticket#0203030
		Запрос.Текст =  "ВЫБРАТЬ
		                |	Диадок_Документы.Документ КАК Документ,
		                |	Диадок_Документы.Статус КАК Статус
		                |ИЗ
		                |	Справочник.Диадок_Документы КАК Диадок_Документы
		                |ГДЕ
		                |	Диадок_Документы.Документ = &Объект";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЗагруженИзДиадок = Истина;
		КонецЕсли; 	
	КонецЕсли; // Евросиб Гудкова) 	
	
	ЗагруженИзРИТМ = ЗагруженИзРИТМ 
		ИЛИ (Не Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ПараметрыЗапроса["ОбъектМаршрутизации"])) 
			И ПараметрыЗапроса["ОбъектМаршрутизации"].ДополнительныеСвойства.Свойство("ЗагруженИзРИТМ"));
	 ЗагруженИзДиадок = ЗагруженИзДиадок 
	 	ИЛИ (Не Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ПараметрыЗапроса["ОбъектМаршрутизации"])) 
			И ПараметрыЗапроса["ОбъектМаршрутизации"].ДополнительныеСвойства.Свойство("ЗагруженИзДиадок"));
			
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Маршрутизация.Ссылка КАК Ссылка, 
				   // Евросиб(ДИТ) US 86962 ТА 87365 Сержантова А.С. Начало: 05.09.2024
				   // Было:
				   //|	Маршрутизация.Договор КАК Договор,
				   //|	Маршрутизация.Контрагент КАК Контрагент,
				   //Стало:
				   |	ЕСТЬNULL(МаршрутизацияКонтрагентыИДоговоры.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Контрагент,
				   |	ЕСТЬNULL(МаршрутизацияКонтрагентыИДоговоры.Договор, ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)) КАК Договор,
				   // Евросиб(ДИТ) US 86962 ТА 87365 Сержантова А.С. Конец: 05.09.2024
	               |	Маршрутизация.Организация КАК Организация,
	               |	Маршрутизация.ПТУРИТМ КАК ПТУРИТМ,
	               |	Маршрутизация.ЭДО КАК ПТУДиадок,
	               |	Маршрутизация.ЦФО КАК ЦФО,
	               |	Маршрутизация.ПТУШтраф КАК ПТУШтраф,
	               |	Маршрутизация.Копия КАК Копия,
	               |	Маршрутизация.Резидент КАК Резидент,
	               |	Маршрутизация.Нерезидент КАК Нерезидент,
	               |	ВЫРАЗИТЬ(&Контрагент КАК Справочник.Контрагенты).СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия) КАК КонтрагентРезидент,
				   //Евросиб Каблов 12.08.2022 ( Task 55578
				   |	Маршрутизация.ПТУВидУслуг КАК ПТУВидУслуг,
				   //Евросиб Каблов 12.08.2022 )				   
				   //Евросиб Каблов 16.08.2021 ( Ticket#0240249
	               |	Маршрутизация.ПТУСуммаОт КАК ПТУСуммаОт,
	               |	Маршрутизация.ПТУСуммаДо КАК ПТУСуммаДо
				   //Евросиб Каблов 16.08.2021 )
	               |ИЗ
	               |	Справочник.Маршрутизация КАК Маршрутизация
				   // Евросиб(ДИТ) US 86962 ТА 87365 Сержантова А.С. Начало: 05.09.2024
				   |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Маршрутизация.КонтрагентыИДоговоры КАК МаршрутизацияКонтрагентыИДоговоры
				   |		ПО (Маршрутизация.Ссылка = МаршрутизацияКонтрагентыИДоговоры.Ссылка)
				   // Евросиб(ДИТ) US 86962 ТА 87365 Сержантова А.С. Конец: 05.09.2024
	               |ГДЕ
	               |	НЕ Маршрутизация.ПометкаУдаления
	               |	И Маршрутизация.МаршрутизируемыйОбъект = ЗНАЧЕНИЕ(Перечисление.МаршрутизируемыеОбъекты.КорректировкаПоступления)
				   // Евросиб(ДИТ) US 86962 ТА 87365 Сержантова А.С. Начало: 05.09.2024
				   // Было:
				   //|	И ВЫБОР
				   //|			КОГДА Маршрутизация.КонтрагентПустой
				   //|				ТОГДА &Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
				   //|			ИНАЧЕ Маршрутизация.Контрагент = &Контрагент
				   //|					ИЛИ Маршрутизация.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
				   //|		КОНЕЦ
				   //|	И ВЫБОР
				   //|			КОГДА Маршрутизация.ДоговорПустой
				   //|				ТОГДА &Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
				   //|			ИНАЧЕ Маршрутизация.Договор = &Договор
				   //|					ИЛИ Маршрутизация.Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
				   //|		КОНЕЦ
				   //Стало:
				   |	И ВЫБОР
				   |			КОГДА Маршрутизация.КонтрагентПустой
				   |				ТОГДА &Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
				   |			ИНАЧЕ ЕСТЬNULL(МаршрутизацияКонтрагентыИДоговоры.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) = &Контрагент
				   |					ИЛИ ЕСТЬNULL(МаршрутизацияКонтрагентыИДоговоры.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
				   |		КОНЕЦ
				   |	И ВЫБОР
				   |			КОГДА Маршрутизация.ДоговорПустой
				   |				ТОГДА &Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
				   |			ИНАЧЕ ЕСТЬNULL(МаршрутизацияКонтрагентыИДоговоры.Договор, ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)) = &Договор
				   |					ИЛИ ЕСТЬNULL(МаршрутизацияКонтрагентыИДоговоры.Договор, ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
				   |		КОНЕЦ
				   // Евросиб(ДИТ) US 86962 ТА 87365 Сержантова А.С. Конец: 05.09.2024
	               |	И ВЫБОР
	               |			КОГДА Маршрутизация.ОрганизацияПустая
