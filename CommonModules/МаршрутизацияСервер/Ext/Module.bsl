Процедура ЗакрытьТекущиеЗадачиПользователя(СписокДокументов) Экспорт
	
	ТекПользователь = Пользователи.ТекущийПользователь();
	ЯЗамещаю = Пользователи_sd_сервер.ПодобратьЗамещениеОбратное(ТекПользователь, ТекущаяДата());
	МоиГруппы = Пользователи_sd_сервер.ПолучитьСписокМоихГрупп(ТекПользователь, ЯЗамещаю);
	// ДИТ Поморцева Т.П. Задача 238786 16.08.21. начало
	//МоиГруппы.Добавить(ТекПользователь);
	//МоиГруппы.Добавить(ЯЗамещаю);
	Для Каждого Элемент ИЗ ЯЗамещаю Цикл
		МоиГруппы.Добавить(Элемент);
	КонецЦикла;	
	// ДИТ Поморцева Т.П. Задача 238786 16.08.21. конец
	
	ЗакрывающиеСтатусы = Новый Массив;
	ЗакрывающиеСтатусы.Добавить(Перечисления.СтатусыЭтапов.ВРаботе);
	ЗакрывающиеСтатусы.Добавить(Перечисления.СтатусыЭтапов.НаВыполнение);
	
	Для каждого Док из СписокДокументов Цикл
		
		ДокО = Док.ПолучитьОбъект();
		ЧтоТоИзменилось = Ложь;
		
		Для каждого Стр из ДокО.Состояния Цикл
			
			Если ЗакрывающиеСтатусы.Найти(Стр.Статус) <> неопределено И МоиГруппы.Найти(Стр.Исполнитель) <> неопределено Тогда
				//Евросиб Каблов 06.02.2021 ( Ticket#0220877
				Отказ = Ложь;
				ПроверитьВозможностьВыполненияЗадачи(Док, ДокО, Стр, Отказ);
				Если Отказ Тогда
				    Продолжить;					
				КонецЕсли; 
				//Евросиб Каблов 06.02.2021 )
				Стр.Статус = Перечисления.СтатусыЭтапов.Выполнен;
				ЧтоТоИзменилось = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЧтоТоИзменилось Тогда
			//Евросиб Каблов 27.01.2021 ( Ticket#0218715
			ИзмененияЗапрещены = Ложь;
			РежимЗаписи = ?(ДокО.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
			КонтрольДоступностиДокументов_сервер.ПроверитьДоступностьПолейДляИзменения(ДокО, ИзмененияЗапрещены, РежимЗаписи, Неопределено);
			//Евросиб Каблов 27.01.2021 )
			//Евросиб Каблов 12.08.2021 ( Ticket#0236986
			УстановитьПривилегированныйРежим(Истина);
			//Евросиб Каблов 12.08.2021 )
			Попытка
				ДокО.Записать(?(ДокО.Проведен,РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
			Исключение
				//Евросиб Каблов 12.08.2021 ( Ticket#0236986
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По документу " + Док + " не удалось закрыть задачу!");
				//Евросиб Каблов 12.08.2021 )
			КонецПопытки;
			//Евросиб Каблов 12.08.2021 ( Ticket#0236986
			УстановитьПривилегированныйРежим(Ложь);
			//Евросиб Каблов 12.08.2021 )
		Иначе
			//Евросиб Каблов 06.02.2021 ( Ticket#0220877
			//Сообщить("По документу " + Док + " не удалось закрыть задачу, т.к. не найдены задачи текущего пользователя!");
			Сообщить("По документу " + Док + " не удалось закрыть задачу!");
			//Евросиб Каблов 06.02.2021 ( Ticket#0220877
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьВозможностьВыполненияЗадачи(ДокументСсылка, ДокументОбъект, СтрокаЗадачи, Отказ)

	Если СтрокаЗадачи.Состояние.ПроверитьВыгрузкуПривязанныхСчетовВУПП Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СчетНаОплатуПоставщика.Ссылка КАК Ссылка,
		|	СчетНаОплатуПоставщика.Представление КАК Представление
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг.СвязанныеСчетаПоставщиков КАК ПоступлениеТоваровУслугСвязанныеСчетаПоставщиков
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетНаОплатуПоставщика КАК СчетНаОплатуПоставщика
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
		|			ПО СчетНаОплатуПоставщика.Ссылка = ПротоколОбменов.Объект
		|				И (ПротоколОбменов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных))
		|				И (ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УППЗаказ))
		|		ПО ПоступлениеТоваровУслугСвязанныеСчетаПоставщиков.СчетПоставщика = СчетНаОплатуПоставщика.Ссылка
		|ГДЕ
		|	ПротоколОбменов.УИДИсточника ЕСТЬ NULL
		|	И ПоступлениеТоваровУслугСвязанныеСчетаПоставщиков.Ссылка = &Ссылка
		|	И НЕ ПоступлениеТоваровУслугСвязанныеСчетаПоставщиков.Ссылка.ДоговорКонтрагента.РасчетыПоДоговоруВЦелом";
		
		Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл			
			ТекстСообщения = СтрШаблон("Документ %1 не выгружен в УПП!", Выборка.Представление);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);		
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры
 

Процедура ПриУстановкеПризнакаВыставленПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	Если Источник.Выставлен Тогда
		Для каждого СтрокаСостояние Из Источник.Состояния Цикл
			Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаСостояние.Состояние, "ОтмечатьВыполнениеАвтоматическиПоВыставлению") Тогда
				СтрокаСостояние.Статус = Перечисления.СтатусыЭтапов.Выполнен;
				СтрокаСостояние.НачалоРаботы = ТекущаяДата();
				СтрокаСостояние.ЗавершениеРаботы = ТекущаяДата();
				СтрокаСостояние.Исполнитель = Пользователи.ТекущийПользователь();
			КонецЕсли; 
		КонецЦикла; 
	КонецЕсли; 
КонецПроцедуры

Функция ПолучитьИсполнителяЭтапа(Ссылка, НаименованиеСостояния) Экспорт

	Результат = Новый Структура("Ссылка, Наименование", Справочники.Пользователи.ПустаяСсылка(), "");
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаСостояний.Исполнитель КАК Ссылка,
	|	ТаблицаСостояний.Исполнитель.Наименование КАК Наименование
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Состояния КАК ТаблицаСостояний
	|ГДЕ
	|	ТаблицаСостояний.Ссылка = &Ссылка
	|	И ТаблицаСостояний.Состояние.Наименование ПОДОБНО &Состояние";
	
	ПолноеИмяОбъекта = Ссылка.Метаданные().ПолноеИмя();
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "Документ.ПоступлениеТоваровУслуг", ПолноеИмяОбъекта);
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Состояние", НаименованиеСостояния);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;

КонецФункции // ПолучитьИсполнителяЭтапа()

