	Приоритеты.Вставить(Перечисления.СтатусыЭтапов.Новый, 			1);
	Приоритеты.Вставить(Перечисления.СтатусыЭтапов.НаВыполнение, 	2); // одинаковый приоритет 
	Приоритеты.Вставить(Перечисления.СтатусыЭтапов.ВРаботе, 		2); // одинаковый приоритет
	Приоритеты.Вставить(Перечисления.СтатусыЭтапов.Выполнен, 		3);
	Приоритеты.Вставить(Перечисления.СтатусыЭтапов.Отклонен, 		4);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПротоколОбменов.Объект КАК Состояние
		|ИЗ
		|	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
		|ГДЕ
		|	ПротоколОбменов.Объект ССЫЛКА Справочник.Состояния";
	
	ТЗСостоянияКВыгрузке = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Стр Из Источник.Состояния Цикл 
		Если Не СтатусыДоЗаписи = Неопределено Тогда 
			Найдено = СтатусыДоЗаписи.Найти(Стр.Состояние,"Состояние"); 
			Если Не Найдено = Неопределено Тогда 
				Если Найдено.Статус <> Стр.Статус Тогда 
					НоваяСтрока = ТЗИзмененныеСтатусы.Добавить();
					НоваяСтрока.Состояние = Найдено.Состояние;
					НоваяСтрока.НачалоРаботы = Стр.НачалоРаботы;
					НоваяСтрока.ДатаВозвратаИсполнителю = Стр.ДатаВозвратаИсполнителю; 
					НоваяСтрока.Понижение = Приоритеты.Получить(Найдено.Статус)>Приоритеты.Получить(Стр.Статус); 
					НоваяСтрока.СтатусНовый = Стр.Статус;
					НоваяСтрока.РавнозначныеСтатусы = Приоритеты.Получить(Найдено.Статус)=Приоритеты.Получить(Стр.Статус);
					НоваяСтрока.ПодлежитОтправке = ЗначениеЗаполнено(ТЗСостоянияКВыгрузке.Найти(Найдено.Состояние,"Состояние"));
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	
	НайденыСтрокиКОтправке = ТЗИзмененныеСтатусы.НайтиСтроки(Новый Структура("РавнозначныеСтатусы,ПодлежитОтправке",Ложь,Истина));
	
	Если НайденыСтрокиКОтправке.Количество() Тогда 
		мСостояние = НайденыСтрокиКОтправке[0];
		Если Не мСостояние.Понижение И Приоритеты.Получить(мСостояние.СтатусНовый) <> 2 Тогда 
			Возврат;	
		КонецЕсли;	
		АктуальноеСостояние = мСостояние.Состояние;
		ЭтоВозвратСостояния = мСостояние.Понижение;
		ДатаСостояния = ?(мСостояние.Понижение,мСостояние.ДатаВозвратаИсполнителю,мСостояние.НачалоРаботы);
	Иначе 
		Возврат;	
	КонецЕсли;
	// ДИТ US 60108 TA 65708 Евсенкин М.А. Конец: 17.02.2023
	
	//Если Не ЭтоВозвратСостояния Тогда  // ДИТ US 60108 TA 65708 Евсенкин М.А. Начало: 17.02.2023
