	МассивКрасныхСостояний.Добавить(Перечисления.СтатусыСогласования.ОтклоненоБезЗамечаний);
	МассивКрасныхСостояний.Добавить(Перечисления.СтатусыСогласования.ОтклоненоСЗамечаниями);
	МассивКрасныхСостояний.Добавить(Перечисления.СтатусыСогласования.СогласованоСЗамечаниями);
	МассивСинихСостояний = Новый Массив;
	МассивСинихСостояний.Добавить(Перечисления.СтатусыСогласования.СогласованСКомментариями);
	
	Для каждого Стр из УФ.Объект.Состояния Цикл
		НЭ = Элементы.Добавить("Н"+СтрЗаменить(Новый УникальныйИдентификатор(), "-", ""), Тип("ДекорацияФормы"), Элементы.ГруппаПрогрессСостояний);
		НЭ.Гиперссылка = Истина;		
		
		НЭ.УстановитьДействие("Нажатие", "ОбработчикНажатияПлитокСостояния");
		НЭ.ЦветТекста = WebЦвета.Черный;
		
		// ДИТ 64186 Давудов М.А. Начало: 07.03.2023
		РодительскийСтатус =  Справочники.Состояния.ЗадачиГотовностьКомплектаПодтверждающихДокументов;
		Если Стр.ПредыдущиеЭтапы = "999"
		   И ЗначениеЗаполнено(Стр.Состояние)
		   И Стр.Состояние.ПринадлежитЭлементу(РодительскийСтатус) Тогда
			СтрТекШаблон = ШаблонНадписи;
			ТекстСостояния = Строка(Стр.Состояние) + " для КА """ + Строка(Стр.Клиент) + """";
			СтрТекШаблон = СтрЗаменить(СтрТекШаблон, "[Состояние]", ТекстСостояния);
			СтрТекШаблон = СтрЗаменить(СтрТекШаблон, "[Исполнитель]", Стр.Исполнитель);
		//Евросиб Шевченко А.В. US 95275 TA 106445 04.09.2025 
		ИначеЕсли Стр.Состояние = Справочники.Состояния.СозданиеСЗНаКорректировкуРТУПоСНП Тогда 
			СтрТекШаблон = ШаблонНадписи;
			СтрТекШаблон =	СтрЗаменить(СтрТекШаблон, "[Состояние]", Строка(Стр.Состояние) + " ("+УФ.Объект.НомерКТК+", расчет № " + УФ.Объект.Номер + " - корректировочный)");	
		//Евросиб Шевченко А.В. US 95275 TA 106445 04.09.2025
		Иначе
		// ДИТ 64186 Давудов М.А. Конец: 07.03.2023
		СтрТекШаблон = ШаблонНадписи;
		СтрТекШаблон = СтрЗаменить(СтрТекШаблон, "[Состояние]", Стр.Состояние);
		СтрТекШаблон = СтрЗаменить(СтрТекШаблон, "[Исполнитель]", Стр.Исполнитель);
		// ДИТ 64186 Давудов М.А. Начало: 07.03.2023
		КонецЕсли;
		// ДИТ 64186 Давудов М.А. Конец: 07.03.2023
		//ДИТ Шевченко А.В. 52889 10.03.2023 -начало
		МассивСтатусовДляОтработки = Новый Массив;
		МассивСтатусовДляОтработки.Добавить(Перечисления.СтатусыЭтапов.НаВыполнение);
		МассивСтатусовДляОтработки.Добавить(Перечисления.СтатусыЭтапов.ВРаботе);
		//ДИТ Шевченко А.В. 52889 10.03.2023 -конец
		РезСтрокаИсп = "";
		Если ТипЗнч(Стр.Исполнитель) = Тип("СправочникСсылка.Пользователи") Тогда
			//РезСтрокаИсп = Пользователи_sd_сервер.ПодобратьЗамещение(Стр.Исполнитель, Стр.НачалоРаботы);
			//ДИТ, Беляев СЮ, Ticket#0262619, 04-03-2022, ++
			//ДИТ Шевченко А.В. 52889 10.03.2023 -начало
			Если МассивСтатусовДляОтработки.Найти(Стр.Статус) <> неопределено Тогда
				РезСтрокаИсп = Пользователи_sd_сервер.ПодобратьЗамещение(Стр.Исполнитель, ТекущаяДата());
			Иначе
				РезСтрокаИсп = Стр.Исполнитель;
			КонецЕсли;
			//ДИТ Шевченко А.В. 52889 10.03.2023 -конец
			//ДИТ, Беляев СЮ, Ticket#0262619, 04-03-2022, --
		Иначе
			//МассивИсп = Пользователи_sd_сервер.ПолучитьПользователейГруппы(Стр.Исполнитель, Стр.НачалоРаботы, Истина);
			//ДИТ, Беляев СЮ, Ticket#0262619, 04-03-2022, ++
			МассивИсп = Пользователи_sd_сервер.ПолучитьПользователейГруппы(Стр.Исполнитель, ТекущаяДата(), Истина);  
			//ДИТ, Беляев СЮ, Ticket#0262619, 04-03-2022, --
			РезСтрокаИсп = СтрСоединить(МассивИсп, ", ");
		КонецЕсли;
		
		СтрТекШаблон = СтрЗаменить(СтрТекШаблон, "[Список_фамилий]", РезСтрокаИсп);
		НЭ.Заголовок = СтрТекШаблон;
		
		//НЭ.Заголовок = "" + Стр.Состояние + Символы.ПС + "("+Стр.Исполнитель+")";
		
		НЭ.РастягиватьПоГоризонтали = Истина;
		Если Стр.Состояние.Процессное Тогда
			НЭ.ЦветРамки = ЦветаСтиля.ЦветПроцесснойРамки;
			НЭ.Рамка = РамкаПроцессная;
		Иначе
			НЭ.ЦветРамки = ЦветаСтиля.ЦветНепроцесснойРамки;
			НЭ.Рамка = РамкаЪ;
		КонецЕсли;
		НЭ.Высота = 2;
		НЭ.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Центр;
		
		Если Стр.Статус = Перечисления.СтатусыЭтапов.ВРаботе Или Стр.Статус = Перечисления.СтатусыЭтапов.НаВыполнение Тогда
			НЭ.ЦветФона = ЦветаСтиля.ФонТекущегоСостояния;
		ИначеЕсли Стр.Статус = Перечисления.СтатусыЭтапов.Выполнен Тогда
			НЭ.ЦветФона = ЦветаСтиля.ФонВыполненногоСостояния;
//Евросиб Гудкова( 21.11.2019 
		ИначеЕсли Стр.Статус = Перечисления.СтатусыЭтапов.Отклонен Тогда
			НЭ.ЦветФона = ЦветаСтиля.СобытиеОтказ;
// Евросиб Гудкова) 			
		Иначе
			НЭ.ЦветФона = ЦветаСтиля.ФонБудущегоСостояния;
		КонецЕсли;
		
		Если МассивКрасныхСостояний.Найти(Стр.СтатусСогласования) <> неопределено Тогда
			НЭ.ЦветФона = ЦветаСтиля.ФонСостоянияСЗамечаниями;
		ИначеЕсли МассивСинихСостояний.Найти(Стр.СтатусСогласования) <> неопределено Тогда
			НЭ.ЦветФона = ЦветаСтиля.ФонСостоянияСКомментариями;
		КонецЕсли;
		
		// отработка по статусу В работе
		Если Стр.Статус = Перечисления.СтатусыЭтапов.ВРаботе И НЕ ЗначениеЗаполнено(Стр.НачалоРаботы) Тогда
			Стр.НачалоРаботы = ТекущаяДата();
		КонецЕсли;
		Если (Стр.Статус = Перечисления.СтатусыЭтапов.Выполнен ИЛИ Стр.Статус = Перечисления.СтатусыЭтапов.Отклонен) Тогда
			Если НЕ ЗначениеЗаполнено(Стр.НачалоРаботы) Тогда
				Стр.НачалоРаботы = ТекущаяДата();
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Стр.ЗавершениеРаботы) Тогда
				Стр.ЗавершениеРаботы = ТекущаяДата();
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
КонецПроцедуры
