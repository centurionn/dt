Функция ОтработатьЗамещениеДелегирование(МассивСостояний, ВидДокумента, ТекДата, Договор = неопределено, Параметры = Неопределено) Экспорт

	//Евросиб Каблов 12.08.2022 ( Task 55578
	Для Каждого Стр Из МассивСостояний Цикл
		Стр.Вставить("ИсполнительИзМаршрута", Стр.Исполнитель);
		Стр.Исполнитель = Неопределено;
	КонецЦикла;
	//Евросиб Каблов 12.08.2022 )
	
	Если ТипЗнч(Договор) = Тип("СправочникСсылка.ДоговорыКонтрагентов") ИЛИ ТипЗнч(Договор) = Тип("СправочникОбъект.ДоговорыКонтрагентов") Тогда
		
		Для каждого Стр из МассивСостояний Цикл
			// ДИТ US 51951 TA 61497 Евсенкин М.А. Начало: 30.11.2022
			// Было:
			//Если Стр.ОРКПоДоговору И ЗначениеЗаполнено(Договор.ОтветственныйЗаСопровождение) И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор.ОтветственныйЗаСопровождение, "Недействителен") = Ложь Тогда Стр.Исполнитель = Договор.ОтветственныйЗаСопровождение; КонецЕсли;
			//Если Стр.ОтветственныйЗаДоговор И ЗначениеЗаполнено(Договор.ОтветственныйЗаДоговор) И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор.ОтветственныйЗаДоговор, "Недействителен") = Ложь Тогда Стр.Исполнитель = Договор.ОтветственныйЗаДоговор; КонецЕсли;
			//Если Стр.ОтветственныйЗаУчет И ЗначениеЗаполнено(Договор.ОтветственныйЗаУчет) И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор.ОтветственныйЗаУчет, "Недействителен") = Ложь Тогда Стр.Исполнитель = Договор.ОтветственныйЗаУчет; КонецЕсли;
			//Стало:
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("Договор",				Договор);
			СтруктураПараметров.Вставить("ЦФО",					Справочники.ЦентрыФинансовойОтветственности.ОсновнойЦФО);
			СтруктураПараметров.Вставить("ТипОтветственного",	Перечисления.ТипыОтветственных.ОтветственныйЗаУчет);  
			мОтветственныйЗаУчет = Справочники.ДоговорыКонтрагентов.ПолучитьОтветственного(СтруктураПараметров);
			
			СтруктураПараметров.Вставить("ТипОтветственного",	Перечисления.ТипыОтветственных.ОтветственныйЗаСопровождение);  
			мОтветственныйЗаСопровождение = Справочники.ДоговорыКонтрагентов.ПолучитьОтветственного(СтруктураПараметров);
			//*
			Если Стр.ОРКПоДоговору 
				И ЗначениеЗаполнено(мОтветственныйЗаСопровождение) 
				И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(мОтветственныйЗаСопровождение, "Недействителен") = Ложь Тогда 
				Стр.Исполнитель = мОтветственныйЗаСопровождение; 
			КонецЕсли;
			Если Стр.ОтветственныйЗаДоговор 
				И ЗначениеЗаполнено(Договор.ОтветственныйЗаДоговор) 
				И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор.ОтветственныйЗаДоговор, "Недействителен") = Ложь Тогда 
				Стр.Исполнитель = Договор.ОтветственныйЗаДоговор; 
			КонецЕсли;
			Если Стр.ОтветственныйЗаУчет 
				И ЗначениеЗаполнено(мОтветственныйЗаУчет) 
				И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(мОтветственныйЗаУчет, "Недействителен") = Ложь Тогда 
				Стр.Исполнитель = мОтветственныйЗаУчет; 
			КонецЕсли;
			// ДИТ US 51951 TA 61497 Евсенкин М.А. Конец: 30.11.2022
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Договор) = Тип("СправочникСсылка.ВидыПеревозок") Тогда
		
		Для каждого Стр из МассивСостояний Цикл
			
			// Евросиб Фролов (22.02.2022 Task №47363
			Если Стр.ИсполнительКакРуководительПоНаправлению И ВидДокумента = Перечисления.МаршрутизируемыеОбъекты.ЗаявкаКлиента Тогда
				Если ЗначениеЗаполнено(Договор) Тогда
					ОтветственныйОтОРП = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "ОтветственныйОтОРП");
					Если ЗначениеЗаполнено(ОтветственныйОтОРП) Тогда
						Стр.Исполнитель = ОтветственныйОтОРП;
					КонецЕсли;	
				КонецЕсли;		
			// Евросиб Фролов)			
			ИначеЕсли Стр.ИсполнительКакРуководительПоНаправлению И ЗначениеЗаполнено(Договор.ОтветственныйПоНаправлению) Тогда 
				Стр.Исполнитель = Договор.ОтветственныйПоНаправлению; 
			КонецЕсли;
			Если Стр.НаблюдательКакРуководительПоНаправлению И ЗначениеЗаполнено(Договор.ОтветственныйПоНаправлению) Тогда 
				Стр.Наблюдатель = Договор.ОтветственныйПоНаправлению; 
			КонецЕсли;
		КонецЦикла;
		
	// Евросиб US 114823 TA 116919 Рыбьяков К.А. 17.08.2025 ((
	ИначеЕсли ТипЗнч(Договор) = Тип("ПеречислениеСсылка.ВнутренниеСтатусыЗапросовНаКТК") Тогда
				
		Для Каждого Стр Из МассивСостояний Цикл
			
			Если Стр.Состояние = ПредопределенноеЗначение("Справочник.Состояния.БронированиеКТК") 
				И Договор = Перечисления.ВнутренниеСтатусыЗапросовНаКТК.НеВзятВРаботу Тогда
				Стр.Исполнитель = Справочники.ГруппыПользователей.ГруппаВыдачиКонтейнеровПоЗапросуВРП;
			ИначеЕсли (Стр.Состояние = ПредопределенноеЗначение("Справочник.Состояния.БронированиеКТК")) 
				И (Стр.Статус = Перечисления.СтатусыЭтапов.НаВыполнение Или Стр.Статус = Перечисления.СтатусыЭтапов.ВРаботе)
				И (Договор = Перечисления.ВнутренниеСтатусыЗапросовНаКТК.Отработан Или Договор = Перечисления.ВнутренниеСтатусыЗапросовНаКТК.ВзятВРаботу) Тогда
				Стр.Исполнитель = Параметры["Редактор"];
			КонецЕсли;
			
			Если Стр.Состояние = ПредопределенноеЗначение("Справочник.Состояния.РелизНаВыдачуКТККлиенту") 
				И Договор = Перечисления.ВнутренниеСтатусыЗапросовНаКТК.НеВзятВРаботу Тогда
				Стр.Исполнитель = Справочники.ГруппыПользователей.ГруппаОформленияРелиза;
			ИначеЕсли (Стр.Состояние = ПредопределенноеЗначение("Справочник.Состояния.РелизНаВыдачуКТККлиенту")) 
				И (Стр.Статус = Перечисления.СтатусыЭтапов.НаВыполнение Или Стр.Статус = Перечисления.СтатусыЭтапов.ВРаботе)
				И (Договор = Перечисления.ВнутренниеСтатусыЗапросовНаКТК.Отработан Или Договор = Перечисления.ВнутренниеСтатусыЗапросовНаКТК.ВзятВРаботу) Тогда
				Стр.Исполнитель = Параметры["Редактор"];
			КонецЕсли;
				
		КонецЦикла;
	// Евросиб Рыбьяков К.А. 17.08.2025 ))
	КонецЕсли;
	
	//Евросиб Каблов 12.08.2022 ( Task 55578
	Для каждого Стр из МассивСостояний Цикл
		
		Если (Стр.РуководительСотрудника Или Стр.ВыбиратьИсполнителяЕслиНеЗаполненРуководительСотрудника)
				И ТипЗнч(Стр.Исполнитель) = Тип("СправочникСсылка.Пользователи") И ЗначениеЗаполнено(Стр.Исполнитель) Тогда
				
			НепосредственныйРуководитель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Стр.Исполнитель, "НепосредственныйРуководитель");
			
			Если ЗначениеЗаполнено(НепосредственныйРуководитель) Тогда
				Если Стр.РуководительСотрудника Тогда
					Стр.Исполнитель = НепосредственныйРуководитель;
				КонецЕсли;
			ИначеЕсли Стр.ВыбиратьИсполнителяЕслиНеЗаполненРуководительСотрудника И ЗначениеЗаполнено(Стр.ИсполнительИзМаршрута) Тогда
				Стр.Исполнитель = Стр.ИсполнительИзМаршрута;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Стр.Исполнитель) И ЗначениеЗаполнено(Стр.ИсполнительИзМаршрута) Тогда
			Стр.Исполнитель = Стр.ИсполнительИзМаршрута;
		КонецЕсли;
		
	КонецЦикла;
	//Евросиб Каблов 12.08.2022 )
	
	Возврат неопределено;
	//------------------------
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗамещениеДляДокументов.Ссылка.ИсходныйПользователь КАК ИсходныйПользователь,
	               |	ЗамещениеДляДокументов.Ссылка.Замещение КАК Замещение,
	               |	ЗамещениеДляДокументов.Ссылка.РежимДокумента КАК РежимДокумента
	               |ИЗ
	               |	Документ.Замещение.ДляДокументов КАК ЗамещениеДляДокументов
	               |ГДЕ
	               |	ЗамещениеДляДокументов.ОбъектЪ = &ОбъектЪ
	               |	И &ТекДата МЕЖДУ ЗамещениеДляДокументов.Ссылка.НачалоПериодаЗамещения И ЗамещениеДляДокументов.Ссылка.КонецПериодаЗамещения
	               |	И ЗамещениеДляДокументов.Ссылка.Проведен";
	Запрос.УстановитьПараметр("ОбъектЪ", ВидДокумента);
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДата());
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		Если Ответ.РежимДокумента = 0 Тогда
			
			Для каждого Стр из МассивСостояний Цикл
				Если Стр.Исполнитель = Ответ.ИсходныйПользователь Тогда Стр.Исполнитель = Ответ.Замещение; КонецЕсли;
				Если Стр.Наблюдатель = Ответ.Замещение Тогда Стр.Наблюдатель = Ответ.Замещение; КонецЕсли;
			КонецЦикла;
			
		Иначе
			
			Для Сч = 0 По МассивСостояний.Количество() Цикл
				Если Пользователи_sd_сервер.ГруппаВключаетПользователя(МассивСостояний[Сч].Исполнитель, Ответ.ИсходныйПользователь) Тогда
					МассивСостояний.Вставить(Сч, Новый Структура("Состояние, Исполнитель, Наблюдатель, Статус, Ссылка", Справочники.Состояния.ДелегированноеСогласование, Ответ.Замещение, неопределено, МассивСостояний[сч].Статус, МассивСостояний[сч].Ссылка));
					МассивСостояний[Сч+1].Статус = Перечисления.СтатусыЭтапов.Новый;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

