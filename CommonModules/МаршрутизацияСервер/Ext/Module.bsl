Процедура ОтметитьВыполнениеЗадачПоСсылке(Ссылка, ЗадачиДляОтметкиВыполнения = Неопределено) Экспорт
	
	Объект = Ссылка.ПолучитьОбъект();
	ОтметитьВыполнениеЗадач(Объект, ЗадачиДляОтметкиВыполнения);
	
	Если Объект.Модифицированность() Тогда
		//ДИТ Шевченко А.В. BUG 75898 TA 75908 10.10.2023
		Объект.ДополнительныеСвойства.Вставить("ЭтоЗакрытиеЗадач");
		//ДИТ Шевченко А.В. BUG 75898 TA 75908 10.10.2023
		Объект.Записать();
	КонецЕсли;
	
