		|	КОНЕЦ КАК Недействителен,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(заявкаСостояния.Исполнитель) = ЗНАЧЕНИЕ(Справочник.ГруппыПользователей)
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ЦентрыФинансовойОтветственности.ПустаяСсылка)
		|		ИНАЧЕ ЕСТЬNULL(Пользователи.ЦФО, ЗНАЧЕНИЕ(Справочник.ЦентрыФинансовойОтветственности.ПустаяСсылка))
		|	КОНЕЦ КАК ЦФО,
		// ДИТ BUG 83426 ТА 83584 Сержантова А.С. Конец: 10.04.2024
		|	заявки.Договор КАК Договор
		|ИЗ
		|	Документ.Сделка.Заявки КАК СделкаЗаявки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Заявка КАК заявки
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка.Состояния КАК заявкасостояния
		|			ПО заявки.Ссылка = заявкасостояния.Ссылка
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка.ПереченьРейсов КАК заявкаПереченьрейсов
		|			ПО заявки.Ссылка = заявкаПереченьрейсов.Ссылка
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
		|			ПО (заявкасостояния.Исполнитель = Пользователи.Ссылка)
		|		ПО СделкаЗаявки.Заявка = заявки.Ссылка
		|ГДЕ
		|	заявкасостояния.НомерСтроки = 1 
		// ДИТ BUG 83426 ТА 83584 Сержантова А.С. Начало: 12.04.2024
		|	И заявки.Создано >= &ДатаНачалаОбработки
		// ДИТ BUG 83426 ТА 83584 Сержантова А.С. Конец: 12.04.2024
		|	И СделкаЗаявки.Ссылка.Проведен
		|	И (заявкаПереченьрейсов.Рейс ЕСТЬ NULL
		|			ИЛИ ВЫРАЗИТЬ(заявкаПереченьрейсов.Рейс КАК Справочник.РейсыЖД).РейсОтменен)";
	// ДИТ BUG 83426 ТА 83584 Сержантова А.С. Начало: 12.04.2024
	Запрос.УстановитьПараметр("ДатаНачалаОбработки", ДатаНачалаОбработки);
	// ДИТ BUG 83426 ТА 83584 Сержантова А.С. Конец: 12.04.2024
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаЗадачи = РезультатЗапроса.Выбрать(); 
	
	Пока ВыборкаЗадачи.Следующий() Цикл
		
		Заявка = ВыборкаЗадачи.Заявка;
		Состояние = Справочники.Состояния.ТребуетсяЗаполнитьРейс; 
		
		// разберемся, не уволен ли исполнитель
		Если ВыборкаЗадачи.Исполнитель = Неопределено ИЛИ ВыборкаЗадачи.Недействителен Тогда
			// с исполнителем непорядок, вместо него задачу поручим Ответственному за сопровождение
			Параметры = Новый Структура;
			Параметры.Вставить("Договор", ВыборкаЗадачи.Договор);
			Параметры.Вставить("ЦФО", ВыборкаЗадачи.ЦФО);
			Параметры.Вставить("ТипОтветственного", Перечисления.ТипыОтветственных.ОтветственныйЗаСопровождение);
			Исполнитель = Справочники.ДоговорыКонтрагентов.ПолучитьОтветственного(Параметры);
		Иначе
			//все нормально, исполнитель есть и он работает
			Исполнитель = ВыборкаЗадачи.Исполнитель;
		КонецЕсли; 
		
        // поищем подобную задачу для этой заявки
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЗаявкаСостояния.Ссылка КАК Ссылка,
			|	ЗаявкаСостояния.Состояние КАК Состояние,
			|	ЗаявкаСостояния.Статус КАК Статус
			|ИЗ
			|	Документ.Заявка.Состояния КАК ЗаявкаСостояния
			|ГДЕ
			|	ЗаявкаСостояния.Ссылка = &Ссылка
			|	И ЗаявкаСостояния.Состояние = &Состояние";
		
		Запрос.УстановитьПараметр("Ссылка", Заявка);
		Запрос.УстановитьПараметр("Состояние", Состояние);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		// если такой задачи нет, то создать
		Если РезультатЗапроса.Пустой() Тогда
			Попытка
				ЗаявкаОбъект = Заявка.ПолучитьОбъект();
				НоваяСтрокаСостояния = ЗаявкаОбъект.Состояния.Добавить();
				НоваяСтрокаСостояния.Состояние = Состояние;
				НоваяСтрокаСостояния.Исполнитель = Исполнитель;
				НоваяСтрокаСостояния.Наблюдатель = Исполнитель;
				НоваяСтрокаСостояния.Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
				НоваяСтрокаСостояния.НачалоРаботы = ТекущаяДата(); 
				ЗаявкаОбъект.Записать();
			Исключение
				//ОбщегоНазначения.СообщитьПользователю("Не удалось cоздать или изменить статус задания ""Требуется заполнить рейс"" задание для заявки: " + ВыборкаЗадачи.Номер);
			КонецПопытки;
			// переходим на следующую задачу
			Продолжить;
		КонецЕсли;
		
		// если такая задача есть, то
		ВыборкаСостояния = РезультатЗапроса.Выбрать();
		Пока ВыборкаСостояния.Следующий() Цикл
			Если ВыборкаСостояния.Статус = Перечисления.СтатусыЭтапов.Выполнен Тогда
				ЗаявкаОбъект = Заявка.ПолучитьОбъект();
				// найдем нужную строку в ТЧ и изменим статус
				Для каждого СтрокаСостояния Из ЗаявкаОбъект.Состояния Цикл
					Если СтрокаСостояния.Состояние = Состояние Тогда                     
						СтрокаСостояния.Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
						СтрокаСостояния.Исполнитель = Исполнитель;
						СтрокаСостояния.Наблюдатель = Исполнитель;
						Попытка
							ЗаявкаОбъект.Записать(); 
						Исключение
							//ОбщегоНазначения.СообщитьПользователю("Не удалось cоздать или изменить статус задания ""Требуется заполнить рейс"" задание для заявки: " + ВыборкаЗадачи.Номер);
						КонецПопытки;
						// дальше просматривать смысла нет, строка должна быть только одна
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры
