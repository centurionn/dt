	               |			ИНАЧЕ Маршрутизация.Организация = &Организация
	               |					ИЛИ Маршрутизация.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА Маршрутизация.Резидент <> Маршрутизация.Нерезидент
	               |				ТОГДА Маршрутизация.Резидент = ВЫРАЗИТЬ(&Контрагент КАК Справочник.Контрагенты).СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	               |						ИЛИ Маршрутизация.Нерезидент = ВЫРАЗИТЬ(&Контрагент КАК Справочник.Контрагенты).СтранаРегистрации <> ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И Маршрутизация.ПТУШтраф = &Штраф
	               |	И (Маршрутизация.ЦФО = &ЦФО
	               |			ИЛИ Маршрутизация.ЦФО = ЗНАЧЕНИЕ(Справочник.ЦентрыФинансовойОтветственности.ПустаяСсылка))
	               |	И Маршрутизация.Копия = &Копия
	               |	И ВЫБОР
	               |			КОГДА Маршрутизация.Резидент <> Маршрутизация.Нерезидент
	               |				ТОГДА Маршрутизация.Резидент = (ВЫРАЗИТЬ(&Контрагент КАК Справочник.Контрагенты).СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия))
	               |						И Маршрутизация.Нерезидент = (ВЫРАЗИТЬ(&Контрагент КАК Справочник.Контрагенты).СтранаРегистрации <> ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия))
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И Маршрутизация.ПТУРИТМ = &ПТУРИТМ
	               |	И Маршрутизация.ЭДО = &ЭДО
				   //Евросиб Каблов 12.08.2022 ( Task 55578
				   |	И (Маршрутизация.ПТУВидУслуг = &ВидУслуг ИЛИ Маршрутизация.ПТУВидУслуг = ЗНАЧЕНИЕ(Перечисление.ВидыУслугПодрядчиков.ПустаяСсылка))
				   //Евросиб Каблов 12.08.2022 )
				   //Евросиб Каблов 16.08.2021 ( Ticket#0240249
	               |	И (&СуммаДокумента МЕЖДУ Маршрутизация.ПТУСуммаОт И Маршрутизация.ПТУСуммаДо
	               |			ИЛИ Маршрутизация.ПТУСуммаОт = 0
	               |				И Маршрутизация.ПТУСуммаДо = 0)";
				   //Евросиб Каблов 16.08.2021 )
	Запрос.УстановитьПараметр("Контрагент", ПараметрыЗапроса["Контрагент"]);
	Запрос.УстановитьПараметр("Организация", ПараметрыЗапроса["Организация"]);
	Запрос.УстановитьПараметр("Договор", ПараметрыЗапроса["Договор"]);
	Запрос.УстановитьПараметр("Штраф", ПараметрыЗапроса["Штраф"]);
	Запрос.УстановитьПараметр("ПТУРИТМ", ЗагруженИзРИТМ);
//Евросиб Максимова 01.04.2021 #0225967
	Запрос.УстановитьПараметр("ЭДО", (ЗагруженИзДиадок И НЕ ЗагруженИзРИТМ));
	//Запрос.УстановитьПараметр("ЭДО", ЗагруженИзДиадок);
//Евросиб Максимова 01.04.2021 #0225967

//Евросиб Гудкова( 29.09.2020 Ticket№ 0208324
	Запрос.УстановитьПараметр("ЦФО", ПараметрыЗапроса["ЦФО"]);
	Запрос.УстановитьПараметр("Копия", ПараметрыЗапроса["Копия"]);
// Евросиб Гудкова)

	//Евросиб Каблов 16.08.2021 ( Ticket#0240249
	СуммаДокументаМодуль = ?(ПараметрыЗапроса["СуммаДокумента"] >= 0, ПараметрыЗапроса["СуммаДокумента"], -ПараметрыЗапроса["СуммаДокумента"]);
	Запрос.УстановитьПараметр("СуммаДокумента", СуммаДокументаМодуль);
	//Евросиб Каблов 16.08.2021 )
	
	//Евросиб Каблов 12.08.2022 ( Task 55578
	Запрос.УстановитьПараметр("ВидУслуг", ПараметрыЗапроса["ВидУслуг"]);
	//Евросиб Каблов 12.08.2022 )
	
	Ответ = Запрос.Выполнить().Выбрать();
	КоличествоСовпаденийМакс = -1;
	ПодходящаяМаршрутизация = Справочники.Маршрутизация.ПустаяСсылка();
	Пока Ответ.Следующий() Цикл
		КоличествоСовпадений = 0;
		
		Если ЗначениеЗаполнено(Ответ["Контрагент"]) Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		Если ЗначениеЗаполнено(Ответ["Организация"]) Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		Если ЗначениеЗаполнено(Ответ["Договор"]) Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		Если Ответ["ПТУДиадок"] = ЗагруженИзДиадок Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		Если Ответ["ПТУРИТМ"] = ЗагруженИзРИТМ Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		Если Ответ["ПТУШтраф"] = ПараметрыЗапроса["Штраф"] Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
//Евросиб Гудкова( 29.09.2020 Ticket№ 0208324
		Если Ответ["ЦФО"] = ПараметрыЗапроса["ЦФО"] Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		Если Ответ["Копия"] = ПараметрыЗапроса["Копия"] Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		Если Ответ["КонтрагентРезидент"] Тогда
			Если Ответ["КонтрагентРезидент"] <> Ответ["НеРезидент"] Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		Иначе
			Если (не Ответ["КонтрагентРезидент"]) <> Ответ["Резидент"] Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		КонецЕсли;	
// Евросиб Гудкова)
		//Евросиб Каблов 16.08.2021 ( Ticket#0240249
		Если Ответ.ПТУСуммаОт <= СуммаДокументаМодуль И Ответ.ПТУСуммаДо >= СуммаДокументаМодуль Тогда
			КоличествоСовпадений = КоличествоСовпадений + 1;
		КонецЕсли;
		//Евросиб Каблов 16.08.2021 )
		
		//Евросиб Каблов 12.08.2022 ( Task 	55578
		Если ЗначениеЗаполнено(Ответ["ПТУВидУслуг"]) Тогда
			КоличествоСовпадений = КоличествоСовпадений + 1;
		КонецЕсли;
		//Евросиб Каблов 12.08.2022 )
		
		Если КоличествоСовпадений > КоличествоСовпаденийМакс Тогда
			ПодходящаяМаршрутизация = Ответ.Ссылка;
			КоличествоСовпаденийМакс = КоличествоСовпадений;
		КонецЕсли;
	КонецЦикла;
	
	РезультатЗапроса = Новый Массив;
