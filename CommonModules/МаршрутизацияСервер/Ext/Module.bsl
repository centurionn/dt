	//	Если НайденныеСтроки.Количество() = 1 Тогда 
	//		АктуальноеСостояние = НайденныеСтроки[0].Состояние;
	//		// ДИТ US 60108 TA 65708 Евсенкин М.А. Начало: 17.02.2023
	//		// Было:
	//		//ЭтоВозвратСостояния = ЗначениеЗаполнено(НайденныеСтроки[0].ДатаВозвратаИсполнителю); 
	//		//ДатаСостояния = ?(ЭтоВозвратСостояния, НайденныеСтроки[0].ДатаВозвратаИсполнителю, НайденныеСтроки[0].НачалоРаботы);
	//		//Стало:
	//		ДатаСостояния = НайденныеСтроки[0].НачалоРаботы;
	//		// ДИТ US 60108 TA 65708 Евсенкин М.А. Конец: 17.02.2023
	//	Иначе 
	//		// пробуем найти состояние В работе
	//		НайденныеСтроки = Источник.Состояния.НайтиСтроки(Новый Структура("Статус", Перечисления.СтатусыЭтапов.ВРаботе));
	//		Если НайденныеСтроки.Количество() = 1 Тогда 
	//			АктуальноеСостояние = НайденныеСтроки[0].Состояние;
	//			// ДИТ US 60108 TA 65708 Евсенкин М.А. Начало: 17.02.2023
	//			// Было:
	//			//ЭтоВозвратСостояния = ЗначениеЗаполнено(НайденныеСтроки[0].ДатаВозвратаИсполнителю); 
	//			//ДатаСостояния = ?(ЭтоВозвратСостояния, НайденныеСтроки[0].ДатаВозвратаИсполнителю, НайденныеСтроки[0].НачалоРаботы);
	//			//Стало:
	//			ДатаСостояния = НайденныеСтроки[0].НачалоРаботы;
	//			// ДИТ US 60108 TA 65708 Евсенкин М.А. Конец: 17.02.2023
	//		Иначе 
	//			// не удалось определить актуальное состояние, либо документ не маршрутизирован
	//		КонецЕсли;
	//	КонецЕсли; 
	//КонецЕсли; // ДИТ US 60108 TA 65708 Евсенкин М.А. Конец: 17.02.2023
	
	Если НЕ ЗначениеЗаполнено(АктуальноеСостояние) Тогда 
		Возврат;
	КонецЕсли;
	
	// проверим нужно ли отправлять состояние в 1С:ДО
	КодСостояния = "";
    //ДИТ Шевченко А.В., US 35090 17.11.2022 -начало
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПротоколОбменов.УИДИсточника КАК УИДИсточника
		|ИЗ
		|	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
		|ГДЕ
		|	ПротоколОбменов.Объект = &Объект
		|	И ПротоколОбменов.ДействиеПриОбмене = &ДействиеПриОбмене
		|	И ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.ДО)";
	
	Запрос.УстановитьПараметр("ДействиеПриОбмене", Перечисления.ДействияПриОбмене.ВыгрузкаДанных);
	Если ЭтоВозвратСостояния Тогда
		Запрос.УстановитьПараметр("ДействиеПриОбмене", Перечисления.ДействияПриОбмене.ЗагрузкаДанных);		
	КонецЕсли;
	//ДИТ Шевченко А.В., US 35090 17.11.2022 -конец
	Запрос.УстановитьПараметр("Объект", АктуальноеСостояние);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
		КодСостояния = ВыборкаДетальныеЗаписи.УИДИсточника;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(КодСостояния) Тогда 
		Возврат;
	КонецЕсли;
		
	Прокси = ВебСервисы_сервер.ПолучитьПрокси("ВебСервисОбменаСДО");
	
	//// получим список состояний из 1С:ДО
	//ОтветВебСервисаСостояния = "out";
	//Попытка
	//	//Вызываем метод веб-сервиса
	//	ОбъектXDTO = Прокси.GetEvents(
