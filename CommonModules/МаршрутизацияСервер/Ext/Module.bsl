Функция РасчетНормативаИсполнения(ВидНорматива, ОбъектРасчета, ДатаНачала, Источник) ЭКСПОРТ
	
	//СтруктураОтвета = Новый СТруктура;
	//ВременноеИзмерение = "ЧАС";
	//ДатаОкончания = ТекущаяДата();
	Длительность = 0;
	
	Если ВидНорматива = Перечисления.ВидыНормативовИспользования.ПервыйРДмесяцаПослеОкончанияПеревозки Тогда
		// данное правило для сделки. анализируем ЖД рейсы. Если их несколько, берем самую
		// позднюю дату по прибытию
		
		// получить данные по производственному календарю
		ПрКалендарь = ПостроительТСх_сервер.ПодобратьПроизводственныйКалендарь(Справочники.Контрагенты.ПустаяСсылка(), Справочники.Номенклатура.ПустаяСсылка());
		
		//КолвоПервых = "ПЕРВЫЕ " + КолвоДней;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ДанныеПроизводственногоКалендаря.ПроизводственныйКалендарь КАК ПроизводственныйКалендарь,
		               |	ВЫБОР
		               |		КОГДА ДанныеПроизводственногоКалендаря.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Рабочий)
		               |				ИЛИ ДанныеПроизводственногоКалендаря.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Предпраздничный)
		               |			ТОГДА 1
		               |		ИНАЧЕ 0
		               |	КОНЕЦ КАК РабочийДень,
		               |	ДанныеПроизводственногоКалендаря.Дата КАК Дата
		               |ПОМЕСТИТЬ Вт1
		               |ИЗ
		               |	РегистрСведений.ДанныеПроизводственногоКалендаря КАК ДанныеПроизводственногоКалендаря
		               |ГДЕ
		               |	ДанныеПроизводственногоКалендаря.ПроизводственныйКалендарь = &ПроизводственныйКалендарь
		               |	И ДанныеПроизводственногоКалендаря.Дата > &ДатаНач
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ ПЕРВЫЕ 1
		               |	Вт1.ПроизводственныйКалендарь КАК ПроизводственныйКалендарь,
		               |	Вт1.РабочийДень КАК РабочийДень,
		               |	Вт1.Дата КАК Дата
		               |ИЗ
		               |	Вт1 КАК Вт1
		               |ГДЕ
		               |	Вт1.РабочийДень <> 0
					   |УПОРЯДОЧИТЬ ПО
					   |	Дата";
		Запрос.УстановитьПараметр("ПроизводственныйКалендарь",ПрКалендарь);
		Запрос.УстановитьПараметр("ДатаНач",КонецМесяца(ДатаНачала));

		ТЗ = Запрос.Выполнить().Выгрузить();
		Если ТЗ.Количество()>0 Тогда
			ДатаОкончания = ТЗ[0].Дата;
			// в длительность записываем кол-во дней от окончания перевозки до момента "ПервыйРДмесяцаПослеОкончанияПеревозки"
			Длительность = (ДатаОкончания - ДатаНачала)/3600;
		КонецЕсли;
		
	КонецЕсли;
	
	//СтруктураОтвета.Вставить("ВременноеИзмерение",ВременноеИзмерение);
	//СтруктураОтвета.Вставить("Длительность",Длительность);
	//СтруктураОтвета.Вставить("ДатаНачала",ДатаНачала);
	//СтруктураОтвета.Вставить("ДатаОкончания",ДатаОкончания);
	
	Возврат Длительность;
	
КонецФункции

Процедура ПрименитьМаршрут(ЭтотОбъектЪ, НайденныйМаршрутМассив, КемЗаполнятьПустыхЮзеров, УказанныеВручнуюИсполнителиНаблюдатели) Экспорт
	
	ЭтотОбъектЪ.ПримененныйМаршрут = НайденныйМаршрутМассив[0].Ссылка;
	
	ЭтотОбъектЪ.Состояния.Очистить();
	Для каждого Стр из НайденныйМаршрутМассив Цикл
		НСтр = ЭтотОбъектЪ.Состояния.Добавить();
		ЗаполнитьЗначенияСвойств(НСтр, Стр);
		
		МассивСтрОбработки = УказанныеВручнуюИсполнителиНаблюдатели.ВыгрузитьЗначения();
		Для каждого Стр7 из МассивСтрОбработки Цикл
			
			Если НСтр.Состояние = Стр7.Состояние Тогда ЗаполнитьЗначенияСвойств(НСтр, Стр7); КонецЕсли;
			
		КонецЦикла;
		
		Если ТипЗнч(ЭтотОбъектЪ) = Тип("ДокументОбъект.ПСЦ") И Стр.ОтветственныйМенеджерПСЦ = Истина И ЗначениеЗаполнено(ЭтотОбъектЪ.ОтветственныйМенеджер) Тогда
			НСтр.Исполнитель = ЭтотОбъектЪ.ОтветственныйМенеджер;
		КонецЕсли;
		//Евросиб Максимова #0223008
		Если ТипЗнч(ЭтотОбъектЪ) = Тип("ДокументОбъект.ПоступлениеНаРасчетныйСчет")  Тогда
			Если ЭтотОбъектЪ.ЦФО<>Справочники.ЦентрыФинансовойОтветственности.ОсновнойЦФО Тогда
				// ДИТ US 51951 TA 61497 Евсенкин М.А. Начало: 14.12.2022
				// Было:
				//ИсполнительНСК=ЭтотОбъектЪ.ДоговорКонтрагента.ОтветственныйЗаСопровождениеНСК; 
				//Стало:
				СтруктураПараметров = Новый Структура;
				СтруктураПараметров.Вставить("Договор",				ЭтотОбъектЪ.ДоговорКонтрагента);
				СтруктураПараметров.Вставить("ЦФО",					Справочники.ЦентрыФинансовойОтветственности.ТерминалНовосибирск);
				СтруктураПараметров.Вставить("ТипОтветственного",	Перечисления.ТипыОтветственных.ОтветственныйЗаСопровождение);  
				ИсполнительНСК = Справочники.ДоговорыКонтрагентов.ПолучитьОтветственного(СтруктураПараметров);
				// ДИТ US 51951 TA 61497 Евсенкин М.А. Конец: 14.12.2022
				
			//Иначе
			//    КемЗаполнятьПустыхЮзеровДоговор=ЭтотОбъектЪ.ДоговорКонтрагента.ОтветственныйЗаСопровождение;
			Если ЗначениеЗаполнено(ИсполнительНСК) Тогда
				НСтр.Исполнитель=ИсполнительНСК;
				НСтр.Наблюдатель=ИсполнительНСК;
			Иначе
				Сообщить("Не заполнен ответственный за сопровождение НСК в договоре!");
			КонецЕсли;
			КонецЕсли;

		КонецЕсли;
		//Евросиб Максимова #0223008
		
		Если НЕ ЗначениеЗаполнено(НСтр.Исполнитель) И НЕ Стр.ТребуетсяУказатьИсполнителя Тогда НСтр.Исполнитель = КемЗаполнятьПустыхЮзеров; КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НСтр.Наблюдатель) И НЕ Стр.ТребуетсяУказатьНаблюдателя Тогда НСтр.Наблюдатель = КемЗаполнятьПустыхЮзеров; КонецЕсли;
		
	КонецЦикла;
	
	// Евросиб Фролов (06.12.2021 TASK№ №42618, РелизКлиента
	Если ТипЗнч(ЭтотОбъектЪ) = Тип("ДокументОбъект.Заявка") Тогда
		Если ЭтотОбъектЪ.ЗапросНаКТК Тогда
			ЭтотОбъектЪ.ВнутреннийСтатусЗапроса = Перечисления.ВнутренниеСтатусыЗапросовНаКТК.Черновик;
		КонецЕсли;	
	КонецЕсли;	
	// Евросиб Фролов)
	
КонецПроцедуры

//Евросиб Каблов 16.06.2021 ( Ticket#0234671
//Процедура ПостобработкаТЧСостояний(ЭтотОбъектЪ, КемЗаполнятьПустыхЮзеров) Экспорт
