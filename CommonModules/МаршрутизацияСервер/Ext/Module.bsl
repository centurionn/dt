	//	   ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	//КонецПопытки;
	
	// отправляем состояние в веб-сервис 1С:ДО
	ИмяМетода = "XMLStatusMonitoring";
	ИмяОперации = "Event";
			
	//Получаем параметры метода
	ТипWSПараметра = Прокси.ФабрикаXDTO.Пакеты.Получить(ИмяМетода).Получить(ИмяОперации);
	
	//Создаем параметр на основе типа и заполняем значение параметров
	WSПараметр = Прокси.ФабрикаXDTO.Создать(ТипWSПараметра);
	WSПараметр.Set_GUID 		= ГУИДДокумента;
	WSПараметр.EventCode 		= КодСостояния;
	WSПараметр.EventDate 		= ДатаСостояния;
	WSПараметр.ExternalSystemID = "Data Core";
	WSПараметр.Comment 			= "";
	
	Запись = Новый ЗаписьXML;
		
	Запись.УстановитьСтроку("windows-1251"); 
	Запись.ЗаписатьОбъявлениеXML();
	
	Запись.ЗаписатьНачалоЭлемента("Events");
	
	Запись.ЗаписатьНачалоАтрибута("xmlns");		
	Запись.ЗаписатьТекст(XMLСтрока("XMLStatusMonitoring"));		
	Запись.ЗаписатьКонецАтрибута(); //xmlns
	
	Запись.ЗаписатьНачалоАтрибута("xmlns:xs");		
	Запись.ЗаписатьТекст(XMLСтрока("http://www.w3.org/2001/XMLSchema"));		
	Запись.ЗаписатьКонецАтрибута(); //xmlns:xs
	
	Запись.ЗаписатьНачалоЭлемента("Event");
	
	Запись.ЗаписатьНачалоЭлемента("Set_GUID");
	Запись.ЗаписатьТекст(XMLСтрока(WSПараметр.Set_GUID));		
	Запись.ЗаписатьКонецЭлемента(); //Set_GUID
	
	Запись.ЗаписатьНачалоЭлемента("EventCode");
	Запись.ЗаписатьТекст(XMLСтрока(WSПараметр.EventCode));		
	Запись.ЗаписатьКонецЭлемента(); //EventCode
	
	Запись.ЗаписатьНачалоЭлемента("EventDate");
	Запись.ЗаписатьТекст(XMLСтрока(WSПараметр.EventDate));		
	Запись.ЗаписатьКонецЭлемента(); //EventDate
	
	Запись.ЗаписатьНачалоЭлемента("ExternalSystemID");
	Запись.ЗаписатьТекст(XMLСтрока(WSПараметр.ExternalSystemID));		
	Запись.ЗаписатьКонецЭлемента(); //ExternalSystemID
	
	Запись.ЗаписатьКонецЭлемента(); //Event
	Запись.ЗаписатьКонецЭлемента(); //Events
	
	ЗапросXML = Запись.Закрыть();
	
	ОтветВебСервиса = "out";
	
	Попытка
		//Вызываем метод веб-сервиса
		ОтветXML = Прокси.ProcessEvents(
			ЗапросXML,
			ОтветВебСервиса);
	Исключение
		//Сообщить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Подключение к вебсервису 1С:ДО'"),
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Если НЕ ОтветXML = Истина Тогда 
		// ответ не успешен
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Подключение к вебсервису 1С:ДО'"),
			УровеньЖурналаРегистрации.Ошибка,,,
			"При запросе:
			|"+ЗапросXML+"
			|не удалось получить успешный ответ.
			|"+ОтветВебСервиса);
	//Иначе
	//	ТаблицаДанных = ВебСервисы_сервер.УниверсальныйПарсерXML(ОтветВебСервиса, "Event");
	КонецЕсли;
	
КонецПроцедуры
