// ДИТ US 76975 ТА 76977 Сержантова А.С. 15.11.2023
Процедура ИсполнениеЗадачПриИзмеренииПСЦвЗаявке(ЗаявкаОбъект) Экспорт
	
	ЗадачаНаВводПСЦ = ЗаявкаОбъект.Состояния.Найти(Справочники.Состояния.ВводПСЦ);   
	Если ЗадачаНаВводПСЦ = Неопределено Тогда
		Возврат; // нет задачи на ввод ПСЦ
	КонецЕсли;
	
	//Евросиб Коханенко Н.А. 26.02.2025 (( #101467 
	// если указали протокол, то автоматически выполняем задачу по вводу псц
	//Если ЗначениеЗаполнено(ЗаявкаОбъект.ПСЦ) Тогда
	//проверяем все строки ТЧ СоставаУслуг на заполненность ПСЦ 
	ПСЦЗаполнен = (ЗаявкаОбъект.СоставУслуги.Количество() > 0);
	Для Каждого Стр Из ЗаявкаОбъект.СоставУслуги Цикл 
		ПСЦЗаполнен = ПСЦЗаполнен И ЗначениеЗаполнено(Стр.ПСЦ);
	КонецЦикла;
	Если ПСЦЗаполнен Тогда
	//Евросиб Коханенко Н.А. 26.02.2025 )) #101467 
		ЗадачаНаВводПСЦ.Статус = Перечисления.СтатусыЭтапов.Выполнен; 
		ЗадачаНаВводПСЦ.НачалоРаботы = ТекущаяДата();
		ЗадачаНаВводПСЦ.ЗавершениеРаботы = ТекущаяДата();
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Состояние",Справочники.Состояния.ТребуетсяСозданиеПСЦ);
		НайденныеСтроки = ЗаявкаОбъект.Состояния.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество()>0 Тогда
			ИндексУдаляемойСтроки = ЗаявкаОбъект.Состояния.Индекс(НайденныеСтроки[0]);
			ЗаявкаОбъект.Состояния.Удалить(ИндексУдаляемойСтроки);
        КонецЕсли;

	// если убрали протокол, смотрим на предыдущий этап 
	Иначе   
		МассивПредЭтапов = Новый Массив;
		СписокПредЭтапов = ЗадачаНаВводПСЦ.ПредыдущиеЭтапы;
		СписокПредЭтапов = СтрЗаменить(СписокПредЭтапов, ";", ","); СписокПредЭтапов = СтрЗаменить(СписокПредЭтапов, " ", "");
		МассивПредЭтапов = СтрРазделить(СписокПредЭтапов, ",", Ложь);
		
		ЕстьНеВыполненный = Ложь;
		Для каждого ПредЭтап Из МассивПредЭтапов Цикл
			Если ЗаявкаОбъект.Состояния[ПредЭтап-1].Статус <> Перечисления.СтатусыЭтапов.Выполнен Тогда
				ЕстьНеВыполненный = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если ЕстьНеВыполненный Тогда
			ЗадачаНаВводПСЦ.Статус = Перечисления.СтатусыЭтапов.Новый;		
		Иначе
			ЗадачаНаВводПСЦ.Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
		КонецЕсли;	
	КонецЕсли;		

КонецПроцедуры

