	ТЗИзмененныеСтатусы.Колонки.Добавить("НачалоРаботы");
	ТЗИзмененныеСтатусы.Колонки.Добавить("ДатаВозвратаИсполнителю"); 
	ТЗИзмененныеСтатусы.Колонки.Добавить("Понижение"); 
	ТЗИзмененныеСтатусы.Колонки.Добавить("СтатусНовый"); 
	ТЗИзмененныеСтатусы.Колонки.Добавить("РавнозначныеСтатусы"); 
	ТЗИзмененныеСтатусы.Колонки.Добавить("ПодлежитОтправке");
	
	// ДИТ US 60108 TA 65708 Евсенкин М.А. Начало: 17.02.2023
	СтатусыДоЗаписи = Неопределено;
	Источник.ДополнительныеСвойства.Свойство("СтатусыДоЗаписи",СтатусыДоЗаписи);
