Процедура ВыполнитьОтправкуСостоянияВДОПриЗаписи(Источник, Отказ) Экспорт

	// проверим пришел ли документ из 1С:ДО
	ГУИДДокумента = "";

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПротоколОбменов.УИДИсточника КАК УИДИсточника
		|ИЗ
		|	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
		|ГДЕ
		|	ПротоколОбменов.Объект = &Объект
		|	И ПротоколОбменов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных)
		|	И ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.ДО)
		|	И ПротоколОбменов.Объект ССЫЛКА Документ.ПоступлениеТоваровУслуг";
	
	Запрос.УстановитьПараметр("Объект", Источник.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
		ГУИДДокумента = ВыборкаДетальныеЗаписи.УИДИсточника;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ГУИДДокумента) Тогда 
		Возврат;
	КонецЕсли;
	
