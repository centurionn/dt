Функция НайтиГотовыеКВыставлениюСтрокиВСделкахПоПСЦ(Протокол) Экспорт
	Если Не ЗначениеЗаполнено(Протокол) Тогда
		СтруктураРезультата = Новый Структура;
		СтруктураРезультата.Вставить("МассивСделокГотовоКВыставлению", Новый Массив);
		СтруктураРезультата.Вставить("МассивСделокВыставленныеДокументы", Новый Массив);
		СтруктураРезультата.Вставить("АдресТаблицыСделокДляОбработки", ПоместитьВоВременноеХранилище(Неопределено ,Новый УникальныйИдентификатор)); 
		Возврат СтруктураРезультата;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СделкаСвязьУчетныхЕдиниц.Ссылка КАК Ссылка,
	|	СделкаСвязьУчетныхЕдиниц.ГУИД КАК ГУИД,
	|	СделкаСвязьУчетныхЕдиниц.ГотовоКВыставлению КАК ГотовоКВыставлению,
	|	СделкаСвязьУчетныхЕдиниц.ДокументыСформированы КАК ДокументыСформированы
	|ПОМЕСТИТЬ ВТ_СделкиПоПротоколу
	|ИЗ
	|	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|ГДЕ
	|	СделкаСвязьУчетныхЕдиниц.Ссылка.Проведен
	|	И СделкаСвязьУчетныхЕдиниц.Протокол = &Протокол
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_СделкиПоПротоколу.Ссылка.Представление КАК Сделка
	|ИЗ
	|	ВТ_СделкиПоПротоколу КАК ВТ_СделкиПоПротоколу
	|ГДЕ
	|	ВТ_СделкиПоПротоколу.ГотовоКВыставлению
	|	И НЕ ВТ_СделкиПоПротоколу.ДокументыСформированы
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_СделкиПоПротоколу.Ссылка.Представление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_СделкиПоПротоколу.Ссылка.Представление КАК Сделка
	|ИЗ
	|	ВТ_СделкиПоПротоколу КАК ВТ_СделкиПоПротоколу
	|ГДЕ
	|	ВТ_СделкиПоПротоколу.ДокументыСформированы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СделкиПоПротоколу.Ссылка КАК Сделка,
	|	ВТ_СделкиПоПротоколу.ГУИД КАК ГУИД
	|ИЗ
	|	ВТ_СделкиПоПротоколу КАК ВТ_СделкиПоПротоколу
	|ГДЕ
	|	ВТ_СделкиПоПротоколу.ГотовоКВыставлению
	|	И НЕ ВТ_СделкиПоПротоколу.ДокументыСформированы";
	Запрос.УстановитьПараметр("Протокол", Протокол);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	МассивСделокГотовоКВыставлению = РезультатЗапроса[1].Выгрузить().ВыгрузитьКолонку("Сделка");
	МассивСделокВыставленныеДокументы = РезультатЗапроса[2].Выгрузить().ВыгрузитьКолонку("Сделка");
	ТаблицаСделокДляОбработки = РезультатЗапроса[3].Выгрузить();
	СтруктураРезультата = Новый Структура;
	СтруктураРезультата.Вставить("МассивСделокГотовоКВыставлению", МассивСделокГотовоКВыставлению);
	СтруктураРезультата.Вставить("МассивСделокВыставленныеДокументы", МассивСделокВыставленныеДокументы);
	СтруктураРезультата.Вставить("АдресТаблицыСделокДляОбработки", ПоместитьВоВременноеХранилище(ТаблицаСделокДляОбработки,Новый УникальныйИдентификатор));
	Возврат СтруктураРезультата;
	
КонецФункции

//Евросиб Каблов 20.01.2022 62514
Процедура ОбработатьСделкиПоПСЦ(АдресТаблицыСделокДляОбработки) Экспорт
	
	Если АдресТаблицыСделокДляОбработки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаСделокДляОбработки = ПолучитьИзВременногоХранилища(АдресТаблицыСделокДляОбработки);
	СоответствиеОбъектовСделок = Новый Соответствие;
	Для каждого СтрокаДляОбработки Из ТаблицаСделокДляОбработки Цикл
		обСделка = СоответствиеОбъектовСделок.Получить(СтрокаДляОбработки.Сделка);
		Если ОбСделка = Неопределено Тогда
			обСделка = СтрокаДляОбработки.Сделка.ПолучитьОбъект();
			СоответствиеОбъектовСделок.Вставить(СтрокаДляОбработки.Сделка, обСделка);
		КонецЕсли;                                                                   
		СтрокаСУЕ = обСделка.СвязьУчетныхЕдиниц.Найти(СтрокаДляОбработки.ГУИД, "ГУИД");
		СтрокаСУЕ.ГотовоКВыставлению = Ложь;
	КонецЦикла;
	
	Для каждого КлючЗначение Из СоответствиеОбъектовСделок Цикл
		КлючЗначение.Значение.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
	
	АдресТаблицыСделокДляОбработки = Неопределено;               
	
КонецПроцедуры
