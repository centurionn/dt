Функция МаршрутизироватьЗапрос(ПараметрыЗапроса, ДатаДокумента) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Маршрутизация.Ссылка КАК Ссылка,
	               |	Маршрутизация.Организация КАК Организация,
	               |	Маршрутизация.Резидент КАК Резидент,
				   // Евросиб(ДИТ) US 86962 ТА 87365 Сержантова А.С. Начало: 05.09.2024
				   // Было:
				   //|	Маршрутизация.Контрагент КАК Контрагент,
				   //|	Маршрутизация.Договор КАК Договор,
				   //|	Маршрутизация.ВидПеревозки КАК ВидПеревозки,
				   //Стало:
				   |	ЕСТЬNULL(МаршрутизацияКонтрагентыИДоговоры.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Контрагент,
				   |	ЕСТЬNULL(МаршрутизацияКонтрагентыИДоговоры.Договор, ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)) КАК Договор,
				   |	ЕСТЬNULL(МаршрутизацияВидыПеревозок.ВидПеревозки, ЗНАЧЕНИЕ(Справочник.ВидыПеревозок.ПустаяСсылка)) КАК ВидПеревозки,
				   // Евросиб(ДИТ) US 86962 ТА 87365 Сержантова А.С. Конец: 05.09.2024
	               |	Маршрутизация.ИсточникЗапроса КАК ИсточникЗапроса
	               |ИЗ
	               |	Справочник.Маршрутизация КАК Маршрутизация
				   // Евросиб(ДИТ) US 86962 ТА 87365 Сержантова А.С. Начало: 05.09.2024
				   |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Маршрутизация.КонтрагентыИДоговоры КАК МаршрутизацияКонтрагентыИДоговоры
				   |		ПО (МаршрутизацияКонтрагентыИДоговоры.Ссылка = Маршрутизация.Ссылка)
				   |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Маршрутизация.ВидыПеревозок КАК МаршрутизацияВидыПеревозок
				   |		ПО (Маршрутизация.Ссылка = МаршрутизацияВидыПеревозок.Ссылка)
				   // Евросиб(ДИТ) US 86962 ТА 87365 Сержантова А.С. Конец: 05.09.2024
	               |ГДЕ
	               |	НЕ Маршрутизация.ПометкаУдаления
	               |	И Маршрутизация.МаршрутизируемыйОбъект = ЗНАЧЕНИЕ(Перечисление.МаршрутизируемыеОбъекты.ЗапросКлиента)
	               |	И ВЫБОР
	               |			КОГДА Маршрутизация.ОрганизацияПустая
	               |				ТОГДА &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	               |			ИНАЧЕ Маршрутизация.Организация = &Организация
	               |					ИЛИ Маршрутизация.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &Резидент
	               |				ТОГДА Маршрутизация.Резидент
	               |			ИНАЧЕ Маршрутизация.Нерезидент
	               |		КОНЕЦ 
				   // Евросиб(ДИТ) US 86962 ТА 87365 Сержантова А.С. Начало: 05.09.2024
				   // Было: 
				   //|	И ВЫБОР
				   //|			КОГДА Маршрутизация.КонтрагентПустой
				   //|				ТОГДА &Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
				   //|			ИНАЧЕ Маршрутизация.Контрагент = &Контрагент
				   //|					ИЛИ Маршрутизация.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
				   //|		КОНЕЦ
				   //|	И ВЫБОР
				   //|			КОГДА Маршрутизация.ДоговорПустой
				   //|				ТОГДА &Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
				   //|			ИНАЧЕ Маршрутизация.Договор = &Договор
				   //|					ИЛИ Маршрутизация.Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
				   //|		КОНЕЦ
				   //|	И ВЫБОР
				   //|			КОГДА Маршрутизация.ВидПеревозки = ЗНАЧЕНИЕ(Справочник.ВидыПеревозок.ПустаяСсылка)
				   //|				ТОГДА ИСТИНА
				   //|			ИНАЧЕ Маршрутизация.ВидПеревозки = &ВидПеревозки
				   //|		КОНЕЦ
				   //Стало:
				   |	И ВЫБОР
				   |			КОГДА Маршрутизация.КонтрагентПустой
				   |				ТОГДА &Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
				   |			ИНАЧЕ ЕСТЬNULL(МаршрутизацияКонтрагентыИДоговоры.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) = &Контрагент
				   |					ИЛИ ЕСТЬNULL(МаршрутизацияКонтрагентыИДоговоры.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
			       |	КОНЕЦ
				   |	И ВЫБОР
				   |			КОГДА Маршрутизация.ДоговорПустой
				   |				ТОГДА &Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
				   |			ИНАЧЕ ЕСТЬNULL(МаршрутизацияКонтрагентыИДоговоры.Договор, ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)) = &Договор
				   |					ИЛИ ЕСТЬNULL(МаршрутизацияКонтрагентыИДоговоры.Договор, ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
				   |	КОНЕЦ
			       |	И ВЫБОР
				   |			КОГДА ЕСТЬNULL(МаршрутизацияВидыПеревозок.ВидПеревозки, ЗНАЧЕНИЕ(Справочник.ВидыПеревозок.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.ВидыПеревозок.ПустаяСсылка)
				   |				ТОГДА ИСТИНА
				   |			ИНАЧЕ ЕСТЬNULL(МаршрутизацияВидыПеревозок.ВидПеревозки, ЗНАЧЕНИЕ(Справочник.ВидыПеревозок.ПустаяСсылка)) = &ВидПеревозки
				   |	КОНЕЦ
				   // Евросиб(ДИТ) US 86962 ТА 87365 Сержантова А.С. Конец: 05.09.2024
				   |	И ВЫБОР
	               |			КОГДА Маршрутизация.ИсточникЗапроса = ЗНАЧЕНИЕ(Перечисление.ИсточникиЗапросов.ПустаяСсылка)
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ Маршрутизация.ИсточникЗапроса = &ИсточникЗапроса
	               |		КОНЕЦ";
	Запрос.УстановитьПараметр("Контрагент", ПараметрыЗапроса["Контрагент"]);
	Запрос.УстановитьПараметр("Организация", ПараметрыЗапроса["Организация"]);
	Запрос.УстановитьПараметр("Договор", ПараметрыЗапроса["Договор"]);
	Запрос.УстановитьПараметр("ВидПеревозки", ПараметрыЗапроса["ВидПеревозки"]);
	Запрос.УстановитьПараметр("ВидПеревозкиПустой", НЕ ЗначениеЗаполнено(ПараметрыЗапроса["ВидПеревозки"]));
	Запрос.УстановитьПараметр("ИсточникЗапроса", ПараметрыЗапроса["ИсточникЗапроса"]);
	Запрос.УстановитьПараметр("ИсточникЗапросаПустой", НЕ ЗначениеЗаполнено(ПараметрыЗапроса["ИсточникЗапроса"]));
	Запрос.УстановитьПараметр("Резидент", ПараметрыЗапроса["Резидент"]);
	Ответ = Запрос.Выполнить().Выбрать();
	КоличествоСовпаденийМакс = -1;
	ПодходящаяМаршрутизация = Справочники.Маршрутизация.ПустаяСсылка();
	Пока Ответ.Следующий() Цикл
		КоличествоСовпадений = 0;
		
		Если ЗначениеЗаполнено(Ответ["Контрагент"]) Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		Если ЗначениеЗаполнено(Ответ["Организация"]) Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		Если ЗначениеЗаполнено(Ответ["Договор"]) Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		Если ЗначениеЗаполнено(Ответ["ВидПеревозки"]) Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		Если ЗначениеЗаполнено(Ответ["ИсточникЗапроса"]) Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		Если ЗначениеЗаполнено(Ответ["Резидент"]) Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		
		Если КоличествоСовпадений > КоличествоСовпаденийМакс Тогда
			ПодходящаяМаршрутизация = Ответ.Ссылка;
			КоличествоСовпаденийМакс = КоличествоСовпадений;
		КонецЕсли;
	КонецЦикла;
	
	РезультатЗапроса = Новый Массив;
	Для каждого Стр из ПодходящаяМаршрутизация.Состояния Цикл
		Статус = ?(РезультатЗапроса.Количество() = 0, ПодходящаяМаршрутизация.НачальныйСтатус, Перечисления.СтатусыЭтапов.Новый);
		РезультатЗапроса.Добавить(Новый Структура("Состояние, Исполнитель, Наблюдатель, Статус, Ссылка, ПредыдущиеЭтапы, ОРКПоДоговору, ОтветственныйЗаУчет, ОтветственныйЗаДоговор, НормативИсполненияСМоментаСоздания, ТребуетсяУказатьНаблюдателя, ТребуетсяУказатьИсполнителя, ВидНормативаИсполнения,ИсполнительКакРуководительПоНаправлению,НаблюдательКакРуководительПоНаправлению, РуководительСотрудника, ВыбиратьИсполнителяЕслиНеЗаполненРуководительСотрудника", Стр.Состояние, Стр.Исполнитель, Стр.Наблюдатель, Статус, ПодходящаяМаршрутизация, Стр.ПредыдущиеЭтапы, Стр.СопровождениеПоДоговору, Стр.ОтветственныйЗаУчет, Стр.ОтветственныйЗаДоговор, Стр.НормативИсполненияСМоментаСоздания, Стр.ТребуетсяУказатьНаблюдателя, Стр.ТребуетсяУказатьИсполнителя, Стр.ВидНормативаИсполнения,Стр.ИсполнительКакРуководительПоНаправлению,Стр.НаблюдательКакРуководительПоНаправлению, Стр.РуководительСотрудника, Стр.ВыбиратьИсполнителяЕслиНеЗаполненРуководительСотрудника));
	КонецЦикла;
	ОтработатьЗамещениеДелегирование(РезультатЗапроса, Перечисления.МаршрутизируемыеОбъекты.ЗапросКлиента, ДатаДокумента, ПараметрыЗапроса["Договор"]);
	ОтработатьЗамещениеДелегирование(РезультатЗапроса, Перечисления.МаршрутизируемыеОбъекты.ЗапросКлиента, ДатаДокумента, ПараметрыЗапроса["ВидПеревозки"]);
	Возврат РезультатЗапроса;
	
КонецФункции

Функция МаршрутизироватьЗакрытиеПериода(ПараметрыЗапроса, ДатаДокумента) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Маршрутизация.Ссылка КАК Ссылка,
	               |	Маршрутизация.Организация КАК Организация
	               |ИЗ
	               |	Справочник.Маршрутизация КАК Маршрутизация
	               |ГДЕ
	               |	НЕ Маршрутизация.ПометкаУдаления
	               |	И Маршрутизация.МаршрутизируемыйОбъект = ЗНАЧЕНИЕ(Перечисление.МаршрутизируемыеОбъекты.ЗакрытиеПериода)
	               |	И ВЫБОР
	               |			КОГДА Маршрутизация.ОрганизацияПустая
	               |				ТОГДА &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	               |			ИНАЧЕ Маршрутизация.Организация = &Организация
	               |					ИЛИ Маршрутизация.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	               |		КОНЕЦ";
	Запрос.УстановитьПараметр("Организация", ПараметрыЗапроса["Организация"]);
	Ответ = Запрос.Выполнить().Выбрать();
	КоличествоСовпаденийМакс = -1;
	ПодходящаяМаршрутизация = Справочники.Маршрутизация.ПустаяСсылка();
	Пока Ответ.Следующий() Цикл
		КоличествоСовпадений = 0;
		
		Если ЗначениеЗаполнено(Ответ["Организация"]) Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		
		Если КоличествоСовпадений > КоличествоСовпаденийМакс Тогда
			ПодходящаяМаршрутизация = Ответ.Ссылка;
			КоличествоСовпаденийМакс = КоличествоСовпадений;
		КонецЕсли;
	КонецЦикла;
	
	РезультатЗапроса = Новый Массив;
	Для каждого Стр из ПодходящаяМаршрутизация.Состояния Цикл
		Статус = ?(РезультатЗапроса.Количество() = 0, ПодходящаяМаршрутизация.НачальныйСтатус, Перечисления.СтатусыЭтапов.Новый);
		РезультатЗапроса.Добавить(Новый Структура("Состояние, Исполнитель, Наблюдатель, Статус, Ссылка, ПредыдущиеЭтапы, ОРКПоДоговору, ОтветственныйЗаУчет, ОтветственныйЗаДоговор, НормативИсполненияСМоментаСоздания, ТребуетсяУказатьНаблюдателя, ТребуетсяУказатьИсполнителя, ВидНормативаИсполнения, РуководительСотрудника, ВыбиратьИсполнителяЕслиНеЗаполненРуководительСотрудника", Стр.Состояние, Стр.Исполнитель, Стр.Наблюдатель, Статус, ПодходящаяМаршрутизация, Стр.ПредыдущиеЭтапы, Стр.СопровождениеПоДоговору, Стр.ОтветственныйЗаУчет, Стр.ОтветственныйЗаДоговор, Стр.НормативИсполненияСМоментаСоздания, Стр.ТребуетсяУказатьНаблюдателя, Стр.ТребуетсяУказатьИсполнителя, Стр.ВидНормативаИсполнения, Стр.РуководительСотрудника, Стр.ВыбиратьИсполнителяЕслиНеЗаполненРуководительСотрудника));
	КонецЦикла;
	ОтработатьЗамещениеДелегирование(РезультатЗапроса, Перечисления.МаршрутизируемыеОбъекты.ЗакрытиеПериода, ДатаДокумента, ПараметрыЗапроса["Договор"]);
	Возврат РезультатЗапроса;
	
КонецФункции

