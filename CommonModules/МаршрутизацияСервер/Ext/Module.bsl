	Для каждого Стр из ПодходящаяМаршрутизация.Состояния Цикл
		Статус = ?(РезультатЗапроса.Количество() = 0, ПодходящаяМаршрутизация.НачальныйСтатус, Перечисления.СтатусыЭтапов.Новый);
		РезультатЗапроса.Добавить(Новый Структура("Состояние, Исполнитель, Наблюдатель, Статус, Ссылка, ПредыдущиеЭтапы, ОРКПоДоговору, ОтветственныйЗаУчет, ОтветственныйЗаДоговор, НормативИсполненияСМоментаСоздания, ТребуетсяУказатьНаблюдателя, ТребуетсяУказатьИсполнителя, ВидНормативаИсполнения,ИсполнительКакРуководительПоНаправлению,НаблюдательКакРуководительПоНаправлению, ОтветственныйМенеджерПСЦ, РуководительСотрудника, ВыбиратьИсполнителяЕслиНеЗаполненРуководительСотрудника", Стр.Состояние, Стр.Исполнитель, Стр.Наблюдатель, Статус, ПодходящаяМаршрутизация, Стр.ПредыдущиеЭтапы, Стр.СопровождениеПоДоговору, Стр.ОтветственныйЗаУчет, Стр.ОтветственныйЗаДоговор, Стр.НормативИсполненияСМоментаСоздания, Стр.ТребуетсяУказатьНаблюдателя, Стр.ТребуетсяУказатьИсполнителя, Стр.ВидНормативаИсполнения,Стр.ИсполнительКакРуководительПоНаправлению,Стр.НаблюдательКакРуководительПоНаправлению, Стр.ОтветственныйМенеджерПСЦ, Стр.РуководительСотрудника, Стр.ВыбиратьИсполнителяЕслиНеЗаполненРуководительСотрудника));
	КонецЦикла;
	
	Возврат РезультатЗапроса;
	
КонецФункции

Функция МаршрутизироватьДоговор(ПараметрыЗапроса, ДатаДокумента) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Маршрутизация.Ссылка КАК Ссылка,
				   // Евросиб(ДИТ) US 86962 ТА 87365 Сержантова А.С. Начало: 05.09.2024
				   // Было:
				   //|	Маршрутизация.Контрагент КАК Контрагент, 
				   //Стало:
				   |	ЕСТЬNULL(МаршрутизацияКонтрагентыИДоговоры.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Контрагент,
				   // Евросиб(ДИТ) US 86962 ТА 87365 Сержантова А.С. Конец: 05.09.2024
	               |	Маршрутизация.Организация КАК Организация,
	               |	Маршрутизация.КатегорияДоговора КАК КатегорияДоговора,
	               |	Маршрутизация.ТипДоговорнойЗаписи КАК ТипДоговорнойЗаписи,
	               |	Маршрутизация.ВидДоговора КАК ВидДоговора,
	               |	Маршрутизация.Валюта КАК Валюта,
	               |	Маршрутизация.Нетиповой КАК Нетиповой,
	               |	Маршрутизация.Нерезидент КАК Нерезидент,
	               |	Маршрутизация.ЦФО КАК ЦФО,
	               |	Маршрутизация.РегионДоговора КАК РегионДоговора,
	               |	Маршрутизация.УсловиеОплаты КАК УсловиеОплаты,
	               |	Маршрутизация.Подписан КАК Подписан
	               |ИЗ
	               |	Справочник.Маршрутизация КАК Маршрутизация 
				   // Евросиб(ДИТ) US 86962 ТА 87365 Сержантова А.С. Начало: 05.09.2024
				   |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Маршрутизация.КонтрагентыИДоговоры КАК МаршрутизацияКонтрагентыИДоговоры
				   |		ПО (Маршрутизация.Ссылка = МаршрутизацияКонтрагентыИДоговоры.Ссылка)
				   // Евросиб(ДИТ) US 86962 ТА 87365 Сержантова А.С. Конец: 05.09.2024
	               |ГДЕ
	               |	НЕ Маршрутизация.ПометкаУдаления
	               |	И Маршрутизация.МаршрутизируемыйОбъект = ЗНАЧЕНИЕ(Перечисление.МаршрутизируемыеОбъекты.Договор)
				   // Евросиб(ДИТ) US 86962 ТА 87365 Сержантова А.С. Начало: 05.09.2024
				   // Было:
				   //|	И ВЫБОР
				   //|			КОГДА Маршрутизация.КонтрагентПустой
				   //|				ТОГДА &Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
				   //|			ИНАЧЕ Маршрутизация.Контрагент = &Контрагент
				   //|					ИЛИ Маршрутизация.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
				   //|		КОНЕЦ 
				   //Стало:
				   |	И ВЫБОР
				   |			КОГДА Маршрутизация.КонтрагентПустой
				   |				ТОГДА &Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
				   |			ИНАЧЕ ЕСТЬNULL(МаршрутизацияКонтрагентыИДоговоры.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) = &Контрагент
				   |					ИЛИ ЕСТЬNULL(МаршрутизацияКонтрагентыИДоговоры.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
				   |		КОНЕЦ
				   // Евросиб(ДИТ) US 86962 ТА 87365 Сержантова А.С. Конец: 05.09.2024
	               |	И ВЫБОР
	               |			КОГДА Маршрутизация.ОрганизацияПустая
	               |				ТОГДА &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	               |			ИНАЧЕ Маршрутизация.Организация = &Организация
	               |					ИЛИ Маршрутизация.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА Маршрутизация.ЦФОПустой
	               |				ТОГДА &Организация = ЗНАЧЕНИЕ(Справочник.ЦентрыФинансовойОтветственности.ПустаяСсылка)
	               |			ИНАЧЕ Маршрутизация.ЦФО = &ЦФО
	               |					ИЛИ Маршрутизация.ЦФО = ЗНАЧЕНИЕ(Справочник.ЦентрыФинансовойОтветственности.ПустаяСсылка)
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &Нерезидент
	               |				ТОГДА Маршрутизация.Нерезидент
	               |			ИНАЧЕ Маршрутизация.Резидент
	               |		КОНЕЦ
	               |	И (Маршрутизация.КатегорияДоговора = &КатегорияДоговора
	               |			ИЛИ Маршрутизация.КатегорияДоговора = ЗНАЧЕНИЕ(Справочник.КатегорииДоговоров.ПустаяСсылка))
	               |	И ВЫБОР
	               |			КОГДА &Нетиповой
	               |				ТОГДА Маршрутизация.Нетиповой
	               |			ИНАЧЕ Маршрутизация.Типовой
	               |		КОНЕЦ
	               |	И (Маршрутизация.ВидДоговора = &ВидДоговора
	               |			ИЛИ Маршрутизация.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.ПустаяСсылка))
	               |	И (Маршрутизация.ТипДоговорнойЗаписи = &ТипДоговорнойЗаписи
	               |			ИЛИ Маршрутизация.ТипДоговорнойЗаписи = ЗНАЧЕНИЕ(Перечисление.ТипДоговорнойЗаписи.ПустаяСсылка))
	               |	И (Маршрутизация.РегионДоговора = &РегионДоговора
	               |			ИЛИ Маршрутизация.РегионДоговора = ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка))
	               |	И (Маршрутизация.Валюта = &Валюта
	               |			ИЛИ Маршрутизация.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка))";
	Запрос.УстановитьПараметр("Контрагент", ПараметрыЗапроса["Контрагент"]);
	Запрос.УстановитьПараметр("Организация", ПараметрыЗапроса["Организация"]);
	Запрос.УстановитьПараметр("Нерезидент", ПараметрыЗапроса["Нерезидент"]);
	Запрос.УстановитьПараметр("КатегорияДоговора", ПараметрыЗапроса["КатегорияДоговора"]);
	Запрос.УстановитьПараметр("Нетиповой", ПараметрыЗапроса["Нетиповой"]);
	Запрос.УстановитьПараметр("ЦФО", ПараметрыЗапроса["ЦФО"]);
	Запрос.УстановитьПараметр("ВидДоговора", ПараметрыЗапроса["ВидДоговора"]);
	Запрос.УстановитьПараметр("ТипДоговорнойЗаписи", ПараметрыЗапроса["ТипДоговорнойЗаписи"]);
	Запрос.УстановитьПараметр("РегионДоговора", ПараметрыЗапроса["РегионДоговора"]);
	Запрос.УстановитьПараметр("Валюта", ПараметрыЗапроса["Валюта"]);
	Запрос.УстановитьПараметр("УсловиеОплаты", ПараметрыЗапроса["УсловиеОплаты"]);
	Запрос.УстановитьПараметр("Подписан", ПараметрыЗапроса["Подписан"]);
	
	Ответ = Запрос.Выполнить().Выбрать();
	КоличествоСовпаденийМакс = -1;
	ПодходящаяМаршрутизация = Справочники.Маршрутизация.ПустаяСсылка();
	Пока Ответ.Следующий() Цикл
		КоличествоСовпадений = 0;
		
		Если ЗначениеЗаполнено(Ответ["Контрагент"]) Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		Если ЗначениеЗаполнено(Ответ["Организация"]) Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		
		Если ЗначениеЗаполнено(Ответ["КатегорияДоговора"]) Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		Если ЗначениеЗаполнено(Ответ["ВидДоговора"]) Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		Если ЗначениеЗаполнено(Ответ["ТипДоговорнойЗаписи"]) Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		Если ЗначениеЗаполнено(Ответ["РегионДоговора"]) Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		Если ЗначениеЗаполнено(Ответ["Валюта"]) Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		Если Ответ["Нетиповой"] = ПараметрыЗапроса["Нетиповой"] Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		Если Ответ["Нерезидент"] = ПараметрыЗапроса["Нерезидент"] Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		
		Если КоличествоСовпадений > КоличествоСовпаденийМакс Тогда
			ПодходящаяМаршрутизация = Ответ.Ссылка;
			КоличествоСовпаденийМакс = КоличествоСовпадений;
		КонецЕсли;
	КонецЦикла;
	
	РезультатЗапроса = Новый Массив;
	Для каждого Стр из ПодходящаяМаршрутизация.Состояния Цикл
		Статус = ?(РезультатЗапроса.Количество() = 0, ПодходящаяМаршрутизация.НачальныйСтатус, Перечисления.СтатусыЭтапов.Новый);
		
		РезультатЗапроса.Добавить(Новый Структура("Состояние, Исполнитель, Наблюдатель, Статус, Ссылка, ПредыдущиеЭтапы, ОРКПоДоговору, ОтветственныйЗаУчет, ОтветственныйЗаДоговор, НормативИсполненияСМоментаСоздания, ТребуетсяУказатьНаблюдателя, ТребуетсяУказатьИсполнителя, ВидНормативаИсполнения, НаблюдательКакРуководительИсполнителя, РуководительСотрудника, ВыбиратьИсполнителяЕслиНеЗаполненРуководительСотрудника", Стр.Состояние, Стр.Исполнитель, Стр.Наблюдатель, Статус, ПодходящаяМаршрутизация, Стр.ПредыдущиеЭтапы, Стр.СопровождениеПоДоговору, Стр.ОтветственныйЗаУчет, Стр.ОтветственныйЗаДоговор, Стр.НормативИсполненияСМоментаСоздания, Стр.ТребуетсяУказатьНаблюдателя, Стр.ТребуетсяУказатьИсполнителя, Стр.ВидНормативаИсполнения, Стр.НаблюдательКакРуководительИсполнителя, Стр.РуководительСотрудника, Стр.ВыбиратьИсполнителяЕслиНеЗаполненРуководительСотрудника));
	КонецЦикла;
	ОтработатьЗамещениеДелегирование(РезультатЗапроса, Перечисления.МаршрутизируемыеОбъекты.Договор, ДатаДокумента, ПараметрыЗапроса["Договор"]);
	Возврат РезультатЗапроса;
	
КонецФункции

Функция МаршрутизироватьПроект(ПараметрыЗапроса, ДатаДокумента) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Маршрутизация.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Маршрутизация КАК Маршрутизация
	               |ГДЕ
	               |	НЕ Маршрутизация.ПометкаУдаления
	               |	И Маршрутизация.МаршрутизируемыйОбъект = ЗНАЧЕНИЕ(Перечисление.МаршрутизируемыеОбъекты.Проект)";
	Ответ = Запрос.Выполнить().Выбрать();
	КоличествоСовпаденийМакс = -1;
	ПодходящаяМаршрутизация = Справочники.Маршрутизация.ПустаяСсылка();
	Пока Ответ.Следующий() Цикл
		КоличествоСовпадений = 0;
		
		КоличествоСовпадений = КоличествоСовпадений + 1;
		
		Если КоличествоСовпадений > КоличествоСовпаденийМакс Тогда
			ПодходящаяМаршрутизация = Ответ.Ссылка;
			КоличествоСовпаденийМакс = КоличествоСовпадений;
		КонецЕсли;
	КонецЦикла;
	
	РезультатЗапроса = Новый Массив;
	Для каждого Стр из ПодходящаяМаршрутизация.Состояния Цикл
		Статус = ?(РезультатЗапроса.Количество() = 0, ПодходящаяМаршрутизация.НачальныйСтатус, Перечисления.СтатусыЭтапов.Новый);
		РезультатЗапроса.Добавить(Новый Структура("Состояние, Исполнитель, Наблюдатель, Статус, Ссылка, ПредыдущиеЭтапы, ОРКПоДоговору, ОтветственныйЗаУчет, ОтветственныйЗаДоговор, НормативИсполненияСМоментаСоздания, ТребуетсяУказатьНаблюдателя, ТребуетсяУказатьИсполнителя, ВидНормативаИсполнения, НаблюдательКакРуководительИсполнителя, РуководительСотрудника, ВыбиратьИсполнителяЕслиНеЗаполненРуководительСотрудника", Стр.Состояние, Стр.Исполнитель, Стр.Наблюдатель, Статус, ПодходящаяМаршрутизация, Стр.ПредыдущиеЭтапы, Стр.СопровождениеПоДоговору, Стр.ОтветственныйЗаУчет, Стр.ОтветственныйЗаДоговор, Стр.НормативИсполненияСМоментаСоздания, Стр.ТребуетсяУказатьНаблюдателя, Стр.ТребуетсяУказатьИсполнителя, Стр.ВидНормативаИсполнения, Стр.НаблюдательКакРуководительИсполнителя, Стр.РуководительСотрудника, Стр.ВыбиратьИсполнителяЕслиНеЗаполненРуководительСотрудника));
	КонецЦикла;
	ОтработатьЗамещениеДелегирование(РезультатЗапроса, Перечисления.МаршрутизируемыеОбъекты.Сделка, ДатаДокумента, ПараметрыЗапроса["Договор"]);
	Возврат РезультатЗапроса;
	
КонецФункции

