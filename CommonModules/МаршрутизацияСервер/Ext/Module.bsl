//ДИТ Авдеева В.С. 47090 11.04.2022 Начало
Процедура УстановитьВыполнениеЗафиксировано(Источник) Экспорт  
	//ДИТ, Беляев СЮ, Ticket#0290209, 27-10-2022, начало
	МетаданныеИсточника = Источник.Метаданные();
	Если МетаданныеИсточника.Реквизиты.Найти("ПримененныйМаршрут") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	//ДИТ, Беляев СЮ, Ticket#0290209, 27-10-2022, конец
	
	СсылкаНаОбъект = Источник.Ссылка;
	
	//Евросиб Каблов 13.01.2022 ( 62514
	//Если Источник.ПримененныйМаршрут <> СсылкаНаОбъект.ПримененныйМаршрут Тогда
	//	Возврат;
	//КонецЕсли;
	ПрименениеМаршрута = Источник.ДополнительныеСвойства.Свойство("ПрименениеМаршрута");
	Если ПрименениеМаршрута Тогда
		Источник.ДополнительныеСвойства.Удалить("ПрименениеМаршрута");
		Возврат;
	КонецЕсли;
	
	Если Источник.ПримененныйМаршрут <> СсылкаНаОбъект.ПримененныйМаршрут И Не Источник.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	//Евросиб Каблов 13.01.2022 )
		 
	
	Запрос = Новый Запрос;
	//Евросиб Каблов 13.01.2022 ( 62514
	//Запрос.Текст = 
	//"ВЫБРАТЬ
	//|	ТаблицаСостояний.Состояние КАК Состояние,
	//|	ТаблицаСостояний.Статус КАК Статус,
	//|	Состояния.ВариантПерезапуска КАК ВариантПерезапуска,
	//|	Состояния.ПроверяемыеПараметры КАК ПроверяемыеПараметры
	//|ИЗ
	//|	Справочник.ДоговорыКонтрагентов.Состояния КАК ТаблицаСостояний
	//|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Состояния КАК Состояния
	//|		ПО ТаблицаСостояний.Состояние = Состояния.Ссылка
	//|ГДЕ
	//|	ТаблицаСостояний.Ссылка = &Ссылка";         
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СостоянияВОбъекте.Состояние КАК Состояние,
	|	СостоянияВОбъекте.Статус КАК Статус
	|ПОМЕСТИТЬ ВТСостоянияВОбъекте
	|ИЗ
	|	&ТЗСостоянияВОбъекте КАК СостоянияВОбъекте
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаСостояний.Состояние КАК Состояние,
	|	ТаблицаСостояний.Статус КАК Статус,
	|	Состояния.ВариантПерезапуска КАК ВариантПерезапуска,
	|	Состояния.ПроверяемыеПараметры КАК ПроверяемыеПараметры
	|ПОМЕСТИТЬ ЗаписанныеСостояния
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов.Состояния КАК ТаблицаСостояний
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Состояния КАК Состояния
	|		ПО ТаблицаСостояний.Состояние = Состояния.Ссылка
	|ГДЕ
	|	ТаблицаСостояний.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Состояния.Ссылка КАК Состояние,
	|	ВТСостоянияВОбъекте.Статус КАК Статус,
	|	Состояния.ВариантПерезапуска КАК ВариантПерезапуска,
	|	Состояния.ПроверяемыеПараметры КАК ПроверяемыеПараметры
	|ПОМЕСТИТЬ СостоянияВОбъекте
	|ИЗ
	|	ВТСостоянияВОбъекте КАК ВТСостоянияВОбъекте
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Состояния КАК Состояния
	|		ПО ВТСостоянияВОбъекте.Состояние = Состояния.Ссылка
	|ГДЕ
	|	Состояния.ВариантПерезапуска = &НикогдаНеПерезапускать
	|	И ВТСостоянияВОбъекте.Статус = &Выполнено
	|	И НЕ ВТСостоянияВОбъекте.Состояние В
	|				(ВЫБРАТЬ
	|					ЗаписанныеСостояния.Состояние КАК Состояние
	|				ИЗ
	|					ЗаписанныеСостояния КАК ЗаписанныеСостояния
	|				ГДЕ
	|					ЗаписанныеСостояния.Статус <> &Выполнено
	|					И ЗаписанныеСостояния.Состояние.ВариантПерезапуска = &НикогдаНеПерезапускать)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаписанныеСостояния.Состояние КАК Состояние,
	|	ЗаписанныеСостояния.Статус КАК Статус,
	|	ЗаписанныеСостояния.ВариантПерезапуска КАК ВариантПерезапуска,
	|	ЗаписанныеСостояния.ПроверяемыеПараметры КАК ПроверяемыеПараметры
	|ИЗ
	|	ЗаписанныеСостояния КАК ЗаписанныеСостояния
	|ГДЕ
	|	НЕ ЗаписанныеСостояния.Состояние В
	|				(ВЫБРАТЬ
	|					СостоянияВОбъекте.Состояние КАК Состояние
	|				ИЗ
	|					СостоянияВОбъекте КАК СостоянияВОбъекте)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СостоянияВОбъекте.Состояние,
	|	СостоянияВОбъекте.Статус,
	|	СостоянияВОбъекте.ВариантПерезапуска,
	|	СостоянияВОбъекте.ПроверяемыеПараметры
	|ИЗ
	|	СостоянияВОбъекте КАК СостоянияВОбъекте";
	
	Запрос.УстановитьПараметр("ТЗСостоянияВОбъекте", Источник.Состояния.Выгрузить());
	Запрос.УстановитьПараметр("НикогдаНеПерезапускать", Перечисления.ВариантыПерезапускаЗадачи.НикогдаНеПерезапускать);
	Запрос.УстановитьПараметр("Выполнено", Перечисления.СтатусыЭтапов.Выполнен);
	
	ВозвращаемыеЗадачи = Неопределено;
	Если Не Источник.ДополнительныеСвойства.Свойство("ВозвращаемыеЗадачи", ВозвращаемыеЗадачи) Тогда
		ВозвращаемыеЗадачи = Новый Массив;
	КонецЕсли;
	//Евросиб Каблов 13.01.2022 )
	
	ПолноеИмяОбъекта = СсылкаНаОбъект.Метаданные().ПолноеИмя();

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник.ДоговорыКонтрагентов", ПолноеИмяОбъекта);
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);

	СтатусВыполнен = Перечисления.СтатусыЭтапов.Выполнен;
	
	ТЗСостоянийВБазе = Запрос.Выполнить().Выгрузить(); 
	
	Для Каждого Стр Из Источник.Состояния Цикл
		
		//Евросиб Каблов 13.01.2022 ( 62514
		Если ВозвращаемыеЗадачи.Найти(Стр.Состояние) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		//Евросиб Каблов 13.01.2022 )
		
		Отбор = Новый Структура("Состояние", Стр.Состояние);  
		
		НайденныеСтроки = ТЗСостоянийВБазе.НайтиСтроки(Отбор);
		
		Если Не ЗначениеЗаполнено(НайденныеСтроки) Тогда
			Продолжить;
		КонецЕсли;    
		
		СтрокаСостоянияВБазе = НайденныеСтроки[0];  
		
		Если Не (СтрокаСостоянияВБазе.Статус = СтатусВыполнен 
			Или Стр.Статус = СтатусВыполнен) Тогда
			Продолжить;
		КонецЕсли;
		
		ВариантПерезапуска = СтрокаСостоянияВБазе.ВариантПерезапуска;  
		
		ВыполнениеЗафиксировано = Ложь; 
		ТекстШаблона = "";   
		ДобавитьНе = Ложь;
		
		Если ВариантПерезапуска = Перечисления.ВариантыПерезапускаЗадачи.НикогдаНеПерезапускать Тогда
			ВыполнениеЗафиксировано = Истина;
		ИначеЕсли ВариантПерезапуска = Перечисления.ВариантыПерезапускаЗадачи.ПерезапускатьПриИзмененииПараметров Тогда 
			ТекстШаблона = "Источник.%1 <> СсылкаНаОбъект.%1";	  
			ДобавитьНе = Истина;
		ИначеЕсли ВариантПерезапуска = Перечисления.ВариантыПерезапускаЗадачи.ПерезапускатьПриНезаполненныхПараметрах Тогда 
			ТекстШаблона = "ЗначениеЗаполнено(Источник.%1)";	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекстШаблона) Тогда
			
			РазделительИ = ";";
			РазделительИли = "/";
			Операция = "";
			ИтоговоеУсловие = "";
			
			ПроверяемыеПараметры = СокрЛП(СтрокаСостоянияВБазе.ПроверяемыеПараметры);
			ПозицияИ = СтрНайти(ПроверяемыеПараметры, РазделительИ);
			ПозицияИли = СтрНайти(ПроверяемыеПараметры, РазделительИли); 
			
			Если ЗначениеЗаполнено(ПозицияИ) И ЗначениеЗаполнено(ПозицияИли) Тогда 
				Позиция = Мин(ПозицияИ, ПозицияИли);
			Иначе
				Позиция = Макс(ПозицияИ, ПозицияИли);
			КонецЕсли; 
			
			Пока Позиция > 0 Цикл
				Подстрока = СокрЛП(Лев(ПроверяемыеПараметры, Позиция - 1));        
				
				Если ЗначениеЗаполнено(Подстрока) Тогда 
					Условие = СтрШаблон(ТекстШаблона, Подстрока);
					ИтоговоеУсловие = ИтоговоеУсловие + Операция + Условие;     
				КонецЕсли;
				Операция = ?(ПозицияИ = Позиция, " И ", " ИЛИ "); 

				ПроверяемыеПараметры = Сред(ПроверяемыеПараметры, Позиция + 1);
				ПозицияИ = СтрНайти(ПроверяемыеПараметры, РазделительИ);
				ПозицияИли = СтрНайти(ПроверяемыеПараметры, РазделительИли); 
				Если ЗначениеЗаполнено(ПозицияИ) И ЗначениеЗаполнено(ПозицияИли) Тогда 
					Позиция = Мин(ПозицияИ, ПозицияИли);
				Иначе
					Позиция = Макс(ПозицияИ, ПозицияИли);
				КонецЕсли;

			КонецЦикла;    
			
			Если Позиция = 0 Тогда
				ИтоговоеУсловие = ИтоговоеУсловие + Операция + СтрШаблон(ТекстШаблона, ПроверяемыеПараметры);
			КонецЕсли;
			
			// ДИТ US 51951 TA 61497 Евсенкин М.А. Начало: 15.12.2022
		    // !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
			// Решение временное, согласовано с Яной Гудковой 15.12.2022г.
			// т.к. механизм изначально не предусматривает проверку табличных частей.
			// На текущий момент нет необходимости проверять табличные части других 
			// объектов, кроме как в договорах ТЧ "Ответственные".
			// Возможно в дальнейшем будет развитие механизма.
			// !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
			Если ТипЗнч(Источник) = Тип("СправочникОбъект.ДоговорыКонтрагентов")  
				Или ТипЗнч(Источник) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда // при необходимости, для совместимости будет изменена переменная "ИтоговоеУсловие"
				МассивВозможныхПолей = Новый Массив;
				МассивВозможныхПолей.Добавить("ОтветственныйЗаСопровождениеНСК");
				МассивВозможныхПолей.Добавить("ОтветственныйЗаУчетНСК");
				МассивВозможныхПолей.Добавить("ОтветственныйЗаСопровождение");
				МассивВозможныхПолей.Добавить("ОтветственныйЗаУчет");
				
				ОсновнойЦФО 					= Справочники.ЦентрыФинансовойОтветственности.ОсновнойЦФО;
				ТерминалНовосибирск 			= Справочники.ЦентрыФинансовойОтветственности.ТерминалНовосибирск;	
				ОтветственныйЗаУчет 			= Перечисления.ТипыОтветственных.ОтветственныйЗаУчет;
				ОтветственныйЗаСопровождение 	= Перечисления.ТипыОтветственных.ОтветственныйЗаСопровождение;
				
				Для Каждого СтрМассивВозможныхПолей Из МассивВозможныхПолей Цикл  
					Если СтрНайти(ИтоговоеУсловие,СтрМассивВозможныхПолей) <> 0 Тогда
						Если СтрМассивВозможныхПолей = "ОтветственныйЗаУчет" Тогда 
							ЦФО = ОсновнойЦФО;
							ТипОтветственного = ОтветственныйЗаУчет;
						ИначеЕсли СтрМассивВозможныхПолей = "ОтветственныйЗаУчетНСК" Тогда 
							ЦФО = ТерминалНовосибирск;
							ТипОтветственного = ОтветственныйЗаУчет; 
						ИначеЕсли СтрМассивВозможныхПолей = "ОтветственныйЗаСопровождение" Тогда
							ЦФО = ОсновнойЦФО;
                            ТипОтветственного = ОтветственныйЗаСопровождение; 
						ИначеЕсли СтрМассивВозможныхПолей = "ОтветственныйЗаСопровождениеНСК" Тогда
							ЦФО = ТерминалНовосибирск;
							ТипОтветственного = ОтветственныйЗаСопровождение; 
						КонецЕсли;	 
						Отбор = Новый Структура("Договор,ЦФО,ТипОтветственного",Источник,ЦФО,ТипОтветственного);
						СтрокаДляЗамены = ЗначениеЗаполнено(Справочники.ДоговорыКонтрагентов.ПолучитьОтветственного(Отбор));
						ИтоговоеУсловие = СтрЗаменить(ИтоговоеУсловие,СтрШаблон("ЗначениеЗаполнено(Источник.%1)",СтрМассивВозможныхПолей),Формат(СтрокаДляЗамены,"БЛ=Ложь; БИ=Истина"));
					КонецЕсли;
				КонецЦикла;	
			КонецЕсли;	
			// ДИТ US 51951 TA 61497 Евсенкин М.А. Конец: 15.12.2022
			
			Если ЗначениеЗаполнено(ИтоговоеУсловие) Тогда      
				ВыполнениеЗафиксировано = Вычислить(ИтоговоеУсловие);
				Если ДобавитьНе Тогда 
					ВыполнениеЗафиксировано = Не ВыполнениеЗафиксировано;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли; 
		
		Стр.ВыполнениеЗафиксировано = ВыполнениеЗафиксировано;
		
	КонецЦикла;	

КонецПроцедуры //ДИТ Авдеева В.С. 47090 11.04.2022 Конец  

//ДИТ Авдеева В.С. 47090 11.04.2022 Начало
Процедура ПостобработкаВыполненныхЗадач(Источник) Экспорт  
	//ДИТ, Беляев СЮ, Ticket#0290209, 27-10-2022, начало
	МетаданныеИсточника = Источник.Метаданные();
	Если МетаданныеИсточника.Реквизиты.Найти("ПримененныйМаршрут") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	//ДИТ, Беляев СЮ, Ticket#0290209, 27-10-2022, конец
	
	СсылкаНаОбъект = Источник.Ссылка;

	Если Источник.ПримененныйМаршрут <> СсылкаНаОбъект.ПримененныйМаршрут Тогда       
		Возврат;
	КонецЕсли; 

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаСостояний.Состояние КАК Состояние,
	|	ТаблицаСостояний.Статус КАК Статус,
	|	ТаблицаСостояний.ВыполнениеЗафиксировано КАК ВыполнениеЗафиксировано
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов.Состояния КАК ТаблицаСостояний
	|ГДЕ
	|	ТаблицаСостояний.Ссылка = &Ссылка
	|	И ТаблицаСостояний.Статус = &Статус";         
	
	ПолноеИмяОбъекта = СсылкаНаОбъект.Метаданные().ПолноеИмя();

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник.ДоговорыКонтрагентов", ПолноеИмяОбъекта);
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыЭтапов.Выполнен);
	
	ТЗСостоянийВБазе = Запрос.Выполнить().Выгрузить();  
	
	ПерваяСтрока = Истина;           
	
	УстановитьСледСтрокеСтатус = Перечисления.СтатусыЭтапов.ПустаяСсылка();
	
	Для Каждого Стр Из Источник.Состояния Цикл  
		
		Отбор = Новый Структура("Состояние", Стр.Состояние);  
		
		НайденныеСтроки = ТЗСостоянийВБазе.НайтиСтроки(Отбор);
		
		Если ЗначениеЗаполнено(НайденныеСтроки) 
			И Стр.ВыполнениеЗафиксировано Тогда
			СтрокаСостоянияВБазе = НайденныеСтроки[0]; 
			
			Если Стр.Статус <> СтрокаСостоянияВБазе.Статус И ПерваяСтрока Тогда 
				УстановитьСледСтрокеСтатус = Стр.Статус; 
			КонецЕсли;
			ПерваяСтрока = Ложь;  
			
			Стр.Статус = СтрокаСостоянияВБазе.Статус;
			Стр.ВыполнениеЗафиксировано = Истина;
			
		Иначе
			Если ЗначениеЗаполнено(УстановитьСледСтрокеСтатус)  Тогда  
				Стр.Статус = УстановитьСледСтрокеСтатус;     
				УстановитьСледСтрокеСтатус = Перечисления.СтатусыЭтапов.ПустаяСсылка(); 
			КонецЕсли;
		КонецЕсли;    
		
		
	КонецЦикла;	

	
КонецПроцедуры //ДИТ Авдеева В.С. 47090 11.04.2022 Конец

//Евросиб Каблов 11.04.2022 Task 45430 
Процедура ОтметитьВыполнениеЗадач(Объект, ЗадачиДляОтметкиВыполнения = Неопределено) Экспорт
	
	СтатусВыполнен = Перечисления.СтатусыЭтапов.Выполнен;
	СтатусОтклонен = Перечисления.СтатусыЭтапов.Отклонен;
	
	ДатаВыполнения = ТекущаяДата();
	
	Если ЗадачиДляОтметкиВыполнения = Неопределено Тогда
		Для Каждого СтрокаТЧ Из Объект.Состояния Цикл
			Если СтрокаТЧ.Статус <> СтатусВыполнен И СтрокаТЧ.Статус <> СтатусОтклонен Тогда
				СтрокаТЧ.Статус = СтатусВыполнен;
				СтрокаТЧ.ЗавершениеРаботы = ДатаВыполнения;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого СтрокаТЧ Из Объект.Состояния Цикл
			Если ЗадачиДляОтметкиВыполнения.Найти(СтрокаТЧ.Состояние) <> Неопределено И СтрокаТЧ.Статус <> СтатусВыполнен И СтрокаТЧ.Статус <> СтатусОтклонен Тогда
				СтрокаТЧ.Статус = СтатусВыполнен;
				СтрокаТЧ.ЗавершениеРаботы = ДатаВыполнения;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры
//)
