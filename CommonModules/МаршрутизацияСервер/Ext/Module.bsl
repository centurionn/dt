Функция МаршрутизироватьТД(ПараметрыЗапроса, ДатаДокумента) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Маршрутизация.Ссылка КАК Ссылка, 
				   // Евросиб(ДИТ) US 86962 ТА 87365 Сержантова А.С. Начало: 05.09.2024
				   // Было:
				   //|	Маршрутизация.Договор КАК Договор, 
				   //|	Маршрутизация.Контрагент КАК Контрагент,
				   //Стало:
				   |	ЕСТЬNULL(МаршрутизацияКонтрагентыИДоговоры.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Контрагент,
				   |	ЕСТЬNULL(МаршрутизацияКонтрагентыИДоговоры.Договор, ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)) КАК Договор,
				   // Евросиб(ДИТ) US 86962 ТА 87365 Сержантова А.С. Конец: 05.09.2024
	               |	Маршрутизация.Организация КАК Организация
	               |ИЗ
	               |	Справочник.Маршрутизация КАК Маршрутизация 
				   // Евросиб(ДИТ) US 86962 ТА 87365 Сержантова А.С. Начало: 05.09.2024
				   |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Маршрутизация.КонтрагентыИДоговоры КАК МаршрутизацияКонтрагентыИДоговоры
				   |		ПО (Маршрутизация.Ссылка = МаршрутизацияКонтрагентыИДоговоры.Ссылка)
				   // Евросиб(ДИТ) US 86962 ТА 87365 Сержантова А.С. Конец: 05.09.2024
	               |ГДЕ
	               |	НЕ Маршрутизация.ПометкаУдаления
	               |	И Маршрутизация.МаршрутизируемыйОбъект = ЗНАЧЕНИЕ(Перечисление.МаршрутизируемыеОбъекты.ТранспортныйДокумент)
				   // Евросиб(ДИТ) US 86962 ТА 87365 Сержантова А.С. Начало: 05.09.2024
				   // Было:
				   //|	И ВЫБОР
				   //|			КОГДА Маршрутизация.КонтрагентПустой
				   //|				ТОГДА &Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
				   //|			ИНАЧЕ Маршрутизация.Контрагент = &Контрагент
				   //|					ИЛИ Маршрутизация.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
				   //|		КОНЕЦ
				   //|	И ВЫБОР
				   //|			КОГДА Маршрутизация.ДоговорПустой
				   //|				ТОГДА &Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
				   //|			ИНАЧЕ Маршрутизация.Договор = &Договор
				   //|					ИЛИ Маршрутизация.Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
				   //|		КОНЕЦ
				   //Стало:
				   |	И ВЫБОР
				   |			КОГДА Маршрутизация.КонтрагентПустой
				   |				ТОГДА &Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
				   |			ИНАЧЕ ЕСТЬNULL(МаршрутизацияКонтрагентыИДоговоры.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) = &Контрагент
				   |					ИЛИ ЕСТЬNULL(МаршрутизацияКонтрагентыИДоговоры.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
				   |		КОНЕЦ
				   |	И ВЫБОР
				   |			КОГДА Маршрутизация.ДоговорПустой
				   |				ТОГДА &Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
				   |			ИНАЧЕ ЕСТЬNULL(МаршрутизацияКонтрагентыИДоговоры.Договор, ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)) = &Договор
				   |					ИЛИ ЕСТЬNULL(МаршрутизацияКонтрагентыИДоговоры.Договор, ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
				   |		КОНЕЦ
				   // Евросиб(ДИТ) US 86962 ТА 87365 Сержантова А.С. Конец: 05.09.2024
	               |	И ВЫБОР
	               |			КОГДА Маршрутизация.ОрганизацияПустая
	               |				ТОГДА &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	               |			ИНАЧЕ Маршрутизация.Организация = &Организация
	               |					ИЛИ Маршрутизация.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	               |		КОНЕЦ";
	Запрос.УстановитьПараметр("Контрагент", ПараметрыЗапроса["Контрагент"]);
	Запрос.УстановитьПараметр("Организация", ПараметрыЗапроса["Организация"]);
	Запрос.УстановитьПараметр("Договор", ПараметрыЗапроса["Договор"]);
	Ответ = Запрос.Выполнить().Выбрать();
	КоличествоСовпаденийМакс = -1;
	ПодходящаяМаршрутизация = Справочники.Маршрутизация.ПустаяСсылка();
	Пока Ответ.Следующий() Цикл
		КоличествоСовпадений = 0;
		
		Если ЗначениеЗаполнено(Ответ["Контрагент"]) Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		Если ЗначениеЗаполнено(Ответ["Организация"]) Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		Если ЗначениеЗаполнено(Ответ["Договор"]) Тогда КоличествоСовпадений = КоличествоСовпадений + 1; КонецЕсли;
		
		Если КоличествоСовпадений > КоличествоСовпаденийМакс Тогда
			ПодходящаяМаршрутизация = Ответ.Ссылка;
			КоличествоСовпаденийМакс = КоличествоСовпадений;
		КонецЕсли;
	КонецЦикла;
	
	РезультатЗапроса = Новый Массив;
	Для каждого Стр из ПодходящаяМаршрутизация.Состояния Цикл
		Статус = ?(РезультатЗапроса.Количество() = 0, ПодходящаяМаршрутизация.НачальныйСтатус, Перечисления.СтатусыЭтапов.Новый);
		РезультатЗапроса.Добавить(Новый Структура("Состояние, Исполнитель, Наблюдатель, Статус, Ссылка, ПредыдущиеЭтапы, ОРКПоДоговору, ОтветственныйЗаУчет, ОтветственныйЗаДоговор, НормативИсполненияСМоментаСоздания, ТребуетсяУказатьНаблюдателя, ТребуетсяУказатьИсполнителя, ВидНормативаИсполнения, РуководительСотрудника, ВыбиратьИсполнителяЕслиНеЗаполненРуководительСотрудника", Стр.Состояние, Стр.Исполнитель, Стр.Наблюдатель, Статус, ПодходящаяМаршрутизация, Стр.ПредыдущиеЭтапы, Стр.СопровождениеПоДоговору, Стр.ОтветственныйЗаУчет, Стр.ОтветственныйЗаДоговор, Стр.НормативИсполненияСМоментаСоздания, Стр.ТребуетсяУказатьНаблюдателя, Стр.ТребуетсяУказатьИсполнителя, Стр.ВидНормативаИсполнения, Стр.РуководительСотрудника, Стр.ВыбиратьИсполнителяЕслиНеЗаполненРуководительСотрудника));
	КонецЦикла;
	ОтработатьЗамещениеДелегирование(РезультатЗапроса, Перечисления.МаршрутизируемыеОбъекты.ПоступлениеТоваровУслуг, ДатаДокумента, ПараметрыЗапроса["Договор"]);
	Возврат РезультатЗапроса;
	
