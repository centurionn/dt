//Евросиб Каблов 20.01.2022 62514
Функция ВыполнитьПовторнуюМаршрутизациюОбъектаПоСсылке(Ссылка, ДополнительныеПараметры) Экспорт
	
	Результат = Новый Структура();
	Результат.Вставить("Выполнено", Ложь);
	
	Объект = Ссылка.ПолучитьОбъект();
	ПолноеИмяОбъекта = Объект.Метаданные().ПолноеИмя();
	
	ПараметрыЗапроса = ПолучитьПараметрыМаршрутизации(Объект);
	
	Если ПолноеИмяОбъекта = "Справочник.ДоговорыКонтрагентов" Тогда		
		РезультатЗапроса = МаршрутизацияСервер.МаршрутизироватьДоговор(ПараметрыЗапроса, Объект.Дата);
	ИначеЕсли ПолноеИмяОбъекта = "Документ.Букинг" Тогда
		РезультатЗапроса = МаршрутизироватьБукинг(ПараметрыЗапроса, Объект.Дата);
	ИначеЕсли ПолноеИмяОбъекта = "Документ.ЗакрытиеПериода" Тогда
		РезультатЗапроса = МаршрутизироватьЗакрытиеПериода(ПараметрыЗапроса, Объект.Дата);
	ИначеЕсли ПолноеИмяОбъекта = "Документ.Запрос" Тогда
		РезультатЗапроса = МаршрутизироватьЗапрос(ПараметрыЗапроса, Объект.Дата);
	ИначеЕсли ПолноеИмяОбъекта = "Документ.Заявка" Тогда		
		РезультатЗапроса = МаршрутизироватьЗаявку(ПараметрыЗапроса, Объект.Дата);
	ИначеЕсли ПолноеИмяОбъекта = "Документ.Калькуляция" Тогда
		РезультатЗапроса = МаршрутизироватьКалькуляцию(ПараметрыЗапроса, Объект.Дата);
	ИначеЕсли ПолноеИмяОбъекта = "Документ.КорректировкаПоступления" Тогда
		РезультатЗапроса = МаршрутизироватьКорректировкуПоступления(ПараметрыЗапроса, Объект.Дата);
	ИначеЕсли ПолноеИмяОбъекта = "Документ.КорректировкаРеализации" Тогда
		РезультатЗапроса = МаршрутизироватьРТУ(ПараметрыЗапроса, Объект.Дата);
	ИначеЕсли ПолноеИмяОбъекта = "Документ.КредитнаяЗаявка" Тогда
		РезультатЗапроса = МаршрутизироватьКредитнуюЗаявку(ПараметрыЗапроса, Объект.Дата);
	ИначеЕсли ПолноеИмяОбъекта = "Документ.ЛичныеЦели" Тогда
		РезультатЗапроса = МаршрутизироватьЛичныеЦели(ПараметрыЗапроса, Объект.Дата);
	ИначеЕсли ПолноеИмяОбъекта = "Документ.Операция" Тогда
		РезультатЗапроса = МаршрутизироватьОперацию(ПараметрыЗапроса, Объект.Дата);
	ИначеЕсли ПолноеИмяОбъекта = "Документ.ОтчетКомиссионераОПродажах" Тогда
		РезультатЗапроса = МаршрутизироватьОтчетКомиссионера(ПараметрыЗапроса, Объект.Дата);
	ИначеЕсли ПолноеИмяОбъекта = "Документ.ОтчетКомитентуОПродажах" Тогда
		РезультатЗапроса = МаршрутизироватьРТУ(ПараметрыЗапроса, Объект.Дата);
	ИначеЕсли ПолноеИмяОбъекта = "Документ.ПоступлениеНаРасчетныйСчет" Тогда
		РезультатЗапроса = МаршрутизироватьПоступлениеНаРС(ПараметрыЗапроса, Объект.Дата);
	ИначеЕсли ПолноеИмяОбъекта = "Документ.ПоступлениеТоваровУслуг" Тогда
		РезультатЗапроса = МаршрутизироватьПТУ(ПараметрыЗапроса, Объект.Дата);
	ИначеЕсли ПолноеИмяОбъекта = "Документ.ПСЦ" Тогда
		РезультатЗапроса = МаршрутизироватьПСЦ(ПараметрыЗапроса, Объект.Дата);
	//Евросиб Каблов 20.05.2024 ( #67092
	ИначеЕсли ПолноеИмяОбъекта = "Документ.ПСЦПоставщика" Тогда
		РезультатЗапроса = МаршрутизироватьПСЦПоставщика(ПараметрыЗапроса, Объект.Дата);
	//Евросиб Каблов 20.05.2024 )
	// Евросиб US 90342 Рыбьяков К.А. 14.12.2025 ((
	ИначеЕсли ПолноеИмяОбъекта = "Документ.РеестрСпециальныхСтавок" Тогда
		РезультатЗапроса = МаршрутизироватьРеестрСпециальныхСтавок(ПараметрыЗапроса, Объект.Дата);
	// Евросиб Рыбьяков К.А. 14.12.2025 ))
	ИначеЕсли ПолноеИмяОбъекта = "Документ.РеализацияТоваровУслуг" Тогда
		РезультатЗапроса = МаршрутизироватьРТУ(ПараметрыЗапроса, Объект.Дата);
	ИначеЕсли ПолноеИмяОбъекта = "Документ.РелизСобственника" Тогда
		РезультатЗапроса = МаршрутизироватьРелизСобственника(ПараметрыЗапроса, Объект.Дата);
	ИначеЕсли ПолноеИмяОбъекта = "Документ.Сделка" Тогда
		РезультатЗапроса = МаршрутизироватьСделку(ПараметрыЗапроса, Объект.Дата);
	ИначеЕсли ПолноеИмяОбъекта = "Документ.СписаниеСРасчетногоСчета" Тогда
		РезультатЗапроса = МаршрутизироватьСписаниеСРС(ПараметрыЗапроса, Объект.Дата);
	ИначеЕсли ПолноеИмяОбъекта = "Документ.СчетНаОплатуПокупателю" Тогда
		РезультатЗапроса = МаршрутизироватьСчетПокупателю(ПараметрыЗапроса, Объект.Дата);
	ИначеЕсли ПолноеИмяОбъекта = "Документ.СчетНаОплатуПоставщика" Тогда
		РезультатЗапроса = МаршрутизироватьСчетПоставщика(ПараметрыЗапроса, Объект.Дата);
	ИначеЕсли ПолноеИмяОбъекта = "Документ.СчетФактураВыданный" Тогда
		РезультатЗапроса = МаршрутизироватьСФВ(ПараметрыЗапроса, Объект.Дата);
	ИначеЕсли ПолноеИмяОбъекта = "Документ.СчетФактураПолученный" Тогда
		РезультатЗапроса = МаршрутизироватьСФП(ПараметрыЗапроса, Объект.Дата);
	ИначеЕсли ПолноеИмяОбъекта = "Документ.ТранспортныйДокумент" Тогда
		РезультатЗапроса = МаршрутизироватьТД(ПараметрыЗапроса, Объект.Дата);
	Иначе
		РезультатЗапроса = Новый Массив;
	КонецЕсли;
	
	Результат.Вставить("РезультатЗапроса", РезультатЗапроса);
	
	СостоянияДляУказанияИсполнителей = Новый Массив;
	Для каждого Стр из  РезультатЗапроса Цикл
		Исполнитель = Стр.Исполнитель;
		Если НЕ Стр.ТребуетсяУказатьИсполнителя И НЕ ЗначениеЗаполнено(Исполнитель) Тогда Исполнитель = Объект.Автор; КонецЕсли;
		Наблюдатель = Стр.Наблюдатель;
		Если НЕ Стр.ТребуетсяУказатьНаблюдателя И НЕ ЗначениеЗаполнено(Наблюдатель) Тогда Наблюдатель = Объект.Автор; КонецЕсли;
		
		Если Стр.ТребуетсяУказатьИсполнителя ИЛИ Стр.ТребуетсяУказатьНаблюдателя Тогда 
			СостоянияДляУказанияИсполнителей.Добавить(Новый Структура("Состояние, Исполнитель, Наблюдатель", Стр.Состояние, Исполнитель, Наблюдатель)); 
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(СостоянияДляУказанияИсполнителей) Тогда
		Результат.Вставить("СостоянияДляУказанияИсполнителей", СостоянияДляУказанияИсполнителей);
	Иначе
		ПрименитьМаршрутИЗаписатьОбъект(Ссылка, РезультатЗапроса, Новый СписокЗначений, ДополнительныеПараметры);
		Результат.Вставить("Выполнено", Истина);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//Евросиб Каблов 20.01.2022 62514
Процедура ПрименитьМаршрутИЗаписатьОбъект(Ссылка, РезультатЗапроса, УказанныеИсполнители, ДополнительныеПараметры) Экспорт
	
	Объект = Ссылка.ПолучитьОбъект();
	Если РезультатЗапроса.Количество() > 0 Тогда
		
		НачатьТранзакцию();
		
		Автор = Объект.Автор;		
		МаршрутизацияСервер.ПрименитьМаршрут(Объект, РезультатЗапроса, Автор, УказанныеИсполнители);
		Для каждого Стр из  Объект.Состояния Цикл
			Если НЕ ЗначениеЗаполнено(Стр.Исполнитель) Тогда Стр.Исполнитель = Автор; КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Стр.Наблюдатель) Тогда Стр.Наблюдатель = Автор; КонецЕсли;
		КонецЦикла;
		Объект.ДополнительныеСвойства.Вставить("ПрименениеМаршрута", Истина);
		Объект.Записать();
		
		Если ДополнительныеПараметры <> Неопределено Тогда
			Если ДополнительныеПараметры.Свойство("АдресТаблицыСделокПоПСЦДляОбработки") Тогда
				ОбработатьСделкиПоПСЦ(ДополнительныеПараметры.АдресТаблицыСделокПоПСЦДляОбработки);
			КонецЕсли;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Иначе
		ОбщегоНазначения.СообщитьПользователю("Для документа: " + Ссылка + " не найден подходящий маршрут. Изменения не внесены!");
	КонецЕсли;
	
КонецПроцедуры

//Евросиб Каблов 20.01.2022 62514
Функция ПолучитьПараметрыМаршрутизации(Объект) Экспорт
	
	ПолноеИмяОбъекта = Объект.Метаданные().ПолноеИмя();
	
	ПараметрыЗапроса = Новый Соответствие;
	
	Если ПолноеИмяОбъекта = "Справочник.ДоговорыКонтрагентов" Тогда
		
		ПараметрыЗапроса.Вставить("Организация", Объект.Организация);
		ПараметрыЗапроса.Вставить("Контрагент", Объект.Владелец);
		ПараметрыЗапроса.Вставить("Договор", Объект.Ссылка);
		
		ПараметрыЗапроса.Вставить("КатегорияДоговора", Объект.КатегорияДоговора);
		ПараметрыЗапроса.Вставить("ТипДоговорнойЗаписи", Объект.ТипДоговорнойЗаписи);
		ПараметрыЗапроса.Вставить("Нетиповой", Не Объект.Типовой);
		ПараметрыЗапроса.Вставить("РегионДоговора", Объект.РегионДоговора);
		ПараметрыЗапроса.Вставить("ВидДоговора", Объект.ВидДоговора);
		ПараметрыЗапроса.Вставить("Валюта", Объект.ВалютаВзаиморасчетов);
		ПараметрыЗапроса.Вставить("ЦФО", Объект.ЦФО);
		ПараметрыЗапроса.Вставить("Нерезидент", (Объект.Владелец.СтранаРегистрации <> Справочники.СтраныМира.Россия));
		ПараметрыЗапроса.Вставить("УсловиеОплаты", Объект.УсловиеОплаты);
		ПараметрыЗапроса.Вставить("Подписан", Объект.Подписан);
		
	ИначеЕсли ПолноеИмяОбъекта = "Документ.Букинг" Тогда
		
		ПараметрыЗапроса.Вставить("Организация", Объект.Организация);
		ПараметрыЗапроса.Вставить("Контрагент", Объект.Грузоотправитель);
