Функция МаршрутизироватьРеестрПлатежей(ПараметрыЗапроса, ДатаДокумента) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Маршрутизация.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Маршрутизация КАК Маршрутизация
	               |ГДЕ
	               |	НЕ Маршрутизация.ПометкаУдаления
	               |	И Маршрутизация.МаршрутизируемыйОбъект = ЗНАЧЕНИЕ(Перечисление.МаршрутизируемыеОбъекты.РеестрПлатежей)
	               |	И Маршрутизация.МаршрутСогласованияРеестраНаОплату = &МаршрутСогласования";
	
	Запрос.УстановитьПараметр("МаршрутСогласования", ПараметрыЗапроса.получить("МаршрутСогласования"));

	Ответ = Запрос.Выполнить().Выбрать();
	КоличествоСовпаденийМакс = -1;
	ПодходящаяМаршрутизация = Справочники.Маршрутизация.ПустаяСсылка();
	Пока Ответ.Следующий() Цикл
		КоличествоСовпадений = 0;
		
		КоличествоСовпадений = КоличествоСовпадений + 1;
		
		Если КоличествоСовпадений > КоличествоСовпаденийМакс Тогда
			ПодходящаяМаршрутизация = Ответ.Ссылка;
			КоличествоСовпаденийМакс = КоличествоСовпадений;
		КонецЕсли;
	КонецЦикла;
	
	РезультатЗапроса = Новый Массив;
	Для каждого Стр из ПодходящаяМаршрутизация.Состояния Цикл
		Статус = ?(РезультатЗапроса.Количество() = 0, ПодходящаяМаршрутизация.НачальныйСтатус, Перечисления.СтатусыЭтапов.Новый);
		РезультатЗапроса.Добавить(Новый Структура("Состояние, Исполнитель, Наблюдатель, Статус, Ссылка, ПредыдущиеЭтапы, ОРКПоДоговору, ОтветственныйЗаУчет, ОтветственныйЗаДоговор, НормативИсполненияСМоментаСоздания, ТребуетсяУказатьНаблюдателя, ТребуетсяУказатьИсполнителя, ВидНормативаИсполнения, НаблюдательКакРуководительИсполнителя, РуководительСотрудника, ВыбиратьИсполнителяЕслиНеЗаполненРуководительСотрудника", Стр.Состояние, Стр.Исполнитель, Стр.Наблюдатель, Статус, ПодходящаяМаршрутизация, Стр.ПредыдущиеЭтапы, Стр.СопровождениеПоДоговору, Стр.ОтветственныйЗаУчет, Стр.ОтветственныйЗаДоговор, Стр.НормативИсполненияСМоментаСоздания, Стр.ТребуетсяУказатьНаблюдателя, Стр.ТребуетсяУказатьИсполнителя, Стр.ВидНормативаИсполнения, Стр.НаблюдательКакРуководительИсполнителя, Стр.РуководительСотрудника, Стр.ВыбиратьИсполнителяЕслиНеЗаполненРуководительСотрудника));
	КонецЦикла;
	//Евросиб СубботинВ #117172 18.08.2025 Начало 
	//ОтработатьЗамещениеДелегирование(РезультатЗапроса, Перечисления.МаршрутизируемыеОбъекты.Сделка, ДатаДокумента, ПараметрыЗапроса["Договор"]);
	ОтработатьЗамещениеДелегирование(РезультатЗапроса, Перечисления.МаршрутизируемыеОбъекты.РеестрПлатежей, ДатаДокумента, ПараметрыЗапроса["Договор"]);
	//Евросиб СубботинВ #117172 18.08.2025 Конец
	Возврат РезультатЗапроса;
	
КонецФункции

