Процедура МаршрутизацияВРегистрБезРегистратораПриЗаписи(Источник, Отказ) Экспорт
	
	НЗ = РегистрыСведений.ЗадачиСотрудника.СоздатьНаборЗаписей();
	НЗ.Отбор.Документ.Установить(Источник.Ссылка);
//Евросиб Гудкова( 19.11.2019
	НЗ.Прочитать();
	НачальноеКоличество = НЗ.Количество();
	НЗ.Очистить();
//Евросиб Гудкова)	

ИсточникПроведен = Истина;
ТипСтрокой = Строка(ТипЗнч(Источник));
Если Найти(ТипСтрокой, "Справочник") = 0 Тогда
	ИсточникПроведен = Источник.Проведен;
КонецЕсли;

	ТипИсточника = ТипЗнч(Источник);

	Для каждого Стр из Источник.Состояния Цикл
		
		Если НЕ Источник.ПометкаУдаления И ИсточникПроведен И ЗначениеЗаполнено(Стр.Исполнитель) Тогда
			
			Попытка
				ДатаНачалаРаботы = ?(ТипИсточника = Тип("СправочникОбъект.ДоговорыКонтрагентов"), ТекущаяДата(), Источник.Дата);//Евросиб Гудкова 19.11.2019 было Источник.Дата
			Исключение
				ДатаНачалаРаботы = ТекущаяДата();
			КонецПопытки;
			
			НСтр = НЗ.Добавить();
			НСтр.Документ = Источник.Ссылка;
			НСтр.Наблюдатель = Стр.Наблюдатель;
			НСтр.Статус = Стр.Статус;
			Если ЗначениеЗаполнено(Стр.Состояние) Тогда
				НСтр.Состояние = Стр.Состояние;
			Иначе
				НСтр.Состояние = Справочники.Состояния.Выполнение;
			КонецЕсли;
			НСТр.НачалоРаботыПлан = ДатаНачалаРаботы;
			//ДИТ Авдеева В.С. 37052 12.05.2022 Начало  
			Если ТипИсточника = Тип("ДокументОбъект.Сделка") 
				И НСтр.Состояние.Родитель = Справочники.Состояния.ЗадачиДелегирования
				//Евросиб Каблов 25.07.2022 ( Ticket#0239076
				Или НСтр.Состояние = Справочники.Состояния.ИзмененСчетПроверитьСоответствиеИнформацииВСделке
				Или НСтр.Состояние.Родитель = Справочники.Состояния.ЗадачиОтработатьИзменениеСчетаОтменитьРТУ
				Или НСтр.Состояние.Родитель = Справочники.Состояния.ЗадачиОтработатьИзменениеСчетаСоздатьСЗнаИзменениеДокументов
				//Евросиб Каблов 25.07.2022 )
				Тогда
				НСТр.НачалоРаботыПлан = Стр.НачалоРаботы;
			КонецЕсли;
			//ДИТ Авдеева В.С. 37052 12.05.2022 Конец
			НСтр.НачалоРаботыФакт = Стр.НачалоРаботы;
			НСтр.ОкончаниеРаботыФакт = Стр.ЗавершениеРаботы;
			НСтр.Ответственный = Стр.Исполнитель;
			НСтр.Период = ДатаНачалаРаботы;
			НСтр.ТипЗадачи = Перечисления.ТипыЗадачСотрудников.ОбработкаДокумента;  
			
			//ДИТ Авдеева В.С. 37052 12.05.2022 Начало
			Попытка
				Комментарий = Стр.Комментарий;
			Исключение
				Комментарий = "";
			КонецПопытки;

			НСтр.Комментарий = Комментарий;
			//ДИТ Авдеева В.С. 37052 12.05.2022 Конец
			
		КонецЕсли;
	КонецЦикла;
	
 	Если НЗ.Количество() > 0 Или НачальноеКоличество > 0 Тогда
		НЗ.Записать(Истина);
	КонецЕсли;
	
КонецПроцедуры

Процедура РегистрацияСостоянийДокументаПриЗаписи(Источник, Отказ, СпециальныйРежимОднойОперации = Ложь) Экспорт
	
	ТребуетсяВозврат = Ложь;
	УстановитьПривилегированныйРежим(Истина);
	Если Источник.Метаданные().ТабличныеЧасти.Найти("Состояния") = неопределено Тогда ТребуетсяВозврат = Истина; КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	Если ТребуетсяВозврат Тогда Возврат; КонецЕсли;
	
	ИсточникПроведен = Истина;
	ТипСтрокой = Строка(ТипЗнч(Источник));
	Если Найти(ТипСтрокой, "Справочник") = 0 Тогда
		ИсточникПроведен = Источник.Проведен;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	//Запрос.Текст = "ВЫБРАТЬ
	//               |	*
	//               |ИЗ
	//               |	РегистрСведений.УведомленияПользователейОЗадачах КАК УведомленияПользователейОЗадачах
	//               |ГДЕ
	//               |	УведомленияПользователейОЗадачах.Документ = &Документ
	//               |	И УведомленияПользователейОЗадачах.Пользователь = &Пользователь
	//               |	И УведомленияПользователейОЗадачах.Состояние = &Состояние
	//               |	И НЕ УведомленияПользователейОЗадачах.УведомлениеОЗадаче";
	Запрос.Текст = "ВЫБРАТЬ
	               |	УведомленияПользователейОЗадачах.Состояние КАК Состояние,
	               |	УведомленияПользователейОЗадачах.Документ КАК Документ,
	               |	УведомленияПользователейОЗадачах.Пользователь КАК Пользователь,
	               |	УведомленияПользователейОЗадачах.УведомлениеОЗадаче КАК УведомлениеОЗадаче
	               |ИЗ
	               |	РегистрСведений.УведомленияПользователейОЗадачах КАК УведомленияПользователейОЗадачах
	               |ГДЕ
	               |	УведомленияПользователейОЗадачах.Документ = &Документ";
	Запрос.УстановитьПараметр("Документ", Источник.Ссылка);
	
	СтруктураСохраняемыхСостояний = Новый Массив;
	
	Ответ = запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		Если Ответ.УведомлениеОЗадаче = Ложь Тогда
			МЗ = РегистрыСведений.УведомленияПользователейОЗадачах.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(МЗ, Ответ);
			МЗ.Удалить();
		Иначе
			СтруктураСохраняемыхСостояний.Добавить(Новый Структура("Состояние, Пользователь", Ответ.Состояние, Ответ.Пользователь));
		КонецЕсли;
	КонецЦикла;
	
	Если Источник.ПометкаУдаления ИЛИ НЕ ИсточникПроведен Тогда
		
		МЗ = РегистрыСведений.УведомленияПользователейОЗадачах.СоздатьНаборЗаписей();
		МЗ.Отбор.Документ.Установить(Источник.Ссылка);
		МЗ.Записать(Истина);
		
	Иначе
		
		Для каждого Стр из Источник.Состояния Цикл
			
			Если Не ЗначениеЗаполнено(Стр.Исполнитель) 
					Или Строка(Стр.Исполнитель) = "<Не указан>" 
					ИЛИ НЕ (Стр.Статус = Перечисления.СтатусыЭтапов.ВРаботе ИЛИ Стр.Статус = Перечисления.СтатусыЭтапов.НаВыполнение) 
				Тогда 
					Продолжить;
			КонецЕсли;
			
			НайдСтрока = Ложь;
			Для каждого Стр88 из СтруктураСохраняемыхСостояний цикл
				Если стр88.Состояние = Стр.Состояние И Стр88.Пользователь = Стр.Исполнитель Тогда НайдСтрока = истина; КонецЕсли;
			КонецЦикла;
			Если НайдСтрока = Истина Тогда Продолжить; КонецЕсли;
			
			МЗ = РегистрыСведений.УведомленияПользователейОЗадачах.СоздатьМенеджерЗаписи();
			МЗ.Документ = Источник.Ссылка;
			МЗ.Пользователь = Стр.Исполнитель;
			МЗ.Состояние = Стр.Состояние;
			МЗ.Период = ТекущаяДата();
			МЗ.Записать(Истина);
			
		КонецЦикла;
	КонецЕсли;
	Если СпециальныйРежимОднойОперации = Истина Тогда Возврат; КонецЕсли;
	
	// - Иван
	
	
	НЗ = РегистрыСведений.СостоянияДокументов.СоздатьНаборЗаписей();
	НЗ.Отбор.ДокументРегистратор.Установить(Источник.ссылка);
	
	Для каждого Стр из Источник.Состояния Цикл
		
		Если Источник.ПометкаУдаления ИЛИ НЕ ИсточникПроведен ИЛИ Строка(Стр.Исполнитель) = "<Не указан>" Тогда Продолжить; КонецЕсли;
		
		НСтр = НЗ.Добавить();
		НСтр.ДокументРегистратор = Источник.ссылка;
		НСтр.ЗавершениеРаботы = Стр.ЗавершениеРаботы;
		НСтр.Исполнитель = Стр.Исполнитель;
		НСтр.Наблюдатель = Стр.Наблюдатель;
		НСтр.НачалоРаботы = Стр.НачалоРаботы;
		НСтр.Период = Текущаядата();
		НСтр.Регистратор = Источник.ссылка;
		НСтр.Состояние = Стр.Состояние;
		НСтр.Статус = Стр.Статус;
		
		Если ТипЗнч(Источник) = Тип("ДокументОбъект.Операция") Тогда
			
			ДатаНачалаВ = ?(ЗначениеЗаполнено(Источник.ДатаОтправленияФакт), Источник.ДатаОтправленияФакт, Источник.ДатаОтправления);
			ДатаОкончанияВ = ?(ЗначениеЗаполнено(Источник.ДатаНазначенияФакт), Источник.ДатаНазначенияФакт, Источник.ДатаНазначения);
			
			Если ЗначениеЗаполнено(ДатаНачалаВ) Тогда НСтр.НачалоРаботы = ДатаНачалаВ; КонецЕсли;
			Если ЗначениеЗаполнено(ДатаОкончанияВ) Тогда НСтр.ЗавершениеРаботы = ДатаОкончанияВ; КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	НЗ.Записать(Истина);

КонецПроцедуры

//Процедура ОбновитьПанельТекущегоПользователя(Объект, ТекущийИсполнитель_Статус, ТекущийИсполнитель_Состояние, ТекущийИсполнитель_Исполнитель, ТекущийИсполнитель_Наблюдатель) Экспорт
//ДИТ, Беляев СЮ, US 37052, 23-08-2022, добавлен параметр ТекущийИсполнитель_Примечание
Процедура ОбновитьПанельТекущегоПользователя(Объект, ТекущийИсполнитель_Статус, ТекущийИсполнитель_Состояние, ТекущийИсполнитель_Исполнитель, ТекущийИсполнитель_Наблюдатель, ТекущийИсполнитель_Примечание = "") Экспорт
	
	ТекП = Пользователи.ТекущийПользователь();
	ТекЗамещающий = Пользователи_sd_сервер.ПодобратьЗамещениеОбратное(ТекП, ТекущаяДата());
	МоиГруппы = Пользователи_sd_сервер.ПолучитьСписокМоихГрупп(ТекП, ТекЗамещающий);
	// ДИТ Поморцева Т.П. Задача 238786 16.08.21. начало
	//МоиГруппы.Добавить(ТекП);
	//МоиГруппы.Добавить(ТекЗамещающий);
	Для Каждого Элемент ИЗ ТекЗамещающий Цикл
		МоиГруппы.Добавить(Элемент);
	КонецЦикла;	
	// ДИТ Поморцева Т.П. Задача 238786 16.08.21. конец
	
	МассивСтатусовДляОтработки = Новый Массив;
	МассивСтатусовДляОтработки.Добавить(Перечисления.СтатусыЭтапов.НаВыполнение);
	МассивСтатусовДляОтработки.Добавить(Перечисления.СтатусыЭтапов.ВРаботе);	
	Для каждого Стр из Объект.Состояния Цикл
		Если МоиГруппы.Найти(Стр.Исполнитель) <> неопределено И МассивСтатусовДляОтработки.Найти(Стр.Статус) <> неопределено Тогда
			ТекущийИсполнитель_Статус = Стр.Статус;
			ТекущийИсполнитель_Состояние = Стр.Состояние;
			ТекущийИсполнитель_Исполнитель = Стр.Исполнитель;
			ТекущийИсполнитель_Наблюдатель = Стр.Наблюдатель;
			//ДИТ, Беляев СЮ, US 37052, 23-08-2022, начало
			// ДИТ 64186 Давудов М.А. Начало: 07.03.2023
			РодительскийСтатус =  Справочники.Состояния.ЗадачиГотовностьКомплектаПодтверждающихДокументов;
			Если Стр.ПредыдущиеЭтапы = "999"
			   И ЗначениеЗаполнено(Стр.Состояние)
			   И Стр.Состояние.ПринадлежитЭлементу(РодительскийСтатус) Тогда
				ТекущийИсполнитель_Примечание = "";
			Иначе
			// ДИТ 64186 Давудов М.А. Конец: 07.03.2023
			ТекущийИсполнитель_Примечание = СокрЛП(Стр.Комментарий);
			// ДИТ 64186 Давудов М.А. Начало: 07.03.2023
			КонецЕсли;
			// ДИТ 64186 Давудов М.А. Конец: 07.03.2023
			//ДИТ, Беляев СЮ, US 37052, 23-08-2022, конец
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

