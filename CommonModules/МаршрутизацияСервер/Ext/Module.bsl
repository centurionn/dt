//Евросиб Шевченко А.В. US 115011 TA 117858 18.09.2025
Процедура СформироватьЗадачуПометкаНаУдалениеСчета(СчетОбъект,ГруппаДКП = Неопределено) Экспорт  
	СтрокаСостояния = СчетОбъект.Состояния.НайтиСтроки(Новый Структура("Состояние", Справочники.Состояния.ТребуетсяПометкаНаУдалениеСчета));
	Если СтрокаСостояния.Количество() <> 0 Тогда
		НС = СтрокаСостояния[0];
	Иначе
		НС = СчетОбъект.Состояния.Добавить();	
	КонецЕсли;
	
	НС.Исполнитель = ПолучитьИсполнителяДляЗадачиПометкаНаУдалениеСчета(СчетОбъект.Ссылка,ГруппаДКП);
	Если СчетОбъект.Состояния.Количество() Тогда
		НС.Наблюдатель = СчетОбъект.Состояния[0].Наблюдатель;
	КонецЕсли;
	НС.Статус = Перечисления.СтатусыЭтапов.ВРаботе;
	НС.Состояние = Справочники.Состояния.ТребуетсяПометкаНаУдалениеСчета;
	НС.Комментарий = "";  
	НС.НачалоРаботы = ТекущаяДата(); 
	//Евросиб Шевченко А.В. US 121985 TA 122270 19.11.2025
	ОставитьИсполнителя = Ложь;
	СтрокаСостояния = СчетОбъект.Состояния.НайтиСтроки(Новый Структура("Состояние", Справочники.Состояния.УдалениеСчета));
	Если СтрокаСостояния.Количество() <> 0 Тогда
		НС = СтрокаСостояния[0];
		ОставитьИсполнителя = Истина;
	Иначе
		НС = СчетОбъект.Состояния.Добавить();	
	КонецЕсли;
	Если НЕ ОставитьИсполнителя Тогда
		НС.Исполнитель = Пользователи.ТекущийПользователь();
	КонецЕсли;
	Если СчетОбъект.Состояния.Количество() Тогда
		НС.Наблюдатель = СчетОбъект.Состояния[0].Наблюдатель;
	КонецЕсли;
	НС.Статус = Перечисления.СтатусыЭтапов.ВРаботе;
	НС.Состояние = Справочники.Состояния.УдалениеСчета;
	НС.Комментарий = "";  
	НС.НачалоРаботы = ТекущаяДата();
	//Евросиб Шевченко А.В. US 121985 TA 122270 19.11.2025
КонецПроцедуры	

Функция ПолучитьИсполнителяДляЗадачиПометкаНаУдалениеСчета(СчетОбъект,ГруппаДКП) Экспорт
	
	Если ГруппаДКП = Неопределено Тогда
		ГруппаДКС = РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ПолучитьГруппуДКСпоДокументу(СчетОбъект);
	Иначе
		ГруппаДКС = ГруппаДКП;
	КонецЕсли;
	Если ГруппаДКС = Справочники.ГруппыДКС.ДМС Тогда
		Возврат Справочники.ГруппыПользователей.ДКПДМС;
	ИначеЕсли ГруппаДКС = Справочники.ГруппыДКС.ДПРК Тогда	
		Возврат Справочники.ГруппыПользователей.ДКПДПРК;
	Иначе
		Возврат Справочники.ГруппыПользователей.ДКПДКС;
	КонецЕсли;
	
КонецФункции
