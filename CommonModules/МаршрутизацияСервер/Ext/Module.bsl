Процедура ПараллельноеСогласование(Состояния) Экспорт
	
	//Евросиб Каблов 31.08.2022 ( Task56814
	ТекДата = ТекущаяДата();
	СтатусВыполнен = Перечисления.СтатусыЭтапов.Выполнен;
	СтатусОтклонен = Перечисления.СтатусыЭтапов.Отклонен;
	
	ДопПоля = Новый Структура;
	ДопПоля.Вставить("ВыполнятьАвтоматическиЕслиПредыдущаяЗадачаСТемЖеИсполнителем");
	
	Для Каждого Стр Из Состояния Цикл
		
		ДопПоля.ВыполнятьАвтоматическиЕслиПредыдущаяЗадачаСТемЖеИсполнителем = Ложь;
		ЗаполнитьЗначенияСвойств(ДопПоля, Стр);
		
		Если Стр.Статус <> СтатусВыполнен И Стр.Статус <> СтатусОтклонен И ДопПоля.ВыполнятьАвтоматическиЕслиПредыдущаяЗадачаСТемЖеИсполнителем Тогда
			
			Если ЗначениеЗаполнено(Стр.ПредыдущиеЭтапы) Тогда
				
				Попытка
					МассивЭтапов = СтрРазделить(Стр.ПредыдущиеЭтапы,",",Ложь);
				Исключение
					Продолжить;
				КонецПопытки;
				ВозможноВыполнение = Истина;
				
				Для каждого Эл из МассивЭтапов Цикл
					
					Попытка
						НомСтр = Число(Эл);
					Исключение
					КонецПопытки;
					
					ПредыдущийЭтап = Состояния.Найти(НомСтр,"НомерСтроки");
					Если ПредыдущийЭтап <> Неопределено Тогда
						Если ПредыдущийЭтап.Статус = СтатусВыполнен И ПредыдущийЭтап.Исполнитель = Стр.Исполнитель Тогда
							
							Стр.Статус = СтатусВыполнен;				
							Стр.НачалоРаботы = ТекДата;							
							Стр.ЗавершениеРаботы = ТекДата;
				
							Прервать;
							
						КонецЕсли;
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;				
			
		КонецЕсли;
		
	КонецЦикла;
	//Евросиб Каблов 31.08.2022 )
	
	//Стаценко Параллельное согласование
	Для каждого СтрТЧ из Состояния Цикл
		Если Не ЗначениеЗаполнено(СтрТЧ.ПредыдущиеЭтапы) и СтрТЧ.Статус = Перечисления.СтатусыЭтапов.Новый Тогда
			СтрТЧ.Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
			//++ Зубов 35844 05.08.2021
			СтрТЧ.НачалоРаботы = ТекущаяДата();
			//-- Зубов 35844 05.08.2021
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрТЧ.ПредыдущиеЭтапы) и СтрТЧ.Статус = Перечисления.СтатусыЭтапов.Новый Тогда
            ПредыдущиеЭтапы = СтрТЧ.ПредыдущиеЭтапы;
			Попытка
				МассивЭтапов = СтрРазделить(ПредыдущиеЭтапы,",",Ложь);
			Исключение
				Сообщить("Некорректная строка предыдущих этапов");
			КонецПопытки;
			ВозможноВыполнение = Истина;
						
			Если МассивЭтапов.Количество() > 0 Тогда
				Для каждого Эл из МассивЭтапов Цикл
					Попытка
						НомСтр = Число(Эл);
						СтрЭтапа = Состояния.Найти(НомСтр,"НомерСтроки");
						Если СтрЭтапа <> Неопределено Тогда
							Если СтрЭтапа.Статус <> Перечисления.СтатусыЭтапов.Выполнен Тогда
								ВозможноВыполнение = Ложь;
							КонецЕсли;
						КонецЕсли;
					Исключение
						Сообщить("Некорректное указание этапа состояние. Возможен только ввод цифр.");
					КонецПопытки
				КонецЦикла;
			КонецЕсли;
			Если ВозможноВыполнение Тогда
				СтрТЧ.Статус =  Перечисления.СтатусыЭтапов.НаВыполнение;
				//++ Зубов 35844 05.08.2021
				СтрТЧ.НачалоРаботы = ТекущаяДата();
				//-- Зубов 35844 05.08.2021
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
