Функция ПолучитьМассивПодчиненных(ИсхТаблица, ТекПозиция, ВключаяТек = Истина, ВключаяОперацииСНесколькимиРодителями = Ложь) Экспорт
	
	МассивГУИДовРезультат = Новый Массив;
	
	Для каждого Стр из ИсхТаблица Цикл
		Если (Стр.Родитель1 = ТекПозиция ИЛИ Стр.Родитель2 = ТекПозиция ИЛИ Стр.Родитель3 = ТекПозиция ИЛИ Стр.Родитель4 = ТекПозиция ИЛИ Стр.Родитель5 = ТекПозиция) И (НЕ Стр.НесколькоРодителей ИЛИ ВключаяОперацииСНесколькимиРодителями) Тогда
			МассивГУИДовРезультат.Добавить(Стр.ГУИД);
		КонецЕсли;
	КонецЦикла;
	
	НайденХотьОдин = Истина;
	Защита = 1000;
	Пока НайденХотьОдин Цикл
		НайденХотьОдин = Ложь;
		
		Для каждого Стр из ИсхТаблица Цикл
			Если 
				(МассивГУИДовРезультат.Найти(Стр.Родитель1) <> неопределено ИЛИ 
				МассивГУИДовРезультат.Найти(Стр.Родитель2) <> неопределено ИЛИ 
				МассивГУИДовРезультат.Найти(Стр.Родитель3) <> неопределено ИЛИ 
				МассивГУИДовРезультат.Найти(Стр.Родитель4) <> неопределено ИЛИ 
				МассивГУИДовРезультат.Найти(Стр.Родитель5) <> неопределено ) И МассивГУИДовРезультат.Найти(Стр.ГУИД) = неопределено И 
				(НЕ Стр.НесколькоРодителей ИЛИ ВключаяОперацииСНесколькимиРодителями)
			Тогда
			МассивГУИДовРезультат.Добавить(Стр.ГУИД);
				НайденХотьОдин = истина;
			КонецЕсли;
		КонецЦикла;
		
		Защита = Защита - 1;
		Если Защита < 0 Тогда Прервать; КонецЕсли;
	КонецЦикла;
	
	Если ВключаяТек Тогда МассивГУИДовРезультат.Добавить(ТекПозиция); КонецЕсли;
	
	Возврат МассивГУИДовРезультат;
	
КонецФункции

Функция НормализоватьРодителейЭлемента(Элемент) Экспорт
	
	РЭлем = Новый Массив;
	Если ЗначениеЗаполнено(Элемент.Родитель1) Тогда РЭлем.Добавить(Элемент.Родитель1); КонецЕсли;
	Если ЗначениеЗаполнено(Элемент.Родитель2) Тогда РЭлем.Добавить(Элемент.Родитель2); КонецЕсли;
	Если ЗначениеЗаполнено(Элемент.Родитель3) Тогда РЭлем.Добавить(Элемент.Родитель3); КонецЕсли;
	Если ЗначениеЗаполнено(Элемент.Родитель4) Тогда РЭлем.Добавить(Элемент.Родитель4); КонецЕсли;
	Если ЗначениеЗаполнено(Элемент.Родитель5) Тогда РЭлем.Добавить(Элемент.Родитель5); КонецЕсли;
	
	Если РЭлем.Количество() > 0 Тогда Элемент.Родитель1 = РЭлем[0]; КонецЕсли;
	Если РЭлем.Количество() > 1 Тогда Элемент.Родитель2 = РЭлем[1]; КонецЕсли;
	Если РЭлем.Количество() > 2 Тогда Элемент.Родитель3 = РЭлем[2]; КонецЕсли;
	Если РЭлем.Количество() > 3 Тогда Элемент.Родитель4 = РЭлем[3]; КонецЕсли;
	Если РЭлем.Количество() > 4 Тогда Элемент.Родитель5 = РЭлем[4]; КонецЕсли;
	
	Элемент.НесколькоРодителей = (РЭлем.Количество() > 1);
	
КонецФункции

Функция ПолучитьДлительность(ДатаНачала, ДатаОкончания, ТипДлительности, ПрКалендарь = неопределено) Экспорт
	
	Результат = 0;
	
	Если НЕ ЗначениеЗаполнено(ТипДлительности) ИЛИ ТипДлительности = ПредопределенноеЗначение("Перечисление.ЕдиницаИзмеренияДлительности.КалендарныйДень") Тогда
		Результат = (ДатаОкончания - ДатаНачала) / 3600 / 24;
	ИначеЕсли ТипДлительности = ПредопределенноеЗначение("Перечисление.ЕдиницаИзмеренияДлительности.РабочийДень") Тогда
		Результат = КалендарныеГрафики.РазностьДатПоКалендарю(ПрКалендарь, ДатаНачала, ДатаОкончания, Истина);
	//ИначеЕсли ТипДлительности = ПредопределенноеЗначение("Перечисление.ЕдиницаИзмеренияДлительности.КалендарныйЧас") Тогда
		//Результат = (ДатаОкончания - ДатаНачала) / 3600;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДобавитьКДате(ДатаНачала, Срок, ТипДлительности, ПрКалендарь = неопределено) Экспорт
	
	Результат = 0;
	
	Если НЕ ЗначениеЗаполнено(ТипДлительности) ИЛИ ТипДлительности = ПредопределенноеЗначение("Перечисление.ЕдиницаИзмеренияДлительности.КалендарныйДень") Тогда
		Результат = ДатаНачала + Срок * 24 * 3600;
	ИначеЕсли ТипДлительности = ПредопределенноеЗначение("Перечисление.ЕдиницаИзмеренияДлительности.РабочийДень") Тогда
		Результат = КалендарныеГрафики.ДатаПоКалендарю(ПрКалендарь, ДатаНачала, Срок, Истина);
	//ИначеЕсли ТипДлительности = ПредопределенноеЗначение("Перечисление.ЕдиницаИзмеренияДлительности.КалендарныйЧас") Тогда
		//Результат = ДатаНачала + Срок * 3600;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ПересчитатьПоТаблице(ТЧ, ТекГУИД, ВычислитьДатуОтправления = Ложь) Экспорт
	
	СписокПодчиненныхСтрок = Новый Массив;
	ТекД = неопределено;
	
	Для каждого Стр из ТЧ Цикл
		Если Стр.ГУИД = ТекГУИД Тогда ТекД = Стр; КонецЕсли;
		Если Стр.Родитель1 = ТекГУИД ИЛИ Стр.Родитель2 = ТекГУИД ИЛИ Стр.Родитель3 = ТекГУИД ИЛИ Стр.Родитель4 = ТекГУИД ИЛИ Стр.Родитель5 = ТекГУИД Тогда
			СписокПодчиненныхСтрок.Добавить(Стр.ГУИД);
		КонецЕсли;
	КонецЦикла;
	
	Если ВычислитьДатуОтправления Тогда
		ТекД.ДатаОтправления = ПолучитьМаксимумРодителей(ТЧ, ТекГУИД);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекД.ДатаОтправления) И ЗначениеЗаполнено(ТекД.Срок) Тогда
		ПрКалендарь = ПостроительТСх_сервер.ПодобратьПроизводственныйКалендарь(ТекД.Поставщик, ТекД.Услуга);
		ТекД.ДатаНазначения = ДобавитьКДате(ТекД.ДатаОтправления, ТекД.Срок, ТекД.ТипДлительности, ПрКалендарь);
	ИначеЕсли ЗначениеЗаполнено(ТекД.ДатаОтправления) И ЗначениеЗаполнено(ТекД.ДатаНазначения) Тогда
		ПрКалендарь = ПостроительТСх_сервер.ПодобратьПроизводственныйКалендарь(ТекД.Поставщик, ТекД.Услуга);
		ТекД.Срок = ПолучитьДлительность(ТекД.ДатаОтправления, ТекД.ДатаНазначения, ТекД.ТипДлительности, ПрКалендарь);
	КонецЕсли;	
	
	Для каждого Стр из СписокПодчиненныхСтрок Цикл
		ПересчитатьПоТаблице(ТЧ, Стр, Истина);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьМаксимумРодителей(ТЧ, ТекГУИД)
	
	ДатаРезультат = Дата("00010101");
	
	МассивРодителей = Новый Массив;
	Для каждого Стр из ТЧ Цикл
		Если Стр.ГУИД = ТекГУИД Тогда
			Если ЗначениеЗаполнено(Стр.Родитель1) Тогда МассивРодителей.Добавить(Стр.Родитель1); КонецЕсли;
			Если ЗначениеЗаполнено(Стр.Родитель2) Тогда МассивРодителей.Добавить(Стр.Родитель2); КонецЕсли;
			Если ЗначениеЗаполнено(Стр.Родитель3) Тогда МассивРодителей.Добавить(Стр.Родитель3); КонецЕсли;
			Если ЗначениеЗаполнено(Стр.Родитель4) Тогда МассивРодителей.Добавить(Стр.Родитель4); КонецЕсли;
			Если ЗначениеЗаполнено(Стр.Родитель5) Тогда МассивРодителей.Добавить(Стр.Родитель5); КонецЕсли;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Для каждого Стр из ТЧ Цикл
		Если МассивРодителей.Найти(Стр.ГУИД) <> неопределено И Стр.ДатаНазначения > ДатаРезультат Тогда ДатаРезультат = Стр.ДатаНазначения; КонецЕсли;
	КонецЦикла;
	
	Возврат ДатаРезультат;
	
КонецФункции


