Функция ПолучитьТаблицуПоТекущимДвижениям(ДвиженияВзаиморасчетов, ДокументВзаиморасчетов)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВзаиморасчетыСПокупателямиОстатки.Организация КАК Организация,
	|	ВзаиморасчетыСПокупателямиОстатки.Контрагент КАК Контрагент,
	|	ВзаиморасчетыСПокупателямиОстатки.Договор КАК Договор,
	|	ВзаиморасчетыСПокупателямиОстатки.ДокументВзаиморасчетов КАК ДокументВзаиморасчетов,
	|	Выразить(ВзаиморасчетыСПокупателямиОстатки.ВидЗадолженности КАК Перечисление.ВидыЗадолженности) КАК ВидЗадолженности,
	|	ВЫБОР
	|		КОГДА ВзаиморасчетыСПокупателямиОстатки.СуммаБезНДС < 0
	|			ТОГДА -ВзаиморасчетыСПокупателямиОстатки.СуммаБезНДС
	|		ИНАЧЕ ВзаиморасчетыСПокупателямиОстатки.СуммаБезНДС
	|	КОНЕЦ КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА ВзаиморасчетыСПокупателямиОстатки.СуммаНДС < 0
	|			ТОГДА -ВзаиморасчетыСПокупателямиОстатки.СуммаНДС
	|		ИНАЧЕ ВзаиморасчетыСПокупателямиОстатки.СуммаНДС
	|	КОНЕЦ КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА ВзаиморасчетыСПокупателямиОстатки.СуммаСНДС < 0
	|			ТОГДА -ВзаиморасчетыСПокупателямиОстатки.СуммаСНДС
	|		ИНАЧЕ ВзаиморасчетыСПокупателямиОстатки.СуммаСНДС
	|	КОНЕЦ КАК СуммаСНДС
	|ПОМЕСТИТЬ ВТ_ТаблицаВзаиморасчетов
	|ИЗ
	|	&ТаблицаДвижений КАК ВзаиморасчетыСПокупателямиОстатки
	|ГДЕ
	|	ВзаиморасчетыСПокупателямиОстатки.ДокументВзаиморасчетов = &ДокументВзаиморасчетов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТаблицаВзаиморасчетов.Организация КАК Организация,
	|	ВТ_ТаблицаВзаиморасчетов.Контрагент КАК Контрагент,
	|	ВТ_ТаблицаВзаиморасчетов.Договор КАК Договор,
	|	ВТ_ТаблицаВзаиморасчетов.ДокументВзаиморасчетов КАК ДокументВзаиморасчетов,
	|	ВТ_ТаблицаВзаиморасчетов.ВидЗадолженности КАК ВидЗадолженности,
	|	ЕСТЬNULL(ВТ_ТаблицаВзаиморасчетов.ВидЗадолженности.Порядок, 99) КАК ВидЗадолженностиПорядок,
	|	ВТ_ТаблицаВзаиморасчетов.СуммаБезНДС КАК СуммаБезНДСОстаток,
	|	ВТ_ТаблицаВзаиморасчетов.СуммаНДС КАК СуммаНДСОстаток,
	|	ВТ_ТаблицаВзаиморасчетов.СуммаСНДС КАК СуммаСНДСОстаток
	|ИЗ
	|	ВТ_ТаблицаВзаиморасчетов КАК ВТ_ТаблицаВзаиморасчетов";
	Запрос.УстановитьПараметр("ТаблицаДвижений", ДвиженияВзаиморасчетов.Выгрузить());
	Запрос.УстановитьПараметр("ДокументВзаиморасчетов", ДокументВзаиморасчетов);
	//Евросиб(ДИТ), Беляев СЮ, BUG 104683 / TA 104685, 18-03-2025, начало
	Если ДокументВзаиморасчетов = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВзаиморасчетыСПокупателямиОстатки.ДокументВзаиморасчетов = &ДокументВзаиморасчетов", "ИСТИНА");
	КонецЕсли;
	//Евросиб(ДИТ), Беляев СЮ, BUG 104683 / TA 104685, 18-03-2025, конец
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

//Евросиб Каблов 29.11.2023 #75365 Перенести в модуль ВзаиморасчетыСервер
Процедура СформироватьДвиженияРазнесениеВходящихПлатежейПоСчетамПокупателей(ДокОбъект) Экспорт
	
	НаборЗаписей = ДокОбъект.Движения.РазнесениеВходящихПлатежейПоСчетамПокупателей;
	НаборЗаписей.Записывать = Истина;
	
	Если ДокОбъект.ВидОперации = Перечисления.ВидыОперацийПоступлениеДенежныхСредств.ОплатаПокупателя Тогда
		
		// приход
		Для каждого Стр из ДокОбъект.РасшифровкаПлатежа Цикл
			Запись = НаборЗаписей.ДобавитьПриход();
			Запись.Период = ДокОбъект.ДатаВзаиморасчетов;
			Запись.Контрагент = ДокОбъект.Контрагент;
			Запись.Договор = Стр.ДоговорКонтрагента;
			Запись.Поступление = ДокОбъект.Ссылка;
			Запись.Валюта = ДокОбъект.ВалютаДокумента;
			Запись.КурсВзаиморасчетов = Стр.КурсВзаиморасчетов;
			//Запись.ДокументРазнесения = ДокОбъект.Ссылка;
			Запись.Сумма = Стр.СуммаВзаиморасчетов;
		КонецЦикла;
		
		// расходы
		Если ЗначениеЗаполнено(ДокОбъект.РасшифровкаПлатежа) Тогда
			КурсВзаиморасчетов = ДокОбъект.РасшифровкаПлатежа[0].КурсВзаиморасчетов;
		Иначе
			КурсВзаиморасчетов = 1;
		КонецЕсли;
		
		Для Каждого СтрокаРазнесения из ДокОбъект.РазнесениеНаСчетаПокупателям Цикл
			Запись = НаборЗаписей.ДобавитьРасход();
			Запись.Период = ДокОбъект.ДатаВзаиморасчетов;
			Запись.Контрагент = ДокОбъект.Контрагент;
			Запись.Договор = ДокОбъект.ДоговорКонтрагента;
			Запись.Поступление = ДокОбъект.Ссылка;
			Запись.ДокументРазнесения = СтрокаРазнесения.СчетПокупателю;
			Запись.Валюта = ДокОбъект.ВалютаДокумента;
			Запись.КурсВзаиморасчетов = КурсВзаиморасчетов;
			Запись.Сумма = СтрокаРазнесения.РазнесеннаяСумма;
		КонецЦикла;		
		
	КонецЕсли;
	
КонецПроцедуры

//ДИТ, Беляев СЮ, US 80923/TA 81611, 06-03-2024, начало
Функция ПолучитьСтавкуНДСдляДокумента( Ссылка ) Экспорт
	Результат = Неопределено;
	
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		//берем ставку НДС из первой строки
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	РеализацияТоваровУслугУслуги.СтавкаНДС КАК СтавкаНДС
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.Услуги КАК РеализацияТоваровУслугУслуги
		|ГДЕ
		|	РеализацияТоваровУслугУслуги.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	РеализацияТоваровУслугУслуги.НомерСтроки";
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Результат = ВыборкаДетальныеЗаписи.СтавкаНДС;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		//берем ставку НДС из первой строки
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КорректировкаРеализацииУслуги.СтавкаНДС КАК СтавкаНДС
		|ИЗ
		|	Документ.КорректировкаРеализации.Услуги КАК КорректировкаРеализацииУслуги
		|ГДЕ
		|	КорректировкаРеализацииУслуги.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	КорректировкаРеализацииУслуги.НомерСтроки";
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Результат = ВыборкаДетальныеЗаписи.СтавкаНДС;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.КорректировкаДолга") Тогда
