//Процедура РаспределитьСуммуПоВидамЗадолженности(ДвижениеВзаиморасчетов, ДокОбъект, ОстаткиПоДокументамВзаиморасчетов, СтрокаДокумента)
//Евросиб(ДИТ), Беляев СЮ, Ticket#0382613, 16-01-2025, добавлен параметр ТаблицауОстатковПоТабличнымЧастямДокументов
//Процедура РаспределитьСуммуПоВидамЗадолженности(ДвижениеВзаиморасчетов, ДокОбъект, ОстаткиПоДокументамВзаиморасчетов, СтрокаДокумента, ТаблицаОстатковПоТабличнымЧастямДокументов = Неопределено)
//Евросиб(ДИТ), Беляев СЮ, BUG 104683 / TA 104685, 18-03-2025, добавлен параметр УпорядочиватьПоВидуЗадолженности
Процедура РаспределитьСуммуПоВидамЗадолженности(ДвижениеВзаиморасчетов, ДокОбъект, ОстаткиПоДокументамВзаиморасчетов, СтрокаДокумента, ТаблицаОстатковПоТабличнымЧастямДокументов = Неопределено, УпорядочиватьПоВидуЗадолженности = Истина)
	
		//ОстаткиПоДокументу = ОстаткиПоДокументамВзаиморасчетов.Скопировать(Новый Структура("ДокументВзаиморасчетов", ДвижениеВзаиморасчетов.ДокументВзаиморасчетов));
		//ОстаткиПоДокументу.Сортировать("ВидЗадолженностиПорядок");
		//Евросиб(ДИТ), Беляев СЮ, Ticket#0382613, 16-01-2025, начало
		//ОстаткиПоДокументамВзаиморасчетов.Сортировать("ВидЗадолженностиПорядок");
		//Евросиб(ДИТ), Беляев СЮ, BUG 104683 / TA 104685, 18-03-2025, начало
		Если УпорядочиватьПоВидуЗадолженности  Тогда
			ОстаткиПоДокументамВзаиморасчетов.Сортировать("ВидЗадолженностиПорядок");
		КонецЕсли;
		//Евросиб(ДИТ), Беляев СЮ, BUG 104683 / TA 104685, 18-03-2025, конец
		ОстаткиПоДокументу = ОстаткиПоДокументамВзаиморасчетов.НайтиСтроки(Новый Структура("ДокументВзаиморасчетов", ДвижениеВзаиморасчетов.ДокументВзаиморасчетов));
		//Евросиб(ДИТ), Беляев СЮ, Ticket#0382613, 16-01-2025, конец
		
		ОстатокСуммыОплаты = ДвижениеВзаиморасчетов.СуммаСНДС;
		Если ОстатокСуммыОплаты < 0  Тогда
			ОстатокСуммыОплаты = -ОстатокСуммыОплаты;
			КоэффициентРасчета = -1;      
		Иначе
			КоэффициентРасчета = 1;
		КонецЕсли;
		Движения = ДокОбъект.Движения;
		//Евросиб(ДИТ), Беляев СЮ, Ticket#0382613, 16-01-2025, начало
		Если ОстаткиПоДокументу.Количество() = 0 И ТаблицаОстатковПоТабличнымЧастямДокументов <> Неопределено Тогда
			ОстаткиПоДокументу = ТаблицаОстатковПоТабличнымЧастямДокументов.НайтиСтроки(Новый Структура("Документ", ДвижениеВзаиморасчетов.ДокументВзаиморасчетов));
		КонецЕсли;
		//Евросиб(ДИТ), Беляев СЮ, Ticket#0382613, 16-01-2025, конец
		Если ОстаткиПоДокументу.Количество() = 0  Тогда
			ОстаткиПоДокументу = ПолучитьТаблицуОстатковПоТабличнойЧастиДокумента(ДвижениеВзаиморасчетов.ДокументВзаиморасчетов);
		КонецЕсли;
		
		Для Каждого СтрокаОстатка Из ОстаткиПоДокументу Цикл
			
			Если ОстатокСуммыОплаты <= 0 Тогда
				Прервать;
			КонецЕсли;
			
			//Евросиб(ДИТ), Беляев СЮ, Ticket#0382613, 16-01-2025, начало
			Если СтрокаОстатка.СуммаСНДСОстаток <= 0 Тогда
				Продолжить;
			КонецЕсли;
			//Евросиб(ДИТ), Беляев СЮ, Ticket#0382613, 16-01-2025, конец
			
			СуммаОплаты = Мин(ОстатокСуммыОплаты, СтрокаОстатка.СуммаСНДСОстаток);
			ОстатокСуммыОплаты = ОстатокСуммыОплаты - СуммаОплаты;
			
			Движение = Движения.ВзаиморасчетыСПокупателями.Добавить();
			ЗаполнитьЗначенияСвойств(Движение, ДвижениеВзаиморасчетов,, "Активность");
			Движение.ВидЗадолженности = СтрокаОстатка.ВидЗадолженности;
			Движение.СуммаСНДС = СуммаОплаты * КоэффициентРасчета;
			СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(СуммаОплаты, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(СтрокаДокумента.СтавкаНДС), Истина, Истина);
			Движение.СуммаНДС = СуммаНДС * КоэффициентРасчета;
			Движение.СуммаБезНДС = (СуммаОплаты - СуммаНДС) * КоэффициентРасчета;		
			//ДИТ, Беляев СЮ, US 80923/TA 81611, 06-03-2024, начало
			Движение.СтавкаНДС = ДвижениеВзаиморасчетов.СтавкаНДС;
			//ДИТ, Беляев СЮ, US 80923/TA 81611, 06-03-2024, конец
			//Евросиб(ДИТ), Беляев СЮ, Ticket#0382613, 16-01-2025, начало
			СтрокаОстатка.СуммаСНДСОстаток = СтрокаОстатка.СуммаСНДСОстаток - СуммаОплаты;
			//Евросиб(ДИТ), Беляев СЮ, Ticket#0382613, 16-01-2025, конец
		КонецЦикла;
		
		Если ОстатокСуммыОплаты > 0 Тогда
			
			ОстаткиПоДокументу = ПолучитьТаблицуОстатковПоТабличнойЧастиДокумента(ДвижениеВзаиморасчетов.ДокументВзаиморасчетов);
			ВидЗадолженности = Неопределено;
			Если ОстаткиПоДокументу.Количество() > 0 Тогда
				ВидЗадолженности = ОстаткиПоДокументу[0].ВидЗадолженности;
			КонецЕсли;

			СуммаОплаты = ОстатокСуммыОплаты;
			
			Движение = Движения.ВзаиморасчетыСПокупателями.Добавить();
			ЗаполнитьЗначенияСвойств(Движение, ДвижениеВзаиморасчетов,, "Активность");
			Движение.ВидЗадолженности = ВидЗадолженности;
			Движение.СуммаСНДС = СуммаОплаты * КоэффициентРасчета;
			СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(СуммаОплаты, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(СтрокаДокумента.СтавкаНДС), Истина, Истина);
			Движение.СуммаНДС = СуммаНДС * КоэффициентРасчета;
			Движение.СуммаБезНДС = (СуммаОплаты - СуммаНДС) * КоэффициентРасчета;		
			//ДИТ, Беляев СЮ, US 80923/TA 81611, 06-03-2024, начало
			Движение.СтавкаНДС = ДвижениеВзаиморасчетов.СтавкаНДС;
			//ДИТ, Беляев СЮ, US 80923/TA 81611, 06-03-2024, конец
		КонецЕсли;
	
КонецПроцедуры 
	
//Функция ПолучитьТаблицуОстатковВзаиморасчетов(ДокОбъект, ДатаОплаты = Неопределено)
//Евросиб(ДИТ), Беляев СЮ, Ticket#0382613, 16-01-2025, добавлен параметр "ОстатокНаТекущийМомент"
Функция ПолучитьТаблицуОстатковВзаиморасчетов(ДокОбъект, ДатаОплаты = Неопределено, ОстатокНаТекущийМомент = Ложь)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВзаиморасчетыСПокупателямиОстатки.Организация КАК Организация,
	|	ВзаиморасчетыСПокупателямиОстатки.Контрагент КАК Контрагент,
	|	ВзаиморасчетыСПокупателямиОстатки.Договор КАК Договор,
	|	ВзаиморасчетыСПокупателямиОстатки.ДокументВзаиморасчетов КАК ДокументВзаиморасчетов,
	//|	ВзаиморасчетыСПокупателямиОстатки.ВалютаРасчетов КАК ВалютаРасчетов,
	//|	ВзаиморасчетыСПокупателямиОстатки.ДатаРасчетов КАК ДатаРасчетов,
	//|	ВзаиморасчетыСПокупателямиОстатки.ЭтоВР КАК ЭтоВР,
	|	ВзаиморасчетыСПокупателямиОстатки.ВидЗадолженности КАК ВидЗадолженности,
	|	ЕСТЬNULL(ВзаиморасчетыСПокупателямиОстатки.ВидЗадолженности.Порядок, 99) КАК ВидЗадолженностиПорядок,
	|	ВЫБОР
	|		КОГДА ВзаиморасчетыСПокупателямиОстатки.СуммаБезНДСОстаток < 0
	|			ТОГДА -ВзаиморасчетыСПокупателямиОстатки.СуммаБезНДСОстаток
	|		ИНАЧЕ ВзаиморасчетыСПокупателямиОстатки.СуммаБезНДСОстаток
	|	КОНЕЦ КАК СуммаБезНДСОстаток,
	|	ВЫБОР
	|		КОГДА ВзаиморасчетыСПокупателямиОстатки.СуммаНДСОстаток < 0
	|			ТОГДА -ВзаиморасчетыСПокупателямиОстатки.СуммаНДСОстаток
	|		ИНАЧЕ ВзаиморасчетыСПокупателямиОстатки.СуммаНДСОстаток
	|	КОНЕЦ КАК СуммаНДСОстаток,
	|	ВЫБОР
	|		КОГДА ВзаиморасчетыСПокупателямиОстатки.СуммаСНДСОстаток < 0
	|			ТОГДА -ВзаиморасчетыСПокупателямиОстатки.СуммаСНДСОстаток
	|		ИНАЧЕ ВзаиморасчетыСПокупателямиОстатки.СуммаСНДСОстаток
	|	КОНЕЦ КАК СуммаСНДСОстаток
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСПокупателями.Остатки(
	|			&Период,
	|			ДокументВзаиморасчетов В (&ДокументыВзаиморасчетов)
	|				И Организация В (&Организация)
	|				И Контрагент В (&Контрагент)
	|				И Договор В (&Договор)) КАК ВзаиморасчетыСПокупателямиОстатки
	//Евросиб(ДИТ), Беляев СЮ, BUG 106982 / TA 106985, 18-04-2025, начало (имеются ошибки закрытия ресурсов СуммаБезНДСОстаток, СуммаНДСОстаток при закрытом СуммаСНДСОстаток - сумма которого нам и нужна для распределения)
	|ГДЕ ВзаиморасчетыСПокупателямиОстатки.СуммаСНДСОстаток <> 0
	//Евросиб(ДИТ), Беляев СЮ, BUG 106982 / TA 106985, 18-04-2025, конец
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидЗадолженностиПорядок";

	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.КорректировкаДолга") Тогда
		МассивКонтрагентов = Новый Массив;
		МассивКонтрагентов.Добавить(ДокОбъект.КонтрагентДебитор);
		МассивКонтрагентов.Добавить(ДокОбъект.КонтрагентКредитор); 
		
		МассивДоговоров = ДокОбъект.ДебиторскаяЗадолженность.ВыгрузитьКолонку("ДоговорКонтрагента");
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивДоговоров, ДокОбъект.КредиторскаяЗадолженность.ВыгрузитьКолонку("ДоговорКонтрагента"), Истина);
		
		
		МассивДокументовВзаиморасчетов = ДокОбъект.ДебиторскаяЗадолженность.ВыгрузитьКолонку("Сделка");
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивДокументовВзаиморасчетов, ДокОбъект.КредиторскаяЗадолженность.ВыгрузитьКолонку("Сделка"), Истина);
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.СписаниеСРасчетногоСчета") Тогда	
		МассивКонтрагентов = Новый Массив;
		МассивКонтрагентов.Добавить(ДокОбъект.Контрагент);
		
		МассивДоговоров = ДокОбъект.РасшифровкаПлатежа.ВыгрузитьКолонку("ДоговорКонтрагента");
		
		МассивДокументовВзаиморасчетов = ДокОбъект.РасшифровкаПлатежа.ВыгрузитьКолонку("Сделка"); 
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеНаРасчетныйСчет")  Тогда
		МассивКонтрагентов = Новый Массив;
		МассивКонтрагентов.Добавить(ДокОбъект.Контрагент);
		
		МассивДоговоров = ДокОбъект.ДоговорКонтрагента;
		
		МассивДокументовВзаиморасчетов = ДокОбъект.ДокументыОплаты.ВыгрузитьКолонку("ДокументРеализации"); 
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДокументыВзаиморасчетов", МассивДокументовВзаиморасчетов);
	Запрос.УстановитьПараметр("Организация", ДокОбъект.Организация);
	Запрос.УстановитьПараметр("Контрагент", МассивКонтрагентов);
	Запрос.УстановитьПараметр("Договор", МассивДоговоров);
	//Запрос.УстановитьПараметр("Период", ДокОбъект.Дата);
	Запрос.УстановитьПараметр("Период", Новый Граница(?(ДатаОплаты = Неопределено, ДокОбъект.Дата, ДатаОплаты), ВидГраницы.Включая));
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0382613, 16-01-2025, начало
	Если ОстатокНаТекущийМомент = Истина Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Период", "");
	КонецЕсли;
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0382613, 16-01-2025, начало
		
	ОстаткиПоДокументамВзаиморасчетов = Запрос.Выполнить().Выгрузить();
	Возврат ОстаткиПоДокументамВзаиморасчетов;
		
КонецФункции

Функция ПолучитьТаблицуОстатковПоТабличнойЧастиДокумента(ДокументВзаиморасчетов)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РеализацияТоваровУслугУслуги.СуммаНДС КАК СуммаНДСОстаток,
	|	ВЫБОР
	|		КОГДА РеализацияТоваровУслугУслуги.Ссылка.СуммаВключаетНДС
	|			ТОГДА РеализацияТоваровУслугУслуги.Сумма
	|		ИНАЧЕ РеализацияТоваровУслугУслуги.Сумма + РеализацияТоваровУслугУслуги.СуммаНДС
	|	КОНЕЦ КАК СуммаСНДСОстаток,
	|	РеализацияТоваровУслугУслуги.Сумма КАК СуммаБезНДСОстаток,
	|	РеализацияТоваровУслугУслуги.Ссылка КАК ДокументВзаиморасчетов,
	|	РеализацияТоваровУслугУслуги.ВидЗадолженности КАК ВидЗадолженности,
	|	РеализацияТоваровУслугУслуги.ВидЗадолженности.Порядок КАК ВидЗадолженностиПорядок
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Услуги КАК РеализацияТоваровУслугУслуги
	|ГДЕ
	|	РеализацияТоваровУслугУслуги.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РеализацияТоваровУслугУслуги.СуммаНДС,
	|	ВЫБОР
	|		КОГДА РеализацияТоваровУслугУслуги.Ссылка.СуммаВключаетНДС
	|			ТОГДА РеализацияТоваровУслугУслуги.Сумма
	|		ИНАЧЕ РеализацияТоваровУслугУслуги.Сумма + РеализацияТоваровУслугУслуги.СуммаНДС
	|	КОНЕЦ,
	|	РеализацияТоваровУслугУслуги.Сумма,
	|	РеализацияТоваровУслугУслуги.Ссылка.ДокументРеализации,
	|	РеализацияТоваровУслугУслуги.ВидЗадолженности,
	|	РеализацияТоваровУслугУслуги.ВидЗадолженности.Порядок
	|ИЗ
	|	Документ.КорректировкаРеализации.Услуги КАК РеализацияТоваровУслугУслуги
	|ГДЕ
	|	РеализацияТоваровУслугУслуги.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидЗадолженностиПорядок";
	Запрос.УстановитьПараметр("Ссылка", ДокументВзаиморасчетов);
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаРезультата = РезультатЗапроса.Выгрузить();
	Возврат ТаблицаРезультата;
	
КонецФункции

