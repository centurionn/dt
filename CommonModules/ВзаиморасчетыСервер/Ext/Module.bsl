
//Евросиб Каблов 07.10.2022 54532
Процедура ОтчетКомитенту_СформироватьДвиженияВзаиморасчетыСПокупателями(ДокОбъект) Экспорт

	ВзаиморасчетыСПокупателями = ДокОбъект.Движения.ВзаиморасчетыСПокупателями;
	ВзаиморасчетыСПокупателями.Записывать = Истина;
	
	//ДИТ, Беляев СЮ, US 80923/TA 81611, 06-03-2024, начало
	СтавкаНДС = ПолучитьСтавкуНДСдляДокумента( ДокОбъект.Ссылка );
	//ДИТ, Беляев СЮ, US 80923/TA 81611, 06-03-2024, конец
	
	Если ДокОбъект.ВидОперации = Перечисления.ВидыОперацийОтчетКомитентуОПродажах.ОтчетОЗакупках Тогда
		
		Для Каждого СтрокаТЧ Из ДокОбъект.Товары Цикл
			
			Движение = ВзаиморасчетыСПокупателями.ДобавитьРасход();
			Движение.Период = Макс(ДокОбъект.ДатаДокумента, ДокОбъект.ПериодВО);
			Движение.Организация = ДокОбъект.Организация;
			Движение.Контрагент = ДокОбъект.Контрагент;
			Движение.Договор = ДокОбъект.ДоговорКонтрагента;
			Движение.ВалютаРасчетов = ДокОбъект.ВалютаДокумента;
			Движение.ДатаРасчетов = ДокОбъект.ДатаДокумента;
			Движение.ДокументВзаиморасчетов = ДокОбъект.Ссылка;
			Движение.ВидЗадолженности = СтрокаТЧ.ВидЗадолженности;
			
			Движение.СуммаБезНДС = ?(ДокОбъект.СуммаВключаетНДС, СтрокаТЧ.Сумма - СтрокаТЧ.СуммаНДС, СтрокаТЧ.Сумма);
			Движение.СуммаНДС = СтрокаТЧ.СуммаНДС;
			Движение.СуммаСНДС = ?(ДокОбъект.СуммаВключаетНДС, СтрокаТЧ.Сумма, СтрокаТЧ.Сумма + СтрокаТЧ.СуммаНДС);
			Движение.ЭтоВР = Истина;
			
			//ДИТ, Беляев СЮ, US 80923/TA 81611, 06-03-2024, начало
			Движение.СтавкаНДС = СтавкаНДС;
			//ДИТ, Беляев СЮ, US 80923/TA 81611, 06-03-2024, конец
			
			// Вознагражение
			Если ДокОбъект.СпособРасчетаКомиссионногоВознаграждения <> Перечисления.СпособыРасчетаКомиссионногоВознаграждения.НеРассчитывается Тогда
				
				Движение = ВзаиморасчетыСПокупателями.ДобавитьРасход();
				Движение.Период = Макс(ДокОбъект.ДатаДокумента, ДокОбъект.ПериодВО);
				Движение.Организация = ДокОбъект.Организация;
				Движение.Контрагент = ДокОбъект.Контрагент;
				Движение.Договор = ДокОбъект.ДоговорКонтрагента;
				Движение.ВалютаРасчетов = ДокОбъект.ВалютаДокумента;
				Движение.ДатаРасчетов = ДокОбъект.ДатаДокумента;
				Движение.ДокументВзаиморасчетов = ДокОбъект.Ссылка;
				Движение.ВидЗадолженности = СтрокаТЧ.ВидЗадолженности;
				
				Движение.СуммаБезНДС = ?(ДокОбъект.СуммаВознагражденияВключаетНДС, СтрокаТЧ.СуммаВознаграждения - СтрокаТЧ.СуммаНДСВознаграждения, СтрокаТЧ.СуммаВознаграждения);
				Движение.СуммаНДС = СтрокаТЧ.СуммаНДСВознаграждения;
				Движение.СуммаСНДС = ?(ДокОбъект.СуммаВознагражденияВключаетНДС, СтрокаТЧ.СуммаВознаграждения, СтрокаТЧ.СуммаВознаграждения + СтрокаТЧ.СуммаНДСВознаграждения);
				
				//ДИТ, Беляев СЮ, US 80923/TA 81611, 06-03-2024, начало
				Движение.СтавкаНДС = СтавкаНДС;
				//ДИТ, Беляев СЮ, US 80923/TA 81611, 06-03-2024, конец
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
		
КонецПроцедуры

//Евросиб Каблов 07.10.2022 54532
Процедура РеализацияТоваровУслуг_СформироватьДвиженияВзаиморасчетыСПокупателями(ДокОбъект) Экспорт
	
	ВзаиморасчетыСПокупателями = ДокОбъект.Движения.ВзаиморасчетыСПокупателями;
	ВзаиморасчетыСПокупателями.Записывать = Истина;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.ВидЗадолженности КАК ВидЗадолженности,
	|	СУММА(ВложенныйЗапрос.СуммаНДС) КАК СуммаНДС,
	|	СУММА(ВложенныйЗапрос.СуммаСНДС) КАК СуммаСНДС,
	|	СУММА(ВложенныйЗапрос.СуммаБезНДС) КАК СуммаБезНДС
	|ИЗ
	|	(ВЫБРАТЬ
	|		РеализацияТоваровУслугТовары.ВидЗадолженности КАК ВидЗадолженности,
	|		ВЫБОР
	|			КОГДА РеализацияТоваровУслугТовары.Ссылка.СуммаВключаетНДС
	|				ТОГДА РеализацияТоваровУслугТовары.Сумма - РеализацияТоваровУслугТовары.СуммаНДС
	|			ИНАЧЕ РеализацияТоваровУслугТовары.Сумма
	|		КОНЕЦ КАК СуммаБезНДС,
	|		РеализацияТоваровУслугТовары.СуммаНДС КАК СуммаНДС,
	|		РеализацияТоваровУслугТовары.Ссылка.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|		ВЫБОР
	|			КОГДА РеализацияТоваровУслугТовары.Ссылка.СуммаВключаетНДС
	|				ТОГДА РеализацияТоваровУслугТовары.Сумма
	|			ИНАЧЕ РеализацияТоваровУслугТовары.Сумма + РеализацияТоваровУслугТовары.СуммаНДС
	|		КОНЕЦ КАК СуммаСНДС
	|	ИЗ
	|		Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|	ГДЕ
	|		РеализацияТоваровУслугТовары.Ссылка = &Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		РеализацияТоваровУслугУслуги.ВидЗадолженности,
	|		ВЫБОР
	|			КОГДА РеализацияТоваровУслугУслуги.Ссылка.СуммаВключаетНДС
	|				ТОГДА РеализацияТоваровУслугУслуги.Сумма - РеализацияТоваровУслугУслуги.СуммаНДС
	|			ИНАЧЕ РеализацияТоваровУслугУслуги.Сумма
	|		КОНЕЦ,
	|		РеализацияТоваровУслугУслуги.СуммаНДС,
	|		РеализацияТоваровУслугУслуги.Ссылка.СуммаВключаетНДС,
	|		ВЫБОР
	|			КОГДА РеализацияТоваровУслугУслуги.Ссылка.СуммаВключаетНДС
	|				ТОГДА РеализацияТоваровУслугУслуги.Сумма
	|			ИНАЧЕ РеализацияТоваровУслугУслуги.Сумма + РеализацияТоваровУслугУслуги.СуммаНДС
	|		КОНЕЦ
	|	ИЗ
	|		Документ.РеализацияТоваровУслуг.Услуги КАК РеализацияТоваровУслугУслуги
	|	ГДЕ
	|		РеализацияТоваровУслугУслуги.Ссылка = &Ссылка) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.ВидЗадолженности";
	Запрос.УстановитьПараметр("Ссылка", ДокОбъект.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	//ДИТ, Беляев СЮ, US 80923/TA 81611, 06-03-2024, начало
	СтавкаНДС = ПолучитьСтавкуНДСдляДокумента( ДокОбъект.Ссылка );
	//ДИТ, Беляев СЮ, US 80923/TA 81611, 06-03-2024, конец
	
	Пока Выборка.Следующий() Цикл
			
		Движение = ВзаиморасчетыСПокупателями.ДобавитьРасход();
		Движение.Период = Макс(ДокОбъект.ДатаДокумента, ДокОбъект.ПериодВО);
		Движение.Организация = ДокОбъект.Организация;
		Движение.Контрагент = ДокОбъект.Контрагент;
		Движение.Договор = ДокОбъект.ДоговорКонтрагента;
		Движение.ВалютаРасчетов = ДокОбъект.ВалютаДокумента;
		Движение.ДатаРасчетов = ДокОбъект.ДатаДокумента;
		Движение.ДокументВзаиморасчетов = ДокОбъект.Ссылка;
		//ДИТ, Беляев СЮ, US 80923/TA 81611, 06-03-2024, начало
		Движение.СтавкаНДС = СтавкаНДС;
		//ДИТ, Беляев СЮ, US 80923/TA 81611, 06-03-2024, конец
		ЗаполнитьЗначенияСвойств(Движение, Выборка);
		
	КонецЦикла;
		
КонецПроцедуры

//Евросиб Каблов 07.10.2022 54532
Процедура ПоступлениеНаРасчетныйСчет_СформироватьДвиженияВзаиморасчетыСПокупателями(ДокОбъект) Экспорт
	
	Движения = ДокОбъект.Движения;
	ВзаиморасчетыСПокупателями = Движения.ВзаиморасчетыСПокупателями;
	ВзаиморасчетыСПокупателями.Записать();
	ВзаиморасчетыСПокупателями.Записывать = Истина;
	
	КопияТаблицыДвижений = Движения.ВзаиморасчетыСПокупателями.Выгрузить();
	КопияТаблицыДвижений.Очистить(); 
	//ТаблицаОстатковВзаиморасчетов = ПолучитьТаблицуОстатковВзаиморасчетов(ДокОбъект); //Евросиб(ДИТ), Беляев СЮ, Ticket#0382613, 16-01-2025, закомментировал, не используется
	
	//ДИТ, Беляев СЮ, US 80923/TA 81611, 06-03-2024, начало
	СтавкаНДС = ПолучитьСтавкуНДСдляДокумента( ДокОбъект.Ссылка );
	//ДИТ, Беляев СЮ, US 80923/TA 81611, 06-03-2024, конец
	
	Для каждого Стр из ДокОбъект.РасшифровкаПлатежа Цикл
		
		Если ДокОбъект.ВидОперации = Перечисления.ВидыОперацийПоступлениеДенежныхСредств.ОплатаПокупателя Тогда
			
			Движение = ВзаиморасчетыСПокупателями.ДобавитьПриход();
			Движение.Период = ДокОбъект.ДатаВзаиморасчетов;
			Движение.Организация = ДокОбъект.Организация;
			Движение.Контрагент = ДокОбъект.Контрагент;
			Движение.Договор = ДокОбъект.ДоговорКонтрагента;
			// Субботин TASK 72390 18.07.2023  Начало 
			Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокОбъект.ДоговорКонтрагента,"РасчетыВУсловныхЕдиницах") тогда
				Движение.ВалютаРасчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокОбъект.ДоговорКонтрагента,"ВалютаВзаиморасчетов");
			Иначе 
				Движение.ВалютаРасчетов = ДокОбъект.ВалютаДокумента;
			КонецЕсли;
			// Субботин TASK 72390 18.07.2023  Конец
			
			Движение.ДатаРасчетов = ДокОбъект.Дата;
			Движение.ДокументВзаиморасчетов = ДокОбъект.Ссылка;
			Движение.ВидЗадолженности = Перечисления.ВидыЗадолженности.НепривязанныеДеньги;
			Движение.СуммаСНДС = Стр.СуммаВзаиморасчетов;
			СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(Стр.СуммаВзаиморасчетов, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(ДокОбъект.СтавкаНДС), Истина, Истина);
			Движение.СуммаНДС = СуммаНДС;
			Движение.СуммаБезНДС = Стр.СуммаВзаиморасчетов - СуммаНДС;
			//ДИТ, Беляев СЮ, US 80923/TA 81611, 06-03-2024, начало
			Движение.СтавкаНДС = СтавкаНДС;
			//ДИТ, Беляев СЮ, US 80923/TA 81611, 06-03-2024, конец
		КонецЕсли;
		
	КонецЦикла;
	
	//Запрос = Новый Запрос;
	//Запрос.Текст =
	//"ВЫБРАТЬ
	//|	ВзаиморасчетыСПокупателямиОстатки.Организация КАК Организация,
	//|	ВзаиморасчетыСПокупателямиОстатки.Контрагент КАК Контрагент,
	//|	ВзаиморасчетыСПокупателямиОстатки.Договор КАК Договор,
	//|	ВзаиморасчетыСПокупателямиОстатки.ДокументВзаиморасчетов КАК ДокументВзаиморасчетов,
	//|	ВзаиморасчетыСПокупателямиОстатки.ВалютаРасчетов КАК ВалютаРасчетов,
	//|	ВзаиморасчетыСПокупателямиОстатки.ДатаРасчетов КАК ДатаРасчетов,
	//|	ВзаиморасчетыСПокупателямиОстатки.ЭтоВР КАК ЭтоВР,
	//|	ВзаиморасчетыСПокупателямиОстатки.ВидЗадолженности КАК ВидЗадолженности,
	//|	ВзаиморасчетыСПокупателямиОстатки.ВидЗадолженности.Порядок КАК ВидЗадолженностиПорядок,
	//|	-ВзаиморасчетыСПокупателямиОстатки.СуммаБезНДСОстаток КАК СуммаБезНДСОстаток,
	//|	-ВзаиморасчетыСПокупателямиОстатки.СуммаНДСОстаток КАК СуммаНДСОстаток,
	//|	-ВзаиморасчетыСПокупателямиОстатки.СуммаСНДСОстаток КАК СуммаСНДСОстаток
	//|ИЗ
	//|	РегистрНакопления.ВзаиморасчетыСПокупателями.Остатки(
	//|			,
	//|			ДокументВзаиморасчетов В (&ДокументыВзаиморасчетов)
	//|				И Организация = &Организация
	//|				И Контрагент = &Контрагент
	//|				И Договор = &Договор) КАК ВзаиморасчетыСПокупателямиОстатки
	//|ГДЕ
	//|	ВзаиморасчетыСПокупателямиОстатки.СуммаСНДСОстаток < 0";
	//
	//Запрос.УстановитьПараметр("ДокументыВзаиморасчетов", ДокОбъект.ДокументыОплаты.Выгрузить(, "ДокументРеализации"));
	//Запрос.УстановитьПараметр("Организация", ДокОбъект.Организация);
	//Запрос.УстановитьПараметр("Контрагент", ДокОбъект.Контрагент);
	//Запрос.УстановитьПараметр("Договор", ДокОбъект.ДоговорКонтрагента);
	//	
	//ОстаткиПоДокументамВзаиморасчетов = Запрос.Выполнить().Выгрузить();	
	
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0382613, 16-01-2025, начало
	МассивДокументовРеализации = ДокОбъект.ДокументыОплаты.Выгрузить().ВыгрузитьКолонку("ДокументРеализации");
	ТаблицаОстатковПоТабличнойЧастиДокументов = ПолучитьТаблицуОстатковПоТабличнойЧастиДокументов(МассивДокументовРеализации);
	ТаблицаОстатковВзаиморасчетовНаТекущийМомент = ПолучитьТаблицуОстатковВзаиморасчетов(ДокОбъект, , Истина); //для распределения остаток надо получать на текущий момент за минусом движений этого документа (очистили движения выше)
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0382613, 16-01-2025, конец
	
	//Для Каждого Стр Из ДокОбъект.ДокументыОплаты Цикл
	//Евросиб(ДИТ), Беляев СЮ, BUG 104683 / TA 104685, 18-03-2025, начало
	МассивДокументовРеализации = Взаимодействия.УдалитьПовторяющиесяЭлементыМассива(МассивДокументовРеализации, Истина);
	МассивДокументовРеализацииДляСторнирования = Новый Массив;
	//ПЕРВЫМ ПРОХОДОМ БУДУТ ОБРАБОТАНЫ ПОЛОЖИТЕЛЬНЫЕ СУММЫ - РАЗНЕСЕНИЕ ОПЛАТ
	//ВТОРЫМ ПРОХОДОМ ОТРИЦАТЕЛЬНЫЕ СУММЫ - СТОРНО, Т.К. ИХ РАСЧЕТ ЗАВИСИТ ОТ ПОЛОЖИТЕЛЬНЫХ СУММ
	Для Каждого ТекущийДокументРеализации Из МассивДокументовРеализации Цикл
		
		//подготовка таблицы распределения сумм по видам задолженности
		ТаблицаСумм = Новый ТаблицаЗначений;
		ТаблицаСумм = ТаблицаОстатковВзаиморасчетовНаТекущийМомент.Скопировать(Новый Структура("ДокументВзаиморасчетов", ТекущийДокументРеализации), "ДокументВзаиморасчетов, СуммаСНДСОстаток");
		ТаблицаСумм.Свернуть("ДокументВзаиморасчетов", "СуммаСНДСОстаток");
		РаспределениеПоВидамЗадолженностиШаблон = ТаблицаОстатковВзаиморасчетовНаТекущийМомент.Скопировать(Новый Структура("ДокументВзаиморасчетов", ТекущийДокументРеализации), "ВидЗадолженности, ВидЗадолженностиПорядок, СуммаСНДСОстаток");
