Функция ПолучитьТаблицуИтогов(ДокОбъект)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.ВидЗадолженности КАК ВидЗадолженности,
	|	СУММА(ВложенныйЗапрос.УслугиСумма) КАК УслугиСумма,
	|	СУММА(ВложенныйЗапрос.УслугиСуммаНДС) КАК УслугиСуммаНДС,
	|	СУММА(ВложенныйЗапрос.УслугиСуммаДоИзменения) КАК УслугиСуммаДоИзменения,
	|	СУММА(ВложенныйЗапрос.УслугиСуммаНДСДоИзменения) КАК УслугиСуммаНДСДоИзменения,
	|	СУММА(ВложенныйЗапрос.УслугиСуммаДоКорректировки) КАК УслугиСуммаДоКорректировки,
	|	СУММА(ВложенныйЗапрос.УслугиСуммаНДСДоКорректировки) КАК УслугиСуммаНДСДоКорректировки,
	|	СУММА(ВложенныйЗапрос.УслугиВсегоДоКорректировки) КАК УслугиВсегоДоКорректировки,
	|	СУММА(ВложенныйЗапрос.УслугиВсегоДоИзменения) КАК УслугиВсегоДоИзменения,
	|	СУММА(ВложенныйЗапрос.УслугиВсего) КАК УслугиВсего,
	|	СУММА(ВложенныйЗапрос.ТоварыСумма) КАК ТоварыСумма,
	|	СУММА(ВложенныйЗапрос.ТоварыСуммаНДС) КАК ТоварыСуммаНДС,
	|	СУММА(ВложенныйЗапрос.ТоварыСуммаДоИзменения) КАК ТоварыСуммаДоИзменения,
	|	СУММА(ВложенныйЗапрос.ТоварыСуммаНДСДоИзменения) КАК ТоварыСуммаНДСДоИзменения,
	|	СУММА(ВложенныйЗапрос.ТоварыСуммаДоКорректировки) КАК ТоварыСуммаДоКорректировки,
	|	СУММА(ВложенныйЗапрос.ТоварыСуммаНДСДоКорректировки) КАК ТоварыСуммаНДСДоКорректировки
	|ИЗ
	|	(ВЫБРАТЬ
	|		КорректировкаРеализацииУслуги.ВидЗадолженности КАК ВидЗадолженности,
	|		СУММА(КорректировкаРеализацииУслуги.Сумма) КАК УслугиСумма,
	|		СУММА(КорректировкаРеализацииУслуги.СуммаНДС) КАК УслугиСуммаНДС,
	|		СУММА(КорректировкаРеализацииУслуги.СуммаДоИзменения) КАК УслугиСуммаДоИзменения,
	|		СУММА(КорректировкаРеализацииУслуги.СуммаНДСДоИзменения) КАК УслугиСуммаНДСДоИзменения,
	|		СУММА(КорректировкаРеализацииУслуги.СуммаДоКорректировки) КАК УслугиСуммаДоКорректировки,
	|		СУММА(КорректировкаРеализацииУслуги.СуммаНДСДоКорректировки) КАК УслугиСуммаНДСДоКорректировки,
	|		СУММА(КорректировкаРеализацииУслуги.ВсегоДоКорректировки) КАК УслугиВсегоДоКорректировки,
	|		СУММА(КорректировкаРеализацииУслуги.ВсегоДоИзменения) КАК УслугиВсегоДоИзменения,
	|		СУММА(КорректировкаРеализацииУслуги.Всего) КАК УслугиВсего,
	|		0 КАК ТоварыСумма,
	|		0 КАК ТоварыСуммаНДС,
	|		0 КАК ТоварыСуммаДоИзменения,
	|		0 КАК ТоварыСуммаНДСДоИзменения,
	|		0 КАК ТоварыСуммаДоКорректировки,
	|		0 КАК ТоварыСуммаНДСДоКорректировки
	|	ИЗ
	|		Документ.КорректировкаРеализации.Услуги КАК КорректировкаРеализацииУслуги
	|	ГДЕ
	|		КорректировкаРеализацииУслуги.Ссылка = &Ссылка
	|	
	|	СГРУППИРОВАТЬ ПО
	|		КорректировкаРеализацииУслуги.ВидЗадолженности
	|	
	|	ОБЪЕДИНИТЬ
	|	
	|	ВЫБРАТЬ
	|		ВидыЗадолженности.Ссылка,
	|		0,
	|		0,
	|		0,
	|		0,
	|		0,
	|		0,
	|		0,
	|		0,
	|		0,
	|		СУММА(КорректировкаРеализацииТовары.Сумма),
	|		СУММА(КорректировкаРеализацииТовары.СуммаНДС),
	|		СУММА(КорректировкаРеализацииТовары.СуммаДоИзменения),
	|		СУММА(КорректировкаРеализацииТовары.СуммаНДСДоИзменения),
	|		СУММА(КорректировкаРеализацииТовары.СуммаДоКорректировки),
	|		СУММА(КорректировкаРеализацииТовары.СуммаНДСДоКорректировки)
	|	ИЗ
	|		Документ.КорректировкаРеализации.Товары КАК КорректировкаРеализацииТовары
	|			ЛЕВОЕ СОЕДИНЕНИЕ Перечисление.ВидыЗадолженности КАК ВидыЗадолженности
	|			ПО (ВидыЗадолженности.Ссылка = ЗНАЧЕНИЕ(Перечисление.ВидыЗадолженности.ОсновнойДолг))
	|	ГДЕ
	|		КорректировкаРеализацииТовары.Ссылка = &Ссылка
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ВидыЗадолженности.Ссылка) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.ВидЗадолженности";
	Запрос.УстановитьПараметр("Ссылка", ДокОбъект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка;
	
