Процедура СписаниеСРасчетногоСчета_СформированитьДвиженияВзаиморасчетыСПокупателями(ДокОбъект) Экспорт
	
	Движения = ДокОбъект.Движения;
	
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0372604, 25-10-2024, начало
	Движения.ВзаиморасчетыСПокупателями.Записывать = Истина;
	Движения.ВзаиморасчетыСПокупателями.Записать();
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0372604, 25-10-2024, конец
	
	Движения.ВзаиморасчетыСПокупателями.Записывать = Истина;
	ДвиженияДС = Движения.ДвиженияДенежныхСредств;
	ДвиженияДС.Записывать = Истина;
	
	ВидОперации 		= ДокОбъект.ВидОперации;
	РасшифровкаПлатежа 	= ДокОбъект.РасшифровкаПлатежа;
	Дата 				= ДокОбъект.Дата;
	Организация 		= ДокОбъект.Организация;
	Контрагент 			= ДокОбъект.Контрагент;
	ДоговорКонтрагента 	= ДокОбъект.ДоговорКонтрагента;
	ВалютаДокумента 	= ДокОбъект.ВалютаДокумента;
	СчетОрганизации 	= ДокОбъект.СчетОрганизации;
	Ссылка 				= ДокОбъект.Ссылка;
	СуммаНДСДокумента	= ДокОбъект.СуммаНДСДокумента;
	СуммаДокумента		= ДокОбъект.СуммаДокумента;
	
	ПараметрыКурсаРегл = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Константы.ВалютаРегламентированногоУчета.Получить(), Дата);
	ПараметрыКурсаДокумента = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаДокумента, Дата);

	КопияТаблицыДвижений = Движения.ВзаиморасчетыСПокупателями.Выгрузить();
	КопияТаблицыДвижений.Очистить(); 
	ТаблицаОстатковВзаиморасчетов = ПолучитьТаблицуОстатковВзаиморасчетов(ДокОбъект);

	Если ВидОперации = Перечисления.ВидыОперацийСписаниеДенежныхСредств.ВозвратПокупателю Тогда
		Если РасшифровкаПлатежа.Количество() > 0 Тогда
			Для Каждого СтрокаТЧ Из РасшифровкаПлатежа Цикл
				//Движение = Движения.ВзаиморасчетыСПокупателями.ДобавитьРасход();
				Движение = КопияТаблицыДвижений.Добавить();
				Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
				Движение.Период = Дата;
				Движение.Организация = Организация;
				Движение.Контрагент = Контрагент;
				Движение.Договор = ДоговорКонтрагента;
				Движение.ДокументВзаиморасчетов = СтрокаТЧ.Сделка;
				Движение.ВалютаРасчетов = ВалютаДокумента;
				Движение.ДатаРасчетов = Дата;
				Движение.СуммаНДС = СтрокаТЧ.СуммаНДС;
				Движение.СуммаСНДС = СтрокаТЧ.СуммаВзаиморасчетов;
				Движение.СуммаБезНДС = СтрокаТЧ.СуммаВзаиморасчетов - СтрокаТЧ.СуммаНДС;
				//ДИТ, Беляев СЮ, US 80923/TA 81611, 06-03-2024, начало
				Движение.СтавкаНДС = ПолучитьСтавкуНДСдляДокумента( Движение.ДокументВзаиморасчетов );
				//ДИТ, Беляев СЮ, US 80923/TA 81611, 06-03-2024, конец
				РаспределитьСуммуПоВидамЗадолженности(Движение, ДокОбъект, ТаблицаОстатковВзаиморасчетов, СтрокаТЧ);
				
				//Евросиб Каблов М.Б. 19.11.2019 (
				//Движения денежных средств
				Движение = ДвиженияДС.Добавить();		
				//Измерения
				Движение.Период = Дата;
				Движение.ПриходРасход = Перечисления.ВидыДвиженийПриходРасход.Расход;
				Движение.Организация = Организация;
				Движение.БанковскийСчет = СчетОрганизации;
				Движение.СтатьяДвиженияДенежныхСредств = СтрокаТЧ.СтатьяДвиженияДенежныхСредств;
				Движение.Контрагент = Контрагент;
				Движение.ДоговорКонтрагента = ДоговорКонтрагента;
				Движение.ДокументДвижения = Ссылка;				
				//Ресурсы
				Движение.СуммаВал = СтрокаТЧ.СуммаВзаиморасчетов;
				Движение.Сумма = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(СтрокаТЧ.СуммаВзаиморасчетов, ПараметрыКурсаДокумента, ПараметрыКурсаРегл);
			КонецЦикла;
		Иначе
			Движение = КопияТаблицыДвижений.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = Дата;
			Движение.Организация = Организация;
			Движение.Контрагент = Контрагент;
			Движение.Договор = ДоговорКонтрагента;
			Движение.ВалютаРасчетов = ВалютаДокумента;
			Движение.ДатаРасчетов = Дата;
			Движение.СуммаНДС = СуммаНДСДокумента;
			Движение.СуммаСНДС = СуммаДокумента;
			Движение.СуммаБезНДС = СуммаДокумента - СуммаНДСДокумента;
			//ДИТ, Беляев СЮ, US 80923/TA 81611, 06-03-2024, начало
			Движение.СтавкаНДС = ПолучитьСтавкуНДСдляДокумента( Движение.ДокументВзаиморасчетов );
			//ДИТ, Беляев СЮ, US 80923/TA 81611, 06-03-2024, конец
			РаспределитьСуммуПоВидамЗадолженности(Движение, ДокОбъект, ТаблицаОстатковВзаиморасчетов, ДокОбъект);
			
			//Евросиб Каблов М.Б. 19.11.2019 (
			//Движения денежных средств
			Движение = ДвиженияДС.Добавить();		
			//Измерения
			Движение.Период = Дата;
			Движение.ПриходРасход = Перечисления.ВидыДвиженийПриходРасход.Расход;
			Движение.Организация = Организация;
			Движение.БанковскийСчет = СчетОрганизации;
			Движение.Контрагент = Контрагент;
			Движение.ДоговорКонтрагента = ДоговорКонтрагента;
			Движение.ДокументДвижения = Ссылка;				
			//Ресурсы
			Движение.СуммаВал = СуммаДокумента;
			Движение.Сумма = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(СуммаДокумента, ПараметрыКурсаДокумента, ПараметрыКурсаРегл);
		КонецЕсли;
		//Евросиб Каблов М.Б. 23.11.2020 
		
	КонецЕсли;

	
КонецПроцедуры

Функция ЗагрузкаИСФИзРИТМа_ПолучитьВидЗадолженности(ИСФ) Экспорт
	Если ИСФ.ЦФО = Справочники.ЦентрыФинансовойОтветственности.ТерминалНовосибирск Тогда
