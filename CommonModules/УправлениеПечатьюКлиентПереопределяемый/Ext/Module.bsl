//   НастройкаПечатнойФормы = УправлениеПечатьюКлиент.НастройкаТекущейПечатнойФормы(Форма);
//   
//   ДополнительныеПараметры = Новый Структура;
//   ДополнительныеПараметры.Вставить("ИмяКоманды", Команда.Имя);
//   ДополнительныеПараметры.Вставить("ИмяРеквизитаТабличногоДокумента", НастройкаПечатнойФормы.ИмяРеквизита);
//   ДополнительныеПараметры.Вставить("НазваниеПечатнойФормы", НастройкаПечатнойФормы.Название);
//   
//   ПродолжитьВыполнениеНаСервере = Истина;
//  КонецЕсли;
//
Процедура ПечатьДокументовВыполнитьКоманду(Форма, Команда, ПродолжитьВыполнениеНаСервере, ДополнительныеПараметры) Экспорт
	
КонецПроцедуры

// Формирует печатную формы запроса на терминал (печать из документа "Релиз клиента").
//
// Параметры:
//  ПараметрыПечати - Структура - описание команды печати, подробнее см. УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//
// Возвращаемое значение:
//  Неопределено - возвращать результат не требуется.
//
Функция ПечатьЗапросаНаТерминал(ПараметрыПечати) Экспорт
    // Евросиб Фролов (06.12.2021 TASK№ №42618, РелизКлиента
	
	ИмяМенеджераПечати 	= ПараметрыПечати.МенеджерПечати;
	ИмяМакета 			= ПараметрыПечати.Идентификатор;
	СоставДокументов 	= ПараметрыПечати.ОбъектыПечати;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ДополнительныеПараметры", ПараметрыПечати.ДополнительныеПараметры);
	
	СоответствиеСинонимовРеквизитам = Новый Соответствие;
	СоответствиеСинонимовРеквизитам.Вставить("НомерРелиза", 				"номер релиза");
	СоответствиеСинонимовРеквизитам.Вставить("ОбщееКоличествоКТКВРелизе", 	"общее количество КТК");
	СоответствиеСинонимовРеквизитам.Вставить("ТипоразмерКТК", 				"типоразмер КТК");
	СоответствиеСинонимовРеквизитам.Вставить("СостояниеКТК", 				"состояние КТК");
	СоответствиеСинонимовРеквизитам.Вставить("ТерминалВыдачи", 				"терминал выдачи");
	СоответствиеСинонимовРеквизитам.Вставить("ЛокацияВыдачи", 				"локация выдачи");
	СоответствиеСинонимовРеквизитам.Вставить("СтокВыдачи", 					"сток выдачи");
	СоответствиеСинонимовРеквизитам.Вставить("ДействиеРелизаНачало", 		"начало действия релиза");
	СоответствиеСинонимовРеквизитам.Вставить("ДействиеРелизаОкончание", 	"окончание действия релиза");
	
	МассивРеквизитов = Новый Массив;
	Для Каждого ТекРеквизит Из СоответствиеСинонимовРеквизитам Цикл
		МассивРеквизитов.Добавить(ТекРеквизит.Ключ);
	КонецЦикла;
	МассивРеквизитов.Добавить("Контейнеры");
	МассивРеквизитов.Добавить("НомернаяВыдача");
	МассивРеквизитов.Добавить("ВыдачаОтСобственника");
	
	РелизКлиента = ПараметрыПечати.ОбъектыПечати[0];
	
	РеквизитыРелиза = ОбщегоНазначенияВызовСервера.ЗначенияРеквизитовОбъектаСТабличнымиЧастями(РелизКлиента, МассивРеквизитов, Истина);
	
	МассивНезаполненныхРеквизитов = Новый Массив;
	
	Если РеквизитыРелиза.НомернаяВыдача И НЕ РеквизитыРелиза.ВыдачаОтСобственника Тогда
		Для Каждого ТекущийКТК Из РеквизитыРелиза.Контейнеры Цикл
			Если ТекущийКТК.Контейнер = ПредопределенноеЗначение("Справочник.ТЕ.ПустаяСсылка") Тогда
				МассивНезаполненныхРеквизитов.Добавить("контейнер");
				Прервать;
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
	
	Для Каждого ТекРеквизит Из СоответствиеСинонимовРеквизитам Цикл			
		Если Не ЗначениеЗаполнено(РеквизитыРелиза[ТекРеквизит.Ключ]) Тогда
			МассивНезаполненныхРеквизитов.Добавить(ТекРеквизит.Значение);
		КонецЕсли;	
	КонецЦикла;	
	
	Если МассивНезаполненныхРеквизитов.Количество() > 0 Тогда
		ПредставлениеРеквизитов = СтрСоединить(МассивНезаполненныхРеквизитов, ", ");
		ПоказатьПредупреждение(, "Не заполнены обязательные поля для отправки формы запроса на релиз КТК: " + ПредставлениеРеквизитов);
	Иначе
		
		Если РеквизитыРелиза.НомернаяВыдача Тогда
			КоличествоЗаполненныхСтрок = 0;
			Для Каждого ТекущийКТК Из РеквизитыРелиза.Контейнеры Цикл
				Если ТекущийКТК.Контейнер <> ПредопределенноеЗначение("Справочник.ТЕ.ПустаяСсылка") Тогда
					КоличествоЗаполненныхСтрок = КоличествоЗаполненныхСтрок + 1;
				КонецЕсли;
			КонецЦикла;
			Если КоличествоЗаполненныхСтрок <> РеквизитыРелиза.ОбщееКоличествоКТКВРелизе Тогда
				Режим = РежимДиалогаВопрос.ДаНет;
				Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаПечатиЗапроса", ЭтотОбъект, ПараметрыПечати);
				ПоказатьВопрос(Оповещение, "Количество контейнеров не соответствует значению из поля ""Общее количество КТК в релизе"". Продолжить?", Режим, 0);
				Возврат Неопределено;
			КонецЕсли;	
		КонецЕсли;
		
		УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(
							ПараметрыПечати.МенеджерПечати,
							ПараметрыПечати.Идентификатор,
							ПараметрыПечати.ОбъектыПечати,
							ПараметрыПечати.Форма,
							ДопПараметры);
	КонецЕсли;	

	// Евросиб Фролов)
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПослеЗакрытияВопросаПечатиЗапроса(Результат, ПараметрыПечати) Экспорт
	// Евросиб Фролов (06.12.2021 TASK№ №42618, РелизКлиента
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ДополнительныеПараметры", ПараметрыПечати.ДополнительныеПараметры);
	
    УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(
							ПараметрыПечати.МенеджерПечати,
							ПараметрыПечати.Идентификатор,
							ПараметрыПечати.ОбъектыПечати,
							ПараметрыПечати.Форма,
							ДопПараметры);

    // Евросиб Фролов)
КонецПроцедуры

#КонецОбласти
