Процедура ЗаписатьСобытиеКТК(ДатаЪ, КТК, Услуга, Специалист, Событие, Документ, Сделка, Удалить)
	
	УстановитьПривилегированныйРежим(Истина);
	МЗ = РегистрыСведений.КлючевыеСобытияСделки.СоздатьМенеджерЗаписи();
	МЗ.ДатаЪ = ДатаЪ;
	МЗ.Документ = Документ;
	МЗ.КТК = КТК;
	МЗ.Событие = Событие;
	МЗ.Специалист = Специалист;
	МЗ.Услуга = Услуга;
	МЗ.Сделка = Сделка;
	Попытка
		Если Удалить Тогда
			МЗ.Удалить();
		Иначе
			МЗ.Записать(Истина);
		КонецЕсли;
	Исключение
		ОО = ОписаниеОшибки();
		Сообщить("Ошибка записи контрольной точки сделки. Сообщите в техподдержку. Описание: " + ОО);
		ЗаписьЖурналаРегистрации("Ошибка записи контрольной точки", УровеньЖурналаРегистрации.Ошибка,,,ОО);
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

