Процедура ОбработатьЗаписьСделки(СделкаОбъект) Экспорт
	
	ТекП = Пользователи.ТекущийПользователь();
	ТекДата = ТекущаяДата();
	
	СсылкаБылаПустой = НЕ ЗначениеЗаполнено(СделкаОбъект.Ссылка);
	Если СсылкаБылаПустой Тогда
		//НовыйГУИД = Строка(Новый УникальныйИдентификатор());
		НовыйГУИД = Новый УникальныйИдентификатор();
		НовСсылка = Документы.Сделка.ПолучитьСсылку(НовыйГУИД);
		СделкаОбъект.УстановитьСсылкуНового(НовСсылка);
	Иначе
		НовСсылка = СделкаОбъект.Ссылка;
	КонецЕсли;
	
	Для каждого Стр из СделкаОбъект.СвязьУчетныхЕдиниц Цикл
		
		Если НЕ ЗначениеЗаполнено(Стр.Контейнер) Тогда Продолжить; КонецЕсли;
		
		СтрокаПредыдущейВерсии = СделкаОбъект.Ссылка.СвязьУчетныхЕдиниц.Найти(Стр.Контейнер, "Контейнер");
		
		// 1. Добавление КТК в состав поезда
		Если СсылкаБылаПустой ИЛИ СтрокаПредыдущейВерсии = неопределено Тогда
			ЗаписатьСобытиеКТК(ТекДата, Стр.Контейнер, неопределено, ТекП, "Добавление КТК в сделку", НовСсылка, НовСсылка, Ложь);
		КонецЕсли;
		
		// 2. Подбор груженой накладной
		Если ЗначениеЗаполнено(Стр.ЖДН) И (СсылкаБылаПустой ИЛИ СтрокаПредыдущейВерсии = неопределено ИЛИ НЕ ЗначениеЗаполнено(СтрокаПредыдущейВерсии.ЖДН)) Тогда
			ЗаписатьСобытиеКТК(ТекДата, Стр.Контейнер, неопределено, ТекП, "Подбор ЖДН", Стр.ЖДН, НовСсылка, Ложь);
		КонецЕсли;
		
		// 3. Готово к выставлению
		Если Стр.ГотовоКВыставлению = Истина И (СсылкаБылаПустой ИЛИ СтрокаПредыдущейВерсии = неопределено ИЛИ СтрокаПредыдущейВерсии.ГотовоКВыставлению = Ложь) Тогда
			ЗаписатьСобытиеКТК(ТекДата, Стр.Контейнер, неопределено, ТекП, "Готово к выставлению", НовСсылка, НовСсылка, Ложь);
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого Стр из СделкаОбъект.Доходы Цикл
		
		Если Стр.НеВыставлятьКлиенту = Истина Тогда Продолжить; КонецЕсли;
		
		СтрокаПредыдущейВерсии = СделкаОбъект.Ссылка.Доходы.Найти(Стр.ГУИД, "ГУИД");
		
		// 3. Готово к выставлению
		Если Стр.ГотовоКВыставлению = Истина И (СсылкаБылаПустой ИЛИ СтрокаПредыдущейВерсии = неопределено ИЛИ СтрокаПредыдущейВерсии.ГотовоКВыставлению = Ложь) Тогда
			
			СтрДоходыКТК = СделкаОбъект.ДоходыКТК.Найти(Стр.ГУИД, "ГУИД");
			Если СтрДоходыКТК <> неопределено Тогда
				МассивКТК = СтрРазделить(СтрДоходыКТК.КТК, ";", Ложь);
				Для каждого КТК из МассивКТК Цикл
					
					НайдКТК = РаботаСКонтейнерамиСервер.НайтиКТК(КТК, Ложь);
					ЗаписатьСобытиеКТК(ТекДата, НайдКТК, Стр.Услуга, ТекП, "Готово к выставлению (доп услуга " + Стр.ГУИД + ")", НовСсылка, НовСсылка, Ложь);
					
				КонецЦикла;
			КонецЕсли;

		КонецЕсли;
		
		// 4. Выставление реализации
		Если ЗначениеЗаполнено(Стр.УчДокумент) И (СсылкаБылаПустой ИЛИ СтрокаПредыдущейВерсии = неопределено ИЛИ НЕ ЗначениеЗаполнено(СтрокаПредыдущейВерсии.УчДокумент)) Тогда
			
			СтрДоходыКТК = СделкаОбъект.ДоходыКТК.Найти(Стр.ГУИД, "ГУИД");
			Если СтрДоходыКТК <> неопределено Тогда
				МассивКТК = СтрРазделить(СтрДоходыКТК.КТК, ";", Ложь);
				Для каждого КТК из МассивКТК Цикл
					
					НайдКТК = РаботаСКонтейнерамиСервер.НайтиКТК(КТК, Ложь);
					ЗаписатьСобытиеКТК(ТекДата, НайдКТК, Стр.Услуга, ТекП, "Реализация (услуга " + Стр.ГУИД + ")", Стр.УчДокумент, НовСсылка, Ложь);
					
				КонецЦикла;
			КонецЕсли;

		КонецЕсли;
		
	КонецЦикла;

	
	
	
КонецПроцедуры

