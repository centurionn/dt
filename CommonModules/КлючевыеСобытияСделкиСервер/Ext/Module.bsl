Функция ПолучитьСчетаДляКТК(Сделка, УслугаФрахта) Экспорт
		
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СделкаСвязьУчетныхЕдиниц.Контейнер КАК Контейнер,
	|	СделкаСвязьУчетныхЕдиниц.Заявка КАК Заявка,
	|	СделкаСвязьУчетныхЕдиниц.Коносамент КАК Коносамент,
	|	СделкаСвязьУчетныхЕдиниц.ГУИД КАК ГУИД
	|ПОМЕСТИТЬ ВТ_СвязьУчетныхЕдиниц
	|ИЗ
	|	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	т.СчетПокупателю КАК СчетПокупателю
	|ПОМЕСТИТЬ ВТ_СчетаСОстатками
	|ИЗ
	|	РегистрНакопления.СчетаПокупателей.Остатки КАК т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КлючевыеСобытияСделки.КТК КАК КТК,
	|	КлючевыеСобытияСделки.Услуга КАК Услуга,
	|	КлючевыеСобытияСделки.Документ КАК Документ,
	|	КлючевыеСобытияСделки.Сделка КАК СвязанныйДокумент,
	|	ВТ_СвязьУчетныхЕдиниц.ГУИД КАК ГУИД,
	|	ВТ_СвязьУчетныхЕдиниц.Коносамент КАК Коносамент,
	|	ВТ_СвязьУчетныхЕдиниц.Заявка КАК Заявка
	|ПОМЕСТИТЬ ВТ_КлючевыеСобытияСделки
	|ИЗ
	|	ВТ_СвязьУчетныхЕдиниц КАК ВТ_СвязьУчетныхЕдиниц
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлючевыеСобытияСделки КАК КлючевыеСобытияСделки
	|		ПО (КлючевыеСобытияСделки.Сделка = ВТ_СвязьУчетныхЕдиниц.Заявка)
	|			И (КлючевыеСобытияСделки.КТК = ВТ_СвязьУчетныхЕдиниц.Контейнер)
	|ГДЕ
	|	КлючевыеСобытияСделки.Документ В
	|			(ВЫБРАТЬ
	|				т.СчетПокупателю
	|			ИЗ
	|				ВТ_СчетаСОстатками КАК т)
	|	И КлючевыеСобытияСделки.Событие = &Событие
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетНаОплатуПокупателюДокументыОснования.Ссылка КАК СчетНаОплату,
	|	СчетНаОплатуПокупателюДокументыОснования.Документ КАК Документ,
	|	СчетНаОплатуПокупателюДокументыОснования.Коносамент КАК Коносамент
	|ПОМЕСТИТЬ ВТ_ДокументыОснованияСчетовНаОплату
	|ИЗ
	|	Документ.СчетНаОплатуПокупателю.ДокументыОснования КАК СчетНаОплатуПокупателюДокументыОснования
	|ГДЕ
	|	СчетНаОплатуПокупателюДокументыОснования.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ_КлючевыеСобытияСделки.Документ
	|			ИЗ
	|				ВТ_КлючевыеСобытияСделки КАК ВТ_КлючевыеСобытияСделки)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_КлючевыеСобытияСделки.КТК КАК КТК,
	|	ВТ_КлючевыеСобытияСделки.ГУИД КАК ГУИД,
	|	ВТ_КлючевыеСобытияСделки.Коносамент КАК Коносамент,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ВТ_КлючевыеСобытияСделки.Услуга = &УслугаФрахта
	|				ТОГДА ВТ_КлючевыеСобытияСделки.Документ
	|			ИНАЧЕ ЗНАЧЕНИЕ(Документ.СчетНаОплатуПокупателю.ПустаяСсылка)
	|		КОНЕЦ) КАК СчетФрахт,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ВТ_КлючевыеСобытияСделки.Услуга <> &УслугаФрахта
	|				ТОГДА ВТ_КлючевыеСобытияСделки.Документ
	|			ИНАЧЕ ЗНАЧЕНИЕ(Документ.СчетНаОплатуПокупателю.ПустаяСсылка)
	|		КОНЕЦ) КАК СчетЖД
	|ПОМЕСТИТЬ ВТ_СчетаСУчетомКоносаментов
	|ИЗ
	|	ВТ_КлючевыеСобытияСделки КАК ВТ_КлючевыеСобытияСделки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДокументыОснованияСчетовНаОплату КАК ВТ_ДокументыОснованияСчетовНаОплату
	|		ПО ВТ_КлючевыеСобытияСделки.Документ = ВТ_ДокументыОснованияСчетовНаОплату.СчетНаОплату
	|			И ВТ_КлючевыеСобытияСделки.Заявка = ВТ_ДокументыОснованияСчетовНаОплату.Документ
	|			И ВТ_КлючевыеСобытияСделки.Коносамент = ВТ_ДокументыОснованияСчетовНаОплату.Коносамент
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_КлючевыеСобытияСделки.КТК,
	|	ВТ_КлючевыеСобытияСделки.ГУИД,
	|	ВТ_КлючевыеСобытияСделки.Коносамент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СчетаСУчетомКоносаментов.КТК КАК КТК,
	|	ВТ_СчетаСУчетомКоносаментов.ГУИД КАК ГУИД,
	|	ВТ_СчетаСУчетомКоносаментов.Коносамент КАК Коносамент,
	|	ВТ_СчетаСУчетомКоносаментов.СчетФрахт КАК СчетФрахт,
	|	ВТ_СчетаСУчетомКоносаментов.СчетЖД КАК СчетЖД
	|ИЗ
	|	ВТ_СчетаСУчетомКоносаментов КАК ВТ_СчетаСУчетомКоносаментов
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_КлючевыеСобытияСделки.КТК,
	|	ВТ_КлючевыеСобытияСделки.ГУИД,
	|	ВТ_КлючевыеСобытияСделки.Коносамент,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ВТ_КлючевыеСобытияСделки.Услуга = &УслугаФрахта
	|				ТОГДА ВТ_КлючевыеСобытияСделки.Документ
	|			ИНАЧЕ ЗНАЧЕНИЕ(Документ.СчетНаОплатуПокупателю.ПустаяСсылка)
	|		КОНЕЦ),
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ВТ_КлючевыеСобытияСделки.Услуга <> &УслугаФрахта
	|				ТОГДА ВТ_КлючевыеСобытияСделки.Документ
	|			ИНАЧЕ ЗНАЧЕНИЕ(Документ.СчетНаОплатуПокупателю.ПустаяСсылка)
	|		КОНЕЦ)
	|ИЗ
	|	ВТ_КлючевыеСобытияСделки КАК ВТ_КлючевыеСобытияСделки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДокументыОснованияСчетовНаОплату КАК ВТ_ДокументыОснованияСчетовНаОплату
	|		ПО ВТ_КлючевыеСобытияСделки.Документ = ВТ_ДокументыОснованияСчетовНаОплату.СчетНаОплату
	|			И ВТ_КлючевыеСобытияСделки.Заявка = ВТ_ДокументыОснованияСчетовНаОплату.Документ
	|ГДЕ
	|	НЕ ВТ_КлючевыеСобытияСделки.ГУИД В
	|				(ВЫБРАТЬ
	|					ВТ_СчетаСУчетомКоносаментов.ГУИД
	|				ИЗ
	|					ВТ_СчетаСУчетомКоносаментов КАК ВТ_СчетаСУчетомКоносаментов)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_КлючевыеСобытияСделки.КТК,
	|	ВТ_КлючевыеСобытияСделки.ГУИД,
	|	ВТ_КлючевыеСобытияСделки.Коносамент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_СвязьУчетныхЕдиниц
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_СчетаСОстатками
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_КлючевыеСобытияСделки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ДокументыОснованияСчетовНаОплату
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_СчетаСУчетомКоносаментов";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.Сделка.СвязьУчетныхЕдиниц", "&ТаблицаСвязьУчетныхЕдиниц");
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТаблицаСвязьУчетныхЕдиниц", Сделка.СвязьУчетныхЕдиниц.Выгрузить());
	Запрос.УстановитьПараметр("Событие", "Создание счета");	
	Запрос.УстановитьПараметр("УслугаФрахта", УслугаФрахта);      
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции
