Процедура ДобавлениепризнаковКонтейнера(КТК)
	МассивИзмЗначений = Новый Соответствие;
	МассивИзмЗначений.Вставить("тек_ВЭксплуатации", Истина);
	МассивИзмЗначений.Вставить("тек_ВидСобственности", Перечисления.ВариантыСобственности.Собственный);
	МассивИзмЗначений.Вставить("ИсточникЗаписи", "Добавлено при создании Документа Реф.сцеп" + ТекущаяДата());
	ДобавитьЗаписьстоки_ТекущиеДанные(КТК, МассивИзмЗначений);
КонецПроцедуры

Процедура ДобавитьЗаписьстоки_ТекущиеДанные(КТК, НаборИзмененныхПолей, Знач Период = неопределено, ИспПроверкиПривязки=Истина, ВыводитьСообщения = Истина, ТипИсточникаЗаписи = Неопределено) Экспорт

	Период = ТекущаяДата();
	МЗ = РегистрыСведений.стоки_ТекущиеДанные.СоздатьМенеджерЗаписи();
	
	// восстанавливаем данные предыдущией записи
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	*
	|ИЗ
	|	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних(&Период, КТК = &КТК) КАК стоки_ТекущиеДанныеСрезПоследних";
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("КТК", КТК);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(МЗ, Ответ);  
	// Евросиб(ДИТ) BUG 99736 ТА 99737 Сержантова А.С. Начало: 22.01.2025
	//если делается первая запись по КТК и нет в изменяемых полях статуса, то ставим статус Свободен
	ИначеЕсли НаборИзмененныхПолей.Получить("тек_Статус") = Неопределено 
		или НаборИзмененныхПолей.Получить("тек_Статус") = Перечисления.СтатусыКТК.ПустаяСсылка() Тогда 
		МЗ.тек_Статус = Перечисления.СтатусыКТК.Свободен;
	// Евросиб(ДИТ) BUG 99736 ТА 99737 Сержантова А.С. Конец: 22.01.2025
	КонецЕсли;
	
	МЗ.Период = Период;
	МЗ.ГУИДЗаписи = Строка(Новый УникальныйИдентификатор);
	МЗ.КТК = КТК;
	Если НЕ ЗначениеЗаполнено(МЗ.ПорядковыйНомерЦиклаАрендыКТК) Тогда 
		МЗ.ПорядковыйНомерЦиклаАрендыКТК = 1; 
	КонецЕсли;
	
	ИсточникЗаписи = НаборИзмененныхПолей.Получить("ИсточникЗаписи");
	
	Для каждого Поле из НаборИзмененныхПолей Цикл
		
		МЗ[Поле.Ключ] = Поле.Значение;
	КонецЦикла;
		
	
	// Проверка заполненности строки записи
	МассивПроверяемыхПолей = Новый Массив;
	МассивПроверяемыхПолей.Добавить("тек_ДатаПриемаВПользование");
	МассивПроверяемыхПолей.Добавить("тек_СледНазначения");
	МассивПроверяемыхПолей.Добавить("след_СледующаяЛокация");
	МассивПроверяемыхПолей.Добавить("тек_ПунктыОкончСдачи");
	МассивПроверяемыхПолей.Добавить("тек_Собственник");
	МассивПроверяемыхПолей.Добавить("тек_СрокВозврата");
	МассивПроверяемыхПолей.Добавить("тек_СтокСдачи");
	МассивПроверяемыхПолей.Добавить("тек_ИнструкцияПоСдаче");
	МассивПроверяемыхПолей.Добавить("комм_Ставка");
	ВсеПоляЗаполнены = Истина;
	Для каждого Стр2 из МассивПроверяемыхПолей Цикл
		ВсеПоляЗаполнены = ВсеПоляЗаполнены И ЗначениеЗаполнено(МЗ[Стр2]);
	КонецЦикла;
	МЗ.Недозаполнено = НЕ ВсеПоляЗаполнены;
	
	РегистрыСведений.стоки_ТекущиеДанные.ИзменитьПериодСтроки(КТК, МЗ.Период); // Евросиб Фролов (08.11.2021 TASK №41220
	
	МЗ.Записать(Истина);
	
КонецПроцедуры

