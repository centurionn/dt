Процедура УстановитьРейсЗавершенДокументаПустыхРефСцепов(Выборка)
	
	ДокументРефСцепОбъект = ПолучитьОбъектРефСцеп(Выборка).РефСцепОбъект;
	Если ДокументРефСцепОбъект = Неопределено Тогда Возврат; КонецЕсли;	
	
	ДокументРефСцепОбъект.РейсЗавершен = Истина;
	
	Попытка
		ДокументРефСцепОбъект.Записать();               
	Исключение
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

Процедура НоваяЗадачаОбновитьДанныеПоРефСцепу(Выборка)
	
	ДокументРефСцепОбъект = ПолучитьОбъектРефСцеп(Выборка).РефСцепОбъект;
	Если ДокументРефСцепОбъект = Неопределено Тогда Возврат; КонецЕсли;	
	
	тзСостояния = ДокументРефСцепОбъект.Состояния.Выгрузить();
	
	НайденноеСостояние = тзСостояния.НайтиСтроки(Новый Структура
		("Состояние", Справочники.Состояния.ОбновитьДанныеОВагонахВРефСцепе));
		
	ТребуетсяЗаписьДокумента = Ложь;
	Если НайденноеСостояние.Количество() = 0 Тогда
		Исполнитель = ДокументРефСцепОбъект.Автор;
		СтрокаСостояния = ДокументРефСцепОбъект.Состояния.Добавить();
		СтрокаСостояния.Исполнитель = Исполнитель;
		СтрокаСостояния.Наблюдатель = СтрокаСостояния.Исполнитель;
		СтрокаСостояния.Комментарий = "";																										  
		СтрокаСостояния.Состояние   = Справочники.Состояния.ОбновитьДанныеОВагонахВРефСцепе;
		СтрокаСостояния.ВидНормативаИсполнения = Перечисления.ВидыНормативовИспользования.ЧасовСМоментаСозданияДокумента;
		СтрокаСостояния.Статус 		= Перечисления.СтатусыЭтапов.НаВыполнение;
		ТребуетсяЗаписьДокумента 	= Истина;

	Иначе
		
		Если НайденноеСостояние[0].Статус = Перечисления.СтатусыЭтапов.Выполнен Тогда
			НайденноеСостояние[0].Статус  = Перечисления.СтатусыЭтапов.НаВыполнение;
			ТребуетсяЗаписьДокумента 	  = Истина;
			
			 // Ставим задачу на последнее место, что б выполнение не обнулялось после записи;
			тзСостояния.Сдвинуть(НайденноеСостояние[0], тзСостояния.Количество() - (тзСостояния.Индекс(НайденноеСостояние[0])+1));
				
			ДокументРефСцепОбъект.Состояния.Загрузить(тзСостояния);

		КонецЕсли;	
		
	КонецЕсли;
	
	Если не ТребуетсяЗаписьДокумента Тогда Возврат; КонецЕсли;
	Попытка
		ДокументРефСцепОбъект.Записать();               
	Исключение
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьОбъектРефСцеп(Выборка)
	
	Если ТипЗнч(Выборка.ДокументРефСцеп) = Тип("ДокументСсылка.РефСцеп")  
		и Выборка.ДокументРефСцеп <> ПредопределенноеЗначение("Документ.РефСцеп.ПустаяСсылка") Тогда
		Попытка
			Возврат Новый Структура("РефСцепОбъект", Выборка.ДокументРефСцеп.ПолучитьОбъект());
		Исключение
			Возврат Новый Структура("РефСцепОбъект", Неопределено);
		КонецПопытки;	
	КонецЕсли;

	Возврат Новый Структура("РефСцепОбъект", Неопределено);
	
КонецФункции

