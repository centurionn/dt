Функция ПолучитьТанкКонтейнерНаСервере(ДГК) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СвязиДГКиТанкКонтейнеровСрезПоследних.ТанкКонтейнер КАК ТанкКонтейнер
		|ИЗ
		|	РегистрСведений.СвязиДГКиТанкКонтейнеров.СрезПоследних(, ДГК = &КТКСсылка) КАК СвязиДГКиТанкКонтейнеровСрезПоследних";
	
	Запрос.УстановитьПараметр("КТКСсылка", ДГК);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.ТанкКонтейнер;
	КонецЦикла;
	
	Возврат Справочники.ТЕ.ПустаяСсылка();
	
КонецФункции

 
Функция ПроверитьТанкКонтейнерыБезДГК(тзВагоныРефСцепа) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РефСцепВагоныРефСцепа.Контейнер КАК Контейнер,
		|	РефСцепВагоныРефСцепа.ЭтоТанкКонтейнер КАК ЭтоТанкКонтейнер
		|ПОМЕСТИТЬ вт_ВагоныРефСцепа
		|ИЗ
		|	&тзВагоныРефСцепа КАК РефСцепВагоныРефСцепа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ВагоныРефСцепа.Контейнер КАК Контейнер,
		|	СвязиДГКиТанкКонтейнеровСрезПоследних.ДГК КАК ДГК
		|ПОМЕСТИТЬ вт_КонтейнерыСДГК
		|ИЗ
		|	вт_ВагоныРефСцепа КАК вт_ВагоныРефСцепа
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СвязиДГКиТанкКонтейнеров.СрезПоследних(, ) КАК СвязиДГКиТанкКонтейнеровСрезПоследних
		|		ПО вт_ВагоныРефСцепа.Контейнер = СвязиДГКиТанкКонтейнеровСрезПоследних.ТанкКонтейнер
		|			И (вт_ВагоныРефСцепа.ЭтоТанкКонтейнер = ИСТИНА)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ВагоныРефСцепа.Контейнер КАК Контейнер,
		|	СУММА(ВЫБОР
		|			КОГДА ЕСТЬNULL(вт_КонтейнерыСДГК.ДГК, ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
		|				ТОГДА 0
		|			ИНАЧЕ 1
		|		КОНЕЦ) КАК ПризнакНаличияДГК
		|ИЗ
		|	вт_ВагоныРефСцепа КАК вт_ВагоныРефСцепа
		|		ЛЕВОЕ СОЕДИНЕНИЕ вт_КонтейнерыСДГК КАК вт_КонтейнерыСДГК
		|		ПО вт_ВагоныРефСцепа.Контейнер = вт_КонтейнерыСДГК.Контейнер
		|ГДЕ
		|	вт_ВагоныРефСцепа.ЭтоТанкКонтейнер = ИСТИНА
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_ВагоныРефСцепа.Контейнер
		|
		|ИМЕЮЩИЕ
		|	СУММА(ВЫБОР
		|			КОГДА ЕСТЬNULL(вт_КонтейнерыСДГК.ДГК, ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
		|				ТОГДА 0
		|			ИНАЧЕ 1
		|		КОНЕЦ) = 0";
	
	Запрос.УстановитьПараметр("тзВагоныРефСцепа", тзВагоныРефСцепа); 
	Возврат  Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Контейнер");
КонецФункции

Функция ДанныеКонтейнеровИсходногоРефСцепа(РефСцепИсходныйСсылка, РефСцепПриемникСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РефСцепКонтейнеры.Ссылка КАК Ссылка,
		|	РефСцепКонтейнеры.НомерСтроки КАК НомерСтроки,
		|	РефСцепКонтейнеры.Контейнер КАК Контейнер,
		|	РефСцепКонтейнеры.ПринадлежностьКонтейнера КАК ПринадлежностьКонтейнера,
		|	РефСцепКонтейнеры.СостояниеКонтейнера КАК СостояниеКонтейнера,
		|	РефСцепКонтейнеры.Груз КАК Груз,
		|	РефСцепКонтейнеры.ВесКонтейнераБрутто КАК ВесКонтейнераБрутто,
		|	РефСцепКонтейнеры.ВесКонтейнераНетто КАК ВесКонтейнераНетто,
		|	РефСцепКонтейнеры.КоличествоМестКонтейнера КАК КоличествоМестКонтейнера,
		|	РефСцепКонтейнеры.Клиент КАК Клиент,
		|	РефСцепКонтейнеры.ПеренесенВРефСцеп КАК ПеренесенВРефСцеп,
		|	РефСцепКонтейнеры.ДопИнформация КАК ДопИнформация,
		|	РефСцепКонтейнеры.Отметка КАК Отметка,
		|	РефСцепКонтейнеры.Ответственный КАК Ответственный,
		|	РефСцепКонтейнеры.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки
		|ИЗ
		|	Документ.РефСцеп.Контейнеры КАК РефСцепКонтейнеры
		|ГДЕ
		|	РефСцепКонтейнеры.Ссылка = &ИсходныйРефСцеп
		|	И РефСцепКонтейнеры.ПеренесенВРефСцеп = &РефСцепПриемникСсылка";
	
	Запрос.УстановитьПараметр("ИсходныйРефСцеп", РефСцепИсходныйСсылка);
	Запрос.УстановитьПараметр("РефСцепПриемникСсылка", РефСцепПриемникСсылка);
	
	Возврат Запрос.Выполнить().Выбрать();
	
