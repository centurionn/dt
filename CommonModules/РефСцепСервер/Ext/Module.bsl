Функция ОпределитьПоздниеФактическиеДатыСпискаЖДН(ВсеЖДН) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(ТранспортныйДокумент.ЖДНакладная КАК Документ.ТранспортныйДокумент) КАК ТранспортныйДок,
	               |	ТранспортныйДокумент.Сделка КАК Сделка
	               |ПОМЕСТИТЬ ВхЖДН
	               |ИЗ
	               |	&ВсеЖДН КАК ТранспортныйДокумент
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ВхЖДН.ТранспортныйДок.НакладнаяЭТРАН.ДатаИВремяОтправленияГруза КАК ДатаИВремяОтправленияГруза,
	               |	ВхЖДН.ТранспортныйДок КАК ТранспортныйДок,
	               |	ВхЖДН.Сделка КАК Сделка
	               |ПОМЕСТИТЬ вт_ФактОтправление
	               |ИЗ
	               |	ВхЖДН КАК ВхЖДН
	               |ГДЕ
	               |	ВхЖДН.ТранспортныйДок.НакладнаяЭТРАН <> ЗНАЧЕНИЕ(Документ.э_Накладная.ПустаяСсылка)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаИВремяОтправленияГруза УБЫВ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ВхЖДН.ТранспортныйДок.НакладнаяЭТРАН.ДатаИВремяРаскредитованияГруза КАК ДатаИВремяПрибытияГрузаМестная,
	               |	ВхЖДН.ТранспортныйДок КАК ТранспортныйДок,
	               |	ВхЖДН.Сделка КАК Сделка
	               |ПОМЕСТИТЬ вт_ФактПрибытие
	               |ИЗ
	               |	ВхЖДН КАК ВхЖДН
	               |ГДЕ
	               |	ВхЖДН.ТранспортныйДок.НакладнаяЭТРАН <> ЗНАЧЕНИЕ(Документ.э_Накладная.ПустаяСсылка)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаИВремяПрибытияГрузаМестная УБЫВ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	вт_ФактОтправление.ДатаИВремяОтправленияГруза КАК ДатаИВремяОтправленияГруза,
	               |	вт_ФактПрибытие.ДатаИВремяПрибытияГрузаМестная КАК ДатаИВремяПрибытияГрузаМестная,
	               |	вт_ФактОтправление.ТранспортныйДок КАК ТранспортныйДокумент,
	               |	вт_ФактОтправление.Сделка КАК Сделка
	               |ИЗ
	               |	вт_ФактОтправление КАК вт_ФактОтправление
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт_ФактПрибытие КАК вт_ФактПрибытие
	               |		ПО вт_ФактОтправление.ДатаИВремяОтправленияГруза <> вт_ФактПрибытие.ДатаИВремяПрибытияГрузаМестная
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	вт_ФактОтправление.ДатаИВремяОтправленияГруза,
	               |	вт_ФактПрибытие.ДатаИВремяПрибытияГрузаМестная,
	               |	вт_ФактОтправление.ТранспортныйДок,
	               |	вт_ФактОтправление.Сделка";
	
	Запрос.УстановитьПараметр("ВсеЖДН", ВсеЖДН);
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

Функция ПолучитьЖДНСделкиПоРейсу(Рейс) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СделкаСвязьУчетныхЕдиниц.ЖДН КАК ЖДНакладная,
		|	СделкаРейсы.Ссылка КАК Сделка
		|ИЗ
		|	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.Рейсы КАК СделкаРейсы
		|		ПО СделкаСвязьУчетныхЕдиниц.Ссылка = СделкаРейсы.Ссылка
		|			И (СделкаРейсы.Рейс = &Рейс)";
	
	Запрос.УстановитьПараметр("Рейс",Рейс);
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции	

