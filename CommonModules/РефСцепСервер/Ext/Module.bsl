Функция ПолучитьСписокЗаявокДляДобавленияКонтейнеров(СтруктураДанных) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Заявка.Ссылка КАК Ссылка,
		|	Заявка.Отправка КАК Отправка,
		|	ВЫРАЗИТЬ(ЗаявкаПереченьРейсов.Рейс КАК Справочник.РейсыЖД) КАК РейсЗаявки
		|ПОМЕСТИТЬ вт_ЗаявкаСсылка
		|ИЗ
		|	Документ.Заявка КАК Заявка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
		|		ПО (ЗаявкаПереченьРейсов.Ссылка = Заявка.Ссылка)
		|ГДЕ
		|	Заявка.Ссылка.Контрагент В(&МассивКлиентов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДокументРефСцеп.Ссылка КАК Ссылка,
		|	ДокументРефСцеп.Рейс КАК РейсРефСцепа,
		|	ДокументРефСцеп.ПланируемоеОтправление КАК ПланируемоеОтправление
		|ПОМЕСТИТЬ вт_РефСцеп
		|ИЗ
		|	Документ.РефСцеп КАК ДокументРефСцеп
		|ГДЕ
		|	ДокументРефСцеп.Ссылка = &РефСцеп
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ЗаявкаСсылка.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ вт_ПроверкаПоРейсуИлиПланируемойДате
		|ИЗ
		|	вт_ЗаявкаСсылка КАК вт_ЗаявкаСсылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт_РефСцеп КАК вт_РефСцеп
		|		ПО (ВЫБОР
		|				КОГДА ЕСТЬNULL(вт_РефСцеп.РейсРефСцепа, ЗНАЧЕНИЕ(Справочник.РейсыЖД.ПустаяСсылка)) <> ЗНАЧЕНИЕ(СПравочник.РейсыЖД.ПустаяСсылка)
		|					ТОГДА вт_РефСцеп.РейсРефСцепа = вт_ЗаявкаСсылка.РейсЗаявки
		|				ИНАЧЕ ЕСТЬNULL(вт_РефСцеп.ПланируемоеОтправление, ДАТАВРЕМЯ(1, 1, 1)) = вт_ЗаявкаСсылка.Отправка
		|			КОНЕЦ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РефСцепВагоныРефСцепа.Контейнер КАК Контейнер
		|ПОМЕСТИТЬ вт_КонтейнерыВРефСцепах
		|ИЗ
		|	Документ.РефСцеп.ВагоныРефСцепа КАК РефСцепВагоныРефСцепа
		|ГДЕ
		|	РефСцепВагоныРефСцепа.Ссылка.РейсЗавершен = ЛОЖЬ
		|	И РефСцепВагоныРефСцепа.Ссылка.Проведен = ИСТИНА
		|	И РефСцепВагоныРефСцепа.Ссылка <> &РефСцеп
		|	И РефСцепВагоныРефСцепа.ПеренесенВРефСцеп = ЗНАЧЕНИЕ(Документ.РефСцеп.ПустаяСсылка)
		|	И РефСцепВагоныРефСцепа.Контейнер <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
		|	И НЕ РефСцепВагоныРефСцепа.Контейнер В (&МассивКонтейнеров)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РефСцепКонтейнеры.Контейнер
		|ИЗ
		|	Документ.РефСцеп.Контейнеры КАК РефСцепКонтейнеры
		|ГДЕ
		|	РефСцепКонтейнеры.Ссылка.РейсЗавершен = ЛОЖЬ
		|	И РефСцепКонтейнеры.Ссылка.Проведен = ИСТИНА
		|	И РефСцепКонтейнеры.Ссылка <> &РефСцеп
		|	И РефСцепКонтейнеры.ПеренесенВРефСцеп = ЗНАЧЕНИЕ(Документ.РефСцеп.ПустаяСсылка)
		|	И РефСцепКонтейнеры.Контейнер <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
		|	И НЕ РефСцепКонтейнеры.Контейнер В (&МассивКонтейнеров)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	вт_ПроверкаПоРейсуИлиПланируемойДате.Ссылка КАК Ссылка,
		|	ЕСТЬNULL(ЗаявкаСоставУслуги.НомерКТК, ЗНАЧЕНИЕ(СПравочник.ТЕ.ПустаяСсылка)) КАК НомерКТК
		|ПОМЕСТИТЬ вт_КонтейнерыЗаявок
		|ИЗ
		|	вт_ПроверкаПоРейсуИлиПланируемойДате КАК вт_ПроверкаПоРейсуИлиПланируемойДате
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
		|		ПО вт_ПроверкаПоРейсуИлиПланируемойДате.Ссылка = ЗаявкаСоставУслуги.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_КонтейнерыЗаявок.Ссылка КАК Ссылка,
		|	СУММА(ВЫБОР
		|			КОГДА ЕСТЬNULL(вт_КонтейнерыВРефСцепах.Контейнер, ЗНАЧЕНИЕ(СПравочник.ТЕ.ПустаяСсылка)) = ЗНАЧЕНИЕ(СПравочник.ТЕ.ПустаяСсылка)
		|				ТОГДА 0
		|			ИНАЧЕ 1
		|		КОНЕЦ) КАК КоличествоКонтейнеровВДругихРефСцепах,
		|	СУММА(ВЫБОР
		|			КОГДА ЕСТЬNULL(вт_КонтейнерыЗаявок.НомерКТК, ЗНАЧЕНИЕ(СПравочник.ТЕ.ПустаяСсылка)) = ЗНАЧЕНИЕ(СПравочник.ТЕ.ПустаяСсылка)
		|				ТОГДА 0
		|			ИНАЧЕ 1
		|		КОНЕЦ) КАК КоличествоКонтейнеровВЗаявке
		|ПОМЕСТИТЬ вт_Заявки
		|ИЗ
		|	вт_КонтейнерыЗаявок КАК вт_КонтейнерыЗаявок
		|		ЛЕВОЕ СОЕДИНЕНИЕ вт_КонтейнерыВРефСцепах КАК вт_КонтейнерыВРефСцепах
		|		ПО вт_КонтейнерыЗаявок.НомерКТК = вт_КонтейнерыВРефСцепах.Контейнер
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_КонтейнерыЗаявок.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	вт_Заявки.Ссылка КАК Ссылка
		|ИЗ
		|	вт_Заявки КАК вт_Заявки
		|ГДЕ
		|	вт_Заявки.КоличествоКонтейнеровВДругихРефСцепах = 0
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	вт_Заявки.Ссылка
		|ИЗ
		|	вт_Заявки КАК вт_Заявки
		|ГДЕ
		|	вт_Заявки.КоличествоКонтейнеровВЗаявке = 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗаявкаСоставУслуги.НомерКТК КАК Контейнер,
		|	ЗаявкаСоставУслуги.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	вт_Заявки.Ссылка КАК Ссылка,
		|	ЗаявкаСоставУслуги.Ссылка.Контрагент КАК Контрагент
		|ИЗ
		|	вт_Заявки КАК вт_Заявки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
		|		ПО вт_Заявки.Ссылка = ЗаявкаСоставУслуги.Ссылка";
	//
	Запрос.УстановитьПараметр("РефСцеп", СтруктураДанных.РефСцеп);
	Запрос.УстановитьПараметр("МассивКлиентов", СтруктураДанных.МассивКлиентов);
	Запрос.УстановитьПараметр("МассивКонтейнеров", СтруктураДанных.МассивКонтейнеров);
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	Результат = Запрос.ВыполнитьПакет();
	Возврат Новый Структура("СписокЗаявок, СписокЗаявокСКлючамиАналитики"
		, Результат[6].Выгрузить().ВыгрузитьКолонку("Ссылка")
		, Результат[7].Выгрузить());
	
КонецФункции

Функция	ПроверитьЕстьЛиПроведеннаяСделкаЗаявокПоРефсцепу(Заявки) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
