	ПодборЖДНПодсыловВРефСцепы(0,"");	
	
КонецФункции	

Процедура ПодборЖДНПодсыловВРефСцепы(КоличествоСделок = 0, АдресРезультата) Экспорт 
	
	Запрос = Новый Запрос;  
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДокументРефСцеп.Ссылка КАК РефСцеп,
	|	ДокументРефСцеп.Дата КАК Дата
	|ПОМЕСТИТЬ ВТ_РефСцепыДляПодбора_сУчетомРейсов
	|ИЗ
	|	Документ.РефСцеп КАК ДокументРефСцеп
	|ГДЕ
	|	ДокументРефСцеп.РейсЗавершен = ЛОЖЬ
	|	И ДокументРефСцеп.ПометкаУдаления = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ_РефСцепыДляПодбора_сУчетомРейсов.РефСцеп КАК РефСцеп,
	|	ЕСТЬNULL(ПротоколПодбораЖДНВСделкиСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПодбора,
	|	ВТ_РефСцепыДляПодбора_сУчетомРейсов.Дата КАК Дата
	|ПОМЕСТИТЬ вт_РефСцепыКОбработке
	|ИЗ
	|	ВТ_РефСцепыДляПодбора_сУчетомРейсов КАК ВТ_РефСцепыДляПодбора_сУчетомРейсов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколАвтоподбораЖДНПодсыловВРефСцепы.СрезПоследних КАК ПротоколПодбораЖДНВСделкиСрезПоследних
	|		ПО ВТ_РефСцепыДляПодбора_сУчетомРейсов.РефСцеп = ПротоколПодбораЖДНВСделкиСрезПоследних.РефСцеп
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	вт_РефСцепыКОбработке.РефСцеп КАК РефСцеп,
	|	вт_РефСцепыКОбработке.ДатаПодбора КАК ДатаПодбора,
	|	вт_РефСцепыКОбработке.Дата КАК Дата
	|ИЗ
	|	вт_РефСцепыКОбработке КАК вт_РефСцепыКОбработке
	|
	|УПОРЯДОЧИТЬ ПО
	|	вт_РефСцепыКОбработке.ДатаПодбора,
	|	Дата УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РефСцепВагоныРефСцепа.Вагон.Наименование КАК НомерВагона,
	|	РефСцепВагоныРефСцепа.Ссылка.ФактическоеОтправление КАК ФактическоеОтправление,
	|	вт_РефСцепыКОбработке.РефСцеп КАК РефСцеп,
	|	РефСцепВагоныРефСцепа.Ссылка.СтанцияОтправления.КодЖДСтанции КАК КодЖДСтанции,
	|	РефСцепВагоныРефСцепа.Вагон КАК Вагон,
	|	РефСцепВагоныРефСцепа.Ссылка.ПланируемоеОтправление КАК ПланируемоеОтправление
	|ИЗ
	|	Документ.РефСцеп.ВагоныРефСцепа КАК РефСцепВагоныРефСцепа
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт_РефСцепыКОбработке КАК вт_РефСцепыКОбработке
	|		ПО РефСцепВагоныРефСцепа.Ссылка = вт_РефСцепыКОбработке.РефСцеп";
	
	
	Если КоличествоСделок = 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 1", "");
	Иначе	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 1", СтрШаблон("ПЕРВЫЕ %1", КоличествоСделок));
	КонецЕсли;
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	Если РезультатЗапроса[2].Пустой() Тогда
		Возврат;
	КонецЕсли;       
	Выборка 						  = РезультатЗапроса[2].Выбрать();
	тзДанныеДокументаВагоны 		  = РезультатЗапроса[3].Выгрузить();
	
	МассивОтработанныхДокументов = Новый Массив;
	ВсегоРефСцепов = Выборка.Количество();     
	Итератор 	   = 0;
	МассивОшибок   = Новый Массив;
	Пока Выборка.Следующий() Цикл           
		Итератор = Итератор + 1;
		Попытка
			ОбъектРефСцеп = Выборка.РефСцеп.ПолучитьОбъект();                
		Исключение
			Продолжить;
		КонецПопытки;	
		ГоризонтПоискаНакладных = 40;
		ТаблицаДоИзменений 		= ОбъектРефСцеп.ВагоныРефСцепа.Выгрузить();
		
		СтруктураТЧВагоныСПодсыламиЖДН = ПолучитьТЧВагоныСПодсыламиЖДН(
			тзДанныеДокументаВагоны, ТаблицаДоИзменений, Выборка.РефСцеп);
			
		// Добавил проведение в попытку, т.к. мог возникать конфликт блокировок.
		// Ошибки собираем в массив, чтобы после выполнения задания отправить их на почту.
		Попытка 
			Если СтруктураТЧВагоныСПодсыламиЖДН.ФлагНаличияИзменений Тогда
				ОбъектРефСцеп.ВагоныРефсцепа.Загрузить(СтруктураТЧВагоныСПодсыламиЖДН.ТаблицаДоИзменений);
				ОбъектРефСцеп.Записать(РежимЗаписиДокумента.Проведение);
			КонецЕсли;
			МассивОтработанныхДокументов.Добавить(Выборка.РефСцеп);
			РегистрыСведений.ПротоколАвтоподбораЖДНПодсыловВРефСцепы.ДобавитьЗапись(Выборка.РефСцеп);
		Исключение
			ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации("ПодборЖДННакладныхВСделки.Проведение сделки",
    												УровеньЖурналаРегистрации.Предупреждение,, Выборка.РефСцеп, ПредставлениеОшибки);
			МассивОшибок.Добавить("" + Выборка.РефСцеп + ": " + ПредставлениеОшибки);
		КонецПопытки;
		ДлительныеОперации.СообщитьПрогресс(Итератор/ВсегоРефСцепов * 100, Выборка.РефСцеп); 
	КонецЦикла;                                           
	ПоместитьВоВременноеХранилище(МассивОтработанныхДокументов, АдресРезультата);
	РаботаСоСделкамиСервер.ОчиститьОчередьОтложенногоИзменения(МассивОтработанныхДокументов); //ДИТ Шевченко А.В. 55599 23.01.2023
	Если МассивОшибок.Количество() > 0 Тогда
		Тема = "Рег. задание: Подбор ЖДН накладных подсыла порожнего вагона в сделки";
		ТекстСообщения = "Во время выполнения рег. задания произошли следующие ошибки:
						|" + СтрСоединить(МассивОшибок, Символы.ПС);
		РаботаСоСделкамиСервер.ВыполнитьОтправкуУведомлений(Тема, ТекстСообщения, Метаданные.РегламентныеЗадания.ПодборЖДНПодсыловВРефСцепы);
	КонецЕсли;
	
КонецПроцедуры 

Функция ПолучитьТЧВагоныСПодсыламиЖДН(тзДанныеДокументаВагоны, ТаблицаДоИзменений, РефСцеп) Экспорт
	
    ФлагНаличияИзменений 	= Ложь;
	мДанныеДокументаВагоны = тзДанныеДокументаВагоны.НайтиСтроки(Новый Структура("РефСцеп", РефСцеп));
	Для каждого ДанныеДокументаВагоны из мДанныеДокументаВагоны Цикл
		СтруктураВагоннаяЖДН = РаботаСоСделкамиСервер.НайтиПодсылПорожнегоВагонаПоЭТРАН(
									ДанныеДокументаВагоны.НомерВагона,
									?(ДанныеДокументаВагоны.ФактическоеОтправление = Дата(1,1,1)
										, ДанныеДокументаВагоны.ПланируемоеОтправление 
										, ДанныеДокументаВагоны.ФактическоеОтправление),
									ДанныеДокументаВагоны.КодЖДСтанции,
									40); 
		ПустаяЖДН = Документы.ТранспортныйДокумент.ПустаяСсылка();							
		
		СтруктураВагоннаяЖДН.НакладнаяПодсылаВагонаСсылка = 
			?(СтруктураВагоннаяЖДН.НакладнаяПодсылаВагонаСсылка = Неопределено, ПустаяЖДН
			, СтруктураВагоннаяЖДН.НакладнаяПодсылаВагонаСсылка); 
										
		Если СтруктураВагоннаяЖДН.НакладнаяПодсылаВагонаСсылка <> ПустаяЖДН Тогда
			
			СтруктураВагоннаяЖДН.Вставить("ТранспортнаяНакладная"
				, ТранспортныеДокументы_сервер.НайтиЖДНПоНомеру(СтруктураВагоннаяЖДН.НакладнаяПодсылаВагонаСсылка));
			
			мДанныеДокументаВагоныТЧ = ТаблицаДоИзменений.НайтиСтроки(Новый Структура("Вагон"
				, ДанныеДокументаВагоны.Вагон));
			Для каждого ДанныеДокументаВагонаТЧ из мДанныеДокументаВагоныТЧ Цикл
				Если ДанныеДокументаВагонаТЧ.ЖДНакладная <> СтруктураВагоннаяЖДН.НакладнаяПодсылаВагонаСсылка Тогда
					ДанныеДокументаВагонаТЧ.ЖДНакладная 					   = СтруктураВагоннаяЖДН.ТранспортнаяНакладная;							
					ДанныеДокументаВагонаТЧ.ПотребовалсяПодсылПорожнегоВагона  = Истина;
					ДанныеДокументаВагонаТЧ.СтанцияОтправленияПодсыла		   
						= СтруктураВагоннаяЖДН.ТранспортнаяНакладная.СтанцияОтправления;							
					ФлагНаличияИзменений 									   = Истина;
				КонецЕсли;	
			КонецЦикла;								
		ИначеЕсли  СтруктураВагоннаяЖДН.НакладнаяПодсылаВагонаСсылка = ПустаяЖДН Тогда
			мДанныеДокументаВагоныТЧ = ТаблицаДоИзменений.НайтиСтроки(Новый Структура("Вагон"
				, ДанныеДокументаВагоны.Вагон));
			Для каждого ДанныеДокументаВагонаТЧ из мДанныеДокументаВагоныТЧ Цикл
				Если ДанныеДокументаВагонаТЧ.ЖДНакладная <> СтруктураВагоннаяЖДН.НакладнаяПодсылаВагонаСсылка
					и (не ДанныеДокументаВагонаТЧ.ЭтоРучноеИзменениеПодсылаЖДН)  Тогда
					ДанныеДокументаВагонаТЧ.ЖДНакладная 					   = Неопределено;							
					ДанныеДокументаВагонаТЧ.СтанцияОтправленияПодсыла		   = Неопределено;							
					ДанныеДокументаВагонаТЧ.ПотребовалсяПодсылПорожнегоВагона = Ложь;
					ФлагНаличияИзменений 									   = Истина;
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат Новый Структура("ТаблицаДоИзменений, ФлагНаличияИзменений", ТаблицаДоИзменений, ФлагНаличияИзменений)

