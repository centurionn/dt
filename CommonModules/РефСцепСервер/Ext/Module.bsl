Функция ПолучитьДанныеРефСцепаДляОтбораЗаявок(Объект, ЭтоПодборЗаявок = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РефСцепВагоныРефСцепа.Контейнер КАК Контейнер,
		|	РефСцепВагоныРефСцепа.Клиент КАК Клиент,
		|	РефСцепВагоныРефСцепа.Отметка КАК Отметка
		|ПОМЕСТИТЬ вт_РефСцепВагоныРефСцепа
		|ИЗ
		|	&тзВагоныРефСцепа КАК РефСцепВагоныРефСцепа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РефСцепКонтейнеры.Контейнер КАК Контейнер,
		|	РефСцепКонтейнеры.Клиент КАК Клиент,
		|	РефСцепКонтейнеры.Отметка КАК Отметка
		|ПОМЕСТИТЬ вт_Контейнеры
		|ИЗ
		|	&тзКонтейнеры КАК РефСцепКонтейнеры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РефСцепВагоныРефСцепа.Контейнер КАК Контейнер,
		|	РефСцепВагоныРефСцепа.Клиент КАК Клиент,
		|	РефСцепВагоныРефСцепа.Отметка КАК Отметка
		|ПОМЕСТИТЬ вт_ОбеТЧРефСцепа
		|ИЗ
		|	вт_РефСцепВагоныРефСцепа КАК РефСцепВагоныРефСцепа
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РефСцепКонтейнеры.Контейнер,
		|	РефСцепКонтейнеры.Клиент,
		|	РефСцепКонтейнеры.Отметка
		|ИЗ
		|	вт_Контейнеры КАК РефСцепКонтейнеры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	вт_ОбеТЧРефСцепа.Контейнер КАК Контейнер
		|ИЗ
		|	вт_ОбеТЧРефСцепа КАК вт_ОбеТЧРефСцепа
		|ГДЕ
		|	вт_ОбеТЧРефСцепа.Контейнер <> ЗНАЧЕНИЕ(СПравочник.ТЕ.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	вт_ОбеТЧРефСцепа.Клиент КАК Клиент
		|ИЗ
		|	вт_ОбеТЧРефСцепа КАК вт_ОбеТЧРефСцепа
		|ГДЕ вт_ОбеТЧРефСцепа.Отметка = ИСТИНА";
	
	тзВагоныРефСцепа = Объект.ВагоныРефСцепа.Выгрузить();
	
	Если ЭтоПодборЗаявок  Тогда
		тзВагоныРефСцепа.Очистить();
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"ГДЕ вт_ОбеТЧРефСцепа.Отметка = ИСТИНА","");
	КонецЕсли;
		
	Запрос.УстановитьПараметр("тзВагоныРефСцепа", тзВагоныРефСцепа);
	Запрос.УстановитьПараметр("тзКонтейнеры", Объект.Контейнеры.Выгрузить());
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	Возврат Новый Структура("МассивКонтейнеров
		|, МассивКлиентов
		|, РефСцеп"
		, МассивРезультатов[3].Выгрузить().ВыгрузитьКолонку("Контейнер")
		, МассивРезультатов[4].Выгрузить().ВыгрузитьКолонку("Клиент")
		, Объект.Ссылка);

