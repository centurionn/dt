Функция ПолучитьДанныеДислокацииВагоновРефСцепа(ДанныеПоВагонамРефСцепа) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВагоныВРефСцепах.Вагон КАК Вагон,
		|	ВагоныВРефСцепах.ПорядковыйНомерВСцепе КАК ПорядковыйНомерВСцепе,
		|	ВагоныВРефСцепах.ПризнакВагона КАК ПризнакВагона,
		|	ВагоныВРефСцепах.Номер1Контроллера КАК Номер1Контроллера,
		|	ВагоныВРефСцепах.Номер2Контроллера КАК Номер2Контроллера,
		|	ВагоныВРефСцепах.ЕстьВагонВРегистреНаФорме КАК ЕстьВагонВРегистреНаФорме,
		|	ВагоныВРефСцепах.ЕстьВагонДокументаВБазе КАК ЕстьВагонДокументаВБазе,
		|	ВагоныВРефСцепах.ПорядковыйНомерВСцепеРегистраНаФорме КАК ПорядковыйНомерВСцепеРегистраНаФорме
		|ПОМЕСТИТЬ вт_ВагоныВРефСцепах
		|ИЗ
		|	&ДанныеПоВагонамРефСцепа КАК ВагоныВРефСцепах
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДислокацияВагоновСрезПоследних.Период КАК Период,
		|	ДислокацияВагоновСрезПоследних.Вагон КАК Вагон,
		|	ДислокацияВагоновСрезПоследних.ОперацияСВагоном КАК ОперацияСВагоном,
		|	ДислокацияВагоновСрезПоследних.НомерПоезда КАК НомерПоезда,
		|	ДислокацияВагоновСрезПоследних.ИндексПоезда КАК ИндексПоезда,
		|	ДислокацияВагоновСрезПоследних.Собственник КАК Собственник,
		|	ДислокацияВагоновСрезПоследних.СтанцияОперации КАК СтанцияОперации,
		|	ДислокацияВагоновСрезПоследних.СтанцияНазначения КАК СтанцияНазначения,
		|	ДислокацияВагоновСрезПоследних.СтанцияОтправления КАК СтанцияОтправления,
		|	ДислокацияВагоновСрезПоследних.ДатаПрибытияНаСтанцию КАК ДатаПрибытияНаСтанцию,
		|	ДислокацияВагоновСрезПоследних.ПростойНаСтанции КАК ПростойНаСтанции,
		|	ДислокацияВагоновСрезПоследних.ДатаОтправленияСоСтанции КАК ДатаОтправленияСоСтанции,
		|	ДислокацияВагоновСрезПоследних.ОстаточноеРасстояниеКМ КАК ОстаточноеРасстояниеКМ,
		|	ДислокацияВагоновСрезПоследних.ОперацияСВагоном.Код КАК ОперацияСВагономКод
		|ПОМЕСТИТЬ вт_ТекущаяОперация0
		|ИЗ
		|	РегистрСведений.ДислокацияВагонов.СрезПоследних(, Вагон В (&ВагоныРефСцепа)) КАК ДислокацияВагоновСрезПоследних
		|ГДЕ
		|	ДислокацияВагоновСрезПоследних.ОперацияСВагоном.ИсключитьИзОтображенияПоследнихОпераций = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(вт_ТекущаяОперация0.Период) КАК Период,
		|	вт_ТекущаяОперация0.Вагон КАК Вагон
		|ПОМЕСТИТЬ вт_ТекущаяОперацияМаксПериод
		|ИЗ
		|	вт_ТекущаяОперация0 КАК вт_ТекущаяОперация0
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_ТекущаяОперация0.Вагон
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ТекущаяОперация0.Период КАК Период,
		|	вт_ТекущаяОперация0.Вагон КАК Вагон,
		|	вт_ТекущаяОперация0.ОперацияСВагоном КАК ОперацияСВагоном,
		|	вт_ТекущаяОперация0.НомерПоезда КАК НомерПоезда,
		|	вт_ТекущаяОперация0.ИндексПоезда КАК ИндексПоезда,
		|	вт_ТекущаяОперация0.Собственник КАК Собственник,
		|	вт_ТекущаяОперация0.СтанцияОперации КАК СтанцияОперации,
		|	вт_ТекущаяОперация0.СтанцияНазначения КАК СтанцияНазначения,
		|	вт_ТекущаяОперация0.СтанцияОтправления КАК СтанцияОтправления,
		|	вт_ТекущаяОперация0.ДатаПрибытияНаСтанцию КАК ДатаПрибытияНаСтанцию,
		|	вт_ТекущаяОперация0.ПростойНаСтанции КАК ПростойНаСтанции,
		|	вт_ТекущаяОперация0.ДатаОтправленияСоСтанции КАК ДатаОтправленияСоСтанции,
		|	вт_ТекущаяОперация0.ОстаточноеРасстояниеКМ КАК ОстаточноеРасстояниеКМ,
		|	вт_ТекущаяОперация0.ОперацияСВагономКод КАК ОперацияСВагономКод
		|ПОМЕСТИТЬ вт_ТекущаяОперация0ДоУдаленияДублейОпераций
		|ИЗ
		|	вт_ТекущаяОперация0 КАК вт_ТекущаяОперация0
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт_ТекущаяОперацияМаксПериод КАК вт_ТекущаяОперацияМаксПериод
		|		ПО вт_ТекущаяОперация0.Вагон = вт_ТекущаяОперацияМаксПериод.Вагон
		|			И вт_ТекущаяОперация0.Период = вт_ТекущаяОперацияМаксПериод.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ вт_ТекущаяОперация0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ вт_ТекущаяОперацияМаксПериод
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ТекущаяОперация0ДоУдаленияДублейОпераций.Вагон КАК Вагон,
		|	МАКСИМУМ(вт_ТекущаяОперация0ДоУдаленияДублейОпераций.ОперацияСВагоном.Код) КАК ОперацияСВагономКод
		|ПОМЕСТИТЬ вт_ТекущаяОперацияМаксКодОперации
		|ИЗ
		|	вт_ТекущаяОперация0ДоУдаленияДублейОпераций КАК вт_ТекущаяОперация0ДоУдаленияДублейОпераций
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_ТекущаяОперация0ДоУдаленияДублейОпераций.Вагон
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ТекущаяОперация0ДоУдаленияДублейОпераций.Период КАК Период,
		|	вт_ТекущаяОперация0ДоУдаленияДублейОпераций.Вагон КАК Вагон,
		|	вт_ТекущаяОперация0ДоУдаленияДублейОпераций.ОперацияСВагоном КАК ОперацияСВагоном,
		|	вт_ТекущаяОперация0ДоУдаленияДублейОпераций.НомерПоезда КАК НомерПоезда,
		|	вт_ТекущаяОперация0ДоУдаленияДублейОпераций.ИндексПоезда КАК ИндексПоезда,
		|	вт_ТекущаяОперация0ДоУдаленияДублейОпераций.Собственник КАК Собственник,
		|	вт_ТекущаяОперация0ДоУдаленияДублейОпераций.СтанцияОперации КАК СтанцияОперации,
		|	вт_ТекущаяОперация0ДоУдаленияДублейОпераций.СтанцияНазначения КАК СтанцияНазначения,
		|	вт_ТекущаяОперация0ДоУдаленияДублейОпераций.СтанцияОтправления КАК СтанцияОтправления,
		|	вт_ТекущаяОперация0ДоУдаленияДублейОпераций.ДатаПрибытияНаСтанцию КАК ДатаПрибытияНаСтанцию,
		|	вт_ТекущаяОперация0ДоУдаленияДублейОпераций.ПростойНаСтанции КАК ПростойНаСтанции,
		|	вт_ТекущаяОперация0ДоУдаленияДублейОпераций.ДатаОтправленияСоСтанции КАК ДатаОтправленияСоСтанции,
		|	вт_ТекущаяОперация0ДоУдаленияДублейОпераций.ОстаточноеРасстояниеКМ КАК ОстаточноеРасстояниеКМ,
		|	вт_ТекущаяОперация0ДоУдаленияДублейОпераций.ОперацияСВагономКод КАК ОперацияСВагономКод
		|ПОМЕСТИТЬ вт_ТекущаяОперация
		|ИЗ
		|	вт_ТекущаяОперация0ДоУдаленияДублейОпераций КАК вт_ТекущаяОперация0ДоУдаленияДублейОпераций
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт_ТекущаяОперацияМаксКодОперации КАК вт_ТекущаяОперацияМаксКодОперации
		|		ПО вт_ТекущаяОперация0ДоУдаленияДублейОпераций.Вагон = вт_ТекущаяОперацияМаксКодОперации.Вагон
		|			И вт_ТекущаяОперация0ДоУдаленияДублейОпераций.ОперацияСВагоном.Код = вт_ТекущаяОперацияМаксКодОперации.ОперацияСВагономКод
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ вт_ТекущаяОперация0ДоУдаленияДублейОпераций
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ вт_ТекущаяОперацияМаксКодОперации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДислокацияВагонов.Период КАК ПериодПредыдущейОперации,
		|	ДислокацияВагонов.ОперацияСВагоном КАК ОперацияСВагономПредыдущая,
		|	ДислокацияВагонов.СтанцияОперации КАК СтанцияПредыдущейОперации,
		|	ДислокацияВагонов.Вагон КАК Вагон
		|ПОМЕСТИТЬ вт_ПредыдущаяОперация0
		|ИЗ
		|	РегистрСведений.ДислокацияВагонов КАК ДислокацияВагонов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт_ТекущаяОперация КАК вт_ТекущаяОперация
		|		ПО ДислокацияВагонов.Вагон = вт_ТекущаяОперация.Вагон
		|			И (НЕ(ДислокацияВагонов.Вагон = вт_ТекущаяОперация.Вагон
		|					И ДислокацияВагонов.Период = вт_ТекущаяОперация.Период
		|					И ДислокацияВагонов.ОперацияСВагоном.Код = вт_ТекущаяОперация.ОперацияСВагономКод))
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Вагон
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(вт_ПредыдущаяОперация0.ПериодПредыдущейОперации) КАК Период,
		|	вт_ПредыдущаяОперация0.Вагон КАК Вагон
		|ПОМЕСТИТЬ вт_ПредыдущаяОперацияМаксПериод
		|ИЗ
		|	вт_ПредыдущаяОперация0 КАК вт_ПредыдущаяОперация0
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_ПредыдущаяОперация0.Вагон
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Период,
		|	Вагон
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ПредыдущаяОперация0.ПериодПредыдущейОперации КАК ПериодПредыдущейОперации,
		|	вт_ПредыдущаяОперация0.ОперацияСВагономПредыдущая КАК ОперацияСВагономПредыдущая,
		|	вт_ПредыдущаяОперация0.СтанцияПредыдущейОперации КАК СтанцияПредыдущейОперации,
		|	вт_ПредыдущаяОперация0.Вагон КАК Вагон
		|ПОМЕСТИТЬ вт_ПредыдущаяОперация0ДоУдаленияДублейОпераций
		|ИЗ
		|	вт_ПредыдущаяОперация0 КАК вт_ПредыдущаяОперация0
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт_ПредыдущаяОперацияМаксПериод КАК вт_ПредыдущаяОперацияМаксПериод
		|		ПО вт_ПредыдущаяОперация0.Вагон = вт_ПредыдущаяОперацияМаксПериод.Вагон
		|			И вт_ПредыдущаяОперация0.ПериодПредыдущейОперации = вт_ПредыдущаяОперацияМаксПериод.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ вт_ПредыдущаяОперация0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ вт_ПредыдущаяОперацияМаксПериод
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(вт_ПредыдущаяОперация.ОперацияСВагономПредыдущая.Код) КАК ОперацияСВагономПредыдущаяКод,
		|	вт_ПредыдущаяОперация.Вагон КАК Вагон
		|ПОМЕСТИТЬ вт_ПредыдущаяОперацияМаксКодОперации
		|ИЗ
		|	вт_ПредыдущаяОперация0ДоУдаленияДублейОпераций КАК вт_ПредыдущаяОперация
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_ПредыдущаяОперация.Вагон
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ПредыдущаяОперация0.ПериодПредыдущейОперации КАК ПериодПредыдущейОперации,
		|	вт_ПредыдущаяОперация0.ОперацияСВагономПредыдущая КАК ОперацияСВагономПредыдущая,
		|	вт_ПредыдущаяОперация0.СтанцияПредыдущейОперации КАК СтанцияПредыдущейОперации,
		|	вт_ПредыдущаяОперация0.Вагон КАК Вагон
		|ПОМЕСТИТЬ вт_ПредыдущаяОперация
		|ИЗ
		|	вт_ПредыдущаяОперация0ДоУдаленияДублейОпераций КАК вт_ПредыдущаяОперация0
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт_ПредыдущаяОперацияМаксКодОперации КАК вт_ПредыдущаяОперацияМаксКодОперации
		|		ПО вт_ПредыдущаяОперация0.Вагон = вт_ПредыдущаяОперацияМаксКодОперации.Вагон
		|			И вт_ПредыдущаяОперация0.ОперацияСВагономПредыдущая.Код = вт_ПредыдущаяОперацияМаксКодОперации.ОперацияСВагономПредыдущаяКод
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ВагоныВРефСцепах.Вагон КАК Вагон,
		|	вт_ВагоныВРефСцепах.ПорядковыйНомерВСцепе КАК ПорядковыйНомерВСцепе,
		|	вт_ВагоныВРефСцепах.ПризнакВагона КАК ПризнакВагона,
		|	вт_ВагоныВРефСцепах.Номер1Контроллера КАК Номер1Контроллера,
		|	вт_ВагоныВРефСцепах.Номер2Контроллера КАК Номер2Контроллера,
		|	вт_ВагоныВРефСцепах.ЕстьВагонВРегистреНаФорме КАК ЕстьВагонВРегистреНаФорме,
		|	вт_ВагоныВРефСцепах.ЕстьВагонДокументаВБазе КАК ЕстьВагонДокументаВБазе,
		|	вт_ВагоныВРефСцепах.ПорядковыйНомерВСцепеРегистраНаФорме КАК ПорядковыйНомерВСцепеРегистраНаФорме,
		|	вт_ТекущаяОперация.Период КАК ДатаТекущейОперации,
		|	вт_ТекущаяОперация.ОперацияСВагоном КАК ТекущаяОперацияСВагоном,
		|	вт_ТекущаяОперация.ИндексПоезда КАК ИндексПоезда,
		|	вт_ТекущаяОперация.Собственник КАК Собственник,
		|	вт_ТекущаяОперация.СтанцияОперации КАК СтанцияТекущейОперации,
		|	вт_ТекущаяОперация.ПростойНаСтанции КАК ПростойНаСтанции,
		|	вт_ТекущаяОперация.ОстаточноеРасстояниеКМ КАК ОстаточноеРасстояние,
		|	вт_ПредыдущаяОперация.ПериодПредыдущейОперации КАК ДатаПредыдущейОперации,
		|	вт_ПредыдущаяОперация.ОперацияСВагономПредыдущая КАК ПредыдущаяОперацияСВагоном,
		|	вт_ПредыдущаяОперация.СтанцияПредыдущейОперации КАК СтанцияПредыдущейОперации,
		|	Локации.ЖелезнаяДорога КАК ДорогаТекущейОперации,
		|	Локации1.ЖелезнаяДорога КАК ДорогаПредыдущейОперации,
		|	РАЗНОСТЬДАТ(вт_ПредыдущаяОперация.ПериодПредыдущейОперации, вт_ТекущаяОперация.Период, ДЕНЬ) КАК ПериодМеждуОперациями,
		|	ВЫБОР
		|		КОГДА вт_ТекущаяОперация.ОперацияСВагоном.Код В (&КодыОперацийСВагономСПризнакомНеисправен)
		|			ТОГДА ""Неисправен""
		|		ИНАЧЕ ""Исправен""
		|	КОНЕЦ КАК ТехСостояниеВагона
		|ИЗ
		|	вт_ВагоныВРефСцепах КАК вт_ВагоныВРефСцепах
		|		ЛЕВОЕ СОЕДИНЕНИЕ вт_ТекущаяОперация КАК вт_ТекущаяОперация
		|		ПО вт_ВагоныВРефСцепах.Вагон = вт_ТекущаяОперация.Вагон
		|		ЛЕВОЕ СОЕДИНЕНИЕ вт_ПредыдущаяОперация КАК вт_ПредыдущаяОперация
		|		ПО вт_ВагоныВРефСцепах.Вагон = вт_ПредыдущаяОперация.Вагон
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Локации КАК Локации
		|		ПО (вт_ТекущаяОперация.СтанцияОперации = Локации.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Локации КАК Локации1
		|		ПО (вт_ПредыдущаяОперация.СтанцияПредыдущейОперации = Локации1.Ссылка)";
	
	Запрос.УстановитьПараметр("ДанныеПоВагонамРефСцепа", ДанныеПоВагонамРефСцепа);
	Запрос.УстановитьПараметр("ВагоныРефСцепа", ДанныеПоВагонамРефСцепа.ВыгрузитьКолонку("Вагон"));
	
	КодыОперацийСВагономСПризнакомНеисправен = СтрРазделить(Константы.КодыОперацийСВагономСПризнакомНеисправен.Получить(), ","); 
	
	Запрос.УстановитьПараметр("КодыОперацийСВагономСПризнакомНеисправен"
			, КодыОперацийСВагономСПризнакомНеисправен);
		
	Возврат Запрос.Выполнить().Выгрузить();    
	
КонецФункции

Функция ПолучитьДанныеДГКВагоновРефСцепа(ДанныеПоВагонамРефСцепа, РефСцеп) Экспорт
	Если ДанныеПоВагонамРефСцепа.Количество() = 0 Тогда
		Возврат неопределено;
	КонецЕсли;
	РефСцепНаименование = ОБщегоНазначения.ЗначениеРеквизитаОбъекта(РефСцеп,"Наименование");
	
	Результат = ПолучитьДГККонтейнер(ДанныеПоВагонамРефСцепа, РефСцеп, РефСцепНаименование);
	тзРезультат = Результат.Выгрузить();
	Для Каждого Выборка из тзРезультат Цикл
		Если Выборка.Вагон = Справочники.ТС.ПустаяСсылка() Тогда
			Возврат Неопределено;
		КонецЕсли;	
		
		Если Выборка.Контейнер <> Справочники.ТЕ.ПустаяСсылка() Тогда
			Возврат Результат.Выбрать();
		Иначе
			НайтиСоздатьДГККонтейнер(ДанныеПоВагонамРефСцепа, РефСцеп, РефСцепНаименование);			
			Возврат ПолучитьДГККонтейнер(ДанныеПоВагонамРефСцепа, РефСцеп, РефСцепНаименование).Выбрать();
		КонецЕсли;
	КонецЦикла;    
    Возврат Неопределено;
КонецФункции 

Функция ПолучитьДГККонтейнер(ДанныеПоВагонамРефСцепа, РефСцеп, РефСцепНаименование)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВагоныВРефСцепах.Вагон КАК Вагон,
		|	ВагоныВРефСцепах.ПризнакВагона КАК ПризнакВагона,
		|	ИСТИНА КАК ЭтоКонтейнерСДГК
		|ПОМЕСТИТЬ вт_ВагоныВРефСцепах
		|ИЗ
		|	&ДанныеПоВагонамРефСцепа КАК ВагоныВРефСцепах
		|ГДЕ
		|	ВагоныВРефСцепах.ПризнакВагона = 2
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТЕ.Ссылка КАК Контейнер
		|ПОМЕСТИТЬ вт_ДГК
		|ИЗ
		|	Справочник.ТЕ КАК ТЕ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТипоразмерыТЕ КАК ТипоразмерыТЕ
		|		ПО (ТЕ.ТипТЕ = &ТипDG)
		|ГДЕ
		//|	ТЕ.Префикс = &Префикс
		//|	И ПОДСТРОКА(ТЕ.Номер, 3, 4) = &НомерРефСцепа
		|   ТЕ.Наименование = &НаименованиеКТК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЕСТЬNULL(вт_ДГК.Контейнер, ЗНАЧЕНИЕ(Справочник.ТЕ.Пустаяссылка)) КАК Контейнер,
		|	ЕСТЬNULL(вт_ВагоныВРефСцепах.Вагон, ЗНАЧЕНИЕ(Справочник.ТС.Пустаяссылка)) КАК Вагон,
		|	вт_ВагоныВРефСцепах.ПризнакВагона КАК ПризнакВагона,
		|	вт_ВагоныВРефСцепах.ЭтоКонтейнерСДГК КАК ЭтоКонтейнерСДГК
		|ИЗ
		|	вт_ВагоныВРефСцепах КАК вт_ВагоныВРефСцепах
		|		ЛЕВОЕ СОЕДИНЕНИЕ вт_ДГК КАК вт_ДГК
		|		ПО (ИСТИНА)
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_ДГК.Контейнер,
		|	вт_ВагоныВРефСцепах.Вагон,
		|	вт_ВагоныВРефСцепах.ПризнакВагона,
		|	вт_ВагоныВРефСцепах.ЭтоКонтейнерСДГК";

	РефСцепНаименование = Рефсцеп.Наименование;	
	Запрос.УстановитьПараметр("ДанныеПоВагонамРефСцепа", ДанныеПоВагонамРефСцепа);
	НаименованиеКТК = "ETSU" + Формат(Число(СокрЛП(РефСцепНаименование)), "ЧЦ=7; ЧВН=; ЧГ=0");
	//Запрос.УстановитьПараметр("НомерРефСцепа", РефСцепНаименование);
	Запрос.УстановитьПараметр("НаименованиеКТК", НаименованиеКТК);
	Запрос.УстановитьПараметр("ТипDG", Справочники.ТипоразмерыТЕ.Тип40DG);
	Запрос.УстановитьПараметр("Префикс", "ETSU"); 
	// Пункт 4.4
	
	Возврат Запрос.Выполнить();

КонецФункции	

Процедура НайтиСоздатьДГККонтейнер(ДанныеПоВагонамРефСцепа, РефСцеп, РефСцепНаименование)
	
	ТипТЕ	 = Справочники.ТипоразмерыТЕ.Тип40DG;
	НомерКТК = "ETSU" + Формат(Число(СокрЛП(РефСцепНаименование)), "ЧЦ=7; ЧВН=; ЧГ=0");
	
	КонтейнерПроверки = Справочники.ТЕ.НайтиПоНаименованию(НомерКТК);
	Если КонтейнерПроверки = Справочники.ТЕ.ПустаяСсылка() Тогда

		НовыйДГККонтейнер = РаботаСКонтейнерамиСервер.СоздатьКТК(ВРег(НомерКТК), ТипТЕ);
		
		ДобавлениеПризнаковКонтейнера(НовыйДГККонтейнер.Ссылка);
		
		ПолучитьДанныеДГКВагоновРефСцепа(ДанныеПоВагонамРефСцепа, РефСцеп);
		
	Иначе
		Если КонтейнерПроверки <> Справочники.ТипоразмерыТЕ.Тип40DG Тогда 
			Попытка
				ОбъектКонтейнерПроверки 	  = КонтейнерПроверки.ПолучитьОбъект();
				ОбъектКонтейнерПроверки.ТипТЕ = Справочники.ТипоразмерыТЕ.Тип40DG;
                ОбъектКонтейнерПроверки.Записать();
			Исключение	
			КонецПопытки;

			РаботаСКонтейнерамиСервер.ПодготовитьЗаписьДляИсточникаСоздания(КонтейнерПроверки.Ссылка);
			
			ДобавлениепризнаковКонтейнера(ОбъектКонтейнерПроверки.Ссылка);						
			
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры	

Функция ПолучитьДанныеПоВагонамРефСцепаРегистра(РефСцеп) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВагоныВРефСцепах.Вагон КАК Вагон,
		|	ВагоныВРефСцепах.ПорядковыйНомерВСцепе КАК ПорядковыйНомерВСцепе,
		|	ВагоныВРефСцепах.ПризнакВагона КАК ПризнакВагона,
		|	ВагоныВРефСцепах.Номер1Контроллера КАК Номер1Контроллера,
		|	ВагоныВРефСцепах.Номер2Контроллера КАК Номер2Контроллера,
		|	ВагоныВРефСцепах.EmailОтвтетственного КАК EmailОтвтетственного,
		|	ВагоныВРефСцепах.РефСцеп КАК РефСцеп,
		|	ВЫБОР
		|		КОГДА ВагоныВРефСцепах.Вагон <> ЗНАЧЕНИЕ(Справочник.ТС.ПустаяСсылка)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЕстьВагонВРегистреНаФорме,
		|	ВЫБОР
		|		КОГДА ВагоныВРефСцепах.Вагон <> ЗНАЧЕНИЕ(Справочник.ТС.ПустаяСсылка)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЕстьВагонДокументаВБазе,
		|	ВагоныВРефСцепах.ПорядковыйНомерВСцепе КАК ПорядковыйНомерВСцепеРегистраНаФорме
		|ИЗ
		|	РегистрСведений.ВагоныВРефСцепах КАК ВагоныВРефСцепах
		|ГДЕ
		|	ВагоныВРефСцепах.РефСцеп = &РефСцеп
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПорядковыйНомерВСцепе";
	Запрос.УстановитьПараметр("РефСцеп", РефСцеп);
	
	Возврат Запрос.Выполнить().Выгрузить();    
	
КонецФункции

Функция ПолучитьДанныеРегистраИДокумента(РефСцеп, тзДанныеТЧВагоныДокументаФормы, ЭтоОбновлениеДанныхИзРегистра, Ссылка) Экспорт
	
	тзДанныеРегистраРефСцеп = ПолучитьДанныеПоВагонамРефСцепаРегистра(РефСцеп);
	
	Для каждого СтрДокумента из тзДанныеТЧВагоныДокументаФормы Цикл
		
		СтрокаРегистраРефСцепа = тзДанныеРегистраРефСцеп.Найти(СтрДокумента.Вагон); 
		Если СтрокаРегистраРефСцепа <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрДокумента, 
				СтрокаРегистраРефСцепа, , "ПорядковыйНомерВСцепе"); 
		КонецЕсли;		
		
	КонецЦикла;
	
	Если тзДанныеРегистраРефСцеп.Количество() = 0 Тогда
		
		тзДанныеТЧВагоныДокументаФормы.ЗаполнитьЗначения(Ложь, "ЕстьВагонВРегистреНаФорме");
		
    КонецЕсли;
	
	// данные по документу в базе
	Если ЭтоОбновлениеДанныхИзРегистра Тогда
		
		Для каждого СтрРегистра из тзДанныеРегистраРефСцеп Цикл
			
			Если тзДанныеТЧВагоныДокументаФормы.Найти(СтрРегистра.Вагон) = неопределено Тогда
				ЗаполнитьЗначенияСвойств(тзДанныеТЧВагоныДокументаФормы.Добавить(), СтрРегистра);  
			КонецЕсли;
			
		КонецЦикла;	
		
		ДанныеПоВагонамВБазе = ПолучитьДанныеДокументаВБазе(Ссылка);
		
		Для каждого стр из тзДанныеРегистраРефСцеп Цикл 
			
			Если ДанныеПоВагонамВБазе.Найти(стр.Вагон, "Вагон") = неопределено Тогда
				
				// Если нет в данных документа в базе, отмечаем
				
				мСтрокДанныеТЧВагоныДокументаФормы = тзДанныеТЧВагоныДокументаФормы
					.НайтиСтроки(Новый Структура("Вагон", стр.Вагон));				
					
				Для каждого СтрТЧВагоны из мСтрокДанныеТЧВагоныДокументаФормы Цикл
					СтрТЧВагоны.ЕстьВагонДокументаВБазе = Ложь;
				КонецЦикла;	
				
			КонецЕсли;	
			
		КонецЦикла;	
		
	КонецЕсли;	
	
	Возврат тзДанныеТЧВагоныДокументаФормы;    
	
КонецФункции

Функция ПолучитьДанныеДокументаВБазе(Ссылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РефСцепВагоныРефСцепа.Вагон КАК Вагон,
		|	РефСцепВагоныРефСцепа.ПорядковыйНомерВСцепе КАК ПорядковыйНомерВСцепе
		|ИЗ
		|	Документ.РефСцеп.ВагоныРефСцепа КАК РефСцепВагоныРефСцепа
		|ГДЕ
		|	РефСцепВагоныРефСцепа.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	РефСцепВагоныРефСцепа.Вагон,
		|	РефСцепВагоныРефСцепа.ПорядковыйНомерВСцепе
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПорядковыйНомерВСцепе";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции	

Функция ПолучитьДанныеФормыРегистраБазыДокумента
	(тзДанныеРефСцепаДокумента
	,РефСцеп 
	,ЭтоОбновлениеДанныхИзРегистра = Истина
	,Ссылка) Экспорт
	
	тзДанныеРефСцепаДокумента.ЗаполнитьЗначения
		(не ЭтоОбновлениеДанныхИзРегистра, "ЕстьВагонВРегистреНаФорме");
	тзДанныеРефСцепаДокумента.ЗаполнитьЗначения
		(Истина, "ЕстьВагонДокументаВБазе");
	
	тзДанныеРефСцепаДокументаИРегистра = ПолучитьДанныеРегистраИДокумента(РефСцеп
		, тзДанныеРефСцепаДокумента, ЭтоОбновлениеДанныхИзРегистра, Ссылка);
	
	тзДанныеРефСцепаДокументаИРегистраДляДислокации = тзДанныеРефСцепаДокументаИРегистра.Скопировать(,"Вагон,
			|ПорядковыйНомерВСцепе,
			|ПризнакВагона,
			|Номер1Контроллера,
			|Номер2Контроллера,
			|ЕстьВагонВРегистреНаФорме,
			|ЕстьВагонДокументаВБазе,
			|ПорядковыйНомерВСцепеРегистраНаФорме");
	
	тзДанныеРефСцепаДокументаИРегистраДляДислокации.Свернуть("Вагон,
			|ПорядковыйНомерВСцепе,
			|ПризнакВагона,
			|Номер1Контроллера,
			|Номер2Контроллера,
			|ЕстьВагонВРегистреНаФорме,
			|ЕстьВагонДокументаВБазе,
			|ПорядковыйНомерВСцепеРегистраНаФорме");
	
	тзДислокацииВагонов = ПолучитьДанныеДислокацииВагоновРефСцепа(
	 	тзДанныеРефСцепаДокументаИРегистраДляДислокации);
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тз_Дислокация.Вагон КАК Вагон,
		|	тз_Дислокация.ПорядковыйНомерВСцепе КАК ПорядковыйНомерВСцепе,
		|	тз_Дислокация.ПризнакВагона КАК ПризнакВагона,
		|	тз_Дислокация.Номер1Контроллера КАК Номер1Контроллера,
		|	тз_Дислокация.Номер2Контроллера КАК Номер2Контроллера,
		|	тз_Дислокация.ЕстьВагонВРегистреНаФорме КАК ЕстьВагонВРегистреНаФорме,
		|	тз_Дислокация.ЕстьВагонДокументаВБазе КАК ЕстьВагонДокументаВБазе,
		|	тз_Дислокация.ПорядковыйНомерВСцепеРегистраНаФорме КАК ПорядковыйНомерВСцепеРегистраНаФорме,
		|	тз_Дислокация.ДатаТекущейОперации КАК ДатаТекущейОперации,
		|	тз_Дислокация.ТекущаяОперацияСВагоном КАК ТекущаяОперацияСВагоном,
		|	тз_Дислокация.ИндексПоезда КАК ИндексПоезда,
		|	тз_Дислокация.Собственник КАК Собственник,
		|	тз_Дислокация.СтанцияТекущейОперации КАК СтанцияТекущейОперации,
		|	тз_Дислокация.ПростойНаСтанции КАК ПростойНаСтанции,
		|	тз_Дислокация.ОстаточноеРасстояние КАК ОстаточноеРасстояние,
		|	тз_Дислокация.ДатаПредыдущейОперации КАК ДатаПредыдущейОперации,
		|	тз_Дислокация.ПредыдущаяОперацияСВагоном КАК ПредыдущаяОперацияСВагоном,
		|	тз_Дислокация.СтанцияПредыдущейОперации КАК СтанцияПредыдущейОперации,
		|	тз_Дислокация.ДорогаТекущейОперации КАК ДорогаТекущейОперации,
		|	тз_Дислокация.ДорогаПредыдущейОперации КАК ДорогаПредыдущейОперации,
		|	тз_Дислокация.ПериодМеждуОперациями КАК ПериодМеждуОперациями,
		|	тз_Дислокация.ТехСостояниеВагона КАК ТехСостояниеВагона
		|ПОМЕСТИТЬ вт_Дислокация
		|ИЗ
		|	&тз_Дислокация КАК тз_Дислокация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	тз_ВагоныРефСцепаДокумента.Вагон КАК Вагон,
		|	тз_ВагоныРефСцепаДокумента.ПорядковыйНомерВСцепе КАК ПорядковыйНомерВСцепе,
