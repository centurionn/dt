Функция ПолучитьЗаявкиПоКлючамАналитикиРефСцепа(КлючиАналитикиПеревозкиРефСцепа, ДокументРефСцепСсылка) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗаявкаСоставУслуги.Ссылка КАК Заявка,
		|	ЗаявкаСоставУслуги.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	ЗаявкаСоставУслуги.Ссылка.Дата КАК Дата
		|ИЗ
		|	Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
		|ГДЕ
		|	ЗаявкаСоставУслуги.КлючАналитикиПеревозки В(&КлючиАналитикиПеревозки)
		|	И ЗаявкаСоставУслуги.ПеренесенВЗаявку = ЗНАЧЕНИЕ(Документ.Заявка.ПустаяСсылка)
		|	И ЗаявкаСоставУслуги.КлючАналитикиПеревозки <> ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПеревозки.ПустаяСсылка)
		|	И ЗаявкаСоставУслуги.Ссылка.ПометкаУдаления = ЛОЖЬ
		|";
	
	Запрос.УстановитьПараметр("КлючиАналитикиПеревозки", КлючиАналитикиПеревозкиРефСцепа);
	Запрос.УстановитьПараметр("ДокументРефСцеп", ДокументРефСцепСсылка);
	
	Возврат Запрос.Выполнить();
КонецФункции	


