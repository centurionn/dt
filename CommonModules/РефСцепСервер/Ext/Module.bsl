			Если Выборка.РефСцеп <> Документы.РефСцеп.ПустаяСсылка() Тогда			
				
				//УстановитьРейсЗавершенДокументаПустыхРефСцепов(Выборка);
				
				НоваяЗадачаОбновитьДанныеПоРефСцепу(Выборка);
				
			КонецЕсли;	
			
		Иначе
			
