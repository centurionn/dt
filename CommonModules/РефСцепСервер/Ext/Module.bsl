Функция ПолучитьДанныеПревышенияПоТЕУ(тзВагоны) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Вт_ВагоныИКонтейнеры.Вагон КАК Вагон,
		|	Вт_ВагоныИКонтейнеры.Контейнер КАК Контейнер
		|ПОМЕСТИТЬ Вт_ВагоныИКонтейнеры1
		|ИЗ
		|	&тзВагоны КАК Вт_ВагоныИКонтейнеры
		|ГДЕ
		|	Вт_ВагоныИКонтейнеры.Контейнер <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Вт_ВагоныИКонтейнеры.Вагон КАК Вагон,
		|	Вт_ВагоныИКонтейнеры.Контейнер КАК Контейнер,
		|	Контейнеры.ТипТЕ КАК ТипТЕ,
		|	Вагоны.ТипТС КАК ТипТС
		|ПОМЕСТИТЬ Вт_ВагоныИКонтейнеры0
		|ИЗ
		|	Вт_ВагоныИКонтейнеры1 КАК Вт_ВагоныИКонтейнеры
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТЕ КАК Контейнеры
		|		ПО Вт_ВагоныИКонтейнеры.Контейнер = Контейнеры.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТС КАК Вагоны
		|		ПО Вт_ВагоныИКонтейнеры.Вагон = Вагоны.Ссылка
		|ГДЕ
		|	Вт_ВагоныИКонтейнеры.Контейнер <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Вт_ВагоныИКонтейнеры.Вагон КАК Вагон,
		|	Вт_ВагоныИКонтейнеры.Контейнер КАК Контейнер,
		|	Вт_ВагоныИКонтейнеры.ТипТЕ КАК ТипТЕ,
		|	Вт_ВагоныИКонтейнеры.ТипТС КАК ТипТС,
		|	ТипоразмерыТЕ.РазмерКТК КАК РазмерКТК,
		|	ТипоразмерыТС.ТЕУ КАК ВагонРазмерВТЕУ
		|ПОМЕСТИТЬ Вт_ВагоныИКонтейнеры
		|ИЗ
		|	Вт_ВагоныИКонтейнеры0 КАК Вт_ВагоныИКонтейнеры
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТипоразмерыТЕ КАК ТипоразмерыТЕ
		|		ПО Вт_ВагоныИКонтейнеры.ТипТЕ = ТипоразмерыТЕ.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТипоразмерыТС КАК ТипоразмерыТС
		|		ПО Вт_ВагоныИКонтейнеры.ТипТС = ТипоразмерыТС.Ссылка
		|ГДЕ
		|	Вт_ВагоныИКонтейнеры.Контейнер <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Вт_ВагоныИКонтейнеры.Вагон КАК Вагон,
		|	ВЫБОР
		|		КОГДА Вт_ВагоныИКонтейнеры.РазмерКТК = ЗНАЧЕНИЕ(Справочник.РазмерыКТК.К20)
		|			ТОГДА 1
		|		КОГДА Вт_ВагоныИКонтейнеры.РазмерКТК = ЗНАЧЕНИЕ(Справочник.РазмерыКТК.К40)
		|			ТОГДА 2
		|		КОГДА Вт_ВагоныИКонтейнеры.РазмерКТК = ЗНАЧЕНИЕ(Справочник.РазмерыКТК.К45)
		|			ТОГДА 2
		|	КОНЕЦ КАК РазмерКТКвТЭУ,
		|	Вт_ВагоныИКонтейнеры.ВагонРазмерВТЕУ КАК ВагонРазмерВТЕУ
		|ПОМЕСТИТЬ вт_ТипоразмерыКонтейнеров
		|ИЗ
		|	Вт_ВагоныИКонтейнеры КАК Вт_ВагоныИКонтейнеры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ТипоразмерыКонтейнеров.Вагон КАК Вагон,
		|	ПРЕДСТАВЛЕНИЕ(вт_ТипоразмерыКонтейнеров.Вагон) КАК ПредставлениеВагона,
		|	СУММА(вт_ТипоразмерыКонтейнеров.РазмерКТКвТЭУ) КАК РазмерКТКвТЭУ,
		|	вт_ТипоразмерыКонтейнеров.ВагонРазмерВТЕУ КАК ВагонРазмерВТЕУ
		|ИЗ
		|	вт_ТипоразмерыКонтейнеров КАК вт_ТипоразмерыКонтейнеров
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_ТипоразмерыКонтейнеров.Вагон,
		|	вт_ТипоразмерыКонтейнеров.ВагонРазмерВТЕУ
		|
		|ИМЕЮЩИЕ
		|	СУММА(вт_ТипоразмерыКонтейнеров.РазмерКТКвТЭУ) > вт_ТипоразмерыКонтейнеров.ВагонРазмерВТЕУ";
	
	
	Запрос.УстановитьПараметр("тзВагоны", тзВагоны);
	
	Возврат Запрос.Выполнить().Выбрать();

