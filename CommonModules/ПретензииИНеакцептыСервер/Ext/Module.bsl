	               |	И АкцептУслуги.ПричинаНеакцепта <> ЗНАЧЕНИЕ(Справочник.Претензии.ПустаяСсылка)
	               |	И ВЫБОР
	               |			КОГДА &ТолькоДляПередачиВРИТМ
	               |				ТОГДА АкцептУслуги.ПричинаНеакцепта.ВыгружатьВРИТМ
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ";
	Запрос.УстановитьПараметр("Номер", НомерДокумента);
	Запрос.УстановитьПараметр("ТолькоДляПередачиВРИТМ", ТолькоДляПередачиВРИТМ);
	Запрос.УстановитьПараметр("НомерНеЗаполнен", НЕ ЗначениеЗаполнено(НомерДокумента));
	Запрос.УстановитьПараметр("ДатаНеЗаполнена", НЕ ЗначениеЗаполнено(НачалоПериодаПоиска));
	Запрос.УстановитьПараметр("Дата1", НачалоПериодаПоиска);
	Запрос.УстановитьПараметр("Дата2", КонецПериодаПоиска);
//Евросиб Гудкова( 29.10.2020 Ticket№ 0212208
	Запрос.УстановитьПараметр("СсылкаАкцепта", СсылкаАкцепта);
// Евросиб Гудкова) 				   
	Ответ = Запрос.Выполнить().Выбрать();
	
	Пока Ответ.Следующий() Цикл
		
		pmRfCode = СоответствиеВСФиpmRfCode.Получить(Ответ.Поступление);
		Если НЕ ЗначениеЗаполнено(pmRfCode) Тогда
