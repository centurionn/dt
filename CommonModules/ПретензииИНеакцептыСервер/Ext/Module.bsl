Функция ПолучитьТекстПолейДляАвтоакцепта(ВыборкаУслуг, ДляОписанияПричиныНеурегов = Ложь)
	
	//здесь настраивается вид таблицы, которая будет обрабатываться автоакцептом 
	//в зависимости от вида поиска:
	//основной поиск: значение как заполнено в акцепте
	//мягкий поиск: если заполнено, то как в акцепте, иначе в поиске не участвует
	
	ТекстПолей = "";
	ТекстПолей = ТекстПолей + СтрШаблон("%1 КАК Приоритет,
	|", ВыборкаУслуг.НомерСтроки);
	
	//Контейнер
	Если ВыборкаУслуг.Контейнер = Перечисления.ВидыПоискаАвтоакцепт.ОсновнойПоиск Тогда
		ТекстПолей = ТекстПолей + "АкцептУслуги.Контейнер КАК КонтейнерДляОтбора,
		|ИСТИНА КАК ЗаполненКонтейнерДляОтбора,
		|";
	Иначе
		//ТекстПолей = "Значение(Справочник.ТЕ.ПустаяСсылка) КАК Контейнер,
		ТекстПолей = ТекстПолей + "Неопределено КАК КонтейнерДляОтбора,
		|ЛОЖЬ КАК ЗаполненКонтейнерДляОтбора,
		|";
	КонецЕсли; 
	//Вагон
	Если ВыборкаУслуг.Вагон = Перечисления.ВидыПоискаАвтоакцепт.ОсновнойПоиск Тогда
		ТекстПолей = ТекстПолей + "АкцептУслуги.Вагон КАК ВагонДляОтбора,
		|ИСТИНА КАК ЗаполненВагонДляОтбора,
		|";
	Иначе
		//ТекстПолей = "Значение(Справочник.ТЕ.ПустаяСсылка) КАК Вагон,
		ТекстПолей = ТекстПолей + "Неопределено КАК ВагонДляОтбора,
