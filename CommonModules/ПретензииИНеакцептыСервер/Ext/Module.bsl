	|	РейсыЖДФактическийСоставПоезда.НомерНакладной КАК НомерНакладной,
	|	ТЕ.Ссылка КАК Контейнер,
	|	ТС.Ссылка КАК Вагон,
	|	РейсыЖД.ПунктОтправления КАК СтанцияОтправления,
	|	РейсыЖД.ПунктНазначения КАК СтанцияНазначения,
	|	РейсыЖД.ДатаОтправления КАК НачалоОказанияУслуги,
	|	РейсыЖД.ДатаПрибытия КАК ОкончаниеОказанияУслуги
	|ИЗ
	|	УслугиДляРазнесения КАК УслугиДляРазнесения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РейсыЖД.ФактическийСоставПоезда КАК РейсыЖДФактическийСоставПоезда
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТС КАК ТС
	|			ПО РейсыЖДФактическийСоставПоезда.НомерВагона = ТС.Наименование
	|				И (РейсыЖДФактическийСоставПоезда.НомерВагона <> """")
	|		ПО УслугиДляРазнесения.Рейс = РейсыЖДФактическийСоставПоезда.Ссылка
	//|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТЕ КАК ТЕ
	//|		ПО (ПОДСТРОКА(РейсыЖДФактическийСоставПоезда.НомерКонтейнера, 1, 4) = ТЕ.Префикс)
	//|			И (ПОДСТРОКА(РейсыЖДФактическийСоставПоезда.НомерКонтейнера, 5, 6) = ТЕ.Номер)
	//ДИТ, Беляев СЮ, BUG 79423/ TASK 79490, 17-01-2024, начало
	|			И РейсыЖДФактическийСоставПоезда.НомерКонтейнера <> """"
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТЕ КАК ТЕ
	|		ПО (ПОДСТРОКА(РейсыЖДФактическийСоставПоезда.НомерКонтейнера, 1, 4) = ТЕ.Префикс)
	|			И (ПОДСТРОКА(РейсыЖДФактическийСоставПоезда.НомерКонтейнера, 5, 6) = ТЕ.Номер)
	|			И НЕ ТЕ.ПометкаУдаления
	//ДИТ, Беляев СЮ, BUG 79423/ TASK 79490, 17-01-2024, конец
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РейсыЖД КАК РейсыЖД
	|		ПО УслугиДляРазнесения.Рейс = РейсыЖД.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтрокиАкцепта,
	|	НомерСтрокиРейса";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Акцепт.Услуги КАК АкцептУслуги", "&АкцептУслуги КАК АкцептУслуги");	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "АкцептУслуги.Ссылка = &Акцепт", "ИСТИНА");
	
	Запрос.УстановитьПараметр("Поступление", Акцепт.Поступление);
	
	//Евросиб Каблов 10.01.2024 ( #99682
	//ТаблицаУслуг = Акцепт.Услуги.Выгрузить(Новый Структура("Сделка", Документы.Сделка.ПустаяСсылка()));
	ТаблицаУслуг = Акцепт.Услуги.ВыгрузитьКолонки();
	СписокНоменклатуры = ОбщегоНазначенияКлиентСервер.СвернутьМассив(Акцепт.Услуги.ВыгрузитьКолонку("Номенклатура"));
	СоответствиеМассивовСписокОбязательныхПолейВАкцепте = Документы.Акцепт.ПолучитьСоответствиеМассивовСписокОбязательныхПолейВАкцептеПоСпискуНоменклатуры(СписокНоменклатуры);
	Для каждого СтрокаАкцепта Из Акцепт.Услуги Цикл
		
		Если СтрокаАкцепта.Неурег = Справочники.ПричиныНеурегулированныхРасходов.ОтработкаВРИТМ
			ИЛИ ЗначениеЗаполнено(СтрокаАкцепта.Сделка) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаУслуга = ТаблицаУслуг.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаУслуга, СтрокаАкцепта);
		
		МассивСписокОбязательныхПолейВАкцепте = СоответствиеМассивовСписокОбязательныхПолейВАкцепте.Получить(СтрокаУслуга.Номенклатура);
		НезаполненныеОбязательныеПоля = Новый Массив;
		Для каждого ИмяОбязательногоПоляВАкцепте Из МассивСписокОбязательныхПолейВАкцепте Цикл
			Если Не ЗначениеЗаполнено(СтрокаУслуга[ИмяОбязательногоПоляВАкцепте]) Тогда
				НезаполненныеОбязательныеПоля.Добавить(ИмяОбязательногоПоляВАкцепте);
			КонецЕсли;
		КонецЦикла;
		Если ЗначениеЗаполнено(НезаполненныеОбязательныеПоля) Тогда
			СтрокаУслуга.Неурег = Справочники.ПричиныНеурегулированныхРасходов.НеЗаполненыОбязательныеПоляВАкцепте;
			ТекстПричиныНеурега = СтрШаблон("Не заполнены поля: %1. Авторазнесение невозможно", СтрСоединить(НезаполненныеОбязательныеПоля, ", "));
			СтрокаУслуга.НеурегКомментарий = ТекстПричиныНеурега;
			Продолжить;
		ИначеЕсли СтрокаУслуга.Неурег = Справочники.ПричиныНеурегулированныхРасходов.НеЗаполненыОбязательныеПоляВАкцепте Тогда
			СтрокаУслуга.Неурег = Справочники.ПричиныНеурегулированныхРасходов.ПустаяСсылка();
			СтрокаУслуга.НеурегКомментарий = "";
		КонецЕсли;
	КонецЦикла;
	//Евросиб Каблов 10.01.2024 )
	
	Запрос.УстановитьПараметр("АкцептУслуги", ТаблицаУслуг);	
	Запрос.УстановитьПараметр("СпособРазнесенияРаспределитьРасходыМеждуКлиентами", Перечисления.СпособыРазнесенияРасходов.РаспределитьРасходыМеждуКлиентами);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();	
	КоличествоЗапросов = РезультатыЗапроса.Количество();
	ТаблицаАкцепта = РезультатыЗапроса[КоличествоЗапросов - 2].Выгрузить();
	
	Если ЗначениеЗаполнено(ТаблицаАкцепта) Тогда
		
		ТаблицаКТК = РезультатыЗапроса[КоличествоЗапросов - 1].Выгрузить();
		
		ТаблицаДляПоискаТД = Новый ТаблицаЗначений;
		ТаблицаДляПоискаТД.Колонки.Добавить("НомерТранспортногоДокумента", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(100)));
		ТаблицаДляПоискаТД.Колонки.Добавить("Поступление", Новый ОписаниеТипов("ДокументСсылка.ПоступлениеТоваровУслуг"));
		ТаблицаДляПоискаТД.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ТаблицаДляПоискаТД.Колонки.Добавить("ТранспортныйДокумент", Новый ОписаниеТипов("ДокументСсылка.ТранспортныйДокумент"));
		ТаблицаДляПоискаТД.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(36)));
		
		Для Каждого СтрокаТаблицыАкцепта Из ТаблицаАкцепта Цикл
			
			ИсходнаяСтрокаАкцепта = Акцепт.Услуги.Найти(СтрокаТаблицыАкцепта.ГУИД, "ГУИД");
			ИндексНовойСтроки = Акцепт.Услуги.Индекс(ИсходнаяСтрокаАкцепта);
			
			СтрокиТаблицыКТК = ТаблицаКТК.НайтиСтроки(Новый Структура("ГУИД", СтрокаТаблицыАкцепта.ГУИД));
			Если ЗначениеЗаполнено(СтрокиТаблицыКТК) Тогда
				
				КоличествоСтрокКТК = СтрокиТаблицыКТК.Количество();
				СуммаОстаток = СтрокаТаблицыАкцепта.ПоступлениеСумма;
				СуммаНДСОстаток = СтрокаТаблицыАкцепта.ПоступлениеСуммаНДС;
				Сумма = Окр(СтрокаТаблицыАкцепта.ПоступлениеСумма / КоличествоСтрокКТК, 2);
				СуммаНДС = Окр(СтрокаТаблицыАкцепта.ПоступлениеСуммаНДС / КоличествоСтрокКТК, 2);
				
				Для Каждого СтрокаТаблицыКТК Из СтрокиТаблицыКТК Цикл
					
					НоваяСтрока = Акцепт.Услуги.Вставить(ИндексНовойСтроки);
					
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ИсходнаяСтрокаАкцепта,, "ГУИД, Рейс");
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыКТК,, "ГУИД");
					НоваяСтрока.ГУИД = Новый УникальныйИдентификатор;
					
					//СуммаПоСтроке = Мин(Сумма, СуммаОстаток);
					//СуммаНДСПоСтроке = Мин(СуммаНДС, СуммаНДСОстаток);
					
					НоваяСтрока.ПоступлениеКоличество = 1;				
					НоваяСтрока.ПоступлениеСумма = Сумма;
					НоваяСтрока.ПоступлениеЦена = Сумма;				
					НоваяСтрока.ПоступлениеСуммаНДС = СуммаНДС;
					
					СуммаОстаток = СуммаОстаток - Сумма;
					СуммаНДСОстаток = СуммаНДСОстаток - СуммаНДС;
					
					ИндексНовойСтроки = ИндексНовойСтроки + 1;
					
					Если ЗначениеЗаполнено(СтрокаТаблицыКТК.НомерНакладной) Тогда
						СтрокаТД = ТаблицаДляПоискаТД.Добавить();
						ЗаполнитьЗначенияСвойств(СтрокаТД, НоваяСтрока);
						СтрокаТД.ИдентификаторСтроки = НоваяСтрока.ГУИД;
						СтрокаТД.Поступление = Акцепт.Поступление;
						СтрокаТД.НомерТранспортногоДокумента = СтрокаТаблицыКТК.НомерНакладной;
					КонецЕсли;
					
				КонецЦикла;
				
				Если СуммаОстаток <> 0 Тогда
					НоваяСтрока.ПоступлениеСумма = НоваяСтрока.ПоступлениеСумма + СуммаОстаток;
					НоваяСтрока.ПоступлениеЦена = НоваяСтрока.ПоступлениеСумма;
				КонецЕсли;
				
