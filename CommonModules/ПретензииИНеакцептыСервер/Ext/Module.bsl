	|
	|УПОРЯДОЧИТЬ ПО
	|	ГУИД,
	|	Приоритет";
	ВыборкаПричинНеурегов = Запрос.Выполнить().Выбрать();
	Пока ВыборкаПричинНеурегов.СледующийПоЗначениюПоля("ГУИД") Цикл
		СтрокаАкцепта = Акцепт.Услуги.Найти(ВыборкаПричинНеурегов.ГУИД, "ГУИД"); 
		Пока ВыборкаПричинНеурегов.СледующийПоЗначениюПоля("Приоритет") Цикл
			МассивОбязательныхПолей = ПолучитьМассивОбязательныхПолей(ВыборкаПричинНеурегов, Истина, Истина);
			ТекстПричиныНеурега = СтрШаблон("Не заполнены поля: %1. Авторазнесение невозможно", СтрСоединить(МассивОбязательныхПолей, "/"));
			СтрокаАкцепта.Неурег = Справочники.ПричиныНеурегулированныхРасходов.НеЗаполненыОбязательныеПоляВАкцепте;
			СтрокаАкцепта.НеурегКомментарий = ТекстПричиныНеурега;
			Прервать
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры  


//Евросиб Каблов 02.08.2023 #64831
Процедура ВыполнитьАвторазнесениеАкцептаНаПрямые(Акцепт, Сделки) Экспорт
	
