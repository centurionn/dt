		//Было
		//ИндексЗначенияПеречисления = Перечисления.СтатусыПричинНеакцепта.Индекс(Ответ.СтатусПричины);
		//ИмяЗначенияПеречисленияСтатусаПричиныНеакцепта = Метаданные.Перечисления.СтатусыПричинНеакцепта.ЗначенияПеречисления[ИндексЗначенияПеречисления].Имя;
		Если ЗначениеЗаполнено(Ответ.СтатусПричины) Тогда
			ИндексЗначенияПеречисления = Перечисления.СтатусыПричинНеакцепта.Индекс(Ответ.СтатусПричины);
			ИмяЗначенияПеречисленияСтатусаПричиныНеакцепта = Метаданные.Перечисления.СтатусыПричинНеакцепта.ЗначенияПеречисления[ИндексЗначенияПеречисления].Имя;
		Иначе
			ИмяЗначенияПеречисленияСтатусаПричиныНеакцепта = "";
		КонецЕсли;
		//Трундуков Конец
		Результат.Добавить(Новый Структура("СтанцияОтправления, СтанцияНазначения, ДатаНачалаУслуги, ДатаОкончанияУслуги, pmRfCode, pmtRFC, pmtObjDate, pmtObjSum, vSymCode, pmtErrCodes, pmtErrText, pmtObjFulfilment, pmtNotes, pmtIsActual, Поступление, Акцепт, Номенклатура, ПричинаНеакцепта, СтатусПричины, Вагон, Контейнер, ТранспортныйДокумент, Количество, Цена, Сумма, СтавкаНДС, СуммаНДС, СуммаПретензии, ПодтвержденнаяСумма",
					Ответ.СтанцияОтправления, Ответ.СтанцияНазначения, Ответ.НачалоОказанияУслуги, Ответ.ОкончаниеОказанияУслуги, pmRfCode, Ответ.pmtRFC, Ответ.ДатаПретензии, Ответ.СуммаПретензии, Ответ.ВалютаПретензий, Ответ.pmtErrCodes, Ответ.ПричинаНеакцепта, ИмяЗначенияПеречисленияСтатусаПричиныНеакцепта, Ответ.ПримечаниеНеакцепта, неопределено, Ответ.Поступление, Ответ.Акцепт, Ответ.Номенклатура, Ответ.ПричинаНеакцепта, Ответ.СтатусПричины, Ответ.Вагон, Ответ.Контейнер, Ответ.ТранспортныйДокумент, Ответ.Количество, Ответ.Цена, Ответ.Сумма, Ответ.СтавкаНДС, Ответ.СуммаНДС, Ответ.СуммаПретензии, Ответ.ПодтвержденнаяСумма));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьpmRfCodeпоВСФ(ПТУ)
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПротоколОбменов.УИДИсточника КАК УИДИсточника,
	               |	ПротоколОбменов.Объект КАК Объект,
	               |	ПротоколОбменов.ДатаОбмена КАК ДатаОбмена
	               |ИЗ
	               |	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	               |ГДЕ
	               |	ПротоколОбменов.Объект = &Объект
	               |	И ПротоколОбменов.УзелОбмена = &РИТМ
	               |	И ПротоколОбменов.ДействиеПриОбмене = &ЗагрузкаДанных
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПротоколОбменов.ДатаОбмена УБЫВ";
	Запрос.УстановитьПараметр("РИТМ", Перечисления.УзлыОбмена.РИТМ);
	Запрос.УстановитьПараметр("ЗагрузкаДанных", Перечисления.ДействияПриОбмене.ЗагрузкаДанных);
	Запрос.УстановитьПараметр("Объект", ПТУ);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.УИДИсточника;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

