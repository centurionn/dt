Функция ПолучитьВесНеттоПоНакладной(НомерЖДН, НомерКТК) Экспорт
	
	Результат = 0;
	
	Если НЕ ЗначениеЗаполнено(НомерЖДН) ИЛИ НЕ ЗначениеЗаполнено(НомерКТК) Тогда Возврат Результат; КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	э_НакладнаяКонтейнеры.МассыВКгНетто КАК МассыВКгНетто
	               |ИЗ
	               |	Документ.э_Накладная.Контейнеры КАК э_НакладнаяКонтейнеры
	               |ГДЕ
	               |	э_НакладнаяКонтейнеры.НомерКонтейнера = &НомерКонтейнера
	               |	И НЕ э_НакладнаяКонтейнеры.Ссылка.ПометкаУдаления
	               |	И э_НакладнаяКонтейнеры.Ссылка.НакладнаяНомер = &НакладнаяНомер
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	э_НакладнаяКонтейнеры.Ссылка.Дата УБЫВ";
	Запрос.УстановитьПараметр("НомерКонтейнера", НомерКТК);
	Запрос.УстановитьПараметр("НакладнаяНомер", НомерЖДН);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.МассыВКгНетто;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

