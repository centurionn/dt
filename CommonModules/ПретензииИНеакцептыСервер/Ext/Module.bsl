			Расходы = Новый Массив;
			Расходы.Добавить(ДанныеСтроки);
			
			РаботаСоСделкамиСервер.ДобавитьСтрокиРасходовВСделку(СделкаОбъект, Расходы, Истина);
			
			НайдСтроки = Акцепт.Услуги.НайтиСтроки(Новый Структура("ГУИД", СтрУслуг.ГУИД));
			Для каждого СтрокаАкцепта из НайдСтроки Цикл
				
				СтрокаАкцепта.ИдентификаторСтрокиРасходовВСделке = ГУИДРасходов;
				СтрокаАкцепта.Сделка = Сделка;
				СтрокаАкцепта.ПолностьюРазнесено = Не СтрУслуг.РазрешитьМногократноеРазнесение;		
				СтрокаАкцепта.ПривязалПользователь = Неопределено;
				СтрокаАкцепта.Сумма = СтрокаАкцепта.ПоступлениеСумма;
				СтрокаАкцепта.СуммаНДС = СтрокаАкцепта.ПоступлениеСуммаНДС;
				// Евросиб US 94195 TA 104912 Рыбьяков К.А. 16.03.2025 (( закомментпровал
				//Евросиб Каблов 29.05.2024 ( #85354 Пока не внедрять
				//СтрокаАкцепта.Неурег = Справочники.ПричиныНеурегулированныхРасходов.ПустаяСсылка();
				//СтрокаАкцепта.НеурегКомментарий = "";
				// Евросиб Рыбьяков К.А. 16.03.2025 ))
				//СтрокаАкцепта.ВариантРазнесения = Перечисления.ВариантыРазнесенияЗатрат.РазнесениеНаПрямые;
				//Евросиб Каблов 29.05.2024 )
				
			КонецЦикла;
			
		ИначеЕсли КоличествоСтрокСделок = 0 Тогда
			
			НайденныеСтроки = Акцепт.Услуги.НайтиСтроки(Новый Структура("ГУИД", СтрУслуг.ГУИД));
			Для Каждого СтрокаАкцепта Из НайденныеСтроки Цикл
				СтрокаАкцепта.Неурег = Справочники.ПричиныНеурегулированныхРасходов.НеНайденыСтрокиРасходовВСделкахПоПериоду;
				СтрокаАкцепта.НеурегКомментарий = "";
			КонецЦикла;
			
		Иначе
			
			ПоляПоиска = Новый Массив;
			Если ЗначениеЗаполнено(СтрУслуг.Контейнер) Тогда
				ПоляПоиска.Добавить("Контейнер");
			КонецЕсли;				
			Если ЗначениеЗаполнено(СтрУслуг.Вагон) Тогда
				ПоляПоиска.Добавить("Вагон");
			КонецЕсли;				
			Если ЗначениеЗаполнено(СтрУслуг.ТранспортныйДокумент) Тогда
				ПоляПоиска.Добавить("Накладная");
			КонецЕсли;
			СтрокаПоляПоиска = СтрСоединить(ПоляПоиска, "/");
			
			НайденныеСтроки = Акцепт.Услуги.НайтиСтроки(Новый Структура("ГУИД", СтрУслуг.ГУИД));
			Для Каждого СтрокаАкцепта Из НайденныеСтроки Цикл
				
				Если КоличествоСтрокСП > 1 Тогда			
					СтрокаАкцепта.Неурег = Справочники.ПричиныНеурегулированныхРасходов.НайденоНесколькоСтрокВСоставеПоезда;					
					ТаблицаНомераСделок = ТаблицаСделок.Скопировать(СтрокиСП, "НомерСделки, ДатаСделки");					
				Иначе					
					СтрокаАкцепта.Неурег = Справочники.ПричиныНеурегулированныхРасходов.НеНайденыСтрокиВСоставеПоезда;
					ТаблицаНомераСделок = ТаблицаСделок.Скопировать(СтрокиСделок, "НомерСделки, ДатаСделки");					
				КонецЕсли;
				
				НомераСделок = Новый Массив;
				ТаблицаНомераСделок.Свернуть("НомерСделки, ДатаСделки");
				Для Каждого Стр Из ТаблицаНомераСделок Цикл
					НомераСделок.Добавить(СтрШаблон("%1/%2", Стр.НомерСделки, Формат(Стр.ДатаСделки, "ДФ=yyyy")));
				КонецЦикла;
				СтрокаНомераСделок = СтрСоединить(НомераСделок, ", ");
				
				Шаблон = "Найденные сделки: %1. Вид ТС: %2. Поля для поиска: %3. Разнесение на прямые невозможно.";
				Комментарий = СтрШаблон(Шаблон, СтрокаНомераСделок, СтрУслуг.РазноситьНаВидТранспортногоСообщения, СтрокаПоляПоиска);
				СтрокаАкцепта.НеурегКомментарий = Комментарий;
			
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

