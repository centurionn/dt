Процедура ЗаписьДанныхОчередиАвторазнесения(Поступление, ТолькоИзменятьЗапись = Истина, СостояниеАвторазнесения = Неопределено, ДатаРазнесения = Неопределено) Экспорт
	мз = РегистрыСведений.ОчередьАвторазнесения.СоздатьМенеджерЗаписи();
	мз.Поступление = Поступление;
	Если СостояниеАвторазнесения = Неопределено
		ИЛИ ДатаРазнесения = Неопределено 
		ИЛИ ТолькоИзменятьЗапись Тогда
		мз.Прочитать();
		Если мз.Выбран() Тогда
			Если СостояниеАвторазнесения = Неопределено Тогда
				СостояниеАвторазнесения = мз.СостояниеАвторазнесения;
			КонецЕсли;
			Если ДатаРазнесения = Неопределено Тогда
				ДатаРазнесения = мз.ДатаРазнесения;
			КонецЕсли;        
		ИначеЕсли ТолькоИзменятьЗапись Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	мз.Поступление = Поступление;
	мз.СостояниеАвторазнесения = СостояниеАвторазнесения;
	мз.ДатаРазнесения = ДатаРазнесения;
	мз.Записать();
КонецПроцедуры

Процедура ИсключитьИзОчередиАвторазнесения(Поступление) Экспорт
	мз = РегистрыСведений.ОчередьАвторазнесения.СоздатьМенеджерЗаписи();
	мз.Поступление = Поступление;
	мз.Прочитать();
	Если мз.Выбран() Тогда
		мз.Удалить();
	КонецЕсли;
КонецПроцедуры


Функция ДокументНаходитсяВОчередиАвторазнесения(Поступление) Экспорт  
	Отбор = Новый Структура("Поступление", Поступление);
	ВыборкаОчереди = РегистрыСведений.ОчередьАвторазнесения.Выбрать(Отбор); 
	Возврат ВыборкаОчереди.Следующий();
КонецФункции

