Функция РазнестиПТУНовыйАлгоритм(ПТУ, РазнестиТолькоЗаполненныеКТКилиВагон = Ложь, СтрокиДляОтключения = Неопределено, РежимБитыеСсылки = Ложь) Экспорт
	
	СтруктураРезультата = Новый Структура("РезультатРазнесения, ТаблицаЛогирования");
	//Строки для отключения это таблица значений из колонок "гуид расходов", "сделка"
	//если она заполнена, то по этому списку происходит перепривязка расходов в рамках этой же сделки
//Евросиб Гудкова( 06.12.2021 Ticket№ 42922
	ОписаниеЗамера = ОценкаПроизводительности.НачатьЗамерДлительнойОперации("АвторазнесениеСервер");
// Евросиб Гудкова)
	НЗ = 0;
	ДЗ(ПТУ,,НЗ, "=== Начало авторазнесения для ПТУ");
	СтатусРазнесения = Документы.Акцепт.ПолучитьДанныеПоследнегоПроведенногоАкцепта(ПТУ).СтатусРазнесения;
	ЗаписьДанныхОчередиАвторазнесения(ПТУ, Истина, СтатусРазнесения, ТекущаяДата());
	Если ТипЗнч(ПТУ) = Тип("ДокументСсылка.КорректировкаПоступления") Тогда
		Если СтатусРазнесения = Перечисления.СостоянияАвторазнесения.АкцептНеСоздан Тогда
			СтруктураРезультата.РезультатРазнесения = СтрШаблон("%1: по документу нет проведенного акцепта. Авторазнесение отменено.", ПТУ);
			Возврат СтруктураРезультата;
		КонецЕсли;
		Если ПТУ.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение")
			И Не ПТУ.КорректироватьСуммыВПервичномВСФ Тогда
			СтруктураРезультата.РезультатРазнесения = СтрШаблон("%1: Корректировочный ВСФ необходимо разносить вручную. Авторазнесение отменено.", ПТУ);
			Возврат СтруктураРезультата;
		КонецЕсли;
		//Евросиб Каблов 17.01.2024 ( #79488
		РеквизитыПТУ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПТУ, "Штраф");
		Если РеквизитыПТУ.Штраф Тогда
			СтруктураРезультата.РезультатРазнесения = СтрШаблон("%1: к авторазнесению не принимаются документы с признаком «Штраф». Авторазнесение отменено.", ПТУ);		
			Возврат СтруктураРезультата;
		КонецЕсли;
	Иначе
		РеквизитыПТУ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПТУ, "Штраф, Претензия");
		Если РеквизитыПТУ.Штраф Тогда
			СтруктураРезультата.РезультатРазнесения = СтрШаблон("%1: к авторазнесению не принимаются документы с признаком «Штраф». Авторазнесение отменено.", ПТУ);		
			Возврат СтруктураРезультата;
		ИначеЕсли РеквизитыПТУ.Претензия Тогда
			СтруктураРезультата.РезультатРазнесения = СтрШаблон("%1: к авторазнесению не принимаются документы с признаком «Претензия». Авторазнесение отменено.", ПТУ);		
			Возврат СтруктураРезультата;
		КонецЕсли;
		//Евросиб Каблов 17.01.2024 )
	КонецЕсли;
	Если СтатусРазнесения = Перечисления.СостоянияАвторазнесения.НетАктуальногоАкцепта
				ИЛИ СтатусРазнесения = Перечисления.СостоянияАвторазнесения.ПолностьюРазнесено Тогда
		СтруктураРезультата.РезультатРазнесения = СтрШаблон("%1: к авторазнесению не принимаются документы в состоянии «Полностью разнесено» или «Нет актуального акцепта». Текущее состояние документа: «%2». Авторазнесение отменено.", ПТУ, СтатусРазнесения);		
		Возврат СтруктураРезультата;
	КонецЕсли;
	ДатаНачалаРазнесенияПТУ = ТекущаяДата();
	//ЗаписьДанныхОчередиАвторазнесения(ПТУ, Истина, СтатусРазнесения, ТекущаяДата());
	
	НАкцепт = Документы.Акцепт.НайтиСоздатьАктуальныйАкцепт(ПТУ, Ложь);
	ТаблицаЛогирования = НАкцепт.Услуги.Выгрузить();
	ТаблицаЛогирования.Очистить();
	ТаблицаЛогирования.Колонки.Добавить("Отключена", Новый ОписаниеТипов("Булево"));
	ТаблицаЛогирования.Колонки.Добавить("Акцепт", Новый ОписаниеТипов("Строка"));
	ЗафиксироватьОтсутствиеПеревозки(НАкцепт);
	ВыполнитьАвторазнесениеАкцепта(НАкцепт, РежимБитыеСсылки);
	ОбработатьСтрокиПодчиненныхУслуг(НАкцепт, СтрокиДляОтключения, ОписаниеЗамера);
	
	//Евросиб Каблов 02.08.2023 ( #64831
	ИзмененныеСделки = Новый Массив;
	ВыполнитьАвторазнесениеАкцептаНаПрямые(НАкцепт, ИзмененныеСделки);
	
	НачатьТранзакцию();
	
	Для Каждого СделкаОбъект Из ИзмененныеСделки Цикл
		СделкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
	//Евросиб Каблов 02.08.2023 )
	
	СтруктураРезультата = ЗаписатьАвторазнесениеАкцепта(ПТУ, НАкцепт, НЗ, ДатаНачалаРазнесенияПТУ, ОписаниеЗамера, ТаблицаЛогирования);
	Для каждого СтрокаЛог Из ТаблицаЛогирования Цикл
		СтрокаЛог.Акцепт = Строка(НАкцепт);
	КонецЦикла;
	
	Возврат СтруктураРезультата;
	
КонецФункции

