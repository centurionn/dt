Процедура ЗаполнитьПричиныИКомментарииНеурега(СтрокаАкцепта, СтрокаТаблицыАвтоакцепта, ПричинаНеурега = Неопределено)
	МассивОбязательныхПолей = ПолучитьМассивОбязательныхПолей(СтрокаТаблицыАвтоакцепта);
	ТекстНеурегКомментарий = ""; 
	Если ЗначениеЗаполнено(ПричинаНеурега) Тогда
		СтрокаАкцепта.Неурег = ПричинаНеурега;
	ИначеЕсли ЗначениеЗаполнено(СтрокаТаблицыАвтоакцепта.ПоискПричинаНеурега) Тогда
		СтрокаАкцепта.Неурег = СтрокаТаблицыАвтоакцепта.ПоискПричинаНеурега;
	Иначе	
		СтрокаАкцепта.Неурег = Справочники.ПричиныНеурегулированныхРасходов.НеНайденыСтрокиРасходовВСделках;
		ТекстНеурегКомментарий = СтрШаблон("Поля для поиска: %1. Авторазнесение невозможно", СтрСоединить(МассивОбязательныхПолей, "/"));
	КонецЕсли;               
	Если СтрокаАкцепта.Неурег = Справочники.ПричиныНеурегулированныхРасходов.НеНайденыСтрокиРасходовВСделкахПоПериоду Тогда
		//ШаблонНеурегКомментарий = "Период поиска с %1 по %2";	
		//ТекстНеурегКомментарий = СтрШаблон(ШаблонНеурегКомментарий, СтрокаТаблицыАвтоакцепта.НачалоОказанияУслугиДляОтбора, СтрокаТаблицыАвтоакцепта.ОкончаниеОказанияУслугиДляОтбора);
		ШаблонКомментарияНеурега = "Период поиска: %1";
		ТекстПериодаПоискаС = ""; 
		ТекстПериодаПоискаПо = "";
		Если ЗначениеЗаполнено(СтрокаТаблицыАвтоакцепта.НачалоОказанияУслугиДляОтбора) Тогда
			ТекстПериодаПоискаС = СтрШаблон("с %1", Формат(СтрокаТаблицыАвтоакцепта.НачалоОказанияУслугиДляОтбора, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТаблицыАвтоакцепта.ОкончаниеОказанияУслугиДляОтбора) Тогда
			ТекстПериодаПоискаПо = СтрШаблон(" по %1", Формат(СтрокаТаблицыАвтоакцепта.ОкончаниеОказанияУслугиДляОтбора, "ДФ=dd.MM.yyyy"));
		КонецЕсли;                                                              
		ТекстПериодаПоиска = СокрЛП(СтрШаблон("%1%2", ТекстПериодаПоискаС, ТекстПериодаПоискаПо));
		ТекстНеурегКомментарий = СтрШаблон(ШаблонКомментарияНеурега, ТекстПериодаПоиска); 
	ИначеЕсли СтрокаАкцепта.Неурег = Справочники.ПричиныНеурегулированныхРасходов.ФактПревышаетПланВНесколькоРаз Тогда            
		Данные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТаблицыАвтоакцепта.Сделка, "Номер, Дата");
		СделкаПредставление = СтрШаблон("%1/%2", ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Данные.Номер), Формат(Данные.Дата,"ДФ=yyyy"));
		ТекстНеурегКомментарий = СтрШаблон("Поля для поиска: %1. Найденные сделки: %2", СтрСоединить(МассивОбязательныхПолей, "/"), СделкаПредставление);
	КонецЕсли;
	СтрокаАкцепта.НеурегКомментарий = ТекстНеурегКомментарий;
КонецПроцедуры

Функция ПолучитьМассивОбязательныхПолей(СтрокаТаблицыАвтоакцепта, ДляОписанияПричинНеурега = Ложь, ПроверятьЗаполненныеЗначения = Ложь)
	МассивОбязательныхПолей = Новый Массив;
	Если СтрокаТаблицыАвтоакцепта.ЗаполненКонтейнерДляОтбора 
		И (НЕ ПроверятьЗаполненныеЗначения 
			ИЛИ НЕ ЗначениеЗаполнено(СтрокаТаблицыАвтоакцепта.Контейнер)) Тогда
		МассивОбязательныхПолей.Добавить("Контейнер");
	КонецЕсли;
	Если СтрокаТаблицыАвтоакцепта.ЗаполненВагонДляОтбора 
		И (НЕ ПроверятьЗаполненныеЗначения 
			ИЛИ НЕ ЗначениеЗаполнено(СтрокаТаблицыАвтоакцепта.Вагон)) Тогда
		МассивОбязательныхПолей.Добавить("Вагон");
	КонецЕсли;
	Если СтрокаТаблицыАвтоакцепта.ЗаполненТранспортныйДокументДляОтбора 
		И (НЕ ПроверятьЗаполненныеЗначения ИЛИ НЕ ЗначениеЗаполнено(СтрокаТаблицыАвтоакцепта.ТранспортныйДокумент)) Тогда 
		МассивОбязательныхПолей.Добавить("Накладная");
	КонецЕсли;
	Если СтрокаТаблицыАвтоакцепта.ЗаполненКлиентДляОтбора 
		И (НЕ ПроверятьЗаполненныеЗначения ИЛИ НЕ ЗначениеЗаполнено(СтрокаТаблицыАвтоакцепта.КлиентРасхода)) Тогда 
		МассивОбязательныхПолей.Добавить("Под клиента");
	КонецЕсли;   
	//убрал, такого не может быть
	//Если СтрокаТаблицыАвтоакцепта.ЗаполненПоставщикДляОтбора Тогда
	//	МассивОбязательныхПолей.Добавить("Поставщик");
	//КонецЕсли;
	//Если СтрокаТаблицыАвтоакцепта.ЗаполненСтанцияОтправленияДляОтбора 
	//	И (НЕ ПроверятьЗаполненныеЗначения ИЛИ НЕ ЗначениеЗаполнено(СтрокаТаблицыАвтоакцепта.СтанцияОтправления)) Тогда 
	//	МассивОбязательныхПолей.Добавить("Станция отправления");
	//КонецЕсли;
	Если СтрокаТаблицыАвтоакцепта.ЗаполненПериодОказанияУслугиДляОтбора 
		И (НЕ ПроверятьЗаполненныеЗначения 
			ИЛИ (НЕ ЗначениеЗаполнено(СтрокаТаблицыАвтоакцепта.НачалоОказанияУслуги)
					И НЕ ЗначениеЗаполнено(СтрокаТаблицыАвтоакцепта.ОкончаниеОказанияУслуги))) Тогда
		МассивОбязательныхПолей.Добавить("Начало оказания услуги ИЛИ Окончание оказания услуги");
	КонецЕсли;
	//Если СтрокаТаблицыАвтоакцепта.ЗаполненСтанцияНазначенияДляОтбора 
	//	И (НЕ ПроверятьЗаполненныеЗначения ИЛИ НЕ ЗначениеЗаполнено(СтрокаТаблицыАвтоакцепта.СтанцияНазначения)) Тогда 
	//	МассивОбязательныхПолей.Добавить("Станция назначения");
	//КонецЕсли;
	Если СтрокаТаблицыАвтоакцепта.ЗаполненЛокацияОтправленияДляОтбора 
		И (НЕ ПроверятьЗаполненныеЗначения ИЛИ НЕ ЗначениеЗаполнено(СтрокаТаблицыАвтоакцепта.СтанцияОтправления)) Тогда 
		МассивОбязательныхПолей.Добавить("Станция отправления");
