	КонецПопытки;
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ПреобразованнаяСтрокаXML(ОтветXML));	
	
	Возврат ФабрикаXDTO.ПрочитатьXML(Чтение);	

КонецФункции

Функция ПреобразованнаяСтрокаXML(XMLСтрока)	
	
	НомерВхождения = 1;
	ВхожденияAddField = Новый Массив;
	Пока Истина Цикл 
		НачалоИскомогоФрагмента = СтрНайти(XMLСтрока, "<AddField",,, НомерВхождения);
		Если НачалоИскомогоФрагмента = 0 Тогда
			Прервать;
		КонецЕсли;	
		НомерВхождения = НомерВхождения + 1;
		ВхожденияAddField.Добавить(НачалоИскомогоФрагмента + 1);	 
	КонецЦикла;
	НомерВхождения = НомерВхождения - 1;
	Если НомерВхождения = 0 Тогда
		Возврат XMLСтрока;
	КонецЕсли;
	
	КоличествоВхождений = НомерВхождения;
	
	ПервыеКавычкиПослеAdField = Новый Массив;
	Для Каждого НачалоВхождения Из ВхожденияAddField Цикл
		ПервыеКавычкиПослеAdField.Добавить(СтрНайти(XMLСтрока, ">",, НачалоВхождения)); 	 
	КонецЦикла;
	ПервыеКавычкиПослеAdField.Добавить(СтрДлина(XMLСтрока) + 1);
	
	ВторыеКавычкиПослеAdField = Новый Массив;
	Для Каждого НачалоВхождения Из ВхожденияAddField Цикл
		ВторыеКавычкиПослеAdField.Добавить(СтрНайти(XMLСтрока, "<",, НачалоВхождения)); 	 
	КонецЦикла;
	
	УменьшитьКоличествоВхождений = 0;
	Для НомерВхождения = 1 По КоличествоВхождений Цикл
		ОбратныйИндекс = КоличествоВхождений - НомерВхождения;
		Если ПервыеКавычкиПослеAdField[ОбратныйИндекс] + 1 = ВторыеКавычкиПослеAdField[ОбратныйИндекс] Тогда
			ПервыеКавычкиПослеAdField.Удалить(ОбратныйИндекс);
			ВторыеКавычкиПослеAdField.Удалить(ОбратныйИндекс);
			УменьшитьКоличествоВхождений = УменьшитьКоличествоВхождений + 1;
		КонецЕсли;
	КонецЦикла;
	КоличествоВхождений = КоличествоВхождений - УменьшитьКоличествоВхождений;
	
	НоваяXMLСтрока = Сред(XMLСтрока, 1, ПервыеКавычкиПослеAdField[0] - 1);
	Для НомерВхождения = 1 По КоличествоВхождений Цикл
		НоваяXMLСтрока = НоваяXMLСтрока + " content=" + "'" + Сред(XMLСтрока, ПервыеКавычкиПослеAdField[НомерВхождения-1] + 1,
					ВторыеКавычкиПослеAdField[НомерВхождения-1] - ПервыеКавычкиПослеAdField[НомерВхождения-1] - 1) + "'"
					+ Сред(XMLСтрока, ПервыеКавычкиПослеAdField[НомерВхождения-1], ПервыеКавычкиПослеAdField[НомерВхождения] - ПервыеКавычкиПослеAdField[НомерВхождения-1]);   
	 КонецЦикла;	
	 
	 Возврат НоваяXMLСтрока;
	 
КонецФункции


