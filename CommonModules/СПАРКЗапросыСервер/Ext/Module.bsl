	ТекущийПользовательОС = ПользователиИнформационнойБазы.ТекущийПользователь().ПользовательОС;
	ТекущийПользовательОСБезДомена = Прав(ТекущийПользовательОС, СтрДлина(ТекущийПользовательОС) - СтрНайти(ТекущийПользовательОС, "\", НаправлениеПоиска.СКонца));                 	
	
	Если НЕ ЗначениеЗаполнено(ТекущийПользовательОСБезДомена) Тогда
