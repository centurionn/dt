Функция ПрямойЗапрос_GetCompanyRiskFactors(ИмяРеквизита, ЗначениеРеквизита, ТекстыОшибок = Неопределено, ТекстXML = "") Экспорт
	
	// ИмяРеквизита - возможные значения: "inn", "ogrn", "sparkID"
	
	ОбъектXDTO = ПрямойЗапросВСпарк("GetCompanyRiskFactors", ИмяРеквизита, ЗначениеРеквизита, ТекстыОшибок, ТекстXML);
	Если ОбъектXDTO = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		info = ОбъектXDTO.Data.Report;
	Исключение
		ТекстыОшибок = "Данные в СПАРК не найдены";
		Возврат Неопределено;
	КонецПопытки;
	
	Результат = Новый Структура;
	Результат.Вставить("SparkID"     , info.SparkID);
	Результат.Вставить("Наименование", info.ShortName);
	Результат.Вставить("ИНН"         , info.INN);
	Результат.Вставить("ОГРН"        , info.OGRN);
	Результат.Вставить("КодПоОКПО"   , info.OKPO);
	Результат.Вставить("ОКАТО"       , info.OKATO);
	
	Возврат Результат;
	
КонецФункции

