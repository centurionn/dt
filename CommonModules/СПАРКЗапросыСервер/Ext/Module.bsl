//Евросиб Гудкова( 07.10.2019
		Отказ = Истина;
// Евросиб Гудкова) 		
	КонецЕсли;
	
//Евросиб Гудкова( 07.10.2019
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли; 
// Евросиб Гудкова)

	Определение = Новый WSОпределения(Константы["АдресСервераСПАРК"+?(ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована, "Тестовый", "")].Получить());    
	
	// http://tsxapp4:2017/SparkAdapter.svc?wsdl - рабочий
	// http://tsxapp4:20172/SparkAdapter.svc?wsdl - тестовый
	
	Прокси = Новый WSПрокси(Определение, "http://tempuri.org/", "SparkAdapter", "BasicHttpBinding_ISparkAdapter");	
	
	ЗаписьXML = Новый ЗаписьXML;
