Функция ОбновитьКонтрагентаСПАРК(Контрагент) Экспорт

	Отказ = Ложь;
	СтруктураРеквизитов = Новый Структура("Контрагент, ИНН, ОГРН, КодПоОКПО, ПоследнееОбновлениеСПАРК");
	СтруктураРеквизитов.Контрагент = Контрагент; 
	СПАРК_ОбновитьПоказателиНаСервере(СтруктураРеквизитов, Отказ);	
	
	// здесь должна быть обработка обновления спарка контрагента и пересчета его рейтинга в карточке
	
	Возврат Не Отказ;
	
КонецФункции

Процедура СПАРК_СкачатьДосьеНаСервере(СтруктураРеквизитов, Отказ) Экспорт
	
	КорневойОбъектXDTO = ОтветныйОбъектXDTO(СтруктураРеквизитов, "GetCompanySparkRisksReport", Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если КорневойОбъектXDTO.ResultInfo.ResultType = "Data not found" Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Компания не найдена в СПАРК");
		Отказ = Истина;
		Возврат;
	ИначеЕсли КорневойОбъектXDTO.ResultInfo.ResultType = "Error" Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Произошла ошибка #"+КорневойОбъектXDTO.ResultInfo.ErrorInfo.Code+": " + КорневойОбъектXDTO.ResultInfo.ErrorInfo.Message);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если КорневойОбъектXDTO.Data.Report.Свойства().Получить("INN") <> Неопределено Тогда
		СтруктураРеквизитов.ИНН = КорневойОбъектXDTO.Data.Report.INN;	
	КонецЕсли;
	
	Если КорневойОбъектXDTO.Data.Report.Свойства().Получить("OGRN") <> Неопределено Тогда
		СтруктураРеквизитов.ОГРН = КорневойОбъектXDTO.Data.Report.OGRN;	
	КонецЕсли;
	
	Если КорневойОбъектXDTO.Data.Report.Свойства().Получить("OKPO") <> Неопределено Тогда
		СтруктураРеквизитов.КодПоОКПО = КорневойОбъектXDTO.Data.Report.OKPO;	
	КонецЕсли;
		
	ДвоичныйФайл = Base64Значение(КорневойОбъектXDTO.Data.Report.SparkRisksReport); 
	
	ФайлВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныйФайл); 
	
	ПараметрыФайла = Новый Структура;
	ПараметрыФайла.Вставить("Автор", Пользователи.ТекущийПользователь());
	ПараметрыФайла.Вставить("ВладелецФайлов", СтруктураРеквизитов.Контрагент);
	ПараметрыФайла.Вставить("ИмяБезРасширения", "Досье СПАРК от " + КорневойОбъектXDTO.Data.Report.Status.Date); 	// SIV просьба не менять предопределенное имя, оно используется для
																													// последующего поиска факта прикрепления СПАРК к карточке
	ПараметрыФайла.Вставить("РасширениеБезТочки", "pdf");
	ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное", ТекущаяДата());
	
	РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, ФайлВоВременномХранилище);
		
КонецПроцедуры

Процедура СПАРК_ОбновитьПоказателиНаСервере(СтруктураРеквизитов, Отказ) Экспорт
	
	ТекущаяДата = ТекущаяДата();
	
	//ДИТ Пак И.Т. Task 34686 (Ticket#0206125) 28.05.2021 Начало
	Если СтруктураРеквизитов.Свойство("КэшXml") И ЗначениеЗаполнено(СтруктураРеквизитов.КэшXml) Тогда
		
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(СтруктураРеквизитов.КэшXml);
		КорневойОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(Чтение);	
		
	Иначе
	//ДИТ Пак И.Т. Task 34686 (Ticket#0206125) 28.05.2021 Конец
	
	
		КорневойОбъектXDTO = ОтветныйОбъектXDTO(СтруктураРеквизитов, "GetCompanyRiskFactors", Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
	
	//ДИТ Пак И.Т. Task 34686 (Ticket#0206125) 28.05.2021 Начало
	КонецЕсли;
	//ДИТ Пак И.Т. Task 34686 (Ticket#0206125) 28.05.2021 Конец
	
		
	МенеджерЗаписи = РегистрыСведений.СПАРКИндексыРисков.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ДатаЗагрузки = ТекущаяДата;
	МенеджерЗаписи.Период = ТекущаяДата;
	МенеджерЗаписи.Контрагент = СтруктураРеквизитов.Контрагент; 
	
	Если КорневойОбъектXDTO.ResultInfo.ResultType <> "True" Тогда 
		Если КорневойОбъектXDTO.ResultInfo.ResultType = "Error" Тогда
			МенеджерЗаписи.ВидОшибки = Перечисления.СПАРКВидыОшибок.ОшибкаПолученияДанных;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Произошла ошибка при вызове метода GetCompanyRiskFactors");
		ИначеЕсли КорневойОбъектXDTO.ResultInfo.ResultType = "Data not found" Тогда
			МенеджерЗаписи.ВидОшибки = Перечисления.СПАРКВидыОшибок.ДанныеНеНайдены;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Компания не найдена в СПАРК");
		КонецЕсли;		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СПАРКИндексыРисков.Контрагент КАК Контрагент
		|ИЗ
		|	РегистрСведений.СПАРКИндексыРисков КАК СПАРКИндексыРисков
		|ГДЕ
		|	СПАРКИндексыРисков.Период = &НачалоМесяца
		|	И СПАРКИндексыРисков.Контрагент = &Контрагент
		|	И СПАРКИндексыРисков.ВидОшибки = ЗНАЧЕНИЕ(Перечисление.СПАРКВидыОшибок.ПустаяСсылка)";	
		Запрос.УстановитьПараметр("Контрагент",   СтруктураРеквизитов.Контрагент);
		Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца(ТекущаяДата));
		Если Запрос.Выполнить().Пустой() Тогда
			МенеджерЗаписи.Записать();
			СтруктураРеквизитов.ПоследнееОбновлениеСПАРК = ТекущаяДата;
		КонецЕсли;
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	Если КорневойОбъектXDTO.Data.Report.Свойства().Получить("INN") <> Неопределено Тогда
		СтруктураРеквизитов.ИНН = КорневойОбъектXDTO.Data.Report.INN;	
	КонецЕсли;
	
	Если КорневойОбъектXDTO.Data.Report.Свойства().Получить("OGRN") <> Неопределено Тогда
		СтруктураРеквизитов.ОГРН = КорневойОбъектXDTO.Data.Report.OGRN;	
	КонецЕсли;
	
	Если КорневойОбъектXDTO.Data.Report.Свойства().Получить("OKPO") <> Неопределено Тогда
		СтруктураРеквизитов.КодПоОКПО = КорневойОбъектXDTO.Data.Report.OKPO;	
	КонецЕсли;
	
	//ДИТ Пак И.Т. Task 34686 (Ticket#0206125) 28.05.2021 Начало
	Если КорневойОбъектXDTO.Data.Report.Свойства().Получить("ShortName") <> Неопределено Тогда
		СтруктураРеквизитов.Вставить("Наименование", КорневойОбъектXDTO.Data.Report.ShortName);
	КонецЕсли;
	Если КорневойОбъектXDTO.Data.Report.Свойства().Получить("OKATO") <> Неопределено Тогда
		СтруктураРеквизитов.Вставить("ОКАТО", КорневойОбъектXDTO.Data.Report.OKATO);
	КонецЕсли;
	//ДИТ Пак И.Т. Task 34686 (Ticket#0206125) 28.05.2021 Конец
	
	МенеджерЗаписи.ИдентификаторСПАРК = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(КорневойОбъектXDTO.Data.Report.SparkID);
	
	Если КорневойОбъектXDTO.Data.Report.Свойства().Получить("ConsolidatedIndicator") <> Неопределено Тогда
		Если КорневойОбъектXDTO.Data.Report.ConsolidatedIndicator.Value = "Low" Тогда
			МенеджерЗаписи.СводныйИндикаторРиска = Перечисления.СПАРКЗначенияРисков.Низкий;
		ИначеЕсли КорневойОбъектXDTO.Data.Report.ConsolidatedIndicator.Value = "Medium" Тогда
			МенеджерЗаписи.СводныйИндикаторРиска = Перечисления.СПАРКЗначенияРисков.Средний;
		ИначеЕсли КорневойОбъектXDTO.Data.Report.ConsolidatedIndicator.Value = "High" Тогда	
			МенеджерЗаписи.СводныйИндикаторРиска = Перечисления.СПАРКЗначенияРисков.Высокий;	
		КонецЕсли;	
	КонецЕсли;
	
	Если КорневойОбъектXDTO.Data.Report.Свойства().Получить("IndexOfDueDiligence") <> Неопределено Тогда	
		МенеджерЗаписи.ИндексДолжнойОсмотрительности = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(КорневойОбъектXDTO.Data.Report.IndexOfDueDiligence.Index);
	КонецЕсли;
	Если КорневойОбъектXDTO.Data.Report.Свойства().Получить("FailureScore") <> Неопределено Тогда
		МенеджерЗаписи.ИндексФинансовогоРиска = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(КорневойОбъектXDTO.Data.Report.FailureScore.FailureScoreValue);
	КонецЕсли;
	Если КорневойОбъектXDTO.Data.Report.Свойства().Получить("PaymentIndex") <> Неопределено Тогда
		МенеджерЗаписи.ИндексПлатежнойДисциплины = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(КорневойОбъектXDTO.Data.Report.PaymentIndex.PaymentIndexValue); 		
	КонецЕсли;
	Если КорневойОбъектXDTO.Data.Report.Свойства().Получить("Status") <> Неопределено Тогда
		МенеджерЗаписи.Активен = Булево(СтроковыеФункцииКлиентСервер.СтрокаВЧисло(КорневойОбъектXDTO.Data.Report.Status.IsActing)); 
		МенеджерЗаписи.Статус = КорневойОбъектXDTO.Data.Report.Status.Code;	
		МенеджерЗаписи.ДатаСтатуса = ДатаИзСтроки(КорневойОбъектXDTO.Data.Report.Status.Date); 
		МенеджерЗаписи.СтатусТекст = КорневойОбъектXDTO.Data.Report.Status.Text;	
	КонецЕсли;	
	Если КорневойОбъектXDTO.Data.Report.Свойства().Получить("RiskFactors") <> Неопределено И КорневойОбъектXDTO.Data.Report.RiskFactors.Свойства().Получить("Factor") <> Неопределено Тогда
		Если ТипЗнч(КорневойОбъектXDTO.Data.Report.RiskFactors.Factor) = Тип("ОбъектXDTO") Тогда
			ЗаполнитьФакторПоID(КорневойОбъектXDTO.Data.Report.RiskFactors.Factor, МенеджерЗаписи);
		ИначеЕсли ТипЗнч(КорневойОбъектXDTO.Data.Report.RiskFactors.Factor) = Тип("СписокXDTO") Тогда
			Для Каждого Элемент Из КорневойОбъектXDTO.Data.Report.RiskFactors.Factor Цикл
				ЗаполнитьФакторПоID(Элемент, МенеджерЗаписи);	
			КонецЦикла;
		КонецЕсли;		                  
	КонецЕсли;                
	
	МенеджерЗаписи.Записать();
	СтруктураРеквизитов.ПоследнееОбновлениеСПАРК = ТекущаяДата;
КонецПроцедуры

Функция ДатаПоследнегоОбновленияСпарка(Контрагент) Экспорт
	
	Возврат РегистрыСведений.СПАРКИндексыРисков.ПолучитьПоследнее(, Новый Структура("Контрагент", Контрагент)).ДатаЗагрузки;	
	
КонецФункции

Функция ЗапросБылВыполненМенее3ДнейНазад(Контрагент) Экспорт	
	
	Возврат ТекущаяДата() - 3*24*3600 < РегистрыСведений.СПАРКИндексыРисков.ПолучитьПоследнее(, Новый Структура("Контрагент", Контрагент)).ДатаЗагрузки;	
	
КонецФункции

Функция ДатаИзСтроки(ДатаСтрокой)
	
	МассивДаты = СтрРазделить(ДатаСтрокой, "-", Ложь);  	
	Возврат СтроковыеФункцииКлиентСервер.СтрокаВДату(МассивДаты[2] + "." + МассивДаты[1] + "." + МассивДаты[0]);
	
КонецФункции

Процедура ЗаполнитьФакторПоID(ОбъектXDTO, МенеджерЗаписи)
	
	Если ОбъектXDTO.Свойства().Получить("AddInfo") <> Неопределено
		И ОбъектXDTO.Свойства().Получить("id") <> Неопределено
		И ОбъектXDTO.AddInfo.Свойства().Получить("AddField") <> Неопределено
		И (ТипЗнч(ОбъектXDTO.AddInfo.AddField) = Тип("ОбъектXDTO") И ОбъектXDTO.AddInfo.AddField.Свойства().Получить("content") <> Неопределено
		Или ТипЗнч(ОбъектXDTO.AddInfo.AddField) = Тип("СписокXDTO")) Тогда 
		
		Если ОбъектXDTO.Id = "1" Тогда
			Если ТипЗнч(ОбъектXDTO.AddInfo.AddField) = Тип("СписокXDTO") Тогда	
				Для Каждого Элемент Из ОбъектXDTO.AddInfo.AddField Цикл
					Если Элемент.Свойства().Получить("Name") <> Неопределено И Элемент.Свойства().Получить("content") <> Неопределено Тогда
						Если Элемент.Name = "FTSNumber" Тогда
							МенеджерЗаписи.КоличествоКомпанийПоАдресуФНС = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Элемент.content);
							Прервать;
						КонецЕсли;
					КонецЕсли;					 
				КонецЦикла;
			ИначеЕсли ТипЗнч(ОбъектXDTO.AddInfo.AddField) = Тип("ОбъектXDTO") Тогда
				Если ОбъектXDTO.AddInfo.AddField.Свойства().Получить("Name") <> Неопределено И ОбъектXDTO.AddInfo.AddField.Свойства().Получить("content") <> Неопределено Тогда
					Если ОбъектXDTO.AddInfo.AddField.Name = "FTSNumber" Тогда
						МенеджерЗаписи.КоличествоКомпанийПоАдресуФНС = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ОбъектXDTO.AddInfo.AddField.content);
					КонецЕсли;
				КонецЕсли;			
			КонецЕсли;
		ИначеЕсли ОбъектXDTO.Id = "6" Тогда
			МенеджерЗаписи.ДатаПервичнойРегистрации = ДатаИзСтроки(ОбъектXDTO.AddInfo.AddField.content);
		ИначеЕсли ОбъектXDTO.Id = "7" Тогда
			МенеджерЗаписи.ДатаНачалаПроцедурыЛиквидации = ДатаИзСтроки(ОбъектXDTO.AddInfo.AddField.content);
		ИначеЕсли ОбъектXDTO.Id = "20" Тогда
			МенеджерЗаписи.КоличествоИсполнительныхПроизводств = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ОбъектXDTO.AddInfo.AddField.content);
		ИначеЕсли ОбъектXDTO.Id = "22" Тогда
			МенеджерЗаписи.ДатаНачалаПроцедурыБанкротства = ДатаИзСтроки(ОбъектXDTO.AddInfo.AddField.content);
		ИначеЕсли ОбъектXDTO.Id = "48" Тогда
			МенеджерЗаписи.ДатаСообщенияОНамеренииБанкротства = ДатаИзСтроки(ОбъектXDTO.AddInfo.AddField.content);
		ИначеЕсли ОбъектXDTO.Id = "21" Тогда
			Если ТипЗнч(ОбъектXDTO.AddInfo.AddField) = Тип("СписокXDTO") Тогда
				МенеджерЗаписиБанкротов = РегистрыСведений.СПАРККонтрагентыСДочернимиБанкротами.СоздатьМенеджерЗаписи();
				МенеджерЗаписиБанкротов.ГоловнойКонтрагент = МенеджерЗаписи.Контрагент;
				МенеджерЗаписиБанкротов.Период = МенеджерЗаписи.Период;
				ПолейЗаполнено = 0;
				Для Каждого Элемент Из ОбъектXDTO.AddInfo.AddField Цикл
					Если Элемент.Свойства().Получить("Name") <> Неопределено И Элемент.Свойства().Получить("content") <> Неопределено Тогда
						Если Элемент.Name = "Name" Тогда
							МенеджерЗаписиБанкротов.Наименование = Элемент.content;
							ПолейЗаполнено = ПолейЗаполнено + 1; 
						ИначеЕсли Элемент.Name = "SparkID" Тогда
							МенеджерЗаписиБанкротов.ИдентификаторСПАРКДочернегоКонтрагента = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Элемент.content);
							ПолейЗаполнено = ПолейЗаполнено + 1;
						КонецЕсли;
					КонецЕсли;					 
				КонецЦикла;
				Если ПолейЗаполнено = 2 Тогда
					МенеджерЗаписиБанкротов.Записать();
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ОбъектXDTO.Id = "41" Тогда
			Если ТипЗнч(ОбъектXDTO.AddInfo.AddField) = Тип("СписокXDTO") Тогда
				МенеджерЗаписиЕГРЮЛ = РегистрыСведений.СПАРКНедостоверныеСведенияКонтрагентовЕГРЮЛ.СоздатьМенеджерЗаписи();
				МенеджерЗаписиЕГРЮЛ.Контрагент = МенеджерЗаписи.Контрагент;
				МенеджерЗаписиЕГРЮЛ.Период = МенеджерЗаписи.Период;
				Для Каждого Элемент Из ОбъектXDTO.AddInfo.AddField Цикл
					Если Элемент.Свойства().Получить("Name") <> Неопределено И Элемент.Свойства().Получить("content") <> Неопределено Тогда
						Если Элемент.Name = "TypeId" Тогда
							Если Элемент.content = "1" Тогда
								МенеджерЗаписиЕГРЮЛ.ТипНедостоверногоСведения = Перечисления.СПАРКТипыНедостоверныхСведений.УправляющаяКомпания; 
							ИначеЕсли Элемент.content = "2" Тогда
								МенеджерЗаписиЕГРЮЛ.ТипНедостоверногоСведения = Перечисления.СПАРКТипыНедостоверныхСведений.ДолжностноеФЛ;
							ИначеЕсли Элемент.content = "3" Тогда
								МенеджерЗаписиЕГРЮЛ.ТипНедостоверногоСведения = Перечисления.СПАРКТипыНедостоверныхСведений.Учредитель;
							ИначеЕсли Элемент.content = "4" Тогда
								МенеджерЗаписиЕГРЮЛ.ТипНедостоверногоСведения = Перечисления.СПАРКТипыНедостоверныхСведений.Адрес;
							КонецЕсли;
						ИначеЕсли Элемент.Name = "Text" Тогда
							МенеджерЗаписиЕГРЮЛ.Сведения = Элемент.content;
						ИначеЕсли Элемент.Name = "Date" Тогда	
							МенеджерЗаписиЕГРЮЛ.ДатаСведений = ДатаИзСтроки(Элемент.content);
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				Если ЗначениеЗаполнено(МенеджерЗаписиЕГРЮЛ.ТипНедостоверногоСведения) Тогда
					МенеджерЗаписиЕГРЮЛ.Записать();
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция ОтветныйОбъектXDTO(СтруктураРеквизитов, МетодСпарка, Отказ)
	
