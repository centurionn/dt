Процедура СПАРК_ОбновитьПоказателиАвтоматически()Экспорт
		
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ИНН ПОДОБНО ""__________""
		|	И НЕ Контрагенты.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	СписокСобытий = Новый СписокЗначений;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Контрагент = ВыборкаДетальныеЗаписи.ссылка;		
		СтруктураРеквизитов = Новый Структура("Контрагент, ИНН, ОГРН, КодПоОКПО, ПоследнееОбновлениеСПАРК");
		СтруктураРеквизитов.Контрагент = Контрагент;
		СтруктураРеквизитов.ИНН = Контрагент.ИНН;
		СтруктураРеквизитов.ОГРН = Контрагент.ОГРН;
		Отказ = Ложь;
		Попытка
		СПАРКЗапросыСервер.СПАРК_СкачатьДосьеНаСервере(СтруктураРеквизитов, Отказ);	
		СПАРКЗапросыСервер.СПАРК_ОбновитьПоказателиНаСервере(СтруктураРеквизитов, Отказ);
		Если Не Отказ Тогда
			ТекОбъект = Контрагент.ПолучитьОбъект();
			Модифицированность = ложь;
			Если Не ЗначениеЗаполнено(ТекОбъект.ИНН) Тогда
				ТекОбъект.ИНН = СтруктураРеквизитов.ИНН;
				Модифицированность = Истина;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(ТекОбъект.ОГРН) Тогда
				ТекОбъект.ОГРН = СтруктураРеквизитов.ОГРН;
				Модифицированность = Истина;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(ТекОбъект.КодПоОКПО) Тогда
				ТекОбъект.КодПоОКПО = СтруктураРеквизитов.КодПоОКПО;
				Модифицированность = Истина;
			КонецЕсли;
			Если Модифицированность тогда 
				ТекОбъект.Записать();
			КонецЕсли;
		КонецЕсли;
		Исключение 
		СтруктураСобытия = Новый Структура;
		СтруктураСобытия.Вставить("ИмяСобытия", "Автоматическое обновление СПАРК");
		СтруктураСобытия.Вставить("ПредставлениеУровня", УровеньЖурналаРегистрации.Ошибка);
		СтруктураСобытия.Вставить("Комментарий", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()) + " " +Контрагент);
		СписокСобытий.Добавить(СтруктураСобытия);
		
		КонецПопытки;

	КонецЦикла;
    ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СписокСобытий);
       
КонецПроцедуры
