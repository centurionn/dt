	ЗаписьXML.ЗаписатьНачалоЭлемента(МетодСпарка);	
	ЗаписьXML.ЗаписатьАтрибут("version", "1.0");
	ЗаписьXML.ЗаписатьНачалоЭлемента(?(ЗначениеЗаполнено(SparkID), "sparkID", ?(ЗначениеЗаполнено(СтруктураРеквизитов.ИНН), "inn", "ogrn")));
	ЗаписьXML.ЗаписатьАтрибут("value", ?(ЗначениеЗаполнено(SparkID), СтрЗаменить(Строка(SparkID), Символы.НПП, ""), ?(ЗначениеЗаполнено(СтруктураРеквизитов.ИНН), СтруктураРеквизитов.ИНН, СтруктураРеквизитов.ОГРН)));
