Функция ПрямойЗапросВСпарк(ИмяМетода, ИмяРеквизита, ЗначениеРеквизита, ТекстыОшибок = Неопределено, ТекстXML = "") Экспорт
	
	Если ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована Тогда
		АдресСПАРК = Константы.АдресСервераСПАРКТестовый.Получить();
	Иначе
		АдресСПАРК = Константы.АдресСервераСПАРК.Получить();
	КонецЕсли;
	
	Определение = Новый WSОпределения(АдресСПАРК);
	
	Прокси = Новый WSПрокси(Определение, "http://tempuri.org/", "SparkAdapter", "BasicHttpBinding_ISparkAdapter");	
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();    
	ЗаписьXML.ЗаписатьНачалоЭлемента(ИмяМетода);	
	ЗаписьXML.ЗаписатьАтрибут("version", "1.0");
	ЗаписьXML.ЗаписатьНачалоЭлемента(ИмяРеквизита);
	ЗаписьXML.ЗаписатьАтрибут("value", ЗначениеРеквизита);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();		
	SparkRequest = ЗаписьXML.Закрыть();
	
	Enterprise = "00000000-1111-2222-3333-444444444444";
	
	ТекущийПользовательОС = ПользователиИнформационнойБазы.ТекущийПользователь().ПользовательОС;
	ТекущийПользовательОСБезДомена = Прав(ТекущийПользовательОС, СтрДлина(ТекущийПользовательОС) - СтрНайти(ТекущийПользовательОС, "\", НаправлениеПоиска.СКонца));
	
	Попытка
		ОтветXML = Прокси.SendSparkRequest(SparkRequest, Enterprise, ТекущийПользовательОСБезДомена);
	Исключение
		Ошибка = "Не удалось выполнить СПАРК метод: " + ИмяМетода + ": " + ОписаниеОшибки();
		Если ТекстыОшибок = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Ошибка);
		Иначе
			ТекстыОшибок = ?(ЗначениеЗаполнено(ТекстыОшибок), ТекстыОшибок + Символы.ПС, "") + Ошибка;
		КонецЕсли;
		Возврат Неопределено;
	КонецПопытки;
	
	ТекстXML = ПреобразованнаяСтрокаXML(ОтветXML);
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ТекстXML);
	
	Возврат ФабрикаXDTO.ПрочитатьXML(Чтение);	
	
КонецФункции

