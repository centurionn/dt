Функция УниверсальныйПарсерXML(XMLстрока, ИмяЭлементаДляНовойСтрокиТЗ, ЭтоФайл = Ложь) Экспорт
	
	ТЗ	= Новый ТаблицаЗначений;
	НовСтрокаТЗ = Неопределено;
	Чтение = Новый ЧтениеXML;
	//Евросиб Гудкова( 11.05.2016 Ticket№ 0079933
	//было 		Чтение.УстановитьСтроку(XMLстрока);
	Если ЭтоФайл Тогда
		Чтение.ОткрытьФайл(XMLстрока);
	Иначе
		Чтение.УстановитьСтроку(XMLстрока);
	КонецЕсли; 
	// Евросиб Гудкова) 
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ТекИмяЭлемента = Чтение.Имя;
			Если ТекИмяЭлемента = ИмяЭлементаДляНовойСтрокиТЗ Тогда
				НовСтрокаТЗ = ТЗ.Добавить();
			КонецЕсли;
			Если ТЗ.Колонки.Найти(ТекИмяЭлемента)=Неопределено Тогда
//Евросиб (Гонтаренко 27.02.2021 #26783
				//ТЗ.Колонки.Добавить(ТекИмяЭлемента, Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(300)));
				ТЗ.Колонки.Добавить(ТекИмяЭлемента, Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
//Евросиб )Гонтаренко 27.02.2021 #2678
			КонецЕсли;
			Если Чтение.Значение <> "" и НовСтрокаТЗ <> Неопределено Тогда
				НовСтрокаТЗ[ТекИмяЭлемента] = СокрЛП(Чтение.Значение);
			КонецЕсли;
			Если Чтение.КоличествоАтрибутов()> 0 и НовСтрокаТЗ <> Неопределено Тогда
				Пока Чтение.ПрочитатьАтрибут()Цикл
					Попытка
						ТекИмяАтрибут = СтрЗаменить(Чтение.Имя,":","_"); 
						Если ТЗ.Колонки.Найти(ТекИмяАтрибут)=Неопределено Тогда
							ТЗ.Колонки.Добавить(ТекИмяАтрибут, Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(300)));
						КонецЕсли;
						НовСтрокаТЗ[ТекИмяАтрибут] = СокрЛП(Чтение.Значение);
					Исключение
						
					КонецПопытки;
				КонецЦикла;
			КонецЕсли;
		ИначеЕсли Чтение.Значение <> "" и НовСтрокаТЗ <> Неопределено и ТекИмяЭлемента<>"" Тогда 
			Если ТЗ.Колонки.Найти(ТекИмяЭлемента)=Неопределено Тогда
				ТЗ.Колонки.Добавить(ТекИмяЭлемента, Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(300)));
			КонецЕсли;
			НовСтрокаТЗ[ТекИмяЭлемента] = СокрЛП(Чтение.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТЗ;
Конецфункции	

