Функция ПолучитьМассивСтруктурЛокацийПоСтрокеПоиска(СтрокаПоиска) Экспорт
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	
	Если СтрокаПоиска = "" Тогда
		
		Запрос.Текст = "ВЫБРАТЬ
		               |	Локации.Код КАК code,
		               |	Локации.Наименование КАК name,
		               |	Локации.КодЖДСтанции КАК zdcode
		               |ИЗ
		               |	Справочник.Локации КАК Локации
		               |ГДЕ
		               |	НЕ Локации.ПометкаУдаления
		               |	И Локации.ДоступноДляВыбораНаСайте";
		
	Иначе
	
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	Локации.Код КАК code,
		               |	Локации.Наименование КАК name,
		               |	Локации.КодЖДСтанции КАК zdcode
		               |ИЗ
//Евросиб Гудкова( 05.10.2020 
					   |	Справочник.Локации.ТаблицаСинонимов КАК ЛокацииТаблицаСинонимов
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Локации КАК Локации
		               |		ПО ЛокацииТаблицаСинонимов.Ссылка = Локации.Ссылка
// Евросиб Гудкова) 					   
		               |ГДЕ
		               |	(Локации.Наименование ПОДОБНО &СтрокаПоиска
		               |			ИЛИ Локации.КодЖДСтанции ПОДОБНО &СтрокаПоиска
		               |			ИЛИ Локации.НаименованиеАнгл ПОДОБНО &СтрокаПоиска
		               |			ИЛИ Локации.КодПорта ПОДОБНО &СтрокаПоиска
		               |			ИЛИ ЛокацииТаблицаСинонимов.СинонимЛокации ПОДОБНО &СтрокаПоиска)
		               |	И НЕ Локации.ПометкаУдаления
		               |	И Локации.ДоступноДляВыбораНаСайте";
	
	КонецЕсли;
	
	Запрос.УстановитьПараметр("СтрокаПоиска", "%"+СтрокаПоиска+"%");
	Возврат Запрос.Выполнить().Выгрузить();
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		Результат.Добавить(Новый Структура("code, name, zdCode", Ответ.Код, ОчиститьСтрокуДляПередачивXML(Ответ.Наименование), Ответ.КодЖДСтанции));
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

