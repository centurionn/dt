Функция ПолучитьПрокси(ИмяКонстанты, ВызыватьИсключениеПриОшибке = Ложь) Экспорт

//Евросиб Гудкова( 20.01.2023 положила в попытку 
	Попытка
		Определение = Новый WSОпределения(Константы[ИмяКонстанты+?(ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована, "Тестовый", "")].Получить());
		Прокси = Новый WSПрокси(Определение, определение.Сервисы[0].URIПространстваИмен, определение.Сервисы[0].Имя, определение.Сервисы[0].ТочкиПодключения[0].Имя);
	Исключение
		Если ВызыватьИсключениеПриОшибке Тогда
			ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ВызватьИсключение ПредставлениеОшибки;
		КонецЕсли;
		Прокси = Неопределено;	
	КонецПопытки;
// Евросиб Гудкова)

	Возврат Прокси;
	
