Функция ОчиститьСтрокуДляПередачивXML(ИсхСтрока)
	
	Результат = ИсхСтрока;
	
	МассивЭкрСимволов = Новый Массив;
	МассивЭкрСимволов.Добавить("""");
	МассивЭкрСимволов.Добавить("'");
	МассивЭкрСимволов.Добавить(Символы.ПС);
	МассивЭкрСимволов.Добавить("\");
	МассивЭкрСимволов.Добавить("/");
	МассивЭкрСимволов.Добавить(">");
	МассивЭкрСимволов.Добавить("<");
	
	Для каждого Стр из МассивЭкрСимволов Цикл
		Результат = СтрЗаменить(Результат, Стр, "");
	КонецЦикла;

	Возврат Результат;
	
КонецФункции

Функция ПреобразоватьДатуВXML(Дата1С)
	
	Возврат XMLСтрока(Дата1С);
	
