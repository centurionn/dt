Функция ПолучитьРасписаниеПродуктов(ИНН, КПП, ДатаОт, ДатаДо) Экспорт
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	//Запрос.Текст = "ВЫБРАТЬ
	//               |	РейсыЖД.Наименование КАК Наименование,
	//               |	РейсыЖД.ПунктОтправления.КодЖДСтанции КАК ПунктОтправленияКодЖДСтанции,
	//               |	РейсыЖД.ПунктОтправления.Код КАК ПунктОтправленияКод,
	//               |	РейсыЖД.ПунктОтправления.Наименование КАК ПунктОтправленияНаименование,
	//               |	РейсыЖД.ПунктНазначения.КодЖДСтанции КАК ПунктНазначенияКодЖДСтанции,
	//               |	РейсыЖД.ПунктНазначения.Код КАК ПунктНазначенияКод,
	//               |	РейсыЖД.ПунктНазначения.Наименование КАК ПунктНазначенияНаименование,
	//               |	РейсыЖД.ДатаОтправления КАК ДатаОтправления,
	//               |	РейсыЖД.ДатаПрибытия КАК ДатаПрибытия,
	//               |	ПродажиПродуктовОстатки.ВсегоСлотовОстаток КАК ВсегоСлотовОстаток,
	//               |	ПродажиПродуктовОстатки.ЗанятоСлотовОстаток КАК ЗанятоСлотовОстаток,
	//               |	РейсыЖД.КП КАК КП
	//               |ИЗ
	//               |	РегистрНакопления.ПродажиПродуктов.Остатки(
	//               |			,
	//               |			Отправка МЕЖДУ &НачалоПериода И &КонецПериода
	//               |				И Организация.ИНН = &ИНН
	//               |				И Организация.КПП = &КПП) КАК ПродажиПродуктовОстатки
	//               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РейсыЖД КАК РейсыЖД
	//               |		ПО ПродажиПродуктовОстатки.Продукт = РейсыЖД.Продукт
	//               |			И ПродажиПродуктовОстатки.Отправка = РейсыЖД.ДатаОтправления
	//               |ГДЕ
	//               |	ПродажиПродуктовОстатки.Продукт.ВыводитьНаСайт";
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	РейсыЖД.Наименование КАК Наименование,
	               |	РейсыЖД.ПунктОтправления.Код КАК ПунктОтправленияКод,
	               |	РейсыЖД.ПунктОтправления.Наименование КАК ПунктОтправленияНаименование,
	               |	РейсыЖД.ПунктОтправления.КодЖДСтанции КАК ПунктОтправленияКодЖДСтанции,
	               |	РейсыЖД.ПунктНазначения.Код КАК ПунктНазначенияКод,
	               |	РейсыЖД.ПунктНазначения.Наименование КАК ПунктНазначенияНаименование,
	               |	РейсыЖД.ПунктНазначения.КодЖДСтанции КАК ПунктНазначенияКодЖДСтанции,
	               |	РейсыЖД.ДатаОтправления КАК ДатаОтправления,
	               |	РейсыЖД.ДатаПрибытия КАК ДатаПрибытия,
	               |	РейсыЖД.КП КАК КП,
	               |	РейсыЖД.КоличествоТЕУ КАК ВсегоСлотовОстаток,
	               |	РейсыЖД.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.РейсыЖД КАК РейсыЖД
	               |ГДЕ
	               |	НЕ РейсыЖД.ПометкаУдаления
	               |	И НЕ РейсыЖД.ТехРейс
	               |	И РейсыЖД.Продукт.ВыводитьНаСайт
	               |	И РейсыЖД.ДатаОтправления МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И НЕ РейсыЖД.РейсОтменен";
	
	Запрос.УстановитьПараметр("НачалоПериода", ДатаОт);
	Запрос.УстановитьПараметр("КонецПериода", ДатаДо);
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("КПП", КПП);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		НовСтр = Новый Структура();
		НовСтр.Вставить("Наименование", ОчиститьСтрокуДляПередачивXML(Ответ.Наименование));
		
		НовСтр.Вставить("ОтправлениеКодРЖД", Ответ.ПунктОтправленияКодЖДСтанции);
		НовСтр.Вставить("ОтправлениеКодСист", Ответ.ПунктОтправленияКод);
		НовСтр.Вставить("ОтправлениеНаименование", ОчиститьСтрокуДляПередачивXML(Ответ.ПунктОтправленияНаименование));
		
		НовСтр.Вставить("ПрибытиеКодРЖД", Ответ.ПунктНазначенияКодЖДСтанции);
		НовСтр.Вставить("ПрибытиеКодСист", Ответ.ПунктНазначенияКод);
		НовСтр.Вставить("ПрибытиеНаименование", ОчиститьСтрокуДляПередачивXML(Ответ.ПунктНазначенияНаименование));
		
		НовСтр.Вставить("ДатаОтправления", ПреобразоватьДатуВXML(Ответ.ДатаОтправления));
		НовСтр.Вставить("ДатаПрибытия", ПреобразоватьДатуВXML(Ответ.ДатаПрибытия));
		
		НовСтр.Вставить("СлотовВсего", Формат(Ответ.ВсегоСлотовОстаток, "ЧН=; ЧГ="));
		
		ЗанятоСлотовОстаток = 0;
		ТаблПривКТК = Отправки_сервер.ПолучитьТаблицуПривязанныхКонтейнеров(Ответ.Ссылка);
		Для каждого Стр из ТаблПривКТК Цикл
			ЗанятоСлотовОстаток = ЗанятоСлотовОстаток + Стр.КоличествоКТК * Стр.ТипКТК.ТЕУ;
		КонецЦикла;
		
		НовСтр.Вставить("СлотовЗанято", Формат(ЗанятоСлотовОстаток, "ЧН=; ЧГ="));
		
		НовСтр.Вставить("КП", Формат(Ответ.КП, "БЛ=0; БИ=1"));
		
		Результат.Добавить(НовСтр);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СоздатьЗапросКлиента(ФИО, Резидент, НазваниеКонтрагента, ИННКонтрагента, КонтактныйТелефон, КонтактнаяПочта, Отправка_дата, Прибытие_дата, Отправка_локация, Прибытие_локация, Груз, КонтейнерЕвросиба, таблицаКонтейнерТипов, ОписаниеЗаявки) Экспорт
	
	ЗапросК = Документы.Запрос.СоздатьДокумент();
	ЗапросК.Заполнить(неопределено);
	ЗапросК.Груз = груз;
	ЗапросК.ИсточникЗапроса = Перечисления.ИсточникиЗапросов.ЗапросЧерезВебСайтБезАвторизации;
	ЗапросК.КонтактныйТелефон = КонтактныйТелефон;
	ЗапросК.КонтейнерКлиента = НЕ КонтейнерЕвросиба;
	ЗапросК.ПериодОтправкиНачало = Отправка_дата;
	ЗапросК.ПериодПрибытияНачало = Прибытие_дата;
	ЗапросК.ПунктОтправления = Отправка_локация;
	ЗапросК.ПунктНазначения = Прибытие_локация;
	ЗапросК.Резидент = Резидент;
	Если ЗначениеЗаполнено(ИННКонтрагента) Тогда
		Запроск.Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", ФОрмат(ИННКонтрагента, "ЧГ="));
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ИННКонтрагента) И ЗначениеЗаполнено(НазваниеКонтрагента) Тогда
		Запроск.Контрагент = КонтрагентыДоговоры_сервер.НайтиКонтрагентаПоНечеткомуУсловию(НазваниеКонтрагента);
	КонецЕсли;
	Для каждого Стр из таблицаКонтейнерТипов Цикл
		НСтр = Запроск.СоставУслуги.Добавить();
		НСтр.Количество = Стр.КоличествоКТ;
		НСтр.ТипТЕ = Стр.ТипКТ;
	КонецЦикла;
	Запроск.ТекстЗапроса = ОписаниеЗаявки;
	Запроск.ЭлектроннаяПочта = КонтактнаяПочта;
	запроск.Примечание = ФИО;
	Запроск.Дата = ТекущаяДата();
	Запроск.Записать(РежимЗаписиДокумента.Запись);
	Попытка
		Запроск.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
	КонецПопытки;
	
	Возврат запроск.Ссылка;
	
КонецФункции

Функция НайтиПосчитатьКалькуляцию(Отправка_локация, Прибытие_локация, Отправка_дата, груз, ВесГруза, РазмерКТК, КонтейнерЕвросиба) Экспорт
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Калькуляция.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.Калькуляция КАК Калькуляция
	               |ГДЕ
	               |	Калькуляция.веб_ДоступнаНаВебе
	               |	И Калькуляция.веб_ОткудаРегион В(&веб_ОткудаРегион)
	               |	И Калькуляция.веб_КудаРегион В(&веб_КудаРегион)
	               |	И &ДатаОтправления МЕЖДУ Калькуляция.веб_периодОтправленияНачало И Калькуляция.веб_периодОтправленияОкончание
	               |	И &Вес МЕЖДУ Калькуляция.веб_ВесОт И Калькуляция.веб_ВесДо
	               |	И ВЫБОР
	               |			КОГДА &РазмерКТК = 20
	               |				ТОГДА Калькуляция.веб_Для20КТК
	               |			КОГДА &РазмерКТК = 40
	               |				ТОГДА Калькуляция.веб_Для40КТК
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &КонтейнерЕвросиба
	               |				ТОГДА Калькуляция.веб_ДляКТКЕвросиб
	               |			ИНАЧЕ Калькуляция.веб_ДляКТККлиента
	               |		КОНЕЦ
	               |	И Калькуляция.Проведен
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Калькуляция.Дата УБЫВ";
	Запрос.УстановитьПараметр("веб_ОткудаРегион", Локации_сервер.ПолучитьМассивРодителей(Отправка_локация, Истина));
	Запрос.УстановитьПараметр("веб_КудаРегион", Локации_сервер.ПолучитьМассивРодителей(Прибытие_локация, Истина));
	Запрос.УстановитьПараметр("ДатаОтправления", Отправка_дата);
	Запрос.УстановитьПараметр("Вес", ВесГруза);
	Запрос.УстановитьПараметр("РазмерКТК", РазмерКТК);
	Запрос.УстановитьПараметр("КонтейнерЕвросиба", КонтейнерЕвросиба);
	Ответ = Запрос.Выполнить().Выбрать();
	Если ответ.Следующий() Тогда
		Результат = Ответ.ссылка;
	КонецЕсли;	
	
	Возврат результат;
	
КонецФункции

Функция СоздатьДоговорЗаявку(Запрос, НомерКалькуляции, КоличествоКонтейнеров, ПараметрыЗаявки) Экспорт
	
	// коды возврата функции
	// 1 - калькуляция не найдена
	// 2 - ошибка создания калькуляции
	// 3 - ошибка создания ПСЦ
	// 4 - ошибка создания заявки
	
	ИсхКалькуляция = Документы.Калькуляция.НайтиПоНомеру(НомерКалькуляции);
	Если НЕ ЗначениеЗаполнено(ИсхКалькуляция) Тогда
		Возврат 1;
	КонецЕсли;
	
	КалькуляцияКопия = ИсхКалькуляция.Скопировать();
	КалькуляцияКопия.веб_ДоступнаНаВебе = Ложь;
	КалькуляцияКопия.Дата = текущаяДата();
	КалькуляцияКопия.Заполнить(Запрос);
	Попытка
		КалькуляцияКопия.Записать(РежимЗаписиДокумента.Запись);
		КалькуляцияКопия.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ОО = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("Ошибка записи калькуляции", УровеньЖурналаРегистрации.Ошибка,,, ОО);
		Возврат 2;
	КонецПопытки;
	
	ПСЦ = Документы.ПСЦ.СоздатьДокумент();
	ПСЦ.Заполнить(КалькуляцияКопия.Ссылка);
	ПСЦ.Дата = ТекущаяДата();
	ПСЦ.ФорматПротокола = Перечисления.ФорматПротокола.ПротоколДвуязычный;
	Попытка
		ПСЦ.Записать(РежимЗаписиДокумента.Запись);
		ПСЦ.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ОО = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("Ошибка записи ПСЦ", УровеньЖурналаРегистрации.Ошибка,,, ОО);
		Возврат 3;
	КонецПопытки;
	
	ЗаявкаК = Документы.Заявка.СоздатьДокумент();
	ЗаявкаК.Заполнить(неопределено);
	ЗаявкаК.Дата = текущаяДата();
	ЗаявкаК.Контрагент = Запрос.Контрагент;
	ЗаявкаК.ПСЦ = ПСЦ.Ссылка;
	ЗаявкаК.Отправка = Запрос.ПериодОтправкиНачало;
	ЗаявкаК.Прибытие = Запрос.ПериодПрибытияНачало;
	ЗаявкаК.Организация = Запрос.Организация;
	ЗаявкаК.КраткоеОписаниеГруза = Запрос.Груз;
	
	Для каждого Стр из Запрос.СоставУслуги Цикл
		НСтр = Заявкак.СоставУслуги.Добавить();
		НСтр.ТипКТК = Стр.ТипТЕ;
		НСтр.КоличествоМест = КоличествоКонтейнеров;
		НСтр.Груз = Запрос.Груз;
	КонецЦикла;
	
	Для каждого Стр из ПараметрыЗаявки Цикл
		НСтр = ЗаявкаК.СоставУслуги.Добавить();
		НСтр.Услуга = Справочники.Номенклатура.НайтиПоКоду(Стр);
		НСтр.Груз = Запрос.Груз;
		НСтр.КоличествоМест = КоличествоКонтейнеров;
	КонецЦикла;
	
	Попытка
		ЗаявкаК.Записать(РежимЗаписиДокумента.Запись);
		ЗаявкаК.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ОО = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("Ошибка записи заявки", УровеньЖурналаРегистрации.Ошибка,,, ОО);
		Возврат 4;
	КонецПопытки;
	
	Возврат ЗаявкаК.Ссылка;
	
КонецФункции

