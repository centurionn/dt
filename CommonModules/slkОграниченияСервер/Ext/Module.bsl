
Функция ВычислитьПоказателиОграничений(ГоризонтПланирования, ФильтрОграничения) Экспорт
	
	// Установим общие отборы и переменные
	Результат = Новый Массив;
	РеальныйФильтрОграничений = ПолучитьОграниченияПоИерархии(ФильтрОграничения);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФильтрОграничений", РеальныйФильтрОграничений);
	Запрос.УстановитьПараметр("ФильтрОграниченийПустой", РеальныйФильтрОграничений.Количество() = 0);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Ограничения.Ссылка КАК Ограничение,
	               |	Ограничения.ЕдиницаТарификации,
	               |	Ограничения.ЖелтыйПорог,
	               |	Ограничения.КрасныйПорог,
	               |	Ограничения.НижняяГраница,
	               |	Ограничения.ТипОграничения
	               |ИЗ
	               |	Справочник.Ограничения КАК Ограничения
	               |ГДЕ
	               |	(Ограничения.Ссылка В (&ФильтрОграничений)
	               |			ИЛИ &ФильтрОграниченийПустой)
	               |	И НЕ Ограничения.ПометкаУдаления
	               |	И НЕ Ограничения.ЭтоГруппа
	               |	И (&ВычисляемыйДень >= Ограничения.НачалоДействия
	               |			ИЛИ Ограничения.НачалоДействия = ДАТАВРЕМЯ(1, 1, 1))
	               |	И (Ограничения.ОкончаниеДействия > &ВычисляемыйДень
	               |			ИЛИ Ограничения.ОкончаниеДействия = ДАТАВРЕМЯ(1, 1, 1))";
	
	// Вычисляем значения по дням
	Сч = НачалоДня(ТекущаяДата());
	Конец = НачалоДня(ТекущаяДата())+ ГоризонтПланирования*24*60*60;
	Пока Сч <= Конец Цикл
		Запрос.УстановитьПараметр("ВычисляемыйДень", Сч);
		Ответ = Запрос.Выполнить().Выбрать();
		Пока Ответ.Следующий() Цикл
			Если Ответ.ТипОграничения = Перечисления.ТипыОграничений.Остаточные Тогда
				ЧисловойПоказатель = 0;
				ЧисловойПоказательТЧ = ПолучитьОстаточныйПоказатель(Сч, Ответ.Ограничение);
				Для каждого Стр из ЧисловойПоказательТЧ Цикл
					ЧисловойПоказатель = ЧисловойПоказатель + Стр.ИтоговыйРезультат;
				КонецЦикла;
			Иначе
				ЧисловойПоказатель = 0;
				ЧисловойПоказательТЧ = ПолучитьПроцессныйПоказатель(Сч, Ответ.Ограничение);
				Для каждого Стр из ЧисловойПоказательТЧ Цикл
					ЧисловойПоказатель = ЧисловойПоказатель + Стр.ИтоговыйРезультат;
				КонецЦикла;
			КонецЕсли;
			Результат.Добавить(Новый Структура("Ограничение, ЕдиницаТарификации, ЖелтыйПорог, КрасныйПорог, НижняяГраница, День, Значение", Ответ.Ограничение, Ответ.ЕдиницаТарификации, Ответ.ЖелтыйПорог, Ответ.КрасныйПорог, Ответ.НижняяГраница, Сч, ЧисловойПоказатель));
		КонецЦикла;
		Сч = Сч + 24*60*60;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьКоэффициент(Значение, Ограничение)
	
	Для каждого Стр из Ограничение.Коэффициенты Цикл
		Если Стр.Показатель = Значение Тогда Возврат Стр.Коэффициент; КонецЕсли;
	КонецЦикла;
	Возврат 1;
	
КонецФункции

Функция ПолучитьОстаточныйПоказатель(ВычисляемыйДень, Ограничение)
	
	РезультатМассив = Новый Массив;
	//РезультатМассив.Добавить(Новый Структура("Операция, ТипТС, ТС, ТипТЕ, ТЕ, Местоположение, ГП, ТипНоменклатуры, Номенклатура, ЧисловойРезультат, Коэффициент, ИтоговыйРезультат"));
	//ЧисловойРезультат = 0;
	
	ОтборТипТЕ = Ограничение.ТипыТЕ.Выгрузить().ВыгрузитьКолонку("ТипТЕ");
	ОтборТипТС = Ограничение.ТипыТС.Выгрузить().ВыгрузитьКолонку("ТипТС");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", ВычисляемыйДень);
	Запрос.УстановитьПараметр("МЕСТОПОЛОЖЕНИЕВРЕГИОНЕ", Ограничение.ПунктОтправленияВРегионе);
	Запрос.УстановитьПараметр("Местоположение", Ограничение.ПунктОтправления);
	Запрос.УстановитьПараметр("ОрганизацияПустая", НЕ ЗначениеЗаполнено(Ограничение.Организация));
	Запрос.УстановитьПараметр("Организация", Ограничение.Организация);
	Запрос.УстановитьПараметр("ОтборТипТЕ", ОтборТипТЕ);
	Запрос.УстановитьПараметр("ОтборТипТЕПустой", ОтборТипТЕ.Количество() = 0);
	Запрос.УстановитьПараметр("ОтборТипТС", ОтборТипТС);
	Запрос.УстановитьПараметр("ОтборТипТСПустой", ОтборТипТС.Количество() = 0);
	Запрос.УстановитьПараметр("ТарифицируетсяПоКоличеству", Ограничение.ЕдиницаТарификации = Перечисления.ЕдиницыТарификации.КоличествоНоменклатуры);
	Запрос.УстановитьПараметр("ЕИКоличества", Ограничение.ЕдиницаИзмеренияКоличества);
	
	Если 
		Ограничение.ЕдиницаТарификации = Перечисления.ЕдиницыТарификации.ТС ИЛИ 
		Ограничение.ЕдиницаТарификации = Перечисления.ЕдиницыТарификации.ТЕ 
	Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	ПозицияВагоновФактОстатки.Локация КАК Местоположение,
		               |	ПозицияВагоновФактОстатки.Вагон КАК ТС,
		               |	ПозицияВагоновФактОстатки.ТипВагона КАК ТипТС,
		               |	ПозицияВагоновФактОстатки.ФактОстаток КАК КоличествоТСОстаток,
		               |	NULL КАК ТЕ,
		               |	NULL КАК ТипТЕ
		               |ИЗ
		               |	РегистрНакопления.ПозицияВагоновФакт.Остатки(
		               |			&Период,
		               |			ВЫБОР
		               |					КОГДА &МЕСТОПОЛОЖЕНИЕВРЕГИОНЕ
		               |						ТОГДА Локация В ИЕРАРХИИ (&Местоположение)
		               |					ИНАЧЕ Локация = &Местоположение
		               |				КОНЕЦ
		               |				И (ТипВагона В (&ОтборТипТС)
		               |					ИЛИ &ОтборТипТСПустой)) КАК ПозицияВагоновФактОстатки
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	ПозицияКонтейнеровФактОстатки.Локация,
		               |	NULL,
		               |	NULL,
		               |	ПозицияКонтейнеровФактОстатки.ФактОстаток,
		               |	ПозицияКонтейнеровФактОстатки.Контейнер,
		               |	ПозицияКонтейнеровФактОстатки.ТипКТК
		               |ИЗ
		               |	РегистрНакопления.ПозицияКонтейнеровФакт.Остатки(
		               |			&Период,
		               |			ВЫБОР
		               |					КОГДА &МЕСТОПОЛОЖЕНИЕВРЕГИОНЕ
		               |						ТОГДА Локация В ИЕРАРХИИ (&Местоположение)
		               |					ИНАЧЕ Локация = &Местоположение
		               |				КОНЕЦ
		               |				И (ТипКТК В (&ОтборТипТЕ)
		               |					ИЛИ &ОтборТипТЕПустой)) КАК ПозицияКонтейнеровФактОстатки";
	
		Ответ = Запрос.Выполнить().Выбрать();
		Пока Ответ.Следующий() Цикл
			Если Ограничение.ЕдиницаТарификации = Перечисления.ЕдиницыТарификации.ТС И ЗначениеЗаполнено(Ответ.ТипТС) Тогда
				УмножающийКоэффициент = ПолучитьКоэффициент(Ответ.ТипТС, Ограничение);
				//ЧисловойРезультат = ЧисловойРезультат + УмножающийКоэффициент * Ответ.КоличествоТСОстаток;
				РезультатМассив.Добавить(Новый Структура("Операция, ТипТС, ТС, ТипТЕ, ТЕ, Местоположение, ГП, ТипНоменклатуры, Номенклатура, ЧисловойРезультат, Коэффициент, ИтоговыйРезультат",
									неопределено, Ответ.ТипТС, Ответ.ТС, Ответ.ТипТЕ, Ответ.ТЕ, Ответ.Местоположение, неопределено, неопределено, неопределено, Ответ.КоличествоТСОстаток, УмножающийКоэффициент, Ответ.КоличествоТСОстаток * УмножающийКоэффициент));
			ИначеЕсли Ограничение.ЕдиницаТарификации = Перечисления.ЕдиницыТарификации.ТЕ И ЗначениеЗаполнено(Ответ.ТипТЕ) Тогда
				УмножающийКоэффициент = ПолучитьКоэффициент(Ответ.ТипТЕ, Ограничение);
				//ЧисловойРезультат = ЧисловойРезультат + УмножающийКоэффициент * Ответ.КоличествоТЕОстаток;
				РезультатМассив.Добавить(Новый Структура("Операция, ТипТС, ТС, ТипТЕ, ТЕ, Местоположение, ГП, ТипНоменклатуры, Номенклатура, ЧисловойРезультат, Коэффициент, ИтоговыйРезультат",
									неопределено, Ответ.ТипТС, Ответ.ТС, Ответ.ТипТЕ, Ответ.ТЕ, Ответ.Местоположение, неопределено, неопределено, неопределено, Ответ.КоличествоТСОстаток, УмножающийКоэффициент, Ответ.КоличествоТСОстаток * УмножающийКоэффициент));
			КонецЕсли;
		КонецЦикла;
					   
	КонецЕсли;
	
	Возврат РезультатМассив;
	
КонецФункции

Функция ПолучитьПроцессныйПоказатель(ВычисляемыйДень, Ограничение)
	
	РезультатМассив = Новый Массив;
	//РезультатМассив.Добавить(Новый Структура("Операция, ТипТС, ТС, ТипТЕ, ТЕ, Местоположение, ГП, ТипНоменклатуры, Номенклатура, ЧисловойРезультат, Коэффициент, ИтоговыйРезультат"));
	//ЧисловойРезультат = 0;
	ВидыОпераций = Ограничение.ВидыОпераций.Выгрузить().ВыгрузитьКолонку("ВидОперации");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПунктОтправленияВРегионе", Ограничение.ПунктОтправленияВРегионе);
	Запрос.УстановитьПараметр("ПунктОтправления", Ограничение.ПунктОтправления);
	Запрос.УстановитьПараметр("ПунктНазначения", Ограничение.ПунктНазначения);
	Запрос.УстановитьПараметр("ПунктНазначенияВРегионе", Ограничение.ПунктНазначенияВРегионе);
	Запрос.УстановитьПараметр("Поставщик", Ограничение.Поставщик);
	Запрос.УстановитьПараметр("Организация", Ограничение.Организация);
	Запрос.УстановитьПараметр("Контрагент", Ограничение.Контрагент);
	Запрос.УстановитьПараметр("Договор", Ограничение.Договор);
	Запрос.УстановитьПараметр("Валюта", Ограничение.Валюта);
	Запрос.УстановитьПараметр("Регламентный", Ограничение.Регламентный);
	Запрос.УстановитьПараметр("ОтборВид", ВидыОпераций);
	Запрос.УстановитьПараметр("ОтборВидПустой", ВидыОпераций.Количество() = 0);
	Запрос.УстановитьПараметр("Период", ВычисляемыйДень);
	Запрос.УстановитьПараметр("НАЧАЛОПЕРИОДА", НачалоДня(ВычисляемыйДень));
	Запрос.УстановитьПараметр("КОНЕЦПЕРИОДА", КонецДня(ВычисляемыйДень));
	Запрос.УстановитьПараметр("ПериодНачалаОграничения", Ограничение.НачалоДействия);
	Запрос.УстановитьПараметр("ПериодОкончанияОграничения", Ограничение.ОкончаниеДействия);
	Запрос.УстановитьПараметр("РаспределениеВесаОперацииПоДням", Ограничение.РаспределениеВесаОперацииПоДням);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	Операция.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.Операция КАК Операция
	               |ГДЕ
	               |	Операция.Проведен
	               |	И ВЫБОР
	               |				КОГДА &ПунктОтправленияВРегионе
	               |					ТОГДА Операция.ПунктОтправления В ИЕРАРХИИ (&ПунктОтправления)
	               |				ИНАЧЕ Операция.ПунктОтправления = &ПунктОтправления
	               |						ИЛИ &ПунктОтправления = ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка)
	               |			КОНЕЦ
	               |			И ВЫБОР
	               |				КОГДА &ПунктНазначенияВРегионе
	               |					ТОГДА Операция.ПунктНазначения В ИЕРАРХИИ (&ПунктНазначения)
	               |				ИНАЧЕ Операция.ПунктНазначения = &ПунктНазначения
	               |						ИЛИ &ПунктНазначения = ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка)
	               |			КОНЕЦ
	               |			И (Операция.Организация = &Организация
	               |				ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	               |			И (Операция.Поставщик = &Контрагент
	               |				ИЛИ &Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	               |			И (Операция.Договор = &Договор
	               |				ИЛИ &Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка))
	               |			И (Операция.Валюта = &Валюта
	               |				ИЛИ &Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка))
	               |			И (Операция.Услуга В (&ОтборВид)
	               |				ИЛИ &ОтборВидПустой)";
	
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		Если НЕ ОперацияПроходитПоДопОтборам(Ответ.Ссылка, Ограничение) Тогда Продолжить; КонецЕсли;
		
		Если Ограничение.ЕдиницаТарификации = Перечисления.ЕдиницыТарификации.Операция Тогда
			//ЧисловойРезультат = ЧисловойРезультат + 1;
			РезультатМассив.Добавить(Новый Структура("Операция, ТипТС, ТС, ТипТЕ, ТЕ, Местоположение, ГП, ТипНоменклатуры, Номенклатура, ЧисловойРезультат, Коэффициент, ИтоговыйРезультат",
									Ответ.Ссылка, неопределено, неопределено, неопределено, неопределено, неопределено, неопределено, неопределено, неопределено, 1, 1, 1));
		ИначеЕсли Ограничение.ЕдиницаТарификации = Перечисления.ЕдиницыТарификации.ТС Тогда
			ТЧРез = ПолучитьТаблицуТСОперации(Ответ.Ссылка);
			Для каждого Стр из ТЧРез Цикл
				Если НЕ ЗначениеЗаполнено(Стр.Значение) Тогда Продолжить; КонецЕсли;
				Коэффициент = ПолучитьКоэффициент(Стр.Значение, Ограничение);
				РезультатМассив.Добавить(Новый Структура("Операция, ТипТС, ТС, ТипТЕ, ТЕ, Местоположение, ГП, ТипНоменклатуры, Номенклатура, ЧисловойРезультат, Коэффициент, ИтоговыйРезультат",
									Ответ.Ссылка, Стр.Значение, неопределено, неопределено, неопределено, неопределено, неопределено, неопределено, неопределено, Стр.Количество, Коэффициент, Коэффициент*Стр.Количество));
				//ЧисловойРезультат = ЧисловойРезультат + Коэффициент*Стр.Количество;
			КонецЦикла;
		ИначеЕсли Ограничение.ЕдиницаТарификации = Перечисления.ЕдиницыТарификации.ТЕ Тогда
			ТЧРез = ПолучитьТаблицуТЕОперации(Ответ.Ссылка);
			Для каждого Стр из ТЧРез Цикл
				Если НЕ ЗначениеЗаполнено(Стр.Значение) Тогда Продолжить; КонецЕсли;
				Коэффициент = ПолучитьКоэффициент(Стр.Значение, Ограничение);
				РезультатМассив.Добавить(Новый Структура("Операция, ТипТС, ТС, ТипТЕ, ТЕ, Местоположение, ГП, ТипНоменклатуры, Номенклатура, ЧисловойРезультат, Коэффициент, ИтоговыйРезультат",
									Ответ.Ссылка, неопределено, неопределено, Стр.Значение, неопределено, неопределено, неопределено, неопределено, неопределено, Стр.Количество, Коэффициент, Коэффициент*Стр.Количество));
				//ЧисловойРезультат = ЧисловойРезультат + Коэффициент*Стр.Количество;
			КонецЦикла;
		//ИначеЕсли Ограничение.ЕдиницаТарификации = Перечисления.ЕдиницыТарификации.Стоимость Тогда
		//	
		//	Стоимость = ?(ЗначениеЗаполнено(Ответ.Ссылка.ФактическаяСтоимость), Ответ.Ссылка.ФактическаяСтоимость, Ответ.Ссылка.ПлановаяСтоимость);
		//	РезультатМассив.Добавить(Новый Структура("Операция, ТипТС, ТС, ТипТЕ, ТЕ, Местоположение, ГП, ТипНоменклатуры, Номенклатура, ЧисловойРезультат, Коэффициент, ИтоговыйРезультат",
		//		Ответ.Ссылка, неопределено, неопределено, неопределено, неопределено, неопределено, неопределено, неопределено, неопределено, Стоимость, 1, Стоимость));
		КонецЕсли;
		
		Если Ограничение.РаспределятьПоДням Тогда
			
			Для каждого Стр из РезультатМассив Цикл
				ДатыОперации = Новый Структура("ФактическаяДатаНачала,ПлановаяДатаНачала,ФактическаяДатаОкончания,ПлановаяДатаОкончания", Стр.Операция.ДатаОтправленияФакт, Стр.Операция.ДатаОтправления, Стр.Операция.ДатаНазначенияФакт, Стр.Операция.ДатаНазначения);
				ДатаНачала = ?(ЗначениеЗаполнено(ДатыОперации.ФактическаяДатаНачала), ДатыОперации.ФактическаяДатаНачала, ДатыОперации.ПлановаяДатаНачала);
				ДатаОкончания = ?(ЗначениеЗаполнено(ДатыОперации.ФактическаяДатаОкончания), ДатыОперации.ФактическаяДатаОкончания, ДатыОперации.ПлановаяДатаОкончания);
				Длительность = (ДатаОкончания - ДатаНачала) / 3600 / 24;
				Длительность = Окр(Длительность, 0, РежимОкругления.Окр15как20);
				Стр.ЧисловойРезультат = Стр.ЧисловойРезультат / Длительность;
				Стр.ИтоговыйРезультат = Стр.ИтоговыйРезультат / Длительность;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат РезультатМассив;
	
КонецФункции

