Функция ОперацияПроходитПоДопОтборам(Операция, Ограничение)
	
	ОперацияПодходитПоПараметрам = Истина;
	
	//ОтборНоменклатура = Ограничение.Номенклатура.Выгрузить().ВыгрузитьКолонку("Номенклатура");
	//ОтборТипНоменклатуры = ПолучитьТипыНоменклатурыПоНоменклатуре(ОтборНоменклатура);
	ОтборТипТЕ = Ограничение.ТипыТЕ.Выгрузить().ВыгрузитьКолонку("ТипТЕ");
	ОтборТипТС = Ограничение.ТипыТС.Выгрузить().ВыгрузитьКолонку("ТипТС");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОперацияГрузы.ТипТС КАК ТипТС,
	               |	ОперацияГрузы.ТипТЕ КАК ТипТЕ
	               |ИЗ
	               |	Документ.Операция.Грузы КАК ОперацияГрузы
	               |ГДЕ
	               |	ОперацияГрузы.Ссылка = &Операция";
	
	//Запрос.Текст = "ВЫБРАТЬ
	//               |	ГрузыВОперациях.ТипТС,
	//               |	ГрузыВОперациях.ТипТЕ,
	//               |	ГрузыВОперациях.Номенклатура,
	//               |	ГрузыВОперациях.Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры
	//               |ИЗ
	//               |	РегистрНакопления.ГрузыВОперациях КАК ГрузыВОперациях
	//               |ГДЕ
	//               |	ГрузыВОперациях.Операция = &Операция";
	Запрос.УстановитьПараметр("Операция", Операция);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		Если ОтборТипТС.Количество() > 0 И Ответ.ТипТС <> Справочники.ТипыТранспортныхСредств.Неизвестно И ОтборТипТС.Найти(Ответ.ТипТС) = неопределено Тогда ОперацияПодходитПоПараметрам = Ложь; КонецЕсли;
		Если ОтборТипТЕ.Количество() > 0 И Ответ.ТипТЕ <> Справочники.ТипыТранспортныхЕдиниц.Неизвестно И ОтборТипТС.Найти(Ответ.ТипТС) = неопределено Тогда ОперацияПодходитПоПараметрам = Ложь; КонецЕсли;
		//Если ОтборТипНоменклатуры.Количество() > 0 И ОтборТипНоменклатуры.Найти(Ответ.ТипНоменклатуры) = неопределено Тогда ОперацияПодходитПоПараметрам = Ложь; КонецЕсли;
		//Если ОтборНоменклатура.Количество() > 0 И ОтборНоменклатура.Найти(Ответ.Номенклатура) = неопределено Тогда ОперацияПодходитПоПараметрам = Ложь; КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОперацияПодходитПоПараметрам;
	
КонецФункции

Функция ПолучитьОграниченияПоИерархии(СписокОграничений)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Ограничения.Ссылка
	               |ИЗ
	               |	Справочник.Ограничения КАК Ограничения
	               |ГДЕ
	               |	НЕ Ограничения.ПометкаУдаления
	               |	И НЕ Ограничения.ЭтоГруппа
	               |	И Ограничения.Ссылка В ИЕРАРХИИ(&Ссылка)";
	
	Результат = Новый Массив;
	Для каждого Стр из СписокОграничений Цикл
		
		Если НЕ Стр.ЭтоГруппа Тогда
			Результат.Добавить(Стр);
		Иначе
			
			Запрос.УстановитьПараметр("Ссылка", Стр);
			Ответ = Запрос.Выполнить().Выбрать();
			Пока Ответ.Следующий() Цикл
				Результат.Добавить(Ответ.Ссылка);
			КонецЦикла;
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ВычислитьДетальныеПоказателиОграничения(День, Ограничение) Экспорт
	
	Результат = Новый Массив;
	
	Если Ограничение.ТипОграничения = Перечисления.ТипыОграничений.Остаточные Тогда
		Результат = ПолучитьОстаточныйПоказатель(День, Ограничение);
	Иначе
		Результат = ПолучитьПроцессныйПоказатель(День, Ограничение);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСписокУведомленийПоОграничениям() Экспорт
	
	ОтправлятьПовторныеОграничения = Константы.ПовторноОтправлятьПредупрежденияОграничений.Получить();
	Результат = Новый Массив;
	ПромежуточныйРезультат = Новый Массив;
	
	// 1. Получаем список ограничений, по которым вообще надо что-то рассылать и вычисляем промежуточную таблицу для дальнейшей обработки
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Ограничения.Ссылка,
	               |	Ограничения.УведомлятьОПревышенииОграниченияВЗаданномГоризонтеДН,
	               |	Ограничения.ТипОграничения,
	               |	Ограничения.ЖелтыйПорог,
	               |	Ограничения.КрасныйПорог,
	               |	Ограничения.НижняяГраница
	               |ИЗ
	               |	Справочник.Ограничения КАК Ограничения
	               |ГДЕ
	               |	НЕ Ограничения.ПометкаУдаления
	               |	И НЕ Ограничения.ЭтоГруппа
	               |	И Ограничения.ОповещатьПоОграничению";
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		Для Сч = 0 По Ответ.УведомлятьОПревышенииОграниченияВЗаданномГоризонтеДН Цикл
			
			ТДата = НачалоДня(ТекущаяДата()) + Сч*3600*24;
			РЕЗ = ВычислитьДетальныеПоказателиОграничения(ТДата, Ответ.Ссылка);
			ИТОГ = 0;
			Для каждого Стр из РЕЗ Цикл
				ИТОГ = ИТОГ + Стр.ИтоговыйРезультат;
			КонецЦикла;
			
			ЖелтыйПорог = Ложь;
			КрасныйПорог = Ложь;
			
			Если НЕ Ответ.НижняяГраница И ИТОГ >= Ответ.КрасныйПорог Тогда 
				КрасныйПорог = Истина; 
			ИначеЕсли НЕ Ответ.НижняяГраница И ИТОГ >= Ответ.ЖелтыйПорог Тогда
				ЖелтыйПорог = Истина;
			КонецЕсли;
			
			Если Ответ.НижняяГраница И ИТОГ <= Ответ.КрасныйПорог Тогда 
				КрасныйПорог = Истина; 
			ИначеЕсли Ответ.НижняяГраница И ИТОГ <= Ответ.ЖелтыйПорог Тогда
				ЖелтыйПорог = Истина;
			КонецЕсли;
			
			Для каждого Пользователь из Ответ.Ссылка.ОповещенияПользователям Цикл
				Если ЖелтыйПорог И (Пользователь.ПорогУведомлений = Перечисления.ПорогУведомления.Желтый ИЛИ Пользователь.ПорогУведомлений = Перечисления.ПорогУведомления.ЖелтыйИКрасный) Тогда
					ПромежуточныйРезультат.Добавить(Новый Структура("Пользователь, День, Ограничение, ЖелтыйПорог, Значение", Пользователь.Пользователь, ТДата, Ответ.Ссылка, Истина, ИТОГ));
				КонецЕсли;
				Если КрасныйПорог И (Пользователь.ПорогУведомлений = Перечисления.ПорогУведомления.Красный ИЛИ Пользователь.ПорогУведомлений = Перечисления.ПорогУведомления.ЖелтыйИКрасный) Тогда
					ПромежуточныйРезультат.Добавить(Новый Структура("Пользователь, День, Ограничение, ЖелтыйПорог, Значение", Пользователь.Пользователь, ТДата, Ответ.Ссылка, Ложь, ИТОГ));
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// 2. Теперь по таблице формируем сообщения для пользователей
	СписокПользователей = Новый Массив;
	Для каждого Стр из ПромежуточныйРезультат Цикл
		Если СписокПользователей.Найти(Стр.Пользователь) = неопределено Тогда
			СписокПользователей.Добавить(Стр.Пользователь);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого Стр из СписокПользователей Цикл
		ПочтовыйЯщикПользователя = ""; //ПользователиСервер.ПолучитьПочтовыйЯщикПользователя(Стр);
		Если ПочтовыйЯщикПользователя = неопределено Тогда
			ЗаписьЖурналаРегистрации("Ошибка отправки сообщения пользователю " + Стр + ": не указан почтовый ящик!", УровеньЖурналаРегистрации.Ошибка);
			Продолжить;
		КонецЕсли;
		
		Для каждого Стр2 из ПромежуточныйРезультат Цикл
			Если Стр2.Пользователь <> Стр Тогда Продолжить; КонецЕсли;
			ТемаЪ = "" + ?(Стр2.ЖелтыйПорог, "Желтый", "Красный") + " порог = " + Стр2.Значение + ?(Стр2.Ограничение.НижняяГраница, " < ", " > ") + ?(Стр2.ЖелтыйПорог, Стр2.Ограничение.ЖелтыйПорог, Стр2.Ограничение.КрасныйПорог) + " = " + Стр2.Ограничение + " " + Формат(Стр2.День, "ДФ=dd.MM.yy");
			Если ПроверитьДобавитьЗаписьВЖурналОтправкиОграничений(Стр2.Ограничение, Стр2.Пользователь, Стр2.День, ТемаЪ) И НЕ ОтправлятьПовторныеОграничения Тогда Продолжить; КонецЕсли;
			Текст = "<table border='1'><tr><td>Ограничение</td><td>Дата</td><td>Желтая граница</td><td>Красная граница</td><td>Текущее значение</td></tr>";
			Текст = Текст + "<tr><td>"+Стр2.Ограничение+"</td><td style='text-align:center'>"+Формат(Стр2.День, "ДФ=dd.MM.yy")+"</td><td style='text-align:center'>"+Стр2.Ограничение.ЖелтыйПорог+"</td><td style='text-align:center'>"+Стр2.Ограничение.КрасныйПорог+"</td><td style='text-align:center; background:"+?(Стр2.ЖелтыйПорог, "yellow", "red")+"'>"+Стр2.Значение+"</td></tr>";
			Текст = Текст + "</table>";
			Пользователи = Новый Массив;
			Пользователи.Добавить(ПочтовыйЯщикПользователя);
			Результат.Добавить(Новый Структура("Получатели, Тема, Текст", Пользователи, ТемаЪ, Текст))
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьДобавитьЗаписьВЖурналОтправкиОграничений(Ограничение, Пользователь, День, Тема)
	
	СообщениеУжеБыло = Ложь;
	
	НЗ = РегистрыСведений.РанееОтправленныеСообщения.СоздатьНаборЗаписей();
	НЗ.Отбор.Ограничение.Установить(Ограничение);
	НЗ.Отбор.Пользователь.Установить(Пользователь);
	НЗ.Отбор.День.Установить(День);
	НЗ.Прочитать();
	Для каждого Стр из НЗ Цикл
		Если Стр.Тема = Тема Тогда СообщениеУжеБыло = Истина; КонецЕсли;
	КонецЦикла;
	НЗ.Очистить();
	НСтр = НЗ.Добавить();
	НСтр.Ограничение = Ограничение;
	НСтр.Период = ТекущаяДата();
	НСтр.Пользователь = Пользователь;
	НСтр.Тема = Тема;
	НСтр.День = День;
	НЗ.Записать(Истина);
	
	Возврат СообщениеУжеБыло;
	
КонецФункции

