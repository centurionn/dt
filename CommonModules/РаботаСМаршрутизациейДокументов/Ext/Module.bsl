								Продолжить;
							КонецЕсли;
							Если МассивВагЕвросиб.Найти(Стр.ТС) = Неопределено Тогда
								МассивВагЕвросиб.Добавить(Стр.ТС);
							КонецЕсли;
						КонецЦикла;
						Если МассивВагЕвросиб.Количество()>0 Тогда
							МассивПодходящихВагонов.Добавить(МассивВагЕвросиб);
						КонецЕсли;
					КонецЕсли;
					
				// 21. Проверка либо Вагоны Евросиб Не Требуются либо Собственность из выбранного значения
				ИначеЕсли ВыборкаДетальныеЗаписи.ТипДополнительногоУсловия = Справочники.ТипДополнительногоУсловия.ВагоныЕвросибНеТребуютсяИлиСобственность Тогда
					
					УсловиеВыполняетсяИЛИ = Истина;
					
					МассивВагЕвросиб = Новый Массив;
					
					// 21.1 НЕ требуются вагоны евросиба
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ
					               |	СделкаРейсы.Рейс.ТребуютсяВагоныЕС КАК РейсТребуютсяВагоныЕС
					               |ИЗ
					               |	Документ.Операция КАК Операция
					               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.Рейсы КАК СделкаРейсы
					               |		ПО Операция.Сделка = СделкаРейсы.Ссылка
					               |ГДЕ
					               |	Операция.Ссылка = &Ссылка
					               |	И НЕ СделкаРейсы.Рейс.ТребуютсяВагоныЕС";
					Запрос.УстановитьПараметр("Ссылка",Ссылка);
					
					ТЗ = Запрос.Выполнить().Выгрузить();
					Если ТЗ.Количество() = 0 Тогда
						УсловиеВыполняетсяИЛИ = Ложь;
					Иначе
						Для Каждого Стр Из Грузы Цикл
							Если НЕ ЗначениеЗаполнено(Стр.ТС) Тогда
								Продолжить;
							КонецЕсли;
							Если МассивВагЕвросиб.Найти(Стр.ТС) = Неопределено Тогда
								МассивВагЕвросиб.Добавить(Стр.ТС);
							КонецЕсли;
						КонецЦикла;
						
						Если МассивВагЕвросиб.Количество()>0 Тогда
							МассивПодходящихВагонов.Добавить(МассивВагЕвросиб);
						КонецЕсли;
					КонецЕсли;
					
					// этот запрос выполняем только если предыдущий не выдал ничего
					Если УсловиеВыполняетсяИЛИ = Ложь Тогда
						Запрос = Новый Запрос;
						Запрос.Текст = "ВЫБРАТЬ
						               |	ОперацияГрузы.ТС КАК ТС
						               |ПОМЕСТИТЬ ВТ
						               |ИЗ
						               |	Документ.Операция.Грузы КАК ОперацияГрузы
						               |ГДЕ
						               |	ОперацияГрузы.Ссылка = &Ссылка
						               |	И НЕ ОперацияГрузы.ТС = ЗНАЧЕНИЕ(Справочник.ТС.ПустаяСсылка)
						               |;
						               |
						               |////////////////////////////////////////////////////////////////////////////////
						               |ВЫБРАТЬ
						               |	ВЫБОР
						               |			КОГДА ПризнакСобственностиВагонаСрезПоследних.ПризнакСобственности В (&ПризнакСобственности)
						               |				ТОГДА 1
						               |			ИНАЧЕ 0
						               |		КОНЕЦ КАК СобственностьВСписке,
						               |	ВЫБОР
						               |			КОГДА НЕ ПризнакСобственностиВагонаСрезПоследних.ПризнакСобственности В (&ПризнакСобственности)
						               |				ТОГДА 1
						               |			ИНАЧЕ 0
						               |		КОНЕЦ КАК СобственностьНеВСписке,
						               |	ПризнакСобственностиВагонаСрезПоследних.Вагон КАК Вагон
						               |ИЗ
						               |	РегистрСведений.ПризнакСобственностиВагона.СрезПоследних(&Период, ) КАК ПризнакСобственностиВагонаСрезПоследних
						               |ГДЕ
						               |	ПризнакСобственностиВагонаСрезПоследних.Вагон В
						               |			(ВЫБРАТЬ
						               |				ВТ.ТС
						               |			ИЗ
						               |				ВТ КАК ВТ)";
						Запрос.УстановитьПараметр("Ссылка",Ссылка);
						// период собственности берем в зависимости от содержимого массива моментов времени
						Если МассивМоментовВремени.Найти(Перечисления.ТипМоментаВремени.ДоНачалаОперации) ИЛИ
							МассивМоментовВремени.Найти(Перечисления.ТипМоментаВремени.ПослеНачалаОперации) Тогда 
							ПериодСобственности = ?(ЗначениеЗаполнено(Ссылка.ДатаОтправленияФакт),Ссылка.ДатаОтправленияФакт,Ссылка.ДатаОтправления);
						ИначеЕсли МассивМоментовВремени.Найти(Перечисления.ТипМоментаВремени.ПослеОкончанияОперации) ИЛИ
							МассивМоментовВремени.Найти(Перечисления.ТипМоментаВремени.ДоОкончанияОперации) Тогда 
							ПериодСобственности = ?(ЗначениеЗаполнено(Ссылка.ДатаНазначенияФакт),Ссылка.ДатаНазначенияФакт,Ссылка.ДатаНазначения);
						КонецЕсли;	
						Запрос.УстановитьПараметр("Период",ПериодСобственности);
						Запрос.УстановитьПараметр("ПризнакСобственности",МассивДанныхДляОтбора);
						ТЗ = Запрос.Выполнить().Выгрузить();
						Если ТЗ.Количество() = 0 Тогда
							УсловиеВыполняется = Ложь;
							Прервать;
						Иначе
							// для учета данного условия 
							// отбор по результату запроса должен вернуть колво строк > 0
							МассивВагСобственность = Новый Массив;
							
							Если (ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.ВСписке ИЛИ
								ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.Равно) Тогда
								ПараметрыОтбора1 = Новый Структура;
								ПараметрыОтбора1.Вставить("СобственностьВСписке",1);
								НайденныеСтр = ТЗ.НайтиСтроки(ПараметрыОтбора1);
								Если НайденныеСтр.Количество() = 0 Тогда
									УсловиеВыполняется = Ложь;
									Прервать;
								Иначе
									Для Каждого Стр Из ТЗ Цикл
										Если МассивВагСобственность.Найти(Стр.Вагон) = Неопределено Тогда
											МассивВагСобственность.Добавить(Стр.Вагон);
										КонецЕсли;
									КонецЦикла;
								КонецЕсли;

							ИначеЕсли (ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.НеВСписке ИЛИ
								ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.НеРавно) Тогда 
								ПараметрыОтбора1 = Новый Структура;
								ПараметрыОтбора1.Вставить("СобственностьНеВСписке",1);
								НайденныеСтр = ТЗ.НайтиСтроки(ПараметрыОтбора1);
								Если НайденныеСтр.Количество() = 0 Тогда
									УсловиеВыполняется = Ложь;
									Прервать;
								Иначе
									Для Каждого Стр Из ТЗ Цикл
										Если МассивВагСобственность.Найти(Стр.Вагон) = Неопределено Тогда
											МассивВагСобственность.Добавить(Стр.Вагон);
										КонецЕсли;
									КонецЦикла;
								КонецЕсли;
							КонецЕсли;
							
							Если МассивВагСобственность.Количество()>0 Тогда
								МассивПодходящихВагонов.Добавить(МассивВагСобственность);
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					
				// 22. Проверка, чтобы в операции пункт отправления ИЛИ пункт назначения (в зависимости от момента времени) 
				// были или нет в списке
				ИначеЕсли ВыборкаДетальныеЗаписи.ТипДополнительногоУсловия = Справочники.ТипДополнительногоУсловия.ЛокацияОперации Тогда
					Если МассивМоментовВремени.Найти(Перечисления.ТипМоментаВремени.ДоНачалаОперации) ИЛИ
						МассивМоментовВремени.Найти(Перечисления.ТипМоментаВремени.ПослеНачалаОперации) Тогда 
						ЛокацияОперации = ПунктОтправления;
					ИначеЕсли МассивМоментовВремени.Найти(Перечисления.ТипМоментаВремени.ПослеОкончанияОперации) ИЛИ
						МассивМоментовВремени.Найти(Перечисления.ТипМоментаВремени.ДоОкончанияОперации) Тогда 
						ЛокацияОперации = ПунктНазначения;
					КонецЕсли;	

					ЛокацияОперацииИерархМассив = Локации_сервер.ПолучитьМассивРодителей(ЛокацияОперации,Истина);
					
					ЛокацияНайдена = Ложь;
					Для Каждого СтрУсл Из ТаблицаЗначенийУсловий Цикл
						Если НЕ ЛокацияОперацииИерархМассив.Найти(СтрУсл.ЗначениеДляОтбора) = Неопределено Тогда
							ЛокацияНайдена = Истина;
						КонецЕсли;
						Если (ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.ВСписке ИЛИ
							ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.Равно) И
							ЛокацияНайдена = Ложь Тогда
							УсловиеВыполняется = Ложь;
							Прервать;
						ИначеЕсли (ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.НеВСписке ИЛИ
							ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.НеРавно) И
							ЛокацияНайдена = Истина Тогда
							УсловиеВыполняется = Ложь;
							Прервать;
						КонецЕсли;
					КонецЦикла;
							
				// 23. Проверка, чтобы в операции исполнитель (поставщик) был из или НЕ из списка
				ИначеЕсли ВыборкаДетальныеЗаписи.ТипДополнительногоУсловия = Справочники.ТипДополнительногоУсловия.Исполнитель Тогда
					
					ИсполнительНайден = Ложь;
					Для Каждого СтрУсл Из ТаблицаЗначенийУсловий Цикл
						Если Ссылка.Поставщик = СтрУсл.ЗначениеДляОтбора Тогда
							ИсполнительНайден = Истина;
						КонецЕсли;
						Если (ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.ВСписке ИЛИ
							ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.Равно) И
							ИсполнительНайден = Ложь Тогда
							УсловиеВыполняется = Ложь;
							Прервать;
						ИначеЕсли (ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.НеВСписке ИЛИ
							ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.НеРавно) И
							ИсполнительНайден = Истина Тогда
							УсловиеВыполняется = Ложь;
							Прервать;
						КонецЕсли;
					КонецЦикла;
							

					
					
					
				///////////////////////////////////////////////////////
				///////////////////////////////////////////////////////
				///////////////////////////////////////////////////////
					
				Иначе
					
					УсловиеВыполняется = Ложь;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Если УсловиеВыполняется = Истина Тогда
				// собираем все задачи, которые нужно отправить другим менеджерам по данному ГУИД
				Для Каждого ЭлемМ Из МассивДругихЗадач Цикл
					СтруктураМенеджеру = Новый Структура;
					СтруктураМенеджеру.Вставить("Операция",ЭлемМ);
					СтруктураМенеджеру.Вставить("ГУИД",ВыборкаГУИД.ГУИД);
				КонецЦикла;
				
				Если НЕ СтруктураМенеджеру = Неопределено Тогда
					ОтправитьДругомуМенеджеру.Добавить(СтруктураМенеджеру);
					СтруктураМенеджеру = Неопределено;
				КонецЕсли;
				
				МассивГУИДПодходящихСтрок.Добавить(ВыборкаГУИД.ГУИД);
				
				////// ????????????????????????????
				// если выставлен флаг "УчитыватьДляВсейОперации" и для одной из операций все проверки пройдены успешно 
				// ("УсловиеВыполняется = Истина"), то цикл прохода по всем операциям ТСх надо прервать.
				Если УчитыватьДляВсейОперации Тогда
					Прервать;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	

	
	ВнесениеДанныхВРСОперативныеЗадачи(МассивГУИДПодходящихСтрок,ОтправитьДругомуМенеджеру,МассивМоментовВремени,ИзначальнаяСсылкаНаОперацию,Ссылка,ДатаРегистрацииЗаявки,ИмяТбл,ДокументОснование,ДатаОтсчетаИзДругойОперации,ДниРасчета,МассивПодходящихВагонов,МассивПодходящихКТК,ТаблицаВыполненныхЗадач);
	
	
КонецПроцедуры

Процедура ВнесениеДанныхВРСОперативныеЗадачи(МассивГУИДПодходящихСтрок,ОтправитьДругомуМенеджеру,МассивМоментовВремени,Ссылка,ОперацияПричина,ДатаРегистрацииЗаявки,ИмяТбл,ДокументОснование,ДатаОтсчетаИзДругойОперации,ДниРасчета,МассивПодходящихВагонов,МассивПодходящихКТК,ТаблицаВыполненныхЗадач)
	
	Грузы = Ссылка.Грузы;
	ПунктОтправления = Ссылка.ПунктОтправления;
	ПунктНазначения = Ссылка.ПунктНазначения;

	
	Для Каждого Элем Из МассивГУИДПодходящихСтрок Цикл
		// если данное сообщение должно быть отправлено по предыдущей или следующей операции,
		// получить эту операцию из массива структур
		
		ДругаяОперация = Неопределено;
		
		Для Каждого ЭМ Из ОтправитьДругомуМенеджеру Цикл
			Если ЭМ.ГУИД = Элем Тогда
				ДругаяОперация = ЭМ.Операция;
			Иначе
				ДругаяОперация = Неопределено;
			КонецЕсли;
		КонецЦикла;
		
	
		Если НЕ МассивМоментовВремени.Найти(Перечисления.ТипМоментаВремени.ПриРегистрацииКлиентскойЗаявки) = Неопределено Тогда
			ДатаОтсчета = ДатаРегистрацииЗаявки;
		ИначеЕсли НЕ МассивМоментовВремени.Найти(Перечисления.ТипМоментаВремени.ДоНачалаОперации) = Неопределено ИЛИ
			НЕ МассивМоментовВремени.Найти(Перечисления.ТипМоментаВремени.ПослеНачалаОперации) = Неопределено Тогда
			ДатаОтсчета = ?(ЗначениеЗаполнено(Ссылка.ДатаОтправленияФакт),Ссылка.ДатаОтправленияФакт,Ссылка.ДатаОтправления);
		ИначеЕсли НЕ МассивМоментовВремени.Найти(Перечисления.ТипМоментаВремени.ПослеОкончанияОперации) = Неопределено ИЛИ
			НЕ МассивМоментовВремени.Найти(Перечисления.ТипМоментаВремени.ДоОкончанияОперации) = Неопределено Тогда
			ДатаОтсчета = ?(ЗначениеЗаполнено(Ссылка.ДатаНазначенияФакт),Ссылка.ДатаНазначенияФакт,Ссылка.ДатаНазначения);
		КонецЕсли;
		
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ГУИД",Элем);
		НайденныеДокументы = Ссылка.Услуга[ИмяТбл].НайтиСтроки(ПараметрыОтбора);
		
		ПорядокТребованияДокументов = НайденныеДокументы[0].ПорядокТребованияДокументов;
		НазначениеМаршрута = НайденныеДокументы[0].НазначениеМаршрута;
		Если ИмяТбл = "ПостановкаЗадач" Тогда
			ОбластьПрименения = Перечисления.ОбластьПрименения.Задачи;
		Иначе
			ОбластьПрименения = Перечисления.ОбластьПрименения.Документы;
		КонецЕсли;
		
		// поиск ответственных по региону в зависимости от момента времени, по которому устанавливается требование документа
		Если ОбластьПрименения = Перечисления.ОбластьПрименения.Задачи Тогда
			Регион = Справочники.Локации.ВСЕ;
		Иначе
			Если НЕ МассивМоментовВремени.Найти(Перечисления.ТипМоментаВремени.ПослеОкончанияОперации) = Неопределено ИЛИ
				НЕ МассивМоментовВремени.Найти(Перечисления.ТипМоментаВремени.ДоОкончанияОперации) = Неопределено Тогда
				Регион = Локации_сервер.ПолучитьМассивРодителей(ПунктНазначения,Истина);
			Иначе
				Регион = Локации_сервер.ПолучитьМассивРодителей(ПунктОтправления,Истина);
			КонецЕсли;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ОтветственныеПоТребуемымДокументам.Исполнитель КАК Исполнитель,
		               |	ОтветственныеПоТребуемымДокументам.Наблюдатель КАК Наблюдатель
		               |ИЗ
		               |	РегистрСведений.ОтветственныеПоТребуемымДокументам КАК ОтветственныеПоТребуемымДокументам
		               |ГДЕ
		               |	ОтветственныеПоТребуемымДокументам.ВидОперации = &ВидОперации
		               |	И ОтветственныеПоТребуемымДокументам.ЗадачаДляОтдела = &ЗадачаДляОтдела
		               |	И ОтветственныеПоТребуемымДокументам.ОбластьПрименения = &ОбластьПрименения
		               |	И ОтветственныеПоТребуемымДокументам.Регион В ИЕРАРХИИ (&Регион)";
		Запрос.УстановитьПараметр("ВидОперации",Ссылка.Услуга);
		Запрос.УстановитьПараметр("Регион",Регион);
		Запрос.УстановитьПараметр("ОбластьПрименения",ОбластьПрименения);
		Запрос.УстановитьПараметр("ЗадачаДляОтдела",НазначениеМаршрута);
		ТЗ = Запрос.Выполнить().Выгрузить();
		
		// цикл по всем участникам, которым нужно создать задачи
		Для Каждого Стр Из ТЗ Цикл
			// в зависимости от значения "ПорядокТребованияДокументов" делаем 
			// а) 1 цикл для операции
			// б) циклы по таблице Грузы для вагонов
			// в) циклы по таблице Грузы для контейнеров
			
			КолвоИтераций = ПолучитьЧислоЦиклов(Грузы,ПорядокТребованияДокументов,МассивПодходящихВагонов,МассивПодходящихКТК);
			
			Для Каждого ИТ Из КолвоИтераций Цикл
				
				МЗ = РегистрыСведений.ОперативныеЗадачи.СоздатьМенеджерЗаписи();
				МЗ.Документ = ?(ДругаяОперация = Неопределено,Ссылка,ДругаяОперация);
				МЗ.Задача = НайденныеДокументы[0].НаименованиеЗадачиСпециалисту;
				ЗаполнитьЗначенияСвойств(МЗ,Стр);
				
				МЗ.ДокументОснование = ДокументОснование;
				МЗ.ОперацияПричина = ОперацияПричина;
				МЗ.ОбластьПрименения = ОбластьПрименения;
				// в зависимости от того, какие данные содержатся в массиве КолвоИтераций, заполняем
				// измерения Вагон или Контейнер. или, если там число, не заполняем ничего
				Если ТипЗнч(ИТ) = Тип("СправочникСсылка.ТС") Тогда
					МЗ.Вагон = ИТ;
				ИначеЕсли ТипЗнч(ИТ) = Тип("СправочникСсылка.ТЕ") Тогда
					МЗ.Контейнер = ИТ;
				КонецЕсли;
				
				Если ИмяТбл = "ТребуемыеДокументы" Тогда
					МЗ.ВидДокумента = НайденныеДокументы[0].ВидДокумента;
				Иначе
					МЗ.ТипОбъектаСистемы = НайденныеДокументы[0].ТипОбъектаСистемы;
				КонецЕсли;
				
				ДатаОтсчета = ?(ДатаОтсчетаИзДругойОперации = Неопределено,ДатаОтсчета,ДатаОтсчетаИзДругойОперации);
				
				ЖелтыйПорог = НайденныеДокументы[0].ЖелтыйПорог;
				КрасныйПорог = НайденныеДокументы[0].КрасныйПорог;
								
				ЖелтыйПорог = НайденныеДокументы[0].ЖелтыйПорог;
				КрасныйПорог = НайденныеДокументы[0].КрасныйПорог;
				Если ДниРасчета = Перечисления.ЕдиницыИзмеренияВДнях.РабочиеДни Тогда
					Если НайденныеДокументы[0].МоментВремени = Перечисления.ТипМоментаВремени.ДоНачалаОперации ИЛИ
						НайденныеДокументы[0].МоментВремени = Перечисления.ТипМоментаВремени.ДоОкончанияОперации  Тогда
						СтруктураКолваДней = РасчетКоличестваДнейПоПпроизводственномуКалендарю(ДатаОтсчета,ЖелтыйПорог,КрасныйПорог,-1,Ссылка);
					Иначе
						СтруктураКолваДней = РасчетКоличестваДнейПоПпроизводственномуКалендарю(ДатаОтсчета,ЖелтыйПорог,КрасныйПорог,1,Ссылка);
					КонецЕсли;
					ЖелтыйПорог = СтруктураКолваДней.ЖелтыйПорог;
					КрасныйПорог = СтруктураКолваДней.КрасныйПорог;
				КонецЕсли;
					
				Если НайденныеДокументы[0].МоментВремени = Перечисления.ТипМоментаВремени.ДоНачалаОперации ИЛИ
					НайденныеДокументы[0].МоментВремени = Перечисления.ТипМоментаВремени.ДоОкончанияОперации  Тогда
					МЗ.НачалоЖелтыйПорог = ДатаОтсчета - ЖелтыйПорог*3600*24;
					МЗ.ОкончаниеЖелтыйПорог = ДатаОтсчета - КрасныйПорог *3600*24;
					МЗ.НачалоКрасныйПорог = ДатаОтсчета - КрасныйПорог *3600*24;
					МЗ.ОкончаниеКрасныйПорог = ДатаОтсчета;
				Иначе
					МЗ.НачалоЖелтыйПорог = ДатаОтсчета;
					МЗ.ОкончаниеЖелтыйПорог = ДатаОтсчета + ЖелтыйПорог *3600*24;
					МЗ.НачалоКрасныйПорог = ДатаОтсчета + ЖелтыйПорог *3600*24;
					МЗ.ОкончаниеКрасныйПорог = ДатаОтсчета + КрасныйПорог *3600*24;
				КонецЕсли;
				
				МЗ2 = РегистрыСведений.ОперативныеЗадачи.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(МЗ2, МЗ);
				
				МЗ.Прочитать();
				
				
				Если НЕ МЗ.Выбран() Тогда
					ЗаполнитьЗначенияСвойств(МЗ, МЗ2);
				КонецЕсли;
				
				// если в таблице ТаблицаВыполненныхЗадач есть данные, то заполнить ими статус и дату
				Если НЕ ТаблицаВыполненныхЗадач = Неопределено Тогда
					ПараметрыОтбора123 = Новый Структура;
					ПараметрыОтбора123.Вставить("ВидДокумента",НайденныеДокументы[0].ВидДокумента);
					ПараметрыОтбора123.Вставить("Учтено",ЛОЖЬ);
					НайденныеСтроки123 = ТаблицаВыполненныхЗадач.НайтиСтроки(ПараметрыОтбора123);
					Если НайденныеСтроки123.Количество()>0 Тогда
						МЗ.Статус = Перечисления.СтатусыЭтапов.Выполнен;
						МЗ.ДатаВыполнения = НайденныеСтроки123[0].ДатаВыполнения;
						НайденныеСтроки123[0].Учтено = Истина;
					Иначе
						МЗ.Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
					КонецЕсли;
				ИначеЕсли НЕ ЗначениеЗаполнено(МЗ.Статус) Тогда
					МЗ.Статус = Перечисления.СтатусыЭтапов.НаВыполнение;					
				КонецЕсли;
					
				МЗ.Записать();
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
КонецПроцедуры

ФУнкция РасчетКоличестваДнейПоПпроизводственномуКалендарю(ДатаНачалаРасчета,ЖелтыйПорог,КрасныйПорог,ИндексРасчета,Ссылка)
	
	СтруктураКолваДней = Новый Структура;
	СтруктураКолваДней.Вставить("ЖелтыйПорог",ЖелтыйПорог);
	СтруктураКолваДней.Вставить("КрасныйПорог",КрасныйПорог);
	
	ПрКалендарь = ПостроительТСх_сервер.ПодобратьПроизводственныйКалендарь(Ссылка.Поставщик, Ссылка.Услуга);
	
	Если ИндексРасчета > 0 Тогда
		ТекстПервогоЗапроса = "ВЫБРАТЬ
				               |	ДанныеПроизводственногоКалендаря.ПроизводственныйКалендарь КАК ПроизводственныйКалендарь,
				               |	ВЫБОР
				               |		КОГДА ДанныеПроизводственногоКалендаря.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Рабочий)
				               |			ИЛИ ДанныеПроизводственногоКалендаря.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Предпраздничный)
				               |			ТОГДА 1
				               |		ИНАЧЕ 0
				               |	КОНЕЦ КАК РабочийДень,
				               |	ДанныеПроизводственногоКалендаря.Дата КАК Дата
				               |ПОМЕСТИТЬ Вт1
				               |ИЗ
				               |	РегистрСведений.ДанныеПроизводственногоКалендаря КАК ДанныеПроизводственногоКалендаря
				               |ГДЕ
				               |	ДанныеПроизводственногоКалендаря.ПроизводственныйКалендарь = &ПроизводственныйКалендарь
				               |	И ДанныеПроизводственногоКалендаря.Дата >= &ДатаНач";
	Иначе
		ТекстПервогоЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 365
		                      |	ДанныеПроизводственногоКалендаря.ПроизводственныйКалендарь КАК ПроизводственныйКалендарь,
		                      |	ВЫБОР
		                      |		КОГДА ДанныеПроизводственногоКалендаря.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Рабочий)
		                      |				ИЛИ ДанныеПроизводственногоКалендаря.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Предпраздничный)
		                      |			ТОГДА 1
		                      |		ИНАЧЕ 0
		                      |	КОНЕЦ КАК РабочийДень,
		                      |	ДанныеПроизводственногоКалендаря.Дата КАК Дата
		                      |ПОМЕСТИТЬ Вт1
				              |ИЗ
		                      |	РегистрСведений.ДанныеПроизводственногоКалендаря КАК ДанныеПроизводственногоКалендаря
		                      |ГДЕ
		                      |	ДанныеПроизводственногоКалендаря.ПроизводственныйКалендарь = &ПроизводственныйКалендарь
		                      |	И ДанныеПроизводственногоКалендаря.Дата <= &ДатаНач
		                      |	И ДанныеПроизводственногоКалендаря.Дата >= &ДатаГодНазад
		                      |
		                      |УПОРЯДОЧИТЬ ПО
		                      |	ПроизводственныйКалендарь,
		                      |	Дата УБЫВ";
	КонецЕсли;
	
	КолвоПервыйЖелтый = "ПЕРВЫЕ " + ЖелтыйПорог;
	КолвоПервыйКрасный = "ПЕРВЫЕ " + КрасныйПорог;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "" + ТекстПервогоЗапроса + "
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ " + КолвоПервыйЖелтый + "
	               |	Вт1.ПроизводственныйКалендарь КАК ПроизводственныйКалендарь,
	               |	Вт1.РабочийДень КАК РабочийДень,
	               |	Вт1.Дата КАК Дата
	               |ПОМЕСТИТЬ ЖелтыйПорог
	               |ИЗ
	               |	Вт1 КАК Вт1
	               |ГДЕ
	               |	Вт1.РабочийДень <> 0
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ " + КолвоПервыйКрасный + "
	               |	Вт1.ПроизводственныйКалендарь КАК ПроизводственныйКалендарь,
	               |	Вт1.РабочийДень КАК РабочийДень,
	               |	Вт1.Дата КАК Дата
	               |ПОМЕСТИТЬ КрасныйПорог
	               |ИЗ
	               |	Вт1 КАК Вт1
	               |ГДЕ
	               |	Вт1.РабочийДень <> 0
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЖелтыйПорог.Дата КАК Дата,
	               |	""Желтый"" КАК Порог
	               |ИЗ
	               |	ЖелтыйПорог КАК ЖелтыйПорог
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	КрасныйПорог.Дата,
	               |	""Красный""
	               |ИЗ
	               |	КрасныйПорог КАК КрасныйПорог
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Порог,
	               |	Дата";
	Запрос.УстановитьПараметр("ПроизводственныйКалендарь",ПрКалендарь);
	Запрос.УстановитьПараметр("ДатаНач",ДатаНачалаРасчета);
	Если ИндексРасчета < 0 Тогда
		Запрос.УстановитьПараметр("ДатаГодНазад",ДатаНачалаРасчета-3600*24*365);
	КонецЕсли;
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Порог","Желтый");
	НайденныеСтр = ТЗ.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтр.Количество()>0 Тогда
		НачальнаяДатаЖелтая = НайденныеСтр[0].Дата;
		// если прямой расчет (т.е. считаем ПОСЛЕ даты начала или окончания перевозки), 
		// то конечная дата берется из запроса. если расчет обратный (т.е. считаем ДО начала или окончания операции),
		// то берем дату из входных параметров функции "ДатаНачалаРасчета"
		КонечнаяДатаЖелтая = ?(ИндексРасчета = 1,НайденныеСтр[НайденныеСтр.Количество()-1].Дата,ДатаНачалаРасчета);
		ДельтаВРабочихДняхЖелтый =(НачалоДня(КонечнаяДатаЖелтая)-НачалоДня(НачальнаяДатаЖелтая))/3600/24;
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Порог","Красный");
	НайденныеСтр = ТЗ.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтр.Количество()>0 Тогда
		НачальнаяДатаКрасная = НайденныеСтр[0].Дата;
		// если прямой расчет (т.е. считаем ПОСЛЕ даты начала или окончания перевозки), 
		// то конечная дата берется из запроса. если расчет обратный (т.е. считаем ДО начала или окончания операции),
		// то берем дату из входных параметров функции "ДатаНачалаРасчета"
		КонечнаяДатаКрасная = ?(ИндексРасчета = 1,НайденныеСтр[НайденныеСтр.Количество()-1].Дата,ДатаНачалаРасчета);
		ДельтаВРабочихДняхКрасный = (НачалоДня(КонечнаяДатаКрасная)-НачалоДня(НачальнаяДатаКрасная))/3600/24;
	КонецЕсли;
	
	СтруктураКолваДней.Вставить("ЖелтыйПорог",ДельтаВРабочихДняхЖелтый);
	СтруктураКолваДней.Вставить("КрасныйПорог",ДельтаВРабочихДняхКрасный);
	
	
	Возврат СтруктураКолваДней;
	
КонецФункции

Функция ПолучитьКалькуляцииПоОперации(Ссылка)
	
	МассивКалькуляций = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	СделкаСвязьУчетныхЕдиниц.Калькуляция КАК Калькуляция
	               |ИЗ
	               |	Документ.Операция.Грузы КАК ОперацияГрузы
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	               |		ПО (ОперацияГрузы.ТЕ = СделкаСвязьУчетныхЕдиниц.Контейнер
	               |					И НЕ ОперацияГрузы.ТЕ = ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
	               |				ИЛИ ОперацияГрузы.ТС = СделкаСвязьУчетныхЕдиниц.Вагон
	               |					И НЕ ОперацияГрузы.ТС = ЗНАЧЕНИЕ(Справочник.ТС.ПустаяСсылка))
	               |			И ОперацияГрузы.Ссылка.Сделка = СделкаСвязьУчетныхЕдиниц.Ссылка
	               |ГДЕ
	               |	ОперацияГрузы.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	МассивКалькуляций = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Калькуляция");
	
	Возврат МассивКалькуляций;
	
КонецФункции

Функция ПолучитьКлиентовПоОперации(Ссылка)
	
	МассивКклиентов = Новый Массив;
	
