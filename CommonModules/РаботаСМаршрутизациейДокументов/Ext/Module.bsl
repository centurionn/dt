КонецФункции

Функция ПолучитьМассивРодителей(ССылка,ИщемРодителей,КолвоРодителей) Экспорт
	
	Результат = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(ССылка) Тогда 
		Возврат Результат; 
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТехнологическаяСхемаТЧ.Ссылка КАК Ссылка,
	               |	ТехнологическаяСхемаТЧ.ГУИД КАК ГУИД
	               |ПОМЕСТИТЬ ВТ
	               |ИЗ
	               |	Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
	               |ГДЕ
	               |	ТехнологическаяСхемаТЧ.Операция = &Операция
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТехнологическаяСхемаТЧ.Ссылка КАК Ссылка,
	               |	ТехнологическаяСхемаТЧ.ГУИД КАК ГУИД,
	               |	ТехнологическаяСхемаТЧ.Родитель1 КАК Родитель1,
	               |	ТехнологическаяСхемаТЧ.Родитель2 КАК Родитель2,
	               |	ТехнологическаяСхемаТЧ.Родитель3 КАК Родитель3,
	               |	ТехнологическаяСхемаТЧ.Родитель4 КАК Родитель4,
	               |	ТехнологическаяСхемаТЧ.Родитель5 КАК Родитель5,
	               |	ВЫБОР
	               |		КОГДА ТехнологическаяСхемаТЧ.ГУИД = ВТ.ГУИД
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ТекОперация,
	               |	ВЫБОР
	               |		КОГДА ТехнологическаяСхемаТЧ.ГУИД = ВТ.ГУИД
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК НадоПроверить,
	               |	ЛОЖЬ КАК Проверено
	               |ИЗ
	               |	ВТ КАК ВТ
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
	               |		ПО ВТ.Ссылка = ТехнологическаяСхемаТЧ.Ссылка";
	
	Запрос.УстановитьПараметр("Операция",Ссылка);
	ТЗ = Запрос.Выполнить().Выгрузить();
	ПараметрыОтбора = Новый СТруктура;
	ПараметрыОтбора.Вставить("ТекОперация",Истина);
	НайденнаяОпер = ТЗ.НайтиСтроки(ПараметрыОтбора);
		
	//СтруктураСтроки = Общегоназначения.СтрокаТаблицыЗначенийВСтруктуру(НайденнаяОпер[0]);
	
	Если ИщемРодителей и НайденнаяОпер.Количество() > 0 Тогда
		РекурсивныйПоискРодителей(НайденнаяОпер[0],Результат,ТЗ,КолвоРодителей);
	ИначеЕсли НайденнаяОпер.Количество() > 0 Тогда
		РекурсивныйПоискПодчиненных(НайденнаяОпер[0],Результат,ТЗ,КолвоРодителей);
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

Процедура РекурсивныйПоискРодителей(НайденнаяОпер,Результат,ТблСхемы,КолвоРекурсий)
	
	Для Сч = 1 По 5 Цикл
		
		Попытка
			ТекРодитель = НайденнаяОпер[Строка("Родитель") + Строка(Сч)];
			Если ЗначениеЗаполнено(ТекРодитель) Тогда
				Результат.Добавить(ТекРодитель);
				// устанавливаем в таблице флаг, что данный ГУИД надо проверить. но только в том случае, если его еще не проверяли
				ПроверяемыйГУИД = НайденнаяОпер.ГУИД;
				ПараметрыОтбора = Новый СТруктура;
				ПараметрыОтбора.Вставить("ГУИД",ПроверяемыйГУИД);
				ПараметрыОтбора.Вставить("Проверено",Ложь);
				ТекСтрока = ТблСхемы.НайтиСтроки(ПараметрыОтбора);
				ТекСтрока[0].НадоПроверить = Истина;
			КонецЕсли;
		Исключение
			НетЭл = Истина;
		КонецПопытки;
		
	КонецЦикла;
	
	// после того, как текущую строку проверили, установить ей флаг "проверено" и снять флаг "нужно проверить"
	ПроверяемыйГУИД = НайденнаяОпер.ГУИД;
	ПараметрыОтбора = Новый СТруктура;
	ПараметрыОтбора.Вставить("ГУИД",ПроверяемыйГУИД);
	ТекСтрока = ТблСхемы.НайтиСтроки(ПараметрыОтбора);
	ТекСтрока[0].НадоПроверить = Ложь;
	ТекСтрока[0].Проверено = Истина;
	
	// выходим из функции в том случае, если в сканируемой таблице нет больше ни одной строки с флагом "надо проверить"
	ПараметрыОТбора = Новый СТруктура;
	ПараметрыОТбора.Вставить("НадоПроверить",Истина);
	НайденныеСтрокиПров = ТблСхемы.НайтиСтроки(ПараметрыОТбора);
	Если НайденныеСтрокиПров.Количество()>0 И КолвоРекурсий = Неопределено Тогда
		РекурсивныйПоискРодителей(НайденныеСтрокиПров[0],Результат,ТблСхемы,КолвоРекурсий);
	Иначе
		ВсеПроверили = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура РекурсивныйПоискПодчиненных(НайденнаяОпер,Результат,ТблСхемы,КолвоРекурсий)
	
	ПроверяемыйГУИД = НайденнаяОпер.ГУИД;
	
	Для Сч = 1 По 5 Цикл
		
		ПараметрыОтбора = Новый СТруктура;
		ПараметрыОтбора.Вставить(Строка("Родитель") + Строка(Сч),ПроверяемыйГУИД);
		ПараметрыОтбора.Вставить("Проверено",Ложь);
		ТекСтрока = ТблСхемы.НайтиСтроки(ПараметрыОтбора);
		Если ТекСтрока.Количество()>0 Тогда
			Результат.Добавить(ТекСтрока[0].ГУИД);
			// устанавливаем в таблице флаг, что данный ГУИД надо проверить. но только в том случае, если его еще не проверяли
			ТекСтрока[0].НадоПроверить = Истина;
		КонецЕсли;
	КонецЦикла;
	
	// после проверки этой строки (что она есть в родителях у других строк),
	// установить ей флаг "проверено" и снять флаг "надо проверить"
	ПараметрыОтбора = Новый СТруктура;
	ПараметрыОтбора.Вставить("ГУИД",ПроверяемыйГУИД);
	ТекСтрока = ТблСхемы.НайтиСтроки(ПараметрыОтбора);
	ТекСтрока[0].Проверено = Истина;
	ТекСтрока[0].НадоПроверить = Ложь;
		
	// выходим из функции в том случае, если в сканируемой таблице нет больше ни одной строки с флагом "надо проверить"
	ПараметрыОТбора = Новый СТруктура;
	ПараметрыОТбора.Вставить("НадоПроверить",Истина);
	НайденныеСтрокиПров = ТблСхемы.НайтиСтроки(ПараметрыОТбора);
	Если НайденныеСтрокиПров.Количество()>0 И КолвоРекурсий = Неопределено Тогда
		РекурсивныйПоискПодчиненных(НайденныеСтрокиПров[0],Результат,ТблСхемы,КолвоРекурсий);
	Иначе
		ВсеПроверили = Истина;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьЧислоЦиклов(Грузы,ПорядокТребованияДокументов,МассивПодходящихВагонов,МассивПодходящихКТК)
	
	МассивОтвета = Новый Массив;
	
	Если ПорядокТребованияДокументов = Перечисления.ПорядокТребованияДокументов.НаВсюОперацию Тогда
		МассивОтвета.Добавить(1);
	ИначеЕсли ПорядокТребованияДокументов = Перечисления.ПорядокТребованияДокументов.НаКаждыйВагон Тогда
		// сначала проверяем, есть ли данные в массиве МассивПодходящихВагонов.
		// если массив заполнен, то нужно разобрать его (это массив массивов) для поиска вагонов, 
		// которые есть во всех массивах МассивПодходящихВагонов.
		Если МассивПодходящихВагонов.Количество()>0 Тогда
			// если в массиве всего 1 массив, то разбирать ничего не надо, просто достаем этот массив
			МассивОтвета = ?(МассивПодходящихВагонов.Количество()>1,РазобратьМассивМассивов(МассивПодходящихВагонов),МассивПодходящихВагонов[0]);
		Иначе
			Для Каждого Стр Из Грузы Цикл
				Если ЗначениеЗаполнено(Стр.ТС) Тогда
					// добавляем только уникальные записи
					Если МассивОтвета.Найти(Стр.ТС) = Неопределено Тогда
						МассивОтвета.Добавить(Стр.ТС);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	ИначеЕсли ПорядокТребованияДокументов = Перечисления.ПорядокТребованияДокументов.НаКаждыйКонтейнер Тогда
		// сначала проверяем, есть ли данные в массиве МассивПодходящихКТК.
		// если массив заполнен, то нужно разобрать его (это массив массивов) для поиска КТК, 
		// которые есть во всех массивах МассивПодходящихКТК.
		Если МассивПодходящихКТК.Количество()>0 Тогда
			// если в массиве всего 1 массив, то разбирать ничего не надо, просто достаем этот массив
			МассивОтвета = ?(МассивПодходящихКТК.Количество()>1,РазобратьМассивМассивов(МассивПодходящихКТК),МассивПодходящихКТК[0]);
		Иначе	
			Для Каждого Стр Из Грузы Цикл
				Если ЗначениеЗаполнено(Стр.ТЕ) Тогда
					// добавляем только уникальные записи
					Если МассивОтвета.Найти(Стр.ТЕ) = Неопределено Тогда
						МассивОтвета.Добавить(Стр.ТЕ);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат МассивОтвета;
	
КонецФункции

Функция РазобратьМассивМассивов(МассивМассивов)
	
	МассивПересечений = МассивМассивов[0];
	
	Для ШагЦикла = 1 По МассивМассивов.Количество()-1 Цикл
		
		ПроверяемыйМассив = МассивМассивов[ШагЦикла];
		
		ВременныйМассивСовпавших = Новый Массив;
		
		Для Каждого Элем Из МассивПересечений Цикл
			Если НЕ ПроверяемыйМассив.Найти(Элем) = Неопределено Тогда
				ВременныйМассивСовпавших.Добавить(Элем);
			КонецЕсли;
		КонецЦикла;
		
		МассивПересечений = ВременныйМассивСовпавших;
		
	КонецЦикла;
	
	Возврат МассивПересечений;
	
КонецФункции

Процедура НапомнитьПользователямОЗадачах(Документ) Экспорт
	
	ТаблицаСостояний = Новый Массив;
	Попытка
		ТаблицаСостояний = Документ.Состояния;
	Исключение
		Сообщить("Напоминания для этого документа не поддерживаются, обратитесь в ИТ!");
		Возврат;
	КонецПопытки;
	
	СписокПолучателей = Новый Массив;
	Тема = "!!! Срочное напоминание о документе: " + Документ;
	ТекстПисьма = "Поступила просьба обратить внимание и отработать данный документ в приоритетном режиме:<br><br>";

	ПрефиксНС = Константы["АдресПубликацииИнформационнойБазыВЛокальнойСети"+?(ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована, "Тестовый", "")].Получить() + "#";
	ТекстНС = "<a target=""_blank"" href="""+ПрефиксНС+ПолучитьНавигационнуюСсылку(Документ)+""">"+ПолучитьНавигационнуюСсылку(Документ)+"</a>";
	
	ТекстПисьма = ТекстПисьма + "<b>Документ:</b> " + Документ + "<br><br><b>Список задач:</b><br>"; 
	ТекстПисьма = ТекстПисьма + "<table border=1><tr><td>Задача</td><td>Открыть из письма</td><td>Исполнитель</td><td>Наблюдатель</td></tr>";
	
	Для каждого Стр из ТаблицаСостояний Цикл
		
		Если Стр.Статус <> Перечисления.СтатусыЭтапов.НаВыполнение И Стр.Статус <> Перечисления.СтатусыЭтапов.ВРаботе Тогда Продолжить; КонецЕсли;
		
		Если ТипЗнч(Стр.Исполнитель) = Тип("СправочникСсылка.Пользователи") И СписокПолучателей.Найти(Стр.Исполнитель) = неопределено Тогда
			СписокПолучателей.Добавить(Стр.Исполнитель);
		ИначеЕсли ТипЗнч(Стр.Исполнитель) = Тип("СправочникСсылка.ГруппыПользователей") Тогда
			СписокПользователей = Пользователи_sd_сервер.ПолучитьПользователейГруппы(Стр.Исполнитель, ТекущаяДата(), Истина);
			Для каждого Плз Из СписокПользователей Цикл
				Если СписокПолучателей.Найти(Плз) = неопределено Тогда  СписокПолучателей.Добавить(Плз); КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.Наблюдатель) Тогда
			
			Если ТипЗнч(Стр.Наблюдатель) = Тип("СправочникСсылка.Пользователи") И СписокПолучателей.Найти(Стр.Наблюдатель) = неопределено Тогда
				СписокПолучателей.Добавить(Стр.Наблюдатель);
			ИначеЕсли ТипЗнч(Стр.Наблюдатель) = Тип("СправочникСсылка.ГруппыПользователей") Тогда
				СписокПользователей = Пользователи_sd_сервер.ПолучитьПользователейГруппы(Стр.Наблюдатель, ТекущаяДата(), Истина);
				Для каждого Плз Из СписокПользователей Цикл
					Если СписокПолучателей.Найти(Плз) = неопределено Тогда  СписокПолучателей.Добавить(Плз); КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
		
		ТекстПисьма = ТекстПисьма + "<tr><td>"+Стр.Состояние+"</td><td>"+ТекстНС+"</td><td>"+Стр.Исполнитель+"</td><td>"+Стр.Наблюдатель+"</td></tr>";
		
	КонецЦикла;
	
	
	ТекстПисьма = ТекстПисьма + "</table>";
	ПолучателиСтруктурой = Новый Массив;
	
	Для каждого Стр из СписокПолучателей Цикл
		ЕМЕЙЛ = Пользователи_sd_сервер.ПолучитьEMAILПользователя(Стр);
		Если ЗначениеЗаполнено(ЕМЕЙЛ) Тогда
			ПолучателиСтруктурой.Добавить(Новый Структура("Представление, Адрес", Строка(Стр), ЕМЕЙЛ));
		КонецЕсли;
	КонецЦикла;
	
	ТекПользовательСтруктура = Новый Массив;
	ТекПользовательСсылка = Пользователи.ТекущийПользователь();
	ЕМЕЙЛ = Пользователи_sd_сервер.ПолучитьEMAILПользователя(ТекПользовательСсылка);
		Если ЗначениеЗаполнено(ЕМЕЙЛ) Тогда
			ТекПользовательСтруктура.Добавить(Новый Структура("Представление, Адрес", Строка(ТекПользовательСсылка), ЕМЕЙЛ));
		КонецЕсли;	
	
	// первичная проверка на то, что мы вообще можем что-то отправить
	УчетнаяЗаписьПоУмолчанию = РаботаСПочтовымиСообщениями.ПроверитьСистемнаяУчетнаяЗаписьДоступна();
	Если не УчетнаяЗаписьПоУмолчанию Тогда возврат; КонецЕсли;
	СистемнаяУчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	ПараметрыОтправкиПисьма = новый Структура;
	ПараметрыОтправкиПисьма.Вставить("Тема", Тема);
	ПараметрыОтправкиПисьма.Вставить("Тело", ТекстПисьма);
	ПараметрыОтправкиПисьма.Вставить("ТипТекста", "HTML");
	ПараметрыОтправкиПисьма.Вставить("Кому", ПолучателиСтруктурой);
	ПараметрыОтправкиПисьма.Вставить("Копии", ТекПользовательСтруктура);
	ПараметрыОтправкиПисьма.Вставить("Важность", ВажностьИнтернетПочтовогоСообщения.Наивысшая);
	
	Результат = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(СистемнаяУчетнаяЗапись, ПараметрыОтправкиПисьма);
	
	Сообщить("Сообщение отправлено: " + Результат);
	
КонецПроцедуры
