					               |			ТОГДА 1
					               |		ИНАЧЕ 0
					               |	КОНЕЦ) КАК ПроверяемаяОперацияВСписке,
					               |	СУММА(ВЫБОР
					               |			КОГДА НЕ ТехнологическаяСхемаТЧ.Услуга В (&Услуга)
					               |					И ТехнологическаяСхемаТЧ.Операция В (&ПроверяемаяОперация)
					               |				ТОГДА 1
					               |			ИНАЧЕ 0
					               |		КОНЕЦ) КАК ПроверяемаяОперацияНеВСписке,
					               |	СУММА(1) КАК ВсегоОперацийТсх,
					               |	ТехнологическаяСхемаТЧ.Операция КАК Операция
					               |ИЗ
					               |	ВТ КАК ВТ
					               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
					               |		ПО ВТ.Ссылка = ТехнологическаяСхемаТЧ.Ссылка
					               |ГДЕ
					               |	ТехнологическаяСхемаТЧ.ГУИД В(&ГУИД)
					               |СГРУППИРОВАТЬ ПО
					               |	ТехнологическаяСхемаТЧ.Операция";
					Запрос.УстановитьПараметр("Операция",ИзначальнаяСсылкаНаОперацию);
					Запрос.УстановитьПараметр("ПроверяемаяОперация",Ссылка);
					Запрос.УстановитьПараметр("ГУИД",МассивГУИДПодчиненных);
					Запрос.УстановитьПараметр("Услуга",МассивДанныхДляОтбора);
					ТЗ = Запрос.Выполнить().Выгрузить();
					Если ТЗ.Количество() = 0 Тогда
						УсловиеВыполняется = Ложь;
						Прервать;
					Иначе
						// если мы проверяем конкретную операцию, то нужно проверить поле ПроверяемаяОперацияВСписке/ПроверяемаяОперацияНеВСписке
						// на равенство 0
						Если ВыборкаДетальныеЗаписи.УчитыватьДляВсейОперации Тогда
							Если (ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.ВСписке ИЛИ
								ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.Равно) И 
								ТЗ[0].ПроверяемаяОперацияВСписке = 0 Тогда
								УсловиеВыполняется = Ложь;
								Прервать;
							ИначеЕсли (ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.НеВСписке ИЛИ
								ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.НеРавно) И 
								ТЗ[0].ПроверяемаяОперацияНеВСписке = 0 Тогда
								УсловиеВыполняется = Ложь;
								Прервать;
							КонецЕсли;
						Иначе
							// если вид сравнения равно или в списке, то для учета данного условия 
							// результат запроса должен вернуть ВидОперацииВСписке > 0
							Если (ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.ВСписке ИЛИ
								ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.Равно) И 
								ТЗ[0].ВидОперацииВСписке = 0 Тогда
								УсловиеВыполняется = Ложь;
								Прервать;
							// если вид сравнения НЕ равно или НЕ в списке, то для учета данного условия 
							// результат запроса должен вернуть ВидОперацииНеВСписке > 0
							ИначеЕсли (ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.НеВСписке ИЛИ
								ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.НеРавно) И 
								ТЗ[0].ВидОперацииНеВСписке = 0 Тогда
								УсловиеВыполняется = Ложь;
								Прервать;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					// если условие выполняется, то сохранить инорфмацию об отправке другому менеджеру оповещения о другой операции.
					Если УсловиеВыполняется = Истина Тогда
						МассивДругихЗадач.Добавить(ТЗ[0].Операция);
					КонецЕсли;
		
				// 12. Проверка наличия хотя бы одной калькуляции на наличие или отсутствие услуги
				ИначеЕсли ВыборкаДетальныеЗаписи.ТипДополнительногоУсловия = Справочники.ТипДополнительногоУсловия.УслугаВКалькуляции Тогда
					
					// т.к. из заявок калькуляцию передаем, а из операций нет (Неопределено), 
					// то для наих надо получить массив калькуляций
					Если Калькуляции = Неопределено Тогда
						Калькуляции = ПолучитьКалькуляцииПоОперации(ИзначальнаяСсылкаНаОперацию);
					КонецЕсли;
					
					Если Калькуляции = Неопределено ИЛИ 
						Калькуляции.Количество() = 0 Тогда
					    УсловиеВыполняется = Ложь;
						Прервать;
					КонецЕсли;
					
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ
					               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка КАК Калькуляция,
					               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Услуга КАК Услуга
					               |ПОМЕСТИТЬ ВТ
					               |ИЗ
					               |	Документ.Калькуляция.ММ_КалькуляцияМультимодальнойЦепочки КАК КалькуляцияММ_КалькуляцияМультимодальнойЦепочки
					               |ГДЕ
					               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка В(&Ссылка)
					               |
					               |ОБЪЕДИНИТЬ ВСЕ
					               |
					               |ВЫБРАТЬ
					               |	КалькуляцияЖД_УслугиВнеСтавки.Ссылка,
					               |	КалькуляцияЖД_УслугиВнеСтавки.Услуга
					               |ИЗ
					               |	Документ.Калькуляция.ЖД_УслугиВнеСтавки КАК КалькуляцияЖД_УслугиВнеСтавки
					               |ГДЕ
					               |	КалькуляцияЖД_УслугиВнеСтавки.Ссылка В(&Ссылка)
					               |;
					               |
					               |////////////////////////////////////////////////////////////////////////////////
					               |ВЫБРАТЬ
					               |	ВТ.Калькуляция КАК Калькуляция,
					               |	СУММА(ВЫБОР
					               |			КОГДА ВТ.Услуга В (&Услуга)
					               |				ТОГДА 1
					               |			ИНАЧЕ 0
					               |		КОНЕЦ) КАК УслугаВСписке,
					               |	СУММА(ВЫБОР
					               |			КОГДА НЕ ВТ.Услуга В (&Услуга)
					               |				ТОГДА 1
					               |			ИНАЧЕ 0
					               |		КОНЕЦ) КАК УслугаНеВСписке
					               |ИЗ
					               |	ВТ КАК ВТ
					               |
					               |СГРУППИРОВАТЬ ПО
					               |	ВТ.Калькуляция";
					Запрос.УстановитьПараметр("Ссылка",Калькуляции);
					Запрос.УстановитьПараметр("Услуга",МассивДанныхДляОтбора);
					ТЗ = Запрос.Выполнить().Выгрузить();
					Если ТЗ.Количество() = 0 Тогда
						УсловиеВыполняется = Ложь;
						Прервать;
					Иначе
						// если вид сравнения равно или в списке, то для учета данного условия 
						// результат запроса должен вернуть УслугаВСписке > 0
						Если (ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.ВСписке ИЛИ
							ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.Равно) И 
							ТЗ[0].УслугаВСписке = 0 Тогда
							УсловиеВыполняется = Ложь;
							Прервать;
						// если вид сравнения НЕ равно или НЕ в списке, то для учета данного условия 
						// результат запроса должен вернуть УслугаНеВСписке > 0
						ИначеЕсли (ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.НеВСписке ИЛИ
							ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.НеРавно) И 
							ТЗ[0].УслугаНеВСписке = 0 Тогда
							УсловиеВыполняется = Ложь;
							Прервать;
						КонецЕсли;
					КонецЕсли;
					
				// 13. НаличиеЛицензии
				ИначеЕсли ВыборкаДетальныеЗаписи.ТипДополнительногоУсловия = Справочники.ТипДополнительногоУсловия.НаличиеЛицензии И 
					ТаблицаЗначенийУсловий[0].ЗначениеДляОтбора = Истина Тогда
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ
					               |	ЛицензияНаПеревозкуОпасныхГрузов.Контрагент КАК Контрагент
					               |ИЗ
					               |	РегистрСведений.ЛицензияНаПеревозкуОпасныхГрузов КАК ЛицензияНаПеревозкуОпасныхГрузов
					               |ГДЕ
					               |	ЛицензияНаПеревозкуОпасныхГрузов.ДатаОкончанияДействияЛицензии < &ДатаОкончанияДействияЛицензии
					               |	И ЛицензияНаПеревозкуОпасныхГрузов.Контрагент = &Контрагент";
					Запрос.УстановитьПараметр("Контрагент",Ссылка.Поставщик);
					// лицензия должна заканчиваться после окончания перевозки
					Если НЕ ЗначениеЗаполнено(Ссылка.ДатаНазначения) И
						Не ЗначениеЗаполнено(Ссылка.ДатаНазначенияФакт) Тогда
						УсловиеВыполняется = Ложь;
						Прервать;
					Иначе
						ДатаОкончанияЛицензии = ?(ЗначениеЗаполнено(Ссылка.ДатаНазначенияФакт),Ссылка.ДатаНазначенияФакт,Ссылка.ДатаНазначения);
						Запрос.УстановитьПараметр("ДатаОкончанияДействияЛицензии",ДатаОкончанияЛицензии);
					КонецЕсли;
					Если НЕ Запрос.Выполнить().Пустой() Тогда
						УсловиеВыполняется = Ложь;
						Прервать;
					КонецЕсли;
					
				// 14. НастроитьРассылкуДислокации. дислокация должна быть у всех клиентов из массива. если у какого-то нет - формируем задачу
				ИначеЕсли ВыборкаДетальныеЗаписи.ТипДополнительногоУсловия = Справочники.ТипДополнительногоУсловия.НастроитьРассылкуДислокации И 
					ТаблицаЗначенийУсловий[0].ЗначениеДляОтбора = Истина Тогда
					
					МассивКлиентов = ПолучитьКлиентовПоОперации(Ссылка);
					
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ
					               |	РассылкаДислокацийРеквизитыВагонов.Клиент КАК Клиент
					               |ПОМЕСТИТЬ ВТ
					               |ИЗ
					               |	Справочник.РассылкаДислокаций.РеквизитыВагонов КАК РассылкаДислокацийРеквизитыВагонов
					               |ГДЕ
					               |	РассылкаДислокацийРеквизитыВагонов.Клиент В (&Клиент)
					               |	И РассылкаДислокацийРеквизитыВагонов.Ссылка.ДатаОкончания >= &ДатаОкончания
					               |
					               |ОБЪЕДИНИТЬ ВСЕ
					               |
					               |ВЫБРАТЬ
					               |	РассылкаДислокацийРеквизитыКТК.Клиент
					               |ИЗ
					               |	Справочник.РассылкаДислокаций.РеквизитыКТК КАК РассылкаДислокацийРеквизитыКТК
					               |ГДЕ
					               |	РассылкаДислокацийРеквизитыКТК.Клиент В(&Клиент)
					               |	И РассылкаДислокацийРеквизитыКТК.Ссылка.ДатаОкончания >= &ДатаОкончания
					               |;
					               |
					               |////////////////////////////////////////////////////////////////////////////////
					               |ВЫБРАТЬ РАЗЛИЧНЫЕ
					               |	ВТ.Клиент КАК Клиент
					               |ИЗ
					               |	ВТ КАК ВТ";
					Запрос.УстановитьПараметр("Клиент",МассивКлиентов);
					// рассылка должна заканчиваться после окончания перевозки
					Если НЕ ЗначениеЗаполнено(Ссылка.ДатаНазначения) И
						Не ЗначениеЗаполнено(Ссылка.ДатаНазначенияФакт) Тогда
						УсловиеВыполняется = Ложь;
						Прервать;
					Иначе
						ДатаОкончанияРассылки = ?(ЗначениеЗаполнено(Ссылка.ДатаНазначенияФакт),Ссылка.ДатаНазначенияФакт,Ссылка.ДатаНазначения);
						Запрос.УстановитьПараметр("ДатаОкончания",ДатаОкончанияРассылки);
					КонецЕсли;
					КолвоЗаписейВЗапросе = Запрос.Выполнить().Выгрузить().Количество();
					КолвоКлиентовВМассиве = МассивКлиентов.Количество();
					
					Если КолвоЗаписейВЗапросе = КолвоКлиентовВМассиве Тогда
						УсловиеВыполняется = Ложь;
						Прервать;
					КонецЕсли;
					
				// 15. Проверка наличия хотя бы одной калькуляции на наличие или отсутствие вида перевозки
				ИначеЕсли ВыборкаДетальныеЗаписи.ТипДополнительногоУсловия = Справочники.ТипДополнительногоУсловия.ВидПеревозкиВКалькуляции Тогда
					
					Если Калькуляции = Неопределено Тогда
						Калькуляции = ПолучитьКалькуляцииПоОперации(ИзначальнаяСсылкаНаОперацию);
					КонецЕсли;
					
					Если Калькуляции = Неопределено ИЛИ 
						Калькуляции.Количество() = 0 Тогда
					    УсловиеВыполняется = Ложь;
						Прервать;
					КонецЕсли;
					
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ
					               |	Калькуляция.Ссылка КАК Калькуляция,
					               |	Калькуляция.ПС_ВидПеревозки КАК ПС_ВидПеревозки
					               |ПОМЕСТИТЬ ВТ
					               |ИЗ
					               |	Документ.Калькуляция КАК Калькуляция
					               |ГДЕ
					               |	Калькуляция.Ссылка В(&Ссылка)
					               |;
					               |
					               |////////////////////////////////////////////////////////////////////////////////
					               |ВЫБРАТЬ
					               |	ВТ.Калькуляция КАК Калькуляция,
					               |	СУММА(ВЫБОР
					               |			КОГДА ВТ.ПС_ВидПеревозки В (&ПС_ВидПеревозки)
					               |				ТОГДА 1
					               |			ИНАЧЕ 0
					               |		КОНЕЦ) КАК ВидПеревозкиВСписке,
					               |	СУММА(ВЫБОР
					               |			КОГДА НЕ ВТ.ПС_ВидПеревозки В (&ПС_ВидПеревозки)
					               |				ТОГДА 1
					               |			ИНАЧЕ 0
					               |		КОНЕЦ) КАК ВидПеревозкиНеВСписке
					               |ИЗ
					               |	ВТ КАК ВТ
					               |
					               |СГРУППИРОВАТЬ ПО
					               |	ВТ.Калькуляция";
					Запрос.УстановитьПараметр("Ссылка",Калькуляции);
					Запрос.УстановитьПараметр("ПС_ВидПеревозки",МассивДанныхДляОтбора);
					ТЗ = Запрос.Выполнить().Выгрузить();
					Если ТЗ.Количество() = 0 Тогда
						УсловиеВыполняется = Ложь;
						Прервать;
					Иначе
						// если вид сравнения равно или в списке, то для учета данного условия 
						// результат запроса должен вернуть ВидПеревозкиВСписке > 0
						Если (ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.ВСписке ИЛИ
							ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.Равно) И 
							ТЗ[0].ВидПеревозкиВСписке = 0 Тогда
							УсловиеВыполняется = Ложь;
							Прервать;
						// если вид сравнения НЕ равно или НЕ в списке, то для учета данного условия 
						// результат запроса должен вернуть ВидПеревозкиНеВСписке > 0
						ИначеЕсли (ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.НеВСписке ИЛИ
							ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.НеРавно) И 
							ТЗ[0].ВидПеревозкиНеВСписке = 0 Тогда
							УсловиеВыполняется = Ложь;
							Прервать;
						КонецЕсли;
					КонецЕсли;
					
				// 16. проверка, если плановая больше или равна фактической, то условие не выполняется
				ИначеЕсли ВыборкаДетальныеЗаписи.ТипДополнительногоУсловия = Справочники.ТипДополнительногоУсловия.ФактическаяДлительностьБольшеПлановой И 
					ТаблицаЗначенийУсловий[0].ЗначениеДляОтбора = Истина Тогда
					Если ЗначениеЗаполнено(Ссылка.ДатаНазначения) И
						ЗначениеЗаполнено(ССылка.ДатаОтправления) И
						ЗначениеЗаполнено(Ссылка.ДатаНазначенияФакт) И
						ЗначениеЗаполнено(ССылка.ДатаОтправленияФакт) Тогда
						Если (Ссылка.ДатаНазначенияФакт - ССылка.ДатаОтправленияФакт)<=(Ссылка.ДатаНазначения - ССылка.ДатаОтправления) Тогда
							УсловиеВыполняется = Ложь;
							Прервать;
						КонецЕсли;
					Иначе 
						УсловиеВыполняется = Ложь;
						Прервать;
					КонецЕсли;
					
				// 17. Проверка НЕПОСРЕДСТВЕННО ОДНОЙ ПРЕДЫДУЩЕЙ и СЛЕДУЮЩЕЙ операций ТСх на наличие или отсутствие видов операций
				ИначеЕсли ВыборкаДетальныеЗаписи.ТипДополнительногоУсловия = Справочники.ТипДополнительногоУсловия.ОтсутствиеСоседнейОперации Тогда
					
					МассивГУИДРодителей = ПолучитьМассивРодителей(ИзначальнаяСсылкаНаОперацию,Истина,1);
					МассивГУИДПодчиненных = ПолучитьМассивРодителей(ИзначальнаяСсылкаНаОперацию,Ложь,1);
					// объединим два массива для передачи параметра в запрос
