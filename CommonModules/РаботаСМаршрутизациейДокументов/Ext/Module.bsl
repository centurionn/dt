
Процедура РазборДополнительныхУсловий(ВыборкаГУИД,СсылкаНаОперацию,МассивМоментовВремени,ИмяТбл,ДатаРегистрацииЗаявки,ДокументОснование,Калькуляции,ТаблицаВыполненныхЗадач) ЭКСПОРТ
	
	МассивГУИДПодходящихСтрок = Новый Массив;
	ОтправитьДругомуМенеджеру = Новый Массив;
	
	ДатаОтсчетаИзДругойОперации = Неопределено;
	
	// нужны для записи в том случае, если требование документов/задач идет повагонное или поконтейнерное
	МассивПодходящихВагонов = Новый Массив;
	МассивПодходящихКТК = Новый Массив;

	Пока ВыборкаГУИД.Следующий() Цикл
		
		// сохраним ссылку на операцию, которая была инициатором всей проверки
		ИзначальнаяСсылкаНаОперацию = СсылкаНаОперацию;

		
		/////////////////////////////////////////////////////////////////////////////////////
		// если установлен флаг "УчитыватьДляВсейОперации", значит нужна для одной из 
		// операций ТСх проверить все дополнительные условия. для этого
		// находим все операции ТСХ и для каждой из них делаем проверку по всем условиям (подменяем переменную Ссылка) 
		// как только подходящая операция найдена, останавливаем цикл
		
		УчитыватьДляВсейОперации = ?(НЕ ЗначениеЗаполнено(ВыборкаГУИД.УчитыватьДляВсейОперации),Ложь,ВыборкаГУИД.УчитыватьДляВсейОперации);
		
		Если УчитыватьДляВсейОперации Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	ТехнологическаяСхемаТЧ.Ссылка КАК Ссылка
			               |ПОМЕСТИТЬ ВТ
			               |ИЗ
			               |	Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
			               |ГДЕ
			               |	ТехнологическаяСхемаТЧ.Операция = &Операция
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	ТехнологическаяСхемаТЧ.Операция КАК Ссылка
			               |ИЗ
			               |	ВТ КАК ВТ
			               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
			               |		ПО ВТ.Ссылка = ТехнологическаяСхемаТЧ.Ссылка";
			Запрос.УстановитьПараметр("Операция",СсылкаНаОперацию);
			ТаблицаПроверяемыхОпераций = Запрос.Выполнить().Выгрузить();
		Иначе
			// если флаг не установлен, все равно создадим таблицу с единственной строкой для универсальнось
			ТаблицаПроверяемыхОпераций = Новый ТаблицаЗначений;
			ТаблицаПроверяемыхОпераций.Колонки.Добавить("Ссылка",Новый ОписаниеТипов("ДокументСсылка.Операция"));
			НовСтр = ТаблицаПроверяемыхОпераций.Добавить();
			НовСтр.Ссылка = СсылкаНаОперацию;
		КонецЕсли;
		/////////////////////////////////////////////////////////////////////////////////////////
		Для Каждого СтрТПО Из ТаблицаПроверяемыхОпераций Цикл
			
			Ссылка = СтрТПО.Ссылка;
			
		
			Грузы = Ссылка.Грузы;
			ПунктОтправления = Ссылка.ПунктОтправления;
			ПунктНазначения = Ссылка.ПунктНазначения;

			
			ВыборкаДетальныеЗаписи = ВыборкаГУИД.Выбрать();
		    УсловиеВыполняется = Истина;
		    МассивДругихЗадач = Новый Массив;
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				// проверяем каждое условие, при котором должен быть создан документ или отправлено оповещение
				
				// проверим заполненность реквизита ВидОперации. Если он заполнен, то установка дат красно-желтых порогов
				// должна производиться с учетом выбранной операции.
				// эта проверка выполняется от имени операции, которая делает проводку
				Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ВидОперации) Тогда
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ
					               |	ТехнологическаяСхемаТЧ.Ссылка КАК Ссылка
					               |ПОМЕСТИТЬ ВТ
					               |ИЗ
					               |	Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
					               |ГДЕ
					               |	ТехнологическаяСхемаТЧ.Операция = &Операция
					               |;
					               |
					               |////////////////////////////////////////////////////////////////////////////////
					               |ВЫБРАТЬ ПЕРВЫЕ 1
					               |	ТехнологическаяСхемаТЧ.Операция КАК Операция
					               |ИЗ
					               |	ВТ КАК ВТ
					               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
					               |		ПО ВТ.Ссылка = ТехнологическаяСхемаТЧ.Ссылка
					               |ГДЕ
					               |	ТехнологическаяСхемаТЧ.Операция.Услуга = &Услуга";
					Запрос.УстановитьПараметр("Операция",ИзначальнаяСсылкаНаОперацию);
					Запрос.УстановитьПараметр("Услуга",ВыборкаДетальныеЗаписи.ВидОперации);
					ТЗ = Запрос.Выполнить().Выгрузить();
					
					// если операцию нашли, то нужно проверить ее даты. в зависимости от "МоментВремени" выбрать нужную
					Если ТЗ.Количество()>0 Тогда
						НайденнаяОперация = ТЗ[0].Операция;
						Если НЕ МассивМоментовВремени.Найти(Перечисления.ТипМоментаВремени.ДоНачалаОперации) = Неопределено Тогда
							ДатаОтсчетаИзДругойОперации = НайденнаяОперация.ДатаОтправления;
						ИначеЕсли НЕ МассивМоментовВремени.Найти(Перечисления.ТипМоментаВремени.ПослеНачалаОперации) = Неопределено ИЛИ
							НЕ МассивМоментовВремени.Найти(Перечисления.ТипМоментаВремени.ОтНачалаДоОкончания) = Неопределено Тогда
							ДатаОтсчетаИзДругойОперации = ?(ЗначениеЗаполнено(НайденнаяОперация.ДатаОтправленияФакт),НайденнаяОперация.ДатаОтправленияФакт,НайденнаяОперация.ДатаОтправления);
						ИначеЕсли НЕ МассивМоментовВремени.Найти(Перечисления.ТипМоментаВремени.ПослеОкончанияОперации) = Неопределено ИЛИ
							НЕ МассивМоментовВремени.Найти(Перечисления.ТипМоментаВремени.ДоОкончанияОперации) = Неопределено Тогда
							ДатаОтсчетаИзДругойОперации = ?(ЗначениеЗаполнено(НайденнаяОперация.ДатаНазначенияФакт),НайденнаяОперация.ДатаНазначенияФакт,НайденнаяОперация.ДатаНазначения);		
						КонецЕсли;
					КонецЕсли;
					
				КонецЕсли;
				
				// если установлен момент времени "До начала предыдущей операции", то получить эту операцию и взять из нее
				// дату начала план (т.к. нужно взять дату ДО начала).
				// эта проверка выполняется от имени операции, которая делает проводку
				Если ВыборкаДетальныеЗаписи.МоментВремени = Перечисления.ТипМоментаВремени.ДоНачалаПредыдущейОперации Тогда
					МассивГУИДРодителей = ПолучитьМассивРодителей(ССылка,Истина,1);
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ
					               |	ТехнологическаяСхемаТЧ.Ссылка КАК Ссылка
					               |ПОМЕСТИТЬ ВТ
					               |ИЗ
					               |	Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
					               |ГДЕ
					               |	ТехнологическаяСхемаТЧ.Операция = &Операция
					               |;
					               |
					               |////////////////////////////////////////////////////////////////////////////////
					               |ВЫБРАТЬ
					               |	ТехнологическаяСхемаТЧ.Операция КАК Операция
					               |ИЗ
					               |	ВТ КАК ВТ
					               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
					               |		ПО ВТ.Ссылка = ТехнологическаяСхемаТЧ.Ссылка
					               |ГДЕ
					               |	ТехнологическаяСхемаТЧ.ГУИД В(&ГУИД)";
					Запрос.УстановитьПараметр("Операция",ИзначальнаяСсылкаНаОперацию);
					Запрос.УстановитьПараметр("ГУИД",МассивГУИДРодителей);
					ТЗ = Запрос.Выполнить().Выгрузить();
					Если ТЗ.Количество() = 0 Тогда
						УсловиеВыполняется = Ложь;
					Иначе
						ДатаОтсчетаИзДругойОперации = ?(ЗначениеЗаполнено(ТЗ[0].Операция.ДатаОтправленияФакт),ТЗ[0].Операция.ДатаОтправленияФакт,ТЗ[0].Операция.ДатаОтправления);
					КонецЕсли;
					
				КонецЕсли;

				
				// если доп условий нет, то проверяем момент срабатывания условия (может зависеть от другой операции)
				Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ДопУсловиеНаименование) Тогда
					МассивГУИДПодходящихСтрок.Добавить(ВыборкаГУИД.ГУИД);
					Продолжить;
				КонецЕсли;
				
				// сначала получим перечень всех значений для данного условия
				ТаблицаЗначенийУсловий = ВыборкаДетальныеЗаписи.ДопУсловиеНаименование.ДанныеДляОтборов;
				Если ТаблицаЗначенийУсловий.Количество() = 0 Тогда
					Продолжить;
				КонецЕсли;
				// выгружаем колонку в массив для подстановки в качестве параметра в запрос
				МассивДанныхДляОтбора = ТаблицаЗначенийУсловий.ВыгрузитьКолонку("ЗначениеДляОтбора");
				// получаем вид сравнения для дополнительного условия
				ВидСравненияДУ = ВыборкаДетальныеЗаписи.ДопУсловиеНаименование.ВидыСравненияДопУсловий;
				// получаем вид сравнения для дополнительного условия
				ДниРасчета = ВыборкаДетальныеЗаписи.ЕдиницаИзмерения;
				
				
				///////////////////////////////////////////////////////////////////////////////////////////////
				///////////////////////////// ВАРИАНТЫ РАСЧЕТОВ ///////////////////////////////////////////////
				///////////////////////////////////////////////////////////////////////////////////////////////
				
				// 1. ПорожнийКТК
				Если ВыборкаДетальныеЗаписи.ТипДополнительногоУсловия = Справочники.ТипДополнительногоУсловия.ПорожнийКТК Тогда
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ
					               |	ОперацияГрузы.ТЕ КАК ТЕ
					               |ИЗ
					               |	Документ.Операция.Грузы КАК ОперацияГрузы
					               |ГДЕ
					               |	НЕ ОперацияГрузы.ТЕ = ЗНАЧЕНИЕ(Справочник.ТЕ.пустаяССылка)
					               |	И ОперацияГрузы.Ссылка = &Ссылка
					               |	И НЕ ОперацияГрузы.ГруженоеТЕ = &ГруженоеТЕ";
					Запрос.УстановитьПараметр("Ссылка",Ссылка);
					Запрос.УстановитьПараметр("ГруженоеТЕ",ТаблицаЗначенийУсловий[0].ЗначениеДляОтбора);
					ТЗ = Запрос.Выполнить().Выгрузить();
					Если ТЗ.Количество() = 0 Тогда
						УсловиеВыполняется = Ложь;
						Прервать;
					Иначе
						МассивПорожнихКТК = Новый Массив;
						Для Каждого Стр Из ТЗ Цикл
							Если МассивПорожнихКТК.Найти(Стр.ТЕ) = Неопределено Тогда
								МассивПорожнихКТК.Добавить(Стр.ТЕ);
							КонецЕсли;
						КонецЦикла;
						
						Если МассивПорожнихКТК.Количество()>0 Тогда
							МассивПодходящихКТК.Добавить(МассивПорожнихКТК);
						КонецЕсли;
					КонецЕсли;

				// 2. ГруженыйКТК
				ИначеЕсли ВыборкаДетальныеЗаписи.ТипДополнительногоУсловия = Справочники.ТипДополнительногоУсловия.ГруженыйКТК Тогда 
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ
					               |	ОперацияГрузы.ТЕ КАК ТЕ
					               |ИЗ
					               |	Документ.Операция.Грузы КАК ОперацияГрузы
					               |ГДЕ
					               |	НЕ ОперацияГрузы.ТЕ = ЗНАЧЕНИЕ(Справочник.ТЕ.пустаяССылка)
					               |	И ОперацияГрузы.Ссылка = &Ссылка
					               |	И ОперацияГрузы.ГруженоеТЕ = &ГруженоеТЕ";
					Запрос.УстановитьПараметр("Ссылка",Ссылка);
					Запрос.УстановитьПараметр("ГруженоеТЕ",ТаблицаЗначенийУсловий[0].ЗначениеДляОтбора);
					ТЗ = Запрос.Выполнить().Выгрузить();
					Если ТЗ.Количество() = 0 Тогда
						УсловиеВыполняется = Ложь;
						Прервать;
					Иначе
						МассивГруженыхКТК = Новый Массив;
						Для Каждого Стр Из ТЗ Цикл
							Если МассивГруженыхКТК.Найти(Стр.ТЕ) = Неопределено Тогда
								МассивГруженыхКТК.Добавить(Стр.ТЕ);
							КонецЕсли;
						КонецЦикла;
						
						Если МассивГруженыхКТК.Количество()>0 Тогда
							МассивПодходящихКТК.Добавить(МассивГруженыхКТК);
						КонецЕсли;
					КонецЕсли;
					
				
				// 3. Проверка всех операций ТСх на наличие или отсутствие видов операций 
				// (во всех операциях ТСх должны выполняться или НЕ выполняться перечисленные условия)
				ИначеЕсли ВыборкаДетальныеЗаписи.ТипДополнительногоУсловия = Справочники.ТипДополнительногоУсловия.ВсеОперацииТехнологическойСхемы Тогда
					// получим все операции "вокруг" данной ТСх
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ
					               |	ТехнологическаяСхемаТЧ.Ссылка КАК Ссылка
					               |ПОМЕСТИТЬ ВТ
					               |ИЗ
					               |	Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
					               |ГДЕ
					               |	ТехнологическаяСхемаТЧ.Операция = &Операция
					               |;
					               |
					               |////////////////////////////////////////////////////////////////////////////////
					               |ВЫБРАТЬ
					               |	СУММА(ВЫБОР
					               |			КОГДА ТехнологическаяСхемаТЧ.Услуга В (&Услуга)
					               |				ТОГДА 1
					               |			ИНАЧЕ 0
					               |		КОНЕЦ) КАК ВидОперацииВСписке,
					               |	СУММА(ВЫБОР
					               |			КОГДА НЕ ТехнологическаяСхемаТЧ.Услуга В (&Услуга)
					               |				ТОГДА 1
					               |			ИНАЧЕ 0
					               |		КОНЕЦ) КАК ВидОперацииНеВСписке,
					               |	СУММА(1) КАК ВсегоОперацийТсх,
					               |	ВТ.Ссылка КАК Ссылка
					               |ИЗ
					               |	ВТ КАК ВТ
					               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
					               |		ПО ВТ.Ссылка = ТехнологическаяСхемаТЧ.Ссылка
					               |
					               |СГРУППИРОВАТЬ ПО
					               |	ВТ.Ссылка";
					Запрос.УстановитьПараметр("Операция",Ссылка);
					Запрос.УстановитьПараметр("Услуга",МассивДанныхДляОтбора);
					ТЗ = Запрос.Выполнить().Выгрузить();
					Если ТЗ.Количество() = 0 Тогда
						УсловиеВыполняется = Ложь;
						Прервать;
					Иначе
						// если вид сравнения равно или в списке, то для учета данного условия 
						// результат запроса должен вернуть ВсегоОперацийТсх = ВидОперацииВСписке
						Если (ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.ВСписке ИЛИ
							ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.Равно) И 
							НЕ ТЗ[0].ВсегоОперацийТсх = ТЗ[0].ВидОперацииВСписке Тогда
							УсловиеВыполняется = Ложь;
							Прервать;
						// если вид сравнения НЕ равно или НЕ в списке, то для учета данного условия 
						// результат запроса должен вернуть ВсегоОперацийТсх = ВидОперацииНеВСписке
						ИначеЕсли (ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.НеВСписке ИЛИ
							ВидСравненияДУ = Перечисления.ВидыСравненияДопУсловий.НеРавно) И 
							НЕ ТЗ[0].ВсегоОперацийТсх = ТЗ[0].ВидОперацииНеВСписке Тогда
							УсловиеВыполняется = Ложь;
							Прервать;
						КонецЕсли;
					КонецЕсли;
					
				// 4. Проверка хотя бы одной операций ТСх на наличие или отсутствие видов операций
				ИначеЕсли ВыборкаДетальныеЗаписи.ТипДополнительногоУсловия = Справочники.ТипДополнительногоУсловия.ОднаИзОперацииТехнологическойСхемы Тогда
					// получим все операции "вокруг" данной ТСх
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ
					               |	ТехнологическаяСхемаТЧ.Ссылка КАК Ссылка
					               |ПОМЕСТИТЬ ВТ
					               |ИЗ
					               |	Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
					               |ГДЕ
					               |	ТехнологическаяСхемаТЧ.Операция = &Операция
					               |;
					               |
					               |////////////////////////////////////////////////////////////////////////////////
					               |ВЫБРАТЬ
					               |	СУММА(ВЫБОР
					               |			КОГДА ТехнологическаяСхемаТЧ.Услуга В (&Услуга)
