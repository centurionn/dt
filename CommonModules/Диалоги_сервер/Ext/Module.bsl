Функция ПолучитьНаборТемПоПараметрам(Знач ПериодС = неопределено, Знач ПериодПо = неопределено, ПоказатьОткрытые = Истина, ПоказатьЗакрытые = Истина, АвторТемы = неопределено, ГУИД = неопределено, Контекст = неопределено) Экспорт
	
	Если ПериодС = неопределено Тогда ПериодС = Дата("20000101"); КонецЕсли;
	Если ПериодПо = неопределено Тогда ПериодПо = Дата("21000101"); КонецЕсли;
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДиалогиЗаголовки.ГУИДТемы КАК ГУИДТемы,
	               |	ДиалогиЗаголовки.Тема КАК Тема,
	               |	ДиалогиЗаголовки.Контекст КАК Контекст,
	               |	ДиалогиЗаголовки.ВопросЗакрыт КАК ВопросЗакрыт,
	               |	Топикстартеры.АвторТемы КАК АвторТемы,
	               |	Топикстартеры.АвторТемы.НепосредственныйРуководитель КАК РуководительАвтораТемы,
	               |	ПоследниеСообщения.ПолучательПослСообщения КАК ПолучательПослСообщения,
	               |	ПоследниеСообщения.ДатаПрочтенияПослСообщения КАК ДатаПрочтенияПослСообщения,
	               |	Топикстартеры.ДатаСозданияТемы КАК ДатаСозданияТемы,
	               |	КоличествоСообщенийЪ.КоличествоСообщений КАК КоличествоСообщений,
	               |	ПоследниеСообщения.АвторПослСообщения КАК АвторПослСообщения,
	               |	ПоследниеСообщения.ДатаПослСообщения КАК ДатаПослСообщения,
	               |	ПоследниеСообщения.ТекстПослСообщения КАК ТекстПослСообщения,
	               |	Топикстартеры.ПолучательЗапроса КАК ПолучательЗапроса
	               |ПОМЕСТИТЬ Диалоги
	               |ИЗ
	               |	РегистрСведений.ДиалогиЗаголовки КАК ДиалогиЗаголовки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ДиалогиСообщения.ГУИДТемы КАК ГУИДТемы,
	               |			ДиалогиСообщения.Отправитель КАК АвторТемы,
	               |			ДиалогиСообщения.ДатаОтправки КАК ДатаСозданияТемы,
	               |			ДиалогиСообщения.Получатель КАК ПолучательЗапроса
	               |		ИЗ
	               |			РегистрСведений.ДиалогиСообщения КАК ДиалогиСообщения
	               |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |					ДиалогиСообщения.ГУИДТемы КАК ГУИДТемы,
	               |					МИНИМУМ(ДиалогиСообщения.ДатаОтправки) КАК ДатаОтправки
	               |				ИЗ
	               |					РегистрСведений.ДиалогиСообщения КАК ДиалогиСообщения
	               |				
	               |				СГРУППИРОВАТЬ ПО
	               |					ДиалогиСообщения.ГУИДТемы) КАК ОтборПервыхСообщений
	               |				ПО ДиалогиСообщения.ГУИДТемы = ОтборПервыхСообщений.ГУИДТемы
	               |					И ДиалогиСообщения.ДатаОтправки = ОтборПервыхСообщений.ДатаОтправки) КАК Топикстартеры
	               |		ПО ДиалогиЗаголовки.ГУИДТемы = Топикстартеры.ГУИДТемы
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ДиалогиСообщения.ГУИДТемы КАК ГУИДТемы,
	               |			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДиалогиСообщения.ГУИДСообщения) КАК КоличествоСообщений
	               |		ИЗ
	               |			РегистрСведений.ДиалогиСообщения КАК ДиалогиСообщения
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ДиалогиСообщения.ГУИДТемы) КАК КоличествоСообщенийЪ
	               |		ПО ДиалогиЗаголовки.ГУИДТемы = КоличествоСообщенийЪ.ГУИДТемы
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ДиалогиСообщения.ГУИДТемы КАК ГУИДТемы,
	               |			ДиалогиСообщения.Отправитель КАК АвторПослСообщения,
	               |			ДиалогиСообщения.ДатаОтправки КАК ДатаПослСообщения,
	               |			ДиалогиСообщения.ТекстСообщения КАК ТекстПослСообщения,
	               |			ДиалогиСообщения.Получатель КАК ПолучательПослСообщения,
	               |			ДиалогиСообщения.ДатаПрочтения КАК ДатаПрочтенияПослСообщения
	               |		ИЗ
	               |			РегистрСведений.ДиалогиСообщения КАК ДиалогиСообщения
	               |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |					ДиалогиСообщения.ГУИДТемы КАК ГУИДТемы,
	               |					МАКСИМУМ(ДиалогиСообщения.ДатаОтправки) КАК ДатаОтправки
	               |				ИЗ
	               |					РегистрСведений.ДиалогиСообщения КАК ДиалогиСообщения
	               |				
	               |				СГРУППИРОВАТЬ ПО
	               |					ДиалогиСообщения.ГУИДТемы) КАК ОтборПервыхСообщений
	               |				ПО ДиалогиСообщения.ГУИДТемы = ОтборПервыхСообщений.ГУИДТемы
	               |					И ДиалогиСообщения.ДатаОтправки = ОтборПервыхСообщений.ДатаОтправки) КАК ПоследниеСообщения
	               |		ПО ДиалогиЗаголовки.ГУИДТемы = ПоследниеСообщения.ГУИДТемы
	               |ГДЕ
	               |	Топикстартеры.ДатаСозданияТемы МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И ВЫБОР
	               |			КОГДА &ОтобранАвтор
	               |				ТОГДА Топикстартеры.АвторТемы = &АвторТемы
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА НЕ &ОтображатьОткрытые
	               |				ТОГДА ДиалогиЗаголовки.ВопросЗакрыт = ИСТИНА
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА НЕ &ОтображатьЗакрытые
	               |				ТОГДА ДиалогиЗаголовки.ВопросЗакрыт = ЛОЖЬ
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &ГУИД <> НЕОПРЕДЕЛЕНО
	               |				ТОГДА ДиалогиЗаголовки.ГУИДТемы = &ГУИД
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &ОтобранКонтекст
	               |				ТОГДА ДиалогиЗаголовки.Контекст = &Контекст
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Диалоги.ГУИДТемы КАК ГУИДТемы,
	               |	Диалоги.Тема КАК Тема,
	               |	Диалоги.Контекст КАК Контекст,
	               |	Диалоги.ВопросЗакрыт КАК ВопросЗакрыт,
	               |	Диалоги.АвторТемы КАК АвторТемы,
	               |	Диалоги.РуководительАвтораТемы КАК РуководительАвтораТемы,
	               |	Диалоги.ПолучательПослСообщения КАК ПолучательПослСообщения,
	               |	Диалоги.ДатаПрочтенияПослСообщения КАК ДатаПрочтенияПослСообщения,
	               |	Диалоги.ДатаСозданияТемы КАК ДатаСозданияТемы,
	               |	Диалоги.КоличествоСообщений КАК КоличествоСообщений,
	               |	Диалоги.АвторПослСообщения КАК АвторПослСообщения,
	               |	Диалоги.ДатаПослСообщения КАК ДатаПослСообщения,
	               |	Диалоги.ТекстПослСообщения КАК ТекстПослСообщения,
	               |	ПоследниеОтветы.ДатаПоследнегоОтвета КАК ДатаПоследнегоОтвета
	               |ИЗ
	               |	Диалоги КАК Диалоги
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			Диалоги.ГУИДТемы КАК ГУИДТемы,
	               |			МАКСИМУМ(ДиалогиСообщения.ДатаОтправки) КАК ДатаПоследнегоОтвета
	               |		ИЗ
	               |			Диалоги КАК Диалоги
	               |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДиалогиСообщения КАК ДиалогиСообщения
	               |				ПО Диалоги.ГУИДТемы = ДиалогиСообщения.ГУИДТемы
	               |					И Диалоги.АвторТемы <> ДиалогиСообщения.Отправитель
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			Диалоги.ГУИДТемы) КАК ПоследниеОтветы
	               |		ПО Диалоги.ГУИДТемы = ПоследниеОтветы.ГУИДТемы
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаСозданияТемы";
	Запрос.УстановитьПараметр("НачалоПериода", ПериодС);
	Запрос.УстановитьПараметр("КонецПериода", ПериодПо);
	Запрос.УстановитьПараметр("ОтобранАвтор", ЗначениеЗаполнено(АвторТемы));
	Запрос.УстановитьПараметр("ОтобранКонтекст", ЗначениеЗаполнено(Контекст));
	Запрос.УстановитьПараметр("Контекст", Контекст);
	Запрос.УстановитьПараметр("АвторТемы", АвторТемы);
	Запрос.УстановитьПараметр("ОтображатьОткрытые", ПоказатьОткрытые);
	Запрос.УстановитьПараметр("ОтображатьЗакрытые", ПоказатьЗакрытые);
	Запрос.УстановитьПараметр("ГУИД", ГУИД);
	
	//Евросиб Каблов 07.09.2022 ( US49022
	РольДоступнаПолныеПрава = РольДоступна("ПолныеПрава");
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	//Евросиб Каблов 07.09.2022 )
	
	Ответ = запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		//Евросиб Каблов 07.09.2022 ( US49022
		//Результат.Добавить(Новый Структура(
		//"ГУИДТемы, Тема, Автор, Контекст, ВопросЗакрыт, КоличествоСообщений, ДатаПослСообщения, АвторПослСообщения, СокрТекстПослСообщения, ДатаСоздания", 
		//Ответ.ГУИДТемы, Ответ.Тема, Ответ.АвторТемы, Ответ.Контекст, Ответ.ВопросЗакрыт, Ответ.КоличествоСообщений, Ответ.ДатаПослСообщения, Ответ.АвторПослСообщения, Ответ.ТекстПослСообщения, Ответ.ДатаСозданияТемы));
		Результат.Добавить(Новый Структура(
		"ГУИДТемы, Тема, Автор, Контекст, ВопросЗакрыт, КоличествоСообщений, ДатаПослСообщения, АвторПослСообщения, СокрТекстПослСообщения, ДатаСоздания, РуководительАвтораТемы, ПолучательПослСообщения, ДатаПрочтенияПослСообщения, ДатаПоследнегоОтвета", 
		Ответ.ГУИДТемы, Ответ.Тема, Ответ.АвторТемы, Ответ.Контекст, Ответ.ВопросЗакрыт, Ответ.КоличествоСообщений, Ответ.ДатаПослСообщения, Ответ.АвторПослСообщения, Ответ.ТекстПослСообщения, Ответ.ДатаСозданияТемы, Ответ.РуководительАвтораТемы, Ответ.ПолучательПослСообщения, Ответ.ДатаПрочтенияПослСообщения, Ответ.ДатаПоследнегоОтвета));
		//Евросиб Каблов 07.09.2022 )		
		
	КонецЦикла;
	
	Возврат Результат;
	
	
КонецФункции

Функция ПолучитьСообщенияТемы(ГУИДТемы) Экспорт
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	//Евросиб Каблов 07.09.2022 ( US49022
	//Запрос.Текст = "ВЫБРАТЬ
	//               |	ДиалогиСообщения.ГУИДСообщения КАК ГУИДСообщения,
	//               |	ДиалогиСообщения.Отправитель КАК Отправитель,
	//               |	ДиалогиСообщения.ДатаОтправки КАК ДатаОтправки,
	//               |	ДиалогиСообщения.ТекстСообщения КАК ТекстСообщения,
	//               |	ДиалогиСообщения.Файл КАК Файл,
	//               |	ДиалогиСообщения.Прочитано КАК Прочитано,
	//               |	ДиалогиСообщения.Получатель КАК Получатель
	//               |ИЗ
	//               |	РегистрСведений.ДиалогиСообщения КАК ДиалогиСообщения
	//               |ГДЕ
	//               |	ДиалогиСообщения.ГУИДТемы = &ГУИДТемы
	//               |
	//               |УПОРЯДОЧИТЬ ПО
	//               |	ДатаОтправки";
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДиалогиСообщения.ГУИДСообщения КАК ГУИДСообщения,
	               |	ДиалогиСообщения.Отправитель КАК Отправитель,
	               |	ДиалогиСообщения.ДатаОтправки КАК ДатаОтправки,
	               |	ДиалогиСообщения.ТекстСообщения КАК ТекстСообщения,
	               |	ДиалогиСообщения.Файл КАК Файл,
	               |	ДиалогиСообщения.Прочитано КАК Прочитано,
	               |	ДиалогиСообщения.Получатель КАК Получатель,
	               |	ДиалогиСообщения.ДатаПрочтения КАК ДатаПрочтения
	               |ПОМЕСТИТЬ СообщенияДиалога
	               |ИЗ
	               |	РегистрСведений.ДиалогиСообщения КАК ДиалогиСообщения
	               |ГДЕ
	               |	ДиалогиСообщения.ГУИДТемы = &ГУИДТемы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Сообщения.ГУИДСообщения КАК ГУИДСообщения,
	               |	Сообщения.Отправитель КАК Отправитель,
	               |	Сообщения.ДатаОтправки КАК ДатаОтправки,
	               |	Сообщения.ТекстСообщения КАК ТекстСообщения,
	               |	Сообщения.Файл КАК Файл,
	               |	Сообщения.Прочитано КАК Прочитано,
	               |	Сообщения.Получатель КАК Получатель,
	               |	Сообщения.ДатаПрочтения КАК ДатаПрочтения,
	               |	Ответы.ДатаОтправки КАК ДатаОтвета
	               |ИЗ
	               |	СообщенияДиалога КАК Сообщения
	               |		ЛЕВОЕ СОЕДИНЕНИЕ СообщенияДиалога КАК Ответы
	               |		ПО (Ответы.ДатаОтправки В
	               |				(ВЫБРАТЬ ПЕРВЫЕ 1
	               |					СообщенияДиалога.ДатаОтправки КАК ДатаОтправки
	               |				ИЗ
	               |					СообщенияДиалога КАК СообщенияДиалога
	               |				ГДЕ
	               |					СообщенияДиалога.ДатаОтправки > Сообщения.ДатаОтправки
	               |				УПОРЯДОЧИТЬ ПО
	               |					ДатаОтправки))
	               |			И (ВЫБОР
	               |				КОГДА Сообщения.Получатель ССЫЛКА Справочник.Пользователи
	               |					ТОГДА Сообщения.Получатель = Ответы.Отправитель
	               |				ИНАЧЕ ИСТИНА
	               |			КОНЕЦ)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаОтправки";
	//Евросиб Каблов 07.09.2022 )
	Запрос.УстановитьПараметр("ГУИДТемы", ГУИДТемы);
	Ответ = запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		//Евросиб Каблов 07.09.2022 ( US49022
		//Результат.Добавить(Новый Структура(
		//"ГУИДСообщения, АвторСообщения, ДатаСообщения, ТекстСообщения, Файл, Прочитано, Получатель", 
		//Ответ.ГУИДСообщения, Ответ.Отправитель, Ответ.ДатаОтправки, Ответ.ТекстСообщения, Ответ.Файл, Ответ.Прочитано, Ответ.Получатель
		//));
		Результат.Добавить(Новый Структура(
		"ГУИДСообщения, АвторСообщения, ДатаСообщения, ТекстСообщения, Файл, Прочитано, Получатель, ДатаПрочтения, ДатаОтвета", 
		Ответ.ГУИДСообщения, Ответ.Отправитель, Ответ.ДатаОтправки, Ответ.ТекстСообщения, Ответ.Файл, Ответ.Прочитано, Ответ.Получатель, Ответ.ДатаПрочтения, Ответ.ДатаОтвета
		));
		//Евросиб Каблов 07.09.2022 )
	КонецЦикла;

	Возврат Результат;
	
КонецФункции

//Евросиб Каблов 07.09.2022 ( US49022
//Процедура ДобавитьСообщение(ГУИДТемы, ГУИДСообщения, Отправитель, ДатаОтправки, ТекстСообщения, Файл = неопределено, Получатель = неопределено) Экспорт
Процедура ДобавитьСообщение(ГУИДТемы, ГУИДСообщения, Отправитель, ДатаОтправки, ТекстСообщения, Файл = неопределено, Получатель = неопределено, Контекст = Неопределено) Экспорт
	
	НачатьТранзакцию();
	
	Если ЗначениеЗаполнено(Файл) И ЗначениеЗаполнено(Контекст) Тогда
		
		ТипЗначенияКонтекста = ТипЗнч(Контекст);
		ТипПоступлениеТоваровУслуг = Тип("ДокументСсылка.ПоступлениеТоваровУслуг");
		ТипКорректировкаПоступления = Тип("ДокументСсылка.КорректировкаПоступления");
		
		Если ТипЗначенияКонтекста = ТипПоступлениеТоваровУслуг Или ТипЗначенияКонтекста = ТипКорректировкаПоступления Тогда
			Если ЗначениеЗаполнено(Файл) Тогда
				ФайлОбъект = Файл.ПолучитьОбъект();
				ФайлОбъект.ВладелецФайла = Контекст;
				ФайлОбъект.Записать();
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
//Евросиб Каблов 07.09.2022 )
	
	МЗ = РегистрыСведений.ДиалогиСообщения.СоздатьМенеджерЗаписи();
	МЗ.ГУИДТемы = ГУИДТемы;
	МЗ.ГУИДСообщения = ГУИДСообщения;
	МЗ.Отправитель = Отправитель;
	МЗ.ДатаОтправки = ДатаОтправки;
	МЗ.ТекстСообщения = ТекстСообщения;
	МЗ.Файл = Файл;
	МЗ.Получатель = Получатель;
	Если ЗначениеЗаполнено(МЗ.Получатель) Тогда
		МЗ.СрокРассмотрения = МЗ.ДатаОтправки + Константы.ВремяОжиданияПередОтправкойУведомленияОСообщенииНаПочтуМин.Получить() * 60;
	КонецЕсли;
	
	МЗ.Записать(Истина);
	
	//Евросиб Каблов 07.09.2022 ( US49022
	ЗафиксироватьТранзакцию();
	//Евросиб Каблов 07.09.2022 )
	
КонецПроцедуры

//Евросиб Каблов 07.09.2022 ( US49022
//Процедура СоздатьТему(ГУИДТемы, Тема, Контекст) Экспорт
Процедура СоздатьТему(ГУИДТемы, Тема, Контекст, ДополнительныеПараметры = Неопределено) Экспорт
	
	НачатьТранзакцию();
//Евросиб Каблов 07.09.2022 )
	
	МЗ = РегистрыСведений.ДиалогиЗаголовки.СоздатьМенеджерЗаписи();
	МЗ.ГУИДТемы = ГУИДТемы;
	МЗ.Контекст = Контекст;
	МЗ.Тема = Тема;
	МЗ.Записать(Истина);
	
	//Евросиб Каблов 07.09.2022 ( US49022
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		
		Поступление = Неопределено;
		ИдентификаторыСтрокАкцепта = Неопределено;
		Если ДополнительныеПараметры.Свойство("Поступление", Поступление) И ЗначениеЗаполнено(Поступление)
			И ДополнительныеПараметры.Свойство("ИдентификаторыСтрокАкцепта", ИдентификаторыСтрокАкцепта) И ЗначениеЗаполнено(ИдентификаторыСтрокАкцепта) Тогда
			
			Для Каждого ИдентификаторСтрокиАкцепта Из ИдентификаторыСтрокАкцепта Цикл
				Запись = РегистрыСведений.ДиалогиПричиныНеурегулированныхРасходов.СоздатьМенеджерЗаписи();
				Запись.Поступление = Поступление;
				Запись.ИдентификаторСтрокиАкцепта = ИдентификаторСтрокиАкцепта;
				Запись.ГУИДТемы = ГУИДТемы;
				Запись.Записать();
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;           
	
	// Евросиб(ДИТ) US 56866 ТА 85906 Сержантова А.С. Начало: 05.07.2024 
	//Запишем События закрытия Диалога 
	//По корректировке поступления - закрываем диалог при наступлении события разрешена выгрузка в УПП
	Если ТипЗнч(Контекст) = Тип("ДокументСсылка.КорректировкаПоступления") Тогда
		МЗ = РегистрыСведений.СобытияЗакрывающиеДиалоги.СоздатьМенеджерЗаписи();
		МЗ.ГУИДТемы = ГУИДТемы;
		МЗ.Контекст = Контекст;
		МЗ.Событие = Перечисления.СобытияЗакрытияДиалогов.РазрешенаВыгрузкаВУПП;
		МЗ.Записать(Истина);
	КонецЕсли;
	
	// Если тема создана из акцепта (АРМ неуреги), то закрываем диалог при разнесении акцепта 
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") 
		и ДополнительныеПараметры.Свойство("Поступление", Поступление) И ЗначениеЗаполнено(Поступление)
		И ДополнительныеПараметры.Свойство("ИдентификаторыСтрокАкцепта", ИдентификаторыСтрокАкцепта) И ЗначениеЗаполнено(ИдентификаторыСтрокАкцепта) Тогда
		МЗ = РегистрыСведений.СобытияЗакрывающиеДиалоги.СоздатьМенеджерЗаписи();
		МЗ.ГУИДТемы = ГУИДТемы;
		МЗ.Контекст = Контекст;
		МЗ.Событие = Перечисления.СобытияЗакрытияДиалогов.ПолноеРазнесениеАкцепта;
		МЗ.Записать(Истина); 
	// По документу ПТУ - закрываем диалог при наступлении события разрешена выгрузка в УПП 
	ИначеЕсли ТипЗнч(Контекст) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		МЗ = РегистрыСведений.СобытияЗакрывающиеДиалоги.СоздатьМенеджерЗаписи();
		МЗ.ГУИДТемы = ГУИДТемы;
		МЗ.Контекст = Контекст;
		МЗ.Событие = Перечисления.СобытияЗакрытияДиалогов.РазрешенаВыгрузкаВУПП;
		МЗ.Записать(Истина);	
	КонецЕсли;
	// Евросиб(ДИТ) US 56866 ТА 85906 Сержантова А.С. Конец: 05.07.2024
	
	ЗафиксироватьТранзакцию();
	//Евросиб Каблов 07.09.2022 )    
	
КонецПроцедуры

//Евросиб Каблов 07.09.2022 ( US49022
//Процедура ПометитьТемуКакПрочитанную(ГУИДТемы, Пользователь) Экспорт
Процедура ПометитьТемуКакПрочитанную(ГУИДТемы, Пользователь, Прочитано = Истина) Экспорт
//Евросиб Каблов 07.09.2022 )
	
	НЗ = РегистрыСведений.ДиалогиСообщения.СоздатьНаборЗаписей();
	НЗ.Отбор.ГУИДТемы.Установить(ГУИДТемы);
	НЗ.Прочитать();
	ТребуетсяИзменение = Ложь;
	Для каждого Стр из НЗ Цикл
		//Евросиб Каблов 07.09.2022 ( US49022
		//Если ЗначениеЗаполнено(Стр.Получатель) И НЕ Стр.Прочитано И Пользователи_sd_сервер.ГруппаВключаетПользователя(Стр.Получатель, Пользователь) Тогда
		Если ЗначениеЗаполнено(Стр.Получатель) И Стр.Прочитано <> Прочитано И Пользователи_sd_сервер.ГруппаВключаетПользователя(Стр.Получатель, Пользователь) Тогда
		//Евросиб Каблов 07.09.2022 )
			ТребуетсяИзменение = Истина;
			//Евросиб Каблов 07.09.2022 ( US49022
			//Стр.Прочитано = истина;
			Стр.Прочитано = Прочитано;
			Если Прочитано Тогда
				Стр.ДатаПрочтения = ТекущаяДата();
			Иначе
				Стр.ДатаПрочтения = '00010101';
			КонецЕсли;
			//Евросиб Каблов 07.09.2022 )
		КонецЕсли;
	КонецЦикла;
	Если ТребуетсяИзменение Тогда
		НЗ.Записать(Истина);
	КонецЕсли;
	
КонецПроцедуры

//Евросиб Каблов 07.09.2022 US49022
Процедура УстановитьСтатусСообщенияПрочитано(ГУИДТемы, ГУИДСообщения, Пользователь, Прочитано = Истина) Экспорт
	
	Сообщение = РегистрыСведений.ДиалогиСообщения.СоздатьМенеджерЗаписи();
	Сообщение.ГУИДТемы = ГУИДТемы;
	Сообщение.ГУИДСообщения = ГУИДСообщения;
	Сообщение.Прочитать();
	
	Если Сообщение.Выбран() Тогда
		
		//Евросиб Каблов 19.01.2023 ( 60424
		//Если ЗначениеЗаполнено(Сообщение.Получатель) И Сообщение.Прочитано <> Прочитано И Пользователи_sd_сервер.ГруппаВключаетПользователя(Сообщение.Получатель, Пользователь) Тогда
		ТекДата = ТекущаяДата();
		СписокПользователей = Пользователи_sd_сервер.ПодобратьЗамещениеОбратное(Пользователь, ТекДата);
		МоиГруппы = Пользователи_sd_сервер.ПолучитьСписокМоихГрупп(Пользователь, СписокПользователей);
		
		Если ЗначениеЗаполнено(Сообщение.Получатель) И Сообщение.Прочитано <> Прочитано 
				И (СписокПользователей.Найти(Сообщение.Получатель) <> Неопределено Или МоиГруппы.Найти(Сообщение.Получатель) <> неопределено) Тогда
		//Евросиб Каблов 19.01.2023 )
			Сообщение.Прочитано = Прочитано;
			Если Прочитано Тогда
				Сообщение.ДатаПрочтения = ТекущаяДата();
			Иначе
				Сообщение.ДатаПрочтения = '00010101';
			КонецЕсли;
			Сообщение.Записать();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьНаборНепрочитанныхТемТребующихВнимания(Пользователь) Экспорт
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДиалогиСообщения.ГУИДТемы КАК ГУИДТемы,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДиалогиСообщения.ГУИДСообщения) КАК КоличествоНепрочитанных
	               |ПОМЕСТИТЬ Т1
	               |ИЗ
	               |	РегистрСведений.ДиалогиСообщения КАК ДиалогиСообщения
	               |ГДЕ
	               |	НЕ ДиалогиСообщения.Прочитано
				   //Евросиб Каблов 19.01.2023 ( 60424
	               //|	И (ДиалогиСообщения.Получатель = &Пользователь
				   |	И (ДиалогиСообщения.Получатель В (&Пользователи)
				   //Евросиб Каблов 19.01.2023 )
	               |			ИЛИ ДиалогиСообщения.Получатель В
	               |				(ВЫБРАТЬ
	               |					ГруппыПользователейСостав.Ссылка КАК Ссылка
	               |				ИЗ
	               |					Справочник.ГруппыПользователей.Состав КАК ГруппыПользователейСостав
	               |				ГДЕ
				   //Евросиб Каблов 19.01.2023 ( 60424
	               //|					ГруппыПользователейСостав.Пользователь = &Пользователь))
				   |					ГруппыПользователейСостав.Пользователь В (&Пользователи)))
				   //Евросиб Каблов 19.01.2023 )
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ДиалогиСообщения.ГУИДТемы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДиалогиЗаголовки.ГУИДТемы КАК ГУИДТемы,
	               |	ДиалогиЗаголовки.Тема КАК Тема,
	               |	Т1.КоличествоНепрочитанных КАК КоличествоНепрочитанных,
	               |	ДиалогиЗаголовки.Контекст КАК Контекст
	               |ИЗ
	               |	РегистрСведений.ДиалогиЗаголовки КАК ДиалогиЗаголовки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Т1 КАК Т1
	               |		ПО ДиалогиЗаголовки.ГУИДТемы = Т1.ГУИДТемы";
	
	//Евросиб Каблов 19.01.2023 ( 60424
	//Запрос.УстановитьПараметр("Пользователь", Пользователь);
	СписокПользователей = Новый Массив;
	СписокПользователей.Добавить(Пользователь);
	
	ТекДата = ТекущаяДата();
	ЗамещаемыйСотрудник = Пользователи_sd_сервер.ПодобратьЗамещениеОбратное(Пользователь, ТекДата);
	Если ЗамещаемыйСотрудник <> Пользователь Тогда
		СписокПользователей.Добавить(ЗамещаемыйСотрудник);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Пользователи", СписокПользователей);
	//Евросиб Каблов 19.01.2023 )
	
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		Результат.Добавить(Новый Структура("ГУИДТемы, Тема, КоличествоНепрочитанных, Контекст", Ответ.ГУИДТемы, Ответ.Тема, Ответ.КоличествоНепрочитанных, Ответ.Контекст));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура РассылкаНепрочитанныхСообщений() Экспорт
	
	Если НЕ РаботаСПочтовымиСообщениями.ПроверитьСистемнаяУчетнаяЗаписьДоступна() Тогда 
		ЗаписьЖурналаРегистрации("Ошибка отправки списка непрочитанных", УровеньЖурналаРегистрации.Ошибка,,,"Недоступна системная учетная запись");
		Возврат; 
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДиалогиСообщения.ГУИДТемы КАК ГУИДТемы,
	               |	ДиалогиСообщения.ГУИДСообщения КАК ГУИДСообщения,
	               |	ДиалогиСообщения.Отправитель КАК Отправитель,
	               |	ДиалогиСообщения.ДатаОтправки КАК ДатаОтправки,
	               |	ДиалогиСообщения.ТекстСообщения КАК ТекстСообщения,
	               |	ДиалогиСообщения.Получатель КАК Получатель,
	               |	ДиалогиСообщения.СрокРассмотрения КАК СрокРассмотрения,
	               |	ДиалогиЗаголовки.Тема КАК Тема,
	               |	ДиалогиЗаголовки.Контекст КАК Контекст
	               |ИЗ
	               |	РегистрСведений.ДиалогиСообщения КАК ДиалогиСообщения
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДиалогиЗаголовки КАК ДиалогиЗаголовки
	               |		ПО ДиалогиСообщения.ГУИДТемы = ДиалогиЗаголовки.ГУИДТемы
	               //Евросиб Коханенко Н.А. 05.03.2025 (( #102648 
				   |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	               |		ПО ДиалогиСообщения.Получатель = Пользователи.Ссылка
	               |			И Пользователи.Недействителен = ЛОЖЬ
	               //Евросиб Коханенко Н.А. 05.03.2025 )) #102648 
	               |ГДЕ
	               |	НЕ ДиалогиСообщения.Прочитано
	               |	И ДиалогиСообщения.СрокРассмотрения < &ТекущаяДата
	               |	И ДиалогиСообщения.СрокРассмотрения > ДАТАВРЕМЯ(1, 1, 1)";
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	ТаблицаУведомлений = Запрос.Выполнить().Выгрузить();
	
	// сначала ищем уникальных получателей сообщений, чтобы сгруппировать корреспонденцию
	МассивУникальныхПолучателей = Новый Массив;
	Для каждого Стр из ТаблицаУведомлений Цикл
		Если ТипЗнч(Стр.Получатель) = Тип("СправочникСсылка.Пользователи") тогда
			Если МассивУникальныхПолучателей.Найти(Стр.Получатель) = неопределено Тогда
				МассивУникальныхПолучателей.Добавить(Стр.Получатель);
			КонецЕсли;
		Иначе
			СписокПользователей = Пользователи_sd_сервер.ПолучитьПользователейГруппы(Стр.Получатель);
			Для каждого СтрПолучатель из СписокПользователей Цикл
				Если МассивУникальныхПолучателей.Найти(СтрПолучатель) = неопределено Тогда
					МассивУникальныхПолучателей.Добавить(СтрПолучатель);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	СтандартныйЗаголовокПисьма = "Добрый день, для Вас есть непрочитанные сообщения: "+ Символы.ПС;
	
	// затем для каждого такого получателя формируем письмо
	Для каждого Стр из МассивУникальныхПолучателей Цикл
		
		АдресУникальногоПолучателя = "";
		Для каждого Стр8 из Стр.КонтактнаяИнформация Цикл
			Если Стр8.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты Тогда
				АдресУникальногоПолучателя = Стр8.АдресЭП;
			КонецЕсли;
		КонецЦикла;
		
		Если АдресУникальногоПолучателя = "" Тогда
			ЗаписьЖурналаРегистрации("Ошибка отправки списка непрочитанных", УровеньЖурналаРегистрации.Ошибка,,,"Не задан электронный адрес получателя "+Стр);
			Продолжить;
		КонецЕсли;
		
		ТекстПисьма = "";
		Для каждого Тема из ТаблицаУведомлений Цикл
			Если Пользователи_sd_сервер.ГруппаВключаетПользователя(Тема.Получатель, Стр) Тогда
				ТекстПисьма = ТекстПисьма + ?(ТекстПисьма = "", "", Символы.ПС) + "= " + Тема.Тема + " от " + Тема.Отправитель + " сообщение: " + Тема.ТекстСообщения;
			КонецЕсли;
		КонецЦикла;
		
		Если ТекстПисьма <> "" Тогда
			
			Попытка
				СУЗ = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
				
				УстановитьПривилегированныйРежим(Истина);
				Пароли = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(СУЗ, "ПарольSMTP");
				УстановитьПривилегированныйРежим(Ложь);
				
				ИПП = Новый ИнтернетПочтовыйПрофиль;
				ИПП.АдресСервераSMTP = СУЗ.СерверИсходящейПочты;
				ИПП.АутентификацияSMTP = СпособSMTPАутентификации.ПоУмолчанию;
				ИПП.ПарольSMTP = Пароли;
				ИПП.ПользовательSMTP = СУЗ.ПользовательSMTP;
				ИПП.ПортSMTP = СУЗ.ПортСервераИсходящейПочты;
				
				ИС = Новый ИнтернетПочтовоеСообщение;
				ИС.ИмяОтправителя = СУЗ.ИмяПользователя;
				ИС.Отправитель.Адрес = СУЗ.АдресЭлектроннойПочты;
				ИС.Получатели.Добавить(АдресУникальногоПолучателя);
				ИС.Тема = "DATACore: Непрочитанные сообщения";
				ИС.Тексты.Добавить(СтандартныйЗаголовокПисьма + ТекстПисьма, ТипТекстаПочтовогоСообщения.ПростойТекст);
				ИС.ОбработатьТексты();
				ИП = Новый ИнтернетПочта;
				ИП.Подключиться(ИПП);
				ИП.Послать(ИС);
				ИП.Отключиться();
				
			Исключение
				ОО = ОписаниеОшибки();
				ЗаписьЖурналаРегистрации("Ошибка отправки списка непрочитанных", УровеньЖурналаРегистрации.Ошибка,,,ОО);
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

//Евросиб Каблов 07.09.2022 ( US49022
//Процедура ЗакрытьТему(ГУИДТемы) Экспорт
Процедура ЗакрытьТему(ГУИДТемы, ВопросЗакрыт = Истина) Экспорт
//Евросиб Каблов 07.09.2022 )
	
	НЗ = РегистрыСведений.ДиалогиЗаголовки.СоздатьНаборЗаписей();
	НЗ.Отбор.ГУИДТемы.Установить(ГУИДТемы);
	НЗ.Прочитать();
	//Евросиб Каблов 07.09.2022 ( US49022
	//НЗ[0].ВопросЗакрыт = Истина;
	НЗ[0].ВопросЗакрыт = ВопросЗакрыт;
	//Евросиб Каблов 07.09.2022 )
	НЗ.Записать(Истина);
	
КонецПроцедуры

Процедура УведомленияОСтатусеИсполненияЛичныхЦелейСотрудников() Экспорт
	
	Если НЕ РаботаСПочтовымиСообщениями.ПроверитьСистемнаяУчетнаяЗаписьДоступна() Тогда 
		ЗаписьЖурналаРегистрации("Ошибка отправки результатов исполнения личных целей", УровеньЖурналаРегистрации.Ошибка,,,"Недоступна системная учетная запись");
		Возврат; 
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛичныеЦелиСотрудниковОстатки.Сотрудник КАК Сотрудник,
	               |	ЛичныеЦелиСотрудниковОстатки.Цель КАК Цель,
	               |	ЛичныеЦелиСотрудниковОстатки.НачалоРаботы КАК НачалоРаботы,
	               |	ЛичныеЦелиСотрудниковОстатки.СрокДостижения КАК СрокДостижения,
	               |	ЛичныеЦелиСотрудниковОстатки.СпособДостижения КАК СпособДостижения,
	               |	ЛичныеЦелиСотрудниковОстатки.ПлановыйПоказательОстаток КАК ПлановыйПоказательОстаток,
	               |	ЛичныеЦелиСотрудниковОстатки.ФактическийПоказательОстаток КАК ФактическийПоказательОстаток
	               |ИЗ
	               |	РегистрНакопления.ЛичныеЦелиСотрудников.Остатки КАК ЛичныеЦелиСотрудниковОстатки
	               |ГДЕ
	               |	ЛичныеЦелиСотрудниковОстатки.СрокДостижения = &ТекущаяДата";
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	ТаблицаУведомлений = Запрос.Выполнить().Выгрузить();
	
	// сначала ищем уникальных получателей сообщений, чтобы сгруппировать корреспонденцию
	МассивУникальныхПолучателей = Новый Массив;
	Для каждого Стр из ТаблицаУведомлений Цикл
		Если ТипЗнч(Стр.Сотрудник) = Тип("СправочникСсылка.Пользователи") тогда
			Если МассивУникальныхПолучателей.Найти(Стр.Сотрудник) = неопределено Тогда
				МассивУникальныхПолучателей.Добавить(Стр.Сотрудник);
			КонецЕсли;
		Иначе
			СписокПользователей = Пользователи_sd_сервер.ПолучитьПользователейГруппы(Стр.Сотрудник);
			Для каждого СтрПолучатель из СписокПользователей Цикл
				Если МассивУникальныхПолучателей.Найти(СтрПолучатель) = неопределено Тогда
					МассивУникальныхПолучателей.Добавить(СтрПолучатель);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	СтандартныйЗаголовокПисьма = "Личные цели сотрудников: результаты работы "+ Символы.ПС;
	
	// затем для каждого такого получателя формируем письмо
	Для каждого Стр из МассивУникальныхПолучателей Цикл
		
		АдресУникальногоПолучателя = "";
		Для каждого Стр8 из Стр.КонтактнаяИнформация Цикл
			Если Стр8.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты Тогда
				АдресУникальногоПолучателя = Стр8.АдресЭП;
			КонецЕсли;
		КонецЦикла;
		
		Если АдресУникальногоПолучателя = "" Тогда
			ЗаписьЖурналаРегистрации("Ошибка отправки результатов исполнения личных целей", УровеньЖурналаРегистрации.Ошибка,,,"Не задан электронный адрес получателя "+Стр);
			Продолжить;
		КонецЕсли;
		
		ТекстПисьма = "На момент времени " + ТекущаяДата() + " личные цели сотрудников имеют следующий статус: <br><br> <table border=1><br>" + 
		"<tr><td>Цель</td><td>Начало работы</td><td>Срок достижения</td><td>Способ достижения</td><td>План</td><td>Факт</td></tr><br>";
		Для каждого Тема из ТаблицаУведомлений Цикл
			Если Пользователи_sd_сервер.ГруппаВключаетПользователя(Тема.Получатель, Стр) Тогда
				ТекстПисьма = ТекстПисьма + "<tr><td>"+Тема.Цель+"</td><td>"+Тема.НачалоРаботы+"</td><td>"+Тема.СрокДостижения+"</td><td>"+Тема.СпособДостижения+"</td><td>"+Тема.ПлановыйПоказательОстаток+"</td><td>"+Тема.ФактическийПоказательОстаток+"</td></tr><br>";
			КонецЕсли;
		КонецЦикла;
		ТекстПисьма = ТекстПисьма + "<br></table>";
		
		Если ТекстПисьма <> "" Тогда
			
			Попытка
				СУЗ = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
				
				УстановитьПривилегированныйРежим(Истина);
				Пароли = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(СУЗ, "ПарольSMTP");
				УстановитьПривилегированныйРежим(Ложь);
				
				ИПП = Новый ИнтернетПочтовыйПрофиль;
				ИПП.АдресСервераSMTP = СУЗ.СерверИсходящейПочты;
				ИПП.АутентификацияSMTP = СпособSMTPАутентификации.ПоУмолчанию;
				ИПП.ПарольSMTP = Пароли;
				ИПП.ПользовательSMTP = СУЗ.ПользовательSMTP;
				ИПП.ПортSMTP = СУЗ.ПортСервераИсходящейПочты;
				
				ИС = Новый ИнтернетПочтовоеСообщение;
				ИС.ИмяОтправителя = СУЗ.ИмяПользователя;
				ИС.Отправитель.Адрес = СУЗ.АдресЭлектроннойПочты;
				ИС.Получатели.Добавить(АдресУникальногоПолучателя);
				ИС.Тема = "DATACore: Личные цели сотрудников";
				ИС.Тексты.Добавить(СтандартныйЗаголовокПисьма + ТекстПисьма, ТипТекстаПочтовогоСообщения.HTML);
				ИС.ОбработатьТексты();
				ИП = Новый ИнтернетПочта;
				ИП.Подключиться(ИПП);
				ИП.Послать(ИС);
				ИП.Отключиться();
				
			Исключение
				ОО = ОписаниеОшибки();
				ЗаписьЖурналаРегистрации("Ошибка отправки результатов исполнения личных целей", УровеньЖурналаРегистрации.Ошибка,,,ОО);
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Евросиб(ДИТ) US 56866 ТА 85906 Сержантова А.С. 05.07.2024
Процедура НайтиИЗакрытьТемуПоСобытию(Контекст, СобытияЗакрытияДиалога) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СобытияЗакрывающиеДиалоги.ГУИДТемы КАК ГУИДТемы,
		|	СобытияЗакрывающиеДиалоги.Контекст КАК Контекст
		|ПОМЕСТИТЬ ВТ_ТемыПоСобытию
		|ИЗ
		|	РегистрСведений.СобытияЗакрывающиеДиалоги КАК СобытияЗакрывающиеДиалоги
		|ГДЕ
		|	СобытияЗакрывающиеДиалоги.Событие В(&ЗакрывающиеСобытия)
		|	И СобытияЗакрывающиеДиалоги.Контекст = &Контекст
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТемыПоСобытию.Контекст КАК Контекст,
		|	ВТ_ТемыПоСобытию.ГУИДТемы КАК ГУИДТемы,
		|	ДиалогиСообщения.ГУИДСообщения КАК ГУИДСообщения,
		|	ДиалогиСообщения.Получатель КАК Получатель
		|ИЗ
		|	ВТ_ТемыПоСобытию КАК ВТ_ТемыПоСобытию
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДиалогиЗаголовки КАК ДиалогиЗаголовки
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДиалогиСообщения КАК ДиалогиСообщения
		|			ПО ДиалогиЗаголовки.ГУИДТемы = ДиалогиСообщения.ГУИДТемы
		|		ПО ВТ_ТемыПоСобытию.ГУИДТемы = ДиалогиЗаголовки.ГУИДТемы
		|ИТОГИ ПО
		|	ГУИДТемы";
	
	Запрос.УстановитьПараметр("Контекст", Контекст);
	Запрос.УстановитьПараметр("ЗакрывающиеСобытия", СобытияЗакрытияДиалога);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если не РезультатЗапроса.Пустой() Тогда
		ВыборкаТема = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаТема.Следующий() Цикл 
			ЗакрытьТему(ВыборкаТема.ГУИДТемы, Истина); 
			
			ТекПользователь = Пользователи.ТекущийПользователь(); 
			ПросмотрТемы_Сообщение = "[СИСТЕМА]: Тема закрыта " + ТекПользователь; 
			
			ДобавитьСообщение(ВыборкаТема.ГУИДТемы, Новый УникальныйИдентификатор(), ТекПользователь, 
											ТекущаяДата(), ПросмотрТемы_Сообщение,,);
			
			ВыборкаСообщение = ВыборкаТема.Выбрать();
			Пока ВыборкаСообщение.Следующий() Цикл
				УстановитьСтатусСообщенияПрочитано(ВыборкаТема.ГУИДТемы, 
												   ВыборкаСообщение.ГУИДСообщения, 
												   ВыборкаСообщение.Получатель);   
			КонецЦикла;
			
		КонецЦикла;
	КонецЕсли;    

КонецПроцедуры

