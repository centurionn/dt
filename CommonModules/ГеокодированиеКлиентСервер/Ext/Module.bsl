Функция ПолучитьМассивАдресовЧерезГеокодерЯндекс(АдресПоиска, Знач НаселенныйПункт, Знач Родитель) Экспорт
	
	Соединение = УстановитьСоединениеСГеокодеромЯндекс();
	СтруктураРезультата = Новый Структура("СтруктураРезультатаЗапроса, МассивАдресов, ОписаниеОшибки", Неопределено, Новый Массив, "");
    
	Если Соединение = Неопределено Тогда
		Возврат Неопределено;
    КонецЕсли;	
	
	КлючAPIГеокодераЯндекс = ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьЗначениеКонстантыСУчетомКонтекста("КлючAPIГеокодераЯндекс");
	Если НЕ ЗначениеЗаполнено(КлючAPIГеокодераЯндекс) Тогда
		ОписаниеОшибки = "Не удалось выполнить запрос геокодера Яндекс. Не заполнен ключ API. Обратитесь в Техническую поддержку";
		//#Если Клиент Тогда
		//	ОбщегоНазначенияКлиент.СообщитьПользователю(ОписаниеОшибки);
		//#Иначе
		//	ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		//#КонецЕсли
		//Возврат Неопределено;     
		СтруктураРезультата.ОписаниеОшибки = ОписаниеОшибки;
		Возврат СтруктураРезультата;
	КонецЕсли;
	ПараметрЗапросаАдрес = СокрЛП(СтрШаблон("%1 %2", НаселенныйПункт, АдресПоиска));
	//ТелоОтвета = ПолучитьОтветГеокодераЯндекс(Соединение, КлючAPIГеокодераЯндекс, ПараметрЗапросаАдрес);
	СтруктураРезультатаЗапроса = ПолучитьОтветГеокодераЯндекс(Соединение, КлючAPIГеокодераЯндекс, ПараметрЗапросаАдрес); 
	Если ЗначениеЗаполнено(СтруктураРезультатаЗапроса.ОписаниеОшибки) Тогда
		СтруктураРезультата.ОписаниеОшибки = СтруктураРезультатаЗапроса.ОписаниеОшибки;	
		#Если Клиент Тогда                                                                                                                                          
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтруктураРезультата.ОписаниеОшибки);
		#Иначе
			ОбщегоНазначения.СообщитьПользователю(СтруктураРезультата.ОписаниеОшибки);
		#КонецЕсли
		Возврат СтруктураРезультата;
	КонецЕсли;
	СтруктураРезультата.СтруктураРезультатаЗапроса = СтруктураРезультатаЗапроса;
	ТелоОтвета = СтруктураРезультатаЗапроса.ТелоОтвета;
    
    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
    Результат = ПрочитатьJSON(ЧтениеJSON);
    ЧтениеJSON.Закрыть(); 
	Если Результат.Свойство("error") Тогда
		СтруктураРезультата.ОписаниеОшибки = СтрШаблон("Не удалось выполнить запрос геокодера Яндекс: %1", Результат.message);
		Возврат СтруктураРезультата;
	КонецЕсли;
	
	КоличествоНайденныхРезультатов = Число(Результат.response.GeoObjectCollection.metaDataProperty.GeocoderResponseMetaData.found);
	//Если ничего не нашли                                                                                                         
	МассивАдресов = Новый Массив;
	Если КоличествоНайденныхРезультатов = 0 Тогда
		//Возврат МассивАдресов;
		Возврат СтруктураРезультата;
	Иначе             
		Для каждого featureMember Из Результат.response.GeoObjectCollection.featureMember Цикл
			НайденНаселенныйПункт = Ложь;
			НайденРодитель = Ложь;
			НаселенныйПункт = "";
			
			СтруктураЛокацииПоГеокодеру = ПолучитьСтруктуруЛокации(featureMember.GeoObject.metaDataProperty.GeocoderMetaData.Address.Components);
			Если Не ЗначениеЗаполнено(СтруктураЛокацииПоГеокодеру.НаселенныйПункт)
				ИЛИ Не ЗначениеЗаполнено(СтруктураЛокацииПоГеокодеру.ЛокацияВышестоящегоУровня) Тогда
				Продолжить;
			КонецЕсли;
			
			Если НаселенныйПункт = "" Тогда 
				//Если featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.Свойство("AdministrativeArea")
				//	И featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.AdministrativeArea.Свойство("SubAdministrativeArea") Тогда
				//	Если НЕ featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.AdministrativeArea.SubAdministrativeArea.Свойство("Locality")
				//		ИЛИ (НЕ featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.AdministrativeArea.SubAdministrativeArea.Locality.Свойство("LocalityName")
				//			И (НЕ featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.AdministrativeArea.SubAdministrativeArea.Locality.Свойство("DependentLocality"))) Тогда
				//		Продолжить;
				//	КонецЕсли;
				//	Если featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.AdministrativeArea.SubAdministrativeArea.Locality.Свойство("LocalityName") Тогда
				//		ИмяЛокации = featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.AdministrativeArea.SubAdministrativeArea.Locality.LocalityName;	
				//	Иначе
				//		ИмяЛокации = featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.AdministrativeArea.SubAdministrativeArea.Locality.DependentLocality.DependentLocalityName;
				//	КонецЕсли;
				//	ЛокацияВышестоящегоУровня = featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.AdministrativeArea.AdministrativeAreaName;
				//	Страна = featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.CountryName;
				//ИначеЕсли featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.Свойство("AdministrativeArea")
				//	И featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.AdministrativeArea.Свойство("Locality")
				//	И featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.AdministrativeArea.Locality.Свойство("LocalityName") Тогда
				//	ИмяЛокации = featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.AdministrativeArea.Locality.LocalityName;
				//	ЛокацияВышестоящегоУровня = featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.AdministrativeArea.AdministrativeAreaName;
				//	Страна = featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.CountryName; 
				//Иначе
				//	Продолжить;
				//КонецЕсли;
			
				Координаты = СтрРазделить(featureMember.GeoObject.Point.pos, " ");
				Долгота = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Координаты[0]);
				Широта = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Координаты[1]);
				//СтруктураЛокации = ГеокодированиеСервер.НайтиЛокацию(ИмяЛокации, ЛокацияВышестоящегоУровня, Долгота, Широта);
				СтруктураЛокации = ГеокодированиеСервер.НайтиЛокацию(СтруктураЛокацииПоГеокодеру.НаселенныйПункт, СтруктураЛокацииПоГеокодеру.ЛокацияВышестоящегоУровня, Долгота, Широта);
																	 
				Если СтруктураЛокации = Неопределено Тогда
					//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("не найдена локация %1 для подбора адреса в справочнике «Локации»", ИмяЛокации));
					//Возврат Неопределено;
					//СтруктураПараметров = Новый Структура("Наименование, Регион, Страна, Широта, Долгота", ИмяЛокации, ЛокацияВышестоящегоУровня, Страна, 0, 0);
					//ЛокацияСсылка = ГеокодированиеСервер.НайтиДобавитьНаселенныйПункт(СтруктураПараметров);
					//ГеокодированиеСервер.ПолучитьКоординатыЛокацииЧерезГеокодер(ЛокацияСсылка);
					//СтруктураЛокации = ГеокодированиеСервер.НайтиЛокацию(ИмяЛокации, ЛокацияВышестоящегоУровня);\
					//НаселенныйПункт = ИмяЛокации;
					НаселенныйПункт = СтруктураЛокацииПоГеокодеру.НаселенныйПункт;
					//Родитель = ЛокацияВышестоящегоУровня;
					Родитель = СтруктураЛокацииПоГеокодеру.ЛокацияВышестоящегоУровня;
					НаселенныйПунктСсылка = ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
				Иначе
					НаселенныйПункт = СтруктураЛокации.Наименование;
					Родитель = СтруктураЛокации.РодительНаименование;
					НаселенныйПунктСсылка = СтруктураЛокации.НаселенныйПунктСсылка;
				КонецЕсли;
			КонецЕсли;          
			КомпонентыАдреса = Новый Массив;
			Для каждого AddressComponent Из featureMember.GeoObject.metaDataProperty.GeocoderMetaData.Address.Components Цикл
				НаименованиеВГеокодере = СтрЗаменить(ВРег(AddressComponent.Name), "Ё","Е");    
				НаселенныйПунктВРег = ВРег(НаселенныйПункт);                            
				РодительВРег = ВРег(Родитель);
				НайденНаселенныйПункт = НайденНаселенныйПункт ИЛИ СтрНайти(НаименованиеВГеокодере, НаселенныйПунктВРег) > 0 ИЛИ СтрНайти(НаселенныйПунктВРег, НаименованиеВГеокодере) > 0;
				НайденРодитель = НайденРодитель ИЛИ СтрНайти(НаименованиеВГеокодере, РодительВРег) > 0 ИЛИ СтрНайти(РодительВРег, НаименованиеВГеокодере) > 0;
				//Если НайденНаселенныйПункт 
				//	И НайденРодитель Тогда
				//	Прервать;
				//КонецЕсли;   
				КомпонентыАдреса.Добавить(Новый Структура("ВидНайденногоТопонима, Имя", AddressComponent.kind, AddressComponent.name));
			КонецЦикла;
			Если Не НайденНаселенныйПункт ИЛИ Не НайденРодитель Тогда
				Продолжить;
			КонецЕсли;
			МассивАдресов.Добавить(Новый Структура("Адрес, Страна, Долгота, Широта, НаселенныйПунктСсылка, ЛокацияВышестоящегоУровня, НаселенныйПункт, КомпонентыАдреса",
													featureMember.GeoObject.metaDataProperty.GeocoderMetaData.text,
													СтруктураЛокацииПоГеокодеру.Страна,
													Долгота,
													Широта,
													НаселенныйПунктСсылка,
													СтруктураЛокацииПоГеокодеру.ЛокацияВышестоящегоУровня,
													НаселенныйПункт,
													КомпонентыАдреса));
		КонецЦикла;
	КонецЕсли;
	
	СтруктураРезультата.МассивАдресов = МассивАдресов;
	Возврат СтруктураРезультата;
	//Возврат МассивАдресов;
    
КонецФункции 

Функция ПолучитьМассивЖелезнодорожныхСтанцийЧерезГеокодерЯндекс(ЖДСтанцияНаименование, ЖДСтанцияЖДДорога, ЖДСтанцияСтрана, ЖДСтанцияСтранаКодАльфа2) Экспорт

	Соединение = УстановитьСоединениеСГеокодеромЯндекс();
    
	Если Соединение = Неопределено Тогда
		Возврат Неопределено;
    КонецЕсли;	
	КлючAPIГеокодераЯндекс = ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьЗначениеКонстантыСУчетомКонтекста("КлючAPIГеокодераЯндекс");
	Если НЕ ЗначениеЗаполнено(КлючAPIГеокодераЯндекс) Тогда
		#Если Клиент Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось выполнить запрос геокодера Яндекс. Не заполнен ключ API. Обратитесь в Техническую поддержку");
		#Иначе
			ОбщегоНазначения.СообщитьПользователю("Не удалось выполнить запрос геокодера Яндекс. Не заполнен ключ API. Обратитесь в Техническую поддержку");
		#КонецЕсли
		Возврат Неопределено;
	КонецЕсли;
	ПараметрЗапросаАдрес = СтрШаблон("%1", ЖДСтанцияНаименование);
	//ТелоОтвета = ПолучитьОтветГеокодераЯндекс(Соединение, КлючAPIГеокодераЯндекс,ПараметрЗапросаАдрес, Новый Структура("КоличествоРезультатов", 50));
	СтруктураРезультатаЗапроса = ПолучитьОтветГеокодераЯндекс(Соединение, КлючAPIГеокодераЯндекс,ПараметрЗапросаАдрес, Новый Структура("КоличествоРезультатов, НеОтправлятьПовторныеНезаписанныеЗапросы", 50, Истина));;
	Если ЗначениеЗаполнено(СтруктураРезультатаЗапроса.ОписаниеОшибки) Тогда
		СтруктураРезультатаЗапроса.Вставить("МассивЖДСтанций", Новый Массив);	
		#Если Клиент Тогда                                                                                                                                          
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтруктураРезультатаЗапроса.ОписаниеОшибки);
		#Иначе
			ОбщегоНазначения.СообщитьПользователю(СтруктураРезультатаЗапроса.ОписаниеОшибки);
		#КонецЕсли
		Возврат СтруктураРезультатаЗапроса;
	КонецЕсли;
	ТелоОтвета = СтруктураРезультатаЗапроса.ТелоОтвета;
    
    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
    Результат = ПрочитатьJSON(ЧтениеJSON);
    ЧтениеJSON.Закрыть();           
	
	КоличествоНайденныхРезультатов = Число(Результат.response.GeoObjectCollection.metaDataProperty.GeocoderResponseMetaData.found);
	//Если ничего не нашли                                                                                                         
	МассивЖДСтанций = Новый Массив;
	СтруктураРезультатаЗапроса.Вставить("МассивЖДСтанций", МассивЖДСтанций);
	Если КоличествоНайденныхРезультатов = 0 Тогда
		//Возврат МассивЖДСтанций;
		Возврат СтруктураРезультатаЗапроса;
	Иначе             
		Для каждого featureMember Из Результат.response.GeoObjectCollection.featureMember Цикл
			Если featureMember.GeoObject.metaDataProperty.GeocoderMetaData.kind = "railway_station" Тогда
				Если НЕ Результат.response.GeoObjectCollection.featureMember[0].GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Свойство("Country")
					ИЛИ НЕ Результат.response.GeoObjectCollection.featureMember[0].GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.CountryNameCode = ЖДСтанцияСтранаКодАльфа2 Тогда
					Продолжить;	
				КонецЕсли;
				Координаты = СтрРазделить(featureMember.GeoObject.Point.pos, " "); 
				Наименование = featureMember.GeoObject.name;
				Если НЕ СтроковыеФункцииКлиентСервер.ТолькоЛатиницаВСтроке(Наименование,," ()-"+Символ(8212))
					И НЕ СтроковыеФункцииКлиентСервер.ТолькоКириллицаВСтроке(Наименование,," ()-"+Символ(8212))Тогда
					Продолжить;
				КонецЕсли;
				МассивЖДСтанций.Добавить(Новый Структура("Долгота, Широта, Наименование", Координаты[0], Координаты[1], Наименование)); 
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат СтруктураРезультатаЗапроса;
	
КонецФункции

Функция ПолучитьМассивНаселенныхПунктовЧерезГеокодерЯндекс(Координаты, ТолькоЛатиницаКириллицаВСтроке = Истина) Экспорт
		
	Соединение = УстановитьСоединениеСГеокодеромЯндекс();
    
	Если Соединение = Неопределено Тогда
		Возврат Неопределено;
    КонецЕсли;	
	
	КлючAPIГеокодераЯндекс = ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьЗначениеКонстантыСУчетомКонтекста("КлючAPIГеокодераЯндекс");
	Если НЕ ЗначениеЗаполнено(КлючAPIГеокодераЯндекс) Тогда
		#Если Клиент Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось выполнить запрос геокодера Яндекс. Не заполнен ключ API. Обратитесь в Техническую поддержку");
		#Иначе
			ОбщегоНазначения.СообщитьПользователю("Не удалось выполнить запрос геокодера Яндекс. Не заполнен ключ API. Обратитесь в Техническую поддержку");
		#КонецЕсли
		Возврат Неопределено;
	КонецЕсли;
	ПараметрЗапросаАдрес = СтрШаблон("%1", Координаты);
	//ТелоОтвета = ПолучитьОтветГеокодераЯндекс(Соединение, КлючAPIГеокодераЯндекс, ПараметрЗапросаАдрес);
	СтруктураРезультатаЗапроса = ПолучитьОтветГеокодераЯндекс(Соединение, КлючAPIГеокодераЯндекс, ПараметрЗапросаАдрес, Новый Структура("НеОтправлятьПовторныеНезаписанныеЗапросы", Истина));
	Если ЗначениеЗаполнено(СтруктураРезультатаЗапроса.ОписаниеОшибки) Тогда
		#Если Клиент Тогда                                                                                                                                          
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтруктураРезультатаЗапроса.ОписаниеОшибки);
		#Иначе
			ОбщегоНазначения.СообщитьПользователю(СтруктураРезультатаЗапроса.ОписаниеОшибки);
		#КонецЕсли
		Возврат СтруктураРезультатаЗапроса;
	КонецЕсли;
	ТелоОтвета = СтруктураРезультатаЗапроса.ТелоОтвета;
    
    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
    Результат = ПрочитатьJSON(ЧтениеJSON);
    ЧтениеJSON.Закрыть();           
	
	КоличествоНайденныхРезультатов = Число(Результат.response.GeoObjectCollection.metaDataProperty.GeocoderResponseMetaData.found);
	//Если ничего не нашли                                                                                                         
	МассивСтруктурНаселенныхПунктов = Новый Массив;
	МассивСтруктурРайонов = Новый Массив;
	МассивНаименованийРайонов = Новый Массив;
	Если КоличествоНайденныхРезультатов = 0 Тогда
		Возврат МассивСтруктурНаселенныхПунктов;
	Иначе             
		Для каждого featureMember Из Результат.response.GeoObjectCollection.featureMember Цикл
			Если featureMember.GeoObject.metaDataProperty.GeocoderMetaData.kind = "locality" Тогда
				Координаты = СтрРазделить(featureMember.GeoObject.Point.pos, " ");
				Долгота = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Координаты[0]);
				Широта = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Координаты[1]); 
