				СтруктураЛокацииПоГеокодеру = ПолучитьСтруктуруЛокации(featureMember.GeoObject.metaDataProperty.GeocoderMetaData.Address.Components);
				//МассивСтруктурНаселенныхПунктов.Добавить(Новый Структура("Наименование, Регион, Страна, Долгота, Широта, Приоритет", Наименование, НаименованиеРегиона, featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.CountryName, Долгота, Широта, 1)); 
				МассивСтруктурНаселенныхПунктов.Добавить(Новый Структура("Наименование, Регион, Страна, Долгота, Широта, Приоритет", 
															СтруктураЛокацииПоГеокодеру.НаселенныйПункт,
															СтруктураЛокацииПоГеокодеру.ЛокацияВышестоящегоУровня,
