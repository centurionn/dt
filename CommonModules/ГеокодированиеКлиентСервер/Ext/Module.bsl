				Координаты = СтрРазделить(featureMember.GeoObject.Point.pos, " ");                   
				Долгота = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Координаты[0]);
				Широта = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Координаты[1]);
				СтруктураЛокацииПоГеокодеру = ПолучитьСтруктуруЛокации(featureMember.GeoObject.metaDataProperty.GeocoderMetaData.Address.Components);
				//Если featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.Свойство("AdministrativeArea") Тогда
				//	Наименование = featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.AdministrativeArea.SubAdministrativeArea.SubAdministrativeAreaName;
				Наименование = СтруктураЛокацииПоГеокодеру.НаселенныйПункт;
					Если ТолькоЛатиницаКириллицаВСтроке
						И НЕ СтроковыеФункцииКлиентСервер.ТолькоЛатиницаВСтроке(Наименование,," ()-"+Символ(8212))
						И НЕ СтроковыеФункцииКлиентСервер.ТолькоКириллицаВСтроке(Наименование,," ()-"+Символ(8212))Тогда
						Продолжить;
					КонецЕсли;
				//Иначе
				//	Наименование = Неопределено;
				//КонецЕсли;   
				//Если featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.Свойство("AdministrativeArea") Тогда
				//	НаименованиеРегиона = featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.AdministrativeArea.AdministrativeAreaName;
				НаименованиеРегиона = СтруктураЛокацииПоГеокодеру.ЛокацияВышестоящегоУровня;
					Если ТолькоЛатиницаКириллицаВСтроке
						И НЕ СтроковыеФункцииКлиентСервер.ТолькоЛатиницаВСтроке(НаименованиеРегиона,," ()-"+Символ(8212))
						И НЕ СтроковыеФункцииКлиентСервер.ТолькоКириллицаВСтроке(НаименованиеРегиона,," ()-"+Символ(8212))Тогда
						Продолжить;
					КонецЕсли;
				//Иначе
				//	НаименованиеРегиона = Неопределено;
				//КонецЕсли;
				//МассивСтруктурРайонов.Добавить(Новый Структура("Наименование, Регион, Страна, Долгота, Широта, Приоритет", Наименование, НаименованиеРегиона, featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.CountryName, Долгота, Широта, 2)); 
				МассивСтруктурРайонов.Добавить(Новый Структура("Наименование, Регион, Страна, Долгота, Широта, Приоритет", 
												СтруктураЛокацииПоГеокодеру.НаселенныйПункт, 
												СтруктураЛокацииПоГеокодеру.ЛокацияВышестоящегоУровня,
												СтруктураЛокацииПоГеокодеру.Страна,
												Долгота,
												Широта,
												2)); 
				//МассивНаименованийРайонов.Добавить(featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.AdministrativeArea.SubAdministrativeArea.SubAdministrativeAreaName);
				//МассивНаименованийРайонов.Добавить(featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.AdministrativeArea.SubAdministrativeArea.SubAdministrativeAreaName);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если МассивСтруктурНаселенныхПунктов.Количество() > 0 Тогда
		СтруктураРезультатаЗапроса.Вставить("МассивСтруктурРезультата", МассивСтруктурНаселенныхПунктов);
		//Возврат МассивСтруктурНаселенныхПунктов;
	Иначе
		СтруктураРезультатаЗапроса.Вставить("МассивСтруктурРезультата", МассивСтруктурРайонов);
		//Возврат МассивСтруктурРайонов;
	КонецЕсли;
	Возврат СтруктураРезультатаЗапроса;

