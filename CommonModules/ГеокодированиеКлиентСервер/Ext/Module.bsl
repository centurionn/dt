Функция ПолучитьМассивТопонимовЧерезГеокодерЯндекс(ПараметрыЗапроса) Экспорт
	СтруктураРезультата = Новый Структура("ИдентификаторЗапроса, МассивСтруктурТопонимов, ОписаниеОшибки", "", Новый Массив, "");
	Соединение = УстановитьСоединениеСГеокодеромЯндекс();
    
	Если Соединение = Неопределено Тогда
		//Возврат Неопределено;
		Возврат СтруктураРезультата;
    КонецЕсли;	
	
	КлючAPIГеокодераЯндекс = ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьЗначениеКонстантыСУчетомКонтекста("КлючAPIГеокодераЯндекс");
	Если НЕ ЗначениеЗаполнено(КлючAPIГеокодераЯндекс) Тогда                                                                                                       
		ОписаниеОшибки = "Не удалось выполнить запрос геокодера Яндекс. Не заполнен ключ API. Обратитесь в Техническую поддержку";
		#Если Клиент Тогда                                                                                                                                          
			ОбщегоНазначенияКлиент.СообщитьПользователю(ОписаниеОшибки);
		#Иначе
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		#КонецЕсли
		//Возврат Неопределено;
		СтруктураРезультата.ОписаниеОшибки = ОписаниеОшибки;
		Возврат СтруктураРезультата;
	КонецЕсли;
	ПараметрЗапросаАдрес = СтрШаблон("%1", ПараметрыЗапроса.Геокод);
	ПараметрыЗапроса.Вставить("НеОтправлятьПовторныеНезаписанныеЗапросы", Истина);
	//ТелоОтвета = ПолучитьОтветГеокодераЯндекс(Соединение, КлючAPIГеокодераЯндекс, ПараметрЗапросаАдрес, ПараметрыЗапроса);
	СтруктураРезультатаЗапроса = ПолучитьОтветГеокодераЯндекс(Соединение, КлючAPIГеокодераЯндекс, ПараметрЗапросаАдрес, ПараметрыЗапроса);
	Если ЗначениеЗаполнено(СтруктураРезультатаЗапроса.ОписаниеОшибки) Тогда
		СтруктураРезультата.ОписаниеОшибки = СтруктураРезультатаЗапроса.ОписаниеОшибки;	
		#Если Клиент Тогда                                                                                                                                          
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтруктураРезультата.ОписаниеОшибки);
		#Иначе
			ОбщегоНазначения.СообщитьПользователю(СтруктураРезультата.ОписаниеОшибки);
		#КонецЕсли
		Возврат СтруктураРезультата;
	КонецЕсли;
	ТелоОтвета = СтруктураРезультатаЗапроса.ТелоОтвета;
    
    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
    Результат = ПрочитатьJSON(ЧтениеJSON);
    ЧтениеJSON.Закрыть();           
	
	КоличествоНайденныхРезультатов = Число(Результат.response.GeoObjectCollection.metaDataProperty.GeocoderResponseMetaData.found);
	Если Результат.response.GeoObjectCollection.metaDataProperty.GeocoderResponseMetaData.Свойство("suggest") Тогда
		#Если Клиент Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Вариант запроса, исправленный сервисом исправления опечаток: "+ Результат.response.GeoObjectCollection.metaDataProperty.GeocoderResponseMetaData.suggest);
		#Иначе
			ОбщегоНазначения.СообщитьПользователю("Вариант запроса, исправленный сервисом исправления опечаток: "+ Результат.response.GeoObjectCollection.metaDataProperty.GeocoderResponseMetaData.suggest);
		#КонецЕсли
	КонецЕсли;
	//Если ничего не нашли                                                                                                         
	МассивСтруктурТопонимов = Новый Массив;
	Если КоличествоНайденныхРезультатов = 0 Тогда
		Возврат МассивСтруктурТопонимов;
	Иначе             
		Для каждого featureMember Из Результат.response.GeoObjectCollection.featureMember Цикл
			Координаты = СтрРазделить(featureMember.GeoObject.Point.pos, " ");
			СтруктураТопонима = Новый Структура("Наименование, Регион, Страна, Долгота, Широта, Приоритет, Вид");
			Наименование = featureMember.GeoObject.name;
			Если НЕ СтроковыеФункцииКлиентСервер.ТолькоЛатиницаВСтроке(Наименование,," ()-"+Символ(8212))
				И НЕ СтроковыеФункцииКлиентСервер.ТолькоКириллицаВСтроке(Наименование,," ()-"+Символ(8212))Тогда
				Продолжить;
			КонецЕсли; 
			СтруктураЛокацииПоДаннымГеокодера = ПолучитьСтруктуруЛокации(featureMember.GeoObject.metaDataProperty.GeocoderMetaData.Address.Components);
			//Если featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Свойство("country") Тогда
			//	СтруктураТопонима.Страна = featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.CountryName;
			//	Если featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.Свойство("AdministrativeArea") Тогда
			//		СтруктураТопонима.Регион = featureMember.GeoObject.metaDataProperty.GeocoderMetaData.AddressDetails.Country.AdministrativeArea.AdministrativeAreaName;	
			//	КонецЕсли;
			//КонецЕсли; 
			СтруктураТопонима.Наименование = Наименование;
			СтруктураТопонима.Страна = СтруктураЛокацииПоДаннымГеокодера.Страна;
			СтруктураТопонима.Регион = СтруктураЛокацииПоДаннымГеокодера.ЛокацияВышестоящегоУровня;
			СтруктураТопонима.Долгота = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Координаты[0]);
			СтруктураТопонима.Широта = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Координаты[1]);
			СтруктураТопонима.Вид = featureMember.GeoObject.metaDataProperty.GeocoderMetaData.kind;
			МассивСтруктурТопонимов.Добавить(СтруктураТопонима); 
		КонецЦикла;
	КонецЕсли;
	СтруктураРезультата.ИдентификаторЗапроса = СтруктураРезультатаЗапроса.ИдентификаторЗапроса;
	СтруктураРезультата.МассивСтруктурТопонимов = МассивСтруктурТопонимов;
	Возврат СтруктураРезультата;

КонецФункции

Функция УстановитьСоединениеСГеокодеромЯндекс()
	АдресГеокодераЯндекс = ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьЗначениеКонстанты("АдресГеокодераЯндекс");
	Попытка		
	    Соединение = Новый HTTPСоединение(АдресГеокодераЯндекс, , , , , , Новый ЗащищенноеСоединениеOpenSSL());
	Исключение		
		#Если Клиент Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось установить соединение с сервером геодирования Яндекс. Проверьте правильность адреса сервера.");
		#Иначе
			ОбщегоНазначения.СообщитьПользователю("Не удалось установить соединение с сервером геодирования Яндекс. Проверьте правильность адреса сервера.");
		#КонецЕсли
        Соединение = Неопределено;
	Конецпопытки;
	Возврат Соединение;
КонецФункции     

Функция ПолучитьОтветГеокодераЯндекс(Соединение, КлючAPIГеокодераЯндекс, АдресПоиска, ДополнительныеПараметры = Неопределено)
	
	ИдентификаторЗапроса = Новый УникальныйИдентификатор;
	СтруктураРезультата = Новый Структура("ИдентификаторЗапроса, ТелоОтвета, ОписаниеОшибки", ИдентификаторЗапроса, Неопределено, "");
	ШаблонАдресРесурсаЗапроса = "/1.x/?format=json&apikey=%1&geocode=%2";
	ДополнительныеПараметрыСтрокой = "";
	Если ДополнительныеПараметры <> Неопределено Тогда
		Если ДополнительныеПараметры.Свойство("ВидТопонима") Тогда
			//kind	Только если в параметре geocode указаны координаты. Вид необходимого топонима.
			//Список допустимых значений:
			//house — дом;
			//street — улица;
			//metro — станция метро;
			//district — район города;
			//locality — населенный пункт (город/поселок/деревня/село/...).
			ДополнительныеПараметрыСтрокой = ДополнительныеПараметрыСтрокой + "&kind="+ДополнительныеПараметры.ВидТопонима;
		КонецЕсли;
		Если ДополнительныеПараметры.Свойство("КоличествоРезультатов") Тогда
			ДополнительныеПараметрыСтрокой = ДополнительныеПараметрыСтрокой + "&results="+ДополнительныеПараметры.КоличествоРезультатов;
		КонецЕсли;
		Если ДополнительныеПараметры.Свойство("НеОтправлятьПовторныеНезаписанныеЗапросы") Тогда
			СтатусЗапросаГеокодера = ГеокодированиеВызовСервера.ПроверитьГеокодПоИсторииЗапросов(АдресПоиска+ДополнительныеПараметрыСтрокой);
			Если СтатусЗапросаГеокодера = ПредопределенноеЗначение("Перечисление.СтатусыОбработкиЗапросаГеокодера.ОтветПолученНеЗаписан") Тогда
				СтруктураРезультата.ОписаниеОшибки = СтрШаблон("При предыдущей отправке аналогичного значения в геокодер по запросу %1 системе не удалось найти подходящий условиям поиска ответ. Необходимо изменить исходные данные для отправки в геокодер, либо заполнить требуемые значения в ручном режиме", АдресПоиска);
				Возврат СтруктураРезультата;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	АдресРесурсаЗапроса = СтрШаблон(ШаблонАдресРесурсаЗапроса, КлючAPIГеокодераЯндекс, АдресПоиска+ДополнительныеПараметрыСтрокой);
	
	ТелоОтвета = "";
	Попытка
		Запрос = Новый HTTPЗапрос;
		Запрос.АдресРесурса = АдресРесурсаЗапроса; 
		Ответ = Соединение.Получить(Запрос);
		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
		Соединение = Неопределено;		
	Исключение
		ОписаниеОшибки = ИнформацияОбОшибке().Описание;
		СтруктураРезультата.ОписаниеОшибки = ОписаниеОшибки;
	КонецПопытки;
	СтруктураРезультата.ТелоОтвета = ТелоОтвета;
	ГеокодированиеСервер.ЗаписатьЛогГеокодирования(ИдентификаторЗапроса, АдресПоиска + ДополнительныеПараметрыСтрокой);
	Возврат СтруктураРезультата;
	
КонецФункции 

Функция ПолучитьСтруктуруЛокации(Components)
	КомпонентыАдреса = Новый Массив;
	Для каждого AddressComponent Из Components Цикл
		КомпонентыАдреса.Добавить(Новый Структура("ВидНайденногоТопонима, Имя", AddressComponent.kind, AddressComponent.name));
	КонецЦикла;              
	
	//страна                 
	ИспользуемыйЭлементЛокации = 0;
	Для каждого КомпонентАдреса Из КомпонентыАдреса Цикл
		Если КомпонентАдреса.ВидНайденногоТопонима = "country" Тогда
			Страна = КомпонентАдреса.Имя;
			ИспользуемыйЭлементЛокации = КомпонентыАдреса.Найти(КомпонентАдреса);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	//лву
	ЛокацияВышестоящегоУровня = Неопределено;
	Для каждого КомпонентАдреса Из КомпонентыАдреса Цикл
		Если КомпонентАдреса.ВидНайденногоТопонима = "province" Тогда
			ЛокацияВышестоящегоУровня = КомпонентАдреса.Имя;
			ИспользуемыйЭлементЛокации = КомпонентыАдреса.Найти(КомпонентАдреса);
		КонецЕсли;
	КонецЦикла;                                               
	//Евросиб - АСуслов 30.10.2023 14:28:43 #76794
