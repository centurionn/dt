Процедура ЗаменитьНеВалидныеНакладныеВАкцептах() Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	АкцептУслуги.Ссылка КАК Акцепт
		|ПОМЕСТИТЬ ВТ_АктуальныеАкцепты
		|ИЗ
		|	Документ.Акцепт.Услуги КАК АкцептУслуги
		|ГДЕ
		|	АкцептУслуги.Ссылка.Проведен
		|	И АкцептУслуги.Ссылка.СторнируемыйАкцепт = ЗНАЧЕНИЕ(Документ.Акцепт.ПустаяСсылка)
		|	И НЕ АкцептУслуги.Ссылка В
		|				(ВЫБРАТЬ
		|					Акцепт.СторнируемыйАкцепт КАК СторнируемыйАкцепт
		|				ИЗ
		|					Документ.Акцепт КАК Акцепт
		|				ГДЕ
		|					Акцепт.Проведен)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_АктуальныеАкцепты.Акцепт КАК Акцепт,
		|	АкцептУслуги.ТранспортныйДокумент КАК ТранспортныйДокумент,
		|	АкцептУслуги.ГУИД КАК ГУИД,
		|	АкцептУслуги.ТранспортныйДокумент.НомерТранспортногоДокумента КАК НомерТранспортногоДокумента,
		|	АкцептУслуги.ТранспортныйДокумент.ДатаТранспортногоДокумента КАК ДатаТранспортногоДокумента
		|ИЗ
		|	ВТ_АктуальныеАкцепты КАК ВТ_АктуальныеАкцепты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Акцепт.Услуги КАК АкцептУслуги
		|		ПО ВТ_АктуальныеАкцепты.Акцепт = АкцептУслуги.Ссылка
		|			И (АкцептУслуги.ТранспортныйДокумент.ПометкаУдаления
		|				ИЛИ АкцептУслуги.ТранспортныйДокумент.НакладнаяЭТРАН.ПометкаУдаления
		|				ИЛИ НЕ АкцептУслуги.ТранспортныйДокумент.НакладнаяЭТРАН.ТекущееСостояниеНакладной.ДействующийСтатус)
		|			И (АкцептУслуги.Сделка = ЗНАЧЕНИЕ(Документ.Сделка.ПустаяСсылка))
//Евросиб Гудкова( 08.09.2022 Ticket№ 54710
//				   |	И АкцептУслуги.ВыгруженаВРИТМ = ЛОЖЬ
				   |	И АкцептУслуги.Неурег <> ЗНАЧЕНИЕ(Справочник.ПричиныНеурегулированныхРасходов.ОтработкаВРИТМ)
// Евросиб Гудкова)
		|ИТОГИ ПО
		|	Акцепт,
		|	ТранспортныйДокумент";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаАкцепт = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаАкцепт.Следующий() Цикл
		
		АкцептОб = ВыборкаАкцепт.Акцепт.ПолучитьОбъект();
		
		ВыборкаТранспортныйДокумент = ВыборкаАкцепт.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		НеобходимаЗапись = Ложь;
		
		Пока ВыборкаТранспортныйДокумент.Следующий() Цикл
			
			НомерТД = ВыборкаТранспортныйДокумент.НомерТранспортногоДокумента;
			ДатаТД  = ВыборкаТранспортныйДокумент.ДатаТранспортногоДокумента;
			
			КорректныйТД = ТранспортныеДокументы_сервер.НайтиТранспортныйДокумент(НомерТД,ДатаТД, Перечисления.ВидыОперацийТранспортныхДокументов.ЖДНакладная);
			
			Если КорректныйТД = Неопределено Тогда
				Продолжить;
			КонецЕсли;	
			
			ВыборкаДетальныеЗаписи = ВыборкаТранспортныйДокумент.Выбрать();
	
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				СтруктураПоиска = Новый Структура("ГУИД",ВыборкаДетальныеЗаписи.ГУИД);
				НайденныеСтроки = АкцептОб.Услуги.НайтиСтроки(СтруктураПоиска);
				Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
					НайденнаяСтрока.ТранспортныйДокумент = КорректныйТД;
					НеобходимаЗапись = Истина;
				КонецЦикла;	
			КонецЦикла;
			
		КонецЦикла;
		
		АкцептОб.ОбменДанными.Загрузка = Истина;
		
		Если НеобходимаЗапись Тогда
			Попытка
				АкцептОб.Записать();
			Исключение
