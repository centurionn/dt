Функция ПолучитьСписокИСФ_XML_ФНС(НачалоПериода, КонецПериода) Экспорт
	
	//Получение списка СФ, у которых есть XML в формате ФНС
	ТипЧисло10 = ОбщегоНазначения.ОписаниеТипаЧисло(10);
	
	ИмяОперации = "GetEtranInvoicesFNSWithXML";
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("date_from",	НачалоПериода);
	СтруктураПараметров.Вставить("date_to",		КонецПериода);
		
	ЗапросXML = ПолучитьТекстЗапросаВебСервису(СтруктураПараметров);
	
	ОтветXML = ВебСервисы_сервер.ЗапроситьРИТМ(ИмяОперации, ЗапросXML);
	Если СтрДлина(ОтветXML) < 48 Тогда
		ТаблицаДанных = Новый ТаблицаЗначений;
		ТаблицаДанных.Колонки.Добавить("НакладнаяИД", ТипЧисло10);
		Возврат ТаблицаДанных;
	КонецЕсли; 
	
	ТаблицаДанных = ВебСервисы_сервер.УниверсальныйПарсерXML(ОтветXML, "invoiceID");
	
	// Добавим колонку с числовыми значениями идентификаторов
	ТаблицаДанных.Колонки.Добавить("НакладнаяИД", ТипЧисло10);
	
	// Преобразуем строковые значения идентификаторов в числовые
	Для Каждого ТекущаяСтрока Из ТаблицаДанных Цикл
		ТекущаяСтрока.НакладнаяИД = ТипЧисло10.ПривестиЗначение(ТекущаяСтрока.invoiceID);
	КонецЦикла;	
	
	Возврат ТаблицаДанных;
	
КонецФункции

Функция ПолучитьТекстЗапросаВебСервису(ПараметрыЗапроса = Неопределено) Экспорт
	
	Запись = Новый ЗаписьXML;
		
	Запись.УстановитьСтроку("windows-1251"); 
	Запись.ЗаписатьОбъявлениеXML();
	
	Запись.ЗаписатьНачалоЭлемента("root");
	
	Если ПараметрыЗапроса <> Неопределено Тогда
		Для Каждого Параметр Из ПараметрыЗапроса Цикл
			ДобавитьЭлементВФайл(Запись, "R", "", Новый Структура("nmParams, valueParams", Параметр.Ключ, Параметр.Значение));
		КонецЦикла;
	КонецЕсли;
	
	Запись.ЗаписатьКонецЭлемента();
	
	Возврат Запись.Закрыть();
	
КонецФункции

Процедура ДобавитьЭлементВФайл(Файл, ИмяЭлемента, Значение, Атрибуты = Неопределено)
	
	Файл.ЗаписатьНачалоЭлемента(ИмяЭлемента);
	
	Если Атрибуты <> Неопределено Тогда
		Для Каждого Атрибут Из Атрибуты Цикл
			ДобавитьАтрибутВФайл(Файл, Атрибут.Ключ, Атрибут.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Файл.ЗаписатьТекст(XMLСтрока(Значение));		
	Файл.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Процедура ДобавитьАтрибутВФайл(Файл, ИмяЭлемента, Значение)
	
	Файл.ЗаписатьНачалоАтрибута(ИмяЭлемента);		
	Файл.ЗаписатьТекст(XMLСтрока(Значение));		
	Файл.ЗаписатьКонецАтрибута();
	
КонецПроцедуры
