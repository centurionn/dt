Функция НайтиЖДНПоНомеру(НакладнаяЭТРАН, ВключаяПомеченныеНаУдаление = ЛОЖЬ) Экспорт
	
	Результат = неопределено;
	
	Если НЕ ЗначениеЗаполнено(НакладнаяЭТРАН) Тогда Возврат Результат; КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ТранспортныйДокумент.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	               |ГДЕ
	               |	ТранспортныйДокумент.НакладнаяЭТРАН = &НакладнаяЭТРАН
				   |    И НЕ ТранспортныйДокумент.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ТранспортныйДокумент.Дата УБЫВ"; 
	Если ВключаяПомеченныеНаУдаление Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И НЕ ТранспортныйДокумент.ПометкаУдаления", "");
	КонецЕсли;
	Запрос.УстановитьПараметр("НакладнаяЭТРАН", НакладнаяЭТРАН);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

