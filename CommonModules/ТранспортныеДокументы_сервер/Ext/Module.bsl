	|	ВТ_ТранспортныеДокументыПоИдентификатору КАК ВТ_ТранспортныеДокументыПоИдентификатору
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеТранспортныхДокументов КАК ДанныеТранспортныхДокументов
	|		ПО ВТ_ТранспортныеДокументыПоИдентификатору.СписокТД = ДанныеТранспортныхДокументов.НомерДляПоиска
	|			И (ДанныеТранспортныхДокументов.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийТранспортныхДокументов.ЖДНакладная))
	|			И (НЕ ВТ_ТранспортныеДокументыПоИдентификатору.СписокТД = """")
	|			И (ВТ_ТранспортныеДокументыПоИдентификатору.ТранспортныйДокумент = ЗНАЧЕНИЕ(Документ.ТранспортныйДокумент.ПустаяСсылка))
    //Субботин 80323  30.01.2024 начало
	//|			И (НЕ ВТ_ТранспортныеДокументыПоИдентификатору.Номенклатура = &НоменклатураФрахт)
	//Субботин 80323  30.01.2024 Конец
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВТ_ТранспортныеДокументыПоИдентификатору.Поступление,
	|	ВТ_ТранспортныеДокументыПоИдентификатору.ИдентификаторСтрокиПоступления,
	|	ВТ_ТранспортныеДокументыПоИдентификатору.ИдентификаторСтрокиАкцепта,
	|	ВТ_ТранспортныеДокументыПоИдентификатору.ОтработкаВРИТМ,
	|	ВТ_ТранспортныеДокументыПоИдентификатору.СделкаЗаполнена,
	|	ДанныеТранспортныхДокументов.ТранспортныйДокумент,
	|	ВЫБОР
	|		КОГДА РАЗНОСТЬДАТ(ДанныеТранспортныхДокументов.ТранспортныйДокумент.ДатаТранспортногоДокумента, ВТ_ТранспортныеДокументыПоИдентификатору.Поступление.ДатаВходящегоДокумента, ДЕНЬ) > 0
	|			ТОГДА РАЗНОСТЬДАТ(ДанныеТранспортныхДокументов.ТранспортныйДокумент.ДатаТранспортногоДокумента, ВТ_ТранспортныеДокументыПоИдентификатору.Поступление.ДатаВходящегоДокумента, ДЕНЬ)
	|		ИНАЧЕ РАЗНОСТЬДАТ(ВТ_ТранспортныеДокументыПоИдентификатору.Поступление.ДатаВходящегоДокумента, ДанныеТранспортныхДокументов.ТранспортныйДокумент.ДатаТранспортногоДокумента, ДЕНЬ)
	|	КОНЕЦ,
	|	1
	|ИЗ
	|	ВТ_ТранспортныеДокументыПоИдентификатору КАК ВТ_ТранспортныеДокументыПоИдентификатору
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеТранспортныхДокументов КАК ДанныеТранспортныхДокументов
	|		ПО ВТ_ТранспортныеДокументыПоИдентификатору.СписокТД = ДанныеТранспортныхДокументов.НомерТранспортногоДокумента
	|			И (ДанныеТранспортныхДокументов.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийТранспортныхДокументов.Коносамент))
	|			И (НЕ ВТ_ТранспортныеДокументыПоИдентификатору.СписокТД = """")
	|			И (ВТ_ТранспортныеДокументыПоИдентификатору.ТранспортныйДокумент = ЗНАЧЕНИЕ(Документ.ТранспортныйДокумент.ПустаяСсылка))
    //Субботин 80323  30.01.2024 Начало
	//|			И (ВТ_ТранспортныеДокументыПоИдентификатору.Номенклатура = &НоменклатураФрахт)
	//Субботин 80323  30.01.2024 Конец
	|
	|УПОРЯДОЧИТЬ ПО
	|	Поступление,
	|	ИдентификаторСтрокиАкцепта,
	|	Приоритет,
	|	ПериодПриближения";  
	ЗапросДляЗаполнения.УстановитьПараметр("НоменклатураФрахт", ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьЗначениеКонстанты("УслугаФрахтаДляКалькуляции"));
	Пакет = ЗапросДляЗаполнения.ВыполнитьПакет();
    ОбработатьПакетРезультатовЗапроса(Пакет, ПараметрыЗаполнения);
		
КонецПроцедуры

Процедура ОбработатьПакетРезультатовЗапроса(ПакетРезультатов, ПараметрыЗаполнения)  
	
	// ДИТ US 61689 TA 73965 Сержантова А.С. Начало: 26.09.2023 - сбор данных для актуализации ТД вСделках
	ТаблицаИзмененныхСтрокАкцептов = Новый ТаблицаЗначений;
	ТаблицаИзмененныхСтрокАкцептов.Колонки.Добавить("Сделка");
	ТаблицаИзмененныхСтрокАкцептов.Колонки.Добавить("ТранспортныйДокумент"); 
	ТаблицаИзмененныхСтрокАкцептов.Колонки.Добавить("ИдентификаторСтрокиРасходовВСделке");
	// ДИТ US 61689 TA 73965 Сержантова А.С. Конец: 26.09.2023	
	
	КоличествоПакетов = ПакетРезультатов.Количество();
	Если ПараметрыЗаполнения.Режим = "ОдиночныйДокумент" Тогда 
		ВыборкаРезультата = ПакетРезультатов [КоличествоПакетов - 1].Выбрать(); 
		Пока ВыборкаРезультата.СледующийПоЗначениюПоля("ИдентификаторСтрокиПоступления") Цикл
			СтрокиАкцепта = ПараметрыЗаполнения.АкцептУслуги.НайтиСтроки(Новый Структура("ИдентификаторСтрокиПоступления", ВыборкаРезультата.ИдентификаторСтрокиПоступления));
			Для каждого СтрокаАкцепта Из СтрокиАкцепта Цикл
				СтрокаАкцепта.ТранспортныйДокумент = ВыборкаРезультата.ТранспортныйДокумент;
			КонецЦикла;
		КонецЦикла;
	ИначеЕсли ПараметрыЗаполнения.Режим = "ОдиночныйДокументПерезаполнениеПоПТУ" Тогда 
		ВыборкаРезультата = ПакетРезультатов [КоличествоПакетов - 1].Выбрать(); 
		Пока ВыборкаРезультата.СледующийПоЗначениюПоля("ИдентификаторСтрокиАкцепта") Цикл
			СтрокиАкцепта = ПараметрыЗаполнения.АкцептУслуги.НайтиСтроки(Новый Структура("ИдентификаторСтрокиПоступления", ВыборкаРезультата.ИдентификаторСтрокиАкцепта));
			Для каждого СтрокаАкцепта Из СтрокиАкцепта Цикл
				СтрокаАкцепта.ТранспортныйДокумент = ВыборкаРезультата.ТранспортныйДокумент;
			КонецЦикла;
		КонецЦикла;
	ИначеЕсли ПараметрыЗаполнения.Режим = "ПроизвольнаяТаблица" Тогда 
		ВыборкаРезультата = ПакетРезультатов [КоличествоПакетов - 1].Выбрать(); 
		Пока ВыборкаРезультата.СледующийПоЗначениюПоля("ИдентификаторСтрокиАкцепта") Цикл
			СтрокиАкцепта = ПараметрыЗаполнения.ТаблицаДанных.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ВыборкаРезультата.ИдентификаторСтрокиАкцепта));
			Для каждого СтрокаАкцепта Из СтрокиАкцепта Цикл
				СтрокаАкцепта.ТранспортныйДокумент = ВыборкаРезультата.ТранспортныйДокумент;
			КонецЦикла;
		КонецЦикла;
	ИначеЕсли ПараметрыЗаполнения.Режим = "РегламентноеЗаполнениеТранспортныхДокументов" Тогда 
		ВыборкаРезультата = ПакетРезультатов [КоличествоПакетов - 1].Выбрать(); 
		Пока ВыборкаРезультата.СледующийПоЗначениюПоля("Поступление") Цикл 
			// ДИТ US 61689 TA 73965 Сержантова А.С. Начало: 26.09.2023
			ТаблицаИзмененныхСтрокАкцептов.Очистить();
			// ДИТ US 61689 TA 73965 Сержантова А.С. Конец: 26.09.2023
			АкцептСсылка = Документы.Акцепт.ПолучитьДанныеПоследнегоПроведенногоАкцепта(ВыборкаРезультата.Поступление).АкцептСсылка;                    
			ОбАкцепт = АкцептСсылка.ПолучитьОбъект();
			Пока ВыборкаРезультата.СледующийПоЗначениюПоля("ИдентификаторСтрокиАкцепта") Цикл
				СтрокиАкцепта = ОбАкцепт.Услуги.НайтиСтроки(Новый Структура("ГУИД", ВыборкаРезультата.ИдентификаторСтрокиАкцепта));
				Для каждого СтрокаАкцепта Из СтрокиАкцепта Цикл
					СтрокаАкцепта.ТранспортныйДокумент = ВыборкаРезультата.ТранспортныйДокумент; 
					// ДИТ US 61689 TA 73965 Сержантова А.С. Начало: 26.09.2023
					Стр = ТаблицаИзмененныхСтрокАкцептов.Добавить();
					ЗаполнитьЗначенияСвойств(Стр, СтрокаАкцепта);
					// ДИТ US 61689 TA 73965 Сержантова А.С. Конец: 26.09.2023
				КонецЦикла;
			КонецЦикла;
			ИзмененийНет = ОбщегоНазначения.КоллекцииИдентичны(АкцептСсылка.Услуги.выгрузить(), ОбАкцепт.Услуги.выгрузить(),"ТранспортныйДокумент",, Истина);		
			Если ИзмененийНет = Ложь Тогда    
				ОбАкцепт.УстановитьКомментарийВерсииИсторииДанных("Перезаполнение транспортных документов (ЗаполнитьТранспортныеДокументы)");
				ОбАкцепт.ОбменДанными.Загрузка = Истина;
				обАкцепт.Записать(РежимЗаписиДокумента.Запись);
				ОбщегоНазначения.СообщитьПользователю(СтрШаблон("новый: %1; старый: %2", ОбАкцепт, АкцептСсылка)); 
				// ДИТ US 61689 TA 73965 Сержантова А.С. Начало: 26.09.2023
				АктуализироватьТДвСделках(ТаблицаИзмененныхСтрокАкцептов, АкцептСсылка);
				// ДИТ US 61689 TA 73965 Сержантова А.С. Конец: 26.09.2023
			КонецЕсли; 
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры 

// ДИТ US 61689 TA 73965 Сержантова А.С. Начало: 26.09.2023
Процедура АктуализироватьТДвСделках(ТаблицаИзмененныхСтрокАкцептов, АкцептСсылка)
	
	Сделки = ТаблицаИзмененныхСтрокАкцептов.ВыгрузитьКолонку("Сделка");
	МассивСделок = Взаимодействия.УдалитьПовторяющиесяЭлементыМассива(Сделки);
	Для каждого Сделка Из МассивСделок Цикл  
		РеквизитыСделки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Сделка, "ДатаЗакрытияСделки, ПометкаУдаления, Расходы");  
		Если ЗначениеЗаполнено(РеквизитыСделки.ДатаЗакрытияСделки) или РеквизитыСделки.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		НужнаЗапись = Ложь; 
		ВыборкаРасходовСделки = РеквизитыСделки.Расходы.Выбрать();
		СтрокиАкцепта = ТаблицаИзмененныхСтрокАкцептов.НайтиСтроки(Новый Структура("Сделка", Сделка));
	    Для каждого СтрокаАкцепта Из СтрокиАкцепта Цикл
			Пока ВыборкаРасходовСделки.НайтиСледующий(Новый Структура("ГУИД", СтрокаАкцепта.ИдентификаторСтрокиРасходовВСделке)) Цикл  
				Если ВыборкаРасходовСделки.ИсточникПоявленияСтрокиЭкономики = Перечисления.ИсточникПоявленияСтрокиЭкономики.ДобавленоИзАкцепта Тогда
					НужнаЗапись = Истина;   
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НужнаЗапись Тогда
				Прервать;
			КонецЕсли;
			ВыборкаРасходовСделки.Сбросить();
		КонецЦикла; 
		Если НужнаЗапись Тогда
			мз = РегистрыСведений.ОчередьОтложенногоИзмененияВзаимосвязанныхОбъектов.СоздатьМенеджерЗаписи();
			мз.ИсточникИзменения = АкцептСсылка;
			мз.ОбрабатываемыйОбъект = Сделка;
			мз.ДатаЗаписи = ТекущаяДата();
			мз.Пользователь = Пользователи.ТекущийПользователь();
			мз.Записать();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура АктуализацияСсылочныхЗначенийТД() Экспорт //ДИТ Шевченко А.В. 59059 19.12.2022
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
