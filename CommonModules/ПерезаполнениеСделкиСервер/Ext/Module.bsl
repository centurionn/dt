Функция ПолучитьСтруктуруПараметровДляПерезаполненияСделки(СделкаОб, СписокКонтрагентовДляПерезаполнения = Неопределено) Экспорт
	
		ЗаполненныеРанееДоплатныеКТК = Новый СписокЗначений;
		СписокКТКФрахт               = Новый СписокЗначений;
		ДинамоИсторияКонтейнеров     = Неопределено;
		
		СвязьУчетныхЕдиниц = СделкаОб.СвязьУчетныхЕдиниц.Выгрузить();
		Если СвязьУчетныхЕдиниц.Колонки.Найти("СформированыЗакрывающиеДокументы") = Неопределено Тогда
			СвязьУчетныхЕдиниц.Колонки.Добавить("СформированыЗакрывающиеДокументы",Новый ОписаниеТипов("Булево"));
		КонецЕсли;
		
		СтруктураПараметров = Новый Структура("ОбъектДоходыКТК,ОбъектДоходы,ОбъектСвязьДоходовИРасходов,ОбъектСвязьУчетныхЕдиниц,СписокКТКФрахт",
												СделкаОб.ДоходыКТК,
												СделкаОб.Доходы,
												СделкаОб.СвязьДоходовИРасходов,
												СвязьУчетныхЕдиниц,
												СписокКТКФрахт);
		
		ЗаполнитьКолонкуСформированыЗакрывающиеДокументы(СтруктураПараметров);
		СвязьУчетныхЕдиниц = СтруктураПараметров.ОбъектСвязьУчетныхЕдиниц;
		СписокКТКФрахт     = СтруктураПараметров.СписокКТКФрахт;
		//СтруктураПараметров = Новый Структура("ЗаполненныеРанееДоплатныеКТК,ВТ_СвязьУчетныхЕдиниц,СписокКТКФрахт,ДинамоИсторияКонтейнеров,ОбъектРейсы,ОбъектЗаявки,СвязьУчетныхЕдиниц,РазрешитьРейсыДругихСделок,ИсторияФильтрацииКонтейнеров,Расходы,ПодсылПорожних,ОбъектСсылка,ЕдиныйОтветственныйОтУчета",
		//										ЗаполненныеРанееДоплатныеКТК,
		//										ВТ_СвязьУчетныхЕдиниц,
		//										СписокКТКФрахт,
		//										ДинамоИсторияКонтейнеров,
		//										СделкаОб.Рейсы.Выгрузить(),
		//										СделкаОб.Заявки.Выгрузить(),
		//										СвязьУчетныхЕдиниц,
		//										СделкаОб.РазрешитьРейсыДругихСделок,
		//										СделкаОб.ИсторияФильтрацииКонтейнеров,
		//										СделкаОб.Расходы.Выгрузить(),
		//										СделкаОб.ПодсылПорожних,
		//										СделкаОб.Ссылка,
		//										СделкаОб.ЕдиныйОтветственныйОтУчета);									
		СтруктураПараметров = Новый Структура("ЗаполненныеРанееДоплатныеКТК,СписокКТКФрахт,ДинамоИсторияКонтейнеров,ОбъектРейсы,ОбъектЗаявки,СвязьУчетныхЕдиниц,РазрешитьРейсыДругихСделок,ИсторияФильтрацииКонтейнеров,Расходы,ПодсылПорожних,ОбъектСсылка,ЕдиныйОтветственныйОтУчета",
												ЗаполненныеРанееДоплатныеКТК,
												СписокКТКФрахт,
												ДинамоИсторияКонтейнеров,
												СделкаОб.Рейсы.Выгрузить(),
												СделкаОб.Заявки.Выгрузить(),
												СвязьУчетныхЕдиниц,
												СделкаОб.РазрешитьРейсыДругихСделок,
												СделкаОб.ИсторияФильтрацииКонтейнеров,
												СделкаОб.Расходы.Выгрузить(),
												СделкаОб.ПодсылПорожних,
												СделкаОб.Ссылка,
												СделкаОб.ЕдиныйОтветственныйОтУчета);                                 
		СтруктураПараметров.Вставить("СтруктураДанныеПоЗапрещеннымДляПересчета", Новый Структура("МассивДобавленоИзАкцепта, МассивОбъединениеПорожнейИГруженойСделок", Новый Массив, Новый Массив));

		ЗаполнитьПараметрыЗаполненияПоКонтрагенту(СделкаОб, СтруктураПараметров, СписокКонтрагентовДляПерезаполнения);	
		
		Возврат СтруктураПараметров;	
	
	
