	//Евросиб СубботинВ #124205 27.11.2025 Конец 
	
	ТаблицаКонтейнеров = ОбъектСделка.СвязьУчетныхЕдиниц.Выгрузить(, "Контейнер, ЖДН");
	Запрос.УстановитьПараметр("ТаблицаКонтейнеров", ТаблицаКонтейнеров);
	
	ПустаяДата = '00010101';
	Запрос.УстановитьПараметр("ПустаяДата", ПустаяДата);
	РейсыЖДПустаяСсылка = Справочники.РейсыЖД.ПустаяСсылка();
	
	ТаблицаРейсов = Запрос.Выполнить().Выгрузить();
	ТаблицаРейсов.Индексы.Добавить("Контейнер, ЖДН");
	ПараметрыПоиска = Новый Структура("Контейнер, ЖДН");
	
	Для Каждого Стр из ОбъектСделка.СвязьУчетныхЕдиниц Цикл
		ЗаполнитьЗначенияСвойств(ПараметрыПоиска, Стр);
		НайденныеСтроки = ТаблицаРейсов.НайтиСтроки(ПараметрыПоиска);
		Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
			Если Стр.ЖДРейс <> НайденныеСтроки[0].Рейс Тогда
				Стр.ЖДРейс = НайденныеСтроки[0].Рейс;
				ВыполненыИзменения = Истина;
			КонецЕсли;
			//Евросиб СубботинВ #124205 27.11.2025 Начало
			Если ЗначениеЗаполнено(НайденныеСтроки[0].ВагонПослеПерегруза) Тогда
				Стр.ФТГПослеПерегруза = НайденныеСтроки[0].ВагонПослеПерегруза;
				ВыполненыИзменения = Истина;
			ИначеЕсли ЗначениеЗаполнено(Стр.ФТГПослеПерегруза) Тогда
				Стр.ФТГПослеПерегруза = Неопределено;				
				ВыполненыИзменения = Истина;
			КонецЕсли;
			//Евросиб СубботинВ #124205 27.11.2025 Конец			
		Иначе
			Если Стр.ЖДРейс <> РейсыЖДПустаяСсылка Тогда
				Стр.ЖДРейс = РейсыЖДПустаяСсылка;
				ВыполненыИзменения = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;  
		
КонецПроцедуры
	


