Процедура ЗаполнитьКолонкуСформированыЗакрывающиеДокументы(СтруктураПараметров) Экспорт
	
	Если СтруктураПараметров.Свойство("ЗаполнениеФормы") Тогда
		ОбъектДоходыКТК 				= СтруктураПараметров.Объект.ДоходыКТК;
		ОбъектДоходы 					= СтруктураПараметров.Объект.Доходы;
		ОбъектСвязьДоходовИРасходов 	= СтруктураПараметров.Объект.СвязьДоходовИРасходов;
		ОбъектСвязьУчетныхЕдиниц 		= СтруктураПараметров.Объект.СвязьУчетныхЕдиниц;
		ТаблицаСвязьУчетныхЕдиниц 		= ОбъектСвязьУчетныхЕдиниц.Выгрузить();
	Иначе
		ОбъектДоходыКТК 				= СтруктураПараметров.ОбъектДоходыКТК;
		ОбъектДоходы 					= СтруктураПараметров.ОбъектДоходы;
		ОбъектСвязьДоходовИРасходов 	= СтруктураПараметров.ОбъектСвязьДоходовИРасходов;
		ОбъектСвязьУчетныхЕдиниц 		= СтруктураПараметров.ОбъектСвязьУчетныхЕдиниц;
		ТаблицаСвязьУчетныхЕдиниц		= ОбъектСвязьУчетныхЕдиниц;
	КонецЕсли;
	СписокКТКФрахт                  = Новый СписокЗначений;
	
	// Если в сделке на вкладке "Экономика сделки" в ТЧ "Доходы" по строке сформированы закрывающие документы клиенту по КТК 
	// (заполнено поле Уч. Документ) и РТУ проведена, не аннулирована и не помечена на удаление, то должен быть реализован
	// запрет на изменение любых данных на вкладке «Состав поезда» по этим КТК.
	// Для этого заполняем колонку "Сформированы закрывающие документы" таблицы "Связь учетных единиц".
	
	// Получаем список КТК таблицы "Доходы".
	// Список КТК текстом хранится в таблице "ДоходыКТК", связь с таблицей "Доходы" по "ГУИД".
	
	ОписаниеТиповСтрока36 = Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(36)); // ГУИД
	ОписаниеТиповСтрока11 = Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(11)); // Наименование
	
	ТаблицаКонтейнеровДоходов = Новый ТаблицаЗначений;
	ТаблицаКонтейнеровДоходов.Колонки.Добавить("КТК", 	ОписаниеТиповСтрока11);
	ТаблицаКонтейнеровДоходов.Колонки.Добавить("ГУИД", 	ОписаниеТиповСтрока36);
	
	Для Каждого ТекущийКТКДоходов Из ОбъектДоходыКТК Цикл
		
		МассивПредставленийКТК = СтрРазделить(ТекущийКТКДоходов.КТК, ";", Ложь);
		Для Каждого ПредставлениеКТК из МассивПредставленийКТК Цикл
		
			СтрокаКТК = ТаблицаКонтейнеровДоходов.Добавить();
			СтрокаКТК.КТК = ПредставлениеКТК;
			СтрокаКТК.ГУИД = ТекущийКТКДоходов.ГУИД;
		
		КонецЦикла;		
		
	КонецЦикла;
	
	// По полученным КТК определяем закрывающие документы и проверяем наличие аннулирования.
	// Если закрывающие документы проведены и не аннулированы, то в строке устанавливаем признак "СформированыЗакрывающиеДокументы".
	
	//ДИТ, Беляев СЮ, BUG 61636, 22-11-2022, вернул потерянные исправления по BUG 57430/TA 57684
	//ДИТ, Беляев СЮ, BUG 57430/TA 57684, 28-09-2022 информация об изменениях в логике
	//устанавливать "СформированыЗакрывающиеДокументы" в случаях
	//1) Корректировка по РТУ запрещена или есть корректируемый документ к РТУ, необходимо учитывать список КТК в новой строке, т.к. могут быть некоторые КТК исключены
	//2) Выполнено аннулирование и создан новый документ РТУ
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СделкаСвязьДоходовИРасходов.Доходы КАК Доходы,
	|	СделкаСвязьДоходовИРасходов.СвязьУчетныхЕдиниц КАК СвязьУчетныхЕдиниц
	|ПОМЕСТИТЬ ВТ_СвязьДоходовИРасходов
	|ИЗ
	|	Документ.Сделка.СвязьДоходовИРасходов КАК СделкаСвязьДоходовИРасходов
	//|ГДЕ
	//|	СделкаСвязьДоходовИРасходов.Ссылка = &Сделка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СделкаСвязьУчетныхЕдиниц.Контейнер КАК Контейнер,
	|	СделкаСвязьУчетныхЕдиниц.ГУИД КАК ГУИД
	|ПОМЕСТИТЬ ВТ_СвязьУчетныхЕдиниц
	|ИЗ
	|	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	//|ГДЕ
	//|	СделкаСвязьУчетныхЕдиниц.Ссылка = &Сделка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Доходы.ГУИД КАК ГУИД,
	|	Доходы.УчДокумент КАК УчДокумент,
	|	Доходы.Услуга КАК Услуга,
	|	Доходы.Клиент КАК Клиент,
	|	Доходы.Договор КАК Договор
	//ДИТ, Беляев СЮ, BUG 57430/TA 57684, 28-09-2022, начало
	|	,Доходы.НеВыставлятьКлиенту КАК НеВыставлятьКлиенту
	|	,Доходы.ГУИДИсправляемойСтроки КАК ГУИДИсправляемойСтроки
	|	,Доходы.КорректировкаДокумента КАК КорректировкаДокумента
	|	,ВЫБОР КОГДА Доходы.ГУИДИсправляемойСтроки <> """" ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ЭтоСтрокаИсправления
	//ДИТ, Беляев СЮ, BUG 57430/TA 57684, 28-09-2022, конец
	|ПОМЕСТИТЬ втДоходы
	|ИЗ
	|	Документ.Сделка.Доходы КАК Доходы
	//|ГДЕ
	//|	Доходы.Ссылка = &Сделка
	|;
	//ДИТ, Беляев СЮ, BUG 57430/TA 57684, 28-09-2022, начало
	|
	|////////////////////////////////////////////////////////////////////////////////
	//|ВЫБРАТЬ    //УБРАНО, НЕ БУДЕТ СВЯЗИ С Составом поезда У СТРОК КОРРЕКТИРОВКИ, В РЕЗУЛЬТАТЕ ВСЕГДА "НЕ СФОРМИРОВАНЫ ДОКУМЕНТЫ"
	//|	втДоходы.ГУИДИсправляемойСтроки КАК ГУИДИсправляемойСтроки
	//|ПОМЕСТИТЬ втДоходыИсправленныеИСтрокиАннулирования
	//|ИЗ
	//|	втДоходы КАК втДоходы
	//|ГДЕ втДоходы.ГУИДИсправляемойСтроки <> """"
	//|	И ЕстьNULL(втДоходы.КорректировкаДокумента.ВидОперации, Значение(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ПустаяСсылка)) <> Значение(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование)
	//|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|	втДоходы.ГУИД КАК ГУИДИсправляемойСтроки
	|ПОМЕСТИТЬ втДоходыИсправленныеИСтрокиАннулирования
	|ИЗ
	|	втДоходы КАК втДоходы
   	|ГДЕ ЕстьNULL(втДоходы.КорректировкаДокумента.ВидОперации, Значение(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ПустаяСсылка)) = Значение(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование)    	
	|;
	//ДИТ, Беляев СЮ, BUG 57430/TA 57684, 28-09-2022, конец
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СвязьДоходовИРасходов.СвязьУчетныхЕдиниц КАК связьучетныхединиц,
	//|	втДоходы.УчДокумент КАК УчетныйДокумент,
	//|	втДоходы.УчДокумент.Проведен КАК УчетныйДокументПроведен,
	//ДИТ, Беляев СЮ, BUG 57430/TA 57684, 28-09-2022, начало
	|	ВЫБОР КОГДА втДоходы.ЭтоСтрокаИсправления ТОГДА
	|			втДоходы.КорректировкаДокумента ИНАЧЕ
	|			втДоходы.УчДокумент КОНЕЦ КАК УчетныйДокумент,
	|	ВЫБОР КОГДА втДоходы.ЭтоСтрокаИсправления ТОГДА
	|			втДоходы.КорректировкаДокумента.Проведен ИНАЧЕ
	|			втДоходы.УчДокумент.Проведен КОНЕЦ КАК УчетныйДокументПроведен, 
	//ДИТ, Беляев СЮ, BUG 57430/TA 57684, 28-09-2022, конец
	|	втДоходы.Услуга.Наименование КАК НаименованиеУслуги,
	|	втДоходы.ГУИД КАК ГУИД,
	|	втДоходы.Клиент КАК Клиент,
	|	втДоходы.Договор КАК Договор
	|ПОМЕСТИТЬ втУчетныеДокументыКТК
	|ИЗ
	|	втДоходы КАК втДоходы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СвязьДоходовИРасходов КАК ВТ_СвязьДоходовИРасходов
	|		ПО втДоходы.ГУИД = ВТ_СвязьДоходовИРасходов.Доходы
	//ДИТ, Беляев СЮ, BUG 57430/TA 57684, 28-09-2022, начало
	|ГДЕ втДоходы.НеВыставлятьКлиенту = ЛОЖЬ
	|	И НЕ втДоходы.ГУИД В (ВЫБРАТЬ втДоходыИсправленныеИСтрокиАннулирования.ГУИДИсправляемойСтроки ИЗ втДоходыИсправленныеИСтрокиАннулирования КАК втДоходыИсправленныеИСтрокиАннулирования)
	//ДИТ, Беляев СЮ, BUG 57430/TA 57684, 28-09-2022, конец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втУчетныеДокументыКТК.УчетныйДокумент КАК УчетныйДокумент,
	|	МАКСИМУМ(ЕСТЬNULL(РазрешениеВводаКорректировокСрезПоследних.РазрешенаКорректировка, ЛОЖЬ)
	|			ИЛИ ЕСТЬNULL(РазрешениеВводаКорректировокСрезПоследних.РазрешеноИсправление, ЛОЖЬ)
	|			ИЛИ ЕСТЬNULL(РазрешениеВводаКорректировокСрезПоследних.РазрешеноАннулирование, ЛОЖЬ)) КАК ИзмененияРазрешены
	|ПОМЕСТИТЬ втРазрешениеИзменений
	|ИЗ
	|	втУчетныеДокументыКТК КАК втУчетныеДокументыКТК
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РазрешениеВводаКорректировок.СрезПоследних(, ) КАК РазрешениеВводаКорректировокСрезПоследних
	|		ПО втУчетныеДокументыКТК.УчетныйДокумент = РазрешениеВводаКорректировокСрезПоследних.ОбъектКорректировки
	|
	|СГРУППИРОВАТЬ ПО
	|	втУчетныеДокументыКТК.УчетныйДокумент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втУчетныеДокументыКТК.связьучетныхединиц КАК связьучетныхединиц,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА втУчетныеДокументыКТК.УчетныйДокументПроведен
	//|					И КорректировкаРеализации.Ссылка ЕСТЬ NULL
	//|					И втРазрешениеИзменений.ИзмененияРазрешены = ЛОЖЬ
	//ДИТ, Беляев СЮ, BUG 57430/TA 57684, 28-09-2022, начало
	|					И (втРазрешениеИзменений.ИзмененияРазрешены = ЛОЖЬ ИЛИ НЕ КорректировкаРеализации.Ссылка ЕСТЬ NULL)
	//ДИТ, Беляев СЮ, BUG 57430/TA 57684, 28-09-2022, конец
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК СформированыЗакрывающиеДокументы,
	//Евросиб(ДИТ), Беляев СЮ, BUG 101605 / TA 102596, 18-03-2025, начало
	|	МАКСИМУМ(втУчетныеДокументыКТК.УчетныйДокументПроведен) КАК УчетныйДокументПроведен,
	//Евросиб(ДИТ), Беляев СЮ, BUG 101605 / TA 102596, 18-03-2025, конец
	|	втУчетныеДокументыКТК.Клиент КАК Клиент,
	|	втУчетныеДокументыКТК.Договор КАК Договор
	|ИЗ
	|	втУчетныеДокументыКТК КАК втУчетныеДокументыКТК
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации КАК КорректировкаРеализации
	|		ПО втУчетныеДокументыКТК.УчетныйДокумент = КорректировкаРеализации.ДокументРеализации
	|			И (КорректировкаРеализации.ДокументРеализации.Проведен)
	|		ЛЕВОЕ СОЕДИНЕНИЕ втРазрешениеИзменений КАК втРазрешениеИзменений
	|		ПО втУчетныеДокументыКТК.УчетныйДокумент = втРазрешениеИзменений.УчетныйДокумент
	|
	|СГРУППИРОВАТЬ ПО
	|	втУчетныеДокументыКТК.связьучетныхединиц,
	|	втУчетныеДокументыКТК.Клиент,
	|	втУчетныеДокументыКТК.Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втУчетныеДокументыКТК.УчетныйДокумент КАК УчетныйДокумент,
	|	втУчетныеДокументыКТК.НаименованиеУслуги КАК НаименованиеУслуги,
	|	ВТ_СвязьДоходовИРасходов.СвязьУчетныхЕдиниц КАК СвязьУчетныхЕдиниц
	|ИЗ
	|	втУчетныеДокументыКТК КАК втУчетныеДокументыКТК
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СвязьДоходовИРасходов КАК ВТ_СвязьДоходовИРасходов
	|		ПО втУчетныеДокументыКТК.ГУИД = ВТ_СвязьДоходовИРасходов.Доходы
	|ГДЕ
	|	втУчетныеДокументыКТК.НаименованиеУслуги = &УслугаФрахт
	|	И втУчетныеДокументыКТК.УчетныйДокумент.Ссылка ЕСТЬ НЕ NULL ";
	// Евросиб Фролов)
	
	Запрос = Новый Запрос;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.Сделка.СвязьДоходовИРасходов", "&СвязьДоходовИРасходов");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.Сделка.Доходы", "&Доходы");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.Сделка.СвязьУчетныхЕдиниц", "&СвязьУчетныхЕдиниц");
	Запрос.Текст = ТекстЗапроса;
	
	
	Запрос.УстановитьПараметр("ТаблицаКонтейнеровДоходов", 	ТаблицаКонтейнеровДоходов);
	Запрос.УстановитьПараметр("Доходы", 					ОбъектДоходы.Выгрузить());
	Запрос.УстановитьПараметр("СвязьДоходовИРасходов", 		ОбъектСвязьДоходовИРасходов.Выгрузить());
	Запрос.УстановитьПараметр("СвязьУчетныхЕдиниц", 		ТаблицаСвязьУчетныхЕдиниц);
	Запрос.УстановитьПараметр("УслугаФрахт",				Константы.УслугаФрахтаДляКалькуляции.Получить());
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	КоличествоПакетов = РезультатЗапроса.Количество();
	РезультатПоВыставленнымДокументам = РезультатЗапроса[КоличествоПакетов-2];
	РезультатПоФрахту = РезультатЗапроса[КоличествоПакетов - 1];
	
	//Евросиб(ДИТ), Беляев СЮ, BUG 101605 / TA 102596, 18-03-2025, начало
	МассивСтрокВРежимеКорректирования = Новый Массив;
	//Евросиб(ДИТ), Беляев СЮ, BUG 101605 / TA 102596, 18-03-2025, конец
	
	Если Не РезультатПоВыставленнымДокументам.Пустой() Тогда
		Выборка = РезультатПоВыставленнымДокументам.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ПараметрыПоиска = Новый Структура;
			//ПараметрыПоиска.Вставить("Контейнер", Выборка.КТК);
			//ПараметрыПоиска.Вставить("Клиент", Выборка.Клиент);
			//ПараметрыПоиска.Вставить("Договор", Выборка.Договор); // Евросиб Фролов (10.02.2022 Task №45022
			ПараметрыПоиска.Вставить("ГУИД", Выборка.СвязьУчетныхЕдиниц);
			НайденныеСтроки = ОбъектСвязьУчетныхЕдиниц.НайтиСтроки(ПараметрыПоиска);
			
			//Если НайденныеСтроки.Количество() > 0 Тогда
			//	СтрокаКТК = НайденныеСтроки[0];
			//	СтрокаКТК.СформированыЗакрывающиеДокументы = Выборка.СформированыЗакрывающиеДокументы;
			//КонецЕсли;	
			Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				НайденнаяСтрока.СформированыЗакрывающиеДокументы = Выборка.СформированыЗакрывающиеДокументы;
				//Евросиб(ДИТ), Беляев СЮ, BUG 101605 / TA 102596, 18-03-2025, начало
				Если НЕ Выборка.СформированыЗакрывающиеДокументы 
					И Выборка.УчетныйДокументПроведен = Истина Тогда
					МассивСтрокВРежимеКорректирования.Добавить(Выборка.СвязьУчетныхЕдиниц);
				КонецЕсли;
				//Евросиб(ДИТ), Беляев СЮ, BUG 101605 / TA 102596, 18-03-2025, конец
			КонецЦикла;
			
		КонецЦикла;	
	КонецЕсли;	
	
	//Если НЕ РезультатПоФрахту.Пустой() Тогда
	//	КТКФрахт = РезультатПоФрахту.Выгрузить().ВыгрузитьКолонку("КТК");
	//	СписокКТКФрахт.ЗагрузитьЗначения(КТКФрахт);
	//КонецЕсли;	
	
	//Евросиб(ДИТ), Беляев СЮ, BUG 101605 / TA 102596, 18-03-2025, начало
	СтруктураПараметров.Вставить("МассивСтрокВРежимеКорректирования", МассивСтрокВРежимеКорректирования);
	//Евросиб(ДИТ), Беляев СЮ, BUG 101605 / TA 102596, 18-03-2025, конец
	
КонецПроцедуры

