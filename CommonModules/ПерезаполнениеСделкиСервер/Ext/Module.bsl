Функция ПроверитьНаличиеЗаявкиВДругихСделках(ЗаявкиДляПроверки, ТекущаяСделка) Экспорт    
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Сделка.Номер КАК НомерСделки,
	|	ДокЗаявка.Номер КАК НомерЗаявки,
	|	СделкаЗаявки.Заявка КАК Заявка
	|ИЗ
	|	Документ.Сделка.Заявки КАК СделкаЗаявки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделка
	|		ПО СделкаЗаявки.Ссылка = Сделка.Ссылка
	|			И (Сделка.Проведен)
	|			И (НЕ Сделка.ПодсылПорожних)
	|			И (НЕ Сделка.Ссылка = &ТекущаяСделка)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Заявка КАК ДокЗаявка
	|		ПО СделкаЗаявки.Заявка = ДокЗаявка.Ссылка
	|ГДЕ
	|	СделкаЗаявки.Заявка В(&Заявки)
	|ИТОГИ ПО
	|	Заявка";
	
	Запрос.УстановитьПараметр("Заявки", ЗаявкиДляПроверки);
	Запрос.УстановитьПараметр("ТекущаяСделка", ТекущаяСделка);    
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ЗаявкиСообщения = Новый Соответствие;
	
	Если Не РезультатЗапроса.Пустой() Тогда 
		ВыборкаЗаявка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);   
		
		Пока ВыборкаЗаявка.Следующий() Цикл  
			
			Выборка = ВыборкаЗаявка.Выбрать();
			
			МассивСообщений = Новый Массив; 
			
			Пока Выборка.Следующий() Цикл   
				ТекстСоообщения = СтрШаблон("Заявка %1 используется в другой сделке %2", 
											Выборка.НомерЗаявки, Выборка.НомерСделки);
											
				МассивСообщений.Добавить(ТекстСоообщения);  
				
			КонецЦикла;    
			
			ЗаявкиСообщения.Вставить(ВыборкаЗаявка.Заявка, МассивСообщений);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ЗаявкиСообщения;

КонецФункции //ДИТ Авдеева В.С. 50072 Конец 08.09.2022	

