Функция ПолучитьЗаявкиКалькуляцииСПодсылом(Заявки, ИмяДокумента) Экспорт
	
	ТипЗначенияЗаявки = ТипЗнч(Заявки);
	Если ТипЗначенияЗаявки = Тип("Массив") Или ТипЗначенияЗаявки = Тип("СписокЗначений") Тогда
		СписокЗаявок = Заявки;
	Иначе
		СписокЗаявок = Новый Массив;
		СписокЗаявок.Добавить(Заявки);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаявкаСоставУслуги.Ссылка КАК Заявка,
	|	ЗаявкаСоставУслуги.Калькуляция КАК Калькуляция
	|ПОМЕСТИТЬ КалькуляцииЗаявок
	|ИЗ
	|	Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
	|ГДЕ
	|	ЗаявкаСоставУслуги.Ссылка В(&СписокЗаявок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КалькуляцииЗаявок.Заявка КАК Док
	|ИЗ
	|	КалькуляцииЗаявок КАК КалькуляцииЗаявок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Калькуляция.ММ_КалькуляцияМультимодальнойЦепочки КАК КалькуляцияММ_КалькуляцияМультимодальнойЦепочки
	|		ПО КалькуляцииЗаявок.Калькуляция = КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка
	|ГДЕ
	|	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.ПодсылПорожних";
	
	Если ИмяДокумента = "Калькуляция" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КалькуляцииЗаявок.Заявка КАК Док", "КалькуляцииЗаявок.Калькуляция КАК Док");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("СписокЗаявок", СписокЗаявок);
	
	ТаблицаДокументов = Запрос.Выполнить().Выгрузить();
	
	СписокДокументов = ТаблицаДокументов.ВыгрузитьКолонку("Док");
	
	Возврат СписокДокументов;
	
КонецФункции   

Функция ПолучитьДанныеДоплаты(КТК, ПериодЪ, ТекСделка = неопределено)
	
	Результат = Новый Структура("Доплата_Клиент, Доплата_Договор, Доплата_ПСЦ, Доплата_Калькуляция, Доплата_Доплата, Доплата_Валюта");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	стоки_КлиентскоеОперированиеСрезПоследних.допл_Клиент КАК Доплата_Клиент,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.допл_Договор КАК Доплата_Договор,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.допл_ПСЦ КАК Доплата_ПСЦ,
	               |	ВЫБОР
	               |		КОГДА стоки_ТекущиеДанныеСрезПоследних.комм_Ставка > 0
	               |			ТОГДА стоки_ТекущиеДанныеСрезПоследних.комм_Ставка
	               |		ИНАЧЕ -стоки_ТекущиеДанныеСрезПоследних.комм_Ставка
	               |	КОНЕЦ КАК Доплата_Доплата,
	               |	стоки_ТекущиеДанныеСрезПоследних.комм_Валюта КАК Доплата_Валюта,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.допл_Калькуляция КАК Доплата_Калькуляция
	               |ИЗ
	               |	РегистрСведений.стоки_КлиентскоеОперирование.СрезПоследних(, КТК = &КТК) КАК стоки_КлиентскоеОперированиеСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.стоки_ТекущиеДанные.СрезПоследних КАК стоки_ТекущиеДанныеСрезПоследних
	               |		ПО стоки_КлиентскоеОперированиеСрезПоследних.КТК = стоки_ТекущиеДанныеСрезПоследних.КТК
	               |ГДЕ
	               |	НЕ стоки_КлиентскоеОперированиеСрезПоследних.допл_ПСЦ В
	               |				(ВЫБРАТЬ
	               |					СделкаСвязьУчетныхЕдиниц.Доплата_ПСЦ КАК Доплата_ПСЦ
	               |				ИЗ
	               |					Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	               |				ГДЕ
	               |					СделкаСвязьУчетныхЕдиниц.Ссылка.ПометкаУдаления = ЛОЖЬ
	               |					И СделкаСвязьУчетныхЕдиниц.Ссылка <> &ТекСделка
	               |					И СделкаСвязьУчетныхЕдиниц.Контейнер = &КТК)";
				   //|	И стоки_КлиентскоеОперированиеСрезПоследних.допл_Сделка = &ТекСделка"; //ДИТ, Беляев СЮ, Ticket#0271096, 04-05-2022 закомментировал - отбор не требуется и нет такого реквизита на рабочей базе
	
	Запрос.УстановитьПараметр("КТК", КТК);
	Запрос.УстановитьПараметр("ТекСделка", ТекСделка);
	
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() И ЗначениеЗаполнено(Ответ.Доплата_Клиент) Тогда
		
		ЗаполнитьЗначенияСвойств(Результат, Ответ);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

Процедура ПерезаполнитьВладельцевКТКСервер(СвязьУчетныхЕдиниц) экспорт
	
	СписокСделок = Новый Массив;
	Соответствие = Новый Массив;
	
	Для каждого Стр из СвязьУчетныхЕдиниц Цикл
		
		СписокСделок.Добавить(Стр.Заявка);
		// Евросиб Фролов (26.12.2021 TASK №44663
		//Соответствие.Добавить(Новый Структура("Заявка, НомерКТК, ГУИД", Стр.Заявка, Стр.Контейнер, Стр.ГУИД));
		Соответствие.Добавить(Новый Структура("Заявка, ГУИДСтрокиЗаявки, ГУИД", Стр.Заявка, Стр.ГУИДСтрокиЗаявки, Стр.ГУИД));
		// Евросиб Фролов)
	КонецЦикла;
	
	Результат = ПолучитьВладельцевУказанныхКТКИзЗаявки(СписокСделок, Соответствие);
	
	Для каждого Стр из СвязьУчетныхЕдиниц Цикл
		
		Для каждого Стр2 из Результат Цикл
			
			// Евросиб Фролов (26.12.2021 TASK №44663
			Если Стр.Заявка = Стр2.Заявка 
				И Стр.ГУИДСтрокиЗаявки = Стр2.ГУИДСтроки Тогда 
				// Евросиб Bug 91817 TA 91845 Рыбьяков К.А. 18.09.2024 ((
				//ЗаполнитьЗначенияСвойств(Стр, Стр2, "ВладелецКТК, ПринадлежностьТЕ, ДатаВыдачиГрузаКлиенту, ВремяПрибытияНаТерминал");
				ЗаполнитьЗначенияСвойств(Стр, Стр2, "ВладелецКТК, ДатаВыдачиГрузаКлиенту, ВремяПрибытияНаТерминал");
				// Евросиб Рыбьяков К.А. 18.09.2024 ))
				Прервать; 
			КонецЕсли;			
			// Евросиб Фролов)
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВосстановитьГУИДыСтрок(СвязьУчетныхЕдиниц,ВТ_СвязьУчетныхЕдиниц)
	Для каждого СтрСостав Из СвязьУчетныхЕдиниц Цикл
		//ДИТ, Беляев СЮ, TA55125, 27-07-2022, начало
		Если ЗначениеЗаполнено(СтрСостав.ГУИД) Тогда
			Продолжить;
		КонецЕсли;
		//ДИТ, Беляев СЮ, TA55125, 27-07-2022, конец
		
		// Евросиб Фролов (15.12.2021 Ticket№ 0244435
		//СтрокиКТК = ВТ_СвязьУчетныхЕдиниц.НайтиСтроки(Новый Структура("ГУИДСтрокиЗаявки", СтрСостав.ГУИДСтрокиЗаявки));  
		СтрокиКТК = ВТ_СвязьУчетныхЕдиниц.НайтиСтроки(Новый Структура("ГУИДСтрокиЗаявки, ВидТранспортногоСообщения",
		СтрСостав.ГУИДСтрокиЗаявки,
		СтрСостав.ВидТранспортногоСообщения));
		// Евросиб Фролов)
		
		Если СтрокиКТК.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(СтрСостав,СтрокиКТК[0],"ГУИД"); 
			//ДИТ, Беляев СЮ, ТА52417 / Ticket#0274408, 06-06-2022, начало
		Иначе 
			СтрСостав.ГУИД = Новый УникальныйИдентификатор;	
			//ДИТ, Беляев СЮ, ТА52417 / Ticket#0274408, 06-06-2022, конец
		КонецЕсли; 
	КонецЦикла; 
КонецПроцедуры

Функция ПолучитьВладельцевУказанныхКТКИзЗаявки(СписокСделок, Соответствие)
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаявкаСоставУслуги.Ссылка КАК Ссылка,
	               |	ЗаявкаСоставУслуги.НомерКТК КАК НомерКТК,
	               |	ЗаявкаСоставУслуги.ВладелецКТК КАК ВладелецКТК,
	               |	ЗаявкаСоставУслуги.ВремяПрибытияНаТерминал КАК ВремяПрибытияНаТерминал,
	               |	ЗаявкаСоставУслуги.ПринадлежностьТЕ КАК ПринадлежностьТЕ,
	               |	ЗаявкаСоставУслуги.ДатаПодачиАвтоПодВыгрузку КАК ДатаПодачиАвтоПодВыгрузку,
	               |	ЗаявкаСоставУслуги.ГУИДСтроки КАК ГУИДСтроки
	               |ИЗ
	               |	Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
	               |ГДЕ
	               |	ЗаявкаСоставУслуги.Ссылка В(&Ссылка)";
	Запрос.УстановитьПараметр("Ссылка", СписокСделок);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		Для каждого Стр из Соответствие Цикл
			// Евросиб Фролов (26.12.2021 TASK №44663
			//Если Ответ.Ссылка = Стр.Заявка И (Ответ.НомерКТК = Стр.НомерКТК ИЛИ Ответ.ГУИДСтроки = Стр.ГУИД) Тогда
			Если Ответ.Ссылка = Стр.Заявка 
				И (Ответ.ГУИДСтроки = Стр.ГУИДСтрокиЗаявки 
					ИЛИ Ответ.ГУИДСтроки = Стр.ГУИД) Тогда
				//Результат.Добавить(Новый Структура("Заявка, КТК, Владелец, ВремяПрибытияНаТерминал, ПринадлежностьТЕ, ДатаВыдачиГрузаКлиенту, ГУИДСтроки", Стр.Заявка, Стр.НомерКТК, Ответ.ВладелецКТК, Ответ.ВремяПрибытияНаТерминал, Ответ.ПринадлежностьТЕ, Ответ.ДатаПодачиАвтоПодВыгрузку, Ответ.ГУИДСтроки));
				Результат.Добавить(Новый Структура("Заявка, ВладелецКТК, ВремяПрибытияНаТерминал, ПринадлежностьТЕ, ДатаВыдачиГрузаКлиенту, ГУИДСтроки", 
												Стр.Заявка, Ответ.ВладелецКТК, Ответ.ВремяПрибытияНаТерминал, Ответ.ПринадлежностьТЕ, Ответ.ДатаПодачиАвтоПодВыгрузку, Ответ.ГУИДСтроки));	
			// Евросиб Фролов)	
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

