Процедура ДобавитьСтрокуСоставаПоезда(СтруктураПараметров, ВидТранспортногоСообщения)
	СвязьУчетныхЕдиниц = СтруктураПараметров.СвязьУчетныхЕдиниц;
	ОбъектЗаявка = СтруктураПараметров.ОбъектЗаявка;
	СтрокаСоставУслуги = СтруктураПараметров.СтрокаСоставУслуги;
	РЗ = СтруктураПараметров.РЗ;
	ОбъектСсылка = СтруктураПараметров.ОбъектСсылка;
	ЗаполненныеРанееДоплатныеКТК = СтруктураПараметров.ЗаполненныеРанееДоплатныеКТК;
	НСтр = СвязьУчетныхЕдиниц.Добавить();
	НСтр.ВидТранспортногоСообщения = ВидТранспортногоСообщения;
	НСтр.Заявка = ОбъектЗаявка.Заявка;
	ЗаполнитьЗначенияСвойств(НСтр, ОбъектЗаявка);
	НСтр.Контейнер = СтрокаСоставУслуги.НомерКТК;
	НСтр.Протокол = СтрокаСоставУслуги.ПСЦ;
	НСтр.Клиент = ОбъектЗаявка.Заявка.Контрагент;
	НСтр.ПравилоГотовностиКВыставлению = Перечисления.ПравилоГотовностиКВыставлению.Вручную;
	НСтр.Договор = ОбъектЗаявка.Заявка.Договор;
	// ДИТ US 62421 TA 64346 Евсенкин М.А. Начало: 06.02.2023
	// Было:
	//НСтр.Груз = СтрокаСоставУслуги.Груз;
	//Стало:
	НСтр.Груз = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаСоставУслуги.КлючАналитикиПеревозки,"Груз");
	// ДИТ US 62421 TA 64346 Евсенкин М.А. Конец: 06.02.2023
	НСтр.ВесГрузаНетто = СтрокаСоставУслуги.ВесГрузаНетто;
	НСтр.Груженый = СтрокаСоставУслуги.Груженый;
	НСтр.УсловияПеревозки = СтрокаСоставУслуги.Калькуляция.УсловияПеревозки_Отправление;
	НСтр.УсловияПеревозкиНазначение = СтрокаСоставУслуги.Калькуляция.УсловияПеревозки_Прибытие;
	НСтр.Калькуляция = ОбъектЗаявка.Калькуляция;
	НСтр.РазмерКТК = СтрокаСоставУслуги.РазмерКТК;
	нСтр.Коносамент = СтрокаСоставУслуги.Коносамент;
	// ДИТ 89973 Давудов М.А. Начало: 21.08.2024
	//ок(
	//нСтр.СобственностьПеревозимогоКТК = СтрокаСоставУслуги.СобственностьПеревозимогоКТК;
	//ок)
	нСтр.УдалитьСобственностьПеревозимогоКТК = СтрокаСоставУслуги.УдалитьСобственностьПеревозимогоКТК;
	нСтр.ПринадлежностьТЕ = СтрокаСоставУслуги.ПринадлежностьТЕ;
	// ДИТ 89973 Давудов М.А. Конец: 21.08.2024
	НСтр.СтокСДачиПорожнего = СтрокаСоставУслуги.СтокСдачиПорожнего;
	нСтр.НеАктивна = ЗначениеЗаполнено(СтрокаСоставУслуги.ПеренесенВЗаявку);
	
	Если ЗаполненныеРанееДоплатныеКТК.НайтиПоЗначению(НСтр.Контейнер) <> Неопределено
		И ВидТранспортногоСообщения = Перечисления.ВидыТранспортныхСообщений.ЖД Тогда
		РезЗапросаДоплаты = ПолучитьДанныеДоплаты(СтрокаСоставУслуги.НомерКТК, СтрокаСоставУслуги.ДатаВыдачи, ОбъектСсылка);
		ЗаполнитьЗначенияСвойств(НСтр, РезЗапросаДоплаты);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаСоставУслуги.Калькуляция) тогда
		НСтр.Калькуляция = СтрокаСоставУслуги.Калькуляция;
		// заполнение по калькуляции порта отправления или назначения (если это одно значение, а не список, то подставляем по умолчанию)
		Если НСтр.Калькуляция.ФрахтИмпорт Тогда
			Если НСтр.Калькуляция.НФ_ПортыОтправленияНазначения.Количество() = 1 Тогда
				НСтр.ПортОтправления = НСтр.Калькуляция.НФ_ПортыОтправленияНазначения[0].Порт;
			КонецЕсли;
			// Евросиб US 87896 TA 90558 Рыбьяков К.А. 18.09.2024 ((
			Если НСтр.Калькуляция.ММ_ПортыОтправленияНазначения.Количество() = 1 Тогда
				НСтр.ПортНазначения = НСтр.Калькуляция.ММ_ПортыОтправленияНазначения[0].Порт;
			КонецЕсли;
			//НСтр.ПортНазначения = НСтр.Калькуляция.ММ_ПортОтправления;
			// Евросиб Рыбьяков К.А. 18.09.2024 ))
		Иначе
			Если НСтр.Калькуляция.НФ_ПортыОтправленияНазначения.Количество() = 1 Тогда
				НСтр.ПортНазначения = НСтр.Калькуляция.НФ_ПортыОтправленияНазначения[0].Порт;
			КонецЕсли;
			// Евросиб US 87896 TA 90558 Рыбьяков К.А. 18.09.2024 ((
			Если НСтр.Калькуляция.ММ_ПортыОтправленияНазначения.Количество() = 1 Тогда
				НСтр.ПортОтправления = НСтр.Калькуляция.ММ_ПортыОтправленияНазначения[0].Порт;
			КонецЕсли;
			//НСтр.ПортОтправления = НСтр.Калькуляция.ММ_ПортОтправления;
			// Евросиб Рыбьяков К.А. 18.09.2024 ))
		КонецЕсли;
	КонецЕсли;
	НСтр.Вагон = СтрокаСоставУслуги.Вагон;
	//ДИТ, Беляев СЮ, Ticket#0307708, 14-04-2023, начало
	Если ЗначениеЗаполнено(НСтр.Коносамент) Тогда
		РеквизитыКоносамента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НСтр.Коносамент,"МорскойРейс,СтанцияОтправления,СтанцияНазначения, МестоПолученияГруза, МестоПоставкиГруза");
		НСтр.МорскойРейс = РеквизитыКоносамента.МорскойРейс;         
		НСтр.ПортОтправления =  ?(ЗначениеЗаполнено(РеквизитыКоносамента.СтанцияОтправления),РеквизитыКоносамента.СтанцияОтправления,НСтр.ПортОтправления);
		НСтр.ПортНазначения = ?(ЗначениеЗаполнено(РеквизитыКоносамента.СтанцияНазначения),РеквизитыКоносамента.СтанцияНазначения,НСтр.ПортНазначения); 
	Иначе
	//ДИТ, Беляев СЮ, Ticket#0307708, 14-04-2023, конец
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("НомерКТК",НСтр.Контейнер);
		ПараметрыОтбора.Вставить("Заявка",ОбъектЗаявка.Заявка);
		НайденныеСтроки = РЗ.НайтиСтроки(ПараметрыОтбора);
		// проверяем наличие КТК в результате запроса. Если есть и заявка та самая, то указываем морской рейс
		// (запрос упорядочен по дате коносамента => берем самый новый)
		Если НайденныеСтроки.Количество()>0 Тогда
			НСтр.МорскойРейс = НайденныеСтроки[0].МорскойРейс;
			НСтр.Коносамент = НайденныеСтроки[0].Коносамент;
			НСтр.ПортОтправления = ?(ЗначениеЗаполнено(НайденныеСтроки[0].СтанцияОтправления),НайденныеСтроки[0].СтанцияОтправления,НСтр.ПортОтправления);
			НСтр.ПортНазначения = ?(ЗначениеЗаполнено(НайденныеСтроки[0].СтанцияНазначения),НайденныеСтроки[0].СтанцияНазначения,НСтр.ПортНазначения);
		КонецЕсли;
	КонецЕсли;
	
	// Евросиб Фролов (23.12.2021 TASK №44661
	НСтр.ГУИДСтрокиЗаявки = СтрокаСоставУслуги.ГУИДСтроки;
	// Евросиб Фролов)
КонецПроцедуры

