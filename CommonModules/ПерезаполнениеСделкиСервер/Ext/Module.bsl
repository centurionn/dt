	КонецЦикла;
	
	Если ОтветственныеПоДоговорам.Количество() = 1 Тогда ЕдиныйОтветственныйОтУчета = ОтветственныеПоДоговорам[0]; КонецЕсли;
		
	СписокСделок = Новый Массив;
	Соответствие = Новый Массив;
	
