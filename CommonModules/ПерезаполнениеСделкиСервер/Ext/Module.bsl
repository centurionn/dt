	ВТ_СвязьУчетныхЕдиниц.Колонки.Добавить("Контейнер",Новый ОписаниеТипов("СправочникСсылка.ТЕ"));
	ВТ_СвязьУчетныхЕдиниц.Колонки.Добавить("ГУИД",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36)));
	ВТ_СвязьУчетныхЕдиниц.Колонки.Добавить("ГотовоКВыставлению",Новый ОписаниеТипов("Булево"));
	ВТ_СвязьУчетныхЕдиниц.Колонки.Добавить("ДокументыСформированы",Новый ОписаниеТипов("Булево"));
	ВТ_СвязьУчетныхЕдиниц.Колонки.Добавить("ДокументыВыставлены",Новый ОписаниеТипов("Булево"));
	ВТ_СвязьУчетныхЕдиниц.Колонки.Добавить("ЗадачаГотовностиКВыставлению",Новый ОписаниеТипов("СправочникСсылка.Состояния"));
	ВТ_СвязьУчетныхЕдиниц.Колонки.Добавить("Протокол",Новый ОписаниеТипов("ДокументСсылка.ПСЦ"));
	ВТ_СвязьУчетныхЕдиниц.Колонки.Добавить("Калькуляция",Новый ОписаниеТипов("ДокументСсылка.Калькуляция"));
	ВТ_СвязьУчетныхЕдиниц.Колонки.Добавить("НеАктивна",Новый ОписаниеТипов("Булево"));
	ВТ_СвязьУчетныхЕдиниц.Колонки.Добавить("ГУИДСтрокиЗаявки",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36)));	
	
	Возврат ВТ_СвязьУчетныхЕдиниц;
	
