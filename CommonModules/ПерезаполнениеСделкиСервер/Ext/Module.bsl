Процедура ВосстановитьКоносаментыСтрок(СвязьУчетныхЕдиниц, ВТ_СвязьУчетныхЕдиниц)
	
	Для Каждого СтрСостав Из СвязьУчетныхЕдиниц Цикл
			
		НайденныеСтроки = ВТ_СвязьУчетныхЕдиниц.НайтиСтроки(Новый Структура("
			|Гуид,
			|Контейнер, 
			|Калькуляция, 
			|ПортОтправления, 
			|ПортНазначения,  
			|ВидТранспортногоСообщения", 
			СтрСостав.Гуид,
			СтрСостав.Контейнер, 
			СтрСостав.Калькуляция,  
			СтрСостав.ПортОтправления, 
			СтрСостав.ПортНазначения, 
			СтрСостав.ВидТранспортногоСообщения));
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(СтрСостав, НайденныеСтроки[0], "Коносамент"); 
		КонецЕсли; 
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьРейсыПоКТКНомеруНакладнойФакт(мРейсы) Экспорт //ДИТ Шевченко А.В. US 62360 ТА 73008 28.07.2023
		
