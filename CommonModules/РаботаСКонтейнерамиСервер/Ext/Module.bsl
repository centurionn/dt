Процедура ПодготовитьЗаписьДляИсточникаСоздания(Контейнер) Экспорт
	
	МоментЗаписи = ТекущаяДатаСеанса();
	
	НаборЗаписей = РегистрыСведений.ИсточникСозданияКонтейнеров.СоздатьНаборЗаписей();
	
	НаборЗаписей.Отбор.Контейнер.Установить(Контейнер);
	
	НоваяЗапись = НаборЗаписей.Добавить();
	
	НоваяЗапись.Контейнер 	= Контейнер;
	НоваяЗапись.Автор 		= Пользователи.АвторизованныйПользователь();
	НоваяЗапись.ДтаСоздания = МоментЗаписи;
	НоваяЗапись.Комментарий = СтрШаблон("%1: создан контейнер", МоментЗаписи);
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

Процедура ДобавитьИнформациюОбИсточникеСозднияКонтейнеров(МассивКонтейнеров, Источник) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИсточникСозданияКонтейнеров.Контейнер КАК Контейнер
	|ИЗ
	|	РегистрСведений.ИсточникСозданияКонтейнеров КАК ИсточникСозданияКонтейнеров
	|ГДЕ
	|	ИсточникСозданияКонтейнеров.ИсточникСоздания = НЕОПРЕДЕЛЕНО
	|	И ИсточникСозданияКонтейнеров.Контейнер В (&Контейнеры)";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Контейнеры", МассивКонтейнеров);
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			НаборЗаписей = РегистрыСведений.ИсточникСозданияКонтейнеров.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Контейнер.Установить(Выборка.Контейнер);
			НаборЗаписей.Прочитать();
			
			Для Каждого Запись Из НаборЗаписей Цикл
				Запись.ИсточникСоздания = Источник;
				Запись.Комментарий = Запись.Комментарий
									+ ?(ПустаяСтрока(Запись.Комментарий), "", Символы.ПС)
									+ СтрШаблон("%1: добавлен источник (%2)", ТекущаяДатаСеанса(), Источник);
			КонецЦикла;	
			
			НаборЗаписей.Записать();
			
		КонецЦикла;
		
	КонецЕсли;	
	
КонецПроцедуры	

Процедура УдалитьИнформациюОбИсточникеСозднияКонтейнеров(Источник) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ИсточникСозданияКонтейнеров.Контейнер КАК Контейнер
	|ИЗ
	|	РегистрСведений.ИсточникСозданияКонтейнеров КАК ИсточникСозданияКонтейнеров
	|ГДЕ
	|	ИсточникСозданияКонтейнеров.ИсточникСоздания = &ИсточникСоздания";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ИсточникСоздания", Источник);
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			НаборЗаписей = РегистрыСведений.ИсточникСозданияКонтейнеров.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Контейнер.Установить(Выборка.Контейнер);
			НаборЗаписей.Прочитать();
			
			Для Каждого Запись Из НаборЗаписей Цикл
				Запись.ИсточникСоздания = Неопределено;
				Запись.Комментарий = Запись.Комментарий
									+ ?(ПустаяСтрока(Запись.Комментарий), "", Символы.ПС)
									+ СтрШаблон("%1: удален источник (%2)", ТекущаяДатаСеанса(), Источник);
			КонецЦикла;	
			
			НаборЗаписей.Записать();
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

