Функция ПолучитьТипТЕ(ПрочитаннаяСсылка) Экспорт 	
	Результат = Новый Структура;
	//Евросиб Каблов 27.07.2022 ( Task 51077
	//Если ЗначениеЗаполнено(ПрочитаннаяСсылка.ТипТЕ) Тогда
	//	Результат.Вставить("СсылкаТипТЕ", ПрочитаннаяСсылка.ТипТЕ);
	//	Результат.Вставить("Размер", ПрочитаннаяСсылка.ТипТЕ.РазмерКТК); 
	//	Результат.Вставить("ТипТЕ", ПрочитаннаяСсылка.ТипТЕ.Наименование);
	Если ЗначениеЗаполнено(ПрочитаннаяСсылка) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТЕ.ТипТЕ КАК ТипТЕ,
		|	ТипоразмерыТЕ.РазмерКТК КАК РазмерКТК,
		|	ТипоразмерыТЕ.Наименование КАК ТипТЕНаименование,
		|	ТипоразмерыТЕ.РазмерКТК.Размер КАК РазмерКТКЧисло
		|ИЗ
		|	Справочник.ТЕ КАК ТЕ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТипоразмерыТЕ КАК ТипоразмерыТЕ
		|		ПО ТЕ.ТипТЕ = ТипоразмерыТЕ.Ссылка
		|ГДЕ
		|	ТЕ.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", ПрочитаннаяСсылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Результат.Вставить("ТипТЕ",	 			Выборка.ТипТЕ);
			Результат.Вставить("Размер", 			Выборка.РазмерКТК); 
			Результат.Вставить("ТипТЕНаименование", Выборка.ТипТЕНаименование);
			Результат.Вставить("РазмерКТКЧисло", 	Выборка.РазмерКТКЧисло);
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	//Евросиб Каблов 27.07.2022 )
		Возврат Результат; 
	Иначе
		Возврат Неопределено; 	
	КонецЕсли;	
КонецФункции

