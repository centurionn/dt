//Функция НайтиКТК(Знач НомерКТК) Экспорт 
Функция НайтиКТК(Знач НомерКТК, СниматьПометкуУдаления = Истина) Экспорт
//Евросиб Каблов 07.10.2020 )	
	Результат = Неопределено;
	
	НомерКТК = НормализоватьНомерКТК(НомерКТК);
	
	Если НомерКТК = "" Тогда Возврат Результат; КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТЕ.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ТЕ КАК ТЕ
	               |ГДЕ
	               |	ТЕ.Префикс = &Префикс
	               |	И ТЕ.Номер = &Номер
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ТЕ.ПометкаУдаления";
	Запрос.УстановитьПараметр("Префикс", Лев(ВРег(НомерКТК), 4));
	Запрос.УстановитьПараметр("Номер", Сред(НомерКТК, 5, 6));
	Ответ = Запрос.Выполнить().Выбрать();
	
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	//Евросиб Каблов 07.10.2020 ( Не всегда нужно снимать пометку удаления. Например, при загрузке дислокации.
	Если СниматьПометкуУдаления Тогда
	//Евросиб Каблов 07.10.2020 )
		Если Результат <> неопределено И Результат.ПометкаУдаления = Истина Тогда
			РезОбъект = Результат.ПолучитьОбъект();
			РезОбъект.ПометкаУдаления = Ложь;
			РезОбъект.Записать();
		КонецЕсли;
	//Евросиб Каблов 07.10.2020 (
	КонецЕсли;
	//Евросиб Каблов 07.10.2020 )
	
	Возврат Результат;
	
КонецФункции

Функция СоздатьКТК(КТК, Тип = Неопределено, ПараметрыКонтейнера = Неопределено) Экспорт
	
	Результат = неопределено;
	
	//Евросиб Каблов 17.02.2021 ( Ticket#0223703 
	Если Не ЗначениеЗаполнено(КТК) Тогда
		Возврат Справочники.ТЕ.ПустаяСсылка();
	КонецЕсли;
	//Евросиб Каблов 17.02.2021 )
	
	КТК = НормализоватьНомерКТК(КТК);
	
	СущКонтейнер = НайтиКТК(КТК);
	
	Если ЗначениеЗаполнено(СущКонтейнер) тогда
		Результат = СущКонтейнер;
		
		Если НЕ ЗначениеЗаполнено(Результат.ТипТЕ) И ЗначениеЗаполнено(Тип) Тогда
			
			РезКТК = Результат.ПолучитьОбъект();
			РезКТК.ТипТЕ = Тип;
			Если ЗначениеЗаполнено(ПараметрыКонтейнера) Тогда
				ЗаполнитьЗначенияСвойств(РезКТК, ПараметрыКонтейнера);	
			КонецЕсли; 
			РезКТК.Записать();
			
		КонецЕсли;
		
	Иначе
		
		НКонтейнер = Справочники.те.СоздатьЭлемент();
		НКонтейнер.Наименование = КТК;
		НКонтейнер.ТипТЕ = Тип;
		НКонтейнер.Префикс = Лев(КТК, 4);
		НКонтейнер.Номер = Сред(КТК, 5, 6);
		НКонтейнер.КонтрольноеЧисло = Сред(КТК, 11, 1);
		Если ЗначениеЗаполнено(ПараметрыКонтейнера) Тогда
			ЗаполнитьЗначенияСвойств(РезКТК, ПараметрыКонтейнера);
		КонецЕсли; 
		НКонтейнер.Записать();
		Результат = НКонтейнер.Ссылка;
		
		// Евросиб Фролов (08.10.2021 Task №39041 
		ПодготовитьЗаписьДляИсточникаСоздания(Результат);		
		// Евросиб Фролов)
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТипИРазмер(КТК) Экспорт
	
	Результат = Новый Структура("Тип, Размер");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТЕ.ТипТЕ КАК Тип,
	               |	ТЕ.ТипТЕ.РазмерКТК КАК Размер
	               |ИЗ
	               |	Справочник.ТЕ КАК ТЕ
	               |ГДЕ
	               |	ТЕ.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", КТК);
	Ответ = Запрос.Выполнить().Выбрать();
	Если ответ.Следующий() Тогда
		Результат.Тип = Ответ.Тип;
		Результат.Размер = Ответ.Размер;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НайтиТипПоРазмеру(РазмерСтрокой,Рефрижераторный = Ложь,НомерКонтейнера = "") Экспорт 
	
	//ДИТ Шевченко А.В. 60130 16.11.22 //Добавил параметр Рефрижераторный в функцию
	
	Результат = Новый Структура("Размер, Тип", Справочники.РазмерыКТК.ПустаяСсылка(),Справочники.ТипоразмерыТЕ.ПустаяСсылка());
	
	ТекстСообщения = СТрШаблон("Не удалось найти тип и размер контейнера %1 для введенного значения размера %2",НомерКонтейнера,РазмерСтрокой);
	
	//Евросиб СубботинВ #82679 18.06.2024 Начало 
	Попытка
		РазмерЧислом = Число(РазмерСтрокой);
	Исключение
		РазмерЧислом = Неопределено;
		//Сообщить(ТекстСообщения);
		//Возврат Результат 
	КонецПопытки;
	//Евросиб СубботинВ #82679 18.06.2024 Конец
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РазмерыКТК.Ссылка КАК Размер,
	               |	ТипоразмерыТЕ.Ссылка КАК Тип
	               |ИЗ
	               |	Справочник.РазмерыКТК КАК РазмерыКТК
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТипоразмерыТЕ КАК ТипоразмерыТЕ
	               |		ПО РазмерыКТК.Ссылка = ТипоразмерыТЕ.РазмерКТК
	               |			И (ТипоразмерыТЕ.ИспользоватьПоУмолчаниюДляКТКУказанногоРазмера)
	               |			И (НЕ ТипоразмерыТЕ.ПометкаУдаления)
	               |ГДЕ
	               |	РазмерыКТК.Размер = &Размер
	               |	И НЕ РазмерыКТК.ПометкаУдаления
	               |	И ТипоразмерыТЕ.Рефрижераторный = &Рефрижераторный
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ТипоразмерыТЕ.РазмерКТК,
	               |	ТипоразмерыТЕ.Ссылка
	               |ИЗ
	               |	Справочник.ТипоразмерыТЕ КАК ТипоразмерыТЕ
	               |ГДЕ
	               |	ТипоразмерыТЕ.Рефрижераторный = &Рефрижераторный
	               |	И ТипоразмерыТЕ.Наименование = &РазмерСтрока";
	Запрос.УстановитьПараметр("Рефрижераторный", Рефрижераторный);
	//Евросиб СубботинВ #82679 18.06.2024 Начало // убрал привязку к числу и сделал универсальный формат 
	Запрос.УстановитьПараметр("Размер", РазмерЧислом); 
	Запрос.УстановитьПараметр("РазмерСтрока", РазмерСтрокой);
	//Евросиб СубботинВ #82679 18.06.2024 Конец
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат.Размер = Ответ.Размер;
		Результат.Тип = Ответ.Тип;
	Иначе
		Сообщить(ТекстСообщения);
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

// Функция вычисляет контрольное число номера кт
Функция ПолучитьКонтрольноеЧисло(Знач Префикс, Знач Номер) Экспорт
	
	Префикс = ВРег(Префикс);
	
	СБ = Новый Соответствие;
	СБ.Вставить("A", 10); СБ.Вставить("N", 25);
	СБ.Вставить("B", 12); СБ.Вставить("O", 26);
	СБ.Вставить("C", 13); СБ.Вставить("P", 27);
	СБ.Вставить("D", 14); СБ.Вставить("Q", 28);
	СБ.Вставить("E", 15); СБ.Вставить("R", 29);
	СБ.Вставить("F", 16); СБ.Вставить("S", 30);
	СБ.Вставить("G", 17); СБ.Вставить("T", 31);
	СБ.Вставить("H", 18); СБ.Вставить("U", 32);
	СБ.Вставить("I", 19); СБ.Вставить("V", 34);
	СБ.Вставить("J", 20); СБ.Вставить("W", 35);
	СБ.Вставить("K", 21); СБ.Вставить("X", 36);
	СБ.Вставить("L", 23); СБ.Вставить("Y", 37);
	СБ.Вставить("M", 24); СБ.Вставить("Z", 38);
	
	Результат = 0;
	
	Если НЕ КорректнаяМаска(ВРЕГ(Префикс),Номер) Тогда
		Сообщить("Номер контейнера указан неверно!");
		Возврат "Неверно";
	КонецЕсли;
	
	Результат = СБ[Сред(Префикс, 1, 1)] + 2*СБ[Сред(Префикс, 2, 1)] + 4*СБ[Сред(Префикс, 3, 1)] + 8*СБ[Сред(Префикс, 4, 1)];
	Результат = Результат + 16*Число(Сред(Номер, 1, 1)) + 32*Число(Сред(Номер, 2, 1)) + 64*Число(Сред(Номер, 3, 1)) + 128*Число(Сред(Номер, 4, 1)) + 256*Число(Сред(Номер, 5, 1)) + 512*Число(Сред(Номер, 6, 1));
	
	Результат = Результат % 11;
	
	Если Результат = 10 Тогда Результат = 0; КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КорректнаяМаска(СтрокаПараметр,НомерПараметр) Экспорт
	                                                  
	// проверка Префикса
	СтрокаПараметр = СокрЛП(СтрокаПараметр);	
 	КоличествоСимволов = СтрДлина(СтрокаПараметр);
 	Если КоличествоСимволов = 4 Тогда
		Для Сч = 1 По КоличествоСимволов Цикл
			Код = КодСимвола(Сред(СтрокаПараметр,Сч)); 
			// Большие латинские буквы: 65 - 90
			Если Код < 65 ИЛИ Код>90 Тогда 
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	Иначе  	
		Возврат Ложь;
	КонецЕсли;
	
 	// проверка Номера
	НомерПараметр = СокрЛП(НомерПараметр);	
 	КоличествоСимволов = СтрДлина(НомерПараметр);
 	Если КоличествоСимволов = 6 Тогда
		Для Сч = 1 По КоличествоСимволов Цикл
			Код = КодСимвола(Сред(НомерПараметр,Сч)); 
			// Цифры: 48 - 57
			Если Код < 48 ИЛИ Код>57 Тогда 
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		// если все проверили и все ок, то возврат ИСТИНА
		ВОзврат Истина;
	Иначе 	
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

