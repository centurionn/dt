Функция ПолучитьНакладнуюЭТРАН(НомерНакладной, ТолькоДействующийСтатус = ЛОЖЬ) экспорт
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	э_Накладная.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.э_Накладная КАК э_Накладная
	               |ГДЕ
	               |	э_Накладная.НакладнаяНомер = &НакладнаяНомер
	               |	И НЕ э_Накладная.ПометкаУдаления
	               |	И ВЫБОР
	               |			КОГДА &ТолькоДействующийСтатус
	               |				ТОГДА э_Накладная.ТекущееСостояниеНакладнойДействующийСтатус
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	э_Накладная.Дата УБЫВ";
	Запрос.УстановитьПараметр("НакладнаяНомер", НомерНакладной);
	Запрос.УстановитьПараметр("ТолькоДействующийСтатус", ТолькоДействующийСтатус);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НормализоватьНомерКТК(Знач НомерКТК) Экспорт
	
	СоответствиеБукв = Новый Соответствие;
	СоответствиеБукв.Вставить("У", "Y");
	СоответствиеБукв.Вставить("К", "K");
	СоответствиеБукв.Вставить("Е", "E");
	СоответствиеБукв.Вставить("Н", "H");
	СоответствиеБукв.Вставить("Х", "X");
	СоответствиеБукв.Вставить("В", "B");
	СоответствиеБукв.Вставить("А", "A");
	СоответствиеБукв.Вставить("Р", "P");
	СоответствиеБукв.Вставить("О", "O");
	СоответствиеБукв.Вставить("С", "C");
	СоответствиеБукв.Вставить("Т", "T");
	
	СоответствиеБукв.Вставить(Символы.ПС, "");
	СоответствиеБукв.Вставить(Символы.Таб, "");
	СоответствиеБукв.Вставить(Символы.НПП, "");
	СоответствиеБукв.Вставить(";", "");
	СоответствиеБукв.Вставить(" ", "");
	СоответствиеБукв.Вставить("-", "");
	
	Для каждого Стр из СоответствиеБукв Цикл
		
		НомерКТК = СтрЗаменить(НомерКТК, Стр.Ключ, Стр.Значение);
		
	КонецЦикла;
	
	Возврат НомерКТК;
	
КонецФункции

Функция Нормализовать_и_НайтиКТК(Знач НомерКТК, Тип) Экспорт
	
	НомерКТК = НормализоватьНомерКТК(НомерКТК);
	Возврат СоздатьКТК(НомерКТК, Тип);
	
КонецФункции

