	//Евросиб(ДИТ), Беляев СЮ, US 103867 / TA 103872, 28-02-2025, конец
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0390428, 13-03-2025, начало
	|	,Диадок_Документы.ИмяФайла КАК ИмяФайла
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0390428, 13-03-2025, конец
	|ПОМЕСТИТЬ втДокументы
	|ИЗ
	|	Справочник.Диадок_Документы КАК Диадок_Документы
	|ГДЕ
	//|	Диадок_Документы.Документ = &Документ
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0390428, 13-03-2025, начало
	|	Диадок_Документы.Документ В(&МассивДокументов)
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0390428, 13-03-2025, конец
	|	И Диадок_Документы.Метка = ""Отправлен""
	|	И НЕ Диадок_Документы.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
