	ЕстьДокументыДляПечати = Ложь;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		КоличествоЭкземпляров = КоллекцияПечатныхФорм[0].Экземпляров;
