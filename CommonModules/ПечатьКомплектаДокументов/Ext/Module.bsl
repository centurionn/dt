&НаСервере
Функция ПроверитьОдинаковыеДанные(ВыделенныеСтр)
	
	НетПовторов = Ложь;
	
	Если ЗначениеЗаполнено(ВыделенныеСтр[0]) Тогда
		Мета = ВыделенныеСтр[0].Метаданные();
		ИмяТаблицы = Мета.Имя;
		ЕстьРеквДоверенностьЗаРуководителя 		= НЕ Мета.Реквизиты.Найти("ДоверенностьЗаРуководителя") = Неопределено;
		ЕстьРеквДоверенностьЗаГлБухгалтера 		= НЕ Мета.Реквизиты.Найти("ДоверенностьЗаГлБухгалтера") = Неопределено;
		ЕстьРеквЗаРуководителяНаОсновании 		= НЕ Мета.Реквизиты.Найти("ЗаРуководителяНаОсновании") = Неопределено;
		ЕстьРеквЗаГлавногоБухгалтераНаОсновании = НЕ Мета.Реквизиты.Найти("ЗаГлавногоБухгалтераНаОсновании") = Неопределено;
		ЕстьРеквГлавныйБухгалтер 				= НЕ Мета.Реквизиты.Найти("ГлавныйБухгалтер") = Неопределено;
		ЕстьРеквРуководитель 					= НЕ Мета.Реквизиты.Найти("Руководитель") = Неопределено;
	Иначе
		Возврат НетПовторов;
	КонецЕсли;                                                                   	// проверка, одинаковые ли данные введены в выбранных документах
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	"+?(ЕстьРеквДоверенностьЗаРуководителя, "ВидДок.ДоверенностьЗаРуководителя", """""")+" КАК ДоверенностьЗаРуководителя,
	               |	"+?(ЕстьРеквДоверенностьЗаГлБухгалтера, "ВидДок.ДоверенностьЗаГлБухгалтера", """""")+" КАК ДоверенностьЗаГлБухгалтера,
	               |	"+?(ЕстьРеквЗаРуководителяНаОсновании, "ВЫРАЗИТЬ(ВидДок.ЗаРуководителяНаОсновании КАК СТРОКА(1000))", """""")+" КАК ЗаРуководителяНаОсновании,
	               |	"+?(ЕстьРеквЗаГлавногоБухгалтераНаОсновании, "ВЫРАЗИТЬ(ВидДок.ЗаГлавногоБухгалтераНаОсновании КАК СТРОКА(1000))", """""")+" КАК ЗаГлавногоБухгалтераНаОсновании,
	               |	"+?(ЕстьРеквГлавныйБухгалтер, "ВидДок.ГлавныйБухгалтер", """""")+" КАК ГлавныйБухгалтер,
	               |	"+?(ЕстьРеквРуководитель, "ВидДок.Руководитель", """""")+" КАК Руководитель
	               |ИЗ
	               |	Документ."+ИмяТаблицы+" КАК ВидДок
	               |ГДЕ
	               |	ВидДок.Ссылка В(&Ссылка)";
	Запрос.УстановитьПараметр("Ссылка",ВыделенныеСтр);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Если ТЗ.Количество() = 1 Тогда
		ПараметрСверки = Новый Структура("ДоверенностьЗаРуководителя,ДоверенностьЗаГлБухгалтера,ГлавныйБухгалтер,Руководитель,ЗаРуководителяНаОсновании,ЗаГлавногоБухгалтераНаОсновании");
		ЗаполнитьЗначенияСвойств(ПараметрСверки, ТЗ[0]);
		Возврат ПараметрСверки;
	КонецЕсли;
	
	Возврат НетПовторов;
	
КонецФункции

