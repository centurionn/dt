&НаСервере
//Функция ПечатьРеестра(МассивДокументов)
//Евросиб(ДИТ), Беляев СЮ, US 89714 / TA 89717, 09-12-2024, добавлен параметр МассивДополнительныхВложений
Функция ПечатьРеестра(МассивДокументов, МассивДополнительныхВложений = Неопределено)
	
	//Евросиб(ДИТ), Беляев СЮ, US 89714 / TA 89717, 09-12-2024, начало
	Если МассивДополнительныхВложений = Неопределено Тогда
		МассивДополнительныхВложений = Новый Массив;
	КонецЕсли;
	//Евросиб(ДИТ), Беляев СЮ, US 89714 / TA 89717, 09-12-2024, конец
	
	Макет = ПолучитьОбщийМакет("РеестрДокументов");
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(МассивДокументов[0].Контрагент,"НаименованиеПолное");
	ОбластьШапка.Параметры.Дата = Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy");
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ОбластьСтрокаТаблицы = Макет.ПолучитьОбласть("СтрокаТаблицы");
	СтруктураИменДокументов = Новый Структура;
	СтруктураИменДокументов.Вставить("РеализацияТоваровУслуг", "Акт сдачи приемки/УПД"); //Евросиб Литвинов 17.05.2021 #34451
	СтруктураИменДокументов.Вставить("ОтчетКомитентуОПродажах", "Отчет комитенту о продажах");
	СтруктураИменДокументов.Вставить("СчетФактураВыданный", "Счет-фактура выданный/УПД"); //Евросиб Литвинов 17.05.2021 #34451
	НаименованиеДокумента = Неопределено;
	Для каждого ДокументКлиента Из МассивДокументов Цикл
		Если СтруктураИменДокументов.Свойство(ДокументКлиента.Метаданные().Имя, НаименованиеДокумента) Тогда
			ОбластьСтрокаТаблицы.Параметры.НаименованиеДокумента = НаименованиеДокумента;
		Иначе
			ОбластьСтрокаТаблицы.Параметры.НаименованиеДокумента = ДокументКлиента.Метаданные().Синоним;
		КонецЕсли;		
		Если ТипЗнч(ДокументКлиента) = Тип("ДокументСсылка.ПСЦ") Тогда
			РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументКлиента, "НомерПСЦ, ДатаПСЦ");
			ОбластьСтрокаТаблицы.Параметры.Номер = РеквизитыДокумента.НомерПСЦ;
			ОбластьСтрокаТаблицы.Параметры.Дата = Формат(РеквизитыДокумента.ДатаПСЦ,"ДФ=dd.MM.yyyy");
		ИначеЕсли ТипЗнч(ДокументКлиента) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
			РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументКлиента, "НомерДляПечати, НомерДляПечатиВознаграждение, ДатаДокумента");
			
			Если ДокументКлиента.ДоговорКонтрагента.ДоговорТранспортнойЭкспедиции Тогда
				ОбластьСтрокаТаблицы.Параметры.НаименованиеДокумента = "Отчет экспедитора";
			Иначе
				ОбластьСтрокаТаблицы.Параметры.НаименованиеДокумента = "Отчет агента";
			КонецЕсли;
			ОбластьСтрокаТаблицы.Параметры.Номер = РеквизитыДокумента.НомерДляПечати;
			ОбластьСтрокаТаблицы.Параметры.Дата = Формат(РеквизитыДокумента.ДатаДокумента,"ДФ=dd.MM.yyyy");
			ТабличныйДокумент.Вывести(ОбластьСтрокаТаблицы);

			ОбластьСтрокаТаблицы.Параметры.НаименованиеДокумента = "Акт сдачи-приемки";
			ОбластьСтрокаТаблицы.Параметры.Номер = РеквизитыДокумента.НомерДляПечатиВознаграждение;
			ОбластьСтрокаТаблицы.Параметры.Дата = Формат(РеквизитыДокумента.ДатаДокумента,"ДФ=dd.MM.yyyy");
		Иначе
			РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументКлиента, "НомерДляПечати, ДатаДокумента");
			ОбластьСтрокаТаблицы.Параметры.Номер = РеквизитыДокумента.НомерДляПечати;
			ОбластьСтрокаТаблицы.Параметры.Дата = Формат(РеквизитыДокумента.ДатаДокумента,"ДФ=dd.MM.yyyy");
		КонецЕсли;		
		ТабличныйДокумент.Вывести(ОбластьСтрокаТаблицы);
		
	КонецЦикла;
	
	//Евросиб(ДИТ), Беляев СЮ, US 89714 / TA 89717, 09-12-2024, начало
	Для Каждого ДопВложение Из МассивДополнительныхВложений Цикл
		//ОбластьСтрокаТаблицы.Параметры.НаименованиеДокумента = ДопВложение;
		//ОбластьСтрокаТаблицы.Параметры.Номер = "";
		//ОбластьСтрокаТаблицы.Параметры.Дата = "";
		//Евросиб(ДИТ), Беляев СЮ, US 103867 / TA 103872, 28-02-2025, начало
		ОбластьСтрокаТаблицы.Параметры.НаименованиеДокумента = ДопВложение.Наименование;
		ОбластьСтрокаТаблицы.Параметры.Номер = ДопВложение.Номер;
		ОбластьСтрокаТаблицы.Параметры.Дата = ДопВложение.Дата;
		//Евросиб(ДИТ), Беляев СЮ, US 103867 / TA 103872, 28-02-2025, конец
		ТабличныйДокумент.Вывести(ОбластьСтрокаТаблицы);
	КонецЦикла;
	//Евросиб(ДИТ), Беляев СЮ, US 89714 / TA 89717, 09-12-2024, конец
	
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	ОбластьПодвал.Параметры.Пользователь = Пользователи.ТекущийПользователь(); 
