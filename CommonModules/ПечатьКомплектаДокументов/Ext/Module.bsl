				НовСтр.ВидДокумента = "Счет-фактура выданный";
				НовСтр.СсылкаНаДокумент = ссСФ;
				НовСтр.Контрагент = ссСФ.Контрагент;
				НовСтр.Договор = ссСФ.ДоговорКонтрагента;
				// ++ ДИТ_Агафонов_task 25372 06.10.2022
				НовСтр.СсылкаНаДокументПервоначальная = ссылкаРТУ;
				// -- ДИТ_Агафонов_task 25372 06.10.2022
			КонецЕсли; 
		КонецЦикла; 
	КонецЕсли;
	//Евросиб СубботинВ #84453 02.07.2024 Начало // // оставил роаботу только с ТЧ счетов
	//Счет = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ссылкаРТУ,"СчетНаОплатуПокупателю");
	//// ДИТ Поморцева Т.П. Задача 232675 11.06.2021. начало
	////Если ЗначениеЗаполнено(Счет) Тогда	
	//Если ЗначениеЗаполнено(Счет) И НЕ Счет.ПометкаУдаления Тогда
	//// ДИТ Поморцева Т.П. Задача 232675 11.06.2021. конец		
	//	НовСтр = ТаблицаДок.Добавить();	
	//	НовСтр.ВидДокумента = "Счет на оплату покупателю";
	//	НовСтр.СсылкаНаДокумент = Счет;
	//	НовСтр.Контрагент = Счет.Контрагент;
	//	НовСтр.Договор = Счет.ДоговорКонтрагента;
