Процедура ДобавитьДокументВМассив(МассивТДПоКлиенту, ПараметрыДобавления)
	
	// Евросиб Фролов (06.10.2021 Task№ 40270
	
	КоллекцияПечатныхФорм 	= ПараметрыДобавления.КоллекцияПечатныхФорм;
	ТекЦикл 				= ПараметрыДобавления.ТекЦикл;
	СсылкаНаДокумент 		= ПараметрыДобавления.СсылкаНаДокумент;
	ПОД 					= ПараметрыДобавления.ПОД;
	
	СписокПолучаемыхРеквизитов = "НомерДляПечати, ДатаДокумента"; 
	Если ТипЗнч(СсылкаНаДокумент) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
		СписокПолучаемыхРеквизитов = "НомерДляПечатиВознаграждение, ДатаДокумента";
	КонецЕсли;
	
	РеквизитыДокумента = ОбщегоНазначенияВызовСервера.ЗначенияРеквизитовОбъекта(СсылкаНаДокумент, СписокПолучаемыхРеквизитов, Истина);
	
	НомерДокумента = "< не определен >";
	Если ТипЗнч(СсылкаНаДокумент) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
		НомерДокумента = РеквизитыДокумента.НомерДляПечатиВознаграждение;
	Иначе	
		НомерДокумента = РеквизитыДокумента.НомерДляПечати;
	КонецЕсли;	
	
	НомерСтроки = 0;
	КоличествоПечатныхФорма = КоллекцияПечатныхФорм.Количество();
	
	Для Каждого ТекущаяПечатнаяФорма Из КоллекцияПечатныхФорм Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		// Если документ один, то нумерация будет простая, например "1. Акт...".
		// Если документов несколько, то нумерацию будем делать в формате "1.1", например "1.1. Акт..."
		НомерПечатнойФормы = Строка(ТекЦикл);
		Если КоличествоПечатныхФорма > 1 Тогда
			НомерПечатнойФормы = НомерПечатнойФормы + "." + НомерСтроки;
		КонецЕсли;										
		
		ИмяПечатнойФормы = СтрШаблон("%1. %2 №%3 от %4",
												НомерПечатнойФормы,
												ТекущаяПечатнаяФорма.СинонимМакета,
												НомерДокумента,
												Формат(РеквизитыДокумента.ДатаДокумента, "ДФ=dd.MM.yyyy"));
		
		ТабДок = ТекущаяПечатнаяФорма.ТабличныйДокумент;
		АдресВХ = ПоместитьВоВременноеХранилище(ТабДок);
		ПОД.Состав.Добавить().Данные = АдресВХ;
		
		СтруктураТабДок = Новый СТруктура;
		СтруктураТабДок.Вставить("ИмяПФ",				ИмяПечатнойФормы);							
		СтруктураТабДок.Вставить("ТабДок", 				ТабДок);
		СтруктураТабДок.Вставить("СсылкаДок", 			СсылкаНаДокумент);
		СтруктураТабДок.Вставить("ОфисныеДокументы", 	ТекущаяПечатнаяФорма.ОфисныеДокументы);
		// ++ ДИТ_Агафонов_task 25372 06.10.2022
		СтруктураТабДок.Вставить("СсылкаДокПервоначальная", ПараметрыДобавления.СсылкаНаДокументПервоначальная);
		// -- ДИТ_Агафонов_task 25372 06.10.2022
		//ДИТ, Беляев СЮ, Ticket#0297503 / BUG 64926, 07-02-2023, начало
		СтруктураТабДок.Вставить("ИмяВРЕГ", ТекущаяПечатнаяФорма.ИмяВРЕГ);
		//ДИТ, Беляев СЮ, Ticket#0297503 / BUG 64926, 07-02-2023, конец
		
		МассивТДПоКлиенту.Добавить(СтруктураТабДок);
				
	КонецЦикла;
	
	// Евросиб Фролов)
		
КонецПроцедуры							

