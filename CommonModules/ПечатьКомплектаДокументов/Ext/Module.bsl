&НаКлиенте
Процедура НапечататьКомплект(МассивПФ, Знач ПараметрКоманды = Неопределено) ЭКСПОРТ
	
	Для каждого ЭлементСтруктуры из МассивПФ Цикл
		
		ПараметрКоманды = Новый Массив;
		Для Каждого Эл Из ЭлементСтруктуры.МассивСсылокНаДок Цикл
			ПараметрКоманды.Добавить(Эл);
		КонецЦикла;
		ОбластиОбъектов = Новый СписокЗначений;
			
		КоллекцияПечатныхФорм = Новый Массив;
		Поля = УправлениеПечатьюКлиентСервер.ИменаПолейКоллекцииПечатныхФорм();
		ДобавленныеПечатныеФормы = Новый Соответствие;
		
		Для каждого Док из ЭлементСтруктуры.МассивТДПоКлиенту Цикл
			ДобавленныеПечатныеФормы = Новый Соответствие;
			ПечатнаяФорма = Новый Структура(СтрСоединить(Поля, ","));
			ПечатнаяФорма.ИмяМакета = Док.ИмяПФ;
			ПечатнаяФорма.ИмяВРЕГ = ВРег(Док.ИмяПФ);
			//ДИТ, Беляев СЮ, Ticket#0297503 / BUG 64926, 07-02-2023, начало
			Если Док.Свойство("ИмяВРЕГ") Тогда
				ПечатнаяФорма.ИмяВРЕГ = ВРег(Док.ИмяВРЕГ);
			КонецЕсли;
			//ДИТ, Беляев СЮ, Ticket#0297503 / BUG 64926, 07-02-2023, конец
			ПечатнаяФорма.СинонимМакета = Док.ИмяПФ;
			ПечатнаяФорма.ТабличныйДокумент = Док.ТабДок;
			ПечатнаяФорма.ИмяФайлаПечатнойФормы = Док.ИмяПФ;
			ПечатнаяФорма.Экземпляров = 1;
			Док.Свойство("СсылкаДок",ПечатнаяФорма.СсылкаДок);
			// ++ ДИТ_Агафонов_task 25372 06.10.2022
			Док.Свойство("СсылкаДокПервоначальная",ПечатнаяФорма.СсылкаДокПервоначальная);
			Док.Свойство("КоличествоЭкземпляров",ПечатнаяФорма.ЭкземпляровПредустановленное);
			// -- ДИТ_Агафонов_task 25372 06.10.2022
			//Евросиб Каблов 24.06.2021 ( Ticket#0225310
			Док.Свойство("ОфисныеДокументы", ПечатнаяФорма.ОфисныеДокументы);
			//Евросиб Каблов 24.06.2021 ) 
			ДобавленныеПечатныеФормы.Вставить(Док.ИмяПФ, ПечатнаяФорма);
			КоллекцияПечатныхФорм.Добавить(ПечатнаяФорма);
		КОнецЦикла;

		Если КоллекцияПечатныхФорм.Количество() <> 0 Тогда
			УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияпечатныхФорм,ОбластиОбъектов,,ПараметрКоманды);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СозданиеТаблицыДокументов(ВыделенныеСтроки,СтруктураПодписантов, ПолныйПакетРеализаций = Ложь
	// ++ ДИТ_Агафонов_task 25372 10.10.2022
	, БезРеестра = Ложь
	// -- ДИТ_Агафонов_task 25372 10.10.2022
	) ЭКСПОРТ
	
	ТаблицаДок = Новый ТаблицаЗначений;
	ТаблицаДок.Колонки.Добавить("ВидДокумента",Новый ОписаниеТипов("Строка"));
	ТаблицаДок.Колонки.Добавить("СсылкаНаДокумент",Документы.ТипВсеСсылки());
	ТаблицаДок.Колонки.Добавить("Контрагент",Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаДок.Колонки.Добавить("Договор",Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
	ТаблицаДок.Колонки.Добавить("СуммаДокумента",Новый ОписаниеТипов("Число"));
	// ++ ДИТ_Агафонов_task 25372 06.10.2022
	ТаблицаДок.Колонки.Добавить("СсылкаНаДокументПервоначальная",Документы.ТипВсеСсылки());
	// -- ДИТ_Агафонов_task 25372 06.10.2022
	
	МассивДокументов = Новый Массив;
	
	Для Каждого Элем Из ВыделенныеСтроки Цикл
		НовСтр = ТаблицаДок.Добавить();
		Если ТипЗнч(Элем.Ссылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			НовСтр.ВидДокумента = "Реализация товаров и услуг";
		ИначеЕсли ТипЗнч(Элем.Ссылка) = Тип("ДокументСсылка.СчетНаОплатуПокупателю") Тогда
			НовСтр.ВидДокумента = "Счет покупателю";
		ИначеЕсли ТипЗнч(Элем.Ссылка) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
			НовСтр.ВидДокумента = "Корректировка реализации товаров и услуг";
		ИначеЕсли ТипЗнч(Элем.Ссылка) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
			НовСтр.ВидДокумента = "Отчет комитенту";
//Евросиб Гудкова( 06.09.2020 Ticket№ 0204621
		ИначеЕсли ТипЗнч(Элем.Ссылка) = Тип("ДокументСсылка.ПСЦ") Тогда
			НовСтр.ВидДокумента = "ПСЦ";
// Евросиб Гудкова) 			
		КонецЕсли;
//Евросиб Гудкова( 06.09.2020 Ticket№ 0204621
		Если НовСтр.ВидДокумента = "ПСЦ" Тогда
			НовСтр.Договор = Элем.Договор;
			НовСтр.СуммаДокумента = 0;
		Иначе
			НовСтр.Договор = Элем.ДоговорКонтрагента;
			НовСтр.СуммаДокумента = Элем.СуммаДокумента;
		КонецЕсли;
// Евросиб Гудкова) 			
		
		НовСтр.СсылкаНаДокумент = Элем.Ссылка;
		// ++ ДИТ_Агафонов_task 25372 06.10.2022
		НовСтр.СсылкаНаДокументПервоначальная = Элем.Ссылка;
		// -- ДИТ_Агафонов_task 25372 06.10.2022
		НовСтр.Контрагент = Элем.Контрагент;
		Если ПолныйПакетРеализаций Тогда
			ДополнитьТаблицуДокументовДоПолногоПакета(Элем.Ссылка, ТаблицаДок);
		КонецЕсли;
	КонецЦикла;
	//удалим лишние счета
	мСчета = Новый Массив;
	мСчетаКУдалению = Новый Массив;
	Для каждого Док Из ТаблицаДок Цикл
		Если ТипЗнч(Док.СсылкаНаДокумент) = Тип("ДокументСсылка.СчетНаОплатуПокупателю") Тогда
			Если мСчета.Найти(Док.СсылкаНаДокумент) = Неопределено Тогда
				мСчета.Добавить(Док.СсылкаНаДокумент);
			Иначе
				мСчетаКУдалению.Добавить(Док);
			КонецЕсли; 
		КонецЕсли; 
	КонецЦикла; 
	Для каждого СчетКУдалению Из мСчетаКУдалению Цикл
		ТаблицаДок.Удалить(СчетКУдалению);
	КонецЦикла;
	
//Евросиб Литвинов 05.02.21 task 28203 (
	УстановитьУДокументовПодписантов(ТаблицаДок, СтруктураПодписантов);
//Евросиб Литвинов 05.02.21 task 28203 )
	МассивДокументов = ПечатьКомплектаДокументов.НапечататьКомплектНаСервере(ТаблицаДок,СтруктураПодписантов
	// ++ ДИТ_Агафонов_task 25372 10.10.2022
	,БезРеестра
	// -- ДИТ_Агафонов_task 25372 10.10.2022
	);

	Возврат МассивДокументов;
	
КонецФункции

&НаСервере
Процедура ДополнитьТаблицуДокументовДоПолногоПакета(ссылкаРТУ, ТаблицаДок)
	
	//счет-фактура
