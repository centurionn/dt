					ПечатнаяФорма.ОфисныеДокументы = Новый Соответствие;
				КонецЕсли;
				//ПечатнаяФорма.ОфисныеДокументы.Вставить(АдресХранилища, Строка(ДокументПечати) + ".pdf");
				//Евросиб(ДИТ), Беляев СЮ, Ticket#0390428, 13-03-2025, начало
