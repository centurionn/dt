&НаСервере
Процедура УстановитьУДокументаПодписантов(Ссылка, СтруктураПодписантов, Отказ)
	
	Если НЕ ТипЗнч(СтруктураПодписантов) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеДокумента 	 = Ссылка.Метаданные();
	// один из реквизитов, что есть у всех целевых документов - ДоверенностьЗаРуководителя
	РеквизитРуководитель 	 = МетаданныеДокумента.Реквизиты.Найти("ДоверенностьЗаРуководителя");
	Если РеквизитРуководитель <> Неопределено Тогда
		
		ЗначенияВСсылке = Новый Структура;
		ЗначенияВСсылке.Вставить("Руководитель", Справочники.ФизическиеЛица.ПустаяСсылка());
		ЗначенияВСсылке.Вставить("ГлавныйБухгалтер", Справочники.ФизическиеЛица.ПустаяСсылка());
		ЗначенияВСсылке.Вставить("ЗаРуководителяНаОсновании", "");
		ЗначенияВСсылке.Вставить("ЗаГлавногоБухгалтераНаОсновании", "");
		ЗначенияВСсылке.Вставить("ДоверенностьЗаРуководителя", Справочники.Доверенности.ПустаяСсылка());
		ЗначенияВСсылке.Вставить("ДоверенностьЗаГлБухгалтера", Справочники.Доверенности.ПустаяСсылка());
		
		ЗаполнитьЗначенияСвойств(ЗначенияВСсылке, Ссылка);
		ЕстьИзменения = ЛОЖЬ;
		Для Каждого мЗнач Из СтруктураПодписантов Цикл
			ЗначениеРеквизитаСсылки = Неопределено;
			Если НЕ ЗначенияВСсылке.Свойство(мЗнач.Ключ, ЗначениеРеквизитаСсылки) Тогда
				Продолжить;
			КонецЕсли;
			ЕстьИзменения = МАКС(ЕстьИзменения, НЕ мЗнач.Значение = ЗначениеРеквизитаСсылки);
		КонецЦикла;
		
		Если ЕстьИзменения Тогда
			
			// проверим наличие первой записи
			ЗапросПоИстории = Новый Запрос();
			ЗапросПоИстории.Текст = "ВЫБРАТЬ
			                        |	ИсторияПодписиДокументовСрезПоследних.Руководитель КАК Руководитель
			                        |ИЗ
			                        |	РегистрСведений.ИсторияПодписиДокументов.СрезПоследних(&ДатаСреза, ДокументНаПодпись = &ДокументНаПодпись) КАК ИсторияПодписиДокументовСрезПоследних";
			ЗапросПоИстории.УстановитьПараметр("ДатаСреза", ТекущаяДата());
			ЗапросПоИстории.УстановитьПараметр("ДокументНаПодпись", Ссылка);
			ВыбИстория = ЗапросПоИстории.Выполнить().Выбрать();
			Если НЕ ВыбИстория.Следующий() Тогда
				Попытка
					
					НаборЗаписей = РегистрыСведений.ИсторияПодписиДокументов.СоздатьНаборЗаписей();
					//НаборЗаписей.Отбор.ДокументНаПодпись.Установить(Ссылка);
					Запись = НаборЗаписей.Добавить();
					ЗаполнитьЗначенияСвойств(Запись, Ссылка);
					//Запись.АвторИзменений 	 = Пользователи.ТекущийПользователь();
					Запись.ДокументНаПодпись = Ссылка;
					Запись.Период			 = Ссылка.Дата;
					НаборЗаписей.Записать(Ложь);
							
				Исключение
					Отказ = Истина;
				КонецПопытки;
			КонецЕсли;
			
			// изменим документ
			Если Не Отказ Тогда
				Попытка 
					ДокОбъект = Ссылка.ПолучитьОбъект();

					ЗаполнитьЗначенияСвойств(ДокОбъект, СтруктураПодписантов);
					
					//ДокОбъект.ДополнительныеСвойства.Вставить("РазрешенаЗаписьВыставленного", Истина);
					ДокОбъект.ОбменДанными.Загрузка = Истина;

					ДокОбъект.Записать();
				Исключение
					Отказ = Истина;
				КонецПопытки;
			КонецЕсли;
			
			// запишем историю
			Если Не Отказ Тогда
				Попытка
					НаборЗаписей = РегистрыСведений.ИсторияПодписиДокументов.СоздатьНаборЗаписей();
					//НаборЗаписей.Отбор.ДокументНаПодпись.Установить(Ссылка);
					Запись = НаборЗаписей.Добавить();
					ЗаполнитьЗначенияСвойств(Запись, ДокОбъект);
					//Запись.АвторИзменений 	 = Пользователи.ТекущийПользователь();
					Запись.ДокументНаПодпись = Ссылка;
					Запись.Период			 = ТекущаяДата();
					НаборЗаписей.Записать(Ложь);
				Исключение
					Отказ = Истина;
				КонецПопытки;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
