Функция ПроверитьГеокодПоИсторииЗапросов(Геокод) Экспорт
	
	СтатусПоследнегоЗапроса = Неопределено;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(ИсторияЗапросовКГеокодеру.ДатаЗапроса) КАК ДатаЗапроса
	|ПОМЕСТИТЬ ВТ_МаксимальнаяДата
	|ИЗ
	|	РегистрСведений.ИсторияЗапросовКГеокодеру КАК ИсторияЗапросовКГеокодеру
	|ГДЕ
	|	ИсторияЗапросовКГеокодеру.ТекстЗапроса = &ТекстЗапроса
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИсторияЗапросовКГеокодеру.СтатусОбработкиЗапроса КАК СтатусОбработкиЗапроса
	|ИЗ
	|	РегистрСведений.ИсторияЗапросовКГеокодеру КАК ИсторияЗапросовКГеокодеру
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_МаксимальнаяДата КАК ВТ_МаксимальнаяДата
	|		ПО ИсторияЗапросовКГеокодеру.ДатаЗапроса = ВТ_МаксимальнаяДата.ДатаЗапроса
	|			И (ИсторияЗапросовКГеокодеру.ТекстЗапроса = &ТекстЗапроса)";
	Запрос.УстановитьПараметр("ТекстЗапроса", Геокод);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаРезультатаЗапроса = РезультатЗапроса.Выбрать();
		ВыборкаРезультатаЗапроса.Следующий();
		СтатусПоследнегоЗапроса = ВыборкаРезультатаЗапроса.СтатусОбработкиЗапроса;
	КонецЕсли;                                                                    
	Возврат СтатусПоследнегоЗапроса;
		
КонецФункции
