// Функция получает название места и возвращает массив наборов координат для него.
// М.б. несколько мест с одним названием
//
// Параметры:
//  Наименование  - Строка - Название локации
//
// Возвращаемое значение:
//   Массив   - Массив структур координат для переданного названия
//
Функция ПолучитьКоординатыПоНаименованию(Наименование) Экспорт

	// основные переменные
	Ключ = СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", "");
	
	// готовим файл с данными для отправки
	Тмп = ПолучитьИмяВременногоФайла();
	ВыходнойФайл = ПолучитьИмяВременногоФайла();
	
	ТФайл = Новый ЗаписьТекста(Тмп, КодировкаТекста.ANSI, Символы.ПС, Ложь);
	ТФайл.ЗаписатьСтроку("--" + Ключ + "--");
	ТФайл.Закрыть();
	
	// формируем заголовок запроса
	ФайлРезультат = Новый Файл(Тмп);
	ЗаголовокHTTP = Новый Соответствие();
    ЗаголовокHTTP.Вставить("Content-Type", "multipart/form-data; boundary=" + Ключ);
    
    РазмерФайлаОтправки = XMLСтрока(ФайлРезультат.Размер());
    ЗаголовокHTTP.Вставить("Content-Length", РазмерФайлаОтправки);

	// осуществляем запрос
	ЗС = Новый ЗащищенноеСоединениеOpenSSL;
	НТТР = Новый HTTPСоединение("nominatim.openstreetmap.org",,,,,, ЗС, Ложь);

	РезультатыРазбора = Новый Массив;
	Попытка 
        НТТР.ОтправитьДляОбработки(Тмп, "/search?q=" + Наименование + "&format=xml", ВыходнойФайл, ЗаголовокHTTP);
		ЧХ = Новый ЧтениеXML();
		ЧХ.ОткрытьФайл(ВыходнойФайл);
		ФО = ФабрикаXDTO.ПрочитатьXML(ЧХ);
		Попытка
			Если ТипЗнч(ФО.place) = Тип("ОбъектXDTO") Тогда
				РезультатыРазбора.Добавить(Новый Структура("Наименование, Широта, Долгота", ФО.place.display_name, ФО.place.lat, ФО.place.lon));
			ИначеЕсли ТипЗнч(ФО.place) = Тип("СписокXDTO") Тогда
				Для каждого Стр из ФО.place Цикл
					РезультатыРазбора.Добавить(Новый Структура("Наименование, Широта, Долгота", Стр.display_name, Стр.lat, Стр.lon));
				КонецЦикла;
			КонецЕсли;
		Исключение
			Сообщить("Ничего не найдено. Попробуйте задать название иначе...");
		КонецПопытки;
		ЧХ.Закрыть();
    Исключение 
        Сообщить("Неудачная попытка соединения: " + ОписаниеОшибки()); 
    КонецПопытки; 
	
	УдалитьФайлы(Тмп);

	Возврат РезультатыРазбора;

КонецФункции // ПолучитьКоординатыПоНаименованию()

Функция СоздатьХТМЛ(КаталогГеосервиса, Широта, Долгота, Масштаб = "4", Знач МассивМаркеров = неопределено, Знач МассивЛиний = неопределено, СтруктураПараметров = неопределено) Экспорт
	
	Если МассивМаркеров = неопределено Тогда МассивМаркеров = Новый Массив; КонецЕсли; 
	Если МассивЛиний = неопределено Тогда МассивЛиний = Новый Массив; КонецЕсли;
	
	Результат = "";
	КартографическийДвижок = Константы.КартографическийДвижок.Получить();
	
	Если КартографическийДвижок = Перечисления.КартографическиеДвижки.MapBoxLeafletOSM Тогда
		
		СоздатьЗаголовок(Результат, Широта, Долгота, Масштаб, КаталогГеосервиса);
		Если СтруктураПараметров <> неопределено Тогда // если есть параметры, то переданные маркеры и линии игнорируем
			СформироватьПоПараметрам(Результат, СтруктураПараметров, КаталогГеосервиса);
		Иначе // иначе рисуем то, что нам передали
			Для каждого Стр из МассивМаркеров Цикл
				ДобавитьМаркер(Результат, Стр.Широта, Стр.Долгота, Стр.Подсказка);
			КонецЦикла;
			Для каждого Стр из МассивЛиний Цикл
				ДобавитьЛинию(Результат, Стр.ШиротаНачало, Стр.ДолготаНачало, Стр.ШиротаКонец, Стр.ДолготаКонец, Стр.Цвет, Стр.Пунктиром);
			КонецЦикла;
		КонецЕсли; // конецЕсли
		ДобавитьПодвал(Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура НайтиДобавитьДанныеМестоположения(МассивЛокаций, Местоположение, Графа = неопределено, Аналитика = неопределено, Значение = неопределено, Операция = неопределено)
	
	Если Местоположение.Широта = 0 И Местоположение.Долгота = 0 Тогда Возврат; КонецЕсли;
	
	СтруктураПоиска = Новый Структура("Широта, Долгота, Графа, Аналитика", Местоположение.Широта, Местоположение.Долгота, Графа, Аналитика);
	МассивНайденныхСтрок = МассивЛокаций.НайтиСтроки(СтруктураПоиска);
	
	Если МассивНайденныхСтрок.Количество() = 0 Тогда
		
		НСтр = МассивЛокаций.Добавить();
		НСтр.Местоположение = Местоположение.Местоположение;
		НСтр.Широта = Местоположение.Широта;
		НСтр.Долгота = Местоположение.Долгота;
		НСтр.Графа = Графа;
		НСтр.Аналитика = Аналитика;
		НСтр.Значение = Значение;
		НСтр.Операция = Операция;
		
	Иначе
		
		МассивНайденныхСтрок[0].Значение = МассивНайденныхСтрок[0].Значение + Значение;
		
	КонецЕсли;
	
	
КонецПроцедуры

Процедура НайтиДобавитьДанныеЛинии(МассивЛиний, Отправление, Назначение, Пунктиром, Цвет = "")
	
	
	ЛинияНайдена = Ложь;
	
	Для каждого Стр из МассивЛиний Цикл
		
		СтруктураПоиска = Новый Структура("ОтправлениеШирота, ОтправлениеДолгота, НазначениеШирота, НазначениеДолгота", Отправление.Широта, Отправление.Долгота, Назначение.Широта, Назначение.Долгота);
		РезПоиска = МассивЛиний.НайтиСтроки(СтруктураПоиска);
		Если РезПоиска.Количество() > 0 Тогда ЛинияНайдена = Истина; КонецЕсли;
		
		СтруктураПоиска = Новый Структура("ОтправлениеШирота, ОтправлениеДолгота, НазначениеШирота, НазначениеДолгота", Назначение.Широта, Назначение.Долгота, Отправление.Широта, Отправление.Долгота);
		РезПоиска = МассивЛиний.НайтиСтроки(СтруктураПоиска);
		Если РезПоиска.Количество() > 0 Тогда ЛинияНайдена = Истина; КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ЛинияНайдена Тогда
		НСтр = МассивЛиний.Добавить();
		НСтр.ОтправлениеШирота = Отправление.Широта;
		НСтр.ОтправлениеДолгота = Отправление.Долгота;
		НСтр.НазначениеШирота = Назначение.Широта;
		НСтр.НазначениеДолгота = Назначение.Долгота;
		НСтр.Пунктиром = Пунктиром;
		НСтр.Цвет = Цвет;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьМассивОпорныхПунктовПоЗаказу(Заказ, ОтображатьТрек, ТС)
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	Операция.Ссылка КАК Операция
	               |ИЗ
	               |	Документ.Операция КАК Операция
	               |ГДЕ
	               |	Операция.ПланФакт = ЗНАЧЕНИЕ(Перечисление.ПланФактСчет.Факт)
	               |	И ВЫБОР
	               |			КОГДА &ОтображатьТрек
	               |				ТОГДА Операция.Ссылка В
	               |						(ВЫБРАТЬ
	               |							ОперацияГрузы.Ссылка КАК Ссылка
	               |						ИЗ
	               |							Документ.Операция.Грузы КАК ОперацияГрузы
	               |						ГДЕ
	               |							ОперацияГрузы.ТС В (&ТС))
	               |			ИНАЧЕ Операция.Сделка В (&Заказ)
	               |		КОНЕЦ
	               |	И Операция.Услуга.ОперацияОтображаетсяВГеосервисе";
	
	//Запрос.Текст = "ВЫБРАТЬ
	//               |	СвязиОпераций.Операция
	//               |ИЗ
	//               |	РегистрСведений.СвязиОпераций КАК СвязиОпераций
	//               |ГДЕ
	//               |	СвязиОпераций.ПланФакт = ЗНАЧЕНИЕ(Перечисление.ПланФактСчет.Факт)
	//               |	И ВЫБОР
	//               |			КОГДА &ОтображатьТрек
	//               |				ТОГДА СвязиОпераций.Операция В
	//               |						(ВЫБРАТЬ
	//               |							ГрузыВОперациях.Операция
	//               |						ИЗ
	//               |							РегистрНакопления.ГрузыВОперациях КАК ГрузыВОперациях
	//               |						ГДЕ
	//               |							ГрузыВОперациях.ТС В (&ТС))
	//               |			ИНАЧЕ СвязиОпераций.Заказ = &Заказ
	//               |		КОНЕЦ";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("ОтображатьТрек", ОтображатьТрек);
	Запрос.УстановитьПараметр("ТС", ТС);
	МассивОпераций = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Операция");
	
	// Результат складывается из 3 составляющих: плановый старт + плановый финиш + пройденные места
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	Операция.ДатаОтправления КАК Дата,
	               |	Операция.Ссылка КАК Операция,
	               |	Операция.ПунктОтправления КАК Местоположение,
	               |	Операция.ПунктОтправления.Широта КАК Широта,
	               |	Операция.ПунктОтправления.Долгота КАК Долгота
	               |ПОМЕСТИТЬ Т1
	               |ИЗ
	               |	Документ.Операция КАК Операция
	               |ГДЕ
	               |	Операция.ДатаОтправленияФакт = ДАТАВРЕМЯ(1, 1, 1)
	               |	И Операция.Ссылка В(&Операция)
	               |	И Операция.Услуга.ОперацияОтображаетсяВГеосервисе
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	Операция.ДатаНазначения,
	               |	Операция.Ссылка,
	               |	Операция.ПунктНазначения,
	               |	Операция.ПунктНазначения.Широта,
	               |	Операция.ПунктНазначения.Долгота
	               |ИЗ
	               |	Документ.Операция КАК Операция
	               |ГДЕ
	               |	Операция.ДатаНазначенияФакт = ДАТАВРЕМЯ(1, 1, 1)
	               |	И Операция.Ссылка В(&Операция)
	               |	И Операция.Услуга.ОперацияОтображаетсяВГеосервисе
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ТректингТранспорта.Период,
	               |	ТректингТранспорта.Операция,
	               |	ТректингТранспорта.Местоположение,
	               |	ВЫБОР
	               |		КОГДА ТректингТранспорта.Широта = 0
	               |			ТОГДА ТректингТранспорта.Местоположение.Широта
	               |		ИНАЧЕ ТректингТранспорта.Широта
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА ТректингТранспорта.Долгота = 0
	               |			ТОГДА ТректингТранспорта.Местоположение.Долгота
	               |		ИНАЧЕ ТректингТранспорта.Долгота
	               |	КОНЕЦ
	               |ИЗ
	               |	РегистрСведений.ТректингТранспорта КАК ТректингТранспорта
	               |ГДЕ
	               |	ТректингТранспорта.Операция В(&Операция)
	               |	И ТректингТранспорта.Операция.Услуга.ОперацияОтображаетсяВГеосервисе
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Т1.Дата КАК Дата,
	               |	Т1.Операция КАК Операция,
	               |	Т1.Местоположение КАК Местоположение,
	               |	Т1.Широта КАК Широта,
	               |	Т1.Долгота КАК Долгота
	               |ИЗ
	               |	Т1 КАК Т1
	               |ГДЕ
	               |	(Т1.Широта <> 0
	               |			ИЛИ Т1.Долгота <> 0)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата
	               |ИТОГИ ПО
	               |	Широта,
	               |	Долгота";
	
	//Запрос.Текст = "ВЫБРАТЬ
	//               |	ДатыОпераций.ПлановаяДатаНачала КАК Дата,
	//               |	ДатыОпераций.Операция,
	//               |	ДатыОпераций.Операция.ПунктОтправления КАК Местоположение,
	//               |	ДатыОпераций.Операция.ПунктОтправления.Широта КАК Широта,
	//               |	ДатыОпераций.Операция.ПунктОтправления.Долгота КАК Долгота
	//               |ПОМЕСТИТЬ ТЗ1
	//               |ИЗ
	//               |	РегистрСведений.ДатыОпераций КАК ДатыОпераций
	//               |ГДЕ
	//               |	ДатыОпераций.ФактическаяДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
	//               |	И ДатыОпераций.Операция В(&Операция)
	//               |
	//               |ОБЪЕДИНИТЬ ВСЕ
	//               |
	//               |ВЫБРАТЬ
	//               |	ДатыОпераций.ПлановаяДатаОкончания,
	//               |	ДатыОпераций.Операция,
	//               |	ДатыОпераций.Операция.ПунктНазначения,
	//               |	ДатыОпераций.Операция.ПунктНазначения.Широта,
	//               |	ДатыОпераций.Операция.ПунктНазначения.Долгота
	//               |ИЗ
	//               |	РегистрСведений.ДатыОпераций КАК ДатыОпераций
	//               |ГДЕ
	//               |	ДатыОпераций.ФактическаяДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	//               |	И ДатыОпераций.Операция В(&Операция)
	//               |
	//               |ОБЪЕДИНИТЬ ВСЕ
	//               |
	//               |ВЫБРАТЬ
	//               |	ТректингТранспорта.Период,
	//               |	ТректингТранспорта.Операция,
	//               |	ТректингТранспорта.Местоположение,
	//               |	ВЫБОР
	//               |		КОГДА ТректингТранспорта.Широта = 0
	//               |			ТОГДА ТректингТранспорта.Местоположение.Широта
	//               |		ИНАЧЕ ТректингТранспорта.Широта
	//               |	КОНЕЦ,
	//               |	ВЫБОР
	//               |		КОГДА ТректингТранспорта.Долгота = 0
	//               |			ТОГДА ТректингТранспорта.Местоположение.Долгота
	//               |		ИНАЧЕ ТректингТранспорта.Долгота
	//               |	КОНЕЦ
	//               |ИЗ
	//               |	РегистрСведений.ТректингТранспорта КАК ТректингТранспорта
	//               |ГДЕ
	//               |	ТректингТранспорта.Операция В(&Операция)
	//               |;
	//               |
	//               |////////////////////////////////////////////////////////////////////////////////
	//               |ВЫБРАТЬ
	//               |	ТЗ1.Дата КАК Дата,
	//               |	ТЗ1.Операция,
	//               |	ТЗ1.Местоположение,
	//               |	ТЗ1.Широта КАК Широта,
	//               |	ТЗ1.Долгота КАК Долгота
	//               |ИЗ
	//               |	ТЗ1 КАК ТЗ1
	//               |ГДЕ
	//               |	(ТЗ1.Широта <> 0
	//               |			ИЛИ ТЗ1.Долгота <> 0)
	//               |
	//               |УПОРЯДОЧИТЬ ПО
	//               |	Дата
	//               |ИТОГИ ПО
	//               |	Широта,
	//               |	Долгота";
	Запрос.УстановитьПараметр("Операция", МассивОпераций);
	ОтветШирота = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ОтветШирота.Следующий() Цикл
		ОтветДолгота = ОтветШирота.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ОтветДолгота.Следующий() Цикл
			
			// местоположение общее
			Местоположение = Справочники.Локации.ПустаяСсылка();
			Подсказка = "";
			
			Ответ = ОтветДолгота.Выбрать();
			Пока Ответ.Следующий() Цикл
				
				Подсказка = Подсказка + "<tr><td style='font-family: verdana; font-size:10px; border-bottom: 1px solid black;'>"+Формат(Ответ.Дата, "ДФ='HH:mm dd.MM.yy'")+"</td><td style='font-family: verdana; font-size:10px; border-bottom: 1px solid black;'><a href='javascript:void(document.getElementById(\""openoperation\"").value = \"""+Ответ.Операция.Номер+"_"+Год(Ответ.Операция.Дата)+"\"");'>"+Ответ.Операция.Услуга + " " + Ответ.Операция.Номер +"</a></td></tr>";
				Местоположение = Ответ.Местоположение;
				
			КонецЦикла;
			
			Подсказка = "<table width='300px'><tr><td colspan='2' style='font-family: verdana; font-size:12px;'><a href='javascript:void(document.getElementById(\""openreport\"").value = \"""+Местоположение.Код+"\"");'>"+Местоположение+" &rArr;</a></td></tr>" + Подсказка;
			
			Результат.Добавить(Новый Структура("Местоположение, Широта, Долгота, Подсказка", Местоположение, ОтветДолгота.Широта, ОтветДолгота.Долгота, Подсказка));
			
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;	
	
КонецФункции

Функция ПолучитьНепривязанныеЛинии(СтруктураПараметров)
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ "+СтрЗаменить(СтруктураПараметров.КоличествоОтрезков, Символы.НПП, "")+"
	               |	ВЫБОР
	               |		КОГДА ТректингТранспорта.Широта = 0
	               |				И ТректингТранспорта.Долгота = 0
	               |			ТОГДА ТректингТранспорта.Местоположение.Широта
	               |		ИНАЧЕ ТректингТранспорта.Широта
	               |	КОНЕЦ КАК Широта,
	               |	ВЫБОР
	               |		КОГДА ТректингТранспорта.Широта = 0
	               |				И ТректингТранспорта.Долгота = 0
	               |			ТОГДА ТректингТранспорта.Местоположение.Долгота
	               |		ИНАЧЕ ТректингТранспорта.Долгота
	               |	КОНЕЦ КАК Долгота,
	               |	ТректингТранспорта.Операция
	               |ИЗ
	               |	РегистрСведений.ТректингТранспорта КАК ТректингТранспорта
	               |ГДЕ
	               |	ТректингТранспорта.ТС = &ТС
	               |	И (ТректингТранспорта.Широта <> 0
	               |			ИЛИ ТректингТранспорта.Долгота <> 0
	               |			ИЛИ ТректингТранспорта.Местоположение <> ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка))
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ТректингТранспорта.Период УБЫВ";
				   
				   Для каждого ПодТС из СтруктураПараметров.ТС Цикл
					   
					   Запрос.УстановитьПараметр("ТС", ПодТС);
					   Ответ = Запрос.Выполнить().Выгрузить();
					   Если Ответ.Количество() < 3 Тогда Возврат Результат; КонецЕсли;
					   Для Сч = 1 По Ответ.Количество()-2 Цикл
						   Если НЕ ЗначениеЗаполнено(Ответ[Сч].Операция) Тогда
							   Результат.Добавить(Новый Структура("Отправление, Назначение", Новый Структура("Широта, Долгота", Ответ[Сч-1].Широта, Ответ[Сч-1].Долгота), Новый Структура("Широта, Долгота", Ответ[Сч].Широта, Ответ[Сч].Долгота)));
							   Результат.Добавить(Новый Структура("Отправление, Назначение", Новый Структура("Широта, Долгота", Ответ[Сч+1].Широта, Ответ[Сч+1].Долгота), Новый Структура("Широта, Долгота", Ответ[Сч].Широта, Ответ[Сч].Долгота)));
						   КонецЕсли;
					   КонецЦикла;
					   Если НЕ ЗначениеЗаполнено(Ответ[Ответ.Количество()-1].Операция) Тогда
						   Результат.Добавить(Новый Структура("Отправление, Назначение", Новый Структура("Широта, Долгота", Ответ[Ответ.Количество()-1].Широта, Ответ[Ответ.Количество()-1].Долгота), Новый Структура("Широта, Долгота", Ответ[Ответ.Количество()-2].Широта, Ответ[Ответ.Количество()-2].Долгота)));
					   КонецЕсли;
					   Если НЕ ЗначениеЗаполнено(Ответ[0].Операция) Тогда
						   Результат.Добавить(Новый Структура("Отправление, Назначение", Новый Структура("Широта, Долгота", Ответ[0].Широта, Ответ[0].Долгота), Новый Структура("Широта, Долгота", Ответ[1].Широта, Ответ[1].Долгота)));
					   КонецЕсли;
					   
				   КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура СформироватьПоПараметрам(Результат, СтруктураПараметров, КаталогГеосервиса)
	
	ЦветРисуемыхЛиний = "red";
	
	КвалификаторыШиротыДолготы = Новый КвалификаторыЧисла(9, 6, ДопустимыйЗнак.Неотрицательный);
	ОТ_ШД = Новый ОписаниеТипов("Число",,,КвалификаторыШиротыДолготы);
	КС = Новый КвалификаторыСтроки(25, ДопустимаяДлина.Переменная);
	
	МассивЛокаций = Новый ТаблицаЗначений;
	МассивЛокаций.Колонки.Добавить("Местоположение", Новый ОписаниеТипов("СправочникСсылка.Локации"));
	МассивЛокаций.Колонки.Добавить("Широта", ОТ_ШД);
	МассивЛокаций.Колонки.Добавить("Долгота", ОТ_ШД);
	
	МассивЛокаций.Колонки.Добавить("Графа", Новый ОписаниеТипов("Строка",,,,КС));
	
	АналитикаМассив = Новый Массив;
	АналитикаМассив.Добавить(Тип("СправочникСсылка.ТипоразмерыТЕ"));
	АналитикаМассив.Добавить(Тип("СправочникСсылка.ТипоразмерыТС"));
	
	МассивЛокаций.Колонки.Добавить("Аналитика", Новый ОписаниеТипов(АналитикаМассив));
	МассивЛокаций.Колонки.Добавить("Значение", Новый ОписаниеТипов("Число"));
	МассивЛокаций.Колонки.Добавить("Операция", Новый ОписаниеТипов("ДокументСсылка.Операция"));
	МассивЛокаций.Индексы.Добавить("Широта, Долгота, Графа, Аналитика");
	
	МассивЛиний = Новый ТаблицаЗначений;
	МассивЛиний.Колонки.Добавить("ОтправлениеШирота", ОТ_ШД);
	МассивЛиний.Колонки.Добавить("ОтправлениеДолгота", ОТ_ШД);	
	МассивЛиний.Колонки.Добавить("НазначениеШирота", ОТ_ШД);
	МассивЛиний.Колонки.Добавить("НазначениеДолгота", ОТ_ШД);
	МассивЛиний.Колонки.Добавить("Пунктиром", Новый ОписаниеТипов("Булево"));
	МассивЛиний.Колонки.Добавить("Цвет", Новый ОписаниеТипов("Строка"));
	МассивЛиний.Индексы.Добавить("ОтправлениеШирота, ОтправлениеДолгота, НазначениеШирота, НазначениеДолгота");
	
	Если ЗначениеЗаполнено(СтруктураПараметров.Заказ) ИЛИ СтруктураПараметров.ОтобразитьТрек Тогда
		
		СтруктураТрекингаЛиний = ПолучитьДанныеМаршрутовПоТрекингу(СтруктураПараметров);
		Для каждого Стр из СтруктураТрекингаЛиний Цикл
			НайтиДобавитьДанныеЛинии(МассивЛиний, Стр.Отправление, Стр.Назначение, Стр.Пунктиром);
		КонецЦикла;
		
		СтруктураНепривязанныхДвижений = ПолучитьНепривязанныеЛинии(СтруктураПараметров);
		Для каждого Стр из СтруктураНепривязанныхДвижений Цикл
			НайтиДобавитьДанныеЛинии(МассивЛиний, Стр.Отправление, Стр.Назначение, Ложь, "green");
		КонецЦикла;
		
		СчЛиний = 1;
		Для каждого Стр из МассивЛиний Цикл
			Если СчЛиний > СтруктураПараметров.КоличествоОтрезков Тогда Прервать; КонецЕсли;
			ДобавитьЛинию(Результат, Стр.ОтправлениеШирота, Стр.ОтправлениеДолгота, Стр.НазначениеШирота, Стр.НазначениеДолгота, ?(ЗначениеЗаполнено(Стр.Цвет), Стр.Цвет, ЦветРисуемыхЛиний), Стр.Пунктиром);
			СчЛиний = СчЛиний + 1;
		КонецЦикла;
		
		Если НЕ СтруктураПараметров.ОтображатьПрогноз Тогда
			МассивОпорныхПунктов = ПолучитьМассивОпорныхПунктовПоЗаказу(СтруктураПараметров.Заказ, СтруктураПараметров.ОтобразитьТрек, СтруктураПараметров.ТС);
			Для каждого Стр из МассивОпорныхПунктов Цикл
				ДобавитьМаркер(Результат, Стр.Широта, Стр.Долгота, Стр.Подсказка, "tourism");
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	// Если это не прогноз, то надо отобразить текущее местоположение грузов по операциям и маршруты по трекингу
	Если НЕ СтруктураПараметров.ОтображатьПрогноз Тогда
		
		СтруктураТрекингаТранспорта = ПолучитьДанныеТрекингаНаДату(СтруктураПараметров);
		Для каждого Стр из СтруктураТрекингаТранспорта Цикл
			НайтиДобавитьДанныеМестоположения(МассивЛокаций, Стр.Местоположение,,,,Стр.Операция);
		КонецЦикла;
		
	Иначе
		
		// -------------------- ОСТАТКИ -------------------- //
		Запрос = Новый Запрос;
		
		Если СтруктураПараметров.РежимОтображенияТСТЕ = 0 Тогда
			
			Запрос.Текст = "ВЫБРАТЬ
			               |	ПозицияВагоновФактОстатки.ТипВагона КАК Тип,
			               |	ПозицияВагоновФактОстатки.ФактОстаток КАК Количество,
			               |	ПозицияВагоновФактОстатки.Локация КАК Местоположение,
			               |	ПозицияВагоновФактОстатки.Локация.Долгота КАК Долгота,
			               |	ПозицияВагоновФактОстатки.Локация.Широта КАК Широта
			               |ИЗ
			               |	РегистрНакопления.ПозицияВагоновФакт.Остатки(&ДатаФактОстатков, ) КАК ПозицияВагоновФактОстатки
			               |ГДЕ
			               |	(ПозицияВагоновФактОстатки.Локация В ИЕРАРХИИ (&Местоположение)
			               |			ИЛИ &Местоположение = ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка))
						   //|	И (ПозицияВагоновФактОстатки.Сделка В (&Заказ)
						   //|			ИЛИ &ЗаказПустой)
			               |	И ПозицияВагоновФактОстатки.ФактОстаток <> 0
						   //|	И ВЫБОР
						   //|			КОГДА &ОтображатьТС = 1
						   //|				ТОГДА ПозицияВагоновФактОстатки.Груженое
						   //|			КОГДА &ОтображатьТС = 2
						   //|				ТОГДА НЕ ПозицияВагоновФактОстатки.Груженое
						   //|			ИНАЧЕ ИСТИНА
						   //|		КОНЕЦ
			               |	И ВЫБОР
			               |			КОГДА &ТипТСЗаполнено
			               |				ТОГДА ПозицияВагоновФактОстатки.ТипВагона В (&ТипТС)
			               |			ИНАЧЕ ИСТИНА
			               |		КОНЕЦ
			               |	И ВЫБОР
			               |			КОГДА &ТСЗаполнено
			               |				ТОГДА ПозицияВагоновФактОстатки.Вагон В (&ТС)
			               |			ИНАЧЕ ИСТИНА
			               |		КОНЕЦ
			               |	И ВЫБОР
			               |			КОГДА &ВладелецТСЗаполнено
			               |				ТОГДА ПозицияВагоновФактОстатки.Вагон.ВладелецТС В (&ВладелецТС)
			               |			ИНАЧЕ ИСТИНА
			               |		КОНЕЦ";
			
		Иначе
			
			Запрос.Текст = "ВЫБРАТЬ
			               |	ПозицияКонтейнеровФактОстатки.ФактОстаток КАК Количество,
			               |	ПозицияКонтейнеровФактОстатки.Локация КАК Местоположение,
			               |	ПозицияКонтейнеровФактОстатки.Локация.Долгота КАК Долгота,
			               |	ПозицияКонтейнеровФактОстатки.Локация.Широта КАК Широта,
			               |	ПозицияКонтейнеровФактОстатки.ТипКТК КАК Тип,
			               |	ПозицияКонтейнеровФактОстатки.Контейнер КАК Контейнер
			               |ПОМЕСТИТЬ ВТ
			               |ИЗ
			               |	РегистрНакопления.ПозицияКонтейнеровФакт.Остатки(&ДатаФактОстатков, ) КАК ПозицияКонтейнеровФактОстатки
			               |ГДЕ
			               |	(ПозицияКонтейнеровФактОстатки.Локация В ИЕРАРХИИ (&Местоположение)
			               |			ИЛИ &Местоположение = ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка))
						   //|	И (ПозицияКонтейнеровФактОстатки.Сделка В (&Заказ)
						   //|			ИЛИ &ЗаказПустой)
			               |	И ПозицияКонтейнеровФактОстатки.ФактОстаток <> 0
						   //|	И ВЫБОР
						   //|			КОГДА &ОтображатьТЕ = 1
						   //|				ТОГДА ПозицияКонтейнеровФактОстатки.Груженое
						   //|			КОГДА &ОтображатьТЕ = 2
						   //|				ТОГДА НЕ ПозицияКонтейнеровФактОстатки.Груженое
						   //|			ИНАЧЕ ИСТИНА
						   //|		КОНЕЦ
			               |	И ВЫБОР
			               |			КОГДА &ТипТЕЗаполнено
			               |				ТОГДА ПозицияКонтейнеровФактОстатки.ТипКТК В (&ТипТЕ)
			               |			ИНАЧЕ ИСТИНА
			               |		КОНЕЦ
			               |	И ВЫБОР
			               |			КОГДА &ТЕЗаполнено
			               |				ТОГДА ПозицияКонтейнеровФактОстатки.Контейнер В (&ТЕ)
			               |			ИНАЧЕ ИСТИНА
			               |		КОНЕЦ
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	ВТ.Количество КАК Количество,
			               |	ВТ.Местоположение КАК Местоположение,
			               |	ВТ.Долгота КАК Долгота,
			               |	ВТ.Широта КАК Широта,
			               |	ВТ.Тип КАК Тип,
			               |	ПризнакСобственностиКонтейнераСрезПоследних.ВладелецКТК КАК ВладелецТЕ
			               |ИЗ
			               |	ВТ КАК ВТ
			               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакСобственностиКонтейнера.СрезПоследних(
			               |				&ДатаФактОстатков,
			               |				Контейнер В
			               |					(ВЫБРАТЬ
			               |						ВТ.Контейнер
			               |					ИЗ
			               |						Вт КАК ВТ)) КАК ПризнакСобственностиКонтейнераСрезПоследних
			               |		ПО ВТ.Контейнер = ПризнакСобственностиКонтейнераСрезПоследних.Контейнер
			               |ГДЕ
			               |	ВЫБОР
			               |			КОГДА &ВладелецТЕЗаполнено
			               |				ТОГДА ПризнакСобственностиКонтейнераСрезПоследних.ВладелецКТК В (&ВладелецТЕ)
			               |			ИНАЧЕ ИСТИНА
			               |		КОНЕЦ";
			
		КонецЕсли;
		
		//Запрос.Текст = "ВЫБРАТЬ
		//               |	ВЫБОР
		//               |		КОГДА &ТипТСТЕ = 0
		//               |			ТОГДА ОстаткиТСТЕОстатки.ТипТС
		//               |		КОГДА &ТипТСТЕ = 1
		//               |			ТОГДА ОстаткиТСТЕОстатки.ТипТЕ
		//               |	КОНЕЦ КАК Тип,
		//               |	ВЫБОР
		//               |		КОГДА &ТипТСТЕ = 0
		//               |			ТОГДА ОстаткиТСТЕОстатки.КоличествоТСОстаток
		//               |		КОГДА &ТипТСТЕ = 1
		//               |			ТОГДА ОстаткиТСТЕОстатки.КоличествоТЕОстаток
		//               |	КОНЕЦ КАК Количество,
		//               |	ОстаткиТСТЕОстатки.Местоположение,
		//               |	ОстаткиТСТЕОстатки.Местоположение.Широта КАК Широта,
		//               |	ОстаткиТСТЕОстатки.Местоположение.Долгота КАК Долгота
		//               |ИЗ
		//               |	РегистрНакопления.ОстаткиТСТЕ.Остатки(&ДатаФактОстатков, ) КАК ОстаткиТСТЕОстатки
		//               |ГДЕ
		//               |	(ОстаткиТСТЕОстатки.Организация = &Организация
		//               |			ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
		//               |	И (ОстаткиТСТЕОстатки.Местоположение В ИЕРАРХИИ (&Местоположение)
		//               |			ИЛИ &Местоположение = ЗНАЧЕНИЕ(Справочник.Местоположения.ПустаяСсылка))
		//               |	И (ОстаткиТСТЕОстатки.Заказ = &Заказ
		//               |			ИЛИ &Заказ = ЗНАЧЕНИЕ(Документ.Заказ.ПустаяСсылка))
		//               |	И (ОстаткиТСТЕОстатки.ПланФакт = ЗНАЧЕНИЕ(Перечисление.ПланФактСчет.Факт)
		//               |			ИЛИ ОстаткиТСТЕОстатки.Заказ.ФактическаяТРСХПустая)
		//               |	И ВЫБОР
		//               |			КОГДА &ТипТСТЕ = 0
		//               |				ТОГДА ОстаткиТСТЕОстатки.КоличествоТСОстаток <> 0
		//               |			КОГДА &ТипТСТЕ = 1
		//               |				ТОГДА ОстаткиТСТЕОстатки.КоличествоТЕОстаток <> 0
		//               |		КОНЕЦ
		//               |	И ВЫБОР
		//               |				КОГДА &ОтображатьТС = 1
		//               |					ТОГДА ОстаткиТСТЕОстатки.ГруженоеТС
		//               |				КОГДА &ОтображатьТС = 2
		//               |					ТОГДА НЕ ОстаткиТСТЕОстатки.ГруженоеТС
		//               |				ИНАЧЕ ИСТИНА
		//               |			КОНЕЦ
		//               |			И ВЫБОР
		//               |				КОГДА &ОтображатьТЕ = 1
		//               |					ТОГДА ОстаткиТСТЕОстатки.ГруженоеТЕ
		//               |				КОГДА &ОтображатьТЕ = 2
		//               |					ТОГДА НЕ ОстаткиТСТЕОстатки.ГруженоеТЕ
		//               |				ИНАЧЕ ИСТИНА
		//               |			КОНЕЦ
		//               |	И ВЫБОР
		//               |				КОГДА &ТипТСЗаполнено
		//               |					ТОГДА ОстаткиТСТЕОстатки.ТипТС В (&ТипТС)
		//               |				ИНАЧЕ ИСТИНА
