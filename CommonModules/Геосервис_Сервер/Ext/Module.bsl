Процедура ДобавитьПодвал(Результат)
	
	Результат = Результат + "</script><input type=""hidden"" id=""openmismatch"" name=""openmismatch"" value=""none""><input type=""hidden"" id=""openoperation"" name=""openoperation"" value=""none""><input type=""hidden"" id=""openreport"" name=""openreport"" value=""none""></body></html>";
	
КонецПроцедуры

Процедура ДобавитьМаркер(Результат, Знач Широта, Знач Долгота, Текст, Маркер = "tp")
	
	Широта = СтрЗаменить(Широта, ",", "."); Долгота = СтрЗаменить(Долгота, ",", ".");
	Результат = Результат + "L.marker(["+Широта+", "+Долгота+"], {icon: "+Маркер+", iconSize: [20, 20]}).addTo(map).bindPopup("""+Текст+""");";
	
КонецПроцедуры

Функция ПреобразоватьПуть(Путь)
	
	Возврат "file:///" + СтрЗаменить(Путь, "\", "\\");
	
КонецФункции

Процедура ДобавитьЛинию(Результат, Знач ШиротаНачало, Знач ДолготаНачало, Знач ШиротаКонец, Знач ДолготаКонец, Цвет, Пунктиром)
	
	ШиротаНачало = СтрЗаменить(ШиротаНачало, ",", "."); ДолготаНачало = СтрЗаменить(ДолготаНачало, ",", "."); ШиротаКонец = СтрЗаменить(ШиротаКонец, ",", "."); ДолготаКонец = СтрЗаменить(ДолготаКонец, ",", ".");
	Результат = Результат + "var mpl = new L.Polyline([new L.LatLng(" + ШиротаНачало + ", " + ДолготаНачало + "), new L.LatLng(" + ШиротаКонец + ", " + ДолготаКонец + ")], { color: '" + Цвет + "', weight: 2, opacity: 0.5, smoothFactor: 1" + ?(Пунктиром, ", dashArray: '5, 5'", "") + " }); mpl.addTo(map);";
	
КонецПроцедуры

// Функция вызывается из самого DC
Функция ПолучитьАналитикиОперации(Операция, Аналитика) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ОперацияГрузы."+Аналитика+"
	               |ИЗ
	               |	Документ.Операция.Грузы КАК ОперацияГрузы
	               |ГДЕ
	               |	ОперацияГрузы.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Операция", Операция);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(Аналитика);
	
КонецФункции

