			Запрос.УстановитьПараметр("ТипТС", СтруктураПараметров.ТипТС);
			Запрос.УстановитьПараметр("ТипТЕЗаполнено", СтруктураПараметров.ТипТЕ.Количество() > 0);
			Запрос.УстановитьПараметр("ТипТЕ", СтруктураПараметров.ТипТЕ);
			Запрос.УстановитьПараметр("ТСЗаполнено", СтруктураПараметров.ТС.Количество() > 0);
			Запрос.УстановитьПараметр("ТС", СтруктураПараметров.ТС);
			Запрос.УстановитьПараметр("ТЕЗаполнено", СтруктураПараметров.ТЕ.Количество() > 0);
			Запрос.УстановитьПараметр("ТЕ", СтруктураПараметров.ТЕ);
			Запрос.УстановитьПараметр("ВладелецТСЗаполнено", СтруктураПараметров.ВладелецТС.Количество() > 0);
			Запрос.УстановитьПараметр("ВладелецТС", СтруктураПараметров.ВладелецТС);
			Запрос.УстановитьПараметр("ВладелецТЕЗаполнено", СтруктураПараметров.ВладелецТЕ.Количество() > 0);
			Запрос.УстановитьПараметр("ВладелецТЕ", СтруктураПараметров.ВладелецТЕ);
			
			Ответ = Запрос.Выполнить().Выбрать();
			Пока Ответ.Следующий() Цикл
				НайтиДобавитьДанныеМестоположения(МассивЛокаций, Новый Структура("Широта, Долгота, Местоположение", Ответ.Широта, Ответ.Долгота, Ответ.Местоположение), "ПрогнозПлан", Ответ.Тип, Ответ.Количество);
			КонецЦикла;
			
		КонецЕсли;

	КонецЕсли;
	
	// Преобразуем таблицу локаций в нормальный вид и выводим данные

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТЧ.Местоположение,
	               |	ТЧ.Широта,
	               |	ТЧ.Долгота,
	               |	ТЧ.Графа,
	               |	ТЧ.Аналитика,
	               |	ТЧ.Значение,
	               |	ТЧ.Операция
	               |ПОМЕСТИТЬ Таб1
	               |ИЗ
	               |	&ТЧ КАК ТЧ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Таб1.Местоположение КАК Местоположение,
	               |	Таб1.Широта КАК Широта,
	               |	Таб1.Долгота КАК Долгота,
	               |	Таб1.Графа,
	               |	Таб1.Аналитика КАК Аналитика,
	               |	СУММА(Таб1.Значение) КАК Значение,
	               |	МАКСИМУМ(Таб1.Операция) КАК Операция
	               |ИЗ
	               |	Таб1 КАК Таб1
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Таб1.Местоположение,
	               |	Таб1.Широта,
	               |	Таб1.Долгота,
	               |	Таб1.Графа,
	               |	Таб1.Аналитика
	               |ИТОГИ
	               |	МАКСИМУМ(Широта),
	               |	МАКСИМУМ(Долгота)
	               |ПО
	               |	Местоположение,
	               |	Аналитика";
	Запрос.УстановитьПараметр("ТЧ", МассивЛокаций);
	ОтветМестоположение = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ОтветМестоположение.Следующий() Цикл
		
		// уровень всего местоположения
		Если ЗначениеЗаполнено(ОтветМестоположение.Местоположение) Тогда
			ТекстПодсказки = "<table width='300px'><tr><td " + ?(СтруктураПараметров.ОтображатьПрогноз, "colspan='5'", "") + " style='font-family: verdana; font-size:12px;'><a href='javascript:void(document.getElementById(\""openreport\"").value = \"""+ОтветМестоположение.Местоположение.Код+"\"");'>"+ОтветМестоположение.Местоположение+" &rArr;</a></td></tr>";
		Иначе
			ТекстПодсказки = "<table width='300px'><tr><td " + ?(СтруктураПараметров.ОтображатьПрогноз, "colspan='5'", "") + " style='font-family: verdana; font-size:12px;'>("+ОтветМестоположение.Широта+"; "+ОтветМестоположение.Долгота+")</td></tr>";
		КонецЕсли;
		
		Если СтруктураПараметров.ОтображатьПрогноз Тогда
			ТекстПодсказки = ТекстПодсказки + "<tr><td style='font-family: verdana; font-size:10px; border-bottom: 1px solid black;'>Тип</td><td style='font-family: verdana; font-size:10px; border-bottom: 1px solid black;'>Факт</td><td style='font-family: verdana; font-size:10px; border-bottom: 1px solid black;'>Прогноз (неутв.)</td><td style='font-family: verdana; font-size:10px; border-bottom: 1px solid black;'>Прогноз (утв.)</td><td style='font-family: verdana; font-size:10px; border-bottom: 1px solid black;'>Итого</td></tr>";
		КонецЕсли;
		
		МаркерОтправки = "tp";
		
		ОтветАналитика = ОтветМестоположение.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ОтветАналитика.Следующий() Цикл
			
			// уровень аналитик
			ГрафаФакт = 0;
			ГрафаПрогнозПлан = 0;
			ГрафаПрогнозФакт = 0;
			
			Если ТипЗнч(ОтветАналитика.Аналитика) = Тип("СправочникСсылка.ТипоразмерыТС") Тогда
				
				Значок = "";
				
				Если ОтветАналитика.Аналитика.Авто Тогда
					Значок = "truck";
				ИначеЕсли ОтветАналитика.Аналитика.Авиа Тогда
					Значок = "airport";
				ИначеЕсли ОтветАналитика.Аналитика.Вагон Тогда
					Значок = "train";
				ИначеЕсли ОтветАналитика.Аналитика.Судно Тогда
					Значок = "boat";
				КонецЕсли;
				
				Если МаркерОтправки = "tp" ИЛИ МаркерОтправки = Значок Тогда
					МаркерОтправки = Значок;
				Иначе
					МаркерОтправки = "";
				КонецЕсли;
				
			КонецЕсли;
			
			Ответ = ОтветАналитика.Выбрать();
			Пока Ответ.Следующий() Цикл
				
				Если НЕ СтруктураПараметров.ОтображатьПрогноз Тогда
					// вариант с операцией
					ТекстПодсказки = ТекстПодсказки + "<tr><td style='font-family: verdana; font-size:10px; border-bottom: 1px solid black;'><a href='javascript:void(document.getElementById(\""openoperation\"").value = \"""+Ответ.Операция.Номер+"_"+Год(Ответ.Операция.Дата)+"\"");'>"+Ответ.Операция.ГрузовыеПартии+"</a></td></tr>";
					МаркерОтправки = ОпределитьМаркерПоОперации(Ответ.Операция);
				Иначе
					// вариант с балансом
					Если Ответ.Графа = "Факт" Тогда
						ГрафаФакт = ГрафаФакт + Ответ.Значение;
					ИначеЕсли Ответ.Графа = "ПрогнозПлан" Тогда
						ГрафаПрогнозПлан = ГрафаПрогнозПлан + Ответ.Значение;
					ИначеЕсли Ответ.Графа = "ПрогнозФакт" Тогда
						ГрафаПрогнозФакт = ГрафаПрогнозФакт + Ответ.Значение;
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
			
			Если СтруктураПараметров.ОтображатьПрогноз Тогда
				ТекстПодсказки = ТекстПодсказки + "<tr><td style='font-family: verdana; font-size:10px;'>"+ОтветАналитика.Аналитика+"</td><td style='font-family: verdana; font-size:10px; text-align: center;'>"+ГрафаФакт+"</td><td style='font-family: verdana; font-size:10px; text-align: center;'>"+ГрафаПрогнозПлан+"</td><td style='font-family: verdana; font-size:10px; text-align: center;'>"+ГрафаПрогнозФакт+"</td><td style='font-family: verdana; font-size:10px; text-align: center;'>"+(ГрафаФакт+ГрафаПрогнозПлан+ГрафаПрогнозФакт)+"</td></tr>";
				
				ЕстьСерыеДвижения = ПоТекущемуМестоположениюЕстьПлановыеПрошедшиеДвиженияПрогноза(ОтветМестоположение.Местоположение);
				
				Если (ГрафаФакт+ГрафаПрогнозПлан+ГрафаПрогнозФакт) > 0 Тогда
					МаркерОтправки = ?(ЕстьСерыеДвижения = 0, "plus", "plus_n");
				ИначеЕсли (ГрафаФакт+ГрафаПрогнозПлан+ГрафаПрогнозФакт) < 0 Тогда
					МаркерОтправки = ?(ЕстьСерыеДвижения = 0, "minus", "minus_n");
				Иначе
					МаркерОтправки = ?(ЕстьСерыеДвижения = 0, "ravno", "ravno_n");
				КонецЕсли;
				
				Если ЕстьСерыеДвижения > 0 Тогда
					ТекстПодсказки = ТекстПодсказки + "<tr><td colspan='5' style='font-family: verdana; font-size:10px;'><a style='color: red' href='javascript:void(document.getElementById(\""openmismatch\"").value = \"""+ОтветМестоположение.Местоположение.Код+"\"");'>Имеются недостоверные движения: "+ЕстьСерыеДвижения+"</a></td></tr>";
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ДобавитьМаркер(Результат, ОтветМестоположение.Широта, ОтветМестоположение.Долгота, ТекстПодсказки+"</table>", МаркерОтправки);
		
	КонецЦикла;
	
КонецПроцедуры

// Функция из тарификатора. Позволяет определить, есть ли просроченные операции в указанном местоположении
Функция ПоТекущемуМестоположениюЕстьПлановыеПрошедшиеДвиженияПрогноза(Местоположение) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПозицияВагоновПлан.Регистратор КАК Регистратор
	               |ПОМЕСТИТЬ Т1
	               |ИЗ
	               |	РегистрНакопления.ПозицияВагоновПлан КАК ПозицияВагоновПлан
	               |ГДЕ
	               |	ПозицияВагоновПлан.Период < &ТекДата
	               |	И (ПозицияВагоновПлан.Локация = &Местоположение
	               |			ИЛИ &Местоположение = ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка))
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПозицияКонтейнеровПлан.Регистратор
	               |ИЗ
	               |	РегистрНакопления.ПозицияКонтейнеровПлан КАК ПозицияКонтейнеровПлан
	               |ГДЕ
	               |	ПозицияКонтейнеровПлан.Период < &ТекДата
	               |	И (ПозицияКонтейнеровПлан.Локация = &Местоположение
	               |			ИЛИ &Местоположение = ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка))
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Т1.Регистратор) КАК Регистратор
	               |ИЗ
	               |	Т1 КАК Т1";
	
	//Запрос.Текст = "ВЫБРАТЬ
	//               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПрогнозДвиженияТСТЕ.Регистратор) КАК Регистратор
	//               |ИЗ
	//               |	РегистрНакопления.ПрогнозДвиженияТСТЕ КАК ПрогнозДвиженияТСТЕ
	//               |ГДЕ
	//               |	ПрогнозДвиженияТСТЕ.Период < &ТекДата
	//               |	И (ПрогнозДвиженияТСТЕ.Местоположение = &Местоположение
	//               |			ИЛИ &Местоположение = ЗНАЧЕНИЕ(Справочник.Местоположения.ПустаяСсылка))
	//               |	И ПрогнозДвиженияТСТЕ.Заказ.ФактическаяТРСХПустая";
	Запрос.УстановитьПараметр("Местоположение", Местоположение);
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДата());
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Возврат ?(Ответ.Регистратор = NULL, 0, Ответ.Регистратор);
	КонецЕсли;
	Возврат 0;	
	
КонецФункции

Функция ПолучитьДанныеМаршрутовПоТрекингу(СтруктураПараметров)
	
	МассивЛиний = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Операция.Ссылка КАК Операция,
	               |	Операция.Сделка КАК Сделка
	               |ИЗ
	               |	Документ.Операция КАК Операция
	               |ГДЕ
	               |	Операция.ПланФакт = ЗНАЧЕНИЕ(Перечисление.ПланФактСчет.Факт)
	               |	И ВЫБОР
	               |			КОГДА &ОтображатьТрек
	               |				ТОГДА Операция.Ссылка В
	               |						(ВЫБРАТЬ
	               |							ОперацияГрузы.Ссылка КАК Ссылка
	               |						ИЗ
	               |							Документ.Операция.Грузы КАК ОперацияГрузы
	               |						ГДЕ
	               |							ОперацияГрузы.ТС В (&ТС))
	               |			ИНАЧЕ Операция.Сделка В (&Заказ)
	               |		КОНЕЦ
	               |	И Операция.Услуга.ОперацияОтображаетсяВГеосервисе
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Операция.Дата УБЫВ";
	
	//Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	//               |	СвязиОпераций.Операция,
	//               |	СвязиОпераций.Заказ
	//               |ИЗ
	//               |	РегистрСведений.СвязиОпераций КАК СвязиОпераций
	//               |ГДЕ
	//               |	СвязиОпераций.ПланФакт = ЗНАЧЕНИЕ(Перечисление.ПланФактСчет.Факт)
	//               |	И ВЫБОР
	//               |			КОГДА &ОтображатьТрек
	//               |				ТОГДА СвязиОпераций.Операция В
	//               |						(ВЫБРАТЬ
	//               |							ГрузыВОперациях.Операция
	//               |						ИЗ
	//               |							РегистрНакопления.ГрузыВОперациях КАК ГрузыВОперациях
	//               |						ГДЕ
	//               |							ГрузыВОперациях.ТС В (&ТС))
	//               |			ИНАЧЕ СвязиОпераций.Заказ = &Заказ
	//               |		КОНЕЦ
	//               |
	//               |УПОРЯДОЧИТЬ ПО
	//               |	СвязиОпераций.Операция.Дата УБЫВ";
	Запрос.УстановитьПараметр("Заказ", СтруктураПараметров.Заказ);
	Запрос.УстановитьПараметр("ТС", СтруктураПараметров.ТС);
	Запрос.УстановитьПараметр("ОтображатьТрек", СтруктураПараметров.ОтобразитьТрек);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		ВесьМаршрут = ПолучитьТрекингПоОперации(Ответ.Операция, СтруктураПараметров.ОтобразитьТрек, СтруктураПараметров.ТС);
		Для каждого Стр из ВесьМаршрут Цикл
			МассивЛиний.Добавить(Новый Структура("Отправление, Назначение, Цвет, Пунктиром", Стр.Отправление, Стр.Назначение, "red", Стр.Пунктиром));
		КонецЦикла;
		Если ВесьМаршрут.Количество() = 0 Тогда
			МассивЛиний.Добавить(Новый Структура("Отправление, Назначение, Цвет, Пунктиром", Новый Структура("Долгота, Широта", Ответ.Операция.ПунктОтправления.Долгота, Ответ.Операция.ПунктОтправления.Широта), Новый Структура("Долгота, Широта", Ответ.Операция.ПунктНазначения.Долгота, Ответ.Операция.ПунктНазначения.Широта), "red", Истина));
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивЛиний;
	
КонецФункции

Функция ПолучитьДанныеТрекингаНаДату(СтруктураПараметров)
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТректингТранспортаСрезПоследних.Местоположение КАК Местоположение,
	               |	ТректингТранспортаСрезПоследних.Состав КАК Состав,
	               |	ТректингТранспортаСрезПоследних.Операция КАК Операция,
	               |	ВЫБОР
	               |		КОГДА ТректингТранспортаСрезПоследних.Широта = 0
	               |			ТОГДА ТректингТранспортаСрезПоследних.Местоположение.Широта
	               |		ИНАЧЕ ТректингТранспортаСрезПоследних.Широта
	               |	КОНЕЦ КАК Широта,
	               |	ВЫБОР
	               |		КОГДА ТректингТранспортаСрезПоследних.Долгота = 0
	               |			ТОГДА ТректингТранспортаСрезПоследних.Местоположение.Долгота
	               |		ИНАЧЕ ТректингТранспортаСрезПоследних.Долгота
	               |	КОНЕЦ КАК Долгота,
	               |	ОперацияГрузы.ТЕ КАК ТЕ
	               |ПОМЕСТИТЬ ВТ
	               |ИЗ
	               |	РегистрСведений.ТректингТранспорта.СрезПоследних(&Период, ) КАК ТректингТранспортаСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Операция.Грузы КАК ОперацияГрузы
	               |		ПО ТректингТранспортаСрезПоследних.Операция = ОперацияГрузы.Ссылка
	               |ГДЕ
	               |	(ТректингТранспортаСрезПоследних.Местоположение <> ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка)
	               |			ИЛИ ТректингТранспортаСрезПоследних.Широта <> 0
	               |			ИЛИ ТректингТранспортаСрезПоследних.Долгота <> 0)
	               |	И (ТректингТранспортаСрезПоследних.Операция.Организация = &Организация
	               |			ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	               |	И (ТректингТранспортаСрезПоследних.Местоположение В ИЕРАРХИИ (&Местоположение)
	               |			ИЛИ &Местоположение = ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка))
	               |	И (ОперацияГрузы.Ссылка.Сделка В (&Заказ)
	               |			ИЛИ &ЗаказПустой)
	               |	И ВЫБОР
	               |			КОГДА &ТипТСЗаполнено
	               |				ТОГДА ОперацияГрузы.ТипТС В (&ТипТС)
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &ТипТЕЗаполнено
	               |				ТОГДА ОперацияГрузы.ТипТЕ В (&ТипТЕ)
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &ТСЗаполнено
	               |				ТОГДА ОперацияГрузы.ТС В (&ТС)
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &ТЕЗаполнено
	               |				ТОГДА ОперацияГрузы.ТЕ В (&ТЕ)
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &ВладелецТСЗаполнено
	               |				ТОГДА ОперацияГрузы.ТС.ВладелецТС В (&ВладелецТС)
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ.Местоположение КАК Местоположение,
	               |	ВТ.Состав КАК Состав,
	               |	ВТ.Операция КАК Операция,
	               |	ВТ.Широта КАК Широта,
	               |	ВТ.Долгота КАК Долгота,
	               |	ПризнакСобственностиКонтейнераСрезПоследних.ВладелецКТК КАК ВладелецКТК
	               |ИЗ
	               |	ВТ КАК ВТ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакСобственностиКонтейнера.СрезПоследних(
	               |				&Период,
	               |				Контейнер В
	               |					(ВЫБРАТЬ
	               |						ВТ.ТЕ
	               |					ИЗ
	               |						ВТ КАК ВТ)) КАК ПризнакСобственностиКонтейнераСрезПоследних
	               |		ПО ВТ.ТЕ = ПризнакСобственностиКонтейнераСрезПоследних.Контейнер
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА &ВладелецТЕЗаполнено
	               |				ТОГДА ПризнакСобственностиКонтейнераСрезПоследних.ВладелецКТК В (&ВладелецТЕ)
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |ИТОГИ
	               |	МАКСИМУМ(Широта),
	               |	МАКСИМУМ(Долгота)
	               |ПО
	               |	Местоположение";
	
	//Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	//               |	ТректингТранспортаСрезПоследних.Местоположение КАК Местоположение,
	//               |	ТректингТранспортаСрезПоследних.Состав,
	//               |	ТректингТранспортаСрезПоследних.Операция,
	//               |	ВЫБОР
	//               |		КОГДА ТректингТранспортаСрезПоследних.Широта = 0
	//               |			ТОГДА ТректингТранспортаСрезПоследних.Местоположение.Широта
	//               |		ИНАЧЕ ТректингТранспортаСрезПоследних.Широта
	//               |	КОНЕЦ КАК Широта,
	//               |	ВЫБОР
	//               |		КОГДА ТректингТранспортаСрезПоследних.Долгота = 0
	//               |			ТОГДА ТректингТранспортаСрезПоследних.Местоположение.Долгота
	//               |		ИНАЧЕ ТректингТранспортаСрезПоследних.Долгота
	//               |	КОНЕЦ КАК Долгота
	//               |ИЗ
	//               |	РегистрСведений.ТректингТранспорта.СрезПоследних(&Период, ) КАК ТректингТранспортаСрезПоследних
	//               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ГрузыВОперациях КАК ГрузыВОперациях
	//               |		ПО ТректингТранспортаСрезПоследних.Операция = ГрузыВОперациях.Операция
	//               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязиОпераций КАК СвязиОпераций
	//               |		ПО ТректингТранспортаСрезПоследних.Операция = СвязиОпераций.Операция
	//               |ГДЕ
	//               |	(ТректингТранспортаСрезПоследних.Местоположение <> ЗНАЧЕНИЕ(Справочник.Местоположения.ПустаяСсылка)
	//               |			ИЛИ ТректингТранспортаСрезПоследних.Широта <> 0
	//               |			ИЛИ ТректингТранспортаСрезПоследних.Долгота <> 0)
	//               |	И (ТректингТранспортаСрезПоследних.Операция.Организация = &Организация
	//               |			ИЛИ &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	//               |	И (ТректингТранспортаСрезПоследних.Местоположение В ИЕРАРХИИ (&Местоположение)
	//               |			ИЛИ &Местоположение = ЗНАЧЕНИЕ(Справочник.Местоположения.ПустаяСсылка))
	//               |	И (СвязиОпераций.Заказ = &Заказ
	//               |			ИЛИ &Заказ = ЗНАЧЕНИЕ(Документ.Заказ.ПустаяСсылка))
	//               |	И ВЫБОР
	//               |			КОГДА &ТипТСЗаполнено
	//               |				ТОГДА ГрузыВОперациях.ТипТС В (&ТипТС)
	//               |			ИНАЧЕ ИСТИНА
	//               |		КОНЕЦ
	//               |	И ВЫБОР
	//               |			КОГДА &ТипТЕЗаполнено
	//               |				ТОГДА ГрузыВОперациях.ТипТЕ В (&ТипТЕ)
	//               |			ИНАЧЕ ИСТИНА
	//               |		КОНЕЦ
	//               |	И ВЫБОР
	//               |			КОГДА &ТСЗаполнено
	//               |				ТОГДА ГрузыВОперациях.ТС В (&ТС)
	//               |			ИНАЧЕ ИСТИНА
	//               |		КОНЕЦ
	//               |	И ВЫБОР
	//               |			КОГДА &ТЕЗаполнено
	//               |				ТОГДА ГрузыВОперациях.ТЕ В (&ТЕ)
	//               |			ИНАЧЕ ИСТИНА
	//               |		КОНЕЦ
	//               |	И ВЫБОР
	//               |			КОГДА &ВладелецТСЗаполнено
	//               |				ТОГДА ГрузыВОперациях.ТС.ВладелецТС В (&ВладелецТС)
	//               |			ИНАЧЕ ИСТИНА
	//               |		КОНЕЦ
	//               |	И ВЫБОР
	//               |			КОГДА &ВладелецТЕЗаполнено
	//               |				ТОГДА ГрузыВОперациях.ТЕ.ВладелецТЕ В (&ВладелецТЕ)
	//               |			ИНАЧЕ ИСТИНА
	//               |		КОНЕЦ
	//               |ИТОГИ
	//               |	МАКСИМУМ(Широта),
	//               |	МАКСИМУМ(Долгота)
	//               |ПО
	//               |	Местоположение";
	
	Запрос.УстановитьПараметр("Период", СтруктураПараметров.ОстаткиНаДату);
	Запрос.УстановитьПараметр("Организация", СтруктураПараметров.ОтборОрганизация);
	Запрос.УстановитьПараметр("Местоположение", СтруктураПараметров.ОтборРегион);
	Запрос.УстановитьПараметр("Заказ", СтруктураПараметров.Заказ);
	Запрос.УстановитьПараметр("ЗаказПустой", СтруктураПараметров.Заказ.Количество() = 0);
	Запрос.УстановитьПараметр("ТипТСЗаполнено", СтруктураПараметров.ТипТС.Количество() > 0);
	Запрос.УстановитьПараметр("ТипТС", СтруктураПараметров.ТипТС);
	Запрос.УстановитьПараметр("ТипТЕЗаполнено", СтруктураПараметров.ТипТЕ.Количество() > 0);
	Запрос.УстановитьПараметр("ТипТЕ", СтруктураПараметров.ТипТЕ);
	Запрос.УстановитьПараметр("ТСЗаполнено", СтруктураПараметров.ТС.Количество() > 0);
	Запрос.УстановитьПараметр("ТС", СтруктураПараметров.ТС);
	Запрос.УстановитьПараметр("ТЕЗаполнено", СтруктураПараметров.ТЕ.Количество() > 0);
	Запрос.УстановитьПараметр("ТЕ", СтруктураПараметров.ТЕ);
	Запрос.УстановитьПараметр("ВладелецТСЗаполнено", СтруктураПараметров.ВладелецТС.Количество() > 0);
	Запрос.УстановитьПараметр("ВладелецТС", СтруктураПараметров.ВладелецТС);
	Запрос.УстановитьПараметр("ВладелецТЕЗаполнено", СтруктураПараметров.ВладелецТЕ.Количество() > 0);
	Запрос.УстановитьПараметр("ВладелецТЕ", СтруктураПараметров.ВладелецТЕ);
	ВыборкаМестоположение = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаМестоположение.Следующий() Цикл
		
		ВыборкаДетальныеЗаписи = ВыборкаМестоположение.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если СтруктураПараметров.ОтображатьТС <> 0 Тогда
				ВЭтойОперацииГруженыеТС = ВЭтойОперацииГруженыеТС(ВыборкаДетальныеЗаписи.Операция);
				Если (СтруктураПараметров.ОтображатьТС = 1 И НЕ ВЭтойОперацииГруженыеТС) ИЛИ (СтруктураПараметров.ОтображатьТС = 2 И ВЭтойОперацииГруженыеТС) Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			Если СтруктураПараметров.ОтображатьТЕ <> 0 Тогда
				ВЭтойОперацииГруженыеТЕ = ВЭтойОперацииГруженыеТЕ(ВыборкаДетальныеЗаписи.Операция);
				Если (СтруктураПараметров.ОтображатьТЕ = 1 И НЕ ВЭтойОперацииГруженыеТЕ) ИЛИ (СтруктураПараметров.ОтображатьТЕ = 2 И ВЭтойОперацииГруженыеТЕ) Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Результат.Добавить(Новый Структура("Местоположение, Операция", Новый Структура("Широта, Долгота, Местоположение", ВыборкаДетальныеЗаписи.Широта, ВыборкаДетальныеЗаписи.Долгота, ВыборкаДетальныеЗаписи.Местоположение), ВыборкаДетальныеЗаписи.Операция));
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ВЭтойОперацииГруженыеТС(Операция)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	МАКСИМУМ(ОперацияГрузы.ГруженоеТС) КАК ГруженоеТС
	               |ИЗ
	               |	Документ.Операция.Грузы КАК ОперацияГрузы
	               |ГДЕ
	               |	ОперацияГрузы.Ссылка = &Операция";
	Запрос.УстановитьПараметр("Операция", Операция);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Возврат Ответ.ГруженоеТС;
	КонецЕсли;
	Возврат Ложь;
	
КонецФункции

Функция ВЭтойОперацииГруженыеТЕ(Операция)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	МАКСИМУМ(ОперацияГрузы.ГруженоеТЕ) КАК ГруженоеТЕ
	               |ИЗ
	               |	Документ.Операция.Грузы КАК ОперацияГрузы
	               |ГДЕ
	               |	ОперацияГрузы.Ссылка = &Операция";
	Запрос.УстановитьПараметр("Операция", Операция);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Возврат Ответ.ГруженоеТЕ;
	КонецЕсли;
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьТрекингПоОперации(Операция,  ОтобразитьТрек, ТС)
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТректингТранспорта.Местоположение КАК Местоположение,
	               |	ТректингТранспорта.Операция.ПунктНазначения КАК ПунктНазначения,
	               |	МАКСИМУМ(ТректингТранспорта.Период) КАК Период,
	               |	ВЫБОР
	               |		КОГДА ТректингТранспорта.Широта = 0
	               |			ТОГДА ТректингТранспорта.Местоположение.Широта
	               |		ИНАЧЕ ТректингТранспорта.Широта
	               |	КОНЕЦ КАК Широта,
	               |	ВЫБОР
	               |		КОГДА ТректингТранспорта.Долгота = 0
	               |			ТОГДА ТректингТранспорта.Местоположение.Долгота
	               |		ИНАЧЕ ТректингТранспорта.Долгота
	               |	КОНЕЦ КАК Долгота
	               |ИЗ
	               |	РегистрСведений.ТректингТранспорта КАК ТректингТранспорта
	               |ГДЕ
	               |	(ТректингТранспорта.Местоположение <> ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка)
	               |			ИЛИ ТректингТранспорта.Широта <> 0
	               |			ИЛИ ТректингТранспорта.Долгота <> 0)
	               |	И ТректингТранспорта.Операция = &Операция
	               |	И ВЫБОР
	               |			КОГДА &ТрекТранспорта
	               |				ТОГДА ТректингТранспорта.ТС В (&СписокТС)
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТректингТранспорта.Операция.ПунктНазначения,
	               |	ТректингТранспорта.Местоположение,
	               |	ВЫБОР
	               |		КОГДА ТректингТранспорта.Широта = 0
	               |			ТОГДА ТректингТранспорта.Местоположение.Широта
	               |		ИНАЧЕ ТректингТранспорта.Широта
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА ТректингТранспорта.Долгота = 0
	               |			ТОГДА ТректингТранспорта.Местоположение.Долгота
	               |		ИНАЧЕ ТректингТранспорта.Долгота
	               |	КОНЕЦ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период";
	Запрос.УстановитьПараметр("Операция", Операция);
	Запрос.УстановитьПараметр("ТрекТранспорта", ОтобразитьТрек);
	Запрос.УстановитьПараметр("СписокТС", ТС);
	Ответ = Запрос.Выполнить().Выбрать();
	ПредПунктШирота = неопределено;
	ПредПунктДолгота = неопределено;
	Пока Ответ.Следующий() Цикл
		Если ПредПунктШирота <> неопределено И ПредПунктШирота <> Ответ.Широта И ПредПунктДолгота <> Ответ.Долгота Тогда
			Результат.Добавить(Новый Структура("Отправление, Назначение, Пунктиром", Новый Структура("Широта, Долгота", ПредПунктШирота, ПредПунктДолгота), Новый Структура("Широта, Долгота", Ответ.Широта, Ответ.Долгота), Ложь));
		КонецЕсли;
		ПредПунктШирота = Ответ.Широта;
		ПредПунктДолгота = Ответ.Долгота;
	КонецЦикла;
	
	Если Ответ.Местоположение <> Ответ.ПунктНазначения Тогда
		Результат.Добавить(Новый Структура("Отправление, Назначение, Пунктиром", Новый Структура("Широта, Долгота", ПредПунктШирота, ПредПунктДолгота), Новый Структура("Широта, Долгота", Ответ.ПунктНазначения.Широта, Ответ.ПунктНазначения.Долгота), Истина));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОпределитьМаркерПоОперации(Операция)
	
	ВыбранныйТипТС = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОперацияГрузы.ТипТС КАК ТипТС
	               |ИЗ
	               |	Документ.Операция.Грузы КАК ОперацияГрузы
	               |ГДЕ
	               |	ОперацияГрузы.Ссылка = &Операция";
	Запрос.УстановитьПараметр("Операция", Операция);			   
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		Если ВыбранныйТипТС = неопределено ИЛИ ВыбранныйТипТС = Ответ.ТипТС Тогда
			ВыбранныйТипТС = Ответ.ТипТС;
		Иначе
			ВыбранныйТипТС = "";
		КонецЕсли;
	КонецЦикла;
	
	Если ВыбранныйТипТС <> неопределено И ВыбранныйТипТС <> "" Тогда
		Если ВыбранныйТипТС.Авто Тогда
			Возврат "truck";
		ИначеЕсли ВыбранныйТипТС.Авиа Тогда
			Возврат "airport";
		ИначеЕсли ВыбранныйТипТС.Вагон Тогда
			Возврат "train";
		ИначеЕсли ВыбранныйТипТС.Судно Тогда
			Возврат "boat";
		КонецЕсли;
	КонецЕсли;
	
	Возврат "tp";
	
КонецФункции

Процедура СоздатьЗаголовок(Результат, Знач Широта, Знач Долгота, Зум, КаталогГеосервиса)
	
	Широта = СтрЗаменить(Широта, ",", "."); Долгота = СтрЗаменить(Долгота, ",", ".");
	Результат = "<html>
	|<head>
	|<link rel=""stylesheet"" href="""+ПреобразоватьПуть(КаталогГеосервиса)+"\\leaflet.css"" />
	|</head>
