Функция ПередатьДоговорВБФ(ДоговорКонтрагента) Экспорт

//Евросиб Гудкова( 10.01.2022 Ticket№ О
	//Определение = Новый WSОпределения(Константы["ВебСервисСозданиеКонтрагентовДоговоровБФ"+?(ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована, "Тестовый", "")].Получить());
	//Прокси = Новый WSПрокси(Определение, определение.Сервисы[0].URIПространстваИмен, определение.Сервисы[0].Имя, определение.Сервисы[0].ТочкиПодключения[0].Имя);
	Прокси = ВебСервисы_сервер.ПолучитьПрокси("ВебСервисСозданиеКонтрагентовДоговоровБФ");
// Евросиб Гудкова)
	ТипWSПараметра = Прокси.ФабрикаXDTO.Пакеты.получить("http://www.eurosib.biz/ES_Dictionaries").Получить("ContractTS");
	
	Contract = Прокси.ФабрикаXDTO.Создать(ТипWSПараметра);
	
	Contract.Type = "Договор";
	Contract.Number = ДоговорКонтрагента.Номер;
	Contract.Currency = ДоговорКонтрагента.ВалютаВзаиморасчетов.Код;
	Contract.ViewContract = СтрЗаменить(Строка(ДоговорКонтрагента.ВидДоговора), " ", "");
	Contract.CategoryCode = ДоговорКонтрагента.КатегорияДоговора.Код;
	Contract.DateContract = ДоговорКонтрагента.Дата;
	Contract.EndDate = ДоговорКонтрагента.СрокДействия;
	
	Мт = РегистрыСведений.ПротоколОбменов.СоздатьНаборЗаписей();
	Мт.Отбор.Объект.Установить(ДоговорКонтрагента.Организация);
	Мт.Отбор.УзелОбмена.Установить(Перечисления.УзлыОбмена.БитФинанс);
	Мт.Отбор.ДействиеПриОбмене.Установить(Перечисления.ДействияПриОбмене.ЗагрузкаДанных);
	Мт.Прочитать();
	Если Мт.Количество() > 0 Тогда
		Contract.CustomerSide1 = Мт[0].УИДИсточника;
	КонецЕсли; 
	
	Мт.Отбор.Объект.Установить(ДоговорКонтрагента.Владелец);
	Мт.Отбор.УзелОбмена.Установить(Перечисления.УзлыОбмена.БитФинанс);
	Мт.Отбор.ДействиеПриОбмене.Установить(Перечисления.ДействияПриОбмене.ЗагрузкаДанных);
	Мт.Прочитать();
	Если Мт.Количество() > 0 Тогда
		Contract.CustomerSide2 = Мт[0].УИДИсточника;
	КонецЕсли; 
	Contract.EmployeeCode = ДоговорКонтрагента.ОтветственныйЗаДоговор.ФизическоеЛицо.Код;
	Contract.CFR = "ТС " + ДоговорКонтрагента.ЦФО.Код; 
	Если ДоговорКонтрагента.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда
		Contract.TypeSettlement = "По заказам";
		Contract.Side1 = "Заказчик";
		Contract.Side2 = "Исполнитель";
	Иначе	
		Contract.TypeSettlement = "По договору в целом";
		Contract.Side1 = "Продавец";
		Contract.Side2 = "Покупатель";
	КонецЕсли; 
	Contract.ViewTermsOfPayment = СтрЗаменить(Строка(ДоговорКонтрагента.УсловиеОплаты), " ", "");
	Contract.PrepayPercent = Строка(ДоговорКонтрагента.РазмерАванса);
	
	ContractInfo = Прокси.CreateContractTS(Contract);
	
	Если ЗначениеЗаполнено(ContractInfo.GUIDContract) Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	ПротоколОбменов.Объект КАК Объект,
		               |	ПротоколОбменов.Объект.Наименование КАК ОбъектНаименование
		               |ИЗ
		               |	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
		               |ГДЕ
		               |	ПротоколОбменов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных)
		               |	И ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.БитФинанс)
		               |	И ПротоколОбменов.УИДИсточника = &УИДИсточника
		               |	И ПротоколОбменов.Объект <> &ТекСсылка";
		Запрос.УстановитьПараметр("УИДИсточника", ContractInfo.GUIDContract);
		Запрос.УстановитьПараметр("ТекСсылка", ДоговорКонтрагента);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Договор с такими параметрами уже есть в базе. Данную карточку использовать запрещено. Нужный договор: " + Выборка.ОбъектНаименование;
			Сообщение.КлючДанных = Выборка.Объект;
			ДоговорКонтрагентаОбъект = ДоговорКонтрагента.ПолучитьОбъект();
			ДоговорКонтрагентаОбъект.УстановитьПометкуУдаления(Истина);
			Возврат Сообщение;
		КонецЕсли; 
		
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("ДействиеПриОбмене", Перечисления.ДействияПриОбмене.ЗагрузкаДанных);
		СтруктураПоиска.Вставить("УзелОбмена", Перечисления.УзлыОбмена.БитФинанс);
		СтруктураПоиска.Вставить("Объект", ДоговорКонтрагента);
		
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("ДатаОбмена", ТекущаяДата());
		СтруктураДанных.Вставить("УИДИсточника", ContractInfo.GUIDContract);
		СтруктураДанных.Вставить("Ответственный", Пользователи.ТекущийПользователь());
		Сообщение = РегистрыСведений.ПротоколОбменов.ЗафиксироватьИнформациюОЗагрузке(СтруктураПоиска, СтруктураДанных, ContractInfo.Message); 
		
		ОбъектДоговор = ДоговорКонтрагента.ПолучитьОбъект();
		ОбъектДоговор.Активный = Истина;
		ОбъектДоговор.Записать();
	
	Иначе
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = ContractInfo.Message;
	КонецЕсли;
	Возврат Сообщение;
	
КонецФункции

Функция ПолучитьДанныеКонтрагентаПоНомеруДокумента(XMLParams) Экспорт
	
	СтруктураОтвет = Новый Структура;
	СтруктураОтвет.Вставить("Result",0);
	СтруктураОтвет.Вставить("ResultData", Неопределено);
	СтруктураОтвет.Вставить("ErrorMsg", "");
	СтруктураПараметров = ОбщегоНазначения.ЗначениеИзСтрокиXML(XMLParams);
	Если ТипЗнч(СтруктураПараметров) <> Тип("Структура") Тогда
		СтруктураОтвет.ErrorMsg = "Неверный тип параметров";
		Возврат СтруктураОтвет;
	КонецЕсли;
	
	Если НЕ СтруктураПараметров.Свойство("Date")
		ИЛИ НЕ СтруктураПараметров.Свойство("Number")
		ИЛИ НЕ СтруктураПараметров.Свойство("Organization")
		Тогда
		СтруктураОтвет.ErrorMsg = "Недостаточно параметров";
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ
	|	ПротоколОбменов.Объект КАК Объект
	|ПОМЕСТИТЬ ВремОрганизации
	|ИЗ
	|	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	|ГДЕ
