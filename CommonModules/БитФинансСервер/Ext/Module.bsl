//Евросиб СубботинВ #105749 20.08.2025 Начало
Функция ПолучитьППЗаявокНаОплатуИзБФ(ГуидЗаявки, ЗаявкаСсылка) Экспорт 
	
	Результат = Новый Структура("ЗагрузкаВыполнена, РезультатЗагрузки");
	Прокси = ВебСервисы_сервер.ПолучитьПрокси("ВебСервисОбменСБФ");	
	
	Попытка	
		Ошибка = "Произошел сбой обмена. Повторите запрос через 30 минут или обратитесь в Тех. поддержку";		
	    ТипWSПараметра2 = Прокси.ФабрикаXDTO.Пакеты.получить("http://www.eurosib.biz/ES_Dictionaries").Получить("PaymentOrderReq");
		ПарамGUID =  Прокси.ФабрикаXDTO.Создать(ТипWSПараметра2);
		
		ПарамGUID.Guid = ГуидЗаявки;
		ОтветБФ = Прокси.GetPaymentOrderPDF(ПарамGUID);
		Ошибка = ""; 
		МассивСтатусовДляПроверки = Новый Массив;
		МассивСтатусовДляПроверки.Добавить("Сформирован");
		МассивСтатусовДляПроверки.Добавить("Подписан");
		МассивСтатусовДляПроверки.Добавить("Подготовлен к отправке");
		
		Если ОтветБФ.IsError Тогда
			Результат.ЗагрузкаВыполнена = Ложь;
			Результат.РезультатЗагрузки = ОтветБФ.Message;
			//Результат.ОписаниеОшибки = ОтветБФ.Message;
		Иначе	
			Для Каждого Ордер из ОтветБФ.PaymentOrderPDF Цикл
				ПроверкаСтатуса = МассивСтатусовДляПроверки.Найти(ОтветБФ.Status);
				Если НЕ ПроверкаСтатуса = Неопределено Тогда
					Результат.ЗагрузкаВыполнена = Ложь;
					Результат.РезультатЗагрузки = "Платежное поручение не отправлено в банк. Повторите запрос позже/";					
					Возврат Результат
				КонецЕсли;
				ВременныйФайл = ПолучитьИмяВременногоФайла(".PDF");
				
				ДвоичныйФайл = Base64Значение(Ордер); 
				
				ФайлВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныйФайл); 
				
				ПараметрыФайла = Новый Структура("Автор, ВладелецФайлов, ИмяБезРасширения, РасширениеБезТочки, ВремяИзмененияУниверсальное,
				|АдресВременногоХранилищаФайла, ВремяИзменения"); 

				ПараметрыФайла.Автор = Справочники.Пользователи.Робот;
				ПараметрыФайла.ВладелецФайлов = ЗаявкаСсылка;
				ПараметрыФайла.ИмяБезРасширения = СтрЗаменить(ОтветБФ.Name,":","-");
				ПараметрыФайла.РасширениеБезТочки = "pdf";
				ПараметрыФайла.ВремяИзмененияУниверсальное = ТекущаяУниверсальнаяДата();
				ПараметрыФайла.АдресВременногоХранилищаФайла = ФайлВоВременномХранилище;
				ПараметрыФайла.ВремяИзменения = ТекущаяУниверсальнаяДата();
							
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	Файлы.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.Файлы КАК Файлы
				|ГДЕ
				|	Файлы.ВладелецФайла = &ВладелецФайла
				|	И НЕ Файлы.ПометкаУдаления";
				
				Запрос.УстановитьПараметр("ВладелецФайла", ЗаявкаСсылка);
				
				РезультатЗапроса = Запрос.Выполнить();
				
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				
				Если ВыборкаДетальныеЗаписи.Следующий() Тогда
					ПараметрыФайлаОбновления = РаботаСФайламиКлиентСервер.СведенияОФайле("Файл");
                    ЗаполнитьЗначенияСвойств(ПараметрыФайлаОбновления,ПараметрыФайла);
					
					РаботаСФайламиСлужебный.ОбновитьВерсиюФайла(ВыборкаДетальныеЗаписи.Ссылка, ПараметрыФайлаОбновления);
				Иначе
					РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, ФайлВоВременномХранилище);
				КонецЕсли;	
				
				СтруктураПоиска = Новый Структура("ДействиеПриОбмене, УзелОбмена, Объект", Перечисления.ДействияПриОбмене.ЗагрузкаДанных, 
				Перечисления.УзлыОбмена.БитФинанс, ЗаявкаСсылка);
				СтруктураДанных = Новый Структура("УИДИсточника", ГуидЗаявки);					
				
				РегистрыСведений.ПротоколОбменов.ЗафиксироватьИнформациюОЗагрузке(СтруктураПоиска, СтруктураДанных);
				Если Не ОтветБФ.Status = "Подтвержден выпиской" Тогда 
					  ВыпискаПодтверждена = Истина;
				  Иначе
					  ВыпискаПодтверждена = Ложь;
				КонецЕсли;
				РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ЗаписатьАналитикуДокумента(ЗаявкаСсылка,
										ПланыВидовХарактеристик.ДополнительныеАналитикиДокументов.СтатусППНеПодтвержден, ВыпискаПодтверждена); 
				
			КонецЦикла;				
			Результат.ЗагрузкаВыполнена = Истина;
			Результат.РезультатЗагрузки = "Загрузка завершена";
		КонецЕсли;		
		
	Исключение		
		Результат.ЗагрузкаВыполнена = Ложь;
		Если Ошибка = "" Тогда
			Ошибка = ОписаниеОшибки();
		КонецЕсли;	
		Результат.РезультатЗагрузки = Ошибка;
		Если Справочники.СобытияОтправкиДокументов.ОшибкаЗагрузкиППБитФинанс.ОтправкаПисемПоСобытию Тогда
			РассылкаУведомленийПользователям.СформироватьЗаписиСобытийИзменений(ЗаявкаСсылка,
																				Справочники.СобытияОтправкиДокументов.ОшибкаЗагрузкиППБитФинанс,
																				ЗаявкаСсылка.Дата);
		КонецЕсли;		
	КонецПопытки;
	
	РегистрыСведений.ИсторияОбменов.ЗафиксироватьИнформациюОбИсторииОбмена(ЗаявкаСсылка, Перечисления.УзлыОбмена.БитФинанс,
																		   НЕ Результат.ЗагрузкаВыполнена, Результат.РезультатЗагрузки);
	Возврат Результат;
		
КонецФункции 

