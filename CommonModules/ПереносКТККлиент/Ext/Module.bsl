
#Область ПеренесеноИзМодуля_УдалениеКТКИзСделки_Клиент
Процедура ИсключитьКТКИзСделкиV2_Сделка_Нажатие(ЭтаФорма) Экспорт
	
	Для каждого Стр из ЭтаФорма.Объект.СвязьУчетныхЕдиниц Цикл
		Стр.БезЖДН = Ложь;
	КонецЦикла;
	
	Элемент_КнопкаОК = ЭтаФорма.Элементы.СвязьУчетныхЕдиницИсключениеКТКИзСделкиОК;
	Элемент_КнопкаИсключить = ЭтаФорма.Элементы.СвязьУчетныхЕдиницИсключениеКТКИзСделки;
	
	Если Элемент_КнопкаОК.Видимость = Истина Тогда
		
		ЭтаФорма.Элементы.СвязьУчетныхЕдиницБезЖДН.Видимость = Ложь;
		Элемент_КнопкаОК.Видимость = Ложь;
		Элемент_КнопкаИсключить.Заголовок = "Исключить КТК из сделки";
		
		ЭтаФорма.Элементы.СвязьУчетныхЕдиницИсключениеКТКУстановитьВсе.Видимость = Ложь;
		ЭтаФорма.Элементы.СвязьУчетныхЕдиницИсключениеКТКСнятьВсе.Видимость = Ложь;
		
	Иначе
		
		ЭтаФорма.Элементы.СвязьУчетныхЕдиницБезЖДН.Видимость = Истина;
		Элемент_КнопкаОК.Видимость = Истина;
		Элемент_КнопкаИсключить.Заголовок = "Исключить КТК из сделки (отмена)";
		
		ЭтаФорма.Элементы.СвязьУчетныхЕдиницИсключениеКТКУстановитьВсе.Видимость = Истина;
		ЭтаФорма.Элементы.СвязьУчетныхЕдиницИсключениеКТКСнятьВсе.Видимость = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ИсключитьКТКИзСделкиV2_ОК_Сделка_Нажатие(ЭтаФорма) Экспорт
	
	Договор = неопределено;
	МассивУникальныхЗаявок = Новый Массив;
	
	// Евросиб Фролов (15.04.2022 Task №48577
	Для Каждого Стр из ЭтаФорма.Объект.СвязьУчетныхЕдиниц Цикл
		Если Стр.БезЖДН = Истина И Стр.ГотовоКВыставлению Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Ошибка: для КТК %1 в строке %2 установлен признак ""Готово к выставлению"". Нельзя переносить КТК, которые отмечены как готовые к выставлению", Стр.Контейнер, Стр.НомерСтроки));
			Стр.БезЖДН = Ложь;
		КонецЕсли;	
	КонецЦикла;
	// Евросиб Фролов)
	
	Для каждого Стр из ЭтаФорма.Объект.СвязьУчетныхЕдиниц Цикл
		//ДИТ, Беляев СЮ, US 66796 / TA 72732, 20-07-2023, начало
		Если Стр.БезЖДН = Истина Тогда
		//ДИТ, Беляев СЮ, US 66796 / TA 72732, 20-07-2023, конец
			//ДИТ, Беляев СЮ, BUG 57430/TA 57684, 28-09-2022, начало (реквизит СформированыЗакрывающиеДокументы учитывает корректировки в Доходах)
			Если Стр.СформированыЗакрывающиеДокументы Тогда
			//ДИТ, Беляев СЮ, BUG 57430/TA 57684, 28-09-2022, начало
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Ошибка: для исключения КТК %1 по строке %2 требуется скорректировать сформированный учетный документ", Стр.Контейнер, Стр.НомерСтроки));
				Стр.БезЖДН = Ложь;
				Продолжить;
			КонецЕсли; 
			Если НЕ ЗначениеЗаполнено(Стр.Заявка) Тогда
				//ДИТ, Беляев СЮ, US 66796 / TA 72732, 20-07-2023, начало
				Стр.БезЖДН = Ложь;
				//ДИТ, Беляев СЮ, US 66796 / TA 72732, 20-07-2023, конец
				Сообщить("Ошибка: в строке " + Стр.НомерСтроки + " по КТК " + Стр.Контейнер + " отсутствует заявка!");
				Продолжить;
			КонецЕсли;
			//ДИТ, Беляев СЮ, US 66796 / TA 72732, 20-07-2023, начало
			Если МассивУникальныхЗаявок.Найти(Стр.Заявка) = неопределено Тогда
				МассивУникальныхЗаявок.Добавить(Стр.Заявка);
			КонецЕсли;
			//ДИТ, Беляев СЮ, US 66796 / TA 72732, 20-07-2023, конец
			Договор = Стр.Договор;
		КонецЕсли;
	КонецЦикла;
	//ДИТ, Беляев СЮ, US 66796 / TA 72732, 20-07-2023, начало
	Если МассивУникальныхЗаявок.Количество() > 1 Тогда
		ПоказатьПредупреждение(, "Разрешено выбирать КТК только из одной заявки!");
		Возврат;
	КонецЕсли;
	//ДИТ, Беляев СЮ, US 66796 / TA 72732, 20-07-2023, конец
	
	//ДИТ, Беляев СЮ, US 66796 / TA 72732, 20-07-2023, начало
	МассивСтрокИсключаемыхКТК = ЭтаФорма.Объект.СвязьУчетныхЕдиниц.НайтиСтроки(Новый Структура("БезЖДН", Истина));
	Если МассивУникальныхЗаявок.Количество() = 0 
		ИЛИ МассивСтрокИсключаемыхКТК.Количество() = 0 Тогда
			ПоказатьПредупреждение(, "Не выбраны строки для исключения КТК из заявок!");
	   	Возврат;
	КонецЕсли;
	
	//Евросиб Каблов 16.04.2024 ( #68187
	КлючиАналитикиПеревозки = Новый Массив;
	Для Каждого Стр Из МассивСтрокИсключаемыхКТК Цикл
		Если ЗначениеЗаполнено(Стр.Заявка) И ЗначениеЗаполнено(Стр.ГУИДСтрокиЗаявки) Тогда
			КлючиАналитикиПеревозки.Добавить(Новый Структура("Заявка, ГУИДСтрокиЗаявки", Стр.Заявка, Стр.ГУИДСтрокиЗаявки));
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(КлючиАналитикиПеревозки) Тогда
		
		//Евросиб Коханенко Н.А. 20.05.2024 (( #83866 
		//НомераКонтейнеровСНезакрытымСНП = УдалениеКТКИзСделки_Сервер.ПолучитьНомераКонтейнеровСНезакрытымСНП(КлючиАналитикиПеревозки);
		НомераКонтейнеровСНезакрытымСНП = ПереносКТКСервер.ПолучитьНомераКонтейнеровСНезакрытымСНП(КлючиАналитикиПеревозки);
		//Евросиб Коханенко Н.А. 20.05.2024 )) #83866 
		
		Если ЗначениеЗаполнено(НомераКонтейнеровСНезакрытымСНП) Тогда
			ШаблонСообщения = "По КТК № %1 не закрыто СНП. Заполните дату окончания пользования КТК в АРМ СНП.";
			ТекстНомераКонтейнеров = СтрСоединить(НомераКонтейнеровСНезакрытымСНП, ", ");
			ТекстСообщения = СтрШаблон(ШаблонСообщения, ТекстНомераКонтейнеров);
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			ПоказатьПредупреждение(, ТекстСообщения);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	//Евросиб Каблов 16.04.2024 )
																													
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("МассивСтрокИсключаемыхКТК", МассивСтрокИсключаемыхКТК);
	ДополнительныеПараметры.Вставить("ЭтаФорма", ЭтаФорма);
	ДополнительныеПараметры.Вставить("Договор", Договор);
	ДополнительныеПараметры.Вставить("МассивУникальныхЗаявок", МассивУникальныхЗаявок);
	ОпОп = Новый ОписаниеОповещения("ПодтверждениеИсключенияКТКИзСделки", ПереносКТККлиент, ДополнительныеПараметры);
	ПоказатьВопрос(ОпОп, "Выбранные контейнеры будут исключены из сделки. Сделка будет автоматически записана. Продолжить?", РежимДиалогаВопрос.ДаНет);
	//ДИТ, Беляев СЮ, US 66796 / TA 72732, 20-07-2023, конец
	
КонецПроцедуры  

Процедура ПодтверждениеИсключенияКТКИзСделки(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 <> КодВозвратаДиалога.Да тогда
		Возврат;
	КонецЕсли;

	МассивДляСпискаКТК = Новый Массив;
	Для каждого СтрокаИсключаемыхКТК Из П2.МассивСтрокИсключаемыхКТК Цикл 
		//Евросиб Коханенко Н.А. 02.07.2024 (( #83866
		//МассивДляСпискаКТК.Добавить(СтрокаИсключаемыхКТК.Контейнер);
		МассивДляСпискаКТК.Добавить("" + ?(ЗначениеЗаполнено(СтрокаИсключаемыхКТК.Контейнер), СтрокаИсключаемыхКТК.Контейнер, "б/н"));
		//Евросиб Коханенко Н.А. 02.07.2024 )) #83866
	КонецЦикла;
	
	//Евросиб Коханенко Н.А. 02.07.2024 (( #83866
	//СписокКТК = СтрСоединить(МассивДляСпискаКТК, "; ");
	//ТекстВопроса = СтрШаблон("Указанные КТК будут удалены из сделки (%1). Выберите способ удаления:",СписокКТК);
	СписокКТК = СтрСоединить(МассивДляСпискаКТК, ", ");
	ТекстВопроса = СтрШаблон("Указанные КТК будут удалены из сделки (%1)." + Символы.ПС + "Выберите способ удаления:", СписокКТК);
	//Евросиб Коханенко Н.А. 02.07.2024 )) #83866

	//ДИТ, Беляев СЮ, US 66796 / TA 72732, 20-07-2023, начало
	ОпОп = Новый ОписаниеОповещения("РешениеОМетодеИсключенияКТКИзСделки_Сделка_ФормаИсключенияКТКИзСделки_Нажатие", ПереносКТККлиент, П2);
	//ДИТ, Беляев СЮ, US 66796 / TA 72732, 20-07-2023, конец
	
	//ДИТ, Беляев СЮ, US 66796 / TA 72732, 20-07-2023, начало
	//Евросиб Коханенко Н.А. 20.05.2024 (( #83866 
	//ОткрытьФорму("Документ.Сделка.Форма.ФормаИсключенияКТКИзСделки", Новый Структура("ТекстВопроса, ЭтаФормаЪ, Договор", ТекстВопроса, П2.ЭтаФорма.УникальныйИдентификатор, П2.Договор),П2.ЭтаФорма,П2.ЭтаФорма.УникальныйИдентификатор,,, ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ОткрытьФорму("ОбщаяФорма.ФормаПереносаКТК", 
				Новый Структура("ТекстВопроса, ЭтаФорма, Договор, РежимПереносаКТК", ТекстВопроса, П2.ЭтаФорма.УникальныйИдентификатор, П2.Договор, 0),
				П2.ЭтаФорма, П2.ЭтаФорма.УникальныйИдентификатор,,, ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	//Евросиб Коханенко Н.А. 20.05.2024 )) #83866 
	//ДИТ, Беляев СЮ, US 66796 / TA 72732, 20-07-2023, конец
	
КонецПроцедуры

Процедура РешениеОМетодеИсключенияКТКИзСделки_Сделка_ФормаИсключенияКТКИзСделки_Нажатие(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = неопределено ИЛИ П1.ВыбраннаяЗаявка = Ложь Тогда 
		Возврат;
	//Евросиб Коханенко Н.А. 20.05.2024 (( #83866
	ИначеЕсли ТипЗнч(П2.ЭтаФорма.Объект.Ссылка)=Тип("ДокументСсылка.Заявка") Тогда 
		Оповестить("ОповещениеОПереносеКТКвДругуюЗаявку", П1.ВыбраннаяЗаявка, П1.ЭтаФормаЪ);
	//Евросиб Коханенко Н.А. 20.05.2024 )) #83866 
	Иначе
		//ДИТ, Беляев СЮ, US 66796 / TA 72732, 20-07-2023, начало
		СтруктураДанныеПоЗапрещеннымДляПересчета = ПереносКТКСервер.ПолучитьДанныеПоЗапрещеннымДляПереноса(П2.ЭтаФорма.Объект, П2.МассивУникальныхЗаявок);
		МассивДобавленоИзАкцепта = СтруктураДанныеПоЗапрещеннымДляПересчета.МассивДобавленоИзАкцепта;
		МассивОбъединениеПорожнейИГруженойСделок = СтруктураДанныеПоЗапрещеннымДляПересчета.МассивОбъединениеПорожнейИГруженойСделок;
		Если МассивДобавленоИзАкцепта.Количество()>0 ИЛИ МассивОбъединениеПорожнейИГруженойСделок.Количество()>0 Тогда
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("МассивОбъединениеПорожнейИГруженойСделок",МассивОбъединениеПорожнейИГруженойСделок);
			ДополнительныеПараметры.Вставить("МассивДобавленоИзАкцепта",МассивДобавленоИзАкцепта);
			ДополнительныеПараметры.Вставить("МассивСтрокИсключаемыхКТК",П2.МассивСтрокИсключаемыхКТК);
			ДополнительныеПараметры.Вставить("ЭтаФорма",П2.ЭтаФорма);
			ДополнительныеПараметры.Вставить("Договор",П2.Договор);
			ДополнительныеПараметры.Вставить("ВыбраннаяЗаявка",П1.ВыбраннаяЗаявка);
			ОписаниеОповещения = Новый ОписаниеОповещения("ПодтверждениеОтвязкиОбъединенныхСделокИОтключенияРасходовДляИсключенияКТК", ПереносКТККлиент, ДополнительныеПараметры);
			ТекстВопроса = "Будут разъединены порожние/груженые сделки, продолжить?";
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Иначе	
			Оповестить("ОповещениеОбИсключенииКТКИзСделки", П1.ВыбраннаяЗаявка, П1.ЭтаФормаЪ);
		КонецЕсли;
		//ДИТ, Беляев СЮ, US 66796 / TA 72732, 20-07-2023, конец
	КонецЕсли;
	
КонецПроцедуры

//ДИТ, Беляев СЮ, US 66796 / TA 72732, 20-07-2023, начало
Процедура ПодтверждениеОтвязкиОбъединенныхСделокИОтключенияРасходовДляИсключенияКТК(П1 = неопределено, П2 = неопределено) Экспорт
	Если П1 <> КодВозвратаДиалога.Да тогда Возврат; КонецЕсли;
	
	ДополнительныеПараметры = П2;
	ЭтаФорма = ДополнительныеПараметры.ЭтаФорма;
	
	//ОТВЯЗКА РАСХОДОВ ИЗ АКЦЕПТОВ И РАЗЪЕДИНЕНИЕ СДЕЛОК
	ДополнительныеПараметрыДляОбработки = Новый Структура;
	ДополнительныеПараметрыДляОбработки.Вставить("МассивДобавленоИзАкцепта", ДополнительныеПараметры.МассивДобавленоИзАкцепта);
	ДополнительныеПараметрыДляОбработки.Вставить("МассивОбъединениеПорожнейИГруженойСделок", Новый Массив);
	//для случая переноса КТК в другую Сделку разъединять Сделки не нужно, расходы будут перенесены в другую сделку
	Если НЕ ТипЗнч(ДополнительныеПараметры.ВыбраннаяЗаявка) = Тип("ДокументСсылка.Сделка") Тогда
		ДополнительныеПараметрыДляОбработки.Вставить("МассивОбъединениеПорожнейИГруженойСделок", ДополнительныеПараметры.МассивОбъединениеПорожнейИГруженойСделок);
	КонецЕсли;
	
	//Евросиб Коханенко Н.А. 20.05.2024 (( #83866 
	//СтруктураРезультата = УдалениеКТКИзСделки_Сервер.ВыполнитьОтключениеРасходовИзАкцептаИВыполнитьРазъединение(ЭтаФорма.Объект, ДополнительныеПараметрыДляОбработки);
	СтруктураРезультата = ПереносКТКСервер.ВыполнитьОтключениеРасходовИзАкцептаИВыполнитьРазъединение(ЭтаФорма.Объект, ДополнительныеПараметрыДляОбработки);
	//Евросиб Коханенко Н.А. 20.05.2024 )) #83866 
	
	ТребуетсяПеречитатьФормуСделки = Ложь;
	
	ОчиститьСообщения();
	//Если СтруктураРезультата.ЕстьРезультатОтключенияРасходов <> Неопределено Тогда
	//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтруктураРезультата.РезультатОтключения);
	//	ТребуетсяПеречитатьФормуСделки = Истина;
	//КонецЕсли;
	
	Если СтруктураРезультата.ЕстьРезультатРазъединенияСделок <> Неопределено Тогда
		Если СтруктураРезультата.ЕстьРезультатРазъединенияСделок Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Операция разъединения выполнена. Список разъединенных сделок:");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтруктураРезультата.СписокСделок); 
			ТребуетсяПеречитатьФормуСделки = Истина;
		ИначеЕсли НЕ СтруктураРезультата.ЕстьРезультатРазъединенияСделок Тогда
			ПоказатьПредупреждение(,"Не удалось выполнить разъединение: "+СтруктураРезультата.РезультатРазъединения);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ТребуетсяПеречитатьФормуСделки Тогда
		Оповестить("ПеречитатьФормуСделки", Истина, ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли;
	
	Оповестить("ОповещениеОбИсключенииКТКИзСделки", ДополнительныеПараметры.ВыбраннаяЗаявка, ЭтаФорма.УникальныйИдентификатор);
	
КонецПроцедуры
//ДИТ, Беляев СЮ, US 66796 / TA 72732, 20-07-2023, конец

Процедура ОбработкаОповещенияОбИсключенииКТКИзСделки_Сделка_ФормаОбъекта_Оповещение(ЭтаФорма, ПараметрОповещения) Экспорт
	
	ПредыдущаяЗаявка = неопределено;
	МассивОтрабатываемыхКТК = Новый Массив;
	Для каждого Стр из ЭтаФорма.Объект.СвязьУчетныхЕдиниц Цикл
		Если Стр.БезЖДН = Истина Тогда
			ПредыдущаяЗаявка = Стр.Заявка;
			МассивОтрабатываемыхКТК.Добавить(Стр.Контейнер);
