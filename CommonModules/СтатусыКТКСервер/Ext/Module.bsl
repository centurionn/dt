		//
		//Пока Выборка.Следующий() Цикл
		//	//Если Заявка проведена и контейнер клиентский - "Взят на баланс"  
		//	Если Выборка.Проведен и Выборка.ВидСобственности = Перечисления.ВариантыСобственности.Клиентский 
		//		и ЗначениеЗаполнено(Выборка.ДатаВзятия) Тогда
		//		НССтатуса = ТаблицаИзмененияСтатусовКлиент.Добавить(); 
		//		ЗаполнитьЗначенияСвойств(НССтатуса, Выборка);
		//		НССтатуса.Статус = Справочники.СтатусыКТК.ВзятНаБаланс;
