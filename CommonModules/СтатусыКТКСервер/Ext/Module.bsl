		//|	КлючиАналитикиПеревозки.ДатаНачалаПеревозки КАК ДатаНачалаПеревозки,
		//|	КлючиАналитикиПеревозки.ДатаОкончанияПеревозки КАК ДатаОкончанияПеревозки,
		//|	стоки_ТекущиеДанныеСрезПоследних.тек_ВидСобственности КАК ВидСобственности,
		//|	стоки_ТекущиеДанныеСрезПоследних.тек_ВЭксплуатации КАК ВЭксплуатации,
		//|	стоки_ТекущиеДанныеСрезПоследних.тек_ДатаСдачиВСток КАК ДатаВозвратаСобственнику,
		//|	стоки_ТекущиеДанныеСрезПоследних.тек_ДатаВзятияИзСтока КАК ДатаВзятия
		//|ИЗ
		//|	ВТ_КонтейнерыЗаявки КАК ВТ_КонтейнерыЗаявки
