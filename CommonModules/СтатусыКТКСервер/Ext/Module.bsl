	ТаблицаИзмененияСтатусов.Колонки.Добавить("Статус", Новый ОписаниеТипов("СправочникСсылка.СтатусыКТК")); 
		
	#Область Источник_Заявка
	Если ТипЗнч(ИсточникЗаписи) = Тип("ДокументСсылка.Заявка") Тогда    
		
