/// СИ ДАТА - Фоновое задание отработки ГУ-12

Процедура АвтоматическаяОтработкаГУ12() Экспорт
	
	//// все истекшие по тайм-ауту ГУ-12 переводим в "автоматически отклонено"
	ТаймАутВЧасахАвтоматическогоОтклоненияГУ12 = Константы.ТаймАутВЧасахАвтоматическогоОтклоненияГУ12.Получить();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	э_ЗаявкаНаПеревозку.Ссылка КАК Ссылка,
	               |	э_ЗаявкаНаПеревозку.СтатусСогласования КАК СтатусСогласования
	               |ПОМЕСТИТЬ Т1
	               |ИЗ
	               |	Документ.э_ЗаявкаНаПеревозку КАК э_ЗаявкаНаПеревозку
	               |ГДЕ
	               |	НЕ э_ЗаявкаНаПеревозку.ПометкаУдаления
	               |	И э_ЗаявкаНаПеревозку.СогласованиеДатаПолучения <= &ТекущаяДатаМинусТаймАут
	               |	И э_ЗаявкаНаПеревозку.СогласованиеДатаПолучения <> ДАТАВРЕМЯ(1, 1, 1)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Т1.Ссылка КАК Ссылка
	               |ИЗ
	               |	Т1 КАК Т1
	               |ГДЕ
	               |	Т1.СтатусСогласования = &ОжидаетсяРешение";
	Запрос.УстановитьПараметр("ТекущаяДатаМинусТаймАут", ТекущаяДата() - ТаймАутВЧасахАвтоматическогоОтклоненияГУ12 * 3600);
	Запрос.УстановитьПараметр("ОжидаетсяРешение", Перечисления.СтатусСогласованияГУ12.ОжидаетРешения);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		ЗаявкаОбъект = Ответ.Ссылка.ПолучитьОбъект();
		ЗаявкаОбъект.СтатусСогласования = Перечисления.СтатусСогласованияГУ12.АвтоматическиОтклонено;
		ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Запись);
		Попытка
			ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ОО = ОписаниеОшибки();
		КонецПопытки
	КонецЦикла;
	
	//// все не переданные ГУ-12 во внешнюю систему передаем и отмечаем факт их передачи
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	э_ЗаявкаНаПеревозку.Ссылка КАК Ссылка,
	               |	э_ЗаявкаНаПеревозку.СтатусСогласования КАК СтатусСогласования
	               |ИЗ
	               |	Документ.э_ЗаявкаНаПеревозку КАК э_ЗаявкаНаПеревозку
	               |ГДЕ
	               |	э_ЗаявкаНаПеревозку.СогласованиеРезультатПередан = ДАТАВРЕМЯ(1, 1, 1)
	               |	И (э_ЗаявкаНаПеревозку.СтатусСогласования = ЗНАЧЕНИЕ(Перечисление.СтатусСогласованияГУ12.АвтоматическиОтклонено)
	               |			ИЛИ э_ЗаявкаНаПеревозку.СтатусСогласования = ЗНАЧЕНИЕ(Перечисление.СтатусСогласованияГУ12.ОтклоненоВручную)
	               |			ИЛИ э_ЗаявкаНаПеревозку.СтатусСогласования = ЗНАЧЕНИЕ(Перечисление.СтатусСогласованияГУ12.ПодтвержденоВручную))
	               |	И НЕ э_ЗаявкаНаПеревозку.ПометкаУдаления";
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		ЗаявкаОбъект = Ответ.Ссылка.ПолучитьОбъект();
		ЗаявкаОбъект.dc_ОшибкаЭтран = ПередатьРезультатГУ12(Ответ.Ссылка, (Ответ.СтатусСогласования = Перечисления.СтатусСогласованияГУ12.ПодтвержденоВручную));
		ЗаявкаОбъект.СогласованиеРезультатПередан = ТекущаяДата();
		ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Запись);
		Попытка
			ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ОО = ОписаниеОшибки();
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Функция ПередатьРезультатГУ12(Заявка, ПодтвержденаДАНЕТ) Экспорт
	
	Результат = Ложь;
	
	Если ПодтвержденаДАНЕТ = Истина Тогда
		
		ТекстЗапроса = "<claimAssentViza version=""1.0""><claimID value="""+Заявка.ИДЗаявки+""" /><frontEndId value="""+Заявка.ИДЗаявки+""" /></claimAssentViza>";
		
	Иначе
		
		ТекстЗапроса = "<claimRejectViza version=""1.0""><claimID value="""+Заявка.ИДЗаявки+""" /><frontEndId value="""+Заявка.ИДЗаявки+""" /></claimRejectViza>";
		
	КонецЕсли;
	
	/////////////////////////////////////////
	РезультатЗапроса = э_ОбщиеСервер.ПолучитьОтветНаЗапрос(ТекстЗапроса);
	
	//Рез = ЗаполнитьДокументЗаявкаНаПеревозку(РезультатЗапроса,Истина,Заявка.ИДЗаявки,ТекущаяДата(),ТекущаяДата(),ТекущаяДата(),Неопределено);
	
	МенеджерЗаписи 				   = РегистрыСведений.э_ЛогиЭТРАН.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период		   = ТекущаяДата();
	МенеджерЗаписи.ТипЗапроса 	   = "Согласование ГУ12";
	МенеджерЗаписи.НомерТранзакции = 1;
	МенеджерЗаписи.Документы	   = Заявка;
	МенеджерЗаписи.Запрос 		   = ТекстЗапроса;
	Сжатие = Новый СжатиеДанных(9);
	МенеджерЗаписи.ОтветСжатый = Новый ХранилищеЗначения(РезультатЗапроса, Сжатие);
	
	Результат = Истина;
	Если Найти(РезультатЗапроса,"error") > 0 Тогда
		МенеджерЗаписи.Ошибка = Истина;
		Результат = Ложь;
	КонецЕсли;
	
	МенеджерЗаписи.Записать();
	/////////////////////////////////////////
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТарифИзЖДН(НомерНакладной, НомерВагона, НомерКТК) Экспорт
	
	Результат = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	э_Накладная.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ Т1
	               |ИЗ
	               |	Документ.э_Накладная КАК э_Накладная
	               |ГДЕ
	               |	э_Накладная.НакладнаяНомер = &НакладнаяНомер
	               |	И НЕ э_Накладная.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	э_Накладная.Дата УБЫВ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	э_НакладнаяПровозныеПлатежиИСборыПоОтправлению.СуммаВРублях КАК СуммаВРублях
	               |ИЗ
	               |	Документ.э_Накладная.ПровозныеПлатежиИСборыПоОтправлению КАК э_НакладнаяПровозныеПлатежиИСборыПоОтправлению
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Т1 КАК Т1
	               |		ПО э_НакладнаяПровозныеПлатежиИСборыПоОтправлению.Ссылка = Т1.Ссылка
	               |ГДЕ
	               |	(э_НакладнаяПровозныеПлатежиИСборыПоОтправлению.НомерВагона = &НомерВагона
	               |			ИЛИ э_НакладнаяПровозныеПлатежиИСборыПоОтправлению.НомерКонтейнера = &НомерКонтейнера)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	э_НакладнаяПровозныеПлатежиИСборыПоПрибытию.СуммаВРублях
	               |ИЗ
	               |	Документ.э_Накладная.ПровозныеПлатежиИСборыПоПрибытию КАК э_НакладнаяПровозныеПлатежиИСборыПоПрибытию
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Т1 КАК Т1
	               |		ПО э_НакладнаяПровозныеПлатежиИСборыПоПрибытию.Ссылка = Т1.Ссылка
	               |ГДЕ
	               |	(э_НакладнаяПровозныеПлатежиИСборыПоПрибытию.НомерВагона = &НомерВагона
	               |			ИЛИ э_НакладнаяПровозныеПлатежиИСборыПоПрибытию.НомерКонтейнера = &НомерКонтейнера)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	э_НакладнаяПровозныеПлатежиИСборыПоПрибытию.СуммаВРублях
	               |ИЗ
	               |	Документ.э_Накладная.ПровозныеПлатежиИСборыПоПрибытию КАК э_НакладнаяПровозныеПлатежиИСборыПоПрибытию
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Т1 КАК Т1
	               |		ПО э_НакладнаяПровозныеПлатежиИСборыПоПрибытию.Ссылка = Т1.Ссылка
	               |ГДЕ
	               |	(э_НакладнаяПровозныеПлатежиИСборыПоПрибытию.НомерВагона = &НомерВагона
	               |			ИЛИ э_НакладнаяПровозныеПлатежиИСборыПоПрибытию.НомерКонтейнера = &НомерКонтейнера)";
	Запрос.УстановитьПараметр("НакладнаяНомер", НомерНакладной);
	Запрос.УстановитьПараметр("НомерВагона", НомерВагона.Наименование);
	Запрос.УстановитьПараметр("НомерКонтейнера", НомерКТК.Наименование);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		
		Результат = Ответ.СуммаВРублях;
		
	Иначе
		Сообщить("!!! Тариф в накладной " + НомерНакладной + " + " + НомерВагона + " + " + НомерКТК + " равен нулю. Укажите сумму плановых расходов в ТЧ Расходы вручную.");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

