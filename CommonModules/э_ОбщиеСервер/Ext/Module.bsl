// Функция преобразовывает данные XML в таблицу
// Имена колонок в таблице задаются в соответтствии с макетом КонвертацияРеквизитов
Функция XMLВТаблицу(СтрокаXML,КонвертацияРеквизитов) 
	
	НезагруженныеРеквизиты = Новый массив;
	
	Конвертация = Новый Соответствие;
	Таблица = Новый ТаблицаЗначений;
	СсылочныеОбъекты = Новый ТаблицаЗначений;
	СсылочныеОбъекты.Колонки.Добавить("РеквизитСсылка");
	СсылочныеОбъекты.Колонки.Добавить("ОбъектПоиска");
	СсылочныеОбъекты.Колонки.Добавить("РеквизитПоиска");
	
	Если СтрокаXML = Неопределено
		ИЛИ СтрокаXML = "" Тогда
		Возврат Таблица;
	КонецЕсли;

	// Создание колонок в Таблице
	Область = КонвертацияРеквизитов.НайтиТекст("<Реквизиты>",,КонвертацияРеквизитов.Область("C1"),,Истина);
	Если Область = Неопределено Тогда 
		Возврат Таблица;
	КонецЕсли;
	Индекс = Область.Верх + 1;	
	
	Пока КонвертацияРеквизитов.Область(Индекс,1).Текст <> "<\Реквизиты>" Цикл
		Если ПустаяСтрока(КонвертацияРеквизитов.Область(Индекс,2).Текст) Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		НовоеИмя = КонвертацияРеквизитов.Область(Индекс,2).Текст;
		//СтароеИмя = Неопределено;
		Если Не ПустаяСтрока(КонвертацияРеквизитов.Область(Индекс,1).Текст) Тогда
			СтароеИмя = КонвертацияРеквизитов.Область(Индекс,1).Текст;
			Конвертация.Вставить(СтароеИмя,НовоеИмя);
		КонецЕсли;
		Таблица.Колонки.Добавить(НовоеИмя);
		ОбъектПоиска = КонвертацияРеквизитов.Область(Индекс,3).Текст;
		Если Не ПустаяСтрока(ОбъектПоиска) Тогда
			Строка = СсылочныеОбъекты.Добавить();
			Строка.РеквизитСсылка = НовоеИмя;
			Строка.ОбъектПоиска = ОбъектПоиска;
			РеквизитПоиска = КонвертацияРеквизитов.Область(Индекс,4).Текст;
			Строка.РеквизитПоиска = ?(РеквизитПоиска="",Строка.РеквизитСсылка,РеквизитПоиска);
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	// Заполнение Таблицы
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(СтрокаXML);
	Строка = Неопределено;
	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.Имя = "row" Тогда
			Строка = ?(ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента, Таблица.Добавить(), Неопределено);			
		ИначеЕсли Строка <> Неопределено Тогда
			Попытка
				Строка[Конвертация[ЧтениеXML.Имя]] = ЧтениеXML.ПолучитьАтрибут("value");
			Исключение
				Если НезагруженныеРеквизиты.Найти(ЧтениеXML.Имя) = неопределено Тогда
					НезагруженныеРеквизиты.добавить();
				КонецЕсли; 				
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	// Заполнение ссылочных полей
	Если СсылочныеОбъекты.Количество() <> 0 Тогда
		ТаблицаРеквизитов = Новый ТаблицаЗначений;
		ТаблицаРеквизитов.Колонки.Добавить("Реквизит");
		ТаблицаРеквизитов.Колонки.Добавить("Значение");
		//НовоеНаименование = "";
		
		Для Каждого Строка Из Таблица Цикл
			Для Каждого СтрокаСсылка Из СсылочныеОбъекты Цикл
				ТаблицаРеквизитов.Очистить();
				Стр = ТаблицаРеквизитов.Добавить();
				Стр.Реквизит = СтрокаСсылка.РеквизитПоиска;
				РеквизитСсылка = СтрокаСсылка.РеквизитСсылка;
				Стр.Значение = Строка[РеквизитСсылка];				
				ОбъектПоиска = СтрокаСсылка.ОбъектПоиска;
				//НовоеНаименование = НовоеНаименование + "_" + Строка[РеквизитСсылка];
				Строка[РеквизитСсылка] = ПолучитьИлиСоздатьСсылкуНаОбъект(ОбъектПоиска,"Справочник",ТаблицаРеквизитов);
			КонецЦикла;
			//Строка[Наименование] = ?(Строка[Наименование] = "",Сред(НовоеНаименование,2),Строка[Наименование]);
		КонецЦикла;
	КонецЕсли;
	
		           	
	
	Возврат Таблица;

КонецФункции

Функция XMLВТаблицуОднаЗапись(СтрокаXML,КонвертацияРеквизитов) 
	
	НезагруженныеРеквизиты = Новый массив;
	
	Конвертация = Новый Соответствие;
	Таблица = Новый ТаблицаЗначений;
	СсылочныеОбъекты = Новый ТаблицаЗначений;
	СсылочныеОбъекты.Колонки.Добавить("РеквизитСсылка");
	СсылочныеОбъекты.Колонки.Добавить("ОбъектПоиска");
	СсылочныеОбъекты.Колонки.Добавить("РеквизитПоиска");
	
	Если СтрокаXML = Неопределено Тогда
		Возврат Таблица;
	КонецЕсли;

	// Создание колонок в Таблице
	Область = КонвертацияРеквизитов.НайтиТекст("<Реквизиты>",,КонвертацияРеквизитов.Область("C1"),,Истина);
	Если Область = Неопределено Тогда 
		Возврат Таблица;
	КонецЕсли;
	Индекс = Область.Верх + 1;	
	
	Пока КонвертацияРеквизитов.Область(Индекс,1).Текст <> "<\Реквизиты>" Цикл
		Если ПустаяСтрока(КонвертацияРеквизитов.Область(Индекс,2).Текст) Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		НовоеИмя = КонвертацияРеквизитов.Область(Индекс,2).Текст;
		//СтароеИмя = Неопределено;
		Если Не ПустаяСтрока(КонвертацияРеквизитов.Область(Индекс,1).Текст) Тогда
			СтароеИмя = КонвертацияРеквизитов.Область(Индекс,1).Текст;
			Конвертация.Вставить(СтароеИмя,НовоеИмя);
		КонецЕсли;
		Таблица.Колонки.Добавить(НовоеИмя);
		ОбъектПоиска = КонвертацияРеквизитов.Область(Индекс,3).Текст;
		Если Не ПустаяСтрока(ОбъектПоиска) Тогда
			Строка = СсылочныеОбъекты.Добавить();
			Строка.РеквизитСсылка = НовоеИмя;
			Строка.ОбъектПоиска = ОбъектПоиска;
			РеквизитПоиска = КонвертацияРеквизитов.Область(Индекс,4).Текст;
			Строка.РеквизитПоиска = ?(РеквизитПоиска="",Строка.РеквизитСсылка,РеквизитПоиска);
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	// Заполнение Таблицы
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(СтрокаXML);
	Строка = Неопределено;
	Попытка // Евросиб Фролов (26.04.2022
		Пока ЧтениеXML.Прочитать() Цикл
			Если ЧтениеXML.Имя = "row" или ЧтениеXML.Имя = "car" или ЧтениеXML.Имя = "org" или ЧтениеXML.Имя = "cont" тогда
				Строка = ?(ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента, Таблица.Добавить(), Неопределено);			
			Иначе
				Попытка
					Строка[Конвертация[ЧтениеXML.Имя]] = ЧтениеXML.ПолучитьАтрибут("value");
				Исключение
					Если НезагруженныеРеквизиты.Найти(ЧтениеXML.Имя) = неопределено Тогда
						НезагруженныеРеквизиты.добавить();
					КонецЕсли; 				
				КонецПопытки;
			КонецЕсли;
			
		КонецЦикла;
	Исключение
		// Евросиб Фролов (26.04.2022
		ЗаписьЖурналаРегистрации("Регламентная загрузка документов ЭТРАН", УровеньЖурналаРегистрации.Ошибка, Метаданные.РегламентныеЗадания.э_РегламентнаяЗагрузкаДокументовЭТРАН, , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		// Евросиб Фролов)
	КонецПопытки;
	
	// Заполнение ссылочных полей
	Если СсылочныеОбъекты.Количество() <> 0 Тогда
		ТаблицаРеквизитов = Новый ТаблицаЗначений;
		ТаблицаРеквизитов.Колонки.Добавить("Реквизит");
		ТаблицаРеквизитов.Колонки.Добавить("Значение");
		//НовоеНаименование = "";
		
