#Область СозданиеЗаявки

Процедура СоздатьЗаявку(СтруктураДокумента, АдресРезультата = Неопределено) Экспорт
	
	МакетНастроек = Обработки.э_Макеты.ПолучитьМакет("э_ЗаявкаНаПеревозку");
	СоответствиеТаблиц = ПолучитьСоответствиеТаблицОбъекта(МакетНастроек);
	Перевод = ПолучитьСоответствиеПереводРеквизитовОбъекта(МакетНастроек,1);
	ТекстЗапроса = ЗаполнитьXMLИзОбъекта(СтруктураДокумента.Ссылка,СоответствиеТаблиц,Перевод,МакетНастроек);
	ТекстЗапроса =
	//<!-- ********************************** -->
	//<!-- ПОДАЧА ЗАЯВКИ НА ПЕРЕВОЗКУ: запрос -->
	//<!-- ********************************** -->
	"<claimAgreement version=""1.0"">"
	+ ТекстЗапроса
	////<!-- Формировать заявку только до отправок включительно - не использовать данные блоков маршрутов, графиков подач и плательщиков -->
	//+ "<notFullClaim/>"
	//<!-- Использование 6-значных кодов станций и грузов в ответе -->
	+ "<useMod11/>"
	//<!-- Расчет графика подач(если не указан график подач и способ подачи не по датам) -->
	+ "<useCalcGraphPod/>"
	//<!-- Выдавать данные подписи ЭЦП -->
	+ "<useECP/>"
	//<!-- Не переводить состояние заявки в согласовано -->
	+ "<notState/>"
	//<!-- Не возвращать данные о накладных по заявке. -->
	+ "<notGetInv/>"
	//<!-- Выдавать список некритических ошибок-->
	//<!-- * тип данных: строка -->
	+ "<useWarning/>"
	+ "</claimAgreement>";
	
	ТипЗапроса = "Запрос создания заявки на перевозку грузов";
	ПоместитьЗапросВОчередь(ТипЗапроса, ТекстЗапроса, СтруктураДокумента.Ссылка);
	
	ДокументОбъект = Документы.э_ЗаявкаНаПеревозку.СоздатьДокумент();
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, СтруктураДокумента);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	э_ОчередьЗапросовКЭтрану.Пользователь КАК Пользователь,
	               |	э_ОчередьЗапросовКЭтрану.ТипЗапроса КАК ТипЗапроса
	               |ИЗ
	               |	РегистрСведений.э_ОчередьЗапросовКЭтрану КАК э_ОчередьЗапросовКЭтрану
	               |ГДЕ
	               |	НЕ э_ОчередьЗапросовКЭтрану.Обработан
	               |	И э_ОчередьЗапросовКЭтрану.Документ = &Заявка
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	э_ОчередьЗапросовКЭтрану.ДатаЗаписи";
	
	Запрос.УстановитьПараметр("Заявка", СтруктураДокумента.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.э_ОчередьЗапросовКЭтрану.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Пользователь.Установить(Выборка.Пользователь);
		НаборЗаписей.Отбор.ТипЗапроса.Установить(Выборка.ТипЗапроса);
		НаборЗаписей.Отбор.Документ.Установить(СтруктураДокумента.Ссылка);
		НаборЗаписей.Прочитать();
		Для Каждого Запись Из НаборЗаписей Цикл
			
			Если Запись.Обработан Тогда
				Продолжить;
			КонецЕсли;
			
			Запись.Пользователь = Выборка.Пользователь;
			Запись.ТипЗапроса = Выборка.ТипЗапроса;
			Запись.Документ = СтруктураДокумента.Ссылка;
			Запись.Ответ = ЗапросДанных(Выборка.ТипЗапроса,Запись.Запрос,Истина);
			Запись.Обработан = Истина;

			ПозицияИД = Найти(Запись.Ответ,"claimID value");
			ПозицияОшибки = Найти(Запись.Ответ,"errorMessage value=");   
			
			Если ПозицияИД > 0 или ПозицияОшибки > 0 Тогда
				
				Если ПозицияИД > 0  Тогда  
					ИДНакладной = Сред(Запись.Ответ,ПозицияИД+14,9);
					ДокументОбъект.ИДЗаявки = ИДНакладной; 
					
					ЗаполнитьДокументЗаявкаНаПеревозкуПриВыгрузке(Запись.Ответ,Ложь,"",ТекущаяДата(),ТекущаяДата(),ТекущаяДата(), ДокументОбъект);
					
					
				ИначеЕсли ПозицияОшибки > 0  Тогда 				
					КонецОшибки  = Найти(Запись.Ответ,"errorStatusCode value=");
					
					Если КонецОшибки > 0  Тогда 
						ДокументОбъект.Ошибки = Сред(Запись.Ответ,ПозицияОшибки+19,КонецОшибки - ПозицияОшибки - 24);
					КонецЕсли; 			
					
				КонецЕсли;
				
			КонецЕсли;
			
			НаборЗаписей.Записать();
			
		КонецЦикла;
	
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(СтруктураДокумента, ДокументОбъект);
	
	ПоместитьВоВременноеХранилище(СтруктураДокумента, АдресРезультата); 
	
КонецПроцедуры

