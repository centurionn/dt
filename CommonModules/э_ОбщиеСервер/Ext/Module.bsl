			Строка = ?(ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента, Таблица.Добавить(), Неопределено);
		ИначеЕсли ЧтениеXML.Имя = "OperId" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			OperId = ЧтениеXML.ПолучитьАтрибут("value");
			Строка = Неопределено; // на всякий случай
			ЗаписатьНомерПоследнейОперации(OperId,Перечисления.э_ИменаЗапросов.ЗапросСтатусаНакопительнойВедомости);
		ИначеЕсли Строка <> Неопределено Тогда
			Попытка
				Строка[ЧтениеXML.Имя] = ЧтениеXML.ПолучитьАтрибут("value");
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	
	Для Каждого Выборка Из Таблица Цикл
		ИДВедомости = Выборка.cumID;
		ТекстЗапроса = "<getCumulativeList version=""1.0"">
		|<cumId value=""" + ИДВедомости + """/>
		|</getCumulativeList>";
		
		
		Если Константы.э_ВебСервис.Получить() Тогда
			РезультатЗапроса = ПолучитьОтветНаЗапрос(ТекстЗапроса);	
		Иначе 
			РезультатЗапроса = глЭтран.Call(ТекстЗапроса);
		КонецЕсли;
		
		
//Евросиб Гудкова( 04.09.2020 Ticket№ 0205656      		ЗаписатьЛогЭТРАН("Запрос данных накопительной ведомости", ТекстЗапроса, РезультатЗапроса,,"Этран");
		
		//15022018 Добавляем получение кода ошибки
		РезультатПроверки = ОбработкаОшибокЗапросаДанных(РезультатЗапроса,, ТекстЗапроса, "Запрос данных накопительной ведомости"); //Евросиб Гудкова( 04.09.2020 Ticket№ 0205656      
		
		//СКА 19102019
		Если РезультатПроверки.КодОшибки = "1" Тогда
			Продолжить;
		КонецЕсли;
		//СКА 19102019
		
		
		
		// Заполнение Документа ВедомостьНакопительная
		Документ = Документы.э_ВедомостьНакопительная.СоздатьДокумент();
		МакетНастроек = Обработки.э_Макеты.ПолучитьМакет("э_ВедомостьНакопительная");
		Соответствие = ПолучитьСоответствиеТаблицОбъекта(МакетНастроек);
		СоответствиеПеревод = ПолучитьСоответствиеПереводРеквизитовОбъекта(МакетНастроек);
		ЗаполнитьОбъектИзXML(Документ,Соответствие,СоответствиеПеревод,РезультатЗапроса);
		СоздатьСсылкиПоРеквизитам(Документ,МакетНастроек);
		Документ2 = Документы.э_ВедомостьНакопительная.НайтиПоРеквизиту("ИдентификаторНакопительнойВедомости", ИДВедомости);
		Если Не Документ2.Пустая() Тогда
			Документ2 = Документ2.ПолучитьОбъект();
			//ЗаполнитьЗначенияСвойств(Документ2,Документ);
			ОбъектыЗаполнения = ПолучитьИменаПереведенныхРеквизитовИСсылокИТаблиц(МакетНастроек);
			ОбъектыЗаполнения = СтрЗаменить(ОбъектыЗаполнения,"<Ссылки>",",");
			ЗаполнитьОбъект(Документ2,Документ,ОбъектыЗаполнения);
			Документ = Документ2;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Документ.Дата) тогда 
			Документ.Дата = ТекущаяДата;
		КонецЕсли;
		Документ.ПометкаУдаления = Ложь;
		//Документ.Номер = ИДВедомости;
		Документ.Записать();
	КонецЦикла;
	
	Если ВсеДокументыЗагрузились Тогда
		НоваяГраницаПериода = ?(КонецПериода<ТекущаяДата,КонецПериода,ТекущаяДата);
		НаборЗаписей = РегистрыСведений.э_ГраницаПериодаЗагрузкиОбъектов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Объект.Установить("э_ВедомостьНакопительная");
		Запись = НаборЗаписей.Добавить();
		Запись.Объект  = "э_ВедомостьНакопительная";
		Запись.Граница = НоваяГраницаПериода;
		НаборЗаписей.Записать();		
	КонецЕсли;

