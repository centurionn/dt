// Рыбьяков К.А 03.05.2024 Ticket#0350495
Функция ЗапроситьНакладнуюВРИТМе(НакладнаяИД) Экспорт

	ИмяОперации = "GetEtranInvoiceByInvoiceID";
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("invoiceID", НакладнаяИД);

	ЗапросXML = ТранспортныеДокументы_сервер.ПолучитьТекстЗапросаВебСервису(СтруктураПараметров);
	
	Ответ = ВебСервисы_сервер.ЗапроситьРИТМ(ИмяОперации, ЗапросXML);
	
	Возврат Ответ;
	
КонецФункции 
