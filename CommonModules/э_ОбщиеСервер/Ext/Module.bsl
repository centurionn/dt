Функция ПолучитьКонтейнер(СтрокаТС)
	
	ISO = СтрокаТС.РазмерКрупнотоннажногоКонтейнера.КодРазмера  + СтрокаТС.ТипКрупнотоннажногоКонтейнера.КодТипа;
	
	ТипКонт = Справочники.э_ТипыКонтейнеров.НайтиПоРеквизиту("ISO",ISO);
	
	Если ЗначениеЗаполнено(ТипКонт) Тогда 		
	Иначе 
		
		//Создавать типы не будем, будем подставлять простые типы
		Если СтрокаТС.РазмерКрупнотоннажногоКонтейнера.НоминальнаяДлиннаВФутах = 20 тогда
			ТипКонт = Справочники.э_ТипыКонтейнеров.НайтиПоРеквизиту("ISO","20G1");
		Иначе
			ТипКонт = Справочники.э_ТипыКонтейнеров.НайтиПоРеквизиту("ISO","40G1");			
		КонецЕсли;
		
		
	КонецЕсли;
	

	
	
	
	НомерКонтейнера = СтрокаТС.НомерКонтейнера; 
	
	РезСПр = Справочники.э_Контейнеры.НайтиПоНаименованию(НомерКонтейнера);	
	ЕСли ЗначениеЗаполнено(РезСПр) Тогда
		//Возврат  РезСПр;
		НовСпр =  РезСПр.ПолучитьОбъект();  
	Иначе
		НовСпр =  Справочники.э_Контейнеры.СоздатьЭлемент();  
	КонецЕсли;
	
		
	НовСпр.Наименование = НомерКонтейнера;
	НовСпр.НомерКонтейнера = НомерКонтейнера;
	НовСпр.ТипКонтейнера = ТипКонт;
	НовСпр.Записать();
	
	Возврат НовСпр;
	
