Функция ЗаполнитьДокументЗаявкаНаПеревозку(РезультатЗапроса,ВсеДокументыЗагрузились,НомерЗаявки,НачалоПериода,КонецПериода,ТекущаяДата,Ссылка)Экспорт
	
			
	ЗапросОбщиеПоказатели = Новый Запрос;
	ЗапросОбщиеПоказатели.Текст = "ВЫБРАТЬ
	                              |	э_ОбщиеПоказатели.Ссылка КАК Ссылка
	                              |ИЗ
	                              |	Справочник.э_ОбщиеПоказатели КАК э_ОбщиеПоказатели
	                              |ГДЕ
	                              |	э_ОбщиеПоказатели.Наименование = &Наименование
	                              |	И э_ОбщиеПоказатели.ИдентификаторПараметра = &ИдентификаторПараметра";
	ПустаяСсылкаОбщиеПоказатели = Справочники.э_ОбщиеПоказатели.ПустаяСсылка();
	
	Документ = Документы.э_ЗаявкаНаПеревозку.СоздатьДокумент(); 
	МакетНастроек = Обработки.э_Макеты.ПолучитьМакет("э_ЗаявкаНаПеревозку");
	
	Соответствие = ПолучитьСоответствиеТаблицОбъекта(МакетНастроек);
	СоответствиеПеревод = ПолучитьСоответствиеПереводРеквизитовОбъекта(МакетНастроек);
	ЗаполнитьОбъектИзXML(Документ,Соответствие,СоответствиеПеревод,РезультатЗапроса);
	СоздатьСсылкиПоРеквизитам(Документ,МакетНастроек);
	
	Если Ссылка = неопределено Тогда
		Документ2 = Документы.э_ЗаявкаНаПеревозку.НайтиПоРеквизиту("ИДЗаявки",Документ.ИДЗаявки);  
	Иначе
		Документ2 = Ссылка;  			
	КонецЕсли;
	
	Ошибки = "";
	Если Найти(РезультатЗапроса,"<warning>") > 0 Тогда
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(РезультатЗапроса);		
		Пока ЧтениеXML.Прочитать() Цикл
			Если ЧтениеXML.Имя = "warning" Тогда
				Ошибки = ЧтениеXML.ПолучитьАтрибут("value");			
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	

		
	Если Не Документ2.Пустая() Тогда
		Документ2 = Документ2.ПолучитьОбъект();
		ОбъектыЗаполнения = ПолучитьИменаПереведенныхРеквизитовИСсылокИТаблиц(МакетНастроек);
		ОбъектыЗаполнения = СтрЗаменить(ОбъектыЗаполнения,"<Ссылки>",",");
		ЗаполнитьОбъект(Документ2,Документ,ОбъектыЗаполнения);
		Документ = Документ2;
	КонецЕсли;                                
	
	Документ.Дата =  Документ.ДатаРегистрации;//Документ.claimRegDate;
	Документ.Номер = НомерЗаявки;
	Документ.Ошибки = Ошибки;
	
		
	Если Документ.Отправки.Количество() > 0 Тогда
		ПаспортОрганизации = Справочники.э_ПаспортаОрганизаций.НайтиПоКоду(XMLСтрока(Документ.Отправки[0].ГрузополучательИД)); 	
			
	КонецЕсли;
	
	Для каждого СтрокаОтправки Из Документ.Плательщики Цикл  		
		   Плательщик  =  ПолучитьПлательщика(СтрокаОтправки);
		   Если ЗначениеЗаполнено(Плательщик) Тогда
				 //ЗаполнитьЗначенияСвойств(СтрокаОтправки,Плательщик);
				 СтрокаОтправки.Плательщик = Плательщик; 
				 Документ.Плательщик  = Плательщик;
		   КонецЕсли;
		   
	КонецЦикла;
	
	

	 
	Попытка
		Документ.ПредыдущийЗапросНеПолучен = ложь;         
		Документ.Записать();
	Исключение
	
	КонецПопытки;
	
	Если ВсеДокументыЗагрузились Тогда
		НоваяГраницаПериода = ?(КонецПериода<ТекущаяДата,КонецПериода,ТекущаяДата);
		НаборЗаписей = РегистрыСведений.э_ГраницаПериодаЗагрузкиОбъектов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Объект.Установить("э_ЗаявкаНаПеревозку");
		Запись = НаборЗаписей.Добавить();
		Запись.Объект  = "э_ЗаявкаНаПеревозку";
		Запись.Граница = НоваяГраницаПериода;
		НаборЗаписей.Записать();
	КонецЕсли;
	
	
	Возврат Истина;
	
КонецФункции

Функция ЗаполнитьГУ12(РезультатЗапроса,ВсеДокументыЗагрузились,ИДЗаявки,НачалоПериода,КонецПериода,ТекущаяДата,НомерЗаявки,Регламент)Экспорт
	
	НайденнаяЗаявка = Документы.э_ЗаявкаНаПеревозку.НайтиПоРеквизиту("ИДЗаявки",ИДЗаявки);  
	Если Не НайденнаяЗаявка.Пустая() Тогда
		ДокументЗаявка = НайденнаяЗаявка.ПолучитьОбъект();
	Иначе
		ДокументЗаявка = Документы.э_ЗаявкаНаПеревозку.СоздатьДокумент();
	КонецЕсли;
	
	МакетНастроек = Обработки.э_Макеты.ПолучитьМакет("э_ЗаявкаНаПеревозку");
	
	Соответствие = ПолучитьСоответствиеТаблицОбъекта(МакетНастроек);
	СоответствиеПеревод = ПолучитьСоответствиеПереводРеквизитовОбъекта(МакетНастроек);
	ЗаполнитьОбъектИзXML(ДокументЗаявка,Соответствие,СоответствиеПеревод,РезультатЗапроса);
	СоздатьСсылкиПоРеквизитам(ДокументЗаявка,МакетНастроек);
	
	Ошибки = "";
	Если Найти(РезультатЗапроса,"<warning>") > 0 Тогда
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(РезультатЗапроса);		
		Пока ЧтениеXML.Прочитать() Цикл
			Если ЧтениеXML.Имя = "warning" Тогда
				Ошибки = ЧтениеXML.ПолучитьАтрибут("value");			
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
		
	//ДокументЗаявка.Номер = НомерЗаявки;
	ДокументЗаявка.Дата = ДокументЗаявка.ДатаРегистрации;
	ДокументЗаявка.Ошибки = Ошибки;
	
		
	Если ДокументЗаявка.Отправки.Количество() > 0 Тогда
		ПаспортОрганизации = Справочники.э_ПаспортаОрганизаций.НайтиПоКоду(XMLСтрока(ДокументЗаявка.Отправки[0].ГрузополучательИД)); 	
	КонецЕсли;
	
	Попытка
		ДокументЗаявка.ПредыдущийЗапросНеПолучен = ложь;         
		ДокументЗаявка.Записать();
	Исключение
		ОО = ОписаниеОшибки();
		ПериодЗапроса = Новый СтандартныйПериод;
		ПериодЗапроса.ДатаНачала = НачалоПериода;
		ПериодЗапроса.ДатаОкончания = КонецПериода;
		ЗаписатьОшибкиЗагрузкиЭТРАН("Запись ГУ-12 в БД", "", "", Регламент, ОО, ИДЗаявки, ПериодЗапроса);
		Возврат Ложь;
	КонецПопытки;
	
	Если ВсеДокументыЗагрузились Тогда
		НоваяГраницаПериода = ?(КонецПериода<ТекущаяДата,КонецПериода,ТекущаяДата);
		НаборЗаписей = РегистрыСведений.э_ГраницаПериодаЗагрузкиОбъектов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Объект.Установить("э_ЗаявкаНаПеревозку");
		Запись = НаборЗаписей.Добавить();
		Запись.Объект  = "э_ЗаявкаНаПеревозку";
		Запись.Граница = НоваяГраницаПериода;
		НаборЗаписей.Записать();
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьПлательщика(СтрокаОтправки)
	
	Возврат Неопределено;

	Если СтрокаОтправки.ПлательщикОКПО = "" Тогда
		Плательщик = Справочники.э_Перевозчики.НайтиПоРеквизиту("УсловныйИдентификаторПеревозчика",СтрокаОтправки.УсловныйИдентификаторПеревозчика);
	Иначе
		Плательщик = Справочники.э_Перевозчики.НайтиПоРеквизиту("ПлательщикОКПО",СтрокаОтправки.ПлательщикОКПО);	
	КонецЕсли;

	Если ЗначениеЗаполнено(Плательщик) Тогда
		НовЭл =	Плательщик.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(НовЭл,СтрокаОтправки);
		НовЭл.Наименование =  СтрокаОтправки.ПлательщикНаименование;
		Попытка
			НовЭл.Записать();
		Исключение
			Возврат Неопределено;
		КонецПопытки;

		Возврат НовЭл.Ссылка;    
	Иначе
		НовЭл =	Справочники.э_Перевозчики.СоздатьЭлемент();
		ЗаполнитьЗначенияСвойств(НовЭл,СтрокаОтправки);
		НовЭл.Наименование =  СтрокаОтправки.ПлательщикНаименование;
		Попытка
			НовЭл.Записать();
		Исключение
			Возврат Неопределено;
		КонецПопытки;
		
		Возврат НовЭл.Ссылка;
		
	КонецЕсли;          	                                                             
	
	
КонецФункции

