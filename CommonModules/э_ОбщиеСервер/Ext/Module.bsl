Функция ПолучитьСоответствиеТаблицОбъекта(МакетНастроек) экспорт 
	Соответствие = Новый Соответствие;

	Область = МакетНастроек.НайтиТекст("<СоответствиеТаблицОбъекта>",,МакетНастроек.Область("C1"),,Истина);
	Индекс = Область.Верх + 1;
	
	Пока МакетНастроек.Область(Индекс,1).Текст <> "<\СоответствиеТаблицОбъекта>" Цикл
		Если ПустаяСтрока(МакетНастроек.Область(Индекс,1).Текст) Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		Ключ = МакетНастроек.Область(Индекс,1).Текст;
		Значение = МакетНастроек.Область(Индекс,2).Текст;
		Соответствие.Вставить(Ключ, Значение);
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Возврат Соответствие;
	
КонецФункции

//Процедура копирует объект Источник в объект Приемник, объекты должны быть одинакового состава
Процедура ЗаполнитьОбъект(Приемник, Источник, ОбъектыЗаполнения="") 
	Если ОбъектыЗаполнения="" Тогда
		ЗаполнитьЗначенияСвойств(Приемник, Источник);
		Для Каждого Объект Из Приемник.Метаданные().ТабличныеЧасти Цикл
			ТабличнаяЧасть = Приемник[Объект.Имя];
			ТабличнаяЧасть.Загрузить(Источник[Объект.Имя].Выгрузить());
		КонецЦикла;
	Иначе
		Реквизиты = "";
		Таблицы = "";
		ПозицияТаблиц = Найти(ОбъектыЗаполнения,"<Таблицы>");
		Если ПозицияТаблиц <> 0 Тогда
			Таблицы   = СтрЗаменить(Сред(ОбъектыЗаполнения,ПозицияТаблиц),"<Таблицы>","");
			Реквизиты = Сред(ОбъектыЗаполнения,1,ПозицияТаблиц-1);
		КонецЕсли;
		Реквизиты = СтрЗаменить(Реквизиты,"<Реквизиты>","");
		Если Реквизиты <> "" Тогда			
			Для Каждого Объект Из Приемник.Метаданные().Реквизиты Цикл
				ПозицияРеквизита = Найти(Реквизиты,Объект.Имя);
				Если ПозицияРеквизита <> 0 Тогда
					Приемник[Объект.Имя] = Источник[Объект.Имя];
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Таблицы <> "" Тогда
			Для Каждого Объект Из Приемник.Метаданные().ТабличныеЧасти Цикл
				ПозицияТаблицы = Найти(Таблицы,Объект.Имя);
				Если ПозицияТаблицы <> 0 и не Объект.Имя = "Грузы" Тогда
					ТабличнаяЧасть = Приемник[Объект.Имя];
					ТабличнаяЧасть.Загрузить(Источник[Объект.Имя].Выгрузить());
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Функция возращает Соответствие, в котором перечислены все реквезиты и таблицы объекта в переведённом виде
// Если Загрузка=Истина, то возвращается соответствие данных XML реквизитам АТК, 
// иначе возвращается соответствие реквизитов АТК данным XML(для создания запросов)
Функция ПолучитьСоответствиеПереводРеквизитовОбъекта(МакетНастроек,Знач КолонкаЗагрузки=0) Экспорт
	Соответствие = Новый Соответствие;

	Область = МакетНастроек.НайтиТекст("<Перевод>",,МакетНастроек.Область("C1"),,Истина);
	Индекс = Область.Верх + 1;
	
	Если КолонкаЗагрузки=0 Тогда	
		Пока МакетНастроек.Область(Индекс,1).Текст <> "<\Перевод>" Цикл
			Если ПустаяСтрока(МакетНастроек.Область(Индекс,1).Текст) Тогда
				Индекс = Индекс + 1;
				Продолжить;
			КонецЕсли;
			Если МакетНастроек.Область(Индекс,1).Текст = "<Реквизиты>" Тогда
				Индекс = Индекс + 1;
				Пока МакетНастроек.Область(Индекс,1).Текст <> "<\Реквизиты>" Цикл
					
					РеквизитЭтран = МакетНастроек.Область(Индекс,1).Текст;
					РеквизитАТК = МакетНастроек.Область(Индекс,2).Текст;
					
					Если ПустаяСтрока(РеквизитЭтран) Или ПустаяСтрока(РеквизитАТК) Тогда
						Индекс = Индекс + 1;
						Продолжить;
					КонецЕсли;
					
					Соответствие.Вставить(РеквизитЭтран, РеквизитАТК);
					Индекс = Индекс + 1;
				КонецЦикла;
			ИначеЕсли МакетНастроек.Область(Индекс,1).Текст = "<Таблица>" Тогда
				ТаблицаЭтран = МакетНастроек.Область(Индекс,2).Текст;
				ТаблицаАТК = МакетНастроек.Область(Индекс,3).Текст;
				Если Не (ПустаяСтрока(ТаблицаЭтран) Или ПустаяСтрока(ТаблицаАТК)) Тогда
					Соответствие.Вставить("Т" + ТаблицаЭтран, ТаблицаАТК);
					Индекс = Индекс + 1;
					Пока МакетНастроек.Область(Индекс,1).Текст <> "<\Таблица>" Цикл
						РеквизитЭтран = МакетНастроек.Область(Индекс,1).Текст;
						РеквизитАТК = МакетНастроек.Область(Индекс,2).Текст;
						
						Если ПустаяСтрока(РеквизитЭтран) Или ПустаяСтрока(РеквизитАТК) Тогда
							Индекс = Индекс + 1;
							Продолжить;
						КонецЕсли;
						
						Соответствие.Вставить(ТаблицаАТК + РеквизитЭтран, РеквизитАТК);
						Индекс = Индекс + 1;					
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
			Индекс = Индекс + 1;
		КонецЦикла;
	Иначе
		КолонкаЗагрузки = 2 + КолонкаЗагрузки;
		Пока МакетНастроек.Область(Индекс,1).Текст <> "<\Перевод>" Цикл
			Если ПустаяСтрока(МакетНастроек.Область(Индекс,1).Текст) Тогда
				Индекс = Индекс + 1;
				Продолжить;
			КонецЕсли;
			Если МакетНастроек.Область(Индекс,1).Текст = "<Реквизиты>" Тогда
				Индекс = Индекс + 1;
				Пока МакетНастроек.Область(Индекс,1).Текст <> "<\Реквизиты>" Цикл

					РеквизитАТК = МакетНастроек.Область(Индекс,2).Текст;
					РеквизитЭтран = ?(МакетНастроек.Область(Индекс,КолонкаЗагрузки).Текст="+"
										,МакетНастроек.Область(Индекс,1).Текст
										,МакетНастроек.Область(Индекс,КолонкаЗагрузки).Текст);						
					
					Если ПустаяСтрока(РеквизитЭтран) Или ПустаяСтрока(РеквизитАТК) Тогда
						Индекс = Индекс + 1;
						Продолжить;
					КонецЕсли;
					
					Соответствие.Вставить(РеквизитАТК, РеквизитЭтран);
					Индекс = Индекс + 1;
				КонецЦикла;
			ИначеЕсли МакетНастроек.Область(Индекс,1).Текст = "<Таблица>" Тогда
				ТаблицаАТК = МакетНастроек.Область(Индекс,3).Текст;
				ТаблицаЭтран = ?(МакетНастроек.Область(Индекс,КолонкаЗагрузки+1).Текст="+"
									,МакетНастроек.Область(Индекс,2).Текст
									,МакетНастроек.Область(Индекс,КолонкаЗагрузки+1).Текст);					

				Если Не (ПустаяСтрока(ТаблицаЭтран) Или ПустаяСтрока(ТаблицаАТК)) Тогда
					Соответствие.Вставить("Т" + ТаблицаАТК, ТаблицаЭтран);
					Индекс = Индекс + 1;
					Пока МакетНастроек.Область(Индекс,1).Текст <> "<\Таблица>" Цикл
						РеквизитАТК = МакетНастроек.Область(Индекс,2).Текст;
						РеквизитЭтран = ?(МакетНастроек.Область(Индекс,КолонкаЗагрузки).Текст="+"
											,МакетНастроек.Область(Индекс,1).Текст
											,МакетНастроек.Область(Индекс,КолонкаЗагрузки).Текст);						

						Если ПустаяСтрока(РеквизитЭтран) Или ПустаяСтрока(РеквизитАТК) Тогда
							Индекс = Индекс + 1;
							Продолжить;
						КонецЕсли;
						
						Соответствие.Вставить(ТаблицаЭтран + РеквизитАТК, РеквизитЭтран);
						Индекс = Индекс + 1;					
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
			Индекс = Индекс + 1;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Соответствие;
	
КонецФункции

// Функция возращает именя переведенных реквизитов, ссылок и таблиц, которые используются при загрузке объекта из Этран
Функция ПолучитьИменаПереведенныхРеквизитовИСсылокИТаблиц(МакетНастроек) 
	
	Реквизиты = "";
	Ссылки = "";
	Таблицы = "";
	
	Область = МакетНастроек.НайтиТекст("<Перевод>",,МакетНастроек.Область("C1"),,Истина);
	Область = МакетНастроек.НайтиТекст("<Реквизиты>",Область,МакетНастроек.Область("C1"),,Истина);
	Индекс = Область.Верх + 1;

	Пока МакетНастроек.Область(Индекс,1).Текст <> "<\Реквизиты>" Цикл
		
		РеквизитЭтран = МакетНастроек.Область(Индекс,1).Текст;
		РеквизитАТК = МакетНастроек.Область(Индекс,2).Текст;
		
		Если ПустаяСтрока(РеквизитЭтран) Или ПустаяСтрока(РеквизитАТК) Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Реквизиты = Реквизиты + "," + РеквизитАТК;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Область = МакетНастроек.НайтиТекст("<СоответствиеТаблицОбъекта>",Область,МакетНастроек.Область("C1"),,Истина);
	Индекс = Область.Верх + 1;

	Пока МакетНастроек.Область(Индекс,1).Текст <> "<\СоответствиеТаблицОбъекта>" Цикл

		ТаблицаАТК = МакетНастроек.Область(Индекс,1).Текст;
		
		Если ПустаяСтрока(ТаблицаАТК) Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Таблицы = Таблицы + "," + ТаблицаАТК;
		Индекс = Индекс + 1;
	КонецЦикла;

	
	Область = МакетНастроек.НайтиТекст("<ЗаполнениеСсылок>",Область,МакетНастроек.Область("C1"),,Истина);
	Область = МакетНастроек.НайтиТекст("<Реквизиты>",Область,МакетНастроек.Область("C1"),,Истина);
	Индекс = Область.Верх + 1;

	Пока МакетНастроек.Область(Индекс,1).Текст <> "<\Реквизиты>" Цикл

		СсылкаАТК = МакетНастроек.Область(Индекс,1).Текст;
		
		Если ПустаяСтрока(СсылкаАТК) Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Ссылки = Ссылки + "," + СсылкаАТК;
		Индекс = Индекс + 1;
	КонецЦикла;

	Реквизиты = Сред(Реквизиты,2);
	Ссылки = Сред(Ссылки,2);
	Таблицы = Сред(Таблицы,2);
	
	Результат = "<Реквизиты>" + Реквизиты + "<Ссылки>" + Ссылки + "<Таблицы>" + Таблицы;
	Возврат Результат;
	
КонецФункции

// Процедура заполняет реквизиты и табличные части Объекта в соответствии с данными из СтрокиXML
// В соответстви СоответствиеТаблицОбъекта указаны все табличные части объекта в первом параметре, 
// а во втором - название реквизита, ссылающегося на другую табличную часть, для данной табличной части
Процедура ЗаполнитьОбъектИзXML(Объект,СоответствиеТаблицОбъекта,СоответствиеПеревод,СтрокаXML,ПутьКФайлу = Неопределено) 
	
	СтрокаXMLПослеЗаменыСимволов = ЗаменитьСимволыXML(СтрокаXML);
	
	//ЧтениеXML = Новый ЧтениеXML;
	//ЧтениеXML.УстановитьСтроку(СтрокаXMLПослеЗаменыСимволов);
	ЧтениеXML = Новый ЧтениеXML;
	
	Если ПутьКФайлу = Неопределено Тогда
		ЧтениеXML.УстановитьСтроку(СтрокаXML);	
	Иначе  		
		ЧтениеXML.ОткрытьФайл(ПутьКФайлу);
	КонецЕсли;

	Стек = Новый Массив;
	Стек.Добавить("");
	Стек.Добавить(Объект);
	ПредыдущийПараметр = Неопределено;
	ПредыдущаяСтрока = Неопределено;
	
	ГОКОД = неопределено;
	ГПКОД = неопределено;
	ГОНаименование = "";
	ГПНаименование = "";
	
	//Попытка для поиск ошибки
	Попытка
		Пока ЧтениеXML.Прочитать() Цикл
			
			Имя = ЧтениеXML.Имя;
			ТаблицаАТК = СоответствиеПеревод["Т" + Имя];
			Параметр = СоответствиеТаблицОбъекта[ТаблицаАТК];
			
			Если Параметр <> Неопределено Тогда
				Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
					//ТаблицаАТК = СоответствиеПеревод["Т" + Имя];
					Строка = Объект[ТаблицаАТК].Добавить();
					Стек.Добавить(ТаблицаАТК);
					Стек.Добавить(Строка);
					Если Параметр <> "" Тогда
						Если Найти(Параметр,"->") = 1 Тогда
							РеквизитАТК = СтрЗаменить(Параметр,"->","");
							Строка[РеквизитАТК] = ?(ПредыдущийПараметр = Параметр,ПредыдущаяСтрока[РеквизитАТК] + 1,0);
							ПредыдущийПараметр = Параметр;
							ПредыдущаяСтрока = Строка;
						Иначе
							Родитель = Стек[Стек.Количество()-3];
							Строка[Параметр] = Родитель[Параметр];
						КонецЕсли;					
					КонецЕсли;
				Иначе
					Стек.Удалить(Стек.Количество()-1);
					Стек.Удалить(Стек.Количество()-1);
				КонецЕсли;
			Иначе
				Попытка
					Атрибут = ЧтениеXML.ПолучитьАтрибут("value");
					Если Атрибут <> Неопределено Тогда
						Строка      = Стек[Стек.Количество()-1];
						ТаблицаАТК  = Стек[Стек.Количество()-2];
						РеквизитАТК = СоответствиеПеревод[ТаблицаАТК + Имя];
						
						Если Имя = "invSenderName" Тогда
							ГОНаименование = Атрибут;
						ИначеЕсли Имя = "invRecipName" Тогда
							ГПНаименование = Атрибут;
						ИначеЕсли Имя = "invSenderID" Тогда
							ГОКОД = Атрибут;
						ИначеЕсли Имя = "invRecipID" Тогда
							ГПКОД = Атрибут;
						КонецЕсли;
							
						Строка[РеквизитАТК] = Атрибут;
						
					КонецЕсли;
				Исключение
					//Сообщить(Имя + " : " + Атрибут);
				КонецПопытки;			
				
			КонецЕсли;
			
		КонецЦикла;
	Исключение
		ы=1;
	КонецПопытки;
	
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.э_Накладная") Тогда
		Если НЕ ЗначениеЗаполнено(Объект.Грузоотправитель) И ЗначениеЗаполнено(ГОНаименование) Тогда
			Объект.Грузоотправитель = ПолучитьГОГП(ГОКОД, ГОНаименование);
			Объект.ГрузоотправительИД = ГОКОД;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.Грузополучатель) И ЗначениеЗаполнено(ГПНаименование) Тогда
			Объект.Грузополучатель = ПолучитьГОГП(ГПКОД, ГПНаименование);
			Объект.ГрузополучательИД = ГПКОД;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьГОГП(Код, Наименование)
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	э_ПаспортаОрганизаций.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.э_ПаспортаОрганизаций КАК э_ПаспортаОрганизаций
	               |ГДЕ
	               |	НЕ э_ПаспортаОрганизаций.ПометкаУдаления
	               |	И ВЫБОР
	               |			КОГДА &Код <> НЕОПРЕДЕЛЕНО
	               |				ТОГДА э_ПаспортаОрганизаций.Код = &Код
	               |			ИНАЧЕ э_ПаспортаОрганизаций.Наименование = &Наименование
	               |		КОНЕЦ";
	Запрос.УстановитьПараметр("Код", Код);
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	Иначе
		
		НСпр = Справочники.э_ПаспортаОрганизаций.СоздатьЭлемент();
		НСпр.Наименование = Наименование;
		НСпр.Код = Код;
		Попытка
			НСпр.Записать();
		Исключение
			Возврат Неопределено;
		КонецПопытки; 		
		Результат = НСпр.Ссылка;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


// Функция возвращает Строку XML на основе данных объекта
// В соответстви СоответствиеТаблицОбъекта указаны все табличные части объекта в первом параметре, 
// а во втором - название реквизита, ссылающегося на другую табличную часть, для данной табличной части
Функция ЗаполнитьXMLИзОбъекта(Объект,СоответствиеТаблицОбъекта,СоответствиеПеревод,МакетНастроек = Неопределено) экспорт
	
	//АТК 29012015
	Если МакетНастроек = Неопределено тогда
		Возврат "";
	иначе
		
		СтрокаXML = "";
		
		//АТК 29012015
		Индекс = 0;
		БлокДанных = "";
		ТекТаблица = "";
		ТекущийТекст = МакетНастроек.Область(Индекс,1).Текст;  				
		
		Пока ТекущийТекст <> "<\Перевод>" Цикл
			
			Если ПустаяСтрока(ТекущийТекст) Тогда
				Индекс = Индекс + 1;
				ТекущийТекст = МакетНастроек.Область(Индекс,1).Текст;
				Продолжить;
			ИначеЕсли ТекущийТекст = "<Реквизиты>" Тогда
				БлокДанных = "Реквизиты";
			ИначеЕсли ТекущийТекст = "<Таблица>" Тогда  
				БлокДанных = "Таблица"; 
				ТекТаблица = МакетНастроек.Область(Индекс,3).Текст;
			КонецЕсли;
			
			ТекущееЗначение = МакетНастроек.Область(Индекс,2).Текст;	
			Если ПустаяСтрока(ТекущееЗначение) Тогда
				Индекс = Индекс + 1;
				ТекущийТекст = МакетНастроек.Область(Индекс,1).Текст;
				Продолжить;
			КонецЕсли;
			
			Если БлокДанных = "Реквизиты" Тогда
				
				РеквизитЭтран = СоответствиеПеревод[ТекущееЗначение];
				Если РеквизитЭтран<>Неопределено Тогда
					Значение = Объект[ТекущееЗначение];
					Если ЗначениеЗаполнено(Значение) Тогда
						Значение = ?(ТипЗнч(Объект[ТекущееЗначение]) = Тип("Число"),СтрЗаменить(Значение,",","."),Значение);
						СтрокаXML = СтрокаXML + Символы.ПС + "<" + РеквизитЭтран + " value=""" + Значение + """/>";
					КонецЕсли;
				КонецЕсли;		
				
			КонецЕсли;
			
			Если БлокДанных = "Таблица" Тогда
				
				Для Каждого Таблица Из Объект.Метаданные().ТабличныеЧасти Цикл
					Если Таблица.Имя = ТекТаблица тогда
						ТаблицаЭтран = СоответствиеПеревод["Т" + Таблица.Имя];
						РеквизитСвязиТаблиц = СоответствиеТаблицОбъекта[Таблица.Имя];
						Если ТаблицаЭтран<>Неопределено И РеквизитСвязиТаблиц = "" Тогда
							
							
							Для Каждого Строка Из Объект[Таблица.Имя] Цикл
								
								
								СтрокаXMLТаблицы = "";  				
								//СтрокаXML = СтрокаXML + Символы.ПС + "<" + ТаблицаЭтран + ">";
								Для Каждого Реквизит Из Объект.Метаданные().ТабличныеЧасти[Таблица.Имя].Реквизиты Цикл
									РеквизитЭтран = СоответствиеПеревод[ТаблицаЭтран+Реквизит.Имя];
									Если РеквизитЭтран<>Неопределено Тогда
										Значение = Строка[Реквизит.Имя];
										Если ЗначениеЗаполнено(Значение) Тогда
											Значение = ?(ТипЗнч(Строка[Реквизит.Имя]) = Тип("Число"),СтрЗаменить(Значение,",","."),Значение);
											СтрокаXMLТаблицы = СтрокаXMLТаблицы + Символы.ПС + "<" + РеквизитЭтран + " value=""" + Значение + """/>";
										КонецЕсли;
									КонецЕсли;
								КонецЦикла;
								//Если в таблице есть реквизит, указанный в следующей(СоответствиеТаблицОбъекта), то вставляем следующую таблицу сюда.
								// тоже самое делаем со всеми последующими
								
								Для Каждого ВложеннаяТаблица Из Объект.Метаданные().ТабличныеЧасти Цикл
									ВложеннаяТаблицаЭтран = СоответствиеПеревод["Т" + ВложеннаяТаблица.Имя];
									РеквизитСвязиТаблиц = СоответствиеТаблицОбъекта[ВложеннаяТаблица.Имя];
									Если ВложеннаяТаблицаЭтран<>Неопределено И РеквизитСвязиТаблиц <> "" Тогда
										Попытка
											КолонкаРодителя = Объект.Метаданные().ТабличныеЧасти[Таблица.Имя].Реквизиты[РеквизитСвязиТаблиц];
										Исключение
											Продолжить;
										КонецПопытки;
										Отбор = Новый Структура();
										Отбор.Вставить(РеквизитСвязиТаблиц,Строка[РеквизитСвязиТаблиц]);
										НайденныеСтроки = Объект[ВложеннаяТаблица.Имя].НайтиСтроки(Отбор);
										
										Для Каждого ВложеннаяСтрока Из НайденныеСтроки Цикл
											СтрокаXMLВложеннойТаблицы = "";
											//СтрокаXML = СтрокаXML + Символы.ПС + "<" + ВложеннаяТаблицаЭтран + ">";
											Для Каждого Реквизит Из Объект.Метаданные().ТабличныеЧасти[ВложеннаяТаблица.Имя].Реквизиты Цикл
												РеквизитЭтран = СоответствиеПеревод[ВложеннаяТаблицаЭтран+Реквизит.Имя];
												Если РеквизитЭтран<>Неопределено Тогда
													Значение = ВложеннаяСтрока[Реквизит.Имя];
													Если ЗначениеЗаполнено(Значение) Тогда
														Значение = ?(ТипЗнч(ВложеннаяСтрока[Реквизит.Имя]) = Тип("Число"),СтрЗаменить(Значение,",","."),Значение);
														СтрокаXMLВложеннойТаблицы = СтрокаXMLВложеннойТаблицы + Символы.ПС + "<" + РеквизитЭтран + " value=""" + Значение + """/>";
													КонецЕсли;
												КонецЕсли;
											КонецЦикла;
											//Если в таблице есть реквизит, указанный в следующей(СоответствиеТаблицОбъекта), то вставляем следующую таблицу сюда.
											// тоже самое делаем со всеми последующими
											
											Если ЗначениеЗаполнено(СтрокаXMLВложеннойТаблицы) Тогда
												СтрокаXMLТаблицы = СтрокаXMLТаблицы 
												+ Символы.ПС + "<" + ВложеннаяТаблицаЭтран + ">" 
												+ СтрокаXMLВложеннойТаблицы
												+ Символы.ПС + "</" + ВложеннаяТаблицаЭтран + ">";
											КонецЕсли;
