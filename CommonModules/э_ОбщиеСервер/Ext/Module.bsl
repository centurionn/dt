Процедура ЗагрузитьНакладнуюПоНомеруВагона(НомерВагона = "", АдресРезультата = Неопределено) Экспорт
	
	Если не Константы.э_ВебСервис.Получить() Тогда  
		глЭтран = ПодключитьКЭтранНаСервере();
	КонецЕсли;
	
	
	ВозвращаемаяСтруктура = Новый Структура("Ссылка, Сообщение, НомерВагона",,,НомерВагона);
	
	ДлительныеОперации.СообщитьПрогресс(, "Подключение к ЭТРАН");
	

	ТекстЗапроса = "<invoiceByCar version=""1.0""> 
	|<car><carNumber value=""" + НомерВагона + """/></car> 
	//|<invToStation value=" + НомерВагона + """/>	
	|<all/></invoiceByCar>";
	
	//Если глЭтран = Неопределено Тогда
	//	ВозвращаемаяСтруктура.Сообщение = "Не удалось подключиться к ЭТРАН";
	//	ПоместитьВоВременноеХранилище(ВозвращаемаяСтруктура, АдресРезультата);
	//	Возврат;
	//КонецЕсли;
	
	ДлительныеОперации.СообщитьПрогресс(, "Отправка запроса в ЭТРАН");
	
	Если Константы.э_ВебСервис.Получить() Тогда
		РезультатЗапроса = ПолучитьОтветНаЗапрос(ТекстЗапроса);	
	Иначе 
		РезультатЗапроса = глЭтран.Call(ТекстЗапроса);
	КонецЕсли;

	//Если СтрНайти(РезультатЗапроса,"invoiceId") = 0 Тогда	
	//	
	//	ТекстЗапроса = "<invoiceByCar version=""1.0""> 
	//	|<car><carNumber value=""" + НомерВагона + """/></car> 
	//	//|<invToStation value=" + НомерВагона + """/>	
	//	|<all/></invoiceByCar>";
	//	
	//	РезультатЗапроса = глЭтран.Call(ТекстЗапроса);
	//КонецЕсли;
	
	
	Если СтрНайти(РезультатЗапроса,"invoiceId") = 0 Тогда
		ВозвращаемаяСтруктура.Сообщение = "Накладная не найдена в ЭТРАН";
		ПоместитьВоВременноеХранилище(ВозвращаемаяСтруктура, АдресРезультата);
		Возврат;
	КонецЕсли;
	
	ДлительныеОперации.СообщитьПрогресс(, "Получение ответа от ЭТРАН");

	
	МассивНакладных = Новый Массив; 		
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(РезультатЗапроса);
	НакладнаяИД = "";
	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.Имя = "invoiceId" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			НакладнаяИД = ЧтениеXML.ПолучитьАтрибут("value");			
			НакладнаяНомерИД = Новый Структура("НомерНакладной, НакладнаяИД, ДатаОперации, СтанцияНазначения");
			НакладнаяНомерИД.Вставить("НакладнаяИД", НакладнаяИД); 
		КонецЕсли;
		
		Если ЧтениеXML.Имя = "invNumber" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			НомерНакладной = ЧтениеXML.ПолучитьАтрибут("value"); 
			НакладнаяНомерИД.Вставить("НомерНакладной", НомерНакладной); 
			//МассивНакладных.Добавить(НакладнаяНомерИД);	
		КонецЕсли;

		Если ЧтениеXML.Имя = "invoiceLastOper" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			ДатаОперации = ЧтениеXML.ПолучитьАтрибут("value"); 
			
			Попытка
				ПериодНакладной = Дата(Сред(ДатаОперации,7,4) + Сред(ДатаОперации,4,2) + Лев(ДатаОперации,2));
			Исключение  				
				ПериодНакладной = Дата('0001.01.01');
			КонецПопытки;
			
			Если ПериодНакладной < (НачалоМесяца(ТекущаяДата()) - 3600*25*30) Тогда
				продолжить;
			Иначе
			КонецЕсли;  

			
			НакладнаяНомерИД.Вставить("ДатаОперации", ПериодНакладной); 
			//МассивНакладных.Добавить(НакладнаяНомерИД);	
		КонецЕсли;

		
		                                  
		Если ЧтениеXML.Имя = "invToStation" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			СтанцияНазначения = ЧтениеXML.ПолучитьАтрибут("value");
			НакладнаяНомерИД.Вставить("СтанцияНазначения", СтанцияНазначения);
			
			Если ЗначениеЗаполнено(НакладнаяНомерИД.НомерНакладной) и ЗначениеЗаполнено(НакладнаяНомерИД.НакладнаяИД) Тогда
				
				МассивНакладных.Добавить(НакладнаяНомерИД);	
				
			КонецЕсли;
			
			
		КонецЕсли;

		
	КонецЦикла; 
	
	МассивРезультатов = Новый Массив;
	
	
	
	
	Для каждого ЭлМасс из МассивНакладных Цикл
		
		Если не НакладнаяИД = "" Тогда
			ДлительныеОперации.СообщитьПрогресс(, "Загрузка накладной: " + ЭлМасс.НакладнаяИД);
			ЗагрузитьНакладную(Новый Структура("ИДНакладной, НомерНакладной", ЭлМасс.НакладнаяИД,ЭлМасс.НомерНакладной), МассивРезультатов);
		Иначе
			МассивРезультатов.Добавить(Новый Структура("Ссылка, Сообщение", Неопределено, "Накладная " + Строка(ЭлМасс.НомерНакладной) + " не загружена"));
		КонецЕсли;
	КонецЦикла;
	
	ВозвращаемаяСтруктура.Вставить("МассивРезультатов", МассивРезультатов);
				
	ПоместитьВоВременноеХранилище(ВозвращаемаяСтруктура, АдресРезультата);	
	
КонецПроцедуры

