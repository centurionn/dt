Процедура ПодгрузитьНовыеНакладныеНаСервере_СиДата(Знач ДатаНачала = неопределено, Знач ДатаОкончания = неопределено)Экспорт
	
	глЭтран = неопределено;
	глЭтранИдетЗагрузка = Истина;
	НомерТранзакции = 1;
	
	ВсеДокументыЗагрузились = Истина;
	
	Если ДатаНачала = неопределено Тогда
		ДатаНачала = ТекущаяДата() - 6*3600;
	КонецЕсли;
	
	Если ДатаОкончания = неопределено Тогда
		ДатаОкончания = ТекущаяДата();
	КонецЕсли;
	
	Сообщить("Начало запроса ЭТРАН: " + ТекущаяДата());
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("invNumber",Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(8)));
	Таблица.Колонки.Добавить("invoiceID",Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(10)));
	
	ТекстЗапроса = "<invoiceStatus version=""1.0"">
	|<fromDate value=""" + (ДатаНачала -1) + """/>
	|<toDate value=""" + (ДатаОкончания+1) + """/>
	|<useSender/><useRecip/><useOwnerCont/><useTenantCar/><useOwnerCar/><usePayer/><useAll/> 
	|</invoiceStatus>";
	
	РезультатЗапроса = ПолучитьОтветНаЗапрос(ТекстЗапроса);	
	
	РезультатПроверки = ОбработкаОшибокЗапросаДанных(РезультатЗапроса,, ТекстЗапроса, "Запрос статуса накладной"); //Евросиб Гудкова( 04.09.2020 Ticket№ 0205656 
	Если РезультатПроверки.КодОшибки = Неопределено Тогда 
		РезультатЗапроса = РезультатПроверки.РезультатЗапроса;
	Иначе
		
		Если РезультатПроверки.КодОшибки = "1" Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если РезультатЗапроса = Неопределено Тогда                            
		ВсеДокументыЗагрузились = Ложь;
		Возврат;
	КонецЕсли;
	
	// Заполнение Таблицы
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(РезультатЗапроса);
	Строка = Неопределено;
	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.Имя = "invoice" Тогда
			Строка = ?(ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента, Таблица.Добавить(), Неопределено);
		ИначеЕсли ЧтениеXML.Имя = "OperId" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			OperId = ЧтениеXML.ПолучитьАтрибут("value");
			Строка = Неопределено; // на всякий случай
			ЗаписатьНомерПоследнейОперации(OperId,Перечисления.э_ИменаЗапросов.ЗапросСтатусаНакладныхПоПлательщику);				
		ИначеЕсли Строка <> Неопределено Тогда
			Попытка
				Строка[ЧтениеXML.Имя] = ЧтениеXML.ПолучитьАтрибут("value");
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;        
	
	////////////// !!!
	
	Для Каждого Выборка Из Таблица Цикл
		ИДНакладной        = Выборка.invoiceID;
		НомерНакладной    = Выборка.invNumber;
		ТекстЗапроса = "<getInvoice version=""1.0"">
		|<invoiceID value=""" + ИДНакладной + """/>
		|<invNumber value=""" + НомерНакладной + """/>
		|<useMod11/><useValid/>
		|</getInvoice>";
		
		
		РезультатЗапроса = ПолучитьОтветНаЗапрос(ТекстЗапроса);	
		
		//15022018 Добавляем получение кода ошибки
		РезультатПроверки = ОбработкаОшибокЗапросаДанных(РезультатЗапроса,, ТекстЗапроса, "Запрос данных накладной"); //Евросиб Гудкова( 04.09.2020 Ticket№ 0205656 
		Если РезультатПроверки.КодОшибки = Неопределено Тогда 
			РезультатЗапроса = РезультатПроверки.РезультатЗапроса;
		КонецЕсли;
		Если РезультатЗапроса = Неопределено Тогда                            
			ВсеДокументыЗагрузились = Ложь;
			Продолжить;
		КонецЕсли;
				
		Рез = ЗаполнитьДокументНакладная(РезультатЗапроса,ВсеДокументыЗагрузились,НомерНакладной,ДатаНачала,ДатаОкончания,ТекущаяДата());
		
	КонецЦикла;
	
	Сообщить("Конец запроса ЭТРАН: " + ТекущаяДата());
	
	глЭтранИдетЗагрузка = Ложь;
	
КонецПроцедуры

Процедура ПаузаВСекундах(Секунды)
	
	ВремяМС = Секунды * 1000;
	
	Если ВремяМС = 0 Тогда
        Возврат
    КонецЕсли;
    Сигнатура = Формат(ТекущаяДата(), "ДФ=yyyyMMddhhmmss");
    ПутьСкрипта = КаталогВременныхФайлов()+"SleepScript"+Сигнатура+".vbs";
    СкриптФайл = Новый ТекстовыйДокумент;
    СкриптФайл.ДобавитьСтроку("WScript.Sleep("+Формат(ВремяМС, "ЧГ=0")+")");
    СкриптФайл.Записать(ПутьСкрипта, КодировкаТекста.OEM);
    WSHShell = Новый COMОбъект("WScript.Shell");
    WSHShell.Run("wscript.exe """+ПутьСкрипта+"""", 0, Истина);
    УдалитьФайлы(ПутьСкрипта);

	
КонецПроцедуры 

Функция ЗагрузитьНакладруюИзЭТРАНПоНомеру(Номер = "", АдресРезультата = Неопределено) Экспорт
	
	ВозвращаемаяСтруктура = Новый Структура("Ссылка, Сообщение");
		
	НачалоПериода = НачалоДня('00010101');
	КонецПериода = КонецДня('39991231');
	
	
	глЭтранИдетЗагрузка = Истина;
	НомерТранзакции = 1;
	
	ДлительныеОперации.СообщитьПрогресс(, "Подключение к ЭТРАН");
	

	
	НомерНакладной = Номер;
	ТекстЗапроса = "<getInvoice version=""1.0"">
	|<invNumber value=""" + НомерНакладной + """/>
	//|<invoiceID value=""" + НомерНакладной + """/>
	//|<useMod11/><useValid/>
	|<useMod11/>
	|</getInvoice>";
	
	
	ДлительныеОперации.СообщитьПрогресс(, "Отправка запроса в ЭТРАН");
	
	Если Константы.э_ВебСервис.Получить() Тогда
		РезультатЗапроса = ПолучитьОтветНаЗапрос(ТекстЗапроса);	
	Иначе 
		глЭтран = неопределено;
		глЭтран = ПодключитьКЭтранНаСервере();
		РезультатЗапроса = глЭтран.Call(ТекстЗапроса);
	КонецЕсли;
	
	ДлительныеОперации.СообщитьПрогресс(, "Получение ответа от ЭТРАН");
	
	ПозицияОшибки = Найти(РезультатЗапроса,"errorMessage value=");
	Если ПозицияОшибки > 0  Тогда 				
		КонецОшибки  = Найти(РезультатЗапроса,"errorStatusCode value=");
		Если КонецОшибки > 0  Тогда 
			Результат = Сред(РезультатЗапроса,ПозицияОшибки+19,КонецОшибки - ПозицияОшибки - 24);
			ВозвращаемаяСтруктура.Сообщение = Результат;
			ПоместитьВоВременноеХранилище(ВозвращаемаяСтруктура, АдресРезультата);
			Возврат ВозвращаемаяСтруктура;
		КонецЕсли;
	КонецЕсли;
	
	//ПутьКФайлуЛога = ЗаписатьЛогВМодуле("Запрос данных накладной", ТекстЗапроса, РезультатЗапроса,,"Этран");
	
	ЗаписатьЛогЭТРАН("Запрос данных накладной", ТекстЗапроса, РезультатЗапроса,,"Этран");
	
	ДлительныеОперации.СообщитьПрогресс(, "Загрузка накладной: " + НомерНакладной);
	
	Если ЗаполнитьДокументНакладная(РезультатЗапроса,Ложь,НомерНакладной,НачалоПериода,КонецПериода,ТекущаяДата(),, ВозвращаемаяСтруктура.Ссылка) = Истина Тогда
		ВозвращаемаяСтруктура.Сообщение = "Накладная " + НомерНакладной + " загружена";
		ПоместитьВоВременноеХранилище(ВозвращаемаяСтруктура, АдресРезультата);
	КонецЕсли;
	
	Возврат ВозвращаемаяСтруктура;
	
