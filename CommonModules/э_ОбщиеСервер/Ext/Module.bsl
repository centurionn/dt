Процедура ЗагрузитьНакладную(ПараметрыПроцедуры, МассивРезультатов) Экспорт
	
	Если ПараметрыПроцедуры.ИДНакладной = Неопределено  и ПараметрыПроцедуры.НомерНакладной = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ДлительныеОперации.СообщитьПрогресс(, "Подключение к ЭТРАН");
	
	Если не Константы.э_ВебСервис.Получить() Тогда  
		глЭтран = ПодключитьКЭтранНаСервере();
	КонецЕсли;
	
	//Если глЭтран = Неопределено Тогда
	//	МассивРезультатов.Добавить(Новый Структура("Ссылка, Сообщение", Неопределено, "Не удалось подключиться к ЭТРАН"));
	//	Возврат;
	//КонецЕсли;
	
	ТекстЗапроса = "<getInvoice version=""1.0"">";
	Если не ПараметрыПроцедуры.ИДНакладной = Неопределено Тогда 
		ТекстЗапроса = ТекстЗапроса + "
		|<invoiceID value=""" + ПараметрыПроцедуры.ИДНакладной + """/>";
	ИначеЕсли  не ПараметрыПроцедуры.НомерНакладной = Неопределено Тогда 
		ТекстЗапроса = ТекстЗапроса + "
		|<invNumber value=""" + ПараметрыПроцедуры.НомерНакладной + """/>";
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса +"
	|<useMod11/><useValid/>
	|</getInvoice>";
	
	ДлительныеОперации.СообщитьПрогресс(, "Отправка запроса в ЭТРАН");
	
	Если Константы.э_ВебСервис.Получить() Тогда
		РезультатЗапроса = ПолучитьОтветНаЗапрос(ТекстЗапроса);	
	Иначе 
		РезультатЗапроса = глЭтран.Call(ТекстЗапроса);
	КонецЕсли;
	
	//15022018 Добавляем получение кода ошибки
	РезультатПроверки = ОбработкаОшибокЗапросаДанных(РезультатЗапроса,, ТекстЗапроса, "Запрос данных накладной"); //Евросиб Гудкова( 04.09.2020 Ticket№ 0205656      
	Если РезультатПроверки.КодОшибки = Неопределено Тогда 
		РезультатЗапроса = РезультатПроверки.РезультатЗапроса;
	Иначе
		
		Если РезультатПроверки.КодОшибки = "100" Тогда  //100-Код ошибки связи, 0 - прочая ошибка. повторение не требуется
			
			//Повторяем запрос 45  по 180 секунд, около 1,5 часа	
			КоличествоПовторов = 0;
			Пока КоличествоПовторов < 5 Цикл
				ПаузаВСекундах(30);// 0,5 минуты
				Если Константы.э_ВебСервис.Получить() Тогда
					РезультатЗапроса = ПолучитьОтветНаЗапрос(ТекстЗапроса);	
				Иначе 
					РезультатЗапроса = глЭтран.Call(ТекстЗапроса);
				КонецЕсли;
				РезультатПроверки = ОбработкаОшибокЗапросаДанных(РезультатЗапроса,, ТекстЗапроса, "Запрос данных накладной"); //Евросиб Гудкова( 04.09.2020 Ticket№ 0205656      
				Если не РезультатПроверки.КодОшибки = "100" Тогда
					РезультатЗапроса = РезультатПроверки.РезультатЗапроса;	
					Прервать;	
				КонецЕсли;
				КоличествоПовторов = КоличествоПовторов + 1;
			КонецЦикла;  
			
		КонецЕсли; 
		
		//СКА 19102019
		Если РезультатПроверки.КодОшибки = "1" 
			ИЛИ РезультатПроверки.КодОшибки = "0" 
			ИЛИ (РезультатПроверки.КодОшибки = "4" 
				И Не РезультатПроверки.СтатусКод = "407") Тогда // 407 Документ платный, обращаемся к Ритму // SIV 09-12-2020 добавил код ошибки 0
			Возврат;
		КонецЕсли;
		//СКА 19102019
		
		// Рыбьяков К.А 03.05.2024 Ticket#0350495  
		Если РезультатПроверки.СтатусКод = "407" И ЗначениеЗаполнено(ПараметрыПроцедуры.ИДНакладной) Тогда // Документ платный, обращаемся к Ритму
			РезультатЗапроса = ЗапроситьНакладнуюВРИТМе(ПараметрыПроцедуры.ИДНакладной); 					
		КонецЕсли;
