Функция ПодключитьКЭтранНаСервере(Логин = Неопределено,Пароль = Неопределено) 
	
	Если Логин = Неопределено или Пароль = Неопределено тогда
		НастройкиЭтрнан = ПолучитьНастройкиЭТРАН();

		Логин =  НастройкиЭтрнан.Логин;
		Пароль = НастройкиЭтрнан.Пароль;
	КонецЕсли;
	
	
	
	
	Попытка
		глЭтран = Новый COMObject("EtranASUGO.EtranASUGO");
	Исключение
		глЭтран = неопределено;
		//Сообщить("Проблемы с подключением к EtranASUGO(возможно не установлен соответствующий COM объект).");
	КонецПопытки;
	
	Попытка			     
		глЭтран.Connect("http://10.248.35.14:8092/EtranServer/EtranHttpSrvr.dll",Логин,Пароль);
		//Сообщить("Связь с этраном установлена " + ТекущаяДата());
	Исключение
		//Сообщить("Связь с этраном не установлена");
		глЭтран = неопределено;                                             
	КонецПопытки;
	
	Возврат глЭтран;
	
КонецФункции


Функция ПолучитьОтветНаЗапрос(ТекстЗапроса) Экспорт
	
	НастройкиЭтрнан = ПолучитьНастройкиЭТРАН();
	
	ТипПараметраString = ФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema","string");
	Логин  = ФабрикаXDTO.Создать(ТипПараметраString, НастройкиЭтрнан.Логин);
	Пароль = ФабрикаXDTO.Создать(ТипПараметраString, НастройкиЭтрнан.Пароль);
	ЗапросТекст = ФабрикаXDTO.Создать(ТипПараметраString, ТекстЗапроса);

	ОпределениеWSDL = ПолучитьОпределение(НастройкиЭтрнан);
	Если ОпределениеWSDL = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка получения WSDL определения от tsxapp!");
		Возврат "Ошибка подключения к прокси. error";
	КонецЕсли;
	
	Прокси = ПолучитьПрокси(ОпределениеWSDL,НастройкиЭтрнан);
	
	Если Прокси = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка получения прокси!"+ОписаниеОшибки());
		Возврат "Ошибка подключения к прокси. error";
	иначе	
		Попытка
			Результат = Прокси.GetBlockUser(ЗапросТекст,Логин,Пароль);
			Возврат Результат.XMLFromEtran;
		Исключение 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка получения ответа на запрос!"+ОписаниеОшибки());
			Возврат "Ошибка подключения к прокси. error";
		КонецПопытки; 		
	КонецЕсли;

КонецФункции

Функция ПолучитьОпределение(НастройкиЭтрнан)	
	
	Результат = неопределено;
	Попытка
