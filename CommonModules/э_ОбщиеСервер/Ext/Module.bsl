		РезультатЗапроса = глЭтран.Call(ТекстЗапроса);
	КонецЕсли;
	
	ЗаписатьЛогЭТРАН("Запрос статуса накопительной ведомости", ТекстЗапроса, РезультатЗапроса,,"Этран");
	
	// Заполнение Таблицы
