//Евросиб Гудкова( 08.10.2019
//было 		МенеджерЗаписи.Ответ 		   = РезультатЗапроса;
		Сжатие = Новый СжатиеДанных(9);
		МенеджерЗаписи.ОтветСжатый = Новый ХранилищеЗначения(РезультатЗапроса, Сжатие);
// Евросиб Гудкова)
		
		Если Найти(РезультатЗапроса,"error") > 0 Или Ошибка Тогда
