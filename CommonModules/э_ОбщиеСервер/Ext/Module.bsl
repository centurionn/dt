Процедура ЗагрузкаЗаявокПоРегламенту() Экспорт
	
	ПоследняяЗагрузка = Константы.ДатаПоследнейЗагрузкиГУЭТРАН.Получить();
	
	Если НЕ ЗначениеЗаполнено(ПоследняяЗагрузка) Тогда
		ПериодЗапроса = Новый СтандартныйПериод;
		ПериодЗапроса.ДатаНачала = ТекущаяДата();
		ПериодЗапроса.ДатаОкончания = ТекущаяДата();
		ЗаписатьОшибкиЗагрузкиЭТРАН("Регламентное задание по загрузке ГУ-12", "", "", Истина, "Не установлена дата последней успешной загрузки", "", ПериодЗапроса);
		Возврат;
	КонецЕсли;
	
	НачалоЦиклическогоПериода = ПоследняяЗагрузка;
	
	Пока НачалоЦиклическогоПериода < ТекущаяДата() Цикл
		
		НачалоПериодаЗагрузки = НачалоЦиклическогоПериода-2*3600;
		КонецПериодаЗагрузки = НачалоЦиклическогоПериода-1*3600;
		
		СтруктураОтветаЭтран = э_ОбщиеСервер.ПодгрузитьЗаявкиПоПериоду(НачалоПериодаЗагрузки, КонецПериодаЗагрузки, ЛОЖЬ, Истина);
		
		Если СтруктураОтветаЭтран.Количество() = 0 Тогда
			Константы.ДатаПоследнейЗагрузкиГУЭТРАН.Установить(КонецПериодаЗагрузки);
		Иначе
			Прервать;
		КонецЕсли;
		
		НачалоЦиклическогоПериода = НачалоЦиклическогоПериода + 3600;
		
	КонецЦикла;
	
	//НачалоПериодаЗагрузки = ПоследняяЗагрузка-1*3600;
	//КонецПериодаЗагрузки = ПоследняяЗагрузка+1*3600;
	//
	//СтруктураОтветаЭтран = э_ОбщиеСервер.ПодгрузитьЗаявкиПоПериоду(НачалоПериодаЗагрузки, КонецПериодаЗагрузки, ЛОЖЬ, Истина);
	//
	//// перезаписываем дату только если загрузка прошла без ошибок
	//Если СтруктураОтветаЭтран.Количество() = 0 Тогда
	//	Константы.ДатаПоследнейЗагрузкиГУЭТРАН.Установить(КонецПериодаЗагрузки);
	//КонецЕсли;
	
