Процедура СоздатьСсылкиПоРеквизитам(Объект,МакетНастроек) 
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Реквизит");
	Таблица.Колонки.Добавить("Значение");

	Область = МакетНастроек.НайтиТекст("<ЗаполнениеСсылок>",,МакетНастроек.Область("C1"),,Истина);
	Если Область = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаПараметров = Область.Верх;
	Индекс = Область.Верх + 1;
	
	Пока МакетНастроек.Область(Индекс,1).Текст <> "<\ЗаполнениеСсылок>" Цикл
		Если ПустаяСтрока(МакетНастроек.Область(Индекс,1).Текст) Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		
		Если МакетНастроек.Область(Индекс,1).Текст = "<Реквизиты>" Тогда
			Индекс = Индекс + 1;
			Пока МакетНастроек.Область(Индекс,1).Текст <> "<\Реквизиты>" Цикл
				
				РеквизитСсылка = МакетНастроек.Область(Индекс,1).Текст;
				ОбъектПоиска = МакетНастроек.Область(Индекс,2).Текст;
				ТипОбъекта = МакетНастроек.Область(Индекс,3).Текст;
				
				Если ПустаяСтрока(РеквизитСсылка) Или ПустаяСтрока(ОбъектПоиска) Или ПустаяСтрока(ТипОбъекта) Тогда
					Индекс = Индекс + 1;
					Продолжить;
				КонецЕсли;
				
				Попытка
					ТестНаНаличиеРеквизита = Объект[РеквизитСсылка];
					Если ТипОбъекта = "Справочник" Тогда
						ТестНаНаличиеСправочника = Справочники[ОбъектПоиска];
					ИначеЕсли ТипОбъекта = "Документ" Тогда
						ТестНаНаличиеДокумента = Документы[ОбъектПоиска];
					КонецЕсли;
				Исключение
					Индекс = Индекс + 1;
					Продолжить;
				КонецПопытки;
				
				Колонка = 4;
				Пока Не ПустаяСтрока(МакетНастроек.Область(Индекс,Колонка).Текст) Цикл
					Значение = МакетНастроек.Область(Индекс,Колонка).Текст;
					Реквизит = МакетНастроек.Область(Индекс,Колонка + 1).Текст;
					Если Не ПустаяСтрока(Реквизит) И Не ПустаяСтрока(Значение) Тогда
						Строка = Таблица.Добавить();
						Строка.Реквизит = Реквизит;
						ПараметрПреобразования = МакетНастроек.Область(СтрокаПараметров,Колонка).Текст;
						Попытка
							Строка.Значение = Число(Значение);
							Строка.Значение = Значение;
						Исключение

							Строка.Значение = Объект[Значение];
						КонецПопытки;
					КонецЕсли;
					Колонка = Колонка + 2;
				КонецЦикла;
				 
				РезПоискаОбъекта = ПолучитьИлиСоздатьСсылкуНаОбъект(ОбъектПоиска,ТипОбъекта,Таблица);
				
				Если  ЗначениеЗаполнено(РезПоискаОбъекта)Тогда 
					Объект[РеквизитСсылка] = РезПоискаОбъекта;
				КонецЕсли;
				
					
				Таблица.Очистить();

				Индекс = Индекс + 1;
			КонецЦикла;

		ИначеЕсли МакетНастроек.Область(Индекс,1).Текст = "<Таблица>" Тогда
			ТаблицаОбъекта = МакетНастроек.Область(Индекс,2).Текст;
			Индекс = Индекс + 1;
			Если ПустаяСтрока(ТаблицаОбъекта) Тогда
				Продолжить;
			КонецЕсли;
			Пока МакетНастроек.Область(Индекс,1).Текст <> "<\Таблица>" Цикл
				
				РеквизитСсылка = МакетНастроек.Область(Индекс,1).Текст;					
				ОбъектПоиска = МакетНастроек.Область(Индекс,2).Текст;
				ТипОбъекта = МакетНастроек.Область(Индекс,3).Текст;
				
				Если ПустаяСтрока(РеквизитСсылка) Или ПустаяСтрока(ОбъектПоиска) Или ПустаяСтрока(ТипОбъекта) Тогда
					Индекс = Индекс + 1;
					Продолжить;
				КонецЕсли;
				
				Попытка
					Если ТипОбъекта = "Справочник" Тогда
						ТестНаНаличиеСправочника = Справочники[ОбъектПоиска];
					ИначеЕсли ТипОбъекта = "Документ" Тогда
						ТестНаНаличиеДокумента = Документы[Объект];
					КонецЕсли;
				Исключение
					Индекс = Индекс + 1;
					Продолжить;
				КонецПопытки;

				
				Для Каждого СтрокаТаблицы Из Объект[ТаблицаОбъекта] Цикл
					Попытка
						ТестНаНаличиеРеквизита = СтрокаТаблицы[РеквизитСсылка];
					Исключение
						Индекс = Индекс + 1;
						Продолжить;//работает не правильно, если ошибка в реквизите, уходит в вечный цикл
					КонецПопытки;     
						
					Колонка = 4;
					Пока Не ПустаяСтрока(МакетНастроек.Область(Индекс,Колонка).Текст) Цикл
						Значение = МакетНастроек.Область(Индекс,Колонка).Текст;
						Реквизит = МакетНастроек.Область(Индекс,Колонка + 1).Текст;
						Если Не ПустаяСтрока(Реквизит) И Не ПустаяСтрока(Значение) Тогда
							Строка = Таблица.Добавить();
							Строка.Реквизит = Реквизит;
							ПараметрПреобразования = МакетНастроек.Область(СтрокаПараметров,Колонка).Текст;
							Попытка
								Строка.Значение = Число(Значение);
								Строка.Значение = Значение;
							Исключение
								Строка.Значение = СтрокаТаблицы[Значение];
							КонецПопытки;
						КонецЕсли;
						Колонка = Колонка + 2;
					КонецЦикла;
					СтрокаТаблицы[РеквизитСсылка] = ПолучитьИлиСоздатьСсылкуНаОбъект(ОбъектПоиска,ТипОбъекта,Таблица);
					Таблица.Очистить();
				
				КонецЦикла;				
				Индекс = Индекс + 1;
			КонецЦикла;                 
		КонецЕсли;		
		Индекс = Индекс + 1;
	КонецЦикла;
 
КонецПроцедуры

Функция ПолучитьИлиСоздатьСсылкуНаОбъект(Объект,ТипОбъекта,Знач ТаблицаРеквизитов) 

	Если ТаблицаРеквизитов <> Неопределено Тогда
		
		Если ТаблицаРеквизитов.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		// Если хотябы один из ключевых реквизитов не заполнен, тогда выходим
		Для Каждого Строка Из ТаблицаРеквизитов Цикл
			Если Не ЗначениеЗаполнено(Строка.Значение) Тогда
				Возврат Неопределено;
			КонецЕсли;		
		КонецЦикла;
		
		ТаблицаРеквизитов = ПреобразоватьТипыПоискаКТипамРеквизитов(Объект,ТипОбъекта,ТаблицаРеквизитов);

		Ссылка = НайтиПоРеквизитам(ТипОбъекта,Объект,ТаблицаРеквизитов);

		Если Ссылка <> Неопределено Тогда
			Возврат Ссылка;		
		КонецЕсли;
	
	КонецЕсли;
	
	Если ТипОбъекта = "Справочник" Тогда
		НовыйОбъект = ЗагрузитьОднуЗапись(Объект, ТаблицаРеквизитов, истина);
	ИначеЕсли ТипОбъекта = "Документ" Тогда
		//НовыйОбъект = Документы[Объект].ЗагрузитьДокумент(ТаблицаРеквизитов[0].Значение);
	КонецЕсли;

	Возврат НовыйОбъект;

КонецФункции

Функция ПреобразоватьТипыПоискаКТипамРеквизитов(Объект,ТипОбъекта,ТаблицаРеквизитов)
	
	Если ТаблицаРеквизитов = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипОбъекта = "Справочник" Тогда
		
		Справочник = Справочники[Объект].СоздатьЭлемент();

		Для Каждого Строка Из ТаблицаРеквизитов Цикл
			Если ТипЗнч(Справочник[Строка.Реквизит]) = Тип("Число") Тогда
				Строка.Значение = Число(Строка.Значение);
			ИначеЕсли ТипЗнч(Справочник[Строка.Реквизит]) = Тип("Строка") Тогда
				Строка.Значение = Формат(Строка.Значение,"ЧГ=0");
			КонецЕсли;			
		КонецЦикла;
		
	ИначеЕсли ТипОбъекта = "Документ" Тогда
		
		Документ = Документы[Объект].СоздатьДокумент();

		Для Каждого Строка Из ТаблицаРеквизитов Цикл
			Если ТипЗнч(Документ[Строка.Реквизит]) = Тип("Число") Тогда
				Строка.Значение = Число(Строка.Значение);
			ИначеЕсли ТипЗнч(Документ[Строка.Реквизит]) = Тип("Строка") Тогда
				Строка.Значение = Формат(Строка.Значение,"ЧГ=0");
			КонецЕсли;			
		КонецЦикла;

	КонецЕсли;
	
	Возврат ТаблицаРеквизитов;
	
КонецФункции

//ТипОбъекта	(Строка)	,например "Справочник"
//Объект		(Строка)	,например "Валюты"
//Таблица, содержет колонки:
//	Реквизит		(Строка)    ,например "Код"
//	Значение		(?)			,например 94
//Возвращает Ссылку на объект или Неопределено
Функция НайтиПоРеквизитам(ТипОбъекта, Объект, Таблица) 

	Если ТипОбъекта = "" Или Объект = "" Или Таблица = Неопределено Или Таблица.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ " + Объект + ".Ссылка ИЗ " + ТипОбъекта + "." + Объект + " КАК " + Объект + " ГДЕ";
	ТекстУсловия = "";
	Индекс = 0;
	Для Каждого Строка Из Таблица Цикл
		//Евросиб Каблов 21.04.2021 ( Ticket#0227855
		//ТекстУсловия = ТекстУсловия + " И " + Объект + "." + Строка.Реквизит +" = &Значение" + Индекс;// +" И " + Объект + ".ПометкаУдаления = ЛОЖЬ";
		Если Объект = "э_Станции" И Строка.Реквизит = "Код" Тогда
			ТекстУсловия = ТекстУсловия + " И ПОДСТРОКА(" + Объект + "." + Строка.Реквизит +", 1, 5) = &Значение" + Индекс;
			Строка.Значение = Лев(Строка.Значение, 5);
		Иначе
			ТекстУсловия = ТекстУсловия + " И " + Объект + "." + Строка.Реквизит +" = &Значение" + Индекс;// +" И " + Объект + ".ПометкаУдаления = ЛОЖЬ";
		КонецЕсли;
		//Евросиб Каблов 21.04.2021 )
		Запрос.УстановитьПараметр("Значение" + Индекс, Строка.Значение);
		Индекс = Индекс + 1;
	КонецЦикла;
	Запрос.Текст = Запрос.Текст + Сред(ТекстУсловия,3);
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() = 0 Тогда
		Возврат Неопределено;
	Иначе
		Возврат Результат[0].Ссылка;
	КонецЕсли;
	
КонецФункции

Функция ЗаменитьСимволыXML(Знач СтрокаXML)
	СоотвествиеЗамещаемыеСимволыXML = Новый Соответствие;
	СоотвествиеЗамещаемыеСимволыXML.Вставить("&#28;", "(");
	СоотвествиеЗамещаемыеСимволыXML.Вставить("&#2;", " ");
	СоотвествиеЗамещаемыеСимволыXML.Вставить("&#26;", " ");
	 
	Для Каждого КлючЗначение Из СоотвествиеЗамещаемыеСимволыXML Цикл
		СтрокаXML = СтрЗаменить(СтрокаXML, КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	
	Возврат СтрокаXML;
КонецФункции


