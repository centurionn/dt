			|<OperId value=""999999999999999""/>";
		Иначе
			ТекстЗапроса = ТекстЗапроса + 
			"
			|<OperId value="""+operid+"""/>"; 
		КонецЕсли;
		
		// use вообще все
		//|<usePayer/><useViza/><useSpoil/><useSending/><useArrive/><useDelivery/><useSpoilDelivery/><useSender/><useStation/><usePort/>
		//|<useRecip/> 
		ТекстЗапроса = ТекстЗапроса + 
		"
		|<useSender/><useRecip/><useOwnerCont/><useTenantCar/><useOwnerCar/><usePayer/><useAll/> 
		|</invoiceStatus>";
		НачалоПериода = КонецПериода+1;		            
		
		Если Константы.э_ВебСервис.Получить() Тогда
			РезультатЗапроса = ПолучитьОтветНаЗапрос(ТекстЗапроса);	
