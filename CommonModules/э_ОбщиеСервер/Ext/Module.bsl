#Область РаботаСОчередью
//важная функция, все запросы не с сервера обрабатываются через эту процедуру
Процедура ПоместитьЗапросВОчередь(ТипЗапроса,ТекстЗапроса,Документ=Неопределено) Экспорт
	
	НаборЗаписей = РегистрыСведений.э_ОчередьЗапросовКЭтрану.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Пользователь.Установить(ПараметрыСеанса.ТекущийПользователь);
	НаборЗаписей.Отбор.ТипЗапроса.Установить(ТипЗапроса);
	НаборЗаписей.Отбор.Документ.Установить(Документ);
	Запись = НаборЗаписей.Добавить();
    Запись.ДатаЗаписи = ТекущаяДата();
