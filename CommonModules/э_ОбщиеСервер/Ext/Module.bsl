				ТаблицаРеквизитов.Очистить();
				Стр = ТаблицаРеквизитов.Добавить();
				Стр.Реквизит = СтрокаСсылка.РеквизитПоиска;
				РеквизитСсылка = СтрокаСсылка.РеквизитСсылка;
				Стр.Значение = Строка[РеквизитСсылка];				
