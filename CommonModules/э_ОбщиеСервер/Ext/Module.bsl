Функция ПроверитьЕТСНГПорожний(СправочникЕТСНГ) Экспорт
	Если НЕ ЗначениеЗаполнено(СправочникЕТСНГ) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Связь_ЭТРАН_DC_Сопоставление.СпрДатакор КАК СпрДатакор
	|ИЗ
	|	РегистрСведений.Связь_ЭТРАН_DC_Сопоставление КАК Связь_ЭТРАН_DC_Сопоставление
	|ГДЕ
	|	Связь_ЭТРАН_DC_Сопоставление.СпрЭтрана = &СпрЭтан";
	Запрос.УстановитьПараметр("СпрЭтан",СправочникЕТСНГ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НайденыйСправочник = Выборка.СпрДатакор;
	КонецЦикла;
	
	Если НайденыйСправочник <> Неопределено Тогда
		Если НайденыйСправочник.ПорожнийВагон ИЛИ НайденыйСправочник.ПорожнийКТК Тогда 
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
