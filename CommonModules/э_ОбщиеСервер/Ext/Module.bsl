#Область ЗагрузкаСправочников


Функция НайтиЭлементСправочникаОбщиеПоказатели(Код, ИдентификаторПараметра) 
	
	  Запрос = Новый Запрос;
	  Запрос.Текст = "ВЫБРАТЬ
	  |	э_ОбщиеПоказатели.Ссылка
	  |ИЗ
	  |	Справочник.э_ОбщиеПоказатели КАК э_ОбщиеПоказатели
	  |ГДЕ
	  |	э_ОбщиеПоказатели.Код = &Код
	  |	И э_ОбщиеПоказатели.ИдентификаторПараметра = &ИдентификаторПараметра";
	  
	  Запрос.УстановитьПараметр("Код", Число(Код));
	  Запрос.УстановитьПараметр("ИдентификаторПараметра", Число(ИдентификаторПараметра));
	  
	  Результат = Запрос.Выполнить();
	  Выборка = Результат.Выбрать();
	  
	  Пока Выборка.Следующий() Цикл
	  
	  	   Возврат Выборка.Ссылка;
	  
	  КонецЦикла;
	  
	  
	  Возврат Неопределено;
	  
КонецФункции

Функция ЗагрузитьОднуЗапись(Справочник, Знач ТаблицаРеквизитов, УдалятьЕслиНезаполнен=Ложь, СписокРеквизитовОбъекта = Неопределено) Экспорт
	
	Если ТаблицаРеквизитов = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТаблицаРеквизитов.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	
	// Если хотябы один из ключевых реквизитов не заполнен, тогда выходим
	Для Каждого Строка Из ТаблицаРеквизитов Цикл
		Если Не ЗначениеЗаполнено(Строка.Значение) Тогда
			Возврат Неопределено;
		КонецЕсли;		
	КонецЦикла;
		
	ТаблицаРеквизитов = ПреобразоватьТипыПоискаКТипамРеквизитов(Справочник,"Справочник",ТаблицаРеквизитов);
	
	Попытка
		Макет = Обработки.э_Макеты.ПолучитьМакет(Справочник);
		Область = Макет.НайтиТекст("<ТаблицаНСИ>",,Макет.Область("C1"),,Истина);
	Исключение
		//Сообщить("Макет настроек не найден: " + Справочник);
		Возврат Неопределено;
	КонецПопытки;
	Если Область = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ЗапрашиваемаяТаблица 	= Макет.Область(Область.Верх, 2).Текст;
	//ПолеИД 					= Макет.Область(Область.Верх + 1,1).Текст;
	Если ПустаяСтрока(ЗапрашиваемаяТаблица) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Область = Макет.НайтиТекст("<Реквизиты>",,Макет.Область("C1"),,Истина);
	Если Область = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;	
	ТаблицаР = ТаблицаРеквизитов.Скопировать();
	Если ТаблицаР.Колонки.Найти("ПолеТаблицы") = Неопределено Тогда
		ТаблицаР.Колонки.Добавить("ПолеТаблицы");
		Индекс = Область.Верх + 1;
		Пока Макет.Область(Индекс, 1).Текст <> "<\Реквизиты>" Цикл
			
			Реквизит = Макет.Область(Индекс, 2).Текст;
			Строка = ТаблицаР.Найти(Реквизит, "Реквизит");
			Если  Строка <> Неопределено Тогда
				Строка.ПолеТаблицы = Макет.Область(Индекс, 1).Текст;
			КонецЕсли;
			
			Индекс = Индекс + 1;
		КонецЦикла;
	ИначеЕсли ТаблицаР.Колонки.Найти("Реквизит") = Неопределено Тогда
		ТаблицаР.Колонки.Добавить("Реквизит");
		Индекс = Область.Верх + 1;
		Пока Макет.Область(Индекс, 1).Текст <> "<\Реквизиты>" Цикл
			
			ПолеТаблицы = Макет.Область(Индекс, 1).Текст;
			Строка = ТаблицаР.Найти(ПолеТаблицы, "ПолеТаблицы");
			Если  Строка <> Неопределено Тогда
				Строка.Реквизит = Макет.Область(Индекс, 2).Текст;
			КонецЕсли;
			
			Индекс = Индекс + 1;
		КонецЦикла;
	КонецЕсли;

	РезультатЗапроса = ПолучитьОднуЗапись(ЗапрашиваемаяТаблица,ТаблицаР);
	
	Таблица = XMLВТаблицуОднаЗапись(РезультатЗапроса,Макет);
	Спр = Неопределено;
	Если Таблица.Количество() <> 0 Тогда
		//Спр = Справочники[Справочник].НайтиПоКоду(Строка.Код);
		Спр = НайтиПоРеквизитам("Справочник", Справочник, ТаблицаР);
		Если Спр = Неопределено Тогда
			Спр = Справочники[Справочник].СоздатьЭлемент();
		Иначе
			
			Если Не СписокРеквизитовОбъекта = Неопределено Тогда
				Спр = СписокРеквизитовОбъекта;
			Иначе
				Спр = Спр.ПолучитьОбъект();
				Спр.УстановитьПометкуУдаления(Ложь);
			КонецЕсли;
			
		КонецЕсли;
		  		   
		ЗаполнитьЗначенияСвойств(Спр, Таблица[0]);
		Если СписокРеквизитовОбъекта = Неопределено Тогда
		Для каждого Колонка из Таблица.Колонки Цикл
			Если ОбщегоНазначения.ЕстьРеквизитОбъекта(Колонка.Имя, Спр.Метаданные()) Тогда
				Если Спр.Метаданные().Реквизиты[Колонка.Имя].Тип = Новый ОписаниеТипов("Булево")  Тогда
					Спр[Колонка.Имя] = Булево(Число(Таблица[0][Колонка.Имя]));
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
		КонецЕсли;
		
		Если Справочник = "э_Вагоны" Тогда
			
			Спр = ПолучитьСоздатьСобственниковАрендаторов(Спр,СписокРеквизитовОбъекта);
			
		КонецЕсли;
		
		
		/////////////////////////////////////////
		// Надо сделать правильно
		Попытка
			Если Спр.RECDATEEND > '30000101' Тогда
				Спр.RECDATEEND ='30000101';
			КонецЕсли;
		Исключение
		КонецПопытки;
		Попытка
			Если Спр.ДатаВыводаИзДействия > '30000101' Тогда
				Спр.ДатаВыводаИзДействия ='30000101';
			КонецЕсли;
		Исключение
		КонецПопытки;

		//////////////////////////////////////////
		Если СписокРеквизитовОбъекта = Неопределено Тогда
			попытка
				Спр.Записать();
			исключение
			КонецПопытки;
			Спр = Спр.Ссылка;
		КонецЕсли;
	Иначе
		Если УдалятьЕслиНезаполнен Тогда
			Спр = НайтиПоРеквизитам("Справочник", Справочник, ТаблицаР);
			Если Спр <> Неопределено Тогда
				Спр = Справочник.ПолучитьОбъект();
				Спр.УстановитьПометкуУдаления(Истина);
                Спр.Записать();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Спр;
	
КонецФункции

Функция ПолучитьОднуЗапись(Справочник,ТаблицаРеквизитов) 
	
	Если ТаблицаРеквизитов = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	Если ТаблицаРеквизитов.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЕстьКолонкаУсловие = ТаблицаРеквизитов.Колонки.Найти("Условие")<>Неопределено;
	//Добавляем условие на запрос вагонов, так как данные беруться из другой НСИ
	
	ТекстЗапроса 	= "<getNSI> <tableName value=""" + Справочник +"""/>";  
		
		ПоляОтбора 		= "";
		УсловияОтбора   = "";
		ЗначенияОтбора 	= "";
		Для Каждого Строка Из ТаблицаРеквизитов Цикл
			Если Строка.ПолеТаблицы = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			ПоляОтбора 		= ПоляОтбора + "," + Строка.ПолеТаблицы;
			Если ЕстьКолонкаУсловие Тогда
				УсловияОтбора	= УсловияОтбора + ?(Строка.Условие=Неопределено,",=",","+Строка.Условие);
			Иначе
				УсловияОтбора	= УсловияОтбора + ",=";
			КонецЕсли;
			
			ЗначенияОтбора	= ЗначенияОтбора + "," + Формат(Строка.Значение,"ЧГ=0");		
		КонецЦикла;
		
		ПоляОтбора 		= "<filterField value=""" + Сред(ПоляОтбора, 2) + """/>";
		УсловияОтбора 	= "<filterCond value=""" + Сред(УсловияОтбора, 2) + """/>";	
		//ЗначенияОтбора 	= "<filterValue value=""" + Сред(ЗначенияОтбора, 2) + """/>";
		
		Если Справочник = "STATION" или Справочник = "FREIGHT" или Справочник = "GNG_FREIGHT_2001"  Тогда
			ЗначенияОтбора 	= "<filterValue value=""" + Лев(Сред(ЗначенияОтбора, 2),5) + """/>";			
		Иначе
			ЗначенияОтбора 	= "<filterValue value=""" + Сред(ЗначенияОтбора, 2) + """/>"; 			
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + ПоляОтбора + УсловияОтбора + ЗначенияОтбора + "<useMod11/></getNSI>";
		
		Если Справочник = "car" Тогда
			Возврат Неопределено;
			ТекстЗапроса 	= "<getCarNSI version=""1.0""> <car> <carNumber value=""" +Строка.Значение+ """/> </car><useCond/></getCarNSI>";
		КонецЕсли;
		
		Если Справочник = "OrgPassport" Тогда
			ТекстЗапроса 	= "<getOrgPassport version=""1.0""><orgOKPO value=""" +Строка.Значение+ """/> </getOrgPassport>";
		КонецЕсли;

		Если Справочник = "cont" Тогда
			Возврат Неопределено;
			ТекстЗапроса 	= "<getCotnNSI version=""1.0""> <cont> <contNumber value=""" +Строка.Значение+ """/> </cont><useLocalNsi/></getContNSI>";
		КонецЕсли;             

		
		

	
	Возврат ЗапросДанных(Справочник,ТекстЗапроса,);
	
	
КонецФункции

Функция ПолучитьСоздатьСобственниковАрендаторов(Спр,СписокРеквизитовОбъекта)
	
	Если ЗначениеЗаполнено(Спр.СобственникИД) Тогда 
		СпрОб = Справочники.э_СобственникиАрендаторыВагонов.НайтиПоКоду(Спр.СобственникИД);
		Если ЗначениеЗаполнено(СпрОб) Тогда
//Евросиб Гудкова( 03.01.2021 Ticket№ 0218255
		Если СпрОб.Наименование <> СократитьНазваниеЮрЛица(Спр.СобственникНаименование)
			ИЛИ СпрОб.ОКПО <> Спр.СобственникОКПО Тогда
			СпрОб.ПолучитьОбъект();
			СпрОб.Наименование = СократитьНазваниеЮрЛица(Спр.СобственникНаименование);
			СпрОб.ОКПО = Спр.СобственникОКПО;
			СпрОб.Записать();
		КонецЕсли; 
// Евросиб Гудкова) 			
		ИначеЕсли ЗначениеЗаполнено(Спр.СобственникНаименование) Тогда
			СпрСоб = Справочники.э_СобственникиАрендаторыВагонов.СоздатьЭлемент();	
			СпрСоб.Код = Спр.СобственникИД;
			СпрСоб.Наименование = СократитьНазваниеЮрЛица(Спр.СобственникНаименование);
			СпрСоб.ОКПО = Спр.СобственникОКПО;  
			СпрСоб.Записать();
		КонецЕсли;
	
		Если СписокРеквизитовОбъекта = Неопределено тогда
			Спр.Собственник =  СпрОб;
		КонецЕсли;
		
	КонецЕсли;	
		
	Если ЗначениеЗаполнено(Спр.АрендаторИД) Тогда
		СпрАр = Справочники.э_СобственникиАрендаторыВагонов.НайтиПоКоду(Спр.АрендаторИД);
		Если ЗначениеЗаполнено(СпрАр) Тогда
//Евросиб Гудкова( 03.01.2021 Ticket№ 0218255
		Если СпрАр.Наименование <> СократитьНазваниеЮрЛица(Спр.АрендаторНаименование)
			ИЛИ СпрАр.ОКПО <> Спр.АрендаторОКПО Тогда
			СпрАр.ПолучитьОбъект();
			СпрАр.Наименование = СократитьНазваниеЮрЛица(Спр.АрендаторНаименование);
			СпрАр.ОКПО = Спр.АрендаторОКПО;
			СпрАр.Записать();
		КонецЕсли; 
// Евросиб Гудкова) 			
		ИначеЕсли ЗначениеЗаполнено(Спр.АрендаторНаименование) Тогда
			СпрАр = Справочники.э_СобственникиАрендаторыВагонов.СоздатьЭлемент();		
			СпрАр.Код = Спр.АрендаторИД;
			СпрАр.Наименование = СократитьНазваниеЮрЛица(Спр.АрендаторНаименование);
			СпрАр.ОКПО = Спр.АрендаторОКПО;
			СпрАр.Записать();
		КонецЕсли;
		
		Если СписокРеквизитовОбъекта = Неопределено тогда
			Спр.Арендатор =  СпрАр;
		КонецЕсли;
		
		
	КонецЕсли;
	
	Если не  Спр.МодельВагонаНаименование = "" Тогда 
		СпрОб = Справочники.э_МоделиВагонов.НайтиПоНаименованию(Спр.МодельВагонаНаименование);
		Если ЗначениеЗаполнено(СпрОб) Тогда
		Иначе
			СпрСоб = Справочники.э_МоделиВагонов.СоздатьЭлемент();	
			СпрСоб.Наименование = Спр.МодельВагонаНаименование;
			СпрСоб.Записать();
		КонецЕсли;
		
		Если СписокРеквизитовОбъекта = Неопределено тогда
			Спр.МодельВагона =  СпрОб;
		КонецЕсли;
		
	КонецЕсли;		

	
	
	
	Возврат Спр;
	
КонецФункции

Функция СократитьНазваниеЮрЛица(НаименованиеЮрЛица)
	
	ДлиннаНаименованиеЮрЛица = СтрДлина(НаименованиеЮрЛица);
	
	Если Лев(НаименованиеЮрЛица,40) = "общество с ограниченной ответственностью" Тогда
		 НаименованиеЮрЛица = Сред(НаименованиеЮрЛица, 41,ДлиннаНаименованиеЮрЛица-41);  
	КонецЕсли;	
	
	Возврат НаименованиеЮрЛица;
		
КонецФункции

Процедура ЗагрузитьВсеЗаписи(Справочник) Экспорт
	
	
	
	Попытка
		Выборка = Справочники[Справочник].Выбрать(); 
		Макет = Обработки.э_Макеты.ПолучитьМакет(Справочник);
	Исключение
		Возврат;
	КонецПопытки;

	//Пока Выборка.Следующий() Цикл
	//	Если Выборка.ПометкаУдаления или Выборка.Предопределенный Тогда
	//	Иначе 
	//		Объект = Выборка.ПолучитьОбъект();
	//		Объект.УстановитьПометкуУдаления(Истина);
	//		Объект.Записать();
	//	КонецЕсли;
	//КонецЦикла;


	Область = Макет.НайтиТекст("<ТаблицаНСИ>",,Макет.Область("C1"),,Истина);
	Если Область = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗапрашиваемаяТаблица 	= Макет.Область(Область.Верх, 2).Текст;
	ПолеИД					= Макет.Область(Область.Верх + 1, 1).Текст;
	ПолеИНД					= Макет.Область(Область.Верх + 2, 1).Текст;
	
	Попытка
		МаксимальноеЗначение= Число(Макет.Область(Область.Верх + 2, 2).Текст);
		Шаг = Число(Макет.Область(Область.Верх + 2, 3).Текст); 
		ЗагрузитьВсеЗаписи = Ложь;
	Исключение
		МаксимальноеЗначение = 2;
		Шаг = 200;
		ЗагрузитьВсеЗаписи = Истина;
	КонецПопытки;
	
	Если ПустаяСтрока(ЗапрашиваемаяТаблица) Тогда
		Возврат;
	ИначеЕсли ПустаяСтрока(ПолеИНД) Тогда
		МаксимальноеЗначение = 2;
		Шаг = 200;
		ЗагрузитьВсеЗаписи = Истина;
		Если ПустаяСтрока(ПолеИД) Тогда
			Возврат;
		КонецЕсли;
		ПолеИНД = ПолеИД;
	КонецЕсли;
	
	Область = Макет.НайтиТекст("<Реквизиты>",,Макет.Область("C1"),,Истина);
	Если Область = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	Реквизит = Неопределено;
	Индекс = Область.Верх + 1;
	Пока Макет.Область(Индекс, 1).Текст <> "<\Реквизиты>" Цикл
		Если Макет.Область(Индекс, 1).Текст = ПолеИД Тогда
			Реквизит = Макет.Область(Индекс, 2).Текст;
			Прервать;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Если Реквизит = Неопределено Тогда
		Возврат;
	КонецЕсли;	

	КонецДиапазона = -1;
	Пока 1 Цикл
		НачалоДиапазона = КонецДиапазона + 1;
		КонецДиапазона = НачалоДиапазона + Шаг;
		Если НачалоДиапазона > МаксимальноеЗначение Тогда
			Прервать;
		КонецЕсли;
		Если КонецДиапазона > МаксимальноеЗначение Тогда
			КонецДиапазона = МаксимальноеЗначение;
		КонецЕсли;
		РезультатЗапроса = Неопределено;
		КоличествоПопыток = 0;
		//ОбработкаПрерыванияПользователя();
		Пока РезультатЗапроса = "Ошибка подключения к прокси. error"
			ИЛИ РезультатЗапроса = Неопределено
			И КоличествоПопыток < 3 Цикл  
			КоличествоПопыток = КоличествоПопыток + 1;
			РезультатЗапроса = ПолучитьДиапазонЗаписей(ЗапрашиваемаяТаблица,ПолеИНД,НачалоДиапазона,КонецДиапазона,ЗагрузитьВсеЗаписи);  				
		КонецЦикла;
		
		Таблица = XMLВТаблицу(РезультатЗапроса,Макет);
		
		Для Каждого Строка Из Таблица Цикл
			
			
			Если Справочник =  "э_ОбщиеПоказатели"  Тогда
				Спр = НайтиЭлементСправочникаОбщиеПоказатели(Строка.Код, Строка.ИдентификаторПараметра);
			Иначе
				
				Попытка   					             
					Спр = Справочники[Справочник].НайтиПоКоду(Строка.Код);
				Исключение   					
					Спр = Неопределено;	
				КонецПопытки;

				
				Попытка
					Спр = ?(ЗначениеЗаполнено(Спр), Спр, Справочники[Справочник].НайтиПоРеквизиту(Реквизит, Строка[Реквизит])); 
				Исключение
					Спр = Неопределено;	
				КонецПопытки;
				
			КонецЕсли;
			
		
			Если Спр = Неопределено или не ЗначениеЗаполнено(Спр)Тогда
				Спр = Справочники[Справочник].СоздатьЭлемент();
			Иначе
				Спр = Спр.ПолучитьОбъект();
				Спр.УстановитьПометкуУдаления(Ложь);
			КонецЕсли;			
			
			ЗаполнитьЗначенияСвойств(Спр, Строка);
			
			/////////////////////////////////////////
			// Надо сделать правильно
			Попытка
				Если Спр.RECDATEEND > '30000101' Тогда
					Спр.RECDATEEND ='30000101';
				КонецЕсли;
			Исключение
				    
			КонецПопытки;
			//////////////////////////////////////////
			
			
			Попытка
				Спр.Записать();
				
			Исключение
			Сообщить("Не загружен справочник: " + Спр + " Справочник: " + Справочник + " " + ОписаниеОшибки());	
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЦикла;	
	
КонецПроцедуры
// Функция получает диапазон записей справочника из Этран
Функция ПолучитьДиапазонЗаписей(ЗапрашиваемаяТаблица,ПолеОтбора,НачалоДиапазона,КонецДиапазона,ВсеЗаписи = Ложь) 
	
	ТекстЗапроса = "<getNSI><tableName value=""" + ЗапрашиваемаяТаблица +"""/>";
	Если Не ВсеЗаписи Тогда
		//ТекстЗапроса = ТекстЗапроса + "<filterField value=""" + ПолеОтбора + "," + ПолеОтбора + """/> <filterCond value=""&gt;,&lt;""/><filterValue value=""" + НачалоДиапазона + "," + КонецДиапазона + """/>";
		
		ТекстЗапроса = ТекстЗапроса + "<filterField value=""" + ПолеОтбора + "," + ПолеОтбора + """/> <filterCond value=""&gt;,&lt;""/><filterValue value=""" + СтрЗаменить(Строка(НачалоДиапазона),Символы.НПП,"") + "," + СтрЗаменить(Строка(КонецДиапазона),Символы.НПП,"") + """/>";
		
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "<useMod11/></getNSI>";
	
	РезультатЗапроса = ЗапросДанных(ЗапрашиваемаяТаблица,ТекстЗапроса,);
	
	Возврат РезультатЗапроса;
	
КонецФункции

// Процедура обновляет все справочники из Этрана
Процедура ЗагрузитьВсеСправочникиНаСервере(ПараметрыПроцедуры, АдресРезультата = Неопределено) Экспорт  	
	
	Макеты  		= ПолучитьНаименованиеМакетовВсехСправочников();
	МассивСообщений = Новый Массив;
	
	Если Макеты.количество() <> 0 Тогда
		Для Каждого СправочникНСИ из Макеты Цикл
			ДлительныеОперации.СообщитьПрогресс(, "Загрузка справочника: " + СправочникНСИ);
			ЗагрузитьВсеЗаписи(СправочникНСИ);			  
		КонецЦикла;
	иначе
		МассивСообщений.Добавить("Нет макетов справочников!");  		
	КонецЕсли;        
	
	МассивСообщений.Добавить("Обновление справочников НСИ завершена");
	
	ПоместитьВоВременноеХранилище(МассивСообщений, АдресРезультата);

КонецПроцедуры

Функция ПолучитьНаименованиеМакетовВсехСправочников()  
	
	Результат = Новый Массив;
	
	Макет = Обработки.э_Макеты.ПолучитьМакет("э_СправочникиНСИ");
	Область = Макет.НайтиТекст("<СправочникиНСИ>",,Макет.Область("C1"),,Истина);
	Если Область = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Индекс = Область.Верх + 1;
	
	Пока Макет.Область(Индекс,1).Текст <> "<\СправочникиНСИ>" Цикл
		
		СправочникНСИ 	= Макет.Область(Индекс, 1).Текст;
		Если Не ПустаяСтрока(СправочникНСИ) Тогда
			Результат.Добавить(СправочникНСИ);
		Иначе
			прервать;
		КонецЕсли;
		
		Индекс = Индекс + 1;
		
	КонецЦикла;

	Возврат Результат;
			
КонецФункции	

Процедура ЗагрузитьДанныеПоВагонуИзЭтран(ПараметрыПроцедуры, АдресРезультата = Неопределено) Экспорт
	
	Результат = Неопределено;
	
	Для Каждого НомерВагона Из ПараметрыПроцедуры.НомераВагонов Цикл
		Если СтрДлина(НомерВагона) = 8 тогда
			
			Таблица = Новый ТаблицаЗначений;
			Таблица.Колонки.Добавить("Реквизит");
			Таблица.Колонки.Добавить("Значение");
			
			СтрокаТ = Таблица.Добавить();
			СтрокаТ.Реквизит = "Код";
			СтрокаТ.Значение = НомерВагона;
			
			ДлительныеОперации.СообщитьПрогресс(, "Загрузка данных по вагону: " + НомерВагона);
			
			Результат = ЗагрузитьОднуЗапись("э_Вагоны",Таблица,,ПараметрыПроцедуры.СписокРеквизитовОбъекта);
			
		КонецЕсли;
	КонецЦикла;
	
	Попытка
		ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	Исключение
		ЗаписьЖурналаРегистрации("ЗагрузкаДанныхПоВагонуИзЭТРАН", УровеньЖурналаРегистрации.Ошибка,,, "Невозможно поместить в хранилище тип значения: " + Строка(ТипЗнч(Результат)));
	КонецПопытки;
	
КонецПроцедуры

