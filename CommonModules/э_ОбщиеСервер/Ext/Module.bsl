Функция ОтобратьДанные(МассивНакладных)
	
	    МассивДанныхОтбор = Неопределено;
	
		ДатаНак  =   Дата('0001.01.01');
		Для каждого СтрокаМас из МассивНакладных Цикл 
			Если (СтрокаМас.СтанцияНазначения = "98000" или СтрокаМас.СтанцияНазначения = "98010" или СтрокаМас.СтанцияНазначения = "98020") И ЗначениеЗаполнено(СтрокаМас.ДатаОперации) Тогда
  				Если СтрокаМас.ДатаОперации> ДатаНак Тогда
					МассивДанныхОтбор = Новый Массив;
					ДатаНак = СтрокаМас.ДатаОперации;
					МассивДанныхОтбор.Добавить(СтрокаМас);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Возврат МассивДанныхОтбор;
	
	
КонецФункции

Функция ЗаполнитьДокументЗаявкаНаПеревозкуПриВыгрузке(РезультатЗапроса,ВсеДокументыЗагрузились,НомерЗаявки,НачалоПериода,КонецПериода,ТекущаяДата,Документ)Экспорт
			
	ЗапросОбщиеПоказатели = Новый Запрос;
	ЗапросОбщиеПоказатели.Текст = "ВЫБРАТЬ Ссылка ИЗ Справочник.э_ОбщиеПоказатели ГДЕ Наименование = &Наименование И ИдентификаторПараметра = &ИдентификаторПараметра";
	ПустаяСсылкаОбщиеПоказатели = Справочники.э_ОбщиеПоказатели.ПустаяСсылка();
	
	МакетНастроек = Обработки.э_Макеты.ПолучитьМакет("э_ЗаявкаНаПеревозку");
	
	Соответствие = ПолучитьСоответствиеТаблицОбъекта(МакетНастроек);
	СоответствиеПеревод = ПолучитьСоответствиеПереводРеквизитовОбъекта(МакетНастроек);
	ЗаполнитьОбъектИзXML(Документ,Соответствие,СоответствиеПеревод,РезультатЗапроса);
	СоздатьСсылкиПоРеквизитам(Документ,МакетНастроек);
		
	Ошибки = "";
	Если Найти(РезультатЗапроса,"<warning>") > 0 Тогда
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(РезультатЗапроса);		
		Пока ЧтениеXML.Прочитать() Цикл
			Если ЧтениеXML.Имя = "warning" Тогда
				Ошибки = ЧтениеXML.ПолучитьАтрибут("value");			
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Документ.Дата =  Документ.ДатаРегистрации;//Документ.claimRegDate;
	Документ.Номер = НомерЗаявки;
	Документ.Ошибки = Ошибки;
	Если Документ.Отправки.Количество() > 0 Тогда
		ПаспортОрганизации = Справочники.э_ПаспортаОрганизаций.НайтиПоКоду(XMLСтрока(Документ.Отправки[0].ГрузополучательИД));
	КонецЕсли;
	Возврат Документ;
	
КонецФункции

Процедура ПодгрузитьНовыеВедомостиПодачиУборкиВагонов(operid = Неопределено) Экспорт
	
	глЭтран = неопределено;
	глЭтранИдетЗагрузка = Истина;
	НомерТранзакции = 1;
	
	ДлительныеОперации.СообщитьПрогресс(, "Подключение к ЭТРАН");
	
	Если не Константы.э_ВебСервис.Получить() Тогда 			
		глЭтран = ПодключитьКЭтранНаСервере();
	КонецЕсли;
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("vpuNumber",Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(10)));
	Таблица.Колонки.Добавить("vpuID",Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(10)));
	
	ВсеДокументыЗагрузились = Истина;
	
	ГраницаПериодаЗагрузкиДокументов = ПолучитьГраницуПериодаЗагрузкиОбъектов(ТекущаяДата(),"э_ВедомостьПодачиУборкиВагонов"); 
	
	//Пробуем получить operid. 
	//Если функция возвращает 999999999999999(нет записи по запросу), тогда грузим по периоду
	Если operid = "999999999999999" Тогда 
		иначе
		operid = ПолучитьНомерПоследнейОперации(Перечисления.э_ИменаЗапросов.ЗапросСтатусаВедомостиПодачиУборкиВагонов);
	КонецЕсли;
	
	День = 24*60*60;
	ДваДня = 2*День;	
	ТекущаяДата = ТекущаяДата();	
	НачалоПериода = ГраницаПериодаЗагрузкиДокументов - ДваДня;
	
	Пока НачалоПериода < ТекущаяДата Цикл
		Таблица.Очистить();
		КонецПериода = НачалоПериода + День;
		ТекстЗапроса = "<vpuStatus version=""1.0"">";
		//|<fromDate value=""" + (НачалоПериода-1) + """/>
		//|<toDate value=""" + (КонецПериода+1) + """/>
		////|<OperId value=""999999999999999""/>
		
		Если operid = "999999999999999" Тогда
			ТекстЗапроса = ТекстЗапроса + 
			"
			|<fromDate value=""" + (НачалоПериода -1) + """/>
			|<toDate value=""" + (КонецПериода+1) + """/>
