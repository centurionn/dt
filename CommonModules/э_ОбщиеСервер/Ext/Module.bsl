Процедура ОбновитьДатуРаскредитацииПо44НакладнымНаСервере() Экспорт
	
	ЗапросПо44 = Новый Запрос;
	ЗапросПо44.УстановитьПараметр("Статус44",  Справочники.э_СостоянияДокументов.НайтиПоКоду(44));
	ЗапросПо44.УстановитьПараметр("ТекущаяДата", ДобавитьМесяц(ТекущаяДата(), -3));
	ЗапросПо44.Текст = "ВЫБРАТЬ
	                   |	э_Накладная.Ссылка КАК Ссылка,
	                   |	э_Накладная.НакладнаяИД КАК invoiceID,
	                   |	э_Накладная.НакладнаяНомер КАК invNumber
	                   |ИЗ
	                   |	Документ.э_Накладная КАК э_Накладная
	                   |ГДЕ
	                   |	э_Накладная.Проведен = ИСТИНА
	                   |	И э_Накладная.ДатаИВремяРаскредитованияГруза = ДАТАВРЕМЯ(1, 1, 1)
	                   |	И э_Накладная.ТекущееСостояниеНакладной = &Статус44
	                   |	И э_Накладная.Дата > &ТекущаяДата
	                   |
	                   |УПОРЯДОЧИТЬ ПО
	                   |	э_Накладная.Дата";
	Выборка = ЗапросПо44.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	глЭтранИдетЗагрузка = Истина;

    ДлительныеОперации.СообщитьПрогресс(, "Получение ответа от ЭТРАН");
	
	КонстантыЭ_ВебСервис = Константы.э_ВебСервис.Получить();
	
	Пока Выборка.Следующий() Цикл
		ОтказПоФильтру = Истина;
        ИДНакладной    = Формат(Выборка.invoiceID, "ЧГ=");
        НомерНакладной = Выборка.invNumber;
		Если Не ЗначениеЗаполнено(НомерНакладной) Тогда
			Продолжить;
		КонецЕсли; 
		
		ПередаваемыйПараметр = Новый Структура;
		ПередаваемыйПараметр.Вставить("ЖДН", Выборка.Ссылка);
		ПередаваемыйПараметр.Вставить("ИДНакладной", ?(СтрДлина(ИДНакладной)>8, Формат(ИДНакладной, "ЧГ="), Неопределено));
		ПередаваемыйПараметр.Вставить("НомерНакладной", ?(СтрДлина(НомерНакладной)>8, Неопределено, НомерНакладной));
		
		ПолучитьДатуРаскредитацииПоНакладной(ПередаваемыйПараметр, КонстантыЭ_ВебСервис);
    КонецЦикла;
	
    глЭтранИдетЗагрузка = Ложь;
    
КонецПроцедуры

Процедура ПолучитьДатуРаскредитацииПоНакладной(ПараметрыДокумента, КонстантыЭ_ВебСервис = Неопределено) Экспорт
	
	Если ПараметрыДокумента.Свойство("НайтиИОбновить") И ПараметрыДокумента.НайтиИОбновить Тогда
		ЗапросПоИД = Новый Запрос;
		ЗапросПоИД.УстановитьПараметр("Статус44",  Справочники.э_СостоянияДокументов.НайтиПоКоду(44));
		Попытка
			чНомерНакладнойИД = Число(ПараметрыДокумента.ИДНакладной);
		Исключение
			Возврат;
		КонецПопытки;
		ЗапросПоИД.УстановитьПараметр("ИДНакладной", чНомерНакладнойИД);
		ЗапросПоИД.Текст = "ВЫБРАТЬ
		                   |	э_Накладная.Ссылка КАК Ссылка,
		                   |	э_Накладная.НакладнаяНомер КАК НакладнаяНомер
		                   |ИЗ
		                   |	Документ.э_Накладная КАК э_Накладная
		                   |ГДЕ
		                   |	э_Накладная.Проведен = ИСТИНА
		                   |	И э_Накладная.НакладнаяИД = &ИДНакладной
		                   |	И э_Накладная.ТекущееСостояниеНакладной = &Статус44";
		Выборка = ЗапросПоИД.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ПараметрыДокумента.ЖДН = Выборка.Ссылка;
			ПараметрыДокумента.НомерНакладной = Выборка.НакладнаяНомер;
		КонецЕсли;
	КонецЕсли;
	
	Если ПараметрыДокумента.ИДНакладной = Неопределено И ПараметрыДокумента.НомерНакладной = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ДлительныеОперации.СообщитьПрогресс(, "Подключение к ЭТРАН");
	
	ТекстЗапроса = "<getInvoice version=""1.0"">";
	Если не ПараметрыДокумента.ИДНакладной = Неопределено Тогда 
	ТекстЗапроса = ТекстЗапроса + "
	|<invoiceID value=""" + ПараметрыДокумента.ИДНакладной + """/>";
	ИначеЕсли  не ПараметрыДокумента.НомерНакладной = Неопределено Тогда 
	ТекстЗапроса = ТекстЗапроса + "
	|<invNumber value=""" + ПараметрыДокумента.НомерНакладной + """/>";
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса +"
	|<useMod11/><useValid/>
	|</getInvoice>";
	
	ДлительныеОперации.СообщитьПрогресс(, "Отправка запроса в ЭТРАН");
	
	Если ?(КонстантыЭ_ВебСервис = Неопределено, Константы.э_ВебСервис.Получить(), КонстантыЭ_ВебСервис) Тогда
		РезультатЗапроса = ПолучитьОтветНаЗапрос(ТекстЗапроса);	
	Иначе 
		глЭтран = ПодключитьКЭтранНаСервере();
		РезультатЗапроса = глЭтран.Call(ТекстЗапроса);
	КонецЕсли;

	РезультатПроверки = ОбработкаОшибокЗапросаДанных(РезультатЗапроса,, ТекстЗапроса, "Запрос данных накладной");      
	Если РезультатПроверки.КодОшибки = Неопределено Тогда 
		РезультатЗапроса = РезультатПроверки.РезультатЗапроса;
	Иначе
		
		Если РезультатПроверки.КодОшибки = "100" Тогда  //100-Код ошибки связи, 0 - прочая ошибка. повторение не требуется
			//Повторяем запрос 45  по 180 секунд, около 1,5 часа	
			КоличествоПовторов = 0;
			Пока КоличествоПовторов < 5 Цикл
				ПаузаВСекундах(30);// 0,5 минуты
				Если ?(КонстантыЭ_ВебСервис = Неопределено, Константы.э_ВебСервис.Получить(), КонстантыЭ_ВебСервис) Тогда
					РезультатЗапроса = ПолучитьОтветНаЗапрос(ТекстЗапроса);	
				Иначе 
					РезультатЗапроса = глЭтран.Call(ТекстЗапроса);
				КонецЕсли;
				РезультатПроверки = ОбработкаОшибокЗапросаДанных(РезультатЗапроса,, ТекстЗапроса, "Запрос данных накладной");      
				Если не РезультатПроверки.КодОшибки = "100" Тогда
					РезультатЗапроса = РезультатПроверки.РезультатЗапроса;	
					Прервать;	
				КонецЕсли;
				КоличествоПовторов = КоличествоПовторов + 1;
			КонецЦикла;  
		КонецЕсли;
		Если РезультатПроверки.КодОшибки = "0" 
			ИЛИ РезультатПроверки.КодОшибки = "1" 
			ИЛИ РезультатПроверки.КодОшибки = "4" Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если РезультатЗапроса = Неопределено Тогда                            
        Возврат;
    КонецЕсли;

	ДлительныеОперации.СообщитьПрогресс(, "Обработка ответа от ЭТРАН");
	invoiceStateID = Неопределено;
	ДатаРаскредитации = Дата(1,1,1);

	ОтказПоФильтру = Истина;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(РезультатЗапроса);
	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.Имя = "invoiceStateID" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			invoiceStateID = ЧтениеXML.ПолучитьАтрибут("value");
			Если invoiceStateID = "44" Тогда
				ОтказПоФильтру = Ложь;
			КонецЕсли;
		ИначеЕсли ЧтениеXML.Имя = "invLastOper" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			// временно ориентируемся на реквизит invLastOper вместо invDateDelivery, т.к. последнего пока нет в ответе 
			Попытка 
				ДатаРаскредитации = Дата(ЧтениеXML.ПолучитьАтрибут("value"));
			Исключение
				ОтказПоФильтру = Истина;
				Возврат;
			КонецПопытки;
			Если invoiceStateID = "44" Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;        

	Если ОтказПоФильтру Тогда
		Возврат;
	КонецЕсли;

	ДлительныеОперации.СообщитьПрогресс(, "Обновление накладной: " + ПараметрыДокумента.НомерНакладной);
	
	Если ЗначениеЗаполнено(ДатаРаскредитации) И ЗначениеЗаполнено(ПараметрыДокумента.ЖДН) Тогда
		эН = ПараметрыДокумента.ЖДН.ПолучитьОбъект();
		эН.ДатаИВремяРаскредитованияГруза 		 = МАКС(эН.ДатаИВремяРаскредитованияГруза, ДатаРаскредитации);
		эН.ДатаИВремяРаскредитованияГрузаМестная = МАКС(эН.ДатаИВремяРаскредитованияГрузаМестная, ДатаРаскредитации);
		Попытка
			эН.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			//ОбщегоНазначения.СообщитьПользователю("Ошибка обновления даты раскредитования из ЭТРАН. "+ПараметрыДокумента.ЖДН);
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры
