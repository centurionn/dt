Функция НайтиНомерВОсобыхОтметках(Строка)
	
	ДлинаСтроки = СтрДлина(Строка);  	
	НомерВагона = "";
	н=1;
	Пока ДлинаСтроки >= н Цикл
		
		СимволИзСтроки = Сред(Строка,н,1);
		Попытка
			
			Если СимволИзСтроки = " " или СимволИзСтроки ="." или СимволИзСтроки ="," Тогда   
				НомерВагона = "";
			Иначе				
				СимволЧисло = Число(СимволИзСтроки);
				НомерВагона = НомерВагона + СимволЧисло;
				Если СтрДлина(НомерВагона) = 8 тогда
					Возврат НомерВагона;
				КонецЕсли;   				              				
			КонецЕсли;
			
		Исключение
			НомерВагона = "";
		КонецПопытки;
		
		н=н+1;
	КонецЦикла;
	
	Возврат "";		
	
