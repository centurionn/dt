Функция ПолучитьГраницуПериодаЗагрузкиОбъектов(ТекущаяДата,НазваниеДокмента) 
	
	НаборЗаписей = РегистрыСведений.э_ГраницаПериодаЗагрузкиОбъектов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(НазваниеДокмента);
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество() > 0 Тогда
		ГраницаПериодаЗагрузкиДокументов = НаборЗаписей[0].Граница;
	Иначе
		Запись = НаборЗаписей.Добавить();
		Запись.Объект  = НазваниеДокмента;
		Запись.Граница = ТекущаяДата();
		ГраницаПериодаЗагрузкиДокументов = Запись.Граница;
		НаборЗаписей.Записать();		
	КонецЕсли;		
	
	
	Возврат ГраницаПериодаЗагрузкиДокументов;
	
КонецФункции

Функция ПолучитьНомерПоследнейОперации(НаименованиеЗапроса) 
	
	НомерПоследнейОперации = "999999999999999";	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	э_НомерПоследнейОперации.НомерОперации КАК НомерОперации
	               |ИЗ
	               |	РегистрСведений.э_НомерПоследнейОперации КАК э_НомерПоследнейОперации
	               |ГДЕ
	               |	э_НомерПоследнейОперации.Запрос = &Запрос";
	Запрос.УстановитьПараметр("Запрос", НаименованиеЗапроса);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		НомерПоследнейОперации = Ответ.НомерОперации;
	КонецЕсли;
	
	Возврат НомерПоследнейОперации;
	
КонецФункции

//Функция ОбработкаОшибокЗапросаДанных(РезультатЗапроса, Отключить = Ложь) //Евросиб Гудкова( 04.09.2020 Ticket№ 0205656
Функция ОбработкаОшибокЗапросаДанных(РезультатЗапроса, Отключить = Ложь, ТекстЗапроса = Неопределено, ТипЗапроса = Неопределено) экспорт
	
	Ответ = Новый Структура;
	Ответ.Вставить("РезультатЗапроса", РезультатЗапроса);
	Ответ.Вставить("КодОшибки",Неопределено);
	//Рыбьяков К.А 03.05.2024 Ticket#0350495
	Ответ.Вставить("СтатусКод",Неопределено);
	//Рыбьяков К.А 03.05.2024 Ticket#0350495
	
	Если Не Отключить Тогда
		
		Если РезультатЗапроса = "Ошибка подключения к прокси. error"  Тогда 
			Ответ.Вставить("КодОшибки","0"); 
		КонецЕсли;
		
		//СКА 19102019
		Если РезультатЗапроса = "" Тогда 
			Ответ.Вставить("КодОшибки","1"); 
		КонецЕсли;
		//СКА 19102019
		
		//Евросиб Каблов 18.08.2021 ( Ticket#0238931
		//Если Найти(РезультатЗапроса,"<error>") > 0 Тогда
		Если Найти(РезультатЗапроса,"<error") > 0 Тогда
			//Евросиб Каблов 18.08.2021 ) 
			ЧтениеXML = Новый ЧтениеXML;
			ЧтениеXML.УстановитьСтроку(РезультатЗапроса);
			КодОшибки = "0";
			Пока ЧтениеXML.Прочитать() Цикл
				Если ЧтениеXML.Имя = "errorCode" Тогда
					КодОшибки = ЧтениеXML.ПолучитьАтрибут("value");
					Ответ.Вставить("КодОшибки",КодОшибки); 
				ИначеЕсли ЧтениеXML.Имя = "errorMessage" Тогда
					ТекстОшибки = ЧтениеXML.ПолучитьАтрибут("value");
					Ответ.Вставить("ТекстОшибки",ТекстОшибки);
					//Рыбьяков К.А 03.05.2024 Ticket#0350495
				ИначеЕсли ЧтениеXML.Имя = "errorStatusCode" Тогда
					СтатусКод = ЧтениеXML.ПолучитьАтрибут("value");
					Ответ.Вставить("СтатусКод", СтатусКод);
					//Рыбьяков К.А 03.05.2024 Ticket#0350495
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	//Евросиб Гудкова( 04.09.2020 Ticket№ 0205656
	ЗаписатьЛогЭТРАН(ТипЗапроса, ТекстЗапроса, РезультатЗапроса,,,, Ответ.КодОшибки <> Неопределено);
	// Евросиб Гудкова) 	
	Возврат Ответ;
	
КонецФункции

