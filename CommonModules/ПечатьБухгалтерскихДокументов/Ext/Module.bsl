Функция ПечатьОтчетаАгенту(СведенияОДокументахОтчет, ОбъектыПечати, ПараметрыПечати,СтруктураПодписантов) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Портрет;
	
	ПервыйДокумент = Истина;
	
	//ДИТ, Беляев СЮ, Ticket#0310096, 25-05-2023, начало
	МассивПредставленийСФПодрядчика = Новый Массив;
	//ДИТ, Беляев СЮ, Ticket#0310096, 25-05-2023, конец

	Для Каждого СведенияОДокументе ИЗ СведенияОДокументахОтчет Цикл
		
//Евросиб ( Литвинов 21.01.2021 #30025
		Наименования = Справочники.Организации.НаименованияНаДату(СведенияОДокументе.Организация, СведенияОДокументе.ДатаДокумента);
//Евросиб ) Литвинов 21.01.2021 #30025

		
		//Евросиб(ДИТ), Беляев СЮ, US 92763 / TA 98182, 19-12-2024, начало
		Страхование = Ложь;
		НаименованиеФактурыВПодвале = "счет-фактура";
		
		//Евросиб(ДИТ), Беляев СЮ, US 103867 / TA 103872, 28-02-2025, начало
		Если ТипЗнч(СведенияОДокументе.Документ) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
			Партия = Документы.ОтчетКомитентуОПродажах.ПолучитьПоступление(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СведенияОДокументе.Документ, "ИсходныйДокументРеализации"));
		Иначе
			Партия = Документы.ОтчетКомитентуОПродажах.ПолучитьПоступление(СведенияОДокументе.Документ);
		КонецЕсли;
		Партия = ?(Партия = Неопределено, Документы.ПоступлениеТоваровУслуг.ПустаяСсылка(), Партия);
		
		ТипДокументаУПД = Ложь;
		
		Если Партия <> Документы.ПоступлениеТоваровУслуг.ПустаяСсылка() Тогда
			КоллекцияПечатныхФормВременная = УправлениеПечатью.ПодготовитьКоллекциюПечатныхФорм(Новый Массив);
			КоллекцияПечатныхФормВременная.Добавить();
			ПечатьКомплектаДокументов.ПолучитьПечатнуюФормуИзДиадок(КоллекцияПечатныхФормВременная, Партия, "ПолучитьТолькоТипДокументаЭДО", "Входящие документы", ТипДокументаУПД);
			Если НЕ ТипДокументаУПД Тогда
				ТипДокументаУПД = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Партия, "ВидПервичногоДокумента") = Перечисления.ВидыПервичныхДокументов.УПД
			КонецЕсли;
		КонецЕсли;
		
		Если ТипДокументаУПД Тогда
			НаименованиеФактурыВПодвале = "УПД";
		КонецЕсли;
		//Евросиб(ДИТ), Беляев СЮ, US 103867 / TA 103872, 28-02-2025, конец
		
		Если СведенияОДокументахОтчет.Колонки.Найти("Страхование") <> Неопределено Тогда
			Страхование = СведенияОДокументе.Страхование;
		КонецЕсли;
		Если Страхование Тогда
			НаименованиеФактурыВПодвале = "страховой полис";
		КонецЕсли;
		//Евросиб(ДИТ), Беляев СЮ, US 92763 / TA 98182, 19-12-2024, конец

		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ОтчетКомитентуОПродажах.ПФ_MXL_ОтчетАгента", СведенияОДокументе.Комитент, СведенияОДокументе.ДоговорКомитента);
		
		ТаблицаУслуги = СведенияОДокументе.ТаблицаДокумента;
		ТаблицаРасшифровки = СведенияОДокументе.ТаблицаРасшифровки;
		//Выводим шапку
		//руководители сторон
		РуководительКонтрагента = ОтветственныеЛица_сервер.ПолучитьРуководителя(СведенияОДокументе.Комитент,СведенияОДокументе.ДатаДокумента);
		//Евросиб(ДИТ), Беляев СЮ, US 103867 / TA 103872, 28-02-2025, начало
		ЭтоЭлектронныйДокументДиадок = Ложь;
		Если ПараметрыПечати.Свойство("ЭлектронныйДокументДиадок")
			и ПараметрыПечати.ЭлектронныйДокументДиадок Тогда
		    //ОбластьМакета.Параметры.ФИОРуководителя = ПараметрыПечати.ФИОПодписанта;
			//ОбластьМакета.Параметры.Подпись = "Электронная подпись";
			ЭтоЭлектронныйДокументДиадок = Истина;
		//Евросиб(ДИТ), Беляев СЮ, US 103867 / TA 103872, 28-02-2025, конец
		ИначеЕсли НЕ СтруктураПодписантов = Неопределено Тогда
			РуководительДолжностьНаименование =  СтруктураПодписантов.ДоверенностьЗаРуководителя.ДолжностьРодительныйПадеж;
			РуководительФИО = СтруктураПодписантов.ДоверенностьЗаРуководителя.ФИОПодписантаДляПротокола;
			ЗаРуководителяНаОсновании = СтруктураПодписантов.ДоверенностьЗаРуководителя.ОснованиеДляПодписанияРП;
			РуководительОрг =  СтруктураПодписантов.ДоверенностьЗаРуководителя.ФИОПодписанта + Символы.ПС + ?(ЗначениеЗаполнено(СтруктураПодписантов.ЗаРуководителяНаОсновании), СтруктураПодписантов.ЗаРуководителяНаОсновании, СтруктураПодписантов.ДоверенностьЗаРуководителя.ОснованиеДляПодписания);
			Если НЕ СтруктураПодписантов.Свойство("БезФаксимиле")
				И ЗначениеЗаполнено(СтруктураПодписантов.ДоверенностьЗаРуководителя.ФайлФаксимиль) Тогда
				ДанныеКартинкиПодпись = РаботаСФайлами.ДанныеФайла(СтруктураПодписантов.ДоверенностьЗаРуководителя.ФайлФаксимиль);
				ДвоичныеДанныеПодпись = ПолучитьИзВременногоХранилища(ДанныеКартинкиПодпись.СсылкаНаДвоичныеДанныеФайла);
			КонецЕсли;
			Если НЕ СтруктураПодписантов.Свойство("БезФаксимиле") 
				И ЗначениеЗаполнено(СтруктураПодписантов.ДоверенностьЗаРуководителя.ФайлПечать) тогда
				ДанныеКартинкиПечать = РаботаСФайлами.ДанныеФайла(СтруктураПодписантов.ДоверенностьЗаРуководителя.ФайлПечать);
				ДвоичныеДанныеПечать = ПолучитьИзВременногоХранилища(ДанныеКартинкиПечать.СсылкаНаДвоичныеДанныеФайла);
			КонецЕсли;
			//++ Зубов Ticket#0238772 21.01.2022
			РуководительДолжностьНаименованиеРП =  СтруктураПодписантов.ДоверенностьЗаРуководителя.ДолжностьРодительныйПадеж;
			РуководительФИОРП = СтруктураПодписантов.ДоверенностьЗаРуководителя.ФИОПодписантаДляПротокола;
			//-- Зубов Ticket#0238772 21.01.2022
		ИначеЕсли ЗначениеЗаполнено(СведенияОДокументе.ДоверенностьЗаРуководителя) Тогда
			РуководительДолжностьНаименованиеРП =  СведенияОДокументе.ДоверенностьЗаРуководителя.ДолжностьРодительныйПадеж;
			РуководительФИОРП = СведенияОДокументе.ДоверенностьЗаРуководителя.ФИОПодписантаДляПротокола;
			ЗаРуководителяНаОсновании = СведенияОДокументе.ДоверенностьЗаРуководителя.ОснованиеДляПодписанияРП;
			РуководительОрг =  СведенияОДокументе.ДоверенностьЗаРуководителя.ФИОПодписанта + Символы.ПС + СведенияОДокументе.ДоверенностьЗаРуководителя.ОснованиеДляПодписания;
			Если ЗначениеЗаполнено(СведенияОДокументе.ДоверенностьЗаРуководителя.ФайлФаксимиль) Тогда
				ДанныеКартинкиПодпись = РаботаСФайлами.ДанныеФайла(СведенияОДокументе.ДоверенностьЗаРуководителя.ФайлФаксимиль);
				ДвоичныеДанныеПодпись = ПолучитьИзВременногоХранилища(ДанныеКартинкиПодпись.СсылкаНаДвоичныеДанныеФайла);
			КонецЕсли;
			Если ЗначениеЗаполнено(СведенияОДокументе.ДоверенностьЗаРуководителя.ФайлПечать) тогда
				ДанныеКартинкиПечать = РаботаСФайлами.ДанныеФайла(СведенияОДокументе.ДоверенностьЗаРуководителя.ФайлПечать);
				ДвоичныеДанныеПечать = ПолучитьИзВременногоХранилища(ДанныеКартинкиПечать.СсылкаНаДвоичныеДанныеФайла);
			КонецЕсли;
		Иначе
			СтруктураОтветственныхЛиц = ОтветственныеЛица_сервер.ПолучитьРуководителя(СведенияОДокументе.Организация, СведенияОДокументе.ДАтаДокумента);
			РуководительДолжностьНаименование =  СтруктураОтветственныхЛиц.ДолжностьРус;
			РуководительДолжностьНаименованиеРП = СтруктураОтветственныхЛиц.ДолжностьРП;
			РуководительФИО = СтруктураОтветственныхЛиц.ФИОРус;
			РуководительФИОРП = СтруктураОтветственныхЛиц.ФИОРПРус;
			ЗаРуководителяНаОсновании = СтруктураОтветственныхЛиц.ОснованиеРус;
			РуководительОрг = СтруктураОтветственныхЛиц.ФИОРус;     
		КонецЕсли;   
		
		Если ТипЗнч(СведенияОДокументе.Документ) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
			
			Если СведенияОДокументе.Документ.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение Тогда
				
				ОбластьШапка = Макет.ПолучитьОбласть("ШапкаКорр");
				
				Если ТипЗнч(СведенияОДокументе.Документ.ИсправляемыйДокументРеализации) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
					//ДИТ Давудов М.А. US 58785 29.01.2024 Начало
					Если НЕ СведенияОДокументе.Документ.КорректировкаОтчетаКомитенту Тогда
						ОбластьШапка = Макет.ПолучитьОбласть("ШапкаКоррАктСдачи");
