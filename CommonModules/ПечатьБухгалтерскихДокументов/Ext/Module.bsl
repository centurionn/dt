			ПараметрыПравилФормирования = Новый Структура; //создадим структуру, чтобы не проверять найденные правила в условиях на НЕОПРЕДЕЛЕНО
			ПараметрыПравилФормирования.Вставить("СворачиватьСтрокиВПечатнойФормеАкта", Ложь);
			ПараметрыПравилФормирования.Вставить("ДанныеИзРеестраПовагонки", Ложь);
			ПараметрыПравилФормирования.Вставить("СпособГруппировкиОтгрузочнойИнформацииКАкту", Перечисления.СпособыГруппировкиОтгрузочнойИнформацииКАкту.ПустаяСсылка());
			ПараметрыПравилФормирования.Вставить("НаименованиеГруппыОтгрузочнойИнформацииКАкту", "");
			
			СФ = БухгалтерскийУчетОбщиеПроцедурыСервер.НайтиПодчиненныйСчетФактуру(СведенияОДокументе.Документ,"СчетФактураВыданный");
			
			Если ПараметрыПравилФормирования.СпособГруппировкиОтгрузочнойИнформацииКАкту = Перечисления.СпособыГруппировкиОтгрузочнойИнформацииКАкту.Сводно Тогда
				ВместоГрузаВывестиТекст = Истина;
				НаименованиеГруза = ПараметрыПравилФормирования.НаименованиеГруппыОтгрузочнойИнформацииКАкту;
				ПоляГруппировкиТаблицыРасшифровки = "ПунктОтправления,ПунктНазначения,ВидТранспортногоСообщения";
			Иначе
				ВместоГрузаВывестиТекст = Ложь;
				НаименованиеГруза = "";
				ПоляГруппировкиТаблицыРасшифровки = "Груз,ПунктОтправления,ПунктНазначения,ВидТранспортногоСообщения";
			КонецЕсли;

			ОбластьМакета = МакетПриложения.ПолучитьОбласть("Шапка");
			ОбластьМакета.Параметры.ПодразделениеГород = СведенияОДокументе.ПодразделениеГород;
			ОбластьМакета.Параметры.НомерДоговора  = СведенияОДокументе.НомерДоговора;
			ОбластьМакета.Параметры.ДатаДоговора = Формат(СведенияОДокументе.ДатаДоговора,"ДФ=dd.MM.yyyy");
			Если СФ <> Неопределено Тогда
				ОбластьМакета.Параметры.НомерСФ  = СФ.НомерДляПечати;
				ОбластьМакета.Параметры.ДатаСФ  =  Формат(СФ.ДатаДокумента,"ДФ=dd.MM.yyyy");
			КонецЕсли;

			ОбластьМакета.Параметры.НомерДокумента = СведенияОДокументе.НомерДокумента;
			ОбластьМакета.Параметры.ДатаДокумента  = СведенияОДокументе.ДатаДокумента;  

			ТабличныйДокумент.Вывести(ОбластьМакета);
			ОбластьМакета = МакетПриложения.ПолучитьОбласть("ЗаголовокТаблицы");
			ТабличныйДокумент.Вывести(ОбластьМакета);

			ОбластьМакета = МакетПриложения.ПолучитьОбласть("ГруппировкаУслуги");
			ОбластьМакетаПНУ = МакетПриложения.ПолучитьОбласть("ГруппировкаУслугиПНУ");
			ОбластьСтрока = МакетПриложения.ПолучитьОбласть("СтрокаРасшифровки");
			НомерСтроки = 0;

			ТаблицаПоГрузам = ТаблицаРасшифровки.Скопировать(, ПоляГруппировкиТаблицыРасшифровки);
			ТаблицаПоГрузам.Свернуть(ПоляГруппировкиТаблицыРасшифровки);

			Для Каждого СтрокаТабличнойЧасти из ТаблицаПоГрузам Цикл
				
				Если ВместоГрузаВывестиТекст Тогда
					ПолноеНаименование = НаименованиеГруза;
				Иначе
					ПолноеНаименование = СтрокаТабличнойЧасти.Груз;
				КонецЕсли;
				
				ОбластьМакетаПНУ.Параметры.ПолноеНаименованиеУслуги = ПолноеНаименование;
				
				ОбластьМакета.Параметры.ПунктОтправления = СтрокаТабличнойЧасти.ПунктОтправления;
				ОбластьМакета.Параметры.ПунктНазначения = СтрокаТабличнойЧасти.ПунктНазначения;
				ТабличныйДокумент.Вывести(ОбластьМакета);
				ТабличныйДокумент.Вывести(ОбластьМакетаПНУ);
				
				Отбор = Новый Структура(ПоляГруппировкиТаблицыРасшифровки);
				ЗаполнитьЗначенияСвойств(Отбор, СтрокаТабличнойЧасти);
				
				КонтейнерыУслуги = ТаблицаРасшифровки.НайтиСтроки(Отбор);
				Для каждого ЭлементМассива из КонтейнерыУслуги Цикл
					НомерСтроки = НомерСтроки+1;
					СтруктураПараметры = Новый Структура();
					СтруктураПараметры.Вставить("НомерСтроки", НомерСтроки);
					СтруктураПараметры.Вставить("НомерДокумента", ЭлементМассива.НомерЖДН);
					СтруктураПараметры.Вставить("НомерВагона",ЭлементМассива.Вагон);
					СтруктураПараметры.Вставить("СерияИНомерКонтейнера",ЭлементМассива.Контейнер);
					СтруктураПараметры.Вставить("ДатаОтправки",ЭлементМассива.ДатаОтправки);
					СтруктураПараметры.Вставить("ДатаПрибытия", СведенияОДокументе.ДатаДокумента);
					СтруктураПараметры.Вставить("ФактВес",ЭлементМассива.ФактическийВес);
					СтруктураПараметры.Вставить("ГП",ЭлементМассива.ГП);
					СтруктураПараметры.Вставить("РасчВес",ЭлементМассива.РасчетныйВес);
					СтруктураПараметры.Вставить("Примечание",ЭлементМассива.Примечание);
					ОбластьСтрока.Параметры.Заполнить(СтруктураПараметры);
					ТабличныйДокумент.Вывести(ОбластьСтрока);
					
				КонецЦикла;
				
			КонецЦИкла;

			ОбластьИтоги = МакетПриложения.ПолучитьОбласть("Итоги");

			ТаблицаИтоговПоКонтейнерам = ТаблицаРасшифровки.СкопироватьКолонки("Контейнер, РасчетныйВес, ФактическийВес");

			Для Каждого СтрокаТаблицыРасшифровки Из ТаблицаРасшифровки Цикл
				СтрокаПоКонтейнеру = ТаблицаИтоговПоКонтейнерам.Найти(СтрокаТаблицыРасшифровки.Контейнер, "Контейнер");
				Если СтрокаПоКонтейнеру = Неопределено Тогда
					СтрокаПоКонтейнеру = ТаблицаИтоговПоКонтейнерам.Добавить();
					СтрокаПоКонтейнеру.Контейнер = СтрокаТаблицыРасшифровки.Контейнер;
				КонецЕсли;
				СтрокаПоКонтейнеру.РасчетныйВес = Макс(СтрокаПоКонтейнеру.РасчетныйВес, СтрокаТаблицыРасшифровки.РасчетныйВес);
				СтрокаПоКонтейнеру.ФактическийВес = Макс(СтрокаПоКонтейнеру.ФактическийВес, СтрокаТаблицыРасшифровки.ФактическийВес);
			КонецЦикла;
			ОбластьИтоги.Параметры.ИтогоРасчВес = ТаблицаИтоговПоКонтейнерам.Итог("РасчетныйВес");
			ОбластьИтоги.Параметры.ИтогоФактВес = ТаблицаИтоговПоКонтейнерам.Итог("ФактическийВес");

			Если СведенияОДокументе.Факторинг Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("ПодвалФакторинг");
				ОбластьМакета.Параметры.ДополнительнаяИнформацияФакторинг = СведенияОДокументе.ДополнительнаяИнформацияФакторинг;
				ТабличныйДокумент.Вывести(ОбластьМакета);
			КонецЕсли; 

			ТабличныйДокумент.Вывести(ОбластьИтоги);

			ОбластьПодписи = МакетПриложения.ПолучитьОбласть("Подписи");
			ОбластьПодписи.Параметры.КраткоеНаименованиеОрг = НаименованиеСтороныИсполнитель;
			ОбластьПодписи.Параметры.ПолноеНаименованиеОрг = Наименования.НаименованиеПолное;
			ОбластьПодписи.Параметры.ФИОРуководителяОрг =  РуководительОрг;
			Если СтруктураПодписантов = Неопределено ИЛИ НЕ СтруктураПодписантов.Свойство("БезФаксимиле")  Тогда
				Если ЗначениеЗаполнено(ДвоичныеДанныеПодпись) Тогда
					ОбластьПодписи.Рисунки.ПодписьРуководителя.Картинка = Новый Картинка(ДвоичныеДанныеПодпись);
				КонецЕсли; 
				Если ЗначениеЗаполнено(ДвоичныеДанныеПечать) Тогда
					ОбластьПодписи.Рисунки.Печать.Картинка = Новый Картинка(ДвоичныеДанныеПечать);
				КонецЕсли;
			КонецЕсли;
			ОбластьПодписи.Параметры.КраткоеНаименованиеКонтр = НаименованиеСтороныКлиент;
			ОбластьПодписи.Параметры.ПолноеНаименованиеКонтр = СведенияОДокументе.ПолноеНаименованиеКонтрагента;
			ОбластьПодписи.Параметры.ФИОРуководителяКонтр = РуководительКонтрагента.ФИОРус;

			ТабличныйДокумент.Вывести(ОбластьПодписи);

			Если СведенияОДокументе.Факторинг Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("ПодвалФакторинг");
				ОбластьМакета.Параметры.ДополнительнаяИнформацияФакторинг = СведенияОДокументе.ДополнительнаяИнформацияФакторинг;
				ТабличныйДокумент.Вывести(ОбластьМакета);
			КонецЕсли;
		КонецЕсли;
		//ДИТ Давудов М.А. US 58785 29.01.2024 Конец

	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПечатьОперативногоПриказа(ОперативныйПриказ) Экспорт
	
	//ОперативныйПриказ = Документы.ОперативныйПриказ.СоздатьДокумент();
	
	Результат = Новый ТабличныйДокумент;
	Макет = Документы.ОперативныйПриказ1.ПолучитьМакет("ОперативныйПриказ");
	
	Шапка = Макет.ПолучитьОбласть("Шапка");
	
	Шапка.Параметры.НомерПриказа = ОперативныйПриказ.Номер;
	Шапка.Параметры.НомерНедели = ОперативныйПриказ.НомерНедели;
	Шапка.Параметры.ДатаФормирования = Формат(ОперативныйПриказ.Дата, "ДФ=dd.MM.yyyy");
	Шапка.Параметры.СтанцияОтправления = ОперативныйПриказ.ПунктОтправления;
	Шапка.Параметры.СтанцияНазначения = ОперативныйПриказ.ПунктНазначения;
	Шапка.Параметры.ДатаОтправления = Формат(ОперативныйПриказ.ДатаОтправления, "ДФ=dd.MM.yyyy");;
//Евросиб ( Литвинов 21.01.2021 #30025
	//Шапка.Параметры.НазваниеОрганизации = ОперативныйПриказ.Организация.НаименованиеСокращенное;
	Шапка.Параметры.НазваниеОрганизации = Справочники.Организации.НаименованияНаДату(ОперативныйПриказ.Организация, ОперативныйПриказ.Дата).НаименованиеСокращенное;
//Евросиб ) Литвинов 21.01.2021 #30025
	Шапка.Параметры.Грузоотправитель = ОперативныйПриказ.Грузоотправитель;
	
	СписокКТК = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(1) КАК КоличествоЪ,
	               |	ОперативныйПриказСписокКТК.Контейнер.ТипТЕ КАК ТипТЕ
	               |ИЗ
	               |	Документ.ОперативныйПриказ1.СписокКТК КАК ОперативныйПриказСписокКТК
	               |ГДЕ
	               |	ОперативныйПриказСписокКТК.Ссылка = &Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОперативныйПриказСписокКТК.Контейнер.ТипТЕ";
	Запрос.УстановитьПараметр("Ссылка", ОперативныйПриказ.Ссылка);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		СписокКТК.Добавить(""+Ответ.КоличествоЪ+"х"+Ответ.ТипТЕ);
	КонецЦикла;
	
	Шапка.Параметры.СписокКонтейнеров = СтрСоединить(СписокКТК, ", ");
	
	Результат.Вывести(Шапка);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОперативныйПриказСписокКТК.Контейнер КАК Контейнер,
	               |	ОперативныйПриказСписокКТК.Собственник КАК Собственник,
	               |	ОперативныйПриказСписокКТК.Выдача КАК Выдача,
	               |	ОперативныйПриказСписокКТК.РазмерПлатформы КАК РазмерПлатформы,
	               |	ОперативныйПриказСписокКТК.Контейнер.ТипТЕ КАК ТипТЕ,
	               |	ОперативныйПриказСписокКТК.Контейнер.ТипТЕ.РазмерКТК КАК РазмерКТК,
	               |	ОперативныйПриказСписокКТК.Платформа КАК Платформа,
	               |	ОперативныйПриказСписокКТК.Примечание КАК Примечание,
	               |	ОперативныйПриказСписокКТК.ВладелецТС КАК ВладелецТС
	               |ИЗ
	               |	Документ.ОперативныйПриказ1.СписокКТК КАК ОперативныйПриказСписокКТК
	               |ГДЕ
	               |	ОперативныйПриказСписокКТК.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ОперативныйПриказ.Ссылка);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		Строка = Макет.ПолучитьОбласть("Строка");
		Строка.Параметры.НомерКТК = Ответ.Контейнер;
		Строка.Параметры.Размер = Ответ.РазмерКТК;
		Строка.Параметры.Тип = Ответ.ТипТЕ;
		Строка.Параметры.Собственность = Ответ.Собственник;
		Строка.Параметры.ВладелецТС = Ответ.ВладелецТС;
		Строка.Параметры.РазмерПл = Ответ.РазмерПлатформы;
		Строка.Параметры.НомерПлатформы = Ответ.Платформа;
		Строка.Параметры.Выдача = Формат(Ответ.Выдача, "ДФ=dd.MM.yyyy");
		Строка.Параметры.НомерПлатформы = Ответ.Платформа;
		Строка.Параметры.Примечание = Ответ.Примечание;
		Результат.Вывести(Строка);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьНаличиеПроцесса(ТекОбъект) Экспорт
	
	ПроцессСогл = Справочники.ПроцессСогласования.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПроцессСогласования.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ПроцессСогласования КАК ПроцессСогласования
	               |ГДЕ
	               |	ПроцессСогласования.ДокументСогласования = &Ссылка
	               |	И НЕ ПроцессСогласования.ПометкаУдаления";
	Запрос.УстановитьПараметр("Ссылка", ТекОбъект);
	Ответ = запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		ПроцессСогл = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат ПроцессСогл;
	
КонецФункции

