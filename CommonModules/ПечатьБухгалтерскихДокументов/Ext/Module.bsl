Процедура УстановитьУДокументовПризнакВыставлен(МассивДокументов, ЗначениеПризнака) Экспорт
	
	//ДИТ Пак И.Т. Task34379 12.05.2021 Начало
	Если Не ПравоНаПечатьСВыставлением(МассивДокументов) Тогда
		Возврат;
	КонецЕсли;
	//ДИТ Пак И.Т. Task34379 12.05.2021 Конец
	
	УстановитьПривилегированныйРежим(Истина);
	Для Каждого ДокументСсылка Из МассивДокументов Цикл
		УстановитьУДокументаПризнакВыставлен(ДокументСсылка, ЗначениеПризнака);
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

//ДИТ Пак И.Т. Task34379 12.05.2021
Функция ПравоНаПечатьСВыставлением(МассивДокументов)
	
	Если ПривилегированныйРежим() Тогда
		БылПривилегированныйРежим = Истина;
		УстановитьПривилегированныйРежим(Ложь);
	Иначе
		БылПривилегированныйРежим = Ложь;
	КонецЕсли;
	
	ЕстьПраво = Истина;
	Для каждого ДокументСсылка Из МассивДокументов Цикл
		МетаИмя = ДокументСсылка.Метаданные().Имя;
		Если МетаИмя = "РеализацияТоваровУслуг"
			Или МетаИмя = "ОтчетКомитентуОПродажах"
			Или МетаИмя = "СчетФактураВыданный" 
			Тогда
			ЕстьПраво = РольДоступна("dc_ПечатьИСФ");
		КонецЕсли;
		Прервать;
	КонецЦикла;
	
	Если БылПривилегированныйРежим Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	Возврат ЕстьПраво;
	
КонецФункции


