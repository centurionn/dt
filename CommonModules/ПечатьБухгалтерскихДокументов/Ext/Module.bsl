		ПараметрыПравилФормирования.Вставить("СпособГруппировкиОтгрузочнойИнформацииКАкту", Перечисления.СпособыГруппировкиОтгрузочнойИнформацииКАкту.ПустаяСсылка());
		ПараметрыПравилФормирования.Вставить("НаименованиеГруппыОтгрузочнойИнформацииКАкту", "");
