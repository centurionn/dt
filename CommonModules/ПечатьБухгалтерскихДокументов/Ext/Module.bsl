		ПараметрыПравилФормирования.Вставить("СворачиватьСтрокиВПечатнойФормеАктаВключаяСтавку", Ложь);
		//Евросиб(ДИТ), Беляев СЮ, US 98449 / TA 98451, 20-12-2024, конец
		Если ПараметрыФФД<>Неопределено Тогда
			ПараметрыПравилФормирования.СворачиватьСтрокиВПечатнойФормеАкта = ПараметрыФФД.СворачиватьСтрокиВПечатнойФормеАкта;
			ПараметрыПравилФормирования.ДанныеИзРеестраПовагонки = ПараметрыФФД.ДанныеИзРеестраПовагонки;
			ПараметрыПравилФормирования.СпособГруппировкиОтгрузочнойИнформацииКАкту = ПараметрыФФД.СпособГруппировкиОтгрузочнойИнформацииКАкту;
			ПараметрыПравилФормирования.НаименованиеГруппыОтгрузочнойИнформацииКАкту = ПараметрыФФД.НаименованиеГруппыОтгрузочнойИнформацииКАкту;
			//Евросиб(ДИТ), Беляев СЮ, US 98449 / TA 98451, 20-12-2024, начало
			ПараметрыПравилФормирования.СворачиватьСтрокиВПечатнойФормеАктаВключаяСтавку = ПараметрыФФД.СворачиватьСтрокиВПечатнойФормеАктаВключаяСтавку;
			//Евросиб(ДИТ), Беляев СЮ, US 98449 / TA 98451, 20-12-2024, конец
		КонецЕсли;
		//ДИТ, Беляев СЮ, Ticket#0297323/BUG65039, 01-02-2023, конец
		
		
		Макет = УправлениеПечатью.МакетПечатнойФормы(ИмяМакетаПечати, СведенияОДокументе.Контрагент, СведенияОДокументе.ДоговорКонтрагента);
		
		Если НЕ ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ТаблицаУслуги = СведенияОДокументе.ТаблицаДокумента;
		ТаблицаРасшифровки = СведенияОДокументе.ТаблицаРасшифровки;
		
		//руководители сторон    
		//ДИТ Авдеева В.С. 43329 29.04.2022 Начало 
		//было 
		//РуководительКонтрагента = ОтветственныеЛица_сервер.ПолучитьРуководителя(СведенияОДокументе.Контрагент,СведенияОДокументе.ДатаДокумента);
		//стало
		ВыбранныйРуководительКонтрагента = Неопределено; 
		
		Если ТипЗнч(СведенияОДокументе.Документ)  = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда 
			ВыбранныйРуководительКонтрагента = СведенияОДокументе.РуководительКонтрагента;
		КонецЕсли;	
		
		РуководительКонтрагента = ОтветственныеЛица_сервер.ПолучитьРуководителя(СведенияОДокументе.Контрагент,СведенияОДокументе.ДатаДокумента, ВыбранныйРуководительКонтрагента);
		//ДИТ Авдеева В.С. 43329 29.04.2022 Конец 
		//Евросиб(ДИТ), Беляев СЮ, US 103867 / TA 103872, 28-02-2025, начало
		ЭтоЭлектронныйДокументДиадок = Ложь;
		Если СтруктураПараметровПечати.Свойство("ЭлектронныйДокументДиадок")
			и СтруктураПараметровПечати.ЭлектронныйДокументДиадок Тогда
		    //ОбластьМакета.Параметры.ФИОРуководителя = ПараметрыПечати.ФИОПодписанта;
			//ОбластьМакета.Параметры.Подпись = "Электронная подпись";
			ЭтоЭлектронныйДокументДиадок = Истина;
		//Евросиб(ДИТ), Беляев СЮ, US 103867 / TA 103872, 28-02-2025, конец
		ИначеЕсли НЕ СтруктураПодписантов = Неопределено Тогда
			//Евросиб Каблов 16.12.2020 ( Ticket#0213091
			//РуководительДолжностьНаименование =  СтруктураПодписантов.ДоверенностьЗаРуководителя.ДолжностьРодительныйПадеж;
			//РуководительФИО = СтруктураПодписантов.ДоверенностьЗаРуководителя.ФИОПодписантаДляПротокола;
			РуководительДолжностьНаименованиеРП =  СтруктураПодписантов.ДоверенностьЗаРуководителя.ДолжностьРодительныйПадеж;
			РуководительФИОРП = СтруктураПодписантов.ДоверенностьЗаРуководителя.ФИОПодписантаДляПротокола;
			//Евросиб Каблов 16.12.2020 )			
			ЗаРуководителяНаОсновании = СтруктураПодписантов.ДоверенностьЗаРуководителя.ОснованиеДляПодписанияРП;
			РуководительОрг =  СтруктураПодписантов.ДоверенностьЗаРуководителя.ФИОПодписанта + Символы.ПС + ?(ЗначениеЗаполнено(СтруктураПодписантов.ЗаРуководителяНаОсновании), СтруктураПодписантов.ЗаРуководителяНаОсновании, СтруктураПодписантов.ДоверенностьЗаРуководителя.ОснованиеДляПодписания);
			Если НЕ СтруктураПодписантов.Свойство("БезФаксимиле")
				И ЗначениеЗаполнено(СтруктураПодписантов.ДоверенностьЗаРуководителя.ФайлФаксимиль) Тогда
				ДанныеКартинкиПодпись = РаботаСФайлами.ДанныеФайла(СтруктураПодписантов.ДоверенностьЗаРуководителя.ФайлФаксимиль);
				ДвоичныеДанныеПодпись = ПолучитьИзВременногоХранилища(ДанныеКартинкиПодпись.СсылкаНаДвоичныеДанныеФайла);
			КонецЕсли;
			
