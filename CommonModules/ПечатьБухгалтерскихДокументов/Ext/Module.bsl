Процедура УстановитьУДокументаПризнакВыставлен(Ссылка, УстанавливаемоеЗначение) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда // Литвинов 18.04.2021 ДНС, баг при отправке пакета с произвольным файлом
		Возврат;		
	КонецЕсли;
	
	МетаданныеДокумента = Ссылка.Метаданные();
	РеквизитВыставлен = МетаданныеДокумента.Реквизиты.Найти("Выставлен");
	Если РеквизитВыставлен <> Неопределено Тогда
				
		Выставлен = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Выставлен");
		Если Выставлен <> УстанавливаемоеЗначение Тогда
			ДокОбъект = Ссылка.ПолучитьОбъект();
			ДокОбъект.Выставлен = УстанавливаемоеЗначение;
			ДокОбъект.ДатаВыставления = ТекущаяДатаСеанса();
			ДокОбъект.ДополнительныеСвойства.Вставить("РазрешенаЗаписьВыставленного", Истина);
			//Евросиб - АСуслов 23.11.2020 12:33:57 #
			//(
			ДокОбъект.ОбменДанными.Загрузка = Истина;
			//)
			//Евросиб - АСуслов 23.11.2020 12:33:58 #
			ДокОбъект.Записать();
		КонецЕсли;
		
		//Установка признак Выставлен у документов оснований, при печати/отправке счета-фактуры
		Если МетаданныеДокумента.Имя = "СчетФактураВыданный" Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	СчетФактураВыданныйДокументыОснования.ДокументОснование КАК ДокументОснование
			|ИЗ
			|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
			|ГДЕ
			|	СчетФактураВыданныйДокументыОснования.Ссылка = &Ссылка
			|	И СчетФактураВыданныйДокументыОснования.ДокументОснование.Выставлен <> &Выставлен";
			Запрос.УстановитьПараметр("Ссылка", Ссылка);
			Запрос.УстановитьПараметр("Выставлен", УстанавливаемоеЗначение);
			Выборка = Запрос.Выполнить().Выбрать();
			
			Пока Выборка.Следующий() Цикл
				Выставлен = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.ДокументОснование, "Выставлен");
				Если Выставлен <> УстанавливаемоеЗначение Тогда
					ДокОбъект = Выборка.ДокументОснование.ПолучитьОбъект();
					ДокОбъект.Выставлен = УстанавливаемоеЗначение;
					ДокОбъект.ДатаВыставления = ТекущаяДатаСеанса();
					ДокОбъект.ДополнительныеСвойства.Вставить("ЗапретитьЗаписыватьСчетФактуру", Истина);
					ДокОбъект.ДополнительныеСвойства.Вставить("РазрешенаЗаписьВыставленного", Истина);
					//Евросиб - АСуслов 23.11.2020 12:33:57 #
					//(
					ДокОбъект.ОбменДанными.Загрузка = Истина;
					//)
					//Евросиб - АСуслов 23.11.2020 12:33:58 #
					ДокОбъект.Записать();
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

//Евросиб Каблов 10.07.2020 TASK 23506
Процедура Диадок_ДокументыПриЗаписи(Источник, Отказ) Экспорт
	
	Если Источник.Направление = "Исходящее" И Источник.Метка = "Отправлен" Тогда
		УстановитьУДокументаПризнакВыставлен(Источник.Документ, Истина);		
	КонецЕсли;
	
КонецПроцедуры
//Евросиб Максимова 19.02.2020
Функция ПроверитьВыводТабличногоДокумента(ТабДокумент, ВыводимыеОбласти, РезультатПриОшибке = Истина) Экспорт

	Попытка
		Возврат ТабДокумент.ПроверитьВывод(ВыводимыеОбласти);
	Исключение
		Возврат РезультатПриОшибке;
	КонецПопытки;

КонецФункции 

// Евросиб US 89967 TA 91565 Рыбьяков К.А. 03.10.2024 ((
Функция ДоступныеДляПечатиИОтправкиПоЭдо(Документы) Экспорт
	
	Результат = Новый Массив;
	
	Если КонтрольДоступностиДокументов_сервер.ПроверитьДоступностьРоли("dc_РазрешитьРедактированиеИСФ") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Реализации = Новый Массив;
	СчетаФактуры = Новый Массив;
	
	Для Каждого Документ Из Документы Цикл
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			Реализации.Добавить(Документ);
		КонецЕсли;
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
			СчетаФактуры.Добавить(Документ);
		КонецЕсли;
	КонецЦикла;
	
	Если Реализации.Количество() > 0 Тогда
		РеквизитыРеализации = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Реализации, "ДатаЗапретаПечатиИОтправкиПоЭДО");
		Для Каждого Реквизит Из РеквизитыРеализации Цикл
			Если Реквизит.Значение.ДатаЗапретаПечатиИОтправкиПоЭДО > ТекущаяДатаСеанса() Тогда
				Данные = Новый Структура;
				Данные.Вставить("Число", День(Реквизит.Значение.ДатаЗапретаПечатиИОтправкиПоЭДО - 1));
				Данные.Вставить("Ссылка", Реквизит.Ключ);
				Результат.Добавить(Данные);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если СчетаФактуры.Количество() > 0 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	СчетФактураВыданныйДокументыОснования.ДокументОснование КАК ДокументОснование,
		|	СчетФактураВыданныйДокументыОснования.Ссылка КАК Ссылка,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(СчетФактураВыданныйДокументыОснования.ДокументОснование) = ТИП(Документ.КорректировкаРеализации)
		|			ТОГДА ЕстьNULL(КорректировкаРТУ.ИсходныйДокументРеализации.ДатаЗапретаПечатиИОтправкиПоЭДО, ДАТАВРЕМЯ(1,1,1,0,0,0))
		|		КОГДА ТИПЗНАЧЕНИЯ(СчетФактураВыданныйДокументыОснования.ДокументОснование) = ТИП(Документ.РеализацияТоваровУслуг)
		|			ТОГДА РеализацияТоваровУслуг.ДатаЗапретаПечатиИОтправкиПоЭДО
		|		ИНАЧЕ ДАТАВРЕМЯ (1, 1, 1)
		|	КОНЕЦ КАК ДатаЗапретаПечатиИОтправкиПоЭДО
		|ИЗ
		|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|		ПО СчетФактураВыданныйДокументыОснования.ДокументОснование = РеализацияТоваровУслуг.Ссылка 
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации КАК КорректировкаРТУ
		|		ПО СчетФактураВыданныйДокументыОснования.ДокументОснование = КорректировкаРТУ.Ссылка
		|ГДЕ
		|	СчетФактураВыданныйДокументыОснования.Ссылка В(&СчетаФактуры)";
		
		Запрос.УстановитьПараметр("СчетаФактуры", СчетаФактуры);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Если Выборка.ДатаЗапретаПечатиИОтправкиПоЭДО > ТекущаяДатаСеанса() Тогда
				Данные = Новый Структура;
				Данные.Вставить("Число", День(Выборка.ДатаЗапретаПечатиИОтправкиПоЭДО - 1));
				Данные.Вставить("Ссылка", Выборка.Ссылка);
				Результат.Добавить(Данные);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;
	
КонецФункции
// Евросиб Рыбьяков К.А. 24.10.2024 ))
