		ИмяПараметровПечати = СтруктураПараметровПечати.ИмяПараметровПечати;
	Иначе
		// Значение по умолчанию:
		ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_РеализацияТоваровУслуг_Акт";
	КонецЕсли; 
	
