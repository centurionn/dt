Процедура РазложитьСтрокуВМассив(МассивТС, СтрокаДляОбработки)
	ПодстрокаПоиска = ";";
	Строка = СтрокаДляОбработки+";";
	Пока СтрНайти(Строка,ПодстрокаПоиска) <> 0 Цикл
		Значение = Лев(Строка,СтрДлина(Строка)-((СтрДлина(СТрока)-СтрНайти(Строка,ПодстрокаПоиска))+1));
		Строка = Прав(Строка, СтрДлина(Строка)-СтрНайти(Строка,ПодстрокаПоиска));
		Если МассивТС.Найти(Значение) = Неопределено Тогда
			МассивТС.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

