Функция ПолучитьНаиболееЧастоВстречающийсяРазделитель( Знач вхСтрока )
	МассивРазделителей = Новый Массив;
	МассивРазделителей.Добавить(" "); //пробел
	МассивРазделителей.Добавить(";"); //точка с запятой
	
	ТЗрасчета = Новый ТаблицаЗначений;
	ТЗрасчета.Колонки.Добавить("Разделитель", Новый ОписаниеТипов("Строка"));
	ТЗрасчета.Колонки.Добавить("КоличествоВхождений", Новый ОписаниеТипов("Число"));
	Для Каждого Разделитель Из МассивРазделителей Цикл
		строкаТЗ = ТЗрасчета.Добавить();
		строкаТЗ.Разделитель = Разделитель;
		строкаТЗ.КоличествоВхождений = СтрЧислоВхождений(вхСтрока, Разделитель);
	КонецЦикла;
	
	ТЗрасчета.Сортировать("КоличествоВхождений Убыв");
	Возврат ТЗрасчета[0].Разделитель;
КонецФункции
//ДИТ, Беляев СЮ, Ticket#0329728, 30-10-2023, конец

