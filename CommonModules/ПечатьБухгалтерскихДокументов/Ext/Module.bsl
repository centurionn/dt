Функция ПолучитьСписокМакетов(МассивОбъектов) Экспорт
	СписокМакетов = "";
	ЕстьСчетФактура981 = Ложь;
	ЕстьКорректировочныйСчетФактура981 = Ложь;

	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СчетФактураВыданный.Ссылка КАК Ссылка,
	                      |	СчетФактураВыданный.ВидСчетаФактуры КАК ВидСчетаФактуры
	                      |ИЗ
	                      |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	                      |ГДЕ
	                      |	СчетФактураВыданный.Ссылка В(&ДокументОснования)");
	Запрос.УстановитьПараметр("ДокументОснования", МассивОбъектов);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ВидСчетаФактуры = Перечисления.ВидСчетаФактурыВыставленного.НаРеализацию Тогда
			Если Не ЕстьСчетФактура981 Тогда
				СписокМакетов = СписокМакетов+?(СписокМакетов = "","СчетФактура981",",СчетФактура981");
			    ЕстьСчетФактура981 = Истина;
			КонецЕсли;
		ИначеЕсли Выборка.ВидСчетаФактуры = Перечисления.ВидСчетаФактурыВыставленного.Корректировочный Тогда
			Если Не ЕстьКорректировочныйСчетФактура981 Тогда
				СписокМакетов = СписокМакетов+?(СписокМакетов = "","КорректировочныйСчетФактура981",",КорректировочныйСчетФактура981");
			    ЕстьКорректировочныйСчетФактура981 = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат СписокМакетов;
КонецФункции

Функция ПолучитьСписокМакетовУПД(МассивОбъектов,ЭтоОснование) Экспорт
	
	СписокМакетов = "";
	ЕстьСчетФактура981 = Ложь;
	ЕстьКорректировочныйСчетФактура981 = Ложь;

	Если ЭтоОснование Тогда
		Запрос= Новый Запрос("ВЫБРАТЬ
		                     |	СчетФактураВыданный.Ссылка КАК Ссылка,
