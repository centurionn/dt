			Если Не ЕстьСчетФактура981 Тогда
				СписокМакетов = СписокМакетов+?(СписокМакетов = "","УниверсальныйПередаточныйДокумент981",",УниверсальныйПередаточныйДокумент981");
			    ЕстьСчетФактура981 = Истина;
			КонецЕсли;
		ИначеЕсли Выборка.ВидСчетаФактуры = Перечисления.ВидСчетаФактурыВыставленного.Корректировочный Тогда
			Если Не ЕстьКорректировочныйСчетФактура981 Тогда
				СписокМакетов = СписокМакетов+?(СписокМакетов = "","УниверсальныйКорректировочныйДокумент981",",УниверсальныйКорректировочныйДокумент981");
			    ЕстьКорректировочныйСчетФактура981 = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат СписокМакетов;
КонецФункции

Функция ПолучитьСписокМакетовУПДБезСчетФактуры(МассивОбъектов) Экспорт
	СписокМакетов = "";
	ЕстьСчетФактура981 = Ложь;
	ЕстьКорректировочныйСчетФактура981 = Ложь;
	Для каждого Эл Из МассивОбъектов Цикл
	Если ТипЗнч(Эл) = Тип("ДокументСсылка.РеализацияТоваровУслуг") или ТипЗнч(Эл) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
		Если Не ЕстьСчетФактура981 Тогда
			СписокМакетов = СписокМакетов+?(СписокМакетов = "","УниверсальныйПередаточныйДокумент981",",УниверсальныйПередаточныйДокумент981");
			ЕстьСчетФактура981 = Истина;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Эл) = Тип("ДокументСсылка.КорректировкаРеализации") и Эл.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки Тогда
		Если Не ЕстьСчетФактура981 Тогда
			СписокМакетов = СписокМакетов+?(СписокМакетов = "","УниверсальныйПередаточныйДокумент981",",УниверсальныйПередаточныйДокумент981");
			ЕстьСчетФактура981 = Истина;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Эл) = Тип("ДокументСсылка.КорректировкаРеализации") и Эл.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение Тогда		
		Если Не ЕстьКорректировочныйСчетФактура981 Тогда
			СписокМакетов = СписокМакетов+?(СписокМакетов = "","УниверсальныйКорректировочныйДокумент981",",УниверсальныйКорректировочныйДокумент981");
		    ЕстьКорректировочныйСчетФактура981 = Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат СписокМакетов;
КонецЦикла;
КонецФункции

