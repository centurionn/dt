Процедура ЗаполнитьРеквизитыОрганизации(Реквизиты, Организация, Период)
	Реквизиты.СтранаРегистрации = Справочники.СтраныМира.Россия;
	Реквизиты.ИНН = Организация.ИНН;
	//Евросиб - АСуслов 06.09.2023 12:57:48 #74705
	//(
	//Реквизиты.КПП = Организация.КПП;
	//)
	//Евросиб - АСуслов 06.09.2023 12:57:51 #74705
	Реквизиты.ОГРН = Организация.ОГРН;
//Евросиб ( Литвинов 21.01.2021 #30025
	//Реквизиты.ПолноеНаименование = Организация.НаименованиеПолное;
	//Реквизиты.СокращенноеНаименование = Организация.НаименованиеСокращенное;
	Наименования = Справочники.Организации.НаименованияНаДату(Организация, Период);
	Реквизиты.ПолноеНаименование 			= Наименования.НаименованиеПолное;
	Реквизиты.СокращенноеНаименование 		= Наименования.НаименованиеСокращенное;
	Реквизиты.ПолноеНаименованиеАнгл 		= Наименования.НаименованиеПолноеАнгл;
	Реквизиты.СокращенноеНаименованиеАнгл 	= Наименования.НаименованиеСокращенноеАнгл;
	//Евросиб - АСуслов 06.09.2023 12:58:06 #74705
	//(
	Реквизиты.КПП = Наименования.КПП;
	//)
	//Евросиб - АСуслов 06.09.2023 12:58:08 #74705
//Евросиб ) Литвинов 21.01.2021 #30025
	Реквизиты.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
	ЗаполнитьКонтактнуюИнформациюВРеквизитахКомпании(Реквизиты, Организация, Период);
		
КонецПроцедуры

Процедура ЗаполнитьРеквизитыКонтрагента(Реквизиты, Контрагент, Период)
	// Общие сведения
	ИменаРеквизитовПредпринимателя = "ДокументУдостоверяющийЛичность, СвидетельствоСерияНомер, СвидетельствоДатаВыдачи";
	ИменаРеквизитовОбъекта = "ЮридическоеФизическоеЛицо, Представление, ИНН, КПП, Наименование, НаименованиеПолное, КодПоОКПО, ОГРН, "
		+ "СтранаРегистрации, НалоговыйНомер, " + ИменаРеквизитовПредпринимателя;
		
	ЗначенияРеквизитовОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент, ИменаРеквизитовОбъекта);
	Реквизиты.НалоговыйНомерВСтранеРегистрации = ЗначенияРеквизитовОбъекта.НалоговыйНомер;
	ЗаполнитьЗначенияСвойств(Реквизиты, ЗначенияРеквизитовОбъекта, , ИменаРеквизитовПредпринимателя); // Все, кроме реквизитов предпринимателя
		// (некоторые свойства зависят от того, как оформлен бизнес контрагента)
	Если Реквизиты.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо Тогда
		ЗаполнитьЗначенияСвойств(Реквизиты, ЗначенияРеквизитовОбъекта, ИменаРеквизитовПредпринимателя);// Только реквизиты предпринимателя
	Иначе // Юридическое лицо
		Реквизиты.КПП = ЗначенияРеквизитовОбъекта.КПП;
	КонецЕсли;
	Реквизиты.НаименованиеДляПечатныхФорм = ?(ЗначениеЗаполнено(ЗначенияРеквизитовОбъекта.НаименованиеПолное),ЗначенияРеквизитовОбъекта.НаименованиеПолное,ЗначенияРеквизитовОбъекта.Наименование);
	
//Евросиб ( Литвинов 21.01.2021 #30025
	Реквизиты.ПолноеНаименованиеАнгл = Контрагент.НаименованиеПолноеАнгл;
//Евросиб ) Литвинов 21.01.2021 #30025

	ЗаполнитьКонтактнуюИнформациюВРеквизитахКомпании(Реквизиты, Контрагент, Период);
	
КонецПроцедуры

Процедура ЗаполнитьКонтактнуюИнформациюВРеквизитахКомпании(Реквизиты, Организация, Период)
	
	//<< Евросиб - Витвицкий 05.06.2019
	Если ТипЗнч(Организация) = Тип("СправочникСсылка.Контрагенты") Тогда
		ЮрАдрес = Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента;
		Телефон = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
	ИначеЕсли  ТипЗнч(Организация) = Тип("СправочникСсылка.Организации") Тогда
		ЮрАдрес = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации;
		Телефон = Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации;
	Иначе
		ВызватьИсключение "Необходимо обработать вид контактной информации для этого объекта";
	КонецЕсли;
	//Реквизиты.ЮридическийАдрес = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Организация,Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации, Период);
	//Реквизиты.Телефоны = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Организация,Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации, Период);
	Реквизиты.ЮридическийАдрес = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Организация,ЮрАдрес, Период);
	Реквизиты.Телефоны = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Организация,Телефон, Период);
	//>> Евросиб - Витвицкий 05.06.2019
КонецПроцедуры

