Функция ПолучитьОписаниеЦепочкиИсправления(КорректировкаСсылка, ФорматРезультата = "Строка" )
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КорректировкаРеализации.Ссылка КАК Ссылка,
		|	КорректировкаРеализации.ДокументРеализации КАК ДокументРеализации,
		|	КорректировкаРеализации.ИсходныйДокументРеализации КАК ИсходныйДокументРеализации
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	Документ.КорректировкаРеализации КАК КорректировкаРеализации
		|ГДЕ
		|	КорректировкаРеализации.Ссылка = &Ссылка
		|	И ВЫРАЗИТЬ(КорректировкаРеализации.ДокументРеализации КАК Документ.КорректировкаРеализации).ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СчетФактураВыданный.Ссылка КАК СФПервойКорректировки,
		|	СчетФактураВыданный.НомерИсправления КАК НомерИсправления,
		|	СчетФактураВыданный.ДатаДокумента КАК ДатаДокумента
		|ИЗ
		|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|ГДЕ
		|	СчетФактураВыданный.ДокументОснование В
		|			(ВЫБРАТЬ
		|				ВТ.ДокументРеализации
		|			ИЗ
		|				ВТ КАК ВТ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СчетФактураВыданный.Ссылка КАК СФИсходногоДокумента,
		|	СчетФактураВыданный.НомерДляПечати КАК НомерДляПечати,
		|	СчетФактураВыданный.ДатаДокумента КАК ДатаДокумента
		|ИЗ
		|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|ГДЕ
		|	СчетФактураВыданный.ДокументОснование В
		|			(ВЫБРАТЬ
		|				ВТ.ИсходныйДокументРеализации
		|			ИЗ
		|				ВТ КАК ВТ)";
	
	Запрос.УстановитьПараметр("Ссылка", КорректировкаСсылка);
	
	РезультатЗапросаПакет = Запрос.ВыполнитьПакет();
	РезультатЗапросаПервойКорректировки = РезультатЗапросаПакет[1];
	РезультатЗапросаИсходногоДокумента = РезультатЗапросаПакет[2];
	
	Если НЕ РезультатЗапросаПервойКорректировки.Пустой() И НЕ РезультатЗапросаИсходногоДокумента.Пустой() Тогда
		
		ВыборкаПервойКорректировки = РезультатЗапросаПервойКорректировки.Выбрать();
		ВыборкаПервойКорректировки.Следующий();
		
		ВыборкаИсходногоДокумента = РезультатЗапросаИсходногоДокумента.Выбрать();
		ВыборкаИсходногоДокумента.Следующий();
		
		Если ФорматРезультата = "Строка" Тогда
			Результат = СтрШаблон("%1 от %2, с учетом исправления №%3 от %4",
						ВыборкаИсходногоДокумента.НомерДляПечати,
						Формат(ВыборкаИсходногоДокумента.ДатаДокумента,"ДФ=dd.MM.yyyy"),
						ВыборкаПервойКорректировки.НомерИсправления,
						Формат(ВыборкаПервойКорректировки.ДатаДокумента,"ДФ=dd.MM.yyyy"));
		Иначе
			Результат = Новый Структура;
			Результат.Вставить("ИсходныйДокументНомерДляПечати", ВыборкаИсходногоДокумента.НомерДляПечати);
			Результат.Вставить("ИсходныйДокументДатаДокумента", Формат(ВыборкаИсходногоДокумента.ДатаДокумента,"ДФ=dd.MM.yyyy"));
			Результат.Вставить("ПерваяКорректировкаНомерИсправления", ВыборкаПервойКорректировки.НомерИсправления);
			Результат.Вставить("ПерваяКорректировкаДатаДокумента", Формат(ВыборкаПервойКорректировки.ДатаДокумента,"ДФ=dd.MM.yyyy"));
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
