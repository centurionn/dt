	Разделитель = ПолучитьНаиболееЧастоВстречающийсяРазделитель( ВыводимаяСтрока );
	ОбщийМассивСлов = СтрРазделить(ВыводимаяСтрока, Разделитель);
	
	Если ОбщийМассивСлов.Количество() <= 1 Тогда
		ВывестиПрисоединитьДанныеДляСтроки(ТабличныйДокумент, ВыводимаяОбласть, ПерваяОбластьСтроки, МассивПрисоединяемыхОбластей);
		Возврат;
	КонецЕсли;
	
	Попытка
		ПервыйВыводСтроки = Истина;
		Пока ОбщийМассивСлов.Количество()>0  Цикл
			//расчет подходящей строки
			ВременныйМассив = ОбщегоНазначения.СкопироватьРекурсивно(ОбщийМассивСлов);
			ВыводимаяОбласть.Параметры[ИмяПараметра] = СтрСоединить(ВременныйМассив, Разделитель);
			ПройденаПроверка = ОбщегоНазначения.ПроверитьВыводТабличногоДокумента(ТабличныйДокумент, ПроверяемаяОбласть);

			ВыполнитьУменьшениеМассиваСлов( ТабличныйДокумент, ВыводимаяОбласть, ПроверяемаяОбласть, Разделитель, ИмяПараметра, ВременныйМассив, ПройденаПроверка );
			
			//проверим что выводим последнюю страницу
			Если ПройденаПроверка 
				И ВременныйМассив.Количество() = ОбщийМассивСлов.Количество()
				И ПроверяемаяОбластьДляПоследнегоЛиста <> Неопределено Тогда
				ПройденаПроверка = ОбщегоНазначения.ПроверитьВыводТабличногоДокумента(ТабличныйДокумент, ПроверяемаяОбластьДляПоследнегоЛиста);
				ВыполнитьУменьшениеМассиваСлов( ТабличныйДокумент, ВыводимаяОбласть, ПроверяемаяОбластьДляПоследнегоЛиста, Разделитель, ИмяПараметра, ВременныйМассив, ПройденаПроверка );
			КонецЕсли;
			
			//вывод на печать
			Если НЕ ПервыйВыводСтроки И ПерваяОбластьСтроки <> Неопределено Тогда
				ТабличныйДокумент.Вывести(ПерваяОбластьСтроки);
			КонецЕсли;
			ВывестиПрисоединитьДанныеДляСтроки(ТабличныйДокумент, ВыводимаяОбласть, ПерваяОбластьСтроки, МассивПрисоединяемыхОбластей);
			
			//очистим параметры, чтобы выводилось только содержание услуги
			Если ПервыйВыводСтроки Тогда
				Если ПерваяОбластьСтроки <> Неопределено Тогда
					ОчиститьПараметрыОбласти(ПерваяОбластьСтроки);
				КонецЕсли;
				ОчиститьПараметрыОбласти(ВыводимаяОбласть);
				Для Каждого ПрисоединяемаяОбласть Из МассивПрисоединяемыхОбластей Цикл
					ОчиститьПараметрыОбласти(ПрисоединяемаяОбласть);
				КонецЦикла;
				ПервыйВыводСтроки = Ложь;
			КонецЕсли;

			//уменьшить общий массив слов
			Для индекс = 0 По ВременныйМассив.Количество()-1 Цикл
				ОбщийМассивСлов.Удалить(0);
			КонецЦикла;
			
			Если ОбщийМассивСлов.Количество()>0 Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
		КонецЦикла;
	Исключение
		ОбщегоНазначения.СообщитьПользователю("Ошибка формирования печатной формы: "+ОписаниеОшибки());
		ВывестиПрисоединитьДанныеДляСтроки(ТабличныйДокумент, ВыводимаяОбласть, ПерваяОбластьСтроки, МассивПрисоединяемыхОбластей);
	КонецПопытки;
КонецПроцедуры
//ДИТ, Беляев СЮ, Ticket#0329728, 30-10-2023, конец

