//Евросиб(ДИТ), Беляев СЮ, US 90032 / TA 108264, 29-04-2025, начало
Функция ПолучитьСвязанныйСтатусДляУзлаОбмена(УзелОбмена, Статус)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СтатусыДокументовСоспоставлениеСтатусов.СтатусДокумента КАК СтатусДокумента
		|ИЗ
		|	Справочник.СтатусыДокументов.СоспоставлениеСтатусов КАК СтатусыДокументовСоспоставлениеСтатусов
		|ГДЕ
		|	СтатусыДокументовСоспоставлениеСтатусов.УзелОбмена = &УзелОбмена
		|	И СтатусыДокументовСоспоставлениеСтатусов.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Статус);
	Запрос.УстановитьПараметр("УзелОбмена", УзелОбмена);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Результат = Выборка.СтатусДокумента;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
