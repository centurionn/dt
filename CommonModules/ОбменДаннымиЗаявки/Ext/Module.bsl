Функция НайтиСоздатьМенеджера(МенеджерXDTO)
	
	НайденныйМенеджер = Справочники.Пользователи.ПустаяСсылка();
	
	//ПОИСК ПО ГУИД
	Если ЗначениеЗаполнено(МенеджерXDTO.МенеджерГУИД) Тогда
		НайденныйМенеджер = Справочники.Пользователи.ПолучитьСсылку(Новый УникальныйИдентификатор(МенеджерXDTO.МенеджерГУИД));
	КонецЕсли;
	
	//ПОИСК ПО E-MAIL
	Если НайденныйМенеджер = Справочники.Пользователи.ПустаяСсылка() И ЗначениеЗаполнено(МенеджерXDTO.АдресЭлектроннойПочты) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ПользователиКонтактнаяИнформация.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
			|ГДЕ
			|	ПользователиКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
			|	И ПользователиКонтактнаяИнформация.Представление = &Представление";
		
		Запрос.УстановитьПараметр("Представление", МенеджерXDTO.АдресЭлектроннойПочты);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			НайденныйМенеджер = Выборка.Ссылка;
		КонецЕсли;
	
	КонецЕсли;
	
	//СОЗДАНИЕ МЕНЕДЖЕРА
	Если НайденныйМенеджер = Справочники.Пользователи.ПустаяСсылка() И ЗначениеЗаполнено(МенеджерXDTO.АдресЭлектроннойПочты) И ЗначениеЗаполнено(МенеджерXDTO.МенеджерФИО) Тогда
		
		НовыйПользователь = Справочники.Пользователи.СоздатьЭлемент();
		НовыйПользователь.Наименование = МенеджерXDTO.МенеджерФИО;
		НовыйПользователь.Недействителен = Истина;
		СтрокаАдреса = НовыйПользователь.КонтактнаяИнформация.Добавить();
		СтрокаАдреса.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		СтрокаАдреса.Вид = Справочники.ВидыКонтактнойИнформации.EmailПользователя;
		СтрокаАдреса.Представление = МенеджерXDTO.АдресЭлектроннойПочты;
		НовыйПользователь.ОбменДанными.Загрузка = Истина;
		НовыйПользователь.Записать();
		
		НайденныйМенеджер = НовыйПользователь.Ссылка;
	КонецЕсли;
	
	Возврат НайденныйМенеджер;
	
КонецФункции

