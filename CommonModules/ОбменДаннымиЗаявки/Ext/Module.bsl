//Евросиб(ДИТ), Беляев СЮ, US 92704 / TA 101723, 11-02-2025, начало
Функция ПодтвердитьЗагрузкуДокументовВУзелОбмена(XMLParams) Экспорт

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("СписокГУИД", "");
	СтруктураПараметров.Вставить("ИсточникЗапроса", "");
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(XMLParams);
	
	ОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(Чтение);
	
	МассивОшибок = Новый Массив;
	МассивУспешноОбработанных = Новый Массив;
	
	Если ОбъектXDTO.Свойства().Получить("ИсточникЗапроса") <> Неопределено Тогда
		СтруктураПараметров.Вставить("ИсточникЗапроса", ОбъектXDTO.ИсточникЗапроса);
	КонецЕсли;
	Если ОбъектXDTO.Свойства().Получить("СписокГУИД") <> Неопределено Тогда
		СтруктураПараметров.Вставить("СписокГУИД", ОбъектXDTO.СписокГУИД);
	Иначе
		МассивОшибок.Добавить("Не указан список ГУИД");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтруктураПараметров.ИсточникЗапроса) Тогда
		МассивОшибок.Добавить("Не указан источник запроса");
	КонецЕсли;
	
	Если МассивОшибок.Количество()>0 Тогда
		Возврат СформироватьСообщениеОПодтверждении(МассивОшибок, МассивУспешноОбработанных);
	КонецЕсли;
	
	УзелОбмена = Неопределено;
	Для каждого ЗначПеречисления Из Метаданные.Перечисления.УзлыОбмена.ЗначенияПеречисления Цикл
		Если ЗначПеречисления.Имя = СтруктураПараметров.ИсточникЗапроса Тогда
			УзелОбмена = Перечисления.УзлыОбмена[ЗначПеречисления.Имя];
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	
	Если УзелОбмена = Неопределено Тогда
		МассивОшибок.Добавить("Не найден узел обмена для источника запроса "+СтруктураПараметров.ИсточникЗапроса);
		Возврат СформироватьСообщениеОПодтверждении(МассивОшибок, МассивУспешноОбработанных);
	КонецЕсли;
	
	УзелПланаОбмена = ПланыОбмена.ОбменЗаявками.ПолучитьУзелОбмена(УзелОбмена);
	Если Не ЗначениеЗаполнено(УзелПланаОбмена) Тогда	
		МассивОшибок.Добавить("Не настроен узел плана обмена для "+СтруктураПараметров.ИсточникЗапроса);
		Возврат СформироватьСообщениеОПодтверждении(МассивОшибок, МассивУспешноОбработанных);
	КонецЕсли;
	
	Если ТипЗнч(ОбъектXDTO.СписокГУИД.ГУИД) = Тип("Строка") Тогда
		
		ПодтвердитьЗагрузкуПоГУИД(ОбъектXDTO.СписокГУИД.ГУИД, УзелОбмена, УзелПланаОбмена, МассивОшибок, МассивУспешноОбработанных);
		
	ИначеЕсли ТипЗнч(ОбъектXDTO.СписокГУИД.ГУИД) = Тип("СписокXDTO") Тогда
		
		Для Каждого ТекГуид Из ОбъектXDTO.СписокГУИД.ГУИД Цикл

			ПодтвердитьЗагрузкуПоГУИД(ТекГуид, УзелОбмена, УзелПланаОбмена, МассивОшибок, МассивУспешноОбработанных);
			
		КонецЦикла;
		
	КонецЕсли;
		
	Возврат СформироватьСообщениеОПодтверждении(МассивОшибок, МассивУспешноОбработанных);
	
КонецФункции
