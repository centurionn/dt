Процедура СоздатьКлючиАналитикиПервозкиЗаявки(ЗаявкаОбъект)
	Для Каждого Стр Из ЗаявкаОбъект.СоставУслуги Цикл 
		СтруктураКлючаАналитикиПеревозки = Справочники.КлючиАналитикиПеревозки.СтруктураКлючаАналитикиПеревозки();
		СтруктураКлючаАналитикиПеревозки.Контейнер = Стр.НомерКТК;
		СтруктураКлючаАналитикиПеревозки.КлючАналитики = Стр.КлючАналитикиПеревозки;
		СтруктураКлючаАналитикиПеревозки.Груз_ЕТСНГ = Стр.КодГруза;
		СтруктураКлючаАналитикиПеревозки.Груз_ГНГ = Стр.ГрузПоГНГ;
		//Евросиб Шевченко А.В. US 124456 TA 125854 10.12.2025
		//СтруктураКлючаАналитикиПеревозки.Груз_ТНВЭД = Стр.ГрузПоТНВЭД;
		СтруктураКлючаАналитикиПеревозки.Груз_ТНВЭД = Стр.КодГрузПоТНВЭД;
		//Евросиб Шевченко А.В. US 124456 TA 125854 10.12.2025
		//Евросиб(ДИТ), Беляев СЮ, US 92704 / TA 103849, 28-04-2025, начало
		СтруктураКлючаАналитикиПеревозки.КоличествоМест = Стр.КоличествоМест; 
		СтруктураКлючаАналитикиПеревозки.ВесГруза = Стр.ВесГрузаНетто;
