#Область ПрограммныйИнтерфейс
//Евросиб(ДИТ), Беляев СЮ, US 90031 / TA 101224, 31-01-2025, начало
Функция СоздатьЗапросНаПолучениеНомера(XMLParams) Экспорт
	
	ОтветГУИД = "";
	ОтветМассивСтрокИнформирование = Новый Массив;
	ОтветФлагОшибки = Ложь;
	
	//от внешней системы приходит запрос на получение номера в файле гуид КА из БФ, имя системы запрашивающей данные
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ГУИД_Контрагента", "");
	СтруктураПараметров.Вставить("ИсточникЗапроса", "");
	//Евросиб Шевченко А.В. US 117988 TA 118023 27.08.2025
	СтруктураПараметров.Вставить("ИдентификаторЗаявки", "");
	//Евросиб Шевченко А.В. US 117988 TA 118023 27.08.2025
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(XMLParams);
	
	ОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(Чтение);
	
	Если ОбъектXDTO.Свойства().Получить("ГУИД_Контрагента") <> Неопределено Тогда
		СтруктураПараметров.Вставить("ГУИД_Контрагента", ОбъектXDTO.ГУИД_Контрагента);
	КонецЕсли;
	Если ОбъектXDTO.Свойства().Получить("ИсточникЗапроса") <> Неопределено Тогда
		СтруктураПараметров.Вставить("ИсточникЗапроса", ОбъектXDTO.ИсточникЗапроса);
	КонецЕсли;
	//Евросиб Шевченко А.В. US 117988 TA 118023 27.08.2025
	Если ОбъектXDTO.Свойства().Получить("ИдентификаторЗаявки") <> Неопределено Тогда
		СтруктураПараметров.Вставить("ИдентификаторЗаявки", ОбъектXDTO.ИдентификаторЗаявки);
	КонецЕсли;
	//Евросиб Шевченко А.В. US 117988 TA 118023 27.08.2025
	Для Каждого Параметр Из СтруктураПараметров Цикл
		//Евросиб Шевченко А.В. US 117988 TA 118023 27.08.2025
		Если Параметр.Ключ = "ИдентификаторЗаявки" Тогда
			Продолжить;
		КонецЕсли;	
		//Евросиб Шевченко А.В. US 117988 TA 118023 27.08.2025
		Если НЕ ЗначениеЗаполнено(Параметр.Значение) Тогда
			ОтветФлагОшибки = Истина;
			ОтветМассивСтрокИнформирование.Добавить("не указан параметр " + Параметр.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	КонтрагентСсылка = Неопределено;
	ИсточникЗапросаСсылка = Неопределено;
	Если НЕ ОтветФлагОшибки Тогда
		
		КонтрагентСсылка = РегистрыСведений.ПротоколОбменов.СсылкаПоУИД(СтруктураПараметров.ГУИД_Контрагента, 
																			Перечисления.ДействияПриОбмене.ЗагрузкаДанных, 
																			Перечисления.УзлыОбмена.БитФинанс, 
																			Тип("СправочникСсылка.Контрагенты"));
		
		Если КонтрагентСсылка = Неопределено 
			Или ТипЗнч(КонтрагентСсылка) <> Тип("СправочникСсылка.Контрагенты")
			Или КонтрагентСсылка = Справочники.Контрагенты.ПустаяСсылка() Тогда
				ОтветФлагОшибки = Истина;
				ОтветМассивСтрокИнформирование.Добавить("не найден контрагент по ГУИД = " + СтруктураПараметров.ГУИД_Контрагента);
		КонецЕсли;
		
		ИсточникЗапросаСсылка = ПолучитьПеречислениеУзелОбменаПоИмени(СтруктураПараметров.ИсточникЗапроса);
		Если ИсточникЗапросаСсылка = Неопределено Тогда
			ОтветФлагОшибки = Истина;
			ОтветМассивСтрокИнформирование.Добавить("не найден Источник запроса по имени " + СтруктураПараметров.ИсточникЗапроса);
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ОтветФлагОшибки Тогда
		
		//Евросиб Шевченко А.В. US 117988 TA 118023 27.08.2025
		
		//РезультатЗапроса = РегистрыСведений.ВнешниеНомераЗаявок.ПолучитьНомерЗаявкиПоИдентификаторуЗаявкиИКонтрагенту(СтруктураПараметров.ИдентификаторЗаявки,КонтрагентСсылка,ИсточникЗапросаСсылка);
	
		//Если НЕ РезультатЗапроса.Успешно Тогда			
		СтруктураПараметров.Вставить("Контрагент", КонтрагентСсылка);
		СтруктураПараметров.Вставить("ИсточникЗапросаСсылка", ИсточникЗапросаСсылка);
		РезультатЗапроса = РегистрыСведений.ВнешниеНомераЗаявок.ЗафиксироватьЗапросНомераЗаявки(СтруктураПараметров); 	
		//КонецЕсли;
		//Евросиб Шевченко А.В. US 117988 TA 118023 27.08.2025
		Если НЕ РезультатЗапроса.Успешно Тогда
			ОтветМассивСтрокИнформирование.Добавить(РезультатЗапроса.ТекстИнформирования);
			ОтветФлагОшибки = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ТекстОшибки = СтрСоединить(ОтветМассивСтрокИнформирование, "; ");
	
	Если НЕ ОтветФлагОшибки Тогда
		//отдаем зарезервированный гуид документа, номер заявки (итоговый номер  из РС) 
		СтрокаXML = ОтветноеСообщениеНаПолучениеНомера(РезультатЗапроса.ГУИД_Заявки, РезультатЗапроса.НомерЗаявки, ОтветФлагОшибки, ТекстОшибки);
	Иначе
		//возвращать ошибку если в запросе не заполнены данные, или если не найдены КА или имя ИС 
		СтрокаXML = ОтветноеСообщениеНаПолучениеНомера("", "", ОтветФлагОшибки, ТекстОшибки);
	КонецЕсли;

	Возврат СтрокаXML;
	
КонецФункции
//Евросиб(ДИТ), Беляев СЮ, US 90031 / TA 101224, 31-01-2025, конец

//Евросиб(ДИТ), Беляев СЮ, US 90031 / TA 101224, 31-01-2025, начало
Функция ОбразецЗапросаИОтветаНомераЗаявки() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ЗапросНомераЗаявки","");
	Результат.Вставить("ОтветНаЗапрос","");
	
	//ЗапросНомераЗаявки
	ЗаписьXML = Новый ЗаписьXML; 
	ЗаписьXML.УстановитьСтроку();
	ЗаписьXML.ЗаписатьОбъявлениеXML();	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ЗапросНомераЗаявки");
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ГУИД_Контрагента");
	ЗаписьXML.ЗаписатьТекст(XMLСтрока(Новый УникальныйИдентификатор));
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ИсточникЗапроса");
	ЗаписьXML.ЗаписатьТекст("ЛК");
	ЗаписьXML.ЗаписатьКонецЭлемента();

	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	Результат.ЗапросНомераЗаявки = ЗаписьXML.Закрыть();
	
	//ОтветНаЗапрос
	ГУИД_Документа = Новый УникальныйИдентификатор;
	Результат.ОтветНаЗапрос = ОтветноеСообщениеНаПолучениеНомера(ГУИД_Документа, "ABBREVEAT_999999", Ложь, "...");
	
	Возврат Результат;
	
КонецФункции
//Евросиб(ДИТ), Беляев СЮ, US 90031 / TA 101224, 31-01-2025, конец

//Евросиб(ДИТ), Беляев СЮ, US 90031 / TA 101224, 31-01-2025, начало
Функция ВыгрузитьЗаявки(XMLParams) Экспорт
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ГУИД", "");
	СтруктураПараметров.Вставить("ИсточникЗапроса", "");
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(XMLParams);
	
	ОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(Чтение);
	
	Если ОбъектXDTO.Свойства().Получить("ИсточникЗапроса") <> Неопределено Тогда
		СтруктураПараметров.Вставить("ИсточникЗапроса", ОбъектXDTO.ИсточникЗапроса);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтруктураПараметров.ИсточникЗапроса) Тогда
		Возврат СформироватьСообщениеОшибкиЗапросаНаВыгрузку("Не указан источник запроса");
	КонецЕсли;
	
	УзелОбмена = Неопределено;
	Для каждого ЗначПеречисления Из Метаданные.Перечисления.УзлыОбмена.ЗначенияПеречисления Цикл
		Если ЗначПеречисления.Имя = СтруктураПараметров.ИсточникЗапроса Тогда
			УзелОбмена = Перечисления.УзлыОбмена[ЗначПеречисления.Имя];
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	
	Если УзелОбмена = Неопределено Тогда
		Возврат СформироватьСообщениеОшибкиЗапросаНаВыгрузку("Не найден узел обмена для источника запроса "+СтруктураПараметров.ИсточникЗапроса);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Если ЗначениеЗаполнено(СтруктураПараметров.ГУИД) Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПротоколОбменов.Объект КАК Заявка
		//|ПОМЕСТИТЬ ВТ_Заявки
		|ИЗ
		|	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
		|ГДЕ
		|	ПротоколОбменов.УИДИсточника = &ГУИД
		|	И ПротоколОбменов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных)
		|	И ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.ЛК)";
		Запрос.УстановитьПараметр("ГУИД", СтруктураПараметров.ГУИД);
		
	Иначе
		
		УзлыПланаОбмена = ПланыОбмена.ОбменЗаявками.ПолучитьУзелОбмена(УзелОбмена);
		Если Не ЗначениеЗаполнено(УзлыПланаОбмена) Тогда
			Возврат СформироватьСообщениеОшибкиЗапросаНаВыгрузку("Не настроен узел плана обмена для "+СтруктураПараметров.ИсточникЗапроса);
		КонецЕсли;
		
		УзелПланаОбмена = УзлыПланаОбмена[0];
				
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаявкаИзменения.Ссылка КАК Ссылка
		//|ПОМЕСТИТЬ ВТ_Заявки
		|ИЗ
		|	Документ.Заявка.Изменения КАК ЗаявкаИзменения
		|ГДЕ
		|	ЗаявкаИзменения.Узел = &УзелПланаОбмена
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВидыПеревозокИзменения.Ссылка
		|ИЗ
		|	Справочник.ВидыПеревозок.Изменения КАК ВидыПеревозокИзменения
		|ГДЕ
		|	ВидыПеревозокИзменения.Узел = &УзелПланаОбмена
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ГрузыИзменения.Ссылка
		|ИЗ
		|	Справочник.Грузы.Изменения КАК ГрузыИзменения
		|ГДЕ
		|	ГрузыИзменения.Узел = &УзелПланаОбмена
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЛокацииИзменения.Ссылка
		|ИЗ
		|	Справочник.Локации.Изменения КАК ЛокацииИзменения
		|ГДЕ
		|	ЛокацииИзменения.Узел = &УзелПланаОбмена
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СервисыУчетноеНаправлениеИзменения.Ссылка
		|ИЗ
		|	Справочник.СервисыУчетноеНаправление.Изменения КАК СервисыУчетноеНаправлениеИзменения
		|ГДЕ
		|	СервисыУчетноеНаправлениеИзменения.Узел = &УзелПланаОбмена
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТипоразмерыТЕИзменения.Ссылка
		|ИЗ
		|	Справочник.ТипоразмерыТЕ.Изменения КАК ТипоразмерыТЕИзменения
		|ГДЕ
		|	ТипоразмерыТЕИзменения.Узел = &УзелПланаОбмена";
		Запрос.УстановитьПараметр("УзелПланаОбмена", УзелПланаОбмена);
		
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Запись = Новый ЗаписьXML; 
	Запись.УстановитьСтроку();
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьНачалоЭлемента("Данные");
	
	Пока Выборка.Следующий() Цикл
		
		//ТипСсылкиОпределен = Истина;
		//Евросиб(ДИТ), Беляев СЮ, US 101347 / TA 115452, 30-07-2025, начало
		РегистрироватьВПротоколОбменов = Ложь;
		//Евросиб(ДИТ), Беляев СЮ, US 101347 / TA 115452, 30-07-2025, конец
		Если ТипЗнч(Выборка.Ссылка) = Тип("ДокументСсылка.Заявка") Тогда
			ДобавитьДанныеЗаявки(Запись, Выборка.Ссылка, УзелОбмена);
			//Евросиб(ДИТ), Беляев СЮ, US 101347 / TA 115452, 30-07-2025, начало
			РегистрироватьВПротоколОбменов = Истина;
			//Евросиб(ДИТ), Беляев СЮ, US 101347 / TA 115452, 30-07-2025, конец
		ИначеЕсли ТипЗнч(Выборка.Ссылка) = Тип("СправочникСсылка.Локации") Тогда
			ДобавитьСправочникЛокации(Запись, Выборка.Ссылка);
		ИначеЕсли ТипЗнч(Выборка.Ссылка) = Тип("СправочникСсылка.Грузы") Тогда
			ДобавитьСправочникГрузы(Запись, Выборка.Ссылка);
		ИначеЕсли ТипЗнч(Выборка.Ссылка) = Тип("СправочникСсылка.ВидыПеревозок") Тогда
			ДобавитьСправочникВидыПеревозок(Запись, Выборка.Ссылка);
		ИначеЕсли ТипЗнч(Выборка.Ссылка) = Тип("СправочникСсылка.СервисыУчетноеНаправление") Тогда
			ДобавитьСправочникСервисыУчетноеНаправление(Запись, Выборка.Ссылка);
		ИначеЕсли ТипЗнч(Выборка.Ссылка) = Тип("СправочникСсылка.ТипоразмерыТЕ") Тогда
			ДобавитьСправочникТипоразмерыТЕ(Запись, Выборка.Ссылка);
		Иначе
			//ТипСсылкиОпределен = Ложь;
		КонецЕсли;	
		
		//Если ТипСсылкиОпределен Тогда
		//Евросиб(ДИТ), Беляев СЮ, US 101347 / TA 115452, 30-07-2025, начало
		Если РегистрироватьВПротоколОбменов Тогда
		//Евросиб(ДИТ), Беляев СЮ, US 101347 / TA 115452, 30-07-2025, конец
			ГУИД = XMLСтрока(Выборка.Ссылка);
			СтруктураПоиска = Новый Структура("ДействиеПриОбмене, УзелОбмена, Объект", Перечисления.ДействияПриОбмене.ВыгрузкаДанных, УзелОбмена, Выборка.Ссылка);
			СтруктураДанных = Новый Структура("УИДИсточника, ЗагрузкаПодтверждена, ДатаОбмена", ГУИД, Ложь, ТекущаяДата());
			РегистрыСведений.ПротоколОбменов.ЗафиксироватьИнформациюОЗагрузке(СтруктураПоиска, СтруктураДанных);
		Иначе
			//Евросиб(ДИТ), Беляев СЮ, US 101347 / TA 115452, 30-07-2025, начало
			//убираем сразу регистрацию из плана, загрузку таких данных не подтверждают внешние системы
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелПланаОбмена, Выборка.Ссылка);
			//Евросиб(ДИТ), Беляев СЮ, US 101347 / TA 115452, 30-07-2025, конец
		КонецЕсли;
	
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента(); //Данные
	
	СообщениеXML = Запись.Закрыть();
	
	Возврат СообщениеXML;
	
КонецФункции
//Евросиб(ДИТ), Беляев СЮ, US 90031 / TA 101224, 31-01-2025, конец

//Евросиб(ДИТ), Беляев СЮ, US 90031 / TA 101224, 31-01-2025, начало
Функция ОбновитьДанныеЗаявки(XMLParams) Экспорт
	
	СтруктураПараметров = Новый Структура;
	//СтруктураПараметров.Вставить("ГУИД", "");
	СтруктураПараметров.Вставить("ИсточникЗапроса", "");
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(XMLParams);
	
	ОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(Чтение);
	
	Если ОбъектXDTO.Свойства().Получить("ИсточникЗапроса") <> Неопределено Тогда
		СтруктураПараметров.Вставить("ИсточникЗапроса", ОбъектXDTO.ИсточникЗапроса);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтруктураПараметров.ИсточникЗапроса) Тогда
		Возврат СформироватьСообщениеОшибкиЗапросаНаВыгрузку("Не указан источник запроса");
	КонецЕсли;
	
	УзелОбмена = Неопределено;
	Для каждого ЗначПеречисления Из Метаданные.Перечисления.УзлыОбмена.ЗначенияПеречисления Цикл
		Если ЗначПеречисления.Имя = СтруктураПараметров.ИсточникЗапроса Тогда
			УзелОбмена = Перечисления.УзлыОбмена[ЗначПеречисления.Имя];
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если УзелОбмена = Неопределено Тогда
		Возврат СформироватьСообщениеОшибкиЗапросаНаВыгрузку("Не найден узел обмена для источника запроса "+СтруктураПараметров.ИсточникЗапроса);
	КонецЕсли;
	
	МассивРезультатовЗагрузки = Новый Массив;
	
	Если ОбъектXDTO.Свойства().Получить("Заявка") <> Неопределено Тогда
		
		Если ТипЗнч(ОбъектXDTO.Заявка) = Тип("ОбъектXDTO") Тогда
			
			РезультатЗагрузки = ЗагрузитьОбновитьДанныеЗаявки(ОбъектXDTO.Заявка, УзелОбмена);
			МассивРезультатовЗагрузки.Добавить(РезультатЗагрузки);
			
