	ЗаписьXML.ЗаписатьТекст(НомерЗаявки);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ФлагОшибки");
	ЗаписьXML.ЗаписатьТекст(XMLСтрока(ФлагОшибки));
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
