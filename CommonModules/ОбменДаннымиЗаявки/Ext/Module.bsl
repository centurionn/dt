Функция КэшПеречислений(ВидПоиска = "ПоискИмениПоПеречислению")
	
	Результат = Новый Структура;
	
	КэшИменаУсловийПеревозкиКТК = Новый Соответствие;
	Для Каждого ТекПеречисление Из Перечисления.УсловияПеревозкиКТК Цикл
		Если ВидПоиска = "ПоискПеречисленияПоИмени" Тогда
			КэшИменаУсловийПеревозкиКТК.Вставить(ОбщегоНазначения.ИмяЗначенияПеречисления(ТекПеречисление), ТекПеречисление);
		Иначе
			КэшИменаУсловийПеревозкиКТК.Вставить(ТекПеречисление, ОбщегоНазначения.ИмяЗначенияПеречисления(ТекПеречисление));
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("КэшИменаУсловийПеревозкиКТК", КэшИменаУсловийПеревозкиКТК);
	
	КэшИменаУсловийПеревозкиПоПортам = Новый Соответствие;
	Для Каждого ТекПеречисление Из Перечисления.УсловияПеревозкиПоПортам Цикл
		Если ВидПоиска = "ПоискПеречисленияПоИмени" Тогда
			КэшИменаУсловийПеревозкиПоПортам.Вставить(ОбщегоНазначения.ИмяЗначенияПеречисления(ТекПеречисление), ТекПеречисление);
		Иначе
			КэшИменаУсловийПеревозкиПоПортам.Вставить(ТекПеречисление, ОбщегоНазначения.ИмяЗначенияПеречисления(ТекПеречисление));
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("КэшИменаУсловийПеревозкиПоПортам", КэшИменаУсловийПеревозкиПоПортам);
	
	КэшИменаУсловийIncoterms = Новый Соответствие;
	Для Каждого ТекПеречисление Из Перечисления.УсловияIncoterms Цикл
		Если ВидПоиска = "ПоискПеречисленияПоИмени" Тогда
			КэшИменаУсловийIncoterms.Вставить(ОбщегоНазначения.ИмяЗначенияПеречисления(ТекПеречисление), ТекПеречисление);
		Иначе
			КэшИменаУсловийIncoterms.Вставить(ТекПеречисление, ОбщегоНазначения.ИмяЗначенияПеречисления(ТекПеречисление));
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("КэшИменаУсловийIncoterms", КэшИменаУсловийIncoterms);
	
	КэшИменаПринадлежностьТЕ = Новый Соответствие;
	Если ВидПоиска = "ПоискПеречисленияПоИмени" Тогда
		КэшИменаПринадлежностьТЕ.Вставить("SOC", Перечисления.ПринадлежностьТЕ.КТКлиента);
		КэшИменаПринадлежностьТЕ.Вставить("COC", Перечисления.ПринадлежностьТЕ.КТЕвросиба);
	Иначе
		КэшИменаПринадлежностьТЕ.Вставить(Перечисления.ПринадлежностьТЕ.КТКлиента, "SOC");
		КэшИменаПринадлежностьТЕ.Вставить(Перечисления.ПринадлежностьТЕ.КТЕвросиба, "COC");
	КонецЕсли;
	Результат.Вставить("КэшИменаПринадлежностьТЕ", КэшИменаПринадлежностьТЕ);
	
	Возврат Результат;
	
КонецФункции

