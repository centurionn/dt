Функция СформироватьСообщениеОПодтверждении(МассивОшибок, МассивУспешноОбработанных)
	
	ФлагОшибки = МассивОшибок.Количество() > 0;
	
	Запись = Новый ЗаписьXML; 
	Запись.УстановитьСтроку();
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьНачалоЭлемента("РезультатОбработки");
	
	Запись.ЗаписатьНачалоЭлемента("ФлагОшибки");
	Запись.ЗаписатьТекст(XMLСтрока(ФлагОшибки));
	Запись.ЗаписатьКонецЭлемента();
	
	Запись.ЗаписатьНачалоЭлемента("Ошибки");
	Для Каждого ТекОшибка Из МассивОшибок Цикл
		Запись.ЗаписатьНачалоЭлемента("Ошибка");
		Запись.ЗаписатьТекст(ТекОшибка);
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента();
	
	Запись.ЗаписатьНачалоЭлемента("Подтвержденные");
	Для Каждого ТекГУИД Из МассивУспешноОбработанных Цикл
		Запись.ЗаписатьНачалоЭлемента("Подтвержден");
		Запись.ЗаписатьТекст(ТекГУИД);
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента();
	
	Запись.ЗаписатьКонецЭлемента();
	
	Возврат Запись.Закрыть();
	
КонецФункции
