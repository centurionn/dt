		ЗаписьXML.ЗаписатьНачалоЭлемента("ГУИД_Документа");
		ЗаписьXML.ЗаписатьТекст(ТекРезультат.ГУИД);
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
