//Евросиб(ДИТ), Беляев СЮ, US 92704 / TA 101723, 11-02-2025, начало
Процедура ПодтвердитьЗагрузкуПоГУИД(ТекГуид, УзелОбмена, УзелПланаОбмена, МассивОшибок, МассивУспешноОбработанных)
	
	СсылкаНаОбъект = РегистрыСведений.ПротоколОбменов.СсылкаПоУИД(ТекГуид, Перечисления.ДействияПриОбмене.ВыгрузкаДанных, УзелОбмена);
	Если СсылкаНаОбъект = Неопределено Тогда
		МассивОшибок.Добавить("Не найден объект по ГУИД "+ ТекГуид );
		Возврат;
	Иначе
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(СсылкаНаОбъект);
	КонецЕсли;
	
	ТекстОшибки = "";
	ПодвержденаЗагрузка = ПодтвердитьЗагрузкуДокумента(СсылкаНаОбъект, ТекГуид, МенеджерОбъекта, УзелОбмена, УзелПланаОбмена, ТекстОшибки);
	
	Если НЕ ПодвержденаЗагрузка Тогда
		МассивОшибок.Добавить(ТекстОшибки);
	Иначе
		МассивУспешноОбработанных.Добавить(ТекГуид);
	КонецЕсли;
	
КонецПроцедуры
//Евросиб(ДИТ), Беляев СЮ, US 92704 / TA 101723, 11-02-2025, конец

//Евросиб(ДИТ), Беляев СЮ, US 92704 / TA 101723, 11-02-2025, начало
Функция ПодтвердитьЗагрузкуДокумента(СсылкаНаОбъект, ГУИД, МенеджерОбъекта, УзелОбмена, УзелПланаОбмена, ТекстРезультат)
	
	ВыгрузкаДанных = Перечисления.ДействияПриОбмене.ВыгрузкаДанных;
	
	ПланыОбмена.УдалитьРегистрациюИзменений(УзелПланаОбмена, СсылкаНаОбъект);
	ПодтвердитьЗагрузкуОбъектаПоГУИДБезПроведения(ГУИД, ВыгрузкаДанных, УзелОбмена, СсылкаНаОбъект);
	
	Возврат Истина;
			
КонецФункции
//Евросиб(ДИТ), Беляев СЮ, US 92704 / TA 101723, 11-02-2025, конец

//Евросиб(ДИТ), Беляев СЮ, US 92704 / TA 101723, 11-02-2025, начало
Процедура ПодтвердитьЗагрузкуОбъектаПоГУИДБезПроведения(ГУИД, Действие, УзелОбмена, СсылкаНаОбъект = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		СсылкаНаОбъект = РегистрыСведений.ПротоколОбменов.СсылкаПоУИД(ГУИД, Действие, УзелОбмена);
	КонецЕсли;
	
	Если СсылкаНаОбъект <> Неопределено Тогда
		
		Объект = СсылкаНаОбъект.Получитьобъект();
		
		НаборЗаписей = РегистрыСведений.ПротоколОбменов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДействиеПриОбмене.Установить(Действие);
		НаборЗаписей.Отбор.УзелОбмена.Установить(УзелОбмена);
		НаборЗаписей.Отбор.Объект.Установить(Объект.ссылка);
		
		НаборЗаписей.Прочитать();
		Для Каждого Запись Из НаборЗаписей Цикл
			Запись.ЗагрузкаПодтверждена = Истина; 
		КонецЦикла;
		НаборЗаписей.Записать();
		
	КонецЕсли;

КонецПроцедуры
