Функция ПолучитьСоздатьСтатусКТК(СтатусКТККод, СтатусКТК, УзелОбмена)
	
	Результат = Справочники.СтатусыКТК.ПустаяСсылка();
	Если НЕ ЗначениеЗаполнено(СтатусКТККод) Тогда
		Возврат Результат;
	КонецЕсли;
	
	НайденныйЭлементСсылка = РегистрыСведений.ПротоколОбменов.СсылкаПоУИД(СтатусКТККод,Перечисления.ДействияПриОбмене.ЗагрузкаДанных,УзелОбмена,Тип("СправочникСсылка.СтатусыКТК"));
	Если НайденныйЭлементСсылка = Неопределено Тогда
		НовыйЭлемент = Справочники.СтатусыКТК.СоздатьЭлемент();
		НовыйЭлемент.Родитель = Справочники.СтатусыКТК.СтатусыЛичногоКабинета;
		НовыйЭлемент.Наименование = СтатусКТК;
		НовыйЭлемент.Записать();
		РегистрыСведений.ПротоколОбменов.ЗаписатьУИДИсточника(СтатусКТККод,Перечисления.ДействияПриОбмене.ЗагрузкаДанных,УзелОбмена,НовыйЭлемент.Ссылка);
		Результат = НовыйЭлемент.Ссылка;
	Иначе
		Если СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НайденныйЭлементСсылка, "Наименование")) <> СокрЛП(СтатусКТК) Тогда
			НайденныйЭлементОбъект = НайденныйЭлементСсылка.ПолучитьОбъект();
			НайденныйЭлементОбъект.Наименование = СокрЛП(СтатусКТК);
			НайденныйЭлементОбъект.Записать();
		КонецЕсли;
		Результат = НайденныйЭлементСсылка;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции
