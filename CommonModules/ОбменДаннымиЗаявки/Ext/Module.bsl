		ЗаписьXML.ЗаписатьТекст(XMLСтрока(ТекРезультат.Информация));
		ЗаписьXML.ЗаписатьКонецЭлемента();
		//Евросиб(ДИТ), Беляев СЮ, US 104177 / TA 104443, 21-03-2025, начало
		ЗаписьXML.ЗаписатьНачалоЭлемента("КлючиАналитикиПеревозки");
