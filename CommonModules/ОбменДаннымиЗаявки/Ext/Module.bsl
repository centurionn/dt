//Евросиб(ДИТ), Беляев СЮ, US 92704 / TA 101723, 11-02-2025, начало
Функция ЗагрузитьОбновитьДанныеЗаявки(ОбъектXDTOЗаявки, УзелОбмена)
	
	РезультатФункции = Новый Структура("УспешноЗагружен, Информация, ГУИД, КлючиАналитикиПеревозки", Ложь, "", "", Неопределено);
	
	//	ОбъектXDTOЗаявки	ОбъектXDTO	ОбъектXDTO
	//+ВидПеревозки	ОбъектXDTO	ОбъектXDTO
	//+ГУИД	"16a60e79-7fbb-11ef-b852-00155dfba800"	Строка
	//+ГрузоотправительПоВнешнеторговомуКонтракту	"Грузоотправитель по внешнему - тест"	Строка
	//+ГрузополучательПоВнешнеторговомуКонтракту	"Грузополучатель по внешнему - тест"	Строка
	//+ДатаОформленияЗаявки	"2025-02-05T00:00:00"	Строка
	//+Договор	ОбъектXDTO	ОбъектXDTO
	//Контейнеры	ОбъектXDTO	ОбъектXDTO
	//+Контрагент	ОбъектXDTO	ОбъектXDTO
	//+НаправлениеПеревозки	"Импорт"	Строка
	//+НомерЗаявки	"KANTASIS_1"	Строка
	//Нотис	ОбъектXDTO	ОбъектXDTO
	//+СогласованнаяCтавка	"жд 250 + море 320"	Строка
	//+СтатусЗаявки	"В работе"	Строка
	//+ТипПеревозки	ОбъектXDTO	ОбъектXDTO
		
	ГУИД = ОбъектXDTOЗаявки.ГУИД;
	РезультатФункции.ГУИД = ГУИД;
	
	НомерЗаявки = РегистрыСведений.ВнешниеНомераЗаявок.ПолучитьНомерЗаявкиПоГУИД(ГУИД);
	Если НЕ ЗначениеЗаполнено(НомерЗаявки) Тогда
		РезультатФункции.УспешноЗагружен = Ложь;
		РезультатФункции.Информация = "Не найден запрос номера заявки по ГУИД "+ГУИД;
		Возврат РезультатФункции;
	КонецЕсли;
	
	МассивОшибокПоискаСправочныхДанных = Новый Массив;
	
	ЗаявкаСсылка = Документы.Заявка.ПолучитьСсылку(Новый УникальныйИдентификатор(ГУИД));
	
	Если ОбщегоНазначения.СсылкаСуществует(ЗаявкаСсылка) Тогда
		ЗаявкаОбъект = ЗаявкаСсылка.ПолучитьОбъект();
	Иначе
		ЗаявкаОбъект = Документы.Заявка.СоздатьДокумент();
		ЗаявкаОбъект.Дата = ТекущаяДата();
		ЗаявкаОбъект.УстановитьНовыйНомер();
		ЗаявкаОбъект.УстановитьСсылкуНового(ЗаявкаСсылка);
		НовоеСостяние = ЗаявкаОбъект.Состояния.Добавить(); //иначе в списке документов не отображается
		НовоеСостяние.Состояние = Справочники.Состояния.Выполнение;
		ЗаявкаОбъект.ТекущееСостояние = Справочники.Состояния.Выполнение;
		Если УзелОбмена = Перечисления.УзлыОбмена.ЛК Тогда
			ЗаявкаОбъект.ЗаявкаЛККДКП = Истина;
		КонецЕсли;
	КонецЕсли;
	
