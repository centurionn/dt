Процедура ЗаполнитьДанныеНомерТранспорта(ТЗНомерТранспорта, ТЗВагоны)
	
	// ДИТ 65310 Давудов М.А. Начало: 16.02.2023
	Для Каждого СтрокаТЗ Из ТЗНомерТранспорта Цикл
		
		Попытка
			МенеджерЗаписи = РегистрыСведений.ИнформацияОтТерминалов.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Период = СтрокаТЗ.Период;
			МенеджерЗаписи.Контейнер = СтрокаТЗ.Контейнер;
			МенеджерЗаписи.НомерКонтейнера = СтрокаТЗ.НомерКонтейнера;
			//МенеджерЗаписи.КодТерминала = СтрокаТЗ.КодТерминала;
			//МенеджерЗаписи.Прочитать();
			//ДИТ, Беляев СЮ, BUG 67625/TA 72362, 07-07-2023, начало
			МенеджерЗаписи.Прочитать();
			МенеджерЗаписи.КодТерминала = СтрокаТЗ.КодТерминала;
			//ДИТ, Беляев СЮ, BUG 67625/TA 72362, 07-07-2023, конец
			
			СообщениеПоВагону = "";
			УдалитьОшибкуПоВагону = Ложь;
			МассивСообщений = СтрРазделить(МенеджерЗаписи.КомментарийКОшибке, Символы.ПС, Ложь);
			НовыйМассивСообщений = Новый Массив;
			Для Каждого СообщениеМассива Из МассивСообщений Цикл
				Если СтрНайти(СообщениеМассива,"которого нет в справочнике ""Вагоны, суда, авто"" DataCore") > 0 Тогда
					СообщениеПоВагону = СообщениеМассива;
					СообщениеМассива = "";
				Иначе
					НовыйМассивСообщений.Добавить(СообщениеМассива);
				КонецЕсли;
			КонецЦикла;
			
			Если Не ЗначениеЗаполнено(СтрокаТЗ.НомерТранспорта) Тогда
				
				Если СообщениеПоВагону = "" Тогда
					Продолжить;
				КонецЕсли;
				
				ПозицияСимволаОкончание = СтрНайти(СообщениеПоВагону, ">") - 1;
				ПозицияСимволаНачало =  СтрНайти(СообщениеПоВагону, "<");
				
				Если ПозицияСимволаОкончание <= 0
					ИЛИ ПозицияСимволаНачало = 0 Тогда
					//Сообщение отличается от шаблона
					Продолжить;
				КонецЕсли;
				
				ДлинаНомера = ПозицияСимволаОкончание - ПозицияСимволаНачало;
				
				Если ДлинаНомера > 150 Тогда
					//Не может быть больше 150 символов (ограничение длины наименования "Справочник.ТС"
					Продолжить;
				КонецЕсли;
				
				НомерТранспорта = Сред(
				СообщениеПоВагону,
				СтрНайти(СообщениеПоВагону, "<") + 1,
				ДлинаНомера);
				
				Если НомерТранспорта = "" Тогда
					Продолжить;
				КонецЕсли;
				
			Иначе
				
				НомерТранспорта = СтрокаТЗ.НомерТранспорта;
				
			КонецЕсли;
			
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Наименование", НомерТранспорта);
			НайденныеСтроки = ТЗВагоны.НайтиСтроки(СтруктураОтбора);
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				НомерТранспорта = НайденныеСтроки[0].Ссылка;
				УдалитьОшибкуПоВагону = Истина;
			КонецЕсли;
			
			МенеджерЗаписи.НомерТранспорта = НомерТранспорта;
			Если УдалитьОшибкуПоВагону Тогда
				МенеджерЗаписи.Ошибка = Ложь;
				МенеджерЗаписи.КомментарийКОшибке = СтрСоединить(НовыйМассивСообщений, Символы.ПС);
			КонецЕсли;
			
			РегистрыСведений.ИнформацияОтТерминалов.ПроверитьЗапись(МенеджерЗаписи);
			МенеджерЗаписи.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось обновить номер транспорта в записях регистра: "+ОписаниеОшибки());
		КонецПопытки;
		
	КонецЦикла;
	// ДИТ 65310 Давудов М.А. Конец: 16.02.2023
	
КонецПроцедуры

Процедура ЗаполнитьДанныеКодТерминала(ТЗКодовТерминалов, ТЗТерминалы)
	
	// ДИТ 65310 Давудов М.А. Начало: 16.02.2023
	Для Каждого СтрокаТЗ Из ТЗКодовТерминалов Цикл
		
		Попытка
			МенеджерЗаписи = РегистрыСведений.ИнформацияОтТерминалов.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Период = СтрокаТЗ.Период;
			МенеджерЗаписи.Контейнер = СтрокаТЗ.Контейнер;
			МенеджерЗаписи.НомерКонтейнера = СтрокаТЗ.НомерКонтейнера;
			//МенеджерЗаписи.КодТерминала = СтрокаТЗ.КодТерминала;
			//МенеджерЗаписи.Прочитать();
			//ДИТ, Беляев СЮ, BUG 67625/TA 72362, 07-07-2023, начало
			МенеджерЗаписи.Прочитать();
			МенеджерЗаписи.КодТерминала = СтрокаТЗ.КодТерминала;
			//ДИТ, Беляев СЮ, BUG 67625/TA 72362, 07-07-2023, конец
			
			СообщениеПоКодуТерминала = "";
			УдалитьОшибкуПоТерминула = Ложь;
			МассивСообщений = СтрРазделить(МенеджерЗаписи.КомментарийКОшибке, Символы.ПС, Ложь);
			НовыйМассивСообщений = Новый Массив;
			Для Каждого СообщениеМассива Из МассивСообщений Цикл
				Если СтрНайти(СообщениеМассива,"которого нет в справочнике ""Локации (терминал)""") > 0 Тогда
					СообщениеПоКодуТерминала = СообщениеМассива;
					СообщениеМассива = "";
				Иначе
					НовыйМассивСообщений.Добавить(СообщениеМассива);
				КонецЕсли;
			КонецЦикла;
				
			Если НЕ ЗначениеЗаполнено(СтрокаТЗ.КодТерминала) Тогда
				
				Если СообщениеПоКодуТерминала = "" Тогда
					Продолжить;
				КонецЕсли;
				
				ПозицияСимволаОкончание = СтрНайти(СообщениеПоКодуТерминала, ">") - 1;
				ПозицияСимволаНачало =  СтрНайти(СообщениеПоКодуТерминала, "<");
				
				Если ПозицияСимволаОкончание <= 0
					ИЛИ ПозицияСимволаНачало = 0 Тогда
					//Сообщение отличается от шаблона
					Продолжить;
				КонецЕсли;
				
				ДлинаНомера = ПозицияСимволаОкончание - ПозицияСимволаНачало;
				
				Если ДлинаНомера > 30 Тогда
					//Не может быть больше 30 символов (ограничение длины реквизита "ПредставлениеВCodeco" "Справочник.Локации"
					Продолжить;
				КонецЕсли;
				
				КодТерминала = Сред(
				СообщениеПоКодуТерминала,
				СтрНайти(СообщениеПоКодуТерминала, "<") + 1,
				ДлинаНомера);
				
				Если КодТерминала = "" Тогда
					Продолжить;
				КонецЕсли;
				
			Иначе
				
				КодТерминала = СтрокаТЗ.КодТерминала;
				
			КонецЕсли;
				
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("ПредставлениеВCodeco", КодТерминала);
			НайденныеСтроки = ТЗТерминалы.НайтиСтроки(СтруктураОтбора);
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				МенеджерЗаписи.Терминал = НайденныеСтроки[0].Ссылка;
				УдалитьОшибкуПоТерминула = Истина;
			КонецЕсли;
			
			МенеджерЗаписи.КодТерминала = КодТерминала;
			Если УдалитьОшибкуПоТерминула Тогда
				МенеджерЗаписи.Ошибка = Ложь;
				МенеджерЗаписи.КомментарийКОшибке = СтрСоединить(НовыйМассивСообщений, Символы.ПС);
			КонецЕсли;
			
			РегистрыСведений.ИнформацияОтТерминалов.ПроверитьЗапись(МенеджерЗаписи);
			МенеджерЗаписи.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось обновить код терминала в записях регистра: "+ОписаниеОшибки());
		КонецПопытки;
		
	КонецЦикла;
	// ДИТ 65310 Давудов М.А. Конец: 16.02.2023
	
