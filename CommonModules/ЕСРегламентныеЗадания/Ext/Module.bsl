Функция ОтветственныйПоРейсуЗаСозданиеСделки(Рейс)
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	// ДИТ US 51951 TA 61497 Евсенкин М.А. Начало: 30.11.2022
	// Было:
	//Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	//               |	ЗаявкаПереченьРейсов.Ссылка.Договор.ОтветственныйЗаСопровождение КАК Ответственный
	//               |ИЗ
	//               |	Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
	//               |ГДЕ
	//               |	ЗаявкаПереченьРейсов.Рейс = &Рейс";
	//Стало:
	//Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	//               |	ТЧОтветственные.Ответственный КАК Ответственный
	//               |ИЗ
	//               |	Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
	//               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов.Ответственные КАК ТЧОтветственные
	//               |		ПО ЗаявкаПереченьРейсов.Ссылка.Договор = ТЧОтветственные.Ссылка
	//               |			И ЗаявкаПереченьРейсов.Ссылка.Договор = ТЧОтветственные.Ссылка
	//               |			И (ТЧОтветственные.ЦФО = ЗНАЧЕНИЕ(Справочник.ЦентрыФинансовойОтветственности.ОсновнойЦФО))
	//               |			И (ТЧОтветственные.ТипОтветственного = ЗНАЧЕНИЕ(Перечисление.ТипыОтветственных.ОтветственныйЗаСопровождение))
	//               |ГДЕ
	//               |	ЗаявкаПереченьРейсов.Рейс = &Рейс";
	// ДИТ US 51951 TA 61497 Евсенкин М.А. Конец: 30.11.2022
	
	//Евросиб СубботинВ #117990 20.01.2026 Начало 
	//ДИТ, Беляев СЮ, Ticket#0304020, 14-03-2023, начало
	//Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	//               |	ТЧОтветственные.Ответственный КАК Ответственный,
	//               |	ТЧОтветственные.ЦФО КАК ОтветственныйЦФО,
	//               |	ЗаявкаПереченьРейсов.Ссылка.ЦФО КАК ЗаявкаЦФО
	//               |ПОМЕСТИТЬ ВТ_Ответственные
	//               |ИЗ
	//               |	Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
	//               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов.Ответственные КАК ТЧОтветственные
	//               |		ПО ЗаявкаПереченьРейсов.Ссылка.Договор = ТЧОтветственные.Ссылка
	//               |			И ЗаявкаПереченьРейсов.Ссылка.Договор = ТЧОтветственные.Ссылка
	//               |			И (ТЧОтветственные.ТипОтветственного = ЗНАЧЕНИЕ(Перечисление.ТипыОтветственных.ОтветственныйЗаСопровождение))
	//               |ГДЕ
	//               |	ЗаявкаПереченьРейсов.Рейс = &Рейс
	//               |;
	//               |
	//               |////////////////////////////////////////////////////////////////////////////////
	//               |ВЫБРАТЬ
	//               |	ВТ_ОтветственныеСУчетомЦФОЗаявки.Ответственный КАК Ответственный
	//               |ИЗ
	//               |	ВТ_Ответственные КАК ВТ_ОтветственныеСУчетомЦФОЗаявки
	//               |ГДЕ
	//               |	ВТ_ОтветственныеСУчетомЦФОЗаявки.ЗаявкаЦФО = ВТ_ОтветственныеСУчетомЦФОЗаявки.ОтветственныйЦФО
	//               |
	//               |ОБЪЕДИНИТЬ
	//               |
	//               |ВЫБРАТЬ
	//               |	ВТ_ОтветственныеПоОсновномуЦФО.Ответственный
	//               |ИЗ
	//               |	ВТ_Ответственные КАК ВТ_ОтветственныеПоОсновномуЦФО
	//               |ГДЕ
	//               |	ВТ_ОтветственныеПоОсновномуЦФО.ОтветственныйЦФО = ЗНАЧЕНИЕ(Справочник.ЦентрыФинансовойОтветственности.ОсновнойЦФО)
	//               |	И НЕ 1 В
	//               |				(ВЫБРАТЬ ПЕРВЫЕ 1
	//               |					1
	//               |				ИЗ
	//               |					ВТ_Ответственные КАК ВТ_Ответственные
	//               |				ГДЕ
	//               |					ВТ_Ответственные.ЗаявкаЦФО = ВТ_Ответственные.ОтветственныйЦФО)";
	//ДИТ, Беляев СЮ, Ticket#0304020, 14-03-2023, конец
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	ВЫБОР
		               |		КОГДА ТИПЗНАЧЕНИЯ(ТЧОтветственные.Ответственный) = ТИП(Справочник.ГруппыПользователей)
		               |			ТОГДА ГруппыПользователейСостав.Пользователь
		               |		ИНАЧЕ Пользователи.Ссылка
		               |	КОНЕЦ КАК Ответственный,
		               |	ТЧОтветственные.ЦФО КАК ОтветственныйЦФО,
		               |	ЗаявкаПереченьРейсов.Ссылка.ЦФО КАК ЗаявкаЦФО
		               |ПОМЕСТИТЬ ВТ_Ответственные
		               |ИЗ
		               |	Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов.Ответственные КАК ТЧОтветственные
		               |			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
		               |			ПО ТЧОтветственные.Ответственный = Пользователи.Ссылка
		               |			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыПользователей.Состав КАК ГруппыПользователейСостав
		               |			ПО ТЧОтветственные.Ответственный = ГруппыПользователейСостав.Пользователь
		               |		ПО ЗаявкаПереченьРейсов.Ссылка.Договор = ТЧОтветственные.Ссылка
		               |			И (ТЧОтветственные.ТипОтветственного = ЗНАЧЕНИЕ(Перечисление.ТипыОтветственных.ОтветственныйЗаСопровождение))
		               |ГДЕ
		               |	ЗаявкаПереченьРейсов.Рейс = &Рейс
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВТ_ОтветственныеСУчетомЦФОЗаявки.Ответственный КАК Ответственный
		               |ИЗ
		               |	ВТ_Ответственные КАК ВТ_ОтветственныеСУчетомЦФОЗаявки
		               |ГДЕ
		               |	ВТ_ОтветственныеСУчетомЦФОЗаявки.ЗаявкаЦФО = ВТ_ОтветственныеСУчетомЦФОЗаявки.ОтветственныйЦФО
		               |
		               |ОБЪЕДИНИТЬ
		               |
		               |ВЫБРАТЬ
		               |	ВТ_ОтветственныеПоОсновномуЦФО.Ответственный
		               |ИЗ
		               |	ВТ_Ответственные КАК ВТ_ОтветственныеПоОсновномуЦФО
		               |ГДЕ
		               |	ВТ_ОтветственныеПоОсновномуЦФО.ОтветственныйЦФО = ЗНАЧЕНИЕ(Справочник.ЦентрыФинансовойОтветственности.ОсновнойЦФО)
		               |	И НЕ 1 В
		               |				(ВЫБРАТЬ ПЕРВЫЕ 1
		               |					1
		               |				ИЗ
		               |					ВТ_Ответственные КАК ВТ_Ответственные
		               |				ГДЕ
		               |					ВТ_Ответственные.ЗаявкаЦФО = ВТ_Ответственные.ОтветственныйЦФО)";
	//Евросиб СубботинВ #117990 20.01.2026 Конец
	
		Запрос.УстановитьПараметр("Рейс", Рейс);
	СписокОтветственных = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ответственный");
	
	Если СписокОтветственных.Количество() = 1 И ЗначениеЗаполнено(СписокОтветственных[0]) Тогда
		Результат = СписокОтветственных[0];
	ИначеЕсли СписокОтветственных.Количество() > 1 Тогда
		Результат = Константы.ГруппаИсполнителейПоСозданиюСделки.Получить();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


Функция ВагоныНазначены(Ссылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
