
Процедура АктуализироватьСостоянияОтправленныхВДиадокДокументов() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.АктуализироватьСостоянияОтправленныхВДиадокДокументов);
	
КонецПроцедуры

Процедура ВыдачаЗаданийНаКомплектацииПоездовИНазначениеВагонов() Экспорт
	
	ЗаСколькоВагоны = Константы.ЗаСколькоДоОтправленияСтавитьЗадачуНазначенияВагонов.Получить();
	ЗаСколькоСделки = Константы.ЗаСколькоДоОтправленияСтавитьЗадачуСозданияСделки.Получить();
	ИсполнителиВагоны = Константы.ГруппаИсполнителейПоНазначениюВагонов.Получить();
	ИсполнителиСделки = Константы.ГруппаИсполнителейПоСозданиюСделки.Получить();
	КоридорПоиска = 5; 	// система ищет в коридоре за 5 дней до дедлайна ~ дедлайн и для каждой отправки проверяет, что там все назначено. 
						// Нужно для поиска пропущенных "вчера" отправок
						
	////////////////////////////////
	
	// 1. Ищем отправки без вагонов
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РейсыЖД.Ссылка КАК Ссылка,
	               |	РейсыЖД.ДатаОтправления КАК ДатаОтправления
	               |ИЗ
	               |	Справочник.РейсыЖД КАК РейсыЖД
	               |ГДЕ
	               |	НЕ РейсыЖД.ПометкаУдаления
	               |	И РейсыЖД.ДатаОтправления МЕЖДУ &Дата1 И &Дата2
	               |	И НЕ РейсыЖД.Ссылка В
	               |				(ВЫБРАТЬ
	               |					ВагоныВОтправке.Отправка КАК Отправка
	               |				ИЗ
	               |					РегистрСведений.ВагоныВОтправке КАК ВагоныВОтправке)
	               |	И НЕ РейсыЖД.РейсОтменен";
	Запрос.УстановитьПараметр("Дата1", ТекущаяДата()-КоридорПоиска*24*3600);
	Запрос.УстановитьПараметр("Дата2", ТекущаяДата()+ЗаСколькоВагоны*24*3600);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		// немного плагиата...
		ПолучОб = Ответ.Ссылка.ПолучитьОбъект();
		ТЧ = ПолучОб.Состояния;
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Состояние", Справочники.Состояния.ТребуетсяНазначениеВагонов);
		НайденныеСтроки = ТЧ.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			ТекСтр = ТЧ.Добавить();
			ТекСтр.Состояние = Справочники.Состояния.ТребуетсяНазначениеВагонов;
			ТекСтр.Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
			ТекСтр.Исполнитель = ИсполнителиВагоны;
			ТекСтр.НормативИсполненияСМоментаСоздания = 2;
			ТекСтр.НачалоРаботы = Ответ.ДатаОтправления - ЗаСколькоВагоны*24*3600;
			Попытка
				ПолучОб.Записать();
			Исключение
			КонецПопытки;
		КонецЕсли;
			
	КонецЦикла;
	
	// 2. Ищем отправки без сделок
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РейсыЖД.Ссылка КАК Ссылка,
	               |	РейсыЖД.ДатаОтправления КАК ДатаОтправления
	               |ИЗ
	               |	Справочник.РейсыЖД КАК РейсыЖД
	               |ГДЕ
	               |	НЕ РейсыЖД.ПометкаУдаления
	               |	И РейсыЖД.ДатаОтправления МЕЖДУ &Дата1 И &Дата2
	               |	И НЕ РейсыЖД.Ссылка В
	               |				(ВЫБРАТЬ
	               |					СделкаРейсы.Рейс КАК Рейс
	               |				ИЗ
	               |					Документ.Сделка.Рейсы КАК СделкаРейсы)";
	Запрос.УстановитьПараметр("Дата1", ТекущаяДата()-КоридорПоиска*24*3600);
	Запрос.УстановитьПараметр("Дата2", ТекущаяДата()+ЗаСколькоСделки*24*3600);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		// немного плагиата...
		ПолучОб = Ответ.Ссылка.ПолучитьОбъект();
		ТЧ = ПолучОб.Состояния;
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Состояние", Справочники.Состояния.ТребуетсяСозданиеСделки);
		НайденныеСтроки = ТЧ.НайтиСтроки(ПараметрыОтбора);
		
		НайдОтветственный = ОтветственныйПоРейсуЗаСозданиеСделки(Ответ.Ссылка);
		
		Если НайденныеСтроки.Количество() = 0 И НайдОтветственный <> неопределено Тогда
			ТекСтр = ТЧ.Добавить();
			ТекСтр.Состояние = Справочники.Состояния.ТребуетсяСозданиеСделки;
			ТекСтр.Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
			ТекСтр.Исполнитель = НайдОтветственный;
			ТекСтр.НормативИсполненияСМоментаСоздания = 2;
			ТекСтр.НачалоРаботы = Ответ.ДатаОтправления - ЗаСколькоСделки*24*3600;
			Попытка
				ПолучОб.Записать();
			Исключение
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;
	
	////////////////////////////////
	// Работа завершена. Все что ниже - оставлено для дальнейшего обсуждения
	Возврат;
	////////////////////////////////
	
	//Счетчик = 0;
	//Пока Счетчик<2 Цикл
	//	Запрос = Новый Запрос;
	//	Запрос.Текст = "ВЫБРАТЬ
	//	               |	ВагоныВОтправке.Отправка КАК Отправка
	//	               |ПОМЕСТИТЬ ОтправкиСВагонами
