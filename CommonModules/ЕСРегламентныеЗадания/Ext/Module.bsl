Процедура ОбновитьСтатусОтправкиИПодписанияЭДОвРТУ() Экспорт //Евросиб Шевченко А.В. 24.06.2025 US 104900 TA 112049
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗначенияДополнительныхАналитикДокументов.Документ КАК Документ
		|ПОМЕСТИТЬ ВТ_РТУНаслежение
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхАналитикДокументов КАК ЗначенияДополнительныхАналитикДокументов
		|ГДЕ
		|	ЗначенияДополнительныхАналитикДокументов.Аналитика = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ДополнительныеАналитикиДокументов.НеОтслеживатьРТУвЭДО)
		|	И ЗначенияДополнительныхАналитикДокументов.Значение = ЛОЖЬ
		|	И ЗначенияДополнительныхАналитикДокументов.Документ.Проведен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗначенияДополнительныхАналитикДокументов.Документ КАК Документ,
		|	ЗначенияДополнительныхАналитикДокументов.Значение КАК Значение
		|ПОМЕСТИТЬ ВТ_РТУНеВРаботеНЕТребуютНачалаРаботы
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхАналитикДокументов КАК ЗначенияДополнительныхАналитикДокументов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_РТУНаслежение КАК ВТ_РТУНаслежение
		|		ПО (ВТ_РТУНаслежение.Документ = ЗначенияДополнительныхАналитикДокументов.Документ)
		|ГДЕ
		|	ЗначенияДополнительныхАналитикДокументов.Аналитика = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ДополнительныеАналитикиДокументов.СтатусОтправкиИПодписанияРТУ)
		|	И ЗначенияДополнительныхАналитикДокументов.Значение = ЗНАЧЕНИЕ(Перечисление.СтатусыОтправкиИПодписанияРТУ.ДокументНеВРаботеИНеТребуетНачалаРаботы)
		|	И ЗначенияДополнительныхАналитикДокументов.Документ.Проведен
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗначенияДополнительныхАналитикДокументов.Документ,
		|	ЗначенияДополнительныхАналитикДокументов.Значение
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхАналитикДокументов КАК ЗначенияДополнительныхАналитикДокументов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_РТУНаслежение КАК ВТ_РТУНаслежение
		|		ПО (ВТ_РТУНаслежение.Документ = ЗначенияДополнительныхАналитикДокументов.Документ)
		|ГДЕ
		|	ЗначенияДополнительныхАналитикДокументов.Аналитика = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ДополнительныеАналитикиДокументов.СтатусОтправкиИПодписанияРТУ)
		|	И ЗначенияДополнительныхАналитикДокументов.Значение = ЗНАЧЕНИЕ(Перечисление.СтатусыОтправкиИПодписанияРТУ.НеОтправлен)
		|	И ЗначенияДополнительныхАналитикДокументов.Документ.Проведен
