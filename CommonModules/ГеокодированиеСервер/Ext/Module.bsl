			обЛокация.Записать();               
			ссРегион = обЛокация.Ссылка;
			ДозаполнитьЛогГеокодераИсточниками(СтруктураРезультата.ИдентификаторЗапроса, ссРегион);
			//Возврат ссЛокация;
		Иначе
			ТаблицаРегионов = РезультатЗапроса.Выгрузить();
			Если ТаблицаРегионов.Количество() > 1 Тогда
				ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Найдено несколько регионов (%1) для создания локации (%2)", ПараметрыЛокации.Регион, ПараметрыЛокации.Наименование));
				Возврат Справочники.Локации.ПустаяСсылка();
			КонецЕсли;
			ссРегион = ТаблицаРегионов[0].Ссылка;
		КонецЕсли;
	КонецЕсли;       
	Возврат ссРегион;
КонецФункции

Процедура ЗаписатьЛогГеокодирования(ИдентификаторЗапроса, ТекстЗапроса) Экспорт
	мз = РегистрыСведений.ИсторияЗапросовКГеокодеру.СоздатьМенеджерЗаписи();
	мз.ИдентификаторЗапроса = ИдентификаторЗапроса;
	мз.ДатаЗапроса = ТекущаяДата();
	мз.ТекстЗапроса = ТекстЗапроса;
	мз.Пользователь = Пользователи.ТекущийПользователь();
	мз.СтатусОбработкиЗапроса = Перечисления.СтатусыОбработкиЗапросаГеокодера.ОтветПолученНеЗаписан;
	мз.Записать();
КонецПроцедуры  

Процедура ДозаполнитьЛогГеокодераИсточниками(ИдентификаторЗапроса, ЛокацияСсылка) Экспорт
	мз = РегистрыСведений.ИсторияЗапросовКГеокодеру.СоздатьМенеджерЗаписи();
	мз.ИдентификаторЗапроса = ИдентификаторЗапроса;
	мз.Прочитать();
	Если мз.Выбран() Тогда
		мз.ТипОбъектаИсточникаЗапроса = "Справочник.Локации.ДополнитьПоДаннымГеокодера";
		мз.ОбъектИсточникЗапроса = ЛокацияСсылка; 
		мз.Записать();
	КонецЕсли;
КонецПроцедуры

Процедура ДозаполнитьЛогГеокодераСтатусами(ИдентификаторЗапроса, Статус, РезультатОбработкиЗапроса) Экспорт
	мз = РегистрыСведений.ИсторияЗапросовКГеокодеру.СоздатьМенеджерЗаписи();
	мз.ИдентификаторЗапроса = ИдентификаторЗапроса;
	мз.Прочитать();
	Если мз.Выбран() Тогда
		мз.СтатусОбработкиЗапроса = Статус;
		мз.РезультатОбработкиЗапроса = РезультатОбработкиЗапроса;
		мз.Записать();
	КонецЕсли;
КонецПроцедуры

