	Получатели = "syskovys@eurosib.biz; gusevav@eurosib.biz; bulanyyas@eurosib.biz; smorchkovals@eurosib.biz";
	СкрытыеКопии = "suslovav@eurosib.biz;";
	Вложения = Новый Массив;
	Вложения.Добавить(Новый Структура("АдресВоВременномХранилище, Представление", АдресВоВременномХранилище, "Отчет")); 
	
	Если РаботаСПочтовымиСообщениями.УчетнаяЗаписьНастроена(Справочники.УчетныеЗаписиЭлектроннойПочты.СистемнаяУчетнаяЗаписьЭлектроннойПочты, Истина, Ложь) Тогда
