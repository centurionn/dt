		Тема = Лев("[DC задачи] Документ: " + Строка(Ответ.Документ)+ " задача: " + Строка(Ответ.Состояние), 200);
		
		ТекстПисьма = "<b>В системе появился документ, требующий Вашего внимания:</b><br/><br/>";
		ТекстПисьма = ТекстПисьма + "<b>Документ: </b>" + Ответ.Документ + "<br/>";
		ТекстПисьма = ТекстПисьма + "<b>Для пользователя: </b>" + Ответ.Пользователь + "<br/>";
		ТекстПисьма = ТекстПисьма + "<b>Задача: </b>" + Ответ.Состояние + "<br/>";
		
		//Евросиб Каблов 21.07.2020 (
		НайденныеСтроки = ТаблицаСостояний.НайтиСтроки(Новый Структура("Документ, Состояние", Ответ.Документ, Ответ.Состояние));
		Если НайденныеСтроки.Количество() > 0 Тогда
			Комментарий = НайденныеСтроки[0].Комментарий;
			Если ЗначениеЗаполнено(Комментарий) Тогда
				ТекстПисьма = ТекстПисьма + СтрШаблон("<b>Комментарий: </b>%1<br/>", Комментарий);
			КонецЕсли;
		КонецЕсли;
		//Евросиб Каблов 21.07.2020 )		
		
		ТекстНС = "<a target=""_blank"" href="""+ПрефиксНС+ПолучитьНавигационнуюСсылку(Ответ.Документ)+""">"+ПолучитьНавигационнуюСсылку(Ответ.Документ)+"</a>";
		
		ТекстПисьма = ТекстПисьма + "<b>Навигационная ссылка: </b>" + ТекстНС + "<br/>";
		ТекстПисьма = ТекстПисьма + "<b>Дата формирования письма: </b>" + ТекущаяДата() + "<br/><br/>";
		ТекстПисьма = ТекстПисьма + "Спасибо за внимание! --DC";
		
		Если ТипЗнч(Ответ.Документ) = Тип("ДокументСсылка.Операция") Тогда
			Тема = "[DC задачи] " + Ответ.Документ.Услуга;

			ТекстПисьма = "<b>В системе появился документ, требующий Вашего внимания:</b><br/><br/>";
			ТекстПисьма = ТекстПисьма + "<b>Операция: </b>" + Ответ.Документ.Услуга + "<br/>";
			ТекстПисьма = ТекстПисьма + "<b>Документ: </b>" + Ответ.Документ + "<br/>";
			ТекстПисьма = ТекстПисьма + "<b>Для пользователя: </b>" + Ответ.Пользователь + "<br/>";
			ТекстПисьма = ТекстПисьма + "<b>Задача: </b>" + Ответ.Состояние + "<br/>";
			
			ТекстНС = "<a target=""_blank"" href="""+ПрефиксНС+ПолучитьНавигационнуюСсылку(Ответ.Документ)+""">"+ПолучитьНавигационнуюСсылку(Ответ.Документ)+"</a>";
			
			ТекстПисьма = ТекстПисьма + "<b>Навигационная ссылка: </b>" + ТекстНС + "<br/>";
			ТекстПисьма = ТекстПисьма + "<b>Дата формирования письма: </b>" + ТекущаяДата() + "<br/><br/>";
			ТекстПисьма = ТекстПисьма + "Спасибо за внимание! --DC";
			
		КонецЕсли;
		
		ПолучателиПисьма = Новый Массив;
		
		Если ЗначениеЗаполнено(АдресДублированияУведомлений) Тогда
			Для каждого Адрес из СтрРазделить(АдресДублированияУведомлений, ";", Ложь) Цикл
				ПолучателиПисьма.Добавить(Новый Структура("Представление, Адрес", "Адрес отслеживания", Адрес));
			КонецЦикла;
		КонецЕсли;
		
		ПараметрыОтправкиПисьма = новый Структура;
		ПараметрыОтправкиПисьма.Вставить("Тема", Тема);
		ПараметрыОтправкиПисьма.Вставить("Тело", ТекстПисьма);
		ПараметрыОтправкиПисьма.Вставить("ТипТекста", "HTML");
		Если ТипЗнч(Ответ.Пользователь) = Тип("СправочникСсылка.Пользователи") Тогда
			EMAIL = ПолучитьEMAILПользователя(ПодобратьЗамещение(Ответ.Пользователь, ТекущаяДата()));
			Если ЗначениеЗаполнено(EMAIL) Тогда
				ПолучателиПисьма.Добавить(Новый Структура("Представление, Адрес", Строка(Ответ.Пользователь), EMAIL));
			КонецЕсли;
		Иначе
			ПользователиГруппы = Пользователи_sd_сервер.ПолучитьПользователейГруппы(Ответ.Пользователь);
			Для каждого ПользовательЪ из ПользователиГруппы Цикл
				EMAIL = ПолучитьEMAILПользователя(ПодобратьЗамещение(ПользовательЪ, ТекущаяДата()));
				Если ЗначениеЗаполнено(EMAIL) Тогда
					ПолучателиПисьма.Добавить(Новый Структура("Представление, Адрес", Строка(ПользовательЪ), EMAIL));
					Сообщить("Планируется к отправке " + EMAIL);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ПараметрыОтправкиПисьма.Вставить("Кому", ПолучателиПисьма);
		
		//ДИТ, Беляев СЮ, Ticket#0261337, 21-02-2022, начало
		//пропускаем отправку и регистрацию, если массив адресов пустой
		Если ПолучателиПисьма.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		//ДИТ, Беляев СЮ, Ticket#0261337, 21-02-2022, конец
		
		РЕЗУЛЬТАТ = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(СистемнаяУчетнаяЗапись, ПараметрыОтправкиПисьма);
		//РЕЗУЛЬТАТ = неопределено;
		Если ЗначениеЗаполнено(РЕЗУЛЬТАТ) Тогда
			МЗ = РегистрыСведений.УведомленияПользователейОЗадачах.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(МЗ, Ответ);
			МЗ.УведомлениеОЗадаче = Истина;
			МЗ.Период = ТекущаяДата();
			МЗ.Записать(Истина);
		КонецЕсли;
		
	КонецЦикла;
	                                                
	//ДИТ, Беляев СЮ, Ticket#0249084, ++
	УдалитьЗаписиВРегистреУведомленийДоДатыНаСервере(ДатаНачалаРазрешеннойРассылки);
	//ДИТ, Беляев СЮ, Ticket#0249084, --
	
КонецПроцедуры     

//ДИТ, Беляев СЮ, Ticket#0249084, ++
&НаСервере
Процедура УдалитьЗаписиВРегистреУведомленийДоДатыНаСервере(вхДата)
	Если ТипЗнч(вхДата)<>Тип("Дата") Тогда 
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(вхДата) Тогда
		Возврат;
	КонецЕсли;	                             
	ТекущаяДатаМинус7Дней = ТекущаяДата()-7*24*3600;
	ДатаУдалитьДО = Мин(вхДата, ТекущаяДатаМинус7Дней); //подстраховка на случай указания в константе "ЗапретитьРассылкуЗадачСтаршеДней" небольщого количества дней
	//удаляем по 100 записей, чтобы не нагружать систему в случае если накопились данные, т.к. запускается задание раз в 10 минут
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 100
	               |	УведомленияПользователейОЗадачах.Документ КАК Документ
	               |ИЗ
	               |	РегистрСведений.УведомленияПользователейОЗадачах КАК УведомленияПользователейОЗадачах
	               |ГДЕ
	               |	УведомленияПользователейОЗадачах.Документ.Дата < &ДатаУдаленияДО";
	Запрос.УстановитьПараметр("ДатаУдаленияДО", ДатаУдалитьДО);
	МассивДокументов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Документ");
	
	Если МассивДокументов.Количество()>0 Тогда
		Для каждого ЭлМассива Из МассивДокументов Цикл
			Набор = РегистрыСведений.УведомленияПользователейОЗадачах.СоздатьНаборЗаписей();
			Набор.Отбор.Документ.Установить(ЭлМассива);
			Набор.Записать();
		КонецЦикла;			
	КонецЕсли;
КонецПроцедуры
//ДИТ, Беляев СЮ, Ticket#0249084, --

Процедура УведомитьПользователяОЕгоПросрочках() Экспорт
	
	// первичная проверка на то, что мы вообще можем что-то отправить
	УчетнаяЗаписьПоУмолчанию = РаботаСПочтовымиСообщениями.ПроверитьСистемнаяУчетнаяЗаписьДоступна();
	
	Если не УчетнаяЗаписьПоУмолчанию Тогда возврат; КонецЕсли;
	СистемнаяУчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	АдресДублированияУведомлений = Константы.АдресДублированияОповещенийОЗадачах.Получить();
	ПрефиксНС = Константы["АдресПубликацииИнформационнойБазыВЛокальнойСети"+?(ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована, "Тестовый", "")].Получить() + "#";
	
	ЗапретитьРассылкуЗадачСтаршеДней = Константы.ЗапретитьРассылкуЗадачСтаршеДней.Получить();
	Если ЗапретитьРассылкуЗадачСтаршеДней = 0 Тогда
		ЗапретитьРассылкуЗадачСтаршеДней = 999999;
	КонецЕсли;
	ДатаНачалаРазрешеннойРассылки = ТекущаяДата() - ЗапретитьРассылкуЗадачСтаршеДней * 24 * 3600;
	
	
	ТЗ_6_СписокПроблем = Новый ТаблицаЗначений;
	ТЗ_6_СписокПроблем.Колонки.Добавить("Исполнитель");
	ТЗ_6_СписокПроблем.Колонки.Добавить("Наблюдатель");
	ТЗ_6_СписокПроблем.Колонки.Добавить("Операция");
	ТЗ_6_СписокПроблем.Колонки.Добавить("Состояние");
	ТЗ_6_СписокПроблем.Колонки.Добавить("МераОтклонения");
	ТЗ_6_СписокПроблем.Колонки.Добавить("Регион");
	ТЗ_6_СписокПроблем.Колонки.Добавить("КлассНарушения");
	ТЗ_6_СписокПроблем.Колонки.Добавить("ДатаОтправления");
	ТЗ_6_СписокПроблем.Колонки.Добавить("ДатаНазначения");
	
	ТЗОбъектовСостояния = Новый ТаблицаЗначений;
	ТЗОбъектовСостояния.Колонки.Добавить("ОбъектСостояние");
	ТЗОбъектовСостояния.Колонки.Добавить("ТипМетаданных");
	
	СписокРазрешенныхСтатусов = Новый Массив;
	СписокРазрешенныхСтатусов.Добавить(Перечисления.СтатусыЭтапов.НаВыполнение);
	СписокРазрешенныхСтатусов.Добавить(Перечисления.СтатусыЭтапов.ВРаботе);
	
	// + скопированный кусок из АРМ Руководителя
	
	// Только операции
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОперацииВСделках.Операция КАК Операция,
	               |	ОперацииВСделках.Исполнитель КАК Исполнитель,
	               |	ОперацииВСделках.Наблюдатель КАК Наблюдатель,
	               |	ОперацииВСделках.Состояние КАК Состояние,
	               |	ВЫБОР
	               |		КОГДА ОперацииВСделках.ДатаОтправленияФакт > ОперацииВСделках.ДатаОтправления
	               |				ИЛИ ОперацииВСделках.ДатаНазначенияФакт > ОперацииВСделках.ДатаНазначения
	               |				ИЛИ ОперацииВСделках.ДатаОтправленияФакт = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |					И ОперацииВСделках.ДатаНазначения < &ТекущаяДата
	               |			ТОГДА ЗНАЧЕНИЕ(Перечисление.КлассНарушенияАРМРуководителя.НарушениеСрока)
	               |	КОНЕЦ КАК КлассНарушения,
	               |	ВЫБОР
	               |		КОГДА ОперацииВСделках.ДатаОтправленияФакт > ОперацииВСделках.ДатаОтправления
	               |			ТОГДА РАЗНОСТЬДАТ(ОперацииВСделках.ДатаОтправления, ОперацииВСделках.ДатаОтправленияФакт, ДЕНЬ)
	               |		КОГДА ОперацииВСделках.ДатаНазначенияФакт > ОперацииВСделках.ДатаНазначения
	               |			ТОГДА РАЗНОСТЬДАТ(ОперацииВСделках.ДатаНазначения, ОперацииВСделках.ДатаНазначенияФакт, ДЕНЬ)
	               |		КОГДА ОперацииВСделках.ДатаОтправленияФакт = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |				И ОперацииВСделках.ДатаНазначения < &ТекущаяДата
	               |			ТОГДА РАЗНОСТЬДАТ(ОперацииВСделках.ДатаОтправления, &ТекущаяДата, ДЕНЬ)
	               |	КОНЕЦ КАК МераОтклонения,
	               |	ОперацииВСделках.Статус КАК Статус
	               |ПОМЕСТИТЬ Операции
	               |ИЗ
	               |	РегистрСведений.ОперацииВСделках КАК ОперацииВСделках
	               |ГДЕ
	               |	(НАЧАЛОПЕРИОДА(ОперацииВСделках.ДатаОтправленияФакт, ДЕНЬ) > НАЧАЛОПЕРИОДА(ОперацииВСделках.ДатаОтправления, ДЕНЬ)
	               |			ИЛИ НАЧАЛОПЕРИОДА(ОперацииВСделках.ДатаНазначенияФакт, ДЕНЬ) > НАЧАЛОПЕРИОДА(ОперацииВСделках.ДатаНазначения, ДЕНЬ)
	               |			ИЛИ ОперацииВСделках.ДатаОтправленияФакт = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |				И ОперацииВСделках.ДатаНазначения < &ТекущаяДата)
	               |	И ОперацииВСделках.Операция.Дата >= &Дата
	               |	И НЕ ОперацииВСделках.Операция.ПометкаУдаления
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ОперацииВСделках.Операция,
	               |	ОперацииВСделках.Исполнитель,
	               |	ОперацииВСделках.Наблюдатель,
	               |	ОперацииВСделках.Состояние,
	               |	ВЫБОР
	               |		КОГДА ОперацииВСделках.СебестоимостьФакт > ОперацииВСделках.Себестоимость
	               |			ТОГДА ЗНАЧЕНИЕ(Перечисление.КлассНарушенияАРМРуководителя.ОтклонениеЦены)
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА ОперацииВСделках.СебестоимостьФакт > ОперацииВСделках.Себестоимость
	               |			ТОГДА ОперацииВСделках.Себестоимость - ОперацииВСделках.СебестоимостьФакт
	               |	КОНЕЦ,
	               |	ОперацииВСделках.Статус
	               |ИЗ
	               |	РегистрСведений.ОперацииВСделках КАК ОперацииВСделках
	               |ГДЕ
	               |	ОперацииВСделках.СебестоимостьФакт > ОперацииВСделках.Себестоимость
	               |	И ОперацииВСделках.Операция.Дата > &Дата
	               |	И НЕ ОперацииВСделках.Операция.ПометкаУдаления
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ОперацииВСделках.Операция,
	               |	ОперацииВСделках.Исполнитель,
	               |	ОперацииВСделках.Наблюдатель,
	               |	ОперацииВСделках.Состояние,
	               |	ВЫБОР
	               |		КОГДА ОперацииВСделках.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЭтапов.Отклонен)
	               |			ТОГДА ЗНАЧЕНИЕ(Перечисление.КлассНарушенияАРМРуководителя.ОтказИсполнения)
	               |	КОНЕЦ,
	               |	NULL,
	               |	ОперацииВСделках.Статус
	               |ИЗ
	               |	РегистрСведений.ОперацииВСделках КАК ОперацииВСделках
	               |ГДЕ
	               |	ОперацииВСделках.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЭтапов.Отклонен)
	               |	И ОперацииВСделках.Операция.Дата > &Дата
	               |	И НЕ ОперацииВСделках.Операция.ПометкаУдаления
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МАКСИМУМ(ОперацияГрузы.ТС) КАК ТС,
	               |	ОперацияГрузы.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ ТСОперации
	               |ИЗ
	               |	Операции КАК Операции
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Операция.Грузы КАК ОперацияГрузы
	               |		ПО Операции.Операция = ОперацияГрузы.Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОперацияГрузы.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДислокацияВагоновСрезПоследних.СтанцияОперации КАК СтанцияОперации,
	               |	ДислокацияВагоновСрезПоследних.Вагон КАК Вагон
	               |ПОМЕСТИТЬ ДислокацияВагона
	               |ИЗ
	               |	РегистрСведений.ДислокацияВагонов.СрезПоследних(
	               |			,
	               |			Вагон В
	               |				(ВЫБРАТЬ
	               |					ТСОперации.ТС
	               |				ИЗ
	               |					ТСОперации КАК ТСОперации)) КАК ДислокацияВагоновСрезПоследних
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Операции.Исполнитель КАК Исполнитель,
	               |	Операции.Наблюдатель КАК Наблюдатель,
	               |	Операции.Операция КАК Операция,
	               |	Операции.Состояние КАК Состояние,
	               |	ДислокацияВагона.СтанцияОперации КАК Регион,
	               |	Операции.КлассНарушения КАК КлассНарушения,
	               |	Операции.МераОтклонения КАК МераОтклонения,
	               |	Операции.Операция.ДатаОтправления КАК ДатаОтправления,
	               |	Операции.Операция.ДатаНазначения КАК ДатаНазначения,
	               |	Операции.Статус КАК Статус
	               |ИЗ
	               |	Операции КАК Операции
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ТСОперации КАК ТСОперации
	               |			ЛЕВОЕ СОЕДИНЕНИЕ ДислокацияВагона КАК ДислокацияВагона
	               |			ПО ТСОперации.ТС = ДислокацияВагона.Вагон
	               |		ПО Операции.Операция = ТСОперации.Ссылка
	               |ГДЕ
	               |	НЕ Операции.Операция.ПометкаУдаления
	               |	И Операции.Статус В(&СписокРазрешенныхСтатусов)
	               |	И Операции.Операция.Дата > &РазрешеннаяДата";
	Запрос.УстановитьПараметр("Дата",НачалоДня(ТекущаяДата()-10*24*3600));
