//Евросиб Каблов 21.07.2020 (
//Процедура УведомитьПользователяОЕгоЗадачах() Экспорт
Процедура УведомитьПользователяОЕгоЗадачах(ОтборУведомлений = Неопределено) Экспорт
//Евросиб Каблов 21.07.2020 )	
	// первичная проверка на то, что мы вообще можем что-то отправить
	УчетнаяЗаписьПоУмолчанию = РаботаСПочтовымиСообщениями.ПроверитьСистемнаяУчетнаяЗаписьДоступна();
	
	Если не УчетнаяЗаписьПоУмолчанию Тогда возврат; КонецЕсли;
	СистемнаяУчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	АдресДублированияУведомлений = Константы.АдресДублированияОповещенийОЗадачах.Получить();
	ЗапретитьРассылкуЗадачСтаршеДней = Константы.ЗапретитьРассылкуЗадачСтаршеДней.Получить();
	Если ЗапретитьРассылкуЗадачСтаршеДней = 0 Тогда
		ЗапретитьРассылкуЗадачСтаршеДней = 999999;
	КонецЕсли;
	ДатаНачалаРазрешеннойРассылки = ТекущаяДата() - ЗапретитьРассылкуЗадачСтаршеДней * 24 * 3600;
	
	ПрефиксНС = Константы["АдресПубликацииИнформационнойБазыВЛокальнойСети"+?(ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована, "Тестовый", "")].Получить() + "#";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	УведомленияПользователейОЗадачах.Документ КАК Документ,
	               |	УведомленияПользователейОЗадачах.Пользователь КАК Пользователь,
	               |	УведомленияПользователейОЗадачах.Состояние КАК Состояние
	               |ИЗ
	               |	РегистрСведений.УведомленияПользователейОЗадачах КАК УведомленияПользователейОЗадачах
	               |ГДЕ
	               |	УведомленияПользователейОЗадачах.УведомлениеОЗадаче = ЛОЖЬ
////Евросиб Гудкова( 01.06.2020 Ticket№0196045 
//	               |	И (НЕ УведомленияПользователейОЗадачах.Пользователь.Недействителен)
//// Евросиб Гудкова) 				   
                   //ДИТ, Беляев СЮ, Ticket#0249084, 21-12-2021, ++
				   |	И (УведомленияПользователейОЗадачах.Пользователь Ссылка Справочник.ГруппыПользователей ИЛИ
				   |		(УведомленияПользователейОЗадачах.Пользователь ССЫЛКА Справочник.Пользователи И 
				   |		 НЕ ВЫРАЗИТЬ(УведомленияПользователейОЗадачах.Пользователь КАК Справочник.Пользователи).Недействителен))
				   //ДИТ, Беляев СЮ, Ticket#0249084, 21-12-2021, --
				   |	И УведомленияПользователейОЗадачах.Документ.Дата > &РазрешенноеНачало";
	Запрос.УстановитьПараметр("РазрешенноеНачало", ДатаНачалаРазрешеннойРассылки);
	//Евросиб Каблов 21.07.2020 (
	//Ответ = Запрос.Выполнить().Выбрать();	
	Если ТипЗнч(ОтборУведомлений) = Тип("Структура") Тогда
		
		ТекстыОтборов = Новый Массив;
		ЗначениеОтбора = Неопределено;
		
		Если ОтборУведомлений.Свойство("Документ", ЗначениеОтбора) Тогда
			ТекстыОтборов.Добавить(" И УведомленияПользователейОЗадачах.Документ = &Документ");
			Запрос.УстановитьПараметр("Документ", ЗначениеОтбора);
		КонецЕсли;
		
		Если ОтборУведомлений.Свойство("Состояние", ЗначениеОтбора) Тогда
			ТекстыОтборов.Добавить(" И УведомленияПользователейОЗадачах.Состояние = &Состояние");
			Запрос.УстановитьПараметр("Состояние", ЗначениеОтбора);
		КонецЕсли;
		
		Если ОтборУведомлений.Свойство("Пользователь", ЗначениеОтбора) Тогда
			ТекстыОтборов.Добавить(" И УведомленияПользователейОЗадачах.Пользователь = &Пользователь");
			Запрос.УстановитьПараметр("Пользователь", ЗначениеОтбора);
		КонецЕсли;
		
		РазделительСтрок = Символы.ПС + Символы.Таб;
		ТекстОтборов = СтрСоединить(ТекстыОтборов, РазделительСтрок);
		Запрос.Текст = Запрос.Текст + РазделительСтрок + ТекстОтборов;
		
	КонецЕсли;
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаУведомлений = РезультатЗапроса.Выгрузить();
	
	//Получение данных из табличных частей "Состояния" объектов
	ТекстыЗапросов = Новый Массив;	
	ИменаОбъектовМетаданных = Новый Массив;
	ШаблонТекстаЗапроса = 
	"ВЫБРАТЬ
	|	ТаблицаСостояний.Ссылка,
	|	ТаблицаСостояний.Состояние,
	|	ТаблицаСостояний.Комментарий
	|ИЗ
	|	%1.Состояния КАК ТаблицаСостояний
	|ГДЕ
	|	(ТаблицаСостояний.Ссылка, ТаблицаСостояний.Состояние) В
	|			(ВЫБРАТЬ
	|				ТаблицаУведомлений.Документ,
	|				ТаблицаУведомлений.Состояние
	|			ИЗ
	|				ТаблицаУведомлений КАК ТаблицаУведомлений)";
	
	ТекстЗапросаСПустымРезультатом =
	"ВЫБРАТЬ
	|	NULL КАК Документ,
	|	NULL КАК Состояние,
	|	NULL КАК Комментарий
	|ГДЕ
	|	ЛОЖЬ";
	ТекстыЗапросов.Добавить(ТекстЗапросаСПустымРезультатом);
	
	//Для Каждого СтрТаблицы Из ТаблицаУведомлений Цикл
	//	МетаданныеОбъекта = СтрТаблицы.Документ.Метаданные();
	//	ТЧСостояния = МетаданныеОбъекта.ТабличныеЧасти.Найти("Состояния");
	//	Если ТЧСостояния <> Неопределено Тогда
	//		ИмяОбъекта = МетаданныеОбъекта.ПолноеИмя();
	//		Если ИменаОбъектовМетаданных.Найти(ИмяОбъекта) = Неопределено Тогда
	//			ТекстЗапроса = СтрШаблон(ШаблонТекстаЗапроса, ИмяОбъекта);
	//			ТекстыЗапросов.Добавить(ТекстЗапроса);
	//		КонецЕсли;
	//	КонецЕсли;
	//КонецЦикла;
	
	//ДИТ, Беляев СЮ, Ticket#0249084, ++
	//Заполним массив объектами метаданных
	МассивОбъектовМетаданных = Новый Массив; 
	Для Каждого СтрТаблицы Из ТаблицаУведомлений Цикл
		МетаданныеОбъекта = СтрТаблицы.Документ.Метаданные();
		Если МассивОбъектовМетаданных.Найти(МетаданныеОбъекта) = Неопределено Тогда
			МассивОбъектовМетаданных.Добавить(МетаданныеОбъекта);
		КонецЕсли;
	КонецЦикла;                                                  
	
	//Сформируем один запрос для всех объектов метаданных
	Для каждого ЭлементМассива Из МассивОбъектовМетаданных Цикл
		ТЧСостояния = ЭлементМассива.ТабличныеЧасти.Найти("Состояния");
		Если ТЧСостояния <> Неопределено Тогда
			ИмяОбъекта = ЭлементМассива.ПолноеИмя();
			Если ИменаОбъектовМетаданных.Найти(ИмяОбъекта) = Неопределено Тогда
				ТекстЗапроса = СтрШаблон(ШаблонТекстаЗапроса, ИмяОбъекта);
				ТекстыЗапросов.Добавить(ТекстЗапроса);
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	//ДИТ, Беляев СЮ, Ticket#0249084, --
	
	ЗапросСозданияВТ = 
	"ВЫБРАТЬ
	|	ТаблицаУведомлений.Документ КАК Документ,
	|	ТаблицаУведомлений.Состояние КАК Состояние
	|ПОМЕСТИТЬ ТаблицаУведомлений
	|ИЗ
	|	&ТаблицаУведомлений КАК ТаблицаУведомлений
	|;
	|";
	
	ЗапросТаблицСостояний = СтрСоединить(ТекстыЗапросов, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);		
	Запрос.Текст = ЗапросСозданияВТ + ЗапросТаблицСостояний;
