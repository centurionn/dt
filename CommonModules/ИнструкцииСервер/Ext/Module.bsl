Процедура ДобавитьКнопкуИнструкции(Форма) Экспорт
	
	//Создаем Команду
	Команда = Форма.Команды.Добавить("ОткрытьОкноСИнструкциями");
	Команда.Картинка  = БиблиотекаКартинок.Информация;
	Команда.Заголовок = НСтр("ru = 'Инструкции'");
	Команда.Подсказка = НСтр("ru = 'Инструкции'");
	
	// кнопка вставляется в группу ГруппаГлавное

	Группа = Форма.Элементы.Найти("ГруппаГлавное"); 
		Если Группа = Неопределено Тогда 
			Группа = Форма.Элементы.Добавить("ГруппаГлавное",  Тип("ГруппаФормы"), Форма.КоманднаяПанель);
			Группа.Вид = ВидГруппыФормы.ГруппаКнопок;
		КонецЕсли;
		ГруппаЕще = Форма.Элементы.Найти("ГруппаГлавноеЕще");
		Если ГруппаЕще = Неопределено Тогда
			Команда.Действие  = "ОткрытьОкноСИнструкциями";
			//Создаем Кнопку
			ПередЧемВставить = Неопределено;
			Кнопка = Форма.Элементы.Вставить(Команда.Имя, Тип("КнопкаФормы"), Группа, ПередЧемВставить);
			Кнопка.ИмяКоманды = Команда.Имя;
			Кнопка.Отображение = ОтображениеКнопки.Картинка;
		Иначе
			Команда.Действие  = "ИнструкцииКлиент.ОткрытьОкноСИнструкциями";
			ОтчетыСервер.ВывестиКоманду(Форма, Команда, "Главное",, Ложь);
		КонецЕсли;
КонецПроцедуры 

