	ПараметрыКлючаАналитики.ДатаПрибытияОтправленияСУчетомРейса = Дата(1,1,1);
	
	ЗначенияРеквизитовРейса = Новый Структура("ДатаПрибытия, ДатаОтправления", Дата(1,1,1), Дата(1,1,1));
	Если (НЕ ЗначениеЗаполнено(ПараметрыКлючаАналитики.ДатаПрибытия)
		ИЛИ НЕ ЗначениеЗаполнено(ПараметрыКлючаАналитики.ДатаОтправления))
		И ЗначениеЗаполнено(ПараметрыКлючаАналитики.Рейс) Тогда
		ЗначенияРеквизитовРейса = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыКлючаАналитики.Рейс, "ДатаПрибытия, ДатаОтправления");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыКлючаАналитики.ДатаПрибытия) Тогда
		ПараметрыКлючаАналитики.ДатаПрибытияОтправленияСУчетомРейса = ПараметрыКлючаАналитики.ДатаПрибытия;
	ИначеЕсли ЗначениеЗаполнено(ЗначенияРеквизитовРейса.ДатаПрибытия) Тогда
		ПараметрыКлючаАналитики.ДатаПрибытияОтправленияСУчетомРейса = ЗначенияРеквизитовРейса.ДатаПрибытия;
	ИначеЕсли ЗначениеЗаполнено(ПараметрыКлючаАналитики.ДатаОтправления) Тогда
		ПараметрыКлючаАналитики.ДатаПрибытияОтправленияСУчетомРейса = ПараметрыКлючаАналитики.ДатаОтправления;
