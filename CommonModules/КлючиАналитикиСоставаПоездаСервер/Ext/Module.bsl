Функция ПолучитьПараметрыКлючаАналитики() Экспорт
	
	СтруктураПараметров = Новый Структура("ИдентификаторКлюча,
							|Сделка,
							|Клиент,
							|ВидТранспортногоСообщения,
							|ЖДН,
							|Коносамент,
							|ИдентификаторСтрокиЗаявки,
							|Контейнер,
							|Вагон,
							|ДатаПодачиАвтоПодВыгрузку,
							|ДатаОтправления,
							|ДатаПрибытия,
							|Активность,
							|ПунктОтправления,
							|ПунктНазначения,
							|Рейс,
							|СтанцияНазначенияАвтоПодВыгрузку,
							|ДатаПрибытияОтправленияСУчетомРейса
							|");
	СтруктураПараметров.ДатаПодачиАвтоПодВыгрузку = Дата(1,1,1);
	СтруктураПараметров.ДатаОтправления = Дата(1,1,1);
	СтруктураПараметров.ДатаПрибытия = Дата(1,1,1);
	СтруктураПараметров.СтанцияНазначенияАвтоПодВыгрузку = Справочники.Локации.ПустаяСсылка();
	Возврат СтруктураПараметров;
	
КонецФункции                                                  

Процедура ЗаполнитьПараметрыКлючаАналитики(ПараметрыКлючаАналитики, ДанныеЗаполнения) Экспорт
	
	ЗаполнитьЗначенияСвойств(ПараметрыКлючаАналитики, ДанныеЗаполнения);
	ПараметрыКлючаАналитики.ИдентификаторКлюча = ДанныеЗаполнения.ГУИД;
		
КонецПроцедуры

Функция СоздатьКлючАналитики(ПараметрыКлючаАналитики, Отказ = Ложь)
	
	ИдентификаторКлючаАналитики = Неопределено;
	Если НЕ ПараметрыКлючаАналитики.Свойство("ИдентификаторКлюча", ИдентификаторКлючаАналитики) 
		ИЛИ НЕ ЗначениеЗаполнено(ИдентификаторКлючаАналитики) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не задан обязательный параметр при создании ключа аналитики состава поезда: Идентификатор ключа");
		Отказ = Истина;
		Возврат Неопределено;
	КонецЕсли;
	КлючАналитики = ПолучитьКлючАналитикиПоИдентификатору(ПараметрыКлючаАналитики);
	Если КлючАналитики.Пустая() Тогда
		КлючАналитикиОбъект = Справочники.КлючиАналитикиСоставаПоезда.СоздатьЭлемент();
		ЗаполнитьЗначенияСвойств(КлючАналитикиОбъект, ПараметрыКлючаАналитики);
		КлючАналитикиОбъект.Наименование = КлючАналитикиОбъект.ИдентификаторКлюча;
		ЗаполнитьДатыОтправленияПрибытия(КлючАналитикиОбъект);
		Попытка
			КлючАналитикиОбъект.Записать();
			КлючАналитики = КлючАналитикиОбъект.Ссылка;
		Исключение
		    Отказ = Истина;
			ОписаниеОшибки = ОписаниеОшибки();
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Ошибка при создании ключа аналитики состава поезда: %1", ОписаниеОшибки));
			ЗаписьЖурналаРегистрации("Запись ключа аналитики состава поезда", УровеньЖурналаРегистрации.Ошибка, КлючАналитикиОбъект.Метаданные(), КлючАналитикиОбъект.Ссылка, ОписаниеОшибки);
		КонецПопытки;
		
	Иначе     
		ПараметрыКлючаАналитикиТекущие = ПолучитьПараметрыКлючаАналитики();
		ЗаполнитьЗначенияСвойств(ПараметрыКлючаАналитикиТекущие, КлючАналитики);
		ЗаполнитьДатыОтправленияПрибытия(ПараметрыКлючаАналитики);
		Если НЕ ОбщегоНазначения.КоллекцииИдентичны(ПараметрыКлючаАналитики, ПараметрыКлючаАналитикиТекущие) Тогда
			КлючАналитикиОбъект = КлючАналитики.ПолучитьОбъект();
			ЗаполнитьЗначенияСвойств(КлючАналитикиОбъект, ПараметрыКлючаАналитики);
				Попытка
					КлючАналитикиОбъект.Записать();
					КлючАналитики = КлючАналитикиОбъект.Ссылка;
				Исключение
					Отказ = Истина;
					ОписаниеОшибки = ОписаниеОшибки();
					ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Ошибка при создании ключа аналитики состава поезда: %1", ОписаниеОшибки));
					ЗаписьЖурналаРегистрации("Запись ключа аналитики состава поезда", УровеньЖурналаРегистрации.Ошибка, КлючАналитикиОбъект.Метаданные(), КлючАналитикиОбъект.Ссылка, ОписаниеОшибки);
				КонецПопытки;
			КонецЕсли;
	КонецЕсли;                
	Возврат КлючАналитики;
КонецФункции                                                     

Функция ПолучитьКлючАналитикиПоИдентификатору(ПараметрыКлючаАналитики)
	
	КлючАналитики = Справочники.КлючиАналитикиСоставаПоезда.ПустаяСсылка();
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КлючиАналитикиСоставаПоезда.Ссылка КАК КлючАналитики
	|ИЗ
	|	Справочник.КлючиАналитикиСоставаПоезда КАК КлючиАналитикиСоставаПоезда
	|ГДЕ
	|	КлючиАналитикиСоставаПоезда.ИдентификаторКлюча = &ИдентификаторКлюча
	|	И НЕ КлючиАналитикиСоставаПоезда.ПометкаУдаления";
	Запрос.УстановитьПараметр("ИдентификаторКлюча", ПараметрыКлючаАналитики.ИдентификаторКлюча);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат КлючАналитики;
	КонецЕсли;                
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.КлючАналитики;
		
КонецФункции

Процедура ЗаполнитьДатыОтправленияПрибытияВКлючахАналитики(ТранспортныйДокумент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КлючиАналитикиСоставаПоезда.Ссылка КАК Ссылка,
	|	ТранспортныйДокумент.ВидОперации КАК ВидОперации,
	|	ТранспортныйДокумент.ДатаОтправления КАК ДатаОтправления,
	|	ТранспортныйДокумент.ДатаПрибытия КАК ДатаПрибытия,
	|	ТранспортныйДокумент.ДатаРаскредитации КАК ДатаРаскредитации
	|ИЗ
	|	Справочник.КлючиАналитикиСоставаПоезда КАК КлючиАналитикиСоставаПоезда
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	|		ПО КлючиАналитикиСоставаПоезда.ЖДН = ТранспортныйДокумент.Ссылка
	|					И ТранспортныйДокумент.Ссылка = &ТранспортныйДокумент
	|					И НЕ КлючиАналитикиСоставаПоезда.ПометкаУдаления
	|					И (ТранспортныйДокумент.ДатаОтправления <> КлючиАналитикиСоставаПоезда.ДатаОтправления
	|						ИЛИ ТранспортныйДокумент.ДатаРаскредитации > КлючиАналитикиСоставаПоезда.ДатаПрибытия)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КлючиАналитикиСоставаПоезда.Ссылка,
	|	ТранспортныйДокумент.ВидОперации,
	|	ТранспортныйДокумент.ДатаОтправления,
	|	ТранспортныйДокумент.ДатаПрибытия,
	|	ТранспортныйДокумент.ДатаРаскредитации
	|ИЗ
	|	Справочник.КлючиАналитикиСоставаПоезда КАК КлючиАналитикиСоставаПоезда
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	|		ПО КлючиАналитикиСоставаПоезда.Коносамент = ТранспортныйДокумент.Ссылка
	|					И ТранспортныйДокумент.Ссылка = &ТранспортныйДокумент
	|					И НЕ КлючиАналитикиСоставаПоезда.ПометкаУдаления
	|					И (ТранспортныйДокумент.ДатаОтправления <> КлючиАналитикиСоставаПоезда.ДатаОтправления
	|						ИЛИ ТранспортныйДокумент.ДатаПрибытия > КлючиАналитикиСоставаПоезда.ДатаПрибытия)";
	Запрос.УстановитьПараметр("ТранспортныйДокумент", ТранспортныйДокумент);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		КлючАналитикиОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ЗаполнитьДатыОтправленияПрибытия(КлючАналитикиОбъект);
		Попытка
			КлючАналитикиОбъект.Записать();
		Исключение  
			ОписаниеОшибки = ОписаниеОшибки();
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Ошибка при записи ключа аналитики состава поезда: %1", ОписаниеОшибки));
			ЗаписьЖурналаРегистрации("Запись ключа аналитики состава поезда", УровеньЖурналаРегистрации.Ошибка, КлючАналитикиОбъект.Метаданные(), КлючАналитикиОбъект.Ссылка, ОписаниеОшибки);
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры 

