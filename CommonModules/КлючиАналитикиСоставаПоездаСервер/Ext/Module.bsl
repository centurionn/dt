	//КонецЕсли;
	Для каждого ЗначениеРеквизитовТранспортныхДокументов Из ЗначенияРеквизитовТранспортныхДокументов Цикл
		Если ЗначениеЗаполнено(ЗначениеРеквизитовТранспортныхДокументов.Значение.ДатаОтправления) Тогда      
			//Евросиб - АСуслов 01.03.2023 15:13:47 #65754
			//(
			//ДатаОтправления = Мин(ДатаОтправления, ЗначениеРеквизитовТранспортныхДокументов.Значение.ДатаОтправления);
			Если ЗначениеРеквизитовТранспортныхДокументов.Значение.ДатаОтправления < ДатаОтправления Тогда
				ДатаОтправления = ЗначениеРеквизитовТранспортныхДокументов.Значение.ДатаОтправления;
				ПунктОтправления = ЗначениеРеквизитовТранспортныхДокументов.Значение.СтанцияОтправления;
			КонецЕсли;
			//)
			//Евросиб - АСуслов 01.03.2023 15:13:49 #65754
		КонецЕсли;                            
	КонецЦикла;
