Функция ПроверитьДокументВыгруженВУППНаСервере(Документ)Экспорт
	
	РезультатПроверки = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СчетНаОплатуПоставщика.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ Вт_Документ
		|ИЗ
		|	Документ.СчетНаОплатуПоставщика КАК СчетНаОплатуПоставщика
		|ГДЕ
		|	СчетНаОплатуПоставщика.Ссылка = &Документ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПоступлениеТоваровУслуг.Ссылка
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|ГДЕ
		|	ПоступлениеТоваровУслуг.Ссылка = &Документ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ФиксацияИзмененийСчетаПоступления.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_ФиксацииИзмененийПоДокументу
		|ИЗ
		|	Вт_Документ КАК Вт_Документ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ФиксацияИзмененийСчетаПоступления КАК ФиксацияИзмененийСчетаПоступления
		|		ПО Вт_Документ.Ссылка = ФиксацияИзмененийСчетаПоступления.ИзменяемыйДокумент
		|ГДЕ
		|	НЕ ФиксацияИзмененийСчетаПоступления.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПротоколОбменов.Объект КАК Объект,
		|	ПротоколОбменов.ДатаОбмена КАК ДатаОбмена
		|ИЗ
		|	ВТ_ФиксацииИзмененийПоДокументу КАК ВТ_ФиксацииИзмененийПоДокументу
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
		|		ПО ВТ_ФиксацииИзмененийПоДокументу.Ссылка = ПротоколОбменов.Объект
		|			И (ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УппЗаказ))
		|			И (ПротоколОбменов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных))
		|ГДЕ
		|	ПротоколОбменов.ДатаОбмена ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ 
		|
		|ВЫБРАТЬ
		|	ПротоколОбменов.Объект,
		|	ПротоколОбменов.ДатаОбмена
		|ИЗ
		|	Вт_Документ КАК Вт_Документ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
		|		ПО Вт_Документ.Ссылка = ПротоколОбменов.Объект
		|			И (ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УппЗаказ))
		|			И (ПротоколОбменов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных))
		|ГДЕ
		|	ПротоколОбменов.ДатаОбмена ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Документ", Документ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	РезультатПроверки = РезультатЗапроса.Пустой();

	Возврат РезультатПроверки;
	
КонецФункции

Процедура ПроверитьКомандыВыгрузкиВУПП(ФормаДокумента, ТипДокумента, СсылкаДокумент) Экспорт  
	
	Если ТипДокумента = Тип("ДокументСсылка.СчетНаОплатуПоставщика") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаявкаНаОплатуДокументыНаОплату.Ссылка КАК Заявка,
		|	СчетНаОплатуПоставщика.Ссылка КАК Счет
		|ПОМЕСТИТЬ ВТ_Заявка
		|ИЗ
		|	Документ.ЗаявкаНаОплату.ДокументыНаОплату КАК ЗаявкаНаОплатуДокументыНаОплату
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетНаОплатуПоставщика КАК СчетНаОплатуПоставщика
		|		ПО ЗаявкаНаОплатуДокументыНаОплату.ОснованиеДляПлатежа = СчетНаОплатуПоставщика.Ссылка
		|			И (ЗаявкаНаОплатуДокументыНаОплату.Ссылка.Проведен)
		|			И (СчетНаОплатуПоставщика.Ссылка = &Ссылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СтатусыОбъектовСрезПоследних.Объект КАК Объект,
		|	СтатусыОбъектовСрезПоследних.Статус КАК Статус
		|ПОМЕСТИТЬ Вт_СтатусЗаявки
		|ИЗ
		|	РегистрСведений.СтатусыОбъектов.СрезПоследних(
		|			,
		|			Объект В
		|				(ВЫБРАТЬ
		|					ВТ_Заявка.Заявка КАК Заявка
		|				ИЗ
		|					ВТ_Заявка КАК ВТ_Заявка)) КАК СтатусыОбъектовСрезПоследних
		|ГДЕ
		|	СтатусыОбъектовСрезПоследних.Статус = &Статус
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Заявка.Заявка КАК Заявка
		|ИЗ
		|	ВТ_Заявка КАК ВТ_Заявка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Вт_СтатусЗаявки КАК Вт_СтатусЗаявки
		|		ПО ВТ_Заявка.Заявка = Вт_СтатусЗаявки.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.СвязанныеСчетаПоставщиков КАК ПоступлениеТоваровУслугСвязанныеСчетаПоставщиков
		|		ПО ВТ_Заявка.Счет = ПоступлениеТоваровУслугСвязанныеСчетаПоставщиков.СчетПоставщика
		|ГДЕ
		|	ПоступлениеТоваровУслугСвязанныеСчетаПоставщиков.Ссылка ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ФиксацияИзмененийСчетаПоступленияИзменения.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ФиксацияИзмененийСчетаПоступления.Изменения КАК ФиксацияИзмененийСчетаПоступленияИзменения
		|ГДЕ
		|	ФиксацияИзмененийСчетаПоступленияИзменения.Узел В (&Узел)
		|	И ФиксацияИзмененийСчетаПоступленияИзменения.Ссылка.ИзменяемыйДокумент = &Ссылка";
		
		Запрос.УстановитьПараметр("Статус", Справочники.СтатусыДокументов.ЗаявкаОплачена);
		Запрос.УстановитьПараметр("Ссылка", СсылкаДокумент);
		УзлыОбмена = ПланыОбмена.ВыгрузкаДанных.ПолучитьУзелОбмена(Перечисления.УзлыОбмена.УПП);
		Запрос.УстановитьПараметр("Узел", УзлыОбмена);

		
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса[2].Выбрать();
		
		Если НЕ РезультатЗапроса[2].Пустой() Тогда
			ФормаДокумента.Элементы.ФормаРедактироватьОплаченныйДокумент.Видимость = Истина;
		КонецЕсли;		
		
		Если НЕ РезультатЗапроса[3].Пустой() Тогда
			ФормаДокумента.Элементы.ФормаСоздатьКЗП.Видимость = Истина;
			ФормаДокумента.Элементы.ФормаВыгрузитьВУПП.Видимость = Ложь;
		КонецЕсли;
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаявкаНаОплатуДокументыНаОплату.Ссылка КАК Заявка,
		|	ПоступлениеТоваровУслуг.Ссылка КАК ПТУ
		|ПОМЕСТИТЬ ВТ_Заявка
		|ИЗ
		|	Документ.ЗаявкаНаОплату.ДокументыНаОплату КАК ЗаявкаНаОплатуДокументыНаОплату
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|		ПО ЗаявкаНаОплатуДокументыНаОплату.ОснованиеДляПлатежа = ПоступлениеТоваровУслуг.Ссылка
		|			И (ЗаявкаНаОплатуДокументыНаОплату.Ссылка.Проведен)
		|			И (ПоступлениеТоваровУслуг.Ссылка = &Ссылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СтатусыОбъектовСрезПоследних.Объект КАК Объект,
		|	СтатусыОбъектовСрезПоследних.Статус КАК Статус
		|ПОМЕСТИТЬ Вт_СтатусЗаявки
		|ИЗ
		|	РегистрСведений.СтатусыОбъектов.СрезПоследних(
		|			,
		|			Объект В
		|				(ВЫБРАТЬ
		|					ВТ_Заявка.Заявка КАК Заявка
		|				ИЗ
		|					ВТ_Заявка КАК ВТ_Заявка)) КАК СтатусыОбъектовСрезПоследних
		|ГДЕ
		|	СтатусыОбъектовСрезПоследних.Статус = &Статус
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Заявка.Заявка КАК Заявка,
		|	ВТ_Заявка.ПТУ КАК ПТУ
		|ПОМЕСТИТЬ ОплаченныеЗаявки
		|ИЗ
		|	ВТ_Заявка КАК ВТ_Заявка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Вт_СтатусЗаявки КАК Вт_СтатусЗаявки
		|		ПО ВТ_Заявка.Заявка = Вт_СтатусЗаявки.Объект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ФиксацияИзмененийСчетаПоступленияИзменения.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ФиксацияИзмененийСчетаПоступления.Изменения КАК ФиксацияИзмененийСчетаПоступленияИзменения
		|ГДЕ
		|	ФиксацияИзмененийСчетаПоступленияИзменения.Узел В (&Узел)
		|	И ФиксацияИзмененийСчетаПоступленияИзменения.Ссылка.ИзменяемыйДокумент = &Ссылка";
		
		Запрос.УстановитьПараметр("Статус", Справочники.СтатусыДокументов.ЗаявкаОплачена);
		Запрос.УстановитьПараметр("Ссылка", СсылкаДокумент);
		УзлыОбмена = ПланыОбмена.ВыгрузкаДанных.ПолучитьУзелОбмена(Перечисления.УзлыОбмена.УПП);
		Запрос.УстановитьПараметр("Узел", УзлыОбмена);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		
		Если НЕ РезультатЗапроса.Пустой() Тогда 
			ФормаДокумента.Элементы.ФормаСоздатьКЗП.Видимость = Истина;
			ФормаДокумента.Элементы.ФормаВыгрузитьЗаказВУПП.Видимость = Ложь; 		
		КонецЕсли;		
	КонецЕсли;
	
	
КонецПроцедуры	

Функция ПроверитьВыгрузкуКЗП(Ссылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ФиксацияИзмененийСчетаПоступленияИзменения.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ФиксацияИзмененийСчетаПоступления.Изменения КАК ФиксацияИзмененийСчетаПоступленияИзменения
		|ГДЕ
		|	ФиксацияИзмененийСчетаПоступленияИзменения.Узел в (&Узел)
		|	И ФиксацияИзмененийСчетаПоступленияИзменения.Ссылка.ИзменяемыйДокумент = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	УзлыОбмена = ПланыОбмена.ВыгрузкаДанных.ПолучитьУзелОбмена(Перечисления.УзлыОбмена.УПП);

	Запрос.УстановитьПараметр("Узел", УзлыОбмена);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	 
	Возврат РезультатЗапроса.Пустой();
	
	
КонецФункции

