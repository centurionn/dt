Процедура ПроверитьИСоздатьКомандыСозданияЗаявокНаоплату(Форма, СсылкаНаДокумент) Экспорт
	
	ВариантыСтавок = Перечисления.СтавкиНДС;
	Для Каждого ВидСтавки из ВариантыСтавок Цикл
		ВидСтавки = СтрЗаменить(ВидСтавки,"%","");
		ВидСтавки = СтрЗаменить(ВидСтавки,"/","_");
		ВидСтавки = СтрЗаменить(ВидСтавки," ","");
		ЗначениеДляПоиска = "ФормаДокументЗаявкаНаОплатуСоздатьНаОсновании" + ВидСтавки;
		
		НайденныйЭлементФормы = Форма.Элементы.Найти(ЗначениеДляПоиска);
		Если НайденныйЭлементФормы <> Неопределено  Тогда
			Форма.Элементы.Удалить(НайденныйЭлементФормы); 
		КонецЕсли; 
		ИмяКоманды = "СоздатьНаОснованииЗаявкуНаОплатуПоСтавке" + ВидСтавки;
		НайденныеКоманды = Форма.Команды.Найти(ИмяКоманды);
		Если НайденныеКоманды <> Неопределено  Тогда
			Форма.Команды.Удалить(НайденныеКоманды); 
		КонецЕсли;
	КонецЦикла;
	
	СоответствиеСтавок = ПолучитьСоответствиеСтавокНДС(СсылкаНаДокумент);
	Если СоответствиеСтавок.количество() > 1 Тогда
		Для Каждого Ставка из СоответствиеСтавок Цикл
			Если Ставка.ключ = Перечисления.СтавкиНДС.ПустаяСсылка() Тогда
				Продолжить;
			КонецЕсли;	
			СтавкаБезПроцента =  ?(Ставка.Ключ = перечисления.СтавкиНДС.БезНДС, Ставка.Ключ, СтрЗаменить(Ставка.Ключ,"%",""));
			СтавкаПреобразованная = СтрЗаменить(СтавкаБезПроцента,"/","_");
			СтавкаПреобразованная = СтрЗаменить(СтавкаПреобразованная," ","");
			
			ИмяКоманды = "СоздатьНаОснованииЗаявкуНаОплатуПоСтавке" + СтавкаПреобразованная;
			Команда = Форма.Команды.Добавить(ИмяКоманды);
			Команда.Действие = "СоздатьНаОснованииЗаявкаНаОплату";
			
			Если ТипЗнч(СсылкаНаДокумент) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
				КнопкаЗаявкаНаОплатуСоздатьНаОсновании = Форма.Элементы.Вставить("ФормаДокументЗаявкаНаОплатуСоздатьНаОсновании" + СтавкаПреобразованная, Тип("КнопкаФормы"),
				Форма.Элементы.ФормаСоздатьНаОсновании, Форма.Элементы.ФормаСоздатьНаОсновании.ПодчиненныеЭлементы.ФормаДокументСчетНаОплатуПоставщикаЗаявкаНаОплату);
			ИначеЕсли ТипЗнч(СсылкаНаДокумент) = Тип("ДокументСсылка.СчетНаОплатуПоставщика") Тогда
				КнопкаЗаявкаНаОплатуСоздатьНаОсновании = Форма.Элементы.Вставить("ФормаДокументЗаявкаНаОплатуСоздатьНаОсновании" + СтавкаПреобразованная, Тип("КнопкаФормы"),
				Форма.Элементы.ФормаСоздатьНаОсновании, Форма.Элементы.ФормаСоздатьНаОсновании.ПодчиненныеЭлементы.ФормаДокументПоступлениеТоваровУслугЗаявкаНаОплату);
			КонецЕсли;
			КнопкаЗаявкаНаОплатуСоздатьНаОсновании.Заголовок = "Заявка на оплату со ставкой " + Ставка.Ключ; 
			КнопкаЗаявкаНаОплатуСоздатьНаОсновании.ИмяКоманды = ИмяКоманды;
			КнопкаЗаявкаНаОплатуСоздатьНаОсновании.РасширеннаяПодсказка.Заголовок = СтавкаПреобразованная;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры 
