Функция ПолучитьДанныеДляЗаполненияЗаявокПоДокументамОплаты(ОснованияДляПлатежа) Экспорт
	
	Если ТипЗнч(ОснованияДляПлатежа) <> Тип("Массив") Тогда
		МассивОснованияДляПлатежа = Новый Массив;
		МассивОснованияДляПлатежа.Добавить(ОснованияДляПлатежа);
	Иначе
		МассивОснованияДляПлатежа = ОснованияДляПлатежа;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	//Евросиб СубботинВ #102528 09.04.2025 Начало

	//"ВЫБРАТЬ
	//|	ВзаиморасчетыСПоставщикамиОстатки.ДокументВзаиморасчетов КАК ДокументВзаиморасчетов,
	//|	ВзаиморасчетыСПоставщикамиОстатки.СуммаБезНДСОстаток КАК СуммаБезНДСОстаток
	//|ПОМЕСТИТЬ ВТ_ОстаткиВзаиморасчетов
	//|ИЗ
	//|	РегистрНакопления.ВзаиморасчетыСПоставщиками.Остатки(, ДокументВзаиморасчетов В (&СписокОснованияДляПлатежа)) КАК ВзаиморасчетыСПоставщикамиОстатки
	//|;
	//|
	//|////////////////////////////////////////////////////////////////////////////////
	//|ВЫБРАТЬ
	//|	ЗаявкиНаОплатуОстатки.СуммаОстаток КАК СуммаОстаток,
	//|	ЗаявкиНаОплатуОстатки.ОснованиеДляПлатежа КАК ОснованиеДляПлатежа
	//|ПОМЕСТИТЬ ВТ_ОстаткиЗаявокНаОплату
	//|ИЗ
	//|	РегистрНакопления.ЗаявкиНаОплату.Остатки(, ОснованиеДляПлатежа В (&СписокОснованияДляПлатежа)) КАК ЗаявкиНаОплатуОстатки
	//|;
	//|
	//|////////////////////////////////////////////////////////////////////////////////
	//|ВЫБРАТЬ
	//|	СчетНаОплатуПоставщика.Ссылка КАК Ссылка
	//|ПОМЕСТИТЬ ВТ_СписокДокументов
	//|ИЗ
	//|	Документ.СчетНаОплатуПоставщика КАК СчетНаОплатуПоставщика
	//|ГДЕ
	//|	СчетНаОплатуПоставщика.Ссылка В(&СписокОснованияДляПлатежа)
	//|
	//|ОБЪЕДИНИТЬ ВСЕ
	//|
	//|ВЫБРАТЬ
	//|	ПоступлениеТоваровУслуг.Ссылка
	//|ИЗ
	//|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	//|ГДЕ
	//|	ПоступлениеТоваровУслуг.Ссылка В(&СписокОснованияДляПлатежа)
	//|;
	//|
	//|////////////////////////////////////////////////////////////////////////////////
	//|ВЫБРАТЬ
	//|	ВТ_СписокДокументов.Ссылка КАК ОснованиеДляПлатежа,
	//|	ВЫБОР
	//|			КОГДА ЕСТЬNULL(ВТ_ОстаткиЗаявокНаОплату.СуммаОстаток, 0) <= ЕСТЬNULL(ВТ_ОстаткиВзаиморасчетов.СуммаБезНДСОстаток, 0)
	//|					ИЛИ ВТ_ОстаткиВзаиморасчетов.СуммаБезНДСОстаток ЕСТЬ NULL
	//|				ТОГДА ЕСТЬNULL(ВТ_ОстаткиЗаявокНаОплату.СуммаОстаток, 0)
	//|			ИНАЧЕ ВТ_ОстаткиВзаиморасчетов.СуммаБезНДСОстаток
	//|		КОНЕЦ КАК СуммаОплаты
	//|ИЗ
	//|	ВТ_СписокДокументов КАК ВТ_СписокДокументов
	//|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОстаткиВзаиморасчетов КАК ВТ_ОстаткиВзаиморасчетов
	//|		ПО ВТ_СписокДокументов.Ссылка = ВТ_ОстаткиВзаиморасчетов.ДокументВзаиморасчетов
	//|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОстаткиЗаявокНаОплату КАК ВТ_ОстаткиЗаявокНаОплату
	//|		ПО ВТ_СписокДокументов.Ссылка = ВТ_ОстаткиЗаявокНаОплату.ОснованиеДляПлатежа
	//|;
	//|
	//|////////////////////////////////////////////////////////////////////////////////
	//|ВЫБРАТЬ
	//|	СчетНаОплатуПоставщикаТовары.СтавкаНДС КАК СтавкаНДС,
	//|	ВТ_ОстаткиВзаиморасчетов.ДокументВзаиморасчетов КАК ОснованиеДляПлатежа
	//|ИЗ
	//|	Документ.СчетНаОплатуПоставщика.Товары КАК СчетНаОплатуПоставщикаТовары
	//|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОстаткиВзаиморасчетов КАК ВТ_ОстаткиВзаиморасчетов
	//|		ПО СчетНаОплатуПоставщикаТовары.Ссылка = ВТ_ОстаткиВзаиморасчетов.ДокументВзаиморасчетов
	//|
	//|ОБЪЕДИНИТЬ
	//|
	//|ВЫБРАТЬ
	//|	ПоступлениеТоваровУслугУслуги.СтавкаНДС,
	//|	ВТ_ОстаткиВзаиморасчетов.ДокументВзаиморасчетов
	//|ИЗ
	//|	Документ.ПоступлениеТоваровУслуг.Услуги КАК ПоступлениеТоваровУслугУслуги
	//|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОстаткиВзаиморасчетов КАК ВТ_ОстаткиВзаиморасчетов
	//|		ПО ПоступлениеТоваровУслугУслуги.Ссылка = ВТ_ОстаткиВзаиморасчетов.ДокументВзаиморасчетов"; 
	//
		"ВЫБРАТЬ
		|	ЗаявкиНаОплатуОстатки.ОснованиеДляПлатежа КАК ДокументВзаиморасчетов,
		|	ЗаявкиНаОплатуОстатки.СуммаОстаток КАК СуммаБезНДСОстаток,
		|	ЗаявкиНаОплатуОстатки.СуммаНДСОстаток КАК СуммаНДСОстаток,
		|	ЗаявкиНаОплатуОстатки.СтавкаНДС КАК СтавкаНДС
		|ПОМЕСТИТЬ ВТ_ОстаткиВзаиморасчетов
		|ИЗ
		|	РегистрНакопления.ЗаявкиНаОплату.Остатки(, ОснованиеДляПлатежа В (&СписокОснованияДляПлатежа)) КАК ЗаявкиНаОплатуОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаявкиНаОплатуОстатки.СуммаОстаток КАК СуммаОстаток,
		|	ЗаявкиНаОплатуОстатки.ОснованиеДляПлатежа КАК ОснованиеДляПлатежа
		|ПОМЕСТИТЬ ВТ_ОстаткиЗаявокНаОплату
		|ИЗ
		|	РегистрНакопления.ЗаявкиНаОплату.Остатки(, ОснованиеДляПлатежа В (&СписокОснованияДляПлатежа)) КАК ЗаявкиНаОплатуОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СчетНаОплатуПоставщика.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_СписокДокументов
		|ИЗ
		|	Документ.СчетНаОплатуПоставщика КАК СчетНаОплатуПоставщика
		|ГДЕ
		|	СчетНаОплатуПоставщика.Ссылка В(&СписокОснованияДляПлатежа)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПоступлениеТоваровУслуг.Ссылка
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|ГДЕ
		|	ПоступлениеТоваровУслуг.Ссылка В(&СписокОснованияДляПлатежа)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СписокДокументов.Ссылка КАК ОснованиеДляПлатежа,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТ_ОстаткиЗаявокНаОплату.СуммаОстаток, 0) <= ЕСТЬNULL(ВТ_ОстаткиВзаиморасчетов.СуммаБезНДСОстаток, 0)
		|				ИЛИ ВТ_ОстаткиВзаиморасчетов.СуммаБезНДСОстаток ЕСТЬ NULL
		|			ТОГДА ЕСТЬNULL(ВТ_ОстаткиЗаявокНаОплату.СуммаОстаток, 0)
		|		ИНАЧЕ ВТ_ОстаткиВзаиморасчетов.СуммаБезНДСОстаток
		|	КОНЕЦ КАК СуммаОплаты,
		|	ВТ_ОстаткиВзаиморасчетов.СтавкаНДС КАК СтавкаНДС,
		|	ВТ_ОстаткиВзаиморасчетов.СуммаНДСОстаток КАК СуммаНДСОстаток
		|ИЗ
		|	ВТ_СписокДокументов КАК ВТ_СписокДокументов
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОстаткиВзаиморасчетов КАК ВТ_ОстаткиВзаиморасчетов
		|		ПО ВТ_СписокДокументов.Ссылка = ВТ_ОстаткиВзаиморасчетов.ДокументВзаиморасчетов
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОстаткиЗаявокНаОплату КАК ВТ_ОстаткиЗаявокНаОплату
		|		ПО ВТ_СписокДокументов.Ссылка = ВТ_ОстаткиЗаявокНаОплату.ОснованиеДляПлатежа";
	
	//Евросиб СубботинВ #102528 09.04.2025 Конец

	Запрос.УстановитьПараметр("СписокОснованияДляПлатежа", МассивОснованияДляПлатежа);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	КоличествоРезультатов = РезультатЗапроса.Количество();
	//Евросиб СубботинВ #102528 09.04.2025 Начало
    //ВыборкаРезультатаЗапроса = РезультатЗапроса[КоличествоРезультатов-2].Выбрать();
	ВыборкаРезультатаЗапроса = РезультатЗапроса[КоличествоРезультатов-1].Выбрать();
	//Евросиб СубботинВ #102528 09.04.2025 Конец
	РезультатСоответствие = Новый Соответствие;
	Пока ВыборкаРезультатаЗапроса.Следующий() Цикл 
		СтруктураДанных = Новый Структура;                                           
		СтруктураДанных.Вставить("СуммаОплаты", ВыборкаРезультатаЗапроса.СуммаОплаты);
		//Евросиб СубботинВ #102528 09.04.2025 Начало
        СтруктураДанных.Вставить("СтавкаНДС", ВыборкаРезультатаЗапроса.СтавкаНДС);
        СтруктураДанных.Вставить("СуммаНДС", ВыборкаРезультатаЗапроса.СуммаНДСОстаток);		
		//Евросиб СубботинВ #102528 09.04.2025 Конец
		РезультатСоответствие.Вставить(ВыборкаРезультатаЗапроса.ОснованиеДляПлатежа, СтруктураДанных);
	КонецЦикла;
	
	//Евросиб СубботинВ #102528 09.04.2025 Начало
	//ВыборкаРезультатаЗапроса = РезультатЗапроса[КоличествоРезультатов-1].Выбрать();
	//Пока ВыборкаРезультатаЗапроса.Следующий() Цикл
	//	СтруктураДанных = РезультатСоответствие.Получить(ВыборкаРезультатаЗапроса.ОснованиеДляПлатежа);
	//	СтруктураДанных.Вставить("СтавкаНДС", ВыборкаРезультатаЗапроса.СтавкаНДС);;
	//КонецЦикла;
	
	//Если ТипЗнч(ОснованияДляПлатежа) <> Тип("Массив") Тогда
	//	Возврат СтруктураДанных;
	//Иначе
	Возврат РезультатСоответствие;
	//КонецЕсли; 
	//Евросиб СубботинВ #102528 09.04.2025 Конец

			
КонецФункции

Процедура ПроверитьВозможностьЗаписиДокумента(Объект, Отказ, ПризнакОтменыПроведения = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка)
		ИЛИ Объект.ДополнительныеСвойства.Свойство("ПерезаполнениеВалютыИзЗаявки")
		ИЛИ Объект.ДополнительныеСвойства.Свойство("ПерезаполнениеДатыОплатыИзЗаявки")
		ИЛИ Объект.ДополнительныеСвойства.Свойство("ПерезаполнениеСтавкиНДСИзЗаявки")
		Тогда
		Возврат;
	КонецЕсли;
	
	//Евросиб СубботинВ #118799 09.10.2025 Начало
	Если Объект.ДополнительныеСвойства.Свойство("РедактированиеОплаченойЗаявки") Тогда
		Если Объект.СуммаДокумента < ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "СуммаДокумента") Тогда 
			ВызватьИсключение("Сумма оплаченного счета не может быть уменьшена. Изменения будут отменены");
		Иначе 
			Возврат
		КонецЕсли;		
	КонецЕсли;	
	//Евросиб СубботинВ #118799 09.10.2025 Конец	
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	//Евросиб СубботинВ #99828 22.01.2025 Начало 
	//"ВЫБРАТЬ
	//|	СвязанныеДокументы.Ссылка КАК Ссылка
	//|ИЗ
	//|	КритерийОтбора.СвязанныеДокументы(&Ссылка) КАК СвязанныеДокументы
	//|ГДЕ
	//|	СвязанныеДокументы.Ссылка ССЫЛКА Документ.ЗаявкаНаОплату";
	//если есть заявки не в статусе подготовлен тогда только блочим
	
	"ВЫБРАТЬ
	|	СвязанныеДокументы.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Документы
	|ИЗ
	|	КритерийОтбора.СвязанныеДокументы(&Ссылка) КАК СвязанныеДокументы
	|ГДЕ
	|	СвязанныеДокументы.Ссылка ССЫЛКА Документ.ЗаявкаНаОплату
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтатусыОбъектовСрезПоследних.Объект КАК Объект,
	|	СтатусыОбъектовСрезПоследних.Статус КАК Статус
	|ИЗ
	|	РегистрСведений.СтатусыОбъектов.СрезПоследних(
	|			,
	|			Объект В
	|				(ВЫБРАТЬ
	|					ВТ_Документы.Ссылка КАК Ссылка
	|				ИЗ
	|					ВТ_Документы КАК ВТ_Документы)) КАК СтатусыОбъектовСрезПоследних
	|ГДЕ
	|	НЕ СтатусыОбъектовСрезПоследних.Статус = &Статус
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Диадок_Документы.Документ КАК Документ,
	|	Диадок_Документы.Статус КАК Статус
	|ИЗ
	|	Справочник.Диадок_Документы КАК Диадок_Документы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|		ПО (Диадок_Документы.Документ = &Ссылка)
	|			И (ПоступлениеТоваровУслуг.Ссылка = Диадок_Документы.Документ)
	|			И (Диадок_Документы.Статус = ""Аннулирован"")
	|			И (ПоступлениеТоваровУслуг.СтатусДокумента = &СтатусДокументаПТУ)";
		
	Запрос.УстановитьПараметр("Статус", Справочники.СтатусыДокументов.Подготовлена);
	Запрос.УстановитьПараметр("СтатусДокументаПТУ", Перечисления.СтатусыДокументовПоступлений.Аннулирован);

	
	//Евросиб СубботинВ #99828 22.01.2025 Конец
	
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	РезультатЗапроса = Запрос.ВыполнитьПакет(); 
	ЗаявкиНаОплату = РезультатЗапроса[1];
	СтатусЭдо = РезультатЗапроса[2];
	Если НЕ СтатусЭдо.Пустой() Тогда //если аннулирован то редактируется без ограничений и остальное даже не проверяем
		Возврат;
	КонецЕсли;	
	Отказ = НЕ ЗаявкиНаОплату.Пустой()
		И (ИзмененыКлючевыеРеквизиты(Объект) или ПризнакОтменыПроведения);
	Если Отказ Тогда
		ВызватьИсключение "По документу создана заявка на оплату, изменение документа, включенного в заявку на оплату, запрещено.
		|Для возможности редактирования документа исключите его из заявки на оплату.";
	КонецЕсли;
	//Евросиб СубботинВ #99828 22.01.2025 Конец

КонецПроцедуры

Функция ИзмененыКлючевыеРеквизиты(Объект)
	
	//Евросиб СубботинВ #99828 22.01.2025 Начало
	//Если ТипЗнч(Объект) <> Тип("ДокументОбъект.ПоступлениеТоваровУслуг") Тогда
	//	Возврат Истина;
	//КонецЕсли;
	ИзмененыКлючевыеРеквизиты = Ложь;
	Если НЕ ТипЗнч(Объект) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг") И НЕ ТипЗнч(Объект) = Тип("ДокументОбъект.СчетНаОплатуПоставщика") Тогда
		Возврат ИзмененыКлючевыеРеквизиты;	
	Иначе	

        //Возврат Ложь;
		//КонецЕсли;		
		//ИзмененыКлючевыеРеквизиты = Ложь;
		//Евросиб СубботинВ #99828 22.01.2025 Конец
		//изменение реквизитов:
		//a)	Контрагент
		//b)	Договор Контрагента
		//c)	Валюта договора/Валюта оплаты – для мультивалютных договоров
		//d)	Ставка НДС в ТЧ вкладки Услуги/товары
		//e)	Данные в ТЧ вкладки Разнесение ПТУ по счетам  
		
		ЭтоМультивалютныйДоговор = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ДоговорКонтрагента, "МультивалютныйДоговор"); 
		// Евросиб(ДИТ) US 73033 ТА 87495 Сержантова А.С. Начало: 03.09.2024
		// Было:
		//Если Объект.Контрагент <> Объект.Ссылка.Контрагент
		//	или Объект.ДоговорКонтрагента <> Объект.Ссылка.ДоговорКонтрагента 
		//	 или не ОбщегоНазначения.КоллекцииИдентичны(Объект.СвязанныеСчетаПоставщиков.Выгрузить(), Объект.Ссылка.СвязанныеСчетаПоставщиков.Выгрузить(),,,Истина) 
