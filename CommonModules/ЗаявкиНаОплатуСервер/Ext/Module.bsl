Процедура ОтправитьДокументНаРедактирование(ОбъектЗаявка) Экспорт
	
		
	ТЧсостояния = ОбъектЗаявка.Состояния;
	//Евросиб СубботинВ #107396 17.04.2025 Начало 
	АннулированТекущимПользователем = Ложь;
	//Евросиб СубботинВ #107396 17.04.2025 Конец
	Для Каждого СтрокаСостояний из ТЧсостояния Цикл
		//Евросиб СубботинВ #107396 17.04.2025 Начало 
		Если НЕ АннулированТекущимПользователем И СтрокаСостояний.Исполнитель = Пользователи.ТекущийПользователь() Тогда
			СтрокаСостояний.Статус = Перечисления.СтатусыЭтапов.Отклонен;
			СтрокаСостояний.СтатусСогласования = Перечисления.СтатусыСогласования.ОтклоненоСЗамечаниями;
			АннулированТекущимПользователем = Истина;
			Продолжить;
		КонецЕсли;
		//Евросиб СубботинВ #107396 17.04.2025 Конец
		Если СтрокаСостояний.Статус = Перечисления.СтатусыЭтапов.Выполнен Тогда
			Продолжить;
		Иначе	
			СтрокаСостояний.Статус = Перечисления.СтатусыЭтапов.Выполнен; 
		КонецЕсли; 
	КонецЦикла;
	
	ЗадачаРедактирования = ТЧсостояния.Добавить();
	ЗадачаРедактирования.Исполнитель = ОбъектЗаявка.Автор;
	ЗадачаРедактирования.Наблюдатель = ОбъектЗаявка.Автор;
	ЗадачаРедактирования.Состояние = Справочники.Состояния.РедактированиеДокумента;
	ЗадачаРедактирования.Статус = Перечисления.СтатусыЭтапов.ВРаботе;
	ЗадачаРедактирования.НачалоРаботы = ТекущаяДата();
	
	
КонецПроцедуры
