
Функция УстановкаДатыДокумента(Объект,ПравилоФормированияДатыУслуги, ПериодичностьВыставления, ДатаПаспортаСделки, СтруктураПоиска = Неопределено) Экспорт
	
	ВыводитьНомерСтроки = Ложь;
	Если ЗначениеЗаполнено(СтруктураПоиска) Тогда
//Евросиб Гудкова( 14.10.2020 Ticket№ 0209986		ПериодВО = СтруктураПоиска.ПериодВО;
		Контрагент = СтруктураПоиска.Клиент;
		Дата = СтруктураПоиска.Дата;
		ВыводитьНомерСтроки = Истина;
	Иначе
//Евросиб Гудкова( 14.10.2020 Ticket№ 0209986		ПериодВО = Объект.ПериодВО;
		Контрагент = Объект.Контрагент;
		Дата = Объект.Дата;
	КонецЕсли; 
	
	//Евросиб Каблов 09.04.2025 ( #105407
	//ДатаОткрытогоПериода = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериод(Объект.Организация);
	ДатаОткрытогоПериода = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериодДоходов(Объект.Организация);
	//Евросиб Каблов 09.04.2025 )
	
	ДатаДок = Дата(1,1,1,0,0,0);
	
//Евросиб Гудкова( 14.10.2020 Ticket№ 0209986 не катят. так период ВО неправильно определяется
	//// для нерезидента упрощенные правила
	//Если НЕ Контрагент.СтранаРегистрации = Справочники.СтраныМира.Россия Тогда
	//	Если ПериодВО = НачалоМесяца(ТекущаяДата()) Тогда
	//		ДатаДок = ТекущаяДата();
	//	ИначеЕсли ПериодВО < НачалоМесяца(ТекущаяДата()) Тогда 
	//		ДатаДок = КонецМесяца(ПериодВО);
	//	КонецЕсли; 
	//	Если ДатаПаспортаСделки > ДатаДок Тогда
	//		ДатаДок = ДатаПаспортаСделки;
	//	КонецЕсли; 
	//	Возврат ДатаДок;
	//КонецЕсли;
// Евросиб Гудкова) 	
	
	// для резидента
	
	// в зависимости от документа, вызвавшего функцию (РТУ, Счет или СФВ) нужно подготовить таблицу-параметр
	// 1. РТУ - просто выгрузка ТЧ Услуги
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		ВремТЧ = Объект.Услуги.Выгрузить();
		Возврат ТекущаяДата();
		
	// 2. Счет. По ГУИД строки доходов находим строку в доходной части сделки и берем оттуда СписокТД
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.СчетНаОплатуПокупателю") Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 	
		"ВЫБРАТЬ
		|	ТЧДокумента.Номенклатура КАК Номенклатура,
		|	ТЧДокумента.СтрокаДоходовСделки КАК СтрокаДоходовСделки
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ТЧДокумента КАК ТЧДокумента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Номенклатура КАК Номенклатура,
		|	ВТ.СтрокаДоходовСделки КАК СтрокаДоходовСделки,
		|	СделкаДоходыТД.ТД КАК СписокТД,
		|	СделкаДоходыКТК.КТК КАК СписокТЕ,
		|	ЗНАЧЕНИЕ(Документ.ТранспортныйДокумент.ПустаяСсылка) КАК Коносамент,
		|	&Контрагент КАК Клиент
		|ИЗ
		|	ВТ КАК ВТ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.ДоходыТД КАК СделкаДоходыТД
		|		ПО ВТ.СтрокаДоходовСделки = СделкаДоходыТД.ГУИД
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.ДоходыКТК КАК СделкаДоходыКТК
		|		ПО ВТ.СтрокаДоходовСделки = СделкаДоходыКТК.ГУИД";
		Запрос.УстановитьПараметр("ТЧДокумента",Объект.Товары.Выгрузить());
		Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
		ВремТЧ = Запрос.Выполнить().Выгрузить();
		
	// 3. Счет-фактура выданный. По документу основанию находим нужную реализацию и получаем ее ТЧ
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.СчетФактураВыданный") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 	
		"ВЫБРАТЬ
		|	ТЧДокумента.ДокументОснование КАК ДокументОснование
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ТЧДокумента КАК ТЧДокумента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РеализацияТоваровУслугУслуги.Номенклатура КАК Номенклатура,
		|	РеализацияТоваровУслугУслуги.СписокТД КАК СписокТД,
		|	РеализацияТоваровУслугУслуги.СтрокаДоходовСделки КАК СтрокаДоходовСделки,
		|	РеализацияТоваровУслугУслуги.СписокТЕ КАК СписокТЕ,
		|	ЗНАЧЕНИЕ(Документ.ТранспортныйДокумент.ПустаяСсылка) КАК Коносамент,
		|	РеализацияТоваровУслугУслуги.Ссылка.Контрагент КАК Клиент
		|ИЗ
		|	ВТ КАК ВТ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Услуги КАК РеализацияТоваровУслугУслуги
		|		ПО ВТ.ДокументОснование = РеализацияТоваровУслугУслуги.Ссылка";
		Запрос.УстановитьПараметр("ТЧДокумента",Объект.ДокументыОснования.Выгрузить());
		ВремТЧ = Запрос.Выполнить().Выгрузить();
	ИначеЕсли ЗначениеЗаполнено(СтруктураПоиска) Тогда
		ТЗ = Новый ТаблицаЗначений;
		ТЗ.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		КвалификаторыСтроки = Новый КвалификаторыСтроки(36);
		ТЗ.Колонки.Добавить("СтрокаДоходовСделки", Новый ОписаниеТипов("Строка",,,,КвалификаторыСтроки));
		ТЗ.Колонки.Добавить("СписокТД", Новый ОписаниеТипов("Строка"));
		ТЗ.Колонки.Добавить("СписокТЕ", Новый ОписаниеТипов("Строка"));
		ТЗ.Колонки.Добавить("Коносамент", Новый ОписаниеТипов("ДокументСсылка.ТранспортныйДокумент"));
		ТЗ.Колонки.Добавить("Клиент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
		новСтрока = ТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(новСтрока, СтруктураПоиска);
		ВремТЧ = ТЗ;
	КонецЕсли;
	
	
	// Основной запрос
	// 1. выбираем данные из ТЧ документа, который вызвал функцию (ВТ)
	// 2. если задано правило формирования даты услуги, то делаем выборку данных из документа транспортный
	//    документ. В зависимости от правила подставляются данные из разных реквизитов. У такого запроса приоритет 1 (ЗапросПоПравилу)
	// 3. объединением двух запросов выбираем данные 1) НЕ для вида услуги "Комплексные" 2) для вида услуг "комплексные" - для них нужно 
	//	  подсоединять документ Сделка и ПТУ для получения максимальной даты по всем ПТУ, у которых выставлен признак "Перевыставляемые" (ЗапросБезПравил)
	// 4. выводим итоговый результат. Соединяем полным соединением п.3 и п.4 по ГУИД. Выбираем те данные, у которых заполнен приоритет = 1. Если нет, то данные по
	//    приоритету 2. Упорядочиваем его по дате документа по убыванию и берем только первую строку (т.е. максимальную дату).
	Запрос = Новый Запрос;
	
	///// это для тестирования (вместо первой вирт табл в запросе). удалить после внедрения	
	//"ВЫБРАТЬ
	//					 |	РеализацияТоваровУслугУслуги.СписокТД КАК СписокТД,
	//					 |	РеализацияТоваровУслугУслуги.Номенклатура КАК Номенклатура,
	//					 |	РеализацияТоваровУслугУслуги.СтрокаДоходовСделки КАК ГУИД
	//					 |ПОМЕСТИТЬ ВТ
	//					 |ИЗ
	//					 |	Документ.РеализацияТоваровУслуг.Услуги КАК РеализацияТоваровУслугУслуги
	//					 |ГДЕ
	//					 |	РеализацияТоваровУслугУслуги.Ссылка = &Ссылка
	//					 |; 
	///////////////////// для тестирования
	//
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЧДокумента.СписокТД КАК СписокТД,
	|	ТЧДокумента.СписокТЕ КАК СписокКТК,
	|	ВЫРАЗИТЬ(ТЧДокумента.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ТЧДокумента.СтрокаДоходовСделки КАК ГУИД,
	|	ВЫРАЗИТЬ(ТЧДокумента.Коносамент КАК Документ.ТранспортныйДокумент) КАК Коносамент,
	|	ТЧДокумента.Клиент КАК Клиент
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&ТЧДокумента КАК ТЧДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ЕСТЬNULL(СделкаСвязьУчетныхЕдиниц.ЖДН.НакладнаяЭТРАН.ДатаИВремяРаскредитованияГруза, ДАТАВРЕМЯ(1, 1, 1))) КАК ЖД_Прибытие,
	|	МАКСИМУМ(ЕСТЬNULL(СделкаСвязьУчетныхЕдиниц.Коносамент.ДатаПрибытия, ДАТАВРЕМЯ(1, 1, 1))) КАК Море_Прибытие,
	|	МАКСИМУМ(ЕСТЬNULL(ЗаявкаСоставУслуги.ДатаПодачиАвтоПодВыгрузку, ДАТАВРЕМЯ(1, 1, 1))) КАК Авто_Прибытие,
	|	ВТ.ГУИД КАК ГУИД
	|ПОМЕСТИТЬ ВТ_Даты
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
	|			ПО СделкаСвязьУчетныхЕдиниц.Заявка = ЗаявкаСоставУслуги.Ссылка
	// Евросиб Фролов (26.12.2021 TASK №44663
	//|				И СделкаСвязьУчетныхЕдиниц.Контейнер = ЗаявкаСоставУслуги.НомерКТК
	|				И СделкаСвязьУчетныхЕдиниц.ГУИДСтрокиЗаявки = ЗаявкаСоставУслуги.ГУИДСтроки
	// Евросиб Фролов)		
	|		ПО (ВТ.СписокКТК ПОДОБНО ""%"" + СделкаСвязьУчетныхЕдиниц.Контейнер.Наименование + ""%"")
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &Сделка = НЕОПРЕДЕЛЕНО
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ СделкаСвязьУчетныхЕдиниц.Ссылка = &Сделка
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.ГУИД
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Даты.ЖД_Прибытие КАК ДатаПрибытия,
	|	ВТ_Даты.ГУИД КАК ГУИД
	|ПОМЕСТИТЬ Врем_ДатыПрибытия
	|ИЗ
	|	ВТ_Даты КАК ВТ_Даты
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_Даты.Море_Прибытие,
	|	ВТ_Даты.ГУИД
	|ИЗ
	|	ВТ_Даты КАК ВТ_Даты
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_Даты.Авто_Прибытие,
	|	ВТ_Даты.ГУИД
	|ИЗ
	|	ВТ_Даты КАК ВТ_Даты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Врем_ДатыПрибытия.ГУИД КАК ГУИД,
	|	МАКСИМУМ(Врем_ДатыПрибытия.ДатаПрибытия) КАК ДатаПрибытия
	|ПОМЕСТИТЬ ВТ_ДатыПрибытияИтог
	|ИЗ
	|	Врем_ДатыПрибытия КАК Врем_ДатыПрибытия
	|
	|СГРУППИРОВАТЬ ПО
	|	Врем_ДатыПрибытия.ГУИД
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА НЕ ВТ.Коносамент = ЗНАЧЕНИЕ(Документ.ТранспортныйДокумент.ПустаяСсылка)
	|			ТОГДА ВЫБОР
	|					КОГДА НЕ ЕСТЬNULL(ФормированиеФинДокументов.Ссылка, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО
	|						ТОГДА ВЫБОР
	|								КОГДА ФормированиеФинДокументов.ДатаРеализации = ЗНАЧЕНИЕ(Перечисление.ФрахтФинДокументы_ДатаРеализации.ДатаКоносамента)
	|									ТОГДА ВТ.Коносамент.ДатаТранспортногоДокумента
	|								КОГДА ФормированиеФинДокументов.ДатаРеализации = ЗНАЧЕНИЕ(Перечисление.ФрахтФинДокументы_ДатаРеализации.ДатаОтправленияЖД)
	|									ТОГДА ТранспортныйДокумент.ДатаОтправления
	|								КОГДА ФормированиеФинДокументов.ДатаРеализации = ЗНАЧЕНИЕ(Перечисление.ФрахтФинДокументы_ДатаРеализации.ДатаУходаСуднаКС)
	|									ТОГДА ВТ.Коносамент.ДатаОтправления
	|								КОГДА ФормированиеФинДокументов.ДатаРеализации = ЗНАЧЕНИЕ(Перечисление.ФрахтФинДокументы_ДатаРеализации.ДатаПрибытияЖД)
	|									ТОГДА ТранспортныйДокумент.НакладнаяЭТРАН.ДатаИВремяРаскредитованияГруза
	|								КОГДА ФормированиеФинДокументов.ДатаРеализации = ЗНАЧЕНИЕ(Перечисление.ФрахтФинДокументы_ДатаРеализации.ДатаПрибытияСуднаКС)
	|									ТОГДА ВТ.Коносамент.ДатаПрибытия
	|								КОГДА ФормированиеФинДокументов.ДатаРеализации = ЗНАЧЕНИЕ(Перечисление.ФрахтФинДокументы_ДатаРеализации.ДатаДоставкиГрузаИзСделки)
	|									ТОГДА ВТ_ДатыПрибытияИтог.ДатаПрибытия
	|							КОНЕЦ
	|				КОНЕЦ
	|		КОГДА &ПравилоФормированияДатыУслуги = ЗНАЧЕНИЕ(Перечисление.СпособыОпределенияДатыДокументаДляДоговора.ПоДатеРаскредитации)
	|			ТОГДА ТранспортныйДокумент.НакладнаяЭТРАН.ДатаИВремяРаскредитованияГруза
	|		КОГДА &ПравилоФормированияДатыУслуги = ЗНАЧЕНИЕ(Перечисление.СпособыОпределенияДатыДокументаДляДоговора.ПоДатеПрибытия)
	|			ТОГДА ВТ_ДатыПрибытияИтог.ДатаПрибытия
	|		ИНАЧЕ ТранспортныйДокумент.ДатаОтправления
	|	КОНЕЦ КАК ДатаДокумента,
	|	1 КАК Приоритет,
	|	ВТ.ГУИД КАК ГУИД,
	|	ЕСТЬNULL(ФормированиеФинДокументов.ДатаРеализации, НЕОПРЕДЕЛЕНО) КАК ДатаРеализации
	|ПОМЕСТИТЬ ЗапросПоПравилу
	|ИЗ
	|	ВТ КАК ВТ
	//		убрал внутреннее соединение, т.к. не всегда ей ждн в сделке
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	|		ПО (ВТ.СписокТД ПОДОБНО ""%"" + ТранспортныйДокумент.НомерТранспортногоДокумента + ""%"")
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДатыПрибытияИтог КАК ВТ_ДатыПрибытияИтог
	|		ПО ВТ.ГУИД = ВТ_ДатыПрибытияИтог.ГУИД
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФормированиеФинДокументов КАК ФормированиеФинДокументов
	|		ПО ВТ.Клиент = ФормированиеФинДокументов.Контрагент
	|			И (ФормированиеФинДокументов.ИспользоватьРасширенныеПараметры)
	|ГДЕ
	|	НЕ &ПравилоФормированияДатыУслуги = ЗНАЧЕНИЕ(Перечисление.СпособыОпределенияДатыДокументаДляДоговора.ПустаяСсылка)
	|	И НЕ &ПравилоФормированияДатыУслуги = ЗНАЧЕНИЕ(Перечисление.СпособыОпределенияДатыДокументаДляДоговора.ПоДатеОтправкиСудна)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ.Номенклатура,
	|	СделкаСвязьУчетныхЕдиниц.МорскойРейс.ДатаОтправления,
	|	1,
	|	ВТ.ГУИД,
	|	NULL
	|ИЗ
	|	ВТ КАК ВТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.ДоходыКТК КАК СделкаДоходыКТК
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|			ПО (СделкаДоходыКТК.КТК ПОДОБНО ""%"" + СделкаСвязьУчетныхЕдиниц.Контейнер.Наименование + ""%"")
	|		ПО ВТ.ГУИД = СделкаДоходыКТК.ГУИД
	|ГДЕ
	|	&ПравилоФормированияДатыУслуги = ЗНАЧЕНИЕ(Перечисление.СпособыОпределенияДатыДокументаДляДоговора.ПоДатеОтправкиСудна)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ВТ.Номенклатура.ВидУслуги = ЗНАЧЕНИЕ(Перечисление.ВидыУслуг.ПредоставлениеВагонов)
	|			ТОГДА ТранспортныйДокумент.ДатаТранспортногоДокумента
	|		КОГДА ВТ.Номенклатура.ВидУслуги = ЗНАЧЕНИЕ(Перечисление.ВидыУслуг.ТранспортноЭкспедиторские)
	|			ТОГДА ТранспортныйДокумент.НакладнаяЭТРАН.ДатаИВремяРаскредитованияГруза
	|		КОГДА ВТ.Номенклатура.ВидУслуги = ЗНАЧЕНИЕ(Перечисление.ВидыУслуг.АгентскиеУслуги)
	|				ИЛИ ВТ.Номенклатура.ВидУслуги = ЗНАЧЕНИЕ(Перечисление.ВидыУслуг.ТерминальнаяОбработкаГрузов)
	|			ТОГДА &ДатаДокумента
	|		КОГДА ВТ.Номенклатура.ВидУслуги = ЗНАЧЕНИЕ(Перечисление.ВидыУслуг.Аренда)
	|			ТОГДА КОНЕЦПЕРИОДА(&ДатаДокумента, МЕСЯЦ)
	|	КОНЕЦ КАК ДатаДокумента,
	|	2 КАК Приоритет,
	|	ВТ.ГУИД КАК ГУИД
	|ПОМЕСТИТЬ ЗапросБезПравил
	|ИЗ
	|	ВТ КАК ВТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	|		ПО (ВТ.СписокТД ПОДОБНО ""%"" + ТранспортныйДокумент.НомерТранспортногоДокумента + ""%"")
	|ГДЕ
	|	&ПравилоФормированияДатыУслуги = ЗНАЧЕНИЕ(Перечисление.СпособыОпределенияДатыДокументаДляДоговора.ПустаяСсылка)
	|	И НЕ ВТ.Номенклатура.ВидУслуги = ЗНАЧЕНИЕ(Перечисление.ВидыУслуг.Комплексные)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ.Номенклатура,
	|	МАКСИМУМ(ПоступлениеТоваровУслугУслуги.Ссылка.Дата),
	|	МАКСИМУМ(2),
	|	ВТ.ГУИД
	|ИЗ
	|	ВТ КАК ВТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьДоходовИРасходов КАК СделкаСвязьДоходовИРасходов
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.Услуги КАК ПоступлениеТоваровУслугУслуги
	|			ПО СделкаСвязьДоходовИРасходов.Расходы = ПоступлениеТоваровУслугУслуги.ГУИДПТУ
	|		ПО ВТ.ГУИД = СделкаСвязьДоходовИРасходов.Доходы
	|ГДЕ
	|	&ПравилоФормированияДатыУслуги = ЗНАЧЕНИЕ(Перечисление.СпособыОпределенияДатыДокументаДляДоговора.ПустаяСсылка)
	|	И ВТ.Номенклатура.ВидУслуги = ЗНАЧЕНИЕ(Перечисление.ВидыУслуг.Комплексные)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.Номенклатура,
	|	ВТ.ГУИД
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВЫБОР
	|		КОГДА НЕ ЕСТЬNULL(ЗапросПоПравилу.Приоритет, 0) = 0
	|			ТОГДА ЗапросПоПравилу.ДатаДокумента
	|		ИНАЧЕ ЗапросБезПравил.ДатаДокумента
	|	КОНЕЦ КАК ДатаДокумента
	|ИЗ
	|	ЗапросПоПравилу КАК ЗапросПоПравилу
	|		ПОЛНОЕ СОЕДИНЕНИЕ ЗапросБезПравил КАК ЗапросБезПравил
	|		ПО ЗапросПоПравилу.ГУИД = ЗапросБезПравил.ГУИД
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаДокумента УБЫВ";
	Запрос.УстановитьПараметр("ТЧДокумента",ВремТЧ);
	//Запрос.УстановитьПараметр("Ссылка",Объект.Ссылка);
	
	Запрос.УстановитьПараметр("ПравилоФормированияДатыУслуги",ПравилоФормированияДатыУслуги);
	Запрос.УстановитьПараметр("ДатаДокумента",Дата);
	Запрос.УстановитьПараметр("Сделка", ?(ТипЗнч(Объект) = Тип("ДокументСсылка.Сделка"), Объект, Неопределено));
	РЗ = Запрос.Выполнить();
	Если НЕ РЗ.Пустой() Тогда
		ДатаДок = РЗ.Выгрузить()[0].ДатаДокумента;
	КонецЕсли;
	
//Евросиб Гудкова( 14.10.2020 Ticket№ 0209986 определение для нерезидента
	Если НЕ Контрагент.СтранаРегистрации = Справочники.СтраныМира.Россия Тогда
	    ПереопределитьДатуДокументаНерезидента(ДатаДок, ДатаОткрытогоПериода, ДатаПаспортаСделки);
	КонецЕсли;	
// Евросиб Гудкова) 	
	
	Если НЕ ЗначениеЗаполнено(ДатаДок) Тогда
		Сообщить(СтрШаблон("%1пределить дату не удалось. Установлена текущая дата. Заполните условие формирования даты в карточке договора",
				?(ВыводитьНомерСтроки,"По строке "+СтруктураПоиска.НомерСтроки+" о", "О")));
		Возврат ТекущаяДата();
	КонецЕсли;
	
	// если установка даты идет не по правилу, то дальнейшую проверку не проводить
	Если НЕ ЗначениеЗаполнено(ПериодичностьВыставления) Тогда
		Возврат Макс(ДатаДок,ДатаОткрытогоПериода);
	КонецЕсли;
	
	// если правило по пятидневкам, по декадам, два раза в месяц, раз в месяц, то нужно обработать дату
	Если ПериодичностьВыставления = Перечисления.ПериодичностьВыставления.ПоПятидневке Тогда
		ДатаДок = ПересчетДаты(ДатаДок,5);
	ИначеЕсли ПериодичностьВыставления = Перечисления.ПериодичностьВыставления.ПоДекаде Тогда
		ДатаДок = ПересчетДаты(ДатаДок,10);
	ИначеЕсли ПериодичностьВыставления = Перечисления.ПериодичностьВыставления.ДваРазаВМесяц Тогда
		ДатаДок = ПересчетДаты(ДатаДок,15);
	ИначеЕсли ПериодичностьВыставления = Перечисления.ПериодичностьВыставления.РазВМесяц Тогда
		ДатаДок = ПересчетДаты(ДатаДок,31);
	КонецЕсли;
	
	Возврат Макс(ДатаДок, ДатаОткрытогоПериода);
	
КонецФункции	

Функция ПересчетДаты(ДатаДляПересчета,ДлинаИнтервала) Экспорт
	ДатаДок = ДатаДляПересчета;
	
	ПоследнийДеньМесяца = День(КонецМесяца(ДатаДляПересчета));
	
	// если дата для пересчета = последнему дню месяца, то ничего не считаем
	Если ПоследнийДеньМесяца = ДатаДляПересчета Тогда
		Возврат Дата(Год(ДатаДляПересчета),Месяц(ДатаДляПересчета),ДатаДок,0,0,0);
	КонецЕсли;
	
	// получим интервал, в котором находится наша дата и округлим в сторону бОльшего
	Интервал = Окр((День(ДатаДляПересчета)/ДлинаИнтервала)+0.5,0,0);          
	// надо получить последнюю дату найденного интервала
	ДатаКон = Интервал*ДлинаИнтервала;
	// для февраля и для месяцев с 31 днем делаем проверку
	Если ДатаКон>ПоследнийДеньМесяца ИЛИ ( ДатаКон = 30 И ПоследнийДеньМесяца = 31) Тогда
		ДатаДок = ПоследнийДеньМесяца;
	Иначе
		ДатаДок = ДатаКон;
	КонецЕсли;
	
	Возврат Дата(Год(ДатаДляПересчета),Месяц(ДатаДляПересчета),ДатаДок,0,0,0);
	
КонецФункции

Функция ПереопределитьДатуДокументаНерезидента(ДатаДок, ДатаОткрытогоПериода, ДатаПаспортаСделки, ПравилоОпределениеДаты = Неопределено) Экспорт
	Если ЗначениеЗаполнено(ДатаДок) и НачалоМесяца(ДатаДок)= НачалоМесяца(ТекущаяДата()) Тогда // siv 22-06-21
		ДатаДок = ТекущаяДата();
		Если НЕ ПравилоОпределениеДаты = Неопределено Тогда
			ПравилоОпределениеДаты = ПравилоОпределениеДаты + "; нерезидент; тек.дата";
		КонецЕсли; 
	Иначе 
		ДатаДок = КонецМесяца(ДатаОткрытогоПериода);
		Если НЕ ПравилоОпределениеДаты = Неопределено Тогда
			ПравилоОпределениеДаты = ПравилоОпределениеДаты + "; нерезидент; конец месяца открытого периода";
		КонецЕсли; 
	КонецЕсли; 
	Если ЗначениеЗаполнено(ДатаПаспортаСделки) и ДатаПаспортаСделки > ДатаДок Тогда  // siv 03-12-20
		ДатаДок = ДатаПаспортаСделки;
		Если НЕ ПравилоОпределениеДаты = Неопределено Тогда
			ПравилоОпределениеДаты = ПравилоОпределениеДаты + "; нерезидент; дата паспорта сделки";
		КонецЕсли; 
	КонецЕсли;
	Возврат ДатаДок;
КонецФункции
