Функция ПолучитьЗначениеКонстанты(ИмяКонстанты) Экспорт

	Возврат Константы[ИмяКонстанты].Получить();

КонецФункции // ПолучитьЗначениеКонстанты()

Функция ПолучитьЗначениеКонстантыСУчетомКонтекста(ИмяКонстанты) Экспорт
	
	УчетКонтекста = "";
	Если ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована Тогда
		УчетКонтекста = "Тестовый";
	КонецЕсли;                    
	ИмяКонстанты = ИмяКонстанты+УчетКонтекста;
	
	Возврат Константы[ИмяКонстанты].Получить();

КонецФункции // ПолучитьЗначениеКонстанты()
