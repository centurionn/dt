//ДИТ, Беляев СЮ, ТА 43624, 13-12-2021 ++
Функция ПолучитьСтрокуОписанияДиапазонов(ВыборкаДетальныеЗаписи, МаксимальноеЗначениеДиапазона)
	СтрокаОписанияДиапазонов = "";
	Если ВыборкаДетальныеЗаписи.Количество() = 1 Тогда               
		ВыборкаДетальныеЗаписи.Следующий();
		СтрокаОписанияДиапазонов = СокрЛП(ВыборкаДетальныеЗаписи.Стоимость);
	Иначе
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл  
			//СтрокаОписанияДиапазонов = СтрокаОписанияДиапазонов + "От " + СокрЛП(ВыборкаДетальныеЗаписи.От)
			//							+  " до " + СокрЛП(ВыборкаДетальныеЗаписи.До) + " - "
			//							+ СокрЛП(ВыборкаДетальныеЗаписи.Стоимость) + Символы.ПС;  
			//ДИТ, Беляев СЮ, ТА 43624, 13-12-2021 ++
			ЧастьСтроки_ДО = " до " + СокрЛП(ВыборкаДетальныеЗаписи.До);
			Если ВыборкаДетальныеЗаписи.До=0 ИЛИ ВыборкаДетальныеЗаписи.До>=МаксимальноеЗначениеДиапазона Тогда
				ЧастьСтроки_ДО = ""; //конец диапазона не указываем, если =0 или МаксимальноеЗначениеДиапазона
			КонецЕсли;  
			СтрокаОписанияДиапазонов = СтрокаОписанияДиапазонов + "От " + СокрЛП(ВыборкаДетальныеЗаписи.От)
			+ ЧастьСтроки_ДО + " - "
			+ СокрЛП(ВыборкаДетальныеЗаписи.Стоимость) + Символы.ПС;   
			//ДИТ, Беляев СЮ, ТА 43624, 13-12-2021 --
		КонецЦикла;	
	КонецЕсли;
	Возврат СтрокаОписанияДиапазонов;			
КонецФункции  
