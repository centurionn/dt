//ДИТ Беляев СЮ, TA 41046, 18-11-2021 ++
Функция ПолучитьРезультатЗапросаДиапазонаСНПизРегистра_ТекущиеДанныеСНП( вхКТК, вхДата )
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	стоки_КлиентскоеОперирование.КТК КАК КТК,
	               |	стоки_ТекущиеДанные_СНП.ГУИДЗаписи КАК ГУИДЗаписи,
	               |	стоки_ТекущиеДанные_СНП.От КАК От,
	               |	стоки_ТекущиеДанные_СНП.До КАК До,
	               |	стоки_ТекущиеДанные_СНП.Сумма КАК Сумма,
	               |	стоки_КлиентскоеОперирование.Период КАК Период
	               |ПОМЕСТИТЬ Т1
	               |ИЗ
	               |	РегистрСведений.стоки_КлиентскоеОперирование КАК стоки_КлиентскоеОперирование
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.стоки_ТекущиеДанные_СНП КАК стоки_ТекущиеДанные_СНП
	               |		ПО стоки_КлиентскоеОперирование.ГУИДЗаписи = стоки_ТекущиеДанные_СНП.ГУИДЗаписи
	               |ГДЕ
	               |	стоки_КлиентскоеОперирование.КТК = &КТК
	               |	И КОНЕЦПЕРИОДА(стоки_КлиентскоеОперирование.Период, ДЕНЬ) <= КОНЕЦПЕРИОДА(&Дата, ДЕНЬ)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Т1.От КАК От,
	               |	Т1.До КАК До,
	               |	Т1.Сумма КАК Стоимость
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		Т1.КТК КАК КТК,
	               |		МАКСИМУМ(Т1.Период) КАК Период
	               |	ИЗ
	               |		Т1 КАК Т1
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		Т1.КТК) КАК ВложенныйЗапрос
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Т1 КАК Т1
	               |		ПО ВложенныйЗапрос.Период = Т1.Период
	               |			И ВложенныйЗапрос.КТК = Т1.КТК";
	Запрос.УстановитьПараметр("КТК", вхКТК); 
	Запрос.УстановитьПараметр("Дата", вхДата);
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса;
КонецФункции 
