//ДИТ Беляев СЮ, TA 41046, 18-11-2021 ++
Функция ПолучитьГУИДСтрокиРелизаПоКТК(вхРелизСобственникаСсылка, вхКТК)
	Результат = "";
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	РелизСобственникаНоминации.ГУИДСтроки КАК ГУИДСтроки
		|ИЗ
		|	Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
		|ГДЕ
		|	РелизСобственникаНоминации.Ссылка = &Ссылка
		|	И РелизСобственникаНоминации.Контейнер = &Контейнер";
	
	Запрос.УстановитьПараметр("Контейнер", вхКТК);
	Запрос.УстановитьПараметр("Ссылка", вхРелизСобственникаСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Результат = ВыборкаДетальныеЗаписи.ГУИДСтроки;
	КонецЦикла;

	Возврат Результат;	
КонецФункции
