//ДИТ, Беляев СЮ, ТА 43624, 13-12-2021 ++
Функция ПолучитьСуммуСНП(ВыборкаДетальныеЗаписи, МаксимальноеЗначениеДиапазона, вхКоличествоДнейДляРасчета)    
	СуммаСНП = 0;
	ВсегоДнейПросрочкиРаспределить = вхКоличествоДнейДляРасчета;
	ВыборкаДетальныеЗаписи.Сбросить();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		НачалоДиапазона = Макс(ВыборкаДетальныеЗаписи.От, 1); //часто диапазон начинается с 0, что будет являтся не значащим днем и исказит расчет 
		//КонецДиапазона = Макс(ВыборкаДетальныеЗаписи.До-1,0);  //делаем "-1", т.к. у нас диапазон "до" и на всякий случай не меньше нуля
		//ДИТ, Беляев СЮ, ТА 43624, 13-12-2021 ++
		КонецДиапазона = Макс(ВыборкаДетальныеЗаписи.До, 0);
		Если КонецДиапазона = 0 Тогда
			КонецДиапазона = МаксимальноеЗначениеДиапазона;
		КонецЕсли;
		//ДИТ, Беляев СЮ, ТА 43624, 13-12-2021 --
		СтоимостьДиапазона = ВыборкаДетальныеЗаписи.Стоимость;
		Разница = КонецДиапазона - вхКоличествоДнейДляРасчета;
		Если Разница>=0 Тогда                                      
			СуммаТекущегоДиапазона = ВсегоДнейПросрочкиРаспределить*СтоимостьДиапазона;  
			СуммаСНП = СуммаСНП + СуммаТекущегоДиапазона;			
			Прервать;
		КонецЕсли;   
		
		КолВоДнейТекущегоДиапазона = КонецДиапазона - НачалоДиапазона + 1; //+1 день, т.к. включается день начала диапазона
		СуммаТекущегоДиапазона = КолВоДнейТекущегоДиапазона * СтоимостьДиапазона;
		СуммаСНП = СуммаСНП + СуммаТекущегоДиапазона;
		ВсегоДнейПросрочкиРаспределить = вхКоличествоДнейДляРасчета - КонецДиапазона; //отнимаем весь диапазон, независимо от его начального значения, например диапазон 0-20 или 5-20  		
	КонецЦикла;  
	Возврат СуммаСНП; 
КонецФункции     
//ДИТ, Беляев СЮ, ТА 43624, 13-12-2021 --