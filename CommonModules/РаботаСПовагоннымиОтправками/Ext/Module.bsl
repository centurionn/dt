				НСтр2.СтавкаНДС = Стр.СтавкаНДС;
				НСтр2.НДСВключенВСтоимость = Стр.СуммаВключаетНДС;
				НСтр2.ПериодВО = ГлобальныйОткрытыйПериод;
				НСтр2.Валюта = Стр.Валюта;
			
				НСтр2.СебестоимостьИтого = НСтр2.Количество * НСтр2.Себестоимость;
				НСтр2.ВознаграждениеИтого = НСтр2.Количество * НСтр2.Вознаграждение;
				НСтр2.СтавкаИтого = НСтр2.Количество * НСтр2.Ставка;
				НСтр2.СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(НСтр2.СтавкаИтого, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(НСтр2.СтавкаНДС), Истина, НСтр2.НДСВключенВСтоимость);
				НСтр2.СуммаИтого = НСтр2.СтавкаИтого + ?(НСтр2.НДСВключенВСтоимость, 0, НСтр2.СуммаНДС);
				
				Если Стр.ПосуточнаяОплата Тогда
					НСтр2.ДатаНачалаПериодаПовагонкиУчДок = Стр.НачалоПосуточногоДиапазона;
					НСтр2.ДатаОкончанияПериодаПовагонкиУчДок = Стр.ОкончаниеПосуточногоДиапазона;
				Иначе
					НСтр2.ДатаНачалаПериодаПовагонкиУчДок = Стр.ДатаНачалаПериодаПовагонкиУчДок;
					НСтр2.ДатаОкончанияПериодаПовагонкиУчДок = Стр.ДатаОкончанияПериодаПовагонкиУчДок;
				КонецЕсли;
				
				МассивИзмененныхДоходов.Добавить(НСтр2.ГУИД);
				
			КонецЕсли;
				
		КонецЕсли;
		
	КонецЦикла;
	// !!!!!!!!!!!!!!!!!!!!!! проверять на группировку направления нет необходимости, т.к. если группировка по периоду = 0,
	// то вагоны выставляются каждый отдельно	
	
	РасходнаяЧастьСделки(НоваяСделка,МассивИзмененныхДоходов,УслугаСНП,МассивГУИД_СНП,ГлобальныйОткрытыйПериод);
	
	
КонецПроцедуры

Процедура ЗаполнениеСНП(ТЗ,Стр,НоваяСделка,МоментСозданияСделки,УслугаСНП,ГлобальныйОткрытыйПериод,МассивГУИД_СНП)ЭКСПОРТ
	// СНП есть всегда, кроме способа расчета ПОСУТОЧНО
	Если НЕ Стр.ЗаявкаПСЦ.ОплатаПользованияВагоном = Перечисления.ВариантыОплатыПользованияВагоном.Посуточно Тогда
		// проверка, есть ли в данной отправке СНП. Для каждого СНП ОТДЕЛЬНАЯ СТРОКА!!!
		// 1. СНП ПОГРУЗКИ
		Если Стр.ДоговорРазделятьСчетаЗаОсновнуюУслугуИСчетаЗаСНП И 
			Стр.СНППогрузки >0 И
			НЕ Стр.ЗаявкаПСЦ.ОплатаПользованияВагоном = Перечисления.ВариантыОплатыПользованияВагоном.ОбщаяПоКоличествуДнейИСНП И
			НЕ МоментСозданияСделки = 4 Тогда
			
			НСтр = НоваяСделка.Доходы.Добавить();
			//ДИТ, Беляев СЮ, ТА48688, 28-03-2022, начало 
			НСтр.ДатаПоявленияСтрокиЭкономики = ТекущаяДата();
			//ДИТ, Беляев СЮ, ТА48688, 28-03-2022, конец
			НСтр.Услуга = УслугаСНП;
			НСтр.Перевыставляемая = УслугаСНП.Перевыставляемая;
			НСтр.Калькуляция = Стр.Калькуляция;
			НСтр.Клиент = Стр.Клиент;
			НСтр.Договор = Стр.Договор;
			НСтр.ГУИД = Строка(Новый УникальныйИдентификатор);
			
			НСтрДоходыВаг = НоваяСделка.ДоходыВагоны.Добавить();
			НСтрДоходыВаг.ГУИД = НСтр.ГУИД;
			НСтрДоходыВаг.Вагон = Стр.Вагон.Наименование;
			
			НСтр.ТипВагонов = Стр.ТипВагонов;
			НСтр.Груз = Стр.Груз;
			НСтр.Комментарий = "СНП погрузки";
			// получаем целые сутки СНП
			Если НЕ СтрНайти(Строка(Стр.СНППогрузки),",") = 0 Тогда
				ДнейСНП = Цел(Стр.СНППогрузки) + 1;
			Иначе
				ДнейСНП = Стр.СНППогрузки;
			КонецЕсли;
			
			НСтр.Себестоимость = Стр.СНППогрузкиРуб*ДнейСНП;
			НСтр.Вознаграждение = 0;
			НСтр.Ставка = Стр.СНППогрузкиРуб*ДнейСНП;
			НСтр.Количество = Стр.Количество;
			НСтр.СтавкаНДС = Стр.СтавкаНДС;
			НСтр.НДСВключенВСтоимость = Стр.СуммаВключаетНДС;
			НСтр.ПериодВО = ГлобальныйОткрытыйПериод;
			НСтр.Валюта = Стр.Валюта;
			
			НСтр.СебестоимостьИтого = НСтр.Количество * НСтр.Себестоимость;
			НСтр.ВознаграждениеИтого = НСтр.Количество * НСтр.Вознаграждение;
			НСтр.СтавкаИтого = НСтр.Количество * НСтр.Ставка;
			НСтр.СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(НСтр.СтавкаИтого, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(НСтр.СтавкаНДС), Истина, НСтр.НДСВключенВСтоимость);
			НСтр.СуммаИтого = НСтр.СтавкаИтого + ?(НСтр.НДСВключенВСтоимость, 0, НСтр.СуммаНДС);
			
			МассивГУИД_СНП.Добавить(НСтр.ГУИД);
			
			// не добавляем этот ГУИД в массив, т.к. для строк СНП отдельная строка расходов
			//МассивИзмененныхДоходов.Добавить(НСтр.ГУИД);
		КонецЕсли;
		// 2. СНП ВЫГРУЗКИ
		Если Стр.ДоговорРазделятьСчетаЗаОсновнуюУслугуИСчетаЗаСНП И 
			Стр.СНПВыгрузки >0 И
			НЕ Стр.ЗаявкаПСЦ.ОплатаПользованияВагоном = Перечисления.ВариантыОплатыПользованияВагоном.ОбщаяПоКоличествуДнейИСНП Тогда
			
			// проверим, что по данному вагону СНП выгрузки еще не вносилось
			ПараметрыОтбора = Новый СТруктура;
			ПараметрыОтбора.Вставить("Вагон",Стр.Вагон);
			ПараметрыОтбора.Вставить("Услуга",УслугаСНП);
			ПараметрыОтбора.Вставить("Комментарий","СНП выгрузки");
			НайденныеСтроки = ТЗ.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() = 0 Тогда
			
				НСтр = НоваяСделка.Доходы.Добавить();
				//ДИТ, Беляев СЮ, ТА48688, 28-03-2022, начало 
				НСтр.ДатаПоявленияСтрокиЭкономики = ТекущаяДата();
				//ДИТ, Беляев СЮ, ТА48688, 28-03-2022, конец
				НСтр.Услуга = УслугаСНП;
				НСтр.Перевыставляемая = УслугаСНП.Перевыставляемая;
				НСтр.Калькуляция = Стр.Калькуляция;
				НСтр.Клиент = Стр.Клиент;
				НСтр.Договор = Стр.Договор;
				НСтр.ГУИД = Строка(Новый УникальныйИдентификатор);
				
				НСтрДоходыВаг = НоваяСделка.ДоходыВагоны.Добавить();
				НСтрДоходыВаг.ГУИД = НСтр.ГУИД;
				НСтрДоходыВаг.Вагон = Стр.Вагон.Наименование;
				
				НСтр.ТипВагонов = Стр.ТипВагонов;
				НСтр.Груз = Стр.Груз;
				НСтр.Комментарий = "СНП выгрузки";
				// получаем целые сутки СНП
				Если НЕ СтрНайти(Строка(Стр.СНПВыгрузки),",") = 0 Тогда
					ДнейСНП = Цел(Стр.СНПВыгрузки) + 1;
				Иначе
					ДнейСНП = Стр.СНПВыгрузки;
				КонецЕсли;
				
				НСтр.Себестоимость = Стр.СНПВыгрузкиРуб*ДнейСНП;
				НСтр.Вознаграждение = 0;
				НСтр.Ставка = Стр.СНПВыгрузкиРуб*ДнейСНП;
				НСтр.Количество = Стр.Количество;
				НСтр.СтавкаНДС = Стр.СтавкаНДС;
				НСтр.НДСВключенВСтоимость = Стр.СуммаВключаетНДС;
				НСтр.ПериодВО = ГлобальныйОткрытыйПериод;
				НСтр.Валюта = Стр.Валюта;
				
				НСтр.СебестоимостьИтого = НСтр.Количество * НСтр.Себестоимость;
				НСтр.ВознаграждениеИтого = НСтр.Количество * НСтр.Вознаграждение;
				НСтр.СтавкаИтого = НСтр.Количество * НСтр.Ставка;
				НСтр.СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(НСтр.СтавкаИтого, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(НСтр.СтавкаНДС), Истина, НСтр.НДСВключенВСтоимость);
				НСтр.СуммаИтого = НСтр.СтавкаИтого + ?(НСтр.НДСВключенВСтоимость, 0, НСтр.СуммаНДС);
				
				МассивГУИД_СНП.Добавить(НСтр.ГУИД);
				
			КонецЕсли;
		КонецЕсли;
		// 3. СНП ПЕРЕВОЗКИ
		Если Стр.ДоговорРазделятьСчетаЗаОсновнуюУслугуИСчетаЗаСНП И Стр.СНПСледования >0 Тогда
			// проверим, что по данному вагону СНП следования еще не вносилось
			ПараметрыОтбора = Новый СТруктура;
			ПараметрыОтбора.Вставить("Вагон",Стр.Вагон);
			ПараметрыОтбора.Вставить("Услуга",УслугаСНП);
			ПараметрыОтбора.Вставить("Комментарий","СНП следования");
			НайденныеСтроки = ТЗ.НайтиСтроки(ПараметрыОтбора);
				
			Если НайденныеСтроки.Количество() = 0 Тогда
				НСтр = НоваяСделка.Доходы.Добавить();
				//ДИТ, Беляев СЮ, ТА48688, 28-03-2022, начало 
				НСтр.ДатаПоявленияСтрокиЭкономики = ТекущаяДата();
				//ДИТ, Беляев СЮ, ТА48688, 28-03-2022, конец
				НСтр.Услуга = УслугаСНП;
				НСтр.Перевыставляемая = УслугаСНП.Перевыставляемая;
				НСтр.Калькуляция = Стр.Калькуляция;
				НСтр.Клиент = Стр.Клиент;
				НСтр.Договор = Стр.Договор;
				НСтр.ГУИД = Строка(Новый УникальныйИдентификатор);
				
				НСтрДоходыВаг = НоваяСделка.ДоходыВагоны.Добавить();
				НСтрДоходыВаг.ГУИД = НСтр.ГУИД;
				НСтрДоходыВаг.Вагон = Стр.Вагон.Наименование;
				
				НСтр.ТипВагонов = Стр.ТипВагонов;
				НСтр.Груз = Стр.Груз;
				НСтр.Комментарий = "СНП следования";
				// получаем целые сутки СНП
				Если НЕ СтрНайти(Строка(Стр.СНПСледования),",") = 0 Тогда
					ДнейСНП = Цел(Стр.СНПСледования) + 1;
				Иначе
					ДнейСНП = Стр.СНПСледования;
				КонецЕсли;
				
				НСтр.Себестоимость = Стр.СНПСледованияРуб*ДнейСНП;
				НСтр.Вознаграждение = 0;
				НСтр.Ставка = Стр.СНПСледованияРуб*ДнейСНП;
				НСтр.Количество = Стр.Количество;
				НСтр.СтавкаНДС = Стр.СтавкаНДС;
				НСтр.НДСВключенВСтоимость = Стр.СуммаВключаетНДС;
				НСтр.ПериодВО = ГлобальныйОткрытыйПериод;
				НСтр.Валюта = Стр.Валюта;
				
				НСтр.СебестоимостьИтого = НСтр.Количество * НСтр.Себестоимость;
				НСтр.ВознаграждениеИтого = НСтр.Количество * НСтр.Вознаграждение;
				НСтр.СтавкаИтого = НСтр.Количество * НСтр.Ставка;
				НСтр.СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(НСтр.СтавкаИтого, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(НСтр.СтавкаНДС), Истина, НСтр.НДСВключенВСтоимость);
				НСтр.СуммаИтого = НСтр.СтавкаИтого + ?(НСтр.НДСВключенВСтоимость, 0, НСтр.СуммаНДС);
				
				МассивГУИД_СНП.Добавить(НСтр.ГУИД);
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

Процедура РасходнаяЧастьСделки(НоваяСделка,МассивИзмененныхДоходов,УслугаСНП,МассивГУИД_СНП,ГлобальныйОткрытыйПериод)
	
	//////////////// ЗАПРОС ДЛЯ РАСХОДОВ ////////////////
	// обновляем расходную часть только у тех доходов, которые были изменены!!!!!!!!!!!!!
	// нужно очистить таблицу расходов от старых записей (от тех, где изменены доходы).
	Для Каждого Стр Из НоваяСделка.СвязьДоходовИРасходов Цикл
		Если НЕ МассивИзмененныхДоходов.Найти(Стр.Доходы) = Неопределено Тогда
			ПараметрыОтбора = Новый Структура;
			ПараметрыОТбора.Вставить("ГУИД",Стр.Расходы);
			НайденныеРасх = НоваяСделка.Расходы.НайтиСтроки(ПараметрыОТбора);
			Для Каждого НС Из НайденныеРасх Цикл
				НоваяСделка.Расходы.Удалить(НС);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	// Строки доходов, у которых услуга - СНП полностью копируются в расходы и в запросе не участвуют
	// сначала добавляем СНП
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Услуга", УслугаСНП);
	НайденныеСтроки = НоваяСделка.Доходы.НайтиСтроки(ПараметрыОтбора);
	
	Для Каждого Стр Из НайденныеСтроки Цикл
		
		// в расходы добавляем только новые строки доходов
		Если МассивГУИД_СНП.Найти(Стр.ГУИД) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НСтр2 = НоваяСделка.Расходы.Добавить();
		ЗаполнитьЗначенияСвойств(НСтр2,Стр);
		НСтр2.ГУИД = Строка(Новый УникальныйИдентификатор);
		НСтр2.ПериодВО = ГлобальныйОткрытыйПериод;
		НСтр2.Регламентный = Истина;
		
		НСтр5 = НоваяСделка.СвязьДоходовИРасходов.Добавить();
		НСтр5.Доходы = Стр.ГУИД;
		НСтр5.Расходы = НСтр2.ГУИД;
		
		// ищем по ГУИДу в тч ДоходыВагоны доходный вагон и создаем такой же расходный
		ПараметрыОтбора2 = Новый Структура;
		ПараметрыОтбора2.Вставить("ГУИД",Стр.ГУИД);
		НайденныеСтроки2 = НоваяСделка.ДоходыВагоны.НайтиСтроки(ПараметрыОтбора2);
		Если НайденныеСтроки2.Количество()>0 Тогда
			НСтр6 = НоваяСделка.ДоходыВагоны.Добавить();
			НСтр6.ГУИД = НСтр2.ГУИД;
			НСтр6.Вагон = НайденныеСтроки2[0].Вагон;
		КонецЕсли;
			
		МассивГУИД_СНП.Добавить(Стр.ГУИД);
		
		// по СНП тоже нужно удалить измененные строки
		НайденныеРасх = НоваяСделка.Расходы.НайтиСтроки(ПараметрыОтбора2);
		Для Каждого НС Из НайденныеРасх Цикл
			НоваяСделка.Расходы.Удалить(НС);
		КонецЦикла;
		
	КонецЦикла;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВыгрТЧ.Калькуляция КАК Калькуляция,
	               |	ВыгрТЧ.Количество КАК Количество,
	               |	ВыгрТЧ.РазмерКТК КАК РазмерКТК,
	               |	ВыгрТЧ.Подсыл КАК Подсыл,
	               |	ВыгрТЧ.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	               |	ВыгрТЧ.Груз КАК Груз,
	               |	ВыгрТЧ.ГУИД КАК ГУИД
	               |ПОМЕСТИТЬ ВТ
	               |ИЗ
	               |	&ВыгрТЧ КАК ВыгрТЧ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.ВыставляемаяУслуга КАК ВыставляемаяУслуга,
	               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Услуга КАК Услуга,
	               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Поставщик КАК Поставщик,
	               |	ВТ.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Договор КАК Договор,
	               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.СтавкаНДС КАК СтавкаНДС,
	               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.НДСВключенВСтоимость КАК НДСВключенВСтоимость,
	               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка КАК Калькуляция,
	               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Цена20 КАК Цена20,
	               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Цена40 КАК Цена40,
	               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.СуммаВознаграждения20 КАК СуммаВознаграждения20,
	               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.СуммаВознаграждения40 КАК СуммаВознаграждения40,
	               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Итого20 КАК Итого20,
	               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Итого40 КАК Итого40,
	               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Валюта КАК Валюта,
	               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.ВнутренняяСебестоимость КАК ВнутренняяСебестоимость,
	               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка.море20_Контрагент КАК море20_Контрагент,
	               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка.море20_Себестоимость КАК море20_Себестоимость,
	               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка.море40_Контрагент КАК море40_Контрагент,
	               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка.море40_Себестоимость КАК море40_Себестоимость,
	               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка.ММ_ВалютаФрахтовыхСтавок КАК ММ_ВалютаФрахтовыхСтавок,
	               |	ВТ.Количество КАК Количество,
	               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Услуга.Перевыставляемая КАК Перевыставляемая,
	               |	ВЫБОР
	               |		КОГДА ВТ.РазмерКТК = ЗНАЧЕНИЕ(Справочник.РазмерыКТК.К20)
	               |			ТОГДА КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Цена20
	               |		ИНАЧЕ КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Цена40
	               |	КОНЕЦ КАК Себестоимость,
	               |	ВЫБОР
	               |		КОГДА ВТ.РазмерКТК = ЗНАЧЕНИЕ(Справочник.РазмерыКТК.К20)
	               |			ТОГДА КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.СуммаВознаграждения20
	               |		ИНАЧЕ КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.СуммаВознаграждения40
	               |	КОНЕЦ * ВТ.Количество КАК ВознаграждениеИтого,
	               |	ВТ.Груз КАК Груз,
	               |	ВТ.Подсыл КАК Подсыл,
	               |	ВТ.ГУИД КАК ГУИДДоход,
	               |	ВТ.РазмерКТК КАК РазмерКТК
	               |ИЗ
	               |	ВТ КАК ВТ
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Калькуляция.ММ_КалькуляцияМультимодальнойЦепочки КАК КалькуляцияММ_КалькуляцияМультимодальнойЦепочки
	               |		ПО ВТ.Калькуляция = КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка
	               |ГДЕ
	               |	ВТ.ГУИД В (&СписокГУИД)
	               |ИТОГИ ПО
	               |	ГУИДДоход";
	
	ВыгрТЧДоходы = НоваяСделка.Доходы.Выгрузить();
	
	Запрос.УстановитьПараметр("ВыгрТЧ", ВыгрТЧДоходы);
	//Запрос.УстановитьПараметр("СписокГУИД",МассивГУИД_СНП);
	Запрос.УстановитьПараметр("СписокГУИД",МассивИзмененныхДоходов);
	
	РЗ = Запрос.Выполнить();
	ОтветГУИДДоход = РЗ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	// потом расходы 1.3

	Пока ОтветГУИДДоход.Следующий() Цикл
		
		ВыборкаДетальныеЗаписи = ОтветГУИДДоход.Выбрать();
		
		// чтобы фрахт не добавлялся несколько раз, добавим признак, что он уже добавлен в рамках данного цикла
		ФрахтДобавлен = Ложь;
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			//Если Не ВыборкаДетальныеЗаписи.Подсыл Тогда
			//	Продолжить;
			//КонецЕсли; 
			НСтр2 = НоваяСделка.Расходы.Добавить();
			ЗаполнитьЗначенияСвойств(НСтр2,ВыборкаДетальныеЗаписи);
			НСтр2.ГУИД = Строка(Новый УникальныйИдентификатор);
			НСтр2.ПериодВО = ГлобальныйОткрытыйПериод;
			НСтр2.Регламентный = Истина;
			НСТр2.НоменклатурнаяГруппа = ВыборкаДетальныеЗаписи.НоменклатурнаяГруппа;
			
			НСтр2.СебестоимостьИтого = НСтр2.Количество * НСтр2.Себестоимость;
			////НСтр2.ВознаграждениеИтого = НСтр2.Калькуляция.море20_Вознаграждение * НСтр2.Количество;
			//СтавкаИтого = НСтр2.Количество * НСтр2.Ставка;
			//НСтр2.СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(СтавкаИтого, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(НСтр2.СтавкаНДС), Истина, НСтр2.НДСВключенВСтоимость);
			//НСтр2.СуммаИтого = СтавкаИтого + ?(НСтр2.НДСВключенВСтоимость, 0, НСтр2.СуммаНДС);
			
			
			НСтр5 = НоваяСделка.СвязьДоходовИРасходов.Добавить();
			НСтр5.Доходы = ВыборкаДетальныеЗаписи.ГУИДДоход;
			НСтр5.Расходы = НСтр2.ГУИД;
			
			// ищем по ГУИДу в тч ДоходыВагоны доходный вагон и создаем такой же расходный
			ПараметрыОтбора2 = Новый Структура;
			ПараметрыОтбора2.Вставить("ГУИД",ВыборкаДетальныеЗаписи.ГУИДДоход);
			НайденныеСтроки2 = НоваяСделка.ДоходыВагоны.НайтиСтроки(ПараметрыОтбора2);
			Если НайденныеСтроки2.Количество()>0 Тогда
				НСтр6 = НоваяСделка.ДоходыВагоны.Добавить();
				НСтр6.ГУИД = НСтр2.ГУИД;
				НСтр6.Вагон = НайденныеСтроки2[0].Вагон;
			КонецЕсли;
			
			// теперь расходы фрахт
			Если ФрахтДобавлен = Ложь И 
							((ВыборкаДетальныеЗаписи.РазмерКТК = Справочники.РазмерыКТК.К20 
											И ВыборкаДетальныеЗаписи.море20_Себестоимость > 0) 
							ИЛИ (ВыборкаДетальныеЗаписи.РазмерКТК <> Справочники.РазмерыКТК.К20 
											И ВыборкаДетальныеЗаписи.море40_Себестоимость > 0)) Тогда
				
				НСтр3 = НоваяСделка.Расходы.Добавить();
				НСтр3.Регламентный = Истина;
				НСтр3.ГУИД = Строка(Новый УникальныйИдентификатор);
				НСтр3.Поставщик = ?(ВыборкаДетальныеЗаписи.РазмерКТК = Справочники.РазмерыКТК.К20, ВыборкаДетальныеЗаписи.Калькуляция.море20_Контрагент, ВыборкаДетальныеЗаписи.Калькуляция.море40_Контрагент);
				УслугаФрахта = Константы.УслугаФрахтаДляКалькуляции.Получить();
				НСтр3.Услуга = УслугаФрахта;
				НСтр3.Перевыставляемая = НСтр3.Услуга.Перевыставляемая;
				НСтр3.Калькуляция = ВыборкаДетальныеЗаписи.Калькуляция;
				НСтр3.Себестоимость = ?(ВыборкаДетальныеЗаписи.РазмерКТК = Справочники.РазмерыКТК.К20, ВыборкаДетальныеЗаписи.Калькуляция.море20_Себестоимость, ВыборкаДетальныеЗаписи.Калькуляция.море40_Себестоимость);
				НСтр3.ВознаграждениеИтого = ВыборкаДетальныеЗаписи.Калькуляция.море20_Вознаграждение * ВыборкаДетальныеЗаписи.Количество;
				НСтр3.Количество = ВыборкаДетальныеЗаписи.Количество;
				НСтр3.Груз = ВыборкаДетальныеЗаписи.Груз;
				НСтр3.СписокКТК = ВыборкаДетальныеЗаписи.СписокКТК;
				НСтр3.ПериодВО = ГлобальныйОткрытыйПериод;
				НСтр3.Валюта = ВыборкаДетальныеЗаписи.ММ_ВалютаФрахтовыхСтавок;
				
				
				НСтр3.СебестоимостьИтого = НСтр3.Количество * НСтр3.Себестоимость;
				//НСтр3.ВознаграждениеИтого = НСтр3.Количество * НСтр3.Вознаграждение;
				//СтавкаИтого = НСтр3.Количество * НСтр3.Ставка;
				//НСтр3.СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(СтавкаИтого, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(НСтр3.СтавкаНДС), Истина, НСтр3.НДСВключенВСтоимость);
				//НСтр3.СуммаИтого = СтавкаИтого + ?(НСтр3.НДСВключенВСтоимость, 0, НСтр3.СуммаНДС);
				
				НСтр4 = НоваяСделка.СвязьДоходовИРасходов.Добавить();
				НСтр4.Доходы = ВыборкаДетальныеЗаписи.ГУИДДоход;
				НСтр4.Расходы = НСтр3.ГУИД;
				
				// ищем по ГУИДу в тч ДоходыВагоны доходный вагон и создаем такой же расходный
				ПараметрыОтбора2 = Новый Структура;
				ПараметрыОтбора2.Вставить("ГУИД",ВыборкаДетальныеЗаписи.ГУИДДоход);
				НайденныеСтроки2 = НоваяСделка.ДоходыВагоны.НайтиСтроки(ПараметрыОтбора2);
				Если НайденныеСтроки2.Количество()>0 Тогда
					НСтр6 = НоваяСделка.ДоходыВагоны.Добавить();
					НСтр6.ГУИД = НСтр3.ГУИД;
					НСтр6.Вагон = НайденныеСтроки2[0].Вагон;
				КонецЕсли;
				
				ФрахтДобавлен = Истина;
				
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Процедура ДополнитьТаблицуИнтерваламиДат(НоваяСделка,ТЗ,ИнтервалСделки,МоментСозданияСделки) ЭКСПОРТ
	
	// т.к. квант времени реализации не может быть больше сделки и реализации создаются только в рамках одной сделки,
	// то начальной датой для расчета диапазонов является ДатаНачалаПериодаПовагонки сделки.
	// в том случае, если для вагона есть выставленные документы, то НачальнаяДатаДиапазонов будет равна
	// окончанию преиода выставленного документа (его строки по вагону)
	НачальнаяДатаДиапазонов = НачалоДня(НоваяСделка.Ссылка.ДатаНачалаПериодаПовагонки);
	
	ТЗ_Копия = ТЗ.СкопироватьКолонки();
	
	Для Каждого Стр ИЗ ТЗ Цикл
		
		ВыставлениеВагоновПоПериоду = Стр.ДоговорВыставлениеВагоновПоПериоду;
		ИнтервалКомплДок = ?(ВыставлениеВагоновПоПериоду>ИнтервалСделки ИЛИ Не ЗначениеЗаполнено(ВыставлениеВагоновПоПериоду),ИнтервалСделки,ВыставлениеВагоновПоПериоду);
		// т.к. вагоны могут быть рассчитаны посуточно, то нужно разбить посуточный 
		// вагон на периоды сделки и добавить нужное количество строк
		Если Стр.ПосуточнаяОплата Тогда
			// если идет обновление таблицы из формы сделки, то проверять на выставленные дни не нужно,
			// т.к. все таблицы сделки очищаются.
			// проверяем, есть ли уже выставленные дни
			Если НЕ МоментСозданияСделки = Неопределено И ЗначениеЗаполнено(Стр.КоличествоДнейОборот) И
				Стр.КоличествоДнейОборот>0 Тогда
				// если да, то проверить, какой промежуток времени они покрывают. если есть РТУ, 
				// которые уже выставлены, то считать промежуток от них
				ВыставленоДоДаты = Стр.ДатаОтправки + Стр.КоличествоДнейОборот*3600*24;
				Если ЗначениеЗаполнено(Стр.ДатаВыставленногоРТУ) Тогда
					НачальнаяДатаДиапазонов = Стр.ДатаВыставленногоРТУ + 1;
				КонецЕсли;
			Иначе
				ВыставленоДоДаты = Стр.ДатаОтправки;
			КонецЕсли;
			// надо проверить по квантам сделки, 
			// есть ли возможность записать вагон в сделку так, чтобы ее даты начала и окончания повагонки 
			// покрывали период от ВыставленоДоДаты до ДатаОкончанияПериодаПовагонки.
			// ВагонВПути здесь всегда Ложь, т.к. реализации нужно выставлять до конца периода повагонки сделки
			СтруктураОтвета = ПолучитьДиапазоныДатПоСделкам(ВыставленоДоДаты,КонецДня(Стр.ДатаОкончанияПериодаПовагонки),ИнтервалКомплДок,НачальнаяДатаДиапазонов,Ложь);
			
			// по количеству элементов массива добавляем во временную таблицу строки для вагона
			Для Каждого Эл Из СтруктураОтвета Цикл
				НовСтр = ТЗ_Копия.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр,Стр);
				НовСтр.НачалоПосуточногоДиапазона = Эл.ДатаНач;
				НовСтр.ОкончаниеПосуточногоДиапазона = Эл.ДатаКон;
				НовСтр.Изменена = Истина;
			КонецЦикла;
				
		КонецЕсли;
			
	КонецЦикла;
	
	// вносим все данные из ТЗ_Копия в основную ТЗ, при этом первую строку таблицы нужно не добавить, а
	// изменить ею существующую
	Для Каждого Стр Из ТЗ_Копия Цикл
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Вагон",Стр.Вагон);
		ПараметрыОтбора.Вставить("ДатаОтправки",Стр.ДатаОтправки);
		ПараметрыОтбора.Вставить("Изменена",Ложь);
		НайденныеСтр = ТЗ.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтр.Количество()>0 Тогда
			НайденныеСтр[0].НачалоПосуточногоДиапазона = Стр.НачалоПосуточногоДиапазона;
			НайденныеСтр[0].ОкончаниеПосуточногоДиапазона = Стр.ОкончаниеПосуточногоДиапазона;
			НайденныеСтр[0].Изменена = Истина;
		Иначе
			НовСтр = ТЗ.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр,Стр);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура РеализацииВЭкономике(НоваяСделка,ТЗ) ЭКСПОРТ
	Для каждого Стр Из ТЗ Цикл
		// интересуют уже распределенные вагоны, у которых есть реализации
		Если НЕ ЗначениеЗаполнено(Стр.РаспределенныеВагоны) Тогда
			Продолжить;
		КонецЕсли;
		
		Стр.УчДокумент = НайтиРеализацию(НоваяСделка.Ссылка, Стр.ГУИД);
		Стр.УчДокумент = НайтиОтчет(НоваяСделка.Ссылка, Стр.ГУИД);
		Если НЕ Стр.УчДокумент = Неопределено Тогда
			Стр.Выставлен = Стр.УчДокумент.Выставлен;	
			Стр.ДатаНачалаПериодаПовагонкиУчДок = Стр.УчДокумент.ДатаНачалаПериодаПовагонки;	
			Стр.ДатаОкончанияПериодаПовагонкиУчДок = Стр.УчДокумент.ДатаОкончанияПериодаПовагонки;
			Стр.НетУчДокумента = Ложь;
			// заполним направление маршрута, если у всего уч документа одинаковые станция отправления и назначения
			СтруктураОтвета = ПроверкаНаправления(Стр.УчДокумент);
			Если СтруктураОтвета.Свойство("Отправление") Тогда
				Стр.ОтправлениеУчДокумента = СтруктураОтвета.Отправление;
				Стр.НазначениеУчДокумента = СтруктураОтвета.Назначение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ЗапросЭкономики(НоваяСделка) ЭКСПОРТ

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СделкаСвязьУчетныхЕдиниц.Груз КАК Груз,
	               |	СделкаСвязьУчетныхЕдиниц.Калькуляция КАК Калькуляция,
	               |	СделкаСвязьУчетныхЕдиниц.РазмерКТК КАК РазмерКТК,
	               |	СделкаСвязьУчетныхЕдиниц.Клиент КАК Клиент,
	               |	СделкаСвязьУчетныхЕдиниц.Договор КАК Договор,
