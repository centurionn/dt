КонецПроцедуры

Функция СоздатьКвантВремениРеализации(ДатаОтправления,КвантВремени,ТЗВспомогательная) ЭКСПОРТ
	
	ДатаНачалаПериодаПовагонкиУчДок = ДатаОтправления;
	ДатаОкончанияПериодаПовагонкиУчДок = ДатаОтправления + КвантВремени*3600;
	
	// поиск кванта времени
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВремТЧ.ДатаНачалаПериодаПовагонкиУчДок КАК ДатаНачалаПериодаПовагонки,
	               |	ВремТЧ.ДатаОкончанияПериодаПовагонкиУчДок КАК ДатаОкончанияПериодаПовагонки
	               |ПОМЕСТИТЬ ВТ
	               |ИЗ
	               |	&ВремТЧ КАК ВремТЧ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ВТ.ДатаОкончанияПериодаПовагонки КАК ДатаОкончанияПериодаПовагонки
	               |ИЗ
	               |	ВТ КАК ВТ
	               |ГДЕ
	               |	НЕ ВТ.ДатаОкончанияПериодаПовагонки = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |	И НЕ ВТ.ДатаНачалаПериодаПовагонки = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |	И ВТ.ДатаОкончанияПериодаПовагонки < &ТекДатаОтпр
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаОкончанияПериодаПовагонки УБЫВ";
	Запрос.УстановитьПараметр("ВремТЧ",ТЗВспомогательная);
	Запрос.УстановитьПараметр("ТекДатаОтпр",ДатаОтправления);
	РЗ = Запрос.Выполнить();
	
	Если РЗ.Пустой() Тогда
		
		// если не нашли дат ранее текущей, то проверить, нет ли дат после нее
		Запрос2 = Новый Запрос;
		Запрос2.Текст = "ВЫБРАТЬ
		                |	ВремТЧ.ДатаНачалаПериодаПовагонкиУчДок КАК ДатаНачалаПериодаПовагонки,
		                |	ВремТЧ.ДатаОкончанияПериодаПовагонкиУчДок КАК ДатаОкончанияПериодаПовагонки
		                |ПОМЕСТИТЬ ВТ
		                |ИЗ
		                |	&ВремТЧ КАК ВремТЧ
		                |;
		                |
		                |////////////////////////////////////////////////////////////////////////////////
		                |ВЫБРАТЬ ПЕРВЫЕ 1
		                |	ВТ.ДатаНачалаПериодаПовагонки КАК ДатаНачалаПериодаПовагонки
		                |ИЗ
		                |	ВТ КАК ВТ
		                |ГДЕ
		                |	НЕ ВТ.ДатаОкончанияПериодаПовагонки = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		                |	И НЕ ВТ.ДатаНачалаПериодаПовагонки = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		                |	И ВТ.ДатаНачалаПериодаПовагонки > &ТекДатаОтпр
		                |
		                |УПОРЯДОЧИТЬ ПО
		                |	ВТ.ДатаНачалаПериодаПовагонки";
		Запрос2.УстановитьПараметр("ВремТЧ",ТЗВспомогательная);
		Запрос2.УстановитьПараметр("ТекДатаОтпр",ДатаОтправления);
		РЗ2 = Запрос2.Выполнить();
		
		// если и здесь пусто, то считаем эту дату начальной и от нее строим всю остальную цепочку
		Если РЗ2.Пустой() Тогда
			ДатаНачалаПериодаПовагонкиУчДок = ДатаОтправления;
			ДатаОкончанияПериодаПовагонкиУчДок = ДатаОтправления + КвантВремени*3600*24;
			
		// если что-то нашли,  то выбираем диапазоны дат так, чтобы между найденной и текущей были равные кванту времени промежутки
		Иначе
			Ответ2 = Запрос2.Выполнить().Выбрать();
		
			Если Ответ2.Следующий() Тогда
				ДельтаДни = (Ответ2.ДатаНачалаПериодаПовагонки - ДатаОтправления)/3600/24;
				КолвоИнтервалов = Цел(ДельтаДни/КвантВремени);
				ВсегоДнейВИнтервалах = КолвоИнтервалов*КвантВремени;
				ОстатокПоДням = ДельтаДни - ВсегоДнейВИнтервалах;
				НачалоПервогоЗаИскомымПериода = Ответ2.ДатаНачалаПериодаПовагонки - ВсегоДнейВИнтервалах*3600*24;
				НачалоИскомогоПериода = НачалоПервогоЗаИскомымПериода - КвантВремени*3600*24;
				// вычитаем единицу, чтобы интервалы не пересекались
				КонецИскомогоПериода = НачалоПервогоЗаИскомымПериода - 1;
				
				ДатаНачалаПериодаПовагонкиУчДок = НачалоИскомогоПериода;
				ДатаОкончанияПериодаПовагонкиУчДок = КонецИскомогоПериода;
			КонецЕсли;
		КонецЕсли;
		
	// если что-то нашли, то выбираем диапазоны дат так, чтобы между найденной и текущей были равные кванту времени промежутки
	Иначе
		Ответ = Запрос.Выполнить().Выбрать();
		
		Если Ответ.Следующий() Тогда
			ДельтаДни = (ДатаОтправления - Ответ.ДатаОкончанияПериодаПовагонки)/3600/24;
			КолвоИнтервалов = Цел(ДельтаДни/КвантВремени);
			ВсегоДнейВИнтервалах = КолвоИнтервалов*КвантВремени;
			ОстатокПоДням = ДельтаДни - ВсегоДнейВИнтервалах;
			ОкончаниеПоследнегоПередИскомымПериода = Ответ.ДатаОкончанияПериодаПовагонки + ВсегоДнейВИнтервалах*3600*24;
			// вычитаем единицу, чтобы интервалы не пересекались
			НачалоИскомогоПериода = ОкончаниеПоследнегоПередИскомымПериода - 1;
			КонецИскомогоПериода = НачалоИскомогоПериода + КвантВремени*3600*24;
			
			ДатаНачалаПериодаПовагонкиУчДок = НачалоИскомогоПериода;
			ДатаОкончанияПериодаПовагонкиУчДок = КонецИскомогоПериода;
		КонецЕсли;
	КонецЕсли;
	
	СтруктураОтвета = Новый СТруктура;
	СтруктураОтвета.Вставить("ДатаНач",ДатаНачалаПериодаПовагонкиУчДок);
	СтруктураОтвета.Вставить("ДатаКон",ДатаОкончанияПериодаПовагонкиУчДок);
	
	Возврат СтруктураОтвета;
	
КонецФункции

Процедура СНПВыгрузкиВСделки(МассивСтруктур) ЭКСПОРТ
	
	ТблВагонов = Новый ТаблицаЗначений;
	ТблВагонов.Колонки.Добавить("НомерВагона",Новый ОписаниеТипов("СправочникСсылка.ТС"));
	ТблВагонов.Колонки.Добавить("ДатаОтправления",Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	
	Для Каждого Эл Из МассивСтруктур Цикл
		НовСтр = ТблВагонов.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,Эл);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВремТЧ.НомерВагона КАК НомерВагона,
		|	ВремТЧ.ДатаОтправления КАК ДатаОтправления
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ВремТЧ КАК ВремТЧ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПовагонныеОтправки.Период КАК Период,
		|	ПовагонныеОтправки.Вагон КАК НомерВагона,
		|	ПовагонныеОтправки.СтанцияОтправления КАК СтанцияОтправления,
		|	ПовагонныеОтправки.Сделка КАК Сделка,
		|	ПовагонныеОтправки.РТУ КАК РТУ,
		|	ПовагонныеОтправки.Клиент КАК Клиент,
		|	ПовагонныеОтправки.Договор КАК Договор,
		|	ПовагонныеОтправки.Калькуляция КАК Калькуляция,
		|	ПовагонныеОтправки.Заявка КАК Заявка,
		|	ПовагонныеОтправки.ДатаОтправления КАК ДатаОтправления,
		|	ПовагонныеОтправки.ДатаПрибытияНаСтанцию КАК ДатаПрибытияНаСтанцию,
		|	ПовагонныеОтправки.ДатаОтправленияСоСтанцииНазначения КАК ДатаОтправленияСоСтанцииНазначения,
		|	ПовагонныеОтправки.ДатаПрибытияНаСтанциюНазначения КАК ДатаПрибытияНаСтанциюНазначения,
		|	ПовагонныеОтправки.СтанцияНазначения КАК СтанцияНазначения,
		|	ВЫБОР
		|		КОГДА ПовагонныеОтправки.Заявка = ЗНАЧЕНИЕ(Документ.Заявка.пустаяссылка)
		|			ТОГДА ПовагонныеОтправки.ДатаПрибытияНаСтанцию
		|		КОГДА ПовагонныеОтправки.ДатаПрибытияНаСтанцию = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|			ТОГДА ПовагонныеОтправки.Заявка.Дата
		|		КОГДА НЕ ПовагонныеОтправки.Заявка = ЗНАЧЕНИЕ(Документ.Заявка.пустаяссылка)
		|				И НЕ ПовагонныеОтправки.ДатаПрибытияНаСтанцию = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|			ТОГДА ВЫБОР
		|					КОГДА ПовагонныеОтправки.ДатаПрибытияНаСтанцию > ПовагонныеОтправки.Заявка.Дата
		|						ТОГДА ПовагонныеОтправки.ДатаПрибытияНаСтанцию
		|					ИНАЧЕ ПовагонныеОтправки.Заявка.Дата
		|				КОНЕЦ
		|	КОНЕЦ КАК ДатаПрибытияДляСНП,
		|	ПовагонныеОтправки.НДС КАК НДС,
		|	ПовагонныеОтправки.КалькуляцияНеПодходит КАК КалькуляцияНеПодходит,
		|	ВЫБОР
		|		КОГДА НЕ ПовагонныеОтправки.ДатаОтправленияСоСтанцииНазначения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|				И НЕ ПовагонныеОтправки.ДатаПрибытияНаСтанциюНазначения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|			ТОГДА РАЗНОСТЬДАТ(ПовагонныеОтправки.ДатаПрибытияНаСтанциюНазначения, ПовагонныеОтправки.ДатаОтправленияСоСтанцииНазначения, ДЕНЬ)
		|		КОГДА НЕ ПовагонныеОтправки.ПереводВНРП = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|				И НЕ ПовагонныеОтправки.ДатаПрибытияНаСтанциюНазначения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|			ТОГДА РАЗНОСТЬДАТ(ПовагонныеОтправки.ДатаПрибытияНаСтанциюНазначения, ПовагонныеОтправки.ПереводВНРП, ДЕНЬ)
		|		КОГДА НЕ ПовагонныеОтправки.ДатаОкончанияПользования = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|				И НЕ ПовагонныеОтправки.ДатаПрибытияНаСтанциюНазначения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|			ТОГДА РАЗНОСТЬДАТ(ПовагонныеОтправки.ДатаПрибытияНаСтанциюНазначения, ПовагонныеОтправки.ДатаОкончанияПользования, ДЕНЬ)
		|	КОНЕЦ КАК ДельтаВыгрузки,
		|	РАЗНОСТЬДАТ(ПовагонныеОтправки.ДатаПередачиВПользование, ПовагонныеОтправки.ДатаОкончанияПользования, ДЕНЬ) КАК ДельтаОбщегоПользования,
		|	ПовагонныеОтправки.ПСЦ КАК ПСЦ
		|ПОМЕСТИТЬ Повагонка
		|ИЗ
		|	ВТ КАК ВТ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПовагонныеОтправки КАК ПовагонныеОтправки
		|		ПО ВТ.НомерВагона = ПовагонныеОтправки.Вагон
		|			И ВТ.ДатаОтправления = ПовагонныеОтправки.ДатаОтправления
		|ГДЕ
		|	НЕ ПовагонныеОтправки.ДатаПрибытияНаСтанциюНазначения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|	И (НЕ ПовагонныеОтправки.ДатаОтправленияСоСтанцииНазначения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|			ИЛИ НЕ ПовагонныеОтправки.ДатаОкончанияПользования = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|			ИЛИ НЕ ПовагонныеОтправки.ПереводВНРП = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
		|	И (НЕ ПовагонныеОтправки.РТУСНПВыгрузки
		|			ИЛИ НЕ ПовагонныеОтправки.РТУСНППогрузки
		|			ИЛИ НЕ ПовагонныеОтправки.РТУСНППеревозки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА Повагонка.ДельтаВыгрузки > ПСЦКалькуляцииПовагонки.СНПВыгрузкиДни
		|			ТОГДА Повагонка.ДельтаВыгрузки - ПСЦКалькуляцииПовагонки.СНПВыгрузкиДни
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СНПВыгрузки,
		|	ВЫБОР
		|		КОГДА Повагонка.ДельтаОбщегоПользования > ПСЦКалькуляцииПовагонки.НормативСледованияДни
		|			ТОГДА Повагонка.ДельтаОбщегоПользования - ПСЦКалькуляцииПовагонки.НормативСледованияДни
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СНПСледования,
		|	Повагонка.НомерВагона КАК НомерВагона,
		|	Повагонка.Период КАК Период,
		|	Повагонка.СтанцияОтправления КАК СтанцияОтправления,  
		//|	ВыставлениеПосуточнойАренды.Регистратор КАК Сделка
		//ДИТ Беляев СЮ, Ticket#0248292, 03-11-2021 ++ (Убираем использование регистра <ВыставлениеПосуточнойАренды>
		|	Значение(Документ.Сделка.ПустаяСсылка) КАК Сделка
		//ДИТ Беляев СЮ, Ticket#0248292, 03-11-2021 --
		|ИЗ
		|	Повагонка КАК Повагонка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПСЦ.КалькуляцииПовагонки КАК ПСЦКалькуляцииПовагонки
		|		ПО Повагонка.ПСЦ = ПСЦКалькуляцииПовагонки.Ссылка
		|			И Повагонка.Калькуляция = ПСЦКалькуляцииПовагонки.Калькуляция       
		//ДИТ Беляев СЮ, Ticket#0248292, 03-11-2021 ++ (Убираем использование регистра <ВыставлениеПосуточнойАренды>
		//|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВыставлениеПосуточнойАренды КАК ВыставлениеПосуточнойАренды
		//|		ПО Повагонка.НомерВагона = ВыставлениеПосуточнойАренды.НомерВагона
		//|			И Повагонка.ДатаОтправления = ВыставлениеПосуточнойАренды.Период
		//|			И (ВыставлениеПосуточнойАренды.Регистратор ССЫЛКА Документ.Сделка)
		//ДИТ Беляев СЮ, Ticket#0248292, 03-11-2021 --                       
		|ГДЕ
		|	(Повагонка.ДельтаВыгрузки > ПСЦКалькуляцииПовагонки.СНПВыгрузкиДни
		|			ИЛИ Повагонка.ДельтаОбщегоПользования > ПСЦКалькуляцииПовагонки.НормативСледованияДни) 
		|ИТОГИ ПО
		|	Сделка
		|";
	
	Запрос.УстановитьПараметр("ВремТЧ",ТблВагонов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаСделка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСделка.Следующий() Цикл
		
		Если Не ЗначениеЗаполнено(ВыборкаСделка.Сделка) ТОгда 
			Продолжить;
		КонецЕсли;
		
		НоваяСделка = ВыборкаСделка.Сделка.ПолучитьОбъект();
		доходы_ЗаполнитьПоЗаявкам2(НоваяСделка,4);
		
		Попытка
			НоваяСделка.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			НоваяСделка.Записать(РежимЗаписиДокумента.Запись);
		КонецПопытки;
		
		
		ВыборкаДетальныеЗаписи = ВыборкаСделка.Выбрать();
	
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			///////////////////////////////
		КонецЦикла;
	КонецЦикла;
	
	
	
КонецПроцедуры

Функция АвтоПОдстановкаКалькуляции(СтавкаНДС,СтанцияОтправления,СтанцияНазначения,НомерВагона);
	
	Калькуляция = Документы.Калькуляция.ПустаяСсылка();
	
	МассивРазмеровВагона = ПолучитьМассивРодителейТипаТС(НомерВагона.ТипТС,Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.Калькуляция.ММ_КалькуляцияМультимодальнойЦепочки КАК КалькуляцияММ_КалькуляцияМультимодальнойЦепочки
	               |ГДЕ
	               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка.ЖД_РасчетСебестоимостиДляТипаФГП В(&РазмерВагона)
	               |	И КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.ПунктОтправления В ИЕРАРХИИ(&ПунктОтправления)
	               |	И КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.ПунктНазначения В ИЕРАРХИИ(&ПунктНазначения)
	               |	И КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.СтавкаНДС = &СтавкаНДС
	               |	И КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.ВыставляемаяУслуга = &ВыставляемаяУслуга";
	Запрос.УстановитьПараметр("ПунктОтправления",СтанцияОтправления);
	Запрос.УстановитьПараметр("ПунктНазначения",СтанцияНазначения);
	Запрос.УстановитьПараметр("СтавкаНДС",СтавкаНДС);
	Запрос.УстановитьПараметр("РазмерВагона",МассивРазмеровВагона);
	Запрос.УстановитьПараметр("ВыставляемаяУслуга",Константы.УслугаДляПовагоннойЗаявки.Получить());

	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Калькуляция = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Калькуляция;
	
КонецФункции
