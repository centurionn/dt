Процедура ОбновлениеДанныхРегистраПовагонки() Экспорт
	
	// необходимо обновлять данные по регистру ПовагонныеОтправки для получения СНП по станциям отправления и назначения.
	// обновляем информацию только для тех вагонов, у который нет даты вывода из повагонки.
	ОбновлениеДатыОтправления();
	
	ОбновлениеДатыПрибытияНаСтанциюНазначения();
	
	ОбновлениеДатыОтправленияСоСтанцииНазначения();
	
	// еще раз, чтобы обновить новые строки, которые могли появиться в результате обновления даты прибытия на станцию назначения
	ОбновлениеДатыОтправления();
	
КонецПроцедуры

Процедура ОбновлениеДатыОтправления()
	
	// 1. СНП отправления. обновляем только те вагоны, у которых нет даты отправления со станции отправления.
	// для данного вагона в РС Дислокация вагонов взять последнюю запись. если станция отправления по повагонке НЕ
	// совпадает со станцией операции в дислокации, то значит вагон ушел со станции отправления и надо записать дату.
	// дату отправления берем как последнюю дату операции по данной станции в регистре дислокации
	// установив верхнюю границу периода - текущий период станции дислокации и нижнюю - дату прибытия на станцию.
	// запишем станцию назначения
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПовагонныеОтправкиСрезПоследних.Период КАК ДатаПомещенияВРежимПовагонки,
	               |	ПовагонныеОтправкиСрезПоследних.Вагон КАК НомерВагона,
	               |	ПовагонныеОтправкиСрезПоследних.СтанцияОтправления КАК СтанцияОтправления,
	               |	ПовагонныеОтправкиСрезПоследних.ДатаПрибытияНаСтанцию КАК ДатаПрибытияНаСтанцию
	               |ПОМЕСТИТЬ Повагонка
	               |ИЗ
	               |	РегистрСведений.ПовагонныеОтправки.СрезПоследних(, ) КАК ПовагонныеОтправкиСрезПоследних
	               |ГДЕ
	               |	ПовагонныеОтправкиСрезПоследних.ВыводИзПовагонки = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |	И ПовагонныеОтправкиСрезПоследних.ДатаОтправления = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |	И НЕ ПовагонныеОтправкиСрезПоследних.ДатаПрибытияНаСтанцию = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МАКСИМУМ(ДислокацияВагонов.Период) КАК Период,
	               |	ДислокацияВагонов.Вагон КАК Вагон
	               |ПОМЕСТИТЬ ПериодДислокации
	               |ИЗ
	               |	Повагонка КАК Повагонка
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДислокацияВагонов КАК ДислокацияВагонов
	               |		ПО Повагонка.НомерВагона = ДислокацияВагонов.Вагон
	               |			И Повагонка.СтанцияОтправления = ДислокацияВагонов.СтанцияОтправления
	               |			И Повагонка.СтанцияОтправления = ДислокацияВагонов.СтанцияОперации
	               |			И (ДислокацияВагонов.Период > Повагонка.ДатаПрибытияНаСтанцию)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ДислокацияВагонов.Вагон
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МАКСИМУМ(ДислокацияВагонов.Период) КАК Период,
	               |	ДислокацияВагонов.Вагон КАК Вагон,
	               |	МАКСИМУМ(ДислокацияВагонов.ОперацияСВагоном) КАК ОперацияСВагоном
	               |ПОМЕСТИТЬ ВагоныОперации
	               |ИЗ
	               |	РегистрСведений.ДислокацияВагонов КАК ДислокацияВагонов
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПериодДислокации КАК ПериодДислокации
	               |		ПО ДислокацияВагонов.Период = ПериодДислокации.Период
	               |			И ДислокацияВагонов.Вагон = ПериодДислокации.Вагон
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ДислокацияВагонов.Вагон
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДислокацияВагонов.Период КАК Период,
	               |	ДислокацияВагонов.Вагон КАК Вагон,
	               |	ДислокацияВагонов.ОперацияСВагоном КАК ОперацияСВагоном,
	               |	ДислокацияВагонов.СтанцияОперации КАК СтанцияОперации
	               |ПОМЕСТИТЬ ДислокацияЪ
	               |ИЗ
	               |	РегистрСведений.ДислокацияВагонов КАК ДислокацияВагонов
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВагоныОперации КАК ВагоныОперации
	               |		ПО ДислокацияВагонов.Период = ВагоныОперации.Период
	               |			И ДислокацияВагонов.Вагон = ВагоныОперации.Вагон
	               |			И ДислокацияВагонов.ОперацияСВагоном = ВагоныОперации.ОперацияСВагоном
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДислокацияЪ.Период КАК Период,
	               |	ДислокацияЪ.Вагон КАК Вагон,
	               |	Повагонка.СтанцияОтправления КАК СтанцияОтправления,
	               |	Повагонка.ДатаПрибытияНаСтанцию КАК ДатаПрибытияНаСтанцию
	               |ПОМЕСТИТЬ НесовпадениеСтанций
	               |ИЗ
	               |	Повагонка КАК Повагонка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДислокацияЪ КАК ДислокацияЪ
	               |		ПО Повагонка.НомерВагона = ДислокацияЪ.Вагон
	               |			И Повагонка.СтанцияОтправления = ДислокацияЪ.СтанцияОперации
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НесовпадениеСтанций.Вагон КАК Вагон,
	               |	НесовпадениеСтанций.СтанцияОтправления КАК СтанцияОтправления,
	               |	НесовпадениеСтанций.ДатаПрибытияНаСтанцию КАК ДатаПрибытияНаСтанцию,
	               |	МАКСИМУМ(ДислокацияВагонов.Период) КАК ДатаОтправленияСоСтанции,
	               |	ДислокацияВагонов.СтанцияНазначения КАК СтанцияНазначения,
	               |	ДислокацияВагонов.Груз КАК Груз,
	               |	ДислокацияВагонов.Груженый КАК Груженый
	               |ПОМЕСТИТЬ ДтОтправления
	               |ИЗ
	               |	НесовпадениеСтанций КАК НесовпадениеСтанций
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДислокацияВагонов КАК ДислокацияВагонов
	               |		ПО НесовпадениеСтанций.Вагон = ДислокацияВагонов.Вагон
	               |			И НесовпадениеСтанций.СтанцияОтправления = ДислокацияВагонов.СтанцияОперации
	               |			И (ДислокацияВагонов.Период МЕЖДУ НесовпадениеСтанций.ДатаПрибытияНаСтанцию И НесовпадениеСтанций.Период)
	               |			И (ДислокацияВагонов.ОперацияСВагоном.ОтправлениеСоСтанции)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	НесовпадениеСтанций.Вагон,
	               |	НесовпадениеСтанций.СтанцияОтправления,
	               |	НесовпадениеСтанций.ДатаПрибытияНаСтанцию,
	               |	ДислокацияВагонов.СтанцияНазначения,
	               |	ДислокацияВагонов.Груз,
	               |	ДислокацияВагонов.Груженый
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Повагонка.ДатаПомещенияВРежимПовагонки КАК Период,
	               |	Повагонка.НомерВагона КАК Вагон,
	               |	ДтОтправления.ДатаОтправленияСоСтанции КАК ДатаОтправленияСоСтанции,
	               |	ДтОтправления.СтанцияНазначения КАК СтанцияНазначения,
	               |	ДтОтправления.Груз КАК Груз,
	               |	ДтОтправления.Груженый КАК Груженый
	               |ИЗ
	               |	Повагонка КАК Повагонка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДислокацияЪ КАК ДислокацияЪ
	               |		ПО Повагонка.НомерВагона = ДислокацияЪ.Вагон
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДтОтправления КАК ДтОтправления
	               |		ПО Повагонка.НомерВагона = ДтОтправления.Вагон
	               |			И Повагонка.СтанцияОтправления = ДтОтправления.СтанцияОтправления";
	Ответ = Запрос.Выполнить().Выбрать();
	МассивВагонов = Новый Массив;
	
	Пока Ответ.Следующий() Цикл
		ТекЗапись = РегистрыСведений.ПовагонныеОтправки.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(ТекЗапись,Ответ,,"СтанцияНазначения");
		ТекЗапись2 = РегистрыСведений.ПовагонныеОтправки.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(ТекЗапись2, ТекЗапись);
		
		ТекЗапись.Прочитать();
		Если НЕ ТекЗапись.Выбран() Тогда
			ЗаполнитьЗначенияСвойств(ТекЗапись, ТекЗапись2);
		КонецЕсли;

		ТекЗапись.ДатаОтправления = Ответ.ДатаОтправленияСоСтанции;
		ТекЗапись.ДатаПередачиВПользование = ?(ЗначениеЗаполнено(ТекЗапись.ДатаПередачиВПользование),ТекЗапись.ДатаПередачиВПользование,Ответ.ДатаОтправленияСоСтанции);
		ТекЗапись.СтанцияНазначения = Ответ.СтанцияНазначения;
		ТекЗапись.Груз = Ответ.Груз;
		ТекЗапись.Груженый = Ответ.Груженый;
		
		ТекЗапись.Записать();
		
		МассивВагонов.Добавить(Ответ.Вагон);
	КонецЦикла;
	
	// создать оповещение для группы пользователей о готовности вагона к оформлению
	ОповещениеПользователейГотовностьВагона(МассивВагонов,"Отправление");

КонецПроцедуры

Процедура ОбновлениеДатыПрибытияНаСтанциюНазначения()
	// 2.1. СНП прибытия. обновляем только те вагоны, у которых нет даты прибытия на станцию назначения.
	// для данного вагона в РС Дислокация вагонов взять последнюю запись. если станция назначения = станции операции,
	// то берем данные по прибытию на станцию 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПовагонныеОтправкиСрезПоследних.Период КАК ДатаПомещенияВРежимПовагонки,
	               |	ПовагонныеОтправкиСрезПоследних.Вагон КАК НомерВагона,
	               |	ПовагонныеОтправкиСрезПоследних.СтанцияНазначения КАК СтанцияНазначения,
	               |	ПовагонныеОтправкиСрезПоследних.ДатаПрибытияНаСтанцию КАК ДатаПрибытияНаСтанцию,
	               |	ПовагонныеОтправкиСрезПоследних.ДатаОтправления КАК ДатаОтправления
	               |ПОМЕСТИТЬ Повагонка
	               |ИЗ
	               |	РегистрСведений.ПовагонныеОтправки.СрезПоследних(, ) КАК ПовагонныеОтправкиСрезПоследних
	               |ГДЕ
	               |	ПовагонныеОтправкиСрезПоследних.ВыводИзПовагонки = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |			И ПовагонныеОтправкиСрезПоследних.ДатаПрибытияНаСтанциюНазначения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |			И НЕ ПовагонныеОтправкиСрезПоследних.ДатаОтправления = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Повагонка.НомерВагона КАК Вагон,
	               |	Повагонка.СтанцияНазначения КАК СтанцияНазначения,
	               |	МИНИМУМ(ДислокацияВагонов.ДатаПрибытияНаСтанцию) КАК ДатаПрибытияНаСтанцию,
	               |	Повагонка.ДатаПомещенияВРежимПовагонки КАК Период
	               |ИЗ
	               |	Повагонка КАК Повагонка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДислокацияВагонов КАК ДислокацияВагонов
	               |		ПО Повагонка.НомерВагона = ДислокацияВагонов.Вагон
	               |			И (ДислокацияВагонов.Период > Повагонка.ДатаОтправления)
	               |			И Повагонка.СтанцияНазначения = ДислокацияВагонов.СтанцияОперации
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Повагонка.СтанцияНазначения,
	               |	Повагонка.НомерВагона,
	               |	Повагонка.ДатаПомещенияВРежимПовагонки";
	Ответ = Запрос.Выполнить().Выбрать();
	
	ТаблицаНовыхНазначений = Новый ТаблицаЗначений;
	ТаблицаНовыхНазначений.Колонки.Добавить("Период");
	ТаблицаНовыхНазначений.Колонки.Добавить("Вагон");
	ТаблицаНовыхНазначений.Колонки.Добавить("СтанцияОтправления");
	ТаблицаНовыхНазначений.Колонки.Добавить("СтанцияНазначения");
	ТаблицаНовыхНазначений.Колонки.Добавить("Клиент");
	ТаблицаНовыхНазначений.Колонки.Добавить("Договор");
	ТаблицаНовыхНазначений.Колонки.Добавить("СтанцияВвода");
	ТаблицаНовыхНазначений.Колонки.Добавить("ПСЦ");
	ТаблицаНовыхНазначений.Колонки.Добавить("ОтветственныйВнесДанные");
	ТаблицаНовыхНазначений.Колонки.Добавить("СобытиеПереводаВПовагонку");
	ТаблицаНовыхНазначений.Колонки.Добавить("ДатаПередачиВПользование");
	ТаблицаНовыхНазначений.Колонки.Добавить("ДатаПрибытияНаСтанцию");
	ТаблицаНовыхНазначений.Колонки.Добавить("РегионОтправления");
	ТаблицаНовыхНазначений.Колонки.Добавить("Подход");
	ТаблицаНовыхНазначений.Колонки.Добавить("НДС");
	ТаблицаНовыхНазначений.Колонки.Добавить("Калькуляция");
	
	МассивВагонов = Новый Массив;
	
	Пока Ответ.Следующий() Цикл
		ТекЗапись = РегистрыСведений.ПовагонныеОтправки.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(ТекЗапись,Ответ,,"ДатаПрибытияНаСтанцию");
		ТекЗапись2 = РегистрыСведений.ПовагонныеОтправки.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(ТекЗапись2, ТекЗапись);
		
		ТекЗапись.Прочитать();
		Если НЕ ТекЗапись.Выбран() Тогда
			ЗаполнитьЗначенияСвойств(ТекЗапись, ТекЗапись2);
		КонецЕсли;

		ТекЗапись.ДатаПрибытияНаСтанциюНазначения = Ответ.ДатаПрибытияНаСтанцию;
		
		// если повилось прибытие на станцию, то проверить, не вывела ли станция вагон из повагонки
		// (проверка на наличие даты вывода из повагонки). если вывода из повагонки нет, то проверить заполнение полей
		// "... следующего назначения".
		
		Если НЕ ЗначениеЗаполнено(ТекЗапись.ВыводИзПовагонки) И ЗначениеЗаполнено(Ответ.ДатаПрибытияНаСтанцию) Тогда
			НовСтр = ТаблицаНовыхНазначений.Добавить();
			НовСтр.Период = ТекЗапись.ДатаПрибытияНаСтанциюНазначения;
			НовСтр.Вагон = ТекЗапись.Вагон;
			НовСтр.СтанцияВвода = ТекЗапись.СтанцияВвода;
			НовСтр.ОтветственныйВнесДанные = ТекЗапись.ОтветственныйВнесДанные;
			НовСтр.СобытиеПереводаВПовагонку = ТекЗапись.СобытиеПереводаВПовагонку;
			НовСтр.Клиент = ?(ЗначениеЗаполнено(ТекЗапись.КлиентСледующегоНазначения),ТекЗапись.КлиентСледующегоНазначения,ТекЗапись.Клиент);
			НовСтр.Договор = ?(ЗначениеЗаполнено(ТекЗапись.ДоговорСледующегоНазначения),ТекЗапись.ДоговорСледующегоНазначения,ТекЗапись.Договор);
			НовСтр.ПСЦ = ?(ЗначениеЗаполнено(ТекЗапись.ПСЦСледующегоНазначения),ТекЗапись.ПСЦСледующегоНазначения,ТекЗапись.ПСЦ);
			НовСтр.СтанцияНазначения = ТекЗапись.СтанцияСледующегоНазначения;
			НовСтр.СтанцияОтправления = ТекЗапись.СтанцияНазначения;
			НовСтр.ДатаПередачиВПользование = ТекЗапись.ДатаПередачиВПользование;
			НовСтр.НДС = ?(ЗначениеЗаполнено(ТекЗапись.ПСЦСледующегоНазначения),ТекЗапись.ПСЦСледующегоНазначения.СтавкаНДС,ТекЗапись.ПСЦ.СтавкаНДС);
			НовСтр.Калькуляция = АвтоПОдстановкаКалькуляции(НовСтр.НДС,НовСтр.СтанцияОтправления,НовСтр.СтанцияНазначения,НовСтр.Вагон);
			НовСтр.ДатаПрибытияНаСтанцию = ТекЗапись.ДатаПрибытияНаСтанциюНазначения;
			
			//// 1. если у вагона станция следующего назначения равна станции назначения (проверка по синонимам локации),
			//// то переместить вагон в регистр повагонки.
			//Если Локации_сервер.ПолучитьСовпадениеСтанций(ТекЗапись.СтанцияСледующегоНазначения,ТекЗапись.СтанцияНазначения) Тогда 
			//	//НовСтр.ДатаПередачиВПользование = ТекЗапись.ДатаПрибытияНаСтанциюНазначения;
			//	НовСтр.ДатаПрибытияНаСтанцию = ТекЗапись.ДатаПрибытияНаСтанциюНазначения;
			//	НовСтр.СтанцияОтправления = ТекЗапись.СтанцияНазначения;
			//	НовСтр.Подход = Ложь;
			//// 2. если у вагона станция следующего назначения НЕ равна станции назначения (проверка по синонимам локации),
			//// то переместить вагон в регистр вагонов ПЛАНИРУЕМЫХ к повагонке.
			//Иначе
			//	//НовСтр.ДатаПередачиВПользование = ТекЗапись.ДатаПрибытияНаСтанциюНазначения;
			//	НовСтр.РегионОтправления = ТекЗапись.СтанцияНазначения;
			//	НовСтр.Подход = Истина;
			//КонецЕсли;
			
		КонецЕсли;
		
		ТекЗапись.Записать();
		
		МассивВагонов.Добавить(Ответ.Вагон);
	КонецЦикла;
				   
	// цикл по таблице новых назначений
	Для Каждого Стр Из ТаблицаНовыхНазначений Цикл
		
		//Если Стр.Подход Тогда
		//	ТекЗапись = РегистрыСведений.ВагоныЗапланированныеКПовагонке.СоздатьМенеджерЗаписи();
		//Иначе
			ТекЗапись = РегистрыСведений.ПовагонныеОтправки.СоздатьМенеджерЗаписи();
		//КонецЕсли;
		ЗаполнитьЗначенияСвойств(ТекЗапись,Стр);
		ТекЗапись.Записать();
	КонецЦикла;
	
	// создать оповещение для группы пользователей о готовности вагона к оформлению
	ОповещениеПользователейГотовностьВагона(МассивВагонов,"Прибытие");

КонецПроцедуры

Процедура ОбновлениеДатыОтправленияСоСтанцииНазначения()
	// 2.2. СНП прибытия. обновляем только те вагоны, у которых нет даты отправления со станции назначения.
	// для данного вагона в РС Дислокация вагонов взять последнюю запись. если станция назначения по повагонке НЕ
	// совпадает со станцией операции в дислокации, то значит вагон ушел со станции назначения и надо записать дату.
	// дату отправления берем как последнюю дату операции по данной станции в регистре дислокации
	// установив верхнюю границу периода - текущий период станции дислокации и нижнюю границу - дату прибытия на станцию назначения.
	// запишем станцию назначения
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПовагонныеОтправкиСрезПоследних.Период КАК ДатаПомещенияВРежимПовагонки,
	               |	ПовагонныеОтправкиСрезПоследних.Вагон КАК НомерВагона,
	               |	ПовагонныеОтправкиСрезПоследних.СтанцияНазначения КАК СтанцияНазначения,
	               |	ПовагонныеОтправкиСрезПоследних.ДатаПрибытияНаСтанциюНазначения КАК ДатаПрибытияНаСтанциюНазначения
	               |ПОМЕСТИТЬ Повагонка
	               |ИЗ
	               |	РегистрСведений.ПовагонныеОтправки.СрезПоследних(
	               |			,
	               |			НЕ ДатаПрибытияНаСтанциюНазначения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |				И НЕ ДатаОтправления = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |				И ДатаОтправленияСоСтанцииНазначения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ПовагонныеОтправкиСрезПоследних
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МАКСИМУМ(ДислокацияВагонов.Период) КАК Период,
	               |	ДислокацияВагонов.Вагон КАК Вагон
	               |ПОМЕСТИТЬ ПериодДислокации
	               |ИЗ
	               |	Повагонка КАК Повагонка
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДислокацияВагонов КАК ДислокацияВагонов
	               |		ПО Повагонка.НомерВагона = ДислокацияВагонов.Вагон
	               |			И Повагонка.СтанцияНазначения = ДислокацияВагонов.СтанцияОтправления
	               |			И Повагонка.СтанцияНазначения = ДислокацияВагонов.СтанцияОперации
	               |			И (ДислокацияВагонов.Период > Повагонка.ДатаПрибытияНаСтанциюНазначения)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ДислокацияВагонов.Вагон
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МАКСИМУМ(ДислокацияВагонов.Период) КАК Период,
	               |	ДислокацияВагонов.Вагон КАК Вагон,
	               |	МАКСИМУМ(ДислокацияВагонов.ОперацияСВагоном) КАК ОперацияСВагоном
	               |ПОМЕСТИТЬ ВагоныОперации
	               |ИЗ
	               |	РегистрСведений.ДислокацияВагонов КАК ДислокацияВагонов
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПериодДислокации КАК ПериодДислокации
	               |		ПО ДислокацияВагонов.Период = ПериодДислокации.Период
	               |			И ДислокацияВагонов.Вагон = ПериодДислокации.Вагон
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ДислокацияВагонов.Вагон
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДислокацияВагонов.Период КАК Период,
	               |	ДислокацияВагонов.Вагон КАК Вагон,
	               |	ДислокацияВагонов.ОперацияСВагоном КАК ОперацияСВагоном,
	               |	ДислокацияВагонов.СтанцияОперации КАК СтанцияОперации
	               |ПОМЕСТИТЬ ДислокацияЪ
	               |ИЗ
	               |	РегистрСведений.ДислокацияВагонов КАК ДислокацияВагонов
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВагоныОперации КАК ВагоныОперации
	               |		ПО ДислокацияВагонов.Период = ВагоныОперации.Период
	               |			И ДислокацияВагонов.Вагон = ВагоныОперации.Вагон
	               |			И ДислокацияВагонов.ОперацияСВагоном = ВагоныОперации.ОперацияСВагоном
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДислокацияЪ.Период КАК Период,
	               |	ДислокацияЪ.Вагон КАК Вагон,
	               |	Повагонка.СтанцияНазначения КАК СтанцияНазначения,
	               |	Повагонка.ДатаПрибытияНаСтанциюНазначения КАК ДатаПрибытияНаСтанциюНазначения
	               |ПОМЕСТИТЬ НесовпадениеСтанций
	               |ИЗ
	               |	Повагонка КАК Повагонка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДислокацияЪ КАК ДислокацияЪ
	               |		ПО Повагонка.НомерВагона = ДислокацияЪ.Вагон
	               |			И (Повагонка.СтанцияНазначения = ДислокацияЪ.СтанцияОперации)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НесовпадениеСтанций.Вагон КАК Вагон,
	               |	НесовпадениеСтанций.СтанцияНазначения КАК СтанцияНазначения,
	               |	НесовпадениеСтанций.ДатаПрибытияНаСтанциюНазначения КАК ДатаПрибытияНаСтанциюНазначения,
	               |	МАКСИМУМ(ДислокацияВагонов.Период) КАК ДатаОтправленияСоСтанции,
	               |	ДислокацияВагонов.СтанцияНазначения КАК СтанцияСледующегоНазначения
	               |ПОМЕСТИТЬ ДтОтправления
	               |ИЗ
	               |	НесовпадениеСтанций КАК НесовпадениеСтанций
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДислокацияВагонов КАК ДислокацияВагонов
	               |		ПО НесовпадениеСтанций.Вагон = ДислокацияВагонов.Вагон
	               |			И НесовпадениеСтанций.СтанцияНазначения = ДислокацияВагонов.СтанцияОперации
	               |			И (ДислокацияВагонов.Период МЕЖДУ НесовпадениеСтанций.ДатаПрибытияНаСтанциюНазначения И НесовпадениеСтанций.Период)
	               |			И (ДислокацияВагонов.ОперацияСВагоном.ОтправлениеСоСтанции)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	НесовпадениеСтанций.Вагон,
	               |	НесовпадениеСтанций.СтанцияНазначения,
	               |	НесовпадениеСтанций.ДатаПрибытияНаСтанциюНазначения,
	               |	ДислокацияВагонов.СтанцияНазначения
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Повагонка.ДатаПомещенияВРежимПовагонки КАК Период,
	               |	Повагонка.НомерВагона КАК Вагон,
	               |	ДтОтправления.ДатаОтправленияСоСтанции КАК ДатаОтправленияСоСтанции,
	               |	ДтОтправления.СтанцияНазначения КАК СтанцияНазначения
	               |ИЗ
	               |	Повагонка КАК Повагонка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДислокацияЪ КАК ДислокацияЪ
	               |		ПО Повагонка.НомерВагона = ДислокацияЪ.Вагон
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДтОтправления КАК ДтОтправления
	               |		ПО Повагонка.НомерВагона = ДтОтправления.Вагон
	               |			И Повагонка.СтанцияНазначения = ДтОтправления.СтанцияНазначения";
	Ответ = Запрос.Выполнить().Выбрать();
	
	Пока Ответ.Следующий() Цикл
		ТекЗапись = РегистрыСведений.ПовагонныеОтправки.СоздатьМенеджерЗаписи();
		ТекЗапись.Вагон = Ответ.Вагон;
		ТекЗапись.Период = Ответ.Период;
		
		ТекЗапись2 = РегистрыСведений.ПовагонныеОтправки.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(ТекЗапись2, ТекЗапись);
		
		ТекЗапись.Прочитать();
		Если НЕ ТекЗапись.Выбран() Тогда
			ЗаполнитьЗначенияСвойств(ТекЗапись, ТекЗапись2);
		КонецЕсли;

		ТекЗапись.ДатаОтправленияСоСтанцииНазначения = Ответ.ДатаОтправленияСоСтанции;
		ТекЗапись.СтанцияСледующегоНазначения = Ответ.СтанцияНазначения;
		
		ТекЗапись.Записать();
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьСписокПодходящихКалькуляций(ПараметрыЗапроса)
	
	МассивРазмеровВагона = ПолучитьМассивРодителейТипаТС(ПараметрыЗапроса.ТипТС,Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.Калькуляция.ММ_КалькуляцияМультимодальнойЦепочки КАК КалькуляцияММ_КалькуляцияМультимодальнойЦепочки
	               |ГДЕ
	               |	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка.ЖД_РасчетСебестоимостиДляТипаФГП В(&РазмерВагона)
	               |	И КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.ПунктОтправления В ИЕРАРХИИ(&ПунктОтправления)
	               |	И КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.ПунктНазначения В ИЕРАРХИИ(&ПунктНазначения)
	               |	И КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.СтавкаНДС = &СтавкаНДС
	               |	И КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.ВыставляемаяУслуга = &ВыставляемаяУслуга";
	Запрос.УстановитьПараметр("ПунктОтправления",ПараметрыЗапроса.ПунктОтправления);
	Запрос.УстановитьПараметр("ПунктНазначения",ПараметрыЗапроса.ПунктНазначения);
	Запрос.УстановитьПараметр("СтавкаНДС",ПараметрыЗапроса.НДС);
	Запрос.УстановитьПараметр("РазмерВагона",МассивРазмеровВагона);
	Запрос.УстановитьПараметр("ВыставляемаяУслуга",Константы.УслугаДляПовагоннойЗаявки.Получить());

	ТЗ = Запрос.Выполнить().Выгрузить();
	МассивКалькуляций = ТЗ.ВыгрузитьКолонку("Ссылка");
	
	Возврат МассивКалькуляций;
	
КонецФункции

Функция ПолучитьМассивРодителейТипаТС(ТипТС, ВключаяТекущий) 
	
	Результат = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(ТипТС) Тогда Возврат Результат; КонецЕсли;
	
	ТекРодитель = ТипТС.Родитель;
	Пока ЗначениеЗаполнено(ТекРодитель) Цикл
		Результат.Добавить(ТекРодитель);
		ТекРодитель = ТекРодитель.Родитель;
	КонецЦикла;
	
	Если ВключаяТекущий = Истина Тогда Результат.Добавить(ТипТС); КОнецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ОповещениеПользователейИсключениеИзПовагонки() ЭКСПОРТ
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПовагонныеОтправкиСрезПоследних.Период КАК Период,
	               |	ПовагонныеОтправкиСрезПоследних.Вагон КАК Вагон,
	               |	ПовагонныеОтправкиСрезПоследних.ВыводИзПовагонки КАК ВыводИзПовагонки
	               |ИЗ
	               |	РегистрСведений.ПовагонныеОтправки.СрезПоследних(, ) КАК ПовагонныеОтправкиСрезПоследних
	               |ГДЕ
	               |	НЕ ПовагонныеОтправкиСрезПоследних.ОповещениеСоздано
	               |			И НЕ ПовагонныеОтправкиСрезПоследних.ВыводИзПовагонки = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)";
	ТЗ = Запрос.Выполнить().Выгрузить();
	МассивВагонов = ТЗ.ВыгрузитьКолонку("Вагон");
	
	ЗВ = Документы.ЗапланированноеВзаимодействие.СоздатьДокумент();
	ЗВ.Дата = ТекущаяДата();
	ЗВ.Автор = Пользователи.ТекущийПользователь();
	ЗВ.СоздатьПроизводственнуюЗадачу = Истина;
	ЗВ.Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
	ЗВ.ДатаНачала = ТекущаяДата();
	СтрокаСВагонами = "";
	Для Каждого Эл Из МассивВагонов Цикл
		СтрокаСВагонами = СтрокаСВагонами + Эл + Символы.ПС;
	КонецЦикла;
	
	ЗВ.Тема = "Удаление вагонов из повагонки";
	ТЧ_Участники = ЗВ.Участники;
	НовСтр = ТЧ_Участники.Добавить();
	НовСтр.Контакт = Константы.ГруппаИнформируемыхОбИсключенииВагонаИзПовагонки.Получить();
	ЗаголовокОписания = "Из режима повагонки были исключены следующие вагоны:";
	
	ЗВ.Описание = ЗаголовокОписания + Символы.ПС + СтрокаСВагонами;
	ПОпытка
		ЗВ.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ЗВ.Записать(РежимЗаписиДокумента.Запись);
	КонецПопытки;
	
	// изменить запись в РС повагонныеОтправки
	Для Каждого Стр Из ТЗ Цикл
		ТекЗапись = РегистрыСведений.ПовагонныеОтправки.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(ТекЗапись,Стр);
		ТекЗапись2 = РегистрыСведений.ПовагонныеОтправки.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(ТекЗапись2, Стр);
		ТекЗапись.Прочитать();
		
		Если НЕ ТекЗапись.Выбран() Тогда
			ЗаполнитьЗначенияСвойств(ТекЗапись, ТекЗапись2);
		КонецЕсли;
		
		ТекЗапись.ОповещениеСоздано = Истина;
		ТекЗапись.Записать();
	КонецЦикла;
		
КонецПроцедуры

Процедура ОповещениеПользователейГотовностьВагона(МассивВагонов,ТипОповещения) 

	ЗВ = Документы.ЗапланированноеВзаимодействие.СоздатьДокумент();
	ЗВ.Дата = ТекущаяДата();
	ЗВ.Автор = Пользователи.ТекущийПользователь();
	ЗВ.СоздатьПроизводственнуюЗадачу = Истина;
	ЗВ.Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
	ЗВ.ДатаНачала = ТекущаяДата();
	СтрокаСВагонами = "";
	Для Каждого Эл Из МассивВагонов Цикл
		СтрокаСВагонами = СтрокаСВагонами + Эл + Символы.ПС;
	КонецЦикла;
	
	
	ЗВ.Тема = "Оформление вагонов";
	ТЧ_Участники = ЗВ.Участники;
	НовСтр = ТЧ_Участники.Добавить();
	НовСтр.Контакт = Константы.ГруппаИнформируемыхОбИсключенииВагонаИзПовагонки.Получить();
	
	Если ТипОповещения = "Отправление" Тогда
		ЗаголовокОписания = "Список вагонов к оформлению документов по отправке:";
	Иначе
		ЗаголовокОписания = "Список вагонов к оформлению документов по прибытию:"	
	КонецЕсли;
	
	ЗВ.Описание = ЗаголовокОписания + Символы.ПС + СтрокаСВагонами;
	ПОпытка
		ЗВ.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ЗВ.Записать(РежимЗаписиДокумента.Запись);
	КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьРегионОтправления(СтанцияОперации,Вагон) ЭКСПОРТ
	
	ПрибылВРегион = Ложь;
	
	РегионОтправленияИерархМассив = Локации_сервер.ПолучитьМассивРодителей(СтанцияОперации,Истина);
	//Евросиб Каблов 25.02.2021 (
	АналогиСтанции = Локации_сервер.ПолучитьАналогиИСтанцииБлижеЧемУказано(СтанцияОперации, 0);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(РегионОтправленияИерархМассив, АналогиСтанции, Истина);
	//Евросиб Каблов 25.02.2021 ) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВагоныЗапланированныеКПовагонке.Вагон КАК Вагон,
	               |	ВагоныЗапланированныеКПовагонке.РегионОтправления КАК РегионОтправления
	               |ИЗ
	               |	РегистрСведений.ВагоныЗапланированныеКПовагонке КАК ВагоныЗапланированныеКПовагонке
	               |ГДЕ
	               |	ВагоныЗапланированныеКПовагонке.Вагон = &Вагон
	               |	И ВагоныЗапланированныеКПовагонке.РегионОтправления В(&РегионОтправления)
	               |	И НЕ ВагоныЗапланированныеКПовагонке.РегионОтправления = ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("Вагон", Вагон);
	Запрос.УстановитьПараметр("РегионОтправления", РегионОтправленияИерархМассив);
	
	РЗ = Запрос.Выполнить();
	
	Если НЕ РЗ.Пустой() Тогда
		ПрибылВРегион = Истина;
	КонецЕсли;
	
	Возврат ПрибылВРегион;
	
КонецФункции

