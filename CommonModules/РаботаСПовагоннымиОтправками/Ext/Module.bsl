	               |	СвязьУчЕд.ДоговорРазделятьСчетаЗаОсновнуюУслугуИСчетаЗаСНП КАК ДоговорРазделятьСчетаЗаОсновнуюУслугуИСчетаЗаСНП,
	               |	СвязьУчЕд.Сделка КАК Сделка,
	               |	ВнесенныеВагоныУслуги.РаспределенныеВагоны КАК РаспределенныеВагоны,
	               |	ВнесенныеВагоныУслуги.ГУИД КАК ГУИД,
	               |	ВнесенныеВагоныУслуги.Услуга КАК Услуга,
	               |	ВнесенныеВагоныУслуги.Комментарий КАК Комментарий,
	               |	СвязьУчЕд.ДоговорВыставлениеВагоновПоПериоду КАК ДоговорВыставлениеВагоновПоПериоду,
	               |	СвязьУчЕд.ДатаНачалаПериодаПовагонки КАК ДатаНачалаПериодаПовагонки,
	               |	СвязьУчЕд.ДатаОкончанияПериодаПовагонки КАК ДатаОкончанияПериодаПовагонки,
	               |	СвязьУчЕд.ДатаОтправки КАК ДатаОтправки,
	               |	СвязьУчЕд.КоличествоДнейОборот КАК КоличествоДнейОборот,
	               |	СвязьУчЕд.СтанцияОтправления КАК СтанцияОтправления,
	               |	СвязьУчЕд.СтанцияНазначения КАК СтанцияНазначения,
	               |	СвязьУчЕд.ДатаПрибытияДляСНП КАК ДатаПрибытияДляСНП,
	               |	СвязьУчЕд.ДельтаВыгрузки КАК ДельтаВыгрузки,
	               |	СвязьУчЕд.ДельтаОбщегоПользования КАК ДельтаОбщегоПользования,
	               |	СвязьУчЕд.НормативСледованияДни КАК НормативСледованияДни,
	               |	СвязьУчЕд.НормативСледованияРуб КАК НормативСледованияРуб,
	               |	СвязьУчЕд.СНППогрузкиДни КАК СНППогрузкиДни,
	               |	СвязьУчЕд.СНППогрузкиРуб КАК СНППогрузкиРуб,
	               |	СвязьУчЕд.СНПВыгрузкиДни КАК СНПВыгрузкиДни,
	               |	СвязьУчЕд.СНПВыгрузкиРуб КАК СНПВыгрузкиРуб,
	               |	СвязьУчЕд.СНПСледованияРуб КАК СНПСледованияРуб,
	               |	СвязьУчЕд.СтавкаЗаРейс КАК СтавкаЗаРейс,
	               |	СвязьУчЕд.Вознаграждение КАК Вознаграждение,
	               |	ВЫБОР
	               |		КОГДА РАЗНОСТЬДАТ(СвязьУчЕд.ДатаПрибытияДляСНП, СвязьУчЕд.ДатаОтправки, ДЕНЬ) - СвязьУчЕд.СНППогрузкиДни > 0
	               |			ТОГДА РАЗНОСТЬДАТ(СвязьУчЕд.ДатаПрибытияДляСНП, СвязьУчЕд.ДатаОтправки, ДЕНЬ) - СвязьУчЕд.СНППогрузкиДни
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК СНППогрузки,
	               |	ВЫБОР
	               |		КОГДА СвязьУчЕд.ДельтаВыгрузки - СвязьУчЕд.СНПВыгрузкиДни > 0
	               |			ТОГДА СвязьУчЕд.ДельтаВыгрузки - СвязьУчЕд.СНПВыгрузкиДни
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК СНПВыгрузки,
	               |	ЛОЖЬ КАК Выставлен,
	               |	ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка) КАК ОтправлениеУчДокумента,
	               |	ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка) КАК НазначениеУчДокумента,
	               |	ВЫБОР
	               |		КОГДА СвязьУчЕд.НормативСледованияДни < СвязьУчЕд.ДельтаОбщегоПользования
	               |			ТОГДА СвязьУчЕд.ДельтаОбщегоПользования - СвязьУчЕд.НормативСледованияДни
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК СНПСледования,
	               |	ЛОЖЬ КАК ВагонПроверен,
	               |	ВЫБОР
	               |		КОГДА СвязьУчЕд.ЗаявкаПСЦ.ОплатаПользованияВагоном = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыПользованияВагоном.Посуточно)
	               |				ИЛИ СвязьУчЕд.ЗаявкаПСЦ.ОплатаПользованияВагоном = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыПользованияВагоном.ОбщаяПоКоличествуДнейИСНП)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ПосуточнаяОплата,
	               |	ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0) КАК НачалоПосуточногоДиапазона,
	               |	ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0) КАК ОкончаниеПосуточногоДиапазона,
	               |	ЛОЖЬ КАК Изменена,
	               |	СвязьУчЕд.Вагон.ТипТС КАК ТипВагонов,
	               |	СвязьУчЕд.НДС КАК СтавкаНДС,
	               |	ВнесенныеВагоныУслуги.ДатаВыставленногоРТУ КАК ДатаВыставленногоРТУ
	               |ИЗ
	               |	СвязьУчЕд КАК СвязьУчЕд
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВнесенныеВагоныУслуги КАК ВнесенныеВагоныУслуги
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.Доходы КАК СделкаДоходы
	               |			ПО ВнесенныеВагоныУслуги.Сделка = СделкаДоходы.Ссылка
	               |				И ВнесенныеВагоныУслуги.ГУИД = СделкаДоходы.ГУИД
	               |		ПО СвязьУчЕд.Вагон = ВнесенныеВагоныУслуги.Вагон
	               |			И СвязьУчЕд.Сделка = ВнесенныеВагоныУслуги.Сделка";
	Запрос.УстановитьПараметр("Ссылка",НоваяСделка.Ссылка);
	Запрос.УстановитьПараметр("ДатаНачалаПовагонки",НоваяСделка.Ссылка.ДатаНачалаПериодаПовагонки);
	Запрос.УстановитьПараметр("ДатаОкончанияПовагонки",НоваяСделка.Ссылка.ДатаОкончанияПериодаПовагонки);
	РезультатЗапроса = Запрос.Выполнить();

	Возврат РезультатЗапроса;
	
КонецФункции

Функция ПолучитьДиапазоныДатПоСделкам(ВыставленоДоДаты,ДатаОкончанияДвижения,КвантВремени,НачальнаяДатаДиапазонов,ВагонВПути)
	
	МассивСтруктур = Новый Массив;
	ПоследняяДата = Неопределено;
	
	// если начальная дата диапазонов больше даты, до коорой выставлены текущие вагоны, то нужно отсчитать диапазоны ранее
	Если НачальнаяДатаДиапазонов>ВыставленоДоДаты Тогда
		КолвоДнейДельта = НачалоДня(НачальнаяДатаДиапазонов) - НачалоДня(ВыставленоДоДаты);
		Интервалы = КолвоДнейДельта/КвантВремени;
		Если НЕ СтрНайти(Интервалы,",") = 0 Тогда
			Интервалы = Цел(Интервалы) + 1;
		Иначе
			Интервалы = Цел(Интервалы);
		КонецЕсли;
		НачальнаяДатаДиапазонов = НачальнаяДатаДиапазонов - Интервалы*КвантВремени;
	КонецЕсли;
		
	
	// нас интересует окончание расчета - ДатаОкончанияДвижения. кол-во сделок надо посчитать до этой даты
	КолвоДнейДляРасчета = Окр((ДатаОкончанияДвижения - НачальнаяДатаДиапазонов)/3600/24);
	
	// если вагон в пути, то нам нужны только целые диапазоны
	//Если ВагонВПути Тогда
	//	КолвоИнтервалов = Цел(КолвоДнейДляРасчета/КвантВремени);
	//Иначе
		// если вагон уже приехал, то нужно взять "хвост" диапазона и найти для него сделку
		КолвоИнтервалов = КолвоДнейДляРасчета/КвантВремени;
		Если НЕ СтрНайти(Строка(КолвоИнтервалов),",") = 0 Тогда
			КолвоИнтервалов = Цел(КолвоДнейДляРасчета/КвантВремени) + 1;
		КонецЕсли;
		ПоследняяДата = ДатаОкончанияДвижения;
	//КонецЕсли;
	
	НачалоЗаписи = Ложь;
	ДатаКон = Неопределено;
	
	Если КолвоИнтервалов = 0 Тогда
		КолвоИнтервалов = 1;
	КонецЕсли;
	
	Для ШагЦикла = 0 По КолвоИнтервалов-1 Цикл
		// чтобы не было пересечений диапазонов, надо прибавлять 1 секунду к каждой дате начала начиная со второго цикла
		Если ДатаКон = Неопределено Тогда
			ДатаНач = НачальнаяДатаДиапазонов;
		Иначе
			ДатаНач = ДатаКон + 1;
		КонецЕсли;
		Если ШагЦикла = КолвоИнтервалов-1 Тогда
			ДатаКон = ?(ПоследняяДата = Неопределено,КонецДня(ДатаНач + (КвантВремени-1)*3600*24),КонецДня(ПоследняяДата));
		Иначе
			ДатаКон = КонецДня(ДатаНач + (КвантВремени-1)*3600*24);
		КонецЕсли;
		
		// как только дошли до интервала, в котором находятся наши даты - начинаем записывать их в массив.
		// пишем до конца цикла, т.к. он считается до ДатаОкончанияДвижения
		Если ВыставленоДоДаты >= ДатаНач И ВыставленоДоДаты <= ДатаКон Тогда
			НачалоЗаписи = Истина;
		КонецЕсли;
		
		Если НачалоЗаписи Тогда
			СтруктураРезультата = Новый СТруктура;
			СтруктураРезультата.Вставить("ДатаНач",ДатаНач);
			СтруктураРезультата.Вставить("ДатаКон",ДатаКон);
			
			МассивСтруктур.Добавить(СтруктураРезультата);
			
		КонецЕсли;
	КонецЦикла;
		
	Возврат МассивСтруктур;

КонецФункции

Функция ПроверкаНаправления(УчДокумент)
	
	СтруктураОтвета = Новый Структура;
	Для Каждого СТр Из УчДокумент.РасшифровкаУслугПоТС Цикл
		// если в структуре уже есть какие-то записи, то проверить их совпадение. 
		// если не совпало, прекращаем цикл - в реализации разные направления
		Если СтруктураОтвета.Свойство("Отправление") Тогда
			Если НЕ СтруктураОтвета.Отправление = Стр.ПунктОтправления ИЛИ
				НЕ СтруктураОтвета.Назначение = Стр.ПунктНазначения Тогда
				// очищаем все из структуры
				СтруктураОтвета = Новый Структура;
				Прервать;
			КонецЕсли;
		Иначе
			СтруктураОтвета.Вставить("Отправление",Стр.ПунктОтправления);
			СтруктураОтвета.Вставить("Назначение",Стр.ПунктНазначения);
		КонецЕсли;
	КонецЦикла;

	Возврат СтруктураОтвета;
	
КонецФункции

