	|	НеДОвыставленныеВагоны.Контейнер КАК Контейнер
	|ПОМЕСТИТЬ Повагонка
	|ИЗ
	|	НеДОвыставленныеВагоны КАК НеДОвыставленныеВагоны
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПовагонныеОтправки КАК ПовагонныеОтправки
	|		ПО (ПовагонныеОтправки.Вагон = НеДОвыставленныеВагоны.НомерВагона)
	//Евросиб Каблов 03.11.2020 (
	|			И (ПовагонныеОтправки.Период = НеДОвыставленныеВагоны.Период)
	//Евросиб Каблов )
	|			И (ПовагонныеОтправки.ДатаОтправления = НеДОвыставленныеВагоны.ДатаОтправки)
	|ГДЕ
	|	(ЕСТЬNULL(НеДОвыставленныеВагоны.КоличествоДнейОборот, 0) = 0
	|			ИЛИ НЕ ЕСТЬNULL(НеДОвыставленныеВагоны.КоличествоДнейОборот, 0) = 0
	|				И (НЕ ПовагонныеОтправки.ДатаОтправленияСоСтанцииНазначения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|						И РАЗНОСТЬДАТ(ПовагонныеОтправки.ДатаОтправления, ПовагонныеОтправки.ДатаОтправленияСоСтанцииНазначения, ДЕНЬ) > НеДОвыставленныеВагоны.КоличествоДнейОборот
	|					ИЛИ НЕ ПовагонныеОтправки.ПереводВНРП = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|						И РАЗНОСТЬДАТ(ПовагонныеОтправки.ДатаОтправления, ПовагонныеОтправки.ПереводВНРП, ДЕНЬ) > НеДОвыставленныеВагоны.КоличествоДнейОборот
	|					ИЛИ НЕ ПовагонныеОтправки.ДатаОкончанияПользования = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|						И РАЗНОСТЬДАТ(ПовагонныеОтправки.ДатаОтправления, ПовагонныеОтправки.ДатаОкончанияПользования, ДЕНЬ) > НеДОвыставленныеВагоны.КоличествоДнейОборот
	|					ИЛИ ПовагонныеОтправки.ДатаОтправленияСоСтанцииНазначения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
