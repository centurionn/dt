Функция СоздатьСделку(ДатаОтправления, КвантВремени)
	
	НоваяСделка = Документы.Сделка.СоздатьДокумент();
	НоваяСделка.Заполнить(Неопределено);
	НоваяСделка.Дата = ТекущаяДата();
	НоваяСделка.ТипЗаказа = Справочники.ТипыЗаказов.ПовагоннаяОтправка;
	НоваяСделка.Автор = Пользователи.ТекущийПользователь();
	НоваяСделка.ЦФО = НоваяСделка.Автор.ЦФО;
	НоваяСделка.Создано = ТекущаяДата();
	НоваяСделка.Организация = Константы.ОсновнаяОрганизация.Получить();
	НоваяСделка.Маршрутизировать = Константы.МаршрутизироватьСделку.Получить();
	НоваяСделка.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	НоваяСделка.ПовагонныеОтправки = Истина;
	
	// поиск кванта времени
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Сделка.ДатаОкончанияПериодаПовагонки КАК ДатаОкончанияПериодаПовагонки
	               |ИЗ
	               |	Документ.Сделка КАК Сделка
	               |ГДЕ
	               |	НЕ Сделка.ДатаОкончанияПериодаПовагонки = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |	И НЕ Сделка.ДатаНачалаПериодаПовагонки = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |	И Сделка.ДатаОкончанияПериодаПовагонки < &ТекДатаОтпр
	               |	И НЕ Сделка.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаОкончанияПериодаПовагонки УБЫВ";
	Запрос.УстановитьПараметр("ТекДатаОтпр",ДатаОтправления);
	РЗ = Запрос.Выполнить();
	
	Если РЗ.Пустой() Тогда
		
		// если не нашли дат ранее текущей, то проверить, нет ли дат после нее
		Запрос2 = Новый Запрос;
		Запрос2.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		                |	Сделка.ДатаНачалаПериодаПовагонки КАК ДатаНачалаПериодаПовагонки
		                |ИЗ
		                |	Документ.Сделка КАК Сделка
		                |ГДЕ
		                |	НЕ Сделка.ДатаОкончанияПериодаПовагонки = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		                |	И НЕ Сделка.ДатаНачалаПериодаПовагонки = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		                |	И Сделка.ДатаНачалаПериодаПовагонки > &ТекДатаОтпр
		                |	И НЕ Сделка.ПометкаУдаления
		                |
		                |УПОРЯДОЧИТЬ ПО
		                |	Сделка.ДатаНачалаПериодаПовагонки";
		Запрос2.УстановитьПараметр("ТекДатаОтпр",ДатаОтправления);
		РЗ2 = Запрос2.Выполнить();
		
		// если и здесь пусто, то считаем эту дату начальной и от нее строим всю остальную цепочку
		Если РЗ2.Пустой() Тогда
			НоваяСделка.ДатаНачалаПериодаПовагонки = НачалоДня(ДатаОтправления);
			НоваяСделка.ДатаОкончанияПериодаПовагонки = КонецДня(ДатаОтправления + (КвантВремени-1)*3600*24);
			
		// если что-то нашли, то создаем сделку так, чтобы между найденной и текущей были равные кванту времени промежутки
		Иначе
			Ответ2 = Запрос2.Выполнить().Выбрать();
		
			Если Ответ2.Следующий() Тогда
				ДельтаДни = (Ответ2.ДатаНачалаПериодаПовагонки - ДатаОтправления)/3600/24;
				КолвоИнтервалов = Цел(ДельтаДни/КвантВремени);
				ВсегоДнейВИнтервалах = КолвоИнтервалов*КвантВремени;
				ОстатокПоДням = ДельтаДни - ВсегоДнейВИнтервалах;
				НачалоПервогоЗаИскомымПериода = Ответ2.ДатаНачалаПериодаПовагонки - ВсегоДнейВИнтервалах*3600*24;
				НачалоИскомогоПериода = НачалоПервогоЗаИскомымПериода - (КвантВремени-1)*3600*24;
				// вычитаем единицу, чтобы интервалы не пересекались
				КонецИскомогоПериода = НачалоПервогоЗаИскомымПериода - 1;
				
				НоваяСделка.ДатаНачалаПериодаПовагонки = НачалоДня(НачалоИскомогоПериода);
				НоваяСделка.ДатаОкончанияПериодаПовагонки = КонецДня(КонецИскомогоПериода);
			КонецЕсли;
		КонецЕсли;
		
	// если что-то нашли, то создаем сделку так, чтобы между найденной и текущей были равные кванту времени промежутки
	Иначе
		Ответ = Запрос.Выполнить().Выбрать();
		
		Если Ответ.Следующий() Тогда
			ДельтаДни = (ДатаОтправления - Ответ.ДатаОкончанияПериодаПовагонки)/3600/24;
			КолвоИнтервалов = Цел(ДельтаДни/КвантВремени);
			ВсегоДнейВИнтервалах = КолвоИнтервалов*КвантВремени;
			ОстатокПоДням = ДельтаДни - ВсегоДнейВИнтервалах;
			ОкончаниеПоследнегоПередИскомымПериода = Ответ.ДатаОкончанияПериодаПовагонки + ВсегоДнейВИнтервалах*3600*24;
			// добавляем единицу, чтобы интервалы не пересекались
			НачалоИскомогоПериода = ОкончаниеПоследнегоПередИскомымПериода + 1;
			КонецИскомогоПериода = НачалоИскомогоПериода + (КвантВремени-1)*3600*24;
			
			НоваяСделка.ДатаНачалаПериодаПовагонки = НачалоДня(НачалоИскомогоПериода);
			НоваяСделка.ДатаОкончанияПериодаПовагонки = КонецДня(КонецИскомогоПериода);
		КонецЕсли;
	КонецЕсли;
	
	Возврат НоваяСделка;
	
КонецФункции

Процедура ЗаполнениеСозданнойСделки(ПолучОб,ВыборкаДетальныеЗаписи,КвантВремени,МоментСозданияСделки,МассивСозданныхСделок)
	
	// если создаем сделку в режиме один вагон = одна сделка, то в реквизит СделкаДляВагона занесем номер вагона для того,
	// чтобы при подборе подходящих диапазонов сделок для други вагонов, не записывать в эту сделку ничего
	Если КвантВремени = 0 Тогда
		ПолучОб.СделкаДляВагона = ВыборкаДетальныеЗаписи.НомерВагона;
	КонецЕсли;

	
	// заполняем полученную сделку
	Заявка = ВыборкаДетальныеЗаписи.Заявка;
	
	ПолучОб.СтанцияОтправления = ?(НЕ ЗначениеЗаполнено(ПолучОб.СтанцияОтправления),ВыборкаДетальныеЗаписи.СтанцияОтправления,ПолучОб.СтанцияОтправления);
	ПолучОб.СтанцияНазначения = ?(НЕ ЗначениеЗаполнено(ПолучОб.СтанцияНазначения),ВыборкаДетальныеЗаписи.СтанцияНазначения,ПолучОб.СтанцияНазначения);
	ПолучОб.Подразделение = ?(НЕ ЗначениеЗаполнено(ПолучОб.Подразделение),Заявка.Подразделение,ПолучОб.Подразделение);
	
	// добавить рейс в сделку, проверив на уникальность
	ПараметрыОТбора = Новый Структура;
	ПараметрыОТбора.Вставить("Рейс",ВыборкаДетальныеЗаписи.РейсЖД);
	НайденныеРейсы = ПолучОб.Рейсы.НайтиСтроки(ПараметрыОТбора);
	Если НайденныеРейсы.Количество() = 0 Тогда
		ТЧРейсы = ПолучОб.Рейсы.Добавить();
		ТЧРейсы.Рейс = ВыборкаДетальныеЗаписи.РейсЖД;
	КонецЕсли;				
	// добавить заявку и калькуляцию в сделку, проверив на уникальность
	ПараметрыОТбора = Новый Структура;
	ПараметрыОТбора.Вставить("Заявка",Заявка);
	НайденныеРейсы = ПолучОб.Заявки.НайтиСтроки(ПараметрыОТбора);
	
	Если НайденныеРейсы.Количество() = 0 Тогда
		ТЧЗаявки = ПолучОб.Заявки.Добавить();
		ТЧЗаявки.Заявка = Заявка;
		ТЧЗаявки.Калькуляция = ВыборкаДетальныеЗаписи.Калькуляция;
	КонецЕсли;				

	// заполнить ТЧ СвязьУчетныхЕдиниц, проверив на уникальность.
	// !!!!! но если вагон есть, то проверить у него диапазон дат. если он совпадает, то ничего не меняем.
	// если не совпадает, то изменить даты диапазона
	ПарамОтб = Новый Структура;
	ПарамОтб.Вставить("Вагон",ВыборкаДетальныеЗаписи.НомерВагона);
	ПарамОтб.Вставить("ЖДН",ВыборкаДетальныеЗаписи.ЖДНакладная);
	ПарамОтб.Вставить("Контейнер",ВыборкаДетальныеЗаписи.Контейнер);
	НайденныйВаг = ПолучОб.СвязьУчетныхЕдиниц.НайтиСтроки(ПарамОтб);
	Для Каждого НВ ИЗ НайденныйВаг Цикл
		Если НЕ НВ.ДатаНачалаПериодаПовагонки = НачалоДня(ВыборкаДетальныеЗаписи.ДатаОтправления) Тогда
			Если НачалоДня(ВыборкаДетальныеЗаписи.ДатаОтправления) <= ПолучОб.ДатаНачалаПериодаПовагонки Тогда
				НВ.ДатаНачалаПериодаПовагонки = НачалоДня(ВыборкаДетальныеЗаписи.ДатаОтправления);
			КонецЕсли;
		КонецЕсли;
		Если НЕ НВ.ДатаОкончанияПериодаПовагонки = КонецДня(ВыборкаДетальныеЗаписи.ОкончаниеПосуточногоДиапазона) Тогда
			Если КонецДня(ВыборкаДетальныеЗаписи.ОкончаниеПосуточногоДиапазона) >= НВ.ДатаОкончанияПериодаПовагонки Тогда
				НВ.ДатаОкончанияПериодаПовагонки = КонецДня(ВыборкаДетальныеЗаписи.ОкончаниеПосуточногоДиапазона);
			КонецЕсли;
		КонецЕсли;
		НВ.ДатаОтправки = ВыборкаДетальныеЗаписи.ДатаОтправленияДляРегистра;
	КонецЦикла;
	Если НайденныйВаг.Количество() = 0 Тогда
		НСтр = ПолучОб.СвязьУчетныхЕдиниц.Добавить();
		//Евросиб Каблов 14.10.2020
		нСтр.ГотовоКВыставлению = Истина;
		//Субботин 72190 30.06.2023
		нСтр.ВидТранспортногоСообщения = Перечисления.ВидыТранспортныхСообщений.ЖД;
		//Субботин 72190 30.06.2023
		НСтр.Заявка = Заявка;
		НСтр.ГУИДСтрокиЗаявки = ВыборкаДетальныеЗаписи.ГУИДСтрокиЗаявки;
		НСтр.Клиент = ВыборкаДетальныеЗаписи.Клиент;
		НСтр.Договор = ВыборкаДетальныеЗаписи.Договор;
		НСтр.Груз = ВыборкаДетальныеЗаписи.Груз;
		Если Не ЗначениеЗаполнено(НСтр.Груз) Тогда
			НСтр.Груз = ВыборкаДетальныеЗаписи.ГрузИзНакладной;
		КонецЕсли;
		НСтр.Калькуляция = ВыборкаДетальныеЗаписи.Калькуляция;
		//Евросиб Каблов 28.06.2021 ( Ticket#0230281
		НСтр.Протокол = ВыборкаДетальныеЗаписи.ПСЦ;
		//Евросиб Каблов 28.06.2021 ) 
		НСтр.Вагон = ВыборкаДетальныеЗаписи.НомерВагона;
		НСтр.ДатаНачалаПериодаПовагонки = ?(ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.НачалоПосуточногоДиапазона),ВыборкаДетальныеЗаписи.НачалоПосуточногоДиапазона,ПолучОб.ДатаНачалаПериодаПовагонки);
		НСтр.ДатаОкончанияПериодаПовагонки = ?(ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ОкончаниеПосуточногоДиапазона),ВыборкаДетальныеЗаписи.ОкончаниеПосуточногоДиапазона,ПолучОб.ДатаОкончанияПериодаПовагонки);
		НСтр.ДатаОтправки = ВыборкаДетальныеЗаписи.ДатаОтправленияДляРегистра;
		//НСтр.ЖДН = ПолучитьЖДН(ВыборкаДетальныеЗаписи);
		НСтр.ЖДН = ВыборкаДетальныеЗаписи.ЖДНакладная;
		НСтр.НомерЖДН = ВыборкаДетальныеЗаписи.НомерЖДН;
		НСтр.Контейнер = ВыборкаДетальныеЗаписи.Контейнер;
		НСтр.Груженый = Истина;
		//НСтр.НомерВагоннойЖДН = РаботаСоСделкамиСервер.НайтиПодсылПорожнегоВагонаПоЭТРАН(
		//										ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыборкаДетальныеЗаписи.НомерВагона, "Наименование"),
		//										ВыборкаДетальныеЗаписи.ДатаОтправления, 
		//										ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыборкаДетальныеЗаписи.СтанцияОтправления,"КодЖДСтанции"),
		//										40);
		СтруктураВагоннаяЖДН = РаботаСоСделкамиСервер.НайтиПодсылПорожнегоВагонаПоЭТРАН(
												ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыборкаДетальныеЗаписи.НомерВагона, "Наименование"),
												ВыборкаДетальныеЗаписи.ДатаОтправления, 
												ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыборкаДетальныеЗаписи.СтанцияОтправления,"КодЖДСтанции"),
												40);
		нСтр.НомерВагоннойЖДН = СтруктураВагоннаяЖДН.НакладнаяПодсылаВагона;
		Если ЗначениеЗаполнено(СтруктураВагоннаяЖДН.НакладнаяПодсылаВагонаСсылка) Тогда
			нСтр.ВагоннаяЖДН = РаботаСоСделкамиСервер.ПолучитьТДПоНакладнойЭтран(СтруктураВагоннаяЖДН.НакладнаяПодсылаВагонаСсылка);
		КонецЕсли;
		НСтр.ГУИД = Новый УникальныйИдентификатор;
		
	КонецЕсли;
	
	Если МоментСозданияСделки = 3 Тогда
		Попытка
			ПолучОб.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			//ПолучОб.Записать(РежимЗаписиДокумента.Запись);
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
		КонецПопытки;
		
		СохраненннаяСделкаОбъект = ПолучОб.Ссылка.ПолучитьОбъект();
		//Евросиб Каблов 14.10.2020
		//доходы_ЗаполнитьПоЗаявкам2(СохраненннаяСделкаОбъект,МоментСозданияСделки);
		//ПолучОб.ДополнитьЭкономикуДаннымиПодсыловПоЖДН();

		//Попытка
		//	СохраненннаяСделкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
		//Исключение
		//	СохраненннаяСделкаОбъект.Записать(РежимЗаписиДокумента.Запись);
		//КонецПопытки;
		//Евросиб Каблов 14.10.2020 )
		МассивСозданныхСделок.Добавить(СохраненннаяСделкаОбъект);
		ЗаписатьСделкуВРегистр(СохраненннаяСделкаОбъект.Ссылка,НСтр.Вагон);
		
	КонецЕсли;
	
				
КонецПроцедуры

Функция ПолучитьЖДН(ПараметрыПоиска)
	
	ЖДН = Неопределено;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТранспортныйДокумент.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.э_Накладная.Вагоны КАК э_НакладнаяВагоны
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	|		ПО э_НакладнаяВагоны.Ссылка = ТранспортныйДокумент.НакладнаяЭТРАН
	|ГДЕ
	|	э_НакладнаяВагоны.НомерВагона = &НомерВагона
	|	И ТранспортныйДокумент.Ссылка.СтанцияНазначения = &СтанцияНазначения
	|	И ТранспортныйДокумент.Ссылка.СтанцияОтправления = &СтанцияОтправления
	|	И НАЧАЛОПЕРИОДА(ТранспортныйДокумент.ДатаОтправления, ДЕНЬ) МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаОтправления, ДЕНЬ, -3) И &ДатаОтправления
	|	И (э_НакладнаяВагоны.Ссылка.ТекущееСостояниеНакладнойДействующийСтатус
	|			ИЛИ э_НакладнаяВагоны.Ссылка.ИсточникНакладной = ЗНАЧЕНИЕ(Перечисление.ИсточникЖДН.ГВЦ))";
	Запрос.УстановитьПараметр("НомерВагона", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыПоиска.НомерВагона, "Наименование"));
	//Запрос.УстановитьПараметр("СтанцияНазначения", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыПоиска.СтанцияНазначения, "КодЖДСтанции"));
	//Запрос.УстановитьПараметр("СтанцияОтправления", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыПоиска.СтанцияОтправления, "КодЖДСтанции"));
	Запрос.УстановитьПараметр("СтанцияНазначения", ПараметрыПоиска.СтанцияНазначения);
	Запрос.УстановитьПараметр("СтанцияОтправления", ПараметрыПоиска.СтанцияОтправления);
	Запрос.УстановитьПараметр("ДатаОтправления", ПараметрыПоиска.ДатаОтправленияДляРегистра);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ЖДН = РезультатЗапроса.Выгрузить()[0].Ссылка; 
	КонецЕсли; 
	Возврат ЖДН;
	
КонецФункции
 
	
Функция ЗапросНаВыборкуСделок(ТЗ)
	// проверяем, есть ли в системе сделки, созданные на этот период.
	// у таких сделок не долже быть заполнен реквизит СделкаДляВагона, т.к. его заполненность означает, 
	// что данная сделка создана в режиме один вагон = одна сделка и добавлять в нее больше ничего нельзя. 
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВремТЧ.НомерВагона КАК НомерВагона,
		|	ВремТЧ.Клиент КАК Клиент,
		|	ВремТЧ.Договор КАК Договор,
		|	ВремТЧ.СтанцияОтправления КАК СтанцияОтправления,
		|	ВремТЧ.Заявка КАК Заявка,
		|	ВремТЧ.СтанцияНазначения КАК СтанцияНазначения,
		|	ВремТЧ.ПСЦ КАК ПСЦ,
		|	ВремТЧ.Груз КАК Груз,
		|	ВремТЧ.ДатаОтправления КАК ДатаОтправления,
		|	ВремТЧ.Калькуляция КАК Калькуляция,
		|	ВремТЧ.ДатаОкончанияДвижения КАК ДатаОкончанияДвижения,
		|	ВремТЧ.ВагонВПути КАК ВагонВПути,
		|	ВремТЧ.НачалоПосуточногоДиапазона КАК НачалоПосуточногоДиапазона,
		|	ВремТЧ.ОкончаниеПосуточногоДиапазона КАК ОкончаниеПосуточногоДиапазона,
		|	ВремТЧ.ПосуточнаяОплата КАК ПосуточнаяОплата,
		|	ВремТЧ.НДС КАК НДС,
		|	ВремТЧ.Контейнер КАК Контейнер,
		|	ВремТЧ.ЖДНакладная КАК ЖДНакладная
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ВремТЧ КАК ВремТЧ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВагоныВОтправке.Отправка КАК Отправка,
		|	ЗаявкаПереченьРейсов.Ссылка КАК Ссылка,
		|	ВагоныВОтправке.Вагон КАК Вагон
		|ПОМЕСТИТЬ РейсыВЗаявке
		|ИЗ
		|	Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВагоныВОтправке КАК ВагоныВОтправке
		|		ПО ЗаявкаПереченьРейсов.Рейс = ВагоныВОтправке.Отправка
		|ГДЕ
		|	ЗаявкаПереченьРейсов.Ссылка В
		|			(ВЫБРАТЬ
		|				ВТ.Заявка
		|			ИЗ
		|				ВТ КАК ВТ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.НомерВагона КАК НомерВагона,
		|	ВТ.Клиент КАК Клиент,
		|	ВТ.Договор КАК Договор,
		|	ВТ.СтанцияОтправления КАК СтанцияОтправления,
		|	ВТ.Заявка КАК Заявка,
		|	ВТ.СтанцияНазначения КАК СтанцияНазначения,
		|	ВТ.ПСЦ КАК ПСЦ,
		|	ВТ.Груз КАК Груз,
		|	ВТ.ДатаОтправления КАК ДатаОтправления,
		|	ВТ.Калькуляция КАК Калькуляция,
		|	ВТ.НДС КАК НДС,
		|	РейсыВЗаявке.Отправка КАК РейсЖД,
		|	РейсыВЗаявке.Ссылка КАК РейсСсылка,
		|	ВТ.ДатаОкончанияДвижения КАК ДатаОкончанияДвижения,
		|	ВТ.НачалоПосуточногоДиапазона КАК НачалоПосуточногоДиапазона,
		|	ВТ.ОкончаниеПосуточногоДиапазона КАК ОкончаниеПосуточногоДиапазона,
		|	ВТ.ПосуточнаяОплата КАК ПосуточнаяОплата,
		|	ВТ.ЖДНакладная КАК ЖДНакладная,
		|	ВТ.Контейнер КАК Контейнер
		|ПОМЕСТИТЬ РейсыВТ
		|ИЗ
		|	ВТ КАК ВТ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РейсыВЗаявке КАК РейсыВЗаявке
		|		ПО ВТ.НомерВагона = РейсыВЗаявке.Вагон
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РейсыВТ.НомерВагона КАК НомерВагона,
		|	МАКСИМУМ(Сделка.Ссылка) КАК Сделка
		|ПОМЕСТИТЬ ВозможныеСделки
		|ИЗ
		|	РейсыВТ КАК РейсыВТ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.Рейсы КАК Сделка
		|		ПО РейсыВТ.РейсСсылка = Сделка.Рейс
		|ГДЕ
		|	НЕ Сделка.Ссылка.ДатаНачалаПериодаПовагонки = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|	И НЕ Сделка.Ссылка.ДатаОкончанияПериодаПовагонки = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|	И НЕ Сделка.Ссылка.ПометкаУдаления
		|	И НЕ РейсыВТ.ПосуточнаяОплата
		|	И Сделка.Ссылка.СделкаДляВагона = ЗНАЧЕНИЕ(Справочник.ТС.ПустаяССылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	РейсыВТ.НомерВагона
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РейсыВТ.НомерВагона КАК НомерВагона,
		|	МАКСИМУМ(Сделка.Ссылка) КАК Сделка,
		|	РейсыВТ.НачалоПосуточногоДиапазона КАК НачалоПосуточногоДиапазона,
		|	РейсыВТ.ОкончаниеПосуточногоДиапазона КАК ОкончаниеПосуточногоДиапазона
		|ПОМЕСТИТЬ ВозможныеСделкиПосуточные
		|ИЗ
		|	РейсыВТ КАК РейсыВТ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделка
		|		ПО (НАЧАЛОПЕРИОДА(РейсыВТ.НачалоПосуточногоДиапазона, ДЕНЬ) МЕЖДУ НАЧАЛОПЕРИОДА(Сделка.ДатаНачалаПериодаПовагонки, ДЕНЬ) И КОНЕЦПЕРИОДА(Сделка.ДатаОкончанияПериодаПовагонки, ДЕНЬ))
		|			И (НАЧАЛОПЕРИОДА(РейсыВТ.ОкончаниеПосуточногоДиапазона, ДЕНЬ) МЕЖДУ НАЧАЛОПЕРИОДА(Сделка.ДатаНачалаПериодаПовагонки, ДЕНЬ) И КОНЕЦПЕРИОДА(Сделка.ДатаОкончанияПериодаПовагонки, ДЕНЬ))
		|ГДЕ
		|	НЕ Сделка.ДатаНачалаПериодаПовагонки = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|	И НЕ Сделка.ДатаОкончанияПериодаПовагонки = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|	И НЕ Сделка.ПометкаУдаления
		|	И РейсыВТ.ПосуточнаяОплата
		|	И Сделка.СделкаДляВагона = ЗНАЧЕНИЕ(Справочник.ТС.ПустаяССылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	РейсыВТ.НомерВагона,
		|	РейсыВТ.НачалоПосуточногоДиапазона,
		|	РейсыВТ.ОкончаниеПосуточногоДиапазона
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РейсыВТ.НомерВагона КАК НомерВагона,
		|	РейсыВТ.Клиент КАК Клиент,
		|	РейсыВТ.Договор КАК Договор,
		|	РейсыВТ.СтанцияОтправления КАК СтанцияОтправления,
		|	РейсыВТ.Заявка КАК Заявка,
		|	РейсыВТ.СтанцияНазначения КАК СтанцияНазначения,
		|	РейсыВТ.ПСЦ КАК ПСЦ,
		|	РейсыВТ.Груз КАК Груз,
		|	РейсыВТ.ДатаОтправления КАК ДатаОтправления,
		|	РейсыВТ.Калькуляция КАК Калькуляция,
		|	РейсыВТ.НДС КАК НДС,
		|	РейсыВТ.РейсЖД КАК РейсЖД,
		|	ВозможныеСделки.Сделка КАК Сделка,
		|	РейсыВТ.ДатаОкончанияДвижения КАК ДатаОкончанияДвижения,
		|	РейсыВТ.НачалоПосуточногоДиапазона КАК НачалоПосуточногоДиапазона,
		|	РейсыВТ.ОкончаниеПосуточногоДиапазона КАК ОкончаниеПосуточногоДиапазона,
		|	РейсыВТ.ПосуточнаяОплата КАК ПосуточнаяОплата,
		|	РейсыВТ.ДатаОтправления КАК ДатаОтправленияДляРегистра,
		|	РейсыВТ.ЖДНакладная КАК ЖДНакладная,
		|	РейсыВТ.Контейнер КАК Контейнер
		|ИЗ
		|	РейсыВТ КАК РейсыВТ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВозможныеСделки КАК ВозможныеСделки
		|		ПО РейсыВТ.НомерВагона = ВозможныеСделки.НомерВагона
		|ГДЕ
		|	НЕ РейсыВТ.ПосуточнаяОплата
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РейсыВТ.НомерВагона,
		|	РейсыВТ.Клиент,
		|	РейсыВТ.Договор,
		|	РейсыВТ.СтанцияОтправления,
		|	РейсыВТ.Заявка,
		|	РейсыВТ.СтанцияНазначения,
		|	РейсыВТ.ПСЦ,
		|	РейсыВТ.Груз,
		|	РейсыВТ.НачалоПосуточногоДиапазона,
		|	РейсыВТ.Калькуляция,
		|	РейсыВТ.НДС,
		|	РейсыВТ.РейсЖД,
		|	ВозможныеСделкиПосуточные.Сделка,
		|	РейсыВТ.ДатаОкончанияДвижения,
		|	РейсыВТ.НачалоПосуточногоДиапазона,
		|	РейсыВТ.ОкончаниеПосуточногоДиапазона,
		|	РейсыВТ.ПосуточнаяОплата,
		|	РейсыВТ.ДатаОтправления,
		|	РейсыВТ.ЖДНакладная,
		|	РейсыВТ.Контейнер
		|ИЗ
		|	РейсыВТ КАК РейсыВТ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВозможныеСделкиПосуточные КАК ВозможныеСделкиПосуточные
		|		ПО РейсыВТ.НомерВагона = ВозможныеСделкиПосуточные.НомерВагона
		|			И РейсыВТ.НачалоПосуточногоДиапазона = ВозможныеСделкиПосуточные.НачалоПосуточногоДиапазона
		|			И РейсыВТ.ОкончаниеПосуточногоДиапазона = ВозможныеСделкиПосуточные.ОкончаниеПосуточногоДиапазона
		|ГДЕ
		|	РейсыВТ.ПосуточнаяОплата
		|ИТОГИ ПО
		|	Сделка,
		|	ДатаОтправления";
	
	Запрос.УстановитьПараметр("ВремТЧ",ТЗ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса;
	
КонецФункции

Процедура ДополнитьИнтерваламиТаблицу(ТЗ,НачальнаяДатаДиапазонов,КвантВремени)
	// создадим копию таблицы ТЗ (только колонки, данные не нужны), для того, чтобы в нее добавить новые строки - 
	// это будут вагоны в посуточном режиме с другими периодами.
	ТЗ_Копия = ТЗ.СкопироватьКолонки();
	
	Для Каждого Стр ИЗ ТЗ Цикл
		
		// т.к. вагоны могут быть рассчитаны посуточно, то нужно разбить посуточный 
		// вагон на периоды сделки и добавить нужное количество строк
		Если Стр.ПосуточнаяОплата Тогда
			// проверяем, есть ли уже выставленные дни
			Если ЗначениеЗаполнено(Стр.КоличествоДнейОборот) И
				Стр.КоличествоДнейОборот>0 Тогда
				// если да, то проверить, какой промежуток времени они покрывают
				ВыставленоДоДаты = Стр.ДатаОтправления + Стр.КоличествоДнейОборот*3600*24;
			Иначе
				ВыставленоДоДаты = Стр.ДатаОтправления;
			КонецЕсли;
			// надо проверить по квантам сделки, 
			// есть ли возможность записать вагон в сделку так, чтобы ее даты начала и окончания повагонки 
			// покрывали период от ВыставленоДоДаты до ДатаОкончанияДвижения.
			СтруктураОтвета = ПолучитьДиапазоныДатПоСделкам(ВыставленоДоДаты,КонецДня(Стр.ДатаОкончанияДвижения),КвантВремени,НачальнаяДатаДиапазонов,Стр.ВагонВПути);
			
			// по количеству элементов массива добавляем во временную таблицу строки для вагона
			Для Каждого Эл Из СтруктураОтвета Цикл
				НовСтр = ТЗ_Копия.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр,Стр);
				НовСтр.НачалоПосуточногоДиапазона = Эл.ДатаНач;
				НовСтр.ОкончаниеПосуточногоДиапазона = Эл.ДатаКон;
				НовСтр.Изменена = Истина;
			КонецЦикла;
		КонецЕсли;
			
	КонецЦикла;
	
	// вносим все данные из ТЗ_Копия в основную ТЗ, при этом первую строку таблицы нужно не добавить, а
	// изменить ею существующую
	Для Каждого Стр Из ТЗ_Копия Цикл
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("НомерВагона",Стр.НомерВагона);
		ПараметрыОтбора.Вставить("ДатаОтправления",Стр.ДатаОтправления);
		ПараметрыОтбора.Вставить("Контейнер", Стр.Контейнер);
		ПараметрыОтбора.Вставить("ЖДНакладная", Стр.ЖДНакладная);
		ПараметрыОтбора.Вставить("Изменена",Ложь);
		НайденныеСтр = ТЗ.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтр.Количество()>0 Тогда
			НайденныеСтр[0].НачалоПосуточногоДиапазона = Стр.НачалоПосуточногоДиапазона;
			НайденныеСтр[0].ОкончаниеПосуточногоДиапазона = Стр.ОкончаниеПосуточногоДиапазона;
			НайденныеСтр[0].Изменена = Истина;
		Иначе
			НовСтр = ТЗ.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр,Стр);
		КонецЕсли;
		
	КонецЦикла;
	
	ТЗ.Сортировать("НомерВагона,ДатаОтправления,НачалоПосуточногоДиапазона");
	
КонецПроцедуры

Процедура ПроверкаКалькуляцийНаСоответствие(ТЗ)
	// для каждой строки проверить наличие калькуляции. если ни одна калькуляция не подошла, 
	// то очистить ПСЦ в регистре и не учитывать такие строки при  создании сделки.
	// в запросе без цикл это сделать не удалось из-за необходимости проверок в ИЕРАРХИИ
	
	Для Каждого Стр Из ТЗ Цикл
		
		// проверять нужно только те строки, у которых не заполнена калькуляция или заполнена, но не подходящая
		Если ЗначениеЗаполнено(Стр.Калькуляция) И НЕ Стр.КалькуляцияНеПодходит Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыЗапроса = Новый СТруктура;
		ПараметрыЗапроса.Вставить("ПунктОтправления",Стр.СтанцияОтправления);
		ПараметрыЗапроса.Вставить("ПунктНазначения",Стр.СтанцияНазначения);
		ПараметрыЗапроса.Вставить("НДС",Стр.НДС);
		ПараметрыЗапроса.Вставить("ТипТС",Стр.ТипТС);
	
		СписокКальк = Новый СписокЗначений;
		СписокКальк.ЗагрузитьЗначения(ПолучитьСписокПодходящихКалькуляций(ПараметрыЗапроса));
		
		Если СписокКальк.Количество() = 0 Тогда
			Стр.Калькуляция = Документы.Калькуляция.ПустаяСсылка();
			
			ТекЗапись = РегистрыСведений.ПовагонныеОтправки.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(ТекЗапись,Стр);
			ТекЗапись2 = РегистрыСведений.ПовагонныеОтправки.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(ТекЗапись2, ТекЗапись);
			
			ТекЗапись.Прочитать();
			Если НЕ ТекЗапись.Выбран() Тогда
				ЗаполнитьЗначенияСвойств(ТекЗапись, ТекЗапись2);
			КонецЕсли;
			
			ТекЗапись.ПСЦ = Документы.ПСЦ.ПустаяСсылка();
			ТекЗапись.Калькуляция = Документы.Калькуляция.ПустаяСсылка();
			
			ТекЗапись.Записать();
			
		Иначе
			// калькуляцию нужно записать в регистр, но сейчас этого делать не будем - запишем вместе со сделкой.
			//ТЗ.Калькуляция = СписокКальк.Получить(0).Значение;
			Стр.Калькуляция = СписокКальк.Получить(0).Значение;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция НачальнаяДатаДиапазоновСделки(ТЗ)
	
	// если в системе пока нет ни одной повагонной сделки (т.е. такой, у которой заполнены реквизиты с 
	// датами повагонки), то нужно выбрать в данном запросе самую раннюю дату отправки и сохранить ее
	// в переменную для вычисления квантов времени для посуточной оплаты. если сделки по повагонке есть,
	// то взять самую раннюю дату, а от нее отсчитать интервалы
	НачальнаяДатаДиапазонов = Неопределено;	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Сделка.ДатаНачалаПериодаПовагонки КАК ДатаНачалаПериодаПовагонки
	               |ИЗ
	               |	Документ.Сделка КАК Сделка
	               |ГДЕ
	               |	НЕ Сделка.ДатаНачалаПериодаПовагонки = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |	И НЕ Сделка.ДатаОкончанияПериодаПовагонки = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |	И НЕ Сделка.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаНачалаПериодаПовагонки";
	Если Запрос.Выполнить().Пустой() Тогда
		ТЗ.Сортировать("ДатаОтправления");
		НачальнаяДатаДиапазонов = НачалоДня(ТЗ[0].ДатаОтправления);
	Иначе
		Ответ = Запрос.Выполнить().Выбрать();
		Если Ответ.Следующий() Тогда
			НачальнаяДатаДиапазонов = НачалоДня(Ответ.ДатаНачалаПериодаПовагонки);
		КонецЕсли;
	КонецЕсли;
	
	Возврат НачальнаяДатаДиапазонов;
	
КонецФункции

Функция ЗапросПоискаВагоновДляСделок(МассивСтруктур)
	
	ТблВагонов = Новый ТаблицаЗначений;
	ТблВагонов.Колонки.Добавить("ДатаПомещенияВРежимПовагонки",Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТблВагонов.Колонки.Добавить("НомерВагона",Новый ОписаниеТипов("СправочникСсылка.ТС"));
	ТблВагонов.Колонки.Добавить("ДатаОтправления",Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТблВагонов.Колонки.Добавить("ЖДНакладная", Новый ОписаниеТипов("ДокументСсылка.ТранспортныйДокумент"));
	ТблВагонов.Колонки.Добавить("Контейнер", Новый ОписаниеТипов("СправочникСсылка.ТЕ"));	
	                                                                                 
	Для Каждого Эл Из МассивСтруктур Цикл
		НовСтр = ТблВагонов.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,Эл);
	КонецЦикла;
	
	// делаем запрос по регистру ПовагонныеОтправки и ДислокацияВагонов, чтобы получить для
	// каждого вагона его отправку со станции отправления.
	// интересуют только те вагоны, которые:
	// 1. находятся в повагонке
	// 2. не заполнена сделка ИЛИ заполнена, но вариант оплаты вагона - ПОСУТОЧНО или ОбщаяПоКоличествуДнейИСНП 
	//							и на либо у него не заполнены даты отправки со станции назначения или окочания пользования
	//								либо даты заполнены, но по колву выставленных дней сделок не хватает
	// 3. есть подходящая по рейсу заявка
	// 
	
	// из регистра ВыставлениеПосуточнойАренды выбираем только те записи, регистратором которых является 
	// сделка, т.к. нам нужно выяснить, на какое количество дней уже есть документы
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВремТЧ.НомерВагона КАК НомерВагона,
	|	ВремТЧ.ДатаПомещенияВРежимПовагонки КАК Период,
	|	ВремТЧ.ДатаОтправления КАК ДатаОтправления,
	|	ВремТЧ.Контейнер КАК Контейнер,
	|	ВремТЧ.ЖДНакладная КАК ЖДНакладная
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&ВремТЧ КАК ВремТЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	//|	СУММА(ЕСТЬNULL(ВыставлениеПосуточнойАрендыОбороты.КоличествоДнейОборот, 0)) КАК КоличествоДнейОборот,
	|	0 КАК КоличествоДнейОборот,
	|	ВТ.НомерВагона КАК НомерВагона,
	|	ВТ.ДатаОтправления КАК ДатаОтправки,
	|	ВТ.ЖДНакладная КАК ЖДНакладная,
	|	ВТ.Контейнер КАК Контейнер,
	|	ВТ.Период КАК Период
	|ПОМЕСТИТЬ НеДОвыставленныеВагоны
	|ИЗ
	|	ВТ КАК ВТ
	//|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВыставлениеПосуточнойАренды.Обороты(, , Регистратор, ) КАК ВыставлениеПосуточнойАрендыОбороты
	//|		ПО ВТ.НомерВагона = ВыставлениеПосуточнойАрендыОбороты.НомерВагона
	//|			И ВТ.ДатаОтправления = ВыставлениеПосуточнойАрендыОбороты.Период
	//|			И (ВыставлениеПосуточнойАрендыОбороты.Регистратор ССЫЛКА Документ.Сделка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.НомерВагона,
	|	ВТ.ДатаОтправления,
	|	ВТ.ЖДНакладная,
