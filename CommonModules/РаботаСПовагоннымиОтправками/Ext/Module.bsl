	|	Итоговая.ПризнакСобственности КАК ПризнакСобственности,
	|	Итоговая.ЖДНакладная КАК ЖДНакладная,
	|	Итоговая.Контейнер КАК Контейнер
	|ИЗ
	|	Итоговая КАК Итоговая
	|ГДЕ
	|	НЕ Итоговая.ДатаОтправления = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)";
	
	Запрос.УстановитьПараметр("ТекДата",ТекущаяДата());
	Запрос.УстановитьПараметр("ВремТЧ",ТблВагонов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса;
	
КонецФункции

Функция СоздатьКвантВремениИСделку(ДатаОтправления,КвантВремени)
	
	НоваяСделка = Документы.Сделка.СоздатьДокумент();
	НоваяСделка.Заполнить(Неопределено);
	НоваяСделка.Дата = ТекущаяДата();
	НоваяСделка.ТипЗаказа = Справочники.ТипыЗаказов.ПовагоннаяОтправка;
	НоваяСделка.Автор = Пользователи.ТекущийПользователь();
	НоваяСделка.ЦФО = НоваяСделка.Автор.ЦФО;
	НоваяСделка.Создано = ТекущаяДата();
	НоваяСделка.Организация = Константы.ОсновнаяОрганизация.Получить();
	НоваяСделка.Маршрутизировать = Константы.МаршрутизироватьСделку.Получить();
	НоваяСделка.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	НоваяСделка.ПовагонныеОтправки = Истина;
	
	// поиск кванта времени
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Сделка.ДатаОкончанияПериодаПовагонки КАК ДатаОкончанияПериодаПовагонки
	               |ИЗ
	               |	Документ.Сделка КАК Сделка
	               |ГДЕ
	               |	НЕ Сделка.ДатаОкончанияПериодаПовагонки = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |	И НЕ Сделка.ДатаНачалаПериодаПовагонки = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |	И Сделка.ДатаОкончанияПериодаПовагонки < &ТекДатаОтпр
	               |	И НЕ Сделка.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаОкончанияПериодаПовагонки УБЫВ";
	Запрос.УстановитьПараметр("ТекДатаОтпр",ДатаОтправления);
	РЗ = Запрос.Выполнить();
	
	Если РЗ.Пустой() Тогда
		
		// если не нашли дат ранее текущей, то проверить, нет ли дат после нее
		Запрос2 = Новый Запрос;
		Запрос2.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		                |	Сделка.ДатаНачалаПериодаПовагонки КАК ДатаНачалаПериодаПовагонки
		                |ИЗ
		                |	Документ.Сделка КАК Сделка
		                |ГДЕ
		                |	НЕ Сделка.ДатаОкончанияПериодаПовагонки = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		                |	И НЕ Сделка.ДатаНачалаПериодаПовагонки = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		                |	И Сделка.ДатаНачалаПериодаПовагонки > &ТекДатаОтпр
		                |	И НЕ Сделка.ПометкаУдаления
		                |
		                |УПОРЯДОЧИТЬ ПО
		                |	Сделка.ДатаНачалаПериодаПовагонки";
		Запрос2.УстановитьПараметр("ТекДатаОтпр",ДатаОтправления);
		РЗ2 = Запрос2.Выполнить();
		
		// если и здесь пусто, то считаем эту дату начальной и от нее строим всю остальную цепочку
		Если РЗ2.Пустой() Тогда
			НоваяСделка.ДатаНачалаПериодаПовагонки = НачалоДня(ДатаОтправления);
			НоваяСделка.ДатаОкончанияПериодаПовагонки = КонецДня(ДатаОтправления + (КвантВремени-1)*3600*24);
			
		// если что-то нашли, то создаем сделку так, чтобы между найденной и текущей были равные кванту времени промежутки
		Иначе
			Ответ2 = Запрос2.Выполнить().Выбрать();
		
			Если Ответ2.Следующий() Тогда
				ДельтаДни = (Ответ2.ДатаНачалаПериодаПовагонки - ДатаОтправления)/3600/24;
				КолвоИнтервалов = Цел(ДельтаДни/КвантВремени);
				ВсегоДнейВИнтервалах = КолвоИнтервалов*КвантВремени;
				ОстатокПоДням = ДельтаДни - ВсегоДнейВИнтервалах;
				НачалоПервогоЗаИскомымПериода = Ответ2.ДатаНачалаПериодаПовагонки - ВсегоДнейВИнтервалах*3600*24;
				НачалоИскомогоПериода = НачалоПервогоЗаИскомымПериода - (КвантВремени-1)*3600*24;
				// вычитаем единицу, чтобы интервалы не пересекались
				КонецИскомогоПериода = НачалоПервогоЗаИскомымПериода - 1;
				
				НоваяСделка.ДатаНачалаПериодаПовагонки = НачалоДня(НачалоИскомогоПериода);
				НоваяСделка.ДатаОкончанияПериодаПовагонки = КонецДня(КонецИскомогоПериода);
			КонецЕсли;
		КонецЕсли;
		
	// если что-то нашли, то создаем сделку так, чтобы между найденной и текущей были равные кванту времени промежутки
	Иначе
		Ответ = Запрос.Выполнить().Выбрать();
		
		Если Ответ.Следующий() Тогда
			ДельтаДни = (ДатаОтправления - Ответ.ДатаОкончанияПериодаПовагонки)/3600/24;
			КолвоИнтервалов = Цел(ДельтаДни/КвантВремени);
			ВсегоДнейВИнтервалах = КолвоИнтервалов*КвантВремени;
			ОстатокПоДням = ДельтаДни - ВсегоДнейВИнтервалах;
			ОкончаниеПоследнегоПередИскомымПериода = Ответ.ДатаОкончанияПериодаПовагонки + ВсегоДнейВИнтервалах*3600*24;
			// добавляем единицу, чтобы интервалы не пересекались
			НачалоИскомогоПериода = ОкончаниеПоследнегоПередИскомымПериода + 1;
			КонецИскомогоПериода = НачалоИскомогоПериода + (КвантВремени-1)*3600*24;
			
			НоваяСделка.ДатаНачалаПериодаПовагонки = НачалоДня(НачалоИскомогоПериода);
			НоваяСделка.ДатаОкончанияПериодаПовагонки = КонецДня(КонецИскомогоПериода);
		КонецЕсли;
	КонецЕсли;
	
	Возврат НоваяСделка;
	
КонецФункции

Процедура доходы_ЗаполнитьПоЗаявкам2(НоваяСделка,МоментСозданияСделки)ЭКСПОРТ
	
	//Евросиб Каблов 09.04.2025 ( #105407
	//ГлобальныйОткрытыйПериод = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериод(НоваяСделка.Организация);
	ГлобальныйОткрытыйПериод = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериодДоходов(НоваяСделка.Организация);
	//Евросиб Каблов 09.04.2025 )
	
	РезультатЗапроса = ЗапросЭкономики(НоваяСделка);
	
	ТЗ = РезультатЗапроса.Выгрузить();
	
	МассивТиповЗнач = Новый Массив;
	МассивТиповЗнач.Добавить(Тип("ДокументСсылка.РеализацияТоваровУслуг"));
	МассивТиповЗнач.Добавить(Тип("ДокументСсылка.ОтчетКомитентуОПродажах"));
	ДопустимыеТипыЗнач = Новый ОписаниеТипов(МассивТиповЗнач);
	
	ТЗ.Колонки.Добавить("УчДокумент",ДопустимыеТипыЗнач);
	
	УслугаДляПовагонки = Константы.УслугаДляПовагоннойЗаявки.Получить();
	УслугаСНП = Константы.УслугаСНППоВагону.Получить();
	// в массив будем заносить новые ГУИДы по СНП
	МассивГУИД_СНП = Новый Массив;
	
	// проставим реализации и даты по ним для всех ранее распределенных вагонов
	РеализацииВЭкономике(НоваяСделка,ТЗ);
	
	
	// сравниваем данные в константах. если интервал на комплект документов больше, 
	// чем на сделку, берем тот интервал, который указывается в сделке
	ИнтервалСделки = Константы.ИнтервалСозданияСделокПовагонки.Получить();
	
	ДополнитьТаблицуИнтерваламиДат(НоваяСделка,ТЗ,ИнтервалСделки,МоментСозданияСделки);
	
	
	// проставим диапазоны дат для всех остальных записей, у которых нет реализаций
	//Для каждого Стр Из ТЗ Цикл
	//	Если Стр.НетУчДокумента И 
	//		НЕ ЗначениеЗаполнено(Стр.ДатаНачалаПериодаПовагонкиУчДок) И 
	//		Не ЗначениеЗаполнено(Стр.ДатаОкончанияПериодаПовагонкиУчДок) Тогда
	//		
	//		ПараметрыОтбора = Новый Структура;
	//		ПараметрыОтбора.Вставить("Клиент",Стр.Клиент);
	//		ПараметрыОтбора.Вставить("Договор",Стр.Договор);
	//		ПараметрыОтбора.Вставить("СтавкаНДС",Стр.СтавкаНДС);
	//		ПараметрыОтбора.Вставить("СуммаВключаетНДС",Стр.СуммаВключаетНДС);
	//		ПараметрыОтбора.Вставить("Валюта",Стр.Валюта);
	//		ПараметрыОтбора.Вставить("ТипВагонов",Стр.ТипВагонов);
	//		ПроверяемаяТЗ = ТЗ.Скопировать(ПараметрыОтбора);
	//		
	//		ВыставлениеВагоновПоПериоду = Стр.ДоговорВыставлениеВагоновПоПериоду;
	//		ИнтервалКомплДок = ?(ВыставлениеВагоновПоПериоду>ИнтервалСделки,ИнтервалСделки,ВыставлениеВагоновПоПериоду);
	//		
	//		СтруктураОтвета = СоздатьКвантВремениРеализации(Стр.ДатаОтправки,ИнтервалКомплДок,ПроверяемаяТЗ);
	//		
	//		Стр.ДатаНачалаПериодаПовагонкиУчДок = СтруктураОтвета.ДатаНач;
	//		Стр.ДатаОкончанияПериодаПовагонкиУчДок = СтруктураОтвета.ДатаКон;
	//		
	//	КонецЕсли;
	//КонецЦикла;
	//
	
	МассивИзмененныхДоходов = Новый Массив;
	
	Для Каждого Стр Из ТЗ Цикл
		
		ВыставлениеВагоновПоПериоду = Стр.ДоговорВыставлениеВагоновПоПериоду;
		ИнтервалКомплДок = ?(ВыставлениеВагоновПоПериоду>ИнтервалСделки,ИнтервалСделки,ВыставлениеВагоновПоПериоду);

		// т.к. при "дополнении" сделки, в ней уже могут быть данные, то вагон в таблице доходов 
		// может встречаться более 1 раза (строка с СНП погрузки, строка с СНП выгрузки, строка с основной перевозкой...)
		// и соединение с таблицей доходыВагоны даст несколько одинаковых строк.
		// поэтому для случая "дополнения" сделки добавить проверку, что данный вагон мы уже обрабатывали
		Если Стр.ВагонПроверен Тогда
			Продолжить;
		КонецЕсли;
		ПараметрыОтбора = Новый СТруктура;
		ПараметрыОтбора.Вставить("Вагон",Стр.Вагон);
		ПараметрыОтбора.Вставить("НачалоПосуточногоДиапазона",Стр.НачалоПосуточногоДиапазона);
		ПараметрыОтбора.Вставить("ОкончаниеПосуточногоДиапазона",Стр.ОкончаниеПосуточногоДиапазона);
		НайденныеСтроки = ТЗ.НайтиСтроки(ПараметрыОтбора);
		Для Каждого Ст Из НайденныеСтроки Цикл
			Ст.ВагонПроверен = Истина;
		КонецЦикла;
		
		
		// проверяем, новый это вагон или уже распределенный.
		// если новый, то смотрим, какая у него группировка. т.к. может быть выбрано несколько вариантов,
		// проверяем по очереди каждый из них. 
		// группировка, которая идет отдельно - ВыставлениеВагоновПоОдному и если необходимо разделять СНП и основную услугу.
		// при отправлении можно создать только СНП на погрузку.
		
		// если идет "дозаполнение" сделки данными по СНП прибытия, то вагоны уже могут быть распределены, поэтому
		// данную проверку не выполнять в этом случае
		
		Если НЕ МоментСозданияСделки = 4 И ЗначениеЗаполнено(Стр.РаспределенныеВагоны) И НЕ МоментСозданияСделки = Неопределено Тогда
			// проверка типа оплаты для вагона. т.к. если вагон уже был ранее распределен и у него НЕ посуточная оплата, то
			// довносить его не нужно.
			// если у вагона посуточная оплата, то надо проверить, на какие диапазоны дат уже есть распределение, а на какие нет
			Если НЕ Стр.ПосуточнаяОплата Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого Стр_Д Из НоваяСделка.Доходы Цикл
				Для Каждого Стр_ДВ Из НоваяСделка.ДоходыВагоны Цикл
					Если Стр_ДВ.ГУИД = Стр_Д.ГУИД ТОгда
						Если НЕ СтрНайти(Стр_ДВ.Вагон,Стр.Вагон.Наименование) = 0 Тогда
							// диапазоны совпали - значит вагон уже добавлен в ТЧ доходы и добавлять его не нужно
							Если Стр.НачалоПосуточногоДиапазона = Стр_Д.ДатаНачалаПериодаПовагонкиУчДок И
								Стр.ОкончаниеПосуточногоДиапазона = Стр_Д.ДатаОкончанияПериодаПовагонкиУчДок Тогда
								Продолжить;
							КонецЕсли;
							// если совпала только дата начала диапазона - значит вагон нужно расширить диапазон дат в документе
							// (т.е. ранее распределение по реализациям было на меньший период, сейчас вагон проехал еще несколько дней и
							// диапазон можно расширить), но только в том случае, если у учдока не стоит признак "Выставлено"
							Если Стр.НачалоПосуточногоДиапазона = Стр_Д.ДатаНачалаПериодаПовагонкиУчДок И
								НЕ Стр.ОкончаниеПосуточногоДиапазона = Стр_Д.ДатаОкончанияПериодаПовагонкиУчДок Тогда
								// проверка на "Высталено"
								УчДокумент2 = НайтиРеализацию(НоваяСделка.Ссылка, Стр_Д.ГУИД);
								УчДокумент2 = ?(ЗначениеЗаполнено(УчДокумент2),УчДокумент2,НайтиОтчет(НоваяСделка.Ссылка, Стр_Д.ГУИД));
								Если НЕ ЗначениеЗаполнено(УчДокумент2) ИЛИ 
									(ЗначениеЗаполнено(УчДокумент2) И НЕ УчДокумент2.Выставлен) Тогда
									Стр_Д.ДатаОкончанияПериодаПовагонкиУчДок = Стр.ОкончаниеПосуточногоДиапазона;
									// надо перенести дату окончания временного диапазона от выставленного документа на текущий
								ИначеЕсли ЗначениеЗаполнено(УчДокумент2) И УчДокумент2.Выставлен Тогда
									Стр.НачалоПосуточногоДиапазона = Стр_Д.ДатаОкончанияПериодаПовагонкиУчДок + 1;
									// нужен пересчет для всех диапазонов дат после этой
									
									
									
									Продолжить;
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			
		КонецЕсли;
		
		Если МоментСозданияСделки = 4 И 
			(Стр.СНПВыгрузки = 0 И Стр.СНПСледования = 0)Тогда
			Продолжить;
		КонецЕсли;
		
		///////////////////////////////////////////////////////////
		////////////////////// С Н П //////////////////////////////
		ЗаполнениеСНП(ТЗ,Стр,НоваяСделка,МоментСозданияСделки,УслугаСНП,ГлобальныйОткрытыйПериод,МассивГУИД_СНП);
		
		
		// дальнейшее для тех вагонов, по которым нужно добавить только СНП выгрузки и следования, делать не нужно
		Если МоментСозданияСделки = 4 Тогда
			Продолжить;
		КонецЕсли;
		
		Если Стр.ДоговорВыставлениеВагоновПоОдному ИЛИ ВыставлениеВагоновПоПериоду = 0 Тогда
			НСтр = НоваяСделка.Доходы.Добавить(); 
			//ДИТ, Беляев СЮ, ТА48688, 28-03-2022, начало 
			НСтр.ДатаПоявленияСтрокиЭкономики = ТекущаяДата();
			//ДИТ, Беляев СЮ, ТА48688, 28-03-2022, конец
			НСтр.Услуга = УслугаДляПовагонки;
			НСтр.Перевыставляемая = УслугаДляПовагонки.Перевыставляемая;
			НСтр.Калькуляция = Стр.Калькуляция;
			нСтр.ПСЦ = Стр.ЗаявкаПСЦ;
			НСтр.Клиент = Стр.Клиент;
			НСтр.Договор = Стр.Договор;
			НСтр.ГУИД = Строка(Новый УникальныйИдентификатор);
			
			НСтрДоходыВаг = НоваяСделка.ДоходыВагоны.Добавить();
			НСтрДоходыВаг.ГУИД = НСтр.ГУИД;
			НСтрДоходыВаг.Вагон = Стр.Вагон.Наименование;
			
			НСтр.ТипВагонов = Стр.ТипВагонов;
			НСтр.Груз = Стр.Груз;
			
			// в зависимости от указанного способа вычисления суммы, выбираем механизм расчета
			Если Стр.ЗаявкаПСЦ.ОплатаПользованияВагоном = Перечисления.ВариантыОплатыПользованияВагоном.Посуточно ИЛИ
				Стр.ЗаявкаПСЦ.ОплатаПользованияВагоном = Перечисления.ВариантыОплатыПользованияВагоном.ОбщаяПоКоличествуДнейИСНП Тогда
				ДельтаПосуточная = Окр((Стр.ОкончаниеПосуточногоДиапазона - Стр.НачалоПосуточногоДиапазона)/3600/24);
				
