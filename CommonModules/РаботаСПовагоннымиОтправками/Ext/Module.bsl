
Функция УдалитьСозданиеПовагоннойСделки(МассивСтруктур) ЭКСПОРТ
	
	МассивСозданныхСделок = Новый Массив;
	
	КвантВремени = Константы.ИнтервалСозданияСделокПовагонки.Получить();
	
	РезультатЗапроса = ЗапросПоискаВагоновДляСделок(МассивСтруктур);

	ТЗ = РезультатЗапроса.Выгрузить();
	
	Если ТЗ.Количество() = 0 Тогда
		Возврат МассивСозданныхСделок;
	КонецЕсли;
	
	НачальнаяДатаДиапазонов = НачальнаяДатаДиапазоновСделки(ТЗ);
	
	ПроверкаКалькуляцийНаСоответствие(ТЗ);
	
	ДополнитьИнтерваламиТаблицу(ТЗ,НачальнаяДатаДиапазонов,КвантВремени);
	
	РезультатЗапроса = ЗапросНаВыборкуСделок(ТЗ);
	
	ВыборкаСделка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	//Евросиб Каблов 12.10.2020 ( Ticket#0209868 
	//При ошибках проведения сделок (по разным причинам, например счет выставлен), они успешно записывались с рейсом.
	//После исправления ошибок, вооще невозможно создавать было формировать сделки, так как рейс уже есть в другой сделке. 
	НачатьТранзакцию();
	//Евросиб Каблов 12.10.2020 )
	
	Пока ВыборкаСделка.Следующий() Цикл
		
		ПолучОб = Неопределено;
		// будем использовать эту переменную, чтобы понять, где именно был получен объект сделки, 
		// чтобы знать на какой итерации цикла его записывать
		МоментСозданияСделки = 0;
		
		// Если у нас есть сделки для данных вагонов, то записываем в них информацию.
		// перед этим нужно проверить, что по правилам формирования документов (в договоре клиента)
		// не установлен ли 0 в кванте времени. если установлен, то 1 вагон = 1 сделка 
		Если ЗначениеЗаполнено(ВыборкаСделка.Сделка) И НЕ КвантВремени = 0 Тогда
			ПолучОб = ВыборкаСделка.Сделка.ПолучитьОбъект();
			МоментСозданияСделки = 1;
		КонецЕсли;
	
		ВыборкаДатаОтправления = ВыборкаСделка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
		Пока ВыборкаДатаОтправления.Следующий() Цикл
			
			// если сделку для данного кванта не нашли, то проверить, 
			// когда создавался последний диапазон, произвести расчет, когда начать текущий.
			// создать сделку.
	
			ВыборкаДетальныеЗаписи = ВыборкаДатаОтправления.Выбрать();
			
			// если квант времени не 0, тогда создаем сделку тут, если 0, то создаем ее в детальных записях
			Если НЕ КвантВремени = 0 И (МоментСозданияСделки = 0 ИЛИ МоментСозданияСделки = 2) Тогда
				ПолучОб = СоздатьКвантВремениИСделку(ВыборкаДатаОтправления.ДатаОтправления,КвантВремени);
				МоментСозданияСделки = 2;
			КонецЕсли;
	
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				Если КвантВремени = 0 Тогда
					ПолучОб = СоздатьКвантВремениИСделку(ВыборкаДатаОтправления.ДатаОтправления,КвантВремени);
					МоментСозданияСделки = 3;
				КонецЕсли;
				
				
				ЗаполнениеСозданнойСделки(ПолучОб,ВыборкаДетальныеЗаписи,КвантВремени,МоментСозданияСделки,МассивСозданныхСделок);
				
				
			КонецЦикла;
			
			Если МоментСозданияСделки = 2 Тогда
				Попытка
					ПолучОб.Записать(РежимЗаписиДокумента.Проведение);
				Исключение
					//Евросиб Каблов 12.10.2020 ( Ticket#0209868
					//ПолучОб.Записать(РежимЗаписиДокумента.Запись);
					ОтменитьТранзакцию();
					//Евросиб Каблов 12.10.2020 )					
				КонецПопытки;
				
				СохраненннаяСделкаОбъект = ПолучОб.Ссылка.ПолучитьОбъект();
				//Евросиб Каблов 14.10.2020 (
				//доходы_ЗаполнитьПоЗаявкам2(СохраненннаяСделкаОбъект,МоментСозданияСделки);

				//Попытка
				//	СохраненннаяСделкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
				//Исключение
				//	//Евросиб Каблов 12.10.2020 ( Ticket#0209868
				//	//СохраненннаяСделкаОбъект.Записать(РежимЗаписиДокумента.Запись);
				//	ОтменитьТранзакцию();
				//	//Евросиб Каблов 12.10.2020 )
				//КонецПопытки;
				//Евросиб Каблов 14.10.2020 )
				МассивСозданныхСделок.Добавить(СохраненннаяСделкаОбъект);
				ЗаписатьСделкуВРегистр(СохраненннаяСделкаОбъект.Ссылка,СохраненннаяСделкаОбъект.СвязьУчетныхЕдиниц.ВыгрузитьКолонку("Вагон"));
				
			КонецЕсли;
			
			
			
		КонецЦикла;
		
		Если МоментСозданияСделки = 1 Тогда
			Попытка
				ПолучОб.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				//Евросиб Каблов 12.10.2020 ( Ticket#0209868
				//ПолучОб.Записать(РежимЗаписиДокумента.Запись);
				ОтменитьТранзакцию();
				//Евросиб Каблов 12.10.2020 )
			КонецПопытки;
			
			СохраненннаяСделкаОбъект = ПолучОб.Ссылка.ПолучитьОбъект();
			//Евросиб Каблов 14.10.2020 (
			//доходы_ЗаполнитьПоЗаявкам2(СохраненннаяСделкаОбъект,МоментСозданияСделки);

			//Попытка
			//	СохраненннаяСделкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
			//Исключение
			//	//Евросиб Каблов 12.10.2020 ( Ticket#0209868
			//	//СохраненннаяСделкаОбъект.Записать(РежимЗаписиДокумента.Запись);
			//	ОтменитьТранзакцию();
			//	//Евросиб Каблов 12.10.2020 )
			//КонецПопытки;
			//Евросиб Каблов 14.10.2020 )
			
			МассивСозданныхСделок.Добавить(СохраненннаяСделкаОбъект);
			ЗаписатьСделкуВРегистр(СохраненннаяСделкаОбъект.Ссылка,СохраненннаяСделкаОбъект.СвязьУчетныхЕдиниц.ВыгрузитьКолонку("Вагон"));
			
		КонецЕсли;
		
	КонецЦикла;
	
	//Евросиб Каблов 12.10.2020 ( Ticket#0209868
	Если ТранзакцияАктивна() Тогда
		ЗафиксироватьТранзакцию();
	Иначе
		МассивСозданныхСделок.Очистить();
	КонецЕсли;
	//Евросиб Каблов 12.10.2020 )
	
	Возврат МассивСозданныхСделок;
	
КонецФункции

Функция СозданиеПовагоннойСделки(МассивСтруктур, Сделка = Неопределено) ЭКСПОРТ
	
	МассивСозданныхСделок = Новый Массив;
	
	РезультатЗапроса = ЗапросПоискаВагоновДляСделок(МассивСтруктур);
	ТЗ = РезультатЗапроса.Выгрузить();
	
	Если ТЗ.Количество() = 0 Тогда
		Возврат МассивСозданныхСделок;
	КонецЕсли;
	
	ПроверкаКалькуляцийНаСоответствие(ТЗ);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВремТЧ.НомерВагона КАК НомерВагона,
	|	ВремТЧ.Период КАК Период,
	|	ВремТЧ.Клиент КАК Клиент,
	|	ВремТЧ.Договор КАК Договор,
	|	ВремТЧ.СтанцияОтправления КАК СтанцияОтправления,
	|	ВремТЧ.Заявка КАК Заявка,
	|	ВремТЧ.СтанцияНазначения КАК СтанцияНазначения,
	|	ВремТЧ.ПСЦ КАК ПСЦ,
	|	ВремТЧ.Груз КАК Груз,
	|	ВремТЧ.ДатаОтправления КАК ДатаОтправления,
	|	ВремТЧ.Калькуляция КАК Калькуляция,
	|	ВремТЧ.ДатаОкончанияДвижения КАК ДатаОкончанияДвижения,
	|	ВремТЧ.ВагонВПути КАК ВагонВПути,
	|	ВремТЧ.НачалоПосуточногоДиапазона КАК НачалоПосуточногоДиапазона,
	|	ВремТЧ.ОкончаниеПосуточногоДиапазона КАК ОкончаниеПосуточногоДиапазона,
	|	ВремТЧ.ПосуточнаяОплата КАК ПосуточнаяОплата,
	|	ВремТЧ.НДС КАК НДС,
	|	ВремТЧ.Контейнер КАК Контейнер,
	|	ВремТЧ.ЖДНакладная КАК ЖДНакладная
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&ВремТЧ КАК ВремТЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВагоныВОтправке.Отправка КАК Отправка,
	|	ЗаявкаПереченьРейсов.Ссылка КАК Ссылка,
	|	ВагоныВОтправке.Вагон КАК Вагон
	|ПОМЕСТИТЬ РейсыВЗаявке
	|ИЗ
	|	Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВагоныВОтправке КАК ВагоныВОтправке
	|		ПО ЗаявкаПереченьРейсов.Рейс = ВагоныВОтправке.Отправка
	|ГДЕ
	|	ЗаявкаПереченьРейсов.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ.Заявка
	|			ИЗ
	|				ВТ КАК ВТ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.НомерВагона КАК НомерВагона,
	|	ВТ.Период КАК Период,
	|	ВТ.Клиент КАК Клиент,
	|	ВТ.Договор КАК Договор,
	|	ВТ.СтанцияОтправления КАК СтанцияОтправления,
	|	ВТ.Заявка КАК Заявка,
	|	ВТ.СтанцияНазначения КАК СтанцияНазначения,
	|	ВТ.ПСЦ КАК ПСЦ,
	|	ВТ.Груз КАК Груз,
	|	ВТ.ДатаОтправления КАК ДатаОтправления,
	|	ВТ.ДатаОтправления КАК ДатаОтправленияДляРегистра,
	|	ВТ.Калькуляция КАК Калькуляция,
	|	ВТ.НДС КАК НДС,
	|	РейсыВЗаявке.Отправка КАК РейсЖД,
	|	РейсыВЗаявке.Ссылка КАК РейсСсылка,
	|	ВТ.ДатаОкончанияДвижения КАК ДатаОкончанияДвижения,
	|	ВТ.НачалоПосуточногоДиапазона КАК НачалоПосуточногоДиапазона,
	|	ВТ.ОкончаниеПосуточногоДиапазона КАК ОкончаниеПосуточногоДиапазона,
	|	ВТ.ПосуточнаяОплата КАК ПосуточнаяОплата,
	|	ВТ.ЖДНакладная КАК ЖДНакладная,
	|	ВТ.Контейнер КАК Контейнер,
	|	СделкаСвязьУчетныхЕдиниц.Ссылка КАК Сделка,
	|	ТранспортныйДокумент.НомерТранспортногоДокумента КАК НомерЖДН,
	|	Грузы.Ссылка КАК ГрузИзНакладной,
	|	ЗаявкаСоставУслуги.ГУИДСтроки КАК ГУИДСтрокиЗаявки
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РейсыВЗаявке КАК РейсыВЗаявке
	|		ПО ВТ.НомерВагона = РейсыВЗаявке.Вагон
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|		ПО ВТ.НомерВагона = СделкаСвязьУчетныхЕдиниц.Вагон
	|			И ВТ.ЖДНакладная = СделкаСвязьУчетныхЕдиниц.ЖДН
	|			И (НЕ СделкаСвязьУчетныхЕдиниц.Ссылка.ПометкаУдаления)
	|			И (НЕ СделкаСвязьУчетныхЕдиниц.Удалена)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.э_Накладная.ГрузыЖД КАК э_НакладнаяГрузыЖД
	|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Грузы КАК Грузы
	|				ПО (ПОДСТРОКА(э_НакладнаяГрузыЖД.КодЕТСНГ, 1, 5) = ПОДСТРОКА(Грузы.ЕТСНГ, 1, 5))
	|			ПО ТранспортныйДокумент.НакладнаяЭТРАН = э_НакладнаяГрузыЖД.Ссылка
	|				И (э_НакладнаяГрузыЖД.НомерСтроки = 1)
	|		ПО ВТ.ЖДНакладная = ТранспортныйДокумент.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
	|		ПО ВТ.Заявка = ЗаявкаСоставУслуги.Ссылка
	|			И ВТ.НомерВагона = ЗаявкаСоставУслуги.Вагон
	|			И (ВТ.Контейнер = ЗаявкаСоставУслуги.НомерКТК
	|				ИЛИ ЗаявкаСоставУслуги.НомерКТК = ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка))";
	Запрос.УстановитьПараметр("ВремТЧ", ТЗ);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Отказ = Ложь;
	//Евросиб Каблов 14.04.2021 ( Ticket#0227609
	//СделкаОбъект = СоздатьНовуюСделку();
	Если ЗначениеЗаполнено(Сделка) Тогда
		СделкаОбъект = Сделка.ПолучитьОбъект();
	Иначе
		СделкаОбъект = СоздатьНовуюСделку();
	КонецЕсли;
	//Евросиб Каблов 14.04.2021 ) 
	Пока Выборка.Следующий() Цикл
		//Евросиб Каблов 09.03.2021 ( Ticket#0225180 Не нужно проверять служебные сделки. Как их отличить, неизвестно. Поэтому проверку отключил.
		//Если ЗначениеЗаполнено(Выборка.Сделка) Тогда
		//	ТекстСообщения = СтрШаблон("По вагону %1 и ЖД накладной %2 уже есть сделка %3", Выборка.НомерВагона, Выборка.ЖДНакладная, Выборка.Сделка);			
		//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		//КонецЕсли;
		//Евросиб Каблов 09.03.2021 ) 
		ПСЦПодписан = ПроверитьСтатусПодписанияПСЦ(Выборка.Заявка, Выборка.Контейнер);
		Если НЕ ПСЦПодписан Тогда
			ТекстСообщения = СтрШаблон("По вагону %1 и заявке %2 ПСЦ не согласован.", Выборка.НомерВагона, Выборка.Заявка);			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		КонецЕсли;
		ЗаполнениеСозданнойСделки(СделкаОбъект, Выборка, 1, 1, МассивСозданныхСделок);
		
		Если Не ЗначениеЗаполнено(Выборка.ГУИДСтрокиЗаявки) Тогда
			ТекстСообщения = СтрШаблон("В заявке %2 не найдена строка с вагоном %1", Выборка.НомерВагона, Выборка.Заявка);			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
	//ДИТ, Беляев СЮ, Ticket#0311227, 26-05-2023, начало
	Документы.Сделка.ЗаполнитьОтветственногоЗаУчет(СделкаОбъект);
	//ДИТ, Беляев СЮ, Ticket#0311227, 26-05-2023, конец
	
	Если Не Отказ Тогда	
		СделкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
		МассивСозданныхСделок.Добавить(СделкаОбъект);
		Выборка.Сбросить();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьПолеСделкаВЗаписиПовагоннойОтправки(Выборка.НомерВагона, Выборка.Период, СделкаОбъект.Ссылка);
		КонецЦикла;
	КонецЕсли;
		
	Возврат МассивСозданныхСделок;
	
КонецФункции

Процедура ЗаполнитьПолеСделкаВЗаписиПовагоннойОтправки(Вагон, Период, Сделка) Экспорт
	
	Запись = РегистрыСведений.ПовагонныеОтправки.СоздатьМенеджерЗаписи();
	Запись.Вагон = Вагон;
	Запись.Период = Период;
	
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		Запись.Сделка = Сделка;
		Запись.Записать();
	КонецЕсли;
	
КонецПроцедуры

Функция ПроверитьСтатусПодписанияПСЦ(Заявка, Контейнер)
	
	Результат = Ложь;
	
	//Евросиб Каблов 19.10.2020
	//Протокол должен быть согласован без замечаний или подписан
	
	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ
	                |	ВЫБОР
	                |		КОГДА Заявка.ПСЦ <> ЗНАЧЕНИЕ(Документ.ПСЦ.ПустаяСсылка)
	                |			ТОГДА Заявка.ПСЦ
	                |		ИНАЧЕ Заявка.Ссылка.ПСЦ
	                |	КОНЕЦ КАК ПСЦ
	                |ПОМЕСТИТЬ НайдПСЦ
	                |ИЗ
	                |	Документ.Заявка КАК Заявка
	                |ГДЕ
	                |	Заявка.Ссылка = &Ссылка
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	НайдПСЦ.ПСЦ.СтатусДокумента В (&РазрСтатусы)
	                |		ИЛИ НайдПСЦ.ПСЦ.МаксимальнаяДатаПодписанияСДвухСторон > &ТекДата КАК УсловиеЪ
	                |ИЗ
	                |	НайдПСЦ КАК НайдПСЦ";
	Запрос.УстановитьПараметр("Ссылка", Заявка);
	Запрос.УстановитьПараметр("НомерКТК", Контейнер);
	Запрос.УстановитьПараметр("ТекДата", НачалоДня(ТекущаяДата()));
	РазрСтатусы = Новый Массив;
	РазрСтатусы.Добавить(Перечисления.СтатусыСогласования.Подписано);
