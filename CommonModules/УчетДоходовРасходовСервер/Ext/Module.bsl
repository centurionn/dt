Процедура Акцепт_СформироватьДвиженияНеурегулированныеРасходы(ОбъектАкцепт) Экспорт

	НеурегулированныеРасходы = ОбъектАкцепт.Движения.НеурегулированныеРасходы;
	НеурегулированныеРасходы.Записывать = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	&Поступление КАК Поступление,
	|	АкцептУслуги.ГУИД КАК ИдентификаторСтрокиАкцепта,
	|	АкцептУслуги.ПоступлениеСумма КАК Сумма,
	|	АкцептУслуги.ПоступлениеСуммаНДС КАК СуммаНДС,
	|	АкцептУслуги.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ НеурегулированныеРасходыАкцепта
	|ИЗ
	|	Документ.Акцепт.Услуги КАК АкцептУслуги
	|ГДЕ
	|	АкцептУслуги.Ссылка = &Ссылка
	|	И АкцептУслуги.Сделка = ЗНАЧЕНИЕ(Документ.Сделка.ПустаяСсылка)
	|	И АкцептУслуги.ПричинаНеакцепта = ЗНАЧЕНИЕ(Справочник.Претензии.ПустаяСсылка)
	|	И АкцептУслуги.СуммаПретензии = 0
	|	И НЕ АкцептУслуги.ВыгруженаВРИТМ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НеурегулированныеРасходыАкцепта.Период КАК Период,
	|	НеурегулированныеРасходыАкцепта.ВидДвижения КАК ВидДвижения,
	|	НеурегулированныеРасходыАкцепта.Поступление КАК Поступление,
	|	НеурегулированныеРасходыАкцепта.ИдентификаторСтрокиАкцепта КАК ИдентификаторСтрокиАкцепта,
	|	НеурегулированныеРасходыАкцепта.Сумма КАК Сумма,
	|	НеурегулированныеРасходыАкцепта.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	НеурегулированныеРасходыАкцепта КАК НеурегулированныеРасходыАкцепта
	|
	|УПОРЯДОЧИТЬ ПО
	|	НеурегулированныеРасходыАкцепта.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДиалогиЗаголовки.ГУИДТемы КАК ГУИДТемы
	|ИЗ
	|	РегистрСведений.ДиалогиПричиныНеурегулированныхРасходов КАК ДиалогиПричиныНеурегулированныхРасходов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДиалогиЗаголовки КАК ДиалогиЗаголовки
	|		ПО ДиалогиПричиныНеурегулированныхРасходов.ГУИДТемы = ДиалогиЗаголовки.ГУИДТемы
	|		ЛЕВОЕ СОЕДИНЕНИЕ НеурегулированныеРасходыАкцепта КАК НеурегулированныеРасходыАкцепта
	|		ПО ДиалогиПричиныНеурегулированныхРасходов.ИдентификаторСтрокиАкцепта = НеурегулированныеРасходыАкцепта.ИдентификаторСтрокиАкцепта
	|ГДЕ
	|	ДиалогиПричиныНеурегулированныхРасходов.Поступление = &Поступление
	|	И НЕ ДиалогиЗаголовки.ВопросЗакрыт
	|	И НеурегулированныеРасходыАкцепта.НомерСтроки ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Ссылка", ОбъектАкцепт.Ссылка);
	Запрос.УстановитьПараметр("ОтработкаВРИТМ", Справочники.ПричиныНеурегулированныхРасходов.ОтработкаВРИТМ);
	Запрос.УстановитьПараметр("Период", ОбъектАкцепт.Дата);
	Запрос.УстановитьПараметр("Поступление", ОбъектАкцепт.Поступление);
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	НеурегРасходыАкцепта = РезультатыЗапроса[1].Выгрузить();
	НеурегулированныеРасходы.Загрузить(НеурегРасходыАкцепта);
	
	ДиалогиКЗакрытию = РезультатыЗапроса[2].Выбрать();
	
	Пока ДиалогиКЗакрытию.Следующий() Цикл
		
		Запись = РегистрыСведений.ДиалогиЗаголовки.СоздатьМенеджерЗаписи();
		Запись.ГУИДТемы = ДиалогиКЗакрытию.ГУИДТемы;
		
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			Запись.ВопросЗакрыт = Истина;
			Запись.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

