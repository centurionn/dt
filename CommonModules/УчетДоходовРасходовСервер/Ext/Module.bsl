	|	ВТ_ТаблицыСписания.СуммаНДСОстатокУУ КАК СуммаНДСОстатокУУ,
	|	ВТ_ТаблицыСписания.СуммаРубОстатокУУ КАК СуммаРубОстатокУУ,
	|	ВТ_ТаблицыСписания.СуммаНДСРубОстатокУУ КАК СуммаНДСРубОстатокУУ
	|ИЗ
	|	ВТ_ТаблицыСписания КАК ВТ_ТаблицыСписания"; 
	Если Параметры.ВО Тогда
		ТекстЗапроса = ТекстШаблонаВТ_ВО + ТекстЗапроса;
	КонецЕсли;
	Если Параметры.УУ Тогда
		ТекстЗапроса = ТекстШаблонаВТ_УУ + ТекстЗапроса;
	КонецЕсли;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("НачалоПериодаВозникновенияОстатков", НачалоДня(Параметры.НачалоПериодаВозникновенияОстатков));
	Запрос.УстановитьПараметр("КонецПериодаВозникновенияОстатков", КонецДня(Параметры.ОкончаниеПериодаВозникновенияОстатков));
	Запрос.УстановитьПараметр("ПериодСписания", КонецМесяца(Параметры.ПериодСписания));
	Запрос.УстановитьПараметр("Организация", Параметры.Организация);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ТаблицаСписания = Неопределено;
	Иначе
		ТаблицаСписания = РезультатЗапроса.Выгрузить();
	КонецЕсли;                                         
	ПоместитьВоВременноеХранилище(ТаблицаСписания, АдресРезультата);
	
КонецФункции

Процедура Списание_СформироватьДвиженияРасходы(Объект) Экспорт

	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено);
	ПолучитьТаблицуСписанияПлановыхРасходов(Объект, АдресРезультата);
	ТаблицаСписания = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Списание_СформироватьДвиженияПлановыеРасходы(Объект, ТаблицаСписания);
	//Списание_СформироватьДвиженияФиксацияИзмененияПлановыхРасходовВО(Объект);
	
КонецПроцедуры

Процедура Списание_СформироватьДвиженияПлановыеРасходы(Объект, ТаблицаСписания)
	
	Объект.Движения.ПлановыеРасходыВО.Очистить();
	Объект.Движения.ПлановыеРасходыВО.Записать();
	Объект.Движения.ПлановыеРасходыУУ.Очистить();
	Объект.Движения.ПлановыеРасходыУУ.Записать();
	Если Объект.ВО Тогда
		Объект.Движения.ПлановыеРасходыВО.Записывать = Истина;
	КонецЕсли;
	Если Объект.УУ Тогда
		Объект.Движения.ПлановыеРасходыУУ.Записывать = Истина;
	КонецЕсли;                                                
	Для каждого СтрокаСписания Из ТаблицаСписания Цикл

		Если Объект.ВО 
			И СтрокаСписания.СуммаОстатокВО <> 0 Тогда
			ДвижениеВО = Объект.Движения.ПлановыеРасходыВО.ДобавитьРасход();
			ЗаполнитьЗначенияСвойств(ДвижениеВО, СтрокаСписания);
			ДвижениеВО.Период = НачалоМесяца(Объект.ПериодСписания);
			ДвижениеВО.Сумма = СтрокаСписания.СуммаОстатокВО;
			ДвижениеВО.СуммаНДС = СтрокаСписания.СуммаНДСОстатокВО;
			ДвижениеВО.СуммаРуб = СтрокаСписания.СуммаРубОстатокВО;
			ДвижениеВО.СуммаНДСРуб = СтрокаСписания.СуммаНДСРубОстатокВО;
			ДвижениеВО.Списание = Истина;
		КонецЕсли;

		Если Объект.УУ 
			И СтрокаСписания.СуммаОстатокУУ <> 0 Тогда
			ДвижениеУУ = Объект.Движения.ПлановыеРасходыУУ.ДобавитьРасход();
			ЗаполнитьЗначенияСвойств(ДвижениеУУ, СтрокаСписания);
			ДвижениеУУ.Период = НачалоМесяца(Объект.ПериодСписания);
			ДвижениеУУ.Сумма = СтрокаСписания.СуммаОстатокУУ;
			ДвижениеУУ.СуммаНДС = СтрокаСписания.СуммаНДСОстатокУУ;
			ДвижениеУУ.СуммаРуб = СтрокаСписания.СуммаРубОстатокУУ;
			ДвижениеУУ.СуммаНДСРуб = СтрокаСписания.СуммаНДСРубОстатокУУ;
			ДвижениеУУ.Списание = Истина;
		КонецЕсли;
		
	КонецЦикла;
	Если Объект.ВО Тогда
		Объект.Движения.ПлановыеРасходыВО.Записать();
	КонецЕсли;
	Если Объект.УУ Тогда
		Объект.Движения.ПлановыеРасходыУУ.Записать();
	КонецЕсли;                                                
	
КонецПроцедуры

Процедура Списание_СформироватьДвиженияФиксацияИзмененияПлановыхРасходовВО(Объект)
	
	Объект.Движения.ФиксацияИзмененияПлановыхРасходовВО.Очистить();
	Объект.Движения.ФиксацияИзмененияПлановыхРасходовВО.Записать();
	Запрос = Новый Запрос;
	Запрос.Текст = Списание_ПолучитьТекстЗапросаФиксацииИзменения("ПлановыеРасходыВО");
	Списание_УстановитьПараметрыЗапросаФиксацииИзменений(Запрос, Объект);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли; 
	Объект.Движения.ФиксацияИзмененияПлановыхРасходовВО.Записывать = Истина;
	Объект.Движения.ФиксацияИзмененияПлановыхРасходовВО.Загрузить(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры

