	|	СделкаРасходы.Ссылка КАК Сделка,
	|	СделкаРасходы.Ссылка.ЦФО КАК ЦФО,
	|	СделкаСвязьДоходовИРасходов.СвязьУчетныхЕдиниц КАК ИдентификаторСУЕ,
	|	СделкаРасходы.Поставщик КАК Поставщик,
	|	СделкаРасходы.Договор КАК Договор,
	|	СделкаРасходы.Услуга КАК Услуга,
	|	СделкаРасходы.Валюта КАК Валюта,
	|	СделкаРасходы.Вагон КАК Вагон,
	|	СделкаРасходы.Контейнер КАК Контейнер,
	|	СделкаРасходы.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	|	ВЫБОР
	|		КОГДА СделкаРасходы.Перевыставляемая
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыРасходов.Возмещаемые)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыРасходов.Себестоимость)
	|	КОНЕЦ КАК ТипОперации,
	|	СделкаРасходы.СуммаИтого КАК Сумма,
	|	СделкаРасходы.СуммаНДС КАК СуммаНДС,
	|	СделкаРасходы.СтавкаНДС КАК СтавкаНДС,
	|	СделкаДоходы.УчДокумент.ДатаДокумента КАК ДатаКурса,
	|	СделкаРасходы.ГУИД КАК ГУИД,
	|	ВЫБОР
	|		КОГДА СделкаРасходы.ОтнестиНаЗатраты
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидОперацииРасходов.СобственныеЗатраты)
	|		КОГДА СделкаРасходы.ВнутренняяСебестоимость
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидОперацииРасходов.ВнутренняяСебестоимость)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидОперацииРасходов.ПрямыеРасходы)
	|	КОНЕЦ КАК ВидОперации,
	|	ВЫБОР
	// + ЗНАЧЕНИЕ(Перечисление.ИсточникПоявленияСтрокиЭкономики.ЖДН)
	|		КОГДА СделкаРасходы.ИсточникПоявленияСтрокиЭкономики В (ЗНАЧЕНИЕ(Перечисление.ИсточникПоявленияСтрокиЭкономики.ПорожняяЖДН), ЗНАЧЕНИЕ(Перечисление.ИсточникПоявленияСтрокиЭкономики.ЖДНПерестановкиВагонов), ЗНАЧЕНИЕ(Перечисление.ИсточникПоявленияСтрокиЭкономики.ЖДН))
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПлановыеРасходыПоЖДН,
	|	СделкаДоходы.Клиент КАК Клиент,
	|	СделкаДоходы.Договор КАК ДоговорКлиента,
	|	СделкаДоходы.УчДокумент КАК УчДокумент,
	//Евросиб Каблов 05.03.2026 ( #126776
	|	ВЫБОР
	|		КОГДА СделкаРасходы.ИсточникПоявленияСтрокиЭкономики = &ИсточникПоявленияСтрокиЭкономикиЖДН
	|				И НЕ СделкаРасходы.ТранспортныйДокумент.НакладнаяЭТРАН.ПлательщикКод В(&КодыПлательщика)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ИсключатьИзУФД
	//Евросиб Каблов 05.03.2026 )
	|ПОМЕСТИТЬ ИсходныеДанные
	|ИЗ
	|	Документ.Сделка.Расходы КАК СделкаРасходы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьДоходовИРасходов КАК СделкаСвязьДоходовИРасходов
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.Доходы КАК СделкаДоходы
	|			ПО СделкаСвязьДоходовИРасходов.Ссылка = СделкаДоходы.Ссылка
	|				И СделкаСвязьДоходовИРасходов.Доходы = СделкаДоходы.ГУИД
	|		ПО СделкаРасходы.Ссылка = СделкаСвязьДоходовИРасходов.Ссылка
	|			И СделкаРасходы.ГУИД = СделкаСвязьДоходовИРасходов.Расходы
	|ГДЕ
	|	СделкаРасходы.Ссылка = &Ссылка
	|	И НЕ СделкаРасходы.УслугаОтключена
	|	И СделкаРасходы.СуммаИтого > 0
	|	И НЕ СделкаРасходы.НеВключатьВПлановыеРасходы
	|	И НЕ СделкаДоходы.УчДокумент.Ссылка ЕСТЬ NULL
	|	И ЕСТЬNULL(СделкаДоходы.УчДокумент.Проведен, ЛОЖЬ)	
	|	И (СделкаРасходы.ИсточникПоявленияСтрокиЭкономики В (ЗНАЧЕНИЕ(Перечисление.ИсточникПоявленияСтрокиЭкономики.ОсновнаяУслугаАвтоматически), ЗНАЧЕНИЕ(Перечисление.ИсточникПоявленияСтрокиЭкономики.ПорожняяЖДН), ЗНАЧЕНИЕ(Перечисление.ИсточникПоявленияСтрокиЭкономики.ЖДНПерестановкиВагонов), ЗНАЧЕНИЕ(Перечисление.ИсточникПоявленияСтрокиЭкономики.ФрахтИзКалькуляции))
	// + ЗНАЧЕНИЕ(Перечисление.ИсточникПоявленияСтрокиЭкономики.ЖДН) с Даты начала учета плановых расходов (полный факт)
	|			ИЛИ СделкаРасходы.ИсточникПоявленияСтрокиЭкономики = ЗНАЧЕНИЕ(Перечисление.ИсточникПоявленияСтрокиЭкономики.ЖДН)
	|				И ВЫБОР
	|					КОГДА СделкаДоходы.УчДокумент.Ссылка ЕСТЬ NULL
	|							ИЛИ СделкаДоходы.УчДокумент = НЕОПРЕДЕЛЕНО
	|							ИЛИ СделкаДоходы.Ссылка ЕСТЬ NULL
	|						ТОГДА &ПустаяДата
	|					ИНАЧЕ СделкаДоходы.ПериодВО
	|				КОНЕЦ >= &ДатаНачалаУчетаПлановыхРасходовПолныйФакт
	|			ИЛИ СделкаРасходы.ВнутренняяСебестоимость)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(КурсыВалют.Период) КАК Период,
	|	КурсыВалют.Валюта КАК Валюта,
	|	ИсходныеДанные.ДатаКурса КАК ДатаКурса,
	|	ИсходныеДанные.Валюта КАК Валюта1
	|ПОМЕСТИТЬ ВТ_Курсы
	|ИЗ
	|	ИсходныеДанные КАК ИсходныеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
	|		ПО ИсходныеДанные.ДатаКурса >= КурсыВалют.Период
	|			И ИсходныеДанные.Валюта = КурсыВалют.Валюта
	|
	|СГРУППИРОВАТЬ ПО
	|	КурсыВалют.Валюта,
	|	ИсходныеДанные.ДатаКурса,
	|	ИсходныеДанные.Валюта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(ИсходныеДанные.Период, МЕСЯЦ) КАК Период, 
	|	ИсходныеДанные.ДатаОказанияУслуги КАК ДатаОказанияУслуги, 
	|	ИсходныеДанные.ВидДвижения КАК ВидДвижения,
	|	ИсходныеДанные.Организация КАК Организация,
	|	ИсходныеДанные.Сделка КАК Сделка,
	|	ИсходныеДанные.ЦФО КАК ЦФО,
	|	ИсходныеДанные.ИдентификаторСУЕ КАК ИдентификаторСУЕ,
	|	ИсходныеДанные.Поставщик КАК Поставщик,
	|	ИсходныеДанные.Договор КАК Договор,
	|	ИсходныеДанные.Услуга КАК Услуга,
	|	ИсходныеДанные.Валюта КАК Валюта,
	|	ИсходныеДанные.Вагон КАК Вагон,
	|	ИсходныеДанные.Контейнер КАК Контейнер,
	|	ИсходныеДанные.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	|	ИсходныеДанные.ТипОперации КАК ТипОперации,
	|	ИсходныеДанные.Сумма КАК Сумма,
	|	ИсходныеДанные.СуммаНДС КАК СуммаНДС,
	|	ИсходныеДанные.СтавкаНДС КАК СтавкаНДС,
	|	ИсходныеДанные.ДатаКурса КАК ДатаКурса,
	|	КурсыВалют.Курс КАК КурсВалюты,
	|	КурсыВалют.Кратность КАК КратностьВалюты,
	|	ИсходныеДанные.ДатаКурса КАК ДатаКурсаВалюты,
	|	ИсходныеДанные.Сумма * ЕСТЬNULL(КурсыВалют.Курс, 1) / ЕСТЬNULL(КурсыВалют.Кратность, 1) КАК СуммаРуб,
	|	ИсходныеДанные.СуммаНДС * ЕСТЬNULL(КурсыВалют.Курс, 1) / ЕСТЬNULL(КурсыВалют.Кратность, 1) КАК СуммаНДСРуб,
	|	ИсходныеДанные.ГУИД КАК ИдентификаторСтрокиРасходов,
	|	ИсходныеДанные.ВидОперации КАК ВидОперации,
	|	ИсходныеДанные.ПлановыеРасходыПоЖДН КАК ПлановыеРасходыПоЖДН,
	|	ИсходныеДанные.Клиент КАК Клиент,
	|	ИсходныеДанные.ДоговорКлиента КАК ДоговорКлиента,
	|	ИсходныеДанные.УчДокумент КАК Реализация,
	//Евросиб Каблов 05.03.2026 ( #126776
	|	ИсходныеДанные.ИсключатьИзУФД КАК ИсключатьИзУФД
	//Евросиб Каблов 05.03.2026 )
	|ИЗ
	|	ИсходныеДанные КАК ИсходныеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Курсы КАК ВТ_Курсы
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
	|			ПО ВТ_Курсы.Период = КурсыВалют.Период
	|				И ВТ_Курсы.Валюта = КурсыВалют.Валюта
	|		ПО ИсходныеДанные.ДатаКурса = ВТ_Курсы.ДатаКурса
	|			И ИсходныеДанные.Валюта = ВТ_Курсы.Валюта";
	
	Если ВидУчета = "УУ" Тогда
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "СделкаДоходы.ПериодВО", "СделкаДоходы.ДатаОказанияУслуги");
		
	КонецЕсли;
	
 	Возврат ТекстЗапроса;
	
КонецФункции

//Евросиб Каблов 06.11.2025 #107942
Процедура Сделка_УстановитьПараметрыЗапросаПлановыеРасходыПолныйФакт(Запрос, ОбъектСделка)
	
	Запрос.УстановитьПараметр("Ссылка", ОбъектСделка.Ссылка);
	Запрос.УстановитьПараметр("УслугаФрахт", Константы.УслугаФрахтаДляКалькуляции.Получить());
	Запрос.УстановитьПараметр("ДатаНачалаУчетаПлановыхРасходовПолныйФакт", Константы.ДатаНачалаУчетаПлановыхРасходовПолныйФакт.Получить());
	//Евросиб Каблов 05.03.2026 ( #126776
	Запрос.УстановитьПараметр("ИсточникПоявленияСтрокиЭкономикиЖДН", Перечисления.ИсточникПоявленияСтрокиЭкономики.ЖДН);
	//Запрос.УстановитьПараметр("КодПлательщика", "1000082317"); //Константа?
	КодыПлательщикаСтрокой = РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ПолучитьАналитикуДокумента(ОбъектСделка.Организация, ПланыВидовХарактеристик.ДополнительныеАналитикиДокументов.КодыПлательщикаДляУчетаПлановыхРасходовВУФД);
	Если ЗначениеЗаполнено(КодыПлательщикаСтрокой) Тогда
		КодыПлательщика = СтрРазделить(КодыПлательщикаСтрокой, ",", Ложь);
		Для Инд = 0 По КодыПлательщика.Количество() - 1 Цикл
			КодыПлательщика[Инд] = СокрЛП(КодыПлательщика[Инд]);
		КонецЦикла;
	Иначе
		КодыПлательщика = Новый Массив;
	КонецЕсли;
	Запрос.УстановитьПараметр("КодыПлательщика", КодыПлательщика);
	//Евросиб Каблов 05.03.2026 ) #126776
	ПустаяДата = '00010101';
	Запрос.УстановитьПараметр("ПустаяДата", ПустаяДата);
	
КонецПроцедуры

