	|		ПО ВТ_Услуги.Услуга = ПлановыеДоходыВО.Услуга
	|			И ВТ_Услуги.Сделка = ПлановыеДоходыВО.Сделка
	|			И ВТ_Услуги.СтрокаСвязьУчетныхЕдиниц = ПлановыеДоходыВО.ИдентификаторСУЕ";
	Запрос.УстановитьПараметр("Ссылка", ОбъектОК.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли; 
	ОбъектОК.Движения.ПлановыеДоходыВО.Записывать = Истина;
	ОбъектОК.Движения.ПлановыеДоходыВО.Загрузить(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры

#КонецОбласти

#Область Акцепт

Процедура Акцепт_СформироватьДвиженияДоходыРасходы(ОбъектАкцепт, ПланУУ = Истина, ПланВО = Истина, ФактУУ = Истина, ФактВО = Истина, ФактБУ = Истина) Экспорт
	
	
//Евросиб Гудкова( 04.07.2022 Ticket№ 54131  добавила возможность не записывать лишние движения
	Если ПланУУ Тогда
		Акцепт_СформироватьДвиженияПлановыеРасходыУУ(ОбъектАкцепт);
	КонецЕсли;
	Если ПланВО Тогда
		Акцепт_СформироватьДвиженияПлановыеРасходыВО(ОбъектАкцепт);
	КонецЕсли;
	Если ФактВО Тогда
		Акцепт_СформироватьДвиженияФактическиеРасходыВО(ОбъектАкцепт);
	КонецЕсли;
	Если ФактУУ тогда
		Акцепт_СформироватьДвиженияФактическиеРасходыУУ(ОбъектАкцепт);
	КонецЕсли;
	Если ФактБУ тогда
		Акцепт_СформироватьДвиженияФактическиеРасходыБУ(ОбъектАкцепт);
	КонецЕсли;
//Евросиб Гудкова

КонецПроцедуры

