//Корректировка реализации. Фактические доходы ВО.
Процедура СформироватьДвиженияФактическиеДоходыВО(ОбъектКРТУ) Экспорт
	
	ОбъектКРТУ.Движения.ФактическиеДоходыВО.Записывать = Истина;
	Запрос = Новый Запрос;
	//ДИТ Шевченко А.В. 31.10.2022 60146 -начало
	Если ТипЗнч(ОбъектКРТУ) = Тип("ДокументОбъект.КорректировкаРеализации") Тогда
		Если ОбъектКРТУ.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование Тогда
			Запрос.Текст = КРТУ_ПолучитьТекстЗапросаФактическиеДоходыАннулирование("ВО");
			КРТУ_УстановитьПараметрыЗапросаФактическиеДоходыАннулирование(Запрос, ОбъектКРТУ, "ВО");	
		КонецЕсли;	
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Запрос.Текст) Тогда
		Запрос.Текст = КРТУ_ПолучитьТекстЗапросаФактическиеДоходы("ВО");
		КРТУ_УстановитьПараметрыЗапросаФактическиеДоходы(Запрос, ОбъектКРТУ, "ВО")
	КонецЕсли;
	//ДИТ Шевченко А.В. 31.10.2022 60146 -конец
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли; 
	ОбъектКРТУ.Движения.ФактическиеДоходыВО.Загрузить(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры //СформироватьДвиженияФактическиеДоходыВО

//Корректировка реализации. Фактические доходы УУ.
Процедура СформироватьДвиженияФактическиеДоходыУУ(ОбъектКРТУ) Экспорт
	
	ОбъектКРТУ.Движения.ФактическиеДоходыУУ.Записывать = Истина;
	Запрос = Новый Запрос;
	//ДИТ Шевченко А.В. 31.10.2022 60146 -начало
	Если ТипЗнч(ОбъектКРТУ) = Тип("ДокументОбъект.КорректировкаРеализации") Тогда
		Если ОбъектКРТУ.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование Тогда
			Запрос.Текст = КРТУ_ПолучитьТекстЗапросаФактическиеДоходыАннулирование("УУ");
			КРТУ_УстановитьПараметрыЗапросаФактическиеДоходыАннулирование(Запрос, ОбъектКРТУ, "УУ");	
		КонецЕсли;	
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Запрос.Текст) Тогда
		Запрос.Текст = КРТУ_ПолучитьТекстЗапросаФактическиеДоходы("УУ");
		КРТУ_УстановитьПараметрыЗапросаФактическиеДоходы(Запрос, ОбъектКРТУ, "УУ");
	КонецЕсли;
	//ДИТ Шевченко А.В. 31.10.2022 60146 -конец
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли; 
	ОбъектКРТУ.Движения.ФактическиеДоходыУУ.Загрузить(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры //СформироватьДвиженияФактическиеДоходыВО

Функция КРТУ_ПолучитьТекстЗапросаФактическиеДоходыАннулирование(ВидУчета)
	ТекстЗапроса = "ВЫБРАТЬ
	|	&ПериодВО КАК Период,
	|	ФактическиеДоходыВО.Организация КАК Организация,
	|	ФактическиеДоходыВО.ЦФО КАК ЦФО,
	|	ФактическиеДоходыВО.Сделка КАК Сделка,
	|	ФактическиеДоходыВО.Услуга КАК Услуга,
	|	ФактическиеДоходыВО.ИдентификаторСУЕ КАК ИдентификаторСУЕ,
	|	ФактическиеДоходыВО.Вагон КАК Вагон,
	|	ФактическиеДоходыВО.Контейнер КАК Контейнер,
	|	СУММА(-ФактическиеДоходыВО.Сумма) КАК Сумма,
	|	СУММА(-ФактическиеДоходыВО.СуммаНДС) КАК СуммаНДС,
	|	ФактическиеДоходыВО.Клиент КАК Клиент,
	|	ФактическиеДоходыВО.Договор КАК Договор,
	|	ФактическиеДоходыВО.Валюта КАК Валюта,
	|	ФактическиеДоходыВО.СтавкаНДС КАК СтавкаНДС,
	|	ФактическиеДоходыВО.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	|	ФактическиеДоходыВО.ТипОперации КАК ТипОперации,
	|	МАКСИМУМ(ФактическиеДоходыВО.ДатаКурсаВалюты) КАК ДатаКурсаВалюты,
	|	СУММА(-ФактическиеДоходыВО.СуммаРуб) КАК СуммаРуб,
	|	СУММА(-ФактическиеДоходыВО.СуммаНДСРуб) КАК СуммаНДСРуб,
	|	ФактическиеДоходыВО.ДокументРеализации КАК ДокументРеализации
	|ИЗ
	|	РегистрНакопления.ФактическиеДоходыВО КАК ФактическиеДоходыВО
	|ГДЕ
	|	ФактическиеДоходыВО.ДокументРеализации = &ИсправляемыйДокумент
	|	И НЕ ФактическиеДоходыВО.Регистратор = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ФактическиеДоходыВО.Сделка,
	|	ФактическиеДоходыВО.НоменклатурнаяГруппа,
	|	ФактическиеДоходыВО.Вагон,
	|	ФактическиеДоходыВО.ТипОперации,
	|	ФактическиеДоходыВО.Клиент,
	|	ФактическиеДоходыВО.Договор,
	|	ФактическиеДоходыВО.ИдентификаторСУЕ,
	|	ФактическиеДоходыВО.СтавкаНДС,
	|	ФактическиеДоходыВО.ЦФО,
	|	ФактическиеДоходыВО.Валюта,
	|	ФактическиеДоходыВО.Организация,
	|	ФактическиеДоходыВО.Контейнер,
	|	ФактическиеДоходыВО.Услуга,
	|	ФактическиеДоходыВО.ДокументРеализации";
	
	Если ВидУчета = "УУ" Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПериодВО", "&ПериодУУ");
	КонецЕсли; 
	Возврат ТекстЗапроса;
	
КонецФункции	

Процедура КРТУ_УстановитьПараметрыЗапросаФактическиеДоходыАннулирование(Запрос, ОбъектКРТУ, ВидУчета)
	
	Запрос.УстановитьПараметр("ИсправляемыйДокумент", ОбъектКРТУ.ИсходныйДокументРеализации);
	Если ТипЗнч(ОбъектКРТУ.ДокументРеализации) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		Если ОбъектКРТУ.ДокументРеализации.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение Тогда 
			Запрос.УстановитьПараметр("ИсправляемыйДокумент", ОбъектКРТУ.ДокументРеализации); 
		КонецЕсли;
	КонецЕсли;	
	Запрос.УстановитьПараметр("Ссылка", ОбъектКРТУ.Ссылка);
	Если ВидУчета = "УУ" Тогда
		ПервоначальныйРТУ = БухгалтерскийУчетПереопределяемый.ПолучитьИсправляемыйДокументРеализации(ОбъектКРТУ.Ссылка, Истина);
		ДатаДокументаПервоначальногоПТУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПервоначальныйРТУ, "ДатаДокумента");
		Запрос.УстановитьПараметр("ПериодУУ", ДатаДокументаПервоначальногоПТУ);
	ИначеЕсли ВидУчета = "ВО" Тогда
		//Евросиб Каблов 05.01.2024 ( #79370
		//Запрос.УстановитьПараметр("ПериодВО", ОбъектКРТУ.Ссылка.ПериодВО);
		Запрос.УстановитьПараметр("ПериодВО", НачалоМесяца(ОбъектКРТУ.ПериодВО));
		//Евросиб Каблов 05.01.2024 )
	КонецЕсли;
КонецПроцедуры	

