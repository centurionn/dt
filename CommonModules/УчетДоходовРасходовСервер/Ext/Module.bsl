	Запрос.УстановитьПараметр("ДатаНачалаГода", НачалоГода(ПериодВО));
	Запрос.УстановитьПараметр("ДатаОкончанияПериода", КонецМесяца(ПериодВО));
	Запрос.УстановитьПараметр("АкцептПустаяСсылка", Документы.Акцепт.ПустаяСсылка());
	Запрос.УстановитьПараметр("СделкаПустаяСсылка", Документы.Сделка.ПустаяСсылка());
	
	Выборка = Запрос.Выполнить().Выбрать();
	НомерСтроки = УФД_ПолучитьНомерПоследнейСтрокиПериода(ПериодВО);
		
	НаборЗаписей = РегистрыСведений.УчетФактическихУправленческихДанных.СоздатьНаборЗаписей();	
	ОтборПоПолю = НаборЗаписей.Отбор.ПериодВО;
	ОтборПоПолю.Установить(ПериодВО, Истина);
	ОтборПоПолю = НаборЗаписей.Отбор.БлокУФД;
	ОтборПоПолю.Установить(БлокУФД_РасходыРезервы, Истина);
		
	Пока Выборка.Следующий() Цикл
		
		НомерСтроки = НомерСтроки + 1;
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.БлокУФД = БлокУФД_РасходыРезервы;
		НоваяЗапись.ПериодВО = ПериодВО;
		ЗаполнитьЗначенияСвойств(НоваяЗапись, Выборка);		
		НоваяЗапись.НомерСтрокиПериода = НомерСтроки;
		
		ИдентификаторПорции = Цел(НомерСтроки / КоличествоЗаписейВПорцииДанных);
		НоваяЗапись.ИдентификаторПорцииДанных = ИдентификаторПорции;
		
	КонецЦикла;
	
	НаборЗаписей.Записать();
		
КонецПроцедуры

