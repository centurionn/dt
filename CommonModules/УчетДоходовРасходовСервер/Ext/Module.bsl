//Евросиб Каблов 06.11.2025 #107942
Процедура Акцепт_СформироватьДвиженияПлановыеРасходыВОПолныйФакт(ДанныеАкцепта, ПлановыеРасходыВОПолныйФакт) Экспорт
	
	ПлановыеРасходыВОПолныйФакт.Очистить();
	ПлановыеРасходыВОПолныйФакт.Записать();
	
	Запрос = Новый Запрос;
	Запрос.Текст = Акцепт_ПолучитьТекстЗапросаПлановыеРасходыПолныйФакт();
	Акцепт_УстановитьПараметрыЗапросаРасходы(Запрос, ДанныеАкцепта);
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаУслугАкцепта = РезультатыЗапроса[4].Выбрать();
	ТаблицаПлановыхПоСтрокеРасходов = РезультатыЗапроса[5].Выгрузить();
	ТаблицаПлановыхПоСтрокеСУЕиУслуге = РезультатыЗапроса[6].Выгрузить();
	
	СтруктураПоискаПоСтрокеРасходов = Новый Структура("Сделка, ИдентификаторСтрокиРасходов");
	СтруктураПоискаПоСУЕиУслуге = Новый Структура("Сделка, ИдентификаторСУЕ, Услуга");
	Пока ВыборкаУслугАкцепта.Следующий() Цикл
		
		Сумма = ВыборкаУслугАкцепта.Сумма;
		СуммаНДС = ВыборкаУслугАкцепта.СуммаНДС;
		
		ЗаполнитьЗначенияСвойств(СтруктураПоискаПоСтрокеРасходов, ВыборкаУслугАкцепта);
		ПлановыеРасходы = ТаблицаПлановыхПоСтрокеРасходов.НайтиСтроки(СтруктураПоискаПоСтрокеРасходов);
		Для Каждого ПлановыйРасход Из ПлановыеРасходы Цикл
			
			Если Сумма <= 0 Тогда
				Прервать;
			КонецЕсли;
			
			Запись = ПлановыеРасходыВОПолныйФакт.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, ПлановыйРасход);
			
			СуммаВВалютеПлановых = ПлановыйРасход.Сумма;
			СуммаВВалютеАкцепта = Окр(СуммаВВалютеПлановых / ПлановыйРасход.КоэффициентПересчетаВВалютуПлановых, 2);
			Сумма = Сумма - СуммаВВалютеАкцепта;
			
			СуммаНДСВВалютеПлановых = ПлановыйРасход.СуммаНДС;
			СуммаНДСВВалютеАкцепта = Окр(СуммаНДСВВалютеПлановых / ПлановыйРасход.КоэффициентПересчетаВВалютуПлановых, 2);
			СуммаНДС = СуммаНДС - СуммаНДСВВалютеАкцепта;
			
		КонецЦикла;
		
		Если Сумма <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтруктураПоискаПоСУЕиУслуге, ВыборкаУслугАкцепта);
		ПлановыеРасходы = ТаблицаПлановыхПоСтрокеСУЕиУслуге.НайтиСтроки(СтруктураПоискаПоСУЕиУслуге);
		Для Каждого ПлановыйРасход Из ПлановыеРасходы Цикл
			
			Если Сумма <= 0 Тогда
				Прервать;
			КонецЕсли;
			
			Запись = ПлановыеРасходыВОПолныйФакт.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, ПлановыйРасход,, "Сумма, СуммаНДС");
			
			СуммаВВалютеПлановых = Окр(Сумма * ПлановыйРасход.КоэффициентПересчетаВВалютуПлановых, 2);
			СуммаСписания = Мин(СуммаВВалютеПлановых, ПлановыйРасход.СуммаОстаток);
			Запись.Сумма = СуммаСписания;
			
			СуммаСписанияВРублях = Окр(СуммаСписания * ПлановыйРасход.КоэффициентПересчетаПлановыхРасходовВРубли, 2);
			Запись.СуммаРуб = СуммаСписанияВРублях;
			
			СуммаВВалютеАкцепта = Окр(СуммаСписания / ПлановыйРасход.КоэффициентПересчетаВВалютуПлановых, 2);
			Сумма = Сумма - СуммаВВалютеАкцепта;
			
			СуммаНДСВВалютеПлановых = Окр(СуммаНДС * ПлановыйРасход.КоэффициентПересчетаВВалютуПлановых, 2);
			СуммаНДССписания = Мин(СуммаНДСВВалютеПлановых, ПлановыйРасход.СуммаНДСОстаток);
			Запись.СуммаНДС = СуммаНДССписания;
			
			СуммаНДССписанияВРублях = Окр(СуммаНДССписания * ПлановыйРасход.КоэффициентПересчетаПлановыхРасходовВРубли, 2);
			Запись.СуммаНДСРуб = СуммаНДССписанияВРублях;
			
			СуммаНДСВВалютеАкцепта = Окр(СуммаНДССписания / ПлановыйРасход.КоэффициентПересчетаВВалютуПлановых, 2);
			СуммаНДС = СуммаНДС - СуммаНДСВВалютеАкцепта;
			
		КонецЦикла
		
	КонецЦикла;
	
КонецПроцедуры

//Евросиб Каблов 06.11.2025 #107942
Процедура Акцепт_СформироватьДвиженияСторноПлановыеРасходыВОПолныйФакт(ДанныеАкцепта, ПлановыеРасходыВОПолныйФакт) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&Ссылка КАК Регистратор,
	|	ПлановыеРасходыВО.НомерСтроки КАК НомерСтроки,
	|	ПлановыеРасходыВО.ВидДвижения КАК ВидДвижения,
	|	ПлановыеРасходыВО.Организация КАК Организация,
	|	ПлановыеРасходыВО.ЦФО КАК ЦФО,
	|	ПлановыеРасходыВО.Сделка КАК Сделка,
	|	ПлановыеРасходыВО.Услуга КАК Услуга,
	|	ПлановыеРасходыВО.Поставщик КАК Поставщик,
	|	ПлановыеРасходыВО.Договор КАК Договор,
	|	ПлановыеРасходыВО.Вагон КАК Вагон,
	|	ПлановыеРасходыВО.Контейнер КАК Контейнер,
	|	ПлановыеРасходыВО.ИдентификаторСУЕ КАК ИдентификаторСУЕ,
	|	ПлановыеРасходыВО.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	|	ПлановыеРасходыВО.ВидОперации КАК ВидОперации,
	|	ПлановыеРасходыВО.ТипОперации КАК ТипОперации,
	|	ПлановыеРасходыВО.СтавкаНДС КАК СтавкаНДС,
	|	ПлановыеРасходыВО.Валюта КАК Валюта,
	|	ПлановыеРасходыВО.ИдентификаторСтрокиРасходов КАК ИдентификаторСтрокиРасходов,
	//Евросиб Каблов 05.03.2026 ( #126776
	|	ПлановыеРасходыВО.ИсключатьИзУФД КАК ИсключатьИзУФД,
	//Евросиб Каблов 05.03.2026 )
	|	-ПлановыеРасходыВО.Сумма КАК Сумма,
	|	-ПлановыеРасходыВО.СуммаНДС КАК СуммаНДС,
	|	-ПлановыеРасходыВО.СуммаРуб КАК СуммаРуб,
	|	-ПлановыеРасходыВО.СуммаНДСРуб КАК СуммаНДСРуб,
	|	ПлановыеРасходыВО.ДатаКурсаВалюты КАК ДатаКурсаВалюты,
	|	ВЫБОР
	|		КОГДА ПлановыеРасходыВО.Период = ДАТАВРЕМЯ(3999, 1, 1)
	|			ТОГДА ПлановыеРасходыВО.Период
	|		ИНАЧЕ &Период
	|	КОНЕЦ КАК Период,
	|	ПлановыеРасходыВО.ПлановыеРасходыПоЖДН КАК ПлановыеРасходыПоЖДН,
	|	ПлановыеРасходыВО.Клиент КАК Клиент,
	|	ПлановыеРасходыВО.ДоговорКлиента КАК ДоговорКлиента,
	|	ПлановыеРасходыВО.Реализация КАК Реализация
	|ИЗ
	|	РегистрНакопления.ПлановыеРасходыВОПолныйФакт КАК ПлановыеРасходыВО
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПлановыеРасходыВОПолныйФакт КАК ПлановыеРасходыВО1
	|		ПО ПлановыеРасходыВО.ИдентификаторСтрокиРасходов = ПлановыеРасходыВО1.ИдентификаторСтрокиРасходов
	|			И (ПлановыеРасходыВО1.Списание = ИСТИНА)
	|ГДЕ
	|	ПлановыеРасходыВО.Регистратор = &Акцепт
	|	И ПлановыеРасходыВО1.ИдентификаторСтрокиРасходов ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПлановыеРасходыВО.НомерСтроки";
	
	Запрос.УстановитьПараметр("Акцепт", ДанныеАкцепта.СторнируемыйАкцепт);
	Запрос.УстановитьПараметр("Ссылка", ДанныеАкцепта.Ссылка);
	Запрос.УстановитьПараметр("Период", ДанныеАкцепта.ПериодВО);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ПлановыеРасходыВОПолныйФакт.Загрузить(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры

//Евросиб Каблов 06.11.2025 #107942
Функция Акцепт_ПолучитьТекстЗапросаПлановыеРасходыПолныйФакт()
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	АкцептУслуги.Сделка КАК Сделка,
	|	АкцептУслуги.ИдентификаторСтрокиРасходовВСделке КАК ИдентификаторСтрокиРасходов,
	|	ВЫБОР
	|		КОГДА АкцептУслуги.Ссылка.ПериодВО >= НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(&ДокументПоступление КАК Документ.ПоступлениеТоваровУслуг).ДатаВходящегоДокумента, МЕСЯЦ)
	|			ТОГДА АкцептУслуги.Ссылка.ПериодВО
	|		ИНАЧЕ НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(&ДокументПоступление КАК Документ.ПоступлениеТоваровУслуг).ДатаВходящегоДокумента, МЕСЯЦ)
	|	КОНЕЦ КАК Период,
	|	СУММА(АкцептУслуги.Сумма) КАК Сумма,
	|	СУММА(АкцептУслуги.СуммаНДС) КАК СуммаНДС,
	|	АкцептУслуги.Ссылка.Поступление.ВалютаДокумента КАК АкцептВалюта
	|ПОМЕСТИТЬ ВТ_УслугиАкцепт
	|ИЗ
	|	Документ.Акцепт.Услуги КАК АкцептУслуги
	|ГДЕ
	|	АкцептУслуги.Ссылка = &Ссылка
	|	И АкцептУслуги.Сделка <> ЗНАЧЕНИЕ(Документ.Сделка.ПустаяСсылка)
	|	И АкцептУслуги.ВидЗатрат <> ЗНАЧЕНИЕ(Перечисление.ВидыЗатрат.НезавершенноеПроизводство)
	|	И ВЫБОР
	|			КОГДА ЕСТЬNULL(АкцептУслуги.УчДокумент.Проведен, ЛОЖЬ)
	|				ТОГДА ИСТИНА
	|			КОГДА АкцептУслуги.ВидЗатрат = ЗНАЧЕНИЕ(Перечисление.ВидыЗатрат.КосвенныеЗатраты)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ
	|	И НЕ АкцептУслуги.Сделка.Служебная
	|
	|СГРУППИРОВАТЬ ПО
	|	АкцептУслуги.Сделка,
	|	ВЫБОР
	|		КОГДА АкцептУслуги.Ссылка.ПериодВО >= НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(&ДокументПоступление КАК Документ.ПоступлениеТоваровУслуг).ДатаВходящегоДокумента, МЕСЯЦ)
	|			ТОГДА АкцептУслуги.Ссылка.ПериодВО
	|		ИНАЧЕ НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(&ДокументПоступление КАК Документ.ПоступлениеТоваровУслуг).ДатаВходящегоДокумента, МЕСЯЦ)
	|	КОНЕЦ,
	|	АкцептУслуги.ИдентификаторСтрокиРасходовВСделке,
	|	АкцептУслуги.Ссылка.Поступление.ВалютаДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ВТ_УслугиАкцепт.Период КАК Период,
	|	ПлановыеРасходыОстатки.Организация КАК Организация,
	|	ПлановыеРасходыОстатки.Сделка КАК Сделка,
	|	ПлановыеРасходыОстатки.ЦФО КАК ЦФО,
	|	ПлановыеРасходыОстатки.ИдентификаторСУЕ КАК ИдентификаторСУЕ,
	|	ПлановыеРасходыОстатки.ИдентификаторСтрокиРасходов КАК ИдентификаторСтрокиРасходов,
	|	ПлановыеРасходыОстатки.Поставщик КАК Поставщик,
	|	ПлановыеРасходыОстатки.Договор КАК Договор,
	|	ПлановыеРасходыОстатки.Услуга КАК Услуга,
	|	ПлановыеРасходыОстатки.Вагон КАК Вагон,
	|	ПлановыеРасходыОстатки.Контейнер КАК Контейнер,
	|	ПлановыеРасходыОстатки.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	|	ПлановыеРасходыОстатки.ВидОперации КАК ВидОперации,
	|	ПлановыеРасходыОстатки.ТипОперации КАК ТипОперации,
