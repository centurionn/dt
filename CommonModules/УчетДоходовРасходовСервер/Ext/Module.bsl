//Акцепт. Запрос фактических расходов.
Функция Акцепт_ПолучитьТекстЗапросаФактическиеРасходы(ВидУчета)
	ТекстЗапроса =	
	"ВЫБРАТЬ
	|	ПоступлениеТоваровУслуг.Ссылка КАК ПТУ,
	|	ПоступлениеТоваровУслуг.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
	|	ПоступлениеТоваровУслуг.ВалютаДокумента КАК ВалютаДокумента,
	|	ЕСТЬNULL(КурсыВалютПоступления.Курс, 1) КАК КурсВалюты,
	|	ЕСТЬNULL(КурсыВалютПоступления.Кратность, 1) КАК КратностьВалюты
	|ПОМЕСТИТЬ ПоступлениеТоваровУслуг
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютПоступления
	|		ПО ПоступлениеТоваровУслуг.ВалютаДокумента = КурсыВалютПоступления.Валюта
	|			И ПоступлениеТоваровУслуг.ДатаВходящегоДокумента = КурсыВалютПоступления.Период
	|ГДЕ
	|	ПоступлениеТоваровУслуг.Ссылка = &ДокументПоступление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА АкцептУслуги.ВидЗатрат = ЗНАЧЕНИЕ(Перечисление.ВидыЗатрат.НезавершенноеПроизводство)
	|				ИЛИ НЕ ЕСТЬNULL(АкцептУслуги.УчДокумент.Проведен, ЛОЖЬ)
	|					И АкцептУслуги.ВидЗатрат <> ЗНАЧЕНИЕ(Перечисление.ВидыЗатрат.КосвенныеЗатраты)
	|				ИЛИ АкцептУслуги.Сделка.Служебная
	|			ТОГДА ДАТАВРЕМЯ(3999, 1, 1)
	|		ИНАЧЕ ВЫБОР
	|				КОГДА АкцептУслуги.Ссылка.ПериодВО >= НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(&ДокументПоступление КАК Документ.ПоступлениеТоваровУслуг).ДатаВходящегоДокумента, МЕСЯЦ)
	|					ТОГДА АкцептУслуги.Ссылка.ПериодВО
	|				ИНАЧЕ НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(&ДокументПоступление КАК Документ.ПоступлениеТоваровУслуг).ДатаВходящегоДокумента, МЕСЯЦ)
	|			КОНЕЦ
	|	КОНЕЦ КАК Период,
	|	АкцептУслуги.Ссылка.Организация КАК Организация,
	//Евросиб Каблов 05.09.2024 ( Ticket#0355763
	//|	АкцептУслуги.Ссылка.Поступление.ЦФО КАК ЦФО,
	|	ВЫБОР
	|		КОГДА НЕ СделкаДоходы.УчДокумент.Ссылка ЕСТЬ NULL
	|			ТОГДА СделкаДоходы.УчДокумент.ЦФО
	|		КОГДА НЕ СделкаСвязьУчетныхЕдиниц.Калькуляция.ЦФО ЕСТЬ NULL
	|			ТОГДА СделкаСвязьУчетныхЕдиниц.Калькуляция.ЦФО
	|		ИНАЧЕ АкцептУслуги.Сделка.ЦФО
	|	КОНЕЦ КАК ЦФО,
	//Евросиб Каблов 05.09.2024 )
	|	АкцептУслуги.Сделка КАК Сделка,
	|	СделкаРасходы.СтрокаСвязьУчетныхЕдиниц КАК ИдентификаторСУЕ,
	//Евросиб Каблов 14.10.2025 ( #107942
	|	АкцептУслуги.ИдентификаторСтрокиРасходовВСделке КАК СтрокаРасходовСделки,
	|	АкцептУслуги.ПериодУУ КАК ПериодУУ,
	//Евросиб Каблов 14.10.2025 ) #107942
	|	АкцептУслуги.Ссылка.Поступление.Контрагент КАК Поставщик,
	|	АкцептУслуги.Ссылка.Поступление.ДоговорКонтрагента КАК Договор,
	|	АкцептУслуги.НоменклатураСделки КАК Услуга,
	|	АкцептУслуги.Номенклатура КАК УслугаФакт,
	|	ЕСТЬNULL(СделкаРасходы.Вагон, АкцептУслуги.Вагон) КАК Вагон,
	|	ЕСТЬNULL(СделкаРасходы.Контейнер, АкцептУслуги.Контейнер) КАК Контейнер,
	|	АкцептУслуги.Сумма КАК Сумма,
	|	АкцептУслуги.СуммаНДС КАК СуммаНДС,
	|	АкцептУслуги.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	|	АкцептУслуги.ПоступлениеСтавкаНДС КАК СтавкаНДС,
	|	Поступление.ВалютаДокумента КАК Валюта,
	|	Поступление.КурсВалюты КАК КурсВалюты,
	|	Поступление.КратностьВалюты КАК КратностьВалюты,
	|	Поступление.ДатаВходящегоДокумента КАК ДатаКурсаВалюты,
	|	ВЫРАЗИТЬ(АкцептУслуги.Сумма * Поступление.КурсВалюты / Поступление.КратностьВалюты КАК ЧИСЛО(15, 2)) КАК СуммаРуб,
	|	ВЫРАЗИТЬ(АкцептУслуги.СуммаНДС * Поступление.КурсВалюты / Поступление.КратностьВалюты КАК ЧИСЛО(15, 2)) КАК СуммаНДСРуб,
	|	Поступление.ПТУ КАК Поступление,
	|	ВЫБОР
	|		КОГДА АкцептУслуги.ВидЗатрат = ЗНАЧЕНИЕ(Перечисление.ВидыЗатрат.КосвенныеЗатраты)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидОперацииРасходов.СобственныеЗатраты)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидОперацииРасходов.ПрямыеРасходы)
	|	КОНЕЦ КАК ВидОперации,
	|	АкцептУслуги.ВидРасходов КАК ТипОперации,
	|	ЕСТЬNULL(АкцептУслуги.УчДокумент.Контрагент, СделкаСвязьУчетныхЕдиниц.Клиент) КАК Клиент,
	|	ЕСТЬNULL(АкцептУслуги.УчДокумент.ДоговорКонтрагента, СделкаСвязьУчетныхЕдиниц.Договор) КАК ДоговорКлиента,
	|	АкцептУслуги.УчДокумент КАК Реализация
	|ИЗ
	|	Документ.Акцепт.Услуги КАК АкцептУслуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.Расходы КАК СделкаРасходы
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|			ПО СделкаРасходы.СтрокаСвязьУчетныхЕдиниц = СделкаСвязьУчетныхЕдиниц.ГУИД
	|				И СделкаРасходы.Ссылка = СделкаСвязьУчетныхЕдиниц.Ссылка
	|				И (НЕ СделкаСвязьУчетныхЕдиниц.НеАктивна)
	//Евросиб Каблов 05.09.2024 ( Ticket#0355763
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьДоходовИРасходов КАК СделкаСвязьДоходовИРасходов
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.Доходы КАК СделкаДоходы
	|			ПО СделкаСвязьДоходовИРасходов.Ссылка = СделкаДоходы.Ссылка
	|				И СделкаСвязьДоходовИРасходов.Доходы = СделкаДоходы.ГУИД
	|		ПО СделкаРасходы.Ссылка = СделкаСвязьДоходовИРасходов.Ссылка
	|			И СделкаРасходы.ГУИД = СделкаСвязьДоходовИРасходов.Расходы
	//Евросиб Каблов 05.09.2024 )
	|		ПО АкцептУслуги.Сделка = СделкаРасходы.Ссылка
	|			И АкцептУслуги.ИдентификаторСтрокиРасходовВСделке = СделкаРасходы.ГУИД,
	|	ПоступлениеТоваровУслуг КАК Поступление
	|ГДЕ
	|	АкцептУслуги.Ссылка = &Ссылка
	|	И НЕ АкцептУслуги.Сделка = ЗНАЧЕНИЕ(Документ.Сделка.ПустаяСсылка)";
	
	ПодстрокаПоиска = 
	"ВЫБОР
	|		КОГДА АкцептУслуги.ВидЗатрат = ЗНАЧЕНИЕ(Перечисление.ВидыЗатрат.НезавершенноеПроизводство)
	|				ИЛИ НЕ ЕСТЬNULL(АкцептУслуги.УчДокумент.Проведен, ЛОЖЬ)
	|					И АкцептУслуги.ВидЗатрат <> ЗНАЧЕНИЕ(Перечисление.ВидыЗатрат.КосвенныеЗатраты)
	|				ИЛИ АкцептУслуги.Сделка.Служебная
	|			ТОГДА ДАТАВРЕМЯ(3999, 1, 1)
	|		ИНАЧЕ ВЫБОР
	|				КОГДА АкцептУслуги.Ссылка.ПериодВО >= НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(&ДокументПоступление КАК Документ.ПоступлениеТоваровУслуг).ДатаВходящегоДокумента, МЕСЯЦ)
	|					ТОГДА АкцептУслуги.Ссылка.ПериодВО
	|				ИНАЧЕ НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(&ДокументПоступление КАК Документ.ПоступлениеТоваровУслуг).ДатаВходящегоДокумента, МЕСЯЦ)
	|			КОНЕЦ
	|	КОНЕЦ";
	Если ВидУчета = "УУ" Тогда                                  
		ПодстрокаЗамены = 	
		"ВЫБОР
		|		КОГДА АкцептУслуги.ВидЗатрат = ЗНАЧЕНИЕ(Перечисление.ВидыЗатрат.НезавершенноеПроизводство)
		|				ИЛИ НЕ ЕСТЬNULL(АкцептУслуги.УчДокумент.Проведен, ЛОЖЬ)
		|					И АкцептУслуги.ВидЗатрат <> ЗНАЧЕНИЕ(Перечисление.ВидыЗатрат.КосвенныеЗатраты)
		|				ИЛИ АкцептУслуги.Сделка.Служебная
		|			ТОГДА ДАТАВРЕМЯ(3999, 1, 1)
		|		КОГДА АкцептУслуги.ПериодУУ > АкцептУслуги.Ссылка.ПериодВО
		|			ТОГДА ВЫБОР
		|					КОГДА АкцептУслуги.Ссылка.ПериодВО >= НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(&ДокументПоступление КАК Документ.ПоступлениеТоваровУслуг).ДатаВходящегоДокумента, МЕСЯЦ)
		|						ТОГДА АкцептУслуги.Ссылка.ПериодВО
		|					ИНАЧЕ НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(&ДокументПоступление КАК Документ.ПоступлениеТоваровУслуг).ДатаВходящегоДокумента, МЕСЯЦ)
		|				КОНЕЦ
		|		КОГДА АкцептУслуги.ПериодУУ = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ВЫБОР
		|					КОГДА АкцептУслуги.ВидЗатрат = ЗНАЧЕНИЕ(перечисление.видыЗатрат.КосвенныеЗатраты)
		|						ТОГДА НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(&ДокументПоступление КАК Документ.ПоступлениеТоваровУслуг).ДатаВходящегоДокумента, МЕСЯЦ)
		|					КОГДА АкцептУслуги.УчДокумент.Проведен
		|						ТОГДА АкцептУслуги.УчДокумент.ДатаОказанияУслуги
		|					ИНАЧЕ ДАТАВРЕМЯ(3999, 1, 1)
		|				КОНЕЦ
		|		ИНАЧЕ АкцептУслуги.ПериодУУ
		|	КОНЕЦ";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ПодстрокаПоиска, ПодстрокаЗамены);
	ИначеЕсли ВидУчета = "БУ" Тогда 
//Евросиб Гудкова( 18.02.2022 Ticket№ периоды акцепта могут быть меньше даты ВСФ. костыль для перепроведения прошлых периодов
//было		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ПодстрокаПоиска, "АкцептУслуги.Ссылка.ПериодБУ");	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ПодстрокаПоиска, "ВЫБОР
		|		КОГДА АкцептУслуги.Ссылка.ПериодБУ >= НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(&ДокументПоступление КАК Документ.ПоступлениеТоваровУслуг).ДатаВходящегоДокумента, МЕСЯЦ)
		|			ТОГДА АкцептУслуги.Ссылка.ПериодБУ
		|		ИНАЧЕ НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(&ДокументПоступление КАК Документ.ПоступлениеТоваровУслуг).ДатаВходящегоДокумента, МЕСЯЦ)
		|	КОНЕЦ");
// Евросиб Гудкова)
	КонецЕсли;
	Возврат ТекстЗапроса;
КонецФункции

Процедура Акцепт_УстановитьПараметрыЗапросаРасходы(Запрос, ОбъектАкцепт)
	
	Запрос.УстановитьПараметр("Ссылка", ОбъектАкцепт.Ссылка);
	Если ТипЗнч(ОбъектАкцепт.Поступление) = Тип("ДокументСсылка.КорректировкаПоступления") Тогда
		Поступление = БухгалтерскийУчетПереопределяемый.ПолучитьИсправляемыйДокументПоступления(ОбъектАкцепт.Поступление, Истина);
	Иначе
		Поступление = ОбъектАкцепт.Поступление;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДокументПоступление", Поступление);
	
КонецПроцедуры

