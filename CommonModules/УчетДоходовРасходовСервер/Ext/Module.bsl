Процедура ОК_УстановитьПараметрыЗапросаФактическиеДоходы(Запрос, ОбъектОК)
	
	Запрос.УстановитьПараметр("Ссылка", ОбъектОК.Ссылка);
	Запрос.УстановитьПараметр("ВалютаРегл", Константы.ВалютаРегламентированногоУчета.Получить());
	Запрос.УстановитьПараметр("ДатаКурса", ОбъектОК.ДатаДокумента);
		
КонецПроцедуры
 
