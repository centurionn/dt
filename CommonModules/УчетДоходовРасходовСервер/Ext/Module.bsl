	|	НастройкиОбменов.КоличествоЗаписейВПорцииДанных КАК КоличествоЗаписейВПорцииДанных
	|ИЗ
	|	Справочник.НастройкиОбменов КАК НастройкиОбменов
	|ГДЕ
	|	НастройкиОбменов.УзелОбмена = &УзелОбмена
	|	И НастройкиОбменов.ИмяМетода = &ИмяМетода";
	Запрос.УстановитьПараметр("УзелОбмена", Перечисления.УзлыОбмена.УПП);
	Запрос.УстановитьПараметр("ИмяМетода", "УФД");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.КоличествоЗаписейВПорцииДанных > 0 Тогда
		КоличествоЗаписейВПорцииДанных = Выборка.КоличествоЗаписейВПорцииДанных;
	Иначе
		КоличествоЗаписейВПорцииДанных = 1000;
	КонецЕсли;
	
	Возврат КоличествоЗаписейВПорцииДанных;
	
