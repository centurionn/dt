	|	КорректировкаРеализацииРасшифровкаУслугПоТС.Контейнер,
	|	КорректировкаРеализацииРасшифровкаУслугПоТС.Вагон,
	//Евросиб Каблов 16.10.2025 ( #121694
	|	NULL,
	//Евросиб Каблов 16.10.2025 ) #121694
	|	ВТ_Документы.ОбщееЧислоУЕ,
	|	ВТ_Документы.АктуальнаяРеализация
	|ИЗ
	|	ВТ_Документы КАК ВТ_Документы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации.РасшифровкаУслугПоТС КАК КорректировкаРеализацииРасшифровкаУслугПоТС
	|		ПО ВТ_Документы.АктуальнаяРеализация = КорректировкаРеализацииРасшифровкаУслугПоТС.Ссылка
	|			И (НЕ ВТ_Документы.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование))";
	
	Запрос.УстановитьПараметр("Ссылка", ОбъектСчет.Ссылка);
	Запрос.УстановитьПараметр("УслугаФрахт", Константы.УслугаФрахтаДляКалькуляции.Получить());
	
	//Евросиб Каблов 16.05.2023 (
	ВремяНачалаЗамера = ОценкаПроизводительности.НачатьЗамерВремени();
	//Евросиб Каблов 16.05.2023 )
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	//Евросиб Каблов 16.05.2023 (
	Комментарий = СтрШаблон("Счет %1/%2 Вес = кол-во строк ""ДокументыОснования""", ОбъектСчет.Номер, Формат(ОбъектСчет.Дата, "ДФ=yyyy"));
	ОценкаПроизводительности.ЗакончитьЗамерВремени("ВыполнениеЗапросаПлановыеДоходыПоСчетам", ВремяНачалаЗамера, ОбъектСчет.ДокументыОснования.Количество(), Комментарий);
	//Евросиб Каблов 16.05.2023 )
	
	ТаблицаУслуг = РезультатыЗапроса[9].Выгрузить();
	ТаблицаУчетныхЕдиниц = РезультатыЗапроса[10].Выгрузить();
	ТаблицаВСделках = РезультатыЗапроса[11].Выгрузить();
	//Субботин 72177 11.08.2023 Начало
	УчЕд_РеализацийПоСделке = РезультатыЗапроса[15].Выгрузить();
	//Субботин 72177 11.08.2023 Конец
	
	Если ЗначениеЗаполнено(ОбъектСчет.ДатаДокумента) Тогда
		ДатаДокумента = ОбъектСчет.ДатаДокумента;
	Иначе
		ДатаДокумента = ОбъектСчет.Дата;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбъектСчет.ДатаКурса) Тогда
		ДатаКурса = ОбъектСчет.ДатаКурса;
	Иначе
		ДатаКурса = ДатаДокумента;
	КонецЕсли;
	
	ВалютаДокумента = ОбъектСчет.ВалютаДокумента;
	
	ВидДоходовДопУслуга = Перечисления.ВидыЗадолженности.ДопУслуга;
	ВидДоходовДопУслугаВР = Перечисления.ВидыЗадолженности.ДопУслугаВР;
	//Субботин 72177 18.08.2023 Начало
	ВидДоходаПустой  =	Перечисления.ВидыЗадолженности.ПустаяСсылка();
	//Субботин 72177 18.08.2023 Конец
	
	ПараметрыПоискаВСделке = Новый Структура("Заявка, Вагон, Контейнер");
	
	//Субботин 72177 11.08.2023 Начало
	Если УчЕд_РеализацийПоСделке.Количество() >0 Тогда
		Если УчЕд_РеализацийПоСделке[0].ОбщееЧислоУЕ = 0 тогда
			Возврат
		КонецЕсли;
	КонецЕсли;
	//Субботин 72177 11.08.2023 Конец
	
	Для Каждого СтрокаПоУслуге Из ТаблицаУслуг Цикл
		
		СтрокиПоУчетнымЕдиницам = ТаблицаУчетныхЕдиниц.НайтиСтроки(Новый Структура("Идентификатор", СтрокаПоУслуге.Идентификатор));		
		КоличествоУчетныхЕдиниц = СтрокиПоУчетнымЕдиницам.Количество();
		
		Если КоличествоУчетныхЕдиниц = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СуммаСНДС = ?(ОбъектСчет.СуммаВключаетНДС, СтрокаПоУслуге.Сумма, СтрокаПоУслуге.Сумма + СтрокаПоУслуге.СуммаНДС); 
		
		Количество = Окр(СтрокаПоУслуге.Количество / КоличествоУчетныхЕдиниц, 3);
		Сумма = Окр(СуммаСНДС / КоличествоУчетныхЕдиниц, 2);
		СуммаНДС = Окр(СтрокаПоУслуге.СуммаНДС / КоличествоУчетныхЕдиниц, 2);
		
		КоличествоОстаток = СтрокаПоУслуге.Количество;
		СуммаОстаток = СуммаСНДС;
		СуммаНДСОстаток = СтрокаПоУслуге.СуммаНДС;
		
		
		
		Если СтрокаПоУслуге.ВидДоходов = ВидДоходовДопУслуга Или СтрокаПоУслуге.ВидДоходов = ВидДоходовДопУслугаВР или СтрокаПоУслуге.ВидДоходов = ВидДоходаПустой Тогда
			ПараметрыПоискаВСделке.Вставить("Услуга", СтрокаПоУслуге.Номенклатура);
		Иначе
			ПараметрыПоискаВСделке.Удалить("Услуга");
		КонецЕсли;
		
		Запись = Неопределено;
		Для Каждого СтрокаПоУчетнойЕдинице Из СтрокиПоУчетнымЕдиницам Цикл
			
			КоличествоОстаток = КоличествоОстаток - Количество;
			СуммаОстаток = СуммаОстаток - Сумма;
			СуммаНДСОстаток = СуммаНДСОстаток - СуммаНДС;
			//Субботин 72177 Начало
			Готовность = Неопределено;
			ПараметрыПоискаУЕ = Новый Структура;
			Если ЗначениеЗаполнено(СтрокаПоУчетнойЕдинице.Вагон) тогда
				ПараметрыПоискаУЕ.Вставить("Вагон", СтрокаПоУчетнойЕдинице.Вагон); 
			ИначеЕсли ЗначениеЗаполнено(СтрокаПоУчетнойЕдинице.Контейнер) тогда
				ПараметрыПоискаУЕ.Вставить("Контейнер", СтрокаПоУчетнойЕдинице.Контейнер);
			//Евросиб Каблов 16.10.2025 ( #121694
			ИначеЕсли ЗначениеЗаполнено(СтрокаПоУчетнойЕдинице.Номенклатура) Тогда
				ПараметрыПоискаУЕ.Вставить("Услуга", СтрокаПоУчетнойЕдинице.Номенклатура);
			//Евросиб Каблов 16.10.2025 ) #121694
			КонецЕсли;
			
			ОтфактурованныеУЕ = УчЕд_РеализацийПоСделке.НайтиСтроки(ПараметрыПоискаУЕ);
			Если ОтфактурованныеУЕ.Количество() <> 0 Тогда 
				Продолжить;
			КонецЕсли;
			//Субботин 72177 11.08.2023 Конец
			
		    ЗаполнитьЗначенияСвойств(ПараметрыПоискаВСделке, СтрокаПоУчетнойЕдинице, "Заявка, Контейнер, Вагон");
			СтрокиВСделках = ТаблицаВСделках.НайтиСтроки(ПараметрыПоискаВСделке);
			Если СтрокиВСделках.Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;
			
			//Субботин 72177 04.08.2023 Начало
			Если ПараметрыПоискаВСделке.Свойство("Услуга") тогда
				СтруктураПоискаГотовности  = Новый Структура("Номенклатура,Заявка, Контейнер, Вагон");
				ЗаполнитьЗначенияСвойств(СтруктураПоискаГотовности, СтрокаПоУчетнойЕдинице, "Номенклатура, Заявка, Контейнер, Вагон");
				ГотовностьВСделках = ТаблицаВСделках.НайтиСтроки(СтруктураПоискаГотовности);
				Если ГотовностьВСделках.Количество() <> 0 Тогда
					Готовность = ГотовностьВСделках[0].ГотовоКВыставлению;
				КонецЕсли;
			КонецЕсли;
			//Субботин 72177 04.08.2023 Конец
			
			Запись = ПлановыеДоходыПоАвансовымСчетам.Добавить();
			Запись.Период = ДатаДокумента;
			Запись.Услуга = СтрокаПоУчетнойЕдинице.Номенклатура;
			Запись.Счет = СтрокаПоУчетнойЕдинице.Ссылка;
			Запись.Заявка = СтрокаПоУчетнойЕдинице.Заявка;
			Запись.ЕдиницаИзмерения = СтрокаПоУчетнойЕдинице.ЕдиницаИзмерения;
			Запись.ВидДоходов = СтрокаПоУчетнойЕдинице.ВидДоходов;
			Запись.Валюта = ВалютаДокумента;
			Запись.ДатаКурсаВалюты = ДатаКурса;
			Запись.СтавкаНДС = СтрокаПоУчетнойЕдинице.СтавкаНДС;
			Запись.Вагон = СтрокаПоУчетнойЕдинице.Вагон;
			Запись.Контейнер = СтрокаПоУчетнойЕдинице.Контейнер;
			//Субботин 72177 04.08.2023 Начало
			Запись.ГотовоКВыставлению = Готовность;
			//Субботин 72177 04.08.2023 Конец
			
			Запись.Количество = Количество;
			Запись.Сумма = Сумма;
			Запись.СуммаНДС = СуммаНДС;			
			
		КонецЦикла;
		
		Если Запись <> Неопределено Тогда
			
			Если КоличествоОстаток <> 0 Тогда
				Запись.Количество = Количество + КоличествоОстаток;
			КонецЕсли;
			
			Если СуммаОстаток <> 0 Тогда
				Запись.Сумма = Сумма + СуммаОстаток;
			КонецЕсли;
			
			Если СуммаНДСОстаток <> 0 Тогда
				Запись.СуммаНДС = СуммаНДС + СуммаОстаток;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область УФД

Процедура УФД_СформироватьЗаписиПоЗакрытиюПериода() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.ФормированиеЗаписейУФД);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗакрытыеПериодыСрезПоследних.Период КАК Период,
	|	ЗакрытыеПериодыСрезПоследних.Регистратор КАК Регистратор,
	|	ЗакрытыеПериодыСрезПоследних.Организация КАК Организация
	|ПОМЕСТИТЬ ЗакрытыеПериоды
	|ИЗ
	|	РегистрСведений.ЗакрытыеПериоды.СрезПоследних(, ) КАК ЗакрытыеПериодыСрезПоследних
	|ГДЕ
	|	ЗакрытыеПериодыСрезПоследних.Период >= &ДатаНачалаУчетаПлановыхРасходовПолныйФакт
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗакрытыеПериоды.Период КАК Период,
	|	ЗакрытыеПериоды.Регистратор КАК Регистратор,
	|	ЗакрытыеПериоды.Организация КАК Организация,
	|	ЕСТЬNULL(СформированыПлановыеРасходыПолныйФакт.Значение, ЛОЖЬ) КАК СформированыПлановыеРасходыПолныйФакт,
	|	ЕСТЬNULL(ЗафиксированыПлановыеРасходыВОПолныйФакт.Значение, ЛОЖЬ) КАК ЗафиксированыПлановыеРасходыПолныйФакт,
	|	ЕСТЬNULL(СформированыЗаписиУФД.Значение, ЛОЖЬ) КАК СформированыЗаписиУФД
	|ИЗ
	|	ЗакрытыеПериоды КАК ЗакрытыеПериоды
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхАналитикДокументов КАК СформированыПлановыеРасходыПолныйФакт
	|		ПО ЗакрытыеПериоды.Регистратор = СформированыПлановыеРасходыПолныйФакт.Документ
	|			И (СформированыПлановыеРасходыПолныйФакт.Аналитика = &АналитикаСформированыПлановыеРасходыВОПолныйФакт)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхАналитикДокументов КАК ЗафиксированыПлановыеРасходыВОПолныйФакт
	|		ПО ЗакрытыеПериоды.Регистратор = ЗафиксированыПлановыеРасходыВОПолныйФакт.Документ
	|			И (ЗафиксированыПлановыеРасходыВОПолныйФакт.Аналитика = &АналитикаЗафиксированыПлановыеРасходыВОПолныйФакт)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхАналитикДокументов КАК СформированыЗаписиУФД
	|		ПО ЗакрытыеПериоды.Регистратор = СформированыЗаписиУФД.Документ
	|			И (СформированыЗаписиУФД.Аналитика = &АналитикаСформированыЗаписиУФД)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период,
	|	Организация,
	|	Регистратор";
	
	АналитикаСформированыПлановыеРасходыВОПолныйФакт = ПланыВидовХарактеристик.ДополнительныеАналитикиДокументов.СформированыПлановыеРасходыВОПолныйФакт;
	АналитикаЗафиксированыПлановыеРасходыВОПолныйФакт = ПланыВидовХарактеристик.ДополнительныеАналитикиДокументов.ЗафиксированыПлановыеРасходыВОПолныйФакт;
	АналитикаСформированыЗаписиУФД = ПланыВидовХарактеристик.ДополнительныеАналитикиДокументов.СформированыЗаписиУФД;
	
	Запрос.УстановитьПараметр("АналитикаСформированыПлановыеРасходыВОПолныйФакт", АналитикаСформированыПлановыеРасходыВОПолныйФакт);
	Запрос.УстановитьПараметр("АналитикаЗафиксированыПлановыеРасходыВОПолныйФакт", АналитикаЗафиксированыПлановыеРасходыВОПолныйФакт);
	Запрос.УстановитьПараметр("АналитикаСформированыЗаписиУФД", АналитикаСформированыЗаписиУФД);
	
	Запрос.УстановитьПараметр("ДатаНачалаУчетаПлановыхРасходовПолныйФакт", Константы.ДатаНачалаУчетаПлановыхРасходовПолныйФакт.Получить());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.СформированыПлановыеРасходыПолныйФакт <> Истина Тогда
			СформироватьПлановыеРасходыВОПолныйФакт(Выборка.Период, Выборка.Организация);			
			РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ЗаписатьАналитикуДокумента(Выборка.Регистратор, АналитикаСформированыПлановыеРасходыВОПолныйФакт, Истина);
		КонецЕсли;
		
		Если Выборка.ЗафиксированыПлановыеРасходыПолныйФакт <> Истина Тогда			
			СформироватьФиксациюИзмененийПлановыхРасходовВОПолныйФакт(Выборка.Регистратор);			
			РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ЗаписатьАналитикуДокумента(Выборка.Регистратор, АналитикаЗафиксированыПлановыеРасходыВОПолныйФакт, Истина);			
		КонецЕсли;
		
		Если Выборка.СформированыЗаписиУФД <> Истина Тогда
			
			НаборЗаписей = РегистрыСведений.УчетФактическихУправленческихДанных.СоздатьНаборЗаписей();
			ОтборПоПериоду = НаборЗаписей.Отбор.ПериодВО;
			ОтборПоПериоду.Установить(Выборка.Период, Истина);
			НаборЗаписей.Записать();
			
			УФД_СформироватьЗаписиПоФактическимДоходамЗаПериод(Выборка.Период);
			УФД_СформироватьЗаписиПоФактическимРасходамЗаПериод(Выборка.Период);
			УФД_СформироватьЗаписиПоПлановымРасходамЗаПериод(Выборка.Период);
			РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ЗаписатьАналитикуДокумента(Выборка.Регистратор, АналитикаСформированыЗаписиУФД, Истина);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СформироватьПлановыеРасходыВОПолныйФакт(ПериодВО, Организация) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДокАкцепт.Ссылка КАК Ссылка,
	|	ДокАкцепт.МоментВремени КАК МоментВремени,
	|	ДокАкцепт.СторнируемыйАкцепт КАК СторнируемыйАкцепт,
	|	ДокАкцепт.ПериодВО КАК ПериодВО,
	|	ДокАкцепт.Поступление КАК Поступление
	|ИЗ
	|	Документ.Акцепт КАК ДокАкцепт
	|ГДЕ
	|	ДокАкцепт.ПериодВО МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ДокАкцепт.Организация = &Организация
	|	И ДокАкцепт.Проведен
	|
	|УПОРЯДОЧИТЬ ПО
	|	МоментВремени";
	
	Запрос.УстановитьПараметр("ДатаНачала", НачалоМесяца(ПериодВО));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецМесяца(ПериодВО));
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ПлановыеРасходыПолныйФакт = РегистрыНакопления.ПлановыеРасходыВОПолныйФакт.СоздатьНаборЗаписей();
		ПлановыеРасходыПолныйФакт.Отбор.Регистратор.Значение = Выборка.Ссылка;
		ПлановыеРасходыПолныйФакт.Отбор.Регистратор.Использование = Истина;
			
		Если ЗначениеЗаполнено(Выборка.СторнируемыйАкцепт) Тогда
			Акцепт_СформироватьДвиженияСторноПлановыеРасходыВОПолныйФакт(Выборка, ПлановыеРасходыПолныйФакт);
		Иначе
			Акцепт_СформироватьДвиженияПлановыеРасходыВОПолныйФакт(Выборка, ПлановыеРасходыПолныйФакт);
		КонецЕсли;
		
		ПлановыеРасходыПолныйФакт.Записать();
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СписаниеПлановыхРасходов.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СписаниеПлановыхРасходов КАК СписаниеПлановыхРасходов
	|ГДЕ
	|	СписаниеПлановыхРасходов.ПериодСписания = &ПериодСписания
	|	И СписаниеПлановыхРасходов.Организация = &Организация
	|	И СписаниеПлановыхРасходов.Проведен
	|	И СписаниеПлановыхРасходов.ВО
	|
	|УПОРЯДОЧИТЬ ПО
	|	СписаниеПлановыхРасходов.Дата";
	
	Запрос.УстановитьПараметр("ПериодСписания", ПериодВО);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	ВыборкаДокументовСписания = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДокументовСписания.Следующий() Цикл
		СписаниеОбъект = ВыборкаДокументовСписания.Ссылка.ПолучитьОбъект();		
		ТаблицаСписания = ПолучитьТаблицуСписанияПлановыхРасходовПолныйФакт(СписаниеОбъект);
		Списание_СформироватьДвиженияПлановыеРасходыПолныйФакт(СписаниеОбъект, ТаблицаСписания);
		//Если ЗначениеЗаполнено(ТаблицаСписания) Тогда						
		//	ТаблицаСписания.Свернуть("Сделка, Валюта", "СуммаВО, СуммаВОРуб, СуммаУУ, СуммаУУРуб");
		//	СписаниеОбъект.РасходыКСписанию.Загрузить(ТаблицаСписания);
		//	СписаниеОбъект.ОбменДанными.Загрузка = Истина;
		//	СписаниеОбъект.Записать(РежимЗаписиДокумента.Запись);			
		//КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура СформироватьФиксациюИзмененийПлановыхРасходовВОПолныйФакт(ЗакрытиеПериодаСсылка) Экспорт
	
	ДокОбъект = ЗакрытиеПериодаСсылка.ПолучитьОбъект();
	УчетДоходовРасходовСервер.ЗП_СформироватьДвиженияФиксацияИзмененияПлановыхРасходовВОПолныйФакт(ДокОбъект);
	ДокОбъект.Движения.Записать();
	
КонецПроцедуры

Процедура УФД_СформироватьЗаписиПоФактическимДоходамЗаПериод(ПериодВО)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ФактическиеДоходыВО.Период КАК ПериодВО,
	|	ВЫБОР
	|		КОГДА ГОД(ФактическиеДоходыВО.Регистратор.ДатаДокумента) < ГОД(ФактическиеДоходыВО.Период)
	|			ТОГДА &БлокУФДДоходыПрошлыхЛет
	|		ИНАЧЕ &БлокУФДДоходы
	|	КОНЕЦ КАК БлокУФД,
	|	ФактическиеДоходыВО.Регистратор КАК Регистратор,
	|	ФактическиеДоходыВО.Сделка КАК Сделка,
	|	ФактическиеДоходыВО.Услуга КАК Услуга,
	|	ФактическиеДоходыВО.Клиент КАК Клиент,
	|	ФактическиеДоходыВО.ИдентификаторСУЕ КАК ИдентификаторСУЕ,
	|	ФактическиеДоходыВО.Вагон КАК Вагон,
	|	ФактическиеДоходыВО.Контейнер КАК Контейнер,
	|	ФактическиеДоходыВО.СтрокаДоходовСделки КАК СтрокаДоходовСделки,
	|	ФактическиеДоходыВО.СуммаРуб - ФактическиеДоходыВО.СуммаНДСРуб КАК СуммаБезНДСРуб,
	|	ФактическиеДоходыВО.МоментВремени КАК МоментВремени,
	|	ФактическиеДоходыВО.Договор КАК Договор
	|ПОМЕСТИТЬ ФактическиеДоходыВО
	|ИЗ
	|	РегистрНакопления.ФактическиеДоходыВО КАК ФактическиеДоходыВО
	|ГДЕ
	|	ФактическиеДоходыВО.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ФактическиеДоходыВО.ТипОперации = &ТипОперацииВыручка
	|	И НЕ ФактическиеДоходыВО.Регистратор ССЫЛКА Документ.КорректировкаРеализации
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ФактическиеДоходыВО.Период,
	|	ВЫБОР
	|		КОГДА ГОД(КорректировкаРеализации.ИсходныйДокументРеализации.ДатаДокумента) < ГОД(ФактическиеДоходыВО.Период)
	|			ТОГДА &БлокУФДДоходыПрошлыхЛет
	|		ИНАЧЕ &БлокУФДДоходы
	|	КОНЕЦ,
	|	КорректировкаРеализации.ИсходныйДокументРеализации,
	|	ФактическиеДоходыВО.Сделка,
	|	ФактическиеДоходыВО.Услуга,
	|	ФактическиеДоходыВО.Клиент,
	|	ФактическиеДоходыВО.ИдентификаторСУЕ,
	|	ФактическиеДоходыВО.Вагон,
	|	ФактическиеДоходыВО.Контейнер,
	|	ФактическиеДоходыВО.СтрокаДоходовСделки,
	|	ФактическиеДоходыВО.СуммаРуб - ФактическиеДоходыВО.СуммаНДСРуб,
	|	ФактическиеДоходыВО.МоментВремени,
	|	ФактическиеДоходыВО.Договор
	|ИЗ
	|	РегистрНакопления.ФактическиеДоходыВО КАК ФактическиеДоходыВО
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации КАК КорректировкаРеализации
	|		ПО ФактическиеДоходыВО.Регистратор = КорректировкаРеализации.Ссылка
	|ГДЕ
	|	ФактическиеДоходыВО.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ФактическиеДоходыВО.ТипОперации = &ТипОперацииВыручка
	|	И ФактическиеДоходыВО.Регистратор ССЫЛКА Документ.КорректировкаРеализации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВременнаяТаблица.ПериодВО КАК ПериодВО,
	|	ВременнаяТаблица.БлокУФД КАК БлокУФД,
	|	ВременнаяТаблица.Регистратор КАК ДокументРегистратор,
	|	ВременнаяТаблица.Сделка КАК Сделка,
	|	ВременнаяТаблица.Услуга КАК Услуга,
	|	ВременнаяТаблица.Клиент КАК Клиент,
	|	ВременнаяТаблица.Договор КАК Договор,
	|	ВременнаяТаблица.ИдентификаторСУЕ КАК ИдентификаторСУЕ,
	|	ВременнаяТаблица.Вагон КАК Вагон,
	|	ВременнаяТаблица.Контейнер КАК Контейнер,
	|	СУММА(ВременнаяТаблица.СуммаБезНДСРуб) КАК СуммаБезНДСРуб,
	|	ДокКалькуляция.УчетноеНаправление КАК УчетноеНаправление,
	|	ДокЗаявка.ВидПеревозки КАК ВидПеревозки,
	|	&ВидОперацииДоходы КАК ВидОперации,
	|	ТЕ.ТипТЕ.Рефрижераторный КАК КонтейнерТипТЕРефрижераторный,
	|	ВременнаяТаблица.СтрокаДоходовСделки КАК ГУИДСтрокиДоходов,
	|	СделкаСвязьУчетныхЕдиниц.КлючАналитикиСоставаПоезда КАК СУЕ,
	|	ВременнаяТаблица.МоментВремени КАК МоментВремени
	|ИЗ
	|	ФактическиеДоходыВО КАК ВременнаяТаблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Калькуляция КАК ДокКалькуляция
	|			ПО СделкаСвязьУчетныхЕдиниц.Калькуляция = ДокКалькуляция.Ссылка
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка КАК ДокЗаявка
	|			ПО СделкаСвязьУчетныхЕдиниц.Заявка = ДокЗаявка.Ссылка
	|		ПО ВременнаяТаблица.Сделка = СделкаСвязьУчетныхЕдиниц.Ссылка
	|			И ВременнаяТаблица.ИдентификаторСУЕ = СделкаСвязьУчетныхЕдиниц.ГУИД
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТЕ КАК ТЕ
	|		ПО ВременнаяТаблица.Контейнер = ТЕ.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ТЕ.ТипТЕ.Рефрижераторный,
	|	ВременнаяТаблица.Услуга,
	|	ВременнаяТаблица.ПериодВО,
	|	ВременнаяТаблица.Регистратор,
	|	ДокКалькуляция.УчетноеНаправление,
	|	ВременнаяТаблица.Сделка,
	|	ВременнаяТаблица.СтрокаДоходовСделки,
	|	ВременнаяТаблица.Вагон,
	|	ВременнаяТаблица.ИдентификаторСУЕ,
	|	ВременнаяТаблица.БлокУФД,
	|	ДокЗаявка.ВидПеревозки,
	|	ВременнаяТаблица.Контейнер,
	|	ВременнаяТаблица.Клиент,
	|	СделкаСвязьУчетныхЕдиниц.КлючАналитикиСоставаПоезда,
	|	ВременнаяТаблица.МоментВремени,
	|	ВременнаяТаблица.Договор
	|
	|УПОРЯДОЧИТЬ ПО
	|	БлокУФД,
	|	МоментВремени";
	
	Запрос.УстановитьПараметр("ДатаНачала", ПериодВО);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецМесяца(ПериодВО));
	Запрос.УстановитьПараметр("БлокУФДПустаяСсылка", Справочники.БлокиУФД.ПустаяСсылка());
	Запрос.УстановитьПараметр("БлокУФДДоходыПрошлыхЛет", Справочники.БлокиУФД.ДоходыПрошлыхЛет);
	Запрос.УстановитьПараметр("БлокУФДДоходы", Справочники.БлокиУФД.Доходы);
	Запрос.УстановитьПараметр("ТипОперацииВыручка", Перечисления.ВидыДоходов.Выручка);
	Запрос.УстановитьПараметр("ВидОперацииДоходы", "Доходы");
	
	Выборка = Запрос.Выполнить().Выбрать();
	НомерСтроки = УФД_ПолучитьНомерПоследнейСтрокиПериода(ПериодВО);
	
	КоличествоЗаписейВПорцииДанных = УФД_ПолучитьКоличествоЗаписейВПорцииДанных();
	
	Пока Выборка.СледующийПоЗначениюПоля("БлокУФД") Цикл
		
		НаборЗаписей = РегистрыСведений.УчетФактическихУправленческихДанных.СоздатьНаборЗаписей();	
		ОтборПоПолю = НаборЗаписей.Отбор.ПериодВО;
		ОтборПоПолю.Установить(ПериодВО, Истина);
		ОтборПоПолю = НаборЗаписей.Отбор.БлокУФД;
		ОтборПоПолю.Установить(Выборка.БлокУФД, Истина);
		
		Пока Выборка.Следующий() Цикл
			НомерСтроки = НомерСтроки + 1;
			НоваяЗапись = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяЗапись, Выборка);
			НоваяЗапись.НомерСтрокиПериода = НомерСтроки;
			
			ИдентификаторПорции = Цел(НомерСтроки / КоличествоЗаписейВПорцииДанных);
			НоваяЗапись.ИдентификаторПорцииДанных = ИдентификаторПорции;
		КонецЦикла;
		
		НаборЗаписей.Записать();
		
	КонецЦикла;	
	
КонецПроцедуры

