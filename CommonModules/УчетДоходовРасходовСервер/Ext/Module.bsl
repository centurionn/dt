	|			И СоставПоездаИДоходы.Контейнер = СоставУслугЗаявки.Контейнер
	|			И СоставПоездаИДоходы.Клиент = СоставУслугЗаявки.Клиент
	|			И СоставПоездаИДоходы.СоставПоездаКалькуляция = СоставУслугЗаявки.СоставПоездаКалькуляция
	|			И СоставПоездаИДоходы.СоставПоездаПротокол = СоставУслугЗаявки.СоставПоездаПротокол
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТРейсы КАК ВТРейсы
	|		ПО (ИСТИНА)";
	
	Возврат ТекстЗапроса;
	
КонецФункции

//Евросиб Каблов 22.12.2023
Процедура Сделка_СформироватьДвиженияДанныеПоОтправлениям(ОбъектСделка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = Сделка_ПолучитьТекстЗапросаДанныеПоОтправлениям();
	Сделка_УстановитьПараметрыЗапросаДанныеПоОтправлениям(Запрос, ОбъектСделка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	НаборЗаписей = РегистрыСведений.ДанныеПоОтправлениям.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ОбъектСделка);
		
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.СледующийПоЗначениюПоля("ИдентификаторСУЕ") Цикл
		Пока Выборка.СледующийПоЗначениюПоля("Период") Цикл
			Пока Выборка.СледующийПоЗначениюПоля("Клиент") Цикл
				Пока Выборка.СледующийПоЗначениюПоля("Услуга") Цикл
					Пока Выборка.СледующийПоЗначениюПоля("ВнутренняяСебестоимость") Цикл
						Выборка.СледующийПоЗначениюПоля("Калькуляция");
						НоваяЗапись = НаборЗаписей.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяЗапись, Выборка);
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

