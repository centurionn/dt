Процедура ЗП_УстановитьПараметрыЗапросаФиксацииИзменений(Запрос, Объект)
	Запрос.УстановитьПараметр("КонецПериодаПлановыхРасходов", КонецМесяца(Объект.ПериодБлокировки));
	Запрос.УстановитьПараметр("КонецПериодаЗафиксированныхРасходов", Объект.ПериодБлокировки-1);
	Запрос.УстановитьПараметр("ПериодФиксации", Объект.ПериодБлокировки);
