	|			И СделкаСвязьДоходовИРасходов.Ссылка = СделкаРасходы.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.Доходы КАК СделкаДоходы
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияКорректировокРеализаций КАК ИсторияКорректировокРеализаций
	|			ПО СделкаДоходы.УчДокумент = ИсторияКорректировокРеализаций.КорректируемыйДокумент
	|				И (ИсторияКорректировокРеализаций.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование))
	|		ПО СделкаСвязьДоходовИРасходов.Доходы = СделкаДоходы.ГУИД
	|			И СделкаСвязьДоходовИРасходов.Ссылка = СделкаДоходы.Ссылка
	|ГДЕ
	|	СделкаСвязьДоходовИРасходов.Ссылка = &Ссылка
	|	И ВТ_ИтоговаяДоходыРасходы.ИдентификаторСтрокиРасхода ЕСТЬ NULL
	|	И НЕ СделкаСвязьДоходовИРасходов.Доходы = """"
	|	И НЕ СделкаСвязьДоходовИРасходов.Расходы = """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_ИтоговаяДоходыРасходы_Расш.ИдентификаторСтрокиСУЕ КАК ИдентификаторСтрокиСУЕ,
	|	ВТ_ИтоговаяДоходыРасходы_Расш.ИдентификаторСтрокиДохода КАК ИдентификаторСтрокиДохода
	|ПОМЕСТИТЬ ВТ_СУЕ_С_ДублямиУслуг
	|ИЗ
	|	ВТ_ИтоговаяДоходыРасходы_Расш КАК ВТ_ИтоговаяДоходыРасходы_Расш
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ИтоговаяДоходыРасходы_Расш КАК ВТ_ИтоговаяДоходыРасходы_Расш1
	|		ПО ВТ_ИтоговаяДоходыРасходы_Расш.Услуга = ВТ_ИтоговаяДоходыРасходы_Расш1.Услуга
	|			И ВТ_ИтоговаяДоходыРасходы_Расш.ИдентификаторСтрокиСУЕ = ВТ_ИтоговаяДоходыРасходы_Расш1.ИдентификаторСтрокиСУЕ
	|			И ВТ_ИтоговаяДоходыРасходы_Расш.ИдентификаторСтрокиДохода <> ВТ_ИтоговаяДоходыРасходы_Расш1.ИдентификаторСтрокиДохода
	|			И (ВТ_ИтоговаяДоходыРасходы_Расш.ИдентификаторСтрокиДохода <> """")
	|			И (ВТ_ИтоговаяДоходыРасходы_Расш1.ИдентификаторСтрокиДохода <> """")
	|			И (ВТ_ИтоговаяДоходыРасходы_Расш1.ВыставленныйДокумент <> ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг.ПустаяСсылка))
	|ГДЕ
	|	ВТ_ИтоговаяДоходыРасходы_Расш.Услуга = ВТ_ИтоговаяДоходыРасходы_Расш.Услуга1
	|	И ВТ_ИтоговаяДоходыРасходы_Расш.НеВыставлятьКлиенту
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_ИтоговаяДоходыРасходы_Расш.ВидДоходов КАК ВидДоходов,
	|	МАКСИМУМ(ВТ_ИтоговаяДоходыРасходы_Расш.РасчетнаяДатаЗавершенияПеревозки) КАК РасчетнаяДатаЗавершенияПеревозки,
	|	ВТ_ИтоговаяДоходыРасходы_Расш.ИдентификаторСтрокиДохода КАК ИдентификаторСтрокиДохода,
	|	ВТ_ИтоговаяДоходыРасходы_Расш.ИдентификаторСтрокиРасхода КАК ИдентификаторСтрокиРасхода,
	|	ВТ_ИтоговаяДоходыРасходы_Расш.ИдентификаторСтрокиСУЕ КАК ИдентификаторСтрокиСУЕ,
	|	ВТ_ИтоговаяДоходыРасходы_Расш.ЕстьЭкономика КАК ЕстьЭкономика,
	|	ВТ_ИтоговаяДоходыРасходы_Расш.ГотовоКВыставлению КАК ГотовоКВыставлению,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_СУЕ_С_ДублямиУслуг.ИдентификаторСтрокиСУЕ, """") = """"
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ДубльДоходнойСтроки,
	|	ВТ_ИтоговаяДоходыРасходы_Расш.ВыставленныйДокумент КАК ВыставленныйДокумент,
	|	ВТ_ИтоговаяДоходыРасходы_Расш.НеВыставлятьКлиенту КАК НеВыставлятьКлиенту,
	|	ВТ_ИтоговаяДоходыРасходы_Расш.НеобходимоОтвязатьАкцептыОтСделки КАК НеобходимоОтвязатьАкцептыОтСделки
	|ИЗ
	|	ВТ_ИтоговаяДоходыРасходы_Расш КАК ВТ_ИтоговаяДоходыРасходы_Расш
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СУЕ_С_ДублямиУслуг КАК ВТ_СУЕ_С_ДублямиУслуг
	|		ПО ВТ_ИтоговаяДоходыРасходы_Расш.ИдентификаторСтрокиСУЕ = ВТ_СУЕ_С_ДублямиУслуг.ИдентификаторСтрокиСУЕ
	|			И ВТ_ИтоговаяДоходыРасходы_Расш.ИдентификаторСтрокиДохода = ВТ_СУЕ_С_ДублямиУслуг.ИдентификаторСтрокиДохода
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ИтоговаяДоходыРасходы_Расш.ИдентификаторСтрокиДохода,
	|	ВТ_ИтоговаяДоходыРасходы_Расш.ИдентификаторСтрокиРасхода,
	|	ВТ_ИтоговаяДоходыРасходы_Расш.ИдентификаторСтрокиСУЕ,
	|	ВТ_ИтоговаяДоходыРасходы_Расш.ВидДоходов,
	|	ВТ_ИтоговаяДоходыРасходы_Расш.ЕстьЭкономика,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_СУЕ_С_ДублямиУслуг.ИдентификаторСтрокиСУЕ, """") = """"
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ,
	|	ВТ_ИтоговаяДоходыРасходы_Расш.ВыставленныйДокумент,
	|	ВТ_ИтоговаяДоходыРасходы_Расш.ГотовоКВыставлению,
	|	ВТ_ИтоговаяДоходыРасходы_Расш.НеВыставлятьКлиенту,
	|	ВТ_ИтоговаяДоходыРасходы_Расш.НеобходимоОтвязатьАкцептыОтСделки";
	Запрос.УстановитьПараметр("ИтоговаяТаблица", ТаблицаПлановыхДоходов);
	Запрос.УстановитьПараметр("Ссылка", ОбъектСделка.Ссылка);
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ПлановыеДоходы = ОбъектСделка.Движения.ПлановыеДоходыВО;
	ПлановыеДоходы.Записывать = Истина;		
	
	ПлановыеДоходы.Загрузить(РезультатыЗапроса[1].Выгрузить());
	
	ДоходыРасходы = ОбъектСделка.Движения.ДоходыРасходы;
	ДоходыРасходы.Записывать = Истина;
	ДоходыРасходы.Загрузить(РезультатыЗапроса[РезультатыЗапроса.Количество()-1].Выгрузить());
	
КонецПроцедуры

Функция Сделка_ПолучитьТекстЗапросаПлановыеДоходыВО()
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	СделкаСвязьУчетныхЕдиниц.Контейнер КАК Контейнер,
	|	КлючиАналитикиСоставаПоезда.ДатаОтправления КАК ДатаОтправления,
	|	КлючиАналитикиСоставаПоезда.ДатаПрибытия КАК ДатаПрибытия,
	|	СделкаСвязьУчетныхЕдиниц.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТДатыОтправленияПрибытия
	|ИЗ
	|	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиСоставаПоезда КАК КлючиАналитикиСоставаПоезда
	|		ПО СделкаСвязьУчетныхЕдиниц.КлючАналитикиСоставаПоезда = КлючиАналитикиСоставаПоезда.Ссылка
	|			И (СделкаСвязьУчетныхЕдиниц.Ссылка = &Ссылка)
	|			И (НЕ СделкаСвязьУчетныхЕдиниц.Контейнер = ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка))
	|			И (НЕ СделкаСвязьУчетныхЕдиниц.ОтключитьРасходы)
	|			И (НЕ СделкаСвязьУчетныхЕдиниц.Удалена)
	|			И (НЕ СделкаСвязьУчетныхЕдиниц.НеАктивна)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СделкаРейсы.Ссылка КАК Ссылка,
	|	МИНИМУМ(СделкаРейсы.Рейс.ДатаОтправления) КАК ДатаОтправления,
	|	МАКСИМУМ(СделкаРейсы.Рейс.ДатаПрибытия) КАК ДатаПрибытия,
	|	МИНИМУМ(СделкаРейсы.Рейс.ДатаПрибытия) КАК МинимальнаяДатаПрибытия,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА СделкаРейсы.Рейс ССЫЛКА Справочник.РейсыЖД
	|				ТОГДА СделкаРейсы.Рейс.ДатаОтправления
	|			ИНАЧЕ NULL
	|		КОНЕЦ) КАК ДатаОтправленияЖД,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СделкаРейсы.Рейс ССЫЛКА Справочник.РейсыЖД
	|				ТОГДА СделкаРейсы.Рейс.ДатаПрибытия
	|			ИНАЧЕ &ПустаяДата
	|		КОНЕЦ) КАК ДатаПрибытияЖД,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА СделкаРейсы.Рейс ССЫЛКА Справочник.РейсыМоре
	|				ТОГДА СделкаРейсы.Рейс.ДатаОтправления
	|			ИНАЧЕ NULL
	|		КОНЕЦ) КАК ДатаОтправленияМоре,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СделкаРейсы.Рейс ССЫЛКА Справочник.РейсыМоре
	|				ТОГДА СделкаРейсы.Рейс.ДатаПрибытия
	|			ИНАЧЕ &ПустаяДата
	|		КОНЕЦ) КАК ДатаПрибытияМоре,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СделкаРейсы.Рейс) КАК КоличествоРейсовВСделке,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
	|			КОГДА СделкаРейсы.Рейс ССЫЛКА Справочник.РейсыЖД
	|				ТОГДА СделкаРейсы.Рейс
	|			ИНАЧЕ NULL
	|		КОНЕЦ) КАК КоличествоЖДРейсовВСделке,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
	|			КОГДА СделкаРейсы.Рейс ССЫЛКА Справочник.РейсыМоре
	|				ТОГДА СделкаРейсы.Рейс
	|			ИНАЧЕ NULL
	|		КОНЕЦ) КАК КоличествоМорскихРейсовВСделке,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СделкаРейсы.Рейс ССЫЛКА Справочник.РейсыЖД
	|				ТОГДА СделкаРейсы.Рейс
	|			ИНАЧЕ NULL
	|		КОНЕЦ) КАК ЖДРейс,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СделкаРейсы.Рейс ССЫЛКА Справочник.РейсыМоре
	|				ТОГДА СделкаРейсы.Рейс
	|			ИНАЧЕ NULL
	|		КОНЕЦ) КАК МорскойРейс
	|ПОМЕСТИТЬ ПлановыеДатыРейсов
	|ИЗ
	|	Документ.Сделка.Рейсы КАК СделкаРейсы
	|ГДЕ
	|	СделкаРейсы.Ссылка = &Ссылка
	|	И НЕ СделкаРейсы.Рейс.ДатаОтправления ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	СделкаРейсы.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СделкаСвязьДоходовИРасходов.Доходы КАК Доходы,
	|	СделкаСвязьДоходовИРасходов.СвязьУчетныхЕдиниц КАК СвязьУчетныхЕдиниц
	|ПОМЕСТИТЬ ВТ_СвязьДоходовИРасходов
	|ИЗ
	|	Документ.Сделка.СвязьДоходовИРасходов КАК СделкаСвязьДоходовИРасходов
	|ГДЕ
	|	СделкаСвязьДоходовИРасходов.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СвязьДоходовИРасходов.СвязьУчетныхЕдиниц КАК ГУИД_СУЕ,
	|	СделкаДоходы.Услуга КАК Услуга,
	|	СделкаДоходы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	СделкаДоходы.ГУИД КАК ГУИД_Доходы,
	|	ВЫБОР
	|		КОГДА ИсторияКорректировокРеализаций.КорректируемыйДокумент ЕСТЬ NULL
	|			ТОГДА СделкаДоходы.УчДокумент
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК УчетныйДокумент,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СделкаДоходы.УчДокумент.Проведен, ЛОЖЬ)
	|				ИЛИ ЕСТЬNULL(СделкаДоходы.КорректировкаДокумента.Проведен, ЛОЖЬ)
	|				ИЛИ ЕСТЬNULL(СделкаДоходы.КорректировкаВознаграждения.Проведен, ЛОЖЬ)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК УчетныйДокументПроведен,
	|	СделкаДоходы.Клиент КАК Клиент,
	|	СделкаДоходы.Договор КАК Договор,
	|	СделкаДоходы.ПСЦ КАК ПСЦ,
	|	СделкаДоходы.Калькуляция КАК Калькуляция,
	|	СделкаДоходы.ДоплатныеКТК КАК ДоплатныеКТК,
	|	СделкаДоходы.НеВыставлятьКлиенту КАК НеВыставлятьКлиенту,
	|	СделкаДоходы.ДатаОказанияУслуги КАК ДатаОказанияУслуги,
	|	СделкаДоходы.Ссылка КАК Ссылка,
	|	СделкаДоходы.УслугаВнеСтавки КАК УслугаВнеСтавки,
	|	СделкаДоходы.ИсточникПоявленияСтрокиЭкономики КАК ИсточникПоявленияСтрокиЭкономики
	|ПОМЕСТИТЬ ВТ_Доходы_СУЕ
	|ИЗ
	|	Документ.Сделка.Доходы КАК СделкаДоходы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СвязьДоходовИРасходов КАК ВТ_СвязьДоходовИРасходов
	|		ПО СделкаДоходы.ГУИД = ВТ_СвязьДоходовИРасходов.Доходы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияКорректировокРеализаций КАК ИсторияКорректировокРеализаций
	|		ПО СделкаДоходы.УчДокумент = ИсторияКорректировокРеализаций.КорректируемыйДокумент
	|			И (ИсторияКорректировокРеализаций.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование))
	|ГДЕ
	|	СделкаДоходы.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Доходы_СУЕ.УчетныйДокумент КАК УчетныйДокумент,
	|	ЕСТЬNULL(РазрешениеВводаКорректировокСрезПоследних.РазрешенаКорректировка, ЛОЖЬ)
	|		ИЛИ ЕСТЬNULL(РазрешениеВводаКорректировокСрезПоследних.РазрешеноИсправление, ЛОЖЬ)
	|		ИЛИ ЕСТЬNULL(РазрешениеВводаКорректировокСрезПоследних.РазрешеноАннулирование, ЛОЖЬ) КАК ИзмененияРазрешены,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(РазрешениеВводаКорректировокСрезПоследних.РазрешенаКорректировка, ЛОЖЬ)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение)
	|		КОГДА ЕСТЬNULL(РазрешениеВводаКорректировокСрезПоследних.РазрешеноИсправление, ЛОЖЬ)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки)
	|		КОГДА ЕСТЬNULL(РазрешениеВводаКорректировокСрезПоследних.РазрешеноАннулирование, ЛОЖЬ)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ПустаяСсылка)
	|	КОНЕЦ КАК ОжидаемыйДокумент
	|ПОМЕСТИТЬ втРазрешениеИзменений
	|ИЗ
	|	ВТ_Доходы_СУЕ КАК ВТ_Доходы_СУЕ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РазрешениеВводаКорректировок.СрезПоследних(, ) КАК РазрешениеВводаКорректировокСрезПоследних
	|		ПО ВТ_Доходы_СУЕ.УчетныйДокумент = РазрешениеВводаКорректировокСрезПоследних.ОбъектКорректировки
