//Сделка. Плановые расходы ВО.
Процедура Сделка_СформироватьДвиженияПлановыеРасходыВО(ОбъектСделка) Экспорт
	
	//ОбъектСделка.Движения.ПлановыеРасходыВО.Записывать = Истина;
	Запрос = Новый Запрос;
	Запрос.Текст = Сделка_ПолучитьТекстЗапросаПлановыеРасходы("ВО");
	Сделка_УстановитьПараметрыЗапросаПлановыеРасходы(Запрос, ОбъектСделка);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ОбъектСделка.Движения.ПлановыеРасходыВО.Загрузить(РезультатЗапроса.Выгрузить());
		//Евросиб Каблов 17.03.2026 ( #126784
		//ОбъектСделка.Движения.ПлановыеРасходыВО.Записать();
		//Евросиб Каблов 17.03.2026 ) #126784
	КонецЕсли; 
	//Евросиб Каблов 17.03.2026 ( #126784
	ОбъектСделка.Движения.ПлановыеРасходыВО.Записать();
	//Евросиб Каблов 17.03.2026 ) #126784
	
КонецПроцедуры

