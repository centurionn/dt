Функция Удалить_Сделка_ПолучитьТекстЗапросаДанныеПоОтправлениям()
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СделкаДоходы.Ссылка КАК Сделка,
	// Евросиб US 82073 TA 114490 Рыбьяков К.А. 24.07.2025 ((
