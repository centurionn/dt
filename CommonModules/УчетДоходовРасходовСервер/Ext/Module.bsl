//Евросиб Каблов 06.11.2025 #107942
Процедура Списание_СформироватьДвиженияПлановыеРасходыПолныйФакт(Объект, ТаблицаСписания) Экспорт
	
	Для каждого СтрокаСписания Из ТаблицаСписания Цикл

		Если Объект.ВО И СтрокаСписания.СуммаОстатокВО <> 0 Тогда
			ДвижениеВО = Объект.Движения.ПлановыеРасходыВОПолныйФакт.ДобавитьРасход();
			ЗаполнитьЗначенияСвойств(ДвижениеВО, СтрокаСписания);
			ДвижениеВО.Период = НачалоМесяца(Объект.ПериодСписания);
			ДвижениеВО.Сумма = СтрокаСписания.СуммаОстатокВО;
			ДвижениеВО.СуммаНДС = СтрокаСписания.СуммаНДСОстатокВО;
			ДвижениеВО.СуммаРуб = СтрокаСписания.СуммаРубОстатокВО;
			ДвижениеВО.СуммаНДСРуб = СтрокаСписания.СуммаНДСРубОстатокВО;
			ДвижениеВО.Списание = Истина;
		КонецЕсли;
		
	КонецЦикла;
	Если Объект.ВО Тогда
		Объект.Движения.ПлановыеРасходыВОПолныйФакт.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура Списание_УстановитьПараметрыЗапросаФиксацииИзменений(Запрос, Объект)
	Запрос.УстановитьПараметр("КонецПериодаПлановыхРасходов", КонецМесяца(Объект.ПериодСписания));
	//Евросиб Каблов 04.03.2024 ( #81836
	//Запрос.УстановитьПараметр("КонецПериодаЗафиксированныхРасходов", Объект.ПериодСписания - 1);
	//Запрос.УстановитьПараметр("ПериодФиксации", КонецМесяца(Объект.ПериодСписания));
	Запрос.УстановитьПараметр("КонецПериодаЗафиксированныхРасходов", КонецМесяца(Объект.ПериодСписания));
	Запрос.УстановитьПараметр("ПериодФиксации", НачалоМесяца(Объект.ПериодСписания));
	//Евросиб Каблов 04.03.2024 )
	
