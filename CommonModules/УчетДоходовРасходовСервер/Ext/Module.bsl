	|						КОГДА КорректировкаРеализацииРасшифровкаУслугПоТС.Ссылка.СуммаВключаетНДС
	|							ТОГДА 0
	|						ИНАЧЕ КорректировкаРеализацииРасшифровкаУслугПоТС.СуммаНДСДоИзменения
	|					КОНЕЦ + КорректировкаРеализацииРасшифровкаУслугПоТС.СуммаДоИзменения
	|			ИНАЧЕ 0
	|		КОНЕЦ) * ВЫБОР
	|			КОГДА КорректировкаРеализацииРасшифровкаУслугПоТС.Ссылка.ДоговорКонтрагента.ВалютаВзаиморасчетов <> &ВалютаРегл
	|				ТОГДА КурсыВалютСрезПоследних.Курс / КурсыВалютСрезПоследних.Кратность
	|			ИНАЧЕ 1
	|		КОНЕЦ,
	|		(КорректировкаРеализацииРасшифровкаУслугПоТС.СуммаНДС - ВЫБОР
	|			КОГДА КорректировкаРеализацииРасшифровкаУслугПоТС.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение)
	|				ТОГДА КорректировкаРеализацииРасшифровкаУслугПоТС.СуммаНДСДоИзменения
	|			ИНАЧЕ 0
	|		КОНЕЦ) * ВЫБОР
	|			КОГДА КорректировкаРеализацииРасшифровкаУслугПоТС.Ссылка.ДоговорКонтрагента.ВалютаВзаиморасчетов <> &ВалютаРегл
	|				ТОГДА КурсыВалютСрезПоследних.Курс / КурсыВалютСрезПоследних.Кратность
	|			ИНАЧЕ 1
	|		КОНЕЦ
	//Евросиб Каблов 26.08.2025 ) #114890
	|	ИЗ
	|		Документ.КорректировкаРеализации.РасшифровкаУслугПоТС КАК КорректировкаРеализацииРасшифровкаУслугПоТС
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.Доходы КАК СделкаДоходы
	|			ПО КорректировкаРеализацииРасшифровкаУслугПоТС.СтрокаДоходовСделки = СделкаДоходы.ГУИД
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&ДатаКурса, ) КАК КурсыВалютСрезПоследних
	|			ПО КорректировкаРеализацииРасшифровкаУслугПоТС.Ссылка.ДоговорКонтрагента.ВалютаВзаиморасчетов = КурсыВалютСрезПоследних.Валюта
	|	ГДЕ
	|		КорректировкаРеализацииРасшифровкаУслугПоТС.Ссылка = &Ссылка
	|		И НЕ &ЭтоАннулирование) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Период,
	|	ВложенныйЗапрос.Организация,
	|	ВложенныйЗапрос.ЦФО,
	|	ВложенныйЗапрос.Сделка,
	|	ВложенныйЗапрос.Услуга,
	|	ВложенныйЗапрос.ИдентификаторСУЕ,
	|	ВложенныйЗапрос.Вагон,
	|	ВложенныйЗапрос.Контейнер,
	//Евросиб Каблов 14.10.2025 ( #107942	
	|	ВложенныйЗапрос.СтрокаДоходовСделки,
	//Евросиб Каблов 14.10.2025 ) #107942
	|	ВложенныйЗапрос.Клиент,
	|	ВложенныйЗапрос.Договор,
	|	ВложенныйЗапрос.Валюта,
	|	ВложенныйЗапрос.СтавкаНДС,
	|	ВложенныйЗапрос.НоменклатурнаяГруппа,
	|	ВложенныйЗапрос.ТипОперации
	|
	|ИМЕЮЩИЕ
	|	(СУММА(ВложенныйЗапрос.Сумма) <> 0
	|		ИЛИ СУММА(ВложенныйЗапрос.СуммаНДС) <> 0
	|		ИЛИ СУММА(ВложенныйЗапрос.СуммаРуб) <> 0
	|		ИЛИ СУММА(ВложенныйЗапрос.СуммаНДСРуб) <> 0)";
	Если ВидУчета = "УУ" Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПериодВО", "&ПериодУУ");
	КонецЕсли; 
	Возврат ТекстЗапроса;

КонецФункции

Процедура КРТУ_УстановитьПараметрыЗапросаФактическиеДоходы(Запрос, ОбъектКРТУ, ВидУчета)
	Запрос.УстановитьПараметр("Ссылка", ОбъектКРТУ.Ссылка);
	Запрос.УстановитьПараметр("ЭтоАннулирование", ОбъектКРТУ.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование);
	Запрос.УстановитьПараметр("ИсправляемыйДокумент", ОбъектКРТУ.ДокументРеализации);
	Запрос.УстановитьПараметр("ВалютаРегл", Константы.ВалютаРегламентированногоУчета.Получить());
	Запрос.УстановитьПараметр("ДатаКурса", ОбъектКРТУ.ДатаДокумента);
	//Евросиб Каблов 08.06.2022 ( Task 52863 
	Запрос.УстановитьПараметр("КорректировкаОтчетаКомитенту", ОбъектКРТУ.КорректировкаОтчетаКомитенту);
	Запрос.УстановитьПараметр("НоменклатураВознаграждение", Справочники.Номенклатура.Вознаграждение);
	//ДИТ Шевченко А.В. 31.10.2022 60146 -начало
	ДокументРеализации = ОбъектКРТУ.Ссылка;
	Если ТипЗнч(ОбъектКРТУ.Ссылка) = Тип("ДокументСсылка.КорректировкаРеализации") И ОбъектКРТУ.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки Тогда
		ДокументРеализации = ОбъектКРТУ.ИсходныйДокументРеализации;
	КонецЕсли;
	Запрос.УстановитьПараметр("ДокументРеализации", ДокументРеализации);
	//ДИТ Шевченко А.В. 31.10.2022 60146 -конец
	//Евросиб Каблов 08.06.2022 )
	Если ВидУчета = "УУ" Тогда
		ПервоначальныйРТУ = БухгалтерскийУчетПереопределяемый.ПолучитьИсправляемыйДокументРеализации(ОбъектКРТУ.Ссылка, Истина);
		ДатаДокументаПервоначальногоПТУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПервоначальныйРТУ, "ДатаДокумента");
		Запрос.УстановитьПараметр("ПериодУУ", ДатаДокументаПервоначальногоПТУ);
	ИначеЕсли ВидУчета = "ВО" Тогда
		//Евросиб Каблов 05.01.2024 ( #79370
		//Запрос.УстановитьПараметр("ПериодВО", ОбъектКРТУ.Ссылка.ПериодВО);
		Запрос.УстановитьПараметр("ПериодВО", НачалоМесяца(ОбъектКРТУ.ПериодВО));
		//Евросиб Каблов 05.01.2024 )		
	КонецЕсли; 
КонецПроцедуры

#КонецОбласти

#Область ОтчетКомитенту

Процедура ОК_СформироватьДвиженияДоходыРасходы(ОбъектОК) Экспорт
	ОК_СформироватьДвиженияФактическиеДоходыВО(ОбъектОК);
	ОК_СформироватьДвиженияФактическиеДоходыУУ(ОбъектОК);
	//Евросиб - АСуслов 09.11.2022 16:48:29 #59240
	//(
	//ОК_СформироватьДвиженияПлановыеДоходыВО(ОбъектОК);
	//)
	//Евросиб - АСуслов 09.11.2022 16:48:34 #59240
КонецПроцедуры

//Отчет комитенту. Фактические доходы ВО.
Процедура ОК_СформироватьДвиженияФактическиеДоходыВО(ОбъектОК) Экспорт
	
	ОбъектОК.Движения.ФактическиеДоходыВО.Записывать = Истина;
	Запрос = Новый Запрос;
	Запрос.Текст = ОК_ПолучитьТекстЗапросаФактическиеДоходы("ВО");
	ОК_УстановитьПараметрыЗапросаФактическиеДоходы(Запрос, ОбъектОК);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли; 
	ОбъектОК.Движения.ФактическиеДоходыВО.Загрузить(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры //СформироватьДвиженияФактическиеДоходыВО

//Отчет комитенту. Фактические доходы УУ.
Процедура ОК_СформироватьДвиженияФактическиеДоходыУУ(ОбъектОК) Экспорт
	
	ОбъектОК.Движения.ФактическиеДоходыУУ.Записывать = Истина;
	Запрос = Новый Запрос;
	Запрос.Текст = ОК_ПолучитьТекстЗапросаФактическиеДоходы("УУ");
	ОК_УстановитьПараметрыЗапросаФактическиеДоходы(Запрос, ОбъектОК);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли; 
	ОбъектОК.Движения.ФактическиеДоходыУУ.Загрузить(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры //СформироватьДвиженияФактическиеДоходыВО

//Отчет комитенту. Текст запроса фактических доходов
Функция ОК_ПолучитьТекстЗапросаФактическиеДоходы(ВидУчета)
	
	//ДИТ Шевченко А.В. 31.10.2022 60146 Добавил поле "ДокументРеализации" в запрос
	
	ТекстЗапроса = 
	//Евросиб Каблов 01.07.2022 ( Task 53389
	"ВЫБРАТЬ
	|	ДанныеДокумента.ДатаКурсаВалют КАК ДатаКурсаВалюты,
	|	ДанныеДокумента.ВалютаДокумента КАК ВалютаДокумента,
	|	ЕСТЬNULL(КурсыВалютДокумента.Курс, 1) КАК КурсВалюты,
	|	ЕСТЬNULL(КурсыВалютДокумента.Кратность, 1) КАК КратностьВалюты,
	|	ДанныеДокумента.СсылкаОК КАК СсылкаОК
	|ПОМЕСТИТЬ ОтчетКомитенту
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПоступлениеТоваровУслуг.ДатаВходящегоДокумента КАК ДатаКурсаВалют,
	|		ОтчетКомитенту.ВалютаДокумента КАК ВалютаДокумента,
	|		ОтчетКомитенту.Ссылка КАК СсылкаОК
	|	ИЗ
	|		Документ.ОтчетКомитентуОПродажах.Поставщики КАК ОтчетКомитентуОПродажахПоставщики
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтчетКомитентуОПродажах КАК ОтчетКомитенту
	|			ПО ОтчетКомитентуОПродажахПоставщики.Ссылка = ОтчетКомитенту.Ссылка
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|			ПО ОтчетКомитентуОПродажахПоставщики.Партия = ПоступлениеТоваровУслуг.Ссылка
	|	ГДЕ
	|		ОтчетКомитентуОПродажахПоставщики.Ссылка = &Ссылка) КАК ДанныеДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютДокумента
	|		ПО ДанныеДокумента.ВалютаДокумента = КурсыВалютДокумента.Валюта
	|			И ДанныеДокумента.ДатаКурсаВалют = КурсыВалютДокумента.Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	//Евросиб Каблов 01.07.2022 )
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОтчетКомитентуОПродажахТовары.Ссылка КАК Ссылка,
	|	ОтчетКомитентуОПродажахТовары.СтрокаДоходовСделки КАК СтрокаДоходовСделки,
	|	ОтчетКомитентуОПродажахТовары.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа
	|ПОМЕСТИТЬ ВТ_ОтчетКомитентуТовары
	|ИЗ
	|	Документ.ОтчетКомитентуОПродажах.Товары КАК ОтчетКомитентуОПродажахТовары
	|ГДЕ	
	|	ОтчетКомитентуОПродажахТовары.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Ссылка.ПериодВО КАК Период,
	|	ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Ссылка.Организация КАК Организация,
	|	ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Ссылка.Сделка КАК Сделка,
	|	ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Ссылка.ЦФО КАК ЦФО,
	// Евросиб US 82073 TA 114490 Рыбьяков К.А. 24.07.2025 ((
	//|	ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.УдалитьСтрокаСвязьУчетныхЕдиниц КАК ИдентификаторСУЕ,
	|	ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.КлючАналитикиСоставаПоезда.ИдентификаторКлюча КАК ИдентификаторСУЕ,
	// Евросиб Рыбьяков К.А. 24.07.2025 ))
	|	ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Ссылка.Контрагент КАК Клиент,
	|	ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Ссылка.ДоговорКонтрагента КАК Договор,
	|	ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Услуга КАК Услуга,
	|	ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Ссылка.ВалютаДокумента КАК Валюта,
	|	ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.СтавкаНДС КАК СтавкаНДС,
	|	ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Вагон КАК Вагон,
	|	ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Контейнер КАК Контейнер,
	//Евросиб Каблов 14.10.2025 ( #107942
	|	ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.СтрокаДоходовСделки КАК СтрокаДоходовСделки,
	//Евросиб Каблов 14.10.2025 ) #107942
	|	ВЫБОР
	|		КОГДА ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Ссылка.СуммаВключаетНДС
	|			ТОГДА 0
	|		ИНАЧЕ ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.СуммаНДС
	|	КОНЕЦ + ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Сумма КАК Сумма,
	|	ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.СуммаНДС КАК СуммаНДС,
	//Евросиб Каблов 01.07.2022 ( Task 53389
	//|	ВЫБОР
	//|		КОГДА ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Ссылка.ВалютаДокумента <> &ВалютаРегл
	//|			ТОГДА &ДатаКурса
	//|		ИНАЧЕ ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Ссылка.ДатаДокумента
	//|	КОНЕЦ КАК ДатаКурсаВалюты,
	//|	ВЫБОР
	//|		КОГДА ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Ссылка.ВалютаДокумента <> &ВалютаРегл
	//|			ТОГДА ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Ссылка.КурсВзаиморасчетов
	//|		ИНАЧЕ 1
	//|	КОНЕЦ КАК КурсВалюты,
	//|	ВЫБОР
	//|		КОГДА ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Ссылка.ВалютаДокумента <> &ВалютаРегл
	//|			ТОГДА ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Ссылка.КратностьВзаиморасчетов
	//|		ИНАЧЕ 1
	//|	КОНЕЦ КАК КратностьВалюты,
	//|	ВЫБОР
	//|		КОГДА ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Ссылка.ВалютаДокумента <> &ВалютаРегл
	//|			ТОГДА (ВЫБОР
	//|					КОГДА ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Ссылка.СуммаВключаетНДС
	//|						ТОГДА 0
	//|					ИНАЧЕ ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.СуммаНДС
	//|				КОНЕЦ + ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Сумма) * ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Ссылка.КурсВзаиморасчетов / ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Ссылка.КратностьВзаиморасчетов
	//|		ИНАЧЕ ВЫБОР
	//|				КОГДА ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Ссылка.СуммаВключаетНДС
	//|					ТОГДА 0
	//|				ИНАЧЕ ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.СуммаНДС
	//|			КОНЕЦ + ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Сумма
	//|	КОНЕЦ КАК СуммаРуб,
