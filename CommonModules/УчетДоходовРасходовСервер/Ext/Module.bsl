	"ВЫБРАТЬ
	|	ПротоколОбменов.ПроведенВБУ КАК ПроведенВБУ,
	|	ПротоколОбменов.ДатаДокументаВнешнейИС КАК ДатаДокументаВнешнейИС
	|ИЗ
	|	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	|ГДЕ
	|	ПротоколОбменов.Объект = &Акцепт
	|	И ПротоколОбменов.УзелОбмена = &УзелОбменаУПП
	|	И ПротоколОбменов.ДействиеПриОбмене = &ДействиеПриОбменеВыгрузкаДанных";
	Запрос.УстановитьПараметр("Акцепт", ОбъектАкцепт.Ссылка);
	Запрос.УстановитьПараметр("УзелОбменаУПП", Перечисления.УзлыОбмена.УПП);
	Запрос.УстановитьПараметр("ДействиеПриОбменеВыгрузкаДанных", Перечисления.ДействияПриОбмене.ВыгрузкаДанных);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() И Выборка.ПроведенВБУ И ЗначениеЗаполнено(Выборка.ДатаДокументаВнешнейИС) Тогда		
		
		МесяцДокументаВнешнейИС = НачалоМесяца(Выборка.ДатаДокументаВнешнейИС);
		Поступление = ОбъектАкцепт.Поступление;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	АкцептУслуги.НомерСтроки КАК НомерСтроки,
		|	АкцептУслуги.НоменклатураСделки КАК Номенклатура,
		|	АкцептУслуги.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
		|	АкцептУслуги.Сделка КАК Сделка,
		|	АкцептУслуги.ИдентификаторСтрокиРасходовВСделке КАК ИдентификаторСтрокиРасходовВСделке,
		|	АкцептУслуги.Сделка.Подразделение КАК Подразделение,
		|	АкцептУслуги.ВидРасходов КАК ВидРасходов,
		|	АкцептУслуги.Сумма КАК Сумма,
		|	АкцептУслуги.СуммаНДС КАК СуммаНДС
		|ИЗ
		|	Документ.Акцепт.Услуги КАК АкцептУслуги
		|ГДЕ
		|	АкцептУслуги.Ссылка = &Ссылка
		|	И АкцептУслуги.ВидЗатрат = &ВидЗатрат
		|	И АкцептУслуги.Сделка <> ЗНАЧЕНИЕ(Документ.Сделка.ПустаяСсылка)
		|	И АкцептУслуги.Сумма <> 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
		Запрос.УстановитьПараметр("Ссылка", ОбъектАкцепт.Ссылка);
		Запрос.УстановитьПараметр("ВидЗатрат", Перечисления.ВидыЗатрат.НезавершенноеПроизводство);
		Запрос.УстановитьПараметр("ВидРасходовВозмещаемые", Перечисления.ВидыРасходов.Возмещаемые);
		
		ВыборкаСтрок = Запрос.Выполнить().Выбрать();
		Пока ВыборкаСтрок.Следующий() Цикл
			
			Запись = ДвиженияНЗППоПериодуПроведенияВБУ.ДобавитьПриход();
			Запись.Период = МесяцДокументаВнешнейИС;
			ЗаполнитьЗначенияСвойств(Запись, ВыборкаСтрок);
			Запись.СтатьяЗатрат = ВыборкаСтрок.Номенклатура;
			Запись.Поступление = Поступление;
			//Евросиб Каблов 30.09.2025 ( #104972
			Запись.Акцепт = ОбъектАкцепт.Ссылка;
			Запись.Валюта = РеквизитыПТУ.ВалютаДокумента;
			//Евросиб Каблов 30.09.2025 )
			Запись.СтрокаРасходовСделки = ВыборкаСтрок.ИдентификаторСтрокиРасходовВСделке;
			Запись.Сумма = ВыборкаСтрок.Сумма;
			Запись.СуммаНДС = ВыборкаСтрок.СуммаНДС;
			Запись.СуммаРуб = ВыборкаСтрок.Сумма / РеквизитыПТУ.КратностьВзаиморасчетов * РеквизитыПТУ.КурсВзаиморасчетов;
			Запись.СуммаНДСРуб = ВыборкаСтрок.СуммаНДС / РеквизитыПТУ.КратностьВзаиморасчетов * РеквизитыПТУ.КурсВзаиморасчетов;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

