Функция УФД_ПолучитьНомерПоследнейСтрокиПериода(Период)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(УчетФактическихУправленческихДанных.НомерСтрокиПериода) КАК НомерСтрокиПериода
	|ИЗ
	|	РегистрСведений.УчетФактическихУправленческихДанных КАК УчетФактическихУправленческихДанных
	|ГДЕ
	|	УчетФактическихУправленческихДанных.ПериодВО = &ПериодВО";
	Запрос.УстановитьПараметр("ПериодВО", Период);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	НомерПоследнейСтроки = Неопределено;
	Если Выборка.Следующий() Тогда
		НомерПоследнейСтроки = Выборка.НомерСтрокиПериода;	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НомерПоследнейСтроки) Тогда
		НомерПоследнейСтроки = 0;
	КонецЕсли;
	
	Возврат НомерПоследнейСтроки;
	
КонецФункции

