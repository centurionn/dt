&НаКлиенте
Процедура ОбновитьВсеТаблицы()
	
	Если Объект.ОдинаковыйФормат Тогда
		Объект.ОписаниеУслугиСчет.Очистить();
		Объект.ОписаниеУслугиАкт.Очистить();
		Для Каждого Стр Из Объект.ОписаниеУслугиСчФ Цикл
			НовСтр1 = Объект.ОписаниеУслугиСчет.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр1,Стр);
			НовСтр2 = Объект.ОписаниеУслугиАкт.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр2,Стр);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

