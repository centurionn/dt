&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)

	Переменные.Очистить();
	
	Если ТекущаяСтраница.Имя = "ГруппаНастройкиФормированияВР" Тогда
		ТаблицаЗамен = ПравилаФормированияКлДокументовРасширенные.ПолучитьАктуальнуюТаблицуЗамен_ОтчетКомитенту();
	//Евросиб Шевченко А.В. 07.05.2025 US 95275 TA 106445
	ИначеЕсли ТекущаяСтраница.Имя = "ГруппаНастройкиФормированияСчета" Тогда
		ТаблицаЗамен = ПравилаФормированияКлДокументовРасширенные.ПолучитьАктуальнуюТаблицуЗамен_Счет();
	//Евросиб Шевченко А.В. 07.05.2025 US 95275 TA 106445
	Иначе
		ТаблицаЗамен = ПравилаФормированияКлДокументовРасширенные.ПолучитьАктуальнуюТаблицуЗамен();
	КонецЕсли;
	
	Для каждого Стр из ТаблицаЗамен Цикл
		ЗаполнитьЗначенияСвойств(Переменные.Добавить(), Стр);
	КонецЦикла;
	
КонецПроцедуры
//Евросиб(ДИТ), Беляев СЮ, US 93521 / TA 94125, 13-12-2024, конец

