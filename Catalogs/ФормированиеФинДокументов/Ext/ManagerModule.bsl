//ДИТ, Беляев СЮ, BUG 76518 / TA 76823, 03-11-2023, начало
//Функция предназначена для получения значения реквизита ОкруглениеКурса с учетом реквизита ИспользоватьРасширенныеПараметры
//Используется когда ссылка на Правило есть, например в документе Счет на оплату или РТУ
Функция ПолучитьЗначениеОкругленияКурсаИзПравил( ПравилоФормирования ) Экспорт
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ФормированиеФинДокументов.ИспользоватьРасширенныеПараметры
		|			ТОГДА ФормированиеФинДокументов.ОкруглениеКурса
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК ОкруглениеКурса
		|ИЗ
		|	Справочник.ФормированиеФинДокументов КАК ФормированиеФинДокументов
		|ГДЕ
		|	ФормированиеФинДокументов.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ПравилоФормирования);
	
	Выборка = Запрос.Выполнить().Выбрать();
		
	Если Выборка.Следующий() Тогда
		Результат = Выборка.ОкруглениеКурса;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
//ДИТ, Беляев СЮ, BUG 76518 / TA 76823, 03-11-2023, конец

