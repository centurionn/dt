	////ДИТ, Беляев СЮ, Ticket#0257828, 24-01-2022, начало 	
	//|	И ВЫБОР КОГДА &ОбязательноеЗаполнениеРеестра <> НЕОПРЕДЕЛЕНО ТОГДА ФормированиеФинДокументов.ОбязательноеЗаполнениеРеестра = &ОбязательноеЗаполнениеРеестра ИНАЧЕ ИСТИНА КОНЕЦ
	////ДИТ, Беляев СЮ, Ticket#0257828, 24-01-2022, конец 
	////)
	////Евросиб - АСуслов 06.04.2022 10:20:28 #40618
	|	И ФормированиеФинДокументов.ПравилоДляПовагонныхОтправок = &ПравилоДляПовагонныхОтправок
	|	И НЕ ФормированиеФинДокументов.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	*,1 КАК Приоритет,
	|   ВЫБОР КОГДА ФормированиеФинДокументов.ИспользоватьРасширенныеПараметры ТОГДА ФормированиеФинДокументов.ОкруглениеКурса ИНАЧЕ Неопределено КОНЕЦ КАК ОкруглениеКурса
	|ПОМЕСТИТЬ ВТ_Общий
	|ИЗ
	|	РегистрСведений.ФормированиеФинДокументов КАК ФормированиеФинДокументов
	|ГДЕ
	|	ФормированиеФинДокументов.Документ = &Документ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	*,2,
	|   ВЫБОР КОГДА ФормированиеФинДокументов.ИспользоватьРасширенныеПараметры ТОГДА ФормированиеФинДокументов.ОкруглениеКурса ИНАЧЕ Неопределено КОНЕЦ
	|ИЗ
	|	РегистрСведений.ФормированиеФинДокументов КАК ФормированиеФинДокументов
	|ГДЕ
	|	ФормированиеФинДокументов.Документ В
	|			(ВЫБРАТЬ
	|				т.Ссылка
	|			ИЗ
	|				ВТ_Правило КАК т)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	*
	|ИЗ
	|	ВТ_Общий КАК ВТ_Общий
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Общий.Приоритет";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	//Евросиб - АСуслов 03.01.2022 15:48:58 #0255988
	//(
	Запрос.УстановитьПараметр("ВидПеревозки", ?(ВидПеревозки = Неопределено, Справочники.ВидыПеревозок.ПустаяСсылка(), ВидПеревозки));
	//)
	//Евросиб - АСуслов 03.01.2022 15:48:59 #0255988
	Запрос.УстановитьПараметр("ПравилоДляПовагонныхОтправок", ПовагонныеОтправки);
	Запрос.УстановитьПараметр("Документ", Документ); 
	////Евросиб - АСуслов 06.04.2022 10:20:44 #40618
	////(
	////ДИТ, Беляев СЮ, Ticket#0257828, 24-01-2022, начало 
	//Запрос.УстановитьПараметр("ОбязательноеЗаполнениеРеестра", ОбязательноеЗаполнениеРеестра);
	////ДИТ, Беляев СЮ, Ticket#0257828, 24-01-2022, конец 
	////)
	////Евросиб - АСуслов 06.04.2022 10:20:50 #40618
	РезультатЗапроса = Запрос.Выполнить();
