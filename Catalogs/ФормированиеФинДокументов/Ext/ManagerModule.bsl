Функция ПолучитьТаблицуФормированияПравилДляНабора(ТаблицаКлиентВидПеревозки, ПовагонныеОтправки = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаКлиентВидПеревозки.Клиент КАК Клиент,
	|	ТаблицаКлиентВидПеревозки.ВидПеревозки КАК ВидПеревозки
	|ПОМЕСТИТЬ ВТ_КлиентВидПеревозки
	|ИЗ
	|	&ТаблицаКлиентВидПеревозки КАК ТаблицаКлиентВидПеревозки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ФормированиеФинДокументов.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Правило
	|ИЗ
	|	ВТ_КлиентВидПеревозки КАК ВТ_КлиентВидПеревозки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ФормированиеФинДокументов КАК ФормированиеФинДокументов
	|		ПО (ФормированиеФинДокументов.Контрагент = ВТ_КлиентВидПеревозки.Клиент)
	|			И (ФормированиеФинДокументов.ПравилоДляПовагонныхОтправок = &ПравилоДляПовагонныхОтправок)
	|			И (ВЫБОР
	|				КОГДА &ПравилоДляПовагонныхОтправок
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ФормированиеФинДокументов.ВидПеревозки = ВТ_КлиентВидПеревозки.ВидПеревозки
	|			КОНЕЦ)
	|			И (НЕ ФормированиеФинДокументов.ПометкаУдаления)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	*,
	|	ВЫБОР
	|		КОГДА ФормированиеФинДокументов.ИспользоватьРасширенныеПараметры
	|			ТОГДА ФормированиеФинДокументов.ОкруглениеКурса
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ОкруглениеКурса
	|ИЗ
	|	РегистрСведений.ФормированиеФинДокументов КАК ФормированиеФинДокументов
	|ГДЕ
	|	ФормированиеФинДокументов.Документ В
	|			(ВЫБРАТЬ
	|				т.Ссылка
	|			ИЗ
	|				ВТ_Правило КАК т)";
	
	Запрос.УстановитьПараметр("ТаблицаКлиентВидПеревозки", ТаблицаКлиентВидПеревозки);
	Запрос.УстановитьПараметр("ПравилоДляПовагонныхОтправок", ПовагонныеОтправки);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции
