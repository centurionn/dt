Функция КодовоеНаименованиеЗанято(Ссылка, КодовоеНаименование) Экспорт
	
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.КодовоеНаименование КАК КодовоеНаименование
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.КодовоеНаименование = &КодовоеНаименование
		|	И Контрагенты.КодовоеНаименование <> """"
		|	И Контрагенты.Ссылка <> &Ссылка";
	
	Запрос.УстановитьПараметр("КодовоеНаименование", КодовоеНаименование);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
