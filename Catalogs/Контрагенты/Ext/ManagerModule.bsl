Функция НапечататьРасчетРисков_ПоПростомуБезЭтихВашихБСП(МассивОбъектов)
	
	Результат = Новый ТабличныйДокумент;
	Результат.АвтоМасштаб = Истина;
	
	Первый = Истина;
	Для каждого Док из МассивОбъектов Цикл
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("Справочник.Контрагенты.ПФ_MXL_РасчетУровняРиска", Док.Ссылка, неопределено);
		СтрМакета = Макет.ПолучитьОбласть("Строка");
		
		Если НЕ Первый Тогда Результат.ВывестиГоризонтальныйРазделительСтраниц(); КонецЕсли;
		
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
		ОбластьШапка.Параметры.НаименованиеКонтрагента = Док.НаименованиеПолное;
		Результат.Вывести(ОбластьШапка);
		
		СокрТЧ = Док.РасчетРисков.Выгрузить();
		СокрТЧ.Свернуть("КатегорияРиска");
		Для каждого Услуга из СокрТЧ.ВыгрузитьКолонку("КатегорияРиска") Цикл
			
			ШапкаУслуги = Макет.ПолучитьОбласть("ШапкаУслуги");
			ШапкаУслуги.Параметры.НаименованиеУслуги = Строка(Услуга);
			Результат.Вывести(ШапкаУслуги);
			
			ИтогПроцентУслуги = 0;
			Сч = 1;
			Для каждого Стр из Док.РасчетРисков Цикл
				Если Стр.КатегорияРиска <> Услуга Тогда Продолжить; КонецЕсли;
				
				СтрМакета.Параметры.ПП = Сч;
				СтрМакета.Параметры.Характеристика = Стр.Характеристика;
				СтрМакета.Параметры.Значение = Стр.ЗначениеХарактеристики;
				СтрМакета.Параметры.ЗначениеРиска = Формат(Стр.Риски, "ЧДЦ=2; ЧН='Риска нет'");
				
				Результат.Вывести(СтрМакета);
				
				ИтогПроцентУслуги = ИтогПроцентУслуги + Стр.Риски;
				Сч = Сч + 1;
			КонецЦикла;
			
			Подвал = Макет.ПолучитьОбласть("Подвал");
			Подвал.Параметры.ИтогоРиск = "" + Формат(ИтогПроцентУслуги, "ЧДЦ=2; ЧН=") + "%";
			Результат.Вывести(Подвал);
			
		КонецЦикла;
		
		
		
		Первый = Ложь;
		
	КонецЦикла;
	
	Возврат Результат;
	
	
КонецФункции

Функция НапечататьАнкетуКлиента_ПоПростомуБезЭтихВашихБСП(МассивОбъектов)
	
	Результат = Новый ТабличныйДокумент;
	Результат.АвтоМасштаб = Истина;
	
	Первый = Истина;
	Для каждого Док из МассивОбъектов Цикл
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("Справочник.Контрагенты.ПФ_MXL_АнкетаКлиента", Док.Ссылка, неопределено);		
		Если НЕ Первый Тогда Результат.ВывестиГоризонтальныйРазделительСтраниц(); КонецЕсли;
		
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
		ОбластьШапка.Параметры.Клиент = Док.НаименованиеПолное;
		ОбластьШапка.Параметры.ИНН = Док.ИНН;
		ОбластьШапка.Параметры.Н = Док.ПлановыеПоказателиРаботыСКлиентом.Количество();
		Результат.Вывести(ОбластьШапка);
		
		КонтрибуцияИтого = 0;
		ПогрузкаИтого = 0;
		
		Для каждого Стр из Док.ПлановыеПоказателиРаботыСКлиентом Цикл
			
			СтрокаПлана = Макет.ПолучитьОбласть("СтрокаПлана");
			СтрокаПлана.Параметры.Н = Формат(Стр.МесяцНачалаРаботы, "ДФ='ММММ гг'");
			СтрокаПлана.Параметры.Контрибуция = Формат(Стр.КонтрибуцияБезНДС, "ЧДЦ=2");
			СтрокаПлана.Параметры.Погрузка = Формат(Стр.Погрузка, "ЧДЦ=2");
			Результат.Вывести(СтрокаПлана);
			
			КонтрибуцияИтого = КонтрибуцияИтого +  Стр.КонтрибуцияБезНДС;
			ПогрузкаИтого = ПогрузкаИтого + Стр.Погрузка;
			
		КонецЦикла;
		
		Подшапка = Макет.ПолучитьОбласть("Подшапка");
		Подшапка.Параметры.КонтрибуцияИтого = Формат(КонтрибуцияИтого, "ЧДЦ=2");
		Подшапка.Параметры.ПогрузкаИтого = Формат(ПогрузкаИтого, "ЧДЦ=2");
		Результат.Вывести(Подшапка);
		
		Сч = 1;
		//Евросиб Каблов 09.01.2019 (
		//Для каждого Стр из Док.ХарактеристикиПодрядчика Цикл
		//	Строка = Макет.ПолучитьОбласть("Подстрока");
		//	Строка.Параметры.Н = Сч;
		//	Строка.Параметры.Вопрос = Стр.Вопрос;
		//	Строка.Параметры.Ответ = Стр.Ответ;
		//	Строка.Параметры.Комментарий = Стр.Комментарий;
		//	Результат.Вывести(Строка);
		//	
		//	Сч = Сч + 1;
		//	
		//КонецЦикла;
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КонтрагентыХарактеристикиКлиента.Вопрос.Наименование КАК ВопросНаименование,
		|	ПРЕДСТАВЛЕНИЕ(КонтрагентыХарактеристикиКлиента.Ответ) КАК ОтветПредставление,
		|	КонтрагентыХарактеристикиКлиента.Комментарий КАК Комментарий,
		|	КонтрагентыХарактеристикиКлиента.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	Справочник.Контрагенты.ХарактеристикиКлиента КАК КонтрагентыХарактеристикиКлиента
		|ГДЕ
		|	КонтрагентыХарактеристикиКлиента.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		Запрос.УстановитьПараметр("Ссылка", Док);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Строка = Макет.ПолучитьОбласть("Подстрока");
			Строка.Параметры.Н = Выборка.НомерСтроки;
			Строка.Параметры.Вопрос = Выборка.ВопросНаименование;
			Строка.Параметры.Ответ = Выборка.ОтветПредставление;
			Строка.Параметры.Комментарий = Выборка.Комментарий;
			Результат.Вывести(Строка);
		КонецЦикла;
		//Евросиб Каблов 09.01.2019 )
		
		Первый = Ложь;
		
	КонецЦикла;
	
	Возврат Результат;
	
	
КонецФункции

