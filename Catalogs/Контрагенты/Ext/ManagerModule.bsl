//Евросиб(ДИТ), Беляев СЮ, US 90031 / TA 101224, 31-01-2025, начало
Функция СформироватьКодовоеНаименование(Ссылка, НаименованиеКонтрагента) Экспорт
	
	Результат = СформироватьПрефиксПоСтроке(НаименованиеКонтрагента);
	
	//проверка на уникальность
	Если КодовоеНаименованиеЗанято(Ссылка, Результат) Тогда
		МассивЗанятыхКодовыхНаименований = ПолучитьЗанятыеКодовыеНаименованияАналогичногоПрефикса(Результат);
		КодовоеНаименованиеСПостфиксом = "";
		
		//Если при присвоении кодового имени контрагента в системе имеется идентичный код - то к кодовому наименованию добавляется цифровой постфикс (ABC1)
		Для ТекНомер = 1 По 9 Цикл
			ПроверяемаяСтрока = Результат+Строка(ТекНомер);
			Если МассивЗанятыхКодовыхНаименований.Найти(ПроверяемаяСтрока) = Неопределено Тогда
				КодовоеНаименованиеСПостфиксом = ПроверяемаяСтрока;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	
		//Если в кодовом наименовании идентичного объекта используется максимальное число символов - то цифровой постфикс заменяет буквенное значение.
		Если НЕ ЗначениеЗаполнено(КодовоеНаименованиеСПостфиксом) Тогда
			//Добавляем только заглавные латинские буквы
			СтрокаЛатинскихБукв = "ABCDEFGHЯKLMNOPQRSTVXYZ";
			Для НомерСимвола = 1 По СтрДлина(СтрокаЛатинскихБукв) Цикл
				ПроверяемаяСтрока = Результат+Сред(СтрокаЛатинскихБукв, НомерСимвола, 1);
				Если МассивЗанятыхКодовыхНаименований.Найти(ПроверяемаяСтрока) = Неопределено Тогда
					КодовоеНаименованиеСПостфиксом = ПроверяемаяСтрока;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
			
		Если ЗначениеЗаполнено(КодовоеНаименованиеСПостфиксом) Тогда
			Результат = КодовоеНаименованиеСПостфиксом;
		Иначе
			Результат = "";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат
	
КонецФункции
