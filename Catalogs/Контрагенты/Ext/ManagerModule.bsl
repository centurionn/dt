//Евросиб(ДИТ), Беляев СЮ, US 90031 / TA 101224, 31-01-2025, начало
Функция СформироватьПрефиксПоСтроке(Знач НаименованиеКонтрагента)
	
	Результат = "";
	
	МаксимальноеКоличествоСимволов = 8; //Максимальное Количество символов в сокращении = 9 символов. СТАВИМ = 8, С УЧЕТОМ ПОСТФИКСА БУДЕТ 9
	КоличествоСимволовДляДлинныхСлов = 4;
	ГраничноеЧислоСлов = 3;
	
	//УБРАТЬ ФОРМУ СОБСТВЕННОСТИ
	//Для кодировки используется только наименование Контрагента, без указания формы собственности
	//ПОЛНОЕ НАИММЕНОВАНИЕ
	ИсключаемыеСлова = МассивСловФормСобственности();
	Для Каждого ПолноеНаименованиеФормы Из ИсключаемыеСлова Цикл
		НаименованиеКонтрагента = СтрЗаменить(НаименованиеКонтрагента, ПолноеНаименованиеФормы, "");
	КонецЦикла;
	//СОКРАЩЕННОЕ НАИМЕНОВАНИЕ
	МассивСловЧерезПробелы = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(НаименованиеКонтрагента," -"); //СтрРазделить(НаименованиеКонтрагента, " ", Ложь);
	ИсключаемыеСлова = МассивСокращенныхСловФормСобственности();
	МассивСловБезФормСобственности = ОбщегоНазначенияКлиентСервер.РазностьМассивов(МассивСловЧерезПробелы, ИсключаемыеСлова);
	КоличествоСлов = МассивСловБезФормСобственности.Количество();
	НаименованиеКонтрагента = ВРЕГ(СтрСоединить(МассивСловБезФормСобственности, " "));
	
	//ТРАНСЛИТЕРАЦИЯ
	//Буквы Кириллицы требуется преобразовывать в соответствии с транслитерацией ГОСТ-7.79-2000
	СтрокаЛатиницей = СтроковыеФункцииКлиентСервер.СтрокаЛатиницей(НаименованиеКонтрагента);
	
	//В сокращенном наименовании используются только заглавные латинские символы и цифры (другие символы игнорируются)
	СтрокаЛатиницей = СтрЗаменитьПоРегулярномуВыражению(СтрокаЛатиницей, "[^A-Za-z0-9 ]", "", Истина, Истина); // https://regex101.com/
	
	МассивСловЧерезПробелы = СтрРазделить(СтрокаЛатиницей, " ", Ложь);
	КоличествоСлов = МассивСловЧерезПробелы.Количество();
	
	СтрокаЛатиницейБезПробелов =  СтрСоединить(МассивСловЧерезПробелы, "");
	
	Если СтрДлина(СтрокаЛатиницейБезПробелов) <= МаксимальноеКоличествоСимволов Тогда
		//Для Контрагентов, в транслитерованных наименованиях которых 9 символов и меньше - использовать транслитерованное наименование
		Результат = СтрокаЛатиницейБезПробелов;
	ИначеЕсли КоличествоСлов = 1 Тогда
		Результат = Лев(СтрокаЛатиницейБезПробелов, МаксимальноеКоличествоСимволов); //Максимальное Количество символов в сокращении = 9 символов.
	ИначеЕсли КоличествоСлов > 1 Тогда
		//Максимальное Количество символов в сокращении = 9 символов.
		
		Если КоличествоСлов <= 3 Тогда
			//Для контрагентов, наименование которых состоит из двух или трех слов (в качестве разделителя может использоваться пробел и дефис) - использовать по 3 первые буквы каждого слова
			Результат = ПоПервымТремБуквамИзСловИзМассива(МассивСловЧерезПробелы);
		Иначе
			//Если Наименование содержит более трех слов - использовать первые буквы каждого слова
			Результат = ПоПервымБуквамИзСловИзМассива(МассивСловЧерезПробелы);
		КонецЕсли;
		
	КонецЕсли;
	
	Если СтрДлина(Результат) > МаксимальноеКоличествоСимволов Тогда
		//Для контрагентов , в транслитерованных наименованиях которых 9 символов и больше - использовать 4 первых и 4 последних символа. 
		Результат = Лев(Результат, 4) + Прав(Результат, 4);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
