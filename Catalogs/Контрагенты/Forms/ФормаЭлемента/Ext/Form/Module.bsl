&НаСервере
Процедура УстановитьЗначениеРеквизитаСибур(); 
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	рПО.УИДИсточника КАК УИДИсточника
		|ИЗ
		|	РегистрСведений.ПротоколОбменов КАК рПО
		|ГДЕ
		|	рПО.Объект = &Объект
		|	И рПО.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных)
		|	И рПО.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.Сибур)";
	
	Запрос.УстановитьПараметр("Объект", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
		
	Если Выборка.Следующий() Тогда 
		КодКонтрагентаСибур = Выборка.УИДИсточника;
	КонецЕсли;	
	
