&НаСервереБезКонтекста
Процедура ЗаписатьКодКонтрагентаСибурНаСервере(мОбъект,УИДИсточника)   
	
	ДействиеПриОбмене = Перечисления.ДействияПриОбмене.ВыгрузкаДанных; 
	УзелОбмена = Перечисления.УзлыОбмена.Сибур;
	
	Если Не УИДИсточника = "" Тогда 
		МенеджерЗаписи = РегистрыСведений.ПротоколОбменов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ДействиеПриОбмене = ДействиеПриОбмене;
		МенеджерЗаписи.УзелОбмена = УзелОбмена;
		МенеджерЗаписи.ДатаОбмена = ТекущаяДатаСеанса();
		МенеджерЗаписи.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		МенеджерЗаписи.Объект = мОбъект;
		МенеджерЗаписи.УИДИсточника = УИДИсточника;
		МенеджерЗаписи.Записать();
	Иначе
		НаборЗаписей = РегистрыСведений.ПротоколОбменов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДействиеПриОбмене.Установить(ДействиеПриОбмене);
		НаборЗаписей.Отбор.УзелОбмена.Установить(УзелОбмена);
		НаборЗаписей.Отбор.Объект.Установить(мОбъект);
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать();
	КонецЕсли;
	
КонецПроцедуры
