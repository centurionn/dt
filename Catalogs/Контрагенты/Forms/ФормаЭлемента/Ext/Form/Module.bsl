&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	//Евросиб Коханенко Н.А. 02.08.2024 (( #88035 
	//Состояния
	ОбновитьПанельТекущегоПользователя();
	ОбновитьПанельСостояний();
	//Евросиб Коханенко Н.А. 02.08.2024 )) #88035 

	Если Объект.ТипКонтрагента_Клиент Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КатегорииКонтрагентовСрезПоследних.Категория КАК Категория
		|ИЗ
		|	РегистрСведений.КатегорииКонтрагентов.СрезПоследних КАК КатегорииКонтрагентовСрезПоследних
		|ГДЕ
		|	КатегорииКонтрагентовСрезПоследних.Контрагент = &Контрагент
		|	И КатегорииКонтрагентовСрезПоследних.ТипКонтрагента = ЗНАЧЕНИЕ(Перечисление.ТипыКонтрагентов.Клиент)
		|	И КатегорииКонтрагентовСрезПоследних.ПлановаяФактическая = ЗНАЧЕНИЕ(Перечисление.ПланФакт.Факт)";
		Запрос.УстановитьПараметр("Контрагент", Объект.Ссылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		ТекущаяКатегория = "";
		Если Выборка.Следующий() Тогда
			ТекущаяКатегория = Выборка.Категория;
		КонецЕсли;
		
		Если КатегорияКлиентаФактическая <> ТекущаяКатегория Тогда
			Запись = РегистрыСведений.КатегорииКонтрагентов.СоздатьМенеджерЗаписи();
			Запись.Период = ТекущаяДатаСеанса();
			Запись.Контрагент = Объект.Ссылка;
			Запись.ТипКонтрагента = Перечисления.ТипыКонтрагентов.Клиент;
			Запись.ПлановаяФактическая = Перечисления.ПланФакт.Факт;
			Запись.Категория = КатегорияКлиентаФактическая;
			Запись.Записать();
		КонецЕсли;
			
	КонецЕсли;
	
КонецПроцедуры

