&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
    ДополнительныеПараметры = УправлениеКонтактнойИнформацией.ПараметрыКонтактнойИнформации();
    ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаКонтактнаяИнформация");
    УправлениеКонтактнойИнформацией.ПриСозданииНаСервере(ЭтотОбъект, Объект, ДополнительныеПараметры);
    // Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	//Состояния
	ОбновитьПанельТекущегоПользователя();
	ОбновитьПанельСостояний();
	
	Отрасль.ЗагрузитьЗначения(Объект.ОтраслиКонтрагента.Выгрузить().ВыгрузитьКолонку("Отрасль"));
	//Договоры.Параметры.УстановитьЗначениеПараметра("Владелец", Объект.Ссылка);
	
	АнкетыПодрядчиков.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", ТекущаяДата());	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(АнкетыПодрядчиков, "Владелец", Объект.Ссылка, ВидСравненияКомпоновкиДанных.Равно);
	
	ОбновитьСостояниеВСтопЛисте();
	
	ОбновитьНаФормеПоказателиСПАРК();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ИсторияПоказателейСПАРК, "Контрагент", Объект.Ссылка, ВидСравненияКомпоновкиДанных.Равно);
	ОбновитьНаФормеКатегориюПодрядчика();
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(РейтингКлиента, "Контрагент", Объект.Ссылка, Истина);
	
	Если Объект.ТипКонтрагента_Подрядчик Тогда
		ЗаполнитьТаблицыФинансовыхПоказателейПодрядчикаСервер();
	КонецЕсли;
	
	Элементы.ГруппаАнкетаПодрядчика.Видимость = Объект.ТипКонтрагента_Подрядчик;
	Элементы.ГруппаФинансовыеПоказатели.Видимость = Объект.ТипКонтрагента_Подрядчик;
//Евросиб Гудкова( 02.02.2020 Ticket№ 0185396
	Элементы.ГруппаРасчетРисков.Видимость = Объект.ТипКонтрагента_Подрядчик;
// Евросиб Гудкова) 	
	Элементы.ГруппаАнкетаКлиента.Видимость = Объект.ТипКонтрагента_Клиент;
	
	// заполнить данные по лицензии
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЛицензияНаПеревозкуОпасныхГрузов.ДатаНачалаДействияЛицензии КАК ДатаНачалаЛицензииОпГр,
	               |	ЛицензияНаПеревозкуОпасныхГрузов.ДатаОкончанияДействияЛицензии КАК ДатаОкончанияЛицензииОпГр,
	               |	ЛицензияНаПеревозкуОпасныхГрузов.ДатаИНомерЛицензии КАК ДатаИНомерЛицензииОпасныеГрузы
	               |ИЗ
	               |	РегистрСведений.ЛицензияНаПеревозкуОпасныхГрузов КАК ЛицензияНаПеревозкуОпасныхГрузов
	               |ГДЕ
	               |	ЛицензияНаПеревозкуОпасныхГрузов.Контрагент = &Контрагент";
	Запрос.УстановитьПараметр("Контрагент",Объект.Ссылка);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Если ТЗ.Количество()>0 Тогда
		ЗаполнитьЗначенияСвойств(Этаформа,ТЗ[0]);
	КонецЕсли;
	//Евросиб Каблов 27.04.2020 ( Ticket#0187054	
	Если Объект.РасчетРисков.Количество() > 0 Тогда
		КатегорияРискаПодрядчика = Объект.РасчетРисков[0].КатегорияРиска;
	КонецЕсли;
	//Евросиб Каблов 27.04.2020 )
	//Евросиб (Гонтаренко 02.03.2021 #28263
	СобственныйКонтрагент = РегистрыСведений.СобственныеКонтрагенты.ЭтоСобственныйКонтрагент(Объект.Ссылка);
	//Евросиб )Гонтаренко 02.03.2021 #28263
	
	//Евросиб Каблов 05.08.2021 ( Ticket#0237548
	ЭтоРезидент = Объект.СтранаРегистрации = Справочники.СтраныМира.Россия;
	Элементы.ВнешнийКодНерезидента.Доступность = Не ЭтоРезидент И (РольДоступна("dc_РаботаСЗаявками") Или РольДоступна("ПолныеПрава"));
	//Евросиб Каблов 05.08.2021 )  
	
	//Евросиб Коханенко Н.А. 25.04.2025 (( #78722 
	ОфисПродаж = РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ПолучитьАналитикуДокумента(Объект.Ссылка,
		ПланыВидовХарактеристик.ДополнительныеАналитикиДокументов.ОфисПродаж);
	//Евросиб Коханенко Н.А. 25.04.2025 )) #78722 
	
	//Евросиб Коханенко Н.А. #61705 08.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 08.12.2022 )
	
	// ++ Евросиб Дудоров С.В. USER STORY 57543 30.01.2023
	Элементы.ДляСлужебныхЗаявок.Видимость = РольДоступна("ПолныеПрава");
	// -- Евросиб Дудоров С.В. USER STORY 57543 30.01.2023
	
	//ДИТ, Беляев СЮ, US 80592/TA 80634, 04-03-2024, начало
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ФормаГруппаРеестрИсключения", "Доступность", ЭтоРезидент);
	//ДИТ, Беляев СЮ, US 80592/TA 80634, 04-03-2024, конец
	
	//Евросиб(ДИТ), Беляев СЮ, US 90031 / TA 101224, 31-01-2025, начало
	ДоступныПолныеПрава = РольДоступна("ПолныеПрава");
	Элементы.КодовоеНаименование.Доступность = ДоступныПолныеПрава;
	//Евросиб(ДИТ), Беляев СЮ, US 90031 / TA 101224, 31-01-2025, конец
	
	//Евросиб(ДИТ) Серебреников А.Г. US 107184 ТА 107186 19.05.25 Начало 
	Если Объект.ТипКонтрагента_Клиент Тогда 
		Элементы.ТранзитныйКлиент.Доступность = РольДоступна("dc_УстановкаТранзитногоКлиента") Или РольДоступна("ПолныеПрава");
	Иначе
		Элементы.ТранзитныйКлиент.Видимость = Ложь;
	КонецЕсли;	
	//Евросиб(ДИТ)) Серебреников А.Г. US 107184 ТА 107186 19.05.25 Конец
	
КонецПроцедуры

