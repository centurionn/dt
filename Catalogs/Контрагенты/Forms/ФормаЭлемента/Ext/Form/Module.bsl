&НаСервере
Функция СоздатьВБФНаСервере()
	
	Возврат БитФинансСервер.ПередатьКонтрагентаВБФ(Объект.Ссылка);
	
КонецФункции

&НаКлиенте
Процедура СоздатьВБФ(Команда)
	
	Если ЭтаФорма.Модифицированность Тогда
		Отказ = Ложь;
		Ответ = Вопрос("Перед отправкой запроса в Бит.Финанс контрагента необходимо записать. Продолжить?", РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Нет,, КодВозвратаДиалога.Нет);
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			Отказ = Истина;
		ИначеЕсли Записать() = Ложь Тогда
			Отказ = Истина;
		КонецЕсли;
		Если Отказ = Истина Тогда
			Сообщить("Контрагент не записан, данные в Бит.Финанс переданы не будут!", СтатусСообщения.Важное);
			Возврат;
		КонецЕсли; 
	КонецЕсли;
	
	Сообщение = СоздатьВБФНаСервере();
	Сообщение.Сообщить();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВводаГоризонтаПланирования2(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	Сч = 0;
	Пока Сч < Параметр1 Цикл
		НСтр  = Объект.ПлановыеПоказателиРаботыСКлиентом.Добавить();
		НСтр.МесяцНачалаРаботы = НачалоМесяца(ТекущаяДата() + Сч * 31 * 24 * 3600);
		Сч = Сч + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	//Договоры.Параметры.УстановитьЗначениеПараметра("Владелец", Объект.Ссылка);	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(АнкетыПодрядчиков, "Владелец", Объект.Ссылка, ВидСравненияКомпоновкиДанных.Равно);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ИсторияПоказателейСПАРК, "Контрагент", Объект.Ссылка, ВидСравненияКомпоновкиДанных.Равно);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(РейтингКлиента, "Контрагент", Объект.Ссылка, Истина);

КонецПроцедуры

&НаКлиенте
Процедура АнкетыПодрядчиковПриАктивизацииСтроки(Элемент)
	
	ТекДанные = Элементы.АнкетыПодрядчиков.ТекущиеДанные;
	Если ТекДанные <> неопределено Тогда
		ЗаполнитьФормуПоАнкете(ТекДанные.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФормуПоАнкете(Анкета)
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Анкета);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	АнкетыПодрядчиков.ТипПодрядчика КАК ТипПодрядчика,
	|	АнкетыПодрядчиков.Ресурсы КАК Ресурсы,
	|	АнкетыПодрядчиков.КонечныйПодрядчик КАК КонечныйПодрядчик,
	|	АнкетыПодрядчиков.Регион КАК Регион,
	|	АнкетыПодрядчиков.ДатаАнкеты КАК ДатаАнкеты,
	|	АнкетыПодрядчиков.ВидУслуги КАК ВидУслуги,
	|	АнкетыПодрядчиков.ДействительнаДо КАК ДействительнаДо
	|ИЗ
	|	Справочник.АнкетыПодрядчиков КАК АнкетыПодрядчиков
	|ГДЕ
	|	АнкетыПодрядчиков.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АнкетыПодрядчиковХарактеристикиПодрядчика.НомерСтроки КАК НомерСтроки,
	|	АнкетыПодрядчиковХарактеристикиПодрядчика.Вопрос КАК Вопрос,
	|	АнкетыПодрядчиковХарактеристикиПодрядчика.Ответ КАК Ответ,
	|	АнкетыПодрядчиковХарактеристикиПодрядчика.Комментарий КАК Комментарий
	|ИЗ
	|	Справочник.АнкетыПодрядчиков.ХарактеристикиПодрядчика КАК АнкетыПодрядчиковХарактеристикиПодрядчика
	|ГДЕ
	|	АнкетыПодрядчиковХарактеристикиПодрядчика.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АнкетыПодрядчиковВидыУслугИРиски.НомерСтроки КАК НомерСтроки,
	|	АнкетыПодрядчиковВидыУслугИРиски.Услуга КАК Услуга,
	|	АнкетыПодрядчиковВидыУслугИРиски.Риски КАК Риски,
	|	АнкетыПодрядчиковВидыУслугИРиски.ГруппаРасчета КАК ГруппаРасчета
	|ИЗ
	|	Справочник.АнкетыПодрядчиков.ВидыУслугИРиски КАК АнкетыПодрядчиковВидыУслугИРиски
	|ГДЕ
	|	АнкетыПодрядчиковВидыУслугИРиски.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АнкетыПодрядчиковПлановыеПоказателиРаботыСПодрядчиком.НомерСтроки КАК НомерСтроки,
	|	АнкетыПодрядчиковПлановыеПоказателиРаботыСПодрядчиком.МесяцНачалаРаботы КАК МесяцНачалаРаботы,
	|	АнкетыПодрядчиковПлановыеПоказателиРаботыСПодрядчиком.Количество КАК Количество,
	|	АнкетыПодрядчиковПлановыеПоказателиРаботыСПодрядчиком.ОбъемЗакупаемыхУслугТР КАК ОбъемЗакупаемыхУслугТР
	|ИЗ
	|	Справочник.АнкетыПодрядчиков.ПлановыеПоказателиРаботыСПодрядчиком КАК АнкетыПодрядчиковПлановыеПоказателиРаботыСПодрядчиком
	|ГДЕ
	|	АнкетыПодрядчиковПлановыеПоказателиРаботыСПодрядчиком.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Результаты = Запрос.ВыполнитьПакет();
	
	Выборка = Результаты[0].Выбрать();
	Если Выборка.Следующий() Тогда
		Анкета_ТипПодрядчика = Выборка.ТипПодрядчика;
		Анкета_Ресурсы = Выборка.Ресурсы;
		Анкета_КонечныйПодрядчик = Выборка.КонечныйПодрядчик;
		Анкета_Регион = Выборка.Регион;
		Анкета_ДатаАнкеты = Выборка.ДатаАнкеты;
		Анкета_ВидУслуги = Выборка.ВидУслуги;
		Анкета_ДействительнаДо = Выборка.ДействительнаДо;
	КонецЕсли;
	
	Анкета_ХарактеристикиПодрядчика.Загрузить(Результаты[1].Выгрузить());
	Анкета_ВидУслугИРиски.Загрузить(Результаты[2].Выгрузить());
	Анкета_ПлановыеПоказатели.Загрузить(Результаты[3].Выгрузить());
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНаборомПараметров(Команда)
	
	Для каждого Стр из Объект.РасчетРисков.НайтиСтроки(Новый Структура("КатегорияРиска", КатегорияРискаПодрядчика)) Цикл
		Объект.РасчетРисков.Удалить(Стр);
	КонецЦикла;
	
	Для каждого Стр из РейтингиИРискиКонтрагентовКлиент.ПолучитьТаблицуПараметровПоКатегорииХарактеристикПодрядчика(КатегорияРискаПодрядчика) Цикл
		НСтр = Объект.РасчетРисков.Добавить();
		НСтр.КатегорияРиска = КатегорияРискаПодрядчика;
		ЗаполнитьЗначенияСвойств(НСтр, Стр);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КатегорияРискаПодрядчикаПриИзменении(Элемент)
	
	Элементы.РасчетРисков.ОтборСтрок = Новый ФиксированнаяСтруктура("КатегорияРиска", КатегорияРискаПодрядчика);
	ПосчитатьИтогПроцентовРисков();
//Евросиб Каблов 27.04.2020 ( Ticket#0187054
	УстановитьДоступностьЭлементовРасчетаРисков();
//Евросиб Каблов 27.04.2020 )
	
КонецПроцедуры

&НаКлиенте
Процедура РасчетРисковПриАктивизацииСтроки(Элемент)
	
	ТекД = Элементы.РасчетРисков.ТекущиеДанные;
	Если ТекД <> неопределено Тогда
		ввод_ГруппаХарактеристик = ТекД.КатегорияРиска;
		ввод_Характеристика = текД.Характеристика;
		ввод_ЗначениеРиска = текД.Риски;
		
		ТипХарактеристики = РейтингиИРискиКонтрагентовКлиент.ВариантыЗначенияДляХарактеристики(ввод_Характеристика);
		Если ТипХарактеристики = "Число" Тогда
			Элементы.ввод_Число.Видимость = Истина;
			Элементы.ввод_ВыборИзСписка.Видимость = Ложь;
			ввод_Число = ТекД.ЗначениеХарактеристики;
		Иначе
			Элементы.ввод_Число.Видимость = Ложь;
			Элементы.ввод_ВыборИзСписка.Видимость = Истина;
			Элементы.ввод_ВыборИзСписка.СписокВыбора.Очистить();
			Для Сч = 0 По ТипХарактеристики.Количество()-1 Цикл
				Элементы.ввод_ВыборИзСписка.СписокВыбора.Добавить(ТипХарактеристики[Сч].Значение, ТипХарактеристики[Сч].Представление);
				Если ТекД.ЗначениеХарактеристики = ТипХарактеристики[Сч].Представление Тогда
					ввод_ВыборИзСписка = ТипХарактеристики[Сч].Значение;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ввод_ЧислоПриИзменении(Элемент)
	
	ввод_ЗначениеРиска = РейтингиИРискиКонтрагентовКлиент.ПолучитьЗначениеРиска(ввод_ГруппаХарактеристик, ввод_Характеристика, ввод_Число);
	
	ТекД = Элементы.РасчетРисков.ТекущиеДанные;
	Если ТекД <> неопределено Тогда
		
		ТекД.ЗначениеХарактеристики = ввод_Число;
		текД.Риски = ввод_ЗначениеРиска;
		
	КонецЕсли;
	
	ПосчитатьИтогПроцентовРисков();
	
КонецПроцедуры

&НаКлиенте
Процедура ввод_ВыборИзСпискаПриИзменении(Элемент)
	
	ввод_ЗначениеРиска = РейтингиИРискиКонтрагентовКлиент.ПолучитьЗначениеРиска(ввод_ГруппаХарактеристик, ввод_Характеристика, ввод_ВыборИзСписка);
	ПредставлениеЗначения = Элементы.ввод_ВыборИзСписка.СписокВыбора.найтиПоЗначению(ввод_ВыборИзСписка).Представление;
	
	ТипХарактеристики = РейтингиИРискиКонтрагентовКлиент.ВариантыЗначенияДляХарактеристики(ввод_Характеристика);
	
	ТекД = Элементы.РасчетРисков.ТекущиеДанные;
	Если ТекД <> неопределено Тогда
		
		ТекД.ЗначениеХарактеристики = ПредставлениеЗначения;
		текД.Риски = ввод_ЗначениеРиска;
		
	КонецЕсли;
	
	ПосчитатьИтогПроцентовРисков();
	
КонецПроцедуры

&НаКлиенте
Процедура ПосчитатьИтогПроцентовРисков()
	
	Итог = 0;
	Для каждого Стр из Объект.РасчетРисков Цикл
		Если Стр.КатегорияРиска = КатегорияРискаПодрядчика Тогда
			Итог = Итог + Стр.Риски;
		КонецЕсли;
	КонецЦикла;
	Элементы.РасчетРисковРиски.ТекстПодвала = Формат(Итог, "ЧДЦ=2; ЧГ=");
	
КонецПроцедуры

#Область ФинансовыеПоказатели

&НаКлиенте
Процедура ЗаполнитьТаблицыФинансовыхПоказателейПодрядчика(Команда)
	
	ЗаполнитьТаблицыФинансовыхПоказателейПодрядчикаСервер();
	
	ГруппыПоказателей = СтатистикаРаботыЗаПолгода.ПолучитьЭлементы();
	Для Каждого ГруппаПоказателей Из ГруппыПоказателей Цикл
		Элементы.СтатистикаРаботыЗаПолгода.Развернуть(ГруппаПоказателей.ПолучитьИдентификатор());
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицыФинансовыхПоказателейПодрядчикаСервер()
	
	//Статистика по годам
	
	СтатистикаРаботыПоГодам.Очистить();
	
	СтрокаПоказателяОбъемЗакупокСНДС = СтатистикаРаботыПоГодам.Добавить();
	СтрокаПоказателяОбъемЗакупокСНДС.Показатель = "Объем закупок";
	СтрокаПоказателяОбъемЗакупокСНДС.УчетНДС = "с учетом НДС";
	
	СтрокаПоказателяОбъемЗакупокБезНДС = СтатистикаРаботыПоГодам.Добавить();
	СтрокаПоказателяОбъемЗакупокБезНДС.Показатель = "Объем закупок";
	СтрокаПоказателяОбъемЗакупокБезНДС.УчетНДС = "без учета НДС";
	
	СтрокаПоказателяПлатежиСНДС = СтатистикаРаботыПоГодам.Добавить();
	СтрокаПоказателяПлатежиСНДС.Показатель = "Платежи";
	СтрокаПоказателяПлатежиСНДС.УчетНДС = "с учетом НДС";	
	
	СтрокаПоказателяОперативноеСальдо = СтатистикаРаботыПоГодам.Добавить();
	СтрокаПоказателяОперативноеСальдо.Показатель = "Оперативное сальдо";
	СтрокаПоказателяОперативноеСальдо.УчетНДС = "с учетом НДС";
	
	ТекДата = ТекущаяДатаСеанса();
	ТекГод = Год(ТекДата);	
	
	СоответствиеГодИмяКолонки = Новый Соответствие;	
	Для Счетчик = 0 По 2 Цикл
		
		ГодТекКолонки = ТекГод - Счетчик;
		СчетчикСтрокой = Формат(Счетчик, "ЧН=0; ЧГ=0");		
		СоответствиеГодИмяКолонки.Вставить(ГодТекКолонки, "Год" + СчетчикСтрокой);
		Элементы["СтатистикаРаботыПоГодамГод" + СчетчикСтрокой].Заголовок = Формат(ГодТекКолонки, "ЧГ=0");
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", Дата(ТекГод - 2, 1, 1));
	Запрос.УстановитьПараметр("ДатаОкончания", ТекДата);
	Запрос.УстановитьПараметр("Контрагент", Объект.Ссылка);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.Год КАК Год,
	|	СУММА(ВложенныйЗапрос.ОбъемЗакупокБезНДС) КАК ОбъемЗакупокБезНДС,
	|	СУММА(ВложенныйЗапрос.ОбъемЗакупокСНДС) КАК ОбъемЗакупокСНДС,
	|	СУММА(ВложенныйЗапрос.ПлатежиСНДС) КАК ПлатежиСНДС,
	|	СУММА(ВложенныйЗапрос.ОбъемЗакупокБезНДС - ВложенныйЗапрос.ПлатежиСНДС) КАК ОперативноеСальдо
	|ИЗ
	|	(ВЫБРАТЬ
	|		ГОД(ЗакупкиОбороты.Период) КАК Год,
	|		ЗакупкиОбороты.СтоимостьОборот - ЗакупкиОбороты.НДСОборот КАК ОбъемЗакупокБезНДС,
	|		ЗакупкиОбороты.СтоимостьОборот КАК ОбъемЗакупокСНДС,
	|		0 КАК ПлатежиСНДС
	|	ИЗ
	|		РегистрНакопления.Закупки.Обороты(&ДатаНачала, &ДатаОкончания, Год, Контрагент = &Контрагент) КАК ЗакупкиОбороты
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ГОД(ДвиженияДенежныхСредствОбороты.Период),
	|		0,
	|		0,
	|		ДвиженияДенежныхСредствОбороты.СуммаОборот
	|	ИЗ
	|		РегистрНакопления.ДвиженияДенежныхСредств.Обороты(
	|				&ДатаНачала,
	|				&ДатаОкончания,
	|				Год,
	|				Контрагент = &Контрагент
	|					И ПриходРасход = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)) КАК ДвиженияДенежныхСредствОбороты) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Год";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ИмяКолонки = СоответствиеГодИмяКолонки.Получить(Выборка.Год);
		Если ИмяКолонки <> Неопределено Тогда
			
			СтрокаПоказателяОбъемЗакупокСНДС[ИмяКолонки] = Выборка.ОбъемЗакупокСНДС;
			СтрокаПоказателяОбъемЗакупокБезНДС[ИмяКолонки] = Выборка.ОбъемЗакупокБезНДС;
			СтрокаПоказателяПлатежиСНДС[ИмяКолонки] = Выборка.ПлатежиСНДС;
			СтрокаПоказателяОперативноеСальдо[ИмяКолонки] = Выборка.ОперативноеСальдо;			
			
		КонецЕсли;
		
	КонецЦикла;
	
	//Статистика за полгода
	
	ГруппыПоказателей = СтатистикаРаботыЗаПолгода.ПолучитьЭлементы();
	ГруппыПоказателей.Очистить();
	
	ГруппаПоказателейПлатежи = ГруппыПоказателей.Добавить();
	ГруппаПоказателейПлатежи.Показатель = "Платежи (тыс. руб.)";
	СтрокиГруппы = ГруппаПоказателейПлатежи.ПолучитьЭлементы();
	СтрокаПоказателяПлатежиСНДС = СтрокиГруппы.Добавить();
	СтрокаПоказателяПлатежиСНДС.Показатель = "Сумма с учетом НДС";
	
	ГруппаПоказателейОбъемУслугПоВСФ = ГруппыПоказателей.Добавить();
	ГруппаПоказателейОбъемУслугПоВСФ.Показатель = "Объем услуг по ВСФ (тыс. руб.)";
	СтрокиГруппы = ГруппаПоказателейОбъемУслугПоВСФ.ПолучитьЭлементы();
	СтрокаПоказателяОбъемУслугСНДС = СтрокиГруппы.Добавить();
	СтрокаПоказателяОбъемУслугСНДС.Показатель = "Сумма всего с НДС";
	СтрокаПоказателяОбъемУслугБезНДС = СтрокиГруппы.Добавить();
	СтрокаПоказателяОбъемУслугБезНДС.Показатель = "Сумма без учета НДС";
	СтрокаПоказателяОбъемУслугНДС = СтрокиГруппы.Добавить();
	СтрокаПоказателяОбъемУслугНДС.Показатель = "Сумма НДС";
	
	ГруппаПоказателейВыполненныеОбъемы = ГруппыПоказателей.Добавить();
	ГруппаПоказателейВыполненныеОбъемы.Показатель = "Объем услуг - выполненные объемы по заказам клиентов (тыс. руб.)";
	СтрокиГруппы = ГруппаПоказателейВыполненныеОбъемы.ПолучитьЭлементы();
	СтрокаПоказателяВыполненныеОбъемыСНДС = СтрокиГруппы.Добавить();
	СтрокаПоказателяВыполненныеОбъемыСНДС.Показатель = "Сумма всего с НДС";
	СтрокаПоказателяВыполненныеОбъемыБезНДС = СтрокиГруппы.Добавить();
	СтрокаПоказателяВыполненныеОбъемыБезНДС.Показатель = "Сумма без учета НДС";
	СтрокаПоказателяВыполненныеОбъемыНДС = СтрокиГруппы.Добавить();
	СтрокаПоказателяВыполненныеОбъемыНДС.Показатель = "Сумма НДС";
	СтрокаПоказателяВыполненныеОбъемыВРСНДС = СтрокиГруппы.Добавить();
	СтрокаПоказателяВыполненныеОбъемыВРСНДС.Показатель = "в т.ч. ВР (с НДС)";
	СтрокаПоказателяВыполненныеОбъемыВРБезНДС = СтрокиГруппы.Добавить();
	СтрокаПоказателяВыполненныеОбъемыВРБезНДС.Показатель = "в т.ч. ВР (без учета НДС)";
	СтрокаПоказателяВыполненныеОбъемыСебестоимостьСНДС = СтрокиГруппы.Добавить();
	СтрокаПоказателяВыполненныеОбъемыСебестоимостьСНДС.Показатель = "в т.ч. Себестоимость (с НДС)";
	СтрокаПоказателяВыполненныеОбъемыСебестоимостьБезНДС = СтрокиГруппы.Добавить();
	СтрокаПоказателяВыполненныеОбъемыСебестоимостьБезНДС.Показатель = "в т.ч. Себестоимость (без учета НДС)";	
	
	ТекМесяц = НачалоМесяца(ТекДата);
	
	СоответствиеМесяцИмяКолонки = Новый Соответствие;
	
	Для Счетчик = 0 по 5 Цикл
		
		МесяцТекКолонки = ДобавитьМесяц(ТекМесяц, -Счетчик);
		СчетчикСтрокой = Формат(Счетчик, "ЧН=0; ЧГ=0");
		СоответствиеМесяцИмяКолонки.Вставить(МесяцТекКолонки, "Месяц" + СчетчикСтрокой);
		Элементы["СтатистикаРаботыЗаПолгодаМесяц" + СчетчикСтрокой].Заголовок = Формат(МесяцТекКолонки, "ДФ='МММ гг'");
		
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ДатаНачала", МесяцТекКолонки);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.Период КАК Период,
	|	СУММА(ВложенныйЗапрос.ВыполненныеОбъемыСНДС) КАК ВыполненныеОбъемыСНДС,
	|	СУММА(ВложенныйЗапрос.ВРсНДС) КАК ВРсНДС,
	|	СУММА(ВложенныйЗапрос.СебестоимостьСНДС) КАК СебестоимостьСНДС,
	|	СУММА(ВложенныйЗапрос.ОбъемЗакупокБезНДС) КАК ОбъемЗакупокБезНДС,
	|	СУММА(ВложенныйЗапрос.ОбъемЗакупокСНДС) КАК ОбъемЗакупокСНДС,
	|	СУММА(ВложенныйЗапрос.ОбъемЗакупокНДС) КАК ОбъемЗакупокНДС,
	|	СУММА(ВложенныйЗапрос.ПлатежиСНДС) КАК ПлатежиСНДС,
	|	СУММА(ВложенныйЗапрос.ВыполненныеОбъемыНДС) КАК ВыполненныеОбъемыНДС,
	|	СУММА(ВложенныйЗапрос.ВРНДС) КАК ВРНДС,
	|	СУММА(ВложенныйЗапрос.СебестоимостьНДС) КАК СебестоимостьНДС
	|ИЗ
	|	(
	//|   ВЫБРАТЬ
	//|		ЗакрытиеПериодовОбороты.Период КАК Период,
	//|		ЗакрытиеПериодовОбороты.СуммаРасходаРасход КАК ВыполненныеОбъемыСНДС,
	//|		ВЫБОР
	//|			КОГДА ЗакрытиеПериодовОбороты.Перевыставляемая
	//|				ТОГДА ЗакрытиеПериодовОбороты.СуммаРасходаРасход
	//|			ИНАЧЕ 0
	//|		КОНЕЦ КАК ВРсНДС,
	//|		ВЫБОР
	//|			КОГДА НЕ ЗакрытиеПериодовОбороты.Перевыставляемая
	//|				ТОГДА ЗакрытиеПериодовОбороты.СуммаРасходаРасход
	//|			ИНАЧЕ 0
	//|		КОНЕЦ КАК СебестоимостьСНДС,
	//|		ЗакрытиеПериодовОбороты.СуммаНДСРасходаРасход КАК ВыполненныеОбъемыНДС,
	//|		ВЫБОР
	//|			КОГДА ЗакрытиеПериодовОбороты.Перевыставляемая
	//|				ТОГДА ЗакрытиеПериодовОбороты.СуммаНДСРасходаРасход
	//|			ИНАЧЕ 0
	//|		КОНЕЦ КАК ВРНДС,
	//|		ВЫБОР
	//|			КОГДА НЕ ЗакрытиеПериодовОбороты.Перевыставляемая
	//|				ТОГДА ЗакрытиеПериодовОбороты.СуммаНДСРасходаРасход
	//|			ИНАЧЕ 0
	//|		КОНЕЦ КАК СебестоимостьНДС,
	//|		0 КАК ОбъемЗакупокБезНДС,
	//|		0 КАК ОбъемЗакупокСНДС,
	//|		0 КАК ОбъемЗакупокНДС,
	//|		0 КАК ПлатежиСНДС
	//|	ИЗ
	//|		РегистрНакопления.ЗакрытиеПериодов.Обороты(&ДатаНачала, &ДатаОкончания, Месяц, Контрагент = &Контрагент) КАК ЗакрытиеПериодовОбороты
	//|	
	//|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ЗакупкиОбороты.Период,
	|		0 КАК ВыполненныеОбъемыСНДС,
	|		0 КАК ВРсНДС,
	|		0 КАК СебестоимостьСНДС,
	|		0 КАК ВыполненныеОбъемыНДС,
	|		0 КАК ВРНДС,
	|		0 КАК СебестоимостьНДС,
	|		ЗакупкиОбороты.СтоимостьОборот - ЗакупкиОбороты.НДСОборот КАК ОбъемЗакупокБезНДС,
	|		ЗакупкиОбороты.СтоимостьОборот КАК ОбъемЗакупокСНДС,
	|		ЗакупкиОбороты.НДСОборот КАК ОбъемЗакупокНДС,
	|		0 КАК ПлатежиСНДС
	|	ИЗ
	|		РегистрНакопления.Закупки.Обороты(&ДатаНачала, &ДатаОкончания, Месяц, Контрагент = &Контрагент) КАК ЗакупкиОбороты
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ДвиженияДенежныхСредствОбороты.Период,
	|		0,
	|		0,
	|		0,
	|		0,
	|		0,
	|		0,
	|		0,
	|		0,
	|		0,
	|		ДвиженияДенежныхСредствОбороты.СуммаОборот
	|	ИЗ
	|		РегистрНакопления.ДвиженияДенежныхСредств.Обороты(
	|				&ДатаНачала,
	|				&ДатаОкончания,
	|				Месяц,
	|				Контрагент = &Контрагент
	|					И ПриходРасход = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Расход)) КАК ДвиженияДенежныхСредствОбороты) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Период";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ИмяКолонки = СоответствиеМесяцИмяКолонки.Получить(Выборка.Период);
		Если ИмяКолонки <> Неопределено Тогда
			СтрокаПоказателяПлатежиСНДС[ИмяКолонки] = Выборка.ПлатежиСНДС;
			СтрокаПоказателяОбъемУслугСНДС[ИмяКолонки] = Выборка.ОбъемЗакупокСНДС;
			СтрокаПоказателяОбъемУслугБезНДС[ИмяКолонки] = Выборка.ОбъемЗакупокБезНДС;
			СтрокаПоказателяОбъемУслугНДС[ИмяКолонки] = Выборка.ОбъемЗакупокНДС;
			СтрокаПоказателяВыполненныеОбъемыСНДС[ИмяКолонки] = Выборка.ВыполненныеОбъемыСНДС;
			СтрокаПоказателяВыполненныеОбъемыБезНДС[ИмяКолонки] = Выборка.ВыполненныеОбъемыСНДС - Выборка.ВыполненныеОбъемыНДС;
			СтрокаПоказателяВыполненныеОбъемыНДС[ИмяКолонки] = Выборка.ВыполненныеОбъемыНДС;
			СтрокаПоказателяВыполненныеОбъемыВРСНДС[ИмяКолонки] = Выборка.ВРсНДС;
			СтрокаПоказателяВыполненныеОбъемыВРБезНДС[ИмяКолонки] = Выборка.ВРсНДС - Выборка.ВРНДС;			
			СтрокаПоказателяВыполненныеОбъемыСебестоимостьСНДС[ИмяКолонки] = Выборка.СебестоимостьСНДС;
			СтрокаПоказателяВыполненныеОбъемыСебестоимостьБезНДС[ИмяКолонки] = Выборка.СебестоимостьСНДС - Выборка.СебестоимостьНДС;
		КонецЕсли;
		
	КонецЦикла;
	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСуммуВСФПоКонтрагентуЗаГод(Контрагент, Год)
	
	Результат = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(СчетФактураВыданный.СуммаДокумента) КАК СуммаДокумента
	               |ИЗ
	               |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	               |ГДЕ
	               |	СчетФактураВыданный.Контрагент = &Контрагент
	               |	И СчетФактураВыданный.Проведен
	               |	И ГОД(СчетФактураВыданный.ДатаВыставления) = &Год";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Год", Год);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.СуммаДокумента;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСуммуПлатежейСНДС(Контрагент, Год)
	
	Результат = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(СписаниеСРасчетногоСчета.СуммаДокумента) КАК СуммаДокумента
	               |ИЗ
	               |	Документ.СписаниеСРасчетногоСчета КАК СписаниеСРасчетногоСчета
	               |ГДЕ
	               |	СписаниеСРасчетногоСчета.Проведен
	               |	И СписаниеСРасчетногоСчета.ВидОперации = &ВидОперации
	               |	И ГОД(СписаниеСРасчетногоСчета.ДатаВзаиморасчетов) = &Год
	               |	И СписаниеСРасчетногоСчета.Контрагент = &Контрагент";
	Запрос.УстановитьПараметр("ВидОперации", Перечисления.ВидыОперацийСписаниеДенежныхСредств.ОплатаПоставщику);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Год", Год);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.СуммаДокумента;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

