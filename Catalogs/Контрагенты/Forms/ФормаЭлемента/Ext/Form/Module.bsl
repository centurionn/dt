	СтруктураРеквизитов.ИНН = Объект.ИНН;
	СтруктураРеквизитов.ОГРН = Объект.ОГРН;
	Отказ = Ложь;
	СПАРКЗапросыСервер.СПАРК_ОбновитьПоказателиНаСервере(СтруктураРеквизитов, Отказ);
	Если Не Отказ Тогда
		Если Не ЗначениеЗаполнено(Объект.ИНН) Тогда
			ЭтаФорма.Объект.ИНН = СтруктураРеквизитов.ИНН;
			//Модифицированность = Истина;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.ОГРН) Тогда
			ЭтаФорма.Объект.ОГРН = СтруктураРеквизитов.ОГРН;
			//Модифицированность = Истина;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.КодПоОКПО) Тогда
			ЭтаФорма.Объект.КодПоОКПО = СтруктураРеквизитов.КодПоОКПО;
			//Модифицированность = Истина;
		КонецЕсли;
		ОбновитьНаФормеПоказателиСПАРК();
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураРеквизитов.ПоследнееОбновлениеСПАРК) Тогда
		ПоследнееОбновлениеСПАРК = СтруктураРеквизитов.ПоследнееОбновлениеСПАРК;
	КонецЕсли;
	
КонецПроцедуры

