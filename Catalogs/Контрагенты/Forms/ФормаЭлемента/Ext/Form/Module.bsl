&НаСервере
Процедура ОбновитьНаФормеПоказателиСПАРК()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контрагент", Объект.Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СПАРКИндексыРисковСрезПоследних.СводныйИндикаторРиска КАК Сводный,
	|	СПАРКИндексыРисковСрезПоследних.ИндексДолжнойОсмотрительности КАК ИДО,
	|	СПАРКИндексыРисковСрезПоследних.ИндексФинансовогоРиска КАК ИФР,
	|	СПАРКИндексыРисковСрезПоследних.ИндексПлатежнойДисциплины КАК ИПД
	|ИЗ
	|	РегистрСведений.СПАРКИндексыРисков.СрезПоследних(, Контрагент = &Контрагент) КАК СПАРКИндексыРисковСрезПоследних";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
				
		ДанныеСпаркСводный = Выборка.Сводный;
		ДанныеСпаркИДО = Выборка.ИДО;
		ДанныеСпаркИФР = Выборка.ИФР;
		ДанныеСпаркИПД = Выборка.ИПД;
		
		Если ДанныеСпаркСводный = "Низкий риск" Тогда
			Элементы.ДанныеСпаркСводный.ЦветФона = WebЦвета.БледноЗеленый;
		ИначеЕсли ДанныеСпаркСводный = "Средний риск" Тогда
			Элементы.ДанныеСпаркСводный.ЦветФона = WebЦвета.Желтый;
		ИначеЕсли ДанныеСпаркСводный = "Высокий риск" Тогда
			Элементы.ДанныеСпаркСводный.ЦветФона = WebЦвета.Красный;
		Иначе
			Элементы.ДанныеСпаркСводный.ЦветФона = ЦветаСтиля.ЦветФонаПоля;
		КонецЕсли;
		
	Иначе
		
		ДанныеСпаркСводный = "";
		ДанныеСпаркИДО = "";
		ДанныеСпаркИФР = "";
		ДанныеСпаркИПД = "";
		
		Элементы.ДанныеСпаркСводный.ЦветФона = ЦветаСтиля.ЦветФонаПоля;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьНаФормеКатегориюПодрядчика()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КатегорииКонтрагентовСрезПоследних.Контрагент КАК Контрагент,
	|	КатегорииКонтрагентовСрезПоследних.ТипКонтрагента КАК ТипКонтрагента,
	|	КатегорииКонтрагентовСрезПоследних.ПлановаяФактическая КАК ПлановаяФактическая,
	|	КатегорииКонтрагентовСрезПоследних.Категория КАК Категория
	|ИЗ
	|	РегистрСведений.КатегорииКонтрагентов.СрезПоследних(, Контрагент = &Контрагент) КАК КатегорииКонтрагентовСрезПоследних";
	Запрос.УстановитьПараметр("Контрагент", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.ТипКонтрагента = Перечисления.ТипыКонтрагентов.Клиент Тогда
			Если Выборка.ПлановаяФактическая = Перечисления.ПланФакт.Факт Тогда
				КатегорияКлиентаФактическая = Выборка.Категория;
			ИначеЕсли Выборка.ПлановаяФактическая = Перечисления.ПланФакт.План Тогда
				КатегорияКлиентаПлановая = Выборка.Категория;
			КонецЕсли;
		ИначеЕсли Выборка.ТипКонтрагента = Перечисления.ТипыКонтрагентов.Подрядчик Тогда
			Если Выборка.ПлановаяФактическая = Перечисления.ПланФакт.Факт Тогда
				КатегорияПодрядчикаФактическая = Выборка.Категория;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
		
КонецПроцедуры

&НаСервере
Процедура ОбновитьСостояниеВСтопЛисте()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СтопЛистКонтрагентовСрезПоследних.ВСтопЛисте КАК ВСтопЛисте,
	               |	СтопЛистКонтрагентовСрезПоследних.Период КАК Период,
	               |	СтопЛистКонтрагентовСрезПоследних.Пользователь КАК Пользователь,
	               |	СтопЛистКонтрагентовСрезПоследних.Комментарий КАК Комментарий
	               |ИЗ
	               |	РегистрСведений.СтопЛистКонтрагентов.СрезПоследних(, Контрагент = &Контрагент) КАК СтопЛистКонтрагентовСрезПоследних";
	Запрос.УстановитьПараметр("Контрагент", Объект.Ссылка);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() и Ответ.ВСтопЛисте Тогда
		
		Элементы.ПредупреждениеСтопЛист.Видимость = Истина;
		Элементы.ПредупреждениеСтопЛист.Заголовок = "Контрагент в стоп-листе с " + Формат(Ответ.Период, "ДФ=dd.MM.yy") + " пользователем " + Ответ.Пользователь + " по причине: " + Ответ.Комментарий;
		
	Иначе
		
		Элементы.ПредупреждениеСтопЛист.Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

