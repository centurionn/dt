
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПараметрыВыбораАдресов = Новый Массив;
	Если Параметры.Свойство("Отбор") Тогда
		Для Каждого ЭлементОтбора Из Параметры.Отбор Цикл
			ИмяПараметра = СтрШаблон("Отбор.%1", ЭлементОтбора.Ключ);
			ПараметрыВыбораАдресов.Добавить(Новый ПараметрВыбора(ИмяПараметра, ЭлементОтбора.Значение));			
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыВыбораАдресов) Тогда
		Элементы.АдресаЗначение.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораАдресов);
	КонецЕсли;
		
	ЗаполнитьТаблицуМультиадресов();
	
КонецПроцедуры

&НаКлиенте
Процедура АдресаЗначениеПриИзменении(Элемент)
	
	ОбработатьИзменениеСпискаАдресов();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеСпискаАдресов()
	
	ИдентификаторТекСтроки = Элементы.Адреса.ТекущаяСтрока;	
	Если ИдентификаторТекСтроки <> Неопределено Тогда
		ТекДанные = Адреса.НайтиПоИдентификатору(ИдентификаторТекСтроки);
		Если Не ЗначениеЗаполнено(ТекДанные.Значение) Тогда
			Адреса.Удалить(ТекДанные);
		Иначе
			Для Каждого Стр Из Адреса Цикл
				Если Стр.Значение = ТекДанные.Значение И Стр.ПолучитьИдентификатор() <> ИдентификаторТекСтроки Тогда
					Адреса.Удалить(ТекДанные);
					Элементы.Адреса.ТекущаяСтрока = Стр.ПолучитьИдентификатор();
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьТаблицуМультиадресов();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуМультиадресов() 
	
	ПараметрыОтбораАдресов = Новый Структура;
	Для Каждого ПараметрВыбора Из Элементы.АдресаЗначение.ПараметрыВыбора Цикл
		ИмяПараметра = СтрЗаменить(ПараметрВыбора.Имя, "Отбор.", "");
		ПараметрыОтбораАдресов.Вставить(ИмяПараметра, ПараметрВыбора.Значение);
	КонецЦикла;
	
	ТаблицаМультиадресов = Справочники.Мультиадреса.ПолучитьМультиадресаПоПараметрам(Адреса.ВыгрузитьЗначения(), ПараметрыОтбораАдресов, Истина);
	Мультиадреса.Загрузить(ТаблицаМультиадресов);
	
КонецПроцедуры

&НаКлиенте
Процедура АдресаПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ИдентификаторТекСтроки = Элементы.Адреса.ТекущаяСтрока;	
	Если ИдентификаторТекСтроки <> Неопределено Тогда
		ТекДанные = Адреса.НайтиПоИдентификатору(ИдентификаторТекСтроки);
		Если Не ЗначениеЗаполнено(ТекДанные.Значение) Тогда
			Адреса.Удалить(ТекДанные);
		Иначе
			Для Каждого Стр Из Адреса Цикл
				Если Стр.Значение = ТекДанные.Значение И Стр.ПолучитьИдентификатор() <> ИдентификаторТекСтроки Тогда
					Адреса.Удалить(ТекДанные);
					Элементы.Адреса.ТекущаяСтрока = Стр.ПолучитьИдентификатор();
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресаПослеУдаления(Элемент)
	
	ОбработатьИзменениеСпискаАдресов();
	
КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда)
	
	ТекДанные = Элементы.Мультиадреса.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ОповеститьОВыборе(ТекДанные.Мультиадрес);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Создать(Команда)
	
	ОповещениеОДобавлении = Новый ОписаниеОповещения("ОбработкаЗакрытияОкнаНовогоЭлемента", ЭтаФорма);
	ПараметрыФормы = Новый Структура;
	
	ЗначениеЗаполнения = Новый Структура;
	ЗначениеЗаполнения.Вставить("Адреса", Адреса.ВыгрузитьЗначения());
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначениеЗаполнения);
	
	ОткрытьФорму("Справочник.Мультиадреса.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,, ОповещениеОДобавлении, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗакрытияОкнаНовогоЭлемента(Значение, ДополнительныеПараметры) Экспорт
	
	ЗаполнитьТаблицуМультиадресов();
	
КонецПроцедуры

&НаКлиенте
Процедура МультиадресаПриАктивизацииСтроки(Элемент)
	
	ТекДанные = Элементы.Мультиадреса.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ПолученныеАдреса = ПолучитьАдресаМультиадреса(ТекДанные.Мультиадрес);
		АдресаВыбранногоМультиадреса.ЗагрузитьЗначения(ПолученныеАдреса);
	Иначе
		АдресаВыбранногоМультиадреса.Очистить();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьАдресаМультиадреса(Мультиадрес)
	
	Возврат Справочники.Мультиадреса.ПолучитьАдресаМультиадреса(Мультиадрес);
	
КонецФункции

&НаКлиенте
Процедура ОбработкаЗаписиНового(НовыйОбъект, Источник, СтандартнаяОбработка)
	
	Если ТипЗнч(НовыйОбъект) = Тип("СправочникСсылка.Мультиадреса") Тогда
		ЗаполнитьТаблицуМультиадресов();
		НайденныеСтроки = Мультиадреса.НайтиСтроки(Новый Структура("Мультиадрес", НовыйОбъект));
		Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
			Элементы.Мультиадреса.ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МультиадресаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элементы.Мультиадреса.ТекущиеДанные;
	ПоказатьЗначение(, ТекДанные.Мультиадрес);
	
КонецПроцедуры

&НаКлиенте
Процедура АдресаЗначениеНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ОткрытьФормуВводаАдреса(Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура АдресаЗначениеСоздание(Элемент, СтандартнаяОбработка)
	
	ОткрытьФормуВводаАдреса(Элемент, СтандартнаяОбработка);
		
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВводаАдреса(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
		
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормы.Вставить("ПоказыватьВыборАдреса", Истина);
	
	ТипыЛокацийМассив = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПредопределенноеЗначение("Справочник.ТипыЛокаций.АдресВНаселенномПункте"));	
	ПараметрыОтбора = Новый Структура("Тип", ТипыЛокацийМассив);
	ПараметрыФормы.Вставить("Отбор", ПараметрыОтбора);
	
	ОткрытьФорму("Справочник.Локации.ФормаВыбора", ПараметрыФормы, Элемент, ЭтаФорма.УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

