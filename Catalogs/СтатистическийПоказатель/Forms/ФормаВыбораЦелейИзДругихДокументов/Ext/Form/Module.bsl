
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗадачиПользователя = Пользователи.ТекущийПользователь();
	Если Параметры.Свойство("АктуальныеНаДату") Тогда
		АктуальныеНаДату = Параметры.АктуальныеНаДату;
	Иначе
		АктуальныеНаДату = ТекущаяДата();
	КонецЕсли;
	ПодобратьНаСервере();
	
	
	//Евросиб Коханенко Н.А. #61705 08.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 08.12.2022 )

КонецПроцедуры

