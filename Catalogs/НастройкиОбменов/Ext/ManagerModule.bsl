
Функция ПолучитьНастройкуОбмена(УзелОбмена, ИмяМетода) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НастройкиОбменов.Ссылка КАК Ссылка,
	|	НастройкиОбменов.КоличествоЗаписейВПорцииДанных КАК КоличествоЗаписейВПорцииДанных
	|ИЗ
	|	Справочник.НастройкиОбменов КАК НастройкиОбменов
	|ГДЕ
	|	НастройкиОбменов.УзелОбмена = &УзелОбмена
	|	И НастройкиОбменов.ИмяМетода = &ИмяМетода
	|	И НЕ НастройкиОбменов.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("УзелОбмена", УзелОбмена);
	Запрос.УстановитьПараметр("ИмяМетода", ИмяМетода);
	Выборка = Запрос.Выполнить().Выбрать();
	
	СтруктураНастроек = Новый Структура("Ссылка, КоличествоЗаписейВПорцииДанных", Неопределено, 0);
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураНастроек, Выборка);
	КонецЕсли;
	
	Возврат СтруктураНастроек;
	
КонецФункции