
&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		//ПараметрыДоговора = ;
		Объект.Валюта = КонтрагентыДоговоры_сервер.ПолучитьВалютуДоговора(Объект.Договор);
		Объект.Регламентный = ?(Истина, 1, 2);
	КонецЕсли;
	ОбновитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьДоступность()
	
	ДоступКПараметрамДоговора = ЗначениеЗаполнено(Объект.Договор);
	Элементы.Регламентный.ТолькоПросмотр = ДоступКПараметрамДоговора;
	Элементы.Валюта.ТолькоПросмотр = ДоступКПараметрамДоговора;
	
	ЭтоПроцессное = Объект.ТипОграничения = ПредопределенноеЗначение("Перечисление.ТипыОграничений.Процессные");
	Элементы.Контрагент.Видимость = ЭтоПроцессное;
	Элементы.Договор.Видимость = ЭтоПроцессное;
	Элементы.Валюта.Видимость = ЭтоПроцессное;
	Элементы.Регламентный.Видимость = ЭтоПроцессное;
	Элементы.ПунктНазначения.Видимость = ЭтоПроцессное;
	Элементы.ПунктНазначенияВРегионе.Видимость = ЭтоПроцессное;
	Элементы.ПунктОтправления.Заголовок = ?(ЭтоПроцессное, "Пункт отправления", "Пункт контроля");
	Элементы.ВидыОпераций.Доступность = ЭтоПроцессное;
	Элементы.РаспределениеВесаОперацииПоДням.Доступность = НЕ Объект.РаспределятьПоДням;
	Элементы.ЕдиницаИзмеренияКоличества.Видимость = (Объект.ЕдиницаТарификации = ПредопределенноеЗначение("Перечисление.ЕдиницыТарификации.КоличествоНоменклатуры"));
	
	Элементы.Коэффициенты.Доступность = (Объект.ЕдиницаТарификации = ПредопределенноеЗначение("Перечисление.ЕдиницыТарификации.ТС") ИЛИ Объект.ЕдиницаТарификации = ПредопределенноеЗначение("Перечисление.ЕдиницыТарификации.ТЕ"));
	Элементы.БазоваяЕИВеса.Видимость = (Объект.ЕдиницаТарификации = ПредопределенноеЗначение("Перечисление.ЕдиницыТарификации.ОбъемНоменклатуры") ИЛИ Объект.ЕдиницаТарификации = ПредопределенноеЗначение("Перечисление.ЕдиницыТарификации.ВесНоменклатуры"));
	Элементы.БазоваяЕИОбъема.Видимость = (Объект.ЕдиницаТарификации = ПредопределенноеЗначение("Перечисление.ЕдиницыТарификации.ОбъемНоменклатуры") ИЛИ Объект.ЕдиницаТарификации = ПредопределенноеЗначение("Перечисление.ЕдиницыТарификации.ВесНоменклатуры"));
	
	СВ = Новый Массив;
	Если ЭтоПроцессное Тогда
		СВ.Добавить(ПредопределенноеЗначение("Перечисление.ЕдиницыТарификации.Операция"));
		СВ.Добавить(ПредопределенноеЗначение("Перечисление.ЕдиницыТарификации.ТС"));
		СВ.Добавить(ПредопределенноеЗначение("Перечисление.ЕдиницыТарификации.ТЕ"));
	Иначе
		СВ.Добавить(ПредопределенноеЗначение("Перечисление.ЕдиницыТарификации.ТС"));
		СВ.Добавить(ПредопределенноеЗначение("Перечисление.ЕдиницыТарификации.ТЕ"));
	КонецЕсли;
	Элементы.ЕдиницаТарификации.СписокВыбора.ЗагрузитьЗначения(СВ);
	
КонецПроцедуры

