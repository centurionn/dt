&НаКлиенте
Процедура НоменклатураНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Объект.ЕдиницаТарификации = ПредопределенноеЗначение("Перечисление.ЕдиницыТарификации.КоличествоНоменклатуры") И НЕ ЗначениеЗаполнено(Объект.ЕдиницаИзмеренияКоличества) Тогда
		СтандартнаяОбработка = Ложь;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Перед подбором номенклатуры необходимо указать единицу измерения количества!";
		Сообщение.Поле = "Объект.ЕдиницаИзмеренияКоличества";
		Сообщение.УстановитьДанные(Объект);
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)
	
	Если Объект.ЕдиницаТарификации = ПредопределенноеЗначение("Перечисление.ЕдиницыТарификации.КоличествоНоменклатуры") Тогда
		Рез = ПроверитьНоменклатуруНаЕИ(Номенклатура.ВыгрузитьЗначения(), Объект.ЕдиницаИзмеренияКоличества);
		
		Для каждого Стр из Рез Цикл
			Сообщить("Базовая е.и. для " + Стр + " не соответствует единице измерения в ограничении. Номенклатура удалена!");
			Номенклатура.Удалить(Номенклатура.НайтиПоЗначению(Стр));
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьНоменклатуруНаЕИ(Номенклатура, ЕдиницаИзмеренияКоличества)
	
	Рез = Новый Массив;
	
	Для каждого Стр из Номенклатура Цикл
		Если Стр.БазоваяЕдиницаИзмерения <> ЕдиницаИзмеренияКоличества Тогда
			Рез.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Рез;
	
КонецФункции

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Объект.НижняяГраница И Объект.ЖелтыйПорог <= Объект.КрасныйПорог Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "При текущих настройках красный порог должен быть меньше, чем желтый!";
		Сообщение.Поле = "Объект.КрасныйПорог";
		Сообщение.УстановитьДанные(Объект);
		Сообщение.Сообщить();
		Отказ = Истина;
	ИначеЕсли НЕ Объект.НижняяГраница И Объект.ЖелтыйПорог >= Объект.КрасныйПорог Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "При текущих настройках красный порог должен быть больше, чем желтый!";
		Сообщение.Поле = "Объект.КрасныйПорог";
		Сообщение.УстановитьДанные(Объект);
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

