&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	   ТекущийОбъект.ТипыТС.Очистить();
	   ТекущийОбъект.ТипыТЕ.Очистить();
	   ТекущийОбъект.ВидыОпераций.Очистить();
	   Для каждого Стр из ТипыТС Цикл ТекущийОбъект.ТипыТС.Добавить().ТипТС = Стр.Значение; КонецЦикла;
	   Для каждого Стр из ТипыТЕ Цикл ТекущийОбъект.ТипыТЕ.Добавить().ТипТЕ = Стр.Значение; КонецЦикла;
	   Для каждого Стр из ВидыОпераций Цикл ТекущийОбъект.ВидыОпераций.Добавить().ВидОперации = Стр.Значение; КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТипыТС.ЗагрузитьЗначения(Объект.ТипыТС.Выгрузить().ВыгрузитьКолонку("ТипТС"));
	ТипыТЕ.ЗагрузитьЗначения(Объект.ТипыТЕ.Выгрузить().ВыгрузитьКолонку("ТипТЕ"));
	ВидыОпераций.ЗагрузитьЗначения(Объект.ВидыОпераций.Выгрузить().ВыгрузитьКолонку("ВидОперации"));
	
	
	//Евросиб Коханенко Н.А. #61705 08.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 08.12.2022 )

КонецПроцедуры

