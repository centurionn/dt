
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДоступныеТипыЗначенийДУ = Метаданные.справочники.ТипДополнительногоУсловия.Реквизиты.ТипЗначенияДУ.Тип.Типы();
	Для Каждого Эл Из ДоступныеТипыЗначенийДУ Цикл
		СписокТиповЗначенияДУ.Добавить(Эл,Строка(Эл));
		Элементы.СписокДУ.СписокВыбора.Добавить(Строка(Эл));
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Объект.ТипЗначенияДУСтрока) Тогда
		Попытка
			Если СтрНайти(Объект.ТипЗначенияДУСтрока,"Перечисление") = 0 Тогда
				ПредставлениеОб = Метаданные.НайтиПоПолномуИмени(Объект.ТипЗначенияДУСтрока).ПредставлениеОбъекта;
			Иначе
				ПредставлениеОб = Метаданные.НайтиПоПолномуИмени(Объект.ТипЗначенияДУСтрока).Синоним;
			КонецЕсли;
		Исключение
			ПредставлениеОб = Объект.ТипЗначенияДУСтрока;
		КонецПопытки;
		СписокДУ = ПредставлениеОб;
	КонецЕсли;
	
	
	//Евросиб Коханенко Н.А. #61705 08.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 08.12.2022 )

КонецПроцедуры

