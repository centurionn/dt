// ++ Евросиб Дудоров С.В. US 57543 30.01.2023 
Функция ПолучитьОтветственногоВФормеДоговора(ТипОтветственного)
	ОсновнойЦФО = ПредопределенноеЗначение("Справочник.ЦентрыФинансовойОтветственности.ОсновнойЦФО");
	Если ЦФО = Неопределено 
		или ЦФО = ПредопределенноеЗначение("Справочник.ЦентрыФинансовойОтветственности.ПустаяСсылка") 
		Тогда ЦФО = ОсновнойЦФО;
	КонецЕсли;	
	Если ТипОтветственного = Неопределено Тогда
		ТипОтветственного = ПредопределенноеЗначение("Перечисление.ТипыОтветственных.ОтветственныйЗаСопровождение");
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДоговорыКонтрагентовОтветственные.Ответственный КАК Ответственный
		|ПОМЕСТИТЬ вт_Ответственные
		|ИЗ
		|	&ТЧОтветственные КАК ДоговорыКонтрагентовОтветственные
		|ГДЕ
		|	ДоговорыКонтрагентовОтветственные.ЦФО = &ЦФО
		|	И ДоговорыКонтрагентовОтветственные.ТипОтветственного = &ТипОтветственного
		|	И ДоговорыКонтрагентовОтветственные.Ответственный <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_Ответственные.Ответственный КАК Ответственный
		|ИЗ
		|	вт_Ответственные КАК вт_Ответственные";
	
	Запрос.УстановитьПараметр("ТЧОтветственные", Ответственные.ВыгрузитьКолонки());
	Запрос.УстановитьПараметр("ТипОтветственного", ТипОтветственного);
	Запрос.УстановитьПараметр("ЦФО", ЦФО);
    Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Ответственный;
	КонецЦикла;
	Возврат ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка");
КонецФункции
// -- Евросиб Дудоров С.В. US 57543 30.01.2023 
	

// ДИТ 56017 Давудов М.А. Начало: 13.07.2023
Процедура ЗаполнитьНастройкуРассылкиПДЗ()
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписей = РегистрыСведений.НастройкиРассылкиПДЗ.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Договор.Установить(Ссылка);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контрагент", Ссылка.Владелец);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтрагентыТабМенеджеры.Фамилия КАК Фамилия,
	|	КонтрагентыТабМенеджеры.Имя КАК Имя,
	|	КонтрагентыТабМенеджеры.Отчество КАК Отчество,
	|	КонтрагентыТабМенеджеры.EMail КАК EMail
	|ИЗ
	|	Справочник.Контрагенты.ТабМенеджеры КАК КонтрагентыТабМенеджеры
	|ГДЕ
	|	КонтрагентыТабМенеджеры.Ссылка = &Контрагент
	|	И (КонтрагентыТабМенеджеры.КонтактДляПСЦ
	|			ИЛИ КонтрагентыТабМенеджеры.КонтактДляСчетаКлиенту
	|			ИЛИ КонтрагентыТабМенеджеры.КонтактДляРеализации)
	|	И КонтрагентыТабМенеджеры.EMail ПОДОБНО ""%@%""
	|	И НЕ КонтрагентыТабМенеджеры.EMail ПОДОБНО ""%@eurosib.biz""";
	
	Результат = Запрос.Выполнить();
	ТаблицаМенеджеров = Результат.Выгрузить();
	
	Если ТаблицаМенеджеров.Количество() = 0 Тогда
		ТекстСообщения = 
			НСтр("ru = 'Для договора ""%1"" не удалось автоматически заполнить «Настройки рассылки ПДЗ», требуется ручное заполнение'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Ссылка);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаМенеджера Из ТаблицаМенеджеров Цикл
		МенеджерЗаписи = РегистрыСведений.НастройкиРассылкиПДЗ.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Договор = Ссылка;
		МенеджерЗаписи.ЭлектроннаяПочта = СтрокаМенеджера.EMail;
		МенеджерЗаписи.ФИО = СтрокаМенеджера.Фамилия + ?(ЗначениеЗаполнено(СтрокаМенеджера.Фамилия), " ", "") + 
			СтрокаМенеджера.Имя + 
			?(ЗначениеЗаполнено(СтрокаМенеджера.Фамилия) ИЛИ ЗначениеЗаполнено(СтрокаМенеджера.Имя), " ", "") + 
		СтрокаМенеджера.Отчество;
		МенеджерЗаписи.Записать(Истина);
	КонецЦикла;
	
КонецПроцедуры // ДИТ 56017 Давудов М.А. Конец: 13.07.2023

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
