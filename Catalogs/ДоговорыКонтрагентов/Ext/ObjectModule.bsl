	Если Не ОбменДанными.Загрузка И НЕ БитФинансСервер.ЭтотОбъектЕстьВБФ(Владелец) Тогда
		Сообщить("Нельзя вводить договор по контрагенту, отсутствующему в Бит.Финанс. Операция прервана.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Редактор = Пользователи.ТекущийПользователь();
	Изменено = ТекущаяДата();
	
	// + Состояния
	
	// проверяем корректность перечня состояний в ТЧ Состояния
	Для Сч = 0 По Состояния.Количество() - 2 Цикл
		ТекСостояние = Состояния[Сч].Состояние;
		Для ТекСч = Сч + 1 По Состояния.Количество() - 1 Цикл
			Если Состояния[ТекСч].Состояние = ТекСостояние Тогда
				Сообщить("Ошибка: одно состояние может встречаться в документе только один раз!");
				Отказ = Истина;
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// Заполняем этапы операции
	Если Не ОбменДанными.Загрузка И Состояния.Количество() = 0 Тогда
		НСтр = Состояния.Добавить();
		НСтр.Исполнитель = Редактор;
		НСтр.Состояние = Справочники.Состояния.Выполнение;
		НСтр.Статус = Перечисления.СтатусыЭтапов.Новый;
	КонецЕсли;
	
