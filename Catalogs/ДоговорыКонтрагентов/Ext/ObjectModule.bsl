	//		НСтр.НормативИсполненияСМоментаСоздания=26;
	//		НСтр.ВидНормативаИсполнения=Перечисления.ВидыНормативовИспользования.ЧасовСМоментаСозданияДокумента;
	//	КонецЕсли;
	//КонецЕсли;
	
	//Евосиб Максимова
	// Маршрутизация договора
	ДляДанногоОбъектаТребуетсяПеремаршрутизация = Не ОбменДанными.Загрузка И 
	(Состояния.Количество() = 0 ИЛИ НЕ ЗначениеЗаполнено(Ссылка) ИЛИ 
	Ссылка.Организация <> Организация ИЛИ 
	Ссылка.ТипДоговорнойЗаписи <> ТипДоговорнойЗаписи ИЛИ 
	Ссылка.Типовой <> Типовой ИЛИ 
	Ссылка.РегионДоговора <> РегионДоговора ИЛИ 
	Ссылка.КатегорияДоговора <> КатегорияДоговора ИЛИ 
	Ссылка.ВидДоговора <> ВидДоговора ИЛИ
	Ссылка.ОтветственныйЗаДоговор <> ОтветственныйЗаДоговор ИЛИ //Евросиб Гудкова( 27.07.2020 Ticket№ 0201581
	Ссылка.ЦФО <> ЦФО ИЛИ //Евросиб Гудкова( 11.08.2020
	Ссылка.ВалютаВзаиморасчетов <> ВалютаВзаиморасчетов);
	
	Если Не ОбменДанными.Загрузка И Маршрутизировать И ДляДанногоОбъектаТребуетсяПеремаршрутизация Тогда
		
		ПараметрыЗапроса = Новый Соответствие;
		ПараметрыЗапроса.Вставить("Организация", Организация);
		ПараметрыЗапроса.Вставить("Контрагент", Владелец);
		ПараметрыЗапроса.Вставить("Договор", ЭтотОбъект);
		
		ПараметрыЗапроса.Вставить("КатегорияДоговора", КатегорияДоговора);
		ПараметрыЗапроса.Вставить("ТипДоговорнойЗаписи", ТипДоговорнойЗаписи);
		ПараметрыЗапроса.Вставить("Нетиповой", Не Типовой);
		ПараметрыЗапроса.Вставить("РегионДоговора", РегионДоговора);
		ПараметрыЗапроса.Вставить("ВидДоговора", ВидДоговора);
		ПараметрыЗапроса.Вставить("Валюта", ВалютаВзаиморасчетов);
		ПараметрыЗапроса.Вставить("ЦФО", ЦФО);
		ПараметрыЗапроса.Вставить("Нерезидент", (Владелец.СтранаРегистрации <> Справочники.СтраныМира.Россия));
		//Евросиб Максимова Ticket#0203438
		ПараметрыЗапроса.Вставить("УсловиеОплаты",УсловиеОплаты);
		ПараметрыЗапроса.Вставить("Подписан", Подписан);
		//Евросиб Максимова

		РезультатЗапроса = МаршрутизацияСервер.МаршрутизироватьДоговор(ПараметрыЗапроса, Дата);
		Если РезультатЗапроса.Количество() > 0 Тогда
			
			Если РезультатЗапроса.Количество() > 0 Тогда
				УказанныеВручнуюИспНаблюдатель = Новый СписокЗначений;
				Если ДополнительныеСвойства.Свойство("ДопСвойстваОбъекта") тогда
					УказанныеВручнуюИспНаблюдатель = ДополнительныеСвойства.ДопСвойстваОбъекта;
				КонецЕсли;
				МаршрутизацияСервер.ПрименитьМаршрут(ЭтотОбъект, РезультатЗапроса, Автор, УказанныеВручнуюИспНаблюдатель); 
				
				//ДИТ, Беляев СЮ, Ticket#0287047, 26-10-2022, закомментировал, перенёс в МаршрутизацияСервер.ПостобработкаТЧСостояний()
				////ДИТ Авдеева В.С. 47090 11.04.2022 Начало
				//МаршрутизацияСервер.УстановитьВыполнениеЗафиксировано(ЭтотОбъект);  
