	КонецЕсли;       
	
	//ДИТ, Беляев СЮ, Ticket#0344187, 06-03-2024, начало
	МаршрутизацияСервер.ПараллельноеСогласование(Состояния);
	//ДИТ, Беляев СЮ, Ticket#0344187, 06-03-2024, конец
	
	//ДИТ, Беляев СЮ, Ticket#0287047, 26-10-2022, закомментировал, перенёс в МаршрутизацияСервер.ПостобработкаТЧСостояний()
	////ДИТ Авдеева В.С. 47090 11.04.2022 Начало 
	//Если Не ОбработаноВыполнениеЗафиксировано Тогда 
	//	МаршрутизацияСервер.УстановитьВыполнениеЗафиксировано(ЭтотОбъект);  
	//КонецЕсли;
	////ДИТ Авдеева В.С. 47090 11.04.2022 Конец

	
	// если исполнитель пустой, то проставляем тек пользователя
	Для каждого Стр из Состояния Цикл
		
		Если Стр.ВидНормативаИсполнения = Перечисления.ВидыНормативовИспользования.Плюс30ДнейСДатыДоговора Тогда
			Стр.НормативИсполненияСМоментаСоздания = 30*24;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Стр.ВидНормативаИсполнения) Тогда
			Стр.ВидНормативаИсполнения = Перечисления.ВидыНормативовИспользования.ЧасовСМоментаСозданияДокумента;
		КонецЕсли;
		
		Если Стр.ПримечаниеЗадачаИсполнителю Тогда
			// если текст примечания изменился, то создать новое сообщение. если остался прежним, то не менять
			// т.к. состояние уникально, ищем по нему
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Состояние",Стр.Состояние);
			НайденнаяСтр = Ссылка.Состояния.НайтиСтроки(ПараметрыОтбора);
			Если НайденнаяСтр.Количество()>0 Тогда
				Если НЕ НайденнаяСтр[0].Комментарий = Стр.Комментарий Тогда
					
					// +Шейко ОЕ [Ticket#0204385] Личные сообщения пользователям
					ДатаСообщения = ТекущаяДата();
					АвторСообщения = Пользователи.ТекущийПользователь();
					ТекстСообщения = Стр.Комментарий;
					ГУИДСообщения = Новый УникальныйИдентификатор();
					
					ГУИДТемы = Новый УникальныйИдентификатор;
					
					РассылкаПоЛичнымЦелям.СформироватьЛичноеСообщение(ГУИДТемы, , Ссылка, ДатаСообщения, АвторСообщения, ТекстСообщения, , ГУИДСообщения, Стр.Исполнитель);
					// -Шейко ОЕ [Ticket#0204385] Личные сообщения пользователям
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если Стр.НаблюдательКакРуководительИсполнителя И ТипЗнч(Стр.Исполнитель) = Тип("СправочникСсылка.Пользователи") И ЗначениеЗаполнено(Стр.Исполнитель.НепосредственныйРуководитель) Тогда
			Стр.Наблюдатель = Стр.Исполнитель.НепосредственныйРуководитель;
		КонецЕсли;
		
	КонецЦикла;
	
	// определяем текущее состояние. для нас это первое состояние не в "выполнено"
	//Для каждого Состояние из Состояния Цикл
	//	Если Состояние.Статус <> Перечисления.СтатусыЭтапов.Выполнен Тогда
	//		ТекущееСостояние = Состояние.Состояние;
	//		Прервать;
	//	КонецЕсли;
	//КонецЦикла;
	
	МаршрутизацияСервер.ПостобработкаТЧСостояний(ЭтотОбъект, Пользователи.ТекущийПользователь());
	
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0398546, 14-05-2025, начало
	Если ПолученОригинал Тогда
		ЗадачиДляОтмены = Новый Массив;
		ЗадачиДляОтмены.Добавить(Справочники.Состояния.КонтрольПоступленияОригиналаДоговора);
		МаршрутизацияСервер.ОтметитьВыполнениеЗадач(ЭтотОбъект, ЗадачиДляОтмены);
	КонецЕсли;
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0398546, 14-05-2025, конец
	
	// - Состояния
	
	//<< Евросиб - Витвицкий 09.07.2019
	Если НЕ ОбменДанными.Загрузка И НЕ ЭтоНовый() И Не ЭтоГруппа Тогда	
		Если Владелец <> Ссылка.Владелец Тогда		
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
			|	ДокументыПоДоговоруКонтрагента.Ссылка
			|ИЗ
			|	КритерийОтбора.ДокументыПоДоговоруКонтрагента(&Договор) КАК ДокументыПоДоговоруКонтрагента";
			
			Запрос.УстановитьПараметр("Договор", Ссылка);
			
			Результат = Запрос.Выполнить();
			ЕстьДокументыПоДоговору = НЕ Результат.Пустой();
			
			Если ЕстьДокументыПоДоговору Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Существуют документы, оформленные по договору """ + Наименование + """.
																|Контрагент договора не может быть изменен, элемент не записан.",,,,Отказ);				
			КонецЕсли; 
		КонецЕсли;
		
		// Проверим возможность смены способа ведения взаиморасчетов и валюты взаиморасчетов
		Если ВалютаВзаиморасчетов <> Ссылка.ВалютаВзаиморасчетов 
			ИЛИ ВидДоговора <> Ссылка.ВидДоговора
			ИЛИ Организация <> Ссылка.Организация
			ИЛИ РасчетыВУсловныхЕдиницах <> Ссылка.РасчетыВУсловныхЕдиницах Тогда
			
			Если Справочники.ДоговорыКонтрагентов.ЕстьСсылкиНаДоговорКонтрагента(Ссылка) Тогда		
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Существуют документы, проведенные по договору """ + Наименование + """.
				|Реквизиты: ""Организация"", ""Валюта взаиморасчетов"", ""Вид договора"", 
				|""Расчеты в условных единицах"" не могут быть изменены, элемент не записан.",,,,Отказ);
			КонецЕсли;		
		КонецЕсли;	
	КонецЕсли;	
	//>> Евросиб - Витвицкий 09.07.2019
	
//Евросиб Гудкова( 16.07.2020 Ticket№ 0200289
	//Если Не ОбменДанными.Загрузка И НЕ ЗначениеЗаполнено(СрокОплаты) Тогда
	//	СрокОплаты = Константы.СрокЗадолженностиДляОтнесенияПокупателяВСтопЛист.Получить();
	//КонецЕсли;
// Евросиб Гудкова) 	
	
	ЛичныеЦелиСервер.ОчиститьЗаписиЛичныхЦелей(Ссылка);
	
	// если изменились данные по реквизитам ПДЗ - записать их в регистр
	Если Ссылка.СтатусПДЗ <> СтатусПДЗ ИЛИ
		Ссылка.КомментарийПДЗ <>КомментарийПДЗ Тогда
		
		ТекЗапись = РегистрыСведений.ИсторияСтатусовПДЗ.СоздатьМенеджерЗаписи();
		ТекЗапись.Период = ТекущаяДата();
		ТекЗапись.Договор = Ссылка;
		ТекЗапись.Статус = СтатусПДЗ;
		ТекЗапись.Комментарий = КомментарийПДЗ;
		ТекЗапись.Ответственный = ПользователиКлиентСервер.ТекущийПользователь();
		ТекЗапись.Записать();
	
	КонецЕсли;   
	
	// ДИТ 56017 Давудов М.А. Начало: 13.07.2023
	Если НЕ (ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем)
	   И УчаствуетВРассылкеПДЗ Тогда
		УчаствуетВРассылкеПДЗ = Ложь;
	КонецЕсли;
	// ДИТ 56017 Давудов М.А. Конец: 13.07.2023
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Автор = Пользователи.ТекущийПользователь();
	ЦФО = Автор.ЦФО;
	Создано = ТекущаяДата();
	ОтветственныйЗаДоговор = Автор;
	Организация = Константы.ОсновнаяОрганизация.Получить();
