Функция ПолучитьЗначенияРеквизитовДоговораПоУмолчанию(Договор) Экспорт
	
	//Евросиб СубботинВ #89675 16.08.2024 Начало //добавил в структуру возврат значения "МультивалютныйДоговор")
	//ЗначенияРеквизитов = Новый Структура("Типовой, ВалютаОплаты, ВалютаВзаиморасчетов, ОтветственныйЗаДоговор, НаименованиеСтороны");
	ЗначенияРеквизитов = Новый Структура("Типовой, ВалютаОплаты, ВалютаВзаиморасчетов, ОтветственныйЗаДоговор, НаименованиеСтороны, НаименованиеCтороныЕвросиб, МультивалютныйДоговор, ФормаПротокола");
	//Евросиб СубботинВ #89675 16.08.2024 Конец

	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.МультивалютныйДоговор КАК МультивалютныйДоговор,
	|	ЕСТЬNULL(ДоговорыКонтрагентов1.ВалютаВзаиморасчетов, НЕОПРЕДЕЛЕНО) КАК ВалютаПоУмолчаниюМультивалютногоДоговора,
	|	ДоговорыКонтрагентов.РасчетыВУсловныхЕдиницах КАК РасчетыВУсловныхЕдиницах,
	|	ДоговорыКонтрагентов.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов,
	|	ДоговорыКонтрагентов.ОтветственныйЗаДоговор КАК ОтветственныйЗаДоговор,
	|	ДоговорыКонтрагентов.НаименованиеСтороны КАК НаименованиеСтороны,
	|	ДоговорыКонтрагентов.Типовой КАК Типовой,
	|	ДоговорыКонтрагентов.НаименованиеCтороныЕвросиб КАК НаименованиеCтороныЕвросиб,
	|	ДоговорыКонтрагентов.ФормаПротокола КАК ФормаПротокола
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов.ДоговорыОплаты КАК ДоговорыКонтрагентовДоговорыОплаты
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов1
	|			ПО ДоговорыКонтрагентовДоговорыОплаты.Договор = ДоговорыКонтрагентов1.Ссылка
	|		ПО ДоговорыКонтрагентов.Ссылка = ДоговорыКонтрагентовДоговорыОплаты.Ссылка
	|			И (ДоговорыКонтрагентовДоговорыОплаты.ВалютаПоУмолчанию)
	|ГДЕ
	|	ДоговорыКонтрагентов.Ссылка = &Договор";
	
	Запрос.УстановитьПараметр("Договор", Договор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Выборка);
		
		Если Выборка.МультивалютныйДоговор Тогда
			ЗначенияРеквизитов.ВалютаОплаты = Выборка.ВалютаПоУмолчаниюМультивалютногоДоговора;
		Иначе
			ЗначенияРеквизитов.ВалютаОплаты = Выборка.ВалютаВзаиморасчетов;
		КонецЕсли;		
		
	КонецЕсли;
	
	Возврат ЗначенияРеквизитов;
	
КонецФункции

//Евросиб СубботинВ #90789 16.08.2024 Начало
// возвращает всегда сам договор и (при наличии) массив договоров связанный с основным(который передали) при мультивалютных историях
Функция ПолучитьСписокСвязанныхДоговоров(Договор) Экспорт
	
	МассивДоговоров = Новый Массив;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДоговорыКонтрагентов.Ссылка КАК Ссылка,
		|	ДоговорыКонтрагентов.МультивалютныйДоговор КАК МультивалютныйДоговор
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.Владелец = &Владелец
		|	И ДоговорыКонтрагентов.ВидДоговора = &ВидДоговора
		//Евросиб СубботинВ #126100 26.12.2025 Начало
		|	И НЕ ДоговорыКонтрагентов.РасчетыВУсловныхЕдиницах
		//Евросиб СубботинВ #126100 26.12.2025 Конец		
		|	И ДоговорыКонтрагентов.Код = &Код
		|	И НЕ ДоговорыКонтрагентов.ПометкаУдаления";
		
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ВидДоговора, Код, Владелец, Ссылка");
	Запрос.УстановитьПараметр("Владелец", РеквизитыДоговора.Владелец);
	Запрос.УстановитьПараметр("ВидДоговора", РеквизитыДоговора.ВидДоговора);
    Запрос.УстановитьПараметр("Код", РеквизитыДоговора.Код);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	СтруктураПоиска = Новый Структура("МультивалютныйДоговор", Истина); 
	МультивалютныйДоговор = РезультатЗапроса.НайтиСтроки(СтруктураПоиска);
	Если МультивалютныйДоговор.Количество()>0 Тогда
		Для Каждого СтрокаДоговор из РезультатЗапроса Цикл
			МассивДоговоров.Добавить(СтрокаДоговор.Ссылка);
		КонецЦикла;
	КонецЕсли;
	
