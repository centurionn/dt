Функция ПолучитьОтветственногоЗаДоговор(Договор) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(Пользователи.Ссылка, &ПользовательПустаяСсылка) КАК ОтветственныйЗаДоговор
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	|		ПО ДоговорыКонтрагентов.ОтветственныйЗаДоговор = Пользователи.Ссылка
	|			И (НЕ Пользователи.Недействителен)
	|ГДЕ
	|	ДоговорыКонтрагентов.Ссылка = &Договор";
	Запрос.УстановитьПараметр("Договор", Договор);
	
	ПользовательПустаяСсылка = Справочники.Пользователи.ПустаяСсылка();
	Запрос.УстановитьПараметр("ПользовательПустаяСсылка", ПользовательПустаяСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.ОтветственныйЗаДоговор;
	Иначе
		Результат = ПользовательПустаяСсылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
