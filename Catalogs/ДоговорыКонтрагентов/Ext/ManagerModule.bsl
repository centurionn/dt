	Запрос = Новый Запрос();
	Запрос.Текст = "	
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПользовательскиеМакетыПечати.Договор КАК ДоговорКонтрагента
	|ИЗ
	|	РегистрСведений.ПользовательскиеМакетыПечати КАК ПользовательскиеМакетыПечати
	|ГДЕ
	|	ПользовательскиеМакетыПечати.Договор = &ДоговорКонтрагента
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВзаиморасчетыСПокупателями.Договор
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСПокупателями КАК ВзаиморасчетыСПокупателями
	|ГДЕ
	|	ВзаиморасчетыСПокупателями.Договор = &ДоговорКонтрагента
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВзаиморасчетыСПоставщиками.Договор
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСПоставщиками КАК ВзаиморасчетыСПоставщиками
	|ГДЕ
	|	ВзаиморасчетыСПоставщиками.Договор = &ДоговорКонтрагента
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	РеализованныеТоварыКомитентов.ДоговорКонтрагента
	|ИЗ
	|	РегистрНакопления.РеализованныеТоварыКомитентов КАК РеализованныеТоварыКомитентов
	|ГДЕ
	|	РеализованныеТоварыКомитентов.ДоговорКонтрагента = &ДоговорКонтрагента
	|
	//|ОБЪЕДИНИТЬ ВСЕ
	//|
	//|ВЫБРАТЬ ПЕРВЫЕ 1
	//|	ЗакупленныеТоварыКомитентов.ДоговорКонтрагента
	//|ИЗ
	//|	РегистрНакопления.ЗакупленныеТоварыКомитентов КАК ЗакупленныеТоварыКомитентов
	//|ГДЕ
	//|	ЗакупленныеТоварыКомитентов.ДоговорКонтрагента = &ДоговорКонтрагента
	//|
	//|ОБЪЕДИНИТЬ ВСЕ
	//|
	//|ВЫБРАТЬ ПЕРВЫЕ 1
	//|	ЗакрытиеПериодов.Договор
	//|ИЗ
	//|	РегистрНакопления.ЗакрытиеПериодов КАК ЗакрытиеПериодов
	//|ГДЕ
	//|	ЗакрытиеПериодов.Договор = &ДоговорКонтрагента
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	РазнесениеСчетовПокупателейПоВходящимПлатежам.Договор
	|ИЗ
	|	РегистрНакопления.РазнесениеСчетовПокупателейПоВходящимПлатежам КАК РазнесениеСчетовПокупателейПоВходящимПлатежам
	|ГДЕ
	|	РазнесениеСчетовПокупателейПоВходящимПлатежам.Договор = &ДоговорКонтрагента";
	
	Запрос.УстановитьПараметр("ДоговорКонтрагента", ДоговорКонтрагента);	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт 

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "ДоговорМакет";
	КомандаПечати.Представление = "Макет договора";
	КомандаПечати.Обработчик    = "ДополнительныйМодульКлиент.ВыполнитьКомандуПечати";
	КомандаПечати.СписокФорм    = "ФормаСписка,ФормаЭлемента";
	КомандаПечати.ПроверкаПроведенияПередПечатью = Ложь;
	
