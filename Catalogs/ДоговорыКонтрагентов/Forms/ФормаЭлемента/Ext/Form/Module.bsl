Функция ВсеСогласовательныеСтатусы()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Состояния.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Состояния КАК Состояния
	               |ГДЕ
	               |	Состояния.Согласование";
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
