&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	//ДИТ Шевченко А.В. 56947 06.09.2022 -начало
	ПроверитьЗаполнениеОтветственных(Отказ);
	//ДИТ Шевченко А.В. 56947 06.09.2022 -конец
	Если Объект.Типовой и Не ЗначениеЗаполнено(Объект.МакетПечатнойФормыДоговора) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Для типовой формы договора нужно выбрать макет",, "Объект.МакетПечатнойФормыДоговора",, Отказ); 
	КонецЕсли;
	
	Для Сч = 1 По Объект.БанковскиеРеквизитыДляОплаты.Количество()-1 Цикл
		Если Объект.БанковскиеРеквизитыДляОплаты[Сч].ДействуетС < Объект.БанковскиеРеквизитыДляОплаты[Сч-1].ДействуетПо Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Пересекаются периоды строк " + (Сч) + " и " + (Сч+1) + ". Необходимо исправить, запись запрещена.",, "Объект.БанковскиеРеквизитыДляОплаты",, Отказ); 
		КонецЕсли;
	КонецЦикла;

	
	ДляДанногоОбъектаТребуетсяПеремаршрутизация = ПроверитьНеобходимостьМаршрутизации();
	Если Объект.Маршрутизировать И ДопСвойстваОбъекта.Количество() = 0 И ДляДанногоОбъектаТребуетсяПеремаршрутизация Тогда
		
		ПараметрыЗапроса = Новый Соответствие;
		ПараметрыЗапроса.Вставить("Организация", Объект.Организация);
		ПараметрыЗапроса.Вставить("Контрагент", Объект.Владелец);
		
		ПараметрыЗапроса.Вставить("КатегорияДоговора", Объект.КатегорияДоговора);
		ПараметрыЗапроса.Вставить("ТипДоговорнойЗаписи", Объект.ТипДоговорнойЗаписи);
		ПараметрыЗапроса.Вставить("Нетиповой", Не Объект.Типовой);
		ПараметрыЗапроса.Вставить("РегионДоговора", Объект.РегионДоговора);
		ПараметрыЗапроса.Вставить("ВидДоговора", Объект.ВидДоговора);
		ПараметрыЗапроса.Вставить("Валюта", Объект.ВалютаВзаиморасчетов);
		ПараметрыЗапроса.Вставить("Нерезидент", КонтрагентНерезидент(Объект.Владелец));
		
		РезультатЗапроса = МаршрутизацияСервер.МаршрутизироватьДоговор(ПараметрыЗапроса, Объект.Дата);
		Если РезультатЗапроса.Количество() > 0 Тогда
			Отказ = ПроверитьУказатьОтветственных(РезультатЗапроса, Истина);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановкаОтветственных(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	Для Каждого Стр Из Параметр1 Цикл
		НовСтр = Объект.Состояния.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,Стр);		
	КонецЦикла;
	Параметры.СохранитьДанныеСостояний = Истина;
	
	СтруктураЗаписиДанных = Новый СТруктура;
	СтруктураЗаписиДанных.Вставить("СостоянияИзменены",Истина);
	
	Записать(СтруктураЗаписиДанных);

КонецПроцедуры

&НаСервере
Функция ПроверитьНеобходимостьМаршрутизации()

	ДляДанногоОбъектаТребуетсяПеремаршрутизация =  
	(НЕ ЗначениеЗаполнено(Объект.Ссылка) ИЛИ Объект.Состояния.Количество() = 0 ИЛИ 
	Объект.Ссылка.Организация <> Объект.Организация ИЛИ 
	Объект.Ссылка.ТипДоговорнойЗаписи <> Объект.ТипДоговорнойЗаписи ИЛИ 
	Объект.Ссылка.Типовой <> Объект.Типовой ИЛИ 
	Объект.Ссылка.РегионДоговора <> Объект.РегионДоговора ИЛИ 
	Объект.Ссылка.КатегорияДоговора <> Объект.КатегорияДоговора ИЛИ 
	Объект.Ссылка.ВидДоговора <> Объект.ВидДоговора ИЛИ 
	Объект.Ссылка.ВалютаВзаиморасчетов <> Объект.ВалютаВзаиморасчетов);
	
	Возврат ДляДанногоОбъектаТребуетсяПеремаршрутизация;
	
КонецФункции

