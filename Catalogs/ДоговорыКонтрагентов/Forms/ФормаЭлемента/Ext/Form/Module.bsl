&НаКлиенте
Процедура СоздатьВБФ(Команда)
	
	Если ЭтаФорма.Модифицированность Тогда
		Отказ = Ложь;
		Ответ = Вопрос("Перед отправкой запроса в Бит.Финанс договор необходимо записать. Продолжить?", РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Нет,, КодВозвратаДиалога.Нет);
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			Отказ = Истина;
		ИначеЕсли Записать() = Ложь Тогда
			Отказ = Истина;
		КонецЕсли;
		Если Отказ = Истина Тогда
			Сообщить("Договор не записан, данные в Бит.Финанс переданы не будут!", СтатусСообщения.Важное);
			Возврат;
		КонецЕсли; 
	КонецЕсли;
	
	Сообщение = СоздатьВБФНаСервере();
	Сообщение.Сообщить();

