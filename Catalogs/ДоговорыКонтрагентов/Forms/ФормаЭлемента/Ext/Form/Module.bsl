&НаКлиенте
Процедура ПроверитьЗаполнениеОтветственных(Отказ)
	// ДИТ US 51951 TA 61497 Евсенкин М.А. 28.11.2022 
	мОтветственныйЗаУчет = ПредопределенноеЗначение("Перечисление.ТипыОтветственных.ОтветственныйЗаУчет"); 
	мОтветственныйЗаСопровождение = ПредопределенноеЗначение("Перечисление.ТипыОтветственных.ОтветственныйЗаСопровождение");
	мОсновнойЦФО = ПредопределенноеЗначение("Справочник.ЦентрыФинансовойОтветственности.ОсновнойЦФО");
	мТерминалНовосибирск = ПредопределенноеЗначение("Справочник.ЦентрыФинансовойОтветственности.ТерминалНовосибирск");
	
	Соответствие = Новый Соответствие;
	
	Для Каждого СтрОтветственный Из Объект.Ответственные Цикл 
		Если СтрОтветственный.ТипОтветственного = мОтветственныйЗаУчет И СтрОтветственный.ЦФО = мОсновнойЦФО Тогда 
			Соответствие.Вставить("ОтветственныйЗаУчет",СтрОтветственный.Ответственный);
		ИначеЕсли СтрОтветственный.ТипОтветственного = мОтветственныйЗаУчет И СтрОтветственный.ЦФО = мТерминалНовосибирск Тогда 
			Соответствие.Вставить("ОтветственныйЗаУчетНСК",СтрОтветственный.Ответственный);	 
		ИначеЕсли СтрОтветственный.ТипОтветственного = мОтветственныйЗаСопровождение И СтрОтветственный.ЦФО = мОсновнойЦФО Тогда 
			Соответствие.Вставить("ОтветственныйЗаСопровождение",СтрОтветственный.Ответственный);
		ИначеЕсли СтрОтветственный.ТипОтветственного = мОтветственныйЗаСопровождение И СтрОтветственный.ЦФО = мТерминалНовосибирск Тогда 
			Соответствие.Вставить("ОтветственныйЗаСопровождениеНСК",СтрОтветственный.Ответственный);	
		КонецЕсли;	
	КонецЦикла;
	
	// Проверка на лишние записи
	Отбор = Новый Структура("ЦФО,ТипОтветственного",мОсновнойЦФО, мОтветственныйЗаУчет);
	Если Объект.Ответственные.НайтиСтроки(Отбор).Количество() > 1 Тогда                                                                                   
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В ЦФО: %1 может быть только один %2!", мОсновнойЦФО, мОтветственныйЗаУчет),,,,Отказ);
	КонецЕсли;
	Отбор = Новый Структура("ЦФО,ТипОтветственного",мТерминалНовосибирск, мОтветственныйЗаУчет);
	Если Объект.Ответственные.НайтиСтроки(Отбор).Количество() > 1 Тогда 
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В ЦФО: %1 может быть только один %2!", мТерминалНовосибирск, мОтветственныйЗаУчет),,,,Отказ);	
	КонецЕсли;
	Отбор = Новый Структура("ЦФО,ТипОтветственного",мОсновнойЦФО, мОтветственныйЗаСопровождение);
	Если Объект.Ответственные.НайтиСтроки(Отбор).Количество() > 1 Тогда 
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В ЦФО: %1 может быть только один %2!", мОсновнойЦФО, мОтветственныйЗаСопровождение),,,,Отказ);	
	КонецЕсли;  
	Отбор = Новый Структура("ЦФО,ТипОтветственного",мТерминалНовосибирск, мОтветственныйЗаСопровождение);
	Если Объект.Ответственные.НайтиСтроки(Отбор).Количество() > 1 Тогда 
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В ЦФО: %1 может быть только один %2!", мТерминалНовосибирск, мОтветственныйЗаСопровождение),,,,Отказ);	
	КонецЕсли;
	//
	
	// ДИТ US 51951 TA 61497 Евсенкин М.А. 28.11.2022
	
	//ДИТ Шевченко А.В. 56947 06.09.2022 -начало
	Если ТипЗнч(Объект.Ссылка) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
		Для Каждого СтрокаСостояния Из Объект.Состояния Цикл
			Если СтрокаСостояния.Состояние = ПредопределенноеЗначение("Справочник.Состояния.ЗаполнитьОтветственногоЗаУчет")
				И СтрокаСостояния.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Выполнен")
					// ДИТ US 51951 TA 61497 Евсенкин М.А. 28.11.2022 
					//И НЕ ЗначениеЗаполнено(Объект.ОтветственныйЗаУчет) Тогда
					//ОбщегоНазначенияКлиент.СообщитьПользователю("Реквизит «Ответственный за учет» не заполнен",,"Объект.ОтветственныйЗаУчет",,Отказ);
					И НЕ ЗначениеЗаполнено(Соответствие.Получить("ОтветственныйЗаУчет")) Тогда
					// ДИТ US 51951 TA 61497 Евсенкин М.А. 28.11.2022
					ОбщегоНазначенияКлиент.СообщитьПользователю("Реквизит «Ответственный за учет» не заполнен",,,,Отказ);
			КонецЕсли;	
		КонецЦикла;	
		Для Каждого СтрокаСостояния Из Объект.Состояния Цикл
			Если СтрокаСостояния.Состояние = ПредопределенноеЗначение("Справочник.Состояния.УказатьОтветственногоЗаСопровождениеИУчетНСК")
				И СтрокаСостояния.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Выполнен")
					// ДИТ US 51951 TA 61497 Евсенкин М.А. 28.11.2022
					//И НЕ ЗначениеЗаполнено(Объект.ОтветственныйЗаСопровождениеНСК) Тогда
					//ОбщегоНазначенияКлиент.СообщитьПользователю("Реквизит «Ответственный За сопровождение НСК» не заполнен",,"Объект.ОтветственныйЗаСопровождениеНСК",,Отказ); 
					И НЕ ЗначениеЗаполнено(Соответствие.Получить("ОтветственныйЗаСопровождениеНСК")) Тогда
					ОбщегоНазначенияКлиент.СообщитьПользователю("Реквизит «Ответственный За сопровождение НСК» не заполнен",,,,Отказ);
					// ДИТ US 51951 TA 61497 Евсенкин М.А. 28.11.2022
			КонецЕсли;	
		КонецЦикла;
		Для Каждого СтрокаСостояния Из Объект.Состояния Цикл
			Если СтрокаСостояния.Состояние = ПредопределенноеЗначение("Справочник.Состояния.УказатьОтветственногоЗаСопровождениеИУчетНСК")
				И СтрокаСостояния.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Выполнен")
					// ДИТ US 51951 TA 61497 Евсенкин М.А. 28.11.2022
					//И НЕ ЗначениеЗаполнено(Объект.ОтветственныйЗаУчетНСК) Тогда
					//ОбщегоНазначенияКлиент.СообщитьПользователю("Реквизит «Ответственный за учет НСК» не заполнен",,"Объект.ОтветственныйЗаУчетНСК",,Отказ); 
					И НЕ ЗначениеЗаполнено(Соответствие.Получить("ОтветственныйЗаУчетНСК")) Тогда
					ОбщегоНазначенияКлиент.СообщитьПользователю("Реквизит «Ответственный за учет НСК» не заполнен",,,,Отказ);
					// ДИТ US 51951 TA 61497 Евсенкин М.А. 28.11.2022
			КонецЕсли;	
		КонецЦикла;
		Для Каждого СтрокаСостояния Из Объект.Состояния Цикл
			Если СтрокаСостояния.Состояние = ПредопределенноеЗначение("Справочник.Состояния.УказатьОтветственногоЗаСопровождение")
				И СтрокаСостояния.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Выполнен") 
					// ДИТ US 51951 TA 61497 Евсенкин М.А. 28.11.2022
					//И НЕ ЗначениеЗаполнено(Объект.ОтветственныйЗаСопровождение) Тогда
					//ОбщегоНазначенияКлиент.СообщитьПользователю("Реквизит «Ответственный за сопровождение» не заполнен",,"Объект.ОтветственныйЗаСопровождение",,Отказ); 
					И НЕ ЗначениеЗаполнено(Соответствие.Получить("ОтветственныйЗаСопровождение")) Тогда
					ОбщегоНазначенияКлиент.СообщитьПользователю("Реквизит «Ответственный за сопровождение» не заполнен",,,,Отказ);
					// ДИТ US 51951 TA 61497 Евсенкин М.А. 28.11.2022
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;	
	//ДИТ Шевченко А.В. 56947 06.09.2022 -конец
КонецПроцедуры	

&НаКлиенте
Процедура ПовторнаяМаршрутизация(Команда)
	
	Если Объект.Маршрутизировать Тогда
		ПараметрыЗапроса = Новый Соответствие;
		ПараметрыЗапроса.Вставить("Организация", Объект.Организация);
		ПараметрыЗапроса.Вставить("Контрагент", Объект.Владелец);
		ПараметрыЗапроса.Вставить("Договор", Объект.Ссылка);
		
		ПараметрыЗапроса.Вставить("КатегорияДоговора", Объект.КатегорияДоговора);
		ПараметрыЗапроса.Вставить("ТипДоговорнойЗаписи", Объект.ТипДоговорнойЗаписи);
		ПараметрыЗапроса.Вставить("Нетиповой", Не Объект.Типовой);
		ПараметрыЗапроса.Вставить("РегионДоговора", Объект.РегионДоговора);
		ПараметрыЗапроса.Вставить("ВидДоговора", Объект.ВидДоговора);
		ПараметрыЗапроса.Вставить("Валюта", Объект.ВалютаВзаиморасчетов);
		ПараметрыЗапроса.Вставить("ЦФО", Объект.ЦФО);
		ПараметрыЗапроса.Вставить("Нерезидент", КонтрагентНерезидент(Объект.Владелец));
		//Евросиб Максимова Ticket#0203438
		
		//ПараметрыЗапроса.Вставить("УсловиеОплаты",Объект.УсловиеОплаты);
		//ПараметрыЗапроса.Вставить("Подписан", ПодписанДоговор(Объект.Ссылка));
		//Евросиб Максимова
		РезультатЗапроса = МаршрутизацияСервер.МаршрутизироватьДоговор(ПараметрыЗапроса, Объект.Дата);
		
		Если РезультатЗапроса.Количество() > 0 Тогда
			Отказ = ПроверитьУказатьОтветственных(РезультатЗапроса, Ложь);
		Иначе
			Сообщить("Для документа не найден подходящий маршрут. Изменения не внесены!");
		КонецЕсли;
				
		ОбновитьПанельСостояний();
	КонецЕсли;
	
КонецПроцедуры

// +++ БЛОК НОВОЙ МАРШРУТИЗАЦИИ

&НаКлиенте
Функция ПроверитьУказатьОтветственных(РезультатЗапроса, СобытиеПередЗаписью)
	
	ДопСвойстваОбъекта.Очистить();
	ЧтоНужноУказатьВручную = Новый Массив;
	Для каждого Стр из  РезультатЗапроса Цикл
		Исполнитель = Стр.Исполнитель;
		Если НЕ Стр.ТребуетсяУказатьИсполнителя И НЕ ЗначениеЗаполнено(Исполнитель) Тогда Исполнитель = Объект.Автор; КонецЕсли;
		Наблюдатель = Стр.Наблюдатель;
		Если НЕ Стр.ТребуетсяУказатьНаблюдателя И НЕ ЗначениеЗаполнено(Наблюдатель) Тогда Наблюдатель = Объект.Автор; КонецЕсли;
		
		Если Стр.ТребуетсяУказатьИсполнителя ИЛИ Стр.ТребуетсяУказатьНаблюдателя Тогда 
			ЧтоНужноУказатьВручную.Добавить(Новый Структура("Состояние, Исполнитель, Наблюдатель", Стр.Состояние, Исполнитель, Наблюдатель)); 
		КонецЕсли;
	КонецЦикла;
	Если ЧтоНужноУказатьВручную.Количество() > 0 Тогда
		ОпОп = Новый ОписаниеОповещения("ОбработкаУказанияОтветственных", ЭтаФорма, Новый Структура("РезультатЗапроса, СобытиеПередЗаписью", РезультатЗапроса, СобытиеПередЗаписью));
		ПараметрыОтбора = Новый СТруктура;
		ПараметрыОтбора.Вставить("ВыбраннаяМаршрутизация", ЧтоНужноУказатьВручную);
		ОткрытьФорму("Справочник.Маршрутизация.Форма.ФормаЗаполненияСостояний",ПараметрыОтбора,, ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		Если НЕ СобытиеПередЗаписью Тогда ПовторнаяМаршрутизация_сервер(РезультатЗапроса); КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаУказанияОтветственных(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = неопределено Тогда Возврат; КонецЕсли;
	ДопСвойстваОбъекта.ЗагрузитьЗначения(П1);
	Если П2.СобытиеПередЗаписью Тогда
		Записать();
	Иначе
		ПовторнаяМаршрутизация_сервер(П2.РезультатЗапроса);
	КонецЕсли;
	
КонецПроцедуры

