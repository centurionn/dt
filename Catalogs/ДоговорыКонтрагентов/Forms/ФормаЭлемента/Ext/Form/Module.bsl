			Если ТипЗнч(Элемент) = Тип("ПолеФормы") И СтрНачинаетсяС(Элемент.Имя, "БФ") Тогда
				Элемент.ТолькоПросмотр = Истина;
			КонецЕсли; 
//			Элемент.РедактированиеТекста = Не СтрНачинаетсяС(Элемент.Имя, "БФ");
		КонецЦикла; 
	КонецЕсли; 
	Элементы.ГруппаНерезидент.Видимость = КонтрагентНерезидент(Объект.Владелец);
	ДоговорСпокупателем = Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем");
	Элементы.ГруппаКлиента.Видимость = ДоговорСпокупателем;
	Если ДоговорСпокупателем Тогда
		Элементы.МакетПечатнойФормыДоговора.СписокВыбора.ЗагрузитьЗначения(МакетыКлиента);
	Иначе	
		Элементы.МакетПечатнойФормыДоговора.СписокВыбора.ЗагрузитьЗначения(МакетыПодрядчика);
	КонецЕсли; 	
	Элементы.МакетПечатнойФормыДоговора.Видимость = Объект.Типовой;
	Элементы.ГруппаНДС0.Видимость = Объект.РазрешеноПрименениеНДС0;
// Евросиб Гудкова)

	//Евросиб Каблов 13.02.2025 ( #100589
	Если Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком") Тогда
		Элементы.СНПКонтейнеровШтраф.Видимость = Истина;
	Иначе
		Элементы.СНПКонтейнеровШтраф.Видимость = Ложь;
	КонецЕсли;
	//Евросиб Каблов 13.02.2025 )
	
	// ДИТ 56017 Давудов М.А. Начало: 13.07.2023
	Элементы.УчаствуетВРассылкеПДЗ.Видимость = ДоговорСпокупателем;
	// ДИТ 56017 Давудов М.А. Конец: 13.07.2023
	//Евросиб - АСуслов 03.01.2024 14:27:44 #78327
	//(
	Элементы.МультивалютныйДоговор.Доступность = НЕ Объект.РасчетыВУсловныхЕдиницах;
	Элементы.ГруппаВалютыОплаты.Видимость = Объект.МультивалютныйДоговор;
	//)
	//Евросиб - АСуслов 03.01.2024 14:27:45 #78327
	
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ЗапуститьДоговорНаСогласование" И Объект.Ссылка = Параметр Тогда
		
		ВсеСоглСтатусы = ВсеСогласовательныеСтатусы();
		Для каждого Стр из Объект.Состояния Цикл
			
			Если ВсеСоглСтатусы.Найти(Стр.Состояние) <> неопределено Тогда
				Стр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение");
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ИмяСобытия = "ТребуетсяПеречитатьУказанныйДокумент" И Параметр = Объект.Ссылка Тогда
		ЭтаФорма.Прочитать();
		ОбновитьПанельТекущегоПользователя();
		ОбновитьПанельСостояний();
	КонецЕсли;
	
КонецПроцедуры
 
