&НаКлиенте
Процедура ОтветственныйОбработкаВыбораТипа(ВыбранныйТип, ДопПараметры) Экспорт
	
	Если ВыбранныйТип <> Неопределено Тогда
		
		ТекДанные = Объект.Ответственные.НайтиПоИдентификатору(ДопПараметры.ИдентификаторТекСтроки);
		Если ВыбранныйТип.Значение = Тип("СправочникСсылка.ГруппыПользователей") Тогда
			ТекДанные.Ответственный = ПредопределенноеЗначение("Справочник.ГруппыПользователей.ПустаяСсылка");
		Иначе
			ТекДанные.Ответственный = ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка");
		КонецЕсли;		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтветственныеОтветственныйНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ТекДанные = Элементы.Ответственные.ТекущиеДанные;
	Если ТекДанные.ТипОтветственного = ПредопределенноеЗначение("Перечисление.ТипыОтветственных.ОтветственныйЗаСопровождение") Тогда 
		
		Если ТекДанные.Ответственный = Неопределено Тогда
			СтандартнаяОбработка = Ложь;
			
			ИдентификаторТекСтроки = ТекДанные.ПолучитьИдентификатор();		
			СписокТипов = Новый СписокЗначений;
			СписокТипов.Добавить(Тип("СправочникСсылка.ГруппыПользователей"));
			СписокТипов.Добавить(Тип("СправочникСсылка.Пользователи"));		
			
			ДопПараметры = Новый Структура("ИдентификаторТекСтроки", ИдентификаторТекСтроки);
			ОповещениеОВыборе = Новый ОписаниеОповещения("ОтветственныйОбработкаВыбораТипа", ЭтаФорма, ДопПараметры);		
			СписокТипов.ПоказатьВыборЭлемента(ОповещениеОВыборе, "Выбор типа данных");
			Возврат;
		КонецЕсли;
		СтандартнаяОбработка = Ложь;

		Если ТипЗнч(ТекДанные.Ответственный) = Тип("СправочникСсылка.ГруппыПользователей") Тогда 
			//СтруктураОтбора = Новый Структура();
			//СтруктураОтбора.Вставить("Иерархия", ПредопределенноеЗначение("Справочник.ГруппыПользователей.ГруппыОтветственныхЗаСопровождение")); 
			ОткрытьФорму("Справочник.ГруппыПользователей.ФормаВыбора", Новый Структура("ЭлементыВИерархии, РежимВыбора", ПредопределенноеЗначение("Справочник.ГруппыПользователей.ГруппыОтветственныхЗаСопровождение"), Истина),Элемент,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);		
		ИначеЕсли ТипЗнч(ТекДанные.Ответственный) = Тип("СправочникСсылка.Пользователи") Тогда 
			ОткрытьФорму("Справочник.Пользователи.ФормаВыбора", Новый Структура("РежимВыбора", Истина) ,Элемент,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли; 
		
	Иначе  
		СтандартнаяОбработка = Ложь;
		ОткрытьФорму("Справочник.Пользователи.ФормаВыбора", Новый Структура("РежимВыбора", Истина) ,Элемент,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
   	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтветственныеОтветственныйОчистка(Элемент, СтандартнаяОбработка)
	ТекДанные = Элементы.Ответственные.ТекущиеДанные;
	ТекДанные.Ответственный = Неопределено;
КонецПроцедуры

&НаКлиенте
Процедура ОтветственныеОтветственныйСоздание(Элемент, СтандартнаяОбработка)
	
   ОткрытьФормуВводаГруппы(Элемент, СтандартнаяОбработка)

КонецПроцедуры  

&НаКлиенте
Процедура ОткрытьФормуВводаГруппы(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
		
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗадатьОтборПоГруппеОтветственных", Истина);
	
	ОткрытьФорму("Справочник.ГруппыПользователей.Форма.ФормаЭлемента", ПараметрыФормы, Элемент, ЭтаФорма.УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

