&НаСервере
Процедура УстановитьОграниченияПричинаОтказаОтЭДО()
	
	Перем мПараметрыВыбора, Параметр, мДоступныеСтатусы;
	
	мПараметрыВыбора = Новый Массив();
	
	Если ЭтаФорма.Объект.ЕС_КонтрагентЭДО Тогда
		
		мДоступныеСтатусы = Новый Массив();
		мДоступныеСтатусы.Добавить(Перечисления.ПричинаОтказаОтЭДО.ЗаблокировалиНасВЭДО);
		мДоступныеСтатусы.Добавить(Перечисления.ПричинаОтказаОтЭДО.ОтказВСоответствииСПолитикойКомпанииКА);
		мДоступныеСтатусы.Добавить(Перечисления.ПричинаОтказаОтЭДО.ОтказЗакрытиеДоговора);
		мДоступныеСтатусы.Добавить(Перечисления.ПричинаОтказаОтЭДО.ОтказРаботаВДругойСистемеЧерезЛКНаправляютИзОРК);
		мДоступныеСтатусы.Добавить(Перечисления.ПричинаОтказаОтЭДО.ОтказНеВнедреноСоответствующееПрограммноеОбеспечениеУКА);
		мДоступныеСтатусы.Добавить(Перечисления.ПричинаОтказаОтЭДО.ОтказЧастичноРаботаютПоставщикИлиКлиент);
		
		Параметр = Новый ПараметрВыбора(
				"Отбор.Ссылка",
		    	    	Новый ФиксированныйМассив(мДоступныеСтатусы)
			);
			
		мПараметрыВыбора.Добавить(Параметр); 
	Иначе
		
		мДоступныеСтатусы = Новый Массив();
		мДоступныеСтатусы.Добавить(Перечисления.ПричинаОтказаОтЭДО.ИндивидуальнаяОтправкаРТУВДругиеСистемыЭДОКАПоДаннымОРК);		
		Параметр = Новый ПараметрВыбора(
				"Отбор.Ссылка",
		    	    	Новый ФиксированныйМассив(мДоступныеСтатусы)
			);
			
		мПараметрыВыбора.Добавить(Параметр); 
		
	КонецЕсли;
	
	ЭтаФорма.Элементы.ПричинаОтказаОтЭДО.ПараметрыВыбора = Новый ФиксированныйМассив(мПараметрыВыбора);
	
КонецПроцедуры

