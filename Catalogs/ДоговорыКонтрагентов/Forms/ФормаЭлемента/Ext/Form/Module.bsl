	// 2. если не типовой, то создавать не нужно, открыть присоединенные
	//ИначеЕсли ТекПроцессСогл = ПредопределенноеЗначение("Справочник.ПроцессСогласования.ПустаяСсылка") И НЕ Объект.Типовой Тогда
	//	ОпОп = Новый ОписаниеОповещения("ОбработкаСогласования", ЭтаФорма);
	//	ПараметрыФормы = Новый Структура("ДокументСогласования", Объект.Ссылка);
	//	ОткрытьФорму("Справочник.ПроцессСогласования.ФормаОбъекта", ПараметрыФормы,, ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	// 3. если процесс согласования ранее создан, открыть его
	Иначе
		ПараметрыФормы = Новый Структура("Ключ", ТекПроцессСогл);
		ОткрытьФорму("Справочник.ПроцессСогласования.ФормаОбъекта", ПараметрыФормы,ЭтаФорма, ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
	
