&НаСервере
Процедура ЗаполнитьПДЗИзРегистра()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИсторияСтатусовПДЗСрезПоследних.Период КАК Период,
	               |	ИсторияСтатусовПДЗСрезПоследних.Статус КАК СтатусПДЗ,
	               |	ИсторияСтатусовПДЗСрезПоследних.Комментарий КАК КомментарийПДЗ,
	               |	ИсторияСтатусовПДЗСрезПоследних.Ответственный КАК Ответственный
	               |ИЗ
	               |	РегистрСведений.ИсторияСтатусовПДЗ.СрезПоследних(, Договор = &Договор) КАК ИсторияСтатусовПДЗСрезПоследних";
	Запрос.УстановитьПараметр("Договор",Объект.Ссылка);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Объект,Ответ);
		ДатаСтатусаПДЗ = Ответ.Период;
		ОтветственныйПДЗ = Ответ.Ответственный;
	КонецЕсли;
	
КонецПроцедуры	
	
