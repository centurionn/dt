
Процедура ПередЗаписью(Отказ)
	
	Если ЗначениеЗаполнено(ИДДорога) Тогда
		
		Попытка
			ИДДорогиЧислом = Число(ИДДорога);
		Исключение
			Возврат; 
		КонецПопытки;
		
		ИскКод = "";
		Если СтрДлина(ИДДорога) < 3 Тогда
			ИскКод = Формат(ИДДорогиЧислом, "ЧЦ=2; ЧВН=");
		Иначе
			ИскКод = Формат(ИДДорогиЧислом, "ЧЦ=3; ЧВН=");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИскКод) Тогда
			Дорога = Справочники.э_Дороги.НайтиПоКоду(ИскКод);
		КонецЕсли; 
	КонецЕсли;
	Если ЗначениеЗаполнено(ИдРегион) Тогда	
		Если ЗначениеЗаполнено(ИдРегион) Тогда
			Регион = Справочники.э_Регионы.НайтиПоКоду(ИдРегион);	
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
