&НаКлиенте
Процедура ОК(Команда)
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Использование",Истина);
	НайденныеСтроки = СписокПолей.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество() = 0 Тогда
		Сообщить("Не выбрано ни одного столбца!");
		Возврат;
	КонецЕсли;
	
	ЗаписатьПодборВХранилище();
	ВладелецФормы.ОбработатьПодбор(КодСправочника);	
	Закрыть();
КонецПроцедуры

&НаСервере
Процедура ЗаписатьПодборВХранилище()
	
	// запись в справочник настроек
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НастройкиФормыОтборовПользователей.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.НастройкиФормыОтборовПользователей КАК НастройкиФормыОтборовПользователей
	               |ГДЕ
	               |	НастройкиФормыОтборовПользователей.Пользователь = &Пользователь
	               |	И НастройкиФормыОтборовПользователей.НаименованиеПресета.Код = &КодПресета";
	Запрос.УстановитьПараметр("Пользователь",Пользователи.ТекущийПользователь());
	Запрос.УстановитьПараметр("КодПресета",КодСправочника);
	
	РЗ = Запрос.Выполнить().Выбрать();
	Если РЗ.Следующий() Тогда
		ТекСпр = РЗ.Ссылка;
		ПолучОб = ТекСпр.ПолучитьОбъект();
		ПолучОб.пометкаУдаления = Ложь;
		ТЧ = ПолучОб.СписокПолей;
		ТекИндекс = 1;
		Для Каждого Стр Из СписокПолей Цикл
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("НаименованиеСтолбцаВСистеме",Стр.НаименованиеСтолбцаВСистеме);
			НайденныеСтр = ТЧ.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтр.Количество()>0 Тогда
				НайденныеСтр[0].Использование = Стр.Использование;
				НайденныеСтр[0].НомерПоПорядку = ТекИндекс;
			КонецЕсли;
			ТекИндекс = ТекИндекс + 1;
		КонецЦикла;
		ПолучОб.Записать();
	КонецЕсли;
	
	ТЗХранилище = СписокПолей.Выгрузить();
	ПоместитьВоВременноеХранилище(ТЗХранилище,ПоляВХранилище);
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	Для Каждого Стр Из СписокПолей Цикл
		Стр.Использование = Истина;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьВсе(Команда)
	Для Каждого Стр Из СписокПолей Цикл
		Стр.Использование = Ложь;
	КонецЦикла;
КонецПроцедуры
