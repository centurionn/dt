
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПоляВХранилище = Параметры.ПоляВХранилище;
	КодСправочника = Параметры.КодСправочника;
	
	ДанныеИзФормыОтбора = ПолучитьИзВременногоХранилища(ПоляВХранилище);
	
	// проверяем, есть ли в справочнике такая запись. 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НастройкиФормыОтборовПользователейСписокПолей.НомерПоПорядку КАК НомерПоПорядку,
	               |	НастройкиФормыОтборовПользователейСписокПолей.НаименованиеСтолбцаВСистеме КАК НаименованиеСтолбцаВСистеме,
	               |	НастройкиФормыОтборовПользователейСписокПолей.НаименованиеСтолбца КАК НаименованиеСтолбца,
	               |	НастройкиФормыОтборовПользователейСписокПолей.Использование КАК Использование
	               |ИЗ
	               |	Справочник.НастройкиФормыОтборовПользователей.СписокПолей КАК НастройкиФормыОтборовПользователейСписокПолей
	               |ГДЕ
	               |	НастройкиФормыОтборовПользователейСписокПолей.Ссылка.Пользователь = &Пользователь
	               |	И НастройкиФормыОтборовПользователейСписокПолей.Ссылка.НаименованиеПресета.Код = &КодПресета
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерПоПорядку";
	Запрос.УстановитьПараметр("Пользователь",Пользователи.ТекущийПользователь());
	Запрос.УстановитьПараметр("КодПресета",КодСправочника);
	
	РЗ = Запрос.Выполнить();
	
	// если нет, то нужно создать, чтобы сохранить первоначальный набор столбцов
	Если РЗ.Пустой() Тогда
		НовСпр = Справочники.НастройкиФормыОтборовПользователей.СоздатьЭлемент();
		НовСпр.Пользователь = Пользователи.ТекущийПользователь();
		НовСпр.НаименованиеПресета = Справочники.ПресетыОтборовАРМ.НайтиПоКоду(КодСправочника);
		НовСпр.Наименование = Строка(НовСпр.Пользователь) + " " + НовСпр.НаименованиеПресета;
		НомерПП = 1;
		Для Каждого Элем Из ДанныеИзФормыОтбора Цикл
			НовСтр = НовСпр.СписокПолей.Добавить();
			НовСтр.НаименованиеСтолбца = Лев(Элем,СтрНайти(Элем,",")-1);
			НовСтр.НаименованиеСтолбцаВСистеме = Сред(Элем,СтрНайти(Элем,",")+1);
			НовСтр.НомерПоПорядку = НомерПП;
			НовСтр.Использование = Истина;
			НомерПП = НомерПП + 1;
		КонецЦикла;
		НовСпр.Записать();
		СсылкаСпр = НовСпр.Ссылка;
		ТЗ = СсылкаСпр.СписокПолей.Выгрузить();
	Иначе
		ТЗ = РЗ.Выгрузить();
	КонецЕсли;
	
	СписокПолей.Загрузить(ТЗ);
	
	
	//Евросиб Коханенко Н.А. #61705 08.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 08.12.2022 )

КонецПроцедуры

