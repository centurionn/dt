
&НаСервере
Процедура ОбновитьЦветовойМаркер()
	
	Если ЗначениеЗаполнено(Объект.Цвет) тогда
		Элементы.Наименование.ЦветФона = Новый Цвет(Объект.Цвет.Цвет_R, Объект.Цвет.Цвет_G, Объект.Цвет.Цвет_B);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЦветПриИзменении(Элемент)
	
	ОбновитьЦветовойМаркер();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбновитьЦветовойМаркер();
	СтруктураКартинок = Новый Структура;
	ОписаниеФормат.УстановитьHTML(Объект.Описание, СтруктураКартинок);
	
	СписокПроектов.Параметры.УстановитьЗначениеПараметра("Стратегия", Объект.Ссылка);
	
	// Обновляем панель текущего пользователя и панель состояний
	ОбновитьПанельТекущегоПользователя();
	ОбновитьПанельСостояний();
	
	
	//Евросиб Коханенко Н.А. #61705 08.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 08.12.2022 )

КонецПроцедуры

