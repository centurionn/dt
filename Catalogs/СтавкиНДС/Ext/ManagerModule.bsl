
Функция ПолучитьСтавкуНДСпоСтроковомуЗначению(СтроковоеЗначение) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СтавкиНДС.СтавкаНДС КАК СтавкаНДС
	|ИЗ
	|	Справочник.СтавкиНДС КАК СтавкиНДС
	|ГДЕ
	|	СтавкиНДС.СтроковоеЗначение = &СтроковоеЗначение";
	
	Запрос.УстановитьПараметр("СтроковоеЗначение", СтроковоеЗначение);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		СтавкаНДС = Выборка.СтавкаНДС;
	Иначе
		СтавкаНДС = Неопределено;
	КонецЕсли;
	
	Возврат СтавкаНДС;
	
КонецФункции    

// Евросиб(ДИТ) US 96051 ТА 96052 Сержантова А.С. 25.12.2024
// Функция возвращает код РИТМ по перечислению СтавкиНДС и по признаку включает или не включает НДС, введенные в РС Протокол обменов
// Обязательно наличие значения в Перечислении Ставки НДС, записи в справочнике Ставки НДС и записи кода в РС ПротоколОбменов
//
// Параметры:
//  СтавкаНДС  - ПеречислениеСсылка.СтавкиНДС
//  СуммаВключаетНДС  - Булево
//
// Возвращаемое значение:
//   КодСтавкиРИТМ   - Строка, пустаяСтрока, если значение не найдено
Функция ПолучитьКодСтавкиРИТМ(СтавкаНДС, СуммаВключаетНДС = Ложь) Экспорт
	
	//Ставки введены в РС ПротоколОбменов:
	//КодНДС = "TC00000R" НДС0			
	//КодНДС = "TC0020BT" (НДС20 и СуммаВключаетНДС) или 20/120 
	//КодНДС = "TC0020KT" НДС20 И Не СуммаВключаетНДС  
	//КодНДС = "TC0005BT" (НДС5 и СуммаВключаетНДС) или 5/105
	//КодНДС = "TC0005KT" НДС5 и Не СуммаВключаетНДС			
	//КодНДС = "TC0007BT" (НДС7 и СуммаВключаетНДС) или 7/107
	//КодНДС = "TC0007KT" НДС7 И Не СуммаВключаетНДС 						
	//КодНДС = "TC00000P" БезНДС   
	
	КодСтавкиРИТМ = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтавкиНДС1.Ссылка КАК СтавкаНДС_КромеТого,
		|	СтавкиНДС.Ссылка КАК СтавкаНДС_вТомЧисле
		|ПОМЕСТИТЬ ВТ_СоответствиеСтавок
		|ИЗ
		|	Справочник.СтавкиНДС КАК СтавкиНДС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СтавкиНДС КАК СтавкиНДС1
		|		ПО (ПОДСТРОКА(СтавкиНДС.Наименование, 0, 3) = СтавкиНДС1.Наименование)
		|ГДЕ
		|	(ПОДСТРОКА(СтавкиНДС.Наименование, 4, 1) = ""/""
		|			ИЛИ ПОДСТРОКА(СтавкиНДС.Наименование, 5, 1) = ""/"")
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПротоколОбменов.УИДИсточника КАК УИДИсточника
		|ИЗ
		|	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СоответствиеСтавок КАК ВТ_СоответствиеСтавок
		|		ПО (ВЫБОР
		|				КОГДА &СуммаВключаетНДС = ИСТИНА
		|					ТОГДА ПротоколОбменов.Объект = ВТ_СоответствиеСтавок.СтавкаНДС_вТомЧисле
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ)
		|ГДЕ
		|	ПротоколОбменов.УзелОбмена.Ссылка = &УзелОбмена
		|	И ТИПЗНАЧЕНИЯ(ПротоколОбменов.Объект) = ЗНАЧЕНИЕ(Справочник.СтавкиНДС)
		|	И ВЫБОР
		|			КОГДА ВЫРАЗИТЬ(ПротоколОбменов.Объект КАК Справочник.СтавкиНДС).СтавкаНДС В (ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС), ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС0))
		|					ИЛИ НЕ &СуммаВключаетНДС
		|				ТОГДА ВЫРАЗИТЬ(ПротоколОбменов.Объект КАК Справочник.СтавкиНДС).СтавкаНДС = &СтавкаНДС
		|			ИНАЧЕ ВТ_СоответствиеСтавок.СтавкаНДС_КромеТого.СтавкаНДС = &СтавкаНДС
		|					ИЛИ ВТ_СоответствиеСтавок.СтавкаНДС_вТомЧисле.СтавкаНДС = &СтавкаНДС
		|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("СтавкаНДС", СтавкаНДС);
	Запрос.УстановитьПараметр("СуммаВключаетНДС", СуммаВключаетНДС);
	Запрос.УстановитьПараметр("УзелОбмена", Перечисления.УзлыОбмена.РИТМ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		КодСтавкиРИТМ = Выборка.УИДИсточника; 
	КонецЦикла;  
	
	Возврат КодСтавкиРИТМ;

КонецФункции 

// Евросиб(ДИТ) US 96051 ТА 96052 Сержантова А.С. 26.12.2024  
// Функция осуществляет поиск перечисления ставки НДС с учетом кодов, введенных в РС Протокол обменов из РИТМа
// Обязательно наличие значения в Перечислении Ставки НДС, записи в справочнике Ставки НДС и записи кода в РС ПротоколОбменов
//
// Параметры:
//  СтрокаСтавкаНДС  - Строка
//
// Возвращаемое значение:
//   СтавкаНДС   - ПеречислениеСсылка.СтавкаНДС, Неопределено
//
Функция ПолучитьСтавкуНДСПоКодуРИТМ(СтрокаСтавкаНДС) Экспорт

	//Логика подбора ставки НДС (коды ставок - соответствие из РС Протокол обменов)
	// Возвращаемая ставка НДС:    Входящая строка:		
	// - Без НДС				   "БЕЗ НДС", "TC00000P", "0/0", "" 
	// - НДС 0					   "0", "0%", "TC00000R" 
	// - НДС 5					   "5", "5/105", "TC0005KT", "TC0005ВT"  
	// - НДС 5/105				   "5%"
	// - НДС 7					   "7", "7/107", "TC0007KT", "TC0007ВT" 
	// - НДС 7/107				   "7%"
	// - НДС 18					   "18", "18/118", "TC00000T", "TC00000W" 
	// - НДС 18/118				   "18%"
	// - НДС 20					   "20", "20/120", "TC0020KT", "TC0020ВT" 
	// - НДС 20/120				   "20%"
	
	СоответствиеСтавок = Новый Соответствие();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтавкиНДС1.СтавкаНДС КАК СтавкаНДС_КромеТого,
		|	СтавкиНДС1.Наименование КАК Наименование_КромеТого,
		|	ЕСТЬNULL(ПротоколОбменов1.УИДИсточника, """") КАК Код_КромеТого,
		|	СтавкиНДС.СтавкаНДС КАК СтавкаНДС_вТомЧисле,
		|	СтавкиНДС.Наименование КАК Наименование_вТомЧисле,
		|	ЕСТЬNULL(ПротоколОбменов.УИДИсточника, """") КАК Код_вТомЧисле
		|ИЗ
		|	Справочник.СтавкиНДС КАК СтавкиНДС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СтавкиНДС КАК СтавкиНДС1
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменов1
		|			ПО СтавкиНДС1.Ссылка = ПротоколОбменов1.Объект
		|		ПО (ПОДСТРОКА(СтавкиНДС.Наименование, 0, 3) = СтавкиНДС1.Наименование)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
		|		ПО (ПротоколОбменов.Объект = СтавкиНДС.Ссылка)
		|ГДЕ
		|	(ПОДСТРОКА(СтавкиНДС.Наименование, 4, 1) = ""/""
		|			ИЛИ ПОДСТРОКА(СтавкиНДС.Наименование, 5, 1) = ""/"")
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СтавкиНДС.СтавкаНДС,
		|	СтавкиНДС.Наименование,
		|	ЕСТЬNULL(ПротоколОбменов.УИДИсточника, """"),
		|	NULL,
		|	NULL,
		|	NULL
		|ИЗ
		|	Справочник.СтавкиНДС КАК СтавкиНДС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
		|		ПО (ПротоколОбменов.Объект = СтавкиНДС.Ссылка)
		|ГДЕ
		|	СтавкиНДС.СтавкаНДС В (ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС), ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС0))";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл  
		
		Если Выборка.СтавкаНДС_КромеТого = Перечисления.СтавкиНДС.БезНДС Тогда
			СтрокаКромеТого = ВРЕГ(Выборка.Наименование_КромеТого);       
			
			СоответствиеСтавок.Вставить(СтрокаКромеТого, Выборка.СтавкаНДС_КромеТого);
			СоответствиеСтавок.Вставить(Выборка.Код_КромеТого, Выборка.СтавкаНДС_КромеТого);
			СоответствиеСтавок.Вставить("0/0", Выборка.СтавкаНДС_КромеТого);
            СоответствиеСтавок.Вставить("", Выборка.СтавкаНДС_КромеТого);
			
		ИначеЕсли Выборка.СтавкаНДС_КромеТого = Перечисления.СтавкиНДС.НДС0 Тогда
			
			СтрокаКромеТого = СтрЗаменить(Выборка.Наименование_КромеТого, "%", "");  
			
			СоответствиеСтавок.Вставить(СтрокаКромеТого, Выборка.СтавкаНДС_КромеТого); 
			СоответствиеСтавок.Вставить(Выборка.Код_КромеТого, Выборка.СтавкаНДС_КромеТого);
			СоответствиеСтавок.Вставить(Выборка.Наименование_КромеТого, Выборка.СтавкаНДС_КромеТого);
			
		Иначе	
			
			СтрокаКромеТого = СтрЗаменить(Выборка.Наименование_КромеТого, "%", "");   
			СоответствиеСтавок.Вставить(СтрокаКромеТого, Выборка.СтавкаНДС_КромеТого);
			
			СтрокаВТомЧисле = СтрЗаменить(Выборка.Наименование_вТомЧисле, "%", "");  
			СтрокаВТомЧисле = СтрЗаменить(СтрокаВТомЧисле, " ", "");
			СоответствиеСтавок.Вставить(СтрокаВТомЧисле, Выборка.СтавкаНДС_КромеТого);

			СоответствиеСтавок.Вставить(Выборка.Код_КромеТого, Выборка.СтавкаНДС_КромеТого);	
			СоответствиеСтавок.Вставить(Выборка.Код_вТомЧисле, Выборка.СтавкаНДС_КромеТого);

			СоответствиеСтавок.Вставить(Выборка.Наименование_КромеТого, Выборка.СтавкаНДС_вТомЧисле); 
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтавкаНДС = СоответствиеСтавок.Получить(ВРЕГ(СтрокаСтавкаНДС)); 
	
	Возврат СтавкаНДС;

КонецФункции
