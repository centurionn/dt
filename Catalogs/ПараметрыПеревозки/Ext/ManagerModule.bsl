
Функция НайтиПараметрПеревозки(РазмерКТК, ПринадлежностьТЕ, Валюта, ВидТранспортногоСообщения) Экспорт
	
	Ответ = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПараметрыПеревозки.Ссылка КАК ПараметрПеревозки
		|ИЗ
		|	Справочник.ПараметрыПеревозки КАК ПараметрыПеревозки
		|ГДЕ
		|	ПараметрыПеревозки.РазмерКТК = &РазмерКТК
		|	И ПараметрыПеревозки.ПринадлежностьТЕ = &ПринадлежностьТЕ
		|	И ПараметрыПеревозки.ВидТранспортногоСообщения = &ВидТранспортногоСообщения
		|	И ПараметрыПеревозки.Валюта = &Валюта
		|	И Не ПараметрыПеревозки.ПометкаУдаления";
		//|	И ПараметрыПеревозки.ТипСтавки = &ТипСтавки";
	
	Запрос.УстановитьПараметр("ВидТранспортногоСообщения", ВидТранспортногоСообщения);
	Запрос.УстановитьПараметр("ПринадлежностьТЕ", ПринадлежностьТЕ);
	Запрос.УстановитьПараметр("РазмерКТК", РазмерКТК);
	Запрос.УстановитьПараметр("Валюта", Валюта);
	//Запрос.УстановитьПараметр("ТипСтавки", ТипСтавки);
	
	Выгрузка = Запрос.Выполнить().Выгрузить();
	
	Если Выгрузка.Количество() = 1 Тогда
		Ответ = Выгрузка[0].ПараметрПеревозки;
	КонецЕсли;
	
	Если Выгрузка.Количество() = 0 Тогда
		Ответ = СоздатьПараметрПеревозки(РазмерКТК, ПринадлежностьТЕ, Валюта, ВидТранспортногоСообщения);
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

Функция СоздатьПараметрПеревозки(РазмерКТК, ПринадлежностьТЕ, Валюта, ВидТранспортногоСообщения) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	НовыйПараметрПеревозки = Справочники.ПараметрыПеревозки.СоздатьЭлемент();
	НовыйПараметрПеревозки.РазмерКТК = РазмерКТК;
	НовыйПараметрПеревозки.ПринадлежностьТЕ = ПринадлежностьТЕ;
	НовыйПараметрПеревозки.Валюта = Валюта;
	НовыйПараметрПеревозки.ВидТранспортногоСообщения = ВидТранспортногоСообщения;
	НовыйПараметрПеревозки.ДополнительныеСвойства.Вставить("ПроверкаУжеБыла");
	НовыйПараметрПеревозки.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат НовыйПараметрПеревозки.Ссылка;
	
КонецФункции