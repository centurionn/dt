
Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	    
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("ОбъектСДублемВСправочниках") 
		И ЕстьНастройкиКонтрагента(ЭтотОбъект) Тогда
		УдалитьДублиВСвязанныхСправочниках(ЭтотОбъект);
    КонецЕсли; 
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры             

// Рыбьяков К.А, Ticket#83729, 07-05-2024 начало
Процедура УдалитьДублиВСвязанныхСправочниках(ОбъектДляЗаписи)
	
	СвязанныеСправочники = Новый Массив;
	
	Если Не ОбъектДляЗаписи.СвязанныйСправочник1 = Неопределено Тогда
    	СвязанныеСправочники.Добавить(ОбъектДляЗаписи.СвязанныйСправочник1);
	КонецЕсли; 
	Если Не ОбъектДляЗаписи.СвязанныйСправочник2 = Неопределено Тогда
    	СвязанныеСправочники.Добавить(ОбъектДляЗаписи.СвязанныйСправочник2);
	КонецЕсли;
	Если Не ОбъектДляЗаписи.СвязанныйСправочник3 = Неопределено Тогда
    	СвязанныеСправочники.Добавить(ОбъектДляЗаписи.СвязанныйСправочник3);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Диадок_ЮрФизЛица.Ссылка КАК Ссылка
	|ИЗ
	|	РегистрСведений.Диадок_НастройкиКонтрагентов КАК Диадок_НастройкиКонтрагентов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Диадок_ЮрФизЛица КАК Диадок_ЮрФизЛица
	|		ПО Диадок_НастройкиКонтрагентов.Контрагент = Диадок_ЮрФизЛица.Ссылка
	|			И (Диадок_НастройкиКонтрагентов.Значение = ""IsMyCounteragent"")
	|ГДЕ
	|	(Диадок_ЮрФизЛица.СвязанныйСправочник1 В (&СвязанныеСправочники)
	|			ИЛИ Диадок_ЮрФизЛица.СвязанныйСправочник2 В (&СвязанныеСправочники)
	|			ИЛИ Диадок_ЮрФизЛица.СвязанныйСправочник3 В (&СвязанныеСправочники))
	|	И НЕ Диадок_ЮрФизЛица.Ссылка = &Ссылка	
	|   &КлиентИлиПоставщик";
	
	Если Клиент И Не Поставщик Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&КлиентИлиПоставщик", "И Диадок_ЮрФизЛица.Клиент = Истина");
	КонецЕсли;
	
	Если Поставщик И Не Клиент Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&КлиентИлиПоставщик", "И Диадок_ЮрФизЛица.Поставщик = Истина");
	КонецЕсли;
	
	Если Клиент И Поставщик Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&КлиентИлиПоставщик", "И (Диадок_ЮрФизЛица.Клиент = Истина ИЛИ Диадок_ЮрФизЛица.Поставщик = Истина)");
	ИначеЕсли Не Клиент И Не Поставщик Тогда	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&КлиентИлиПоставщик", "И (Диадок_ЮрФизЛица.Клиент = Ложь И Диадок_ЮрФизЛица.Поставщик = Ложь)");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("СвязанныеСправочники", СвязанныеСправочники);
	Запрос.УстановитьПараметр("Ссылка", ОбъектДляЗаписи.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		ВыборкаДетальнойЗаписи = РезультатЗапроса.Выбрать();
				
		Пока ВыборкаДетальнойЗаписи.Следующий() Цикл
			
			ОбъектСправочника = ВыборкаДетальнойЗаписи.Ссылка.ПолучитьОбъект();
			НомераСвязи = "";
			
			Для Каждого Справочник Из СвязанныеСправочники Цикл			
				
				Если ОбъектСправочника.СвязанныйСправочник1 = Справочник Тогда
					ОбъектСправочника.СвязанныйСправочник1 = Неопределено;
					НомераСвязи = НомераСвязи + "1, ";
				КонецЕсли;
				Если ОбъектСправочника.СвязанныйСправочник2 = Справочник Тогда
					ОбъектСправочника.СвязанныйСправочник2 = Неопределено;
					НомераСвязи = НомераСвязи + "2, ";
				КонецЕсли;
				Если ОбъектСправочника.СвязанныйСправочник3 = Справочник Тогда
					ОбъектСправочника.СвязанныйСправочник3 = Неопределено;
					НомераСвязи = НомераСвязи + "3, ";
				КонецЕсли;
								
			КонецЦикла;	
			
			ОбъектСправочника.ДополнительныеСвойства.Вставить("ОбъектСДублемВСправочниках", Истина);
			ОбъектСправочника.Записать();
						
			ОбщегоНазначения.СообщитьПользователю("В элементе справочника " + ОбъектСправочника.Наименование + 
				" была удалена связь по связанному справочнику: " + НомераСвязи + 
				"идентификатор участника ЭДО: " + ОбъектСправочника.ИдентификаторУчастникаЭДО);			
		КонецЦикла;
			
	КонецЕсли;
	
КонецПроцедуры

Функция ЕстьНастройкиКонтрагента(Контрагент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Диадок_ЮрФизЛица.Ссылка КАК Ссылка
	|ИЗ
	|	РегистрСведений.Диадок_НастройкиКонтрагентов КАК Диадок_НастройкиКонтрагентов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Диадок_ЮрФизЛица КАК Диадок_ЮрФизЛица
	|		ПО Диадок_НастройкиКонтрагентов.Контрагент = Диадок_ЮрФизЛица.Ссылка
	|			И (Диадок_НастройкиКонтрагентов.Значение = ""IsMyCounteragent"")
	|ГДЕ
	|	Диадок_ЮрФизЛица.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Контрагент.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = Ложь;
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Результат = Истина;	

	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
