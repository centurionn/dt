
Процедура ПередЗаписью(Отказ)
	
	Если ТипЗнч(ВладелецФайла) = Тип("ДокументСсылка.Операция") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ Первые 1
		               |	ОперативныеЗадачи.Исполнитель КАК Исполнитель,
		               |	ОперативныеЗадачи.Задача КАК Задача,
		               |	ОперативныеЗадачи.Документ КАК Документ,
		               |	ОперативныеЗадачи.Наблюдатель КАК Наблюдатель,
		               |	ОперативныеЗадачи.ВидДокумента КАК ВидДокумента,
		               |	ОперативныеЗадачи.Вагон КАК Вагон,
		               |	ОперативныеЗадачи.Контейнер КАК Контейнер,
		               |	ОперативныеЗадачи.ДокументОснование КАК ДокументОснование,
		               |	ОперативныеЗадачи.НачалоЖелтыйПорог КАК НачалоЖелтыйПорог,
		               |	ОперативныеЗадачи.ОкончаниеЖелтыйПорог КАК ОкончаниеЖелтыйПорог,
		               |	ОперативныеЗадачи.НачалоКрасныйПорог КАК НачалоКрасныйПорог,
		               |	ОперативныеЗадачи.ОкончаниеКрасныйПорог КАК ОкончаниеКрасныйПорог,
		               |	ОперативныеЗадачи.Статус КАК Статус,
		               |	ОперативныеЗадачи.ТипОбъектаСистемы КАК ТипОбъектаСистемы,
		               |	ОперативныеЗадачи.ОперацияПричина КАК ОперацияПричина
		               |ИЗ
		               |	РегистрСведений.ОперативныеЗадачи КАК ОперативныеЗадачи
		               |ГДЕ
		               |	ОперативныеЗадачи.ДокументОснование = &ДокументОснование
		               |	И ОперативныеЗадачи.ВидДокумента = &ВидДокумента
		               |	И ОперативныеЗадачи.ОбластьПрименения = &ОбластьПрименения
		               |	И НЕ ОперативныеЗадачи.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЭтапов.Выполнен)";
		Запрос.УстановитьПараметр("ДокументОснование",ВладелецФайла);
		Запрос.УстановитьПараметр("ВидДокумента",ВидДокумента);
		Запрос.УстановитьПараметр("ОбластьПрименения",Перечисления.ОбластьПрименения.Документы);
		Ответ = Запрос.Выполнить().Выбрать();
		Пока Ответ.Следующий() Цикл
			МЗ = РегистрыСведений.ОперативныеЗадачи.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(МЗ, Ответ);
			МЗ.Прочитать();
			МЗ.Статус = Перечисления.СтатусыЭтапов.Выполнен;
			МЗ.ДатаВыполнения = ТекущаяДата();
			МЗ.Записать();
		КонецЦикла;
		
	КонецЕсли;
	//Евросиб Шевченко А.В. US 110215 TA 122847 10.11.2025
	Если ТипЗнч(ВладелецФайла) = Тип("ДокументСсылка.ПСЦПоставщика") Тогда
		Если ПометкаУдаления Тогда
			ЭтоСканКопия = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	//Евросиб Шевченко А.В. US 110215 TA 122847 10.11.2025
КонецПроцедуры

