Функция ПолучитьМассивЛокаций( Мультилокация ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МультилокацииЛокации.Локация КАК Локация
		|ИЗ
		|	Справочник.Мультилокации.Локации КАК МультилокацииЛокации
		|ГДЕ
		|	МультилокацииЛокации.Ссылка = &Мультилокация
		|	И МультилокацииЛокации.Локация <> ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("Мультилокация", Мультилокация);
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Локация");
