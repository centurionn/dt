
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПараметрыВыбораЛокаций = Новый Массив;
	
	МассивТиповЛокаций = Новый Массив;
	Если Параметры.Свойство("ТипыЛокаций") Тогда
		Если ЗначениеЗаполнено(Параметры.ТипыЛокаций) Тогда
			МассивТиповЛокаций = Параметры.ТипыЛокаций;
			ПараметрыВыбораЛокаций.Добавить(Новый ПараметрВыбора("Отбор.Тип", Новый ФиксированныйМассив(МассивТиповЛокаций)));
		КонецЕсли;	
	ИначеЕсли Параметры.Свойство("Отбор") Тогда
		
		Если Параметры.Отбор.Свойство("Тип") Тогда
			Если ТипЗнч(Параметры.Отбор.Тип) = Тип("ФиксированныйМассив") Тогда
				ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивТиповЛокаций, Параметры.Отбор.Тип);
			Иначе
				МассивТиповЛокаций.Добавить(Параметры.Отбор.Тип);
			КонецЕсли;
		КонецЕсли;		
		
		Для Каждого ЭлементОтбора Из Параметры.Отбор Цикл
			ИмяПараметра = СтрШаблон("Отбор.%1", ЭлементОтбора.Ключ);
			ПараметрыВыбораЛокаций.Добавить(Новый ПараметрВыбора(ИмяПараметра, ЭлементОтбора.Значение));			
		КонецЦикла;
		
	КонецЕсли;

	СписокТиповЛокаций.ЗагрузитьЗначения(МассивТиповЛокаций); 
	
	Погранпереход = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "Погранпереход", Неопределено);
	Если Погранпереход <> Неопределено Тогда
		ПараметрыВыбораЛокаций.Добавить(Новый ПараметрВыбора("Отбор.Погранпереход", Погранпереход));
	КонецЕсли;
	
	ПараметрЛокации = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "Локации", Неопределено);
	Если ЗначениеЗаполнено(ПараметрЛокации) Тогда
		ПараметрыВыбораЛокаций.Добавить(Новый ПараметрВыбора("Отбор.Ссылка", Новый ФиксированныйМассив(ПараметрЛокации)));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыВыбораЛокаций) Тогда
		Элементы.ЛокацииЗначение.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораЛокаций);
		Элементы.ЛокацииВыбраннойМультилокацииЗначение.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораЛокаций);
	КонецЕсли;
	
	ЗаполнитьТаблицуМультилокаций();
	
КонецПроцедуры

//ДИТ, Беляев СЮ, US 83045 / TA 85275, 16-05-2024, начало
&НаСервереБезКонтекста
Функция МультилокацииВыбранныхЛокаций( СписокЛокаций, МассивТиповЛокаций )
	Возврат Справочники.Мультилокации.ПолучитьМассивМультилокацийСодержащиеЛокации( СписокЛокаций, МассивТиповЛокаций );
КонецФункции
