&НаСервере
Процедура ЗаполнитьТаблицуМультилокаций() 
	
	ПараметрыОтбораЛокаций = Новый Структура;
	Для Каждого ПараметрВыбора Из Элементы.ЛокацииЗначение.ПараметрыВыбора Цикл
		ИмяПараметра = СтрЗаменить(ПараметрВыбора.Имя, "Отбор.", "");
		ПараметрыОтбораЛокаций.Вставить(ИмяПараметра, ПараметрВыбора.Значение);
	КонецЦикла;
	
	ТаблицаМультилокаций = Справочники.Мультилокации.ПолучитьМультилокацииПоПараметрам(Локации.ВыгрузитьЗначения(), ПараметрыОтбораЛокаций, Истина);
	ПодобранныеМультилокацииТЧ.Загрузить(ТаблицаМультилокаций);
	
КонецПроцедуры


&НаКлиенте
Процедура ЛокацииПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	//Евросиб Каблов 01.11.2024 ( #67092
	ИдентификаторТекСтроки = Элементы.Локации.ТекущаяСтрока;
	ТекДанные = Локации.НайтиПоИдентификатору(ИдентификаторТекСтроки);
	Если ТекДанные <> Неопределено Тогда
		Если Не ЗначениеЗаполнено(ТекДанные.Значение) Тогда
			Локации.Удалить(ТекДанные);
		Иначе
			Для Каждого Стр Из Локации Цикл
				Если Стр.Значение = ТекДанные.Значение И Стр.ПолучитьИдентификатор() <> ИдентификаторТекСтроки Тогда
					Локации.Удалить(ТекДанные);
					Элементы.Локации.ТекущаяСтрока = Стр.ПолучитьИдентификатор();
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	//Евросиб Каблов 01.11.2024 )
	
КонецПроцедуры

