&НаСервереБезКонтекста
Функция ЛокацииВыбраннойМультилокации( Мультилокация )
	Возврат Справочники.Мультилокации.ПолучитьМассивЛокаций( Мультилокация );
КонецФункции

&НаКлиенте
Процедура ЛокацииЗначениеПриИзменении(Элемент)
	
	//Евросиб Каблов 01.11.2024 ( #67092	
	ИдентификаторТекСтроки = Элементы.Локации.ТекущаяСтрока;	
	Если ИдентификаторТекСтроки <> Неопределено Тогда
		ТекДанные = Локации.НайтиПоИдентификатору(ИдентификаторТекСтроки);
		Если Не ЗначениеЗаполнено(ТекДанные.Значение) Тогда
			Локации.Удалить(ТекДанные);
		Иначе
			Для Каждого Стр Из Локации Цикл
				Если Стр.Значение = ТекДанные.Значение И Стр.ПолучитьИдентификатор() <> ИдентификаторТекСтроки Тогда
					Локации.Удалить(ТекДанные);
					Элементы.Локации.ТекущаяСтрока = Стр.ПолучитьИдентификатор();
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьТаблицуМультилокаций();
	//Евросиб Каблов 01.11.2024 )
	
	//Евросиб(ДИТ), Беляев СЮ, US 83045/TA 86738, 18-06-2024, начало
	ПодобранныеМультилокацииПриАктивизацииСтроки("");
	//Евросиб(ДИТ), Беляев СЮ, US 83045/TA 86738, 18-06-2024, конец
КонецПроцедуры

&НаКлиенте
Процедура ПодобранныеМультилокацииПриАктивизацииСтроки(Элемент)
	//ДИТ, Беляев СЮ, US 83045 / TA 85275, 16-05-2024, начало
	ТекД = Элементы.ПодобранныеМультилокацииТЧ.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		//Евросиб(ДИТ), Беляев СЮ, US 83045/TA 86738, 18-06-2024, начало
		ТекущаяМультилокация = Неопределено;
		ЛокацииВыбраннойМультилокации.Очистить();
		//Евросиб(ДИТ), Беляев СЮ, US 83045/TA 86738, 18-06-2024, конец
		Возврат;
	КонецЕсли; 
	ТекущаяМультилокация = ТекД.Мультилокация;
	МассивЛокаций = ЛокацииВыбраннойМультилокации(ТекД.Мультилокация);
	ЛокацииВыбраннойМультилокации.Очистить();
	ЛокацииВыбраннойМультилокации.ЗагрузитьЗначения(МассивЛокаций);
	//ДИТ, Беляев СЮ, US 83045 / TA 85275, 16-05-2024, конец   
	
	// Евросиб(ДИТ) US 83045 ТА 85915 Сержантова А.С. Начало: 10.06.2024
	//ДобавлениеЛокацийНеДоступно = ПроверитьДоступностьДобавленияЛокаций(ТекД.Значение);
	//Если ДобавлениеЛокацийНеДоступно Тогда
	//	Элементы.ЛокацииВыбраннойМультилокацииДобавить.Доступность = Ложь;
	//	Элементы.ЛокацииВыбраннойМультилокацииКонтекстноеМенюДобавить.Доступность = Ложь;
	//Иначе	
	//    Элементы.ЛокацииВыбраннойМультилокацииДобавить.Доступность = Истина;
	//	Элементы.ЛокацииВыбраннойМультилокацииКонтекстноеМенюДобавить.Доступность = Истина;
	//КонецЕсли;
	// Евросиб(ДИТ) US 83045 ТА 85915 Сержантова А.С. Конец: 10.06.2024
	//Евросиб(ДИТ), Беляев СЮ, US 83045/TA 86738, 18-06-2024, начало
	ДобавлениеЛокацийДоступно = ПроверитьДоступностьДобавленияЛокаций(ТекД.Мультилокация);
	Элементы.ЛокацииВыбраннойМультилокацииДобавить.Доступность = ДобавлениеЛокацийДоступно;
	Элементы.ЛокацииВыбраннойМультилокацииКонтекстноеМенюДобавить.Доступность = ДобавлениеЛокацийДоступно;
	Элементы.ЛокацииВыбраннойМультилокацииУдалить.Доступность = ДобавлениеЛокацийДоступно;
	Элементы.ЛокацииВыбраннойМультилокацииКонтекстноеМенюУдалить.Доступность = ДобавлениеЛокацийДоступно;
	//Евросиб(ДИТ), Беляев СЮ, US 83045/TA 86738, 18-06-2024, конец
КонецПроцедуры   

// Евросиб(ДИТ) US 83045 ТА 85915 Сержантова А.С. 10.06.2024 
&НаСервереБезКонтекста
Функция ПроверитьДоступностьДобавленияЛокаций(СсылкаМультилокации)
	Возврат НЕ Справочники.Мультилокации.ЕстьДокументыПоМультилокации(СсылкаМультилокации)	
КонецФункции 

//ДИТ, Беляев СЮ, US 83045 / TA 85275, 16-05-2024, начало
&НаСервереБезКонтекста
Функция СохранитьМультилокациюНаСервере(Мультилокация = Неопределено, ЛокацииВыбраннойМультилокации) 
	// Евросиб(ДИТ) US 83045 ТА 85915 Сержантова А.С. Начало: 03.06.2024
	Если Мультилокация = Неопределено Тогда
		МультилокацияОбъект = Справочники.Мультилокации.СоздатьЭлемент();
	Иначе
		МультилокацияОбъект = Мультилокация.ПолучитьОбъект();
	КонецЕсли;
	// Евросиб(ДИТ) US 83045 ТА 85915 Сержантова А.С. Конец: 03.06.2024
	МультилокацияОбъект.Локации.Очистить();
	Для Каждого ТекЛокация Из ЛокацииВыбраннойМультилокации Цикл
		СтрокаЛокаций = МультилокацияОбъект.Локации.Добавить();
		СтрокаЛокаций.Локация = ТекЛокация.Значение;
	КонецЦикла;   
	МультилокацияОбъект.Записать();   
	
	// Евросиб(ДИТ) US 83045 ТА 85915 Сержантова А.С. Начало: 03.06.2024
	Если ЗначениеЗаполнено(МультилокацияОбъект.Ссылка) Тогда
		Возврат МультилокацияОбъект.Ссылка;
	КонецЕсли;
	// Евросиб(ДИТ) US 83045 ТА 85915 Сержантова А.С. Конец: 03.06.2024
	
КонецФункции
//ДИТ, Беляев СЮ, US 83045 / TA 85275, 16-05-2024, конец

//ДИТ, Беляев СЮ, US 83045 / TA 85275, 16-05-2024, начало
&НаКлиенте
Процедура Сохранить(Команда)
	ТекД = Элементы.ПодобранныеМультилокацииТЧ.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;   
	//Евросиб(ДИТ), Беляев СЮ, US 83045/TA 86738, 11-06-2024, начало
	МассивЛокаций = ЛокацииВыбраннойМультилокации.ВыгрузитьЗначения();
	АналогичнаяМультилокацияСтрукура = ПолучитьМультилокациюСАналогичнымНаборомЛокацийНаСервере(ТекД.Мультилокация, МассивЛокаций);
	Если ЗначениеЗаполнено(АналогичнаяМультилокацияСтрукура.АналогичнаяМультилокация) Тогда
		ДопПараметры = Новый Структура(); 
		ДопПараметры.Вставить("АналогичнаяМультилокация", АналогичнаяМультилокацияСтрукура.АналогичнаяМультилокация);
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаИспользоватьАналогичную", ЭтотОбъект, ДопПараметры);
		ПоказатьВопрос(Оповещение, "Мультилокация с данным набором локаций уже существует <"+АналогичнаяМультилокацияСтрукура.Представление+">. Использовать существующую мультилокацию?", РежимДиалогаВопрос.ДаНет, 0);
		Возврат;
	КонецЕсли;
	//Евросиб(ДИТ), Беляев СЮ, US 83045/TA 86738, 11-06-2024, конец

	СохранитьМультилокациюНаСервере(ТекД.Мультилокация, ЛокацииВыбраннойМультилокации); 
	// Евросиб(ДИТ) US 83045 ТА 85915 Сержантова А.С. Начало: 03.06.2024
	ОповеститьОбИзменении(Тип("СправочникСсылка.Мультилокации"));   
	Элементы.ПодобранныеМультилокацииТЧ.Обновить();
	// Евросиб(ДИТ) US 83045 ТА 85915 Сержантова А.С. Конец: 03.06.2024
КонецПроцедуры
//ДИТ, Беляев СЮ, US 83045 / TA 85275, 16-05-2024, конец

//Евросиб(ДИТ), Беляев СЮ, US 83045/TA 86738, 11-06-2024, начало
&НаСервереБезКонтекста
Функция ПолучитьМультилокациюСАналогичнымНаборомЛокацийНаСервере(Ссылка, МассивЛокаций)
	СтруктураРезультат = Новый Структура("АналогичнаяМультилокация, Представление");
	КлючНабораЛокаций = Справочники.Мультилокации.ПолучитьКлючНабораЛокаций(МассивЛокаций);
	АналогичнаяМультилокация = Справочники.Мультилокации.ПолучитьМультилокациюСАналогичнымНаборомЛокаций(Ссылка, КлючНабораЛокаций);
	СтруктураРезультат.АналогичнаяМультилокация = АналогичнаяМультилокация;
	Если АналогичнаяМультилокация <> Справочники.Мультилокации.ПустаяСсылка() Тогда
		РеквизитыМультилокации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(АналогичнаяМультилокация, "Код, Наименование");
		СтруктураРезультат.Представление = СтрШаблон("%1 (код %2)", РеквизитыМультилокации.Наименование, РеквизитыМультилокации.Код);
	КонецЕсли;
	Возврат СтруктураРезультат;
КонецФункции
//Евросиб(ДИТ), Беляев СЮ, US 83045/TA 86738, 11-06-2024, конец

//Евросиб(ДИТ), Беляев СЮ, US 83045/TA 86738, 11-06-2024, начало
&НаКлиенте
Процедура ПослеЗакрытияВопросаИспользоватьАналогичную(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	ТекущаяМультилокация = Параметры.АналогичнаяМультилокация;
	Выбрать(Неопределено);
КонецПроцедуры
//Евросиб(ДИТ), Беляев СЮ, US 83045/TA 86738, 11-06-2024, конец

&НаКлиенте
Процедура ПодобранныеМультилокацииЗначениеНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	//ДИТ, Беляев СЮ, US 83045 / TA 85275, 16-05-2024, начало
	СтандартнаяОбработка = Ложь;
	ОткрытьФорму("Справочник.Мультилокации.Форма.ФормаВыбора", , Элемент,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ПодобранныеМультилокацииПриАктивизацииСтроки("");
	//ДИТ, Беляев СЮ, US 83045 / TA 85275, 16-05-2024, конец
КонецПроцедуры

&НаКлиенте
Процедура ПодобранныеМультилокацииЗначениеПриИзменении(Элемент)
	//ДИТ, Беляев СЮ, US 83045 / TA 85275, 16-05-2024, начало
	ПодобранныеМультилокацииПриАктивизацииСтроки("");
	//ДИТ, Беляев СЮ, US 83045 / TA 85275, 16-05-2024, конец
КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда)
	УстановитьОбъектФормы();
	ОповеститьОВыборе(ТекущаяМультилокация);
КонецПроцедуры

&НаСервере
Процедура УстановитьОбъектФормы()
	ЗначениеВДанныеФормы(ТекущаяМультилокация.ПолучитьОбъект(), МультилокацияОбъект);
КонецПроцедуры

