// Евросиб(ДИТ) US 83045 ТА 85915 Сержантова А.С. 10.06.2024
&НаКлиенте
Процедура Создать(Команда)
	ПараметрыФормы = Новый Структура;       
	ПараметрыФормы.Вставить("ЗаполнитьНаБазе", Локации.ВыгрузитьЗначения());
	//Евросиб(ДИТ), Беляев СЮ, US 83045/TA 87282, 24-06-2024, начало
	ПараметрыФормы.Вставить("МассивТиповЛокаций", СписокТиповЛокаций.ВыгрузитьЗначения());
	//Евросиб(ДИТ), Беляев СЮ, US 83045/TA 87282, 24-06-2024, конец
	ОповещениеОЗаписиНового = Новый ОписаниеОповещения("ПослеЗаписиНовогоЭлемента", ЭтаФорма);
	ОткрытьФорму("Справочник.Мультилокации.Форма.ФормаЭлемента", ПараметрыФормы,ЭтаФорма,,,,ОповещениеОЗаписиНового);
КонецПроцедуры  

// Евросиб(ДИТ) US 83045 ТА 85915 Сержантова А.С. 10.06.2024
&НаКлиенте 
Процедура ПослеЗаписиНовогоЭлемента(Результат, ДопПараметры) Экспорт
	//Евросиб(ДИТ), Беляев СЮ, US 83045/TA 86738, 18-06-2024, начало
	Если Результат <> Неопределено Тогда
		Если ТипЗнч(Результат) = Тип("Структура") Тогда
			Если Результат.Свойство("АналогичнаяМультилокация") Тогда
				ТекущаяМультилокация = Результат.АналогичнаяМультилокация;
				Выбрать(Неопределено);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//Евросиб(ДИТ), Беляев СЮ, US 83045/TA 86738, 18-06-2024, конец
	Элементы.ПодобранныеМультилокацииТЧ.Обновить();
КонецПроцедуры

