
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Владелец") Тогда
		Владелец = Параметры.Владелец;
	КонецЕсли;
	
	Если Параметры.Свойство("ЗаполнитьНаБазе") Тогда    
		// Евросиб(ДИТ) US 83045 ТА 85915 Сержантова А.С. Начало: 07.06.2024
		// Было:
		//Объект.Локации.Загрузить(Параметры.ЗаполнитьНаБазе.Локации.Выгрузить()); 
		//Стало:
		Для каждого Локация Из Параметры.ЗаполнитьНаБазе Цикл
			НС = Объект.Локации.Добавить();	
			НС.Локация = Локация;			
		КонецЦикла;
		// Евросиб(ДИТ) US 83045 ТА 85915 Сержантова А.С. Конец: 07.06.2024
	КонецЕсли;
	
	// Евросиб Фролов (16.02.2022 Task №46605
	РодительЛокации = Параметры.РодительЛокации;
	ТипЛокации = Параметры.ТипЛокации;
	Если РодительЛокации.Количество() > 0
		Или ТипЛокации.Количество() > 0 Тогда
		Элементы.ЛокацииЛокация.ИсторияВыбораПриВводе = ИсторияВыбораПриВводе.НеИспользовать;
	КонецЕсли;	
	// Евросиб Фролов)
	
	//Евросиб(ДИТ), Беляев СЮ, US 83045/TA 87282, 24-06-2024, начало
	Если Параметры.Свойство("МассивТиповЛокаций") И Параметры.МассивТиповЛокаций.Количество() > 0 Тогда
		МассивТиповЛокаций = Параметры.МассивТиповЛокаций;
		
		МассивПараметровВыбора = Новый Массив;
		МассивПараметровВыбора.Добавить(Новый ПараметрВыбора("Отбор.Тип", Новый ФиксированныйМассив(МассивТиповЛокаций)));
		
		Элементы.ЛокацииЛокация.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);
	//Евросиб Каблов 11.12.2024 ( #89872
	ИначеЕсли Параметры.Свойство("ПараметрыВыбораЛокаций") Тогда
		Элементы.ЛокацииЛокация.ПараметрыВыбора = Новый ФиксированныйМассив(Параметры.ПараметрыВыбораЛокаций);
	ИначеЕсли Параметры.Свойство("ПараметрыВыбора") И ЗначениеЗаполнено(Параметры.ПараметрыВыбора) Тогда
		МассивПараметровВыбора = Новый Массив;
		Для Каждого ПараметрВыбора Из Параметры.ПараметрыВыбора Цикл			
			МассивПараметровВыбора.Добавить(Новый ПараметрВыбора("Отбор." + ПараметрВыбора.Ключ, ПараметрВыбора.Значение));
		КонецЦикла;
		Элементы.ЛокацииЛокация.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);
	//Евросиб Каблов 11.12.2024 )		
	КонецЕсли;
	//Евросиб(ДИТ), Беляев СЮ, US 83045/TA 87282, 24-06-2024, конец
	
	//Евросиб Коханенко Н.А. #61705 08.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 08.12.2022 )

КонецПроцедуры

