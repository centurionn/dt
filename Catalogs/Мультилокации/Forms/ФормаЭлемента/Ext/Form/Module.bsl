&НаКлиенте
Функция ФормаЭлементаОткрыта_из_ФормаРедактированияИВыбора()
	Результат = Ложь;
	Если Тип(Этаформа.ВладелецФормы) = Тип("ФормаКлиентскогоПриложения") Тогда
		Если Этаформа.ВладелецФормы.ИмяФормы = "Справочник.Мультилокации.Форма.ФормаРедактированияИВыбора" Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции
//Евросиб(ДИТ), Беляев СЮ, US 83045/TA 87282, 24-06-2024, конец

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	//Евросиб(ДИТ), Беляев СЮ, US 83045/TA 86738, 18-06-2024, начало
	Если Этаформа.ВладелецФормы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ФормаЭлементаОткрыта_из_ФормаРедактированияИВыбора() Тогда
		МассивЛокаций = Новый Массив;
		Для Каждого ТекСтрока Из Объект.Локации  Цикл
			МассивЛокаций.Добавить(ТекСтрока.Локация);
		КонецЦикла;
		АналогичнаяМультилокацияСтрукура = ПолучитьМультилокациюСАналогичнымНаборомЛокацийНаСервере(Объект.Ссылка, МассивЛокаций);
		Если ЗначениеЗаполнено(АналогичнаяМультилокацияСтрукура.АналогичнаяМультилокация) Тогда
			ДопПараметры = Новый Структура(); 
			ДопПараметры.Вставить("АналогичнаяМультилокация", АналогичнаяМультилокацияСтрукура.АналогичнаяМультилокация);
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаИспользоватьАналогичную", ЭтотОбъект, ДопПараметры);
			ПоказатьВопрос(Оповещение, "Мультилокация с данным набором локаций уже существует <"+АналогичнаяМультилокацияСтрукура.Представление+">. Использовать существующую мультилокацию?", РежимДиалогаВопрос.ДаНет, 0);
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	//Евросиб(ДИТ), Беляев СЮ, US 83045/TA 86738, 18-06-2024, конец
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьМультилокациюСАналогичнымНаборомЛокацийНаСервере(Ссылка, МассивЛокаций)
	СтруктураРезультат = Новый Структура("АналогичнаяМультилокация, Представление");
	КлючНабораЛокаций = Справочники.Мультилокации.ПолучитьКлючНабораЛокаций(МассивЛокаций);
	АналогичнаяМультилокация = Справочники.Мультилокации.ПолучитьМультилокациюСАналогичнымНаборомЛокаций(Ссылка, КлючНабораЛокаций);
	СтруктураРезультат.АналогичнаяМультилокация = АналогичнаяМультилокация;
	Если АналогичнаяМультилокация <> Справочники.Мультилокации.ПустаяСсылка() Тогда
		РеквизитыМультилокации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(АналогичнаяМультилокация, "Код, Наименование");
		СтруктураРезультат.Представление = СтрШаблон("%1 (код %2)", РеквизитыМультилокации.Наименование, РеквизитыМультилокации.Код);
	КонецЕсли;
	Возврат СтруктураРезультат;
КонецФункции

&НаКлиенте
Процедура ПослеЗакрытияВопросаИспользоватьАналогичную(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ЭтотОбъект.Модифицированность = Ложь;
	
	ПараметрЗакрытия = Новый Структура;
	ПараметрЗакрытия.Вставить("АналогичнаяМультилокация",Параметры.АналогичнаяМультилокация);
	Закрыть(ПараметрЗакрытия);	
КонецПроцедуры
