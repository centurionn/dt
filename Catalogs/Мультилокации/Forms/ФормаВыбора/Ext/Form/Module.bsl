#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Евросиб Фролов (16.02.2022 Task №46605
	
	// Список типов локаций содержит список только разрешенных типов локаций.
	// Добавлено для того, чтобы организовать выбор только тех мультилокаций, 
	// в составе которых присутствуют только указанные типы локаций и отсутствуют какие-л. другие.
    СписокТиповЛокаций = Параметры.СписокТиповЛокаций;
	
	// Мультилокация родителя используется для отбора в списке только тех мультилокаций,
	// в составе которых есть только локации подчиненные локациям мультилокации родителя.
	МультилокацияРодителей = Параметры.МультилокацияРодителей;
	
	Если СписокТиповЛокаций.Количество() > 0
		ИЛИ ЗначениеЗаполнено(МультилокацияРодителей) Тогда
		ЗаполнитьТекстЗапросаДинамическогоСписка();
		Список.Параметры.УстановитьЗначениеПараметра("СписокТипов", СписокТиповЛокаций);
		Если ЗначениеЗаполнено(МультилокацияРодителей) Тогда
			Список.Параметры.УстановитьЗначениеПараметра("МультилокацияРодителей", МультилокацияРодителей);
		КонецЕсли;	
	КонецЕсли;		
	// Евросиб Фролов)
	
	//Евросиб Коханенко Н.А. #61705 08.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 08.12.2022 ) 
 	//Евросиб - АСуслов 04.07.2023 17:55:01 #67501 локации
	//(
	РаботаСФормамиСервер.УстановитьОграничениеНаВыборПомеченныхНаУдалениеЭлементов(Список);
	//)
	//Евросиб - АСуслов 04.07.2023 17:55:09 #67501 локации
	

КонецПроцедуры

//Евросиб Коханенко Н.А. #61705 08.12.2022 (
