&НаКлиенте
Процедура ЛокацииЗначениеПриИзменении(Элемент)
	Если Локации.Количество() = 0 Тогда    
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Список, "Ссылка");
	Иначе                 
		МассивМультилокаций = МультилокацииВыбранныхЛокаций(Локации);
        ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Ссылка", 
										МассивМультилокаций, ВидСравненияКомпоновкиДанных.ВСписке,,Истина);
	КонецЕсли;   
	СписокПриАктивизацииСтроки(Неопределено);
КонецПроцедуры      

&НаСервереБезКонтекста
Функция МультилокацииВыбранныхЛокаций( СписокЛокаций )
	Возврат Справочники.Мультилокации.ПолучитьМассивМультилокацийСодержащиеЛокации( СписокЛокаций );
КонецФункции

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	ТекД = Элементы.Список.ТекущиеДанные;
	Если ТекД = Неопределено Тогда  
		ЛокацииВыбраннойМультилокации.Очистить();
		Возврат;
	КонецЕсли;
	ТекущаяМультилокация = ТекД.Ссылка;
	МассивЛокаций = ЛокацииВыбраннойМультилокации(ТекущаяМультилокация);
	ЛокацииВыбраннойМультилокации.Очистить();
	ЛокацииВыбраннойМультилокации.ЗагрузитьЗначения(МассивЛокаций);
	
	//ДобавлениеЛокацийНеДоступно = ПроверитьДоступностьДобавленияЛокаций(ТекущаяМультилокация);
	//Если ДобавлениеЛокацийНеДоступно Тогда
	//	Элементы.ЛокацииВыбраннойМультилокацииДобавить.Доступность = Ложь;
	//	Элементы.ЛокацииВыбраннойМультилокацииКонтекстноеМенюДобавить.Доступность = Ложь;
	//Иначе	
	//    Элементы.ЛокацииВыбраннойМультилокацииДобавить.Доступность = Истина;
	//	Элементы.ЛокацииВыбраннойМультилокацииКонтекстноеМенюДобавить.Доступность = Истина;
	//КонецЕсли;
	
	//Евросиб(ДИТ), Беляев СЮ, US 83045/TA 86738, 18-06-2024, начало
	ДобавлениеЛокацийДоступно = ПроверитьДоступностьДобавленияЛокаций(ТекущаяМультилокация);
	ДобавлениеЛокацийДоступно = ДобавлениеЛокацийДоступно И НЕ ТекД.ПометкаУдаления;
	Элементы.ЛокацииВыбраннойМультилокацииДобавить.Доступность = ДобавлениеЛокацийДоступно;
	Элементы.ЛокацииВыбраннойМультилокацииКонтекстноеМенюДобавить.Доступность = ДобавлениеЛокацийДоступно;
	//Евросиб(ДИТ), Беляев СЮ, US 83045/TA 86738, 18-06-2024, конец

КонецПроцедуры  

&НаСервереБезКонтекста
Функция ПроверитьДоступностьДобавленияЛокаций(ТекущаяМультилокация)
	Возврат НЕ Справочники.Мультилокации.ЕстьДокументыПоМультилокации(ТекущаяМультилокация)	
КонецФункции

&НаСервереБезКонтекста
Функция ЛокацииВыбраннойМультилокации(Мультилокация)
	Возврат Справочники.Мультилокации.ПолучитьМассивЛокаций(Мультилокация);
КонецФункции

&НаКлиенте
Процедура ЛокацииПослеУдаления(Элемент)
	ЛокацииЗначениеПриИзменении(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура Создать(Команда)
	ПараметрыФормы = Новый Структура;       
	ПараметрыФормы.Вставить("ЗаполнитьНаБазе", Локации.ВыгрузитьЗначения()); 
	ОповещениеОЗаписиНового = Новый ОписаниеОповещения("ПослеЗаписиНовогоЭлемента", ЭтаФорма);
	ОткрытьФорму("Справочник.Мультилокации.Форма.ФормаЭлемента", ПараметрыФормы,,,,,ОповещениеОЗаписиНового);
КонецПроцедуры   

&НаКлиенте 
Процедура ПослеЗаписиНовогоЭлемента(Результат, ДопПараметры) Экспорт
	Элементы.Список.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	ТекД = Элементы.Список.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;   
	СохранитьМультилокациюНаСервере(ТекД.Ссылка, ЛокацииВыбраннойМультилокации); 
	Элементы.Список.Обновить();
КонецПроцедуры  

&НаСервереБезКонтекста
Функция СохранитьМультилокациюНаСервере(Мультилокация = Неопределено, ЛокацииВыбраннойМультилокации) 
	МультилокацияОбъект = Мультилокация.ПолучитьОбъект();
	МультилокацияОбъект.Локации.Очистить();
	Для Каждого ТекЛокация Из ЛокацииВыбраннойМультилокации Цикл
		СтрокаЛокаций = МультилокацияОбъект.Локации.Добавить();
		СтрокаЛокаций.Локация = ТекЛокация.Значение;
	КонецЦикла;   
	МультилокацияОбъект.Записать();   
КонецФункции

//Евросиб(ДИТ), Беляев СЮ, US 83045/TA 86738, 18-06-2024, начало
&НаКлиенте
Процедура ЛокацииВыбраннойМультилокацииПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если НЕ ДобавлениеЛокацийДоступно Тогда
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры
