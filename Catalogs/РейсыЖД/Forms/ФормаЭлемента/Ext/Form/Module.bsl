&НаКлиенте
Процедура ПроставитьТабельноеРасписание()
	
	РезТабельноеРасписание = Отправки_сервер.ПолучитьТабельноеРасписаниеПоПараметрам(Объект.ПунктОтправления, Объект.ПунктНазначения);
	
	Если ЗначениеЗаполнено(РезТабельноеРасписание.Расписание) Тогда
		Если НачалоДня(Объект.ДатаОтправления) = Объект.ДатаОтправления Тогда
			Объект.ДатаОтправления = Объект.ДатаОтправления + РезТабельноеРасписание.ДобавитьКНачалу;
		КонецЕсли;
		Объект.ДатаПрибытия = Объект.ДатаОтправления + РезТабельноеРасписание.ДобавитьКОкончанию;
		Объект.ДатаПрибытия = НачалоДня(Объект.ДатаПрибытия) + РезТабельноеРасписание.ТочноеВремяПрибытия;
		Объект.ТабельноеРасписание = РезТабельноеРасписание.Расписание;
	КонецЕсли;
	
КонецПроцедуры


