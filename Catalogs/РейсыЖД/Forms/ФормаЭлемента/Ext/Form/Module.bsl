&НаСервереБезКонтекста
Функция ПолучитьКлиентаИзРеестрПримечанийКЖДОтправкам(Отправка)

	Рез = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	РеестрПримечанийКЖДОтправкам.Отправка КАК Отправка,
	|	РеестрПримечанийКЖДОтправкам.Примечание КАК Примечание,
	|	РеестрПримечанийКЖДОтправкам.РаспознанныйКлиент КАК РаспознанныйКлиент
	|ИЗ
	|	РегистрСведений.РеестрПримечанийКЖДОтправкам КАК РеестрПримечанийКЖДОтправкам
	|ГДЕ
	|	РеестрПримечанийКЖДОтправкам.Отправка = &Отправка";
	
	Запрос.УстановитьПараметр("Отправка", Отправка);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Количество() > 1 Тогда
	
		
	
	Иначе
	
		Пока Выборка.Следующий() Цикл
			
			Рез = Выборка.РаспознанныйКлиент;
			
		КонецЦикла;
	
	КонецЕсли; 
	
	Возврат Рез;

КонецФункции // ПолучитьКлиентаИзРеестрПримечанийКЖДОтправкам()

