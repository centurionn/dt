	// Обновляем панель текущего пользователя и панель состояний
	ОбновитьПанельТекущегоПользователя();
	ОбновитьПанельСостояний();

	Клиент_ПримечаниеКОтправке = ПолучитьКлиентаИзРеестрПримечанийКЖДОтправкам(Объект.Ссылка);
	
	
	//Евросиб Коханенко Н.А. #61705 08.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 08.12.2022 )
	
	//Евросиб(ДИТ), Беляев СЮ, US 87368/TA 87370, 29-08-2024, начало
	ПользовательСПолнымиПравами = РольДоступна("ПолныеПрава");
	//Элементы.ЛотDX.Доступность = ПользовательСПолнымиПравами;
	//Элементы.КТК_DX.Доступность = ПользовательСПолнымиПравами;
	//Элементы.ПлановаяВыручка_DX.Доступность = ПользовательСПолнымиПравами;
	//Евросиб(ДИТ), Беляев СЮ, US 87368/TA 87370, 29-08-2024, начало
	Если НЕ ПользовательСПолнымиПравами Тогда
		Для Каждого ТекЭлемент Из Элементы Цикл
			Если ТипЗнч(ТекЭлемент) <> Тип("ПолеФормы") Тогда
				Продолжить;
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.Имя, "DX") > 0 Тогда
				ТекЭлемент.Доступность = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	//Евросиб(ДИТ), Беляев СЮ, US 87368/TA 87370, 29-08-2024, конец

КонецПроцедуры

