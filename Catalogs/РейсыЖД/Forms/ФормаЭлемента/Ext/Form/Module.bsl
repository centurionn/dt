&НаКлиенте
Процедура Утвердительно_УдалитьРейс(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;
	
	Объект.РейсОтменен = Истина;
	
	// надо отменить все состояния, чтобы они не появлялись в задачах пользователя
	Для Каждого Стр Из Объект.Состояния Цикл
		Если НЕ Стр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Выполнен") И 
			НЕ Стр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Отклонен") Тогда
			Стр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Отклонен");
			Стр.ЗавершениеРаботы = ТекущаяДата();
		КонецЕсли;
		
	КонецЦикла;
	
	СтатусПродажника = ПредопределенноеЗначение("Справочник.Состояния.ОтменаРейсаПереносЗаявокКлиентов");
	СтатусЛогиста = ПредопределенноеЗначение("Справочник.Состояния.ОтменаРейсаПереназначениеВагонов");
	
	СписокОтветственных = ПолучитьОтветственныхПриПереносахРейсов();
	
	Для каждого Стр из Объект.Состояния Цикл
		Если Стр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Новый") ИЛИ Стр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение") Тогда
			Стр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Отклонен");
		КонецЕсли;
	КонецЦикла;
	
	ГруппаПродажника = СписокОтветственных.ОтветственныйЗаПереносЗаявокКлиентов;
	ГруппаЛогиста = СписокОтветственных.ОтветственныйЗаПереназначениеВагонов;
	
	//НСтр = Объект.Состояния.Добавить();
	//НСтр.Состояние = СтатусПродажника;
	//НСтр.Исполнитель = ГруппаПродажника;
	//НСтр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение");
	//НСтр.НормативИсполненияСМоментаСоздания = 2;
	
	Если ПоРейсуЕстьНазначенныеВагоны(Объект.Ссылка) тогда
		НСтр = Объект.Состояния.Добавить();
		НСтр.Состояние = СтатусЛогиста;
		НСтр.Исполнитель = ГруппаЛогиста;
		НСтр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение");
		НСтр.НормативИсполненияСМоментаСоздания = 2;
	КонецЕсли;
	
	// удалить связь вагонов (КТК) и отправок
	УдалитьВагоныИзОтправки(Объект.Ссылка);
	
	СписокСвязанныхЗаявок = СписокЗаявокПоРейсу(Объект.Ссылка);
	Для каждого Заявка из СписокСвязанныхЗаявок Цикл
		
		ОтменитьЗаявкуИСоздатьЗадачуНаПереназначениеРейса(Заявка);
		
	КонецЦикла;
	
	// добавить в состояния последующих отправок информацию о возможности сдвигов сроков
	СледОтправки = Отправки_сервер.ПолучитьМассивДочернихОтправок(Объект.Ссылка);
	Если СледОтправки.Количество()>0 Тогда
		ОбновитьСостоянияДочернихОтправок(СледОтправки);
	КонецЕсли;
	
	ОбновитьВидимость();
	
	Записать();
	
	// после отмены рейса сделать рассылку
	ОтправитьНаПочтуУведомление(Объект.Автор,Объект.Ссылка,"ОтменаРейса",Объект.ДатаОтправления);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтправитьНаПочтуУведомление(АвторОтправки,СсылкаНаРейс,ТипОповещения,ДатаОтправленияРейса)
	
	// первичная проверка на то, что мы вообще можем что-то отправить
	УчетнаяЗаписьПоУмолчанию = РаботаСПочтовымиСообщениями.ПроверитьСистемнаяУчетнаяЗаписьДоступна();
	
	Если не УчетнаяЗаписьПоУмолчанию Тогда 
		возврат; 
	КонецЕсли;
	СистемнаяУчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	ГруппаПолучателей = Константы.ОтменаРейсаОтветственныеЗаПереназначениеВагонов.Получить();
	Если НЕ ЗначениеЗаполнено(ГруппаПолучателей) И НЕ ЗначениеЗаполнено(АвторОтправки) Тогда
		Возврат;
	КонецЕсли;
	
	ПрефиксНС = Константы["АдресПубликацииИнформационнойБазыВЛокальнойСети"+?(ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована, "Тестовый", "")].Получить() + "#";
	
	ПолучателиПисьма = Новый Массив;
	
	Если ЗначениеЗаполнено(АвторОтправки) Тогда
		EMAIL = ПолучитьEMAILПользователя(Пользователи_sd_сервер.ПодобратьЗамещение(АвторОтправки, ТекущаяДата()));
		Если ЗначениеЗаполнено(EMAIL) Тогда
			ПолучателиПисьма.Добавить(Новый Структура("Представление, Адрес", Строка(АвторОтправки), EMAIL));
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(ГруппаПолучателей) = Тип("СправочникСсылка.Пользователи") Тогда
		EMAIL = ПолучитьEMAILПользователя(Пользователи_sd_сервер.ПодобратьЗамещение(ГруппаПолучателей, ТекущаяДата()));
		Если ЗначениеЗаполнено(EMAIL) Тогда
			ПолучателиПисьма.Добавить(Новый Структура("Представление, Адрес", Строка(ГруппаПолучателей), EMAIL));
		КонецЕсли;
	Иначе
		ПользователиГруппы = Пользователи_sd_сервер.ПолучитьПользователейГруппы(ГруппаПолучателей);
		Для каждого ПользовательЪ из ПользователиГруппы Цикл
			EMAIL = ПолучитьEMAILПользователя(Пользователи_sd_сервер.ПодобратьЗамещение(ПользовательЪ, ТекущаяДата()));
			Если ЗначениеЗаполнено(EMAIL) Тогда
				ПолучателиПисьма.Добавить(Новый Структура("Представление, Адрес", Строка(ПользовательЪ), EMAIL));
				Сообщить("Планируется к отправке " + EMAIL);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
		
	Если ТипОповещения = "ОтменаРейса" Тогда
		Тема = "DATACore: Информация об отмене рейса";
		ТекстПисьма = "<b>В системе был отменен рейс:</b><br/><br/>";
	Иначе
		Тема = "DATACore: Информация о переносе дат рейса";
		ТекстПисьма = "<b>В системе были изменены даты рейса:</b><br/><br/>";
	КонецЕсли;
	
	ТекстПисьма = ТекстПисьма + СсылкаНаРейс + "<br/>";
	
	ТекстНС = "<a target=""_blank"" href="""+ПрефиксНС+ПолучитьНавигационнуюСсылку(СсылкаНаРейс)+""">"+ПолучитьНавигационнуюСсылку(СсылкаНаРейс)+"</a>";
	
	ТекстПисьма = ТекстПисьма + "<b>Навигационная ссылка: </b>" + ТекстНС + "<br/>";
	
	Если НЕ ТипОповещения = "ОтменаРейса" Тогда
		ТекстПисьма = ТекстПисьма + "<b>Дата отправления: </b>" + ДатаОтправленияРейса + "<br/><br/>";
	КонецЕсли;
	
	ТекстПисьма = ТекстПисьма + "<b>Дата формирования письма: </b>" + ТекущаяДата() + "<br/><br/>";
	ТекстПисьма = ТекстПисьма + "Спасибо за внимание! --DC";
	
	ПараметрыОтправкиПисьма = новый Структура;
	ПараметрыОтправкиПисьма.Вставить("Тема", Тема);
	ПараметрыОтправкиПисьма.Вставить("Тело", ТекстПисьма);
	ПараметрыОтправкиПисьма.Вставить("ТипТекста", "HTML");

	ПараметрыОтправкиПисьма.Вставить("Кому", ПолучателиПисьма);
	
	РЕЗУЛЬТАТ = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(СистемнаяУчетнаяЗапись, ПараметрыОтправкиПисьма);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьEMAILПользователя(Контрагент) 
	
	Результат = "";
	Для каждого Стр из Контрагент.КонтактнаяИнформация Цикл
		Если ЗначениеЗаполнено(Стр.АдресЭП) тогда
			Результат = Стр.Представление;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ОбновитьСостоянияДочернихОтправок(СледОтправки)
	
	Для каждого СлОтпр из СледОтправки Цикл
		СтатусЛогиста = ПредопределенноеЗначение("Справочник.Состояния.ОтменаПредыдущегоРейса");
		
		СписокОтветственных = ПолучитьОтветственныхПриПереносахРейсов();
		
		ГруппаЛогиста = СписокОтветственных.ОтветственныйЗаПереназначениеВагонов;
		
		ПолучОб = СлОтпр.ПолучитьОбъект();
		
		НСтр = ПолучОб.Состояния.Добавить();
		НСтр.Состояние = СтатусЛогиста;
		НСтр.Исполнитель = ГруппаЛогиста;
		НСтр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение");
		НСтр.НормативИсполненияСМоментаСоздания = 2;
		
		ПолучОб.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УдалитьВагоныИзОтправки(Отправка)
	
	НаборЗаписей = РегистрыСведений.ВагоныВОтправке.СоздатьНаборЗаписей();
    НаборЗаписей.Отбор.Отправка.Установить(Отправка);
    НаборЗаписей.Записать();
	
	НаборЗаписей = РегистрыСведений.КонтейнерыВОтправке.СоздатьНаборЗаписей();
    НаборЗаписей.Отбор.Отправка.Установить(Отправка);
    НаборЗаписей.Записать();
	
КонецПроцедуры	

&НаСервереБезКонтекста
Процедура ОтменитьЗаявкуИСоздатьЗадачуНаПереназначениеРейса(Заявка)
	
	МассивУдаляемыхСостояний = Новый Массив;
	СтатусПродажника = ПредопределенноеЗначение("Справочник.Состояния.ОтменаРейсаПереносЗаявокКлиентов");
	
	ЗаявкаОбъект = Заявка.ПолучитьОбъект();
	Для каждого Стр из ЗаявкаОбъект.Состояния Цикл
		// Закомментировано 17.01.2020 - заявку не отменяем, а предлагаем переназначить вагоны
		//Если Стр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Новый") ИЛИ Стр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение") Тогда
		//	Стр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Отклонен");
		//КонецЕсли;
		Если Стр.Состояние = СтатусПродажника Тогда МассивУдаляемыхСостояний.Добавить(Стр); КонецЕсли;
	КонецЦикла;
	
	Для каждого УдСост из МассивУдаляемыхСостояний Цикл
		ЗаявкаОбъект.Состояния.Удалить(УдСост);
	КонецЦикла;
	
	НСтр = ЗаявкаОбъект.Состояния.Добавить();
	НСтр.Состояние = СтатусПродажника;
	ГруппаПродажника = ЗаявкаОбъект.Состояния[0].Исполнитель;
	НСтр.Наблюдатель = ГруппаПродажника;
	НСтр.Исполнитель = ГруппаПродажника;
	НСтр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение");
	НСтр.НормативИсполненияСМоментаСоздания = 2;
	ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПоРейсуЕстьНазначенныеВагоны(Отправка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВагоныВОтправке.Вагон КАК Вагон
	               |ИЗ
	               |	РегистрСведений.ВагоныВОтправке КАК ВагоныВОтправке
	               |ГДЕ
	               |	ВагоныВОтправке.Отправка = &Отправка";
	Запрос.УстановитьПараметр("Отправка", Отправка);
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

&НаСервереБезКонтекста
Функция СписокЗаявокПоРейсу(Рейс)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаявкаПереченьРейсов.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
	               |ГДЕ
	               |	ЗаявкаПереченьРейсов.Рейс = &Рейс
	               |	И ЗаявкаПереченьРейсов.Ссылка.Проведен";
	Запрос.УстановитьПараметр("Рейс", Рейс);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
