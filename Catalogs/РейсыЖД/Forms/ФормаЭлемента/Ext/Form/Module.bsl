&НаКлиенте
Процедура ОбработкаНовойДатыРейса(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	Если Объект.ДатаОтправления <> Параметр1 Тогда //Евросиб Гудкова( 16.07.2020 Ticket№ 0200141 было < Параметр1 Тогда 
		ДельтаПоДатам = (Параметр1 - Объект.ДатаОтправления)/3600/24;
		ОповещениеПользователейОСдвигахСроков(Параметр1, ДельтаПоДатам);
		//Евросиб Гудкова( 16.07.2020 Ticket№ 0200141 ошибка при расчете даты прибытия
		//было	//Объект.ДатаПрибытия = Объект.ДатаПрибытия+ДельтаПрибытиеОтправление*3600*24;
		//		ДельтаПрибытиеОтправление = (Объект.ДатаПрибытия - Объект.ДатаОтправления)/3600/24;
		
		// Определим разницу между отправкой и прибытием:
		ДельтаПрибытиеОтправление = Объект.ДатаПрибытия - Объект.ДатаОтправления;
		
		// Посчитаем новую отправку:
		Если ЗначениеЗаполнено(Объект.ДатаОтправления) И ЗначениеЗаполнено(Объект.ПунктОтправления) И ЗначениеЗаполнено(Объект.ПунктНазначения) Тогда
			
			РезТабельноеРасписание = Отправки_сервер.ПолучитьТабельноеРасписаниеПоПараметрам(Объект.ПунктОтправления, Объект.ПунктНазначения);
			
			Если ЗначениеЗаполнено(РезТабельноеРасписание.Расписание) Тогда
				Если НачалоДня(Параметр1) = Параметр1 Тогда
					Объект.ДатаОтправления = Параметр1 + РезТабельноеРасписание.ДобавитьКНачалу;
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			Объект.ДатаОтправления = Параметр1;
			
		КонецЕсли;
		
		Объект.ДатаПрибытия = Объект.ДатаОтправления + ДельтаПрибытиеОтправление;
		// Евросиб Гудкова) 		
		Объект.СдвигРейсаПредыдущаяДата = Объект.ДатаОтправления;
		
		Попытка
			
			Записать();
			
		Исключение
			а = ОписаниеОшибки();
			Сообщить(а);
		КонецПопытки; 
		
		
		// после отмены рейса сделать рассылку
		ОтправитьНаПочтуУведомление(Объект.Автор,Объект.Ссылка,"ПереносДаты",Объект.ДатаОтправления);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОповещениеПользователейОСдвигахСроков(НоваяДатаРейса,ДельтаПоДатам)
	
	РекурсивныйВызовОповещенийПользователю(Объект.Ссылка,НоваяДатаРейса,ДельтаПоДатам);
	
КонецПроцедуры

&НаСервере
Процедура РекурсивныйВызовОповещенийПользователю(ТекОтпр,НоваяДатаРейса,ДельтаПоДатам)

	СледОтправки = Отправки_сервер.ПолучитьМассивДочернихОтправок(ТекОтпр);

	// выбираем первую отправку по дате отправки.
	// проверяем, чтобы дата отправления этой отправки была меньше 
	// даты прибытия родительской отправки плюс КоличествоСутокРазгрузки
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ВагоныВОтправке.Отправка КАК Отправка
	               |ПОМЕСТИТЬ ВТ
	               |ИЗ
	               |	РегистрСведений.ВагоныВОтправке КАК ВагоныВОтправке
	               |ГДЕ
	               |	НЕ ВагоныВОтправке.Отправка.РейсОтменен
	               |	И НЕ ВагоныВОтправке.Отправка.ПометкаУдаления
	               |	И ВагоныВОтправке.Отправка В(&Отправка)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВагоныВОтправке.Отправка.ДатаОтправления
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВагоныВОтправке.Отправка КАК Отправка,
	               |	ВагоныВОтправке.Вагон КАК Вагон,
	               |	ВагоныВОтправке.Отправка.ДатаПрибытия КАК ДатаПрибытия
	               |ИЗ
	               |	РегистрСведений.ВагоныВОтправке КАК ВагоныВОтправке
	               |ГДЕ
	               |	ВагоныВОтправке.Отправка В
	               |			(ВЫБРАТЬ
	               |				ВТ.Отправка
	               |			ИЗ
	               |				ВТ КАК ВТ)
	               |	И ВагоныВОтправке.Отправка.ДатаОтправления < НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаКон, ДЕНЬ, ВагоныВОтправке.Вагон.ТипТС.КоличествоСутокРазгрузки), ДЕНЬ)";
	Запрос.УстановитьПараметр("Отправка",СледОтправки);
	Запрос.УстановитьПараметр("ДатаКон",НоваяДатаРейса);
	ТЗ = Запрос.Выполнить().Выгрузить();
	// если такую отправку не нашли, прерываем рекурсию
	Если ТЗ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПерваяОтправка = ТЗ[0].Отправка;
	
	// добавить в состояния последующей отправки информацию о возможности сдвигов сроков

	ПолучОб = ПерваяОтправка.ПолучитьОбъект();
	
	СтатусЛогиста = Справочники.Состояния.ВозможенСдвигСроковПредыдущегоРейса;
	
	СписокОтветственных = ПолучитьОтветственныхПриПереносахРейсов();
	
	ГруппаЛогиста = СписокОтветственных.ОтветственныйЗаПереназначениеВагонов;
	
	НСтр = ПолучОб.Состояния.Добавить();
	НСтр.Состояние = СтатусЛогиста;
	НСтр.Исполнитель = ГруппаЛогиста;
	НСтр.Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
	НСтр.НормативИсполненияСМоментаСоздания = 2;
	Попытка
	
		ПолучОб.Записать();
	
	Исключение
	
	КонецПопытки; 
	
	// меняем новую дату рейса для последующего витка рекурсии
	НоваяДатаРейса = ТЗ[0].ДатаПрибытия+ДельтаПоДатам*3600*24;
	РекурсивныйВызовОповещенийПользователю(ПерваяОтправка,НоваяДатаРейса,ДельтаПоДатам);
	
КонецПроцедуры

