
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("УказанаСтанцияНазначения") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	АналогиЛокаций.Локация КАК Локация,
		               |	АналогиЛокаций.Аналог КАК Аналог
		               |ИЗ
		               |	РегистрСведений.АналогиЛокаций КАК АналогиЛокаций
		               |ГДЕ
		               |	АналогиЛокаций.Локация = &Локация";
		
		Запрос.УстановитьПараметр("Локация", Параметры.УказанаСтанцияНазначения);
		
		Результат = Запрос.Выполнить();
		Мас = Результат.Выгрузить().ВыгрузитьКолонку("Аналог");
		Мас.Добавить( Параметры.УказанаСтанцияНазначения );
		
		Спис = Новый СписокЗначений;
		Спис.ЗагрузитьЗначения(Мас);
		//ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ПунктНазначения", Мас, ВидСравненияКомпоновкиДанных.ВСписке,, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ, );
		
		ПользовательскийОтбор = Список.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(Список.КомпоновщикНастроек.Настройки.Отбор.ИдентификаторПользовательскойНастройки);
		
		ЭлементОтбора = ПользовательскийОтбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПунктНазначения");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.ПравоеЗначение = Спис;
		ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
		ЭлементОтбора.ИдентификаторПользовательскойНастройки = "ПунктНазначения";
		
	КонецЕсли; 
	
	// ДИТ ТА 70350 Сержантова А.С. Начало: 09.06.2023
	Если Параметры.Свойство("КТК") и Параметры.КТК.Количество() > 0 Тогда  
		ОтборПоКТК = Истина;
		СписокКТК.ЗагрузитьЗначения(Параметры.КТК);	
	КонецЕсли;  
	ОбновитьДинамическийСписок();
	// ДИТ ТА 70350 Сержантова А.С. Конец: 09.06.2023
	
	//Евросиб Коханенко Н.А. #61705 08.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 08.12.2022 )

КонецПроцедуры

