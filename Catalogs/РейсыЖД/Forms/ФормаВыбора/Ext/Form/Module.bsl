// ++ ДИТ, Сгонник, 2022-03-25 US 46168; TA 48699 необходимо вывести в форму "Отправки (жд-рейсы)" столбец с номером сделки
&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Рейсы = Строки.ПолучитьКлючи();
	
	Если Рейсы.Количество() Тогда
		
		// Проверим, нужно ли получать дополнительные поля
		СтрокаСписка = Строки.Получить(Рейсы[0]);
		ДополнительныеПоляВыводятся = СтрокаСписка.Данные.Свойство("Сделка") ИЛИ СтрокаСписка.Данные.Свойство("Контрагент");
	
		Если НЕ ДополнительныеПоляВыводятся Тогда 
			Возврат;
		КонецЕсли;
	Иначе
		// список пустой
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СделкаРейсы.Рейс КАК Рейс,
		|	СделкаРейсы.Ссылка.Номер КАК Сделка,
		|	НЕОПРЕДЕЛЕНО КАК Контрагент
		|ИЗ
		|	Документ.Сделка.Рейсы КАК СделкаРейсы
		|ГДЕ
		|	СделкаРейсы.Рейс В(&Рейсы)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗаявкаПереченьРейсов.Рейс,
		|	НЕОПРЕДЕЛЕНО,
		|	ЗаявкаПереченьРейсов.Ссылка.Контрагент
		|ИЗ
		|	Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
		|ГДЕ
		|	ЗаявкаПереченьРейсов.Рейс В(&Рейсы)";
	
	Запрос.УстановитьПараметр("Рейсы", Рейсы);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ТаблицаДополнительныеПоля = Новый ТаблицаЗначений;
	ТаблицаДополнительныеПоля.Колонки.Добавить("Рейс", Новый ОписаниеТипов("СправочникСсылка.РейсыЖД"));
	ТаблицаДополнительныеПоля.Колонки.Добавить("Сделка", Новый ОписаниеТипов("Строка"));
	ТаблицаДополнительныеПоля.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("Строка"));
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НайденнаяСтрока = ТаблицаДополнительныеПоля.Найти(ВыборкаДетальныеЗаписи.Рейс, "Рейс");
		Если НайденнаяСтрока = Неопределено Тогда 
			НайденнаяСтрока = ТаблицаДополнительныеПоля.Добавить();
			НайденнаяСтрока.Рейс = ВыборкаДетальныеЗаписи.Рейс;
		КонецЕсли;
		НайденнаяСтрока.Сделка = НайденнаяСтрока.Сделка 
			+ ?(ЗначениеЗаполнено(НайденнаяСтрока.Сделка) И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Сделка), ";", "") 
			+ ?(ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Сделка), ВыборкаДетальныеЗаписи.Сделка, ""); 
		НайденнаяСтрока.Контрагент = НайденнаяСтрока.Контрагент 
			+ ?(ЗначениеЗаполнено(НайденнаяСтрока.Контрагент) И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Контрагент), ";", "") 
			+ ?(ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Контрагент), ВыборкаДетальныеЗаписи.Контрагент, ""); 
	КонецЦикла;
	
	Для Каждого СтрокаТаблицыДополнительныеПоля Из ТаблицаДополнительныеПоля Цикл 
		СтрокаСписка = Строки[СтрокаТаблицыДополнительныеПоля.Рейс];
		// выводим для всех полей отдельно, чтобы если первое поле не выводится, следующее поле заполнялось
		Попытка
			СтрокаСписка.Данные["Сделка"] = СтрокаТаблицыДополнительныеПоля.Сделка;            
		Исключение
			// в порции данных строки с таким ключом может и не быть
		КонецПопытки;
		Попытка
			СтрокаСписка.Данные["Контрагент"] = СтрокаТаблицыДополнительныеПоля.Контрагент;            
		Исключение
			// в порции данных строки с таким ключом может и не быть
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры
