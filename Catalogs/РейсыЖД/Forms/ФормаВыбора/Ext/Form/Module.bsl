// ДИТ ТА 70350 Сержантова А.С. Начало: 09.06.2023
&НаСервере
Процедура ОбновитьДинамическийСписок()
	
	Если ОтборПоКТК Тогда   
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
			Список, "ОтборПоКТК", Истина, Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
			Список, "СписокКТК", СписокКТК, Истина);   
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
			Список, "ОтборПоКТК", Ложь, Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
			Список, "СписокКТК", Новый СписокЗначений, Истина);	
	КонецЕсли;	 

КонецПроцедуры    

