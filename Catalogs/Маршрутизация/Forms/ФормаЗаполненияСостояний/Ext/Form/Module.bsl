
&НаКлиенте
Процедура СостоянияПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ОК(Команда)
	
	ВсеЗаполнено = Истина;
	
	Результат = Новый Массив;
	Для каждого Стр из Состояния Цикл
		
		Результат.Добавить(Новый Структура("Состояние, Исполнитель, Наблюдатель", Стр.Состояние, Стр.Исполнитель, Стр.Наблюдатель));
		Если НЕ ЗначениеЗаполнено(Стр.Исполнитель) ИЛИ НЕ ЗначениеЗаполнено(Стр.Наблюдатель) Тогда ВсеЗаполнено = Ложь; КонецЕсли;
		
	КонецЦикла;
	
	Если ВсеЗаполнено Тогда
		Закрыть(Результат);
	Иначе
		ПоказатьПредупреждение(, "Не заполнены исполнители и наблюдатели. Проверьте таблицу и повторите попытку.");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ВыбраннаяМаршрутизация") Тогда
		
		Для Каждого Стр Из Параметры.ВыбраннаяМаршрутизация Цикл
			НовСтр = Состояния.Добавить();
			ЗаполнитьЗначенияСвойств(НовСТр,Стр);
		КонецЦикла;
		
	КонецЕсли;
	
	
