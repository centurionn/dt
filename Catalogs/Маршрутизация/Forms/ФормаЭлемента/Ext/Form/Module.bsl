			Элементы.ГруппаКонтрагентыИДоговоры4.Видимость = Истина;
			Элементы.ЦФО9.Видимость = Истина;
		Иначе
			Элементы.ГруппаКонтрагентыИДоговоры4.Видимость = Ложь;
			Элементы.ЦФО9.Видимость = Ложь;
		КонецЕсли; 
	КонецЕсли;
	
	
КонецПроцедуры
