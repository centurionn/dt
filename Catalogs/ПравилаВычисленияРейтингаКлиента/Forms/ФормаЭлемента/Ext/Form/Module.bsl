
&НаКлиенте
Процедура ЗаполнитьШаблоном(Команда)
	
	Объект.ПараметрыРейтинга.Очистить();
	Объект.ПараметрыРейтинга.Добавить().Аналитика = ПредопределенноеЗначение("Перечисление.АналитикиРейтингаКлиентов.СуммаДебиторскойЗадолженности");
	Объект.ПараметрыРейтинга.Добавить().Аналитика = ПредопределенноеЗначение("Перечисление.АналитикиРейтингаКлиентов.ДоляПДЗВСреднемесячнойВыручке");
	Объект.ПараметрыРейтинга.Добавить().Аналитика = ПредопределенноеЗначение("Перечисление.АналитикиРейтингаКлиентов.КоличествоДнейОтСчетаНаОплату");
	Объект.ПараметрыРейтинга.Добавить().Аналитика = ПредопределенноеЗначение("Перечисление.АналитикиРейтингаКлиентов.СводныйРискСПАРК");
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Для Каждого СтрокаТаблицыПараметров Из Объект.ПараметрыРейтинга Цикл
		
		Получатели = Объект.ПолучателиУведомлений.Выгрузить(Новый Структура("Аналитика, УровеньРиска", СтрокаТаблицыПараметров.Аналитика, Перечисления.СПАРКЗначенияРисков.Средний), "ПолучательУведомления").ВыгрузитьКолонку("ПолучательУведомления");
		СтрокаТаблицыПараметров.ПолучателиУведомленийЖелтойЗоны.ЗагрузитьЗначения(Получатели);
		
		Получатели = Объект.ПолучателиУведомлений.Выгрузить(Новый Структура("Аналитика, УровеньРиска", СтрокаТаблицыПараметров.Аналитика, Перечисления.СПАРКЗначенияРисков.Высокий), "ПолучательУведомления").ВыгрузитьКолонку("ПолучательУведомления");
		СтрокаТаблицыПараметров.ПолучателиУведомленийКраснойЗоны.ЗагрузитьЗначения(Получатели);		
		
	КонецЦикла;
	
	
	//Евросиб Коханенко Н.А. #61705 08.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 08.12.2022 )

КонецПроцедуры

