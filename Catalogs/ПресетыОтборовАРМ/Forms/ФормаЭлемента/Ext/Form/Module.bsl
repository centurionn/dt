&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Объект.СписокОтборовВагонов.Очистить();
	
	ОбойтиРекурсивноСтрокиДереваНаКлиенте(ДеревоОтборов.ПолучитьЭлементы());
	ОбойтиРекурсивноСтрокиДереваНаКлиенте(ДеревоОтборовТипТС.ПолучитьЭлементы());
	
КонецПроцедуры

&НаКлиенте
Процедура ОбойтиРекурсивноСтрокиДереваНаКлиенте(Строки)
	Для Каждого СтрокаДерева Из Строки Цикл
		// сохраняем данные только если стоит флаг использования фильтра
		Если СтрокаДерева.Использование Тогда
			Если (СтрокаДерева.НаименованиеОтбора = ПредопределенноеЗначение("Перечисление.ВариантыОтборовВагонов.ТипТС") И
				НЕ ЗначениеЗаполнено(СтрокаДерева.ВариантЗначенияОтбора)) ИЛИ
				НЕ ЗначениеЗаполнено(СтрокаДерева.НаименованиеОтбора) Тогда
				// ничего не делаем, нам не нужны родительские группы, т.к. при выделении 
				// родительской группы автоматически отмечаются флагами дочерние
			Иначе
				НовСтр = Объект.СписокОтборовВагонов.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр,СтрокаДерева);
				Если СтрокаДерева.НаименованиеОтбора = ПредопределенноеЗначение("Перечисление.ВариантыОтборовВагонов.ИсторияПоВагону") И
					СтрокаДерева.ВариантЗначенияОтбора = Истина Тогда
					НовСтр.Приоритет = 1;
					Объект.Исторический = Истина;
				Иначе
					НовСтр.Приоритет = 0;
					Объект.Исторический = Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
         
        ПодчиненныеСтроки = СтрокаДерева.ПолучитьЭлементы();
         
        Если ПодчиненныеСтроки.Количество() > 0 Тогда
            ОбойтиРекурсивноСтрокиДереваНаКлиенте(ПодчиненныеСтроки);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОтборовТипТСИспользованиеПриИзменении(Элемент)
	
	ТекД = Элементы.ДеревоОтборовТипТС.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекСтр = Элементы.ДеревоОтборовТипТС.ТекущаяСтрока;
	
	ОбходНаСервере(ТекСтр,ТекД.Использование);
КонецПроцедуры

&НаСервере
Процедура ОбходНаСервере(ТекСтр,Использование)

	тДерево = ДеревоОтборовТипТС.НайтиПоИдентификатору(ТекСтр);
	
	ОбходДерева(тДерево,Использование);
	
КонецПроцедуры
 
&НаСервере
Процедура ОбходДерева(Дерево,Использование)
	
	Для Каждого Строка Из Дерево.ПолучитьЭлементы() Цикл
		ИдентификаторСтроки = Строка.ПолучитьИдентификатор();

		тДерево = ДеревоОтборовТипТС.НайтиПоИдентификатору(ИдентификаторСтроки);
		тДерево.Использование = Использование;
		ОбходДерева(Строка,Использование);

	КонецЦикла;
	
КонецПроцедуры