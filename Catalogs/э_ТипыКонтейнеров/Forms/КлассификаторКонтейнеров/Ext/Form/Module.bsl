&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДанныеКлассификатора = ПолучитьДанныеКлассификатора();
	Для каждого СтрКлассиф Из  ДанныеКлассификатора Цикл
		НовСтр = Классификатор.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,СтрКлассиф); 				
	КонецЦикла; 
	
	
	//Евросиб Коханенко Н.А. #61705 08.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 08.12.2022 )

КонецПроцедуры

