&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	МассивРеквизитов = Новый Массив;
	
	Для Каждого Стр Из РеквизитыОбъекта Цикл 
		МассивРеквизитов.Добавить(Стр.Имя);
	КонецЦикла;
	
	ТекстСообщения = ПроверитьУсловияПроверяемыхПараметров(ТипОбъекта, Объект.ПроверяемыеПараметры, 
							Объект.Ссылка, МассивРеквизитов, Объект.ВариантПерезапуска); 
	Если ЗначениеЗаполнено(ТекстСообщения) Тогда    
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
	КонецЕсли;
		
КонецПроцедуры //ДИТ Авдеева В.С. 47090 20.04.2022 Конец

