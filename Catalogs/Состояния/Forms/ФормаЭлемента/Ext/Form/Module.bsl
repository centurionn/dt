//ДИТ Авдеева В.С. 47090 20.04.2022 Начало
&НаКлиенте
Процедура ТипОбъектаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = ПодготовитьПараметрыФормыВыборОбъектовМетаданных(); 
	ОписаниеОповещения = Новый ОписаниеОповещения("ТипОбъектаПослеВыбора", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.ВыборОбъектовМетаданных", ПараметрыФормы, Элемент,,,, ОписаниеОповещения);

КонецПроцедуры //ДИТ Авдеева В.С. 47090 20.04.2022 Конец

//ДИТ Авдеева В.С. 47090 20.04.2022 Начало
&НаКлиенте
Процедура ТипОбъектаПослеВыбора(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено 
		И ТипЗнч(Результат) = Тип("СписокЗначений")
		И ЗначениеЗаполнено(Результат) Тогда 
		ПолноеИмяОбъекта = Результат[0].Значение;
		ЗаполнитьРеквизитыПоОбъекту(ПолноеИмяОбъекта);
	КонецЕсли;
	
КонецПроцедуры //ДИТ Авдеева В.С. 47090 20.04.2022 Конец

