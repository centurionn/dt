// Функция - Структура пустая
//
// Параметры:
//  Структура	 - Сруктура	 - 
// 
// Возвращаемое значение:
//  Булево - 
//
Функция СтруктураПустая(Структура)
    Для Каждого Стр Из Структура Цикл
        Если ТипЗнч(Стр) = Тип("Структура") Тогда
            Если НЕ СтруктураПустая(Стр) Тогда
                Возврат Ложь;
            КонецЕсли;
        Иначе
            Если Стр.Значение <> Неопределено Тогда
                Возврат Ложь;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    
    Возврат Истина;
КонецФункции

// Функция - Таблицы значений равны
//
// Параметры:
//  ТаблицаЗначений1 - 	 - 
//  ТаблицаЗначений2 - 	 - 
// 
// Возвращаемое значение:
// Булево  - 
//
Функция ТаблицыЗначенийРавны(ТаблицаЗначений1, ТаблицаЗначений2) // ДИТ US 62421 TA 64346 Евсенкин М.А.


    Если ТипЗнч(ТаблицаЗначений1) <> Тип("ТаблицаЗначений") ИЛИ ТипЗнч(ТаблицаЗначений2) <> Тип("ТаблицаЗначений") Тогда
        Возврат Ложь;
    КонецЕсли; 
    
    Если ТаблицаЗначений1.Количество() <> ТаблицаЗначений2.Количество() Тогда
        Возврат Ложь;
    КонецЕсли; 


    Если ТаблицаЗначений1.Колонки.Количество() <> ТаблицаЗначений2.Колонки.Количество() Тогда
        Возврат Ложь;
    КонецЕсли;
    
   // Проверим поля
 
    Для каждого Колонка Из ТаблицаЗначений1.Колонки Цикл
        Если ТаблицаЗначений2.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла; 
    Для каждого Колонка Из ТаблицаЗначений2.Колонки Цикл
        Если ТаблицаЗначений1.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла; 
    
   // сформируем строку индекса для оптимизации поиска по таблице значений
 
    СтрокаИндекса = "";
    Для каждого Колонка Из ТаблицаЗначений1.Колонки Цикл
        Если СтрокаИндекса = "" Тогда
            СтрокаИндекса = Колонка.Имя;
        Иначе
            СтрокаИндекса = СтрокаИндекса+","+Колонка.Имя;
        КонецЕсли;
    КонецЦикла;
   // добавим индекс
 
    ТаблицаЗначений2.Индексы.Добавить(СтрокаИндекса);
    
   // Проверим записи
 
    Для каждого СтрокаТаблицы Из ТаблицаЗначений1 Цикл
        СтруктураПоиска = Новый Структура;
        Для каждого Колонка Из ТаблицаЗначений1.Колонки Цикл
            СтруктураПоиска.Вставить(Колонка.Имя, СтрокаТаблицы[Колонка.Имя]);
        КонецЦикла;
        СтрокиТаблицы2 = ТаблицаЗначений2.НайтиСтроки(СтруктураПоиска);
        Если СтрокиТаблицы2.Количество() <> 1 Тогда
            Возврат Ложь;
        КонецЕсли; 
    КонецЦикла;
    
   // сформируем строку индекса для оптимизации поиска по таблице значений
 
    СтрокаИндекса = "";
    Для каждого Колонка Из ТаблицаЗначений2.Колонки Цикл
        Если СтрокаИндекса = "" Тогда
            СтрокаИндекса = Колонка.Имя;
        Иначе
            СтрокаИндекса = СтрокаИндекса+","+Колонка.Имя;
        КонецЕсли;
    КонецЦикла;
   // добавим индекс
 
    ТаблицаЗначений1.Индексы.Добавить(СтрокаИндекса);
    
    Для каждого СтрокаТаблицы Из ТаблицаЗначений2 Цикл
        СтруктураПоиска = Новый Структура;
        Для каждого Колонка Из ТаблицаЗначений2.Колонки Цикл
            СтруктураПоиска.Вставить(Колонка.Имя, СтрокаТаблицы[Колонка.Имя]);
        КонецЦикла;
        СтрокиТаблицы1 = ТаблицаЗначений1.НайтиСтроки(СтруктураПоиска);
        Если СтрокиТаблицы1.Количество() <> 1 Тогда
            Возврат Ложь;
        КонецЕсли; 
    КонецЦикла;
    
    Возврат Истина;
    
КонецФункции

// Функция - Проверка реквизитов на изменение
//
Функция ПроверкаРеквизитовНаИзменение(СтруктураШапкиКлючаАналитики,ВыборкаДетальныеЗаписи)  // ДИТ US 62421 TA 64346 Евсенкин М.А.
	
	МассивИзмененныхПолей = Новый Массив;
	
	Для Каждого Стр Из СтруктураШапкиКлючаАналитики Цикл	
		Если Стр.Ключ = "ИзменятьТЧДетализацияПоГрузу"  
			//Евросиб(ДИТ) Антонова А.С. US 77172 ТА 110410 Начало 26.05.2025
			ИЛИ Стр.Ключ = "ИсточникЗаписи"
			//Евросиб(ДИТ) Антонова А.С. US 77172 ТА 110410 Конец 26.05.2025
			Или ТипЗнч(Стр.Значение) = Тип("Структура") 
			Или ТипЗнч(Стр.Значение) = Тип("ТаблицаЗначений")
			//Евросиб Шевченко А.В. 07.05.2025 US 94035 TA 104217
			ИЛИ Стр.Ключ = "ИзменятьТЧЭтапыСНП" Тогда 
			//Евросиб Шевченко А.В. 07.05.2025 US 94035 TA 104217
			Продолжить;
		КонецЕсли;	
		Если Не Стр.Значение = Неопределено И НЕ ВыборкаДетальныеЗаписи[Стр.Ключ] = Стр.Значение Тогда 
			МассивИзмененныхПолей.Добавить(Стр.Ключ);		
		КонецЕсли;	
	КонецЦикла;                                      
	
	Возврат МассивИзмененныхПолей; 
	
КонецФункции	

Функция ПроверкаРеквизитовНаИзменениеТЧМили(СтруктураТЧМилиКлючаАналитики,РезультатМили,ЭтапПеревозки)
	
	МассивИзмененныхПолей = Новый Массив;
		
	Если Не СтруктураПустая(СтруктураТЧМилиКлючаАналитики) Тогда 
		ТЗМилиДоИзменения = РезультатМили.Выгрузить();
		СтруктураПоиска = Новый Структура("ЭтапПеревозки",ЭтапПеревозки);
		МассивСтрок = ТЗМилиДоИзменения.НайтиСтроки(СтруктураПоиска);	
		Для Каждого Стр Из СтруктураТЧМилиКлючаАналитики Цикл
			Если МассивСтрок.Количество() Тогда
				Если Стр.Значение <> Неопределено И МассивСтрок[0][Стр.Ключ] <> Стр.Значение Тогда 
					МассивИзмененныхПолей.Добавить(Стр.Ключ);		
				КонецЕсли;
			Иначе
				МассивИзмененныхПолей.Добавить(Стр.Ключ);
			КонецЕсли;
		КонецЦикла; 
	КонецЕсли;
	
	Возврат МассивИзмененныхПолей; 
	
КонецФункции

#КонецОбласти

