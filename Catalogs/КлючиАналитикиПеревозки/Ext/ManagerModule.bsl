#Область ПрограммныйИнтерфейс

// Функция - Создать/Найти ключ аналитики
//
// Параметры:
//  СтруктураКлючаАналитикиПеревозки - 	 - СтруктураКлючаАналитикиПеревозки() 
// 
// Возвращаемое значение:
//  Структура - СправочникСсылка.КлючиАналитикиПеревозки и Версия данных
//
Функция НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлючаАналитикиПеревозки) Экспорт // ДИТ US 62421 TA 64346 Евсенкин М.А. 
	
	КлючСсылка = Справочники.КлючиАналитикиПеревозки.ПустаяСсылка();
	
	Если СтруктураКлючаАналитикиПеревозки.Свойство("КлючАналитики",КлючСсылка) Тогда  
		Если Не ЗначениеЗаполнено(КлючСсылка) Тогда   
			КлючСсылка = СоздатьНовыйКлючАналитикиПеревозки(СтруктураКлючаАналитикиПеревозки);
		Иначе 
			КлючСсылка = ОбновитьСуществующийКлючАналитикиПеревозки(СтруктураКлючаАналитикиПеревозки);
		КонецЕсли;	
	КонецЕсли;	
	
	ВерсияДанных = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КлючСсылка,"ВерсияДанных");
	
	Структура = Новый Структура("КлючАналитикиПеревозки,ВерсияДанных",КлючСсылка,ВерсияДанных);
	
	Возврат Структура;	
	
КонецФункции

