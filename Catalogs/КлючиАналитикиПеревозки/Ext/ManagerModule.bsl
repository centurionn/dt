// Функция - Создать новый ключ аналитики перевозки
//
// Параметры:
//  СтруктураКлючаАналитикиПеревозки - 	 - 
// 
// Возвращаемое значение:
//   - 
//
Функция СоздатьНовыйКлючАналитикиПеревозки(СтруктураКлючаАналитикиПеревозки)
	
	КлючОбъект = Справочники.КлючиАналитикиПеревозки.СоздатьЭлемент();
	// Наименование будет сформировано при записи объекта автоматически	
	ЗаполнитьЗначенияСвойств(КлючОбъект,СтруктураКлючаАналитикиПеревозки);
	Если Не СтруктураПустая(СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиПерваяМиляКлючаАналитики) Тогда
		НовСтрока = КлючОбъект.Мили.Добавить();
		НовСтрока.ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПерваяМиля;
		ЗаполнитьЗначенияСвойств(НовСтрока,СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиПерваяМиляКлючаАналитики);
	КонецЕсли;
	Если Не СтруктураПустая(СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиПоследняяМиляКлючаАналитики) Тогда
		НовСтрока = КлючОбъект.Мили.Добавить();
		НовСтрока.ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПоследняяМиля;
		ЗаполнитьЗначенияСвойств(НовСтрока,СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиПоследняяМиляКлючаАналитики);
	КонецЕсли;
	//Евросиб Коханенко Н.А. 12.08.2024 (( #87840 
	Если Не СтруктураПустая(СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиСредняяМиляКлючаАналитики) Тогда
		НовСтрока = КлючОбъект.Мили.Добавить();
		НовСтрока.ЭтапПеревозки = Перечисления.ЭтапыПеревозки.СредняяМиля;
		ЗаполнитьЗначенияСвойств(НовСтрока,СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиСредняяМиляКлючаАналитики);
	КонецЕсли;
	//Евросиб Коханенко Н.А. 12.08.2024 )) #87840
	//Евросиб Шевченко А.В. 07.05.2025 US 94035 TA 104217
	Если СтруктураКлючаАналитикиПеревозки.ТЧЭтапыСНП.Количество() Тогда
		НовСтрока = КлючОбъект.ЭтапыСНП.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока,СтруктураКлючаАналитикиПеревозки.ТЧЭтапыСНП);
	КонецЕсли;
	//Евросиб Шевченко А.В. 07.05.2025 US 94035 TA 104217
	Если СтруктураКлючаАналитикиПеревозки.ТЧДетализацияПоГрузу.Количество() Тогда
		КлючОбъект.ДетализацияПоГрузу.Загрузить(СтруктураКлючаАналитикиПеревозки.ТЧДетализацияПоГрузу);
	КонецЕсли;        
	//Евросиб(ДИТ) Антонова А.С. US 77172 ТА 110410 Начало 26.05.2025
	КлючОбъект.ДополнительныеСвойства.Вставить("ИсточникЗаписи", СтруктураКлючаАналитикиПеревозки.ИсточникЗаписи);
	//Евросиб(ДИТ) Антонова А.С. US 77172 ТА 110410 Конец 26.05.2025
	КлючОбъект.Записать();
	
	Возврат КлючОбъект.Ссылка;
	
КонецФункции

// Функция - Обновить существующий ключ аналитики перевозки
//
// Параметры:
//  СтруктураКлючаАналитикиПеревозки - 	 - 
// 
// Возвращаемое значение:
//   - 
//
Функция ОбновитьСуществующийКлючАналитикиПеревозки(СтруктураКлючаАналитикиПеревозки)
	КлючВыборка = ПолучитьЗначенияКлюча(СтруктураКлючаАналитикиПеревозки.КлючАналитики);
	КлючВыборка.Следующий(); 
	КлючОбъект 							= КлючВыборка.КлючАналитики.ПолучитьОбъект();
	МассивИзмененныхПолей 				= ПроверкаРеквизитовНаИзменение(СтруктураКлючаАналитикиПеревозки,КлючВыборка);
	МассивИзмененныхПолейПерваяМиля 	= ПроверкаРеквизитовНаИзменениеТЧМили(СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиПерваяМиляКлючаАналитики,КлючВыборка.Мили,Перечисления.ЭтапыПеревозки.ПерваяМиля);
	МассивИзмененныхПолейПоследняяМиля 	= ПроверкаРеквизитовНаИзменениеТЧМили(СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиПоследняяМиляКлючаАналитики,КлючВыборка.Мили,Перечисления.ЭтапыПеревозки.ПоследняяМиля);
	//Евросиб Коханенко Н.А. 12.08.2024 (( #87840 
	МассивИзмененныхПолейСредняяМиля 	= ПроверкаРеквизитовНаИзменениеТЧМили(СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиСредняяМиляКлючаАналитики,КлючВыборка.Мили,Перечисления.ЭтапыПеревозки.СредняяМиля);
	//Евросиб Коханенко Н.А. 12.08.2024 )) #87840 

	ТЧДетализацияПоГрузуИзменена = Ложь;
	Если СтруктураКлючаАналитикиПеревозки.ИзменятьТЧДетализацияПоГрузу Тогда  
		мДетализацияПоГрузу = КлючВыборка.ДетализацияПоГрузу.Выгрузить();
		мДетализацияПоГрузу.Колонки.Удалить("КлючАналитикиПеревозки");
		ТЧДетализацияПоГрузуИзменена		= Не ТаблицыЗначенийРавны(СтруктураКлючаАналитикиПеревозки.ТЧДетализацияПоГрузу,мДетализацияПоГрузу)   
						// ДИТ US 78233 TA 78240 Сержантова А.С. Начало: 09.01.2024 - если таблицы пустые, то ключ не перезаписываем
						И (не СтруктураКлючаАналитикиПеревозки.ТЧДетализацияПоГрузу.Количество() = 0 или не мДетализацияПоГрузу.Количество() = 0);
						// ДИТ US 78233 TA 78240 Сержантова А.С. Конец: 09.01.2024
	КонецЕсли;
	//Евросиб Шевченко А.В. 07.05.2025 US 94035 TA 104217
	ТЧЭтапыСНПИзменена = Ложь;
	Если СтруктураКлючаАналитикиПеревозки.ИзменятьТЧЭтапыСНП Тогда  
		мЭтапыСНП = КлючВыборка.ЭтапыСНП.Выгрузить();
		ТЧЭтапыСНПИзменена		= Не ТаблицыЗначенийРавны(СтруктураКлючаАналитикиПеревозки.ТЧЭтапыСНП,мЭтапыСНП)   
						И (не СтруктураКлючаАналитикиПеревозки.ТЧЭтапыСНП.Количество() = 0 или не мЭтапыСНП.Количество() = 0);
	КонецЕсли;
	//Евросиб Шевченко А.В. 07.05.2025 US 94035 TA 104217
	Если МассивИзмененныхПолей.Количество() 
		ИЛИ МассивИзмененныхПолейПерваяМиля.Количество() 
		ИЛИ МассивИзмененныхПолейПоследняяМиля.Количество() 
		//Евросиб Коханенко Н.А. 12.08.2024 (( #87840 
		ИЛИ МассивИзмененныхПолейСредняяМиля.Количество() 
		//Евросиб Коханенко Н.А. 12.08.2024 )) #87840 
		ИЛИ ТЧДетализацияПоГрузуИзменена
		//Евросиб Шевченко А.В. 07.05.2025 US 94035 TA 104217
		ИЛИ ТЧЭтапыСНПИзменена Тогда
		//Евросиб Шевченко А.В. 07.05.2025 US 94035 TA 104217
		
		// Наименование будет сформировано при записи объекта автоматически
		Для Каждого СтрМассивИзмененныхПолей Из МассивИзмененныхПолей Цикл 
			//Евросиб Коханенко Н.А. 05.07.2024 (( #83866
			Если СтрМассивИзмененныхПолей = "НомерЗаявкиПриемника" Тогда
				КлючОбъект.ДополнительныеСвойства.Вставить("НомерЗаявкиПриемника", СтруктураКлючаАналитикиПеревозки[СтрМассивИзмененныхПолей]);
				Продолжить;
			КонецЕсли;
			//Евросиб Коханенко Н.А. 05.07.2024 )) #83866    
			КлючОбъект[СтрМассивИзмененныхПолей] = СтруктураКлючаАналитикиПеревозки[СтрМассивИзмененныхПолей];
		КонецЦикла;
		Для Каждого СтрМассивИзмененныхПолей Из МассивИзмененныхПолейПерваяМиля Цикл
			СтруктураПоиска = Новый Структура("ЭтапПеревозки",Перечисления.ЭтапыПеревозки.ПерваяМиля);
			МассивСтрок = КлючОбъект.Мили.НайтиСтроки(СтруктураПоиска);
			Если МассивСтрок.Количество() Тогда
				СтрокаТЧ = МассивСтрок[0];
			Иначе
				СтрокаТЧ = КлючОбъект.Мили.Добавить();
				СтрокаТЧ.ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПерваяМиля;
			КонецЕсли;
			СтрокаТЧ[СтрМассивИзмененныхПолей] = СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиПерваяМиляКлючаАналитики[СтрМассивИзмененныхПолей];
		КонецЦикла;
		Для Каждого СтрМассивИзмененныхПолей Из МассивИзмененныхПолейПоследняяМиля Цикл 
			СтруктураПоиска = Новый Структура("ЭтапПеревозки",Перечисления.ЭтапыПеревозки.ПоследняяМиля);
			МассивСтрок = КлючОбъект.Мили.НайтиСтроки(СтруктураПоиска);
			Если МассивСтрок.Количество() Тогда
				СтрокаТЧ = МассивСтрок[0];
			Иначе
				СтрокаТЧ = КлючОбъект.Мили.Добавить();
				СтрокаТЧ.ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПоследняяМиля;
			КонецЕсли;
			СтрокаТЧ[СтрМассивИзмененныхПолей] = СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиПоследняяМиляКлючаАналитики[СтрМассивИзмененныхПолей];
		КонецЦикла;
        //Евросиб Коханенко Н.А. 12.08.2024 (( #87840 
		Для Каждого СтрМассивИзмененныхПолей Из МассивИзмененныхПолейСредняяМиля Цикл 
			СтруктураПоиска = Новый Структура("ЭтапПеревозки",Перечисления.ЭтапыПеревозки.СредняяМиля);
			МассивСтрок = КлючОбъект.Мили.НайтиСтроки(СтруктураПоиска);
			Если МассивСтрок.Количество() Тогда
				СтрокаТЧ = МассивСтрок[0];
			Иначе
				СтрокаТЧ = КлючОбъект.Мили.Добавить();
				СтрокаТЧ.ЭтапПеревозки = Перечисления.ЭтапыПеревозки.СредняяМиля;
			КонецЕсли;
			СтрокаТЧ[СтрМассивИзмененныхПолей] = СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиСредняяМиляКлючаАналитики[СтрМассивИзмененныхПолей];
		КонецЦикла;
		//Евросиб Коханенко Н.А. 12.08.2024 )) #87840 
		Если ТЧДетализацияПоГрузуИзменена Тогда
			КлючОбъект.ДетализацияПоГрузу.Загрузить(СтруктураКлючаАналитикиПеревозки.ТЧДетализацияПоГрузу);
		КонецЕсли;
		//Евросиб Шевченко А.В. 07.05.2025 US 94035 TA 104217
		Если ТЧЭтапыСНПИзменена Тогда
			КлючОбъект.ЭтапыСНП.Загрузить(СтруктураКлючаАналитикиПеревозки.ТЧЭтапыСНП);
		КонецЕсли;
		//Евросиб Шевченко А.В. 07.05.2025 US 94035 TA 104217
		//Евросиб(ДИТ) Антонова А.С. US 77172 ТА 110410 Начало 26.05.2025
		КлючОбъект.ДополнительныеСвойства.Вставить("ИсточникЗаписи", СтруктураКлючаАналитикиПеревозки.ИсточникЗаписи);
		//Евросиб(ДИТ) Антонова А.С. US 77172 ТА 110410 Конец 26.05.2025
		КлючОбъект.Записать();
	КонецЕсли;
	
	Возврат КлючОбъект.Ссылка;	
КонецФункции
