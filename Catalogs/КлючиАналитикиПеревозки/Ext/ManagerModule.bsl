// Функция - Получить детализацию по грузу
//
// Параметры:
//  МассивКлючей - Массив	 - ссылки на ключи
// 
// Возвращаемое значение:
//  ТЗ - Таблица значений
//
Функция ПолучитьДетализациюПоГрузу(МассивКлючей) Экспорт	// ДИТ US 62421 TA 64346 Евсенкин М.А. 	
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДетализацияПоГрузу.Ссылка КАК КлючАналитикиПеревозки,
		|	ДетализацияПоГрузу.Груз КАК Груз,
		|	ДетализацияПоГрузу.ОпасныйГруз КАК ОпасныйГруз,
		|	ДетализацияПоГрузу.КоличествоМест КАК КоличествоМест,
		|	ДетализацияПоГрузу.ВесГруза КАК ВесГруза,
		|	ДетализацияПоГрузу.РодУпаковки КАК РодУпаковки
		|ИЗ
		|	Справочник.КлючиАналитикиПеревозки.ДетализацияПоГрузу КАК ДетализацияПоГрузу
		|ГДЕ
		|	ДетализацияПоГрузу.Ссылка В(&МассивКлючей)";
	
	Запрос.УстановитьПараметр("МассивКлючей",МассивКлючей);
	
	Результат = Запрос.Выполнить(); 

	Возврат Результат.Выгрузить();
	
КонецФункции

