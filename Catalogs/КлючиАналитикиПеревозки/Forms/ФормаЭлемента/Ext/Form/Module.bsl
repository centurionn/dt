&НаКлиенте
Процедура ПоказатьВопросПродолжениеЗаписиЗавершение(Результат, ПараметрыЗаписи) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		ПараметрыЗаписи.Вставить("ВопросВыставленныеСчетаЗадан", Истина);
	    Записать(ПараметрыЗаписи);
	КонецЕсли;	

КонецПроцедуры

// ДИТ US 83041 ТА 83043 Сержантова А.С. 02.05.2024    
&НаСервере
Функция ПроверитьВыставленныеПоЗаявкеСчета(СсылкаЗаявки)

	МассивСчетов = Новый Массив;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СчетНаОплатуПокупателюДокументыОснования.Ссылка КАК Ссылка,
		|	СчетНаОплатуПокупателюДокументыОснования.Ссылка.Представление КАК ПредставлениеСчета
		|ИЗ
		|	Документ.СчетНаОплатуПокупателю.ДокументыОснования КАК СчетНаОплатуПокупателюДокументыОснования
		|ГДЕ
		|	СчетНаОплатуПокупателюДокументыОснования.Документ = &Документ
		|	И НЕ СчетНаОплатуПокупателюДокументыОснования.Ссылка.ПометкаУдаления
		|	И СчетНаОплатуПокупателюДокументыОснования.Ссылка.Проведен";
	
	Запрос.УстановитьПараметр("Документ", СсылкаЗаявки);
	
	РезультатЗапроса = Запрос.Выполнить();   
	Если не РезультатЗапроса.Пустой() Тогда
		ВыборкаСчетов = РезультатЗапроса.Выбрать();
		Пока ВыборкаСчетов.Следующий() Цикл
			МассивСчетов.Добавить(ВыборкаСчетов.ПредставлениеСчета);
		КонецЦикла;
	КонецЕсли;

	Возврат МассивСчетов;
КонецФункции 

// ДИТ US 83041 ТА 83043 Сержантова А.С. 02.05.2024 
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи) 
	КонтейнерПредыдущий = ОбщегоНазначенияВызовСервера.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "Контейнер");
	Если ЗначениеЗаполнено(Объект.Заявка) и КонтейнерПредыдущий <> Объект.Контейнер 
		и не ПараметрыЗаписи.Свойство("ВопросВыставленныеСчетаЗадан") Тогда
		МассивВыставленныхСчетов = ПроверитьВыставленныеПоЗаявкеСчета(Объект.Заявка);  
		Если МассивВыставленныхСчетов.Количество() Тогда
			Отказ = Истина;
			Оповещение = Новый ОписаниеОповещения("ПоказатьВопросПродолжениеЗаписиЗавершение", ЭтаФорма, ПараметрыЗаписи);	
			СчетаСтрока = СтрСоединить(МассивВыставленныхСчетов, ", ");
			ТекстВопроса = "Внимание, вы изменяете данные по заявке, на которую имеются выставленные счета: " + СчетаСтрока;
			СписокКнопок = Новый СписокЗначений;
			СписокКнопок.Добавить(КодВозвратаДиалога.Да, "Продолжить");
			СписокКнопок.Добавить(КодВозвратаДиалога.Отмена, "Отмена");
			ПоказатьВопрос(Оповещение, ТекстВопроса, СписокКнопок,,КодВозвратаДиалога.Да);  
			Возврат;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

