Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Поля = Новый Массив;
	Поля.Добавить("Наименование");
	Поля.Добавить("ОснованиеДляПодписания");
	Поля.Добавить("ДатаНачалаДействия");
	Поля.Добавить("ДатаОкончанияДейставия");
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Представление = "" + Данные.Наименование + " " + Данные.ОснованиеДляПодписания + " " + Формат(Данные.ДатаНачалаДействия, "ДЛФ=Д") + " - " + Формат(Данные.ДатаОкончанияДейставия, "ДЛФ=Д");
	
КонецПроцедуры

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = Новый СписокЗначений;
	
	Если СтрДлина(Параметры.СтрокаПоиска) < 3 Тогда Возврат; КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Доверенности.Ссылка КАК Ссылка,
	               |	Доверенности.ОснованиеДляПодписания КАК ОснованиеДляПодписания,
	               |	Доверенности.Наименование КАК Наименование,
	               |	Доверенности.ДатаНачалаДействия КАК ДатаНачалаДействия,
	               |	Доверенности.ДатаОкончанияДейставия КАК ДатаОкончанияДействия
	               |ИЗ
	               |	Справочник.Доверенности КАК Доверенности
	               |ГДЕ
	               |	НЕ Доверенности.ПометкаУдаления
	               |	И Доверенности.Наименование ПОДОБНО &СтрПоиска";
	Запрос.УстановитьПараметр("СтрПоиска", "%"+Параметры.СтрокаПоиска +"%");
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		ДанныеВыбора.Добавить(Ответ.Ссылка, ""+Ответ.Наименование + " " + Ответ.ОснованиеДляПодписания + " " + Формат(Ответ.ДатаНачалаДействия, "ДЛФ=Д") + " - " + Формат(Ответ.ДатаОкончанияДействия, "ДЛФ=Д"));
	КонецЦикла;

КонецПроцедуры
