
&НаКлиенте
Процедура Сохранить(Команда)
	МассивВыбранных = Новый Массив;
	Для каждого Стр из ВидыДокументов Цикл 
		Если Стр.Использовать Тогда 
			МассивВыбранных.Добавить(Стр.ВидДокумента); 
		КонецЕсли; 
	КонецЦикла;
	Закрыть(МассивВыбранных);
	

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Для каждого Док из Метаданные.Документы Цикл
		НовСтр = ВидыДокументов.Добавить(); 
		НовСтр.ВидДокумента = Док.Синоним;
	
	КонецЦикла;

	Если Параметры.Свойство("СписокДок") тогда
		МассивДок = СтрРазделить(Параметры.СписокДок,";", Ложь);
		Для каждого Эл из МассивДок Цикл
			ОтборСтрок = Новый Структура("ВидДокумента",Эл);
			СтрокаДок = ВидыДокументов.НайтиСтроки(ОтборСтрок);
			Если СтрокаДок.Количество() > 0 Тогда
				СтрокаДок[0].Использовать = Истина;
			КонецЕсли;
		КонецЦИкла;
	КонецЕсли;
	
	//Евросиб Коханенко Н.А. #61705 08.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 08.12.2022 )

КонецПроцедуры

