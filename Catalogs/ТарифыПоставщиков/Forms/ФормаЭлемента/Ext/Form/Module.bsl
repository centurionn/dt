&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Объект.НачалоДействия = ПериодДействия.ДатаНачала;
	Объект.ОкончаниеДействия = ПериодДействия.ДатаОкончания;
	
	Объект.ТипыТС.Очистить();
	Объект.ТипыТЕ.Очистить();
	Объект.РазмерыКТК.Очистить();
	
	Для каждого Стр из ТипыТС Цикл
		Объект.ТипыТС.Добавить().ТипТС = Стр.Значение;
	КонецЦикла;
	Для каждого Стр из ТипыТЕ Цикл
		Объект.ТипыТЕ.Добавить().ТипТЕ = Стр.Значение;
	КонецЦикла;
	Для каждого Стр из РазмерыКТК Цикл
		Объект.РазмерыКТК.Добавить().РазмерКТК = Стр.Значение;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьПодсказку();
	Элементы.ГруппаЛичныеЦели.Заголовок = "Личные цели ("+Объект.ЛичныеЦели.Количество()+")";
	
КонецПроцедуры

&НаКлиенте
Процедура ЛичныеЦелиОтметкаПриИзменении(Элемент)
	
	ТекД = Элементы.ЛичныеЦели.ТекущиеДанные;
	Если ТекД <> неопределено Тогда
		
		ТекПользователь = ПользователиКлиент.ТекущийПользователь();
		МоиГруппы = Пользователи_sd_сервер.ПолучитьСписокМоихГрупп(ТекПользователь);
		МоиГруппы.Добавить(ТекПользователь);
		
		ИмеюПравоМенять = (МоиГруппы.найти(ТекД.Исполнитель) <> неопределено);
		
		Если ИмеюПравоМенять Тогда
			ТекД.ДатаОтметки = ТекущаяДата();
			ТекД.Исполнитель = ТекПользователь;
		Иначе
			ТекД.Отметка = НЕ ТекД.Отметка;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

