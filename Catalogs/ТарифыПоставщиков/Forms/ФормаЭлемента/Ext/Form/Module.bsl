&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПериодДействия.ДатаНачала = Объект.НачалоДействия;
	ПериодДействия.ДатаОкончания = Объект.ОкончаниеДействия;
	ТипыТС.ЗагрузитьЗначения(Объект.ТипыТС.Выгрузить().ВыгрузитьКолонку("ТипТС"));
	ТипыТЕ.ЗагрузитьЗначения(Объект.ТипыТЕ.Выгрузить().ВыгрузитьКолонку("ТипТЕ"));
	РазмерыКТК.ЗагрузитьЗначения(Объект.РазмерыКТК.Выгрузить().ВыгрузитьКолонку("РазмерКТК"));
	
	ДоступныеЛичныеЦели = ЛичныеЦелиСервер.ПолучитьДействующиеЦелиДляРучнойОтметки(Объект.Ссылка);
	Для каждого Стр из ДоступныеЛичныеЦели Цикл
		НСтр = Объект.ЛичныеЦели.Добавить();
		ЗаполнитьЗначенияСвойств(НСтр, Стр);
	КонецЦикла;
	
	
	//Евросиб Коханенко Н.А. #61705 08.12.2022 (
