	//(
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.ПунктНазначения = Справочники.Локации.ПустаяСсылка();
		Объект.ПунктОтправления = Справочники.Локации.ПустаяСсылка();
	КонецЕсли;
	//)
	//Евросиб - АСуслов 28.06.2023 11:25:46 #локации

КонецПроцедуры

