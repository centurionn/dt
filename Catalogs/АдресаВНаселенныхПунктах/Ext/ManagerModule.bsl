Функция ПолучитьЗначениеТопонима(СсылкаНаАдрес, ВидТопонима) Экспорт 
	Если СсылкаНаАдрес = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	АдресаВНаселенныхПунктахКомпонентыАдреса.Имя КАК Имя,
		|	АдресаВНаселенныхПунктахКомпонентыАдреса.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	Справочник.АдресаВНаселенныхПунктах.КомпонентыАдреса КАК АдресаВНаселенныхПунктахКомпонентыАдреса
		|ГДЕ
		|	АдресаВНаселенныхПунктахКомпонентыАдреса.Ссылка = &Ссылка
		|	И АдресаВНаселенныхПунктахКомпонентыАдреса.ВидНайденногоТопонима = &ВидТопонима
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки УБЫВ";
	Запрос.УстановитьПараметр("ВидТопонима", ВидТопонима);
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаАдрес);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий(); 
		Результат = Выборка.Имя; 
	Иначе
		Результат = Неопределено;
	КонецЕсли; 
	Возврат Результат;
КонецФункции
