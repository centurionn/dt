Функция НайтиСоздатьАдресВНаселенномПункте(Адрес, НаселенныйПункт, КомпонентыАдреса, Широта = 0, Долгота = 0) Экспорт
//Евросиб Коханенко Н.А. 17.12.2025 )) #125251 
//АдресВНаселенномПункте = Справочники.АдресаВНаселенныхПунктах.НайтиПоРеквизиту("Адрес",Адрес,,НаселенныйПункт);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АдресаВНаселенныхПунктах.Ссылка КАК СсылкаАдрес,
	|	АдресаВНаселенныхПунктах.Владелец КАК НаселенныйПункт
	|ИЗ
	|	Справочник.АдресаВНаселенныхПунктах КАК АдресаВНаселенныхПунктах
	|ГДЕ
	|	АдресаВНаселенныхПунктах.Адрес = &Адрес
	|	И НЕ АдресаВНаселенныхПунктах.ПометкаУдаления
	|	И АдресаВНаселенныхПунктах.Владелец = &Владелец";
	Запрос.УстановитьПараметр("Адрес", Адрес);
	Запрос.УстановитьПараметр("Владелец", НаселенныйПункт);
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		АдресВНаселенномПункте = Результат.Выгрузить()[0].СсылкаАдрес;
	Иначе
		АдресВНаселенномПункте = Справочники.АдресаВНаселенныхПунктах.ПустаяСсылка();
	КонецЕсли;
	Если АдресВНаселенномПункте.Пустая() 
		И ЗначениеЗаполнено(НаселенныйПункт) Тогда
		обАдрес = Справочники.АдресаВНаселенныхПунктах.СоздатьЭлемент();
		обАдрес.Владелец = НаселенныйПункт;
		обАдрес.КомпонентыАдреса.Очистить();
		Для каждого КомпонентАдреса Из КомпонентыАдреса Цикл
			ЗаполнитьЗначенияСвойств(обАдрес.КомпонентыАдреса.Добавить(), КомпонентАдреса);
		КонецЦикла;
		обАдрес.Адрес = Адрес;
		//Евросиб Коханенко Н.А. 17.12.2025 (( #125251
		обАдрес.Широта = Широта;
		обАдрес.Долгота = Долгота;
		//Евросиб Коханенко Н.А. 17.12.2025 )) #125251 
		обАдрес.Записать();
		АдресВНаселенномПункте = обАдрес.Ссылка;
	КонецЕсли;                                  
	Возврат АдресВНаселенномПункте;
КонецФункции

