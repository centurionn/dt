//Евросиб Коханенко Н.А. 25.11.2024 (( #96360
&НаСервере
Процедура УстановитьПризнакНеИспользовать()
	Если ЗначениеЗаполнено(Объект.ДатаНеИспользовать) Тогда
		ЭтаФорма.НеИспользовать = Истина;
	Иначе
		ЭтаФорма.НеИспользовать = Ложь;
	КонецЕсли;
КонецПроцедуры //Евросиб Коханенко Н.А. 25.11.2024 )) #96360

