&НаКлиенте
Процедура НеИспользоватьПриИзменении(Элемент)
	Если НеИспользовать Тогда 
		Если НЕ ЗначениеЗаполнено(Объект.ДатаНеИспользовать) Тогда
			Объект.ДатаНеИспользовать = ТекущаяДата();
		КонецЕсли;
	Иначе 
		Объект.ДатаНеИспользовать = Дата(1,1,1);
	КонецЕсли;
КонецПроцедуры //Евросиб Коханенко Н.А. 25.11.2024 )) #96360

