
Функция ПолучитьПредставлениеШкалы(Шкала, ИмяПоляЦена = "Цена") Экспорт
	
	СтрокиШкалы = Новый Массив;
	ШаблонСтроки = "От %1 до %2 - %3";
	Для Каждого Стр Из Шкала Цикл
		
		Если Стр.От = 0 И Стр.До = 0 Тогда
			ТекстСтавки = Строка(Стр[ИмяПоляЦена]);
		ИначеЕсли Стр.От = 0 И Стр.До <> 0 Тогда
			ТекстСтавки = СтрШаблон("От 0 до %1 - %2", Стр.До, Стр[ИмяПоляЦена]);
		ИначеЕсли Стр.От <> 0 И Стр.До <> 0 Тогда
			ТекстСтавки = СтрШаблон("С %1 до %2 - %3", Стр.От, Стр.До, Стр[ИмяПоляЦена]);
		ИначеЕсли Стр.От <> 0 И Стр.До = 0 Тогда
			ТекстСтавки = СтрШаблон("С %1 и далее - %2", Стр.От, Стр[ИмяПоляЦена]);
		КонецЕсли;
		
		СтрокиШкалы.Добавить(ТекстСтавки);
		
	КонецЦикла;
	
	Возврат СтрСоединить(СтрокиШкалы, Символы.ПС);
	
КонецФункции