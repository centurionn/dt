&НаСервере
Процедура ИзменитьРеквизитШаблон(Калькуляция)
	Запрос = Новый Запрос;
	Текст = 
		"ВЫБРАТЬ
		|	ПродуктыПланПродаж_Калькуляции.Ссылка КАК Ссылка
		|ИЗ
		//ДИТ Шевченко А.В. US 62360 ТА 72965 26.07.2023
		//|	Справочник.Продукты.ПланПродаж_Калькуляции КАК ПродуктыПланПродаж_Калькуляции
		|	Справочник.СервисыУчетноеНаправление.ПланПродаж_Калькуляции КАК ПродуктыПланПродаж_Калькуляции
		//ДИТ Шевченко А.В. US 62360 ТА 72965 26.07.2023
		|ГДЕ
		|	ПродуктыПланПродаж_Калькуляции.Калькуляция = &Калькуляция";

	Запрос.Текст = Текст;
	Запрос.УстановитьПараметр("Калькуляция", Калькуляция);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	КалькуляцияОбъект = Калькуляция.ПолучитьОбъект();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		КалькуляцияОбъект.Шаблон = Истина;
	Иначе
		КалькуляцияОбъект.Шаблон = Ложь;
	КонецЕсли;
	Попытка
		КалькуляцияОбъект.Записать();
	Исключение
		Сообщить("Неудалось записать документ "+Калькуляция);
	КонецПопытки;
КонецПроцедуры

