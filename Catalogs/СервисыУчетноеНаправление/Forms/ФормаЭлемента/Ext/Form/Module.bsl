&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	МассивКУдалению = Новый Массив;
	Для каждого Строка из КалькуляцииПриОткрытии Цикл
		ПОтбора = Новый Структура("Калькуляция",Строка.Калькуляция);
		НайденныеСтроки = Объект.ПланПродаж_Калькуляции.НайтиСтроки(ПОтбора);
		Если НайденныеСтроки.Количество()=0 Тогда
			ИзменитьРеквизитШаблон(Строка.Калькуляция);
			МассивКУдалению.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	Для каждого Строка из Объект.ПланПродаж_Калькуляции Цикл
		ПОтбора = Новый Структура("Калькуляция",Строка.Калькуляция);
		НайденныеСтроки = КалькуляцииПриОткрытии.НайтиСтроки(ПОтбора);
		Если НайденныеСтроки.Количество()=0 Тогда
			ИзменитьРеквизитШаблон(Строка.Калькуляция);
			НовСтрока = КалькуляцииПриОткрытии.Добавить();
			НовСтрока.Калькуляция = Строка.Калькуляция;
		КонецЕсли;
	КонецЦикла;
	Для каждого СтрокаУдалить из МассивКУдалению Цикл
		КалькуляцииПриОткрытии.Удалить(СтрокаУдалить);
	КонецЦикла;
КонецПроцедуры
//-- Зубов Task 37315 02.08.2021
