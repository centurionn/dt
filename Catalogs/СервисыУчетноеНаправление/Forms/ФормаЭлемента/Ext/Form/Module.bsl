
&НаКлиенте
Процедура ЗаполнитьПоКалькуляции(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.КалькуляцияПланаПродаж) Тогда
		Сообщить("Сначала укажите калькуляцию!");
		Возврат;
	КонецЕсли;
	
	Объект.ПланПродаж_Доходы.Очистить();
	Объект.ПланПродаж_Расходы.Очистить();
	
	ЗаполнитьПоКалькуляции_сервер();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоКалькуляции_сервер()
	
	НСтр = Объект.ПланПродаж_Доходы.Добавить();
	НСтр.СуммаОплаты40 = Объект.КалькуляцияПланаПродаж.море40_Вознаграждение + 
						Объект.КалькуляцияПланаПродаж.море40_Себестоимость + 
						Объект.КалькуляцияПланаПродаж.ММ_КалькуляцияМультимодальнойЦепочки.Итог("Итого40") +
						Объект.КалькуляцияПланаПродаж.ММ_Вознаграждение;
	НСтр.СуммаОплаты20 = Объект.КалькуляцияПланаПродаж.море20_Вознаграждение + 
						Объект.КалькуляцияПланаПродаж.море20_Себестоимость + 
						Объект.КалькуляцияПланаПродаж.ММ_КалькуляцияМультимодальнойЦепочки.Итог("Итого20") +
						Объект.КалькуляцияПланаПродаж.ММ_Вознаграждение;
	Попытка					
		// Евросиб US 86792 TA 87489 Рыбьяков К.А. 02.07.2024 (( 
		НСтр.Номенклатура = Объект.КалькуляцияПланаПродаж.ОсновнаяУслуга;
		//НСтр.Номенклатура = Объект.КалькуляцияПланаПродаж.ММ_КалькуляцияМультимодальнойЦепочки[0].ВыставляемаяУслуга;
		// Евросиб Рыбьяков К.А. 02.07.2024 ))						
	Исключение
		Сообщить("Не удалось вычислить номенклатуру выставляемой услуги. Заполните таблицу 1.3 в калькуляции.");
	КонецПопытки;
	
	Для каждого Стр из Объект.КалькуляцияПланаПродаж.ЖД_УслугиВнеСтавки Цикл
		НСтр = Объект.ПланПродаж_Доходы.Добавить();
		НСтр.Номенклатура = Стр.Услуга;
		НСтр.СрокОплаты = Стр.Договор.СрокОплаты;
		НСтр.СуммаОплаты40 = Стр.Ставка40;
		НСтр.СуммаОплаты20 = Стр.Ставка20;
	КонецЦикла;
	
	Для каждого Стр из Объект.КалькуляцияПланаПродаж.ММ_КалькуляцияМультимодальнойЦепочки Цикл
		НСтр = Объект.ПланПродаж_Расходы.Добавить();
		НСтр.Номенклатура = Стр.Услуга;
		НСтр.НоменклатурнаяГруппа = Стр.Услуга.УкрупненнаяГруппа;
		НСтр.СрокОплаты = Стр.Договор.СрокОплаты;
		НСтр.Поставщик = Стр.Поставщик;
		НСтр.Договор = Стр.Договор;
		НСтр.СуммаАванса40 = Стр.Цена40 / 100 * Стр.Договор.РазмерАванса;
		НСтр.СуммаОплаты40 = Стр.Цена40 - НСтр.СуммаАванса40;
		НСтр.СуммаАванса20 = Стр.Цена20 / 100 * Стр.Договор.РазмерАванса;
		НСтр.СуммаОплаты20 = Стр.Цена20 - НСтр.СуммаАванса20;
	КонецЦикла;
	
	Если Объект.КалькуляцияПланаПродаж.море40_Себестоимость > 0 ИЛИ Объект.КалькуляцияПланаПродаж.море20_Себестоимость > 0 Тогда
		НСтр = Объект.ПланПродаж_Расходы.Добавить();
		НСтр.Номенклатура = Константы.УслугаФрахтаДляКалькуляции.Получить();
		НСтр.НоменклатурнаяГруппа = НСтр.Номенклатура.УкрупненнаяГруппа;
		НСтр.Поставщик = Объект.КалькуляцияПланаПродаж.ПротоколСчитаетсяПоСтавкамКонтрагента;
		НСтр.СуммаОплаты40 = Объект.КалькуляцияПланаПродаж.море40_Себестоимость;
		НСтр.СуммаОплаты20 = Объект.КалькуляцияПланаПродаж.море20_Себестоимость;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ПланПродаж_КалькуляцииКалькуляцияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОпОп = Новый ОписаниеОповещения("ВыборКалькуляции", ЭтаФорма);
	ПараметрыФормы = Новый Структура("ПоказКалькуляций", 1);
	Если ЗначениеЗаполнено(Элементы.ПланПродаж_Калькуляции.ТекущиеДанные.Клиент) Тогда
		ПараметрыФормы.Вставить("Клиент", Элементы.ПланПродаж_Калькуляции.ТекущиеДанные.Клиент);
	КонецЕсли;
	
	//ДИТ Пак И.Т. Task34426 21.05.2021 Начало
	ПараметрыФормы.Вставить("ВызовИзПродукта", Истина);
	//ДИТ Пак И.Т. Task34426 21.05.2021 Конец
	
	ОткрытьФорму("Документ.Калькуляция.ФормаВыбора", ПараметрыФормы, , ЭтаФорма.УникальныйИдентификатор,,,ОпОп,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборКалькуляции(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если параметр1 = неопределено Тогда Возврат; КОнецЕсли;
	Элементы.ПланПродаж_Калькуляции.ТекущиеДанные.Калькуляция = Параметр1;
	
КонецПроцедуры


