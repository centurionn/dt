&НаКлиенте
Процедура УдалитьМаршрутизацию(Команда)
	
	ОткрытаяСтраница = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;

	
	Если ОткрытаяСтраница = "ГруппаНастройкаДокументов" Тогда
		ТекТбл = "ТребуемыеДокументы";
	Иначе
		ТекТбл = "ПостановкаЗадач";
	КонецЕсли;
	
	ТекД = Элементы[ТекТбл].ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ГУИДТребуемыеДокументы",ТекД.ГУИД);
	
	НайденныеСтр = Объект.ДополнительныеУсловия.НайтиСтроки(ПараметрыОтбора);
	Для Каждого Стр Из НайденныеСтр Цикл
		Объект.ДополнительныеУсловия.Удалить(Стр);
	КонецЦикла;
	
	//НайденныеСтр = Объект.Отделы.НайтиСтроки(ПараметрыОтбора);
	//Для Каждого Стр Из НайденныеСтр Цикл
	//	Объект.Отделы.Удалить(Стр);
	//КонецЦикла;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ГУИД",ТекД.ГУИД);
	
	НайденныеСтр = Объект[ТекТбл].НайтиСтроки(ПараметрыОтбора);
	Для Каждого Стр Из НайденныеСтр Цикл
		Объект[ТекТбл].Удалить(Стр);
	КонецЦикла;

	
КонецПроцедуры

