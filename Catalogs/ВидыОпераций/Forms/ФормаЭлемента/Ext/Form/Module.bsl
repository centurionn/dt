&НаСервере
Процедура ОбновитьДанныеПоСпискам()
	
	Для Каждого СтрТД Из Объект.ТребуемыеДокументы ЦИкл
		
		ГУИД = СтрТД.ГУИД;
		
		СписокДопУсловий = Новый СписокЗначений;
		Для Каждого Стр ИЗ Объект.ДополнительныеУсловия Цикл
			Если Стр.ГУИДТребуемыеДокументы = ГУИД Тогда
				СписокДопУсловий.Добавить(Стр.ДопУсловиеНаименование);
			КонецЕсли;
		КонецЦикла;
		СтрТД.ДопУсловия = СписокДопУсловий;
		
	КонецЦикла;
			
	Для Каждого СтрПЗ Из Объект.ПостановкаЗадач ЦИкл
		
		ГУИД = СтрПЗ.ГУИД;
		
		СписокДопУсловий = Новый СписокЗначений;
		Для Каждого Стр ИЗ Объект.ДополнительныеУсловия Цикл
			Если Стр.ГУИДТребуемыеДокументы = ГУИД Тогда
				СписокДопУсловий.Добавить(Стр.ДопУсловиеНаименование);
			КонецЕсли;
		КонецЦикла;
		СтрПЗ.ДопУсловия = СписокДопУсловий;
		
		//СписокОтделов = Новый СписокЗначений;
		//Для Каждого Стр ИЗ Объект.Отделы Цикл
		//	Если Стр.ГУИДТребуемыеДокументы = ГУИД Тогда
		//		СписокОтделов.Добавить(Стр.НаименованиеОтдела);
		//	КонецЕсли;
		//КонецЦикла;
		//СтрПЗ.Отделы = СписокОтделов;
		
	КонецЦикла;
	
КонецПроцедуры

