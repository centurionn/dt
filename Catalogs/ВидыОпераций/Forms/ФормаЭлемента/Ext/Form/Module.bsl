
&НаКлиенте
Процедура ДобавитьМаршрутизацию(Команда)
	
	ОткрытаяСтраница = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ТипСоздаваемогоОбъекта",ОткрытаяСтраница);
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаСозданияМаршрутизации", Этаформа, ПараметрыОткрытия);
	ОткрытьФорму("Обработка.НастройкаМаршрутизации.Форма",ПараметрыОткрытия,, ЭтаФорма.УникальныйИдентификатор, ,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаСозданияМаршрутизации(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Параметр2.ТипСоздаваемогоОбъекта = "ГруппаНастройкаДокументов" Тогда
		ТекТбл = "ТребуемыеДокументы";
	Иначе
		ТекТбл = "ПостановкаЗадач";
	КонецЕсли;
	
	НовСтр = Объект[ТекТбл].Добавить();
	ЗаполнитьЗначенияСвойств(НовСтр,Параметр1);
	ГУИД = Новый УникальныйИдентификатор;
	НовСтр.ГУИД = ГУИД;
	
	СписокДопУсловий = Новый СписокЗначений;
	Для Каждого Стр ИЗ Параметр1.ДополнительныеУсловия Цикл
		НовСтр2 = Объект.ДополнительныеУсловия.Добавить();
	    НовСтр2.ДопУсловиеНаименование = Стр.Условие;
		НовСтр2.ГУИДТребуемыеДокументы = ГУИД;
		
		СписокДопУсловий.Добавить(Стр.Условие);
	КонецЦикла;
	НовСтр.ДопУсловия = СписокДопУсловий;
	
	// отделы заполняются только для настройки задач
	//Если Параметр2.ТипСоздаваемогоОбъекта = "ГруппаНастройкаЗадач" Тогда
	//	СписокОтделов = Новый СписокЗначений;
	//	Для Каждого Стр ИЗ Параметр1.ОтделОтветственные Цикл
	//		НовСтр2 = Объект.Отделы.Добавить();
	//	    НовСтр2.НаименованиеОтдела = Стр.НаименованиеОтдела;
	//		НовСтр2.ГУИДТребуемыеДокументы = ГУИД;
	//		
	//		СписокОтделов.Добавить(Стр.НаименованиеОтдела);
	//	КонецЦикла;
	//	НовСтр.Отделы = СписокОтделов;
	//КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьМаршрутизацию(Команда)
	
	ИзменитьМаршрутизациюКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьМаршрутизациюКлиент()
	
	ОткрытаяСтраница = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ТипСоздаваемогоОбъекта",ОткрытаяСтраница);

	
	Если ОткрытаяСтраница = "ГруппаНастройкаДокументов" Тогда
		ТекТбл = "ТребуемыеДокументы";
	Иначе
		ТекТбл = "ПостановкаЗадач";
	КонецЕсли;
	
	ТекД = Элементы[ТекТбл].ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураТекД = Новый Структура;
	СтруктураТекД.Вставить("ГУИД",ТекД.ГУИД);
	СтруктураТекД.Вставить("ЖелтыйПорог",ТекД.ЖелтыйПорог);
	СтруктураТекД.Вставить("КрасныйПорог",ТекД.КрасныйПорог);
	СтруктураТекД.Вставить("МоментВремени",ТекД.МоментВремени);
	СтруктураТекД.Вставить("НаименованиеЗадачиСпециалисту",ТекД.НаименованиеЗадачиСпециалисту);
	СтруктураТекД.Вставить("ПорядокТребованияДокументов",ТекД.ПорядокТребованияДокументов);
	СтруктураТекД.Вставить("ВидОперации",ТекД.ВидОперации);
	СтруктураТекД.Вставить("ЕдиницаИзмерения",ТекД.ЕдиницаИзмерения);
	СтруктураТекД.Вставить("НазначениеМаршрута",ТекД.НазначениеМаршрута);
	СтруктураТекД.Вставить("УчитыватьДляВсейОперации",ТекД.УчитыватьДляВсейОперации);
	
	МассивДопУсловий = Новый Массив;
	Для Каждого Стр Из Объект.ДополнительныеУсловия Цикл
		Если Стр.ГУИДТребуемыеДокументы = ТекД.ГУИД Тогда
			МассивДопУсловий.Добавить(Стр.ДопУсловиеНаименование);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыОткрытия.Вставить("МассивДопУсловий",МассивДопУсловий);
	
	Если ОткрытаяСтраница = "ГруппаНастройкаЗадач" Тогда
		//МассивОтделов = Новый Массив;
		//Для Каждого Стр Из Объект.Отделы Цикл
		//	Если Стр.ГУИДТребуемыеДокументы = ТекД.ГУИД Тогда
		//		МассивОтделов.Добавить(Стр.НаименованиеОтдела);
		//	КонецЕсли;
		//КонецЦикла;
		//ПараметрыОткрытия.Вставить("МассивОтделов",МассивОтделов);
		СтруктураТекД.Вставить("ТипОбъектаСистемы",ТекД.ТипОбъектаСистемы);
	Иначе
		СтруктураТекД.Вставить("ВидДокумента",ТекД.ВидДокумента);
	КонецЕсли;
	
	ПараметрыОткрытия.Вставить("ТребуемыеДокументы",СтруктураТекД);

	
	ОпОп = Новый ОписаниеОповещения("ОбработкаИзмененияМаршрутизации", Этаформа, ПараметрыОткрытия);
	ОткрытьФорму("Обработка.НастройкаМаршрутизации.Форма",ПараметрыОткрытия,, ЭтаФорма.УникальныйИдентификатор, ,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаИзмененияМаршрутизации(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ГУИД = Параметр2.ТребуемыеДокументы.ГУИД;
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ГУИД",ГУИД);
	Если Параметр2.ТребуемыеДокументы.Свойство("ТипОбъектаСистемы") Тогда
		ТекТбл = "ПостановкаЗадач";
	Иначе
		ТекТбл = "ТребуемыеДокументы";
	КонецЕсли;
	
	НайденныеСтр = Объект[ТекТбл].НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеСтр.Количество() = 0 ТОгда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(НайденныеСтр[0],Параметр1);
	
	ПараметрыОтбора2 = Новый Структура;
	ПараметрыОтбора2.Вставить("ГУИДТребуемыеДокументы",ГУИД);
	
	// удаляем старые строки по ГУИД
	НайденныеСтр2 = Объект.ДополнительныеУсловия.НайтиСтроки(ПараметрыОтбора2);
	Для Каждого Стр Из НайденныеСтр2 Цикл
		Объект.ДополнительныеУсловия.Удалить(Стр);
	КонецЦикла;
	
	//НайденныеСтр2 = Объект.Отделы.НайтиСтроки(ПараметрыОтбора2);
	//Для Каждого Стр Из НайденныеСтр2 Цикл
	//	Объект.Отделы.Удалить(Стр);
	//КонецЦикла;
	
	СписокДопУсловий = Новый СписокЗначений;
	Для Каждого Стр ИЗ Параметр1.ДополнительныеУсловия Цикл
		НовСтр2 = Объект.ДополнительныеУсловия.Добавить();
	    НовСтр2.ДопУсловиеНаименование = Стр.Условие;
		НовСтр2.ГУИДТребуемыеДокументы = ГУИД;
		
		СписокДопУсловий.Добавить(Стр.Условие);
	КонецЦикла;
	НайденныеСтр[0].ДопУсловия = СписокДопУсловий;
	
	//Если Параметр2.ТребуемыеДокументы.Свойство("ТипОбъектаСистемы") Тогда
	//	СписокОтделов = Новый СписокЗначений;
	//	Для Каждого Стр ИЗ Параметр1.ОтделОтветственные Цикл
	//		НовСтр2 = Объект.Отделы.Добавить();
	//	    НовСтр2.НаименованиеОтдела = Стр.НаименованиеОтдела;
	//		НовСтр2.ГУИДТребуемыеДокументы = ГУИД;
	//		
	//		СписокОтделов.Добавить(Стр.НаименованиеОтдела);
	//	КонецЦикла;
	//	НайденныеСтр[0].Отделы = СписокОтделов;
	//КонецЕсли;
	
КонецПроцедуры

