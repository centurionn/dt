#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если Не СравниватьВерсииОдногоОбъекта Тогда
		Для Каждого ТекСтрока Из Правила Цикл
			Если Не ЗначениеЗаполнено(ТекСтрока.РеквизитИсточника) Тогда
				ОбщегоНазначения.СообщитьПользователю(
										СтрШаблон("В строке %1 не заполнен реквизит источника.", ТекСтрока.НомерСтроки),
										ЭтотОбъект,
										ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Правила", ТекСтрока.НомерСтроки, "РеквизитИсточника"),
										,
										Отказ);
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	
	// Запретить сохранение правил с повторяющимися наборами реквизитов во всех элементах справочника,
	// т.к. на один вид объекта могут быть настроены разные правила сравнения.
	УточнениеПоиска = Новый Структура;
	УточнениеПоиска.Вставить("ВидОбъекта", ВидОбъекта);
	РаботаСТабличнымиЧастями.ПроверитьОтсутствиеДублейВТабличныхЧастяхВсехОбъектов(ЭтотОбъект, "Правила", Новый Структура("РеквизитФормы, РеквизитДокумента, РеквизитИсточника", Истина, Истина, Истина), УточнениеПоиска, Отказ);
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
