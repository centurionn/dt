#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ВидОбъекта = Параметры.ВидОбъекта;
	
	ПолноеИмяОбъекта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидОбъекта, "ПолноеИмя");
	МетаТип = Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъекта);
	
	Элементы.ОтборПоТабличнымЧастям.СписокВыбора.Добавить("Объект", "Реквизиты объекта");
	
	Для Каждого ТекРеквизит Из МетаТип.СтандартныеРеквизиты Цикл
		НоваяСтрока = РеквизитыОбъекта.Добавить();
		НоваяСтрока.ИмяРеквизита = ТекРеквизит.Имя;
		НоваяСтрока.Синоним = ?(ПустаяСтрока(ТекРеквизит.Синоним), ТекРеквизит.Имя, ТекРеквизит.Синоним);
		НоваяСтрока.ИмяТабличнойЧасти = "Объект";
	КонецЦикла;
	
	Для Каждого ТекРеквизит Из МетаТип.Реквизиты Цикл
		НоваяСтрока = РеквизитыОбъекта.Добавить();
		НоваяСтрока.ИмяРеквизита = ТекРеквизит.Имя;
		НоваяСтрока.Синоним = ТекРеквизит.Синоним;
		НоваяСтрока.ИмяТабличнойЧасти = "Объект";
	КонецЦикла;	
	
	Для Каждого ТекТабличнаяЧасть Из МетаТип.ТабличныеЧасти Цикл
		Для Каждого ТекРеквизитТЧ Из ТекТабличнаяЧасть.Реквизиты Цикл		
			НоваяСтрока = РеквизитыОбъекта.Добавить();
			НоваяСтрока.ИмяРеквизита = ТекТабличнаяЧасть.Имя + "." + ТекРеквизитТЧ.Имя;
			НоваяСтрока.Синоним = ТекРеквизитТЧ.Синоним;
			НоваяСтрока.ИмяТабличнойЧасти = ТекТабличнаяЧасть.Имя;
		КонецЦикла;
		Элементы.ОтборПоТабличнымЧастям.СписокВыбора.Добавить(ТекТабличнаяЧасть.Имя, "ТЧ: " + ТекТабличнаяЧасть.Синоним);
	КонецЦикла;
	
	РеквизитыОбъекта.Сортировать("Синоним");
	
	ОтборПоТабличнымЧастям = "Объект";
	УстановитьОтборРеквизитов();
	
	
	//Евросиб Коханенко Н.А. #61705 08.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 08.12.2022 )

КонецПроцедуры

//Евросиб Коханенко Н.А. #61705 08.12.2022 (
&НаКлиенте
Процедура ОткрытьОкноСИнструкциями(Форма, Команда)
	ИнструкцииКлиент.ОткрытьОкноСИнструкциями(ЭтаФорма, Команда);
КонецПроцедуры  
//Евросиб Коханенко Н.А. #61705 08.12.2022 )



#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ОтборПоТабличнымЧастямПриИзменении(Элемент)
	УстановитьОтборРеквизитов();
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыОбъектаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.РеквизитыОбъекта.ТекущиеДанные;
	Закрыть(ТекущиеДанные.ИмяРеквизита);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьРеквизит(Команда)
	
    ТекущиеДанные = Элементы.РеквизитыОбъекта.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Не выбран реквизит.");
		Возврат;
	КонецЕсли;	
	
	Закрыть(ТекущиеДанные.ИмяРеквизита);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьОтборРеквизитов()
	ФиксированнаяСтруктура = Новый ФиксированнаяСтруктура("ИмяТабличнойЧасти", ОтборПоТабличнымЧастям);
	Элементы.РеквизитыОбъекта.ОтборСтрок = ФиксированнаяСтруктура;
КонецПроцедуры	

#КонецОбласти