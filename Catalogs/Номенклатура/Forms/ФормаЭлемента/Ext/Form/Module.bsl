
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ЪИмя = "РазрешенныеЕИ";
	Объект[ЪИмя].Очистить();
	Для каждого Стр из РазрешенныеЕИ Цикл
		Объект[ЪИмя].Добавить().Элемент = Стр.Значение;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Объект.ДатаНеИспользовать) и Объект.НеИспользовать Тогда
		Объект.ДатаНеИспользовать = ТекущаяДата();
	КонецЕсли;
	
	// Евросиб Ситников К.А.(24.06.2025 TASK №112671)	
    Если ЗначениеЗаполнено(Объект.ЕдиницаИзмерения) Тогда
	
        ЕстьВСписке = Ложь;        
	       Для Каждого ЕИ Из Объект.РазрешенныеЕИ Цикл
	            Если ЕИ.Элемент = Объект.ЕдиницаИзмерения Тогда
	                ЕстьВСписке = Истина;
	                Прервать;
	            КонецЕсли;
	       КонецЦикла;
        
       Если ЕстьВСписке = Ложь Тогда
            Сообщение = Новый СообщениеПользователю;
            Сообщение.Текст = "Необходимо указать Единицу измерений из разрешённых";
            Сообщение.Поле = "Объект.ЕдиницаИзмерения";
            Сообщение.УстановитьДанные(ЭтотОбъект);
            Сообщение.Сообщить();
            Отказ = Истина;
       КонецЕсли;
	КонецЕсли;
    // Евросиб Ситников К.А.(24.06.2025 TASK №112671)
	
КонецПроцедуры

