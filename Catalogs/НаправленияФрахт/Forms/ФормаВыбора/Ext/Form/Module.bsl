&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Отбор.Свойство("ПунктОтправления") Тогда
		Параметры.ПрограммныйОтбор = Истина;
		Параметры.ПолеОтбора = Новый ПолеКомпоновкиДанных("ПунктОтправления");
		Параметры.Отбор.Свойство("ПунктОтправления", Параметры.ЗначениеОтбора);
	КонецЕсли;
	
	//Евросиб Коханенко Н.А. #61705 08.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 08.12.2022 )

КонецПроцедуры

