&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	// проверим содержимое полей "Адреса инструкций" в таблице
	Для Каждого стрАдреса из Объект.Адреса Цикл
		Если НРег(Лев(стрАдреса.АдресИнструкции, 8)) <> "https://" Тогда
			Сообщение = Новый СообщениеПользователю;
			ИндексСтроки = стрАдреса.НомерСтроки - 1;
			Сообщение.Поле = "Объект.Адреса["+ИндексСтроки+"].АдресИнструкции";
			Сообщение.Текст = "Некорректный адрес. Содержимое колонки ""Адрес инструкции"" в строке " 
									+ (ИндексСтроки+1) + " списка ""Адреса"" должно начинаться с ""https://""";
			Сообщение.Сообщить();
			Отказ = Истина;
			Возврат
		Иначе
			Если Лев(стрАдреса.АдресИнструкции, 8) <> "https://"  Тогда
			    стрАдреса.АдресИнструкции = "https://" + Прав(стрАдреса.АдресИнструкции, СтрДлина(стрАдреса.АдресИнструкции)-8); 
			КонецЕсли;
		КонецЕсли;
	КонецЦикла; 
КонецПроцедуры 

&НаСервере
Функция ПроверкаНаДублиНеПройдена(ТабЧасть)

	ТЗДок = ТабЧасть.Выгрузить();
	ТЗДок.Колонки.Добавить("КоличествоДублей");
	ТЗДок.ЗаполнитьЗначения(1,"КоличествоДублей");

	ТЗДок.Свернуть("ИмяФормы,НазваниеИнструкции","КоличествоДублей");
	Для каждого Стр Из ТЗДок Цикл
	   	Если Стр.КоличествоДублей > 1 тогда
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Обнаружены недопустимые совпадения в таблице для Имени формы: ""%1"" и Названия инструкции: ""%2""", 
				Стр.ИмяФормы, Стр.НазваниеИнструкции));
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	ТЗДок = ТабЧасть.Выгрузить();
	ТЗДок.Колонки.Добавить("КоличествоДублей");
	ТЗДок.ЗаполнитьЗначения(1,"КоличествоДублей");

	ТЗДок.Свернуть("ИмяФормы,АдресИнструкции","КоличествоДублей");
	Для каждого Стр Из ТЗДок Цикл
	   	Если Стр.КоличествоДублей > 1 тогда
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Обнаружены недопустимые совпадения в таблице для Имени формы: ""%1"" и Адреса инструкции: ""%2""", 
				Стр.ИмяФормы, Стр.АдресИнструкции));
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;
	
КонецФункции

