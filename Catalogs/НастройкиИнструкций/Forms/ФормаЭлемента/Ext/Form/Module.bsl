&НаСервере
Процедура ЗаполнитьСписокВыбораАдресаИмяФормыНаСервере()
	
	Элементы.АдресаИмяФормы.СписокВыбора.Очистить();
	
	//Евросиб Коханенко Н.А. #64811 27.01.2023 (( 
	Если Объект.Наименование = "" Тогда
		Возврат;
	КонецЕсли;
	//Евросиб Коханенко Н.А. #64811 27.01.2023 )) 
	
	ПредопределенныеФормыОбнаружены = Ложь;
	
	// если Справочник
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени("Справочник."+Объект.Наименование);
	Если ОбъектМетаданных <> Неопределено Тогда
		// если объект нашелся
		Для каждого Форма Из ОбъектМетаданных.Формы Цикл
        	Элементы.АдресаИмяФормы.СписокВыбора.Добавить(Форма.Имя, Форма.Имя); 
        	ПредопределенныеФормыОбнаружены = Истина;
		КонецЦикла;
		Если НЕ ПредопределенныеФормыОбнаружены Тогда
			Элементы.АдресаИмяФормы.СписокВыбора.Добавить("ФормаСписка", "ФормаСписка");  
			Элементы.АдресаИмяФормы.СписокВыбора.Добавить("ФормаОбъекта", "ФормаОбъекта");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	// если Документ
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени("Документ."+Объект.Наименование);
	Если ОбъектМетаданных <> Неопределено Тогда
		// если объект нашелся
		Для каждого Форма Из ОбъектМетаданных.Формы Цикл
        	Элементы.АдресаИмяФормы.СписокВыбора.Добавить(Форма.Имя, Форма.Имя); 
        	ПредопределенныеФормыОбнаружены = Истина;
		КонецЦикла;
		Если НЕ ПредопределенныеФормыОбнаружены Тогда
		    Элементы.АдресаИмяФормы.СписокВыбора.Добавить("ФормаДокумента", "ФормаДокумента");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	// если Отчет
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени("Отчет."+Объект.Наименование);
	Если ОбъектМетаданных <> Неопределено Тогда
		// если объект нашелся
		Для каждого Форма Из ОбъектМетаданных.Формы Цикл
        	Элементы.АдресаИмяФормы.СписокВыбора.Добавить(Форма.Имя, Форма.Имя); 
			Если Форма.Имя = "ФормаОтчета" Тогда
				ПредопределенныеФормыОбнаружены = Истина;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ПредопределенныеФормыОбнаружены Тогда
			//Евросиб Коханенко Н.А. #65974 20.02.2023 (( 
			//Элементы.АдресаИмяФормы.СписокВыбора.Добавить("ОбщаяФорма", "ОбщаяФорма");
			Элементы.АдресаИмяФормы.СписокВыбора.Добавить("ФормаОтчета", "ФормаОтчета");
			//Евросиб Коханенко Н.А. #65974 20.02.2023 )) 
		КонецЕсли;
		Возврат;
		//КонецЕсли;
	КонецЕсли;
	
	// если Обработка
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени("Обработка."+Объект.Наименование);
	Если ОбъектМетаданных <> Неопределено Тогда
		// если объект нашелся
		Для каждого Форма Из ОбъектМетаданных.Формы Цикл
        	Элементы.АдресаИмяФормы.СписокВыбора.Добавить(Форма.Имя, Форма.Имя); 
        	ПредопределенныеФормыОбнаружены = Истина;
		КонецЦикла;
		Если НЕ ПредопределенныеФормыОбнаружены Тогда
		    Элементы.АдресаИмяФормы.СписокВыбора.Добавить("ФормаОбработки", "ФормаОбработки");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	//Евросиб Коханенко Н.А. #64811 27.01.2023 (( 
	// если Общая форма
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени("ОбщаяФорма."+Объект.Наименование); 
	Если ОбъектМетаданных <> Неопределено Тогда
		// если объект нашелся
		// то у него нет подчиненных форм, поэтому берем имя самой общей формы
		Элементы.АдресаИмяФормы.СписокВыбора.Добавить(ОбъектМетаданных.Имя, ОбъектМетаданных.Имя);
	КонецЕсли;
	//Евросиб Коханенко Н.А. #64811 27.01.2023 )) 

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)  
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиИнструкций.Наименование КАК Наименование,
		|	НастройкиИнструкций.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.НастройкиИнструкций КАК НастройкиИнструкций
		|ГДЕ
		|	НастройкиИнструкций.Наименование = &Наименование
		|	И 
		|	НастройкиИнструкций.Ссылка <> &Ссылка";
	
	Запрос.УстановитьПараметр("Наименование", ТекущийОбъект.Наименование);
	Запрос.УстановитьПараметр("Ссылка", ТекущийОбъект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю("В справочнике уже существует запись для объекта " + ТекущийОбъект.Наименование);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
    
	// проверим на дубли комбинаций ИмяФормы + НазваниеИнструкции и ИмяФормы + АдресИнструкции
	Если ПроверкаНаДублиНеПройдена(ТекущийОбъект.Адреса) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
КонецПроцедуры

