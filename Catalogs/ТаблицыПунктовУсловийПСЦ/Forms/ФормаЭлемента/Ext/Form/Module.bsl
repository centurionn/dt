//Евросиб Коханенко Н.А. 01.11.2024 (( #92915 
&НаСервере
Процедура ЗаписатьМакет(ТабДок); 
	
	Если ТабДок = Неопределено Тогда
		ЕстьМакет = Ложь;
	Иначе
		ЭтаФорма.МакетТаблицыВоВремХранилище = ПоместитьВоВременноеХранилище(ТабДок, УникальныйИдентификатор);
		ЕстьМакет = Истина;
		Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры //Евросиб Коханенко Н.А. 30.10.2024 )) #92915  

//Евросиб Коханенко Н.А. 01.11.2024 (( #92915 
&НаСервере
Функция ПолучитьМакет();
	
	ТабДок = Неопределено;
	
	Если ЭтоАдресВременногоХранилища(ЭтаФорма.МакетТаблицыВоВремХранилище) Тогда
			ТабДок = ПолучитьИзВременногоХранилища(ЭтаФорма.МакетТаблицыВоВремХранилище);
	ИначеЕсли ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		Хранилище = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "Макет");
		ТабДок = Хранилище.Получить();
	КонецЕсли;
		
	Если ТабДок = Неопределено Тогда
		ТабДок = Справочники.ТаблицыПунктовУсловийПСЦ.ПолучитьМакет("ПФ_MXL_Нотис_ШаблонТаблицы");
	КонецЕсли;

	Возврат ТабДок;
	
КонецФункции //Евросиб Коханенко Н.А. 30.10.2024 )) #92915


//Евросиб Коханенко Н.А. 01.11.2024 (( #92915 
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ЭтоАдресВременногоХранилища(ЭтаФорма.МакетТаблицыВоВремХранилище) Тогда
		ТабДок = ПолучитьИзВременногоХранилища(ЭтаФорма.МакетТаблицыВоВремХранилище);
		ТекущийОбъект.Макет = Новый ХранилищеЗначения(ТабДок, Новый СжатиеДанных(9));
		ТекущийОбъект.ЕстьМакет = Истина;
	КонецЕсли;
	
КонецПроцедуры //Евросиб Коханенко Н.А. 30.10.2024 )) #92915

