&НаКлиенте
Процедура ОткрытьРедакторТаблиц(Команда)
	
	ТабДок = ПолучитьМакет();
	
	ОпОп = Новый ОписаниеОповещения("ВыполнитьПослеОкончанияРедактированияМакета", ЭтаФорма);
		
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ТабличныйДокумент", ТабДок);
	ПараметрыОткрытия.Вставить("ТипМакета", "MXL");
	ПараметрыОткрытия.Вставить("Редактирование", Истина);
	ПараметрыОткрытия.Вставить("НеПредлагатьСохранениеВФайл", Истина);
	ТабДок = ОткрытьФорму("ОбщаяФорма.РедактированиеТабличногоДокумента", ПараметрыОткрытия,, ЭтаФорма.УникальныйИдентификатор,,, ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
КонецПроцедуры //Евросиб Коханенко Н.А. 30.10.2024 )) #92915  

