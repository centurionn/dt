Функция ПолучитьСсылкуПоКодуИУровню(Код,Уровень) Экспорт //Евросиб Шевченко А.В. US 124456 TA 125854 10.12.2025
	
	ПустойОтвет = Справочники.ГрузыПоТНВЭД.ПустаяСсылка();
	
	Попытка
		Уровень = Число(Уровень);
	Исключение
		Уровень = 0;
	КонецПопытки;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ГрузыПоТНВЭД.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ГрузыПоТНВЭД КАК ГрузыПоТНВЭД
		|ГДЕ
		|	ГрузыПоТНВЭД.ТНВЭД = &Код
		|	И ГрузыПоТНВЭД.УровеньВГруппе = &Уровень
		|	И НЕ ГрузыПоТНВЭД.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Код", Код);
	Запрос.УстановитьПараметр("Уровень", Уровень);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Возврат ПустойОтвет;
	
КонецФункции	


