Функция СоздатьАктуализироватьКарточкуТНВЭД(СтрокаЭлемента) Экспорт
	
	parentid 	= СтрокаЭлемента.parentid;
	id 			= СтрокаЭлемента.id;
	level 		= СтрокаЭлемента.level;
	code 		= СтрокаЭлемента.code;
	version 	= СтрокаЭлемента.version;
	value 		= СтрокаЭлемента.value;
	//Евросиб Шевченко А.В. US 124456 TA 125854 10.12.2025
	//Объект  = ПолучитьЭлементПоСтороннемуИдентификатору(id, Истина);
	ОбъектСсылка = СтрокаЭлемента.ОбъектСсылка;
	//Евросиб Шевченко А.В. US 124456 TA 125854 10.12.2025
	Если ОбъектСсылка = Неопределено Тогда
        Объект = Справочники.ГрузыПоТНВЭД.СоздатьЭлемент();
	Иначе
		Объект = ОбъектСсылка.ПолучитьОбъект();
	КонецЕсли;	
	Объект.Наименование = СокрЛП(СТРЗаменить(value,Символы.ПС," "));
	Объект.ТНВЭД = code;
	//Объект.СтороннийИдентификатор = СтрЗаменить(Строка(id),Символы.НПП,"");
	//Евросиб Шевченко А.В. US 124456 TA 125854 10.12.2025
	Если ЗначениеЗаполнено(level) Тогда
		Объект.УровеньВГруппе = level;
	Иначе
		Объект.УровеньВГруппе = 0;
	КонецЕсли;	
	//Если ЗначениеЗаполнено(parentid) Тогда
	//	Объект.Родитель = ПолучитьЭлементПоСтороннемуИдентификатору(СтрЗаменить(Строка(parentid),Символы.НПП,""));
	//КонецЕсли;
	Если ЗначениеЗаполнено(parentid) Тогда
		Объект.Родитель = СтрокаЭлемента.Родитель;
	КонецЕсли;
	//Евросиб Шевченко А.В. US 124456 TA 125854 10.12.2025
	Объект.Записать();
	
	Возврат Объект.Ссылка;
	
КонецФункции 

