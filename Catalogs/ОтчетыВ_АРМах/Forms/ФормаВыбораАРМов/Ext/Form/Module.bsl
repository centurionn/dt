
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СписокДоступныхАРМов.Очистить();
	
	Для Каждого ФормаАРМ Из Метаданные.ОбщиеФормы Цикл
		Если СтрНачинаетсяС(ФормаАРМ.Имя,"АРМ_") Тогда
			Стр = СписокДоступныхАРМов.Добавить();
			Стр.НаименованиеАРМа = ФормаАРМ.Синоним;
			Стр.НаименованиеАРМаВСистеме = ФормаАРМ.Имя;
		КонецЕсли;
	КонецЦикла;
	
	
	//Евросиб Коханенко Н.А. #61705 08.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 08.12.2022 )

КонецПроцедуры

