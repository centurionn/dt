&НаСервере
Процедура ЗаполнитьТекстЗапросаДинамическогоСписка()
    // Евросиб Фролов (06.12.2021 TASK№ №42618, РелизКлиента

	// Меняем текст запроса списка, чтобы в полях выборки появились нужные для отбора поля.
	// В запрос через свойства изменения не стал вносить чтобы не замедлять отрытие формы выбора
	// (т.к. не всегда нужны эти поля).
	ТексЗапроса = Список.ТекстЗапроса;
	
	ТексЗапроса = СтрЗаменить(ТексЗапроса, "ИЗ", "%1 ИЗ");
	ТексЗапроса = ТексЗапроса + "%2";
	
	ПоляВЗапрос = "";
	ТаблицыВЗапрос = "";
	
	ПоляВЗапрос = ПоляВЗапрос + ",
		|	
		|	ЕСТЬNULL(стоки_ТекущиеДанныеСрезПоследних.тек_ВидСобственности, ЗНАЧЕНИЕ(Перечисление.ВариантыСобственности.ПустаяСсылка)) КАК ВариантСобственности,
		|	ЕСТЬNULL(стоки_ТекущиеДанныеСрезПоследних.тек_Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыКТК.ПустаяСсылка)) КАК Состояние";
		
	ТаблицыВЗапрос = ТаблицыВЗапрос + "
		|	
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.стоки_ТекущиеДанные.СрезПоследних() КАК стоки_ТекущиеДанныеСрезПоследних
		|		ПО СправочникТЕ.Ссылка = стоки_ТекущиеДанныеСрезПоследних.КТК";

	Список.ТекстЗапроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		ТексЗапроса,
		ПоляВЗапрос,
		ТаблицыВЗапрос);
	// Евросиб Фролов)
КонецПроцедуры	
