
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Список.Параметры.УстановитьЗначениеПараметра("Сегодня", ТекущаяДата());
	Если Параметры.Свойство("МножественныйВыбор") И Параметры.МножественныйВыбор = Истина Тогда
		Элементы.Список.МножественныйВыбор = Истина;
	КонецЕсли;
	
	// Евросиб Фролов (06.12.2021 TASK№ №42618, РелизКлиента
	Если Параметры.Свойство("Отбор") Тогда
		
		Если Параметры.Отбор.Свойство("ВариантСобственности")
			И Параметры.Отбор.Свойство("Статус") Тогда
		    // По наличию в отборе полей "Вариант собственности" и "Статус" понимаем, что
			// пришли сюда из формы доккумента "Релиз клиента".
			ЗаполнитьТекстЗапросаДинамическогоСписка();
		КонецЕсли;
	КонецЕсли;
	// Евросиб Фролов)
	
	
	//Евросиб Коханенко Н.А. #61705 08.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 08.12.2022 )
 	//Евросиб - АСуслов 04.07.2023 17:55:09 #67501 локации
	//(
	РаботаСФормамиСервер.УстановитьОграничениеНаВыборПомеченныхНаУдалениеЭлементов(Список);
	//)
	//Евросиб - АСуслов 04.07.2023 17:55:09 #67501 локации

КонецПроцедуры

