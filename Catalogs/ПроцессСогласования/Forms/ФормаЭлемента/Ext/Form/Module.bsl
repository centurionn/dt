Перем ЗакрытиеРазрешено;

&НаКлиенте
Процедура ДокументПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Объект.ДокументСогласования) Тогда
		Объект.Наименование = Строка(Объект.ДокументСогласования);
	КонецЕсли;

	//ДИТ Мамедов Э.Т. Ticket#0268161 US 51931 29.03.2024 Начало
	ДИТ_ЗаполнитьКатегориюДоговора();
	Если Не ЗначениеЗаполнено(ЭтаФорма.ДИТ_КатегорияДоговора) Тогда 
		Элементы.ПолеДИТ_КатегорияДоговора.Видимость = Ложь;
		Элементы.ПолеДИТ_ФормаДоговора.Видимость = Ложь;
	Иначе
		Элементы.ПолеДИТ_КатегорияДоговора.Видимость = Истина;
		Элементы.ПолеДИТ_ФормаДоговора.Видимость = Истина;
	КонецЕсли;
	//ДИТ Мамедов Э.Т. Ticket#0268161 US 51931 29.03.2024 Конец

КонецПроцедуры

&НаКлиенте
Процедура НовыйЦикл(Команда)
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаНовыйЦикл", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Начать новый цикл?", Режим);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаНовыйЦикл(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	НовыйЦиклНачать();
	Записать();
	
КонецПроцедуры

&НаКлиенте
Процедура НажалиОКВПредупрежденииОБлокировке(П1 = неопределено) Экспорт
	
	Модифицированность = Ложь;
	ЭтаФорма.Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПроверкаУдаленнойКарточкиСогласования();
	
	//Если ЗначениеЗаполнено(ТекстСообщения) Тогда
	//	ОпОп = Новый ОписаниеОповещения("НажалиОКВПредупрежденииОБлокировке", ЭтаФорма);
	//	ПоказатьПредупреждение(ОпОп, ТекстСообщения);
	//	Возврат;
	//КонецЕсли;
	
	Если Объект.Состояния.Количество() = 0 Тогда
		ТекущийЦикл = 0;
		Возврат;
	КонецЕсли;
	
	// свернем все строки, у которых шагцикла менее текущего. имеет смысл делать это только если
	// есть более одного цикла согласований
	//Если ТекущийЦикл>1 Тогда
	//	СвернутьДерево(ТЗСостояния);
	//	РазвернутьДерево(ТЗСостояния);
	//КонецЕсли;
	
	ЭтаФорма.ТолькоПросмотр = Объект.СогласованиеЗавершено И НЕ РольДоступнаАдмин;
	
	ХранилищеФайла = ПолучитьДанныеХранилища();
	
	СоздатьЗакладки(ХранилищеФайла);
	
	#ЕСЛИ НЕ ВебКлиент ТОГДА
	// для первой страницы открыть файл, остальные по факту смены страниц. 
	// если закладка с типовым договором видна, то не нужно загружать первый документ
	Если Элементы.Группа10.Видимость = Ложь И ХранилищеФайла.Количество()>0 Тогда
		Элем = ХранилищеФайла[0];
		
		ТекЗакладка = ПолучитьСтрокуГУИД(Элем.Ссылка);
		
		ПараметрыО = Новый Структура;
		ПараметрыО.Вставить("ТекЗакладка",ТекЗакладка);
		ПараметрыО.Вставить("ИмяФайла",Строка(Элем.Наименование)+"."+Строка(Элем.Расширение));
		ОпОп = Новый ОписаниеОповещения("ПолученФайл", ЭтаФорма,ПараметрыО);
		РаботаСФайламиКлиент.ПолучитьПрисоединенныйФайл(ОпОп, Элем.Ссылка,ЭтаФорма.УникальныйИдентификатор,неопределено);
	КонецЕсли;
	#КонецЕсли
	
	Если Объект.СогласованиеЗавершено И НЕ РольДоступнаАдмин Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
		Элементы.Группа6.Доступность = Ложь;
		Элементы.Группа9.Доступность = Ложь;
	Иначе
		АвтозаполнениеРеквизитами(неопределено);
	КонецЕсли;
	//Евросиб - АСуслов 25.03.2022 12:00:16 #
	//(
	УстановитьВидимостьДоступность();
	//)
	//Евросиб - АСуслов 25.03.2022 12:00:16 #
КонецПроцедуры                       

