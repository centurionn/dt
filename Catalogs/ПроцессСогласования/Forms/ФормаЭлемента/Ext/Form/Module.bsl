&НаКлиенте
Процедура ОтветыНаЗамечания(Команда)
	
	ПараметрЪ = Новый Массив;
	Для каждого Стр из ТЗСостояния Цикл
		ПараметрЪ.Добавить(Новый Структура("Состояние, СтатусСогласования, Исполнитель, Комментарий, ОтветИнициатора", Стр.Состояние, Стр.СтатусСогласования, Стр.Исполнитель, Стр.Комментарий, Стр.ОтветИнициатора));
	КонецЦикла;
	ОпОп = Новый ОписаниеОповещения("ОбработкаРезультатовРедактирования", ЭтаФорма);
	
	ИнициаторЪ = неопределено;
	Если ТЗСостояния.Количество() > 0 Тогда
		ИнициаторЪ = ТЗСостояния[ТЗСостояния.Количество()-1].Исполнитель;
	КонецЕсли;
	
	ОткрытьФорму("Справочник.ПроцессСогласования.Форма.ФормаОтветовНаЗамечания", Новый Структура("ТаблицаСостояний, Инициатор", ПараметрЪ, ИнициаторЪ),, ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаРезультатовРедактирования(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = неопределено Тогда Возврат; КонецЕсли;
	Для каждого Стр_П из П1 Цикл
		
		Для каждого Стр_ТЧ из ТЗСостояния Цикл
			
			Если Стр_ТЧ.Состояние = Стр_П.Состояние Тогда 
				Стр_ТЧ.ОтветИнициатора = Стр_П.ОтветИнициатора; 
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	//Евросиб Каблов 21.02.2025 ( #97984
	Модифицированность = Истина;
	//Евросиб Каблов 21.02.2025 )
	
КонецПроцедуры

