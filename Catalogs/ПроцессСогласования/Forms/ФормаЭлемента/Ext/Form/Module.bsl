&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	//++ Зубов US 37680 TA 38757 18.11.2021
	Если СуществуетДругойПроцесс() Тогда
		Отказ = Истина;
		//Сообщить("Для данного документа уже создан другой Процесс согласования. Пожалуйста, закройте эту форму и повторите согласование.");
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст="Обнаружен уже запущенный процесс согласования по данному документу, обратитесь в техподдержку";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	//-- Зубов US 37680 TA 38757 18.11.2021
	
	ПолучОб = Объект.ДокументСогласования.ПолучитьОбъект();
	ТЧ = ПолучОб.Состояния;
	// создаем таблицу, куда добавить все новые строки и запомним их позицию в таблице состояний
	ТЗДобавленныхСтрок = ТЧ.ВыгрузитьКолонки();

	ПозицияПоследнего = 0;
	
	// Евросиб US 128174 TA 130483 Рыбьяков К.А. 15.03.2026 ((
	СохранитьОтветИнициатора = Справочники.ПроцессСогласования.СохранитьОтветИнициатора(Объект.ДокументСогласования);
	// Евросиб Рыбьяков К.А. 15.03.2026 ))
	
	//Для ШагЦикла = 0 По Объект.Состояния.Количество()-1 Цикл
	//	ТекСтр = Объект.Состояния[ШагЦикла];  
	//ДИТ, Беляев СЮ, BUG 73824 / TA 73826, 24-10-2023, начало (переносим данные в объект только по текущему циклу согласования)
	Для Каждого ТекСтр Из Объект.Состояния.НайтиСтроки(Новый Структура("ШагЦикла", ТекущийЦикл)) Цикл
	//ДИТ, Беляев СЮ, BUG 73824 / TA 73826, 24-10-2023, конец
		//ДИТ Авдеева В.С. 52203 30.05.22 Начало
		////ДИТ Авдеева В.С. 37680 15.04.22 Начало
		//ОбрабатыватьСтроку = (НачальныйЦикл <> ТекущийЦикл) 
		//						Или ПроверитьПользователя(ТекущийПользователь, ТекСтр.Исполнитель);
		//Если ОбрабатыватьСтроку Тогда 
		////ДИТ Авдеева В.С. 37680 15.04.22 Конец
		//ДИТ Авдеева В.С. 52203 30.05.22 Конец
			ПараметрыОтбора = Новый Структура;
			ПараметрыОТбора.Вставить("Состояние",ТекСтр.Состояние);
			НайденныеСтроки = ТЧ.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество()>0 Тогда	
				// Евросиб US 128174 TA 130483 Рыбьяков К.А. 25.02.2026 ((
				Если СохранитьОтветИнициатора Тогда
					ЗаполнитьЗначенияСвойств(НайденныеСтроки[0], ТекСтр, "ОтветИнициатора");
				КонецЕсли;
				// Евросиб Рыбьяков К.А. 25.02.2026 ))
				//ДИТ Авдеева В.С. 52203, 37680 30.05.22 Начало
				ОбрабатыватьСтроку = (НачальныйЦикл <> ТекущийЦикл) 
										Или ПроверитьПользователя(ТекущийПользователь, ТекСтр.Исполнитель);
				Если ОбрабатыватьСтроку Тогда 
				//ДИТ Авдеева В.С. 52203, 37680 30.05.22 Конец
				
					ЗаполнитьЗначенияСвойств(НайденныеСтроки[0],ТекСтр,,"НормативИсполненияСМоментаСоздания,НачалоРаботы");
					
