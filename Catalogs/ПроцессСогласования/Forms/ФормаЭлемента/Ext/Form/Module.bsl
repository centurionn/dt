&НаКлиенте
Процедура ОбновитьСведения()
	
	//ДИТ Авдеева В.С. 37680 15.04.22 Начало
	Если НачальныйЦикл <> ТекущийЦикл Тогда
	//ДИТ Авдеева В.С. 37680 15.04.22 Конец
		// удалить из основной таблицы все данные по текущему циклу
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ШагЦикла",ТекущийЦикл);
		НайденныеСтроки = Объект.Состояния.НайтиСтроки(ПараметрыОтбора);
		Для Каждого Стр Из НайденныеСтроки Цикл
			Объект.Состояния.Удалить(Стр);
		КонецЦикла;
		// перенести в основную таблицу только данные по текущему циклу
		Для Каждого Стр Из ТЗСостояния Цикл
			Если Стр.ШагЦикла = ТекущийЦикл И ЗначениеЗаполнено(Стр.Состояние) Тогда
				НовСтр = Объект.Состояния.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр,Стр);
			КонецЕсли;
		КонецЦикла;   
	//ДИТ Авдеева В.С. 37680 15.04.22 Начало
	Иначе
		Для Каждого Стр Из ТЗСостояния Цикл  
			Если Не (Стр.ШагЦикла = ТекущийЦикл И ЗначениеЗаполнено(Стр.Состояние)) Тогда
				Продолжить;
			КонецЕсли;
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("ШагЦикла",ТекущийЦикл);
			ПараметрыОтбора.Вставить("Состояние",Стр.Состояние);
			НайденныеСтроки = Объект.Состояния.НайтиСтроки(ПараметрыОтбора); 
			Если ЗначениеЗаполнено(НайденныеСтроки) 
				И ПроверитьПользователя(ПользователиКлиент.ТекущийПользователь(), Стр.Исполнитель) Тогда
				ЗаполнитьЗначенияСвойств(НайденныеСтроки[0],Стр);   
				//ДИТ Авдеева В.С. 52203 30.05.2022 Начало  
				Если Не ЗначениеЗаполнено(НайденныеСтроки[0].Наблюдатель) Тогда
					НайденныеСтроки[0].Наблюдатель = ПользователиКлиент.ТекущийПользователь();   
				КонецЕсли;
				//ДИТ Авдеева В.С. 52203 30.05.2022 Конец
			ИначеЕсли Не ЗначениеЗаполнено(НайденныеСтроки) Тогда	
				НовСтр = Объект.Состояния.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр,Стр);
				//ДИТ Авдеева В.С. 52203 30.05.2022 Начало  
				Если Не ЗначениеЗаполнено(НовСтр.Наблюдатель) Тогда
					НовСтр.Наблюдатель = ПользователиКлиент.ТекущийПользователь();   
				КонецЕсли;
				//ДИТ Авдеева В.С. 52203 30.05.2022 Конец
			//ДИТ Авдеева В.С. 51664 30.05.22 Начало
			ИначеЕсли ЗначениеЗаполнено(НайденныеСтроки) 
				И ЗначениеЗаполнено(Стр.ОтветИнициатора) Тогда
				ЗаполнитьЗначенияСвойств(НайденныеСтроки[0],Стр, "ОтветИнициатора");  
			//ДИТ Авдеева В.С. 51664 30.05.22 Конец
			КонецЕсли;
		КонецЦикла;   
	КонецЕсли;
	//ДИТ Авдеева В.С. 37680 15.04.22 Конец
	
КонецПроцедуры

