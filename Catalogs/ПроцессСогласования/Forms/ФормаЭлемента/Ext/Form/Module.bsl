&НаКлиенте
Процедура ПослеКонвертацииПдфВHTML(Результат, СписокПараметров) Экспорт
	//The Xpdf tools use the following exit codes:
	СписокОшибок = Новый Соответствие;
	СписокОшибок.Вставить(1,	"Error opening a PDF file");
