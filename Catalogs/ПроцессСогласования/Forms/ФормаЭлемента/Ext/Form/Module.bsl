&НаКлиенте
Процедура ДоступностьКнопок()
	ТекД = Элементы.ТЗСостояния.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ПроверитьПользователя(ПользователиКлиент.ТекущийПользователь(), ТекД.Исполнитель) И
		(ТекД.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.ВРаботе") ИЛИ
		ТекД.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение")) Тогда
		Элементы.Группа7.Доступность = Истина;
		Элементы.ТЗСостоянияДелегировать.Доступность = Истина;
		Элементы.ТЗСостоянияРецензирование.Доступность = Истина;
		
		//Евросиб Коханенко Н.А. 08.07.2025 (( #112281
		Если ТипЗнч(Объект.ДокументСогласования) = Тип("ДокументСсылка.ПСЦ") 
			И ТекД.Состояние = ПредопределенноеЗначение("Справочник.Состояния.ПроверкаРезультатовСогласования")
			И НЕ Объект.СогласованиеЗавершено 
			И ПроверитьДатуПСЦНаНачалоДействияУсловий(Объект.ДокументСогласования) Тогда 
			СтрокиСогласованоСЗамечаниями = ТЗСостояния.НайтиСтроки(Новый Структура("СтатусСогласования", ПредопределенноеЗначение("Перечисление.СтатусыСогласования.СогласованоСЗамечаниями")));
            //Если есть среди всех статусов согласования хотя бы один = согласовано с замечаниями, 
			Если СтрокиСогласованоСЗамечаниями.Количество() > 0  Тогда
				//тогда кнопка может быть активна и использоваться. 
				Элементы.СогласованСЗамечаниями.Доступность = Истина;
			Иначе
				// необходимо сделать неактивной кнопку "Согласовано с замечаниями"
				Элементы.СогласованСЗамечаниями.Доступность = Ложь;
			КонецЕсли;
		КонецЕсли;
		//Евросиб Коханенко Н.А. 08.07.2025 )) #112281 
	
	Иначе
		Элементы.Группа7.Доступность = Ложь;
		Элементы.ТЗСостоянияДелегировать.Доступность = Ложь;
		Элементы.ТЗСостоянияРецензирование.Доступность = Ложь;
	КонецЕсли;
	//Евросиб Шевченко А.В. US 110215 TA 122847 10.11.2025
	Если ТипЗнч(Объект.ДокументСогласования) = Тип("ДокументСсылка.ПСЦПоставщика") Тогда
		Если ПроверитьПользователя(ПользователиКлиент.ТекущийПользователь(), ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(Объект.ДокументСогласования,"Автор")) Тогда
			Если ТекД.Состояние = ПредопределенноеЗначение("Справочник.Состояния.ПроверкаСогласованияОтправкаПодкреплениеПодписанногоПСЦ") Тогда
				Элементы.Группа8.Доступность = Ложь;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
	//Евросиб Шевченко А.В. US 110215 TA 122847 10.11.2025
	Если НЕ Объект.СогласованиеЗавершено И КнопкаЗавершитьСогласование() Тогда
		ОпОп = Новый ОписаниеОповещения("ОбработкаПродолжения", ЭтаФорма);
		ОткрытьФорму("Справочник.ПроцессСогласования.Форма.ФормаДиалогаПродолжения", ,, ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Функция КнопкаЗавершитьСогласование()
	
	Элементы.ФормаЗавершитьСогласование.Доступность = Ложь;
	Элементы.ЭтапыСогласованийНовыйЦикл.Доступность = Ложь;
	
	ЗавершитьСогл = Ложь;
	
	// кнопка завершения согласования доступна только в том случае, если предыдущее состояние выполнено
	// выгружаем все строки, кроме строки с предопределенным состоянием "проверка результатов согласования".
	// ДИТ BUG 78947 Сержантова А.С. Начало: 20.12.2023
	// Было:           
	//ПараметрыОтбора = Новый Структура;
	//ПараметрыОтбора.Вставить("Состояние",ПредопределенноеЗначение("Справочник.Состояния.ПроверкаРезультатовСогласования"));
	//НайденнаяСтрока = ТЗСостояния.НайтиСтроки(ПараметрыОтбора); 
	// Стало: 
	ИскомыеСостоянияПроверкиСогласования = Новый Массив; 
	ИскомыеСостоянияПроверкиСогласования.Добавить(ПредопределенноеЗначение("Справочник.Состояния.ПроверкаРезультатовСогласования"));
	ИскомыеСостоянияПроверкиСогласования.Добавить(ПредопределенноеЗначение("Справочник.Состояния.ПроверкаСогласованияОтправкаПодкреплениеПодписанногоПСЦ")); 
	НайденнаяСтрока = Новый Массив;
	СчетчикСтрок = ТЗСостояния.Количество() - 1; 
	Пока СчетчикСтрок >= 0 Цикл
		Если ИскомыеСостоянияПроверкиСогласования.Найти(ТЗСостояния[СчетчикСтрок].Состояние) <> Неопределено Тогда
			НайденнаяСтрока.Добавить(ТЗСостояния[СчетчикСтрок]);
			Прервать;
		КонецЕсли;
		СчетчикСтрок = СчетчикСтрок - 1;
	КонецЦикла;
	// ДИТ BUG 78947 Сержантова А.С. Конец: 20.12.2023  
	Если НайденнаяСтрока.Количество()>0 Тогда
		ПоследнееСостояние = НайденнаяСтрока[0].Состояние;
		ПоследнийИсполнитель = НайденнаяСтрока[0].Исполнитель;
	Иначе
		Возврат ЗавершитьСогл;
	КонецЕсли;
	
	// ДИТ Поморцева Т.П. Задача 236586 13.07.21. начало
	СтатусДок = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(Объект.ДокументСогласования, "СтатусДокумента");
	// ДИТ Поморцева Т.П. Задача 236586 13.07.21. конец      
	// ДИТ BUG 78947 Сержантова А.С. Начало: 21.12.2023 
	ЭтоПСЦПоставщика = Ложь;
	Если ТипЗнч(Объект.ДокументСогласования) = Тип("ДокументСсылка.ПСЦ") Тогда
		ЭтоПСЦПоставщика = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(Объект.ДокументСогласования, "ПСЦПоставщика");
	//Евросиб Каблов 28.06.2024 ( #67092
	ИначеЕсли ТипЗнч(Объект.ДокументСогласования) = Тип("ДокументСсылка.ПСЦПоставщика") Тогда
		ЭтоПСЦПоставщика = Истина;
	//Евросиб Каблов 28.06.2024 )
	КонецЕсли;
	// ДИТ BUG 78947 Сержантова А.С. Конец: 21.12.2023
	
	// если пользователю назначено состояние проверка результатов, то вне зависимости от текущего статуса
	// и этапа ему доступна кнопка завершения согласования. но окно выбора дальнейшего действия не появляется 
	Если ПроверитьПользователя(ТекущийПользователь,ПоследнийИсполнитель) Тогда
		
		// ДИТ Поморцева Т.П. Задача 236586 13.07.21. начало
		Если (СтатусДок = ПредопределенноеЗначение("Перечисление.СтатусыСогласования.СогласованСКомментариями") ИЛИ 
		 СтатусДок = ПредопределенноеЗначение("Перечисление.СтатусыСогласования.СогласованоБезЗамечаний")) 
		// ДИТ Поморцева Т.П. Задача 236586 13.07.21. конец  
		// ДИТ BUG 78947 Сержантова А.С. Начало: 21.12.2023
			или (ЭтоПСЦПоставщика и СтатусДок = ПредопределенноеЗначение("Перечисление.СтатусыСогласования.Подписано")) Тогда 
		// ДИТ BUG 78947 Сержантова А.С. Конец: 21.12.2023
			ЗавершитьСогл = Ложь;
			Элементы.ФормаЗавершитьСогласование.Доступность = Истина;
		КонецЕсли;
		
		Элементы.ЭтапыСогласованийНовыйЦикл.Доступность = Истина;
	// окно выбора дальнейшего действия появляется только если выполняются условия:	
	ИначеЕсли ПоследнееСостояние = ТекущийСтатус И
		ПроверитьПользователя(ТекущийПользователь,ПоследнийИсполнитель) И
		(НЕ НайденнаяСтрока[0].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.ВРаботе") И
		НЕ НайденнаяСтрока[0].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение") И
		НЕ НайденнаяСтрока[0].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Новый")) Тогда

		// ДИТ Поморцева Т.П. Задача 236586 13.07.21. начало
		Если (СтатусДок = ПредопределенноеЗначение("Перечисление.СтатусыСогласования.СогласованСКомментариями") ИЛИ 
			СтатусДок = ПредопределенноеЗначение("Перечисление.СтатусыСогласования.СогласованоБезЗамечаний")) 
		// ДИТ Поморцева Т.П. Задача 236586 13.07.21. конец			 
		// ДИТ BUG 78947 Сержантова А.С. Начало: 21.12.2023
			или (ЭтоПСЦПоставщика и СтатусДок = ПредопределенноеЗначение("Перечисление.СтатусыСогласования.Подписано")) Тогда 
		// ДИТ BUG 78947 Сержантова А.С. Конец: 21.12.2023
			ЗавершитьСогл = Истина;
			Элементы.ФормаЗавершитьСогласование.Доступность = Истина;
		КонецЕсли;
		Элементы.ЭтапыСогласованийНовыйЦикл.Доступность = Истина;
	КонецЕсли;
		
	// пользователю с правом "dc_НастройкаМаршрутизации" и полными правами кнопка доступна на всех этапах, но окно не появляется
	//Евросиб Шевченко А.В. US 110215 TA 122847 10.11.2025
	// Евросиб US 90342 Рыбьяков К.А. 16.03.2026 ((
	Если ТипЗнч(Объект.ДокументСогласования) = Тип("ДокументСсылка.ПСЦПоставщика") 
		Или ТипЗнч(Объект.ДокументСогласования) = Тип("ДокументСсылка.РеестрСпециальныхСтавок") Тогда
	//Если ТипЗнч(Объект.ДокументСогласования) = Тип("ДокументСсылка.ПСЦПоставщика") Тогда
	// Евросиб Рыбьяков К.А. 16.03.2026 ))
		Элементы.ФормаЗавершитьСогласование.Доступность = ПолучитьРазрещениеНаЗавершение();
	Иначе
		Элементы.ФормаЗавершитьСогласование.Доступность = Элементы.ФормаЗавершитьСогласование.Доступность ИЛИ ДоступностьРоли();
	КонецЕсли;
	//Евросиб Шевченко А.В. US 110215 TA 122847 10.11.2025
	Элементы.ЭтапыСогласованийНовыйЦикл.Доступность = Элементы.ЭтапыСогласованийНовыйЦикл.Доступность ИЛИ ДоступностьРоли();
	
	Возврат ЗавершитьСогл;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДоступностьРоли()
	НужнаяРоль = Ложь;
	Если РольДоступна("dc_НастройкаМаршрутизации") ИЛИ
		РольДоступна("ПолныеПрава") Тогда
		НужнаяРоль = Истина;
	КонецЕсли;
	Возврат НужнаяРоль;
КонецФункции

&НаКлиенте
Процедура ОбработкаПродолжения(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	// если форму просто закрыли, то не нужно начинать процесс согласования
	Если Параметр1 = "Завершить" Тогда
		СогласованиеЗавершитьКлиент();
	Иначе
		НовыйЦиклНачать();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НовыйЦиклНачать()  
	
	//ДИТ Авдеева В.С. 37680 15.04.22 Начало
	ЭтаФорма.Прочитать();
	//ДИТ Авдеева В.С. 47467 17.05.22 Начало
	//ЗаполнитьТЧСостояния(ТекущийЦикл);
	//ДИТ Авдеева В.С. 47467 17.05.22 Конец
	ЗаполнитьДеревоНаСервере(Ложь);
	//ДИТ Авдеева В.С. 37680 15.04.22 Конец

	// переносим все значения из текущей таблицы состояний в основную
	ОбновитьСведения();

	// ДИТ Поморцева Т.П. Задача 0233272 28.05.21. начало
	//СохранитьРеестрРазногласий();
	
	//Евросиб СубботинВ #89527 30.10.2024 Начало // проба пера для теста
    Если НЕ ТипЗнч(Объект.ДокументСогласования) = ТИП("ДокументСсылка.РеестрПлатежей") тогда
		СохранитьРеестрРазногласийНаСервере();
	КонецЕсли;
	//Евросиб СубботинВ #89527 30.10.2024 Начало

	// ДИТ Поморцева Т.П. Задача 0233272 28.05.21. конец
	
	ТекущийЦикл = ТекущийЦикл + 1;
	ЗаполнитьТЧСостоянияСервер(ТекущийЦикл, Истина);
	ЗаполнитьДеревоНаСервере(Истина);
	
	// для договоров контрагентов и ПСЦ нужно создать заново документы (присоединенные файлы) и обновить закладки с их отображением
	
	// SIV 22-01-2020 Попросили не создавать новый комплект документов никогда
	
	//Если ТипЗнч(Объект.ДокументСогласования) = Тип("СправочникСсылка.ДоговорыКонтрагентов") ИЛИ
	//	ТипЗнч(Объект.ДокументСогласования) = Тип("ДокументСсылка.ПСЦ") Тогда	
	//	
	//	СоздатьНовыйКомлектДокументов();
	//КонецЕсли;
		

	УдалитьСтарыеЭлементы();
	
	ХранилищеФайла = ПолучитьДанныеХранилища();
	СоздатьЗакладки(ХранилищеФайла);
	
	#ЕСЛИ НЕ ВебКлиент ТОГДА
	// для первой страницы открыть файл, остальные по факту смены страниц
	Если Элементы.Группа10.Видимость = Ложь И ХранилищеФайла.Количество()>0 Тогда
		Элем = ХранилищеФайла[0];
		
		ТекЗакладка = ПолучитьСтрокуГУИД(Элем.Ссылка);
		
		ПараметрыО = Новый Структура;
		ПараметрыО.Вставить("ТекЗакладка",ТекЗакладка);
		ПараметрыО.Вставить("ИмяФайла",Строка(Элем.Наименование)+"."+Строка(Элем.Расширение));
		ОпОп = Новый ОписаниеОповещения("ПолученФайл", ЭтаФорма,ПараметрыО);
		РаботаСФайламиКлиент.ПолучитьПрисоединенныйФайл(ОпОп, Элем.Ссылка,ЭтаФорма.УникальныйИдентификатор,неопределено);
	КонецЕсли;
	#КонецЕсли
	
	Если Объект.СогласованиеЗавершено Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
		Элементы.Группа6.Доступность = Ложь;
		Элементы.Группа9.Доступность = Ложь;
	Иначе
		АвтозаполнениеРеквизитами(неопределено);
	КонецЕсли;
	
	//Если ТекущийЦикл>1 Тогда
	//	СвернутьДерево(ТЗСостояния);
	//	РазвернутьДерево(ТЗСостояния);
	//КонецЕсли;
	
	//Евросиб СубботинВ #89527 30.10.2024 Начало
	Если ТипЗнч(Объект.ДокументСогласования) = Тип("ДокументСсылка.РеестрПлатежей") Тогда
		ЗаполнитьИсториюРеквизитов(ТекущийЦикл);
	КонецЕсли;
	//Евросиб СубботинВ #89527 30.10.2024 Конец 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТЧСостоянияСервер(ТекущийЦикл, СброситьПроверку)
	
	Справочники.ПроцессСогласования.ЗаполнитьТЧСостояния(Объект, ТекущийЦикл, СброситьПроверку);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьСтарыеЭлементы()
	
	Для каждого ЭлементФ Из СписокЭФ Цикл
		Попытка
			Элементы.Удалить(Элементы.Найти(ЭлементФ.ТекЭлемент));
		Исключение
		КонецПопытки;
	КонецЦикла;
	СписокЭФ.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНовыйКомлектДокументов()
	
	Если НЕ ТиповойДокумент(Объект.ДокументСогласования) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Объект.ДокументСогласования) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Договор",Объект.ДокументСогласования);
		ПараметрыФормы.Вставить("ПроцессСогласования",Истина);
		ПараметрыФормы.Вставить("ЦиклСогласования",ТекущийЦикл);
		ОткрытьФорму("Обработка.СогласованиеДоговоров.Форма.Форма", ПараметрыФормы,, ЭтаФорма.УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ИначеЕсли ТипЗнч(Объект.ДокументСогласования) = Тип("ДокументСсылка.ПСЦ") Тогда	
		// закомментировано 09.01.2020. не создавать новые документы. только отображать
	    //СоздатьНовыеТабДоки();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТиповойДокумент(Док)
	
	ТиповойДок = Ложь;
	Если ТипЗнч(Док) = Тип("СправочникСсылка.ДоговорыКонтрагентов") И Док.Типовой Тогда
		ТиповойДок = Истина;
	ИначеЕсли ТипЗнч(Док) = Тип("ДокументСсылка.ПСЦ") И НЕ Док.НетиповойПротокол Тогда
		ТиповойДок = Истина;
	//Евросиб Каблов 28.06.2024 ( #67092
	ИначеЕсли ТипЗнч(Док) = Тип("ДокументСсылка.ПСЦПоставщика") Тогда
		ТиповойДок = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Док, "Типовой");
	//Евросиб Каблов 28.06.2024 )
	КонецЕсли;
	
	Возврат ТиповойДок;
	
КонецФункции

&НаСервере
Процедура СоздатьНовыеТабДоки()

	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(Объект.ДокументСогласования.Ссылка);
	ФорматПротокола = Объект.ДокументСогласования.ФорматПротокола;
	Если ФорматПротокола = ПредопределенноеЗначение("Перечисление.ФорматПротокола.ПротоколДвуязычный") Тогда
		ТабДок = Документы.ПСЦ.НапечататьОдноязычныйПСЦ_ПоПростомуБезЭтихВашихБСП(МассивОбъектов);
	ИначеЕсли ФорматПротокола = ПредопределенноеЗначение("Перечисление.ФорматПротокола.ПротоколОдноязычныйВаг") Тогда
		ТабДок = Документы.ПСЦ.НапечататьОдноязычный3ПСЦ_ПоПростомуБезЭтихВашихБСП(МассивОбъектов);
	ИначеЕсли ФорматПротокола = ПредопределенноеЗначение("Перечисление.ФорматПротокола.ПротоколОдноязычныйКомпл") Тогда
		ТабДок = Документы.ПСЦ.НапечататьОдноязычныйПСЦ_ПоПростомуБезЭтихВашихБСП(МассивОбъектов);
	ИначеЕсли ФорматПротокола = ПредопределенноеЗначение("Перечисление.ФорматПротокола.ПротоколОдноязычныйКТК") Тогда
		ТабДок = Документы.ПСЦ.НапечататьОдноязычный2ПСЦ_ПоПростомуБезЭтихВашихБСП(МассивОбъектов);
	КонецЕсли;
	
	ИмяФайла = ПолучитьИмяВременногоФайла("docx");
	ТабДок.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.DOCX);
	ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ИмяФайла);
	АдресВХ = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла);
	ПараметрыФайла = Новый Структура;
	ПараметрыФайла.Вставить("Автор", Пользователи.ТекущийПользователь());
	ПараметрыФайла.Вставить("ВладелецФайлов", Объект.ДокументСогласования.Ссылка);
	ПараметрыФайла.Вставить("ИмяБезРасширения",  "(" + ТекущийЦикл + ") " + "Протокол №" + Объект.ДокументСогласования.Номер + " от " + Формат(Объект.ДокументСогласования.Дата,"ДФ=dd.MM.yyyy"));
	ПараметрыФайла.Вставить("Описание", XMLСтрока(Объект.ДокументСогласования.Ссылка));
	ПараметрыФайла.Вставить("РасширениеБезТочки", "docx");
	ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное", ТекущаяДата());
		
	РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресВХ);
	
КонецПроцедуры

&НаКлиенте
Процедура СогласованиеЗавершитьКлиент()
	//Евросиб Шевченко А.В. US 110215 TA 122847 10.11.2025
	Если ТипЗнч(Объект.ДокументСогласования) <> Тип("ДокументСсылка.ПСЦПоставщика") Тогда
		Для каждого Стр из Объект.Состояния Цикл
			Если Стр.Статус <> ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Выполнен") Тогда
				Стр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Отклонен");
			КонецЕсли;
		КонецЦикла;
