&НаКлиенте
Процедура Группа4ПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница.Имя = "Группа10" тогда
		Возврат;
	КонецЕсли;
	
	ГУИДФайла = СтрЗаменить(ТекущаяСтраница.Имя,"Страница","");
	ФайлОткрыт = "Признак" + ГУИДФайла;
	// если файл уже открыт, то повторно не открываем
	Если ЭтаФорма[ФайлОткрыт] Тогда
		Возврат;
	КонецЕсли;
	
	ТекСсылкаНаФайл = ПолучитьСсылкуНаСпр(ГУИДФайла);
	
	#ЕСЛИ НЕ ВебКлиент ТОГДА
	ПараметрыО = Новый Структура;
	ПараметрыО.Вставить("ТекЗакладка",ГУИДФайла);
	ПараметрыО.Вставить("ИмяФайла",ТекущаяСтраница.Заголовок);
	ОпОп = Новый ОписаниеОповещения("ПолученФайл", ЭтаФорма,ПараметрыО);
	РаботаСФайламиКлиент.ПолучитьПрисоединенныйФайл(ОпОп, ТекСсылкаНаФайл,ЭтаФорма.УникальныйИдентификатор,неопределено);
	#КонецЕсли
	
КонецПроцедуры

