&НаКлиенте
Процедура ВыборДелегирования(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	Для Сч = 0 По ТЗСостояния.Количество()-1 Цикл
		
		Если ТЗСостояния[Сч].Состояние = ТекущийСтатус Тогда
			ЗапомнилиСвязь = ТЗСостояния[Сч].ПредыдущиеЭтапы;
			ТЗСостояния[Сч].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Новый");
			НСтр = ТЗСостояния.Вставить(Сч);
			НСтр.Состояние = ПредопределенноеЗначение("Справочник.Состояния.ДелегированноеСогласование");
			НСтр.Исполнитель = Параметр1;
			НСтр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение");
			НСтр.СтатусСогласования = ПредопределенноеЗначение("Перечисление.СтатусыСогласования.Планируется");
			НСтр.ПредыдущиеЭтапы = ЗапомнилиСвязь;
			НСтр.ШагЦикла = ТекущийЦикл;   
			//ДИТ Авдеева В.С. 52203 30.05.2022 Начало
			НСтр.Наблюдатель = ПользователиКлиент.ТекущийПользователь();
			//ДИТ Авдеева В.С. 52203 30.05.2022 Конец
			
			НомерНовойСтроки = НСтр.ПорядковыйНомер;
			Для Сч2 = Сч+1 По ТЗСостояния.Количество()-1 Цикл
				ТЗСостояния[Сч2].ПредыдущиеЭтапы = ПлюсОдин(ТЗСостояния[Сч2].ПредыдущиеЭтапы, НомерНовойСтроки);
			КонецЦикла;
			
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПлюсОдин(ПредыдущиеЭтапы, НомерНовойСтроки)
	
	НоваяСтрокаБэкапов = СтрЗаменить(ПредыдущиеЭтапы, " ", "");
	МассивЧИсле = СтрРазделить(НоваяСтрокаБэкапов, ",", Ложь);
	Для Сыч = 1 по МассивЧИсле.Количество()-1  Цикл
		Попытка
			ТекЧисло = Число(МассивЧИсле[Сыч]);
		Исключение
		КонецПопытки;
		Если ТекЧисло >= НомерНовойСтроки тогда
			МассивЧИсле[Сыч] = Строка(ТекЧисло + 1);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(МассивЧИсле, ",");
КонецФункции


