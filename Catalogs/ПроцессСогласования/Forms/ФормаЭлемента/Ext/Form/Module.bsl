&НаСервере
Процедура ПолучитьТекущийСтатус()
	
	МассивСтатусов = Новый Массив;
	МассивСтатусов.Добавить(Перечисления.СтатусыЭтапов.ВРаботе);
	МассивСтатусов.Добавить(Перечисления.СтатусыЭтапов.НаВыполнение);
	ВремТЧ = ТЗСостояния.Выгрузить();	
	
	ТекущийСтатус = Справочники.Состояния.ПустаяСсылка();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВыгрТЧ.Состояние КАК Состояние,
	               |	ВыгрТЧ.ПорядковыйНомер КАК ПорядковыйНомер,
	               |	ВыгрТЧ.Статус КАК Статус
	               |ПОМЕСТИТЬ ВТ
	               |ИЗ
	               |	&ВыгрТЧ КАК ВыгрТЧ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ.Состояние КАК Состояние,
	               |	ВТ.ПорядковыйНомер КАК ПорядковыйНомер,
	               |	ВТ.Статус КАК Статус
	               |ИЗ
	               |	ВТ КАК ВТ
	               |ГДЕ
	               |	ВТ.Статус В (&Статус)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПорядковыйНомер";
	Запрос.УстановитьПараметр("ВыгрТЧ",ВремТЧ);
	Запрос.УстановитьПараметр("Статус",МассивСтатусов);
	Если НЕ Запрос.Выполнить().Пустой() Тогда
		ТекущийСтатус = Запрос.Выполнить().Выгрузить()[0].Состояние;
	Иначе
		ВремТЧ.Сортировать("ПорядковыйНомер Убыв");
		ТекущийСтатус = ВремТЧ[0].Состояние;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоНаСервере(ЭтоНовыйЦикл)
	
	ТЗСостояния.Очистить();
	ПерваяСтр = 0;
	Для Каждого Стр Из ЭтаФорма.Объект.Состояния Цикл
		Если Стр.ШагЦикла = ТекущийЦикл Тогда
			ПерваяСтр = ПерваяСтр + 1;
			НовСтр = ТЗСостояния.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр,Стр);
			// проверим совпадение статусов с таблицей из документа согласования, но только в случае, если это НЕ новый цикл
			Если НЕ ЭтоНовыйЦикл И ЗначениеЗаполнено(Объект.ДокументСогласования) Тогда
				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("Состояние",Стр.Состояние);
				НайденныеСтр = Объект.ДокументСогласования.Состояния.НайтиСтроки(ПараметрыОтбора);
				Если НайденныеСтр.Количество()>0 Тогда
					НовСтр.Статус = НайденныеСтр[0].Статус;
				КонецЕсли;
			КонецЕсли;
			// будем использовать это значение для последовательного перехода при смене статуса
			НовСтр.ПорядковыйНомер = ПерваяСтр;
		КонецЕсли;		
	КонецЦикла;
	
	// проверить параллельное согласование
	Если ЭтоНовыйЦикл Тогда
		Для каждого СтрТЧ из ТЗСостояния Цикл
			Если Не ЗначениеЗаполнено(СтрТЧ.ПредыдущиеЭтапы) и СтрТЧ.Статус = Перечисления.СтатусыЭтапов.Новый Тогда
				СтрТЧ.Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
				//++ Зубов 35844 05.08.2021
				СтрТЧ.НачалоРаботы = ТекущаяДата();
				//-- Зубов 35844 05.08.2021
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрТЧ.ПредыдущиеЭтапы) и СтрТЧ.Статус = Перечисления.СтатусыЭтапов.Новый Тогда
	            ПредыдущиеЭтапы = СтрТЧ.ПредыдущиеЭтапы;
				Попытка
					МассивЭтапов = СтрРазделить(ПредыдущиеЭтапы,",",Ложь);
				Исключение
					Сообщить("Некорректная строка предыдущих этапов");
				КонецПопытки;
				ВозможноВыполнение = Истина;
				Если МассивЭтапов.Количество() > 0 Тогда
					Для каждого Эл из МассивЭтапов Цикл
						Попытка
							НомСтр = Число(Эл);
							ПараметрыОТбора = Новый Структура;
							ПараметрыОТбора.Вставить("НомерТекущегоЭтапаСогласования",НомСтр);
							СтрЭтапа = ТЗСостояния.НайтиСтроки(ПараметрыОТбора);
							Если НЕ СтрЭтапа.Количество() = 0 Тогда
								Если СтрЭтапа[0].Статус <> Перечисления.СтатусыЭтапов.Выполнен Тогда
									ВозможноВыполнение = Ложь;
								КонецЕсли;
							КонецЕсли;
						Исключение
							Сообщить("Некорректное указание этапа состояние. Возможен только ввод цифр.");
						КонецПопытки
					КонецЦикла;
				КонецЕсли;
				Если ВозможноВыполнение Тогда
					СтрТЧ.Статус =  Перечисления.СтатусыЭтапов.НаВыполнение;
					//++ Зубов 35844 05.08.2021
					СтрТЧ.НачалоРаботы = ТекущаяДата();
					//-- Зубов 35844 05.08.2021
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	
	Запрос2 = Новый Запрос;
	Запрос2.Текст = "ВЫБРАТЬ
	                |	ВремТЧ.СтатусСогласования КАК СтатусСогласования,
	                |	ВремТЧ.Статус КАК Статус,
	                |	ВремТЧ.Состояние КАК Состояние,
	                |	ВремТЧ.Исполнитель КАК Исполнитель,
	                |	ВремТЧ.ЗавершениеРаботы КАК ЗавершениеРаботы,
	                |	ВремТЧ.ШагЦикла КАК ШагЦикла,
	                |	ВремТЧ.Комментарий КАК Комментарий,
	                |	ВремТЧ.ОтветИнициатора КАК ОтветИнициатора,
	                |	ВремТЧ.ПредыдущиеЭтапы КАК ПредыдущиеЭтапы
	                |ПОМЕСТИТЬ ВТ
	                |ИЗ
	                |	&ВремТЧ КАК ВремТЧ
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	ВТ.СтатусСогласования КАК СтатусСогласования,
	                |	ВТ.Статус КАК Статус,
	                |	ВТ.Состояние КАК Состояние,
	                |	ВТ.Исполнитель КАК Исполнитель,
	                |	ВТ.ЗавершениеРаботы КАК ЗавершениеРаботы,
	                |	ВТ.ШагЦикла КАК ШагЦикла,
	                |	ВТ.Комментарий КАК Комментарий,
	                |	ВТ.ПредыдущиеЭтапы КАК ПредыдущиеЭтапы,
	                |	ВТ.ОтветИнициатора КАК ОтветИнициатора
	                |ИЗ
	                |	ВТ КАК ВТ
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	ШагЦикла
	                |ИТОГИ ПО
	                |	ШагЦикла";
	Запрос2.УстановитьПараметр("ВремТЧ",ЭтаФорма.Объект.Состояния.Выгрузить());
	ТЗ2 = Запрос2.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	ЗначениеВРеквизитФормы(ТЗ2, "ТЗСостоянияАрхив");
	
КонецПроцедуры

&НаСервере
Процедура АвтозаполнениеРеквизитамиНаСервере()
	
	Если ЗначениеЗаполнено(Объект.ДокументСогласования) Тогда
		Если ТипЗнч(Объект.ДокументСогласования) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
			ОбъектМД = Метаданные.Справочники.ДоговорыКонтрагентов;
		ИначеЕсли ТипЗнч(Объект.ДокументСогласования) = Тип("ДокументСсылка.Заявка") Тогда
			ОбъектМД = Метаданные.Документы.Заявка;
		ИначеЕсли ТипЗнч(Объект.ДокументСогласования) = Тип("ДокументСсылка.ПСЦ") Тогда
			ОбъектМД = Метаданные.Документы.ПСЦ;
		ИначеЕсли ТипЗнч(Объект.ДокументСогласования) = Тип("ДокументСсылка.Калькуляция") Тогда
			ОбъектМД = Метаданные.Документы.Калькуляция;
		ИначеЕсли ТипЗнч(Объект.ДокументСогласования) = Тип("ДокументСсылка.КредитнаяЗаявка") Тогда
			ОбъектМД = Метаданные.Документы.КредитнаяЗаявка;
		//Евросиб Каблов 28.06.2024 ( #67092
		ИначеЕсли ТипЗнч(Объект.ДокументСогласования) = Тип("ДокументСсылка.ПСЦПоставщика") Тогда
			ОбъектМД = Метаданные.Документы.ПСЦПоставщика;
		//Евросиб Каблов 28.06.2024 )
		//Евросиб СубботинВ #89527 30.10.2024 Начало
		ИначеЕсли ТипЗнч(Объект.ДокументСогласования) = Тип("ДокументСсылка.РеестрПлатежей") Тогда
			ОбъектМД = Метаданные.Документы.РеестрПлатежей;
        //Евросиб СубботинВ #89527 30.10.2024 Конец
		//Евросиб Каблов 11.12.2024 ( #89872
		ИначеЕсли ТипЗнч(Объект.ДокументСогласования) = Тип("ДокументСсылка.ПротоколСНормативнымиСтавкамиНаУслугиПоставщиков") Тогда
			ОбъектМД = Метаданные.Документы.ПротоколСНормативнымиСтавкамиНаУслугиПоставщиков;
		//Евросиб Каблов 11.12.2024 )
		// Евросиб US 90342 TA 90342 Рыбьяков К.А. 29.01.2026 ((
		ИначеЕсли ТипЗнч(Объект.ДокументСогласования) = Тип("ДокументСсылка.РеестрСпециальныхСтавок") Тогда
			ОбъектМД = Метаданные.Документы.РеестрСпециальныхСтавок;
		// Евросиб Рыбьяков К.А. 29.01.2026 ))
		КонецЕсли;
		
		//Евросиб СубботинВ #89527 30.10.2024 Начало
		//// заполнить таблицу реквизитов
		//Для Каждого Рекв Из ОбъектМД.Реквизиты Цикл
		//	НовСтр = Объект.РеквизитыСогласования.Добавить();
		//	НовСтр.РеквизитВСистеме = Рекв.Имя;
		//	НовСтр.РеквизитПредставление = Рекв.Синоним;				
		//	НовСтр.ДанныеРеквизита = Объект.ДокументСогласования[НовСтр.РеквизитВСистеме];
		//КонецЦикла;
		
		Если ТипЗнч(Объект.ДокументСогласования) = Тип("ДокументСсылка.РеестрПлатежей") Тогда
			Элементы.РеквизитыСогласования.Видимость = Ложь;
			//Евросиб СубботинВ #104218 13.03.2025 Начало
			Элементы.СуммаКОплате.Видимость = Истина;
			Элементы.ОтчетПоЦикламСогласования.Видимость = Истина;	
			//Евросиб СубботинВ #104218 13.03.2025 Конец
			//Евросиб СубботинВ #128538 23.01.2026 Начало
			//СуммаКОплате = Объект.ДокументСогласования.СуммаИтогоВРублях;
			СуммаКОплате = Документы.РеестрПлатежей.ПосчитатьИтогиПоДокументу(Объект.ДокументСогласования); 
			//Евросиб СубботинВ #128538 23.01.2026 Конец
			Элементы.СогласованСЗамечаниями.Видимость = Ложь;
			Элементы.СогласованСКомментариями.Видимость = Ложь;
			Элементы.ИсторияИзмененияРеквизитов.Видимость = Ложь;
			Элементы.Группа5.Видимость = Ложь; 
			//Евросиб СубботинВ #101320 30.01.2025 Начало 
			Элементы.Группа9.Видимость = Ложь;
			ЭтаФорма.КоманднаяПанель.ПодчиненныеЭлементы.Найти("ФормаТехнологическиеСхемы").Видимость = Ложь;
			Элементы.ТЗСостояния.КоманднаяПанель.ПодчиненныеЭлементы.Найти("ТЗСостоянияДелегировать").Видимость = Ложь;
			Элементы.ТЗСостояния.КоманднаяПанель.ПодчиненныеЭлементы.Найти("ТЗСостоянияОтветыНаЗамечания").Видимость = Ложь;
			//Евросиб СубботинВ #101320 30.01.2025 Конец
			
			НовоеИмяКоманды = ТекущийСтатус.НаименованиеКомандыПроцессаСогласования;
			Если ЗначениеЗаполнено(НовоеИмяКоманды) Тогда
				Элементы.Согласован.Заголовок = НовоеИмяКоманды;
				Элементы.НеСогласован.Заголовок = "Не " + НРег(НовоеИмяКоманды);
			КонецЕсли;	

		Иначе	
			// заполнить таблицу реквизитов
			Для Каждого Рекв Из ОбъектМД.Реквизиты Цикл
				НовСтр = Объект.РеквизитыСогласования.Добавить();
				НовСтр.РеквизитВСистеме = Рекв.Имя;
				НовСтр.РеквизитПредставление = Рекв.Синоним;
				//Евросиб СубботинВ #125532 23.12.2025 Начало
				Если (ОбъектМД = Метаданные.Документы.ПСЦ ИЛИ ОбъектМД = Метаданные.Документы.ПСЦПоставщика) и Рекв = ОбъектМД.Реквизиты.Автор Тогда			
					ИнформацияПоСостоянию = МаршрутизацияСервер.ПолучитьИнформациюПоСостояниюОбъекта(Справочники.Состояния.ВводПСЦ, Объект.ДокументСогласования.ПолучитьОбъект()); 
					НовСтр.ДанныеРеквизита = ИнформацияПоСостоянию.Исполнитель;
				Иначе
				//Евросиб СубботинВ #125532 23.12.2025 Конец
					НовСтр.ДанныеРеквизита = Объект.ДокументСогласования[НовСтр.РеквизитВСистеме];
