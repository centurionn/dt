			ИЛИ ТипЗнч(Объект.ДокументСогласования) = Тип("ДокументСсылка.ПСЦПоставщика"))
		Тогда
	//Евросиб Каблов 28.06.2024 )
		ДоговорСогл = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ДокументСогласования, "Договор");
		ЭтаФорма.ДИТ_КатегорияДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорСогл, "КатегорияДоговора");
		Если ДоговорСогл.Типовой Тогда 
			ЭтаФорма.ДИТ_ФормаДоговора = "Типовая";
		Иначе
			ЭтаФорма.ДИТ_ФормаДоговора = "Нетиповая";
		КонецЕсли;
	Иначе 
		ЭтаФорма.ДИТ_КатегорияДоговора = Неопределено;
		ЭтаФорма.ДИТ_ФормаДоговора = "";
	КонецЕсли;
