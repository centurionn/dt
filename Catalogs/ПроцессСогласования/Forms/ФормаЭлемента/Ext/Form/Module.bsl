	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Доступность = Ложь;
    ЭтаФорма.Элементы.Переместить(Элементы.ПолеДИТ_КатегорияДоговора, ГруппаДокументКатегория);
	НовыйЭлемент = Элементы.Добавить("ПолеДИТ_ФормаДоговора", Тип("ПолеФормы"), ЭтаФорма);
	НовыйЭлемент.ПутьКДанным = "ДИТ_ФормаДоговора";
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Доступность = Ложь;
    ЭтаФорма.Элементы.Переместить(Элементы.ПолеДИТ_ФормаДоговора, ГруппаСтатусФорма);
	ДИТ_ЗаполнитьКатегориюДоговора();
	Если Не ЗначениеЗаполнено(ЭтаФорма.ДИТ_КатегорияДоговора) Тогда 
		Элементы.ПолеДИТ_КатегорияДоговора.Видимость = Ложь;
		Элементы.ПолеДИТ_ФормаДоговора.Видимость = Ложь;
	Иначе
		Элементы.ПолеДИТ_КатегорияДоговора.Видимость = Истина;
		Элементы.ПолеДИТ_ФормаДоговора.Видимость = Истина;
	КонецЕсли;
	//ДИТ Мамедов Э.Т. Ticket#0268161 US 51931 29.03.2024 Конец
	
	
	
    //Евросиб СубботинВ #89527 30.10.2024 Начало
	Если ТипЗнч(Объект.ДокументСогласования) = Тип("ДокументСсылка.РеестрПлатежей") Тогда 	
		ЗаполнитьИсториюРеквизитов(ТекущийЦикл);
		ЭтаФорма.Элементы.Переместить(Элементы.СуммаКОплате, ЭтаФорма, ГруппаСтатусФорма); 
		КомментарийИнициатора = Объект.ДокументСогласования.КомментарийИнициатора;
		СтруктураПоиска = Новый Структура("ШагЦикла", ТекущийЦикл);
		СтрокиТекущегоЦикла = Объект.Состояния.НайтиСтроки(СтруктураПоиска);
		Если СтрокиТекущегоЦикла.Количество() <> 0 Тогда
			Для Каждого Состояние из СтрокиТекущегоЦикла Цикл
				Объект.Состояния.Удалить(Состояние);
			КонецЦикла;
			Для Каждого Состояние Из Объект.ДокументСогласования.Состояния Цикл
				НовСтр = Объект.Состояния.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр, Состояние);
				НовСтр.ШагЦикла = ТекущийЦикл;
			КонецЦикла;
		КонецЕсли;
	Иначе
		КомментарийИнициатора = Объект.ДокументСогласования.Комментарий
	КонецЕсли;
	//Евросиб СубботинВ #89527 30.10.2024 Конец

     //Евросиб СубботинВ #89527 30.10.2024 Начало	 
	ЗаполнитьДеревоНаСервере(Ложь);
	ПолучитьТекущийСтатус();

	 Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЭтаФорма.Записать();
	КонецЕсли;
	//Евросиб СубботинВ #89527 30.10.2024 Конец	
	
	//Евросиб СубботинВ #89527 30.10.2024 Начало
	СформироватьОтчетПрограммно();
	//Евросиб СубботинВ #89527 30.10.2024 Конец

		
КонецПроцедуры

