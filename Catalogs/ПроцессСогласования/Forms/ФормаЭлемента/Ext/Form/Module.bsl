&НаКлиенте
Процедура СменаСтатуса(ТекСт)  
	
	ТекД = Элементы.ТЗСостояния.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//Евросиб Каблов 08.01.2025 ( #97984
	ТекСтр = Элементы.ТЗСостояния.ТекущаяСтрока;
	ПараметрыЗаписиРецензирования = Новый Структура;	
	ПараметрыЗаписиРецензирования.Вставить("РольИсполнителя", ТекД.Исполнитель);
	//Евросиб Каблов 08.01.2025 )
			
	ТекД.Исполнитель = ПользователиКлиент.ТекущийПользователь();
	ТекД.СтатусСогласования = ПредопределенноеЗначение("Перечисление.СтатусыСогласования."+ТекСт);
	ТекД.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Выполнен");
	ТекД.ЗавершениеРаботы = ТекущаяДата();
	ТекД.Комментарий = Комментарии;
	ТекущаяСтр = ТекД.ПорядковыйНомер;
	ПараметрыОтбора = Новый СТруктура;
	ПараметрыОтбора.Вставить("ПорядковыйНомер", ТекущаяСтр+1);
	ПараметрыОтбора.Вставить("Статус", ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Новый"));
	НайденнаяСтрока = ТЗСостояния.НайтиСтроки(ПараметрыОтбора);
	
	Если ТекСт = "ОтклоненоБезЗамечаний" Тогда
		Для каждого Стр из ТЗСостояния.НайтиСтроки(Новый Структура("ПорядковыйНомер", ТекущаяСтр)) Цикл
			Стр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Отклонен");
		КонецЦикла;
	КонецЕсли;
		
	Если НайденнаяСтрока.Количество()>0 Тогда
		НайденнаяСтрока[0].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение");
		Элементы.ТЗСостояния.ТекущаяСтрока = НайденнаяСтрока[0].ПолучитьИдентификатор();
	КонецЕсли;       
	
	//ДИТ Авдеева В.С. 37680 15.04.22 Начало
	Этаформа.Прочитать();
	//ДИТ Авдеева В.С. 37680 15.04.22 Конец
	
	Комментарии = "";
	
	ПолучитьТекущийСтатус();
	
	ДоступностьКнопок();
// закомментировано 30.01.2020. Не сохраняем без подтверждения пользователя

	//Евросиб Каблов 08.01.2025 ( #97984
	ДобавитьЗаписьРецензирование(ТекСтр, ПараметрыЗаписиРецензирования);
	//Евросиб Каблов 08.01.2025 )
	
	ЭтотОбъект.Записать();

	//ЭтаФорма.Модифицированность = Истина;  
	
	//ДИТ Авдеева В.С. 0283481 Начало 25.08.2022 
	ДоступностьКнопок();
	//ДИТ Авдеева В.С. 0283481 Конец 25.08.2022

КонецПроцедуры

