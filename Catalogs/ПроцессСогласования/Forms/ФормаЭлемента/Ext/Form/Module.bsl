&НаСервере
Процедура ДобавитьЗаписьРецензирование(ТекСтрока, ДопПараметры)
	
	Стр = ТЗСостояния.НайтиПоИдентификатору(ТекСтрока);
	
	МЗ = РегистрыСведений.Рецензирование.СоздатьМенеджерЗаписи();
	МЗ.ЦиклСогласования = Стр.ШагЦикла;
	МЗ.РецензОбъект = Объект.ДокументСогласования;
	МЗ.Рецензент = Стр.Исполнитель;
	Если ЗначениеЗаполнено(Стр.ЗавершениеРаботы) Тогда
		МЗ.ТаймШтамп = Стр.ЗавершениеРаботы;
	Иначе
		МЗ.ТаймШтамп = ТекущаяДата();
	КонецЕсли;
	МЗ.Комментарии = Стр.Комментарий;
	МЗ.ОтветИнициатора = Стр.ОтветИнициатора;	
	МЗ.Действие = Стр.Статус;
	РольИсполнителя = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДопПараметры, "РольИсполнителя");
	Если ЗначениеЗаполнено(РольИсполнителя) Тогда
		МЗ.РольИсполнителя = РольИсполнителя;
	КонецЕсли;
	МЗ.СтатусОбъекта = Стр.СтатусСогласования;
	МЗ.Состояние = Стр.Состояние;
	МЗ.Записать(Истина);
	
КонецПроцедуры

