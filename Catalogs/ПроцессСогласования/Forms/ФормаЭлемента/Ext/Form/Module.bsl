&НаКлиенте
Процедура ЗавершитьСогласование(Команда)
	
	ЕстьНезакрытыеЭтапы = Ложь;
	Для каждого Стр из ТЗСостояния Цикл
		ЕстьНезакрытыеЭтапы = ЕстьНезакрытыеЭтапы ИЛИ Стр.СтатусСогласования = ПредопределенноеЗначение("Перечисление.СтатусыСогласования.Планируется");
	КонецЦикла;
	//Евросиб Шевченко А.В. US 110215 TA 122847 10.11.2025
	ОсобыйСлучайЗавершенияСогласования = Ложь;
	Если ТипЗнч(Объект.ДокументСогласования) = Тип("ДокументСсылка.ПСЦПоставщика") Тогда
		ОсобыйСлучайЗавершенияСогласования = ПолучитьРазрещениеНаЗавершение();
	КонецЕсли;	
		
	Если НЕ ОсобыйСлучайЗавершенияСогласования Тогда
		//Евросиб Гудкова( 27.04.2021 Ticket№ 0230800
		//	ТекстДиалога = ?(ЕстьНезакрытыеЭтапы, "Внимание! В согласовании есть не отработанные позиции! Если завершить согласование, то они перейдут в ""отклонено"" и общий цикл согласования придется перезапускать. ", "") + "Завершить цикл согласования?";
		ТекстДиалога = ?(ЕстьНезакрытыеЭтапы, "Внимание! В согласовании есть не отработанные позиции! Если завершить согласование, то они перейдут в ""отклонено"" и всё согласование придется перезапускать через отмену. ", "") + "Завершить согласование полностью?";
		// Евросиб Гудкова)
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаЗавершитьСогласование", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстДиалога, Режим);
	Иначе
		ПослеЗакрытияВопросаЗавершитьСогласование(КодВозвратаДиалога.Да,Неопределено);
	КонецЕсли;
	//Евросиб Шевченко А.В. US 110215 TA 122847 10.11.2025	
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьРазрещениеНаЗавершение() //Евросиб Шевченко А.В. US 110215 TA 122847 10.11.2025
	
	Ответ = Истина;
	
	Для Каждого Стр Из ТЗСостояния Цикл
		Если Стр.Состояние <> ПредопределенноеЗначение("Справочник.Состояния.ПроверкаСогласованияОтправкаПодкреплениеПодписанногоПСЦ") Тогда
			Если Стр.Статус <> ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Выполнен") Тогда
				Ответ = Ложь;
				Прервать;
			КонецЕсли;
			Если Стр.СтатусСогласования <> ПредопределенноеЗначение("Перечисление.СтатусыСогласования.СогласованоБезЗамечаний") И Стр.СтатусСогласования <> ПредопределенноеЗначение("Перечисление.СтатусыСогласования.СогласованСКомментариями") Тогда
				Ответ = Ложь;
				Прервать;
			КонецЕсли;	
		КонецЕсли;
		Если Стр.Состояние = ПредопределенноеЗначение("Справочник.Состояния.ПроверкаСогласованияОтправкаПодкреплениеПодписанногоПСЦ") Тогда
			Если Стр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Выполнен") Тогда
				Ответ = Ложь;
				Прервать;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат Ответ;
	
КонецФункции	

&НаКлиенте
Процедура ПослеЗакрытияВопросаЗавершитьСогласование(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	СогласованиеЗавершитьКлиент();
	// ДИТ Поморцева Т.П. Задача 0233272 28.05.21. начало
	//СохранитьРеестрРазногласий();
	СохранитьРеестрРазногласийНаСервере();
	// ДИТ Поморцева Т.П. Задача 0233272 28.05.21. конец
	//Евросиб Шевченко А.В. US 100317 BUG 124407 21.11.2025
	Если ТипЗнч(Объект.ДокументСогласования) = Тип("ДокументСсылка.ПСЦПоставщика") Тогда
		СохранитьПротокол();
	КонецЕсли;
	//Евросиб Шевченко А.В. US 100317 BUG 124407 21.11.2025
	УдалитьСтарыеЭлементы();
	ХранилищеФайла = ПолучитьДанныеХранилища();
	СоздатьЗакладки(ХранилищеФайла);
	
КонецПроцедуры

&НаСервере
Процедура СохранитьПротокол() //Евросиб Шевченко А.В. US 100317 BUG 124407 21.11.2025
	
	ДокументПСЦ = Объект.ДокументСогласования;
	
	Если (ТипЗнч(ДокументПСЦ) = Тип("ДокументСсылка.ПСЦПоставщика")	И ДокументПСЦ.Типовой И ДокументПСЦ.ВидУслугПоставщика = ПредопределенноеЗначение("Справочник.ВидыУслугПоставщиков.Автоперевозки")) Тогда
			
		ИмяФайлаПФ = "Протокол " + СтрЗаменить(ДокументПСЦ.НомерПСЦ,"/","-") + " от " + Формат(ДокументПСЦ.ДатаПСЦ, "ДФ=dd.MM.yyyy");  
		
		Запрос = Новый Запрос;
		Запрос.Текст =    
		"ВЫБРАТЬ 
		|	Файлы.Ссылка КАК Файл,
		|	Файлы.Наименование КАК Имя,
		|	Файлы.Расширение КАК Расширение,
		|	Файлы.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.Файлы КАК Файлы
		|ГДЕ
		|	Файлы.ВладелецФайла = &ВладелецФайла  
		|	И Файлы.Наименование ПОДОБНО &ИмяФайла";
		
		Запрос.УстановитьПараметр("ВладелецФайла", ДокументПСЦ);  
		Запрос.УстановитьПараметр("ИмяФайла", "Протокол % от %");
		
		РезультатЗапроса = Запрос.Выполнить();
		Если не РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать(); 
			Пока Выборка.Следующий() Цикл
				Если Выборка.Имя = ИмяФайлаПФ и не Выборка.ПометкаУдаления Тогда
					обФайл = Выборка.Файл.ПолучитьОбъект();
					ОбФайл.ПометкаУдаления = Истина;
					обФайл.Записать();
				КонецЕсли;    
			КонецЦикла;
		КонецЕсли;
		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(ДокументПСЦ);
		
		пАдресаТерминалов = РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ПолучитьВидПечатнойФормыПротоколаПСЦПоставщика(ДокументПСЦ);
		
		ВыводитьАдресаТерминалов = Ложь;
		
		Если ТипЗнч(пАдресаТерминалов) = Тип("ПеречислениеСсылка.ВидПечатнойФормыПротоколаПСЦПоставщика") Тогда
			ВыводитьАдресаТерминалов = пАдресаТерминалов = Перечисления.ВидПечатнойФормыПротоколаПСЦПоставщика.САдресамиТерминалов;
		КонецЕсли;	
		
		ДопПараметры = Новый Структура("ВыводитьАдресаТерминалов",ВыводитьАдресаТерминалов);
		
		ТабДокПротокола = Документы.ПСЦПоставщика.НапечататьТиповойПротоколАвтоперевозки(МассивОбъектов,ДопПараметры);
		
		ИмяФайла = КаталогВременныхФайлов() + ИмяФайлаПФ + ".pdf";
		ТабДокПротокола.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.PDF);    
