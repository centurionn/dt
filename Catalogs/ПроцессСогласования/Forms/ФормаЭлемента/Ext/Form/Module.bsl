&НаСервере
Процедура СоздатьЗакладки(ХранилищеФайла)
	
	//необходимо удалить старые программно созданные реквизиты
	МассивУдаляемыхРеквизитовФормы = новый Массив;
	Для каждого Стр из ЭтаФорма.ПолучитьРеквизиты() Цикл
		ПутьКДан = ?(ЗначениеЗаполнено(Стр.Путь),Строка(Стр.Путь)+".","");
		Если Стр.Имя <> "ОтображениеФайла" И
			Стр.Имя <> "Объект" И 
			Стр.Имя <> "ТекущийПользователь" И
			Стр.Имя <> "ТекущийСтатус" И
			Стр.Имя <> "ТекущийЦикл" И
			Стр.Имя <> "СогласованиеЗавершено" И
			Стр.Имя <> "РольДоступнаАдмин" И
			Стр.Имя <> "ТЗСостояния" И 
			Стр.Имя <> "СписокЭФ" И 
	//ДИТ Авдеева В.С. 37680 15.04.22 Начало
			Стр.Имя <> "НачальныйЦикл" И 
	//ДИТ Авдеева В.С. 37680 15.04.22 Конец
	//ДИТ Мамедов Э.Т. Ticket#0268161 US 51931 29.03.2024 Начало
			Стр.Имя <> "ДИТ_КатегорияДоговора" И 
			Стр.Имя <> "ДИТ_ФормаДоговора" И 
	//ДИТ Мамедов Э.Т. Ticket#0268161 US 51931 29.03.2024 Конец
			Стр.Имя <> "ТЗСостоянияАрхив" И
			Стр.Имя <> "ТекстСообщения" И
			Стр.Имя <> "Комментарии" И
			Стр.Имя <> "КомментарийИнициатора" И
			//Евросиб СубботинВ #89527 30.10.2024 Начало
			Стр.Имя <> "РеквизитыАрхив" И 
			Стр.Имя <> "СуммаКОплате" И
			Стр.Имя <> "ОтчетПоЦикламСогласования" И 
			Стр.Имя <> "ТЗСостоянияАрхив" И
			//Евросиб СубботинВ #89527 30.10.2024 Конец
			Стр.Имя <> "ТД" тогда 
			МассивУдаляемыхРеквизитовФормы.Добавить(Строка(ПутьКДан) + Стр.Имя); 
		КонецЕсли;
	КонецЦикла;
	
	// для типовых договоров и ПСЦ добавить закладки с договорами
	Если ТипЗнч(Объект.ДокументСогласования) = Тип("СправочникСсылка.ДоговорыКонтрагентов") И Объект.ДокументСогласования.Типовой Тогда 
		ТД = Обработки.СогласованиеДоговоров.НапечататьДоговор(Объект.ДокументСогласования,Объект.ДокументСогласования.МакетПечатнойФормыДоговора);
		Элементы.Группа10.Заголовок = "Типовой договор";
