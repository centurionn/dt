// Евросиб US 128174 TA 130483 Рыбьяков К.А. 15.03.2026 ((
Функция СохранитьОтветИнициатора(ДокументСогласования) Экспорт
	
	УДокументаЕстьРеквизитОтветИнициатора = Ложь;
	
	Если ТипЗнч(ДокументСогласования) = Тип("ДокументСсылка.ПСЦПоставщика")
		Или ТипЗнч(ДокументСогласования) = Тип("ДокументСсылка.Калькуляция")
		Или ТипЗнч(ДокументСогласования) = Тип("ДокументСсылка.КредитнаяЗаявка")
		Или ТипЗнч(ДокументСогласования) = Тип("ДокументСсылка.РеестрСпециальныхСтавок") Тогда
		УДокументаЕстьРеквизитОтветИнициатора = Истина;
	КонецЕсли;
	
	Возврат УДокументаЕстьРеквизитОтветИнициатора;
	
КонецФункции // Евросиб Рыбьяков К.А. 15.03.2026 ))