						НовыйИсполнитель = ПолучитьИсполнителяЭтапаСЗамечаниями(Объект.ДокументСогласования, Стр.Состояние);
						Если НовыйИсполнитель <> Неопределено Тогда
							НовСтр.Исполнитель = НовыйИсполнитель;
						КонецЕсли;	
					КонецЕсли;	
					// Евросиб Фролов)
					
				КонецЕсли;				
				
			// Евросиб US 90342 Рыбьяков К.А. 19.03.2026 (( закомментировал и перенес выше
