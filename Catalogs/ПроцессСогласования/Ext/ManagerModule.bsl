					// Евросиб Фролов (7.02.2022 TASK #46807
					Или Стр.СтатусСогласования = Перечисления.СтатусыСогласования.СогласованСКомментариями Тогда
					// Евросиб Фролов)
					НовСтр.СтатусСогласования = Стр.СтатусСогласования;
					НовСтр.Статус = Стр.Статус;
					
					// Евросиб Фролов (7.02.2022 TASK #46807
					Если Стр.СтатусСогласования = Перечисления.СтатусыСогласования.СогласованСКомментариями Тогда
						НовСтр.Комментарий = Стр.Комментарий;
					КонецЕсли;	
					// Евросиб Фролов)
					
					// Евросиб Фролов (28.02.2022 Task №47911
