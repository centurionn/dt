
//Евросиб Каблов 15.01.2025 #89876 скопировал функцию из формы элемента
Функция ПолучитьИсполнителяЭтапаСЗамечаниями(ДокументСогласования, Состояние) Экспорт
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСогласования, "ПримененныйМаршрут, Дата, ПримененныйМаршрут.НачальныйСтатус, Договор, ВидПеревозки");
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	МаршрутизацияСостояния.Состояние КАК Состояние,
	|	МаршрутизацияСостояния.Исполнитель КАК Исполнитель,
	|	МаршрутизацияСостояния.Наблюдатель КАК Наблюдатель,
	|	МаршрутизацияСостояния.ПредыдущиеЭтапы КАК ПредыдущиеЭтапы,
	|	МаршрутизацияСостояния.СопровождениеПоДоговору КАК СопровождениеПоДоговору,
	|	МаршрутизацияСостояния.ОтветственныйЗаУчет КАК ОтветственныйЗаУчет,
	|	МаршрутизацияСостояния.ОтветственныйЗаДоговор КАК ОтветственныйЗаДоговор,
	|	МаршрутизацияСостояния.НормативИсполненияСМоментаСоздания КАК НормативИсполненияСМоментаСоздания,
	|	МаршрутизацияСостояния.ТребуетсяУказатьНаблюдателя КАК ТребуетсяУказатьНаблюдателя,
	|	МаршрутизацияСостояния.ТребуетсяУказатьИсполнителя КАК ТребуетсяУказатьИсполнителя,
	|	МаршрутизацияСостояния.ВидНормативаИсполнения КАК ВидНормативаИсполнения,
	|	МаршрутизацияСостояния.ИсполнительКакРуководительПоНаправлению КАК ИсполнительКакРуководительПоНаправлению,
	|	МаршрутизацияСостояния.НаблюдательКакРуководительПоНаправлению КАК НаблюдательКакРуководительПоНаправлению,
	|	МаршрутизацияСостояния.ОтветственныйМенеджерПСЦ КАК ОтветственныйМенеджерПСЦ,
	|	МаршрутизацияСостояния.РуководительСотрудника КАК РуководительСотрудника,
	|	МаршрутизацияСостояния.ВыбиратьИсполнителяЕслиНеЗаполненРуководительСотрудника КАК ВыбиратьИсполнителяЕслиНеЗаполненРуководительСотрудника
	|ИЗ
	|	Справочник.Маршрутизация.Состояния КАК МаршрутизацияСостояния
	|ГДЕ
	|	МаршрутизацияСостояния.Ссылка = &ПримененныйМаршрут
	|	И МаршрутизацияСостояния.Состояние = &Состояние";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("ПримененныйМаршрут", РеквизитыДокумента.ПримененныйМаршрут);
	Запрос.УстановитьПараметр("Состояние", Состояние);
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		Стр = Результат.Выбрать();
		Стр.Следующий();
				
		РезультатЗапроса = Новый Массив;
		
		Статус = РеквизитыДокумента.ПримененныйМаршрутНачальныйСтатус;
		РезультатЗапроса.Добавить(Новый Структура("Состояние, Исполнитель, Наблюдатель, Статус, Ссылка, ПредыдущиеЭтапы, ОРКПоДоговору, ОтветственныйЗаУчет, ОтветственныйЗаДоговор, НормативИсполненияСМоментаСоздания, ТребуетсяУказатьНаблюдателя, ТребуетсяУказатьИсполнителя, ВидНормативаИсполнения,ИсполнительКакРуководительПоНаправлению,НаблюдательКакРуководительПоНаправлению, ОтветственныйМенеджерПСЦ, РуководительСотрудника, ВыбиратьИсполнителяЕслиНеЗаполненРуководительСотрудника", Стр.Состояние, Стр.Исполнитель, Стр.Наблюдатель, Статус, РеквизитыДокумента.ПримененныйМаршрут, Стр.ПредыдущиеЭтапы, Стр.СопровождениеПоДоговору, Стр.ОтветственныйЗаУчет, Стр.ОтветственныйЗаДоговор, Стр.НормативИсполненияСМоментаСоздания, Стр.ТребуетсяУказатьНаблюдателя, Стр.ТребуетсяУказатьИсполнителя, Стр.ВидНормативаИсполнения,Стр.ИсполнительКакРуководительПоНаправлению,Стр.НаблюдательКакРуководительПоНаправлению, Стр.ОтветственныйМенеджерПСЦ, Стр.РуководительСотрудника, Стр.ВыбиратьИсполнителяЕслиНеЗаполненРуководительСотрудника));
	
		МаршрутизацияСервер.ОтработатьЗамещениеДелегирование(РезультатЗапроса, Перечисления.МаршрутизируемыеОбъекты.ПротоколСогласованияЦены, РеквизитыДокумента.Дата, РеквизитыДокумента.Договор);
		МаршрутизацияСервер.ОтработатьЗамещениеДелегирование(РезультатЗапроса, Перечисления.МаршрутизируемыеОбъекты.ПротоколСогласованияЦены, РеквизитыДокумента.Дата, РеквизитыДокумента.ВидПеревозки);
		
		Возврат РезультатЗапроса[0].Исполнитель;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

//Евросиб Каблов 26.02.2025 #89876 скопировал функцию из формы элемента
Процедура ЗаполнитьТЧСостояния(Объект, ТекЦикл, СброситьПроверку = Ложь) Экспорт
	
	СохранитьОтветИнициатора = СохранитьОтветИнициатора(Объект.ДокументСогласования);
	
	ТЧСост = Объект.ДокументСогласования.Состояния;
	ПерваяСтр = 0;
	Для Каждого Стр Из ТЧСост Цикл
		// добавлять только согласование
		Если Стр.Состояние.Согласование = Истина Тогда
			НовСтр = Объект.Состояния.Добавить();
			ПерваяСтр = ПерваяСтр + 1;
			//++ Зубов 35844 05.08.2021
			//ЗаполнитьЗначенияСвойств(НовСтр,Стр,"Состояние,Исполнитель,Наблюдатель,ПредыдущиеЭтапы,НормативИсполненияСМоментаСоздания");
			// Евросиб US 128174 TA 130483 Рыбьяков К.А. 10.02.2026 ((
			Если СохранитьОтветИнициатора Тогда
				ЗаполнитьЗначенияСвойств(НовСтр,Стр,"Состояние,Исполнитель,Наблюдатель,ПредыдущиеЭтапы,
													|НормативИсполненияСМоментаСоздания,НачалоРаботы,ОтветИнициатора");
			Иначе
				ЗаполнитьЗначенияСвойств(НовСтр,Стр,"Состояние,Исполнитель,Наблюдатель,ПредыдущиеЭтапы,
													|НормативИсполненияСМоментаСоздания,НачалоРаботы,Комментарий");
			КонецЕсли;
			//ЗаполнитьЗначенияСвойств(НовСтр,Стр,"Состояние,Исполнитель,Наблюдатель,ПредыдущиеЭтапы,НормативИсполненияСМоментаСоздания,НачалоРаботы");
			// Евросиб Рыбьяков К.А. 10.02.2026 ))
			//-- Зубов 35844 05.08.2021
			НовСтр.ШагЦикла = ТекЦикл;
			
			// Евросиб US 90342 Рыбьяков К.А. 19.03.2026 ((
			Если ТипЗнч(Объект.ДокументСогласования) = Тип("ДокументСсылка.РеестрПлатежей") Тогда
				
				НовСтр.СтатусСогласования = Перечисления.СтатусыСогласования.Планируется;
				НовСтр.Статус = Перечисления.СтатусыЭтапов.Новый;
				Если ТекЦикл > 1 И Стр.СтатусСогласования = Перечисления.СтатусыСогласования.СогласованоСЗамечаниями Тогда
					НовыйИсполнитель = ПолучитьИсполнителяЭтапаСЗамечаниями(Объект.ДокументСогласования, Стр.Состояние);
					Если НовыйИсполнитель <> Неопределено Тогда
						НовСтр.Исполнитель = НовыйИсполнитель;
					КонецЕсли;
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(Объект.ДокументСогласования) = Тип("ДокументСсылка.РеестрСпециальныхСтавок") Тогда
				
				Если Стр.СтатусСогласования = Перечисления.СтатусыСогласования.СогласованоБезЗамечаний
