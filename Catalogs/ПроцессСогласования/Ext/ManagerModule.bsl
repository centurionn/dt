					НовСтр.Статус = Стр.Статус;
					НовСтр.Комментарий = Стр.Комментарий;
					
					Если ТекЦикл > 1 Тогда
						НовСтр.ЗавершениеРаботы = Стр.ЗавершениеРаботы;
					КонецЕсли;
				Иначе
					НовСтр.СтатусСогласования = Перечисления.СтатусыСогласования.Планируется;
					НовСтр.Статус = ?(ТекЦикл = 1,Стр.Статус,Перечисления.СтатусыЭтапов.Новый);
					
