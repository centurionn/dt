						НовСтр.ЗавершениеРаботы = Стр.ЗавершениеРаботы;
					КонецЕсли;	
					// Евросиб Фролов)
				Иначе
					НовСтр.СтатусСогласования = Перечисления.СтатусыСогласования.Планируется;
					//НовСтр.Статус = Перечисления.СтатусыЭтапов.Новый;
					НовСтр.Статус = ?(ТекЦикл = 1,Стр.Статус,Перечисления.СтатусыЭтапов.Новый);
					
					// Евросиб Фролов (19.01.2022 Ticket№ 0252994
					// "Сброс" исполнителя по этапу с замечаниями(при запуске согласования на новый цикл) на первоначальную группу.
