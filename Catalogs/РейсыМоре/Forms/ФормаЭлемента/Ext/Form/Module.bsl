// Евросиб(ДИТ) US 84968 ТА 85932 Сержантова А.С. 19.06.2024
&НаСервере
Функция ПолучитьВсеТипоразмерыСудна()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТипоразмерыТС.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ТипоразмерыТС КАК ТипоразмерыТС
		|ГДЕ
		|	ТипоразмерыТС.Судно";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Результат = Новый Массив;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Результат.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
	КонецЦикла;   
	
	Возврат Результат;

КонецФункции 

