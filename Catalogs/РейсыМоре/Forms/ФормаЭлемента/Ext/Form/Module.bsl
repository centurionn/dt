// Евросиб(ДИТ) US 84968 ТА 85932 Сержантова А.С. 19.06.2024
Функция ПолучитьПроверитьТерминалыПорта(Порт, Терминал = Неопределено)  
	
	Результат = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ГоризонтальныеСвязиЛокаций.Терминал КАК Терминал
		|ИЗ
		|	РегистрСведений.ГоризонтальныеСвязиЛокаций КАК ГоризонтальныеСвязиЛокаций
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Локации КАК Локации
		|		ПО ГоризонтальныеСвязиЛокаций.Терминал = Локации.Ссылка
		|ГДЕ
		|	ГоризонтальныеСвязиЛокаций.Порт = &Порт 
		|	И Локации.Ссылка = &Терминал
		|	И Локации.ТипПодрядчика = &ТипПодрядчика
		|	И Локации.Тип = &Тип";
	
	Запрос.УстановитьПараметр("Порт", Порт);
	Запрос.УстановитьПараметр("Тип", Справочники.ТипыЛокаций.Терминал);
	Запрос.УстановитьПараметр("ТипПодрядчика", Перечисления.ТипПодрядчикаТерминал.Порт); 
	
	Если Терминал <> Неопределено Тогда
	    Запрос.УстановитьПараметр("Терминал", Терминал); 
	Иначе	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Локации.Ссылка = &Терминал", ""); 
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить(); 
	Если Терминал <> Неопределено Тогда
		Если РезультатЗапроса.Пустой() Тогда
			Возврат Ложь;
		Иначе	
			Возврат Истина;
		КонецЕсли;
	Иначе
		Если не РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				Результат.Добавить(Выборка.Терминал);
			КонецЦикла;
		КонецЕсли;   
		Возврат Результат;
	КонецЕсли;
	
КонецФункции 

// Евросиб(ДИТ) US 84968 ТА 85932 Сержантова А.С. 19.06.2024
&НаКлиенте
