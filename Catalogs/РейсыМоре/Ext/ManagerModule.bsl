// Евросиб US 111176 TA 111178 Рыбьяков К.А. 25.06.2025 ((
Функция ПортНазначенияРоссийский(ПортНазначения) Экспорт
	
	Результат = Ложь;
	
	Если ЗначениеЗаполнено(ПортНазначения) Тогда
		Страна = Неопределено;
		ЛокацияВышестоящегоУровня = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПортНазначения, "ЛокацияВышестоящегоУровня");
		ТипЛокацииВышестоящегоУровня = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЛокацияВышестоящегоУровня, "Тип");
		Пока ЗначениеЗаполнено(ЛокацияВышестоящегоУровня) Цикл
			Если ТипЛокацииВышестоящегоУровня = Справочники.ТипыЛокаций.Страна И Страна = Неопределено Тогда
				Страна = ЛокацияВышестоящегоУровня;
			КонецЕсли;
			ЛокацияВышестоящегоУровня = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЛокацияВышестоящегоУровня, "ЛокацияВышестоящегоУровня");
			ТипЛокацииВышестоящегоУровня = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЛокацияВышестоящегоУровня, "Тип");
		КонецЦикла;
		Если Страна = Справочники.Локации.РОССИЯ Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // Евросиб Рыбьяков К.А. 25.06.2025 ))

// Евросиб US 111176 TA 111178 Рыбьяков К.А. 30.07.2025 ((
Функция ПроверитьПунктыНаПометкуУдаления(МорскойРейс) Экспорт
	Ответ = Новый Структура;
	Ответ.Вставить("ПунктНазначенияПометкаУдаления", Ложь);
	Ответ.Вставить("МестоРазгрузкиПометкаУдаления", Ложь);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(РейсыМоре.ПунктНазначения.ПометкаУдаления, Ложь) КАК ПунктНазначенияПометкаУдаления,
	|	ЕСТЬNULL(РейсыМоре.МестоРазгрузки.ПометкаУдаления, Ложь) КАК МестоРазгрузкиПометкаУдаления
	|ИЗ
	|	Справочник.РейсыМоре КАК РейсыМоре
	|ГДЕ
	|	РейсыМоре.Ссылка = &МорскойРейс";
	
	Запрос.УстановитьПараметр("МорскойРейс", МорскойРейс);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.ПунктНазначенияПометкаУдаления Тогда
			Ответ.ПунктНазначенияПометкаУдаления = Истина;
		КонецЕсли;
		Если Выборка.МестоРазгрузкиПометкаУдаления Тогда
			Ответ.МестоРазгрузкиПометкаУдаления = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ответ;
КонецФункции// Евросиб Рыбьяков К.А. 30.07.2025 ))

