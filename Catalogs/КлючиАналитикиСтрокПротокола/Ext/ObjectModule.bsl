
Процедура ПередЗаписью(Отказ)
	
	Если ЭтоНовый() Тогда
		СсылкаНового = ПолучитьСсылкуНового();
		Если Не ЗначениеЗаполнено(СсылкаНового) Тогда
			СсылкаНового = Справочники.КлючиАналитикиСтрокПротокола.ПолучитьСсылку();
			УстановитьСсылкуНового(СсылкаНового);
		КонецЕсли;
		Наименование = XMLСтрока(СсылкаНового);
	КонецЕсли;
	
	Изменено = ТекущаяДата();
	
КонецПроцедуры

