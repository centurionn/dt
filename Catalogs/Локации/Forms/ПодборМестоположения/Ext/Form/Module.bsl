
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("НазваниеМеста") Тогда
		
		ВызывающаяФормаГУИД = Параметры.ЭтаФормаГУИД;
		
		МассивОтвета = Геосервис_Сервер.ПолучитьКоординатыПоНаименованию(Параметры.НазваниеМеста);
		Для каждого Стр из МассивОтвета Цикл
			ЗаполнитьЗначенияСвойств(ТЧ.Добавить(), Стр);
		КонецЦикла;
		
	КонецЕсли;
	
	//Евросиб Коханенко Н.А. #61705 08.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 08.12.2022 )

КонецПроцедуры

