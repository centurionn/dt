&НаКлиенте
Процедура ЗагрузитьИдентификаторыMAERSKДляГородовСтраны(Команда)
	
	ТекC = Элементы.Список.ТекущаяСтрока;
	Если ТекC <> неопределено Тогда
		Альфа2 = ЭтоСтранаСАльфаДваКодом(ТекC);
		Если Альфа2 <> "" Тогда
			ОткрытьФорму("Справочник.Локации.Форма.ФормаЗагрузкиИдентификаторовМаэрска", Новый Структура("КодСтраныЗагружаемыхГородов, ЛокацияРегиона", Альфа2, ТекC));
		Иначе
			ПоказатьПредупреждение(, "Необходимо выбрать страну с заполненным альфа-2 кодом.");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭтоСтранаСАльфаДваКодом(Локация)
	
	Возврат Локация.Страна.КодАльфа2;
	
КонецФункции

