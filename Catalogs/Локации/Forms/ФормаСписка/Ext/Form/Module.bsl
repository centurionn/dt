&НаКлиенте
Процедура ВосстановитьСвязьСтанцийСДорогами(Команда)
	СтрокИзменено = ВосстановитьСвязьСтанцийСДорогамиНаСервере();
	Сообщить("Обновлено " + СтрокИзменено + " станций.");
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВосстановитьСвязьСтанцийСДорогамиНаСервере()
	
	Результат = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Локации.Ссылка КАК Ссылка,
	               |	Связь_ЭТРАН_DC_Сопоставление.СпрЭтрана.Дорога.КодДороги КАК СпрЭтранаКодДороги
	               |ИЗ
	               |	Справочник.Локации КАК Локации
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Связь_ЭТРАН_DC_Сопоставление КАК Связь_ЭТРАН_DC_Сопоставление
	               |		ПО Локации.Ссылка = Связь_ЭТРАН_DC_Сопоставление.СпрДатакор
	               |ГДЕ
	               |	НЕ Локации.ПометкаУдаления
	               |	И Локации.ЖелезнаяДорога = ЗНАЧЕНИЕ(Справочник.ЖелезныеДороги.ПустаяСсылка)";
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		ЭОбъект = Ответ.Ссылка.ПолучитьОбъект();
		ЭОбъект.ЖелезнаяДорога = Справочники.ЖелезныеДороги.НайтиПоКоду(Ответ.СпрЭтранаКодДороги);
		ЭОбъект.записать();
		
		Результат = Результат + 1;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

