&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	// Евросиб US 90359  TA 91563 Рыбьяков К.А. 30.10.2024 (( закомментировал
	//Если Не ЗначениеЗаполнено(Объект.Родитель) Тогда
	//	ОбщегоНазначенияКлиент.СообщитьПользователю("Нужно заполнить родителя.",,"Объект.Родитель",,Отказ); 
	//КонецЕсли; 
	// Евросиб Рыбьяков К.А. 30.10.2024 ))
	Если Не ЗначениеЗаполнено(Объект.Страна) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Нужно заполнить родителя.",,"Объект.Страна",,Отказ); 
	КонецЕсли; 
//Евросиб Гудкова( 01.06.2021 Ticket№ 
	Если Объект.Недоступен и Не ЗначениеЗаполнено(Объект.НедоступенС) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Нужно заполнить дату начала недоступности.",,"Объект.НедоступенС",,Отказ); 
	КонецЕсли; 
// Евросиб Гудкова) 	

	//ДИТ, Беляев СЮ, ТА49361, 30-03-2022, начало  
	Если Объект.EDIОбменСТерминалами и Не ЗначениеЗаполнено(Объект.EmailОбменаСТерминалами) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Нужно заполнить электронный адрес обмена с Терминалами.",,"Объект.EmailОбменаСТерминалами",,Отказ); 
	КонецЕсли; 	
	//ДИТ, Беляев СЮ, ТА49361, 30-03-2022, конец    
	//Евросиб - АСуслов 15.05.2023 12:48:45 #67494
	//(
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка)
		И Не ПользовательСПолнымиПравами
		И Объект.Тип = ПредопределенноеЗначение("Справочник.ТипыЛокаций.СтанцияЖД") Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиент.СообщитьПользователю("Запрещен ручной ввод локаций с типом «жд станция». Воспользуйтесь обработкой «Загрузка железных дорог, локаций»");
	КонецЕсли;
	//)
	//Евросиб - АСуслов 15.05.2023 12:48:46 #67494 
	
	// ДИТ US 74929 ТА 74933 Сержантова А.С. Начало: 05.10.2023
	Если не ВопросЗадан и Объект.Тип = ПредопределенноеЗначение("Справочник.ТипыЛокаций.Терминал") 
		и не КодCodecoУникален() Тогда
		Отказ = Истина;
		ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗаписьюЗавершение", ЭтаФорма,),
					"Установленное представление в Codeco или синонимы представлений содержатся в карточке другой локации! 
					|Вы уверены, что хотите записать не уникальное значение кода Codeco?", РежимДиалогаВопрос.ДаНет); 
	КонецЕсли;
	// ДИТ US 74929 ТА 74933 Сержантова А.С. Конец: 05.10.2023
	
КонецПроцедуры

