// ДИТ US 74929 ТА 74933 Сержантова А.С. 05.10.2023
&НаСервере
Функция КодCodecoУникален()   
	
	ПредставленияВCodeco = Объект.СписокПредставлений.Выгрузить().ВыгрузитьКолонку("Представление"); 
	ПредставленияВCodeco.Добавить(Объект.ПредставлениеВCodeco);
	Взаимодействия.УдалитьПовторяющиесяЭлементыМассива(ПредставленияВCodeco);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Локации.Ссылка КАК ДругойТерминал
		|ИЗ
		|	Справочник.Локации КАК Локации
		|ГДЕ
		|	Локации.Ссылка <> &ТекущаяСсылка
		|	И Локации.Тип = &ТипТерминал
		|	И Локации.ПредставлениеВCodeco В (&ПредставленияВCodeco)
		|	И Локации.ПредставлениеВCodeco <> """"
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЛокацииСписокПредставлений.Ссылка
		|ИЗ
		|	Справочник.Локации.СписокПредставлений КАК ЛокацииСписокПредставлений
		|ГДЕ
		|	ЛокацииСписокПредставлений.Ссылка <> &ТекущаяСсылка
		|	И ЛокацииСписокПредставлений.Ссылка.Тип = &ТипТерминал
		|	И ЛокацииСписокПредставлений.Представление В (&ПредставленияВCodeco)
		|	И ЛокацииСписокПредставлений.Представление <> """"";
	
	Запрос.УстановитьПараметр("ПредставленияВCodeco", ПредставленияВCodeco);
	Запрос.УстановитьПараметр("ТекущаяСсылка", Объект.Ссылка);
	Запрос.УстановитьПараметр("ТипТерминал", Справочники.ТипыЛокаций.Терминал);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Истина;
	КонецЕсли; 
	
	Возврат Ложь;
	
КонецФункции 

