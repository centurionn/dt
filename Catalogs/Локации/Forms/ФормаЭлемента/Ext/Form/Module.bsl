&НаСервереБезКонтекста
Функция ЗаполнитьЗначенияКвот(Ссылка)
	СтруктураКвоты = Новый Структура("КвотаПорожние, КвотаГруженые", "Не согласовано", "Не согласовано");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КвотыХраненияКТКНаТерминалах.КвотаГруженые КАК КвотаГруженые,
		|	КвотыХраненияКТКНаТерминалах.КвотаПорожние КАК КвотаПорожние
		|ИЗ
		|	РегистрСведений.КвотыХраненияКТКНаТерминалах КАК КвотыХраненияКТКНаТерминалах
		|ГДЕ
		|	КвотыХраненияКТКНаТерминалах.Терминал = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		ТаблицаДетальныеЗаписи = РезультатЗапроса.Выгрузить();
		СтруктураКвоты.Вставить("КвотаПорожние", ?(ТаблицаДетальныеЗаписи[0].КвотаПорожние = -1, "Не согласовано", ТаблицаДетальныеЗаписи[0].КвотаПорожние));
