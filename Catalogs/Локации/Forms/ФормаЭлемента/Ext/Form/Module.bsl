		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Порт"); 
	Иначе
		Элементы.ГруппаГоризонтальныеСвязиЛокаций.Видимость = Ложь;
	КонецЕсли;
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.ПравоеЗначение = Объект.Ссылка;   
	//)
	//Евросиб - АСуслов 03.07.2023 15:09:46 #67519 
