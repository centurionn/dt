	Объект.СписокПредставлений.Очистить();
	Для каждого Представление Из ПредставленияCodeco Цикл
		НС = Объект.СписокПредставлений.Добавить();
		НС.Представление = Представление;
	КонецЦикла;    
	Если не ЗначениеЗаполнено(Объект.ПредставлениеВCodeco) и ПредставленияCodeco.Количество() Тогда
		Объект.ПредставлениеВCodeco = ПредставленияCodeco[0];
