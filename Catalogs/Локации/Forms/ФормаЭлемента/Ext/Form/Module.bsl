&НаКлиенте
Процедура ОпределитьКоординаты(Команда)
	
	ОткрытьФорму("Справочник.Локации.Форма.ПодборМестоположения", Новый Структура("НазваниеМеста, ЭтаФормаГУИД", Объект.Наименование, Строка(ЭтаФорма.УникальныйИдентификатор)));
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ВыбраныКоординаты" И Источник = Строка(ЭтаФорма.УникальныйИдентификатор) Тогда
		
		Объект.Широта = Параметр.Широта;
		Объект.Долгота = Параметр.Долгота;
		Объект.Адрес = Параметр.Адрес;
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Элементы.НадписьИерархияЭлемента.Заголовок = Справочники.Локации.ПолучитьТекстИерархииЭлемента(Объект.Ссылка);
	КонецЕсли;
	Аналоги.Параметры.УстановитьЗначениеПараметра("Л1", Объект.Ссылка);
	РасстоянияМеждуЛокациями.Параметры.УстановитьЗначениеПараметра("Локация", Объект.Ссылка);
	
	Если Параметры.Свойство("НовыйСток") тогда
		Объект.Родитель = Параметры.Родитель;
		Объект.Тип = Справочники.ТипыЛокаций.Сток;
	КонецЕсли;
	
	// Евросиб Фролов (06.12.2021 Task №42618
	// СтандартныеПодсистемы.КонтактнаяИнформация
    ДополнительныеПараметры = УправлениеКонтактнойИнформацией.ПараметрыКонтактнойИнформации();
    ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаКонтактнаяИнформация");
    УправлениеКонтактнойИнформацией.ПриСозданииНаСервере(ЭтотОбъект, Объект, ДополнительныеПараметры);
    // Конец СтандартныеПодсистемы.КонтактнаяИнформация
	// Евросиб Фролов)
	
	//Евросиб Коханенко Н.А. #61705 08.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 08.12.2022 )
	//Евросиб - АСуслов 02.02.2023 9:32:16 #64514
	//(                          
	РаботаСДМРазрешена = Пользователи.РолиДоступны("ПолныеПрава, dc_РаботаСДетскийМир");
	Если РаботаСДМРазрешена Тогда
		КонтрагентДетскийМир = Константы.КонтрагентДетскийМир.Получить();
		РаботаСДМРазрешена = ЗначениеЗаполнено(КонтрагентДетскийМир);
	КонецЕсли;
	Элементы.ГруппаКодДетскийМир.Видимость = РаботаСДМРазрешена;
	//)
	//Евросиб - АСуслов 02.02.2023 9:32:18 #64514
	//Евросиб - АСуслов 03.07.2023 15:09:18 #67519
	//(
	ЭлементОтбора = ГоризонтальныеСвязиЛокаций.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Если Объект.Тип = Справочники.ТипыЛокаций.СтанцияЖД Тогда
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЖДСтанция");
	ИначеЕсли Объект.Тип = Справочники.ТипыЛокаций.Терминал Тогда	
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Терминал"); 
		//Евросиб Коханенко Н.А. 27.05.2025 (( #106848
		Элементы.КластерНаселенногоПунктаДляЧистогоСтока.Видимость = Истина;
		//Евросиб Коханенко Н.А. 27.05.2025 )) #106848 
