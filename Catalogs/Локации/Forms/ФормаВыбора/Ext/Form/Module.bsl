&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка) 
	//ДИТ Беляев СЮ, TA 41046, 18-11-2021 ++
	Если ЭтаФорма.ВладелецФормы = Неопределено Тогда
		Возврат;
	КонецЕсли;                              
	//ДИТ Беляев СЮ, TA 41046, 18-11-2021 --  
	
	//Если НЕ ТипЗнч(ЭтаФорма.ВладелецФормы) = Тип("ПолеФормы") Тогда
	//ДИТ Беляев СЮ, TA 41046, 18-11-2021 ++
	Если НЕ ТипЗнч(ЭтаФорма.ВладелецФормы) = Тип("ПолеФормы") И НЕ ТипЗнч(ЭтаФорма.ВладелецФормы) = Тип("ТаблицаФормы") Тогда 
	//ДИТ Беляев СЮ, TA 41046, 18-11-2021 --
		Если ЭтаФорма.ВладелецФормы.ИмяФормы = "ОбщаяФорма.Мультилокации" Тогда
			Оповестить("ЗакрытиеФормыВыбораЛокацииДляМультилокации",Элементы.Список.ТекущаяСтрока,ЭтаФорма.ВладелецФормы.УникальныйИдентификатор);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ПодобратьАдресПоГеокодеру(Команда) 
	АдресВНаселенномПункте = НайтиАдресВНаселенномПункте(АдресВЛокации);
	Если ЗначениеЗаполнено(АдресВНаселенномПункте) Тогда
		ЗавершениеУточненияАдреса(АдресВНаселенномПункте, Неопределено);
	КонецЕсли;
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("Режим", "СозданиеСВыборомНаселенногоПункта");
	//ПараметрыОткрытияФормы.Вставить("Локация", Элементы.Список.ТекущаяСтрока);
	ПараметрыОткрытияФормы.Вставить("Локация", Неопределено);
	ПараметрыОткрытияФормы.Вставить("АдресВЛокации", АдресВЛокации);
    СтатусПоследнегоЗапроса = ГеокодированиеВызовСервера.ПроверитьГеокодПоИсторииЗапросов(АдресВЛокации);
	Если СтатусПоследнегоЗапроса = ПредопределенноеЗначение("Перечисление.СтатусыОбработкиЗапросаГеокодера.ОтветПолученНеЗаписан") Тогда
		ОписаниеОповещенияВопросаГеокодера = Новый ОписаниеОповещения("ПродолжитьОткрытиеФормыПодбораАдреса", ЭтотОбъект, ПараметрыОткрытияФормы);
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить(КодВозвратаДиалога.Отмена, "Отмена");
		СписокКнопок.Добавить(КодВозвратаДиалога.Ок, "Отправить запрос в текущем виде");
		ПоказатьВопрос(ОписаниеОповещенияВопросаГеокодера, "При предыдущей отправке аналогичного значения системе не удалось найти подходящий условиям поиска адрес в адресном классификаторе.
		|Попробуйте изменить введенное значение перед его отправкой. Отправить запрос в текущем виде?", СписокКнопок);
	Иначе
		ПродолжитьОткрытиеФормыПодбораАдреса(Неопределено, ПараметрыОткрытияФормы);
	КонецЕсли;
КонецПроцедуры  

&НаКлиенте
Процедура ПродолжитьОткрытиеФормыПодбораАдреса(Параметр1, Параметр2) Экспорт
	Если Параметр1 = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;  
 	Оповещение = Новый ОписаниеОповещения("ЗавершениеУточненияАдреса", ЭтотОбъект, Новый Структура);
	//ГеокодированиеКлиент.НачалоВыбораАдреса(ЭтаФорма, Элементы.Адрес, Неопределено, Ложь, Неопределено, НаименованиеЛокации, ЛокацияВышестоящегоУровня);
	//ГеокодированиеКлиент.НачалоВыбораАдреса(ЭтаФорма, Элементы.АдресВЛокации, Неопределено, Ложь, Неопределено);
	//ОткрытьФорму("Справочник.АдресаВНаселенныхПунктах.Форма.ФормаПодбораАдреса", Параметр2, ЭтаФорма, ,,,Оповещение);
	ОткрытьФорму("ОбщаяФорма.ФормаПодбораАдресаПоГеокодеруЯндекс", Параметр2, ЭтаФорма,,,,Оповещение);
КонецПроцедуры


&НаСервереБезКонтекста
Функция НайтиАдресВНаселенномПункте(Адрес)
	//1 ищем адрес в справочнике
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АдресаВНаселенныхПунктах.Ссылка КАК СсылкаАдрес,
	|	АдресаВНаселенныхПунктах.Владелец КАК НаселенныйПункт
	|ИЗ
	|	Справочник.АдресаВНаселенныхПунктах КАК АдресаВНаселенныхПунктах
	|ГДЕ
	|	АдресаВНаселенныхПунктах.Адрес = &Адрес
	|	И НЕ АдресаВНаселенныхПунктах.ПометкаУдаления";
	Запрос.УстановитьПараметр("Адрес", Адрес);
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Возврат Результат.Выгрузить()[0].СсылкаАдрес;   
	КонецЕсли;
КонецФункции


&НаКлиенте
Процедура ЗавершениеУточненияАдреса(Результат, Параметры) Экспорт
	ОповеститьОВыборе(Результат);
	Если Открыта() Тогда
		Закрыть(Результат);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура АдресВЛокацииОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	АдресВЛокации = Текст;
	ПодобратьАдресПоГеокодеру(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Закрыть(ВыбранноеЗначение);
КонецПроцедуры

