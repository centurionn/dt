
&НаКлиенте
Процедура ЗагрузитьАдресныйКлассификатор(Команда)
	
	ОткрытьФорму("РегистрСведений.АдресныеОбъекты.Форма.ЗагрузкаАдресногоКлассификатора");
	
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	ЗагруженныеРегионы.Очистить();
	ОбновитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	АдресныеОбъекты.КодСубъектаРФ КАК КодСубъектаРФ,
	               |	АдресныеОбъекты.Наименование КАК Наименование
	               |ИЗ
	               |	РегистрСведений.АдресныеОбъекты КАК АдресныеОбъекты
	               |ГДЕ
	               |	АдресныеОбъекты.Уровень = &Уровень
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	КодСубъектаРФ";
	Запрос.УстановитьПараметр("Уровень", 1);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		НСтр = ЗагруженныеРегионы.Добавить();
		НСтр.КодСубъекта = Ответ.КодСубъектаРФ;
		НСтр.Наименование = Ответ.Наименование;
		НСтр.ЗагруженыУлицы = ЗагруженыУлицы(Ответ.КодСубъектаРФ);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ЗагруженыУлицы(Субъект)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	АдресныеОбъекты.Идентификатор КАК Идентификатор
	               |ИЗ
	               |	РегистрСведений.АдресныеОбъекты КАК АдресныеОбъекты
	               |ГДЕ
	               |	АдресныеОбъекты.КодСубъектаРФ = &КодСубъектаРФ
	               |	И (АдресныеОбъекты.Уровень = 4)";
	Запрос.УстановитьПараметр("КодСубъектаРФ", Субъект);
	Запрос.УстановитьПараметр("Уровень", 7);
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	СоздатьРегионы = Истина;
	Обновить(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьЛокации(Команда)
	ЗаписатьЛокацииНаСервере();
	ПоказатьПредупреждение(, "Создание структуры локаций завершено!");
КонецПроцедуры

&НаСервере
Процедура ЗаписатьЛокацииНаСервере()
	
	Для каждого Стр из ЗагруженныеРегионы Цикл
		
		Если НЕ Стр.Пометка Тогда Продолжить; КонецЕсли;
		
		Если СоздатьРегионы Тогда ПроверитьСоздатьРегион(Стр.КодСубъекта, Стр.Наименование); КонецЕсли;
		Если СоздатьУлицы Тогда ПроверитьСоздатьГородаРегиона(Стр.КодСубъекта, Стр.Наименование); КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьСоздатьРегион(КодСубъекта, Наименование)
	
	Регион = НайтиРегион(КодСубъекта, Наименование);
	
	Если Регион = неопределено Тогда
		
		НЛокация 				= Справочники.Локации.СоздатьЭлемент();
		НЛокация.Адрес 			= "РОССИЯ, " + Наименование;
		НЛокация.Наименование 	= Наименование;
		НЛокация.Родитель 		= Справочники.Локации.РОССИЯ;
		НЛокация.Страна			= Справочники.СтраныМира.Россия;
		//Евросиб - АСуслов 05.05.2023 11:27:16 #67492
		//(
		//НЛокация.Тип 			= Справочники.ТипыЛокаций.Субъект;
		НЛокация.Тип 			= Справочники.ТипыЛокаций.НаселенныйПункт;
		//)
		//Евросиб - АСуслов 05.05.2023 11:27:25 #67492
		НЛокация.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НайтиРегион(КодСубъекта, Наименование)
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Локации.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Локации КАК Локации
	               |ГДЕ
	               |	Локации.Родитель = &Родитель
	               |	И Локации.Тип = &Тип
	               |	И НЕ Локации.ПометкаУдаления
	               |	И Локации.Наименование = &Наименование";
	Запрос.УстановитьПараметр("Родитель", Справочники.Локации.РОССИЯ);
	//Евросиб - АСуслов 05.05.2023 11:27:55 #67492
	//(
	//Запрос.УстановитьПараметр("Тип", Справочники.ТипыЛокаций.Субъект);
	Запрос.УстановитьПараметр("Тип", Справочники.ТипыЛокаций.НаселенныйПункт);
	//)
	//Евросиб - АСуслов 05.05.2023 11:28:05 #67492
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПроверитьСоздатьГородаРегиона(КодСубъекта, Наименование)
	
	ТекРегион = НайтиРегион(КодСубъекта, Наименование);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	АдресныеОбъекты.Наименование КАК Наименование,
	               |	АдресныеОбъекты.Сокращение КАК Сокращение
	               |ИЗ
	               |	РегистрСведений.АдресныеОбъекты КАК АдресныеОбъекты
	               |ГДЕ
	               |	АдресныеОбъекты.КодСубъектаРФ = &КодСубъектаРФ
	               |	И (АдресныеОбъекты.Уровень = 1 ИЛИ АдресныеОбъекты.Уровень = 4)";
	Запрос.УстановитьПараметр("КодСубъектаРФ", КодСубъекта);
	Запрос.УстановитьПараметр("Уровень", 7);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		НовоеНаименование = "" + Ответ.Сокращение + " " + Ответ.Наименование;
		Улица = НайтиУлицу(ТекРегион, НовоеНаименование);
		Если Улица = неопределено Тогда
			НЛокация = Справочники.Локации.СоздатьЭлемент();
			НЛокация.Адрес = "РОССИЯ, " + ТекРегион + ", " + НовоеНаименование;
			НЛокация.Наименование = НовоеНаименование;
			НЛокация.Родитель = ТекРегион;
			НЛокация.Страна = Справочники.СтраныМира.Россия;
			//Евросиб - АСуслов 05.05.2023 11:28:22 #67492
			//(
			//НЛокация.Тип = Справочники.ТипыЛокаций.Субъект;
			НЛокация.Тип = Справочники.ТипыЛокаций.НаселенныйПункт;
			//)
			//Евросиб - АСуслов 05.05.2023 11:28:27 #67492
			НЛокация.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

