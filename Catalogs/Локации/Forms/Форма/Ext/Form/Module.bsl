
&НаКлиенте
Процедура ВыбратьФайл(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие); 
	Диалог.Заголовок = "Выберите файлы для загрузки"; 
	Диалог.МножественныйВыбор = Истина;
	ОбработкаОкончанияЗагрузки = Новый ОписаниеОповещения("Обработчик_Завершения_Загрузки", ЭтаФорма); 
	ОповещениеПередНачаломПередачи = Новый ОписаниеОповещения("СохранениеИменФайлов", ЭтаФорма);
	НачатьПомещениеФайлов(ОбработкаОкончанияЗагрузки, Диалог, Истина, УникальныйИдентификатор, ОповещениеПередНачаломПередачи);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранениеИменФайлов(Параметр1 = неопределено, Параметр2 = неопределено, Параметр3 = неопределено) Экспорт
	
	ТЧИмен.Очистить();
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	Для каждого Стр из Параметр1 Цикл
		ф = ТЧИмен.Добавить();
		ф.Идентификатор = Стр.ИдентификаторФайла;
		ф.ИФ = Стр.Имя;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Обработчик_Завершения_Загрузки(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	СписокФайловДляСохраненияНаСервере = Новый Массив;
	ТЧ.Очистить();
	
	Для каждого Стр из Параметр1 Цикл
		
		ИмяФайла = "";
		Для каждого Стр2 из ТЧИмен Цикл
			Если Стр.ИдентификаторФайла = Стр2.Идентификатор Тогда ИмяФайла = Стр2.ИФ; КонецЕсли;
		КонецЦикла;
		ДДФайла = ПолучитьИзВременногоХранилища(Параметр1[0].Хранение);
		
		СписокФайловДляСохраненияНаСервере.Добавить(Новый Структура("ИмяФайла, ТекстФайла, ИсходноеРасположение, Документ", ИмяФайла, ДДФайла, ИмяФайла, Параметр2));
		
	КонецЦикла;
	
	Обработчик_Завершения_Загрузки_Сервер(СписокФайловДляСохраненияНаСервере);
	
КонецПроцедуры

&НаСервере
Процедура Обработчик_Завершения_Загрузки_Сервер(СписокФайлов)
	
	Для каждого Стр из СписокФайлов Цикл
		
		ИВФ = ПолучитьИмяВременногоФайла("XLSX");
		Стр.ТекстФайла.Записать(ИВФ);
		ТД = Новый ТабличныйДокумент;
		ТД.Прочитать(ИВФ);
		
		СчСтрок = 2;
		
		КодСтанции = ТД.Область("R"+Формат(СчСтрок, "ЧГ=")+"C1").Текст;
		Пока КодСтанции <> "" и КодСтанции <> неопределено Цикл
			НСтр = ТЧ.Добавить();
			НСтр.КодСтанции = ТД.Область("R"+Формат(СчСтрок, "ЧГ=")+"C1").Текст;
			НСтр.Наименование = ТД.Область("R"+Формат(СчСтрок, "ЧГ=")+"C2").Текст;
			НСтр.Дорога = ТД.Область("R"+Формат(СчСтрок, "ЧГ=")+"C3").Текст;
			
			НСтр.СсылкаСправочника = Справочники.Местоположения.НайтиПоРеквизиту("КодСтанции", НСтр.КодСтанции);
			
			СчСтрок = СчСтрок + 1;
			КодСтанции = ТД.Область("R"+Формат(СчСтрок, "ЧГ=")+"C1").Текст;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьНедостающиеСтанции(Команда)
	ЗаписатьНедостающиеСтанцииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНедостающиеСтанцииНаСервере()
	
	Для каждого Стр из ТЧ Цикл
		Если ЗначениеЗаполнено(Стр.СсылкаСправочника) Тогда Продолжить; КонецЕсли;
		
		НЭлемент = Справочники.Местоположения.СоздатьЭлемент();
		НЭлемент.Родитель = Справочники.Местоположения.Загруженные;
		НЭлемент.ТипМестоположения = Справочники.ТипыМестоположений.ЖДСтанция;
		НЭлемент.КодСтанции = Стр.КодСтанции;
		НЭлемент.Наименование = Стр.Наименование;
		//НЭлемент.Код = Стр.КодСтанции;
		НЭлемент.Записать();
		Стр.СсылкаСправочника = НЭлемент.Ссылка;
		
	КонецЦикла;
	Сообщить("Закончено!");
	
КонецПроцедуры

