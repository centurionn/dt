
&НаКлиенте
Процедура ВыбратьФайл(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие); 
	Диалог.Заголовок = "Выберите файлы для загрузки"; 
	Диалог.МножественныйВыбор = Истина;
	ОбработкаОкончанияЗагрузки = Новый ОписаниеОповещения("Обработчик_Завершения_Загрузки", ЭтаФорма); 
	ОповещениеПередНачаломПередачи = Новый ОписаниеОповещения("СохранениеИменФайлов", ЭтаФорма);
	НачатьПомещениеФайлов(ОбработкаОкончанияЗагрузки, Диалог, Истина, УникальныйИдентификатор, ОповещениеПередНачаломПередачи);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранениеИменФайлов(Параметр1 = неопределено, Параметр2 = неопределено, Параметр3 = неопределено) Экспорт
	
	ТЧИмен.Очистить();
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	Для каждого Стр из Параметр1 Цикл
		ф = ТЧИмен.Добавить();
		ф.Идентификатор = Стр.ИдентификаторФайла;
		ф.ИФ = Стр.Имя;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Обработчик_Завершения_Загрузки(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	СписокФайловДляСохраненияНаСервере = Новый Массив;
	ТЧ.Очистить();
	
	Для каждого Стр из Параметр1 Цикл
		
		ИмяФайла = "";
		Для каждого Стр2 из ТЧИмен Цикл
			Если Стр.ИдентификаторФайла = Стр2.Идентификатор Тогда ИмяФайла = Стр2.ИФ; КонецЕсли;
		КонецЦикла;
		ДДФайла = ПолучитьИзВременногоХранилища(Параметр1[0].Хранение);
		
		СписокФайловДляСохраненияНаСервере.Добавить(Новый Структура("ИмяФайла, ТекстФайла, ИсходноеРасположение, Документ", ИмяФайла, ДДФайла, ИмяФайла, Параметр2));
		
	КонецЦикла;
	
	Обработчик_Завершения_Загрузки_Сервер(СписокФайловДляСохраненияНаСервере);
	
КонецПроцедуры

&НаСервере
Процедура Обработчик_Завершения_Загрузки_Сервер(СписокФайлов)
	
	Для каждого Стр из СписокФайлов Цикл
		
		ИВФ = ПолучитьИмяВременногоФайла("XLSX");
		Стр.ТекстФайла.Записать(ИВФ);
		ТД = Новый ТабличныйДокумент;
		ТД.Прочитать(ИВФ);
		
		СчСтрок = 2;
		
		НаименованиеСтанции = ТД.Область("R"+Формат(СчСтрок, "ЧГ=")+"C2").Текст;
		Пока ЗначениеЗаполнено(НаименованиеСтанции) Цикл
			НСтр = ТЧ.Добавить();
			НСтр.КодСтанции = ТД.Область("R"+Формат(СчСтрок, "ЧГ=")+"C1").Текст;
			НСтр.Наименование = ТД.Область("R"+Формат(СчСтрок, "ЧГ=")+"C2").Текст;
			НСтр.НаименованиеАнгл = ТД.Область("R"+Формат(СчСтрок, "ЧГ=")+"C3").Текст;
			НСтр.СтранаКод = ТД.Область("R"+Формат(СчСтрок, "ЧГ=")+"C4").Текст;
			НСтр.СтранаНаименование = ТД.Область("R"+Формат(СчСтрок, "ЧГ=")+"C5").Текст;
			НСтр.Дорога = ТД.Область("R"+Формат(СчСтрок, "ЧГ=")+"C6").Текст;
			НСтр.ДорогаНаименование = ТД.Область("R"+Формат(СчСтрок, "ЧГ=")+"C7").Текст;
			//СтруктураНаименования = СтрРазделить(СтрЗаменить(НСтр.Наименование, ", ", "@"), "@", Ложь);
			//Если СтруктураНаименования.Количество() > 1 Тогда
			//	НСтр.ДорогаНаименование = СтруктураНаименования[СтруктураНаименования.Количество()-1];
			//КонецЕсли;
			Если ЗначениеЗаполнено(НСтр.КодСтанции) Тогда
				НСтр.СсылкаСправочника = Справочники.Локации.НайтиПоРеквизиту("КодЖДСтанции", НСтр.КодСтанции);
			Иначе
				Локация = Справочники.Локации.НайтиПоНаименованию(НСтр.Наименование, Истина);
				Если Локация.Тип = Справочники.ТипыЛокаций.СтанцияЖД Тогда
					НСтр.СсылкаСправочника = Локация; //Справочники.Локации.НайтиПоНаименованию(НСтр.Наименование, Истина);
				КонецЕсли; 
			КонецЕсли; 
			
			СчСтрок = СчСтрок + 1;
			НаименованиеСтанции = ТД.Область("R"+Формат(СчСтрок, "ЧГ=")+"C2").Текст;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьНедостающиеСтанции(Команда)
	
	ЗаписатьНедостающиеСтанцииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНедостающиеСтанцииНаСервере()
	
	Для каждого Стр из ТЧ Цикл
		Если ЗначениеЗаполнено(Стр.СсылкаСправочника) Тогда 
		//	Продолжить;
			НЭлемент = Стр.СсылкаСправочника.ПолучитьОбъект();
		Иначе
			НЭлемент = Справочники.Локации.СоздатьЭлемент();
		КонецЕсли;
		Отбор = Новый Структура("Наименование", Стр.СтранаНаименование);
		Выборка = Справочники.Локации.Выбрать(,,Отбор);
		Страна = Неопределено;
		Пока Выборка.Следующий() Цикл
			Если Выборка.Тип = Справочники.ТипыЛокаций.Страна Тогда
				Страна = Выборка.Ссылка;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ЗначениеЗаполнено(Страна) Тогда
			НЭлемент.Родитель 			= Страна;
		Иначе
			НЭлемент.Родитель 			= Справочники.Локации.Загруженные;
		КонецЕсли; 
		НЭлемент.Страна = Справочники.СтраныМира.НайтиПоКоду(Стр.СтранаКод);
		НЭлемент.Тип 				= Справочники.ТипыЛокаций.СтанцияЖД;
		НЭлемент.КодЖДСтанции 		= Стр.КодСтанции;
		НЭлемент.Наименование 		= Стр.Наименование;
		Если ЗначениеЗаполнено(Стр.Дорога) Тогда
			НЭлемент.ЖелезнаяДорога		= Локации_сервер.ПолучитьЖелезнуюДорогуПоКоду(Стр.Дорога, Стр.ДорогаНаименование);
		КонецЕсли; 
		
		НЭлемент.Записать();
		Стр.СсылкаСправочника 		= НЭлемент.Ссылка;
		
	КонецЦикла;
	Сообщить("Закончено!");
	
КонецПроцедуры

