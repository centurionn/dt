&НаКлиенте
Процедура ЗаполнятьПоПервойСтрокеПриИзменении(Элемент)
	
	Если НЕ ЗаполнятьПоПервойСтроке Тогда
		Возврат;
	КонецЕсли;
	Если СписокВагонов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранныйКлиент = "";
	ВыбранныйДоговор = "";
	ВыбраннаяКалькуляция = "";
	
	СтрокаСКлиентом = СписокВагонов.Получить(0);
	ВыбранныйКлиент = СтрокаСКлиентом.Клиент;
	ВыбранныйДоговор = СтрокаСКлиентом.Договор;
	ВыбраннаяКалькуляция = СтрокаСКлиентом.Калькуляция;
	
	Для Каждого Стр Из СписокВагонов Цикл
		Стр.Клиент = ВыбранныйКлиент;
		Стр.Договор = ВыбранныйДоговор;
		Стр.Калькуляция = ВыбраннаяКалькуляция;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВагоновПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если СписокВагонов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекД = Элементы.СписокВагонов.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НоваяСтрока И ЗаполнятьПоПервойСтроке Тогда
		СтрокаСКлиентом = СписокВагонов.Получить(0);
		ВыбранныйКлиент = СтрокаСКлиентом.Клиент;
		ВыбранныйДоговор = СтрокаСКлиентом.Договор;
		ВыбраннаяКалькуляция = СтрокаСКлиентом.Калькуляция;
		ТекД.Клиент = ВыбранныйКлиент;
		ТекД.Договор = ВыбранныйДоговор;
		ТекД.Калькуляция = ВыбраннаяКалькуляция;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВагоновПриИзменении(Элемент)
	
	ТекД = Элементы.СписокВагонов.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Элементы.СписокВагонов.ТекущаяСтрока = 0 И ЗаполнятьПоПервойСтроке Тогда
		ВыбранныйКлиент = ТекД.Клиент;
		ВыбранныйДоговор = ТекД.Договор;
		ВыбраннаяКалькуляция = ТекД.Калькуляция;
		
		Для Каждого Стр Из СписокВагонов Цикл
			Стр.Клиент = ВыбранныйКлиент;
			Стр.Договор = ВыбранныйДоговор;
			Стр.Калькуляция = ВыбраннаяКалькуляция;
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура СписокВагоновДоговорПриИзменении(Элемент)
	
	ТекД = Элементы.СписокВагонов.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекД.Калькуляция = ПолучитьДанныеПоКалькуляции(ТекД.Клиент,ТекД.Договор);
КонецПроцедуры
