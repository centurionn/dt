
&НаСервере
Процедура ПривязатьТипоразмерыПоПаспортамВагоновНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПаспортаВагоновСрезПоследних.Вагон КАК Вагон,
	               |	ТипоразмерыТСОбозначенияМоделиВагона.Ссылка КАК ТипТС
	               |ИЗ
	               |	РегистрСведений.ПаспортаВагонов.СрезПоследних КАК ПаспортаВагоновСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТипоразмерыТС.ОбозначенияМоделиВагона КАК ТипоразмерыТСОбозначенияМоделиВагона
	               |		ПО ПаспортаВагоновСрезПоследних.МодельВагона = ТипоразмерыТСОбозначенияМоделиВагона.Обозначение
	               |ГДЕ
	               |	ПаспортаВагоновСрезПоследних.Вагон.ТипТС = ЗНАЧЕНИЕ(Справочник.ТипоразмерыТС.ПустаяСсылка)";
	Ответ  = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		ОВагон = Ответ.Вагон.ПолучитьОбъект();
		ОВагон.ТипТС = Ответ.ТипТС;
		ОВагон.Записать();
		Сообщить("Вагону " + Ответ.Вагон + " присвоен ТипТС " + Ответ.ТипТС);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПроставитьУсловныеДлиныПоПаспортамВагоновНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ТС.ТипТС КАК ТипТС,
	               |	ПаспортаВагоновСрезПоследних.МодельВагона КАК МодельВагона,
	               |	ПаспортаВагоновСрезПоследних.ДлинаПоОсямАвтосцепки КАК ДлинаПоОсямАвтосцепки
	               |ИЗ
	               |	РегистрСведений.ПаспортаВагонов.СрезПоследних КАК ПаспортаВагоновСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТС КАК ТС
	               |		ПО ПаспортаВагоновСрезПоследних.Вагон = ТС.Ссылка";
	Ответ  = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Ответ.ТипТС) Тогда
			ОТип = Ответ.ТипТС.ПолучитьОбъект();
			ОТип.УсловнаяДлина = (Ответ.ДлинаПоОсямАвтосцепки / 13920);
			ОТип.Записать();
			Сообщить("Типу " + Ответ.ТипТС + " присвоена условная длина " + ОТип.УсловнаяДлина);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПривязатьТипоразмерыПоПаспортамВагонов(Команда)
	ПривязатьТипоразмерыПоПаспортамВагоновНаСервере();
	ПоказатьПредупреждение(, "Работа мастера сопоставления завершена. Благодарим за использование.");
КонецПроцедуры

