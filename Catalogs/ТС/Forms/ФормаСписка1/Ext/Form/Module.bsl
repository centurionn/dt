&НаКлиенте
Процедура ПослеВводаЗначения(ВыбЗнач, Параметры) Экспорт
    Если ВыбЗнач<>Неопределено Тогда
        ЗанестиВРеестрПовагонкиСервер(ВыбЗнач);
    КонецЕсли;
КонецПроцедуры

&НаСервере
Функция СтанцияИзДислокации(НомерВаг)
	
	СтнОтпр = Справочники.Локации.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДислокацияВагоновСрезПоследних.СтанцияОперации КАК СтанцияОперации
	               |ИЗ
	               |	РегистрСведений.ДислокацияВагонов.СрезПоследних(, Вагон = &Вагон) КАК ДислокацияВагоновСрезПоследних";
	Запрос.УстановитьПараметр("Вагон",Справочники.ТС.НайтиПоНаименованию(НомерВаг));
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ТЗ = РезультатЗапроса.Выгрузить();
		СтнОтпр = ТЗ[0].СтанцияОперации;
	КонецЕсли;
	
	Возврат СтнОтпр;
	
КонецФункции

&НаСервере
Процедура ЗанестиВРеестрПовагонкиСервер(МассивВагонов)
	
	Для Каждого Элем Из МассивВагонов Цикл
		НоваяЗапись = РегистрыСведений.ПовагонныеОтправки.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(НоваяЗапись,Элем);
		НоваяЗапись.Период = Элем.ДатаНачала;
		НоваяЗапись.Записать(Истина);
	КонецЦикла;
	
КонецПроцедуры











