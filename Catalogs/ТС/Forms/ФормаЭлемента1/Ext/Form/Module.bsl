
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Вагон", Объект.Ссылка);
		Запрос.УстановитьПараметр("ПериодСегодня", ТекущаяДата());
		Запрос.Текст = "ВЫБРАТЬ
		               |	*
		               |ИЗ
		               |	РегистрСведений.ПаспортаВагонов.СрезПоследних(, Вагон = &Вагон) КАК ПаспортаВагоновСрезПоследних";
		Ответ = Запрос.Выполнить().Выбрать();
		Если Ответ.Следующий() Тогда
			ВАренде = Ответ.ВАренде;
			ВидСледующегоПлановогоРемонта = Ответ.ВидСледующегоПлановогоРемонта;
			Грузоподъемность = Ответ.Грузоподъемность;
			ДатаНазначенияСостояния = Ответ.ДатаНазначенияСостояния;
			ДатаОкончанияАренды = Ответ.ДатаОкончанияАренды;
			ДатаПоследнегоДеповскогоРемонта = Ответ.ДатаПоследнегоДеповскогоРемонта;
			ДатаПоследнегоКапРемонта = Ответ.ДатаПоследнегоКапРемонта;
			ДатаСледующегоПлановогоРемонта = Ответ.ДатаСледующегоПлановогоРемонта;
			ДепоПоследнегоДеповскогоРемонта = Ответ.ДепоПоследнегоДеповскогоРемонта;
			ДепоПоследнегоКапРемонта = Ответ.ДепоПоследнегоКапРемонта;
			КодМоделиВагона = Ответ.КодМоделиВагона;
			КодРЖДАрендатора = Ответ.КодРЖДАрендатора;
			КодРЖДСобственника = Ответ.КодРЖДСобственника;
			КодСостоянияВагона = Ответ.КодСостоянияВагона;
			МодельВагона = Ответ.МодельВагона;
			Ошибки = Ответ.Ошибки;
			ПрежнийНомерВагона = Ответ.ПрежнийНомерВагона;
			ПричинаЗапретаНаКурсирование = Ответ.ПричинаЗапретаНаКурсирование;
			РемонтПоПробегу = ответ.РемонтПоПробегу;
			СрокСлужбыВагона = Ответ.СрокСлужбыВагона;
			СрокСлужбыВагонаПродлен = Ответ.СрокСлужбыВагонаПродлен;
			СтанцияПриписки = Ответ.СтанцияПриписки;
			СтанцияПрипискиАренды = Ответ.СтанцияПрипискиАренды;
			ТипВагона = Ответ.ТипВагона;
			ДатаАктуальностиПаспорта = Ответ.Период;
			//Евросиб Каблов 24.02.2020 (
			Собственник = Ответ.Собственник;
			Арендатор = Ответ.Арендатор;
			ЗаполнитьЗначенияСвойств(ЭтаФорма, Ответ);
			//Евросиб Каблов 24.02.2020 )
		КонецЕсли;
		
		Запрос.Текст = "ВЫБРАТЬ
		               |	*
		               |ИЗ
		               |	РегистрСведений.ПробегиВагонов.СрезПоследних(, Вагон = &Вагон) КАК ПробегиВагоновСрезПоследних";
		Ответ = Запрос.Выполнить().Выбрать();
		Если Ответ.Следующий() Тогда
			ПолныйПробег = Ответ.ПолныйПробег;
			ОстаточныйПробег = Ответ.ОстаточныйПробег;
			ПорогПробега = Ответ.ПорогПробега;
			НормативныйПробег = Ответ.НормативныйПробег;
		КонецЕсли;
		
		Запрос.Текст = "ВЫБРАТЬ
		               |	ВагоныНаСлеженииСрезПоследних.Период КАК Слежение_Период,
		               |	ВагоныНаСлеженииСрезПоследних.НаСлежении КАК НаСлежении,
		               |	ПризнакСобственностиВагонаСрезПоследних.Период КАК Собств_Период,
		               |	ПризнакСобственностиВагонаСрезПоследних.ПризнакСобственности КАК ПризнакСобственности,
		               |	ПризнакСобственностиВагонаСрезПоследних.ВЭксплуатации КАК ВЭксплуатации
		               |ИЗ
		               |	РегистрСведений.ВагоныНаСлежении.СрезПоследних(&ПериодСегодня, Вагон = &Вагон) КАК ВагоныНаСлеженииСрезПоследних
		               |		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакСобственностиВагона.СрезПоследних(&ПериодСегодня, Вагон = &Вагон) КАК ПризнакСобственностиВагонаСрезПоследних
		               |		ПО ВагоныНаСлеженииСрезПоследних.Вагон = ПризнакСобственностиВагонаСрезПоследних.Вагон";
		Ответ = Запрос.Выполнить().Выбрать();
		Если Ответ.Следующий() Тогда
			ВЭксплуатации = Ответ.ВЭксплуатации;
			ВидСобственности = Ответ.ПризнакСобственности;
			ДатаОбновленияСобственности = Ответ.Собств_Период;
			НаСлежении = Ответ.НаСлежении;
			ДатаОбновленияСлежения = Ответ.Слежение_Период;
		КонецЕсли;
		
	КонецЕсли;
	
	//Евросиб Каблов 29.05.2023 ( 70291
	//Если ЗначениеЗаполнено(Объект.ТипТС) Тогда
	//	
	//	Элементы.ГруппаВагон.Видимость = Объект.ТипТС.Вагон;
	//	Элементы.ГруппаСудно.Видимость = Объект.ТипТС.Судно;
	//	Элементы.ГруппаАвто.Видимость = Объект.ТипТС.Авто;
	//	
	//КонецЕсли;
	
	ДоступнаНастройкаРефрижераторныхУчетныхЕдиниц = РольДоступна("dc_НастройкаРефрижераторныхУчетныхЕдиниц") Или РольДоступна("ПолныеПрава");
	Элементы.ЭлектрифицированнаяФТГ.ТолькоПросмотр = Не ДоступнаНастройкаРефрижераторныхУчетныхЕдиниц; 
	//Евросиб Каблов 29.05.2023 )
	
	
	//Евросиб Коханенко Н.А. #61705 08.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 08.12.2022 )

КонецПроцедуры

