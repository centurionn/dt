&НаСервере
Процедура УстановитьВидимостьВкладок()
	
	Если ЗначениеЗаполнено(Объект.ТипТС) Тогда
		
		Элементы.ГруппаВагон.Видимость = Объект.ТипТС.Вагон;
		Элементы.ГруппаСудно.Видимость = Объект.ТипТС.Судно;
		Элементы.ГруппаАвто.Видимость = Объект.ТипТС.Авто;
		
	Иначе
		
		Элементы.ГруппаВагон.Видимость = Ложь;
		Элементы.ГруппаСудно.Видимость = Ложь;
		Элементы.ГруппаАвто.Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТипТСПриИзменении(Элемент)
	
	//Евросиб Каблов 29.05.2023 ( 70291
	УстановитьВидимостьВкладок();
	//Евросиб Каблов 29.05.2023 )
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	//Евросиб Каблов 29.05.2023 ( 70291
	УстановитьВидимостьВкладок();
	//Евросиб Каблов 29.05.2023 )
	
КонецПроцедуры
