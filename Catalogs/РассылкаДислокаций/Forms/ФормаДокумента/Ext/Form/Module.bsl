&НаКлиенте
Процедура КлиентыТЗПередУдалением(Элемент, Отказ)
	
	ТекД = Элементы.КлиентыТЗ.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Клиент",ТекД.Клиент);
	НайденныеСтроки = Объект.РеквизитыВагонов.НайтиСтроки(ПараметрыОтбора);
	Для Каждого Элем Из НайденныеСтроки Цикл
		Объект.РеквизитыВагонов.Удалить(Элем);
	КонецЦикла;
	НайденныеСтроки2 = Объект.РеквизитыКТК.НайтиСтроки(ПараметрыОтбора);
	Для Каждого Элем2 Из НайденныеСтроки2 Цикл
		Объект.РеквизитыКТК.Удалить(Элем2);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КлиентыТЗКлиентПриИзменении(Элемент)
	
	// SIV - отработка кейса изменения контрагента в сохраненных данных;
	
	ТекД = Элементы.КлиентыТЗ.ТекущиеДанные;
	Если ТекД = неопределено Тогда Возврат; КонецЕсли;
	
	Для каждого Стр из Объект.РеквизитыВагонов Цикл
		Если Стр.Клиент = ПоследнийВыбранныйКонтрагент Тогда Стр.Клиент = ТекД.Клиент; КонецЕсли;
	КонецЦикла;
	Для каждого Стр из Объект.РеквизитыКТК Цикл
		Если Стр.Клиент = ПоследнийВыбранныйКонтрагент Тогда Стр.Клиент = ТекД.Клиент; КонецЕсли;
	КонецЦикла;
	
	ПоследнийВыбранныйКонтрагент = ТекД.Клиент;
	КлиентыТЗПриАктивизацииСтроки(неопределено);
	
КонецПроцедуры
