
&НаКлиенте
Процедура КлиентыТЗПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ТекД = Элементы.КлиентыТЗ.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НоваяСтрока И ЗначениеЗаполнено(ТекД.Клиент) Тогда
		ЗаполнитьТаблицуРеквизитами(ТекД.Клиент);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуРеквизитами(ТекКлиент)
	// 1. Вагоны
	ИзмеренияРС = Метаданные.РегистрыСведений.ДислокацияВагонов.Измерения;
	РесурсыРС = Метаданные.РегистрыСведений.ДислокацияВагонов.Ресурсы;
	РеквизитыРС = Метаданные.РегистрыСведений.ДислокацияВагонов.Реквизиты;
	Для Каждого Изм Из ИзмеренияРС Цикл
		НовСтр = Объект.РеквизитыВагонов.Добавить();
		НовСтр.РеквизитКлиентаВСистеме = Изм.Имя;
		НовСтр.РеквизитКлиента = Изм.Синоним;
		НовСтр.Клиент = ТекКлиент;
	КонецЦикла;
	Для Каждого Рес Из РесурсыРС Цикл
		НовСтр = Объект.РеквизитыВагонов.Добавить();
		НовСтр.РеквизитКлиентаВСистеме = Рес.Имя;
		НовСтр.РеквизитКлиента = Рес.Синоним;
		НовСтр.Клиент = ТекКлиент;
	КонецЦикла;
	Для Каждого Рек Из РеквизитыРС Цикл
		НовСтр = Объект.РеквизитыВагонов.Добавить();
		НовСтр.РеквизитКлиентаВСистеме = Рек.Имя;
		НовСтр.РеквизитКлиента = Рек.Синоним;
		НовСтр.Клиент = ТекКлиент;
	КонецЦикла;
	
	// 2. Контейнеры
	ИзмеренияРС = Метаданные.РегистрыСведений.ДислокацияКонтейнеров.Измерения;
	РесурсыРС = Метаданные.РегистрыСведений.ДислокацияКонтейнеров.Ресурсы;
	РеквизитыРС = Метаданные.РегистрыСведений.ДислокацияКонтейнеров.Реквизиты;
	Для Каждого Изм Из ИзмеренияРС Цикл
		НовСтр = Объект.РеквизитыКТК.Добавить();
		НовСтр.РеквизитКлиентаВСистеме = Изм.Имя;
		НовСтр.РеквизитКлиента = Изм.Синоним;
		НовСтр.Клиент = ТекКлиент;
	КонецЦикла;
	Для Каждого Рес Из РесурсыРС Цикл
		НовСтр = Объект.РеквизитыКТК.Добавить();
		НовСтр.РеквизитКлиентаВСистеме = Рес.Имя;
		НовСтр.РеквизитКлиента = Рес.Синоним;
		НовСтр.Клиент = ТекКлиент;
	КонецЦикла;
	Для Каждого Рек Из РеквизитыРС Цикл
		НовСтр = Объект.РеквизитыКТК.Добавить();
		НовСтр.РеквизитКлиентаВСистеме = Рек.Имя;
		НовСтр.РеквизитКлиента = Рек.Синоним;
		НовСтр.Клиент = ТекКлиент;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	Если Элементы.Группа1.ТекущаяСтраница.Имя = "ГруппаВагоны" Тогда
		Для Каждого Стр Из Объект.РеквизитыВагонов Цикл
			Стр.Использование = Истина;
		КонецЦикла;
	Иначе
		Для Каждого Стр Из Объект.РеквизитыКТК Цикл
			Стр.Использование = Истина;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметки(Команда)
	Если Элементы.Группа1.ТекущаяСтраница.Имя = "ГруппаВагоны" Тогда
		Для Каждого Стр Из Объект.РеквизитыВагонов Цикл
			Стр.Использование = Ложь;
		КонецЦикла;
	Иначе
		Для Каждого Стр Из Объект.РеквизитыКТК Цикл
			Стр.Использование = Ложь;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КлиентыТЗПриАктивизацииСтроки(Элемент)
	
	ТекД = Элементы.КлиентыТЗ.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Элементы.РеквизитыВагонов.ОтборСтрок = Новый ФиксированнаяСтруктура("Клиент",ТекД.Клиент);
	Элементы.РеквизитыКТК.ОтборСтрок = Новый ФиксированнаяСтруктура("Клиент",ТекД.Клиент);
	ПоследнийВыбранныйКонтрагент = ТекД.Клиент;
	
КонецПроцедуры

