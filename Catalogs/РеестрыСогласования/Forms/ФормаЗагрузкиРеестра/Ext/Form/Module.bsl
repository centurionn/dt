
&НаКлиенте
Процедура ТДПриИзмененииСодержимогоОбласти(Элемент, Область)
	
	СтрокиТД = 3;

	ЧислаМ = Новый Массив;
	Для Сч = 0 По 9 Цикл 
		ЧислаМ.Добавить(Строка(Сч)); 
	КонецЦикла;
	
	СохраненныйБелый = ТД.Область("R1C15").ЦветФона;
	
	// Анализируем ключ Контейнер + (Номер_заявки или Номер_авто)
	Контейнер = ТД.Область("R"+СтрокиТД+"C5").Текст;
	
	Пока Контейнер <> "" Цикл
		
		НомерЗаявки = ТД.Область("R"+СтрокиТД+"C4").Текст;
		НомерАвто = ТД.Область("R"+СтрокиТД+"C2").Текст;
		
		//Если НайтиЗаявкуВСистеме(Контейнер,НомерЗаявки,НомерАвто) = ПредопределенноеЗначение("Документ.Заявка.ПустаяСсылка") Тогда
		//	ТД.Область("R"+СтрокиТД+"C5").ЦветФона = WebЦвета.Голубой;
		//Иначе
		//	ТД.Область("R"+СтрокиТД+"C5").ЦветФона = СохраненныйБелый;
		//КонецЕсли;
		
		Если СтрДлина(СокрЛП(Контейнер)) = 11 Тогда
			КонтрольныйЗнак = РаботаСКонтейнерамиСервер.ПолучитьКонтрольноеЧисло(Лев(Контейнер,4), Сред(Контейнер,5,6));
		КонецЕсли;
		
		// если контрольный знак не совпал
		Если СтрДлина(СокрЛП(Контейнер)) <> 11  
			ИЛИ КонтрольныйЗнак = "Неверно" ИЛИ ЧислаМ.Найти(Прав(СокрЛП(Контейнер),1)) = неопределено  
			ИЛИ (СтрДлина(СокрЛП(Контейнер)) = 11 И НЕ Число(Прав(СокрЛП(Контейнер),1)) = КонтрольныйЗнак) Тогда
			ТД.Область("R"+СтрокиТД+"C5").ЦветФона = WebЦвета.Розовый;
		// если не нашли заявку, то подсветить номер контейнера
		//ИначеЕсли НайтиЗаявкуВСистеме(Контейнер,НомерЗаявки,НомерАвто) = ПредопределенноеЗначение("Документ.Заявка.ПустаяСсылка") Тогда
		//ДИТ, Беляев СЮ, Ticket#0284531, 06-09-2022, начало
		ИначеЕсли НайтиЗаявкуВСистеме(Контейнер,НомерЗаявки,НомерАвто,Клиент,Договор) = ПредопределенноеЗначение("Документ.Заявка.ПустаяСсылка") Тогда
		//ДИТ, Беляев СЮ, Ticket#0284531, 06-09-2022, конец
			ТД.Область("R"+СтрокиТД+"C5").ЦветФона = WebЦвета.Голубой;
		Иначе
			ТД.Область("R"+СтрокиТД+"C5").ЦветФона = СохраненныйБелый;
		КонецЕсли;
		
		СтрокиТД = СтрокиТД + 1;
		Контейнер = ТД.Область("R"+СтрокиТД+"C5").Текст;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда) 
	//ДИТ, Беляев СЮ, Ticket#0285135, 09-09-2022, начало 
	Если НЕ ЗначениеЗаполнено(НаименованиеРеестра) Тогда
		СтрокиТД = 3;
		ДатаЗагрузки =  ПреобразованиеВДату(СокрЛП(ТД.Область("R"+СтрокиТД+"C6").Текст));
		ДатаВыгрузки =  ПреобразованиеВДату(СокрЛП(ТД.Область("R"+СтрокиТД+"C7").Текст));
		НаименованиеРеестра = ПолучитьНаименованиеДляНовогоЭлемента(Реестр, Клиент, ДатаЗагрузки, ДатаВыгрузки);
	КонецЕсли;

	Если ЕстьРеестрСАналогичнымНаименованием(Реестр, Клиент, НаименованиеРеестра) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Запись отменена, уже есть Реестр с аналогичным наименованием! Требуется изменить наименование на уникальное",
													,"НаименованиеРеестра");
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(НаименованиеРеестра) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Запись отменена, требуется заполнить Наименование реестрае",
													,"НаименованиеРеестра");
		Возврат;
	КонецЕсли;
	//ДИТ, Беляев СЮ, Ticket#0285135, 09-09-2022, конец
	
	Если РежимРаботы = "Контейнеры" Тогда
		СозданныйРеестр = СохранитьНаСервереКТК();
	Иначе
		СозданныйРеестр = СохранитьНаСервереВагоны();
	КонецЕсли;
	Закрыть(СозданныйРеестр);
	
КонецПроцедуры   

