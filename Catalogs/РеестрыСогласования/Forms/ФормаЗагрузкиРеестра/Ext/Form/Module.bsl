						ИначеЕсли СокрЛП(ТекЯчейка) = "18" Тогда
							ТекЭлем = Перечисления.СтавкиНДС.НДС18;  
						// Евросиб(ДИТ) US 96051 ТА 96052 Сержантова А.С. Начало: 25.12.2024
