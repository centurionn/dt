//Функция НайтиЗаявкуПоКускуНомера(ВнешнийНомерЗаявки)
Функция НайтиЗаявкуПоКускуНомера(ВнешнийНомерЗаявки, Контрагент, Договор)
//Евросиб - Дубская 28.06.2022 #0255944	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Заявка.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.Заявка КАК Заявка
	               |ГДЕ
	               |	Заявка.ПометкаУдаления = ЛОЖЬ
	               |	И Заявка.Номер ПОДОБНО &Номер 
		//Евросиб - Дубская 28.06.2022 #0255944 
	               |	&УсловиеПоКонтрагенту
	               |	&УсловиеПоДоговору
		//Евросиб - Дубская 28.06.2022 #0255944 
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Заявка.Дата УБЫВ";
	Запрос.УстановитьПараметр("Номер", "%"+ВнешнийНомерЗаявки);
	//Евросиб - Дубская 28.06.2022 #0255944 
	Если ЗначениеЗаполнено(Контрагент) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКонтрагенту", "И Заявка.Контрагент = &Контрагент"); 
		Запрос.УстановитьПараметр("Контрагент", Контрагент); 
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКонтрагенту", ""); 
	КонецЕсли;	                                            
	Если ЗначениеЗаполнено(Договор) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоДоговору", "И Заявка.Договор = &Договор"); 
		Запрос.УстановитьПараметр("Договор", Договор);  
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоДоговору", ""); 
	КонецЕсли;	                                            
	//Евросиб - Дубская 28.06.2022 #0255944 
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СохранитьНаСервереКТК()
	
	Если ЗначениеЗаполнено(Реестр) Тогда
		СозданныйРеестр = Реестр;
		НовРеестр = СозданныйРеестр.ПолучитьОбъект();
	Иначе
		СозданныйРеестр = Справочники.РеестрыСогласования.ПустаяСсылка();
		НовРеестр = Справочники.РеестрыСогласования.СоздатьЭлемент();
	КонецЕсли;
	
	СтрокиТД = 3;
	
	ПрочСтрока = ТД.Область("R"+СтрокиТД+"C1").Текст;
	
	
	Пока ПрочСтрока <> "" Цикл
		
		НовСтр = НовРеестр.ПереченьКонтейнеров.Добавить(); 

		
		СтолбцыТД = 1;
		
		Пока СтолбцыТД<14 Цикл
			
			ТекЯчейка = ТД.Область("R"+СтрокиТД+"C"+СтолбцыТД).Текст;
			// ищем в справочнике РеестрыСогласования комментарий реквизита с номером = номеру столбца
			РеквизитыТЧ = Метаданные.Справочники.РеестрыСогласования.ТабличныеЧасти.ПереченьКонтейнеров.Реквизиты;
			Для Каждого Рекв Из РеквизитыТЧ Цикл
				Если Рекв.Комментарий = Строка(СтолбцыТД) Тогда
					Если Рекв.Имя = "Контейнер" Тогда
						ТекЭлем = РаботаСКонтейнерамиСервер.НайтиКТК(СокрЛП(ТекЯчейка)); // Справочники.ТЕ.НайтиПоНаименованию(СокрЛП(ТекЯчейка));
					ИначеЕсли Рекв.Имя = "ТипТЕ" Тогда
						ТекЭлем = Справочники.ТипоразмерыТЕ.НайтиПоНаименованию(СокрЛП(ТекЯчейка));
					ИначеЕсли Рекв.Имя = "ДатаЗагрузки" ИЛИ Рекв.Имя = "ДатаВыгрузки" Тогда
						Попытка
							ТекЭлем = ПреобразованиеВДату(СокрЛП(ТекЯчейка));
						Исключение
							НЕтДТ = Истина;
						КонецПопытки;
					ИначеЕсли Рекв.Имя = "ПунктОтправления" ИЛИ Рекв.Имя = "ПунктНазначения" Тогда
						ТекЭлем = ПоискЛокацииВСправочнике(ТекЯчейка);
					Иначе
						ТекЭлем = СокрЛП(ТекЯчейка);
					КонецЕсли;
					
					НовСтр[Рекв.Имя] = ТекЭлем;
					
					Прервать;
					
				КонецЕсли;
			КонецЦикла;
			СтолбцыТД = СтолбцыТД+1;
		КонецЦикла; 
		//Евросиб - АСуслов 22.11.2021 15:58:24 #42467
		//(
		НовСтр.Услуга = Услуга;
		//)
		//Евросиб - АСуслов 22.11.2021 15:58:34 #42467
		
		Если ЗначениеЗаполнено(НовСтр.ВнешнийНомерЗаявки) Тогда
			//Евросиб - Дубская 28.06.2022 #0255944 
			//НовСтр.ЗаявкаВСистеме = НайтиЗаявкуПоКускуНомера(НовСтр.ВнешнийНомерЗаявки);   
			НовСтр.ЗаявкаВСистеме = НайтиЗаявкуПоКускуНомера(НовСтр.ВнешнийНомерЗаявки, Клиент, Договор);   
			//Евросиб - Дубская 28.06.2022 #0255944 
		Иначе
			
			//НовСтр.ЗаявкаВСистеме = НайтиЗаявкуВСистеме(НовСтр.Контейнер.Наименование,НовСтр.ВнешнийНомерЗаявки,НовСтр.НомерАвто);
			//ДИТ, Беляев СЮ, Ticket#0284531, 06-09-2022, начало
			НовСтр.ЗаявкаВСистеме = НайтиЗаявкуВСистеме(НовСтр.Контейнер.Наименование,НовСтр.ВнешнийНомерЗаявки,НовСтр.НомерАвто, Клиент, Договор);
			//ДИТ, Беляев СЮ, Ticket#0284531, 06-09-2022, конец
			
		КонецЕсли;
		
		СтрокиТД = СтрокиТД + 1;
		ПрочСтрока = ТД.Область("R"+СтрокиТД+"C1").Текст;
	КонецЦикла;
	
	Если НовРеестр.ПереченьКонтейнеров.Количество() = 0 Тогда
		Возврат СозданныйРеестр;
	КонецЕсли;
	
	// Период реестра - минимальная дата загрузки и максимальная дата выгрузки
	ВремТбл = НовРеестр.ПереченьКонтейнеров.Выгрузить();
	ВремТбл.Сортировать("ДатаЗагрузки ВОЗР");
	ДатаНач = ВремТбл[0].ДатаЗагрузки;
	ВремТбл.Сортировать("ДатаВыгрузки УБЫВ");
	ДатаКон = ВремТбл[0].ДатаВыгрузки;
	
	НовРеестр.Клиент = Клиент;
	НовРеестр.Договор = Договор;
	НовРеестр.Организация = Организация;
	НовРеестр.ПериодРеестраНачало = ДатаНач;
	НовРеестр.ПериодРеестраОкончание = ДатаКон;
	//Если НЕ ЗначениеЗаполнено(НаименованиеРеестра) Тогда
	//	НаименованиеРеестра = "№ " + Формат(ДатаНач,"ДФ=dd.MM.yy") + "_" + Формат(ДатаКон,"ДФ=dd.MM.yy"); //ДИТ, Беляев СЮ, ..., 09-09-2022, закомментировал
	//КонецЕсли;
	НовРеестр.Наименование = НаименованиеРеестра;	
	НовРеестр.Записать();
	
	Сообщить("Записан реестр " + НовРеестр.Ссылка);
	// записать данные в заявку
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РеестрыСогласованияПереченьКонтейнеров.ЗаявкаВСистеме КАК ЗаявкаВСистеме,
		|	РеестрыСогласованияПереченьКонтейнеров.Ссылка.Наименование КАК Наименование,
		|	РеестрыСогласованияПереченьКонтейнеров.Контейнер КАК Контейнер
		|ИЗ
		|	Справочник.РеестрыСогласования.ПереченьКонтейнеров КАК РеестрыСогласованияПереченьКонтейнеров
		|ГДЕ
		|	РеестрыСогласованияПереченьКонтейнеров.Ссылка = &Ссылка
		|	И НЕ РеестрыСогласованияПереченьКонтейнеров.ЗаявкаВСистеме = ЗНАЧЕНИЕ(Документ.Заявка.ПустаяСсылка)
		|ИТОГИ ПО
		|	ЗаявкаВСистеме";
	
	Запрос.УстановитьПараметр("Ссылка",НовРеестр.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаЗаявка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// сделаем группировку, чтобы одну заявку не записывать много раз
	Пока ВыборкаЗаявка.Следующий() Цикл
	    ТекЗаявка = ВыборкаЗаявка.ЗаявкаВСистеме;
		ПолучОб = ТекЗаявка.ПолучитьОбъект();
		ВыборкаДетальныеЗаписи = ВыборкаЗаявка.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ТЧ = ПолучОб.СоставУслуги;
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("НомерКТК",ВыборкаДетальныеЗаписи.Контейнер);
			НайденныеСтроки = ТЧ.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество()>0 Тогда
				НайденныеСтроки[0].РеестрКлиента = ВыборкаДетальныеЗаписи.Наименование;
			КонецЕсли;
		КонецЦикла;
		ПолучОб.Записать(РежимЗаписиДокумента.Проведение);
		Сообщить("Данные по заявке " + ПолучОб + " обновлены!");
	КонецЦикла;
	//Евросиб - Дубская 12.08.2022 #0255944 
	//// обновить данные по сделке
	//Запрос = Новый Запрос;
	//Запрос.Текст = 
	//	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	//	|	СделкаЗаявки.Ссылка КАК Ссылка
	//	|ИЗ
	//	|	Справочник.РеестрыСогласования.ПереченьКонтейнеров КАК РеестрыСогласованияПереченьКонтейнеров
	//	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.Заявки КАК СделкаЗаявки
	//	|		ПО РеестрыСогласованияПереченьКонтейнеров.ЗаявкаВСистеме = СделкаЗаявки.Заявка  //было = СделкаЗаявки.Ссылка 
	//	|ГДЕ
	//	|	РеестрыСогласованияПереченьКонтейнеров.Ссылка = &Ссылка";
	//
	//Запрос.УстановитьПараметр("Ссылка",НовРеестр.Ссылка);
	//РезультатЗапроса = Запрос.Выполнить();
	//ТЗ = РезультатЗапроса.Выгрузить();
	//
	//Для Каждого Стр  Из Тз Цикл
	//	доходы_ЗаполнитьПоЗаявкам2(Стр.Сделка.ПолучитьОбъект());
	//	Сообщить("Данные по сделке " + Стр.Сделка + " обновлены!");
	//КонецЦикла;   
	//Евросиб - Дубская 12.08.2022 #0255944
	
	СозданныйРеестр = НовРеестр.Ссылка;
	
	Возврат СозданныйРеестр;
	
КонецФункции

&НаСервере
Функция СохранитьНаСервереВагоны()
	
	СозданныйРеестр = Справочники.РеестрыСогласования.ПустаяСсылка();
	
	СтрокиТД = 3;
	
	ПрочСтрока = ТДВагоны.Область("R"+СтрокиТД+"C1").Текст;
	
	НовРеестр = Справочники.РеестрыСогласования.СоздатьЭлемент();
	Вагон = ТДВагоны.Область("R"+СтрокиТД+"C2").Текст;
	
	Пока ПрочСтрока <> "" Цикл
		// если вагона в системе нет, то такую строку не добавлять
		Если НЕ НайтиВагонВСистеме(Вагон) Тогда
			Продолжить;
		Иначе
			НовСтр = НовРеестр.ПереченьВагонов.Добавить();
		КонецЕсли;
		
		СтолбцыТД = 1;
		
		Пока СтолбцыТД<20 Цикл
			
			ТекЯчейка = ТДВагоны.Область("R"+СтрокиТД+"C"+СтолбцыТД).Текст;
			// ищем в справочнике РеестрыСогласования комментарий реквизита с номером = номеру столбца
			РеквизитыТЧ = Метаданные.Справочники.РеестрыСогласования.ТабличныеЧасти.ПереченьВагонов.Реквизиты;
			Для Каждого Рекв Из РеквизитыТЧ Цикл
				Если Рекв.Комментарий = Строка(СтолбцыТД) Тогда
					Если Рекв.Имя = "НомерКонтейнера" Тогда
						ТекЭлем = РаботаСКонтейнерамиСервер.НайтиКТК(СокрЛП(ТекЯчейка)); // Справочники.ТЕ.НайтиПоНаименованию(СокрЛП(ТекЯчейка));
					ИначеЕсли Рекв.Имя = "НомерВагона" Тогда
						ТекЭлем = Справочники.ТС.НайтиПоНаименованию(СокрЛП(ТекЯчейка));
					ИначеЕсли Рекв.Имя = "ДатаНачалаПользования" ИЛИ Рекв.Имя = "ДатаОкончанияПользования" ИЛИ Рекв.Имя = "НачалоПерерываНаРемонт" ИЛИ Рекв.Имя = "ОкончаниеПерерываНаРемонт" Тогда
						Попытка
							ТекЭлем = ПреобразованиеВДату(СокрЛП(ТекЯчейка));
						Исключение
						КонецПопытки;
					ИначеЕсли Рекв.Имя = "СтанцияНачалаСтрока" ИЛИ Рекв.Имя = "СтанцияОкончанияСтрока" Тогда
						НовСтр[СтрЗаменить(Рекв.Имя,"Строка","Справочник")] = ПоискЛокацииВСправочнике(ТекЯчейка);
						ТекЭлем = СокрЛП(ТекЯчейка);
					ИначеЕсли Рекв.Имя = "СтавкаЗаРейсСНДС" ИЛИ Рекв.Имя = "СтавкаЗаРейсБезНДС" Тогда
						Попытка
							ТекЭлем = Число(СтрЗаменить(ТекЯчейка," ",""));
						Исключение
						КонецПопытки;
					ИначеЕсли Рекв.Имя = "СтавкаНДС" Тогда
						Если СокрЛП(ТекЯчейка) = "0" Тогда
							ТекЭлем = Перечисления.СтавкиНДС.НДС0;
						ИначеЕсли СокрЛП(ТекЯчейка) = "" Тогда
							ТекЭлем = Перечисления.СтавкиНДС.БезНДС;
						ИначеЕсли СокрЛП(ТекЯчейка) = "20" Тогда
							ТекЭлем = Перечисления.СтавкиНДС.НДС20;
						ИначеЕсли СокрЛП(ТекЯчейка) = "10" Тогда
