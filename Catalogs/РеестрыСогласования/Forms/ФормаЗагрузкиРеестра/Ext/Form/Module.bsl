Функция НайтиЗаявкуВСистеме(Контейнер,ВнешнийНомерЗаявки,НомерАвто, Клиент, Договор) 
	
	ЗаявкаВСистеме = Документы.Заявка.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаявкаСоставУслуги.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
	               |ГДЕ
	               |	ЗаявкаСоставУслуги.НомерКТК.Наименование = &НомерКТК
	               |	И (ЗаявкаСоставУслуги.Ссылка.ВнешнийНомер = &ВнешнийНомер
	               |			ИЛИ ЗаявкаСоставУслуги.НомерАвто = &НомерАвто)
	               |	И НЕ ЗаявкаСоставУслуги.Ссылка.ПометкаУдаления 
				   //ДИТ, Беляев СЮ, Ticket#0284531, 06-09-2022, начало
				   |	И ЗаявкаСоставУслуги.Ссылка.Контрагент = &Контрагент
				   |	И ЗаявкаСоставУслуги.Ссылка.Договор = &Договор
				   //ДИТ, Беляев СЮ, Ticket#0284531, 06-09-2022, конец
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЗаявкаСоставУслуги.Ссылка.Дата УБЫВ";
	Запрос.УстановитьПараметр("НомерКТК",СокрЛП(Контейнер));
	Запрос.УстановитьПараметр("ВнешнийНомер",СокрЛП(ВнешнийНомерЗаявки));
	Запрос.УстановитьПараметр("НомерАвто",СокрЛП(НомерАвто));
	//ДИТ, Беляев СЮ, Ticket#0284531, 06-09-2022, начало
	Запрос.УстановитьПараметр("Контрагент",Клиент);
	Запрос.УстановитьПараметр("Договор",Договор);
	//ДИТ, Беляев СЮ, Ticket#0284531, 06-09-2022, конец
	
	РЗ = Запрос.Выполнить();
	Если НЕ РЗ.Пустой() Тогда
		ТЗ = РЗ.Выгрузить();
		ЗаявкаВСистеме = ТЗ[0].Ссылка;
	КонецЕсли;
	
	Возврат ЗаявкаВСистеме;
	
