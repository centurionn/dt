
Функция ПолучитьНастройкиВидаУслуг(ВидУслугПоставщика, ИмяТаблицы) Экспорт
	
	НастройкиВидаУслуг = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыУслугПоставщиков.ТипУчетныхЕдиницДетализации КАК ТипУчетныхЕдиницДетализации,
	|	ВидыУслугПоставщиков.ВалютаПоУмолчанию КАК ВалютаПоУмолчанию,
	|	ВидыУслугПоставщиков.ЗаполнятьНормативы КАК ЗаполнятьНормативы,
	|	ВидыУслугПоставщиков.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ВидыУслугПоставщиков.ИспользоватьЗаполнениеНормативов КАК ИспользоватьЗаполнениеНормативов
	|ИЗ
	|	Справочник.ВидыУслугПоставщиков КАК ВидыУслугПоставщиков
	|ГДЕ
	|	ВидыУслугПоставщиков.Ссылка = &ВидУслугПоставщика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица.НомерСтроки КАК НомерСтроки,
	|	Таблица.Имя КАК Имя,
	|	Таблица.Представление КАК Представление,
	|	Таблица.Выводить КАК Выводить,
	|	Таблица.Обязательное КАК Обязательное,
	|	Таблица.ИмяТаблицы КАК ИмяТаблицы,
	|	Таблица.ЗагружатьИзExcel КАК ЗагружатьИзExcel,
	|	Таблица.ЗагружатьИзExcelВПростойФорме КАК ЗагружатьИзExcelВПростойФорме,
	|	Таблица.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию,
	|	Таблица.ЭтоГруппаЭлементов КАК ЭтоГруппаЭлементов,
	|	Таблица.ОтображатьВШапке КАК ОтображатьВШапке,
	|	Таблица.Группировка КАК Группировка,
	|	Таблица.Родитель КАК Родитель,
	|	Таблица.ТолькоПросмотр КАК ТолькоПросмотр,
	|	Таблица.ЗаполнятьАвтоматически КАК ЗаполнятьАвтоматически
	|ИЗ
	|	Справочник.ВидыУслугПоставщиков.ПоляТаблицыУслуг КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка = &ВидУслугПоставщика
	|	И Таблица.ИмяТаблицы = &ИмяТаблицы
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица.НомерСтроки КАК НомерСтроки,
	|	Таблица.ИмяТаблицы КАК ИмяТаблицы,
	|	Таблица.Имя КАК Имя,
	|	Таблица.Значение КАК Значение
	|ИЗ
	|	Справочник.ВидыУслугПоставщиков.СпискиВыбора КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка = &ВидУслугПоставщика
	|	И Таблица.ИмяТаблицы = &ИмяТаблицы
	|
	|УПОРЯДОЧИТЬ ПО
	|	Имя,
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица.НомерСтроки КАК НомерСтроки,
	|	Таблица.ИмяТаблицы КАК ИмяТаблицы,
	|	Таблица.Имя КАК Имя,
	|	Таблица.ИмяТипа КАК ИмяТипа
	|ИЗ
	|	Справочник.ВидыУслугПоставщиков.ОграниченияТипов КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка = &ВидУслугПоставщика
	|	И Таблица.ИмяТаблицы = &ИмяТаблицы
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица.НомерСтроки КАК НомерСтроки,
	|	Таблица.ИмяТаблицы КАК ИмяТаблицы,
	|	Таблица.Имя КАК Имя,
	|	Таблица.ИмяПараметра КАК ИмяПараметра,
	|	Таблица.ЗначениеПараметра КАК ЗначениеПараметра
	|ИЗ
	|	Справочник.ВидыУслугПоставщиков.ПараметрыВыбора КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка = &ВидУслугПоставщика
	|	И Таблица.ИмяТаблицы = &ИмяТаблицы
	|
	|УПОРЯДОЧИТЬ ПО
	|	Имя,
	|	ИмяПараметра,
	|	ЗначениеПараметра
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица.НомерСтроки КАК НомерСтроки,
	|	Таблица.ИмяТаблицы КАК ИмяТаблицы,
	|	Таблица.Имя КАК Имя,
	|	Таблица.ИмяПоля КАК ИмяПоля
	|ИЗ
	|	Справочник.ВидыУслугПоставщиков.ПоляПоиска КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка = &ВидУслугПоставщика
	|	И Таблица.ИмяТаблицы = &ИмяТаблицы
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|ВЫБРАТЬ
	|	ВидыУслугПоставщиковДополнительныеУсловия.Имя КАК Имя,
	|	ВидыУслугПоставщиковДополнительныеУсловия.Условие КАК Условие
	|ИЗ
	|	Справочник.ВидыУслугПоставщиков.ДополнительныеУсловия КАК ВидыУслугПоставщиковДополнительныеУсловия
	|ГДЕ
	|	ВидыУслугПоставщиковДополнительныеУсловия.Ссылка = &ВидУслугПоставщика
	|	И ВидыУслугПоставщиковДополнительныеУсловия.ИмяТаблицы = &ИмяТаблицы";
	
	Запрос.УстановитьПараметр("ВидУслугПоставщика", ВидУслугПоставщика);
	Если ЗначениеЗаполнено(ИмяТаблицы) Тогда
		Запрос.УстановитьПараметр("ИмяТаблицы", ИмяТаблицы);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Таблица.ИмяТаблицы = &ИмяТаблицы", "");
	КонецЕсли;
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаНастроек = РезультатыЗапроса[0].Выбрать();
	ПоляТаблицыУслуг = РезультатыЗапроса[1].Выгрузить();
	ПоляТаблицыУслуг.Колонки.Добавить("Тип", Новый ОписаниеТипов("ОписаниеТипов"));
	ПоляТаблицыУслуг.Колонки.Добавить("ПараметрыВыбора", Новый ОписаниеТипов("Массив"));
	ПоляТаблицыУслуг.Колонки.Добавить("СписокВыбора", Новый ОписаниеТипов("СписокЗначений"));
	ПоляТаблицыУслуг.Колонки.Добавить("ОграничениеТипа", Новый ОписаниеТипов("Массив"));
	ПоляТаблицыУслуг.Колонки.Добавить("ПоляПоиска", Новый ОписаниеТипов("Массив"));
	ПоляТаблицыУслуг.Колонки.Добавить("ДопУсловия", Новый ОписаниеТипов("Массив"));
	ПоляТаблицыУслуг.Колонки.Добавить("ВыборГруппИЭлементов");
	
	СпискиВыбора = РезультатыЗапроса[2].Выгрузить();
	СпискиВыбора.Индексы.Добавить("ИмяТаблицы, Имя");
	
	ОграниченияТипов = РезультатыЗапроса[3].Выгрузить();
	ОграниченияТипов.Индексы.Добавить("ИмяТаблицы, Имя");
	
	ВыборкаПараметровВыбора = РезультатыЗапроса[4].Выбрать();
	
	ПоляПоиска = РезультатыЗапроса[5].Выгрузить();	
	
	ДопУсловия = РезультатыЗапроса[6].Выгрузить();
	
	НастройкиВидаУслуг.Вставить("ТипУчетныхЕдиницДетализации");
	НастройкиВидаУслуг.Вставить("ВалютаПоУмолчанию");
	НастройкиВидаУслуг.Вставить("ИспользоватьЗаполнениеНормативов");
	НастройкиВидаУслуг.Вставить("ЗаполнятьНормативы");	
	НастройкиВидаУслуг.Вставить("СуммаВключаетНДС");
	
	Если ВыборкаНастроек.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(НастройкиВидаУслуг, ВыборкаНастроек);
	КонецЕсли;
	
	Для Каждого Реквизит из Метаданные.Документы.ПСЦПоставщика.ТабличныеЧасти.Услуги.Реквизиты Цикл
		ОписаниеРеквизита = ПоляТаблицыУслуг.Найти(Реквизит.Имя, "Имя");
		Если ОписаниеРеквизита <> Неопределено Тогда
			ОписаниеРеквизита.Тип = Реквизит.Тип;
		КонецЕсли;
	КонецЦикла;
	
	ДоступныеРеквизиты = ПолучитьДоступныеРеквизиты(ИмяТаблицы);
	
	СоставИмениТаблицы = СтрРазделить(ИмяТаблицы, ".");
	ИмяДокумента = СоставИмениТаблицы[0];
	ИмяТЧ = СоставИмениТаблицы[1];
	МетаданныеТаблицы = Метаданные.Документы[ИмяДокумента].ТабличныеЧасти[ИмяТЧ];	
	
	Для Каждого Поле Из ПоляТаблицыУслуг Цикл
		
		НайденныеСтроки = ДоступныеРеквизиты.НайтиСтроки(Новый Структура("ИмяТаблицы, Имя", ИмяТаблицы, Поле.Имя));
		Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
			ДоступныйРеквизит = НайденныеСтроки[0];
		Иначе
			Продолжить;
		КонецЕсли;
		
		Поле.Тип = ДоступныйРеквизит.Тип;
				
		СписокВыбора = СпискиВыбора.Скопировать(Новый Структура("ИмяТаблицы, Имя", ИмяТаблицы, Поле.Имя), "Значение");
		Если ЗначениеЗаполнено(СписокВыбора) Тогда
			
			Поле.СписокВыбора.ЗагрузитьЗначения(СписокВыбора.ВыгрузитьКолонку("Значение"));
			
			Значения = Поле.СписокВыбора.ВыгрузитьЗначения();
			Поле.ПараметрыВыбора.Добавить(Новый Структура("ИмяПараметра, ЗначениеПараметра", "Отбор.Ссылка", Новый ФиксированныйМассив(Значения)));
			
		КонецЕсли;
		
		ОграничениеТипа = ОграниченияТипов.Скопировать(Новый Структура("ИмяТаблицы, Имя", ИмяТаблицы, Поле.Имя), "ИмяТипа");
		Если ЗначениеЗаполнено(ОграничениеТипа) Тогда
			Поле.ОграничениеТипа = ОграничениеТипа.ВыгрузитьКолонку("ИмяТипа");
		КонецЕсли;
		
		ТекПоляПоиска = ПоляПоиска.Скопировать(Новый Структура("ИмяТаблицы, Имя", ИмяТаблицы, Поле.Имя), "ИмяПоля");
		Если ЗначениеЗаполнено(ТекПоляПоиска) Тогда
			Поле.ПоляПоиска = ТекПоляПоиска.ВыгрузитьКолонку("ИмяПоля");
		КонецЕсли;
		
		МетаданныеРеквизита = МетаданныеТаблицы.Реквизиты.Найти(Поле.Имя);
		Если МетаданныеРеквизита <> Неопределено Тогда
			Поле.ВыборГруппИЭлементов = МетаданныеРеквизита.ВыборГруппИЭлементов;
		КонецЕсли;
				
	КонецЦикла;
	
	Пока ВыборкаПараметровВыбора.СледующийПоЗначениюПоля("Имя") Цикл
		
		Поле = ПоляТаблицыУслуг.Найти(ВыборкаПараметровВыбора.Имя, "Имя");
		
		Если Поле <> Неопределено Тогда
			Пока ВыборкаПараметровВыбора.СледующийПоЗначениюПоля("ИмяПараметра") Цикл
				
				ЗначенияПараметра = Новый Массив;
				Пока ВыборкаПараметровВыбора.СледующийПоЗначениюПоля("ЗначениеПараметра") Цикл
					ЗначенияПараметра.Добавить(ВыборкаПараметровВыбора.ЗначениеПараметра);
				КонецЦикла;
				
				Если ЗначенияПараметра.Количество() = 1 Тогда
					ЗначениеПараметра = ЗначенияПараметра[0];
				Иначе
					ЗначениеПараметра = Новый ФиксированныйМассив(ЗначенияПараметра);
				КонецЕсли;
				
				Поле.ПараметрыВыбора.Добавить(Новый Структура("ИмяПараметра, ЗначениеПараметра", ВыборкаПараметровВыбора.ИмяПараметра, ЗначениеПараметра));
				
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	НастройкиВидаУслуг.Вставить("ПоляТаблицыУслуг", ПоляТаблицыУслуг);
	НастройкиВидаУслуг.Вставить("ДопУсловия", ДопУсловия);
	
	Возврат НастройкиВидаУслуг;
	
КонецФункции

Функция ПолучитьДоступныеРеквизиты(ИмяТаблицы = "") Экспорт
	
	ТипСтрока150 = Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(150));
	ТипОписаниеТипов = Новый ОписаниеТипов("ОписаниеТипов");
	
	ДоступныеРеквизиты = Новый ТаблицаЗначений;
	ДоступныеРеквизиты.Колонки.Добавить("Имя", ТипСтрока150);
	ДоступныеРеквизиты.Колонки.Добавить("Представление", ТипСтрока150);
	ДоступныеРеквизиты.Колонки.Добавить("ИмяТаблицы", ТипСтрока150);
	ДоступныеРеквизиты.Колонки.Добавить("Тип", ТипОписаниеТипов);
	
	Для Каждого Реквизит из Метаданные.Документы.ПСЦПоставщика.ТабличныеЧасти.Услуги.Реквизиты Цикл
		
		НоваяСтрока = ДоступныеРеквизиты.Добавить();
		НоваяСтрока.Имя = Реквизит.Имя;
		НоваяСтрока.Представление = Реквизит.Синоним;
		НоваяСтрока.ИмяТаблицы = "ПСЦПоставщика.Услуги";
		НоваяСтрока.Тип = Реквизит.Тип;
		
	КонецЦикла;
	
	НоваяСтрока = ДоступныеРеквизиты.Добавить();
	НоваяСтрока.Имя = "Контейнеры";
	НоваяСтрока.Представление = "Контейнеры";
	НоваяСтрока.ИмяТаблицы = "ПСЦПоставщика.Услуги";
		
	НоваяСтрока = ДоступныеРеквизиты.Добавить();
	НоваяСтрока.Имя = "Вагоны";
	НоваяСтрока.Представление = "Вагоны";
	НоваяСтрока.ИмяТаблицы = "ПСЦПоставщика.Услуги";
	
	НоваяСтрока = ДоступныеРеквизиты.Добавить();
	НоваяСтрока.Имя = "КонтейнерыВагоны";
	НоваяСтрока.Представление = "Номера КТК/Вагонов";
	НоваяСтрока.ИмяТаблицы = "ПСЦПоставщика.Услуги";
	НоваяСтрока.Тип = Новый ОписаниеТипов("СправочникСсылка.ТЕ, СправочникСсылка.ТС");
	
	НоваяСтрока = ДоступныеРеквизиты.Добавить();
	НоваяСтрока.Имя = "ТипоразмерКТК_Вагона";
	НоваяСтрока.Представление = "Типоразмер КТК/Вагона";
	НоваяСтрока.ИмяТаблицы = "ПСЦПоставщика.Услуги";
	НоваяСтрока.Тип = Новый ОписаниеТипов("СправочникСсылка.ТипоразмерыТЕ, СправочникСсылка.ТипоразмерыТС");
	
	НоваяСтрока = ДоступныеРеквизиты.Добавить();
	НоваяСтрока.Имя = "ТипоразмерыКТК";
	НоваяСтрока.Представление = "Типоразмеры КТК";
	НоваяСтрока.ИмяТаблицы = "ПСЦПоставщика.Услуги";
	НоваяСтрока.Тип = Новый ОписаниеТипов("СправочникСсылка.ТипоразмерыТЕ");
	
	НоваяСтрока = ДоступныеРеквизиты.Добавить();
	НоваяСтрока.Имя = "ТипоразмерыКТКСтрокой";
	НоваяСтрока.Представление = "Типоразмеры КТК (строкой)";
	НоваяСтрока.ИмяТаблицы = "ПСЦПоставщика.Услуги";
	НоваяСтрока.Тип = Новый ОписаниеТипов("СправочникСсылка.ТипоразмерыТЕ");
	
	НоваяСтрока = ДоступныеРеквизиты.Добавить();
	НоваяСтрока.Имя = "ТипоразмерВагонов";
	НоваяСтрока.Представление = "Типоразмер вагонов";
	НоваяСтрока.ИмяТаблицы = "ПСЦПоставщика.Услуги";
	НоваяСтрока.Тип = Новый ОписаниеТипов("СправочникСсылка.ТипоразмерыТС");
	
	НоваяСтрока = ДоступныеРеквизиты.Добавить();
	НоваяСтрока.Имя = "ТипоразмерыВагонов";
	НоваяСтрока.Представление = "Типоразмеры вагонов";
	НоваяСтрока.ИмяТаблицы = "ПСЦПоставщика.Услуги";
	НоваяСтрока.Тип = Новый ОписаниеТипов("СправочникСсылка.ТипоразмерыТС");
	
	НоваяСтрока = ДоступныеРеквизиты.Добавить();
	НоваяСтрока.Имя = "ТипоразмерыВагоновСтрокой";
	НоваяСтрока.Представление = "Типоразмеры вагонов (строкой)";
	НоваяСтрока.ИмяТаблицы = "ПСЦПоставщика.Услуги";
	НоваяСтрока.Тип = Новый ОписаниеТипов("СправочникСсылка.ТипоразмерыТС");
	
	НоваяСтрока = ДоступныеРеквизиты.Добавить();
	НоваяСтрока.Имя = "ВидыОтправок";
	НоваяСтрока.Представление = "Виды отправок";
