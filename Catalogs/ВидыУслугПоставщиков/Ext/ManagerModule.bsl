Функция ПолучитьПоляСпискаТарифовВидаУслуг(ВидУслуг) Экспорт	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыУслугПоставщиковПоляСпискаТарифов.Ссылка КАК Ссылка,
	|	ВидыУслугПоставщиковПоляСпискаТарифов.НомерСтроки КАК НомерСтроки,
	|	ВидыУслугПоставщиковПоляСпискаТарифов.Имя КАК Имя,
	|	ВидыУслугПоставщиковПоляСпискаТарифов.Представление КАК Представление
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Справочник.ВидыУслугПоставщиков.ПоляСпискаТарифов КАК ВидыУслугПоставщиковПоляСпискаТарифов
	|ГДЕ
	|	НЕ ВидыУслугПоставщиковПоляСпискаТарифов.Ссылка.ПометкаУдаления
	|	И ВидыУслугПоставщиковПоляСпискаТарифов.Ссылка = &ВидУслуг
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.НомерСтроки КАК НомерСтроки,
	|	ВТ.Имя КАК Имя,
	|	ВТ.Представление КАК Представление
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВТ.Имя КАК Имя,
	|		ВТ.НомерСтроки КАК НомерСтроки,
	|		МИНИМУМ(ВТ.Ссылка) КАК Ссылка
	|	ИЗ
	|		(ВЫБРАТЬ
	|			ВТ.Имя КАК Имя,
	|			МИНИМУМ(ВТ.НомерСтроки) КАК НомерСтроки
	|		ИЗ
	|			ВТ КАК ВТ
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ВТ.Имя) КАК ВложенныйЗапрос
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ КАК ВТ
	|			ПО ВложенныйЗапрос.Имя = ВТ.Имя
	|				И ВложенныйЗапрос.НомерСтроки = ВТ.НомерСтроки
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ВТ.Имя,
	|		ВТ.НомерСтроки) КАК ВложенныйЗапрос
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ КАК ВТ
	|		ПО ВложенныйЗапрос.Ссылка = ВТ.Ссылка
	|			И ВложенныйЗапрос.Имя = ВТ.Имя
	|			И ВложенныйЗапрос.НомерСтроки = ВТ.НомерСтроки
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки,
	|	Представление";
	
	Если ЗначениеЗаполнено(ВидУслуг) Тогда
		Запрос.УстановитьПараметр("ВидУслуг", ВидУслуг);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ВидыУслугПоставщиковПоляСпискаТарифов.Ссылка = &ВидУслуг", "");
	КонецЕсли;
	
	ПоляСпискаТарифов = Запрос.Выполнить().Выгрузить();
	
	Возврат ПоляСпискаТарифов;
	
КонецФункции

