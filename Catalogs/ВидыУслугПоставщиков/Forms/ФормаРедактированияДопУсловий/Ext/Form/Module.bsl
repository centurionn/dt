
  
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Настройки= Неопределено;
	
	СхемаКомпоновки = ПолучитьОбщийМакет("ДопУсловияОбязательныхПолейВидовУслугПоставщиков");
	
	АдресСхемы = ПоместитьВоВременноеХранилище(СхемаКомпоновки, ЭтаФОрма.УникальныйИдентификатор);
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы));
	
	
	Для Каждого Парам Из Параметры.СписокПараметров Цикл		
		Если ЗначениеЗаполнено(Парам.Адрес) Тогда
			Настройки = ПолучитьИзВременногоХранилища(Парам.Адрес);
		Иначе
			Настройки = ПолучитьНастройкиИзСправочника(Парам.Ссылка,Парам.ИмяТаблицы,Парам.Имя);
		КонецЕсли; 
		Если Настройки <> Неопределено Тогда
			КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
		Иначе
			КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновки.НастройкиПоУмолчанию);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНастройкиИзСправочника(Ссылка,ИмяТаблицы,Имя)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыУслугПоставщиковДополнительныеУсловия.Условие КАК Условие
		|ИЗ
		|	Справочник.ВидыУслугПоставщиков.ДополнительныеУсловия КАК ВидыУслугПоставщиковДополнительныеУсловия
		|ГДЕ
		|	ВидыУслугПоставщиковДополнительныеУсловия.Ссылка = &Ссылка
		|	И ВидыУслугПоставщиковДополнительныеУсловия.ИмяТаблицы = &ИмяТаблицы
		|	И ВидыУслугПоставщиковДополнительныеУсловия.Имя = &Имя";
	
	Запрос.УстановитьПараметр("Имя", Имя);
	Запрос.УстановитьПараметр("ИмяТаблицы", ИмяТаблицы);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Условие.Получить();
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции	

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	
	СписокПараметров = Новый Массив;

	СписокПараметров.Добавить(Новый Структура("ЗначениеПараметра", ПолучитьСхемуНастроекНаСервере()));
	
	Закрыть(СписокПараметров);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСхемуНастроекНаСервере()
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	Если Настройки.Отбор.Элементы.Количество() = 0 Тогда
		Возврат "";
	Иначе	
		Возврат ПоместитьВоВременноеХранилище(Настройки, Новый УникальныйИдентификатор);
	КонецЕсли;
КонецФункции	