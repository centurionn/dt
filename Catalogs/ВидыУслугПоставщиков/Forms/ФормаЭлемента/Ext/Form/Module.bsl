&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗначениеНеопределено = Неопределено;
	
	СписокВыбораСоставаТаблицыУслуг = Элементы.СоставТаблицыУслугИмя.СписокВыбора;
	СписокВыбораСоставаТаблицыНормативов = Элементы.СоставТаблицыНормативныхСтавокИмя.СписокВыбора;
	
	ДоступныеРеквизиты.Загрузить(Справочники.ВидыУслугПоставщиков.ПолучитьДоступныеРеквизиты());
	
	Для Каждого Реквизит из ДоступныеРеквизиты Цикл
		Если Реквизит.ИмяТаблицы = "ПСЦПоставщика.Услуги" Тогда
			СписокВыбораСоставаТаблицыУслуг.Добавить(Реквизит.Имя, Реквизит.Представление);
		ИначеЕсли Реквизит.ИмяТаблицы = "ПротоколСНормативнымиСтавкамиНаУслугиПоставщиков.Услуги" Тогда
			СписокВыбораСоставаТаблицыНормативов.Добавить(Реквизит.Имя, Реквизит.Представление);
		КонецЕсли;
	КонецЦикла;	
	
	Для Каждого Реквизит Из ДоступныеРеквизиты Цикл
		
		ДоступныеПоляПоиска = Реквизит.ДоступныеПоляПоиска;
		Типы = Реквизит.Тип.Типы();
		Для Каждого Тип Из Типы Цикл
			
			СтроковоеПредставлениеТипа = ОбщегоНазначения.СтроковоеПредставлениеТипа(Тип);
			Реквизит.ДоступныеТипы.Добавить(СтроковоеПредставлениеТипа);
			
			ПолноеИмяТипа = СтрЗаменить(СтроковоеПредставлениеТипа, "Ссылка.", ".");
			КлассОМ = ЕСОбщегоНазначенияКлиентСервер.ПолучитьКлассОбъектаМетаданных(ПолноеИмяТипа);
			
			Если КлассОМ = "Справочник" Тогда
				
				МетаданныеПоТипу = Метаданные.НайтиПоТипу(Тип);
				
				Для Каждого Элемент Из МетаданныеПоТипу.СтандартныеРеквизиты Цикл
					Если Элемент.Имя = "Наименование" Или Элемент.Имя = "Код" Тогда
						Если ДоступныеПоляПоиска.НайтиПоЗначению(Элемент.Имя) = Неопределено Тогда
							ДоступныеПоляПоиска.Добавить(Элемент.Имя, Элемент.Синоним);
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				
				Для Каждого Элемент Из МетаданныеПоТипу.Реквизиты Цикл
					Если ДоступныеПоляПоиска.НайтиПоЗначению(Элемент.Имя) = Неопределено Тогда
						ДоступныеПоляПоиска.Добавить(Элемент.Имя, Элемент.Синоним);
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
			
			//МетаданныеПоТипу.ВводПоСтроке
			
		КонецЦикла;
			
		НайденныеСтроки = Объект.ПоляТаблицыУслуг.НайтиСтроки(Новый Структура("ИмяТаблицы, Имя", Реквизит.ИмяТаблицы, Реквизит.Имя));
		Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
			
			НайденнаяСтрока = НайденныеСтроки[0];
			НайденнаяСтрока.Используется = Истина;
			НайденнаяСтрока.Тип = Реквизит.Тип;
			НайденнаяСтрока.ДоступныеТипы.ЗагрузитьЗначения(Реквизит.ДоступныеТипы.ВыгрузитьЗначения());
			
			Для Каждого Элемент Из Реквизит.ДоступныеПоляПоиска Цикл
				НайденнаяСтрока.ДоступныеПоляПоиска.Добавить(Элемент.Значение, Элемент.Представление);
			КонецЦикла;
			
		КонецЕсли;
	
	КонецЦикла;	
	
	КорневыеЭлементы = СоставТаблицыУслуг.ПолучитьЭлементы();
	ЗаполнитьДеревоСоставТаблицы(КорневыеЭлементы, "ПСЦПоставщика.Услуги");
	
	КорневыеЭлементы = СоставТаблицыНормативныхСтавок.ПолучитьЭлементы();
	ЗаполнитьДеревоСоставТаблицы(КорневыеЭлементы, "ПротоколСНормативнымиСтавкамиНаУслугиПоставщиков.Услуги");
	
	СписокВыбораПолейСпискаТарифов = Элементы.ПоляСпискаТарифовИмя.СписокВыбора;
	ДоступныеПоляСпискаТарифов.Загрузить(Справочники.ВидыУслугПоставщиков.ПолучитьДоступныеПоляСпискаТарифов());
	Для Каждого ДоступноеПоле Из ДоступныеПоляСпискаТарифов Цикл
		СписокВыбораПолейСпискаТарифов.Добавить(ДоступноеПоле.Имя, ДоступноеПоле.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоСоставТаблицы(КорневыеЭлементы, ИмяТаблицы)

	ГруппыКолонок = Новый Соответствие;
	НайденныеПоля = Объект.ПоляТаблицыУслуг.НайтиСтроки(Новый Структура("ИмяТаблицы", ИмяТаблицы));
	
	Для Каждого Поле Из НайденныеПоля Цикл		
		
		Если ЗначениеЗаполнено(Поле.Родитель) Тогда
			ЭлементыТекущейГруппы = ГруппыКолонок.Получить(Поле.Родитель);
		Иначе
			ЭлементыТекущейГруппы = КорневыеЭлементы;
		КонецЕсли;
		
		ЭлементДерева = ЭлементыТекущейГруппы.Добавить();
		Если Поле.ЭтоГруппаЭлементов Тогда
			ГруппыКолонок.Вставить(Поле.Имя, ЭлементДерева.ПолучитьЭлементы());
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ЭлементДерева, Поле);
		
		ЭлементыСписка = Объект.СпискиВыбора.НайтиСтроки(Новый Структура("Имя, ИмяТаблицы", Поле.Имя, ИмяТаблицы));
		Для Каждого Элемент Из ЭлементыСписка Цикл
			ЭлементДерева.СписокВыбора.Добавить(Элемент.Значение);
		КонецЦикла;
		//Евросиб Шевченко А.В. US 83101 TA 122833 07.11.2025
		ЭлементыСпискаДопУсловий = Объект.ДополнительныеУсловия.НайтиСтроки(Новый Структура("Имя, ИмяТаблицы", Поле.Имя, ИмяТаблицы));
		Для Каждого Стр Из ЭлементыСпискаДопУсловий Цикл
			ЭлементДерева.ДополнительныеУсловия.Добавить("Установлены отборы");
		КонецЦикла;
		//Евросиб Шевченко А.В. US 83101 TA 122833 07.11.2025
		ОграниченияТипа = Объект.ОграниченияТипов.НайтиСтроки(Новый Структура("Имя, ИмяТаблицы", Поле.Имя, ИмяТаблицы));
		Для Каждого Стр Из ОграниченияТипа Цикл
			ДоступныйТип = Поле.ДоступныеТипы.НайтиПоЗначению(Стр.ИмяТипа);
			Если ДоступныйТип <> Неопределено Тогда
				ЭлементДерева.ОграничениеТипа.Добавить(Стр.ИмяТипа, ДоступныйТип.Представление);
			КонецЕсли;
		КонецЦикла;
		
		ПараметрыВыбораПоля = Объект.ПараметрыВыбора.НайтиСтроки(Новый Структура("Имя, ИмяТаблицы", Поле.Имя, ИмяТаблицы));
		Для Каждого Стр Из ПараметрыВыбораПоля Цикл
			ЭлементДерева.ПараметрыВыбора.Добавить(Стр.ИмяПараметра + " = " + Строка(Стр.ЗначениеПараметра));
		КонецЦикла;
		
		ПоляПоиска = Объект.ПоляПоиска.НайтиСтроки(Новый Структура("Имя, ИмяТаблицы", Поле.Имя, ИмяТаблицы));		
		Для Каждого Стр Из ПоляПоиска Цикл
			ДоступноеПолеПоиска = Поле.ДоступныеПоляПоиска.НайтиПоЗначению(Стр.ИмяПоля);
			Если ДоступноеПолеПоиска <> Неопределено Тогда
				ЭлементДерева.ПоляПоиска.Добавить(Стр.ИмяПоля, ДоступноеПолеПоиска.Представление);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Объект.ПоляТаблицыУслуг.Очистить();
	Объект.СпискиВыбора.Очистить();
	ПеренестиДеревоВТаблицу(СоставТаблицыНормативныхСтавок, "ПротоколСНормативнымиСтавкамиНаУслугиПоставщиков.Услуги");
	ПеренестиДеревоВТаблицу(СоставТаблицыУслуг, "ПСЦПоставщика.Услуги");
	
КонецПроцедуры

