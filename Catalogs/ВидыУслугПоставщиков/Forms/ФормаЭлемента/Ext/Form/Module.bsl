&НаКлиенте
Процедура ВыполнитьАвтоподборПоляПоТексту(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	ТекстПоиска = ВРег(Текст);
	
	Пока СтрНайти(ТекстПоиска, "  ") > 0 Цикл
		ТекстПоиска = СтрЗаменить(ТекстПоиска, "  ", " ");
	КонецЦикла;
	
	ТекстПоиска = СокрЛП(ТекстПоиска);
	
	ДлинаТекста = СтрДлина(ТекстПоиска);
	Если ДлинаТекста = 0 Тогда
		Возврат
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Шрифт = Новый Шрифт(,,Истина);
	Цвет = WebЦвета.Зеленый;
	
	ДанныеВыбора = Новый СписокЗначений;
	
	МассивПодстрок = СтрРазделить(ТекстПоиска, " ");
	
	Для Каждого Стр Из Элемент.СписокВыбора Цикл
		
		Значение = Стр.Значение;
		Строка = Стр.Представление;
		СтрокаВРег = ВРег(Строка);
		
		ВхожденияНайдены = Истина;
		
		Для Каждого Подстрока Из МассивПодстрок Цикл
			Если Найти(СтрокаВРег, Подстрока) = 0 Тогда
				ВхожденияНайдены = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не ВхожденияНайдены Тогда
			Продолжить
		КонецЕсли;
		
		ДлинаСтроки = СтрДлина(Строка);
		Массив = Новый Массив(ДлинаСтроки);
		
		Для Каждого Подстрока Из МассивПодстрок Цикл
			ДлинаПодстроки = СтрДлина(Подстрока);
			НачалоПоиска = 1;			
			Пока Истина Цикл
				ПозицияПодстроки = СтрНайти(СтрокаВРег, Подстрока, , НачалоПоиска);
				Если ПозицияПодстроки = 0 Тогда
					Прервать;
				КонецЕсли;
				
				НачалоПоиска = ПозицияПодстроки + ДлинаПодстроки;
				
				Для Сч = ПозицияПодстроки По НачалоПоиска - 1 Цикл
					Массив[Сч - 1] = Истина;
				КонецЦикла;				
				
				Если НачалоПоиска > ДлинаСтроки Тогда
					Прервать;
				КонецЕсли;
				
			КонецЦикла;			
		КонецЦикла;
		
		МассивСтрок = Новый Массив;		
		Для Сч = 0 По Массив.ВГраница() Цикл
			Символ = Сред(Строка, Сч + 1, 1);
			Если Массив[Сч] = Неопределено Тогда
				МассивСтрок.Добавить(Символ);
			Иначе
				МассивСтрок.Добавить(Новый ФорматированнаяСтрока(Символ, Шрифт, Цвет));
			КонецЕсли;
		КонецЦикла;
		
		ДанныеВыбора.Добавить(Значение, Новый ФорматированнаяСтрока(МассивСтрок));
		
		Если ДанныеВыбора.Количество() = 50 Тогда
			Прервать
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьНачалоВыбораСпискаВыбора(ИмяТаблицы, ИмяДереваЭлементов)
	
	ТекСтрока = Элементы[ИмяДереваЭлементов].ТекущаяСтрока;
	ТекДанные = Элементы[ИмяДереваЭлементов].ТекущиеДанные;
	
	СписокВыбора = ТекДанные.СписокВыбора.ВыгрузитьЗначения();
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТипЗначенияСписка", ТекДанные.Тип);
	ПараметрыФормы.Вставить("ТекущийСписок", СписокВыбора);
	
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ИдентификаторСтроки", ТекСтрока);
	ПараметрыОповещения.Вставить("ИмяТаблицы", ИмяТаблицы);
	ПараметрыОповещения.Вставить("ИмяДереваЭлементов", ИмяДереваЭлементов);	
	
	ОповещениеОЗакрытииФормыСписка = Новый ОписаниеОповещения("ПриЗакрытииФормыРедактированияСпискаВыбораЭлемента", ЭтаФорма, ПараметрыОповещения);
	
	ОткрытьФорму("ОбщаяФорма.ФормаРедактированияСпискаЗначений", ПараметрыФормы, Этаформа,,,, ОповещениеОЗакрытииФормыСписка, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыРедактированияСпискаВыбораЭлемента(СписокВыбора, ДополнительныеПараметры) Экспорт
	
	Если СписокВыбора <> Неопределено Тогда
		
		ИмяДереваЭлементов = ДополнительныеПараметры.ИмяДереваЭлементов;
		ИмяТаблицы = ДополнительныеПараметры.ИмяТаблицы;
		
		ТекПоле = ЭтотОбъект[ИмяДереваЭлементов].НайтиПоИдентификатору(ДополнительныеПараметры.ИдентификаторСтроки);
		ТекПоле.СписокВыбора.ЗагрузитьЗначения(СписокВыбора.ВыгрузитьЗначения());
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьНачалоВыбораПараметровВыбора(ИмяТаблицы, ИмяДереваЭлементов)
	
	ТекСтрока = Элементы[ИмяДереваЭлементов].ТекущаяСтрока;
	ТекДанные = Элементы[ИмяДереваЭлементов].ТекущиеДанные;
	
	ТекПараметрыВыбора = Объект.ПараметрыВыбора.НайтиСтроки(Новый Структура("ИмяТаблицы, Имя", ИмяТаблицы, ТекДанные.Имя));
	СписокПараметров = Новый Массив;
	Для Каждого Стр Из ТекПараметрыВыбора Цикл
		СписокПараметров.Добавить(Новый Структура("ИмяПараметра, ЗначениеПараметра", Стр.ИмяПараметра, Стр.ЗначениеПараметра));
	КонецЦикла;
	
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ИдентификаторСтроки", ТекСтрока);
	ПараметрыОповещения.Вставить("ИмяТаблицы", ИмяТаблицы);
	ПараметрыОповещения.Вставить("ИмяДереваЭлементов", ИмяДереваЭлементов);
	
	ОповещениеОЗакрытииФормы = Новый ОписаниеОповещения("ПриЗакрытииФормыРедактированияПараметровВыбора", ЭтаФорма, ПараметрыОповещения);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СписокПараметров", СписокПараметров);
	
	ОткрытьФорму("Справочник.ВидыУслугПоставщиков.Форма.ФормаРедактированияПараметровВыбора", ПараметрыФормы, ЭтаФорма,,,, ОповещениеОЗакрытииФормы, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыРедактированияПараметровВыбора(СписокПараметров, ДопПараметры) Экспорт
	
	Если СписокПараметров <> Неопределено Тогда
		
		ИмяТаблицы = ДопПараметры.ИмяТаблицы;
		ИмяДереваЭлементов = ДопПараметры.ИмяДереваЭлементов;
		
		ТекДанные = ЭтотОбъект[ИмяДереваЭлементов].НайтиПоИдентификатору(ДопПараметры.ИдентификаторСтроки);
		
		ТекПараметрыВыбора = Объект.ПараметрыВыбора.НайтиСтроки(Новый Структура("ИмяТаблицы, Имя", ИмяТаблицы, ТекДанные.Имя));
		Для Каждого Стр Из ТекПараметрыВыбора Цикл
			Объект.ПараметрыВыбора.Удалить(Стр);
		КонецЦикла;
		
		ТекДанные.ПараметрыВыбора.Очистить();
		
		Для Каждого Параметр Из СписокПараметров Цикл
			
			Стр = Объект.ПараметрыВыбора.Добавить();
			Стр.ИмяТаблицы = ИмяТаблицы;
			Стр.Имя = ТекДанные.Имя;
			ЗаполнитьЗначенияСвойств(Стр, Параметр, "ИмяПараметра, ЗначениеПараметра");
			
			ТекДанные.ПараметрыВыбора.Добавить(Стр.ИмяПараметра + " = " + Строка(Стр.ЗначениеПараметра));
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьНачалоВыбораОграниченияТипа(ИмяТаблицы, ИмяДереваЭлементов)
	
	ТекСтрока = Элементы[ИмяДереваЭлементов].ТекущаяСтрока;
	ТекДанные = Элементы[ИмяДереваЭлементов].ТекущиеДанные;	
	
	СписокОграничениеТипа = Новый СписокЗначений;
	Для Каждого ЭлементСписка Из ТекДанные.ОграничениеТипа Цикл
		ДоступныйТип = ТекДанные.ДоступныеТипы.НайтиПоЗначению(ЭлементСписка.Значение);
		Если ДоступныйТип <> Неопределено Тогда
			СписокОграничениеТипа.Добавить(ДоступныйТип.Значение, ДоступныйТип.Представление, Истина);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ЭлементСписка Из ТекДанные.ДоступныеТипы Цикл
		ВыбранныйЭлемент = СписокОграничениеТипа.НайтиПоЗначению(ЭлементСписка.Значение);
		Если ВыбранныйЭлемент = Неопределено Тогда
			Пометка = ТекДанные.ОграничениеТипа.НайтиПоЗначению(ЭлементСписка.Значение) <> Неопределено;		
			СписокОграничениеТипа.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление, Пометка);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;	
	ПараметрыФормы.Вставить("ТекущийСписок", СписокОграничениеТипа);
	ПараметрыФормы.Вставить("ПоказыватьПометку", Истина);
	ПараметрыФормы.Вставить("ИзменятьСоставСтрок", Ложь);
	
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ИдентификаторСтроки", ТекСтрока);
	ПараметрыОповещения.Вставить("ИмяТаблицы", ИмяТаблицы);
	ПараметрыОповещения.Вставить("ИмяДереваЭлементов", ИмяДереваЭлементов);
	
	ОповещениеОЗакрытииФормыСписка = Новый ОписаниеОповещения("ПриЗакрытииФормыРедактированияОграниченияТипа", ЭтаФорма, ПараметрыОповещения);
	
	ОткрытьФорму("ОбщаяФорма.ФормаРедактированияСпискаЗначений", ПараметрыФормы, Этаформа,,,, ОповещениеОЗакрытииФормыСписка, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыРедактированияОграниченияТипа(СписокОграничениеТипа, ДополнительныеПараметры) Экспорт
	
	Если СписокОграничениеТипа <> Неопределено Тогда
		
		ИмяТаблицы = ДополнительныеПараметры.ИмяТаблицы;
		ИмяДереваЭлементов = ДополнительныеПараметры.ИмяДереваЭлементов;
		
		ТекДанные = ЭтотОбъект[ИмяДереваЭлементов].НайтиПоИдентификатору(ДополнительныеПараметры.ИдентификаторСтроки);
		ОграничениеТипа = ТекДанные.ОграничениеТипа;
		ОграничениеТипа.Очистить();
		
		Для Каждого ЭлементСписка Из СписокОграничениеТипа Цикл
			Если ЭлементСписка.Пометка Тогда
				ОграничениеТипа.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
			КонецЕсли;
		КонецЦикла;
		
		ЭлементыПоТекущемуПолю = Объект.ОграниченияТипов.НайтиСтроки(Новый Структура("ИмяТаблицы, Имя", ИмяТаблицы, ТекДанные.Имя));
		Для Каждого Элемент Из ЭлементыПоТекущемуПолю Цикл
			Объект.ОграниченияТипов.Удалить(Элемент);
		КонецЦикла;
		
		Для Каждого Элемент Из ОграничениеТипа Цикл
			НовыйЭлемент = Объект.ОграниченияТипов.Добавить();
			НовыйЭлемент.ИмяТаблицы = ИмяТаблицы;
			НовыйЭлемент.Имя = ТекДанные.Имя;
			НовыйЭлемент.ИмяТипа = Элемент.Значение;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьНачалоВыбораПолейПоиска(ИмяТаблицы, ИмяДереваЭлементов)
	
	ТекСтрока = Элементы[ИмяДереваЭлементов].ТекущаяСтрока;
	ТекДанные = Элементы[ИмяДереваЭлементов].ТекущиеДанные;
		
	СписокПолей = Новый СписокЗначений;
	
	ПоляПоиска = Объект.ПоляПоиска.НайтиСтроки(Новый Структура("ИмяТаблицы, Имя", ИмяТаблицы, ТекДанные.Имя));
	Для Каждого Стр Из ПоляПоиска Цикл
		ДоступныйТип = ТекДанные.ДоступныеПоляПоиска.НайтиПоЗначению(Стр.ИмяПоля);
		Если ДоступныйТип <> Неопределено Тогда
			СписокПолей.Добавить(ДоступныйТип.Значение, ДоступныйТип.Представление, Истина);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ЭлементСписка Из ТекДанные.ДоступныеПоляПоиска Цикл
		ВыбранныйЭлемент = СписокПолей.НайтиПоЗначению(ЭлементСписка.Значение);
		Если ВыбранныйЭлемент = Неопределено Тогда
			СписокПолей.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление, Ложь);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;	
	ПараметрыФормы.Вставить("ТекущийСписок", СписокПолей);
	ПараметрыФормы.Вставить("ПоказыватьПометку", Истина);
	ПараметрыФормы.Вставить("ИзменятьСоставСтрок", Ложь);
	
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ИдентификаторСтроки", ТекСтрока);
	ПараметрыОповещения.Вставить("ИмяТаблицы", ИмяТаблицы);
	ПараметрыОповещения.Вставить("ИмяДереваЭлементов", ИмяДереваЭлементов);	
	
	ОповещениеОЗакрытииФормыСписка = Новый ОписаниеОповещения("ПриЗакрытииФормыСпискаПолейПоиска", ЭтаФорма, ПараметрыОповещения);
	
	ОткрытьФорму("ОбщаяФорма.ФормаРедактированияСпискаЗначений", ПараметрыФормы, Этаформа,,,, ОповещениеОЗакрытииФормыСписка, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыСпискаПолейПоиска(СписокПолейПоиска, ДополнительныеПараметры) Экспорт
	
	Если СписокПолейПоиска <> Неопределено Тогда
		
		ИмяТаблицы = ДополнительныеПараметры.ИмяТаблицы;
		ИмяДереваЭлементов = ДополнительныеПараметры.ИмяДереваЭлементов;
		ТекДанные = ЭтотОбъект[ИмяДереваЭлементов].НайтиПоИдентификатору(ДополнительныеПараметры.ИдентификаторСтроки);
		ПоляПоиска = ТекДанные.ПоляПоиска;
		ПоляПоиска.Очистить();
		
		Для Каждого ЭлементСписка Из СписокПолейПоиска Цикл
			Если ЭлементСписка.Пометка Тогда
				ПоляПоиска.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
			КонецЕсли;
		КонецЦикла;
		
		ЭлементыПоТекущемуПолю = Объект.ПоляПоиска.НайтиСтроки(Новый Структура("ИмяТаблицы, Имя", ИмяТаблицы, ТекДанные.Имя));
		Для Каждого Элемент Из ЭлементыПоТекущемуПолю Цикл
			Объект.ПоляПоиска.Удалить(Элемент);
		КонецЦикла;
		
		Для Каждого Элемент Из ПоляПоиска Цикл
			НовыйЭлемент = Объект.ПоляПоиска.Добавить();
			НовыйЭлемент.ИмяТаблицы = ИмяТаблицы;
			НовыйЭлемент.Имя = ТекДанные.Имя;
			НовыйЭлемент.ИмяПоля = Элемент.Значение;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЭлементДерева(ИмяДереваЭлементов, Группа = Ложь)
	
	ТекДанные = Элементы[ИмяДереваЭлементов].ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда		
		Если ТекДанные.ЭтоГруппаЭлементов Тогда
			ЭлементыТекущейГруппы = ТекДанные.ПолучитьЭлементы();
			НовыйЭлемент = ЭлементыТекущейГруппы.Добавить();
		Иначе
			ТекущаяГруппа = ТекДанные.ПолучитьРодителя();
			Если ТекущаяГруппа = Неопределено Тогда
				ТекущаяГруппа = ЭтотОбъект[ИмяДереваЭлементов];
			КонецЕсли;
			ЭлементыТекущейГруппы = ТекущаяГруппа.ПолучитьЭлементы();
			ИндексТекущейСтроки = ЭлементыТекущейГруппы.Индекс(ТекДанные);
			НовыйЭлемент = ЭлементыТекущейГруппы.Вставить(ИндексТекущейСтроки + 1);
		КонецЕсли;
	Иначе
		ТекущаяГруппа = ЭтотОбъект[ИмяДереваЭлементов];
		ЭлементыТекущейГруппы = ТекущаяГруппа.ПолучитьЭлементы();
		НовыйЭлемент = ЭлементыТекущейГруппы.Добавить();
	КонецЕсли;
		
	Если Группа Тогда
		НовыйЭлемент.ЭтоГруппаЭлементов = Истина;
		НовыйЭлемент.Группировка = "Вертикальная";
	Иначе
		НовыйЭлемент.ЭтоГруппаЭлементов = Ложь;
		НовыйЭлемент.Группировка = "";
	КонецЕсли;
	
	НовыйЭлемент.Выводить = Истина;
	НовыйЭлемент.ОтображатьВШапке = Истина;
	Элементы[ИмяДереваЭлементов].ТекущаяСтрока = НовыйЭлемент.ПолучитьИдентификатор();
			
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиДеревоВТаблицу(ГруппаЭлементов, ИмяТаблицы, ИмяГруппы = "")
	
	СтрокиДерева = ГруппаЭлементов.ПолучитьЭлементы();
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		
		СтрокаТаблицы = Объект.ПоляТаблицыУслуг.Добавить();
		СтрокаТаблицы.ИмяТаблицы = ИмяТаблицы;
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаДерева);
		СтрокаТаблицы.Родитель = ИмяГруппы;
		
		Если СтрокаДерева.ЭтоГруппаЭлементов Тогда
			ПеренестиДеревоВТаблицу(СтрокаДерева, ИмяТаблицы, СтрокаДерева.Имя);
		Иначе
			
			Для Каждого ЭлементСписка Из СтрокаДерева.СписокВыбора Цикл
				НоваяСтрока = Объект.СпискиВыбора.Добавить();
				НоваяСтрока.Имя = СтрокаТаблицы.Имя;
				НоваяСтрока.ИмяТаблицы = ИмяТаблицы;
				НоваяСтрока.Значение = ЭлементСписка.Значение;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция НайтиСтрокуДереваПоИмени(ГруппаЭлементов, ИмяЭлемента)
	
	НайденнаяСтрока = Неопределено;
	СтрокиДерева = ГруппаЭлементов.ПолучитьЭлементы();
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл		
		Если СтрокаДерева.ЭтоГруппаЭлементов Тогда
			НайденнаяСтрока = НайтиСтрокуДереваПоИмени(СтрокаДерева, ИмяЭлемента);
			Если НайденнаяСтрока <> Неопределено Тогда
				Прервать;
			КонецЕсли;
		Иначе			
			Если СтрокаДерева.Имя = ИмяЭлемента Тогда
				НайденнаяСтрока = СтрокаДерева;
				Прервать;
			КонецЕсли;
		КонецЕсли;		
	КонецЦикла;
	
	Возврат НайденнаяСтрока;
	
КонецФункции

