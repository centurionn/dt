&НаКлиенте
Процедура ОбработатьНачалоВыбораДополнительныеУсловия(ИмяТаблицы, ИмяДереваЭлементов)
	
	ТекСтрока = Элементы[ИмяДереваЭлементов].ТекущаяСтрока;
	ТекДанные = Элементы[ИмяДереваЭлементов].ТекущиеДанные;
	
	ТекПараметрыВыбора = Объект.ДополнительныеУсловия.НайтиСтроки(Новый Структура("ИмяТаблицы, Имя", ИмяТаблицы, ТекДанные.Имя));
	
	сДопУсловий = Новый Структура("Ссылка,УникальныйИдентификаторВладельца,ИмяТаблицы,Имя,Адрес",Объект.Ссылка,Этаформа.УникальныйИдентификатор,"","","");
	
	Для Каждого СтрДопУсловие Из ТекПараметрыВыбора Цикл
		сДопУсловий.Вставить("Ссылка",Объект.Ссылка);
		сДопУсловий.Вставить("ИмяТаблицы",СтрДопУсловие.ИмяТаблицы);
		сДопУсловий.Вставить("Имя",СтрДопУсловие.Имя);
		сДопУсловий.Вставить("Адрес",СтрДопУсловие.Адрес);
	КонецЦикла;
	
	СписокПараметров = Новый Массив;
	СписокПараметров.Добавить(сДопУсловий);
		
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ИдентификаторСтроки", ТекСтрока);
	ПараметрыОповещения.Вставить("ИмяТаблицы", ИмяТаблицы);
	ПараметрыОповещения.Вставить("ИмяДереваЭлементов", ИмяДереваЭлементов);
	
	ОповещениеОЗакрытииФормы = Новый ОписаниеОповещения("ПриЗакрытииФормыРедактированияСпискаДополнительныхУсловий", ЭтаФорма, ПараметрыОповещения);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СписокПараметров", СписокПараметров);
	
	ОткрытьФорму("Справочник.ВидыУслугПоставщиков.Форма.ФормаРедактированияДопУсловий", ПараметрыФормы, ЭтаФорма,,,, ОповещениеОЗакрытииФормы, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыРедактированияСпискаДополнительныхУсловий(вПараметр, ДопПараметры) Экспорт
	
	Если вПараметр <> Неопределено Тогда
		
		ИмяТаблицы = ДопПараметры.ИмяТаблицы;
		ИмяДереваЭлементов = ДопПараметры.ИмяДереваЭлементов;
		
		ТекДанные = ЭтотОбъект[ИмяДереваЭлементов].НайтиПоИдентификатору(ДопПараметры.ИдентификаторСтроки);
		
		ТекПараметрыВыбора = Объект.ДополнительныеУсловия.НайтиСтроки(Новый Структура("ИмяТаблицы, Имя", ИмяТаблицы, ТекДанные.Имя));
		Для Каждого Стр Из ТекПараметрыВыбора Цикл
			Объект.ДополнительныеУсловия.Удалить(Стр);
		КонецЦикла;
		
		ТекДанные.ДополнительныеУсловия.Очистить();	
		
		Для Каждого Параметр Из вПараметр Цикл
			
			Если Параметр.ЗначениеПараметра <> "" И ТекДанные.Обязательное Тогда
				Стр = Объект.ДополнительныеУсловия.Добавить();
				Стр.ИмяТаблицы = ИмяТаблицы;
				Стр.Имя = ТекДанные.Имя;
				Стр.Адрес = Параметр.ЗначениеПараметра;
				ТекДанные.ДополнительныеУсловия.Добавить("Установлены отборы");
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры
	

&НаСервере
Функция ПолучитьАдресВременногоХранилища(Стр)
	Если НЕ ЗначениеЗаполнено(Стр.Условие) Тогда
		Возврат "";
	Иначе
		Возврат ПоместитьВоВременноеХранилище(Стр.Условие,ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли;	
КонецФункции	

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Для Каждого СтрДопУсловия Из ТекущийОбъект.ДополнительныеУсловия Цикл
		Если ЗначениеЗаполнено(СтрДопУсловия.Адрес) Тогда
			СтрДопУсловия.Условие = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(СтрДопУсловия.Адрес),Новый СжатиеДанных(9));
			СтрДопУсловия.Адрес = "";
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры
