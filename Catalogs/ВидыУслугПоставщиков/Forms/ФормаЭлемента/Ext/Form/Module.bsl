&НаКлиенте
Процедура ПоляТаблицыУслугПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	ИдентификаторТекСтроки = Элементы.ПоляТаблицыУслуг.ТекущаяСтрока;
	ТекСтрока = Объект.ПоляТаблицыУслуг.НайтиПоИдентификатору(ИдентификаторТекСтроки);
	
	Для Каждого Стр Из Объект.ПоляТаблицыУслуг Цикл
		
		ИдентификаторСтроки = Стр.ПолучитьИдентификатор();
		Если  ИдентификаторСтроки = ИдентификаторТекСтроки Тогда
			Продолжить;
		КонецЕсли;
		
		Если Стр.Имя = ТекСтрока.Имя Тогда
			ПоказатьПредупреждение(, "Реквизит уже выбран в другой строке!");
			Отказ = Истина;
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура ПоляТаблицыУслугПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ТекДанные = Элементы.ПоляТаблицыУслуг.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		Если Не ЗначениеЗаполнено(ТекДанные.Имя) Тогда
			Объект.ПоляТаблицыУслуг.Удалить(ТекДанные);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоляТаблицыУслугИмяОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ИдентификаторТекСтроки = Элементы.ПоляТаблицыУслуг.ТекущаяСтрока;
	ТекДанные = Элементы.ПоляТаблицыУслуг.ТекущиеДанные;
	
	Для Каждого ДоступныйРеквизит Из ДоступныеРеквизиты Цикл
		
		Если ДоступныйРеквизит.Имя = ВыбранноеЗначение Тогда
			
			ВыбранВДругойСтроке = Ложь;
			Для Каждого Стр Из Объект.ПоляТаблицыУслуг Цикл
		
				ИдентификаторСтроки = Стр.ПолучитьИдентификатор();
				Если ИдентификаторСтроки = ИдентификаторТекСтроки Тогда
					Продолжить;
				КонецЕсли;
				
				Если Стр.Имя = ДоступныйРеквизит.Имя Тогда
					ПоказатьПредупреждение(, "Реквизит уже выбран в другой строке!");
					ВыбранВДругойСтроке = Истина;
				КонецЕсли;
				
			КонецЦикла;
			
			Если Не ВыбранВДругойСтроке Тогда
				ЗаполнитьЗначенияСвойств(ТекДанные, ДоступныйРеквизит);
				ТекДанные.Используется = Истина;
			КонецЕсли;
			
			Прервать;
			
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры

