
&НаКлиенте
Перем ДанныеСтрокиКопирования;

&НаКлиенте
Процедура ПлановыеПоказателиРаботыСПодрядчикомПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
		
	Если Копирование Тогда
		
		ДанныеСтрокиКопирования = Новый Структура;
		
		ТекДанные = Элементы.ПлановыеПоказателиРаботыСПодрядчиком.ТекущиеДанные;
		Если ТекДанные <> Неопределено Тогда
			ДанныеСтрокиКопирования.Вставить("ОбъемЗакупаемыхУслугТР", ТекДанные.ОбъемЗакупаемыхУслугТР);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПлановыеПоказателиРаботыСПодрядчикомПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		ТекДанные = Элементы.ПлановыеПоказателиРаботыСПодрядчиком.ТекущиеДанные;
		Если ТекДанные <> Неопределено Тогда
			
			ТекДанные.МесяцНачалаРаботы = ДобавитьМесяц(Объект.ДатаАнкеты, ТекДанные.НомерСтроки);
			
			Если Копирование Тогда
				ЗаполнитьЗначенияСвойств(ТекДанные, ДанныеСтрокиКопирования);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуХарактеристик(Команда)
	
	Объект.ХарактеристикиПодрядчика.Очистить();
	
	Вопросы = ПолучитьВопросыХарактеристикиПодрядчика();
	Для Каждого Вопрос Из Вопросы Цикл
		
		НоваяСтрока = Объект.ХарактеристикиПодрядчика.Добавить();
		НоваяСтрока.Вопрос = Вопрос;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВопросыХарактеристикиПодрядчика()
	
	Возврат Справочники.АнкетыПодрядчиков.ПолучитьВопросыХарактеристикиПодрядчика();
	
КонецФункции

