Процедура УдалитьЗаписьВРегистре( вхДокумент )
	УстановитьПривилегированныйРежим(Истина);
	ЗаписьВРегистрДиадока = РегистрыСведений.СостоянияДокументовВДиадоке.СоздатьМенеджерЗаписи();
	ЗаписьВРегистрДиадока.Документ = вхДокумент;
	ЗаписьВРегистрДиадока.Прочитать();
	Если ЗаписьВРегистрДиадока.Выбран() Тогда
		//Евросиб Каблов 20.10.2025 ( Ticket#0418967
		//ЗаписьВРегистрДиадока.Удалить();
		//Евросиб Каблов 04.12.2025 ( #117141
		//Если ЗаписьВРегистрДиадока.ДатаОбновленияСостояния <= ЭтотОбъект.ДатаЗагрузки Тогда
		Если ЗаписьВРегистрДиадока.ДатаОбновленияСостояния <= ЭтотОбъект.ДатаЗагрузки И ЭтотОбъект.Статус <> "Документооборот завершен" Тогда
		//Евросиб Каблов 04.12.2025 )
			ЗаписьВРегистрДиадока.Удалить();
		КонецЕсли;
		//Евросиб Каблов 20.10.2025 )
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры
