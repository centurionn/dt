Процедура ДобавитьЗаписьВРегистр( вхДокумент )
	УстановитьПривилегированныйРежим(Истина);
	ЗаписьВРегистрДиадока = РегистрыСведений.СостоянияДокументовВДиадоке.СоздатьМенеджерЗаписи();
	ЗаписьВРегистрДиадока.Документ = вхДокумент;
	//Евросиб Каблов 20.10.2025 ( Ticket#0418967
	ЗаписьВРегистрДиадока.Прочитать();
	Если ЗаписьВРегистрДиадока.Выбран() Тогда
		//Евросиб Каблов 04.12.2025 ( #117141
		//Если ЗаписьВРегистрДиадока.ДатаОбновленияСостояния > ЭтотОбъект.ДатаЗагрузки Тогда
		Если ЗаписьВРегистрДиадока.ДатаОбновленияСостояния > ЭтотОбъект.ДатаЗагрузки Или ЭтотОбъект.Статус = "Документооборот завершен" Тогда
		//Евросиб Каблов 04.12.2025 )
			Возврат;
		КонецЕсли;
	Иначе
		ЗаписьВРегистрДиадока.Документ = вхДокумент;
	КонецЕсли;
	//Евросиб Каблов 20.10.2025 )
	Если ЗначениеЗаполнено(ЭтотОбъект.Статус) Тогда
		ЗаписьВРегистрДиадока.СостояниеДокументооборота = ЭтотОбъект.Статус;
	Иначе 
		ЗаписьВРегистрДиадока.СостояниеДокументооборота = ЭтотОбъект.ДополнительныйСтатус;
	КонецЕсли;
	// Евросиб(ДИТ) US 96006 ТА 96007 Шевченко А.В. Начало: 02.12.2024
	ЗаписьВРегистрДиадока.СостояниеДокументооборотаДоп = ЭтотОбъект.ДополнительныйСтатус;
	// Евросиб(ДИТ) US 96006 ТА 96007 Шевченко А.В. Конец: 02.12.2024
	ЗаписьВРегистрДиадока.ДатаОбновленияСостояния = ЭтотОбъект.ДатаЗагрузки;
	//Евросиб(ДИТ), Беляев СЮ, BUG 92593 / TA 92595, 07-10-2024, начало
	ЗаписьВРегистрДиадока.ДатаДокумента = ЭтотОбъект.ДатаДокумента;
	ЗаписьВРегистрДиадока.Подписант = ЭтотОбъект.Подписант;
	//Евросиб(ДИТ), Беляев СЮ, BUG 92593 / TA 92595, 07-10-2024, конец
	//Евросиб Шевченко А.В. US 104900 TA 112049 27.06.2025
	ЗаписьВРегистрДиадока.ДатаПодписиКонтрагентом = ЭтотОбъект.ДатаПодписиКонтрагентом;
	//Евросиб Шевченко А.В. US 104900 TA 112049 27.06.2025
	ЗаписьВРегистрДиадока.Записать();
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры
//Евросиб(ДИТ), Беляев СЮ, Ticket#0344893, 28-06-2024, конец

//Евросиб(ДИТ), Беляев СЮ, Ticket#0344893, 28-06-2024, начало
Функция ЭтоСсылкаНаДокумент( вхСсылка )
	ТипСсылки = ТипЗнч(вхСсылка);
	Возврат Документы.ТипВсеСсылки().СодержитТип(ТипСсылки);
КонецФункции
//Евросиб(ДИТ), Беляев СЮ, Ticket#0344893, 28-06-2024, конец

//Евросиб(ДИТ), Беляев СЮ, Ticket#0344893, 28-06-2024, начало
Процедура ЗаписатьИзмененияВРегистр_СостоянияДокументовВДиадоке( Действие )
	
	Если Действие = "УдалитьЗапись" Тогда
		
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "Документ, ВидДокумента, Статус, ДополнительныйСтатус");
		
		Если НЕ ЗначениеЗаполнено(РеквизитыДокумента.ВидДокумента) Тогда
			Возврат;
		КонецЕсли;
		
		//Евросиб(ДИТ), Беляев СЮ, BUG 102843 / TA 104678, 19-05-2025, начало
		Если НЕ ЗначениеЗаполнено(РеквизитыДокумента.Статус) И НЕ ЗначениеЗаполнено(РеквизитыДокумента.ДополнительныйСтатус) Тогда
			Возврат;
		КонецЕсли;
		//Евросиб(ДИТ), Беляев СЮ, BUG 102843 / TA 104678, 19-05-2025, конец
		
		//очищаем в слечае наличия настройки, очищать все нельзя, т.к. последним из пакета может быть записан элемент без включенной регистрации и не останется записи по документу
		Если НЕ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыДокумента.ВидДокумента, "РегистрироватьСостояниеВРегистре") Тогда
			Возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(РеквизитыДокумента.Документ) Тогда
			
			Если ТипЗнч(РеквизитыДокумента.Документ) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда 
				ДокументОснование = ПолучитьДокументОснованияСчетаФактуры(РеквизитыДокумента.Документ);
				Если ДокументОснование <> Неопределено Тогда
					УдалитьЗаписьВРегистре( ДокументОснование );
				КонецЕсли;
			Иначе
				УдалитьЗаписьВРегистре( РеквизитыДокумента.Документ );
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли Действие = "ЗаписатьСтатус" Тогда
		
		//Евросиб(ДИТ), АлексеевАА, Ticket#0359057, 28-06-2024, Начало
		Если (ТипЗнч(ЭтотОбъект.Документ) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг")) 
									ИЛИ (ТипЗнч(ЭтотОбъект.Документ) = Тип("ДокументСсылка.КорректировкаПоступления")) Тогда
			Если ЭтотОбъект.Статус = "Аннулирован" Тогда
				Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Документ, "СтатусДокумента") <> Перечисления.СтатусыДокументовПоступлений.Аннулирован Тогда //Евросиб(ДИТ), Беляев СЮ, Ticket#0363342, 20-08-2024, исключим лишнюю запись документа
					УстановитьПривилегированныйРежим(Истина);
					ДокОбъект = ЭтотОбъект.Документ.ПолучитьОбъект();
					ДокОбъект.СтатусДокумента = Перечисления.СтатусыДокументовПоступлений.Аннулирован;
					ДокОбъект.Записать();
					УстановитьПривилегированныйРежим(Ложь);
				КонецЕсли;
			КонецЕсли;
			// Евросиб Bug 90451 TA 90452 Рыбьяков К.А. 21.08.2024 ((
			ДобавитьЗаписьВРегистр(ЭтотОбъект.Документ);
			// Евросиб Рыбьяков К.А. 21.08.2024 ))
		КонецЕсли;
		//Евросиб(ДИТ), АлексеевАА, Ticket#0359057, 28-06-2024, Конец
		
		Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ВидДокумента) Тогда
			Возврат;
		КонецЕсли;
		
		Если НЕ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.ВидДокумента, "РегистрироватьСостояниеВРегистре") Тогда //пишем в случае наличия настройки
			Возврат;
		КонецЕсли;
		
		//Евросиб(ДИТ), Беляев СЮ, BUG 102843 / TA 104678, 19-05-2025, начало
		Если НЕ ЗначениеЗаполнено(ЭтотОбъект.Статус) И НЕ ЗначениеЗаполнено(ЭтотОбъект.ДополнительныйСтатус) Тогда
			Возврат;
		КонецЕсли;
		//Евросиб(ДИТ), Беляев СЮ, BUG 102843 / TA 104678, 19-05-2025, конец
		
		Если ЗначениеЗаполнено(ЭтотОбъект.Документ) И ЭтоСсылкаНаДокумент( ЭтотОбъект.Документ ) Тогда
			
			Если ТипЗнч(ЭтотОбъект.Документ) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда 
				ДокументОснование = ПолучитьДокументОснованияСчетаФактуры(ЭтотОбъект.Документ);
				Если ДокументОснование <> Неопределено Тогда
					ДобавитьЗаписьВРегистр( ДокументОснование );
				КонецЕсли;
			Иначе
				ДобавитьЗаписьВРегистр( ЭтотОбъект.Документ );
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
//Евросиб(ДИТ), Беляев СЮ, Ticket#0344893, 28-06-2024, конец
