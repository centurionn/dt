			Движение.ДоговорКонтрагента = ДокОбъект.ДоговорКонтрагента;
			Движение.Номенклатура 	= СтрокаТЧ.Номенклатура;
			
			//Ресурсы
			//КоличествоИзменение 	= СтрокаТЧ.Количество - СтрокаТЧ.КоличествоДоИзменения;
			//Ресурсы
			//ДИТ Шевченко А.В. 58535 20.10.2022 -начало
			Если ТипЗнч(ДокОбъект.ДокументРеализации)=Тип("ДокументСсылка.КорректировкаРеализации") и
				 ДокОбъект.ДокументРеализации.ВидОперации=Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение Тогда	
					СуммаИзменение = -СтрокаТЧ.ВсегоДоКорректировки +СтрокаТЧ.СуммаДоИзменения;
					СуммаНДСИзменение= -СтрокаТЧ.СуммаНДСДоКорректировки+СтрокаТЧ.СуммаНДСДоИзменения;
				    Движение.Количество 	= -СтрокаТЧ.КоличествоДоКорректировки+СтрокаТЧ.КоличествоДоИзменения;
            Иначе
			
			СуммаИзменение 			= -СтрокаТЧ.СуммаДоИзменения;
			СуммаНДСИзменение 		= -СтрокаТЧ.СуммаНДСДоИзменения;
			Движение.Количество 	= -СтрокаТЧ.КоличествоДоИзменения;
		    КонецЕсли;
			Если ТипЗнч(ДокОбъект.ДокументРеализации)=Тип("ДокументСсылка.КорректировкаРеализации") и
				ДокОбъект.ДокументРеализации.ВидОперации=Перечисления.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки Тогда
				
				СуммаИзменение 			= -СтрокаТЧ.СуммаДоКорректировки;
				СуммаНДСИзменение 		= -СтрокаТЧ.СуммаНДСДоКорректировки;
				Движение.Количество 	= -СтрокаТЧ.КоличествоДоКорректировки;
				
			КонецЕсли;	
            //ДИТ Шевченко А.В. 58535 20.10.2022 -конец
			
			Движение.СтоимостьВал 	= ?(ДокОбъект.СуммаВключаетНДС, СуммаИзменение, СуммаИзменение + СуммаНДСИзменение);			
			Движение.Стоимость 		= РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Движение.СтоимостьВал, ПараметрыКурсаДокумента, ПараметрыКурсаРегл);
			Движение.НДС 			= РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(СуммаНДСИзменение, ПараметрыКурсаДокумента, ПараметрыКурсаРегл);
			
		КонецЦикла;
		
		Для Каждого СтрокаТЧ Из Услуги Цикл
			
			Движение = Продажи.Добавить();
			Движение.Период = ДокОбъект.ДатаДокумента;
			
			//Измерения
			Движение.ДокументПродажи= ДокОбъект.ИсходныйДокументРеализации;
			Движение.Организация 	= ДокОбъект.Организация;
