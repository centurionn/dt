			Движение.Контрагент = ДокОбъект.Контрагент;
			Движение.ДоговорКонтрагента = ДокОбъект.ДоговорКонтрагента;
			Движение.Номенклатура = СтрокаТЧ.Номенклатура;
			
			//Ресурсы
			КоличествоИзменение = СтрокаТЧ.Количество - СтрокаТЧ.КоличествоДоИзменения;
			СуммаИзменение = СтрокаТЧ.Сумма - СтрокаТЧ.СуммаДоИзменения;
			СуммаНДСИзменение = СтрокаТЧ.СуммаНДС - СтрокаТЧ.СуммаНДСДоИзменения;
			
			Движение.Количество = КоличествоИзменение;
			Движение.СтоимостьВал = ?(ДокОбъект.СуммаВключаетНДС, СуммаИзменение, СуммаИзменение + СуммаНДСИзменение);			
			Движение.Стоимость = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Движение.СтоимостьВал, ПараметрыКурсаДокумента, ПараметрыКурсаРегл);
			Движение.НДС = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(СуммаНДСИзменение, ПараметрыКурсаДокумента, ПараметрыКурсаРегл);
			
		КонецЦикла;
		
		Для Каждого СтрокаТЧ Из Услуги Цикл
			
//Евросиб Гудкова( 04.03.2022 Ticket№ ОАД
			Если СтрокаТЧ.Сумма - СтрокаТЧ.СуммаДоИзменения = 0 и СтрокаТЧ.СуммаНДС - СтрокаТЧ.СуммаНДСДоИзменения = 0 Тогда
				Продолжить;			                                                                                                          	
			КонецЕсли;
// Евросиб Гудкова)
			Движение = Продажи.Добавить();
			Движение.Период = ДокОбъект.ДатаДокумента;			
			//Измерения
			//Движение.ДокументПродажи = Ссылка;
			Движение.ДокументПродажи = ДокОбъект.ИсходныйДокументРеализации;
			Движение.Организация = ДокОбъект.Организация;
			Движение.ЦФО = ДокОбъект.ЦФО;
			Движение.Сделка = ДокОбъект.Сделка;
			//Движение.Продукт = 
			Движение.Контрагент = ДокОбъект.Контрагент;
			Движение.ДоговорКонтрагента = ДокОбъект.ДоговорКонтрагента;
			Движение.Номенклатура = СтрокаТЧ.Номенклатура;
			//Ресурсы
			КоличествоИзменение = СтрокаТЧ.Количество - СтрокаТЧ.КоличествоДоИзменения;
			СуммаИзменение = СтрокаТЧ.Всего - СтрокаТЧ.ВсегоДоИзменения;
			СуммаНДСИзменение = СтрокаТЧ.СуммаНДС - СтрокаТЧ.СуммаНДСДоИзменения;
			
			Движение.Количество = КоличествоИзменение;
