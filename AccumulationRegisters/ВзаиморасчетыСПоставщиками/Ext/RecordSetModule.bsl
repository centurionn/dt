#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	// Евросиб Фролов (04.04.2022 Task №49392
	ЗначениеРегистратора = ЭтотОбъект.Отбор.Регистратор.Значение;
	Для Каждого ТекущаяЗапись Из ЭтотОбъект Цикл
		Если ТипЗнч(ЗначениеРегистратора) <> Тип("ДокументСсылка.ПоступлениеТоваровУслуг")
			И ТипЗнч(ЗначениеРегистратора) <> Тип("ДокументСсылка.КорректировкаПоступления") Тогда 
			ТекущаяЗапись.СогласованаСуммаПТУ = Истина;
			ТекущаяЗапись.ЗавершенаПроверкаПТУ = Истина;
			ТекущаяЗапись.РазрешенаВыгрузкаПТУ = Истина;
		КонецЕсли;
	КонецЦикла;
	// Евросиб Фролов)
КонецПроцедуры

#КонецОбласти

#КонецЕсли
