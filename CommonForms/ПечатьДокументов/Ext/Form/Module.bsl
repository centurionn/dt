&НаСервере
Функция ПолучитьСведенияДляФО()
	
	ТЗВыбраные = ЭтаФорма.НастройкиПечатныхФорм.Выгрузить(Новый Структура("Печатать", Истина));
	
	СоответствиеКонтрагенты = Новый Соответствие;
	
	ОрганизацияИзСсылки = Неопределено;
	
	ПереченьКлиентов = "";
	
	ОтправлятьВФО = Ложь;
	
	Для каждого СтрокаТЗ Из ТЗВыбраные Цикл
		СсылкаДок = СтрокаТЗ.СсылкаДок;
		
		Если Не ЗначениеЗаполнено(СсылкаДок) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ОтправлятьВФО И РегистрыСведений.ИсторияФакторинга.ДокументПроходитПоФакторингу(СсылкаДок) Тогда
			ОтправлятьВФО = Истина;
		КонецЕсли;
		
		ДанныеСсылки = Новый Структура("Контрагент, Организация");
		ЗаполнитьЗначенияСвойств(ДанныеСсылки, СсылкаДок);
		
		Если Не ЗначениеЗаполнено(ОрганизацияИзСсылки) И ЗначениеЗаполнено(ДанныеСсылки.Организация) Тогда
			ОрганизацияИзСсылки = ДанныеСсылки.Организация;
		КонецЕсли;
		
		КонтрагентИзСсылки = ДанныеСсылки.Контрагент;
		
		Если ЗначениеЗаполнено(КонтрагентИзСсылки) И СоответствиеКонтрагенты[КонтрагентИзСсылки] = Неопределено Тогда
			СоответствиеКонтрагенты.Вставить(КонтрагентИзСсылки, Истина);
			ПереченьКлиентов = ПереченьКлиентов + ?(ПереченьКлиентов = "", "", ", ") + Строка(КонтрагентИзСсылки);
		КонецЕсли;
	КонецЦикла;
	
	ЭлАдресФО = "";
	Если ЗначениеЗаполнено(ОрганизацияИзСсылки) Тогда
		Если ЗначениеЗаполнено(ОрганизацияИзСсылки.ГоловнаяОрганизация) Тогда
			ОрганизацияИзСсылки = ОрганизацияИзСсылки.ГоловнаяОрганизация;
		КонецЕсли;                                                                                                                                            
		//Евросиб - АСуслов 19.09.2023 9:55:55 #74724
		//(
		//ЭлАдресФО = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ОрганизацияИзСсылки, Справочники.ВидыКонтактнойИнформации.EmailФО,, Истина);
		ЭлАдресФО = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ОрганизацияИзСсылки, Справочники.ВидыКонтактнойИнформации.EmailФО, ТекущаяДата(), Истина);
		//)
		//Евросиб - АСуслов 19.09.2023 9:59:11 #74724
	Иначе
		ОтправлятьВФО = Ложь;
	КонецЕсли;
	
	
	Сведения = Новый Структура("ОтправлятьВФО, ЭлАдресФО, ПереченьКлиентов", ОтправлятьВФО, ЭлАдресФО, ПереченьКлиентов);
	
	Возврат Сведения;
	
КонецФункции

&НаКлиенте
Процедура ПередЗакрытиемВопросОбОбязательнойОтправке()
	
	ТочкаПродолжения = Новый ОписаниеОповещения("ПередЗакрытиемВопросОбОбязательнойОтправке_Продолжение", ЭтаФорма);
	Если ЭтаФорма.ОтправкаТолькоДляФО Тогда
		ТекстВопроса = "Необходимо выполнить отправку уведомления в ФО." + Символы.ПС + "Отправить?";
	Иначе
		ТекстВопроса = "Необходимо выполнить отправку письма." + Символы.ПС + "Отправить?";
	КонецЕсли;
	
	Ответы = Новый СписокЗначений;
	Ответы.Добавить(КодВозвратаДиалога.Да);
	Ответы.Добавить(КодВозвратаДиалога.Нет);
	Ответы.Добавить("НетДляВсех", " Нет для всех ");
	
	ПоказатьВопрос(ТочкаПродолжения, ТекстВопроса, Ответы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемВопросОбОбязательнойОтправке_Продолжение(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		Отправить(Неопределено);
		
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		
		ЭтаФорма.ОбязательнаяОтправка = Ложь;
		ЭтаФорма.Закрыть();
		
	ИначеЕсли Ответ = "НетДляВсех" Тогда
		
		ЭтаФорма.ОбязательнаяОтправка = Ложь;
		ЭтаФорма.Закрыть(Новый Структура("НеОтправлятьДляВсех", Истина));
		
	КонецЕсли;
	
КонецПроцедуры

