&НаКлиенте
Процедура СохранитьВПрисоединенныхФайлах(Команда) 
	
	Если Параметры.Свойство("ПараметрКоманды")
		И Параметры.ПараметрКоманды.Количество() > 0
		И ЗначениеЗаполнено(Параметры.ПараметрКоманды[0]) Тогда
		ВладелецФайлов = Параметры.ПараметрКоманды[0];
		НаличиеФайлаПФПСЦПоставщикаАвтоперевозки = КонтрольДоступностиДокументов_сервер.ПроверитьНаличиеФайлаПФПСЦПоставщикаАвтоперевозки(ВладелецФайлов);
		
		Если НаличиеФайлаПФПСЦПоставщикаАвтоперевозки Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Печатная форма Протокола (автоперевозки) уже сохранена в Присоединенных файлах. Удалите предыдущую версию файла перед сохранением новой.");
			Возврат;	
		КонецЕсли;
	КонецЕсли;
	
	ФорматыСохранения = Новый Массив;
	ФорматыСохранения.Добавить("PDF");
	
	ВыбранныйОбъект = Неопределено;
	
	РезультатВыбора = Новый Структура;
	РезультатВыбора.Вставить("УпаковатьВАрхив", Ложь);
	РезультатВыбора.Вставить("ФорматыСохранения", ФорматыСохранения);
	РезультатВыбора.Вставить("ВариантСохранения", "Присоединить");
	РезультатВыбора.Вставить("ПапкаДляСохранения", Неопределено);
	РезультатВыбора.Вставить("ОбъектДляПрикрепления", ВыбранныйОбъект);
	РезультатВыбора.Вставить("ПереводитьИменаФайловВТранслит", Ложь);
	
	ВыбранноеЗначение = Неопределено;
	
	ФайлыВоВременномХранилище = ПоместитьТабличныеДокументыВоВременноеХранилище(РезультатВыбора);
	ЗаписанныеОбъекты = ПрисоединитьПечатныеФормыКОбъекту(ФайлыВоВременномХранилище, ФайлыВоВременномХранилище[0].СсылкаДок);
	//Евросиб Шевченко А.В. US 110215 TA 124098 24.11.2025
	Если ТипЗнч(ВладелецФайлов) = Тип("ДокументСсылка.ПСЦПоставщика") Тогда
		Если Параметры.ИменаМакетов = "ПСЦПоставщикаАвтоперевозки" Тогда
			ВыполнитьЗаписьДопПараметра(ВладелецФайлов,ПредопределенноеЗначение("Перечисление.ВидПечатнойФормыПротоколаПСЦПоставщика.БезАдресовТерминалов"));
		ИначеЕсли Параметры.ИменаМакетов = "ПСЦПоставщикаАвтоперевозкиТерминалы" Тогда
			ВыполнитьЗаписьДопПараметра(ВладелецФайлов,ПредопределенноеЗначение("Перечисление.ВидПечатнойФормыПротоколаПСЦПоставщика.САдресамиТерминалов"));
		КонецЕсли;
	КонецЕсли;
	//Евросиб Шевченко А.В. US 110215 TA 124098 24.11.2025
	Если ЗаписанныеОбъекты.Количество() > 0 Тогда
		ОповеститьОбИзменении(ТипЗнч(ЗаписанныеОбъекты[0]));
	КонецЕсли;
	Для Каждого ЗаписанныйОбъект Из ЗаписанныеОбъекты Цикл
		Оповестить("Запись_Файл", Новый Структура, ЗаписанныйОбъект);
	КонецЦикла;
	ПоказатьОповещениеПользователя(, , НСтр("ru = 'Сохранение завершено'"), БиблиотекаКартинок.Информация32);
	
	Если ЗначениеЗаполнено(ВладелецФайлов) Тогда
		Оповестить("СписокПрисоединенныхФайловПСЦПоставщикаИзменен", Новый Структура("ВладелецФайлов", ВладелецФайлов), ЗаписанныйОбъект);
	КонецЕсли;
	
КонецПроцедуры //Евросиб Коханенко Н.А. 26.03.2025 )) #102319

