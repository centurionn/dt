&НаКлиенте
Процедура НапечататьPDFДокумент(ИмяФайлаПечати)
	АдресВХУтилиты = ПодготовитьПечатьPDFДокументСервер(); 
	
	
	// Евросиб Фролов (07.10.2021 Ticket№ 40270
	//ИмяФайлаУтилиты = КаталогВременныхФайлов() + "PDFtoPrinter.exe"; закомментировал
	Шелл = Новый COMОбъект("WScript.Shell");
	ПеременнаяСреды = Шелл.ExpandEnvironmentStrings("%APPDATA%");
	ИмяФайлаУтилиты = ПеременнаяСреды + "\PDFtoPrinter\PDFtoPrinter.exe";
	// Евросиб Фролов)
	
	лФайл = Новый Файл(ИмяФайлаУтилиты);
	Если Не лФайл.Существует() Тогда
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресВХУтилиты);
		ДвоичныеДанные.Записать(ИмяФайлаУтилиты);
	КонецЕсли;
	
	// Евросиб Фролов (07.10.2021 Ticket№ 40270
	//"PDFtoPrinter.exe" filename.pdf "Name of Printer"
	//ЗапуститьПриложение(""""+ИмяФайлаУтилиты + """ """ + ИмяФайлаПечати +  """", , Истина);
	ФайловаяСистемаКлиент.ЗапуститьПрограмму(""""+ИмяФайлаУтилиты + """ """ + ИмяФайлаПечати +  """");
	// Евросиб Фролов)
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьPDFДокумент(Команда)
	ИмяФайлаПечати  = КаталогВременныхФайлов() + НастройкаТекущейПечатнойФормы().ИмяВременногоФайлаПечатнойФормы;
	лФайл = Новый Файл(ИмяФайлаПечати);
	Если лФайл.Существует() Тогда
		НапечататьPDFДокумент(ИмяФайлаПечати);
	Иначе
		Сообщить("Ошибка обработки файла данных печати, печать невозможна.");
	КонецЕсли;
		
КонецПроцедуры
