#Область ПечатьДокументовПоОтборам

&НаКлиенте
Процедура ТЗТипыДокументовПриАктивизацииСтроки(Элемент)
	
	ТекД = Элементы.ТЗТипыДокументов.ТекущиеДанные;
    Если ТекД = Неопределено Тогда
        // ТЗ ТЗТипыДокументов пустая
        Элементы.ТЗСписокДокументов.ОтборСтрок = Неопределено;
    Иначе
        // Для ТЧ Договоры устанавливаем отбор по текущему контрагенту
        ТекВидДокумента = ТекД.ВидДокументаВСистеме;
        Элементы.ТЗСписокДокументов.ОтборСтрок = Новый ФиксированнаяСтруктура("ВидДокументаВСистеме", ТекВидДокумента);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоискДокументовПоОтборам(Команда)
	
	Если НЕ ЗначениеЗаполнено(ПериодДокумента)
		И НЕ ЗначениеЗаполнено(Клиент)
		И НЕ ЗначениеЗаполнено(Договор) Тогда
		Сообщить("Установите отбор для ускорения обработки и уменьшения количества документов");
		Возврат;
	Иначе
		ПоискДокументовПоОтборамНаСервере();
		
		Для Каждого Стр Из ТЗТипыДокументов Цикл
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("ВидДокументаВСистеме",Стр.ВидДокументаВСистеме);
			НайденныеСтроки = ТЗСписокДокументов.НайтиСтроки(ПараметрыОтбора);
			КолвоВыбранных = НайденныеСтроки.Количество();
			Стр.НайденоДокументов = КолвоВыбранных;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПоискДокументовПоОтборамНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КорректировкаРеализации.Ссылка КАК Ссылка,
	               |	КорректировкаРеализации.Дата КАК ДатаДокумента,
	               |	КорректировкаРеализации.Контрагент КАК Контрагент,
	               |	КорректировкаРеализации.ДоговорКонтрагента КАК ДоговорКонтрагента,
	               |	КорректировкаРеализации.СуммаДокумента КАК СуммаДокумента,
	               |	""КорректировкаРеализации"" КАК ВидДокументаВСистеме
	               |ИЗ
	               |	Документ.КорректировкаРеализации КАК КорректировкаРеализации
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА ТИПЗНАЧЕНИЯ(&Контрагент) = ТИП(СТРОКА)
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ КорректировкаРеализации.Контрагент В (&Контрагент)
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА ТИПЗНАЧЕНИЯ(&Договор) = ТИП(СТРОКА)
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ КорректировкаРеализации.ДоговорКонтрагента = &Договор
	               |		КОНЕЦ
	               |	И КорректировкаРеализации.Дата МЕЖДУ &ДатаНач И &ДатаКон
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ОтчетКомитентуОПродажах.Ссылка,
	               |	ОтчетКомитентуОПродажах.Дата,
	               |	ОтчетКомитентуОПродажах.Контрагент,
	               |	ОтчетКомитентуОПродажах.ДоговорКонтрагента,
	               |	ОтчетКомитентуОПродажах.СуммаДокумента,
	               |	""ОтчетКомитентуОПродажах""
	               |ИЗ
	               |	Документ.ОтчетКомитентуОПродажах КАК ОтчетКомитентуОПродажах
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА ТИПЗНАЧЕНИЯ(&Контрагент) = ТИП(СТРОКА)
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ ОтчетКомитентуОПродажах.Контрагент В (&Контрагент)
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА ТИПЗНАЧЕНИЯ(&Договор) = ТИП(СТРОКА)
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ ОтчетКомитентуОПродажах.ДоговорКонтрагента = &Договор
	               |		КОНЕЦ
	               |	И ОтчетКомитентуОПродажах.Дата МЕЖДУ &ДатаНач И &ДатаКон
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	РеализацияТоваровУслуг.Ссылка,
	               |	РеализацияТоваровУслуг.Дата,
	               |	РеализацияТоваровУслуг.Контрагент,
	               |	РеализацияТоваровУслуг.ДоговорКонтрагента,
	               |	РеализацияТоваровУслуг.СуммаДокумента,
	               |	""РеализацияТоваровУслуг""
	               |ИЗ
	               |	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА ТИПЗНАЧЕНИЯ(&Контрагент) = ТИП(СТРОКА)
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ РеализацияТоваровУслуг.Контрагент В (&Контрагент)
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА ТИПЗНАЧЕНИЯ(&Договор) = ТИП(СТРОКА)
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ РеализацияТоваровУслуг.ДоговорКонтрагента = &Договор
	               |		КОНЕЦ
	               |	И РеализацияТоваровУслуг.Дата МЕЖДУ &ДатаНач И &ДатаКон
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СчетНаОплатуПокупателю.Ссылка,
	               |	СчетНаОплатуПокупателю.Дата,
	               |	СчетНаОплатуПокупателю.Контрагент,
	               |	СчетНаОплатуПокупателю.ДоговорКонтрагента,
	               |	СчетНаОплатуПокупателю.СуммаДокумента,
	               |	""СчетНаОплатуПокупателю""
	               |ИЗ
	               |	Документ.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА ТИПЗНАЧЕНИЯ(&Контрагент) = ТИП(СТРОКА)
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ СчетНаОплатуПокупателю.Контрагент В (&Контрагент)
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА ТИПЗНАЧЕНИЯ(&Договор) = ТИП(СТРОКА)
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ СчетНаОплатуПокупателю.ДоговорКонтрагента = &Договор
	               |		КОНЕЦ
	               |	И СчетНаОплатуПокупателю.Дата МЕЖДУ &ДатаНач И &ДатаКон";
	
	Запрос.УстановитьПараметр("Контрагент",?(ЗначениеЗаполнено(Клиент),Клиент,"НЕТ"));
	Запрос.УстановитьПараметр("Договор",?(ЗначениеЗаполнено(Договор),Договор,"НЕТ"));
	Запрос.УстановитьПараметр("ДатаНач",ПериодДокумента.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКон",?(ЗначениеЗаполнено(ПериодДокумента.ДатаОкончания),ПериодДокумента.ДатаОкончания,ТекущаяДата()));

	ТЗСписокДокументов.Загрузить(Запрос.Выполнить().Выгрузить());
	
	ТЗСписокДокументов.Индекс("Отметка");
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	Для Каждого Стр Из ТЗСписокДокументов Цикл
		стр.Отметка = Истина;
	КонецЦикла;
	ПересчетКолваОтмеченныхДокументов();
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметку(Команда)
	Для Каждого Стр Из ТЗСписокДокументов Цикл
		стр.Отметка = Ложь;
	КонецЦикла;
	ПересчетКолваОтмеченныхДокументов();
КонецПроцедуры

&НаКлиенте
Процедура ПечатьВыбранных(Команда)
	
	ОткрытьФорму("ОбщаяФорма.ВыборПодписантов",, ЭтотОбъект);

КонецПроцедуры

 &НаСервере
Процедура СозданиеТаблицыДокументов(СтруктураПодписантов)
	 
	ПараметрыОтбора = Новый Структура;
	ПараметрыОТбора.Вставить("Отметка",Истина);
	НайденныеСтроки = ТЗСписокДокументов.Выгрузить().Скопировать(ПараметрыОтбора);
	
	МассивПараметровКоманды = НОвый Массив;
	
	Параметры.ПараметрКоманды.Очистить();
	Для Каждого Стр Из НайденныеСтроки Цикл
		Параметры.ПараметрКоманды.Добавить(Стр.Ссылка);
	КонецЦикла;
	
	МассивДокументов = ПечатьКомплектаДокументов.СозданиеТаблицыДокументов(НайденныеСтроки,СтруктураПодписантов);
	
	КоллекцияПечатныхФорм = Новый Массив;
	
	ДЛя каждого Комплект из МассивДокументов Цикл
		Поля = УправлениеПечатьюКлиентСервер.ИменаПолейКоллекцииПечатныхФорм();
		ДобавленныеПечатныеФормы = Новый Соответствие;
		Для каждого Док из Комплект Цикл
			ДобавленныеПечатныеФормы = Новый Соответствие;
			ПечатнаяФорма = Новый Структура(СтрСоединить(Поля, ","));
			ПечатнаяФорма.ИмяМакета = Док.ИмяПФ;
			ПечатнаяФорма.ИмяВРЕГ = ВРег(Док.ИмяПФ);
			ПечатнаяФорма.СинонимМакета = Док.ИмяПФ;
			ПечатнаяФорма.ТабличныйДокумент = Док.ТабДок;
			ПечатнаяФорма.ИмяФайлаПечатнойФормы = Док.ИмяПФ;
			ПечатнаяФорма.Экземпляров = 1;
			ДобавленныеПечатныеФормы.Вставить(Док.ИмяПФ, ПечатнаяФорма);
			КоллекцияПечатныхФорм.Добавить(ПечатнаяФорма);
		КОнецЦикла;
		
		ОбластиОбъектов = Новый СписокЗначений;

	КонецЦикла;
	
	Если ОбъектыПечати = Неопределено Тогда
		ОбъектыПечати = Новый СписокЗначений;
	КонецЕсли;
	ПараметрыВывода = УправлениеПечатью.ПодготовитьСтруктуруПараметровВывода();
	 
	СоздатьРеквизитыИЭлементыФормыДляПечатныхФорм(КоллекцияПечатныхФорм);
	
	УбратьПодписьИПечать();
	СохранитьНастройкиКомплектаПоУмолчанию();
	ЗагрузитьНастройкиКоличестваКопий();
	ЕстьРазрешенныйВывод = ЕстьРазрешенныйВывод();
	НастроитьВидимостьЭлементовФормы(ЕстьРазрешенныйВывод);
	УстановитьПризнакДоступностиВыводаВПредставленияхПечатныхФорм(ЕстьРазрешенныйВывод);
	УстановитьИмяПринтераВПодсказкеКнопкиПечать();
	УстановитьЗаголовокФормы();
	Если Не ОбщегоНазначения.ЭтоМобильныйКлиент() И ЭтоПечатьКомплекта() Тогда
		Элементы.Копий.Заголовок = НСтр("ru = 'Копий комплекта'");
	КонецЕсли;
	
	ДополнительнаяИнформация = Новый Структура("Картинка, Текст", Новый Картинка, "");
	МассивСсылок = Новый Массив;
	Если ОбщегоНазначения.ЗначениеСсылочногоТипа(МассивСсылок) Тогда
		МассивСсылок = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(МассивСсылок);
	КонецЕсли;
	Если ТипЗнч(МассивСсылок) = Тип("Массив")
		И МассивСсылок.Количество() > 0
		И ОбщегоНазначения.ЗначениеСсылочногоТипа(МассивСсылок[0]) Тогда
			Если ОбщегоНазначения.ПодсистемаСуществует("ЭлектронноеВзаимодействие") Тогда 
				МодульЭлектронноеВзаимодействие = ОбщегоНазначения.ОбщийМодуль("ЭлектронноеВзаимодействие");
				МодульЭлектронноеВзаимодействие.ПриВыводеНавигационнойСсылкиВФормеОбъектаИБ(ДополнительнаяИнформация, МассивСсылок);
			КонецЕсли;
	КонецЕсли;
	Элементы.ДополнительнаяИнформация.Заголовок = СтроковыеФункцииКлиентСервер.ФорматированнаяСтрока(ДополнительнаяИнформация.Текст);
	Элементы.КартинкаИнформации.Картинка = ДополнительнаяИнформация.Картинка;
	Элементы.ГруппаДополнительнаяИнформация.Видимость = Не ПустаяСтрока(Элементы.ДополнительнаяИнформация.Заголовок);
	Элементы.КартинкаИнформации.Видимость = Элементы.КартинкаИнформации.Картинка.Вид <> ВидКартинки.Пустая;
	
	Если ОбщегоНазначения.ЭтоМобильныйКлиент() Тогда
		Элементы.КоманднаяПанельЛеваяЧасть.Видимость = Ложь;
		Элементы.КоманднаяПанельПраваяЧасть.Видимость = Ложь;
		Элементы.НастройкиПечатныхФорм.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Авто;
		Элементы.КнопкаОтправитьВсеДействия.КнопкаПоУмолчанию = Истина;
		Элементы.Справка.ТолькоВоВсехДействиях= Истина;
		Элементы.КнопкаИзменитьМакет.Видимость = Ложь;
	КонецЕсли;
	
	УправлениеПечатьюПереопределяемый.ПечатьДокументовПриСозданииНаСервере(ЭтотОбъект, Ложь, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура КлиентПриИзменении(Элемент)

	КолвоКлиентов = Клиент.Количество();
	Если КолвоКлиентов <2 Тогда
		Элементы.Договор.Видимость = Истина;
	Иначе
		Элементы.Договор.Видимость = Ложь;
		Договор = ПредопределенноеЗначение("Справочник.ДоговорыКонтрагентов.ПустаяСсылка");
	КонецЕсли;
	
