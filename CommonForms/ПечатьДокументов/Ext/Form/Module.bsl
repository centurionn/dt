Функция ЕстьПодписьИПечать(ТабличныйДокумент)
	
	// ШЕЙКО О.Е. (04.02.2021) В определенных ситуациях он без этого падал
	Если ТипЗнч(ТабличныйДокумент) = Тип("Неопределено") Тогда
	
		Возврат Ложь;
	
	КонецЕсли; 
	
	Для Каждого Рисунок Из ТабличныйДокумент.Рисунки Цикл
		Если СтрНачинаетсяС(Рисунок.Имя, "Печать")
			Или СтрНачинаетсяС(Рисунок.Имя, "Подпись")
			Или СтрНачинаетсяС(Рисунок.Имя, "Факсимиле") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

