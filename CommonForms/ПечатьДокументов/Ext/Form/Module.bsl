		//URLФайла = "file:\\" + ПолноеИмяФайла;
		//Элементы.ПолеФормыОфисногоДокумента.Документ.URL = URLФайла;
		//ПолеФормыОфисногоДокумента = ПолноеИмяФайла;
		//ИнициализироватьПолеТабличнойФормыОфисногоДокумента(НастройкаПечатнойФормы);
	//Евросиб Каблов 23.06.2021 )
	
//Евросиб Литвинов 29.06.2021 ( Ticket#0218510 #35933
		ИнициализироватьПолеТабличнойФормыОфисногоДокумента(НастройкаПечатнойФормы);
//Евросиб Литвинов 29.06.2021 ) Ticket#0218510 #35933
	
	КонецЕсли;
	Элементы.Страницы.ТекущаяСтраница = ТекущаяСтраница;
	
	ПереключитьПометкуКнопкиРедактирование();
	УстановитьДоступностьИзмененияМакета();
	УстановитьДоступностьКомандВывода();
	
//Евросиб Литвинов 10.08.21 ( #0238291 #37147
	Элементы.ГруппаКоманднаяПанель.ПодчиненныеЭлементы.ДекорацияНадписьДиадок.Видимость = ТекущаяСтраница = Элементы.СтраницаОфисныйДокумент;
//Евросиб Литвинов 10.08.21 ) #0238291 #37147
//Евросиб Литвинов 15.09.21 ( #35933 #36212 #36052
	Элементы.ГруппаКоманднаяПанель.ПодчиненныеЭлементы.КоманднаяПанельЛеваяЧасть.ПодчиненныеЭлементы.КнопкаПредварительныйПросмотр.Видимость = НЕ ТекущаяСтраница = Элементы.СтраницаОфисныйДокумент;
	Элементы.ГруппаКоманднаяПанель.ПодчиненныеЭлементы.КоманднаяПанельПраваяЧасть.ПодчиненныеЭлементы.ГруппаСохранитьОтправить.ПодчиненныеЭлементы.КнопкаОтправить.Видимость = 
		МАКС(Элементы.ГруппаКоманднаяПанель.ПодчиненныеЭлементы.КоманднаяПанельПраваяЧасть.ПодчиненныеЭлементы.ГруппаСохранитьОтправить.ПодчиненныеЭлементы.КнопкаОтправить.Видимость, ТекущаяСтраница = Элементы.СтраницаОфисныйДокумент);
