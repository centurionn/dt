#Область ОбработчикиКомандФормы
// ДИТ US 51148 TA 64324 Евсенкин М.А. Начало: 23.01.2023
&НаСервере
Процедура ДобавитьРазрешениеНаСервере() 
	
	СтруктураПараметров = РегистрыСведений.РазрешенныйПериодРедактирования.ПолучитьСтруктуруПараметров();
	
	СтруктураПараметров.ДатаНачалаПериодаРазрешенияРедактирования 		= ПериодРедактирования.ДатаНачала;
	СтруктураПараметров.ДатаОкончанияПериодаРазрешенияРедактирования 	= ПериодРедактирования.ДатаОкончания;
	СтруктураПараметров.ДатаНачалаРазрешенногоПериодаПереноса 			= ПериодПереноса.ДатаНачала;
	СтруктураПараметров.ДатаОкончанияРазрешенногоПериодаПереноса 		= ПериодПереноса.ДатаОкончания;
	
	РегистрыСведений.РазрешенныйПериодРедактирования.ДобавитьРазрешение(СтруктураПараметров);	
	
	ОтобразитьНаФормеАктуальныеПериоды();
	
КонецПроцедуры
// ДИТ US 51148 TA 64324 Евсенкин М.А. Конец: 23.01.2023

// ДИТ US 51148 TA 64324 Евсенкин М.А. Начало: 23.01.2023
&НаСервере
Процедура УдалитьРазрешениеНаСервере()
	РегистрыСведений.РазрешенныйПериодРедактирования.УдалитьРазрешение();
	ОтобразитьНаФормеАктуальныеПериоды();	
КонецПроцедуры
