// ДИТ US 51148 TA 64324 Евсенкин М.А. Начало: 23.01.2023
&НаКлиенте
Процедура ДобавитьРазрешение(Команда)
	
	Отказ = Ложь;
	Ошибки = Неопределено;  
	Если ПериодРедактирования.ДатаНачала < НачалоМесяца(ПериодВО) Тогда 
		Ошибки = Неопределено;
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,"ПериодРедактирования",СтрШаблон("Период редактирования не может быть меньше периода ВО %1",Формат(ПериодВО,"ДФ='ММММ гггг'")));
	КонецЕсли; 
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки,Отказ);
	Если Не Отказ Тогда 
		Если Не ЗначениеЗаполнено(ПериодРедактирования) Тогда 
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,"ПериодРедактирования","Период редактирования не заполнен","Период",,"Период редактирования не заполнен!");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ПериодПереноса) Тогда 
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,"ПериодПереноса","Период переноса не заполнен","Период",,"Период переноса не заполнен!"); 
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки,Отказ);
	КонецЕсли;
	
	Если Не Отказ Тогда 
		Если ПериодыУстановлены Тогда 
			Ф = "ДФ=dd.MM.yyyy";
			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеЗакрытияВопроса",ЭтаФорма);
			ТекстВопроса = СтрШаблон("Текущее разрешение переноса ИСФ из периода
									|%1 - %2 в период %3 - %4. 
									|Изменить на перенос из периода 
									|%5 - %6  в период %7 - %8?",
			Формат(ДатаНачалаПериодаРазрешенияРедактирования,Ф),
			Формат(ДатаОкончанияПериодаРазрешенияРедактирования,Ф),
			Формат(ДатаНачалаРазрешенногоПериодаПереноса,Ф),
			Формат(ДатаОкончанияРазрешенногоПериодаПереноса,Ф),
			Формат(ПериодРедактирования.ДатаНачала,Ф),
			Формат(ПериодРедактирования.ДатаОкончания,Ф), 
			Формат(ПериодПереноса.ДатаНачала,Ф),
			Формат(ПериодПереноса.ДатаОкончания,Ф));
			
			ПоказатьВопрос(ОписаниеОповещения,ТекстВопроса,РежимДиалогаВопрос.ДаНет,60,КодВозвратаДиалога.Нет,,КодВозвратаДиалога.Нет);
		Иначе 
			ДобавитьРазрешениеНаСервере();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
// ДИТ US 51148 TA 64324 Евсенкин М.А. Конец: 23.01.2023

// ДИТ US 51148 TA 64324 Евсенкин М.А. Начало: 23.01.2023
&НаКлиенте
Процедура ПослеЗакрытияВопроса(Ответ, ДополнительныеПараметры) Экспорт 
	Если Ответ = КодВозвратаДиалога.Да Тогда 
		ДобавитьРазрешениеНаСервере();	
	КонецЕсли;	
КонецПроцедуры
// ДИТ US 51148 TA 64324 Евсенкин М.А. Конец: 23.01.2023

// ДИТ US 51148 TA 64324 Евсенкин М.А. Начало: 23.01.2023
&НаКлиенте
Процедура УдалитьРазрешение(Команда)
	УдалитьРазрешениеНаСервере();
КонецПроцедуры
