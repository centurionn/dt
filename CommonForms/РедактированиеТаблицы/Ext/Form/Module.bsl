
&НаСервере
Функция СохранитьНаСервере()
	
	Результат = Неопределено;
	Если ЗначениеЗаполнено(ИмяКонстанты) Тогда
		ХранилищеТаблицыКодов = Новый ХранилищеЗначения(ЭтаФорма.Список.Выгрузить());
		Константы.ТаблицаКодовНоменклатурыИзРИТМа.Установить(ХранилищеТаблицыКодов);
	ИначеЕсли ЗначениеЗаполнено(АдресТаблицы) Тогда
		Результат = ПоместитьВоВременноеХранилище(ЭтаФорма.Список.Выгрузить(), АдресТаблицы);		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	
	Результат = СохранитьНаСервере();
	Закрыть(Результат);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТипТаблицаЗначений = Тип("ТаблицаЗначений");
	Параметры.Свойство("ИмяКонстанты", ИмяКонстанты);
	Параметры.Свойство("АдресТаблицы", АдресТаблицы);
	
	ЗаголовокФормы = "";
	Если Параметры.Свойство("ЗаголовокФормы", ЗаголовокФормы) Тогда
		Заголовок = ЗаголовокФормы;
	КонецЕсли;
	
	Таблица = Неопределено;
	Если ЗначениеЗаполнено(ИмяКонстанты) Тогда
		
		ХранилищеТаблицыКодов = Константы[ИмяКонстанты].Получить();
		Таблица = ХранилищеТаблицыКодов.Получить();
		
		Если ТипЗнч(Таблица) <> ТипТаблицаЗначений Тогда
			Попытка
				Таблица = Константы[ИмяКонстанты].ПолучитьНовуюТаблицу();
			Исключение
			КонецПопытки;
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(АдресТаблицы) Тогда
		
		Таблица = ПолучитьИзВременногоХранилища(АдресТаблицы);
		
	КонецЕсли;
	
	Если ТипЗнч(Таблица) = ТипТаблицаЗначений Тогда
	
		// добавим таблицу: сначала саму таблицу, потом колонку.
		Реквизиты = Новый Массив;
		Реквизиты.Добавить(Новый РеквизитФормы("Список", Новый ОписаниеТипов("ТаблицаЗначений")));
		Для Каждого Ст ИЗ Таблица.Колонки Цикл
			Реквизиты.Добавить(Новый РеквизитФормы(Ст.Имя, Ст.ТипЗначения, "Список"));
		КонецЦикла;

		// добавим реквизиты на форму
		ИзменитьРеквизиты(Реквизиты);

		// добавим элементы формы
		ЭлементСписок = Элементы.Добавить("Список", Тип("ТаблицаФормы"));
		ЭлементСписок.ПутьКДанным = "Список";

		// запретим менять положение строк и сами строки, отключим командную панель
		//Таб.ИзменятьСоставСтрок = Ложь;
		//Таб.ИзменятьПорядокСтрок = Ложь;
		//Таб.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;

		Для Каждого Ст ИЗ Таблица.Колонки Цикл
			Рек = Элементы.Добавить("Список" + Ст.Имя, Тип("ПолеФормы"), ЭлементСписок);
			Рек.Вид = ВидПоляФормы.ПолеВвода;
			Рек.ПутьКДанным = "Список" + "." + Ст.Имя;
			Рек.Заголовок = ?(ЗначениеЗаполнено(Ст.Заголовок), Ст.Заголовок, Ст.Имя);
		КонецЦикла;
		
		ЭтаФорма.Список.Загрузить(Таблица);
		
	КонецЕсли;
	
КонецПроцедуры
