
&НаКлиенте
Процедура ВыбратьВсе(Команда)
	Для каждого Стр из ТЧ Цикл Стр.Пометка = Истина; КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьВыбор(Команда)
	Для каждого Стр из ТЧ Цикл Стр.Пометка = Ложь; КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗначения(Команда)
	
	Если ТС Тогда
		ОпОп = Новый ОписаниеОповещения("ОбработкаВставкиExcel2", ЭтаФорма, Новый Структура("Вагоны", Истина));
		ОткрытьФорму("ОбщаяФорма.ВставкаИзБуфераОбмена", Новый Структура("Вагоны", Истина), , ЭтаФорма.УникальныйИдентификатор, ,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		//ОткрытьФорму("Справочник.ТС.ФормаВыбора", Новый Структура("МножественныйВыбор", Истина), ЭтаФорма, ,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ИначеЕсли ТЕ Тогда
		ОпОп = Новый ОписаниеОповещения("ОбработкаВставкиExcel2", ЭтаФорма, Новый Структура("КТК", Истина));
		ОткрытьФорму("ОбщаяФорма.ВставкаИзБуфераОбмена", Новый Структура("КТК", Истина), , ЭтаФорма.УникальныйИдентификатор, ,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		//ОткрытьФорму("Справочник.ТЕ.ФормаВыбора",, ЭтаФорма, ,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ИначеЕсли ТД Тогда
		ОткрытьФорму("Документ.ТранспортныйДокумент.ФормаВыбора",, ЭтаФорма, ,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВставкиExcel2(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если ЗначениеЗаполнено(Параметр1) Тогда
		Для каждого УЕ Из Параметр1 Цикл
			СтрокиУЕ = ТЧ.НайтиСтроки(Новый Структура("УчетнаяЕдиница", УЕ));
			Если ЗначениеЗаполнено(СтрокиУЕ) Тогда
				Для каждого УЕ Из СтрокиУЕ Цикл
					УЕ.Пометка = Истина;
				КонецЦикла;                    
			Иначе
				нУЕ = ТЧ.Добавить();
				нУЕ.Пометка = Истина;
				нУЕ.N = ТЧ.Количество();
				нУЕ.УчетнаяЕдиница = УЕ;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	ВыбрЗнач = ВыбранноеЗначение;
	
	Если ТипЗнч(ВыбрЗнач) <> Тип("Массив") Тогда
		ВыбрЗнач = Новый Массив;
		ВыбрЗнач.Добавить(ВыбранноеЗначение);
	КонецЕсли;
	
	Для каждого Стр из ВыбрЗнач Цикл
		НСтр = ТЧ.Добавить();
		НСтр.Пометка = Истина;
		НСтр.УчетнаяЕдиница = Стр;
	КонецЦикла;
	
	ОбновитьСчетчик();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСчетчик()
	
	Для Сч = 1 По ТЧ.Количество() Цикл
		ТЧ[Сч-1].N = Сч;
	КонецЦикла;
		
КонецПроцедуры

