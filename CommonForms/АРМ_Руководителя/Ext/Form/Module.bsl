&НаКлиенте
Процедура ОбновитьПоказатели()
	
	СсылкаТекПользователя = ПолучитьСсылкуТекПользователя();
	
	// 1
	ТЗ_1_ВходящиеЗадачи.Очистить();
	ТЗ_1_ИсходящиеЗадачи.Очистить();
	Если Демо Тогда
		
		НСтр = ТЗ_1_ВходящиеЗадачи.Добавить();
		НСтр.Задача = "Укомплектовать КП на Забайкальск";
		НСтр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.ВРаботе");
		НСтр.Постановщик = ПользователиКлиент.ТекущийПользователь();
		НСтр.ДатаПостановки = текущаядата()-7*24*3600;
		НСтр.СрокИсполнения = текущаядата()+3*24*3600;
		
		НСтр = ТЗ_1_ВходящиеЗадачи.Добавить();
		НСтр.Задача = "До конца месяца реализовать 10 поездов в Находку";
		НСтр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.ВРаботе");
		НСтр.Постановщик = ПользователиКлиент.ТекущийПользователь();
		НСтр.ДатаПостановки = НачалоМесяца(текущаядата());
		НСтр.СрокИсполнения = КонецМесяца(текущаядата());
		
		НСтр = ТЗ_1_ИсходящиеЗадачи.Добавить();
		НСтр.Задача = "Продать 200 TEU направления Находка";
		НСтр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.ВРаботе");
		НСтр.Сотрудник = ПользователиКлиент.ТекущийПользователь();
		НСтр.ДатаПостановки = НачалоМесяца(текущаядата());
		НСтр.СрокИсполнения = КонецМесяца(текущаядата());
		
		НСтр = ТЗ_1_ИсходящиеЗадачи.Добавить();
		НСтр.Задача = "Заключить договор с автоперевозчиком ТрансПеревозки ДВ";
		НСтр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Выполнен");
		НСтр.Сотрудник = ПользователиКлиент.ТекущийПользователь();
		НСтр.ДатаПостановки = НачалоМесяца(текущаядата());
		НСтр.СрокИсполнения = КонецМесяца(текущаядата());
		
		НСтр = ТЗ_1_ИсходящиеЗадачи.Добавить();
		НСтр.Задача = "Заключить договор на 75 TEU перевозку в Забайкальск";
		НСтр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Выполнен");
		НСтр.Сотрудник = ПользователиКлиент.ТекущийПользователь();
		НСтр.ДатаПостановки = НачалоМесяца(текущаядата());
		НСтр.СрокИсполнения = КонецМесяца(текущаядата());
		
	Иначе
		
		РЕЗ = АРМ_Сервер.ПолучитьЗначениеПоказателя("ВходящиеЗадачи", Новый Структура("Контекст", ТЗ_1_Контекст));
		Для каждого Стр из РЕЗ Цикл
			ЗаполнитьЗначенияСвойств(ТЗ_1_ВходящиеЗадачи.Добавить(), Стр);
		КонецЦикла;
		
		РЕЗ = АРМ_Сервер.ПолучитьЗначениеПоказателя("ИсходящиеЗадачи", Новый Структура("Контекст", ТЗ_1_Контекст));
		Для каждого Стр из РЕЗ Цикл
			ЗаполнитьЗначенияСвойств(ТЗ_1_ИсходящиеЗадачи.Добавить(), Стр);
		КонецЦикла;
		
	КонецЕсли;
	
	// 2 диаграмма Ганта
	Если Демо Тогда
		ДГ.Очистить();
		ДГ.Обновление = Ложь;
		
		Сделка1 = ДГ.УстановитьТочку("КП SIBUR08 / Сделка № 2568/19 от 04.08.19 Электроугли - Иня-Восточная");
		ПоказательЦвета = ДГ.УстановитьСерию("");
		ПродЗначение = ДГ.ПолучитьЗначение(Сделка1, ПоказательЦвета);
		ПериодХ = ПродЗначение.Добавить();
		ПериодХ.Начало = ТекущаяДата()-3*24*3600;
		ПериодХ.Конец = ТекущаяДата()+7*24*3600;
		ПериодХ.Расшифровка = ПредопределенноеЗначение("Справочник.ОтчетыВ_АРМах.АРМРуководителя");
		
		Сделка2 = ДГ.УстановитьТочку("КП SIBUR07 / Сделка № 1158/19 от 20.07.19 Автово-Эксп - Электроугли");
		ПродЗначение = ДГ.ПолучитьЗначение(Сделка2, ПоказательЦвета);
		ПериодХ = ПродЗначение.Добавить();
		ПериодХ.Начало = ТекущаяДата()-13*24*3600;
		ПериодХ.Конец = ТекущаяДата()-4*24*3600;
		ПериодХ.Расшифровка = ПредопределенноеЗначение("Справочник.ОтчетыВ_АРМах.АРМРуководителя");
		
		
		ДГ.Обновление = Истина;
	Иначе
		
		ВыбратьСделкиОперации();
		
	КонецЕсли;
	
	// 3
	ТЗ_3_ПанельОтчетовКоды.Очистить();
	ТЗ_3_ПанельОтчетов = 0;
	//НСтр = ТЗ_3_ПанельОтчетовКоды.Добавить();
	//НСтр.Код = 0;
	//НСтр.Заголовок = " ";
	//НСтр.КодВызова = "";
		
	Если СсылкаТекПользователя.количество() > 0 Тогда
		Сч = 1;
		Для каждого Стр из ПолучитьСписокОтчетов(СсылкаТекПользователя[0].АРМ) Цикл
			НСтр = ТЗ_3_ПанельОтчетовКоды.Добавить();
			НСтр.Код = Сч;
			НСтр.Заголовок = Стр.НаименованиеОтчета;
			НСтр.КодВызова = "Отчет."+Стр.НаименованиеОтчетаВСистеме+".Форма";
			Сч = Сч + 1;
		КонецЦикла;
		
	КонецЕсли;

	Элементы.ТЗ_3_ПанельОтчетов.СписокВыбора.Очистить();
	Для каждого Стр из ТЗ_3_ПанельОтчетовКоды Цикл Элементы.ТЗ_3_ПанельОтчетов.СписокВыбора.Добавить(Стр.Код, Стр.Заголовок); КонецЦикла;
	
	// 5
	ТЗ_5_СписокПоказателей.Очистить();
	Если СсылкаТекПользователя.количество() > 0 Тогда
		
		ТаблицаКнопок5 = ПолучитьТаблицуКнопок5ПоПрофиль(СсылкаТекПользователя[0].АРМ);
		Для каждого Стр из ТаблицаКнопок5 Цикл
			ЗаполнитьЗначенияСвойств(ТЗ_5_СписокПоказателей.Добавить(), Стр);
		КонецЦикла;
		
		ДобавитьЭлементыНаСервере();
		
	КонецЕсли;
	
	
	// 6
	ТЗ_6_СписокПроблем.Очистить();
	Если Демо Тогда
		
		НСтр = ТЗ_6_СписокПроблем.Добавить();
		НСтр.Исполнитель = ПользователиКлиент.ТекущийПользователь();
		НСтр.Операция = неопределено;
		НСтр.Регион = ПредопределенноеЗначение("Справочник.Локации.РОССИЯ");
		НСтр.КлассНарушения = ПредопределенноеЗначение("Перечисление.КлассНарушенияАРМРуководителя.НарушениеСрока");
		НСтр.МераОтклонения = 55;
		
		НСтр = ТЗ_6_СписокПроблем.Добавить();
		НСтр.Исполнитель = ПользователиКлиент.ТекущийПользователь();
		НСтр.Операция = неопределено;
		НСтр.Регион = ПредопределенноеЗначение("Справочник.Локации.РОССИЯ");
		НСтр.КлассНарушения = ПредопределенноеЗначение("Перечисление.КлассНарушенияАРМРуководителя.ОтказИсполнения");
		НСтр.МераОтклонения = 0;
		
		НСтр = ТЗ_6_СписокПроблем.Добавить();
		НСтр.Исполнитель = ПользователиКлиент.ТекущийПользователь();
		НСтр.Операция = неопределено;
		НСтр.Регион = ПредопределенноеЗначение("Справочник.Локации.РОССИЯ");
		НСтр.КлассНарушения = ПредопределенноеЗначение("Перечисление.КлассНарушенияАРМРуководителя.ОтклонениеЦены");
		НСтр.МераОтклонения = -3500;
		
	Иначе
		
		ВыбратьСписокПроблем();
		
	КонецЕсли;
	
	Элементы.ТЗ_6_СписокПроблемИсполнитель.ТекстПодвала = Формат(ТЗ_6_СписокПроблем.Количество(), "ЧГ=");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЭлементыНаСервере()
	
	МассивУдал = Новый Массив;
	Для каждого стр из Элементы.Группа5ОперативнаяШкала.ПодчиненныеЭлементы Цикл
		Если НЕ стр.Имя = "ПериодОтображенияПоказателей" Тогда
			МассивУдал.Добавить(стр);
		КонецЕсли;
	КонецЦикла;
	Для каждого стр из МассивУдал Цикл
		ЭтаФорма.Элементы.Удалить(стр);
	КонецЦикла;
	
	ГСЧ = Новый ГенераторСлучайныхЧисел();
	
	СопоставлениеГрупп = Новый Соответствие;
	
	Для каждого Стр из ТЗ_5_СписокПоказателей цикл
		
		КП = СтрЗаменить(Стр.КатегорияПоказателя, " ", "");
		
		Если СопоставлениеГрупп.Получить(КП) <> неопределено Тогда Продолжить; КонецЕсли;
		
		НДеко =  ЭтаФорма.Элементы.Добавить(КП, Тип("ГруппаФормы"), Элементы.Группа5ОперативнаяШкала);
		НДеко.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		НДеко.Заголовок = Стр.КатегорияПоказателя;
		НДеко.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно;
		НДеко.Отображение = ОтображениеОбычнойГруппы.СильноеВыделение;
		СопоставлениеГрупп.Вставить(КП, НДеко);
		
	КонецЦикла;
	
	Для каждого Стр из ТЗ_5_СписокПоказателей цикл
		
		ЗначениеПеречисления = Стр.НаименованиеПоказателя;
		ИмяПеречисления = ЗначениеПеречисления.Метаданные().Имя;
		ИндексЗначенияПеречисления = Перечисления[ИмяПеречисления].Индекс(ЗначениеПеречисления);
		ИмяЗначенияПеречисления = Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления[ИндексЗначенияПеречисления].Имя;
		
		НДеко =  ЭтаФорма.Элементы.Добавить(ИмяЗначенияПеречисления, Тип("ДекорацияФормы"), СопоставлениеГрупп.Получить(СтрЗаменить(Стр.КатегорияПоказателя, " ", "")));
		НДеко.Вид = ВидДекорацииФормы.Надпись;
		НДеко.Заголовок = Строка(Стр.НаименованиеПоказателя) + ": " + ПолучитьЧисловоеЗначениеПоказателя(Стр.НаименованиеПоказателя, ПериодОтображенияПоказателей);
		НДеко.УстановитьДействие("Нажатие", "ОбработкаНажатияПоказателя");
		НДеко.Гиперссылка = Истина;
		НДеко.Рамка = Новый Рамка(ТипРамкиЭлементаУправления.Выпуклая, 2);
		НДеко.ЦветТекста = WebЦвета.Синий;
		НДеко.Шрифт = Новый Шрифт("Arial", 12, Истина, Ложь);
		
	КонецЦикла;
	
КонецПроцедуры

