
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ТипЗначенияСписка") Тогда
	
		СписокЗначений.ТипЗначения = Параметры.ТипЗначенияСписка;
		
	КонецЕсли; 
	
	Если Параметры.Свойство("ТекущийСписокЗначений") Тогда
		
		//Евросиб Каблов 28.05.2024 ( #67092
		ТипЗначенияСписка = ТипЗнч(Параметры.ТекущийСписокЗначений);
		Если ТипЗначенияСписка = Тип("Массив") Тогда
			СписокЗначений.ЗагрузитьЗначения(Параметры.ТекущийСписокЗначений);
		Иначе
		//Евросиб Каблов 28.05.2024 )
			Для каждого Стр Из Параметры.ТекущийСписокЗначений Цикл
			
				СписокЗначений.Добавить(Стр.Значение);
			
			КонецЦикла;
		КонецЕсли;
	
	КонецЕсли; 
	
	ЭтаФорма.ЗакрыватьПриВыборе = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВыбор(Команда)
	
	ОповеститьОВыборе(СписокЗначений);
	
КонецПроцедуры

