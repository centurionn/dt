&НаСервере
Процедура ПолучитьФайлыНаСервере(ИдентификаторСтроки)
	
	Если ИдентификаторСтроки = Неопределено Тогда 
		
		// необходимо открыть все файлы
		Для Каждого СтрокаТаблицы Из ТаблицаФайлов Цикл 
			
			ПолучитьФайлНаСервере(СтрокаТаблицы);
			
		КонецЦикла;
			
	Иначе
		
		// необходимо открыть только один файл
		СтрокаТаблицы = ТаблицаФайлов.НайтиПоИдентификатору(ИдентификаторСтроки);
		ПолучитьФайлНаСервере(СтрокаТаблицы);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьФайлНаСервере(СтрокаТаблицы)
	
	//Если ЗначениеЗаполнено(СтрокаТаблицы.АдресВременногоХранилища) Тогда 
	//	Возврат;
	//КонецЕсли;
	
	// получим данные файлов из 1С:ДО
	ИмяМетода = "FileAndDocumentData";
	ИмяОперации = "Get_File";
			
	Прокси = ПолучитьПрокси("ВебСервисОбменаСДО");
	
	//Получаем параметры метода
	ТипWSПараметра = Прокси.ФабрикаXDTO.Пакеты.Получить(ИмяМетода).Получить(ИмяОперации);
	
	//Создаем параметр на основе типа и заполняем значение параметров
	WSПараметр = Прокси.ФабрикаXDTO.Создать(ТипWSПараметра);
	WSПараметр.File_GUID 	= СтрокаТаблицы[ИмяРеквизитаГУИДФайла];
	
	Попытка
		//Вызываем метод веб-сервиса
		ОбъектXDTO = Прокси.Get_File(
			WSПараметр.File_GUID);
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Подключение к вебсервису 1С:ДО'"),
		   УровеньЖурналаРегистрации.Ошибка,,,
		   ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Если ТипЗнч(ОбъектXDTO) <> Тип("ОбъектXDTO")
			ИЛИ ОбъектXDTO.Свойства().Получить("Extension") = Неопределено
			ИЛИ ОбъектXDTO.Свойства().Получить("BinaryData") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
