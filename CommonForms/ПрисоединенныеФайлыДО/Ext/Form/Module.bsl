			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Не заполнено поле %1.'"),
				Элементы.ИмяРеквизитаГУИДФайла.Заголовок), ,
			"ИмяРеквизитаГУИДФайла");
