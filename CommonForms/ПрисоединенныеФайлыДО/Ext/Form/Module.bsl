
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("Документ", Документ);
	Параметры.Свойство("ГУИДДокумента", ГУИДДокумента);
	
	Если ЗначениеЗаполнено(Документ) И НЕ ЗначениеЗаполнено(ГУИДДокумента) Тогда
		
		Заголовок = Строка(Документ);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПротоколОбменов.УИДИсточника КАК УИДИсточника
			|ИЗ
			|	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
			|ГДЕ
			|	ПротоколОбменов.Объект = &Объект
			|	И ПротоколОбменов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных)
			|	И ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.ДО)";
		
		Запрос.УстановитьПараметр("Объект", Документ);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
			ГУИДДокумента = ВыборкаДетальныеЗаписи.УИДИсточника;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ГУИДДокумента) Тогда 
		
		// получим список актуальных файлов из 1С:ДО
		ИмяМетода = "FileAndDocumentData";
		ИмяОперации = "Get_FileInformation";
		
		//Прокси = ВебСервисы_сервер.ПолучитьПрокси("ВебСервисОбменаСДО");
		Прокси = ПолучитьПрокси("ВебСервисОбменаСДО");
		
		//Получаем тип параметра, который передается в метод Get_FileInformation.
		ТипWSПараметра = Прокси.ФабрикаXDTO.Пакеты.Получить(ИмяМетода).Получить(ИмяОперации);
		
		//Создаем параметр на основе типа и заполняем значение параметров
		WSПараметр = Прокси.ФабрикаXDTO.Создать(ТипWSПараметра);
		WSПараметр.Document_GUID 			= ГУИДДокумента;
		WSПараметр.Related_Docs_Required 	= "true"; // получаем файлы связанных документов в 1С:ДО
		
		ОтветВебСервиса = Новый ТаблицаЗначений;
		тзТаблицаФайлов = ТаблицаФайлов.Выгрузить();
		Попытка
			//Вызываем метод веб-сервиса
			ОбъектXDTO = Прокси.Get_FileInformation(
				WSПараметр.Document_GUID,
				WSПараметр.Related_Docs_Required);
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Подключение к вебсервису 1С:ДО'"),
			   УровеньЖурналаРегистрации.Ошибка,,,
			   ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
		////ТаблицаДанных = СериализоватьОбъектВXML(Прокси.ФабрикаXDTO, ОбъектXDTO);
		//Сериализатор = Новый СериализаторXDTO(Прокси.ФабрикаXDTO);
		////ТаблицаДанных = Сериализатор.ПрочитатьXDTO(ОбъектXDTO.FileInfo);
		//ТипWSПараметра1 = Прокси.ФабрикаXDTO.Пакеты.Получить("http://www.w3.org/2001/XMLSchema").Получить("anyType");
		//WSПараметр1 = Прокси.ФабрикаXDTO.Создать(ТипWSПараметра1);
		
		МассивДобавляемыхРеквизитов = Новый Массив;
		
		Если ТипЗнч(ОбъектXDTO) <> Тип("ОбъектXDTO")
				ИЛИ ОбъектXDTO.Свойства().Получить("FileInfo") = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Для Каждого СтрокаОбъектаXDTO Из ОбъектXDTO.FileInfo Цикл
			
			//СтрокаТаблицы = Сериализатор.ПрочитатьXDTO(СтрокаОбъектаXDTO);
			
			Для Каждого СвойствоСтроки Из СтрокаОбъектаXDTO.Свойства() Цикл 
				Если тзТаблицаФайлов.Колонки.Найти(СвойствоСтроки.Имя) = Неопределено Тогда
					ОписаниеТиповРеквизита = Новый ОписаниеТипов(Строка(ТипЗнч(СтрокаОбъектаXDTO[СвойствоСтроки.Имя])));
					тзТаблицаФайлов.Колонки.Добавить(СвойствоСтроки.Имя, ОписаниеТиповРеквизита);
					МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы(СвойствоСтроки.Имя, ОписаниеТиповРеквизита, "ТаблицаФайлов")); 
				КонецЕсли;
			КонецЦикла;
			
			НоваяСтрока = тзТаблицаФайлов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОбъектаXDTO);
			
		КонецЦикла;
		
		ЭтаФорма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
		
		Для Каждого ДобавляемыйРеквизит Из МассивДобавляемыхРеквизитов Цикл 
			НовыйЭлемент = Элементы.Добавить("ТаблицаФайлов"+ДобавляемыйРеквизит.Имя, Тип("ПолеФормы"), Элементы.ТаблицаФайлов);
			НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
			НовыйЭлемент.ПутьКДанным = "ТаблицаФайлов."+ДобавляемыйРеквизит.Имя;
			НовыйЭлемент.ТолькоПросмотр = Истина;
			Если СтрНайти(ДобавляемыйРеквизит.Имя, "GUID") > 0 Тогда 
				ИмяРеквизитаГУИДФайла = ДобавляемыйРеквизит.Имя;
			КонецЕсли;
			Если СтрНайти(ДобавляемыйРеквизит.Имя, "Type") > 0 Тогда 
				ИмяРеквизитаТипФайла = ДобавляемыйРеквизит.Имя;
			КонецЕсли;
		КонецЦикла;
		
		ТаблицаФайлов.Загрузить(тзТаблицаФайлов);
		
	КонецЕсли;
		
	//Евросиб Коханенко Н.А. #64811 27.01.2023 (( 
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #64811 27.01.2023 )) 
	
КонецПроцедуры

