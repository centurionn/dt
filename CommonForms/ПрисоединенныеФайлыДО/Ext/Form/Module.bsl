&НаСервере
Функция ПолучитьПрокси(ИмяКонстанты) Экспорт

	АдресWSDL = Константы[ИмяКонстанты+?(ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована, "Тестовый", "")].Получить();
	Попытка
		Определение = Новый WSОпределения(АдресWSDL);
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Подключение к вебсервису 1С:ДО'"),
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
	Прокси = Новый WSПрокси(Определение, Определение.Сервисы[0].URIПространстваИмен, Определение.Сервисы[0].Имя, Определение.Сервисы[0].ТочкиПодключения[0].Имя);

	Возврат Прокси;
	
КонецФункции

