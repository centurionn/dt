
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СписокСтатусов = Новый СписокЗначений;
	СписокСтатусов.Добавить(Перечисления.СтатусыЭтапов.НаВыполнение);
	СписокСтатусов.Добавить(Перечисления.СтатусыЭтапов.ВРаботе);
	
	СписокСтатусовВыполнено = Новый СписокЗначений;
	СписокСтатусовВыполнено.Добавить(Перечисления.СтатусыЭтапов.Выполнен);
	
	// планируемые
	ПланируемыеЗадачи.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", ТекущаяДата());
	ПользовательЪ = Новый Массив;
	ТекПользователь = Пользователи.ТекущийПользователь();
	
	// ДИТ Поморцева Т.П. 238786 20.08.2021 начало
	//ПользовательЪ.Добавить(текпользователь);
	//ПользовательЪ.Добавить(Пользователи_sd_сервер.ПодобратьЗамещениеОбратное(текпользователь, текущаяДата()));
	ПользовательЪ = Пользователи_sd_Сервер.ПодобратьЗамещениеОбратное(ТекПользователь, ТекущаяДата());
	// ДИТ Поморцева Т.П. 238786 20.08.2021 конец
	ПланируемыеЗадачи.Параметры.УстановитьЗначениеПараметра("Пользователь", ПользовательЪ);
	ПланируемыеЗадачи.Параметры.УстановитьЗначениеПараметра("ПоказатьНаблюдателем", Истина);
	ПланируемыеЗадачи.Параметры.УстановитьЗначениеПараметра("Статус",СписокСтатусов);
	
	// желтый порог
	ЗадачиЖелтыйПорог.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", ТекущаяДата());
	ПользовательЪ = Новый Массив;
	ТекПользователь = Пользователи.ТекущийПользователь();
	
	// ДИТ Поморцева Т.П. 238786 20.08.2021 начало
	//ПользовательЪ.Добавить(текпользователь);
	//ПользовательЪ.Добавить(Пользователи_sd_сервер.ПодобратьЗамещениеОбратное(текпользователь, текущаяДата()));
	ПользовательЪ = Пользователи_sd_Сервер.ПодобратьЗамещениеОбратное(ТекПользователь, ТекущаяДата());
	// ДИТ Поморцева Т.П. 238786 20.08.2021 конец
	ЗадачиЖелтыйПорог.Параметры.УстановитьЗначениеПараметра("Пользователь", ПользовательЪ);
	ЗадачиЖелтыйПорог.Параметры.УстановитьЗначениеПараметра("ПоказатьНаблюдателем", Истина);
	ЗадачиЖелтыйПорог.Параметры.УстановитьЗначениеПараметра("Статус",СписокСтатусов);
	
	// красный порог
	ЗадачиКрасныйПорог.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", ТекущаяДата());
	ПользовательЪ = Новый Массив;
	ТекПользователь = Пользователи.ТекущийПользователь();
	// ДИТ Поморцева Т.П. 238786 20.08.2021 начало
	//ПользовательЪ.Добавить(текпользователь);
	//ПользовательЪ.Добавить(Пользователи_sd_сервер.ПодобратьЗамещениеОбратное(текпользователь, текущаяДата()));
	ПользовательЪ = Пользователи_sd_Сервер.ПодобратьЗамещениеОбратное(ТекПользователь, ТекущаяДата());
	// ДИТ Поморцева Т.П. 238786 20.08.2021 конец

	ЗадачиКрасныйПорог.Параметры.УстановитьЗначениеПараметра("Пользователь", ПользовательЪ);
	ЗадачиКрасныйПорог.Параметры.УстановитьЗначениеПараметра("ПоказатьНаблюдателем", Истина);
	ЗадачиКрасныйПорог.Параметры.УстановитьЗначениеПараметра("Статус",СписокСтатусов);
	
	// выполнено
	ПользовательЪ = Новый Массив;
	ТекПользователь = Пользователи.ТекущийПользователь();
	// ДИТ Поморцева Т.П. 238786 20.08.2021 начало
	//ПользовательЪ.Добавить(текпользователь);
	//ПользовательЪ.Добавить(Пользователи_sd_сервер.ПодобратьЗамещениеОбратное(текпользователь, текущаяДата()));
	ПользовательЪ = Пользователи_sd_Сервер.ПодобратьЗамещениеОбратное(ТекПользователь, ТекущаяДата());
	// ДИТ Поморцева Т.П. 238786 20.08.2021 конец

	ВыполненныеЗадачи.Параметры.УстановитьЗначениеПараметра("Пользователь", ПользовательЪ);
	ВыполненныеЗадачи.Параметры.УстановитьЗначениеПараметра("ПоказатьНаблюдателем", Истина);
	ВыполненныеЗадачи.Параметры.УстановитьЗначениеПараметра("СтатусВыполнен",СписокСтатусовВыполнено);
	
КонецПроцедуры

