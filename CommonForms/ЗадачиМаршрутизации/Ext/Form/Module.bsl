&НаКлиенте
Процедура СтатусВыполнено(Команда)
	
	ТекСтраница = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	ТекТбл = СтрЗаменить(ТекСтраница,"Группа","");
	
	ТекД = Элементы[ТекТбл].ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИзменитьРегистрОперативныеЗадачи(ТекД);
	
	Элементы.ВыполненныеЗадачи.Обновить();
	Элементы[ТекТбл].Обновить();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ИзменитьРегистрОперативныеЗадачи(ТекСтр)
	
	МЗ = РегистрыСведений.ОперативныеЗадачи.СоздатьМенеджерЗаписи();
	МЗ.Исполнитель = ТекСтр.Исполнитель;
	МЗ.Задача = ТекСтр.Задача;
	МЗ.Документ = ТекСтр.Документ;
	МЗ.Наблюдатель = ТекСтр.Наблюдатель;
	МЗ.ВидДокумента = ТекСтр.ВидДокумента;
	МЗ.Вагон = ТекСтр.Вагон;
	МЗ.Контейнер = ТекСтр.Контейнер;
	МЗ.ДокументОснование = ТекСтр.ДокументОснование;

	МЗ.Прочитать();
	МЗ.Статус = Перечисления.СтатусыЭтапов.Выполнен;
	МЗ.ДатаВыполнения = ТекущаяДата();
	
	МЗ.Записать();	
	
КонецПроцедуры

