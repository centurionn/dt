			Для Каждого ДанныеСделки Из Сделки Цикл
				ЭлементСтруктура.Сделки.Добавить(ДанныеСделки.Сделка);
				Если ЗначениеЗаполнено(ДанныеСделки.СчетФактура) Тогда
					//ЭлементСтруктура.СчетаФактуры.Добавить(ДанныеСделки.СчетФактура);
