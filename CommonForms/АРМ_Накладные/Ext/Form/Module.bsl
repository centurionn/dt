				Если ЭлементСтруктура.Исполнители.НайтиПоЗначению(ДанныеСделки.Исполнитель) = Неопределено Тогда
					ЭлементСтруктура.Исполнители.Добавить(ДанныеСделки.Исполнитель);
				КонецЕсли;
				// Евросиб Фролов (23.11.2021 Ticket№ 0244435
				Если ЭлементСтруктура.ДоплатныеПСЦ.НайтиПоЗначению(ДанныеСделки.Доплата_ПСЦ) = Неопределено
					И ЗначениеЗаполнено(ДанныеСделки.Доплата_ПСЦ) Тогда
					//ЭлементСтруктура.ДоплатныеПСЦ.Добавить(ДанныеСделки.Доплата_ПСЦ);
					//ДИТ Шевченко А.В. Ticket#0276731 17.08.2022 -начало
					Представление = "ПСЦ " + ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДанныеСделки.Доплата_ПСЦ.Номер) + " от " + Формат(ДанныеСделки.Доплата_ПСЦ.Дата,"ДФ=dd.MM.yy");
					ЭлементСтруктура.ДоплатныеПСЦ.Добавить(ДанныеСделки.Доплата_ПСЦ,Представление);
					//ДИТ Шевченко А.В. Ticket#0276731 17.08.2022 -конец
				КонецЕсли;
				// Евросиб Фролов)
			КонецЦикла;
		КонецЕсли;
		//Евросиб Каблов 11.12.2020 )
		МассивОтвета.Добавить(ЭлементСтруктура);
	КонецЦикла;

	Возврат МассивОтвета;
	
