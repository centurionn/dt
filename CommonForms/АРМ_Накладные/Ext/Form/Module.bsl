&НаСервере
Функция ПодготовитьДанныеДляРазнесенияНакладных()
	
	ДанныеДляРазнесения = Новый Структура;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Отметка", Истина);
	ТаблицаВыбранныхНакладных = ТЗНакладные.Выгрузить(ПараметрыОтбора);	
	АдресТаблицыНакладных = ПоместитьВоВременноеХранилище(ТаблицаВыбранныхНакладных, УникальныйИдентификатор);	
	ДанныеДляРазнесения.Вставить("АдресТаблицыНакладных", АдресТаблицыНакладных);
	
	МассивПодходящихСделок = НайтиПодходящиеСделки(ТаблицаВыбранныхНакладных);
	ДанныеДляРазнесения.Вставить("МассивПодходящихСделок", МассивПодходящихСделок);
	
	Возврат ДанныеДляРазнесения;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаРазнесенияНакладных(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если параметр1 = Неопределено тогда 
		возврат; 
	КонецЕсли;
	
	// Записать данные в сделку
	ЗаписатьНакладнуюВСделку(параметр1,Параметр2);
	
	ТЗНакладные.Очистить();
	
	ОбновитьТаблицуНаФорме();
	
	Сообщить("Разнесение выполнено!");
	
КонецПроцедуры

