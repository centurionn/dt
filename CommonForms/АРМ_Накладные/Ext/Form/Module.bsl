	               |	ВремТЧ.СтанцияНазначения КАК СтанцияНазначения
	               |ПОМЕСТИТЬ ВТ
	               |ИЗ
	               |	&ВремТЧ КАК ВремТЧ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Связь_ЭТРАН_DC_Сопоставление.СпрДатакор КАК СтанцияОтправления,
	               |	Связь_ЭТРАН_DC_Сопоставление1.СпрДатакор КАК СтанцияНазначения,
	               |	ВТ.Контейнер КАК Контейнер,
	               |	ВТ.Вагон КАК Вагон
	               |ПОМЕСТИТЬ СоответствиеСпр
	               |ИЗ
	               |	ВТ КАК ВТ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Связь_ЭТРАН_DC_Сопоставление КАК Связь_ЭТРАН_DC_Сопоставление
	               |		ПО ВТ.СтанцияОтправления = Связь_ЭТРАН_DC_Сопоставление.СпрЭтрана
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Связь_ЭТРАН_DC_Сопоставление КАК Связь_ЭТРАН_DC_Сопоставление1
	               |		ПО ВТ.СтанцияНазначения = Связь_ЭТРАН_DC_Сопоставление1.СпрЭтрана
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	СделкаСвязьУчетныхЕдиниц.Ссылка КАК Ссылка
	               |ИЗ
	               |	СоответствиеСпр КАК СоответствиеСпр
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	               |		ПО (СделкаСвязьУчетныхЕдиниц.Ссылка.СтанцияОтправления = СоответствиеСпр.СтанцияОтправления)
	               |			И (СделкаСвязьУчетныхЕдиниц.Ссылка.СтанцияНазначения = СоответствиеСпр.СтанцияНазначения)
	               |			И (СделкаСвязьУчетныхЕдиниц.Контейнер.Наименование = СоответствиеСпр.Контейнер
	               |				ИЛИ СделкаСвязьУчетныхЕдиниц.Вагон.Наименование = СоответствиеСпр.Вагон)
	               |ГДЕ
	               |	НЕ СделкаСвязьУчетныхЕдиниц.Ссылка.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ВремТЧ",ТаблицаВыбранных);
	МассивСделок = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ССылка");
	
	Возврат МассивСделок;
КонецФункции


&НаКлиенте
