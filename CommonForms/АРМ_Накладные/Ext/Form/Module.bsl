&НаКлиенте
Процедура ПеренестиВыбранныеСтрокиВДокумент(Команда)
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Отметка", Истина);
	ВыбранныеСтроки = ТЗНакладные.НайтиСтроки(ПараметрыОтбора);
	КоличествоВыбранныхСтрок = ВыбранныеСтроки.Количество();
	Если КоличествоВыбранныхСтрок = 0 Тогда
		ПоказатьПредупреждение(, "Не выбраны строки для переноса в документ!");
		Возврат;
	КонецЕсли;
		
	Если МаксимальноеКоличествоВыбранныхСтрок > 0 Тогда		
		Если КоличествоВыбранныхСтрок > МаксимальноеКоличествоВыбранныхСтрок Тогда
			ТекстПредупреждения = СтрШаблон("Выбрано строк больше, чем доступно! Доступно выбрать %1, выбрано %2", МаксимальноеКоличествоВыбранныхСтрок, КоличествоВыбранныхСтрок);
			ПоказатьПредупреждение(, ТекстПредупреждения);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Ошибки = Неопределено;
	АдресТаблицы = ПоместитьВоВременноеХранилищеТаблицуВыбранныхСтрок(Ошибки);
	
	Если АдресТаблицы = Неопределено Тогда
		Для Каждого ТекстОшибки Из Ошибки Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	Закрыть(АдресТаблицы);
	
КонецПроцедуры

//Евросиб Каблов 25.09.2020
&НаСервере
Функция ПоместитьВоВременноеХранилищеТаблицуВыбранныхСтрок(Ошибки)
	
	Ошибки = Новый Массив;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Отметка", Истина);
	ВыбранныеНакладные = ТЗНакладные.Выгрузить(ПараметрыОтбора);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаНакладных", ВыбранныеНакладные);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаНакладных.Контейнер КАК Контейнер,
	|	ТаблицаНакладных.Вагон КАК Вагон,
	|	ТаблицаНакладных.Документ КАК Документ,
	|	ТаблицаНакладных.ВесГруза КАК ВесГруза,
	|	ТаблицаНакладных.ОКПОГрузоотправителя КАК ОКПОГрузоотправителя,
	|	ТаблицаНакладных.ОКПОГрузополучателя КАК ОКПОГрузополучателя,
	|	ТаблицаНакладных.ГОЕвросиб КАК ГОЕвросиб,
	|	ТаблицаНакладных.ГПЕвросиб КАК ГПЕвросиб
	|ПОМЕСТИТЬ ВТНакладные
	|ИЗ
	|	&ТаблицаНакладных КАК ТаблицаНакладных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТНакладные.Контейнер КАК Контейнер,
	|	ВТНакладные.Вагон КАК Вагон,
	|	ВТНакладные.Документ КАК Документ,
	|	ВТНакладные.ВесГруза КАК ВесГруза,
	|	ВТНакладные.ОКПОГрузоотправителя КАК ОКПОГрузоотправителя,
	|	ВТНакладные.ОКПОГрузополучателя КАК ОКПОГрузополучателя,
	|	э_Накладная.Номер КАК НомерНакладной,
	|	СпрКонтейнеры.Ссылка КАК КонтейнерСсылка,
	|	ТС.Ссылка КАК ВагонСсылка,
	|	ТранспортныйДокумент.Ссылка КАК ТранспортныйДокументСсылка,
	|	ЕСТЬNULL(КонтрагентыГрузополучателиЕвросиб.Ссылка, КонтрагентыГрузополучатели.Ссылка) КАК ГрузополучательСсылка,
	|	ЕСТЬNULL(КонтрагентыГрузоотправителиЕвросиб.Ссылка, КонтрагентыГрузоотправители.Ссылка) КАК ГрузоотправительСсылка,
	|	СпрКонтейнеры.ТипТЕ КАК ТипКонтейнера,
	|	СпрКонтейнеры.ТипТЕ.РазмерКТК КАК РазмерКонтейнера,
	|	ПризнакСобственностиКонтейнераСрезПоследних.ПризнакСобственности КАК ПризнакСобственности
	|ИЗ
	|	ВТНакладные КАК ВТНакладные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.э_Накладная КАК э_Накладная
	|		ПО ВТНакладные.Документ = э_Накладная.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	|		ПО ВТНакладные.Документ = ТранспортныйДокумент.НакладнаяЭТРАН
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТЕ КАК СпрКонтейнеры
	|		ПО ВТНакладные.Контейнер = СпрКонтейнеры.Наименование
	|			И (НЕ СпрКонтейнеры.ПометкаУдаления)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТС КАК ТС
	|		ПО ВТНакладные.Вагон = ТС.Наименование
	|			И (НЕ ТС.ПометкаУдаления)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК КонтрагентыГрузоотправители
	|		ПО ВТНакладные.ОКПОГрузоотправителя = КонтрагентыГрузоотправители.КодПоОКПО
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК КонтрагентыГрузополучатели
	|		ПО ВТНакладные.ОКПОГрузополучателя = КонтрагентыГрузополучатели.КодПоОКПО
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК ОрганизацииГрузоотправители
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК КонтрагентыГрузоотправителиЕвросиб
	|			ПО ОрганизацииГрузоотправители.ОКПО = КонтрагентыГрузоотправителиЕвросиб.КодПоОКПО
	|		ПО ВТНакладные.ГОЕвросиб = ОрганизацииГрузоотправители.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК ОрганизацииГрузополучатели
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК КонтрагентыГрузополучателиЕвросиб
	|			ПО ОрганизацииГрузополучатели.ОКПО = КонтрагентыГрузополучателиЕвросиб.КодПоОКПО
	|		ПО ВТНакладные.ГПЕвросиб = ОрганизацииГрузополучатели.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакСобственностиКонтейнера.СрезПоследних(
	|				,
	|				Контейнер В
	|					(ВЫБРАТЬ
	|						ВТНакладные.Контейнер КАК Контейнер
	|					ИЗ
	|						ВТНакладные КАК ВТНакладные)) КАК ПризнакСобственностиКонтейнераСрезПоследних
	|		ПО ВТНакладные.Контейнер = ПризнакСобственностиКонтейнераСрезПоследних.Контейнер";
	
	ТаблицаВыбранныхНакладных = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТаблицы Из ТаблицаВыбранныхНакладных Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Контейнер) Тогда
			ТекстОшибки = СтрШаблон("В строке по накладной %1 не указан контейнер!", СтрокаТаблицы.НомерНакладной);
			Ошибки.Добавить(ТекстОшибки);
		ИначеЕсли Не ЗначениеЗаполнено(СтрокаТаблицы.КонтейнерСсылка) Тогда
			ТекстОшибки = СтрШаблон("Не найден контейнер с номером %1!", СтрокаТаблицы.Контейнер);
			Ошибки.Добавить(ТекстОшибки);
		КонецЕсли;
	КонецЦикла;
	
	Если Ошибки.Количество() > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаВыбранныхНакладных, Новый УникальныйИдентификатор());
	
КонецФункции

