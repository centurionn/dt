&НаКлиенте
Процедура ИзменениеДанныхПоНакладной()
	// если было изменено одно из полей ТЗ (контроль, контрольустановил, комментарийизмакета, ответственныйменеджер),
	// необходимо изменить все строки по данной накладной (их может быть несколько)
	ТекД = Элементы.ТЗНакладные.ТекущиеДанные;
	
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекД.ДанныеИзменены = Истина;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Документ",ТекД.Документ);
	НайденныеНакладные = ТЗНакладные.НайтиСтроки(ПараметрыОтбора);
	Для Каждого Стр Из НайденныеНакладные Цикл
		ЗаполнитьЗначенияСвойств(Стр,ТекД,"Контроль,КонтрольУстановил,КомментарийИзМакета,ОтветственныйМенеджер,ДанныеИзменены");
	КонецЦикла;
	
	МассивСтруктур = Новый Массив;
	// проверка изменения данным по накладным
	Если ЗначениеЗаполнено(ТекД.Контроль) И ЗначениеЗаполнено(ТекД.ОтветственныйМенеджер) Тогда
		Для Каждого Стр Из НайденныеНакладные Цикл
			СтруктураСтроки = Новый Структура;
			СтруктураСтроки.Вставить("Документ",Стр.Документ);
			СтруктураСтроки.Вставить("Контроль",Стр.Контроль);
			СтруктураСтроки.Вставить("КонтрольУстановил",Стр.КонтрольУстановил);
			СтруктураСтроки.Вставить("КомментарийИзМакета",Стр.КомментарийИзМакета);
			СтруктураСтроки.Вставить("ОтветственныйМенеджер",Стр.ОтветственныйМенеджер);
			
			МассивСтруктур.Добавить(СтруктураСтроки);
		КонецЦикла;
		СохранитьНакладные(МассивСтруктур);
	КонецЕсли;
	
	// если установлена сделка, но в ней не заполнен договор с клиентом, протокол, калькуляция - изменить
	Если ЗначениеЗаполнено(ТекД.Сделка) Тогда
		ПроверкаСделки(ТекД.Сделка,ТекД.Договор,ТекД.Калькуляция,ТекД.Вагон,ТекД.Контейнер);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверкаСделки(ТекСделка,ТекДоговор,ТекКалькуляция,ТекВагон,ТекКонтейнер)
	
	// цикл для каждой выбранной сделки.
	// находим в ней подходящий номер вагона или контейнера и записываем в найденную строку номер накладной
	ПолучОб = ТекСделка.ПолучитьОбъект();
	ТЧ = ПолучОб.СвязьУчетныхЕдиниц;
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Вагон",Справочники.ТС.НайтиПоНаименованию(ТекВагон));
	НайденныеСтроки = ТЧ.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество() = 0 Тогда
		ПараметрыОтбора2 = Новый Структура;
		ПараметрыОтбора2.Вставить("Контейнер", РаботаСКонтейнерамиСервер.НайтиКТК(ТекКонтейнер)); //Справочники.ТЕ.НайтиПоНаименованию(ТекКонтейнер));
		НайденныеСтроки2 = ТЧ.НайтиСтроки(ПараметрыОтбора2);
		Если НайденныеСтроки2.Количество()>0 Тогда
			Если НЕ ЗначениеЗаполнено(НайденныеСтроки2[0].Договор) ТОгда
				НайденныеСтроки2[0].Договор = ТекДоговор;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(НайденныеСтроки2[0].Калькуляция) ТОгда
				НайденныеСтроки2[0].Калькуляция = ТекКалькуляция;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если НЕ ЗначениеЗаполнено(НайденныеСтроки[0].Договор) ТОгда
			НайденныеСтроки[0].Договор = ТекДоговор;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НайденныеСтроки[0].Калькуляция) ТОгда
			НайденныеСтроки[0].Калькуляция = ТекКалькуляция;
		КонецЕсли;
	КонецЕсли;

	Попытка
		ПолучОб.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ПолучОб.Записать(РежимЗаписиДокумента.Запись);
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьШаблон(Команда)
	
	// заполнить ТЗ реквизитов (кроме тч)
	
	СтруктураРеквизитов = новый Массив;
	ЗаполнитьТЗРеквизитовКлиент(Элементы.ГруппаШапка, СтруктураРеквизитов);
	
	Если Команда.Имя = "СохранитьШаблон" Тогда
	
		Если ЗначениеЗаполнено(ШаблоныОтборов) Тогда
			
			ШаблоныОтборов = ЗанестиДанныеВСправочник(ШаблоныОтборов,Неопределено,СтруктураРеквизитов);
			
		Иначе
			Подсказка = "Введите наименование шаблона";
			Оповещение = Новый ОписаниеОповещения("ПослеВводаСтроки",ЭтаФорма, СтруктураРеквизитов);
			ПоказатьВводСтроки(Оповещение, "", Подсказка, 150, Ложь);
		КонецЕсли;
	Иначе
		Подсказка = "Введите наименование шаблона";
		Оповещение = Новый ОписаниеОповещения("ПослеВводаСтроки",ЭтаФорма, СтруктураРеквизитов);
		ПоказатьВводСтроки(Оповещение, "", Подсказка, 150, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТЗРеквизитовКлиент(РодительскаяГруппа, СтруктураР)
	
	Для каждого Стр из РодительскаяГруппа.ПодчиненныеЭлементы Цикл
		
		Если ТипЗнч(Стр) = Тип("ГруппаФормы") Тогда
			ЗаполнитьТЗРеквизитовКлиент(Стр, СтруктураР);
		ИначеЕсли ТипЗнч(Стр) = Тип("ПолеФормы") Тогда
			Попытка
				Если ТипЗнч(ЭтаФорма[Стр.Имя]) = Тип("СписокЗначений") Тогда
					ТекЗначРеквизита = ЭтаФорма[Стр.Имя].ВыгрузитьЗначения();
				Иначе
					ТекЗначРеквизита = ЭтаФорма[Стр.Имя];
				КонецЕсли;
				СтруктураР.Добавить(Новый Структура("ИмяРеквизита, ЗаголовокРеквизита, ЗначениеРеквизита", Стр.Имя, Стр.Заголовок, ТекЗначРеквизита));
			Исключение
				Сообщить("Для элемента " + Стр.Имя + " не обнаружено соответствующего реквизита!");
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если НЕ ЗначениеЗаполнено(ТипПлательщика) Тогда
		ТипПлательщика = ПредопределенноеЗначение("Перечисление.ТипыПлательщиков.ВсеПлательщики");
	КонецЕсли;
	
	ВагоныТЕУ = Элементы.ВагоныТЕУ.СписокВыбора[0].Значение;
	ТипРейса = Элементы.ТипРейса.СписокВыбора[0].Значение;
	
	ДоступностьВыбораПлательщика();
	
	Если ВыполнитьПоискПриОткрытии Тогда
		Поиск(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДоступностьВыбораПлательщика()
	Если ТипПлательщика = ПредопределенноеЗначение("Перечисление.ТипыПлательщиков.ВыбранныеПлательщики") Тогда
		Элементы.Плательщик.Доступность = Истина;
	Иначе
		Элементы.Плательщик.Доступность = Ложь;
		Плательщик = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТипПлательщикаПриИзменении(Элемент)
	ДоступностьВыбораПлательщика();
КонецПроцедуры

&НаКлиенте
Процедура ТЗНакладныеКонтрольПриИзменении(Элемент)
	
	ТекД = Элементы.ТЗНакладные.ТекущиеДанные;
	
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекД.Контроль) Тогда
		ТекД.КонтрольУстановил = ПользователиКлиент.ТекущийПользователь();
	Иначе
		ТекД.КонтрольУстановил = "";
	КонецЕсли;
	
	ИзменениеДанныхПоНакладной();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СтанцияНазначения.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.э_Станции");
	
	СтанцияОтправления.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.э_Станции");
	//Элементы.СтанцияНазначения.ДоступныеТипы = Новый ОписаниеТипов("СправочникСсылка.э_Станции");
	//Элементы.СтанцияНазначения.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.э_Станции");
	//Элементы.СтанцияНазначения.РазрешитьСоставнойТип = Ложь;
	//
	//Элементы.СтанцияОтправления.ДоступныеТипы = Новый ОписаниеТипов("СправочникСсылка.э_Станции");
	//Элементы.СтанцияОтправления.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.э_Станции");
	//Элементы.СтанцияОтправления.РазрешитьСоставнойТип = Ложь;
	
	//Евросиб Каблов 25.09.2020 ( Ticket#0208129
	ЗначениеПараметра = Неопределено;
	Если Параметры.Свойство("ПодборВДокумент", ЗначениеПараметра) И ТипЗнч(ЗначениеПараметра) = Тип("Булево") Тогда
		Элементы.ФормаПеренестиВыбранныеСтрокиВДокумент.Видимость = ЗначениеПараметра;
	КонецЕсли;
	Параметры.Свойство("МаксимальноеКоличествоВыбранныхСтрок", МаксимальноеКоличествоВыбранныхСтрок);
	Параметры.Свойство("ПодборКонтейнеров", ПодборКонтейнеров);
	
	Если Параметры.Свойство("Грузоотправитель", ЗначениеПараметра) Тогда
		Если ТипЗнч(ЗначениеПараметра) = Тип("СправочникСсылка.Контрагенты") И ЗначениеЗаполнено(ЗначениеПараметра) Тогда
			ОКПОГрузоотправитель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначениеПараметра, "КодПоОКПО");
		КонецЕсли;
	КонецЕсли;
	
	Если Параметры.Свойство("Грузополучатель", ЗначениеПараметра) Тогда
		Если ТипЗнч(ЗначениеПараметра) = Тип("СправочникСсылка.Контрагенты") И ЗначениеЗаполнено(ЗначениеПараметра) Тогда
			ОКПОГрузополучателя = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначениеПараметра, "КодПоОКПО");
		КонецЕсли;
	КонецЕсли;
	
	ДатаНачала = Неопределено;
	ДатаОкончания = Неопределено;
	Если Параметры.Свойство("ДатаНачала", ДатаНачала) И Параметры.Свойство("ДатаОкончания", ДатаОкончания) Тогда
		ПериодПеревозки.ДатаНачала = ДатаНачала;
		ПериодПеревозки.ДатаОкончания = ДатаОкончания;
	КонецЕсли;	
	//Евросиб Каблов 25.09.2020 )
	
	//Евросиб Каблов 24.10.2020 ( Ticket#0211298
	ЗначениеПараметра = Неопределено;
	Параметры.Свойство("СтанцияОтправления", ЗначениеПараметра);
	Если ТипЗнч(ЗначениеПараметра) = Тип("СправочникСсылка.Локации") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	э_Станции.Ссылка КАК Станция
		|ИЗ
		|	Справочник.Локации КАК Локации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.э_Станции КАК э_Станции
		|		ПО (ПОДСТРОКА(Локации.КодЖДСтанции, 1, 5) = ПОДСТРОКА(э_Станции.Код, 1, 5))
		|ГДЕ
		|	Локации.Ссылка = &Локация";
		Запрос.УстановитьПараметр("Локация", ЗначениеПараметра);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			СтанцияОтправления = Выборка.Станция;
		КонецЕсли;
	Иначе
		СтанцияОтправления = ЗначениеПараметра;
	КонецЕсли;
	
	Параметры.Свойство("СтанцияНазначения", ЗначениеПараметра);
	Если ТипЗнч(ЗначениеПараметра) = Тип("СправочникСсылка.Локации") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	э_Станции.Ссылка КАК Станция
		|ИЗ
		|	Справочник.Локации КАК Локации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.э_Станции КАК э_Станции
		|		ПО (ПОДСТРОКА(Локации.КодЖДСтанции, 1, 5) = ПОДСТРОКА(э_Станции.Код, 1, 5))
		|ГДЕ
		|	Локации.Ссылка = &Локация";
		Запрос.УстановитьПараметр("Локация", ЗначениеПараметра);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			СтанцияНазначения = Выборка.Станция;
		КонецЕсли;
	Иначе
		СтанцияНазначения = ЗначениеПараметра;
	КонецЕсли;
	
	Параметры.Свойство("ВыполнитьПоискПриОткрытии", ВыполнитьПоискПриОткрытии);
	//Евросиб Каблов 24.10.2020 )
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ШаблоныОтборовНакладных.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ШаблоныОтборовНакладных КАК ШаблоныОтборовНакладных
	               |ГДЕ
	               |	ШаблоныОтборовНакладных.Пользователь = &Пользователь
	               |	И ШаблоныОтборовНакладных.СделатьОсновным";
	Запрос.УстановитьПараметр("Пользователь",Пользователи.ТекущийПользователь());
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ШаблоныОтборов = Выборка.Ссылка;
		// заполнить все сохраненные фильтры
		ТЧ = ШаблоныОтборов.СписокПолейОтборов;
		Для Каждого Стр Из ТЧ Цикл
			ЭтаФорма[Стр.НаименованиеПоляВСистеме] = Стр.СохраненноеЗначение.Получить();
	    КонецЦикла;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВыбиратьЗаписей) Тогда
		ВыбиратьЗаписей = 200;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ШаблоныОтборовПриИзменении(Элемент)
	
	СтруктураПолейШаблона = ШаблоныОтборовПриИзмененииНаСервере(ШаблоныОтборов);

	Для Каждого Стр Из СтруктураПолейШаблона Цикл
		Если Стр.НаименованиеПоляВСистеме = "НомерВагона" ИЛИ
			Стр.НаименованиеПоляВСистеме = "НомерДокумента" ИЛИ
			Стр.НаименованиеПоляВСистеме = "НомерКонтейнера" тогда
			СписокЭл = Новый СписокЗначений;
			СписокЭл.ЗагрузитьЗначения(Стр.СохраненноеЗначение);
			ЭтаФорма[Стр.НаименованиеПоляВСистеме] = СписокЭл;
			
			Если Стр.НаименованиеПоляВСистеме = "НомерДокумента" Тогда
				ЭтаФорма[Стр.НаименованиеПоляВСистеме].ТипЗначения = Новый ОписаниеТипов("ДокументСсылка.э_Накладная");
			КонецЕсли;
			//Если Стр.НаименованиеПоляВСистеме = "НомерВагона" Тогда
			//	ЭтаФорма[Стр.НаименованиеПоляВСистеме].ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.ТС");
			//ИначеЕсли Стр.НаименованиеПоляВСистеме = "НомерДокумента" Тогда
			//	ЭтаФорма[Стр.НаименованиеПоляВСистеме].ТипЗначения = Новый ОписаниеТипов("ДокументСсылка.э_Накладная");
			//ИначеЕсли Стр.НаименованиеПоляВСистеме = "НомерКонтейнера" Тогда
			//	ЭтаФорма[Стр.НаименованиеПоляВСистеме].ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.ТЕ");
			//КонецЕсли;
			
		Иначе
			ЭтаФорма[Стр.НаименованиеПоляВСистеме] = Стр.СохраненноеЗначение;
		КонецЕсли;
		
    КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ШаблоныОтборовПриИзмененииНаСервере(ВыбранныйШаблон)
	
	МассивОтвета = Новый Массив;
	// заполнить все сохраненные фильтры
	ТЧ = ВыбранныйШаблон.СписокПолейОтборов.Выгрузить();
	Для каждого Колонка из ТЧ.Колонки Цикл
		ОписаниеПолучившейсяСтруктуры = Строка(ОписаниеПолучившейсяСтруктуры) + ?(ОписаниеПолучившейсяСтруктуры = "", "", ",") + Строка(Колонка.Имя);
	КонецЦикла;
	
	Для Каждого Стр иЗ ТЧ Цикл
		Если Стр.НаименованиеПоляВСистеме = "ШаблоныОтборов" Тогда
			Продолжить;
		КонецЕсли;
		ЭлементСтруктура = Новый Структура(ОписаниеПолучившейсяСтруктуры);
		ЗаполнитьЗначенияСвойств(ЭлементСтруктура, Стр,,"СохраненноеЗначение");
		ЭлементСтруктура.Вставить("СохраненноеЗначение",Стр.СохраненноеЗначение.Получить());
		МассивОтвета.Добавить(ЭлементСтруктура);
	КонецЦикла;
	
	Возврат МассивОтвета;
	
КонецФункции	


