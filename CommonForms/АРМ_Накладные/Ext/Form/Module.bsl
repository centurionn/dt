&НаКлиенте
Процедура ОткрытьСделкуТекущейСтроки(ТекСтрока, Знач ИмяКолонки)
	
	ИмяКолонки = СтрЗаменить(ИмяКолонки, "ТЗНакладные", "");
	КоличествоСделок = ТекСтрока[ИмяКолонки].Количество();
	Если КоличествоСделок = 1 Тогда
		ПоказатьЗначение(, ТекСтрока[ИмяКолонки][0].Значение);
	ИначеЕсли КоличествоСделок > 1 Тогда
		ОповещениеОВыбореСделки = Новый ОписаниеОповещения("ОбработкаВыбораСделкиИзСписка", ЭтаФорма);
		ПоказатьВыборИзСписка(ОповещениеОВыбореСделки, ТекСтрока[ИмяКолонки]);
	КонецЕсли;
	
КонецПроцедуры

