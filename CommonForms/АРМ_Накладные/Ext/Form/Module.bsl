
&НаКлиенте
Процедура ВставитьИзEXCEL(Команда)
	
	
	Если ЭтаФорма.ТекущийЭлемент.Имя = "ВставитьИзEXCELВагон" Тогда
		ОпОп = Новый ОписаниеОповещения("ОбработкаДобавленияНомерныхПозиций", ЭтаФорма, Новый Структура("Вагоны", Истина));
		ОткрытьФорму("ОбщаяФорма.ВставкаИзБуфераОбмена", Новый Структура("Вагоны", Истина), , ЭтаФорма.УникальныйИдентификатор, ,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ИначеЕсли ЭтаФорма.ТекущийЭлемент.Имя = "ВставитьИзEXCELКТК" Тогда
		ОпОп = Новый ОписаниеОповещения("ОбработкаДобавленияНомерныхПозиций", ЭтаФорма, Новый Структура("КТК", Истина));
		ОткрытьФорму("ОбщаяФорма.ВставкаИзБуфераОбмена", Новый Структура("КТК", Истина), , ЭтаФорма.УникальныйИдентификатор, ,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ИначеЕсли ЭтаФорма.ТекущийЭлемент.Имя = "ВставитьИзEXCELНакладная" Тогда
		ОпОп = Новый ОписаниеОповещения("ОбработкаДобавленияНомерныхПозиций", ЭтаФорма, Новый Структура("Накладные", Истина));
		ОткрытьФорму("ОбщаяФорма.ВставкаИзБуфераОбмена", Новый Структура("Накладные", Истина), , ЭтаФорма.УникальныйИдентификатор, ,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаДобавленияНомерныхПозиций(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если параметр1 = Неопределено тогда 
		возврат; 
	КонецЕсли;
	
	Для каждого Стр из параметр1 Цикл
		Если Параметр2.Свойство("Вагоны") Тогда
			ЭтаФорма.НомерВагона.Добавить(Стр);
		ИначеЕсли Параметр2.Свойство("КТК") Тогда
			ЭтаФорма.НомерКонтейнера.Добавить(Стр);
		ИначеЕсли Параметр2.Свойство("Накладные") Тогда
			НайдНакладная = Преобразовать_ТрДок_вЭНакладная(Стр);
			ЭтаФорма.НомерДокумента.Добавить(НайдНакладная);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
