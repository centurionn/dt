&НаСервереБезКонтекста
Функция ЗанестиДанныеВСправочник(СпрОбъект,ИмяСпр,СтруктураРеквизитов)

	Если ЗначениеЗаполнено(СпрОбъект) Тогда
		
		ПолучОб = СпрОбъект.ПолучитьОбъект();
		ПолучОб.СписокПолейОтборов.Очистить();
		
	Иначе
		
		ПолучОб = Справочники.ШаблоныОтборовНакладных.СоздатьЭлемент();
		ПолучОб.Наименование = ИмяСпр;
		ПолучОб.Пользователь = Пользователи.ТекущийПользователь();
		
	КонецЕсли;
	
	Для Каждого Стр Из СтруктураРеквизитов Цикл
		Если Стр.ИмяРеквизита = "ШаблоныОтборов" Тогда
			Продолжить;
		КонецЕсли;
		НовСтр = ПолучОб.СписокПолейОтборов.Добавить();
		НовСтр.НаименованиеПоляВСистеме = Стр.ИмяРеквизита;
		НовСтр.НаименованиеПоля = Стр.ЗаголовокРеквизита;
		НовСтр.СохраненноеЗначение = Новый ХранилищеЗначения(Стр.ЗначениеРеквизита);
	КонецЦикла;
	
	ПолучОб.Записать();
	
	Возврат ПолучОб.Ссылка;
	
КонецФункции

&НаСервереБезКонтекста
Процедура СохранитьНакладные(МассивНайденныйхСтрок)
	
	ТаблицаВыбранных = Новый ТаблицаЗначений;
	КС = Новый КвалификаторыСтроки(11);
	Массив = Новый Массив;
	Массив.Добавить(Тип("Строка"));
	ОписаниеТиповС = Новый ОписаниеТипов(Массив, , КС);
	ТаблицаВыбранных.Колонки.Добавить("Документ",Новый ОписаниеТипов("ДокументСсылка.э_Накладная"));
	ТаблицаВыбранных.Колонки.Добавить("Контроль",Новый ОписаниеТипов("ПеречислениеСсылка.КонтрольНакладные"));
	ТаблицаВыбранных.Колонки.Добавить("КонтрольУстановил",Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	ТаблицаВыбранных.Колонки.Добавить("КомментарийИзМакета",ОписаниеТиповС);
	ТаблицаВыбранных.Колонки.Добавить("ОтветственныйМенеджер",Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	Для Каждого Стр Из МассивНайденныйхСтрок Цикл
		НовСтр = ТаблицаВыбранных.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,Стр);
	КонецЦикла;
	// делаем запрос по ТЗ для того, чтобы сгруппировать измененные строки накладных и не делать цикл по всем строкам
	// (т.к. детализация идет до контейнера, строк с одной и той же накладной может быть несколько).
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВремТЧ.Документ КАК Документ,
		|	ВремТЧ.Контроль КАК Контроль,
		|	ВремТЧ.КонтрольУстановил КАК КонтрольУстановил,
		|	ВремТЧ.КомментарийИзМакета КАК КомментарийИзМакета,
		|	ВремТЧ.ОтветственныйМенеджер КАК ОтветственныйМенеджер
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ВремТЧ КАК ВремТЧ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Документ КАК Документ,
		|	ВТ.Контроль КАК Контроль,
		|	ВТ.КонтрольУстановил КАК КонтрольУстановил,
		|	ВТ.КомментарийИзМакета КАК КомментарийИзМакета,
		|	ВТ.ОтветственныйМенеджер КАК ОтветственныйМенеджер
		|ИЗ
		|	ВТ КАК ВТ
		|ИТОГИ ПО
		|	Документ";
	
	Запрос.УстановитьПараметр("ВремТЧ",ТаблицаВыбранных);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаНакладная = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаНакладная.Следующий() Цикл
		ТекНакладная = ВыборкаНакладная.Документ;
		ПолучОб = ТекНакладная.ПолучитьОбъект();
		ВыборкаДетальныеЗаписи = ВыборкаНакладная.Выбрать();
	
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Получоб,ВыборкаДетальныеЗаписи);
			Исполнитель = ВыборкаДетальныеЗаписи.ОтветственныйМенеджер;
		КонецЦикла;
		// должны быть только уникальные состояния
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Состояние",ПредопределенноеЗначение("Справочник.Состояния.ДополнительнаяОбработкаНакладной"));
		НайденныеСтр = ПолучОб.Состояния.НайтиСтроки(ПараметрыОтбора);
		// если нашли такое состояние и исполнитель изменился, то удалить такую строку и 
		// записать новую. если исполнитель тот же, то ничего не делаем
		Если НайденныеСтр.Количество()>0 И 
			НЕ НайденныеСтр[0].Исполнитель = Исполнитель Тогда
			ПолучОб.Состояния.Удалить(НайденныеСтр[0]);
			
			НСтр = ПолучОб.Состояния.Добавить();
			СтатусМенеджера = ПредопределенноеЗначение("Справочник.Состояния.ДополнительнаяОбработкаНакладной");
			НСтр.Состояние = СтатусМенеджера;
			НСтр.Исполнитель = Исполнитель;
			НСтр.Наблюдатель = Исполнитель;
			НСтр.НачалоРаботы = ТекущаяДата();
			НСтр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение");
			НСтр.НормативИсполненияСМоментаСоздания = 2;
			
		ИначеЕсли НайденныеСтр.Количество() = 0 Тогда
			НСтр = ПолучОб.Состояния.Добавить();
			СтатусМенеджера = ПредопределенноеЗначение("Справочник.Состояния.ДополнительнаяОбработкаНакладной");
			НСтр.Состояние = СтатусМенеджера;
			НСтр.Исполнитель = Исполнитель;
			НСтр.Наблюдатель = Исполнитель;
			НСтр.НачалоРаботы = ТекущаяДата();
			НСтр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение");
			НСтр.НормативИсполненияСМоментаСоздания = 2;
		КонецЕсли;
		
		ПолучОб.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Поиск(Команда)
	
	ТЗНакладные.Очистить();

	// Евросиб Фролов (23.11.2021 Ticket№ 0244435
	ВыделенныеСтроки = Элементы.ТЗНакладные.ВыделенныеСтроки;
	ВыделенныеСтроки.Очистить();
    // Евросиб Фролов)
	
	Если ВыбиратьЗаписей = 0 Тогда
		ВыбиратьЗаписей = 1;
	КонецЕсли;
	
	ОбновитьТаблицуНаФорме();
	
	ПодключитьОбработчикОжидания("ДинамическоеОбновлениеПодвалаМакета", 2, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ДинамическоеОбновлениеПодвалаМакета()
	
	КоличествоСтр = 0;
	
	Если ТЗНакладные.Количество() > 200 Тогда
		
		КоличествоСтр = ТЗНакладные.Количество();
		
	Иначе
		
		Для Сч = 0 По ТЗНакладные.Количество()-1 Цикл
			
			Если Элементы.ТЗНакладные.ПроверитьСтроку(ТЗНакладные[Сч].ПолучитьИдентификатор()) Тогда
				
				КоличествоСтр = КоличествоСтр + 1;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	//Евросиб Каблов 11.12.2020 ( Ticket#0216886
	//Элементы.ТЗНакладныеСделка.ТекстПодвала = "Количество: " + Формат(КоличествоСтр, "ЧГ=");
	Элементы.ТЗНакладныеСделки.ТекстПодвала = "Количество: " + Формат(КоличествоСтр, "ЧГ=");
	//Евросиб Каблов 11.12.2020 )
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПоискНаСервере(МассивСтруктурРеквизитов)
		
	Запрос = Новый Запрос;
	
	ОтборыДорогаОтправления = "";
	ОтборыДорогаНазначения = "";
	ОтборыСтанцияОтправления = "";
	ОтборыСтанцияНазначения = "";
	//ДИТ, Беляев СЮ, Ticket#0296744, 30-12-2022, начало (реквизиты из документа удалены, комментируем код)
	//ОтборыКонтроль = "";
	//ОтборыМенеджер = "";
	//ДИТ, Беляев СЮ, Ticket#0296744, 30-12-2022, конец
	ОтборыПоискКлиент = "";
	ОтборыПоискДоговор = "";
	ОтборыГрузЕТСНГ = "";
	ОтборыНомерВагона = "";			
	ОтборыНомерДокумента = "";
	ОтборыНомерКонтейнера = "";
	ОтборыОКПОГрузоотправитель = "";
	ОтборыОКПОГрузополучателя = "";
	ОтборыПериодПеревозки = "";
	ОтборыИсключитьВагонСданВАренду = "";
	ОтборыТипПлательщика = "";
	//Евросиб Каблов 11.12.2020 ( Ticket#0216886
	//ОтборыРаспределенаВСделки = " ЕСТЬNULL(Итоговая.Сделка,0) = 0";	
	ОтборыРаспределенаВСделки = " Сделки.Документ ЕСТЬ NULL";
	//Евросиб Каблов 11.12.2020 )
	ОтборыГОГПЕвросиб = "";
	ОтборыДлинаПоОсямАвтосцепки = "";
	ОтборыТипРейса = "";
	ОтборыНакладныеРемонт = "";
	ОтборыКонтейнерныйПоезд = "";
	ОтборыНакладнаяДействительна = " НЕ э_Накладная.ПометкаУдаления";
	ОтборыВыбиратьЗаписей = 200; ПарОтборыВыбиратьЗаписей = "";
	
	НаименованиеПлательщика = Справочники.Контрагенты.ПустаяСсылка();
	ТипПлательщика = Перечисления.ТипыПлательщиков.ПустаяСсылка();
	
	// Евросиб Фролов (05.10.2021 
	// Переменная для того, чтобы понять - заданы отборы или нет
	ЗаданыОтборыДляПоиска = Ложь;	
	// Евросиб Фролов)
	
	Для Каждого Элем Из МассивСтруктурРеквизитов Цикл
		Если (ТипЗнч(Элем.ЗначениеРеквизита) = Тип("СписокЗначений") И Элем.ЗначениеРеквизита.Количество()>0) ИЛИ
			(ТипЗнч(Элем.ЗначениеРеквизита) = Тип("Булево") И Элем.ЗначениеРеквизита) ИЛИ
			(НЕ ТипЗнч(Элем.ЗначениеРеквизита) = Тип("СписокЗначений") И НЕ ТипЗнч(Элем.ЗначениеРеквизита) = Тип("Булево") И ЗначениеЗаполнено(Элем.ЗначениеРеквизита)) Тогда
			// параметры в зависимости от установленных отборов на форме
			
			// Евросиб Фролов (05.10.2021 
			// Если заполнено значение хотя бы одного поля или флажка (кроме количества записей),
			// то отборы заданы и поиск будет выполнен.
			Если Элем.ИмяРеквизита <> "ВыбиратьЗаписей"
				И Элем.ИмяРеквизита <> "ТипПлательщика" Тогда
				ЗаданыОтборыДляПоиска = Истина;
			КонецЕсли;	
			// Евросиб Фролов)
			
			Если Элем.ИмяРеквизита = "ВыбиратьЗаписей" Тогда
				ПарОтборыВыбиратьЗаписей = "	ПЕРВЫЕ " + Формат(Элем.ЗначениеРеквизита,"ЧГ=0");
			КонецЕсли;
			Если Элем.ИмяРеквизита = "ДорогаОтправления" Тогда
				ОтборыДорогаОтправления = "	э_Накладная.СтанцияОтправления.Дорога В(&ОтборыДорогаОтправления)";
				Запрос.УстановитьПараметр("ОтборыДорогаОтправления",Элем.ЗначениеРеквизита);
			КонецЕсли;
			
			Если Элем.ИмяРеквизита = "ДорогаНазначения" Тогда
				ОтборыДорогаНазначения = " э_Накладная.СтанцияНазначения.Дорога В(&ОтборыДорогаНазначения)";
				Запрос.УстановитьПараметр("ОтборыДорогаНазначения",Элем.ЗначениеРеквизита);
			КонецЕсли;
			Если Элем.ИмяРеквизита = "СтанцияОтправления" Тогда
				ОтборыСтанцияОтправления = " э_Накладная.СтанцияОтправления В(&ОтборыСтанцияОтправления)";
				Запрос.УстановитьПараметр("ОтборыСтанцияОтправления",Элем.ЗначениеРеквизита);
			КонецЕсли;
			Если Элем.ИмяРеквизита = "СтанцияНазначения" Тогда
				ОтборыСтанцияНазначения = " э_Накладная.СтанцияНазначения В(&ОтборыСтанцияНазначения)";
				Запрос.УстановитьПараметр("ОтборыСтанцияНазначения",Элем.ЗначениеРеквизита);
			КонецЕсли;
			//ДИТ, Беляев СЮ, Ticket#0296744, 30-12-2022, начало (реквизиты из документа удалены, комментируем код)
			//Если Элем.ИмяРеквизита = "Контроль" Тогда
			//	ОтборыКонтроль = " э_Накладная.Контроль В(&ОтборыКонтроль)";
			//	Запрос.УстановитьПараметр("ОтборыКонтроль",Элем.ЗначениеРеквизита);
			//КонецЕсли;
			//Если Элем.ИмяРеквизита = "Менеджер" Тогда
			//	ОтборыМенеджер = " э_Накладная.ОтветственныйМенеджер В(&ОтборыМенеджер)";
			//	Запрос.УстановитьПараметр("ОтборыМенеджер",Элем.ЗначениеРеквизита);
			//КонецЕсли;
			//ДИТ, Беляев СЮ, Ticket#0296744, 30-12-2022, конец
			Если Элем.ИмяРеквизита = "ПоискКлиент" Тогда
				ОтборыПоискКлиент = " Итоговая.Клиент В(&ОтборыПоискКлиент)";
				Запрос.УстановитьПараметр("ОтборыПоискКлиент",Элем.ЗначениеРеквизита);
			КонецЕсли;
			Если Элем.ИмяРеквизита = "ПоискДоговор" Тогда
				ОтборыПоискДоговор = " Итоговая.Договор В(&ОтборыПоискДоговор)";
				Запрос.УстановитьПараметр("ОтборыПоискДоговор",Элем.ЗначениеРеквизита);
			КонецЕсли;
			Если Элем.ИмяРеквизита = "ГрузЕТСНГ" Тогда
				ОтборыГрузЕТСНГ = " э_НакладнаяГрузыЖД.ЕТСНГ В(&ОтборыГрузЕТСНГ)";
