				Если ЭлементСтруктура.Калькуляции.НайтиПоЗначению(ДанныеСделки.Калькуляция) = Неопределено Тогда
					ЭлементСтруктура.Калькуляции.Добавить(ДанныеСделки.Калькуляция);
