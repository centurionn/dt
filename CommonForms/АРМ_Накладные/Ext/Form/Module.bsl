&НаКлиенте
Процедура ОткрытьПФЖДН(Команда)
	
	ОтмеченныеСтроки = ТЗНакладные.НайтиСтроки(Новый Структура("Отметка", Истина));
	
	Если ОтмеченныеСтроки.Количество() > 0 Тогда
		МассивУникальныхНакладных = Новый Массив;
		Для Каждого ОтмеченнаяСтрока Из ОтмеченныеСтроки Цикл
			Если МассивУникальныхНакладных.Найти(ОтмеченнаяСтрока.НакладнаяИД) = Неопределено Тогда
				ДополнительныйМодульКлиент.ВыполнитьПолучениеФайлаЖДН(ОтмеченнаяСтрока.НакладнаяИД);
				МассивУникальныхНакладных.Добавить(ОтмеченнаяСтрока.НакладнаяИД);
			КонецЕсли;	
		КонецЦикла;	
	Иначе
		ТекущиеДанные = Элементы.ТЗНакладные.ТекущиеДанные;
		
		Если ТекущиеДанные = Неопределено Тогда
			ПоказатьПредупреждение(, "Выделите строку с ЖДН, печатную форму которой необходимо открыть.");
			Возврат;
		КонецЕсли;
		
		ДополнительныйМодульКлиент.ВыполнитьПолучениеФайлаЖДН(ТекущиеДанные.НакладнаяИД);
	КонецЕсли;	
КонецПроцедуры
// Евросиб Фролов)