	ТекД = Элементы.ТЗНакладные.ТекущиеДанные;
	Если ТекД <> неопределено Тогда
		
		Если ЗначениеЗаполнено(ТекД.Документ) Тогда
			ПоказатьЗначение(, ТекД.Документ);
		КонецЕсли;
		
	КонецЕсли;
	
