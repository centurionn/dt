&НаКлиенте
Процедура ПечатьСлужебнойЗаписки(Команда)
	// Евросиб Фролов (23.11.2021 Ticket№ 0244435
	
	МассивКТК = Новый Массив; // массив всех КТК (по всем выделенным строкам) 
	
	// По строковым представлениям получим список КТК для печати служебной записки
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("Отметка", Истина);
	ВыделенныеСтроки = ТЗНакладные.НайтиСтроки(ПараметрыПоиска);
	
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Не выделены строки в списке услуг для печати служебной записи.");
		Возврат;
	КонецЕсли;	
	
	ПротоколыРазные = Ложь;
	Протокол = ПредопределенноеЗначение("Документ.ПСЦ.ПустаяСсылка");
	МассивПредставленийКТК = Новый Массив;	
	
	МассивСтрок = Новый Массив;

	Для Каждого СтрокаДанных Из ВыделенныеСтроки Цикл
		
		МассивПредставленийКТК.Очистить();
		Если МассивПредставленийКТК.Найти(СтрокаДанных.Контейнер) = Неопределено Тогда
			МассивПредставленийКТК.Добавить(СтрокаДанных.Контейнер);
		КонецЕсли;	
		
		Для Каждого ТекущийПротокол Из СтрокаДанных.ДоплатныеПСЦ Цикл
			Если ЗначениеЗаполнено(ТекущийПротокол.Значение)
				И ЗначениеЗаполнено(Протокол)
				И ТекущийПротокол.Значение <> Протокол Тогда
				ПротоколыРазные = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если СтрокаДанных.ДоплатныеПСЦ.Количество() > 0 Тогда
			Протокол = СтрокаДанных.ДоплатныеПСЦ[0].Значение;
		КонецЕсли;	
		
		КонтейнерыСтроки = ПолучитьМассивКТК(МассивПредставленийКТК);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивКТК, КонтейнерыСтроки, Истина);
		
		СтруктураСтроки = Новый Структура;
		СтруктураСтроки.Вставить("Сделки", 				СтрокаДанных.Сделки);
		СтруктураСтроки.Вставить("СчетаФактуры", 		СтрокаДанных.СчетаФактуры);
		СтруктураСтроки.Вставить("Контейнеры", 			КонтейнерыСтроки);
		СтруктураСтроки.Вставить("ДатаРаскредитации", 	СтрокаДанных.ДатаРаскредитации);
		СтруктураСтроки.Вставить("Клиенты", 			СтрокаДанных.Клиенты);
		
		МассивСтрок.Добавить(СтруктураСтроки);
		
	КонецЦикла;
	
	Если ПротоколыРазные Тогда
		ПоказатьПредупреждение(, "В выбранных строках отличаются доплатные протоколы.
								|Проверьте данные.");
		Возврат;
	КонецЕсли;	
	
	//МассивКТК = ПолучитьМассивКТК(МассивПредставленийКТК);
	
	СписокКТК = Новый СписокЗначений;	
	СписокКТК.ЗагрузитьЗначения(МассивКТК);
	
	//ПараметрПечати = ПолучитьТаблицуРТУ(МассивСтрок);
	
	ПараметрыФормыПечати = Новый Структура;
	ПараметрыФормыПечати.Вставить("СписокКТК", 			СписокКТК);
	ПараметрыФормыПечати.Вставить("Протокол", 			Протокол);
	ПараметрыФормыПечати.Вставить("МассивСтрок", 		МассивСтрок);
	//ПараметрыФормыПечати.Вставить("ТаблицаРТУ", 		ПараметрПечати.ТаблицаДанных);
	//ПараметрыФормыПечати.Вставить("ДатыСозданияИСФ", 	ПараметрПечати.ДатыСозданияИСФ);
	
	ОткрытьФорму("Обработка.ПечатьСлужебныхЗаписокПоДоплатнымКТК.Форма", ПараметрыФормыПечати);
	// Евросиб Фролов)
КонецПроцедуры
	
&НаСервере
Функция ПолучитьМассивКТК(МассивПредставленийКТК)
	// Евросиб Фролов (23.11.2021 Ticket№ 0244435

	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТЕ.Ссылка КАК КТК
	|ИЗ
	|	Справочник.ТЕ КАК ТЕ
	|ГДЕ
	|	ТЕ.Наименование В(&МассивПредставленийКТК)
	|	И НЕ ТЕ.ПометкаУдаления";	

	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("МассивПредставленийКТК", МассивПредставленийКТК);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	МассивКТК = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("КТК");
	
	Возврат МассивКТК;
	
	// Евросиб Фролов)
КонецФункции

