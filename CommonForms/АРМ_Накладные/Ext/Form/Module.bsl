					Представление = ТипДок + ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДанныеСделки.СчетФактура.Номер) + " от " + Формат(ДанныеСделки.СчетФактура.Дата,"ДФ=dd.MM.yy");
					ЭлементСтруктура.СчетаФактуры.Добавить(ДанныеСделки.СчетФактура,Представление);
					//ДИТ Шевченко А.В. Ticket#0276731 17.08.2022 -конец
				КонецЕсли;
				Если ЭлементСтруктура.Клиенты.НайтиПоЗначению(ДанныеСделки.Клиент) = Неопределено Тогда
					ЭлементСтруктура.Клиенты.Добавить(ДанныеСделки.Клиент);
				КонецЕсли;
				Если ЭлементСтруктура.Договоры.НайтиПоЗначению(ДанныеСделки.Договор) = Неопределено Тогда
					ЭлементСтруктура.Договоры.Добавить(ДанныеСделки.Договор);
				КонецЕсли;
				Если ЭлементСтруктура.Протоколы.НайтиПоЗначению(ДанныеСделки.Протокол) = Неопределено Тогда
					ЭлементСтруктура.Протоколы.Добавить(ДанныеСделки.Протокол);
