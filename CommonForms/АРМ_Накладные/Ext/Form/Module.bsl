&НаКлиенте
Процедура ДобавитьНакладные_ВСуществующуюСделку(Команда)
	
	СписокНакладных = Новый Массив;
	УжеДобавленныеКТК = Новый Массив;
	Для каждого Стр из ТЗНакладные Цикл
		Если Стр.Отметка И УжеДобавленныеКТК.Найти(Стр.Контейнер) = неопределено Тогда СписокНакладных.Добавить(Новый Структура("Вагон, Контейнер, ЖДН, ВесГруза, Груз", Стр.Вагон, Стр.Контейнер, Стр.Документ, Стр.ВесГруза, Стр.ГрузЕТСНГ)); УжеДобавленныеКТК.Добавить(Стр.Контейнер); КонецЕсли;
	КонецЦикла;
	
	Если СписокНакладных.Количество() = 0 Тогда ПоказатьПредупреждение(, "Перед продолжением отметьте накладные!"); Возврат; КонецЕсли;
	
	БезДоходов = СтрЗаканчиваетсяНа(Команда.Имя, "1");
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораСделки", ЭтаФорма, Новый Структура("СписокНакладных, ВключитьВДоходы, ВключитьВРасходы", СписокНакладных, НЕ БезДоходов, Истина));
	ОткрытьФорму("Документ.Сделка.ФормаВыбора",,,ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораСделки(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = неопределено Тогда Возврат; КонецЕсли;
	
	РезСделка = ВнестиНакладныеВСделку(П1, П2.СписокНакладных, П2.ВключитьВДоходы, П2.ВключитьВРасходы);
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаВопросаОткрытияСделки", ЭтаФорма, РезСделка);
	ПоказатьВопрос(ОпОп, "Данные внесены в сделку. Открыть ее?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаОткрытияСделки(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = КодВозвратаДиалога.Да Тогда ПоказатьЗначение(, П2); КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВнестиНакладныеВСделку(Сделка, СписокНакладных, ВключитьВДоходы, ВключитьВРасходы)
	
	Возврат РаботаСоСделкамиСервер.ВнестиДанныеНакладныхВСделку(СписокНакладных, Сделка, ВключитьВДоходы, ВключитьВРасходы);
	
