&НаКлиенте
Процедура ВагоныВПовагонкеКлиентСледующегоНазначенияПриИзменении(Элемент)
	
	ТекД = Элементы.ВагоныВПовагонке.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// очищаем договор и ПСЦ
	ТекД.ДоговорСледующегоНазначения = ПредопределенноеЗначение("Справочник.ДоговорыКонтрагентов.ПустаяСсылка");
	ТекД.ПСЦСледующегоНазначения = ПредопределенноеЗначение("Документ.ПСЦ.ПустаяСсылка");
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("Клиент",ТекД.Клиент);
	СтруктураЗапроса.Вставить("Договор",ТекД.ДоговорСледующегоНазначения);
	СтруктураОтвета = ПолучитьДоговорПСЦ(СтруктураЗапроса);
	ТекД.ДоговорСледующегоНазначения = СтруктураОтвета.Договор;
	ТекД.ПСЦСледующегоНазначения = СтруктураОтвета.ПСЦ;
	
КонецПроцедуры

&НаКлиенте
Процедура ВагоныВПовагонкеДоговорКонтрагентаПриИзменении(Элемент)
	
	ТекД = Элементы.ВагоныВПовагонке.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИзменениеДоговора(ТекД);
	АвтоПОдстановкаКалькуляции(ТекД, Истина); 
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеДоговора(ТекД)
	
	// очищаем ПСЦ
	ТекД.ПСЦ = ПредопределенноеЗначение("Документ.ПСЦ.ПустаяСсылка");
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("Клиент",ТекД.Клиент);
	СтруктураЗапроса.Вставить("Договор",ТекД.Договор);
	СтруктураОтвета = ПолучитьДоговорПСЦ(СтруктураЗапроса);
	ТекД.ПСЦ = СтруктураОтвета.ПСЦ;
	
КонецПроцедуры

