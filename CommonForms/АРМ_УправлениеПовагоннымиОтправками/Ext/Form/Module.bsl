&НаКлиенте
Процедура ВагоныВПовагонкеЗаявкаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекД = Элементы.ВагоныВПовагонке.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыборЗаявки(ТекД,Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборЗаявки(ТекД,Фактическая)

	ПараметрыЗапроса = Новый СТруктура;
	Если Фактическая Тогда
		ПараметрыЗапроса.Вставить("ПунктОтправления",ТекД.СтанцияОтправления);
		ПараметрыЗапроса.Вставить("ПунктНазначения",ТекД.СтанцияНазначения);
		ПараметрыЗапроса.Вставить("ДатаОтправления",?(ЗначениеЗаполнено(ТекД.ДатаОтправления),ТекД.ДатаОтправления,ТекД.ДатаПередачиВПользование));
		// получаем дату прибытия по табельному расписанию
		ДанныеТабельногоРасписания = Отправки_сервер.ПолучитьТабельноеРасписаниеПоПараметрам(ТекД.СтанцияОтправления, ТекД.СтанцияНазначения);
		КолвоДн = ДанныеТабельногоРасписания.ДобавитьКОкончанию;
		Если ЗначениеЗаполнено(КолвоДн) Тогда
			ДатаПриб = ТекД.ДатаОтправления + КолвоДн*24;
		КонецЕсли;
		Если ЗначениеЗаполнено(КолвоДн) Тогда
			ПараметрыЗапроса.Вставить("ДатаПрибытия",?(ЗначениеЗаполнено(ТекД.ДатаОтправления),ТекД.ДатаОтправления,ТекД.ДатаПередачиВПользование) + КолвоДн);
		КонецЕсли;
	Иначе
		ПараметрыЗапроса.Вставить("ПунктОтправления",ТекД.РегионОтправления);
		ПараметрыЗапроса.Вставить("ПунктНазначения",ТекД.РегионВозврата);
		ПараметрыЗапроса.Вставить("ДатаОтправления",ТекД.ДатаПередачиВПользование);
		// получаем дату прибытия по табельному расписанию
		ДанныеТабельногоРасписания = Отправки_сервер.ПолучитьТабельноеРасписаниеПоПараметрам(ТекД.РегионОтправления, ТекД.РегионВозврата);
		КолвоДн = ДанныеТабельногоРасписания.ДобавитьКОкончанию;
		Если ЗначениеЗаполнено(КолвоДн) Тогда
			ДатаПриб = ТекД.ДатаПередачиВПользование + КолвоДн*24;
		КонецЕсли;
		Если ЗначениеЗаполнено(КолвоДн) Тогда
			ПараметрыЗапроса.Вставить("ДатаПрибытия",ТекД.ДатаПередачиВПользование + КолвоДн);
		КонецЕсли;
	КонецЕсли;
	ПараметрыЗапроса.Вставить("ПСЦ",ТекД.ПСЦ);
	
	СписокЗаявок = Новый СписокЗначений;
	СписокЗаявок.ЗагрузитьЗначения(ПолучитьСписокПодходящихЗаявок(ПараметрыЗапроса));
	
	ПараметрыОтбора = Новый СТруктура;
	ПараметрыОтбора.Вставить("ПодходящиеРейсы",СписокЗаявок);
	
	ДопПараметры = Новый СТруктура;
	ДопПараметры.Вставить("СписокЗаявок",СписокЗаявок);
	ДопПараметры.Вставить("ТекД",ТекД);
	
	ОпОп = новый ОписаниеОповещения("ОбработкаВыбораЗаявки", ЭтаФорма, ДопПараметры);
	ОткрытьФорму("Документ.Заявка.ФормаВыбора",ПараметрыОтбора ,, ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораЗаявки(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если параметр1 = Неопределено тогда 
		возврат; 
	КонецЕсли;
	
	Параметр2.ТекД.Заявка = Параметр1;
	// если в массиве подходящих заявок нет выбранной, то значит, выбрали из общего списка; отметить как неподходящую
	Если Параметр2.СписокЗаявок.НайтиПоЗначению(Параметр1) = Неопределено Тогда
		Параметр2.ТекД.ЗаявкаНеПодходит = Истина;
	Иначе
		Параметр2.ТекД.ЗаявкаНеПодходит = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьЗаявкиНаЗаполненность(СтруктураСтроки)
	
	МассивЗаявок = Новый Массив;
	
	Для Каждого Эл Из СтруктураСтроки Цикл
		Если Не ЗначениеЗаполнено(Эл.Заявка.Подразделение) Тогда
			МассивЗаявок.Добавить(Эл.Заявка);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивЗаявок;
	
КонецФункции	
	
&НаСервереБезКонтекста
Функция ПолучитьСписокПодходящихЗаявок(ПараметрыЗапроса)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаявкаПереченьРейсов.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
	               |ГДЕ
	               |	ЗаявкаПереченьРейсов.Рейс.ПунктОтправления В ИЕРАРХИИ(&ПунктОтправления)
	               //|	И ЗаявкаПереченьРейсов.Рейс.ПунктНазначения В ИЕРАРХИИ(&ПунктНазначения)
	               |	И ВЫБОР
	               |			КОГДА &ДатаЕсть = ИСТИНА
	               |				ТОГДА ЗаявкаПереченьРейсов.Рейс.ДатаПрибытия = &ДатаПрибытия
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И ЗаявкаПереченьРейсов.Рейс.ДатаОтправления = &ДатаОтправления
	               |	И ЗаявкаПереченьРейсов.Ссылка.ПСЦ = &ПСЦ";
	Запрос.УстановитьПараметр("ПунктОтправления",ПараметрыЗапроса.ПунктОтправления);
	Запрос.УстановитьПараметр("ПунктНазначения",ПараметрыЗапроса.ПунктНазначения);
	Запрос.УстановитьПараметр("ДатаОтправления",ПараметрыЗапроса.ДатаОтправления);
	Запрос.УстановитьПараметр("ПСЦ",ПараметрыЗапроса.ПСЦ);
	Если ПараметрыЗапроса.Свойство("ДатаПрибытия") И ЗначениеЗаполнено(ПараметрыЗапроса.ДатаПрибытия) ТОгда
		Запрос.УстановитьПараметр("ДатаЕсть",Истина);
		Запрос.УстановитьПараметр("ДатаПрибытия",ПараметрыЗапроса.ДатаПрибытия);
	Иначе
		Запрос.УстановитьПараметр("ДатаЕсть",Ложь);
		Запрос.УстановитьПараметр("ДатаПрибытия",1);
	КонецЕсли;

	ТЗ = Запрос.Выполнить().Выгрузить();
	МассивЗаявок = ТЗ.ВыгрузитьКолонку("Ссылка");
	
	Возврат МассивЗаявок;
	
КонецФункции

&НаКлиенте
Процедура ПодходВагоновЗаявкаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекД = Элементы.ПодходВагонов.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыборЗаявки(ТекД,Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаявку(Команда)
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "ГруппаВагоныВПовагонке" Тогда
		ИмяТч = "ВагоныВПовагонке";
		Фактическая = Истина;
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "ГруппаВыведеныИзПовагонки" Тогда
		ИмяТЧ = "ВагоныВыведены";
		Фактическая = Истина;
	Иначе
		ИмяТч = "ПодходВагонов";
		Фактическая = Ложь;
	КонецЕсли;
	
	ТекД = Элементы[ИмяТч].ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивСтруктур = Новый Массив;
	мСписокВагонов = Новый Массив;
	Для Каждого Стр Из ЭтаФорма[ИмяТч] Цикл
		СтруктураДанныхСтроки = Новый Структура;
		Если НЕ Стр.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Стр.Клиент) Тогда
			Сообщить("У выбранного вагона "+Стр.НомерВагона+" не выбран клиент. Выберите клиента и повторите попытку создания заявки");
			ВОзврат;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Стр.Договор) Тогда
			Сообщить("У выбранного вагона "+Стр.НомерВагона+" не выбран договор. Выберите договор и повторите попытку создания заявки");
			ВОзврат;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Стр.ПСЦ) Тогда
			Сообщить("У выбранного вагона "+Стр.НомерВагона+" не выбран ПСЦ. Выберите ПСЦ и повторите попытку создания заявки");
			ВОзврат;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Стр.НДС) Тогда
			Сообщить("У выбранного вагона "+Стр.НомерВагона+" не выбран НДС. Выберите НДС и повторите попытку создания заявки");
			ВОзврат;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Стр.Калькуляция) Тогда
			Сообщить("У выбранного вагона "+Стр.НомерВагона+" не выбрана калькуляция. Выберите калькуляцию и повторите попытку создания заявки");
			ВОзврат;
		КонецЕсли;
		//Если НЕ ЗначениеЗаполнено(Стр.СтанцияПодачи) Тогда
		Если НЕ ЗначениеЗаполнено(Стр.СтанцияОтправления) Тогда
			Сообщить("У выбранного вагона "+Стр.НомерВагона+" не выбрана станция подачи. Выберите станцию подачи и повторите попытку создания заявки");
			ВОзврат;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Стр.ДатаОтправления) Тогда
			Сообщить("У выбранного вагона "+Стр.НомерВагона+" не заполнена дата отправления. Создание заявки отменено");
			ВОзврат;
		КонецЕсли;
		//Если Стр.КалькуляцияНеПодходит Тогда
		//	Сообщить("У выбранных вагонов калькуляции не подходят к рейсу. Выберите другие и повторите попытку создания заявки");
		//	ВОзврат;
		//КонецЕсли;
		
		Для Каждого ЭлемСп Из СписокКолонокВагоныВПовагонке Цикл
			Попытка
				СтруктураДанныхСтроки.Вставить(ЭлемСп.Значение,Стр[ЭлемСп.Значение]);
			Исключение
			КонецПопытки;
		КонецЦикла;
		МассивСтруктур.Добавить(СтруктураДанныхСтроки);
		
	КонецЦикла;
	
	Если МассивСтруктур.Количество() = 0 Тогда
		Сообщить("Не выбрано ни одной строки для создания заявки");
		Возврат;
	КонецЕсли;
	
	МассивЗаявок = СоздатьЗаявкуНаСервере(МассивСтруктур,Истина);
	
	//МассивЗаявокКЗаписи = Новый Массив;
	Для Каждого Эл Из МассивЗаявок Цикл
		Сообщить(Строка(Эл.Заявка) + " успешно создана!");
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("НомерВагона",Эл.НомерВагона);
		ПараметрыОтбора.Вставить("ДатаПомещенияВРежимПовагонки",Эл.ДатаПомещенияВРежимПовагонки);
		НайдСтр = ЭтаФорма[ИмяТч].НайтиСтроки(ПараметрыОтбора);
		Если НайдСтр.Количество()>0 Тогда
			НайдСтр[0].Заявка = Эл.Заявка;
			НайдСтр[0].ЗаявкаНеПодходит = Ложь;
			//МассивЗаявокКЗаписи.Добавить(Эл.Заявка);
//			СохранитьДанныеВРСПовагонки(СтруктураДанныхСтроки,Ложь,ЗаявкаИзменилась,Ложь);
		КонецЕсли;
	КонецЦикла;
	
	//Если МассивЗаявокКЗаписи.Количество()>0 Тогда
	//	Если Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "ГруппаВагоныВПовагонке" Тогда
	//		Фактическая = Истина;
	//	Иначе
	//		Фактическая = Ложь;
	//	КонецЕсли;
	//	ЗаписатьДанныеПоВагонуВЗаявку(МассивЗаявокКЗаписи,Фактическая);
	//КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьЗаявкуНаСервере(СтруктураДанныхСтроки,Фактическая)
	
	// сгруппируем данные для записи в заявки
	ТЗ_Заявок = Новый ТаблицаЗначений;
	ТЗ_Заявок.Колонки.Добавить("ДатаОтправления",Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТЗ_Заявок.Колонки.Добавить("ДатаПрибытия",Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТЗ_Заявок.Колонки.Добавить("ДатаПомещенияВРежимПовагонки",Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТЗ_Заявок.Колонки.Добавить("СтанцияОтправления",Новый ОписаниеТипов("СправочникСсылка.Локации"));
	ТЗ_Заявок.Колонки.Добавить("СтанцияНазначения",Новый ОписаниеТипов("СправочникСсылка.Локации"));
	ТЗ_Заявок.Колонки.Добавить("Клиент",Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТЗ_Заявок.Колонки.Добавить("Договор",Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
	ТЗ_Заявок.Колонки.Добавить("ПСЦ",Новый ОписаниеТипов("ДокументСсылка.ПСЦ"));
	ТЗ_Заявок.Колонки.Добавить("Груженый",Новый ОписаниеТипов("Булево"));
	ТЗ_Заявок.Колонки.Добавить("НомерВагона",Новый ОписаниеТипов("СправочникСсылка.ТС"));
	ТЗ_Заявок.Колонки.Добавить("Заявка",Новый ОписаниеТипов("ДокументСсылка.Заявка"));
	ТЗ_Заявок.Колонки.Добавить("ГУИДЗаявки",Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(36)));
	ТЗ_Заявок.Колонки.Добавить("Груз",Новый ОписаниеТипов("СправочникСсылка.Грузы"));
	ТЗ_Заявок.Колонки.Добавить("МодельВагона",Новый ОписаниеТипов("СправочникСсылка.ТипоразмерыТС"));
	ТЗ_Заявок.Колонки.Добавить("Калькуляция",Новый ОписаниеТипов("ДокументСсылка.Калькуляция"));

	Для Каждого Эл Из СтруктураДанныхСтроки Цикл
		
		//Если ЗначениеЗаполнено(Эл.Заявка) Тогда
		//	Продолжить;
		//КонецЕсли; 
		НовСтр = ТЗ_Заявок.Добавить();
		Если Фактическая Тогда
			
			//СтнОтпр = Эл.СтанцияПодачи;
			СтнОтпр = Эл.СтанцияОтправления;
			//СтнПриб = Эл.СтанцияНазначения;
			Если Эл.Свойство("ДатаНакладной") И ЗначениеЗаполнено(Эл.ДатаНакладной) Тогда
				ДтОтпр = Эл.ДатаНакладной;
			Иначе
				ДтОтпр = Эл.ДатаОтправления;
			КонецЕсли; 
		Иначе
			//СтнОтпр = Эл.РегионОтправления;
			//СтнОтпр = Эл.СтанцияПодачи;
			СтнОтпр = Эл.СтанцияОтправления;
			//СтнПриб = Эл.РегионВозврата;
			ДтОтпр = Эл.ДатаПередачиВПользование;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НовСТр,Эл);
		
		НовСТр.ДатаОтправления = ДтОтпр;
		НовСТр.СтанцияОтправления = СтнОтпр;
		НовСТр.СтанцияНазначения = Эл.СтанцияНазначения;
		//НовСТр.СтанцияНазначения = Эл.Калькуляция.Суша_ПунктНазначения;
		//НовСтр.СтанцияНазначения = Неопределено;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВремТЧ.ДатаОтправления КАК ДатаОтправления,
		|	ВремТЧ.ДатаПрибытия КАК ДатаПрибытия,
		|	ВремТЧ.ДатаПомещенияВРежимПовагонки КАК ДатаПомещенияВРежимПовагонки,
		|	ВремТЧ.СтанцияОтправления КАК СтанцияОтправления,
		|	ВремТЧ.СтанцияНазначения КАК СтанцияНазначения,
		|	ВремТЧ.Клиент КАК Клиент,
		|	ВремТЧ.Договор КАК Договор,
		|	ВремТЧ.НомерВагона КАК НомерВагона,
		|	ВремТЧ.Груженый КАК Груженый,
		|	ВремТЧ.ПСЦ КАК ПСЦ,
		|	ВремТЧ.Груз КАК Груз,
		|	ВремТЧ.МодельВагона КАК ТипВагона,
		|	ВремТЧ.Калькуляция КАК Калькуляция,
		|	ВремТЧ.Заявка КАК Заявка
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ВремТЧ КАК ВремТЧ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.ДатаОтправления КАК ДатаОтправления,
		|	ВТ.ДатаПрибытия КАК ДатаПрибытия,
		|	ВТ.ДатаПомещенияВРежимПовагонки КАК ДатаПомещенияВРежимПовагонки,
		|	ВТ.СтанцияОтправления КАК СтанцияОтправления,
		|	ВТ.СтанцияНазначения КАК СтанцияНазначения,
		|	ВТ.Клиент КАК Клиент,
		|	ВТ.Договор КАК Договор,
		|	ВТ.НомерВагона КАК НомерВагона,
		|	ВТ.ПСЦ КАК ПСЦ,
		|	ВТ.Груженый КАК Груженый,
		|	ВТ.Груз КАК Груз,
		|	ВТ.ТипВагона КАК ТипВагона,
		|	ВТ.Калькуляция КАК Калькуляция,
		|	ВТ.Заявка КАК Заявка,
		|	ЗаявкаСоставУслуги.ГУИДСтроки КАК ГУИДСтроки
		|ИЗ
		|	ВТ КАК ВТ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
		|		ПО ВТ.Заявка = ЗаявкаСоставУслуги.Ссылка
		|			И ВТ.НомерВагона = ЗаявкаСоставУслуги.Вагон
		|ИТОГИ ПО
		|	ДатаОтправления,
		|	СтанцияОтправления,
		|	СтанцияНазначения,
		|	Клиент,
		|	Договор";
	
	Запрос.УстановитьПараметр("ВремТЧ",ТЗ_Заявок);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДатаОтправления = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	МассивЗаявок = Новый Массив;
	
	Пока ВыборкаДатаОтправления.Следующий() Цикл
		ВыборкаСтанцияОтправления = ВыборкаДатаОтправления.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаСтанцияОтправления.Следующий() Цикл
			ВыборкаСтанцияНазначения = ВыборкаСтанцияОтправления.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаСтанцияНазначения.Следующий() Цикл
				ВыборкаКлиент = ВыборкаСтанцияНазначения.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаКлиент.Следующий() Цикл
					ВыборкаДоговор = ВыборкаКлиент.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					Пока ВыборкаДоговор.Следующий() Цикл
						
						// заявку создаем учитывая все группировки
						Если Фактическая 
							И ЗначениеЗаполнено(ВыборкаДоговор.СтанцияНазначения) Тогда
						
							//////// создать ПРОДУКТ, проверив перед этим, возможно, он уже создан//////////
							//ДИТ Шевченко А.В. US 62360 ТА 72965 26.07.2023
							//ТекПродукт = Справочники.Продукты.ПустаяСсылка();
							ТекПродукт = Справочники.СервисыУчетноеНаправление.ПустаяСсылка();
							//ДИТ Шевченко А.В. US 62360 ТА 72965 26.07.2023
							ЗапросП = Новый Запрос;
							ЗапросП.Текст = "ВЫБРАТЬ 
							                |	Продукты.Ссылка КАК Ссылка
							                |ИЗ
											//ДИТ Шевченко А.В. US 62360 ТА 72965 26.07.2023
											//|	Справочник.Продукты КАК Продукты
											|	Справочник.СервисыУчетноеНаправление КАК Продукты
											//ДИТ Шевченко А.В. US 62360 ТА 72965 26.07.2023
							                |ГДЕ
							                |	НЕ Продукты.ПометкаУдаления
							                |	И Продукты.НачалоМаршрута = &НачалоМаршрута
							                |	И Продукты.ОкончаниеМаршрута = &ОкончаниеМаршрута";
							ЗапросП.УстановитьПараметр("НачалоМаршрута",ВыборкаДоговор.СтанцияОтправления);
							ЗапросП.УстановитьПараметр("ОкончаниеМаршрута",ВыборкаДоговор.СтанцияНазначения);
							РезультатЗапросаП = ЗапросП.Выполнить();
							Если РезультатЗапросаП.Пустой() Тогда
								// создать продукт
								УстановитьПривилегированныйРежим(Истина);
								//ДИТ Шевченко А.В. US 62360 ТА 72965 26.07.2023
								//ТекПродукт = Справочники.Продукты.СоздатьЭлемент();
								ТекПродукт = Справочники.СервисыУчетноеНаправление.СоздатьЭлемент();
								//ДИТ Шевченко А.В. US 62360 ТА 72965 26.07.2023
								ТекПродукт.Наименование = Строка(ВыборкаДоговор.СтанцияОтправления) + " - " + Строка(ВыборкаДоговор.СтанцияНазначения);
								ТекПродукт.ВключаетРасходыПоПодсылуВагонов = Истина;
								ТекПродукт.НачалоМаршрута = ВыборкаДоговор.СтанцияОтправления;
								ТекПродукт.ОкончаниеМаршрута = ВыборкаДоговор.СтанцияНазначения;
								Если СтнОтпр.Страна = Справочники.СтраныМира.Россия И ВыборкаДоговор.СтанцияНазначения.Страна = Справочники.СтраныМира.Россия Тогда 
									//ДИТ Шевченко А.В. US 62360 ТА 72965 26.07.2023
									//ТекПродукт.Родитель = Справочники.Продукты.НайтиПоНаименованию("РФ - РФ");
									ТекПродукт.Родитель = Справочники.СервисыУчетноеНаправление.НайтиПоНаименованию("РФ - РФ");
									//ДИТ Шевченко А.В. US 62360 ТА 72965 26.07.2023
								Иначе
									//ДИТ Шевченко А.В. US 62360 ТА 72965 26.07.2023
									//ТекПродукт.Родитель = Справочники.Продукты.НайтиПоНаименованию("Продукты");
									ТекПродукт.Родитель = Справочники.СервисыУчетноеНаправление.НайтиПоНаименованию("Продукты");
									//ДИТ Шевченко А.В. US 62360 ТА 72965 26.07.2023
								КонецЕсли;
								ТекПродукт.Записать();
								УстановитьПривилегированныйРежим(Ложь);
							Иначе
								ТекПродукт = РезультатЗапросаП.Выгрузить().ВыгрузитьКолонку("Ссылка")[0];
							КонецЕсли;
						КонецЕсли;
						
						Заявка = Неопределено;
						ВыборкаДетальныеЗаписи = ВыборкаДоговор.Выбрать();						
						Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
							Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Заявка) Тогда
								Заявка = ВыборкаДетальныеЗаписи.Заявка;
							КонецЕсли;
						КонецЦикла;
						
						// создаем заявку
						Если ЗначениеЗаполнено(Заявка) Тогда
							НоваяЗаявка = Заявка.ПолучитьОбъект();
						Иначе
							НоваяЗаявка = Документы.Заявка.СоздатьДокумент();
							НоваяЗаявка.Заполнить(Неопределено);
							НоваяЗаявка.Дата = ТекущаяДата();
							НоваяЗаявка.Автор = Пользователи.ТекущийПользователь();
							НоваяЗаявка.Контрагент = ВыборкаДоговор.Клиент;
							НоваяЗаявка.Договор = ВыборкаДоговор.Договор;
							НоваяЗаявка.ЦФО = НоваяЗаявка.Автор.ЦФО;
							НоваяЗаявка.Создано = ТекущаяДата();
							НоваяЗаявка.Организация = Константы.ОсновнаяОрганизация.Получить();
							НоваяЗаявка.Маршрутизировать = Константы.МаршрутизироватьЗаявку.Получить();
							НоваяЗаявка.Отправка = ВыборкаДоговор.ДатаОтправления;							
							НоваяЗаявка.ИсточникЗаявки = Перечисления.ИсточникЗаявок.Повагонка; 
						КонецЕсли;
						

						ГУИДЗаявки = Строка(Новый УникальныйИдентификатор);
						
						ВыборкаДетальныеЗаписи = ВыборкаДоговор.Выбрать();
						ЗаявкаИзменена = Ложь;
						Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
							
							Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ГУИДСтроки) Тогда
								Продолжить;
							КонецЕсли;
							
							ЗаявкаИзменена = Истина;
							НоваяЗаявка.ПСЦ = ВыборкаДетальныеЗаписи.ПСЦ;
							
							ТЧ_Услуги = НоваяЗаявка.СоставУслуги;
							НовСтр = ТЧ_Услуги.Добавить();
							НовСтр.Услуга = Константы.УслугаДляПовагоннойЗаявки.Получить();
							НовСтр.СтанцияОтправления = ВыборкаДетальныеЗаписи.СтанцияОтправления;
							НовСтр.СтанцияНазначения = ВыборкаДетальныеЗаписи.СтанцияНазначения;
							НовСтр.ПунктОтправления = ВыборкаДетальныеЗаписи.СтанцияОтправления;
							НовСтр.ПунктНазначения = ВыборкаДетальныеЗаписи.СтанцияНазначения;
							НовСтр.Вагон = ВыборкаДетальныеЗаписи.НомерВагона;
							НовСтр.ПСЦ = ВыборкаДетальныеЗаписи.ПСЦ;
							НовСтр.ТипВагона = ВыборкаДетальныеЗаписи.НомерВагона.ТипТС;
							НовСтр.ГУИДСтроки = Новый УникальныйИдентификатор();
							
							// вносим в ТЗ данные по ГУИДу заявки
							ПарамОтб = Новый Структура;
							ПарамОтб.Вставить("НомерВагона",ВыборкаДетальныеЗаписи.НомерВагона);
							ПарамОтб.Вставить("ДатаПомещенияВРежимПовагонки",ВыборкаДетальныеЗаписи.ДатаПомещенияВРежимПовагонки);
							НайдСтр = ТЗ_Заявок.НайтиСтроки(ПарамОтб);
							Если НайдСтр.Количество()>0 Тогда
								НайдСтр[0].ГУИДЗаявки = ГУИДЗаявки;
							КонецЕсли;
							
							// рейс и признак груженого заполняем только для фактической
							Если Фактическая 
								И ЗначениеЗаполнено(ВыборкаДоговор.СтанцияНазначения) Тогда
								// рейс ищем или создаем здесь, т.к. нужно получить признак груженого или порожнего
								// проверка, есть ли уже такой рейс. 
								ТекРейс = Справочники.РейсыЖД.ПустаяСсылка();
								ЗапросР = Новый Запрос;
								ЗапросР.Текст = "ВЫБРАТЬ
								                |	РейсыЖД.Ссылка КАК Ссылка
								                |ИЗ
								                |	Справочник.РейсыЖД КАК РейсыЖД
								                |ГДЕ
								                |	НЕ РейсыЖД.КП
								                |	И НЕ РейсыЖД.ПометкаУдаления
								                |	И РейсыЖД.ПовагоннаяОтправка
								                |	И РейсыЖД.ПунктОтправления = &ПунктОтправления
								                |	И РейсыЖД.ПунктНазначения = &ПунктНазначения
								                |	И ВЫБОР
								                |			КОГДА &ДатаЕсть = ИСТИНА
								                |				ТОГДА НАЧАЛОПЕРИОДА(РейсыЖД.ДатаПрибытия, ДЕНЬ) = &ДатаПрибытия
								                |			ИНАЧЕ ИСТИНА
								                |		КОНЕЦ
								                |	И НАЧАЛОПЕРИОДА(РейсыЖД.ДатаОтправления, ДЕНЬ) = &ДатаОтправления";
								ЗапросР.УстановитьПараметр("ПунктОтправления",ВыборкаДоговор.СтанцияОтправления);
								ЗапросР.УстановитьПараметр("ПунктНазначения",ВыборкаДоговор.СтанцияНазначения);
								ЗапросР.УстановитьПараметр("ДатаОтправления",НачалоДня(ВыборкаДоговор.ДатаОтправления));
								// получаем дату прибытия по табельному расписанию
								ДанныеТабельногоРасписания = Отправки_сервер.ПолучитьТабельноеРасписаниеПоПараметрам(ВыборкаДоговор.СтанцияОтправления, ВыборкаДоговор.СтанцияНазначения);
								// ДобавитьКОкончанию - часы
								КолвоДн = ДанныеТабельногоРасписания.ДобавитьКОкончанию;
								Если ЗначениеЗаполнено(КолвоДн) Тогда
									ДатаПриб = ВыборкаДоговор.ДатаОтправления + КолвоДн*24;
								КонецЕсли;
								// если по табельному расписанию не получили ничего, то запрос к рейл тарифу
								Если Не ЗначениеЗаполнено(ДатаПриб) Тогда
									//КолвоДн = ПолучитьДанныеРейлТариф(ВыборкаДоговор.СтанцияОтправления,ВыборкаДоговор.СтанцияНазначения,ВыборкаДетальныеЗаписи.Груженый,ВыборкаДетальныеЗаписи.Груз,ВыборкаДетальныеЗаписи.НомерВагона.ТипТС,Перечисления.ПринадлежностьПС.Собственный);
									КолвоДн = ПолучитьДанныеРейлТариф(ВыборкаДоговор.СтанцияОтправления,ВыборкаДоговор.СтанцияНазначения,Ложь,Неопределено,ВыборкаДетальныеЗаписи.НомерВагона.ТипТС,Перечисления.ПринадлежностьПС.Собственный);
									ДатаПриб = ВыборкаДоговор.ДатаОтправления + КолвоДн*3600*24;
								КонецЕсли;
								Если ЗначениеЗаполнено(ДатаПриб) Тогда
									ЗапросР.УстановитьПараметр("ДатаЕсть",Истина);
									ЗапросР.УстановитьПараметр("ДатаПрибытия",НачалоДня(ДатаПриб));
								Иначе
									ЗапросР.УстановитьПараметр("ДатаЕсть",Ложь);
									ЗапросР.УстановитьПараметр("ДатаПрибытия",1);
								КонецЕсли;
								
								РезультатЗапросаР = ЗапросР.Выполнить();
								Если РезультатЗапросаР.Пустой() Тогда
									//////////////// создать РЕЙС ////////////////////////////
									ТекРейс = Справочники.РейсыЖД.СоздатьЭлемент();
									ТекРейс.Наименование = Строка(ВыборкаДоговор.СтанцияОтправления) + " - " + Строка(ВыборкаДоговор.СтанцияНазначения);
									ТекРейс.ПунктОтправления = ВыборкаДоговор.СтанцияОтправления;
									ТекРейс.ПунктНазначения = ВыборкаДоговор.СтанцияНазначения;
									ТекРейс.ДатаОтправления = ВыборкаДоговор.ДатаОтправления;
									ТекРейс.ДатаПрибытия = ДатаПриб;
									ТекРейс.Продукт = ТекПродукт.Ссылка;
									ТекРейс.Сервис = ТекПродукт.Ссылка;
									ТекРейс.ПовагоннаяОтправка = Истина;
									ТекРейс.ТехРейс = Истина;
									ТекРейс.Записать();
									//////////////////////////////////////////////////////////
								Иначе
									ТекРейс = РезультатЗапросаР.Выгрузить().ВыгрузитьКолонку("Ссылка")[0];
								КонецЕсли;
								
								НайденнаяСтрокаСРейсом = НоваяЗаявка.ПереченьРейсов.Найти(ТекРейс.Ссылка);
								Если НайденнаяСтрокаСРейсом = Неопределено Тогда
									НовСтр_Рейсы = НоваяЗаявка.ПереченьРейсов.Добавить();
									НовСтр_Рейсы.Продукт = ТекПродукт.Ссылка;
									НовСтр_Рейсы.Рейс = ТекРейс.Ссылка;
								КонецЕсли;
							
								///// Заполнить РС ВАГОНЫВОТПРАВКЕ. Связать вагоны и рейс ////////
								МЗ = РегистрыСведений.ВагоныВОтправке.СоздатьМенеджерЗаписи();
								МЗ.Вагон = ВыборкаДетальныеЗаписи.НомерВагона;
								МЗ.Отправка = ТекРейс.Ссылка;
								МЗ.Период = ТекущаяДата();
								МЗ.Записать(Истина);
								// ДИТ US 62421 TA 64346 Евсенкин М.А. Начало: 13.02.2023
								// Было:
								//НовСтр.Груз = ВыборкаДетальныеЗаписи.Груз; 
								//Стало:
								СтруктураКлючаАналитикиПеревозки = Справочники.КлючиАналитикиПеревозки.СтруктураКлючаАналитикиПеревозки();
								СтруктураКлючаАналитикиПеревозки.Контейнер = НовСтр.НомерКТК;
								СтруктураКлючаАналитикиПеревозки.Груз = ВыборкаДетальныеЗаписи.Груз;
								Если ЗначениеЗаполнено(НоваяЗаявка.Ссылка) Тогда 
									СтруктураКлючаАналитикиПеревозки.КлючАналитики = НовСтр.КлючАналитикиПеревозки;	
								КонецЕсли;	
								КлючАналитики = Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлючаАналитикиПеревозки);
								НовСтр.КлючАналитикиПеревозки = КлючАналитики;
								// ДИТ US 62421 TA 64346 Евсенкин М.А. Конец: 13.02.2023
								НовСтр.КодГруза = ВыборкаДетальныеЗаписи.Груз.ЕТСНГ;
								НовСтр.Груженый = ВыборкаДетальныеЗаписи.Груженый;
								НоваяЗаявка.Прибытие = ДатаПриб;
							КонецЕсли;
							
							Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Калькуляция) Тогда
								ДанныеПоКалькуляции = ПолучитьКалькуляцию(НоваяЗаявка.Контрагент, НоваяЗаявка.Договор, ВыборкаДетальныеЗаписи.СтанцияОтправления, ВыборкаДетальныеЗаписи.СтанцияНазначения);
								НовСтр.Калькуляция = ДанныеПоКалькуляции.Калькуляция;
								НоваяЗаявка.ПСЦ = ?(НЕ ЗначениеЗаполнено(НоваяЗаявка.ПСЦ),ДанныеПоКалькуляции.Протокол,НоваяЗаявка.ПСЦ);
								НоваяЗаявка.ВидПеревозки = ?(НЕ ЗначениеЗаполнено(НоваяЗаявка.ВидПеревозки),ДанныеПоКалькуляции.ВидПеревозки,НоваяЗаявка.ВидПеревозки);
							Иначе
								НовСтр.Калькуляция = ВыборкаДетальныеЗаписи.Калькуляция;
								НоваяЗаявка.ПСЦ = ?(НЕ ЗначениеЗаполнено(НоваяЗаявка.ПСЦ),ПолучитьПСЦПоКалькуляции(ВыборкаДетальныеЗаписи.Калькуляция),НоваяЗаявка.ПСЦ);
								НоваяЗаявка.ВидПеревозки = ?(НЕ ЗначениеЗаполнено(НоваяЗаявка.ВидПеревозки),ВыборкаДетальныеЗаписи.Калькуляция.ПС_ВидПеревозки,НоваяЗаявка.ВидПеревозки);
							КонецЕсли;
							
						КонецЦикла;
						
						Если Не ЗаявкаИзменена Тогда
							Продолжить;
						КонецЕсли;
						
						Попытка
							НоваяЗаявка.Записать(РежимЗаписиДокумента.Проведение);
						Исключение
							НоваяЗаявка.Записать(РежимЗаписиДокумента.Запись);
						КонецПопытки;
						
						// по ГУИДу заявки находим нужный вагон и формируем массив
						ПараметрыОтбора = Новый СТруктура;
						ПараметрыОтбора.Вставить("ГУИДЗаявки",ГУИДЗаявки);
						НайденныеСтроки = ТЗ_Заявок.НайтиСтроки(ПараметрыОтбора);
						Для Каждого ЭлСтр Из НайденныеСтроки Цикл
							СтруктураЗаписи = Новый Структура;
							СтруктураЗаписи.Вставить("НомерВагона",ЭлСтр.НомерВагона);
							СтруктураЗаписи.Вставить("ДатаПомещенияВРежимПовагонки",ЭлСтр.ДатаПомещенияВРежимПовагонки);
							СтруктураЗаписи.Вставить("Заявка",НоваяЗаявка.Ссылка);
							
							МассивЗаявок.Добавить(СтруктураЗаписи);
							
							// записать данные в регистры
							Если Фактическая Тогда
								Запрос = Новый Запрос;
								Запрос.Текст = "ВЫБРАТЬ
								               |	ПовагонныеОтправкиСрезПоследних.Период КАК Период,
								               |	ПовагонныеОтправкиСрезПоследних.Вагон КАК Вагон,
								               |	ПовагонныеОтправкиСрезПоследних.Заявка КАК Заявка
								               |ИЗ
								               |	РегистрСведений.ПовагонныеОтправки.СрезПоследних(
								               |			,
								               |			Вагон = &Вагон
								               |				И Период = &Период) КАК ПовагонныеОтправкиСрезПоследних";
								
								Запрос.УстановитьПараметр("Вагон", ЭлСтр.НомерВагона);
								Запрос.УстановитьПараметр("Период", ЭлСтр.ДатаПомещенияВРежимПовагонки);
								ИмяРегистра = "ПовагонныеОтправки";
							Иначе
								Запрос = Новый Запрос;
								Запрос.Текст = "ВЫБРАТЬ
								               |	ВагоныЗапланированныеКПовагонке.Вагон КАК Вагон,
								               |	ВагоныЗапланированныеКПовагонке.Заявка КАК Заявка
								               |ИЗ
								               |	РегистрСведений.ВагоныЗапланированныеКПовагонке КАК ВагоныЗапланированныеКПовагонке
								               |ГДЕ
								               |	ВагоныЗапланированныеКПовагонке.Вагон = &Вагон";
								
								Запрос.УстановитьПараметр("Вагон", ЭлСтр.НомерВагона);
								ИмяРегистра = "ВагоныЗапланированныеКПовагонке";
							КонецЕсли;
							
							РЗ = Запрос.Выполнить();
							Если НЕ РЗ.Пустой() Тогда
								Ответ = РЗ.Выбрать();

								Если Ответ.Следующий() Тогда
									ТекЗапись = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
									ЗаполнитьЗначенияСвойств(ТекЗапись,Ответ);
									ТекЗапись2 = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
									ЗаполнитьЗначенияСвойств(ТекЗапись2, ТекЗапись);
									
									ТекЗапись.Прочитать();
									Если НЕ ТекЗапись.Выбран() Тогда
										ЗаполнитьЗначенияСвойств(ТекЗапись, ТекЗапись2);
									КонецЕсли;
									ТекЗапись.Заявка = НоваяЗаявка.Ссылка;
									
									ТекЗапись.Записать();
								КонецЕсли;
							КонецЕсли;
						КонецЦикла;
						
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	
	Возврат МассивЗаявок;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеРейлТариф(СтанцияОтправления,СтанцияНазначения,Груженый,Груз,ТипВагона,ПринадлежностьВагона)
	
	ДлительностьДней = 0;
	
	ПараметрыКалькуляции = РейлТариф_сервер.ПолучитьСтруктуруПараметровКалькуляции();

	ПараметрыКалькуляции.Порожний = НЕ Груженый;
	Если ПараметрыКалькуляции.Порожний Тогда
		ПараметрыКалькуляции.ПараметрыОтправки.КодКатегории = 1000;
		ПараметрыКалькуляции.ПараметрыОтправки.КодДетализации = 100;//Порожние вагоны под погрузку/из-под выгрузки
	Иначе
		ПараметрыКалькуляции.ПараметрыОтправки.КодКатегории = 3000;
		ПараметрыКалькуляции.ПараметрыОтправки.КодДетализации = 6;//Одиночные контейнеры (а также спец. контейнеры мелкой отправкой
		//Параметры груза
		ПараметрыКалькуляции.ПараметрыГруза.КодЕТСНГ = ПолучитьРеквизитСсылкиНаСервере(Груз,"ЕТСНГ").ЕТСНГ;
		ПараметрыКалькуляции.ПараметрыГруза.Вес = 10;
		//Выбор груза
	КонецЕсли; 
	ПараметрыКалькуляции.КодСтанцииОтправления = ПолучитьРеквизитСсылкиНаСервере(СтанцияОтправления,"КодЖДСтанции").КодЖДСтанции;
	ПараметрыКалькуляции.КодСтанцииНазначения = ПолучитьРеквизитСсылкиНаСервере(СтанцияНазначения,"КодЖДСтанции").КодЖДСтанции;
	ПараметрыКалькуляции.ПараметрыОтправки.ПризнакМаршрутнойОтправки = 0;
	ПараметрыКалькуляции.ПараметрыОтправки.КодСкорости = 2;
	//Параметры контейнера
	ПараметрыКалькуляции.ПараметрыКонтейнера.КодВагона = ПолучитьРеквизитСсылкиНаСервере(ТипВагона, "КодПоКлассификаторуРейлТариф").КодПоКлассификаторуРейлТариф;
	ПараметрыКалькуляции.ПараметрыКонтейнера.ПринадлежностьВагона = ПолучитьПринадлежностьRTСервер(ПринадлежностьВагона);
	ПараметрыКалькуляции.ПараметрыКонтейнера.КоличествоВагонов = 1;
	//параметры платформы
	ПараметрыКалькуляции.ПараметрыТранспортДляКонтейнера.КодВагона = 2;
	ПараметрыКалькуляции.ПараметрыТранспортДляКонтейнера.ПринадлежностьВагона = 2;
	ПараметрыКалькуляции.ПараметрыТранспортДляКонтейнера.КоличествоВагонов = 1;
	
	ПараметрыКалькуляции.ПараметрыПорожнегоВагона.КодВагона = ПолучитьРеквизитСсылкиНаСервере(ТипВагона, "КодПоКлассификаторуРейлТариф").КодПоКлассификаторуРейлТариф;
	ПараметрыКалькуляции.ПараметрыПорожнегоВагона.ПринадлежностьВагона = ПолучитьПринадлежностьRTСервер(ПринадлежностьВагона);
	ПараметрыКалькуляции.ПараметрыПорожнегоВагона.КоличествоВагонов = 1;

	ДанныеКалькуляции = РейлТариф_сервер.ПолучитьКалькуляцию(ПараметрыКалькуляции);
	Если ДанныеКалькуляции.Ошибка Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ДанныеКалькуляции.ОписаниеОшибки);
		Возврат ДлительностьДней;
	КонецЕсли; 

	Для каждого СтрокаДанныхКалькуляции Из ДанныеКалькуляции.РезультатТаблица Цикл
		ДлительностьДней = ДлительностьДней + СтрокаДанныхКалькуляции.ДлительностьДней;
	КонецЦикла;
	
	Возврат ДлительностьДней;
		
КонецФункции

