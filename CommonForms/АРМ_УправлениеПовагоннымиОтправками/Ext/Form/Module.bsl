Процедура ДозаполнитьЗаявку(Команда)
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Пометка",Истина);
	НайденныеСтроки = ВагоныВПовагонке.НайтиСтроки(ПараметрыОтбора);
	МассивСтруктур = Новый Массив;
	
	Для Каждого Стр Из НайденныеСтроки Цикл
		СтруктураСтроки = Новый Структура;
		СтруктураСтроки.Вставить("НомерВагона",Стр.НомерВагона);
		СтруктураСтроки.Вставить("ДатаОтправления",Стр.ДатаОтправления);
		СтруктураСтроки.Вставить("Заявка",Стр.Заявка);
		СтруктураСтроки.Вставить("СтанцияОтправления",Стр.СтанцияОтправления);
		СтруктураСтроки.Вставить("СтанцияНазначения",Стр.СтанцияНазначения);
		СтруктураСтроки.Вставить("Груженый",Стр.Груженый);
		СтруктураСтроки.Вставить("Груз",Стр.Груз);
		СтруктураСтроки.Вставить("Калькуляция",Стр.Калькуляция);

		МассивСтруктур.Добавить(СтруктураСтроки);
	КонецЦикла;
	
	Если МассивСтруктур.Количество() = 0 Тогда
		Сообщить("Не выбрано ни одной строки для дозаполнения заявки");
		Возврат;
	КонецЕсли;
	
	МассивИзмененных = ДозаполнитьЗаявкуНасервере(МассивСтруктур);
	
	Для Каждого Стр Из НайденныеСтроки Цикл
		Если НЕ МассивИзмененных.Найти(Стр.Заявка) = Неопределено ТОгда
			Стр.ЗаявкаНеПодходит = Ложь;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

