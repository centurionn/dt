Процедура СнятьВсеОтметки(Команда)
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "ГруппаВагоныВПовагонке" Тогда
		ИмяТч = "ВагоныВПовагонке";
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "ГруппаВыведеныИзПовагонки" Тогда
		ИмяТЧ = "ВагоныВыведены";
	Иначе
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТЗ Из ЭтаФорма[ИмяТч] Цикл
		СтрокаТЗ.Пометка = Ложь;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВыбранныеСтроки(Команда)
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "ГруппаВагоныВПовагонке" Тогда
		ИмяТч = "ВагоныВПовагонке";
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "ГруппаВыведеныИзПовагонки" Тогда
		ИмяТЧ = "ВагоныВыведены";
	Иначе
		Возврат;
	КонецЕсли;
	
	Для каждого Стр из Элементы[ИмяТч].ВыделенныеСтроки Цикл
		ЭтаФорма[ИмяТч].НайтиПоИдентификатору(Стр).Пометка = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнятьПоПервойСтроке(Команда)
	
	ЗаполнятьПоПервойСтроке = Не ЗаполнятьПоПервойСтроке;
	Элементы.ВагоныВПовагонкеЗаполнятьПоПервойСтроке.Пометка = ЗаполнятьПоПервойСтроке;
	Элементы.ВагоныВыведеныЗаполнятьПоПервойСтроке.Пометка = ЗаполнятьПоПервойСтроке;
	
КонецПроцедуры

&НаКлиенте
Процедура ВагоныВПовагонкеПриИзменении(Элемент)
	
	Если ЗаполнятьПоПервойСтроке Тогда
		
		ИмяТЧ = Элемент.Имя;
		ИмяПоля = Сред(Элемент.ТекущийЭлемент.Имя, СтрДлина(ИмяТЧ)+1);
		
		//Если СтрНайти("СтанцияПодачи, ПСЦ, Калькуляция", ИмяПоля) > 0 Тогда
		//Костюков(
		Если СтрНайти("СтанцияПодачи, ПСЦ, Калькуляция, СтанцияОтправления, СтанцияНазначения, Заявка, НДС", ИмяПоля) > 0 Тогда			
		//Костюков)	
			
			//Строка должна быть первая среди строк с пометкой
			СтрокиСПометкой = ВагоныВПовагонке.НайтиСтроки(Новый Структура("Пометка", Истина));
			Если СтрокиСПометкой.Количество() > 1 Тогда
				
				ТекДанные = Элементы.ВагоныВПовагонке.ТекущиеДанные;
				ПерваяСтрока = СтрокиСПометкой[0];
				
				СтруктураДанныхСтроки = Новый Структура;
				Для Каждого ЭлемСп Из СписокКолонокВагоныВПовагонке Цикл
					СтруктураДанныхСтроки.Вставить(ЭлемСп.Значение);
				КонецЦикла;
						
				Если ТекДанные = ПерваяСтрока Тогда
					НовоеЗначение = ПерваяСтрока[ИмяПоля];
					Для Каждого СтрокаСПометкой Из СтрокиСПометкой Цикл
						Если СтрокаСПометкой = ПерваяСтрока Тогда
							Продолжить;
						КонецЕсли;
						СтрокаСПометкой[ИмяПоля] = НовоеЗначение;
						
						ЗаполнитьЗначенияСвойств(СтруктураДанныхСтроки, СтрокаСПометкой);
						
						ЗаявкаИзменилась = Ложь;
						СохранитьДанныеВРСПовагонки(СтруктураДанныхСтроки,Ложь,ЗаявкаИзменилась,Ложь,Неопределено);
						
						ЗаполнитьЗначенияСвойств(СтрокаСПометкой, СтруктураДанныхСтроки);
	
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВСделку(Команда)
	
	ОповещениеОВыбореСделки = Новый ОписаниеОповещения("ОбработкаВыбораСделки", ЭтаФорма);
	ЗначениеОтбора = Новый Структура("ПовагонныеОтправки", Истина);
	ПараметрыОткрытия = Новый Структура("Отбор", ЗначениеОтбора);
	ОткрытьФорму("Документ.Сделка.ФормаВыбора", ПараметрыОткрытия, ЭтаФорма,,,, ОповещениеОВыбореСделки, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораСделки(Сделка, ДополнительныеПараметры) Экспорт
	
	Если Сделка <> Неопределено Тогда
		СоздатьСделкиПоВагонам(, Сделка);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицуВагоновИзРеестровВСКНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РейсыЖД.Ссылка КАК Рейс,
	|	СделкаРейсы.Ссылка КАК Сделка,
	|	РейсыЖД.ПунктОтправления КАК ПунктОтправления,
	|	РейсыЖД.ПунктНазначения КАК ПунктНазначения,
	|	РейсыЖД.ДатаОтправления КАК ДатаОтправления
	|ПОМЕСТИТЬ РейсыСделки
	|ИЗ
	|	Справочник.РейсыЖД КАК РейсыЖД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.Рейсы КАК СделкаРейсы
	|		ПО РейсыЖД.Ссылка = СделкаРейсы.Рейс
	|ГДЕ
	|	РейсыЖД.ДатаОтправления МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И НЕ РейсыЖД.ПометкаУдаления
	|	И СделкаРейсы.Ссылка.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РейсыСделки.Рейс КАК Рейс,
	|	РейсыСделки.Сделка КАК Сделка,
	|	СделкаСвязьУчетныхЕдиниц.Контейнер КАК Контейнер,
	|	СделкаСвязьУчетныхЕдиниц.ЖДН КАК Накладная,
	|	СделкаСвязьУчетныхЕдиниц.Вагон КАК Вагон,
	|	СделкаСвязьУчетныхЕдиниц.Калькуляция КАК Калькуляция,
	|	СделкаСвязьУчетныхЕдиниц.Протокол КАК Протокол,
	|	СделкаСвязьУчетныхЕдиниц.Заявка КАК Заявка,
	|	СделкаДоходы.ГУИД КАК ИдентификаторСтрокиДоходовСделки,
	|	РейсыСделки.ПунктОтправления КАК ПунктОтправления,
	|	РейсыСделки.ПунктНазначения КАК ПунктНазначения,
	|	РейсыСделки.ДатаОтправления КАК ДатаОтправления
	|ПОМЕСТИТЬ СтрокиСделок
	|ИЗ
	|	РейсыСделки КАК РейсыСделки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьДоходовИРасходов КАК СделкаСвязьДоходовИРасходов
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.Доходы КАК СделкаДоходы
	|				ПО СделкаСвязьДоходовИРасходов.Ссылка = СделкаДоходы.Ссылка
	|					И СделкаСвязьДоходовИРасходов.Доходы = СделкаДоходы.ГУИД
	|			ПО СделкаСвязьУчетныхЕдиниц.Ссылка = СделкаСвязьДоходовИРасходов.Ссылка
	|				И СделкаСвязьУчетныхЕдиниц.ГУИД = СделкаСвязьДоходовИРасходов.СвязьУчетныхЕдиниц
	|		ПО РейсыСделки.Сделка = СделкаСвязьУчетныхЕдиниц.Ссылка
	|ГДЕ
	|	СделкаСвязьУчетныхЕдиниц.Клиент = &Клиент
	|	И СделкаСвязьУчетныхЕдиниц.Договор = &Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДислокацияВагонов.Вагон КАК Вагон,
	|	ДислокацияВагонов.СтанцияОтправления КАК СтанцияОтправления,
	|	ДислокацияВагонов.СтанцияНазначения КАК СтанцияНазначения,
	|	ДислокацияВагонов.СтанцияОперации КАК СтанцияОперации
	|ПОМЕСТИТЬ ДислокацияВагонов
	|ИЗ
	|	(ВЫБРАТЬ
	|		МАКСИМУМ(ДислокацияВагонов.Период) КАК Период,
	|		ДислокацияВагонов.Вагон КАК Вагон
	|	ИЗ
	|		РегистрСведений.ДислокацияВагонов КАК ДислокацияВагонов
	|	ГДЕ
	|		ДислокацияВагонов.Вагон В
	|				(ВЫБРАТЬ
	|					СтрокиСделок.Вагон КАК Вагон
	|				ИЗ
	|					СтрокиСделок КАК СтрокиСделок)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ДислокацияВагонов.Вагон) КАК ВложенныйЗапрос
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДислокацияВагонов КАК ДислокацияВагонов
	|		ПО ВложенныйЗапрос.Вагон = ДислокацияВагонов.Вагон
	|			И ВложенныйЗапрос.Период = ДислокацияВагонов.Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтрокиСделок.Рейс КАК Рейс,
	|	СтрокиСделок.Сделка КАК Сделка,
	|	СтрокиСделок.Контейнер КАК Контейнер,
	|	СтрокиСделок.Накладная КАК Накладная,
	|	СтрокиСделок.Вагон КАК Вагон,
	|	СтрокиСделок.Калькуляция КАК Калькуляция,
	|	СтрокиСделок.Протокол КАК Протокол,
	|	СтрокиСделок.Заявка КАК Заявка,
	|	СтрокиСделок.ИдентификаторСтрокиДоходовСделки КАК ИдентификаторСтрокиДоходовСделки,
	|	СтрокиСделок.ПунктОтправления КАК ПунктОтправления,
	|	СтрокиСделок.ПунктНазначения КАК ПунктНазначения,
	|	СтрокиСделок.ДатаОтправления КАК ДатаОтправления,
	|	ДислокацияВагонов.СтанцияОтправления КАК ТекДислСтанцияОтправления,
	|	ДислокацияВагонов.СтанцияНазначения КАК ТекДислСтанцияНазначения,
	|	ДислокацияВагонов.СтанцияОперации КАК ТекДислСтанцияОперации
	|ИЗ
	|	СтрокиСделок КАК СтрокиСделок
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДислокацияВагонов КАК ДислокацияВагонов
	|		ПО СтрокиСделок.Вагон = ДислокацияВагонов.Вагон
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПунктОтправления,
	|	ПунктНазначения,
	|	ДатаОтправления";
	
	Запрос.УстановитьПараметр("ДатаНачала", ПериодРеестраПоКонтрагенту.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ПериодРеестраПоКонтрагенту.ДатаОкончания);
	Запрос.УстановитьПараметр("Клиент", КонтрагентРеестра);
	Запрос.УстановитьПараметр("Договор", ДоговорРеестра);
	
	РеестрПоКонтрагенту.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Обработки.ЗагрузкаРеестраВСК.НайтиРеестры(РеестрПоКонтрагенту, КонтрагентРеестра, ДоговорРеестра, ПериодРеестраПоКонтрагенту);
	Обработки.ЗагрузкаРеестраВСК.НайтиУчетныеДокументы(РеестрПоКонтрагенту);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТаблицуВагоновИзРеестровПоКонтрагенту(Команда)
	ОбновитьТаблицуВагоновИзРеестровВСКНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКомплектДокументовПоКонтрагенту(Команда)
	
	ПараметрыФормы = ПодготовитьПараметрыФормыСозданияКомплектаДокументов();
	Если ПараметрыФормы <> Неопределено Тогда
		ОткрытьФорму("Документ.Сделка.Форма.ФормаСозданияКомплектаДокументов", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьПараметрыФормыСозданияКомплектаДокументов()
	
	ТаблицаРеестра = РеестрПоКонтрагенту.Выгрузить(Новый Структура("Выбрать", Истина));	
	Возврат Обработки.ЗагрузкаРеестраВСК.ПодготовитьПараметрыФормыСозданияКомплектаДокументов(ТаблицаРеестра);
	
КонецФункции

&НаКлиенте
Процедура ВыбратьСтрокиПоНаправлению(Команда)
	
	АдресТаблицыНаправлений = ПолучитьАдресТаблицыНаправлений();
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресТаблицыНаправлений", АдресТаблицыНаправлений);
	
	ОповещениеОВыбореНаправления = Новый ОписаниеОповещения("ОбработатьВыборНаправления", ЭтаФорма);
	ОткрытьФорму("Обработка.ЗагрузкаРеестраВСК.Форма.ФормаВыбораНаправления", ПараметрыФормы, ЭтаФорма,,,, ОповещениеОВыбореНаправления, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборНаправления(Направление, ДополнительныеПараметры) Экспорт
	
	Если Направление <> Неопределено Тогда
		
		ВыбранныеСтроки = РеестрПоКонтрагенту.НайтиСтроки(Новый Структура("Выбрать", Истина));
		Для Каждого ВыбраннаяСтрока Из ВыбранныеСтроки Цикл
			ВыбраннаяСтрока.Выбрать = Ложь;
		КонецЦикла;
		
		СтрокиПоНаправлению = РеестрПоКонтрагенту.НайтиСтроки(Новый Структура("ПунктОтправления, ПунктНазначения", Направление.ПунктОтправления, Направление.ПунктНазначения));
		Для Каждого СтрокаПоНаправлению Из СтрокиПоНаправлению Цикл
			Если ЗначениеЗаполнено(СтрокаПоНаправлению.Вагон)
				И ЗначениеЗаполнено(СтрокаПоНаправлению.Контейнер)
				И ЗначениеЗаполнено(СтрокаПоНаправлению.Накладная)
				И ЗначениеЗаполнено(СтрокаПоНаправлению.ПунктОтправления)
				И ЗначениеЗаполнено(СтрокаПоНаправлению.ПунктНазначения)
				И ЗначениеЗаполнено(СтрокаПоНаправлению.Калькуляция)
				И ЗначениеЗаполнено(СтрокаПоНаправлению.Протокол)
				И ЗначениеЗаполнено(СтрокаПоНаправлению.Заявка)
				И ЗначениеЗаполнено(СтрокаПоНаправлению.Сделка)
				И ЗначениеЗаполнено(СтрокаПоНаправлению.ИдентификаторСтрокиДоходовСделки) 
				И Не ЗначениеЗаполнено(СтрокаПоНаправлению.РТУ) Тогда
				СтрокаПоНаправлению.Выбрать = Истина;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьАдресТаблицыНаправлений()
	
	Возврат Обработки.ЗагрузкаРеестраВСК.ПолучитьАдресТаблицыНаправлений(РеестрПоКонтрагенту, УникальныйИдентификатор);
	
КонецФункции

