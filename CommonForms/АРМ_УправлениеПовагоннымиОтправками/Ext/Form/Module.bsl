		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ПовагонныеОтправки.ЦФО = &ЦФО", "");		
	КонецЕсли;
	
	Если Отборы.ОтборТипСтавки <> "Посуточная ставка" Тогда		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ПовагонныеОтправки.ПСЦ.ОплатаПользованияВагоном = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыПользованияВагоном.Посуточно)", "");
