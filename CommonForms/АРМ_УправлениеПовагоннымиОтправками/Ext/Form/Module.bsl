&НаКлиенте
Функция АвтоПОдстановкаКалькуляции(ТекД,Фактическая);
	
	//Евросиб Каблов 12.10.2020 (
	//СтавкаНДС = ПолучитьДанныеПСЦ(ТекД.ПСЦ);
	Если ЗначениеЗаполнено(ТекД.ПСЦ) Тогда
		ЗначенияРеквизитовПСЦ = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(ТекД.ПСЦ, "СтавкаНДС, ОплатаПользованияВагоном");
		Если Не ЗначениеЗаполнено(ЗначенияРеквизитовПСЦ.ОплатаПользованияВагоном) Тогда
			ТекД.ПСЦ = Неопределено;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В протоколе не заполнено поле Оплата пользования вагоном!");
		КонецЕсли;
	Иначе
		СтавкаНДС = Неопределено;
	КонецЕсли;
	//Евросиб Каблов 12.10.2020 )
	ТекД.НДС = СтавкаНДС;
	
	ПараметрыЗапроса = Новый СТруктура;
	Если Фактическая Тогда
		ПараметрыЗапроса.Вставить("ПунктОтправления",ТекД.СтанцияОтправления);
		ПараметрыЗапроса.Вставить("ПунктНазначения",ТекД.СтанцияНазначения);
	Иначе
		ПараметрыЗапроса.Вставить("ПунктОтправления",ТекД.РегионОтправления);
		ПараметрыЗапроса.Вставить("ПунктНазначения",ТекД.РегионВозврата);
	КонецЕсли;
	
	ПараметрыЗапроса.Вставить("НДС",ТекД.НДС);
	ПараметрыЗапроса.Вставить("Вагон",ТекД.НомерВагона);
	
	//Евросиб Каблов 07.04.2021 (
	ПараметрыЗапроса.Вставить("ПСЦ", ТекД.ПСЦ);
	//Евросиб Каблов 07.04.2021 ) 
	
	МассивКальк = ПолучитьСписокПодходящихКалькуляций(ПараметрыЗапроса);
	Если МассивКальк.Количество()>0 Тогда
		ТекД.Калькуляция = МассивКальк[0];
	КонецЕсли;
	
КонецФункции

