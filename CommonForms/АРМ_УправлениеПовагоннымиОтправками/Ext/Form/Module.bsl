&НаСервереБезКонтекста
Процедура ОчиститьСделкиСлужебнаяНаСервере(мСделки)
	Для каждого Сделка Из мСделки Цикл
		обСделка = Сделка.ПолучитьОбъект();
		обСделка.СвязьУчетныхЕдиниц.Очистить();
		обСделка.Доходы.Очистить();
		обСделка.Расходы.Очистить();
		обСделка.СвязьДоходовИРасходов.Очистить();
		обСделка.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЦикла; 
КонецПроцедуры


&НаКлиенте
Процедура ОчиститьСделкиСлужебная(Команда)
	ВыделенныеСтроки = ВагоныВПовагонке.НайтиСтроки(Новый Структура("Пометка", Истина));
	мСделки = Новый Массив;
	Для каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		Для каждого Сделка Из ВыделеннаяСтрока.Сделка Цикл
			мСделки.Добавить(Сделка.Значение);
		КонецЦикла; 
	КонецЦикла; 
	ОчиститьСделкиСлужебнаяНаСервере(мСделки);
КонецПроцедуры


