Процедура ОтборВагоновПриИзменении(Элемент)
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "ГруппаВагоныВПовагонке" Тогда
		ИмяТбл = "ВагоныВПовагонке";
	Иначе
		ИмяТбл = "ВагоныВыведены";
	КонецЕсли;
	// ВСЕ
	Если ОтборВагонов = 0 Тогда
		Элементы[ИмяТбл].ОтборСтрок = неопределено;
	// Вагоны без заявок
	ИначеЕсли ОтборВагонов = 1 Тогда
		Элементы[ИмяТбл].ОтборСтрок = Новый ФиксированнаяСтруктура("Заявка", ПредопределенноеЗначение("Документ.Заявка.ПустаяСсылка"));
	// Вагоны без сделок
	ИначеЕсли ОтборВагонов = 2 Тогда
		//Евросиб Каблов 06.11.2020 ( Ticket#0212868
		//Элементы[ИмяТбл].ОтборСтрок = Новый ФиксированнаяСтруктура("БезСделки", Истина)
		Элементы[ИмяТбл].ОтборСтрок = Новый ФиксированнаяСтруктура("Сделка", ПредопределенноеЗначение("Документ.Сделка.ПустаяСсылка"));
		//Евросиб Каблов 06.11.2020 )
	// Вагоны без документов
	ИначеЕсли ОтборВагонов = 3 Тогда
		Элементы[ИмяТбл].ОтборСтрок = Новый ФиксированнаяСтруктура("БезФинДокументов", Истина)
	// завершенные треки - дата прибытия на станцию назначения	
	ИначеЕсли ОтборВагонов = 4 Тогда
		Элементы[ИмяТбл].ОтборСтрок = Новый ФиксированнаяСтруктура("ЗавершенныйТрек", Истина)
	КонецЕсли;

КонецПроцедуры

