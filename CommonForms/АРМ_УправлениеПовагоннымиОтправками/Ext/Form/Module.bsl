&НаКлиенте
Процедура ВывестиИзПовагонки(Команда)
	
	// т.к. вагон может быть несколько раз в талбице вагоныв повагонке, то окончание пользования должно проставиться у всех строк
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Пометка",Истина);
	НайденныеСтроки = ВагоныВПовагонке.НайтиСтроки(ПараметрыОтбора);
	Для Каждого НС ИЗ НайденныеСтроки Цикл
		ПараметрыОтбора2 = Новый Структура;
		ПараметрыОтбора2.Вставить("НомерВагона",НС.НомерВагона);
		НайденныеСтроки2 = ВагоныВПовагонке.НайтиСтроки(ПараметрыОтбора2);
		Для Каждого НС2 Из НайденныеСтроки2 Цикл
			НС2.Пометка = Истина;
		КонецЦикла;		
	КонецЦикла;
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Пометка",Истина);
	НайденныеСтроки = ВагоныВПовагонке.НайтиСтроки(ПараметрыОтбора);
	
	//ВыдСтроки = Элементы.ВагоныВПовагонке.ВыделенныеСтроки;
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		Сообщить("Не выбрано ни одного вагона для вывода из повагонки!");
		Возврат;
	КонецЕсли;
	
	ИнформированиеПланеров = Новый Массив;
	
	Для Каждого Стр Из НайденныеСтроки Цикл
		СтруктураДанныхСтроки = Новый Структура;
		Для Каждого ЭлемСп Из СписокКолонокВагоныВПовагонке Цикл
			Попытка
				СтруктураДанныхСтроки.Вставить(ЭлемСп.Значение,Стр[ЭлемСп.Значение]);
			Исключение
			КонецПопытки;
		КонецЦикла;
		
		СохранитьДанныеВРСПовагонки(СтруктураДанныхСтроки,Истина,Ложь,Ложь,Неопределено);
		// информируем группу планеров
		ИнформированиеПланеров.Добавить(СтруктураДанныхСтроки);
		
	КонецЦикла;
	
	ОбновитьВагоныВПовагонке();
	ОбновитьВагоныВышедшиеИзПовагонки();
	
	// создать оповещение для планеров
	ОповещениеПользователей(ИнформированиеПланеров,"ИсключенииеВагонов");
	
КонецПроцедуры


&НаКлиенте
Процедура ИсторияПоВагону(Команда)
	
	ТекД = Элементы.ВагоныВПовагонке.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураОтвета = ИсторияПоВагонуСервер(ТекД.НомерВагона);
	
	ПараметрыОткрытия = Новый Структура();
	ПараметрыОткрытия.Вставить("СформироватьПриОткрытии", Истина);
	ПараметрыОткрытия.Вставить("Вариант", СтруктураОтвета.Настройки);
	ПараметрыОткрытия.Вставить("ПользовательскиеНастройки", СтруктураОтвета.КомпоновщикНастроек.ПользовательскиеНастройки);
	ОткрытьФорму("Отчет.ОтчетПоВагонамВПовагонке.Форма", ПараметрыОткрытия, ЭтаФорма);
	
КонецПроцедуры

