	ОписаниеПолучившейсяСтруктуры = ОписаниеПолучившейсяСтруктуры + ?(ОписаниеПолучившейсяСтруктуры = "", "", ",") + "БезФинДокументов";
	
	Ответ = ОтветВыполнить.Выбрать();
	Пока Ответ.Следующий() Цикл
		ЭлементСтруктура = Новый Структура(ОписаниеПолучившейсяСтруктуры);
		ЗаполнитьЗначенияСвойств(ЭлементСтруктура, Ответ);
		Если (НЕ Ответ.СНППогрузки = 0 И НЕ Ответ.РТУСНППогрузки) ИЛИ
			(НЕ Ответ.СНПВыгрузки = 0 И НЕ Ответ.РТУСНПВыгрузки) ИЛИ
			(НЕ Ответ.СНПСледования = 0 И НЕ Ответ.РТУСНППеревозки) ИЛИ
			(НЕ Ответ.СозданСчет И ЗначениеЗаполнено(Ответ.ДатаОтправления)) Тогда
			ЭлементСтруктура.БезФинДокументов = Истина;
		Иначе
			ЭлементСтруктура.БезФинДокументов = Ложь;
		КонецЕсли;
		
		// значение элемента БезСделки заполним исходя из кол-ва дней без сделки
		//Если ЗначениеЗаполнено(Ответ.КоличествоДнейБезСделок) И Ответ.КоличествоДнейБезСделок>0 Тогда
		//	ЭлементСтруктура.БезСделки = Истина;
		//Иначе
		//	ЭлементСтруктура.БезСделки = Ложь;
		//КонецЕсли;
		
		МассивОтвета.Добавить(ЭлементСтруктура);
	КонецЦикла;
	
	Возврат МассивОтвета;
	
КонецФункции

&НаСервереБезКонтекста
Функция ОбновитьВагоныВышедшиеИзПовагонкиСервер(Отборы)
	
	// вагоны вышедшие из повагонки. станцию отправления и назначениея брать из дислокации, установив период
	// равный дате выхода из повагонки
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПовагонныеОтправки.Период КАК Период,
	               |	ПовагонныеОтправки.Вагон КАК НомерВагона,
	               |	ПовагонныеОтправки.Клиент КАК Клиент,
	               |	ПовагонныеОтправки.Договор КАК Договор,
	               |	ПовагонныеОтправки.ПСЦ КАК ПСЦ,
	               |	ПовагонныеОтправки.Сделка КАК Сделка,
	               |	ПовагонныеОтправки.СтанцияОтправления КАК СтанцияОтправления,
	               |	ПовагонныеОтправки.ДатаОтправления КАК ДатаОтправления,
	               |	ПовагонныеОтправки.СтанцияНазначения КАК СтанцияНазначения,
	               |	ПовагонныеОтправки.ДатаПрибытияНаСтанциюНазначения КАК ДатаПрибытияНаСтанциюНазначения,
	               |	ПовагонныеОтправки.ДатаОтправленияСоСтанцииНазначения КАК ДатаОтправленияСоСтанцииНазначения,
	               |	ПовагонныеОтправки.РТУСНППогрузки КАК РТУСНППогрузки,
	               |	ПовагонныеОтправки.РТУСНПВыгрузки КАК РТУСНПВыгрузки,
	               |	ПовагонныеОтправки.РТУСНППеревозки КАК РТУСНППеревозки,
	               |	ПовагонныеОтправки.Комментарий КАК Комментарий,
	               |	ВЫБОР
	               |		КОГДА ПовагонныеОтправки.Заявка = ЗНАЧЕНИЕ(Документ.Заявка.пустаяссылка)
	               |			ТОГДА ПовагонныеОтправки.ДатаПрибытияНаСтанцию
	               |		КОГДА ПовагонныеОтправки.ДатаПрибытияНаСтанцию = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |			ТОГДА ПовагонныеОтправки.Заявка.Дата
	               |		КОГДА НЕ ПовагонныеОтправки.Заявка = ЗНАЧЕНИЕ(Документ.Заявка.пустаяссылка)
	               |				И НЕ ПовагонныеОтправки.ДатаПрибытияНаСтанцию = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |			ТОГДА ВЫБОР
	               |					КОГДА ПовагонныеОтправки.ДатаПрибытияНаСтанцию > ПовагонныеОтправки.Заявка.Дата
	               |						ТОГДА ПовагонныеОтправки.ДатаПрибытияНаСтанцию
	               |					ИНАЧЕ ПовагонныеОтправки.Заявка.Дата
	               |				КОНЕЦ
	               |	КОНЕЦ КАК ДатаПрибытияДляСНП,
	               |	ПовагонныеОтправки.Калькуляция КАК Калькуляция,
	               |	ПовагонныеОтправки.РТУ КАК РТУОсновнаяУслуга,
	               |	ВЫБОР
	               |		КОГДА НЕ ПовагонныеОтправки.ДатаОкончанияПользования = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |			ТОГДА ПовагонныеОтправки.ДатаОкончанияПользования
	               |		ИНАЧЕ ПовагонныеОтправки.ДатаПрибытияНаСтанциюНазначения
	               |	КОНЕЦ КАК ДатаВыгрузкиДляСНП,
	               |	ВЫБОР
	               |		КОГДА НЕ ПовагонныеОтправки.ДатаОтправленияСоСтанцииНазначения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |			ТОГДА ПовагонныеОтправки.ДатаОтправленияСоСтанцииНазначения
	               |		КОГДА НЕ ПовагонныеОтправки.ПереводВНРП = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |			ТОГДА ПовагонныеОтправки.ПереводВНРП
	               |		ИНАЧЕ ПовагонныеОтправки.ДатаОкончанияПользования
	               |	КОНЕЦ КАК ДатаОкончанияДляСНПСлед,
