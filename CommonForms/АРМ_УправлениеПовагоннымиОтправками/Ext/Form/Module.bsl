&НаКлиенте
Процедура ОбновитьВагоныВПодходе()
	
	ПодходВагонов.Очистить();
	СтруктураОтборов = ПолучитьСтруктуруОтборов();
	МассивСтруктурОтвет = ОбновитьВагоныВПодходеСервер(СтруктураОтборов);
	КолвоВПодходе = 0;
	Для Каждого ЭлементМассива Из МассивСтруктурОтвет Цикл
		ЗаполнитьЗначенияСвойств(ПодходВагонов.Добавить(), ЭлементМассива);
		КолвоВПодходе = КолвоВПодходе + 1;
		
	КонецЦикла;
	
	Элементы.ГруппаПодходВагоновКСтанциям.Заголовок = "Подход к станциям перевода в повагонку (" + КолвоВПодходе + ")";
	
