&НаКлиенте
Процедура ВыборКалькуляции(ТекД, ИмяТаблицы, Фактическая)

	ПараметрыЗапроса = Новый СТруктура;
	Если Фактическая Тогда
		ПараметрыЗапроса.Вставить("ПунктОтправления",ТекД.СтанцияОтправления);
		//ПараметрыЗапроса.Вставить("ПунктОтправления", ТекД.СтанцияПодачи);
		ПараметрыЗапроса.Вставить("ПунктНазначения",ТекД.СтанцияНазначения);
	Иначе
		ПараметрыЗапроса.Вставить("ПунктОтправления",ТекД.РегионОтправления);
		Если ЗначениеЗаполнено(ТекД.РегионВозврата) Тогда
			ПараметрыЗапроса.Вставить("ПунктНазначения",ТекД.РегионВозврата);
		Иначе
			ПараметрыЗапроса.Вставить("ПунктНазначения",Неопределено);
		КонецЕсли;			
	КонецЕсли;
	
	ПараметрыЗапроса.Вставить("НДС",ТекД.НДС);
	ПараметрыЗапроса.Вставить("Вагон",ТекД.НомерВагона);
	//Евросиб Каблов 07.04.2021 (
	ПараметрыЗапроса.Вставить("ПСЦ", ТекД.ПСЦ);
	ПараметрыЗапроса.Вставить("ОтборПоТипуТС", Истина);
	//Евросиб Каблов 07.04.2021 )
	
	СписокКальк = Новый СписокЗначений;
	СписокКальк.ЗагрузитьЗначения(ПолучитьСписокПодходящихКалькуляций(ПараметрыЗапроса));
	
	ПараметрыОтбора = Новый СТруктура;
	ПараметрыОтбора.Вставить("ПодходящиеКалькуляции",СписокКальк);
	Если ЗначениеЗаполнено(ТекД.Клиент) Тогда
		ПараметрыОтбора.Вставить("Клиент",ТекД.Клиент);
	КонецЕсли;
	
	ДопПараметры = Новый СТруктура;
	ДопПараметры.Вставить("СписокКальк",СписокКальк);
	ДопПараметры.Вставить("ТекД",ТекД);
	ДопПараметры.Вставить("ИмяТаблицы", ИмяТаблицы);
	
	ОпОп = новый ОписаниеОповещения("ОбработкаВыбораКалькуляции", ЭтаФорма, ДопПараметры);
	ОткрытьФорму("Документ.Калькуляция.ФормаВыбора",ПараметрыОтбора ,, ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокПодходящихКалькуляций(ПараметрыЗапроса)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АналогиЛокаций.Аналог КАК Станция
	|ПОМЕСТИТЬ СтанцииОтправления
	|ИЗ
	|	РегистрСведений.АналогиЛокаций КАК АналогиЛокаций
	|ГДЕ
	|	АналогиЛокаций.Локация = &ПунктОтправления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	АналогиЛокаций.Локация
	|ИЗ
	|	РегистрСведений.АналогиЛокаций КАК АналогиЛокаций
	|ГДЕ
	|	АналогиЛокаций.Аналог = &ПунктОтправления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	&ПунктОтправления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АналогиЛокаций.Аналог КАК Станция
	|ПОМЕСТИТЬ СтанцииНазначения
	|ИЗ
	|	РегистрСведений.АналогиЛокаций КАК АналогиЛокаций
	|ГДЕ
	|	АналогиЛокаций.Локация = &ПунктНазначения
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	АналогиЛокаций.Локация
	|ИЗ
	|	РегистрСведений.АналогиЛокаций КАК АналогиЛокаций
	|ГДЕ
	|	АналогиЛокаций.Аналог = &ПунктНазначения
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	&ПунктНазначения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокКалькуляция.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВремКалькуляцииПоСтанциям
	|ИЗ
	|	Документ.Калькуляция КАК ДокКалькуляция
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Калькуляция.СписокСтанцийОтправления КАК КалькуляцияСписокСтанцийОтправления
	|		ПО ДокКалькуляция.Ссылка = КалькуляцияСписокСтанцийОтправления.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Калькуляция.СписокСтанцийНазначения КАК КалькуляцияСписокСтанцийНазначения
	|		ПО ДокКалькуляция.Ссылка = КалькуляцияСписокСтанцийНазначения.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПСЦ.Калькуляции КАК ПСЦКалькуляции
	|		ПО ДокКалькуляция.Ссылка = ПСЦКалькуляции.Калькуляция
	|ГДЕ
	|	(ВЫБОР
	|				КОГДА &БезПунктаНазначения
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ КалькуляцияСписокСтанцийНазначения.Станция В ИЕРАРХИИ
	|						(ВЫБРАТЬ
	|							СтанцииНазначения.Станция КАК Станция
	|						ИЗ
	|							СтанцииНазначения КАК СтанцииНазначения)
	|			КОНЕЦ
	|			ИЛИ ДокКалькуляция.Ссылка.Суша_ПунктНазначения В
	|				(ВЫБРАТЬ
	|					СтанцииНазначения.Станция КАК Станция
	|				ИЗ
	|					СтанцииНазначения КАК СтанцииНазначения))
	|	И (КалькуляцияСписокСтанцийОтправления.Станция В ИЕРАРХИИ
	|				(ВЫБРАТЬ
	|					СтанцииОтправления.Станция КАК Станция
	|				ИЗ
	|					СтанцииОтправления КАК СтанцииОтправления)
	|			ИЛИ ДокКалькуляция.Ссылка.Суша_ПунктОтправления В
	|				(ВЫБРАТЬ
	|					СтанцииОтправления.Станция КАК Станция
	|				ИЗ
	|					СтанцииОтправления КАК СтанцииОтправления))
	|	И ПСЦКалькуляции.Ссылка = &ПСЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка КАК Ссылка
	|ИЗ
	|	ВремКалькуляцииПоСтанциям КАК ВремКалькуляцииПоСтанциям
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Калькуляция.ММ_КалькуляцияМультимодальнойЦепочки КАК КалькуляцияММ_КалькуляцияМультимодальнойЦепочки
	|		ПО ВремКалькуляцииПоСтанциям.Ссылка = КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка
	|ГДЕ
	|	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.СтавкаНДС = &СтавкаНДС
	|	И КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Услуга = &ВыставляемаяУслуга
	|	И КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка.ЖД_РасчетСебестоимостиДляТипаФГП В (&РазмерВагона)";
	Запрос.УстановитьПараметр("ПунктОтправления",ПараметрыЗапроса.ПунктОтправления);
	Если ПараметрыЗапроса.ПунктНазначения = Неопределено Тогда
		Запрос.УстановитьПараметр("БезПунктаНазначения",Истина);
		Запрос.УстановитьПараметр("ПунктНазначения",ПараметрыЗапроса.ПунктНазначения);
	Иначе
		Запрос.УстановитьПараметр("БезПунктаНазначения",Ложь);
		Запрос.УстановитьПараметр("ПунктНазначения",ПараметрыЗапроса.ПунктНазначения);
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("СтавкаНДС",ПараметрыЗапроса.НДС);
	Запрос.УстановитьПараметр("ВыставляемаяУслуга",Константы.УслугаДляПовагоннойЗаявки.Получить());
	
	//Евросиб Каблов 07.04.2021 ( Ticket#0226529
	ПСЦ = Неопределено;
	Если ПараметрыЗапроса.Свойство("ПСЦ", ПСЦ) И ЗначениеЗаполнено(ПСЦ) Тогда
		Запрос.УстановитьПараметр("ПСЦ", ПСЦ);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ПСЦКалькуляции.Ссылка = &ПСЦ", "");
	КонецЕсли;
	
	ОтборПоТипуТС = Неопределено;
	Если ПараметрыЗапроса.Свойство("ОтборПоТипуТС", ОтборПоТипуТС) И ОтборПоТипуТС Тогда
		МассивРазмеровВагона = ПолучитьМассивРодителейТипаТС(ПараметрыЗапроса.Вагон.ТипТС,Истина);
		МассивРазмеровВагона.Добавить(Справочники.ТипоразмерыТС.ПустаяСсылка());
		Запрос.УстановитьПараметр("РазмерВагона",МассивРазмеровВагона);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка.ЖД_РасчетСебестоимостиДляТипаФГП В (&РазмерВагона)", "");
	КонецЕсли;
	//Евросиб Каблов 07.04.2021 ) 
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	МассивКалькуляций = ТЗ.ВыгрузитьКолонку("Ссылка");
	
	Возврат МассивКалькуляций;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьМассивРодителейТипаТС(ТипТС, ВключаяТекущий) 
	
	Результат = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(ТипТС) Тогда Возврат Результат; КонецЕсли;
	
	ТекРодитель = ТипТС.Родитель;
	Пока ЗначениеЗаполнено(ТекРодитель) Цикл
		Результат.Добавить(ТекРодитель);
		ТекРодитель = ТекРодитель.Родитель;
	КонецЦикла;
	
	Если ВключаяТекущий = Истина Тогда Результат.Добавить(ТипТС); КОнецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаВыбораКалькуляции(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если параметр1 = Неопределено тогда 
		возврат; 
	КонецЕсли;
	
	Параметр2.ТекД.Калькуляция = Параметр1;
	// если в массиве подходящих калькуляций нет выбранной, то значит, выбрали из общего списка; отметить как неподходящую
	Если Параметр2.СписокКальк.НайтиПоЗначению(Параметр1) = Неопределено Тогда
		Параметр2.ТекД.КалькуляцияНеПодходит = Истина;
	Иначе
		Параметр2.ТекД.КалькуляцияНеПодходит = Ложь;
	КонецЕсли;
	
	Если Параметр2.ИмяТаблицы = "ВагоныВПовагонке" Тогда
		ВагоныВПовагонкеПриИзменении(Элементы.ВагоныВПовагонке);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура СоздатьКомплектДокументов(Команда)    
	//ДИТ Беляев СЮ, Ticket#0248292, 03-11-2021 ++ (Убираем использование регистра <ВыставлениеПосуточнойАренды>
	ПоказатьПредупреждение(,"В настоящий момент эта функция не работает."+Символы.ПС+
					"Причина: логика основывалась на данных регистра <ВыставлениеПосуточнойАренды>, который был упразднен.",60);	
	Возврат;
	//ДИТ Беляев СЮ, Ticket#0248292, 03-11-2021 -- 
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "ГруппаВагоныВПовагонке" Тогда
		ТекТбл = "ВагоныВПовагонке";
	Иначе
		ТекТбл = "ВагоныВыведены";
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Пометка",Истина);
	НайденныеСтроки = ЭтаФорма[ТекТбл].НайтиСтроки(ПараметрыОтбора);
	МассивОтмеченных = Новый Массив;
	Для Каждого Стр Из НайденныеСтроки Цикл
		СтруктураСтроки = Новый Структура;
		СтруктураСтроки.Вставить("НомерВагона",Стр.НомерВагона);
		СтруктураСтроки.Вставить("ДатаОтправления",Стр.ДатаОтправления);

		// проверка на созданные сделки
		//Если ЗначениеЗаполнено(Стр.ДатаОтправления) И Стр.Сделка.Количество() = 0 Тогда
		//ДИТ Беляев СЮ, Ticket#0248292, 03-11-2021 ++ (Стр.Сделка.Количество() вызывает ошибку платформы)
		Если ЗначениеЗаполнено(Стр.ДатаОтправления) И НЕ ЗначениеЗаполнено(Стр.Сделка) Тогда
		//ДИТ Беляев СЮ, Ticket#0248292, 03-11-2021 --
			Сообщить("Перед созданием комплекта документов должная быть создана сделка");
			Возврат;
		КонецЕсли;
		
		МассивОтмеченных.Добавить(СтруктураСтроки);
	КонецЦикла;
	
	Если МассивОтмеченных.Количество() = 0 Тогда
		Сообщить("Не выбрано ни одной строки для создания комплекта документов!");
		Возврат;
	КонецЕсли;
	
	// проверка сделок на наличие ЖДН  
	//МассивСделок_С_ЖДН = ПроверкаСделокЖДН(МассивОтмеченных);
	//ДИТ Беляев СЮ, Ticket#0248292, 03-11-2021 ++ (Убираем использование регистра <ВыставлениеПосуточнойАренды>
    МассивСделок_С_ЖДН = Новый Массив;
	//ДИТ Беляев СЮ, Ticket#0248292, 03-11-2021 --
	
	// нужно вывести информацию о тех сделках, где нет ЖДН
	Для Каждого Эл Из МассивОтмеченных Цикл
		Сообщить("Для сделки " + Эл + " не указан номер ЖДН");	
	КонецЦикла;
	
	Если МассивСделок_С_ЖДН.Количество() = 0 Тогда
		МассивСтруктур = Новый Массив;
	Иначе
		МассивСтруктур = ПодготовитьТаблицуПоДокументам(МассивСделок_С_ЖДН);	
	КонецЕсли;
	
	
	ПараметрыФормы =  Новый Структура("Повагонка, МассивСтрок", Истина, МассивСтруктур);
	
	ОткрытьФорму("Документ.Сделка.Форма.ФормаСозданияКомплектаДокументов", ПараметрыФормы);
	
КонецПроцедуры

//ДИТ Беляев СЮ, Ticket#0248292, 03-11-2021 ++ (Убираем использование регистра <ВыставлениеПосуточнойАренды>
//&НаСервереБезКонтекста
//Функция ПроверкаСделокЖДН(МассивОтмеченных)
//	
//	МассивСделокБезЖДН = Новый Массив;
//	
