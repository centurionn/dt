&НаКлиенте
Процедура ДобавитьВагоныВПовагонку(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаДобавленияВагоновВПовагонку", ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.ДобавлениеВагоновВПовагонку", ,,ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаДобавленияВагоновВПовагонку(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если параметр1 = Неопределено тогда 
		возврат; 
	КонецЕсли;
	
	МассивЗаявокКЗаписи = Новый Массив;
	ИнформированиеМенеджеровПоПродажам = Новый Массив;
	
	Для каждого Стр из параметр1 Цикл
		
		// записать данные в РС повагонки или запланированных вагонов.
		// подготовка структуры.
		СтруктураДанныхСтроки = Новый Структура;
		
		// для первого добавления данных в регистр
		Если СписокКолонокВагоныВПовагонке.Количество() = 0 Тогда
			СтруктураДанныхСтроки.Вставить("НомерВагона",Стр.НомерВагона);
			СтруктураДанныхСтроки.Вставить("ДатаПередачиВПользование",Стр.ДатаПередачиВПользование);
			СтруктураДанныхСтроки.Вставить("Договор",Стр.Договор);
			СтруктураДанныхСтроки.Вставить("Клиент",Стр.Клиент);
			СтруктураДанныхСтроки.Вставить("РегионВозврата",Стр.РегионВозврата);
			СтруктураДанныхСтроки.Вставить("РегионОтправления",Стр.РегионОтправления);
			СтруктураДанныхСтроки.Вставить("ЦФО",Стр.ЦФО);			
			
		Иначе
			Для Каждого ЭлемСп Из СписокКолонокВагоныВПовагонке Цикл
				Попытка
					СтруктураДанныхСтроки.Вставить(ЭлемСп.Значение,Стр[ЭлемСп.Значение]);
				Исключение
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;
		
		ДатаПомещения = ТекущаяДата();
		СпособПомещения = ПредопределенноеЗначение("Перечисление.СобытияПереводаВПовагонку.Вручную");
		СтруктураДанныхСтроки.Вставить("ДатаПомещенияВРежимПовагонки",ДатаПомещения);
		СтруктураДанныхСтроки.Вставить("СобытиеПереводаВПовагонку",СпособПомещения);
		
		ЗаявкаИзменилась = Ложь;
		
		Если НЕ ЗначениеЗаполнено(Стр.ДатаПередачиВПользование) Тогда
			Стр.ДатаПередачиВПользование = ТекущаяДата();
		КонецЕсли;
		
		// если региона отправления нет, то добавляем непосредственно в ВагоныВПовагонке  
		Если Стр.РегионОтправления = ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка") Тогда
			НовСтр = ВагоныВПовагонке.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр,Стр);
			НовСтр.ДатаПомещенияВРежимПовагонки = ДатаПомещения;
			НовСтр.СобытиеПереводаВПовагонку = СпособПомещения;

			СохранитьДанныеВРСПовагонки(СтруктураДанныхСтроки,Ложь,ЗаявкаИзменилась,Ложь,Стр.ВводВРейс);
			
		Иначе
			// в другом случае, добавляем в плановые и ждем достижения ими требуемой станции
			НовСтр = ПодходВагонов.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр,Стр);
			НовСтр.ДатаПомещенияВРежимПовагонки = ДатаПомещения;
			НовСтр.СобытиеПереводаВПовагонку = СпособПомещения;

			СохранитьДанныеВРСПовагонки(СтруктураДанныхСтроки,Ложь,ЗаявкаИзменилась,Истина,Неопределено);
			
		КонецЕсли;
		
		Если ЗаявкаИзменилась Тогда
			МассивЗаявокКЗаписи.Добавить(СтруктураДанныхСтроки);
		КонецЕсли;
		// менеджеров по продажам информируем в любом случае
		ИнформированиеМенеджеровПоПродажам.Добавить(СтруктураДанныхСтроки);
		
	КонецЦикла;
	
	
	// записать данные в заявку
	Если МассивЗаявокКЗаписи.Количество()>0 Тогда
		Если Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "ГруппаВагоныВПовагонке" Тогда
			Фактическая = Истина;
		Иначе
			Фактическая = Ложь;
		КонецЕсли;
		ЗаписатьДанныеПоВагонуВЗаявку(МассивЗаявокКЗаписи,Фактическая);
	КонецЕсли;

	// обновляем данные из дислокации
	ОбновитьВагоныВПовагонке();
	ОбновитьВагоныВПодходе();
	//Если ВагоныВПовагонке.Количество() = 0 Тогда
	//	ОбновитьВагоныВПовагонке(1);
	//Иначе
	//	ОбновитьВагоныВПовагонке(0);
	//КонецЕсли;
	//Если ПодходВагонов.Количество() = 0 Тогда
	//	ОбновитьВагоныВПодходе(1);
	//Иначе
	//	ОбновитьВагоныВПодходе(0);
	//КонецЕсли;

	// создать оповещение для менеджеров по продажам
	ОповещениеПользователей(ИнформированиеМенеджеровПоПродажам,"ДобавлениеВагонов");	
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОповещениеПользователей(ИнформированиеМенеджеровПоПродажам,ПроисходящееСобытие)
	
	ЗВ = Документы.ЗапланированноеВзаимодействие.СоздатьДокумент();
	ЗВ.Дата = ТекущаяДата();
	ЗВ.Автор = Пользователи.ТекущийПользователь();
	ЗВ.СоздатьПроизводственнуюЗадачу = Истина;
	ЗВ.Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
	ЗВ.ДатаНачала = ТекущаяДата();
	СтрокаСВагонами = "";
	Для Каждого Эл Из ИнформированиеМенеджеровПоПродажам Цикл
		СтрокаСВагонами = СтрокаСВагонами + Эл.НомерВагона + Символы.ПС;
	КонецЦикла;
	
	Если ПроисходящееСобытие = "ДобавлениеВагонов" Тогда
		ЗВ.Тема = "Добавление вагонов в повагонку";
		ТЧ_Участники = ЗВ.Участники;
		Участники = Константы.ГруппаИнформируемыхОВключенииВагонаВПовагонку.Получить();
		Если НЕ ЗначениеЗаполнено(Участники) Тогда
			Сообщить("Не заполнена константа <Группа информируемых о включении вагона в повагонку>
			|Оповещение не выполнено! Обратитесь в тех.поддержку!");
			Возврат;
		КонецЕсли; 
		Для каждого Участник Из Участники.Состав Цикл
			НовСтр = ТЧ_Участники.Добавить();
			НовСтр.Контакт = Участник.Пользователь;
		КонецЦикла; 
		ЗаголовокОписания = "В АРМ повагонки были добавлены следующие вагоны:";
	ИначеЕсли ПроисходящееСобытие = "ИсключенииеВагонов" Тогда
		ЗВ.Тема = "Удаление вагонов из повагонки";
		ТЧ_Участники = ЗВ.Участники;
		Участники = Константы.ГруппаИнформируемыхОбИсключенииВагонаИзПовагонки.Получить();
		Если НЕ ЗначениеЗаполнено(Участники) Тогда
			Сообщить("Не заполнена константа <Группа информируемых об исключении вагона из повагонки>
			|Оповещение не выполнено! Обратитесь в тех.поддержку!");
			Возврат;
		КонецЕсли; 
		Для каждого Участник Из Участники.Состав Цикл
			НовСтр = ТЧ_Участники.Добавить();
			НовСтр.Контакт = Участник.Пользователь;
		КонецЦикла; 
		ЗаголовокОписания = "Из режима повагонки были исключены следующие вагоны:";
	ИначеЕсли ПроисходящееСобытие = "ВключениеВСделку" Тогда
		ЗВ.Тема = "Включение вагонов в сделку";
		ТЧ_Участники = ЗВ.Участники;
		Участники = Константы.ГруппаИнформируемыхОВключенииВагонаВСделку.Получить();
		Если НЕ ЗначениеЗаполнено(Участники) Тогда
			Сообщить("Не заполнена константа <Группа информируемых о включении вагона в сделку>
			|Оповещение не выполнено! Обратитесь в тех.поддержку!");
			Возврат;
		КонецЕсли; 
		Для каждого Участник Из Участники.Состав Цикл
			НовСтр = ТЧ_Участники.Добавить();
			НовСтр.Контакт = Участник.Пользователь;
		КонецЦикла; 
		ЗаголовокОписания = "В сделку были добавлены следующие вагоны:";
	ИначеЕсли ПроисходящееСобытие = "ЗапросВагоновВПовагонку" Тогда 
		ЗВ.Тема = "Запрос вагонов в повагонку";
		ТЧ_Участники = ЗВ.Участники;
		Участники = Константы.ГруппаИнформируемыхОЗапросеПереводаВагонаВПовагонку.Получить();
		Если НЕ ЗначениеЗаполнено(Участники) Тогда
			Сообщить("Не заполнена константа <Группа информируемых о запросе перевода вагона в повагонку>
			|Оповещение не выполнено! Обратитесь в тех.поддержку!");
			Возврат;
		КонецЕсли; 
		Для каждого Участник Из Участники.Состав Цикл
			НовСтр = ТЧ_Участники.Добавить();
			НовСтр.Контакт = Участник.Пользователь;
		КонецЦикла; 
		ЗаголовокОписания = "Требуется вывести в повагонку следующие вагоны:";
	ИначеЕсли ПроисходящееСобытие = "НеобходимаПередислокация" Тогда 
		ЗВ.Тема = "Требуется передислокация";
		ТЧ_Участники = ЗВ.Участники;
		Участники = Константы.ГруппаИнформируемыхОНеобходимостиПередислокации.Получить();
		Если НЕ ЗначениеЗаполнено(Участники) Тогда
			Сообщить("Не заполнена константа <Группа информируемых о необходимости передислокации>
			|Оповещение не выполнено! Обратитесь в тех.поддержку!");
			Возврат;
		КонецЕсли; 
		Для каждого Участник Из Участники.Состав Цикл
			НовСтр = ТЧ_Участники.Добавить();
			НовСтр.Контакт = Участник.Пользователь;
		КонецЦикла; 
		ЗаголовокОписания = "требуется подсыл следующих вагонов на станцию %1 %2:";
		ЗаголовокОписания = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ЗаголовокОписания,
								ИнформированиеМенеджеровПоПродажам[0].СтанцияПодачи,
								ИнформированиеМенеджеровПоПродажам[0].ДатаПлановогоОтправленияСоСтанцииПодачи); 
	КонецЕсли;
	
	ЗВ.Описание = ЗаголовокОписания + Символы.ПС + СтрокаСВагонами;
	ПОпытка
		ЗВ.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ЗВ.Записать(РежимЗаписиДокумента.Запись);
	КонецПопытки;
	Сообщить("Оповещение планеров выполнено");
	
КонецПроцедуры

