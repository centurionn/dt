&НаКлиенте
Процедура СоздатьСделкиПоВагонам(ИскатьНакладные = Истина, Сделка = Неопределено)
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "ГруппаВагоныВПовагонке" Тогда
		ТекТаблица = ВагоныВПовагонке;
		ИмяТч = "ВагоныВПовагонке";
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "ГруппаВыведеныИзПовагонки" Тогда
		ТекТаблица = ВагоныВыведены;
		ИмяТч = "ВагоныВыведены";
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Пометка",Истина);
	НайденныеСтроки = ТекТаблица.НайтиСтроки(ПараметрыОтбора);
	МассивСтруктур = Новый Массив;
	Для Каждого Стр Из НайденныеСтроки Цикл
		
		Если НЕ ЗначениеЗаполнено(Стр.Клиент) Тогда
			Сообщить("У выбранных вагонов не выбран клиент. Выберите клиента и повторите попытку создания сделки");
			ВОзврат;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Стр.Договор) Тогда
			Сообщить("У выбранных вагонов не выбран договор. Выберите договор и повторите попытку создания сделки");
			ВОзврат;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Стр.ПСЦ) Тогда
			Сообщить("У выбранных вагонов не выбран ПСЦ. Выберите ПСЦ и повторите попытку создания сделки");
			ВОзврат;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Стр.НДС) Тогда
			Сообщить("У выбранных вагонов не выбран НДС. Выберите НДС и повторите попытку создания сделки");
			ВОзврат;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Стр.Калькуляция) Тогда
			Сообщить("У выбранных вагонов не выбрана калькуляция. Выберите калькуляцию и повторите попытку создания сделки");
			ВОзврат;
		КонецЕсли;
		//Если Стр.КалькуляцияНеПодходит Тогда
		//	Сообщить("У выбранных вагонов калькуляции не подходят к рейсу. Выберите другие и повторите попытку создания сделки");
		//	ВОзврат;
		//КонецЕсли;
		//Если НЕ ЗначениеЗаполнено(Стр.Заявка) Тогда
		//	Сообщить("У выбранных вагонов не заполнены заявки. Выберите или создайте заявки и повторите попытку создания сделки");
		//	ВОзврат;
		//КонецЕсли;
		//Если Стр.ЗаявкаНеПодходит Тогда
		//	Сообщить("У выбранных вагонов заявки не подходят для рейса. Выберите другие и повторите попытку создания сделки");
		//	ВОзврат;
		//КонецЕсли;
		
		СтруктураДанныхСтроки = Новый Структура;
		//СтруктураСтроки.Вставить("НомерВагона",Стр.НомерВагона);
		//СтруктураСтроки.Вставить("ДатаОтправления",Стр.ДатаОтправления);
		//СтруктураСтроки.Вставить("Заявка",Стр.Заявка);
		Для Каждого ЭлемСп Из СписокКолонокВагоныВПовагонке Цикл
			Попытка
				СтруктураДанныхСтроки.Вставить(ЭлемСп.Значение,Стр[ЭлемСп.Значение]);
			Исключение
			КонецПопытки;
		КонецЦикла;

		МассивСтруктур.Добавить(СтруктураДанныхСтроки);
	КонецЦикла;
		
	Если МассивСтруктур.Количество() = 0 Тогда
		Сообщить("Не выбрано ни одной строки для создания сделки!");
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	ПроверитьВагоныПередСозданиемСделокСервер(МассивСтруктур, Отказ);
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сделки не созданы!");
		Возврат;
	КонецЕсли;
	
	//ДИТ Беляев СЮ, Ticket#0248292, 03-11-2021 ++ (Убираем использование регистра <ВыставлениеПосуточнойАренды>
	//МассивНеподходящихВагонов = ПроверкаВозможностиСозданияСделки(МассивСтруктур);
	//ДИТ Беляев СЮ, Ticket#0248292, 03-11-2021 --
	
	МассивЗаявок = СоздатьЗаявкуНаСервере(МассивСтруктур,Истина);
	Для Каждого Эл Из МассивЗаявок Цикл
		Сообщить(Строка(Эл.Заявка) + " успешно создана!");
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("НомерВагона",Эл.НомерВагона);
		ПараметрыОтбора.Вставить("ДатаПомещенияВРежимПовагонки",Эл.ДатаПомещенияВРежимПовагонки);
		НайдСтр = ТекТаблица.НайтиСтроки(ПараметрыОтбора);
		Если НайдСтр.Количество()>0 Тогда
			НайдСтр[0].Заявка = Эл.Заявка;
			НайдСтр[0].ЗаявкаНеПодходит = Ложь;
		КонецЕсли;
	КонецЦикла;
	СтруктураСтроки = Новый Структура;
	СтруктураСтроки.Вставить("НомерВагона",Стр.НомерВагона);
	СтруктураСтроки.Вставить("ДатаОтправления",Стр.ДатаОтправления);
	СтруктураСтроки.Вставить("Заявка",Стр.Заявка);
	
	МассивЗаявокБезПодразделения = ПроверитьЗаявкиНаЗаполненность(МассивСтруктур);
	СтрокаЗаявок = "";
	Если МассивЗаявокБезПодразделения.Количество()>0 Тогда
		Для Каждого Эл Из МассивЗаявокБезПодразделения Цикл
			СтрокаЗаявок = СтрокаЗаявок + Символы.ПС + Эл;
		КонецЦикла;
		Сообщить("В следующих заявках не указано Подразделение. Укажите Подразделение и повторите попытку создания Сделки! " + СтрокаЗаявок);
		ВОзврат;
	КонецЕсли;
	
	//ВыбранныеСтрокиПовагонки = МассивСтруктур;
	ВсеНакладныеНайдены = Истина;
	ВагоныДляПодбораНакладных = Новый Массив;
	ТриДня = 3 * 24 * 3600;
	ВыбранныеСтрокиПовагонки = Новый Массив;
	Для Каждого ДанныеСтроки Из МассивСтруктур Цикл
		
		ДанныеСтроки.Вставить("ЖДНакладная");
		ДанныеСтроки.Вставить("НомерКонтейнера");
		Если ИскатьНакладные Тогда
			ДанныеНакладных = НайтиНакладные(ДанныеСтроки);
			КоличествоНакладных = ДанныеНакладных.Количество();
			Если КоличествоНакладных = 1 Тогда
				ДанныеСтроки.НомерКонтейнера = ДанныеНакладных[0].НомерКонтейнера;
				ДанныеСтроки.ЖДНакладная = ДанныеНакладных[0].Накладная;
			Иначе
				ПериодОтправленияНачало = НачалоДня(ДанныеСтроки.ДатаОтправления) - ТриДня;
				ПериодОтправленияОкончание = КонецДня(ДанныеСтроки.ДатаОтправления);
				ВагоныДляПодбораНакладных.Добавить(Новый Структура("Вагон, СтанцияОтправления, СтанцияНазначения, ПериодОтправленияНачало, ПериодОтправленияОкончание", ДанныеСтроки.НомерВагона, ДанныеСтроки.СтанцияОтправления, ДанныеСтроки.СтанцияНазначения, ПериодОтправленияНачало, ПериодОтправленияОкончание));			
			КонецЕсли;
		КонецЕсли;
		
		ВыбранныеСтрокиПовагонки.Добавить(ДанныеСтроки);
		
	КонецЦикла;
	
	Если ИскатьНакладные И Не ВсеНакладныеНайдены Тогда
		ТекстПредупреждения = СтрШаблон("Не удалось найти ЖД накладные для всех вагонов. Сделки не созданы.", ДанныеСтроки.НомерВагона);
		ПоказатьПредупреждение(, ТекстПредупреждения);
	ИначеЕсли ИскатьНакладные И ВагоныДляПодбораНакладных.Количество() > 0 Тогда
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ИмяТЧ", ИмяТч);
		ДополнительныеПараметры.Вставить("ВыбранныеСтрокиПовагонки", ВыбранныеСтрокиПовагонки);
		ДополнительныеПараметры.Вставить("Сделка", Сделка);
		ОпОп = Новый ОписаниеОповещения("ОбработатьВыборНакладныхПоВагонам", ЭтаФорма, ДополнительныеПараметры);
		ПараметрыОтбора = Новый СТруктура;
		//ПерваяВыбраннаяСтрока = ВыбранныеСтрокиПовагонки[0];
		//ПараметрыОтбора.Вставить("ПериодОтправленияНачало", НачалоДня(ПерваяВыбраннаяСтрока.ДатаОтправления) - ТриДня);
		//ПараметрыОтбора.Вставить("ПериодОтправленияОкончание", КонецДня(ПерваяВыбраннаяСтрока.ДатаОтправления));
		//ПараметрыОтбора.Вставить("СтанцияОтправления", ПерваяВыбраннаяСтрока.СтанцияОтправления);
		//ПараметрыОтбора.Вставить("СтанцияНазначения", ПерваяВыбраннаяСтрока.СтанцияНазначения);
		ПараметрыОтбора.Вставить("ВагоныДляПодбораНакладных", ВагоныДляПодбораНакладных);
		ПараметрыОтбора.Вставить("ПроверятьДействующийСтатусГВЦ", Ложь);
		ПараметрыОтбора.Вставить("ПодборНесколькихЖДННаВагон", Истина);
		ОткрытьФорму("Документ.Сделка.Форма.ФормаПодбораЖДНакладных",ПараметрыОтбора,, ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		СоздатьСделкиПродолжение(ВыбранныеСтрокиПовагонки, Новый Структура("ИмяТЧ", ИмяТч), Сделка);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверитьВагоныПередСозданиемСделокСервер(МассивСтрок, Отказ = Ложь)
	
	Для Каждого ТекД Из МассивСтрок Цикл
		
		ПараметрыЗапроса = Новый СТруктура;
		ПараметрыЗапроса.Вставить("ПунктОтправления",ТекД.СтанцияОтправления);
		ПараметрыЗапроса.Вставить("ПунктНазначения",ТекД.СтанцияНазначения);
		ПараметрыЗапроса.Вставить("НДС",ТекД.НДС);
		ПараметрыЗапроса.Вставить("Вагон",ТекД.НомерВагона);
		//Евросиб Каблов 07.04.2021 (
		ПараметрыЗапроса.Вставить("ПСЦ", ТекД.ПСЦ);
		//Евросиб Каблов 07.04.2021 )
		
		МассивПодходящихКалькуляций = ПолучитьСписокПодходящихКалькуляций(ПараметрыЗапроса);
		Если МассивПодходящихКалькуляций.Найти(ТекД.Калькуляция) = Неопределено Тогда
			ТекД.КалькуляцияНеПодходит = Истина;
			ТекстСообщения = СтрШаблон("По вагону %1 выбрана не подходящая калькуляция", ТекД.НомерВагона);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		Иначе
			ТекД.КалькуляцияНеПодходит = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборНакладныхПоВагонам(НакладныеПоВагонам, ДополнительныеПараметры) Экспорт
	
	Если НакладныеПоВагонам = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	ВыбранныеСтрокиПовагонки = ДополнительныеПараметры.ВыбранныеСтрокиПовагонки;
	
	СтрокиДляДобавленияВСделку = Новый Массив;
	Для Каждого СтрокаПоВагону Из ВыбранныеСтрокиПовагонки Цикл
		
		//Накладная подобралась автоматически
		Если ЗначениеЗаполнено(СтрокаПоВагону.ЖДНакладная) Тогда
			СтрокаДляСделки = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(СтрокаПоВагону);
			СтрокиДляДобавленияВСделку.Добавить(СтрокаДляСделки);
			Продолжить;
		КонецЕсли;
		
		//Накладные подобрались пользователем
		ДобавленаЖДНакладная = Ложь;
		Для Каждого НакладнаяПоВагону Из НакладныеПоВагонам Цикл
			Если СтрокаПоВагону.НомерВагона = НакладнаяПоВагону.Вагон Тогда
				СтрокаПоВагону.ЖДНакладная = НакладнаяПоВагону.ТранспортныйДокумент;
				НомераКонтейнеров = СтрРазделить(НакладнаяПоВагону.НомераКонтейнеров, ";");
				Если НомераКонтейнеров.Количество() > 0 Тогда
					Для Каждого НомерКонтейнера Из НомераКонтейнеров Цикл
						СтрокаДляСделки = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(СтрокаПоВагону);
						СтрокаДляСделки.Вставить("ЖДНакладная", НакладнаяПоВагону.ТранспортныйДокумент);
						СтрокаДляСделки.Вставить("НомерКонтейнера", НомерКонтейнера);
						СтрокиДляДобавленияВСделку.Добавить(СтрокаДляСделки);
						ДобавленаЖДНакладная = Истина;
					КонецЦикла;
				Иначе
					СтрокаДляСделки = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(СтрокаПоВагону);
					СтрокаДляСделки.Вставить("ЖДНакладная", НакладнаяПоВагону.ТранспортныйДокумент);
					СтрокаДляСделки.Вставить("НомерКонтейнера", "");
					СтрокиДляДобавленияВСделку.Добавить(СтрокаДляСделки);
					ДобавленаЖДНакладная = Истина;
				КонецЕсли;				
			КонецЕсли;
		КонецЦикла;
		Если Не ДобавленаЖДНакладная Тогда
			ТекстСообщения = СтрШаблон("Не выбрана ЖД накладная по вагону %1", СтрокаПоВагону.НомерВагона);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;
		
	КонецЦикла;
		
	СоздатьСделкиПродолжение(СтрокиДляДобавленияВСделку, Новый Структура("ИмяТЧ", ДополнительныеПараметры.ИмяТЧ), ДополнительныеПараметры.Сделка);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьСделкиПродолжение(ВыбранныеСтрокиПовагонки, ДополнительныеПараметры, Сделка) Экспорт
	
	СоздатьСделкиНаСервере(ВыбранныеСтрокиПовагонки, Сделка);
	
	Если ДополнительныеПараметры.ИмяТЧ = "ВагоныВПовагонке" Тогда
		текСтрока = Элементы.ВагоныВПовагонке.ТекущаяСтрока;
		ОбновитьВагоныВПовагонке();
		Элементы.ВагоныВПовагонке.ТекущаяСтрока = текСтрока;
	ИначеЕсли ДополнительныеПараметры.ИмяТЧ = "ВагоныВыведены" Тогда
		текСтрока = Элементы.ВагоныВыведены.ТекущаяСтрока;
		ОбновитьВагоныВышедшиеИзПовагонки();
		Элементы.ВагоныВыведены.ТекущаяСтрока = текСтрока;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция УдалитьНайтиНакладные(ДанныеСтроки)
	
	ДанныеНакладных = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТранспортныйДокумент.Ссылка КАК Накладная,
	|	ТранспортныйДокумент.ДатаОтправления
	|ИЗ
	|	Документ.э_Накладная.Вагоны КАК э_НакладнаяВагоны
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	|		ПО э_НакладнаяВагоны.Ссылка = ТранспортныйДокумент.НакладнаяЭТРАН
	|ГДЕ
	|	э_НакладнаяВагоны.НомерВагона = &НомерВагона
	|	И ТранспортныйДокумент.Ссылка.СтанцияНазначения = &СтанцияНазначения
	|	И ТранспортныйДокумент.Ссылка.СтанцияОтправления = &СтанцияОтправления
	|	И НАЧАЛОПЕРИОДА(ТранспортныйДокумент.ДатаОтправления, ДЕНЬ) МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаОтправления, ДЕНЬ, -3) И &ДатаОтправления";
	Запрос.УстановитьПараметр("НомерВагона", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеСтроки.НомерВагона, "Наименование"));
	//Запрос.УстановитьПараметр("СтанцияНазначения", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыПоиска.СтанцияНазначения, "КодЖДСтанции"));
	//Запрос.УстановитьПараметр("СтанцияОтправления", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыПоиска.СтанцияОтправления, "КодЖДСтанции"));
	Запрос.УстановитьПараметр("СтанцияНазначения", ДанныеСтроки.СтанцияНазначения);
	Запрос.УстановитьПараметр("СтанцияОтправления", ДанныеСтроки.СтанцияОтправления);
	Запрос.УстановитьПараметр("ДатаОтправления", ДанныеСтроки.ДатаОтправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Поля = "НомерВагона, ДатаОтправления, Накладная";
	Пока Выборка.Следующий() Цикл
		ДанныеНакладной = Новый Структура(Поля);
		ЗаполнитьЗначенияСвойств(ДанныеНакладной, Выборка);
		ДанныеНакладной.НомерВагона = ДанныеСтроки.НомерВагона;
		ДанныеНакладных.Добавить(ДанныеНакладной);
	КонецЦикла;
	
	Возврат ДанныеНакладных;
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиНакладные(ДанныеСтроки)
	
	ДанныеНакладных = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТранспортныйДокумент.Ссылка КАК Накладная,
	|	ТранспортныйДокумент.ДатаОтправления КАК ДатаОтправления,
	|	э_НакладнаяКонтейнеры.НомерКонтейнера КАК НомерКонтейнера,
	|	ТЕ.Ссылка КАК Контейнер
	|ИЗ
	|	Документ.э_Накладная.Вагоны КАК э_НакладнаяВагоны
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	|		ПО э_НакладнаяВагоны.Ссылка = ТранспортныйДокумент.НакладнаяЭТРАН
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.э_Накладная.Контейнеры КАК э_НакладнаяКонтейнеры
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТЕ КАК ТЕ
	|			ПО э_НакладнаяКонтейнеры.НомерКонтейнера = ТЕ.Наименование
	|		ПО э_НакладнаяВагоны.Ссылка = э_НакладнаяКонтейнеры.Ссылка
	|			И (ВЫБОР
	|				КОГДА э_НакладнаяКонтейнеры.НомерВагонаДляКонтейнерногоПоезда <> 0
	|					ТОГДА э_НакладнаяКонтейнеры.НомерВагонаДляКонтейнерногоПоезда = э_НакладнаяВагоны.НомерСтроки
	|				ИНАЧЕ э_НакладнаяВагоны.НомерСтроки = 1
	|			КОНЕЦ)
	|ГДЕ
	|	э_НакладнаяВагоны.НомерВагона = &НомерВагона
	|	И НЕ э_НакладнаяВагоны.Ссылка.ПометкаУдаления
	//Евросиб Каблов 14.04.2021 ( Ticket#0224665	
	//|	И ТранспортныйДокумент.Ссылка.СтанцияНазначения = &СтанцияНазначения
	//|	И ТранспортныйДокумент.Ссылка.СтанцияОтправления = &СтанцияОтправления 
	|	И (ТранспортныйДокумент.Ссылка.СтанцияНазначения = &СтанцияНазначения
	|				ИЛИ ТранспортныйДокумент.Ссылка.СтанцияНазначения В
	|					(ВЫБРАТЬ
	|						АналогиЛокаций.Локация
	|					ИЗ
	|						регистрСведений.АналогиЛокаций КАК АналогиЛокаций
	|					ГДЕ
	|						АналогиЛокаций.Аналог = &СтанцияНазначения
	|			
	|					ОБЪЕДИНИТЬ ВСЕ
	|			
	|					ВЫБРАТЬ
	|						АналогиЛокаций.Аналог
	|					ИЗ
	|						регистрСведений.АналогиЛокаций КАК АналогиЛокаций
	|					ГДЕ
	|						АналогиЛокаций.Локация = &СтанцияНазначения))
	|	И (ТранспортныйДокумент.Ссылка.СтанцияОтправления = &СтанцияОтправления
	|				ИЛИ ТранспортныйДокумент.Ссылка.СтанцияОтправления В
	|					(ВЫБРАТЬ
	|						АналогиЛокаций.Локация
	|					ИЗ
	|						регистрСведений.АналогиЛокаций КАК АналогиЛокаций
	|					ГДЕ
	|						АналогиЛокаций.Аналог = &СтанцияОтправления
	|			
	|					ОБЪЕДИНИТЬ ВСЕ
	|			
	|					ВЫБРАТЬ
	|						АналогиЛокаций.Аналог
	|					ИЗ
	|						регистрСведений.АналогиЛокаций КАК АналогиЛокаций
	|					ГДЕ
	|						АналогиЛокаций.Локация = &СтанцияОтправления))
	//Евросиб Каблов 14.04.2021 )
	|	И (э_НакладнаяВагоны.Ссылка.ТекущееСостояниеНакладнойДействующийСтатус
	|			ИЛИ э_НакладнаяВагоны.Ссылка.ИсточникНакладной = ЗНАЧЕНИЕ(Перечисление.ИсточникЖДН.ГВЦ))
	|	И ТранспортныйДокумент.ДатаОтправления МЕЖДУ &ДатаНачала И &ДатаОкончания";
	Запрос.УстановитьПараметр("НомерВагона", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеСтроки.НомерВагона, "Наименование"));
	//Запрос.УстановитьПараметр("СтанцияНазначения", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыПоиска.СтанцияНазначения, "КодЖДСтанции"));
	//Запрос.УстановитьПараметр("СтанцияОтправления", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыПоиска.СтанцияОтправления, "КодЖДСтанции"));
	Запрос.УстановитьПараметр("СтанцияНазначения", ДанныеСтроки.СтанцияНазначения);
	Запрос.УстановитьПараметр("СтанцияОтправления", ДанныеСтроки.СтанцияОтправления);
	//Запрос.УстановитьПараметр("ДатаОтправления", ДанныеСтроки.ДатаОтправления);
	ТриДня = 3 * 24 * 3600;
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДанныеСтроки.ДатаОтправления) - ТриДня);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДанныеСтроки.ДатаОтправления));
	Выборка = Запрос.Выполнить().Выбрать();
	Поля = "НомерВагона, ДатаОтправления, Накладная, НомерКонтейнера, Контейнер";
	Пока Выборка.Следующий() Цикл
		ДанныеНакладной = Новый Структура(Поля);
		ЗаполнитьЗначенияСвойств(ДанныеНакладной, Выборка);
		ДанныеНакладной.НомерВагона = ДанныеСтроки.НомерВагона;
		ДанныеНакладных.Добавить(ДанныеНакладной);
	КонецЦикла;
	
	Возврат ДанныеНакладных;
	
КонецФункции

