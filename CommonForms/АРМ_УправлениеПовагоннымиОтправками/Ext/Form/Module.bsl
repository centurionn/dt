Функция ПодготовитьТаблицуПоДокументам(МассивСделокБезЖДН)
	
	ТблВагонов = Новый ТаблицаЗначений;
	
	ТблВагонов.Колонки.Добавить("Вагон",Новый ОписаниеТипов("СправочникСсылка.ТС"));
	ТблВагонов.Колонки.Добавить("ПериодЪ",Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТблВагонов.Колонки.Добавить("Сделка",Новый ОписаниеТипов("ДокументСсылка.Сделка"));
	ТблВагонов.Колонки.Добавить("НевыставленоДней",Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10)));
	ТблВагонов.Колонки.Добавить("ГУИД",Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(36)));
	
	Для Каждого Эл Из МассивСделокБезЖДН Цикл
		НовСтр = ТблВагонов.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,Эл);
	КонецЦикла;
	
	// т.к. в таблице доходов данные уже сгруппированы, то создаем документы согласно этой группировке.
	// строки, в которых указаны реализации с флагом "Выставлен", не используем.
	
	// необходимо добавить группировку по датам ДатаНачалаПериодаПовагонки и ДатаОкончанияПериодаПовагонки, т.к.
	// в сделке этого не сделать (могут быть не созданы ранее документы и в разных сделках будут разные периоды)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВремТЧ.ПериодЪ КАК ПериодЪ,
	               |	ВремТЧ.Сделка КАК Сделка,
	               |	ВремТЧ.Вагон КАК Вагон,
	               |	ВремТЧ.НевыставленоДней КАК НевыставленоДней,
	               |	ВремТЧ.ГУИД КАК ГУИД
	               |ПОМЕСТИТЬ НевыставленоДнейЪ
	               |ИЗ
	               |	&ВремТЧ КАК ВремТЧ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПовагонныеОтправки.Период КАК Период,
	               |	ПовагонныеОтправки.Вагон КАК Вагон,
	               |	ПовагонныеОтправки.СтанцияОтправления КАК СтанцияОтправления,
	               |	НевыставленоДнейЪ.Сделка КАК Сделка,
	               |	ПовагонныеОтправки.Клиент КАК Клиент,
	               |	ПовагонныеОтправки.Договор КАК Договор,
	               |	ПовагонныеОтправки.ПСЦ КАК ПСЦ,
	               |	ПовагонныеОтправки.СтанцияНазначения КАК СтанцияНазначения,
	               |	ПовагонныеОтправки.ДатаПрибытияНаСтанцию КАК ДатаПрибытияНаСтанцию,
	               |	ПовагонныеОтправки.ДатаОтправления КАК ДатаОтправления,
	               |	НевыставленоДнейЪ.ГУИД КАК ГУИД,
	               |	НевыставленоДнейЪ.НевыставленоДней КАК НевыставленоДней
	               |ПОМЕСТИТЬ Повагонка
	               |ИЗ
	               |	НевыставленоДнейЪ КАК НевыставленоДнейЪ
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПовагонныеОтправки КАК ПовагонныеОтправки
	               |		ПО НевыставленоДнейЪ.ПериодЪ = ПовагонныеОтправки.ДатаОтправления
	               |			И НевыставленоДнейЪ.Вагон = ПовагонныеОтправки.Вагон
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СделкаДоходы.Ссылка КАК Сделка,
	               |	СделкаДоходы.НомерСтроки КАК НомерСтроки,
	               |	СделкаДоходы.Клиент КАК Клиент,
	               |	СделкаДоходы.Договор КАК Договор,
	               |	СделкаДоходы.Услуга КАК Услуга,
	               |	СделкаДоходы.Калькуляция КАК Калькуляция,
	               |	СделкаДоходы.Себестоимость КАК Себестоимость,
	               |	СделкаДоходы.Вознаграждение КАК Вознаграждение,
	               |	СделкаДоходы.Ставка КАК Ставка,
	               |	СделкаДоходы.Количество КАК Количество,
	               |	СделкаДоходы.СебестоимостьИтого КАК СебестоимостьИтого,
	               |	СделкаДоходы.ВознаграждениеИтого КАК ВознаграждениеИтого,
	               |	СделкаДоходы.СтавкаИтого КАК СтавкаИтого,
	               |	СделкаДоходы.Рентабельность КАК Рентабельность,
	               |	СделкаДоходы.СтавкаНДС КАК СтавкаНДС,
	               |	СделкаДоходы.СуммаНДС КАК СуммаНДС,
	               |	СделкаДоходы.НДСВключенВСтоимость КАК НДСВключенВСтоимость,
	               |	СделкаДоходы.СуммаИтого КАК СуммаИтого,
	               |	СделкаДоходы.ГУИД КАК ГУИД,
	               |	СделкаДоходы.ТипВагонов КАК ТипВагонов,
	               |	СделкаДоходы.ТипКТК КАК ТипКТК,
	               |	СделкаДоходы.Груз КАК Груз,
	               |	СделкаДоходы.РазмерКТК КАК РазмерКТК,
	               |	СделкаДоходы.ПериодВО КАК ПериодВО,
	               |	СделкаДоходы.УчДокумент КАК УчДокумент,
	               |	СделкаДоходы.Валюта КАК Валюта,
	               |	СделкаДоходы.Перевыставляемая КАК Перевыставляемая,
	               |	СделкаДоходы.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	               |	СделкаДоходы.РеестрКлиента КАК РеестрКлиента,
	               |	СделкаДоходы.ПСЦ КАК ПСЦ,
	               |	СделкаДоходы.Подсыл КАК Подсыл,
	               |	СделкаДоходы.Комментарий КАК Комментарий,
	               |	СделкаДоходы.ДатаНачалаПериодаПовагонкиУчДок КАК ДатаНачалаПериодаПовагонкиУчДок,
	               |	СделкаДоходы.ДатаОкончанияПериодаПовагонкиУчДок КАК ДатаОкончанияПериодаПовагонкиУчДок,
	               |	СделкаДоходы.ОтправлениеУчДокумента КАК ОтправлениеУчДокумента,
	               |	СделкаДоходы.НазначениеУчДокумента КАК НазначениеУчДокумента
	               |ИЗ
	               |	Повагонка КАК Повагонка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.Доходы КАК СделкаДоходы
	               |		ПО Повагонка.Сделка = СделкаДоходы.Ссылка
	               |			И Повагонка.ГУИД = СделкаДоходы.ГУИД";
	
	Запрос.УстановитьПараметр("ВремТЧ",ТблВагонов);
	
	ТЗВспомогательная = Запрос.Выполнить().Выгрузить();
	
	ТЗВспомогательная.Колонки.Добавить("СписокДокументов");
	
	Для каждого Стр Из ТЗВспомогательная Цикл 

		Перевыставление = Ложь;
		ПрямыеПродажи = Ложь;
		УчДокумент =  Неопределено;
		
		СписокДокументов = Новый Массив;
		
		Если Стр.Перевыставляемая Тогда
			УчДокумент = ?(ЗначениеЗаполнено(Стр.УчДокумент),Стр.УчДокумент,НайтиОтчет(Стр.Сделка, Стр.ГУИД));
			Перевыставление = Истина;
		Иначе
			//Евросиб СубботинВ #84453 02.07.2024 Начало // переделал на вызов аналогичной процедуры из общего модуля + перешел с поиском сделки на сделку из ТЧ
            //УчДокумент = ?(ЗначениеЗаполнено(Стр.УчДокумент),Стр.УчДокумент,НайтиРеализацию(Стр.Сделка, Стр.ГУИД));
			УчДокумент = ?(ЗначениеЗаполнено(Стр.УчДокумент),Стр.УчДокумент,РаботаСПовагоннымиОтправками.НайтиРеализацию(Стр.Сделка, Стр.ГУИД));
			//Евросиб СубботинВ #84453 02.07.2024 Конец

			ПрямыеПродажи = Истина;
		КонецЕсли;
		
		Если Перевыставление Тогда
			//Отчет
			ЭлементМассива = Новый Структура;
			ЭлементМассива.Вставить("ВидДокумента", "Отчет комитенту о закупках");
			ЭлементМассива.Вставить("Документ", УчДокумент);
			СписокДокументов.Добавить(ЭлементМассива);
			//Счет
			ЭлементМассива = Новый Структура;
			Счет = ?(ЗначениеЗаполнено(УчДокумент),НайтиСчетНаОплату(УчДокумент),Неопределено);
			ЭлементМассива.Вставить("ВидДокумента", "Счет покупателю");
			ЭлементМассива.Вставить("Документ", Счет);
			СписокДокументов.Добавить(ЭлементМассива);
			//СчФ
			ЭлементМассива = Новый Структура;
			СчФ = ?(ЗначениеЗаполнено(УчДокумент),БухгалтерскийУчетОбщиеПроцедурыСервер.НайтиПодчиненныйСчетФактуру(УчДокумент,"СчетФактураВыданный"),Неопределено);
			ЭлементМассива.Вставить("ВидДокумента", "Счет-фактура выданный");
			ЭлементМассива.Вставить("Документ", СчФ);
			СписокДокументов.Добавить(ЭлементМассива);

		КонецЕсли;
		Если ПрямыеПродажи Тогда
			//Акт
			ЭлементМассива = Новый Структура;
			ЭлементМассива.Вставить("ВидДокумента", "Реализация товаров и услуг");
			ЭлементМассива.Вставить("Документ", УчДокумент);
			СписокДокументов.Добавить(ЭлементМассива);
			//Счет
			ЭлементМассива = Новый Структура;
			Счет = ?(ЗначениеЗаполнено(УчДокумент),НайтиСчетНаОплатуПоРеализации(УчДокумент),Неопределено);
			ЭлементМассива.Вставить("ВидДокумента", "Счет покупателю");
			ЭлементМассива.Вставить("Документ", Счет);
			СписокДокументов.Добавить(ЭлементМассива);
			//СчФ
			ЭлементМассива = Новый Структура;
			СчФ = ?(ЗначениеЗаполнено(УчДокумент),БухгалтерскийУчетОбщиеПроцедурыСервер.НайтиПодчиненныйСчетФактуру(УчДокумент,"СчетФактураВыданный"),Неопределено);
			ЭлементМассива.Вставить("ВидДокумента", "Счет-фактура выданный");
			ЭлементМассива.Вставить("Документ", СчФ);
			СписокДокументов.Добавить(ЭлементМассива);
			
		КонецЕсли;
		
		Стр.СписокДокументов = СписокДокументов;
		
	КонецЦикла;
	
	
	ИтоговыйМассив = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТЗВспомогательная);
	
	Возврат ИтоговыйМассив;
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиОтчет(ОбъектСсылка, СтрГУИД)
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ОбъектСсылка);
