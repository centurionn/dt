&НаКлиенте
Процедура ПодходВагоновПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если Элемент.ТекущийЭлемент.Имя = "ПодходВагоновОтметка" Тогда
		Возврат;	
	КонецЕсли; 
	ТекД = Элементы.ПодходВагонов.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПроверкаКалькуляцииИЗаявки(ТекД,Ложь);
	
	СтруктураДанныхСтроки = Новый Структура;
	Для Каждого ЭлемСп Из СписокКолонокВагоныВПовагонке Цикл
		Попытка
			СтруктураДанныхСтроки.Вставить(ЭлемСп.Значение,ТекД[ЭлемСп.Значение]);
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	ЗаявкаИзменилась = Ложь;
	СохранитьДанныеВРСПовагонки(СтруктураДанныхСтроки,Ложь,ЗаявкаИзменилась,Истина,Неопределено);
	
	// записать данные в заявку. перезаписываем только в том случае, если заявка изменилась
	Если ЗначениеЗаполнено(ТекД.Заявка) И ЗаявкаИзменилась Тогда
		МассивЗаявокКЗаписи = Новый Массив;
		МассивЗаявокКЗаписи.Добавить(СтруктураДанныхСтроки);
		Если МассивЗаявокКЗаписи.Количество()>0 Тогда
			Если Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "ГруппаВагоныВПовагонке" Тогда
				Фактическая = Истина;
			Иначе
				Фактическая = Ложь;
			КонецЕсли;
			ЗаписатьДанныеПоВагонуВЗаявку(МассивЗаявокКЗаписи,Фактическая);
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьВагоныВПовагонке();
	//ОбновитьВагоныВПодходе();
	
КонецПроцедуры

