	               |	ДислокацияВагоновСрезПоследних.СтанцияОперации КАК СтанцияОперации,
	               |	ДислокацияВагоновСрезПоследних.СтанцияНазначения КАК СтанцияНазначения,
	               |	ДислокацияВагоновСрезПоследних.СтанцияОтправления КАК СтанцияОтправления,
	               |	ДислокацияВагоновСрезПоследних.ДатаПрибытияНаСтанцию КАК ДатаПрибытияНаСтанцию,
	               |	ДислокацияВагоновСрезПоследних.ПростойНаСтанции КАК ПростойНаСтанции
	               |ПОМЕСТИТЬ ДислокацияЪ
	               |ИЗ
	               |	РегистрСведений.ДислокацияВагонов.СрезПоследних КАК ДислокацияВагоновСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПериодДислокации КАК ПериодДислокации
	               |		ПО ДислокацияВагоновСрезПоследних.Период = ПериодДислокации.Период
	               |			И ДислокацияВагоновСрезПоследних.Вагон = ПериодДислокации.Вагон
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВагоныПодход.НомерВагона КАК НомерВагона,
	               |	ДислокацияЪ.СтанцияОперации КАК ТекущаяСтанцияОперации,
	               |	ДислокацияЪ.ОперацияСВагоном КАК ОперацияСВагоном,
	               |	ДислокацияЪ.Груженый КАК Груженый,
	               |	РасстоянияМеждуЛокациями.РасстояниеКМ КАК РасстояниеДоСтанцииНазначения,
	               |	ВагоныПодход.СобытиеПереводаВПовагонку КАК СобытиеПереводаВПовагонку,
	               |	ДислокацияЪ.Период КАК ДатаОперации,
	               |	ВагоныПодход.МодельВагона КАК МодельВагона,
	               |	ВагоныПодход.Грузоподъемность КАК Грузоподъемность,
	               |	ВагоныПодход.ДатаСледующегоРемонта КАК ДатаСледующегоРемонта,
	               |	ВагоныПодход.ТипВагонаСсылка КАК ТипВагонаСсылка,
	               |	ВагоныПодход.Клиент КАК Клиент,
	               |	ВагоныПодход.Договор КАК Договор,
	               |	ВагоныПодход.Заявка КАК Заявка,
	               |	ВагоныПодход.ПСЦ КАК ПСЦ,
	               |	ВагоныПодход.Комментарий КАК Комментарий,
	               |	ВагоныПодход.ДатаПомещенияВРежимПовагонки КАК ДатаПомещенияВРежимПовагонки,
	               |	ВагоныПодход.РегионОтправления КАК РегионОтправления,
	               |	ВагоныПодход.РегионВозврата КАК РегионВозврата,
	               |	ВагоныПодход.ЗаявкаНеПодходит КАК ЗаявкаНеПодходит,
	               |	ВагоныПодход.ДатаПередачиВПользование КАК ДатаПередачиВПользование,
	               |	ВагоныПодход.Калькуляция КАК Калькуляция,
	               |	ВагоныПодход.НДС КАК НДС,
	               |	ВагоныПодход.ПереводВНРП КАК ПереводВНРП,
	               |	ВагоныПодход.ВыводИзНРП КАК ВыводИзНРП,
	               |	ВагоныПодход.НомерВагона.ТипТС.Родитель КАК РазмерВагона,
	               |	ВагоныПодход.ЦФО КАК ЦФО
	               |ИЗ
	               |	ВагоныПодход КАК ВагоныПодход
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДислокацияЪ КАК ДислокацияЪ
	               |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасстоянияМеждуЛокациями КАК РасстоянияМеждуЛокациями
	               |			ПО ДислокацияЪ.СтанцияОперации = РасстоянияМеждуЛокациями.Локация1
	               |				И ДислокацияЪ.СтанцияНазначения = РасстоянияМеждуЛокациями.Локация2
	               |		ПО ВагоныПодход.НомерВагона = ДислокацияЪ.Вагон";
	
	ДополнительныеУсловия = Новый Массив;
	
	Если ЗначениеЗаполнено(Отборы.ЦФО) Тогда
		Запрос.УстановитьПараметр("ЦФО", Отборы.ЦФО);
		ДополнительныеУсловия.Добавить("ВагоныЗапланированныеКПовагонке.ЦФО = &ЦФО");		
	КонецЕсли;
	
	Если Отборы.ОтборТипСтавки = "Посуточная ставка" Тогда		
		ДополнительныеУсловия.Добавить("ВагоныЗапланированныеКПовагонке.ПСЦ.ОплатаПользованияВагоном = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыПользованияВагоном.Посуточно)");
	ИначеЕсли Отборы.ОтборТипСтавки = "Ставка за вагон" Тогда
		ДополнительныеУсловия.Добавить("ВагоныЗапланированныеКПовагонке.Калькуляция.ТипКалькуляции В (ЗНАЧЕНИЕ(Перечисление.ТипыКалькуляций.ПредоставлениеПСБезТарифаГруженого), ЗНАЧЕНИЕ(Перечисление.ТипыКалькуляций.ПредоставлениеПССТарифом))");
	ИначеЕсли Отборы.ОтборТипСтавки = "Ставка за КТК" Тогда
		ДополнительныеУсловия.Добавить("ВагоныЗапланированныеКПовагонке.Калькуляция.ТипКалькуляции = ЗНАЧЕНИЕ(Перечисление.ТипыКалькуляций.Мультимодальная)");
	КонецЕсли;
	
	Если Отборы.ОтборПоКлиентам Тогда
		Запрос.УстановитьПараметр("Клиенты", Отборы.Клиенты);
		ДополнительныеУсловия.Добавить("ВагоныЗапланированныеКПовагонке.Клиент В(&Клиенты)");
	КонецЕсли;
	
	Если ДополнительныеУсловия.Количество() > 0 Тогда
		ТекстУсловий = СтрСоединить(ДополнительныеУсловия, Символы.ПС + "	И ");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//ДополнительныеУсловия", "ГДЕ " + ТекстУсловий)
	КонецЕсли;

	МассивОтвета = Новый Массив;
	ОтветВыполнить = Запрос.Выполнить();
	
	ОписаниеПолучившейсяСтруктуры = "";
	Для каждого Колонка из ОтветВыполнить.Колонки Цикл
		ОписаниеПолучившейсяСтруктуры = ОписаниеПолучившейсяСтруктуры + ?(ОписаниеПолучившейсяСтруктуры = "", "", ",") + Колонка.Имя;
	КонецЦикла;
	
	Ответ = ОтветВыполнить.Выбрать();
	Пока Ответ.Следующий() Цикл
		ЭлементСтруктура = Новый Структура(ОписаниеПолучившейсяСтруктуры);
		ЗаполнитьЗначенияСвойств(ЭлементСтруктура, Ответ);
		МассивОтвета.Добавить(ЭлементСтруктура);
	КонецЦикла;

	Возврат МассивОтвета;
КонецФункции

&НаСервереБезКонтекста
Процедура СохранитьДанныеВРСПовагонки(СтруктураДанныхСтроки,ВыводИзПовагонки,ЗаявкаИзменилась,ЭтоПодход,ВходВРейс)
	
	ЗаявкаИзменилась = Ложь;
	Если ЭтоПодход Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ВагоныЗапланированныеКПовагонке.Вагон КАК Вагон,
		               |	ВагоныЗапланированныеКПовагонке.Заявка КАК Заявка
		               |ИЗ
		               |	РегистрСведений.ВагоныЗапланированныеКПовагонке КАК ВагоныЗапланированныеКПовагонке
		               |ГДЕ
		               |	ВагоныЗапланированныеКПовагонке.Вагон = &Вагон";
		
		Запрос.УстановитьПараметр("Вагон", СтруктураДанныхСтроки.НомерВагона);
		ИмяРегистра = "ВагоныЗапланированныеКПовагонке";
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ПовагонныеОтправкиСрезПоследних.Период КАК Период,
		               |	ПовагонныеОтправкиСрезПоследних.Вагон КАК Вагон,
		               |	ПовагонныеОтправкиСрезПоследних.Заявка КАК Заявка
		               |ИЗ
		               |	РегистрСведений.ПовагонныеОтправки.СрезПоследних(
		               |			,
		               |			Вагон = &Вагон
		               |				И Период = &Период) КАК ПовагонныеОтправкиСрезПоследних";
		
		Запрос.УстановитьПараметр("Вагон", СтруктураДанныхСтроки.НомерВагона);
		Запрос.УстановитьПараметр("Период", СтруктураДанныхСтроки.ДатаПомещенияВРежимПовагонки);
		ИмяРегистра = "ПовагонныеОтправки";
	КонецЕсли;
	
	ДанныеСтрокиНДС = Неопределено;
	Если СтруктураДанныхСтроки.Свойство("НДС", ДанныеСтрокиНДС) И Не ЗначениеЗаполнено(ДанныеСтрокиНДС) Тогда
		
		//Евросиб Каблов 10.02.2021 ( Ticket#0213432
		//ДанныеСтрокиПСЦ = Неопределено;
		//Если СтруктураДанныхСтроки.Свойство("ПСЦ", ДанныеСтрокиПСЦ) И ЗначениеЗаполнено(ДанныеСтрокиПСЦ) Тогда
		//	СтруктураДанныхСтроки.НДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеСтрокиПСЦ, "СтавкаНДС");
		//КонецЕсли;
		//
		//ДанныеСтрокиКалькуляция = Неопределено;
		//Если Не ЗначениеЗаполнено(СтруктураДанныхСтроки.НДС) И СтруктураДанныхСтроки.Свойство("Калькуляция", ДанныеСтрокиКалькуляция) И ЗначениеЗаполнено(ДанныеСтрокиКалькуляция) Тогда
		//	СтруктураДанныхСтроки.НДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеСтрокиКалькуляция, "СтавкаНДС");
		//КонецЕсли;
		ДанныеСтрокиКалькуляция = Неопределено;
		Если СтруктураДанныхСтроки.Свойство("Калькуляция", ДанныеСтрокиКалькуляция) И ЗначениеЗаполнено(ДанныеСтрокиКалькуляция) Тогда
			СтруктураДанныхСтроки.НДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеСтрокиКалькуляция, "СтавкаНДС");
		КонецЕсли;
		//Евросиб Каблов 10.02.2021 )
		
	КонецЕсли;
	
	РЗ = Запрос.Выполнить();
	Если НЕ РЗ.Пустой() Тогда
		Ответ = РЗ.Выбрать();
		// если запись есть - изменить ее
		Если Ответ.Следующий() Тогда
			ТекЗапись = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(ТекЗапись,Ответ);
			ТекЗапись2 = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(ТекЗапись2, ТекЗапись);
			
			ТекЗапись.Прочитать();
			Если НЕ ТекЗапись.Выбран() Тогда
				ЗаполнитьЗначенияСвойств(ТекЗапись, ТекЗапись2);
			КонецЕсли;
			
			ДанныеСтрокиЗаявка = Неопределено;
			Если СтруктураДанныхСтроки.Свойство("Заявка", ДанныеСтрокиЗаявка) И НЕ Ответ.Заявка = ДанныеСтрокиЗаявка Тогда
				ЗаявкаИзменилась = Истина;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(ТекЗапись,СтруктураДанныхСтроки);
			
			Если ВыводИзПовагонки Тогда
				ТекЗапись.ВыводИзПовагонки = ТекущаяДата();
				ТекЗапись.СобытиеВыводаИзПовагонки = Перечисления.СобытияВыводаИзПовагонки.Вручную;
				ТекЗапись.СтанцияВывода = СтруктураДанныхСтроки.ТекущаяДислокацияПоСлежению;
				ТекЗапись.ОтветственныйУдалилДанные = Пользователи.ТекущийПользователь();
			КонецЕсли;
			
			// если вагон ушел в ремонт, то очистить у него дату передачи в пользование.
			Если ЗначениеЗаполнено(ТекЗапись.ПереводВНРП) И 
				НЕ ЗначениеЗаполнено(ТекЗапись.ВыводИзНРП) Тогда
				
				ТекЗапись.ДатаПередачиВПользование = "";
				// если вагон вернулся из ремонта, заполнить ему дату передачи в пользование как дату вывода из НРП
			ИначеЕсли ЗначениеЗаполнено(ТекЗапись.ПереводВНРП) И 
				ЗначениеЗаполнено(ТекЗапись.ВыводИзНРП) И
				НЕ ЗначениеЗаполнено(ТекЗапись.ДатаПередачиВПользование) Тогда
				
				ТекЗапись.ДатаПередачиВПользование = ТекЗапись.ВыводИзНРП;
			КонецЕсли;
			
			Если НЕ ИмяРегистра = "ПовагонныеОтправки" Тогда
				// если вагон находится в плановом регистре, только что вернулся из ремонта и его станция
				// операции находится в регионе отправления, то перенести данные из планового в фактический
				РегионОтправленияИерархМассив = Локации_сервер.ПолучитьМассивРодителей(СтруктураДанныхСтроки.ТекущаяСтанцияОперации,Истина);
				
				Если ЗначениеЗаполнено(ТекЗапись.ПереводВНРП) И 
					ЗначениеЗаполнено(ТекЗапись.ВыводИзНРП) И
					НЕ РегионОтправленияИерархМассив.Найти(ТекЗапись.РегионОтправления) = Неопределено Тогда
					
					ТекЗапись3 = РегистрыСведений.ПовагонныеОтправки.СоздатьМенеджерЗаписи();
					
					ЗаполнитьЗначенияСвойств(ТекЗапись3,ТекЗапись);
					ТекЗапись3.Период = ТекЗапись.ВыводИзНРП;
					ТекЗапись3.Записать();
					// Удаление из регистра ВагоныЗапланированныеКПовагонке.
					ТекЗапись.Удалить();
					
				Иначе
					ТекЗапись.Записать();
						
				КонецЕсли;
			Иначе
				ТекЗапись.Записать();
			КонецЕсли;
			
		КонецЕсли;
	Иначе
		// если записи нет, создать новую
		ТекЗапись = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(ТекЗапись,СтруктураДанныхСтроки);
		ТекЗапись.Вагон = СтруктураДанныхСтроки.НомерВагона;
		Если ИмяРегистра = "ПовагонныеОтправки" Тогда
			
			Если НЕ ЗначениеЗаполнено(СтруктураДанныхСтроки.ДатаПередачиВПользование) Тогда
				ПередачаВПользование = ТекущаяДата();
			Иначе
				ПередачаВПользование = СтруктураДанныхСтроки.ДатаПередачиВПользование;
			КонецЕсли;
			
			
			ТекЗапись.Период = СтруктураДанныхСтроки.ДатаПомещенияВРежимПовагонки;
			ТекЗапись.ОтветственныйВнесДанные = Пользователи.ТекущийПользователь();
			// получить данные по вагону из дислокации
			Если ВходВРейс = Ложь ИЛИ ВходВРейс = Неопределено Тогда
				ЗапросДисл = Новый Запрос;
				// сначала выберем дату максимально приближенную к указанной
				
				ЗапросДисл.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
				                   |	ДислокацияВагонов.Период КАК Период,
				                   |	ДислокацияВагонов.Вагон КАК Вагон
				                   |ИЗ
				                   |	РегистрСведений.ДислокацияВагонов КАК ДислокацияВагонов
				                   |ГДЕ
				                   |	ДислокацияВагонов.Вагон = &Вагон
				                   |	И ДислокацияВагонов.Период <= &Период
				                   |
				                   |УПОРЯДОЧИТЬ ПО
				                   |	Период УБЫВ";
				ЗапросДисл.УстановитьПараметр("Вагон",СтруктураДанныхСтроки.НомерВагона);
				ЗапросДисл.УстановитьПараметр("Период",ПередачаВПользование);
				Ответ = ЗапросДисл.Выполнить().Выбрать();
				Если Ответ.Следующий() Тогда
					ПериодОтбор = Ответ.Период;	
				
				
					ЗапросДисл.Текст = "ВЫБРАТЬ
					                   |	МИНИМУМ(ДислокацияВагонов.Период) КАК Период,
					                   |	ДислокацияВагонов.Вагон КАК Вагон
					                   |ПОМЕСТИТЬ МаксПериод
					                   |ИЗ
					                   |	РегистрСведений.ДислокацияВагонов КАК ДислокацияВагонов
					                   |ГДЕ
					                   |	ДислокацияВагонов.Вагон = &Вагон
					                   |	И ДислокацияВагонов.Период = &Период
					                   |
					                   |СГРУППИРОВАТЬ ПО
					                   |	ДислокацияВагонов.Вагон
					                   |;
					                   |
					                   |////////////////////////////////////////////////////////////////////////////////
					                   |ВЫБРАТЬ
					                   |	МИНИМУМ(ДислокацияВагонов.Период) КАК Период,
					                   |	ДислокацияВагонов.Вагон КАК Вагон,
					                   |	МИНИМУМ(ДислокацияВагонов.ОперацияСВагоном) КАК ОперацияСВагоном
					                   |ПОМЕСТИТЬ ОперВаг
					                   |ИЗ
					                   |	МаксПериод КАК МаксПериод
					                   |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДислокацияВагонов КАК ДислокацияВагонов
					                   |		ПО МаксПериод.Период = ДислокацияВагонов.Период
					                   |			И МаксПериод.Вагон = ДислокацияВагонов.Вагон
					                   |
					                   |СГРУППИРОВАТЬ ПО
					                   |	ДислокацияВагонов.Вагон
					                   |;
					                   |
					                   |////////////////////////////////////////////////////////////////////////////////
					                   |ВЫБРАТЬ
					                   |	ДислокацияВагонов.Период КАК Период2,
					                   |	ДислокацияВагонов.Вагон КАК Вагон,
					                   |	ДислокацияВагонов.ОперацияСВагоном КАК ОперацияСВагоном,
					                   |	ДислокацияВагонов.РабочийПарк КАК РабочийПарк,
					                   |	ДислокацияВагонов.Груженый КАК Груженый,
					                   |	ДислокацияВагонов.НомерПоезда КАК НомерПоезда,
					                   |	ДислокацияВагонов.ИндексПоезда КАК ИндексПоезда,
					                   |	ДислокацияВагонов.КодГрузоотправителя КАК КодГрузоотправителя,
					                   |	ДислокацияВагонов.КодГрузополучателя КАК КодГрузополучателя,
					                   |	ДислокацияВагонов.Собственник КАК Собственник,
					                   |	ДислокацияВагонов.КодГрузаЕТСНГ КАК КодГрузаЕТСНГ,
					                   |	ДислокацияВагонов.Груз КАК Груз,
					                   |	ДислокацияВагонов.ВесГруза КАК ВесГруза,
					                   |	ДислокацияВагонов.СтанцияОперации КАК СтанцияОперации,
					                   |	ДислокацияВагонов.СтанцияНазначения КАК СтанцияНазначения,
					                   |	ДислокацияВагонов.СтанцияОтправления КАК СтанцияОтправления,
					                   |	ДислокацияВагонов.ДатаПрибытияНаСтанцию КАК ДатаПрибытияНаСтанцию,
					                   |	ДислокацияВагонов.ПростойНаСтанции КАК ПростойНаСтанции
					                   |ИЗ
					                   |	РегистрСведений.ДислокацияВагонов КАК ДислокацияВагонов
					                   |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОперВаг КАК ОперВаг
					                   |		ПО ДислокацияВагонов.Период = ОперВаг.Период
					                   |			И ДислокацияВагонов.Вагон = ОперВаг.Вагон
					                   |			И ДислокацияВагонов.ОперацияСВагоном = ОперВаг.ОперацияСВагоном";
					ЗапросДисл.УстановитьПараметр("Вагон",СтруктураДанныхСтроки.НомерВагона);
					ЗапросДисл.УстановитьПараметр("Период",ПериодОтбор);
					ОтветДисл = ЗапросДисл.Выполнить().Выбрать();
					Если ОтветДисл.Следующий() Тогда
						ЗаполнитьЗначенияСвойств(ТекЗапись,ОтветДисл);
						
						//Если ВходВРейс = Ложь Тогда
						//	ТекЗапись.СтанцияОтправления = ОтветДисл.СтанцияОперации;
						//	ТекЗапись.ДатаПрибытияНаСтанцию = ОтветДисл.ДатаПрибытияНаСтанцию;
						//КонецЕсли;
						ТекЗапись.ДатаПередачиВПользование = ОтветДисл.ДатаПрибытияНаСтанцию;
					КонецЕсли;
				КонецЕсли;	
			Иначе
				ЗапросДисл = Новый Запрос;
				ЗапросДисл.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
				               |	ДислокацияВагоновСрезПоследних.Период КАК Период,
				               |	ДислокацияВагоновСрезПоследних.Вагон КАК Вагон,
				               |	ДислокацияВагоновСрезПоследних.ОперацияСВагоном КАК ОперацияСВагоном,
				               |	ДислокацияВагоновСрезПоследних.РабочийПарк КАК РабочийПарк,
				               |	ДислокацияВагоновСрезПоследних.Груженый КАК Груженый,
				               |	ДислокацияВагоновСрезПоследних.НомерПоезда КАК НомерПоезда,
				               |	ДислокацияВагоновСрезПоследних.ИндексПоезда КАК ИндексПоезда,
				               |	ДислокацияВагоновСрезПоследних.КодГрузоотправителя КАК КодГрузоотправителя,
				               |	ДислокацияВагоновСрезПоследних.КодГрузополучателя КАК КодГрузополучателя,
				               |	ДислокацияВагоновСрезПоследних.Собственник КАК Собственник,
				               |	ДислокацияВагоновСрезПоследних.КодГрузаЕТСНГ КАК КодГрузаЕТСНГ,
				               |	ДислокацияВагоновСрезПоследних.Груз КАК Груз,
				               |	ДислокацияВагоновСрезПоследних.ВесГруза КАК ВесГруза,
				               |	ДислокацияВагоновСрезПоследних.СтанцияОперации КАК СтанцияОперации,
				               |	ДислокацияВагоновСрезПоследних.СтанцияНазначения КАК СтанцияНазначения,
				               |	ДислокацияВагоновСрезПоследних.СтанцияОтправления КАК СтанцияОтправления,
				               |	ДислокацияВагоновСрезПоследних.ДатаПрибытияНаСтанцию КАК ДатаПрибытияНаСтанцию,
				               |	ДислокацияВагоновСрезПоследних.ПростойНаСтанции КАК ПростойНаСтанции,
				               |	ДислокацияВагоновСрезПоследних.ДатаОтправленияСоСтанции КАК ДатаОтправленияСоСтанции,
				               |	ДислокацияВагоновСрезПоследних.ОстаточноеРасстояниеКМ КАК ОстаточноеРасстояниеКМ
				               |ИЗ
				               |	РегистрСведений.ДислокацияВагонов.СрезПоследних(, Вагон = &Вагон) КАК ДислокацияВагоновСрезПоследних
				               |ГДЕ
				               |	ДислокацияВагоновСрезПоследних.Период <= &Период
				               |	И ДислокацияВагоновСрезПоследних.СтанцияОперации = ДислокацияВагоновСрезПоследних.СтанцияОтправления
				               |
				               |УПОРЯДОЧИТЬ ПО
				               |	Период УБЫВ";
				ЗапросДисл.УстановитьПараметр("Вагон",СтруктураДанныхСтроки.НомерВагона);
				ЗапросДисл.УстановитьПараметр("Период",ПередачаВПользование);
				
				ОтветДисл = ЗапросДисл.Выполнить().Выбрать();
				Если ОтветДисл.Следующий() Тогда
					ЗаполнитьЗначенияСвойств(ТекЗапись,ОтветДисл);
					ТекЗапись.ДатаПередачиВПользование = ОтветДисл.ДатаПрибытияНаСтанцию;
					ТекЗапись.Период = ОтветДисл.ДатаПрибытияНаСтанцию;
				КонецЕсли;
				
				
			КонецЕсли;
		
		КонецЕсли;
		
		Если СтруктураДанныхСтроки.Свойство("Заявка") И ЗначениеЗаполнено(СтруктураДанныхСтроки.Заявка) Тогда
			ЗаявкаИзменилась = Истина;
		КонецЕсли;
				
		ТекЗапись.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВагоныВПовагонкеПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если Элемент.ТекущийЭлемент.Имя = "ВагоныВПовагонкеПометка" Тогда
		Возврат;	
	КонецЕсли; 
	ТекД = Элементы.ВагоныВПовагонке.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	
	ПроверкаКалькуляцииИЗаявки(ТекД,Истина);
	
	СтруктураДанныхСтроки = Новый Структура;
	Для Каждого ЭлемСп Из СписокКолонокВагоныВПовагонке Цикл
		Попытка
			СтруктураДанныхСтроки.Вставить(ЭлемСп.Значение,ТекД[ЭлемСп.Значение]);
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	ЗаявкаИзменилась = Ложь;
	СохранитьДанныеВРСПовагонки(СтруктураДанныхСтроки,Ложь,ЗаявкаИзменилась,Ложь,Неопределено);
	
	ЗаполнитьЗначенияСвойств(ТекД, СтруктураДанныхСтроки);
	
	// записать данные в заявку. перезаписываем только в том случае, если заявка изменилась
	Если ЗначениеЗаполнено(ТекД.Заявка) И ЗаявкаИзменилась Тогда
		МассивЗаявокКЗаписи = Новый Массив;
		МассивЗаявокКЗаписи.Добавить(СтруктураДанныхСтроки);
		Если МассивЗаявокКЗаписи.Количество()>0 Тогда
			Фактическая = Истина;
			ЗаписатьДанныеПоВагонуВЗаявку(МассивЗаявокКЗаписи,Фактическая);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаКалькуляцииИЗаявки(ТекД,Фактическая)
	
	Если ЗначениеЗаполнено(ТекД.Калькуляция) Тогда
		// проверка калькуляции
		ПараметрыЗапроса = Новый СТруктура;
		Если Фактическая Тогда
			//ПараметрыЗапроса.Вставить("ПунктОтправления",ТекД.СтанцияПодачи);
			ПараметрыЗапроса.Вставить("ПунктОтправления",ТекД.СтанцияОтправления);
			ПараметрыЗапроса.Вставить("ПунктНазначения",ТекД.СтанцияНазначения);
			//ПараметрыЗапроса.Вставить("ПунктНазначения",Неопределено);
		Иначе
			ПараметрыЗапроса.Вставить("ПунктОтправления",ТекД.РегионОтправления);
			ПараметрыЗапроса.Вставить("ПунктНазначения",ТекД.РегионВозврата);
		КонецЕсли;
		
		ПараметрыЗапроса.Вставить("НДС",ТекД.НДС);
		ПараметрыЗапроса.Вставить("Вагон",ТекД.НомерВагона);
		//Евросиб Каблов 07.04.2021 (
		ПараметрыЗапроса.Вставить("ПСЦ", ТекД.ПСЦ);
		//Евросиб Каблов 07.04.2021 )
		
		МассивПодходящихКалькуляций = ПолучитьСписокПодходящихКалькуляций(ПараметрыЗапроса);
		Если МассивПодходящихКалькуляций.Найти(ТекД.Калькуляция) = Неопределено Тогда
			ТекД.КалькуляцияНеПодходит = Истина;
		Иначе
			ТекД.КалькуляцияНеПодходит = Ложь;
		КонецЕсли;
	Иначе
		ТекД.КалькуляцияНеПодходит = Ложь;
	КонецЕсли;
	
	// проверка на подходящую заявку только в фактической части, т.к. в подходе еще не известны данные для создания рейса
	Если Фактическая И ЗначениеЗаполнено(ТекД.Заявка) Тогда
		// проверка заявки
		ПараметрыЗапроса = Новый СТруктура;
		Если Фактическая Тогда
			//ПараметрыЗапроса.Вставить("ПунктОтправления",ТекД.СтанцияПодачи);
			ПараметрыЗапроса.Вставить("ПунктОтправления",ТекД.СтанцияОтправления);
			//ПараметрыЗапроса.Вставить("ПунктНазначения",ТекД.СтанцияНазначения);
			ПараметрыЗапроса.Вставить("ПунктНазначения", Неопределено);
			ПараметрыЗапроса.Вставить("ДатаОтправления",?(ЗначениеЗаполнено(ТекД.ДатаОтправления),ТекД.ДатаОтправления,ТекД.ДатаПередачиВПользование));
			// получаем дату прибытия по табельному расписанию
			ДанныеТабельногоРасписания = Отправки_сервер.ПолучитьТабельноеРасписаниеПоПараметрам(ТекД.СтанцияОтправления, ТекД.СтанцияНазначения);
			КолвоДн = ДанныеТабельногоРасписания.ДобавитьКОкончанию;
			Если ЗначениеЗаполнено(КолвоДн) Тогда
				ДатаПриб = ТекД.ДатаОтправления + КолвоДн*24;
			КонецЕсли;
			Если ЗначениеЗаполнено(КолвоДн) Тогда
				ПараметрыЗапроса.Вставить("ДатаПрибытия",?(ЗначениеЗаполнено(ТекД.ДатаОтправления),ТекД.ДатаОтправления,ТекД.ДатаПередачиВПользование) + КолвоДн);
			КонецЕсли;
		Иначе
			ПараметрыЗапроса.Вставить("ПунктОтправления",ТекД.РегионОтправления);
			ПараметрыЗапроса.Вставить("ПунктНазначения",ТекД.РегионВозврата);
			ПараметрыЗапроса.Вставить("ДатаОтправления",ТекД.ДатаПередачиВПользование);
			// получаем дату прибытия по табельному расписанию
			ДанныеТабельногоРасписания = Отправки_сервер.ПолучитьТабельноеРасписаниеПоПараметрам(ТекД.РегионОтправления, ТекД.РегионВозврата);
			КолвоДн = ДанныеТабельногоРасписания.ДобавитьКОкончанию;
			Если ЗначениеЗаполнено(КолвоДн) Тогда
				ДатаПриб = ТекД.ДатаПередачиВПользование + КолвоДн*24;
			КонецЕсли;
			Если ЗначениеЗаполнено(КолвоДн) Тогда
				ПараметрыЗапроса.Вставить("ДатаПрибытия",ТекД.ДатаПередачиВПользование + КолвоДн);
			КонецЕсли;
		КонецЕсли;
		ПараметрыЗапроса.Вставить("ПСЦ",ТекД.ПСЦ);
	
		МассивПодходящихЗаявок = ПолучитьСписокПодходящихЗаявок(ПараметрыЗапроса);
		
		//Если МассивПодходящихЗаявок.Найти(ТекД.Заявка) = Неопределено Тогда
		//	ТекД.ЗаявкаНеПодходит = Истина;
		//Иначе
			ТекД.ЗаявкаНеПодходит = Ложь;
		//КонецЕсли;
	Иначе
		ТекД.ЗаявкаНеПодходит = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВагоныВПовагонкеКлиентПриИзменении(Элемент)
	
	ТекД = Элементы.ВагоныВПовагонке.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИзменениеКлиента(ТекД);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеКлиента(ТекД)
	
	// очищаем договор и ПСЦ
	ТекД.Договор = ПредопределенноеЗначение("Справочник.ДоговорыКонтрагентов.ПустаяСсылка");
	ТекД.ПСЦ = ПредопределенноеЗначение("Документ.ПСЦ.ПустаяСсылка");
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("Клиент",ТекД.Клиент);
	СтруктураЗапроса.Вставить("Договор",ТекД.Договор);
	СтруктураОтвета = ПолучитьДоговорПСЦ(СтруктураЗапроса);
	ЗаполнитьЗначенияСвойств(ТекД,СтруктураОтвета);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДоговорПСЦ(СтруктураЗапроса)
	
	// если у клиента один договор и/или один ПСЦ, то подставим их автоматически
	
	Договор = СтруктураЗапроса.Договор;
	ПСЦ = Документы.ПСЦ.ПустаяСсылка();
	
	Если НЕ ЗначениеЗаполнено(СтруктураЗапроса.Договор) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ДоговорыКонтрагентов.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		               |ГДЕ
		               |	ДоговорыКонтрагентов.Владелец = &Владелец";
		Запрос.УстановитьПараметр("Владелец",СтруктураЗапроса.Клиент);
		ТЗ = Запрос.Выполнить().Выгрузить();
		Если ТЗ.Количество() = 1 Тогда
			Договор = ТЗ[0].Ссылка;
		Иначе
			Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Договор) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ПСЦ.Ссылка КАК Ссылка
		               |ИЗ
		               |	Документ.ПСЦ КАК ПСЦ
		               |ГДЕ
		               |	ПСЦ.Договор = &Договор";
		Запрос.УстановитьПараметр("Договор",Договор);
		ТЗ = Запрос.Выполнить().Выгрузить();
		Если ТЗ.Количество() = 1 Тогда
			ПСЦ = ТЗ[0].Ссылка;
		Иначе
			ПСЦ = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	
	СтруктураЗапроса.Вставить("Договор",Договор);
	СтруктураЗапроса.Вставить("ПСЦ",ПСЦ);
	
	Возврат СтруктураЗапроса;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьДанныеПоВагонуВЗаявку(МассивЗаявокКЗаписи,Фактическая)
	
	ТЗ_Заявки = Новый ТаблицаЗначений;
	ТЗ_Заявки.Колонки.Добавить("НомерВагона",Новый ОписаниеТипов("СправочникСсылка.ТС"));
	ТЗ_Заявки.Колонки.Добавить("СтанцияОтправления",Новый ОписаниеТипов("СправочникСсылка.Локации"));
	ТЗ_Заявки.Колонки.Добавить("СтанцияНазначения",Новый ОписаниеТипов("СправочникСсылка.Локации"));
	ТЗ_Заявки.Колонки.Добавить("Калькуляция",Новый ОписаниеТипов("ДокументСсылка.Калькуляция"));
	ТЗ_Заявки.Колонки.Добавить("ДатаОтправления",Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТЗ_Заявки.Колонки.Добавить("ДатаПередачиВПользование",Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТЗ_Заявки.Колонки.Добавить("РегионОтправления",Новый ОписаниеТипов("СправочникСсылка.Локации"));
	ТЗ_Заявки.Колонки.Добавить("РегионВозврата",Новый ОписаниеТипов("СправочникСсылка.Локации"));
	ТЗ_Заявки.Колонки.Добавить("Заявка",Новый ОписаниеТипов("ДокументСсылка.Заявка"));

	Для Каждого Эл Из МассивЗаявокКЗаписи Цикл
		НовСтр = ТЗ_Заявки.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,Эл);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	*
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ВремТЧ КАК ВремТЧ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	*
		|ИЗ
		|	ВТ КАК ВТ
		|ИТОГИ ПО
		|	ВТ.Заявка";
	Запрос.УстановитьПараметр("ВремТЧ",ТЗ_Заявки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаЗаявка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаЗаявка.Следующий() Цикл
		ВыборкаДетальныеЗаписи = ВыборкаЗаявка.Выбрать();
		
		Заявка = ВыборкаЗаявка.Заявка;
		Если Не ЗначениеЗаполнено(Заявка) Тогда
			Продолжить;
		КонецЕсли;
		
		ПолучОб = Заявка.ПОлучитьОбъект();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ТЧ_СоставУслуги = ПолучОб.СоставУслуги;
			ПараметрыОтбора = Новый СТруктура;
			ПараметрыОтбора.Вставить("Вагон",ВыборкаДетальныеЗаписи.НомерВагона);
			НайденныеСтроки = ТЧ_СоставУслуги.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() = 0 Тогда
				НовСтр = ТЧ_СоставУслуги.Добавить();
				НовСтр.Вагон = ВыборкаДетальныеЗаписи.НомерВагона;
				НовСтр.Услуга = Константы.УслугаДляПовагоннойЗаявки.Получить();
				НовСтр.СтанцияОтправления = ВыборкаДетальныеЗаписи.СтанцияОтправления;
				НовСтр.СтанцияНазначения = ВыборкаДетальныеЗаписи.СтанцияНазначения;
				НовСтр.ПунктОтправления = ВыборкаДетальныеЗаписи.СтанцияОтправления;
				НовСтр.ПунктНазначения = ВыборкаДетальныеЗаписи.СтанцияНазначения;
				НовСтр.ТипВагона = ВыборкаДетальныеЗаписи.НомерВагона.ТипТС;
				НовСтр.ГУИДСтроки = Новый УникальныйИдентификатор;
				НовСтр.Калькуляция = ВыборкаДетальныеЗаписи.Калькуляция;
				
				// добавить вагоны в регистр вагоны в отправках
				ПараметрыЗапроса = Новый СТруктура;
				Если Фактическая Тогда
					ПараметрыЗапроса.Вставить("ПунктОтправления",ВыборкаДетальныеЗаписи.СтанцияОтправления);
					ПараметрыЗапроса.Вставить("ПунктНазначения",ВыборкаДетальныеЗаписи.СтанцияНазначения);
					ПараметрыЗапроса.Вставить("ДатаОтправления",?(ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ДатаОтправления),ВыборкаДетальныеЗаписи.ДатаОтправления,ВыборкаДетальныеЗаписи.ДатаПередачиВПользование));
					// получаем дату прибытия по табельному расписанию
					ДанныеТабельногоРасписания = Отправки_сервер.ПолучитьТабельноеРасписаниеПоПараметрам(ВыборкаДетальныеЗаписи.СтанцияОтправления, ВыборкаДетальныеЗаписи.СтанцияНазначения);
					КолвоДн = ДанныеТабельногоРасписания.ДобавитьКОкончанию;
					Если ЗначениеЗаполнено(КолвоДн) Тогда
						ДатаПриб = ВыборкаДетальныеЗаписи.ДатаОтправления + КолвоДн*24;
					КонецЕсли;
					Если ЗначениеЗаполнено(КолвоДн) Тогда
						ПараметрыЗапроса.Вставить("ДатаПрибытия",?(ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ДатаОтправления),ВыборкаДетальныеЗаписи.ДатаОтправления,ВыборкаДетальныеЗаписи.ДатаПередачиВПользование) + КолвоДн);
					КонецЕсли;
				Иначе
					ПараметрыЗапроса.Вставить("ПунктОтправления",ВыборкаДетальныеЗаписи.РегионОтправления);
					ПараметрыЗапроса.Вставить("ПунктНазначения",ВыборкаДетальныеЗаписи.РегионВозврата);
					ПараметрыЗапроса.Вставить("ДатаОтправления",ВыборкаДетальныеЗаписи.ДатаПередачиВПользование);
					// получаем дату прибытия по табельному расписанию
					ДанныеТабельногоРасписания = Отправки_сервер.ПолучитьТабельноеРасписаниеПоПараметрам(ВыборкаДетальныеЗаписи.РегионОтправления, ВыборкаДетальныеЗаписи.РегионВозврата);
					КолвоДн = ДанныеТабельногоРасписания.ДобавитьКОкончанию;
					Если ЗначениеЗаполнено(КолвоДн) Тогда
						ДатаПриб = ВыборкаДетальныеЗаписи.ДатаОтправления + КолвоДн*24;
					КонецЕсли;
					Если ЗначениеЗаполнено(КолвоДн) Тогда
						ПараметрыЗапроса.Вставить("ДатаПрибытия",ВыборкаДетальныеЗаписи.ДатаПередачиВПользование + КолвоДн);
					КонецЕсли;
				КонецЕсли;
				
				Запрос = Новый Запрос;
				Запрос.Текст = "ВЫБРАТЬ
				               |	ЗаявкаПереченьРейсов.Ссылка КАК Ссылка,
				               |	МАКСИМУМ(ЗаявкаПереченьРейсов.Рейс) КАК Рейс
				               |ИЗ
				               |	Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
				               |ГДЕ
				               |	ЗаявкаПереченьРейсов.Рейс.ПунктОтправления В ИЕРАРХИИ(&ПунктОтправления)
				               |	И ЗаявкаПереченьРейсов.Рейс.ПунктНазначения В ИЕРАРХИИ(&ПунктНазначения)
				               |	И ВЫБОР
				               |			КОГДА &ДатаЕсть = ИСТИНА
				               |				ТОГДА ЗаявкаПереченьРейсов.Рейс.ДатаПрибытия = &ДатаПрибытия
				               |			ИНАЧЕ ИСТИНА
				               |		КОНЕЦ
				               |	И ЗаявкаПереченьРейсов.Рейс.ДатаОтправления = &ДатаОтправления
				               |	И ЗаявкаПереченьРейсов.Ссылка = &Ссылка
				               |
				               |СГРУППИРОВАТЬ ПО
				               |	ЗаявкаПереченьРейсов.Ссылка";
				Запрос.УстановитьПараметр("Ссылка",Заявка.Ссылка);
				Запрос.УстановитьПараметр("ПунктОтправления",ПараметрыЗапроса.ПунктОтправления);
				Запрос.УстановитьПараметр("ПунктНазначения",ПараметрыЗапроса.ПунктНазначения);
				Запрос.УстановитьПараметр("ДатаОтправления",ПараметрыЗапроса.ДатаОтправления);
				Если ПараметрыЗапроса.Свойство("ДатаПрибытия") И ЗначениеЗаполнено(ПараметрыЗапроса.ДатаПрибытия) ТОгда
					Запрос.УстановитьПараметр("ДатаЕсть",Истина);
					Запрос.УстановитьПараметр("ДатаПрибытия",ПараметрыЗапроса.ДатаПрибытия);
				Иначе
					Запрос.УстановитьПараметр("ДатаЕсть",Ложь);
					Запрос.УстановитьПараметр("ДатаПрибытия",1);
				КонецЕсли;

				Ответ = Запрос.Выполнить().Выбрать();
				Если Ответ.Следующий() Тогда
					
					///// Заполнить РС ВАГОНЫВОТПРАВКЕ. Связать вагоны и рейс ////////
					МЗ = РегистрыСведений.ВагоныВОтправке.СоздатьМенеджерЗаписи();
					МЗ.Вагон = ВыборкаДетальныеЗаписи.НомерВагона;
					МЗ.Отправка = Ответ.Рейс;
					МЗ.Период = ТекущаяДата();
					МЗ.Записать(Истина);
					
				КонецЕсли;

			КонецЕсли;
		КонецЦикла;
		
		Попытка
			ПолучОб.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ПолучОб.Записать(РежимЗаписиДокумента.Запись);
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

