						//ДИТ Шевченко А.В. US 62360 ТА 72965 26.07.2023
						//|	Справочник.Продукты КАК Продукты
						|	Справочник.СервисыУчетноеНаправление КАК Продукты
						//ДИТ Шевченко А.В. US 62360 ТА 72965 26.07.2023
						|ГДЕ
						|	НЕ Продукты.ПометкаУдаления
						|	И Продукты.НачалоМаршрута = &НачалоМаршрута
						|	И Продукты.ОкончаниеМаршрута = &ОкончаниеМаршрута";
		ЗапросП.УстановитьПараметр("НачалоМаршрута",Эл.СтанцияОтправления);
		ЗапросП.УстановитьПараметр("ОкончаниеМаршрута",Эл.СтанцияНазначения);
		РезультатЗапросаП = ЗапросП.Выполнить();
		Если РезультатЗапросаП.Пустой() Тогда
			// создать продукт 
			//ДИТ Шевченко А.В. US 62360 ТА 72965 26.07.2023
			//ТекПродукт = Справочники.Продукты.СоздатьЭлемент();
			ТекПродукт = Справочники.СервисыУчетноеНаправление.СоздатьЭлемент();
			//ДИТ Шевченко А.В. US 62360 ТА 72965 26.07.2023
			ТекПродукт.Наименование = Строка(Эл.СтанцияОтправления) + " - " + Строка(Эл.СтанцияНазначения);
			ТекПродукт.ВключаетРасходыПоПодсылуВагонов = Истина;
			ТекПродукт.НачалоМаршрута = Эл.СтанцияОтправления;
			ТекПродукт.ОкончаниеМаршрута = Эл.СтанцияНазначения;
			Если Эл.СтанцияОтправления.Страна = Справочники.СтраныМира.Россия И Эл.СтанцияНазначения.Страна = Справочники.СтраныМира.Россия Тогда 
				//ДИТ Шевченко А.В. US 62360 ТА 72965 26.07.2023
				//ТекПродукт.Родитель = Справочники.Продукты.НайтиПоНаименованию("РФ - РФ");
				ТекПродукт.Родитель = Справочники.СервисыУчетноеНаправление.НайтиПоНаименованию("РФ - РФ");
				//ДИТ Шевченко А.В. US 62360 ТА 72965 26.07.2023
			Иначе
				//ДИТ Шевченко А.В. US 62360 ТА 72965 26.07.2023
				//ТекПродукт.Родитель = Справочники.Продукты.НайтиПоНаименованию("Продукты");
				ТекПродукт.Родитель = Справочники.СервисыУчетноеНаправление.НайтиПоНаименованию("Продукты");
				//ДИТ Шевченко А.В. US 62360 ТА 72965 26.07.2023
			КонецЕсли;
			ТекПродукт.Записать();
		Иначе
			ТекПродукт = РезультатЗапросаП.Выгрузить().ВыгрузитьКолонку("Ссылка")[0];
		КонецЕсли;

		// рейс ищем или создаем здесь, т.к. нужно получить признак груженого или порожнего
		// проверка, есть ли уже такой рейс. 
		ТекРейс = Справочники.РейсыЖД.ПустаяСсылка();
		ЗапросР = Новый Запрос;
		ЗапросР.Текст = "ВЫБРАТЬ
		                |	РейсыЖД.Ссылка КАК Ссылка
		                |ИЗ
		                |	Справочник.РейсыЖД КАК РейсыЖД
		                |ГДЕ
		                |	НЕ РейсыЖД.КП
		                |	И НЕ РейсыЖД.ПометкаУдаления
		                |	И РейсыЖД.ПовагоннаяОтправка
		                |	И РейсыЖД.ПунктОтправления = &ПунктОтправления
		                |	И РейсыЖД.ПунктНазначения = &ПунктНазначения
		                |	И ВЫБОР
		                |			КОГДА &ДатаЕсть = ИСТИНА
		                |				ТОГДА НАЧАЛОПЕРИОДА(РейсыЖД.ДатаПрибытия, ДЕНЬ) = &ДатаПрибытия
		                |			ИНАЧЕ ИСТИНА
		                |		КОНЕЦ
		                |	И НАЧАЛОПЕРИОДА(РейсыЖД.ДатаОтправления, ДЕНЬ) = &ДатаОтправления";
		ЗапросР.УстановитьПараметр("ПунктОтправления",Эл.СтанцияОтправления);
		ЗапросР.УстановитьПараметр("ПунктНазначения",Эл.СтанцияНазначения);
		ЗапросР.УстановитьПараметр("ДатаОтправления",НачалоДня(Эл.ДатаОтправления));
		// получаем дату прибытия по табельному расписанию
		ДанныеТабельногоРасписания = Отправки_сервер.ПолучитьТабельноеРасписаниеПоПараметрам(Эл.СтанцияОтправления, Эл.СтанцияНазначения);
		КолвоДн = ДанныеТабельногоРасписания.ДобавитьКОкончанию;
		Если ЗначениеЗаполнено(КолвоДн) Тогда
			ДатаПриб = Эл.ДатаОтправления + КолвоДн*24;
		КонецЕсли;
		// если по табельному расписанию не получили ничего, то запрос к рейл тарифу
		Если Не ЗначениеЗаполнено(ДатаПриб) Тогда
			КолвоДн = ПолучитьДанныеРейлТариф(Эл.СтанцияОтправления,Эл.СтанцияНазначения,Эл.Груженый,Эл.Груз,Эл.НомерВагона.ТипТС,Перечисления.ПринадлежностьПС.Собственный);
			ДатаПриб = Эл.ДатаОтправления + КолвоДн*3600*24;
		КонецЕсли;
		Если ЗначениеЗаполнено(ДатаПриб) Тогда
			ЗапросР.УстановитьПараметр("ДатаЕсть",Истина);
			ЗапросР.УстановитьПараметр("ДатаПрибытия",НачалоДня(ДатаПриб));
		Иначе
			ЗапросР.УстановитьПараметр("ДатаЕсть",Ложь);
			ЗапросР.УстановитьПараметр("ДатаПрибытия",1);
		КонецЕсли;
		
		РезультатЗапросаР = ЗапросР.Выполнить();
		Если РезультатЗапросаР.Пустой() Тогда
			//////////////// создать РЕЙС ////////////////////////////
			ТекРейс = Справочники.РейсыЖД.СоздатьЭлемент();
			ТекРейс.Наименование = Строка(Эл.СтанцияОтправления) + " - " + Строка(Эл.СтанцияНазначения);
			ТекРейс.ПунктОтправления = Эл.СтанцияОтправления;
			ТекРейс.ПунктНазначения = Эл.СтанцияНазначения;
			ТекРейс.ДатаОтправления = Эл.ДатаОтправления;
			ТекРейс.ДатаПрибытия = ДатаПриб;
			ТекРейс.Продукт = ТекПродукт.Ссылка;
			ТекРейс.Сервис = ТекПродукт.Ссылка;
			ТекРейс.ПовагоннаяОтправка = Истина;
			ТекРейс.ТехРейс = Истина;
			ТекРейс.Записать();
			//////////////////////////////////////////////////////////
		Иначе
			ТекРейс = РезультатЗапросаР.Выгрузить().ВыгрузитьКолонку("Ссылка")[0];
		КонецЕсли;
		
		ТекЗаявка = Эл.Заявка.ПолучитьОбъект();
		
		ТЧ_Рейсы = ТекЗаявка.ПереченьРейсов;
		НовСтр_Рейсы = ТЧ_Рейсы.Добавить();
		НовСтр_Рейсы.Продукт = ТекПродукт.Ссылка;
		НовСтр_Рейсы.Рейс = ТекРейс.Ссылка;
	
		///// Заполнить РС ВАГОНЫВОТПРАВКЕ. Связать вагоны и рейс ////////
		МЗ = РегистрыСведений.ВагоныВОтправке.СоздатьМенеджерЗаписи();
		МЗ.Вагон = Эл.НомерВагона;
		МЗ.Отправка = ТекРейс.Ссылка;
		МЗ.Период = ТекущаяДата();
		МЗ.Записать(Истина);
		
		// изменить строку с вагоном
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Вагон",Эл.НомерВагона);
		НайденныйВагон = ТекЗаявка.СоставУслуги.НайтиСтроки(ПараметрыОтбора);
		Если НайденныйВагон.Количество()>0 Тогда
			НовСтр = НайденныйВагон[0];
			НовСтр.Калькуляция = Эл.Калькуляция;
			НовСтр.Груз = Эл.Груз;
			НовСтр.КодГруза = Эл.Груз.ЕТСНГ;
			НовСтр.Груженый = Эл.Груженый;
			НовСтр.ПунктНазначения = Эл.СтанцияНазначения;
			НовСтр.СтанцияНазначения = Эл.СтанцияНазначения;
			
		КонецЕсли;
		ТекЗаявка.Прибытие = ДатаПриб;
		
		Попытка
			ТекЗаявка.Записать(РежимЗаписиДокумента.Проведение);
			МассивИзмененных.Добавить(ТекЗаявка.Ссылка);
		Исключение
			ТекЗаявка.Записать(РежимЗаписиДокумента.Запись);
			МассивИзмененных.Добавить(ТекЗаявка.Ссылка);
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат МассивИзмененных;
	
КонецФункции

&НаКлиенте
Процедура ВагоныВыведеныПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ТекД = Элементы.ВагоныВыведены.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	
	СтруктураДанныхСтроки = Новый Структура;
	Для Каждого ЭлемСп Из СписокКолонокВагоныВПовагонке Цикл
		Попытка
			СтруктураДанныхСтроки.Вставить(ЭлемСп.Значение,ТекД[ЭлемСп.Значение]);
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	ЗаявкаИзменилась = Ложь;
	СохранитьДанныеВРСПовагонки(СтруктураДанныхСтроки,Ложь,ЗаявкаИзменилась,Ложь,Неопределено);
	
	ЗаполнитьЗначенияСвойств(ТекД, СтруктураДанныхСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаявкуНаУшедшийРейс(Команда)
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "ГруппаВагоныВПовагонке" Тогда
		ИмяТч = "ВагоныВПовагонке";
		Фактическая = Истина;
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "ГруппаВыведеныИзПовагонки" Тогда
		ИмяТч = "ВагоныВыведены";
		Фактическая = Истина;
	Иначе
		ИмяТч = "ПодходВагонов";
		Фактическая = Ложь;
	КонецЕсли;
	
	ТекД = Элементы[ИмяТч].ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивСтруктур = Новый Массив;
	
	//ТаблицаВыбранныхСтрок = ВагоныВПовагонке.Выгрузить(,"СтанцияОтправления, СтанцияНазначения, ДатаОтправления");
	//ТаблицаВыбранныхСтрок.Очистить();
	мСписокВагонов = Новый Массив;
	Для Каждого Стр Из ЭтаФорма[ИмяТч] Цикл
		СтруктураДанныхСтроки = Новый Структура;
		Если НЕ Стр.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Стр.Клиент) Тогда
			Сообщить("У выбранного вагона "+Стр.НомерВагона+" не выбран клиент. Выберите клиента и повторите попытку создания заявки");
			ВОзврат;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Стр.Договор) Тогда
			Сообщить("У выбранного вагона "+Стр.НомерВагона+" не выбран договор. Выберите договор и повторите попытку создания заявки");
			ВОзврат;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Стр.ПСЦ) Тогда
			Сообщить("У выбранного вагона "+Стр.НомерВагона+" не выбран ПСЦ. Выберите ПСЦ и повторите попытку создания заявки");
			ВОзврат;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Стр.НДС) Тогда
			Сообщить("У выбранного вагона "+Стр.НомерВагона+" не выбран НДС. Выберите НДС и повторите попытку создания заявки");
			ВОзврат;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Стр.Калькуляция) Тогда
			Сообщить("У выбранного вагона "+Стр.НомерВагона+" не выбрана калькуляция. Выберите калькуляцию и повторите попытку создания заявки");
			ВОзврат;
		КонецЕсли;
		//Если НЕ ЗначениеЗаполнено(Стр.СтанцияПодачи) Тогда
		Если НЕ ЗначениеЗаполнено(Стр.СтанцияОтправления) Тогда
			Сообщить("У выбранного вагона "+Стр.НомерВагона+" не выбрана станция отправления. Выберите станцию отправления и повторите попытку создания заявки");
			ВОзврат;
		КонецЕсли;
		
		Для Каждого ЭлемСп Из СписокКолонокВагоныВПовагонке Цикл
			Попытка
				СтруктураДанныхСтроки.Вставить(ЭлемСп.Значение,Стр[ЭлемСп.Значение]);
			Исключение
			КонецПопытки;
		КонецЦикла;
		СтруктураДанныхСтроки.Вставить("ДатаНакладной", Дата(1,1,1));
		СтруктураДанныхСтроки.Вставить("Накладная");
		
		//нСтрока = ТаблицаВыбранныхСтрок.Добавить();
		//ЗаполнитьЗначенияСвойств(нСтрока, СтруктураДанныхСтроки);
		МассивСтруктур.Добавить(СтруктураДанныхСтроки);
		мСписокВагонов.Добавить(СтруктураДанныхСтроки.НомерВагона);

		
	КонецЦикла;
	
	Если МассивСтруктур.Количество() = 0 Тогда
		Сообщить("Не выбрано ни одной строки для создания заявки");
		Возврат;
	КонецЕсли;
	
	//МассивСгруппированныхОтправок = ПолучитьСгруппированныеОтправки(МассивСтруктур);
	ОпОп = Новый ОписаниеОповещения("ОбработкаЗакрытияФормыПодбораРейса",ЭтаФорма,Новый Структура("Фактическая, ИмяТЧ", Фактическая, ИмяТЧ));
	ПараметрыОткрытия = Новый Структура("МассивСтруктур", МассивСтруктур);
	ОткрытьФорму("ОбщаяФорма.ФормаПодбораРейсов", ПараметрыОткрытия, ЭтаФорма,,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

Функция ПолучитьСгруппированныеОтправки(МассивСтруктур)
	
	ТЗГруппОтправок = ВагоныВПовагонке.Выгрузить(Новый Структура("Пометка", Истина),"СтанцияПодачи, СтанцияНазначения, ДатаОтправления");
	ТЗГруппОтправок.Свернуть("СтанцияПодачи, СтанцияНазначения, ДатаОтправления");
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(ТЗГруппОтправок);
	
КонецФункции

Процедура ОбработкаЗакрытияФормыПодбораРейса(Параметр1, Параметр2) Экспорт
	Если Параметр1 = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	МассивСтруктур = Параметр1;
	ИмяТЧ = Параметр2.ИмяТЧ;
	
	Для Каждого Эл Из МассивСтруктур Цикл
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("НомерВагона",Эл.НомерВагона);
		ПараметрыОтбора.Вставить("ДатаПомещенияВРежимПовагонки",Эл.ДатаПомещенияВРежимПовагонки);
		НайдСтр = ЭтаФорма[ИмяТч].НайтиСтроки(ПараметрыОтбора);
		Если НайдСтр.Количество()>0 Тогда
			НайдСтр[0].УшедшийРейс = Истина;
			НайдСтр[0].ДатаОтправления = Эл.ДатаОтправления;
			НайдСтр[0].СтанцияОтправления = Эл.СтанцияОтправления;
			НайдСтр[0].СтанцияНазначения = Эл.СтанцияНазначения;
			НайдСтр[0].ДатаПрибытияНаСтанциюНазначения = Эл.ДатаПрибытияНаСтанциюНазначения;
		КонецЕсли;
		СохранитьДанныеВРСПовагонки(НайдСтр[0],Ложь, Ложь, Ложь, Неопределено);
	КонецЦикла;
		
	МассивЗаявок = СоздатьЗаявкуНаСервере(МассивСтруктур, Параметр2.Фактическая);
	Для Каждого Эл Из МассивЗаявок Цикл
		Сообщить(Строка(Эл.Заявка) + " успешно создана!");
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("НомерВагона",Эл.НомерВагона);
		ПараметрыОтбора.Вставить("ДатаПомещенияВРежимПовагонки",Эл.ДатаПомещенияВРежимПовагонки);
		НайдСтр = ЭтаФорма[ИмяТч].НайтиСтроки(ПараметрыОтбора);
		Если НайдСтр.Количество()>0 Тогда
			НайдСтр[0].Заявка = Эл.Заявка;
			НайдСтр[0].ЗаявкаНеПодходит = Ложь;
			НайдСтр[0].ДатаОтправления = ПолучитьРеквизитСсылкиНаСервере(Эл.Заявка,"Отправка").Отправка;
		КонецЕсли;
		СохранитьДанныеВРСПовагонки(НайдСтр[0],Ложь, Ложь, Ложь, Неопределено);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаявкуНаПодсыл(Команда)
	//ПараметрыОтбора = Новый Структура("СписокВагонов,СтанцияНазначения,ДатаОтправления,РейсЖД",ВагоныВПовагонке,Дислокация,ДатаОтправки,Отправка);
	ПараметрыОтбора = Новый Структура("СписокВагонов,Повагонка",ВагоныВПовагонке,Истина);
	ОткрытьФорму("Документ.Операция.Форма.ФормаЕдиничнойОтправки",ПараметрыОтбора);
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьВыводВагоновВПовагонку(Команда)
	ВыделенныеВагоны = Элементы.СписокВагонов.ВыделенныеСтроки;
	ИнформированиеПланеров = Новый Массив;
	ЗапрошенныеВагоны = Новый Массив;
	Для каждого ВыделенныйВагон Из ВыделенныеВагоны Цикл
		СтруктураВагон = Новый Структура("НомерВагона");
		НомерВагона = ПолучитьРеквизит(Элементы.СписокВагонов.ДанныеСтроки(ВыделенныйВагон).Вагон,"Наименование");
		СтруктураВагон.НомерВагона = НомерВагона;
		ИнформированиеПланеров.Добавить(СтруктураВагон);
		ЗапрошенныеВагоны.Добавить(Элементы.СписокВагонов.ДанныеСтроки(ВыделенныйВагон).Вагон);
	КонецЦикла;
	ЗаписатьВРегистрЗапросНаПовагонкуНаСервере(ЗапрошенныеВагоны);
	// создать оповещение для планеров
	ОповещениеПользователей(ИнформированиеПланеров,"ЗапросВагоновВПовагонку");
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьРеквизит(Ссылка, Реквизит)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, Реквизит);	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьВРегистрЗапросНаПовагонкуНаСервере(МассивВагонов)
	
	Для каждого Вагон Из МассивВагонов Цикл
		мз = РегистрыСведений.ВагоныЗапрошенныеВПовагонку.СоздатьМенеджерЗаписи();
		мз.Вагон = Вагон;
		мз.ТребуетсяВыводВПовагонку = Истина;
		мз.Записать(Истина);
	КонецЦикла; 

КонецПроцедуры 

&НаКлиенте
Процедура ВагоныВПовагонкеТребуетсяПередислокацияПриИзменении(Элемент)
	текДанные = Элементы.ВагоныВПовагонке.ТекущиеДанные;
	ЕстьОшибки = Ложь;
	СоздатьОповещениеПланеруОНеобходимостиПередислокации(текДанные, ЕстьОшибки);
	Если ЕстьОшибки Тогда
		ТекДанные.ТребуетсяПередислокация = Ложь;
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура СоздатьОповещениеПланеруОНеобходимостиПередислокации(Данные, ЕстьОшибки)
	Если Данные.ТребуетсяПередислокация и Данные.СогласованоМенеджером Тогда
		Если Не ЗначениеЗаполнено(Данные.СтанцияПодачи) Тогда
			Сообщить("Не заполнена станция подачи");
			ЕстьОшибки = Истина;
		КонецЕсли; 
		Если Не ЗначениеЗаполнено(Данные.НомерГУ) Тогда
			Сообщить("Не заполнен номер ГУ");
			ЕстьОшибки = Истина;
		КонецЕсли; 
		Если Не ЗначениеЗаполнено(Данные.ДатаПлановогоОтправленияСоСтанцииПодачи) Тогда
			Сообщить("Не заполнена дата планового отправления со станции подачи");
			ЕстьОшибки = Истина;
		КонецЕсли; 
		Если Не ЗначениеЗаполнено(Данные.Грузоотправитель) Тогда
			Сообщить("Не заполнен грузоотправитель");
			ЕстьОшибки = Истина;
		КонецЕсли; 
		Если ЕстьОшибки Тогда
			Возврат;
		КонецЕсли; 
		ИнформированиеПланеров = Новый Массив;
		СтруктураВагон = Новый Структура("НомерВагона, СтанцияПодачи, ДатаПлановогоОтправленияСоСтанцииПодачи");
		ЗаполнитьЗначенияСвойств(СтруктураВагон, Данные);
		ИнформированиеПланеров.Добавить(СтруктураВагон);	
		ОповещениеПользователей(ИнформированиеПланеров, "НеобходимаПередислокация");
		Сообщить("Оповещение планеров выполнено");
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура ВагоныВПовагонкеСогласованоМенеджеромПриИзменении(Элемент)
	текДанные = Элементы.ВагоныВПовагонке.ТекущиеДанные;
	ЕстьОшибки = Ложь;
	СоздатьОповещениеПланеруОНеобходимостиПередислокации(текДанные, ЕстьОшибки);
	Если ЕстьОшибки Тогда
		ТекДанные.СогласованоМенеджером = Ложь;
	КонецЕсли; 
КонецПроцедуры

&НаСервере
Процедура УдалитьИзПодходаНаСервере()
	ВыделенныеВагоны = ПодходВагонов.НайтиСтроки(Новый Структура("Отметка", Истина));
	Для каждого ВыделенныйВагон Из ВыделенныеВагоны Цикл
		мз = РегистрыСведений.ВагоныЗапланированныеКПовагонке.СоздатьМенеджерЗаписи();
		мз.Вагон = ВыделенныйВагон.НомерВагона;
		мз.Прочитать();
		Если мз.Выбран() Тогда
			мз.Удалить();
		КонецЕсли; 
	КонецЦикла; 
КонецПроцедуры

