&НаСервере
Процедура НастроитьВидимостьЭлементовДляРежимаПереносаКТК(); 
	
	Если РежимПереносаКТК = 1 Тогда //вызов из Заявки
		Элементы.ПеренестиВДругуюСделку.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры //Евросиб Коханенко Н.А. 17.05.2024 )) #83866

