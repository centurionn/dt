
#Область ПеренесеноИзФормы_Сделка_ФормаИсключенияКТКИзСделки
&НаКлиенте
Процедура ОтменаЪ(Команда)
	
	Закрыть(Новый Структура("ВыбраннаяЗаявка, ЭтаФормаЪ", Ложь, ЭтаФормаЪ));
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНовуюЗаявку(Команда)
	
	Закрыть(Новый Структура("ВыбраннаяЗаявка, ЭтаФормаЪ", Истина, ЭтаФормаЪ));
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВСуществующую(Команда)
	
	Элементы.ГруппаВыберитеЗаявкуДляДобавления.Видимость = Истина;
    // Евросиб Фролов (15.04.2022 Task №48577
	Элементы.ГруппаВыберитеЗаявкуДляДобавления.Заголовок = "Выберите заявку для добавления";
	Элементы.ВыбраннаяЗаявка.Видимость = Истина;
	Элементы.ВыбраннаяСделка.Видимость = Ложь;
	НастроитьДоступностьКнопкиСохранить();
	// Евросиб Фролов)
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекстВопроса = Параметры.ТекстВопроса;
	ЭтаФормаЪ = Параметры.ЭтаФорма; 
	
	//Евросиб Коханенко Н.А. 17.05.2024 (( #83866
	//если параметр РежимПереносаКТК = 0, то вызов из Сделки
	//если параметр РежимПереносаКТК = 1, то вызов из Заявки 
	Если Параметры.Свойство("РежимПереносаКТК") Тогда
		РежимПереносаКТК = Параметры.РежимПереносаКТК;
	КонецЕсли;  
	НастроитьВидимостьЭлементовДляРежимаПереносаКТК();
	//Евросиб Коханенко Н.А. 17.05.2024 )) #83866
	
	ОтборСуществующейПоДоговору = Параметры.Договор;
	Элементы.ГруппаВыберитеЗаявкуДляДобавления.Видимость = Ложь;
	Элементы.СохранитьЪ.Доступность = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПродолжить(Команда)
	
	// Евросиб Фролов (15.04.2022 Task №48577
	Если Элементы.ВыбраннаяСделка.Видимость Тогда
		
		Если Не ЗначениеЗаполнено(ВыбраннаяСделка) Тогда
			ПоказатьПредупреждение(, "Не выбрана сделка, в которую будут перенесены выбранные КТК.");
			Возврат;
		КонецЕсли;	
		
		НомерСделки = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(ВыбраннаяСделка, "Номер");
		ПредсталениеНомера = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(НомерСделки);
		ТекстВопроса = СтрШаблон("Выбранные КТК будут перенесены в сделку №%1 и будет создана новая заявка. Продолжить?", ПредсталениеНомера);
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОПереносеВСделку", ЭтотОбъект, Параметры);
		ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0);
		Возврат;
	КонецЕсли;
	// Евросиб Фролов)
	
	Закрыть(Новый Структура("ВыбраннаяЗаявка, ЭтаФормаЪ", ВыбраннаяЗаявка, ЭтаФормаЪ));
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбраннаяЗаявкаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	//Евросиб Коханенко Н.А. 20.05.2024 (( #83866 
	//ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораЗаявки", ЭтаФормаЪ);
	//ОткрытьФорму("Документ.Заявка.ФормаВыбора", Новый Структура("Договор", ОтборСуществующейПоДоговору),, ЭтаФормаЪ.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораЗаявки", ЭтотОбъект);
	ОткрытьФорму("Документ.Заявка.ФормаВыбора", Новый Структура("Договор", ОтборСуществующейПоДоговору),, ЭтотОбъект.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	//Евросиб Коханенко Н.А. 20.05.2024 )) #83866 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораЗаявки(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = неопределено Тогда Возврат; КонецЕсли;
	
	ВыбраннаяЗаявка = П1;
	ВыбраннаяЗаявкаПриИзменении(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбраннаяЗаявкаПриИзменении(Элемент)
	
	// Евросиб Фролов (15.04.2022 Task №48577
	//Элементы.СохранитьЪ.Доступность = ЗначениеЗаполнено(ВыбраннаяЗаявка);
	НастроитьДоступностьКнопкиСохранить();
	// Евросиб Фролов) 
	
КонецПроцедуры

// Евросиб Фролов (15.04.2022 Task №48577
&НаКлиенте
Процедура ПеренестиВДругуюСделку(Команда)
	
	Элементы.ГруппаВыберитеЗаявкуДляДобавления.Видимость = Истина;
	Элементы.ГруппаВыберитеЗаявкуДляДобавления.Заголовок = "Выберите сделку для добавления";
	
	Элементы.ВыбраннаяЗаявка.Видимость = Ложь;
	Элементы.ВыбраннаяСделка.Видимость = Истина;
	
	НастроитьДоступностьКнопкиСохранить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОПереносеВСделку(Результат, Параметры) Экспорт 
	
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

    Закрыть(Новый Структура("ВыбраннаяЗаявка, ЭтаФормаЪ", ВыбраннаяСделка, ЭтаФормаЪ));

КонецПроцедуры

&НаКлиенте
Процедура ВыбраннаяСделкаПриИзменении(Элемент)
	
	НастроитьДоступностьКнопкиСохранить();
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьДоступностьКнопкиСохранить() 
	
	Элементы.СохранитьЪ.Доступность = ЗначениеЗаполнено(ВыбраннаяСделка) И Элементы.ВыбраннаяСделка.Видимость
										ИЛИ ЗначениеЗаполнено(ВыбраннаяЗаявка) И Элементы.ВыбраннаяЗаявка.Видимость;
										
КонецПроцедуры	

&НаКлиенте
Процедура ВыбраннаяСделкаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ОтборСуществующейПоДоговору) Тогда
		СтандартнаяОбработка = Ложь;
		СписокДокументов = ПолучитьСделкиПоДоговору(ОтборСуществующейПоДоговору);
		
		НастройкиКомпоновки = Новый НастройкиКомпоновкиДанных;
		
		ЭлементОтбора = НастройкиКомпоновки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
		ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Ссылка");
		ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
		ЭлементОтбора.Использование  = Истина;
		ЭлементОтбора.ПравоеЗначение = СписокДокументов;
		
		ПараметрыВыбора = Новый Структура;
		ПараметрыВыбора.Вставить("ФиксированныеНастройки", НастройкиКомпоновки);
		
		ОткрытьФорму("Документ.Сделка.ФормаВыбора", ПараметрыВыбора, Элемент);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСделкиПоДоговору(Договор)

	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СделкаСвязьУчетныхЕдиниц.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|ГДЕ
	|	СделкаСвязьУчетныхЕдиниц.Договор = &Договор";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Договор", Договор);
	
	Результат = Запрос.Выполнить();
	МассивДокументов = Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	СписокДокументов = Новый СписокЗначений;
	СписокДокументов.ЗагрузитьЗначения(МассивДокументов);
	
	Возврат СписокДокументов;
	
КонецФункции
// Евросиб Фролов)
#КонецОбласти

