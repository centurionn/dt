&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
    ПараметрКоманды = Новый Массив;
	//++ДИТ Гаузер А.В. BUG 54206 TA 54207 14.07.2022
	//ПараметрКоманды.Добавить(Поступление);
	Если СписокДокументов.Количество() Тогда
		ПараметрКоманды = СписокДокументов.ВыгрузитьЗначения();
	Иначе
		ПараметрКоманды.Добавить(Поступление);
	КонецЕсли;
	//--ДИТ Гаузер А.В. BUG 54206 TA 54207 14.07.2022
	
	ПараметрыВыполненияКоманды = Новый Структура;
	ПараметрыВыполненияКоманды.Вставить("Источник", ЭтаФорма);
	
	//ВыполнениеКомандКлиент.ВыполнитьКомандуОднократноеРазнесение(ПараметрКоманды, ПараметрыВыполненияКоманды);
	ВыполнитьКомандуОднократноеРазнесение(ПараметрКоманды, ПараметрыВыполненияКоманды);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандуОднократноеРазнесение(ПараметрКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	//Евросиб Каблов 09.11.2022 ( Ticket#0288962
	Если ПараметрКоманды.Количество() = 1 Тогда
		ИдентификаторЗадания = ПараметрКоманды[0].УникальныйИдентификатор();
	Иначе
		ИдентификаторЗадания = Неопределено;
	КонецЕсли;
	РезультатДлительнойОперации = ВыполнениеКомандСервер.ЗапуститьФоновоеЗаданиеОднократноеРазнесение(ПараметрКоманды, ИдентификаторЗадания);
	
	Если РезультатДлительнойОперации.Статус = "Ошибка"
		И РезультатДлительнойОперации.КраткоеПредставлениеОшибки = "Задание с таким значением ключа уже выполняется. " Тогда
		
		МожноЗакрытьФорму = Истина;
		Закрыть();
		Возврат;
	КонецЕсли;
	//Евросиб Каблов 09.11.2022 )
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("РезультатДлительнойОперации", РезультатДлительнойОперации);
	ДопПараметры.Вставить("Источник", ПараметрыВыполненияКоманды.Источник);
	
	Подключаемый_ПроверитьВыполнениеЗадания(, ДопПараметры);

КонецПроцедуры

