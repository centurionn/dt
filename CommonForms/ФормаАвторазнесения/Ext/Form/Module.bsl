&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если Не ЗавершениеРаботы Тогда
		СтандартнаяОбработка = Ложь;
		Если НЕ МожноЗакрытьФорму Тогда
			ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВопросаЗакрытияФормы", ЭтотОбъект);
			ПоказатьВопрос(ОписаниеОповещения, "При закрытии формы задание по авторазнесению будет отменено! Закрыть форму?",РежимДиалогаВопрос.ДаНет, 15, КодВозвратаДиалога.Нет,, КодВозвратаДиалога.Нет);
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
//Евросиб Гудкова( 02.12.2021 Ticket№ 42922
	ОценкаПроизводительностиКлиент.ЗавершитьЗамерВремени(Новый УникальныйИдентификатор(УИДЗамера));
// Евросиб Гудкова)
КонецПроцедуры
&НаКлиенте
Процедура ОбработкаВопросаЗакрытияФормы(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		МожноЗакрытьФорму = Истина;
		Если ЭтаФорма.Открыта() Тогда
//Евросиб Гудкова( 02.12.2021 Ticket№ 42922
			ОценкаПроизводительностиКлиент.ЗавершитьЗамерВремени(Новый УникальныйИдентификатор(УИДЗамера), Истина);
// Евросиб Гудкова)
			Закрыть();	
		КонецЕсли;
	КонецЕсли; 
	
КонецПроцедуры
