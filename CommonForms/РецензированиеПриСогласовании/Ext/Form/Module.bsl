
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РецензируемыйДокумент = Параметры.РецензОбъект;
	Замечания.Параметры.УстановитьЗначениеПараметра("РецензОбъект", неопределено);
	Замечания.Параметры.УстановитьЗначениеПараметра("Рецензент", Пользователи.ТекущийПользователь());
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СведенияОФайлах.ВладелецФайла КАК ВладелецФайла,
	               |	СведенияОФайлах.Файл КАК Файл
	               |ИЗ
	               |	РегистрСведений.СведенияОФайлах КАК СведенияОФайлах
	               |ГДЕ
	               |	СведенияОФайлах.ВладелецФайла = &ВладелецФайла
	               |	И НЕ СведенияОФайлах.ПометкаУдаления
	               |	И НЕ СведенияОФайлах.Служебный";
	Запрос.УстановитьПараметр("ВладелецФайла", РецензируемыйДокумент);
	Файлы.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Файл"));
	
	//Евросиб Коханенко Н.А. #64811 27.01.2023 (( 
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #64811 27.01.2023 )) 
	
КонецПроцедуры

