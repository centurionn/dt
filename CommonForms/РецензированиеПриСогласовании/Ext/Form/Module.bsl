&НаКлиенте
Процедура ЗамечанияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = истина;
	ТекД = Элементы.Файлы.ТекущиеДанные;
	Если ТекД <> неопределено Тогда
		ОпОп = Новый ОписаниеОповещения("ОбновитьСписок", ЭтаФорма);
		ПараметрыФормы = Новый Структура("РецензОбъект", ТекД.Значение);
		ВыделенныйТекст = "";
		Попытка
			ВыделенныйТекст = Элементы.ТД.Документ.selection.createRange().text;
		Исключение
		КонецПопытки;
		ПараметрыФормы.Вставить("ИсходныйТекст", ВыделенныйТекст);
		ОткрытьФорму("ОбщаяФорма.РецензированиеПриСогласованииЗамечание", ПараметрыФормы,,ЭтаФорма.УникальныйИдентификатор,,,ОпОп,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
	
КонецПроцедуры

