&НаСервере
Процедура ПрочитатьНаСервере(ФайлЪ)
	
	ДД = РаботаСФайлами.ДвоичныеДанныеФайла(ФайлЪ);
	ИВФ = ПолучитьИмяВременногоФайла(ФайлЪ.Расширение);
	ДД.Записать(ИВФ);
	ТД.Прочитать(ИВФ);
	УдалитьФайлы(ИВФ);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолученФайл(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если СтрЗаканчиваетсяНа(ВРЕГ(П1.ПолноеИмяФайла), "DOC") ИЛИ СтрЗаканчиваетсяНа(ВРЕГ(П1.ПолноеИмяФайла), "DOCX") ИЛИ СтрЗаканчиваетсяНа(ВРЕГ(П1.ПолноеИмяФайла), "RTF") Тогда
		Состояние("Попытка открыть файл с использованием Microsoft Word...");
		Word = new COMОбъект("Word.Application");
		Попытка
			Doc = Word.Documents.Open(П1.ПолноеИмяФайла);
			ИВФ = ПолучитьИмяВременногоФайла("html");
			Doc.SaveAs(ИВФ, 8);
			ТД = ИВФ;
		Исключение
			Сообщить("Ошибка при открытии файла через Word...");
		КонецПопытки;
		Попытка
			Word.Quit();
		Исключение
		КонецПопытки;
//	ИначеЕсли СтрЗаканчиваетсяНа(ВРЕГ(П1.ПолноеИмяФайла), "XLS") ИЛИ СтрЗаканчиваетсяНа(ВРЕГ(П1.ПолноеИмяФайла), "XLSX") Тогда
		
	КонецЕсли;
	
КонецПроцедуры

