&НаСервере
Процедура ПолучитьТаблицуЭтаповПоПараметрам(Пользователь, ДатаНачала, ДатаОкончания, Статусы, ПоказатьЗадачиБезДаты)
	
	Исполнители = Новый Массив;
	Если ТипЗнч(Пользователь) = Тип("СправочникСсылка.Пользователи") тогда
		
		ЗамПользователя = Пользователи_sd_сервер.ПодобратьЗамещениеОбратное(Пользователь, ТекущаяДата());
		
		Исполнители = Пользователи_sd_сервер.ПолучитьСписокМоихГрупп(Пользователь, ЗамПользователя);
		
		// ДИТ Поморцева Т.П. Задача 238786 16.08.21. начало
		//Исполнители.Добавить(Пользователь);
		//Исполнители.Добавить(ЗамПользователя);
		Для Каждого Элемент ИЗ ЗамПользователя Цикл
			Исполнители.Добавить(Элемент);
		КонецЦикла;	
		// ДИТ Поморцева Т.П. Задача 238786 16.08.21. конец
		
	Иначе
		Исполнители = Пользователи_sd_сервер.ПолучитьПользователейГруппы(Пользователь);
		Исполнители.Добавить(Пользователь);
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СостоянияДокументов.ДокументРегистратор КАК ДокументРегистратор,
	               |	СостоянияДокументов.Состояние КАК Состояние,
	               |	СостоянияДокументов.Исполнитель КАК Исполнитель,
	               |	СостоянияДокументов.Наблюдатель КАК Наблюдатель,
	               |	СостоянияДокументов.Статус КАК Статус,
	               |	СостоянияДокументов.НачалоРаботы КАК НачалоРаботы,
	               |	СостоянияДокументов.ЗавершениеРаботы КАК ЗавершениеРаботы,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(СостоянияДокументов.ДокументРегистратор) = ТИП(Документ.Операция)
	               |			ТОГДА ВЫБОР
	               |					КОГДА СостоянияДокументов.ДокументРегистратор.ДатаОтправленияФакт = ДАТАВРЕМЯ(1, 1, 1)
	               |						ТОГДА СостоянияДокументов.ДокументРегистратор.ДатаОтправления
	               |					ИНАЧЕ СостоянияДокументов.ДокументРегистратор.ДатаОтправленияФакт
	               |				КОНЕЦ
	               |		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	               |	КОНЕЦ КАК ДатаНачалаОперации,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(СостоянияДокументов.ДокументРегистратор) = ТИП(Документ.Операция)
	               |			ТОГДА ВЫБОР
	               |					КОГДА СостоянияДокументов.ДокументРегистратор.ДатаНазначенияФакт = ДАТАВРЕМЯ(1, 1, 1)
	               |						ТОГДА СостоянияДокументов.ДокументРегистратор.ДатаНазначения
	               |					ИНАЧЕ СостоянияДокументов.ДокументРегистратор.ДатаНазначенияФакт
	               |				КОНЕЦ
	               |		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	               |	КОНЕЦ КАК ДатаОкончанияОперации
	               |ИЗ
	               |	РегистрСведений.СостоянияДокументов КАК СостоянияДокументов
	               |ГДЕ
	               |	СостоянияДокументов.Статус В(&Статусы)
	               |	И (СостоянияДокументов.Исполнитель В (&Исполнители)
	               |			ИЛИ СостоянияДокументов.Наблюдатель В (&Исполнители))";
	Запрос.УстановитьПараметр("Статусы", Статусы);
	Запрос.УстановитьПараметр("Исполнители", Исполнители);
	Запрос.УстановитьПараметр("ПоказатьЗадачиБезДаты", ПоказатьЗадачиБезДаты);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		Если НЕ ПоказатьЗадачиБезДаты И (НЕ ЗначениеЗаполнено(Ответ.ДатаНачалаОперации) ИЛИ НЕ ЗначениеЗаполнено(Ответ.ДатаОкончанияОперации)) Тогда Продолжить; КонецЕсли;
		
		ДатаНачала = ?(ЗначениеЗаполнено(Ответ.ДатаНачалаОперации), Ответ.ДатаНачалаОперации, Ответ.НачалоРаботы);
		ДатаОкончания = ?(ЗначениеЗаполнено(Ответ.ДатаОкончанияОперации), Ответ.ДатаОкончанияОперации, Ответ.ЗавершениеРаботы);
		
		Если НЕ ЗначениеЗаполнено(ДатаНачала) Тогда ДатаНачала = ТекущаяДата(); КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда ДатаОкончания = ТекущаяДата(); КонецЕсли;
		
		НЭлемент = Расписание.Элементы.Добавить(ДатаНачала, ДатаОкончания);
		НЭлемент.Текст = "" + Ответ.Состояние + " " + Ответ.ДокументРегистратор;
				
	КонецЦикла;
	
КонецПроцедуры

