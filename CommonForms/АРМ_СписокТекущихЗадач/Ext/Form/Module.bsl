
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//ЗаполнениеТаблицыОбъектов();
	
	Пользователь = Пользователи.ТекущийПользователь();
	ПериодОтображения.ДатаНачала = ТекущаяДата()-24*3600;
	ПериодОтображения.ДатаОкончания = ТекущаяДата()+7*24*3600;
	
	Статусы.Добавить(перечисления.СтатусыЭтапов.НаВыполнение);
	Статусы.Добавить(перечисления.СтатусыЭтапов.ВРаботе);
	Статусы.Добавить(перечисления.СтатусыЭтапов.Отклонен);
	
	Календарь = ТекущаяДата();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнениеТаблицыОбъектов()
	
	ТЗОбъектовСостояния.Очистить();
	
	Для Каждого ЭлемСпр Из Метаданные.Справочники Цикл
		Попытка
			СостоянияЭлементов = ЭлемСпр.ТабличныеЧасти.Состояния;
			ЕстьСтатус = СостоянияЭлементов.Реквизиты.Статус;
			ТекСтр = ТЗОбъектовСостояния.Добавить();
			ТекСтр.ОбъектСостояние = ЭлемСпр.Имя;
			ТекСтр.ТипМетаданных = "Справочник.";
		Исключение
			СостоянияЭлементов = "";
		КонецПопытки;
	КонецЦикла;
			
	Для Каждого ЭлемДок Из Метаданные.Документы Цикл
		Попытка
			СостоянияЭлементов = ЭлемДок.ТабличныеЧасти.Состояния;
			ЕстьСтатус = СостоянияЭлементов.Реквизиты.Статус;
			ТекСтр = ТЗОбъектовСостояния.Добавить();
			ТекСтр.ОбъектСостояние = ЭлемДок.Имя;
			ТекСтр.ТипМетаданных = "Документ.";
		Исключение
			СостоянияЭлементов = "";
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ОбновитьОтображениеКалендарей()
	
	Элементы.Календарь.ВыделенныеДаты.Очистить();
	Элементы.Календарь.ВыделенныеДаты.Добавить(Календарь);
	
	//Расписание.ЕдиницаПериодическогоВарианта = ТипЕдиницыШкалыВремени.Неделя;
	Расписание.ТекущиеПериодыОтображения.Очистить();
	Расписание.ТекущиеПериодыОтображения.Добавить(Расписание.НачалоПериодаОтображения + 6 * 3600, Расписание.НачалоПериодаОтображения + 18 * 3600);
	
	//Расписание.ТекущиеПериодыОтображения.Добавить(Календарь, Календарь+Отображение);
	
	Возврат Календарь;
	
КонецФункции

