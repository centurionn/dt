&НаКлиенте
Процедура СформироватьДатыОтображения(Дата)

	НачальнаяДатаОтображения = ?(Отображение = 0,НачалоДня(Дата)+6*3600,?(Отображение = 1,НачалоНедели(Дата),НачалоМесяца(Дата)));	
	КонечнаяДатаОтображения = ?(Отображение = 0,КонецДня(Дата)-5*3600,?(Отображение = 1,КонецНедели(Дата),КонецМесяца(Дата)));

Конецпроцедуры 

&НаКлиенте
Процедура СформироватьПланировщик();

	Расписание.ТекущиеПериодыОтображения.Очистить();
	Расписание.ТекущиеПериодыОтображения.Добавить(НачальнаяДатаОтображения, КонечнаяДатаОтображения);

	Расписание.НачалоПериодаОтображения = НачальнаяДатаОтображения;
	Расписание.КонецПериодаОтображения = КонечнаяДатаОтображения;
	
КонецПроцедуры 
 
&НаКлиенте
Процедура СформироватьЭлементыШкалыПланировщика()

	ЭлементыШкалыВремени = Расписание.ШкалаВремени.Элементы;
	
	// день
	Если Отображение = 0 Тогда
		Расписание.ЕдиницаПериодическогоВарианта = ТипЕдиницыШкалыВремени.День;
		Расписание.НачалоПериодаОтображения = Календарь+6*3600;
		Расписание.КонецПериодаОтображения = Календарь+19*3600;
		Расписание.КратностьПериодическогоВарианта = 1;
		Расписание.ОтображатьПеренесенныеЗаголовки = Истина;
		Расписание.ШкалаВремени.Положение = ПоложениеШкалыВремени.Лево;
	    ЭлементыШкалыВремени[0].Кратность = 1;
	    ЭлементыШкалыВремени[0].Формат = "ДФ=ЧЧ:мм";
		ЭлементыШкалыВремени[0].Единица = ТипЕдиницыШкалыВремени.Час;
		
	// неделя	
	ИначеЕсли Отображение = 1 Тогда
		Расписание.ЕдиницаПериодическогоВарианта = ТипЕдиницыШкалыВремени.День;
		Расписание.КратностьПериодическогоВарианта = 7;
		Расписание.ОтображатьПеренесенныеЗаголовки = Ложь;
		Расписание.ШкалаВремени.Положение = ПоложениеШкалыВремени.Лево;
		ЭлементыШкалыВремени[0].Кратность = 1;
		ЭлементыШкалыВремени[0].Единица = ТипЕдиницыШкалыВремени.День;
		ЭлементыШкалыВремени[0].Формат = "ДЛФ=Д";
		
	// месяц	
	ИначеЕсли Отображение = 2 Тогда
		Расписание.КратностьПериодическогоВарианта = 1;
		Расписание.ОтображатьПеренесенныеЗаголовки = Истина;
		Расписание.ШкалаВремени.Положение = ПоложениеШкалыВремени.Лево;
		ЭлементыШкалыВремени[0].Кратность = 1;
		ЭлементыШкалыВремени[0].Единица = ТипЕдиницыШкалыВремени.Месяц;
		ЭлементыШкалыВремени[0].Формат = "ДЛФ=Д";
		
	КонецЕсли;
	
КонецПроцедуры 

