
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// ++ Дудоров С.В. Ticket#61931 29.11.2022

	//Документ = Параметры.ДокументПоступления;
	//ДокументОбъект = Документ.ПолучитьОбъект();
	//// Евросиб Фролов (18.02.2022 Task №44768
	//// Обернул блокировку в попытку чтобы выходило понятное уведомление, а не сообщение об ошибке
	//// (если документ был предварительно изменен в форме).
	//Попытка
	//	ДокументОбъект.Заблокировать();
	//Исключение
	//	ОбщегоНазначения.СообщитьПользователю("Документ заблокирован для изменений. Попробуйте открыть его заново и повторить возврат задачи");
	//	Отказ = Истина;
	//КонецПопытки;
	//// Евросиб Фролов)

	//Для каждого СтрокаСостояния из Документ.Состояния Цикл
	//	НоваяСтрока = Задачи.Добавить();
	//	ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаСостояния);
	//КонецЦикла;

	ОбъектСсылка = Параметры.ДокументПоступления;
	Если ОбъектСсылка <> Неопределено Тогда
		ОбъектСогласования = ОбъектСсылка.ПолучитьОбъект();
	Иначе
		ОбщегоНазначения.СообщитьПользователю(
			"Объект согласования не определен. Попробуйте запустить процедуру отмены задачи из формы объекта или формы списка объекта.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Попытка
		ОбъектСогласования.Заблокировать();
	Исключение
		ОбщегоНазначения.СообщитьПользователю(
			"Объект согласования заблокирован для изменений. Попробуйте открыть его заново и повторить возврат задачи");
		Отказ = Истина;
		Возврат;
	КонецПопытки;
	
	СтруктураСогласования = СогласованиеСервер.СогласованияДокумента(ОбъектСсылка);		
	Согласования 		  = СтруктураСогласования.Согласования;
	НачальныйСтатус       = СтруктураСогласования.НачальныйСтатус;
	
	СтатусВыполнено 	  = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Выполнен"); 
	
	Если не РольДоступна("ПолныеПрава") 
		и СтруктураСогласования.ТекущемуПользователюНеДоступенВозврат Тогда
		Сообщить("Возврат задач доступен только пользователям маршрута!");
		Отказ = Истина;
	КонецЕсли;	
	
	Пока Согласования.Следующий() Цикл
		// Для возврата доступны только состояния со строками больше последнего выполненного согласования	
		Если (Согласования.НомерСтроки <= СтруктураСогласования.НомерСтрокиПоследнегоВыполненногоСогласования) 
			Тогда 
				Продолжить;
		КонецЕсли; 
		// Убираем состояния со статусами, с которыми возврат не имеет смысл
		Если не Согласования.Статус = СтатусВыполнено Тогда
			Продолжить;
		КонецЕсли;	
		НоваяСтрока = Задачи.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Согласования);
	КонецЦикла;
	
	//ИспользоватьСтатус = Истина;
	//Статус = Перечисления.СтатусыЭтапов.Выполнен;

	// -- Дудоров С.В. Ticket#61931 29.11.2022
	
	//Евросиб Коханенко Н.А. #64811 27.01.2023 (( 
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #64811 27.01.2023 )) 
	
КонецПроцедуры

