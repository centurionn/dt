&НаСервере
Процедура ПриЗакрытииНаСервере()
	//++ Глеков Д.В. Ticket#0255784  03.02.2022 
	РазблокироватьДокумент();
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	//++ Глеков Д.В. Ticket#0255784  03.02.2022 
	Если ЗавершениеРаботы <> ИСТИНА Тогда
		
		ПриЗакрытииНаСервере();
	
	КонецЕсли;
	//-- Глеков Д.В. Ticket#0255784  03.02.2022
КонецПроцедуры

&НаКлиенте
Процедура ЗадачиВозвратЗадачиПриИзменении(Элемент)
	КоличествоПомеченных = 0;
	Для каждого СтрокаЗадач из Задачи Цикл
		Если СтрокаЗадач.ВозвратЗадачи Тогда
			КоличествоПомеченных = КоличествоПомеченных+1;
		КонецЕсли;
	КонецЦикла;
	Если КоличествоПомеченных>1 Тогда
		Сообщить("Может быть выбрана только одна задача");
		ТекущиеДанные = Элементы.Задачи.ТекущиеДанные;
		ТекущиеДанные.ВозвратЗадачи = Ложь;
	КонецЕсли;
КонецПроцедуры

//++ Глеков Д.В. Ticket#0255784  03.02.2022 
&НаСервере
Процедура РазблокироватьДокумент()
	// ++ Дудоров С.В. Ticket#61931 29.11.2022
	//ДокументОбъект = Документ.ПолучитьОбъект();
	ДокументОбъект = ОбъектСсылка.ПолучитьОбъект();
	// -- Дудоров С.В. Ticket#61931 29.11.2022
	Если ДокументОбъект.Заблокирован() Тогда
		ДокументОбъект.Разблокировать();
	КонецЕсли; 
КонецПроцедуры // РазблокироватьДокумент()

&НаКлиенте
Процедура Отмена(Команда)
	//++ Глеков Д.В. Ticket#0255784  03.02.2022  
	РазблокироватьДокумент();	
	//-- Глеков Д.В. Ticket#0255784  03.02.2022
	ЭтаФорма.Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВозврат(Команда)
	
	Если Не ЗначениеЗаполнено(ПричинаВозврата) Тогда
		Сообщить("Укажите причину возврата");
	Иначе
		КоличествоПомеченных = 0;
		Для каждого СтрокаЗадач из Задачи Цикл
			Если СтрокаЗадач.ВозвратЗадачи Тогда
				КоличествоПомеченных = КоличествоПомеченных+1;
			КонецЕсли;
		КонецЦикла;
		Если КоличествоПомеченных<1 Тогда
			Сообщить("Укажите задачу для возврата");
		Иначе
			// ++ Дудоров С.В. Ticket#61931 29.11.2022
			//ВыполнитьВозвратНаСервере();
			////++ Зубов US45321 TA45322 28.01.2022
			//Если ТипЗнч(Документ) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
			//	Оповестить("ЗаписьПоступлениеТоваровУслуг"); // ++ ДИТ Сгонник, 21-10-26 №27109
			//ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.КорректировкаПоступления") Тогда
			//	Оповестить("ЗаписьКорректировкиПоступления");
			//// Евросиб Фролов (16.02.2022 Task №44768	
			//ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.Заявка") Тогда
			//	Оповестить("ЗаписьЗаявки");
			//// Евросиб Фролов)
			//// Евросиб Фролов (04.05.2022 Task №41900	
			//ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ПСЦ") Тогда
			//	Оповестить("ЗаписьПСЦ");
			//// Евросиб Фролов)
			//КонецЕсли;
			//-- Зубов US45321 TA45322 28.01.2022
			
			ВыполнитьВозвратНаСервере();

			ВладелецФормы = ЭтаФорма.ВладелецФормы;
			
			ЭтаФорма.Закрыть();
			
			Если не СтрНайти(ВладелецФормы.ИмяФормы,"ФормаСписка") > 0 Тогда 
				
				Попытка
					ВладелецФормы.Закрыть();
				Исключение
				КонецПопытки;
				
				ПоказатьЗначение(,ОбъектСсылка);			
				
			КонецЕсли;	
			// --Дудоров С.В. Ticket#61931 29.11.2022

		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьВозвратНаСервере()
	// ++Дудоров С.В. Ticket#61931 29.11.2022
	//ДокументОбъект = Документ.ПолучитьОбъект();
	ДокументОбъект = ОбъектСсылка.ПолучитьОбъект();
	// обновляем информацию по состоянию 
	//МаршрутизацияКлиент.ТекущийИсполнитель_СтатусПриИзменении(Объект, ТекущийИсполнитель_Состояние, ТекущийИсполнитель_Статус, ТекущийИсполнитель_Исполнитель, ТекущийИсполнитель_Наблюдатель);
	
	// --Дудоров С.В. Ticket#61931 29.11.2022

	Если ДокументОбъект.Заблокирован() Тогда
		ДокументОбъект.Разблокировать();
	КонецЕсли;
	
	//Евросиб Каблов 13.01.2022 ( 62514
	ДокументОбъект.ДополнительныеСвойства.Вставить("ВозвращаемыеЗадачи", Новый Массив);
	//Евросиб Каблов 13.01.2022 )
	
	Для каждого СтрокаЗадачи из Задачи Цикл
		Если СтрокаЗадачи.ВозвратЗадачи Тогда
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Состояние",СтрокаЗадачи.Состояние);
			ПараметрыОтбора.Вставить("Исполнитель",СтрокаЗадачи.Исполнитель);
			ПараметрыОтбора.Вставить("Наблюдатель",СтрокаЗадачи.Наблюдатель);
			ПараметрыОтбора.Вставить("Статус",СтрокаЗадачи.Статус);
			МассивСтрок = ДокументОбъект.Состояния.НайтиСтроки(ПараметрыОтбора);
			Для каждого СтрокаСостояния из МассивСтрок Цикл
				
				// ++Дудоров С.В. Ticket#61931 29.11.2022
				//СтрокаСостояния.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение");
				СтрокаСостояния.Статус = НачальныйСтатус;
				// --Дудоров С.В. Ticket#61931 29.11.2022
				
				СтрокаСостояния.ПримечаниеЗадачаИсполнителю = Истина;
				СтрокаСостояния.Комментарий = ПричинаВозврата;				
				
				// ++ ДИТ Сгонник, 21-10-26 №27109
				//СтрокаСостояния.ЗавершениеРаботы = Дата("00010101"); 
				СтрокаСостояния.ДатаВозвратаИсполнителю = ТекущаяДата();
				// -- ДИТ Сгонник, 21-10-26 №27109
				
				//Евросиб Каблов 13.01.2022 ( 62514
				СтрокаСостояния.ВыполнениеЗафиксировано = Ложь;
				ДокументОбъект.ДополнительныеСвойства.ВозвращаемыеЗадачи.Добавить(СтрокаЗадачи.Состояние);
				//Евросиб Каблов 13.01.2022 )
				
				//ДИТ Шевченко А.В. US 92974 TA 99395 04.03.2025
				Если СтрокаСостояния.Исполнитель = Справочники.Пользователи.Робот Тогда
					Если ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
						РезультатЗапроса = Новый Массив;
						Для каждого Стр из ДокументОбъект.ПримененныйМаршрут.Состояния Цикл
							Статус = ?(РезультатЗапроса.Количество() = 0, ДокументОбъект.ПримененныйМаршрут.НачальныйСтатус, Перечисления.СтатусыЭтапов.Новый);
							РезультатЗапроса.Добавить(Новый Структура("Состояние, Исполнитель, Наблюдатель, Статус, Ссылка, ПредыдущиеЭтапы, ОРКПоДоговору, ОтветственныйЗаУчет, ОтветственныйЗаДоговор, НормативИсполненияСМоментаСоздания, ТребуетсяУказатьНаблюдателя, ТребуетсяУказатьИсполнителя, ВидНормативаИсполнения, РуководительСотрудника, ВыбиратьИсполнителяЕслиНеЗаполненРуководительСотрудника, ВыполнятьАвтоматическиЕслиПредыдущаяЗадачаСТемЖеИсполнителем, УсловиеАвтоматическогоВыполнения", Стр.Состояние, Стр.Исполнитель, Стр.Наблюдатель, Статус, ДокументОбъект.ПримененныйМаршрут, Стр.ПредыдущиеЭтапы, Стр.СопровождениеПоДоговору, Стр.ОтветственныйЗаУчет, Стр.ОтветственныйЗаДоговор, Стр.НормативИсполненияСМоментаСоздания, Стр.ТребуетсяУказатьНаблюдателя, Стр.ТребуетсяУказатьИсполнителя, Стр.ВидНормативаИсполнения, Стр.РуководительСотрудника, Стр.ВыбиратьИсполнителяЕслиНеЗаполненРуководительСотрудника, Стр.ВыполнятьАвтоматическиЕслиПредыдущаяЗадачаСТемЖеИсполнителем, Стр.УсловиеАвтоматическогоВыполнения));
						КонецЦикла;
						МаршрутизацияСервер.ОтработатьЗамещениеДелегирование(РезультатЗапроса, Перечисления.МаршрутизируемыеОбъекты.ПоступлениеТоваровУслуг, ДокументОбъект.Дата, ДокументОбъект.ДоговорКонтрагента);
						
						Для Каждого СтрР Из РезультатЗапроса Цикл
							Если СтрР.Состояние = СтрокаСостояния.Состояние Тогда
								СтрокаСостояния.Исполнитель = СтрР.Исполнитель;
								Если НЕ ЗначениеЗаполнено(СтрокаСостояния.Исполнитель) Тогда СтрокаСостояния.Исполнитель = ДокументОбъект.Автор; КонецЕсли;
							КонецЕсли;	
						КонецЦикла;	
						
					КонецЕсли;
				КонецЕсли;	
				//ДИТ Шевченко А.В. US 92974 TA 99395 04.03.2025
				
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	// Евросиб Фролов (2.03.2022 Task №44768
	ДокументОбъект.ДополнительныеСвойства.Вставить("ВозвращенаЗадача");
	// Евросиб Фролов)
	
	ДокументОбъект.Записать();
	
КонецПроцедуры

