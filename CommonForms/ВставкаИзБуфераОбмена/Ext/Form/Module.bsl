&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Вагоны") Тогда
		РежимРаботы = "Вагоны";
	ИначеЕсли Параметры.Свойство("КТК") Тогда
		РежимРаботы = "КТК";
//Евросиб Гудкова( 09.09.2020 Ticket№ 0204605
		ТД.Область("R1C1").Текст = "Номер КТК";
//Евросиб Гудкова( 04.01.2020 
	ИначеЕсли Параметры.Свойство("Накладные") Тогда
		РежимРаботы = "Накладные";
		ВозвращатьСтроки = Истина;
// Евросиб Гудкова) 			
	// ++ ДИТ_Агафонов_task 37859 19.08.2022
	ИначеЕсли Параметры.Свойство("Контрагенты") Тогда
		РежимРаботы = "Контрагенты";
		ТД.Область("R1C1").Текст = "Наименование контрагента";
	ИначеЕсли Параметры.Свойство("Номенклатура") Тогда
		РежимРаботы = "Номенклатура";
		ТД.Область("R1C1").Текст = "Наименование номенклатуры";
	// -- ДИТ_Агафонов_task 37859 19.08.2022
	КонецЕсли;
	Если Параметры.Свойство("ПередаватьИсходныеНомера") Тогда
		ВозвращатьСтроки = Истина;
	КонецЕсли;
//Евросиб Гудкова( 09.09.2020 Ticket№ 0204605
	Сч = 2;
	Если Параметры.Свойство("Контрагент") Тогда
		ОбластьКонтрагент = "C" + Сч;
		ТД.Область("R1" + ОбластьКонтрагент).Текст = "Контрагент";
		ТД.Область("R1" + ОбластьКонтрагент).ШиринаКолонки = 50;
    	ЕстьКонтрагент = Истина;
		Сч = Сч + 1;
		Элементы.ВозвращатьСтроки.Видимость = Ложь;
	КонецЕсли;
// Евросиб Гудкова) 	
	Если Параметры.Свойство("РазмерКТК") Тогда
		ПоказыватьРазмерКТК = Параметры.РазмерКТК;
//Евросиб Гудкова( 17.09.2020 Ticket№ 0204605
		ОбластьРазмерКТК = "C" + Сч;
		ТД.Область("R1" + ОбластьРазмерКТК).Текст = "Размер КТК";
		ТД.Область("R1" + ОбластьРазмерКТК).ШиринаКолонки = 10;
		Сч = Сч + 1;
// Евросиб Гудкова) 		
	КонецЕсли;

	Если Параметры.Свойство("ПоказыватьДатуВзятия") Тогда
		ОбластьДатаВзятия = "C" + Сч;
		ДопСекция = ТД.ПолучитьОбласть("R1" + ОбластьДатаВзятия);//Гудкова "R1C3");
		ТД.Область("R1" + ОбластьДатаВзятия).Текст = "Дата взятия";
		ТД.Область("R1" + ОбластьДатаВзятия).ШиринаКолонки = 20;
    	//ТД.Присоединить(ДопСекция, 1, ТД.ВысотаТаблицы, ТД.ШиринаТаблицы);
		ПоказыватьДатуВзятия = Истина;
		Сч = Сч + 1;
	КонецЕсли;
	
	Если Параметры.Свойство("ПрибытиеНаТерминалОтпр") Тогда
		ОбластьПрибытиеНаТерминалОтпр = "C" + Сч;
		ТД.Область("R1" + ОбластьПрибытиеНаТерминалОтпр).Текст = "Дата приема в пользование";
		ТД.Область("R1" + ОбластьПрибытиеНаТерминалОтпр).ШиринаКолонки = 25;
    	ПоказатьПрибытиеНаТерминалОтпр = Истина;
		Сч = Сч + 1;
	КонецЕсли;
	
	Если Параметры.Свойство("ДатаДоставкиГруза") Тогда
		ОбластьДатаДоставкиГруза = "C" + Сч;
		ТД.Область("R1" + ОбластьДатаДоставкиГруза).Текст = "Дата доставки груза";
		ТД.Область("R1" + ОбластьДатаДоставкиГруза).ШиринаКолонки = 25;
    	ПоказатьДатаДоставкиГруза = Истина;
		Сч = Сч + 1;
	КонецЕсли; 
	
	Если Параметры.Свойство("ДатаПриемаВСток") Тогда
		ОбластьДатаПриемаВСток = "C" + Сч;
		ТД.Область("R1" + ОбластьДатаПриемаВСток).Текст = "Дата приема в сток";
		ТД.Область("R1" + ОбластьДатаПриемаВСток).ШиринаКолонки = 20;
    	ЕстьДатаПриемаВСток = Истина;
		Сч = Сч + 1;
	КонецЕсли; 
	
	Если Параметры.Свойство("НомерТС") Тогда
		ОбластьНомерТС = "C" + Сч;
		ТД.Область("R1" + ОбластьНомерТС).Текст = "Номер ТС";
		ТД.Область("R1" + ОбластьНомерТС).ШиринаКолонки = 15;
    	ЕстьНомерТС = Истина;
		Сч = Сч + 1;
	КонецЕсли; 
	
	Если Параметры.Свойство("ВодительТС") Тогда
		ОбластьВодительТС = "C" + Сч;
		ТД.Область("R1" + ОбластьВодительТС).Текст = "Водитель";
		ТД.Область("R1" + ОбластьВодительТС).ШиринаКолонки = 100;
    	ЕстьВодительТС = Истина;
		Сч = Сч + 1;
	КонецЕсли; 
// Евросиб Гудкова) 	
	Если Параметры.Свойство("Автовставка") Тогда
		Автовставка = Истина;
	Иначе
		Автовставка = Ложь;
	КонецЕсли;
	
	Если Параметры.Свойство("ФорматДаты") Тогда
		ФорматДаты = Параметры.ФорматДаты;
	КонецЕсли;
	// ++ ДИТ_Агафонов_task 37859 19.08.2022
	Если Параметры.Свойство("ВозвращатьСтроки") Тогда
		ВозвращатьСтроки = Параметры.ВозвращатьСтроки;
	КонецЕсли;
	// -- ДИТ_Агафонов_task 37859 19.08.2022
	//++ Зубов US 33131 TA 38910 29.10.2021
	Если Параметры.Свойство("ВозвращатьСтрокиНедоступно") Тогда
		ВозвращатьСтрокиНедоступно = Параметры.ВозвращатьСтрокиНедоступно;
	КонецЕсли;
	//-- Зубов US 33131 TA 38910 29.10.2021
	//++ Зубов Ticket#0250132 15.11.2021  // ДИТ Сержантова А.С. 02.11.2023 US 76956 ТА 76958 закомментировала, убрала параметр 
	//Если Параметры.Свойство("СоздаватьКТК") Тогда
	//	СоздаватьКТК = Параметры.СоздаватьКТК;
	//Иначе
	//	СоздаватьКТК = Ложь;
	//КонецЕсли;
	//-- Зубов Ticket#0250132 15.11.2021
	
	//++ Зубов US 45162 TA 45703 21.01.2022
	Если Параметры.Свойство("ПериодДействияРелиза") Тогда
		ПериодДействияРелиза = Параметры.ПериодДействияРелиза;
	Иначе
		ПериодДействияРелиза = Неопределено;
	КонецЕсли;
	//-- Зубов US 45162 TA 45703 21.01.2022
	
	//Евросиб Бозняков( 06.04.2022 TASK 51077
	Если Параметры.Свойство("КлиентскийКТК") Тогда
		Элементы.РефрижераторныйКТК.Видимость = Истина;
		Элементы.ВозвращатьСтроки.Видимость = Ложь;
		КлиентскийКТК = Параметры.КлиентскийКТК; 
	КонецЕсли;
	//Евросиб Бозняков )
	
	//Евросиб Каблов 16.08.2022 ( US41519
	Если Не Параметры.Свойство("СоздаватьКТКПриПереносеВДокумент", СоздаватьКТКПриПереносеВДокумент) Тогда
		СоздаватьКТКПриПереносеВДокумент = Ложь;
	КонецЕсли;
	//Евросиб Каблов 16.08.2022 )
	
	//Евросиб Коханенко Н.А. #64811 27.01.2023 (( 
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #64811 27.01.2023 ))
	
	// ++ Евросиб Дудоров С.В. US 57543 30.01.2023 
	Если Параметры.Свойство("РефрижераторныйКТК") Тогда
		Элементы.РефрижераторныйКТК.Видимость = Истина;
		РефрижераторныйКТК = Параметры.РефрижераторныйКТК;
	КонецЕсли;
	// -- Евросиб Дудоров С.В. US 57543 30.01.2023  
	
	//Субботин 75462 05.10.2023 Начало
	Если Параметры.Свойство("ЭтоРефсцеп") Тогда
		ЭтоРефсцеп = Истина;
	КонецЕсли; 
	//Субботин 75462 05.10.2023 Конец  
	// ДИТ US 93168 ТА 96594 Лаврентьев О.М. Начало: 26.11.2024
	Если Параметры.Свойство("ПоказыватьДатуИзготовленияКТК") Тогда
		ОбластьДатаИзготовленияКТК = "C" + Сч;
		ДопСекция = ТД.ПолучитьОбласть("R1" + ОбластьДатаИзготовленияКТК);
		ТД.Область("R1" + ОбластьДатаИзготовленияКТК).Текст = "Дата изготовления КТК";
		ТД.Область("R1" + ОбластьДатаИзготовленияКТК).ШиринаКолонки = 20;
		ПоказыватьДатуИзготовленияКТК = Истина;
		Сч = Сч + 1;
	КонецЕсли;
	// ДИТ US 93168 ТА 96594 Лаврентьев О.М. Конец: 26.11.2024
	
	//ТрундуковСА 112690 26.06.2025 начало
	Если Параметры.Свойство("СобственныйКТК") Тогда
		СобственныйКТК = Истина;
	Иначе
		СобственныйКТК = Ложь;
	КонецЕсли;
	//ТрундуковСА 112690 26.06.2025 конец
КонецПроцедуры

//Евросиб Коханенко Н.А. #64811 27.01.2023 (( 
&НаКлиенте
Процедура ОткрытьОкноСИнструкциями(Форма, Команда)
	ИнструкцииКлиент.ОткрытьОкноСИнструкциями(ЭтаФорма, Команда);
КонецПроцедуры 
