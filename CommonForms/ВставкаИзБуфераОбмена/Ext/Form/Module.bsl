				НСтр.ДатаПриемаВСток = ПреобразованиеВДату(ТД.Область("R"+Формат(Сч, "ЧГ=0")+ОбластьДатаПриемаВСток).Текст);
			КонецЕсли;
			Если ЕстьКонтрагент Тогда
				СтрКонтрагент = СокрЛП(ТД.Область("R"+Формат(Сч, "ЧГ=0")+ОбластьКонтрагент).Текст);
				Нстр.Контрагент = ПолучитьКонтрагентаПоСинониму(СтрКонтрагент);
				Нстр.СтрокаКонтрагент = СтрКонтрагент;
			КонецЕсли;
			Если ЕстьНомерТС Тогда
				НСтр.НомерТС = СокрЛП(ТД.Область("R"+Формат(Сч, "ЧГ=0")+ОбластьНомерТС).Текст);
			КонецЕсли;
// Евросиб Гудкова)
		КонецЕсли;
		
		Сч = Сч + 1;
		ПрочСтрока = ТД.Область("R"+Формат(Сч, "ЧГ=0")+"C1").Текст;
	КонецЦикла;
	
	//Евросиб Каблов 16.08.2022 ( US41519
	Если ЕстьНекорректныйНомерКТК Тогда
		ПоказатьПредупреждение(, "Не удалось записать контейнер!");
	КонецЕсли;
	//Евросиб Каблов 16.08.2022 )
	
	// после распознавания, если стоит флаг "Автовставка", вызвать процедуру переноса значений в документ
	Если Автовставка Тогда
		ПеренестиВДокументКлиент();
	КонецЕсли;
	
КонецПроцедуры


