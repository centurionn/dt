&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.Декорация5.Видимость = ?(РежимРаботы = "КТК",Истина,Ложь);
	Элементы.Декорация6.Видимость = ?(РежимРаботы = "КТК",Истина,Ложь);
	Элементы.РезультатДатаВзятия.Видимость = ?(ПоказыватьДатуВзятия,Истина,Ложь);
	Элементы.РезультатДатаДоставкиГруза.Видимость = ?(ПоказатьДатаДоставкиГруза,Истина,Ложь);
	Элементы.РезультатВремяПрибытияНаТерминал.Видимость = ?(ПоказатьПрибытиеНаТерминалОтпр,Истина,Ложь);
	Элементы.ФорматДаты.Видимость = ?(ПоказыватьДатуВзятия ИЛИ ПоказатьДатаДоставкиГруза,Истина,Ложь);
	Элементы.РезультатДатаПриемаВСток.Видимость = ?(ЕстьДатаПриемаВСток,Истина,Ложь);
	Элементы.РезультатКонтрагент.Видимость = ?(ЕстьКонтрагент,Истина,Ложь);
	Элементы.РезультатСтрокаКонтрагент.Видимость = ?(ЕстьКонтрагент,Истина,Ложь);
	Элементы.РезультатВодительТС.Видимость = ?(ЕстьВодительТС,Истина,Ложь);
	Элементы.РезультатНомерТС.Видимость = ?(ЕстьНомерТС,Истина,Ложь);
	//++ Зубов US 33131 TA 38910 29.10.2021
	Элементы.ВозвращатьСтроки.ТолькоПросмотр = ?(ВозвращатьСтрокиНедоступно,Истина,Ложь);
	//-- Зубов US 33131 TA 38910 29.10.2021
	// ++ ДИТ_Агафонов_task 37859 19.08.2022
	Элементы.РефрижераторныйКТК.Видимость = РежимРаботы = "КТК";	
	// -- ДИТ_Агафонов_task 37859 19.08.2022
	Если Автовставка Тогда
		// необходимо установить обработчик ожидания для работы механизма копирования/вставки через WScript.Shell
		// в противном случае, скрипт не успевает вставить данные в форму, а 1С уже проверяет их наличие
		ПодключитьОбработчикОжидания("ПроверкаСодержимогоЯчейки", 0.1, Истина);
		
		wsh=Новый COMОбъект("WScript.Shell");    
		ЭтаФорма.ТекущийЭлемент = Элементы.ТД;
		Элементы.ТД.ТекущаяОбласть = ЭтаФорма.ТД.Область("R2C1");
		wsh.SendKeys("^v");
		wsh.SendKeys("^м");
    КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьДанные(Команда)
	
	ПроверкаСодержимогоЯчейки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаСодержимогоЯчейки() 
	
	Сч = 2;
	Результат.Очистить();
	
	ПрочСтрока = ТД.Область("R"+Формат(Сч, "ЧГ=0")+"C1").Текст;
	
	// блок для проверки копирования/вставки
	//ДИТ Авдеева В.С. 0284196 05.09.2022 Начало 
	//Если ПрочСтрока = "" Тогда 
	Если Не ЗначениеЗаполнено(ПрочСтрока) Тогда	
	//ДИТ Авдеева В.С. 0284196 05.09.2022 Конец
		Возврат;
	КонецЕсли;
	ОтключитьОбработчикОжидания("ПроверкаСодержимогоЯчейки");
	///////////////////////
	
	//Евросиб Каблов 16.08.2022 ( US41519
	ЕстьНекорректныйНомерКТК = Ложь;
	//Евросиб Каблов 16.08.2022 )
	
	//ДИТ Авдеева В.С. 0284196 05.09.2022 Начало 
	//Пока ПрочСтрока <> "" Цикл
	Пока ЗначениеЗаполнено(ПрочСтрока) Цикл
	//ДИТ Авдеева В.С. 0284196 05.09.2022 Конец
	
		//ДИТ, Беляев СЮ, Код-ревью, 22-12-2023, начало (т.к. включен вывод заголовков таб.документа появились номера строк у пользователя)
		НомерТекущейСтроки = Сч; 
		//ДИТ, Беляев СЮ, Код-ревью, 22-12-2023, конец
		
//Евросиб Гудкова( 17.09.2020 Ticket№ 0204605
//было		СтрокаРазмерКТК = ТД.Область("R"+Сч+"C2").Текст;
		СтрокаРазмерКТК = СокрЛП(ТД.Область("R"+Формат(Сч, "ЧГ=0")+ОбластьРазмерКТК).Текст);
// Евросиб Гудкова) 			
		Если ПоказыватьДатуВзятия Тогда
			СтрокаДата = СокрЛП(ТД.Область("R"+Формат(Сч, "ЧГ=0")+ОбластьДатаВзятия).Текст);
		КонецЕсли;
		// ДИТ US 93168 ТА 96594 Лаврентьев О.М. Начало: 26.11.2024
		Если ПоказыватьДатуИзготовленияКТК Тогда
			СтрокаДатаИзготовленияКТК = СокрЛП(ТД.Область("R"+Формат(Сч, "ЧГ=0")+ОбластьДатаИзготовленияКТК).Текст);
			СтрокаДатаИзготовленияКТК = "01." + СтрокаДатаИзготовленияКТК;
		КонецЕсли;
		// ДИТ US 93168 ТА 96594 Лаврентьев О.М. Конец: 26.11.2024
		Если ПоказатьПрибытиеНаТерминалОтпр Тогда
			СтрДатаПрибытия = СокрЛП(ТД.Область("R"+Формат(Сч, "ЧГ=0")+ОбластьПрибытиеНаТерминалОтпр).Текст);
		КонецЕсли;
		Если ПоказатьДатаДоставкиГруза Тогда
			СтрДатаДоставкиГруза = СокрЛП(ТД.Область("R"+Формат(Сч, "ЧГ=0")+ОбластьДатаДоставкиГруза).Текст);
		КонецЕсли;
		НСтр = Результат.Добавить();
		НСтр.ПрочитаннаяСтрока = ПрочСтрока;
		Если РежимРаботы = "Вагоны" Тогда
			НСтр.ПрочитаннаяСсылка = Грузы_сервер.НайтиВагон(ПрочСтрока);
		КонецЕсли;
//Евросиб Гудкова( 04.01.2020 
		Если Режимработы = "Накладные" Тогда
			НСтр.ПрочитаннаяСсылка = НайтиНакладную(ПрочСтрока);
		КонецЕсли;
// Евросиб Гудкова) 			

		// ++ ДИТ_Агафонов_task 37859 19.08.2022
		Если Режимработы = "Контрагенты" Тогда
			НСтр.ПрочитаннаяСсылка = НайтиКонтрагента(ПрочСтрока);
		КонецЕсли;
		Если Режимработы = "Номенклатура" Тогда
			НСтр.ПрочитаннаяСсылка = НайтиНоменклатуру(ПрочСтрока);
		КонецЕсли;
		// -- ДИТ_Агафонов_task 37859 19.08.2022

		Если РежимРаботы = "КТК" Тогда
			//Евросиб СубботинВ #102415 18.02.2025 Начало // добавил проверку на заполнение поля размера 
			//Евросиб СубботинВ #88346 11.07.2024 Начало 
			//Если ЗначениеЗаполнено(ОбластьРазмерКТК) тогда
			Если ЗначениеЗаполнено(ОбластьРазмерКТК) и ЗначениеЗаполнено(СтрокаРазмерКТК) Тогда
			//Евросиб СубботинВ #102415 18.02.2025 Конец
				НСтр.РазмерКТКСтрока = СокрЛП(СтрокаРазмерКТК);
				НСтр.РазмерКТК = ПолучитьТипоразмерКТК(СокрЛП(СтрокаРазмерКТК), РефрижераторныйКТК); //Евросиб Бозняков( 06.04.2022 TASK 51077 Добавлен параметр "РефрижераторныйКТК"
			КонецЕсли;
			//Евросиб СубботинВ #88346 11.07.2024 Конец
			НСтр.ВычисленноеКонтрольноеЧисло = ?(СтрДлина(ПрочСтрока) = 11,РаботаСКонтейнерамиСервер.ПолучитьКонтрольноеЧисло(Лев(ПрочСтрока,4), Сред(ПрочСтрока,5,6)),0);
			НСтр.КонтрольноеЧислоПользователя = Прав(ПрочСтрока,1);
			Если ПоказыватьДатуВзятия Тогда
				//++ Зубов US 33131 TA 43877 16.12.2021
				//НСтр.ПрочитаннаяСсылка = НайтиКТК(ПрочСтрока);
				НСтр.ПрочитаннаяСсылка = НайтиКТК(ПрочСтрока,НСтр.РазмерКТК); 
				НСтр.РазмерКТК = ВыбратьНужныйРазмерКТК(НСтр.РазмерКТК,НСтр.ПрочитаннаяСсылка);
