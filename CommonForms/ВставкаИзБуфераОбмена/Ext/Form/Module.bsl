&НаСервере
Функция СоздатьДозаполнитьКонтейнерыСервер()
	
	Для каждого Стр из Результат Цикл
			
		Если Не ЗначениеЗаполнено(Стр.ПрочитаннаяСсылка) И ЗначениеЗаполнено(Стр.ПрочитаннаяСтрока) И ЗначениеЗаполнено(Стр.РазмерКТК) Тогда
			Если ПроверитьКорректностьНомераКонтейнера(Стр) Тогда
				Стр.ПрочитаннаяСсылка = РаботаСКонтейнерамиСервер.СоздатьКТК(Стр.ПрочитаннаяСтрока, Стр.РазмерКТК);
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(Стр.ПрочитаннаяСсылка) И Не ЗначениеЗаполнено(Стр.ПрочитаннаяСсылка.ТипТЕ) И ЗначениеЗаполнено(Стр.РазмерКТК) Тогда
			КонтейнерОбъект = Стр.ПрочитаннаяСсылка.ПолучитьОбъект();
			КонтейнерОбъект.ТипТЕ = Стр.РазмерКТК;
			КонтейнерОбъект.Записать();
		КонецЕсли;
		
	КонецЦикла;
		
КонецФункции

//Евросиб Каблов 16.08.2022 US41519
&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьКорректностьНомераКонтейнера(НСтр)
	
	НомерКорректный = Истина;
	
	Если НСтр.ВычисленноеКонтрольноеЧисло <> НСтр.КонтрольноеЧислоПользователя Или Не РаботаСКонтейнерамиСервер.КорректнаяМаска(Лев(НСтр.ПрочитаннаяСтрока,4),Сред(НСтр.ПрочитаннаяСтрока,5,6)) Тогда
		НомерКорректный = Ложь;
	КонецЕсли;
	
	Возврат НомерКорректный;
					
КонецФункции
