&НаКлиенте
Процедура Диалоги(Команда)
	
	ТекСтр = Элементы.ГруппаСтраницы.ТекущаяСтраница;
	
	ТекД = Неопределено;
	
	Если ТекСтр.Имя = "ГруппаЗапросы" Тогда
		ТекД = Элементы.СписокЗапросы.ТекущаяСтрока;
	ИначеЕсли ТекСтр.Имя = "ГруппаЗаявки" Тогда
		ТекД = Элементы.Заявки.ТекущаяСтрока;
	ИначеЕсли ТекСтр.Имя = "ГруппаДокументыПользователя" Тогда
		ТекД = Элементы.МоиДокументыФайлы.ТекущаяСтрока;
	ИначеЕсли ТекСтр.Имя = "ГруппаПСЦ" Тогда
		ТекД = Элементы.ПСЦДоговоры.ТекущиеДанные;		
	ИначеЕсли ТекСтр.Имя = "ГруппаФинансовая" Тогда
		ТекД = Элементы.ФинДокументы.ТекущиеДанные;		
	ИначеЕсли ТекСтр.Имя = "ГруппаАрхив" Тогда
		ТекД = Элементы.СписокДокументов.ТекущиеДанные;		
	Иначе
		Возврат;
	КонецЕсли;

	//Если ТекД = Неопределено Тогда
	//	Сообщить("Не выбран документ для создания чата по нему!");
	//	Возврат;
	//КонецЕсли;
	
	Попытка
		КонтекстДляДиалога = ТекД.Ссылка;
	Исключение
		КонтекстДляДиалога = ТекД;
	КонецПопытки;
	
	ПараметрыФормы = Новый Структура("Контекст", КонтекстДляДиалога);
	ОткрытьФорму("Обработка.Диалоги.Форма", ПараметрыФормы, ЭтаФорма, Ложь, Неопределено, "e1cib/command/Обработка.Диалоги.Команда.ДиалогиКонтекста");
	
КонецПроцедуры


