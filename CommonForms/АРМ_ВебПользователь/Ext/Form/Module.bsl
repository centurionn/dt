&НаКлиенте
Процедура ОтображениеКонтрагента()
	
	ЗонаРиска = ЗонаРискаКонтрагента();
	Элементы.Контрагент.Подсказка = "";
	Элементы.Контрагент.ОтображениеПодсказки = ОтображениеПодсказки.Нет;	
	
	Если ЗонаРиска.Количество()=1 Тогда
		Элементы.Контрагент.ЦветФона = WebЦвета.Желтый;
	ИначеЕсли ЗонаРиска.Количество()=2 Тогда
		Элементы.Контрагент.ЦветФона = WebЦвета.Красный;
		Элементы.Контрагент.Подсказка = ЗонаРиска[1];
		Элементы.Контрагент.ОтображениеПодсказки = ОтображениеПодсказки.Кнопка;
	КонецЕсли;
	
КонецПроцедуры

