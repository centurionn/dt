&НаКлиенте
Процедура ПоказателиДляРФПриИзменении(Элемент)
	
	СтруктураПоказателей = ПолучитьАктуальныеПоказатели(ПоказателиДляРФ);
	
	ЖелтыйПорогПоПробегу = СтруктураПоказателей.порогипробег_ЖелтыйПорог;
	ЖелтыйПорогПоСроку = СтруктураПоказателей.порогисрок_ЖелтыйПорог;
	
	КрасныйПорогПоПробегу = СтруктураПоказателей.порогипробег_КрасныйПорог;
	КрасныйПорогПоСроку = СтруктураПоказателей.порогисрок_КрасныйПорог;
	
	ЖелтыеИКрасныеПороги.Параметры.УстановитьЗначениеПараметра("ЖелтыйПробег", ЖелтыйПорогПоПробегу);
	ЖелтыеИКрасныеПороги.Параметры.УстановитьЗначениеПараметра("ЖелтыйСрок", ЖелтыйПорогПоСроку);
	
	ЖелтыеИКрасныеПороги.Параметры.УстановитьЗначениеПараметра("КрасныйПробег", КрасныйПорогПоПробегу);
	ЖелтыеИКрасныеПороги.Параметры.УстановитьЗначениеПараметра("КрасныйСрок", КрасныйПорогПоСроку);
	
	Элементы.ЖелтыеИКрасныеПороги.Обновить();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьАктуальныеПоказатели(ПоказателиДляРФ)
	
	Результат = Новый Структура();
	
	Результат.Вставить("порогисрок_ЖелтыйПорог", Константы.порогисрок_ЖелтыйПорог.Получить());
	Результат.Вставить("порогисрок_КрасныйПорог", Константы.порогисрок_КрасныйПорог.Получить());
	
	Если ПоказателиДляРФ = 0 Тогда
		
		Результат.Вставить("порогипробег_ЖелтыйПорог", Константы.порогипробег_ЖелтыйПорогРФ.Получить());
		Результат.Вставить("порогипробег_КрасныйПорог", Константы.порогипробег_КрасныйПорогРФ.Получить());
		
	Иначе
		
		Результат.Вставить("порогипробег_ЖелтыйПорог", Константы.порогипробег_ЖелтыйПорогИнТерр.Получить());
		Результат.Вставить("порогипробег_КрасныйПорог", Константы.порогипробег_КрасныйПорогИнТерр.Получить());
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПоказателиДляРФПриИзменении(неопределено);
	
	ПраваяПанельСкрыта = Истина;
	ЛеваяПанельСкрыта = Истина;
	ОтображениеСкрытыхПанелей();
	
	ПодключитьОбработчикОжидания("ОбновитьКоличестовВСписке", 25, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКоличестовВСписке()

	ТекСтр = Элементы.ГруппаСтраницы.ТекущаяСтраница;
	Если НЕ СтрНайти(ТекСтр.Имя,"ГруппаСписокВагонов") = 0 Тогда
		ТекСписок = "СписокВагонов";
		ТекОтбор = "";
	ИначеЕсли НЕ СтрНайти(ТекСтр.Имя,"Страница") = 0 Тогда
		ТекСписок = "Список" + Строка(СтрЗаменить(ТекСтр.Имя,"Страница",""));
		ТекОтбор = Строка(СтрЗаменить(ТекСтр.Имя,"Страница",""));
	КонецЕсли;
	
	СтруктураОтвета = РасчетДанных_и_Подвала(ТекСписок);
	ЭтаФорма["ВсегоВагоновВСистеме" + Строка(ТекОтбор)] = СтруктураОтвета.ВсегоВагоновВСистеме;
	ЭтаФорма["ВсегоВагоновСУчетомОтборов" + Строка(ТекОтбор)] = СтруктураОтвета.ВсегоВагоновСУчетомОтборов;
	ЭтаФорма["ВсегоВагоновВыбрано" + Строка(ТекОтбор)] = 1;
	
КонецПроцедуры

&НаСервере
Процедура ДобавлениеСохраненныхФильтров()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ПресетыОтборовАРМСписокОтборовВагонов.Ссылка.Наименование КАК Наименование,
				   |	ПресетыОтборовАРМСписокОтборовВагонов.Ссылка.Код КАК Код,
	               |	ПресетыОтборовАРМСписокОтборовВагонов.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ПресетыОтборовАРМ.Пользователи КАК ПресетыОтборовАРМПользователи
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПресетыОтборовАРМ.СписокОтборовВагонов КАК ПресетыОтборовАРМСписокОтборовВагонов
	               |		ПО ПресетыОтборовАРМПользователи.Ссылка = ПресетыОтборовАРМСписокОтборовВагонов.Ссылка
	               |ГДЕ
	               |	ПресетыОтборовАРМПользователи.Пользователь = &Пользователь";
	Запрос.УстановитьПараметр("Пользователь",Пользователи.ТекущийПользователь());
	РезультатЗапроса = Запрос.Выполнить();
	
	ТЗ = РезультатЗапроса.Выгрузить();
	
	Для Каждого Стр Из ТЗ Цикл
		
		// 1. группа
		ГруппаФормы = Элементы.Добавить("ГруппаФильтров" + Стр.Код, Тип("ГруппаФормы"), ЭтаФорма.Элементы.Группа2);
		ГруппаФормы.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		НовСтрЭФ = СписокЭФОтборов.Добавить();
		НовСтрЭФ.ТекЭлемент = "ГруппаФильтров" + Стр.Код;

		// 2. кнопка редактирования
		НовЭлемент = Элементы.Добавить("РедактироватьФильтр" + Стр.Код, Тип("КнопкаФормы"), ГруппаФормы);
		НовЭлемент.ИмяКоманды = "РедактироватьФильтр";
		НовЭлемент.Вид = ВидКнопкиФормы.Гиперссылка;
		НовСтрЭФ = СписокЭФОтборов.Добавить();
		НовСтрЭФ.ТекЭлемент = "РедактироватьФильтр" + Стр.Код;
		
		// 3. кнопка удаления
		НовЭлемент = Элементы.Добавить("УдалитьФильтр" + Стр.Код, Тип("КнопкаФормы"), ГруппаФормы);
		НовЭлемент.ИмяКоманды = "УдалитьФильтр";
		НовЭлемент.Вид = ВидКнопкиФормы.Гиперссылка;
		НовСтрЭФ = СписокЭФОтборов.Добавить();
		НовСтрЭФ.ТекЭлемент = "УдалитьФильтр" + Стр.Код;

		// 4. гиперссылка отбора
		Элемент = ЭтаФорма.Элементы.Добавить("Отбор"+Стр.Код,Тип("ДекорацияФормы"), ГруппаФормы);  
		Элемент.Гиперссылка = Истина;
		Элемент.Заголовок = Стр.Наименование; 
		Элемент.Подсказка = "Применить отбор " + Стр.Наименование;
		Элемент.УстановитьДействие("ОбработкаНавигационнойСсылки", "ФильтрОбработкаНавигационнойСсылки" );
	    Элемент.УстановитьДействие("Нажатие", "ФильтрОбработкаНавигационнойСсылки");
		НовСтрЭФ = СписокЭФОтборов.Добавить();
		НовСтрЭФ.ТекЭлемент = "Отбор" + Стр.Код;
		
		ГруппаФормы.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
		
	КонецЦикла;
	
КонецПроцедуры

