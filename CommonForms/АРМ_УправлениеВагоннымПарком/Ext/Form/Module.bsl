&НаКлиенте
Процедура СоздатьЗаявкуНаПодсыл(Команда)
	ТекСтр = Элементы.ГруппаСтраницы.ТекущаяСтраница;
	Если НЕ СтрНайти(ТекСтр.Имя,"ГруппаСписокВагонов") = 0 Тогда
		ТекСписок = "СписокВагонов";
		ТекОтбор = "";
	ИначеЕсли НЕ СтрНайти(ТекСтр.Имя,"Страница") = 0 Тогда
		ТекСписок = "Список" + Строка(СтрЗаменить(ТекСтр.Имя,"Страница",""));
		ТекОтбор = Строка(СтрЗаменить(ТекСтр.Имя,"Страница",""));
	КонецЕсли;
	ВыделенныеВагоны = Элементы[ТекСписок].ВыделенныеСтроки;
	ТаблицаВагонов.Очистить();
	Для каждого ВыделеннаяСтрока Из ВыделенныеВагоны Цикл
		нСтрока = ТаблицаВагонов.Добавить();
		нСтрока.Пометка = Истина;
		нСтрока.НомерВагона = Элементы[ТекСписок].ДанныеСтроки(ВыделеннаяСтрока).Вагон;
		ЗаполнитьЗначенияСвойств(нСтрока, Элементы[ТекСписок].ДанныеСтроки(ВыделеннаяСтрока));
	КонецЦикла; 
	ОпОп = Новый ОписаниеОповещения("ОбработкаСозданияПодсыла",ЭтаФорма,Новый Структура("Список",ТекСписок));
	ПараметрыОтбора = Новый Структура("СписокВагонов,Повагонка",ТаблицаВагонов,Истина);
	ОткрытьФорму("Документ.Операция.Форма.ФормаЕдиничнойОтправки",ПараметрыОтбора,,,,,ОпОп);
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаСозданияПодсыла(Параметр1, Параметр2) Экспорт
	//Если Параметр1 = Истина Тогда
	Если ЗначениеЗаполнено(Параметр1) 
		И Параметр1.Результат = Истина 
		И ЗначениеЗаполнено(Параметр1.АдресТаблицыОпераций) Тогда
		ВыделенныеВагоны = Элементы[Параметр2.Список].ВыделенныеСтроки;
		ОбновитьРСПовагонныеОтправки(ВыделенныеВагоны, Параметр1.АдресТаблицыОпераций);
		Элементы[Параметр2.Список].Обновить();
	КонецЕсли; 		
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбновитьРСПовагонныеОтправки(Вагоны, АдресТаблицыОпераций)

	ТаблицаОпераций = ПолучитьИзВременногоХранилища(АдресТаблицыОпераций);
	МассивОтработанныхСтрок = ТаблицаОпераций.НайтиСтроки(Новый Структура("ВыгруженаВИРС", Истина));
	МассивВагонов = Новый Массив;
	Для каждого ОтработаннаяСтрока Из МассивОтработанныхСтрок Цикл
		МассивВагонов.Добавить(ОтработаннаяСтрока.ТС);
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПовагонныеОтправкиСрезПервых.Период КАК Период,
	|	ПовагонныеОтправкиСрезПервых.Вагон КАК Вагон
	|ИЗ
	|	РегистрСведений.ПовагонныеОтправки.СрезПоследних(, Вагон В (&Вагон)) КАК ПовагонныеОтправкиСрезПервых";
	Запрос.УстановитьПараметр("Вагон", МассивВагонов);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		рс = РегистрыСведений.ПовагонныеОтправки.СоздатьМенеджерЗаписи();
		рс.Период = Выборка.Период;
		рс.Вагон = Выборка.Вагон;
		рс.Прочитать();
		рс.ПодсылСогласованСПланером = Истина;
		рс.ТребуетсяПередислокация = Ложь;
		рс.Записать();
	КонецЦикла; 
	
КонецПроцедуры


