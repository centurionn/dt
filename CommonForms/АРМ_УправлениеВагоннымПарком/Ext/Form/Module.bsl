&НаКлиенте
Процедура ВставитьИзEXCEL(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаДобавленияНомерныхВагонов", ЭтаФорма, Новый Структура("Вагоны, ПередаватьИсходныеНомера", Истина, Истина));
	ОткрытьФорму("ОбщаяФорма.ВставкаИзБуфераОбмена", Новый Структура("Вагоны", Истина), , ЭтаФорма.УникальныйИдентификатор, ,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаДобавленияНомерныхВагонов(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если параметр1 = Неопределено тогда 
		возврат; 
	КонецЕсли;
	
	ТекСтр = Элементы.ГруппаСтраницы.ТекущаяСтраница;
	Если НЕ СтрНайти(ТекСтр.Имя,"ГруппаСписокВагонов") = 0 Тогда
		ТекСписок = "СписокВагоновПоиск";
	ИначеЕсли НЕ СтрНайти(ТекСтр.Имя,"Страница") = 0 Тогда
		ТекСписок = "СписокВагоновПоиск" + Строка(СтрЗаменить(ТекСтр.Имя,"Страница",""));
	КонецЕсли;
	
	ЭтаФорма[ТекСписок].Очистить();
	
	Для каждого Стр из параметр1 Цикл
		
		ЭтаФорма[ТекСписок].Добавить(Стр);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Автофильтр(Команда)
	ТекСтр = Элементы.ГруппаСтраницы.ТекущаяСтраница;
	Если НЕ СтрНайти(ТекСтр.Имя,"ГруппаСписокВагонов") = 0 Тогда
		ТекСписок = "СписокВагонов";
		ТекОтбор = "";
	ИначеЕсли НЕ СтрНайти(ТекСтр.Имя,"Страница") = 0 Тогда
		ТекСписок = "Список" + Строка(СтрЗаменить(ТекСтр.Имя,"Страница",""));
		ТекОтбор = Строка(СтрЗаменить(ТекСтр.Имя,"Страница",""));
	КонецЕсли;
	
	// текущая колонка
	КолонкаДС = СтрЗаменить(Элементы[ТекСписок].ТекущийЭлемент.Имя,ТекСписок,"");
	
	//Схема = Элементы[ТекСписок].ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	//Настройки = Элементы[ТекСписок].ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	
	ТекКолонкаМассив = ПолучитьДанныеДинамическогоСписка(ТекСписок,КолонкаДС);
	ЗаголовокКолонки = Элементы[ТекСписок].ТекущийЭлемент.Заголовок;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Колонка", ТекКолонкаМассив);
	ПараметрыОтбора.Вставить("ЗаголовокКолонки", ЗаголовокКолонки);
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаФильтрации", ЭтаФорма, Новый Структура("ИмяКолонки", КолонкаДС));
	ОткрытьФорму("Справочник.ПресетыОтборовАРМ.Форма.ФормаАвтофильтра", ПараметрыОтбора, , ЭтаФорма.УникальныйИдентификатор, ,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаФильтрации(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если параметр1 = Неопределено тогда 
		возврат; 
	КонецЕсли;
	
	ТекСтр = Элементы.ГруппаСтраницы.ТекущаяСтраница;
	Если НЕ СтрНайти(ТекСтр.Имя,"ГруппаСписокВагонов") = 0 Тогда
		ТекСписок = "СписокВагонов";
		ТекОтбор = "";
	ИначеЕсли НЕ СтрНайти(ТекСтр.Имя,"Страница") = 0 Тогда
		ТекСписок = "Список" + Строка(СтрЗаменить(ТекСтр.Имя,"Страница",""));
		ТекОтбор = Строка(СтрЗаменить(ТекСтр.Имя,"Страница",""));
	КонецЕсли;
	
	// если уже создана группа отбора, то добавить элемент в нее
	ГруппаОтбора = Неопределено;
	Если ЭтаФорма[ТекСписок].Отбор.Элементы.Количество() > 0 Тогда
	
		Для каждого СтрОтбор Из ЭтаФорма[ТекСписок].Отбор.Элементы Цикл
		
			Если СтрОтбор.ИдентификаторПользовательскойНастройки = "Автофильтр" Тогда
			
				ГруппаОтбора = СтрОтбор;
				Прервать;
			
			КонецЕсли; 
		
		КонецЦикла; 
	
	КонецЕсли; 
	
	//Если ЭтаФорма[ТекСписок].Отбор.Элементы.Количество()= 1 Тогда
	//	ГруппаОтбора = ЭтаФорма[ТекСписок].Отбор.Элементы[0];
	//Иначе
	Если ГруппаОтбора = Неопределено Тогда
		ГруппаОтбора = ЭтаФорма[ТекСписок].Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
		ГруппаОтбора.ИдентификаторПользовательскойНастройки = "Автофильтр";
	КонецЕсли;

	// отключить отбор. ищем по представлению нужный отбор
	Если НЕ ТипЗнч(параметр1) = Тип("Массив") И параметр1 = "Все" Тогда
		Для Каждого Элем Из ГруппаОтбора.Элементы Цикл
			Если Элем.Представление = Параметр2.ИмяКолонки Тогда
				ГруппаОтбора.Элементы.Удалить(Элем);
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// данные для отбора переносим в массив
	МассивОтбора = Новый Массив;
	Если параметр1 <> "Все" Тогда
		Для Каждого Элем Из параметр1 Цикл
			МассивОтбора.Добавить(Элем.ЗначениеФильтра);
		КонецЦикла;
	КонецЕсли; 
	
	Если ТипЗнч(параметр1) = Тип("Массив") Тогда
		ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Параметр2.ИмяКолонки);
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		ЭлементОтбора.Представление = Параметр2.ИмяКолонки;
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.ПравоеЗначение = МассивОтбора;
	КонецЕсли;
	
	//Схема = Элементы[ТекСписок].ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	//Настройки = Элементы[ТекСписок].ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	//
	СтруктураОтвета = РасчетДанных_и_Подвала(ТекСписок);
	ЭтаФорма["ВсегоВагоновВСистеме" + Строка(ТекОтбор)] = СтруктураОтвета.ВсегоВагоновВСистеме;
	ЭтаФорма["ВсегоВагоновСУчетомОтборов" + Строка(ТекОтбор)] = СтруктураОтвета.ВсегоВагоновСУчетомОтборов;
	ЭтаФорма["ВсегоВагоновВыбрано" + Строка(ТекОтбор)] = 1;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьФорму(Команда)
	
	ТекСтр = Элементы.ГруппаСтраницы.ТекущаяСтраница;
	Если НЕ СтрНайти(ТекСтр.Имя,"Страница") = 0 Тогда
		ТекСписок = "Список" + Строка(СтрЗаменить(ТекСтр.Имя,"Страница",""));
		ТекОтбор = Строка(СтрЗаменить(ТекСтр.Имя,"Страница",""));
	КонецЕсли;
	
	ПоляВХранилище = ПоместитьПоляВХранилище(ТекСписок);
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ПоляВХранилище", ПоляВХранилище);
	ПараметрыОтбора.Вставить("КодСправочника", ТекОтбор);

	ОткрытьФорму("Справочник.НастройкиФормыОтборовПользователей.Форма.ФормаНастройкиСписка", ПараметрыОтбора, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Функция ПоместитьПоляВХранилище(ТекСписок)
	
	//Схема = Элементы[ТекСписок].ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	//Настройки = Элементы[ТекСписок].ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	
	КолонкиПолейОтбора = ПолучитьДанныеДинамическогоСписка(ТекСписок,Неопределено);
		
	Возврат ПоместитьВоВременноеХранилище(КолонкиПолейОтбора, УникальныйИдентификатор);
	
КонецФункции

&НаКлиенте
Процедура ОбработатьПодбор(КодСправочника) Экспорт
	
	ПолучитьПоляИзХранилища(ПоляВХранилище,КодСправочника);
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьПоляИзХранилища(ПоляВХранилище,КодСправочника)
	// Обязательно &НаСервере иначе "Ошибка отображения типов"
	РезультатПодбора = ПолучитьИзВременногоХранилища(ПоляВХранилище);
	ИмяДинСписка = "Список" + Строка(КодСправочника);
	ЭлементыОтбораСохранить = ЭтаФорма[ИмяДинСписка].Отбор.Элементы;
	
	СтруктураРеквизитов = новый Массив;
	
	ИмяЗакладки = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	ТекОтбор = СтрЗаменить(ИмяЗакладки,"Страница","");
	
	////ЗаполнитьТЗРеквизитовКлиент(Элементы.ГруппаСтраницы, СтруктураРеквизитов,ТекОтбор);
	
	ЗакрытьТекОтборНаСервере();
	
	////Для каждого ЭлементФ Из СписокЭФ Цикл
	////	Если СтрНайти(ЭлементФ.ТекЭлемент,ТекОтбор) тогда
	////		Попытка
	////			Элементы.Удалить(Элементы.Найти(ЭлементФ.ТекЭлемент));
	////			СписокЭФ.Удалить(ЭлементФ);
	////		Исключение
	////		КонецПопытки;
	////	КонецЕсли;
	////КонецЦикла;
	
    // проверить уникальность отбора
	ТекОтбор = СокрЛП(КодСправочника);
	ИмяНовойСтраницы = "Страница" + ТекОтбор;
	Если НЕ Элементы.Найти(ИмяНовойСтраницы) = Неопределено Тогда
		Сообщить("Данный отбор уже выбран!");
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницы.ПодчиненныеЭлементы[ИмяНовойСтраницы];
		Возврат;
	КонецЕсли;
	
	СозданиеЗакладки(КодСправочника,ЭлементыОтбораСохранить);
	
	ТекСтр = Элементы.ГруппаСтраницы.ТекущаяСтраница;
	ТекСписок = "Список" + Строка(СтрЗаменить(ТекСтр.Имя,"Страница",""));
	
	СтруктураОтвета = РасчетДанных_и_Подвала(ТекСписок);
	ЭтаФорма["ВсегоВагоновВСистеме" + Строка(СтрЗаменить(ТекСтр.Имя,"Страница",""))] = СтруктураОтвета.ВсегоВагоновВСистеме;
	ЭтаФорма["ВсегоВагоновСУчетомОтборов" + Строка(СтрЗаменить(ТекСтр.Имя,"Страница",""))] = СтруктураОтвета.ВсегоВагоновСУчетомОтборов;
	ЭтаФорма["ВсегоВагоновВыбрано" + Строка(СтрЗаменить(ТекСтр.Имя,"Страница",""))] = 1;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьФильтры(Команда)
	
	УдалитьЭлементыФормыОтборы();
	
	ДобавлениеСохраненныхФильтров();
	
КонецПроцедуры

&НаСервере
Процедура УдалитьЭлементыФормыОтборы()
	// должна работать только на сервере, т.к. иначе элементы не удаляются
	Для каждого ЭлементФ Из СписокЭФОтборов Цикл
		Попытка
			Элементы.Удалить(Элементы.Найти(ЭлементФ.ТекЭлемент));
			СписокЭФОтборов.Удалить(ЭлементФ);
		Исключение
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьФильтр(Команда)
	
	ТекКнопка = ТекущийЭлемент.Имя;
	ТекОтбор = СтрЗаменить(ТекущийЭлемент.Имя,"РедактироватьФильтр","");
	
	Спр = ПолучитьСправочник(ТекОтбор);
	
	ПоказатьЗначение(,Спр);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьФильтр(Команда)
	
	ТекКнопка = ТекущийЭлемент.Имя;
	ТекОтбор = СтрЗаменить(ТекущийЭлемент.Имя,"УдалитьФильтр","");
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ТекОтбор",ТекОтбор);
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтотОбъект, ПараметрыОтбора);
	ПоказатьВопрос(Оповещение, "Удалить данный фильтр у пользователя?", Режим, 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, ПараметрыОтбора) Экспорт
	
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
	КонецЕсли;
	
	УдалитьПользователяИзСправочник(ПараметрыОтбора.ТекОтбор);
	
	Сообщить("Отбор удален для данного пользователя!");

	УдалитьЭлементыФормыОтборы();
	
	ДобавлениеСохраненныхФильтров();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСправочник(ТекОтбор)
	
	ТекСпр = Справочники.ПресетыОтборовАРМ.НайтиПоКоду(ТекОтбор);
	Возврат ТекСпр;
	
КонецФункции

&НаСервереБезКонтекста
Процедура УдалитьПользователяИзСправочник(ТекОтбор)
	
	ТекСпр = Справочники.ПресетыОтборовАРМ.НайтиПоКоду(ТекОтбор);
	ПолучОб = ТекСпр.ПолучитьОбъект();
	ТЧ = ПолучОб.Пользователи;
	Для ШагЦикла = 0 По ТЧ.Количество()-1 Цикл
		Если ТЧ[ШагЦикла].Пользователь = Пользователи.ТекущийПользователь() Тогда
			ТЧ.Удалить(ШагЦикла);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ПолучОб.Записать();
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьАвтофильтр(Команда)
	ТекСтр = Элементы.ГруппаСтраницы.ТекущаяСтраница;
	Если НЕ СтрНайти(ТекСтр.Имя,"ГруппаСписокВагонов") = 0 Тогда
		ТекСписок = "СписокВагонов";
		ТекОтбор = "";
	ИначеЕсли НЕ СтрНайти(ТекСтр.Имя,"Страница") = 0 Тогда
		ТекСписок = "Список" + Строка(СтрЗаменить(ТекСтр.Имя,"Страница",""));
		ТекОтбор = Строка(СтрЗаменить(ТекСтр.Имя,"Страница",""));
	КонецЕсли;
	
	// отключить отбор. ищем по представлению нужный отбор. если представление заполнено, то удаляем
	Если ЭтаФорма[ТекСписок].Отбор.Элементы.Количество()= 1 Тогда
		МассивУд = Новый Массив;		
		ГруппаОтбора = ЭтаФорма[ТекСписок].Отбор.Элементы[0];
		Для Каждого Элем Из ГруппаОтбора.Элементы Цикл
			Если НЕ Элем.Представление = "" Тогда
				МассивУд.Добавить(Элем);
				
			КонецЕсли;
		КонецЦикла;
		Для Каждого Эл Из МассивУд Цикл
			ГруппаОтбора.Элементы.Удалить(Эл);
		КонецЦикла;
	КонецЕсли;
	
	//Схема = Элементы[ТекСписок].ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	//Настройки = Элементы[ТекСписок].ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	
	СтруктураОтвета = РасчетДанных_и_Подвала(ТекСписок);
	ЭтаФорма["ВсегоВагоновВСистеме" + Строка(СтрЗаменить(ТекСтр.Имя,"Страница",""))] = СтруктураОтвета.ВсегоВагоновВСистеме;
	ЭтаФорма["ВсегоВагоновСУчетомОтборов" + Строка(СтрЗаменить(ТекСтр.Имя,"Страница",""))] = СтруктураОтвета.ВсегоВагоновСУчетомОтборов;
	ЭтаФорма["ВсегоВагоновВыбрано" + Строка(СтрЗаменить(ТекСтр.Имя,"Страница",""))] = 1;	
	
КонецПроцедуры

&НаКлиенте
Процедура НазначитьВОтправку(Команда)
	
	ТекСтр = Элементы.ГруппаСтраницы.ТекущаяСтраница;
	Если НЕ СтрНайти(ТекСтр.Имя,"ГруппаСписокВагонов") = 0 Тогда
		ТекСписок = "СписокВагонов";
		ТекОтбор = "";
	ИначеЕсли НЕ СтрНайти(ТекСтр.Имя,"Страница") = 0 Тогда
		ТекСписок = "Список" + Строка(СтрЗаменить(ТекСтр.Имя,"Страница",""));
		ТекОтбор = Строка(СтрЗаменить(ТекСтр.Имя,"Страница",""));
	КонецЕсли;
	
	МассивОтправок = ПолучитьМассивОтправок();
	СписокОтправок = Новый СписокЗначений;
    СписокОтправок.ЗагрузитьЗначения(МассивОтправок);
    ПараметрыОтбора = Новый Структура("Ссылка", СписокОтправок); 
    ПараметрыОткрытия = Новый Структура("Отбор", ПараметрыОтбора); 
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораРейса", ЭтаФорма,Элементы[ТекСписок].ВыделенныеСтроки);
	ОткрытьФорму("Справочник.РейсыЖД.Форма.ФормаВыбора",ПараметрыОткрытия , , ЭтаФорма.УникальныйИдентификатор, ,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьМассивОтправок()
	
	МассивОтпр = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РейсыЖД.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.РейсыЖД КАК РейсыЖД
	               |ГДЕ
	               |	(РейсыЖД.ДатаОтправления > &ТекДата
	               |			ИЛИ РейсыЖД.ДатаОтправления = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
	               |	И НЕ РейсыЖД.ПометкаУдаления
	               |	И НЕ РейсыЖД.РейсОтменен
	               |	И НЕ РейсыЖД.ТехРейс";
	Запрос.УстановитьПараметр("ТекДата",ТекущаяДата());
	МассивОтпр = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат МассивОтпр;
	
КонецФункции

