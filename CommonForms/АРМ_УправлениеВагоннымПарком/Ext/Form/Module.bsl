&НаСервере
Процедура ЗакрытьТекОтборНаСервере()
	
	ИмяЗакладки = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	ТекОтбор = СтрЗаменить(ИмяЗакладки,"Страница","");
	
	//необходимо удалить старые программно созданные реквизиты
	МассивУдаляемыхРеквизитовФормы = новый Массив;
	////Для Каждого Эл Из СтруктураРеквизитов Цикл
	////	МассивУдаляемыхРеквизитовФормы.Добавить(Эл);
	////КонецЦикла;
	
	
	
	Для каждого Стр из ЭтаФорма.ПолучитьРеквизиты() Цикл
		ПутьКДан = ?(ЗначениеЗаполнено(Стр.Путь),Строка(Стр.Путь)+".","");
		Если СтрНайти(Стр.Имя,ТекОтбор) тогда 
			МассивУдаляемыхРеквизитовФормы.Добавить(Строка(ПутьКДан) + Стр.Имя); 
		КонецЕсли;
	КонецЦикла;
	ИзменитьРеквизиты(,МассивУдаляемыхРеквизитовФормы);
	МассивУдаляемыхРеквизитовФормы.Очистить();	
		
	Для каждого ЭлементФ Из СписокЭФ Цикл
		Если СтрНайти(ЭлементФ.ТекЭлемент,ТекОтбор) тогда
			Попытка
				Элементы.Удалить(Элементы.Найти(ЭлементФ.ТекЭлемент));
				СписокЭФ.Удалить(ЭлементФ);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборВагонов(Использование, ЗначениеОтбора, ЭлементОтбора, Предст_ИД_Элемента)
	
	МасЗн = СтрРазделить(Предст_ИД_Элемента, "/");
	ЛевЗначОтбора = МасЗн[0];
	ИДЗначОтбора = МасЗн[1];
	
	ТекСтр = Элементы.ГруппаСтраницы.ТекущаяСтраница;
	Если НЕ СтрНайти(ТекСтр.Имя,"ГруппаСписокВагонов") = 0 Тогда
		ТекСписок = "СписокВагонов";
		ТекОтбор = "";
	ИначеЕсли НЕ СтрНайти(ТекСтр.Имя,"Страница") = 0 Тогда
		ТекСписок = "Список" + Строка(СтрЗаменить(ТекСтр.Имя,"Страница",""));
		ТекОтбор = Строка(СтрЗаменить(ТекСтр.Имя,"Страница",""));
	КонецЕсли;
	
	// Универсальные Отборы:
	Для каждого ТекОтб Из ЭтаФорма[ТекСписок].Отбор.Элементы Цикл
	
		Если ТекОтб.ИдентификаторПользовательскойНастройки = ИДЗначОтбора Тогда
			ТекЭлОтбора = ТекОтб;
			Прервать;
		Иначе
			ТекЭлОтбора = Неопределено;
		КонецЕсли; 
	
	КонецЦикла; 
	
	СоздатьЭл = Ложь;
	
	Если ТекЭлОтбора = Неопределено Тогда
	
		Если Использование Тогда
		
			СоздатьЭл = Истина;
		
		Иначе
		
			// Ничего не делаем
		
		КонецЕсли; 
	
	Иначе
	
		 ТекЭлОтбора.Использование = Использование;
		 ТекЭлОтбора.ПравоеЗначение = ЗначениеОтбора;
	
	КонецЕсли; 
	
	Если СоздатьЭл Тогда
	
		ЭлементОтбора = ЭтаФорма[ТекСписок].Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных(ЛевЗначОтбора);
		ЭлементОтбора.ВидСравнения 		= ?(ТипЗнч(ЗначениеОтбора)=Тип("СписокЗначений"), ВидСравненияКомпоновкиДанных.ВСписке, ВидСравненияКомпоновкиДанных.Равно);
		ЭлементОтбора.Представление 	= ЭлементОтбора;
		ЭлементОтбора.ИдентификаторПользовательскойНастройки = ИДЗначОтбора;
		ЭлементОтбора.Использование 	= Использование;
		ЭлементОтбора.ПравоеЗначение 	= ЗначениеОтбора;
	
	КонецЕсли;  
	
	//ОтборВключен = ЭтаФорма["ОтборВагоновИспользование"+ТекОтбор];
	
	//Если ЭтаФорма[ТекСписок].Отбор.Элементы.Количество()= 1 Тогда
