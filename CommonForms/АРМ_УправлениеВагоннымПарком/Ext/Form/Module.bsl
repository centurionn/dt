&НаКлиенте
Процедура СписокВагоновПоискПриИзменении(Элемент)
	
	РезПоиска = ИдентификаторыОтборов.НайтиПоЗначению(Элемент.Имя);
	
	УстановитьОтборВагонов(ОтборВагоновИспользование, СписокВагоновПоиск, Элемент.Имя, РезПоиска.Представление);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеДинамическогоСписка(ДинСписок,ТекКолонка)
	
	МассивДанныхКол = Новый Массив;
	
	// получаем данные динамического списка, который сейчас на экране 
	Схема = Элементы[ДинСписок].ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	Настройки = Элементы[ДинСписок].ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
	МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
 
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	
	ТЗ = Новый ТаблицаЗначений;
	ПроцессорВывода.УстановитьОбъект(ТЗ); 
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Если НЕ ТекКолонка = Неопределено Тогда
		НоваяТЗ = ТЗ.Скопировать(,ТекКолонка);
		НоваяТЗ.Свернуть(ТекКолонка);
		
		МассивДанныхКол = НоваяТЗ.ВыгрузитьКолонку(ТекКолонка);
	Иначе
		Для Каждого Кол Из ТЗ.Колонки Цикл
			МассивДанныхКол.Добавить(Кол.Заголовок + "," + Кол.Имя);			
		КонецЦикла;
	КонецЕсли;
	
	Возврат МассивДанныхКол;
	
КонецФункции

&НаСервере
Процедура УстановитьОтборНаСписок(КодСправочника,ИмяДинСписка)
	
	СтруктураПолейОтбора = Новый Структура;

	// в зависимости от выбранного фильтра, получаем данные для отбора
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ПресетыОтборовАРМСписокОтборовВагонов.НаименованиеОтбора = ЗНАЧЕНИЕ(Перечисление.ВариантыОтборовВагонов.РазмерыВагонов)
		|			ТОГДА ""РазмерыВагонов""
		|		КОГДА ПресетыОтборовАРМСписокОтборовВагонов.НаименованиеОтбора = ЗНАЧЕНИЕ(Перечисление.ВариантыОтборовВагонов.ТипТС)
		|			ТОГДА ""ТипТС""
		|		КОГДА ПресетыОтборовАРМСписокОтборовВагонов.НаименованиеОтбора = ЗНАЧЕНИЕ(Перечисление.ВариантыОтборовВагонов.ВидыСобственности)
		|			ТОГДА ""ПризнакСобственности""
		|		КОГДА ПресетыОтборовАРМСписокОтборовВагонов.НаименованиеОтбора = ЗНАЧЕНИЕ(Перечисление.ВариантыОтборовВагонов.ВЭксплуатации)
		|			ТОГДА ""ВЭксплуатации""
		|		КОГДА ПресетыОтборовАРМСписокОтборовВагонов.НаименованиеОтбора = ЗНАЧЕНИЕ(Перечисление.ВариантыОтборовВагонов.Резервный)
		|			ТОГДА ""РезервноеТС""
		|		КОГДА ПресетыОтборовАРМСписокОтборовВагонов.НаименованиеОтбора = ЗНАЧЕНИЕ(Перечисление.ВариантыОтборовВагонов.Прибывшие)
		|			ТОГДА ""Прибытие""
		|		КОГДА ПресетыОтборовАРМСписокОтборовВагонов.НаименованиеОтбора = ЗНАЧЕНИЕ(Перечисление.ВариантыОтборовВагонов.Назначенные)
		|			ТОГДА ""ВОтправке""
		|		КОГДА ПресетыОтборовАРМСписокОтборовВагонов.НаименованиеОтбора = ЗНАЧЕНИЕ(Перечисление.ВариантыОтборовВагонов.ИсторияПоВагону)
		|			ТОГДА ""ИсторияПоВагону""
		|		КОГДА ПресетыОтборовАРМСписокОтборовВагонов.НаименованиеОтбора = ЗНАЧЕНИЕ(Перечисление.ВариантыОтборовВагонов.ТребуетсяПередислокация)
		|			ТОГДА ""ТребуетсяПередислокация""
		|		КОГДА ПресетыОтборовАРМСписокОтборовВагонов.НаименованиеОтбора = ЗНАЧЕНИЕ(Перечисление.ВариантыОтборовВагонов.СогласованоМенеджером)
		|			ТОГДА ""СогласованоМенеджером""
		|		КОГДА ПресетыОтборовАРМСписокОтборовВагонов.НаименованиеОтбора = ЗНАЧЕНИЕ(Перечисление.ВариантыОтборовВагонов.СогласованоПланером)
		|			ТОГДА ""СогласованоПланером""
		|		КОГДА ПресетыОтборовАРМСписокОтборовВагонов.НаименованиеОтбора = ЗНАЧЕНИЕ(Перечисление.ВариантыОтборовВагонов.ТребуетсяВыводВПовагонку)
		|			ТОГДА ""ТребуетсяВыводВПовагонку""
		|	КОНЕЦ КАК НаименованиеОтбора,
		|	ПресетыОтборовАРМСписокОтборовВагонов.ВариантЗначенияОтбора КАК ВариантЗначенияОтбора
		|ИЗ
		|	Справочник.ПресетыОтборовАРМ.СписокОтборовВагонов КАК ПресетыОтборовАРМСписокОтборовВагонов
		|ГДЕ
		|	ПресетыОтборовАРМСписокОтборовВагонов.Ссылка.Код = &Код
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПресетыОтборовАРМСписокОтборовВагонов.Приоритет УБЫВ
		|ИТОГИ ПО
		|	НаименованиеОтбора";
	Запрос.УстановитьПараметр("Код", КодСправочника);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаНаименованиеОтбора = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ГруппаОтбора = ИмяДинСписка.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;

	Пока ВыборкаНаименованиеОтбора.Следующий() Цикл
		СтруктураПолейОтбора.Вставить("ИмяПоля",ВыборкаНаименованиеОтбора.НаименованиеОтбора);
		
		ВыборкаДетальныеЗаписи = ВыборкаНаименованиеОтбора.Выбрать();
		МассивДанных = Новый Массив;
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			МассивДанных.Добавить(ВыборкаДетальныеЗаписи.ВариантЗначенияОтбора);
		КонецЦикла;
		СтруктураПолейОтбора.Вставить("ЗначениеПоля",МассивДанных);
		
		// установить отбор
		// для истории вагона придумать другое
		Если НЕ СтруктураПолейОтбора.ИмяПоля = "ИсторияПоВагону" Тогда
			
			ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(СтруктураПолейОтбора.ИмяПоля);
			Если СтруктураПолейОтбора.ИмяПоля = "ТипТС" Тогда
				ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии;
			Иначе
				ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
			КонецЕсли;
			ЭлементОтбора.Использование = Истина;
			ЭлементОтбора.ПравоеЗначение = СтруктураПолейОтбора.ЗначениеПоля;
		КонецЕсли;
		
	КонецЦикла;
	
	//Схема = Элементы["Список"+КодСправочника].ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	//Настройки = Элементы["Список"+КодСправочника].ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	
	СтруктураОтвета = РасчетДанных_и_Подвала("Список"+КодСправочника);
	
	ЭтаФорма["ВсегоВагоновВСистеме" + КодСправочника] = СтруктураОтвета.ВсегоВагоновВСистеме;
	ЭтаФорма["ВсегоВагоновСУчетомОтборов" + КодСправочника] = СтруктураОтвета.ВсегоВагоновСУчетомОтборов;
	ЭтаФорма["ВсегоВагоновВыбрано" + КодСправочника] = 1;
	
КонецПроцедуры

&НаСервере
Процедура СозданиеДинамическогоСписка(ИмяСписка,ТекстЗапроса,МассивКолонок,ДобавитьВ,КодСправочника,ГруппаФормы,Исторический)

	// Создаем реквизит формы
	ТипыРеквизита = Новый Массив;                             
	ТипыРеквизита.Добавить(Тип("ДинамическийСписок"));
	ОписаниеТиповДляРеквизита = Новый ОписаниеТипов(ТипыРеквизита); 
	ДинамическийСписок = Новый РеквизитФормы(ИмяСписка, ОписаниеТиповДляРеквизита,,"",ЛОЖЬ); 
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(ДинамическийСписок);        
	
	// создаем реквизиты для отбора списка вагонов
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СписокВагоновПоиск"+КодСправочника,Новый ОписаниеТипов("СписокЗначений"),,"Список вагонов поиск",Истина));    
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ОтборВагоновИспользование"+КодСправочника,Новый ОписаниеТипов("Булево"),,"Список вагонов",Истина));    
	
	// создаем реквизиты для отображения подвала
	КЧ = Новый КвалификаторыЧисла(10,0);
	Массив = Новый Массив;
	Массив.Добавить(Тип("Число"));
	ОписаниеТиповЧ = Новый ОписаниеТипов(Массив, , ,КЧ);
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ВсегоВагоновВСистеме"+КодСправочника,ОписаниеТиповЧ,,"Всего в системе",Истина));    
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ВсегоВагоновВыбрано"+КодСправочника,ОписаниеТиповЧ,,"Всего выбрано",Истина));    
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ВсегоВагоновСУчетомОтборов"+КодСправочника,ОписаниеТиповЧ,,"Всего на экране с учетом отборов",Истина));    
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);        
	
	ЭтаФорма["СписокВагоновПоиск"+КодСправочника].ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.ТС");
	
	// Задаем свойства реквизиту
	РеквизитДинамическийСписок = ЭтаФорма[ИмяСписка]; 
	РеквизитДинамическийСписок.ПроизвольныйЗапрос = ИСТИНА;
	РеквизитДинамическийСписок.ТекстЗапроса = ТекстЗапроса;
	Если НЕ Исторический Тогда
		РеквизитДинамическийСписок.ОсновнаяТаблица = "Справочник.ТС";
	КонецЕсли;
	
	// Размещаем реквизит на форме
    // 1. флажок
    Элемент = Элементы.Добавить("ОтборВагоновИспользование"+КодСправочника, Тип("ПолеФормы"), ГруппаФормы);
	Элемент.Вид = ВидПоляФормы.ПолеФлажка;
    Элемент.ПутьКДанным = "ОтборВагоновИспользование"+КодСправочника;
    Элемент.УстановитьДействие("ПриИзменении", "ОтборВагоновИспользованиеПриИзменении");
	НовСтрЭФ = СписокЭФ.Добавить();
	НовСтрЭФ.ТекЭлемент = "ОтборВагоновИспользование" + КодСправочника;
    // 2. поле ввода
    Элемент = Элементы.Добавить("СписокВагоновПоиск"+КодСправочника, Тип("ПолеФормы"), ГруппаФормы);
	Элемент.Вид = ВидПоляФормы.ПолеВвода;
    Элемент.ПутьКДанным = "СписокВагоновПоиск"+КодСправочника;
    Элемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
    Элемент.УстановитьДействие("ПриИзменении", "СписокВагоновПоискПриИзменении");
	НовСтрЭФ = СписокЭФ.Добавить();
	НовСтрЭФ.ТекЭлемент = "СписокВагоновПоиск" + КодСправочника;
	// 3. эксель
	НовЭлемент = Элементы.Добавить("ВставитьИзEXCEL" + КодСправочника, Тип("КнопкаФормы"), ГруппаФормы);
	НовЭлемент.ИмяКоманды = "ВставитьИзEXCEL";
	НовСтрЭФ = СписокЭФ.Добавить();
	НовСтрЭФ.ТекЭлемент = "ВставитьИзEXCEL" + КодСправочника;
	// 3.1 копирование из буфера обмена
	НовЭлемент = Элементы.Добавить("ВставитьИзБуфераОбмена" + КодСправочника, Тип("КнопкаФормы"), ГруппаФормы);
	НовЭлемент.ИмяКоманды = "ВставитьИзБуфераОбмена";
	НовСтрЭФ = СписокЭФ.Добавить();
	НовСтрЭФ.ТекЭлемент = "ВставитьИзБуфераОбмена" + КодСправочника;
	
	// 4. таблица
	ТаблицаФормы = Элементы.Вставить(ИмяСписка,Тип("ТаблицаФормы"),?(ДобавитьВ = "",ЭтаФорма,ЭтаФорма.Элементы[ДобавитьВ]));	
	ТаблицаФормы.ИзменятьСоставСтрок = Ложь;
	ТаблицаФормы.ИзменятьПорядокСтрок = Ложь;
	ТаблицаФормы.МножественныйВыбор = Истина;

	ТаблицаФормы.ПутьКДанным = ИмяСписка;  
	
	// Создание колонок на основании МассивКолонок
	Для Каждого Элемента Из МассивКолонок Цикл
		ПараметрыКолонки = СтрЗаменить(Элемента,",",Символы.ПС);
		Если СтрЧислоСтрок(ПараметрыКолонки) > 1 Тогда
			ЗаголовокКол = СтрПолучитьСтроку(ПараметрыКолонки, 1);
			ИмяКолонки = СтрПолучитьСтроку(ПараметрыКолонки, 2);
		Иначе
			ЗаголовокКол = "";
			ИмяКолонки = ПараметрыКолонки; 
		КонецЕсли;
		НоваяКолонкаТаблицы = Элементы.Добавить(ИмяСписка + ИмяКолонки, Тип("ПолеФормы"), ТаблицаФормы);
		Если ЗаголовокКол <> "" Тогда 
			НоваяКолонкаТаблицы.Заголовок = ЗаголовокКол; 
		КонецЕсли;
		НоваяКолонкаТаблицы.ПутьКДанным = ИмяСписка + "." + ИмяКолонки;
		Если ИмяКолонки = "ВЭксплуатации" ИЛИ
			ИмяКолонки = "РезервноеТС" ИЛИ
			ИмяКолонки = "НаСлежении" ИЛИ
			ИмяКолонки = "Груженый" ИЛИ
			ИмяКолонки = "СогласованоМенеджером" ИЛИ
			ИмяКолонки = "СогласованоПланером" ИЛИ
			ИмяКолонки = "ТребуетсяПередислокация" ИЛИ
			ИмяКолонки = "ТребуетсяПереводВПовагонку" ИЛИ
			ИмяКолонки = "ВОтправке" Тогда
			НоваяКолонкаТаблицы.Вид = ВидПоляФормы.ПолеФлажка;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаФормы.УстановитьДействие("ПриАктивизацииСтроки","ВыполнитьДействиеПриАктивизацииСтроки");
	
	// 5. группа для подвала
	ГруппаФормыПодвала = Элементы.Вставить("ГруппаПодвал" + КодСправочника, Тип("ГруппаФормы"), ?(ДобавитьВ = "",ЭтаФорма,ЭтаФорма.Элементы[ДобавитьВ]));
	ГруппаФормыПодвала.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НовСтрЭФ = СписокЭФ.Добавить();
	НовСтрЭФ.ТекЭлемент = "ГруппаПодвал" + КодСправочника;
	// 6. поля ввода (подвал итогов)
	// 6.1.
    Элемент = Элементы.Добавить("ВсегоВагоновВСистеме"+КодСправочника, Тип("ПолеФормы"), ГруппаФормыПодвала);
	Элемент.Вид = ВидПоляФормы.ПолеВвода;
    Элемент.ПутьКДанным = "ВсегоВагоновВСистеме"+КодСправочника;
    Элемент.ТолькоПросмотр = Истина;
	НовСтрЭФ = СписокЭФ.Добавить();
	НовСтрЭФ.ТекЭлемент = "ВсегоВагоновВСистеме" + КодСправочника;
	// 6.2.
    Элемент = Элементы.Добавить("ВсегоВагоновСУчетомОтборов"+КодСправочника, Тип("ПолеФормы"), ГруппаФормыПодвала);
	Элемент.Вид = ВидПоляФормы.ПолеВвода;
    Элемент.ПутьКДанным = "ВсегоВагоновСУчетомОтборов"+КодСправочника;
    Элемент.ТолькоПросмотр = Истина;
	НовСтрЭФ = СписокЭФ.Добавить();
	НовСтрЭФ.ТекЭлемент = "ВсегоВагоновСУчетомОтборов" + КодСправочника;
	// 6.3.
    Элемент = Элементы.Добавить("ВсегоВагоновВыбрано"+КодСправочника, Тип("ПолеФормы"), ГруппаФормыПодвала);
