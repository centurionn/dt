			Стр.Имя <> "КрасныйПорогПоПробегу" И
			Стр.Имя <> "КрасныйПорогПоСроку" И 
			Стр.Имя <> "ЛеваяПанельСкрыта" И 
			Стр.Имя <> "ОтборВагоновИспользование" И
			Стр.Имя <> "ПоказателиДляРФ" И
			Стр.Имя <> "ПраваяПанельСкрыта" И
			Стр.Имя <> "РеестрТранспортныхОпераций" И
			Стр.Имя <> "СписокВагонов" И
			Стр.Имя <> "СписокВагоновПоиск" И
			Стр.Имя <> "ВсегоВагоновВСистеме" И
			Стр.Имя <> "ВсегоВагоновВыбрано" И
			Стр.Имя <> "ВсегоВагоновСУчетомОтборов" И
			Стр.Имя <> "СписокКонтейнеров" И
			Стр.Имя <> "СписокЭФ" И
			Стр.Имя <> "СписокЭФОтборов" тогда 
			МассивУдаляемыхРеквизитовФормы.Добавить(Строка(ПутьКДан) + Стр.Имя); 
		КонецЕсли;
	КонецЦикла;
	
