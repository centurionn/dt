	НовСтрЭФ.ТекЭлемент = "КПДобавитьВПовагонкуExcel" + ТекОтбор;
	// 9. 
	НовЭлемент = Элементы.Добавить("ОбновитьДанныеПоВагонам" + КодСправочника, Тип("КнопкаФормы"), ЭтаФорма.Элементы["Список" + Строка(КодСправочника)].КоманднаяПанель);
	НовЭлемент.ИмяКоманды = "ОбновитьДанныеПоВагонам"; 
	
	// если форма открывается в первый раз, то не подгружаем старые отборы (по автофильтру)
	Если СохраненныйОтбор = Неопределено Тогда
		УстановитьОтборНаСписок(КодСправочника,ЭтаФорма["Список" + Строка(КодСправочника)]);
	// если форма открывается после ее изменения (состав и порядок реквизитов), то нужно загрузить ранее сделанные отборы
	Иначе
		ГруппаОтбора = ЭтаФорма["Список" + Строка(КодСправочника)].Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
		Если СохраненныйОтбор.Количество()>0 Тогда
			СохраненнаяГруппа = СохраненныйОтбор[0].Элементы;
			Для Каждого Эл Из СохраненнаяГруппа Цикл
				ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЗаполнитьЗначенияСвойств(ЭлементОтбора,Эл);
			КонецЦикла;
		Иначе
			УстановитьОтборНаСписок(КодСправочника,ЭтаФорма["Список" + Строка(КодСправочника)]);
		КонецЕсли;		
	КонецЕсли;
	
	НовыйЭлемент1.Заголовок = "Отбор " + Строка(Справочники.ПресетыОтборовАРМ.НайтиПоКоду(КодСправочника).Наименование);
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницы.ПодчиненныеЭлементы[ИмяТекСтраницы];

