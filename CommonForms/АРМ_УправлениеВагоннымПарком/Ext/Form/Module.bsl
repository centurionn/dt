	ЭлементОтбора = СписокВагонов.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("ПризнакСобственности");
	ЭлементОтбора.ВидСравнения 		= ВидСравненияКомпоновкиДанных.ВСписке;
	ЭлементОтбора.Представление 	= "ПризнакСобственности";
	ЭлементОтбора.ИдентификаторПользовательскойНастройки = ИДЗначОтбора2;
	ЭлементОтбора.Использование 	= Истина;
	ЭлементОтбора.ПравоеЗначение 	= ПризнакСобственности;
	
	СтруктураОтвета = РасчетДанных_и_Подвала("СписокВагонов");
	
	ВсегоВагоновВСистеме = СтруктураОтвета.ВсегоВагоновВСистеме;
	ВсегоВагоновСУчетомОтборов = СтруктураОтвета.ВсегоВагоновСУчетомОтборов;
	ВсегоВагоновВыбрано = 1;
	
	//Евросиб Коханенко Н.А. #64811 27.01.2023 (( 
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #64811 27.01.2023 )) 

КонецПроцедуры

&НаСервере
Функция РасчетДанных_и_Подвала(ИмяТбл)

	СтруктураОтвета = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТС.Ссылка) КАК Вагон
	               |ИЗ
	               |	Справочник.ТС КАК ТС
	               |ГДЕ
	               |	НЕ ТС.ПометкаУдаления
	               |	И ТС.ТипТС.Вагон";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ВсегоВаг = Выборка.Вагон;
	Иначе
		ВсегоВаг = 0;
	КонецЕсли; 
	
	// получаем данные динамического списка, который сейчас на экране 
	Схема = Элементы[ИмяТбл].ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	Настройки = Элементы[ИмяТбл].ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
	МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	Запрос2 = Новый Запрос;
	Запрос2.Текст = МакетКомпоновки.НаборыДанных.НаборДанныхДинамическогоСписка.Запрос;
	НачалоСимволовЗамены = Найти(Запрос2.Текст, "РАЗРЕШЕННЫЕ" + Символы.ПС + Символы.Таб + "ТС.Ссылка КАК Вагон");
	ОкончаниеСимволовЗамены = Найти(Запрос2.Текст, "ИЗ" + Символы.ПС + Символы.Таб + "Справочник.ТС КАК ТС");
	СтрокаЗамены = Сред(Запрос2.Текст,НачалоСимволовЗамены,ОкончаниеСимволовЗамены-НачалоСимволовЗамены);
	Запрос2.Текст = СтрЗаменить(Запрос2.Текст,СтрокаЗамены,"Количество(*) КАК Кол" + Символы.ПС);

	Для Каждого парам из МакетКомпоновки.ЗначенияПараметров Цикл
		Запрос2.УстановитьПараметр(парам.Имя, парам.Значение);
	КонецЦикла;
	             
	Результат = Запрос2.Выполнить();
	
	Выборка2 = Результат.Выбрать();
	Если Выборка2.Следующий() Тогда
		КолВагОтбор = Выборка2.Кол;
	Иначе
		КолВагОтбор = 0;
	КонецЕсли;
	
	//////////////////////////////////////////////////////////////////////////

	СтруктураОтвета.Вставить("ВсегоВагоновВСистеме",ВсегоВаг);
	СтруктураОтвета.Вставить("ВсегоВагоновСУчетомОтборов",КолВагОтбор);
	
	Возврат СтруктураОтвета;
	
КонецФункции

