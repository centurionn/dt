&НаКлиенте
Процедура ОтображениеСкрытыхПанелей()
	
	Элементы.Группа2.Видимость = НЕ ЛеваяПанельСкрыта;
	Элементы.ГруппаОтчеты.Видимость = НЕ ПраваяПанельСкрыта;
	
	Если ЛеваяПанельСкрыта Тогда
		Элементы.Декорация2.Заголовок = ">";
	Иначе
		Элементы.Декорация2.Заголовок = "<";
	КонецЕсли;
	
	Если ПраваяПанельСкрыта Тогда
		Элементы.Декорация3.Заголовок = "<";
	Иначе
		Элементы.Декорация3.Заголовок = ">";
	КонецЕсли;
	
КонецПроцедуры

