
Функция getProductSchedule(org_inn, org_kpp, date_from, date_to)
	
	таблицаСоотвПродуктов = ВебСервисы_сервер.ПолучитьРасписаниеПродуктов(org_inn, org_kpp, date_from, date_to);
	
	Результат = "<response>";
	Результат = результат + Символы.ПС + "<responseType>productList</responseType>";
	Результат = результат + Символы.ПС + "<productList>";
	
	Для каждого Стр из таблицаСоотвПродуктов Цикл
		Результат = результат + Символы.ПС + Символы.Таб + "<productItem КП="""+Стр.КП+""" ДатаОтправления="""+Стр.ДатаОтправления+""" ДатаПрибытия="""+Стр.ДатаПрибытия+""" Наименование="""+Стр.Наименование+""" ОтправлениеКодРЖД="""+Стр.ОтправлениеКодРЖД+""" ОтправлениеКодСист="""+Стр.ОтправлениеКодСист+""" ОтправлениеНаименование="""+Стр.ОтправлениеНаименование+""" ПрибытиеКодРЖД="""+Стр.ПрибытиеКодРЖД+""" ПрибытиеКодСист="""+Стр.ПрибытиеКодСист+""" ПрибытиеНаименование="""+Стр.ПрибытиеНаименование+""" СлотовВсего="""+Стр.СлотовВсего+""" СлотовЗанято="""+Стр.СлотовЗанято+""" />";
	КонецЦикла;
	
	Результат = результат + Символы.ПС + "</productList>";
	Результат = результат + Символы.ПС + "</response>";
	
	Возврат Результат;
	
КонецФункции

