Функция postRequest(other_fio, other_rez, other_title, other_inn, other_tel, other_email, from_datetime, to_datetime, from_location, to_location, gruzlist, uslugilist, usloviaperevozki, cnt_eurosibowner, cnt_isotype, other_longdescription, makeOrder)
	
	ФИО = other_fio;
	Резидент = ?(Строка(other_rez) = "1", Истина, Ложь);
	НазваниеКонтрагента = other_title;
	ИННКонтрагента = "";
	Попытка
		ИННКонтрагента = Число(other_inn);
	Исключение
	КонецПопытки;
	КонтактныйТелефон = other_tel;
	КонтактнаяПочта = other_email;
	Отправка_дата = from_datetime; //ЗагрузкаВнешнихИсточников_сервер.ПреобразоватьДатуВ1С(from_datetime, 2);
	Прибытие_дата = to_datetime; //ЗагрузкаВнешнихИсточников_сервер.ПреобразоватьДатуВ1С(to_datetime, 2);
	Отправка_локация = Справочники.Локации.НайтиПоКоду(from_location);
	Прибытие_локация = Справочники.Локации.НайтиПоКоду(to_location);
	Груз = Грузы_сервер.НайтиСоздатьГруз(gruzlist);
	КонтейнерЕвросиба = ?(Строка(cnt_eurosibowner) = "1", Истина, Ложь);
	
	таблицаКонтейнерТипов = Новый Массив;
	Для каждого Стр1 из СтрРазделить(cnt_isotype, ";", Ложь) Цикл
		ПодМассив = СтрРазделить(Стр1, "=", Ложь);
		Если ПодМассив.Количество() = 2 Тогда
			ТипКТ = Справочники.ТипоразмерыТЕ.НайтиПоРеквизиту("КодISO", ПодМассив[0]);
			КоличествоКТ = 0;
			Попытка
				КоличествоКТ = Число(ПодМассив[1]);
			Исключение
			КонецПопытки;
			таблицаКонтейнерТипов.Добавить(Новый Структура("ТипКТ, КоличествоКТ", ТипКТ, КоличествоКТ));
		КонецЕсли;
	КонецЦикла;
	
	ОписаниеЗаявки = other_longdescription;
	
	ЗапросСсылка = ВебСервисы_сервер.СоздатьЗапросКлиента(ФИО, Резидент, НазваниеКонтрагента, ИННКонтрагента, КонтактныйТелефон, КонтактнаяПочта, Отправка_дата, Прибытие_дата, Отправка_локация, Прибытие_локация, Груз, КонтейнерЕвросиба, таблицаКонтейнерТипов, ОписаниеЗаявки);
	РезультатMakeOrder = "";
	
	Если ЗначениеЗаполнено(makeOrder) Тогда
		Рез = СтрРазделить(makeOrder, ";", Ложь);
		НомерКалькуляции = Рез[0];
		КоличествоКонтейнеров = 1;
		Попытка
			КоличествоКонтейнеров = Число(Рез[1]);
		Исключение
		КонецПопытки;
		МассивДопУслуг = Новый Массив;
		Для Сч = 2 По Рез.Количество()-1 Цикл
			МассивДопУслуг.Добавить(Рез[Сч]);
		КонецЦикла;
		
		РезультатMakeOrder = ВебСервисы_сервер.СоздатьДоговорЗаявку(ЗапросСсылка, НомерКалькуляции, КоличествоКонтейнеров, МассивДопУслуг);
		
	КонецЕсли;
	
	Результат = "<response>";
	Результат = результат + Символы.ПС + "<responseType>makeRequest</responseType>";
	Результат = результат + Символы.ПС + "<createdDocumentId number="""+ЗапросСсылка.Номер+""" />";
	Если ЗначениеЗаполнено(makeOrder) Тогда
		Результат = результат + Символы.ПС + "<createOrderStatus status="""+РезультатMakeOrder+""" />";
	КонецЕсли;
	
	
	Результат = результат + Символы.ПС + "</response>";
	
	Возврат Результат;
	
КонецФункции

Функция calculateDelivery(from_location, to_location, from_dateTime, cargo, weight, cont_size, cont_owner)
	
	ТекстЗапроса = "из " + from_location + " для " + to_location + " от даты " + from_dateTime + " груз " + cargo + " вес " + weight + " размер " + cont_size + " владелец " + cont_owner;
	ЗаписьЖурналаРегистрации("Запрос с веб сайта",,,, ТекстЗапроса);
	
	//Отправка_локация = Локации_сервер.НайтиСтанциюПоНеполномуКоду(from_location);
	//Прибытие_локация = Локации_сервер.НайтиСтанциюПоНеполномуКоду(to_location);
	
	Отправка_локация = Справочники.Локации.НайтиПоКоду(from_location);
	Прибытие_локация = Справочники.Локации.НайтиПоКоду(to_location);
	
	Отправка_дата = from_datetime;
	Груз = Грузы_сервер.НайтиСоздатьГруз(cargo);
	ВесГруза = 0;
	Попытка
		ВесГруза = Число(weight);
	Исключение
	КонецПопытки;
	РазмерКТК = Число(cont_size);
	КонтейнерЕвросиба = ?(Строка(cont_owner) = "1", Истина, Ложь);
	
	КалькуляцияСсылка = ВебСервисы_сервер.НайтиПосчитатьКалькуляцию(Отправка_локация, Прибытие_локация, Отправка_дата, груз, ВесГруза, РазмерКТК, КонтейнерЕвросиба);
	
	Результат = "<response>";
	Результат = результат + Символы.ПС + "<responseType>calculation</responseType>";
	
	Если ЗначениеЗаполнено(КалькуляцияСсылка) Тогда
		Результат = результат + Символы.ПС + "<found>1</found>";
		Результат = результат + Символы.ПС + "<documentId>"+КалькуляцияСсылка.Номер+"</documentId>";
		Результат = результат + Символы.ПС + "<totalCost>"+Формат(?(cont_size = 20, КалькуляцияСсылка.ММ_ИтогоСтавка20, КалькуляцияСсылка.ММ_ИтогоСтавка), "ЧГ=")+"</totalCost>";
		Результат = результат + Символы.ПС + "<serviceList>";
		Для каждого Стр из КалькуляцияСсылка.ЖД_УслугиВнеСтавки Цикл
			Результат = результат + Символы.ПС + "<service code="""+Стр.Услуга.Код+""" title="""+Стр.Услуга+""" cost="""+Формат(?(cont_size = 20, Стр.Ставка20, стр.Ставка40), "ЧГ=")+""" />";
		КонецЦикла;
		Результат = результат + Символы.ПС + "</serviceList>";
	Иначе
		Результат = результат + Символы.ПС + "<found>0</found>";
	КонецЕсли;
	
	Результат = результат + Символы.ПС + "</response>";
	
	Возврат Результат;
	
КонецФункции

