// ДИТ US 64822 Сержантова А.С. Начало: 04.07.2023
Функция ProtocolsUpdate(Inp, Out)
	СтруктураПараметров = ИнициализироватьСтруктуруДляОбработкиСообщения();
	СтруктураПараметров.Сообщение = Inp;
	СтруктураПараметров.ИсточникВызова = "ВебСервис";
	
	Результат = ОбработатьProtocolsUpdate(СтруктураПараметров);
	
	out = СтруктураПараметров.Ответ;
	
	Возврат СтруктураПараметров.Результат;
КонецФункции   

// ДИТ US 64822 Сержантова А.С. Начало: 04.07.2023  
// Используется в веб сервисе DataCore_DO_Service для создания ПСЦ по данным ДО
Функция ОбработатьProtocolsUpdate(ВходныеПараметры) Экспорт

	Если ВходныеПараметры.Свойство("Сообщение") = Ложь Тогда
		ВходныеПараметры.Ответ = "Не найдено сообщение";
		Возврат Ложь;
	КонецЕсли;	
	
	Сообщение =  ВходныеПараметры.Сообщение;
	
	ИсточникВызова = Неопределено;
	ВходныеПараметры.Свойство("ИсточникВызова", ИсточникВызова);
	
	Тип = "Protocols";
	URIПространстваИмен = "XMLDocuments";
	ТипСообщения = ФабрикаXDTO.Тип(URIПространстваИмен,Тип);
	
	СообщениеXDTO = ПреобразоватьСообщениеВXDTOОбъект(ВходныеПараметры, ТипСообщения);
	Если СообщениеXDTO = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	ОтветXDTO = ФабрикаXDTO.Создать(ТипСообщения);
	ЕстьОшибки = Ложь;	
	 
	Для каждого ДанныеПротокола ИЗ СообщениеXDTO.Protocol Цикл  
		НаименованиеВнешнейСистемы = ДанныеПротокола.ExternalSystemID;
		ЕстьЛокальныеОшибки = Ложь;
		PurchaseXDTO = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип(URIПространстваИмен,"Protocol")); // сюда будем писать данные для ответа		
		
		// обновим документ ПСЦ
		Если ЗначениеЗаполнено(ДанныеПротокола.GUIDProtocol) Тогда // обновляем данные
			СтруктуруРезультата = ОбновитьДанныеПСЦ(ДанныеПротокола); 
		КонецЕсли;
		Если СтруктуруРезультата.ЕстьОшибки Тогда
			// нужно дополнить ответ текстом ошибки  PurchaseXDTO, сделать метод формирования ответа
			Если ТипЗнч(СтруктуруРезультата.Комментарий) = Тип("ИнформацияОбОшибке") Тогда
				СтруктуруРезультата.Комментарий = ПодробноеПредставлениеОшибки(СтруктуруРезультата.Комментарий);
			КонецЕсли;
			PurchaseXDTO.Comment = СтруктуруРезультата.Комментарий;
			ЕстьОшибки = Истина;
			ОтветXDTO.Protocol.Добавить(PurchaseXDTO);
			Продолжить;
		КонецЕсли;
				
		ПСЦДокументСсылка = СтруктуруРезультата.ЗначениеЭлемента;
			
		PurchaseXDTO.Comment = "ОК" +?(ЗначениеЗаполнено(СтруктуруРезультата.Комментарий), "; "+СтруктуруРезультата.Комментарий, ""); 
		PurchaseXDTO.GUIDProtocol = Строка(ПСЦДокументСсылка.УникальныйИдентификатор()); 
		ОтветXDTO.Protocol.Добавить(PurchaseXDTO);
	КонецЦикла;  
	
	// вернем данные
	Ответ =  ОбернутьОтветДляПередачи(ОтветXDTO);
	ВходныеПараметры.Вставить("Ответ", Ответ );
	
	ВходныеПараметры.Вставить("Результат", НЕ ЕстьОшибки);
	
	Возврат НЕ ЕстьОшибки;

КонецФункции   

// ДИТ US 64822 Сержантова А.С. Начало: 13.07.2023
Функция ОбновитьДанныеПСЦ(ВходныеДанные)

	СтруктураРезультата = ИнициализироватьСтруктуруРезультата();  
	
	ИсточникСтрока = ВходныеДанные.ExternalSystemID; 
	ИсточникОбъект = Метаданные.Перечисления.УзлыОбмена.ЗначенияПеречисления.Найти(ИсточникСтрока);
	Если ИсточникОбъект = Неопределено Тогда 
		СтруктураРезультата.ЕстьОшибки = Истина;	
		СтруктураРезультата.Комментарий = "Не установлен источник по ExternalSystemID!";
		Возврат СтруктураРезультата;
	КонецЕсли; 
	Источник = Перечисления.УзлыОбмена[ИсточникСтрока];
	
	Если ЗначениеЗаполнено(ВходныеДанные.GUIDProtocol) ТОгда  // обновим существующий документ 
		ПротоколСсылка = РегистрыСведений.ПротоколОбменов.СсылкаПоУИД(ВходныеДанные.GUIDProtocol, Перечисления.ДействияПриОбмене.ВыгрузкаДанных, Источник); 
		Если ПротоколСсылка <> Неопределено Тогда
			
			// обработаем файлы
			Для Каждого ДанныеФайла ИЗ ВходныеДанные.Files Цикл 
				СтруктуруРезультатаСозданияФайла = ДобавитьФайлКДокументу(ПротоколСсылка, ДанныеФайла, Источник);        
				Если СтруктуруРезультатаСозданияФайла.ЕстьОшибки Тогда  
					СтруктураРезультата.ЕстьОшибки = Истина;
					СтруктураРезультата.Комментарий =  СтруктуруРезультатаСозданияФайла.Комментарий;
					Возврат СтруктураРезультата;	
				КонецЕсли;	
			КонецЦикла; 
			
			Если ЗначениеЗаполнено(ВходныеДанные.Signed) и не ПротоколСсылка.ПодписанСДвухСторон Тогда
				ДокументПСЦ = ПротоколСсылка.ПолучитьОбъект();
				ДокументПСЦ.ПодписанСДвухСторон = ВходныеДанные.Signed; 
				
				НачатьТранзакцию();
				Попытка
					ДокументПСЦ.Записать();	
					ЗафиксироватьТранзакцию();
				Исключение
					Если ТранзакцияАктивна() Тогда
						ОтменитьТранзакцию();
					КонецЕсли;
					СтруктураРезультата.Комментарий = "Не удалось обновить данные документа";  
					Возврат СтруктураРезультата;
				КонецПопытки;
			КонецЕсли;
			
			СтруктураРезультата.Комментарий = "Данные документа обновлены"; 
			СтруктураРезультата.ЗначениеЭлемента = ПротоколСсылка;	
		Иначе
			СтруктураРезультата.ЕстьОшибки = Истина;	
			СтруктураРезультата.Комментарий = "Не найден ранее отправленный документ ПСЦ по ГУИДУ!";  
			Возврат СтруктураРезультата;
		КонецЕсли;  
	КонецЕсли;
	
	Возврат СтруктураРезультата;

КонецФункции    

#КонецОбласти

#Область ВспомогательныеПроцедурыИФункции
// ДИТ US 64822 Сержантова А.С. Начало: 14.07.2023
Функция ДобавитьФайлКДокументу(ДокументВладелец, ДанныеФайла, ИсточникСсылка);
	
	СтруктураРезультата = ИнициализироватьСтруктуруРезультата();
	ДвоичныеДанные = ДанныеФайла.BinaryData;
	Если ДвоичныеДанные.Размер() = 0 Тогда
		СтруктураРезультата.ЕстьОшибки = Истина;
		СтруктураРезультата.Комментарий = "Invalid binary data.";
		Возврат СтруктураРезультата;
	КонецЕсли;	
	
	ВремяИзменения = ТекущаяДатаСеанса();
	ВремяИзмененияУниверсальное = ТекущаяДата();
	АдресВременногоХранилищаФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанные);

	// Создадим карточку Файла в БД 
	
	ФайлПрикрепленный = РегистрыСведений.ПротоколОбменов.СсылкаПоУИД(ДанныеФайла.GUID, Перечисления.ДействияПриОбмене.ЗагрузкаДанных, ИсточникСсылка); 
	Если ФайлПрикрепленный = Неопределено Тогда
		ОписаниеФайла = РаботаСФайламиКлиентСервер.СведенияОФайле("ФайлСВерсией");
		ОписаниеФайла.АдресВременногоХранилищаФайла = АдресВременногоХранилищаФайла;
		ОписаниеФайла.ИмяБезРасширения = ДанныеФайла.Name;
		ОписаниеФайла.РасширениеБезТочки = ОбщегоНазначенияКлиентСервер.РасширениеБезТочки(ДанныеФайла.Extension);
		ОписаниеФайла.Размер = ДвоичныеДанные.Размер();
		ОписаниеФайла.ВремяИзменения = ВремяИзменения;
		ОписаниеФайла.ВремяИзмененияУниверсальное = ВремяИзмененияУниверсальное;
		
		НовыйФайл = РаботаСФайламиСлужебныйВызовСервера.СоздатьФайлСВерсией(ДокументВладелец, ОписаниеФайла);
		НовыйФайл.Записать();
		
		Если НовыйФайл <> Неопределено И Не НовыйФайл.Пустая() Тогда	
			СтруктураРезультата.ЗначениеЭлемента =  ОписаниеФайла;  
			
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("ДействиеПриОбмене", Перечисления.ДействияПриОбмене.ЗагрузкаДанных);
			СтруктураПоиска.Вставить("УзелОбмена", ИсточникСсылка);
			СтруктураПоиска.Вставить("Объект", НовыйФайл);
			
			СтруктураДанных = Новый Структура;
			СтруктураДанных.Вставить("ДатаОбмена", ТекущаяДата());
			СтруктураДанных.Вставить("УИДИсточника", ДанныеФайла.GUID);
			СтруктураДанных.Вставить("Ответственный", Пользователи.ТекущийПользователь());
			Сообщение = РегистрыСведений.ПротоколОбменов.ЗафиксироватьИнформациюОЗагрузке(СтруктураПоиска, СтруктураДанных);
		КонецЕсли; 
	Иначе
		Если ФайлПрикрепленный.Размер <> ДвоичныеДанные.Размер() Тогда
			ОписаниеФайла = РаботаСФайламиКлиентСервер.СведенияОФайле("ФайлСВерсией");
			ОписаниеФайла.АдресВременногоХранилищаФайла = АдресВременногоХранилищаФайла;
			ОписаниеФайла.ИмяБезРасширения = ДанныеФайла.Name;
			ОписаниеФайла.РасширениеБезТочки = ОбщегоНазначенияКлиентСервер.РасширениеБезТочки(ДанныеФайла.Extension);
			ОписаниеФайла.Размер = ДвоичныеДанные.Размер();
			ОписаниеФайла.ВремяИзменения = ВремяИзменения;
			ОписаниеФайла.ВремяИзмененияУниверсальное = ВремяИзмененияУниверсальное;	
			НовыйФайл = РаботаСФайламиСлужебный.ОбновитьВерсиюФайла(ФайлПрикрепленный,, ФайлПрикрепленный.ТекущаяВерсия); 
			
			Если НовыйФайл <> Неопределено И Не НовыйФайл.Пустая() Тогда	
				СтруктураРезультата.ЗначениеЭлемента =  ОписаниеФайла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураРезультата;
КонецФункции	

// ДИТ US 64822 Сержантова А.С. Начало: 04.07.2023
Функция ПреобразоватьСообщениеВXDTOОбъект(ВходныеПараметры, ТипСообщения);
	
	Сообщение = ВходныеПараметры.Сообщение;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(Сообщение);

	Попытка 	
		СообщениеXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML,ТипСообщения);
	Исключение 
		ВходныеПараметры.Ответ = "Не удалось преобразовать сообщение в XDTO объект. Проверьте сообщение на соответствие формату.";
		Возврат Неопределено;
	КонецПопытки;

	Возврат СообщениеXDTO;
КонецФункции

// ДИТ US 64822 Сержантова А.С. Начало: 14.07.2023
Функция ОбернутьОтветДляПередачи(ОтветXDTO);
	
	МойXML = Новый ЗаписьXML; 
	МойXML.УстановитьСтроку("UTF-8");
	МойXML.ЗаписатьОбъявлениеXML(); 
	ФабрикаXDTO.ЗаписатьXML(МойXML, ОтветXDTO);
	ОтветСтрока = МойXML.Закрыть();
	
	Возврат ОтветСтрока;
КонецФункции

// ДИТ US 64822 Сержантова А.С. Начало: 13.07.2023
Функция ИнициализироватьСтруктуруРезультата()

	СтруктураРезультат = Новый Структура("ЗначениеЭлемента, Комментарий, ЕстьОшибки",,"",Ложь);	
	
	Возврат СтруктураРезультат

КонецФункции 

// ДИТ US 64822 Сержантова А.С. Начало: 04.07.2023
Функция ИнициализироватьСтруктуруДляОбработкиСообщения()  
	Ответ = "Не известная ошибка";
	СтруктураПараметров = Новый Структура("Сообщение, Ответ, Результат, ИсточникВызова", ,Ответ , Ложь,);
	
	Возврат СтруктураПараметров;
КонецФункции
	
#КонецОбласти
