Функция ПолучитьАдрес(XMLParams) 
	
	ДанныеXML = ОбщегоНазначения.ЗначениеИзСтрокиXML(XMLParams);
	ЗапрашиваемыйАдресСтрока = ДанныеXML.Address;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(АдресаВНаселенныхПунктах.Ссылка) КАК Идентификатор,
		|	АдресаВНаселенныхПунктах.Адрес КАК Адрес,
		|	АдресаВНаселенныхПунктах.Широта КАК Широта,
		|	АдресаВНаселенныхПунктах.Долгота КАК Долгота,
		|	АдресаВНаселенныхПунктахКомпонентыАдреса.НомерСтроки КАК НомерСтроки,
		|	АдресаВНаселенныхПунктахКомпонентыАдреса.ВидНайденногоТопонима КАК ВидНайденногоТопонима,
		|	АдресаВНаселенныхПунктахКомпонентыАдреса.Имя КАК Имя,
		|	АдресаВНаселенныхПунктах.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.АдресаВНаселенныхПунктах.КомпонентыАдреса КАК АдресаВНаселенныхПунктахКомпонентыАдреса
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.АдресаВНаселенныхПунктах КАК АдресаВНаселенныхПунктах
		|		ПО АдресаВНаселенныхПунктахКомпонентыАдреса.Ссылка = АдресаВНаселенныхПунктах.Ссылка
		|			И НЕ АдресаВНаселенныхПунктах.ПометкаУдаления
		|			И (АдресаВНаселенныхПунктах.Адрес = &АдресВНП)";
	
	Запрос.УстановитьПараметр("АдресВНП", ЗапрашиваемыйАдресСтрока);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();

	Если РезультатЗапроса.Количество() > 0 Тогда
		ДанныеXML = ОбщегоНазначения.ЗначениеВСтрокуXML(Новый Структура("TypeOfResult, Address", 1, РезультатЗапроса)); 
		Возврат ДанныеXML;
	КонецЕсли;
	
	//адреса не нашлось, или найденная карточка адреса с пометкой удаления, то спросим у Яндекса
	НаселенныйПункт = "";
	НаселенныйПунктРодитель = "";
	СтруктураРезультата = ГеокодированиеКлиентСервер.ПолучитьМассивАдресовЧерезГеокодерЯндекс(ЗапрашиваемыйАдресСтрока, НаселенныйПункт, НаселенныйПунктРодитель);
	Если ЗначениеЗаполнено(СтруктураРезультата.ОписаниеОшибки) Тогда
		ОбщегоНазначения.СообщитьПользователю(СтруктураРезультата.ОписаниеОшибки);
		Возврат Неопределено;
	КонецЕсли;
	ИдентификаторЗапроса = СтруктураРезультата.СтруктураРезультатаЗапроса.ИдентификаторЗапроса;
	
	//Сохраним пакет данных в регистре сведений «Данные пакетов обмена»
    ЗаписатьЛогГеокодераВДанныхПакетовОбменаНаСервере(СтруктураРезультата, ИдентификаторЗапроса);
			
	ДанныеXML = ОбщегоНазначения.ЗначениеВСтрокуXML(Новый Структура("TypeOfResult, Address, RequestID", 2, СтруктураРезультата.МассивАдресов, ИдентификаторЗапроса));
	
	Возврат ДанныеXML;
	
КонецФункции //Евросиб Коханенко Н.А. 18.12.2025 )) #125251

//Евросиб Коханенко Н.А. 18.12.2025 (( #125251
Процедура ЗаписатьЛогГеокодераВДанныхПакетовОбменаНаСервере(Результат, ИдентификаторЗапроса)
	
	мз = РегистрыСведений.ДанныеПакетовОбмена.СоздатьМенеджерЗаписи();
	мз.ПериодОбмена = ТекущаяДата();
	мз.ИдентификаторСтрокиПакетаДанных = ИдентификаторЗапроса;
    мз.ВнешнийИдентификаторСтрокиПакетаДанных = ИдентификаторЗапроса;
    мз.ИсточникПакетаДанных = ПредопределенноеЗначение("Справочник.ИсточникиПакетовДанных.ПолучениеДанныхГеокодера");
	мз.СтруктураДанных = Новый ХранилищеЗначения(Результат, Новый СжатиеДанных(9));
	мз.ОбъектДанных = Неопределено;
	мз.Обработано = Ложь;
	мз.ДатаОбработки = Дата(1,1,1);
	мз.ЕстьОшибки = Ложь;
	мз.ОписаниеОшибки = "";
	мз.Записать(); 
	
КонецПроцедуры //Евросиб Коханенко Н.А. 23.12.2025 )) #125251

