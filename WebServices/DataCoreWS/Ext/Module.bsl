Функция GetClaimsByDocnumberOrPeriod(docnumber, periodStart, periodEnd)
	
	Если НЕ ЗначениеЗаполнено(docnumber) и НЕ ЗначениеЗаполнено(periodStart) Тогда
		
		Возврат "<xml><error>EMPTY PARAMETERS!!!</error></xml>";
		
	КонецЕсли;
	
	Результат = ПретензииИНеакцептыСервер.ПредоставитьДанныеНеакцептовПоПериодуИлиНомеруДокумента(docnumber, periodStart, periodEnd);
	
	РезультатXML = "<xml>" + Символы.ПС + "<claims>" + Символы.ПС;
	
	Для каждого Стр из Результат Цикл
		
		РезультатXML = РезультатXML + "<claim pmRfCode=""" + Стр.pmRfCode + """ pmtRFC=""" + 
					Стр.pmtRFC + """ pmtObjDate=""" + Стр.pmtObjDate + """ pmtObjSum=""" + 
					Формат(Стр.pmtObjSum, "ЧН=; ЧГ=") + """ vSymCode=""" + Стр.vSymCode + """ pmtErrCodes=""" + 
					Стр.pmtErrCodes + """ pmtErrText=""" + Стр.pmtErrText + """ pmtObjFulfilment=""" + 
					Стр.pmtObjFulfilment + """ pmtNotes=""" + Стр.pmtNotes + """ pmtIsActual=""" + ?(Строка(Стр.pmtObjFulfilment) = "Рассматривается", 1, 0) + """ />";
		
	КонецЦикла;
	
	Возврат РезультатXML + "</claims>" + Символы.ПС + "</xml>"; // Юля должна уточнить формат данных!
	
КонецФункции

