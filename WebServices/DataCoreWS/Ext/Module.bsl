	РезультатXML = "<xml>" + Символы.ПС + "<shippings>" + Символы.ПС;
	Для каждого Стр из ТЗПланОтправок Цикл
		
		РезультатXML = РезультатXML + "<shipping stDepartureCode="""	+ Стр.КодЖДСтанцииОтправления					+ """ 
												|stDestinationCode=""" 	+ Стр.КодЖДСтанцииНазначения 					+ """
												|DepartureDate=""" 		+ Стр.ДатаОтправления 							+ """
												|ArrivalDate=""" 		+ Стр.ДатаПрибытия								+ """
												|TrainLenght=""" 		+ Формат(Стр.УсловнаяДлинаСостава,"ЧН=; ЧГ=")	+ """
												|TEU=""" 				+ Стр.КоличествоТЕУ								+ """
												|TEUReserved=""" 		+ Стр.ЗарезервированоТЭУ						+ """
												|UnloadingDuration=""" 	+ Стр.ДлительностьВыгрузки						+ """
												|Service="""		 	+ Стр.Сервис									+ """
												|Author="""		  	 	+ Стр.Автор 									+ """
												|UID="""		 		+ Стр.Ссылка.УникальныйИдентификатор()			+ """
												|/>";
		
	КонецЦикла;
	
	Возврат РезультатXML + "</shippings>" + Символы.ПС + "</xml>";
