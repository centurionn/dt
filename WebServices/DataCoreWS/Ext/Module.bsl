			Если ЗначениеЗаполнено(СтрокаТаблицы.ПериодВО) Тогда
				ПериодВО = Формат(СтрокаТаблицы.ПериодВО, "ДФ=dd.MM.yyyy");
				Если ПериодыВО.Найти(ПериодВО) = Неопределено Тогда
					ПериодыВО.Добавить(ПериодВО);
				КонецЕсли;
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаТаблицы.НомерАкта) Тогда
				НомерАкта = СтрШаблон("%1 %2", СокрЛП(СтрокаТаблицы.НомерАкта), Формат(СтрокаТаблицы.ДатаАкта, "ДФ=dd.MM.yyyy"));
				Если НомераАктов.Найти(НомерАкта) = Неопределено Тогда 
					НомераАктов.Добавить(НомерАкта);
				КонецЕсли;
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаТаблицы.НомерСделки) Тогда
				Если НомераСделок.Найти(СтрокаТаблицы.НомерСделки) = Неопределено Тогда
					НомераСделок.Добавить(СтрокаТаблицы.НомерСделки);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		ПериодыВОСтрокой = СтрСоединить(ПериодыВО, ";");
		ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "ПериодыВО", ПериодыВОСтрокой);
		НомераАктовСтрокой = СтрСоединить(НомераАктов, ";");
		ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "Акты", НомераАктовСтрокой);
		НомераСделокСтрокой = СтрСоединить(НомераСделок, ";");
		ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "Сделки", НомераСделокСтрокой);
		
		Запись.ЗаписатьКонецЭлемента(); //Act
		
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента(); //root
	
	Возврат Запись.Закрыть();
	
