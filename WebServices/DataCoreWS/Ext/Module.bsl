Функция GetKTK()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	стоки_ТекущиеДанныеСрезПоследних.КТК.Префикс КАК КТКСерия,
		|	стоки_ТекущиеДанныеСрезПоследних.КТК.Номер КАК КТКНомер,
		|	стоки_ТекущиеДанныеСрезПоследних.КТК.ТипТЕ КАК КТКТип,
		|	стоки_ТекущиеДанныеСрезПоследних.тек_Собственник.Наименование КАК СобственникНаименование,
		|	стоки_ТекущиеДанныеСрезПоследних.тек_Собственник.Код КАК СобственникКод,
		|	стоки_ТекущиеДанныеСрезПоследних.тек_Собственник.ИНН КАК СобственникИНН,
		|	"""" КАК СобственникГУИД,
		|	стоки_ТекущиеДанныеСрезПоследних.тек_ВидСобственности КАК ВидСобственности,
		|	стоки_ТекущиеДанныеСрезПоследних.тек_ДатаПриемаВПользование КАК ДатаПриемаВПользование,
		|	стоки_ТекущиеДанныеСрезПоследних.тек_СрокВозврата КАК СрокВозврата,
		|	стоки_ТекущиеДанныеСрезПоследних.тек_СВВ КАК СВВ,
		|	стоки_ТекущиеДанныеСрезПоследних.тек_Собственник КАК тек_Собственник,
		|	стоки_ТекущиеДанныеСрезПоследних.КТК.КонтрольноеЧисло КАК КТККонтрольноеЧисло,
		// + ДИТ Кузнецов Е.Е. 53477 28.10.2022
		|	стоки_ТекущиеДанныеСрезПоследних.тек_сток КАК тек_Сток,
		|	стоки_ТекущиеДанныеСрезПоследних.тек_ЛокацияСдачи КАК тек_ЛокацияСдачи,
		|	стоки_ТекущиеДанныеСрезПоследних.тек_ПунктыОкончСдачи КАК тек_ПунктыОкончСдачи,
		// - ДИТ Кузнецов Е.Е. 53477 28.10.2022
		// Евросиб Фролов (12.04.2022 Task №50207
		|	стоки_ТекущиеДанныеСрезПоследних.тек_ВЭксплуатации КАК ВЭксплуатации,		
		// Евросиб Фролов)
		//Евросиб Каблов 23.01.2024 ( #79698
		|	ВЫРАЗИТЬ("""" КАК СТРОКА(20)) КАК Ставка,
		|	стоки_ТекущиеДанныеСрезПоследних.комм_Ставка КАК СтавкаЧисло,
		|	стоки_ТекущиеДанныеСрезПоследних.комм_Валюта.Наименование КАК Валюта
		//Евросиб Каблов 23.01.2024 )
		|ИЗ
		|	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних КАК стоки_ТекущиеДанныеСрезПоследних
		|ИТОГИ ПО
		|	ОБЩИЕ";
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	Если РезультатЗапроса.Строки.Количество() > 0 Тогда
		//Евросиб Каблов 23.01.2024 ( #79698
		//Для каждого СтрокаПоКоду Из РезультатЗапроса.Строки[0].Строки Цикл
		Для каждого СтрокаПоКоду Из РезультатЗапроса.Строки Цикл
		//Евросиб Каблов 23.01.2024 )
			Для каждого СтрокаРезультата из СтрокаПоКоду.Строки Цикл
				Если ЗначениеЗаполнено(СтрокаРезультата.тек_Собственник) Тогда
					СтрокаРезультата.СобственникГУИД = Строка(СтрокаРезультата.тек_Собственник.УникальныйИдентификатор());
					//СтрокаРезультата.КТКНомер = Строка(СтрокаРезультата.КТКНомер)+Строка(СтрокаРезультата.КТККонтрольноеЧисло);
				КонецЕсли;
				//Евросиб Каблов 23.01.2024 ( #79698
				СтрокаРезультата.Ставка = Формат(СтрокаРезультата.СтавкаЧисло, "ЧДЦ=2; ЧН=0; ЧГ=0");
				//Евросиб Каблов 23.01.2024 )
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	//Евросиб Каблов 23.01.2024 ( #79698
	РезультатЗапроса.Колонки.Удалить("СтавкаЧисло");
	//Евросиб Каблов 23.01.2024 )
	
	Ответ = ЕСОбменСервер.ЗаписатьДеревоВXML(РезультатЗапроса);
	Возврат Ответ;
	
КонецФункции

