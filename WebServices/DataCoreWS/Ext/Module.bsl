			Результат = ЕСОбменСервер.ОбработатьКоносамент(ДанныеКоносамента, СтруктураПоискаВПротоколах, ОбъектXDTO, ТипыДокументов) ;
			СтруктураОтвета.Вставить("ГУИД_DX", Результат.ГУИД);
