Процедура ПодтвердитьЗагрузкуОбъектаПоГУИД(ГУИД, Действие, УзелОбмена) Экспорт
	
	СсылкаНаОбъект = РегистрыСведений.ПротоколОбменов.СсылкаПоУИД(ГУИД, Действие, УзелОбмена);
	Если СсылкаНаОбъект <> Неопределено Тогда 
		Объект = СсылкаНаОбъект.Получитьобъект();
		Если НЕ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаОбъект, "ПометкаУдаления") тогда
			 				
			ТипЗначения = ТипЗнч(СсылкаНаОбъект);
			ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
			//Если Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда// заготовка под справочник
			// что-то
			Если Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
				Попытка
					Объект.Записать(РежимЗаписиДокумента.Проведение); 
				Исключение 
					Объект.Записать(РежимЗаписиДокумента.Запись);
				КонецПопытки; 				
			КонецЕсли; 
			
		КонецЕсли;
		
		//УстановитьПривилегированныйРежим(Истина);	
		НаборЗаписей = РегистрыСведений.ПротоколОбменов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДействиеПриОбмене.Установить(Действие);
		НаборЗаписей.Отбор.УзелОбмена.Установить(УзелОбмена);
		НаборЗаписей.Отбор.Объект.Установить(Объект.ссылка);
		
		НаборЗаписей.Прочитать();
		Для Каждого Запись Из НаборЗаписей Цикл
			 Запись.ЗагрузкаПодтверждена = Истина; 
		 КонецЦикла;
		 НаборЗаписей.Записать();
