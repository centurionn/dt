		Для каждого ДанныеКоносамента из ОбъектXDTO.Шапка Цикл

		СтруктураОтвета = Новый Структура("ID_DX, ГУИД_DX, Error");
		СтруктураОтвета.Вставить("ID_DX", ДанныеКоносамента.ID_DX);
		
		//Если что-то не заполнено из обязательных реквизитов фиксируем и пропускам документ		
