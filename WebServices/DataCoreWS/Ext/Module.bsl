Функция  CreateDispatchSea(XMLParams) 
    
	Чтение 				= Новый ЧтениеXML;
	Чтение.УстановитьСтроку(XMLParams);
	Фабрика 			= Новый ФабрикаXDTO;
	ОбъектXDTO			= Фабрика.ПрочитатьXML(Чтение); 
	
	МассивОбработанныхДокументов = Новый Массив; 
	МодульРС 		= РегистрыСведений.ПротоколОбменов;
	ЗагрузкаДанных 	= Перечисления.ДействияПриОбмене.ЗагрузкаДанных;
	УзелОбмена 		= Перечисления.УзлыОбмена.DX;
	
	ТипОбъекта = Новый СписокЗначений;
	ТипОбъекта.Добавить(Тип("СправочникСсылка.РейсыМоре"));
	//РегистрыСведений.ПротоколОбменов.УдалитьНеподтвержденныеОбъекты(УзелОбмена, ЗагрузкаДанных, ТипОбъекта); //Евросиб(ДИТ), Беляев СЮ, US 88935/TA 89126, 12-08-2024, закомменировал (перенесено в отдельное задание)
	
	СтруктураПоискаВПротоколах = Новый Структура ;
	СтруктураПоискаВПротоколах.Вставить("МодульРС",МодульРС);
	СтруктураПоискаВПротоколах.Вставить("ЗагрузкаДанных",ЗагрузкаДанных); 
	СтруктураПоискаВПротоколах.Вставить("УзелОбмена",УзелОбмена);
	
	Если НЕ ТипЗнч(ОбъектXDTO.Шапка)= ТИП(ОбъектXDTO) тогда 	
		Для каждого ДанныеРейса из ОбъектXDTO.Шапка цикл

		СтруктураОтвета = Новый Структура("ID_DX, ГУИД_DX, Error");
		СтруктураОтвета.Вставить("ID_DX", ДанныеРейса.ID_DX);
		
		Результат = ЕСОбменСервер.ОбработатьРейс(ДанныеРейса, СтруктураПоискаВПротоколах, ОбъектXDTO, ТипОбъекта) ;
				
		СтруктураОтвета.Вставить("Error", Результат.Error);
		СтруктураОтвета.Вставить("ГУИД_DX", Результат.ГУИД);

		МассивОбработанныхДокументов.Добавить(СтруктураОтвета);
	КонецЦикла;
	
	Иначе		
		 ДанныеРейса = ОбъектXDTO.Шапка;

		СтруктураОтвета = Новый Структура("ID_DX, ГУИД_DX, Error");
		СтруктураОтвета.Вставить("ID_DX", ДанныеРейса.ID_DX);
		Результат = ЕСОбменСервер.ОбработатьРейс(ДанныеРейса, СтруктураПоискаВПротоколах, ОбъектXDTO, ТипОбъекта) ;
			
		СтруктураОтвета.Вставить("Error", Результат.Error);
		СтруктураОтвета.Вставить("ГУИД_DX", Результат.ГУИД);
		МассивОбработанныхДокументов.Добавить(СтруктураОтвета);
		КонецЕсли;
		
	//формирование и выгрузка ответа
	
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	Запись.ЗаписатьОбъявлениеXML(); //
	Запись.ЗаписатьНачалоЭлемента("Root"); 	
	
	Для Каждого Док Из МассивОбработанныхДокументов Цикл
		Запись.ЗаписатьНачалоЭлемента("Коносамент");       		
		Запись.ЗаписатьАтрибут("ID_DX",Док.ID_DX);
		Запись.ЗаписатьАтрибут("ГУИД_DX",Строка(Док.ГУИД_DX));
		Запись.ЗаписатьАтрибут("Error",Док.Error);
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	ОтветXml = Запись.Закрыть();

	Возврат ОтветXml	

