//Евросиб Литвинов ) 15.02.2022 #44592 Ticket#0254477 #44587
	
		Акты = ТаблицаАктов.НайтиСтроки(Новый Структура("Акцепт", Выборка.Акцепт));
		ПериодыВО = Новый Массив;
		НомераАктов = Новый Массив;
		НомераСделок = Новый Массив;
