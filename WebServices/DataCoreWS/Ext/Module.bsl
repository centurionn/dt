// Рыбьяков К.А 14.05.2024 US 81613 Начало
Функция GetProcessedDocuments(DateBegin, DateEnd) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ОтработанныеДокументыБухгалтерией.Документ.ПСЦПоставщика
	|			ТОГДА ""Протокол согласования договорной цены (подрядчик)""
	|		ИНАЧЕ ""Протокол согласования договорной цены (клиент)""
	|	КОНЕЦ КАК Документ,
	|	ОтработанныеДокументыБухгалтерией.Документ КАК ДокументСсылка,
	|	ОтработанныеДокументыБухгалтерией.НомерДокумента КАК НомерДокумента,
	|	ПРЕДСТАВЛЕНИЕ(ОтработанныеДокументыБухгалтерией.Организация) КАК Организация,
	|	ОтработанныеДокументыБухгалтерией.ДатаУчетаДокумента КАК ДатаУчетаДокумента,
	|	ПРЕДСТАВЛЕНИЕ(ОтработанныеДокументыБухгалтерией.Контрагент) КАК НаименованиеКонтрагента,
	|	ОтработанныеДокументыБухгалтерией.Контрагент КАК Контрагент,
	|	ОтработанныеДокументыБухгалтерией.Проведен КАК Проведен,
	|	ОтработанныеДокументыБухгалтерией.ДатаУдаленияДокумента КАК ДатаУдаленияДокумента,
	|	ОтработанныеДокументыБухгалтерией.ДатаДокумента КАК ДатаДокумента,
	|	ЕСТЬNULL(ОтработанныеДокументыБухгалтерией.Ответственный.Наименование, """") КАК Ответственный
	|ИЗ
	|	РегистрСведений.ОтработанныеДокументыБухгалтерией КАК ОтработанныеДокументыБухгалтерией
	|ГДЕ
	|	(ОтработанныеДокументыБухгалтерией.ДатаУчетаДокумента МЕЖДУ &НачПериод И &КонПериод
	|			ИЛИ ОтработанныеДокументыБухгалтерией.ДатаУдаленияДокумента МЕЖДУ &НачПериод И &КонПериод
	|				И ОтработанныеДокументыБухгалтерией.ДатаУчетаДокумента <> ДАТАВРЕМЯ(1, 1, 1))";

	Запрос.УстановитьПараметр("КонПериод", DateEnd);
	Запрос.УстановитьПараметр("НачПериод", DateBegin);
		
	Выгрузка = Запрос.Выполнить().Выгрузить();
	
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку("UTF-8");
	 
	Запись.ЗаписатьОбъявлениеXML();
	
	Запись.ЗаписатьНачалоЭлемента("Protocols");
	
	Для Каждого СтрокаПСЦ Из Выгрузка Цикл
		
		Запись.ЗаписатьНачалоЭлемента("Protocol");   
		
		Запись.ЗаписатьНачалоЭлемента("ProtocolName");		
		Запись.ЗаписатьТекст(XMLСтрока(СтрокаПСЦ.Документ));		
		Запись.ЗаписатьКонецЭлемента();
						
		Запись.ЗаписатьНачалоЭлемента("ProtocolID");		
		Запись.ЗаписатьТекст(XMLСтрока(СтрокаПСЦ.ДокументСсылка));		
		Запись.ЗаписатьКонецЭлемента();
		
		Запись.ЗаписатьНачалоЭлемента("Number");
		Запись.ЗаписатьТекст(СтрокаПСЦ.НомерДокумента);		
		Запись.ЗаписатьКонецЭлемента();
				
		Запись.ЗаписатьНачалоЭлемента("Organization");		
		Запись.ЗаписатьТекст(XMLСтрока(СтрокаПСЦ.Организация));		
		Запись.ЗаписатьКонецЭлемента();
		
		Запись.ЗаписатьНачалоЭлемента("AccountingDate");
		Запись.ЗаписатьТекст(XMLСтрока(СтрокаПСЦ.ДатаУчетаДокумента));		
		Запись.ЗаписатьКонецЭлемента();
		
		Запись.ЗаписатьНачалоЭлемента("ContragentName");		
		Запись.ЗаписатьТекст(XMLСтрока(СтрокаПСЦ.НаименованиеКонтрагента));		
		Запись.ЗаписатьКонецЭлемента();
		
		Запись.ЗаписатьНачалоЭлемента("ContragentID");		
		Запись.ЗаписатьТекст(XMLСтрока(СтрокаПСЦ.Контрагент));		
		Запись.ЗаписатьКонецЭлемента();
		
		Запись.ЗаписатьНачалоЭлемента("Actual");
		Запись.ЗаписатьТекст(XMLСтрока(?(СтрокаПСЦ.Проведен, 1, 0)));		
		Запись.ЗаписатьКонецЭлемента();
		
		Запись.ЗаписатьНачалоЭлемента("DocumentDate");
		Запись.ЗаписатьТекст(XMLСтрока(СтрокаПСЦ.ДатаДокумента));		
		Запись.ЗаписатьКонецЭлемента();
		
		Запись.ЗаписатьНачалоЭлемента("Manager");
		Если СтрокаПСЦ.Ответственный = "" Тогда
			Запись.ЗаписатьТекст(XMLСтрока(""));	
		Иначе
			Запись.ЗаписатьТекст(XMLСтрока(ФизическиеЛицаКлиентСервер.ФамилияИнициалы(СтрокаПСЦ.Ответственный)));
		КонецЕсли;
		Запись.ЗаписатьКонецЭлемента();
		
		Запись.ЗаписатьНачалоЭлемента("DeleteDate");
		Запись.ЗаписатьТекст(XMLСтрока(?(СтрокаПСЦ.Проведен, Дата("00010101"), СтрокаПСЦ.ДатаУдаленияДокумента)));		
		Запись.ЗаписатьКонецЭлемента();
		
		Запись.ЗаписатьКонецЭлемента();
		
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	
	ПротоколыXML = Запись.Закрыть();
	
	Возврат ПротоколыXML;	
			
КонецФункции
