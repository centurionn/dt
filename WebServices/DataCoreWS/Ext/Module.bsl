// + ДИТ Кузнецов Е.Е. 50174 26.10.2022
Функция GetKTKList()

	МоментПолучения = ТекущаяДата();
	Запрос = Новый Запрос;
	//Запрос сбора данных
	//ДИТ Шевченко А.В. 62309 29.12.22 -начало
	//Запрос.Текст = ТекстЗапросаСпискаКТК();
	Запрос.Текст = АРМ_Сервер.СобратьТекстЗапросаТекущийСток();
	Запрос.УстановитьПараметр("ДатаОкончания",ТекущаяДата());
	ТаблицаКТК = ПолучитьПустуюТаблицуКТК();
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НовСтрока = ТаблицаКТК.Добавить();
		НовСтрока.Период 			= Выборка.ДатаВвозаВывоза;
		НовСтрока.Контейнер 		= Выборка.КонтейнерНаименование;
		НовСтрока.Состояние 		= "Порожний";
		Если Выборка.Состояние Тогда
			НовСтрока.Состояние 		= "Груженый";
		КонецЕсли;	
		НовСтрока.Поврежден 		= "Нет";
		Если Выборка.Поврежден Тогда
			НовСтрока.Поврежден 		= "Да";
		КонецЕсли;
		НовСтрока.Терминал 		    = Выборка.ТерминалНаименование;
		НовСтрока.КодСodeco 		= СокрЛП(Выборка.ТерминалПредставлениеВCodeco);
		НовСтрока.КодТерминала  	= СокрЛП(Выборка.ТерминалКод);
		// ДИТ 65580 Давудов М.А. Начало: 23.02.2023
		//Было:
		//НовСтрока.ВидСобственности  = Выборка.ВидСобственностиДляВебСервиса;
		//Стало:
		НовСтрока.ВидСобственности  = Выборка.ВидСобственности;
		// ДИТ 65580 Давудов М.А. Конец: 23.02.2023
	КонецЦикла;	
	//ДИТ Шевченко А.В. 62309 29.12.22 -конец
	//Сериализация
	Возврат ЕСОбменСервер.ЗаписатьТаблицуВXML(ТаблицаКТК);
	
КонецФункции	

Функция ПолучитьПустуюТаблицуКТК() //ДИТ Шевченко А.В. 62309 29.12.22
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Период",Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТЗ.Колонки.Добавить("Контейнер",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(11)));
	ТЗ.Колонки.Добавить("Состояние",Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("Терминал",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(150)));
	ТЗ.Колонки.Добавить("Поврежден",Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("КодСodeco",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(30)));
	ТЗ.Колонки.Добавить("КодТерминала",Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("ВидСобственности",Новый ОписаниеТипов("Строка"));
	Возврат ТЗ
КонецФункции	

Функция ТекстЗапросаСпискаКТК()
	Возврат "ВЫБРАТЬ
	        |	ИнформацияОтТерминаловСрезПоследних.Период КАК Период,
	        |	ВЫБОР
	        |		КОГДА ИнформацияОтТерминаловСрезПоследних.Контейнер = ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
	        |			ТОГДА ИнформацияОтТерминаловСрезПоследних.НомерКонтейнера
	        |		ИНАЧЕ ИнформацияОтТерминаловСрезПоследних.Контейнер.Наименование
	        |	КОНЕЦ КАК НомерКТК,
	        |	ВЫБОР
	        |		КОГДА ИнформацияОтТерминаловСрезПоследних.Состояние
	        |			ТОГДА ""Груженый""
	        |		ИНАЧЕ ""Порожний""
	        |	КОНЕЦ КАК Состояние,
	        |	ЕСТЬNULL(ИнформацияОтТерминаловСрезПоследних.Терминал.Наименование, """") КАК Терминал,
	        |	"""" КАК Сток,
	        |	ИнформацияОтТерминаловСрезПоследних.Поврежден КАК Поврежден,
	        |	ИнформацияОтТерминаловСрезПоследних.Статус.Наименование КАК Статус,
	        |	1 КАК Приоритет
	        |ПОМЕСТИТЬ ВТ_ДетальныеЗаписи
	        |ИЗ
	        |	РегистрСведений.ИнформацияОтТерминалов.СрезПоследних КАК ИнформацияОтТерминаловСрезПоследних
	        |
	        |ОБЪЕДИНИТЬ ВСЕ
	        |
	        |ВЫБРАТЬ
	        |	ВЫБОР
	        |		КОГДА стоки_ТекущиеДанныеСрезПоследних.тек_ДатаВзятияИзСтока = ДАТАВРЕМЯ(1, 1, 1)
	        |			ТОГДА стоки_ТекущиеДанныеСрезПоследних.тек_ДатаПриемаВСток
	        |		ИНАЧЕ стоки_ТекущиеДанныеСрезПоследних.тек_ДатаВзятияИзСтока
	        |	КОНЕЦ,
	        |	стоки_ТекущиеДанныеСрезПоследних.КТК.Наименование,
	        |	"""",
	        |	ВЫБОР
	        |		КОГДА стоки_ТекущиеДанныеСрезПоследних.тек_ДатаВзятияИзСтока = ДАТАВРЕМЯ(1, 1, 1)
	        |			ТОГДА стоки_ТекущиеДанныеСрезПоследних.тек_СтокСдачи.Родитель.Наименование
	        |		ИНАЧЕ стоки_ТекущиеДанныеСрезПоследних.тек_СтокВзятия.Родитель.Наименование
	        |	КОНЕЦ,
	        |	ВЫБОР
	        |		КОГДА стоки_ТекущиеДанныеСрезПоследних.тек_ДатаВзятияИзСтока = ДАТАВРЕМЯ(1, 1, 1)
	        |			ТОГДА стоки_ТекущиеДанныеСрезПоследних.тек_СтокСдачи.Наименование
	        |		ИНАЧЕ стоки_ТекущиеДанныеСрезПоследних.тек_СтокВзятия.Наименование
	        |	КОНЕЦ,
	        |	стоки_ТекущиеДанныеСрезПоследних.тек_ТребуетсяРемонт,
	        |	стоки_ТекущиеДанныеСрезПоследних.тек_Статус,
	        |	0
	        |ИЗ
	        |	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних КАК стоки_ТекущиеДанныеСрезПоследних
	        |ГДЕ
	        |	стоки_ТекущиеДанныеСрезПоследних.тек_ВЭксплуатации
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	МАКСИМУМ(ВТ_ДетальныеЗаписи.Период) КАК Период,
	        |	ВТ_ДетальныеЗаписи.НомерКТК КАК НомерКТК
	        |ПОМЕСТИТЬ ВТ_МаксимумыПериод
	        |ИЗ
	        |	ВТ_ДетальныеЗаписи КАК ВТ_ДетальныеЗаписи
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	ВТ_ДетальныеЗаписи.НомерКТК
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ВТ_МаксимумыПериод.Период КАК Период,
	        |	ВТ_МаксимумыПериод.НомерКТК КАК НомерКТК,
	        |	МАКСИМУМ(ВТ_ДетальныеЗаписи.Приоритет) КАК Приоритет
	        |ПОМЕСТИТЬ ВТ_МаксимумыПериодПриоритет
	        |ИЗ
	        |	ВТ_МаксимумыПериод КАК ВТ_МаксимумыПериод
	        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДетальныеЗаписи КАК ВТ_ДетальныеЗаписи
	        |		ПО ВТ_МаксимумыПериод.НомерКТК = ВТ_ДетальныеЗаписи.НомерКТК
	        |			И ВТ_МаксимумыПериод.Период = ВТ_ДетальныеЗаписи.Период
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	ВТ_МаксимумыПериод.Период,
	        |	ВТ_МаксимумыПериод.НомерКТК
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ВТ_МаксимумыПериодПриоритет.НомерКТК КАК НомерКТК,
	        |	ВТ_ДетальныеЗаписи.Терминал КАК Терминал,
	        |	ВТ_ДетальныеЗаписи.Сток КАК Сток,
	        |	ВТ_ДетальныеЗаписи.Состояние КАК Состояние,
	        |	ВТ_ДетальныеЗаписи.Период КАК Период,
	        |	ПРЕДСТАВЛЕНИЕ(ВТ_ДетальныеЗаписи.Статус) КАК Статус,
	        |	ВТ_ДетальныеЗаписи.Поврежден КАК Поврежден
	        |ИЗ
	        |	ВТ_МаксимумыПериодПриоритет КАК ВТ_МаксимумыПериодПриоритет
	        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДетальныеЗаписи КАК ВТ_ДетальныеЗаписи
	        |		ПО ВТ_МаксимумыПериодПриоритет.Период = ВТ_ДетальныеЗаписи.Период
	        |			И ВТ_МаксимумыПериодПриоритет.НомерКТК = ВТ_ДетальныеЗаписи.НомерКТК
	        |			И ВТ_МаксимумыПериодПриоритет.Приоритет = ВТ_ДетальныеЗаписи.Приоритет";
КонецФункции
