		СтруктураОтвета.Вставить("ГУИД_DX", Результат.ГУИД);
     	СтруктураОтвета.Вставить("Error", Результат.Error); 
		МассивОбработанныхДокументов.Добавить(СтруктураОтвета);
	КонецЦикла;
	
	Иначе		
		 ДанныеКоносамента = ОбъектXDTO.Шапка;

		СтруктураОтвета = Новый Структура("ID_DX, ГУИД_DX, Error");
		СтруктураОтвета.Вставить("ID_DX", ДанныеКоносамента.ID_DX);
		
		//Если что-то не заполнено из обязательных реквизитов фиксируем и пропускам документ		
		НеобходимыеРеквизиты = ЕСОбменСервер.ПроверитьНаборОбязательныхРеквизитов(ДанныеКоносамента); 
		Если НеобходимыеРеквизиты = Ложь Тогда
			СтруктураОтвета.Вставить("Error", "Не заполнена дата документа");
			МассивОбработанныхДокументов.Добавить(СтруктураОтвета);
