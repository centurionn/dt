Функция ВыгрузитьТабельноеРасписание()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТабельныеРасписанияРЖДРасписание.Ссылка.Код КАК Код,
	//Евросиб Каблов 13.04.2021 ( Task 32839
	|	ТабельныеРасписанияРЖДРасписание.Ссылка КАК Ссылка,
	//Евросиб Каблов 13.04.2021 )
	|	ТабельныеРасписанияРЖДРасписание.Ссылка.Наименование КАК Наименование,
	|	ТабельныеРасписанияРЖДРасписание.Ссылка.ПунктОтправления.КодЖДСтанции КАК ПунктОтправленияКодЖДСтанции,
	|	ТабельныеРасписанияРЖДРасписание.Ссылка.ПунктНазначения.КодЖДСтанции КАК ПунктНазначенияКодЖДСтанции,
	|	ТабельныеРасписанияРЖДРасписание.Ссылка.ВсегоВПутиЧ КАК ВсегоВПутиЧ,
	|	ТабельныеРасписанияРЖДРасписание.НомерСтроки КАК НомерСтроки,
	|	ТабельныеРасписанияРЖДРасписание.Станция.КодЖДСтанции КАК СтанцияКодЖДСтанции,
	|	ТабельныеРасписанияРЖДРасписание.ДоСледующейСтанции КАК ВремяВПути,
	|	ТабельныеРасписанияРЖДРасписание.ВремяОтправления КАК ВремяОтправления,
	|	ТабельныеРасписанияРЖДРасписание.ВремяПрибытия КАК ВремяПрибытия,
	|	ТабельныеРасписанияРЖДРасписание.РасстояниеДоСледующейСтанции КАК РасстояниеДоСледующейСтанции,
	//Евросиб Фролов (27.09.2021 Ticket№ 38934
	|	ТабельныеРасписанияРЖДРасписание.Ссылка.ПометкаУдаления КАК Удалена
	// Евросиб Фролов) 
	|ИЗ
	|	Справочник.ТабельныеРасписанияРЖД.Расписание КАК ТабельныеРасписанияРЖДРасписание
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|ИТОГИ ПО
	|	ОБЩИЕ,
	|	Код";
	РезультатЗапроса = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	//Евросиб Каблов 13.04.2021 ( Task 32839
	РезультатЗапроса.Колонки.Добавить("ГУИД", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(36)));
	Если РезультатЗапроса.Строки.Количество() > 0 Тогда
		Для каждого СтрокаПоКоду Из РезультатЗапроса.Строки[0].Строки Цикл
			ИдентификаторДляСсылки = "";
			Для Каждого СтрокаРасписания Из СтрокаПоКоду.Строки Цикл
				Если Не ЗначениеЗаполнено(ИдентификаторДляСсылки) Тогда
					Идентификатор = Строка(СтрокаРасписания.Ссылка.УникальныйИдентификатор());
					ИдентификаторДляСсылки = Сред(Идентификатор, 20, 4) + Сред(Идентификатор, 25, 12) + Сред(Идентификатор, 15, 4) + Сред(Идентификатор, 10, 4) + Сред(Идентификатор, 1, 8);
				КонецЕсли;
				СтрокаРасписания.ГУИД = ИдентификаторДляСсылки;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	РезультатЗапроса.Колонки.Удалить(РезультатЗапроса.Колонки.Ссылка);
	//Евросиб Каблов 13.04.2021 )
	Ответ = ЕСОбменСервер.ЗаписатьДеревоВXML(РезультатЗапроса);
	Возврат Ответ;
КонецФункции

Функция GetShippingPlan()
