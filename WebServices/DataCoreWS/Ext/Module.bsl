	Чтение 				= Новый ЧтениеXML;
	Чтение.УстановитьСтроку(XMLParams);
	Фабрика 			= Новый ФабрикаXDTO;
	ОбъектXDTO			= Фабрика.ПрочитатьXML(Чтение);
	
	ЗагрузкаДанных 	= Перечисления.ДействияПриОбмене.ЗагрузкаДанных;
	УзелОбмена 		= Перечисления.УзлыОбмена.DX;


	Если НЕ ТипЗнч(ОбъектXDTO.Шапка)= ТИП(ОбъектXDTO) Тогда
		Для Каждого Объект Из ОбъектXDTO.Шапка Цикл
			ПодтвердитьЗагрузкуОбъектаПоГУИД(Объект.ГУИД_DX, ЗагрузкаДанных, УзелОбмена)
		КонецЦикла	
		
	Иначе		
		Объект = ОбъектXDTO.Шапка;
		ПодтвердитьЗагрузкуОбъектаПоГУИД(Объект.ГУИД_DX, ЗагрузкаДанных, УзелОбмена);
	КонецЕсли;
	Возврат "Подтверждение завершено"

