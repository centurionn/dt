	Возврат ЕСОбменСибурСервер.ПолучитьДислокациюКонтейнеров(XMLRequest);
	
КонецФункции

Функция УдалитьGetDislocationCont(XMLRequest)
	
	ФорматДаты = "ДФ=yyyy-MM-ddTHH:mm:ss+03:00";
	//ТаблицаСтатусов = ПолучитьТаблицуДислокационныхСтатусов();
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(XMLRequest);
	
	ОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(Чтение);
		
	Если ОбъектXDTO.Свойства().Получить("CREATED_ON_START") <> Неопределено Или ОбъектXDTO.Свойства().Получить("CREATED_ON_END") <> Неопределено Тогда
		ДатаНачала = XMLЗначение(Тип("Дата"), ОбъектXDTO.CREATED_ON_START);
		ДатаНачала = МестноеВремя(ДатаНачала);
		ДатаОкончания = XMLЗначение(Тип("Дата"), ОбъектXDTO.CREATED_ON_END);
		ДатаОкончания = МестноеВремя(ДатаОкончания);
	Иначе
		Возврат "";
	КонецЕсли;
	
	Если ОбъектXDTO.Свойства().Получить("CONTAINER_ID") <> Неопределено Тогда
		ИдентификаторКонтейнера = ОбъектXDTO.CONTAINER_ID;
		Выборка = ПолучитьДислокационныеДанныеПоИдентификаторуКонтейнераЗаПериод(ДатаНачала, ДатаОкончания, ИдентификаторКонтейнера);
	Иначе
		Выборка = ПолучитьДислокационныеДанныеЗаПериод(ДатаНачала, ДатаОкончания);
	КонецЕсли;	
	
	Запись = Новый ЗаписьXML;
		
	Запись.УстановитьСтроку("UTF-8");
	Запись.ЗаписатьОбъявлениеXML();
	
	Запись.ЗаписатьНачалоЭлемента("n0:mt_displacement_data_ans");
	
	ДобавитьАтрибутВФайл(Запись, "xmlns:n0", "urn:sibur:po:a:TM:Railway");
	
	Пока Выборка.Следующий() Цикл
		
		Запись.ЗаписатьНачалоЭлемента("ROW");
	
		ДобавитьЭлементВФайл(Запись, "WAYBILL_INV_NUM", Выборка.НомерНакладной);
		ДобавитьЭлементВФайл(Запись, "PARENT_KEY_WBINVNUM", ""); //Номер досылочной накладной, если имеется
		ДобавитьЭлементВФайл(Запись, "INDEX_RW", Выборка.ИндексПоезда); //Индекс поезда
		
		НомерПоезда = "";
		Если ЗначениеЗаполнено(Выборка.ИндексПоезда) Тогда
			НомерПоезда = Сред(Выборка.ИндексПоезда, 7, 3);
		КонецЕсли;
		ДобавитьЭлементВФайл(Запись, "NUMBER_RW", НомерПоезда);			//Номер поезда
		ДобавитьЭлементВФайл(Запись, "CONTAINER_ID", Выборка.КонтейнерНаименование);		
		ДобавитьЭлементВФайл(Запись, "CONTAINER_MOT", Выборка.РазмерКТК + "FT");		
		//ДобавитьЭлементВФайл(Запись, "CONTAINER_WEI_VAL", Выборка.МассыВКгТары); //Удалено из формата
		//ДобавитьЭлементВФайл(Запись, "CONTAINER_WEI_UOM", "КГ"); //Удалено из формата
		//ДобавитьЭлементВФайл(Запись, "CAPACITY_MAX", ""); //Удалено из формата
		//ДобавитьЭлементВФайл(Запись, "CAPACITY_MAX_UOM", ""); //Удалено из формата
		//ДобавитьЭлементВФайл(Запись, "WEIGHT", ""); //Удалено из формата  //Максимально допустимый вес продукции. При выгрузке из Ритма пусто
		//ДобавитьЭлементВФайл(Запись, "WEIGHT_UOM", ""); //Удалено из формата
		//ДобавитьЭлементВФайл(Запись, "NET_WEI_VAL", Выборка.МассыВКгНетто); //Удалено из формата
		//ДобавитьЭлементВФайл(Запись, "NET_WEI_UOM", "КГ"); //Удалено из формата
		//ДобавитьЭлементВФайл(Запись, "VOLUME", ""); 
		//ДобавитьЭлементВФайл(Запись, "VOLUME_UOM", ""); 
		ДобавитьЭлементВФайл(Запись, "PLATE_ID", Выборка.НомерВагона);
		ДобавитьЭлементВФайл(Запись, "PLATE_MOT", Выборка.ВидЖДПлатформы);
		//ДобавитьЭлементВФайл(Запись, "PLATE_WEI_VAL", Выборка.МассаТарыВагона); //Удалено из формата
		//ДобавитьЭлементВФайл(Запись, "PLATE_WEI_UOM", "КГ"); //Удалено из формата
		
		Если Выборка.СобственникМорскаяЛиния = Неопределено Тогда
			ДобавитьЭлементВФайл(Запись, "CONTAINER_OWNER_ID", "");
			ДобавитьЭлементВФайл(Запись, "CONTAINER_OWNER_DESCR", "");
		ИначеЕсли Выборка.СобственникМорскаяЛиния = Истина Тогда
			
		КонецЕсли;
		ДобавитьЭлементВФайл(Запись, "PLATE_OWNER_ID", );
		ДобавитьЭлементВФайл(Запись, "PLATE_OWNER_DESCR", );
		//ДобавитьЭлементВФайл(Запись, "CARRIER_ID", ); //Удалено из формата
		//ДобавитьЭлементВФайл(Запись, "CARRIER_DESCR", ); //Удалено из формата
		ДобавитьЭлементВФайл(Запись, "SHIPPER_ID", Выборка.ГрузоотправительИД);
		ДобавитьЭлементВФайл(Запись, "SHIPPER_DESCR", Выборка.ГрузоотправительНаименование);
		ДобавитьЭлементВФайл(Запись, "CONSIGNEE_ID", Выборка.ГрузополучательИД);
		ДобавитьЭлементВФайл(Запись, "CONSIGNEE_DESCR", Выборка.ГрузополучательНаименование);
		ДобавитьЭлементВФайл(Запись, "SOURCE_LOC", Выборка.СтанцияОтправленияКод);
		ДобавитьЭлементВФайл(Запись, "SOURCE_LOC_DESC", Выборка.НаименованиеСтанцииОтправления);
		ДобавитьЭлементВФайл(Запись, "DEST_LOC", Выборка.СтанцияНазначенияКодЖДСтанции);
		ДобавитьЭлементВФайл(Запись, "DEST_LOC_DESC", Выборка.СтанцияНазначенияНаименование);
		ДобавитьЭлементВФайл(Запись, "CURRENT_LOC", Выборка.СтанцияОперацииКодЖДСтанции);
		ДобавитьЭлементВФайл(Запись, "CURRENT_LOC_DESC", Выборка.СтанцияОперацииНаименование);
		//ДобавитьЭлементВФайл(Запись, "RFQ_ETA", Формат(Выборка.ДатаИВремяПрибытияГруза, ФорматДаты)); //Удалено из формата // новая
		ДобавитьЭлементВФайл(Запись, "RFQ_ID", "1100000020/100"); //новая Идентификатор заявки SAP TM - новая
		ДобавитьЭлементВФайл(Запись, "REF_RFQ", "8955624896");  //CHAR 20	Внешний номер заявки  
		//ДобавитьЭлементВФайл(Запись, "NEXT_LOCT", Выборка.СтанцияНазначенияКодЖДСтанции); //Удалено из формата//Станция назначения. Информация по исполнению перевозки в рамках конкретной заявки

		ДобавитьЭлементВФайл(Запись, "ETD", Формат(Выборка.ДатаИВремяОтправленияГруза, ФорматДаты));
		ДобавитьЭлементВФайл(Запись, "ETA", Формат(Выборка.ДатаИВремяРаскредитованияГруза, ФорматДаты));			
		
		//Вместо справочника Сибур, используются наши статусы
		//Статус = ПолучитьДислокационныйСтатус(ТаблицаСтатусов, Выборка.ОперацияСВагономКод);		
		//ДобавитьЭлементВФайл(Запись, "STATUS", Статус.STATUS);
		//ДобавитьЭлементВФайл(Запись, "STATUS_DESC", Статус.STATUS_DESC);
		ДобавитьЭлементВФайл(Запись, "STATUS", Выборка.ОперацияСВагономКод);
		ДобавитьЭлементВФайл(Запись, "STATUS_DESC", Выборка.ОперацияСВагономНаименование);
		
		ДобавитьЭлементВФайл(Запись, "STATUS_DATE", Формат(Выборка.Период, ФорматДаты)); //Фактическая дата наступления события - Новая
		
		ДобавитьЭлементВФайл(Запись, "SPEC", "");
		ДобавитьЭлементВФайл(Запись, "SPEC_DESCR", "");
		ДобавитьЭлементВФайл(Запись, "COMMENT", "");
		ДобавитьЭлементВФайл(Запись, "CREATED_ON", Формат(Выборка.Период, ФорматДаты));
		ДобавитьЭлементВФайл(Запись, "STATUS_PROC", "01");
		ДобавитьЭлементВФайл(Запись, "STATUS_PROC_DESC", "Успешно");
		
		Запись.ЗаписатьКонецЭлемента(); //ROW
		
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента(); //n0:mt_displacement_data_ans
			
	Возврат Запись.Закрыть();
	
КонецФункции

//4.2.1.	Инфообмен «Перечень контейнеров и платформ»

Функция УдалитьGetDislocationContByPeriod(XMLRequest)
	
	ФорматДаты = "ДФ='дд.ММ.гггг чч:мм:сс'";
	ТаблицаСтатусов = ПолучитьТаблицуДислокационныхСтатусов();
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(XMLRequest);
	
	ОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(Чтение);
	Если ОбъектXDTO.Свойства().Получить("CREATED_ON_START") = Неопределено Или ОбъектXDTO.Свойства().Получить("CREATED_ON_END") = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ДатаНачала = Дата(ОбъектXDTO.CREATED_ON_START);
	ДатаОкончания = Дата(ОбъектXDTO.CREATED_ON_END);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.УстановитьПараметр("Заказчик", Справочники.э_ПаспортаОрганизаций.НайтиПоНаименованию("ООО ""НХТК"""));	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	э_Накладная.Ссылка КАК Накладная,
	|	э_Накладная.Номер КАК НомерНакладной,
	|	э_Накладная.ДатаИВремяОтправленияГруза КАК ДатаИВремяОтправленияГруза,
	|	э_Накладная.ДатаИВремяПрибытияГруза КАК ДатаИВремяПрибытияГруза,
	|	э_Накладная.СтанцияОтправленияКод КАК СтанцияОтправления,
	|	э_Накладная.СтанцияОтправления.Наименование КАК НаименованиеСтанцииОтправления,
	|	э_Накладная.Грузоотправитель КАК Грузоотправитель,
	|	э_Накладная.ГрузоотправительИД КАК ГрузоотправительИД,
	|	э_Накладная.ГрузоотправительНаименование КАК ГрузоотправительНаименование,
	|	э_Накладная.Грузополучатель КАК Грузополучатель,
	|	э_Накладная.ГрузополучательИД КАК ГрузополучательИД,
	|	э_Накладная.ГрузополучательНаименование КАК ГрузополучательНаименование,
	|	э_Накладная.СтанцияОтправленияКод КАК СтанцияОтправленияКод,
	|	э_Накладная.СтанцияОтправленияНаименование КАК СтанцияОтправленияНаименование,
	|	э_Накладная.ДатаИВремяРаскредитованияГруза КАК ДатаИВремяРаскредитованияГруза
	|ПОМЕСТИТЬ ВТНакладные
	|ИЗ
	|	Документ.э_Накладная КАК э_Накладная
	|ГДЕ
	|	э_Накладная.ДатаИВремяОтправленияГруза <= &ДатаОкончания
	|	И э_Накладная.ДатаИВремяПрибытияГруза >= &ДатаНачала
	|	И (э_Накладная.Грузоотправитель = &Заказчик
	|			ИЛИ э_Накладная.Грузополучатель = &Заказчик)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТНакладные.Накладная КАК Накладная,
	|	ВТНакладные.НомерНакладной КАК НомерНакладной,
	|	ВТНакладные.ДатаИВремяОтправленияГруза КАК ДатаИВремяОтправленияГруза,
	|	ВТНакладные.ДатаИВремяПрибытияГруза КАК ДатаИВремяПрибытияГруза,
	|	э_НакладнаяКонтейнеры.НомерКонтейнера КАК НомерКонтейнера,
	|	э_НакладнаяКонтейнеры.МассыВКгТары КАК МассыВКгТары,
	|	э_НакладнаяКонтейнеры.МассыВКгНетто КАК МассыВКгНетто,
	|	ТЕ.Ссылка КАК Контейнер
	|ПОМЕСТИТЬ ВТКонтейнерыНакладной
	|ИЗ
	|	ВТНакладные КАК ВТНакладные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.э_Накладная.Контейнеры КАК э_НакладнаяКонтейнеры
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТЕ КАК ТЕ
	|			ПО э_НакладнаяКонтейнеры.НомерКонтейнера = ТЕ.Наименование
	|		ПО ВТНакладные.Накладная = э_НакладнаяКонтейнеры.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТКонтейнерыНакладной.Накладная КАК Накладная,
	|	ВТКонтейнерыНакладной.Контейнер КАК Контейнер,
	|	ДислокацияКонтейнеров.Период КАК Период,
	|	ДислокацияКонтейнеров.Вагон.Наименование КАК НомерВагона,
	|	ДислокацияКонтейнеров.Вагон.ТипТС.Длина КАК ДлинаВагона,
	|	ДислокацияКонтейнеров.ИндексПоезда КАК ИндексПоезда,
	|	ДислокацияКонтейнеров.Контейнер.Наименование КАК КонтейнерНаименование,
	|	ДислокацияКонтейнеров.ТипКонтейнера КАК ТипКонтейнера,
	|	ДислокацияКонтейнеров.СтанцияНазначения.КодЖДСтанции КАК СтанцияНазначенияКодЖДСтанции,
	|	ДислокацияКонтейнеров.СтанцияНазначения.Наименование КАК СтанцияНазначенияНаименование,
	|	ДислокацияКонтейнеров.СтанцияОперации.КодЖДСтанции КАК СтанцияОперацииКодЖДСтанции,
	|	ДислокацияКонтейнеров.СтанцияОперации.Наименование КАК СтанцияОперацииНаименование,
	|	ДислокацияКонтейнеров.ОперацияСВагоном.Код КАК ОперацияСВагономКод,
	|	ДислокацияКонтейнеров.ОперацияСВагоном.Наименование КАК ОперацияСВагономНаименование
	|ПОМЕСТИТЬ ВТДислокация
	|ИЗ
	|	ВТКонтейнерыНакладной КАК ВТКонтейнерыНакладной
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДислокацияКонтейнеров КАК ДислокацияКонтейнеров
	|		ПО ВТКонтейнерыНакладной.Контейнер = ДислокацияКонтейнеров.Контейнер
	|			И ВТКонтейнерыНакладной.НомерНакладной = ДислокацияКонтейнеров.НомерНакладной
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТНакладные.Накладная КАК Накладная,
	|	ВТНакладные.НомерНакладной КАК НомерНакладной,
	|	ВТКонтейнерыНакладной.НомерКонтейнера КАК НомерКонтейнера,
	|	ВТКонтейнерыНакладной.Контейнер КАК Контейнер,
	|	ДислокацияКонтейнеров.Период КАК Период,
	|	ДислокацияКонтейнеров.ИндексПоезда КАК ИндексПоезда,
	|	ДислокацияКонтейнеров.КонтейнерНаименование КАК КонтейнерНаименование,
	|	ДислокацияКонтейнеров.ТипКонтейнера КАК ТипКонтейнера,
	|	ДислокацияКонтейнеров.СтанцияНазначенияКодЖДСтанции КАК СтанцияНазначенияКодЖДСтанции,
	|	ДислокацияКонтейнеров.СтанцияНазначенияНаименование КАК СтанцияНазначенияНаименование,
	|	ДислокацияКонтейнеров.СтанцияОперацииКодЖДСтанции КАК СтанцияОперацииКодЖДСтанции,
	|	ДислокацияКонтейнеров.СтанцияОперацииНаименование КАК СтанцияОперацииНаименование,
	|	ДислокацияКонтейнеров.ОперацияСВагономКод КАК ОперацияСВагономКод,
	|	ДислокацияКонтейнеров.ОперацияСВагономНаименование КАК ОперацияСВагономНаименование,
	|	ВТНакладные.НаименованиеСтанцииОтправления КАК НаименованиеСтанцииОтправления,
	|	ВТНакладные.Грузоотправитель КАК Грузоотправитель,
	|	ВТНакладные.ГрузоотправительИД КАК ГрузоотправительИД,
	|	ВТНакладные.ГрузоотправительНаименование КАК ГрузоотправительНаименование,
	|	ВТНакладные.Грузополучатель КАК Грузополучатель,
	|	ВТНакладные.ГрузополучательИД КАК ГрузополучательИД,
	|	ВТНакладные.ГрузополучательНаименование КАК ГрузополучательНаименование,
	|	ВТНакладные.СтанцияОтправленияКод КАК СтанцияОтправленияКод,
	|	ВТНакладные.СтанцияОтправленияНаименование КАК СтанцияОтправленияНаименование,
	|	ВТНакладные.ДатаИВремяОтправленияГруза КАК ДатаИВремяОтправленияГруза,
	|	ВТНакладные.ДатаИВремяРаскредитованияГруза КАК ДатаИВремяРаскредитованияГруза,
	|	ВТНакладные.ДатаИВремяПрибытияГруза КАК ДатаИВремяПрибытияГруза,
	|	ВТКонтейнерыНакладной.МассыВКгТары КАК МассыВКгТары,
	|	ВТКонтейнерыНакладной.МассыВКгНетто КАК МассыВКгНетто,
	|	ДислокацияКонтейнеров.НомерВагона КАК НомерВагона,
	|	ДислокацияКонтейнеров.ДлинаВагона КАК ДлинаВагона,
	|	ВЫБОР
	|		КОГДА ДислокацияКонтейнеров.ДлинаВагона <= 15240
	|			ТОГДА ""40""
