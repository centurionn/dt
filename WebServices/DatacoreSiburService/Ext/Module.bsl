	СвойстваЗаявки.Вставить("CHANGED_BY", 			ОбъектXDTO.CHANGED_BY); 		//	CHAR 12	Поле содержит идентификатор пользователя, внесшего изменения в заявку
	СвойстваЗаявки.Вставить("CHANGED_ON", 			ОбъектXDTO.CHANGED_ON); 		//	DATE/TIME	Поле содержит дату внесения изменений в заявку в формате DD.MM.YYYY HH:MM:SS
	СвойстваЗаявки.Вставить("LIFECYCLE_RFQ", 		ОбъектXDTO.LIFECYCLE_RFQ); 		//	CHAR 2	Поле содержит статус заявки. Возможные значения необходимо брать из справочника LIFECYCLE_RFQ 
	СвойстваЗаявки.Вставить("LOWEST_PRICE_PROP", 	ОбъектXDTO.LOWEST_PRICE_PROP); 	//	P(15) DECIMALS 6	Поле содержит стоимость, предлагаемую клиентом для выполнения заявки (в случае закрытой ставки может быть пустым; ре)
	СвойстваЗаявки.Вставить("LOWEST_PRICE_PROP_CURR", ОбъектXDTO.LOWEST_PRICE_PROP_CURR); //	CHAR 5	Поле содержит курс валюты заявки (в случае закрытой ставки может быть пустым)
			 																				//Возможные курсы валют необходимо брать из справочника CURRENCY
	СвойстваЗаявки.Вставить("EST_END_DATETIME", 	ОбъектXDTO.EST_END_DATETIME); 			//	DATE/TIME	Поле содержит дату крайнего срока ответа экспедитора в формате DD.MM.YYYY HH:MM:SS
	СвойстваЗаявки.Вставить("TSP_ID", 				ОбъектXDTO.TSP_ID); 			//	CHAR 10	Код ЛП
	СвойстваЗаявки.Вставить("TEND_KEY", 			ОбъектXDTO.TEND_KEY); 			//	NUMC 10	Номер позиции заявки SAP TM
	СвойстваЗаявки.Вставить("SOURCE_LOC", 			ОбъектXDTO.SOURCE_LOC); 		//	CHAR 20	Поле содержит код станции отправления (код ЭТРАН)/порта отправления
	СвойстваЗаявки.Вставить("SOURCE_LOC_DESCR", 	ОбъектXDTO.SOURCE_LOC_DESCR); 	//	CHAR 255	Адрес станции отправления/порта отправления
	СвойстваЗаявки.Вставить("DEST_LOC", 			ОбъектXDTO.DEST_LOC); 			//	CHAR 20	Поле содержит код станции назначения/порта прибытия
	СвойстваЗаявки.Вставить("DEST_LOC_DESCR", 		ОбъектXDTO.DEST_LOC_DESCR); 	//	CHAR 255	Адрес станции назначения/порта прибытия
	СвойстваЗаявки.Вставить("FIN_LOC", 				ОбъектXDTO.FIN_LOC); 			//	CHAR 20	Финальная станция назначения/порта прибытия (при первичной подаче заявки до осуществления продажи – направление/страна)
	СвойстваЗаявки.Вставить("FIN_LOC_DESCR", 		ОбъектXDTO.FIN_LOC_DESCR); 		//	CHAR 255	Адрес финальной станции назначения
	СвойстваЗаявки.Вставить("RET_LOC", 				ОбъектXDTO.RET_LOC); 			//	CHAR 20	Станция возврата порожнего контейнера
	СвойстваЗаявки.Вставить("RET_LOC_DESCR", 		ОбъектXDTO.RET_LOC_DESCR); 		//	CHAR 255	Адрес станции возврата порожнего контейнера
	СвойстваЗаявки.Вставить("WEIGHT", 				ОбъектXDTO.WEIGHT); 			//	QUAN 31	Вес продукции
