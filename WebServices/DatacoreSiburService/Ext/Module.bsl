Функция GetOfferClaimsXML(XMLRequest)
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(XMLRequest);	
	ОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(Чтение);
	Если ОбъектXDTO.Свойства().Получить("ROW") <> Неопределено Тогда
		ОбъектXDTO = ОбъектXDTO.ROW;
	КонецЕсли;
	
	ДанныеДляОтвета = ЕСОбменСибурСервер.ПолучитьПредложениеПоЗаявке(ОбъектXDTO);
	
	Если ЗначениеЗаполнено(ДанныеДляОтвета.RFQ_ID) Тогда
		Запись = Новый ЗаписьXML;
		Запись.УстановитьСтроку();
		ФабрикаXDTO.ЗаписатьXML(Запись, ДанныеДляОтвета,, "",);
		XMLResponse = Запись.Закрыть();
		XMLResponse = СтрЗаменить(XMLResponse, "xmlns=""""", "");
		XMLResponse = СтрЗаменить(XMLResponse, "ОбъектXDTO", "");
	Иначе
		XMLResponse = "";
	КонецЕсли;
	
	Возврат XMLResponse;	
	
КонецФункции

