Функция ПолучитьСвойстваЗаявки(ОбъектXDTO)
	
	СвойстваЗаявки = Новый Структура;	
	
	СвойстваЗаявки.Вставить("KEY",					ОбъектXDTO.KEY); 				// 	32(X(16))	Технический идентификатор заявки в SAP TM
	СвойстваЗаявки.Вставить("PARENT_KEY", 			ОбъектXDTO.PARENT_KEY); 		//	CHAR 32(X(16))	Технический идентификатор общей потребности на контейнеры
	СвойстваЗаявки.Вставить("ROOT_KEY", 			ОбъектXDTO.ROOT_KEY); 			//	CHAR 32(X(16))	Технический идентификатор общей потребности на контейнеры
	СвойстваЗаявки.Вставить("RFQ_ID", 				ОбъектXDTO.RFQ_ID); 			//	CHAR 10	Идентификатор заявки SAP TM
	СвойстваЗаявки.Вставить("TEND_SEQ_NR", 			ОбъектXDTO.TEND_SEQ_NR); 		//	CHAR 3	Порядковый номер заявки к конкретному ЛП (в случае переторжки = 2, 3, n…)
	СвойстваЗаявки.Вставить("TEND_MANAGER", 		ОбъектXDTO.TEND_MANAGER); 		//	CHAR 12	Поле содержит идентификатор контактного лица
	СвойстваЗаявки.Вставить("TEND_MANAGER_TEL", 	ОбъектXDTO.TEND_MANAGER_TEL); 	//	CHAR 20	Контактный телефон
	СвойстваЗаявки.Вставить("TEND_MANAGER_MAIL", 	ОбъектXDTO.TEND_MANAGER_MAIL); 	//	CHAR 50	Контактная почта
