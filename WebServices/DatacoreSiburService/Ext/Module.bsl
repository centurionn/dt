Функция ПолучитьДислокационныеДанныеПоИдентификаторуКонтейнераЗаПериод(ДатаНачала, ДатаОкончания, ИдентификаторКонтейнера)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.УстановитьПараметр("ИдентификаторКонтейнера", ИдентификаторКонтейнера);
	Запрос.УстановитьПараметр("Заказчик", Справочники.э_ПаспортаОрганизаций.НайтиПоНаименованию("ООО ""НХТК"""));
