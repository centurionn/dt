//4.1.1. Инфообмен «Размещение заявок экспедиторам» CreateClaims

Функция УдалитьCreateClaims(XMLRequest)
	
	ФорматДаты = "ДФ='дд.ММ.гггг чч:мм:сс'";
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(XMLRequest);
	
	ОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(Чтение);
	Чтение.Закрыть();
	
	Заявки = Новый Массив;
	ИдентификаторыЗаявок = Новый Массив;
	КодыСтанций = Новый Массив;
	
	Если ОбъектXDTO.ROW = Тип("СписокXDTO") Тогда
		Для Каждого Элемент Из ОбъектXDTO.ROW Цикл
			Заявка = ПолучитьСвойстваЗаявки(Элемент);
			Заявки.Добавить(Заявка);
			ИдентификаторыЗаявок.Добавить(Заявка.KEY);
			КодыСтанций.Добавить(Заявка.SOURCE_LOC);
		КонецЦикла;
	Иначе
		Заявка = ПолучитьСвойстваЗаявки(ОбъектXDTO.ROW);
		Заявки.Добавить(Заявка);
		ИдентификаторыЗаявок.Добавить(Заявка.KEY);
		КодыСтанций.Добавить(Заявка.SOURCE_LOC);
	КонецЕсли;
	
	//Поиск среди размещенных заявок
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РазмещенныеЗаявкиСибур.ext_KEY КАК ext_KEY,
	|	РазмещенныеЗаявкиСибур.Заявка КАК ДокументЗаявка
	|ИЗ
	|	РегистрСведений.РазмещенныеЗаявкиСибур КАК РазмещенныеЗаявкиСибур
	|ГДЕ
	|	РазмещенныеЗаявкиСибур.ext_KEY В(&ИдентификаторыЗаявок)";
	Запрос.УстановитьПараметр("ИдентификаторыЗаявок", ИдентификаторыЗаявок);
	Выборка = Запрос.Выполнить().Выбрать();
	НайденныеЗаявки = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		НайденныеЗаявки.Вставить(Выборка.ext_KEY, Выборка.ДокументЗаявка);
	КонецЦикла;
	
	//Получение станций по кодам
	СтанцииПоКодам = Новый Соответствие;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Локации.КодЖДСтанции КАК Код,
	|	Локации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Локации КАК Локации
	|ГДЕ
	|	Локации.КодЖДСтанции В(&КодыСтанций)";
	Запрос.УстановитьПараметр("КодыСтанций", КодыСтанций);	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтанцииПоКодам.Вставить(Выборка.Код, Выборка.Ссылка);
	КонецЦикла;
	
	Запись = Новый ЗаписьXML;
		
	Запись.УстановитьСтроку("UTF-8");
	Запись.ЗаписатьОбъявлениеXML();
	
	Запись.ЗаписатьНачалоЭлемента("n0:mt_displacement_data_ans");
	
	ДобавитьАтрибутВФайл(Запись, "xmlns:n0", "http://На этапе реализации");
	ДобавитьАтрибутВФайл(Запись, "xmlns:prx", "На этапе реализации");
	ДобавитьАтрибутВФайл(Запись, "xmlns:n1", "На этапе реализации");		
	
	ДобавитьЭлементВФайл(Запись, "BasicMessageHeader", "");
	
	Для Каждого Заявка Из Заявки Цикл
		
		Запись.ЗаписатьНачалоЭлемента("ROW");
		
		НайденнаяЗаявка = НайденныеЗаявки.Получить(Заявка.KEY);
		Если НайденнаяЗаявка = Неопределено Тогда
			ДокументЗаявка = Документы.Заявка.СоздатьДокумент();
			ДокументЗаявка.Дата = Заявка.CREATED_ON;
			ДокументЗаявка.Создано = Заявка.CREATED_ON;			
		Иначе
			ДокументЗаявка = НайденнаяЗаявка.ПолучитьОбъект();
		КонецЕсли;
				
		ДокументЗаявка.Отправка = Заявка.START_DATETIME;
		ДокументЗаявка.Прибытие = Заявка.END_DATETIME;
		
		СтанцияОтправления = СтанцииПоКодам.Получить(Заявка.SOURCE_LOC);
		СтанцияНазначения = СтанцииПоКодам.Получить(Заявка.DEST_LOC);
		ФинальнаяСтанцияНазначения = СтанцииПоКодам.Получить(Заявка.FIN_LOC);
		СтанцияВозвратаПорожнегоКонтейнера = СтанцииПоКодам.Получить(Заявка.RET_LOC);
		
		ВесПродукции = Число(Заявка.WEIGHT);
		Объем = Число(Заявка.VOLUME);
		КоличествоКонтейнеров = Число(Заявка.QUANT);
				
		Если Заявка.CONTAINER_MOT = "20FT" Тогда
			РазмерКТК = Справочники.РазмерыКТК.К20;
		ИначеЕсли Заявка.CONTAINER_MOT = "40FT" Тогда
			РазмерКТК = Справочники.РазмерыКТК.К40;
		ИначеЕсли Заявка.CONTAINER_MOT = "45FT" Тогда
			РазмерКТК = Справочники.РазмерыКТК.К45;
		Иначе
			РазмерКТК = Неопределено;
		КонецЕсли;
		
		ДокументЗаявка.СоставУслуги.Очистить();
		Для ПорядковыйНомер = 1 По КоличествоКонтейнеров Цикл
			НоваяСтрока = ДокументЗаявка.СоставУслуги.Добавить();
			НоваяСтрока.РазмерКТК = РазмерКТК;
		КонецЦикла;
		
		НачатьТранзакцию();
		
		ДокументЗаявка.Записать();
		
		Если НайденнаяЗаявка = Неопределено Тогда
			РазмещеннаяЗаявка = РегистрыСведений.СибурРазмещенныеЗаявки.СоздатьМенеджерЗаписи();
			РазмещеннаяЗаявка.RFQ_ID = Заявка.KEY;
			РазмещеннаяЗаявка.Заявка = ДокументЗаявка.Ссылка;
			РазмещеннаяЗаявка.ext_PARENT_KEY = Заявка.PARENT_KEY;
			РазмещеннаяЗаявка.ext_ROOT_KEY = Заявка.ROOT_KEY;
			РазмещеннаяЗаявка.ext_TEND_KEY = Заявка.TEND_KEY;
			РазмещеннаяЗаявка.ext_TEND_SEQ_NR = Заявка.TEND_SEQ_NR;
			РазмещеннаяЗаявка.ext_TSP_ID = Заявка.TSP_ID;
			РазмещеннаяЗаявка.Записать();
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
		ДобавитьЭлементВФайл(Запись, "KEY", Заявка.KEY);
		ДобавитьЭлементВФайл(Запись, "STATUS_PROC", "01");
		ДобавитьЭлементВФайл(Запись, "STATUS_PROC_DESC", "успешно");
		ДобавитьЭлементВФайл(Запись, "STATUS_DATE", Формат(ТекущаяДатаСеанса(), ФорматДаты));
		
		Запись.ЗаписатьКонецЭлемента(); //ROW
		
	КонецЦикла;	
		
	Запись.ЗаписатьКонецЭлемента(); //n0:mt_displacement_data_ans
	
	Возврат Запись.Закрыть();
	
КонецФункции

