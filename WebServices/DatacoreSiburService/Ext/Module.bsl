	ДанныеДляОтвета = ЕСОбменСибурСервер.СоздатьЗаявку(ОбъектXDTO);
	
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	ФабрикаXDTO.ЗаписатьXML(Запись, ДанныеДляОтвета,, "",);
	XMLResponse = Запись.Закрыть();
	XMLResponse = СтрЗаменить(XMLResponse, "xmlns=""""", "");
	XMLResponse = СтрЗаменить(XMLResponse, "ОбъектXDTO", "");
	
	Возврат XMLResponse;
	
