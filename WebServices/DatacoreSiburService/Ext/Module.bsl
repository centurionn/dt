Функция ПолучитьДислокационныйСтатус(ТаблицаСтатусов, КодОперации)
	
	Статус = Новый Структура("STATUS, STATUS_DESC");
	
	НайденнаяСтрока = ТаблицаСтатусов.Найти(КодОперации, "КодОперации");
	Если НайденнаяСтрока <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Статус, НайденнаяСтрока);
	Иначе
		Статус.STATUS = "LOCATION";
		Статус.STATUS_DESC = "Текущее местоположение";
	КонецЕсли;
	
	Возврат Статус;
	
КонецФункции

