//"3e0c5cd8-e1aa-405a-b693-383153cf78f6",
//"3e0c5cd8-e1aa-405a-b693-383153cf78f7"
//],
//		" GUIDinvoce ": [
//"3e0c5cd8-e1aa-405a-b693-383153cf78f2",
//"3e0c5cd8-e1aa-405a-b693-383153cf78f4",
//"3e0c5cd8-e1aa-405a-b693-383153cf78f6",
//"3e0c5cd8-e1aa-405a-b693-383153cf78f7"]}}
//Исх - 
//{
//	"result": 0,
//	"data": [{
//			"GUID": "3e0c5cd8-e1aa-405a-b693-383153cf78f2",
//			"GUIDinvoce": "3e0c5cd8-e1aa-405a-b693-383153cf78f2",
//			"number": "YT000123",
//			"date": "2020-09-05T00:00:00",
//			"dateOfPayment": "2020-09-09T00:00:00",
//			"paid": 0,
//			"sum": "123521",
//			"document": "//123.jpeg",
//			"closingDocuments": "",
//			"deletionMark": 0
//		}]}
Функция getInvoce(Параметры);
	Запрос = Новый Запрос();
	//Евросиб Каблов 04.08.2025 ( #115153
	//Запрос.Текст = "ВЫБРАТЬ
	//               |	ДокументСчет.Ссылка КАК Ссылка,
	//               |	МИНИМУМ(ЕСТЬNULL(РеализацияТоваровУслуг.Оплачен, 0)) КАК Оплачен
	//               |ПОМЕСТИТЬ ВТ_Счета
	//               |ИЗ
	//               |	Документ.СчетНаОплатуПокупателю КАК ДокументСчет
	//			   |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	//			   |		ПО ДокументСчет.Ссылка = РеализацияТоваровУслуг.СчетНаОплатуПокупателю";
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДокументСчет.Ссылка КАК Ссылка,
	               |	МИНИМУМ(ЕСТЬNULL(РеализацияТоваровУслугСчетаНаОплатуПокупателям.Ссылка.Оплачен, 0)) КАК Оплачен
	               |ПОМЕСТИТЬ ВТ_Счета
	               |ИЗ
	               |	Документ.СчетНаОплатуПокупателю КАК ДокументСчет
				   |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.СчетаНаОплатуПокупателям КАК РеализацияТоваровУслугСчетаНаОплатуПокупателям
	               |		ПО ДокументСчет.Ссылка = РеализацияТоваровУслугСчетаНаОплатуПокупателям.СчетПокупателю";
				   //Евросиб Каблов 04.08.2025 )
	Запрос.Текст = Запрос.Текст + " 
	               |ГДЕ
	               |	ИСТИНА";
	Если Параметры.Свойство("GIUD") И Параметры.GUID.Количество() Тогда     
		Запрос.Текст = Запрос.Текст + " 
	               | И СчетНаОплатуПокупателю.UID В(&UID)";  
		Запрос.УстановитьПараметр("UID", Параметры.GUID);
	ИначеЕсли Параметры.Свойство("User") И ЗначениеЗаполнено(Параметры.User)
		И Параметры.Свойство("dateFrom") И ЗначениеЗаполнено(Параметры.dateFrom)
		И Параметры.Свойство("dateTo") И ЗначениеЗаполнено(Параметры.dateTo)
		Тогда
		Запрос.УстановитьПараметр("Контрагент", Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(Параметры.User)));
		Запрос.УстановитьПараметр("ДатаНачала", ПолучитьДату(Параметры.dateFrom));
		Запрос.УстановитьПараметр("ДатаОкончания", ПолучитьДату(Параметры.dateTo));
		Запрос.Текст = Запрос.Текст + "
		//Евросиб Каблов 04.08.2025 ( #115153
				   //| И (СчетНаОплатуПокупателю.Контрагент = &Контрагент
				   //| И СчетНаОплатуПокупателю.Дата >= &ДатаНачала
				   //| И СчетНаОплатуПокупателю.Дата <= &ДатаОкончания)";
				   | И (ДокументСчет.Контрагент = &Контрагент
	               | И ДокументСчет.Дата >= &ДатаНачала
	               | И ДокументСчет.Дата <= &ДатаОкончания)";
		//Евросиб Каблов 04.08.2025 )
	КонецЕсли;

	Запрос.Текст = Запрос.Текст + "
	               |ВЫБРАТЬ
	               |	СчетНаОплатуПокупателю.UID КАК GUID,
	               |	СделкаЗаявки.Заявка.UID КАК GUIDInvoce,
				   |	СчетНаОплатуПокупателю.Номер КАК number,
	               |	СчетНаОплатуПокупателю.Дата КАК date,
	               |	СчетНаОплатуПокупателю.СуммаДокумента КАК Sum,
	               |	""TBD найти пути к файлам"" КАК document,                         
	               |	""TBD найти пути к файлам"" КАК closingDocuments,
				   |	СчетНаОплатуПокупателю.ДатаОплаты КАК dateOfPayment,
				   |	ВТ_Счета.Оплачен как Paid,
	               |	ВЫБОР
	               |		КОГДА СчетНаОплатуПокупателю.ПометкаУдаления
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК deletionMark
	               |ИЗ
	               |	Документ.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю
				   |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Счета КАК ВТ_Счета
				   |		ПО СчетНаОплатуПокупателю.Ссылка = ВТ_Счета.Ссылка
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.Заявки КАК СделкаЗаявки
	               |		ПО СчетНаОплатуПокупателю.УдалитьСделка = СделкаЗаявки.Ссылка
	               |			И СчетНаОплатуПокупателю.ДоговорКонтрагента = СделкаЗаявки.Заявка.Договор";
	Если Параметры.Свойство("GIUDInvoce") И Параметры.GIUDInvoce.Количество() Тогда     
		Запрос.Текст = Запрос.Текст + " И СделкаЗаявки.Заявка.UID В(&GIUDInvoce)";  
		Запрос.УстановитьПараметр("GIUDInvoce", Параметры.GIUDInvoce);
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + " 
	               |ГДЕ
	               |	ИСТИНА";
	Если Параметры.Свойство("GIUD") И Параметры.GUID.Количество() Тогда     
		Запрос.Текст = Запрос.Текст + " И СчетНаОплатуПокупателю.UID В(&UID)";  
		Запрос.УстановитьПараметр("UID", Параметры.GUID);
	КонецЕсли;

	МассивData = Новый Массив;
	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	Пока ВыборкаЗапроса.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(ВыборкаЗапроса.GUID) 
			ИЛИ НЕ ЗначениеЗаполнено(ВыборкаЗапроса.GUIDInvoce) 
			ИЛИ НЕ ЗначениеЗаполнено(ВыборкаЗапроса.number)
			ИЛИ НЕ ЗначениеЗаполнено(ВыборкаЗапроса.dateOfPayment)
			ИЛИ НЕ ЗначениеЗаполнено(ВыборкаЗапроса.sum)
			Тогда
			Продолжить;
		КонецЕсли;
		СтруктураData = Новый Структура("GUID, GUIDInvoce, number, date, dateOfPayment, paid, sum, document, closingDocuments, deletionMark");
		ЗаполнитьЗначенияСвойств(СтруктураData, ВыборкаЗапроса);
		МассивData.Добавить(СтруктураData);
	КонецЦикла;
	

	СтруктураОтвет = новый Структура("result, data");
	СтруктураОтвет.data 	= МассивData;
	СтруктураОтвет.result 	= 0;
	//СтруктураОтвет.result 	= ?(МассивData.Количество() > 0, 0, -15);
	
	Возврат СтруктураОтвет;
КонецФункции

