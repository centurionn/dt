	Пока ВыборкаЗапроса.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(ВыборкаЗапроса.codeStock) ИЛИ НЕ ЗначениеЗаполнено(ВыборкаЗапроса.codeISO) ИЛИ НЕ ЗначениеЗаполнено(ВыборкаЗапроса.quantity) Тогда
			Продолжить;
		КонецЕсли;
		СтруктураData = Новый Структура("codeStock, codeISO, quantity");
		ЗаполнитьЗначенияСвойств(СтруктураData, ВыборкаЗапроса);
		МассивData.Добавить(СтруктураData);
	КонецЦикла;
	
	СтруктураОтвет = новый Структура("result, data");
	СтруктураОтвет.data = МассивData;
	СтруктураОтвет.result = 0;
	
	Возврат СтруктураОтвет;
КонецФункции

// getTrip 
// Функция для обновления справочника с данными по зарегистрированным Рейсам. Возвращает массив данных
//Вх - 
//{
//	"request": "getTrip",
//	"data": {
//		"date_from": "2020-09-05T00:00:00",
//		"date_to": "2020-09-21T00:00:00"
//		}}
//Исх - 
//{
//	"result": 0,
//	"data": [{
//			"fromCodeLocation": "КодЖД1",
//			"toCodeLocation": "КодЖД2",
//			"isoCodePrice": {
//				"22G1": 12587,
//				"42G1": 45652
//},
//			"date": "2020-09-05T00:00:00",
//			"free": 12
//		}]}
Функция getTrip(Параметры);
	МассивData = Новый Массив;
	
	Если Параметры.Свойство("date_from") И Параметры.Свойство("date_to") Тогда     
		Запрос = Новый Запрос();
		Запрос.УстановитьПараметр("date_from", ПолучитьДату(Параметры.date_from));
		Запрос.УстановитьПараметр("date_to", ПолучитьДату(Параметры.date_to));
		Запрос.Текст = "ВЫБРАТЬ
		               |	РейсыЖД.Код КАК codeStock,
					   |	РейсыЖД.Ссылка КАК Ссылка,
		               |	РейсыЖД.ДатаОтправления КАК date,
		               |	РейсыЖД.ПунктОтправления.КодЖДСтанции КАК fromCodeLocation,
		               |	РейсыЖД.ПунктНазначения.КодЖДСтанции КАК toCodeLocation,
		               |	РейсыЖД.КоличествоТЕУ КАК free
		               |ИЗ
		               |	Справочник.РейсыЖД КАК РейсыЖД
		               |ГДЕ
		               |	РейсыЖД.РейсОтменен = ЛОЖЬ
		               |	И РейсыЖД.ПометкаУдаления = ЛОЖЬ
		               |	И РейсыЖД.ДатаОтправления МЕЖДУ &date_from И &date_to";
		           
		
		ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
		
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("ДействиеПриОбмене", Перечисления.ДействияПриОбмене.ВыгрузкаДанных);
		СтруктураПоиска.Вставить("УзелОбмена", Перечисления.УзлыОбмена.ЛК);
		СтруктураПоиска.Вставить("Объект", Неопределено);
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("Ответственный", Справочники.Пользователи.ПустаяСсылка());
		СтруктураДанных.Вставить("УИДИсточника", Неопределено);
			
		Пока ВыборкаЗапроса.Следующий() Цикл
			Если НЕ ЗначениеЗаполнено(ВыборкаЗапроса.fromCodeLocation) ИЛИ НЕ ЗначениеЗаполнено(ВыборкаЗапроса.toCodeLocation) ИЛИ НЕ ЗначениеЗаполнено(ВыборкаЗапроса.date) ИЛИ НЕ ЗначениеЗаполнено(ВыборкаЗапроса.free) Тогда
				Продолжить;
			КонецЕсли;
			СтруктураData = Новый Структура("fromCodeLocation, toCodeLocation, isoCodePrice, date, free");
			ЗаполнитьЗначенияСвойств(СтруктураData, ВыборкаЗапроса);
			СтруктураData.isoCodePrice = Новый Структура("22G1, 42G1", 0, 0);  // TBD отыскать ставки по типам конт
			МассивData.Добавить(СтруктураData);
			
			// зафиксируем протокол обмена   // TBD переделать на запись списка объектов пачкой?
			СтруктураПоиска.Объект 		 = ВыборкаЗапроса.Ссылка;
			СтруктураДанных.УИДИсточника = ВыборкаЗапроса.Ссылка.УникальныйИдентификатор();
			РегистрыСведений.ПротоколОбменов.ЗафиксироватьИнформациюОЗагрузке(СтруктураПоиска, СтруктураДанных);
		КонецЦикла;
	КонецЕсли;
	
	СтруктураОтвет = новый Структура("result, data");
	СтруктураОтвет.data 	= МассивData;
	СтруктураОтвет.result = 0;
	
	Возврат СтруктураОтвет;
КонецФункции

