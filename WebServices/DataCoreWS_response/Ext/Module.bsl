// getLocationList 
// Функция для обновления справочника ЖД Станций. Возвращает массив данных.
//Вх - 
//{
//	"request": "getLocationList",
//	"data": {
//		"code": [
//			"code1",
//			"code2",
//			"code3"
//		]}}
//Исх - 
//{
//	"result": 0,
//	"data": [{
//			"code": "123",
//			"name": "Название",
//			"zdcode": "11000254",
//			"deletionMark": 0
//		},
//		{
//			"code": "123",
//			"name": "Название",
//			"zdcode": "11000254",
//			"deletionMark": 0
//		}]}
Функция getLocationList(Параметры);
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ТипЖДСтанция", Справочники.ТипыЛокаций.СтанцияЖД);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Локации.Ссылка КАК Ссылка,
	               |	Локации.Код КАК code,
	               |	Локации.Наименование КАК name,
	               |	Локации.КодЖДСтанции КАК zdcode,
	               |	ВЫБОР
	               |		КОГДА Локации.ПометкаУдаления
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК deletionMark
	               |ИЗ
	               |	Справочник.Локации КАК Локации
	               |ГДЕ
	               |	Локации.Тип = &ТипЖДСтанция";
	Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("code") И Параметры.code.Количество() Тогда      // TBD выяснить фильтр по СТОК или КОДСТАНЦИИ
		Запрос.Текст = Запрос.Текст + " И Локации.Код В(&Стоки)";  
		Запрос.УстановитьПараметр("Стоки", Параметры.code);
	КонецЕсли;
	
	МассивData = Новый Массив;
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ДействиеПриОбмене", Перечисления.ДействияПриОбмене.ВыгрузкаДанных);
	СтруктураПоиска.Вставить("УзелОбмена", Перечисления.УзлыОбмена.ЛК);
	СтруктураПоиска.Вставить("Объект", Неопределено);
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Ответственный", Справочники.Пользователи.ПустаяСсылка());
	СтруктураДанных.Вставить("УИДИсточника", Неопределено);
		
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	Пока ВыборкаЗапроса.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(ВыборкаЗапроса.code) ИЛИ НЕ ЗначениеЗаполнено(ВыборкаЗапроса.name) ИЛИ НЕ ЗначениеЗаполнено(ВыборкаЗапроса.zdcode) Тогда
			Продолжить;
		КонецЕсли;
		СтруктураData = Новый Структура("code, name, zdcode, deletionMark");
		ЗаполнитьЗначенияСвойств(СтруктураData, ВыборкаЗапроса);
		МассивData.Добавить(СтруктураData);
		
		// зафиксируем протокол обмена   // TBD переделать на запись списка объектов пачкой?
		СтруктураПоиска.Объект 		 = ВыборкаЗапроса.Ссылка;
		СтруктураДанных.УИДИсточника = ВыборкаЗапроса.Ссылка.УникальныйИдентификатор();
		РегистрыСведений.ПротоколОбменов.ЗафиксироватьИнформациюОЗагрузке(СтруктураПоиска, СтруктураДанных);
	КонецЦикла;
	
	СтруктураОтвет = новый Структура("result, data");
	СтруктураОтвет.data = МассивData;
	СтруктураОтвет.result = 0;

	Возврат СтруктураОтвет;//СтруктураОтвет;
КонецФункции

