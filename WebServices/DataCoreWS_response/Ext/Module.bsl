//			"returnStokName": "ЕВРОСИБ",
//			"returnDate": "21 – 25.03.2021"
//		}]}
Функция getReliz(Параметры);
	
	// TBD Выяснить про РЕЛИЗЫ
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДокументЗаявка.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ ВТ_Счета
	               |ИЗ
	               |	Документ.Заявка КАК ДокументЗаявка";
	Запрос.Текст = Запрос.Текст + " 
	               |ГДЕ
	               |	ИСТИНА";
	Если Параметры.Свойство("GIUD") И Параметры.GUID.Количество() Тогда     
		Запрос.Текст = Запрос.Текст + " 
	               | И ДокументЗаявка.UID В(&UID)";  
		Запрос.УстановитьПараметр("UID", Параметры.GUID);
	КонецЕсли;
	
	Если Параметры.Свойство("User") И ЗначениеЗаполнено(Параметры.User)
		И Параметры.Свойство("dateFrom") И ЗначениеЗаполнено(Параметры.dateFrom)
		И Параметры.Свойство("dateTo") И ЗначениеЗаполнено(Параметры.dateTo)
		Тогда
		Запрос.УстановитьПараметр("Контрагент", Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(Параметры.User)));
		Запрос.УстановитьПараметр("ДатаНачала", ПолучитьДату(Параметры.dateFrom));
		Запрос.УстановитьПараметр("ДатаОкончания", ПолучитьДату(Параметры.dateTo));
		Запрос.Текст = Запрос.Текст + " 
	               | ИЛИ (ДокументЗаявка.Контрагент = &Контрагент
	               | И ДокументЗаявка.Дата >= &ДатаНачала
	               | И ДокументЗаявка.Дата <= &ДатаОкончания)";
	КонецЕсли;

	Запрос.Текст = Запрос.Текст + "
	               |
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Заявка.Ссылка.UID КАК GUID,
	               |	""TBD найти пути к файлам"" КАК GUIDreliz,
				   |	Заявка.НомерКТК.Наименование КАК containerNumber,
				   |	Заявка.НомерКТК.ТипТЕ.Наименование КАК containerType,
	               |	""TBD найти пути к файлам"" КАК gettingStok,                         
	               |	""TBD найти пути к файлам"" КАК gettingDate,                         
	               |	Заявка.ФИОВодителя КАК gettingFIO,                         
	               |	""TBD найти пути к файлам"" КАК gettingPassport,                         
	               |	Заявка.НомерАвто КАК gettingAvto,                         
	               |	""TBD найти пути к файлам"" КАК returnStok,                         
	               |	""TBD найти пути к файлам"" КАК returnDate                         
	               |ИЗ
	               |	Документ.Заявка.СоставУслуги КАК Заявка
				   |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Счета КАК ВТ_Счета
				   |		ПО Заявка.Ссылка = ВТ_Счета.Ссылка";

	МассивData = Новый Массив;
	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	Пока ВыборкаЗапроса.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(ВыборкаЗапроса.GUID) 
			ИЛИ НЕ ЗначениеЗаполнено(ВыборкаЗапроса.GUIDreliz) 
			ИЛИ НЕ ЗначениеЗаполнено(ВыборкаЗапроса.containerNumber)
			ИЛИ НЕ ЗначениеЗаполнено(ВыборкаЗапроса.containerType)
			Тогда
			Продолжить;
		КонецЕсли;
		СтруктураData = Новый Структура("GUID, GUIDreliz, containerNumber, containerType, gettingStok, gettingDate, gettingFIO, gettingPassport, gettingAvto, returnStok, returnDate");
		ЗаполнитьЗначенияСвойств(СтруктураData, ВыборкаЗапроса);
		МассивData.Добавить(СтруктураData);
	КонецЦикла;

	СтруктураОтвет = новый Структура("result, data");
	СтруктураОтвет.data 	= МассивData;
	СтруктураОтвет.result = 0;
	//СтруктураОтвет.result 	= ?(МассивData.Количество() > 0, 0, -18);
	
	Возврат СтруктураОтвет;
