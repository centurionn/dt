// getEventsList 
// Функция для получения списка новых событий
//Вх - 
//{
//	"request": "getEventsList",
//	"data": {
//		"user":"3e0c5cd8-e1aa-405a-b693-383153cf78f2"}}
//Исх - 
//{
//	"request": "getEventsList",
//	"data": [{
//			"User": "450c5cd8-e1aa-405a-b693-383153cf78f2",
//"GUID": "3e0c5cd8-e1aa-405a-b693-383153cf78f2",
//"type": 5,
//"Date": "2020-09-05T00:00:00",
//"Description": "" 
//		}]}
Функция getEventsList(Параметры);
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДокументЗаявка.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.Заявка КАК ДокументЗаявка";
	Запрос.Текст = Запрос.Текст + " 
	               |ГДЕ
	               |	ДокументЗаявка.ПометкаУдаления = ЛОЖЬ";
	Если Параметры.Свойство("User") И ЗначениеЗаполнено(Параметры.User) Тогда     
		Запрос.Текст = Запрос.Текст + " 
	               | И ДокументЗаявка.Контрагент = &Контрагент";  
		Запрос.УстановитьПараметр("Контрагент", Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(Параметры.User)));
	КонецЕсли;
// 1	Смена статуса заявки "Получена". Заявка подана получателем, попала в DataCore, но ещё не подтверждена менеджером.
// 2	смена статуса заявки "Подтверждена". Заявка подана пользователем и подтверждена менеджеров
// 3	смена статуса заявки "Отклонена"
// 4	выставлен счёт
// 5	напоминание об оплате счёта (тут надо будет придумать регулярность и счётчик)
// 6	просрочка оплаты
// 7	выдача релиза
// 8	назначение контейнера в поезд
// 9	отправление поезда ("Контейнеры №№ отправлены (дата отправления)")
// 10	прибытие поезда
// 11	контейнеры готовы к выдаче
// 12	загрузка закрывающих документов (АВР и т.д.)
// 13	смена статуса заявки
// 14	выставление счёта
// 15	напоминание об оплате счёта (тут надо будет придумать регулярность и счётчик)
// 16	просрочка оплаты
// 17	выдача релиза
// 18	назначение контейнера в поезд
// 19	отправление поезда ("Контейнеры №№ отправлены (дата отправления)")
// 20	прибытие поезда

// TBD сопоставить наши статусы с новоявленными. А точнее, убрать новоявленные и пользовать только наши

	МассивData = Новый Массив;
	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	Пока ВыборкаЗапроса.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(ВыборкаЗапроса.GUID) 
			ИЛИ НЕ ЗначениеЗаполнено(ВыборкаЗапроса.User) 
			ИЛИ НЕ ЗначениеЗаполнено(ВыборкаЗапроса.type)
			ИЛИ НЕ ЗначениеЗаполнено(ВыборкаЗапроса.Date)
			Тогда
			Продолжить;
		КонецЕсли;
		СтруктураData = Новый Структура("User, GUID, type, Date, description");
		ЗаполнитьЗначенияСвойств(СтруктураData, ВыборкаЗапроса);
		СтруктураData.User = Параметры.User;
		МассивData.Добавить(СтруктураData);
	КонецЦикла;
	
	СтруктураОтвет = новый Структура("result, data");
	СтруктураОтвет.data   = МассивData;
	СтруктураОтвет.result = 0;
	//СтруктураОтвет.result 	= ?(МассивData.Количество() > 0, 0, -20);
	
	Возврат СтруктураОтвет;
КонецФункции

