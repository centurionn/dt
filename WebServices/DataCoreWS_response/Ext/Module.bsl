Функция postRequest(Параметры);

	СтруктураData = Новый Структура("GUID, version, DocumentId, OrderStatus, OrderРrice", "00000000-0000-0000-0000-000000000000", "00000000000000000000", "0", 2, 0);
	
	СтруктураОтвет = новый Структура("result, data");
	
	ЗапросСсылка = СоздатьЗапросКлиента(Параметры);
	Если НЕ ЗапросСсылка = Документы.Запрос.ПустаяСсылка() Тогда

		СтруктураData.GUID = СокрЛП(ЗапросСсылка.УникальныйИдентификатор());
		
		СтруктураData.DocumentId = ЗапросСсылка.Номер;
		//СтруктураData.OrderStatus = 2;
		//СтруктураData.OrderРrice = 0;   // TBD как найти Рассчитанная стоимость заявки (счет оферта), руб.

		Запрос = Новый Запрос();
		Запрос.Текст = "ВЫБРАТЬ
		               |	ДокЗапрос.Ссылка КАК Ссылка,
		               |	ДокЗапрос.ВерсияДанных КАК version
		               |ИЗ
		               |	Документ.Запрос КАК ДокЗапрос
		               |ГДЕ
		               |	ДокЗапрос.Ссылка = &Ссыль";
		Запрос.УстановитьПараметр("Ссыль", ЗапросСсылка);
		
		ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
		ВыборкаЗапроса.Следующий();
		СтруктураData.version = ВыборкаЗапроса.version;
		
		СтруктураОтвет.result 	= 0;
	Иначе
		СтруктураОтвет.result 	= -1;
	КонецЕсли;
	
	СтруктураОтвет.data 	= СтруктураData;
	
	Возврат СтруктураОтвет;
КонецФункции

