Функция getStokQuantity(Параметры);
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ТипЖДСтанция", Справочники.ТипыЛокаций.Сток);
	Запрос.Текст = "ВЫБРАТЬ
