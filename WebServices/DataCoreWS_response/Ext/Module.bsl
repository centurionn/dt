Функция changObjects(Параметры)
	
	// TBD Выяснить необходимость выгрузки всего объема данных и применения критериев фильтра
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТИПЗНАЧЕНИЯ(ПротоколОбменов.Объект) КАК ТипОбъекта,
	|	ПротоколОбменов.УИДИсточника КАК УИДИсточника
	|ИЗ
	|	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	|ГДЕ
	|	ПротоколОбменов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных)
	|	И ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.ЛК)
	|	И ПротоколОбменов.ДатаОбмена = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТИПЗНАЧЕНИЯ(ПротоколОбменов.Объект),
	|	ПротоколОбменов.УИДИсточника";
	
	результат = Запрос.Выполнить();
	ВыборкаТип = результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ТипОбъекта");
	//	
	структураПоТипам = Новый Структура();
	Пока ВыборкаТип.Следующий()Цикл		
		массивУИДы = новый Массив;
		выборкаУИД = ВыборкаТип.Выбрать();
		Пока выборкаУИД.Следующий()Цикл
			массивУИДы.Добавить(выборкаУИД.УИДИсточника);
		КонецЦикла;
		структураПоТипам.Вставить(ВыборкаТип.ТипОбъекта, массивУИДы);
	КонецЦикла;
	
	СтруктураОтвет = новый Структура("result, data");
	СтруктураОтвет.data = структураПоТипам;
	СтруктураОтвет.result = 0;
	
	Возврат СтруктураОтвет;
КонецФункции

