&НаСервере
Функция response(request, GUID)

	СтруктураОтвет = Новый Структура("response, GUID", "", GUID);
	Результат = Неопределено;
	
	
	ДанныеСобытия = РазобратьВходящиеDATA(request);
	
	Если ДанныеСобытия.ErrorMsg = "" Тогда
		//Попытка         
			СтруктураОтвет.response = ВыполнитьФункциюМодуля(ДанныеСобытия.request, ДанныеСобытия.data);
		//Исключение
		//	СтруктураОтвет.response = Новый Структура("result, data", "-2", ДанныеСобытия.ErrorMsg);;
		//КонецПопытки;
	Иначе
		СтруктураОтвет.response = Новый Структура("result, data", "-2", ДанныеСобытия.ErrorMsg);
	КонецЕсли;
	
	Возврат ПреобразоватьВСтрокуОтвета(СтруктураОтвет);
КонецФункции

Функция ВыполнитьФункциюМодуля(ИмяСобытия, Параметры)
	
	Если ИмяСобытия = "changObjects" Тогда
		
		Возврат changObjects(Параметры);
		
	ИначеЕсли ИмяСобытия = "createUser" Тогда
		
		Возврат createUser(Параметры);
				
	ИначеЕсли ИмяСобытия = "getLocationList" Тогда
		
		Возврат getLocationList(Параметры);
				
	ИначеЕсли ИмяСобытия = "getStokList" Тогда
		
		Возврат getStokList(Параметры);
				
	ИначеЕсли ИмяСобытия = "getStokQuantity" Тогда
		
		Возврат getStokQuantity(Параметры);

	ИначеЕсли ИмяСобытия = "getTrip" Тогда
		
		Возврат getTrip(Параметры);

	ИначеЕсли ИмяСобытия = "getServiceList" Тогда
		
		Возврат getServiceList(Параметры);

	ИначеЕсли ИмяСобытия = "getISOList" Тогда
		
		Возврат getISOList(Параметры);

	ИначеЕсли ИмяСобытия = "getTypeOfCargo" Тогда
		
		Возврат getTypeOfCargo(Параметры);

	ИначеЕсли ИмяСобытия = "postRequest" Тогда
		
		Возврат postRequest(Параметры);

	ИначеЕсли ИмяСобытия = "getRequest" Тогда
		
		Возврат getRequest(Параметры);

	ИначеЕсли ИмяСобытия = "updateRequest" Тогда
		
		Возврат updateRequest(Параметры);

	ИначеЕсли ИмяСобытия = "getInvoce" Тогда
		
		Возврат getInvoce(Параметры);

	//ИначеЕсли ИмяСобытия = "getRailwayInvoice" Тогда
	//	
	//	Возврат getRailwayInvoice(Параметры);

	//ИначеЕсли ИмяСобытия = "getDislocation" Тогда
	//	
	//	Возврат getDislocation(Параметры);

	ИначеЕсли ИмяСобытия = "getReliz" Тогда
		
		Возврат getReliz(Параметры);

	ИначеЕсли ИмяСобытия = "updateReliz" Тогда
		
		Возврат updateReliz(Параметры);
		
	ИначеЕсли ИмяСобытия = "getEventsList" Тогда
		
		Возврат getEventsList(Параметры);
		
	Иначе // -1
		
		СтруктураОтвет = новый Структура("result, data", -1, "Не найден WS-метод");
		Возврат СтруктураОтвет;
		
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция РазобратьВходящиеDATA(Входящее)
	
	СтруктураОтвет = Новый Структура;
	СтруктураОтвет.Вставить("request", "");
	СтруктураОтвет.Вставить("data", "");
	СтруктураОтвет.Вставить("ErrorMsg", "");
	
    ЧтениеJSON    = Новый ЧтениеJSON();
    ЧтениеJSON.УстановитьСтроку(Входящее);
	Попытка
		РезультатРазбора = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		СтруктураОтвет.ErrorMsg = ""+СокрЛП(Входящее);
		Возврат СтруктураОтвет;
	КонецПопытки;	
	
	Если ТипЗнч(РезультатРазбора) <> Тип("Структура") Тогда
		СтруктураОтвет.ErrorMsg = "Неверный тип параметров";
		Возврат СтруктураОтвет;
	КонецЕсли;

	Если НЕ РезультатРазбора.Свойство("request") ИЛИ НЕ РезультатРазбора.Свойство("data") Тогда
		СтруктураОтвет.ErrorMsg = "Недостаточно параметров";
		Возврат СтруктураОтвет;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(СтруктураОтвет, РезультатРазбора, "request, data");
	
	Возврат СтруктураОтвет;
КонецФункции

Функция ПреобразоватьВСтрокуОтвета(НаОтправку)
	
	ЗаписьJSON = новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(ЗаписьJSON, НаОтправку);
	лОтвет = ЗаписьJSON.Закрыть();
	
	//лОтвет = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(лОтвет));
	
	Возврат лОтвет;
КонецФункции

// Преобразование строки даты формата "2020-09-21T00:00:00" в 1С дату
Функция ПолучитьДату(date_)
	лОтвет = Неопределено;
	
	Попытка
		лОтвет = СтрЗаменить(date_, "-", "");
		лОтвет = СтрЗаменить(лОтвет, "T", "");
		лОтвет = СтрЗаменить(лОтвет, ":", "");
		лОтвет = Дата(лОтвет);
	Исключение
		
	КонецПопытки;
	
	Возврат лОтвет;
КонецФункции

Функция СоздатьЗапросКлиента(СтруктураПараметров)
	
	ЗапросК = Документы.Запрос.СоздатьДокумент();
	ЗапросК.Заполнить(Неопределено);
	//ЗапросК.Груз = груз;
	//ЗапросК.КонтейнерКлиента 		= НЕ КонтейнерЕвросиба;
	//ЗапросК.Резидент = Резидент;
	//Груз = Грузы_сервер.НайтиСоздатьГруз(gruzlist);
	//КонтейнерЕвросиба = ?(Строка(cnt_eurosibowner) = "1", Истина, Ложь);
	ЗапросК.ИсточникЗапроса 		= Перечисления.ИсточникиЗапросов.ЗапросЧерезВебСайтБезАвторизации;
	ЗапросК.КонтактныйТелефон 		= СтруктураПараметров.other_tel;
	ЗапросК.ПериодОтправкиНачало 	= ПолучитьДату(СтруктураПараметров.from_datetime);
	ЗапросК.ПериодПрибытияНачало 	= ПолучитьДату(СтруктураПараметров.to_datetime);;
	ЗапросК.ПунктОтправления 		= Справочники.Локации.НайтиПоКоду(СтруктураПараметров.from_location);
	ЗапросК.ПунктНазначения 		= Справочники.Локации.НайтиПоКоду(СтруктураПараметров.to_location);
	Если ЗначениеЗаполнено(СтруктураПараметров.GUIDPartner) Тогда
		//поиск по уид
		//Запроск.Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", ФОрмат(ИННКонтрагента, "ЧГ="));
	КонецЕсли;
	
	Для каждого Стр из СтруктураПараметров.containers Цикл
		НСтр = ЗапросК.СоставУслуги.Добавить();
		НСтр.Количество = Стр.count;
		НСтр.ТипТЕ 		= Справочники.ТипоразмерыТЕ.НайтиПоНаименованию(Стр.typeISO, Истина);
	КонецЦикла;
	ЗапросК.ТекстЗапроса 		= СокрЛП(СтруктураПараметров.other_longdescription);
	ЗапросК.ЭлектроннаяПочта 	= СтруктураПараметров.other_email;
	ЗапросК.Примечание 			= СтруктураПараметров.other_fio;
	ЗапросК.Дата 				= ТекущаяДата();
	ЗапросК.Записать(РежимЗаписиДокумента.Запись);
	Попытка
		ЗапросК.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
	КонецПопытки;
	
	Возврат ЗапросК.Ссылка;
	
КонецФункции


