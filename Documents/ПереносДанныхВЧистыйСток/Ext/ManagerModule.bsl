Функция ПроверитьДанныеПоОперациямЧистыйСток(Коллекция, Ссылка)
	ТаблицаРезультат = Коллекция.СкопироватьКолонки();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Коллекция",Коллекция);
	Запрос.Текст = 
