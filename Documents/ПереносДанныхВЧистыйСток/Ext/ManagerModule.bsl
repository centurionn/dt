		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИнформацияОтТерминаловCodeco.Период КАК Период,
		|	ИнформацияОтТерминаловCodeco.Контейнер КАК Контейнер,
		|	ИнформацияОтТерминаловCodeco.Терминал КАК Терминал,
		|	ИнформацияОтТерминаловCodeco.ДатаОперации КАК ДатаОперации,
		|	ИнформацияОтТерминаловCodeco.ПеренесенВЧистыйСток КАК ПеренесенВЧистыйСток
		|ПОМЕСТИТЬ ИТОГ
		|ИЗ
		|	ВременнаяТаблица КАК ВременнаяТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИнформацияОтТерминаловCodeco КАК ИнформацияОтТерминаловCodeco
		|		ПО (ИнформацияОтТерминаловCodeco.Контейнер = ВременнаяТаблица.Контейнер)
		|			И (ИнформацияОтТерминаловCodeco.Терминал = ВременнаяТаблица.Терминал)
		|			И (ИнформацияОтТерминаловCodeco.ДатаОперации = ВременнаяТаблица.ДатаОперации)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИТОГ.Период КАК Период,
		|	ИТОГ.Контейнер КАК Контейнер,
		|	ИТОГ.Терминал КАК Терминал,
		|	ИТОГ.ДатаОперации КАК ДатаОперации
		|ИЗ
		|	ИТОГ КАК ИТОГ
		|ГДЕ
		|	НЕ ИТОГ.ПеренесенВЧистыйСток";
	
	Запрос.УстановитьПараметр("ТЗ", ДанныеДляПометки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Набор = РегистрыСведений.ИнформацияОтТерминаловCodeco.СоздатьНаборЗаписей();
		Набор.Отбор.Период.Установить(ВыборкаДетальныеЗаписи.Период);
		Набор.Отбор.Контейнер.Установить(ВыборкаДетальныеЗаписи.Контейнер);
		Набор.Отбор.ДатаОперации.Установить(ВыборкаДетальныеЗаписи.ДатаОперации);
		Набор.Отбор.Терминал.Установить(ВыборкаДетальныеЗаписи.Терминал);
		Набор.Прочитать();
		Для Каждого СтрокаНабора Из Набор Цикл
			СтрокаНабора.ПеренесенВЧистыйСток = Истина;
		КонецЦикла;
		Набор.Записать();
	КонецЦикла;
	
КонецПроцедуры

