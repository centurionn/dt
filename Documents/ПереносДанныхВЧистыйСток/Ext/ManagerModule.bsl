Процедура УстановитьВРегистреИнформацияОтТерминаловCodeco(ДанныеДляПометки) //Евросиб Шевченко А.В. US 112575 TA 124359 24.11.2025
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
