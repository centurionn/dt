Процедура ЗаписатьБлокировкуКонтейнеров(Источник)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПереносДанныхВЧистыйСтокДанныеПоОперациямЧистыйСток.Контейнер КАК КТК,
		|	ПереносДанныхВЧистыйСтокДанныеПоОперациямЧистыйСток.НаличиеПодвреждения КАК НаличиеПовреждения,
		|	ПереносДанныхВЧистыйСтокДанныеПоОперациямЧистыйСток.ДатаОперации КАК Период,
		|	ПереносДанныхВЧистыйСтокДанныеПоОперациямЧистыйСток.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ ВТ_СостояниеБлокировкиПриПереносеДанных
		|ИЗ
		|	Документ.ПереносДанныхВЧистыйСток.ДанныеПоОперациямЧистыйСток КАК ПереносДанныхВЧистыйСтокДанныеПоОперациямЧистыйСток
		|ГДЕ
		|	НЕ ПереносДанныхВЧистыйСтокДанныеПоОперациямЧистыйСток.НаличиеПодвреждения В (ЗНАЧЕНИЕ(Перечисление.ТипыПоврежденияКТК.НетДанных), ЗНАЧЕНИЕ(Перечисление.ТипыПоврежденияКТК.ПустаяСсылка))
		|	И ПереносДанныхВЧистыйСтокДанныеПоОперациямЧистыйСток.Ссылка = &Регистратор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_СостояниеБлокировкиПриПереносеДанных.КТК КАК КТК,
		|	ВТ_СостояниеБлокировкиПриПереносеДанных.НаличиеПовреждения КАК НаличиеПовреждения,
		|	МАКСИМУМ(ВТ_СостояниеБлокировкиПриПереносеДанных.Период) КАК Период,
		|	ВТ_СостояниеБлокировкиПриПереносеДанных.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ ВТ_КТКкУстановкеСтатуса
		|ИЗ
		|	ВТ_СостояниеБлокировкиПриПереносеДанных КАК ВТ_СостояниеБлокировкиПриПереносеДанных
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_СостояниеБлокировкиПриПереносеДанных.КТК,
		|	ВТ_СостояниеБлокировкиПриПереносеДанных.НаличиеПовреждения,
		|	ВТ_СостояниеБлокировкиПриПереносеДанных.НомерСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_КТКкУстановкеСтатуса.КТК КАК КТК,
		|	ВЫБОР
		|		КОГДА ВТ_КТКкУстановкеСтатуса.НаличиеПовреждения = ЗНАЧЕНИЕ(Перечисление.ТипыПоврежденияКТК.Поврежден)
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.СтатусыКТК.Заблокирован)
		|		КОГДА ВТ_КТКкУстановкеСтатуса.НаличиеПовреждения = ЗНАЧЕНИЕ(Перечисление.ТипыПоврежденияКТК.НеПоврежден)
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.СтатусыКТК.НеЗаблокирован)
		|	КОНЕЦ КАК Статус,
		|	""Установка статуса при проведении Переноса данных в чистый сток"" КАК Комментарий,
		|	ВТ_КТКкУстановкеСтатуса.Период КАК Период,
		|	&Регистратор КАК Регистратор,
		|	ВЫБОР
		|		КОГДА ВТ_КТКкУстановкеСтатуса.НаличиеПовреждения = ЗНАЧЕНИЕ(Перечисление.ТипыПоврежденияКТК.Поврежден)
		|			ТОГДА ИСТИНА
		|		КОГДА ВТ_КТКкУстановкеСтатуса.НаличиеПовреждения = ЗНАЧЕНИЕ(Перечисление.ТипыПоврежденияКТК.НеПоврежден)
		|			ТОГДА ЛОЖЬ
		|	КОНЕЦ КАК Поврежден,
		|	ВТ_КТКкУстановкеСтатуса.НомерСтроки КАК НомерСтроки,
		|	ЕСТЬNULL(СостояниеБлокировкиКТКСрезПоследних.ПросроченСВВ, ЛОЖЬ) КАК ПросроченСВВ,
		|	ЕСТЬNULL(СостояниеБлокировкиКТКСрезПоследних.Другое, ЛОЖЬ) КАК Другое,
		|	СостояниеБлокировкиКТКСрезПоследних.ОписаниеПричиныДругое КАК ОписаниеПричиныДругое,
		|	СостояниеБлокировкиКТКСрезПоследних.ДатаПоврежден КАК ДатаПоврежден,
		|	СостояниеБлокировкиКТКСрезПоследних.ДатаПросроченСВВ КАК ДатаПросроченСВВ,
		|	СостояниеБлокировкиКТКСрезПоследних.ДатаДругое КАК ДатаДругое,
		|	СостояниеБлокировкиКТКСрезПоследних.СостояниеРемонта КАК СостояниеРемонта
		|ПОМЕСТИТЬ ВТ_Итог
		|ИЗ
		|	ВТ_КТКкУстановкеСтатуса КАК ВТ_КТКкУстановкеСтатуса
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеБлокировкиКТКАктуальный.СрезПоследних(
		|				&Период,
		|				КТК В
		|					(ВЫБРАТЬ
		|						ВТ_КТКкУстановкеСтатуса.КТК КАК КТК
		|					ИЗ
		|						ВТ_КТКкУстановкеСтатуса КАК ВТ_КТКкУстановкеСтатуса)) КАК СостояниеБлокировкиКТКСрезПоследних
		|		ПО ВТ_КТКкУстановкеСтатуса.КТК = СостояниеБлокировкиКТКСрезПоследних.КТК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Итог.КТК КАК КТК,
		|	ВЫБОР
		|		КОГДА ВТ_Итог.Поврежден
		|				ИЛИ ВТ_Итог.ПросроченСВВ
		|				ИЛИ ВТ_Итог.Другое
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.СтатусыКТК.Заблокирован)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СтатусыКТК.НеЗаблокирован)
		|	КОНЕЦ КАК Статус,
		|	&Период КАК ДатаПереноса,
		|	ВТ_Итог.Комментарий КАК Комментарий,
		|	ВТ_Итог.Период КАК Период,
		|	ВТ_Итог.Регистратор КАК Регистратор,
		|	ВТ_Итог.Поврежден КАК Поврежден,
		|	ВТ_Итог.НомерСтроки КАК НомерСтроки,
		|	ВТ_Итог.ПросроченСВВ КАК ПросроченСВВ,
		|	ВТ_Итог.Другое КАК Другое,
		|	ВТ_Итог.ОписаниеПричиныДругое КАК ОписаниеПричиныДругое,
		|	ВТ_Итог.ДатаПоврежден КАК ДатаПоврежден,
		|	ВТ_Итог.ДатаПросроченСВВ КАК ДатаПросроченСВВ,
		|	ВТ_Итог.ДатаДругое КАК ДатаДругое,
		|	ВТ_Итог.СостояниеРемонта КАК СостояниеРемонта
		|ИЗ
		|	ВТ_Итог КАК ВТ_Итог";
	Запрос.УстановитьПараметр("Регистратор", Источник.Ссылка); 
	Запрос.УстановитьПараметр("Период", Источник.Дата);
	РезультатЗапроса = Запрос.Выполнить(); 
	
	ТаблицаКПроведению = ПроверитьСостояниеБлокировкиКТК(РезультатЗапроса.Выгрузить());
	Источник.Движения.СостояниеБлокировкиКТК.Загрузить(ТаблицаКПроведению);
	Источник.Движения.СостояниеБлокировкиКТК.Записывать = Истина;
	Источник.Движения.СостояниеБлокировкиКТК.Записать();
	
КонецПроцедуры

Функция ПроверитьСостояниеБлокировкиКТК(Коллекция)
	ТаблицаРезультат = Коллекция.СкопироватьКолонки();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Коллекция",Коллекция);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Т.Период КАК Период,
		|	Т.КТК КАК КТК,
		|	Т.ДатаПереноса КАК ДатаПереноса, 
		|	Т.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ ВТ_Набор
		|ИЗ
		|	&Коллекция КАК Т
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СостояниеБлокировкиКТК.КТК КАК КТК,
		|	СостояниеБлокировкиКТК.ДатаПереноса КАК ДатаПереноса,
		|	СостояниеБлокировкиКТК.Период КАК Период,
		|	СостояниеБлокировкиКТК.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ ВТ_ДанныеБД
		|ИЗ
		|	РегистрСведений.СостояниеБлокировкиКТК КАК СостояниеБлокировкиКТК
		|ГДЕ
		|	(СостояниеБлокировкиКТК.Период, СостояниеБлокировкиКТК.КТК, СостояниеБлокировкиКТК.ДатаПереноса) В
		|			(ВЫБРАТЬ
		|				ВТ_Набор.Период КАК Период,
		|				ВТ_Набор.КТК КАК КТК,
		|				ВТ_Набор.Период КАК ДатаПереноса
		|			ИЗ
		|				ВТ_Набор КАК ВТ_Набор)
		|
		|СГРУППИРОВАТЬ ПО
		|	СостояниеБлокировкиКТК.КТК,
		|	СостояниеБлокировкиКТК.Период,
		|	СостояниеБлокировкиКТК.ДатаПереноса,
		|	СостояниеБлокировкиКТК.НомерСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Набор.Период КАК Период,
		|	ВТ_Набор.КТК КАК КТК,
		|	ВТ_Набор.ДатаПереноса КАК ДатаПереноса,
		|	ВТ_Набор.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ ВТ_ОбщиеДанные_Начало
		|ИЗ
		|	ВТ_Набор КАК ВТ_Набор
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТ_ДанныеБД.Период,
		|	ВТ_ДанныеБД.КТК,
		|	ВТ_ДанныеБД.ДатаПереноса,
		|	ВТ_ДанныеБД.НомерСтроки
		|ИЗ
		|	ВТ_ДанныеБД КАК ВТ_ДанныеБД
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ОбщиеДанные_Начало.Период КАК Период,
		|	ВТ_ОбщиеДанные_Начало.КТК КАК КТК,
		|	ВТ_ОбщиеДанные_Начало.ДатаПереноса КАК ДатаПереноса,
		|	ВТ_ОбщиеДанные_Начало.НомерСтроки КАК НомерСтроки,
		|	АВТОНОМЕРЗАПИСИ() КАК НомерЗаписи
		|ПОМЕСТИТЬ ВТ_ОбщиеДанные
		|ИЗ
		|	ВТ_ОбщиеДанные_Начало КАК ВТ_ОбщиеДанные_Начало
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ОбщиеДанные.Период КАК Период,
		|	ВТ_ОбщиеДанные.КТК КАК КТК,
		|	ВТ_ОбщиеДанные.ДатаПереноса КАК ДатаПереноса,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_ОбщиеДанные.НомерЗаписи) КАК НомерЗаписи
		|ПОМЕСТИТЬ ВТ_РасчетДублей
		|ИЗ
		|	ВТ_ОбщиеДанные КАК ВТ_ОбщиеДанные
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ОбщиеДанные.Период,
		|	ВТ_ОбщиеДанные.ДатаПереноса,
		|	ВТ_ОбщиеДанные.КТК
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_ОбщиеДанные.НомерЗаписи) > 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Набор.Период КАК Период,
		|	ВТ_Набор.КТК КАК КТК,
		|	ВТ_Набор.ДатаПереноса КАК ДатаПереноса,
		|	ВТ_Набор.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	ВТ_Набор КАК ВТ_Набор
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РасчетДублей КАК ВТ_РасчетДублей
		|		ПО ВТ_Набор.Период = ВТ_РасчетДублей.Период
		|			И ВТ_Набор.КТК = ВТ_РасчетДублей.КТК 
		|			И ВТ_Набор.ДатаПереноса = ВТ_РасчетДублей.ДатаПереноса 
		|ГДЕ
		|	ВТ_РасчетДублей.НомерЗаписи ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_РасчетДублей.Период КАК Период,
		|	ВТ_РасчетДублей.КТК КАК КТК,
		|	ВТ_РасчетДублей.ДатаПереноса КАК ДатаПереноса,
		|	ВТ_РасчетДублей.НомерЗаписи КАК НомерЗаписи
		|ИЗ
		|	ВТ_РасчетДублей КАК ВТ_РасчетДублей";
	                                                                         
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ТаблицаУспех = РезультатыЗапроса[РезультатыЗапроса.ВГраница()-1].Выгрузить();
	ТаблицаОшибок = РезультатыЗапроса[РезультатыЗапроса.ВГраница()].Выгрузить();
	
	Для Каждого СтрокаУспех Из ТаблицаУспех Цикл
		Отбор = Новый Структура("НомерСтроки,Период,КТК,ДатаПереноса");
		ЗаполнитьЗначенияСвойств(Отбор,СтрокаУспех);
		НайденныеСтроки = Коллекция.НайтиСтроки(Отбор); 
		Если НайденныеСтроки.Количество() Тогда
			ЗаполнитьЗначенияСвойств(ТаблицаРезультат.Добавить(),НайденныеСтроки[0]);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаОшибки Из ТаблицаОшибок Цикл
		Ошибка = СтрШаблон("Обнаружена не уникальная запись Период:%1 КТК:%2 ДатаПереноса:%3",СтрокаОшибки.Период,СтрокаОшибки.КТК,СтрокаОшибки.ДатаПереноса);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Ошибка);
		ЗаписьЖурналаРегистрации("ПроведениеПереносЧистыйСток_СостояниеБлокировкиКТК",,,,Ошибка);
	КонецЦикла;
	
	Возврат ТаблицаРезультат;
КонецФункции

