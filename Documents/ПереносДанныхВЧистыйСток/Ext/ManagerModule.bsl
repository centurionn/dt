Процедура УстановитьУИДСтрок(ДанныеИзИсточниковДляЧистогоСтока) Экспорт //Евросиб Шевченко А.В. US 112575 TA 124359 24.11.2025
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТабЧасть.Контейнер КАК Контейнер,
		|	ТабЧасть.ДатаОперации КАК ДатаОперации,
		|	ТабЧасть.Терминал КАК Терминал,
		|	ТабЧасть.ТипОперации КАК ТипОперации,
		|	ТабЧасть.Состояние КАК Состояние,
		|	ТабЧасть.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ ТабЧасть
		|ИЗ
		|	&ТЗ КАК ТабЧасть
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТабЧасть.Контейнер КАК Контейнер,
		|	ТабЧасть.ДатаОперации КАК ДатаОперации,
		|	ТабЧасть.Терминал КАК Терминал,
		|	ТабЧасть.ТипОперации КАК ТипОперации,
		|	ТабЧасть.Состояние КАК Состояние,
		|	АВТОНОМЕРЗАПИСИ() КАК НомерГруппировки
		|ПОМЕСТИТЬ ВТ_Итог
		|ИЗ
		|	ТабЧасть КАК ТабЧасть
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабЧасть КАК ТабЧасть1
		|		ПО ТабЧасть.Контейнер = ТабЧасть1.Контейнер
		|			И (НАЧАЛОПЕРИОДА(ТабЧасть.ДатаОперации, ЧАС) = НАЧАЛОПЕРИОДА(ТабЧасть1.ДатаОперации, ЧАС))
		|			И ТабЧасть.Терминал = ТабЧасть1.Терминал
		|			И ТабЧасть.ТипОперации = ТабЧасть1.ТипОперации
		|			И ТабЧасть.Состояние = ТабЧасть1.Состояние
		|			И ТабЧасть.НомерСтроки <> ТабЧасть1.НомерСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабЧасть1.НомерСтроки КАК НомерСтроки,
		|	ВТ_Итог.НомерГруппировки КАК НомерГруппировки
		|ИЗ
		|	ВТ_Итог КАК ВТ_Итог
		|		ЛЕВОЕ СОЕДИНЕНИЕ ТабЧасть КАК ТабЧасть1
		|		ПО ВТ_Итог.Контейнер = ТабЧасть1.Контейнер
		|			И (НАЧАЛОПЕРИОДА(ВТ_Итог.ДатаОперации, ЧАС) = НАЧАЛОПЕРИОДА(ТабЧасть1.ДатаОперации, ЧАС))
		|			И ВТ_Итог.Терминал = ТабЧасть1.Терминал
		|			И ВТ_Итог.ТипОперации = ТабЧасть1.ТипОперации
		|			И ВТ_Итог.Состояние = ТабЧасть1.Состояние
		|ИТОГИ ПО
		|	НомерГруппировки";
	
	Запрос.УстановитьПараметр("ТЗ", ДанныеИзИсточниковДляЧистогоСтока.Выгрузить());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаНомерГруппировки = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаНомерГруппировки.Следующий() Цикл
	
		ВыборкаДетальныеЗаписи = ВыборкаНомерГруппировки.Выбрать();
		
		УИД = Новый УникальныйИдентификатор;
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			СтруктураПоиска = Новый Структура("НомерСтроки",ВыборкаДетальныеЗаписи.НомерСтроки);
			СтрокаТЧ = ДанныеИзИсточниковДляЧистогоСтока[ВыборкаДетальныеЗаписи.НомерСтроки-1];
			Если ЗначениеЗаполнено(СтрокаТЧ.УИД) Тогда
				Продолжить;
			КонецЕсли;	
			СтрокаТЧ.УИД = УИД;
		КонецЦикла;
				
	КонецЦикла;
	
	Для Каждого СТрокаТЧ Из ДанныеИзИсточниковДляЧистогоСтока Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.УИД) Тогда
			СтрокаТЧ.УИД = Новый УникальныйИдентификатор;
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры	

Функция НайтиСтрокиВТЧСТочностьДоЧаса(ТЧ,Отбор)
	МассивНайденныхСтрок = Новый Массив;
	Для Каждого СтрокаТЧ Из ТЧ Цикл
		СтрокаПодходит = Истина;
		Для Каждого КлючЗначение Из Отбор Цикл
			
			ЗначениеСтроки = СтрокаТЧ[КлючЗначение.Ключ];
			ЗначениеОтбора = КлючЗначение.Значение;
			Если КлючЗначение.Ключ = "ДатаОперации" Тогда
				ЗначениеСтроки = НачалоЧаса(ЗначениеСтроки);
				ЗначениеОтбора = НачалоЧаса(ЗначениеОтбора);
			КонецЕсли;
			Если ЗначениеСтроки <> ЗначениеОтбора Тогда
				СтрокаПодходит = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если СтрокаПодходит Тогда
			МассивНайденныхСтрок.Добавить(СтрокаТЧ);
		КонецЕсли;
	КонецЦикла;
	Возврат МассивНайденныхСтрок;
КонецФункции
