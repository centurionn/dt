Процедура УдалитьВыполнитьКонтроль48Часов()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МестонахождениеЧистыйСтокОстатки.Контейнер КАК Контейнер,
		|	МестонахождениеЧистыйСтокОстатки.Терминал КАК Терминал,
		|	ЕСТЬNULL(ДанныеПоОперациямЧистыйСтокАктуальный.ДатаОперации, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОперации,
		|	ВЫБОР
		|		КОГДА МестонахождениеЧистыйСтокОстатки.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|			ТОГДА -МестонахождениеЧистыйСтокОстатки.Количество
		|		ИНАЧЕ МестонахождениеЧистыйСтокОстатки.Количество
		|	КОНЕЦ КАК КоличествоОстаток,
		|	МестонахождениеЧистыйСтокОстатки.ИсточникДобавленияДанных КАК ИсточникДобавленияДанных
		|ПОМЕСТИТЬ ВТ_МестонахождениеАктуальное
		|ИЗ
		|	РегистрНакопления.МестонахождениеЧистыйСток КАК МестонахождениеЧистыйСтокОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеПоОперациямЧистыйСтокАктуальный КАК ДанныеПоОперациямЧистыйСтокАктуальный
		|		ПО МестонахождениеЧистыйСтокОстатки.Контейнер = ДанныеПоОперациямЧистыйСтокАктуальный.Контейнер
		|			И МестонахождениеЧистыйСтокОстатки.Терминал = ДанныеПоОперациямЧистыйСтокАктуальный.Терминал
		|ГДЕ
		|	МестонахождениеЧистыйСтокОстатки.ИсточникДобавленияДанных = ЗНАЧЕНИЕ(Справочник.ИсточникиДанныхЧистогоСтока.ИнформацияОтАвтоподрядчиков)
		|	И МестонахождениеЧистыйСтокОстатки.Регистратор ССЫЛКА Документ.ПереносДанныхВЧистыйСток
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Контейнер,
		|	ДатаОперации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_МестонахождениеАктуальное.Терминал КАК Терминал,
		|	ВТ_МестонахождениеАктуальное.Контейнер КАК Контейнер,
		|	ДанныеПоОперациямЧистыйСтокСрезПоследних.ДатаОперации КАК ДатаОперации,
		|	ДанныеПоОперациямЧистыйСтокСрезПоследних.ДатаОбновленияИнформации КАК ДатаОбновленияИнформации,
		|	ДанныеПоОперациямЧистыйСтокСрезПоследних.ИсточникДобавленияДанных КАК ИсточникДобавленияДанных,
		|	ВТ_МестонахождениеАктуальное.КоличествоОстаток КАК КоличествоОстаток,
		|	ДанныеПоОперациямЧистыйСтокСрезПоследних.ИсточникДобавленияДанных КАК ИсточникДобавленияДанныхСток
		|ПОМЕСТИТЬ ВТ_ЧистыйСток
		|ИЗ
		|	ВТ_МестонахождениеАктуальное КАК ВТ_МестонахождениеАктуальное
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеПоОперациямЧистыйСток.СрезПоследних(, ) КАК ДанныеПоОперациямЧистыйСтокСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеПоОперациямЧистыйСтокДанныеРедактирования.СрезПоследних(, ) КАК ДанныеПоОперациямЧистыйСтокДанныеРедактированияСрезПоследних
		|			ПО ДанныеПоОперациямЧистыйСтокСрезПоследних.Контейнер = ДанныеПоОперациямЧистыйСтокДанныеРедактированияСрезПоследних.Контейнер
		|				И ДанныеПоОперациямЧистыйСтокСрезПоследних.ДатаОперации = ДанныеПоОперациямЧистыйСтокДанныеРедактированияСрезПоследних.ДатаОперации
		|		ПО ВТ_МестонахождениеАктуальное.Контейнер = ДанныеПоОперациямЧистыйСтокСрезПоследних.Контейнер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ЧистыйСток.Контейнер КАК Контейнер,
		|	МАКСИМУМ(ВТ_ЧистыйСток.ДатаОперации) КАК ДатаОперации
		|ПОМЕСТИТЬ ВТ_Максимумы
		|ИЗ
		|	ВТ_ЧистыйСток КАК ВТ_ЧистыйСток
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ЧистыйСток.Контейнер
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Контейнер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Максимумы.ДатаОперации КАК ДатаОперации,
		|	ВТ_ЧистыйСток.Терминал КАК Терминал,
		|	ВТ_ЧистыйСток.Контейнер КАК Контейнер,
		|	ВТ_ЧистыйСток.ДатаОбновленияИнформации КАК ДатаОбновленияИнформации,
		|	ВТ_ЧистыйСток.ИсточникДобавленияДанных КАК ИсточникДобавленияДанных,
		|	ВТ_ЧистыйСток.КоличествоОстаток КАК КоличествоОстаток
		|ПОМЕСТИТЬ ВТ_ПредИтог
		|ИЗ
		|	ВТ_Максимумы КАК ВТ_Максимумы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ЧистыйСток КАК ВТ_ЧистыйСток
		|		ПО ВТ_Максимумы.Контейнер = ВТ_ЧистыйСток.Контейнер
		|			И ВТ_Максимумы.ДатаОперации = ВТ_ЧистыйСток.ДатаОперации
		|ГДЕ
		|	РАЗНОСТЬДАТ(ВТ_ЧистыйСток.ДатаОбновленияИнформации, &ТекущаяДата, МИНУТА) >= 1
		|	И ВТ_ЧистыйСток.ИсточникДобавленияДанныхСток = ЗНАЧЕНИЕ(Справочник.ИсточникиДанныхЧистогоСтока.ИнформацияОтАвтоподрядчиков)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ПредИтог.ДатаОперации КАК ДатаОперации,
		|	ВТ_ПредИтог.Терминал КАК Терминал,
		|	ВТ_ПредИтог.Контейнер КАК Контейнер,
		|	ВТ_ПредИтог.ДатаОбновленияИнформации КАК ДатаОбновленияИнформации,
		|	ВТ_ПредИтог.ИсточникДобавленияДанных КАК ИсточникДобавленияДанных,
		|	ВТ_ПредИтог.КоличествоОстаток КАК КоличествоОстаток
		|ИЗ
		|	ВТ_ПредИтог КАК ВТ_ПредИтог
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИнформацияОтАвтоподрядчиковПоТерминалам КАК ИнформацияОтАвтоподрядчиковПоТерминалам
		|		ПО ВТ_ПредИтог.ДатаОперации = ИнформацияОтАвтоподрядчиковПоТерминалам.ДатаОперации
		|			И ВТ_ПредИтог.Контейнер = ИнформацияОтАвтоподрядчиковПоТерминалам.Контейнер
		|			И ВТ_ПредИтог.Терминал = ИнформацияОтАвтоподрядчиковПоТерминалам.Терминал
		|ГДЕ
		|	ВЫБОР
		|			КОГДА ЕСТЬNULL(ИнформацияОтАвтоподрядчиковПоТерминалам.ОшибкиПриЗагрузкеИнформацииОтТерминалов, ЗНАЧЕНИЕ(Справочник.ОшибкиПриЗагрузкеИнформацииОтТерминалов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.ОшибкиПриЗагрузкеИнформацииОтТерминалов.ПустаяСсылка)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ НЕ ИнформацияОтАвтоподрядчиковПоТерминалам.ОшибкиПриЗагрузкеИнформацииОтТерминалов.Контроль48Часов
		|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		//Данные записи надо удалить с чистого стока.
		Параметры = Новый Структура("Контейнер,Терминал,ДатаОперации,КоличествоОстаток",Выборка.Контейнер,Выборка.Терминал,Выборка.ДатаОперации,Выборка.КоличествоОстаток);
		Отказ = Ложь;
		Попытка
			ДокументРедактирования = Документы.РедактированиеДанныхЧистогоСтока.ВвестиДокументСторно(Параметры,Отказ);
		Исключение
			Если ТранзакцияАктивна() Тогда
				ШаблонОшибки = СтрШаблон("Не удалось сформировать сторно Контейнер:%1 ,Терминал:%2, ДатаОперации:%3, КоличествоОстаток:%4",
				Выборка.Контейнер,Выборка.Терминал,Выборка.ДатаОперации,Выборка.КоличествоОстаток);
				ВызватьИсключение(ШаблонОшибки);
			КонецЕсли;	
		КонецПопытки;
		//Запись ошибки
		НаборИсточника = РегистрыСведений.ИнформацияОтАвтоподрядчиковПоТерминалам.СоздатьНаборЗаписей();
		НаборИсточника.Отбор.Контейнер.Установить(Выборка.Контейнер);
		НаборИсточника.Отбор.ДатаОперации.Установить(Выборка.ДатаОперации);
		НаборИсточника.Отбор.Терминал.Установить(Выборка.Терминал);
		НаборИсточника.Прочитать();
		
		Если НаборИсточника.Количество() = 1 Тогда
			СтрокаИсточника = НаборИсточника[0];  
			Если Не ЗначениеЗаполнено(СтрокаИсточника.ОшибкиПриЗагрузкеИнформацииОтТерминалов) Тогда 
				//Евросиб(ДИТ) Антонова А.С. US 105060 ТА 114167 Начало 23.07.2025
				//СправочникОшибки = СоздатьСправочникОшибки();
				СправочникОшибки = СоздатьСправочникОшибки(Перечисления.ОшибкиЗагрузкиСтоков.Другое, Истина);
				//Евросиб(ДИТ) Антонова А.С. US 105060 ТА 114167 Конец 23.07.2025
				СтрокаИсточника.ОшибкиПриЗагрузкеИнформацииОтТерминалов = СправочникОшибки;
				НаборИсточника.ОбменДанными.Загрузка = Истина;
				НаборИсточника.Записать();
			Иначе
				ДополнитьСправочникОшибки(СтрокаИсточника.ОшибкиПриЗагрузкеИнформацииОтТерминалов, Перечисления.ОшибкиЗагрузкиСтоков.Другое, Истина);	
			КонецЕсли;
		КонецЕсли; 
		
		Если Не Отказ Тогда
			ЗаполнитьРегистрАктуальный(ДокументРедактирования,Параметры);
		Иначе
			Если ТранзакцияАктивна() Тогда
				ВызватьИсключение("Не удалось сформировать сторно");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

//Евросиб(ДИТ) Антонова А.С. US 105060 ТА 114167 23.07.2025 добавлены параметры ТипОшибки и Контроль48Часов
//Процедура ДополнитьСправочникОшибки48Часов(СправочникСсылка) Экспорт
Процедура ДополнитьСправочникОшибки(СправочникСсылка, ТипОшибки, Контроль48Часов) Экспорт
	
	СправочникОбъект = СправочникСсылка.ПолучитьОбъект();
	СправочникОбъект.Контроль48Часов = Контроль48Часов;
	СтрокаОшибкиСправочника = СправочникОбъект.ОшибкиПриЗагрузке.Добавить();
	СтрокаОшибкиСправочника.ТипОшибки = ТипОшибки;
	СтрокаОшибкиСправочника.Пользователь = Пользователи.ТекущийПользователь();
	
	Попытка
		СправочникОбъект.Записать();
	Исключение
	КонецПопытки;
	
КонецПроцедуры

//Евросиб(ДИТ) Антонова А.С. US 105060 ТА 114167 23.07.2025 добавлены параметры ТипОшибки и Контроль48Часов
Функция СоздатьСправочникОшибки(ТипОшибки, Контроль48Часов) Экспорт
	
	СправочникОбъект = Справочники.ОшибкиПриЗагрузкеИнформацииОтТерминалов.СоздатьЭлемент();
	//СправочникОбъект.ОшибкиПриЗагрузке.Загрузить(ТаблицаОшибок);
	СправочникОбъект.УстановитьНовыйКод();
	СправочникОбъект.Контроль48Часов = Контроль48Часов;
	СтрокаОшибкиСправочника = СправочникОбъект.ОшибкиПриЗагрузке.Добавить();
	//Евросиб(ДИТ) Антонова А.С. US 105060 ТА 114167 Начало 23.07.2025
	//СтрокаОшибкиСправочника.ТипОшибки = Перечисления.ОшибкиЗагрузкиСтоков.Другое;
	СтрокаОшибкиСправочника.ТипОшибки = ТипОшибки;
	//Евросиб(ДИТ) Антонова А.С. US 105060 ТА 114167 Конец 23.07.2025 
	//Евросиб(ДИТ) Антонова А.С. US 105060 ТА 115174 Начало 18.08.2025
	Если ТипОшибки = Перечисления.ОшибкиЗагрузкиСтоков.ИнформацияОтАвтоподрядчика Тогда
		СтрокаОшибкиСправочника.ИсправляемаяОшибка = Истина;
	КонецЕсли;
	//Евросиб(ДИТ) Антонова А.С. US 105060 ТА 115174 Конец 18.08.2025
	СтрокаОшибкиСправочника.Пользователь = Пользователи.ТекущийПользователь();
	
	
	Попытка
		СправочникОбъект.Записать();
		Возврат СправочникОбъект.Ссылка;
	Исключение
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции 

Процедура ОтметитьДанныеЗагруженными(ДанныеДляПометки) Экспорт
	//Евросиб Шевченко А.В. US 112575 TA 124359 24.11.2025
	//Для Каждого СтрокаДанных Из ДанныеДляПометки Цикл
	//	Если СтрокаДанных.ИсточникДобавленияДанных = Справочники.ИсточникиДанныхЧистогоСтока.РучнаяЗагрузка Тогда
