// + ДИТ Кузнецов Е.Е. US 78754 ТА 98408 06.02.202
Процедура ЗаписатьПризнакЗагрузкиТерминала(Источник)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПереносДанныхВЧистыйСтокТерминалы.Терминал КАК Терминал,
		|	НАЧАЛОПЕРИОДА(ПереносДанныхВЧистыйСтокТерминалы.Ссылка.Дата, ДЕНЬ) КАК ДатаЗагрузки,
		|	ИСТИНА КАК Обработано
		|ИЗ
		|	Документ.ПереносДанныхВЧистыйСток.Терминалы КАК ПереносДанныхВЧистыйСтокТерминалы
		|ГДЕ
		|	ПереносДанныхВЧистыйСтокТерминалы.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.ДатыЗагрузокДанныхПоТерминалам.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи,Выборка);
		МенеджерЗаписи.Записать();
	КонецЦикла;
	
	
КонецПроцедуры

Процедура ЗаполнитьТЧТерминалы(Объект)
	Объект.Терминалы.Очистить();
	ТчТерминалы = Объект.ДанныеПоОперациямЧистыйСток.Выгрузить(,"Терминал");
	ТчТерминалы.Свернуть("Терминал");
	Для Каждого СтрокаТерминала Из ТчТерминалы Цикл
		ЗаполнитьЗначенияСвойств(Объект.Терминалы.Добавить(),СтрокаТерминала);
	КонецЦикла;
КонецПроцедуры

Процедура ДозаполнитьДанныеПоРасходуТерминалов(Объект) Экспорт
	ДатаПереноса = НачалоДня(Объект.Дата);
	ДатаРасхода = ДатаПереноса - 1;
	ТаблицаИсключений = Объект.ДанныеПоОперациямЧистыйСток.Выгрузить(,"Контейнер,Терминал");
	ТаблицаИсключений.Свернуть("Контейнер,Терминал");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаОстатков", Объект.Дата);
	Запрос.УстановитьПараметр("ДатаЗагрузки", ДатаПереноса); 
	Запрос.УстановитьПараметр("Регистратор", Объект.Ссылка); 
	Запрос.УстановитьПараметр("ДатаРасхода", ДатаРасхода); 
	Запрос.УстановитьПараметр("ТаблицаИсключений", ТаблицаИсключений); 
	Запрос.УстановитьПараметр("ТекущаяДата",ТекущаяДата());
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДатыЗагрузокДанныхПоТерминалам.Терминал КАК Терминал,
		|	ДатыЗагрузокДанныхПоТерминалам.ДатаЗагрузки КАК ДатаЗагрузки
		|ПОМЕСТИТЬ ВТ_Терминалы
		|ИЗ
		|	РегистрСведений.ДатыЗагрузокДанныхПоТерминалам КАК ДатыЗагрузокДанныхПоТерминалам
		|ГДЕ
		|	НЕ ДатыЗагрузокДанныхПоТерминалам.Обработано
		|	И ДатыЗагрузокДанныхПоТерминалам.ДатаЗагрузки = &ДатаЗагрузки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаИсключений.Контейнер КАК Контейнер,
		|	ТаблицаИсключений.Терминал КАК Терминал
		|ПОМЕСТИТЬ ВТ_Ислючения
		|ИЗ
		|	&ТаблицаИсключений КАК ТаблицаИсключений
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МестонахождениеЧистыйСтокОстатки.Контейнер КАК Контейнер,
		|	МестонахождениеЧистыйСтокОстатки.Терминал КАК Терминал,
		|	МестонахождениеЧистыйСтокОстатки.КоличествоОстаток КАК Количество
		|ПОМЕСТИТЬ ВТ_Остатки
		|ИЗ
		|	РегистрНакопления.МестонахождениеЧистыйСток.Остатки(
		//Евросиб Шевченко А.В. US 129202 TA 132019 03.03.2026
		|			&ДатаОстатков,
		//Евросиб Шевченко А.В. US 129202 TA 132019 03.03.2026
		|			Терминал В
		|				(ВЫБРАТЬ
		|					ВТ_Терминалы.Терминал КАК Терминал
		|				ИЗ
		|					ВТ_Терминалы КАК ВТ_Терминалы)) КАК МестонахождениеЧистыйСтокОстатки
		//Евросиб Шевченко А.В. US 129202 TA 132019 03.03.2026
		|ГДЕ
		|	МестонахождениеЧистыйСтокОстатки.КоличествоОстаток > 0
		//Евросиб Шевченко А.В. US 129202 TA 132019 03.03.2026
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеПоОперациямЧистыйСток.Контейнер КАК Контейнер,
		|	МАКСИМУМ(ДанныеПоОперациямЧистыйСток.ДатаОперации) КАК ДатаОперации
		|ПОМЕСТИТЬ ВТ_МаксимумыАналитика
		|ИЗ
		|	РегистрСведений.ДанныеПоОперациямЧистыйСток КАК ДанныеПоОперациямЧистыйСток
		|ГДЕ
		|	ДанныеПоОперациямЧистыйСток.Контейнер В
		|			(ВЫБРАТЬ
		|				ВТ_Остатки.Контейнер КАК Контейнер
		|			ИЗ
		|				ВТ_Остатки КАК ВТ_Остатки)
		|	И ДанныеПоОперациямЧистыйСток.ДатаОперации <= &ДатаРасхода
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеПоОперациямЧистыйСток.Контейнер
		|;
