		Если СтрокаОпераци.Действие = Перечисления.ДействияСоСтрокамиДанныхПоОперациямЧистыйСток.Перенести Тогда
			СтрокаНакопления.Количество = 1;
		ИначеЕсли СтрокаОпераци.Действие = Перечисления.ДействияСоСтрокамиДанныхПоОперациямЧистыйСток.Сторнировать
			ИЛИ СтрокаОпераци.Действие = Перечисления.ДействияСоСтрокамиДанныхПоОперациямЧистыйСток.Расход Тогда
			СтрокаНакопления.Количество = -1;
		КонецЕсли;
	КонецЦикла;
	
	// + ДИТ Кузнецов Е.Е. US 78754 ТА 98408 06.02.2025
	ЗаполнитьТЧТерминалы(Объект);
	// - ДИТ Кузнецов Е.Е. US 78754 ТА 98408 06.02.2025  
	
	//Евросиб(ДИТ) Антонова А.С. US 105060 ТА 114167 Начало ,.2025
	//Убираем отрицательные остатки по информации от автоподрядчиков 
	//(добавление строки Технической записи прихода, запись в спр Ошибки при загрузке информации от терминалов)    
	ДобавитьТехническуюЗаписьПриходаПоОтрицательнымОстаткамПоИнформацииАвтоподрядчиков(Объект);
	//Евросиб(ДИТ) Антонова А.С. US 105060 ТА 114167 Конец 22.07.2025
	
КонецПроцедуры  

Функция ОбогатитьТаблицуПоКлючам(Знач ТаблицаКОбогащению,ТаблицаМаксимумовПриоритета)
	ТаблицаРезультат = ТаблицаКОбогащению.СкопироватьКолонки();
	Ключи = КлючиОбогащения();
	КолонкиКОбогащению = КолонкиКОбогащению();  
	
	//Обогатим всю коллекцию
	ПрошлаяСтрока = Неопределено;
	Для Каждого СтрокаТЧ Из ТаблицаКОбогащению Цикл
		Если ПрошлаяСтрока = Неопределено Тогда
			ПрошлаяСтрока = СтрокаТЧ;
			Продолжить;
		КонецЕсли;
		Если СтрокаСовпадаетПоКлючам(Ключи,СтрокаТЧ,ПрошлаяСтрока) Тогда
			ОбогатитьСтроку(КолонкиКОбогащению,ПрошлаяСтрока,СтрокаТЧ);
			СтрокаТЧ.ДатаОбновленияИнформации = Макс(ПрошлаяСтрока.ДатаОбновленияИнформации,СтрокаТЧ.ДатаОбновленияИнформации);
			ПрошлаяСтрока = СтрокаТЧ;
		Иначе
			ПрошлаяСтрока = Неопределено;
		КонецЕсли;
	КонецЦикла;
	//Выберем самый высокий приоритет
	Для Каждого МаксПриоритет Из ТаблицаМаксимумовПриоритета Цикл
		Отбор = Новый Структура("ПриходРасход,ДатаОперацииСвязьРасхода,Контейнер,Терминал,Приоритет");
		ЗаполнитьЗначенияСвойств(Отбор,МаксПриоритет);
		ОбогащенныеСтроки = ТаблицаКОбогащению.НайтиСтроки(Отбор);
		Если ОбогащенныеСтроки.Количество() Тогда
			СтрокаРезультата = ТаблицаРезультат.Добавить();
			СтрокаДанных = ОбогащенныеСтроки[ОбогащенныеСтроки.ВГраница()];
			ЗаполнитьЗначенияСвойств(СтрокаРезультата,СтрокаДанных);
		КонецЕсли;
	КонецЦикла;
	Возврат ТаблицаРезультат;
КонецФункции

Процедура ОбогатитьСтроку(КолонкиКОбогащению,ПрошлаяСтрока,ТекущаяСтрока)
	//ПрошлаяСтрока - приоритет ниже
	Для Каждого ИмяКолонки Из КолонкиКОбогащению Цикл
		ПрошлоеЗначение = ПрошлаяСтрока[ИмяКолонки];
		ТекущееЗначение = ТекущаяСтрока[ИмяКолонки];
		Если Не ЗначениеЗаполнено(ТекущееЗначение) Тогда
			ТекущаяСтрока[ИмяКолонки] = ПрошлоеЗначение;
			ТекущаяСтрока.Комбинированная = Истина;
		КонецЕсли;
	КонецЦикла;
	
	//Если ПрошлаяСтрока.ИсточникДобавленияДанных = ПредопределенноеЗначение("Справочник.ИсточникиДанныхЧистогоСтока.ИнформацияОтАвтоподрядчиков")
	//	И ТекущаяСтрока.ИсточникДобавленияДанных = ПредопределенноеЗначение("Справочник.ИсточникиДанныхЧистогоСтока.РучнаяЗагрузка") 
	//	ИЛИ ПрошлаяСтрока.ДанныеИзБД Тогда   
	//Евросиб(ДИТ) Антонова А.С. US 105060 ТА 115174 Начало 18.08.2025
	// Обновляем дату операции только если приоритет текущей строки ниже приоритета предыдущей строки из БД
	//Если ПрошлаяСтрока.ДанныеИзБД Тогда
	Если ПрошлаяСтрока.ДанныеИзБД 
		и ТекущаяСтрока.Приоритет > ПрошлаяСтрока.Приоритет Тогда
	//Евросиб(ДИТ) Антонова А.С. US 105060 ТА 115174 Конец 18.08.2025
		ТекущаяСтрока.ДанныеИзБД = ПрошлаяСтрока.ДанныеИзБД;  
		//Евросиб(ДИТ) Антонова А.С. US 105060 ТА 115174 Начало 21.08.2025
		// дату операции не изменяем при обогащении, записываем в ресурс ДатаОперацииОбогащаемая
		//ТекущаяСтрока.ДатаОперации = ПрошлаяСтрока.ДатаОперации;
		//Евросиб(ДИТ) Антонова А.С. US 105060 ТА 115174 Конец 21.08.2025
		//ТекущаяСтрока.Комбинированная = Истина;
	КонецЕсли;
	//КонецЕсли;
КонецПроцедуры

Функция СтрокаСовпадаетПоКлючам(Ключи,Строка1,Строка2)
	Результат = Истина;
	Для Каждого ИмяКолонки Из Ключи Цикл
		Значение1 = Строка1[ИмяКолонки];
		Значение2 = Строка2[ИмяКолонки];
		Если Значение1 <> Значение2 Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

