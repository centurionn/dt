	мСобств = Новый Массив;
	мСобств.Добавить(Перечисления.ВариантыСобственности.Спот);
	мСобств.Добавить(Перечисления.ВариантыСобственности.СпотДоплатный);
	
	Запрос.УстановитьПараметр("Вывоз", Справочники.ОперацииСВагонами.ВывозКонтейнераСКонтПункта);
	Запрос.УстановитьПараметр("Завоз", Справочники.ОперацииСВагонами.ЗавозНаКонтейнерныйПункт);
	Запрос.УстановитьПараметр("тек_СобственностьКТК", мСобств);
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДата());
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаДетальныеСТерминала = РезультатЗапроса[8].Выбрать();
	ВыборкаДетальныеПодтвержденныеТерминалом = РезультатЗапроса[9].Выбрать();
	ВыборкаДетальныеНеПодтвержденныеТерминалом = РезультатЗапроса[10].Выбрать();
	ВыборкаДетальныеРучнаяЗагрузка = РезультатЗапроса[11].Выбрать();
	ВыборкаДетальныеОдинаковыеСтроки = РезультатЗапроса[13].Выбрать();
	
	Объект.ДанныеИзИсточниковДляЧистогоСтока.Очистить();
	ДатаОбновленияИнформации = ТекущаяДата();
	Пока ВыборкаДетальныеСТерминала.Следующий() Цикл 
		СтрокаТЧ = Объект.ДанныеИзИсточниковДляЧистогоСтока.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ,ВыборкаДетальныеСТерминала);
		СтрокаТЧ.ДатаОбновленияИнформации = ДатаОбновленияИнформации;
	КонецЦикла;
	Пока ВыборкаДетальныеПодтвержденныеТерминалом.Следующий() Цикл
		СтрокаТЧ = Объект.ДанныеИзИсточниковДляЧистогоСтока.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ,ВыборкаДетальныеПодтвержденныеТерминалом);
		СтрокаТЧ.ДатаОбновленияИнформации = ДатаОбновленияИнформации;
	КонецЦикла;
	Пока ВыборкаДетальныеНеПодтвержденныеТерминалом.Следующий() Цикл
		СтрокаТЧ = Объект.ДанныеИзИсточниковДляЧистогоСтока.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ,ВыборкаДетальныеНеПодтвержденныеТерминалом);
		СтрокаТЧ.ДатаОбновленияИнформации = ДатаОбновленияИнформации;
	КонецЦикла;
	Пока ВыборкаДетальныеРучнаяЗагрузка.Следующий() Цикл
		СтрокаТЧ = Объект.ДанныеИзИсточниковДляЧистогоСтока.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ,ВыборкаДетальныеРучнаяЗагрузка);
		СтрокаТЧ.ДатаОбновленияИнформации = ДатаОбновленияИнформации;
	КонецЦикла;  
	
	//Евросиб(ДИТ) Антонова А.С. US 112575 ТА 112632 Начало 25.06.2025
	//для источника от автоподряда переопределяем тип локации по горизонтальной связи на Терминал
