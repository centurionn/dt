		// Добавляем техническую запись прихода для исключения отрицательных остатков
		СтрокаМестонахождение = Объект.МестонахождениеЧистыйСток.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаМестонахождение, ВыборкаСозданиеТехническогоЗавоза);   
		СтрокаМестонахождение.ИдентификаторСтроки = Новый УникальныйИдентификатор; 
		
		НаборИсточника = РегистрыСведений.ИнформацияОтАвтоподрядчиковПоТерминалам.СоздатьНаборЗаписей();
		НаборИсточника.Отбор.Контейнер.Установить(ВыборкаСозданиеТехническогоЗавоза.Контейнер);
		НаборИсточника.Отбор.ДатаОперации.Установить(ВыборкаСозданиеТехническогоЗавоза.ДатаОперацииРасхода);
		НаборИсточника.Отбор.Терминал.Установить(ВыборкаСозданиеТехническогоЗавоза.Терминал);
		НаборИсточника.Прочитать();  
		
		Если НаборИсточника.Количество() = 1 Тогда
			СтрокаИсточника = НаборИсточника[0];  
			Если Не ЗначениеЗаполнено(СтрокаИсточника.ОшибкиПриЗагрузкеИнформацииОтТерминалов) Тогда 
				СправочникОшибки = СоздатьСправочникОшибки(Перечисления.ОшибкиЗагрузкиСтоков.ТерминалНеСообщилОВвозеКТК, Ложь);
				СтрокаИсточника.ОшибкиПриЗагрузкеИнформацииОтТерминалов = СправочникОшибки;
				НаборИсточника.ОбменДанными.Загрузка = Истина;
				НаборИсточника.Записать();
			Иначе
				ДополнитьСправочникОшибки(СтрокаИсточника.ОшибкиПриЗагрузкеИнформацииОтТерминалов, Перечисления.ОшибкиЗагрузкиСтоков.ТерминалНеСообщилОВвозеКТК, Ложь);	
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла; 
	
	ВыборкаСторноТехническогоЗавоза = РезультатыЗапроса[РезультатыЗапроса.ВГраница()].Выбрать();
	
	Пока ВыборкаСторноТехническогоЗавоза.Следующий() Цикл
		// Добавляем техническую запись прихода для исключения отрицательных остатков
		СтрокаМестонахождение = Объект.МестонахождениеЧистыйСток.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаМестонахождение, ВыборкаСторноТехническогоЗавоза);   
		СтрокаМестонахождение.ИдентификаторСтроки = Новый УникальныйИдентификатор; 
	КонецЦикла;  
	
	Объект.МестонахождениеЧистыйСток.Сортировать("Количество Убыв");

КонецПроцедуры

//Евросиб(ДИТ) Антонова А.С. US 105060 ТА 115174 Начало 18.08.2025
Процедура УбратьСторнированиеПодтвержденныхСтрокАвтоподрядчиков(ДанныеИзИсточников)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПереносДанныхВЧистыйСтокДанныеИзИсточниковДляЧистогоСтока.Контейнер КАК Контейнер,
		|	ПереносДанныхВЧистыйСтокДанныеИзИсточниковДляЧистогоСтока.Терминал КАК Терминал,
		|	ПереносДанныхВЧистыйСтокДанныеИзИсточниковДляЧистогоСтока.Состояние КАК Состояние,
		|	ПереносДанныхВЧистыйСтокДанныеИзИсточниковДляЧистогоСтока.ДатаОперации КАК ДатаОперации,
		|	ПереносДанныхВЧистыйСтокДанныеИзИсточниковДляЧистогоСтока.ИсточникДобавленияДанных КАК ИсточникДобавленияДанных,
		|	ПереносДанныхВЧистыйСтокДанныеИзИсточниковДляЧистогоСтока.ТипОперации КАК ТипОперации
		|ПОМЕСТИТЬ ВТ_ВходящиеДанныеТерминалов
		|ИЗ
		|	&ПереносДанныхВЧистыйСтокДанныеИзИсточниковДляЧистогоСтока КАК ПереносДанныхВЧистыйСтокДанныеИзИсточниковДляЧистогоСтока
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МестонахождениеЧистыйСтокОбороты.Регистратор КАК Регистратор,
		|	МестонахождениеЧистыйСток.Период КАК ДатаОперации,
		|	МестонахождениеЧистыйСток.Контейнер КАК Контейнер,
		|	МестонахождениеЧистыйСток.Терминал КАК Терминал
		|ИЗ
		|	ВТ_ВходящиеДанныеТерминалов КАК ВТ_ВходящиеДанныеТерминалов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.МестонахождениеЧистыйСток.Обороты(
		|				,
		|				,
		|				Регистратор,
		|				(Контейнер, Терминал) В
		|					(ВЫБРАТЬ
		|						Т.Контейнер,
		|						Т.Терминал
		|					ИЗ
		|						ВТ_ВходящиеДанныеТерминалов КАК Т)) КАК МестонахождениеЧистыйСтокОбороты
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.МестонахождениеЧистыйСток КАК МестонахождениеЧистыйСток
		|			ПО (МестонахождениеЧистыйСток.Регистратор = МестонахождениеЧистыйСтокОбороты.Регистратор)
		|				И МестонахождениеЧистыйСтокОбороты.Контейнер = МестонахождениеЧистыйСток.Контейнер
		|				И МестонахождениеЧистыйСтокОбороты.Терминал = МестонахождениеЧистыйСток.Терминал
		|		ПО ВТ_ВходящиеДанныеТерминалов.Контейнер = МестонахождениеЧистыйСтокОбороты.Контейнер
		|			И ВТ_ВходящиеДанныеТерминалов.Терминал = МестонахождениеЧистыйСтокОбороты.Терминал
		|			И (ВЫБОР
		|				КОГДА ВТ_ВходящиеДанныеТерминалов.ТипОперации = ЗНАЧЕНИЕ(Справочник.ОперацииСВагонами.ЗавозНаКонтейнерныйПункт)
		|					ТОГДА МестонахождениеЧистыйСтокОбороты.КоличествоПриход = -1
		|				ИНАЧЕ МестонахождениеЧистыйСтокОбороты.КоличествоРасход = -1
		|			КОНЕЦ)
		|			И (ВТ_ВходящиеДанныеТерминалов.ДатаОперации МЕЖДУ ДОБАВИТЬКДАТЕ(МестонахождениеЧистыйСтокОбороты.Период, ЧАС, -1) И ДОБАВИТЬКДАТЕ(МестонахождениеЧистыйСтокОбороты.Период, ЧАС, 1))
		|ГДЕ
		|	МестонахождениеЧистыйСток.ИсточникДобавленияДанных = ЗНАЧЕНИЕ(Справочник.ИсточникиДанныхЧистогоСтока.ТехническаяЗапись)
		|	И ТИПЗНАЧЕНИЯ(МестонахождениеЧистыйСтокОбороты.Регистратор) = ЗНАЧЕНИЕ(Документ.РедактированиеДанныхЧистогоСтока)";
	
	Запрос.УстановитьПараметр("ПереносДанныхВЧистыйСтокДанныеИзИсточниковДляЧистогоСтока", ДанныеИзИсточников);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ДокРедактирования = Выборка.Регистратор.ПолучитьОбъект(); 
		Для каждого РегистрДвижения Из ДокРедактирования.Движения Цикл
			Если ТипЗнч(РегистрДвижения) = Тип("РегистрНакопленияНаборЗаписей.МестонахождениеЧистыйСток") Тогда
				РегистрДвижения.Записать();
			КонецЕсли;	
		КонецЦикла;  
		ДокРедактирования.Движения.МестонахождениеЧистыйСток.Записывать = Истина;
		ДокРедактирования.Записать();   
		
		//в РС ИнформацияОтАвтоподрядчиковПоТерминалам делаем пометку, что не требуется подтверждение
		НЗ = РегистрыСведений.ИнформацияОтАвтоподрядчиковПоТерминалам.СоздатьНаборЗаписей();
		НЗ.Отбор.ДатаОперации.Установить(Выборка.ДатаОперации); 
		НЗ.Отбор.Терминал.Установить(Выборка.Терминал);
		НЗ.Отбор.Контейнер.Установить(Выборка.Контейнер);   
		НЗ.Прочитать();
		Для каждого СтрокаНЗ Из НЗ Цикл
			СтрокаНЗ.ТребуетсяПодтверждениеОперацииАвтоподрядчика = Ложь;
		КонецЦикла;
		НЗ.ОбменДанными.Загрузка = Истина;
		НЗ.Записать();
		
		//Убираем ошибку при загрузке информации от терминалов из записей от автоперевозчика
		НаборИсточника = РегистрыСведений.ИнформацияОтАвтоподрядчиковПоТерминалам.СоздатьНаборЗаписей();
		НаборИсточника.Отбор.Контейнер.Установить(Выборка.Контейнер);
		НаборИсточника.Отбор.ДатаОперации.Установить(Выборка.ДатаОперации);
		НаборИсточника.Отбор.Терминал.Установить(Выборка.Терминал);
		НаборИсточника.Прочитать();
		
		Если НаборИсточника.Количество() = 1 Тогда
			СтрокаИсточника = НаборИсточника[0];  
			Если ЗначениеЗаполнено(СтрокаИсточника.ОшибкиПриЗагрузкеИнформацииОтТерминалов) Тогда 
				ОбъектОшибки = СтрокаИсточника.ОшибкиПриЗагрузкеИнформацииОтТерминалов.ПолучитьОбъект();  
				ОбъектОшибки.ВсеОшибкиИсправлены = Истина;   
				Для каждого СтрОшибки Из ОбъектОшибки.ОшибкиПриЗагрузке Цикл
					СтрОшибки.Комментарий = "Запись подтверждена информацией от терминала";
				КонецЦикла;
				ОбъектОшибки.Записать();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

