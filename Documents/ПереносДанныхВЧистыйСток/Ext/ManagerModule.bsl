		|		ПО (ВТ_ПодборТерминалаИзПрочихДанных.Контейнер = ВТ_ОбрабатываемыеСтроки.Контейнер)
		|			И (ВТ_ПодборТерминалаИзПрочихДанных.Состояние = ВТ_ОбрабатываемыеСтроки.Состояние)
		|			И (ВТ_ПодборТерминалаИзПрочихДанных.ДатаОперации = ВТ_ОбрабатываемыеСтроки.ДатаОперации)
		|			И (ВТ_ПодборТерминалаИзПрочихДанных.ТипОперации = ВТ_ОбрабатываемыеСтроки.ТипОперации)
		|			И (ВТ_ПодборТерминалаИзПрочихДанных.Терминал1 = ВТ_ОбрабатываемыеСтроки.Терминал)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТерминалыСтанций КАК ВТ_ТерминалыСтанций
		|		ПО ВТ_ОбрабатываемыеСтроки.Терминал = ВТ_ТерминалыСтанций.ЖДСтанция";
	Запрос.УстановитьПараметр("ДанныеИзИсточниковДляЧистогоСтока", Объект.ДанныеИзИсточниковДляЧистогоСтока.Выгрузить());
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	СтруктураПоискаСтроки = Новый Структура("Контейнер,Состояние,ДатаОперации,ТипОперации");
	Пока Выборка.Следующий() Цикл         
		
		ЗаполнитьЗначенияСвойств(СтруктураПоискаСтроки, Выборка);
		КорректируемыеСтроки = Объект.ДанныеИзИсточниковДляЧистогоСтока.НайтиСтроки(СтруктураПоискаСтроки);    
		Для каждого КорректируемаяСтрока Из КорректируемыеСтроки Цикл
			Если Выборка.Терминал = "УдалитьСтроку" Тогда
				Объект.ДанныеИзИсточниковДляЧистогоСтока.Удалить(КорректируемаяСтрока);	
			Иначе
				КорректируемаяСтрока.Терминал = Выборка.Терминал;
			КонецЕсли;
		КонецЦикла; 
		
	КонецЦикла;

КонецФункции 

