&НаСервере
Процедура РасчетТарифаНаСервере()
	
	//Добавить предупреждение      	
	Объект.ОтправкиУслугиПоГрузам.Очистить();
	
	Для каждого СтрокаОтправки Из Объект.Отправки Цикл 
		
		РасчитатьТарифИОхрану(СтрокаОтправки);
		  		
	КонецЦикла; 

	
КонецПроцедуры

&НаСервере
Процедура РасчитатьТарифИОхрану(СтрокаОтправки)
	
	Тоннажность = СтрокаОтправки.ФутовостьДляКонтейнеров;
	РазмерКонт = 12;
	Если СтрокаОтправки.ФутовостьДляКонтейнеров = 40 тогда 		
		Тоннажность = 30;
		РазмерКонт = 12;
	ИначеЕсли   СтрокаОтправки.ФутовостьДляКонтейнеров = 30 Тогда
		Тоннажность = 24;
		РазмерКонт = 6;
	ИначеЕсли   СтрокаОтправки.ФутовостьДляКонтейнеров = 20 Тогда
		Тоннажность = 24;
		РазмерКонт = 6;
	КонецЕсли;
	
	
	
	ТекстЗапроса = "<getCalcDue> 	
	|<invFromCountryCode value=""" + Объект.СтранаОтправленияКод + """/>
	|<invFromPortCode value=""37786""/>
	|<invFromStationCode value=""" + Объект.СтанцияОтправленияКод + """/>
	//|<invLoadAssetsID value=""" +  + """/>
	|<invPayFormID value=""12""/>                                                     
	|<invPayPlaceID value=""3""/>                                                      
	|<invPayPlaceRwCode value=""39""/>
	|<invPlanCarCount value=""" + СтрокаОтправки.КоличествоВагоновКонтейнеров + """/>
	|<invPlanCarOwnerTypeID value=""" + ?(СтрокаОтправки.ТипСобственностиВагоновДляКонтейнеровИД = 0,1,СтрокаОтправки.ТипСобственностиВагоновДляКонтейнеровИД) + """/>
	|<invPlanCarTypeID value=""" + СтрокаОтправки.ВидПодвижногоСостава.КодВагонаДляПровознойПлаты + """/>
	|<invPlanContCount value=""" + СтрокаОтправки.КоличествоВагоновКонтейнеров + """/>
	|<invPlanContOwnerTypeID value=""1""/>
	|<invContPlanSizeBig value=""" + РазмерКонт + """/>
	|<invPlanContTonnage value=""" + Тоннажность + """/>";
	
	Если  не СтрокаОтправки.Грузополучатель = Неопределено Тогда
		
		ТекстЗапроса = ТекстЗапроса + "|<invRecipID value=""" + СтрокаОтправки.Грузополучатель.Код + """/>
		|<invRecipAddressID value=""" + СтрокаОтправки.Грузополучатель.АдресИД + """/>
		|<invRecipOKPO value=""" + СтрокаОтправки.Грузополучатель.ОКПО + """/>
		|<invRecipTGNL value=""" + СтрокаОтправки.Грузополучатель.ТГНЛ + """/>";
		
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + 
	"|<invSendKindID value=""" + Объект.ВидОтправкиИД + """/>
	|<invSendSpeedID value=""2""/>
	|<invToCountryCode value=""" + СтрокаОтправки.СтранаНазначенияКод + """/>
	|<invToStationCode value=""" + СтрокаОтправки.СтанцияНазначенияКод + """/>
	|<invFreight>
	|<freightGNGID2001 value=""" + СтрокаОтправки.ГрузПоГНГКод + """/>
	//|<freightGNGCode value=""" + СтрокаОтправки.ГрузПоГНГКод + """/>
	|<freightPackTypeID value=""" + СтрокаОтправки.ВидУпаковки.Код + """/>
	|<freightWeight value=""" + Формат(СтрокаОтправки.ВесГрузаВТоннах ,"ЧГ = 0") + """/>  
	|<freightCode value=""" + СтрокаОтправки.ГрузПоЕТСНГкод + """/>
	|</invFreight>";
	
	Если Объект.Охрана Тогда
		
		ТекстЗапроса = ТекстЗапроса + 
		"|<invSPC>
		|<spcTranspClauseID value=""398""/>
		|<spcCustomText value=""1""/>
		|</invSPC>";
		
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + 
	"|</getCalcDue>"; 
	
	
	
	Результат = э_ОбщиеСервер.ПолучитьОтветНаЗапрос(ТекстЗапроса);
	
	
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(Результат);
	
	
	Объект.Ошибки = "";
	Если Найти(Результат,"errorMessage") > 0 Тогда
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(Результат);		
		Пока ЧтениеXML.Прочитать() Цикл
			Если ЧтениеXML.Имя = "errorMessage" Тогда
				Объект.Ошибки = ЧтениеXML.ПолучитьАтрибут("value");	
				продолжить;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	
	
	Тариф = 0;
	ТарифНДС = 0;
	
	Охрана = 0;
	ОхранаНДС = 0;
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.Имя = "dueTypeID" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ТипРасчета = Число(ЧтениеXML.ПолучитьАтрибут("value"));			
		КонецЕсли;
		
		
		 //тариф
		Если ЧтениеXML.Имя = "dueSumInfr" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента и ТипРасчета = 1 Тогда 
			 Тариф = Число(ЧтениеXML.ПолучитьАтрибут("value"));
		КонецЕсли;
		
		//Охрана
		Если ЧтениеXML.Имя = "dueAmount" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента и ТипРасчета = 4 Тогда
			Охрана = Число(ЧтениеXML.ПолучитьАтрибут("value"));
		КонецЕсли;
	    
		
		Если ЧтениеXML.Имя = "dueTaxSum" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			Если ТипРасчета = 1 тогда
				ТарифНДС = Число(ЧтениеXML.ПолучитьАтрибут("value"));
			ИначеЕсли ТипРасчета = 4  тогда
				ОхранаНДС = Число(ЧтениеXML.ПолучитьАтрибут("value"));
			КонецЕсли; 	
			
		КонецЕсли; 
		
		Если ЧтениеXML.Имя = "dueTaxVal" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			Если ТипРасчета = 1  тогда
				ТарифСтавкаНДС = Число(ЧтениеXML.ПолучитьАтрибут("value"));
			ИначеЕсли ТипРасчета = 4  тогда
				ОхранаСтавкаНДС = Число(ЧтениеXML.ПолучитьАтрибут("value"));
			КонецЕсли; 	
			
		КонецЕсли; 
		
	КонецЦикла; 
	
		ВсегоТариф =  Тариф + ТарифНДС;		
		Если ВсегоТариф <> 0 Тогда  
				НовСтрокаУслугТариф = Объект.ОтправкиУслугиПоГрузам.Добавить();
				НовСтрокаУслугТариф.НомерОтправки = СтрокаОтправки.НомерСтроки; 
				НовСтрокаУслугТариф.Сумма = Тариф;
				НовСтрокаУслугТариф.СуммаНДС = ТарифНДС;
				НовСтрокаУслугТариф.СуммаСНДС = ВсегоТариф;
				НовСтрокаУслугТариф.СтавкаНДС = СтавкаНДСПеречисление(Строка(ТарифСтавкаНДС)); 
		КонецЕсли;
		
		ВсегоОхрана =  Охрана + ОхранаНДС;		
		Если ВсегоОхрана <> 0 Тогда  
				НовСтрокаУслугОхрана = Объект.ОтправкиУслугиПоГрузам.Добавить();
				НовСтрокаУслугОхрана.НомерОтправки = СтрокаОтправки.НомерСтроки; 
				НовСтрокаУслугОхрана.Сумма = Охрана;
				НовСтрокаУслугОхрана.СуммаНДС = ОхранаНДС;
				НовСтрокаУслугОхрана.СуммаСНДС = ВсегоОхрана;
				НовСтрокаУслугОхрана.СтавкаНДС = СтавкаНДСПеречисление(Строка(ОхранаСтавкаНДС)); 
		КонецЕсли;   
	           
	
КонецПроцедуры

Процедура ЗаполнитьСоответствиеСтавокНДС(Соответствие) 
	
	Соответствие.Вставить("0",       Перечисления.СтавкиНДС.НДС0);
	Соответствие.Вставить("10",      Перечисления.СтавкиНДС.НДС10);
	Соответствие.Вставить("18",      Перечисления.СтавкиНДС.НДС18);
	Соответствие.Вставить("10/110",  Перечисления.СтавкиНДС.НДС10_110);
	Соответствие.Вставить("18/118",  Перечисления.СтавкиНДС.НДС18_118);
	Соответствие.Вставить("без НДС", Перечисления.СтавкиНДС.БезНДС);
	// Евросиб(ДИТ) US 96051 ТА 96052 Сержантова А.С. Начало: 25.12.2024
	Соответствие.Вставить("5",      Перечисления.СтавкиНДС.НДС5);
	Соответствие.Вставить("5/105",  Перечисления.СтавкиНДС.НДС5_105);
	Соответствие.Вставить("7",      Перечисления.СтавкиНДС.НДС7);
	Соответствие.Вставить("7/107",  Перечисления.СтавкиНДС.НДС7_107);
	// Евросиб(ДИТ) US 96051 ТА 96052 Сержантова А.С. Конец: 25.12.2024
	//Евросиб СубботинВ #125845 09.12.2025 Начало
	Соответствие.Вставить("22",      Перечисления.СтавкиНДС.НДС2);
	Соответствие.Вставить("22/122",  Перечисления.СтавкиНДС.НДС22_122);
	//Евросиб СубботинВ #125845 09.12.2025 Конец
	
КонецПроцедуры

Функция СтавкаНДСПеречисление(СтавкаНДС) 
	
	Соответствие = Новый Соответствие;
	ЗаполнитьСоответствиеСтавокНДС(Соответствие);
	
	Для Каждого КлючИЗначение Из Соответствие Цикл
		Если КлючИЗначение.Ключ = СтавкаНДС Тогда
			Возврат КлючИЗначение.Значение;			
		КонецЕсли;
	КонецЦикла;
	
	Возврат Перечисления.СтавкиНДС.ПустаяСсылка();
	
КонецФункции



