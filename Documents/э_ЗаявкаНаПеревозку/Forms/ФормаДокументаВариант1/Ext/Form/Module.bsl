
&НаСервере
Процедура ПлательщикПриИзмененииНаСервере(Плательщик)
	
	Для каждого Строка Из Объект.Плательщики Цикл
		ЗаполнитьЗначенияСвойств(Строка,Плательщик);
		Строка.Плательщик = Плательщик;		
	КонецЦикла;
	
		
	КонецПроцедуры

&НаКлиенте
Процедура ПлательщикПриИзменении(Элемент)
	ПлательщикПриИзмененииНаСервере(Объект.Плательщик);
КонецПроцедуры
&НаКлиенте
Процедура СоздатьЗаявку(Команда)  	
	
	Если Модифицированность и ЗначениеЗаполнено(Объект.Плательщик) Тогда
		ПлательщикПриИзмененииНаСервере(Объект.Плательщик);
	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.ИДЗаявки) Тогда
		Возврат;
	КонецЕсли;
	
		
	ЗаполнитьКодыПоСсылкам();
	
	
	
	СоздатьЗаявкуВДокументе();
//Временно, пока регист работает с ошибкой
	//ЗадатьВопрос(Команда);
	
КонецПроцедуры


&НаСервере
&НаСервере
Процедура СоздатьЗаявкуВДокументе() 
	
	ДокОбъект = ДанныеФормыВЗначение(объект,Тип("ДокументОбъект.э_ЗаявкаНаПеревозку"));
	
	КодЗапроса = Сред(ТекущаяДата(),4,2) + Лев(ТекущаяДата(),2)+ Час(ТекущаяДата()) + Минута(ТекущаяДата());

	МакетНастроек = Обработки.э_Макеты.ПолучитьМакет("э_ЗаявкаНаПеревозку");
	СоответствиеТаблиц = э_ОбщиеСервер.ПолучитьСоответствиеТаблицОбъекта(МакетНастроек);
	Перевод = э_ОбщиеСервер.ПолучитьСоответствиеПереводРеквизитовОбъекта(МакетНастроек,1);
	ТекстЗапроса = э_ОбщиеСервер.ЗаполнитьXMLИзОбъекта(ДокОбъект,СоответствиеТаблиц,Перевод,МакетНастроек);
	ТекстЗапроса =
	//<!-- ********************************** -->
	//<!-- ПОДАЧА ЗАЯВКИ НА ПЕРЕВОЗКУ: запрос -->
	//<!-- ********************************** -->
	"<claimAgreement version=""1.0"">" +
	
	//Если не ЗначениеЗаполнено(ДокОбъект.ИДЗаявки) Тогда
	//	
	//	ТекстЗапроса = ТекстЗапроса + "<frontEndId value=" + КодЗапроса +"/>";
	//	
	//КонецЕсли;

	ТекстЗапроса 
	////<!-- Формировать заявку только до отправок включительно - не использовать данные блоков маршрутов, графиков подач и плательщиков -->
	//+ "<notFullClaim/>"
	//<!-- Использование 6-значных кодов станций и грузов в ответе -->
	+ "<useMod11/>"
	//<!-- Расчет графика подач(если не указан график подач и способ подачи не по датам) -->
	+ "<useCalcGraphPod/>"
	//<!-- Выдавать данные подписи ЭЦП -->
	+ "<useECP/>"
	//<!-- Не переводить состояние заявки в согласовано -->
	+ "<notState/>"
	//<!-- Не возвращать данные о накладных по заявке. -->
	+ "<notGetInv/>"
	//<!-- Выдавать список некритических ошибок-->
	//<!-- * тип данных: строка -->
	+ "<useWarning/>"
	+ "</claimAgreement>";
	
	
	РезультатЗапроса = э_ОбщиеСервер.ПолучитьОтветНаЗапрос(ТекстЗапроса);
	
			ПозицияИД = Найти(РезультатЗапроса,"claimID value");
			ПозицияОшибки = Найти(РезультатЗапроса,"errorMessage value=");   
			
			Если ПозицияИД > 0 или ПозицияОшибки > 0 Тогда
				
				Если ПозицияИД > 0  Тогда  
					ИДНакладной = Сред(РезультатЗапроса,ПозицияИД+14,9);
					ДокОбъект.ИДЗаявки = ИДНакладной; 
					
					э_ОбщиеСервер.ЗаполнитьДокументЗаявкаНаПеревозкуПриВыгрузке(РезультатЗапроса	,Ложь,"",ТекущаяДата(),ТекущаяДата(),ТекущаяДата(),ДокОбъект);
					
					
				ИначеЕсли ПозицияОшибки > 0  Тогда 				
					КонецОшибки  = Найти(РезультатЗапроса,"errorStatusCode value=");
					
					Если КонецОшибки > 0  Тогда 
						ДокОбъект.Ошибки = Сред(РезультатЗапроса,ПозицияОшибки+19,КонецОшибки - ПозицияОшибки - 24);
					КонецЕсли; 			
					
				КонецЕсли;
				
			КонецЕсли;
			
		ЗначениеВДанныеФормы(ДокОбъект,Объект);	
	
КонецПроцедуры

&НаСервере
Функция СоздатьЗаявкуНаСервере()
	
	 
	
	СтруктураДокумента = Новый Структура;
	
	Для каждого Реквизит Из Объект.Ссылка.Метаданные().Реквизиты Цикл
		СтруктураДокумента.Вставить(Реквизит.Имя);	
	КонецЦикла;
	
	СтруктураДокумента.Вставить("Ссылка", Объект.Ссылка);
	СтруктураДокумента.Вставить("Номер", Объект.Номер);
	СтруктураДокумента.Вставить("Дата", Объект.Дата);
	
	ЗаполнитьЗначенияСвойств(СтруктураДокумента, Объект); 
	 
	ПараметрыВыполненияВФоне = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполненияВФоне.ЗапуститьВФоне = Истина;
	ПараметрыВыполненияВФоне.КлючФоновогоЗадания = "ВыгрузкаЗаявкиВЭТРАН";
	ПараметрыВыполненияВФоне.НаименованиеФоновогоЗадания = НСтр("ru = 'Выгрузка заявки в ЭТРАН.'");
	РезультатДлительнойОперации = ДлительныеОперации.ВыполнитьВФоне("э_ОбщиеСервер.СоздатьЗаявку", СтруктураДокумента, ПараметрыВыполненияВФоне);

	
	
КонецФункции

&НаСервере
Процедура ДобавитьВОчередьЗапросовНаСервере()
	
	//Добавить = Ложь;
	
	Для каждого Строка из Объект.invoice Цикл 
		
		ТекПользователь = ПараметрыСеанса.ТекущийПользователь.Наименование;
		
		НаборЗаписей = РегистрыСведений.э_ЭТРАН_ОчередьЗапросовКЭтрану.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Пользователь.Установить(ТекПользователь);
		НаборЗаписей.Отбор.ТипЗапроса.Установить(Перечисления.э_ИменаЗапросов.ЗапросДанныхНакладной);
		НаборЗаписей.Отбор.Документ.Установить(Документы.э_ЭТРАН_ЭлектроннаяНакладная.ПустаяСсылка()); 
		НаборЗаписей.Отбор.НомерДокумента.Установить(Строка.invNumber);
		
		НаборЗаписей.Прочитать();
		
		Для каждого Запись из НаборЗаписей Цикл 		
			Если Запись.Обработан тогда
				//Перезаписываем накладную	
				Запись.Ответ = "";
				Запись.Обработан = Ложь; 			
				//Добавить = Истина;
				Сообщить("Повторный запрос по накладной: " + Запись.НомерДокумента);
			КонецЕсли;   		
		КонецЦикла;
		
		
		Если НаборЗаписей.Количество() = 0 тогда
			Запись = НаборЗаписей.Добавить();
			Запись.Документ  = Документы.э_ЭТРАН_ЭлектроннаяНакладная.ПустаяСсылка();
			Запись.ТипЗапроса = Перечисления.э_ИменаЗапросов.ЗапросДанныхНакладной;
			Запись.Пользователь = ТекПользователь;
			Запись.НомерДокумента = Строка.invNumber;
			Запись.НомерНакладной = Строка.invNumber;
			Запись.Обработан = Ложь;
		КонецЕсли;
		
		
		
		
		Для Каждого Запись Из НаборЗаписей Цикл
			Запись.Запрос = "<getInvoice version=""1.0"">
			|<invNumber value=""" + Строка.invNumber  + """/>
			|<useMod11/>
			|</getInvoice>";
			Запись.ДатаЗаписи = ТекущаяДата();
			//Запись. = ;
			//Запись. = ;
		КонецЦикла;
		
		Попытка
			НаборЗаписей.Записать();
			Объект.invoice.Очистить();
		Исключение
			Сообщить("Не Удалось накладную поставить в очередь запросов к этрану!");
		КонецПопытки;
		
		
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадатьВопрос(Команда)    
	
	Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопрос",ЭтотОбъект); // Прописываем название процедуры-обработчика.
	
	ПоказатьВопрос(Оповещение, "Выгрузить ГУ-12 в ЭТРАН?", РежимДиалогаВопрос.ОКОтмена,0, КодВозвратаДиалога.ОК, "Выгрузка заявки в ЭТРАН?");
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопрос(Результат, Параметры) Экспорт
	Если НетЗапущеныхРанееЗаданий("ВыгрузкаЗаявкиВЭТРАН") Тогда	
		Если Результат = КодВозвратаДиалога.Ок Тогда  		
			Если Модифицированность Тогда
				ЗаполнитьКодыПоСсылкам();
			КонецЕсли;
			Сообщить("Начало выгрузки заявки");
			СоздатьЗаявкуНаСервере();
			Подключаемый_ПроверитьВыполнениеЗадания();
		Иначе                             		
			Сообщить("Документ не создан!");
		КонецЕсли;
	Иначе
		Сообщить("Дождитесь завершения предыдущего вызова");
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКодыПоСсылкам()  

	Объект.ВидСообщенияИД = Объект.ВидСообщения.Код;	
	Объект.ВидОтправкиИД = Объект.ВидОтправки.Код;
	Объект.СтранаОтправленияКод = ?(Объект.СтранаОтправления.Код="","643",Объект.СтранаОтправления.Код);
	Объект.СтанцияОтправленияКод = Объект.СтанцияОтправления.э_СтанцияКод;
	Объект.СтанцияВходаВРоссиюКод = Объект.СтанцияВходаВРоссию.э_СтанцияКод;

	Объект.ТипСобственностиВагоновИД = Объект.ТипСобственностиВагонов.Код;
	Объект.ГрузоотправительОКПО = Объект.Грузоотправитель.ОКПО;
	Объект.ГрузоотправительИД = Объект.Грузоотправитель.Код;
	Объект.ГрузоотправительАдресИД = Объект.Грузоотправитель.АдресИД;
	Объект.ГрузоотправительТГНЛ = Объект.Грузоотправитель.ТГНЛ;
	Объект.СпособПодачиИД = Объект.СпособПодачи.Код;
	
	Если Объект.ГруппаГруза = "" Тогда 
		Объект.ГруппаГруза = "41";
	КонецЕсли;
	
	Если Объект.ТипСогласованияСВладельцемПодъездногоПути = "" Тогда 
		Объект.ТипСогласованияСВладельцемПодъездногоПути = "1";
	КонецЕсли;

	Объект.ВладелецПодъездногоПутиИД = Объект.ВладелецПодъездногоПути.Код;

	
	Для Каждого Строка из Объект.Отправки Цикл                
		Строка.НомерОтправки = Строка.НомерСтроки;
		Строка.ВидОтправкиИД = Строка.ВидОтправки.Код;
		Строка.ВидПодвижногоСоставаИД = Строка.ВидПодвижногоСостава.Код;
		Строка.ВидУпаковкиИД = Строка.ВидУпаковки.Код;
		
		//Строка.НовыйВидПодвижногоСоставаКод = Строка.НовыйВидПодвижногоСостава.ИДWAGTYPE;
		//Строка.ВладелецВагонаИД = Строка.;
		//Строка.ВладелецКонтейнераИД = Строка;
		
		Если ЗначениеЗаполнено(Строка.Грузополучатель) Тогда
			Строка.ГрузополучательИД = Строка.Грузополучатель.Код;
			Строка.ГрузополучательОКПО = Строка.Грузополучатель.ОКПО;
		КонецЕсли;
		
		//Строка.ГрузополучательАдрес = Строка.Грузополучатель.Адрес;
		//Строка.ГрузополучательТГНЛ = Строка.Грузополучатель.ТГНЛ;
		Строка.ГрузПоГНГКод = Строка.ГрузПоГНГ.Код;
		Строка.ГрузПоЕТСНГКод = Строка.ГрузПоЕТСНГ.Код;
		Строка.ТипСобственностиВагоновДляКонтейнеровИД = Строка.ТипСобственностиВагоновДляКонтейнеров.Код; 
		Строка.СтанцияНазначенияКод = Строка.СтанцияНазначения.э_СтанцияКод;
		Строка.СтанцияВыходаИзРоссииКод = Строка.СтанцияВыходаИзРоссии.э_СтанцияКод;
		Строка.ГрузПоГНГНаименование = Строка.ГрузПоГНГ.Наименование;
		Строка.ГрузНаименование = Строка.ГрузПоЕТСНГ.Наименование;
		Строка.ВладелецВагонаИД = Строка.ВладелецВагона.Код;
		Строка.ВидУпаковкиИД = Строка.ВидУпаковки.Код;
		Строка.СтранаНазначенияКод = Строка.СтранаНазначения.Код;
	КонецЦикла;                                                                 
	
	Для Каждого Строка из Объект.Плательщики Цикл
		
		//Строка.ПлательщикИД = Строка.Плательщик.Код;
		////Строка.ПлательщикКод = Строка.Плательщик.Код;
		//Строка.ПлательщикОКПО = Строка.Плательщик.ОКПО;
		//Строка.ПлательщикАдрес = Строка.Плательщик.Адрес;
		//Строка.ПлательщикИД = Строка.Плательщик.Код;
		//Строка.ПлательщикКод = Строка.Плательщик.ЕЛС;

	КонецЦикла;                                         
	
	
КонецПроцедуры                                           

