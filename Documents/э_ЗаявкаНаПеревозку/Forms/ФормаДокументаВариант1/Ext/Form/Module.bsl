&НаКлиенте
Процедура ОтправкиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	СтандартнаяОбработка = Ложь;
	ПараметрыФ = Новый Структура;    
		
	ПараметрыФ.Вставить("ВидОтправки",Элемент.ТекущиеДанные.ВидОтправки);
	ПараметрыФ.Вставить("ВидПодвижногоСостава",Элемент.ТекущиеДанные.ВидПодвижногоСостава);
	ПараметрыФ.Вставить("ВидУпаковки",Элемент.ТекущиеДанные.ВидУпаковки);
	ПараметрыФ.Вставить("ВладелецКонтейнера",Элемент.ТекущиеДанные.ВладелецКонтейнера);
	ПараметрыФ.Вставить("ГрузПоГНГ",Элемент.ТекущиеДанные.ГрузПоГНГ);
	ПараметрыФ.Вставить("ГрузПоГНГ2001",Элемент.ТекущиеДанные.ГрузПоГНГ2001);
	ПараметрыФ.Вставить("КоличествоВагоновКонтейнеров",Элемент.ТекущиеДанные.КоличествоВагоновКонтейнеров);
	ПараметрыФ.Вставить("НовыйВидПодвижногоСостава",Элемент.ТекущиеДанные.НовыйВидПодвижногоСостава);
	ПараметрыФ.Вставить("СтанцияНазначения",Элемент.ТекущиеДанные.СтанцияНазначения);
	ПараметрыФ.Вставить("СтранаНазначения",Элемент.ТекущиеДанные.СтранаНазначения);
	ПараметрыФ.Вставить("ТипСобственностиВагоновДляКонтейнеров",Элемент.ТекущиеДанные.ТипСобственностиВагоновДляКонтейнеров);
	ПараметрыФ.Вставить("ГрузПоЕТСНГ",Элемент.ТекущиеДанные.ГрузПоЕТСНГ);
	

	ОткрытьФорму("Документ.э_ЗаявкаНаПеревозку.Форма.ФормаОтправки",ПараметрыФ,ЭтаФорма,Новый УникальныйИдентификатор,,,Новый ОписаниеОповещения("СписокОтправокПередНачаломДобавленияЗавершение",));
			
	Отказ = Истина;
	
	
КонецПроцедуры

