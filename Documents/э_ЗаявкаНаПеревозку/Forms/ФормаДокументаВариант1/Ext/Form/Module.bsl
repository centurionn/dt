&НаКлиенте
Процедура ТабличнаяЧастьВыбор(ИмяТабличнойЧасти)
	Оповещение 					= Новый ОписаниеОповещения("ЗавершениеРедактированияСтроки", ЭтотОбъект);
	ТекущаяСтрокаТабличнойЧасти = Элементы[ИмяТабличнойЧасти].ТекущиеДанные;
	МассивРеквизитов 			= ПередНачаломДобавленияПолучитьСтруктуруРеквизитов(ИмяТабличнойЧасти);
	Для Каждого Реквизит из МассивРеквизитов Цикл
		Реквизит.Значение = ТекущаяСтрокаТабличнойЧасти[Реквизит.Имя];	
	КонецЦикла;
	Если ИмяТабличнойЧасти =  "Плательщики" Тогда
		ОткрытьФорму("Документ.э_ЗаявкаНаПеревозку.Форма.ФормаРедактированияПлательщика", Новый Структура("Действие, ИмяТабличнойЧасти, МассивРеквизитов", "Редактирование", ИмяТабличнойЧасти, МассивРеквизитов), ЭтаФорма, Новый УникальныйИдентификатор,,, Оповещение);
	ИначеЕсли ИмяТабличнойЧасти =  "Отправки" Тогда
		МассивРеквизитов.Добавить(Новый Структура("Имя, Тип, Синоним, Значение", "НомерСтроки", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10)), "Номер строки", ТекущаяСтрокаТабличнойЧасти.НомерСтроки));
		ОткрытьФорму("Документ.э_ЗаявкаНаПеревозку.Форма.ФормаРедактированияОтправка", Новый Структура("Действие, ИмяТабличнойЧасти, МассивРеквизитов", "Редактирование", ИмяТабличнойЧасти, МассивРеквизитов), ЭтаФорма, Новый УникальныйИдентификатор,,, Оповещение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеРедактированияСтроки(Результат, ДополнительныеПараметры) Экспорт
	Если НЕ Результат = Неопределено Тогда 
		Если Результат.Действие = "Добавление" Тогда  
			ЗавершениеРедактированияСтрокиНаСервере(Результат);
		Иначе
			ТекущаяСтрокаТабличнойЧасти = Элементы[Результат.ИмяТабличнойЧасти].ТекущиеДанные;
			ЗаполнитьЗначенияСвойств(ТекущаяСтрокаТабличнойЧасти, Результат);
			ЗаполнитьКодыПоСсылкам(); 
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗавершениеРедактированияСтрокиНаСервере(Результат)
	ЗаполнитьЗначенияСвойств(Объект[Результат.ИмяТабличнойЧасти].Добавить(), Результат);
	ЗаполнитьКодыПоСсылкам();
КонецПроцедуры

&НаСервере
Функция ПередНачаломДобавленияПолучитьСтруктуруРеквизитов(ИмяТабличнойЧасти)
	МассивРеквизитов = Новый Массив();
	Для Каждого Реквизит из Метаданные.Документы.э_ЗаявкаНаПеревозку.ТабличныеЧасти[ИмяТабличнойЧасти].Реквизиты Цикл
		Если НЕ Элементы.Найти(ИмяТабличнойЧасти + Реквизит.Имя) = Неопределено И Элементы[ИмяТабличнойЧасти + Реквизит.Имя].Видимость Тогда 
			МассивРеквизитов.Добавить(Новый Структура("Имя, Тип, Синоним, Значение", Реквизит.Имя, Реквизит.Тип, Реквизит.Синоним));
		КонецЕсли;
	КонецЦикла;
	Возврат МассивРеквизитов;
КонецФункции

