&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Действие 		  = Параметры.Действие;
	ИмяТабличнойЧасти = Параметры.ИмяТабличнойЧасти;
	АвтоЗаголовок 	  = Ложь;
	Заголовок		  = Действие + " строки табличной части " + """" + ИмяТабличнойЧасти + """";
	
	Для Каждого Реквизит Из Параметры.МассивРеквизитов Цикл
		МассивСоздаваемыхРеквизитов = Новый Массив;
		СоздаваемыйРеквизит = Новый РеквизитФормы(Реквизит.Имя, Реквизит.Тип, , Реквизит.Синоним, Истина);
		МассивСоздаваемыхРеквизитов.Добавить(СоздаваемыйРеквизит);
		ИзменитьРеквизиты(МассивСоздаваемыхРеквизитов);
	КонецЦикла;
	
	Для Каждого Реквизит Из Параметры.МассивРеквизитов Цикл
		Элемент = Элементы.Добавить(Реквизит.Имя, Тип("ПолеФормы"), ЭтаФорма);
		Элемент.Вид = ВидПоляФормы.ПолеВвода;
		Элемент.ПутьКДанным = Реквизит.Имя;
		ЭтотОбъект[Реквизит.Имя] = Реквизит.Значение;
	КонецЦикла;
	

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры

