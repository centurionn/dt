		 НайденныеСтроки = Объект.Заявки.НайтиСтроки(СтруктураПоиска);
		 Для Каждого НайденнаяСтрока из НайденныеСтроки цикл
			НайденнаяСтрока.СтатусЗаявки = Выборка.СтатусЗаявки;
			НайденнаяСтрока.АктуальныйРеестр = Выборка.АктуальныйРеестр;
			//Евросиб СубботинВ #111466 09.06.2025 Начло 
			НайденнаяСтрока.ИзмененаДатаОплатыУПП = Выборка.ИзмененаДатаОплатыУПП;
			//Евросиб СубботинВ #111466 09.06.2025 Конец 
			//Евросиб СубботинВ #128538 23.01.2026 Начало
            НайденнаяСтрока.Отключена = Выборка.СтрокаОтключена;
			//Евросиб СубботинВ #128538 23.01.2026 Конец              
		 КонецЦикла;
	КонецЦикла;	
		
КонецПроцедуры	


Процедура ПроставитьЗакрытиеЗадач()
	
	
	Для Каждого Этап из Объект.Состояния цикл
		Если Этап.Статус = Перечисления.СтатусыЭтапов.Выполнен и Не ЗначениеЗаполнено(Этап.СтатусСогласования) Тогда
			Этап.СтатусСогласования = Перечисления.СтатусыСогласования.СогласованоБезЗамечаний;
		КонецЕсли;
	КонецЦикла;	
		
КонецПроцедуры


&НаКлиенте
Процедура ТекущийИсполнитель_СтатусОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	Если ВыбранноеЗначение = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Отклонен") тогда
		СтандартнаяОбработка = Ложь; 
		ЗапуститьНаСогласование(Неопределено);
		ОбщегоНазначенияКлиент.СообщитьПользователю("Для закрытия текущей задачи необходимо использовать процесс согласования, для указания причины отклонения");
    КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ТипРеестраПлатежейПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ТипРеестраПлатежей) Тогда
		Если Объект.ТипРеестраПлатежей = ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.ОсновнойДМС") Тогда
			Объект.МаршрутСогласования = ПредопределенноеЗначение("Перечисление.ВидыМаршрутовРеестраПлатежей.Основной")
		Иначе
			Объект.МаршрутСогласования = ПредопределенноеЗначение("Перечисление.ВидыМаршрутовРеестраПлатежей.Дополнительный")
		КонецЕсли;
	Иначе
		Объект.МаршрутСогласования = Неопределено;
	КонецЕсли;	
	
КонецПроцедуры
