&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	//Евросиб СубботинВ #89527 30.10.2024 Начало
	ТекущийОбъект.ДополнительныеСвойства.Вставить("СтатусДокумента", СтатусДокумента);
	ТекущийОбъект.ДополнительныеСвойства.Вставить("СтатусДокументаПервичный", СтатусДокументаПервичный);
	СтрокСсылки = Объект.Ссылка.Заявки.Выгрузить(, "ЗаявкаНаОплату");	
	СтрокиТекущий = Объект.Заявки.Выгрузить(, "ЗаявкаНаОплату");
	МассивСтрокиТекущие = Новый Массив;
	Для Каждого ТекущаяСтрока из СтрокиТекущий Цикл
		 МассивСтрокиТекущие.Добавить(ТекущаяСтрока.ЗаявкаНаОплату);
	 КонецЦикла;
	 
	МассивСтрокиСсылки = Новый Массив;
	Для Каждого СтрокаСсылка из СтрокСсылки Цикл
		Если ЗначениеЗаполнено(СтрокаСсылка.ЗаявкаНаОплату) тогда
			МассивСтрокиСсылки.Добавить(СтрокаСсылка.ЗаявкаНаОплату);
		КонецЕсли;
	КонецЦикла;
 
	СтрокиДляИСключения = ОбщегоНазначенияКлиентСервер.РазностьМассивов(МассивСтрокиСсылки, МассивСтрокиТекущие);
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ТаблицаИсключенныхЗаявок", СтрокиДляИсключения);
    //Евросиб СубботинВ #89527 30.10.2024 Конец

КонецПроцедуры

&НаСервере
Процедура УстановитьТекущийСтатусДокумента()
	
	СтатусДокумента = Справочники.СтатусыДокументов.РеестрПодготовлен;
	
	ТекущийСтатус = РегистрыСведений.СтатусыОбъектов.ПолучитьПоследнее(, Новый Структура("Объект", Объект.Ссылка));   
	
	Если ЗначениеЗаполнено(ТекущийСтатус.Статус) Тогда
		СтатусДокумента = ТекущийСтатус.Статус;  
	КонецЕсли; 
	
	Если не ЗначениеЗаполнено(СтатусДокументаПервичный) и ЗначениеЗаполнено(ТекущийСтатус.Статус) Тогда
		СтатусДокументаПервичный = СтатусДокумента;
	КонецЕсли;
	
		
	УстановитьВидимостьДоступность();

	
КонецПроцедуры

&НаКлиенте
Процедура СтатусДокументаОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)

	//Евросиб СубботинВ #122650 18.11.2025 Начало
	
	Если СтатусДокумента = ПредопределенноеЗначение("Справочник.СтатусыДокументов.РеестрСогласован")
		или СтатусДокумента = ПредопределенноеЗначение("Справочник.СтатусыДокументов.РеестрУтвержден") Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Статус устанавливается автоматически участниками согласования реестра. Ручная смена статуса не возможна");
    	СтандартнаяОбработка = Ложь;
		ВыбранноеЗначение = СтатусДокумента;
		Возврат;
	ИначеЕсли СтатусДокумента = ПредопределенноеЗначение("Справочник.СтатусыДокументов.РеестрПодготовлен") 
		и ВыбранноеЗначение <> ПредопределенноеЗначение("Справочник.СтатусыДокументов.РеестрНаСогласование") Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Установка выбранного статуса не доступна! Доступен статус ""На согласование""");
		СтандартнаяОбработка = Ложь;
		ВыбранноеЗначение = СтатусДокумента;
		Возврат;
	ИначеЕсли (СтатусДокумента = ПредопределенноеЗначение("Справочник.СтатусыДокументов.РеестрНеСогласован") 
		или СтатусДокумента = ПредопределенноеЗначение("Справочник.СтатусыДокументов.РеестрНеУтвержден")) 
		и ВыбранноеЗначение <> ПредопределенноеЗначение("Справочник.СтатусыДокументов.РеестрПодготовлен") Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Для реестра в статусе ""Не согласован"" или  ""Не утвержден"" доступен только статус ""Подготовлен""");
		СтандартнаяОбработка = Ложь;
		Возврат;
		//Евросиб СубботинВ #126080 23.12.2025 Начало 
		//ИначеЕсли СтатусДокумента = ПредопределенноеЗначение("Справочник.СтатусыДокументов.РеестрНаСогласование")Тогда
		//	ОбщегоНазначенияКлиент.СообщитьПользователю("Ручная смена текущего статуса не возможна");
	ИначеЕсли СтатусДокумента = ПредопределенноеЗначение("Справочник.СтатусыДокументов.РеестрНаСогласование") и
		 ВыбранноеЗначение <> ПредопределенноеЗначение("Справочник.СтатусыДокументов.РеестрПодготовлен") Тогда
		 ОбщегоНазначенияКлиент.СообщитьПользователю("Для реестра в статусе ""На согласование"" доступен только статус ""Подготовлен""");
		//Евросиб СубботинВ #126080 23.12.2025 Конец
		СтандартнаяОбработка = Ложь;
		ВыбранноеЗначение = СтатусДокумента;
		Возврат;	
	КонецЕсли;	
	//Евросиб СубботинВ #122650 18.11.2025 Конец
	
	Если НЕ ВыбранноеЗначение = ПредопределенноеЗначение("Справочник.СтатусыДокументов.РеестрПодготовлен") Тогда
		Элементы.Заявки.ТолькоПросмотр = Истина;
		Элементы.ЗаявкиОтобратьИПодгрузитьЗаявки.Доступность = Ложь;
		Элементы.НайтиЗаявкиПоОтбору.Доступность = Ложь;
	ИначеЕсли ВыбранноеЗначение = ПредопределенноеЗначение("Справочник.СтатусыДокументов.РеестрПодготовлен")
		и НЕ СтатусДокументаПервичный = ВыбранноеЗначение Тогда
		Объект.Состояния.Очистить();		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьДоступность()
	
	//Евросиб СубботинВ #122650 18.11.2025 Начало
	Если Не КонтрольДоступностиДокументов_сервер.РольДоступнаВызовСервера("dc_СогласованиеРеестраПлатежей") И Не
		КонтрольДоступностиДокументов_сервер.РольДоступнаВызовСервера("dc_УтверждениеРеестраПлатежей") Тогда
		Элементы.ТекущийИсполнитель_Статус.Доступность = Ложь;
	КонецЕсли;	
	//Евросиб СубботинВ #122650 18.11.2025 Конец
	
	Если СтатусДокумента <> ПредопределенноеЗначение("Справочник.СтатусыДокументов.РеестрПодготовлен") Тогда
		Элементы.Заявки.ТолькоПросмотр = Истина;
		Элементы.ЗаявкиОтобратьИПодгрузитьЗаявки.Доступность = Ложь;
		Элементы.НайтиЗаявкиПоОтбору.Доступность = Ложь;
	КонецЕсли;
	Если РольДоступна("ПолныеПрава") и СтатусДокумента = ПредопределенноеЗначение("Справочник.СтатусыДокументов.РеестрУтвержден") Тогда
		Элементы.СписокЗаявокВыгрузитьЗаявкиВУПП.Доступность = Истина;
	КонецЕсли;	

КонецПроцедуры

