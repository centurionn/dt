&НаКлиенте
Процедура ВидОперацииОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
		
	Если Объект.Заявки.Количество() > 0 Тогда
		СтандартнаяОбработка = Ложь;
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить(КодВозвратаДиалога.ОК, "Очистить");
		СписокКнопок.Добавить(КодВозвратаДиалога.Отмена, "Отмена");		
		ОпОп = Новый ОписаниеОповещения("ОбработкаОтветаПользователяИзменениеВидаОперации", ЭтаФорма, Новый Структура("ЗаполнениеНовымЗначением", Ложь));
		ПоказатьВопрос(ОпОп,"Реестр уже содержит документы. При изменении вида операции документ будет очищен..",СписокКнопок,,КодВозвратаДиалога.ОК);		
	КонецЕсли;
	
КонецПроцедуры 
	
&НаКлиенте	
Процедура ОбработкаОтветаПользователяИзменениеВидаОперации(ОтветПользователя = Неопределено, ДопПараметры = Неопределено)Экспорт

	Если ОтветПользователя = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ОтветПользователя = КодВозвратаДиалога.Ок Тогда // перезаполняем		
		Объект.Заявки.Очистить();
		ОбновитьИтоги();
		Если ДопПараметры.ЗаполнениеНовымЗначением тогда
			Объект.ТипРеестраПлатежей = ДопПараметры.НовоеЗначение;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры	

