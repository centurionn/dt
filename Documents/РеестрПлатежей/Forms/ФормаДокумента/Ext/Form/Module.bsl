&НаСервере
Процедура НайтиЗаявкиПоОтборуНаСервере(УдалитьДобавленныеЗаявки) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	
		"ВЫБРАТЬ
		|	ЗаявкаНаОплату.Ссылка КАК ЗаявкаНаОплату,
		|	ЗаявкаНаОплату.Контрагент КАК Контрагент,
		|	ЗаявкаНаОплату.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	ЗаявкаНаОплату.ОтветственныйЗаОплату КАК ОтветственныйЗаОплату,
		|	ЗаявкаНаОплату.ВсегоПоЗаявке КАК СуммаПлатежаВВалюте,
		|	ЗаявкаНаОплату.ДоговорКонтрагента.ВалютаВзаиморасчетов КАК Валюта,
		|	ЗаявкаНаОплату.ДоговорКонтрагента.УсловиеОплаты КАК УсловиеОплаты,
		|	ЗаявкаНаОплату.ДатаПланируемойОплаты КАК ДатаПланируемойОплаты
		|ПОМЕСТИТЬ ВТ_Заявки
		|ИЗ
		|	Документ.ЗаявкаНаОплату КАК ЗаявкаНаОплату
		|ГДЕ
		|	ЗаявкаНаОплату.ДатаПланируемойОплаты В(&ДатыОплаты)
		|	И ЗаявкаНаОплату.Проведен
		//Евросиб СубботинВ #89527 30.10.2024 Начало 
		|	И &ТекущиеУсловия
		|	И &ДопУсловия 
		// доп условия для подборов по видам реестра собираются ниже
		//Евросиб СубботинВ #89527 30.10.2024 Конец 
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СтатусыОбъектовСрезПоследних.Объект КАК Объект
		|ПОМЕСТИТЬ ВТ_СтатусыЗаявок
		|ИЗ
		|	РегистрСведений.СтатусыОбъектов.СрезПоследних(
		|			,
		|			Объект В
		|				(ВЫБРАТЬ
		|					ВТ_Заявки.ЗаявкаНаОплату КАК ЗаявкаНаОплату
		|				ИЗ
		|					ВТ_Заявки КАК ВТ_Заявки)) КАК СтатусыОбъектовСрезПоследних
		|ГДЕ
		|	СтатусыОбъектовСрезПоследних.Статус = &СтатусСогласован
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_Заявки.ЗаявкаНаОплату КАК ЗаявкаНаОплату,
		|	ВТ_Заявки.Контрагент КАК Контрагент,
		|	ВТ_Заявки.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	ВТ_Заявки.ОтветственныйЗаОплату КАК ОтветственныйЗаОплату,
		|	ВТ_Заявки.СуммаПлатежаВВалюте КАК СуммаПлатежаВВалюте,
		|	ВТ_Заявки.Валюта КАК Валюта,
		|	ВТ_Заявки.УсловиеОплаты КАК УсловиеОплаты,
		|	ВТ_Заявки.ДатаПланируемойОплаты КАК ДатаПланируемойОплаты,
		|   &СтатусСогласован КАК СтатусЗаявки
		|ИЗ
		|	ВТ_Заявки КАК ВТ_Заявки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СтатусыЗаявок КАК ВТ_СтатусыЗаявок
		|		ПО ВТ_Заявки.ЗаявкаНаОплату = ВТ_СтатусыЗаявок.Объект		
		|		Левое СОЕДИНЕНИЕ Справочник.Маршрутизация.КонтрагентыИДоговоры КАК МаршрутизацияКонтрагентыИДоговоры
		|		ПО ВТ_Заявки.Контрагент = МаршрутизацияКонтрагентыИДоговоры.Контрагент
		|       и МаршрутизацияКонтрагентыИДоговоры.Ссылка.ВидОперацииЗаявкиНаОплату = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаявкиНаОплату.ОплатаПоставщикуОбщехозяйственные)
        |ГДЕ
		// контрагенты по списку маршрута должны быть только в одном случае, в остальных они попадают в исключения
		| 	Выбор 
		|	Когда &ТипРеестраПлатежей = ЗНАЧЕНИЕ(Перечисление.ТипыРеестраПлатежей.ОбщехозяйственнаяДеятельность)
		|	Тогда НЕ МаршрутизацияКонтрагентыИДоговоры.Ссылка ЕСТЬ NULL
		|	Иначе МаршрутизацияКонтрагентыИДоговоры.Ссылка ЕСТЬ NULL 
		|Конец
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_Заявки.ЗаявкаНаОплату КАК ЗаявкаНаОплату,
		|	ПоступлениеТоваровУслугУслуги.Номенклатура КАК Номенклатура
		|ИЗ
		|	ВТ_Заявки КАК ВТ_Заявки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаОплату.ДокументыНаОплату КАК ЗаявкаНаОплатуДокументыНаОплату
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.Услуги КАК ПоступлениеТоваровУслугУслуги
		|			ПО ЗаявкаНаОплатуДокументыНаОплату.ОснованиеДляПлатежа = ПоступлениеТоваровУслугУслуги.Ссылка
		|		ПО ВТ_Заявки.ЗаявкаНаОплату = ЗаявкаНаОплатуДокументыНаОплату.Ссылка
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_Заявки.ЗаявкаНаОплату,
		|	СчетНаОплатуПоставщикаТовары.Номенклатура
		|ИЗ
		|	ВТ_Заявки КАК ВТ_Заявки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаОплату.ДокументыНаОплату КАК ЗаявкаНаОплатуДокументыНаОплату
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетНаОплатуПоставщика.Товары КАК СчетНаОплатуПоставщикаТовары
		|			ПО ЗаявкаНаОплатуДокументыНаОплату.ОснованиеДляПлатежа = СчетНаОплатуПоставщикаТовары.Ссылка
		|		ПО ВТ_Заявки.ЗаявкаНаОплату = ЗаявкаНаОплатуДокументыНаОплату.Ссылка";
		

	
	ТзДатыОплаты = Объект.ВыбранныеДаты.Выгрузить(,"Дата");
	Запрос.УстановитьПараметр("ДатыОплаты", ТзДатыОплаты);
	Запрос.УстановитьПараметр("СтатусСогласован", Справочники.СтатусыДокументов.Согласована);
	
	//Евросиб СубботинВ #89527 30.10.2024 Начало 
	Запрос.УстановитьПараметр("ТипРеестраПлатежей", Объект.ТипРеестраПлатежей);
	Запрос.УстановитьПараметр("ДопУсловия", Истина);
	Запрос.УстановитьПараметр("ТекущиеУсловия", Истина);
	МассивОтборов = Новый Массив;
	ЗаполнитьОтборыЗаявок(МассивОтборов);
	СчетчикУсловий = 0;
	
	Для Каждого Отбор из МассивОтборов Цикл
		Если СчетчикУсловий = 0 Тогда			
			СтрокаЗамены = СтрШаблон(" И ЗаявкаНаОплату.ВидОперации = (&%1)","ВидОперации" + СчетчикУсловий);
			Запрос.УстановитьПараметр("ВидОперации" + СчетчикУсловий, Отбор.ВидОперации);			
			Если Отбор.МассивПодразделений <> Неопределено Тогда
				СтрокаЗамены = СтрокаЗамены + СтрШаблон(" И %1 ЗаявкаНаОплату.ПодразделениеДКП В Иерархии (&%2)",
				 ?(Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке,"","НЕ"),  //парам шаблона 1
				 "СписокДКП" + СчетчикУсловий);//парам шаблона 2
				Запрос.УстановитьПараметр("СписокДКП" + СчетчикУсловий, Отбор.МассивПодразделений);
			КонецЕсли;
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &ТекущиеУсловия", СтрокаЗамены);
		Иначе	
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &ДопУсловия", "ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ
			|	ЗаявкаНаОплату.Ссылка КАК ЗаявкаНаОплату,
			|	ЗаявкаНаОплату.Контрагент КАК Контрагент,
			|	ЗаявкаНаОплату.ДоговорКонтрагента КАК ДоговорКонтрагента,
			|	ЗаявкаНаОплату.ОтветственныйЗаОплату КАК ОтветственныйЗаОплату,
			|	ЗаявкаНаОплату.ВсегоПоЗаявке КАК СуммаПлатежаВВалюте,
			|	ЗаявкаНаОплату.ДоговорКонтрагента.ВалютаВзаиморасчетов КАК Валюта,
			|	ЗаявкаНаОплату.ДоговорКонтрагента.УсловиеОплаты КАК УсловиеОплаты,
			|	ЗаявкаНаОплату.ДатаПланируемойОплаты КАК ДатаПланируемойОплаты
			|ИЗ
			|	Документ.ЗаявкаНаОплату КАК ЗаявкаНаОплату
			|ГДЕ
			|	ЗаявкаНаОплату.ДатаПланируемойОплаты В(&ДатыОплаты)
			|	И ЗаявкаНаОплату.Проведен
			|	И &ТекущиеУсловия
			|	И &ДопУсловия");			
			СтрокаЗамены = СтрШаблон(" И ЗаявкаНаОплату.ВидОперации = (&%1)","ВидОперации" + СчетчикУсловий);
			Запрос.УстановитьПараметр("ВидОперации" + СчетчикУсловий, Отбор.ВидОперации);			
			Если Отбор.МассивПодразделений <> Неопределено Тогда
				СтрокаЗамены = СтрокаЗамены + СтрШаблон(" И %1 ЗаявкаНаОплату.ПодразделениеДКП В Иерархии (&%2)",
				 ?(Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке,"","НЕ"),  //парам шаблона 1
				 "СписокДКП" + СчетчикУсловий);//парам шаблона 2
				Запрос.УстановитьПараметр("СписокДКП" + СчетчикУсловий, Отбор.МассивПодразделений);
			КонецЕсли;
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &ТекущиеУсловия", СтрокаЗамены);
		КонецЕсли;		
		СчетчикУсловий = СчетчикУсловий + 1;
	КонецЦикла;
	//Евросиб СубботинВ #89527 30.10.2024 Конец 

	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	Если не РезультатЗапроса[2].Пустой() Тогда
		Если УдалитьДобавленныеЗаявки Тогда
			Объект.Заявки.Очистить();
		КонецЕсли;
		ТЗЗаявок  = РезультатЗапроса[2].Выгрузить();
		Для Каждого СтрокаТЗ из ТЗЗаявок Цикл 
			СтруктураПоиска = Новый Структура("ЗаявкаНаОплату", СтрокаТЗ.ЗаявкаНаОплату);
			Дубли =  Объект.Заявки.НайтиСтроки(СтруктураПоиска);
			Если Дубли.Количество() = 0 Тогда
				НоваяСтрока = Объект.Заявки.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЗ);
				НоваяСтрока.ПопадаетВОтборы = Истина;
				НоваяСтрока.СуммаПлатежаРуб = РаботаСКурсамиВалют.ПересчитатьВВалюту(НоваяСтрока.СуммаПлатежаВВалюте, НоваяСтрока.Валюта,
																			  	   ВалютаРегУчета, Объект.Дата);

			Иначе 
				ОбщегоНазначения.СообщитьПользователю("Документ " + СтрокаТЗ.ЗаявкаНаОплату + " уже добавлен.");
			КонецЕсли;			
		КонецЦикла;
	Иначе
		ОбщегоНазначения.СообщитьПользователю("Заявок с датами планируемой оплаты, попадающих в выбранные периоды, в статусе «Согласована в DC» не найдено");
	КонецЕсли;
	
	Если не РезультатЗапроса[3].Пустой() Тогда
		ТЗУслуг = РезультатЗапроса[3].Выгрузить();
		Для Каждого СтрокаЗаявок Из Объект.Заявки Цикл
			СтруктураПоиска = Новый Структура("ЗаявкаНаОплату",СтрокаЗаявок.ЗаявкаНаОплату);
			УслугиПоЗаявке = ТЗУслуг.НайтиСтроки(СтруктураПоиска);
			МассивНоменклатур = Новый Массив;
			Для Каждого СтрокаУслуг из УслугиПоЗаявке Цикл
				Если ЗначениеЗаполнено(СтрокаУслуг.Номенклатура) Тогда
					МассивНоменклатур.Добавить(СтрокаУслуг.Номенклатура);
				КонецЕсли;
			КонецЦикла;
			СтрокаЗаявок.УслугиПТУСчет = СтрСоединить(МассивНоменклатур,";");
		КонецЦикла;
	КонецЕсли;
	СформироватьТаблицыДляОтбора(Истина);
	
	ОбновитьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура НайтиЗаявкиПоОтбору(Команда)	
	
	Если НЕ Объект.ВыбранныеДаты.Количество()>0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо выбрать даты оплаты для заполнения реестра заявок на оплату");
		Возврат;
	КонецЕсли;
	
	Если не ЗначениеЗаполнено(Объект.ТипРеестраПлатежей) тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо выбрать тип реестра для заполнения реестра заявок на оплату");
		Возврат;
	КонецЕсли;
	
	Если Объект.Заявки.Количество() > 0 Тогда
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить(КодВозвратаДиалога.Да, "Перезаполнить реестр");
		СписокКнопок.Добавить(КодВозвратаДиалога.ОК, "Дополнить реестр");
		СписокКнопок.Добавить(КодВозвратаДиалога.Отмена, "Отмена");		
		ОпОп = Новый ОписаниеОповещения("ОбработкаОтветаПользователя", ЭтаФорма);
		ПоказатьВопрос(ОпОп,"Реестр уже содержит документы. Выберите вариант заполнения.",СписокКнопок,,КодВозвратаДиалога.Да);		
		
	Иначе
		НайтиЗаявкиПоОтборуНаСервере(Истина);
	КонецЕсли;
КонецПроцедуры 

&НаКлиенте	
Процедура ОбработкаОтветаПользователя(ОтветПользователя = Неопределено, ДопПараметры = Неопределено)Экспорт

	Если ОтветПользователя = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ОтветПользователя = КодВозвратаДиалога.Да Тогда // перезаполняем		
		НайтиЗаявкиПоОтборуНаСервере(Истина);
	ИначеЕсли ОтветПользователя = КодВозвратаДиалога.ОК Тогда  // дополняем новыми строками
		НайтиЗаявкиПоОтборуНаСервере(Ложь);
	КонецЕсли;

КонецПроцедуры	

&НаКлиенте
Процедура ВыгрузитьЗаявкиВУПП(Команда)
//	ВыгрузитьЗаявкиВУППНаСервере();
КонецПроцедуры         

&НаСервере
Процедура ВыгрузитьЗаявкиВУППНаСервере()
	МассивСсылок = Новый Массив;   
	Для Каждого СтрЗаявки Из Объект.Заявки Цикл
		МассивСсылок.Добавить(СтрЗаявки.ЗаявкаНаОплату);
	КонецЦикла;
	ПланыОбмена.ВыгрузкаДанных.ЗарегистрироватьИзмененияПоДокументу(МассивСсылок, Перечисления.УзлыОбмена.УПП);
	ЕСОбменСервер.РегЗадание_ВыгрузкаЗаявокНаОплатуВУПП(МассивСсылок);
КонецПроцедуры

&НаКлиенте
Процедура ВыбранныеДатыРеестраПриИзменении(Элемент)
	
	Если Объект.Заявки.Количество()>0 Тогда
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить(КодВозвратаДиалога.Да, "Продолжить");
		СписокКнопок.Добавить(КодВозвратаДиалога.Отмена, "Отмена");		
		ОпОп = Новый ОписаниеОповещения("ОбработкаОтветаПользователяОчисткаЗаявок", ЭтаФорма, Новый Структура("Элемент", Элемент));
		ПоказатьВопрос(ОпОп,"Перед изменением выбранных дат реест будет очищен.", СписокКнопок,,КодВозвратаДиалога.Да);		
	Иначе
		Объект.ВыбранныеДаты.Очистить();
		Для Каждого Значение из ВыбранныеДатыРеестра цикл
			НовСтрока = Объект.ВыбранныеДаты.Добавить();
			НовСтрока.Дата = Значение.Значение;
		КонецЦикла;	
        ВыбранныеДатыРеестра.СортироватьПоЗначению(НаправлениеСортировки.Возр);
		Объект.ВыбранныеДаты.Сортировать("Дата Возр");
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если Объект.ВыбранныеДаты.Количество() Тогда 
		ВыбранныеДатыРеестра.Очистить();
		Для Каждого ЭлементСписка Из Объект.ВыбранныеДаты Цикл
			ВыбранныеДатыРеестра.Добавить(ЭлементСписка.Дата);
		КонецЦикла;
	КонецЕсли;
	СформироватьТаблицыДляОтбора(Истина);
	СформироватьОтборСтрок();
	
	//Евросиб СубботинВ #89527 30.10.2024 Начало
	ЗаполнитьСтатусыДокументов();
	//Евросиб СубботинВ #89527 30.10.2024 Конец 
	
	//Евросиб СубботинВ #128538 23.01.2026 Начало
	ОбновитьИтоги()
	//Евросиб СубботинВ #128538 23.01.2026 Конец	

	
КонецПроцедуры

