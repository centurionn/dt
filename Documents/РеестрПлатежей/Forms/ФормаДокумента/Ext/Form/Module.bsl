&НаКлиенте
Процедура ОбработкаПодбораЗаявок(МассивСсылок = Неопределено, Параметр2 = Неопределено) Экспорт
	
	Если МассивСсылок = Неопределено Тогда
		Возврат; 
	КонецЕсли;
	
	МассивВозможныхТиповЗаявок = Новый Массив;	
	ЗаполнитьОтборыЗаявок(МассивВозможныхТиповЗаявок);
	
	ДанныеПоСпискуЗаявок = ДанныеВыбранныхЗаявок(МассивСсылок);	
	Для Каждого СтрокаПоЗаявке из ДанныеПоСпискуЗаявок Цикл
		//Евросиб СубботинВ #89527 30.10.2024 Начало
		//НоваяСтрока = Объект.Заявки.Добавить();	
		//ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПоЗаявке);
		//АктуализироватьСписокВыбранныхДат(СтрокаПоЗаявке.ДатаПланируемойОплаты);		
		Если не ЗначениеЗаполнено(Объект.ТипРеестраПлатежей) Тогда 
			НоваяСтрока = Объект.Заявки.Добавить();	
			Объект.ТипРеестраПлатежей = СтрокаПоЗаявке.ТипРеестраПлатежей; 
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПоЗаявке);
			АктуализироватьСписокВыбранныхДат(СтрокаПоЗаявке.ДатаПланируемойОплаты);	
		Иначе
			//	или (СтрокаПоЗаявке.ТипРеестраПлатежей = ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.СтрахованиеГрузов")
			//	и Объект.ТипРеестраПлатежей = ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.СтрахованиеИПретензииДКС"))
			//	или (СтрокаПоЗаявке.ТипРеестраПлатежей = ПредопределенноеЗначение("Перечисление..ТипыРеестраПлатежей.ПретензииДКС")
			//	и Объект.ТипРеестраПлатежей = ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.СтрахованиеИПретензииДКС")) Тогда
			ЗаявкаМожетБытьВключенаВРесстр = Ложь;
			Для Каждого ТипЗаявки  из МассивВозможныхТиповЗаявок цикл
				Если СтрокаПоЗаявке.ТипРеестраПлатежей = ТипЗаявки.ТипРеестра 
				или (СтрокаПоЗаявке.ТипРеестраПлатежей = ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.СтрахованиеГрузов")
				и Объект.ТипРеестраПлатежей = ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.СтрахованиеИПретензииДКС"))
				или (СтрокаПоЗаявке.ТипРеестраПлатежей = ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.ПретензииДКС")
				и Объект.ТипРеестраПлатежей = ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.СтрахованиеИПретензииДКС")) Тогда
					ЗаявкаМожетБытьВключенаВРесстр = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если ЗаявкаМожетБытьВключенаВРесстр Тогда				
				НоваяСтрока = Объект.Заявки.Добавить();	
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПоЗаявке);
				АктуализироватьСписокВыбранныхДат(СтрокаПоЗаявке.ДатаПланируемойОплаты);	
			Иначе 
				ОбщегоНазначенияКлиент.СообщитьПользователю("Документ " + СтрокаПоЗаявке.ЗаявкаНаОплату + " не может быть добавлен в реестр с типом " + Объект.ТипРеестраПлатежей +".");
				Возврат;
			КонецЕсли;	
		КонецЕсли;	
	//Евросиб СубботинВ #89527 30.10.2024 Конец

	КонецЦикла;
	СформироватьТаблицыДляОтбора(Истина);
	СформироватьОтборСтрок();

КонецПроцедуры	

