Функция ЗаполнитьОтборыЗаявок(МассивОтборов)
	
	Если Объект.ТипРеестраПлатежей = ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.ОсновнойДМС") Тогда                 
	//ОсновнойДМС
		МассивОтборов.Добавить(Новый Структура("ВидОперации, МассивПодразделений, ВидСравнения, ТипРеестра",
											   	ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаявкиНаОплату.ОплатаПоставщику"),
												Неопределено, Неопределено, ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.ОсновнойДМС")));
		
		МассивОтборов.Добавить(Новый Структура("ВидОперации, МассивПодразделений, ВидСравнения, ТипРеестра",
												ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаявкиНаОплату.ОплатаШтрафов"),
												Неопределено, Неопределено, ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.ОсновнойДМС")));		
		МассивОтборов.Добавить(Новый Структура("ВидОперации, МассивПодразделений, ВидСравнения, ТипРеестра",
											   	ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаявкиНаОплату.ОплатаПоставщикуОбщехозяйственные"),
												Неопределено, Неопределено,ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.ОсновнойДМС")));
		МассивОтборов.Добавить(Новый Структура("ВидОперации, МассивПодразделений, ВидСравнения, ТипРеестра",
												ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаявкиНаОплату.ОплатаПретензий"),
												ПредопределенноеЗначение("Справочник.ГруппыПользователей.ДепартаментКлиентскогоСервиса"),
											   	ВидСравненияКомпоновкиДанных.НеВСписке, ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.ОсновнойДМС")));
	//Общехоз										   
	ИначеЕсли Объект.ТипРеестраПлатежей = ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.ОбщехозяйственнаяДеятельность") Тогда	
		МассивОтборов.Добавить(Новый Структура("ВидОперации,МассивПодразделений,ВидСравнения, ТипРеестра",
											   	ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаявкиНаОплату.ОплатаПоставщикуОбщехозяйственные"),
												Неопределено, Неопределено, ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.ОбщехозяйственнаяДеятельность")));   
	//Аренда	
	ИначеЕсли Объект.ТипРеестраПлатежей = ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.АрендаВагонов") Тогда					
		МассивОтборов.Добавить(Новый Структура("ВидОперации, МассивПодразделений, ВидСравнения, ТипРеестра",
											   	ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаявкиНаОплату.ОплатаАренды"),
												Неопределено, Неопределено, ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.АрендаВагонов")));
    //СтрахованиеИПретензииДКС		
	ИначеЕсли Объект.ТипРеестраПлатежей = ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.СтрахованиеИПретензииДКС") Тогда
	    МассивОтборов.Добавить(Новый Структура("ВидОперации, МассивПодразделений, ВидСравнения, ТипРеестра",
											   	ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаявкиНаОплату.Страхование"),
												Неопределено, Неопределено, ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.СтрахованиеИПретензииДКС")));   

	   	МассивОтборов.Добавить(Новый Структура("ВидОперации, МассивПодразделений, ВидСравнения, ТипРеестра",
											   	ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаявкиНаОплату.ОплатаПретензий"),
												ПредопределенноеЗначение("Справочник.ГруппыПользователей.ДепартаментКлиентскогоСервиса"),
												ВидСравненияКомпоновкиДанных.ВСписке, ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.СтрахованиеИПретензииДКС")));	
	//Претензии	
	ИначеЕсли Объект.ТипРеестраПлатежей = ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.ПретензииДКС") Тогда
	   	МассивОтборов.Добавить(Новый Структура("ВидОперации, МассивПодразделений, ВидСравнения, ТипРеестра",
											   	ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаявкиНаОплату.ОплатаПретензий"),
												ПредопределенноеЗначение("Справочник.ГруппыПользователей.ДепартаментКлиентскогоСервиса"),
												ВидСравненияКомпоновкиДанных.ВСписке, ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.ПретензииДКС")));	
	//Страховка	
	ИначеЕсли Объект.ТипРеестраПлатежей = ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.СтрахованиеГрузов") Тогда
	    МассивОтборов.Добавить(Новый Структура("ВидОперации, МассивПодразделений, ВидСравнения, ТипРеестра",
											   	ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаявкиНаОплату.Страхование"),
												Неопределено, Неопределено, ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.СтрахованиеГрузов")));	
                                                //ПредопределенноеЗначение("Справочник.ГруппыПользователей.ДепартаментКлиентскогоСервиса"),
												//ВидСравненияКомпоновкиДанных.ВСписке, ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.СтрахованиеГрузов")));	
	КонецЕсли;
	
	Возврат МассивОтборов;
	
