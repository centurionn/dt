&НаКлиенте
Процедура СписокЗаявокЗаявкаНаОплатуОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ТекДанные = Элементы.Заявки.ТекущиеДанные;
	//Евросиб СубботинВ #89527 30.10.2024 Начало
	//ЗаполнитьЗначенияСвойств(ТекДанные, ДанныеВыбранныхЗаявок(ВыбранноеЗначение)[0]);
	ДанныеЗаявки = ДанныеВыбранныхЗаявок(ВыбранноеЗначение)[0];
	Если ДанныеЗаявки.ЗаявкаНаОплату = Неопределено тогда
		Возврат
	КонецЕсли;	
	Если не ЗначениеЗаполнено(Объект.ТипРеестраПлатежей) Тогда
		Объект.ТипРеестраПлатежей = ДанныеЗаявки.ТипРеестраПлатежей; 
		ЗаполнитьЗначенияСвойств(ТекДанные, ДанныеЗаявки);
	Иначе
		//Если Объект.ТипРеестраПлатежей = ДанныеЗаявки.ТипРеестраПлатежей 
		//	или (ДанныеЗаявки.ТипРеестраПлатежей = ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.СтрахованиеГрузов")
		//	и Объект.ТипРеестраПлатежей = ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.СтрахованиеИПретензииДКС"))
		//	или (ДанныеЗаявки.ТипРеестраПлатежей = ПредопределенноеЗначение("Перечисление..ТипыРеестраПлатежей.ПретензииДКС")
		//	и Объект.ТипРеестраПлатежей = ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.СтрахованиеИПретензииДКС")) Тогда
		ЗаявкаМожетБытьВключенаВРесстр = Ложь;
		МассивВозможныхТиповЗаявок = Новый Массив;	
		ЗаполнитьОтборыЗаявок(МассивВозможныхТиповЗаявок);
		Для Каждого ТипЗаявки  из МассивВозможныхТиповЗаявок цикл
			Если ДанныеЗаявки.ТипРеестраПлатежей = ТипЗаявки.ТипРеестра 
			или (ДанныеЗаявки.ТипРеестраПлатежей = ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.СтрахованиеГрузов")
			и Объект.ТипРеестраПлатежей = ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.СтрахованиеИПретензииДКС"))
			или (ДанныеЗаявки.ТипРеестраПлатежей = ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.ПретензииДКС")
			и Объект.ТипРеестраПлатежей = ПредопределенноеЗначение("Перечисление.ТипыРеестраПлатежей.СтрахованиеИПретензииДКС")) Тогда 
			ЗаявкаМожетБытьВключенаВРесстр = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ЗаявкаМожетБытьВключенаВРесстр Тогда			
			ЗаполнитьЗначенияСвойств(ТекДанные, ДанныеЗаявки); 
		Иначе 
			ОбщегоНазначенияКлиент.СообщитьПользователю("Документ " + ДанныеЗаявки.ЗаявкаНаОплату + " не может быть добавлен в реестр с типом " + Объект.ТипРеестраПлатежей +".");
			Возврат;
		КонецЕсли;	
	КонецЕсли;	
	//Евросиб СубботинВ #89527 30.10.2024 Конец
	СформироватьТаблицыДляОтбора(Истина);
	СформироватьОтборСтрок();
	АктуализироватьСписокВыбранныхДат(ТекДанные.ДатаПланируемойОплаты);
	
КонецПроцедуры	

&НаСервере	
Функция ДанныеВыбранныхЗаявок(МассивСсылок)
	
	МассивСтруктурОтветов = Новый Массив;
	
	//Евросиб СубботинВ #89527 30.10.2024 Начало
	//СтруктураОтвета = Новый Структура("ЗаявкаНаОплату, Контрагент, ДоговорКонтрагента,
	//								  |ОтветственныйЗаОплату, СуммаПлатежаРуб, СуммаПлатежаВВалюте,
	//								  //|Валюта,ДатаПланируемойОплаты,УсловиеОплаты, ПопадаетВОтборы, УслугиПТУСчет");
  //Евросиб СубботинВ #89527 30.10.2024 Конец
  
	Запрос = Новый Запрос;
	Запрос.Текст = 
	
	"ВЫБРАТЬ
	|	ЗаявкаНаОплату.Ссылка КАК ЗаявкаНаОплату,
	|	ЗаявкаНаОплату.Контрагент КАК Контрагент,
	|	ЗаявкаНаОплату.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ЗаявкаНаОплату.ОтветственныйЗаОплату КАК ОтветственныйЗаОплату,
	|	ЗаявкаНаОплату.ВсегоПоЗаявке КАК СуммаПлатежаВВалюте,
	|	ЗаявкаНаОплату.ДоговорКонтрагента.ВалютаВзаиморасчетов КАК Валюта,
	|	ЗаявкаНаОплату.ДоговорКонтрагента.УсловиеОплаты КАК УсловиеОплаты,
	|	ЗаявкаНаОплату.ДатаПланируемойОплаты КАК ДатаПланируемойОплаты,
	|	ИСТИНА КАК ПопадаетВОтборы
	//Евросиб СубботинВ #89527 30.10.2024 Начало 
	|	,Выбор Когда  ЗаявкаНаОплату.ВидОперации = Значение(Перечисление.ВидыОперацийЗаявкиНаОплату.ОплатаПретензий) и
	|				   ЗаявкаНаОплату.ПодразделениеДКП = Значение(Справочник.группыПользователей.ДепартаментКлиентскогоСервиса)
	|			Тогда Значение(Перечисление.ТипыРеестраПлатежей.ПретензииДКС)
	|          Когда  ЗаявкаНаОплату.ВидОперации = Значение(Перечисление.ВидыОперацийЗаявкиНаОплату.Страхование) 
	|			Тогда Значение(Перечисление.ТипыРеестраПлатежей.СтрахованиеГрузов)
	|          Когда  ЗаявкаНаОплату.ВидОперации = Значение(Перечисление.ВидыОперацийЗаявкиНаОплату.ОплатаПоставщикуОбщехозяйственные) 
	|			Тогда Значение(Перечисление.ТипыРеестраПлатежей.ОбщехозяйственнаяДеятельность)
	|          Когда  ЗаявкаНаОплату.ВидОперации = Значение(Перечисление.ВидыОперацийЗаявкиНаОплату.ОплатаАренды) 
	|			Тогда Значение(Перечисление.ТипыРеестраПлатежей.АрендаВагонов)
	|         Иначе Значение(Перечисление.ТипыРеестраПлатежей.ОсновнойДМС)
	|    Конец
	|   КАК ТипРеестраПлатежей
	//Евросиб СубботинВ #89527 30.10.2024 Конец 
	|ИЗ
	|	Документ.ЗаявкаНаОплату КАК ЗаявкаНаОплату
	|ГДЕ
	|	ЗаявкаНаОплату.Ссылка В(&Ссылки)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПоступлениеТоваровУслугУслуги.Номенклатура КАК Номенклатура,
	|	ЗаявкаНаОплатуДокументыНаОплату.Ссылка КАК ЗаявкаНаОплату
	|ИЗ
	|	Документ.ЗаявкаНаОплату.ДокументыНаОплату КАК ЗаявкаНаОплатуДокументыНаОплату
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.Услуги КАК ПоступлениеТоваровУслугУслуги
	|		ПО ЗаявкаНаОплатуДокументыНаОплату.ОснованиеДляПлатежа = ПоступлениеТоваровУслугУслуги.Ссылка
	|ГДЕ
	|	ЗаявкаНаОплатуДокументыНаОплату.Ссылка В(&Ссылки)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СчетНаОплатуПоставщикаТовары.Номенклатура,
	|	ЗаявкаНаОплатуДокументыНаОплату.Ссылка
	|ИЗ
	|	Документ.ЗаявкаНаОплату.ДокументыНаОплату КАК ЗаявкаНаОплатуДокументыНаОплату
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетНаОплатуПоставщика.Товары КАК СчетНаОплатуПоставщикаТовары
	|		ПО ЗаявкаНаОплатуДокументыНаОплату.ОснованиеДляПлатежа = СчетНаОплатуПоставщикаТовары.Ссылка
	|ГДЕ
	|	ЗаявкаНаОплатуДокументыНаОплату.Ссылка В(&Ссылки)"; 
	
	Запрос.УстановитьПараметр("Ссылки", МассивСсылок);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаЗаявка = РезультатЗапроса[0].Выбрать();
	Пока ВыборкаЗаявка.Следующий() Цикл
		СтруктураПоиска = Новый Структура("ЗаявкаНаОплату", ВыборкаЗаявка.ЗаявкаНаОплату);
		Дубли =  Объект.Заявки.НайтиСтроки(СтруктураПоиска);
		Если Дубли.Количество() = 0 Тогда 
			СтруктураОтвета = Новый Структура("ЗаявкаНаОплату, Контрагент, ДоговорКонтрагента, ТипРеестраПлатежей,
									  |ОтветственныйЗаОплату, СуммаПлатежаРуб, СуммаПлатежаВВалюте, Валюта,ДатаПланируемойОплаты,УсловиеОплаты, ПопадаетВОтборы, УслугиПТУСчет");

			ЗаполнитьЗначенияСвойств(СтруктураОтвета, ВыборкаЗаявка);
			СтруктураОтвета.СуммаПлатежаРуб = РаботаСКурсамиВалют.ПересчитатьВВалюту(ВыборкаЗаявка.СуммаПлатежаВВалюте,ВыборкаЗаявка.Валюта,ВалютаРегУчета,Объект.Дата);
		Иначе
			ОбщегоНазначения.СообщитьПользователю("Документ " + ВыборкаЗаявка.ЗаявкаНаОплату + " уже добавлен.");
			Продолжить
		КонецЕсли;			
		МассивНоменклатур = Новый Массив;
		Если не РезультатЗапроса[1].Пустой() Тогда
			ТЗУслуг = РезультатЗапроса[1].Выгрузить();
			УслугиПоЗаявке = ТЗУслуг.НайтиСтроки(СтруктураПоиска);
			Для Каждого СтрокаУслуг из УслугиПоЗаявке Цикл
				Если ЗначениеЗаполнено(СтрокаУслуг.Номенклатура) Тогда
					МассивНоменклатур.Добавить(СтрокаУслуг.Номенклатура);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;		
		
		СтруктураОтвета.УслугиПТУСчет = СтрСоединить(МассивНоменклатур,";");
		МассивСтруктурОтветов.Добавить(СтруктураОтвета);
	КонецЦикла;
	Если МассивСтруктурОтветов.Количество()= 0 Тогда 
		СтруктураОтвета = Новый Структура("ЗаявкаНаОплату, Контрагент, ДоговорКонтрагента, ТипРеестраПлатежей,
									  |ОтветственныйЗаОплату, СуммаПлатежаРуб, СуммаПлатежаВВалюте, Валюта,ДатаПланируемойОплаты,УсловиеОплаты, ПопадаетВОтборы, УслугиПТУСчет");

		МассивСтруктурОтветов.Добавить(СтруктураОтвета);
	КонецЕсли;
	Возврат МассивСтруктурОтветов;
	
КонецФункции		

&НаКлиенте
Процедура ДатаПриИзменении(Элемент) 
	
	Для Каждого СтрокаЗаявки из Объект.Заявки Цикл
		СтрокаЗаявки.СуммаПлатежаРуб = РаботаСКурсамиВалют.ПересчитатьВВалюту(СтрокаЗаявки.СуммаПлатежаВВалюте, СтрокаЗаявки.Валюта, ВалютаРегУчета, Объект.Дата);
	КонецЦикла;	
	
	Объект.СуммаИтогоВРублях = Объект.Заявки.Итог("СуммаПлатежаРуб");
	
КонецПроцедуры

&НаСервере
Процедура СформироватьОтборСтрок()
	
	Для Каждого СтрокаТЧ из Объект.Заявки Цикл
		СтрокаТЧ.ПопадаетВОтборы = Ложь;
	КонецЦикла;
	ОтборСтрок = Новый Структура("ПопадаетВОтборы", Истина);
	Элементы.Заявки.ОтборСтрок = Новый ФиксированнаяСтруктура(ОтборСтрок);

	
	ТаблицаЗаявок = Объект.Заявки.Выгрузить();	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВТ_Заявки.ЗаявкаНаОплату КАК ЗаявкаНаОплату,
	|	ВТ_Заявки.НомерСтроки КАК НомерСтроки,
	|	ВТ_Заявки.Контрагент КАК Контрагент,
	|	ВТ_Заявки.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ВТ_Заявки.ОтветственныйЗаОплату КАК ОтветственныйЗаОплату,
	|	ВТ_Заявки.СуммаПлатежаВВалюте КАК СуммаПлатежаВВалюте,
	|	ВТ_Заявки.СуммаПлатежаРуб КАК СуммаПлатежаРуб,
	|	ВТ_Заявки.Валюта КАК Валюта,
	|	ВТ_Заявки.УсловиеОплаты КАК УсловиеОплаты,
	|	ВТ_Заявки.ДатаПланируемойОплаты КАК ДатаПланируемойОплаты
	|ПОМЕСТИТЬ ВТ_Заявки
	|ИЗ
	|	&ТаблицаЗаявок КАК ВТ_Заявки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Заявки.ЗаявкаНаОплату КАК ЗаявкаНаОплату,
	|	ВТ_Заявки.НомерСтроки КАК НомерСтроки,
	|	ВТ_Заявки.Контрагент КАК Контрагент,
	|	ВТ_Заявки.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ВТ_Заявки.ОтветственныйЗаОплату КАК ОтветственныйЗаОплату,
	|	ВТ_Заявки.СуммаПлатежаВВалюте КАК СуммаПлатежаВВалюте,
	|	ВТ_Заявки.Валюта КАК Валюта,
	|	ВТ_Заявки.УсловиеОплаты КАК УсловиеОплаты,
	|	ВТ_Заявки.СуммаПлатежаРуб КАК СуммаПлатежаРуб,
	|	ВТ_Заявки.ДатаПланируемойОплаты КАК ДатаПланируемойОплаты
	|ИЗ
	|	ВТ_Заявки КАК ВТ_Заявки
	|ГДЕ
	|	&ДатаПланируемойОплаты
	|	и &УсловиеОплаты";
	
	Запрос.УстановитьПараметр("ТаблицаЗаявок", ТаблицаЗаявок);
	
	// отбор по датам
	МассивЗначенийПоДатам = Новый Массив;
	Для Каждого ЭлементСписка Из ОтборДатаОплаты Цикл
		Если ЭлементСписка.Пометка Тогда
			МассивЗначенийПоДатам.Добавить(ЭлементСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	//отборы по подразделениям
	МассивЗначенийПодразделений = Новый Массив;
	Для Каждого ЭлементСписка Из ОтборПодразделение Цикл
		Если ЭлементСписка.Пометка Тогда
			МассивЗначенийПодразделений.Добавить(ЭлементСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	
	// отбор условие оплаты
	МассивЗначенийУсловийОплаты = Новый Массив;
	Для Каждого ЭлементСписка Из ОтборУсловиеОплаты Цикл
		Если ЭлементСписка.Пометка Тогда
			МассивЗначенийУсловийОплаты.Добавить(ЭлементСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	Если МассивЗначенийПоДатам.Количество() = 0 И МассивЗначенийПодразделений.Количество() = 0 И МассивЗначенийУсловийОплаты.Количество() = 0 Тогда 
		Возврат
	Иначе 	
		//параметр запроса по дате
		Если МассивЗначенийПоДатам.Количество() Тогда		
			Запрос.УстановитьПараметр("ДатаПланируемойОплаты", МассивЗначенийПоДатам);
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДатаПланируемойОплаты", "ВТ_Заявки.ДатаПланируемойОплаты В(&ДатаПланируемойОплаты)");
		Иначе
			Запрос.УстановитьПараметр("ДатаПланируемойОплаты", Истина);
		КонецЕсли;	
		//параметр запроса по подразделению
		Если МассивЗначенийПодразделений.Количество() Тогда
			Запрос.УстановитьПараметр("ОтборГруппаПользователей", МассивЗначенийПодразделений);
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВТ_Заявки КАК ВТ_Заявки",
			"ВТ_Заявки КАК ВТ_Заявки
			|	Внутреннее СОЕДИНЕНИЕ Справочник.ГруппыПользователей.Состав КАК ГруппыПользователейСостав
			|	ПО (ГруппыПользователейСостав.Ссылка В (&ОтборГруппаПользователей))
			|	И (НЕ ГруппыПользователейСостав.Пользователь.Недействителен)
			|	И (НЕ ГруппыПользователейСостав.Пользователь.ПометкаУдаления)
			|	И (ВТ_Заявки.ЗаявкаНаОплату.ОтветственныйЗаОплату = ГруппыПользователейСостав.Пользователь)");
		КонецЕсли;
		// параметр запроса по условию оплаты
		Если МассивЗначенийУсловийОплаты.Количество() Тогда
			Запрос.УстановитьПараметр("УсловиеОплаты", МассивЗначенийУсловийОплаты);
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОплаты", "ВТ_Заявки.УсловиеОплаты В (&УсловиеОплаты)");
		Иначе 
			Запрос.УстановитьПараметр("УсловиеОплаты", Истина);
		КонецЕсли;
		
		Результат = Запрос.Выполнить().Выгрузить(); 
		
		Для Каждого СтрокаРезультата из Результат Цикл
			Объект.Заявки[СтрокаРезультата.НомерСтроки-1].ПопадаетВОтборы = Истина;
		КонецЦикла; 	
		
		Элементы.СписокЗаявокСуммаПлатежаРуб.ТекстПодвала = Результат.Итог("СуммаПлатежаРуб"); 
	КонецЕсли;

КонецПроцедуры	

Процедура СформироватьТаблицыДляОтбора(ПроставитьПометкиПоДате = Ложь)
	
	ОтборДатаОплаты.Очистить();
	ТЗДаты = Объект.Заявки.Выгрузить(,"ДатаПланируемойОплаты");
	ТЗДаты.Свернуть("ДатаПланируемойОплаты");
	ТЗДаты.Сортировать("ДатаПланируемойОплаты Возр");
	Для Каждого ДатаОплаты из ТЗДаты Цикл
	//	Если ЗначениеЗаполнено(ДатаОплаты.ДатаПланируемойОплаты) Тогда
			ОтборДатаОплаты.Добавить(ДатаОплаты.ДатаПланируемойОплаты);
	//	КонецЕсли;
	КонецЦикла;
		
	ТЗОтветственные = Объект.Заявки.Выгрузить(,"ОтветственныйЗаОплату");
	ТЗОтветственные.Свернуть("ОтветственныйЗаОплату");
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ГруппыПользователейСостав.Ссылка КАК ГруппаПользователя
		|ИЗ
		|	Справочник.ГруппыПользователей.Состав КАК ГруппыПользователейСостав
		|ГДЕ
		|	ГруппыПользователейСостав.Пользователь В(&Пользователи)
		|	И НЕ ГруппыПользователейСостав.Ссылка.ПометкаУдаления
		|	И ГруппыПользователейСостав.Ссылка В ИЕРАРХИИ(&ДКП)";
	
	Запрос.УстановитьПараметр("Пользователи", ТЗОтветственные);
	Запрос.УстановитьПараметр("ДКП", Справочники.ГруппыПользователей.ДирекцияКонтейнерныхПеревозок);
	РезультатЗапроса = Запрос.Выполнить();	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ОтборПодразделение.Очистить();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ОтборПодразделение.Добавить(ВыборкаДетальныеЗаписи.ГруппаПользователя);
	КонецЦикла;
	
	ОтборУсловиеОплаты.Очистить();
	ТЗДаты = Объект.Заявки.Выгрузить(,"УсловиеОплаты");
	ТЗДаты.Свернуть("УсловиеОплаты");
	Для Каждого ДатаОплаты из ТЗДаты Цикл 
	//	Если ЗначениеЗаполнено(ДатаОплаты.УсловиеОплаты) Тогда
			ОтборУсловиеОплаты.Добавить(ДатаОплаты.УсловиеОплаты);
	//	КонецЕсли;
	КонецЦикла;
	Если ПроставитьПометкиПоДате Тогда
		// ОтборУсловиеОплаты.ЗаполнитьПометки(Истина);
	    // ОтборПодразделение.ЗаполнитьПометки(Истина);
		 ОтборДатаОплаты.ЗаполнитьПометки(Истина);
	 КонецЕсли;
	 
КонецПроцедуры	                    

