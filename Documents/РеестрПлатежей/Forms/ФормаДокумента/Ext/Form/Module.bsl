Процедура АктуализироватьСписокВыбранныхДат(ДатаДляПроверки)
	
	Если НЕ ЗначениеЗаполнено(ДатаДляПроверки) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура("Дата",ДатаДляПроверки);
	РезультатПроверки = Объект.ВыбранныеДаты.НайтиСтроки(ПараметрыОтбора);
	Если РезультатПроверки.Количество() = 0 Тогда
		НоваяДата = Объект.ВыбранныеДаты.Добавить();
		НоваяДата.Дата = ДатаДляПроверки;
		Объект.ВыбранныеДаты.Сортировать("Дата Возр");
		Если Объект.ВыбранныеДаты.Количество() Тогда 
			ВыбранныеДатыРеестра.Очистить();
			Для Каждого ЭлементСписка Из Объект.ВыбранныеДаты Цикл
				ВыбранныеДатыРеестра.Добавить(ЭлементСписка.Дата);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	 	
КонецПроцедуры	

&НаКлиенте	
Процедура ОбработкаОтветаПользователяОчисткаЗаявок(ОтветПользователя = Неопределено, ДопПараметры = Неопределено)Экспорт
	
	Если ОтветПользователя = Неопределено Тогда
		Возврат;
	ИначеЕсли ОтветПользователя = КодВозвратаДиалога.Отмена тогда
		ВыбранныеДатыРеестра.Очистить();
		Для Каждого ДатаПериодаРеестра из Объект.ВыбранныеДаты Цикл
			ВыбранныеДатыРеестра.Добавить(ДатаПериодаРеестра.Дата);
		КонецЦикла;	
		ВыбранныеДатыРеестра.СортироватьПоЗначению(НаправлениеСортировки.Возр);	
	ИначеЕсли ОтветПользователя = КодВозвратаДиалога.Да Тогда // перезаполняем		
		Объект.Заявки.Очистить();
		СформироватьТаблицыДляОтбора();
		//Евросиб СубботинВ #128538 23.01.2026 Начало
		//Объект.СуммаИтогоВРублях = 0;
		ИтогоКОплатеРубли = 0;
		//Евросиб СубботинВ #128538 23.01.2026 Конец
		ВыбранныеДатыРеестраПриИзменении(ДопПараметры.Элемент);
	КонецЕсли; 
	
КонецПроцедуры

