		СписокКнопок.Добавить(КодВозвратаДиалога.ОК, "Очистить");
		СписокКнопок.Добавить(КодВозвратаДиалога.Отмена, "Отмена");		
		ОпОп = Новый ОписаниеОповещения("ОбработкаОтветаПользователяИзменениеВидаОперации", ЭтаФорма, Новый Структура("НовоеЗначение, ЗаполнениеНовымЗначением",ВыбранноеЗначение, Истина));
