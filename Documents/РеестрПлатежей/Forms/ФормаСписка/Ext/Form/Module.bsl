&НаКлиенте
Процедура ПеродДатОплатыПриИзменении(Элемент)
	ДатаНачалаПериодаОплаты    = ПериодДатОплаты.ДатаНачала; 
	ДатаОкончанияПериодаОплаты = КонецДня(ПериодДатОплаты.ДатаОкончания);
	НовыеДаты = Новый Структура;
	ДатаНачала = Список.Параметры.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ДатаНачалаПериодаОплаты"));
	Если Не ДатаНачала = Неопределено и НЕ ЗначениеЗаполнено(ПериодДатОплаты.ДатаНачала) Тогда
		 ДатаНачала.Использование = Ложь;
	 КонецЕсли;
	 
	 ДатаОкончания = Список.Параметры.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ДатаОкончанияПериодаОплаты"));
	 Если Не ДатаОкончания = Неопределено и НЕ ЗначениеЗаполнено(ПериодДатОплаты.ДатаОкончания) Тогда
		 ДатаОкончания.Использование = Ложь;
	 КонецЕсли; 
	
	Если ЗначениеЗаполнено(ДатаНачалаПериодаОплаты) Тогда  
		Список.Параметры.УстановитьЗначениеПараметра("ДатаНачалаПериодаОплаты",ДатаНачалаПериодаОплаты);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПериодДатОплаты.ДатаОкончания) Тогда		
		Список.Параметры.УстановитьЗначениеПараметра("ДатаОкончанияПериодаОплаты", ДатаОкончанияПериодаОплаты);
	КонецЕсли;
	
	//ЗаполнитьЗначенияСвойств(ЭтаФорма.Список.Параметры, НовыеДаты);

	ЭтаФорма.Элементы.Список.Обновить();
КонецПроцедуры
