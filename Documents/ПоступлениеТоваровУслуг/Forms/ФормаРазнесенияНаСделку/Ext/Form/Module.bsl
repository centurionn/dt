
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ПТУ") Тогда
		ПТУ = Параметры.ПТУ;
	КонецЕсли;
	Если Параметры.Свойство("НомерСтроки") Тогда
		НомерСтрокиЪ = Параметры.НомерСтроки;
	КонецЕсли;
	Если Параметры.Свойство("СуммаКРазнесению") Тогда
		СуммаКРазнесению = Параметры.СуммаКРазнесению;
	КонецЕсли;
	Если Параметры.Свойство("Перевыставляемые") Тогда
		Перевыставляемые = Параметры.Перевыставляемые;
	КонецЕсли;
	
	СтрокаПТУ = ПолучитьТекСтрокуПТУ(ПТУ, НомерСтрокиЪ)[0];
	
	ТЗСделок = ПолучитьДоступныеСделки(СтрокаПТУ,Неопределено,Перевыставляемые);
	Если Перевыставляемые Тогда
		ТЗСделок = ТЗСделок.Скопировать(,"Сделка,СтанцияОтправления,СтанцияНазначения,Клиент,Договор,Груз,Калькуляция,РазмерКТК,КолвоКТК,КолвоВаг,КолвоЖДН");
		ТЗСделок.Свернуть("Сделка,СтанцияОтправления,СтанцияНазначения,Клиент,Договор,Груз,Калькуляция,РазмерКТК","КолвоКТК,КолвоВаг,КолвоЖДН");
	Иначе
		ТЗСделок = ТЗСделок.Скопировать(,"Сделка,СтанцияОтправления,СтанцияНазначения,РазмерКТК,КолвоКТК,КолвоВаг,КолвоЖДН");
		ТЗСделок.Свернуть("Сделка,СтанцияОтправления,СтанцияНазначения","КолвоКТК,КолвоВаг,КолвоЖДН");
	КонецЕсли;
	
	СписокСделок.Загрузить(ТЗСделок);
	

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры

