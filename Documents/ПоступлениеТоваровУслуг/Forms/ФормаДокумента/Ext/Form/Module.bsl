&НаСервере
Процедура ЗаполнитьСтатусыПротоколовПоставщика()
	
	Если Объект.ПротоколПоставщика.Количество() > 0 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ПСЦ.Ссылка КАК Ссылка,
		|	ПСЦ.СтатусДокумента КАК СтатусДокумента
		|ИЗ
		|	Документ.ПСЦ КАК ПСЦ
		|ГДЕ
		|	ПСЦ.Ссылка В(&Протоколы)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПСЦПоставщика.Ссылка,
		|	ПСЦПоставщика.СтатусДокумента
		|ИЗ
		|	Документ.ПСЦПоставщика КАК ПСЦПоставщика
		|ГДЕ
		|	ПСЦПоставщика.Ссылка В(&Протоколы)";
		
		Протоколы = Объект.ПротоколПоставщика.Выгрузить(, "ПСЦ").ВыгрузитьКолонку("ПСЦ");
		Запрос.УстановитьПараметр("Протоколы", Протоколы);
		
		ТаблицаСтатусов = Запрос.Выполнить().Выгрузить();
		Для Каждого Стр Из Объект.ПротоколПоставщика Цикл
			СтрокаСтатуса = ТаблицаСтатусов.Найти(Стр.ПСЦ, "Ссылка");
			Если СтрокаСтатуса <> Неопределено Тогда
				Стр.СтатусДокумента = СтрокаСтатуса.СтатусДокумента;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

