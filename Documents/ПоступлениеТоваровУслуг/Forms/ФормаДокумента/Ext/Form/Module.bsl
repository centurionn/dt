	ТекД = Элементы.Услуги1.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораСделки", ЭтаФорма);
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ПТУ",Объект.Ссылка);
	ПараметрыОтбора.Вставить("НомерСтроки",ТекД.НомерСтроки);
	ПараметрыОтбора.Вставить("СуммаКРазнесению",ТекД.Всего);
	Если ИмяКоманды = "РазнестиКакПеревыставляемые" Тогда
		ПараметрыОтбора.Вставить("Перевыставляемые",Истина);
	Иначе
		ПараметрыОтбора.Вставить("Перевыставляемые",Ложь);
	КонецЕсли;
	ОткрытьФорму("Документ.ПоступлениеТоваровУслуг.Форма.ФормаРазнесенияНаСделку",ПараметрыОтбора ,, ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура РазнестиНаСделку(Команда)
	
	ОткрытьФормуРазнесения(Команда.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура РазнестиКакСобственные(Команда)
	ОткрытьФормуРазнесения(Команда.Имя);
КонецПроцедуры

&НаКлиенте
Процедура Услуги1ПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока И Копирование Тогда
		Элемент.ТекущиеДанные.ГУИДПТУ = Новый УникальныйИдентификатор();
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура Услуги1СуммаПриИзменении(Элемент)
	
	СтрТабЧасти = Элементы.Услуги1.ТекущиеДанные;
	БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(СтрТабЧасти,Объект.СуммаВключаетНДС);
	РассчитатьСуммыВсегоПоДокументу();
//Евросиб Гудкова( 22.10.2020 Ticket№ 0211393
	Если Объект.СуммаВключаетНДС Тогда
		Объект.ПолнаяСуммаВСФ = Объект.Услуги.Итог("Сумма") + Объект.Товары.Итог("Сумма");
	Иначе
		Объект.ПолнаяСуммаВСФ = Объект.Услуги.Итог("Сумма") + Объект.Услуги.Итог("СуммаНДС") + Объект.Товары.Итог("Сумма") + Объект.Товары.Итог("СуммаНДС");
	КонецЕсли;
// Евросиб Гудкова)

	//Евросиб Каблов 11.10.2023 ( Ticket#0317657
	СтрТабЧасти.ПолнаяСумма = СтрТабЧасти.Всего;
	СтрТабЧасти.ПолнаяСуммаНДС = СтрТабЧасти.СуммаНДС;
	//Евросиб Каблов 11.10.2023 )

КонецПроцедуры

&НаКлиенте
Процедура КопияПриИзменении(Элемент)
	
	Если Объект.Копия Тогда
		Объект.ДатаПолученияОригинала = '00010101';
		Элементы.ДатаПолученияОригинала.Доступность = Ложь;
	Иначе
		Объект.ДатаПолученияОригинала = ТекущаяДата();
		Элементы.ДатаПолученияОригинала.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаВключаетНДСПриИзменении(Элемент)
	
	Для Каждого СтрТЧ Из Объект.Услуги Цикл
		БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуСтрокиТабличнойЧасти(СтрТЧ);
		БухгалтерскийУчетОбщиеПроцедурыКлиент.ПересчитатьСуммыНДС(СтрТЧ,Объект.УчитыватьНДС,Объект.СуммаВключаетНДС);
		БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(СтрТЧ,Объект.СуммаВключаетНДС);
		//Евросиб Каблов 11.10.2023 ( Ticket#0317657
		СтрТЧ.ПолнаяСумма = СтрТЧ.Всего;
		СтрТЧ.ПолнаяСуммаНДС = СтрТЧ.СуммаНДС;
		//Евросиб Каблов 11.10.2023 )
	КонецЦикла;
		
	РассчитатьСуммыВсегоПоДокументу();
	Если Объект.СуммаВключаетНДС Тогда
		Объект.ПолнаяСуммаВСФ = Объект.Услуги.Итог("Сумма") + Объект.Товары.Итог("Сумма");
	Иначе
		Объект.ПолнаяСуммаВСФ = Объект.Услуги.Итог("Сумма") + Объект.Услуги.Итог("СуммаНДС") + Объект.Товары.Итог("Сумма") + Объект.Товары.Итог("СуммаНДС");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ЗаписанВСФ" Тогда
		РеквизитыСФ = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьРеквизитыСчетФактуры(Объект, "СчетФактураПолученный");
		Элементы.СчФНадпись.Заголовок = БухгалтерскийУчетОбщиеПроцедурыКлиент.ЗаполнитьНадписьСчФ(РеквизитыСФ);
//Евросиб Гудкова( 02.01.2021 Ticket№0218691 
		НомерВСФ = РеквизитыСФ.НомерВходящегоДокумента;
		ДатаВСФ = РеквизитыСФ.ДатаВходящегоДокумента;
// Евросиб Гудкова) 		

	// ++ Дудоров С.В. Ticket#61931 29.11.2022
	//// ++ ДИТ Сгонник, 21-10-26 №27109
	//ИначеЕсли ИмяСобытия = "ЗаписьПоступлениеТоваровУслуг" Тогда 
	//	ЭтаФорма.ОбновитьОтображениеДанных();
	//	ЭтаФорма.Прочитать();
	//	ОбновитьПанельТекущегоПользователя();
	//	ОбновитьПанельСостояний();
	//// -- ДИТ Сгонник, 21-10-26 №27109
	// -- Дудоров С.В. Ticket#61931 29.11.2022
		
	КонецЕсли;
КонецПроцедуры

//Евросиб Каблов 09.12.2020 Ticket#0216086
&НаКлиенте
Процедура РазрешенаВыгрузкаВУПППриИзменении(Элемент)
	
	Если Объект.РазрешенаВыгрузкаВУПП Тогда
		Объект.РазрешилВыгрузкуВУПП = ПользователиКлиент.ТекущийПользователь();
		Объект.ДатаРазрешенияВыгрузкиВУПП = ТекущаяДата();
		Элементы.РазрешенаВыгрузкаВУПП.Заголовок = СтрШаблон("Разрешена выгрузка в 1С УПП (%1;%2)", Объект.РазрешилВыгрузкуВУПП, Объект.ДатаРазрешенияВыгрузкиВУПП);
	Иначе
		Объект.РазрешилВыгрузкуВУПП = Неопределено;		
		Объект.ДатаРазрешенияВыгрузкиВУПП = '00010101';
		Элементы.РазрешенаВыгрузкаВУПП.Заголовок = "Разрешена выгрузка в 1С УПП";
	КонецЕсли;
		
КонецПроцедуры

//Евросиб Каблов 09.12.2020 Ticket#0216086
&НаСервере
Процедура УстановитьДоступностьРазрешенияВыгрузкиВУПП()
	
	ДоступностьФлажка = КонтрольДоступностиДокументов_сервер.ПроверитьДоступностьРоли("dc_РаботаСАкцептами");
	
	Если ДоступностьФлажка Тогда
		ДоступностьФлажка = ПоступлениеДоступноДляВыгрузкиВУПП();
	КонецЕсли;
	
	Элементы.РазрешенаВыгрузкаВУПП.Доступность = ДоступностьФлажка;
	
КонецПроцедуры

//Евросиб Каблов 09.12.2020 Ticket#0216086
&НаСервере
Функция ПоступлениеДоступноДляВыгрузкиВУПП()
	
	Если Не Объект.Проведен Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтранаКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Контрагент, "СтранаРегистрации");
	ЭтоРезидент = СтранаКонтрагента = ПредопределенноеЗначение("Справочник.СтраныМира.Россия");
	
	Если ЭтоРезидент Тогда
		ДоступноДляВыгрузки = Не Объект.Копия;
	Иначе
		ДоступноДляВыгрузки = Истина;
	КонецЕсли;
	
	Возврат ДоступноДляВыгрузки;
		
КонецФункции

