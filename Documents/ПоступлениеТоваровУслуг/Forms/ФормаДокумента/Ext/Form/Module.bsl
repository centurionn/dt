&НаСервере
Процедура ЗаписатьИВыгрузитьДокументПоступления(Параметры)

	Если Параметры.НеЗаписан Тогда
		ЗаписатьДокументПоступления();	
	КонецЕсли; 
	СчетчикВыгруженных = 0;
	СчетчикПовторов = 0;    
	Если Параметры.СчетЗаказ = Неопределено Тогда
		ТаблицаСчетов = Объект.СвязанныеСчетаПоставщиков.Выгрузить(,"СчетПоставщика");
	Иначе                           
		ТаблицаСчетов = Объект.СвязанныеСчетаПоставщиков.Выгрузить(Новый Структура("СчетПоставщика", Параметры.СчетЗаказ),"СчетПоставщика");
	КонецЕсли;
	ВыгрузитьСчетаВУППНаСервере(ТаблицаСчетов, СчетчикВыгруженных, СчетчикПовторов);
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По основаниям для заявок выгружено комплектов: " + СчетчикВыгруженных + ". Ранее выгружалось: " + СчетчикПовторов);
