&НаСервере
Процедура ВыгрузитьКЗПСервер()  
	
	МассивДокументов = Новый Массив;
	МассивДокументов.Добавить(Объект.Ссылка);
	ЕСОбменСервер.ВыгрузитьКЗПвУПП(МассивДокументов, Тип("ДокументСсылка.ПоступлениеТоваровУслуг"));
	ЗаявкиНаОплатуСервер.ПроверитьКомандыВыгрузкиВУПП(Этаформа, Тип("ДокументСсылка.ПоступлениеТоваровУслуг"), Объект.Ссылка);

		
