&НаСервереБезКонтекста
Функция ОбновитьСтатусЭДО(Ссылка)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Диадок_Документы.Документ КАК Документ,
	|	Диадок_Документы.Статус КАК Статус
	|ИЗ
	|	Справочник.Диадок_Документы КАК Диадок_Документы
	|ГДЕ
	|	Диадок_Документы.Документ =&Документ";
	Запрос.УстановитьПараметр("Документ", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Статус;
	Иначе	
		Возврат "";
	КонецЕсли; 	

КонецФункции // ОбновитьСтатусЭДО()
 
