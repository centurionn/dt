&НаКлиенте
Процедура ВыгрузитьЗаказВУПП(Команда)
	
	Отказ = Ложь;
	
//ДИТ Давудов М.А. Task 33123 (Ticket#0194926) 16.06.2021 Начало
	ОчиститьСообщения();
	
	//Евросиб Каблов 12.08.2022 ( Task 55578
	Если Не ЗначениеЗаполнено(Объект.Ответственный) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнено поле Менеджер по договору!");
		Возврат;
	КонецЕсли;
	//Евросиб Каблов 12.08.2022 )
	
	Если Объект.ДоговорКонтрагента <> ПредопределенноеЗначение("Справочник.ДоговорыКонтрагентов.ПустаяСсылка")
	   И НЕ ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(Объект.ДоговорКонтрагента, "ПолученОригинал") Тогда 
	   
	   	// ДИТ Поморцева Т.П.  Task 33123 (Ticket#0194926) 22.06.2021 начало
		//ТекстОшибки = НСтр("ru = 'Отсутствует оригинал договора ""%Договор%""'");
		//ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Договор%", Объект.ДоговорКонтрагента);
		
		//ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки,,,, Отказ);
		
		//Если Отказ Тогда
		//	Возврат;
		//КонецЕсли;
		
		СтруктураДат = Новый Структура("Дата,СрокПредоставленияОригиналаДней,СрокПредоставленияОригиналаДата");
		ДанныеДоговора = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(Объект.ДоговорКонтрагента,СтруктураДат);
																		
		КолДнейОсталось = Число(НачалоДня(ДанныеДоговора.СрокПредоставленияОригиналаДата) - (НачалоДня(ТекущаяДата()) )) / (60 * 60 * 24);		
		Если КолДнейОсталось > 0 Тогда
			ТекстОшибки = НСтр("ru = 'Отсутствует оригинал договора. Срок предоставления оригинала " + Формат(ДанныеДоговора.СрокПредоставленияОригиналаДата,"ДФ=dd.MM.yyyy") + ". Платежи по договору будут заблокированы через ""%КолДней%"" дней'");
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "%КолДней%", КолДнейОсталось);
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Договор%", Объект.ДоговорКонтрагента);
		
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки,,,, Отказ);
			
		Иначе
			ТекстОшибки = НСтр("ru = 'Платежи по договору ""%Договор%"" заблокированы по причине непредоставления оригинала договора. 
									|Для возобновления платежей необходимо согласование финансового директора на продление периода предоставления оригинала'");
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "%КолДней%", КолДнейОсталось);
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Договор%", Объект.ДоговорКонтрагента);
		
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки,,,, Отказ);

			Если Отказ Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		// ДИТ Поморцева Т.П.  Task 33123 (Ticket#0194926) 22.06.2021 конец
	КонецЕсли;
//ДИТ Давудов М.А. Task 33123 (Ticket#0194926) 16.06.2021 Конец

	НеЗаписан = ЭтаФорма.Модифицированность или Не Объект.Проведен;                                        
	СчетЗаказ = Неопределено;
	Если Команда.Имя = "ВыгрузитьЗаказВУПППоСтрокеСвязанныхСчетов" Тогда
		СчетЗаказ = Элементы.СвязанныеСчетаПоставщиков.ТекущиеДанные.СчетПоставщика;
		СоздатьЗаказПоПТУ = НЕ ЗначениеЗаполнено(СчетЗаказ);
	Иначе
		СоздатьЗаказПоПТУ = Объект.СвязанныеСчетаПоставщиков.НайтиСтроки(Новый Структура("СчетПоставщика", Неопределено)).Количество()>0;
	КонецЕсли;
	//Евросиб - АСуслов 06.02.2024 13:02:07 #78327
