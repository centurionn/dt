&НаКлиенте
Процедура ОстатокОплатитьНаОснованииПТУ(Команда)
	
	СчетаПоставщиковСумма = Объект.СвязанныеСчетаПоставщиков.Итог("СуммаНаПТУ");
	ОтнесеннаяСуммаОтнесенныхСчетов = 0;
	Для каждого Стр из Объект.СвязанныеСчетаПоставщиков Цикл
		Если ЗначениеЗаполнено(Стр.СчетПоставщика) Тогда ОтнесеннаяСуммаОтнесенныхСчетов = ОтнесеннаяСуммаОтнесенныхСчетов + Стр.СуммаНаПТУ; КонецЕсли;
	КонецЦикла;
	
	//Евросиб Каблов 09.10.2020 (
	//Если (Объект.СуммаДокумента-ОтнесеннаяСуммаОтнесенныхСчетов) = 0 Тогда Возврат; КонецЕсли;
	Если (Объект.ПолнаяСуммаВСФ-ОтнесеннаяСуммаОтнесенныхСчетов) = 0 Тогда Возврат; КонецЕсли;
	//Евросиб Каблов 09.10.2020 )
	
	МассивНС = Объект.СвязанныеСчетаПоставщиков.НайтиСтроки(Новый Структура("СчетПоставщика", ПредопределенноеЗначение("Документ.СчетНаОплатуПоставщика.ПустаяСсылка")));
	Для каждого Стр из МассивНС Цикл
		Объект.СвязанныеСчетаПоставщиков.Удалить(Стр);
	КонецЦикла;
	
	НСтр = Объект.СвязанныеСчетаПоставщиков.Добавить();
	//Евросиб Каблов 09.10.2020 (
	//НСтр.СуммаНаПТУ = Объект.СуммаДокумента-ОтнесеннаяСуммаОтнесенныхСчетов;
	НСтр.СуммаНаПТУ = Объект.ПолнаяСуммаВСФ-ОтнесеннаяСуммаОтнесенныхСчетов;
	//Евросиб Каблов 09.10.2020 )
		
	СвязанныеСчетаПоставщиковПриИзменении(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДетализацию(Команда)
	
//Евросиб Гудкова( 19.01.2020 переделала процедуру, чтобы она не меняла данные формы при открытии формы на чтение или после записи объекта
	Если Команда <> неопределено Тогда //заполнение по кнопке
		Объект.СвязьУслугИСчетов.Очистить();
		Для каждого СтрУслуги из Объект.Услуги Цикл
			Если НЕ ЗначениеЗаполнено(СтрУслуги.ГУИДПТУ) Тогда
				СтрУслуги.ГУИДПТУ = Строка(Новый УникальныйИдентификатор);
			КонецЕсли;
			
			СтрНайдена = Ложь;
			Для каждого СтрСвязи из Объект.СвязьУслугИСчетов Цикл
				Если СтрСвязи.ГУИДПТУ = СтрУслуги.ГУИДПТУ Тогда
					ЗаполнитьЗначенияСвойств(СтрСвязи, СтрУслуги, "Номенклатура,Содержание,СписокТС,СписокТЕ,СписокТД");
					СтрНайдена = Истина;
				КонецЕсли;
			КонецЦикла;
			
			//Евросиб Каблов 11.10.2023 ( Ticket#0317657
			//Если НЕ СтрНайдена и СтрУслуги.Всего <> 0 Тогда
			//	НСтр = Объект.СвязьУслугИСчетов.Добавить();
			//	ЗаполнитьЗначенияСвойств(НСтр, СтрУслуги, "Номенклатура,Содержание,СписокТС,СписокТЕ,СписокТД,Всего,ГУИДПТУ,СуммаНДС,СтавкаНДС");
			//КонецЕсли;
			Если НЕ СтрНайдена И (СтрУслуги.Всего <> 0 Или СтрУслуги.ПолнаяСумма <> 0) Тогда			
				НСтр = Объект.СвязьУслугИСчетов.Добавить();
				ЗаполнитьЗначенияСвойств(НСтр, СтрУслуги, "Номенклатура,Содержание,СписокТС,СписокТЕ,СписокТД,Всего,ГУИДПТУ,СуммаНДС,СтавкаНДС,ПолнаяСумма,ПолнаяСуммаНДС");
			КонецЕсли;
			//Евросиб Каблов 11.10.2023 )
		КонецЦикла;
	Иначе //обновление отображения
		ОбновитьДетализациюНаСервере();
	КонецЕсли;
// Евросиб Гудкова) 	

КонецПроцедуры                         

