	КонецЦикла;
	Если ЗначениеЗаполнено(ТекД.СчетПоставщика) Тогда
		ПолученнаяСуммаСчета = ПолучитьСуммуСчета(ТекД.СчетПоставщика);
		//СуммаДокументаРуб = РаботаСКурсамиВалют.ПересчитатьВВалюту(, Объект.ВалютаДокумента, ВалютаРеглУчета, объект.Дата);
		ТекД.СуммаНаПТУ = Макс(Мин(ПолученнаяСуммаСчета, Объект.СуммаДокумента-СуммаТаблицыПривязанныхСчетов+ТекД.СуммаНаПТУ), 0);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСуммуСчета(СчетПоставщика)
	
	Рез = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПривязанныеСчетаПоставщиковОстатки.СуммаОстаток КАК ОсталосьПривязать
	|ИЗ
	|	РегистрНакопления.ПривязанныеСчетаПоставщиков.Остатки(, СчетПоставщика = &СчетПоставщика) КАК ПривязанныеСчетаПоставщиковОстатки";
	Запрос.УстановитьПараметр("СчетПоставщика", СчетПоставщика);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Рез = Ответ.ОсталосьПривязать;
	КонецЕсли;
	
	Возврат Рез;
	
КонецФункции

