	//		ОбщегоНазначенияКлиент.СообщитьПользователю("Перед созданием заявки на оплату необходимо заполнить Дату оплаты", , "ДатаОплаты",, Отказ);
	//	КонецЕсли; 
	//	//Если Не ЗначениеЗаполнено(Объект.СтатьяДвиженияДенежныхСредств) Тогда
	//	//	ОбщегоНазначенияКлиент.СообщитьПользователю("Перед созданием заявки на оплату необходимо заполнить Статью ДДС", Объект, "СтатьяДвиженияДенежныхСредств","Объект.СтатьяДвиженияДенежныхСредств", Отказ);
	//	//КонецЕсли;
	//	Если Отказ Тогда
	//		Возврат;
	//	КонецЕсли; 
	//КонецЕсли;                                                                                                                              
	//)
	//Евросиб - АСуслов 06.02.2024 13:02:09 #78327
	
	ПараметрыОбработки = Новый Структура("НеЗаписан, СчетЗаказ", НеЗаписан, СчетЗаказ);
	ОповещениеОтветаВопроса = Новый ОписаниеОповещения("ОбработкаВопросаСчет", ЭтаФорма, ПараметрыОбработки);
	Если НеЗаписан Тогда
		ПоказатьВопрос(ОповещениеОтветаВопроса, "Перед выгрузкой заказа ПТУ необходимо провести. Продолжить?", РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Нет);
	Иначе
