Процедура excel_ВставитьИзEXCEL(Команда)
	
	// SIV 21-05-21 Логику данного блока скопировал у Михаила, зачем отменять проведение перед вставкой - не знаю.
	
	//Евросиб Шевченко А.В. US 108445 TA 110185 21.05.2025
	ЕстьАктуальныйАкцепт = НЕ СтатусРазнесения = ПредопределенноеЗначение("Перечисление.СостоянияАвторазнесения.НетАктуальногоАкцепта") И НЕ СтатусРазнесения = ПредопределенноеЗначение("Перечисление.СостоянияАвторазнесения.АкцептНеСоздан");
	//Евросиб Шевченко А.В. US 108445 TA 110185 21.05.2025
	Если Объект.Проведен И ЕстьАктуальныйАкцепт Тогда //Евросиб Шевченко А.В. US 108445 TA 110185 21.05.2025
		ПодтверждениеОтменыПроведенияПередВставкойEXCEL = Новый ОписаниеОповещения("ПодтверждениеОтменыПроведенияПередВставкойEXCEL", ЭтаФорма);
		ПоказатьВопрос(ПодтверждениеОтменыПроведенияПередВставкойEXCEL, "Необходимо отменить проведение акцепта. Продолжить?", РежимДиалогаВопрос.ДаНет);
	Иначе
		ПодтверждениеОтменыПроведенияПередВставкойEXCEL(КодВозвратаДиалога.Да, Истина);
	КонецЕсли;
	
КонецПроцедуры
 
&НаКлиенте
Процедура ПодтверждениеОтменыПроведенияПередВставкойEXCEL(П1 = неопределено, НеНадоРаспроводить = Ложь) Экспорт
	
	Если П1 <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;
	
	Если НеНадоРаспроводить <> Истина Тогда
		ПроведениеОтменено = Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
		Если ПроведениеОтменено = Ложь Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось выполнить отмену проведения акцепта. Вставка вагонов и КТК не выполнена.");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ОбработкаВставкиДанныхExcelВПТУ = Новый ОписаниеОповещения("ОбработкаВставкиДанныхExcelВПТУ", ЭтаФорма);
	ОткрытьФорму("Документ.ПоступлениеТоваровУслуг.Форма.ФормаВставкиИзEXCEL", Новый Структура("СуммаВключаетНДС", Объект.СуммаВключаетНДС),,ЭтаФорма.УникальныйИдентификатор,,,ОбработкаВставкиДанныхExcelВПТУ, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВставкиДанныхExcelВПТУ(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если ТипЗнч(П1) <> Тип("Массив") Тогда Возврат; КонецЕсли;
	
	// Евросиб Фролов (02.11.2021 Ticket№ 0247409
	МассивЖДН = Новый Массив;
	Для Каждого СтрокаМассива Из П1 Цикл
		Если ЗначениеЗаполнено(СтрокаМассива.ЖДН) И МассивЖДН.Найти(СтрокаМассива.ЖДН) = Неопределено Тогда
			МассивЖДН.Добавить(СтрокаМассива.ЖДН);	
		КонецЕсли;	
	КонецЦикла;
	НомераТранспортныхДокументов = ПолучитьНомераТранспортныхДокументов(МассивЖДН);
	// Евросиб Фролов)
	
	Для каждого Стр из П1 Цикл
		
		НСтр = Объект.Услуги.Добавить();
		ЗаполнитьЗначенияСвойств(НСтр, Стр);
		
		НСтр.ГУИДПТУ = Новый УникальныйИдентификатор();
		
		НСтр.СписокТЕ = Стр.Контейнер;
		НСтр.СписокТС = Стр.Вагон;
		
		// Евросиб Фролов (02.11.2021 Ticket№ 0247409
		//НСтр.СписокТД = ПолучитьКодЖДН(Стр.ЖДН); закомментировал
		НСтр.СписокТД = НомераТранспортныхДокументов.Получить(Стр.ЖДН);
		// Евросиб Фролов)
		
		БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуСтрокиТабличнойЧасти(НСтр);
		БухгалтерскийУчетОбщиеПроцедурыКлиент.ПересчитатьСуммыНДС(НСтр, Объект.УчитыватьНДС, Объект.СуммаВключаетНДС);
		БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(НСтр, Объект.СуммаВключаетНДС);
		//Евросиб Каблов 11.10.2023 ( Ticket#0317657
		НСтр.ПолнаяСумма = НСтр.Всего;
		НСтр.ПолнаяСуммаНДС = НСтр.СуммаНДС;
		//Евросиб Каблов 11.10.2023 )
		
	КонецЦикла;
	
	РассчитатьСуммыВсегоПоДокументу();
	Услуги1ПриИзменении(неопределено);
	
КонецПроцедуры

