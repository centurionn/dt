Процедура ВыгрузитьСчетаВУППНаСервере(СсылкиСчетов, СчетчикВыгруженных, СчетчикПовторов)

	МассивСсылок = Новый Массив;
	Для каждого СсылкаСчета Из СсылкиСчетов Цикл
		Отказ = Ложь;
		Ответ = РегистрыСведений.ПротоколОбменов.ПроверитьВыгрузку(СсылкаСчета.СчетПоставщика, Перечисления.УзлыОбмена.УППЗаказ, Перечисления.ДействияПриОбмене.ВыгрузкаДанных);
		Если ЗначениеЗаполнено(Ответ.Ссылка) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Заказ на основании " + СсылкаСчета.СчетПоставщика + " уже выгружался в УПП " + Ответ.ДатаОбмена + " пользователем " 
													+ Ответ.Ответственный + ". Повторная выгрузка не требуется.",,,,Отказ);
			СчетчикПовторов = СчетчикПовторов + 1;
			Продолжить;
		КонецЕсли; 
		//Евросиб - АСуслов 06.02.2024 13:03:34 #78327
		//(
		//Если Не ЗначениеЗаполнено(СсылкаСчета.СчетПоставщика.ДатаОплаты) Тогда
		//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Перед созданием заявки на оплату в Счете необходимо заполнить Дату оплаты",, СсылкаСчета.СчетПоставщика.ДатаОплаты,, Отказ);
		//КонецЕсли;
		//)
		//Евросиб - АСуслов 06.02.2024 13:03:36 #78327
		//Если Не ЗначениеЗаполнено(СсылкаСчета.СчетПоставщика.СтатьяДвиженияДенежныхСредств) Тогда
		//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Перед созданием заявки на оплату в Счете необходимо заполнить Статью ДДС", СсылкаСчета.СчетПоставщика,,, Отказ);
		//КонецЕсли;
		Если Отказ Тогда
			Продолжить;
		КонецЕсли; 
		Если ТипЗнч(СсылкаСчета.СчетПоставщика) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
			ВыгрузитьЗаказВУППНаСервере(СсылкаСчета.СчетПоставщика, СчетчикВыгруженных, СчетчикПовторов);
		Иначе	
			МассивСсылок.Добавить(СсылкаСчета.СчетПоставщика);
		КонецЕсли; 
	КонецЦикла; 	

	Если МассивСсылок.Количество() > 0 Тогда
		ЕСОбменСервер.ПередатьЗаказЗаявкуВУПП(МассивСсылок, "СчетНаОплатуПоставщика", 1);
	КонецЕсли; 
	СчетчикВыгруженных = СчетчикВыгруженных + МассивСсылок.Количество();
	
