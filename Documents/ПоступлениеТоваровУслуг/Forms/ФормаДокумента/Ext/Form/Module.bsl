&НаКлиенте
Процедура ОбработкаВыбораСчета(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если параметр1 = Неопределено тогда 
		возврат; 
	КонецЕсли;
	
	Параметр2.СчетПоставщика =  Параметр1;
	
	// по умолчанию сумма счета = сумме остатка по оплате ПТУ
	//Евросиб Каблов 09.10.2020 (
	//СуммаТекСчета = Объект.СуммаДокумента - Объект.СвязанныеСчетаПоставщиков.Итог("СуммаНаПТУ");
	СуммаТекСчета = Объект.ПолнаяСуммаВСФ - Объект.СвязанныеСчетаПоставщиков.Итог("СуммаНаПТУ");
	//Евросиб Каблов 09.10.2020 )
	
	//мультивалютка
	СписокСумм = ПолучитьСписокСчетов(Объект.Дата,Объект.Контрагент,Объект.ДоговорКонтрагента,Параметр1);
	//Если СписокСумм.Количество()>0 Тогда
	//	СуммаТекСчета = Мин(СуммаТекСчета,СписокСумм[0].Значение);
	//КонецЕсли;
	Для каждого СтруктураСчета Из СписокСумм Цикл
		Если СтруктураСчета.Значение.Счет = Параметр1 Тогда
			СуммаТекСчета = Мин(СуммаТекСчета,СтруктураСчета.Значение.СуммаСчетаОстаток);
		КонецЕсли;
	КонецЦикла;               
	//мультивалютка
	
	Параметр2.СуммаНаПТУ = СуммаТекСчета;
	//Евросиб Каблов 09.10.2020 (
	//Элементы.СвязанныеСчетаПоставщиковОстатокОплатитьНаОснованииПТУ.Заголовок = "Остаток (" + (Объект.СуммаДокумента - Объект.СвязанныеСчетаПоставщиков.Итог("СуммаНаПТУ")) + ") оплатить на основании ПТУ";
	Элементы.СвязанныеСчетаПоставщиковОстатокОплатитьНаОснованииПТУ.Заголовок = "Остаток (" + (Объект.ПолнаяСуммаВСФ - Объект.СвязанныеСчетаПоставщиков.Итог("СуммаНаПТУ")) + ") оплатить на основании ПТУ";
	//Евросиб Каблов 09.10.2020 ) 
	
	//Евросиб Коханенко Н.А. 22.09.2023 (( Ticket#0325508 #75277 
	ИзменениеСтрокиСчетаПоставщиков();
	//Евросиб Коханенко Н.А. 22.09.2023 )) Ticket#0325508 #75277 
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСсылкуКонтурЭДОНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Диадок_Документы.BoxId КАК BoxId,
	|	Диадок_Документы.DocumentId КАК DocumentId,
	|	Диадок_Документы.LetterId КАК LetterId
	|ИЗ
	|	Справочник.Диадок_Документы КАК Диадок_Документы
	|ГДЕ
	|	Диадок_Документы.Документ = &Документ";
	Запрос.УстановитьПараметр("Документ", Объект.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		//ШаблонАдрес = "https://diadoc.kontur.ru/%1/Document/Show?letterId=%2&documentId=%3";
		ШаблонАдрес = Константы.ШаблонАдресаДокументаВДиадок.Получить();
		Адрес = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонАдрес,
																		Выборка.BoxId,
																		Выборка.LetterId,
																		Выборка.DocumentId);
																		
	Иначе
		Адрес = Неопределено;																
	КонецЕсли;
	Возврат Адрес;
КонецФункции

