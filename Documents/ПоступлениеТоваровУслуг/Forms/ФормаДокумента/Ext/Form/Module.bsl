&НаСервере
Процедура ПересчитатьСуммыДокументаПоВалютеВзаиморасчетов(СтруктураТекущая,СтруктураНовая)
	Для каждого Стр из Объект.Услуги Цикл
		Стр.Всего = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Стр.Всего, СтруктураТекущая,СтруктураНовая);
		Стр.Сумма = ?(Объект.СуммаВключаетНДС, Стр.Всего,Стр.Всего/(1+(БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Стр.СтавкаНДС)/100)));
		Стр.СуммаНДС = ?(Объект.СуммаВключаетНДС,  Стр.Всего*БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Стр.СтавкаНДС)/100,Стр.Всего- Стр.Сумма);
		Стр.Цена = Стр.Сумма/Стр.Количество;
	КонецЦикла;
КонецПроцедуры

