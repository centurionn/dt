Процедура РассчитатьСуммыВсегоПоДокументу()
	
	ИтогиВсегоНДС = ?(Объект.Товары.Количество()>0, Объект.Товары.Итог("СуммаНДС"),0)+?(Объект.Услуги.Количество()>0,Объект.Услуги.Итог("СуммаНДС"),0);
	ИтогиВсего = ?(Объект.Товары.Количество()>0, Объект.Товары.Итог("Сумма"),0)+ ?(Объект.Услуги.Количество()>0,Объект.Услуги.Итог("Сумма"),0)+?(Объект.СуммаВключаетНДС,0,ИтогиВсегоНДС);
//Евросиб Гудкова( 14.01.2020 втф
	//Попытка
	//	Объект.СуммаДокумента = ИтогиВсего;
	//Исключение
	//КонецПопытки;
// Евросиб Гудкова) 	
	Элементы.Валюта.Заголовок = Объект.ВалютаДокумента;
	
