&НаКлиенте
Процедура ОткрытьФормуВыбораДокумента(Ссылка, ТекущиеДанные)
	
	ИмяФормыВыбора = ПолучитьИмяФормыВыбораПоСсылке(Ссылка);
	
	ПараметрыОтбора  = Новый Структура;        
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.СчетНаОплатуПоставщика") Тогда
    	ПараметрыОтбора.Вставить("СписокДоступныхСчетов", ПолучитьСписокСчетов(Объект.Дата,Объект.Контрагент,Объект.ДоговорКонтрагента,Неопределено));
		ПараметрыОтбора.Вставить("Контрагент",Объект.Контрагент);
		ПараметрыОтбора.Вставить("ДоговорКонтрагента",Объект.ДоговорКонтрагента);
	КонецЕсли;
    
	ОпОп = новый ОписаниеОповещения("ОбработкаВыбораСчета", ЭтаФорма, ТекущиеДанные);
	ОткрытьФорму(ИмяФормыВыбора,ПараметрыОтбора ,, ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокСчетов(ДатаДок,Контрагент,Договор,СчетПоставщика)
	
	СписокСчетов = Новый СписокЗначений;
	
	Запрос = Новый Запрос(
	   "ВЫБРАТЬ
	   |	ОстаткиПоСчетам.СчетПоставщика КАК Номенклатура,
	   |	ОстаткиПоСчетам.СчетПоставщика КАК Счет,
	   |	ОстаткиПоСчетам.СуммаОстаток КАК СуммаСчетаОстаток
	   |ИЗ
	   |	РегистрНакопления.ПривязанныеСчетаПоставщиков.Остатки(
	   //|			&МоментВремени,
	   //|			СчетПоставщика.Контрагент = &Контрагент
	   //|				И СчетПоставщика.ДоговорКонтрагента = &Договор
	   //ДИТ, Беляев СЮ, Ticket#0309546, 16-05-2023, начало
	   |			,
	   |			СчетПоставщика.Контрагент = &Контрагент
	   |				И СчетПоставщика.ДоговорКонтрагента = &Договор
	   //|				И СчетПоставщика.Дата <= &ДатаПоступления //ДИТ, Беляев СЮ, Ticket#0309546, 24-05-2023, закомментировал, согласовано отключение условия по дате
	   //ДИТ, Беляев СЮ, Ticket#0309546, 16-05-2023, конец
   	   |) КАК ОстаткиПоСчетам
	   |ГДЕ
	   |	ОстаткиПоСчетам.СуммаОстаток > 0");
	   
    //ГраницаКонтроля = Новый Граница(ДатаДок, ВидГраницы.Включая);
    //Запрос.УстановитьПараметр("МоментВремени", ГраницаКонтроля);
    //ДИТ, Беляев СЮ, Ticket#0309546, 16-05-2023, начало
    //Запрос.УстановитьПараметр("ДатаПоступления", КонецДня(ДатаДок)); //ДИТ, Беляев СЮ, Ticket#0309546, 24-05-2023, закомментировал, согласовано отключение условия по дате
    //ДИТ, Беляев СЮ, Ticket#0309546, 16-05-2023, конец
    Запрос.УстановитьПараметр("Контрагент", Контрагент);
    Запрос.УстановитьПараметр("Договор", Договор);
 
    РезультатЗапроса = Запрос.Выполнить();
    
    ТЗ = РезультатЗапроса.Выгрузить();
    Для Каждого СТр Из ТЗ Цикл
   	 	Если СчетПоставщика = Неопределено Тогда
			СписокСчетов.Добавить(Стр.Счет);
		Иначе
			СписокСчетов.Добавить(Новый Структура("Счет, СуммаСчетаОстаток", Стр.Счет, Стр.СуммаСчетаОстаток));
		КонецЕсли;
	КонецЦикла;
   
	Возврат СписокСчетов;
	
КонецФункции	
	
