
&НаКлиенте
Процедура Перенести(Команда)
	
	Если НЕ ЗначениеЗаполнено(ЗаполняемаяУслуга) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбрана «Заполняемая услуга»");
		Возврат;
	КонецЕсли; 
	СсылкаАктПостановки = Неопределено;
	
    //Евросиб СубботинВ #82679 18.06.2024 Начало
	Для Каждого Стр из Таб Цикл
		Если НЕ Стр.РасчитаннаяКонтрольнаяЦифра = Стр.ПользовательскаяКонтрольнаяЦифра Тогда 
			ОбщегоНазначенияКлиент.СообщитьПользователю("Для контейнера " + СокрЛП(Стр.ПрочитаннаяСтрока) 
			+ " ожидаемое контрольное число " + Стр.РасчитаннаяКонтрольнаяЦифра + ". Перенос отменен."); 
			Возврат
		КонецЕсли;
	КонецЦикла;
	//Евросиб СубботинВ #82679 18.06.2024 Конец
	Результат = Новый Массив;
	Для каждого Стр из Таб Цикл
		ДанныеСтроки = Новый Структура;
		ДанныеСтроки.Вставить("ПоступлениеНоменклатура", 			ЗаполняемаяУслуга);
		ДанныеСтроки.Вставить("Содержание", 						Содержание);
		ДанныеСтроки.Вставить("ПоступлениеВагоны", 					Стр.Вагон);
		//Евросиб СубботинВ #82679 18.06.2024 Начало
		//ДанныеСтроки.Вставить("ПоступлениеКТК", 					Стр.КТК);  исходная 
		Если ЗначениеЗаполнено(Стр.КТК) Тогда
			Контейнер = Стр.КТК; 
		// Евросиб TA 89165 Рыбьяков К.А. 05.08.2024 ((
		//Иначе
		ИначеЕсли ЗначениеЗаполнено(Стр.ПрочитаннаяСтрока) Тогда
		// Евросиб Рыбьяков К.А. 05.08.2024 ))
			СозданныйКтк = СоздатьЧерезАктПостановки(Стр.ПрочитаннаяСтрока, СсылкаАктПостановки, Стр.РазмерКТК, Истина);
			Контейнер = СозданныйКтк.КТК;
			СсылкаАктПостановки = СозданныйКтк.АктПостановки;
		КонецЕсли;
		ДанныеСтроки.Вставить("ПоступлениеКТК", 					Контейнер);
		//Евросиб СубботинВ #82679 18.06.2024 Конец
		ДанныеСтроки.Вставить("ПоступлениеКоличество", 				1);
		ДанныеСтроки.Вставить("ПоступлениеЦена", 					Стр.Сумма);
		ДанныеСтроки.Вставить("ПоступлениеСумма", 					Стр.Сумма);
		ДанныеСтроки.Вставить("НачалоРасчета", 						Стр.НачалоРасчета);
		ДанныеСтроки.Вставить("ОкончаниеРасчета", 					Стр.ОкончаниеРасчета);
		ДанныеСтроки.Вставить("НачалоОказанияУслуги", 				Стр.НачалоОказанияУслуги);
		ДанныеСтроки.Вставить("ОкончаниеОказанияУслуги", 			Стр.ОкончаниеОказанияУслуги);
		ДанныеСтроки.Вставить("ПоступлениеСтавкаНДС", 				ПоступлениеСтавкаНДС);
		ДанныеСтроки.Вставить("ИдентификаторСтрокиПоступления",		ИдентификаторСтрокиПоступления);
		ДанныеСтроки.Вставить("СтанцияОтправления", 				Стр.СтанцияОтправления);
		ДанныеСтроки.Вставить("СтанцияНазначения", 					Стр.СтанцияНазначения);
		ДанныеСтроки.Вставить("ТранспортныйДокумент", 				Стр.ТранспортныйДокумент);
		ДанныеСтроки.Вставить("ПоступлениеСуммаПоСтроке", 			ПоступлениеСумма);
		ДанныеСтроки.Вставить("ПоступлениеСуммаНДСПоСтроке", 		ПоступлениеСуммаНДС);
		Результат.Добавить(ДанныеСтроки);
	КонецЦикла;
	
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьЪ(Команда)
	
	//Евросиб Каблов 27.06.2023 ( 64831 Перенес в серверную процедуру
	ПрочитатьСервер();
	//Евросиб Каблов 27.06.2023 )
	
КонецПроцедуры

