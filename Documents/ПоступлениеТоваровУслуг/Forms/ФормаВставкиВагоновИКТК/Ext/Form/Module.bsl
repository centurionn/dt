	КонецЕсли;
	
	Параметры.Свойство("Поступление", Поступление);
	
	НоменклатураФрахт = Константы.УслугаФрахтаДляКалькуляции.Получить();
	
	//Евросиб(ДИТ), Беляев СЮ, US 91053 / TA 91139, 05-09-2024, начало
	КонтейнерыИВагоны = Новый Структура;
	Если Параметры.Свойство("КонтейнерыИВагоны", КонтейнерыИВагоны) Тогда
		РежимВставкиКомментариевВДиалог = Истина;
		Элементы.Группа3.Видимость = Ложь;
		Элементы.Таб.Видимость = Ложь;
		ЗаполнитьКонтейнерыИВагоныВТЧ(КонтейнерыИВагоны);
	КонецЕсли;
	//Евросиб(ДИТ), Беляев СЮ, US 91053 / TA 91139, 05-09-2024, конец

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
	
	//Евросиб(ДИТ), Беляев СЮ, US 91053 / TA 91139, 05-09-2024, начало
	Если РежимВставкиКомментариевВДиалог Тогда
		Команда = ЭтаФорма.Элементы.Добавить("ПеренестиКомментарии", Тип("КнопкаФормы"), ЭтаФорма.КоманднаяПанель);
		Команда.Заголовок	= "Перенести комментарии";
		Команда.ИмяКоманды  = "ПеренестиКомментарии";
	//Евросиб(ДИТ), Беляев СЮ, US 91053 / TA 91139, 05-09-2024, конец
	Иначе
		//Евросиб СубботинВ #82679 18.06.2024 Начало сделал програмно. чтобы кнопка добавлялась в конец командной панели после инструкций
		Команда = ЭтаФорма.Элементы.Добавить("ПрочитатьЪ", Тип("КнопкаФормы"), ЭтаФорма.КоманднаяПанель);
		Команда.Заголовок	= "Прочитать";
		Команда.ИмяКоманды  = "ПрочитатьЪ";
		//Евросиб СубботинВ #82679 18.06.2024 Конец
	КонецЕсли;
	
	//Евросиб Каблов 16.12.2024 ( #94192
	ПроверятьДоступныеТипыЛокацииНоменклатуры = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ПроверятьДоступныеТипыЛокацииНоменклатуры", Ложь);
    //Евросиб Каблов 16.12.2024 )
	
КонецПроцедуры

