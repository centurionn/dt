//Евросиб Каблов 16.12.2024 ( #94192
Процедура ВыполнитьПроверкуВыбранныхСтанцийПоДоступнымТипомЛокацийНоменклатуры()
	
	ДоступныеТипыЛокаций = НоменклатураСервер.ПолучитьДоступныеТипыЛокацийПоНоменклатуре(ЗаполняемаяУслуга);
	СтрокаДоступныеТипыЛокаций = СтрСоединить(ДоступныеТипыЛокаций, ", ");
	ПроверенныеСтанции = Новый Массив;	
	
	ЛокацияПустаяСсылка = Справочники.Локации.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(ДоступныеТипыЛокаций) Тогда
		Для Каждого НСтр Из Таб Цикл
			Если ЗначениеЗаполнено(НСтр.СтанцияОтправления) И ПроверенныеСтанции.Найти(НСтр.СтанцияОтправления) = Неопределено Тогда
				Если ДоступныеТипыЛокаций.Найти(НСтр.СтанцияОтправления.Тип) = Неопределено Тогда
					ТекстСообщения = СтрШаблон("Станция %1 не соответствует доступным типам локаций услуги. Доступные типы локаций: %2", НСтр.СтанцияОтправления, СтрокаДоступныеТипыЛокаций);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
					НСтр.СтанцияОтправления = ЛокацияПустаяСсылка;
				КонецЕсли;
				ПроверенныеСтанции.Добавить(НСтр.СтанцияОтправления);
			КонецЕсли;
			Если ЗначениеЗаполнено(НСтр.СтанцияНазначения) И ПроверенныеСтанции.Найти(НСтр.СтанцияНазначения) = Неопределено Тогда
				Если ДоступныеТипыЛокаций.Найти(НСтр.СтанцияНазначения.Тип) = Неопределено Тогда
					ТекстСообщения = СтрШаблон("Станция %1 не соответствует доступным типам локаций услуги. Доступные типы локаций: %2", НСтр.СтанцияНазначения, СтрокаДоступныеТипыЛокаций);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
					НСтр.СтанцияНазначения = ЛокацияПустаяСсылка;
				КонецЕсли;
				ПроверенныеСтанции.Добавить(НСтр.СтанцияНазначения);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры
//Евросиб Каблов 16.12.2024 )

//Евросиб(ДИТ), Беляев СЮ, US 91053 / TA 91139, 05-09-2024, начало
&НаКлиенте
Процедура ПеренестиКомментарии(Команда)
	
	СтрокаРезультат = "";
	
	СчетчикСтрок = 2;
	СтрокаВагон = ТЧ.Область("R"+Формат(СчетчикСтрок, "ЧГ=0")+"C1").Текст;
	СтрокаКонтейнер = ТЧ.Область("R"+Формат(СчетчикСтрок, "ЧГ=0")+"C2").Текст;
	
	Пока СтрокаВагон <> "" ИЛИ СтрокаКонтейнер <> "" Цикл
		
		СтрокаКомментарий = ТЧ.Область("R"+Формат(СчетчикСтрок, "ЧГ=0")+"C3").Текст;
		
		Если СтрокаКомментарий <> "" Тогда
			Если СтрокаВагон <> "" Тогда
				СтрокаРезультат = СтрокаРезультат + СтрокаВагон + " - " + СтрокаКомментарий + Символы.ПС;
			КонецЕсли;
			Если СтрокаКонтейнер <> "" Тогда
				СтрокаРезультат = СтрокаРезультат + СтрокаКонтейнер + " - " + СтрокаКомментарий + Символы.ПС;
			КонецЕсли;
		КонецЕсли;
		
		СчетчикСтрок = СчетчикСтрок + 1;
		СтрокаВагон = ТЧ.Область("R"+Формат(СчетчикСтрок, "ЧГ=0")+"C1").Текст;
		СтрокаКонтейнер = ТЧ.Область("R"+Формат(СчетчикСтрок, "ЧГ=0")+"C2").Текст;
	КонецЦикла;
	
	Закрыть(СтрокаРезультат);
КонецПроцедуры
//Евросиб(ДИТ), Беляев СЮ, US 91053 / TA 91139, 05-09-2024, конец

