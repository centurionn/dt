&НаСервере
Процедура ПрочитатьСервер()
	
	Сч = 2;
	Таб.Очистить();
	
	СсылкаАктаПостановки = неопределено;
	//Евросиб СубботинВ #82679 18.06.2024 Начало
	МассивСтрокБезРазмера = Новый Массив;
	МассивНовыхКТК = Новый Массив;
	МассивНовыхКТКБезРазмера = Новый Массив;
	МассивКткСИнформациейИзКарточки = Новый Массив;
	МассивКривыхРефКтк = Новый Массив;
	//Евросиб СубботинВ #82679 18.06.2024 Конец
	
	//Евросиб Каблов 16.12.2024 ( #94192
	Если ПроверятьДоступныеТипыЛокацииНоменклатуры Тогда
		ДоступныеТипыЛокаций = НоменклатураСервер.ПолучитьДоступныеТипыЛокацийПоНоменклатуре(ЗаполняемаяУслуга);
		СтрокаДоступныеТипыЛокаций = СтрСоединить(ДоступныеТипыЛокаций, ", ");
		ПроверенныеСтанции = Новый Массив;
	КонецЕсли;
	
	ЛокацияПустаяСсылка = Справочники.Локации.ПустаяСсылка();
	//Евросиб Каблов 16.12.2024 )
	
	ПрочСтрока = ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C1").Текст;
	ПрочСтрока2 = ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C2").Текст;
	Пока ПрочСтрока <> "" ИЛИ ПрочСтрока2 <> "" Цикл
		НСтр = Таб.Добавить();
		нСтр.ИдентификаторСтроки = Новый УникальныйИдентификатор;  
		нСтр.Поступление = Поступление;
		нСтр.Номенклатура = ЗаполняемаяУслуга;  
		нСтр.НомерТранспортногоДокумента = ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C4").Текст;
		Если ЗначениеЗаполнено(ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C1").Текст) Тогда
			НСтр.Вагон = НайтиВагон(ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C1").Текст);
		КонецЕсли;
		Если ЗначениеЗаполнено(ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C2").Текст) Тогда
			НСтр.КТК = РаботаСКонтейнерамиСервер.НайтиКТК(ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C2").Текст);
			//Евросиб СубботинВ #82679 18.06.2024 Начало
			НСтр.ПрочитаннаяСтрока = СокрЛП(ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C2").Текст);
			УказанныйТипоразмерКТК = СокрЛП(ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C3").Текст);
						
			Если НСтр.КТК = Справочники.ТЕ.ПустаяСсылка() Тогда // ктк НОВЫЙ
				НовыйКтк = Истина;
				Если ЗначениеЗаполнено(УказанныйТипоразмерКТК) Тогда
					МассивНовыхКТК.Добавить(НСтр.ПрочитаннаяСтрока);
				Иначе
					МассивНовыхКТКБезРазмера.Добавить(НСтр.ПрочитаннаяСтрока);
				КонецЕсли;
				//Проверяем контрольные числа
				КонтрольнаяЦифра = РаботаСКонтейнерамиСервер.ПолучитьКонтрольноеЧисло(Лев(НСтр.ПрочитаннаяСтрока, 4), Сред(НСтр.ПрочитаннаяСтрока, 5, 6));
				Нстр.РасчитаннаяКонтрольнаяЦифра = КонтрольнаяЦифра;
				Нстр.ПользовательскаяКонтрольнаяЦифра = Прав(НСтр.ПрочитаннаяСтрока, 1);
				Если СтрДлина(СокрЛП(НСтр.ПрочитаннаяСтрока)) <> 11  
					ИЛИ КонтрольнаяЦифра = "Неверно" 
					ИЛИ (СтрДлина(СокрЛП(НСтр.ПрочитаннаяСтрока)) = 11 И НЕ Число(Прав(НСтр.ПрочитаннаяСтрока, 1)) = Нстр.РасчитаннаяКонтрольнаяЦифра) Тогда
						ОбщегоНазначения.СообщитьПользователю("Для контейнера " + СокрЛП(НСтр.ПрочитаннаяСтрока) + " ожидаемое контрольное число " + Нстр.РасчитаннаяКонтрольнаяЦифра);
				   		ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C2").ЦветФона = WebЦвета.Розовый;
					Иначе
						Если ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C2").ЦветФона = WebЦвета.Розовый Тогда							
							ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C2").ЦветФона = WebЦвета.Белый;
						КонецЕсли;
				КонецЕсли;
				//КонецПроверки
			
			ИначеЕсли ЗначениеЗаполнено(НСтр.КТК) Тогда //КТК уже существует
				НовыйКтк = Ложь;
				РазмерКонтейнераИзКарточки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НСтр.КТК, "ТипТЕ");
				Если НЕ Строка(РазмерКонтейнераИзКарточки) = УказанныйТипоразмерКТК Тогда
					МассивКткСИнформациейИзКарточки.Добавить(НСтр.КТК);
				КонецЕсли;				
				НСтр.РазмерКТК = РазмерКонтейнераИзКарточки;
			КонецЕсли;
				
			Если НЕ ЗначениеЗаполнено(НСтр.РазмерКТК) Тогда
				Если ЗначениеЗаполнено(УказанныйТипоразмерКТК) Тогда
					Если РефрижераторныйКТК Тогда
						МассивКорректныхТипоразмеров = Новый Массив;
						МассивКорректныхТипоразмеров.Добавить("20");
						МассивКорректныхТипоразмеров.Добавить("40");
						МассивКорректныхТипоразмеров.Добавить("45");						
						МассивКорректныхТипоразмеров.Добавить("20RF");
						МассивКорректныхТипоразмеров.Добавить("40RFH");
						МассивКорректныхТипоразмеров.Добавить("45RFH");
						Если МассивКорректныхТипоразмеров.Найти(УказанныйТипоразмерКТК) = Неопределено Тогда
							НСтр.РазмерКТК = Справочники.ТипоразмерыТЕ.ПустаяСсылка();
							НомерТекущейСтроки = Сч-1;					
							МассивКривыхРефКтк.Добавить(Строка(НомерТекущейСтроки));
							ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C3").ЦветФона = WebЦвета.Розовый;
							//Сообщить();		
						Иначе	
							НСтр.РазмерКТК = РаботаСКонтейнерамиСервер.НайтиТипПоРазмеру(УказанныйТипоразмерКТК, РефрижераторныйКТК, НСтр.ПрочитаннаяСтрока).Тип;
							Если ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C3").ЦветФона = WebЦвета.Розовый Тогда
								ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C3").ЦветФона = WebЦвета.Белый;
							КонецЕсли;
						КонецЕсли;	
					Иначе
						НСтр.РазмерКТК = РаботаСКонтейнерамиСервер.НайтиТипПоРазмеру(УказанныйТипоразмерКТК, , НСтр.ПрочитаннаяСтрока).Тип;
					КонецЕсли;
				Иначе
					Если Не НовыйКТК Тогда
						МассивСтрокБезРазмера.Добавить(НСтр.ПрочитаннаяСтрока);	
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			            
            //Евросиб СубботинВ #82679 18.06.2024 Конец
			
			
		//Евросиб СубботинВ #82679 18.06.2024 Начало // убрал создание КТК при чтении таблицы
			//Если НЕ ЗначениеЗаполнено(НСтр.КТК) Тогда				
				//СтрКТК = СоздатьЧерезАктПостановки(ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C2").Текст, СсылкаАктаПостановки);  перенес и дополнил функционал на кнопку перенести
			//	СтрКТК = СоздатьЧерезАктПостановки(ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C2").Текст, СсылкаАктаПостановки, Истина); Перенести в доработку
			// 	НСтр.КТК = СтрКТК.КТК;
			//	НСтр.АктПостановки = СтрКТК.АктПостановки;
			//	СсылкаАктаПостановки = СтрКТК.АктПостановки;
			
			//КонецЕсли;
		//Евросиб СубботинВ #82679 18.06.2024 Конец

		КонецЕсли;
		//Евросиб Каблов 03.02.2020 ( Ticket#0185661
		//НСтр.Сумма = Число(ТЧ.Область("R"+Сч+"C8").Текст);
		СуммаСтрокой = ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C9").Текст;
		Если ЗначениеЗаполнено(СуммаСтрокой) Тогда
			НСтр.Сумма = Число(СуммаСтрокой);
		КонецЕсли;
		//Евросиб Каблов 03.02.2020 )
		
		//НСтр.ТранспортныйДокумент 		= НайтиЖДНПоНомеру(ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C3").Текст);
		//Евросиб Каблов 27.06.2023 ( 64831
		//НСтр.НачалоРасчета 				= РаспознатьДату(ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C4").Текст);
		//НСтр.ОкончаниеРасчета 			= РаспознатьДату(ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C5").Текст);
		//НСтр.НачалоОказанияУслуги 		= РаспознатьДату(ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C6").Текст);
		//НСтр.ОкончаниеОказанияУслуги 	= РаспознатьДату(ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C7").Текст);
		НСтр.НачалоРасчета 				= СтроковыеФункцииКлиентСервер.СтрокаВДату(ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C5").Текст);
		НСтр.ОкончаниеРасчета 			= СтроковыеФункцииКлиентСервер.СтрокаВДату(ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C6").Текст);
		НСтр.НачалоОказанияУслуги 		= СтроковыеФункцииКлиентСервер.СтрокаВДату(ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C7").Текст);
		НСтр.ОкончаниеОказанияУслуги 	= СтроковыеФункцииКлиентСервер.СтрокаВДату(ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C8").Текст);
		//Евросиб - АСуслов 13.12.2020 18:35:31 #
		//(
		СтанцияОтправленияСтрокой = ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C10").Текст;
		СтанцияНазначенияСтрокой  = ТЧ.Область("R"+Формат(Сч, "ЧГ=0")+"C11").Текст;
		Если ЗначениеЗаполнено(СтанцияОтправленияСтрокой) Тогда
			НСтр.СтанцияОтправления 		= Локации_сервер.НайтиСтанциюПоНеполномуКоду(СтанцияОтправленияСтрокой);
			
			Если НЕ ЗначениеЗаполнено(НСтр.СтанцияОтправления) Тогда
				НСтр.СтанцияОтправления = Справочники_Локации_НайтиПоНаименованию(СтанцияОтправленияСтрокой); //Локации_сервер.ПолучитьЛокациюПоНечеткомуПоиску(СтанцияОтправленияСтрокой, Ложь, Ложь);
			КонецЕсли;
			
		КонецЕсли; 
		Если ЗначениеЗаполнено(СтанцияНазначенияСтрокой) Тогда
			
			НСтр.СтанцияНазначения = Локации_сервер.НайтиСтанциюПоНеполномуКоду(СтанцияНазначенияСтрокой);
			
			Если НЕ ЗначениеЗаполнено(НСтр.СтанцияНазначения) Тогда
				НСтр.СтанцияНазначения = Справочники_Локации_НайтиПоНаименованию(СтанцияНазначенияСтрокой); //Локации_сервер.ПолучитьЛокациюПоНечеткомуПоиску(СтанцияНазначенияСтрокой, Ложь, Ложь);
			КонецЕсли;
			
		КонецЕсли; 
		//)
		//Евросиб - АСуслов 13.12.2020 18:35:32 #
		
		//Евросиб Каблов 16.12.2024 ( #94192
		Если ЗначениеЗаполнено(ДоступныеТипыЛокаций) Тогда
			Если ЗначениеЗаполнено(НСтр.СтанцияОтправления) И ПроверенныеСтанции.Найти(НСтр.СтанцияОтправления) = Неопределено Тогда
				Если ДоступныеТипыЛокаций.Найти(НСтр.СтанцияОтправления.Тип) = Неопределено Тогда
					ТекстСообщения = СтрШаблон("Станция %1 не соответствует доступным типам локаций услуги. Доступные типы локаций: %2", НСтр.СтанцияОтправления, СтрокаДоступныеТипыЛокаций);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
					НСтр.СтанцияОтправления = ЛокацияПустаяСсылка;
				КонецЕсли;
				ПроверенныеСтанции.Добавить(НСтр.СтанцияОтправления);
			КонецЕсли;
			Если ЗначениеЗаполнено(НСтр.СтанцияНазначения) И ПроверенныеСтанции.Найти(НСтр.СтанцияНазначения) = Неопределено Тогда
				Если ДоступныеТипыЛокаций.Найти(НСтр.СтанцияНазначения.Тип) = Неопределено Тогда
					ТекстСообщения = СтрШаблон("Станция %1 не соответствует доступным типам локаций услуги. Доступные типы локаций: %2", НСтр.СтанцияНазначения, СтрокаДоступныеТипыЛокаций);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
