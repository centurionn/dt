&НаСервере
Процедура ЗаполнитьКонтейнерыИВагоныВТЧ(КонтейнерыИВагоны)
	Для сч = 1 По 13 Цикл
		ТЧ.Область("R1C"+сч).Текст = "";
	КонецЦикла;
	ТЧ.Область("R1C1").Текст = "Вагон";
	ТЧ.Область("R1C2").Текст = "Контейнер";
	ТЧ.Область("R1C3").Текст = "Комментарий";
	СчетчикСтрок = 2;
	Для Каждого ТекВагон Из КонтейнерыИВагоны.Вагоны Цикл
		ТЧ.Область("R"+СчетчикСтрок+"C1").Текст = Строка(ТекВагон);
		СчетчикСтрок = СчетчикСтрок + 1;
	КонецЦикла;
	Для Каждого ТекКонтейнер Из КонтейнерыИВагоны.Контейнеры Цикл
		ТЧ.Область("R"+СчетчикСтрок+"C2").Текст = Строка(ТекКонтейнер);
		СчетчикСтрок = СчетчикСтрок + 1;
	КонецЦикла;
