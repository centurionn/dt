		// Заполнение шапки
		БанковскийСчетКонтрагента = ДанныеЗаполнения.БанковскийСчетКонтрагента;
		БанковскийСчетОрганизации = ДанныеЗаполнения.БанковскийСчетОрганизации;
		//Гудкова ВалютаДокумента = ДанныеЗаполнения.ВалютаДокумента;
		//Гудкова ДатаВходящегоДокумента = ДанныеЗаполнения.ДатаВходящегоДокумента;
		ДоговорКонтрагента = ДанныеЗаполнения.ДоговорКонтрагента;
		ВалютаДокумента = ДоговорКонтрагента.ВалютаВзаиморасчетов; //Гудкова
		Комментарий = ДанныеЗаполнения.Комментарий;
		Грузоотправитель = ДанныеЗаполнения.Контрагент;
		Контрагент = ДанныеЗаполнения.Контрагент;
		Организация = ДанныеЗаполнения.Организация;
		Грузополучатель = ДанныеЗаполнения.Организация;
		//Гудкова Ответственный = ДанныеЗаполнения.Ответственный;
		ПодразделениеОрганизации = ДанныеЗаполнения.ПодразделениеОрганизации;
 		СчетНаОплатуПоставщика = ДанныеЗаполнения.Ссылка;
		СуммаВключаетНДС = ДанныеЗаполнения.СуммаВключаетНДС;
		СуммаДокумента = ДанныеЗаполнения.СуммаДокумента;
		УчитыватьНДС = ДанныеЗаполнения.УчитыватьНДС;
		Для Каждого ТекСтрокаТовары Из ДанныеЗаполнения.Товары Цикл
			Если ТекСтрокаТовары.Номенклатура.Услуга Тогда
				НоваяСтрока = Услуги.Добавить();
				НоваяСтрока.Количество = ТекСтрокаТовары.Количество;
				НоваяСтрока.Номенклатура = ТекСтрокаТовары.Номенклатура;
				НоваяСтрока.Содержание = ТекСтрокаТовары.Содержание;
				НоваяСтрока.СтавкаНДС = ТекСтрокаТовары.СтавкаНДС;
				НоваяСтрока.Сумма = ТекСтрокаТовары.Сумма;
				НоваяСтрока.СуммаНДС = ТекСтрокаТовары.СуммаНДС;
				НоваяСтрока.Цена = ТекСтрокаТовары.Цена;
//Евросиб Гудкова( 17.11.2020 Ticket№ 
				НоваяСтрока.Всего = ТекСтрокаТовары.Сумма + ?(СуммаВключаетНДС, 0, ТекСтрокаТовары.СуммаНДС);
// Евросиб Гудкова) 				
			Иначе	
				НоваяСтрока = Товары.Добавить();
				НоваяСтрока.ЕдиницаИзмерения = ТекСтрокаТовары.ЕдиницаИзмерения;
				НоваяСтрока.Количество = ТекСтрокаТовары.Количество;
				НоваяСтрока.Номенклатура = ТекСтрокаТовары.Номенклатура;
				НоваяСтрока.СтавкаНДС = ТекСтрокаТовары.СтавкаНДС;
				НоваяСтрока.Сумма = ТекСтрокаТовары.Сумма;
				НоваяСтрока.СуммаНДС = ТекСтрокаТовары.СуммаНДС;
				НоваяСтрока.Цена = ТекСтрокаТовары.Цена;
			КонецЕсли;
		КонецЦикла;
		НСтр 					= СвязанныеСчетаПоставщиков.Добавить();
		НСтр.СчетПоставщика 	= ДанныеЗаполнения;
		НСтр.СуммаНаПТУ 		= ДанныеЗаполнения.СуммаДокумента;
	КонецЕсли;
	
	//Евросиб Каблов 12.08.2022 ( Task 55578	
	Ответственный = Справочники.ДоговорыКонтрагентов.ПолучитьОтветственногоЗаДоговор(ДоговорКонтрагента);
	//Евросиб Каблов 12.08.2022 )
	
	//Гудкова РезультатВалюта = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаДокумента,ТекущаяДата());
	//Гудкова КратностьВзаиморасчетов = РезультатВалюта.Кратность;
	//Гудкова КурсВзаиморасчетов = РезультатВалюта.Курс;
	
КонецПроцедуры

