Функция ПолучитьМассивКонтейнеровДокумента()
	
	ОписаниеТиповСтрока11 = Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(11));
	
	ТаблицаКонтейнеров = Новый ТаблицаЗначений;
	ТаблицаКонтейнеров.Колонки.Добавить("КТК", 	ОписаниеТиповСтрока11);
	
	Для Каждого ТекущийКТК Из Услуги Цикл
		
		МассивПредставленийКТК = СтрРазделить(ТекущийКТК.СписокТЕ, ";", Ложь);
		Для Каждого ПредставлениеКТК из МассивПредставленийКТК Цикл	
			СтрокаКТК = ТаблицаКонтейнеров.Добавить();
			СтрокаКТК.КТК = ПредставлениеКТК;		
		КонецЦикла;		
		
	КонецЦикла;
	
	// По полученным КТК определяем закрывающие документы и проверяем наличие аннулирования.
	// Если закрывающие документы проведены и не аннулированы, то в строке устанавливаем признак "СформированыЗакрывающиеДокументы".
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаКонтейнеров.КТК КАК КТК
	|ПОМЕСТИТЬ втТаблицаКонтейнеров
	|ИЗ
	|	&ТаблицаКонтейнеров КАК ТаблицаКонтейнеров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЕ.Ссылка КАК КТК
	|ИЗ
	|	втТаблицаКонтейнеров КАК втТаблицаКонтейнеров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТЕ КАК ТЕ
	|		ПО втТаблицаКонтейнеров.КТК = ТЕ.Наименование
	|			И (НЕ ТЕ.ПометкаУдаления)";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("ТаблицаКонтейнеров", ТаблицаКонтейнеров);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаКонтейнеров = РезультатЗапроса.Выгрузить();
	
	Возврат ТаблицаКонтейнеров.ВыгрузитьКолонку("КТК");
	
КонецФункции	

