Процедура ПроверитьЗаполнитьСвязанныеСчетаПоставщиков() Экспорт
	
	СчетаПоставщиковСумма = СвязанныеСчетаПоставщиков.Итог("СуммаНаПТУ");
	ОтнесеннаяСуммаОтнесенныхСчетов = 0;
	Для каждого Стр из СвязанныеСчетаПоставщиков Цикл
		Если ЗначениеЗаполнено(Стр.СчетПоставщика) Тогда ОтнесеннаяСуммаОтнесенныхСчетов = ОтнесеннаяСуммаОтнесенныхСчетов + Стр.СуммаНаПТУ; КонецЕсли;
	КонецЦикла;
	
	Разница = ПолнаяСуммаВСФ-ОтнесеннаяСуммаОтнесенныхСчетов;
	Если (Разница) = 0 Тогда Возврат; КонецЕсли;
		
	МассивНС = СвязанныеСчетаПоставщиков.НайтиСтроки(Новый Структура("СчетПоставщика", ПредопределенноеЗначение("Документ.СчетНаОплатуПоставщика.ПустаяСсылка")));
	Для каждого Стр из МассивНС Цикл
		СвязанныеСчетаПоставщиков.Удалить(Стр);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		СтрокиПоПТУ = СвязанныеСчетаПоставщиков.НайтиСтроки(Новый Структура("СчетПоставщика", Ссылка));
		Если СтрокиПоПТУ.Количество() > 0 Тогда
			СтрокиПоПТУ[0].СуммаНаПТУ = СтрокиПоПТУ[0].СуммаНаПТУ + Разница;
			Разница = 0;
	    КонецЕсли;
	КонецЕсли;
	
	Если Разница <> 0 Тогда
		НСтр = СвязанныеСчетаПоставщиков.Добавить();
		НСтр.СуммаНаПТУ = Разница;
	КонецЕсли;
	
КонецПроцедуры

Функция РублеваяСумма(ИсхСумма)
	ВалютаРег = Константы.ВалютаРегламентированногоУчета.Получить();
	Если ВалютаДокумента <> ВалютаРег Тогда
		СуммаРуб = РаботаСКурсамиВалют.ПересчитатьВВалюту(ИсхСумма,ВалютаДокумента,ВалютаРег,Дата);
		Возврат СуммаРуб;
	Иначе
		Возврат ИсхСумма;
	КонецЕсли;
КонецФункции

Функция ПолучитьСуммыИзТаблицыСоответствия(Счет)
	МассивРезультата = Новый Массив;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("СчетПоставщика", Счет);
	
	ВыборкаСтрок = СвязьУслугИСчетов.Выгрузить(ПараметрыОтбора);
	Если ВыборкаСтрок.Количество() > 0 Тогда
		ВыборкаСтрок.Свернуть("СтавкаНДС","ОтнесеннаяСумма, СуммаНДС");
		Для каждого Стр из ВыборкаСтрок Цикл
			СтруктураСумм = Новый Структура;
			СтруктураСумм.Вставить("СтавкаНДС",Стр.СтавкаНДС);
			СтруктураСумм.Вставить("СуммаИтого",Стр.ОтнесеннаяСумма);
			СтруктураСумм.Вставить("СуммаНДС",Стр.СуммаНДС);
			МассивРезультата.Добавить(СтруктураСумм);
		КонецЦикла;
	КонецЕсли;
	
	Возврат МассивРезультата;
	
КонецФункции

