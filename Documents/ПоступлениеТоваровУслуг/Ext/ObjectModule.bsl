Процедура СообщитьПользователюИДобавитьОшибкиВДополнительныеСвойства( ТекстОшибки, Отказ = Ложь )
	ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,,,,Отказ);
	Если НЕ ДополнительныеСвойства.Свойство("ТекстОшибкиЗаписиДокумента") Тогда
		ДополнительныеСвойства.Вставить("ТекстОшибкиЗаписиДокумента", ТекстОшибки);
	Иначе
		ДополнительныеСвойства.ТекстОшибкиЗаписиДокумента = Строка(ДополнительныеСвойства.ТекстОшибкиЗаписиДокумента) 
															+ Символы.ПС + ТекстОшибки;	
	КонецЕсли;
														
КонецПроцедуры
//ДИТ, Беляев СЮ, BUG 82750 / TA 83060, 28-03-2024, конец

//ДИТ, Беляев СЮ, BUG 82750 / TA 83060, 28-03-2024, начало
Процедура ОчиститьДополнительныеСвойства_ТекстОшибкиЗаписиДокумента()
	Если ДополнительныеСвойства.Свойство("ТекстОшибкиЗаписиДокумента") Тогда
		ДополнительныеСвойства.Вставить("ТекстОшибкиЗаписиДокумента", "");
	КонецЕсли;
КонецПроцедуры
