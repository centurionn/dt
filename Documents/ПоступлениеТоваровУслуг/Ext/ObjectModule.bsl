		|		КОНЕЦ
		|		ТОГДА ИСТИНА
		|	ИНАЧЕ Диадок_Документы.СостояниеДокументооборота = ""Подписан""
		|			ИЛИ Диадок_Документы.СостояниеДокументооборота = ""Откорректирован""
		|			ИЛИ Диадок_Документы.СостояниеДокументооборота = ""Документооборот завершен""
		|				И Диадок_Документы.СостояниеДокументооборотаДоп В (""Согласован"", """")
		|КОНЕЦ КАК ОшибкаВСтатусах,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ПротоколОбменов.ДатаОбмена, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ПротоколОбменов.ДатаОбмена < ПоступлениеТоваровУслуг.ДатаМодификации
		|	КОНЕЦ = ЛОЖЬ КАК ОшибкаВДатеМодификации,
		|	ПоступлениеТоваровУслуг.Регламентный = ЛОЖЬ КАК ОшибкаНеРегламентный,
		|	ВЫБОР
		|		КОГДА ПоступлениеТоваровУслуг.Контрагент.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
		|			ТОГДА НЕ ПоступлениеТоваровУслуг.Копия
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ = ЛОЖЬ КАК ОшибкаЭтоКопия,
		|	ВЫБОР
		|		КОГДА ПротоколОбменов.ДатаОбмена ЕСТЬ NULL
		|			ТОГДА ПоступлениеТоваровУслуг.СуммаДокумента > 0
		|		ИНАЧЕ ПоступлениеТоваровУслуг.СуммаДокумента >= 0
		|	КОНЕЦ = ЛОЖЬ КАК ОшибкаСуммаДокумента,
		|	(НЕ ВыгруженныеЗаказыПоПТУ.Ссылка ЕСТЬ NULL
		|		ИЛИ ПоступлениеТоваровУслуг.ДоговорКонтрагента.РасчетыПоДоговоруВЦелом
		|		ИЛИ ПоступлениеТоваровУслуг.Контрагент.РазделятьЗатратыПоОрганизациямАвизо) = ЛОЖЬ КАК ОшибкаНеВыгруженЗаказ,
		|	ПоступлениеТоваровУслуг.РазрешенаВыгрузкаВУПП = ЛОЖЬ КАК ОшибкаНеРазрешенаВыгрузка
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
		|		ПО ПоступлениеТоваровУслуг.Ссылка = ПротоколОбменов.Объект
		|			И (ПротоколОбменов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных))
		|			И (ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УПП))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК Контрагенты
		|		ПО ПоступлениеТоваровУслуг.Контрагент = Контрагенты.Объект
		|			И (Контрагенты.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
		|			И (Контрагенты.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.БитФинанс))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ДоговорыКонтрагентов
		|		ПО ПоступлениеТоваровУслуг.ДоговорКонтрагента = ДоговорыКонтрагентов.Объект
		|			И (ДоговорыКонтрагентов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
		|			И (ДоговорыКонтрагентов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.БитФинанс))
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВыгруженныеЗаказыПоПТУ КАК ВыгруженныеЗаказыПоПТУ
		|		ПО ПоступлениеТоваровУслуг.Ссылка = ВыгруженныеЗаказыПоПТУ.Ссылка
		|			И (ВыгруженныеЗаказыПоПТУ.Выгружен)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияДокументовВДиадоке КАК Диадок_Документы
		|		ПО ПоступлениеТоваровУслуг.Ссылка = Диадок_Документы.Документ
		|ГДЕ
		|	ПоступлениеТоваровУслуг.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() <> 0 Тогда
		КоличествоОшибок = 0;
		Для каждого Колонка из Результат.Колонки Цикл
			Если Результат[0][Колонка.Имя] Тогда
				КоличествоОшибок = КоличествоОшибок+1;
				Сообщить(СоответствиеОшибок.Получить(Колонка.Имя));
			КонецЕсли;
		КонецЦикла
	КонецЕсли;
	
	Сообщить("Проверка готовности документа к выгрузке завершена, выявлено ошибок: " +КоличествоОшибок);
	
КонецПроцедуры

// Евросиб Пирожкова 30.07.2025)

Процедура ВыполнитьПроверкуПризнакКопия(Отказ,РежимЗаписи) //Евросиб Шевченко А.В. US 71681 TA 120124 01.12.2025
	                          
	мСостояния = Новый Массив;
	
	мСостояния.Добавить(Справочники.Состояния.ПолучитьОригиналыСнятьПризнакКопияПодготовитьПТУкВыгрузкеВУПП);
	мСостояния.Добавить(Справочники.Состояния.ПолучитьОригиналыСнятьПризнакКопияПодготовитьКорПТУкВыгрузкеВУПП);
	мСостояния.Добавить(Справочники.Состояния.ПолучениеОригиналовДокументовОтНерезидентовПроверитьСнятьПризнакКопия);
	мСостояния.Добавить(Справочники.Состояния.ПолучениеОригДокументовОтНерезидентаПровНаСоответствиеОригКопииСнятьПризнакКопия);
	
	Если (РежимЗаписи = РежимЗаписиДокумента.Запись ИЛИ РежимЗаписи = РежимЗаписиДокумента.Проведение) И НЕ ПометкаУдаления Тогда
		Для Каждого мСостояние Из мСостояния Цикл
			СтрокаСостояния = Состояния.НайтиСтроки(Новый Структура("Состояние,Статус", мСостояние, Перечисления.СтатусыЭтапов.Выполнен));
			Если СтрокаСостояния.Количество() <> 0 И Копия Тогда
				ОбщегоНазначения.СообщитьПользователю("Необходимо снять признак ""Копия""",,,"Объект.Копия",Отказ);
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры;	
