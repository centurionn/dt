				СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(СуммаВУчете, СтавкаНДС, УчитыватьНДС, Истина);
				СуммаНДС = Мин(СуммаНДС, СтрУслуг.СуммаНДС);
				
				//Евросиб Коханенко Н.А. 23.11.2023 (( BUG #77744 TASK #77745
				ПолнаяСуммаНДС = Окр(ПолнаяСуммаНДС, 2);
				СуммаНДС = Окр(СуммаНДС, 2);
				//Евросиб Коханенко Н.А. 23.11.2023 )) BUG #77744 TASK #77745 

				НСтр.ПолнаяСуммаНДС = ПолнаяСуммаНДС;
				НСтр.СуммаНДС = СуммаНДС;
				
				СтрСчетов.ПолнаяСуммаНаПТУ = СтрСчетов.ПолнаяСуммаНаПТУ - ПолнаяСумма;
				СтрСчетов.СуммаНаПТУ = СтрСчетов.СуммаНаПТУ - СуммаВУчете;
				
				СтрУслуг.ПолнаяСумма = СтрУслуг.ПолнаяСумма - ПолнаяСумма;
				СтрУслуг.Всего = СтрУслуг.Всего - СуммаВУчете;
				СтрУслуг.ПолнаяСуммаНДС = СтрУслуг.ПолнаяСуммаНДС - ПолнаяСуммаНДС;
				СтрУслуг.СуммаНДС = СтрУслуг.СуммаНДС - СуммаНДС;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если НСтр <> Неопределено Тогда
			
			Если СтрУслуг.ПолнаяСумма = 0 И СтрУслуг.ПолнаяСуммаНДС <> 0 Тогда
				НСтр.ПолнаяСуммаНДС = НСтр.ПолнаяСуммаНДС + СтрУслуг.ПолнаяСуммаНДС;
			КонецЕсли;
			
			Если СтрУслуг.Всего = 0 И СтрУслуг.СуммаНДС <> 0 Тогда
				НСтр.СуммаНДС = НСтр.СуммаНДС + СтрУслуг.СуммаНДС;
			КонецЕсли;
			
		КонецЕсли;
		
		Если СтрУслуг.Всего <> 0 Или СтрУслуг.ПолнаяСумма <> 0 Тогда
			НСтр = СвязьУслугИСчетов.Добавить();
			ЗаполнитьЗначенияСвойств(НСтр, СтрУслуг, "Всего,ГУИДПТУ,СуммаНДС,СтавкаНДС,ПолнаяСумма,ПолнаяСуммаНДС");
		КонецЕсли;
		
	КонецЦикла;
	
	//Евросиб Каблов 11.10.2023 )
	
КонецПроцедуры

Функция ПроверитьРеквизитыПТУНаИзменение(РеквизитыШапки, РеквизитыТЧСвязанныеСчета) Экспорт

	ДокументИзменен = Ложь;
	МассивШапки = СтрРазделить(РеквизитыШапки, ",", Ложь);
	МассивТЧСчетов = СтрРазделить(РеквизитыТЧСвязанныеСчета, ",", Ложь);
	Для каждого СтрокаШапки Из МассивШапки Цикл
		ДокументИзменен = ДокументИзменен Или ЭтотОбъект[СтрокаШапки] <> Ссылка[СтрокаШапки];
	КонецЦикла;
	
	Для каждого СтрокаСчета Из СвязанныеСчетаПоставщиков Цикл
		//Евросиб - АСуслов 25.05.2021 10:11:48 #0231779 
		//(
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорКонтрагента,"РасчетыПоДоговоруВЦелом") = Истина Тогда
			Прервать;
		КонецЕсли; 
		//)
		//Евросиб - АСуслов 25.05.2021 10:11:48 #
		СтрокаСчетаСохраненная = Ссылка.СвязанныеСчетаПоставщиков.Найти(СтрокаСчета.СчетПоставщика, "СчетПоставщика");
		Если СтрокаСчетаСохраненная = Неопределено Тогда
			ДокументИзменен = Истина;
			Прервать;
		КонецЕсли; 
		Для каждого КолонкаСчета Из МассивТЧСчетов Цикл
			ДокументИзменен = ДокументИзменен Или СтрокаСчета[КолонкаСчета] <> СтрокаСчетаСохраненная[КолонкаСчета];
		КонецЦикла;
	КонецЦикла;
	
	//Евросиб Каблов 02.09.2024 ( Ticket#0360646
	Если Не ДокументИзменен Тогда
		ИсходнаяТаблица = Ссылка.СвязьУслугИСчетов.Выгрузить(, "НомерСтроки, ГУИДПТУ, ОтнесеннаяСумма, СтавкаНДС, СуммаНДС");
		ТекущаяТаблица = СвязьУслугИСчетов.Выгрузить(, "НомерСтроки, ГУИДПТУ, ОтнесеннаяСумма, СтавкаНДС, СуммаНДС");
		ТаблицыИдентичны = ОбщегоНазначения.КоллекцииИдентичны(ИсходнаяТаблица, ТекущаяТаблица,,, Истина);
		Если Не ТаблицыИдентичны Тогда
			ДокументИзменен = Истина;
		КонецЕсли;
	КонецЕсли;
	//Евросиб Каблов 02.09.2024 )
	
//Евросиб Гудкова( 14.12.2020 Ticket№ 
	ДокументИзменен = ДокументИзменен Или ЭтотОбъект.Услуги.Итог("СуммаНДС") <> Ссылка.Услуги.Итог("СуммаНДС");
// Евросиб Гудкова) 	
	
	Возврат ДокументИзменен;

КонецФункции // ПроверитьРеквизитыПТУНаИзменение()
 
