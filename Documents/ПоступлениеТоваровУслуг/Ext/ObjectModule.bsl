Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли; 
	
    //Евросиб СубботинВ #99828 22.01.2025 Начало
    //ЗаявкиНаОплатуСервер.ПроверитьВозможностьЗаписиДокумента(ЭтотОбъект, Отказ);  добавил признак для проверки
	ЗаявкиНаОплатуСервер.ПроверитьВозможностьЗаписиДокумента(ЭтотОбъект, Отказ, РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения);
	//Евросиб СубботинВ #99828 22.01.2025 Конец

	//ДИТ, Беляев СЮ, BUG 82750 / TA 83060, 28-03-2024, начало
	ОчиститьДополнительныеСвойства_ТекстОшибкиЗаписиДокумента();
	//ДИТ, Беляев СЮ, BUG 82750 / TA 83060, 28-03-2024, конец
	
	// ++ ДИТ_Агафонов_task 41390 16.01.2023
	Если не ЭтоНовый() и не РольДоступна("ПолныеПрава") Тогда
		Корректировка = Документы.КорректировкаПоступления.ПолучитьКорректировкуПоОснованию(Ссылка);
		//Евросиб СубботинВ #97888 16.01.2025 Начало // добавил код позволяющий менять какие-то поля и провести док, имея корректировку, делал для даты оплаты 
		//Если ЗначениеЗаполнено(Корректировка) Тогда
		Если ЗначениеЗаполнено(Корректировка) и не ПроверитьРеквизитыДляПерепроведенияСКорректировкой() Тогда	
		//Евросиб СубботинВ #97888 16.01.2025 Конец
			Отказ = Истина;
			//Сообщить("Работа с документом "+Ссылка+" должна происходить через Документ исправления "+Корректировка);
			//ДИТ, Беляев СЮ, BUG 82750 / TA 83060, 28-03-2024, начало
			СообщитьПользователюИДобавитьОшибкиВДополнительныеСвойства( "Работа с документом "+Ссылка+" должна происходить через Документ исправления "+Корректировка );
			//ДИТ, Беляев СЮ, BUG 82750 / TA 83060, 28-03-2024, конец
			Возврат;
		КонецЕсли;	
	КонецЕсли;
	// -- ДИТ_Агафонов_task 41390 16.01.2023
	
	//Евросиб Литвинов ( 30.12.21 #44592 Ticket#0254477 #44587 
	Если НЕ ЭтоНовый() И ЗначениеЗаполнено(ДатаСФХЖ) И ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ДатаСФХЖ")) И Год(ДатаСФХЖ) <> Год(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ДатаСФХЖ")) Тогда
		СтатусАкцепта = Документы.Акцепт.ПолучитьДанныеПоследнегоПроведенногоАкцепта(Ссылка).СтатусРазнесения;
		Если НЕ СтатусАкцепта = Перечисления.СостоянияАвторазнесения.НетАктуальногоАкцепта
			//Евросиб - АСуслов 01.12.2022 9:42:27 #0293662 
			//(
			И НЕ СтатусАкцепта = Перечисления.СостоянияАвторазнесения.АкцептНеСоздан 
			//)
			//Евросиб - АСуслов 01.12.2022 9:42:43 #0293662 
			Тогда
			Отказ = Истина;
			//Сообщить("Для документа существует актуальный акцепт. Запрещена смена года для даты совершения факта хоз. жизни");
			//ДИТ, Беляев СЮ, BUG 82750 / TA 83060, 28-03-2024, начало
			СообщитьПользователюИДобавитьОшибкиВДополнительныеСвойства( "Для документа существует актуальный акцепт. Запрещена смена года для даты совершения факта хоз. жизни" );
			//ДИТ, Беляев СЮ, BUG 82750 / TA 83060, 28-03-2024, конец
			Возврат;
		Иначе
			ДатаМодификации = ТекущаяДата();
		КонецЕсли; 
	КонецЕсли;
 	Если ЭтоНовый() И НЕ ЗначениеЗаполнено(ДатаСФХЖ) И ДатаВходящегоДокумента >= Дата(2022,1,1) Тогда
		ДатаСФХЖ = ДатаВходящегоДокумента;
	КонецЕсли;
 	//Евросиб Литвинов) 
	//Евросиб - АСуслов 03.03.2023 16:40:50 #65484
	//(
	УстановитьПризнакВсеЗаказыПоПТУВыгруженыВУПП();
	//)
	//Евросиб - АСуслов 03.03.2023 16:40:52 #65484
		
		
	//Евросиб Каблов 16.02.2021 ( Ticket#0222945
	Если ЭтоНовый() Тогда
		ДокументПроведен = Ложь;
	Иначе
	    ДокументПроведен = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Проведен");	
	КонецЕсли;
	
	Если (Не ПометкаУдаления) И (Не ДокументПроведен) И ЗначениеЗаполнено(НомерВходящегоДокумента) И Контрагент <> Справочники.Контрагенты.РЖД Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ПоступлениеТоваровУслуг.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|ГДЕ
		|	ПоступлениеТоваровУслуг.Контрагент = &Контрагент
		|	И ПоступлениеТоваровУслуг.НомерВходящегоДокумента = &НомерВходящегоДокумента
		//|	И ПоступлениеТоваровУслуг.ДатаВходящегоДокумента МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ПоступлениеТоваровУслуг.ДатаВходящегоДокумента = &ДатаВходящегоДокумента
		|	И НЕ ПоступлениеТоваровУслуг.ПометкаУдаления
		|	И ПоступлениеТоваровУслуг.Ссылка <> &Ссылка";
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		Запрос.УстановитьПараметр("НомерВходящегоДокумента", НомерВходящегоДокумента);
		//Запрос.УстановитьПараметр("ДатаНачала", НачалоГода(ДатаВходящегоДокумента));
		//Запрос.УстановитьПараметр("ДатаОкончания", КонецГода(ДатаВходящегоДокумента));
		Запрос.УстановитьПараметр("ДатаВходящегоДокумента", ДатаВходящегоДокумента);
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда
		    Отказ = Истина;
			ТекстСообщения = СтрШаблон("Поступление с номером входящего документа %1 уже зарегистрировано в системе!", НомерВходящегоДокумента);
			//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			//ДИТ, Беляев СЮ, BUG 82750 / TA 83060, 28-03-2024, начало
			СообщитьПользователюИДобавитьОшибкиВДополнительныеСвойства( ТекстСообщения );
			//ДИТ, Беляев СЮ, BUG 82750 / TA 83060, 28-03-2024, конец
		КонецЕсли;
		
	КонецЕсли;
	//Евросиб Каблов 16.02.2021 )   
	
	//Евросиб(ДИТ) Антонова А.С. US 105103 ТА 105106 Начало 19.03.2025
	Если (РежимЗаписи = РежимЗаписиДокумента.Проведение или РежимЗаписи = РежимЗаписиДокумента.Запись) 
		и КонецДня(ДатаВходящегоДокумента) > КонецДня(ТекущаяДата()) Тогда
		Отказ = Истина;
		ТекстСообщения = СтрШаблон("Запись/проведение документа будущей датой запрещена!");
		СообщитьПользователюИДобавитьОшибкиВДополнительныеСвойства(ТекстСообщения);
	КонецЕсли;
	//Евросиб(ДИТ) Антонова А.С. US 105103 ТА 105106 Конец 19.03.2025
	
	//Евросиб Каблов 13.04.2021 ( Ticket#0228396
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		Если ЭтоНовый() Тогда
			СохраненнаяДатаВходящегоДокумента = ДатаВходящегоДокумента;
		Иначе	
			СохраненнаяДатаВходящегоДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ДатаВходящегоДокумента");
		КонецЕсли;
		
		Если Не Проведен Или СохраненнаяДатаВходящегоДокумента <> ДатаВходящегоДокумента Тогда
			
