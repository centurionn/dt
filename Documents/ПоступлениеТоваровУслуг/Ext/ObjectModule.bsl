	//(
	СтатусДокумента = Перечисления.СтатусыДокументовПоступлений.НаПроверке;
	ДатаПоступленияДокумента = ТекущаяДата();
	//)
	//Евросиб - АСуслов 16.03.2023 16:19:00 #65868
	
