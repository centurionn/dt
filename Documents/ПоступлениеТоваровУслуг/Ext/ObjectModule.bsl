//Евросиб Гудкова( 11.02.2020 Ticket№ 0182509
	//	удПериодВО = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериод(Организация);
// Евросиб Гудкова) 	
	УчитыватьНДС = Истина;
	Регламентный = Истина;
