Функция ОпределитьСтатусДляВзаиморасчетов(ДокументПоступленияТоваровУслуг) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА Состояния.Состояние.Согласование = ИСТИНА
	|					И Состояния.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЭтапов.Выполнен)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК СогласованаСуммаПТУ,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА Состояния.Состояние.ЗавершенаПроверкаПТУ = ИСТИНА
	|					И Состояния.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЭтапов.Выполнен)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЗавершенаПроверкаПТУ
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Состояния КАК Состояния
	|ГДЕ
	|	Состояния.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	Состояния.Ссылка";
	
	Если ТипЗнч(ДокументПоступленияТоваровУслуг) = Тип("ДокументСсылка.КорректировкаПоступления") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ".ПоступлениеТоваровУслуг.", ".КорректировкаПоступления.");
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ДокументПоступленияТоваровУслуг);
	
	Результат = Запрос.Выполнить();
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("СогласованаСуммаПТУ", Ложь);
	СтруктураОтвета.Вставить("ЗавершенаПроверкаПТУ", Ложь);
	
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		ЗаполнитьЗначенияСвойств(СтруктураОтвета, Выборка);
	КонецЕсли;	
	
	Возврат СтруктураОтвета;
	
КонецФункции	
