		//КлючЗначение = СоответствиеОбъектов.Получить(Ссылка);
		//Если КлючЗначение <> Неопределено Тогда
		//	СоответствиеОбъектов.Вставить(Ссылка, КлючЗначение.Значение + СтрокаНомераВБУ);
		//Иначе
		//	СоответствиеОбъектов.Вставить(Ссылка, СтрокаНомераВБУ);
		//КонецЕсли;
		СтруктураРезультата.НомерДатаВБУ = СтруктураРезультата.НомерДатаВБУ + СтрокаНомераВБУ;
		СоответствиеОбъектов.Вставить(Ссылка, СтруктураРезультата);
	КонецЦикла; 
	
	
	
	Возврат СоответствиеОбъектов;

