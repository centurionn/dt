		ТекущаяДата 	= ТекущаяДата();
							
		ВыполненыУсловияРегистрацииПТУИПрикрепленияСканов = Справочники.УсловияАвтоматическогоВыполненияЗадач.ВыполненыУсловияРегистрацииПТУИПрикрепленияСканов;
		НайденныеСтроки = Объект.Состояния.НайтиСтроки(Новый Структура("УсловиеАвтоматическогоВыполнения", ВыполненыУсловияРегистрацииПТУИПрикрепленияСканов));
		Для Каждого Стр Из НайденныеСтроки Цикл
			Стр.Статус = СтатусВыполнен;
			Стр.Исполнитель = Справочники.Пользователи.Робот;
			Стр.ЗавершениеРаботы = ТекущаяДата;
		КонецЦикла; 	

							
	КонецЕсли;
	
КонецПроцедуры

Функция ЕстьПрисоединенныеФайлы(Ссылка) //ДИТ Шевченко А.В. US 92974 TA 99395 03.03.2025
	Ответ = Ложь;
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Файлы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Файлы КАК Файлы
		|ГДЕ
		|	Файлы.ВладелецФайла = &Ссылка
		|	И НЕ Файлы.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Ответ = Истина;
			Прервать;
		КонецЦикла;
		
	КонецЕсли;	
	
	Возврат Ответ;
КонецФункции	

Функция НайтиСчетНаОплатуИзПТУСПризнакомСтрахование(Поступление) Экспорт
	
	// Евросиб US 87923 TA 104654 Рыбьяков К.А. 12.03.2025 ((
	Счет = Неопределено;
	Если ЗначениеЗаполнено(Поступление) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СчетНаОплатуПокупателюДокументыОснования.Ссылка КАК СчетПокупателю
		|ИЗ
		|	Документ.СчетНаОплатуПокупателю.ДокументыОснования КАК СчетНаОплатуПокупателюДокументыОснования
		|ГДЕ
		|	СчетНаОплатуПокупателюДокументыОснования.Документ = &Документ
		|	И НЕ СчетНаОплатуПокупателюДокументыОснования.Ссылка.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("Документ", Поступление);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Счет = Выборка.СчетПокупателю;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Счет; 
	// Евросиб Рыбьяков К.А. 12.03.2025 ))
КонецФункции