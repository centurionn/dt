			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	СвязанныеДокументы.Ссылка КАК ЗаявкаНаОплату,
			|	ПротоколОбменов.ПроведенВБУ КАК ПроведенВБУ,
			|	ПротоколОбменов.НомерДатаВБУ КАК НомерДатаВБУ
			|ИЗ
			|	КритерийОтбора.СвязанныеДокументы(&Документ) КАК СвязанныеДокументы
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
			|		ПО СвязанныеДокументы.Ссылка = ПротоколОбменов.Объект
			|			И (ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(перечисление.УзлыОбмена.УПП))
			|			И (ПротоколОбменов.ДействиеПриОбмене = ЗНАЧЕНИЕ(перечисление.ДействияПриОбмене.ВыгрузкаДанных))
			|ГДЕ
			|	СвязанныеДокументы.Ссылка ССЫЛКА Документ.ЗаявкаНаОплату";
			Запрос.УстановитьПараметр("Документ", Ссылка);
