//Евросиб Гудкова( 22.11.2020 Ticket№ 0212786 
Процедура МаршрутизироватьПТУ(СсылкаПТУ, СтруктураПараметров) Экспорт

	ПараметрыЗапроса = Новый Соответствие;
	ПараметрыЗапроса.Вставить("ОбъектМаршрутизации", СсылкаПТУ);
	ПараметрыЗапроса.Вставить("Организация", СтруктураПараметров.Организация);
	ПараметрыЗапроса.Вставить("Контрагент", СтруктураПараметров.Контрагент);
	ПараметрыЗапроса.Вставить("Договор", СтруктураПараметров.ДоговорКонтрагента);
	ПараметрыЗапроса.Вставить("Штраф", СтруктураПараметров.Штраф);
//Евросиб Максимова 17062021 #0216135
	ПараметрыЗапроса.Вставить("Претензия", СтруктураПараметров.Претензия);
//Евросиб Максимова 17062021 #0216135	
	ПараметрыЗапроса.Вставить("Копия", СтруктураПараметров.Копия);
	ПараметрыЗапроса.Вставить("ЦФО", СтруктураПараметров.ЦФО);
	//Евросиб Каблов 16.08.2021 ( Ticket#0240249
	РеквизитыПТУ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаПТУ, "КратностьВзаиморасчетов, КурсВзаиморасчетов");
	ПараметрыЗапроса.Вставить("ПолнаяСуммаВСФ", СтруктураПараметров.ПолнаяСуммаВСФ / РеквизитыПТУ.КратностьВзаиморасчетов * РеквизитыПТУ.КурсВзаиморасчетов);
	//Евросиб Каблов 16.08.2021 )
	
	//Евросиб Каблов 12.08.2022 ( Task 55578
	ПараметрыЗапроса.Вставить("ВидУслуг", СтруктураПараметров.ВидУслуг);
	//Евросиб Каблов 12.08.2022 )
	
	РезультатЗапроса = МаршрутизацияСервер.МаршрутизироватьПТУ(ПараметрыЗапроса, СтруктураПараметров.Дата);
		
	Автор = СтруктураПараметров.Автор;
	Если РезультатЗапроса.Количество() > 0 Тогда
		Для каждого Стр из  РезультатЗапроса Цикл
			Если НЕ ЗначениеЗаполнено(Стр.Исполнитель) Тогда Стр.Исполнитель = Автор; КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Стр.Наблюдатель) Тогда Стр.Наблюдатель = Автор; КонецЕсли;
		КонецЦикла;
		Попытка
			ОбъектДС = СсылкаПТУ.ПолучитьОбъект();
			МаршрутизацияСервер.ПрименитьМаршрут(ОбъектДС, РезультатЗапроса, Автор, Новый СписокЗначений);
			ОбъектДС.Записать();
		Исключение
			ОбщегоНазначения.СообщитьПользователю("Не удалось перемаршрутизировать документ " + СсылкаПТУ);
		КонецПопытки;
	Иначе
		ОбщегоНазначения.СообщитьПользователю("Для документа: " + СсылкаПТУ + " не найден подходящий маршрут. Изменения не внесены!");
	КонецЕсли;

КонецПроцедуры
