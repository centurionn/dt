Процедура СнятьПризнакКопии(МассивСсылок) Экспорт

	Если ТипЗнч(МассивСсылок) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли; 

	Для каждого ПТУСсылка Из МассивСсылок Цикл
		Если ПТУСсылка.Копия Тогда
			ПТУОбъект = ПТУСсылка.ПолучитьОбъект();
			ПТУОбъект.Копия = Ложь;
			ПТУОбъект.ДатаПолученияОригинала = ТекущаяДата();
			ПТУОбъект.Записать();
		КонецЕсли; 
	КонецЦикла; 
	
КонецПроцедуры

Функция ПолучитьРеквизитыОбъектаУПП(Ссылка, ВидОбмена) Экспорт

	НомерИДата = "";
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПротоколОбменов.НомерДатаВБУ КАК НомерДатаВБУ,
//ДИТ Давудов М.А. US 64830 15.04.2023 Начало
	               |	ПротоколОбменов.ДатаОбмена КАК ДатаОбмена,
//ДИТ Давудов М.А. US 64830 15.04.2023 Конец
	               |	ПротоколОбменов.ПроведенВБУ КАК ПроведенВБУ
	               |ИЗ
	               |	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ПротоколОбменов.Объект КАК Объект,
	               |			ПротоколОбменов.УзелОбмена КАК УзелОбмена,
	               |			МАКСИМУМ(ПротоколОбменов.НУИНУ) КАК НУИНУ
	               |		ИЗ
	               |			РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	               |		ГДЕ
	               |			ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(перечисление.УзлыОбмена."+ВидОбмена+")
	               |			И ПротоколОбменов.Объект = &Ссылка
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ПротоколОбменов.УзелОбмена,
	               |			ПротоколОбменов.Объект) КАК ВложенныйЗапрос
	               |		ПО ПротоколОбменов.УзелОбмена = ВложенныйЗапрос.УзелОбмена
	               |			И ПротоколОбменов.Объект = ВложенныйЗапрос.Объект
	               |			И ПротоколОбменов.НУИНУ = ВложенныйЗапрос.НУИНУ";
	
	Запрос.УстановитьПараметр("ссылка", Ссылка);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат;
	Иначе
		Возврат Новый Структура("НомерДатаВБУ, ПроведенВБУ", "", Ложь);
	КонецЕсли;

КонецФункции  

