Процедура УстановитьСтатусКонтейнера(ПараметрыВыполнения) Экспорт
	ДокБлокировки = Документы.УстановкаСтатусовКТК.СоздатьДокумент();  
	ТекущаяДата = ТекущаяДата();
	ДокБлокировки.Дата = ТекущаяДата();
	ДокБлокировки.Автор = Пользователи.АвторизованныйПользователь();
	Для Каждого СтрокаКТК Из ПараметрыВыполнения.ДанныеСтрок Цикл
		НС = ДокБлокировки.СостояниеБлокировкиКТК.Добавить();	
		ЗаполнитьЗначенияСвойств(НС, СтрокаКТК);
		НС.ДатаУстановкиСтатуса = ТекущаяДата;
	КонецЦикла;
	ПараметрыВыполнения.Свойство("Комментарий",ДокБлокировки.Комментарий);
	ДокБлокировки.Создано = ТекущаяДата();
	
	НачатьТранзакцию();
	Попытка
		ДокБлокировки.Записать(РежимЗаписиДокумента.Проведение);
		ЗафиксироватьТранзакцию();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать документ установки статусов КТК по причине: " + ОписаниеОшибки());
		ЗаписьЖурналаРегистрации("Ошибки при установке/снятии статуса КТК заблокирован", 
		УровеньЖурналаРегистрации.Ошибка,,,
		"Не удалось записать документ установки статусов КТК по причине: " + ОписаниеОшибки());   
		ОтменитьТранзакцию();
	КонецПопытки;
КонецПроцедуры
