
&НаКлиенте
Процедура ВыбратьВагоны(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораВагонов", ЭтаФорма, Новый Структура("МножественныйВыбор", Истина));
	ОткрытьФорму("Справочник.ТС.ФормаВыбора", Новый Структура("МножественныйВыбор", Истина),,,,, ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораВагонов(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	ИмяТЧ = ?(Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаРегистрацияНовыхВагонов, "РегистрацияНовыхВагонов", "СнятиеСУчетаВагона");
	
	Для каждого Стр из параметр1 Цикл
		
		СтрНайдена = Ложь;
		Для каждого стрТ из Объект[ИмяТЧ] Цикл
			Если стрТ.ВагонСсылка = Стр Тогда СтрНайдена = Истина; Прервать; КонецЕсли;
		КонецЦикла;
		
		Если НЕ СтрНайдена Тогда
			НСтр = Объект[ИмяТЧ].Добавить();
			НСтр.ВагонСсылка = Стр;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораКонтейнеров(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	ИмяТЧ = ?(Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаРегистрацияНовыхКонтейнеров, "РегистрацияНовыхКонтейнеров", "СнятиеСУчетаКонтейнеров");
	
	Для каждого Стр из параметр1 Цикл
		
		СтрНайдена = Ложь;
		Для каждого стрТ из Объект[ИмяТЧ] Цикл
			Если стрТ.КонтейнерСсылка = Стр Тогда СтрНайдена = Истина; Прервать; КонецЕсли;
		КонецЦикла;
		
		Если НЕ СтрНайдена Тогда
			НСтр = Объект[ИмяТЧ].Добавить();
			НСтр.КонтейнерСсылка = Стр;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКонтейнеры(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораКонтейнеров", ЭтаФорма, Новый Структура("МножественныйВыбор", Истина));
	ОткрытьФорму("Справочник.ТЕ.ФормаВыбора",Новый Структура("МножественныйВыбор", Истина),,,,, ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДату(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ПроставитьДату", ЭтаФорма);
	ПоказатьВводДаты(ОпОп, ТекущаяДата(), "Укажите дату для незаполненных строк", ЧастиДаты.ДатаВремя);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроставитьДату(ВыбрДата, Параметр2 = неопределено) Экспорт
	
	Если ВыбрДата = неопределено Тогда Возврат; КонецЕсли;
	
	ИмяТЧ = "РегистрацияНовыхВагонов";
	ИмяРеквизита = "ДатаВводаВЭксплуатацию";
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСнятиеСУчетаВагонов Тогда
		ИмяТЧ = "СнятиеСУчетаВагона";
		ИмяРеквизита = "ДатаВыводаИзЭксплуатации";
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаРегистрацияНовыхКонтейнеров Тогда
		ИмяТЧ = "РегистрацияНовыхКонтейнеров";
		ИмяРеквизита = "ДатаВводаВЭксплуатацию";
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСнятиеСУчетаКонтейнеров Тогда
		ИмяТЧ = "СнятиеСУчетаКонтейнеров";
		ИмяРеквизита = "ДатаВыводаИзЭксплуатации";
	КонецЕсли;
	
	Для каждого Стр из Объект[ИмяТЧ] Цикл
		Если НЕ ЗначениеЗаполнено(Стр[ИмяРеквизита]) Тогда
			Стр[ИмяРеквизита] = ВыбрДата;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура ДобавитьИзEXCEL(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ВставитьИзEXCELОбработка", ЭтаФорма);
	ОткрытьФорму("Документ.АктПостановкиСнятияСУчета.Форма.ВставкаИзБуфераОбмена", , , ЭтаФорма.УникальныйИдентификатор, ,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьИзEXCELВагоны(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ВставитьИзEXCELОбработка", ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.ВставкаИзБуфераОбмена", Новый Структура("Вагоны, ПередаватьИсходныеНомера", Истина, Истина), , ЭтаФорма.УникальныйИдентификатор, ,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВставитьИзEXCELОбработка(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если ТипЗнч(Параметр1) <> Тип("Массив") тогда Возврат; КонецЕсли;
	
	Для каждого Стр из Параметр1 Цикл
		Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаРегистрацияНовыхВагонов Тогда
			НСтр = Объект.РегистрацияНовыхВагонов.Добавить();
			НСтр.НомерВагона = Стр;
		Иначе
			НСтр = Объект.РегистрацияНовыхКонтейнеров.Добавить();
			НСтр.НомерКонтейнера = Стр;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РегистрацияНовыхВагоновПриИзменении(Элемент)
	
	МассивРазрешенныхПолей = Новый Массив;
	МассивРазрешенныхПолей.Добавить("ТипВагона");
	МассивРазрешенныхПолей.Добавить("Владелец");
	МассивРазрешенныхПолей.Добавить("ВидСобственности");
	МассивРазрешенныхПолей.Добавить("ДатаВводаВЭксплуатацию");
	МассивРазрешенныхПолей.Добавить("ДатаВыводаИзЭксплуатации");
	МассивРазрешенныхПолей.Добавить("ТипКонтейнера");
	
	МассивРазрешенныхПолей.Добавить("ЛокацияВыдачи");
	МассивРазрешенныхПолей.Добавить("ЛокацияВозврата");
	МассивРазрешенныхПолей.Добавить("ИнструкцииПоСдаче");
	МассивРазрешенныхПолей.Добавить("ПСЦ");
	МассивРазрешенныхПолей.Добавить("ДатаВозврата");
	МассивРазрешенныхПолей.Добавить("СрокПользованияДней");
//Евросиб Гудкова( 02.10.2020 Ticket№ 0208875
	МассивРазрешенныхПолей.Добавить("Договор");
	МассивРазрешенныхПолей.Добавить("ДатаПриемаВПользованиеПередПоставщиком");
	МассивРазрешенныхПолей.Добавить("СтокВыдачи");
	МассивРазрешенныхПолей.Добавить("СтокВозврата");
// Евросиб Гудкова) 	                                    
	
	Если ЗаполнятьПоПервойСтроке Тогда
		ИмяТЧ = Элемент.Имя;
		ИмяПоля = Сред(Элемент.ТекущийЭлемент.Имя, СтрДлина(ИмяТЧ)+1);
		
		Если МассивРазрешенныхПолей.Найти(ИмяПоля) = неопределено Тогда Возврат; КонецЕсли;
		Для Сч = 1 По Объект[ИмяТЧ].Количество() - 1 Цикл
			Объект[ИмяТЧ][Сч][ИмяПоля] = Объект[ИмяТЧ][0][ИмяПоля];
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РегистрацияНовыхКонтейнеровИнструкцииПоСдачеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекД = Элементы.РегистрацияНовыхКонтейнеров.ТекущиеДанные;
	Если ТекД <> неопределено Тогда
		
		ОпОп = Новый ОписаниеОповещения("ОбработкаВводаИнструкции", ЭтаФорма);
		ПоказатьВводСтроки(ОпОп, ТекД.ИнструкцииПоСдаче, "Укажите инструкции по сдаче порожнего КТК",, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВводаИнструкции(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	ТекД = Элементы.РегистрацияНовыхКонтейнеров.ТекущиеДанные;
	Если Параметр1 <> неопределено И ТекД <> неопределено Тогда
		ТекД.ИнструкцииПоСдаче = Параметр1;
		Если ЗаполнятьПоПервойСтроке Тогда
			РегистрацияНовыхВагоновПриИзменении(Элементы.РегистрацияНовыхКонтейнеров)
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

