Процедура ПроверкаСодержимогоЯчейки() 
	
	Сч = 2;
	Результат.Очистить();
	
	ПрочСтрока = ТД.Область("R"+Сч+"C5").Текст;
	
	// блок для проверки копирования/вставки
	Если ПрочСтрока = "" Тогда
		Возврат;
	КонецЕсли;
	ОтключитьОбработчикОжидания("ПроверкаСодержимогоЯчейки");
	///////////////////////
	
	Пока ПрочСтрока <> "" Цикл
		СтрокаРазмерКТК = ТД.Область("R"+Сч+"C6").Текст;
		
		Если ПоказыватьДатуВзятия Тогда
			СтрокаДата = ТД.Область("R"+Сч+ОбластьДатаВзятия).Текст;
		КонецЕсли;
		Если ПоказатьПрибытиеНаТерминалОтпр Тогда
			СтрДатаПрибытия = ТД.Область("R"+Сч+ОбластьПрибытиеНаТерминалОтпр).Текст;
		КонецЕсли;
		НСтр = Результат.Добавить();
		НСтр.ПрочитаннаяСтрока = ПрочСтрока;
		
		Если РежимРаботы = "КТК" Тогда
			
			НСтр.РазмерКТКСтрока = СокрЛП(СтрокаРазмерКТК);
			НСтр.РазмерКТК = ПолучитьТипоразмерКТК(СокрЛП(СтрЗаменить(СтрокаРазмерКТК, " ", "") ) );
			НСтр.ВычисленноеКонтрольноеЧисло = РаботаСКонтейнерамиСервер.ПолучитьКонтрольноеЧисло(Лев(ПрочСтрока,4), Сред(ПрочСтрока,5,6));
			НСтр.КонтрольноеЧислоПользователя = Прав(ПрочСтрока,1);
			НСтр.ПрочитаннаяСсылка = РаботаСКонтейнерамиСервер.СоздатьКТК(ПрочСтрока, НСтр.РазмерКТК);
			//Если ПоказыватьДатуВзятия Тогда
			//	НСтр.ПрочитаннаяСсылка = НайтиКТК(ПрочСтрока);
			//	НСтр.ДатаВзятия = ПреобразованиеВДату(СтрокаДата);
			//Иначе
			//	
			//КонецЕсли;
			//Если ПоказатьПрибытиеНаТерминалОтпр Тогда
			//	НСтр.ВремяПрибытияНаТерминал = ПреобразованиеВДату(СтрДатаПрибытия);
			//КонецЕсли;

			//Если ЕстьВодительТС Тогда
			//	НСтр.ВодительТС = СокрЛП(ТД.Область("R"+Сч+ОбластьВодительТС).Текст);
			//КонецЕсли;
			//Если ЕстьДатаПриемаВСток Тогда
			//	НСтр.ДатаПриемаВСток = ПреобразованиеВДату(ТД.Область("R"+Сч+ОбластьДатаПриемаВСток).Текст);
			//КонецЕсли;
			//Если ЕстьКонтрагент Тогда
			//	СтрКонтрагент = СокрЛП(ТД.Область("R"+Сч+ОбластьКонтрагент).Текст);
			//	Нстр.Контрагент = ПолучитьКонтрагентаПоСинониму(СтрКонтрагент);
			//	Нстр.СтрокаКонтрагент = СтрКонтрагент;
			//КонецЕсли;
			//Если ЕстьНомерТС Тогда
			//	НСтр.НомерТС = СокрЛП(ТД.Область("R"+Сч+ОбластьНомерТС).Текст);
			//КонецЕсли;

		КонецЕсли;
		
		Сч = Сч + 1;
		ПрочСтрока = ТД.Область("R"+Сч+"C5").Текст;
		
	КонецЦикла;
	
	// после распознавания, если стоит флаг "Автовставка", вызвать процедуру переноса значений в документ
	Если Автовставка Тогда
		ПеренестиВДокументКлиент();
