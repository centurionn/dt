&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.Декорация5.Видимость = ?(РежимРаботы = "КТК",Истина,Ложь);
	Элементы.Декорация6.Видимость = ?(РежимРаботы = "КТК",Истина,Ложь);
	Элементы.РезультатДатаВзятия.Видимость = ?(ПоказыватьДатуВзятия,Истина,Ложь);
	Элементы.РезультатВремяПрибытияНаТерминал.Видимость = ?(ПоказатьПрибытиеНаТерминалОтпр,Истина,Ложь);
	Элементы.ФорматДаты.Видимость = ?(ПоказыватьДатуВзятия,Истина,Ложь);
	Элементы.РезультатДатаПриемаВСток.Видимость = ?(ЕстьДатаПриемаВСток,Истина,Ложь);
	Элементы.РезультатКонтрагент.Видимость = ?(ЕстьКонтрагент,Истина,Ложь);
	Элементы.РезультатСтрокаКонтрагент.Видимость = ?(ЕстьКонтрагент,Истина,Ложь);
	Элементы.РезультатВодительТС.Видимость = ?(ЕстьВодительТС,Истина,Ложь);
	Элементы.РезультатНомерТС.Видимость = ?(ЕстьНомерТС,Истина,Ложь);
	
	Если Автовставка Тогда
		// необходимо установить обработчик ожидания для работы механизма копирования/вставки через WScript.Shell
		// в противном случае, скрипт не успевает вставить данные в форму, а 1С уже проверяет их наличие
		ПодключитьОбработчикОжидания("ПроверкаСодержимогоЯчейки", 0.1, Истина);
		
		wsh=Новый COMОбъект("WScript.Shell");    
		ЭтаФорма.ТекущийЭлемент = Элементы.ТД;
		Элементы.ТД.ТекущаяОбласть = ЭтаФорма.ТД.Область("R2C1");
		wsh.SendKeys("^v");
		wsh.SendKeys("^м");
    КонецЕсли;
	
КонецПроцедуры

