&НаСервереБезКонтекста
Функция НайтиНакладную(НомерНакладной) 
	
	Результат = Неопределено;
	Если НомерНакладной = "" Тогда Возврат Результат; КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ТранспортныйДокумент.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	               |ГДЕ
	               |	НЕ ТранспортныйДокумент.ПометкаУдаления
	               |	И ТранспортныйДокумент.НомерТранспортногоДокумента = &Наименование
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ТранспортныйДокумент.ДатаТранспортногоДокумента УБЫВ";
	Запрос.УстановитьПараметр("Наименование", НомерНакладной);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

