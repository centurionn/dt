&НаКлиенте
Процедура ПеренестиВДокументКлиент()
	
	Результат8 = Новый Массив;
	РезультатДаты = Новый Массив;
	РезДатыПрибытНаТерм = Новый Массив;
	РезультатРазмерКТК = Новый Массив;
	РезультатКонтрагент = Новый Массив;
	РезультатДатаПриемаВСток = Новый Массив;
	РезультатВодительТС = Новый Массив;
	РезультатНомерТС = Новый Массив;
	ВсеХорошо = Истина;
	
	Если ВозвращатьСтроки тогда
		
		Для каждого Стр из Результат Цикл
			Если ЗначениеЗаполнено(Стр.ПрочитаннаяСтрока) Тогда
				Результат8.Добавить(Стр.ПрочитаннаяСтрока);
				РезультатДаты.Добавить(Стр.ДатаВзятия);
				РезДатыПрибытНаТерм.Добавить(Стр.ВремяПрибытияНаТерминал);
				РезультатРазмерКТК.Добавить(Стр.РазмерКТКСтрока);
				РезультатКонтрагент.Добавить(Стр.Контрагент);
				РезультатДатаПриемаВСток.Добавить(НачалоДня(Стр.ДатаПриемаВСток));
				РезультатВодительТС.Добавить(Стр.ВодительТС);
				РезультатНомерТС.Добавить(Стр.НомерТС);
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		Для каждого Стр из Результат Цикл
			Если ЗначениеЗаполнено(Стр.ПрочитаннаяСсылка) Тогда
				Если ЕстьКонтрагент И НЕ ЗначениеЗаполнено(Стр.Контрагент) Тогда
					ВсеХорошо = Ложь;
					Продолжить;
				КонецЕсли; 
				Результат8.Добавить(Стр.ПрочитаннаяСсылка);
				РезультатДаты.Добавить(Стр.ДатаВзятия);
				РезДатыПрибытНаТерм.Добавить(Стр.ВремяПрибытияНаТерминал);
				РезультатРазмерКТК.Добавить(Стр.РазмерКТК);
				РезультатКонтрагент.Добавить(Стр.Контрагент);
				РезультатДатаПриемаВСток.Добавить(НачалоДня(Стр.ДатаПриемаВСток));
				РезультатВодительТС.Добавить(Стр.ВодительТС);
				РезультатНомерТС.Добавить(Стр.НомерТС);
			Иначе
				ВсеХорошо = Ложь;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	СтруктураМассивов = Новый Структура;
	СтруктураМассивов.Вставить("КТК",Результат8);
	СтруктураМассивов.Вставить("РазмерКТК",РезультатРазмерКТК);
	СтруктураМассивов.Вставить("ДатыКТК",РезультатДаты);
	СтруктураМассивов.Вставить("ДатыПрибытияНаТерм",РезДатыПрибытНаТерм);
	СтруктураМассивов.Вставить("Контрагент",РезультатКонтрагент);
	СтруктураМассивов.Вставить("ДатаПриемаВСток",РезультатДатаПриемаВСток);
	СтруктураМассивов.Вставить("ВодительТС",РезультатВодительТС);
	СтруктураМассивов.Вставить("НомерТС",РезультатНомерТС);
	
	Если ПоказыватьДатуВзятия ИЛИ ПоказатьПрибытиеНаТерминалОтпр ИЛИ ПоказыватьРазмерКТК Или ЕстьКонтрагент Тогда
		ЧтоВозвращаем = СтруктураМассивов;
	Иначе
		ЧтоВозвращаем = Результат8;
	КонецЕсли;
	
	Если ВсеХорошо Тогда
		Закрыть(ЧтоВозвращаем);
	Иначе
		
		ОпОп = Новый ОписаниеОповещения("ВопросПереноса", ЭтаФорма, Новый Структура("СписокРезультат", ЧтоВозвращаем));
		ПоказатьВопрос(ОпОп, "Не все строки найдены. При переносе позиции без найденных строк будут пропущены. Продолжить?", РежимДиалогаВопрос.ДаНет, 30, КодВозвратаДиалога.Нет,, КодВозвратаДиалога.Нет);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВопросПереноса(Параметр1 = неопределено, Параметр2 = неопределено) экспорт
	
	Если Параметр1 = КодВозвратаДиалога.Да Тогда
		Закрыть(Параметр2.СписокРезультат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТДПриИзмененииСодержимогоОбласти(Элемент, Область)
	
	// проверять только КТК
	Если не РежимРаботы = "КТК" Тогда
		Возврат;
	КонецЕсли;
	
	ЧислаМ = Новый Массив;
	Для Сч = 0 По 9 Цикл ЧислаМ.Добавить(Строка(Сч)); КонецЦикла;
	
	Сч = 2;

	СохраненныйБелый = ТД.Область("R1C25").ЦветФона;
	
	ПрочСтрока = ТД.Область("R"+Сч+"C5").Текст;
	
	Пока ПрочСтрока <> "" Цикл
		Если СтрДлина(ПрочСтрока) = 11 Тогда
			КонтрольныйЗнак = РаботаСКонтейнерамиСервер.ПолучитьКонтрольноеЧисло(Лев(ПрочСтрока,4), Сред(ПрочСтрока,5,6));
		КонецЕсли;
		Если СтрДлина(ПрочСтрока) <> 11 //////   \/ добавил вот это 
			ИЛИ КонтрольныйЗнак = "Неверно" ИЛИ ЧислаМ.Найти(Прав(ПрочСтрока,1)) = неопределено  
			ИЛИ (СтрДлина(ПрочСтрока) = 11 И НЕ Число(Прав(ПрочСтрока,1)) = КонтрольныйЗнак) Тогда
			ТД.Область("R"+Сч+"C5").ЦветФона = WebЦвета.Розовый;
		Иначе
			ТД.Область("R"+Сч+"C5").ЦветФона = СохраненныйБелый;
		КонецЕсли;
		
		Сч = Сч + 1;
		ПрочСтрока = ТД.Область("R"+Сч+"C5").Текст;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Пауза()
    Для Инд = 0 По 10000 Цикл
        
    КонецЦикла;
КонецПроцедуры    

