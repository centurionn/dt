Функция ПолучитьСобственностьВГНаДату(Вагон, Дата)
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПризнакСобственностиВагонаСрезПоследних.ПризнакСобственности КАК ПризнакСобственности
	               |ИЗ
	               |	РегистрСведений.ПризнакСобственностиВагона.СрезПоследних(&Период, Вагон = &Вагон) КАК ПризнакСобственностиВагонаСрезПоследних";
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("Вагон", Вагон);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.ПризнакСобственности;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСобственностьКТНаДату(Контейнер, Дата)
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПризнакСобственностиКонтейнераСрезПоследних.ПризнакСобственности КАК ПризнакСобственности
	               |ИЗ
	               |	РегистрСведений.ПризнакСобственностиКонтейнера.СрезПоследних(&Период, Контейнер = &Контейнер) КАК ПризнакСобственностиКонтейнераСрезПоследних";
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("Контейнер", Контейнер);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.ПризнакСобственности;
	КонецЕсли;
	
	Возврат Результат;
	
