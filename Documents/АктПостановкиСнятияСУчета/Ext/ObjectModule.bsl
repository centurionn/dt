Функция ПолучитьЛокациюВагона(ВагонСсылка, ДатаВыводаИзЭксплуатации)
	
	Результат = Новый Структура("Локация, ТипВагона, ФактОстаток");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПозицияВагоновФактОстатки.Локация КАК Локация,
	               |	ПозицияВагоновФактОстатки.Вагон КАК Вагон,
	               |	ПозицияВагоновФактОстатки.ТипВагона КАК ТипВагона,
	               |	ПозицияВагоновФактОстатки.ФактОстаток КАК ФактОстаток
	               |ИЗ
	               |	РегистрНакопления.ПозицияВагоновФакт.Остатки(&Период, Вагон = &Вагон) КАК ПозицияВагоновФактОстатки";
	Запрос.УстановитьПараметр("Период", ДатаВыводаИзЭксплуатации);
	Запрос.УстановитьПараметр("Вагон", ВагонСсылка);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Ответ);
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

Функция ПолучитьЛокациюКонтейнера(КТКСсылка, ДатаВыводаИзЭксплуатации)
	
	Результат = Новый Структура("Локация, ТипКТК, ФактОстаток");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПозицияКонтейнеровФактОстатки.Локация КАК Локация,
	               |	ПозицияКонтейнеровФактОстатки.Контейнер КАК Контейнер,
	               |	ПозицияКонтейнеровФактОстатки.ТипКТК КАК ТипКТК,
	               |	ПозицияКонтейнеровФактОстатки.ФактОстаток КАК ФактОстаток
	               |ИЗ
	               |	РегистрНакопления.ПозицияКонтейнеровФакт.Остатки(&Период, Контейнер = &Контейнер) КАК ПозицияКонтейнеровФактОстатки";
	Запрос.УстановитьПараметр("Период", ДатаВыводаИзЭксплуатации);
	Запрос.УстановитьПараметр("Контейнер", КТКСсылка);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Ответ);
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

