		Движение.Локация = ДанныеВагона.Локация;
		Движение.Вагон = Стр.ВагонСсылка;
		Движение.ТипВагона = ДанныеВагона.ТипВагона;
		Движение.Период = Стр.ДатаВыводаИзЭксплуатации;
		Движение.Факт = ДанныеВагона.ФактОстаток;
		
		МЗ = РегистрыСведений.ПризнакСобственностиВагона.СоздатьМенеджерЗаписи();
