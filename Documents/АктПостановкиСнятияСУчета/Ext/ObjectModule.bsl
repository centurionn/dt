		МЗ.ДокументРегистратор = Ссылка;
		МЗ.Период = Стр.ДатаВыводаИзЭксплуатации;
		МЗ.ПризнакСобственности = ПолучитьСобственностьВГНаДату(МЗ.Вагон, МЗ.Период-1);
