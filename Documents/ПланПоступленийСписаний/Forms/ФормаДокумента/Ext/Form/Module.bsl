
&НаКлиенте
Процедура ЗаполнитьПоступления(Команда)
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Объект.Поступления.Очистить();
		Таб = ПланыПродажПоступленийВыбытийСервер.ЗаполнитьПоступленияПоПлануПродаж(Объект.ДокументОснование, Объект.ПоступлениеСДопУслугами);
		Для каждого Стр из Таб Цикл
			ЗаполнитьЗначенияСвойств(Объект.Поступления.Добавить(), Стр);
		КонецЦикла;
	Иначе
		СП = Новый СообщениеПользователю;
		СП.Поле = "ДокументОснование";
		СП.УстановитьДанные(Объект);
		СП.Текст = "Сначала укажите план продаж!";
		СП.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

