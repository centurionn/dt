Процедура ВвестиДокументРучногоРедактирования(ПараметрыСоздания,Отказ) Экспорт
	
	ИзменятьСведения = Ложь;
	ИзменятьНакопление = Ложь;
	
	Если ПараметрыСоздания.КомментарийСотрудникаБыло <> ПараметрыСоздания.КомментарийСотрудникаСтало Тогда
		ИзменятьСведения = Истина;
	КонецЕсли;
	
	Если ПараметрыСоздания.ДатаОперации <> ПараметрыСоздания.ДатаОперацииНовая Тогда
		ИзменятьНакопление = Истина;
	КонецЕсли;
	
	Если Не ИзменятьСведения И Не ИзменятьНакопление Тогда
		//Корректировка не нужна
		Возврат;
	КонецЕсли;
	
	ДокументКорректировки = Документы.РедактированиеДанныхЧистогоСтока.СоздатьДокумент();
	ДокументКорректировки.Дата = ТекущаяДата();
	ДокументКорректировки.УстановитьНовыйНомер();
	ДокументКорректировки.Отвественный = Пользователи.АвторизованныйПользователь();
	
	Попытка
		ДокументКорректировки.Записать(РежимЗаписиДокумента.Запись)
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки(),,,,Отказ);
	КонецПопытки;
	
	Если ИзменятьСведения И Не Отказ Тогда
		ДвиженияСведений = ДокументКорректировки.Движения.ДанныеПоОперациямЧистыйСтокДанныеРедактирования;
		ДвиженияСведений.Записывать = Истина;
		СтрокаСведений = ДвиженияСведений.Добавить();
		СтрокаСведений.Период = ДокументКорректировки.Дата;
		СтрокаСведений.ДатаОперации = ПараметрыСоздания.ПериодСведений;
		СтрокаСведений.Активность = Истина;
		СтрокаСведений.Регистратор = ДокументКорректировки.Ссылка;
		СтрокаСведений.Контейнер = ПараметрыСоздания.Контейнер;
		СтрокаСведений.КомментарийСотрудника = ПараметрыСоздания.КомментарийСотрудникаСтало;
		Попытка
			ДвиженияСведений.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки(),,,,Отказ);
		КонецПопытки;  
	КонецЕсли;
	
	Если ИзменятьНакопление И Не Отказ Тогда
		ДанныеНакопления = ДанныеНакопленияДляСторнирования(ПараметрыСоздания);
		ДвиженияНакопления = ДокументКорректировки.Движения.МестонахождениеЧистыйСток;
		СтрокаСторно = ДвиженияНакопления.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСторно,ДанныеНакопления);
		СтрокаСторно.Регистратор = ДокументКорректировки.Ссылка;
		СтрокаСторно.ВидДвижения = ВидДвиженияНакопления.Приход;
		СтрокаСторно.Период = СтрокаСторно.Период;
		
		СтрокаРедактирования = ДвиженияНакопления.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРедактирования,ДанныеНакопления);
		СтрокаРедактирования.Регистратор = ДокументКорректировки.Ссылка;
		СтрокаРедактирования.Период = ПараметрыСоздания.ДатаОперацииНовая;
		СтрокаРедактирования.Количество = -СтрокаРедактирования.Количество; 
		
		//Транслируем аналитику
		ДанныеАналитики = ДанныеАналитикиСторно(СтрокаСторно.Период,ДанныеНакопления.Контейнер); 
		
		Если ДанныеАналитики <> Неопределено Тогда
			ДвиженияАналитики = ДокументКорректировки.Движения.ДанныеПоОперациямЧистыйСток;
			ДвиженияАналитики.Записывать = Истина;
			СтрокаАналитики = ДвиженияАналитики.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаАналитики,ДанныеАналитики);
			СтрокаАналитики.ДатаОперации = ПараметрыСоздания.ДатаОперацииНовая;
			СтрокаАналитики.Активность = Истина;
			СтрокаАналитики.Регистратор = ДокументКорректировки.Ссылка;
			
			СтрокаАналитики.Период = ДокументКорректировки.Дата;
			Попытка
				ДвиженияАналитики.Записать();
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки(),,,,Отказ);
			КонецПопытки;  
		КонецЕсли;
		
		Попытка
			ДвиженияНакопления.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки(),,,,Отказ);
		КонецПопытки;  
	КонецЕсли;
	
КонецПроцедуры

Функция ДанныеАналитикиСторно(ДатаАналитики,Контейнер)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеПоОперациямЧистыйСтокСрезПоследних.Контейнер КАК Контейнер,
		|	ДанныеПоОперациямЧистыйСтокСрезПоследних.Состояние КАК Состояние,
		|	&ТекущаяДата КАК ДатаОбновленияИнформации,
		|	ДанныеПоОперациямЧистыйСтокСрезПоследних.ТерминальнаяУслуга КАК ТерминальнаяУслуга,
		|	ДанныеПоОперациямЧистыйСтокСрезПоследних.ЛинияПодсток КАК ЛинияПодсток,
		|	ДанныеПоОперациямЧистыйСтокСрезПоследних.НаличиеПодвреждения КАК НаличиеПодвреждения,
		|	ДанныеПоОперациямЧистыйСтокСрезПоследних.ЗаявкаНаВыдачу КАК ЗаявкаНаВыдачу,
		|	ДанныеПоОперациямЧистыйСтокСрезПоследних.КомментарийТерминала КАК КомментарийТерминала,
		|	ДанныеПоОперациямЧистыйСтокСрезПоследних.ЗаявкаНаСдачу КАК ЗаявкаНаСдачу,
		|	ЕСТЬNULL(ДанныеПоОперациямЧистыйСтокДанныеРедактирования.КомментарийСотрудника, ДанныеПоОперациямЧистыйСтокСрезПоследних.КомментарийСотрудника) КАК КомментарийСотрудника,
		|	ДанныеПоОперациямЧистыйСтокСрезПоследних.ИсточникДобавленияДанных КАК ИсточникДобавленияДанных,
		|	ДанныеПоОперациямЧистыйСтокСрезПоследних.ВидТранспортаУбытия КАК ВидТранспортаУбытия,
		|	ДанныеПоОперациямЧистыйСтокСрезПоследних.ФИОВодителя КАК ФИОВодителя,
		|	ДанныеПоОперациямЧистыйСтокСрезПоследних.НомерТранспорта КАК НомерТранспорта,
		|	ДанныеПоОперациямЧистыйСтокСрезПоследних.ВидТранспорта КАК ВидТранспорта,
		|	ДанныеПоОперациямЧистыйСтокСрезПоследних.ОтветственныйЗаЗагрузку КАК ОтветственныйЗаЗагрузку,
		|	ДанныеПоОперациямЧистыйСтокСрезПоследних.Станция КАК Станция,
		|	ДанныеПоОперациямЧистыйСтокСрезПоследних.Контрагент КАК Контрагент,
		|	ДанныеПоОперациямЧистыйСтокСрезПоследних.Период КАК Период
		|ИЗ
		|	РегистрСведений.ДанныеПоОперациямЧистыйСток.СрезПоследних(НЕОПРЕДЕЛЕНО, Контейнер = &Контейнер) КАК ДанныеПоОперациямЧистыйСтокСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеПоОперациямЧистыйСтокДанныеРедактирования КАК ДанныеПоОперациямЧистыйСтокДанныеРедактирования
		|		ПО ДанныеПоОперациямЧистыйСтокСрезПоследних.Контейнер = ДанныеПоОперациямЧистыйСтокДанныеРедактирования.Контейнер
		|			И ДанныеПоОперациямЧистыйСтокСрезПоследних.ДатаОперации = ДанныеПоОперациямЧистыйСтокДанныеРедактирования.ДатаОперации
		|ГДЕ
		|	ДанныеПоОперациямЧистыйСтокСрезПоследних.ДатаОперации = &ДатаАналитики";
	
	Запрос.УстановитьПараметр("ДатаАналитики", ДатаАналитики);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.УстановитьПараметр("Контейнер", Контейнер);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеНакопленияДляСторнирования(Параметры)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МестонахождениеЧистыйСток.Период КАК Период,
		|	МестонахождениеЧистыйСток.Активность КАК Активность,
		|	МестонахождениеЧистыйСток.Контейнер КАК Контейнер,
		|	МестонахождениеЧистыйСток.Терминал КАК Терминал,
		|	-МестонахождениеЧистыйСток.Количество КАК Количество,
		|	МестонахождениеЧистыйСток.ВидДвижения КАК ВидДвижения,
		|	МестонахождениеЧистыйСток.ИсточникДобавленияДанных КАК ИсточникДобавленияДанных,
		|	МестонахождениеЧистыйСток.ИсходнаяДатаОперации КАК ИсходнаяДатаОперации
		|ИЗ
		|	РегистрНакопления.МестонахождениеЧистыйСток КАК МестонахождениеЧистыйСток
		|ГДЕ
		|	МестонахождениеЧистыйСток.Период = &Период
		|	И МестонахождениеЧистыйСток.Контейнер = &Контейнер
		|	И МестонахождениеЧистыйСток.Терминал = &Терминал";
	
	Запрос.УстановитьПараметр("Контейнер", Параметры.Контейнер);
	Запрос.УстановитьПараметр("Период", Параметры.ДатаОперации);
	Запрос.УстановитьПараметр("Терминал", Параметры.Терминал);
	
	РезультатЗапроса = Запрос.Выполнить();
	//Евросиб(ДИТ) Антонова А.С. US 105060 ТА 114251 Начало 24.07.2025
	Если не РезультатЗапроса.Пустой() Тогда
	//Евросиб(ДИТ) Антонова А.С. US 105060 ТА 114251 Конец 24.07.2025
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Если Выборка.Следующий() Тогда
			Возврат Выборка;
		КонецЕсли;
		
	//Евросиб(ДИТ) Антонова А.С. US 105060 ТА 114251 Начало 24.07.2025   
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	//Евросиб(ДИТ) Антонова А.С. US 105060 ТА 114251 Конец 24.07.2025
	
КонецФункции

Функция ВвестиДокументСторно(ПараметрыСоздания,Отказ) Экспорт
	
	ДокументКорректировки = Документы.РедактированиеДанныхЧистогоСтока.СоздатьДокумент();
	ДокументКорректировки.Дата = ТекущаяДата();
	ДокументКорректировки.УстановитьНовыйНомер();
	ДокументКорректировки.Отвественный = Пользователи.АвторизованныйПользователь();
	ДокументКорректировки.Сторно = Истина;
	
	Попытка
		//Евросиб(ДИТ) Антонова А.С. US 105060 ТА 115174 Начало 11.08.2025 - заполнение документа перенесено до записи, чтобы не создавался пустой документ
		//ДокументКорректировки.Записать(РежимЗаписиДокумента.Запись)
		
		ДанныеНакопления = ДанныеНакопленияДляСторнирования(ПараметрыСоздания); 
		//Евросиб(ДИТ) Антонова А.С. US 105060 ТА 114251 Начало 24.07.2025
		Если ДанныеНакопления = Неопределено Тогда
			Возврат Неопределено;		
		КонецЕсли;
		//Евросиб(ДИТ) Антонова А.С. US 105060 ТА 114251 Конец 24.07.2025
		ДвиженияНакопления = ДокументКорректировки.Движения.МестонахождениеЧистыйСток;
		СтрокаСторно = ДвиженияНакопления.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСторно,ДанныеНакопления);
		СтрокаСторно.Регистратор = ДокументКорректировки.Ссылка;
		//СтрокаСторно.ВидДвижения = ВидДвиженияНакопления.Приход;
		СтрокаСторно.Период = СтрокаСторно.Период;
		//СтрокаСторно.Количество =  - ПараметрыСоздания.КоличествоОстаток; 
		//Евросиб(ДИТ) Антонова А.С. US 105060 ТА 114251 Начало 12.08.2025
		Если ПараметрыСоздания.Свойство("ИсточникДобавленияДанных") Тогда
			СтрокаСторно.ИсточникДобавленияДанных = ПараметрыСоздания.ИсточникДобавленияДанных; 
		КонецЕсли;
		//Евросиб(ДИТ) Антонова А.С. US 105060 ТА 114251 Конец 12.08.2025
		
		Если ДвиженияНакопления.Количество() Тогда
			ДокументКорректировки.Записать(РежимЗаписиДокумента.Запись);
			ДвиженияНакопления.Записать();
		КонецЕсли;
		//Евросиб(ДИТ) Антонова А.С. US 105060 ТА 115174 Конец 11.08.2025
		
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки(),,,,Отказ);
		Если ТранзакцияАктивна() Тогда
			ВызватьИсключение(ОписаниеОшибки(),КатегорияОшибки.ИсключениеВызванноеИзВстроенногоЯзыка,,,ИнформацияОбОшибке());
		КонецЕсли;
	КонецПопытки;
	
	Возврат ДокументКорректировки; 
	
КонецФункции
