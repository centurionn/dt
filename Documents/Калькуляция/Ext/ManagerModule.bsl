Функция ПолучитьДанныеКонтактногоЛица(ФизЛицо)
	СтруктураДанных = Новый Структура;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ФизическиеЛицаКонтактнаяИнформация.Тип КАК Тип,
	                      |	ФизическиеЛицаКонтактнаяИнформация.Вид КАК Вид,
	                      |	ФизическиеЛицаКонтактнаяИнформация.Представление КАК Представление
	                      |ИЗ
	                      |	Справочник.ФизическиеЛица.КонтактнаяИнформация КАК ФизическиеЛицаКонтактнаяИнформация
	                      |ГДЕ
	                      |	ФизическиеЛицаКонтактнаяИнформация.Ссылка.Ссылка = &ФизЛицо");
	Запрос.УстановитьПараметр("ФизЛицо", ФизЛицо);
	Результат = Запрос.Выполнить().Выгрузить();
	Тел = Результат.Найти(Перечисления.ТипыКонтактнойИнформации.Телефон, "Тип");
	Если Тел <> Неопределено Тогда
		СтруктураДанных.Вставить("Телефон", Тел.Представление);
	Иначе
		СтруктураДанных.Вставить("Телефон", "");
	КонецЕсли;
	Майл = Результат.Найти(Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты,"Тип");
	Если Майл <> Неопределено Тогда
		СтруктураДанных.Вставить("Майл", Майл.Представление);
	Иначе
		СтруктураДанных.Вставить("Майл", "");
	КонецЕсли;
	
	Возврат СтруктураДанных;
КонецФункции

Функция ПолучитьПринадлежностьRT(ПринадлежностьПС) Экспорт
	Если ПринадлежностьПС = Перечисления.ПринадлежностьПС.ОбщийПарк Тогда
		ПринадлежностьТС_RT = 1;
	ИначеЕсли ПринадлежностьПС = Перечисления.ПринадлежностьПС.Собственный Тогда 
		ПринадлежностьТС_RT = 2;
	ИначеЕсли ПринадлежностьПС = Перечисления.ПринадлежностьПС.Арендованный Тогда 
		ПринадлежностьТС_RT = 3;
	ИначеЕсли ПринадлежностьПС = Перечисления.ПринадлежностьПС.ПривлеченныйРЖД Тогда 
		ПринадлежностьТС_RT = 7;
	КонецЕсли; 
	Возврат ПринадлежностьТС_RT;
КонецФункции

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Поля = Новый Массив;
	Поля.Добавить("Номер");
	Поля.Добавить("Дата");
	Поля.Добавить("Суша_ПунктОтправления");
	Поля.Добавить("Суша_ПунктНазначения");	
	Поля.Добавить("Комментарий");	
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Представление = "" + "Калькуляция " + СокрЛП(Данные.Комментарий) + " " + Данные.Номер + " от " + Формат(Данные.Дата, "ДФ=dd.MM.yy") + " (" + Данные.Суша_ПунктОтправления + " - " + Данные.Суша_ПунктНазначения + ")";
	
КонецПроцедуры

Функция КалькуляцияНаходитсяВСогласованномПСЦ(Калькуляция) Экспорт
	
	Результат = неопределено;
	СтатусДокумента = Новый Массив;
	СтатусДокумента.Добавить(Перечисления.СтатусыСогласования.Подписано);
	СтатусДокумента.Добавить(Перечисления.СтатусыСогласования.СогласованоБезЗамечаний);
//	СтатусДокумента.Добавить(Перечисления.СтатусыСогласования.СогласованСКомментариями);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ первые 1
	               |	ПСЦКалькуляции.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ПСЦ.Калькуляции КАК ПСЦКалькуляции
	               |ГДЕ
	               |	ПСЦКалькуляции.Калькуляция = &Калькуляция
	               |	И ПСЦКалькуляции.Ссылка.Проведен
	               |	И ПСЦКалькуляции.Ссылка.СтатусДокумента В(&СтатусДокумента)";
	Запрос.УстановитьПараметр("Калькуляция", Калькуляция);
	Запрос.УстановитьПараметр("СтатусДокумента", СтатусДокумента);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоМаршрутизацияДействующегоКлиента(Объект) Экспорт
	ЭтоМаршрутизацияДействующегоКлиента = Ложь;
	Если ТипЗнч(Объект.КалькуляцияСозданаНаОсновании) = Тип("ДокументСсылка.Калькуляция") Тогда
		Если Объект.КалькуляцияСозданаНаОсновании.Шаблон Тогда 
			Если ЗначениеЗаполнено(Объект.КалькуляцияСозданаНаОсновании.Контрагент) Тогда
				Если Объект.Контрагент<>Объект.КалькуляцияСозданаНаОсновании.Контрагент Тогда
					//СтандартнаяМаршрутизация = "Калькуляция нового клиента";
					ЭтоМаршрутизацияДействующегоКлиента = Ложь;
				Иначе
					Если ПроверитьИзменениеМодальности(Объект) Тогда
						//СтандартнаяМаршрутизация = "Калькуляция нового клиента";
						ЭтоМаршрутизацияДействующегоКлиента = Ложь;
					ИначеЕсли Объект.ММ_ИтогоСтавка>=Объект.КалькуляцияСозданаНаОсновании.ММ_ИтогоСтавка ИЛИ Объект.ММ_ИтогоСтавка20>=Объект.КалькуляцияСозданаНаОсновании.ММ_ИтогоСтавка20 Тогда
						//СтандартнаяМаршрутизация = "Калькуляция действующего клиента";
						ЭтоМаршрутизацияДействующегоКлиента = Истина;
					ИначеЕсли Объект.ММ_ИтогоСтавка<Объект.КалькуляцияСозданаНаОсновании.ММ_ИтогоСтавка ИЛИ Объект.ММ_ИтогоСтавка20<Объект.КалькуляцияСозданаНаОсновании.ММ_ИтогоСтавка20 Тогда
						//СтандартнаяМаршрутизация = "Калькуляция нового клиента"; 
						ЭтоМаршрутизацияДействующегоКлиента = Ложь;
					Иначе
						//СтандартнаяМаршрутизация = "Калькуляция действующего клиента";
						ЭтоМаршрутизацияДействующегоКлиента = Истина;
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли НЕ ЗначениеЗаполнено(Объект.КалькуляцияСозданаНаОсновании.Контрагент) Тогда
				Если ПроверитьИзменениеМодальности(Объект) Тогда
					//СтандартнаяМаршрутизация = "Калькуляция нового клиента";
					ЭтоМаршрутизацияДействующегоКлиента = Ложь;
				ИначеЕсли Объект.ММ_ИтогоСтавка>=Объект.КалькуляцияСозданаНаОсновании.ММ_ИтогоСтавка ИЛИ Объект.ММ_ИтогоСтавка20>=Объект.КалькуляцияСозданаНаОсновании.ММ_ИтогоСтавка20 Тогда
					//СтандартнаяМаршрутизация = "Калькуляция действующего клиента";
					ЭтоМаршрутизацияДействующегоКлиента = Истина;
				ИначеЕсли Объект.ММ_ИтогоСтавка<Объект.КалькуляцияСозданаНаОсновании.ММ_ИтогоСтавка ИЛИ Объект.ММ_ИтогоСтавка20<Объект.КалькуляцияСозданаНаОсновании.ММ_ИтогоСтавка20 Тогда
					//СтандартнаяМаршрутизация = "Калькуляция нового клиента";
					ЭтоМаршрутизацияДействующегоКлиента = Ложь;
				Иначе
					//СтандартнаяМаршрутизация = "Калькуляция действующего клиента";
					ЭтоМаршрутизацияДействующегоКлиента = Истина;
				КонецЕсли;
			КонецЕсли;
		Иначе
			//СтандартнаяМаршрутизация = "Калькуляция нового клиента";
			ЭтоМаршрутизацияДействующегоКлиента = Ложь;
		КонецЕсли;
	Иначе
		//СтандартнаяМаршрутизация = "Стандарт";
		ЭтоМаршрутизацияДействующегоКлиента = Ложь;
	КонецЕсли;
	
	Возврат ЭтоМаршрутизацияДействующегоКлиента;
КонецФункции

Функция ПроверитьИзменениеМодальности(Объект)
	ИзмененоБулево = Ложь;
	Если Объект.ММ_КоличествоВагонов <> Объект.КалькуляцияСозданаНаОсновании.ММ_КоличествоВагонов
		ИЛИ Объект.ММ_КоличествоКТК <> Объект.КалькуляцияСозданаНаОсновании.ММ_КоличествоКТК
		ИЛИ Объект.ММ_СтавкаПредоставленияПлатформы <> Объект.КалькуляцияСозданаНаОсновании.ММ_СтавкаПредоставленияПлатформы
		ИЛИ Объект.ММ_КоличествоКТКНаВагон <> Объект.КалькуляцияСозданаНаОсновании.ММ_КоличествоКТКНаВагон
		ИЛИ Объект.ММ_ГруженыйПоСуше <> Объект.КалькуляцияСозданаНаОсновании.ММ_ГруженыйПоСуше
		ИЛИ Объект.ММ_СтавкаПредоставленияКТК20 <> Объект.КалькуляцияСозданаНаОсновании.ММ_СтавкаПредоставленияКТК20
		ИЛИ Объект.ММ_СтавкаПредоставленияКТК40 <> Объект.КалькуляцияСозданаНаОсновании.ММ_СтавкаПредоставленияКТК40
		ИЛИ Объект.ЕдиницаИзмерения <> Объект.КалькуляцияСозданаНаОсновании.ЕдиницаИзмерения
		ИЛИ Объект.ЖД_РасчетСебестоимостиДляТипаФГП <> Объект.КалькуляцияСозданаНаОсновании.ЖД_РасчетСебестоимостиДляТипаФГП
		ИЛИ Объект.Груз <> Объект.КалькуляцияСозданаНаОсновании.Груз
		ИЛИ Объект.СтавкаНДС <> Объект.КалькуляцияСозданаНаОсновании.СтавкаНДС
		ИЛИ Объект.СуммаВключаетНДС <> Объект.КалькуляцияСозданаНаОсновании.СуммаВключаетНДС
		ИЛИ Объект.веб_ДляКТКЕвросиб <> Объект.КалькуляцияСозданаНаОсновании.веб_ДляКТКЕвросиб
		ИЛИ Объект.веб_ДляКТККлиента <> Объект.КалькуляцияСозданаНаОсновании.веб_ДляКТККлиента
		ИЛИ Объект.СпециальныеУсловия <> Объект.КалькуляцияСозданаНаОсновании.СпециальныеУсловия
