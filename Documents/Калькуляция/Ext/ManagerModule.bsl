Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт 

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "КП";
	КомандаПечати.Представление = "Коммерческое предложение";
	КомандаПечати.Обработчик    = "ДополнительныйМодульКлиент.ВыполнитьКомандуПечати";
	КомандаПечати.СписокФорм    = "ФормаСписка,ФормаДокумента";
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "КП") Тогда
		
		Для каждого ЭлМассива из МассивОбъектов Цикл
			//УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "КП", "Коммерческое предложение", НапечататьКП_ПоПростомуБезЭтихВашихБСП(МассивОбъектов),,"Документы.Калькуляция.ПФ_MXL_КоммерческоеПредложение");
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "КП", "Коммерческое предложение", НапечататьКП_ПоПростомуБезЭтихВашихБСП(ЭлМассива),,"Документы.Калькуляция.ПФ_MXL_КоммерческоеПредложение");
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция НапечататьКП_ПоПростомуБезЭтихВашихБСП(Документ)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;	
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Портрет;
	
	//////////////////////////////////
	
	//Макет = Документы.Калькуляция.ПолучитьМакет("ПФ_MXL_КоммерческоеПредложение2");
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.Калькуляция.ПФ_MXL_КоммерческоеПредложение2", Документ.Контрагент, Документ.Договор);
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	НомерВарианта = 1;
	
	Если Документ.кп2_ПоказыватьВремяВПути = Истина И Документ.кп2_ПоказыватьКоличествоКТК = Ложь Тогда
		НомерВарианта = 2;
	ИначеЕсли Документ.кп2_ПоказыватьВремяВПути = Ложь И Документ.кп2_ПоказыватьКоличествоКТК = Истина Тогда
		НомерВарианта = 3;
	ИначеЕсли Документ.кп2_ПоказыватьВремяВПути = Ложь И Документ.кп2_ПоказыватьКоличествоКТК = Ложь Тогда
		НомерВарианта = 4;
	КонецЕсли;
	
	ОбластьШапкаВ = Макет.ПолучитьОбласть("ШапкаВ"+НомерВарианта);
	ОбластьСтрокаВ = Макет.ПолучитьОбласть("СтрокаВ"+НомерВарианта);
	
	ОбластьПодвал1 = Макет.ПолучитьОбласть("Подвал1");
	
	ОбластьДогУслуги = Макет.ПолучитьОбласть("ДогУслуги");
	
	ОбластьПодвал2 = Макет.ПолучитьОбласть("Подвал2");
	
	ОбластьДопУслуги1 = Макет.ПолучитьОбласть("ДопУслуги1");
	ОбластьДопУслуги2 = Макет.ПолучитьОбласть("ДопУслуги2");
	
	ОбластьПодвал3 = Макет.ПолучитьОбласть("Подвал3");
	
	//////////////////////////////////
	
	Если ЗначениеЗаполнено(Документ.Контрагент) Тогда
		ОбластьШапка.Параметры.ПолноеНаименованиеКонтрагента = Документ.Контрагент.НаименованиеПолное;
	КонецЕсли;
	
	ОбластьШапка.Параметры.НачалоДействияКП = Формат(Документ.НачалоДействия, "ДФ=dd.MM.yyyy");
	Если Документ.кп2_УказыватьДатуОкончанияКП Тогда
		ОбластьШапка.Параметры.КонецДействияКП = "до " + Формат(Документ.ОкончаниеДействия, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	Если Документ.ТипЗаказа = Справочники.ТипыЗаказов.КонтейнерныйПоезд Тогда
		ОбластьШапка.Параметры.ОпциональноеДополнение = "в составе ускоренного контейнерного поезда";
	КонецЕсли;
	
	ОбластьШапка.Параметры.ВидСервиса = ?(Документ.ПС_ВидПеревозки = Справочники.ВидыПеревозок.Внутрироссийская, "внутригосударственном (внутрироссийском)", "международном");
	
//Евросиб ( Литвинов 21.01.2021 #30025
	ОбластьШапка.Параметры.НаименованиеПолное = Справочники.Организации.НаименованияНаДату(?(ЗначениеЗаполнено(Документ.Организация.ГоловнаяОрганизация), Документ.Организация.ГоловнаяОрганизация, Документ.Организация), Документ.Дата).НаименованиеПолное;
//Евросиб ) Литвинов 21.01.2021 #30025
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ТабличныйДокумент.Вывести(ОбластьШапкаВ);
	Для каждого Стр из Документ.КП2_СоставУслуг Цикл
		ЗаполнитьЗначенияСвойств(ОбластьСтрокаВ.Параметры, Стр);
		ТабличныйДокумент.Вывести(ОбластьСтрокаВ);
	КонецЦикла;
	
	ТабличныйДокумент.Вывести(ОбластьПодвал1);
	Для каждого Стр из Документ.КП2_ДоговорнаяЦенаВключает Цикл
		ОбластьДогУслуги.Параметры.УслугаДогЦены = Стр.Составляющая;
		ТабличныйДокумент.Вывести(ОбластьДогУслуги);
	КонецЦикла;
	
	Если Документ.КП2_ДоговорнаяЦенаНЕВключает.Количество() > 0 Тогда
		ОбластьДогУслугиНеВключает = Макет.ПолучитьОбласть("ДогУслугиНеВключает");
		ОбластьПодвалНеВключает = Макет.ПолучитьОбласть("ПодвалНеВключает");
		ТабличныйДокумент.Вывести(ОбластьПодвалНеВключает);
		Для каждого Стр из Документ.КП2_ДоговорнаяЦенаНЕВключает Цикл
			ОбластьДогУслугиНеВключает.Параметры.УслугаДогНеВключает = Стр.Составляющая;
			ТабличныйДокумент.Вывести(ОбластьДогУслугиНеВключает);
		КонецЦикла;
		
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(ОбластьПодвал2);
	Для каждого Стр из Документ.КП2_ДополнительныеУслуги Цикл
		Если Стр.ОтобразитьСТочкой Тогда
			ОбластьДопУслуги1.Параметры.УслугаДопЗаголовок = Стр.Составляющая;
			ТабличныйДокумент.Вывести(ОбластьДопУслуги1);
		Иначе
			ОбластьДопУслуги2.Параметры.УслугаДопТекст = Стр.Составляющая;
			ТабличныйДокумент.Вывести(ОбластьДопУслуги2);
		КонецЕсли;
	КонецЦикла;
	
	
	ОбластьПодвал3.Параметры.ПрименениеСтавкиНДС = ?(Документ.кп2_СтавкиНДСВСоответствииСЗаконодательством, "НДС в соответствии с законодательством РФ", "Все ставки указаны с учетом НДС " + Документ.СтавкаНДС);
	
	ОбластьПодвал3.Параметры.Валюта = Документ.Валюта;
	
	ТабличныйДокумент.Вывести(ОбластьПодвал3);
	
	ОбластьГруппаМенеджеров1 = Макет.ПолучитьОбласть("ГруппаМенеджеров1");
	
	ТекСекцияМенеджер = 0;
	
	Для Сч = 0 по Документ.КП2_ГруппаМенеджеров.Количество()-1 Цикл
		
		ТекСекцияМенеджер = Сч % 3 + 1;
		
		ОбластьГруппаМенеджеров1.Параметры["ФИО"+ТекСекцияМенеджер] = Документ.КП2_ГруппаМенеджеров[Сч].ФИО;
		ОбластьГруппаМенеджеров1.Параметры["Должность"+ТекСекцияМенеджер] = Документ.КП2_ГруппаМенеджеров[Сч].Должность;
		ОбластьГруппаМенеджеров1.Параметры["Телефон"+ТекСекцияМенеджер] = Документ.КП2_ГруппаМенеджеров[Сч].Телефон;
		ОбластьГруппаМенеджеров1.Параметры["Моб"+ТекСекцияМенеджер] = Документ.КП2_ГруппаМенеджеров[Сч].Мобильный;
		ОбластьГруппаМенеджеров1.Параметры["Почта"+ТекСекцияМенеджер] = Документ.КП2_ГруппаМенеджеров[Сч].ЭлПочта;
		
		Если ТекСекцияМенеджер = 3 Тогда
			ТабличныйДокумент.Вывести(ОбластьГруппаМенеджеров1);
			ОбластьГруппаМенеджеров1 = Макет.ПолучитьОбласть("ГруппаМенеджеров1");
		КонецЕсли;
		
	КонецЦикла;
	
	Если ТекСекцияМенеджер > 0 И ТекСекцияМенеджер < 3 Тогда
		ТабличныйДокумент.Вывести(ОбластьГруппаМенеджеров1);
	КонецЕсли;
	
	
	
	
	
	
	
	
	
