Процедура ЗаполнитьКлючиАналитикиСтрокКалькуляции(РазделКалькуляции) Экспорт
	
	ТекстЗапросаДляОтладки = "";
	Если РазделКалькуляции = Перечисления.РазделыКалькуляции.КалькуляцияМультимодальнойЦепочки Тогда
		ТаблицаКалькуляции = ММ_КалькуляцияМультимодальнойЦепочки;
	ИначеЕсли РазделКалькуляции = Перечисления.РазделыКалькуляции.КалькуляцияУслугВнеСтавки Тогда
		ТаблицаКалькуляции = ЖД_УслугиВнеСтавки;
	ИначеЕсли РазделКалькуляции = Перечисления.РазделыКалькуляции.КалькуляцияСтавокПоФрахту Тогда
		ТаблицаКалькуляции = НФ_ВыбранныеСтавки;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КлючиАналитикиСтрокКалькуляцииКлючевыеПоля.ИмяПоля КАК ИмяПоля,
	|	КлючиАналитикиСтрокКалькуляцииКлючевыеПоля.ИмяПоляКакВыражениеТекстаЗапроса КАК ИмяПоляКакВыражениеТекстаЗапроса,
	|	КлючиАналитикиСтрокКалькуляцииКлючевыеПоля.ЗначениеПоляКакВыражениеТекстаЗапроса КАК ЗначениеПоляКакВыражениеТекстаЗапроса
	|ИЗ
	|	Справочник.КлючиАналитикиСтрокКалькуляции.КлючевыеПоля КАК КлючиАналитикиСтрокКалькуляцииКлючевыеПоля
	|ГДЕ
	|	КлючиАналитикиСтрокКалькуляцииКлючевыеПоля.Ссылка.РазделКалькуляции = &РазделКалькуляции
	|	И КлючиАналитикиСтрокКалькуляцииКлючевыеПоля.Ссылка.ИспользуетсяКакШаблон
	|	И НЕ КлючиАналитикиСтрокКалькуляцииКлючевыеПоля.Ссылка.ПометкаУдаления";
	Запрос.УстановитьПараметр("РазделКалькуляции", РазделКалькуляции);
	РезультатЗапроса = Запрос.Выполнить();
	КлючевыеПоля = РезультатЗапроса.Выгрузить();
	ТекстЗапросаПоля = "";                               
	ИндексСтроки = 0;
	Запрос = Новый Запрос; 
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_СтрокиКалькуляции ИЗ &СтрокиКалькуляции КАК СтрокиКалькуляции";
	Запрос.УстановитьПараметр("СтрокиКалькуляции", ТаблицаКалькуляции.Выгрузить());
	ТекстЗапросаДляОтладки = ТекстЗапросаДляОтладки + Запрос.Текст + ";";
	Запрос.Выполнить();
	
	ТекстЗапросаОбщий = "";                                  
	ВсегоЗапросов = 0; 
	Для каждого КлючевоеПоле Из КлючевыеПоля Цикл        
		ВсегоЗапросов = ВсегоЗапросов + 1;
		ШаблонЗапроса = ПолучитьШаблонЗапроса(); 
		Если ЗначениеЗаполнено(КлючевоеПоле.ИмяПоляКакВыражениеТекстаЗапроса) Тогда
			ТекстЗапроса = СтрЗаменить(ШаблонЗапроса, "&ИмяПоляКалькуляции", СтрШаблон("%1", КлючевоеПоле.ИмяПоляКакВыражениеТекстаЗапроса));
		Иначе			
			ТекстЗапроса = СтрЗаменить(ШаблонЗапроса, "&ИмяПоляКалькуляции", СтрШаблон("""%1""", КлючевоеПоле.ИмяПоля));
		КонецЕсли;
		Если ЗначениеЗаполнено(КлючевоеПоле.ЗначениеПоляКакВыражениеТекстаЗапроса) Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЗначениеПоляКалькуляции", СтрШаблон("%1", КлючевоеПоле.ЗначениеПоляКакВыражениеТекстаЗапроса));
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЗначениеПоляКалькуляции", СтрШаблон("СтрокиКалькуляции.%1", КлючевоеПоле.ИмяПоля));
		КонецЕсли;
		Если ВсегоЗапросов > 1 Тогда
			ТекстЗапросаОбщий = ТекстЗапросаОбщий + "
			|ОБЪЕДИНИТЬ ВСЕ
			|";
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ ВТ_ПоляСтрокКалькуляции", "");
		КонецЕсли;
		ТекстЗапросаОбщий = ТекстЗапросаОбщий + ТекстЗапроса;
	КонецЦикла;   
	Запрос.Текст = ТекстЗапросаОбщий;
	ТекстЗапросаДляОтладки = ТекстЗапросаДляОтладки + Запрос.Текст;
	Запрос.Выполнить();
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КлючиАналитикиСтрокКалькуляцииКлючевыеПоля.Ссылка КАК КлючАналитики,
	|   ВЫБОР КОГДА КлючиАналитикиСтрокКалькуляцииКлючевыеПоля.Ссылка = &ТекущийКлючАналитики Тогда 1 Иначе 0 КОНЕЦ КАК ДополнительнаяСортировка
	|ИЗ
	|	Справочник.КлючиАналитикиСтрокКалькуляции.КлючевыеПоля КАК КлючиАналитикиСтрокКалькуляцииКлючевыеПоля
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПоляСтрокКалькуляции КАК т
	|		ПО КлючиАналитикиСтрокКалькуляцииКлючевыеПоля.ИмяПоля = т.ИмяПоля
	|			И КлючиАналитикиСтрокКалькуляцииКлючевыеПоля.ЗначениеПоля = т.ЗначениеПоля
	|			И (т.ИдентификаторСтроки = &ИдентификаторСтроки)
	|ГДЕ
	|	КлючиАналитикиСтрокКалькуляцииКлючевыеПоля.Ссылка.РазделКалькуляции = &РазделКалькуляции
	|   И НЕ КлючиАналитикиСтрокКалькуляцииКлючевыеПоля.Ссылка.ПометкаУдаления 
	|
	|СГРУППИРОВАТЬ ПО
	|	КлючиАналитикиСтрокКалькуляцииКлючевыеПоля.Ссылка
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(КлючиАналитикиСтрокКалькуляцииКлючевыеПоля.Ссылка) = &КоличествоАналитик
	|УПОРЯДОЧИТЬ ПО ДополнительнаяСортировка УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	т.ИмяПоля КАК ИмяПоля,
	|	т.ЗначениеПоля КАК ЗначениеПоля
	|ИЗ
	|	ВТ_ПоляСтрокКалькуляции КАК т
	|ГДЕ
	|	т.ИдентификаторСтроки = &ИдентификаторСтроки"; 
	Запрос.УстановитьПараметр("РазделКалькуляции", РазделКалькуляции);
	СтрокиДляЗаполнения = ТаблицаКалькуляции;
	Для каждого СтрокаДляЗаполнения Из СтрокиДляЗаполнения Цикл  
		ТекстЗапросаДляОтладкиВЦикле = "";
		Запрос.УстановитьПараметр("ИдентификаторСтроки", СтрокаДляЗаполнения.ИдентификаторСтроки);
		Запрос.УстановитьПараметр("КоличествоАналитик", КлючевыеПоля.Количество());
		Запрос.УстановитьПараметр("ТекущийКлючАналитики", СтрокаДляЗаполнения.КлючАналитикиСтрокиКалькуляции);
		ТекстЗапросаДляОтладкиВЦикле = ТекстЗапросаДляОтладки + Запрос.Текст;
		Пакеты = Запрос.ВыполнитьПакет();
		КоличествоПакетов = Пакеты.Количество();
		Если Пакеты[КоличествоПакетов-2].Пустой() Тогда
			Ключ = Справочники.КлючиАналитикиСтрокКалькуляции.СоздатьЭлемент();
			Ключ.РазделКалькуляции = РазделКалькуляции;
			Ключ.КлючевыеПоля.Загрузить(Пакеты[КоличествоПакетов-1].Выгрузить());
			Ключ.Записать();
			КлючАналитики = Ключ.Ссылка;
		Иначе
			КлючАналитики = Пакеты[КоличествоПакетов-2].Выгрузить()[0].КлючАналитики
