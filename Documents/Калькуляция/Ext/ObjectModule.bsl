Функция ПолучитьСуммуБезНДС(Сумма, Ставка)
	
	Множитель = 1;
	Если Ставка = Перечисления.СтавкиНДС.НДС10 Тогда
		Множитель = 1.1;
	ИначеЕсли Ставка = Перечисления.СтавкиНДС.НДС18 Тогда
		Множитель = 1.18;
	ИначеЕсли Ставка = Перечисления.СтавкиНДС.НДС20 Тогда
		Множитель = 1.20; 
	// Евросиб(ДИТ) US 96051 ТА 96052 Сержантова А.С. Начало: 13.01.2025
	ИначеЕсли Ставка = Перечисления.СтавкиНДС.НДС7 Тогда
		Множитель = 1.07;
	ИначеЕсли Ставка = Перечисления.СтавкиНДС.НДС5 Тогда
		Множитель = 1.05;
	// Евросиб(ДИТ) US 96051 ТА 96052 Сержантова А.С. Конец: 13.01.2025
	//Евросиб СубботинВ #125845 09.12.2025 Начало
	ИначеЕсли Ставка = Перечисления.СтавкиНДС.НДС22 Тогда
		Множитель = 1.22;
	//Евросиб СубботинВ #125845 09.12.2025 Конец
	КонецЕсли;
	
	Возврат Сумма / Множитель;
	
КонецФункции
Функция ПолучитьСписокПСЦ()
	Запрос=Новый Запрос;
	Запрос.Текст= "ВЫБРАТЬ
	              |	ПСЦКалькуляции.Ссылка КАК ПСЦ
	              |ИЗ
	              |	Документ.ПСЦ.Калькуляции КАК ПСЦКалькуляции
	              |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПСЦ.Состояния КАК ПСЦСостояния
	              |		ПО ПСЦКалькуляции.Ссылка = ПСЦСостояния.Ссылка
	              |ГДЕ
	              |	ПСЦСостояния.Состояние.Согласование = ИСТИНА
	              |	И ПСЦСостояния.Статус В(&Статус)
	              |	И ПСЦКалькуляции.Калькуляция = &Калькуляция
	              |	И (ПСЦКалькуляции.Ссылка.Контрагент <> &Контрагент
	              |			ИЛИ ПСЦКалькуляции.Ссылка.Договор <> &Договор)
	              |
	              |СГРУППИРОВАТЬ ПО
	              |	ПСЦКалькуляции.Ссылка" ;
  Запрос.УстановитьПараметр("Калькуляция",Ссылка);
  МассивСтатус=Новый Массив;
  МассивСтатус.Добавить(Перечисления.СтатусыЭтапов.НаВыполнение);
  МассивСтатус.Добавить(Перечисления.СтатусыЭтапов.Выполнен);
  Запрос.УстановитьПараметр("Статус",МассивСтатус);
  Запрос.УстановитьПараметр("Контрагент",Контрагент);
  Запрос.УстановитьПараметр("Договор",Договор);
 
  Результат=Запрос.Выполнить().Выгрузить();
  Возврат Результат;
КонецФункции

