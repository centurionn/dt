Процедура ОбновитьДанныеДляПечатиВПСЦ()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПСЦКалькуляции.Ссылка КАК ПСЦ
	|ИЗ
	|	Документ.ПСЦ.Калькуляции КАК ПСЦКалькуляции
	|ГДЕ
	|	ПСЦКалькуляции.Калькуляция = &Калькуляция
	|	И НЕ ПСЦКалькуляции.Ссылка.ПСЦПоставщика
	|	И НЕ ПСЦКалькуляции.Ссылка.НетиповойПротокол
	|	И ПСЦКалькуляции.Ссылка.СтатусДокумента = ЗНАЧЕНИЕ(Перечисление.СтатусыСогласования.Планируется)";
	
	Запрос.УстановитьПараметр("Калькуляция", Ссылка);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		// Перезаполнить печатные данные
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Документ.ПСЦ");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Выборка.ПСЦ);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		
		ПСЦОбъект = Выборка.ПСЦ.ПолучитьОбъект();
		Документы.ПСЦ.ЗаполнитьДанныеДляПечати(ПСЦОбъект);
		ПСЦОбъект.Записать();
	КонецЦикла;
		
КонецПроцедуры
