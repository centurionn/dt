Процедура ПриЗаписи(Отказ)
	
	// Евросиб Фролов (06.04.2022
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли; 	
	// Евросиб Фролов)
	
	// блок отработки родительского документа
	МассивСостояний = МаршрутизацияСервер.НайтиПолучитьМассивСостоянийДляОтметки(Состояния);
	МассивРодительскихДокументов = Новый Массив;
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		МассивРодительскихДокументов.Добавить(ДокументОснование);
	КонецЕсли;
	МаршрутизацияСервер.ОтметитьВыполнениеРодительскогоДокументаАвтоматически(МассивРодительскихДокументов, МассивСостояний, Отказ);
	
	
	//////// Пересчет планов продаж в случае, если он не зафиксирован и калькуляция изменена!!!
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ПланПродажПродукты.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ПланПродаж.Продукты КАК ПланПродажПродукты
	               |ГДЕ
	               |	ПланПродажПродукты.Калькуляция = &Калькуляция
	               |	И НЕ ПланПродажПродукты.Ссылка.ПланПродажЗафиксирован
	               |	И НЕ ПланПродажПродукты.Ссылка.ПометкаУдаления";
	Запрос.УстановитьПараметр("Калькуляция", Ссылка);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		ПланОбъект = Ответ.Ссылка.ПолучитьОбъект();
		
		Для каждого стр из ПланОбъект.Продукты Цикл
			
			Если Стр.Калькуляция = Ссылка Тогда
				
				Если НЕ СуммаВключаетНДС ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС0 ИЛИ Стр.Калькуляция.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС Тогда
					
					// доходы 20
					Стр.СтавкаЗа20 = ММ_ИтогоСтавка20;
					Для каждого Стр8 из ЖД_УслугиВнеСтавки Цикл
						Стр.СтавкаЗа20 = Стр.СтавкаЗа20 + Стр8.Ставка20;
					КонецЦикла;
					
					// доходы 40
					Стр.СтавкаЗа40 = ММ_ИтогоСтавка;
					Для каждого Стр8 из ЖД_УслугиВнеСтавки Цикл
						Стр.СтавкаЗа40 = Стр.СтавкаЗа40 + Стр8.Ставка40;
					КонецЦикла;
					
					// контрибуция 20
					Стр.КонтрибуцияЗа20 = ММ_ИтогоВознаграждение20;
					Для каждого Стр8 из ЖД_УслугиВнеСтавки Цикл
						Стр.КонтрибуцияЗа20 = Стр.КонтрибуцияЗа20 + Стр8.Вознаграждение20;
					КонецЦикла;
					
					// контрибуция 40
					Стр.КонтрибуцияЗа40 = ММ_ИтогоВознаграждение;
					Для каждого Стр8 из ЖД_УслугиВнеСтавки Цикл
						Стр.КонтрибуцияЗа40 = Стр.КонтрибуцияЗа40 + Стр8.Вознаграждение40;
					КонецЦикла;
					
				Иначе
					
					// доходы 20
					Стр.СтавкаЗа20 = ПолучитьСуммуБезНДС(ММ_ИтогоСтавка20, СтавкаНДС);
					Для каждого Стр8 из ЖД_УслугиВнеСтавки Цикл
						Стр.СтавкаЗа20 = Стр.СтавкаЗа20 + ПолучитьСуммуБезНДС(Стр8.Ставка20, СтавкаНДС);
					КонецЦикла;
					
					// доходы 40
					Стр.СтавкаЗа40 = ПолучитьСуммуБезНДС(ММ_ИтогоСтавка, СтавкаНДС);
					Для каждого Стр8 из ЖД_УслугиВнеСтавки Цикл
						Стр.СтавкаЗа40 = Стр.СтавкаЗа40 + ПолучитьСуммуБезНДС(Стр8.Ставка40, СтавкаНДС);
					КонецЦикла;
					
					// контрибуция 20
					Стр.КонтрибуцияЗа20 = ПолучитьСуммуБезНДС(ММ_ИтогоВознаграждение20, СтавкаНДС);
					Для каждого Стр8 из Стр.Калькуляция.ЖД_УслугиВнеСтавки Цикл
						Стр.КонтрибуцияЗа20 = Стр.КонтрибуцияЗа20 + ПолучитьСуммуБезНДС(Стр8.Вознаграждение20, СтавкаНДС);
					КонецЦикла;
					
					// контрибуция 40
					Стр.КонтрибуцияЗа40 = ПолучитьСуммуБезНДС(ММ_ИтогоВознаграждение, СтавкаНДС);
					Для каждого Стр8 из Стр.Калькуляция.ЖД_УслугиВнеСтавки Цикл
						Стр.КонтрибуцияЗа40 = Стр.КонтрибуцияЗа40 + ПолучитьСуммуБезНДС(Стр8.Вознаграждение40, СтавкаНДС);
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ПланОбъект.Записать(РежимЗаписиДокумента.Запись);
		Сообщить("План продаж был обновлен: " + ПланОбъект.Ссылка);
		Попытка
			ПланОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ОО = ОписаниеОшибки();
			Сообщить("Ошибка проведения: " + ОО);
		КонецПопытки;
		
	КонецЦикла;
	
	// Евросиб Фролов (28.12.2021 TASK№ 42761
	Если Не Отказ И ЭтотОбъект.ДополнительныеСвойства.Свойство("КалькуляцияИзменена") Тогда
		ОбновитьДанныеДляПечатиВПСЦ();
		//Евросиб Коханенко Н.А. 15.02.2024 (( #80981 
		ОтложенноеИзменениеСервер.ПоставитьСвязанныеОбъектыВОчередьИзмененияПоИсточникуКалькуляция(ЭтотОбъект.Ссылка);
		//Евросиб Коханенко Н.А. 15.02.2024 )) #80981 
	КонецЕсли;
	// Евросиб Фролов)
	
	//Евросиб СубботинВ #131884 02.03.2026 Начало
	Если ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		ПланыОбмена.ВыгрузкаДанных.УдалитьРегистрациюИзменений(Ссылка, Перечисления.УзлыОбмена.DX);
	ИначеЕсли ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда 
	//Евросиб СубботинВ #131884 02.03.2026 Конец		
		//Евросиб Каблов 14.11.2024 ( #93051	
		ПланыОбмена.ВыгрузкаДанных.ЗарегистрироватьИзмененияПоДокументу(Ссылка, Перечисления.УзлыОбмена.DX);
		//Евросиб Каблов 14.11.2024 ) 
	//Евросиб СубботинВ #131884 02.03.2026 Начало
	КонецЕсли;
	//Евросиб СубботинВ #131884 02.03.2026 Конец
	
	
	
	// Евросиб US 88683 TA 108959 Рыбьяков К.А. 26.05.2025 ((
	Если Не Отказ Тогда
		ПроверитьИзмененияВКлючахАналитикиНоминацийРелиза(Ссылка);
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 26.05.2025 ))
	
	//Евросиб Шевченко А.В. 03.06.2025 US 97974 TA 111305
	Если ДополнительныеСвойства.Свойство("НормативнаяКонтрибуция") Тогда
		Если ЗначениеЗаполнено(ДополнительныеСвойства.НормативнаяКонтрибуция) Тогда
			РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ЗаписатьНормативнуюКонтрибуциюпоДокументу(Ссылка, ДополнительныеСвойства.НормативнаяКонтрибуция);
		Иначе
			РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.УдалитьАналитикуДокумента(Ссылка, ПланыВидовХарактеристик.ДополнительныеАналитикиДокументов.НормативнаяКонтрибуция);
		КонецЕсли;
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("РасчетнаяКонтрибуция20") Тогда
		Если ЗначениеЗаполнено(ДополнительныеСвойства.РасчетнаяКонтрибуция20) Тогда
			РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ЗаписатьРасчетнуюКонтрибуцию20поДокументу(Ссылка, ДополнительныеСвойства.РасчетнаяКонтрибуция20);
		Иначе
			РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.УдалитьАналитикуДокумента(Ссылка, ПланыВидовХарактеристик.ДополнительныеАналитикиДокументов.РасчетнаяКонтрибуция20);
		КонецЕсли;
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("РасчетнаяКонтрибуция40") Тогда
		Если ЗначениеЗаполнено(ДополнительныеСвойства.РасчетнаяКонтрибуция40) Тогда
			РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ЗаписатьРасчетнуюКонтрибуцию40поДокументу(Ссылка, ДополнительныеСвойства.РасчетнаяКонтрибуция40);
		Иначе
			РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.УдалитьАналитикуДокумента(Ссылка, ПланыВидовХарактеристик.ДополнительныеАналитикиДокументов.РасчетнаяКонтрибуция40);
		КонецЕсли;
	КонецЕсли;
	//Евросиб Шевченко А.В. 03.06.2025 US 97974 TA 111305 
	
	//Евросиб Коханенко Н.А. 05.08.2025 (( #115687 
	Если ДополнительныеСвойства.Свойство("ВидЗадолженности") Тогда
		Если ЗначениеЗаполнено(ДополнительныеСвойства.ВидЗадолженности) Тогда
			//запишем аналитику для калькуляции 
			РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ЗаписатьВидЗадолженностиПоДокументу(Ссылка, ДополнительныеСвойства.ВидЗадолженности);
			//получим список связанных заявок
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	ЗаявкаСоставУслуги.Ссылка КАК Ссылка
				|ИЗ
				|	Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
				|ГДЕ
				|	ЗаявкаСоставУслуги.Калькуляция = &Калькуляция";
			Запрос.УстановитьПараметр("Калькуляция", Ссылка);
			МассивДокументов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"); 
			Для Каждого ДокументСсылка Из МассивДокументов Цикл
				РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ЗаписатьАналитикуДокумента(ДокументСсылка, 
																			ПланыВидовХарактеристик.ДополнительныеАналитикиДокументов.ВидЗадолженности, 
																			ДополнительныеСвойства.ВидЗадолженности);
			КонецЦикла;
		Иначе
			РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.УдалитьАналитикуДокумента(Ссылка, ПланыВидовХарактеристик.ДополнительныеАналитикиДокументов.ВидЗадолженности);
		КонецЕсли;
	КонецЕсли;
	//Евросиб Коханенко Н.А. 05.08.2025 )) #115687 
	
