Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	//++ДИТ Моисеенко Ю.В. Ticket#0290442 08.11.2022
	МассивНепроверяемыхРеквизитов = Новый Массив;
	МассивНепроверяемыхРеквизитов.Добавить("ММ_КалькуляцияМультимодальнойЦепочки.Услуга");
	
	Для Каждого СтрокаКалькуляции Из ММ_КалькуляцияМультимодальнойЦепочки Цикл
		
		Префикс = "ММ_КалькуляцияМультимодальнойЦепочки[" + Формат(СтрокаКалькуляции.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].";
		
		Если Не ЗначениеЗаполнено(СтрокаКалькуляции.Услуга) Тогда
			ТекстСообщения = СтрШаблон("В таблице 1.3 в строке %1 поле «Услуга» не заполнено", СтрокаКалькуляции.НомерСтроки);
			Поле = Префикс + "Услуга";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект", Отказ);		
		КонецЕсли;
		
	КонецЦикла;
	
	//Евросиб Коханенко Н.А. 12.03.2025 (( #100979
	АвтозаполнениеПродуктаВКалькуляцииСДаты = Константы.АвтозаполнениеПродуктаВКалькуляцииСДаты.Получить();
	Если Дата < АвтозаполнениеПродуктаВКалькуляцииСДаты Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ТипКалькуляции");
		МассивНепроверяемыхРеквизитов.Добавить("ТипЗаказа");
		МассивНепроверяемыхРеквизитов.Добавить("УчетноеНаправление");
		МассивНепроверяемыхРеквизитов.Добавить("ПродуктДКП");
	КонецЕсли;
	//Евросиб Коханенко Н.А. 12.03.2025 )) #100979 
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	//--ДИТ Моисеенко Ю.В. Ticket#0290442 08.11.2022 
	
	//Евросиб Коханенко Н.А. 25.12.2023 (( #72829 
	Если КонтрагентыДоговоры_сервер.КонтрагентЯвляетсяДирекциейКонтейнерныхПеревозок(Контрагент) 
		И КалькуляцииЗаявкиПСЦСервер.ТипКалькуляцииЯвляетсяМежсервиснымиРасходами(ТипКалькуляции) Тогда
		//в служебной калькуляции Комментарий не может оставаться не заполненным
		Если НЕ ЗначениеЗаполнено(Комментарий) Тогда
			ОбщегоНазначения.СообщитьПользователю("Поле ""Комментарий"" в служебной калькуляции не может оставаться не заполненным",, "Комментарий", "Объект", Отказ);
		КонецЕсли;
        //Евросиб Коханенко Н.А. 25.12.2023 (( #78960 
		//в служебной сделке должно быть выбрано либо одно, либо другое из значений Отнесения Расходов
		Если НЕ (ОтнестиРасходыНаСебестоимостьКлиента ИЛИ ОтнестиРасходыНаСобственныеЗатраты) Тогда
			ОбщегоНазначения.СообщитьПользователю("Калькуляция не может быть проведена, т.к. вы не выбрали условие по отнесению затрат.",,"ОтнестиРасходыНаСебестоимостьКлиента", "Объект", Отказ);
		КонецЕсли;
		//Евросиб Коханенко Н.А. 25.12.2023 )) #78960
	КонецЕсли;
	//Евросиб Коханенко Н.А. 25.12.2023 )) #72829 
	
	//Евросиб Коханенко Н.А. 25.12.2023 (( #79188
	ПроверитьЗаполнениеЦенНаОтрицательность(Отказ);
	//Евросиб Коханенко Н.А. 25.12.2023 )) #79188 
	
	//Евросиб Коханенко Н.А. 12.02.2026 (( #93365
	Отказ = ПроверкаСоответствияЗначенийРеквизитовКалькуляцииЗаявкиПСЦ(Отказ);
	//Евросиб Коханенко Н.А. 12.02.2026 )) #93365 

