			|	&ПроверятьКонтрагент И вт_СвязанныеПСЦ.Контрагент <> &Контрагент КАК ОшибкаКонтрагент,
			|	&ПроверятьДоговор И вт_СвязанныеПСЦ.Договор <> &Договор КАК ОшибкаДоговор,
			|	&ПроверятьОрганизация И вт_СвязанныеПСЦ.Организация <> &Организация КАК ОшибкаОрганизация,			
			|	&ПроверятьЦФО И вт_СвязанныеПСЦ.ЦФО <> &ЦФО КАК ОшибкаЦФО,
			|	&ПроверятьТипКалькуляции И вт_СвязанныеПСЦ.ТипКалькуляции <> &ТипКалькуляции КАК ОшибкаТипКалькуляции,
			|	&ПроверятьВалюта И вт_СвязанныеПСЦ.Валюта <> &Валюта КАК ОшибкаВалюта
			|ИЗ
			|	вт_СвязанныеПСЦ КАК вт_СвязанныеПСЦ
			|ГДЕ
			|	(&ПроверятьКонтрагент
			|				И вт_СвязанныеПСЦ.Контрагент <> &Контрагент
			|			ИЛИ &ПроверятьДоговор
			|				И вт_СвязанныеПСЦ.Договор <> &Договор
			|			ИЛИ &ПроверятьОрганизация
			|				И вт_СвязанныеПСЦ.Организация <> &Организация
			|			ИЛИ &ПроверятьЦФО
			|				И вт_СвязанныеПСЦ.ЦФО <> &ЦФО
			|			ИЛИ &ПроверятьТипКалькуляции
			|				И вт_СвязанныеПСЦ.ТипКалькуляции <> &ТипКалькуляции
			|			ИЛИ &ПроверятьВалюта
			|				И вт_СвязанныеПСЦ.Валюта <> &Валюта)
			|УПОРЯДОЧИТЬ ПО
			|	Номер
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	вт_СвязанныеЗаявки.Номер КАК Номер,
			|	&ПроверятьКонтрагент И вт_СвязанныеЗаявки.Контрагент <> &Контрагент КАК ОшибкаКонтрагент,
			|	&ПроверятьДоговор И вт_СвязанныеЗаявки.Договор <> &Договор КАК ОшибкаДоговор,
			|	&ПроверятьТранзитДляКлиента И вт_СвязанныеЗаявки.ТранзитДляКлиента <> &ТранзитДляКлиента КАК ОшибкаТранзитДляКлиента
			|ИЗ
			|	вт_СвязанныеЗаявки КАК вт_СвязанныеЗаявки
			|ГДЕ
			|	(&ПроверятьКонтрагент
			|				И вт_СвязанныеЗаявки.Контрагент <> &Контрагент
			|			ИЛИ &ПроверятьДоговор
			|				И вт_СвязанныеЗаявки.Договор <> &Договор
			|			ИЛИ &ПроверятьТранзитДляКлиента
			|				И вт_СвязанныеЗаявки.ТранзитДляКлиента <> &ТранзитДляКлиента)
			|УПОРЯДОЧИТЬ ПО
			|	Номер
			|";
		Запрос.УстановитьПараметр("Калькуляция", Ссылка);
		Для Каждого Параметр Из ИзмененныеРеквизиты Цикл
			Запрос.УстановитьПараметр("Проверять" + Параметр.Ключ, Параметр.Проверять);
			Запрос.УстановитьПараметр(Параметр.Ключ, ЭтотОбъект[Параметр.Ключ]);
		КонецЦикла; 
		//пока непонятно, как проверять этот реквизит
		Запрос.УстановитьПараметр("ПроверятьТранзитДляКлиента", Ложь);
		Запрос.УстановитьПараметр("ТранзитДляКлиента", Неопределено);
		Результат = Запрос.ВыполнитьПакет();
		ВыборкаПСЦ = Результат[2].Выбрать();
		Пока ВыборкаПСЦ.Следующий() Цикл
			МассивРеквизитов = Новый Массив;
			Если ВыборкаПСЦ.ОшибкаКонтрагент Тогда МассивРеквизитов.Добавить("Контрагент") КонецЕсли;
			Если ВыборкаПСЦ.ОшибкаДоговор Тогда МассивРеквизитов.Добавить("Договор") КонецЕсли;
			Если ВыборкаПСЦ.ОшибкаОрганизация Тогда МассивРеквизитов.Добавить("Организация") КонецЕсли;
			Если ВыборкаПСЦ.ОшибкаЦФО Тогда МассивРеквизитов.Добавить("ЦФО") КонецЕсли;
			Если ВыборкаПСЦ.ОшибкаТипКалькуляции Тогда МассивРеквизитов.Добавить("ТипКалькуляции") КонецЕсли;
			Если ВыборкаПСЦ.ОшибкаВалюта Тогда МассивРеквизитов.Добавить("Валюта") КонецЕсли;
			ОбщегоНазначения.СообщитьПользователю(СформироватьТекстСообщенияОНесоответствииЗначенийРеквизитов("ПСЦ", ВыборкаПСЦ.Номер, МассивРеквизитов));
			РезультатОтказ = Истина;
		КонецЦикла;   
		ВыборкаЗаявки = Результат[3].Выбрать();
		Пока ВыборкаЗаявки.Следующий() Цикл
			МассивРеквизитов = Новый Массив;
			Если ВыборкаЗаявки.ОшибкаКонтрагент Тогда МассивРеквизитов.Добавить("Контрагент") КонецЕсли;
			Если ВыборкаЗаявки.ОшибкаДоговор Тогда МассивРеквизитов.Добавить("Договор") КонецЕсли;
			Если ВыборкаЗаявки.ОшибкаТранзитДляКлиента Тогда МассивРеквизитов.Добавить("ТранзитДляКлиента") КонецЕсли;
			ОбщегоНазначения.СообщитьПользователю(СформироватьТекстСообщенияОНесоответствииЗначенийРеквизитов("Заявке", ВыборкаЗаявки.Номер, МассивРеквизитов));
			РезультатОтказ = Истина;
		КонецЦикла; 
	КонецЕсли;
	
	Возврат РезультатОтказ;

КонецФункции //Евросиб Коханенко Н.А. 12.02.2026 )) #93365 

