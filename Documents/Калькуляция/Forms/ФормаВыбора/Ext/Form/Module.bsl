
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Евросиб US 87896 Рыбьяков К.А. 31.07.2024 ((
	Если Параметры.Свойство("ДоступныеКалькуляции") Тогда
		Список.Параметры.УстановитьЗначениеПараметра("ДоступныеКалькуляции", Истина);
		Список.Параметры.УстановитьЗначениеПараметра("СписокДоступных", Параметры.ДоступныеКалькуляции);
	Иначе
		Список.Параметры.УстановитьЗначениеПараметра("ДоступныеКалькуляции", Ложь);
		Список.Параметры.УстановитьЗначениеПараметра("СписокДоступных", Неопределено);
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 31.07.2024 ))
		
	Если Параметры.Свойство("ПоказКалькуляций") Тогда
		ПоказКалькуляций = Параметры.ПоказКалькуляций;
	КонецЕсли;
	
	Если Параметры.Свойство("Клиент") Тогда
		Список.Параметры.УстановитьЗначениеПараметра("Клиент", Параметры.Клиент);
		Список.Параметры.УстановитьЗначениеПараметра("КлиентЗаполнен", Истина);
	Иначе
		Список.Параметры.УстановитьЗначениеПараметра("Клиент", неопределено);
		Список.Параметры.УстановитьЗначениеПараметра("КлиентЗаполнен", Ложь);
	КонецЕсли;
	
	Список.Параметры.УстановитьЗначениеПараметра("ПоказКалькуляций", ПоказКалькуляций);
	Список.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", ТекущаяДата());
	
	Если Параметры.Свойство("ПодходящиеКалькуляции") Тогда
		Если Параметры.Свойство("Клиент") Тогда
			Список.Параметры.УстановитьЗначениеПараметра("Клиент", Параметры.Клиент);
			Список.Параметры.УстановитьЗначениеПараметра("КлиентЗаполнен", Истина);
		Иначе
			Список.Параметры.УстановитьЗначениеПараметра("Клиент", неопределено);
			Список.Параметры.УстановитьЗначениеПараметра("КлиентЗаполнен", Ложь);
		КонецЕсли;
		
		СписокПодходящихКалькуляций = Параметры.ПодходящиеКалькуляции;
		Элементы.ПодходящиеКалькуляции.Видимость = Истина;
		ПодходящиеКалькуляции = Истина;
	Иначе
		Элементы.ПодходящиеКалькуляции.Видимость = Ложь;
		ПодходящиеКалькуляции = Ложь;
	КонецЕсли;
	
	//ДИТ Пак И.Т. Task34426 21.05.2021 Начало
	ЭтаФорма.ВызваноИзПродукта = Параметры.Свойство("ВызовИзПродукта") И Параметры.ВызовИзПродукта = Истина;
	//ДИТ Пак И.Т. Task34426 21.05.2021 Конец
	

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры

&НаКлиенте
Процедура ПоказКалькуляцийПриИзменении(Элемент)
	
	Список.Параметры.УстановитьЗначениеПараметра("ПоказКалькуляций", ПоказКалькуляций);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПоКалькуляциям()
	Если ПодходящиеКалькуляции Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,"Ссылка", СписокПодходящихКалькуляций,ВидСравненияКомпоновкиДанных.ВСписке);
	Иначе
		ОбщегоНазначенияКлиентСервер. УдалитьЭлементыГруппыОтбораДинамическогоСписка(Список,"Ссылка")
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОтборПоКалькуляциям();
КонецПроцедуры

&НаКлиенте
Процедура ПодходящиеКалькуляцииПриИзменении(Элемент)
	ОтборПоКалькуляциям();
КонецПроцедуры
