&НаСервереБезКонтекста
Функция ОчиститьФорматПеревозки(ФПеревозки)
	
	Результат = ФПеревозки;
	
	МассивСоставляющих = СтрРазделить(ФПеревозки, "-", Ложь);
	
	Если МассивСоставляющих.Количество() > 1 Тогда
		Результат = МассивСоставляющих[1];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


&НаСервере
Процедура АвтоматическоеЗаполнениеКПрНаСервере()
	
	УслПредоставленияКТК = Константы.УслугаОтражающаяПредоставлениеКТКДляКалькуляции.Получить();
	
	Объект.КП2_СоставУслуг.Очистить();
	Объект.КП2_ДоговорнаяЦенаВключает.Очистить();
	Объект.КП2_ДополнительныеУслуги.Очистить();
	
	УслугаПредоставленияКТК = Объект.ММ_КалькуляцияМультимодальнойЦепочки.НайтиСтроки(Новый Структура("Услуга", УслПредоставленияКТК));
	
	Если Объект.ММ_ИтогоСтавка20 > 0 И УслугаПредоставленияКТК.Количество() > 0 Тогда
		
		НСтр = Объект.КП2_СоставУслуг.Добавить();
		НСтр.СтанцияОтправления = Объект.Суша_ПунктОтправления.Наименование;
		НСтр.СтанцияНазначения = Объект.Суша_ПунктНазначения.Наименование;
		НСтр.УсловияПеревозки = "" + ОчиститьФорматПеревозки(Объект.УсловияПеревозки_Отправление) + " - " + ОчиститьФорматПеревозки(Объект.УсловияПеревозки_Прибытие);
		НСтр.ВремяВПути = Объект.ММ_КалькуляцияЖДСоставляющей.Итог("ДлительностьДней");
		НСтр.КоличествоКТК = 0;
		НСтр.Типоразмер = "20 футов с предоставлением контейнера";
		НСтр.СтавкаБезОхраны = Объект.ММ_ИтогоСтавка20;
		
		НСтр = Объект.КП2_СоставУслуг.Добавить();
		НСтр.СтанцияОтправления = Объект.Суша_ПунктОтправления.Наименование;
		НСтр.СтанцияНазначения = Объект.Суша_ПунктНазначения.Наименование;
		НСтр.УсловияПеревозки = "" + ОчиститьФорматПеревозки(Объект.УсловияПеревозки_Отправление) + " - " + ОчиститьФорматПеревозки(Объект.УсловияПеревозки_Прибытие);
		НСтр.ВремяВПути = Объект.ММ_КалькуляцияЖДСоставляющей.Итог("ДлительностьДней");
		НСтр.КоличествоКТК = 0;
		НСтр.Типоразмер = "20 футов контейнер клиента";
		НСтр.СтавкаБезОхраны = Объект.ММ_ИтогоСтавка20 - РаботаСКурсамиВалют.ПересчитатьВВалюту(УслугаПредоставленияКТК[0].Итого20, УслугаПредоставленияКТК[0].Валюта, Объект.Валюта, Объект.ДатаКурса);
		
	ИначеЕсли Объект.ММ_ИтогоСтавка20 > 0 И УслугаПредоставленияКТК.Количество() = 0 Тогда
		
		НСтр = Объект.КП2_СоставУслуг.Добавить();
		НСтр.СтанцияОтправления = Объект.Суша_ПунктОтправления.Наименование;
		НСтр.СтанцияНазначения = Объект.Суша_ПунктНазначения.Наименование;
		НСтр.УсловияПеревозки = "" + ОчиститьФорматПеревозки(Объект.УсловияПеревозки_Отправление) + " - " + ОчиститьФорматПеревозки(Объект.УсловияПеревозки_Прибытие);
		НСтр.ВремяВПути = Объект.ММ_КалькуляцияЖДСоставляющей.Итог("ДлительностьДней");
		НСтр.КоличествоКТК = 0;
		НСтр.Типоразмер = "20 футов контейнер клиента";
		НСтр.СтавкаБезОхраны = Объект.ММ_ИтогоСтавка20;
		
	КонецЕсли;
	
	Если Объект.ММ_ИтогоСтавка > 0 И УслугаПредоставленияКТК.Количество() > 0 Тогда
		
		НСтр = Объект.КП2_СоставУслуг.Добавить();
		НСтр.СтанцияОтправления = Объект.Суша_ПунктОтправления.Наименование;
		НСтр.СтанцияНазначения = Объект.Суша_ПунктНазначения.Наименование;
		НСтр.УсловияПеревозки = "" + ОчиститьФорматПеревозки(Объект.УсловияПеревозки_Отправление) + " - " + ОчиститьФорматПеревозки(Объект.УсловияПеревозки_Прибытие);
		НСтр.ВремяВПути = Объект.ММ_КалькуляцияЖДСоставляющей.Итог("ДлительностьДней");
		НСтр.КоличествоКТК = 0;
		НСтр.Типоразмер = "40 футов с предоставлением контейнера";
		НСтр.СтавкаБезОхраны = Объект.ММ_ИтогоСтавка;
		
		НСтр = Объект.КП2_СоставУслуг.Добавить();
		НСтр.СтанцияОтправления = Объект.Суша_ПунктОтправления.Наименование;
		НСтр.СтанцияНазначения = Объект.Суша_ПунктНазначения.Наименование;
		НСтр.УсловияПеревозки = "" + ОчиститьФорматПеревозки(Объект.УсловияПеревозки_Отправление) + " - " + ОчиститьФорматПеревозки(Объект.УсловияПеревозки_Прибытие);
		НСтр.ВремяВПути = Объект.ММ_КалькуляцияЖДСоставляющей.Итог("ДлительностьДней");
		НСтр.КоличествоКТК = 0;
		НСтр.Типоразмер = "40 футов контейнер клиента";
		НСтр.СтавкаБезОхраны = Объект.ММ_ИтогоСтавка - РаботаСКурсамиВалют.ПересчитатьВВалюту(УслугаПредоставленияКТК[0].Итого40, УслугаПредоставленияКТК[0].Валюта, Объект.Валюта, Объект.ДатаКурса);
		
	ИначеЕсли Объект.ММ_ИтогоСтавка > 0 И УслугаПредоставленияКТК.Количество() = 0 Тогда
		
		НСтр = Объект.КП2_СоставУслуг.Добавить();
		НСтр.СтанцияОтправления = Объект.Суша_ПунктОтправления.Наименование;
		НСтр.СтанцияНазначения = Объект.Суша_ПунктНазначения.Наименование;
		НСтр.УсловияПеревозки = "" + ОчиститьФорматПеревозки(Объект.УсловияПеревозки_Отправление) + " - " + ОчиститьФорматПеревозки(Объект.УсловияПеревозки_Прибытие);
		НСтр.ВремяВПути = Объект.ММ_КалькуляцияЖДСоставляющей.Итог("ДлительностьДней");
		НСтр.КоличествоКТК = 0;
		НСтр.Типоразмер = "40 футов контейнер клиента";
		НСтр.СтавкаБезОхраны = Объект.ММ_ИтогоСтавка;
		
	КонецЕсли;
	
	Для каждого Стр из Объект.ММ_КалькуляцияМультимодальнойЦепочки Цикл
		Если Стр.ОсновнаяУслугаГруппы = Ложь И ЗначениеЗаполнено(Стр.ГруппаУслуг) Тогда Продолжить; КонецЕсли;
		Объект.КП2_ДоговорнаяЦенаВключает.Добавить().Составляющая = Стр.Услуга.НаименованиеПолное;
	КонецЦикла;
	
	Для каждого Стр из Объект.ЖД_УслугиВнеСтавки Цикл
		
		Если Не ЗначениеЗаполнено(Стр.Услуга.НаименованиеДляКП) Тогда Продолжить; КонецЕсли;
		
		НСтр = Объект.КП2_ДополнительныеУслуги.Добавить();
		НСтр.Составляющая = Стр.Услуга.НаименованиеДляКП;
		НСтр.ОтобразитьСТочкой = Истина;
		
		Если ЗначениеЗаполнено(Стр.Ставка20) Тогда
			НСтр = Объект.КП2_ДополнительныеУслуги.Добавить();
			НСтр.Составляющая = "20 футов - " + Стр.Ставка20 + " " + Стр.Валюта;
		КонецЕсли;
			
		Если ЗначениеЗаполнено(Стр.Ставка40) Тогда
			НСтр = Объект.КП2_ДополнительныеУслуги.Добавить();
			НСтр.Составляющая = "40 футов - " + Стр.Ставка40 + " " + Стр.Валюта;
		КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьМенеджеров(Команда)
	
	ОткрытьФорму("Справочник.Пользователи.ФормаСписка", Новый Структура("РежимВыбора, ЗакрыватьПриВыборе", Истина, Ложь), Элементы.КП2_ГруппаМенеджеров, ЭтаФорма.УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьОписаниеМенеджера(Менеджер)
	
	Результат = Новый Структура("ФИО, Должность, Телефон, Мобильный, ЭлПочта");
	
	Результат.ФИО = "" + Менеджер.ФизическоеЛицо.Имя + " " + Менеджер.ФизическоеЛицо.Фамилия;
	Результат.Должность = Менеджер.ФизическоеЛицо.Должность;
	
	Для каждого Стр из Менеджер.ФизическоеЛицо.КонтактнаяИнформация Цикл
		
		Если ЗначениеЗаполнено(Стр.АдресЭП) Тогда Результат.ЭлПочта = "e-mail: " + Стр.АдресЭП; КонецЕсли;
		Если ЗначениеЗаполнено(Стр.НомерТелефона) Тогда Результат.Телефон = "тел.: " + Стр.НомерТелефона; КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

