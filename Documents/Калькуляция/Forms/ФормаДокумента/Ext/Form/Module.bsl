	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтавкиНормативовКонтрибуции.Регистратор КАК Регистратор,
		|	СтавкиНормативовКонтрибуции.НормативнаяСтавка КАК НормативнаяСтавка,
		|	СтавкиНормативовКонтрибуции.Клиент КАК Клиент,
		|	СтавкиНормативовКонтрибуции.ОфисПродаж КАК ОфисПродаж,
		|	СтавкиНормативовКонтрибуции.ГУИД КАК ГУИД
		|ПОМЕСТИТЬ ВТ_Итог
		|ИЗ
		|	РегистрСведений.СтавкиНормативовКонтрибуции КАК СтавкиНормативовКонтрибуции
		|ГДЕ
		|	СтавкиНормативовКонтрибуции.Продукт = &Продукт
		|	И СтавкиНормативовКонтрибуции.УчетноеНаправление = &УчетноеНаправление
		|	И СтавкиНормативовКонтрибуции.ПунктОтправления В(&ПунктОтправления)
		|	И СтавкиНормативовКонтрибуции.ПунктНазначения В(&ПунктНазначения)
		|	И СтавкиНормативовКонтрибуции.ДатаНачалаПериодаДействия <= &Дата
		|	И СтавкиНормативовКонтрибуции.ДатаОкончанияПериодаДействия >= &Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|   Истина КАК Успех,
		|	ВТ_Итог.Регистратор КАК ДокументСсылка,
		|	ВТ_Итог.ГУИД КАК ГУИД,
		|	ВТ_Итог.НормативнаяСтавка КАК Ставка
		|ИЗ
		|	ВТ_Итог КАК ВТ_Итог
		|ГДЕ
		|	ВТ_Итог.Клиент = &Клиент
		|	И ВТ_Итог.ОфисПродаж = &ОфисПродаж
		|
		|УПОРЯДОЧИТЬ ПО
		|	Регистратор УБЫВ,
		|	НормативнаяСтавка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|   Истина КАК Успех,
		|	ВТ_Итог.Регистратор КАК ДокументСсылка,
		|	ВТ_Итог.ГУИД КАК ГУИД,
		|	ВТ_Итог.НормативнаяСтавка КАК Ставка
		|ИЗ
		|	ВТ_Итог КАК ВТ_Итог
		|ГДЕ
		|	ВТ_Итог.Клиент = &Клиент
		|	И ВТ_Итог.ОфисПродаж = """"
		|
		|УПОРЯДОЧИТЬ ПО
		|	Регистратор УБЫВ,
		|	НормативнаяСтавка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|   Истина КАК Успех,
		|	ВТ_Итог.Регистратор КАК ДокументСсылка,
		|	ВТ_Итог.ГУИД КАК ГУИД,
		|	ВТ_Итог.НормативнаяСтавка КАК Ставка
		|ИЗ
		|	ВТ_Итог КАК ВТ_Итог
		|ГДЕ
		|	ВТ_Итог.Клиент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|	И ВТ_Итог.ОфисПродаж = &ОфисПродаж
		|
		|УПОРЯДОЧИТЬ ПО
		|	Регистратор УБЫВ,
		|	НормативнаяСтавка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|   Истина КАК Успех,
		|	ВТ_Итог.Регистратор КАК ДокументСсылка,
		|	ВТ_Итог.ГУИД КАК ГУИД,
		|	ВТ_Итог.НормативнаяСтавка КАК Ставка
		|ИЗ
		|	ВТ_Итог КАК ВТ_Итог
		|ГДЕ
		|	ВТ_Итог.Клиент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|	И ВТ_Итог.ОфисПродаж = """"
		|
		|УПОРЯДОЧИТЬ ПО
		|	Регистратор УБЫВ,
		|	НормативнаяСтавка";
	
	ДатаПериод = Дата(1,1,1);
	
	пЗапрос = Новый Запрос;
	пЗапрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
	|	ПСЦКалькуляции.Ссылка КАК Ссылка,
	|	ПСЦКалькуляции.Ссылка.ДатаПСЦ КАК ДатаПСЦ
	|ИЗ
	|	Документ.ПСЦ.Калькуляции КАК ПСЦКалькуляции
	|ГДЕ
	|	ПСЦКалькуляции.Калькуляция = &Калькуляция
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПСЦ УБЫВ";
	
	пЗапрос.УстановитьПараметр("Калькуляция", Объект.Ссылка);
	
	пРезультатЗапроса = пЗапрос.Выполнить();
	
	пВыборкаДетальныеЗаписи = пРезультатЗапроса.Выбрать();
	
	Пока пВыборкаДетальныеЗаписи.Следующий() Цикл
		ДатаПериод = пВыборкаДетальныеЗаписи.ДатаПСЦ
	КонецЦикла;	
	
	Запрос.УстановитьПараметр("Дата", ДатаПериод);
	Запрос.УстановитьПараметр("Клиент", Объект.Контрагент);
	Запрос.УстановитьПараметр("ОфисПродаж", "");
	Запрос.УстановитьПараметр("Продукт", Объект.ПродуктДКП);
	Запрос.УстановитьПараметр("ПунктНазначения", мПунктыНазначения);
	Запрос.УстановитьПараметр("ПунктОтправления", мПунктыОтправления);
	Запрос.УстановитьПараметр("УчетноеНаправление", Объект.УчетноеНаправление);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаКлиентОфис 				= РезультатЗапроса[1].Выбрать();
	ВыборкаКлиент 					= РезультатЗапроса[2].Выбрать();
	Выборкаофис 					= РезультатЗапроса[3].Выбрать();
	ВыборкаБезофисаБезКлиента 		= РезультатЗапроса[4].Выбрать();
	
	Пока ВыборкаКлиентОфис.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(сОтвет,ВыборкаКлиентОфис);
		Возврат сОтвет;
	КонецЦикла;
	Пока ВыборкаКлиент.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(сОтвет,ВыборкаКлиент);
		Возврат сОтвет;
	КонецЦикла;
	Пока Выборкаофис.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(сОтвет,Выборкаофис);
		Возврат сОтвет;
	КонецЦикла;
	Пока ВыборкаБезофисаБезКлиента.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(сОтвет,Выборкаофис);
		Возврат сОтвет;
	КонецЦикла;
	
	Возврат сОтвет;
	
КонецФункции	

