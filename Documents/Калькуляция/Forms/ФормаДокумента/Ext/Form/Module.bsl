Процедура ММ_КалькуляцияКТКСоставляющейУслугаПриИзменении(Элемент)
	
	ВычислитьДлительностьТекущейСтроки(Элементы.ММ_КалькуляцияКТКСоставляющей.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ММ_КалькуляцияКТКСоставляющейПриИзменении(Элемент)
	
	Если Объект.ММ_СтавкаПредоставленияКТК20 = 0 ИЛИ Объект.ММ_СтавкаПредоставленияКТК40 = 0 Тогда Возврат; КонецЕсли;
	
	ДлитДней = ОкрВверх(Объект.ММ_КалькуляцияКТКСоставляющей.Итог("ДлительностьДней"));
	
	СтрокаНайдена = неопределено;
	Для каждого Стр из Объект.ММ_КалькуляцияМультимодальнойЦепочки Цикл
		Если Стр.Услуга = ПредопределенноеЗначение("Справочник.Номенклатура.ПредоставлениеКТК") Тогда
			СтрокаНайдена = Стр;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если СтрокаНайдена = неопределено Тогда СтрокаНайдена = Объект.ММ_КалькуляцияМультимодальнойЦепочки.Добавить(); КонецЕсли;
	СтрокаНайдена.Услуга = ПредопределенноеЗначение("Справочник.Номенклатура.ПредоставлениеКТК");
	
	
	СтрокаНайдена.Цена20 = ДлитДней * Объект.ММ_СтавкаПредоставленияКТК20;
	СтрокаНайдена.Цена40 = ДлитДней * Объект.ММ_СтавкаПредоставленияКТК40;
	
	СтрокаНайдена.НДСВключенВСтоимость = Истина;
	СтрокаНайдена.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС0");
	
	СтрокаНайдена.НормативныйПроцентВознаграждения20 = ПроцентВознагражденияУслуги(СтрокаНайдена.Услуга, Объект.Дата);
	СтрокаНайдена.НормативныйПроцентВознаграждения40 = СтрокаНайдена.НормативныйПроцентВознаграждения20;
	
	СтрокаНайдена.ПунктОтправления = Объект.Суша_ПунктОтправления;
	СтрокаНайдена.ПунктНазначения = Объект.Суша_ПунктНазначения;
	
	СтрокаНайдена.Вознаграждение20 = СтрокаНайдена.НормативныйПроцентВознаграждения20;
	СтрокаНайдена.Вознаграждение40 = СтрокаНайдена.НормативныйПроцентВознаграждения40;
	
	ПосчитатьСтрокуКалькуляцииЖД(СтрокаНайдена);
	
	ОбновитьИтоговыеПараметрыТаблиц(ВалютаИтогов);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтандартнымСпискомУслуг(Команда)
	
	СписокУслугВагона = ПолучитьСтандартныйСписокУслугВагона();
	Для каждого Стр из СписокУслугВагона Цикл
		СтрНайдена = Ложь;
		Для каждого Под из Объект.ММ_КалькуляцияЖДСоставляющей Цикл
			Если Под.Операция = Стр Тогда СтрНайдена = Истина; КонецЕсли;
		КонецЦикла;
		Если НЕ СтрНайдена Тогда
			НСтр = Объект.ММ_КалькуляцияЖДСоставляющей.Добавить();
			НСтр.Операция = Стр;
			НормыРасчетаДлительности = Услуги_сервер.ПолучитьПараметрыРасчетаДлительностиУслуги(НСтр.Операция);
			НСтр.СчПробег = НормыРасчетаДлительности.Пробег;
		КонецЕсли;
	КонецЦикла;
	
	СписокУслугКТК = ПолучитьСтандартныйСписокУслугКТК();
	Для каждого Стр из СписокУслугКТК Цикл
		СтрНайдена = Ложь;
		Для каждого Под из Объект.ММ_КалькуляцияКТКСоставляющей Цикл
			Если Под.Операция = Стр Тогда СтрНайдена = Истина; КонецЕсли;
		КонецЦикла;
		Если НЕ СтрНайдена Тогда
			НСтр = Объект.ММ_КалькуляцияКТКСоставляющей.Добавить();
			НСтр.Операция = Стр;
			НормыРасчетаДлительности = Услуги_сервер.ПолучитьПараметрыРасчетаДлительностиУслуги(НСтр.Операция);
			НСтр.СчПробег = НормыРасчетаДлительности.Пробег;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСтандартныйСписокУслугВагона()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВидыОпераций.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ВидыОпераций КАК ВидыОпераций
	               |ГДЕ
	               |	НЕ ВидыОпераций.ПометкаУдаления
	               |	И НЕ ВидыОпераций.ЭтоГруппа
	               |	И ВидыОпераций.ЗаполнятьВагоннуюСоставляющуюКалькуляции <> 0
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВидыОпераций.ЗаполнятьВагоннуюСоставляющуюКалькуляции";
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
