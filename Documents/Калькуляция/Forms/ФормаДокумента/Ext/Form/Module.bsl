	//Евросиб Коханенко Н.А. 08.04.2024 )) #83546 
	
	МассивРазрешенныхКПересчетуКолонок = Новый Массив;
	МассивРазрешенныхКПересчетуКолонок.Добавить("ММ_КалькуляцияМультимодальнойЦепочкиТариф20");
	МассивРазрешенныхКПересчетуКолонок.Добавить("ММ_КалькуляцияМультимодальнойЦепочкиТариф40");
	МассивРазрешенныхКПересчетуКолонок.Добавить("ММ_КалькуляцияМультимодальнойЦепочкиЦена20");
	МассивРазрешенныхКПересчетуКолонок.Добавить("ММ_КалькуляцияМультимодальнойЦепочкиЦена40");
	МассивРазрешенныхКПересчетуКолонок.Добавить("ММ_КалькуляцияМультимодальнойЦепочкиВалюта");
	МассивРазрешенныхКПересчетуКолонок.Добавить("ММ_КалькуляцияМультимодальнойЦепочкиСтавкаНДС");
	МассивРазрешенныхКПересчетуКолонок.Добавить("ММ_КалькуляцияМультимодальнойЦепочкиНДСВключенВСтоимость");
	МассивРазрешенныхКПересчетуКолонок.Добавить("ММ_КалькуляцияМультимодальнойЦепочкиСуммаНДС20");
	МассивРазрешенныхКПересчетуКолонок.Добавить("ММ_КалькуляцияМультимодальнойЦепочкиСуммаНДС40");
	МассивРазрешенныхКПересчетуКолонок.Добавить("ММ_КалькуляцияМультимодальнойЦепочкиВознаграждение20");
	МассивРазрешенныхКПересчетуКолонок.Добавить("ММ_КалькуляцияМультимодальнойЦепочкиВознаграждение40");
	МассивРазрешенныхКПересчетуКолонок.Добавить("ММ_КалькуляцияМультимодальнойЦепочкиСуммаВознаграждения20");
	МассивРазрешенныхКПересчетуКолонок.Добавить("ММ_КалькуляцияМультимодальнойЦепочкиСуммаВознаграждения40");
	МассивРазрешенныхКПересчетуКолонок.Добавить("ММ_КалькуляцияМультимодальнойЦепочкиИтого20");
	МассивРазрешенныхКПересчетуКолонок.Добавить("ММ_КалькуляцияМультимодальнойЦепочкиИтого40");
	МассивРазрешенныхКПересчетуКолонок.Добавить("ММ_КалькуляцияМультимодальнойЦепочкиГруппаУслуг");
