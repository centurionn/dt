&НаКлиенте
Процедура ОбработкаВыбораНаправлений(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	МассивВыбора = Новый Массив;
	Если ТипЗнч(Параметр1) = Тип("Массив") Тогда
		МассивВыбора = Параметр1;
	Иначе
		МассивВыбора.Добавить(Параметр1);
	КонецЕсли;
	Для каждого Стр из МассивВыбора Цикл
		Объект.ММ_ПодборНаправлений.Добавить().Направление = Стр;
	КонецЦикла;
	ММ_ПодборНаправленийПриИзменении(неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерестроитьТаблицуСтавокФрахта(Команда)
	
	ММ_ТаблицаСтавокФрахт.Очистить();
	ПерестроитьТаблицуСтавокФрахтаНаСервере();
	ММ_ТаблицаСтавокФрахтПриИзменении(неопределено);	
	
КонецПроцедуры

&НаСервере
Процедура bugfix_ДополнитьТЧ_ПросчитанныеСтавкиИНаправления()
	
	Для каждого Стр из Объект.ММ_ПодборНаправлений Цикл
		//-1
		Найдено = Ложь;
		Для каждого Стр2 из Объект.ММ_ПросчитанныеСтавкиФрахта Цикл
			Найдено = Найдено ИЛИ (Стр.Направление = Стр2.Направление);
		КонецЦикла;
		Если НЕ Найдено Тогда
			Объект.ММ_ПросчитанныеСтавкиФрахта.Добавить().Направление = Стр.Направление;
		КонецЕсли;
		//-2
		Найдено = Ложь;
		Для каждого Стр2 из Объект.ММ_ПросчитанныеУслугиФрахта Цикл
			Найдено = Найдено ИЛИ (Стр.Направление = Стр2.Направление);
		КонецЦикла;
		Если НЕ Найдено Тогда
			Для каждого Стр3 из Стр.Направление.СтруктураЗатрат Цикл
				НСтр = Объект.ММ_ПросчитанныеУслугиФрахта.Добавить();
				НСтр.Направление = Стр.Направление;
				НСтр.Услуга = Стр3.Услуга;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПерестроитьТаблицуСтавокФрахтаНаСервере()
	
	ММ_ТаблицаСтавокФрахт.Очистить();
	
	// сначала сформируем состав колонок
	
	МассивДобавляемыхРеквизитовФормы = Новый массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	НаправленияФрахтСтруктураЗатрат.Услуга КАК Услуга,
	               |	НаправленияФрахтСтруктураЗатрат.Ссылка.Линия КАК Линия
	               |ИЗ
	               |	Справочник.НаправленияФрахт.СтруктураЗатрат КАК НаправленияФрахтСтруктураЗатрат
	               |ГДЕ
	               |	НаправленияФрахтСтруктураЗатрат.Ссылка В(&СписокНаправлений)
	               |	И НЕ НаправленияФрахтСтруктураЗатрат.Ссылка.ПометкаУдаления
	               |ИТОГИ ПО
	               |	Линия";
	
	Запрос.УстановитьПараметр("СписокНаправлений", Объект.ММ_ПодборНаправлений.Выгрузить().ВыгрузитьКолонку("Направление"));
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаЛиния = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаЛиния.Следующий() Цикл
		
		// услуги по линии
		
		НЭлемент = Элементы.Найти("ГруппаММФрахт"+ВыборкаЛиния.Линия.Код);
		Если НЭлемент = неопределено Тогда
			ГруппаТаблицыЛиния = Элементы.Добавить("ГруппаММФрахт"+ВыборкаЛиния.Линия.Код, Тип("ГруппаФормы"), Элементы.ММ_ТаблицаСтавокФрахт);
			ГруппаТаблицыЛиния.Группировка = ГруппировкаКолонок.Горизонтальная;
			ГруппаТаблицыЛиния.ОтображатьВШапке = Истина;
			ГруппаТаблицыЛиния.Заголовок = ВыборкаЛиния.Линия;
		Иначе
			ГруппаТаблицыЛиния = НЭлемент;
		КонецЕсли;
		
		ВыборкаДетальныеЗаписи = ВыборкаЛиния.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			ИмяНовогоРеквизита = "ЛинияУслуга_" + ВыборкаДетальныеЗаписи.Линия.Код + "_" + ВыборкаДетальныеЗаписи.Услуга.Код;
			
			МассивДобавляемыхРеквизитовФормы.Добавить(Новый РеквизитФормы(ИмяНовогоРеквизита, Новый ОписаниеТипов("Число", ,,Новый КвалификаторыЧисла(10,2,ДопустимыйЗнак.Любой)), "ММ_ТаблицаСтавокФрахт", "", Истина));
			
			НайдЭлемент = Элементы.Найти(ИмяНовогоРеквизита);
			Если НайдЭлемент = неопределено Тогда
				НКолонка = Элементы.Добавить(ИмяНовогоРеквизита, Тип("ПолеФормы"), ГруппаТаблицыЛиния);
				НКолонка.Вид = ВидПоляФормы.ПолеВвода;
				НКолонка.Заголовок = ВыборкаДетальныеЗаписи.Услуга;
				НКолонка.ТолькоПросмотр = Истина;
				
				//
				//НКолонка.Ширина = 1;
				//НКолонка.РастягиватьПоГоризонтали = Ложь;
				//НКолонка.АвтоМаксимальнаяШирина = Ложь;
			КонецЕсли;
			
		КонецЦикла;
		
		// вознаграждение и ставка по линии, условия выгрузки
		
		ИмяНовогоРеквизита = "ЛинияУсловия_" + ВыборкаЛиния.Линия.Код;
		МассивДобавляемыхРеквизитовФормы.Добавить(Новый РеквизитФормы(ИмяНовогоРеквизита, Новый ОписаниеТипов("Строка"), "ММ_ТаблицаСтавокФрахт", "", Истина));
		Если НайдЭлемент = неопределено Тогда
			НКолонка = Элементы.Добавить(ИмяНовогоРеквизита, Тип("ПолеФормы"), ГруппаТаблицыЛиния);
			НКолонка.Вид = ВидПоляФормы.ПолеВвода;
			НКолонка.Заголовок = "Выгрузка";
			НКолонка.ТолькоПросмотр = Истина;
			
			//
			//НКолонка.АвтоМаксимальнаяШирина = Ложь;
			//НКолонка.Ширина = 1;
			//НКолонка.РастягиватьПоГоризонтали = Ложь;
		КонецЕсли;
		
		ИмяНовогоРеквизита = "ЛинияВознаграждение_" + ВыборкаЛиния.Линия.Код;
		МассивДобавляемыхРеквизитовФормы.Добавить(Новый РеквизитФормы(ИмяНовогоРеквизита, Новый ОписаниеТипов("Число", ,,Новый КвалификаторыЧисла(10,2,ДопустимыйЗнак.Любой)), "ММ_ТаблицаСтавокФрахт", "", Истина));
		НайдЭлемент = Элементы.Найти(ИмяНовогоРеквизита);
		Если НайдЭлемент = неопределено Тогда
			НКолонка = Элементы.Добавить(ИмяНовогоРеквизита, Тип("ПолеФормы"), ГруппаТаблицыЛиния);
			НКолонка.Вид = ВидПоляФормы.ПолеВвода;
			НКолонка.Заголовок = "Вознаграждение";
			НКолонка.УстановитьДействие("ПриИзменении", "ВознаграждениеПриИзменении");
			
			//
			//НКолонка.Ширина = 1;
			//НКолонка.РастягиватьПоГоризонтали = Ложь;
			//НКолонка.АвтоМаксимальнаяШирина = Ложь;
		КонецЕсли;
		
		ИмяНовогоРеквизита = "ЛинияСтавка_" + ВыборкаЛиния.Линия.Код;
		МассивДобавляемыхРеквизитовФормы.Добавить(Новый РеквизитФормы(ИмяНовогоРеквизита, Новый ОписаниеТипов("Число", ,,Новый КвалификаторыЧисла(10,2,ДопустимыйЗнак.Любой)), "ММ_ТаблицаСтавокФрахт", "", Истина));
		Если НайдЭлемент = неопределено Тогда
			НКолонка = Элементы.Добавить(ИмяНовогоРеквизита, Тип("ПолеФормы"), ГруппаТаблицыЛиния);
			НКолонка.Вид = ВидПоляФормы.ПолеВвода;
			НКолонка.Заголовок = "Ставка";
			НКолонка.УстановитьДействие("ПриИзменении", "СтавкаПриИзменении");
			
			//
			//НКолонка.Ширина = 1;
			//НКолонка.РастягиватьПоГоризонтали = Ложь;
			//НКолонка.АвтоМаксимальнаяШирина = Ложь;
		КонецЕсли;
				
	КонецЦикла;

	МассивУдаляемыхРеквизитовФормы = новый Массив;
	Для каждого Стр из ЭтаФорма.ПолучитьРеквизиты("ММ_ТаблицаСтавокФрахт") Цикл
		Если Стр.Имя <> "Порт" тогда МассивУдаляемыхРеквизитовФормы.Добавить(Стр.Путь+"."+Стр.Имя); КонецЕсли;
	КонецЦикла;
	
	ИзменитьРеквизиты(МассивДобавляемыхРеквизитовФормы, МассивУдаляемыхРеквизитовФормы);
	
	Для каждого Стр из ЭтаФорма.ПолучитьРеквизиты("ММ_ТаблицаСтавокФрахт") Цикл
		Если Стр.Имя <> "Порт" И Элементы[Стр.Имя].ПутьКДанным <> Стр.Путь+"."+Стр.Имя тогда 
			Элементы[Стр.Имя].ПутьКДанным = Стр.Путь+"."+Стр.Имя; 
		КонецЕсли;
	КонецЦикла;
	
	// затем заполним строки таблицы пунктами назначения и ранее введенными ставками / посчитанными услугами
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	НаправленияФрахт.ПунктНазначения КАК ПунктНазначения
	               |ИЗ
	               |	Справочник.НаправленияФрахт КАК НаправленияФрахт
	               |ГДЕ
	               |	НаправленияФрахт.Ссылка В(&СписокНаправлений)
	               |	И НЕ НаправленияФрахт.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("СписокНаправлений", Объект.ММ_ПодборНаправлений.Выгрузить().ВыгрузитьКолонку("Направление"));
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		НСтр = ММ_ТаблицаСтавокФрахт.Добавить();
		НСтр.Порт = Ответ.ПунктНазначения;
		
		// вознаграждение и ставка
		Для каждого Стр из Объект.ММ_ПросчитанныеСтавкиФрахта Цикл
			Если Стр.Направление.ПунктНазначения = Ответ.ПунктНазначения Тогда
				ИмяИскомойКолонкиВознаграждение = "ЛинияВознаграждение_"+Стр.Направление.Линия.Код;
				Если Элементы.Найти(ИмяИскомойКолонкиВознаграждение) <> неопределено И Элементы.Найти(ИмяИскомойКолонкиВознаграждение).ПутьКДанным <> "" Тогда
					НСтр[ИмяИскомойКолонкиВознаграждение] = Стр.Вознаграждение;
				КонецЕсли;
				ИмяИскомойКолонкиСтавка = "ЛинияСтавка_"+Стр.Направление.Линия.Код;
				Если Элементы.Найти(ИмяИскомойКолонкиСтавка) <> неопределено И Элементы.Найти(ИмяИскомойКолонкиСтавка).ПутьКДанным <> "" Тогда
					НСтр[ИмяИскомойКолонкиСтавка] = Стр.Ставка;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		// себестоимость по услугам
		Для каждого Стр из Объект.ММ_ПросчитанныеУслугиФрахта Цикл
			Если Стр.Направление.ПунктНазначения = Ответ.ПунктНазначения Тогда
				ИмяИскомойКолонкиУслуга = "ЛинияУслуга_"+Стр.Направление.Линия.Код+"_"+Стр.Услуга.Код;
				Если Элементы.Найти(ИмяИскомойКолонкиУслуга) <> неопределено И Элементы.Найти(ИмяИскомойКолонкиУслуга).ПутьКДанным <> "" Тогда
					НСтр[ИмяИскомойКолонкиУслуга] = Стр.Себестоимость;
				КонецЕсли;
				Если ЗначениеЗаполнено(Стр.Тариф) Тогда 
					ИмяИскомойКолонкиУслуга = "ЛинияУсловия_"+Стр.Направление.Линия.Код;
					Если Элементы.Найти(ИмяИскомойКолонкиУслуга) <> неопределено И Элементы.Найти(ИмяИскомойКолонкиУслуга).ПутьКДанным <> "" Тогда
						НСтр[ИмяИскомойКолонкиУслуга] = Лев(Стр.Тариф.ПунктНазначенияУсловия, 2);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ММ_ТаблицаСтавокФрахтПриИзменении(Элемент)
	
	ТекД = Элементы.ММ_ТаблицаСтавокФрахт.ТекущиеДанные;
	Если ТекД <> неопределено Тогда
		ПунктНазначения = ТекД.Порт;
		Для каждого ПодчЭ1 из Элементы.ММ_ТаблицаСтавокФрахт.ПодчиненныеЭлементы Цикл
			Если Лев(ПодчЭ1.Имя, 8) <> "ГруппаММ" Тогда Продолжить; КонецЕсли;
			Для каждого ПодчЭ2 из ПодчЭ1.ПодчиненныеЭлементы Цикл
				
				СтрСтроки = СтрРазделить(ПодчЭ2.Имя, "_", Ложь);
				КодЛинии = СтрСтроки[1];
				//ЛинияСсылка = 
				Направление = ПолучитьНаправление_Кэш(Объект.ММ_ПортОтправления, ПунктНазначения, КодЛинии);
				Если Направление = неопределено Тогда 
					
					Продолжить;
					//ОпОп = Новый ОписаниеОповещения("ВопросСозданияНаправления", ЭтаФорма, Новый Структура("ПортОтправления, ПортНазначения, КодЛинии", Объект.ММ_ПортОтправления, ПунктНазначения, КодЛинии));
					//ПоказатьВопрос(ОпОп, "В системе нет направления " + Объект.ММ_ПортОтправления + " - " + ПунктНазначения + " для линии " + ПодчЭ1.Имя, РежимДиалогаВопрос.ДаНет);
					
				КонецЕсли;
				
				Если СтрНайти(ПодчЭ2.Имя, "ЛинияУслуга") <> 0 Тогда
					// это строка с услугой
					КодУслуги = СтрСтроки[2];
					ЗначениеКода = ТекД[ПодчЭ2.Имя];
					Услуга = ПолучитьУслугу_Кэш(КодУслуги);
					
					СтрНайдена = Ложь;
					Для каждого Стр из Объект.ММ_ПросчитанныеУслугиФрахта Цикл
						Если Стр.Направление = Направление И Стр.Услуга = Услуга Тогда
							СтрНайдена = Истина;
							Стр.Себестоимость = ЗначениеКода;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Если НЕ СтрНайдена Тогда
						НСтр = Объект.ММ_ПросчитанныеУслугиФрахта.Добавить();
						НСтр.Направление = Направление;
						НСтр.Услуга = Услуга;
						НСтр.Себестоимость = ЗначениеКода;
					КонецЕсли;
					
				ИначеЕсли СтрНайти(ПодчЭ2.Имя, "ЛинияВознаграждение_") <> 0 Тогда
					// это строка с вознаграждением
					ЗначениеКода = ТекД[ПодчЭ2.Имя];
									
					СтрНайдена = Ложь;
					Для каждого Стр из Объект.ММ_ПросчитанныеСтавкиФрахта Цикл
						Если Стр.Направление = Направление Тогда
							СтрНайдена = Истина;
							Стр.Вознаграждение = ЗначениеКода;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Если НЕ СтрНайдена Тогда
						НСтр = Объект.ММ_ПросчитанныеСтавкиФрахта.Добавить();
						НСтр.Направление = Направление;
						НСтр.Вознаграждение = ЗначениеКода;
					КонецЕсли;
					
				ИначеЕсли СтрНайти(ПодчЭ2.Имя, "ЛинияСтавка_") <> 0 Тогда
					// это строка со ставкой
					ЗначениеКода = ТекД[ПодчЭ2.Имя];
										
					СтрНайдена = Ложь;
					Для каждого Стр из Объект.ММ_ПросчитанныеСтавкиФрахта Цикл
						Если Стр.Направление = Направление Тогда
							СтрНайдена = Истина;
							Стр.Ставка = ЗначениеКода;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Если НЕ СтрНайдена Тогда
						НСтр = Объект.ММ_ПросчитанныеСтавкиФрахта.Добавить();
						НСтр.Направление = Направление;
						НСтр.Ставка = ЗначениеКода;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
		//// МОРЕ таблицы
	ММ_МореСтавка = 0;
	ТопНаправление = неопределено;
	ММ_МореВознаграждение = 0;
	ММ_МореСебестоимость = 0;
	Для каждого Стр из Объект.ММ_ПросчитанныеСтавкиФрахта Цикл
		Если Стр.Ставка > ММ_МореСтавка Тогда
			ММ_МореСтавка = Стр.Ставка;
			ТопНаправление = Стр.Направление;
			ММ_МореВознаграждение = Стр.Вознаграждение;
		КонецЕсли;
	КонецЦикла;
	Для каждого Стр из Объект.ММ_ПросчитанныеУслугиФрахта Цикл
		Если Стр.Направление = ТопНаправление Тогда
			ММ_МореСебестоимость = ММ_МореСебестоимость + Стр.Себестоимость;
			Объект.ПротоколСчитаетсяПоСтавкамКонтрагента = КонтрагентТарифа(Стр.Тариф);
		КонецЕсли;
	КонецЦикла;

	
	ОбновитьИтоговыеПараметрыТаблиц(Объект.Валюта,Истина,,Истина);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция КонтрагентТарифа(Тариф)
	
	Если ЗначениеЗаполнено(Тариф) Тогда
		Возврат Тариф.Поставщик;
	КонецЕсли;
	
	Возврат неопределено;
	
КонецФункции

//Евросиб Каблов 28.05.2025 ( #109346
//&НаКлиенте
&НаСервере
//Евросиб Каблов 28.05.2025 )
Процедура ОбновитьИтоговыеПараметрыТаблиц(Валюта,СохранитьВознаграждение = Ложь, КурсВручную = Ложь, СохранитьСтавку = Ложь)
	
	//+++ MM SECTION +++//
	
	// ЖД Таблицы
	ДлитДней = ОкрВверх(Объект.ММ_КалькуляцияЖДСоставляющей.Итог("ДлительностьДней"));
	Элементы.ММ_КалькуляцияЖДСоставляющейДлительностьДней.ТекстПодвала = Формат(ДлитДней, "ЧДЦ=2; ЧН=");
	Элементы.ММ_КалькуляцияЖДСоставляющейПробег.ТекстПодвала = Формат(Объект.ММ_КалькуляцияЖДСоставляющей.Итог("Пробег"), "ЧДЦ=2; ЧН=");
	Элементы.ММ_КалькуляцияЖДСоставляющейСтоимость.ТекстПодвала = Формат(Объект.ММ_КалькуляцияЖДСоставляющей.Итог("Стоимость"), "ЧДЦ=2; ЧН=");
	Элементы.ММ_КалькуляцияЖДСоставляющейНДС.ТекстПодвала = Формат(Объект.ММ_КалькуляцияЖДСоставляющей.Итог("НДС"), "ЧДЦ=2; ЧН=");
	Элементы.ММ_КалькуляцияЖДСоставляющейСтоимостьИтого.ТекстПодвала = Формат(Объект.ММ_КалькуляцияЖДСоставляющей.Итог("СтоимостьИтого"), "ЧДЦ=2; ЧН=");
	
	ДлитДней = ОкрВверх(Объект.ММ_КалькуляцияКТКСоставляющей.Итог("ДлительностьДней"));
	Элементы.ММ_КалькуляцияКТКСоставляющейДлительностьДней.ТекстПодвала = Формат(ДлитДней, "ЧДЦ=2; ЧН=");
	Элементы.ММ_КалькуляцияКТКСоставляющейПробег.ТекстПодвала = Формат(Объект.ММ_КалькуляцияКТКСоставляющей.Итог("Пробег"), "ЧДЦ=2; ЧН=");
	
	ПараметрыКурса = Новый Соответствие;
	
	НДСНеВкл20 = 0;
	НДСНеВкл40 = 0;
	
	Для каждого Стр из Объект.ММ_КалькуляцияМультимодальнойЦепочки Цикл
		
		Если Стр.ОсновнаяУслугаГруппы = Ложь И ЗначениеЗаполнено(Стр.ГруппаУслуг) Тогда Продолжить; КонецЕсли;
		
		Если НЕ Стр.НДСВключенВСтоимость Тогда
			
			ПараметрыКурсаДокумента = ПараметрыКурса.Получить(Валюта);
			Если ПараметрыКурсаДокумента = неопределено Тогда
				Если Объект.ЗафиксироватьКурс ИЛИ КурсВручную Тогда
					// если курс зафиксирован, то взять данные из реквизитов объекта
					ПараметрыКурсаДокумента = Новый Структура;
					ПараметрыКурсаДокумента.Вставить("Валюта",Валюта);
					ПараметрыКурсаДокумента.Вставить("ДатаКурса",Объект.ДатаКурса);
					ПараметрыКурсаДокумента.Вставить("Кратность",1);
