Функция ПолучитьИмяСвойстваБлокировкиЭлементаФормы(Знач вхЭлементФормы)
	Результат = "";
	Если ТипЗнч(вхЭлементФормы) = Тип("ПолеФормы") 
			ИЛИ ТипЗнч(вхЭлементФормы) = Тип("ТаблицаФормы") Тогда
		Результат = "ТолькоПросмотр";
	КонецЕсли;
	Если ТипЗнч(вхЭлементФормы) = Тип("КнопкаФормы") Тогда
	   	Результат = "Доступность";	
	КонецЕсли;
	Возврат Результат;
