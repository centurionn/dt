&НаСервере
Функция НаличиеИзмененийВМеньшуюСторону(СравниваемаяСсылка, Подробности = "")
	
	РезультатПоиска = НайтиИзмененияВТЧ(СравниваемаяСсылка, Истина, Ложь, Истина);
	
	Если РезультатПоиска.ЕстьСнижение Тогда
		Подробности = РезультатПоиска.ДеталиСнижения;
		Возврат Истина;
	КонецЕсли;
	
	Если РезультатПоиска.ИзмененоСодержание Тогда
		Подробности = РезультатПоиска.ДеталиИзменения;
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция НайтиИзмененияВТЧ(СравниваемаяСсылка, ИскатьСнижение = Истина, ИскатьУвеличение = Истина, ИскатьИзменениеСодержания = Истина)
	
	ТабЧасти = Новый Массив;
	ТабЧасти.Добавить(ОписательТЧ("ММ_КалькуляцияЖДСоставляющей", "Калькуляция ЖД составляющей", "Операция,Груз", "Пробег,Стоимость,СтоимостьИтого"));
	ТабЧасти.Добавить(ОписательТЧ("ММ_КалькуляцияМультимодальнойЦепочки", "Калькуляция мультимодальной цепочки", "Услуга,ВыставляемаяУслуга,Поставщик", "Итого20,Итого40,ВнутренняяСебестоимость"));
	ТабЧасти.Добавить(ОписательТЧ("ММ_ПросчитанныеСтавкиФрахта", "Просчитанные ставки фрахта", "Направление", "Вознаграждение,Ставка"));
	ТабЧасти.Добавить(ОписательТЧ("ММ_ПросчитанныеУслугиФрахта", "Просчитанные услуги фрахта", "Направление,Услуга,Тариф", "Себестоимость"));
	ТабЧасти.Добавить(ОписательТЧ("ЖД_КалькуляцияСебестоимости", "Калькуляция себестоимости", "Услуга,ВидРасходов,СуммаВключаетНДС", "Сумма20,Сумма40,НормВознаграждение20,НормВознаграждение40"));
	ТабЧасти.Добавить(ОписательТЧ("ЖД_УслугиВнеСтавки", "Услуги вне ставки", "Услуга,Поставщик,СуммаВключаетНДС", "Себестоимость20,Себестоимость40,Вознаграждение20,Вознаграждение40"));
	ТабЧасти.Добавить(ОписательТЧ("ЖД_УслугиПоСверхнормативам", "Услуги по сверхнормативам", "Услуга,Поставщик,СуммаВключаетНДС", "Себестоимость20,Себестоимость40,Вознаграждение20,Вознаграждение40"));
	ТабЧасти.Добавить(ОписательТЧ("ПС_ДопРасходыВклВСтавку",, "Услуга,Поставщик,СуммаВключаетНДС", "СуммаБезНДС,СуммаБезНДСРуб"));
	ТабЧасти.Добавить(ОписательТЧ("ПланПродаж_Расходы",, "Номенклатура,Поставщик", "СуммаАванса20,СуммаОплаты20,СуммаАванса40,СуммаОплаты40", Ложь));
	ТабЧасти.Добавить(ОписательТЧ("ПланПродаж_Доходы",, "Номенклатура,ТипСтавки", "СуммаАванса20,СуммаОплаты20,СуммаАванса40,СуммаОплаты40,СуммаНДС20,СуммаНДС40"));
	
	ДанныеИсточника = Новый Структура;
	Для каждого ОписаниеТЧ Из ТабЧасти Цикл
		ИмяТЧ = ОписаниеТЧ.ИмяТЧ;
		ТЗ = СравниваемаяСсылка[ИмяТЧ].Выгрузить(, ОписаниеТЧ.КолонкиСодержания + "," + ОписаниеТЧ.КолонкиВеличины);
		ДанныеИсточника.Вставить(ИмяТЧ, ТЗ);
	КонецЦикла;
	
	
	РезультатПоиска = Новый Структура;
	РезультатПоиска.Вставить("ЕстьОтличия"       , Ложь);
	РезультатПоиска.Вставить("ЕстьСнижение"      , Ложь);
	РезультатПоиска.Вставить("ДеталиСнижения"    , ""  );
	РезультатПоиска.Вставить("ЕстьУвеличение"    , Ложь);
	РезультатПоиска.Вставить("ДеталиУвеличения"  , ""  );
	РезультатПоиска.Вставить("ИзмененоСодержание", Ложь);
	РезультатПоиска.Вставить("ДеталиИзменения"   , ""  );
	
	РезультатПоиска.Вставить("ИскатьСнижение"           , ИскатьСнижение);
	РезультатПоиска.Вставить("ИскатьУвеличение"         , ИскатьУвеличение);
	РезультатПоиска.Вставить("ИскатьИзменениеСодержания", ИскатьИзменениеСодержания);
	
	Для каждого ОписаниеТЧ Из ТабЧасти Цикл
		ЗаполнитьХарактерИзмененийТЧ(ОписаниеТЧ, ДанныеИсточника, РезультатПоиска);
		Если ДостигнутыВсеЦелиПоиска(РезультатПоиска) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат РезультатПоиска;
	
КонецФункции

&НаСервере
Функция ОписательТЧ(ИмяТЧ, СинонимТЧ = "", КолонкиСодержания, КолонкиВеличины, ЗнакПлюс = Истина)
	
	Если ЗначениеЗаполнено(СинонимТЧ) Тогда
		Синоним = СинонимТЧ;
	Иначе
		Синоним = Метаданные.Документы.Калькуляция.ТабличныеЧасти[ИмяТЧ].Синоним;
	КонецЕсли;
	
	ОписаниеТЧ = Новый Структура;
	ОписаниеТЧ.Вставить("ИмяТЧ"            , ИмяТЧ);
	ОписаниеТЧ.Вставить("СинонимТЧ"        , Синоним);
	ОписаниеТЧ.Вставить("КолонкиСодержания", КолонкиСодержания);
	ОписаниеТЧ.Вставить("КолонкиВеличины"  , КолонкиВеличины);
	ОписаниеТЧ.Вставить("ЗнакПлюс"         , ЗнакПлюс);
	
	Возврат ОписаниеТЧ;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьХарактерИзмененийТЧ(ОписаниеТЧ, ДанныеИсточника, РезультатПоиска)
	
	ИмяТЧ = ОписаниеТЧ.ИмяТЧ;
	СинонимТЧ = ОписаниеТЧ.СинонимТЧ;
	КоэфПлюс = ?(ОписаниеТЧ.ЗнакПлюс, 1, -1);
	
	КолонкиСодержания = СтрРазделить(ОписаниеТЧ.КолонкиСодержания, ",");
	КолонкиВеличины = СтрРазделить(ОписаниеТЧ.КолонкиВеличины, ",");
	
	ТЗИтог = ДанныеИсточника[ИмяТЧ].Скопировать();
	ТЗИтог.Колонки.Добавить("КолСтр");
	ТЗИтог.Заполнить(-1, "КолСтр");
	
	Для каждого СтрокаИтог Из ТЗИтог Цикл
		Для каждого ИмяКолонки Из КолонкиВеличины Цикл
			СтрокаИтог[ИмяКолонки] = -КоэфПлюс * СтрокаИтог[ИмяКолонки];
		КонецЦикла;
	КонецЦикла;
	
	Для каждого СтрокаТЧ Из Объект[ИмяТЧ] Цикл
		СтрокаИтог = ТЗИтог.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаИтог, СтрокаТЧ);
		СтрокаИтог.КолСтр = 1;
		Для каждого ИмяКолонки Из КолонкиВеличины Цикл
			СтрокаИтог[ИмяКолонки] = КоэфПлюс * СтрокаИтог[ИмяКолонки];
		КонецЦикла;
	КонецЦикла;
	
	ТЗИтог.Свернуть(КолонкиСодержания, КолонкиВеличины);
	
	Для каждого СтрокаИтог Из ТЗИтог Цикл
		
		Если Не РезультатПоиска.ИзмененоСодержание И СтрокаИтог.КолСтр <> 0 Тогда
			РезультатПоиска.ЕстьОтличия = Истина;
			РезультатПоиска.ИзмененоСодержание = Истина;
			Если СтрокаИтог.КолСтр < 0 Тогда
				РезультатПоиска.ДеталиИзменения = "Пропала строка " + ТекстОписанияСтроки(ИмяТЧ, СинонимТЧ, СтрокаИтог, КолонкиСодержания);
			Иначе
				РезультатПоиска.ДеталиИзменения = "Появилась строка " + ТекстОписанияСтроки(ИмяТЧ, СинонимТЧ, СтрокаИтог, КолонкиСодержания);
			КонецЕсли;
		КонецЕсли;
		
		Для каждого ИмяКолонки Из КолонкиВеличины Цикл
			
			Если Не РезультатПоиска.ЕстьСнижение И СтрокаИтог[ИмяКолонки] < 0 Тогда
				РезультатПоиска.ЕстьОтличия = Истина;
				РезультатПоиска.ЕстьСнижение = Истина;
				РезультатПоиска.ДеталиСнижения = "Уменьшение " + ИмяКолонки + "=" + СтрокаИтог[ИмяКолонки] + " " + ТекстОписанияСтроки(ИмяТЧ, СинонимТЧ, СтрокаИтог, КолонкиСодержания);
			КонецЕсли;
			
			Если Не РезультатПоиска.ЕстьУвеличение И СтрокаИтог[ИмяКолонки] < 0 Тогда
				РезультатПоиска.ЕстьОтличия = Истина;
				РезультатПоиска.ЕстьУвеличение = Истина;
				РезультатПоиска.ДеталиУвеличения = "Увеличение " + ИмяКолонки + "=" + СтрокаИтог[ИмяКолонки] + " " + ТекстОписанияСтроки(ИмяТЧ, СинонимТЧ, СтрокаИтог, КолонкиСодержания);
			КонецЕсли;
			
		КонецЦикла;
		
		Если ДостигнутыВсеЦелиПоиска(РезультатПоиска) Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	
КонецПроцедуры

&НаСервере
Функция ТекстОписанияСтроки(ИмяТЧ, СинонимТЧ, СтрокаТаблицы, КолонкиСодержания)
	
	МетаРеквизиты = Метаданные.Документы.Калькуляция.ТабличныеЧасти[ИмяТЧ].Реквизиты;
	
	Текст = "";
	Для каждого ИмяКолонки Из КолонкиСодержания Цикл
		Текст = Текст + ?(Текст = "", "", ", ") + МетаРеквизиты[ИмяКолонки].Синоним + ": " + СтрокаТаблицы[ИмяКолонки];
	КонецЦикла;
	
	Текст = "в таблице " + СинонимТЧ + ", данные строки: " + Текст;
	
	Возврат Текст;
	
КонецФункции

&НаСервере
Функция ДостигнутыВсеЦелиПоиска(РезультатПоиска)
	
	Ответ = РезультатПоиска.ЕстьОтличия;
	Ответ = Ответ И (Не РезультатПоиска.ИскатьСнижение            Или РезультатПоиска.ЕстьСнижение);
	Ответ = Ответ И (Не РезультатПоиска.ИскатьУвеличение          Или РезультатПоиска.ЕстьУвеличение);
	Ответ = Ответ И (Не РезультатПоиска.ИскатьИзменениеСодержания Или РезультатПоиска.ИзмененоСодержание);
	
	Возврат Ответ;
	
КонецФункции

