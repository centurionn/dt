Функция ПолучитьСтатистикуРаспределения(ДатаНачала, ДатаОкончания)
	
	Результат = Новый Структура("Для20, Для40, СредняяЗагрузка", 1, 1, 0);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СРЕДНЕЕ(СтатистикаРаспределенияКТКВПоездах.Процент20) КАК Процент20,
	               |	СРЕДНЕЕ(СтатистикаРаспределенияКТКВПоездах.Процент40) КАК Процент40,
	               |	СРЕДНЕЕ(ПродажиПродуктовОстатки.ЗанятоСлотовОстаток / ПродажиПродуктовОстатки.ВсегоСлотовОстаток) КАК ПроцентЗагрузки
	               |ИЗ
	               |	РегистрСведений.СтатистикаРаспределенияКТКВПоездах КАК СтатистикаРаспределенияКТКВПоездах
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПродажиПродуктов.Остатки КАК ПродажиПродуктовОстатки
	               |		ПО СтатистикаРаспределенияКТКВПоездах.Поезд = ПродажиПродуктовОстатки.Продукт
	               |ГДЕ
	               |	СтатистикаРаспределенияКТКВПоездах.Отправка МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |	И ПродажиПродуктовОстатки.ЗанятоСлотовОстаток > 0";
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат.Для20 = ?(Ответ.Процент20 = NULL, 1, Ответ.Процент20);
		Результат.Для40 = ?(Ответ.Процент40 = NULL, 1, Ответ.Процент40);
		Результат.СредняяЗагрузка = ?(Ответ.ПроцентЗагрузки = NULL, 0, Ответ.ПроцентЗагрузки);
	КонецЕсли;
	
	Возврат Результат;	
	
КонецФункции

