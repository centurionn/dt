Процедура ММ_КалькуляцияМультимодальнойЦепочкиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекД = Элементы.ММ_КалькуляцияМультимодальнойЦепочки.ТекущиеДанные;
	Если НоваяСтрока И ТекД <> неопределено Тогда
		ТекД.Валюта = Объект.Валюта;
		ТекД.СтавкаНДС = Объект.СтавкаНДС;
		ТекД.НДСВключенВСтоимость = Объект.СуммаВключаетНДС;
		ТекД.ПунктОтправления = Объект.Суша_ПунктОтправления;
		ТекД.ПунктНазначения = Объект.Суша_ПунктНазначения;
	КонецЕсли;
	//Евросиб - АСуслов 27.09.2022 13:35:46 #
	//(
	Если Копирование Тогда
		ТекД.ИдентификаторСтроки = "";
		// Евросиб US 86792 TA 86795 Рыбьяков К.А. 15.06.2024 ((
		Если ТекД.Услуга = ПредопределенноеЗначение("Справочник.Номенклатура.ТЭУ") Тогда
			ТекД.Услуга = Неопределено;
		КонецЕсли;
		// Евросиб Рыбьяков К.А. 15.06.2024 ))
	КонецЕсли;
	//)
	//Евросиб - АСуслов 27.09.2022 13:35:47 #   
	
	//Евросиб - АСуслов 28.06.2023 10:43:33 #локации
	//(
	Если НоваяСтрока 
		И Не Копирование 
		// ДИТ US 85649 Сержантова А.С. Начало: 23.05.2024    
		и не КалькуляцииЗаявкиПСЦСервер.ТипКалькуляцииЯвляетсяМежсервиснымиРасходами(Объект.ТипКалькуляции)
		// ДИТ US 85649 Сержантова А.С. Конец: 23.05.2024
		Тогда
		ТекД.ПунктОтправления = ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
		ТекД.ПунктНазначения = ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
	КонецЕсли;
	//)
	//Евросиб - АСуслов 28.06.2023 10:43:36 #локации     
	
	// ДИТ US 85649 Сержантова А.С. Начало: 27.05.2024
	Если НоваяСтрока И Не Копирование 
		и КалькуляцииЗаявкиПСЦСервер.ТипКалькуляцииЯвляетсяМежсервиснымиРасходами(Объект.ТипКалькуляции) Тогда
	    Если СписокСтанцийОтправления.Количество() Тогда
			ТекД.ПунктОтправления = ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
		КонецЕсли;
		 Если СписокСтанцийНазначения.Количество() Тогда
			ТекД.ПунктНазначения = ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
		КонецЕсли;
	КонецЕсли;
	// ДИТ US 85649 Сержантова А.С. Конец: 27.05.2024
КонецПроцедуры

