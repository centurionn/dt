&НаКлиенте
Процедура НФ_ЛинииПортыПриАктивизацииЯчейки(Элемент)
	
	СтандартнаяОбработка = Ложь;
	
	ТекД = Элементы.НФ_ЛинииПорты.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если (НЕ СтрНайти(Элемент.ТекущийЭлемент.Имя,"SOC") = 0 ИЛИ 
		НЕ СтрНайти(Элемент.ТекущийЭлемент.Имя,"COC") = 0) И
		СтрНайти(Элемент.ТекущийЭлемент.Имя,"Выбрано") = 0 И
		СтрНайти(Элемент.ТекущийЭлемент.Имя,"Флажок") = 0 Тогда	
		//ДИТ, Беляев СЮ, US 85745 / TA 85764, 24-05-2024, начало
		Элемент.ТекущийЭлемент.РежимВыбораИзСписка = Ложь;
		Элемент.ТекущийЭлемент.СписокВыбора.Очистить();
		//ДИТ, Беляев СЮ, US 85745 / TA 85764, 24-05-2024, конец
		Если НЕ СтрНайти(Строка(ТекД.Статья),Строка("20")) = 0 ИЛИ
			НЕ СтрНайти(Строка(ТекД.Статья),Строка("40")) = 0 Тогда
			Элемент.ТекущийЭлемент.ВыбиратьТип = Ложь;
			Элемент.ТекущийЭлемент.ОграничениеТипа = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10,3));
		ИначеЕсли НЕ СтрНайти(Строка(ТекД.Статья),Строка("Валюта")) = 0 Тогда
			Элемент.ТекущийЭлемент.ВыбиратьТип = Ложь;
			Элемент.ТекущийЭлемент.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.Валюты");
			//ДИТ, Беляев СЮ, US 85745 / TA 85764, 24-05-2024, начало
			Элемент.ТекущийЭлемент.РежимВыбораИзСписка = Истина;
			Элемент.ТекущийЭлемент.СписокВыбора.ЗагрузитьЗначения(ОсновныеВалюты.ВыгрузитьЗначения());
			//ДИТ, Беляев СЮ, US 85745 / TA 85764, 24-05-2024, конец
		ИначеЕсли НЕ СтрНайти(Строка(ТекД.Статья),Строка("Погрузка")) = 0 ИЛИ
			НЕ СтрНайти(Строка(ТекД.Статья),Строка("Выгрузка")) = 0 Тогда
			Элемент.ТекущийЭлемент.ВыбиратьТип = Ложь;
			Элемент.ТекущийЭлемент.ОграничениеТипа = Новый ОписаниеТипов("ПеречислениеСсылка.УсловияПеревозкиПоПортам");
		КонецЕсли;
	//ИначеЕсли (НЕ СтрНайти(Элемент.ТекущийЭлемент.Имя,"SOC") = 0 ИЛИ 
	//	НЕ СтрНайти(Элемент.ТекущийЭлемент.Имя,"COC") = 0) И
