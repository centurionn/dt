&НаКлиенте
Процедура ДополнительныеТарифы(Команда)
	
	ТекД = Элементы.НФ_ЛинииПорты.ТекущиеДанные;
	Если ТекД = неопределено Тогда Возврат; КонецЕсли;
	
	КодПорта = Прав(Элементы.НФ_ЛинииПорты.ТекущийЭлемент.Имя, 9);
	ПортЪ = ПолучитьЛокациюПоКоду(КодПорта);
	
	Если Объект.ФрахтИмпорт Тогда
		ПунктОтправления = ПортЪ;
		// Евросиб US 87896 TA 90558 Рыбьяков К.А. 18.09.2024 ((
		ПунктНазначения = Новый Массив;
		Для Каждого Строка Из Объект.ММ_ПортыОтправленияНазначения Цикл
			ПунктНазначения.Добавить(Строка.Порт);
		КонецЦикла;
		//ПунктНазначения = Объект.ММ_ПортОтправления;
		// Евросиб Рыбьяков К.А. 18.09.2024 ))
	Иначе
		// Евросиб US 87896 TA 90558 Рыбьяков К.А. 18.09.2024 ((
		ПунктОтправления = Новый Массив;
		Для Каждого Строка Из Объект.ММ_ПортыОтправленияНазначения Цикл
			ПунктОтправления.Добавить(Строка.Порт);
		КонецЦикла;
		//ПунктОтправления = Объект.ММ_ПортОтправления;
		// Евросиб Рыбьяков К.А. 18.09.2024 ))
		ПунктНазначения = ПортЪ; 
	КонецЕсли;
	
	СтрНаправление = Новый Структура("Линия,ПунктОтправления,ПунктНазначения", ТекД.Контрагент, ПунктОтправления, ПунктНазначения);
	
	РазмерКТК = ПредопределенноеЗначение("Справочник.РазмерыКТК.К40");
	Если 
		ТекД.Статья = ПредопределенноеЗначение("Перечисление.СтатьяФрахта.Вознаграждение20") ИЛИ
		ТекД.Статья = ПредопределенноеЗначение("Перечисление.СтатьяФрахта.Итого20") ИЛИ
		ТекД.Статья = ПредопределенноеЗначение("Перечисление.СтатьяФрахта.Фрахт20")
	Тогда
		РазмерКТК = ПредопределенноеЗначение("Справочник.РазмерыКТК.К20");
	КонецЕсли;
		
	
	СтруктураПараметров = Новый Массив;
	СтруктураПараметров.Добавить(Новый Структура("Направление, Услуга", СтрНаправление, УслугаФрахтаДляКалькуляции));
	ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораТарифов_пустая", ЭтаФорма);
	ОткрытьФорму("Документ.Калькуляция.Форма.ПодборТарифаКалькуляцией", Новый Структура("ПоискТарифов, ДатаПоиска, Груженый, Организация, РазмерКТК", СтруктураПараметров, Объект.ММ_ДействиеСтавокНа, Объект.ММ_ГруженыйПоМорю, Объект.Организация, РазмерКТК),,ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

