&НаКлиенте
Процедура Делегировать(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ВыборДелегирования", ЭтаФорма);
	ОткрытьФорму("Справочник.Пользователи.Форма.ФормаВыбора",,,ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборДелегирования(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	Для Сч = 0 По Объект.Состояния.Количество()-1 Цикл
		Если Объект.Состояния[Сч].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение") ИЛИ Объект.Состояния[Сч].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.ВРаботе") Тогда
			Объект.Состояния[Сч].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Новый");
			НСтр = Объект.Состояния.Вставить(Сч);
			НСтр.Состояние = ПредопределенноеЗначение("Справочник.Состояния.ДелегированноеСогласование");
			НСтр.Исполнитель = Параметр1;
			НСтр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение");
			ОбновитьПанельСостояний();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Рецензирование(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаРецензирования", ЭтаФорма);
	ПараметрыФормы = Новый Структура("РецензОбъект", Объект.Ссылка);
	ОткрытьФорму("ОбщаяФорма.РецензированиеПриСогласовании", ПараметрыФормы,,ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаРецензирования(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура СостоянияСтатусСогласованияПриИзменении(Элемент)
	
	ТекД = Элементы.Состояния.ТекущиеДанные;
	Если ТекД <> неопределено Тогда
		ТекД.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Выполнен");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЛистСогласования(Команда)
	
	ТабДок = МаршрутизацияСервер.ПолучитьТабдокЛистаСогласования(Объект.Ссылка);
	ТабДок.Показать();
	
КонецПроцедуры

&НаКлиенте
Процедура РасчетRT(Команда)
	
	Адрес = ПолучитьТЗУслугНаСервере();
	ОпОп = Новый ОписаниеОповещения("ОбработкаЗакрытияФормыКалькуляции", ЭтотОбъект);
	ОткрытьФорму("Документ.Калькуляция.Форма.ФормаКалькуляции",Новый Структура("АдресТаблицыУслуг", Адрес),,,,,ОпОп);	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТЗУслугНаСервере()
	
	ТЗУслуг = Объект.ММ_КалькуляцияЖДСоставляющей.Выгрузить();
	Адрес = ПоместитьВоВременноеХранилище(ТЗУслуг, Новый УникальныйИдентификатор);
	Возврат Адрес;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаЗакрытияФормыКалькуляции(Параметр1, Параметр2) Экспорт
	ЗаполнитьУслугиНаСервере(Параметр1);
	ОбновитьИтоговыеПараметрыТаблиц(ВалютаИтогов);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУслугиНаСервере(Параметр)
	АдресХранилища = Неопределено;
	Если НЕ Параметр = Неопределено И Параметр.Свойство("АдресТаблицыУслуг", АдресХранилища) Тогда
		ТЗУслуги = ПолучитьИзВременногоХранилища(АдресХранилища);
		Объект.ММ_КалькуляцияЖДСоставляющей.Загрузить(ТЗУслуги);
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура КалькуляцияЗавершенаПриИзменении(Элемент)
	
	Если Объект.КалькуляцияЗавершена Тогда
		
		ДляТекущейКалькуляцииНужнаУслугаПодсыла = Ложь;
		
		Если СтоимостьПодсылаВключенаВТекущуюОтправку(Объект.Отправка) Тогда
			ДляТекущейКалькуляцииНужнаУслугаПодсыла = Истина;
		Иначе
			ПредыдущаяОтправка = Отправки_сервер.ПолучитьПредыдущуюОтправку(Объект.Отправка);
			СтоимостьВключенаВПредыдущую = СтоимостьПодсылаВключенаВТекущуюОтправку(ПредыдущаяОтправка);
			Если НЕ СтоимостьВключенаВПредыдущую Тогда
				ДляТекущейКалькуляцииНужнаУслугаПодсыла = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ДляТекущейКалькуляцииНужнаУслугаПодсыла И Объект.ММ_КалькуляцияЖДСоставляющей.НайтиСтроки(Новый Структура("Операция", УслугаПодсылаВагонов)).Количество() = 0 Тогда
			
			ОпОп = Новый ОписаниеОповещения("ОтветНаОтсутствиеПодсыла", ЭтаФорма);
			ПоказатьВопрос(ОпОп, "В этой калькуляции должна быть учтена стоимость подсыла порожних вагонов, но ее нет. Вы действительно хотите оставить калькуляцию без стоимости подсыла?", РежимДиалогаВопрос.ДаНет);
			
		КонецЕсли;
		
	КонецЕсли;
	
