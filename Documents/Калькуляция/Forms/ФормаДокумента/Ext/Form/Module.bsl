&НаСервере
Процедура СкопироватьТСхНаСервере(ОбъектКалькуляцияСозданаНаОсновании, ОбъектСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТехнологическаяСхема.ПредметТСх КАК ПредметТСх,
	               |	ТехнологическаяСхема.Вариант КАК Вариант,
	               |	ТехнологическаяСхема.ТСх КАК ТСх
	               |ИЗ
	               |	РегистрСведений.ТехнологическаяСхема КАК ТехнологическаяСхема
	               |ГДЕ
	               |	ТехнологическаяСхема.ПредметТСх = &ПредметТСх";
	Запрос.УстановитьПараметр("ПредметТСх", ОбъектКалькуляцияСозданаНаОсновании);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		КопияТСх = ПостроительТСх_сервер.СкопироватьТСх(Ответ.ТСх);
		
		МЗ = РегистрыСведений.ТехнологическаяСхема.СоздатьМенеджерЗаписи();
		МЗ.Вариант = Ответ.Вариант+"_"+Прав(КопияТСх.Код, 7);
		МЗ.ПредметТСх = ОбъектСсылка;
		МЗ.ТСх = КопияТСх;
		МЗ.Записать(Истина);
		
	КонецЦикла;
	
КонецПроцедуры

