&НаСервере
Функция ПолучитьНестандартнуюМаршрутизацию(НовМаршрутизация,ПроцДоходности)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Маршрутизация.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Маршрутизация КАК Маршрутизация
		|ГДЕ
		|	Маршрутизация.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Наименование", НовМаршрутизация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПодходящаяМаршрутизация = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;

	РезультатЗапроса = Новый Массив;
	Для каждого Стр из ПодходящаяМаршрутизация.Состояния Цикл
		Статус = ?(РезультатЗапроса.Количество() = 0, ПодходящаяМаршрутизация.НачальныйСтатус, Перечисления.СтатусыЭтапов.Новый);
		
		Если Стр.НаправлятьНаСогласованиеПриДоходностиМенееПроцентов <> 0 И Стр.НаправлятьНаСогласованиеПриДоходностиМенееПроцентов > ПроцДоходности Тогда
			Статус = Перечисления.СтатусыЭтапов.Выполнен;
		КонецЕсли;
		
		РезультатЗапроса.Добавить(Новый Структура("Состояние, Исполнитель, Наблюдатель, Статус, Ссылка, ПредыдущиеЭтапы, ОРКПоДоговору, ОтветственныйЗаУчет, ОтветственныйЗаДоговор, НормативИсполненияСМоментаСоздания, ТребуетсяУказатьНаблюдателя, ТребуетсяУказатьИсполнителя, ВидНормативаИсполнения,ИсполнительКакРуководительПоНаправлению,НаблюдательКакРуководительПоНаправлению", Стр.Состояние, Стр.Исполнитель, Стр.Наблюдатель, Статус, ПодходящаяМаршрутизация, Стр.ПредыдущиеЭтапы, Стр.СопровождениеПоДоговору, Стр.ОтветственныйЗаУчет, Стр.ОтветственныйЗаДоговор, Стр.НормативИсполненияСМоментаСоздания, Стр.ТребуетсяУказатьНаблюдателя, Стр.ТребуетсяУказатьИсполнителя, Стр.ВидНормативаИсполнения,Стр.ИсполнительКакРуководительПоНаправлению,Стр.НаблюдательКакРуководительПоНаправлению));
	КонецЦикла;
	МаршрутизацияСервер.ОтработатьЗамещениеДелегирование(РезультатЗапроса, Перечисления.МаршрутизируемыеОбъекты.Калькуляция, Объект.Дата, Объект.Договор);
	МаршрутизацияСервер.ОтработатьЗамещениеДелегирование(РезультатЗапроса, Перечисления.МаршрутизируемыеОбъекты.Калькуляция, Объект.Дата, Объект.ПС_ВидПеревозки);
	Возврат РезультатЗапроса;
КонецФункции

