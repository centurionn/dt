// ДИТ US 59973 ТА 68125 Сержантова А.С. Начало: 24.07.2023
&НаСервере
Процедура РекурсивноОчиститьДанныеВкладки(ЭлементОчищения)
	
	Для каждого ЭлементГруппы Из ЭлементОчищения.ПодчиненныеЭлементы Цикл 
		Если ТипЗнч(ЭлементГруппы) = Тип("ГруппаФормы") Тогда
			РекурсивноОчиститьДанныеВкладки(ЭлементГруппы)	
		ИначеЕсли ТипЗнч(ЭлементГруппы) <> Тип("ПолеФормы") 
			и ТипЗнч(ЭлементГруппы) <> Тип("ТаблицаФормы") Тогда
			Продолжить;
		Иначе
			ИменаЭл = СтрРазделить(ЭлементГруппы.ПутьКДанным, ".", Ложь);
			Если ИменаЭл.Количество() > 1 и ИменаЭл[0] = "Объект" Тогда 
				Если Объект[ИменаЭл[1]] = Неопределено Тогда  //значение не заполнено
					Продолжить;	
				КонецЕсли;
				Если ТипЗнч(Объект[ИменаЭл[1]]) = Тип("ДанныеФормыКоллекция")  Тогда
					Объект[ИменаЭл[1]].Очистить();
					Продолжить;  
				ИначеЕсли ТипЗнч(Объект[ИменаЭл[1]]) = Тип("Число")  Тогда
					Объект[ИменаЭл[1]] = 0;  
					Продолжить;
				ИначеЕсли ТипЗнч(Объект[ИменаЭл[1]]) = Тип("Строка")  Тогда
					Объект[ИменаЭл[1]] = "";   
					Продолжить;
				ИначеЕсли ТипЗнч(Объект[ИменаЭл[1]]) = Тип("Булево")  Тогда
					Объект[ИменаЭл[1]] = Ложь; 
					Продолжить;
				КонецЕсли;
				ТипСтрокой = Объект[ИменаЭл[1]].Метаданные().ПолноеИмя();
				ТипСтрокой = СтрЗаменить(ТипСтрокой, "Справочник", "СправочникСсылка");
				ТипСтрокой = СтрЗаменить(ТипСтрокой, "Документ", "ДокументСсылка");
                ТипСтрокой = СтрЗаменить(ТипСтрокой, "Перечисление", "ПеречислениеСсылка");
				ТипЗначения = Новый ОписаниеТипов(ТипСтрокой);
				Объект[ИменаЭл[1]] = ТипЗначения.ПривестиЗначение();
			КонецЕсли;
		КонецЕсли;				
	КонецЦикла;

КонецПроцедуры

