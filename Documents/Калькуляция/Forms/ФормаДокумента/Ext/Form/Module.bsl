&НаСервере
Процедура ОбновитьДанныеРентабельности()
	
	ОграниченияМаксПроцРент = 0;
	ОграниченияМинПроцРент = 0;
	ОграниченияМаксСуммаРент = 0;
	ОграниченияМинСуммаРент = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НормативыМаржинальностиПеревозокСрезПоследних.МинПроцентСтавки КАК МинПроцентСтавки,
	               |	НормативыМаржинальностиПеревозокСрезПоследних.МаксПроцентСтавки КАК МаксПроцентСтавки,
	               |	НормативыМаржинальностиПеревозокСрезПоследних.МинСуммаРубли КАК МинСуммаРубли,
	               |	НормативыМаржинальностиПеревозокСрезПоследних.МаксСуммаРубли КАК МаксСуммаРубли
	               |ИЗ
	               |	РегистрСведений.НормативыМаржинальностиПеревозок.СрезПоследних(
	               |			&Период,
	               |			Организация = &Организация
	               |				И (Клиент = &Клиент
	               |					ИЛИ Клиент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	               |				И (ВидКалькуляции = &ВидКалькуляции
	               |					ИЛИ ВидКалькуляции = ЗНАЧЕНИЕ(Перечисление.ТипыКалькуляций.ПустаяСсылка))) КАК НормативыМаржинальностиПеревозокСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НормативыМаржинальностиПеревозокСрезПоследних.Клиент УБЫВ,
	               |	НормативыМаржинальностиПеревозокСрезПоследних.ВидКалькуляции УБЫВ";
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Клиент", Объект.Контрагент);
	Запрос.УстановитьПараметр("ВидКалькуляции", Объект.ТипКалькуляции);
	Запрос.УстановитьПараметр("Период", Объект.Дата);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		ОграниченияМаксПроцРент = Ответ.МаксПроцентСтавки;
		ОграниченияМинПроцРент = Ответ.МинПроцентСтавки;
		ОграниченияМаксСуммаРент = Ответ.МаксСуммаРубли;
		ОграниченияМинСуммаРент = Ответ.МинСуммаРубли;
	КонецЕсли;
	
КонецПроцедуры

