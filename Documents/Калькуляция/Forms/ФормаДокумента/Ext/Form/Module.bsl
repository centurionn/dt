	//ИтогСтавка13_40 = Объект.ММ_Ставка40_1_3;
	
	ИтогСтавка13_20 = ММ_СтавкаИтого20;
	ИтогСтавка13_40 = ММ_СтавкаИтого;
	
	Если Объект.ЗафиксироватьКурс ИЛИ КурсВручную Тогда
		ПараметрыКурсаДокумента = Новый Структура;
		ПараметрыКурсаДокумента.Вставить("Валюта",Валюта);
		ПараметрыКурсаДокумента.Вставить("ДатаКурса",Объект.ДатаКурса);
		ПараметрыКурсаДокумента.Вставить("Кратность",1);
		ПараметрыКурсаДокумента.Вставить("Курс",Объект.Курс);
	Иначе
		ПараметрыКурсаДокумента = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Валюта, ?(ЗначениеЗаполнено(Объект.ДатаКурса), Объект.ДатаКурса, Объект.Дата));
	КонецЕсли;

    ПараметрыКурсаПересчета = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Справочники.Валюты.Рубль, ?(ЗначениеЗаполнено(Объект.ДатаКурса), Объект.ДатаКурса, Объект.Дата));
	
	ИтогСтавка13_20 = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(ИтогСтавка13_20, ПараметрыКурсаДокумента, ПараметрыКурсаПересчета);
	ИтогСтавка13_40 = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(ИтогСтавка13_40, ПараметрыКурсаДокумента, ПараметрыКурсаПересчета);
	
	Если Объект.СуммаВключаетНДС Тогда
		
		ПроцентНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Объект.СтавкаНДС);
		
		ИтогСтавка13_20_СуммаНДС   = Окр(ИтогСтавка13_20 * ПроцентНДС / (100 + ПроцентНДС), 2);
		ИтогСтавка13_20 = ИтогСтавка13_20 - ИтогСтавка13_20_СуммаНДС;
		
		ИтогСтавка13_40_СуммаНДС   = Окр(ИтогСтавка13_40 * ПроцентНДС / (100 + ПроцентНДС), 2);
		ИтогСтавка13_40 = ИтогСтавка13_40 - ИтогСтавка13_40_СуммаНДС;
	КонецЕсли;
	
	Объект.ММ_ИтогоВознаграждение20БезНДСРуб =  ИтогСтавка13_20 - Себестоимость20;
	Объект.ММ_ИтогоВознаграждениеБезНДСРуб =  ИтогСтавка13_40 - Себестоимость40;
	
КонецПроцедуры	

&НаСервере
Процедура ПолучитьРасчетнуюКонтрибуцию() //Евросиб Шевченко А.В. 03.06.2025 US 97974 TA 111305
	
	ПараметрыКурса = Новый Соответствие;
	Валюта = Объект.Валюта;
	КурсВручную = Ложь;
	
	РасчетнаяКонтрибуция20 = 0;
	РасчетнаяКонтрибуция40 = 0;
	
	Для каждого Стр из Объект.ММ_КалькуляцияМультимодальнойЦепочки Цикл
		
		Если Стр.ОсновнаяУслугаГруппы = Ложь И ЗначениеЗаполнено(Стр.ГруппаУслуг) Тогда Продолжить; КонецЕсли;
		
		Если Стр.Услуга.ИсключатьИзРасчетнойКонтрибуции Тогда
			Продолжить;
		КонецЕсли;	
		
		ПараметрыКурсаДокумента = ПараметрыКурса.Получить(Справочники.Валюты.Рубль);
		ПараметрыКурсаДокумента = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Справочники.Валюты.Рубль, ?(ЗначениеЗаполнено(Объект.ДатаКурса), Объект.ДатаКурса, Объект.Дата));
		ПараметрыКурса.Вставить(Справочники.Валюты.Рубль, ПараметрыКурсаДокумента);

		ПараметрыКурсаСтроки = ПараметрыКурса.Получить(Стр.Валюта);
		Если ПараметрыКурсаСтроки = неопределено Тогда
			ПараметрыКурсаСтроки = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Стр.Валюта, ?(ЗначениеЗаполнено(Объект.ДатаКурса), Объект.ДатаКурса, Объект.Дата));
			ПараметрыКурса.Вставить(Стр.Валюта, ПараметрыКурсаСтроки);
		КонецЕсли;
		
		Цена20 = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Стр.Цена20, ПараметрыКурсаСтроки, ПараметрыКурсаДокумента);
		Цена40 = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Стр.Цена40, ПараметрыКурсаСтроки, ПараметрыКурсаДокумента);
		
		РасчетнаяКонтрибуция20 = РасчетнаяКонтрибуция20 + Цена20;
		РасчетнаяКонтрибуция40 = РасчетнаяКонтрибуция40 + Цена40;
		
		Если Стр.НДСВключенВСтоимость Тогда
			чСтавкаНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Стр.СтавкаНДС);
			РасчетнаяКонтрибуция20 = РасчетнаяКонтрибуция20 - Цена20* чСтавкаНДС / (100 + чСтавкаНДС);
			РасчетнаяКонтрибуция40 = РасчетнаяКонтрибуция40 - Цена40* чСтавкаНДС / (100 + чСтавкаНДС);
		КонецЕсли;
		
	КонецЦикла;	
	Если Объект.ЕдиницаИзмерения <> ПредопределенноеЗначение("Справочник.КлассификаторЕдиницИзмерения.вагон") Тогда	
		Если РасчетнаяКонтрибуция40 > 0 Тогда
			РасчетнаяКонтрибуция40 = РасчетнаяКонтрибуция40 / 2;
		КонецЕсли;	
	КонецЕсли;
	Возн40 = 0;
	Возн20 = 0;
	Итог40 = 0;
	Итог20 = 0;
	
	КолонкиТЗ = НФ_ЛинииПорты.Выгрузить().Колонки;
	
	мСтавок20 = Новый СписокЗначений;
	мСтавок40 = Новый СписокЗначений;
	
	тСтавок20 = Новый ТаблицаЗначений;
	тСтавок20.Колонки.Добавить("Возн20");
	тСтавок20.Колонки.Добавить("Итог20");
	тСтавок40 = Новый ТаблицаЗначений;
	тСтавок40.Колонки.Добавить("Возн40");
	тСтавок40.Колонки.Добавить("Итог40");
	
	Для Каждого Кол Из КолонкиТЗ Цикл	
		Если (НЕ СтрНайти(Кол.Имя,"SOC") = 0 ИЛИ НЕ СтрНайти(Кол.Имя,"COC") = 0) И 
			СтрНайти(Кол.Имя,"Выбрано") = 0 И
			СтрНайти(Кол.Имя,"Флажок") = 0 Тогда
			ТекКолонка = Кол.Имя;
			Для Каждого СтрТз Из НФ_ЛинииПорты Цикл
				Если СтрТз.Статья = Перечисления.СтатьяФрахта.Вознаграждение40 И ЗначениеЗаполнено(СтрТз[ТекКолонка]) Тогда
					Возн40 = СтрТз[ТекКолонка];
				КонецЕсли;
				Если СтрТз.Статья = Перечисления.СтатьяФрахта.Вознаграждение20 И ЗначениеЗаполнено(СтрТз[ТекКолонка]) Тогда
					Возн20 = СтрТз[ТекКолонка];
				КонецЕсли;
				Если СтрТз.Статья = Перечисления.СтатьяФрахта.Итого40 И ЗначениеЗаполнено(СтрТз[ТекКолонка]) Тогда
					Итог40 = СтрТз[ТекКолонка];
				КонецЕсли;
				Если СтрТз.Статья = Перечисления.СтатьяФрахта.Итого20 И ЗначениеЗаполнено(СтрТз[ТекКолонка]) Тогда
					Итог20 = СтрТз[ТекКолонка];
				КонецЕсли;
				Если СтрТз.Статья = Перечисления.СтатьяФрахта.Валюта Тогда
					
					ПараметрыКурсаДокумента = ПараметрыКурса.Получить(Справочники.Валюты.Рубль);
					ПараметрыКурсаДокумента = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Справочники.Валюты.Рубль, ?(ЗначениеЗаполнено(Объект.ДатаКурса), Объект.ДатаКурса, Объект.Дата));
					ПараметрыКурса.Вставить(Справочники.Валюты.Рубль, ПараметрыКурсаДокумента);

					ПараметрыКурсаСтроки = ПараметрыКурса.Получить(СтрТз[ТекКолонка]);
					Если ПараметрыКурсаСтроки = неопределено Тогда
						ПараметрыКурсаСтроки = РаботаСКурсамиВалют.ПолучитьКурсВалюты(СтрТз[ТекКолонка], ?(ЗначениеЗаполнено(Объект.ДатаКурса), Объект.ДатаКурса, Объект.Дата));
						ПараметрыКурса.Вставить(СтрТз[ТекКолонка], ПараметрыКурсаСтроки);
					КонецЕсли;
					Возн20 = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Возн20, ПараметрыКурсаСтроки, ПараметрыКурсаДокумента);
					Возн40 = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Возн40, ПараметрыКурсаСтроки, ПараметрыКурсаДокумента);
					
					Итог20 = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Итог20, ПараметрыКурсаСтроки, ПараметрыКурсаДокумента);
					Итог40 = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Итог40, ПараметрыКурсаСтроки, ПараметрыКурсаДокумента);
					
					Если Объект.СуммаВключаетНДСФрахт Тогда
						
						ПроцентНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Объект.НДСФрахт);
						
						Возн20_СуммаНДС   = Окр(Возн20 * ПроцентНДС / (100 + ПроцентНДС), 2);
						Возн20 = Возн20 - Возн20_СуммаНДС;
						
						Итог20_СуммаНДС   = Окр(Итог20 * ПроцентНДС / (100 + ПроцентНДС), 2);
						Итог20 = Итог20 - Итог20_СуммаНДС;
						
						Возн40_СуммаНДС   = Окр(Возн40 * ПроцентНДС / (100 + ПроцентНДС), 2);
						Возн40 = Возн40 - Возн40_СуммаНДС;
						
						Итог40_СуммаНДС   = Окр(Итог40 * ПроцентНДС / (100 + ПроцентНДС), 2);
						Итог40 = Итог40 - Итог40_СуммаНДС;
						
					КонецЕсли;
					Если Объект.ЕдиницаИзмерения <> ПредопределенноеЗначение("Справочник.КлассификаторЕдиницИзмерения.вагон") Тогда
						Возн40 = Возн40/2;
					КонецЕсли;
					Если Возн20 <> 0 Тогда
						мСтавок20.Добавить(Возн20);
						новСтр = тСтавок20.Добавить();
						новСтр.Возн20 = Возн20;
						новСтр.Итог20 = Итог20;
					КонецЕсли;
					Если Возн40 <> 0 Тогда
						мСтавок40.Добавить(Возн40);
						новСтр = тСтавок40.Добавить();
						новСтр.Возн40 = Возн40;
						новСтр.Итог40 = Итог40;
					КонецЕсли;
					
				КонецЕсли;	
			КонецЦикла;
		Иначе
			Продолжить;
		КонецЕсли;
		
		
	КонецЦикла;
	
	//Если мСтавок20.Количество() Тогда
	//	мСтавок20.СортироватьПоЗначению(НаправлениеСортировки.Возр);
	//	РасчетнаяКонтрибуция20 = РасчетнаяКонтрибуция20 + мСтавок20[0].Значение;
	//КонецЕсли;
	//Если мСтавок40.Количество() Тогда
	//	мСтавок40.СортироватьПоЗначению(НаправлениеСортировки.Возр);
	//	РасчетнаяКонтрибуция40 = РасчетнаяКонтрибуция40 + мСтавок40[0].Значение;
	//КонецЕсли;
	
	Если тСтавок20.Количество() Тогда
		тСтавок20.Сортировать("Возн20 ВОЗР");
		РасчетнаяКонтрибуция20 = РасчетнаяКонтрибуция20 + тСтавок20[0].Возн20;
		//море20Ставка		   = тСтавок20[0].Итог20; //Евросиб Шевченко А.В. US 122386 TA 122575 30.10.2025
	КонецЕсли;
	
	Если тСтавок40.Количество() Тогда
		тСтавок40.Сортировать("Возн40 ВОЗР");
		РасчетнаяКонтрибуция40 = РасчетнаяКонтрибуция40 + тСтавок40[0].Возн40;
		//море40Ставка		   = тСтавок40[0].Итог40; //Евросиб Шевченко А.В. US 122386 TA 122575 30.10.2025
	КонецЕсли;
	
	//Евросиб Шевченко А.В. US 122386 TA 122575 30.10.2025
	ИтогСтавка13_20 = ММ_СтавкаИтого20;
	ИтогСтавка13_40 = ММ_СтавкаИтого;
	//Если Объект.Дата > ДатаНачалаНовогоРасчетаВознаграждения Тогда
	//	ИтогСтавка13_20 = Объект.ММ_Ставка20_1_3;
	//	ИтогСтавка13_40 = Объект.ММ_Ставка40_1_3;
	//Иначе
	//	ИтогСтавка13_20 = ММ_СтавкаИтого20;
	//	ИтогСтавка13_40 = ММ_СтавкаИтого;
	//КонецЕсли;
	
	Если Объект.ЗафиксироватьКурс ИЛИ КурсВручную Тогда
		ПараметрыКурсаДокумента = Новый Структура;
		ПараметрыКурсаДокумента.Вставить("Валюта",Валюта);
		ПараметрыКурсаДокумента.Вставить("ДатаКурса",Объект.ДатаКурса);
		ПараметрыКурсаДокумента.Вставить("Кратность",1);
		ПараметрыКурсаДокумента.Вставить("Курс",Объект.Курс);
	Иначе
		ПараметрыКурсаДокумента = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Валюта, ?(ЗначениеЗаполнено(Объект.ДатаКурса), Объект.ДатаКурса, Объект.Дата));
	КонецЕсли;

	ПараметрыКурсаПересчета = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Справочники.Валюты.Рубль, ?(ЗначениеЗаполнено(Объект.ДатаКурса), Объект.ДатаКурса, Объект.Дата));
	
	ИтогСтавка13_20 = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(ИтогСтавка13_20, ПараметрыКурсаДокумента, ПараметрыКурсаПересчета);
	ИтогСтавка13_40 = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(ИтогСтавка13_40, ПараметрыКурсаДокумента, ПараметрыКурсаПересчета);

	//ИтогСтавкаМоре_20 = море20Ставка;
	//ИтогСтавкаМоре_40 = море40Ставка;
	//
	Если Объект.СуммаВключаетНДС Тогда
		
		ПроцентНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Объект.СтавкаНДС);
		
		ИтогСтавка13_20_СуммаНДС   = Окр(ИтогСтавка13_20 * ПроцентНДС / (100 + ПроцентНДС), 2);
		ИтогСтавка13_20 = ИтогСтавка13_20 - ИтогСтавка13_20_СуммаНДС;
		
		ИтогСтавка13_40_СуммаНДС   = Окр(ИтогСтавка13_40 * ПроцентНДС / (100 + ПроцентНДС), 2);
		ИтогСтавка13_40 = ИтогСтавка13_40 - ИтогСтавка13_40_СуммаНДС;
	КонецЕсли;
	//Если Объект.СуммаВключаетНДСФрахт Тогда
	//	
	//	ПроцентНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Объект.НДСФрахт);
	//	
	//	ИтогСтавкаМоре_20_СуммаНДС   = Окр(ИтогСтавкаМоре_20 * ПроцентНДС / (100 + ПроцентНДС), 2);
	//	ИтогСтавкаМоре_20 = ИтогСтавкаМоре_20 - ИтогСтавкаМоре_20_СуммаНДС;
	//	
	//	ИтогСтавкаМоре_40_СуммаНДС   = Окр(ИтогСтавкаМоре_40 * ПроцентНДС / (100 + ПроцентНДС), 2);
	//	ИтогСтавкаМоре_40 = ИтогСтавкаМоре_40 - ИтогСтавкаМоре_40_СуммаНДС;
	//	
	//КонецЕсли;	
	//Евросиб Шевченко А.В. US 122386 TA 122575 30.10.2025
	
	Если Объект.ЕдиницаИзмерения = ПредопределенноеЗначение("Справочник.КлассификаторЕдиницИзмерения.вагон") Тогда
		
		РазмерТЕУ = 1;
		
		Если ЗначениеЗаполнено(Объект.ЖД_РасчетСебестоимостиДляТипаФГП) Тогда
			
			РазмерТЕУ = ПолучитьРазмерТЕУ(Объект.ЖД_РасчетСебестоимостиДляТипаФГП);
			
		КонецЕсли;	
		//Евросиб Шевченко А.В. US 122386 TA 122575 30.10.2025
		//РасчетнаяКонтрибуция20 = ((ИтогСтавка13_20 + ИтогСтавкаМоре_20) - РасчетнаяКонтрибуция20)/РазмерТЕУ;
		//РасчетнаяКонтрибуция40 = ((ИтогСтавка13_40 + ИтогСтавкаМоре_40) - РасчетнаяКонтрибуция40)/РазмерТЕУ;
		
		//РасчетнаяКонтрибуция20 = ((ИтогСтавка13_20 + ИтогСтавкаМоре_20) - РасчетнаяКонтрибуция20)/РазмерТЕУ;
		//РасчетнаяКонтрибуция40 = ((ИтогСтавка13_40 + ИтогСтавкаМоре_40) - РасчетнаяКонтрибуция40)/РазмерТЕУ;
		
		РасчетнаяКонтрибуция20 = (ИтогСтавка13_20 - РасчетнаяКонтрибуция20)/РазмерТЕУ;
		РасчетнаяКонтрибуция40 = (ИтогСтавка13_40 -  РасчетнаяКонтрибуция40)/РазмерТЕУ;
	Иначе
		//РасчетнаяКонтрибуция20 = (ИтогСтавка13_20 + ИтогСтавкаМоре_20) - РасчетнаяКонтрибуция20;
		//РасчетнаяКонтрибуция40 = ((ИтогСтавка13_40/2) + ИтогСтавкаМоре_40/2) - РасчетнаяКонтрибуция40;
		
		РасчетнаяКонтрибуция20 = ИтогСтавка13_20 - РасчетнаяКонтрибуция20;
		РасчетнаяКонтрибуция40 = (ИтогСтавка13_40/2) - РасчетнаяКонтрибуция40;
		
		//Евросиб Шевченко А.В. US 122386 TA 122575 30.10.2025
	КонецЕсли;
	
	
КонецПроцедуры	

&НаСервере 
Функция ПолучитьРазмерТЕУ(ЖД_РасчетСебестоимостиДляТипаФГП);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТипоразмерыТС.ТЕУ КАК ТЕУ
	|ИЗ
	|	Справочник.ТипоразмерыТС КАК ТипоразмерыТС
	|ГДЕ
	|	ТипоразмерыТС.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ЖД_РасчетСебестоимостиДляТипаФГП);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ТЕУ) Тогда
			Возврат ВыборкаДетальныеЗаписи.ТЕУ;
		КонецЕсли;
	КонецЦикла;

	Возврат 1;
	
КонецФункции

