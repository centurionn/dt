	|	TS1.КлючАналитикиСтрокиКалькуляции КАК КлючАналитикиСтрокиКалькуляции,
	|	TS1.ИдентификаторСтроки КАК ИдентификаторСтроки,
	// Евросиб US 87896 TA 90558 Рыбьяков К.А. 11.09.2024 ((
	|	TS1.ПортВыгрузкиОтгрузки КАК ПортВыгрузкиОтгрузки
	// Евросиб Рыбьяков К.А. 11.09.2024 ))
	|ИЗ
	|	TS1 КАК TS1
	|ИТОГИ ПО
	|	Поставщик";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Калькуляция.НФ_ВыбранныеСтавки", "&НФ_ВыбранныеСтавки");
	//)
	//Евросиб - АСуслов 07.04.2022 19:22:28 #42899
	
	Запрос.УстановитьПараметр("НФ_ВыбранныеСтавки",Объект.НФ_ВыбранныеСтавки.Выгрузить());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаПоставщик = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПоставщик.Следующий() Цикл
	
		ВыборкаДетальныеЗаписи = ВыборкаПоставщик.Выбрать();
	
		// 4. ЗАПОЛНЕНИЕ ТАБЛИЦЫ СУММАМИ
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			// ищем нужного контрагента
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Контрагент",ВыборкаПоставщик.Поставщик);
			// Евросиб US 87896 TA 90558 Рыбьяков К.А. 11.09.2024 ((
			ПараметрыОтбора.Вставить("Порт", ВыборкаДетальныеЗаписи.ПортВыгрузкиОтгрузки);
			// Евросиб Рыбьяков К.А. 11.09.2024 ))
			НайденныеСтр = НФ_ЛинииПорты.НайтиСтроки(ПараметрыОтбора);
			
			ВБлокеВыбрано = Ложь;
			Для Каждого НС Из НайденныеСтр Цикл
				
				КодПорта = СокрЛП(ВыборкаДетальныеЗаписи.Порт.Код);
				
				СобственностьПеревозимогоКТК = ВыборкаДетальныеЗаписи.SOCCOC;
				НаименованиеКолонки = "НФ_ИмяПорта_" + СобственностьПеревозимогоКТК + "_" + КодПорта;
				НаименованиеКолонкиВыбрано = "НФ_ИмяПорта_Выбрано_" + СобственностьПеревозимогоКТК + "_" + КодПорта;
				НаименованиеКолонкиФлажок = "НФ_ИмяПорта_Флажок_" + СобственностьПеревозимогоКТК + "_" + КодПорта;

				ТекСтатья = СтрЗаменить(НС.Статья," ","");
				ТекСтатья = СтрЗаменить(ТекСтатья,"'","");
				
				Если НС.Свойство(НаименованиеКолонки) Тогда
					
					НС[НаименованиеКолонки] = ВыборкаДетальныеЗаписи[ТекСтатья];
					Если НЕ СтрНайти(ТекСтатья,"20") = 0 Тогда
						НС[НаименованиеКолонкиВыбрано] = ВыборкаДетальныеЗаписи.Выбрано20;
						НС[НаименованиеКолонкиФлажок] = ВыборкаДетальныеЗаписи.Выбрано20;
						ВБлокеВыбрано = ?(ВыборкаДетальныеЗаписи.Выбрано20,Истина,ВБлокеВыбрано);
					ИначеЕсли НЕ СтрНайти(ТекСтатья,"40") = 0 Тогда
						НС[НаименованиеКолонкиВыбрано] = ВыборкаДетальныеЗаписи.Выбрано40;
						НС[НаименованиеКолонкиФлажок] = ВыборкаДетальныеЗаписи.Выбрано40;
						ВБлокеВыбрано = ?(ВыборкаДетальныеЗаписи.Выбрано40,Истина,ВБлокеВыбрано);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуТарифами()
	
	// 3. получить ставки
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТарифыПоставщиков.Валюта КАК Валюта,
		|	ТарифыПоставщиков.Ссылка КАК ТекТариф,
		|	ТарифыПоставщиков.ПунктОтправленияУсловия КАК ПунктОтправленияУсловия,
		|	ТарифыПоставщиков.ПунктНазначенияУсловия КАК ПунктНазначенияУсловия,
		|	МорскиеЛинии.Ссылка КАК Поставщик,
		|	ТарифыПоставщиков.ПунктОтправления КАК ПунктОтправления,
		|	ТарифыПоставщиков.ПунктНазначения КАК ПунктНазначения,
		|	ТарифыПоставщиковРазмерыКТК.РазмерКТК КАК РазмерКТК,
		|	ВЫБОР
		// ДИТ 89973 Давудов М.А. Начало: 21.08.2024
		//ок(
		//|		КОГДА ТарифыПоставщиков.СобственностьПеревозимогоКТК = ЗНАЧЕНИЕ(Перечисление.СобственностьПеревозимогоКонтейнера.COC)
		//ок)
		|		КОГДА ТарифыПоставщиков.ПринадлежностьТЕ = ЗНАЧЕНИЕ(Перечисление.ПринадлежностьТЕ.КТЕвросиба)
		// ДИТ 89973 Давудов М.А. Конец: 21.08.2024
		|			ТОГДА ""COC""
		|		ИНАЧЕ ""SOC""
		|	КОНЕЦ КАК СобственностьПеревозимогоКТК
		|ИЗ
		|	Справочник.ТарифыПоставщиков КАК ТарифыПоставщиков
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТарифыПоставщиков.РазмерыКТК КАК ТарифыПоставщиковРазмерыКТК
		|		ПО (ТарифыПоставщиковРазмерыКТК.Ссылка = ТарифыПоставщиков.Ссылка)
		|			И (ТарифыПоставщиковРазмерыКТК.РазмерКТК В (&РазмерКТК))
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.МорскиеЛинии КАК МорскиеЛинии
		|		ПО ТарифыПоставщиков.Поставщик = МорскиеЛинии.Контрагент
		|ГДЕ
		|	ТарифыПоставщиков.ПунктОтправления В(&ПунктОтправления)
		|	И ТарифыПоставщиков.ПунктНазначения В(&ПунктНазначения)
		|	И ТарифыПоставщиков.Организация = &Организация
		|	И ТарифыПоставщиков.Поставщик В(&Поставщик)
		|	И &ДействиеТарифа МЕЖДУ ТарифыПоставщиков.НачалоДействия И ТарифыПоставщиков.ОкончаниеДействия
		|	И ВЫБОР
		|			КОГДА &Груженый
		|				ТОГДА ТарифыПоставщиков.ДляГруженых
		|			ИНАЧЕ ТарифыПоставщиков.ДляПорожних
		|		КОНЕЦ
		|	И ТарифыПоставщиков.Услуга = &Услуга
		|	И (ТарифыПоставщиков.ПунктОтправленияУсловия = &ПунктОтправленияУсловия
		|			ИЛИ &ПунктОтправленияУсловия = ЗНАЧЕНИЕ(Перечисление.УсловияПеревозкиПоПортам.ПустаяСсылка))
		|	И (ТарифыПоставщиков.ПунктНазначенияУсловия = &ПунктНазначенияУсловия
		|			ИЛИ ЗНАЧЕНИЕ(Перечисление.УсловияПеревозкиПоПортам.ПустаяСсылка) = &ПунктНазначенияУсловия)
		|ИТОГИ ПО
		|	Поставщик";
	
	Если Объект.ФрахтИмпорт Тогда
		Запрос.УстановитьПараметр("ПунктОтправления",Объект.НФ_ПортыОтправленияНазначения.Выгрузить().ВыгрузитьКолонку("Порт"));
		// Евросиб US 87896 TA 91708 Рыбьяков К.А. 16.09.2024 ((
		Запрос.УстановитьПараметр("ПунктНазначения", Объект.ММ_ПортыОтправленияНазначения.Выгрузить().ВыгрузитьКолонку("Порт"));
		//Запрос.УстановитьПараметр("ПунктНазначения",Объект.ММ_ПортОтправления);
	Иначе
		Запрос.УстановитьПараметр("ПунктОтправления", Объект.ММ_ПортыОтправленияНазначения.Выгрузить().ВыгрузитьКолонку("Порт"));
		//Запрос.УстановитьПараметр("ПунктОтправления",Объект.ММ_ПортОтправления);
		// Евросиб Рыбьяков К.А. 16.09.2024 ))
		Запрос.УстановитьПараметр("ПунктНазначения",Объект.НФ_ПортыОтправленияНазначения.Выгрузить().ВыгрузитьКолонку("Порт"));
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация",Объект.Организация);
	МассивЛиний = Новый Массив;
	Для Каждого СтрЛ Из Объект.НФ_Линии Цикл
		МассивЛиний.Добавить(СтрЛ.Линия.Контрагент);
	КонецЦикла;
	Запрос.УстановитьПараметр("ПунктОтправленияУсловия",Объект.Море_УсловияПогрузки);
	Запрос.УстановитьПараметр("ПунктНазначенияУсловия",Объект.Море_УсловияВыгрузки);
	Запрос.УстановитьПараметр("Поставщик",МассивЛиний);
	Запрос.УстановитьПараметр("ДействиеТарифа",Объект.ММ_ДействиеСтавокНа);
	Запрос.УстановитьПараметр("Груженый",Объект.ММ_ГруженыйПоМорю);
	Запрос.УстановитьПараметр("Услуга", УслугаФрахтаДляКалькуляции);
	МассивРазмеровКТК = Новый Массив;
	Если ТарифицируемыйРазмерКТК = "20" ИЛИ
		ТарифицируемыйРазмерКТК = "2040" Тогда
		МассивРазмеровКТК.Добавить(Справочники.РазмерыКТК.К20);
	КонецЕсли;
	Если ТарифицируемыйРазмерКТК = "40" ИЛИ
		ТарифицируемыйРазмерКТК = "2040" Тогда
		МассивРазмеровКТК.Добавить(Справочники.РазмерыКТК.К40);
	КонецЕсли;
	Запрос.УстановитьПараметр("РазмерКТК",МассивРазмеровКТК);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаПоставщик = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПоставщик.Следующий() Цикл
	
		ВыборкаДетальныеЗаписи = ВыборкаПоставщик.Выбрать();
	
		// 4. ЗАПОЛНЕНИЕ ТАБЛИЦЫ СУММАМИ
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			// ищем нужного контрагента
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Контрагент",ВыборкаПоставщик.Поставщик);
			НайденныеСтр = НФ_ЛинииПорты.НайтиСтроки(ПараметрыОтбора);
			
			Для Каждого НС Из НайденныеСтр Цикл
				
				Если Объект.ФрахтИмпорт Тогда
					КодПорта = СокрЛП(ВыборкаДетальныеЗаписи.ПунктОтправления.Код);
				Иначе
					КодПорта = СокрЛП(ВыборкаДетальныеЗаписи.ПунктНазначения.Код);
				КонецЕсли;
				СобственностьПеревозимогоКТК = ВыборкаДетальныеЗаписи.СобственностьПеревозимогоКТК;
				НаименованиеКолонки = "НФ_ИмяПорта_" + СобственностьПеревозимогоКТК + "_" + КодПорта;
				
				Если (ВыборкаДетальныеЗаписи.РазмерКТК = Справочники.РазмерыКТК.К20 И
					(Объект.ТарифицируемыйРазмерКТК = "20" ИЛИ Объект.ТарифицируемыйРазмерКТК = "2040") И
					(НС.Статья = Перечисления.СтатьяФрахта.Фрахт20 ИЛИ НС.Статья = Перечисления.СтатьяФрахта.Итого20)) ИЛИ
					
					(ВыборкаДетальныеЗаписи.РазмерКТК = Справочники.РазмерыКТК.К40 И
					(Объект.ТарифицируемыйРазмерКТК = "40" ИЛИ Объект.ТарифицируемыйРазмерКТК = "2040")  И
					(НС.Статья = Перечисления.СтатьяФрахта.Фрахт40 ИЛИ НС.Статья = Перечисления.СтатьяФрахта.Итого40)) Тогда
					
					
					НС[НаименованиеКолонки] = Тарификатор_сервер.ВычислитьСтоимостьПоТарифуДляОперации(Новый Структура,ВыборкаДетальныеЗаписи.ТекТариф);
					
				ИначеЕсли НС.Статья = Перечисления.СтатьяФрахта.Валюта Тогда
					
					НС[НаименованиеКолонки] = ВыборкаДетальныеЗаписи.Валюта;
				
				ИначеЕсли НС.Статья = Перечисления.СтатьяФрахта.Погрузка Тогда
					
					НС[НаименованиеКолонки] = ВыборкаДетальныеЗаписи.ПунктОтправленияУсловия;
				
				ИначеЕсли НС.Статья = Перечисления.СтатьяФрахта.Выгрузка Тогда
					
					НС[НаименованиеКолонки] = ВыборкаДетальныеЗаписи.ПунктНазначенияУсловия;
					
				КонецЕсли;
					
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура РасчетПодвалаФрахта()
	
	КолонкиТЗ = НФ_ЛинииПорты.Выгрузить().Колонки;
	
	//БИТ Белинский Д.А. 30.06.2023 -начало TASK 66201
		СуммаДельта20 = 0;
		СуммаДельта40 = 0;	
	//БИТ Белинский Д.А. 30.06.2023 -конец TASK 66201
	
	Для Каждого Кол Из КолонкиТЗ Цикл
		
		Минимально20 = 999999999999999.999;
		Минимально40 = 999999999999999.999;
		Максимально20 = 0;
		Максимально40 = 0;
		Колво20 = 0;
		Колво40 = 0;
		//БИТ Белинский Д.А. 30.06.2023 -начало TASK 66201
			Дельта20 = 0;
			Дельта40 = 0;	
		//БИТ Белинский Д.А. 30.06.2023 -конец TASK 66201
		
		Если (НЕ СтрНайти(Кол.Имя,"SOC") = 0 ИЛИ НЕ СтрНайти(Кол.Имя,"COC") = 0) И 
			СтрНайти(Кол.Имя,"Выбрано") = 0 И
			СтрНайти(Кол.Имя,"Флажок") = 0 Тогда
			ТекКолонка = Кол.Имя;
			Для Каждого СтрТз Из НФ_ЛинииПорты Цикл
				Если СтрТз.Статья = Перечисления.СтатьяФрахта.Фрахт20 И ЗначениеЗаполнено(СтрТз[ТекКолонка]) Тогда
					Минимально20 = Мин(Минимально20,СтрТз[ТекКолонка]);
					Максимально20 = Макс(Максимально20,СтрТз[ТекКолонка]);
					Колво20 = Колво20 + 1;
				КонецЕсли;
				Если СтрТз.Статья = Перечисления.СтатьяФрахта.Фрахт40 И ЗначениеЗаполнено(СтрТз[ТекКолонка]) Тогда
					Минимально40 = Мин(Минимально40,СтрТз[ТекКолонка]);
					Максимально40 = Макс(Максимально40,СтрТз[ТекКолонка]);
					Колво40 = Колво40 + 1;
				КонецЕсли;
			КонецЦикла;
		Иначе
			Продолжить;
		КонецЕсли;
		
		ПараметрыОтбора = новый Структура;
		
		// 20футовые
		Если Колво20>0 Тогда
			ПараметрыОтбора.Вставить("Контрагент","Минимум 20'");
			// Евросиб US 87896 TA 90558 Рыбьяков К.А. 09.09.2024 ((
			//ПараметрыОтбора.Вставить("Порт", "Минимум 20'");
			// Евросиб Рыбьяков К.А. 09.09.2024 ))
			НайдСтр = НФ_ЛинииПорты.НайтиСтроки(ПараметрыОтбора);
			Если НайдСтр.Количество()>0 Тогда
				НайдСтр[0][ТекКолонка] = Минимально20;
			КонецЕсли;
			
			ПараметрыОтбора.Вставить("Контрагент","Среднее 20'");
			НайдСтр = НФ_ЛинииПорты.НайтиСтроки(ПараметрыОтбора);
			Если НайдСтр.Количество()>0 Тогда
				Если Колво20>1 Тогда
					Дельта20 = (Максимально20 - Минимально20);
				Иначе
					Дельта20 = Макс(Максимально20, Минимально20);
				КонецЕсли;
				НайдСтр[0][ТекКолонка] = Окр(Дельта20/Колво20,3);
			КонецЕсли;
		
			ПараметрыОтбора.Вставить("Контрагент","Максимум 20'");
			НайдСтр = НФ_ЛинииПорты.НайтиСтроки(ПараметрыОтбора);
			Если НайдСтр.Количество()>0 Тогда
				НайдСтр[0][ТекКолонка] = Максимально20;
			КонецЕсли;
		КонецЕсли;
		
		// 40футовые
		Если Колво40>0 Тогда
			ПараметрыОтбора.Вставить("Контрагент","Минимум 40'");
			НайдСтр = НФ_ЛинииПорты.НайтиСтроки(ПараметрыОтбора);
			Если НайдСтр.Количество()>0 Тогда
				НайдСтр[0][ТекКолонка] = Минимально40;
			КонецЕсли;
		
			ПараметрыОтбора.Вставить("Контрагент","Среднее 40'");
			НайдСтр = НФ_ЛинииПорты.НайтиСтроки(ПараметрыОтбора);
			Если НайдСтр.Количество()>0 Тогда
				Если Колво40>1 Тогда
					Дельта40 = (Максимально40 - Минимально40);
				Иначе
					Дельта40 = Макс(Максимально40, Минимально40);
				КонецЕсли;
				НайдСтр[0][ТекКолонка] = Окр(Дельта40/Колво40,3);
			КонецЕсли;
		
			ПараметрыОтбора.Вставить("Контрагент","Максимум 40'");
			НайдСтр = НФ_ЛинииПорты.НайтиСтроки(ПараметрыОтбора);
			Если НайдСтр.Количество()>0 Тогда
				НайдСтр[0][ТекКолонка] = Максимально40;
			КонецЕсли;
		КонецЕсли;
		
		//БИТ Белинский Д.А. 30.06.2023 -начало TASK 66201
