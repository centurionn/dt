&НаКлиенте
Процедура ВставитьСтавки(SOCилиCOC)
	
	ПортыОтгрузкиВыгрузки = Новый Массив;
	ПортыОтправленияНазначения = Новый Массив;
	
	Для Каждого Строка Из Объект.НФ_ПортыОтгрузкиВыгрузки Цикл
		ПортыОтгрузкиВыгрузки.Добавить(Строка.Порт);
	КонецЦикла;
	
	Для Каждого Строка Из Объект.НФ_ПортыОтправленияНазначения Цикл
		ПортыОтправленияНазначения.Добавить(Строка.Порт);
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ПортыОтгрузкиВыгрузки", ПортыОтгрузкиВыгрузки);
	ПараметрыФормы.Вставить("ПортыОтправленияНазначения", ПортыОтправленияНазначения);
	ПараметрыФормы.Вставить("SOCилиCOC", SOCилиCOC);
		
	Если Объект.ФрахтИмпорт Тогда
		ПараметрыФормы.Вставить("ФрахтИмпорт", Истина);
	Иначе
		ПараметрыФормы.Вставить("ФрахтИмпорт", Ложь);
	КонецЕсли;
	
	// Евросиб US 115279 TA 115468 Рыбьяков К.А. 29.07.2025 ((
	Если Объект.ЕдиницаИзмерения = ПредопределенноеЗначение("Справочник.КлассификаторЕдиницИзмерения.teu") Тогда
		ПараметрыФормы.Вставить("ЕдиницаИзмеренияTEU");
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 20.08.2025 ))
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаЗагрузкиСтавок", ЭтаФорма, SOCилиCOC);
	
	ОткрытьФорму("Документ.Калькуляция.Форма.ФормаВставкиСтавокЗаФрахт",
		ПараметрыФормы,
		ЭтаФорма.УникальныйИдентификатор, 
		, 
		,
		,
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗагрузкиСтавок(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьДанныеТаблицыФрахтов(Результат, Параметры);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеТаблицыФрахтов(МассивДанных, SOCилиCOC)
	
	Таблица = НФ_ЛинииПорты.Выгрузить();
	
	ИмяКолонки = "НФ_ИмяПорта_" + SOCилиCOC + "_";
	
	Для Каждого Данные Из МассивДанных Цикл
		КодПорта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.ПортОтправленияНазначения, "Код");
		КодПорта = Строка(СокрЛП(КодПорта));
