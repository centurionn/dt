&НаКлиенте
Процедура ММ_КалькуляцияМультимодальнойЦепочкиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	//Евросиб Каблов 05.12.2025 ( Ticket#0422793
	//Так как при изменении происходит вызов сервера, при начале редактирования не вызывалась
	Отказ = Истина;
	
	ТекДанные = Элемент.ТекущиеДанные;
	
	НоваяСтрока = Объект.ММ_КалькуляцияМультимодальнойЦепочки.Добавить();
	
	Если Копирование Тогда
		Если ТекДанные <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекДанные);
		КонецЕсли;
	КонецЕсли;
	
	Элемент.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	
	ММ_КалькуляцияМультимодальнойЦепочкиПриИзменении(Элемент);
	
	ММ_КалькуляцияМультимодальнойЦепочкиПриНачалеРедактирования(Элемент, Истина, Копирование);
