Процедура ПовторнаяМаршрутизация(Команда)
	
	Если Объект.Маршрутизировать Тогда
		ПараметрыЗапроса = ПолучитьПараметрыМаршрутизацииНаСервере(Объект);
		РезультатЗапроса = МаршрутизацияСервер.МаршрутизироватьКалькуляцию(ПараметрыЗапроса, Объект.Дата);
		Если РезультатЗапроса.Количество() > 0 Тогда
			Отказ = ПроверитьУказатьОтветственных(РезультатЗапроса, Ложь);
		Иначе
			Сообщить("Для документа не найден подходящий маршрут. Изменения не внесены!");
		КонецЕсли;                               
		
		ОбновитьПанельСостояний();
		
	КонецЕсли;
	
