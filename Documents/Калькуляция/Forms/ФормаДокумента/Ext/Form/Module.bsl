&НаКлиенте
Процедура НФ_ЛинииПортыПередНачаломИзменения(Элемент, Отказ)
	
	ТекД = Элементы.НФ_ЛинииПорты.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ СтрНайти(Элемент.ТекущийЭлемент.Имя,"Выбрано") = 0 И
		(НЕ СтрНайти(Строка(ТекД.Статья),Строка("Валюта")) = 0 ИЛИ
		НЕ СтрНайти(Строка(ТекД.Статья),Строка("Погрузка")) = 0 ИЛИ
		НЕ СтрНайти(Строка(ТекД.Статья),Строка("Выгрузка")) = 0 ИЛИ
		НЕ СтрНачинаетсяС(Строка(ТекД.Контрагент),Строка("Минимум")) = 0 ИЛИ
		НЕ СтрНачинаетсяС(Строка(ТекД.Контрагент),Строка("Максимум")) = 0 ИЛИ
		НЕ СтрНачинаетсяС(Строка(ТекД.Контрагент),Строка("Среднее")) = 0) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

