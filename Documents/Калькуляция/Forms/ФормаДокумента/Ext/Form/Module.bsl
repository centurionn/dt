		ИначеЕсли Объект.ТипКалькуляции = ПредопределенноеЗначение("Перечисление.ТипыКалькуляций.КалькуляцияКомплекснойСтавки") Тогда
			ПС_РасчетнаяСтавкаПредоставленияСутки = (Объект.ПС_РасчетнаяСтавкаПредоставления - Объект.ПС_СтавкаГруженогоТарифа - Объект.ЖД_ТарифЗаПодсылПорожнейПлатформыБезНДС - Объект.ПС_ДопРасходыСуммаВВалютеДокумента ) / ОбщаяДлительность;
		КонецЕсли;
	КонецЕсли;
	
	море20Ставка = Объект.море20_Вознаграждение + Объект.море20_Себестоимость;
	море40Ставка = Объект.море40_Вознаграждение + Объект.море40_Себестоимость;
	
	ПолучитьРасчетнуюКонтрибуцию(); //Евросиб Шевченко А.В. 03.06.2025 US 97974 TA 111305
	ОформитьПоляСтавокКонтрибуции(); //Евросиб Шевченко А.В. 03.06.2025 US 97974 TA 111305
	
КонецПроцедуры

&НаКлиенте
Процедура ВознаграждениеПриИзменении(параметр1 = неопределено, параметр2 = неопределено)
	
	ТекД = Элементы.ММ_ТаблицаСтавокФрахт.ТекущиеДанные;
	Себестоимость = 0;
	ИмяРеквизитаСтавки = "";
	Для каждого Стр из параметр1.Родитель.ПодчиненныеЭлементы Цикл
		Если СтрНайти(Стр.Имя, "ЛинияУслуга") > 0 Тогда 
			Себестоимость = Себестоимость + ТекД[Стр.Имя];
		ИначеЕсли СтрНайти(Стр.Имя, "Ставка") > 0 Тогда 
			ИмяРеквизитаСтавки = Стр.Имя; 
		КонецЕсли;
	КонецЦикла;
	Если ИмяРеквизитаСтавки <> "" Тогда
		ТекД[ИмяРеквизитаСтавки] = Себестоимость + ТекД[параметр1.Имя];
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтавкаПриИзменении(параметр1 = неопределено, параметр2 = неопределено)
	
	ТекД = Элементы.ММ_ТаблицаСтавокФрахт.ТекущиеДанные;
	Себестоимость = 0;
	ИмяРеквизитаВознаграждение = "";
	Для каждого Стр из параметр1.Родитель.ПодчиненныеЭлементы Цикл
		Если СтрНайти(Стр.Имя, "ЛинияУслуга") > 0 Тогда 
			Себестоимость = Себестоимость + ТекД[Стр.Имя];
		ИначеЕсли СтрНайти(Стр.Имя, "Вознаграждение") > 0 Тогда 
			ИмяРеквизитаВознаграждение = Стр.Имя; 
		КонецЕсли;
	КонецЦикла;
	Если ИмяРеквизитаВознаграждение <> "" Тогда
		ТекД[ИмяРеквизитаВознаграждение] = ТекД[параметр1.Имя] - Себестоимость;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьНаправление_Кэш(ПунктОтправления, ПунктНазначения, Линия)
	
	Результат = неопределено;
	
	Для каждого стр из КэшНаправлений Цикл
		Если стр.ПунктОтправления = ПунктОтправления И стр.ПунктНазначения = ПунктНазначения И стр.Линия = Линия Тогда
			Результат = стр.Направление;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Результат = Неопределено Тогда
		Результат = ПолучитьНаправление(ПунктОтправления, ПунктНазначения, Линия);
		Если результат <> неопределено Тогда
			КэшНаправлений.Добавить(Новый Структура("ПунктОтправления, ПунктНазначения, Линия, Направление", ПунктОтправления, ПунктНазначения, Линия, Результат));
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПолучитьУслугу_Кэш(КодУслуги)
	
	Результат = КэшУслуг.Получить(КодУслуги);
	
	Если Результат = Неопределено Тогда
		Результат = Услуги_сервер.ПолучитьУслугуПоКоду(КодУслуги);
		КэшУслуг.Вставить(КодУслуги, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНаправление(ПунктОтправления, ПунктНазначения, Линия)
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	НаправленияФрахт.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.НаправленияФрахт КАК НаправленияФрахт
	               |ГДЕ
	               |	НаправленияФрахт.ПунктОтправления В ИЕРАРХИИ(&ПунктОтправления)
	               |	И НаправленияФрахт.ПунктНазначения В ИЕРАРХИИ(&ПунктНазначения)
	               |	И НаправленияФрахт.Линия.Код ПОДОБНО &Линия
	               |	И НЕ НаправленияФрахт.ПометкаУдаления";
	Запрос.УстановитьПараметр("ПунктОтправления", ПунктОтправления);
	Запрос.УстановитьПараметр("ПунктНазначения", ПунктНазначения);
	Запрос.УстановитьПараметр("Линия", Линия);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

