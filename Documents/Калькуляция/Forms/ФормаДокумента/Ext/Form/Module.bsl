		Если Стр.ОсновнаяУслугаГруппы = Ложь И ЗначениеЗаполнено(Стр.ГруппаУслуг) Тогда Продолжить; КонецЕсли;
		
		Если Объект.Валюта = Стр.Валюта Тогда
			ММ_СебестоимостьСуши = ММ_СебестоимостьСуши + Стр.Итого40;
		Иначе
			ПараметрыКурсаДокумента = ПараметрыКурса.Получить(Объект.Валюта);
			Если ПараметрыКурсаДокумента = неопределено Тогда
				ПараметрыКурсаДокумента = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Объект.Валюта, ?(ЗначениеЗаполнено(Объект.ДатаКурса), Объект.ДатаКурса, Объект.Дата));
