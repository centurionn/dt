&НаКлиенте
Процедура ПС_ДопРасходыВклВСтавкуСтавкаКлиентуПриИзменении(Элемент)
	
	ТекД = Элементы.ПС_ДопРасходыВклВСтавку.ТекущиеДанные;
	Если ТекД <> неопределено Тогда
		ТекД.Вознаграждение = ТекД.СтавкаКлиенту - ТекД.СуммаБезНДС;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРасчетнуюСтавку(Команда)
	
	Если Объект.ТипКалькуляции = ПредопределенноеЗначение("Перечисление.ТипыКалькуляций.ПредоставлениеПСБезТарифаГруженого") Тогда
		
		Если Объект.ПС_ТипСтавкиКлиенту = ПредопределенноеЗначение("Перечисление.ТипыСтавокКлиенту.ОтНормативнойСтавки") Тогда
			Объект.ПС_РасчетнаяСтавкаПредоставления = Объект.ЖД_ТарифЗаПодсылПорожнейПлатформыБезНДС + НормативнаяСтавкаПредоставленияПС * (Объект.ЖД_ПодсылПорожнейПлатформы + Объект.ЖД_Погрузка + Объект.ЖД_ДвижениеГруженый + Объект.ЖД_Выгрузка + Объект.ЖД_ВозвратПорожнейПлатформы);
		ИначеЕсли Объект.ПС_ТипСтавкиКлиенту = ПредопределенноеЗначение("Перечисление.ТипыСтавокКлиенту.РыночнаяСтавка") Тогда	
			Объект.ПС_РасчетнаяСтавкаПредоставления = Объект.ЖД_ТарифЗаПодсылПорожнейПлатформыБезНДС + Объект.ПС_СтавкаКлиентуРыночная * (Объект.ЖД_ПодсылПорожнейПлатформы + Объект.ЖД_Погрузка + Объект.ЖД_ДвижениеГруженый + Объект.ЖД_Выгрузка + Объект.ЖД_ВозвратПорожнейПлатформы);
		ИначеЕсли Объект.ПС_ТипСтавкиКлиенту = ПредопределенноеЗначение("Перечисление.ТипыСтавокКлиенту.ФормулаПрейскурант10_01") Тогда
			Объект.ПС_РасчетнаяСтавкаПредоставления = 0;
		КонецЕсли;
		
	ИначеЕсли Объект.ТипКалькуляции = ПредопределенноеЗначение("Перечисление.ТипыКалькуляций.КалькуляцияКомплекснойСтавки") Тогда
		
		Объект.ПС_ДопРасходыСуммаВВалютеДокумента = 0;
		Для каждого Стр из Объект.ПС_ДопРасходыВклВСтавку Цикл
			Объект.ПС_ДопРасходыСуммаВВалютеДокумента = Объект.ПС_ДопРасходыСуммаВВалютеДокумента + Валюта_сервер.ПересчитатьПоКурсу(Стр.СтавкаКлиенту, Стр.Валюта, Объект.Валюта, Объект.Дата);
		КонецЦикла;
		
		Если Объект.ПС_ТипСтавкиКлиенту = ПредопределенноеЗначение("Перечисление.ТипыСтавокКлиенту.ОтНормативнойСтавки") И Объект.ПС_ЕдиницаИзмерения = ПредопределенноеЗначение("Справочник.КлассификаторЕдиницИзмерения.вагон") Тогда
			Объект.ПС_РасчетнаяСтавкаПредоставления = Объект.ПС_СтавкаГруженогоТарифа + Объект.ЖД_ТарифЗаПодсылПорожнейПлатформыБезНДС + Объект.ПС_ДопРасходыСуммаВВалютеДокумента + НормативнаяСтавкаПредоставленияПС * (Объект.ЖД_ПодсылПорожнейПлатформы + Объект.ЖД_Погрузка + Объект.ЖД_ДвижениеГруженый + Объект.ЖД_Выгрузка + Объект.ЖД_ВозвратПорожнейПлатформы);
		ИначеЕсли Объект.ПС_ТипСтавкиКлиенту = ПредопределенноеЗначение("Перечисление.ТипыСтавокКлиенту.ОтНормативнойСтавки") И Объект.ПС_ЕдиницаИзмерения = ПредопределенноеЗначение("Справочник.КлассификаторЕдиницИзмерения.т") И ЗначениеЗаполнено(Объект.ПС_ФакторЦены_Вес) Тогда
			Объект.ПС_РасчетнаяСтавкаПредоставления = (Объект.ПС_СтавкаГруженогоТарифа + Объект.ЖД_ТарифЗаПодсылПорожнейПлатформыБезНДС + Объект.ПС_ДопРасходыСуммаВВалютеДокумента + НормативнаяСтавкаПредоставленияПС * (Объект.ЖД_ПодсылПорожнейПлатформы + Объект.ЖД_Погрузка + Объект.ЖД_ДвижениеГруженый + Объект.ЖД_Выгрузка + Объект.ЖД_ВозвратПорожнейПлатформы))/Объект.ПС_ФакторЦены_Вес;
		ИначеЕсли Объект.ПС_ТипСтавкиКлиенту = ПредопределенноеЗначение("Перечисление.ТипыСтавокКлиенту.РыночнаяСтавка") И Объект.ПС_ЕдиницаИзмерения = ПредопределенноеЗначение("Справочник.КлассификаторЕдиницИзмерения.вагон") Тогда	
			Объект.ПС_РасчетнаяСтавкаПредоставления = Объект.ПС_СтавкаГруженогоТарифа + Объект.ЖД_ТарифЗаПодсылПорожнейПлатформыБезНДС + Объект.ПС_ДопРасходыСуммаВВалютеДокумента + Объект.ПС_СтавкаКлиентуРыночная * (Объект.ЖД_ПодсылПорожнейПлатформы + Объект.ЖД_Погрузка + Объект.ЖД_ДвижениеГруженый + Объект.ЖД_Выгрузка + Объект.ЖД_ВозвратПорожнейПлатформы);
		ИначеЕсли Объект.ПС_ТипСтавкиКлиенту = ПредопределенноеЗначение("Перечисление.ТипыСтавокКлиенту.РыночнаяСтавка") И Объект.ПС_ЕдиницаИзмерения = ПредопределенноеЗначение("Справочник.КлассификаторЕдиницИзмерения.т") И ЗначениеЗаполнено(Объект.ПС_ФакторЦены_Вес) Тогда
			Объект.ПС_РасчетнаяСтавкаПредоставления = (Объект.ПС_СтавкаГруженогоТарифа + Объект.ЖД_ТарифЗаПодсылПорожнейПлатформыБезНДС + Объект.ПС_ДопРасходыСуммаВВалютеДокумента + Объект.ПС_СтавкаКлиентуРыночная * (Объект.ЖД_ПодсылПорожнейПлатформы + Объект.ЖД_Погрузка + Объект.ЖД_ДвижениеГруженый + Объект.ЖД_Выгрузка + Объект.ЖД_ВозвратПорожнейПлатформы))/Объект.ПС_ФакторЦены_Вес;
		Иначе
			Объект.ПС_РасчетнаяСтавкаПредоставления = 0;
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьИтоговыеПараметрыТаблиц(ВалютаИтогов);
	
КонецПроцедуры

