&НаКлиенте
Процедура БлокВалютыДокумента()
	
	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		
		Элементы.Валюта.ТолькоПросмотр = Истина;
		Если КонтрагентРезидент(Объект.Контрагент) Тогда
			Объект.Валюта = ПредопределенноеЗначение("Справочник.Валюты.Рубль");
		КонецЕсли;
		
	Иначе
		
		Элементы.Валюта.ТолькоПросмотр = Ложь;
		
	КонецЕсли;
	
