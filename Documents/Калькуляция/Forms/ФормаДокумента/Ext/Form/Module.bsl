&НаСервереБезКонтекста
Функция ПолучитьУслугуПоКатегорииДоговора(Договор)  
	
	Услуга = Справочники.Номенклатура.ПустаяСсылка();   
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КатегорииДоговоров.ОсновнаяНоменклатура КАК ОсновнаяНоменклатура
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КатегорииДоговоров КАК КатегорииДоговоров
	|		ПО ДоговорыКонтрагентов.КатегорияДоговора = КатегорииДоговоров.Ссылка
	|ГДЕ
	|	ДоговорыКонтрагентов.Ссылка = &Договор";    
	
	Запрос.УстановитьПараметр("Договор", Договор);   
	
	РезультатЗапроса = Запрос.Выполнить(); 
	
	Если Не РезультатЗапроса.Пустой() Тогда    
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Услуга = Выборка.ОсновнаяНоменклатура;
	КонецЕсли; 
	
	
	
	Возврат Услуга;
	
КонецФункции //ДИТ Авдеева В. 43126 04.04.2022 Конец 
	
