&НаКлиенте
Процедура ОтменаСогласования(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение <> КодВозвратаДиалога.Да Тогда
		Возврат; 
	КонецЕсли;
	
	Для Сч = 1 По Объект.Состояния.Количество()-1 Цикл
		
		Объект.Состояния[Сч].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Новый");
		Если ЗначениеЗаполнено(Объект.Состояния[Сч].СтатусСогласования) Тогда
			Объект.Состояния[Сч].СтатусСогласования = ПредопределенноеЗначение("Перечисление.СтатусыСогласования.Планируется");
		КонецЕсли;
		
	КонецЦикла;
	
	Если Объект.Состояния.Количество() > 0 Тогда
		Объект.Состояния[0].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.ВРаботе");
	КонецЕсли;
		
	ЗаписатьОтменуСогласования();

	ОбновитьПанельТекущегоПользователя();
	ОбновитьПанельСостояний();
	
	//ДИТ, Беляев СЮ, Ticket#0256571, ++ 
	//Возвращаем дефолтные настройки доступности формы
	ВременнаяФорма = ПолучитьФорму("Документ.Калькуляция.Форма.ФормаДокумента",Новый Структура("ДефолтныеНастройки", Истина),,Истина);        
	ЭлементыВременнойФормы = ВременнаяФорма.Элементы; 
	Для Каждого ЭлементФормы Из ЭтаФорма.Элементы Цикл        
		ИмяСвойстваБлокировкиЭлементаФормы = ПолучитьИмяСвойстваБлокировкиЭлементаФормы(ЭлементФормы);
		Если НЕ ЗначениеЗаполнено(ИмяСвойстваБлокировкиЭлементаФормы) Тогда
			Продолжить;
		КонецЕсли;
		НайденныйЭлемент = ЭлементыВременнойФормы.Найти(ЭлементФормы.Имя);
		Если НайденныйЭлемент = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ИмяСвойстваБлокировкиЭлементаФормы = "ТолькоПросмотр" Тогда
			Если ЭлементФормы.ТолькоПросмотр <> НайденныйЭлемент.ТолькоПросмотр Тогда
				ЭлементФормы.ТолькоПросмотр = НайденныйЭлемент.ТолькоПросмотр;
			КонецЕсли;
		Иначе
			Если ЭлементФормы.Доступность <> НайденныйЭлемент.Доступность Тогда
				ЭлементФормы.Доступность = НайденныйЭлемент.Доступность;
			КонецЕсли;		
		КонецЕсли;   	
	КонецЦикла;      
	//обработка требуемых блокировок
	ОбработатьБлокировкуЭлементовФормы();
	//ДИТ, Беляев СЮ, Ticket#0256571, --
КонецПроцедуры  

