&НаСервере
Процедура ПосчитатьСтрокуКалькуляцииЖДСервер(ТекСтрока)
	
	Если ТекСтрока = неопределено Тогда Возврат; КонецЕсли;
	
	ТекД = Объект.ММ_КалькуляцияМультимодальнойЦепочки.НайтиПоИдентификатору(ТекСтрока);
	
	СуммаНДСВключая20 = 0;
	СуммаНДСВключая40 = 0;
	Если текД.НДСВключенВСтоимость Тогда
		СуммаСтавки = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(ТекД.СтавкаНДС);
		СуммаНДСВключая20 = ТекД.Цена20  * СуммаСтавки / (100+СуммаСтавки);
		СуммаНДСВключая40 = ТекД.Цена40  * СуммаСтавки / (100+СуммаСтавки);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекД.Вознаграждение20) Тогда
		ТекД.СуммаВознаграждения20 = (ТекД.Цена20-СуммаНДСВключая20) * ТекД.Вознаграждение20 / 100;
	Иначе 
		//Евросиб Коханенко Н.А. 02.10.2023 (( #75712   
		Если ЭтоДирекцияКонтейнерныхПеревозок И ЭтоМежсервисныеРасходы() Тогда
			ТекД.СуммаВознаграждения20 = 0;
		КонецЕсли;                               
		//Евросиб Коханенко Н.А. 02.10.2023 )) #75712 
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекД.Вознаграждение40) Тогда
		ТекД.СуммаВознаграждения40 = (ТекД.Цена40-СуммаНДСВключая40) * ТекД.Вознаграждение40 / 100;
	Иначе
		//Евросиб Коханенко Н.А. 02.10.2023 (( #75712   
		Если ЭтоДирекцияКонтейнерныхПеревозок И ЭтоМежсервисныеРасходы() Тогда
			ТекД.СуммаВознаграждения40 = 0;
		КонецЕсли;                               
		//Евросиб Коханенко Н.А. 02.10.2023 )) #75712 
	КонецЕсли;
	
	//Евросиб Каблов 28.05.2025 ( #109346
	//ТекД.СуммаНДС20 = БухгалтерскийУчетОбщиеПроцедурыКлиент.ПолучитьСуммуНДС(ТекД.Цена20+ТекД.СуммаВознаграждения20, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(ТекД.СтавкаНДС), Истина, ТекД.НДСВключенВСтоимость);
	//ТекД.СуммаНДС40 = БухгалтерскийУчетОбщиеПроцедурыКлиент.ПолучитьСуммуНДС(ТекД.Цена40+ТекД.СуммаВознаграждения40, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(ТекД.СтавкаНДС), Истина, ТекД.НДСВключенВСтоимость);
	ТекД.СуммаНДС20 = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(ТекД.Цена20+ТекД.СуммаВознаграждения20, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(ТекД.СтавкаНДС), Истина, ТекД.НДСВключенВСтоимость);
	ТекД.СуммаНДС40 = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(ТекД.Цена40+ТекД.СуммаВознаграждения40, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(ТекД.СтавкаНДС), Истина, ТекД.НДСВключенВСтоимость);
	//Евросиб Каблов 28.05.2025 )
	
	ТекД.Итого20 = ТекД.СуммаВознаграждения20 + ТекД.Цена20 + ?(ТекД.НДСВключенВСтоимость, 0, ТекД.СуммаНДС20);
	ТекД.Итого40 = ТекД.СуммаВознаграждения40 + ТекД.Цена40 + ?(ТекД.НДСВключенВСтоимость, 0, ТекД.СуммаНДС40);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСебестоимостьПС()
	
	НСБПЛ = ПолучитьНормативнуюСебестоимостьПлатформы(Объект.Дата, Объект.Валюта, Объект.ЖД_РасчетСебестоимостиДляТипаФГП);
	НормативнаяСтавкаПредоставленияПС = ПолучитьНормативнуюСебестоимостьПлатформы(Объект.Дата, Объект.Валюта, Объект.ЖД_РасчетСебестоимостиДляТипаФГП, ПредопределенноеЗначение("Перечисление.ТипНормативнойСтавкиВагона.КлиентскаяСтавка"));
	
	СТРАСПР = ПолучитьСтатистикуРаспределения(Объект.ЖД_ПериодСбораСтатистикиРаспределенияНачало, Объект.ЖД_ПериодСбораСтатистикиРаспределенияОкончание);
	ЖД_СреднийПроцентСороковок = СТРАСПР.Для40;
	ЖД_СредняяЗагрузкаПлатформСтатистика = СТРАСПР.СредняяЗагрузка;
	Попытка
		Если НЕ ЗначениеЗаполнено(Объект.ЖД_СредняяЗагрузкаПлатформ) тогда
			Объект.ЖД_СредняяЗагрузкаПлатформ = ЖД_СредняяЗагрузкаПлатформСтатистика;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.ЖД_СреднийПроцентСороковок) Тогда
			Объект.ЖД_СреднийПроцентСороковок = ЖД_СреднийПроцентСороковок;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	ЖД_СебестоимостьПредоставленияПС.Очистить();
	НСтр = ЖД_СебестоимостьПредоставленияПС.Добавить();
	НСтр.Статья = "Мин. загрузка 1 кт/пл";
	НСтр.Для20 = (НСБПЛ * ЖД_ИтогоВИспользовании) + Объект.ЖД_ТарифЗаПодсылПорожнейПлатформыБезНДС + Объект.ЖД_ТарифЗаВозвратПорожнейПлатформыПослеВыгрузкиБезНДС;
	НСтр.Для40 = НСтр.Для20;
	
	НСтр2 = ЖД_СебестоимостьПредоставленияПС.Добавить();
	НСтр2.Статья = "Макс. загрузка";
	НСтр2.Для20 = НСтр.Для20/4;
	НСтр2.Для40 = НСтр.Для20/2;
	
	НСтр3 = ЖД_СебестоимостьПредоставленияПС.Добавить();
	НСтр3.Статья = "Средняя загрузка";
	Если (100-Объект.ЖД_СреднийПроцентСороковок) > 0 Тогда
		НСтр3.Для20 = НСтр2.Для20 / ((100-Объект.ЖД_СреднийПроцентСороковок) * 0.01);
	КонецЕсли;
	Если Объект.ЖД_СреднийПроцентСороковок > 0 Тогда
		НСтр3.Для40 = НСтр2.Для40 / (Объект.ЖД_СреднийПроцентСороковок * 0.01);
	КонецЕсли;
	
	НСтр4 = ЖД_СебестоимостьПредоставленияПС.Добавить();
	НСтр4.Статья = "Предоставление ПС (расчет)";
	Если Объект.ЖД_СредняяЗагрузкаПлатформ > 0 Тогда
		НСтр4.Для20 = НСтр2.Для20 / (Объект.ЖД_СредняяЗагрузкаПлатформ * 0.01);
		НСтр4.Для40 = НСтр2.Для40 / (Объект.ЖД_СредняяЗагрузкаПлатформ * 0.01);
	КонецЕсли;
	
	Если ЖД_ИтогоВИспользовании > 0 Тогда
		Попытка
			ДоходностьПлатформыСтатистика = (((Объект.ЖД_Вознаграждение20 + НСтр4.Для20) * (1 - Объект.ЖД_СреднийПроцентСороковок/100) + (Объект.ЖД_Вознаграждение40 + НСтр4.Для40) * (Объект.ЖД_СреднийПроцентСороковок/100)) * ПолучитьКоэффициентТипаФГП(Объект.ЖД_РасчетДляКТКРазмер) / ((1 - Объект.ЖД_СреднийПроцентСороковок/100) + Объект.ЖД_СреднийПроцентСороковок/100 * 2 )) * (Объект.ЖД_СредняяЗагрузкаПлатформ/100) - (Объект.ЖД_ТарифЗаПодсылПорожнейПлатформыБезНДС + Объект.ЖД_ТарифЗаВозвратПорожнейПлатформыПослеВыгрузкиБезНДС);
			ЖД_ДоходностьПлатформыВСутки = ДоходностьПлатформыСтатистика / ЖД_ИтогоВИспользовании;	
		Исключение
			ДоходностьПлатформыСтатистика = 0;
			ЖД_ДоходностьПлатформыВСутки = 0;
		КонецПопытки;
	КонецЕсли;
	

	
КонецПроцедуры

