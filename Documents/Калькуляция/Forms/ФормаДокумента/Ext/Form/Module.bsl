	Если Параметр1 = неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	Для Каждого Стр Из Параметр1 Цикл
		НовСтр = Объект.Состояния.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,Стр);		
	КонецЦикла;
	Параметры.СохранитьДанныеСостояний = Истина;
	
	СтруктураЗаписиДанных = Новый СТруктура;
	СтруктураЗаписиДанных.Вставить("СостоянияИзменены",Истина);
	
	Записать(СтруктураЗаписиДанных);

КонецПроцедуры

&НаСервере
Функция ПроверитьНеобходимостьМаршрутизации()

	//ДляДанногоОбъектаТребуетсяПеремаршрутизация = //Ссылка.ПС_ВидПеревозки <> ПС_ВидПеревозки;
	//НЕ ЗначениеЗаполнено(Объект.Ссылка) ИЛИ 
	//Объект.Ссылка.Организация <> Объект.Организация ИЛИ 
	//Объект.Ссылка.Контрагент <> Объект.Контрагент ИЛИ
	//Объект.Ссылка.Договор <> Объект.Договор ИЛИ
	//Объект.Ссылка.ПС_ВидПеревозки <> Объект.ПС_ВидПеревозки ИЛИ
	//Объект.Ссылка.ММ_ИтогоРентабельность <> Объект.ММ_ИтогоРентабельность ИЛИ
	//Объект.Ссылка.ММ_ИтогоРентабельность20 <> Объект.ММ_ИтогоРентабельность20 ИЛИ
	//Объект.Ссылка.РежимКалькуляции <> Объект.РежимКалькуляции ИЛИ Объект.Состояния.Количество() = 0;
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		РеквизитыКалькуляции = "Организация, Контрагент, Договор, ПС_ВидПеревозки, ММ_ИтогоРентабельность, ММ_ИтогоРентабельность20, ЖД_ПринадлежностьПС, ТипКалькуляции";
		ЗначенияРеквизитовКалькуляцииСсылка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Ссылка, РеквизитыКалькуляции);
		ЗначенияРеквизитовКалькуляцииОбъект = Новый Структура(РеквизитыКалькуляции);
		ЗаполнитьЗначенияСвойств(ЗначенияРеквизитовКалькуляцииОбъект, Объект)
	КонецЕсли;
	ДляДанногоОбъектаТребуетсяПеремаршрутизация = Не ЗначениеЗаполнено(Объект.Ссылка) 
									ИЛИ Не ОбщегоНазначения.КоллекцииИдентичны(ЗначенияРеквизитовКалькуляцииОбъект, ЗначенияРеквизитовКалькуляцииСсылка)
									ИЛИ Объект.Состояния.Количество() = 0;
	
	Возврат ДляДанногоОбъектаТребуетсяПеремаршрутизация;
	
КонецФункции

