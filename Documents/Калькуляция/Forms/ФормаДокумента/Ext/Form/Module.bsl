	               |	И ТарифыПоставщиковТаблицаСтоимость.СчитатьСверхнормативом
	               |	И НЕ ТарифыПоставщиковТаблицаСтоимость.Ссылка.ПометкаУдаления";
	Запрос.УстановитьПараметр("ПериодДействия", Объект.Дата);
	Запрос.УстановитьПараметр("Ссылка", МассивТарифовСверхнорматива40);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		НСтр = Объект.ЖД_УслугиПоСверхнормативам.Добавить();
		ЗаполнитьЗначенияСвойств(НСтр, Ответ);
		НСтр.ВидРасходов = ВидРасходовСоответствие[НСтр.Тариф40];
		
