Функция ПолучитьНормативнуюСебестоимостьПлатформы(ДатаДока, ВалютаДока, ТипПлатформы, Знач ВидСтавки = неопределено)
	
	Если ВидСтавки = неопределено Тогда
		ВидСтавки = Перечисления.ТипНормативнойСтавкиВагона.Себестоимость;
	КонецЕсли;
	
	Результат = 0;
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	НормативныеСтавкиВагонов.СтавкаНаПредоставление КАК СтавкаНаПредоставление,
	               |	НормативныеСтавкиВагонов.Валюта КАК Валюта
	               |ИЗ
	               |	Справочник.НормативныеСтавкиВагонов КАК НормативныеСтавкиВагонов
	               |ГДЕ
	               |	НЕ НормативныеСтавкиВагонов.ПометкаУдаления
	               |	И НормативныеСтавкиВагонов.ТипВагона = &ТипВагона
	               |	И НормативныеСтавкиВагонов.ВидСтавки = &ВидСтавки
	               |	И &ТекДата МЕЖДУ НормативныеСтавкиВагонов.НачалоДействия И НормативныеСтавкиВагонов.ОкончаниеДействия";
	Запрос.УстановитьПараметр("ТипВагона", ТипПлатформы);
	Запрос.УстановитьПараметр("ВидСтавки", ВидСтавки);
	Запрос.УстановитьПараметр("ТекДата", ДатаДока);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		
		Результат = Валюта_сервер.ПересчитатьПоКурсу(Ответ.СтавкаНаПредоставление, Ответ.Валюта, ВалютаДока, ДатаДока);
		
	КонецЕсли;
	
	Возврат Результат;
	
