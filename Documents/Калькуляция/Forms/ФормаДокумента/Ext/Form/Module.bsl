&НаКлиенте
Процедура ОбновитьФлажкиСтавок(КодПоиска, ВыбраннаяСтатья = Неопределено)
	
	ТекущиеДанные = Элементы.НФ_ЛинииПорты.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	Иначе
		Статья = ВыбраннаяСтатья;
	КонецЕсли;
	
	РазмерностьКТК = ?(СтрНайти(ТекущиеДанные.Статья, "20") = 0, Строка("40"), Строка("20"));
	Статья = ТекущиеДанные.Статья;
	
	ТекКолонка = СтрЗаменить(КодПоиска, "Выбрано", "Флажок");
	ТекИмяПорта = СтрЗаменить(КодПоиска, "Выбрано_", "");
	ТекКолонкаВыбрано = КодПоиска;
	
	СтатьяПодбора = Неопределено;
	Если Статья = ПредопределенноеЗначение("Перечисление.СтатьяФрахта.Вознаграждение20") Тогда
		СтатьяПодбора = ПредопределенноеЗначение("Перечисление.СтатьяФрахта.Фрахт20")
	ИначеЕсли Статья = ПредопределенноеЗначение("Перечисление.СтатьяФрахта.Вознаграждение40") Тогда
		СтатьяПодбора = ПредопределенноеЗначение("Перечисление.СтатьяФрахта.Фрахт40")
	ИначеЕсли Статья = ПредопределенноеЗначение("Перечисление.СтатьяФрахта.Фрахт20") Тогда
		СтатьяПодбора = ПредопределенноеЗначение("Перечисление.СтатьяФрахта.Вознаграждение20")
	ИначеЕсли Статья = ПредопределенноеЗначение("Перечисление.СтатьяФрахта.Фрахт40") Тогда
		СтатьяПодбора = ПредопределенноеЗначение("Перечисление.СтатьяФрахта.Вознаграждение40")
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Контрагент", ТекущиеДанные.Контрагент);
	ПараметрыОтбора.Вставить("Порт", ТекущиеДанные.Порт);
	ПараметрыОтбора.Вставить("Статья", СтатьяПодбора);
	НайденныеСтроки = НФ_ЛинииПорты.НайтиСтроки(ПараметрыОтбора);
	
	Если ТекущиеДанные[ТекКолонка] = Ложь Тогда
		//Для Каждого Строка Из НайденныеСтроки Цикл
		//	Если СтрНайти(Строка.Статья, РазмерностьКТК) <> 0 Тогда
		//		Строка[ТекКолонка] = Ложь;
		//		Строка[ТекКолонкаВыбрано] = Ложь;
		//	КонецЕсли;
		//КонецЦикла;
	Иначе
		//Для Каждого Строка Из НайденныеСтроки Цикл
		//	Если СтрНайти(Строка.Статья, РазмерностьКТК) <> 0 Тогда
		//		Строка[ТекКолонка] = Истина;
		//		Строка[ТекКолонкаВыбрано] = Истина;
		//		Если ПроверитьВторуюСтроку И ВведенноеЗначение <> 0 И СтрНайти(Строка.Статья, "Итог") = 0 Тогда
		//			ПоставитьФлажокИтого = ПоставитьФлажокИтого + 1;
		//		КонецЕсли;
		//	КонецЕсли;
		//КонецЦикла;
		Если НайденныеСтроки.Количество() > 0 Тогда
			Если НайденныеСтроки[0][ТекИмяПорта] <> 0 И НайденныеСтроки[0][ТекКолонка] = Истина Тогда
				Если РазмерностьКТК = "20" Тогда
					СтатьяПодбора = ПредопределенноеЗначение("Перечисление.СтатьяФрахта.Итого20");
				Иначе	
					СтатьяПодбора = ПредопределенноеЗначение("Перечисление.СтатьяФрахта.Итого40");
				КонецЕсли;
				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("Контрагент", ТекущиеДанные.Контрагент);
				ПараметрыОтбора.Вставить("Порт", ТекущиеДанные.Порт);
				ПараметрыОтбора.Вставить("Статья", СтатьяПодбора);
				НайденныеСтроки = НФ_ЛинииПорты.НайтиСтроки(ПараметрыОтбора);
				НайденныеСтроки[0][ТекКолонка] = Истина;
				НайденныеСтроки[0][ТекКолонкаВыбрано] = Истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

