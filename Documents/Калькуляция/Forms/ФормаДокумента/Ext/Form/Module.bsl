							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				Если ФрахтЗаполнен Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		КлючевыеПараметрыПродукта["ФрахтЗаполнен"] = ФрахтЗаполнен;
	КонецЕсли;
	
	//условия наличия услуг в табл.1.3
	Если Все ИЛИ РеквизитИмя = "ММ_КалькуляцияМультимодальнойЦепочки" Тогда 
		УслугиТарифГруженыйЖД = Ложь;
		УслугаПредоставлениеКТК = Ложь;
		УслугаТерминальнаяОбработкаПерегрузНСК = Ложь;
		Для Каждого СтрокаТЧ Из Объект.ММ_КалькуляцияМультимодальнойЦепочки Цикл
			Если СтрокаТЧ.Услуга = Справочники.Номенклатура.ГруженыйЖДтарифРФ 
					ИЛИ СтрокаТЧ.Услуга = Справочники.Номенклатура.ГруженыйЖДтарифПрочТерритории Тогда
				УслугиТарифГруженыйЖД = Истина;
			ИначеЕсли СтрокаТЧ.Услуга = Справочники.Номенклатура.ПредоставлениеКТК Тогда 
				УслугаПредоставлениеКТК = Истина;
			ИначеЕсли СтрокаТЧ.Услуга = Справочники.Номенклатура.ТерминальнаяОбработкаПерегрузНСК Тогда 
				УслугаТерминальнаяОбработкаПерегрузНСК = Истина;
			КонецЕсли;
		КонецЦикла;
		КлючевыеПараметрыПродукта["УслугиТарифГруженыйЖД"] = УслугиТарифГруженыйЖД;
		КлючевыеПараметрыПродукта["УслугаПредоставлениеКТК"] = УслугаПредоставлениеКТК;
		КлючевыеПараметрыПродукта["УслугаТерминальнаяОбработкаПерегрузНСК"] = УслугаТерминальнаяОбработкаПерегрузНСК;
	КонецЕсли;
	
	//условия ТипКалькуляции
	Если Все ИЛИ РеквизитИмя = "РежимКалькуляции" Тогда 
		ОбъектТипКалькуляции = Объект.ТипКалькуляции;
		
		Если ОбъектТипКалькуляции = Перечисления.ТипыКалькуляций.Мультимодальная Тогда
			ТипКалькуляцииММ = Истина;
		Иначе
			ТипКалькуляцииММ = Ложь;
		КонецЕсли;
		
		Если ОбъектТипКалькуляции = Перечисления.ТипыКалькуляций.КонтейнерныйПоезд Тогда
			ТипКалькуляцииКонтейнерныйПоезд = Истина;
		Иначе
			ТипКалькуляцииКонтейнерныйПоезд = Ложь;
		КонецЕсли;

		Если ОбъектТипКалькуляции = Перечисления.ТипыКалькуляций.РефрижераторныеПеревозки Тогда
			ТипКалькуляцииРефПеревозки = Истина;
		Иначе
			ТипКалькуляцииРефПеревозки = Ложь;
		КонецЕсли;

		Если ОбъектТипКалькуляции = Перечисления.ТипыКалькуляций.Доплатные Тогда
			ТипКалькуляцииДоплатныеКТК = Истина;
		Иначе
			ТипКалькуляцииДоплатныеКТК = Ложь;
		КонецЕсли;

		Если ОбъектТипКалькуляции = Перечисления.ТипыКалькуляций.ПредоставлениеПСБезТарифаГруженого Тогда
			ТипКалькуляцииПредоставлениеПСБезТарифа = Истина;
			//при смене Типа калькуляции изменяется значение Типа заказа, поэтому пересчитаем и по нему
			ПересчитатьТипЗаказа = Истина;
		Иначе
			ТипКалькуляцииПредоставлениеПСБезТарифа = Ложь;
		КонецЕсли;

		Если ТипКалькуляцииММ 
				ИЛИ ТипКалькуляцииКонтейнерныйПоезд Тогда
			ТипКалькуляцииММИлиКонтейнерныйПоезд = Истина;
		Иначе
			ТипКалькуляцииММИлиКонтейнерныйПоезд = Ложь;
		КонецЕсли;           
		
		//Евросиб Коханенко Н.А. 24.03.2025 (( #105705
		Если ОбъектТипКалькуляции = Перечисления.ТипыКалькуляций.Субсидии 
				ИЛИ ОбъектТипКалькуляции = Перечисления.ТипыКалькуляций.Премии Тогда
			ТипКалькуляцииСубсидииПремии = Истина;
		Иначе
			ТипКалькуляцииСубсидииПремии = Ложь;
		КонецЕсли;           
		
		Если ОбъектТипКалькуляции = Перечисления.ТипыКалькуляций.МежсервисныеРасходы 
				ИЛИ ОбъектТипКалькуляции = Перечисления.ТипыКалькуляций.МежсервисныеРасходыРеф Тогда
			ТипКалькуляцииМежсервисныеРасходы = Истина;
		Иначе
			ТипКалькуляцииМежсервисныеРасходы = Ложь;
		КонецЕсли;  
		КлючевыеПараметрыПродукта["ТипКалькуляцииСубсидииПремии"] = ТипКалькуляцииСубсидииПремии;
		КлючевыеПараметрыПродукта["ТипКалькуляцииМежсервисныеРасходы"] = ТипКалькуляцииМежсервисныеРасходы;
		//Евросиб Коханенко Н.А. 24.03.2025 )) #105705
		
		//Евросиб Коханенко Н.А. 01.08.2025 (( #115687
		Если ОбъектТипКалькуляции = Перечисления.ТипыКалькуляций.ДоплатныеПВ Тогда
			ТипКалькуляцииДоплатныеПВ = Истина;
		Иначе
			ТипКалькуляцииДоплатныеПВ = Ложь;
		КонецЕсли;
		КлючевыеПараметрыПродукта["ТипКалькуляцииДоплатныеПВ"] = ТипКалькуляцииДоплатныеПВ;
		//Евросиб Коханенко Н.А. 01.08.2025 )) #115687 

		КлючевыеПараметрыПродукта["ТипКалькуляцииММ"] = ТипКалькуляцииММ;
		КлючевыеПараметрыПродукта["ТипКалькуляцииКонтейнерныйПоезд"] = ТипКалькуляцииКонтейнерныйПоезд;
		КлючевыеПараметрыПродукта["ТипКалькуляцииРефПеревозки"] = ТипКалькуляцииРефПеревозки;
		КлючевыеПараметрыПродукта["ТипКалькуляцииДоплатныеКТК"] = ТипКалькуляцииДоплатныеКТК;
		КлючевыеПараметрыПродукта["ТипКалькуляцииПредоставлениеПСБезТарифа"] = ТипКалькуляцииПредоставлениеПСБезТарифа;
		КлючевыеПараметрыПродукта["ТипКалькуляцииММИлиКонтейнерныйПоезд"] = ТипКалькуляцииММИлиКонтейнерныйПоезд;
		
		//при смене Типа калькуляции изменяется значение Учетного направления, поэтому пересчитаем и по нему
		ПересчитатьУчетноеНаправление = Истина;
 	КонецЕсли;

	//условия УчетноеНаправление
	Если Все ИЛИ РеквизитИмя = "УчетноеНаправление" ИЛИ ПересчитатьУчетноеНаправление Тогда 
		ОбъектУчетноеНаправление = Объект.УчетноеНаправление;
		
		Если ОбъектУчетноеНаправление = Справочники.УчетныеНаправления.ИмпортМорской Тогда
			УчНаправлениеИмпортМорской = Истина;
		Иначе
			УчНаправлениеИмпортМорской = Ложь;
		КонецЕсли;
		
		Если ОбъектУчетноеНаправление = Справочники.УчетныеНаправления.ЭкспортМорской
				ИЛИ УчНаправлениеИмпортМорской Тогда
			УчНаправлениеМорской = Истина;
		Иначе
			УчНаправлениеМорской = Ложь;
		КонецЕсли;
			
		Если ОбъектУчетноеНаправление = Справочники.УчетныеНаправления.ИмпортСухопутный
				ИЛИ ОбъектУчетноеНаправление = Справочники.УчетныеНаправления.ЭкспортСухопутный
				ИЛИ ОбъектУчетноеНаправление = Справочники.УчетныеНаправления.Транзит Тогда
			УчНаправлениеСухопутныйИлиТранзит = Истина;
		Иначе
			УчНаправлениеСухопутныйИлиТранзит = Ложь;
		КонецЕсли;
		
		Если ОбъектУчетноеНаправление = Справочники.УчетныеНаправления.РефрижераторныеПеревозки Тогда
	        УчНаправлениеРефПеревозки = Истина;
		Иначе
	        УчНаправлениеРефПеревозки = Ложь;
		КонецЕсли;
		КлючевыеПараметрыПродукта["УчНаправлениеИмпортМорской"] = УчНаправлениеИмпортМорской;
		КлючевыеПараметрыПродукта["УчНаправлениеМорской"] = УчНаправлениеМорской;
		КлючевыеПараметрыПродукта["УчНаправлениеСухопутныйИлиТранзит"] = УчНаправлениеСухопутныйИлиТранзит;
		КлючевыеПараметрыПродукта["УчНаправлениеРефПеревозки"] = УчНаправлениеРефПеревозки;
	КонецЕсли;

	//условия ТипЗаказа 
	Если Все ИЛИ РеквизитИмя = "ТипЗаказа" ИЛИ ПересчитатьТипЗаказа Тогда 
		ОбъектТипЗаказа = Объект.ТипЗаказа;
		
		Если ОбъектТипЗаказа = Справочники.ТипыЗаказов.КонтейнерныйПоезд Тогда
		    ТипЗаказаКонтейнерныйПоезд = Истина;
		Иначе	
		    ТипЗаказаКонтейнерныйПоезд = Ложь; 
		КонецЕсли;
		
		Если ОбъектТипЗаказа = Справочники.ТипыЗаказов.ПоконтейнернаяОтправка Тогда
		    ТипЗаказаПоконтейнернаяОтправка = Истина;
		Иначе	
		    ТипЗаказаПоконтейнернаяОтправка = Ложь;
		КонецЕсли;
		
		Если ТипЗаказаКонтейнерныйПоезд
				ИЛИ ТипЗаказаПоконтейнернаяОтправка Тогда
			ТипЗаказаКонтейнерныйПоездИлиПоконтейнернаяОтправка = Истина;
		Иначе	
		    ТипЗаказаКонтейнерныйПоездИлиПоконтейнернаяОтправка = Ложь;
		КонецЕсли;
		Если ОбъектТипЗаказа = Справочники.ТипыЗаказов.ПовагоннаяОтправка Тогда
		    ТипЗаказаПредоставлениеВагонов = Истина; 
		Иначе	
		    ТипЗаказаПредоставлениеВагонов = Ложь;
		КонецЕсли;
		
		Если ОбъектТипЗаказа = Справочники.ТипыЗаказов.Автоперевозка Тогда
		    ТипЗаказаАвтоперевозка = Истина;
		Иначе	
		    ТипЗаказаАвтоперевозка = Ложь;
		КонецЕсли;
		КлючевыеПараметрыПродукта["ТипЗаказаКонтейнерныйПоезд"] = ТипЗаказаКонтейнерныйПоезд;
		КлючевыеПараметрыПродукта["ТипЗаказаПоконтейнернаяОтправка"] = ТипЗаказаПоконтейнернаяОтправка;
		КлючевыеПараметрыПродукта["ТипЗаказаКонтейнерныйПоездИлиПоконтейнернаяОтправка"] = ТипЗаказаКонтейнерныйПоездИлиПоконтейнернаяОтправка;
		КлючевыеПараметрыПродукта["ТипЗаказаПредоставлениеВагонов"] = ТипЗаказаПредоставлениеВагонов;
		КлючевыеПараметрыПродукта["ТипЗаказаАвтоперевозка"] = ТипЗаказаАвтоперевозка;
	КонецЕсли;

	//условия ОсновнаяУслуга
	Если Все ИЛИ РеквизитИмя = "ОсновнаяУслуга" Тогда 
		ОбъектОсновнаяУслуга = Объект.ОсновнаяУслуга;
	 
		 Если ОбъектОсновнаяУслуга = Справочники.Номенклатура.ТЭУ Тогда
		    ОсновнаяУслугаТЭУ = Истина;
		Иначе	
		    ОсновнаяУслугаТЭУ = Ложь;
		КонецЕсли;
		
		Если ОбъектОсновнаяУслуга = Справочники.Номенклатура.Фрахт Тогда
		    ОсновнаяУслугаФрахт = Истина;
		Иначе	
		    ОсновнаяУслугаФрахт = Ложь;
		КонецЕсли;
		КлючевыеПараметрыПродукта["ОсновнаяУслугаТЭУ"] = ОсновнаяУслугаТЭУ;
		КлючевыеПараметрыПродукта["ОсновнаяУслугаФрахт"] = ОсновнаяУслугаФрахт;
	КонецЕсли;

	//Условие Погранпереход
	Если Все ИЛИ РеквизитИмя = "Суша_ПунктОтправления" 
			 ИЛИ РеквизитИмя = "Суша_ПунктНазначения" 
			 ИЛИ РеквизитИмя = "СписокСтанцийОтправления" 
			 ИЛИ РеквизитИмя = "СписокСтанцийНазначения" Тогда 
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЛокацииПунктов.Значение КАК Локация
			|ПОМЕСТИТЬ вт_СписокСтанцийНазначения
			|ИЗ
			|	&СписокСтанцийНазначения КАК ЛокацииПунктов
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЛокацииПунктов.Значение КАК Локация
			|ПОМЕСТИТЬ вт_СписокСтанцийОтправления
			|ИЗ
			|	&СписокСтанцийОтправления КАК ЛокацииПунктов
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	&ПунктНазначения КАК Локация
			|ПОМЕСТИТЬ вт_Локации
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ
			|	&ПунктОтправления
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ
			|	вт_СписокСтанцийНазначения.Локация
			|ИЗ
			|	вт_СписокСтанцийНазначения КАК вт_СписокСтанцийНазначения
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ
			|	вт_СписокСтанцийОтправления.Локация
			|ИЗ
			|	вт_СписокСтанцийОтправления КАК вт_СписокСтанцийОтправления
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Локации.Наименование КАК Наименование,
			|	Локации.Погранпереход КАК Погранпереход
			|ИЗ
			|	вт_Локации КАК вт_Локации
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Локации КАК Локации
			|		ПО вт_Локации.Локация = Локации.Ссылка
			|ГДЕ
			|	Локации.Погранпереход = ИСТИНА";
		
		Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
		Запрос.УстановитьПараметр("ПунктНазначения", Объект.Суша_ПунктНазначения);
		Запрос.УстановитьПараметр("ПунктОтправления", Объект.Суша_ПунктОтправления);
		Запрос.УстановитьПараметр("СписокСтанцийНазначения", СписокСтанцийНазначения);
		Запрос.УстановитьПараметр("СписокСтанцийОтправления", СписокСтанцийОтправления);
		РезультатЗапроса = Запрос.Выполнить();
		Погранпереход = НЕ РезультатЗапроса.Пустой();
		КлючевыеПараметрыПродукта["Погранпереход"] = Погранпереход;
	КонецЕсли;
	
	//условие ЦФО
	Если Все ИЛИ РеквизитИмя = "ЦФО" Тогда 
		Если Объект.ЦФО = Справочники.ЦентрыФинансовойОтветственности.ТерминалНовосибирск Тогда
			ЦФОТерминалНСК = Истина; 
		Иначе
			ЦФОТерминалНСК = Ложь; 
		КонецЕсли;
		КлючевыеПараметрыПродукта["ЦФОТерминалНСК"] = ЦФОТерминалНСК;
	КонецЕсли;
	
	//условие Груз
	Если Все ИЛИ РеквизитИмя = "Груз" Тогда 
		Если Объект.Груз = Перечисления.ТипыГрузов.КонтейнерыПорожние Тогда
			ГрузКонтейнерыПорожние = Истина; 
		Иначе
			ГрузКонтейнерыПорожние = Ложь; 
		КонецЕсли;
		КлючевыеПараметрыПродукта["ГрузКонтейнерыПорожние"] = ГрузКонтейнерыПорожние;
	КонецЕсли;
	
	Возврат КлючевыеПараметрыПродукта;

КонецФункции //Евросиб Коханенко Н.А. 03.02.2025 )) #100979

//Евросиб Коханенко Н.А. 03.02.2025 (( #100979
&НаСервере
Функция ПодобратьЗначениеПродукта(КлючевыеПараметрыПродукта)
		
	Если КлючевыеПараметрыПродукта["УчНаправлениеМорской"] 
		И КлючевыеПараметрыПродукта["ТипКалькуляцииММ"] 
		И КлючевыеПараметрыПродукта["ТипЗаказаКонтейнерныйПоезд"] 
		И КлючевыеПараметрыПродукта["ФрахтЗаполнен"] 
		И КлючевыеПараметрыПродукта["ОсновнаяУслугаТЭУ"] Тогда
		Результат = Справочники.ПродуктыДКП.ММморской;
	ИначеЕсли КлючевыеПараметрыПродукта["УчНаправлениеСухопутныйИлиТранзит"] 
		И КлючевыеПараметрыПродукта["ТипКалькуляцииММ"] 
		И КлючевыеПараметрыПродукта["ТипЗаказаКонтейнерныйПоезд"] 
		И КлючевыеПараметрыПродукта["УслугаПредоставлениеКТК"] 
		И КлючевыеПараметрыПродукта["Погранпереход"] Тогда
		Результат = Справочники.ПродуктыДКП.ММсухопутный;
	ИначеЕсли КлючевыеПараметрыПродукта["ТипКалькуляцииКонтейнерныйПоезд"] 
		И КлючевыеПараметрыПродукта["ТипЗаказаКонтейнерныйПоезд"] 
		И КлючевыеПараметрыПродукта["УслугиТарифГруженыйЖД"] 
		И НЕ КлючевыеПараметрыПродукта["ФрахтЗаполнен"] Тогда
		Результат = Справочники.ПродуктыДКП.МестоВПоезде;
