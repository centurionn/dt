	//		Элемент.ТекущийЭлемент.ОграничениеТипа = Новый ОписаниеТипов("Булево");
	//		Элемент.ТекущийЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
	//	КонецЕсли;
	КонецЕсли;
	
