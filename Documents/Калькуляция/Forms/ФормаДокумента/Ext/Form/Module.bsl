					, 
					"ММ_ПортыОтправленияНазначения[" + ИндексСтроки + "].Порт", 
					"Объект", 
					Отказ);
			КонецЕсли;
		КонецЦикла;
		//Если ТекущийОбъект.ММ_ПортОтправления.ИспользованиеПортаВКалькуляции = 1 Тогда
		//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для порта "+ТекущийОбъект.ММ_ПортОтправления+" разрешено использование только в экспорте!",, "Объект.ММ_ПортОтправления",, Отказ);
		//КонецЕсли;
		// Евросиб Рыбьяков К.А. 16.09.2024 ))
		
	Иначе // 1 = экспорт
		
