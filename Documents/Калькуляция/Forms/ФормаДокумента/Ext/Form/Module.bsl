&НаКлиенте
Процедура ОбработкаВыбораТарифов_выбранныхВручную(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	ТЧ = неопределено;
	
	Если Параметр2 = 1 Тогда
		ТЧ = Элементы.ЖД_КалькуляцияСебестоимости;
	ИначеЕсли Параметр2 = 8 Тогда
		ТЧ = Элементы.ЖД_УслугиВнеСтавки1;
	ИначеЕсли Параметр2 = 2 Тогда
		ТЧ = Элементы.ПС_ДопРасходыВклВСтавку;
	Иначе
		ТЧ = Элементы.ЖД_УслугиВнеСтавки;
	КонецЕсли;
	
	ТекД = ТЧ.ТекущиеДанные;
	Если Параметр1 = неопределено ИЛИ ТекД = неопределено Тогда Возврат; КонецЕсли;
	
	Для каждого Стр из Параметр1 Цикл
		
		Если НЕ ЗначениеЗаполнено(Стр.Тариф) Тогда Продолжить; КонецЕсли;
		
		ДеталиТарифа = Тарификатор_сервер.ПолучитьДеталиТарифа(Стр.Тариф);
		ЗаполнитьЗначенияСвойств(ТекД, ДеталиТарифа);
		Если Стр.Размер = ПредопределенноеЗначение("Справочник.РазмерыКТК.К20") Тогда
			ЗаполнитьСумму = Новый структура("Тариф20, Сумма20, Себестоимость20, СтавкаМаксимальная, СуммаБезНДС", Стр.Тариф, Стр.Себестоимость, Стр.Себестоимость, Стр.Максимум, Стр.Себестоимость);
		Иначе
			ЗаполнитьСумму = Новый структура("Тариф40, Сумма40, Себестоимость40, СтавкаМаксимальная, СуммаБезНДС", Стр.Тариф, Стр.Себестоимость, Стр.Себестоимость, Стр.Максимум, Стр.Себестоимость);
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ТекД, ЗаполнитьСумму);
			
	КонецЦикла;
	
	Если Параметр2 = 1 Тогда
		ЖД_КалькуляцияСебестоимостиПриИзменении(неопределено);
	ИначеЕсли Параметр2 = 2 Тогда
		ПС_ДопРасходыВклВСтавкуПриИзменении(неопределено);
	Иначе
		ЖД_УслугиВнеСтавкиПриИзменении(неопределено);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ТарификаторПоСтроке(Команда)
	
	ТЧ = неопределено;
	
	Если Команда = Истина Тогда
		ТЧ = Элементы.ЖД_КалькуляцияСебестоимости;
	ИначеЕсли Команда = 8 Тогда
		ТЧ = Элементы.ЖД_УслугиВнеСтавки1;
	ИначеЕсли Объект.ТипКалькуляции = ПредопределенноеЗначение("Перечисление.ТипыКалькуляций.КалькуляцияКомплекснойСтавки")
		ИЛИ Объект.ТипКалькуляции = ПредопределенноеЗначение("Перечисление.ТипыКалькуляций.ПредоставлениеПСБезТарифаГруженого") Тогда
		ТЧ = Элементы.ПС_ДопРасходыВклВСтавку;
	Иначе
		ТЧ = Элементы.ЖД_УслугиВнеСтавки;
	КонецЕсли;
	
	Если ТЧ = неопределено ИЛИ ТЧ.ТекущиеДанные = неопределено Тогда Возврат; КонецЕсли;
	
	Стр = ТЧ.ТекущиеДанные;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("КалькуляцияСухопутнойСоставляющей", Истина);
	СтруктураПараметров.Вставить("Период", Объект.Дата);
	
	СтруктураПараметров.Вставить("ПунктОтправления", Стр.ПунктОтправления);
	СтруктураПараметров.Вставить("ПунктНазначения", Стр.ПунктНазначения);
	
	СтруктураПараметров.Вставить("Услуга", Стр.Услуга);
	МРазмерКТК = Новый Массив;
	МРазмерКТК.Добавить(ПредопределенноеЗначение("Справочник.РазмерыКТК.К20"));
	СтруктураПараметров.Вставить("РазмерыКТК", МРазмерКТК);
	
	РЕЗТарифы = Тарификатор_сервер.ПолучитьТарифыПоПараметрам(СтруктураПараметров);
	
	МаксСтавка = 0;
	Для каждого Трф из РЕЗТарифы Цикл
		Если Трф.Себестоимость > МаксСтавка Тогда
			ПараметрыТарифа = Тарификатор_сервер.ПолучитьДеталиТарифа(Трф.Тариф);
			ЗаполнитьЗначенияСвойств(Стр, ПараметрыТарифа);
			ЗаполнитьСумму = Новый структура("Тариф20, Сумма20, Себестоимость20, СтавкаМаксимальная, СуммаБезНДС", Трф.Тариф, Трф.Себестоимость, Трф.Себестоимость, Истина, Трф.Себестоимость);
			ЗаполнитьЗначенияСвойств(Стр, ЗаполнитьСумму);
			МаксСтавка = Трф.Себестоимость;
		КонецЕсли;
	КонецЦикла;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("КалькуляцияСухопутнойСоставляющей", Истина);
	СтруктураПараметров.Вставить("Период", Объект.Дата);
	
	СтруктураПараметров.Вставить("ПунктОтправления", Стр.ПунктОтправления);
	СтруктураПараметров.Вставить("ПунктНазначения", Стр.ПунктНазначения);
	
	СтруктураПараметров.Вставить("Услуга", Стр.Услуга);
	МРазмерКТК = Новый Массив;
	МРазмерКТК.Добавить(ПредопределенноеЗначение("Справочник.РазмерыКТК.К40"));
	СтруктураПараметров.Вставить("РазмерыКТК", МРазмерКТК);
	
	РЕЗТарифы = Тарификатор_сервер.ПолучитьТарифыПоПараметрам(СтруктураПараметров);
	
	МаксСтавка = 0;
	Для каждого Трф из РЕЗТарифы Цикл
		Если Трф.Себестоимость > МаксСтавка Тогда
			ПараметрыТарифа = Тарификатор_сервер.ПолучитьДеталиТарифа(Трф.Тариф);
			ЗаполнитьЗначенияСвойств(Стр, ПараметрыТарифа);
			ЗаполнитьСумму = Новый структура("Тариф40, Сумма40, Себестоимость40, СтавкаМаксимальная, СуммаБезНДС", Трф.Тариф, Трф.Себестоимость, Трф.Себестоимость, Истина, Трф.Себестоимость);
			ЗаполнитьЗначенияСвойств(Стр, ЗаполнитьСумму);
			МаксСтавка = Трф.Себестоимость;
		КонецЕсли;
	КонецЦикла;
	
	Если Команда = Истина Тогда
		ЖД_КалькуляцияСебестоимостиПриИзменении(неопределено);
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаЖелезнодорожнаяПредоставление Тогда
		ПС_ДопРасходыВклВСтавкуПриИзменении(неопределено);
	Иначе
		ЖД_УслугиВнеСтавкиПриИзменении(неопределено);
	КонецЕсли;
	
КонецПроцедуры

