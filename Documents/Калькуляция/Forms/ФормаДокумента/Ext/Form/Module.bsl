&НаСервере
Процедура ЗаписатьОтменуСогласования()
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПараметрыЗаписи = Новый Структура("РежимЗаписи, ИзмененыТолькоРазрешенныеПоля", РежимЗаписиДокумента.Запись, Истина);	
	Записать(ПараметрыЗаписи);
	
	Если Не БлокировкаРаботыСВнешнимиРесурсами.РаботаСВнешнимиРесурсамиЗаблокирована() Тогда
	
		ОтветственныйЗаУчет = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "ОтветственныйЗаУчет");
		Если ЗначениеЗаполнено(ОтветственныйЗаУчет) Тогда
			АдресПолучателя = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(ОтветственныйЗаУчет, Справочники.ВидыКонтактнойИнформации.EmailПользователя);
		Иначе
			АдресПолучателя = "";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(АдресПолучателя) Тогда
			
			Тема = СтрШаблон("Отменено согласование калькуляции %1", Объект.Ссылка);
			ТелоПисьма = Новый ФорматированныйДокумент;
			ТелоПисьма.Добавить(Тема);
			СкрытыеКопии = "";
			Вложения = Новый Массив;
			
			Если РаботаСПочтовымиСообщениями.УчетнаяЗаписьНастроена(Справочники.УчетныеЗаписиЭлектроннойПочты.СистемнаяУчетнаяЗаписьЭлектроннойПочты, Истина, Ложь) Тогда
				ПараметрыСообщения = новый Структура("Кому, ПолучателиСообщения, СкрытыеКопии, Тема, Тело, Вложения", АдресПолучателя, АдресПолучателя, СкрытыеКопии, Тема, ТелоПисьма, Вложения);
				Попытка
					ИДПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(Справочники.УчетныеЗаписиЭлектроннойПочты.СистемнаяУчетнаяЗаписьЭлектроннойПочты, ПараметрыСообщения);
				Исключение
					ОписаниеОшибки = ОписаниеОшибки();
					//ЗаписьЖурналаРегистрации("Письмо не отправлено по причине: " + ОписаниеОшибки, УровеньЖурналаРегистрации.Ошибка,,, "Рассылка об изменении рейтинга клиентов");
					//ДИТ, Беляев СЮ, Ticket#0272756, 25-07-2022, начало
					ЗаписьЖурналаРегистрации(РаботаСПочтовымиСообщениями.СобытиеЖурналаРегистрацииОшибка(), УровеньЖурналаРегистрации.Ошибка,,, "Отмена согласования Калькуляции. Письмо не отправлено по причине: "+ОписаниеОшибки);
					//ДИТ, Беляев СЮ, Ticket#0272756, 25-07-2022, конец
				КонецПопытки;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

