&НаСервереБезКонтекста
Функция ПолучитьТипПункта(Пункт)
	ТипПункта = "";
	Если Пункт = Неопределено Тогда
		ТипПункта = "";
	ИначеЕсли ТипЗнч(Пункт) = Тип("СправочникСсылка.Локации") Тогда
		ТипПункта = ОбщегоНазначенияВызовСервера.ЗначениеРеквизитаОбъекта(Пункт, "Тип");
	ИначеЕсли ТипЗнч(Пункт) = Тип("СправочникСсылка.АдресаВНаселенныхПунктах") Тогда
		ТипПункта = "Адрес";
	КонецЕсли;             
	Возврат ТипПункта;
КонецФункции

	

