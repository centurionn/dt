&НаСервере
Процедура ОбновитьТаблицуВыбранныхСтавок(ДанныеИзТарифа)
	
	//1. создать таблицу
	// создаем колонки
	// сначала удалить все старые колонки
	//необходимо удалить старые программно созданные реквизиты
	МассивУдаляемыхРеквизитовФормы = новый Массив;
	Для каждого Стр из ЭтаФорма.ПолучитьРеквизиты("НФ_ЛинииПорты") Цикл
		ПутьКДан = ?(ЗначениеЗаполнено(Стр.Путь),Строка(Стр.Путь)+".","");
		Если СтрНачинаетсяС(Стр.Имя,"НФ_ИмяПорта") Тогда 
			МассивУдаляемыхРеквизитовФормы.Добавить(Строка(ПутьКДан) + Стр.Имя); 
		КонецЕсли;
	КонецЦикла;
		
	ТЗ = Новый ТаблицаЗначений;
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Число"));
	ПараметрыЧисла = Новый КвалификаторыЧисла(15,3,ДопустимыйЗнак.Любой);
	МассивТипов.Добавить(Тип("ПеречислениеСсылка.УсловияПеревозкиПоПортам"));
	МассивТипов.Добавить(Тип("СправочникСсылка.Валюты"));

	ДопустимыеТипы = Новый ОписаниеТипов(МассивТипов, ПараметрыЧисла);
	
