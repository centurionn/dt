&НаСервере
Процедура НФ_ЛинииПортыВыбратьСнятьНаСервере(Действие)
	
	Таблица = НФ_ЛинииПорты.Выгрузить();
	
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Если СтрНайти(Колонка.Имя, "Флажок") <> 0 Тогда
			Если Действие = "Установить" Тогда
				Таблица.ЗаполнитьЗначения(Истина, Колонка.Имя);
			Иначе
				Таблица.ЗаполнитьЗначения(Ложь, Колонка.Имя);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	НФ_ЛинииПорты.Загрузить(Таблица);
	
КонецПроцедуры

