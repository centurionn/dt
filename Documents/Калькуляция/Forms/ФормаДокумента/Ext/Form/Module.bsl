&НаСервере
Функция ПроцентВознагражденияУслуги(Услуга, Период)
	
	Результат = 0;
	
	//БИТ Белинский Д.А. 30.06.2023 -начало TASK 66201
	Если Объект.Контрагент = Константы.КонтрагентДирекцияКонтейнерныхПеревозок.Получить() Тогда
		Возврат Результат;
	КонецЕсли;
 	//БИТ Белинский Д.А. 30.60.2023 -начало TASK 66201 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НормативныйПроцентВознаграженияСрезПоследних.ПроцентВознаграждения КАК ПроцентВознаграждения
	               |ИЗ
	               |	РегистрСведений.НормативныйПроцентВознагражения.СрезПоследних(&Период, Услуга = &Услуга) КАК НормативныйПроцентВознаграженияСрезПоследних";
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Услуга", Услуга);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.ПроцентВознаграждения;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

