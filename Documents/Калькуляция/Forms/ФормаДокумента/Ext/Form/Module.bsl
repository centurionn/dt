&НаСервере
Процедура ОбработатьИзменениеЖДСоставляющейСервер(ПараметрыТарифа = Неопределено, ДобавлятьСтрокуПредоставлениеПС = Ложь)
	
	Если Объект.ММ_КоличествоКТКНаВагон = 0 Тогда Возврат; КонецЕсли;
	
	НоменклатураПредоставлениеПС = Справочники.Номенклатура.ПредоставлениеПлатформ;
	ВалютаРубль = Справочники.Валюты.Рубль;
	СтавкаНДС0 = Перечисления.СтавкиНДС.НДС0;
	
	Если ЗначениеЗаполнено(ПараметрыТарифа) Тогда
		ВалютаТарифа = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыТарифа, "Валюта", ВалютаРубль);
		СтавкаНДСТарифа = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыТарифа, "СтавкаНДС", СтавкаНДС0);
		НДСВключенВСтоимость = Ложь;
	Иначе
		ВалютаТарифа = ВалютаРубль;
		СтавкаНДСТарифа = СтавкаНДС0;
		НДСВключенВСтоимость = Ложь;
	КонецЕсли;
	
	ДлитДней = ОкрВверх(Объект.ММ_КалькуляцияЖДСоставляющей.Итог("ДлительностьДней"));
	
	НайденныеСтроки = Объект.ММ_КалькуляцияМультимодальнойЦепочки.НайтиСтроки(Новый Структура("Услуга", НоменклатураПредоставлениеПС));
	Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
		НайденнаяСтрока = НайденныеСтроки[0];
	Иначе
		//Евросиб Каблов 25.06.2025 ( #112882
		Если ДобавлятьСтрокуПредоставлениеПС Тогда
		//Евросиб Каблов 25.06.2025 )
			НайденнаяСтрока = Объект.ММ_КалькуляцияМультимодальнойЦепочки.Добавить();
			НайденнаяСтрока.Услуга = НоменклатураПредоставлениеПС;
		//Евросиб Каблов 25.06.2025 ( #112882
		Иначе
			Возврат;
		КонецЕсли;
		//Евросиб Каблов 25.06.2025 )
	КонецЕсли;
	
	НайденнаяСтрока.Валюта = ВалютаТарифа;
	НайденнаяСтрока.НДСВключенВСтоимость = НДСВключенВСтоимость;
	НайденнаяСтрока.СтавкаНДС = СтавкаНДСТарифа;
    
	НайденнаяСтрока.ПунктОтправления = Объект.Суша_ПунктОтправления;
	НайденнаяСтрока.ПунктНазначения = Объект.Суша_ПунктНазначения;
	
	НайденнаяСтрока.Цена20 = 0;
	НайденнаяСтрока.НормативныйПроцентВознаграждения20 = 0;
	НайденнаяСтрока.Вознаграждение20 = 0;
	НайденнаяСтрока.СуммаВознаграждения20 = 0;
	НайденнаяСтрока.Цена40 = 0;
	НайденнаяСтрока.НормативныйПроцентВознаграждения40 = 0;
	НайденнаяСтрока.Вознаграждение40 = 0;
	НайденнаяСтрока.СуммаВознаграждения40 = 0;
	
	Если СтрНайти(ТарифицируемыйРазмерКТК, "20") <> 0 Тогда
		НайденнаяСтрока.Цена20 = ДлитДней * Объект.ММ_СтавкаПредоставленияПлатформы / Объект.ММ_КоличествоКТКНаВагон;
		НайденнаяСтрока.НормативныйПроцентВознаграждения20 = ПроцентВознагражденияУслуги(НайденнаяСтрока.Услуга, Объект.Дата);
		НайденнаяСтрока.Вознаграждение20 = НайденнаяСтрока.НормативныйПроцентВознаграждения20;
	КонецЕсли;
	
	Если СтрНайти(ТарифицируемыйРазмерКТК, "40") <> 0 Тогда
		НайденнаяСтрока.Цена40 = ДлитДней * Объект.ММ_СтавкаПредоставленияПлатформы / Объект.ММ_КоличествоКТКНаВагон;
		НайденнаяСтрока.НормативныйПроцентВознаграждения40 = ПроцентВознагражденияУслуги(НайденнаяСтрока.Услуга, Объект.Дата);
		НайденнаяСтрока.Вознаграждение40 = НайденнаяСтрока.НормативныйПроцентВознаграждения40;
	КонецЕсли;
	
	ПосчитатьСтрокуКалькуляцииЖДСервер(НайденнаяСтрока.ПолучитьИдентификатор());	
	ПересчитатьИтогоВИспользовании(неопределено);
	ОбновитьИтоговыеПараметрыТаблиц(Объект.Валюта,);
	
КонецПроцедуры

//Евросиб Каблов 28.05.2025 #109346
&НаКлиенте
Процедура ПосчитатьСтрокуКалькуляцииЖД(Знач ТекД = неопределено)
	
	Если ТекД <> Неопределено Тогда
		ТекСтрока = ТекД.ПолучитьИдентификатор();
	Иначе
		ТекСтрока = Элементы.ММ_КалькуляцияМультимодальнойЦепочки.ТекущаяСтрока;
	КонецЕсли;
	
	Если ТекСтрока <> Неопределено Тогда
		ПосчитатьСтрокуКалькуляцииЖДСервер(ТекСтрока);
	КонецЕсли;
	
КонецПроцедуры

