Процедура ПолучитьДанныеИзБазы()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КалькуляцияСостояния.Ссылка КАК Ссылка,
	               |	КалькуляцияСостояния.НомерСтроки КАК НомерСтроки,
	               |	КалькуляцияСостояния.Состояние КАК Состояние,
	               |	КалькуляцияСостояния.Исполнитель КАК Исполнитель,
	               |	КалькуляцияСостояния.Наблюдатель КАК Наблюдатель,
	               |	КалькуляцияСостояния.Статус КАК Статус,
	               |	КалькуляцияСостояния.НачалоРаботы КАК НачалоРаботы,
	               |	КалькуляцияСостояния.ЗавершениеРаботы КАК ЗавершениеРаботы,
	               |	КалькуляцияСостояния.ПричинаОтказа КАК ПричинаОтказа,
	               |	КалькуляцияСостояния.СтатусСогласования КАК СтатусСогласования,
	               |	КалькуляцияСостояния.ПредыдущиеЭтапы КАК ПредыдущиеЭтапы,
	               |	КалькуляцияСостояния.НормативИсполненияСМоментаСоздания КАК НормативИсполненияСМоментаСоздания
	               |ИЗ
	               |	Документ.Калькуляция.Состояния КАК КалькуляцияСостояния
	               |ГДЕ
	               |	КалькуляцияСостояния.Ссылка = &Ссылка
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка",Объект.Ссылка);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Объект.Состояния.Загрузить(ТЗ);
	
