&НаСервере
Процедура ИзмененКонтрагент_сервер()
	
	// МОРЕ таблицы
	ММ_МореСтавка = 0;
	ТопНаправление = неопределено;
	ММ_МореВознаграждение = 0;
	ММ_МореСебестоимость = 0;
	Для каждого Стр из Объект.ММ_ПросчитанныеСтавкиФрахта Цикл
		Если Стр.Направление.Линия.Контрагент = Объект.ПротоколСчитаетсяПоСтавкамКонтрагента И Стр.Ставка > ММ_МореСтавка Тогда
			ММ_МореСтавка = Стр.Ставка;
			ТопНаправление = Стр.Направление;
			ММ_МореВознаграждение = Стр.Вознаграждение;
		КонецЕсли;
	КонецЦикла;
	Для каждого Стр из Объект.ММ_ПросчитанныеУслугиФрахта Цикл
		Если Стр.Направление = ТопНаправление Тогда
			ММ_МореСебестоимость = ММ_МореСебестоимость + Стр.Себестоимость;
			Объект.ММ_ВалютаФрахтовыхСтавок = Стр.Тариф.Валюта;
			//Объект.ПротоколСчитаетсяПоСтавкамКонтрагента = КонтрагентТарифа(Стр.Тариф);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

