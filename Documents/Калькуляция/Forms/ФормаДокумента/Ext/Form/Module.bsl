&НаСервереБезКонтекста
Функция ПолучитьВнутреннююСебестоимость(ТекУслуга, ПунктОтправления, ПунктНазначения)
	
	//Возврат ТекУслуга.ВнутренняяСебестоимость И (ПунктОтправления.НаТерминалеИспользуютсяУслугиВнСебестоимости ИЛИ ПунктНазначения.НаТерминалеИспользуютсяУслугиВнСебестоимости);
	//ДИТ, Беляев СЮ, Ticket#0334071, 04-12-2023, начало (тип реквизитов ПунктОтправления, ПунктНазначения может быть не назначен, а также могут быть ссылки на спр-к АдресаВНаселенныхПунктах)
	ФлагИспользованияНаТерминалеУслугиВнСебестоимости = Ложь;
	МассивПунктов = Новый Массив;
	МассивПунктов.Добавить(ПунктОтправления);
	МассивПунктов.Добавить(ПунктНазначения);
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(МАКСИМУМ(Локации.НаТерминалеИспользуютсяУслугиВнСебестоимости), ЛОЖЬ) КАК НаТерминалеИспользуютсяУслугиВнСебестоимости
		|ИЗ
		|	Справочник.Локации КАК Локации
		|ГДЕ
		|	Локации.Ссылка В(&МассивПунктов)";
	
	Запрос.УстановитьПараметр("МассивПунктов", МассивПунктов);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ФлагИспользованияНаТерминалеУслугиВнСебестоимости = ВыборкаДетальныеЗаписи.НаТерминалеИспользуютсяУслугиВнСебестоимости;
	КонецЕсли;

	Возврат ТекУслуга.ВнутренняяСебестоимость И ФлагИспользованияНаТерминалеУслугиВнСебестоимости;
	//ДИТ, Беляев СЮ, Ticket#0334071, 04-12-2023, конец
	
КонецФункции	
	
&НаКлиенте
Процедура ТарификаторПоСтроке_Мультимодал(Команда)
	
	ТекД = Элементы.ММ_КалькуляцияМультимодальнойЦепочки.ТекущиеДанные;
	Если ТекД = неопределено Тогда Возврат; КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("РежимПодбораСухопутногоТарифа", Истина);
	СтруктураПараметров.Вставить("Период", Объект.Дата);
	СтруктураПараметров.Вставить("ПунктОтправления", ТекД.ПунктОтправления);
	СтруктураПараметров.Вставить("ПунктНазначения", ТекД.ПунктНазначения);
	СтруктураПараметров.Вставить("Услуга", ТекД.Услуга);
	СтруктураПараметров.Вставить("Организация", Объект.Организация);

	Если ЗначениеЗаполнено(ТекД.Поставщик) Тогда
		СтруктураПараметров.Вставить("Поставщик", ТекД.Поставщик);
	КонецЕсли;
	
	ОпОп = Новый ОписаниеОповещения("ТарификаторПоСтроке_Мультимодал_выбор", ЭтаФорма);
	ОткрытьФорму("Документ.Калькуляция.Форма.ПодборТарифаКалькуляцией", СтруктураПараметров,,ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	
КонецПроцедуры

&НаКлиенте
Процедура ТарификаторПоСтроке_Мультимодал_выбор(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	ТекД = Элементы.ММ_КалькуляцияМультимодальнойЦепочки.ТекущиеДанные;
	
	Если параметр1 = неопределено ИЛИ ТекД = неопределено Тогда Возврат; КонецЕсли;
	
	Для каждого Стр из Параметр1 Цикл
		
		Если НЕ ЗначениеЗаполнено(Стр.Тариф) Тогда Продолжить; КонецЕсли;
		
		ДеталиТарифа = Тарификатор_сервер.ПолучитьДеталиТарифа(Стр.Тариф);
		ЗаполнитьЗначенияСвойств(ТекД, ДеталиТарифа);
		ТекД.НДСВключенВСтоимость = ДеталиТарифа.СуммаВключаетНДС;
		Если Стр.Размер = ПредопределенноеЗначение("Справочник.РазмерыКТК.К20") Тогда
			ЗаполнитьСумму = Новый структура("Тариф20, Цена20, СтавкаМаксимальная20", Стр.Тариф, Стр.Себестоимость, Стр.Максимум);
		Иначе
			ЗаполнитьСумму = Новый структура("Тариф40, Цена40, СтавкаМаксимальная40", Стр.Тариф, Стр.Себестоимость, Стр.Максимум);
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ТекД, ЗаполнитьСумму);
		ММ_КалькуляцияМультимодальнойЦепочкиПриИзменении(неопределено,,Истина);
		
	КонецЦикла;
	
КонецПроцедуры

