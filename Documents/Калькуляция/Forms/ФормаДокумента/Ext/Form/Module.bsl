Процедура СкопироватьТСх(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Записать();
	КонецЕсли;
	СкопироватьТСхНаСервере(Объект.КалькуляцияСозданаНаОсновании, Объект.Ссылка);
	Элементы.ГруппаКопированиеКалькуляций.Видимость = Ложь;
	ПоказатьПредупреждение(, "Копирование завершено!");
	
