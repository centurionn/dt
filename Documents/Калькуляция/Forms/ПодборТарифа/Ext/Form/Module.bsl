
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВалютаРубль = Константы.ВалютаРегламентированногоУчета.Получить();
	
	РаскраситьСтроку = Истина;
	
	ПунктНазначенияПоЗапросу = неопределено;
	
	//Евросиб Каблов 17.11.2023 ( #75269
	Период = НачалоДня(ТекущаяДата());
	Услуга = Параметры.Услуга;
	ПунктОтправления = Параметры.ПунктОтправления;
	ПунктНазначения = Параметры.ПунктНазначения;
	
	Если Параметры.ДляКТКЕвросиб Тогда
		// ДИТ 89973 Давудов М.А. Начало: 21.08.2024
		//ок(
		//СобственностьПеревозимогоКТК = Перечисления.СобственностьПеревозимогоКонтейнера.COC;
		//ок)
		УдалитьСобственностьПеревозимогоКТК = Перечисления.УдалитьСобственностьПеревозимогоКонтейнера.COC;
		ПринадлежностьТЕ = Перечисления.ПринадлежностьТЕ.КТЕвросиба;
		// ДИТ 89973 Давудов М.А. Конец: 21.08.2024
	ИначеЕсли Параметры.ДляКТККлиента Тогда
		// ДИТ 89973 Давудов М.А. Начало: 21.08.2024
		//ок(
		//СобственностьПеревозимогоКТК = Перечисления.СобственностьПеревозимогоКонтейнера.SOC;
		//ок)
		УдалитьСобственностьПеревозимогоКТК = Перечисления.УдалитьСобственностьПеревозимогоКонтейнера.SOC;
		ПринадлежностьТЕ = Перечисления.ПринадлежностьТЕ.КТКлиента;
		// ДИТ 89973 Давудов М.А. Конец: 21.08.2024
	КонецЕсли;
	
	Если Параметры.ТипГруза = Перечисления.ТипыГрузов.КонтейнерыСГрузом Тогда
		СостояниеКТК = Перечисления.СостоянияКТК.Груженый;
	ИначеЕсли Параметры.ТипГруза = Перечисления.ТипыГрузов.КонтейнерыПорожние Тогда
		СостояниеКТК = Перечисления.СостоянияКТК.Порожний;
	КонецЕсли;
	
	Если СостояниеКТК = Перечисления.СостоянияКТК.Груженый Тогда
		Элементы.ГруппаПараметрыГруза.Видимость = Истина;
	Иначе
		Элементы.ГруппаПараметрыГруза.Видимость = Ложь;
	КонецЕсли;
	
	УсловияПеревозки_Отправление = Параметры.УсловияПеревозки_Отправление;
	УсловияПеревозки_Прибытие = Параметры.УсловияПеревозки_Прибытие;
	//Евросиб Каблов 17.11.2023 )	

	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	
КонецПроцедуры

