
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВалютаРубль = Константы.ВалютаРегламентированногоУчета.Получить();
	
	РаскраситьСтроку = Истина;
	
	ПунктНазначенияПоЗапросу = неопределено;
	
	/// Режим для обычного выбора тарифа в ЖД калькуляции
	
	Если Параметры.Свойство("РежимПодбораСухопутногоТарифа") Тогда
		
		ПоискТарифовНаДату = Параметры.Период;
		Организация = Параметры.Организация;
		ПунктОтправления = Параметры.ПунктОтправления;
		ПунктНазначения = Параметры.ПунктНазначения;
		Услуга = Параметры.Услуга;
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("КалькуляцияСухопутнойСоставляющей", Истина);
		СтруктураПараметров.Вставить("Период", Параметры.Период);
		СтруктураПараметров.Вставить("ПунктОтправления", Параметры.ПунктОтправления);
		СтруктураПараметров.Вставить("ПунктНазначения", Параметры.ПунктНазначения);
		
		Если Параметры.Свойство("Поставщик") Тогда СтруктураПараметров.Вставить("Поставщик", Параметры.Поставщик); Поставщик = Параметры.Поставщик; КонецЕсли;
		
		ПунктНазначенияПоЗапросу = Параметры.ПунктНазначения;
		
		ПунктНазначенияПоЗапросу = Локации_сервер.ПолучитьМассивРодителей(ПунктНазначенияПоЗапросу, Истина);
		
		СтруктураПараметров.Вставить("ИгнорироватьПунктНазначения", Истина);
		СтруктураПараметров.Вставить("Услуга", Параметры.Услуга);
		СтруктураПараметров.Вставить("Организация", Параметры.Организация);
		МРазмерКТК = Новый Массив;
		МРазмерКТК.Добавить(Справочники.РазмерыКТК.К20);
		СтруктураПараметров.Вставить("РазмерыКТК", МРазмерКТК);
		
		РЕЗТарифы = Тарификатор_сервер.ПолучитьТарифыПоПараметрам(СтруктураПараметров);
		
		ПервыйПоставлен = Ложь;
		РаскраситьСтроку = НЕ РаскраситьСтроку;
		
		СтавкаСамогоДорогого = 0;
		СтрокаСамогоДорогого = "";
		Для каждого Стр2 из РЕЗТарифы Цикл
			НСтр = ТЧ.Добавить();
			НСтр.ПунктОтправления = Параметры.ПунктОтправления;
			НСтр.ПунктНазначения = Стр2.Тариф.ПунктНазначения;
			НСтр.ТарифПодходитПоПунктуНазначения = ПунктНазначенияПоЗапросу.Найти(НСтр.ПунктНазначения) <> неопределено;
			//НСтр.Направление = Стр.Направление;
			НСтр.Контрагент = Стр2.Тариф.Поставщик;
			НСтр.Услуга = Параметры.Услуга;
			НСтр.ГУИДСтроки = Строка(Новый УникальныйИдентификатор);
			НСтр.Размер = Справочники.РазмерыКТК.К20;
			НСтр.Себестоимость = Стр2.Себестоимость;
			
			СебестоимостьРубБезНДС = Валюта_сервер.ПересчитатьПоКурсу(Стр2.Себестоимость, Стр2.Валюта, ВалютаРубль,Параметры.Период);
			СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(СебестоимостьРубБезНДС, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Стр2.Тариф.СтавкаНДС), Истина, Стр2.Тариф.СуммаВключаетНДС);
			НСтр.СебестоимостьРубБезНДС = СебестоимостьРубБезНДС - ?(Стр2.Тариф.СуммаВключаетНДС, СуммаНДС, 0); 
			НСтр.СебестоимостьРубСНДС = СебестоимостьРубБезНДС + ?(Стр2.Тариф.СуммаВключаетНДС, 0, СуммаНДС);

			Если НСтр.СебестоимостьРубБезНДС > СтавкаСамогоДорогого Тогда
				СтавкаСамогоДорогого = НСтр.СебестоимостьРубБезНДС;
				СтрокаСамогоДорогого = НСтр.ГУИДСтроки;
			КонецЕсли;
			СтавкаСамогоДорогого = Макс(СтавкаСамогоДорогого, Стр2.Себестоимость);
			НСтр.Тариф = Стр2.Тариф;
			НСтр.СтавкаНДС = Стр2.Тариф.СтавкаНДС;
			НСтр.НДСВключенВСтоимость = Стр2.Тариф.СуммаВключаетНДС;
			НСтр.Валюта = Стр2.Валюта;
			НСтр.РаскраситьСтроку = РаскраситьСтроку;
			Если НЕ ПервыйПоставлен Тогда
				НСтр.Выбор = Истина;
				ПервыйПоставлен = Истина;
			КонецЕсли;
		КонецЦикла;
		Для каждого Стр из ТЧ Цикл
			Если Стр.ГУИДСтроки = СтрокаСамогоДорогого Тогда Стр.СамыйВысокий = Истина; Прервать; КонецЕсли;
		КонецЦикла;
		
		// а теперь то же самое для 40"
		
		МРазмерКТК = Новый Массив;
		МРазмерКТК.Добавить(Справочники.РазмерыКТК.К40);
		СтруктураПараметров.Вставить("РазмерыКТК", МРазмерКТК);
		
		РЕЗТарифы = Тарификатор_сервер.ПолучитьТарифыПоПараметрам(СтруктураПараметров);
		
		ПервыйПоставлен = Ложь;
		РаскраситьСтроку = НЕ РаскраситьСтроку;
		
		СтавкаСамогоДорогого = 0;
		СтрокаСамогоДорогого = "";
		Для каждого Стр2 из РЕЗТарифы Цикл
			НСтр = ТЧ.Добавить();
			НСтр.ПунктОтправления = Параметры.ПунктОтправления;
			НСтр.ПунктНазначения = Стр2.Тариф.ПунктНазначения;
			НСтр.ТарифПодходитПоПунктуНазначения = ПунктНазначенияПоЗапросу.Найти(НСтр.ПунктНазначения) <> неопределено;
			//НСтр.Направление = Стр.Направление;
			НСтр.Контрагент = Стр2.Тариф.Поставщик;
			НСтр.Услуга = Параметры.Услуга;
			НСтр.Размер = Справочники.РазмерыКТК.К40;
			НСтр.ГУИДСтроки = Строка(Новый УникальныйИдентификатор);
			НСтр.Себестоимость = Стр2.Себестоимость;
			
			СебестоимостьРубБезНДС = Валюта_сервер.ПересчитатьПоКурсу(Стр2.Себестоимость, Стр2.Валюта, ВалютаРубль,Параметры.Период);
			СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(СебестоимостьРубБезНДС, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Стр2.Тариф.СтавкаНДС), Истина, Стр2.Тариф.СуммаВключаетНДС);
			НСтр.СебестоимостьРубБезНДС = СебестоимостьРубБезНДС - ?(Стр2.Тариф.СуммаВключаетНДС, СуммаНДС, 0); 
			НСтр.СебестоимостьРубСНДС = СебестоимостьРубБезНДС + ?(Стр2.Тариф.СуммаВключаетНДС, 0, СуммаНДС);

			Если НСтр.СебестоимостьРубБезНДС > СтавкаСамогоДорогого Тогда
				СтавкаСамогоДорогого = НСтр.СебестоимостьРубБезНДС;
				СтрокаСамогоДорогого = НСтр.ГУИДСтроки;
			КонецЕсли;
			СтавкаСамогоДорогого = Макс(СтавкаСамогоДорогого, Стр2.Себестоимость);
			НСтр.Тариф = Стр2.Тариф;
			НСтр.СтавкаНДС = Стр2.Тариф.СтавкаНДС;
			НСтр.НДСВключенВСтоимость = Стр2.Тариф.СуммаВключаетНДС;
			НСтр.Валюта = Стр2.Валюта;
			НСтр.РаскраситьСтроку = РаскраситьСтроку;
			Если НЕ ПервыйПоставлен Тогда
				НСтр.Выбор = Истина;
				ПервыйПоставлен = Истина;
			КонецЕсли;
		КонецЦикла;
		Для каждого Стр из ТЧ Цикл
			Если Стр.ГУИДСтроки = СтрокаСамогоДорогого Тогда Стр.СамыйВысокий = Истина; Прервать; КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	
	
	/// Режим для обычного выбора тарифа в мультимодалке
	
	Если Параметры.Свойство("ПоискТарифов") Тогда
		ПоискТарифовНаДату = Параметры.ДатаПоиска;
		Организация = Параметры.Организация;
		ГруженыеКТК = Параметры.Груженый;
		РазмерКТК = Параметры.РазмерКТК;
		Для каждого Стр из Параметры.ПоискТарифов Цикл
			ПервыйПоставлен = Ложь;
			РаскраситьСтроку = НЕ РаскраситьСтроку;
			
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("КалькуляцияМорскойСоставляющей", Истина);
			СтруктураПараметров.Вставить("Период", Параметры.ДатаПоиска);
			СтруктураПараметров.Вставить("Поставщик", Стр.Направление.Линия.Контрагент);
			СтруктураПараметров.Вставить("ПунктОтправления", Стр.Направление.ПунктОтправления);
			СтруктураПараметров.Вставить("ПунктНазначения", Стр.Направление.ПунктНазначения);
			//СтруктураПараметров.Вставить("ИгнорироватьПунктНазначения", БезУчетаПунктаНазначения);
			СтруктураПараметров.Вставить("Услуга", Стр.Услуга);
			
			Если ЗначениеЗаполнено(Параметры.РазмерКТК) Тогда
				МРазмерКТК = Новый Массив;
				МРазмерКТК.Добавить(Параметры.РазмерКТК);
				СтруктураПараметров.Вставить("РазмерыКТК", МРазмерКТК);
			КонецЕсли;
			СтруктураПараметров.Вставить("Организация", Организация);
			Если ГруженыеКТК Тогда
				СтруктураПараметров.Вставить("ДляГруженых", Истина);
			Иначе
				СтруктураПараметров.Вставить("ДляПорожних", Истина);
			КонецЕсли;
			
			РЕЗТарифы = Тарификатор_сервер.ПолучитьТарифыПоПараметрам(СтруктураПараметров);
			Для каждого Стр2 из РЕЗТарифы Цикл
				НСтр = ТЧ.Добавить();
				НСтр.ПунктОтправления = Стр.Направление.ПунктОтправления;
				НСтр.ПунктНазначения = Стр.Направление.ПунктНазначения;
				НСтр.Направление = Стр.Направление;
				НСтр.Контрагент = Стр.Направление.Линия;
				НСтр.Услуга = Стр.Услуга;
				НСтр.Размер = Параметры.РазмерКТК;
				НСтр.Себестоимость = Стр2.Себестоимость;
				
				СебестоимостьРубБезНДС = Валюта_сервер.ПересчитатьПоКурсу(Стр2.Себестоимость, Стр2.Валюта, ВалютаРубль,Параметры.ДатаПоиска);
				СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(СебестоимостьРубБезНДС, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Стр2.Тариф.СтавкаНДС), Истина, Стр2.Тариф.СуммаВключаетНДС);
				НСтр.СебестоимостьРубБезНДС = СебестоимостьРубБезНДС - ?(Стр2.Тариф.СуммаВключаетНДС, СуммаНДС, 0); 
				НСтр.СебестоимостьРубСНДС = СебестоимостьРубБезНДС + ?(Стр2.Тариф.СуммаВключаетНДС, 0, СуммаНДС);

				НСтр.Тариф = Стр2.Тариф;
				НСтр.СтавкаНДС = Стр2.Тариф.СтавкаНДС;
				НСтр.НДСВключенВСтоимость = Стр2.Тариф.СуммаВключаетНДС;
				НСтр.Валюта = Стр2.Валюта;
				НСтр.РаскраситьСтроку = РаскраситьСтроку;
				НСтр.ГУИДСтроки = Строка(Новый УникальныйИдентификатор);
				Если НЕ ПервыйПоставлен Тогда
					НСтр.Выбор = Истина;
					ПервыйПоставлен = Истина;
				КонецЕсли;
				НСтр.ТарифПодходитПоПунктуНазначения = Истина;
			КонецЦикла;
			Если РЕЗТарифы.Количество() = 0 Тогда
				НСтр = ТЧ.Добавить();
				НСтр.ПунктОтправления = Стр.Направление.ПунктОтправления;
				НСтр.ПунктНазначения = Стр.Направление.ПунктНазначения;
				НСтр.Направление = Стр.Направление;
				НСтр.Контрагент = Стр.Направление.Линия;
				НСтр.Услуга = Стр.Услуга;
				НСтр.Размер = Параметры.РазмерКТК;
				НСтр.РаскраситьСтроку = РаскраситьСтроку;
				НСтр.ГУИДСтроки = Строка(Новый УникальныйИдентификатор);
				Если НЕ ПервыйПоставлен Тогда
					НСтр.Выбор = Истина;
					ПервыйПоставлен = Истина;
				КонецЕсли;
				НСтр.ТарифПодходитПоПунктуНазначения = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура ТЧВыборПриИзменении(Элемент)
	
	ТекД = Элементы.ТЧ.ТекущиеДанные;
	Если ТекД <> неопределено И ТекД.Выбор Тогда
		Для каждого Стр из ТЧ Цикл
			Если Стр.Направление = ТекД.Направление И Стр.Размер = ТекД.Размер И Стр.Услуга = ТекД.Услуга И Стр.ГУИДСтроки <> ТекД.ГУИДСтроки Тогда Стр.Выбор = Ложь; КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВКалькуляцию(Команда)
	
	Результат = Новый Массив;
	Для каждого Стр из ТЧ Цикл
		Если Стр.Выбор Тогда
			Результат.Добавить(Новый Структура("Направление, Услуга, Себестоимость, Тариф, СтавкаНДС, Валюта, Максимум, Размер, НДСВключенВСтоимость", Стр.Направление, Стр.Услуга, Стр.Себестоимость, Стр.Тариф, Стр.СтавкаНДС, Стр.Валюта, Стр.СамыйВысокий, Стр.Размер, Стр.НДСВключенВСтоимость));
		КонецЕсли;
	КонецЦикла;
	
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура БезУчетаПунктаНазначенияПриИзменении(Элемент)
	
	Элементы.тч.ОтборСтрок = ?(БезУчетаПунктаНазначения, неопределено, Новый ФиксированнаяСтруктура("ТарифПодходитПоПунктуНазначения", Истина));	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	БезУчетаПунктаНазначенияПриИзменении(неопределено);
	
КонецПроцедуры
