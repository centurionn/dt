
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	МаршрутизируемыеОбъекты.Ссылка КАК ОбъектЪ,
	               |	МаршрутизируемыеОбъекты.Ссылка В
	               |		(ВЫБРАТЬ
	               |			ЗамещениеДляДокументов.ОбъектЪ КАК ОбъектЪ
	               |		ИЗ
	               |			Документ.Замещение.ДляДокументов КАК ЗамещениеДляДокументов
	               |		ГДЕ
	               |			ЗамещениеДляДокументов.Ссылка = &Ссылка) КАК Пометка
	               |ИЗ
	               |	Перечисление.МаршрутизируемыеОбъекты КАК МаршрутизируемыеОбъекты";
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Ответ = запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТЧ.Добавить(), Ответ);
	КонецЦикла;
	
	ПериодДействия.ДатаНачала = Объект.НачалоПериодаЗамещения;
	ПериодДействия.ДатаОкончания = Объект.КонецПериодаЗамещения;

	//Евросиб Коханенко Н.А. 09.12.2022 (( #61705
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. 09.12.2022 ))#61705
	
	//Евросиб Коханенко Н.А. 15.09.2023 (( Ticket#0325322
	РежимДокумента = 0;
	//Евросиб Коханенко Н.А. 15.09.2023 )) Ticket#0325322 
КонецПроцедуры

