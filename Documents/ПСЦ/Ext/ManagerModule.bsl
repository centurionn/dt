Функция СформироватьОписаниеЛокацийРУС(МассивЛокаций)
	
	МассивРусНаименований = Новый Массив;
	Для каждого Стр из МассивЛокаций Цикл
		МассивРусНаименований.Добавить(Стр.Наименование);
	КонецЦикла;
	
	ВОзврат СтрСоединить(МассивРусНаименований, "; ");
	
КонецФункции

Функция СформироватьОписаниеЛокацийАНГЛ(МассивЛокаций)
	
	МассивАнглНаименований = Новый Массив;
	Для каждого Стр из МассивЛокаций Цикл
		МассивАнглНаименований.Добавить(Стр.НаименованиеАнгл);
	КонецЦикла;
	
	ВОзврат СтрСоединить(МассивАнглНаименований, "; ");
	
КонецФункции

Процедура СравнитьКалькуляции(Объект) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ПСЦКалькуляции.Калькуляция КАК Калькуляция
	|ПОМЕСТИТЬ втКалькуляцииСсылки
	|ИЗ
	|	Документ.ПСЦ.Калькуляции КАК ПСЦКалькуляции
	|ГДЕ
	|	ПСЦКалькуляции.Ссылка = &ПСЦ
	|	И ПСЦКалькуляции.Калькуляция <> ЗНАЧЕНИЕ(Документ.Калькуляция.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КалькуляцииОбъекта.Калькуляция КАК Калькуляция
	|ПОМЕСТИТЬ втКалькуляцииОбъекта
	|ИЗ
	|	&КалькуляцииОбъекта КАК КалькуляцииОбъекта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втКалькуляцииОбъекта.Калькуляция КАК Калькуляция
	|ПОМЕСТИТЬ втЗаполненныеКалькуляцииОбъекта
	|ИЗ
	|	втКалькуляцииОбъекта КАК втКалькуляцииОбъекта
	|ГДЕ
	|	втКалькуляцииОбъекта.Калькуляция <> ЗНАЧЕНИЕ(Документ.Калькуляция.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втКалькуляцииСсылки.Калькуляция КАК Калькуляция
	|ИЗ
	|	втКалькуляцииСсылки КАК втКалькуляцииСсылки
	|		ПОЛНОЕ СОЕДИНЕНИЕ втЗаполненныеКалькуляцииОбъекта КАК втЗаполненныеКалькуляцииОбъекта
	|		ПО втКалькуляцииСсылки.Калькуляция = втЗаполненныеКалькуляцииОбъекта.Калькуляция
	|ГДЕ
	|	(втЗаполненныеКалькуляцииОбъекта.Калькуляция ЕСТЬ NULL
	|			ИЛИ втКалькуляцииСсылки.Калькуляция ЕСТЬ NULL)";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("ПСЦ", Объект.Ссылка);
	Запрос.УстановитьПараметр("КалькуляцииОбъекта", Объект.Калькуляции.Выгрузить());
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		// Калькуляции отличаются, обновим данные для печатим
		ЗаполнитьДанныеДляПечати(Объект);
	КонецЕсли;
	
КонецПроцедуры	
