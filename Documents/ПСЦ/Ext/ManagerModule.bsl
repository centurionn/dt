// ДИТ US 64822 Сержантова А.С. Начало: 02.10.2023
Процедура ОтправитьПСЦВДО(ПараметрыВыполнения, АдресРезультата) Экспорт   
	
	// ДИТ BUG 85918 ТА 85919 Сержантова А.С. Начало: 27.05.2024
	ПСЦСсылка = ПараметрыВыполнения.ПСЦСсылка;    
	ЭтоЗавершениеСогласования = ПараметрыВыполнения.ЭтоЗавершениеСогласования;
	// ДИТ BUG 85918 ТА 85919 Сержантова А.С. Конец: 27.05.2024
	
	ОтправкаСканКопии = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПСЦ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Файлы КАК Файлы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПСЦ КАК ПСЦ
		|		ПО (ПСЦ.Ссылка = Файлы.ВладелецФайла)
		|			И (Файлы.ЭтоСканКопия)
		|ГДЕ
		|	ПСЦ.Ссылка = &Ссылка
		|	И НЕ Файлы.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Ссылка", ПСЦСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если не РезультатЗапроса.Пустой() Тогда
		ОтправкаСканКопии = Истина;
	КонецЕсли;	  
	
	// ДИТ BUG 85918 ТА 85919 Сержантова А.С. Начало: 27.05.2024
	РеквизитыПСЦ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПСЦСсылка, 
				"СсылкаНаВнутреннийДокументДО, СтатусДокумента, Организация, ТипКалькуляции, ПСЦПоставщика, ПодписанСДвухСторон");
	// ДИТ BUG 85918 ТА 85919 Сержантова А.С. Конец: 27.05.2024
	
	Если (не ЗначениеЗаполнено(РеквизитыПСЦ.СсылкаНаВнутреннийДокументДО) ИЛИ ЭтоЗавершениеСогласования ИЛИ ОтправкаСканКопии)
		и (РеквизитыПСЦ.СтатусДокумента = Перечисления.СтатусыСогласования.СогласованоБезЗамечаний
		или РеквизитыПСЦ.СтатусДокумента = Перечисления.СтатусыСогласования.СогласованСКомментариями
		или РеквизитыПСЦ.СтатусДокумента = Перечисления.СтатусыСогласования.Подписано) Тогда
		
		// ограничение - не выгружаем если организация ДКП и Тип калькуляции межсервисные расходы/ межсервисные расходы реф   
		ОрганизацияДКП = Константы.ОсновнаяОрганизация.Получить();
		Если не (РеквизитыПСЦ.Организация = ОрганизацияДКП и 
			(РеквизитыПСЦ.ТипКалькуляции = Перечисления.ТипыКалькуляций.МежсервисныеРасходы 
			или РеквизитыПСЦ.ТипКалькуляции = Перечисления.ТипыКалькуляций.МежсервисныеРасходыРеф)) Тогда
			
			ДанныеДляОтправки = ЕСОбменСервер.ПодготовитьТаблицуПСЦдляОтправкиДО(ПСЦСсылка);
			// ПСЦ поставщика отправляем в ДО после установки даты подписания с двух сторон 
			Если РеквизитыПСЦ.ПСЦПоставщика и РеквизитыПСЦ.ПодписанСДвухСторон Тогда
				ЕСОбменСервер.СоздатьКарточкуПСЦвДО(ДанныеДляОтправки);  
			ИначеЕсли не РеквизитыПСЦ.ПСЦПоставщика Тогда 	
				ЕСОбменСервер.СоздатьКарточкуПСЦвДО(ДанныеДляОтправки);  
			КонецЕсли;
			
			Если СтрНайти(ДанныеДляОтправки[0].Сообщение, "ОК") <> 0 Тогда   
				// ДИТ BUG 85918 ТА 85919 Сержантова А.С. Начало: 27.05.2024
				Объект = ПСЦСсылка.ПолучитьОбъект();
				// ДИТ BUG 85918 ТА 85919 Сержантова А.С. Конец: 27.05.2024
				Объект.СсылкаНаВнутреннийДокументДО = ДанныеДляОтправки[0].Ссылка_В_ДО;  
				Попытка
					Объект.ОбменДанными.Загрузка = Истина;	
					Объект.Записать(РежимЗаписиДокумента.Запись);				
				Исключение
				    //Сообщить("Добавлена ссылка на внутренний документ в Документообороте. Необходимо записать Протокол!");
				КонецПопытки;
			КонецЕсли;
			
		КонецЕсли;   	
	КонецЕсли;	
	
КонецПроцедуры	

