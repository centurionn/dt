//Евросиб Каблов 17.12.2025 Ticket#0426699
Функция ПроверитьИзменениеКлючевыхПолейДляОбменаСДО(ДокОбъект) Экспорт
		
	МожноВыгружать = Ложь;
	Если ДокОбъект.Проведен И ЗначениеЗаполнено(ДокОбъект.ДатаСогласования) Тогда
		Если ДокОбъект.ПСЦПоставщика Тогда
			Если ДокОбъект.ПодписанСДвухСторон Тогда
				МожноВыгружать = Истина;
			КонецЕсли;
		Иначе
			МожноВыгружать = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ИзмененияЕсть = Ложь;
	
	Если МожноВыгружать Тогда
		
		СписокРеквизитовДляСравнения = "ДатаСогласования, ДатаПСЦ, НомерПСЦ, НачалоДействия, ОкончаниеДействия, ДействуетДоСогласованияНовыхУсловий, Автор, ПодписанСДвухСторон, ОтветственныйМенеджер, Контрагент, Договор, НетиповойПротокол";
		ЗначенияРеквизитовСсылки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокОбъект.Ссылка, СписокРеквизитовДляСравнения);
		ЗначенияРеквизитовОбъекта = Новый Структура(СписокРеквизитовДляСравнения);
		ЗаполнитьЗначенияСвойств(ЗначенияРеквизитовОбъекта, ДокОбъект);
		
		ИзмененияЕсть = Не ОбщегоНазначения.КоллекцииИдентичны(ЗначенияРеквизитовОбъекта, ЗначенияРеквизитовСсылки);
		
	КонецЕсли;
			
	Возврат ИзмененияЕсть;
	
КонецФункции

