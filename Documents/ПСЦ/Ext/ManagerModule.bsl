Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПСЦ_одноязычный") Тогда
		
		// отключено
		Для каждого ЭлМассива из МассивОбъектов Цикл
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПСЦ_одноязычный", "Протокол одноязычный (компл. ставка)", НапечататьОдноязычныйПСЦ_ПоПростомуБезЭтихВашихБСП(МассивОбъектов),,"Документы.ПСЦ.ПФ_MXL_ПротоколОдноязычный_3варианта");
		КонецЦикла;
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПСЦ_двуязычный") Тогда
		
		// отключено
		//Для каждого ЭлМассива из МассивОбъектов Цикл
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПСЦ_двуязычный", "Протокол двуязычный", НапечататьДвуязычныйПСЦ_ПоПростомуБезЭтихВашихБСП(МассивОбъектов),,"Документы.ПСЦ.ПФ_MXL_ПротоколДвуязычный");
		//КонецЦикла;
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПСЦ_одноязычный2") Тогда
		
		//Для каждого ЭлМассива из МассивОбъектов Цикл
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПСЦ_одноязычный2", "Протокол клиента", ИнтеллектуальныйОпределительФорматаПротокола(МассивОбъектов, , ОбъектыПечати),,"Документы.ПСЦ.ПФ_MXL_ПротоколДвуязычный");
		//КонецЦикла;

		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПСЦ_одноязычный2") Тогда
		
		// отключено
		Для каждого ЭлМассива из МассивОбъектов Цикл
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПСЦ_одноязычный2", "Протокол одноязычный (ставка за ктк)", НапечататьОдноязычный2ПСЦ_ПоПростомуБезЭтихВашихБСП(МассивОбъектов),,"Документы.ПСЦ.ПФ_MXL_ПротоколДвуязычный");
		КонецЦикла;
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПСЦ_одноязычный3") Тогда
		
		// отключено
		Для каждого ЭлМассива из МассивОбъектов Цикл
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПСЦ_одноязычный3", "Протокол одноязычный (ставка за вагон)", НапечататьОдноязычный3ПСЦ_ПоПростомуБезЭтихВашихБСП(МассивОбъектов),,"Документы.ПСЦ.ПФ_MXL_ПротоколДвуязычный");
		КонецЦикла;

	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПСЦ_ОдноязычныйУниверсальный") Тогда
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ВыводитьФаксимиле", Ложь);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПСЦ_ОдноязычныйУниверсальный", "Протокол одноязычный", ИнтеллектуальныйОпределительФорматаПротокола(МассивОбъектов, ДопПараметры, ОбъектыПечати),,"Документы.ПСЦ.ПФ_MXL_ПротоколОдноязычныйУниверсальный");
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПСЦ_ОдноязычныйУниверсальныйФаксимиле") Тогда
//ДИТ Давудов М.А. Ticket#0234739 16.06.2021 Начало
		ИтераторПоКоличествуОбъектовПечати = МассивОбъектов.Количество() - 1; // Итератор для обхода массива объектов
		КоличествоДокументовНаПечать = МассивОбъектов.Количество(); // Количество ссылок в массиве

		Пока ИтераторПоКоличествуОбъектовПечати >= 0 Цикл
			Если МассивОбъектов[ИтераторПоКоличествуОбъектовПечати].СтатусДокумента <> Перечисления.СтатусыСогласования.СогласованоБезЗамечаний
			   И МассивОбъектов[ИтераторПоКоличествуОбъектовПечати].СтатусДокумента <> Перечисления.СтатусыСогласования.СогласованСКомментариями
			   И МассивОбъектов[ИтераторПоКоличествуОбъектовПечати].СтатусДокумента <> Перечисления.СтатусыСогласования.Подписано Тогда
			   
			   	Если КоличествоДокументовНаПечать = 1 Тогда
					ТекстСообщения = НСтр("ru = 'Протокол не согласован! Печать с факсимиле невозможна!'");
			    Иначе
					ТекстСообщения = НСтр("ru = 'Протокол ""%Протокол%"" не согласован! Печать с факсимиле невозможна!'");   
			        ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Протокол%", МассивОбъектов[ИтераторПоКоличествуОбъектовПечати].Ссылка);
				КонецЕсли;
				
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				
				МассивОбъектов.Удалить(ИтераторПоКоличествуОбъектовПечати);
			КонецЕсли;
			
			ИтераторПоКоличествуОбъектовПечати = ИтераторПоКоличествуОбъектовПечати - 1;
		КонецЦикла;
//ДИТ Давудов М.А. Ticket#0234739 16.06.2021 Конец
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ВыводитьФаксимиле", Истина);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПСЦ_ОдноязычныйУниверсальныйФаксимиле", "Протокол одноязычный", ИнтеллектуальныйОпределительФорматаПротокола(МассивОбъектов, ДопПараметры, ОбъектыПечати),,"Документы.ПСЦ.ПФ_MXL_ПротоколОдноязычныйУниверсальный");
		
	//Евросиб Коханенко Н.А. 17.10.2024 (( #92915
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПСЦ_Нотис") Тогда  
	
		Если КоллекцияПечатныхФорм.Количество() > 0 Тогда
			ИмяФайлаПечатнойФормы = "Документы.ПСЦ.ПФ_MXL_Нотис";
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("ВыводитьФаксимиле", Ложь);
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПСЦ_Нотис", "Нотис ВРП", ИнтеллектуальныйОпределительФорматаПротокола(МассивОбъектов, ДопПараметры, ОбъектыПечати),,ИмяФайлаПечатнойФормы);
		КонецЕсли;
	//Евросиб Коханенко Н.А. 17.10.2024 )) #92915 
	
	КонецЕсли;
	
КонецПроцедуры

Функция ИнтеллектуальныйОпределительФорматаПротокола(МассивОбъектов, ДопПараметры = Неопределено, ОбъектыПечати) Экспорт
	
	Результат = Новый ТабличныйДокумент;
	Результат.АвтоМасштаб = Истина;
	
	Первый = Истина;
	Для каждого Док из МассивОбъектов Цикл
		
		НомерСтрокиНачало = Результат.ВысотаТаблицы + 1; // Для задания области печати
		
		ПодМассивОб = Новый Массив;
		ПодМассивОб.Добавить(Док);
		
		Если НЕ Первый Тогда Результат.ВывестиГоризонтальныйРазделительСтраниц(); КонецЕсли;

		//Евросиб Коханенко Н.А. 17.10.2024 (( #92915 
		//Если Док.ФорматПротокола = Перечисления.ФорматПротокола.ПротоколОдноязычныйВаг Тогд
		Если Док.Нотис Тогда
			
			Если Док.ФорматНотиса = Перечисления.ФорматыНотисов.НотисВРП 
					ИЛИ Док.ФорматНотиса = Перечисления.ФорматыНотисов.НотисВРПНСК
					ИЛИ Док.ФорматНотиса = Перечисления.ФорматыНотисов.НотисРефы  Тогда
				// Евросиб US 90342 Рыбьяков К.А. 02.03.2026 ((
				Рез = ПечатьПротоколов.НапечататьНотисВРП_Рефы_ММ(ПодМассивОб, ДопПараметры);
				//Рез = НапечататьНотисВРП_Рефы_ММ(ПодМассивОб, ДопПараметры);
				// Евросиб Рыбьяков К.А. 02.03.2026 ))
			ИначеЕсли Док.ФорматНотиса = Перечисления.ФорматыНотисов.НотисММИмпорт
					ИЛИ Док.ФорматНотиса = Перечисления.ФорматыНотисов.НотисММЭкспорт Тогда
				// Евросиб US 90342 Рыбьяков К.А. 02.03.2026 ((
				Рез = ПечатьПротоколов.НапечататьНотисВРП_Рефы_ММ(ПодМассивОб, ДопПараметры, Ложь);
				//Рез = НапечататьНотисВРП_Рефы_ММ(ПодМассивОб, ДопПараметры, Ложь);
				// Евросиб Рыбьяков К.А. 02.03.2026 ))
			Иначе
				Возврат Неопределено;
			КонецЕсли;
			
			//ДИТ Пак И.Т. Task34353 12.05.2021 Начало
			НаложитьВодянойЗнакЕслиНеобходимо(Рез, Док);
			//ДИТ Пак И.Т. Task34353 12.05.2021 Конец
			
			Результат.Вывести(Рез);
			
		ИначеЕсли Док.ФорматПротокола = Перечисления.ФорматПротокола.ПротоколОдноязычныйВаг Тогда
