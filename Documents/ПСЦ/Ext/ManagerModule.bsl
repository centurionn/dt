Функция ПреобразованиеВПунктМеню(НомерПункта)
	
	Рез = 0;
	
 	КоличествоСимволов = СтрДлина(НомерПункта);
	НашлиЦифру = Ложь;
	НайденноеЧисло = "";
	
	Для Сч = 1 По КоличествоСимволов Цикл
		Код = КодСимвола(Сред(НомерПункта,Сч)); 
		// Цифры: 48 - 57
		Если Код < 48 ИЛИ Код>57 Тогда
			// если к этому моменту цифра уже была найдена, то при нахождении символа, отличного от цифры, прекращаем цикл по строке
			Если НашлиЦифру Тогда
				Прервать;
			КонецЕсли;
		Иначе
			НайденноеЧисло = Строка(НайденноеЧисло) + Строка(Сред(НомерПункта,Сч,1));
			НашлиЦифру = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Попытка
		Рез = Число(НайденноеЧисло);
	Исключение
		Рез = 0;
	КонецПопытки;
	
	Возврат Рез;
	
КонецФункции

Функция ПолучитьИмяЗначенияПеречисления(ИмяПеречисл, ЗначПеречисл)
	
	Если ТипЗнч(ИмяПеречисл) = Тип("ПеречислениеСсылка.УсловияПеревозкиКТК") Тогда
		ТекПеречисл = "УсловияПеревозкиКТК";
	Иначе
		ТекПеречисл = "УсловияПеревозкиПоПортам";
	КонецЕсли;
	
	ИмяПеречисления = ЗначПеречисл.Метаданные().Имя;
	ИндексЗначенияПеречисления = Перечисления[ИмяПеречисления].Индекс(ЗначПеречисл);
	ИмяЗначенияПеречисления = Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления[ИндексЗначенияПеречисления].Имя;			
	
	Возврат ИмяЗначенияПеречисления;
	
