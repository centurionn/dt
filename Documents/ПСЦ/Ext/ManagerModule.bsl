Функция ОтработатьШаблоны(ПСЦ, Текст) Экспорт
	
	Результат = Текст;
	
	УстановитьПривилегированныйРежим(Истина);
	
	//Евросиб Каблов 23.08.2020 (
	Шаблон = "##СрокДействияУсловийПротокола";
	Если СтрНайти(Результат, Шаблон) > 0 Тогда
		Если ПСЦ.ДействуетДоСогласованияНовыхУсловий Тогда
			Результат = СтрЗаменить(Результат, Шаблон, "согласования новых условий");
		ИначеЕсли ЗначениеЗаполнено(ПСЦ.ОкончаниеДействия) Тогда
			Результат = СтрЗаменить(Результат, Шаблон, Формат(ПСЦ.ОкончаниеДействия, "ДФ=dd.MM.yyyy"));
		Иначе
			Результат = СтрЗаменить(Результат, Шаблон, "");
		КонецЕсли;
	КонецЕсли;
	
	Шаблон = "##СтавкаНДСВознагражденияВТомЧислеКромеТого";
	Если СтрНайти(Результат, Шаблон) > 0 Тогда
		Если ЗначениеЗаполнено(ПСЦ.СтавкаНДСВознаграждения) И ПСЦ.СтавкаНДСВознаграждения <> Перечисления.СтавкиНДС.БезНДС Тогда
			ВставляемыйТекст = СтрШаблон("(%1 НДС %2)", ?(ПСЦ.СуммаВознагражденияВключаетНДС, "в т.ч.", "кроме того"), Строка(ПСЦ.СтавкаНДСВознаграждения));
			Результат = СтрЗаменить(Результат, Шаблон, ВставляемыйТекст);
		Иначе
			Результат = СтрЗаменить(Результат, Шаблон, "");
		КонецЕсли;
	КонецЕсли;
	
	Шаблон = "##СтавкаНДСВознаграждения";
	Если СтрНайти(Результат, Шаблон) > 0 Тогда
		Если ЗначениеЗаполнено(ПСЦ.СтавкаНДСВознаграждения) Тогда
			Результат = СтрЗаменить(Результат, Шаблон, Строка(ПСЦ.СтавкаНДСВознаграждения));
		Иначе
			Результат = СтрЗаменить(Результат, Шаблон, "");
		КонецЕсли;
	КонецЕсли;
	
	Шаблон = "##НаименованиеПодписиИсполнителяВРодительномПадеже";
	Если СтрНайти(Результат, Шаблон) > 0 Тогда
		ВставляемыйТекст = "";
		Если ПСЦ.НаименованиеУслугиВознагражденияДляДоговорнойЦеныВР = Справочники.НаименованияУслугиВознагражденияДляДоговорнойЦеныВР.Вознаграждение
				И ЗначениеЗаполнено(ПСЦ.НаименованиеПодписиИсполнителя) Тогда
			ВставляемыйТекст = ПСЦ.НаименованиеПодписиИсполнителя.НаименованиеВРодительномПадеже;
		КонецЕсли;
		Результат = СтрЗаменить(Результат, Шаблон, ВставляемыйТекст);
	КонецЕсли;
	
	Шаблон = "##НаименованиеПодписиКлиентаВРодительномПадеже";
	Если СтрНайти(Результат, Шаблон) > 0 Тогда
		ВставляемыйТекст = "";
		Если ЗначениеЗаполнено(ПСЦ.НаименованиеПодписиКлиента) Тогда
			ВставляемыйТекст = ПСЦ.НаименованиеПодписиКлиента.НаименованиеВРодительномПадеже;
		КонецЕсли;
		Результат = СтрЗаменить(Результат, Шаблон, ВставляемыйТекст);
	КонецЕсли;
	//Евросиб Каблов 23.08.2020 )
	
	Для каждого Стр из Метаданные.Документы.ПСЦ.Реквизиты Цикл
		
		Результат = СтрЗаменить(Результат, "##"+Стр.Имя, Формат(ПСЦ[Стр.Имя], "ЧДЦ=2; ЧН=; ЧГ=; ДФ=dd.MM.yyyy; БЛ=Нет; БИ=Да"));
		
	КонецЦикла;
	
	Результат = СтрЗаменить(Результат, "##НомерДоговора", Формат(ПСЦ.Договор.Номер, "ЧДЦ=2; ЧН=; ЧГ=; ДФ=dd.MM.yyyy; БЛ=Нет; БИ=Да"));
	Результат = СтрЗаменить(Результат, "##ДатаДоговора", Формат(ПСЦ.Договор.Дата, "ЧДЦ=2; ЧН=; ЧГ=; ДФ=dd.MM.yyyy; БЛ=Нет; БИ=Да"));
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

