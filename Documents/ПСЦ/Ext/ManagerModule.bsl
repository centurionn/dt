	КолонкиТаблицы.Вставить("ДоговорнаяЦенаНДС", Новый Структура("Наименование, Ширина", ЗаголовокКолонки, 5));
	КолонкиТаблицы.Вставить("ДоговорнаяЦенаСУчетомНДС", Новый Структура("Наименование, Ширина", "Договорная цена (с учетом НДС)", 5));
	
	Если Протокол.СуммаВключаетНДС Тогда
		ЗаголовокКолонки = "Ставка НДС в том числе";
	Иначе
		ЗаголовокКолонки = "Ставка НДС кроме того";
	КонецЕсли;
	КолонкиТаблицы.Вставить("СтавкаНДС", Новый Структура("Наименование, Ширина", ЗаголовокКолонки, 4));
	
	ЗаголовокКолонки = "##НаименованиеУслугиВознагражденияДляДоговорнойЦеныВР ##НаименованиеПодписиИсполнителяВРодительномПадеже";
	ЗаголовокКолонки = Документы.ПСЦ.ОтработатьШаблоны(Протокол, ЗаголовокКолонки);
	
	КолонкиТаблицы.Вставить("ПроцентВознаграждения", Новый Структура("Наименование, Ширина", ЗаголовокКолонки, 4));
	
	Если Протокол.СуммаВознагражденияВключаетНДС Тогда
		ЗаголовокКолонки = "Ставка НДС в том числе";
	Иначе
		ЗаголовокКолонки = "Ставка НДС кроме того";
	КонецЕсли;	
	КолонкиТаблицы.Вставить("СтавкаНДСВознаграждения", Новый Структура("Наименование, Ширина", ЗаголовокКолонки, 4));
	
	ШаблонКоординатШапки = "R1C2:R1C%1";
	ШаблонКоординатСтроки = "R2C2:R2C%1";
		
	СвойстваКолонки = КолонкиТаблицы.Получить("НомерПоПорядку");
	КоординатыОбласти = СтрШаблон(ШаблонКоординатШапки, СвойстваКолонки.Ширина + 1);
	ОбластьШапкаТаблицыНомерПоПорядку = Макет.ПолучитьОбласть(КоординатыОбласти);
	ОбластьШапкаТаблицыНомерПоПорядку.Область().Объединить();
	ОбластьШапкаТаблицыНомерПоПорядку.Параметры.НаименованиеКолонки = "№" + Символы.ПС + "п/п";
	//СвойстваКолонки.Вставить("ОбластьШапка", ОбластьШапкаТаблицы);
	ОбластьОтступ = Макет.ПолучитьОбласть("R1C1:R1C1");
	
	КоординатыОбласти = СтрШаблон(ШаблонКоординатСтроки, СвойстваКолонки.Ширина + 1);
	ОбластьСтрокаТаблицыНомерПоПорядку = Макет.ПолучитьОбласть(КоординатыОбласти);
	ОбластьСтрокаТаблицыНомерПоПорядку.Область().Объединить();
	//СвойстваКолонки.Вставить("ОбластьСтрока", ОбластьСтрокаТаблицы);
	
	ШиринаТаблицы = 0;
	Для Каждого ПолеТаблицы Из ПоляТаблицы Цикл
		СвойстваКолонки = КолонкиТаблицы.Получить(ПолеТаблицы);
		ШиринаТаблицы = ШиринаТаблицы + СвойстваКолонки.Ширина;		
	КонецЦикла;
			
	НужнаяШирина = 49;
	Коэффициент = НужнаяШирина / ШиринаТаблицы;
	Если Коэффициент <> 1 Тогда
		ШиринаТаблицы = 0;
		Для Каждого ПолеТаблицы Из ПоляТаблицы Цикл
			СвойстваКолонки = КолонкиТаблицы.Получить(ПолеТаблицы);
			СвойстваКолонки.Ширина = Окр(СвойстваКолонки.Ширина * Коэффициент, 0);
			ШиринаТаблицы = ШиринаТаблицы + СвойстваКолонки.Ширина;		
		КонецЦикла;
		Разница = НужнаяШирина - ШиринаТаблицы;
		Если ШиринаТаблицы <> НужнаяШирина И ПоляТаблицы.Количество() > 1 Тогда
			ПолеТаблицы = ПоляТаблицы[1];			
			СвойстваКолонки = КолонкиТаблицы.Получить(ПолеТаблицы);
			СвойстваКолонки.Ширина = СвойстваКолонки.Ширина + Разница;
		КонецЕсли;
	КонецЕсли;
	
	ТабДок.Вывести(ОбластьОтступ);
	ТабДок.Присоединить(ОбластьШапкаТаблицыНомерПоПорядку);
	
	Для Каждого ПолеТаблицы Из ПоляТаблицы Цикл
		
		СвойстваКолонки = КолонкиТаблицы.Получить(ПолеТаблицы);
		
		КоординатыОбласти = СтрШаблон(ШаблонКоординатШапки, СвойстваКолонки.Ширина + 1);
		ОбластьШапкаТаблицы = Макет.ПолучитьОбласть(КоординатыОбласти);
		ОбластьШапкаТаблицы.Область().Объединить();
		ОбластьШапкаТаблицы.Параметры.НаименованиеКолонки = ПолучитьСтрокуСПереносами(СвойстваКолонки.Наименование, СвойстваКолонки.Ширина);
		СвойстваКолонки.Вставить("ОбластьШапка", ОбластьШапкаТаблицы);
		
		ТабДок.Присоединить(СвойстваКолонки.ОбластьШапка);
		
		КоординатыОбласти = СтрШаблон(ШаблонКоординатСтроки, СвойстваКолонки.Ширина + 1);
		ОбластьСтрокаТаблицы = Макет.ПолучитьОбласть(КоординатыОбласти);
		ОбластьСтрокаТаблицы.Область().Объединить();
		СвойстваКолонки.Вставить("ОбластьСтрока", ОбластьСтрокаТаблицы);
		
	КонецЦикла;	
	
	//Формирование и упорядочивание таблицы для вывода
	ТекстПоляТаблицы = СтрСоединить(ПоляТаблицы, ", ");
	ТекстПоляТаблицы = ТекстПоляТаблицы + ", ТипСтавки, ВалютаСокр";
	ТаблицаДляВывода = ТаблицаДанных.Скопировать(, ТекстПоляТаблицы);
	ТаблицаДляВывода.Свернуть(ТекстПоляТаблицы);
	ТаблицаДляВывода.Колонки.Добавить("ПорядокПоТипуСтавки", Новый ОписаниеТипов("Число"));
	Для Каждого СтрокаТаблицы Из ТаблицаДляВывода Цикл
		Если СтрокаТаблицы.ТипСтавки = Перечисления.ТипыСтавокПротокола.Ставка Тогда
			СтрокаТаблицы.ПорядокПоТипуСтавки = 0;
		Иначе
			СтрокаТаблицы.ПорядокПоТипуСтавки = 1;
		КонецЕсли;
	КонецЦикла;
	ТаблицаДляВывода.Сортировать("ПорядокПоТипуСтавки");
	
	//Вывод таблицы
	НомерПоПорядку = 0;
	Для Каждого СтрокаТаблицы Из ТаблицаДляВывода Цикл		
		
		ТабДок.Вывести(ОбластьОтступ);
		
		НомерПоПорядку = НомерПоПорядку + 1;
		ОбластьСтрокаТаблицыНомерПоПорядку.Параметры.ЗначениеПоля = НомерПоПорядку;
		ТабДок.Присоединить(ОбластьСтрокаТаблицыНомерПоПорядку);
		
		Для Каждого ПолеТаблицы Из ПоляТаблицы Цикл
			
			СвойстваПоля = КолонкиТаблицы.Получить(ПолеТаблицы);
			
			ТекущаяОбласть = СвойстваПоля.ОбластьСтрока;
			Если ПолеТаблицы = "ПроцентВознаграждения" Тогда
				ТекущаяОбласть.Параметры.ЗначениеПоля = Формат(СтрокаТаблицы[ПолеТаблицы], "ЧДЦ=2; ЧН=0") + "%";
			ИначеЕсли СтрНайти("ДоговорнаяЦена, ДоговорнаяЦенаБезУчетаНДС, ДоговорнаяЦенаНДС, ДоговорнаяЦенаСУчетомНДС", ПолеТаблицы) > 0 Тогда
				СтавкаТекст = Формат(СтрокаТаблицы[ПолеТаблицы], "ЧДЦ=2; ЧН=0.00");
				Если ФорматПротокола = Перечисления.ФорматПротокола.ПротоколОдноязычныйВаг Тогда
					СтавкаТекст = СтрШаблон("%1%2%3/ваг.", СтавкаТекст, Символы.ПС, СтрокаТаблицы.ВалютаСокр);
				ИначеЕсли ФорматПротокола = Перечисления.ФорматПротокола.ПротоколОдноязычныйКТК Или ФорматПротокола = Перечисления.ФорматПротокола.ПротоколОдноязычныйУниверсальный Тогда
					СтавкаТекст = СтрШаблон("%1%2%3/конт.", СтавкаТекст, Символы.ПС, СтрокаТаблицы.ВалютаСокр);
				КонецЕсли;
				ТекущаяОбласть.Параметры.ЗначениеПоля = СтавкаТекст;				
			Иначе
				ТекстЯчейки = Строка(СтрокаТаблицы[ПолеТаблицы]);	
				ТекущаяОбласть.Параметры.ЗначениеПоля = ПолучитьСтрокуСПереносами(ТекстЯчейки, СвойстваПоля.Ширина);
				//Евросиб Шевченко А.В. US 114750 TA 114751 17.07.2025
				Если ПолеТаблицы = "ДопУсловия" Тогда
					Если СтрНайти(Строка(СтрокаТаблицы[ПолеТаблицы]),Символы.ПС) <> 0 Тогда
						ТекущаяОбласть.Параметры.ЗначениеПоля = Строка(СтрокаТаблицы[ПолеТаблицы]);
					КонецЕсли;
				КонецЕсли;
				//Евросиб Шевченко А.В. US 114750 TA 114751 17.07.2025
			КонецЕсли;
			ТабДок.Присоединить(ТекущаяОбласть);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСтрокуСПереносами(ИсходнаяСтрока, КоличествоЯчеек)
	 	
	//КоличествоСимволов = Цел(КоличествоЯчеек * 1.7);
	//Евросиб(ДИТ), Беляев СЮ, BUG 101636, 24-02-2025, начало
	КоличествоСимволов = Цел(КоличествоЯчеек * 1.5);
	//Евросиб(ДИТ), Беляев СЮ, BUG 101636, 24-02-2025, конец
	Строка2 = ИсходнаяСтрока;
    мСтрок = Новый Массив;
    Пока СтрДлина(СокрЛП(Строка2)) > 0 Цикл
        ИсходнаяСтрока = Строка2;
        Строка1 = "";
        Строка2 = "";
        //Евросиб Коханенко Н.А. 08.09.2025 (( #111204 
		//глПеренестиСловоЛокал(ИсходнаяСтрока, КоличествоСимволов, Строка1, Строка2, -1);
		глПеренестиСловоЛокал(ИсходнаяСтрока, КоличествоСимволов, Строка1, Строка2, 1);
		//Евросиб Коханенко Н.А. 08.09.2025 )) #111204 
		Если Строка1 = "" Тогда
			Слова = СтрРазделить(Строка2, " ");
			Для Каждого Слово Из Слова Цикл 
				мСтрок.Добавить(Слово);
			КонецЦикла;
			Прервать;
		КонецЕсли;
        мСтрок.Добавить(Строка1);		
	КонецЦикла;
	
	Возврат СтрСоединить(мСтрок, Символы.ПС);
	
КонецФункции

// Процедура глПеренестиСлово(_СловоИсточник,_КоличествоСимволов,СловоРезультат1,СловоРезультат2,МягкийПеренос=0)      
//
//	 разбивает исходную строку _СловоИсточник на две строки СловоРезультат1 и СловоРезультат2
//	 при этом в СловоРезультат1 попадает не более _КоличествоСимволов, остальные идут в СловоРезультат2
// 	 параметр МягкийПеренос определяет метод разбиения:
//   МягкийПеренос  =  0   - слова переносятся по слогам;
//   МягкийПеренос  = -1   - слова переносятся по слогам или на символе, не являющемся не буквой не цифрой;
//   МягкийПеренос  =  1   - перенос осуществляется только на символах, не являющихся не буквой не цифрой.
//   Результат возвращается в виде двух строк СловоРезультат1 и СловоРезультат2.
//   
//   Гарантии и предупреждения:
//   отдельные слова делятся на слоги почти всегда корректно; предложения могут переносится некорректно из-за
//   знаков препинания, примыкающих к словам и прочих символов; числа и даты могут переносится некорректно, 
//   если они отформатированы с применением точек, запятых, пробелов и проч. 
// 
//   Рекомендации:
//   если в тексте есть даты и/или форматированные числа, то МягкийПеренос = 0
//   если в тексте нет дат и/или форматированных чисел и необходимо 100% верно перенести слова, то МягкийПеренос=1
//   если в тексте нет дат и/или форматированных чисел то МягкийПеренос=0
//
Процедура глПеренестиСловоЛокал(_СловоИсточник,_КоличествоСимволов,СловоРезультат1,СловоРезультат2,МягкийПеренос=0) Экспорт 
	Алфавит = "абвгдеёжзийклмнопрстуфхцчшщьъыэюяАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЬЪЫЭЮЯ";
	Цифры = "0123456789";
	Гласные = "аеёиоуыэюяАЕЁИОУЫЭЮЯ"; 
	Согласные = "бвгджзйклмнпрстфхцчшщьъБВГДЖЗЙКЛМНПРСТФХЦЧШЩЬЪ";
	СловоРезультат1 = "";
	СловоРезультат2 = "";
	СловоИсточник = СокрЛП(_СловоИсточник);
	КоличествоСимволов = Число(_КоличествоСимволов);
	Если КоличествоСимволов <= 2 Тогда
		СловоРезультат2 = СловоИсточник;
		Возврат;
	ИначеЕсли КоличествоСимволов >= СтрДлина(СловоИсточник) Тогда
		СловоРезультат1 = СловоИсточник;
		Возврат;
	КонецЕсли; 
	
	СловоРезультат1 = Лев(СловоИсточник,КоличествоСимволов);
	СловоРезультат2 = Сред(СловоИсточник,КоличествоСимволов+1);
	
	//мягкий перенос - только на знаках-не-буквах-не-цифрах
	Если МягкийПеренос > 0 Тогда 
		Пока СтрДлина(СловоРезультат1) > 0 Цикл
			Б2 = Прав(СловоРезультат1,1);
			Если (Найти(Алфавит,Б2) = 0) И (Найти(Цифры,Б2) = 0) Тогда
				Прервать;
			КонецЕсли;
			Если СтрДлина(СловоРезультат1) = 1 Тогда
				СловоРезультат1 = "";
				СловоРезультат2 = Б2 + СловоРезультат2;
			Иначе
				СловоРезультат1 = Лев(СловоРезультат1,СтрДлина(СловоРезультат1)-1);
				СловоРезультат2 = Б2 + СловоРезультат2;
			КонецЕсли;
		КонецЦикла;  
	Иначе 
		//пробуем отделить вторую часть слова так, чтобы в первой осталось не менее половины 
		//запрашиваемой длины слова
		ДлинаСлова = КоличествоСимволов;   
		ПоловинаДлиныСлова = Цел(ДлинаСлова/2);
		Пока ДлинаСлова >= ПоловинаДлиныСлова Цикл
			Б1 = Лев(Прав(СловоРезультат1,2),1);
			Б2 = Прав(СловоРезультат1,1);
			Б3 = Лев(СловоРезультат2,1);
			Б4 = Прав(Лев(СловоРезультат2,2),1);
			
			Если МягкийПеренос < 0 Тогда
				//посл. буква -  не буква и не цифра, на ней и переносим
				Если (Найти(Алфавит,Б2) = 0) И (Найти(Цифры,Б2) = 0) Тогда
					Прервать;
				КонецЕсли;    
			КонецЕсли;
			
			МожноПереносить = 0;
			//гггс
			Если ((Найти(Гласные,Б1)<>0) И (Найти(Гласные,Б2)<>0)) И ((Найти(Гласные,Б3)<>0) И (Найти(Согласные,Б4)<>0)) Тогда  
				МожноПереносить = 0;
				//гсгг
			ИначеЕсли ((Найти(Гласные,Б1)<>0) И (Найти(СоГласные,Б2)<>0)) И ((Найти(Гласные,Б3)<>0) И (Найти(Гласные,Б4)<>0)) Тогда
				МожноПереносить = 0;
				//сггг
			ИначеЕсли ((Найти(СоГласные,Б1)<>0) И (Найти(Гласные,Б2)<>0)) И ((Найти(Гласные,Б3)<>0) И (Найти(Гласные,Б4)<>0)) Тогда
				МожноПереносить = 0;
				//ссгс
			ИначеЕсли ((Найти(СоГласные,Б1)<>0) И (Найти(СоГласные,Б2)<>0)) И ((Найти(Гласные,Б3)<>0) И (Найти(СоГласные,Б4)<>0)) Тогда	
				МожноПереносить = 0;  
				Если Найти("ьъйЬЪЙ",Б2)<>0 Тогда
					МожноПереносить = 1;
				КонецЕсли;
				//ссгг
			ИначеЕсли ((Найти(СоГласные,Б1)<>0) И (Найти(СоГласные,Б2)<>0)) И ((Найти(Гласные,Б3)<>0) И (Найти(Гласные,Б4)<>0)) Тогда	
				МожноПереносить = 0;
				//сггс
			ИначеЕсли ((Найти(СоГласные,Б1)<>0) И (Найти(Гласные,Б2)<>0)) И ((Найти(Гласные,Б3)<>0) И (Найти(СоГласные,Б4)<>0)) Тогда	
				МожноПереносить = 0;
				//гсгс
			ИначеЕсли ((Найти(Гласные,Б1)<>0) И (Найти(СоГласные,Б2)<>0)) И ((Найти(Гласные,Б3)<>0) И (Найти(СоГласные,Б4)<>0)) Тогда	
				МожноПереносить = 0;
				//сгсг
			ИначеЕсли ((Найти(СоГласные,Б1)<>0) И (Найти(Гласные,Б2)<>0)) И ((Найти(Согласные,Б3)<>0) И (Найти(Гласные,Б4)<>0)) Тогда
				МожноПереносить = 1;
				//ггсг
			ИначеЕсли ((Найти(Гласные,Б1)<>0) И (Найти(Гласные,Б2)<>0)) И ((Найти(Согласные,Б3)<>0) И (Найти(Гласные,Б4)<>0)) Тогда
				МожноПереносить = 1;
				//сссс
			ИначеЕсли ((Найти(СоГласные,Б1)<>0) И (Найти(СоГласные,Б2)<>0)) И ((Найти(Согласные,Б3)<>0) И (Найти(СоГласные,Б4)<>0)) Тогда	
				МожноПереносить = 1;   
				Если СтрДлина(СловоРезультат2) = 2 Тогда
					МожноПереносить = 0;
				КонецЕсли;
				//сссг
			ИначеЕсли ((Найти(СоГласные,Б1)<>0) И (Найти(СоГласные,Б2)<>0)) И ((Найти(Согласные,Б3)<>0) И (Найти(Гласные,Б4)<>0)) Тогда	
				МожноПереносить = 1;
				//сгсс
			ИначеЕсли ((Найти(СоГласные,Б1)<>0) И (Найти(Гласные,Б2)<>0)) И ((Найти(Согласные,Б3)<>0) И (Найти(СоГласные,Б4)<>0)) Тогда	
				МожноПереносить = 1;
				Если (СтрДлина(СловоРезультат2) = 2) ИЛИ (Найти("ьъйЬЪЙ",Б4)<>0) Тогда
					МожноПереносить = 0;
				КонецЕсли;
				//гссс
			ИначеЕсли ((Найти(Гласные,Б1)<>0) И (Найти(СоГласные,Б2)<>0)) И ((Найти(Согласные,Б3)<>0) И (Найти(СоГласные,Б4)<>0)) Тогда	
				МожноПереносить = 1;
				Если СтрДлина(СловоРезультат2) = 2 Тогда
					МожноПереносить = 0;
				КонецЕсли;
				//ггсс
			ИначеЕсли ((Найти(Гласные,Б1)<>0) И (Найти(Гласные,Б2)<>0)) И ((Найти(Согласные,Б3)<>0) И (Найти(СоГласные,Б4)<>0)) Тогда	
				МожноПереносить = 1;
				Если СтрДлина(СловоРезультат2) = 2 Тогда
					МожноПереносить = 0;
				КонецЕсли;
				//гссг
			ИначеЕсли ((Найти(Гласные,Б1)<>0) И (Найти(СоГласные,Б2)<>0)) И ((Найти(Согласные,Б3)<>0) И (Найти(Гласные,Б4)<>0)) Тогда	
				МожноПереносить = 1;
			КонецЕсли;   
			
			//вторая часть не может: начинаться на ы,ь,ъ,й;
			//первая часть не может: заканчиваться на ы
			Если (Найти("йьъыЙЬЪЫ",Б3) <> 0) ИЛИ (Найти("ыЫ",Б2) <> 0) Тогда
				МожноПереносить = 0;
			КонецЕсли;
			
			Если МожноПереносить = 0 Тогда
				Если СтрДлина(СловоРезультат2) = 1 Тогда
					СловоРезультат1 = СловоРезультат1 + СловоРезультат2;
					СловоРезультат2 = "";
					Прервать;
				КонецЕсли;
				СловоРезультат1 = Лев(СловоРезультат1,СтрДлина(СловоРезультат1)-1);
				СловоРезультат2 = Б2 + СловоРезультат2;  
				Если СтрДлина(СловоРезультат1) < ПоловинаДлиныСлова Тогда
					Если (Найти(Цифры,Прав(СловоРезультат1,1))<>0) И (Найти(Цифры,Лев(СловоРезультат2,1))<>0) Тогда
						Пока (Найти(Цифры,Прав(СловоРезультат1,1))<>0) И (Найти(Цифры,Лев(СловоРезультат2,1))<>0) Цикл
							СловоРезультат2 = Прав(СловоРезультат1,1) + СловоРезультат2;
							Если СтрДлина(СловоРезультат1) > 1 Тогда
								СловоРезультат1 = Лев(СловоРезультат1,СтрДлина(СловоРезультат1)-1);
							Иначе
								СловоРезультат1 = "";
								//Евросиб Коханенко Н.А. #66948 14.03.2023 ((
								Прервать;
								//Евросиб Коханенко Н.А. #66948 14.03.2023 ))
							КонецЕсли;
						КонецЦикла;
						Прервать;
					КонецЕсли;
					Прервать;
				КонецЕсли;
				
			Иначе
				Если СтрДлина(СловоРезультат2) = 1 Тогда
					СловоРезультат1 = СловоРезультат1 + СловоРезультат2;
					СловоРезультат2 = "";
				Иначе
					СловоРезультат1 = СловоРезультат1 + "-";
				КонецЕсли;
				Прервать;
			КонецЕсли;
			
			ДлинаСлова = СтрДлина(СловоРезультат1);
		КонецЦикла;
	КонецЕсли;
