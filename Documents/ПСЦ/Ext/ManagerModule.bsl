//ДИТ Кузнецов Е.Е. Ticket#0282110 21.10.2022
Процедура ВывестиЗаголовокПунктаПСЦ(ТабличныйДокумент, ОбластьПроверки, ОбластьПодвал, НомерСтроки, ВсегоПунктов)
	
	//Проверяем последний пункт, если он помещается вместе с подвалом, то выводим его, иначе выводим разделитель
	Если НомерСтроки = ВсегоПунктов Тогда 
		СтрокаСПодвалом = Новый Массив;
		СтрокаСПодвалом.Добавить(ОбластьПроверки);
		СтрокаСПодвалом.Добавить(ОбластьПодвал);
		РезультатПроверкиВывода = ПечатьБухгалтерскихДокументов.ПроверитьВыводТабличногоДокумента(ТабличныйДокумент, СтрокаСПодвалом);
		
		Если Не РезультатПроверкиВывода Тогда 
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(ОбластьПроверки);	
	
КонецПроцедуры

