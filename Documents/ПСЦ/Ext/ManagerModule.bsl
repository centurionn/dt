// Евросиб US 87896 TA 90558 Рыбьяков К.А. 17.09.2024 ((
Функция СформироватьОписаниеЛокаций(КалькуляцияСсылка, Список, Англ)
	
	МассивНаименований = Новый Массив;
	Для Каждого Строка Из Список Цикл
		Если Строка.Ссылка = КалькуляцияСсылка Тогда
			Если Англ Тогда
				Если Строка.НаименованиеАнгл <> "" Тогда
					МассивНаименований.Добавить(Строка.НаименованиеАнгл);
				КонецЕсли;
			Иначе
				Если Строка.Наименование <> "" Тогда
					МассивНаименований.Добавить(Строка.Наименование);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
