Процедура НаложитьВодянойЗнакЕслиНеобходимо(ТабДок, Документ)
	
	Статус = Документ.СтатусДокумента;
	
	НуженЗнак = Не ЗначениеЗаполнено(Статус);  // т.е. "Не согласовано"
	НуженЗнак = НуженЗнак Или (Статус = Перечисления.СтатусыСогласования.Планируется);
	НуженЗнак = НуженЗнак Или (Статус = Перечисления.СтатусыСогласования.СогласованоСЗамечаниями);
	НуженЗнак = НуженЗнак Или (Статус = Перечисления.СтатусыСогласования.НаРассмотрении);
	НуженЗнак = НуженЗнак Или (Статус = Перечисления.СтатусыСогласования.ОтклоненоСЗамечаниями);
	НуженЗнак = НуженЗнак Или (Статус = Перечисления.СтатусыСогласования.ОтклоненоБезЗамечаний);
	
	Если НуженЗнак Тогда
		НаложитьВодянойЗнакПостранично(ТабДок);
	КонецЕсли;
	
КонецПроцедуры

//ДИТ Пак И.Т. Task34353 12.05.2021
Процедура НаложитьВодянойЗнакПостранично(ТабДок)
	
	СтраницыТД = РазбитьТабличныйДокументПостранично(ТабДок);
	
	Если СтраницыТД.Количество() = 0 Тогда
		Возврат;
	ИначеЕсли СтраницыТД.Количество() = 1 Тогда
		НаложитьВодянойЗнакНаПервуюСтраницу(ТабДок);
		Возврат;
	КонецЕсли;
	
	Холст = Новый ТабличныйДокумент;
	Начало = Истина;
	
	
	Для каждого СтраницаТД Из СтраницыТД Цикл
		
		Если Начало Тогда
			Начало = Ложь;
		Иначе
			Холст.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		НаложитьВодянойЗнакНаПервуюСтраницу(СтраницаТД);
		Холст.Вывести(СтраницаТД);
		
	КонецЦикла;
	
	ТабДок = Холст;
	
КонецПроцедуры

//ДИТ Пак И.Т. Task34353 12.05.2021
Процедура НаложитьВодянойЗнакНаПервуюСтраницу(ТабДок)
	
	ДвДанные = ПолучитьМакет("ФайлКартинкиВодянойЗнак");
	
	Рисунок = ТабДок.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка);
	Рисунок.Верх   = 1;
	Рисунок.Лево   = 1;
	Рисунок.Высота = ТабДок.ВысотаСтраницы; 
	Рисунок.Ширина = ТабДок.ШиринаСтраницы; 
	
	Рисунок.Картинка = Новый Картинка(ДвДанные, Истина); 
	Рисунок.РазмерКартинки = РазмерКартинки.Растянуть;
	
	Рисунок.ГраницаСверху = Ложь;
	Рисунок.ГраницаСнизу  = Ложь;
	Рисунок.ГраницаСлева  = Ложь;
	Рисунок.ГраницаСправа = Ложь;
	Рисунок.Узор = ТипУзораТабличногоДокумента.БезУзора;
	
//ДИТ Давудов М.А. Ticket#0305235 29.03.2023 Начало
	Рисунок.ЦветФона = Новый Цвет;
	Рисунок.Линия = Новый Линия(ТипЛинииРисункаТабличногоДокумента.НетЛинии, 0);
//ДИТ Давудов М.А. Ticket#0305235 29.03.2023 Конец
КонецПроцедуры

//ДИТ Пак И.Т. Task34353 12.05.2021
Функция РазбитьТабличныйДокументПостранично(ТабДок)
	
	СтраницыТД = Новый Массив;
	
	Если ТабДок.КоличествоСтраниц() < 2 Тогда
		СтраницыТД.Добавить(ТабДок);
		Возврат СтраницыТД;
	КонецЕсли;
	
	НомераСтрокКонцовСтраниц = Новый Массив;
	
	ДостигнутКонец = Ложь;
	
	Для НомерСтроки = 1 По ТабДок.ВысотаТаблицы Цикл
		Если ТабДок.Область(НомерСтроки,, НомерСтроки).КонецСтраницы Тогда
			НомераСтрокКонцовСтраниц.Добавить(НомерСтроки);
			Если НомерСтроки = ТабДок.ВысотаТаблицы Тогда
				ДостигнутКонец = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ДостигнутКонец Тогда
		НомераСтрокКонцовСтраниц.Добавить(ТабДок.ВысотаТаблицы);
	КонецЕсли;
	
	ПредыдущийНомер = 0;
	Для каждого НомерСтрокиКонцаСтраницы Из НомераСтрокКонцовСтраниц Цикл
		СтраницаТД = ТабДок.ПолучитьОбласть(ПредыдущийНомер + 1,, НомерСтрокиКонцаСтраницы);
		СтраницаТД.Область(СтраницаТД.ВысотаТаблицы,, СтраницаТД.ВысотаТаблицы).КонецСтраницы = Ложь;
		СтраницыТД.Добавить(СтраницаТД);
		ПредыдущийНомер = НомерСтрокиКонцаСтраницы;
	КонецЦикла;
	
	Возврат СтраницыТД;
	
КонецФункции

Функция ПолучитьПараметрыМаршрутизации(Объект) Экспорт
	ПараметрыЗапроса = Новый Соответствие;
	ПараметрыЗапроса.Вставить("Организация", Объект.Организация);
	ПараметрыЗапроса.Вставить("Контрагент", Объект.Контрагент);
	ПараметрыЗапроса.Вставить("Договор", Объект.Договор);
	ПараметрыЗапроса.Вставить("Валюта", Объект.Валюта);
	ПараметрыЗапроса.Вставить("СодержитВР", Объект.СодержитВР);
	ПараметрыЗапроса.Вставить("ПротоколНаДоплатныеКТК", Объект.ПротоколНаДоплатныеКТК);
