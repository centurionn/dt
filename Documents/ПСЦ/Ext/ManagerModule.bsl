		ОбластьШапка.Параметры.КраткоеНаименованиеКлиента = Док.Контрагент.Наименование;
		ОбластьШапка.Параметры.ДолжностьРукКлиента = РуководительКонтрагента.ДолжностьРП;
		ОбластьШапка.Параметры.ФИОРукКлиента = РуководительКонтрагента.ФИОРПРус ;
		ОбластьШапка.Параметры.ОснованиеКлиента = РуководительКонтрагента.ОснованиеРус ;
		
		Если ЗначениеЗаполнено(Док.ДоверенностьЗаРуководителя) Тогда
			
			ОбластьШапка.Параметры.ДолжностьРуководителя = Док.ДоверенностьЗаРуководителя.ДолжностьРодительныйПадеж;
			ОбластьШапка.Параметры.ФИОРуководителя = Док.ДоверенностьЗаРуководителя.ФИОПодписантаДляПротокола;
			
			//ОбластьШапка.Параметры.ДолжностьРуководителя = Док.ДоверенностьЗаРуководителя.Должность;
			//ОбластьШапка.Параметры.ФИОРуководителя = Док.ДоверенностьЗаРуководителя.ФИОПодписанта;
			
			ОбластьШапка.Параметры.ОснованиеРуководителя = Док.ДоверенностьЗаРуководителя.ОснованиеДляПодписанияРП;
			
		КонецЕсли;

		
		Результат.Вывести(ОбластьШапка);
		
		///////////////
		ТЧВспомогательная = Док.ТЧ.Выгрузить();
		ТЧВспомогательная.Свернуть("ВидПеревозки,ТерриторияМаршрута");
		ОбластьЗаголовок = Макет.ПолучитьОбласть("ОбластьЗаголовок");
		Для каждого СтрВ из ТЧВспомогательная Цикл
			ОбластьЗаголовок.Параметры.Заголовок = "Вид перевозки: " + СтрВ.ВидПеревозки;
			Результат.Вывести(ОбластьЗаголовок);
			ОбластьЗаголовок.Параметры.Заголовок = "Территория маршрута: " + СтрВ.ТерриторияМаршрута;
			Результат.Вывести(ОбластьЗаголовок);
			
			//Евросиб Каблов М.Б. 31.10.2019 (
			//ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТабл4");
			//Результат.Вывести(ОбластьШапкаТаблицы);
			//
			//ОбластьСтрока = Макет.ПолучитьОбласть("ОбластьТаблица1");
			//Евросиб Каблов М.Б. 31.10.2019 )
			
			
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("ВидПеревозки" , СтрВ.ВидПеревозки);
			СтруктураОтбора.Вставить("ТерриторияМаршрута", СтрВ.ТерриторияМаршрута);
			
			Строки = Док.ТЧ.НайтиСтроки(СтруктураОтбора);
			
			//Евросиб Каблов М.Б. 31.10.2019 (
			ВыводитьДопУсловия = Ложь;
			Для Каждого СтрокаТЧ Из Строки Цикл
				Если ЗначениеЗаполнено(СтрокаТЧ.ДопУсловия) Тогда
					ВыводитьДопУсловия = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ВыводитьДопУсловия Тогда
				ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТабл4");						
				ОбластьСтрока = Макет.ПолучитьОбласть("ОбластьТаблица1");
			Иначе
				ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТабл4БезДопУсловий");						
				ОбластьСтрока = Макет.ПолучитьОбласть("ОбластьТаблица1БезДопУсловий");
			КонецЕсли;
			
			Результат.Вывести(ОбластьШапкаТаблицы);
			//Евросиб Каблов М.Б. 31.10.2019 )
			
			НомерСтроки = 1;
			Для каждого Стр из Строки Цикл
				ОбластьСтрока.Параметры.n = НомерСтроки;
				ОбластьСтрока.Параметры.НаименованиеУслуги = Стр.Услуга;
				ОбластьСтрока.Параметры.МаршрутСледования = Стр.ПунктОтправленияRUS + "-" + Стр.ПунктДоставкиRUS;
				ОбластьСтрока.Параметры.НаименованиеГруза = Стр.Груз;
				ОбластьСтрока.Параметры.ТипСостава = Стр.ВидПС;
				ОбластьСтрока.Параметры.ПринадлежностьСостава = Стр.ПринадлежностьПС;
				//Евросиб Каблов М.Б. 31.10.2019 (
				Если ВыводитьДопУсловия Тогда
					ОбластьСтрока.Параметры.ДопУсловие = Стр.ДопУсловия;
				КонецЕсли;
				//Евросиб Каблов М.Б. 31.10.2019 )
				ОбластьСтрока.Параметры.Цена = Строка(Формат(Стр.СуммаСНДС,"ЧДЦ=2"))+" "+ Стр.Валюта.Наименование + "/вагон";
				ОбластьСтрока.Параметры.СтавкаНДС = Стр.СтавкаНДС;
				Результат.Вывести(ОбластьСтрока);
				НомерСтроки = НомерСтроки+1;
			КонецЦикла;
		КонецЦикла;
					
		/////////////////
		
	
		Для каждого Стр из Док.ПунктыПСЦ Цикл
			
			Если Стр.Заголовок и НЕ ЗначениеЗаполнено(Стр.НомерПункта) Тогда
				ОбластьЗаголовок 							= Макет.ПолучитьОбласть("ОбластьЗаголовок");
				ОбластьЗаголовок.Параметры.Заголовок		= ОтработатьШаблоны(Док, Стр.ТекстПунктаРус);
				Результат.Вывести(ОбластьЗаголовок);
			ИначеЕсли Стр.Заголовок и ЗначениеЗаполнено(Стр.НомерПункта) Тогда
				ОбластьЗаголовок 							= Макет.ПолучитьОбласть("ОбластьПодзаголовок");
				ОбластьЗаголовок.Параметры.n				= Стр.НомерПункта;
				ОбластьЗаголовок.Параметры.Подзаголовок		= ОтработатьШаблоны(Док, Стр.ТекстПунктаРус);
				Результат.Вывести(ОбластьЗаголовок);
			ИначеЕсли НЕ Стр.Заголовок Тогда
				ОбластьЗаголовок 							= Макет.ПолучитьОбласть("ТекстБлока");
				ОбластьЗаголовок.Параметры.n				= Стр.НомерПункта;
				ОбластьЗаголовок.Параметры.ТекстБлокаРус	= ОтработатьШаблоны(Док, Стр.ТекстПунктаРус);
				Результат.Вывести(ОбластьЗаголовок);
			КонецЕсли;
			
		КонецЦикла;
		
			/////////////////
		
		ОбластьПодвал = Макет.ПолучитьОбласть("ОбластьПодписи");
//Евросиб ( Литвинов 21.01.2021 #30025
		//ОбластьПодвал.Параметры.КраткоеНаименование = ?(ЗначениеЗаполнено(Док.Организация.ГоловнаяОрганизация), Док.Организация.ГоловнаяОрганизация.НаименованиеСокращенное, Док.Организация.НаименованиеСокращенное); //Евросиб Гудкова( 17.09.2020 Ticket№ 0206626 Док.Организация.НаименованиеСокращенное;
		//ОбластьПодвал.Параметры.ПолноеНаименование = ?(ЗначениеЗаполнено(Док.Организация.ГоловнаяОрганизация), Док.Организация.ГоловнаяОрганизация.НаименованиеПолное, Док.Организация.НаименованиеПолное); //Евросиб Гудкова( 17.09.2020 Ticket№ 0206626 Док.Организация.НаименованиеПолное;
		ОбластьПодвал.Параметры.КраткоеНаименование = НаименованияНаДату.НаименованиеСокращенное;
		ОбластьПодвал.Параметры.ПолноеНаименование  = НаименованияНаДату.НаименованиеПолное;
//Евросиб ) Литвинов 21.01.2021 #30025
		ОбластьПодвал.Параметры.ФИОРуководителя = НашРуководитель.ФИОРус;
		ОбластьПодвал.Параметры.ДатаПСЦ = Формат(Док.ДатаПСЦ,"ДФ=dd.MM.yyyy");
		ОбластьПодвал.Параметры.КраткоеНаименованиеКлиента  =  Док.Контрагент.Наименование;
		ОбластьПодвал.Параметры.ПолноеНаименованиеКлиента = Док.Контрагент.НаименованиеПолное;
		ОбластьПодвал.Параметры.ФИОРукКлиента = РуководительКонтрагента.ФИОРус;
		
		Если ЗначениеЗаполнено(Док.ДоверенностьЗаРуководителя) Тогда
			ОбластьПодвал.Параметры.ФИОРуководителя = ""+Док.ДоверенностьЗаРуководителя.ФИОПодписанта+Символы.ПС+Док.ДоверенностьЗаРуководителя.ОснованиеДляПодписания;
			//ОбластьПодвал.Параметры.ДолжностьОргРус = ""+ Док.ДоверенностьЗаРуководителя.Должность;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Док.ДоверенностьЗаРуководителя.ФайлФаксимиль) Тогда
			ДанныеКартинкиПодпись = РаботаСФайлами.ДанныеФайла(Док.ДоверенностьЗаРуководителя.ФайлФаксимиль);
			ДвоичныеДанныеПодпись = ПолучитьИзВременногоХранилища(ДанныеКартинкиПодпись.СсылкаНаДвоичныеДанныеФайла);
			Если ЗначениеЗаполнено(ДвоичныеДанныеПодпись) Тогда
				ОбластьПодвал.Рисунки.ПодписьРуководителя.Картинка = Новый Картинка(ДвоичныеДанныеПодпись);
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(Док.ДоверенностьЗаРуководителя.ФайлПечать) тогда
			ДанныеКартинкиПечать = РаботаСФайлами.ДанныеФайла(Док.ДоверенностьЗаРуководителя.ФайлПечать);
			ДвоичныеДанныеПечать = ПолучитьИзВременногоХранилища(ДанныеКартинкиПечать.СсылкаНаДвоичныеДанныеФайла);
			Если ЗначениеЗаполнено(ДвоичныеДанныеПечать) Тогда
				ОбластьПодвал.Рисунки.Печать.Картинка = Новый Картинка(ДвоичныеДанныеПечать);
			КонецЕсли;
		КонецЕсли;

		Результат.Вывести(ОбластьПодвал);
		
		Первый = Ложь;
		
	КонецЦикла;
	
	Возврат Результат;
	
	
КонецФункции

Функция НапечататьОдноязычныйУниверсальныйПротокол(Протоколы, ДопПараметры = Неопределено) Экспорт
	
	Результат = Новый ТабличныйДокумент;
	Результат.АвтоМасштаб = Истина;
	
	ВыводитьФаксимиле = Ложь;
	Если ТипЗнч(ДопПараметры) = Тип("Структура") Тогда
		ДопПараметры.Свойство("ВыводитьФаксимиле", ВыводитьФаксимиле);
		Если ТипЗнч(ВыводитьФаксимиле) <> Тип("Булево") Тогда
			ВыводитьФаксимиле = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Первый = Истина;
	Для каждого Протокол из Протоколы Цикл
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ПСЦ.ПФ_MXL_ПротоколОдноязычныйУниверсальный", Протокол.Контрагент, Протокол.Договор);
		
		Если НЕ Первый Тогда Результат.ВывестиГоризонтальныйРазделительСтраниц(); КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", Протокол);	
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ПСЦ.КлиентскийНомер КАК НомерПротокола,
		|	ПСЦ.ДатаПСЦ КАК ДатаПротокола,
		|	ПСЦ.Договор.Номер КАК НомерДоговора,
		|	ПСЦ.Договор.Дата КАК ДатаДоговора,
		|	ПСЦ.ГородПодписания.Наименование КАК ГородПодписания,
		|	ВЫБОР
		|		КОГДА Организации.Ссылка ЕСТЬ NULL
		|			ТОГДА ПСЦ.Организация.НаименованиеПолное
		|		ИНАЧЕ Организации.НаименованиеПолное
		|	КОНЕЦ КАК НаименованиеИсполнителя,
		|	ПСЦ.НаименованиеПодписиИсполнителя КАК НаименованиеПодписиИсполнителя,
		|	ПСЦ.Контрагент.НаименованиеПолное КАК НаименованиеКлиента,
		|	ПСЦ.НаименованиеПодписиКлиента КАК НаименованиеПодписиКлиента,
		|	ПСЦ.ДоверенностьЗаРуководителя.ФИОПодписанта КАК ДоверенностьЗаРуководителяФИОПодписанта,
		|	ПСЦ.ДоверенностьЗаРуководителя.ФИОПодписантаДляПротокола КАК ДоверенностьЗаРуководителяФИОПодписантаВРодительномПадеже,
		|	ПСЦ.ДоверенностьЗаРуководителя.Должность КАК ДоверенностьЗаРуководителяДолжность,
		|	ПСЦ.ДоверенностьЗаРуководителя.ДолжностьРодительныйПадеж КАК ДоверенностьЗаРуководителяДолжностьРодительныйПадеж,
		|	ПСЦ.ДоверенностьЗаРуководителя.ОснованиеДляПодписания КАК ДоверенностьЗаРуководителяОснованиеДляПодписания,
		|	ПСЦ.ДоверенностьЗаРуководителя.ОснованиеДляПодписанияРП КАК ДоверенностьЗаРуководителяОснованиеВРодительномПадеже,
		|	ПСЦ.ДоверенностьЗаРуководителя.ФайлФаксимиль КАК ДоверенностьЗаРуководителяФайлФаксимиль,
		|	ПСЦ.ДоверенностьЗаРуководителя.ФайлПечать КАК ДоверенностьЗаРуководителяФайлПечать,
		|	ВЫБОР
		|		КОГДА Организации.Ссылка ЕСТЬ NULL
		|			ТОГДА ПСЦ.Организация
		|		ИНАЧЕ Организации.Ссылка
		|	КОНЕЦ КАК Организация,
		|	ПСЦ.Контрагент КАК Контрагент,
		|	ПСЦ.РуководительКонтрагента КАК РуководительКонтрагента,
		|	ПСЦ.РуководительКонтрагента.Наименование КАК ФИОРуководителяКлиента,
		|	ПСЦ.ФорматПротокола КАК ФорматПротокола
		|ИЗ
		|	Документ.ПСЦ КАК ПСЦ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|		ПО ПСЦ.Организация.ГоловнаяОрганизация = Организации.Ссылка
		|ГДЕ
		|	ПСЦ.Ссылка = &Ссылка";
		ДанныеШапки = Запрос.Выполнить().Выбрать();
		ДанныеШапки.Следующий();
		
		ДатаПротокола = Формат(ДанныеШапки.ДатаПротокола, "ДФ=dd.MM.yyyy") + "г.";
		ДатаДоговора = Формат(ДанныеШапки.ДатаДоговора, "ДФ=dd.MM.yyyy") + "г.";
		
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
		ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, ДанныеШапки);
		ОбластьШапка.Параметры.ДатаПротокола = ДатаПротокола;
		ОбластьШапка.Параметры.ДатаДоговора = ДатаДоговора;
//Евросиб ( Литвинов 21.01.2021 #30025
		НаименованияНаДату = Справочники.Организации.НаименованияНаДату(ДанныеШапки.Организация, ДанныеШапки.ДатаПротокола);
		
		ОбластьШапка.Параметры.НаименованиеИсполнителя = НаименованияНаДату.НаименованиеПолное;
//Евросиб ) Литвинов 21.01.2021 #30025
		
		Если ЗначениеЗаполнено(ДанныеШапки.ДоверенностьЗаРуководителяДолжностьРодительныйПадеж) И ЗначениеЗаполнено(ДанныеШапки.ДоверенностьЗаРуководителяФИОПодписантаВРодительномПадеже) Тогда
			ОбластьШапка.Параметры.ДолжностьРуководителяИсполнителя = ДанныеШапки.ДоверенностьЗаРуководителяДолжностьРодительныйПадеж;
			ОбластьШапка.Параметры.ФИОРуководителяИсполнителя = ДанныеШапки.ДоверенностьЗаРуководителяФИОПодписантаВРодительномПадеже;
			ОбластьШапка.Параметры.ОснованиеИсполнителя = ДанныеШапки.ДоверенностьЗаРуководителяОснованиеВРодительномПадеже;
		Иначе
			//РуководительИсполнителя = ОтветственныеЛица_сервер.ПолучитьРуководителя(ДанныеШапки.Организация, ДанныеШапки.ДатаПротокола);
			//Евросиб(ДИТ), Беляев СЮ, BUG 110167 / TA 110622, 29-05-2025, начало
			РуководительИсполнителя = ОтветственныеЛица_сервер.ПолучитьРуководителя(ДанныеШапки.Организация, ДанныеШапки.ДатаПротокола, , , , ТипЗнч(Протокол));
			//Евросиб(ДИТ), Беляев СЮ, BUG 110167 / TA 110622, 29-05-2025, конец
			ОбластьШапка.Параметры.ДолжностьРуководителяИсполнителя = РуководительИсполнителя.ДолжностьРус;
			ОбластьШапка.Параметры.ФИОРуководителяИсполнителя = РуководительИсполнителя.ФИОРПРус;			
			ОбластьШапка.Параметры.ОснованиеИсполнителя = РуководительИсполнителя.ОснованиеРус;
		КонецЕсли;
		
