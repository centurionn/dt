Функция НапечататьОдноязычныйФрахт(МассивОбъектов, ДопПараметры = Неопределено) Экспорт
	
	ВыводитьФаксимиле = Ложь;
	Если ТипЗнч(ДопПараметры) = Тип("Структура") Тогда
		ДопПараметры.Свойство("ВыводитьФаксимиле", ВыводитьФаксимиле);
		Если ТипЗнч(ВыводитьФаксимиле) <> Тип("Булево") Тогда
			ВыводитьФаксимиле = Ложь;
		КонецЕсли;
	КонецЕсли;
	//ДИТ Давудов М.А. Ticket#0236090 01.07.2021 Конец

	Результат = Новый ТабличныйДокумент;
	Результат.АвтоМасштаб = Истина;
	
	Первый = Истина;
	Для каждого Док из МассивОбъектов Цикл
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ПСЦ.ПФ_MXL_ПротоколОдноязычный_Фрахт", Док.Контрагент, Док.Договор);
		
		Если НЕ Первый Тогда Результат.ВывестиГоризонтальныйРазделительСтраниц(); КонецЕсли;
		
		//Евросиб Коханенко Н.А. 15.11.2024 (( #95589 
		//РуководительКонтрагента = ОтветственныеЛица_сервер.ПолучитьРуководителя(Док.Контрагент, Док.Дата, Док.РуководительКонтрагента);
		//РуководительКонтрагента = ОтветственныеЛица_сервер.ПолучитьРуководителя(Док.Контрагент, Док.Дата, Док.РуководительКонтрагента,, Док.ПСЦПоставщика);
		//Евросиб(ДИТ), Беляев СЮ, BUG 110167 / TA 110622, 29-05-2025, начало
		РуководительКонтрагента = ОтветственныеЛица_сервер.ПолучитьРуководителя(Док.Контрагент, Док.Дата, Док.РуководительКонтрагента,, Док.ПСЦПоставщика, ТипЗнч(Док));
		//Евросиб(ДИТ), Беляев СЮ, BUG 110167 / TA 110622, 29-05-2025, конец
		//Евросиб Коханенко Н.А. 15.11.2024 )) #95589 
		НашРуководитель = ОтветственныеЛица_сервер.ПолучитьРуководителя(Док.Организация, Док.Дата);
		
		ОбластьШапка = Макет.ПолучитьОбласть("ОбластьШапка");
		
		ОбластьШапка.Параметры.НомерДоговора = Док.Договор.Номер;
		ОбластьШапка.Параметры.ДатаДоговора = Формат(Док.Договор.Дата, "ДФ=dd.MM.yyyy");
		ОбластьШапка.Параметры.НомерПротокола = Док.НомерПСЦ;
		ОбластьШапка.Параметры.ДатаПСЦ = Строка(Формат(Док.ДатаПСЦ, "ДФ=dd.MM.yyyy")) + " г.";
		ОбластьШапка.Параметры.ГородПодписания = Док.ГородПодписания.Наименование;
//Евросиб ( Литвинов 21.01.2021 #30025
		//ОбластьШапка.Параметры.ПолноеНаименование = ?(ЗначениеЗаполнено(Док.Организация.ГоловнаяОрганизация), Док.Организация.ГоловнаяОрганизация.Наименованиеполное, Док.Организация.Наименованиеполное);//Евросиб Гудкова( 17.09.2020 Ticket№ 0206626 Док.Организация.НаименованиеПолное;
		//ОбластьШапка.Параметры.КраткоеНаименование = ?(ЗначениеЗаполнено(Док.Организация.ГоловнаяОрганизация), Док.Организация.ГоловнаяОрганизация.НаименованиеСокращенное, Док.Организация.НаименованиеСокращенное); //Евросиб Гудкова( 17.09.2020 Ticket№ 0206626 Док.Организация.НаименованиеСокращенное;
		НаименованияНаДату = Справочники.Организации.НаименованияНаДату(?(ЗначениеЗаполнено(Док.Организация.ГоловнаяОрганизация), Док.Организация.ГоловнаяОрганизация, Док.Организация), Док.Дата);
		
		ОбластьШапка.Параметры.ПолноеНаименование = НаименованияНаДату.НаименованиеПолное;
		ОбластьШапка.Параметры.КраткоеНаименование = НаименованияНаДату.НаименованиеСокращенное;
//Евросиб ) Литвинов 21.01.2021 #30025
		ОбластьШапка.Параметры.ДолжностьРуководителя = НашРуководитель.ДолжностьРус;
		ОбластьШапка.Параметры.ФИОРуководителя = НашРуководитель.ФИОРус;
		ОбластьШапка.Параметры.ОснованиеРуководителя = НашРуководитель.ОснованиеРус;
		ОбластьШапка.Параметры.ПолноеНаименованиеКлиента = Док.Контрагент.НаименованиеПолное;
		ОбластьШапка.Параметры.ДолжностьРукКлиента = РуководительКонтрагента.ДолжностьРП;
		ОбластьШапка.Параметры.ФИОРукКлиента = РуководительКонтрагента.ФИОРПРус;
		ОбластьШапка.Параметры.ОснованиеКлиента = РуководительКонтрагента.ОснованиеРус;
		
		Если ЗначениеЗаполнено(Док.ДоверенностьЗаРуководителя) Тогда
			
			ОбластьШапка.Параметры.ДолжностьРуководителя = Док.ДоверенностьЗаРуководителя.ДолжностьРодительныйПадеж;
			ОбластьШапка.Параметры.ФИОРуководителя = Док.ДоверенностьЗаРуководителя.ФИОПодписантаДляПротокола;
			ОбластьШапка.Параметры.ОснованиеРуководителя = Док.ДоверенностьЗаРуководителя.ОснованиеДляПодписанияРП;
			
		КонецЕсли;
		
		Результат.Вывести(ОбластьШапка);
		
		///////////////
		// если перед таблицей должны идти какие-то пункты, то заполняем их.
		// используем для проверки флаг "ПередТаблицей"
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ПередТаблицей",Истина);
		НайденныеСтр = Док.ПунктыПСЦ.НайтиСтроки(ПараметрыОтбора);
		Для каждого Стр из НайденныеСтр Цикл
			
			Если Стр.Заголовок и НЕ ЗначениеЗаполнено(Стр.НомерПункта) Тогда
				ОбластьЗаголовок = Макет.ПолучитьОбласть("ОбластьЗаголовок");
				ОбластьЗаголовок.Параметры.Заголовок = ОтработатьШаблоны(Док, Стр.ТекстПунктаРус);
				Результат.Вывести(ОбластьЗаголовок);
			ИначеЕсли Стр.Заголовок и ЗначениеЗаполнено(Стр.НомерПункта) Тогда
				ОбластьЗаголовок = Макет.ПолучитьОбласть("ОбластьПодзаголовок");
				ОбластьЗаголовок.Параметры.n = Стр.НомерПункта;
				ОбластьЗаголовок.Параметры.Подзаголовок = ОтработатьШаблоны(Док, Стр.ТекстПунктаРус);
				Результат.Вывести(ОбластьЗаголовок);
			ИначеЕсли Стр.ВложенныйСписок Тогда
				ОбластьЗаголовок = Макет.ПолучитьОбласть("ОбластьВложенныйСписок");
				ОбластьЗаголовок.Параметры.Подзаголовок = ОтработатьШаблоны(Док, Стр.ТекстПунктаРус);
				Результат.Вывести(ОбластьЗаголовок);
			ИначеЕсли НЕ Стр.Заголовок Тогда
				ОбластьЗаголовок = Макет.ПолучитьОбласть("ТекстБлока");
				ОбластьЗаголовок.Параметры.n = Стр.НомерПункта;
				ОбластьЗаголовок.Параметры.ТекстБлокаРус = ОтработатьШаблоны(Док, Стр.ТекстПунктаРус);
				Результат.Вывести(ОбластьЗаголовок);
			КонецЕсли;
			
		КонецЦикла;
		
		
		
		ОбластьМаршрутыШапка = Макет.ПолучитьОбласть("ШапкаТабл2");
		ОбластьМаршрутыШапка.Параметры.СтавкаНДС = Док.СтавкаНДС;
		Результат.Вывести(ОбластьМаршрутыШапка);
		
		Для каждого Стр из Док.ТЧ_МорскаяЧасть Цикл
			ОбластьМаршрутыСтрока = Макет.ПолучитьОбласть("ОбластьТабл2");
			ОбластьМаршрутыСтрока.Параметры.НаименованиеУслуги = Стр.Услуга;
			
			Если ЗначениеЗаполнено(Стр.УсловияПеревозки_Отправление) Тогда
				УсловияОтпр = ПолучитьИмяЗначенияПеречисления(Стр.УсловияПеревозки_Отправление, Стр.УсловияПеревозки_Отправление);
			Иначе
				УсловияОтпр = "";
			КонецЕсли;
			Если ЗначениеЗаполнено(Стр.УсловияПеревозки_Прибытие) Тогда
				УсловияПриб = ПолучитьИмяЗначенияПеречисления(Стр.УсловияПеревозки_Прибытие, Стр.УсловияПеревозки_Прибытие);
			Иначе
				УсловияПриб = "";
			КонецЕсли;
			
			ОбластьМаршрутыСтрока.Параметры.МаршрутСледования = Строка(УсловияОтпр) + " " + Строка(Стр.ПортПогрузкиRUS) + " - " + Строка(УсловияПриб) + " " + Строка(Стр.ПунктДоставкиRUS);
			ОбластьМаршрутыСтрока.Параметры.ТипКонтейнера = Стр.ТипКТК;
			СтавкаЗаКонт = Стр.СуммаСНДС; //Формат(Стр.СуммаСНДС, "ЧДЦ=2; ЧГ=");
			ОбластьМаршрутыСтрока.Параметры.Ставка = ?(ЗначениеЗаполнено(СтавкаЗаКонт), Строка(СтавкаЗаКонт) + " " + Стр.Валюта + "/конт.",СтавкаЗаКонт);
			Результат.Вывести(ОбластьМаршрутыСтрока);
		КонецЦикла;
		
		ПоследнийПунктУсловий = Макет.ПолучитьОбласть("ОбластьПримечание");
		ПоследнийПунктУсловий.Параметры.Примечание = Док.ПримечанияПунктовИУсловийПСЦ;
		Результат.Вывести(ПоследнийПунктУсловий);
		
		/////////////////
		
		//++ДИТ Кузнецов Е.Е. Ticket#0282110 21.10.2022
		ОбластьПодвал = Макет.ПолучитьОбласть("ОбластьПодписи");
		ВсегоПунктов = Док.ПунктыПСЦ.Количество();
		//--ДИТ Кузнецов Е.Е. Ticket#0282110 21.10.2022
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ПередТаблицей",Ложь);
		НайденныеСтр = Док.ПунктыПСЦ.НайтиСтроки(ПараметрыОтбора);
		Для каждого Стр из НайденныеСтр Цикл
			
			Если Стр.Заголовок и НЕ ЗначениеЗаполнено(Стр.НомерПункта) Тогда
				ОбластьЗаголовок = Макет.ПолучитьОбласть("ОбластьЗаголовок1");
				ОбластьЗаголовок.Параметры.Заголовок = ОтработатьШаблоны(Док, Стр.ТекстПунктаРус);
				//++ДИТ Кузнецов Е.Е. Ticket#0282110 21.10.2022
