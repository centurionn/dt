Функция ПолучитьТаблицуШаблоновРеквизитов(Протокол = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Шаблоны = Новый ТаблицаЗначений;
	Шаблоны.Колонки.Добавить("Шаблон", Новый ОписаниеТипов("Строка"));
	Шаблоны.Колонки.Добавить("Реквизит", Новый ОписаниеТипов("Строка"));
	Шаблоны.Колонки.Добавить("ПримерЗначения", Новый ОписаниеТипов("Строка"));
	
	Для каждого Стр из Метаданные.Документы.ПСЦ.Реквизиты Цикл
		НСтр = Шаблоны.Добавить();
		НСтр.Шаблон = "##"+Стр.Имя;
		НСтр.Реквизит = Стр.Синоним;
		Если Протокол <> Неопределено Тогда
			НСтр.ПримерЗначения = Формат(Протокол[Стр.Имя], "ЧДЦ=2; ЧН=; ЧГ=; ДФ=dd.MM.yyyy; БЛ=Нет; БИ=Да");
		КонецЕсли;
	КонецЦикла;
	
	НСтр = Шаблоны.Добавить();
	НСтр.Шаблон = "##НомерДоговора";
	НСтр.Реквизит = "Номер договора";
	Если Протокол <> Неопределено Тогда
		НСтр.ПримерЗначения = Формат(Протокол.Договор.Номер, "ЧДЦ=2; ЧН=; ЧГ=; ДФ=dd.MM.yyyy; БЛ=Нет; БИ=Да");
	КонецЕсли;
	
	НСтр = Шаблоны.Добавить();
	НСтр.Шаблон = "##ДатаДоговора";
	НСтр.Реквизит = "Дата договора";
	Если Протокол <> Неопределено Тогда
		НСтр.ПримерЗначения = Формат(Протокол.Договор.Дата, "ЧДЦ=2; ЧН=; ЧГ=; ДФ=dd.MM.yyyy; БЛ=Нет; БИ=Да");
	КонецЕсли;
	
	НСтр = Шаблоны.Добавить();
	НСтр.Шаблон = "##СрокДействияУсловийПротокола";
	НСтр.Реквизит = "Срок действия условий протокола";
	
	НСтр = Шаблоны.Добавить();
	НСтр.Шаблон = "##СтавкаНДСВознагражденияВТомЧислеКромеТого";
	НСтр.Реквизит = "(Ставка НДС вознаграждения, кроме того или в т.ч.)";
	
	НСтр = Шаблоны.Добавить();
	НСтр.Шаблон = "##НаименованиеПодписиИсполнителяВРодительномПадеже";
	НСтр.Реквизит = "Наименование подписи исполнителя в родительном падеже";
	
	НСтр = Шаблоны.Добавить();
	НСтр.Шаблон = "##НаименованиеПодписиКлиентаВРодительномПадеже";
	НСтр.Реквизит = "Наименование подписи клиента в родительном падеже";
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Шаблоны;
	
КонецФункции

