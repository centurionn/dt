				ОбластьЗаголовок.Параметры.ПодзаголовокРус		= ОтработатьШаблоны(Док, Стр.ТекстПунктаРус);
				ОбластьЗаголовок.Параметры.ПодзаголовокАнгл 	= ОтработатьШаблоны(Док, Стр.ТекстПунктаАнгл);
				Результат.Вывести(ОбластьЗаголовок);
			ИначеЕсли НЕ Стр.Заголовок Тогда
				ОбластьЗаголовок 							= Макет.ПолучитьОбласть("ТекстБлока");
				ОбластьЗаголовок.Параметры.n				= Стр.НомерПункта;
				ОбластьЗаголовок.Параметры.ТекстБлокаРус	= ОтработатьШаблоны(Док, Стр.ТекстПунктаРус);
				ОбластьЗаголовок.Параметры.ТекстБлокаАнгл 	= ОтработатьШаблоны(Док, Стр.ТекстПунктаАнгл);
				Результат.Вывести(ОбластьЗаголовок);
			КонецЕсли;
			
		КонецЦикла;
		
		/////////////////
		Если ЗначениеЗаполнено(Док.ПримечанияПунктовИУсловийПСЦ) тогда
			БлокДопПримечания = Макет.ПолучитьОбласть("БлокДопПримечания");
			БлокДопПримечания.Параметры.ТекстДопПримечания = Док.ПримечанияПунктовИУсловийПСЦ;
			Результат.Вывести(БлокДопПримечания);
		КонецЕсли;
		/////////////////
		
		ОбластьПодвал = Макет.ПолучитьОбласть("ОбластьПодписи");
//Евросиб ( Литвинов 21.01.2021 #30025
		//ОбластьПодвал.Параметры.ОрганизацияКраткоеРус = ?(ЗначениеЗаполнено(Док.Организация.ГоловнаяОрганизация), Док.Организация.ГоловнаяОрганизация.НаименованиеСокращенное, Док.Организация.НаименованиеСокращенное); //Евросиб Гудкова( 17.09.2020 Ticket№ 0206626 Док.Организация.НаименованиеСокращенное;
		//ОбластьПодвал.Параметры.ОрганизацияКраткоеЕнг = ?(ЗначениеЗаполнено(Док.Организация.ГоловнаяОрганизация), Док.Организация.ГоловнаяОрганизация.НаименованиеСокращенноеАнгл, Док.Организация.НаименованиеСокращенноеАнгл); //Евросиб Гудкова( 17.09.2020 Ticket№ 0206626 Док.Организация.НаименованиеСокращенноеАнгл;
		НаименованияНаДату = Справочники.Организации.НаименованияНаДату(?(ЗначениеЗаполнено(Док.Организация.ГоловнаяОрганизация), Док.Организация.ГоловнаяОрганизация, Док.Организация), Док.Дата);
		ОбластьПодвал.Параметры.ОрганизацияКраткоеРус = НаименованияНаДату.НаименованиеСокращенное;
		ОбластьПодвал.Параметры.ОрганизацияКраткоеЕнг = НаименованияНаДату.НаименованиеСокращенноеАнгл;
//Евросиб ) Литвинов 21.01.2021 #30025
		ОбластьПодвал.Параметры.ФИООргРус2 = НашРуководитель.ФИОРус;
		ОбластьПодвал.Параметры.ФИООргЕнг = НашРуководитель.ФИОАнгл;
		ОбластьПодвал.Параметры.ДолжностьОргРус = НашРуководитель.ДолжностьРус;
		ОбластьПодвал.Параметры.ДолжностьОргЕнг = НашРуководитель.ДолжностьАнгл;
		ОбластьПодвал.Параметры.КлиентФИОЕнг = РуководительКонтрагента.ФИОАнгл;
		ОбластьПодвал.Параметры.КлиентФИОРус = РуководительКонтрагента.ФИОРус;
		
		ОбластьПодвал.Параметры.КлиентДолжностьЕнг = РуководительКонтрагента.ДолжностьАнгл;
		ОбластьПодвал.Параметры.КлиентДолжностьРус = РуководительКонтрагента.ДолжностьРус;
		
		Если ЗначениеЗаполнено(Док.ДоверенностьЗаРуководителя) Тогда
			ОбластьПодвал.Параметры.ФИООргРус2 = ""+Док.ДоверенностьЗаРуководителя.ФИОПодписанта+Символы.ПС+Док.ДоверенностьЗаРуководителя.ОснованиеДляПодписания;
			ОбластьПодвал.Параметры.ДолжностьОргРус = ""+ Док.ДоверенностьЗаРуководителя.Должность;
