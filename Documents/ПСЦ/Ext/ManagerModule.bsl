Функция ПрикрепитьПротоколДляСубсидий(Док, ФорматПротокола) Экспорт

	СтруктураВозврата = Новый Структура("Результат, СообщениеПользователю, ПФ");   
	Результат = Новый ТабличныйДокумент;  
	Результат.АвтоМасштаб = Истина;
	
	Если не ЗначениеЗаполнено(Док) Тогда  
		СтруктураВозврата.Результат = Ложь;
		СтруктураВозврата.СообщениеПользователю = "Не определен ПСЦ прикрепления для печатной формы";
	    Возврат СтруктураВозврата;
	КонецЕсли;
	
	ЗаполнятьАнглийскиеНаименования = Ложь;
	Если ФорматПротокола = Перечисления.ФорматПротокола.ПротоколОдноязычныйУниверсальный Тогда
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ПСЦ.ПФ_MXL_ПротоколСубсидииОдноязычный", Док.Контрагент, Док.Договор);
	Иначе	
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ПСЦ.ПФ_MXL_ПротоколСубсидииДвуязычный", Док.Контрагент, Док.Договор);
		ЗаполнятьАнглийскиеНаименования = Истина;
	КонецЕсли;	   
	
	ЗаполнениеПоУмолчанию = "________________";
	ОбластьШапка 			= Макет.ПолучитьОбласть("ОбластьШапка");  
	ОбластьПункт1 			= Макет.ПолучитьОбласть("ОбластьПункт1"); 
	ОбластьШапкаТаблицы		= Макет.ПолучитьОбласть("ШапкаТаблицы");   
	ОбластьСтрокаТаблицы	= Макет.ПолучитьОбласть("СтрокаТаблицы"); 
    ОбластьПункт2 			= Макет.ПолучитьОбласть("ОбластьПункт2");
	ОбластьПункт3 			= Макет.ПолучитьОбласть("ОбластьПункт3");   
	ОбластьПодписи 			= Макет.ПолучитьОбласть("ОбластьПодписи"); 
	
	//Евросиб Коханенко Н.А. 15.11.2024 (( #95589 
	//РуководительКонтрагента = ОтветственныеЛица_сервер.ПолучитьРуководителя(Док.Контрагент, Док.Дата, Док.РуководительКонтрагента);
	//РуководительКонтрагента = ОтветственныеЛица_сервер.ПолучитьРуководителя(Док.Контрагент, Док.Дата, Док.РуководительКонтрагента,, Док.ПСЦПоставщика);
	//Евросиб(ДИТ), Беляев СЮ, BUG 110167 / TA 110622, 29-05-2025, начало
	РуководительКонтрагента = ОтветственныеЛица_сервер.ПолучитьРуководителя(Док.Контрагент, Док.Дата, Док.РуководительКонтрагента,, Док.ПСЦПоставщика, ТипЗнч(Док));
	//Евросиб(ДИТ), Беляев СЮ, BUG 110167 / TA 110622, 29-05-2025, конец
	//Евросиб Коханенко Н.А. 15.11.2024 )) #95589 
	Если ЗначениеЗаполнено(Док.ДоверенностьЗаРуководителя) Тогда
		НашРуководитель = Новый Структура("Ссылка, ФИОРус, ФИОРПРус, ДолжностьРус, ДолжностьРП, Основание, ОснованиеРус, ФИОАнгл, ДолжностьАнгл, ОснованиеАнгл");
		СтруктураПодписанта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Док.ДоверенностьЗаРуководителя, 
		"ФИОПодписанта, ФИОПодписантаДляПротокола, Должность, ДолжностьАнгл, ДолжностьРодительныйПадеж, ОснованиеДляПодписания, ОснованиеДляПодписанияРП, ОснованиеДляПодписанияАнгл, ФизЛицо");
		НашРуководитель.ФИОРус 			= СтруктураПодписанта.ФИОПодписанта;  
		НашРуководитель.ФИОАнгл 		= ?(ЗначениеЗаполнено(СтруктураПодписанта.ФизЛицо), 
											ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураПодписанта.ФизЛицо, "ФамилияИнициалыАнгл"), "");
		НашРуководитель.ФИОРПРус 		= СтруктураПодписанта.ФИОПодписантаДляПротокола;
		НашРуководитель.ДолжностьРус 	= СтруктураПодписанта.Должность;
		НашРуководитель.ДолжностьАнгл 	= СтруктураПодписанта.ДолжностьАнгл;
		НашРуководитель.ДолжностьРП 	= СтруктураПодписанта.ДолжностьРодительныйПадеж;
		НашРуководитель.ОснованиеРус 	= СтруктураПодписанта.ОснованиеДляПодписанияРП;   
		НашРуководитель.Основание	 	= СтруктураПодписанта.ОснованиеДляПодписания;
		НашРуководитель.ОснованиеАнгл 	= СтруктураПодписанта.ОснованиеДляПодписанияАнгл;
	Иначе	
		НашРуководитель = ОтветственныеЛица_сервер.ПолучитьРуководителя(Док.Организация, Док.Дата);
	КонецЕсли;
	
	///////////////////// ШАПКА /////////////////////
	ОбластьШапка.Параметры.НомерДоговора = Док.Договор.Номер;
	ОбластьШапка.Параметры.ДатаДоговора = Формат(Док.Договор.Дата, "ДФ='''«''d''»'' MMMM yyyy ""г.""'");   
	
	ОбластьШапка.Параметры.ГородПодписания = Док.ГородПодписания.Наименование;
	ОбластьШапка.Параметры.НомерПСЦ = Док.НомерПСЦ;
	ОбластьШапка.Параметры.ДатаПСЦ = Формат(Док.ДатаПСЦ, "ДФ='''«''d''»'' MMMM yyyy ""г.""'");  
	
	Если ЗаполнятьАнглийскиеНаименования Тогда
		ОбластьШапка.Параметры.ДатаПСЦАнгл = Формат(Док.ДатаПСЦ, "Л=en_GB; ДФ='d MMMM yyyy'");
		ОбластьШапка.Параметры.ДатаДоговораАнгл = Формат(Док.Договор.Дата, "Л=en_GB; ДФ='d MMMM yyyy'"); 
	КонецЕсли;
	
	НаименованияНаДату = Справочники.Организации.НаименованияНаДату(?(ЗначениеЗаполнено(Док.Организация.ГоловнаяОрганизация), Док.Организация.ГоловнаяОрганизация, Док.Организация), Док.Дата);
	ОбластьШапка.Параметры.ОрганизацияПолноеРус = НаименованияНаДату.НаименованиеПолное;
	ОбластьШапка.Параметры.ДолжностьОргРус = НашРуководитель.ДолжностьРП; 
	ОбластьШапка.Параметры.ФИООргРус = НашРуководитель.ФИОРПРус; 
	ОбластьШапка.Параметры.ОснованиеРус = НашРуководитель.ОснованиеРус; 
	ОбластьШапка.Параметры.КлиентПолноеРус = Док.Контрагент.НаименованиеПолное;
	ОбластьШапка.Параметры.КлиентДолжностьРус = РуководительКонтрагента.ДолжностьРП;
	ОбластьШапка.Параметры.КлиентФИОРус = РуководительКонтрагента.ФИОРПРус ;
	
	Если ЗаполнятьАнглийскиеНаименования Тогда
		ОбластьШапка.Параметры.ГородПодписанияАнгл = Док.ГородПодписания.НаименованиеАнгл;
		
		НаименованияНаДату = Справочники.Организации.НаименованияНаДату(?(ЗначениеЗаполнено(Док.Организация.ГоловнаяОрганизация), Док.Организация.ГоловнаяОрганизация, Док.Организация), Док.Дата);
		ОбластьШапка.Параметры.ОрганизацияПолноеЕнг  = НаименованияНаДату.НаименованиеПолноеАнгл;
		ОбластьШапка.Параметры.ДолжностьОргЕнг = НашРуководитель.ДолжностьАнгл; 
		ОбластьШапка.Параметры.ФИООргЕнг = НашРуководитель.ФИОАнгл; 
		ОбластьШапка.Параметры.ОснованиеЕнг = НашРуководитель.ОснованиеАнгл; 
		ОбластьШапка.Параметры.КлиентПолноеЕнг = Док.Контрагент.НаименованиеПолноеАнгл;
		ОбластьШапка.Параметры.КлиентДолжностьЕнг = РуководительКонтрагента.ДолжностьАнгл;
		ОбластьШапка.Параметры.КлиентФИОЕнг = РуководительКонтрагента.ФИОАнгл;   
		
		Если ЗначениеЗаполнено(РуководительКонтрагента.ОснованиеАнгл) Тогда
			ОбластьШапка.Параметры.КлиентДолжностьЕнг = "" + РуководительКонтрагента.ДолжностьАнгл + " " + РуководительКонтрагента.ОснованиеАнгл;
		КонецЕсли; 
	КонецЕсли;
		
	Результат.Вывести(ОбластьШапка);
	
	///////////////////// ПУНКТ 1 /////////////////////
	Результат.Вывести(ОбластьПункт1);  
	
	///////////////////// ТАБЛИЦА /////////////////////  
	ОбластьШапкаТаблицы.Параметры.Валюта = Док.Валюта;
	Результат.Вывести(ОбластьШапкаТаблицы); 
	
	СтанцияОтправления 		= ЗаполнениеПоУмолчанию;
	СтанцияОтправленияАнг 	= ЗаполнениеПоУмолчанию;
	СтанцияНазначения 		= ЗаполнениеПоУмолчанию;   
	СтанцияНазначенияАнг 	= ЗаполнениеПоУмолчанию;
	
	Если Док.ТЧ.Количество() > 0 Тогда
		СтанцияОтправления = Док.ТЧ[0].ПунктОтправленияRUS; 
		СтанцияНазначения = Док.ТЧ[0].ПунктДоставкиRUS;
		Если ЗаполнятьАнглийскиеНаименования Тогда
			СтанцияОтправленияАнг = Док.ТЧ[0].ПунктОтправленияENG;
			СтанцияНазначенияАнг = Док.ТЧ[0].ПунктДоставкиENG;
		КонецЕсли;  
		Если ЗначениеЗаполнено(Док.ТЧ[0].УсловияПеревозки_Отправление) и ЗначениеЗаполнено(Док.ТЧ[0].УсловияПеревозки_Прибытие) Тогда
			ОбластьСтрокаТаблицы.Параметры.УсловияПеревозки = Док.ТЧ[0].УсловияПеревозки_Отправление + "-" + Док.ТЧ[0].УсловияПеревозки_Прибытие; 
		КонецЕсли; 
	КонецЕсли;       
	
	ОбластьСтрокаТаблицы.Параметры.СтанцияОтправления = Строка(СтанцияОтправления) + ?(не ЗаполнятьАнглийскиеНаименования, "", "/" + СтанцияОтправленияАнг);  
	ОбластьСтрокаТаблицы.Параметры.СтанцияНазначения = Строка(СтанцияНазначения) + ?(не ЗаполнятьАнглийскиеНаименования, "", "/" + СтанцияНазначенияАнг);
	
	Результат.Вывести(ОбластьСтрокаТаблицы);
	
	///////////////////// ПУНКТ 2 ///////////////////// 
	ОбластьПункт2.Параметры.СтанцияОтправления = СтанцияОтправления;  
	ОбластьПункт2.Параметры.СтанцияНазначения = СтанцияНазначения;  
	ОбластьПункт2.Параметры.Валюта = Док.Валюта;
	Если ЗаполнятьАнглийскиеНаименования Тогда
		ОбластьПункт2.Параметры.СтанцияОтправленияАнг = СтанцияОтправленияАнг;  
		ОбластьПункт2.Параметры.СтанцияНазначенияАнг = СтанцияНазначенияАнг;
	КонецЕсли;

	Результат.Вывести(ОбластьПункт2);  
	
	///////////////////// ПУНКТ 3 /////////////////////    
	ОбластьПункт3.Параметры.Валюта = Док.Валюта;
	ОбластьПункт3.Параметры.СтанцияОтправления = СтанцияОтправления;  
	//ОбластьПункт3.Параметры.СтанцияНазначения = СтанцияНазначения;  
	Если ЗаполнятьАнглийскиеНаименования Тогда
		ОбластьПункт3.Параметры.СтанцияОтправленияАнг = СтанцияОтправленияАнг;  
		//ОбластьПункт3.Параметры.СтанцияНазначенияАнг = СтанцияНазначенияАнг;
	КонецЕсли;
	
	ОбластьПункт3.Параметры.НомерДоговора = Док.Договор.Номер;
	ОбластьПункт3.Параметры.ДатаДоговора = Формат(Док.Договор.Дата, "ДФ='d MMMM yyyy'"); 
	Если ЗаполнятьАнглийскиеНаименования Тогда
		ОбластьПункт3.Параметры.ДатаДоговора = Формат(Док.Договор.Дата, "Л=en_GB; ДФ='d MMMM yyyy'");
	КонецЕсли;
	
	Результат.Вывести(ОбластьПункт3);
	
	///////////////////// ПОДПИСИ ///////////////////// 
	НаименованияНаДату = Справочники.Организации.НаименованияНаДату(?(ЗначениеЗаполнено(Док.Организация.ГоловнаяОрганизация), Док.Организация.ГоловнаяОрганизация, Док.Организация), Док.Дата);
	
	ОбластьПодписи.Параметры.ОрганизацияПолноеРус 	= НаименованияНаДату.НаименованиеПолное; 
	ОбластьПодписи.Параметры.ДолжностьОргРус		= НашРуководитель.ДолжностьРус; 
	ОбластьПодписи.Параметры.ФИООргРус    			= НашРуководитель.ФИОРус; 
	ОбластьПодписи.Параметры.КлиентПолноеРус		= Док.Контрагент.НаименованиеПолное;
	ОбластьПодписи.Параметры.КлиентДолжностьРус		= РуководительКонтрагента.ДолжностьРус;
	ОбластьПодписи.Параметры.КлиентФИОРус   		= РуководительКонтрагента.ФИОРус;
	
	Если ЗаполнятьАнглийскиеНаименования Тогда
		ОбластьПодписи.Параметры.ОрганизацияПолноеЕнг 	= НаименованияНаДату.НаименованиеПолноеАнгл;
		ОбластьПодписи.Параметры.ДолжностьОргЕнг		= НашРуководитель.ДолжностьАнгл; 
		ОбластьПодписи.Параметры.ФИООргЕнг    			= НашРуководитель.ФИОАнгл; 
		ОбластьПодписи.Параметры.КлиентПолноеЕнг		= Док.Контрагент.НаименованиеПолноеАнгл;
		ОбластьПодписи.Параметры.КлиентДолжностьЕнг		= РуководительКонтрагента.ДолжностьАнгл;
		ОбластьПодписи.Параметры.КлиентФИОЕнг   		= РуководительКонтрагента.ФИОАнгл;	
	КонецЕсли;                 
	
	Результат.Вывести(ОбластьПодписи);    
	
	///////////////////// ПРИКРЕПЛЕНИЕ ВЛОЖЕННОГО ФАЙЛА /////////////////////
	СтруктураВозврата.ПФ = Результат;   
	
	Если ФорматПротокола = Перечисления.ФорматПротокола.ПротоколОдноязычныйУниверсальный Тогда
		ИмяФайлаПФ = "Протокол субсидии №" + СтрЗаменить(Док.НомерПСЦ, "/", "-") + " (одноязычный)"; 
	Иначе
		ИмяФайлаПФ = "Протокол субсидии №" + СтрЗаменить(Док.НомерПСЦ, "/", "-") + " (двуязычный)";
	КонецЕсли;
	ИмяФайла = КаталогВременныхФайлов() + ИмяФайлаПФ + ".DOCX";

	Результат.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.DOCX); 
	ПрисоединенныйФайл = РаботаСФайлами.ДобавитьФайлСДиска(Док.Ссылка, ИмяФайла);  
	
	Попытка
		УдалитьФайлы(КаталогВременныхФайлов(), ИмяФайлаПФ + ".DOCX");
	Исключение
	КонецПопытки;

	СтруктураВозврата.Результат = Истина;
	
	Возврат СтруктураВозврата;

КонецФункции 

// Рыбьяков К.А 13.05.2024 US 81613 Начало 
Процедура ОбновитьРегистрОтработанныхДокументов(Ссылка, ДатаОтработкиДокумента, Исполнитель)
	
	Если Не ЗначениеЗаполнено(Исполнитель) Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыПСЦ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "Дата, Организация, Номер, Контрагент, Проведен, ПометкаУдаления");
	
	МенеджерЗаписи = РегистрыСведений.ОтработанныеДокументыБухгалтерией.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Документ = Ссылка;
	МенеджерЗаписи.Организация = РеквизитыПСЦ.Организация; 
	МенеджерЗаписи.НомерДокумента = РеквизитыПСЦ.Номер;
	МенеджерЗаписи.ДатаУчетаДокумента = ДатаОтработкиДокумента; 
	МенеджерЗаписи.Контрагент = РеквизитыПСЦ.Контрагент;	
	МенеджерЗаписи.ДатаДокумента = РеквизитыПСЦ.Дата;
	МенеджерЗаписи.Ответственный = Исполнитель;
	МенеджерЗаписи.Проведен = РеквизитыПСЦ.Проведен;
	Если Ссылка.ПометкаУдаления Тогда
		МенеджерЗаписи.ДатаУдаленияДокумента = ТекущаяДата();
	ИначеЕсли Не Ссылка.ПометкаУдаления И МенеджерЗаписи.ДатаУдаленияДокумента <> Дата('00010101') Тогда
		МенеджерЗаписи.ДатаУдаленияДокумента = Дата('00010101');	
	КонецЕсли;
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

Процедура ОтработкаДокументаБухгалтерией(Ссылка) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ГруппыПользователей.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТГруппы
	|ИЗ
	|	Справочник.ГруппыПользователей КАК ГруппыПользователей
	|ГДЕ
	|	ГруппыПользователей.Родитель В ИЕРАРХИИ(&Группа)
	|	Или ГруппыПользователей.Ссылка = &Группа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ГруппыПользователейСостав.Пользователь КАК Пользователь
	|ПОМЕСТИТЬ ВТ_ПользователиБух
	|ИЗ
	|	Справочник.ГруппыПользователей.Состав КАК ГруппыПользователейСостав
	|ГДЕ
	|	ГруппыПользователейСостав.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТГруппы.Ссылка
	|			ИЗ
	|				ВТГруппы КАК ВТГруппы)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ПСЦСостояния.ЗавершениеРаботы) КАК ДатаЗавершенияРаботы,
	|	ПСЦСостояния.Исполнитель КАК Исполнитель
	|ИЗ
	|	Документ.ПСЦ.Состояния КАК ПСЦСостояния
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтработанныеДокументыБухгалтерией КАК ОтработанныеДокументыБухгалтерией
	|		ПО ПСЦСостояния.Ссылка = ОтработанныеДокументыБухгалтерией.Документ
	|ГДЕ
	|	ПСЦСостояния.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЭтапов.Выполнен)
	|	И ПСЦСостояния.Исполнитель В
	|			(ВЫБРАТЬ
	|				ВТ_ПользователиБух.Пользователь
	|			ИЗ
	|				ВТ_ПользователиБух КАК ВТ_ПользователиБух)
	|	И ПСЦСостояния.Ссылка = &Документ
	|
	|СГРУППИРОВАТЬ ПО
	|	ПСЦСостояния.Ссылка,
	|	ПСЦСостояния.Исполнитель";

	// Бухгалтерия (Справочник.ГруппыПользователей)
	ГруппаБухгалтерия = Справочники.ГруппыПользователей.ПолучитьСсылку(Новый УникальныйИдентификатор("8c364532-cfdf-11ea-b819-00155dfba800"));
	
	Запрос.УстановитьПараметр("Группа", ГруппаБухгалтерия);
	Запрос.УстановитьПараметр("Документ", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			ОбновитьРегистрОтработанныхДокументов(Ссылка, Выборка.ДатаЗавершенияРаботы, Выборка.Исполнитель);
		КонецЦикла;	
	Иначе
		ПроверитьЗаписьВРегистре(Ссылка);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьЗаписьВРегистре(Ссылка)  
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ОтработанныеДокументыБухгалтерией.Документ КАК Документ
	|ИЗ
	|	РегистрСведений.ОтработанныеДокументыБухгалтерией КАК ОтработанныеДокументыБухгалтерией
	|ГДЕ
	|	ОтработанныеДокументыБухгалтерией.Документ = &Документ";

	Запрос.УстановитьПараметр("Документ", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();

	Если Не РезультатЗапроса.Пустой() Тогда	
		Выборка = РезультатЗапроса.Выбрать();		
		Пока Выборка.Следующий() Цикл
			МенеджерЗаписи = РегистрыСведений.ОтработанныеДокументыБухгалтерией.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Документ = Ссылка;
			МенеджерЗаписи.Прочитать();
			РеквизитыПСЦ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "Проведен, ПометкаУдаления");
			МенеджерЗаписи.Проведен = РеквизитыПСЦ.Проведен;
			Если Ссылка.ПометкаУдаления Тогда
				МенеджерЗаписи.ДатаУдаленияДокумента = ТекущаяДата();
			ИначеЕсли Не Ссылка.ПометкаУдаления И МенеджерЗаписи.ДатаУдаленияДокумента <> Дата('00010101') Тогда
				МенеджерЗаписи.ДатаУдаленияДокумента = Дата('00010101');	
			КонецЕсли;
			МенеджерЗаписи.Записать();	
		КонецЦикла;				
	КонецЕсли;	
	
КонецПроцедуры
