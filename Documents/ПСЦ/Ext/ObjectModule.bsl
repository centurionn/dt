Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Евросиб Фролов (17.02.2022 Task №45918 
	// Для администратора разрешить удаление проведения при срабатывании проверки на наличие РТУ.
	// Евросиб Фролов (31.03.2022 Ticket №Ticket#0238226
	//Если Пользователи.ЭтоПолноправныйПользователь() Тогда
	Если Пользователи.ЭтоПолноправныйПользователь(,, Ложь) Тогда
	// Евросиб Фролов)
		Возврат;	
	КонецЕсли;		
	// Евросиб Фролов)
	
	Отказ = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СделкаДоходы.УчДокумент КАК УчДокумент
	|ИЗ
	|	Документ.Сделка.Доходы КАК СделкаДоходы
	|ГДЕ
	|	СделкаДоходы.ПСЦ = &Ссылка
	|	И СделкаДоходы.УчДокумент ССЫЛКА Документ.РеализацияТоваровУслуг
	|	И НЕ СделкаДоходы.УчДокумент.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Сообщить("По документу создан документ ""Реализация товаров и услуг"". Отмена проведения запрещена!");				
		Отказ = Истина;		
	КонецЕсли;
	
КонецПроцедуры
// ДИТ Поморцева Т.П. Задача 0238226 08.09.21. конец

Процедура ЗаполнитьОтветственногоМенеджера() Экспорт
	// Евросиб Фролов (08.11.2021 TASK №41432
	ОтветственныйМенеджер = Справочники.Пользователи.ПустаяСсылка();
	Если ЗначениеЗаполнено(Договор) И ЗначениеЗаполнено(ЦФО) Тогда
		
		ИмяРеквизита = "";
		Если ЦФО = Справочники.ЦентрыФинансовойОтветственности.ОсновнойЦФО Тогда
			ИмяРеквизита = "ОтветственныйЗаСопровождение";
		ИначеЕсли ЦФО = Справочники.ЦентрыФинансовойОтветственности.ТерминалНовосибирск Тогда
			ИмяРеквизита = "ОтветственныйЗаСопровождениеНСК";
		КонецЕсли;
		
		Если ПустаяСтрока(ИмяРеквизита) Тогда
			Возврат;
		КонецЕсли;	
		
		// ДИТ US 51951 TA 61497 Евсенкин М.А. Начало: 30.11.2022
		// Было:
		//РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, ИмяРеквизита + ", " + ИмяРеквизита + ".Недействителен"); 
		//ОтветственныйДоговораНедействителен = РеквизитыДоговора[ИмяРеквизита + "Недействителен"];
		//ОтветственныйДоговора = РеквизитыДоговора[ИмяРеквизита];
		//Стало:
		//ОтветственныйДоговора = Справочники.ДоговорыКонтрагентов.ПолучитьОтветственного(Договор,ИмяРеквизита);
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Договор",				Договор);
		СтруктураПараметров.Вставить("ЦФО",					ЦФО);
		СтруктураПараметров.Вставить("ТипОтветственного",	Перечисления.ТипыОтветственных.ОтветственныйЗаСопровождение);  
		ОтветственныйДоговора = Справочники.ДоговорыКонтрагентов.ПолучитьОтветственного(СтруктураПараметров);
		РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОтветственныйДоговора, "Недействителен");
		ОтветственныйДоговораНедействителен = РеквизитыДоговора.Недействителен;                                              
        // ДИТ US 51951 TA 61497 Евсенкин М.А. Конец: 30.11.2022
		Если ОтветственныйДоговораНедействителен = Ложь Тогда
			ОтветственныйМенеджер = ОтветственныйДоговора;
		КонецЕсли;
		
	КонецЕсли;
	// Евросиб Фролов)
КонецПроцедуры

