Функция ПолучитьСтатусИзТЧ(ИсточникТЧ, Состояние)
	
	Результат = неопределено;
	
	НайдСтроки = ИсточникТЧ.НайтиСтроки(Новый Структура("Состояние", Состояние));
	Если НайдСтроки.Количество() > 0 Тогда
		Результат = НайдСтроки[0].Статус;
	КонецЕсли;
	
	Возврат Результат;
	
