Функция ЕстьКалькуляцииДляКТКЕвросиб()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ПСЦКалькуляции.Калькуляция КАК Документ.Калькуляция) КАК Калькуляция
	|ПОМЕСТИТЬ ВТ_КалькуляцииДляКТКЕвросиб
	|ИЗ
	|	Документ.ПСЦ.Калькуляции КАК ПСЦКалькуляции
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_КалькуляцииДляКТКЕвросиб.Калькуляция КАК Калькуляция
	|ИЗ
	|	ВТ_КалькуляцииДляКТКЕвросиб КАК ВТ_КалькуляцииДляКТКЕвросиб
	|ГДЕ
	|	ВТ_КалькуляцииДляКТКЕвросиб.Калькуляция.веб_ДляКТКЕвросиб
	//БИТ Белинский Д.А. 20.06.2023 -начало TASK 66201
	|	И НЕ (ВТ_КалькуляцииДляКТКЕвросиб.Калькуляция.ТипКалькуляции В (&МРРасходы) И ВТ_КалькуляцииДляКТКЕвросиб.Калькуляция.Контрагент = &Контрагент)";
	//БИТ Белинский Д.А. 20.06.2023 -конец TASK 66201
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ПСЦ.Калькуляции", "&ПСЦКалькуляции");
	Запрос.УстановитьПараметр("ПСЦКалькуляции", Калькуляции.Выгрузить());
	//БИТ Белинский Д.А. 20.06.2023 -начало TASK 66201
    МРРасходы = Новый Массив;
	МРРасходы.Добавить(Перечисления.ТипыКалькуляций.МежсервисныеРасходы);
	МРРасходы.Добавить(Перечисления.ТипыКалькуляций.МежсервисныеРасходыРеф);
	Запрос.УстановитьПараметр("МРРасходы", МРРасходы);
	Запрос.УстановитьПараметр("Контрагент", Константы.КонтрагентДирекцияКонтейнерныхПеревозок.Получить());
	//БИТ Белинский Д.А. 20.06.2023 -конец TASK 66201
	РезультатЗапроса = Запрос.Выполнить();
	Возврат НЕ РезультатЗапроса.Пустой();
		
КонецФункции


Процедура ПроверитьСтрокуСверхнормативногоПользования(Стр, Отказ)
	
	ИмяТабличнойЧасти = "СверхнормативноеПользование";
	ПутьКДанным = "Объект";
	
	Если Не ЗначениеЗаполнено(Стр.НормативныйСрок) Тогда
		Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТабличнойЧасти, Стр.НомерСтроки, "НормативныйСрок");
		ОбщегоНазначения.СообщитьПользователю("Не заполнен Нормативный срок во вкладке Сверхнормативы",, Поле, ПутьКДанным, Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Стр.ТипКТК) Тогда
		Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТабличнойЧасти, Стр.НомерСтроки, "ТипКТК");
		ОбщегоНазначения.СообщитьПользователю("Не заполнен Тип КТК во вкладке Сверхнормативы",, Поле, ПутьКДанным, Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Стр.Ставка) Тогда
		Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТабличнойЧасти, Стр.НомерСтроки, "Ставка");
		ОбщегоНазначения.СообщитьПользователю("Не заполнена Ставка во вкладке Сверхнормативы",, Поле, ПутьКДанным, Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Стр.Валюта) Тогда
		Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТабличнойЧасти, Стр.НомерСтроки, "Валюта");
		ОбщегоНазначения.СообщитьПользователю("Не заполнена Валюта во вкладке Сверхнормативы",, Поле, ПутьКДанным, Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Стр.СтавкаНДС) Тогда
		Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТабличнойЧасти, Стр.НомерСтроки, "СтавкаНДС");
		ОбщегоНазначения.СообщитьПользователю("Не заполнена Ставка НДС во вкладке Сверхнормативы",, Поле, ПутьКДанным, Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Стр.ЕдиницаИзмеренияРасчетаСНП) Тогда
		Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТабличнойЧасти, Стр.НомерСтроки, "ЕдиницаИзмеренияРасчетаСНП");
		ОбщегоНазначения.СообщитьПользователю("Не заполнено поле ""Расчет СНП в"" во вкладке Сверхнормативы",, Поле, ПутьКДанным, Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Стр.ВариантОпределенияДатыКурсаВалют) Тогда
		Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТабличнойЧасти, Стр.НомерСтроки, "ВариантОпределенияДатыКурсаВалют");
		ОбщегоНазначения.СообщитьПользователю("Не заполнено поле ""Курс валюты на дату"" во вкладке Сверхнормативы",, Поле, ПутьКДанным, Отказ);
