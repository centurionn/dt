
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Автор = Пользователи.ТекущийПользователь();
	ЦФО = Автор.ЦФО;
	Подразделение = Автор.Подразделение;
	Организация = Константы.ОсновнаяОрганизация.Получить();
	Создано = ТекущаяДата();
	Маршрутизировать = Константы.МаршрутизироватьПСЦ.Получить();
	НаименованиеПодписиИсполнителя = Справочники.НаименованияПодписей.Исполнитель;
	НаименованиеПодписиКлиента = Справочники.НаименованияПодписей.Клиент;
	НаименованиеУслугиВознагражденияДляДоговорнойЦеныВР = Справочники.НаименованияУслугиВознагражденияДляДоговорнойЦеныВР.Вознаграждение;
	ПересчетСуммыИСФнаДатуСчета = Истина;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Калькуляция") Тогда
		Калькуляции.Добавить().Калькуляция = ДанныеЗаполнения;
		Контрагент = ДанныеЗаполнения.Контрагент;
		
		Если ЗначениеЗаполнено(Контрагент) Тогда
			РуководительКонтрагента = КонтрагентыДоговоры_сервер.ПолучитьРуководителяКонтрагента(Контрагент, ТекущаяДата());
		КонецЕсли;
		
		Договор = ДанныеЗаполнения.Договор;
		Организация = ДанныеЗаполнения.Организация;
		СтавкаНДС = ДанныеЗаполнения.СтавкаНДС;
		Валюта = ДанныеЗаполнения.Валюта;
		СуммаВключаетНДС = ДанныеЗаполнения.СуммаВключаетНДС;
		Подразделение = ДанныеЗаполнения.Подразделение;
		ЦФО = ДанныеЗаполнения.ЦФО;
		СтатусДокумента = Перечисления.СтатусыСогласования.Планируется;
		//Евросиб Каблов 13.03.2023 ( Ticket#0265045
		ВидПеревозки = ДанныеЗаполнения.ПС_ВидПеревозки;
		//Евросиб Каблов 13.03.2023 )
		Для каждого Стр из ДанныеЗаполнения.ММ_КалькуляцияЖДСоставляющей Цикл
			Если Стр.Операция.НормативВыгрузки Тогда
				НормативВыгрузки = Стр.ДлительностьДней;
			ИначеЕсли Стр.Операция.НормативПогрузки Тогда
				НормативПогрузки = Стр.ДлительностьДней;
			КонецЕсли;
		КонецЦикла;
		
		//БИТ Белинский Д.А. 20.06.2023 -начало
		Если ДанныеЗаполнения.ТипКалькуляции = Перечисления.ТипыКалькуляций.МежсервисныеРасходы 
			ИЛИ ДанныеЗаполнения.ТипКалькуляции = Перечисления.ТипыКалькуляций.МежсервисныеРасходыРеф Тогда 
			
			ДатаПСЦ = ТекущаяДата();
			ФорматПротокола = Перечисления.ФорматПротокола.ПротоколОдноязычныйУниверсальный;  
			ТипКалькуляции = ДанныеЗаполнения.ТипКалькуляции;   
			НачалоДействия = ТекущаяДата();
			ОтветственныйМенеджер = ПараметрыСеанса.ТекущийПользователь;
		// ДИТ US 59973 ТА 76151 Сержантова А.С. Начало: 16.10.2023
		ИначеЕсли ДанныеЗаполнения.ТипКалькуляции = Перечисления.ТипыКалькуляций.Субсидии ИЛИ ДанныеЗаполнения.ТипКалькуляции = Перечисления.ТипыКалькуляций.Премии Тогда  //ДИТ Шевченко А.В. US 103646 TA 103658 10.03.2025
			ТипКалькуляции = ДанныеЗаполнения.ТипКалькуляции;    
		// ДИТ US 59973 ТА 76151 Сержантова А.С. Конец: 16.10.2023	
		КонецЕсли;
		//БИТ Белинский Д.А. 20.06.2023 -конец
		
	КонецЕсли;
	
	// Евросиб US 88643 Рыбьяков К.А. 16.08.2024 ((
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И ДанныеЗаполнения.Свойство("Основание") 
		И ТипЗнч(ДанныеЗаполнения.Основание) = Тип("ДокументСсылка.РелизСобственника") Тогда
		
		Подразделение = ДанныеЗаполнения.Подразделение;
		Контрагент = ДанныеЗаполнения.Контрагент;
		Договор = ДанныеЗаполнения.Договор;
		ТипКалькуляции = Перечисления.ТипыКалькуляций.Доплатные;
		ПротоколНаДоплатныеКТК = Истина;
		КатегорияУслуг = Справочники.КатегорииУслуг.КТКСтокиТерминалыПорты;
		Если ДанныеЗаполнения.Свойство("ВидПеревозки") Тогда
			ВидПеревозки = ДанныеЗаполнения.ВидПеревозки;
		КонецЕсли;
		Если ДанныеЗаполнения.Свойство("СтавкаНДС") Тогда
			СтавкаНДС = ДанныеЗаполнения.СтавкаНДС;
		КонецЕсли;
		Если ДанныеЗаполнения.Свойство("НДСВключая") Тогда
			СуммаВключаетНДС = ДанныеЗаполнения.НДСВключая;
		КонецЕсли;
		
		Для Каждого Калькуляция Из ДанныеЗаполнения.Калькуляции Цикл
			Калькуляции.Добавить().Калькуляция = Калькуляция;
		КонецЦикла;
		
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 16.08.2024 ))
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	//Евросиб Каблов 18.09.2020 (
	КонтрольДоступностиДокументов_сервер.ПроверитьДоступностьПолейДляИзменения(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	//Евросиб Каблов 18.09.2020 )
		
	// ШейкоОЕ (25.08.2020 Ticket№ 0204488 Добавить реквизит "СозданНаОсновании" в справочник "ТарифыПоставщиков")
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
	
		НовУник = Новый УникальныйИдентификатор();
		ТекСсылка = Документы.ПСЦ.ПолучитьСсылку(НовУник);
		УстановитьСсылкуНового(ТекСсылка);
		//Евросиб - АСуслов 12.01.2021 16:54:07 #
		//(
		ПересчетСуммыИСФнаДатуСчета = Истина;
		//)
		//Евросиб - АСуслов 12.01.2021 16:54:08 #
	Иначе
		ТекСсылка = Ссылка;
	КонецЕсли; 
	// ШейкоОЕ (25.08.2020 Ticket№ 0204488 Добавить реквизит "СозданНаОсновании" в справочник "ТарифыПоставщиков")
	
	Редактор = Пользователи.ТекущийПользователь();
	Изменено = ТекущаяДата();

	// Евросиб US 87896 Рыбьяков К.А. 18.07.2024 ((
	// проверка на несоответствие клиента в калькуляциях и в ПСЦ
	Если Не Нотис Тогда
		Для каждого Стр из Калькуляции Цикл
			Если Стр.Калькуляция.Контрагент <> Контрагент ИЛИ Стр.Калькуляция.Договор <> Договор Тогда
				
				Сообщить("В калькуляции " + Стр.Калькуляция + " не совпадает Контрагент или Договор. Запись запрещена!");
				Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 18.07.2024 ))
	
	//// Евросиб Фролов (29.11.2021 Ticket№ 0250840
	//Если Не ЗначениеЗаполнено(ОкончаниеДействия)
	//	И ДействуетДоСогласованияНовыхУсловий = Ложь Тогда
	//	ТекстСообщения = "Укажите дату окончания действия ПСЦ или установите признак ""Действует до согласования новых условий""";

	//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
	//														ТекстСообщения,
	//														ЭтотОбъект,
	//														"ОкончаниеДействия",
	//														,
	//														Отказ);
	//КонецЕсли;	
	//
	//Если ПСЦПоставщика Тогда
