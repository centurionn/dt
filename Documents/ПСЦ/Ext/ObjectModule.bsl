		РуководительКонтрагента = КонтрагентыДоговоры_сервер.ПолучитьРуководителяКонтрагента(Контрагент, ?(ЗначениеЗаполнено(ДатаПодписания), ДатаПодписания, Дата));
		
	КонецЕсли;
	
	Если Не БезДоверенностей Тогда
		СтруктураПодписантовПоДоверенности = БухгалтерскийУчетОбщиеПроцедурыСервер.НайтиДействующиеДоверенностиНаПодпись(?(ЗначениеЗаполнено(ДатаПодписания), ДатаПодписания, Дата), "Протокол", ЦФО);
		//Евросиб Коханенко Н.А. 13.10.2023 (( #76015
		//ДоверенностьЗаРуководителя = СтруктураПодписантовПоДоверенности.ДоверенностьЗаРуководителя;
		Если НЕ ПСЦПоставщика Тогда
			ДоверенностьЗаРуководителя = СтруктураПодписантовПоДоверенности.ДоверенностьЗаРуководителя;
		КонецЕсли;
		//Евросиб Коханенко Н.А. 13.10.2023 )) #76015 
		ДоверенностьЗаГлБухгалтера = СтруктураПодписантовПоДоверенности.ДоверенностьЗаГБ;
	КонецЕсли;
//Евросиб Гудкова( 11.11.2019 Ticket№ 0180052 проверка условий НДС 0% в договоре
	Если СтавкаНДС = Перечисления.СтавкиНДС.НДС0 Тогда
		ВыборкаТекУсловий = КонтрольДоступностиДокументов_сервер.ПолучитьТекущиеПараметрыНДС0(Договор, ДатаПСЦ);
		Если Не ВыборкаТекУсловий.Следующий() Тогда
			ОбщегоНазначения.СообщитьПользователю("На дату ПСЦ не обнаружены действующие условия применения ставки НДС 0%",,,,Отказ);
		КонецЕсли; 
	КонецЕсли; 
// Евросиб Гудкова)

