&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Нотис", Истина);
	ОткрытьФорму("Документ.ПСЦ.Форма.ФормаДокумента", СтруктураПараметров, Элемент);
	
	Отказ = Истина;

КонецПроцедуры //Евросиб Коханенко Н.А. 13.12.2024 )) #97657
