&НаСервере
Процедура НайтиКалькуляцииНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Калькуляция.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.Калькуляция КАК Калькуляция
	               |ГДЕ
	               |	Калькуляция.Проведен
	               |	И ВЫБОР
	               |			КОГДА &КонтрагентЗадан
	               |				ТОГДА Калькуляция.Контрагент = &Контрагент
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &ДоговорЗадан
	               |				ТОГДА Калькуляция.Договор = &Договор
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &ОрганизацияЗадан
	               |				ТОГДА Калькуляция.Организация = &Организация
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И Калькуляция.НачалоДействия МЕЖДУ &НачалоПериода1 И &НачалоПериода2
	               |	И (Калькуляция.ОкончаниеДействия МЕЖДУ &КонецПериода1 И &КонецПериода2 ИЛИ &ДатаЗавершенияНеУказана)
	               |	И Калькуляция.ТипКалькуляции В(&ТипыКалькуляций)
	               |	И ВЫБОР
	               |			КОГДА &ТолькоЗавершенные
	               |				ТОГДА Калькуляция.КалькуляцияЗавершена
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ";
	УстановитьПараметрЪ("Контрагент", Запрос, Контрагент);
	УстановитьПараметрЪ("Договор", Запрос, Договор);
	УстановитьПараметрЪ("Организация", Запрос, Организация);
	Запрос.УстановитьПараметр("ТолькоЗавершенные", ТолькоЗавершенные);
	Запрос.УстановитьПараметр("НачалоПериода1", ПериодНачалаДействия.ДатаНачала);
	Запрос.УстановитьПараметр("НачалоПериода2", ?(ЗначениеЗаполнено(ПериодНачалаДействия.ДатаОкончания), ПериодНачалаДействия.ДатаОкончания, ТекущаяДата()));//Гудкова 0207169 ПериодНачалаДействия.ДатаОкончания);
	Запрос.УстановитьПараметр("КонецПериода1", ПериодОкончанияДействия.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода2", ?(ЗначениеЗаполнено(ПериодОкончанияДействия.ДатаОкончания), ПериодОкончанияДействия.ДатаОкончания, КонецГода(ТекущаяДата()))); //Гудкова 0207169 ПериодОкончанияДействия.ДатаОкончания);
	Запрос.УстановитьПараметр("ДатаЗавершенияНеУказана", ДатаЗавершенияНеУказана);
	Запрос.УстановитьПараметр("ТипыКалькуляций", ВидыКалькуляций.ВыгрузитьЗначения());
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		НСтр = ТЧ.Добавить();
		НСтр.Калькуляция = Ответ.Ссылка;
		//Евросиб Шевченко А.В. US 99262 TA 121126 09.10.2025
		НСтр.РасчетнаяКонтрибуция40 = ПолучитьРасчетнуюКонтрибуцияю(Ответ.Ссылка);
		//Евросиб Шевченко А.В. US 99262 TA 121126 09.10.2025
		НСтр.Выбрать = истина;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрЪ(ИмяПараметра, Запрос, СтруктураПараметров)
	
	Если ЗначениеЗаполнено(СтруктураПараметров) Тогда
		Запрос.УстановитьПараметр(ИмяПараметра+"Задан", Истина);
		Запрос.УстановитьПараметр(ИмяПараметра, СтруктураПараметров);
	Иначе
		Запрос.УстановитьПараметр(ИмяПараметра+"Задан", Ложь);
		Запрос.УстановитьПараметр(ИмяПараметра, неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВПСЦ(Команда)
	
	Результат = Новый массив;
	Для каждого Стр из ТЧ Цикл
	Если Стр.Выбрать Тогда 
	   	//Евросиб Коханенко Н.А. 25.07.2023 (( #72829 
		ВыборНевозможен = ПроверитьНаВозможностьИспользованияКалькуляцииПоРезультатамСогласования(, Стр.Калькуляция);
		Если ВыборНевозможен Тогда
			Продолжить;
		КонецЕсли;
		//Евросиб Коханенко Н.А. 25.07.2023 )) #72829 
		Результат.Добавить(Стр.Калькуляция); 
	КонецЕсли;
	КонецЦикла;
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ПометитьВсе(Пометка)
	
	Для каждого Стр из ТЧ Цикл
		Стр.Выбрать = Пометка;
	КонецЦикла;
	
КонецПроцедуры

