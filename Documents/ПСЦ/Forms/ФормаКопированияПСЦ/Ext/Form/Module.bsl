	Если Параметры.Свойство("ПСЦ") Тогда
		ИсходныйПСЦ = Параметры.ПСЦ;
	КонецЕсли;
	
	ИсходныйПСЦПриИзмененииНаСервере();
	

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры

