
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Запрос = Новый Запрос;
	
	// если в ПСЦ для выбранного контрагента найдены суммы СНП для конкретного КТК, то
	// заполнить таблицу этими данными.
	// Если по номеру КТК данных нет, то выбирать из ПСЦ данные по типу КТК.
	
	ПолученыДанныеПоНомеруКТК = Ложь;
	
	ИерархическийМассивЛокаций = Локации_сервер.ПолучитьМассивРодителей(Параметры.Отбор.ГородВыдачи,Истина);
	
	Если ЗначениеЗаполнено(Параметры.Отбор.НомерКонтейнера) ТОгда
			Запрос.Текст = "ВЫБРАТЬ
			               |	ПСЦПСЦПоставщика_НомераКТК_ВРП.НомерКонтейнера КАК НомерКонтейнера,
			               |	ПСЦПСЦПоставщика_контейнерыВРП.Ссылка КАК ПСЦ,
			               |	ПСЦПСЦПоставщика_контейнерыВРП.ТипКонтейнера1 КАК ТипКонтейнера,
			               |	ПСЦПСЦПоставщика_контейнерыВРП.Ставка1 КАК Ставка,
			               |	ПСЦПСЦПоставщика_контейнерыВРП.НДС1 КАК НДС,
			               |	ПСЦПСЦПоставщика_контейнерыВРП.НормативПользования1 КАК НормативПользования,
			               |	ПСЦПСЦПоставщика_контейнерыВРП.СтоимостьСНПХранилище КАК СтоимостьСНПХранилище,
			               |	ПСЦПСЦПоставщика_контейнерыВРП.ГородВыдачи1 КАК ГородВыдачи,
			               |	ПСЦПСЦПоставщика_контейнерыВРП.ГородВозврата1 КАК ГородВозврата,
			               |	ПСЦПСЦПоставщика_контейнерыВРП.СозданныйТариф КАК СозданныйТариф,
			               |	ПСЦПСЦПоставщика_контейнерыВРП.Валюта1 КАК Валюта,
			               |	ПСЦПСЦПоставщика_контейнерыВРП.ЕИ КАК ЕИ,
			               |	NULL КАК СтранаВыдачи,
			               |	NULL КАК СтранаВозврата,
			               |	ПСЦПСЦПоставщика_контейнерыВРП.НоменклатураПоставщика1 КАК НоменклатураПоставщика,
			               |	ПСЦПСЦПоставщика_контейнерыВРП.СтавкаВключаетНДС КАК СтавкаВключаетНДС,
			               |	ПСЦПСЦПоставщика_контейнерыВРП.СтоимостьСНП1 КАК СтоимостьСНП
			               |ИЗ
			               |	Документ.ПСЦ.ПСЦПоставщика_НомераКТК_ВРП КАК ПСЦПСЦПоставщика_НомераКТК_ВРП
			               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПСЦ.ПСЦПоставщика_контейнерыВРП КАК ПСЦПСЦПоставщика_контейнерыВРП
			               |		ПО ПСЦПСЦПоставщика_НомераКТК_ВРП.ГУИД = ПСЦПСЦПоставщика_контейнерыВРП.ГУИД
			               |ГДЕ
			               |	ПСЦПСЦПоставщика_НомераКТК_ВРП.НомерКонтейнера = &НомерКонтейнера
			               |	И ПСЦПСЦПоставщика_контейнерыВРП.Ссылка.ПСЦПоставщика
			               |	И ПСЦПСЦПоставщика_контейнерыВРП.ГородВыдачи1 В (&ГородВыдачи)
			               |
			               |ОБЪЕДИНИТЬ ВСЕ
			               |
			               |ВЫБРАТЬ
			               |	ПСЦПСЦПоставщика_НомераКТК_Экспорт.НомерКонтейнера,
			               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.Ссылка,
			               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.ТипКонтейнера1,
			               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.Ставка1,
			               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.НДС1,
			               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.НормативПользования1,
			               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.СтоимостьСНПХранилище,
			               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.ГородВыдачи1,
			               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.ГородВозврата1,
			               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.СозданныйТариф,
			               |	NULL,
			               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.ЕИ,
			               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.СтранаВыдачи1,
			               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.СтранаВозврата1,
			               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.НоменклатураПоставщика1,
			               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.СтавкаВключаетНДС,
			               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.СтоимостьСНП1
			               |ИЗ
			               |	Документ.ПСЦ.ПСЦПоставщика_НомераКТК_Экспорт КАК ПСЦПСЦПоставщика_НомераКТК_Экспорт
			               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПСЦ.ПСЦПоставщика_контейнерыЭкспорт КАК ПСЦПСЦПоставщика_контейнерыЭкспорт
			               |		ПО ПСЦПСЦПоставщика_НомераКТК_Экспорт.ГУИД = ПСЦПСЦПоставщика_контейнерыЭкспорт.ГУИД
			               |ГДЕ
			               |	ПСЦПСЦПоставщика_НомераКТК_Экспорт.НомерКонтейнера = &НомерКонтейнера
			               |	И ПСЦПСЦПоставщика_контейнерыЭкспорт.ГородВыдачи1 В (&ГородВыдачи)
			               |	И ПСЦПСЦПоставщика_контейнерыЭкспорт.Ссылка.ПСЦПоставщика";
			
		Запрос.УстановитьПараметр("НомерКонтейнера",Параметры.Отбор.НомерКонтейнера);
		Запрос.УстановитьПараметр("ТипКонтейнера",Параметры.Отбор.ТипКонтейнера);
		Запрос.УстановитьПараметр("Контрагент",Параметры.Отбор.Контрагент);
		Запрос.УстановитьПараметр("ГородВыдачи",ИерархическийМассивЛокаций);
		
		РЗ = Запрос.Выполнить();
		Если НЕ РЗ.Пустой() Тогда
			
			ТЗ = РЗ.Выгрузить();
			
			Для Каждого Стр Из ТЗ Цикл
				НовСтр = ТаблицаПСЦ.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр,Стр,,"ГородВозврата,СтоимостьСНПХранилище");
				НовСтр.ГородВозврата = ?(ЗначениеЗаполнено(Стр.ГородВозврата),Стр.ГородВозврата.Получить(),Новый СписокЗначений);
				
				ХранЗнач = Стр.СтоимостьСНПХранилище.Получить();
				Если НЕ ХранЗнач = Неопределено И ХранЗнач.Количество()>0 Тогда
					Для Каждого Элем Из ХранЗнач Цикл
						НовСтр2 = НовСтр.СтоимостьСНПХранилище.Добавить();
						ЗаполнитьЗначенияСвойств(НовСтр2,Элем);
					КонецЦикла;
					НовСтр.СтоимостьСНППредставление = "Прогр.шкала";
				Иначе
					НовСтр.СтоимостьСНППредставление = Стр.СтоимостьСНП;
				КонецЕсли;
			КонецЦикла;
			
			ПолученыДанныеПоНомеруКТК = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// если данные получены предыдущим запросом или номер КТК не заполнен, то выполняем этот запрос
	Если ПолученыДанныеПоНомеруКТК = Ложь ИЛИ НЕ ЗначениеЗаполнено(Параметры.Отбор.НомерКонтейнера) Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	ПСЦПСЦПоставщика_контейнерыВРП.НоменклатураПоставщика1 КАК НоменклатураПоставщика,
		               |	ПСЦПСЦПоставщика_контейнерыВРП.ТипКонтейнера1 КАК ТипКонтейнера,
		               |	ПСЦПСЦПоставщика_контейнерыВРП.Ставка1 КАК Ставка,
		               |	ПСЦПСЦПоставщика_контейнерыВРП.НДС1 КАК НДС,
		               |	ПСЦПСЦПоставщика_контейнерыВРП.НормативПользования1 КАК НормативПользования,
		               |	ПСЦПСЦПоставщика_контейнерыВРП.СтоимостьСНП1 КАК СтоимостьСНП,
		               |	ПСЦПСЦПоставщика_контейнерыВРП.СтоимостьСНПХранилище КАК СтоимостьСНПХранилище,
		               |	ПСЦПСЦПоставщика_контейнерыВРП.ГородВыдачи1 КАК ГородВыдачи,
		               |	ПСЦПСЦПоставщика_контейнерыВРП.ГородВозврата1 КАК ГородВозврата,
		               |	ПСЦПСЦПоставщика_контейнерыВРП.СозданныйТариф КАК СозданныйТариф,
		               |	ПСЦПСЦПоставщика_контейнерыВРП.Валюта1 КАК Валюта,
		               |	ПСЦПСЦПоставщика_контейнерыВРП.ЕИ КАК ЕИ,
		               |	NULL КАК СтранаВыдачи,
		               |	NULL КАК СтранаВозврата,
		               |	ПСЦПСЦПоставщика_контейнерыВРП.Ссылка КАК ПСЦ,
		               |	ПСЦПСЦПоставщика_контейнерыВРП.СтавкаВключаетНДС КАК СтавкаВключаетНДС
		               |ИЗ
		               |	Документ.ПСЦ.ПСЦПоставщика_контейнерыВРП КАК ПСЦПСЦПоставщика_контейнерыВРП
		               |ГДЕ
		               |	ПСЦПСЦПоставщика_контейнерыВРП.ТипКонтейнера1 = &ТипКонтейнера
		               |	И ПСЦПСЦПоставщика_контейнерыВРП.Ссылка.Контрагент = &Контрагент
		               |	И ПСЦПСЦПоставщика_контейнерыВРП.Ссылка.ПСЦПоставщика
			           |	И ПСЦПСЦПоставщика_контейнерыВРП.ГородВыдачи1 В (&ГородВыдачи)
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.НоменклатураПоставщика1,
		               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.ТипКонтейнера1,
		               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.Ставка1,
		               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.НДС1,
		               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.НормативПользования1,
		               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.СтоимостьСНП1,
		               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.СтоимостьСНПХранилище,
		               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.ГородВыдачи1,
		               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.ГородВозврата1,
		               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.СозданныйТариф,
		               |	NULL,
		               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.ЕИ,
		               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.СтранаВыдачи1,
		               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.СтранаВозврата1,
		               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.Ссылка,
		               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.СтавкаВключаетНДС
		               |ИЗ
		               |	Документ.ПСЦ.ПСЦПоставщика_контейнерыЭкспорт КАК ПСЦПСЦПоставщика_контейнерыЭкспорт
		               |ГДЕ
		               |	ПСЦПСЦПоставщика_контейнерыЭкспорт.ТипКонтейнера1 = &ТипКонтейнера
		               |	И ПСЦПСЦПоставщика_контейнерыЭкспорт.Ссылка.Контрагент = &Контрагент
			           |	И ПСЦПСЦПоставщика_контейнерыЭкспорт.ГородВыдачи1 В (&ГородВыдачи)
		               |	И ПСЦПСЦПоставщика_контейнерыЭкспорт.Ссылка.ПСЦПоставщика";

		Запрос.УстановитьПараметр("ТипКонтейнера",Параметры.Отбор.ТипКонтейнера);
		Запрос.УстановитьПараметр("Контрагент",Параметры.Отбор.Контрагент);
		Запрос.УстановитьПараметр("ГородВыдачи",ИерархическийМассивЛокаций);
		
		ТЗ = Запрос.Выполнить().Выгрузить();
		Для Каждого Стр Из ТЗ Цикл
			НовСтр = ТаблицаПСЦ.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр,Стр,,"ГородВозврата,СтоимостьСНПХранилище");
			НовСтр.ГородВозврата = ?(ЗначениеЗаполнено(Стр.ГородВозврата),Стр.ГородВозврата.Получить(),Новый СписокЗначений);
			
			ХранЗнач = Стр.СтоимостьСНПХранилище.Получить();
			Если НЕ ХранЗнач = Неопределено И ХранЗнач.Количество()>0 Тогда
				Для Каждого Элем Из ХранЗнач Цикл
					НовСтр2 = НовСтр.СтоимостьСНПХранилище.Добавить();
					ЗаполнитьЗначенияСвойств(НовСтр2,Элем);
				КонецЦикла;
				НовСтр.СтоимостьСНППредставление = "Прогр.шкала";
			Иначе
				НовСтр.СтоимостьСНППредставление = Стр.СтоимостьСНП;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Элементы.ТаблицаПСЦНомерКонтейнера.Видимость = ПолученыДанныеПоНомеруКТК;
	

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры

