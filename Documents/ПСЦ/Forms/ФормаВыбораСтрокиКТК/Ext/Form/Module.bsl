&НаКлиенте
Процедура ТаблицаПСЦВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекСтр = ТаблицаПСЦ.НайтиПоИдентификатору(ВыбраннаяСтрока);
	СТруктураОтвета = СоздатьСтруктуруОтвета(ТекСтр);
	ОповеститьОВыборе(СТруктураОтвета); 
    СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Функция СоздатьСтруктуруОтвета(ТекСтр)
	
	СТруктураОтвета = НОвый СТруктура;
	СТруктураОтвета.Вставить("ПунктОкончательнойСдачиСписок",ТекСтр.ГородВозврата);
	СТруктураОтвета.Вставить("ПСЦ",ТекСтр.ПСЦ);
	Если ТекСтр.СтоимостьСНПХранилище.Количество() = 0 Тогда
		СТруктураОтвета.Вставить("СтавкаСНП",ТекСтр.СтоимостьСНП);
	Иначе
		МассивСтруктур = Новый Массив;
		Для Каждого Стр Из ТекСтр.СтоимостьСНПХранилище Цикл
			СтруктураТбл = Новый Структура;
			СтруктураТбл.Вставить("От",Стр.От);
			СтруктураТбл.Вставить("До",Стр.До);
			СтруктураТбл.Вставить("Стоимость",Стр.Стоимость);
			МассивСтруктур.Добавить(СтруктураТбл);
		КонецЦикла;
		СТруктураОтвета.Вставить("СтавкаСНП",МассивСтруктур);
	КонецЕсли;
	СТруктураОтвета.Вставить("Ставка",ТекСтр.Ставка);
	СТруктураОтвета.Вставить("Валюта",ТекСтр.Валюта);
	СТруктураОтвета.Вставить("ЕдиницаИзмерения",ТекСтр.ЕИ);
	СТруктураОтвета.Вставить("СтавкаНДС",ТекСтр.НДС);
	СТруктураОтвета.Вставить("НДСВключая",ТекСтр.СтавкаВключаетНДС);
	
	Возврат СТруктураОтвета;
	
КонецФункции

&НаКлиенте
Процедура Выбрать(Команда)
	
	ТекД = Элементы.ТаблицаПСЦ.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СТруктураОтвета = СоздатьСтруктуруОтвета(ТекД);
	ОповеститьОВыборе(СТруктураОтвета);
	
КонецПроцедуры
