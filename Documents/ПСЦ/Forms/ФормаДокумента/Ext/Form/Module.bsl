	//ОпОп = Новый ОписаниеОповещения("ОбработатьВводТекстаПараметрыСНП", ЭтаФорма, "РУС");
	//ПоказатьВводСтроки(ОпОп, ТекстПункта, "Добавить следующий текст в <Печать ПСЦ>?",,Истина);
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ИдентификаторСтрокиСНП", ТекД.ПолучитьИдентификатор());
	ПараметрыОповещения.Вставить("ГУИДСтрокиСНП", ТекД.ГУИДСтроки);
	ОпОп = Новый ОписаниеОповещения("ОбработатьВводТекстаПараметрыСНП", ЭтаФорма, ПараметрыОповещения);
	ПоказатьВводСтроки(ОпОп, ТекстПункта, "Перенести следующий текст в <Печать ПСЦ>?",,Истина);
	//Евросиб Каблов 13.03.2023 )
	
