Функция ПроверкаНаПрикрепленные(ТекДок)
	
	ЕстьПрикрепленные = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Файлы.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Файлы КАК Файлы
	               |ГДЕ
	               |	Файлы.ВладелецФайла = &ВладелецФайла
				   //Евросиб Каблов 26.06.2020 ( Ticket#0197685
				   |	И НЕ Файлы.ПометкаУдаления";
				   //Евросиб Каблов 26.06.2020 )
	Запрос.УстановитьПараметр("ВладелецФайла",ТекДок);
	Если Запрос.Выполнить().Пустой() Тогда
		ЕстьПрикрепленные = Ложь;
	КонецЕсли;
	
	Возврат ЕстьПрикрепленные;
	
