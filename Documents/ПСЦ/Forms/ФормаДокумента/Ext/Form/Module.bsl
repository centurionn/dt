&НаКлиенте
Процедура ЗаполнитьСтандартнымиУсловиями(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораСтандартныхУсловий", ЭтаФорма);
	
	ОткрытьФорму("Справочник.СтандартныеУсловияПСЦ.ФормаВыбора",,,ЭтаФорма.УникальныйИдентификатор, ,, ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораСтандартныхУсловий(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
		
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	Если НЕ ПриВыбореДобавлятьВКонецСписка Тогда
		//Евросиб Каблов 13.03.2023 ( Ticket#0265045
		//Объект.ПунктыПСЦ.Очистить();		
		СтрокиСНП = Объект.ПунктыПСЦ.НайтиСтроки(Новый Структура("ИсточникСтроки", "СверхнормативноеПользование"));
		УдаляемыеСтроки = Новый Массив;
		Для Каждого Стр Из Объект.ПунктыПСЦ Цикл
			Если СтрокиСНП.Найти(Стр) = Неопределено Тогда
				УдаляемыеСтроки.Добавить(Стр);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Стр Из УдаляемыеСтроки Цикл
			Объект.ПунктыПСЦ.Удалить(Стр);
		КонецЦикла;
		//Евросиб Каблов 13.03.2023 )
		Объект.ПримечанияПунктовИУсловийПСЦ = "";
	Иначе
		//удалим предопределенные
		ПредопределенныеСтроки = Объект.ПунктыПСЦ.НайтиСтроки(Новый Структура("Предопределенный", Истина));
		Для каждого ПредопределеннаяСтрока Из ПредопределенныеСтроки Цикл
			Объект.ПунктыПСЦ.Удалить(ПредопределеннаяСтрока);
		КонецЦикла; 
	КонецЕсли;
	ОбработкаВыбораСтандартныхУсловий_ЗаполнитьСервер(Параметр1);
	
	//Евросиб Каблов 13.03.2023 ( Ticket#0265045
	СтрокиСНП = Объект.ПунктыПСЦ.НайтиСтроки(Новый Структура("ИсточникСтроки", "СверхнормативноеПользование"));
	КоличествоПунктов = Объект.ПунктыПСЦ.Количество();
	Для Каждого Стр Из СтрокиСНП Цикл
		Индекс = Объект.ПунктыПСЦ.Индекс(Стр);
		КоличествоСтрок = КоличествоПунктов - Стр.НомерСтроки - 1;
		Объект.ПунктыПСЦ.Сдвинуть(Индекс, КоличествоСтрок);
	КонецЦикла;
	//Евросиб Каблов 13.03.2023 )
	
КонецПроцедуры

