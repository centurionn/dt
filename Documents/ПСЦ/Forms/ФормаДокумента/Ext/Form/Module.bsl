&НаКлиенте
Процедура НачалоВыбораСНППоставщика(ИмяТбл)

	ТекД = Элементы[ИмяТбл].ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("СтоимостьСНПТаблица", ТекД.СтоимостьСНПТаблица);
	СтруктураПараметров.Вставить("ТолькоПросмотр", Ложь);
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаСНП", ЭтаФорма, ТекД);
	ОткрытьФорму("Документ.ПСЦ.Форма.ФормаПрогрессивнойШкалыСНП", СтруктураПараметров,,ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

