	Если ИмяСобытия = "ТребуетсяПеречитатьУказанныйДокумент" И Параметр = Объект.Ссылка Тогда
		ЭтаФорма.Прочитать();
		ОбновитьПанельТекущегоПользователя();
		ОбновитьПанельСостояний(); 
		//Евросиб Коханенко Н.А. 08.07.2025 (( #112281
		ОбновитьВидимостьЭлементовПоСостояниямСогласования();
		//Евросиб Коханенко Н.А. 08.07.2025 )) #112281 
	КонецЕсли;
	
	Если ИмяСобытия = "СозданРуководительКонтрагента" И Источник = Строка(ЭтаФорма.УникальныйИдентификатор) Тогда
	//Евросиб Коханенко Н.А. 07.08.2025 (( #112773
		//Объект.РуководительКонтрагента = Параметр;
		//Элементы.РуководительКонтрагента.СписокВыбора.ЗагрузитьЗначения(ПолучитьВсехРуководителейКонтрагента(Объект.Контрагент));
		ЗаполнитьДанныеРуководителяКонтрагента(Параметр);
	ИначеЕсли ИмяСобытия = "СозданПодписантКонтрагента" И Источник = Строка(ЭтаФорма.УникальныйИдентификатор) Тогда 
		ЗаполнитьДанныеПодписантаКонтрагента(Параметр);
	//Евросиб Коханенко Н.А. 07.08.2025 )) #112773 
	КонецЕсли;
	
	// Евросиб Фролов (28.12.2021 TASK№ 42761
	Если ИмяСобытия = "ИзмененаКалькуляция" Тогда
		// Из калькуляции перезаполнены данные для печати
		ЭтаФорма.Прочитать();	
	КонецЕсли;	
	// Евросиб Фролов) 
	
	ОбновитьПодписьДействительнойДоверки();
	
