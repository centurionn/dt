&НаКлиенте
Процедура ПрочитатьСтавки(Команда)
	
	МассивПортовОтправления = Новый Массив;
	МассивПортовОтправления.Добавить("");
	МассивПортовНазначения = Новый Массив;
	МассивПортовНазначения.Добавить("");
	
	Если СписокПортовОтправления.Количество() > 0 Тогда 
		МассивПортовОтправления = СписокПортовОтправления.ВыгрузитьЗначения(); 
		МассивПортовНазначения = СписокПортовНазначения.ВыгрузитьЗначения(); 
	КонецЕсли;
	
	
	НераспознанныеЗначения = Новый Массив;
	
	СтрокДобавлено = 0;
	
	Для каждого ПортОтправления из МассивПортовОтправления Цикл
		Для каждого ПортНазначения из МассивПортовНазначения Цикл
			
			ТекСч = 2;
			ТекстСтроки = ТДИмпортСтавок.Область("R"+ТекСч+"C1").Текст;
			
			Пока ЗначениеЗаполнено(ТекстСтроки) Цикл
				
				Колонка_РазмерКТК = "1";
				Колонка_ПортОтправления = "2";
				Колонка_ПортНазначения = "3";
				Колонка_ЦенаCOC = "4";
				Колонка_ЦенаSOC = "5";
				Колонка_УсловияЛИФИ = "6";
				Колонка_КодТарифаCOC = "7";
				Колонка_КодТарифаSOC = "8";
				Колонка_Груз = "9";
				Колонка_ДопУсловия = "10";
				Колонка_КлассIMO = "11";
				Колонка_КлассUN = "12";
				

				РазмерКТК = ТДИмпортСтавок.Область("R"+ТекСч+"C"+Колонка_РазмерКТК).Текст;
				СтруктураРазмера = РаботаСКонтейнерамиСервер.НайтиТипПоРазмеру(РазмерКТК);
				Если НЕ ЗначениеЗаполнено(СтруктураРазмера) Тогда НераспознанныеЗначения.Добавить(РазмерКТК); КонецЕсли;
				
				POL = ?(ЗначениеЗаполнено(ПортОтправления), ПортОтправления, ТДИмпортСтавок.Область("R"+ТекСч+"C"+Колонка_ПортОтправления).Текст);
				Если ТипЗнч(POL) = Тип("Строка") Тогда POL = Локации_сервер.ПолучитьЛокациюПоНечеткомуПоиску(POL); КонецЕсли;
				Если НЕ ЗначениеЗаполнено(POL) Тогда НераспознанныеЗначения.Добавить(ТДИмпортСтавок.Область("R"+ТекСч+"C"+Колонка_ПортОтправления).Текст); КонецЕсли;
				
				POD = ?(ЗначениеЗаполнено(ПортНазначения), ПортНазначения, ТДИмпортСтавок.Область("R"+ТекСч+"C"+Колонка_ПортНазначения).Текст);
				Если ТипЗнч(POD) = Тип("Строка") Тогда POD = Локации_сервер.ПолучитьЛокациюПоНечеткомуПоиску(POD); КонецЕсли;
				Если НЕ ЗначениеЗаполнено(POD) Тогда НераспознанныеЗначения.Добавить(ТДИмпортСтавок.Область("R"+ТекСч+"C"+Колонка_ПортНазначения).Текст); КонецЕсли;
				
				ЦенаCOC = ТДИмпортСтавок.Область("R"+ТекСч+"C"+Колонка_ЦенаCOC).Текст;
				Попытка
					ЦенаCOC = Число(ЦенаCOC);
				Исключение
					НераспознанныеЗначения.Добавить(ТДИмпортСтавок.Область("R"+ТекСч+"C"+Колонка_ЦенаCOC).Текст);
				КонецПопытки;
				
				
				ЦенаSOC = ТДИмпортСтавок.Область("R"+ТекСч+"C"+Колонка_ЦенаSOC).Текст;
				Попытка
					ЦенаSOC = Число(ЦенаSOC);
				Исключение
					НераспознанныеЗначения.Добавить(ТДИмпортСтавок.Область("R"+ТекСч+"C"+Колонка_ЦенаSOC).Текст);
				КонецПопытки;
				
				УсловияЛИФИ = ТДИмпортСтавок.Область("R"+ТекСч+"C"+Колонка_УсловияЛИФИ).Текст;
				
				КодТарифаCOC = ТДИмпортСтавок.Область("R"+ТекСч+"C"+Колонка_КодТарифаCOC).Текст;
				КодТарифаSOC = ТДИмпортСтавок.Область("R"+ТекСч+"C"+Колонка_КодТарифаSOC).Текст;
				
				Груз = ?(ЗначениеЗаполнено(вн_Груз), вн_Груз, ТДИмпортСтавок.Область("R"+ТекСч+"C"+Колонка_Груз).Текст);
				Если ТипЗнч(Груз) = Тип("Строка") Тогда Груз = ПолучитьГрузЕТСНГ(Груз); КонецЕсли;

				ДопУсловия = ТДИмпортСтавок.Область("R"+ТекСч+"C"+Колонка_ДопУсловия).Текст;
				КлассIMO = ТДИмпортСтавок.Область("R"+ТекСч+"C"+Колонка_КлассIMO).Текст;
				КлассUN = ТДИмпортСтавок.Область("R"+ТекСч+"C"+Колонка_КлассUN).Текст;
				
				
				Если ЗначениеЗаполнено(ЦенаCOC) И ТипЗнч(ЦенаCOC) = Тип("Число") Тогда
					
					НСтр = Объект.ПСЦПоставщика_ТЭО.Добавить();
					НСтр.НоменклатураПоставщика = вн_УслугаФрахта;
					НСтр.Услуга = вн_УслугаФрахта;
					НСтр.ПунктНачалаПеревозки = ТДИмпортСтавок.Область("R"+ТекСч+"C"+Колонка_ПортОтправления).Текст;
					НСтр.ПунктОкончанияПеревозки = ТДИмпортСтавок.Область("R"+ТекСч+"C"+Колонка_ПортНазначения).Текст;
					НСтр.РазмерКонтейнера = ТДИмпортСтавок.Область("R"+ТекСч+"C"+Колонка_РазмерКТК).Текст;
					НСтр.Груженый = ЗначениеЗаполнено(вн_Груз);
					НСтр.ЕдиницаИзмерения = "ктк";
					НСтр.Стоимость =  ТДИмпортСтавок.Область("R"+ТекСч+"C"+Колонка_ЦенаCOC).Текст;
					НСтр.ВидОтправки = "Фрахт";
					НСтр.ПунктНачалаПеревозки1 = POL;
