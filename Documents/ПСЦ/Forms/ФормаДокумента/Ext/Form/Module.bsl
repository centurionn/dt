&НаКлиенте
Процедура ДействияПередЗаписью(Отказ, ПараметрыЗаписи)
	Если ПараметрыЗаписи.Свойство("ТребуетсяПеремаршутизация") И ПараметрыЗаписи.ТребуетсяПеремаршрутизация Тогда
		ПараметрыЗапроса = ПолучитьПараметрыМаршрутизацииНаСервере(Объект);
		РезультатЗапроса = МаршрутизацияСервер.МаршрутизироватьПСЦ(ПараметрыЗапроса, Объект.Дата);
		Если РезультатЗапроса.Количество() > 0 Тогда
			Отказ = ПроверитьУказатьОтветственных(РезультатЗапроса, Истина);
		КонецЕсли;  
	КонецЕсли;
	// Евросиб Фролов (28.12.2021 TASK№ 42761
	Если Не Отказ
		И ЗначениеЗаполнено(Объект.Ссылка) // Евросиб Фролов, 17.01.2022 Ticket№ 0256462
		И НЕ Объект.ПСЦПоставщика
		И НЕ Объект.НетиповойПротокол 
		И Объект.СтатусДокумента = ПредопределенноеЗначение("Перечисление.СтатусыСогласования.Планируется") Тогда
		СравнитьКалькуляции();
	КонецЕсли;

	Если Объект.ДанныеДляПечатиИзменены
		И ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ПоказатьПредупреждение(, "Данные калькуляций, указанных в протоколе, были изменены. Проверьте данные для печати ПСЦ");
		Объект.ДанныеДляПечатиИзменены = Ложь;
	КонецЕсли;	
	// Евросиб Фролов)
КонецПроцедуры


