Процедура ТипКалькуляцииПриИзмененииНаСервере()
	//БИТ Белинский Д.А. 20.06.2023 -начало
	Если Объект.ТипКалькуляции = Перечисления.ТипыКалькуляций.МежсервисныеРасходы 
			ИЛИ Объект.ТипКалькуляции = Перечисления.ТипыКалькуляций.МежсервисныеРасходыРеф Тогда 
		Объект.ДатаПСЦ = ТекущаяДата();
		Объект.ФорматПротокола = Перечисления.ФорматПротокола.ПротоколОдноязычныйУниверсальный;  
		Объект.НачалоДействия = ТекущаяДата();
		Объект.ОтветственныйМенеджер = ПараметрыСеанса.ТекущийПользователь;
	ИначеЕсли ВыбраныМежсервисныеРасходы = Истина Тогда
		ВыбраныМежсервисныеРасходы = Ложь;	
		Объект.ДатаПСЦ =Неопределено;
		Объект.ФорматПротокола = Неопределено;  
		Объект.ТипКалькуляции = Неопределено;   
		Объект.НачалоДействия = Неопределено;
		Объект.ОтветственныйМенеджер = Неопределено;
	КонецЕсли;
	//БИТ Белинский Д.А. 20.06.2023 -конец     
	
	// ДИТ US 59973 ТА 68125 Сержантова А.С. Начало: 24.07.2023
	Если Объект.ТипКалькуляции = ПредопределенноеЗначение("Перечисление.ТипыКалькуляций.Субсидии") ИЛИ Объект.ТипКалькуляции = ПредопределенноеЗначение("Перечисление.ТипыКалькуляций.Премии") Тогда //ДИТ Шевченко А.В. US 103646 TA 103658 10.03.2025
		Элементы.ГруппаПовагонка.Видимость = Ложь;
		Элементы.ГруппаСверхнормативы.Видимость = Ложь; 
		Элементы.ГруппаЛичныеЦели.Видимость = Ложь;
		Элементы.ПрикрепитьПротоколДляСубсидий.Видимость = Истина;
		
		Объект.КалькуляцииПовагонки.Очистить();
		Объект.СверхнормативноеПользование.Очистить();
		Объект.ЛичныеЦели.Очистить();
	Иначе
		Элементы.ГруппаПовагонка.Видимость = Истина;
		Элементы.ГруппаСверхнормативы.Видимость = Истина; 
		Элементы.ГруппаЛичныеЦели.Видимость = Истина;
		Элементы.ПрикрепитьПротоколДляСубсидий.Видимость = Ложь;
	КонецЕсли;
	// ДИТ US 59973 ТА 68125 Сержантова А.С. Конец: 24.07.2023
	
	//Евросиб Шевченко А.В. 07.05.2025 US 94035 TA 104217
	Элементы.СверхнормативыЗаполнитьСверхнормативыПоШаблону.Видимость = Объект.ТипКалькуляции = ПредопределенноеЗначение("Перечисление.ТипыКалькуляций.Мультимодальная") И Объект.ВидПеревозки = ПредопределенноеЗначение("Справочник.ВидыПеревозок.ИмпортМоре");
