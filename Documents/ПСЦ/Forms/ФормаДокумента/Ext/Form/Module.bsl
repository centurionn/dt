&НаКлиенте
Процедура ОткрытьМультилокацию(Элемент, ИмяПоля)
	
	ТекСтрока = Элементы.СверхнормативноеПользование.ТекущаяСтрока;
	ТекДанные = Объект.СверхнормативноеПользование.НайтиПоИдентификатору(ТекСтрока);
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Владелец", ЭтаФорма.УникальныйИдентификатор);
	ПараметрыОтбора.Вставить("ТипЛокации", ПолучитьТипыЛокацийБезСтока());
	
	ТекущаяЛокация = ТекДанные[ИмяПоля];
	Если ЗначениеЗаполнено(ТекущаяЛокация) Тогда
		ПараметрыОтбора.Вставить("Мультилокация", ТекущаяЛокация);	
	КонецЕсли;
	
	ДопПараметры = Новый Структура("ИмяПоля, ТекСтрока", ИмяПоля, ТекСтрока);
	ОповещениеОВыборе = Новый ОписаниеОповещения("ОбработкаВыбораМультилокации", ЭтаФорма, ДопПараметры);
	ОткрытьФорму("ОбщаяФорма.Мультилокации", ПараметрыОтбора, Элемент,,,, ОповещениеОВыборе, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

