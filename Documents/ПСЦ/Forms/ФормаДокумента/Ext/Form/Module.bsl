&НаСервере
Процедура УстановитьВидимостьТранзитаКлиента()
	
	Если РаботаетДатаВнедренияТранзита(Объект) Тогда 
		ВидимостьПоляТранзитныйКлиент = ЭтоТранзитныйКлиент(Объект);
		
		Элементы.ТранзитДляКлиента.Видимость = ВидимостьПоляТранзитныйКлиент;
		Элементы.ТранзитДляКлиента.АвтоОтметкаНезаполненного = ВидимостьПоляТранзитныйКлиент;
		Если ВидимостьПоляТранзитныйКлиент = Ложь Тогда
			Если ЗначениеЗаполнено(ТранзитДляКлиента) Тогда
				ТранзитДляКлиента = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
			КонецЕсли;
		КонецЕсли;                                 
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ПроверитьОбязательностьЗаполненияТранзитаКлиента(Отказ, ТекущийОбъект)
	
	Если РаботаетДатаВнедренияТранзита(ТекущийОбъект) Тогда 
		Если ЭтоТранзитныйКлиент(ТекущийОбъект) Тогда 
			Если Не ЗначениеЗаполнено(ТранзитДляКлиента) Тогда
				ТекстСообщения = "Поле ""Транзит для клиента"" не заполнено";
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,"ТранзитДляКлиента",,Отказ);
			КонецЕсли;		
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры 

&НаСервере
Функция РаботаетДатаВнедренияТранзита(ТекущийОбъект)
	
	ДатаВнедренияТранзита = Константы.ДатаНачалаПроверкиТранзитныхКлиентовВПСЦ.Получить();
	Если ЗначениеЗаполнено(ДатаВнедренияТранзита) Тогда 
		ДатаСравнения = ?(ЗначениеЗаполнено(ТекущийОбъект.Дата), ТекущийОбъект.Дата, ТекущаяДата());
		Если ДатаСравнения >= ДатаВнедренияТранзита Тогда
            Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат Ложь;
	
КонецФункции	

&НаСервере
Функция ЭтоТранзитныйКлиент(ТекущийОбъект)
	
	Если ЗначениеЗаполнено(ТекущийОбъект.Контрагент) И ЗначениеЗаполнено(ТекущийОбъект.Договор) Тогда
		//Евросиб(ДИТ) Серебреников А.Г. US 110525 ТА 110526 27.05.25 Начало
		ЭтоТранзитныйКлиент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущийОбъект.Контрагент,"ТранзитныйКлиент"); 
		вхВидДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущийОбъект.Договор, "ВидДоговора");
		ВидимостьПоляТранзитныйКлиент = ЭтоТранзитныйКлиент И Не ТекущийОбъект.ПСЦПоставщика И вхВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем"); 
		//Евросиб(ДИТ) Серебреников А.Г. US 110525 ТА 110526 27.05.25 Конец
		Если ВидимостьПоляТранзитныйКлиент Тогда 
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат Ложь;
	
КонецФункции	//Евросиб(ДИТ) Серебреников А.Г. US 107184 ТА 107186 19.05.25 Конец 
