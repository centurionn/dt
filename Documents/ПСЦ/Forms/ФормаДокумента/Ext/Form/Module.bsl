&НаКлиенте
Процедура ЗапуститьНаСогласование(Команда)
	
	Если ЭтаФорма.Модифицированность Тогда 
		Записать(); 
	КонецЕсли;
	
	Если Не Объект.НетиповойПротокол 
		//Евросиб Коханенко Н.А. 17.12.2024 (( #88818
		И НЕ Объект.Нотис
		//Евросиб Коханенко Н.А. 17.12.2024 )) #88818
		И Не ЗначениеЗаполнено(Объект.ФорматПротокола) Тогда
		СП = Новый СообщениеПользователю;
		СП.Текст = "Формат протокола должен быть заполнен!";
		СП.Поле = "Объект.ФорматПротокола";
		СП.УстановитьДанные(Объект);
		СП.Сообщить();
		Возврат;
	КонецЕсли;
	
	// проверим наличие согласований в таблице. если нет, то не запускать процесс
	//ДИТ Авдеева В.С. 0280868 Начало 06.09.2022  
	ЕстьСогласованиеВСтатусеОтличнымОтПланируется = Ложь;
	//ДИТ Авдеева В.С. 0280868 Конец 06.09.2022
	ДанныеЕсть = Ложь;
	Для Каждого Стр Из объект.Состояния Цикл
		Если ПолучитьСогласование(Стр.Состояние) Тогда
			ДанныеЕсть = Истина;
			//ДИТ Авдеева В.С. 0280868 Начало 06.09.2022 
			//Прервать;    
			Если Стр.Статус <> ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Новый") Тогда
				ЕстьСогласованиеВСтатусеОтличнымОтПланируется = Истина;
			КонецЕсли;
			//ДИТ Авдеева В.С. 0280868 Конец 06.09.2022
		КонецЕсли;
	КонецЦикла;
	Если ДанныеЕсть = Ложь Тогда
		Сообщить("В таблице Состояния нет ни одного согласования!");
		Возврат;
	КонецЕсли;

	//ДИТ Авдеева В.С. 0280868 Начало 06.09.2022 
	Если Не ЕстьСогласованиеВСтатусеОтличнымОтПланируется Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("ПСЦ не передан на согласование, необходимо выполнить предшествующие этапы");
		Возврат;
	КонецЕсли;
	//ДИТ Авдеева В.С. 0280868 Конец 06.09.2022
	
	// если документ НЕ типовой, то запустить на согласование только в том случае, если есть прикрепленные файлы
	Если Объект.НетиповойПротокол И НЕ ПроверкаНаПрикрепленные(Объект.Ссылка) 
//Евросиб Гудкова( 29.07.2020 Ticket№ 0201278
		И НЕ Объект.ПСЦПоставщикаФрахт
// Евросиб Гудкова) 		
		Тогда
		Сообщить("Протокол является нетиповым! Прикрепите файлы!");
		Возврат;
	КонецЕсли;
	
//по требованию Ложниковой запрос в Спарк отключен, требуется только для согласования договоров.	
//	// если спарк запрос выполнен более 3 дней назад, то запросить заново
////Евросиб Гудкова( 04.02.2020 Ticket№ 0185919
//	Если ПолучитьЗначениеРеквизитаНаСервере(Объект.Контрагент, "СтранаРегистрации") <> ПредопределенноеЗначение("Справочник.СтраныМира.Россия") Тогда
		СПАРК_СкачатьДосьеЗавершение(КодВозвратаДиалога.Нет, Неопределено);
//// Евросиб Гудкова) 	
//	ИначеЕсли СПАРКЗапросыСервер.ЗапросБылВыполненМенее3ДнейНазад(Объект.Контрагент) Тогда
//		ПоказатьВопрос(Новый ОписаниеОповещения("СПАРК_СкачатьДосьеЗавершение", ЭтаФорма), "Предыдущий запрос досье СПАРК был выполнен менее трех дней назад. Загрузить актуальную версию досье контрагента?",
//		РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Нет,, КодВозвратаДиалога.Нет);
//	Иначе
//		СПАРК_СкачатьДосьеЗавершение(КодВозвратаДиалога.Да, Неопределено);
//	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СПАРК_СкачатьДосьеЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	Если Ответ = КодВозвратаДиалога.Да Тогда
		СПАРК_СкачатьДосьеФрагмент();
		СПАРК_ОбновитьПоказателиЗавершение(РезультатВопроса, ДополнительныеПараметры);
	КонецЕсли;		
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаСогласования", ЭтаФорма);
	
	ТекПроцессСогл = ПечатьБухгалтерскихДокументов.ПроверитьНаличиеПроцесса(Объект.Ссылка);
	Если ТекПроцессСогл = ПредопределенноеЗначение("Справочник.ПроцессСогласования.ПустаяСсылка") Тогда
		// создать новые документы. закомметировано 09.01.2020. не создавать новые документы, только отображать
		//СоздатьНовыеТабДоки();
		ПараметрыФормы = Новый Структура("ДокументСогласования", Объект.Ссылка);
	Иначе
		ПараметрыФормы = Новый Структура("Ключ", ТекПроцессСогл);
	КонецЕсли;
	ОткрытьФорму("Справочник.ПроцессСогласования.ФормаОбъекта", ПараметрыФормы,ЭтаФорма, ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

