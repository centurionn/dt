&НаСервере
Процедура СоздатьКарточкуПСЦвДОНаСервере()  
	
	ОрганизацияДКП = Константы.ОсновнаяОрганизация.Получить();
	Если не (Объект.Организация = ОрганизацияДКП и 
		(Объект.ТипКалькуляции = Перечисления.ТипыКалькуляций.МежсервисныеРасходы 
		или Объект.ТипКалькуляции = Перечисления.ТипыКалькуляций.МежсервисныеРасходыРеф)) Тогда
		
		ДанныеДляОтправки = ЕСОбменСервер.ПодготовитьТаблицуПСЦдляОтправкиДО(Объект.Ссылка);
		ЕСОбменСервер.СоздатьКарточкуПСЦвДО(ДанныеДляОтправки);  
		
		Если СтрНайти(ДанныеДляОтправки[0].Сообщение, "ОК") <> 0 Тогда 
