&НаКлиенте
Процедура ПриНачалеРедактированияТблПостащика(ИмяТбл,НоваяСтрока,Копирование)

	ТекД = Элементы[ИмяТбл].ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НоваяСтрока ИЛИ Копирование ИЛИ НЕ ЗначениеЗаполнено(ТекД.ГУИДСтроки) Тогда
		ТекД.ГУИДСтроки = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	Если ТекД.СтоимостьСНПТаблица.Количество() = 0 Тогда
		Если ТипЗнч(ТекД.СтоимостьСНППредставление) = Тип("Строка") ИЛИ
			ТипЗнч(ТекД.СтоимостьСНППредставление) = Тип("Неопределено") Тогда
			ТекД.СтоимостьСНППредставление = 0;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

