// Функция обновляет панель состояний документа для графического отражения его движения по состояниям
&НаСервере
Процедура ОбновитьПанельСостояний()

	МаршрутизацияСервер.ОбновитьПанельСостояний(ЭтотОбъект);
	
	// +Шейко ОЕ [Ticket#0204619] Блокировка завершенных калькуляций
	КолСостоянийЗавершено = 0;
	
	Для каждого Стр из Объект.Ссылка.Состояния Цикл //Гудкова добавила ссылку
		
		Если Стр.Статус = Перечисления.СтатусыЭтапов.Выполнен Тогда
		
			КолСостоянийЗавершено = КолСостоянийЗавершено + 1;
		
		КонецЕсли;
		
	КонецЦикла;
	
	//РамкаПроцессная = Новый Рамка(ТипРамкиЭлементаУправления.Одинарная, 2);
	
	Если ЗначениеЗаполнено(Объект.Ссылка) И КолСостоянийЗавершено = Объект.ссылка.Состояния.Количество() Тогда
		Элементы.ГруппаИнформацияОДокументе.Видимость = Истина;
		
		Элементы.ПредупреждениеРедактирования.Заголовок = "Документ полностью отработан. Запись заблокирована";
	Иначе	
		Элементы.ГруппаИнформацияОДокументе.Видимость = Ложь;
	КонецЕсли;
	// -Шейко ОЕ [Ticket#0204619] Блокировка завершенных калькуляций
	
	// ДИТ US 64822 Сержантова А.С. Начало: 28.06.2023
    Элементы.СсылкаНаПротоколВДО.Видимость = ЗначениеЗаполнено(Объект.СсылкаНаВнутреннийДокументДО);
	// ДИТ US 64822 Сержантова А.С. Конец: 28.06.2023

КонецПроцедуры

