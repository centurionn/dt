		//НовСтр.Вознаграждение = СтруктураДанныхКалькуляции.Вознагр;
		//ДатаНачалаНовогоРасчетаВознаграждения = ПолучитьДатуНачалаНовогоРасчетаВознаграждения();
		//Если СтруктураДанныхКалькуляции.Дата > ДатаНачалаНовогоРасчетаВознаграждения Тогда
			НовСтр.Вознаграждение = ?(СтруктураДанныхКалькуляции.РасчетнаяКонтрибуция = неопределено,0,СтруктураДанныхКалькуляции.РасчетнаяКонтрибуция);
		//Иначе
		//	НовСтр.Вознаграждение = СтруктураДанныхКалькуляции.Вознагр;
		//КонецЕсли;
		//Евросиб Шевченко А.В. US 99262 TA 121126 09.10.2025
		
	КонецЦикла;
	
