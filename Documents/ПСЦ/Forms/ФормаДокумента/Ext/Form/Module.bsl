		|	СтандартныеУсловияПСЦПунктыПСЦ.НомерПункта КАК НомерПункта,
		|	СтандартныеУсловияПСЦПунктыПСЦ.ТекстПунктаРус КАК ТекстПунктаРус,
		|	СтандартныеУсловияПСЦПунктыПСЦ.ТекстПунктаАнгл КАК ТекстПунктаАнгл,
		|	СтандартныеУсловияПСЦПунктыПСЦ.Ссылка.ПримечанияПунктовИУсловийПСЦ КАК ПримечанияПунктовИУсловийПСЦ,
		//Евросиб Коханенко Н.А. 01.11.2024 (( #92915
		|	СтандартныеУсловияПСЦПунктыПСЦ.Макет КАК Макет,		
		//Евросиб Коханенко Н.А. 01.11.2024 )) #92915 
		|   Ложь Как Предопределенный 
		|ИЗ
		|	Справочник.СтандартныеУсловияПСЦ.ПунктыПСЦ КАК СтандартныеУсловияПСЦПунктыПСЦ
		|ГДЕ
		|	СтандартныеУсловияПСЦПунктыПСЦ.Ссылка = &Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СтандартныеУсловияПСЦПунктыПСЦ.Заголовок,
		|	СтандартныеУсловияПСЦПунктыПСЦ.НомерПункта,
		|	СтандартныеУсловияПСЦПунктыПСЦ.ТекстПунктаРус,
		|	СтандартныеУсловияПСЦПунктыПСЦ.ТекстПунктаАнгл,
		|	СтандартныеУсловияПСЦПунктыПСЦ.Ссылка.ПримечанияПунктовИУсловийПСЦ,
		//Евросиб Коханенко Н.А. 01.11.2024 (( #92915
		|	СтандартныеУсловияПСЦПунктыПСЦ.Макет КАК Макет,		
		//Евросиб Коханенко Н.А. 01.11.2024 )) #92915 
		|   Истина 
		|ИЗ
		|	Справочник.СтандартныеУсловияПСЦ.ПунктыПСЦ КАК СтандартныеУсловияПСЦПунктыПСЦ
		|ГДЕ
		|	СтандартныеУсловияПСЦПунктыПСЦ.Ссылка = ЗНАЧЕНИЕ(Справочник.СтандартныеУсловияПСЦ.СтандартныйПунктШаблона)";
		Запрос.УстановитьПараметр("Ссылка", Параметр1);
		Ответ = Запрос.Выполнить().Выбрать();
		ОписаниеПункта = "";
		Пока Ответ.Следующий() Цикл
			СтрокаПункт = Объект.ПунктыПСЦ.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПункт, Ответ);
			Если ЗначениеЗаполнено(СтрокаПункт.НомерПункта) Тогда
				ПоследнийНомерПункта = СтрокаПункт.НомерПункта;
			КонецЕсли; 
			Если СтрокаПункт.Предопределенный И ЗначениеЗаполнено(ПоследнийНомерПункта) Тогда
				ПозицияТочки = СтрНайти(ПоследнийНомерПункта,".");
				Если ПозицияТочки = 0 Тогда
					СтрокаПункт.НомерПункта = Число(ПоследнийНомерПункта)+1;	
				Иначе
					СтрокаПункт.НомерПункта = ""+(Число(Лев(ПоследнийНомерПункта, СтрНайти(ПоследнийНомерПункта,".")-1))+1)+".";	
				КонецЕсли; 
			КонецЕсли; 
			ОписаниеПункта = Ответ.ПримечанияПунктовИУсловийПСЦ;
			
		КонецЦикла;
		
		Объект.ПримечанияПунктовИУсловийПСЦ = Объект.ПримечанияПунктовИУсловийПСЦ + ?(Объект.ПримечанияПунктовИУсловийПСЦ = "", "", Символы.ПС) + ОписаниеПункта;  
		
	КонецЕсли;
	
