Процедура ДополнитьСтруктуруСНПДаннымиСервер(СтруктураСНП)
	
	СтруктураСНП.Вставить("СобытиеНачалаНаименование");
	СтруктураСНП.Вставить("СобытиеНачалаТекстВРодительномПадеже");
	СтруктураСНП.Вставить("СобытиеОкончанияНаименование");
	СтруктураСНП.Вставить("СобытиеОкончанияТекстВРодительномПадеже");
	СтруктураСНП.Вставить("ЛокацияНачалаНаименование");
	СтруктураСНП.Вставить("ЛокацияОкончанияНаименование");
	СтруктураСНП.Вставить("ВалютаНаименование");
	СтруктураСНП.Вставить("ТипКТКНаименование");
	//СтруктураСНП.Вставить("");
	//СтруктураСНП.Вставить("");	
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&СобытиеНачалаРасчетаПользования КАК СобытиеНачалаРасчетаПользования,
	|	&СобытиеОкончанияРасчетаПользования КАК СобытиеОкончанияРасчетаПользования,
	|	&ЛокацияСобытияНачала КАК ЛокацияСобытияНачала,
	|	&ЛокацияСобытияОкончания КАК ЛокацияСобытияОкончания,
	|	&Валюта КАК Валюта,
	|	&ТипКТК КАК ТипКТК
	|ПОМЕСТИТЬ ВТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СобытияНачала.Наименование КАК СобытиеНачалаНаименование,
	|	СобытияНачала.ТекстВРодительномПадеже КАК СобытиеНачалаТекстВРодительномПадеже,
	|	СобытияОкончания.Наименование КАК СобытиеОкончанияНаименование,
	|	СобытияОкончания.ТекстВРодительномПадеже КАК СобытиеОкончанияТекстВРодительномПадеже,
	|	ЕСТЬNULL(ЛокацииНачала.Наименование, """") КАК ЛокацияНачалаНаименование,
	|	ЕСТЬNULL(ЛокацииОкончания.Наименование, """") КАК ЛокацияОкончанияНаименование,
	|	Валюты.Наименование КАК ВалютаНаименование,
	|	РазмерыКТК.Наименование КАК ТипКТКНаименование
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СобытияНачалаИОкончанияРасчетаПользования КАК СобытияНачала
	|		ПО ВТ.СобытиеНачалаРасчетаПользования = СобытияНачала.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СобытияНачалаИОкончанияРасчетаПользования КАК СобытияОкончания
	|		ПО ВТ.СобытиеОкончанияРасчетаПользования = СобытияОкончания.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Локации КАК ЛокацииНачала
	|		ПО ВТ.ЛокацияСобытияНачала = ЛокацииНачала.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Локации КАК ЛокацииОкончания
	|		ПО ВТ.ЛокацияСобытияОкончания = ЛокацииОкончания.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
	|		ПО ВТ.Валюта = Валюты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РазмерыКТК КАК РазмерыКТК
	|		ПО ВТ.ТипКТК = РазмерыКТК.Ссылка";
	
	ТипМультилокации = Тип("СправочникСсылка.Мультилокации");
	Если ТипЗнч(СтруктураСНП.ЛокацияСобытияНачала) = ТипМультилокации Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Локации КАК ЛокацииНачала", "ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Мультилокации КАК ЛокацииНачала");
	КонецЕсли;
	
	Если ТипЗнч(СтруктураСНП.ЛокацияСобытияОкончания) = ТипМультилокации Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Локации КАК ЛокацииОкончания", "ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Мультилокации КАК ЛокацииОкончания");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("СобытиеНачалаРасчетаПользования", СтруктураСНП.СобытиеНачалаРасчетаПользования);
	Запрос.УстановитьПараметр("СобытиеОкончанияРасчетаПользования", СтруктураСНП.СобытиеОкончанияРасчетаПользования);
	Запрос.УстановитьПараметр("ЛокацияСобытияНачала", СтруктураСНП.ЛокацияСобытияНачала);
	Запрос.УстановитьПараметр("ЛокацияСобытияОкончания", СтруктураСНП.ЛокацияСобытияОкончания);
	Запрос.УстановитьПараметр("Валюта", СтруктураСНП.Валюта);
	Запрос.УстановитьПараметр("ТипКТК", СтруктураСНП.ТипКТК);
	//Запрос.УстановитьПараметр("", );
	//Запрос.УстановитьПараметр("", );
	//Запрос.УстановитьПараметр("", );
	//Запрос.УстановитьПараметр("", );
	//Запрос.УстановитьПараметр("", );
	
	Выборка = Запрос.Выполнить().Выбрать();	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураСНП, Выборка);
	КонецЕсли;
	
	СтруктураСНП.ЛокацияНачалаНаименование = СокрЛП(СтруктураСНП.ЛокацияНачалаНаименование);
	СтруктураСНП.ЛокацияОкончанияНаименование = СокрЛП(СтруктураСНП.ЛокацияОкончанияНаименование);
	
	Если СтруктураСНП.ЕдиницаИзмеренияРасчетаСНП = Перечисления.ЕдиницыИзмеренияВремениРасчетаСНП.Часы Тогда
		ЕдиницаВремени = "час";
		ЕдиницаВремениВоМножественномЧисле = "часов";
		ЕдиницаВремениСокр = "ч.";
	Иначе
		ЕдиницаВремени = "сутки";
		ЕдиницаВремениВоМножественномЧисле = "суток";
		ЕдиницаВремениСокр = "сут.";
	КонецЕсли;	
	СтруктураСНП.Вставить("ЕдиницаВремени", ЕдиницаВремени);
	СтруктураСНП.Вставить("ЕдиницаВремениВоМножественномЧисле", ЕдиницаВремениВоМножественномЧисле);
	СтруктураСНП.Вставить("ЕдиницаВремениСокр", ЕдиницаВремениСокр);
	
	Если СтруктураСНП.ВариантОпределенияДатыКурсаВалют = Перечисления.ВариантыОпределенияДатыКурсаВалют.НаДатуВозвратаПорожнегоКТКпоИнструкции Тогда
		ТекстВариантОпределенияДатыКурсаВалют = " на дату возврата порожнего КТК по инструкции";
	ИначеЕсли СтруктураСНП.ВариантОпределенияДатыКурсаВалют = Перечисления.ВариантыОпределенияДатыКурсаВалют.НаДатуВыставленияСчета Тогда
		ТекстВариантОпределенияДатыКурсаВалют = " на дату выставления счета";
	ИначеЕсли СтруктураСНП.ВариантОпределенияДатыКурсаВалют = Перечисления.ВариантыОпределенияДатыКурсаВалют.НаДатуОплатыСчета Тогда
		ТекстВариантОпределенияДатыКурсаВалют = " на дату оплаты счета";
	ИначеЕсли СтруктураСНП.ВариантОпределенияДатыКурсаВалют = Перечисления.ВариантыОпределенияДатыКурсаВалют.НаДатуСчета Тогда
		ТекстВариантОпределенияДатыКурсаВалют = " на дату счета";
	Иначе
		ТекстВариантОпределенияДатыКурсаВалют = "";
	КонецЕсли;
	СтруктураСНП.Вставить("ТекстВариантОпределенияДатыКурсаВалют", ТекстВариантОпределенияДатыКурсаВалют);
	
	Если СтруктураСНП.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС Или Не ЗначениеЗаполнено(СтруктураСНП.СтавкаНДС) Тогда
		ТекстСтавкаНДС = "Ставка за сверхнормативное пользование указана без учета НДС.";
	Иначе
		Если СтруктураСНП.СтавкаВключаетНДС Тогда
			ШаблонСтавкаНДС = "Включая НДС %1.";
		Иначе
			ШаблонСтавкаНДС = "Кроме того, НДС %1.";
		КонецЕсли;
		ТекстСтавкаНДС = СтрШаблон(ШаблонСтавкаНДС, Строка(СтруктураСНП.СтавкаНДС));
	КонецЕсли;
	СтруктураСНП.Вставить("ТекстСтавкаНДС", ТекстСтавкаНДС);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТекстПунктаПСЦпоСтрокеСНП(СтруктураСНП) //Евросиб Шевченко А.В. 12.05.2025 US 94035 TA 104217
	
	//Тариф
	Если СтруктураСНП.СтавкаПрогрессивная Тогда
		
		//Если в поле "Ставка прогрессивная" стоит чек-бокс, то {значение из поля "Ставка за СНП" на вкладке "Сверхнормативы" в  виде текста:
		//1 - {значение из поля "От >=}
		//2 - {значение из поля "До, <="}
		//3 - единица измерения
		//4 - {значение из поля "Стоимость"
		//5 - {значение из поля "Валюта" на той же вкладке}
		//6 - {значение из поля "Расчет СНП в" на  той же вкладке}
		ШаблонТарифа = "- %1%2 %3 по тарифу %4 %5 за 1 КТК за %6";
		
		//Значения выводятся построчно до последнего условия, отраженного при прогрессивной ставке СНП.";
		СтрокиШкалы = Объект.ПрогрессивнаяШкалаСНП.НайтиСтроки(Новый Структура("ГУИДСтроки", СтруктураСНП.ГУИДСтроки));
		ТекстыСтрокШкалы = Новый Массив;
		ТекстыСтрокШкалы.Добавить("");
		Для Каждого СтрШкалы Из СтрокиШкалы Цикл
			
			Если СтрШкалы.От = 0 Тогда
				СтрокаОт = "с 1";
			Иначе
				СтрокаОт = СтрШаблон("с %1", СтрШкалы.От);
			КонецЕсли;
			
			Если СтрШкалы.До = 0 Тогда
				СтрокаДо = "";				
				ТекЕдиницаВремени = СтруктураСНП.ЕдиницаВремениВоМножественномЧисле;
			Иначе
				СтрокаДо = СтрШаблон(" по %1", СтрШкалы.До);
				ТекЕдиницаВремени = СтруктураСНП.ЕдиницаВремени;
			КонецЕсли;
			
			
			ТекстСтрокиШкалы = СтрШаблон(ШаблонТарифа, СтрокаОт, СтрокаДо, ТекЕдиницаВремени, СтрШкалы.Стоимость, СтруктураСНП.ВалютаНаименование, СтруктураСНП.ЕдиницаВремени);
			ТекстыСтрокШкалы.Добавить(ТекстСтрокиШкалы);
			
		КонецЦикла;
		
		СтрокаТариф = СтрСоединить(ТекстыСтрокШкалы, Символы.ПС);
		
	Иначе
		
		//Если в поле "Ставка прогрессивная" не стоит чек-бокс, то {значение из поля "Ставка за СНП" на вкладке "Сверхнормативы"} {значение из поля "Валюта" на той же вкладке} за {значение из поля "Расчет СНП в" на  той же вкладке}.
		//1 - {значение из поля "Ставка за СНП" на вкладке "Сверхнормативы"}
		//2 - {значение из поля "Валюта" на той же вкладке}
		//3 - {значение из поля "Расчет СНП в" на  той же вкладке}
		ШаблонТарифа = "%1 %2 за 1 КТК за %3";
		СтрокаТариф = СтрШаблон(ШаблонТарифа, СтруктураСНП.Ставка, СтруктураСНП.ВалютаНаименование, СтруктураСНП.ЕдиницаВремени);
		
	КонецЕсли;
	
	//1 - ссылка на значение из поля "Тип КТК" на вкладке "Сверхнормативы"
	//2 - {ссылка на значение из поля "Нормативный срок" на вкладке "Сверхнормативы"}
	//3 - единица времени во множественном числе
	//4 - {ссылка на значение из поля "Событие начала пользования" на вкладке "Сверхнормативы"}
	//5 - {ссылка на значение из поля «Локация события» под полем "Событие начала.." на вкладке "Сверхнормативы"}
	//6 - {ссылка на поле "Событие окончания пользования" на вкладке "Сверхнормативы"}
	//7 - {ссылка на значение из поля "Локация события" под полем "Событие окончания" на вкладке "Сверхнормативы"}
	//8 - Тариф 
	// ДИТ 0310437 Сержантова А.С. Начало: 18.05.2023
	// Было:
	//Шаблон = "Использование КТК %1 (фут.) сверх вышеуказанного нормативного срока - %2 %3%4 с/в/на %5%6 с/в/на %7 оплачивается по следующим тарифам: %8."; 
	//Стало:
	Шаблон = "Использование КТК %1 (фут.) сверх нормативного срока - %2 %3%4 с/в/на %5%6 с/в/на %7 оплачивается по следующим тарифам: %8.";
	// ДИТ 0310437 Сержантова А.С. Конец: 18.05.2023
	ЛокацияЗаводСклад = "Завод/склад клиента";
	ЛокацияНачала = ?(ЗначениеЗаполнено(СтруктураСНП.ЛокацияНачалаНаименование), СтруктураСНП.ЛокацияНачалаНаименование, ЛокацияЗаводСклад);
	ЛокацияОкончания = ?(ЗначениеЗаполнено(СтруктураСНП.ЛокацияОкончанияНаименование), СтруктураСНП.ЛокацияОкончанияНаименование, ЛокацияЗаводСклад);
	СобытиеНачалаТекстВРодительномПадеже = ?(ЗначениеЗаполнено(СтруктураСНП.СобытиеНачалаТекстВРодительномПадеже), СтрШаблон(" с %1", СтруктураСНП.СобытиеНачалаТекстВРодительномПадеже), "");
	СобытиеОкончанияТекстВРодительномПадеже = ?(ЗначениеЗаполнено(СтруктураСНП.СобытиеОкончанияТекстВРодительномПадеже), СтрШаблон(" до %1", СтруктураСНП.СобытиеОкончанияТекстВРодительномПадеже), "");
	ТекстСНП = СтрШаблон(Шаблон, СтруктураСНП.ТипКТК, СтруктураСНП.НормативныйСрок, СтруктураСНП.ЕдиницаВремениСокр, СобытиеНачалаТекстВРодительномПадеже, ЛокацияНачала, СобытиеОкончанияТекстВРодительномПадеже, ЛокацияОкончания, СтрокаТариф);
	
	//Валюта	
	//|Расчеты производятся в рублях РФ на дату {значение из поля «Курс валюты на дату», на вкладке "Сверхнормативы", если в этом поле значение "Не требуется", то оставляем поле пустым, чтобы пользователь мог вручную вписать определенную дату или описал событие}
	//{значение из поля «Курс валюты на дату», на вкладке "Сверхнормативы", если в этом поле значение "Не требуется", то оставляем поле пустым, чтобы пользователь мог вручную вписать определенную дату или описал событие}
	ШаблонТекстаВалюта = "Расчеты производятся в рублях РФ%1.";
	ТекстВалюта = СтрШаблон(ШаблонТекстаВалюта, СтруктураСНП.ТекстВариантОпределенияДатыКурсаВалют);
	
	//Ставка НДС
	//Если СтруктураСНП.СтавкаВключаетНДС Тогда
	//	ШаблонТекстаНДС = "Ставка включает НДС%1.";
	//Иначе
	//	ШаблонТекстаНДС = "Ставка за СНП указана без учета НДС%1.";
	//КонецЕсли;
	//
	//Если ЗначениеЗаполнено(СтруктураСНП.ТекстСтавкаНДС) Тогда
	//	ТекстСтавкаНДС = СтрШаблон(" %1", СтруктураСНП.ТекстСтавкаНДС);
	//Иначе
	//	ТекстСтавкаНДС = "";
	//КонецЕсли;
	//	
	//ТекстНДС = СтрШаблон(ШаблонТекстаНДС, ТекстСтавкаНДС);
	ТекстНДС = СтруктураСНП.ТекстСтавкаНДС;
	
	Возврат ТекстСНП + Символы.ПС + ТекстВалюта + Символы.ПС + ТекстНДС;
	
КонецФункции

//ДИТ, Беляев СЮ, ТА47544, 09-03-2022, начало
&НаКлиенте
Процедура ОбработатьВводТекстаПараметрыСНП(Строка, Параметры) Экспорт
    Если Строка = Неопределено Тогда
        Возврат;
	КонецЕсли;         	
	//создать строку в пунктах ПСЦ
	//Евросиб Каблов 13.03.2023 ( Ticket#0265045
	//НоваяСтрокаПунктаПСЦ = Объект.ПунктыПСЦ.Добавить();
	ИсточникСтроки = "СверхнормативноеПользование";
	НайденныеСтроки = Объект.ПунктыПСЦ.НайтиСтроки(Новый Структура("ИсточникСтроки, ИдентификаторСтрокиИсточника", ИсточникСтроки, Параметры.ГУИДСтрокиСНП));
	Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
		НоваяСтрокаПунктаПСЦ = НайденныеСтроки[0];
	Иначе
		НоваяСтрокаПунктаПСЦ = Объект.ПунктыПСЦ.Добавить();
		НоваяСтрокаПунктаПСЦ.ИсточникСтроки = "СверхнормативноеПользование";
		НоваяСтрокаПунктаПСЦ.ИдентификаторСтрокиИсточника = Параметры.ГУИДСтрокиСНП;
		//строку ставим на предпоследнее место
		Индекс = Объект.ПунктыПСЦ.Индекс(НоваяСтрокаПунктаПСЦ); 	
		Если Индекс <> 0 Тогда
			Объект.ПунктыПСЦ.Сдвинуть(Индекс,-1);
		КонецЕсли;
	КонецЕсли;
	
