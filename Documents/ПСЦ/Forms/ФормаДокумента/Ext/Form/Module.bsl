&НаКлиенте
Процедура ПСЦПоставщикаСтоимостьСНП1НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекД = Элементы.ПСЦПоставщика.ТекущиеДанные;
	Если ТекД = неопределено Тогда Возврат; КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТекД.ГУИДСтроки) Тогда ТекД.ГУИДСтроки = Строка(Новый УникальныйИдентификатор()); КонецЕсли;
	
	ИмяТЧ = "ПСЦПоставщика_вагоны";
	ГУИДСтроки = ТекД.ГУИДСтроки;
	
	ТаблицаТекущихСНП = Новый Массив;
	Для каждого Стр из Объект.ПрогрессивнаяШкалаСНП Цикл
		Если Стр.ТЧ <> ИмяТЧ ИЛИ Стр.ГУИДСтроки <> ГУИДСтроки Тогда Продолжить; КонецЕсли;
		ТаблицаТекущихСНП.Добавить(Новый Структура("ТЧ, ГУИДСтроки, От, До, Стоимость", ИмяТЧ, ГУИДСтроки, Стр.От, Стр.До, Стр.Стоимость));
	КонецЦикла;
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаРедактированияСНП", ЭтаФорма, Новый Структура("ИмяТЧ, ГУИДСтроки", ИмяТЧ, ГУИДСтроки));
	ОткрытьФорму("Документ.ПСЦ.Форма.ФормаПрогрессивнойШкалыСНП", Новый Структура("ТаблицаТекущихСНП", ТаблицаТекущихСНП),, ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаРедактированияСНП(Элемент, СтандартнаяОбработка) Экспорт
	
	Если Элемент = неопределено Тогда Возврат; КонецЕсли;
	
	Для Сч = 0 По Элемент.Количество()-1 Цикл
		
		Если Сч = 0 Тогда
			
			Отбор = Новый Структура("ТЧ, ГУИДСтроки", Элемент[Сч].ТЧ, Элемент[Сч].ГУИДСтроки);
			НайдСтроки = Объект.ПрогрессивнаяШкалаСНП.НайтиСтроки(Отбор);
			Для каждого Стр2 из НайдСтроки Цикл Объект.ПрогрессивнаяШкалаСНП.Удалить(Стр2); КонецЦикла;
			
		КонецЕсли;
		
		НСтр = Объект.ПрогрессивнаяШкалаСНП.Добавить();
		ЗаполнитьЗначенияСвойств(НСтр, Элемент[Сч]);
		//НСтр.
		
	КонецЦикла;
	
КонецПроцедуры


