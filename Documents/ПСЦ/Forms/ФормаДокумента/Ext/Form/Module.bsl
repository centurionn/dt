		|	ДанныеРуководителяКонтрагентов.Руководитель КАК Ссылка
		|ИЗ
		|	РегистрСведений.ДанныеРуководителяКонтрагентов КАК ДанныеРуководителяКонтрагентов
		|ГДЕ
		|	ДанныеРуководителяКонтрагентов.Контрагент = &СсылкаНаВыбранногоКонтрагента
		|	И (&НеОтбиратьПоПериоду
		|		ИЛИ (ДанныеРуководителяКонтрагентов.Период <= &ДатаДокумента
		|			И (ДанныеРуководителяКонтрагентов.ОкончаниеДействия = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ КОНЕЦПЕРИОДА(ДанныеРуководителяКонтрагентов.ОкончаниеДействия, ДЕНЬ) >= &ДатаДокумента)))";
	
	Если НЕ ЭтоПоставщик Тогда 
		Запрос.Текст = Запрос.Текст +
		"
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|    ДанныеПодписантовКонтрагентов.Подписант КАК Ссылка
		|ИЗ
		|    РегистрСведений.ДанныеПодписантовКонтрагентов КАК ДанныеПодписантовКонтрагентов
		|ГДЕ
		|   ДанныеПодписантовКонтрагентов.Контрагент = &СсылкаНаВыбранногоКонтрагента
		|	И (&НеОтбиратьПоПериоду
		|		ИЛИ (ДанныеПодписантовКонтрагентов.Период <= &ДатаДокумента
		|			И (ДанныеПодписантовКонтрагентов.ОкончаниеДействия = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ КОНЕЦПЕРИОДА(ДанныеПодписантовКонтрагентов.ОкончаниеДействия, ДЕНЬ) >= &ДатаДокумента)))";
	КонецЕсли;
	
    Запрос.УстановитьПараметр("СсылкаНаВыбранногоКонтрагента", СсылкаНаВыбранногоКонтрагента);
    Запрос.УстановитьПараметр("ДатаДокумента", ДатаДокумента);
    Запрос.УстановитьПараметр("НеОтбиратьПоПериоду", НЕ ЗначениеЗаполнено(ДатаДокумента));
    
    РезультатЗапроса = Запрос.Выполнить();    
    
    Выборка = РезультатЗапроса.Выбрать();
    Пока Выборка.Следующий() Цикл
        МассивРуководителейИПодписантов.Добавить(Выборка.Ссылка);
    КонецЦикла;
    Возврат МассивРуководителейИПодписантов; 
	
КонецФункции
