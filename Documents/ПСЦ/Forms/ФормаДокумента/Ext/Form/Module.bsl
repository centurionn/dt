&НаКлиенте
Процедура ОтозватьСогласование(Команда)

	СтруктураРезультата = НайтиГотовыеКВыставлениюСтрокиВСделкахПоДанномуПСЦНаСервере(Объект.Ссылка);
	Если СтруктураРезультата.МассивСделокВыставленныеДокументы.Количество() > 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По данному протоколу существуют сделки с сформированными документами.
														|"+СтрСоединить(СтруктураРезультата.МассивСделокВыставленныеДокументы,Символы.ПС)+"
														|Отмена согласования невозможна.");
		Возврат;
	КонецЕсли;
	ОпОп = Новый ОписаниеОповещения("ОтменаСогласования", ЭтаФорма, СтруктураРезультата);
	Если СтруктураРезультата.МассивСделокГотовоКВыставлению.Количество() > 0 Тогда
		ПоказатьВопрос(ОпОп, "Протокол будет возвращен на этап ввода, а информация о результатах согласования стерта.
							|Есть строки в сделках, которые готовы к выставлению:
							|"+СтрСоединить(СтруктураРезультата.МассивСделокГотовоКВыставлению,Символы.ПС)+"
							|Признак будет снят автоматически.
							|Продолжить?", РежимДиалогаВопрос.ДаНет);
	Иначе
		ПоказатьВопрос(ОпОп, "Протокол будет возвращен на этап ввода, а информация о результатах согласования стерта. Продолжить?", РежимДиалогаВопрос.ДаНет);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменаСогласования(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;  
	
	//ДИТ Авдеева В.С. 51492 17.08.2022 Начало
	ПараметрыЗапроса = ПолучитьПараметрыМаршрутизацииНаСервере(Объект);
	РезультатЗапроса = МаршрутизацияСервер.МаршрутизироватьПСЦ(ПараметрыЗапроса, объект.Дата); 
	
	Для Каждого Стр Из РезультатЗапроса Цикл  
		Если Не ЗначениеЗаполнено(Стр.Исполнитель) Тогда
			Продолжить;
		КонецЕсли;
		Отбор = Новый Структура("Состояние", Стр.Состояние);
		НайденныеСтроки = Объект.Состояния.НайтиСтроки(Отбор);
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл 
			НайденнаяСтрока.Исполнитель = Стр.Исполнитель;
		КонецЦикла;
	КонецЦикла;
	//ДИТ Авдеева В.С. 51492 17.08.2022 Конец
	
	//Евросиб Каблов 02.03.2022 ( Ticket#0303065
	ВозвращаемыеЗадачи = Новый Массив;
	Если Объект.Состояния.Количество() > 0 Тогда
		СтрСостояния = Объект.Состояния[0];
		СтрСостояния.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.ВРаботе");
		СтрСостояния.ВыполнениеЗафиксировано = Ложь;
		ВозвращаемыеЗадачи.Добавить(СтрСостояния.Состояние);
	КонецЕсли;
	//Евросиб Каблов 02.03.2022 )
	
	Для Сч = 1 По Объект.Состояния.Количество()-1 Цикл
		
		Объект.Состояния[Сч].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Новый");
		Если ЗначениеЗаполнено(Объект.Состояния[Сч].СтатусСогласования) Тогда Объект.Состояния[Сч].СтатусСогласования = ПредопределенноеЗначение("Перечисление.СтатусыСогласования.Планируется"); КонецЕсли;
		//Евросиб Каблов 02.03.2022 ( Ticket#0303065
		//Если Объект.Состояния.Количество() > 0 Тогда Объект.Состояния[0].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.ВРаботе"); КонецЕсли;
		Объект.Состояния[Сч].ВыполнениеЗафиксировано = Ложь;
		ВозвращаемыеЗадачи.Добавить(Объект.Состояния[Сч].Состояние);
		//Евросиб Каблов 02.03.2022 )
	
	КонецЦикла;
	//(Евросиб Максимова 31.03.2021 #0225197
	Объект.ДатаСогласования=Дата(1,1,1);
	Объект.МаксимальнаяДатаПодписанияСДвухСторон=Дата(1,1,1);
	//)Евросиб Максимова 31.03.2021 #0225197

//Евросиб Гудкова( 15.04.2021 Ticket№ 0229065
	Объект.ПодписанСДвухСторон = Ложь;
// Евросиб Гудкова) 	
	
