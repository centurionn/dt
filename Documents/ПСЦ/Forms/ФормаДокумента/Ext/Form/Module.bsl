&НаСервереБезКонтекста
Функция ПолучитьТипыЛокацийБезСтока()
	
	ТипыЛокацийКромеСтока = Новый СписокЗначений;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТипыЛокаций.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ТипыЛокаций КАК ТипыЛокаций";

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если НЕ ВыборкаДетальныеЗаписи.Ссылка = Справочники.ТипыЛокаций.Сток Тогда
			ТипыЛокацийКромеСтока.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
		КонецЕсли;
	КонецЦикла;

	Возврат ТипыЛокацийКромеСтока;
		
КонецФункции

