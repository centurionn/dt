		обСделка.ДополнительныеСвойства.Вставить("ОтключениеГотовоКВыставлениюИзПСЦ", Истина);
		обСделка.Записать(РежимЗаписиДокумента.Проведение);
		//Евросиб(ДИТ), Беляев СЮ, US 114953 / TA 114960, 22-07-2025, конец
	КонецЦикла;
	АдресТаблицыСделокДляОбработки = Неопределено;               
