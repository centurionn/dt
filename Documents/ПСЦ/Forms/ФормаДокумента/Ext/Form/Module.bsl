&НаКлиенте
Процедура КалькуляцииПриИзменении(Элемент)
	
	ТекД = Элементы.Калькуляции.ТекущиеДанные;
	Если Текд = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	//Евросиб Коханенко Н.А. 25.07.2023 (( #72829 
	ВыборНевозможен = ПроверитьНаВозможностьИспользованияКалькуляцииПоРезультатамСогласования(Объект.Ссылка, ТекД.Калькуляция);
	Если ВыборНевозможен Тогда
		ТекД.Калькуляция = Неопределено;
		Возврат;
	КонецЕсли;
	//Евросиб Коханенко Н.А. 25.07.2023 )) #72829 
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Калькуляция",ТекД.Калькуляция);
	НайденныеСтр = Объект.КалькуляцииПовагонки.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтр.Количество() = 0 Тогда
		НовСтр = Объект.КалькуляцииПовагонки.Добавить();
		НовСтр.Калькуляция = ТекД.Калькуляция;
		СтруктураДанныхКалькуляции = ПолучитьДанныеКалькуляции(ТекД.Калькуляция);
		НовСтр.СтанцияОтправления = СтруктураДанныхКалькуляции.СтОтпр;
		НовСтр.СтанцияНазначения = СтруктураДанныхКалькуляции.СтНазн;
		НовСтр.СтавкаЗаРейс = СтруктураДанныхКалькуляции.Ставка;
		//Евросиб Шевченко А.В. US 99262 TA 121126 09.10.2025
		//НовСтр.Вознаграждение = СтруктураДанныхКалькуляции.Вознагр;
		//ДатаНачалаНовогоРасчетаВознаграждения = ПолучитьДатуНачалаНовогоРасчетаВознаграждения();
		//Если СтруктураДанныхКалькуляции.Дата > ДатаНачалаНовогоРасчетаВознаграждения Тогда
			НовСтр.Вознаграждение = ?(СтруктураДанныхКалькуляции.РасчетнаяКонтрибуция = неопределено,0,СтруктураДанныхКалькуляции.РасчетнаяКонтрибуция);
		//Иначе
		//	НовСтр.Вознаграждение = СтруктураДанныхКалькуляции.Вознагр;
		//КонецЕсли;
		//Евросиб Шевченко А.В. US 99262 TA 121126 09.10.2025
	КонецЕсли;
	
	//Евросиб Каблов 13.03.2023 ( Ticket#0265045
	Если Объект.Калькуляции.Количество() > 0 И ЗначениеЗаполнено(Объект.Калькуляции[0].Калькуляция) Тогда
		ПерваяКалькуляция = Объект.Калькуляции[0].Калькуляция;
		Объект.ВидПеревозки = ОбщегоНазначенияВызовСервера.ЗначениеРеквизитаОбъекта(ПерваяКалькуляция, "ПС_ВидПеревозки");
	КонецЕсли;
	//Евросиб Каблов 13.03.2023 ) 
	
КонецПроцедуры

