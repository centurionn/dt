&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаписатьДанныеПоСпискамЗначений("ПСЦПоставщика_контейнерыВРП","ПСЦПоставщика_НомераКТК_ВРП",ТекущийОбъект);
	ЗаписатьДанныеПоСпискамЗначений("ПСЦПоставщика_контейнерыЭкспорт","ПСЦПоставщика_НомераКТК_Экспорт",ТекущийОбъект);
	
	РаспознатьСодержимоеТаблицПСЦПоставщиков();
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ДопСвойстваОбъекта", ДопСвойстваОбъекта);
//Евросиб Гудкова( 29.07.2020 Ticket№ 0201452
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ОбновитьТарифы", ОбновитьТарифы);
// Евросиб Гудкова)

	//Евросиб Каблов 27.04.2021 (
	ИзмененыТолькоРазрешенныеПоля = Неопределено;
	Если ПараметрыЗаписи.Свойство("ИзмененыТолькоРазрешенныеПоля", ИзмененыТолькоРазрешенныеПоля) Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ИзмененыТолькоРазрешенныеПоля", ИзмененыТолькоРазрешенныеПоля);
	КонецЕсли;
	//Евросиб Каблов 27.04.2021 )
	
	//Евросиб Каблов 02.03.2022 ( Ticket#0303065
	ВозвращаемыеЗадачи = Неопределено;
	Если ПараметрыЗаписи.Свойство("ВозвращаемыеЗадачи", ВозвращаемыеЗадачи) Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ВозвращаемыеЗадачи", ВозвращаемыеЗадачи);
	КонецЕсли;
	//Евросиб Каблов 02.03.2022 )
	
	//Если Параметры.СохранитьДанныеСостояний Тогда
	//	ТЗ = Объект.Состояния.Выгрузить();
	//	ТекущийОбъект.ДополнительныеСвойства.Вставить("Состояния", ТЗ);
	//	Параметры.СохранитьДанныеСостояний = Ложь;
	//КонецЕсли;
	
	//Евросиб Коханенко Н.А. 03.10.2024 (( #90263
	Если ТекущийОбъект.Нотис 
		И НЕ ЗначениеЗаполнено(ТекущийОбъект.НомерПСЦ) 
		И (ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение ИЛИ ТекущийОбъект.Проведен) Тогда
		ТекущийОбъект.НомерПСЦ = ПолучитьНовыйНомерПСЦ(ТекущийОбъект.НаправлениеНотиса, ТекущийОбъект.Создано, ТекущийОбъект.НачалоДействия, НЕ ЗначениеЗаполнено(ТекущийОбъект.Ссылка));
	КонецЕсли;
	//Евросиб Коханенко Н.А. 03.10.2024 )) #90263 
	
	//Евросиб(ДИТ) Серебреников А.Г. US 107184 ТА 107186 19.05.25 Начало
	ПроверитьОбязательностьЗаполненияТранзитаКлиента(Отказ, ТекущийОбъект);
	//Евросиб(ДИТ)) Серебреников А.Г. US 107184 ТА 107186 19.05.25 Конец
	
	//ДИТ Шевченко А.В. 17.01.2024 US 91366 TA 93137 -начало
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ТранзитДляКлиента", ТранзитДляКлиента);
	//ДИТ Шевченко А.В. 17.01.2024 US 91366 TA 93137 -конец
	
КонецПроцедуры

&НаКлиенте
Процедура СопоставлениеНоменклатуры(Команда)
	
	ОткрытьФорму("Обработка.СопоставлениеНоменклатурыПоставщиков.Форма");
	
КонецПроцедуры

&НаКлиенте
Процедура ПовторитьРаспознавание(Команда)
	
	РаспознатьСодержимоеТаблицПСЦПоставщиков();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоконтейнернуюКалькуляцию(Команда)
	
	ЗаполнитьКалькуляциюНаСервере("Контейнеры");
	
КонецПроцедуры

