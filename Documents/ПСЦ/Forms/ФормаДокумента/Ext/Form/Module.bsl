&НаКлиенте
Процедура ЗаполнятьПоПервойСтроке(Команда)
	
	ЗаполнятьПоПервойСтроке = НЕ ЗаполнятьПоПервойСтроке;
	Элементы.ПСЦПоставщика_ТЭОЗаполнятьПоПервойСтроке.ЦветФона = ?(ЗаполнятьПоПервойСтроке, ЦветКнопки_Выделенный, ЦветКнопки_Исходный);
	Элементы.ТЧ1ЗаполнятьПоПервойСтроке.ЦветФона = ?(ЗаполнятьПоПервойСтроке, ЦветКнопки_Выделенный, ЦветКнопки_Исходный);
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПСЦПоставщика_ТЭОПриИзменении(Элемент)
	
	ТекД = Элементы.ПСЦПоставщика_ТЭО.ТекущиеДанные;
	
	Если ЗаполнятьПоПервойСтроке Тогда
		ИмяТЧ = Элемент.Имя;
		ИмяПоля = Сред(Элемент.ТекущийЭлемент.Имя, СтрДлина(ИмяТЧ)+1);
		
		Для Сч = 1 По Объект[ИмяТЧ].Количество() - 1 Цикл
			Объект[ИмяТЧ][Сч][ИмяПоля] = Объект[ИмяТЧ][0][ИмяПоля];
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнитьПовагонку(Команда)
	
	Объект.КалькуляцииПовагонки.Очистить();
	Для каждого ТекД из Объект.Калькуляции Цикл
		
		НовСтр = Объект.КалькуляцииПовагонки.Добавить();
		НовСтр.Калькуляция = ТекД.Калькуляция;
		СтруктураДанныхКалькуляции = ПолучитьДанныеКалькуляции(ТекД.Калькуляция);
		ЗаполнитьЗначенияСвойств(НовСтр, СтруктураДанныхКалькуляции);
		НовСтр.СтанцияОтправления = СтруктураДанныхКалькуляции.СтОтпр;
		НовСтр.СтанцияНазначения = СтруктураДанныхКалькуляции.СтНазн;
		НовСтр.СтавкаЗаРейс = СтруктураДанныхКалькуляции.Ставка;
