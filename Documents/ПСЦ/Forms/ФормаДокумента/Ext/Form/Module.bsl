&НаКлиенте
Процедура ВыдатьНомерПСЦ(Команда)

	//Евросиб Коханенко Н.А. 14.08.2023 (( #73729 
	//Если ЗначениеЗаполнено(Объект.НомерПСЦ) ИЛИ НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
	//	Сообщить("Перед выдачей нового номера ПСЦ, предыдущий нужно очистить и записать!");
	//	Возврат;
	//КонецЕсли;  
	Если ЗначениеЗаполнено(Объект.НомерПСЦ) Тогда
		Сообщить("Перед выдачей нового номера ПСЦ, предыдущий нужно очистить и записать!");
		Возврат;
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		//новый ПСЦ, поле с номером 
		Сообщить("Перед выдачей номера ПСЦ необходимо записать документ!");
		Возврат;
	КонецЕсли;  
	//Евросиб Коханенко Н.А. 14.08.2023 )) #73729 
	
	Отказ = Ложь;  
	
	//Евросиб Коханенко Н.А. 03.10.2024 (( #90263 
	Если Объект.Нотис Тогда
		Если НЕ ЗначениеЗаполнено(Объект.НаправлениеНотиса) Тогда Сообщить("Выберите направление нотиса!"); Отказ = Истина; КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.НачалоДействия) Тогда Сообщить("Укажите начало действия!"); Отказ = Истина; КонецЕсли;
		Если Отказ = Истина Тогда Возврат; КонецЕсли;
		ОчереднойНомер = ПолучитьНовыйНомерПСЦ(Объект.НаправлениеНотиса, Объект.Создано, Объект.НачалоДействия);
	Иначе
	//Евросиб Коханенко Н.А. 03.10.2024 )) #90263 
		Если НЕ ЗначениеЗаполнено(Объект.ДатаПСЦ) Тогда Сообщить("Укажите дату ПСЦ!"); Отказ = Истина; КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.Договор) Тогда Сообщить("Укажите договор с номером!"); Отказ = Истина; КонецЕсли;
		Если Отказ = Истина Тогда Возврат; КонецЕсли;
		ОчереднойНомер = ПолучитьОчереднойНомерПСЦ(Объект.Договор, Объект.ДатаПСЦ);
	КонецЕсли;
	
	Объект.НомерПСЦ = ОчереднойНомер;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьОчереднойНомерПСЦ(Договор, ДатаПСЦ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(ПСЦ.Ссылка) КАК Ссылка
	               |ИЗ
	               |	Документ.ПСЦ КАК ПСЦ
	               |ГДЕ
	               |	ПСЦ.Договор = &Договор
	               |	И ПСЦ.ДатаПСЦ МЕЖДУ &НачалоМесяца И &КонецМесяца";
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца(ДатаПСЦ));
	Запрос.УстановитьПараметр("КонецМесяца", КонецМесяца(ДатаПСЦ));
	Ответ = Запрос.Выполнить().Выбрать();
	НомерПорядковый = 0;
	Если Ответ.Следующий() Тогда 
		НомерПорядковый = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Формат(ДатаПСЦ, "ДФ=ггггММ")+Договор.Номер+Формат(Ответ.Ссылка, "ЧЦ=3; ЧН=000; ЧВН=");
	
КонецФункции


