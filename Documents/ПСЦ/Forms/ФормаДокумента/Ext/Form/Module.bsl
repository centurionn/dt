&НаСервере
Функция ПолучитьТипВагона(ИмяТипаВагона) 
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТипоразмерыТС.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ТипоразмерыТС КАК ТипоразмерыТС
	               |ГДЕ
	               |	(ТипоразмерыТС.Наименование ПОДОБНО &Наименование
	               |			ИЛИ ТипоразмерыТС.ТипВагонаИзСлежения = &Наименование)";
	Запрос.УстановитьПараметр("Наименование", ИмяТипаВагона);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

