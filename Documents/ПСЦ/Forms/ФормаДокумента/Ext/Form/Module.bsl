&НаКлиенте
Процедура ПеренестиПараметрыСНПвПунктыПСЦ(ТекД)
	//Евросиб Шевченко А.В. 12.05.2025 US 94035 TA 104217
	СтруктураСНП = Новый Структура();
	СтруктураСНП.Вставить("СобытиеНачалаРасчетаПользования", ТекД.СобытиеНачалаРасчетаПользования);
	СтруктураСНП.Вставить("СобытиеОкончанияРасчетаПользования", ТекД.СобытиеОкончанияРасчетаПользования);
	СтруктураСНП.Вставить("ЛокацияСобытияНачала", ТекД.ЛокацияСобытияНачала);
	СтруктураСНП.Вставить("ЛокацияСобытияОкончания", ТекД.ЛокацияСобытияОкончания);
	СтруктураСНП.Вставить("ЕдиницаИзмеренияРасчетаСНП", ТекД.ЕдиницаИзмеренияРасчетаСНП);
	СтруктураСНП.Вставить("СтавкаПрогрессивная", ТекД.СтавкаПрогрессивная);
	СтруктураСНП.Вставить("Валюта", ТекД.Валюта);
	СтруктураСНП.Вставить("Ставка", ТекД.Ставка);
	СтруктураСНП.Вставить("ТипКТК", ТекД.ТипКТК);
	СтруктураСНП.Вставить("НормативныйСрок", ТекД.НормативныйСрок);
	СтруктураСНП.Вставить("ВариантОпределенияДатыКурсаВалют", ТекД.ВариантОпределенияДатыКурсаВалют);
	СтруктураСНП.Вставить("СтавкаНДС", ТекД.СтавкаНДС);
	СтруктураСНП.Вставить("СтавкаВключаетНДС", ТекД.СтавкаВключаетНДС);
	СтруктураСНП.Вставить("ГУИДСтроки", ТекД.ГУИДСтроки);
	
	ТекстПункта = ПолучитьТекстПункта(СтруктураСНП);
