	Возврат Константы.ДатаНачалаРасчетаВознагражденияПоНовойФормулеВКалькуляциях.Получить();
КонецФункции	

&НаСервереБезКонтекста
Функция ПолучитьДанныеКалькуляции(ТекКалькуляция)
	
	СтруктураОтвета = Новый СТруктура;
	СтруктураОтвета.Вставить("СтОтпр",ТекКалькуляция.Суша_ПунктОтправления);
	СтруктураОтвета.Вставить("СтНазн",ТекКалькуляция.Суша_ПунктНазначения);
	СтруктураОтвета.Вставить("Вознагр",ТекКалькуляция.ММ_ИтогоВознаграждение);
	//Евросиб Шевченко А.В. US 99262 TA 121126 09.10.2025
	СтруктураОтвета.Вставить("Дата",ТекКалькуляция.Дата);
	СтруктураОтвета.Вставить("РасчетнаяКонтрибуция",РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ПолучитьРасчетнуюКонтрибуцию40ПоДокументу(ТекКалькуляция));
	//Евросиб Шевченко А.В. US 99262 TA 121126 09.10.2025
	СтруктураОтвета.Вставить("Ставка",ТекКалькуляция.ММ_ИтогоСтавка);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КалькуляцияММ_КалькуляцияЖДСоставляющей.Операция КАК Операция,
	|	КалькуляцияММ_КалькуляцияЖДСоставляющей.Операция.Наименование КАК ОперацияНаименование,
	|	КалькуляцияММ_КалькуляцияЖДСоставляющей.ДлительностьДней КАК ДлительностьДней
	|ИЗ
	|	Документ.Калькуляция.ММ_КалькуляцияЖДСоставляющей КАК КалькуляцияММ_КалькуляцияЖДСоставляющей
	|ГДЕ
	|	КалькуляцияММ_КалькуляцияЖДСоставляющей.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ТекКалькуляция);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ОперацияНаименование = "Движение груженый - обязательно для заполнения" Тогда
			СтруктураОтвета.Вставить("НормативСледованияДни", Выборка.ДлительностьДней);
		ИначеЕсли Выборка.ОперацияНаименование = "Погрузка - обязательно для заполнения" Тогда
			СтруктураОтвета.Вставить("СНППогрузкиДни", Выборка.ДлительностьДней);
		ИначеЕсли Выборка.ОперацияНаименование = "Выгрузка - обязательно для заполнения" Тогда
			СтруктураОтвета.Вставить("СНПВыгрузкиДни", Выборка.ДлительностьДней);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтруктураОтвета;
	
КонецФункции

