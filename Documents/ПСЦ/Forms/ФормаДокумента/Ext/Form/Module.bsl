&НаСервере
Процедура ПолучитьДанныеПоСпискамЗначений(ИмяТбл, ИмяТблКТК)
	
	Для ШагЦикла = 0 По Объект.Ссылка[ИмяТбл].Количество()-1 Цикл
		СтрокаВБД = Объект.Ссылка[ИмяТбл][ШагЦикла];
		СтрокаФормы = Объект[ИмяТбл][ШагЦикла];
		СтрокаФормы.ГородВозвратаСписок = ?(ЗначениеЗаполнено(СтрокаВБД.ГородВозврата1),СтрокаВБД.ГородВозврата1.Получить(),Новый СписокЗначений);
		СтрокаФормы.СозданныйТарифСписок = ?(ЗначениеЗаполнено(СтрокаВБД.СозданныйТариф),СтрокаВБД.СозданныйТариф.Получить(),Новый СписокЗначений);
		
		
		ХранЗнач = СтрокаВБД.СтоимостьСНПХранилище.Получить();
		// если в хранилище есть значения, то загружаем их.
		// если значений нет, то записываем в реквизит формы СтоимостьСНППредставление значение из СтоимостьСНП1
		Если НЕ ХранЗнач = Неопределено И ХранЗнач.Количество()>0 Тогда
			СтрокаФормы.СтоимостьСНПТаблица.Очистить();
			Для Каждого Элем Из ХранЗнач Цикл
				НовСтр = СтрокаФормы.СтоимостьСНПТаблица.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр,Элем);
			КонецЦикла;
			СтрокаФормы.СтоимостьСНППредставление = "Прогр.шкала";
		Иначе
			СтрокаФормы.СтоимостьСНППредставление = СтрокаВБД.СтоимостьСНП1;
		КонецЕсли;
		
		// получаем список контейнеров по ГУИД для каждой строки
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ГУИДСтроки",СтрокаВБД.ГУИДСтроки);
		НайденныеСтроки = Объект.Ссылка[ИмяТблКТК].НайтиСтроки(ПараметрыОтбора);
		СписокКТКПоГУИД = Новый СписокЗначений;
		Для Каждого Стр Из НайденныеСтроки Цикл
			СписокКТКПоГУИД.Добавить(Стр.НомерКонтейнера);
		КонецЦикла;
		
		СтрокаФормы.СписокКТК = СписокКТКПоГУИД;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДанныеПоСпискамЗначений(ИмяТбл, ИмяТблКТК,ТекущийОбъект)
	
	// очищаем таблицу с контейнерами
	ТекущийОбъект[ИмяТблКТК].Очистить();
	
	Для ШагЦикла = 0 По Объект[ИмяТбл].Количество()-1 Цикл
		СтрокаВБД = ТекущийОбъект[ИмяТбл][ШагЦикла];
		СТрокаФормы = Объект[ИмяТбл][ШагЦикла];
		СтрокаВБД.ГородВозврата1 = Новый ХранилищеЗначения(СТрокаФормы.ГородВозвратаСписок);
		СтрокаВБД.СозданныйТариф = Новый ХранилищеЗначения(СТрокаФормы.СозданныйТарифСписок);
		СтрокаВБД.СтоимостьСНПХранилище = Новый ХранилищеЗначения(ОбщегоНазначения.ТаблицаЗначенийВМассив(СТрокаФормы.СтоимостьСНПТаблица.Выгрузить()));
		СтрокаВБД.СтоимостьСНП1 = ?(ТипЗнч(СТрокаФормы.СтоимостьСНППредставление) = Тип("Число"),СТрокаФормы.СтоимостьСНППредставление,0);
		
		Для Каждого Элем Из СТрокаФормы.СписокКТК Цикл
			НовСтр = ТекущийОбъект[ИмяТблКТК].Добавить();
			НовСтр.НомерКонтейнера = Элем.Значение;
			НовСтр.ГУИДСтроки = СТрокаФормы.ГУИДСтроки;
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

