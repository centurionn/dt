&НаКлиенте
Процедура СверхнормативноеПользованиеСтавкаПрогрессивнаяПриИзменении(Элемент)
	
	//Евросиб Каблов 13.03.2023 ( Ticket#0265045
	ТекДанные = Элементы.СверхнормативноеПользование.ТекущиеДанные;
	Если ТекДанные.СтавкаПрогрессивная Тогда
		
		УстановитьТекстСтавки(ТекДанные);
		
	Иначе
		
		СтрокиШкалы = Объект.ПрогрессивнаяШкалаСНП.НайтиСтроки(Новый Структура("ГУИДСтроки", ТекДанные.ГУИДСтроки));
		КоличествоСтрок = СтрокиШкалы.Количество();
		Если КоличествоСтрок > 0 Тогда
			
			ПерваяСтрока = СтрокиШкалы[0];
			ПерваяСтрока.От = 0;
			ПерваяСтрока.До = 0;
			
			ТекДанные.Ставка = ПерваяСтрока.Стоимость;
			
			Для Инд = 1 По КоличествоСтрок - 1 Цикл
				Объект.ПрогрессивнаяШкалаСНП.Удалить(СтрокиШкалы[Инд]);
			КонецЦикла;
			
		Иначе
			
			НСтр = Объект.ПрогрессивнаяШкалаСНП.Добавить();
			НСтр.ГУИДСтроки = ТекДанные.ГУИДСтроки;
			НСтр.От = 0;
			НСтр.До = 0;
			Попытка
				НСтр.Стоимость = ТекДанные.Ставка;
			Исключение
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	//Евросиб Каблов 13.03.2023 )
	
КонецПроцедуры

