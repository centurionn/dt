		|	И ПСЦ.НаправлениеНотиса = &НаправлениеНотиса
		|	И НАЧАЛОПЕРИОДА(ПСЦ.Создано, ГОД) = &НачалоГода";
	
	Запрос.УстановитьПараметр("НаправлениеНотиса", НаправлениеНотиса);
	Запрос.УстановитьПараметр("НачалоГода", НачалоГода(ДатаСоздания));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	КоличествоВБазе = Выборка.КоличествоПСЦ;
	Если КоличествоВБазе = 0 Тогда
		ПорядковыйНомер = 1;
