	Если ТипЗнч(Тариф) = Тип("СправочникСсылка.ТарифыПоставщиков") Тогда
		
		ТОбъект = Тариф.ПолучитьОбъект();
		ТОбъект.ПометкаУдаления = Истина;
		ТОбъект.Записать();
		
	КонецЕсли;
	
