	Если Параметр1 = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Для Каждого ПараметрыСНП Из Параметр1 Цикл
		ОбработатьВводТекстаПараметрыСНП(ПараметрыСНП.Строка, ПараметрыСНП);
	КонецЦикла;
	
КонецПроцедуры


&НаСервере
Функция ПодготовитьТаблицуДляВыбораПунктовПСЦ()
	
	ТаблицаДляФормы = Новый ТаблицаЗначений;
	ТаблицаДляФормы.Колонки.Добавить("Пометка");
	ТаблицаДляФормы.Колонки.Добавить("Текст");
	ТаблицаДляФормы.Колонки.Добавить("ИдентификаторСтроки");
	ТаблицаДляФормы.Колонки.Добавить("ГУИДСтроки");
	
	Для каждого СтрокаС Из Объект.СверхнормативноеПользование Цикл
		
		СтруктураСНП = Новый Структура();
		СтруктураСНП.Вставить("СобытиеНачалаРасчетаПользования", СтрокаС.СобытиеНачалаРасчетаПользования);
		СтруктураСНП.Вставить("СобытиеОкончанияРасчетаПользования", СтрокаС.СобытиеОкончанияРасчетаПользования);
		СтруктураСНП.Вставить("ЛокацияСобытияНачала", СтрокаС.ЛокацияСобытияНачала);
		СтруктураСНП.Вставить("ЛокацияСобытияОкончания", СтрокаС.ЛокацияСобытияОкончания);
		СтруктураСНП.Вставить("ЕдиницаИзмеренияРасчетаСНП", СтрокаС.ЕдиницаИзмеренияРасчетаСНП);
		СтруктураСНП.Вставить("СтавкаПрогрессивная", СтрокаС.СтавкаПрогрессивная);
		СтруктураСНП.Вставить("Валюта", СтрокаС.Валюта);
		СтруктураСНП.Вставить("Ставка", СтрокаС.Ставка);
		СтруктураСНП.Вставить("ТипКТК", СтрокаС.ТипКТК);
		СтруктураСНП.Вставить("НормативныйСрок", СтрокаС.НормативныйСрок);
		СтруктураСНП.Вставить("ВариантОпределенияДатыКурсаВалют", СтрокаС.ВариантОпределенияДатыКурсаВалют);
		СтруктураСНП.Вставить("СтавкаНДС", СтрокаС.СтавкаНДС);
		СтруктураСНП.Вставить("СтавкаВключаетНДС", СтрокаС.СтавкаВключаетНДС);
		СтруктураСНП.Вставить("ГУИДСтроки", СтрокаС.ГУИДСтроки);
		
		ТекстПункта = ПолучитьТекстПункта(СтруктураСНП);
		НовСтрока = ТаблицаДляФормы.Добавить();
		НовСтрока.Пометка = Истина;
		НовСтрока.Текст = ТекстПункта;
		НовСтрока.ИдентификаторСтроки = СтрокаС.ПолучитьИдентификатор();
		НовСтрока.ГУИДСтроки = СтрокаС.ГУИДСтроки;
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаДляФормы,ЭтаФорма.УникальныйИдентификатор);
	
КонецФункции	

&НаКлиенте
Процедура УдалитьПунктыПСЦ(ЗаполнениеИзСправочника = Ложь)
	Если ЗаполнениеИзСправочника Тогда
		ИдентификаторыСтрок = Новый Массив;
		Для Каждого СтрокаС Из Объект.СверхнормативноеПользование Цикл
			ИдентификаторыСтрок.Добавить(СтрокаС.ПолучитьИдентификатор());			
		КонецЦикла;	
	Иначе
		ИдентификаторыСтрок = Элементы.СверхнормативноеПользование.ВыделенныеСтроки;
	КонецЕсли;	
	
	Для Каждого ИдентификаторСтроки Из ИдентификаторыСтрок Цикл
		СтрокаСНП = Объект.СверхнормативноеПользование.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если СтрокаСНП <> Неопределено Тогда
			НайденныеПунктыПСЦ = Объект.ПунктыПСЦ.НайтиСтроки(Новый Структура("ИсточникСтроки, ИдентификаторСтрокиИсточника", "СверхнормативноеПользование", СтрокаСНП.ГУИДСтроки));
			Для Каждого ПунктПСЦ Из НайденныеПунктыПСЦ Цикл
				Объект.ПунктыПСЦ.Удалить(ПунктПСЦ);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры	

