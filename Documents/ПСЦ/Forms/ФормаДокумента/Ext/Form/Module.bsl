	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	ФайлПротокола = Параметр1[0];
	Объект.ПСЦПоставщика = Истина;
	Объект.ПСЦПоставщика_автодоставка.Очистить();
	Объект.ПСЦПоставщика_вагоны.Очистить();
	Объект.ПСЦПоставщика_контейнерыВРП.Очистить();
	Объект.ПСЦПоставщика_контейнерыЭкспорт.Очистить();
	
	ДД = Новый ДвоичныеДанные(Параметр1[0]);
	
	ОтработатьНаСервере(ДД);
	
КонецПроцедуры

&НаСервере
Процедура ОтработатьНаСервере(ДД)
	
	ИВФ = ПолучитьИмяВременногоФайла("xlsx");
	ДД.Записать(ИВФ);
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Прочитать(ИВФ);
	
	Для каждого ЛистИмя из ТабДок.Области Цикл
		
		Если Найти(ЛистИмя.Имя, "вагоны") <> 0 Тогда 
			
			Лист = ТабДок.ПолучитьОбласть(ЛистИмя.Имя);
			
			Сч = 3;
			
			Объект.ПСЦПоставщика_НаименованиеПоставщика = Лист.Область("R1C3").Текст;
			Объект.ПСЦПоставщика_ИНН = Лист.Область("R1C5").Текст;
			Объект.ПСЦПоставщика_КПП = Лист.Область("R1C6").Текст;
			ДатаНД = Лист.Область("R1C8").Текст;
			ДатаКД = Лист.Область("R1C9").Текст;
			
			Объект.ПСЦПоставщика_НачалоДействияСтавок = ?(СтрДлина(ДатаНД) = 10, Дата(""+Прав(ДатаНД, 4)+Сред(ДатаНД,4,2)+Лев(ДатаНД, 2)), ДатаНД);
			Объект.ПСЦПоставщика_КонецДействияСтавок = ?(СтрДлина(ДатаКД) = 10, Дата(""+Прав(ДатаКД, 4)+Сред(ДатаКД,4,2)+Лев(ДатаКД, 2)), ДатаКД);
			
			Услуга 				= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C1").Текст;
			ТипВагона 			= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C2").Текст;
			СтОтправления 		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C3").Текст;
			СтПрибытия 			= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C4").Текст;
			Стоимость 			= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C5").Текст;
			НДС 				= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C6").Текст;
			НормативПогрузки 	= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C7").Текст;
			НормативВыгрузки 	= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C8").Текст;
			СНП 				= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C9").Текст;
			
			Пока ЗначениеЗаполнено(ТипВагона) Цикл
				
				
				НСтр = Объект.ПСЦПоставщика_вагоны.Добавить();
				НСтр.ТипВагона = ТипВагона;
				НСтр.СтанцияОтправления = СтОтправления;
				НСтр.СтанцияНазначения = СтПрибытия;
				НСтр.Ставка = Стоимость;
				НСтр.НДС = НДС;
				НСтр.НормативПогрузки = НормативПогрузки;
				НСтр.НормативВыгрузки = НормативВыгрузки;
				НСтр.СтоимостьСНП = СНП;
				НСтр.НоменклатураПоставщика = Услуга;
				
				Сч = Сч + 1;
				
				Услуга 				= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C1").Текст;
				ТипВагона 			= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C2").Текст;
				СтОтправления 		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C3").Текст;
				СтПрибытия 			= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C4").Текст;
				Стоимость 			= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C5").Текст;
				НДС 				= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C6").Текст;
				НормативПогрузки 	= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C7").Текст;
				НормативВыгрузки 	= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C8").Текст;
				СНП 				= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C9").Текст;
				
			КонецЦикла;
			
		ИначеЕсли Найти(ЛистИмя.Имя, "контейнеры_ВРП") <> 0 Тогда
			
			Лист = ТабДок.ПолучитьОбласть(ЛистИмя.Имя);
			
			Сч = 3;
			
			Услуга 				= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C1").Текст;
			ТипКонтейнера 		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C2").Текст;
			ГородВыдачи 		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C3").Текст;
			ГородВозврата 		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C4").Текст;
			Стоимость 			= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C5").Текст;
			Валюта 				= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C6").Текст;
			НДС 				= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C7").Текст;
			СрокПользования 	= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C8").Текст;
			СНП 				= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C9").Текст;
			
			Пока ЗначениеЗаполнено(ТипКонтейнера) Цикл
				
				
				НСтр = Объект.ПСЦПоставщика_контейнерыВРП.Добавить();
				НСтр.ТипКонтейнера = ТипКонтейнера;
				НСтр.Ставка = Стоимость;
				НСтр.НДС = НДС;
				НСтр.Валюта = Валюта;
				НСтр.НормативПользования = СрокПользования;
				НСтр.СтоимостьСНП = СНП;
				НСтр.ГородВыдачи = ГородВыдачи;
				НСтр.ГородВозврата = ГородВозврата;
				НСтр.НоменклатураПоставщика = Услуга;
				
				Сч = Сч + 1;
				
				Услуга 				= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C1").Текст;
				ТипКонтейнера 		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C2").Текст;
				ГородВыдачи 		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C3").Текст;
				ГородВозврата 		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C4").Текст;
				Стоимость 			= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C5").Текст;
				Валюта 				= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C6").Текст;
				НДС 				= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C7").Текст;
				СрокПользования 	= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C8").Текст;
				СНП 				= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C9").Текст;
				
			КонецЦикла;
			
		ИначеЕсли Найти(ЛистИмя.Имя, "контейнеры_экспорт") <> 0 Тогда
			
			Лист = ТабДок.ПолучитьОбласть(ЛистИмя.Имя);
			
			Сч = 3;
			
			Услуга 				= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C1").Текст;
			ТипКонтейнера 		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C2").Текст;
			ГородВыдачи 		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C4").Текст;
			ГородВозврата 		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C6").Текст;
			Стоимость 			= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C7").Текст;
			НДС 				= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C8").Текст;
			СрокПользования 	= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C9").Текст;
			СНП 				= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C10").Текст;
			СтранаВыдачи	 	= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C3").Текст;
			СтранаВозврата		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C5").Текст;
			
			Пока ЗначениеЗаполнено(ТипКонтейнера) Цикл
				
				
				НСтр 						= Объект.ПСЦПоставщика_контейнерыЭкспорт.Добавить();
				НСтр.ТипКонтейнера 			= ТипКонтейнера;
				НСтр.Ставка 				= Стоимость;
				НСтр.НДС 					= НДС;
				НСтр.НормативПользования 	= СрокПользования;
				НСтр.СтоимостьСНП 			= СНП;
				НСтр.ГородВыдачи 			= ГородВыдачи;
				НСтр.ГородВозврата 			= ГородВозврата;
				НСтр.СтранаВыдачи 			= СтранаВыдачи;
				НСтр.СтранаВозврата 		= СтранаВозврата;
				НСтр.НоменклатураПоставщика = Услуга;
				
				Сч = Сч + 1;
				Услуга 				= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C1").Текст;
				ТипКонтейнера 		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C2").Текст;
				ГородВыдачи 		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C4").Текст;
				ГородВозврата 		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C6").Текст;
				Стоимость 			= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C7").Текст;
				НДС 				= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C8").Текст;
				СрокПользования 	= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C9").Текст;
				СНП 				= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C10").Текст;
				СтранаВыдачи	 	= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C3").Текст;
				СтранаВозврата		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C5").Текст;
				
			КонецЦикла;
			
		ИначеЕсли Найти(ЛистИмя.Имя, "автотранспорт") <> 0 Тогда
			
			Лист = ТабДок.ПолучитьОбласть(ЛистИмя.Имя);
			
			Сч = 3;
			
			Услуга 				= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C1").Текст;
			ТипКонтейнера 		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C2").Текст;
			Постановка 			= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C3").Текст;
			ПунктНачала 		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C4").Текст;
			ПунктОкончания 		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C5").Текст;
			СдачаПорожнего 		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C6").Текст;
			Стоимость 			= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C7").Текст;
			НДС 				= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C8").Текст;
			НормаЗагрузки	 	= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C9").Текст;
			ПревышениеНормы		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C10").Текст;
			НормативВремени		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C11").Текст;
			ПревышениеНорматива	= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C12").Текст;
			
			Пока ЗначениеЗаполнено(ТипКонтейнера) Цикл
				
				// Если заполнена и временная и загрузочная нормы, то создавать 2 строки услуг
				// 1.
				Если ЗначениеЗаполнено(НормаЗагрузки) Тогда
					НСтр 													= Объект.ПСЦПоставщика_автодоставка.Добавить();
					НСтр.НоменклатураПоставщика 							= Услуга;
					НСтр.ТипКонтейнера 										= ТипКонтейнера;
					НСтр.ПостановкаГрПор 									= Постановка;
					НСтр.ПунктНачалаПеревозки 								= ПунктНачала;
					НСтр.ПунктОкончанияПеревозки 							= ПунктОкончания;
					НСтр.СдачаПорожнего 									= СдачаПорожнего;
					НСтр.Стоимость 											= Стоимость;
					НСтр.НДС 												= НДС;
					НСтр.НормаЗагрузки 										= НормаЗагрузки;
					НСтр.СтоимостьПревышенияНормыЗагрузки 					= ПревышениеНормы;
				КонецЕсли;
				// 2.
				Если ЗначениеЗаполнено(НормативВремени) Тогда
					НСтр 													= Объект.ПСЦПоставщика_автодоставка.Добавить();
					НСтр.НоменклатураПоставщика 							= "Сверхнормативная погрузка (временная)";
					НСтр.ТипКонтейнера 										= ТипКонтейнера;
					НСтр.ПостановкаГрПор 									= Постановка;
					НСтр.ПунктНачалаПеревозки 								= ПунктНачала;
					НСтр.ПунктОкончанияПеревозки 							= ПунктОкончания;
					НСтр.СдачаПорожнего 									= СдачаПорожнего;
					НСтр.Стоимость 											= Стоимость;
					НСтр.НДС 												= НДС;
					НСтр.НормаЗагрузки 										= НормаЗагрузки;
					НСтр.СтоимостьПревышенияНормыЗагрузки 					= ПревышениеНормы;
					НСтр.НормативВремениНаПогрузкуВыгрузку 					= НормативВремени;
					НСтр.СтоимостьПревышенияНормыВремениНаПогрузкуВыгрузку 	= ПревышениеНорматива;
				КонецЕсли;
				
				Сч = Сч + 1;
				Услуга 				= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C1").Текст;
				ТипКонтейнера 		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C2").Текст;
				Постановка 			= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C3").Текст;
				ПунктНачала 		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C4").Текст;
				ПунктОкончания 		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C5").Текст;
				СдачаПорожнего 		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C6").Текст;
				Стоимость 			= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C7").Текст;
				НДС 				= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C8").Текст;
				НормаЗагрузки	 	= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C9").Текст;
				ПревышениеНормы		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C10").Текст;
				НормативВремени		= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C11").Текст;
				ПревышениеНорматива	= Лист.Область("R"+Формат(Сч, "ЧГ=")+"C12").Текст;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	РаспознатьСодержимоеТаблицПСЦПоставщиков();
	
КонецПроцедуры

&НаСервере
Процедура РаспознатьСодержимоеТаблицПСЦПоставщиков()
	
	Для каждого Стр из Объект.ПСЦПоставщика_вагоны Цикл
		
		Если ЗначениеЗаполнено(Стр.НоменклатураПоставщика) И НЕ ЗначениеЗаполнено(Стр.НоменклатураПоставщика1) Тогда
			Стр.НоменклатураПоставщика1 = Справочники.НоменклатураПоставщиков.НайтиСоздатьНоменклатуруПоставщика(Стр.НоменклатураПоставщика);
			Стр.Услуга = Стр.НоменклатураПоставщика1.Номенклатура; //Евросиб Гудкова( 06.09.2020 Ticket№ 0202979
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.ТипВагона) И НЕ ЗначениеЗаполнено(Стр.ТипВагона1) Тогда
			Стр.ТипВагона1 = ПолучитьТипВагона(Стр.ТипВагона);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.СтанцияОтправления) И НЕ ЗначениеЗаполнено(Стр.СтанцияОтправления1) Тогда
			Стр.СтанцияОтправления1 = Локации_сервер.ПолучитьЛокациюПоНечеткомуПоиску(Стр.СтанцияОтправления);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.СтанцияНазначения) И НЕ ЗначениеЗаполнено(Стр.СтанцияНазначения1) Тогда
			Стр.СтанцияНазначения1 = Локации_сервер.ПолучитьЛокациюПоНечеткомуПоиску(Стр.СтанцияНазначения);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.Ставка) И НЕ ЗначениеЗаполнено(Стр.Ставка1) Тогда
			Стр.Ставка1 = Число(Стр.Ставка);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.НДС) И НЕ ЗначениеЗаполнено(Стр.НДС1) Тогда
			Стр.НДС1 = ПолучитьНДС(Стр.НДС);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.НормативПогрузки) И НЕ ЗначениеЗаполнено(Стр.НормативПогрузки1) Тогда
			Стр.НормативПогрузки1 = Число(Стр.НормативПогрузки);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.НормативВыгрузки) И НЕ ЗначениеЗаполнено(Стр.НормативВыгрузки1) Тогда
			Стр.НормативВыгрузки1 = Число(Стр.НормативВыгрузки);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.СтоимостьСНП) И НЕ ЗначениеЗаполнено(Стр.СтоимостьСНП1) Тогда
