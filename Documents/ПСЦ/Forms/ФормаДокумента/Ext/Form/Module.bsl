Процедура ОбработкаСНП(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда 
		Возврат 
	КонецЕсли;
	Параметр2.СтоимостьСНПТаблица.Очистить();
	Для Каждого Стр Из Параметр1 Цикл
		НовСтр = Параметр2.СтоимостьСНПТаблица.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,Стр);
	КонецЦикла;
	
	Параметр2.СтоимостьСНППредставление = ?(Параметр2.СтоимостьСНПТаблица.Количество()>0,"Прогр.шкала",0);	
	
