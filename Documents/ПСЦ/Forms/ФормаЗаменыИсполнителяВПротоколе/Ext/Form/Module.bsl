
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаменяемыеСтатусы.Добавить(Перечисления.СтатусыЭтапов.ВРаботе);
	ЗаменяемыеСтатусы.Добавить(Перечисления.СтатусыЭтапов.НаВыполнение);
	ЗаменяемыеСтатусы.Добавить(Перечисления.СтатусыЭтапов.Новый);
	
	ЗаменятьИсполнителя = Истина;
	ЗаменятьНаблюдателя = Истина;
	КонечныйПользователь = Пользователи.ТекущийПользователь();
	Если Параметры.Свойство("ИсходныйПользователь") Тогда
		ИсходныйПользователь = Параметры.ИсходныйПользователь;
	КонецЕсли;
	

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры

