&НаКлиенте
Процедура ОткрытьОкноСИнструкциями(Форма, Команда)
	ИнструкцииКлиент.ОткрытьОкноСИнструкциями(ЭтаФорма, Команда);
КонецПроцедуры  
//Евросиб Коханенко Н.А. #61705 09.12.2022 )


&НаКлиенте
Процедура Заменить(Команда)
	
	Результат = Новый Структура;
	Результат.Вставить("ИсходныйПользователь", ИсходныйПользователь);
	Результат.Вставить("КонечныйПользователь", КонечныйПользователь);
	
	Результат.Вставить("ЗаменятьИсполнителя", ЗаменятьИсполнителя);
	Результат.Вставить("ЗаменятьНаблюдателя", ЗаменятьНаблюдателя);
	
	Результат.Вставить("ЗаменяемыеСтатусы", ЗаменяемыеСтатусы.ВыгрузитьЗначения());
	
	Закрыть(Результат);
	
КонецПроцедуры
