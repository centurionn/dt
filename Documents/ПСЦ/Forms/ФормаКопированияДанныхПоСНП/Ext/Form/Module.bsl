//ДИТ, Беляев СЮ, ТА47544, 09-03-2022, начало
&НаСервере
Функция НайтиВалюту(Знач вхСтрока, вхВалютыСоответствие)
	стрДляОбработки = НРег(вхСтрока);
	Если СтрНайти(нрег(стрДляОбработки),"руб")>0 Тогда
		Возврат Справочники.Валюты.Рубль;
	КонецЕсли;
	Для Каждого Элемент ИЗ вхВалютыСоответствие Цикл
		Если СтрНайти(стрДляОбработки,Элемент.Значение)>0 Тогда
			Возврат Элемент.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат  Справочники.Валюты.ПустаяСсылка();
КонецФункции  
//ДИТ, Беляев СЮ, ТА47544, 09-03-2022, конец

//ДИТ, Беляев СЮ, ТА47544, 09-03-2022, начало
&НаСервере
Функция НайтиЧисловыеЗначения(Знач вхСтрока)
	МассивЧисел	= Новый Массив;
	стрДопустимыхЗнаков = "0123456789.";
	стрЧисло = "";
	Пока СтрДлина(вхСтрока)>0 цикл
		ТекСимвол = Лев(вхСтрока,1);
		Если СтрНайти(стрДопустимыхЗнаков,ТекСимвол)>0 Тогда
			стрЧисло = стрЧисло + ТекСимвол;			
		Иначе
			Если СтрДлина(стрЧисло)>0 Тогда
				МассивЧисел.Добавить(стрЧисло);
				стрЧисло = "";
			КонецЕсли;
		КонецЕсли;				
		вхСтрока = Сред(вхСтрока,2);	
	КонецЦикла;     
	Если СтрДлина(стрЧисло)>0 Тогда
		МассивЧисел.Добавить(стрЧисло);
		стрЧисло = "";
	КонецЕсли;
	Возврат МассивЧисел;
КонецФункции     
//ДИТ, Беляев СЮ, ТА47544, 09-03-2022, конец

