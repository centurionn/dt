
//Евросиб Коханенко Н.А. #61705 09.12.2022 (
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	
	// ДИТ US 64822 Сержантова А.С. Начало: 03.07.2023
	Если Параметры.Свойство("ПСЦПоставщика") Тогда
		ЭтаФорма.ПСЦПоставщика = Параметры.ПСЦПоставщика;
		ЭтаФорма.НуженОтборПоПСЦПоставщика = Истина;
	КонецЕсли; 
	Параметры.Свойство("Контрагент", ЭтаФорма.Контрагент);
	Параметры.Свойство("Договор", ЭтаФорма.ДоговорКонтрагента);
	Параметры.Свойство("ДатаДокумента", ЭтаФорма.ДатаАктуальности); 
	Если Параметры.Свойство("СписокУслуг") Тогда
		ЭтаФорма.СписокУслуг.ЗагрузитьЗначения(Параметры.СписокУслуг);
		ОтборПоУслугам = Истина;
		Элементы.ГруппаОтборУслуг.Видимость = Истина;
	КонецЕсли;
	
	УстановитьОтборПоУслугам();
	УстановитьОтборыДинамическогоСписка();
	// ДИТ US 64822 Сержантова А.С. Конец: 03.07.2023

КонецПроцедуры
