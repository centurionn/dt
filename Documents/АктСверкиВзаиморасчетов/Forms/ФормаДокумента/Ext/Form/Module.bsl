&НаСервере
Процедура ЗаполнитьСуммуНаНачало()
	Запрос = Новый Запрос;
	Если ЗначениеЗаполнено(Объект.ДоговорКонтрагента) Тогда
		ДопУсловие = " и Договор = &Договор ";
		Запрос.УстановитьПараметр("Договор", Объект.ДоговорКонтрагента);
	Иначе
		ДопУсловие = "";
	КонецЕсли;

	Если Объект.Контрагент.ТипКонтрагента_Клиент Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	ВзаиморасчетыСПокупателямиОстатки.СуммаСНДСОстаток КАК СуммаСНДСОстаток
		               |ИЗ
		               |	РегистрНакопления.ВзаиморасчетыСПокупателями.Остатки(
		               |			&НачалоПериода,
		               |			Контрагент = &Контрагент"+ДопУсловие+
		               				" И Организация = &Организация) КАК ВзаиморасчетыСПокупателямиОстатки";
	ИначеЕсли Объект.Контрагент.ТипКонтрагента_Подрядчик Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	ВзаиморасчетыСПоставщикамиОстатки.СуммаСНДСОстаток КАК СуммаСНДСОстаток
		               |ИЗ
		               |	РегистрНакопления.ВзаиморасчетыСПоставщиками.Остатки(
		               |			&НачалоПериода,
		               |			Контрагент = &Контрагент"+ДопУсловие+
		               				" И Организация = &Организация) КАК ВзаиморасчетыСПоставщикамиОстатки";
	ИначеЕсли Объект.Контрагент.ТипКонтрагента_Клиент и Объект.Контрагент.ТипКонтрагента_Подрядчик Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	ВзаиморасчетыСПокупателямиОстатки.СуммаСНДСОстаток КАК СуммаСНДСОстаток
		               |ПОМЕСТИТЬ ОбщиеИтоги
		               |ИЗ
		               |	РегистрНакопления.ВзаиморасчетыСПокупателями.Остатки(
		               |			&НачалоПериода,
		               |			Контрагент = &Контрагент"+ДопУсловие+
		              				" И Организация = &Организация) КАК ВзаиморасчетыСПокупателямиОстатки
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	ВзаиморасчетыСПоставщикамиОстатки.СуммаСНДСОстаток
		               |ИЗ
		               |	РегистрНакопления.ВзаиморасчетыСПоставщиками.Остатки(
		               |			&НачалоПериода,
		               |			Контрагент = &Контрагент"+ДопУсловие+
		               				" И Организация = &Организация) КАК ВзаиморасчетыСПоставщикамиОстатки
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	СУММА(ОбщиеИтоги.СуммаСНДСОстаток) КАК СуммаСНДСОстаток
		               |ИЗ
		               |	ОбщиеИтоги КАК ОбщиеИтоги";
	КонецЕсли;
	Запрос.УстановитьПараметр("НачалоПериода", Объект.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", Объект.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
	Если Запрос.Текст = "" Тогда
		Сообщить("У контрагента не определен тип (подрядчик/покупатель) в карточке контрагента. Невозможно получить остаток на начало периода.");
	Иначе	
		Результат= Запрос.Выполнить().Выбрать();
		Если Результат.Следующий() Тогда
			Объект.ОстатокНаНачало = Результат.СуммаСНДСОстаток;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

