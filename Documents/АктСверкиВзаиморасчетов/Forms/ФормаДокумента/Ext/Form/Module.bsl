&НаКлиенте
Процедура РассчитатьСуммыИтого()
	ОстатокНаКонец = Объект.ОстатокНаНачало + Объект.ПоДаннымОрганизации.Итог("Дебет") - Объект.ПоДаннымОрганизации.Итог("Кредит");
	ОстатокНаНачалоКонтрагент = - Объект.ОстатокНаНачало;
	ОстатокНаКонецКонтрагент = ОстатокНаНачалоКонтрагент + Объект.ПоДаннымКонтрагента.Итог("Дебет")-Объект.ПоДаннымКонтрагента.Итог("Кредит");
	Объект.Расхождение = ОстатокНаКонец+ОстатокНаКонецКонтрагент;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДанныеКонтрагентаПоДаннымОрганизации()
	Для каждого Стр из Объект.ПоДаннымОрганизации Цикл
		НовСтр = Объект.ПоДаннымКонтрагента.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,Стр);
		Если СтрНайти(НовСтр.Представление,"Приход") <> 0 Тогда
			НовСтр.Представление = СтрЗаменить(НовСтр.Представление,"Приход","Продажа");
		ИначеЕсли СтрНайти(НовСтр.Представление,"Продажа") <> 0 Тогда
			НовСтр.Представление = СтрЗаменить(НовСтр.Представление,"Продажа","Приход");
		ИначеЕсли СтрНайти(НовСтр.Представление,"прихода") <> 0 Тогда
			НовСтр.Представление = СтрЗаменить(НовСтр.Представление,"прихода","продажи");
		ИначеЕсли СтрНайти(НовСтр.Представление,"продажи") <> 0 Тогда
			НовСтр.Представление = СтрЗаменить(НовСтр.Представление,"продажи","прихода");
		КонецЕсли;
		НовСтр.Дебет = Стр.Кредит;
		НовСтр.Кредит = Стр.Дебет;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоДаннымОрганизации(Команда)
	Если Объект.ПоДаннымКонтрагента.Количество() > 0 Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ВопросЗаполнитьКонтрагентаЗавершение", ЭтотОбъект);
		Текст = НСтр("ru='Перед заполнением табличные части будут очищены. Продолжить?'");
		ПоказатьВопрос(ОписаниеОповещения, Текст, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Да);
	Иначе
	
	ЗаполнитьДанныеКонтрагентаПоДаннымОрганизации();
	РассчитатьСуммыИтого();
		Записать();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоОрганизацииИПоКонтрагенту(Команда)
//Евросиб Литвинов 06.02.21 task 27746 (
	допПараметры = Новый Структура("КомандаИмя", Команда.Имя = "ЗаполнитьПоОрганизацииИПоКонтрагентуПоСФ");
//Евросиб Литвинов 06.02.21 task 27746 )
	Если Объект.ПоДаннымОрганизации.Количество() > 0 или Объект.ПоДаннымКонтрагента.Количество() > 0 Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ВопросЗаполнитьПоДаннымУчетаИКонтрагентаЗавершение", ЭтотОбъект, допПараметры); //Евросиб Литвинов 06.02.21 task 27746
		Текст = НСтр("ru='Перед заполнением табличные части будут очищены. Продолжить?'");
		ПоказатьВопрос(ОписаниеОповещения, Текст, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Да);
	Иначе
	
		ЗаполнитьДокументНаСервере(допПараметры);
		ЗаполнитьДанныеКонтрагентаПоДаннымОрганизации();
		РассчитатьСуммыИтого();
		Модифицированность = Истина;  
		// Евросиб(ДИТ) US 86248 ТА 86254  Сержантова А.С. Начало: 02.07.2024 
		Если Команда.Имя = "ЗаполнитьПоОрганизацииИПоКонтрагентуПоСФ" Тогда
			Объект.ТипАктаСверки = ПредопределенноеЗначение("Перечисление.ТипыАктовСверок.ПоОрганизацииИКонтрагенту_СчетФактуры");
		Иначе
		    Объект.ТипАктаСверки = ПредопределенноеЗначение("Перечисление.ТипыАктовСверок.ПоОрганизацииИКонтрагенту_Акты");
		КонецЕсли;
		// Евросиб(ДИТ) US 86248 ТА 86254  Сержантова А.С. Конец: 02.07.2024
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВопросЗаполнитьПоДаннымУчетаИКонтрагентаЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда 
		// Евросиб(ДИТ) US 86248 ТА 86254  Сержантова А.С. Начало: 02.07.2024 
		Если ДополнительныеПараметры.КомандаИмя = Истина Тогда
			Объект.ТипАктаСверки = ПредопределенноеЗначение("Перечисление.ТипыАктовСверок.ПоОрганизацииИКонтрагенту_СчетФактуры");
		Иначе
		    Объект.ТипАктаСверки = ПредопределенноеЗначение("Перечисление.ТипыАктовСверок.ПоОрганизацииИКонтрагенту_Акты");
		КонецЕсли;
		// Евросиб(ДИТ) US 86248 ТА 86254  Сержантова А.С. Конец: 02.07.2024
		Объект.ПоДаннымОрганизации.Очистить();
		Объект.ПоДаннымКонтрагента.Очистить();
		ЗаполнитьДокументНаСервере(ДополнительныеПараметры);  //Евросиб Литвинов 06.02.21 task 27746;
		ЗаполнитьДанныеКонтрагентаПоДаннымОрганизации();
		РассчитатьСуммыИтого();
		Модифицированность = Истина;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ВопросЗаполнитьКонтрагентаЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
			Объект.ПоДаннымКонтрагента.Очистить();
		ЗаполнитьДанныеКонтрагентаПоДаннымОрганизации();
		РассчитатьСуммыИтого();
	КонецЕсли;
		
КонецПроцедуры

