	Если Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		// Евросиб(ДИТ) US 86248 ТА 86254  Сержантова А.С. Начало: 02.07.2024 
		Если ДополнительныеПараметры.КомандаИмя = Истина Тогда
			Объект.ТипАктаСверки = ПредопределенноеЗначение("Перечисление.ТипыАктовСверок.ПоОрганизации_СчетФактуры");
		Иначе
		    Объект.ТипАктаСверки = ПредопределенноеЗначение("Перечисление.ТипыАктовСверок.ПоОрганизации_Акты");
