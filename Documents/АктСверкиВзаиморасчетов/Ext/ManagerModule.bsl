Функция ПроверитьВозможностьПечатиАкта(ТаблицаДокументовИзАкта, ВызовИсключения = Ложь) Экспорт
	
	//Евросиб СубботинВ #119324 07.10.2025 Начало
	НоменклатурыБлокировкиПечатиРТУ = Константы.СписокНоменклатурыБлокировкиПечатиРТУ.Получить().Получить();
	//Евросиб СубботинВ #119324 07.10.2025 Конец	
	
	МассивШтрафныхАктов = Новый Массив;
	Для Каждого ДокументИзАкта Из ТаблицаДокументовИзАкта Цикл
		Если (ТипЗнч(ДокументИзАкта.Документ) = Тип("ДокументСсылка.СчетФактураВыданный")
			и ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументИзАкта.Документ,"Штрафы",))
			или (ТипЗнч(ДокументИзАкта.Документ) = Тип("ДокументСсылка.РеализацияТоваровУслуг")
			и ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументИзАкта.Документ,"Штраф",)) Тогда
			Если ВызовИсключения Тогда
				ВызватьИсключение("В " + ДокументИзАкта.Документ + "  установлен признак Штраф. Недостаточно прав для выполнения операции.");
			КонецЕсли;	
			МассивШтрафныхАктов.Добавить(ДокументИзАкта.Документ); 
		КонецЕсли;
		//Евросиб СубботинВ #119324 07.10.2025 Начало
		Если ТипЗнч(ДокументИзАкта.Документ) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			Услуги = ДокументИзАкта.Документ.Услуги.Выгрузить();
			Для Каждого СтрокаУслуг из Услуги Цикл
				Если НЕ НоменклатурыБлокировкиПечатиРТУ.НайтиПоЗначению(СтрокаУслуг.Номенклатура) = Неопределено Тогда
					Если МассивШтрафныхАктов.Найти(ДокументИзАкта.Документ) = Неопределено	Тогда 
						МассивШтрафныхАктов.Добавить(ДокументИзАкта.Документ);
					КонецЕсли;						
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;			
		//Евросиб СубботинВ #119324 07.10.2025 Конец		
	КонецЦикла;		
	Возврат МассивШтрафныхАктов
	
КонецФункции
