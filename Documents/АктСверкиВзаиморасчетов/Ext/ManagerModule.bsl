Функция ЗаполненаКолонкаДокументРегистратор( СсылкаНаОбъект )
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	АктСверкиВзаиморасчетовПоДаннымОрганизации.ДокументРегистратор КАК ДокументРегистратор
		|ИЗ
		|	Документ.АктСверкиВзаиморасчетов.ПоДаннымОрганизации КАК АктСверкиВзаиморасчетовПоДаннымОрганизации
		|ГДЕ
		|	АктСверкиВзаиморасчетовПоДаннымОрганизации.Ссылка = &Ссылка
		|	И АктСверкиВзаиморасчетовПоДаннымОрганизации.ДокументРегистратор <> НЕОПРЕДЕЛЕНО";
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

