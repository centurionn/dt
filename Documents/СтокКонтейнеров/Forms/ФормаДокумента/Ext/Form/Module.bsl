&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	
	Тбл = Параметры.Тбл;
	СтрДляУдаления = ЭтаФорма[Тбл].НайтиПоИдентификатору(Параметры.Стр);
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		// удаляем новую строку
		УдалитьСтрокуСервер(Параметры);
		Возврат;
	Иначе
		СложитьСтрокиСервер(Параметры);
	КонецЕсли;
	
КонецПроцедуры		

&НаСервере
Процедура УдалитьСтрокуСервер(Параметры)
	
	Тбл = Параметры.Тбл;
	СтрДляУдаления = ЭтаФорма[Тбл].НайтиПоИдентификатору(Параметры.Стр);
	ЭтаФорма[Тбл].Удалить(СтрДляУдаления);
	
КонецПроцедуры

&НаСервере
Процедура СложитьСтрокиСервер(Параметры)
	
	Тбл = Параметры.Тбл;
	СтрДляУдаления = ЭтаФорма[Тбл].НайтиПоИдентификатору(Параметры.Стр);
	ТЗ = ЭтаФорма[Тбл].Выгрузить();
	ТЗ.Свернуть("Контейнер,Контрагент,Направление,Статус","КоличествоБНКонтейнеров");
	ЭтаФорма[Тбл].Загрузить(ТЗ);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействиеПриИзмененииДанных(Элемент)
	
	ТекД = Элемент.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КодКонтрагента = СтрЗаменить(Элемент.Имя,"ТЗН","");
	
	ТабЗначИмя = СтрЗаменить(Элемент.Имя,"ТЗН","Тбл");
	
	
	Если ЗначениеЗаполнено(ТекД.Контейнер) Тогда
		
		Если НЕ ЗначениеЗаполнено(ТекД.ТипКонтейнера) Тогда
			ТекД.ТипКонтейнера = ПолучитьТипКонтейнера(ТекД.Контейнер).ТипТЕ;
		КонецЕсли;
		
		Если ТекД.Статус = ПредопределенноеЗначение("Перечисление.СтатусыКТК.Свободен") Тогда
			ТекД.КоличествоБНКонтейнеров = 1;
		КонецЕсли;
		
		// сделать проверку на то, что выбранный КТК не находится в другом стоке или у другого клиента
		// 1. не зарезервирован ранее
		// 2. если НЕ зарезервирован (свободен) В ДРУГОМ стоке, то спросить у пользователя, что делать с этим КТК.
		МассивКТК = Новый Массив;
		МассивКТК.Добавить(ТекД.Контейнер);
		МассивСтруктурКТК = ПолучитьСпорныеКТК(МассивКТК,Объект.Сток,КодКонтрагента);
	
		МассивКТКДляВопроса = Новый Массив;
		
		НеПишем = Ложь;
		
		Для Каждого Эл Из МассивСтруктурКТК Цикл
			Если Эл.Контейнер = ТекД.Контейнер Тогда
				НеПишем = Истина;
	//			Если НЕ Эл.ЗапретСтатуса Тогда
					МассивКТКДляВопроса.Добавить(Эл.Контейнер);
	//			КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если НеПишем И МассивКТКДляВопроса.Количество() = 0 Тогда
			ПоказатьПредупреждение(,"Данный контейнер уже зарезервирован и не может быть добавлен повторно!");
			Возврат;
		КонецЕсли;
		
		// если есть КТК, которые находятся не в этом стоке или не у этого контрагента
		Если МассивКТКДляВопроса.Количество()>0 Тогда
			
			МассивРазмеровКТКВопрос = Новый Массив;
			МассивДатВопрос = Новый Массив;
			МасДатПрибТермВопрос = Новый Массив;
			
			ПараметрыДействия = Новый Структура;
			ПараметрыДействия.Вставить("ИмяТбл","Тбл"+КодКонтрагента);
			ПараметрыДействия.Вставить("ИДКонтрагента",КодКонтрагента);
			ПараметрыДействия.Вставить("МассивКТК",МассивКТКДляВопроса);
			ПараметрыДействия.Вставить("МассивРазмеровКТК",МассивРазмеровКТКВопрос);
			ПараметрыДействия.Вставить("МассивДат",МассивДатВопрос);
			ПараметрыДействия.Вставить("МасДатПрибТерм",МасДатПрибТермВопрос);
			ПараметрыДействия.Вставить("МассивСтруктурКТК",МассивСтруктурКТК);
			
			ТекстСообщения = "Контейнеры " + СтрСоединить(МассивКТКДляВопроса, Символы.ПС) + " находятся в другом стоке или у другого контрагента.";
			ОпОп = Новый ОписаниеОповещения("ВопросДействияКТК", ЭтаФорма, ПараметрыДействия);
			ПоказатьВопрос(ОпОп, ТекстСообщения + " Перенести в этот сток контрагенту " + Элементы.ГруппаСтраницы.ТекущаяСтраница.Заголовок + "?", РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Нет,, КодВозвратаДиалога.Нет);
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;	
	КонецЕсли;
	
	
	Если ЭтаФорма[ТабЗначИмя].Количество()>0 Тогда
		ЭтаФорма.Элементы["КМЗаполнитьПоТекСтр" + Строка(КодКонтрагента)].Доступность = Истина;
		ЭтаФорма.Элементы["КМЗаполнитьПоСпр" + Строка(КодКонтрагента)].Доступность = Истина;
		ЭтаФорма.Элементы["КПЗаполнитьПоТекСтр" + Строка(КодКонтрагента)].Доступность = Истина;
		ЭтаФорма.Элементы["КПЗаполнитьПоСпр" + Строка(КодКонтрагента)].Доступность = Истина;
	Иначе
		ЭтаФорма.Элементы["КМЗаполнитьПоТекСтр" + Строка(КодКонтрагента)].Доступность = Ложь;
		ЭтаФорма.Элементы["КМЗаполнитьПоСпр" + Строка(КодКонтрагента)].Доступность = Ложь;
		ЭтаФорма.Элементы["КПЗаполнитьПоТекСтр" + Строка(КодКонтрагента)].Доступность = Ложь;
		ЭтаФорма.Элементы["КПЗаполнитьПоСпр" + Строка(КодКонтрагента)].Доступность = Ложь;
	КонецЕсли;
	
	Если СтрНачинаетсяС(Элемент.ТекущийЭлемент.Имя,"Контейнер") Тогда
		Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.Контейнер) Тогда
			Элемент.ТекущиеДанные.КоличествоБНКонтейнеров = 1;
			//Элемент.ТекущиеДанные.ТипКонтейнера = "";
		КонецЕсли;
	ИначеЕсли СтрНачинаетсяС(Элемент.ТекущийЭлемент.Имя,"ТипКонтейнера") Тогда
		//Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.ТипКонтейнера) Тогда
		//	Элемент.ТекущиеДанные.Контейнер = "";
		//КонецЕсли;
	КонецЕсли;
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница.Заголовок = Строка(ПолучитьКонтрагента(КодКонтрагента)) + " (" + Строка(ЭтаФорма[ТабЗначИмя].Итог("КоличествоБНКонтейнеров"))+ ")";
	
	/////////////////////////////////////////
	
	МассивРазрешенныхПолей = Новый Массив;
	МассивРазрешенныхПолей.Добавить("ТипКонтейнера");
	МассивРазрешенныхПолей.Добавить("Направление");
	МассивРазрешенныхПолей.Добавить("СледующийСток");
	МассивРазрешенныхПолей.Добавить("СрокВозврата");
	МассивРазрешенныхПолей.Добавить("ПСЦ");
	МассивРазрешенныхПолей.Добавить("Ставка");
	МассивРазрешенныхПолей.Добавить("ЗабратьДо");
	МассивРазрешенныхПолей.Добавить("ДатаВзятияИзСтока");
	МассивРазрешенныхПолей.Добавить("ДатаПриемаВСток");
	
	МассивРазрешенныхПолей.Добавить("ЕдиницаИзмерения");
	МассивРазрешенныхПолей.Добавить("Валюта");
	МассивРазрешенныхПолей.Добавить("СтавкаНДС");
	МассивРазрешенныхПолей.Добавить("НДСВключая");
	МассивРазрешенныхПолей.Добавить("ИнструкцииПоСдачеПорожнего");
	МассивРазрешенныхПолей.Добавить("СтавкаСНП");
	МассивРазрешенныхПолей.Добавить("ПунктОкончательнойСдачиСписок");
	МассивРазрешенныхПолей.Добавить("СтавкаСНППредставление");
	МассивРазрешенныхПолей.Добавить("СтавкаСНПТаблица");
	
	МассивРазрешенныхПолей.Добавить("НомерТСПрибытия");
	МассивРазрешенныхПолей.Добавить("ВодительТСПрибытия");
	
	Если ЗаполнятьПоПервойСтроке Тогда
		ИмяТЧ = Элемент.Имя;
		ИмяТбл = СтрЗаменить(ИмяТЧ, "ТЗН", "Тбл");
		ИмяПоля = СтрЗаменить(Элемент.ТекущийЭлемент.Имя, Сред(ИмяТЧ, 4), "");
		
		//Поиск первой строки выводимой пользователю с учетом отборов и поиска
		ТаблицаДанных = ЭтаФорма[ИмяТбл];
		
		// использовать такую конструкцию, т.к. на заполнении по первой сроке для ставкиСНП (если она идет прогрессивной шкалой) в 
		// поле Элемент будет не таблица формы, а структура
		ТаблицаФормы = Элементы[ИмяТЧ];
		
		ПерваяСтрока = Неопределено;
		Для Каждого СтрокаТаблицы Из ТаблицаДанных Цикл
			Если ТаблицаФормы.ПроверитьСтроку(СтрокаТаблицы.ПолучитьИдентификатор()) Тогда				
				ПерваяСтрока = СтрокаТаблицы;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		СтрДозаполнения = Новый Структура();		
		Если СтрНачинаетсяС(Элемент.ТекущийЭлемент.Имя, "ПСЦ") Тогда
			СтрДозаполнения = ПолучитьСтруктуруПСЦ(ПерваяСтрока[ИмяПоля]);
		КонецЕсли;
		
		//Если МассивРазрешенныхПолей.Найти(ИмяПоля) = неопределено Тогда Возврат; КонецЕсли;
		
		Для Сч = 1 По ЭтаФорма[ИмяТбл].Количество() - 1 Цикл
			//Менять только те строки, которые видны в таблице с учетом отборов и поиска
			СтрокаТаблицы = ЭтаФорма[ИмяТбл][Сч];			
			Если Не ТаблицаФормы.ПроверитьСтроку(СтрокаТаблицы.ПолучитьИдентификатор())
					Или ПерваяСтрока = СтрокаТаблицы Тогда
				Продолжить;			
			КонецЕсли;
			
			ЭтаФорма[ИмяТбл][Сч][ИмяПоля] = ПерваяСтрока[ИмяПоля];
			ЗаполнитьЗначенияСвойств(ЭтаФорма[ИмяТбл][Сч], СтрДозаполнения);
			Если СтрДозаполнения.Свойство("ПунктОкончательнойСдачиСписок") ТОгда
				ЭтаФорма[ИмяТбл][Сч]["ПунктОкончательнойСдачиСписок"].Очистить();
				Для Каждого Эл Из ПерваяСтрока["ПунктОкончательнойСдачиСписок"] Цикл
					ЭтаФорма[ИмяТбл][Сч]["ПунктОкончательнойСдачиСписок"].Добавить(Эл);
				КонецЦикла;
				ЗаполнитьЗначенияСвойств(ЭтаФорма[ИмяТбл][Сч], ПерваяСтрока,"Ставка,ЕдиницаИзмерения,Валюта,СтавкаНДС,НДСВключая,СтавкаСНП,СтавкаСНППредставление");
			КонецЕсли;
			
			Если ИмяПоля = "СтавкаСНППредставление" ИЛИ ИмяПоля = "ПСЦ" Тогда
				ТекТбл = ЭтаФорма[ИмяТбл][Сч]["СтавкаСНПТаблица"];
				ТблИсточник = ПерваяСтрока["СтавкаСНПТаблица"];
				ТекТбл.Очистить();
				Для Каждого Стр Из ТблИсточник Цикл
					НСтр = ТекТбл.Добавить();
					ЗаполнитьЗначенияСвойств(НСтр,Стр);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТипКонтейнера(КонтейнерСсылка)
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КонтейнерСсылка,"ТипТЕ");
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКонтрагента(КодКонтрагента)
	
	Возврат Справочники.Контрагенты.НайтиПоКоду(КодКонтрагента);
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьДействиеПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекД = Элемент.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КодКонтрагента = СтрЗаменить(Элемент.Имя,"ТЗН","");
	
	Если НоваяСтрока Тогда
		ТекД.Статус = ПредопределенноеЗначение("Перечисление.СтатусыКТК.Свободен");
		ТекД.КоличествоБНКонтейнеров = 1;
		
		Если ЗаполнятьПоПервойСтроке Тогда
			
			ТабЗначИмя = СтрЗаменить(Элемент.Имя,"ТЗН","Тбл");
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Контрагент", ПолучитьКонтрагента(КодКонтрагента));
			НайденныеСтроки = ЭтаФорма[ТабЗначИмя].НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество()>0 Тогда
				ЗаполнитьЗначенияСвойств(ТекД, НайденныеСтроки[0],,"Контейнер,СтавкаСНПТаблица");
				Для Каждого Стр Из НайденныеСтроки[0].СтавкаСНПТаблица Цикл
					НовСтр = ТекД.СтавкаСНПТаблица.Добавить();
					ЗаполнитьЗначенияСвойств(НовСтр,Стр);
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбщаяИнформацияПоКТК()
	
	ОбщиеДанные.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтейнерыВСтокахОстатки.Сток КАК Сток,
	               |	КонтейнерыВСтокахОстатки.Назначение КАК Направление,
	               |	КонтейнерыВСтокахОстатки.Контрагент КАК Контрагент,
	               |	КонтейнерыВСтокахОстатки.Контейнер КАК Контейнер,
	               |	КонтейнерыВСтокахОстатки.КоличествоОстаток КАК КоличествоБНКонтейнеров,
	               |	КонтейнерыВСтокахОстатки.ДатаПриемаВСток КАК ДатаПриемаВСток,
	               |	КонтейнерыВСтокахОстатки.СрокВозврата КАК СрокВозврата
	               |ПОМЕСТИТЬ ДанныеРС
	               |ИЗ
	               |	РегистрНакопления.КонтейнерыВСтоках.Остатки(&ДатаКон, Сток = &Сток) КАК КонтейнерыВСтокахОстатки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДанныеРС.Сток КАК Сток,
	               |	ДанныеРС.Направление КАК Направление,
	               |	ДанныеРС.Контрагент КАК Контрагент,
	               |	ДанныеРС.Контейнер КАК Контейнер,
	               |	ЗНАЧЕНИЕ(Перечисление.СтатусыКТК.Свободен) КАК Статус,
	               |	ДанныеРС.КоличествоБНКонтейнеров КАК КоличествоБНКонтейнеров,
	               |	ДанныеРС.ДатаПриемаВСток КАК ДатаПриемаВСток,
	               |	ДанныеРС.СрокВозврата КАК СрокВозврата
	               |ПОМЕСТИТЬ СтатусыКТК
	               |ИЗ
	               |	ДанныеРС КАК ДанныеРС
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СтатусыКТКСрезПоследних.Сток,
	               |	СтатусыКТКСрезПоследних.Направление,
	               |	СтатусыКТКСрезПоследних.Контрагент,
	               |	СтатусыКТКСрезПоследних.Контейнер,
	               |	СтатусыКТКСрезПоследних.Статус,
	               |	СтатусыКТКСрезПоследних.Количество,
	               |	ДанныеРС.ДатаПриемаВСток,
	               |	ДанныеРС.СрокВозврата
	               |ИЗ
	               |	РегистрСведений.СтатусыКТК.СрезПоследних(&ДатаКон, Сток = &Сток) КАК СтатусыКТКСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеРС КАК ДанныеРС
	               |		ПО (ДанныеРС.Сток = СтатусыКТКСрезПоследних.Сток)
	               |			И (ДанныеРС.Контрагент = СтатусыКТКСрезПоследних.Контрагент)
	               |			И (ДанныеРС.Контейнер = СтатусыКТКСрезПоследних.Контейнер)
	               |			И СтатусыКТКСрезПоследних.Направление = ДанныеРС.Направление
	               |ГДЕ
	               |	СтатусыКТКСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыКТК.Зарезервирован)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СтатусыКТК.Сток КАК Сток,
	               |	СтатусыКТК.Направление КАК Назначение,
	               |	СтатусыКТК.Контрагент КАК Контрагент,
	               |	СтатусыКТК.Статус КАК Статус,
	               |	СУММА(ВЫБОР
	               |			КОГДА СтатусыКТК.Контейнер ССЫЛКА Справочник.ТЕ
	               |				ТОГДА СтатусыКТК.КоличествоБНКонтейнеров
	               |		КОНЕЦ) КАК КоличествоКТК,
	               |	СУММА(ВЫБОР
	               |			КОГДА СтатусыКТК.Контейнер ССЫЛКА Справочник.ТипоразмерыТЕ
	               |				ТОГДА СтатусыКТК.КоличествоБНКонтейнеров
	               |		КОНЕЦ) КАК КоличествоБНКТК,
	               |	СУММА(СтатусыКТК.КоличествоБНКонтейнеров) КАК ВсегоКТК,
	               |	СтатусыКТК.ДатаПриемаВСток КАК ДатаПриемаВСток,
	               |	СтатусыКТК.СрокВозврата КАК СрокВозврата,
	               |	СтатусыКТК.ДатаПриемаВСток КАК ДатаПриемаВПользованиеПередПоставщиком
	               |ИЗ
	               |	СтатусыКТК КАК СтатусыКТК
	               |ГДЕ
	               |	(НЕ СтатусыКТК.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыКТК.ВДвижении)
	               |			ИЛИ СтатусыКТК.Статус ЕСТЬ NULL)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СтатусыКТК.Контрагент,
	               |	СтатусыКТК.Статус,
	               |	СтатусыКТК.Сток,
	               |	СтатусыКТК.Направление,
	               |	СтатусыКТК.ДатаПриемаВСток,
	               |	СтатусыКТК.СрокВозврата,
	               |	СтатусыКТК.ДатаПриемаВСток";
	Запрос.УстановитьПараметр("Сток",Объект.Сток);
	// если это запрос по старым данным стока, то период это дата следующего документа 
	// (чтобы получить актуальную информацию по движению контейнеров за цикл)
	Если ТолькоПросмотрЪ Тогда
		ДатаОст = ЕстьСледующиеДокументы();
	Иначе
		ДатаОст = ТекущаяДата();
	КонецЕсли;
	//ДатаПредыдущегоРегистратора = ЕстьПредыдущиеДокументы();   Запрос.ВыполнитьПакетСПромежуточнымиДанными()[0].Выгрузить()
	
	//Запрос.УстановитьПараметр("ДатаНач",ДатаПредыдущегоРегистратора);
	Запрос.УстановитьПараметр("ДатаКон",ДатаОст);
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	ОбщиеДанные.Загрузить(ТЗ);
	ИтогоБНКТК = ТЗ.Итог("КоличествоБНКТК");
	ИтогоНомерныхКТК = ТЗ.Итог("КоличествоКТК");
	ИтогоКТК = ТЗ.Итог("ВсегоКТК");
	
	Элементы.ГруппаОсновное.Заголовок = "Данные по стоку (" + Формат(ДатаОст,"ДФ=dd.MM.yy") + ")";
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ОбщаяИнформацияПоКТК();
	Оповестить("ОбновитьДанныеСтоков");
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВладельца(Команда)
	
	Перем ВыбЗнач;
	ВыбЗнач = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
	ОписаниеТипов = Новый ОписаниеТипов("СправочникСсылка.Контрагенты");
	
	Оповещение = Новый ОписаниеОповещения("ВыполнитьПослеВводаЗначения",ЭтаФорма,);
	ОткрытьФорму("Справочник.Контрагенты.ФормаВыбора", Новый Структура("КонтрагентПодрядчик", Истина), ,ЭтаФорма.УникальныйИдентификатор,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	//    ПоказатьВводЗначения(Оповещение,ВыбЗнач,"Выберите владельца стока",ОписаниеТипов);
	
КонецПроцедуры

&НаКлиенте 
Процедура ВыполнитьПослеВводаЗначения(Результат,ДопПараметры) Экспорт
	
	Если Результат = Неопределено Или Результат.Пустая() Тогда
		
		Возврат;
		
	КонецЕсли;
	
	СозданиеЗакладки(Результат);
	
КонецПроцедуры

&НаСервере
Процедура СозданиеЗакладки(НовыйКонтрагент, Сообщать = Истина)
	
	// проверить уникальность контрагента
	ТекКонтраг = СокрЛП(НовыйКонтрагент.Код);
	ИмяНовойСтраницы = "Страница" + ТекКонтраг;
	Если НЕ Элементы.Найти(ИмяНовойСтраницы) = Неопределено Тогда
		Если Сообщать Тогда
 			Сообщить("Данный контрагент уже выбран!");
		КонецЕсли;
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницы.ПодчиненныеЭлементы[ИмяНовойСтраницы];
		Возврат;
	КонецЕсли;
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Статус",Новый ОписаниеТипов("ПеречислениеСсылка.СтатусыКТК"),"Статус");
	ТЗ.Колонки.Добавить("Контейнер",Новый ОписаниеТипов("СправочникСсылка.ТЕ"));
	ТЗ.Колонки.Добавить("Контрагент",Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТЗ.Колонки.Добавить("Договор",Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
	ТЗ.Колонки.Добавить("КоличествоБНКонтейнеров",Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10)),"Кол-во конт.");
	ТЗ.Колонки.Добавить("ТипКонтейнера",Новый ОписаниеТипов("СправочникСсылка.ТипоразмерыТЕ"),"Тип контейнера");
	ТЗ.Колонки.Добавить("ДатаПриемаВСток",Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)),"Дата приема в сток");
	ТЗ.Колонки.Добавить("СрокВозврата",Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10)),"Срок возврата");
	ТЗ.Колонки.Добавить("ВремяПрибытияНаТерминалОтпр",Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)),"Прибытие на терминал отпр.");
	ТЗ.Колонки.Добавить("ЗабратьДо",Новый ОписаниеТипов("Дата"),"Забрать до");
	ТЗ.Колонки.Добавить("ДатаВзятияИзСтока",Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)),"Дата взятия из стока");
	ТЗ.Колонки.Добавить("Направление",Новый ОписаниеТипов("СправочникСсылка.Локации"),"Ст. след. назн.");
	ТЗ.Колонки.Добавить("СледующийСток",Новый ОписаниеТипов("СправочникСсылка.Локации"),"Следующий сток");
	ТЗ.Колонки.Добавить("ПСЦ",Новый ОписаниеТипов("ДокументСсылка.ПСЦ"));
	ТЗ.Колонки.Добавить("ПунктОкончательнойСдачиСписок",Новый ОписаниеТипов("СписокЗначений"), "Пункт оконч. сдачи");
	ТЗ.Колонки.Добавить("СтавкаСНПТаблица",Новый ОписаниеТипов("ТаблицаЗначений"));
	
	ТЗ.Колонки.Добавить("ДатаПриемаВПользованиеПередПоставщиком",Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)),"Дата приема в пользование перед поставщиком");
	ТЗ.Колонки.Добавить("ДатаСдачиКТКПоставщику",Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)),"Дата сдачи из пользования (подрядчик)");
	
	ТЗ.Колонки.Добавить("КлиентПередислокация_Клиент",Новый ОписаниеТипов("СправочникСсылка.Контрагенты"),"Клиент (передислокация)");
	ТЗ.Колонки.Добавить("КлиентПередислокация_Договор",Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"),"Договор (передислокация)");
	ТЗ.Колонки.Добавить("КлиентПередислокация_ПСЦ",Новый ОписаниеТипов("ДокументСсылка.ПСЦ"),"ПСЦ (передислокация)");
	
	ТЗ.Колонки.Добавить("СВВ",Новый ОписаниеТипов("Дата"),"СВВ");
	
	ТЗ.Колонки.Добавить("ЕдиницаИзмерения",Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"),"Е.и.");
	ТЗ.Колонки.Добавить("Ставка",Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 3)),"Ставка");
	ТЗ.Колонки.Добавить("Валюта",Новый ОписаниеТипов("СправочникСсылка.Валюты"),"Валюта");
	ТЗ.Колонки.Добавить("СтавкаНДС",Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"),"Ставка НДС");
	ТЗ.Колонки.Добавить("НДСВключая",Новый ОписаниеТипов("Булево"),"НДС вкл.");
	ТЗ.Колонки.Добавить("СтавкаСНП",Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 2)),"Ставка СНП");
	
	ТЗ.Колонки.Добавить("ТекКонтрагент",Новый ОписаниеТипов("СправочникСсылка.Контрагенты"),"Контрагент");
	ТЗ.Колонки.Добавить("ТекСток",Новый ОписаниеТипов("СправочникСсылка.Локации"),"Сток");
	ТЗ.Колонки.Добавить("ТекКолвоКТК",Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10)),"Кол-во конт.");
	
	ТЗ.Колонки.Добавить("НомерРелиза",Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)),"Номер релиза");
	ТЗ.Колонки.Добавить("ДатаНачалаРелиза",Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)),"Дата начала релиза");
	ТЗ.Колонки.Добавить("СрокДействияРелиза",Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)),"Срок действия релиза");
	
	ТЗ.Колонки.Добавить("ФактическоеНаправление",Новый ОписаниеТипов("СправочникСсылка.Локации"),"Фактическое направление");
	ТЗ.Колонки.Добавить("ИнструкцииПоСдачеПорожнего",Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)),"Инстр. по сдаче порожнего");
	
	ТЗ.Колонки.Добавить("НомерТСПрибытия",Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)),"Номер ТС Прибытия");
	ТЗ.Колонки.Добавить("ВодительТСПрибытия",Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(150)),"Водитель ТС Прибытия");

	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Число"));
	ПараметрыЧисла = Новый КвалификаторыЧисла(15,2,ДопустимыйЗнак.Неотрицательный);
	МассивТипов.Добавить(Тип("Строка"));
	ПараметрыСтроки = Новый КвалификаторыСтроки(0);
	
	ДопустимыеТипы = Новый ОписаниеТипов(МассивТипов, ПараметрыЧисла, ПараметрыСтроки);
	ТЗ.Колонки.Добавить("СтавкаСНППредставление",ДопустимыеТипы,"Ставка СНП");
	
	
	ТекКонтраг = СокрЛП(НовыйКонтрагент.Код);
	ИмяТекСтраницы = "Страница" + ТекКонтраг;
	ИмяТблРеквизит = "Тбл" + ТекКонтраг;
	ИмяТблЭлементФормы = "ТЗН" + ТекКонтраг;
	
	НовыйЭлемент1 = Элементы.Добавить(ИмяТекСтраницы,Тип("ГруппаФормы"),Элементы.ГруппаСтраницы);
	НовыйЭлемент1.Вид = ВидГруппыФормы.Страница;
	НовСтрЭФ = СписокЭФ.Добавить();
	НовСтрЭФ.ТекЭлемент = ИмяТекСтраницы;
	
	МассивТипаВыбора = Новый Массив;
	МассивТипаВыбора.Добавить(Тип("ТаблицаЗначений"));
	ОписаниеТипаВыбора = Новый ОписаниеТипов(МассивТипаВыбора);
	МассивРеквизитов = Новый Массив;
	
	
	МассивРеквизитов.Добавить(Новый РеквизитФормы(ИмяТблРеквизит, ОписаниеТипаВыбора, "", ИмяТблЭлементФормы));
	Для Каждого Колонка Из ТЗ.Колонки Цикл
		ИмяКолонкиРеквизит = Колонка.Имя;
		МассивРеквизитов.Добавить(Новый РеквизитФормы(ИмяКолонкиРеквизит, Колонка.ТипЗначения,ИмяТблРеквизит));
		// для колонки СтавкаСНПТаблица создать ее собственные колонки, т.к. это таблица значений
		Если ИмяКолонкиРеквизит = "СтавкаСНПТаблица" Тогда
			ТЗ_Хранилище = Новый ТаблицаЗначений;
			ТЗ_Хранилище.Колонки.Добавить("От",Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10,3)));
			ТЗ_Хранилище.Колонки.Добавить("До",Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10,3)));
			ТЗ_Хранилище.Колонки.Добавить("Стоимость",Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2,ДопустимыйЗнак.Неотрицательный)));
			Для Каждого Колонка2 Из ТЗ_Хранилище.Колонки Цикл
				ИмяКолонкиРеквизит2 = Колонка2.Имя;
				МассивРеквизитов.Добавить(Новый РеквизитФормы(ИмяКолонкиРеквизит2, Колонка2.ТипЗначения,ИмяТблРеквизит + ".СтавкаСНПТаблица"));
			КонецЦикла;
		КонецЕсли;	
	КонецЦикла;
	
	ИзменитьРеквизиты(МассивРеквизитов);      
	ТаблицаПолейВыбора = Элементы.Добавить(ИмяТблЭлементФормы, Тип("ТаблицаФормы"),НовыйЭлемент1);
	ТаблицаПолейВыбора.ПутьКДанным = ИмяТблРеквизит;
	ТаблицаПолейВыбора.Отображение = ОтображениеТаблицы.Список;
	НовСтрЭФ = СписокЭФ.Добавить();
	НовСтрЭФ.ТекЭлемент = ИмяТблЭлементФормы;
	
	// Контекстное меню таблицы
	НовЭлемент = Элементы.Добавить("КМЗаполнитьПоСпр" + ТекКонтраг, Тип("КнопкаФормы"), ТаблицаПолейВыбора.КонтекстноеМеню);
	НовЭлемент.ИмяКоманды = "ЗаполнитьВыбранныеПоСправочнику"; 
	НовЭлемент.Доступность = Ложь;
	НовСтрЭФ = СписокЭФ.Добавить();
	НовСтрЭФ.ТекЭлемент = "КМЗаполнитьПоСпр" + ТекКонтраг;
	
	НовЭлемент = Элементы.Добавить("КМЗаполнитьПоТекСтр" + ТекКонтраг, Тип("КнопкаФормы"), ТаблицаПолейВыбора.КонтекстноеМеню);
	НовЭлемент.ИмяКоманды = "ЗаполнитьВыбранныеСтроки";
	НовЭлемент.Доступность = Ложь;
	НовСтрЭФ = СписокЭФ.Добавить();
	НовСтрЭФ.ТекЭлемент = "КМЗаполнитьПоТекСтр" + ТекКонтраг;
	
	// Командная панель таблицы
	НовЭлемент = Элементы.Добавить("ВставитьИзEXCEL" + ТекКонтраг, Тип("КнопкаФормы"), ТаблицаПолейВыбора.КоманднаяПанель);
	НовЭлемент.ИмяКоманды = "ВставитьИзEXCEL";
	НовСтрЭФ = СписокЭФ.Добавить();
	НовСтрЭФ.ТекЭлемент = "ВставитьИзEXCEL" + ТекКонтраг;
	
	НовЭлемент = Элементы.Добавить("КПУдалитьТекКонтрагента" + ТекКонтраг, Тип("КнопкаФормы"), ТаблицаПолейВыбора.КоманднаяПанель);
	НовЭлемент.ИмяКоманды = "УдалитьТекКонтрагента";
	НовСтрЭФ = СписокЭФ.Добавить();
	НовСтрЭФ.ТекЭлемент = "КПУдалитьТекКонтрагента" + ТекКонтраг;
	
	НовЭлемент = Элементы.Добавить("КПЗаполнитьПоСпр" + ТекКонтраг, Тип("КнопкаФормы"), ТаблицаПолейВыбора.КоманднаяПанель);
	НовЭлемент.ИмяКоманды = "ЗаполнитьВыбранныеПоСправочнику"; 
	НовЭлемент.Доступность = Ложь;
	НовСтрЭФ = СписокЭФ.Добавить();
	НовСтрЭФ.ТекЭлемент = "КПЗаполнитьПоСпр" + ТекКонтраг;
	
	НовЭлемент = Элементы.Добавить("КПЗаполнитьПоТекСтр" + ТекКонтраг, Тип("КнопкаФормы"), ТаблицаПолейВыбора.КоманднаяПанель);
	НовЭлемент.ИмяКоманды = "ЗаполнитьВыбранныеСтроки";
	НовЭлемент.Доступность = Ложь;
	НовСтрЭФ = СписокЭФ.Добавить();
	НовСтрЭФ.ТекЭлемент = "КПЗаполнитьПоТекСтр" + ТекКонтраг;
	
	ГруппаАктуальных = Ложь;
	
	Для Каждого Колонка Из ТЗ.Колонки Цикл
		
		// для колонки СтавкаСНПТаблица элемент формы не создавать
		Если Колонка.Имя = "СтавкаСНПТаблица" Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяКолонкиЭлементФормы = Колонка.Имя + ТекКонтраг;
		
		ТолькоПросм = Ложь;
		РасположениеКолонки = ТаблицаПолейВыбора;
		
		Если //Колонка.Имя = "Статус" ИЛИ
			Колонка.Имя = "ТекКонтрагент" ИЛИ
			Колонка.Имя = "ТекСток" ИЛИ
			Колонка.Имя = "ТекКолвоКТК" Тогда
			
			Если НЕ ГруппаАктуальных Тогда
				// добавляем новую группу колонок для актуальных данных по КТК
				ИмяГруппыКолонок = "ГруппаАктуальныеДанные" + ТекКонтраг;
				НоваяГруппаКолонок = Элементы.Добавить(ИмяГруппыКолонок,Тип("ГруппаФормы"),ТаблицаПолейВыбора);
				НоваяГруппаКолонок.Вид = ВидГруппыФормы.ГруппаКолонок;
				НоваяГруппаКолонок.Группировка = ГруппировкаКолонок.Горизонтальная;
				НоваяГруппаКолонок.ОтображатьВШапке = Истина;
				НоваяГруппаКолонок.Заголовок = "Актуальные данные";
				НовСтрЭФ = СписокЭФ.Добавить();
				НовСтрЭФ.ТекЭлемент = ИмяГруппыКолонок;
				ГруппаАктуальных = Истина;
			КонецЕсли;
			
			ТолькоПросм = Истина;
			РасположениеКолонки = НоваяГруппаКолонок;
			
		КонецЕсли;
		
		
		НовыйЭлемент = Элементы.Добавить(ИмяКолонкиЭлементФормы, Тип("ПолеФормы"), РасположениеКолонки);       
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным = ИмяТблРеквизит + "." + Колонка.Имя;
		НовыйЭлемент.Ширина = 10;
		
		НовыйЭлемент.ТолькоПросмотр = ТолькоПросм;
		
		Если Колонка.Имя = "ПСЦ" Тогда
			НовыйЭлемент.УстановитьДействие("НачалоВыбора","ПСЦНачалоВыбора");
		КонецЕсли;
		Если Колонка.Имя = "СтавкаСНППредставление" Тогда
			НовыйЭлемент.УстановитьДействие("НачалоВыбора","СтавкаСНППредставлениеНачалоВыбора");
		КонецЕсли;
		Если Колонка.Имя = "ПунктОкончательнойСдачиСписок" Тогда
			НовыйЭлемент.УстановитьДействие("НачалоВыбора","ПунктОкончательнойСдачиСписокНачалоВыбора");
		КонецЕсли;
		НовыйЭлемент.Заголовок = Колонка.Заголовок;
		Если Колонка.Имя = "Контрагент" ИЛИ Колонка.Имя = "СтавкаСНП" ИЛИ Колонка.Имя = "ПСЦ" Тогда
			НовыйЭлемент.Видимость = Ложь;
		КонецЕсли;
		
		
		Если Колонка.Имя = "Договор" Тогда
			НовыйМассивПараметров = Новый Массив();
			НовыйМассивПараметров.Добавить(Новый СвязьПараметраВыбора("Отбор.Владелец", "Элементы."+ИмяТблЭлементФормы+".ТекущиеДанные.Контрагент"));
			НовыйЭлемент.СвязиПараметровВыбора = Новый ФиксированныйМассив(НовыйМассивПараметров);
		КонецЕсли;
		
		Если Колонка.Имя = "КлиентПередислокация_Договор" Тогда
			НовыйМассивПараметров = Новый Массив();
			НовыйМассивПараметров.Добавить(Новый СвязьПараметраВыбора("Отбор.Владелец", "Элементы."+ИмяТблЭлементФормы+".ТекущиеДанные.КлиентПередислокация_Клиент"));
			НовыйЭлемент.СвязиПараметровВыбора = Новый ФиксированныйМассив(НовыйМассивПараметров);
		КонецЕсли;
		
		Если Колонка.Имя = "КлиентПередислокация_ПСЦ" Тогда
			НовыйМассивПараметров = Новый Массив();
			НовыйМассивПараметров.Добавить(Новый СвязьПараметраВыбора("Отбор.Договор", "Элементы."+ИмяТблЭлементФормы+".ТекущиеДанные.КлиентПередислокация_Договор"));
			НовыйЭлемент.СвязиПараметровВыбора = Новый ФиксированныйМассив(НовыйМассивПараметров);
		КонецЕсли;

		Если Колонка.Имя = "СледующийСток" Тогда
			НовыйМассивПараметров = Новый Массив();
			НовыйМассивПараметров.Добавить(Новый СвязьПараметраВыбора("Отбор.Родитель", "Элементы."+ИмяТблЭлементФормы+".ТекущиеДанные.Направление"));
			НовыйЭлемент.СвязиПараметровВыбора = Новый ФиксированныйМассив(НовыйМассивПараметров);
		КонецЕсли;
		
		НовСтрЭФ = СписокЭФ.Добавить();
		НовСтрЭФ.ТекЭлемент = ИмяКолонкиЭлементФормы;
	КонецЦикла;
	
	ТаблицаПолейВыбора.УстановитьДействие("ПриИзменении","ВыполнитьДействиеПриИзмененииДанных");
	ТаблицаПолейВыбора.УстановитьДействие("ПриНачалеРедактирования","ВыполнитьДействиеПриНачалеРедактирования");
	ТаблицаПолейВыбора.УстановитьДействие("ПередОкончаниемРедактирования","ВыполнитьДействиеПередОкончаниемРедактирования");
	ТаблицаПолейВыбора.УстановитьДействие("ПослеУдаления","ВыполнитьДействиеПослеУдаления");
	ТаблицаПолейВыбора.УстановитьДействие("ПередУдалением","ВыполнитьДействиеПередУдалением");
	ЗначениеВРеквизитФормы(ТЗ, ИмяТблРеквизит);
	
	// условное оформление: желтый цвет фона для КТК в статусе На подходе
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяТблЭлементФормы);
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяТблРеквизит+".Статус");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.СтатусыКТК.НаПодходе;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.БледноЗеленый);
	// -
	
	НовыйЭлемент1.Заголовок = Строка(НовыйКонтрагент) + " (" + Строка(ТЗ.Итог("КоличествоБНКонтейнеров"))+ ")";
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницы.ПодчиненныеЭлементы[ИмяТекСтраницы];
	
КонецПроцедуры

&НаКлиенте
Процедура СтокПриИзменении(Элемент)
	
	// очищать информацию в ТЧ контейнеры, поскольку оттуда она берется для динамического формирования закладок
	Объект.Контейнеры.Очистить();
	
	ОбщаяИнформацияПоКТК();
	УдалитьСтарыеЭлементы();
	//ДобавитьДанныеВТблКонт();
	СоздатьНовыеЭлементыФормы(Истина);
КонецПроцедуры

&НаСервере
Процедура УдалитьСтарыеЭлементы()
	
	Для каждого ЭлементФ Из СписокЭФ Цикл
		Попытка
			Элементы.Удалить(Элементы.Найти(ЭлементФ.ТекЭлемент));
		Исключение
		КонецПопытки;
	КонецЦикла;
	СписокЭФ.Очистить();
	
КонецПроцедуры

