&НаСервереБезКонтекста
Функция ПолучитьСтруктуруПСЦ(ПСЦ)
	
	ЕИ = неопределено;
	НормативнаяСтавкаВСутки = ПСЦ.НормативнаяСтавкаВСутки;
	Валюта = ПСЦ.Валюта;
	СтавкаНДС = ПСЦ.СтавкаНДС;
	СуммаВключаетНДС = ПСЦ.СуммаВключаетНДС;
	НевозвратКонтейнераСуммаНеустойкиВСутки = ПСЦ.НевозвратКонтейнераСуммаНеустойкиВСутки;
	
	
	Если ПСЦ.ПСЦПоставщика_контейнерыВРП.Количество() > 0 Тогда
		ЕИ = ПСЦ.ПСЦПоставщика_контейнерыВРП[0].ЕИ;
		НормативнаяСтавкаВСутки = ПСЦ.ПСЦПоставщика_контейнерыВРП[0].Ставка1;
		Валюта = ПСЦ.ПСЦПоставщика_контейнерыВРП[0].Валюта1;
		СтавкаНДС = ПСЦ.ПСЦПоставщика_контейнерыВРП[0].НДС1;
		СуммаВключаетНДС = ПСЦ.ПСЦПоставщика_контейнерыВРП[0].НДС1;
		НевозвратКонтейнераСуммаНеустойкиВСутки = ПСЦ.ПСЦПоставщика_контейнерыВРП[0].СтоимостьСНП1;
		ГородВозврата = ПСЦ.ПСЦПоставщика_контейнерыВРП[0].ГородВозврата1.Получить();
	КонецЕсли;
	Если ПСЦ.ПСЦПоставщика_контейнерыЭкспорт.Количество() > 0 Тогда
		ЕИ = ПСЦ.ПСЦПоставщика_контейнерыЭкспорт[0].ЕИ;
		НормативнаяСтавкаВСутки = ПСЦ.ПСЦПоставщика_контейнерыЭкспорт[0].Ставка1;
		Валюта = ПСЦ.ПСЦПоставщика_контейнерыЭкспорт[0].Валюта1;
		СтавкаНДС = ПСЦ.ПСЦПоставщика_контейнерыЭкспорт[0].НДС1;
		СуммаВключаетНДС = ПСЦ.ПСЦПоставщика_контейнерыЭкспорт[0].НДС1;
		НевозвратКонтейнераСуммаНеустойкиВСутки = ПСЦ.ПСЦПоставщика_контейнерыЭкспорт[0].СтоимостьСНП1;
		ГородВозврата = ПСЦ.ПСЦПоставщика_контейнерыЭкспорт[0].ГородВозврата1.Получить();
	КонецЕсли;
	
	Возврат Новый Структура("Ставка,ЕдиницаИзмерения,Валюта,СтавкаНДС,НДСВключая,СтавкаСНП,ПунктОкончательнойСдачиСписок", НормативнаяСтавкаВСутки, ЕИ, Валюта, СтавкаНДС, СуммаВключаетНДС, НевозвратКонтейнераСуммаНеустойкиВСутки,ГородВозврата);
	
КонецФункции

