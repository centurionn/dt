	ТекД = Элементы[ТабЗначИмя].ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("СтоимостьСНПТаблица", ТекД.СтавкаСНПТаблица);
	//Если ЗначениеЗаполнено(ТекД.ПСЦ) Тогда
	СтруктураПараметров.Вставить("ТолькоПросмотр", Ложь);
	//Иначе
	//	СтруктураПараметров.Вставить("ТолькоПросмотр", Истина);
	//КонецЕсли;
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаСНП", ЭтаФорма, ТекД);
