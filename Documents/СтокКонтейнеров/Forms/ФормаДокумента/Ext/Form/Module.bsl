		//ПараметрыОтбора.Вставить("Контейнер",ТекД.Контейнер);
		//ПараметрыОтбора.Вставить("Контрагент",ТекД.Контрагент);
		//ПараметрыОтбора.Вставить("Направление",ТекД.Направление);
		//ПараметрыОтбора.Вставить("Статус",ТекД.Статус);
		//
		//УдалитьСтрокуНаСервере(ИмяТблДляУдаления,ПараметрыОтбора);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокуНаСервере(ИмяТбл,ПараметрыОтбора)
	
    ТЗ = РеквизитФормыВЗначение(ИмяТбл);
	НайденныеСтроки = ТЗ.НайтиСтроки(ПараметрыОтбора);
	Для Каждого Стр Из НайденныеСтроки Цикл
		ТЗ.Удалить(Стр);
	КонецЦикла;
	// обработанную ТЗ обратно на форму
