&НаСервере
Процедура УдалитьТекКонтрагентаНаСервере()
	
	ИмяЗакладки = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	ТекКонтраг = СтрЗаменить(ИмяЗакладки,"Страница","");
	
	//необходимо удалить старые программно созданные реквизиты
	МассивУдаляемыхРеквизитовФормы = новый Массив;
	Для каждого Стр из ЭтаФорма.ПолучитьРеквизиты() Цикл
		ПутьКДан = ?(ЗначениеЗаполнено(Стр.Путь),Строка(Стр.Путь)+".","");
		Если СтрНайти(Стр.Имя,ТекКонтраг) тогда 
			МассивУдаляемыхРеквизитовФормы.Добавить(Строка(ПутьКДан) + Стр.Имя); 
		КонецЕсли;
	КонецЦикла;
	ИзменитьРеквизиты(,МассивУдаляемыхРеквизитовФормы);
	МассивУдаляемыхРеквизитовФормы.Очистить();	
	
	Для каждого ЭлементФ Из СписокЭФ Цикл
		Если СтрНайти(ЭлементФ.ТекЭлемент,ТекКонтраг) тогда
			Попытка
				Элементы.Удалить(Элементы.Найти(ЭлементФ.ТекЭлемент));
				СписокЭФ.Удалить(ЭлементФ);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// по всем таблицам формы сделать цикл и заполнить таблицу Контейнеры
	ТекущийОбъект.Контейнеры.Очистить();
	
	Для Каждого Реквизит Из ЭтаФорма.ПолучитьРеквизиты() Цикл
		Если СтрНачинаетсяС(Реквизит.Имя,"Тбл") Тогда
			Для Каждого Стр Из ЭтаФорма[Реквизит.Имя] Цикл
				// строки с нулевым количеством контейнеров не записывать
				Если Стр.КоличествоБНКонтейнеров = 0 Тогда
					Продолжить;
				КонецЕсли;
				НовСтр = ТекущийОбъект.Контейнеры.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр,Стр);
				НовСтр.ПунктОкончательнойСдачи = Новый ХранилищеЗначения(Стр.ПунктОкончательнойСдачиСписок);
				НовСтр.СтавкаСНПХранилище = Новый ХранилищеЗначения(ОбщегоНазначения.ТаблицаЗначенийВМассив(Стр.СтавкаСНПТаблица.Выгрузить()));
				НовСтр.СтавкаСНП = ?(ТипЗнч(Стр.СтавкаСНППредставление) = Тип("Число"),Стр.СтавкаСНППредставление,0);
				// контрагента записываем по наименованию страницы
				НовСтр.Контрагент = Справочники.Контрагенты.НайтиПоКоду(СтрЗаменить(Реквизит.Имя,"Тбл",""));
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	ОбщаяИнформацияПоКТК();
	
КонецПроцедуры

&НаКлиенте
Процедура СтавкаСНППредставлениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	КодКонтрагента = СтрЗаменить(Элемент.Имя,"СтавкаСНППредставление","");
	
