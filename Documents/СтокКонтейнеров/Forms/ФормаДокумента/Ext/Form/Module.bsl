&НаКлиенте
Процедура ЗаполнитьВыбранныеСтрокиПоТекущей(Команда)
	
	// работаем с текущей закладкой
	ТекЗакладка = Элементы.ГруппаСтраницы.ТекущаяСтраница;
	Для каждого Элем Из ТекЗакладка.ПодчиненныеЭлементы Цикл
		// нахоим на закладке подчиненный элемент - таблицу
		Если СтрНачинаетсяС(Элем.Имя,"ТЗН") Тогда
			ВыделенСтр = Элементы[Элем.Имя].ВыделенныеСтроки;
			Если ВыделенСтр.Количество() = 0 Тогда
				Возврат;
			КонецЕсли;
			ТекКолонка = Элементы[Элем.Имя].ТекущийЭлемент.Имя;
			ТекСтрока = Элементы[Элем.Имя].ТекущиеДанные;
			// работаем только со столбцами контрагент и направление
			Если СтрНачинаетсяС(ТекКолонка,"ТипКонтейнера") Тогда
				ИмяКолонкиТЗ = "ТипКонтейнера";
			ИначеЕсли СтрНачинаетсяС(ТекКолонка,"Направление") Тогда
				ИмяКолонкиТЗ = "Направление";
			Иначе
				ИмяКолонкиТЗ = "";
			КонецЕсли;
			Если ИмяКолонкиТЗ = "" Тогда
				Возврат;
			КонецЕсли;
			// получаем эталонное значение, которым будем заполнять все строки
			// за эталонное значение принимаем первую выделенную строку
			Эталон = ТекСтрока[ИмяКолонкиТЗ];
			ТекТбл = СтрЗаменить(Элем.Имя,"ТЗН","Тбл");
			Для Каждого Стр Из ВыделенСтр Цикл
				ТекСтр = ЭтаФорма[ТекТбл].НайтиПоИдентификатору(Стр);
				ТекСтр[ИмяКолонкиТЗ] = Эталон;
			КонецЦикла;
			
			Прервать;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВыбранныеПоСправочнику(Команда)
	
	Перем ВыбЗнач;
	
	// работаем с текущей закладкой
	ТекЗакладка = Элементы.ГруппаСтраницы.ТекущаяСтраница;
	Для каждого Элем Из ТекЗакладка.ПодчиненныеЭлементы Цикл
		// нахоим на закладке подчиненный элемент - таблицу
		Если СтрНачинаетсяС(Элем.Имя,"ТЗН") Тогда
			ВыделенСтр = Элементы[Элем.Имя].ВыделенныеСтроки;
			Если ВыделенСтр.Количество() = 0 Тогда
				Возврат;
			КонецЕсли;
			ТекКолонка = Элементы[Элем.Имя].ТекущийЭлемент.Имя;
			// работаем только со столбцами контрагент и направление
			Если СтрНачинаетсяС(ТекКолонка,"ТипКонтейнера") Тогда
				ИмяКолонкиТЗ = "ТипКонтейнера";
				ОписаниеТипов = Новый ОписаниеТипов("СправочникСсылка.ТипоразмерыТЕ");
			ИначеЕсли СтрНачинаетсяС(ТекКолонка,"Направление") Тогда
				ИмяКолонкиТЗ = "Направление";
				ОписаниеТипов = Новый ОписаниеТипов("СправочникСсылка.Локации");
			Иначе
				Продолжить;
			КонецЕсли;
			
			ТекТбл = СтрЗаменить(Элем.Имя,"ТЗН","Тбл");
			// выбрать эталонное значение, которым будем заполнять все строки
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("ВыделенныеСтроки",ВыделенСтр);
			ПараметрыОтбора.Вставить("ТекТбл",ТекТбл);
			ПараметрыОтбора.Вставить("ИмяКолонкиТЗ",ИмяКолонкиТЗ);
			
			Оповещение = Новый ОписаниеОповещения("ВыполнитьПослеВыбораЗначения",ЭтаФорма,ПараметрыОтбора);
			ПоказатьВводЗначения(Оповещение,ВыбЗнач,"Выберите значение для подстановки",ОписаниеТипов);
			
			Прервать;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте 
Процедура ВыполнитьПослеВыбораЗначения(Результат,ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыделенныеСтроки = ДопПараметры.ВыделенныеСтроки;
	ТекТбл = ДопПараметры.ТекТбл;
	ИмяКолонкиТЗ = ДопПараметры.ИмяКолонкиТЗ;
	Для Каждого Стр Из ВыделенныеСтроки Цикл
		ТекСтр = ЭтаФорма[ТекТбл].НайтиПоИдентификатору(Стр);
		ТекСтр[ИмяКолонкиТЗ] = Результат;
	КонецЦикла;
	
