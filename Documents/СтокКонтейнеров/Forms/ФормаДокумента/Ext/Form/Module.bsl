&НаСервере
Функция ЕстьСледующиеДокументы()
	
	ДатаНовогоРегистратора = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	СтокКонтейнеров.Ссылка КАК Ссылка,
	               |	СтокКонтейнеров.Дата КАК Период
	               |ИЗ
	               |	Документ.СтокКонтейнеров КАК СтокКонтейнеров
	               |ГДЕ
	               |	СтокКонтейнеров.Дата > &Период
	               |	И СтокКонтейнеров.Сток = &Сток
	               |	И НЕ СтокКонтейнеров.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата";
	
	Запрос.УстановитьПараметр("Регистратор", Объект.Ссылка);
	Запрос.УстановитьПараметр("Период", Объект.Дата);
	Запрос.УстановитьПараметр("Сток", Объект.Сток);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
	
		ДатаНовогоРегистратора = Выборка.Период-1;
	
	КонецЦикла;
	
	Возврат ДатаНовогоРегистратора;
	
КонецФункции

&НаСервере
Функция ЕстьПредыдущиеДокументы(СсылкаНаДок=Неопределено)
	
	Если СсылкаНаДок = Неопределено Тогда
		ТекОб = Объект;
	Иначе
		ТекОб = СсылкаНаДок;
	КонецЕсли; 
	
	ДатаНовогоРегистратора = Дата(1,1,1,0,0,0);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	КонтейнерыВСтокахОстаткиИОбороты.Контейнер КАК Контейнер,
	               |	КонтейнерыВСтокахОстаткиИОбороты.Сток КАК Сток,
	               |	КонтейнерыВСтокахОстаткиИОбороты.Назначение КАК Назначение,
	               |	КонтейнерыВСтокахОстаткиИОбороты.Контрагент КАК Контрагент,
	               |	КонтейнерыВСтокахОстаткиИОбороты.ДатаПриемаВСток КАК ДатаПриемаВСток,
	               |	КонтейнерыВСтокахОстаткиИОбороты.СрокВозврата КАК СрокВозврата,
	               |	КонтейнерыВСтокахОстаткиИОбороты.Регистратор КАК Регистратор,
	               |	КонтейнерыВСтокахОстаткиИОбороты.Период КАК Период
	               |ИЗ
	               |	РегистрНакопления.КонтейнерыВСтоках.ОстаткиИОбороты(, &Период, Регистратор, , Контейнер В (&СписокКТ)) КАК КонтейнерыВСтокахОстаткиИОбороты
	               |ГДЕ
	               |	КонтейнерыВСтокахОстаткиИОбороты.Регистратор <> &Регистратор
	               |	И КонтейнерыВСтокахОстаткиИОбороты.Сток = &Сток
	               |	И КонтейнерыВСтокахОстаткиИОбороты.Регистратор ССЫЛКА Документ.СтокКонтейнеров
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период УБЫВ";
	Запрос.УстановитьПараметр("Регистратор", ТекОб.Ссылка);
	Запрос.УстановитьПараметр("Период", ?(ЗначениеЗаполнено(ТекОб.Дата), ТекОб.Дата-1, ТекОб.Дата) );
	Запрос.УстановитьПараметр("Сток", ТекОб.Сток);
	Запрос.УстановитьПараметр("СписокКТ", ТекОб.Контейнеры.Выгрузить().ВыгрузитьКолонку("Контейнер"));
	Ответ = Запрос.Выполнить().Выбрать();
	
	Пока Ответ.Следующий() Цикл
	
		ДатаНовогоРегистратора = Ответ.Период+1;
	
	КонецЦикла; 
	
	Возврат ДатаНовогоРегистратора;
	
КонецФункции

&НаСервере
Процедура СоздатьНовыеЭлементыФормы(СоздатьНовыйСток) // ДатаПоследнегоРегистратора,ДатаПредыдущегоРегистратора,
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтейнерыВСтокахОстатки.Сток КАК Сток,
	               |	КонтейнерыВСтокахОстатки.Контрагент КАК Контрагент,
	               |	КонтейнерыВСтокахОстатки.Контейнер КАК Контейнер,
	               |	ЗНАЧЕНИЕ(Перечисление.СтатусыКТК.Свободен) КАК Статус,
	               |	КонтейнерыВСтокахОстатки.КоличествоОстаток КАК КоличествоБНКонтейнеров,
	               |	КонтейнерыВСтокахОстатки.ДатаПриемаВСток КАК ДатаПриемаВСток,
	               |	КонтейнерыВСтокахОстатки.СрокВозврата КАК СрокВозврата,
	               |	КонтейнерыВСтокахОстатки.Назначение КАК Направление,
	               |	NULL КАК КлиентПередислокация_Клиент,
	               |	NULL КАК КлиентПередислокация_Договор,
	               |	NULL КАК КлиентПередислокация_ПСЦ,
	               |	NULL КАК ДатаПриемаВПользованиеПередПоставщиком,
	               |	NULL КАК ДатаСдачиКТКПоставщику,
	               |	NULL КАК ДатаВзятияИзСтока,
	               |	NULL КАК Договор
	               |ПОМЕСТИТЬ СтатусыКТК
	               |ИЗ
	               |	РегистрНакопления.КонтейнерыВСтоках.Остатки(&ДатаКон, Сток = &Сток) КАК КонтейнерыВСтокахОстатки
	               |ГДЕ
	               |	КонтейнерыВСтокахОстатки.Контейнер ССЫЛКА Справочник.ТипоразмерыТЕ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СтокКонтейнеровКонтейнеры.Ссылка.Сток,
	               |	СтокКонтейнеровКонтейнеры.Контрагент,
	               |	СтокКонтейнеровКонтейнеры.Контейнер,
	               |	СтатусыКТКСрезПоследних.Статус,
	               |	СтокКонтейнеровКонтейнеры.КоличествоБНКонтейнеров,
	               |	СтокКонтейнеровКонтейнеры.ДатаПриемаВСток,
	               |	СтокКонтейнеровКонтейнеры.СрокВозврата,
	               |	СтатусыКТКСрезПоследних.Направление,
	               |	СтокКонтейнеровКонтейнеры.КлиентПередислокация_Клиент,
	               |	СтокКонтейнеровКонтейнеры.КлиентПередислокация_Договор,
	               |	СтокКонтейнеровКонтейнеры.КлиентПередислокация_ПСЦ,
	               |	СтокКонтейнеровКонтейнеры.ДатаПриемаВПользованиеПередПоставщиком,
	               |	СтокКонтейнеровКонтейнеры.ДатаСдачиКТКПоставщику,
	               |	СтокКонтейнеровКонтейнеры.ДатаПриемаВСток,
	               |	СтокКонтейнеровКонтейнеры.Договор
	               |ИЗ
	               |	Документ.СтокКонтейнеров.Контейнеры КАК СтокКонтейнеровКонтейнеры
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыКТК.СрезПоследних(&ДатаКон, Сток = &Сток) КАК СтатусыКТКСрезПоследних
	               |		ПО СтокКонтейнеровКонтейнеры.Контейнер = СтатусыКТКСрезПоследних.Контейнер
	               |ГДЕ
	               |	СтатусыКТКСрезПоследних.Контейнер ССЫЛКА Справочник.ТЕ
	               |	И СтокКонтейнеровКонтейнеры.Контейнер ССЫЛКА Справочник.ТЕ
	               |	И СтокКонтейнеровКонтейнеры.Ссылка = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	КонтейнерыВСтокахОстатки.Сток,
	               |	КонтейнерыВСтокахОстатки.Контрагент,
	               |	КонтейнерыВСтокахОстатки.Контейнер,
	               |	ЗНАЧЕНИЕ(Перечисление.СтатусыКТК.Свободен),
	               |	КонтейнерыВСтокахОстатки.КоличествоОстаток,
	               |	КонтейнерыВСтокахОстатки.ДатаПриемаВСток,
	               |	КонтейнерыВСтокахОстатки.СрокВозврата,
	               |	КонтейнерыВСтокахОстатки.Назначение,
	               |	NULL,
	               |	NULL,
	               |	NULL,
	               |	NULL,
	               |	NULL,
	               |	NULL,
	               |	NULL
	               |ИЗ
	               |	РегистрНакопления.КонтейнерыВСтоках.Остатки(&ДатаКон, Сток = &Сток) КАК КонтейнерыВСтокахОстатки
	               |ГДЕ
	               |	КонтейнерыВСтокахОстатки.Контейнер ССЫЛКА Справочник.ТЕ
	               |	И &НовыйОбъект
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СтатусыКТК.Сток КАК Сток,
	               |	СтатусыКТК.Контрагент КАК Контрагент,
	               |	СтатусыКТК.Статус КАК Статус,
	               |	СтатусыКТК.Контейнер КАК Контейнер,
	               |	СУММА(СтатусыКТК.КоличествоБНКонтейнеров) КАК КоличествоБНКонтейнеров,
	               |	СтатусыКТК.ДатаВзятияИзСтока КАК ДатаВзятияИзСтока,
	               |	СтатусыКТК.СрокВозврата КАК СрокВозврата,
	               |	СтатусыКТК.Направление КАК Направление,
	               |	СтатусыКТК.КлиентПередислокация_Клиент КАК КлиентПередислокация_Клиент,
	               |	СтатусыКТК.КлиентПередислокация_Договор КАК КлиентПередислокация_Договор,
	               |	СтатусыКТК.КлиентПередислокация_ПСЦ КАК КлиентПередислокация_ПСЦ,
	               |	СтатусыКТК.ДатаПриемаВСток КАК ДатаПриемаВСток,
	               |	СтатусыКТК.ДатаПриемаВПользованиеПередПоставщиком КАК ДатаПриемаВПользованиеПередПоставщиком,
	               |	СтатусыКТК.ДатаСдачиКТКПоставщику КАК ДатаСдачиКТКПоставщику,
	               |	СтатусыКТК.Договор КАК Договор
	               |ПОМЕСТИТЬ ИтогоПоРС
	               |ИЗ
	               |	СтатусыКТК КАК СтатусыКТК
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СтатусыКТК.Контрагент,
	               |	СтатусыКТК.Статус,
	               |	СтатусыКТК.Контейнер,
	               |	СтатусыКТК.Сток,
	               |	СтатусыКТК.ДатаВзятияИзСтока,
	               |	СтатусыКТК.СрокВозврата,
	               |	СтатусыКТК.Направление,
	               |	СтатусыКТК.КлиентПередислокация_Клиент,
	               |	СтатусыКТК.КлиентПередислокация_Договор,
	               |	СтатусыКТК.КлиентПередислокация_ПСЦ,
	               |	СтатусыКТК.ДатаПриемаВСток,
	               |	СтатусыКТК.ДатаПриемаВПользованиеПередПоставщиком,
	               |	СтатусыКТК.ДатаСдачиКТКПоставщику,
	               |	СтатусыКТК.Договор
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МАКСИМУМ(СтокКонтейнеров.Дата) КАК Дата
	               |ПОМЕСТИТЬ ДатаПослДок
	               |ИЗ
	               |	Документ.СтокКонтейнеров КАК СтокКонтейнеров
	               |ГДЕ
	               |	СтокКонтейнеров.Дата < &ДатаКон
	               |	И СтокКонтейнеров.Проведен
	               |	И СтокКонтейнеров.Сток = &Сток
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СтокКонтейнеровКонтейнеры.Контейнер КАК Контейнер,
	               |	СтокКонтейнеровКонтейнеры.Контрагент КАК Контрагент,
	               |	СтокКонтейнеровКонтейнеры.Ссылка.Сток КАК Сток,
	               |	МАКСИМУМ(СтокКонтейнеровКонтейнеры.Ссылка.Дата) КАК Дата,
	               |	КонтейнерыВСтокахОстатки.КоличествоОстаток КАК КоличествоОстаток,
	               |	СтокКонтейнеровКонтейнеры.ТипКонтейнера КАК ТипКонтейнера
	               |ПОМЕСТИТЬ ПоПредыдущимСтокам
	               |ИЗ
	               |	РегистрНакопления.КонтейнерыВСтоках.Остатки(&ДатаКон, Сток = &Сток) КАК КонтейнерыВСтокахОстатки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СтокКонтейнеров.Контейнеры КАК СтокКонтейнеровКонтейнеры
	               |		ПО КонтейнерыВСтокахОстатки.Контейнер = СтокКонтейнеровКонтейнеры.ТипКонтейнера
	               |			И КонтейнерыВСтокахОстатки.Сток = СтокКонтейнеровКонтейнеры.Ссылка.Сток
	               |			И КонтейнерыВСтокахОстатки.Контрагент = СтокКонтейнеровКонтейнеры.Контрагент
	               |			И (СтокКонтейнеровКонтейнеры.Ссылка.Проведен)
	               |ГДЕ
	               |	&НовыйОбъект
	               |	И КонтейнерыВСтокахОстатки.Контейнер ССЫЛКА Справочник.ТипоразмерыТЕ
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СтокКонтейнеровКонтейнеры.Контейнер,
	               |	СтокКонтейнеровКонтейнеры.Ссылка.Сток,
	               |	СтокКонтейнеровКонтейнеры.Контрагент,
	               |	КонтейнерыВСтокахОстатки.КоличествоОстаток,
	               |	СтокКонтейнеровКонтейнеры.ТипКонтейнера
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СтокКонтейнеровКонтейнеры.Контейнер,
	               |	СтокКонтейнеровКонтейнеры.Контрагент,
	               |	СтокКонтейнеровКонтейнеры.Ссылка.Сток,
	               |	МАКСИМУМ(СтокКонтейнеровКонтейнеры.Ссылка.Дата),
	               |	КонтейнерыВСтокахОстатки.КоличествоОстаток,
	               |	СтокКонтейнеровКонтейнеры.ТипКонтейнера
