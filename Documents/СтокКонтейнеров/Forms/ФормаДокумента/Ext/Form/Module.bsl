&НаКлиенте
Процедура ВставитьИзEXCELпоСтоку(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаДобавленияНомерныхПозицийВСток", ЭтаФорма, Новый Структура("КТК, ПередаватьИсходныеНомера", Истина, Истина));
	ОткрытьФорму("ОбщаяФорма.ВставкаИзБуфераОбмена", Новый Структура("КТК, РазмерКТК, Контрагент, ДатаПриемаВСток, НомерТС, ВодительТС", Истина, Истина, Истина, Истина, Истина, Истина), , ЭтаФорма.УникальныйИдентификатор, ,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаДобавленияНомерныхПозицийВСток(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = Неопределено тогда возврат; КонецЕсли;
	
	// SIV 06-10-20 FIX при добавлении КТК в сток надо удалить их из всех закладок старого документа
	Для каждого ДобКТК из Параметр1.КТК Цикл
		Для каждого ТаблицаКА из ЭтаФорма.ПодчиненныеЭлементы.ГруппаСтраницы.ПодчиненныеЭлементы Цикл
			Если СтрНачинаетсяС(ТаблицаКА.Имя, "Страница") Тогда
				
				ТаблицаЪ = Этаформа["Тбл"+Сред(ТаблицаКА.Имя, 9)];
				
				КУдалению = Новый Массив;
				Для каждого НСтр из ТаблицаЪ Цикл 
					Если НСтр.Контейнер = ДобКТК Тогда ТаблицаЪ.Удалить(НСтр); КонецЕсли;
				КонецЦикла;
				Для каждого Удал из КУдалению Цикл
					ТаблицаЪ.Удалить(Удал);
				КонецЦикла;
				
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	МассивВопросов = ОбработкаДобавленияНомерныхПозицийВСтокНаСервере(Параметр1, Параметр2);
	
	Для каждого Вопрос Из МассивВопросов Цикл
	
		ТекстСообщения = "Контейнеры " + СтрСоединить(Вопрос.МассивКТК, Символы.ПС) + " находятся в другом стоке или у другого контрагента.";
		ОпОп = Новый ОписаниеОповещения("ВопросДействияКТК", ЭтаФорма, Вопрос);
		ПоказатьВопрос(ОпОп, ТекстСообщения + " Перенести в этот сток контрагенту " + Вопрос.Контрагент + "?", РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Нет,, КодВозвратаДиалога.Нет);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ДозаполнятьВыбранныеПозиции(СписокКТК)
	
	ВыбрПозицииСервер = ДозаполнятьВыбранныеПозиции_Сервер(СписокКТК);
	Возврат ВыбрПозицииСервер;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДозаполнятьВыбранныеПозиции_Сервер(СписокКТК)
	
	Результат = Новый Соответствие;
	
	Для каждого КТК из СписокКТК Цикл
		
		СтруктураПараметров = Новый Структура("Договор,СрокВозврата,ДатаПриемаВСток,ЗабратьДо,Направление,СледующийСток,ДатаПриемаВПользованиеПередПоставщиком,КлиентПередислокация_Клиент,КлиентПередислокация_Договор,КлиентПередислокация_ПСЦ,СВВ,ЕдиницаИзмерения,Ставка,Валюта,СтавкаНДС,НДСВключая,СтавкаСНП,ИнструкцииПоСдачеПорожнего,НомерТСПрибытия,ВодительТСПрибытия");
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ТЕ.Ссылка КАК Ссылка,
		               |	ПризнакСобственностиКонтейнераСрезПоследних.Договор КАК Договор,
		               |	СтокКонтейнеровКонтейнеры.СрокВозврата КАК СрокВозврата,
		               |	СтокКонтейнеровКонтейнеры.ДатаПриемаВПользованиеПередПоставщиком КАК ДатаПриемаВПользованиеПередПоставщиком,
		               |	СтокКонтейнеровКонтейнеры.Направление КАК Направление,
		               |	СтокКонтейнеровКонтейнеры.СВВ КАК СВВ,
		               |	СтокКонтейнеровКонтейнеры.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		               |	СтокКонтейнеровКонтейнеры.Ставка КАК Ставка,
		               |	СтокКонтейнеровКонтейнеры.Валюта КАК Валюта,
		               |	СтокКонтейнеровКонтейнеры.СтавкаНДС КАК СтавкаНДС,
		               |	СтокКонтейнеровКонтейнеры.НДСВключая КАК НДСВключая,
		               |	СтокКонтейнеровКонтейнеры.СтавкаСНПХранилище КАК СтавкаСНПХранилище,
		               |	СтокКонтейнеровКонтейнеры.ПунктОкончательнойСдачи КАК ПунктОкончательнойСдачи
		               |ИЗ
		               |	Справочник.ТЕ КАК ТЕ
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакСобственностиКонтейнера.СрезПоследних(, Контейнер В (&Контейнеры)) КАК ПризнакСобственностиКонтейнераСрезПоследних
		               |		ПО ТЕ.Ссылка = ПризнакСобственностиКонтейнераСрезПоследних.Контейнер
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СтокКонтейнеров.Контейнеры КАК СтокКонтейнеровКонтейнеры
		               |		ПО ТЕ.Ссылка = СтокКонтейнеровКонтейнеры.Контейнер
		               |			И (СтокКонтейнеровКонтейнеры.Ссылка В
		               |				(ВЫБРАТЬ
		               |					СтокКонтейнеров.Ссылка КАК Ссылка
		               |				ИЗ
		               |					Документ.СтокКонтейнеров КАК СтокКонтейнеров
		               |						ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		               |							МАКСИМУМ(СтокКонтейнеров.Дата) КАК Дата,
		               |							СтокКонтейнеров.Сток КАК Сток
		               |						ИЗ
		               |							Документ.СтокКонтейнеров КАК СтокКонтейнеров
		               |						СГРУППИРОВАТЬ ПО
		               |							СтокКонтейнеров.Сток) КАК ВложенныйЗапрос
		               |						ПО
		               |							СтокКонтейнеров.Сток = ВложенныйЗапрос.Сток
		               |								И СтокКонтейнеров.Дата = ВложенныйЗапрос.Дата))
		               |ГДЕ
		               |	ТЕ.Ссылка В(&Контейнеры)";
		Запрос.УстановитьПараметр("Контейнеры", КТК);
		Ответ = Запрос.Выполнить().Выбрать();
		Пока Ответ.Следующий() Цикл
			
			ЗаполнитьЗначенияСвойств(СтруктураПараметров, Ответ);
			
		КонецЦикла;
		
		Результат.Вставить(КТК, СтруктураПараметров);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДополнительныеДанныеКонтейнера(КТК, Период)
	
	Результат = Новый Структура("ДатаПриемаВСток, Договор, ИнструкцииПоСдачеПорожнего, ПунктОкончательнойСдачиСписок", Дата("00010101"), неопределено, "", Новый СписокЗначений);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПризнакСобственностиКонтейнераСрезПоследних.Договор КАК Договор,
	               |	ПризнакСобственностиКонтейнераСрезПоследних.ДокументРегистратор КАК ДокументРегистратор
	               |ИЗ
	               |	РегистрСведений.ПризнакСобственностиКонтейнера.СрезПоследних(&Период, Контейнер = &Контейнер) КАК ПризнакСобственностиКонтейнераСрезПоследних";
	Запрос.УстановитьПараметр("Контейнер", КТК);
	Запрос.УстановитьПараметр("Период", Период);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		
		Результат.Договор = Ответ.Договор;
		
		НайдСтроки = Ответ.ДокументРегистратор.РегистрацияНовыхКонтейнеров.НайтиСтроки(Новый Структура("КонтейнерСсылка", КТК));
		Если НайдСтроки.Количество() > 0 Тогда
			
			Результат.ДатаПриемаВСток = НайдСтроки[0].ДатаВводаВЭксплуатацию;
			Результат.ИнструкцииПоСдачеПорожнего = НайдСтроки[0].ИнструкцииПоСдаче;
			Если ЗначениеЗаполнено(НайдСтроки[0].ЛокацияВозврата) Тогда Результат.ПунктОкончательнойСдачиСписок.Добавить(НайдСтроки[0].ЛокацияВозврата); КонецЕсли;
			Если ЗначениеЗаполнено(НайдСтроки[0].СтокВозврата) Тогда Результат.ПунктОкончательнойСдачиСписок.Добавить(НайдСтроки[0].СтокВозврата); КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ОбработкаДобавленияНомерныхПозицийВСтокНаСервере(Параметр1, Параметр2)

	МассивВопросов = Новый массив;
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Контейнер",Новый ОписаниеТипов("СправочникСсылка.ТЕ"));
	ТЗ.Колонки.Добавить("ТипКонтейнера",Новый ОписаниеТипов("СправочникСсылка.ТипоразмерыТЕ"),"Тип контейнера");
	ТЗ.Колонки.Добавить("Контрагент",Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТЗ.Колонки.Добавить("ДатаПриемаВСток",Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)),"Дата приема в сток");
	ТЗ.Колонки.Добавить("ВремяПрибытияНаТерминалОтпр",Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)),"Прибытие на терминал отпр.");
	ТЗ.Колонки.Добавить("ДатаВзятияИзСтока",Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)),"Дата взятия из стока");
	ТЗ.Колонки.Добавить("НомерТСПрибытия",Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)),"Номер ТС Прибытия");
	ТЗ.Колонки.Добавить("ВодительТСПрибытия",Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(150)),"Водитель ТС Прибытия");

	ТЗ.Колонки.Добавить("Договор",Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
	ТЗ.Колонки.Добавить("ИнструкцииПоСдачеПорожнего",Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));	
	ТЗ.Колонки.Добавить("ПунктОкончательнойСдачиСписок",Новый ОписаниеТипов("СписокЗначений"));	
	
	Для ШагЦикла = 0 По Параметр1.КТК.Количество()-1 Цикл
		НСтрока = ТЗ.Добавить();
		НСтрока.Контейнер					= Параметр1.КТК[ШагЦикла];
		НСтрока.ТипКонтейнера				= Параметр1.РазмерКТК[ШагЦикла];
		НСтрока.Контрагент					= Параметр1.Контрагент[ШагЦикла];
		НСтрока.ДатаПриемаВСток				= Параметр1.ДатаПриемаВСток[ШагЦикла];
		НСтрока.ДатаВзятияИзСтока			= Параметр1.ДатыКТК[ШагЦикла];
		НСтрока.НомерТСПрибытия				= Параметр1.НомерТС[ШагЦикла];
		НСтрока.ВремяПрибытияНаТерминалОтпр	= Параметр1.ДатыПрибытияНаТерм[ШагЦикла];
		НСтрока.НомерТСПрибытия				= Параметр1.НомерТС[ШагЦикла];
		НСтрока.ВодительТСПрибытия			= Параметр1.ВодительТС[ШагЦикла];
		
		ДопПараметрыКТК = ДополнительныеДанныеКонтейнера(НСтрока.Контейнер, ТекущаяДата());
		
		НСтрока.Договор = ДопПараметрыКТК.Договор;
		Если ЗначениеЗаполнено(ДопПараметрыКТК.ДатаПриемаВСток) Тогда НСтрока.ДатаПриемаВСток = ДопПараметрыКТК.ДатаПриемаВСток; КонецЕсли;
		НСтрока.ИнструкцииПоСдачеПорожнего = ДопПараметрыКТК.ИнструкцииПоСдачеПорожнего;
		НСтрока.ПунктОкончательнойСдачиСписок.ЗагрузитьЗначения(ДопПараметрыКТК.ПунктОкончательнойСдачиСписок.ВыгрузитьЗначения());
		
	КонецЦикла;
	ТЗКонтрагентов = ТЗ.Скопировать(,"Контрагент");
	ТЗКонтрагентов.Свернуть("Контрагент");
	
	Для каждого Контрагент Из ТЗКонтрагентов Цикл
		СозданиеЗакладки(Контрагент.Контрагент, Ложь);
		ИмяЗакладки = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
		ИДКонтрагента = Сред(ИмяЗакладки, 9);
		ТаблицаФормы = ЭтаФорма["Тбл"+ИДКонтрагента];
		
		СтрокиПоКонтрагенту = ТЗ.НайтиСтроки(Новый Структура("Контрагент", Контрагент.Контрагент));
		МассивКТК = Новый Массив;
		Для каждого Строка Из СтрокиПоКонтрагенту Цикл
			МассивКТК.Добавить(Строка.Контейнер);
		КонецЦикла; 
		// надо проверить, что указанный КТК 
		// 1. не зарезервирован ранее
		// 2. если НЕ зарезервирован (свободен) В ДРУГОМ стоке, то спросить у пользователя, что делать с этим КТК.
		МассивСтруктурКТК = ПолучитьСпорныеКТК(МассивКТК, Объект.Сток, ИДКонтрагента);
		// в таблицу "молча" добавляем только те КТК, которых нет в элементе структуры СтруктураКТК
		// если ктк есть в структуре, то нужно проверить причину, почему он там и задать пользователю вопрос, что делать с этим КТК дальше.
		МассивКТКДляВопроса = Новый массив;
		МассивТипКонтейнераВопрос = Новый Массив;
		МассивДатаПриемаВСтокВопрос = Новый массив;
		МассивВремяПрибытияНаТерминалОтпрВопрос = Новый массив;
		МассивДатаВзятияИзСтокаВопрос = Новый массив;
		МассивНомерТСПрибытияВопрос = Новый массив;
		МассивВодительТСПрибытияВопрос = Новый массив;
		Для каждого Строка Из СтрокиПоКонтрагенту Цикл
			НеПишем = Ложь;
			Для Каждого Эл Из МассивСтруктурКТК Цикл
				Если Эл.Контейнер = Строка.Контейнер Тогда
					НеПишем = Истина;
					МассивКТКДляВопроса.Добавить(Строка.Контейнер);
					МассивТипКонтейнераВопрос.Добавить(Строка.ТипКонтейнера);
					МассивДатаПриемаВСтокВопрос.Добавить(Строка.ДатаПриемаВСток);
					МассивВремяПрибытияНаТерминалОтпрВопрос.Добавить(Строка.ВремяПрибытияНаТерминалОтпр);
					МассивДатаВзятияИзСтокаВопрос.Добавить(Строка.ДатаВзятияИзСтока);
					МассивНомерТСПрибытияВопрос.Добавить(Строка.НомерТСПрибытия);
					МассивВодительТСПрибытияВопрос.Добавить(Строка.ВодительТСПрибытия);
				КонецЕсли;
			КонецЦикла;
			
			Если НеПишем ИЛИ ТаблицаФормы.НайтиСтроки(Новый Структура("Контейнер", Строка.Контейнер)).Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НСтр = ТаблицаФормы.Добавить();
			ЗаполнитьЗначенияСвойств(НСтр, Строка);
			НСтр.КоличествоБНКонтейнеров = 1;
			НСтр.Статус = Перечисления.СтатусыКТК.Свободен;
			
		КонецЦикла;
		
		Если ТаблицаФормы.Количество()>0 Тогда
			ЭтаФорма.Элементы["КМЗаполнитьПоТекСтр" + Строка(ИДКонтрагента)].Доступность = Истина;
			ЭтаФорма.Элементы["КМЗаполнитьПоСпр" + Строка(ИДКонтрагента)].Доступность = Истина;
			ЭтаФорма.Элементы["КПЗаполнитьПоТекСтр" + Строка(ИДКонтрагента)].Доступность = Истина;
			ЭтаФорма.Элементы["КПЗаполнитьПоСпр" + Строка(ИДКонтрагента)].Доступность = Истина;
		Иначе
			ЭтаФорма.Элементы["КМЗаполнитьПоТекСтр" + Строка(ИДКонтрагента)].Доступность = Ложь;
			ЭтаФорма.Элементы["КМЗаполнитьПоСпр" + Строка(ИДКонтрагента)].Доступность = Ложь;
			ЭтаФорма.Элементы["КПЗаполнитьПоТекСтр" + Строка(ИДКонтрагента)].Доступность = Ложь;
			ЭтаФорма.Элементы["КПЗаполнитьПоСпр" + Строка(ИДКонтрагента)].Доступность = Ложь;
		КонецЕсли;
		
		// если есть КТК, которые находятся не в этом стоке или не у этого контрагента
		Если МассивКТКДляВопроса.Количество()>0 Тогда
			
			ПараметрыДействия = Новый Структура;
			ПараметрыДействия.Вставить("ИмяТбл","Тбл"+ИДКонтрагента);
			ПараметрыДействия.Вставить("ИДКонтрагента",ИДКонтрагента);
			ПараметрыДействия.Вставить("МассивКТК",МассивКТКДляВопроса);
			ПараметрыДействия.Вставить("МассивРазмеровКТК",МассивТипКонтейнераВопрос);
			ПараметрыДействия.Вставить("МассивДат",МассивДатаВзятияИзСтокаВопрос);
			ПараметрыДействия.Вставить("МасДатПрибТерм",МассивВремяПрибытияНаТерминалОтпрВопрос);
			ПараметрыДействия.Вставить("МассивДатаПриемаВСток",МассивДатаПриемаВСтокВопрос);
			ПараметрыДействия.Вставить("МассивНомерТСПрибытия",МассивНомерТСПрибытияВопрос);
			ПараметрыДействия.Вставить("МассивВодительТСПрибытия",МассивВодительТСПрибытияВопрос);
			ПараметрыДействия.Вставить("МассивСтруктурКТК",МассивСтруктурКТК);
			ПараметрыДействия.Вставить("ДобавлениеЧерезФорму",Истина);
			ПараметрыДействия.Вставить("Контрагент",Строка.Контрагент);
			
			МассивВопросов.Добавить(ПараметрыДействия);
		КонецЕсли;	
		
	КонецЦикла; 
	
	Возврат МассивВопросов;
	
КонецФункции // ОбработкаДобавленияНомерныхПозицийВСтокНаСервере()

