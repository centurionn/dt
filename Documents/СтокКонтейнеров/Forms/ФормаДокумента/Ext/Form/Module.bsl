
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЭтаФорма.ТолькоПросмотр = ТолькоПросмотрЪ;
	Элементы.ФормаДобавитьВладельца.Доступность = НЕ ТолькоПросмотрЪ;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() И не Параметры.Свойство("Сток") Тогда
		Возврат;
	КонецЕсли;
	
	// если получили в результате функции дату, то есть заявки до даты этого стока
	//ДатаПредыдущегоРегистратора = ЕстьПредыдущиеДокументы();
	// если получили в результате функции дату, то есть документы после этого стока
	ДатаПоследнегоРегистратора = ЕстьСледующиеДокументы();
	Если ДатаПоследнегоРегистратора = "" Тогда
		ТолькоПросмотрЪ = Ложь;
		ДатаПоследнегоРегистратора = ТекущаяДата();
	Иначе
		ТолькоПросмотрЪ = Истина;
	КонецЕсли;
	
	Если Параметры.Свойство("Сток") Тогда
		Объект.Сток = Параметры.Сток;
		// найти последний документ Сток контейнеров (с максимальной датой) по данному стоку, чтобы для него вычислить 
		// ДатаПредыдущегоРегистратора, т.к. у вновь создаваемого документа еще нет ссылки и ф-ция  ЕстьПредыдущиеДокументы()
		// вернет пустую дату => будут задвоения по остаткам контейнеров
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	СтокКонтейнеров.Ссылка КАК Ссылка
		               |ИЗ
		               |	Документ.СтокКонтейнеров КАК СтокКонтейнеров
		               |ГДЕ
		               |	СтокКонтейнеров.Сток = &Сток
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	СтокКонтейнеров.Дата УБЫВ";
		Запрос.УстановитьПараметр("Сток",Параметры.Сток);
		ТЗ = Запрос.Выполнить().Выгрузить();
		Если ТЗ.Количество()>0 Тогда
			СсылкаНаДок = ТЗ[0].Ссылка;
			//ДатаПредыдущегоРегистратора = ЕстьПредыдущиеДокументы(СсылкаНаДок);
		КонецЕсли;
		Объект.Контейнеры.Загрузить(СсылкаНаДок.Контейнеры.Выгрузить());
	КонецЕсли;
	
	ОбщаяИнформацияПоКТК();
		
	// создавать элементы по регистру только если по данному стоку нет более свежих регистраторов (Сток контейнеров)
	// в другом случае заполнять закладки по ТЧ Контейнеры (исторические данные) и запрещать их редактирование
	// Данные по наличию предыдущего регистратора нужны, чтобы в списке зарезервированных КТК не показывать из предыдущих стоков
	СоздатьНовыеЭлементыФормы(Ложь);
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект); 
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры

