&НаКлиенте
Процедура ОбработкаДобавленияНомерныхПозиций(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = Неопределено тогда возврат; КонецЕсли;
	
	ИмяЗакладки = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	ИДКонтрагента = Сред(ИмяЗакладки, 9);
	ТаблицаФормы = ЭтаФорма["Тбл"+ИДКонтрагента];
	
	МассивКТК 			= Параметр1.КТК;
	МассивРазмеровКТК 	= Параметр1.РазмерКТК;
	МассивДат 			= Параметр1.ДатыКТК;
	МасДатПрибТерм 		= Параметр1.ДатыПрибытияНаТерм;
	ДатаПриемаВСток		= ?(Параметр1.Свойство("ДатаПриемаВСток"), Параметр1.ДатаПриемаВСток, Новый Массив);
	
	// надо проверить, что указанный КТК 
	// 1. не зарезервирован ранее
	// 2. если НЕ зарезервирован (свободен) В ДРУГОМ стоке, то спросить у пользователя, что делать с этим КТК.
	
	МассивСтруктурКТК = ПолучитьСпорныеКТК(МассивКТК,Объект.Сток,ИДКонтрагента);
	
	МассивКТКДляВопроса = Новый Массив;
	МассивРазмеровКТКВопрос = Новый Массив;
	МассивДатВопрос = Новый Массив;
	МасДатПрибТермВопрос = Новый Массив;
	
	Для ШагЦикла = 0 По Параметр1.КТК.Количество()-1 Цикл
		
		НачКТ = МассивКТК[ШагЦикла];
		
		Если ТипЗнч(НачКТ) = Тип("Строка") Тогда
		
			КТКСсылка = РаботаСКонтейнерамиСервер.СоздатьКТК(МассивКТК[ШагЦикла], неопределено);
		
		Иначе
		
			КТКСсылка = НачКТ;
		
		КонецЕсли; 
		
		// в таблицу "молча" добавляем только те КТК, которых нет в элементе структуры СтруктураКТК
		// если ктк есть в структуре, то нужно проверить причину, почему он там и задать пользователю вопрос, что делать с этим КТК дальше.
		
		НеПишем = Ложь;
		
		Для Каждого Эл Из МассивСтруктурКТК Цикл
			Если Эл.Контейнер = КТКСсылка Тогда
				НеПишем = Истина;
	//			Если НЕ Эл.ЗапретСтатуса Тогда
					МассивКТКДляВопроса.Добавить(Эл.Контейнер);
					МассивРазмеровКТКВопрос.Добавить(МассивРазмеровКТК[ШагЦикла]);
					МассивДатВопрос.Добавить(МассивДат[ШагЦикла]);
					МасДатПрибТермВопрос.Добавить(МасДатПрибТерм[ШагЦикла]);
	//			КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		                 
		Если НеПишем ИЛИ НайтиКтВТаблицеФормы(ТаблицаФормы, КТКСсылка) Тогда
			Продолжить;
		КонецЕсли;
		
		НСтр = ТаблицаФормы.Добавить();
		НСтр.Контейнер = КТКСсылка;
		Если МассивРазмеровКТК.Количество()> 0 Тогда
			НСтр.ТипКонтейнера = ?(ЗначениеЗаполнено(МассивРазмеровКТК[ШагЦикла]),МассивРазмеровКТК[ШагЦикла],ПолучитьТипКТК(КТКСсылка));
		Иначе
			НСтр.ТипКонтейнера = ПолучитьТипКТК(КТКСсылка);
		КонецЕсли;
		НСтр.ДатаПриемаВСток = ?(ДатаПриемаВСток.количество() > 0, ДатаПриемаВСток[ШагЦикла], неопределено);
		//НСтр.ВремяПрибытияНаТерминалОтпр = МасДатПрибТерм[ШагЦикла];
		Нстр.ДатаПриемаВПользованиеПередПоставщиком = МасДатПрибТерм[ШагЦикла];
		НСтр.КоличествоБНКонтейнеров = 1;
		НСтр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыКТК.Свободен");
		
	КонецЦикла;
	
	Если ТаблицаФормы.Количество()>0 Тогда
		ЭтаФорма.Элементы["КМЗаполнитьПоТекСтр" + Строка(ИДКонтрагента)].Доступность = Истина;
		ЭтаФорма.Элементы["КМЗаполнитьПоСпр" + Строка(ИДКонтрагента)].Доступность = Истина;
		ЭтаФорма.Элементы["КПЗаполнитьПоТекСтр" + Строка(ИДКонтрагента)].Доступность = Истина;
		ЭтаФорма.Элементы["КПЗаполнитьПоСпр" + Строка(ИДКонтрагента)].Доступность = Истина;
	Иначе
		ЭтаФорма.Элементы["КМЗаполнитьПоТекСтр" + Строка(ИДКонтрагента)].Доступность = Ложь;
		ЭтаФорма.Элементы["КМЗаполнитьПоСпр" + Строка(ИДКонтрагента)].Доступность = Ложь;
		ЭтаФорма.Элементы["КПЗаполнитьПоТекСтр" + Строка(ИДКонтрагента)].Доступность = Ложь;
		ЭтаФорма.Элементы["КПЗаполнитьПоСпр" + Строка(ИДКонтрагента)].Доступность = Ложь;
	КонецЕсли;
	
	// если есть КТК, которые находятся не в этом стоке или не у этого контрагента
	Если МассивКТКДляВопроса.Количество()>0 Тогда
		
		ПараметрыДействия = Новый Структура;
		ПараметрыДействия.Вставить("ИмяТбл","Тбл"+ИДКонтрагента);
		ПараметрыДействия.Вставить("ИДКонтрагента",ИДКонтрагента);
		ПараметрыДействия.Вставить("МассивКТК",МассивКТКДляВопроса);
		ПараметрыДействия.Вставить("МассивРазмеровКТК",МассивРазмеровКТКВопрос);
		ПараметрыДействия.Вставить("МассивДат",МассивДатВопрос);
		ПараметрыДействия.Вставить("МасДатПрибТерм",МасДатПрибТермВопрос);
		ПараметрыДействия.Вставить("МассивСтруктурКТК",МассивСтруктурКТК);
		ПараметрыДействия.Вставить("ДобавлениеЧерезФорму",Истина);
		
		ОпОп = Новый ОписаниеОповещения("ВопросДействияКТК", ЭтаФорма, ПараметрыДействия);
		ТекстСообщения = "Контейнеры " + СтрСоединить(МассивКТКДляВопроса, Символы.ПС) + " находятся в другом стоке или у другого контрагента.";
		ПоказатьВопрос(ОпОп, ТекстСообщения + " Перенести в этот сток контрагенту (" + Элементы.ГруппаСтраницы.ТекущаяСтраница.Заголовок + ")?", РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Нет,, КодВозвратаДиалога.Нет);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Функция НайтиКтВТаблицеФормы(КоллекцияФормы, КТ)

	РезПоиска = Ложь;
	
	Для каждого Стр Из КоллекцияФормы Цикл
	
		Если Стр.Контейнер = КТ Тогда
		
			Возврат Истина;
		
		Иначе
		
			
		
		КонецЕсли; 
	
	КонецЦикла; 

	Возврат РезПоиска;
	
КонецФункции


&НаКлиенте
Процедура ВопросДействияКТК(Параметр1 = неопределено, Параметр2 = неопределено) экспорт
	
	Если Параметр1 = КодВозвратаДиалога.Да Тогда
		
		ТаблицаФормы = ЭтаФорма[Параметр2.ИмяТбл];
		
		// сторнировать КТК у другого стока/контрагента
		СторноКТКВДругомСтоке(Параметр2.МассивСтруктурКТК);
		
		// занести в данный сток только если данные вносились через форму вставки. если через кнопку "Добавить", то они там уже есть и делать ничего больше не надо
		Если Параметр2.Свойство("ДобавлениеЧерезФорму") Тогда
			
			Для ШагЦикла = 0 По Параметр2.МассивКТК.Количество()-1 Цикл
				НСтр = ТаблицаФормы.Добавить();
				НСтр.Контейнер = Параметр2.МассивКТК[ШагЦикла];
				Если Параметр2.МассивРазмеровКТК.Количество()> 0 Тогда
					НСтр.ТипКонтейнера = ?(ЗначениеЗаполнено(Параметр2.МассивРазмеровКТК[ШагЦикла]),Параметр2.МассивРазмеровКТК[ШагЦикла],ПолучитьТипКТК(Параметр2.МассивКТК[ШагЦикла]));
				Иначе
					НСтр.ТипКонтейнера = ПолучитьТипКТК(Параметр2.МассивКТК[ШагЦикла]);
				КонецЕсли;
				Если Параметр2.МассивДат.Количество()>0 Тогда
					НСтр.ДатаВзятияИзСтока = Параметр2.МассивДат[ШагЦикла];
				КонецЕсли;
				Если Параметр2.МасДатПрибТерм.Количество()>0 Тогда
					НСтр.ВремяПрибытияНаТерминалОтпр = Параметр2.МасДатПрибТерм[ШагЦикла];
				КонецЕсли;
				Если Параметр2.Свойство("МассивДатаПриемаВСток") Тогда
					НСтр.ДатаПриемаВСток = Параметр2.МассивДатаПриемаВСток[ШагЦикла];
				КонецЕсли;
				Если Параметр2.Свойство("МассивНомерТСПрибытия") Тогда
					НСтр.НомерТСПрибытия = Параметр2.МассивНомерТСПрибытия[ШагЦикла];
				КонецЕсли;
				Если Параметр2.Свойство("МассивВодительТСПрибытия") Тогда
					НСтр.ВодительТСПрибытия = Параметр2.МассивВодительТСПрибытия[ШагЦикла];
				КонецЕсли;
				Если Параметр2.Свойство("Контрагент") Тогда
					НСтр.Контрагент = Параметр2.Контрагент;
				КонецЕсли;
				НСтр.КоличествоБНКонтейнеров = 1;
				НСтр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыКТК.Свободен");
				
			КонецЦикла;
		КонецЕсли;
		
		Если ТаблицаФормы.Количество()>0 Тогда
			ЭтаФорма.Элементы["КМЗаполнитьПоТекСтр" + Строка(Параметр2.ИДКонтрагента)].Доступность = Истина;
			ЭтаФорма.Элементы["КМЗаполнитьПоСпр" + Строка(Параметр2.ИДКонтрагента)].Доступность = Истина;
			ЭтаФорма.Элементы["КПЗаполнитьПоТекСтр" + Строка(Параметр2.ИДКонтрагента)].Доступность = Истина;
			ЭтаФорма.Элементы["КПЗаполнитьПоСпр" + Строка(Параметр2.ИДКонтрагента)].Доступность = Истина;
		Иначе
			ЭтаФорма.Элементы["КМЗаполнитьПоТекСтр" + Строка(Параметр2.ИДКонтрагента)].Доступность = Ложь;
			ЭтаФорма.Элементы["КМЗаполнитьПоСпр" + Строка(Параметр2.ИДКонтрагента)].Доступность = Ложь;
			ЭтаФорма.Элементы["КПЗаполнитьПоТекСтр" + Строка(Параметр2.ИДКонтрагента)].Доступность = Ложь;
			ЭтаФорма.Элементы["КПЗаполнитьПоСпр" + Строка(Параметр2.ИДКонтрагента)].Доступность = Ложь;
		КонецЕсли;
		
	Иначе
	//Евросиб Гудкова( 09.09.2020 если через вставку, то удалять нечего
		Если Параметр2.Свойство("ДобавлениеЧерезФорму") И Параметр2.ДобавлениеЧерезФорму Тогда
			Возврат;
		КонецЕсли; 
	// Евросиб Гудкова) 	
		// удалить строку с этим КТК (для случая, когда данные добавлены через кнопку "Добавить")
		ИмяЗакладки = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
		ИДКонтрагента = Сред(ИмяЗакладки, 9);
		ИмяТбл = "ТЗН"+ИДКонтрагента;
		ИмяТблДляУдаления = "Тбл"+ИДКонтрагента;
		
		ТекД = Элементы[ИмяТбл].ТекущиеДанные;
		
		Если ТекД = Неопределено Тогда
			Возврат;
		КонецЕсли;
		// уникальность записи определяется полями:
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ТипКонтейнера",ТекД.ТипКонтейнера);
		ПараметрыОтбора.Вставить("Контейнер",ТекД.Контейнер);
		ПараметрыОтбора.Вставить("Контрагент",ТекД.Контрагент);
		ПараметрыОтбора.Вставить("Направление",ТекД.Направление);
		ПараметрыОтбора.Вставить("Статус",ТекД.Статус);
		
		УдалитьСтрокуНаСервере(ИмяТблДляУдаления,ПараметрыОтбора);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СторноКТКВДругомСтоке(МассивСтруктурКТК)
	
	// удалить в самом документе сток
	Для Каждого Эл Из МассивСтруктурКТК Цикл
//		Если Эл.ЗапретСтатуса = Ложь Тогда
			// ищем по стоку, контейнеру и контрагенту последний документ Сток Контейнеров
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	МАКСИМУМ(СтокКонтейнеровКонтейнеры.Ссылка.Дата) КАК Дата,
			               |	СтокКонтейнеровКонтейнеры.Контейнер КАК Контейнер,
			               |	СтокКонтейнеровКонтейнеры.Контрагент КАК Контрагент,
			               |	СтокКонтейнеровКонтейнеры.Ссылка.Сток КАК Сток
			               |ПОМЕСТИТЬ МаксДатаСтока
			               |ИЗ
			               |	Документ.СтокКонтейнеров.Контейнеры КАК СтокКонтейнеровКонтейнеры
			               |ГДЕ
			               |	СтокКонтейнеровКонтейнеры.Ссылка.Сток = &Сток
			               |	И СтокКонтейнеровКонтейнеры.Контейнер = &Контейнер
			               |	И СтокКонтейнеровКонтейнеры.Контрагент = &Контрагент
			               |	И НЕ СтокКонтейнеровКонтейнеры.Ссылка.ПометкаУдаления
			               |
			               |СГРУППИРОВАТЬ ПО
			               |	СтокКонтейнеровКонтейнеры.Ссылка.Сток,
			               |	СтокКонтейнеровКонтейнеры.Контейнер,
			               |	СтокКонтейнеровКонтейнеры.Контрагент
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	СтокКонтейнеровКонтейнеры.Ссылка КАК ДокументСтокиКонт,
			               |	СтокКонтейнеровКонтейнеры.Контейнер КАК Контейнер,
			               |	СтокКонтейнеровКонтейнеры.Контрагент КАК Контрагент,
			               |	СтокКонтейнеровКонтейнеры.Ссылка.Сток КАК Сток
			               |ИЗ
			               |	МаксДатаСтока КАК МаксДатаСтока
			               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СтокКонтейнеров.Контейнеры КАК СтокКонтейнеровКонтейнеры
			               |		ПО МаксДатаСтока.Контейнер = СтокКонтейнеровКонтейнеры.Контейнер
			               |			И МаксДатаСтока.Дата = СтокКонтейнеровКонтейнеры.Ссылка.Дата
			               |			И МаксДатаСтока.Контрагент = СтокКонтейнеровКонтейнеры.Контрагент
			               |			И МаксДатаСтока.Сток = СтокКонтейнеровКонтейнеры.Ссылка.Сток";
			Запрос.УстановитьПараметр("Сток",Эл.Сток);
			Запрос.УстановитьПараметр("Контейнер",Эл.Контейнер);
			Запрос.УстановитьПараметр("Контрагент",Эл.Контрагент);
			
			Ответ = Запрос.Выполнить().Выбрать();
			
			Если Ответ.Следующий() Тогда
				
				ПолучОб = Ответ.ДокументСтокиКонт.ПолучитьОбъект();
				ТЧКонт = ПолучОб.Контейнеры;
				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("Контейнер",Эл.Контейнер);
				НайденнаяСтрока = ТЧКонт.НайтиСтроки(ПараметрыОтбора);
				Для каждого Стр Из НайденнаяСтрока Цикл
					ТЧКонт.Удалить(Стр);
				КонецЦикла;
				ПолучОб.Записать(РежимЗаписиДокумента.Проведение);
				
			КонецЕсли;
			
//		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСпорныеКТК(МассивКТК, ТекСток, ИДКонтрагента)
	
	МассивСтруктурКТК = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтейнерыВСтокахОстатки.Контейнер КАК Контейнер,
	               |	КонтейнерыВСтокахОстатки.Сток КАК Сток,
	               |	КонтейнерыВСтокахОстатки.Контрагент КАК Контрагент,
	               |	ВЫБОР
	               |		КОГДА КонтейнерыВСтокахОстатки.Сток = &Сток
	               |				И НЕ КонтейнерыВСтокахОстатки.Контрагент.Код = &Контрагент
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ДругойКонтрагент,
	               |	ВЫБОР
	               |		КОГДА НЕ КонтейнерыВСтокахОстатки.Сток = &Сток
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ДругойСток,
	               |	СтатусыКТКСрезПоследних.Статус КАК Статус
	               |ИЗ
	               |	РегистрНакопления.КонтейнерыВСтоках.Остатки(, Контейнер В (&Контейнер)) КАК КонтейнерыВСтокахОстатки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыКТК.СрезПоследних(, Контейнер В (&Контейнер)) КАК СтатусыКТКСрезПоследних
	               |		ПО КонтейнерыВСтокахОстатки.Контейнер = СтатусыКТКСрезПоследних.Контейнер
	               |ГДЕ
	               |	КонтейнерыВСтокахОстатки.Контейнер ССЫЛКА Справочник.ТЕ
	               |	И ВЫБОР
	               |			КОГДА СтатусыКТКСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыКТК.Зарезервирован)
	               |					ИЛИ СтатусыКТКСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыКТК.ВДвижении)
	               |				ТОГДА ЛОЖЬ
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ";
				   //|	И (НЕ КонтейнерыВСтокахОстатки.Сток = &Сток
				   //|			ИЛИ КонтейнерыВСтокахОстатки.Сток = &Сток
				   //|				И НЕ КонтейнерыВСтокахОстатки.Контрагент.Код = &Контрагент)";
	Запрос.УстановитьПараметр("Сток", ТекСток);
	Запрос.УстановитьПараметр("Контрагент", ИДКонтрагента);
	Запрос.УстановитьПараметр("Контейнер", МассивКТК);
	
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		Если НЕ Ответ.ДругойКонтрагент И НЕ  Ответ.ДругойСток Тогда Продолжить; КонецЕсли;
		
		СтруктураКТК = Новый Структура;
		СтруктураКТК.Вставить("ДругойКонтрагент",Ответ.ДругойКонтрагент);
		СтруктураКТК.Вставить("ДругойСток",Ответ.ДругойСток);
		СтруктураКТК.Вставить("Сток",Ответ.Сток);
		СтруктураКТК.Вставить("Контейнер",Ответ.Контейнер);
		СтруктураКТК.Вставить("Контрагент",Ответ.Контрагент);
//		СтруктураКТК.Вставить("ЗапретСтатуса",Ответ.ЗапретСтатуса);
		
		МассивСтруктурКТК.Добавить(СтруктураКТК);
		
	КонецЦикла;
	
	Возврат МассивСтруктурКТК;
	
КонецФункции

