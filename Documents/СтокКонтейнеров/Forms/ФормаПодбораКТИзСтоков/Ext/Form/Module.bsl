&НаСервере
Процедура ПроверкаНаРанееВыгруженные()
	
	ДанныеИзЗаявки = ПолучитьИзВременногоХранилища(КТКВХранилище);
	
	Запрос = Новый Запрос;
	
	УсловияОтборов = "";
	Запрос.УстановитьПараметр("УсловияОтборов", Истина);
	
	// добавление отборов на форму
	ОтборСток = "";
	Если ЗначениеЗаполнено(Сток) Тогда
		ОтборСток = "ДанныеИзРН.Сток В ИЕРАРХИИ(&Сток)";
		Запрос.УстановитьПараметр("Сток", Сток);
		УсловияОтборов = УсловияОтборов + ОтборСток;
	КонецЕсли;
	
	ОтборНаправление = "";
	Если ЗначениеЗаполнено(Направление) Тогда
		ОтборНаправление = "ДанныеИзРН.Назначение В ИЕРАРХИИ (&Назначение)";
		Запрос.УстановитьПараметр("Назначение", Направление);
		УсловияОтборов = УсловияОтборов + ?(УсловияОтборов="", "", " И ")+ОтборНаправление;
	КонецЕсли;
	
	ОтборТипКТ = "";
	Если ЗначениеЗаполнено(ТипКонтейнера) Тогда
		ОтборТипКТ = "ДанныеИзРН.ТипКТК = &ТипКТК";
		Запрос.УстановитьПараметр("ТипКТК", ТипКонтейнера);
		УсловияОтборов = УсловияОтборов + ?(УсловияОтборов="", "", " И ")+ОтборТипКТ;
	КонецЕсли;
	
	ОтборПоКонтрагенту = "";
	Если ЗначениеЗаполнено(Контрагент) Тогда
		ОтборПоКонтрагенту = "ДанныеИзРН.Контрагент = &Контрагент";
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		УсловияОтборов = УсловияОтборов + ?(УсловияОтборов="", "", " И ")+ОтборПоКонтрагенту;
	КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДанныеИзЗаявки.НомерКТК КАК НомерКТК,
	               |	ДанныеИзЗаявки.ПунктОтправления КАК ПунктОтправления,
	               |	ДанныеИзЗаявки.ПунктНазначения КАК ПунктНазначения,
	               |	ДанныеИзЗаявки.ВладелецКТК КАК ВладелецКТК,
	               |	ДанныеИзЗаявки.ТипКТК КАК ТипКТК
	               |ПОМЕСТИТЬ ДанныеИзЗаявки
	               |ИЗ
	               |	&ДанныеИзЗаявки КАК ДанныеИзЗаявки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДанныеИзЗаявки.НомерКТК КАК Контейнер,
	               |	ДанныеИзЗаявки.ПунктОтправления КАК Сток,
	               |	ДанныеИзЗаявки.ПунктНазначения КАК Назначение,
	               |	ДанныеИзЗаявки.ВладелецКТК КАК Контрагент,
	               |	ДанныеИзЗаявки.ТипКТК КАК ТипКТК,
	               |	СУММА(1) КАК Колво
	               |ПОМЕСТИТЬ ДЗ
	               |ИЗ
	               |	ДанныеИзЗаявки КАК ДанныеИзЗаявки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ДанныеИзЗаявки.ПунктНазначения,
	               |	ДанныеИзЗаявки.ТипКТК,
	               |	ДанныеИзЗаявки.НомерКТК,
	               |	ДанныеИзЗаявки.ВладелецКТК,
	               |	ДанныеИзЗаявки.ПунктОтправления
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КонтейнерыВСтокахОстаткиИОбороты.Контейнер КАК Контейнер,
	               |	КонтейнерыВСтокахОстаткиИОбороты.Контейнер.ТипТЕ КАК ТипКТК,
	               |	КонтейнерыВСтокахОстаткиИОбороты.Сток КАК Сток,
	               |	КонтейнерыВСтокахОстаткиИОбороты.Назначение КАК Назначение,
	               |	КонтейнерыВСтокахОстаткиИОбороты.Контрагент КАК Контрагент,
	               |	КонтейнерыВСтокахОстаткиИОбороты.ДатаПриемаВСток КАК ДатаПриемаВСток,
	               |	КонтейнерыВСтокахОстаткиИОбороты.СрокВозврата КАК СрокВозврата,
	               |	СУММА(КонтейнерыВСтокахОстаткиИОбороты.КоличествоОборот - ЕСТЬNULL(ДЗ.Колво, 0)) КАК КоличествоОстаток
	               |ПОМЕСТИТЬ ДанныеИзРН
	               |ИЗ
	               |	РегистрНакопления.КонтейнерыВСтоках.ОстаткиИОбороты(, &ДатаСозданияСтока, Авто, , ) КАК КонтейнерыВСтокахОстаткиИОбороты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДЗ КАК ДЗ
	               |		ПО КонтейнерыВСтокахОстаткиИОбороты.Контейнер = ДЗ.Контейнер
	               |			И (НЕ ДЗ.Контейнер = ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка))
	               |			И КонтейнерыВСтокахОстаткиИОбороты.Сток = ДЗ.Сток
	               |			И КонтейнерыВСтокахОстаткиИОбороты.Назначение = ДЗ.Назначение
	               |			И КонтейнерыВСтокахОстаткиИОбороты.Контрагент = ДЗ.Контрагент
	               |ГДЕ
	               |	КонтейнерыВСтокахОстаткиИОбороты.Контейнер ССЫЛКА Справочник.ТЕ
	               |	И НЕ КонтейнерыВСтокахОстаткиИОбороты.Регистратор = &Регистратор
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	КонтейнерыВСтокахОстаткиИОбороты.ДатаПриемаВСток,
	               |	КонтейнерыВСтокахОстаткиИОбороты.Контейнер,
	               |	КонтейнерыВСтокахОстаткиИОбороты.Контрагент,
	               |	КонтейнерыВСтокахОстаткиИОбороты.Сток,
	               |	КонтейнерыВСтокахОстаткиИОбороты.Назначение,
	               |	КонтейнерыВСтокахОстаткиИОбороты.Контейнер.ТипТЕ,
	               |	КонтейнерыВСтокахОстаткиИОбороты.СрокВозврата
	               |
	               |ИМЕЮЩИЕ
	               |	СУММА(КонтейнерыВСтокахОстаткиИОбороты.КоличествоОборот - ЕСТЬNULL(ДЗ.Колво, 0)) > 0
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	КонтейнерыВСтокахОстаткиИОбороты.Контейнер,
	               |	КонтейнерыВСтокахОстаткиИОбороты.Контейнер,
	               |	КонтейнерыВСтокахОстаткиИОбороты.Сток,
	               |	КонтейнерыВСтокахОстаткиИОбороты.Назначение,
	               |	КонтейнерыВСтокахОстаткиИОбороты.Контрагент,
	               |	КонтейнерыВСтокахОстаткиИОбороты.ДатаПриемаВСток,
	               |	КонтейнерыВСтокахОстаткиИОбороты.СрокВозврата,
	               |	СУММА(КонтейнерыВСтокахОстаткиИОбороты.КоличествоОборот - ЕСТЬNULL(ДЗ.Колво, 0))
	               |ИЗ
	               |	РегистрНакопления.КонтейнерыВСтоках.ОстаткиИОбороты(, &ДатаСозданияСтока, Авто, , ) КАК КонтейнерыВСтокахОстаткиИОбороты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДЗ КАК ДЗ
	               |		ПО КонтейнерыВСтокахОстаткиИОбороты.Контейнер = ДЗ.ТипКТК
	               |			И КонтейнерыВСтокахОстаткиИОбороты.Сток = ДЗ.Сток
	               |			И КонтейнерыВСтокахОстаткиИОбороты.Назначение = ДЗ.Назначение
	               |			И КонтейнерыВСтокахОстаткиИОбороты.Контрагент = ДЗ.Контрагент
	               |			И (ДЗ.Контейнер = ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка))
	               |ГДЕ
	               |	КонтейнерыВСтокахОстаткиИОбороты.Контейнер ССЫЛКА Справочник.ТипоразмерыТЕ
	               |	И КонтейнерыВСтокахОстаткиИОбороты.КоличествоКонечныйОстаток - ЕСТЬNULL(ДЗ.Колво, 0) > 0
	               |	И НЕ КонтейнерыВСтокахОстаткиИОбороты.Регистратор = &Регистратор
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	КонтейнерыВСтокахОстаткиИОбороты.ДатаПриемаВСток,
	               |	КонтейнерыВСтокахОстаткиИОбороты.Сток,
	               |	КонтейнерыВСтокахОстаткиИОбороты.Назначение,
	               |	КонтейнерыВСтокахОстаткиИОбороты.Контрагент,
	               |	КонтейнерыВСтокахОстаткиИОбороты.Контейнер,
	               |	КонтейнерыВСтокахОстаткиИОбороты.СрокВозврата,
	               |	КонтейнерыВСтокахОстаткиИОбороты.Контейнер
	               |
	               |ИМЕЮЩИЕ
	               |	СУММА(КонтейнерыВСтокахОстаткиИОбороты.КоличествоОборот - ЕСТЬNULL(ДЗ.Колво, 0)) > 0
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ДанныеИзРН.Контейнер КАК Контейнер,
	               |	ДанныеИзРН.ТипКТК КАК ТипКТК,
	               |	ДанныеИзРН.Сток КАК Сток,
	               |	ДанныеИзРН.Назначение КАК Назначение,
	               |	ДанныеИзРН.Контрагент КАК Контрагент,
	               |	ДанныеИзРН.ДатаПриемаВСток КАК ДатаПриемаВСток,
	               |	ДанныеИзРН.СрокВозврата КАК СрокВозврата,
	               |	ДанныеИзРН.КоличествоОстаток КАК КоличествоОстаток
	               |ИЗ
	               |	ДанныеИзРН КАК ДанныеИзРН
	               |ГДЕ
	               |	&УсловияОтборов";
	Запрос.УстановитьПараметр("ДанныеИзЗаявки",ДанныеИзЗаявки);
	Запрос.УстановитьПараметр("ДатаСозданияСтока", ?(ЗначениеЗаполнено(ДатаЗаявки), ДатаЗаявки, ТекущаяДата()));
	Запрос.УстановитьПараметр("Сток",Сток);
	Запрос.УстановитьПараметр("ТипКТК",ТипКонтейнера);
	Запрос.УстановитьПараметр("Назначение",Направление);
	Запрос.УстановитьПараметр("Регистратор",Параметры.Заявка);
	Если УсловияОтборов <> "" Тогда
	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловияОтборов", УсловияОтборов);
	
	КонецЕсли; 
	РезультатТЗ = Запрос.Выполнить().Выгрузить();
	ТЗХранилище.Загрузить(РезультатТЗ);
	
	Если РезультатТЗ.Количество() = 0 Тогда
	
		Элементы.Контрагент1.РежимВыбораИзСписка = Ложь; 
		Элементы.Контрагент1.СписокВыбора.Очистить();
	
	Иначе
		
		ТЗКонтр = РезультатТЗ.Скопировать(,"Контрагент");
		ТЗКонтр.Свернуть("Контрагент");
		
		Элементы.Контрагент1.РежимВыбораИзСписка = Истина; 
		Элементы.Контрагент1.СписокВыбора.ЗагрузитьЗначения( ТЗКонтр.ВыгрузитьКолонку("Контрагент") );
	
	КонецЕсли; 
	
	КоличествоКТ_В_Списке = ТЗХранилище.Количество();
	
	//Элементы.ТЗХранилищеСток.Видимость = НЕ ЗначениеЗаполнено(Сток);
	// дозаполнение по данным документа СтокКТК
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	СтокКонтейнеровКонтейнеры.Контейнер КАК Контейнер,
	               |	СтокКонтейнеровКонтейнеры.ПСЦ КАК ПСЦ,
	               |	СтокКонтейнеровКонтейнеры.Ставка КАК Ставка,
	               |	СтокКонтейнеровКонтейнеры.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	СтокКонтейнеровКонтейнеры.Валюта КАК Валюта,
	               |	СтокКонтейнеровКонтейнеры.СтавкаНДС КАК СтавкаНДС,
	               |	СтокКонтейнеровКонтейнеры.НДСВключая КАК НДСВключая,
	               |	СтокКонтейнеровКонтейнеры.СтавкаСНП КАК СтавкаСНП,
	               |	СтокКонтейнеровКонтейнеры.ЗабратьДо КАК ЗабратьДо,
	               |	СтокКонтейнеровКонтейнеры.ВремяПрибытияНаТерминалОтпр КАК ВремяПрибытияНаТерминалОтпр,
	               |	СтокКонтейнеровКонтейнеры.ИнструкцииПоСдачеПорожнего КАК ИнструкцииПоСдачеПорожнего
	               |ИЗ
	               |	Документ.СтокКонтейнеров.Контейнеры КАК СтокКонтейнеровКонтейнеры
	               |ГДЕ
	               |	НЕ СтокКонтейнеровКонтейнеры.Ссылка.ПометкаУдаления
	               |	И СтокКонтейнеровКонтейнеры.Контейнер = &Контейнер
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СтокКонтейнеровКонтейнеры.Ссылка.Дата УБЫВ";
	
	Для каждого Стр из ТЗХранилище Цикл
		
		Запрос.УстановитьПараметр("Контейнер", Стр.Контейнер);
		Ответ = запрос.Выполнить().Выбрать();
		Если ответ.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(Стр, Ответ);
		КонецЕсли;
		
	КонецЦикла;
	
	ТЗХранилище.Сортировать("ЗабратьДо");
	
КонецПроцедуры	
	
