&НаКлиенте
Процедура ОК(Команда)
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Отметка",Истина);
	НайденныеСтроки = ТЗХранилище.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество() = 0 Тогда
		Сообщить("Не выбрано ни одного контейнера");
		Возврат;
	КонецЕсли;
	
	ЗаписатьПодборВХранилище();
	Если Команда.Имя = "ОК" Тогда
		ВладелецФормы.ОбработатьПодбор(Параметры.ГУИД);
	Иначе
		ВладелецФормы.ОбработатьПодбор("Замена");
	КонецЕсли;
	Закрыть();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьПодборВХранилище()
	
	//ГУИДСтроки = "";
	
	ТЗДляЗаявки = ПолучитьИзВременногоХранилища(КТКВХранилище);
	// запомнить ГУИД строки, которую надо удалить
	//Если ТЗДляЗаявки.Количество()>0 Тогда
	//	ГУИДСтроки = ТЗДляЗаявки[0].ГУИД;
	//КонецЕсли;
	ТЗДляЗаявки.Очистить();
	
	Если ПриоритетНомерным Тогда
		УпорядочиваниеПриоритет = " УПОРЯДОЧИТЬ ПО Приоритет";
	Иначе
		УпорядочиваниеПриоритет = "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВыбранныеСтроки.Контейнер КАК Контейнер,
	               |	ВыбранныеСтроки.Сток КАК Сток,
	               |	ВыбранныеСтроки.Отметка КАК Отметка,
	               |	ВыбранныеСтроки.Назначение КАК Назначение,
	               |	ВыбранныеСтроки.Контрагент КАК Контрагент,
	               |	ВыбранныеСтроки.КоличествоОстаток КАК КоличествоОстаток,
	               |	ВыбранныеСтроки.ДатаПриемаВСток КАК ДатаПриемаВСток,
	               |	ВыбранныеСтроки.ВремяПрибытияНаТерминалОтпр КАК ВремяПрибытияНаТерминалОтпр,
	               |	ВыбранныеСтроки.СрокВозврата КАК СрокВозврата,
	               |	ВыбранныеСтроки.ИнструкцииПоСдачеПорожнего КАК ИнструкцииПоСдачеПорожнего,
	               |	ВЫБОР
	               |		КОГДА ВыбранныеСтроки.Контейнер ССЫЛКА Справочник.ТЕ
	               |			ТОГДА 1
	               |		ИНАЧЕ 2
	               |	КОНЕЦ КАК Приоритет
	               |ПОМЕСТИТЬ ВыбранныеСтроки
	               |ИЗ
	               |	&ВыбранныеСтроки КАК ВыбранныеСтроки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВыбранныеСтроки.Отметка КАК Отметка,
	               |	ВыбранныеСтроки.Контейнер КАК НомерКТК,
	               |	ВыбранныеСтроки.Сток КАК ПунктОтправления,
	               |	ВыбранныеСтроки.Сток КАК СтанцияОтправления,
	               |	ВыбранныеСтроки.Назначение КАК ПунктНазначения,
	               |	ВыбранныеСтроки.Назначение КАК СтанцияНазначения,
	               |	ВыбранныеСтроки.Контрагент КАК ВладелецКТК,
	               |	ВыбранныеСтроки.КоличествоОстаток КАК КоличествоОстаток,
	               |	ВыбранныеСтроки.ДатаПриемаВСток КАК ДатаПриемаВСток,
	               |	ВыбранныеСтроки.ВремяПрибытияНаТерминалОтпр КАК ВремяПрибытияНаТерминалОтпр,
	               |	ВыбранныеСтроки.СрокВозврата КАК НормативноеИспользованиеИзСтока,
	               |	ВыбранныеСтроки.Приоритет КАК Приоритет,
	               |	ВыбранныеСтроки.ИнструкцииПоСдачеПорожнего КАК ИнструкцииПоСдачеПорожнего
	               |ИЗ
	               |	ВыбранныеСтроки КАК ВыбранныеСтроки
	               |ГДЕ
	               |	ВыбранныеСтроки.Отметка" + УпорядочиваниеПриоритет + "
				   |	";
	Запрос.УстановитьПараметр("ВыбранныеСтроки",ТЗХранилище.Выгрузить());
	РезультатЗапроса = Запрос.Выполнить();
	ТЗ = РезультатЗапроса.Выгрузить();
	
	Для Каждого Стр Из ТЗ Цикл
		// если в ТЗ строк столько сколько требуется контейнеров, то стоп
		Если ТЗДляЗаявки.Количество() = КолвоКонтейнеров Тогда
			Прервать;
		КонецЕсли;
		// если установлена галочка "приоритет номерным", то сначала в ТЗ добавить строки, содержащие номер контейнера,
		// а затем, если количество требуемых контейнеров больше добавленных в ТЗ данных, добавить из безномерного парка
		//СтрДС = Элементы.Список.ДанныеСтроки(Стр);
		// если в поле КоличествоОстаток 1, то нужно добавить одну запись в ТЗ
		Попытка
			ТипТЕ = Стр.НомерКТК.ТипТЕ;
		Исключение
			ТипТЕ = Стр.НомерКТК;
		КонецПопытки;
		Если Стр.КоличествоОстаток = 1 Тогда
			//СтруктураСтроки = Новый Структура("НомерКТК,ПунктОтправления,СтанцияОтправления,ПунктНазначения,СтанцияНазначения,ВладелецКТК,ТипКТК",Стр.Контейнер,Стр.Сток,Стр.Сток,Стр.Назначение,Стр.Назначение,Стр.Контрагент,ТипТЕ);
			НовСтр = ТЗДляЗаявки.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр,Стр);
			НовСтр.ТипКТК = ТипТЕ;
			//НовСтр.ВремяПрибытияНаТерминал = Стр.ВремяПрибытияНаТерминалОтпр; // Было Захвачено Сусловым. "Времянка" добавляю строчку
			//НовСтр.ГУИД = ГУИДСтроки;
			// если КоличествоОстаток >1 тогда нужно добавить такое количество записей в массив, какое число там стоит, но не более
			// количества требуемых контейнеров
		Иначе
			i = 1;
			Пока i<Стр.КоличествоОстаток Цикл
				НовСтр = ТЗДляЗаявки.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр,Стр);
				НовСтр.ТипКТК = ТипТЕ;
				//НовСтр.ГУИД = ГУИДСтроки;
				Если ТЗДляЗаявки.Количество() = КолвоКонтейнеров Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	ПоместитьВоВременноеХранилище(ТЗДляЗаявки,КТКВХранилище);
	
КонецПроцедуры

