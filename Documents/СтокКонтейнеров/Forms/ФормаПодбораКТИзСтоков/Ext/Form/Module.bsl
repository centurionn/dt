&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	КТКВХранилище = Параметры.КТКВХранилище;
	
	БазовыеЗначения = Новый Структура;
	
	Если Параметры.Свойство("Контрагент") Тогда
		Контрагент = Параметры.Контрагент;
		БазовыеЗначения.Вставить("Контрагент", Контрагент);
	Иначе
		БазовыеЗначения.Вставить("Контрагент", "");
	КонецЕсли;
	Если Параметры.Свойство("Сток") Тогда
		Сток = Параметры.Сток;
		БазовыеЗначения.Вставить("Сток", Сток);
	Иначе
		БазовыеЗначения.Вставить("Сток", "");
	КонецЕсли;
	Если Параметры.Свойство("Направление") Тогда
		Направление = Параметры.Направление;
		БазовыеЗначения.Вставить("Направление", Направление);
	Иначе
		БазовыеЗначения.Вставить("Направление", "");
	КонецЕсли;
	Если Параметры.Свойство("ТипКонтейнера") Тогда
		ТипКонтейнера = Параметры.ТипКонтейнера;
		БазовыеЗначения.Вставить("ТипКонтейнера", ТипКонтейнера);
	Иначе
		БазовыеЗначения.Вставить("ТипКонтейнера", "");
	КонецЕсли;
	Если Параметры.Свойство("СрокВозврата") Тогда
		СрокВозврата = Параметры.СрокВозврата;
		БазовыеЗначения.Вставить("СрокВозврата", СрокВозврата);
	Иначе
		БазовыеЗначения.Вставить("СрокВозврата", "");
	КонецЕсли;
	Если Параметры.Свойство("ДатаЗаявки") Тогда
		ДатаЗаявки = Параметры.ДатаЗаявки;
		БазовыеЗначения.Вставить("ДатаЗаявки", ДатаЗаявки);
	Иначе
		БазовыеЗначения.Вставить("ДатаЗаявки", "");
	КонецЕсли;
	Если параметры.Свойство("КоличествоТребуемыхКТК") тогда
		КолвоКонтейнеров = Параметры.КоличествоТребуемыхКТК;
	Иначе
		КолвоКонтейнеров = 1;
	КонецЕсли;
	БазовыеЗначения.Вставить("КолвоКонтейнеров", КолвоКонтейнеров);
	ПриоритетНомерным = Истина;
	БазовыеЗначения.Вставить("ПриоритетНомерным", ПриоритетНомерным);
	
	ПроверкаНаРанееВыгруженные();
	

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры

//Евросиб Коханенко Н.А. #61705 09.12.2022 (
&НаКлиенте
Процедура ОткрытьОкноСИнструкциями(Форма, Команда)
	ИнструкцииКлиент.ОткрытьОкноСИнструкциями(ЭтаФорма, Команда);
КонецПроцедуры  
