
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	КТКВХранилище = Параметры.КТКВХранилище;
	ПроверкаНаРанееВыгруженные();
	КТКНаАвтоматическоеЗаполнение();
	Для Каждого Стр Из ТЗХранилище Цикл
		Стр.КоличествоОстаток = ПолучитьДоступныеКонтейнеры(Стр.ТипКТК,Стр.Контрагент,Стр.Назначение,Стр.Сток);
	КонецЦикла;

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры

//Евросиб Коханенко Н.А. #61705 09.12.2022 (
&НаКлиенте
Процедура ОткрытьОкноСИнструкциями(Форма, Команда)
	ИнструкцииКлиент.ОткрытьОкноСИнструкциями(ЭтаФорма, Команда);
КонецПроцедуры  
