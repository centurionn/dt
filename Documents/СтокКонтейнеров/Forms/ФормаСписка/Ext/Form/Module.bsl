
&НаКлиенте
Процедура ПоказатьАрхив(Команда)
	
	Элементы.СписокПоказатьАрхив.Пометка = НЕ Элементы.СписокПоказатьАрхив.Пометка;
	Если Элементы.СписокПоказатьАрхив.Пометка Тогда
		Список.ТекстЗапроса = "ВЫБРАТЬ
		                      |	ДокументСтокКонтейнеров.Ссылка КАК Ссылка,
		                      |	ДокументСтокКонтейнеров.ПометкаУдаления КАК ПометкаУдаления,
		                      |	ДокументСтокКонтейнеров.Номер КАК Номер,
		                      |	ДокументСтокКонтейнеров.Дата КАК Дата,
		                      |	ДокументСтокКонтейнеров.Проведен КАК Проведен,
		                      |	ДокументСтокКонтейнеров.Сток КАК Сток,
		                      |	ДокументСтокКонтейнеров.КоличествоБНКонтейнеров КАК КоличествоБНКонтейнеров,
		                      |	ДокументСтокКонтейнеров.Автор КАК Автор,
		                      |	ДокументСтокКонтейнеров.Изменено КАК Изменено,
		                      |	ДокументСтокКонтейнеров.Редактор КАК Редактор,
		                      |	ДокументСтокКонтейнеров.Создано КАК Создано,
		                      |	ДокументСтокКонтейнеров.Комментарий КАК Комментарий,
		                      |	ДокументСтокКонтейнеров.КоличествоКонтейнеров КАК КоличествоКонтейнеров,
		                      |	ДокументСтокКонтейнеров.КоличествоКонтейнеровВсего КАК КоличествоКонтейнеровВсего,
		                      |	ДокументСтокКонтейнеров.МоментВремени КАК МоментВремени
		                      |ИЗ
		                      |	Документ.СтокКонтейнеров КАК ДокументСтокКонтейнеров";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТолькоДанныеПоСтокуПриИзменении(Элемент)
	
	ТекД = Элементы.СписокСтоков.ТекущиеДанные;
	
	Если ТекД = неопределено Тогда Возврат; КонецЕсли;
	
	Если ТекД.Свойство("Ссылка") Тогда
		Список.Параметры.УстановитьЗначениеПараметра("Сток", ?(ТолькоДанныеПоСтоку И ТекД <> неопределено, ТекД.Ссылка, ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка")));
	КонецЕсли;
	
	// остатки по стокам
	ОтборРегион = неопределено;
	Если ТекД.Свойство("Ссылка") Тогда
		ОтборРегион = ТекД.Ссылка;
	ИначеЕсли ТекД.Свойство("ГруппировкаСтроки") Тогда
		ОтборРегион = ТекД.ГруппировкаСтроки.Ключ;
	КонецЕсли;
	
	ОстаткиКТКПоСтокам.Параметры.УстановитьЗначениеПараметра("СтокВыбр", ОтборРегион);
	ОстаткиКТКПоСтокам.Параметры.УстановитьЗначениеПараметра("СтоНеОграничен", НЕ ТолькоДанныеПоСтоку);
	
	//ОтборРегион = неопределено;
	//Если ТекД.Свойство("Ссылка") Тогда
	//	ОтборРегион = ТекД.Ссылка;
	//ИначеЕсли ТекД.Свойство("ГруппировкаСтроки") Тогда
	//	ОтборРегион = ТекД.ГруппировкаСтроки.Ключ;
	//КонецЕсли;
	//МассивЛокаций = ПолучитьВсеПодчиненные(ОтборРегион);
	//
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВсеПодчиненные(Локация)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Локации.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Локации КАК Локации
	               |ГДЕ
	               |	Локации.Ссылка В ИЕРАРХИИ(&Ссылка)
	               |	И НЕ Локации.ПометкаУдаления";
	Запрос.УстановитьПараметр("Ссылка", Локация);
	Возврат Запрос.Выполнить().Выгрузить("Ссылка");
	
КонецФункции

