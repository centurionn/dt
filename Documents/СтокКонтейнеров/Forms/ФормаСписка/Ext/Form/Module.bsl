&НаКлиенте
Процедура ДобавитьСток(Команда)
	
	ТекД = Элементы.СписокСтоков.ТекущиеДанные;
	ОтборРегион = неопределено;
	Если ТекД.Свойство("Ссылка") Тогда
		ОтборРегион = ТекД.Ссылка;
	ИначеЕсли ТекД.Свойство("ГруппировкаСтроки") Тогда
		ОтборРегион = ТекД.ГруппировкаСтроки.Ключ;
	КонецЕсли;
	
	ОткрытьФорму("Справочник.Локации.ФормаОбъекта", Новый Структура("НовыйСток, Родитель", Истина, ОтборРегион));
	
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиКТКПоСтокамВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Док = НайтиПоследнийДокПоСтоку(Элемент.ТекущиеДанные.Сток);
	ПоказатьЗначение(,Док);
	
КонецПроцедуры


&НаСервереБезКонтекста
Функция НайтиПоследнийДокПоСтоку(Сток)
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	СтокКонтейнеров.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.СтокКонтейнеров КАК СтокКонтейнеров
	               |ГДЕ
	               |	НЕ СтокКонтейнеров.ПометкаУдаления
	               |	И СтокКонтейнеров.Сток = &Сток
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СтокКонтейнеров.Дата УБЫВ";
	Запрос.УстановитьПараметр("Сток", Сток);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбновитьДанныеСтоков" Тогда
		Элементы.ОстаткиКТКПоСтокам.Обновить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПросмотрОстатковСписком(Команда)
	
	АдресВХР = ПоместитьПустуюТаблицуВХранилище(ЭтаФорма.УникальныйИдентификатор);
	ПараметрыСтруктура = Новый Структура("КТКВХранилище", АдресВХР);
	ОткрытьФорму("Документ.СтокКонтейнеров.Форма.ФормаПодбораКТИзСтоков", ПараметрыСтруктура,,ЭтаФорма.УникальныйИдентификатор,,,,РежимОткрытияОкнаФормы.Независимый);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПоместитьПустуюТаблицуВХранилище(ГУИД)
	
	ТЧ = Новый ТаблицаЗначений;
	ТЧ.Колонки.Добавить("НомерКТК", Новый ОписаниеТипов("СправочникСсылка.ТЕ"));
	ТЧ.Колонки.Добавить("ПунктОтправления", Новый ОписаниеТипов("СправочникСсылка.Локации"));
	ТЧ.Колонки.Добавить("ПунктНазначения", Новый ОписаниеТипов("СправочникСсылка.Локации"));
	ТЧ.Колонки.Добавить("ВладелецКТК", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТЧ.Колонки.Добавить("ТипКТК", Новый ОписаниеТипов("СправочникСсылка.ТипоразмерыТЕ"));
	
	Возврат ПоместитьВоВременноеХранилище(ТЧ, ГУИД);
	
КонецФункции


&НаКлиенте
Процедура ОткрытьЗаявку(Команда)
	
	ТекД = Элементы.КТКНаПодходе.ТекущиеДанные;
	Если ТекД <> неопределено Тогда
		ПоказатьЗначение(, ТекД.Заявка);
	КонецЕсли;
	
КонецПроцедуры

