
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)   
	
	Параметры.Свойство("Фрахт", ЭтотОбъект.Фрахт);
	Параметры.Свойство("Авто", ЭтотОбъект.Авто);
	Параметры.Свойство("СчетФактура", ЭтотОбъект.СчетФарктураСсылка);
	
	Элементы.ФормаДобавить.Доступность = Пользователи.РолиДоступны("dc_РаботаСНДС0");
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьОтображениеКолонок();
	
	ТаблицаФрахтИзменена = Ложь;
	
	Элементы.ЗаполнитьПоПервойСтроке.Видимость = Истина;	
	
	ИзменитьДоступностьТЧПодтверждающиеДокументы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
  
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	
	Если ЗаполнитьПоПервойСтроке Тогда
		 Для Каждого Строка Из ПодтверждающиеДокументы Цикл
			Строка.ВыбратьСтрокуДляЗаполнения = Истина;
		КонецЦикла;
	Иначе
		Если ВидПеревозки = ПредопределенноеЗначение("Справочник.ВидыПеревозок.ИмпортМоре") Или ВидПеревозки = ПредопределенноеЗначение("Справочник.ВидыПеревозок.ЭкспортМоре") Тогда
			Для каждого Строка Из ПодтверждающиеДокументы Цикл
				ЕстьДокПоМорскомуТранспорту = ПроверитьНаличиеДокументовПоМорскомуТранспорту(Строка);
				Если ЕстьДокПоМорскомуТранспорту Тогда
					Строка.ДокументыЕсть = Истина;
				Иначе
					Строка.ДокументыЕсть = Ложь;
				КонецЕсли;
			КонецЦикла;
		Иначе
			Для каждого Строка Из ПодтверждающиеДокументы Цикл
				Строка.ДокументыЕсть = Истина;	
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)

	Для каждого Строка Из ПодтверждающиеДокументы Цикл
		Если ЗаполнитьПоПервойСтроке Тогда
			Строка.ВыбратьСтрокуДляЗаполнения = Ложь;			
		Иначе
			Строка.ДокументыЕсть = Ложь;
		КонецЕсли;
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеКолонок()
	
	Если ВидПеревозки = ПредопределенноеЗначение("Справочник.ВидыПеревозок.Транзит") 
			Или ВидПеревозки = ПредопределенноеЗначение("Справочник.ВидыПеревозок.ТранзитМоре")
		Тогда
		Элементы.ПодтверждающиеДокументыВходнаяСтанция.Видимость = Истина;	
		Элементы.ПодтверждающиеДокументыВыходнаяСтанция.Видимость = Истина;
	Иначе	
		Элементы.ПодтверждающиеДокументыВходнаяСтанция.Видимость = Ложь;	
		Элементы.ПодтверждающиеДокументыВыходнаяСтанция.Видимость = Ложь;
	КонецЕсли;
	Элементы.ПодтверждающиеДокументы.Видимость = НЕ Фрахт;
	Элементы.МорскойТранспорт.Видимость = НЕ Фрахт;
	Элементы.ТаблицаФрахт.Видимость = Фрахт;
	
КонецПроцедуры

#Область ТаблицаПодтверждающиеДокументы

&НаКлиенте
Процедура ПодтверждающиеДокументыПриАктивизацииСтроки(Элемент)
	
	Если Элементы.ПодтверждающиеДокументы.ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли; 
	
	УстановитьОтборПоЖДН(Элементы.ПодтверждающиеДокументы.ТекущиеДанные.КлючСтроки);  
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтверждающиеДокументыНомерГТДОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	ДлинаНомера = СтрДлина(Текст);
	Если ДлинаНомера > 0 И ДлинаНомера <> 23 Тогда
		ТекСтрока = Элементы.ПодтверждающиеДокументы.ТекущиеДанные;
		Поле = СтрШаблон("ПодтверждающиеДокументы[%1].НомерГТД", ТекСтрока.НомерСтроки - 1);
		ТекстСообщения = СтрШаблон("Номер ГТД должен состоять из 23 знаков! Введено %1.", Строка(ДлинаНомера));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, Поле);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтверждающиеДокументыДокументыЕстьПриИзменении(Элемент)
	
	ТекДанные = Элементы.ПодтверждающиеДокументы.ТекущиеДанные;
	Если ТекДанные.ДокументыЕсть И (ВидПеревозки = ПредопределенноеЗначение("Справочник.ВидыПеревозок.ИмпортМоре") Или ВидПеревозки = ПредопределенноеЗначение("Справочник.ВидыПеревозок.ЭкспортМоре")) Тогда
		ЕстьДокПоМорскомуТранспорту = ПроверитьНаличиеДокументовПоМорскомуТранспорту(ТекДанные);
		Если Не ЕстьДокПоМорскомуТранспорту Тогда
			ТекДанные.ДокументыЕсть = Ложь;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указаны документы по морскому транспорту!");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтверждающиеДокументыПриИзменении(Элемент)
	Если ЗаполнитьПоПервойСтроке И Элемент.ТекущийЭлемент.Имя <> "ПодтверждающиеДокументыВыбратьСтрокуДляЗаполнения"
		И Элемент.ТекущиеДанные.ВыбратьСтрокуДляЗаполнения Тогда
		ИмяТЧ = Элемент.Имя;
		ИмяПоля = Сред(Элемент.ТекущийЭлемент.Имя, СтрДлина(ИмяТЧ)+1);
		
		НовоеЗначение = Элементы.ПодтверждающиеДокументы.ТекущиеДанные[ИмяПоля];
	    ЗаполнитьПодтверждающиеДокументыПоПервойСтроке(ИмяПоля,НовоеЗначение);
	КонецЕсли;	
		
КонецПроцедуры

#КонецОбласти 

#Область ТаблицаМорскойТранспорт

 &НаКлиенте
Процедура МорскойТранспортПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И Не Элементы.ПодтверждающиеДокументы.ТекущиеДанные = Неопределено Тогда
		Элементы.МорскойТранспорт.ТекущиеДанные.КлючСтроки = Элементы.ПодтверждающиеДокументы.ТекущиеДанные.КлючСтроки;
		Элементы.МорскойТранспорт.ТекущиеДанные.ВыбратьДляПереноса = Элементы.ПодтверждающиеДокументы.ТекущиеДанные.ВыбратьДляПереноса;
	КонецЕсли; 
	Элементы.МорскойТранспорт.ТекущиеДанные.НомерСтроки = МорскойТранспорт.Количество();

КонецПроцедуры

&НаКлиенте
Процедура МорскойТранспортПортРазгрузкиПриИзменении(Элемент)
	
	ТекДанные = Элементы.МорскойТранспорт.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекДанные.ПортРазгрузки) Тогда
		СтранаРазгрузки = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(ТекДанные.ПортРазгрузки, "Страна");
		Если ЗначениеЗаполнено(СтранаРазгрузки) Тогда
			ТекДанные.СтранаРазгрузки = СтранаРазгрузки;
		Иначе ТекДанные.СтранаРазгрузки = Неопределено;
		КонецЕсли;
	Иначе ТекДанные.СтранаРазгрузки = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МорскойТранспортКоносаментПриИзменении(Элемент)
	
	ТекДанные = Элементы.МорскойТранспорт.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекДанные.Коносамент) Тогда
		ДанныеКоносамента = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(ТекДанные.Коносамент, "НомерТранспортногоДокумента, ДатаТранспортногоДокумента, Судно");
		Если ЗначениеЗаполнено(ДанныеКоносамента.НомерТранспортногоДокумента) Тогда
			ТекДанные.НомерДокумента = ДанныеКоносамента.НомерТранспортногоДокумента;
		Иначе ТекДанные.НомерДокумента = "";
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеКоносамента.ДатаТранспортногоДокумента) Тогда
			ТекДанные.ДатаДокумента = ДанныеКоносамента.ДатаТранспортногоДокумента;
		Иначе ТекДанные.ДатаДокумента = Неопределено;
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеКоносамента.Судно) Тогда
			ТекДанные.Судно = ДанныеКоносамента.Судно;
		Иначе ТекДанные.Судно = Неопределено;
		КонецЕсли;
	Иначе 
		ТекДанные.НомерДокумента = "";
		ТекДанные.ДатаДокумента = Неопределено;
		ТекДанные.Судно = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МорскойТранспортПриИзменении(Элемент)
	текДанные = Элементы.МорскойТранспорт.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		Для каждого СтрокаДанные Из МорскойТранспорт Цикл
			Если СтрокаДанные.Коносамент = текДанные.Коносамент
				И СтрокаДанные.ТипДокумента = текДанные.ТипДокумента
				И СтрокаДанные.НомерДокумента = текДанные.НомерДокумента Тогда
				ЗаполнитьЗначенияСвойств(СтрокаДанные, текДанные,,"КлючСтроки");
			КонецЕсли; 
		КонецЦикла;
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура МорскойТранспортПортПогрузкиПриИзменении(Элемент)
	ТекДанные = Элементы.МорскойТранспорт.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекДанные.ПортПогрузки) Тогда
		СтранаПогрузки = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(ТекДанные.ПортПогрузки, "Страна");
		Если ЗначениеЗаполнено(СтранаПогрузки) Тогда
			ТекДанные.СтранаПогрузки = СтранаПогрузки;
		Иначе ТекДанные.СтранаПогрузки = Неопределено;
		КонецЕсли;
	Иначе ТекДанные.СтранаПогрузки = Неопределено;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Коносаменты_ОтметитьВсе(Команда)
	Если Элементы.МорскойТранспорт.ОтборСтрок <> Неопределено Тогда     
		КлючСтроки = Элементы.МорскойТранспорт.ОтборСтрок["КлючСтроки"];
		СтрокиТаб = МорскойТранспорт.НайтиСтроки(Новый Структура("КлючСтроки", КлючСтроки)); 
		Для каждого СтрокаМорскогоТранспорта Из СтрокиТаб Цикл
			СтрокаМорскогоТранспорта.ВыбратьДляПереноса = Истина;	
		КонецЦикла;
	Иначе	
	    Для каждого СтрокаМорскогоТранспорта Из МорскойТранспорт Цикл
			СтрокаМорскогоТранспорта.ВыбратьДляПереноса = Истина;	
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Коносаменты_СнятьВсе(Команда)
	Если Элементы.МорскойТранспорт.ОтборСтрок <> Неопределено Тогда
		КлючСтроки = Элементы.МорскойТранспорт.ОтборСтрок["КлючСтроки"];
		СтрокиТаб = МорскойТранспорт.НайтиСтроки(Новый Структура("КлючСтроки", КлючСтроки)); 
		Для каждого СтрокаМорскогоТранспорта Из СтрокиТаб Цикл
			СтрокаМорскогоТранспорта.ВыбратьДляПереноса = Ложь;	
		КонецЦикла;
	Иначе	
	    Для каждого СтрокаМорскогоТранспорта Из МорскойТранспорт Цикл
			СтрокаМорскогоТранспорта.ВыбратьДляПереноса = Ложь;	
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти   

#Область ТаблицаФрахт

&НаКлиенте
Процедура ТаблицаФрахтПослеУдаления(Элемент)
	ТаблицаФрахтИзменена = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФрахтПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)  
	
	Если Не ОтменаРедактирования 
		И (Не ЗначениеЗаполнено(Элемент.ТекущиеДанные.ТипДокумента)
		ИЛИ Не ЗначениеЗаполнено(Элемент.ТекущиеДанные.НомерДокумента)) Тогда
		ПоказатьПредупреждение(,"Необходимо заполнить поля «ТипДокумента», «НомерДокумента»",20);
		Отказ = Истина;
	КонецЕсли; 
	
	Если НоваяСтрока Тогда
		Элемент.ТекущиеДанные.КлючСтроки = Новый УникальныйИдентификатор;
	КонецЕсли;
	Если Не ОтменаРедактирования Тогда
		ТаблицаФрахтИзменена = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсеТабФрахт(Команда)
	
	Для Каждого Строка Из ТаблицаФрахт Цикл
		Строка.ВыбратьДляПереноса = Истина; 
		ПоискПодтв = ПодтверждающиеДокументы.НайтиСтроки(Новый Структура("КлючСтроки", Строка.КлючСтроки));
		Для каждого СтрПодтв Из ПоискПодтв Цикл
			СтрПодтв.ВыбратьДляПереноса = Истина;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте
Процедура СнятьВсеТабФрахт(Команда)

	Для каждого Строка Из ТаблицаФрахт Цикл
		Строка.ВыбратьДляПереноса = Ложь;	
		ПоискПодтв = ПодтверждающиеДокументы.НайтиСтроки(Новый Структура("КлючСтроки", Строка.КлючСтроки));
		Для каждого СтрПодтв Из ПоискПодтв Цикл
			СтрПодтв.ВыбратьДляПереноса = Ложь;
		КонецЦикла;
	КонецЦикла; 
	
КонецПроцедуры 

&НаКлиенте
Процедура ТаблицаФрахтПриИзменении(Элемент)
	Если ЗаполнитьПоПервойСтроке И Элемент.ТекущийЭлемент.Имя <> "ТаблицаФрахтВыбратьСтрокуДляЗаполнения"
		И Элемент.ТекущиеДанные.ВыбратьСтрокуДляЗаполнения Тогда
		ИмяТЧ = Элемент.Имя;
		ИмяПоля = Сред(Элемент.ТекущийЭлемент.Имя, СтрДлина(ИмяТЧ)+1);
		
		НовоеЗначение = Элементы.ТаблицаФрахт.ТекущиеДанные[ИмяПоля];
	    ЗаполнитьТаблицуФрахтПоПервойСтроке(ИмяПоля,НовоеЗначение);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФрахтПриАктивизацииСтроки(Элемент)
	Если Элементы.ТаблицаФрахт.ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура УстановитьОтборПоЖДН(КлючСтроки)
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("КлючСтроки", Элементы.ПодтверждающиеДокументы.ТекущиеДанные.КлючСтроки);
	Элементы.МорскойТранспорт.ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураПоиска); 	
	
	//Коносаменты_СнятьВсе(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьОтбор(Команда)
	
	Элементы.МорскойТранспорт.ОтборСтрок = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура Добавить(Команда)
	
	Отказ = Ложь;
	
	Если не ЗначениеЗаполнено(ВыбраннаяИСФ) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбрана ИСФ для добавления строк ГТД!",,,"ВыбраннаяИСФ",Отказ);
	КонецЕсли;
	
	//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 109048 Начало 11.06.2025
	//Если ЗначениеЗаполнено(ВыбраннаяИСФ) и СписокДобавленныхИСФ.НайтиПоЗначению(ВыбраннаяИСФ) <> Неопределено Тогда
	Если ПодтверждающиеДокументы.Количество() <> 0 и ЗначениеЗаполнено(ВыбраннаяИСФ) 
		и СписокДобавленныхИСФ.НайтиПоЗначению(ВыбраннаяИСФ) <> Неопределено Тогда
	//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 109048 Конец 11.06.2025
		ОбщегоНазначенияКлиент.СообщитьПользователю("По выбранной ИСФ строки ГТД уже были добавлены!",,,"ВыбраннаяИСФ",Отказ);	
	КонецЕсли;
	
	Если Отказ = Истина Тогда
		Возврат;
	КонецЕсли;   
	
	ДобавитьСтрокиГТДизИСФ(ВыбраннаяИСФ);
	
	СписокДобавленныхИСФ.Добавить(ВыбраннаяИСФ);
		
КонецПроцедуры  

&НаСервере
