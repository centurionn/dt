	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СчетФактураВыданныйПодтверждающиеДокументы.ЖДН КАК ЖДН,
		|	СчетФактураВыданныйПодтверждающиеДокументы.Вагон КАК Вагон,
		|	СчетФактураВыданныйПодтверждающиеДокументы.Контейнер КАК Контейнер,
		|	СчетФактураВыданныйПодтверждающиеДокументы.ДокументыЕсть КАК ДокументыЕсть,
		|	СчетФактураВыданныйПодтверждающиеДокументы.СтранаОтправления КАК СтранаОтправления,
		|	СчетФактураВыданныйПодтверждающиеДокументы.СтанцияОтправления КАК СтанцияОтправления,
		|	СчетФактураВыданныйПодтверждающиеДокументы.ВходнаяСтанция КАК ВходнаяСтанция,
		|	СчетФактураВыданныйПодтверждающиеДокументы.СтранаНазначения КАК СтранаНазначения,
		|	СчетФактураВыданныйПодтверждающиеДокументы.СтанцияНазначения КАК СтанцияНазначения,
		|	СчетФактураВыданныйПодтверждающиеДокументы.ВыходнаяСтанция КАК ВыходнаяСтанция,
		|	СчетФактураВыданныйПодтверждающиеДокументы.НомерГТД КАК НомерГТД,
		|	СчетФактураВыданныйПодтверждающиеДокументы.ДатаГТД КАК ДатаГТД,
		|	СчетФактураВыданныйПодтверждающиеДокументы.Транспорт КАК Транспорт,
		|	СчетФактураВыданныйПодтверждающиеДокументы.КлючСтроки КАК КлючСтроки,
		|	СчетФактураВыданныйПодтверждающиеДокументы.ВыбратьСтрокуДляЗаполнения КАК ВыбратьСтрокуДляЗаполнения,
		|	СчетФактураВыданныйПодтверждающиеДокументы.ДатаПодтвержденияНДС0 КАК ДатаПодтвержденияНДС0,
		|	СчетФактураВыданныйПодтверждающиеДокументы.ВключатьВОтчетДляФНС КАК ВключатьВОтчетДляФНС,
		|	СчетФактураВыданныйПодтверждающиеДокументы.СуммаПоКТК КАК СуммаПоКТК,
		|	СчетФактураВыданныйПодтверждающиеДокументы.ДатаОтчетаДляФНС КАК ДатаОтчетаДляФНС,
		|	СчетФактураВыданныйПодтверждающиеДокументы.РегНомерТранзитнойДекларации КАК РегНомерТранзитнойДекларации
		|ИЗ
		|	Документ.СчетФактураВыданный.ПодтверждающиеДокументы КАК СчетФактураВыданныйПодтверждающиеДокументы
		|ГДЕ
		|	СчетФактураВыданныйПодтверждающиеДокументы.Ссылка = &ВыбраннаяИСФ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СчетФактураВыданныйМорскойТранспорт.КлючСтроки КАК КлючСтроки,
		|	СчетФактураВыданныйМорскойТранспорт.ТипДокумента КАК ТипДокумента,
		|	СчетФактураВыданныйМорскойТранспорт.НомерДокумента КАК НомерДокумента,
		|	СчетФактураВыданныйМорскойТранспорт.ДатаДокумента КАК ДатаДокумента,
		|	СчетФактураВыданныйМорскойТранспорт.Судно КАК Судно,
		|	СчетФактураВыданныйМорскойТранспорт.ДатаРазрешенияПогрузки КАК ДатаРазрешенияПогрузки,
		|	СчетФактураВыданныйМорскойТранспорт.ПортРазгрузки КАК ПортРазгрузки,
		|	СчетФактураВыданныйМорскойТранспорт.СтранаРазгрузки КАК СтранаРазгрузки,
		|	СчетФактураВыданныйМорскойТранспорт.Коносамент КАК Коносамент,
		|	СчетФактураВыданныйМорскойТранспорт.ПортПогрузки КАК ПортПогрузки,
		|	СчетФактураВыданныйМорскойТранспорт.СтранаПогрузки КАК СтранаПогрузки,
		|	СчетФактураВыданныйМорскойТранспорт.НомерГТД КАК НомерГТД,
		|	СчетФактураВыданныйМорскойТранспорт.ДатаПодтвержденияНДС0 КАК ДатаПодтвержденияНДС0,
		|	СчетФактураВыданныйМорскойТранспорт.ВключатьВОтчетДляФНС КАК ВключатьВОтчетДляФНС,
		|	СчетФактураВыданныйМорскойТранспорт.СуммаПоКТК КАК СуммаПоКТК,
		|	СчетФактураВыданныйМорскойТранспорт.ДатаОтчетаДляФНС КАК ДатаОтчетаДляФНС,
		|	СчетФактураВыданныйМорскойТранспорт.Контейнер КАК Контейнер,
		|	СчетФактураВыданныйМорскойТранспорт.ДокументыЕсть КАК ДокументыЕсть,
		|	СчетФактураВыданныйМорскойТранспорт.РегНомерТранзитнойДекларации КАК РегНомерТранзитнойДекларации
		|ИЗ
		|	Документ.СчетФактураВыданный.МорскойТранспорт КАК СчетФактураВыданныйМорскойТранспорт
		|ГДЕ
		|	СчетФактураВыданныйМорскойТранспорт.Ссылка = &ВыбраннаяИСФ";
	
	Запрос.УстановитьПараметр("ВыбраннаяИСФ", ВыбраннаяИСФСсылка);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаСуша = РезультатыЗапроса[0].Выбрать();     
	ВыборкаФрахт = РезультатыЗапроса[1].Выбрать();
	
	Если не Авто и не Фрахт Тогда  
		//Сухопутная перевозка, заполняем ТЧ ПодтверждающиеДокументы и ТЧ МорскойТранспорт  
		НомерСтрокиСуша = ПодтверждающиеДокументы.Количество() + 1;
		НомерСтрокиФрахт = МорскойТранспорт.Количество() + 1;
		Пока ВыборкаСуша.Следующий() Цикл
			
			НС = ПодтверждающиеДокументы.Добавить(); 
			НС.НомерСтроки = НомерСтрокиСуша;
			НС.ВыбратьДляПереноса = Истина;
			ЗаполнитьЗначенияСвойств(НС, ВыборкаСуша);
			
			СтруктураПоискаСтрокТранспорта = Новый Структура("КлючСтроки", НС.КлючСтроки);
			Пока ВыборкаФрахт.НайтиСледующий(СтруктураПоискаСтрокТранспорта) Цикл
				НС_Трансп = МорскойТранспорт.Добавить();
				НС_Трансп.НомерСтроки = НомерСтрокиФрахт; 
				НС_Трансп.ВыбратьДляПереноса = Истина;
				ЗаполнитьЗначенияСвойств(НС_Трансп, ВыборкаФрахт);
				
				НомерСтрокиФрахт = НомерСтрокиФрахт + 1;
			КонецЦикла;	
			ВыборкаФрахт.Сбросить();
			
			НомерСтрокиСуша = НомерСтрокиСуша + 1;
			
		КонецЦикла;   
		
	ИначеЕсли не Авто и Фрахт Тогда 
		//Морская перевозка, заполняем ТаблицаФрахт и ПодтверждающиеДокументы
		
		НомерСтрокиФрахт = ТаблицаФрахт.Количество() + 1;
		Пока ВыборкаФрахт.Следующий() Цикл
			НС_Фрахт = ТаблицаФрахт.Добавить();
			НС_Фрахт.НомерСтроки = НомерСтрокиФрахт;  
			НС_Фрахт.ВыбратьДляПереноса = Истина;
			ЗаполнитьЗначенияСвойств(НС_Фрахт, ВыборкаФрахт);
			
			НомерСтрокиФрахт = НомерСтрокиФрахт + 1;
			
			ТаблицаФрахтИзменена = Истина;
		КонецЦикла;  
		
		НомерСтрокиСуша = ПодтверждающиеДокументы.Количество() + 1;
		Пока ВыборкаСуша.Следующий() Цикл
			
			НС = ПодтверждающиеДокументы.Добавить(); 
			НС.НомерСтроки = НомерСтрокиСуша;   
			НС.ВыбратьДляПереноса = Истина;
			ЗаполнитьЗначенияСвойств(НС, ВыборкаСуша);
			
			НомерСтрокиСуша = НомерСтрокиСуша + 1;
			
		КонецЦикла;  
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПроверитьНаличиеДокументовПоМорскомуТранспорту(СтрокаПоПодтверждающемуДокументу)
	
	Результат = Ложь;
	
	СтрокиМорскойТранспорт = МорскойТранспорт.НайтиСтроки(Новый Структура("КлючСтроки", СтрокаПоПодтверждающемуДокументу.КлючСтроки));
	Если СтрокиМорскойТранспорт.Количество() > 0 Тогда
		Результат = ЗначениеЗаполнено(СтрокиМорскойТранспорт[0].Коносамент);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура Перенести(Команда)
	
	АдресВставки = УпаковатьТаблицыДляПередачи();
		
	Закрыть(АдресВставки);

КонецПроцедуры   

&НаСервере
Функция УпаковатьТаблицыДляПередачи()

	СтруктураЗаполненияГТД = Новый Структура("ПодтверждающиеДокументы, МорскойТранспорт, ПодтверждающиеДокументыАвто");
	
	Если ТаблицаФрахтИзменена Тогда
		ОбновитьТЧМорскойТранспорт();  
	КонецЕсли;       
	
	ВыбранныеСтрокиПодтвДок = ПодтверждающиеДокументы.НайтиСтроки(Новый Структура("ВыбратьДляПереноса", Истина)); 
	ВыбранныеСтрокиМорскойТранспорт = МорскойТранспорт.НайтиСтроки(Новый Структура("ВыбратьДляПереноса", Истина));
	
	СтруктураЗаполненияГТД.ПодтверждающиеДокументы 	= ПодтверждающиеДокументы.Выгрузить(ВыбранныеСтрокиПодтвДок);
	СтруктураЗаполненияГТД.МорскойТранспорт 		= МорскойТранспорт.Выгрузить(ВыбранныеСтрокиМорскойТранспорт); 

	Возврат ЗначениеВСтрокуВнутр(СтруктураЗаполненияГТД);
	
КонецФункции 

Процедура ОбновитьТЧМорскойТранспорт()
	МорскойТранспорт.Очистить();
	Для Каждого СтрокаФрахт Из ТаблицаФрахт Цикл
		СтрокаМорскойТранспорт = МорскойТранспорт.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаМорскойТранспорт, СтрокаФрахт);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоПервойСтрокеПриИзменении(Элемент)
	ИзменитьДоступностьТЧПодтверждающиеДокументы();
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьДоступностьТЧПодтверждающиеДокументы()
	Элементы.ПодтверждающиеДокументыВагон.ТолькоПросмотр = ЗаполнитьПоПервойСтроке;
	Элементы.ПодтверждающиеДокументыДатаГТД.ТолькоПросмотр = ЗаполнитьПоПервойСтроке;
	Элементы.ПодтверждающиеДокументыДокументыЕсть.ТолькоПросмотр = ЗаполнитьПоПервойСтроке;
	Элементы.ПодтверждающиеДокументыКонтейнер.ТолькоПросмотр = ЗаполнитьПоПервойСтроке;
	Элементы.ПодтверждающиеДокументыТранспорт.ТолькоПросмотр = ЗаполнитьПоПервойСтроке;
	Элементы.ПодтверждающиеДокументыКлючСтроки.ТолькоПросмотр = ЗаполнитьПоПервойСтроке;    
	
	Элементы.ТаблицаФрахтДокументыЕсть.ТолькоПросмотр = ЗаполнитьПоПервойСтроке;
	Элементы.ТаблицаФрахтКонтейнер.ТолькоПросмотр = ЗаполнитьПоПервойСтроке;
    Элементы.ТаблицаФрахтКлючСтроки.ТолькоПросмотр = ЗаполнитьПоПервойСтроке;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПодтверждающиеДокументыПоПервойСтроке(ИмяПоля,НовоеЗначение)
	
	Для Сч = 0 По ПодтверждающиеДокументы.Количество() - 1 Цикл
		РезПроверки = Элементы.ПодтверждающиеДокументы.ПроверитьСтроку(ПодтверждающиеДокументы[Сч].ПолучитьИдентификатор());
		текСтрока = Элементы.ПодтверждающиеДокументы.ДанныеСтроки(ПодтверждающиеДокументы[Сч].ПолучитьИдентификатор());
		Если РезПроверки = Истина И текСтрока.ВыбратьСтрокуДляЗаполнения Тогда
			
			ПодтверждающиеДокументы[Сч][ИмяПоля] = НовоеЗначение;
			
			Если ИмяПоля = "СтранаНазначения" Тогда
				ПодтверждающиеДокументы[Сч]["СтанцияНазначения"]	= ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
			ИначеЕсли ИмяПоля = "СтранаОтправления" Тогда
				ПодтверждающиеДокументы[Сч]["СтанцияОтправления"]	= ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
			КонецЕсли; 
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКДокументу(Команда)
	
	СтрокиМорскогоТранспорта = Новый Массив;
	СтруктураОтбора = Новый Структура("Флаг", Истина); 
	СтрокиКДобавлению = МорскойТранспорт.НайтиСтроки(СтруктураОтбора);  
	Если СтрокиКДобавлению.Количество() = 0 Тогда
		Возврат;
	КонецЕсли; 
	
	СтрутураКоносамента = Новый Структура;
	СтрутураКоносамента.Вставить("СтрокиКоносаментов",СтрокиКДобавлению); 
	
	//Коносаменты_СнятьВсе(Неопределено);
	
	СписокЖДН = Новый СписокЗначений;
	СписокЖДН.Добавить("Ссылка");
	СписокЖДН.Очистить();
	
	Для каждого СтрокаЖДН Из ПодтверждающиеДокументы Цикл
		Если ТекущийСписокЖДН.НайтиПоЗначению(СтрокаЖДН.ЖДН) = Неопределено Тогда
			СписокЖДН.Добавить(Новый Структура("Ссылка, Контейнер", СтрокаЖДН.ЖДН, Строка(СтрокаЖДН.Контейнер)), Строка(СтрокаЖДН.КлючСтроки)); 
		КонецЕсли; 
	КонецЦикла;
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораМорскихЖДНИзСписка", ЭтаФорма, СтрутураКоносамента);
	ОткрытьФорму("ОбщаяФорма.э_ФормаВыбораИзСписка",Новый Структура("Список,Заголовок,ОбъектВладелец",СписокЖДН,"Выберите список ЖДН для добавления морских документов",СчетФарктураСсылка),СчетФарктураСсылка,,,,ОпОп);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораМорскихЖДНИзСписка(Параметр1, Параметр2) Экспорт
	
	Если Параметр1 = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущийСписокЖДН.Очистить();
	Для каждого Элемент Из Параметр1 Цикл
		Если Элемент.Пометка Тогда 
			Для каждого СтрКоносамента Из Параметр2.СтрокиКоносаментов Цикл
				СтрокиМорскойТранспорт = МорскойТранспорт.НайтиСтроки(Новый Структура("Коносамент,КлючСтроки", СтрКоносамента.Коносамент,Элемент.Представление));
				Если СтрокиМорскойТранспорт.Количество() > 0 Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока = МорскойТранспорт.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрКоносамента,,"КлючСтроки");
				НоваяСтрока.КлючСтроки = Элемент.Представление;
			КонецЦикла;
		КонецЕсли; 
	КонецЦикла; 
	
КонецПроцедуры

