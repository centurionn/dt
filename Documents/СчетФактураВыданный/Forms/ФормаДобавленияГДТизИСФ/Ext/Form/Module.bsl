Процедура ЗаполнитьТаблицуФрахтПоПервойСтроке(ИмяПоля,НовоеЗначение)
	
	Для Сч = 0 По ТаблицаФрахт.Количество() - 1 Цикл
		РезПроверки = Элементы.ТаблицаФрахт.ПроверитьСтроку(ТаблицаФрахт[Сч].ПолучитьИдентификатор());
		текСтрока = Элементы.ТаблицаФрахт.ДанныеСтроки(ТаблицаФрахт[Сч].ПолучитьИдентификатор());
		Если РезПроверки = Истина И текСтрока.ВыбратьСтрокуДляЗаполнения Тогда
			
			ТаблицаФрахт[Сч][ИмяПоля] = НовоеЗначение;			
			// ДИТ Поморцева Т.П. 0252360 07.12.21. начало
			Если ИмяПоля = "СтранаПогрузки" Тогда
				ТаблицаФрахт[Сч]["ПортПогрузки"]	= ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
			ИначеЕсли ИмяПоля = "СтранаРазгрузки" Тогда
				ТаблицаФрахт[Сч]["ПортРазгрузки"]	= ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
			КонецЕсли; 
			// ДИТ Поморцева Т.П. 0252360 07.12.21. конец
		КонецЕсли;		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьПодтверждениеЖДНИлиКоносамента()
	
	ЧастичноПодтвержденныеДокументы = Новый Массив;
	
	Если Фрахт Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ПодтверждающиеДокументы.Коносамент,
		|	ПодтверждающиеДокументы.ДатаПодтвержденияНДС0,
		|	ПодтверждающиеДокументы.Контейнер
		|ПОМЕСТИТЬ ВТ_ПодтверждающиеДокументы
		|ИЗ 
		|	Документ.СчетФактураВыданный.МорскойТранспорт КАК ПодтверждающиеДокументы  
		|ГДЕ
		|	ПодтверждающиеДокументы.Ссылка = &Ссылка
		|;
		|
		|ВЫБРАТЬ
		|	СчетФактураВыданныйМорскойТранспорт.Коносамент КАК Коносамент,
		|	ТранспортныйДокументКоносаменты.НомерКТК КАК НомерКТК
		|ПОМЕСТИТЬ ВТ_ВременнаяТаблица
		|ИЗ
		|	ВТ_ПодтверждающиеДокументы КАК СчетФактураВыданныйМорскойТранспорт
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент.Коносаменты КАК ТранспортныйДокументКоносаменты
		|		ПО (СчетФактураВыданныйМорскойТранспорт.Коносамент = ТранспортныйДокументКоносаменты.Ссылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_ВременнаяТаблица.Коносамент КАК ТранспортныйДокумент,
		|	ВТ_ВременнаяТаблица.НомерКТК КАК Контейнер,
		|	ЕСТЬNULL(СчетФактураВыданныйМорскойТранспорт.ДатаПодтвержденияНДС0, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДатаПодтвержденияНДС0
		|ИЗ
		|	ВТ_ВременнаяТаблица КАК ВТ_ВременнаяТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПодтверждающиеДокументы КАК СчетФактураВыданныйМорскойТранспорт
		|		ПО (ВТ_ВременнаяТаблица.НомерКТК = СчетФактураВыданныйМорскойТранспорт.Контейнер)
		|ИТОГИ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ НомерКТК)
		|ПО
		|	ТранспортныйДокумент";  
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.СчетФактураВыданный.МорскойТранспорт КАК ПодтверждающиеДокументы", 
												 "&ПодтверждающиеДокументы КАК ПодтверждающиеДокументы");  
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ГДЕ
		|	ПодтверждающиеДокументы.Ссылка = &Ссылка", ""); 
		
		Запрос.УстановитьПараметр("ПодтверждающиеДокументы", МорскойТранспорт.Выгрузить(,"Коносамент, Контейнер, ДатаПодтвержденияНДС0")); 
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ПодтверждающиеДокументы.ЖДН,
		|	ПодтверждающиеДокументы.ДатаПодтвержденияНДС0,
		|	ПодтверждающиеДокументы.Контейнер
		|ПОМЕСТИТЬ ВТ_ПодтверждающиеДокументы
		|ИЗ 
		|	Документ.СчетФактураВыданный.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы  
		|ГДЕ
		|	ПодтверждающиеДокументы.Ссылка = &Ссылка
		|;
		|		
		|ВЫБРАТЬ
		|	СчетФактураВыданныйПодтверждающиеДокументы.ЖДН КАК ЖДН,
		|	ТранспортныйДокументУчетныеЕдиницы.Контейнер КАК Контейнер
		|ПОМЕСТИТЬ ВТ_ВременнаяТаблица
		|ИЗ
		|	ВТ_ПодтверждающиеДокументы КАК СчетФактураВыданныйПодтверждающиеДокументы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент.УчетныеЕдиницы КАК ТранспортныйДокументУчетныеЕдиницы
		|		ПО (СчетФактураВыданныйПодтверждающиеДокументы.ЖДН = ТранспортныйДокументУчетныеЕдиницы.Ссылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_ВременнаяТаблица.ЖДН КАК ТранспортныйДокумент,
		|	ВТ_ВременнаяТаблица.Контейнер КАК Контейнер,
		|	ЕСТЬNULL(СчетФактураВыданныйПодтверждающиеДокументы.ДатаПодтвержденияНДС0, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДатаПодтвержденияНДС0
		|ИЗ
		|	ВТ_ВременнаяТаблица КАК ВТ_ВременнаяТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПодтверждающиеДокументы КАК СчетФактураВыданныйПодтверждающиеДокументы
		|		ПО (ВТ_ВременнаяТаблица.Контейнер = СчетФактураВыданныйПодтверждающиеДокументы.Контейнер)
		|ИТОГИ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Контейнер)
		|ПО
		|	ТранспортныйДокумент";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.СчетФактураВыданный.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы", 
												 "&ПодтверждающиеДокументы КАК ПодтверждающиеДокументы");  
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ГДЕ
		|	ПодтверждающиеДокументы.Ссылка = &Ссылка", ""); 
		
		Запрос.УстановитьПараметр("ПодтверждающиеДокументы", ПодтверждающиеДокументы.Выгрузить(,"ЖДН, Контейнер, ДатаПодтвержденияНДС0"));
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаТранспортныйДокумент = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаТранспортныйДокумент.Следующий() Цикл
		КоличествоКонтейнеров = ВыборкаТранспортныйДокумент.Контейнер;
		Если ВыборкаТранспортныйДокумент.Контейнер = 1 Тогда
			Продолжить;
		КонецЕсли;
		ВыборкаКТК = ВыборкаТранспортныйДокумент.Выбрать();
		ПодтвержденныеКонтейнеры = Новый Массив;
		Пока ВыборкаКТК.Следующий() Цикл
			Если ЗначениеЗаполнено(ВыборкаКТК.ДатаПодтвержденияНДС0) Тогда
				Если ПодтвержденныеКонтейнеры.Найти(ВыборкаКТК.Контейнер) = Неопределено Тогда
					ПодтвержденныеКонтейнеры.Добавить(ВыборкаКТК.Контейнер);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если ПодтвержденныеКонтейнеры.Количество() <> 0 Тогда
			Если КоличествоКонтейнеров <> ПодтвержденныеКонтейнеры.Количество() Тогда
				ЧастичноПодтвержденныеДокументы.Добавить(ВыборкаТранспортныйДокумент.ТранспортныйДокумент);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЧастичноПодтвержденныеДокументы;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСуммыПоКТК()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫБОР
	|		КОГДА РеализацияТоваровУслугРасшифровкаУслугПоТС.Ссылка ЕСТЬ NULL
	|			ТОГДА КорректировкаРеализацииРасшифровкаУслугПоТС.Цена
	|		ИНАЧЕ РеализацияТоваровУслугРасшифровкаУслугПоТС.Сумма
	|	КОНЕЦ КАК Сумма,
	|	ВЫБОР
	|		КОГДА РеализацияТоваровУслугРасшифровкаУслугПоТС.Ссылка ЕСТЬ NULL
	|			ТОГДА КорректировкаРеализацииРасшифровкаУслугПоТС.Контейнер
	|		ИНАЧЕ РеализацияТоваровУслугРасшифровкаУслугПоТС.Контейнер
	|	КОНЕЦ КАК Контейнер
	|ИЗ
	|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|		ПО СчетФактураВыданный.Ссылка = СчетФактураВыданныйДокументыОснования.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.РасшифровкаУслугПоТС КАК РеализацияТоваровУслугРасшифровкаУслугПоТС
	|		ПО (РеализацияТоваровУслугРасшифровкаУслугПоТС.Ссылка = СчетФактураВыданныйДокументыОснования.ДокументОснование)
	|			И (РеализацияТоваровУслугРасшифровкаУслугПоТС.СтавкаНДС = &СтавкаНДС)
	|			И (РеализацияТоваровУслугРасшифровкаУслугПоТС.Услуга = &Услуга)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации.РасшифровкаУслугПоТС КАК КорректировкаРеализацииРасшифровкаУслугПоТС
	|		ПО (КорректировкаРеализацииРасшифровкаУслугПоТС.Ссылка = СчетФактураВыданныйДокументыОснования.ДокументОснование)
	|			И (КорректировкаРеализацииРасшифровкаУслугПоТС.СтавкаНДСДоИзменения = &СтавкаНДС)
	|			И (КорректировкаРеализацииРасшифровкаУслугПоТС.Услуга = &Услуга)
	|ГДЕ
	|	СчетФактураВыданный.Ссылка = &Ссылка
	|	И (НЕ РеализацияТоваровУслугРасшифровкаУслугПоТС.Ссылка ЕСТЬ NULL
	|		ИЛИ НЕ КорректировкаРеализацииРасшифровкаУслугПоТС.Ссылка ЕСТЬ NULL)";
	
	Запрос.УстановитьПараметр("СтавкаНДС", Перечисления.СтавкиНДС.НДС0);
	Запрос.УстановитьПараметр("Услуга", Константы.УслугаФрахтаДляКалькуляции.Получить());
	Запрос.УстановитьПараметр("Ссылка", СчетФарктураСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
		
	Пока Выборка.Следующий() Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("Контейнер", Выборка.Контейнер);
		Если Фрахт Тогда
			НайденныеСтроки = ТаблицаФрахт.НайтиСтроки(Отбор);
		Иначе
			НайденныеСтроки = ПодтверждающиеДокументы.НайтиСтроки(Отбор);
		КонецЕсли;
		Для Каждого Строка Из НайденныеСтроки Цикл
			Строка.СуммаПоКТК = Выборка.Сумма;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ВыбраннаяИСФАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = ПолучитьДанныеАвтоподбораРасширенные(Текст);
	
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ПолучитьДанныеАвтоподбораРасширенные(СтрокаПоиска)

	Возврат Документы.СчетФактураВыданный.ПолучитьДанныеВыбора(Новый Структура("СтрокаПоиска, ВводПоСтрокеРасширенный", СтрокаПоиска, Истина));	

КонецФункции


&НаКлиенте
Процедура КПереносуУстановить(Команда)
	Для каждого СтрПодтверждающих Из ПодтверждающиеДокументы Цикл   
		СтрПодтверждающих.ВыбратьДляПереноса = Истина;
		ПоискТранспорта = МорскойТранспорт.НайтиСтроки(Новый Структура("КлючСтроки", СтрПодтверждающих.КлючСтроки));
		Для каждого СтрТранспорт Из ПоискТранспорта Цикл
			СтрТранспорт.ВыбратьДляПереноса = Истина;
		КонецЦикла;	
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура КПереносуСнять(Команда)
	Для каждого СтрПодтверждающих Из ПодтверждающиеДокументы Цикл   
		СтрПодтверждающих.ВыбратьДляПереноса = Ложь;
		ПоискТранспорта = МорскойТранспорт.НайтиСтроки(Новый Структура("КлючСтроки", СтрПодтверждающих.КлючСтроки));
		Для каждого СтрТранспорт Из ПоискТранспорта Цикл
			СтрТранспорт.ВыбратьДляПереноса = Ложь;
		КонецЦикла;	
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПодтверждающиеДокументыВыбратьДляПереносаПриИзменении(Элемент)
	ТекСтрока = Элементы.ПодтверждающиеДокументы.ТекущиеДанные;
	Если ТекСтрока <> Неопределено Тогда
		ПоискТранспорта = МорскойТранспорт.НайтиСтроки(Новый Структура("КлючСтроки", ТекСтрока.КлючСтроки));
		Для каждого СтрТранспорт Из ПоискТранспорта Цикл
			СтрТранспорт.ВыбратьДляПереноса = ТекСтрока.ВыбратьДляПереноса;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

