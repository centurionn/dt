&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	СтрокиБезДокументов = Объект.ПодтверждающиеДокументы.НайтиСтроки(Новый Структура("ДокументыЕсть", Ложь));
	Если Объект.ПодтверждающиеДокументы.Количество() > 0 И СтрокиБезДокументов.Количество() = 0 И Не ЗначениеЗаполнено(Объект.УдалитьДатаПолногоПодтвержденияНДС0) Тогда
		Объект.ПодтверждающиеДокументы.Сортировать("ДатаГТД Убыв");
		Объект.УдалитьДатаПолногоПодтвержденияНДС0 = Объект.ПодтверждающиеДокументы[0].ДатаГТД;
	ИначеЕсли ЗначениеЗаполнено(Объект.УдалитьДатаПолногоПодтвержденияНДС0) Тогда 
		Объект.УдалитьДатаПолногоПодтвержденияНДС0 = Неопределено;
	КонецЕсли;
	
	//ЭтаФорма.Закрыть(ЭтотОбъект);
	
КонецПроцедуры


&НаКлиенте
Процедура ОтметитьВсе(Команда)
	
	//Евросиб Каблов 30.06.2021 ( Ticket#0203749
	//Для каждого Строка Из Объект.ПодтверждающиеДокументы Цикл
	//	Строка.ДокументыЕсть = Истина;	
	//КонецЦикла;
	
	// ДИТ Поморцева Т.П. Задача 37207 27.09.21. начало
	Если ЗаполнитьПоПервойСтроке Тогда
		 Для Каждого Строка Из Объект.ПодтверждающиеДокументы Цикл
			Строка.ВыбратьСтрокуДляЗаполнения = Истина;
		КонецЦикла;
	Иначе
	// ДИТ Поморцева Т.П. Задача 37207 27.09.21. конец
	
		Если Объект.ВидПеревозки = ПредопределенноеЗначение("Справочник.ВидыПеревозок.ИмпортМоре") Или Объект.ВидПеревозки = ПредопределенноеЗначение("Справочник.ВидыПеревозок.ЭкспортМоре") Тогда
			Для каждого Строка Из Объект.ПодтверждающиеДокументы Цикл
				ЕстьДокПоМорскомуТранспорту = ПроверитьНаличиеДокументовПоМорскомуТранспорту(Строка);
				Если ЕстьДокПоМорскомуТранспорту Тогда
					Строка.ДокументыЕсть = Истина;
				Иначе
					Строка.ДокументыЕсть = Ложь;
				КонецЕсли;
			КонецЦикла;
		Иначе
			Для каждого Строка Из Объект.ПодтверждающиеДокументы Цикл
				Строка.ДокументыЕсть = Истина;	
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	//Евросиб Каблов 30.06.2021 ) 
	
КонецПроцедуры


&НаКлиенте
Процедура СнятьВсе(Команда)

	Для каждого Строка Из Объект.ПодтверждающиеДокументы Цикл
		// ДИТ Поморцева Т.П. Задача 37207 27.09.21. начало
		Если ЗаполнитьПоПервойСтроке Тогда
			Строка.ВыбратьСтрокуДляЗаполнения = Ложь;			
		Иначе
		// ДИТ Поморцева Т.П. Задача 37207 27.09.21. конец

			Строка.ДокументыЕсть = Ложь;
		КонецЕсли;
	КонецЦикла; 
	
КонецПроцедуры


