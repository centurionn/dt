Процедура ПослеДобавленияДанныхИзИСФ(АдресДобавленныеСтроки, ПараметрыВыбора) Экспорт

	Если ЗначениеЗаполнено(АдресДобавленныеСтроки) Тогда
		
		ПослеПолученияДанныхЗаполнения = Новый ОписаниеОповещения("ПослеВопросаПерезаполнитьДополнить", ЭтаФорма, АдресДобавленныеСтроки);
		ТекстВопроса = "Очистить таблицы ГТД и вставить строки подтверждения из выбранных ИСФ (ЗАМЕНИТЬ) или добавить строки к имеющимся (ДОПОЛНИТЬ)?";
		КнопкиОтветов = Новый СписокЗначений;
		КнопкиОтветов.Добавить(КодВозвратаДиалога.Да, "Заменить");
		КнопкиОтветов.Добавить(КодВозвратаДиалога.Нет, "Дополнить");
		КнопкиОтветов.Добавить(КодВозвратаДиалога.Отмена, "Отмена");
		ПоказатьВопрос(ПослеПолученияДанныхЗаполнения, ТекстВопроса, КнопкиОтветов,,,"Вставка ГТД из ИСФ");
	
	КонецЕсли;	

КонецПроцедуры

//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 107705 23.04.2025
&НаКлиенте
Процедура ПослеВопросаПерезаполнитьДополнить(Ответ, АдресДобавленныеСтроки) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда 
		ЗаполнитьТаблицыГТДизИСФ(АдресДобавленныеСтроки);	
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		ЗаполнитьТаблицыГТДизИСФ(АдресДобавленныеСтроки, Истина);
	КонецЕсли;
	
КонецПроцедуры

//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 107705 23.04.2025
&НаСервере
Процедура ЗаполнитьТаблицыГТДизИСФ(АдресДобавленныеСтроки, Дополнить = Ложь)
	
	ДобавленныеДанныеГТД = ЗначениеИзСтрокиВнутр(АдресДобавленныеСтроки);
	
	Если Дополнить = Истина Тогда
		Для каждого СтрокаМорскогоТранспорта Из ДобавленныеДанныеГТД.МорскойТранспорт Цикл
			НС = Объект.МорскойТранспорт.Добавить();
			ЗаполнитьЗначенияСвойств(НС, СтрокаМорскогоТранспорта,,"НомерСтроки");
		КонецЦикла; 
		Для каждого СтрокаСуша Из ДобавленныеДанныеГТД.ПодтверждающиеДокументы Цикл
			НС = Объект.ПодтверждающиеДокументы.Добавить();
			ЗаполнитьЗначенияСвойств(НС, СтрокаСуша,,"НомерСтроки");
		КонецЦикла;

	Иначе
		Объект.ПодтверждающиеДокументы.Очистить();
		Объект.МорскойТранспорт.Очистить();
		ТаблицаФрахт.Очистить();
		
		Объект.МорскойТранспорт.Загрузить(ДобавленныеДанныеГТД.МорскойТранспорт);
		Объект.ПодтверждающиеДокументы.Загрузить(ДобавленныеДанныеГТД.ПодтверждающиеДокументы);   
	КонецЕсли;  
	
	ЗаполнитьТаблицуФрахтаНаСервере();

КонецПроцедуры

//Евросиб(ДИТ) Антонова А.С. US 87497 ТА 104722 13.05.2025
&НаКлиенте
Процедура АвтоТранпортОтправительПриИзменении(Элемент)
	
	ТекСтрока = Элементы.АвтоТранпорт.ТекущиеДанные;
	Если ТекСтрока <> Неопределено и ЗначениеЗаполнено(ТекСтрока.Отправитель) Тогда
		РеквизитыКонтрагента = ПолучитьДанныеКонтрагента(ТекСтрока.Отправитель);
		ТекСтрока.Отправитель_ИНН 			= РеквизитыКонтрагента.ИНН;
		ТекСтрока.Отправитель_Наименование 	= РеквизитыКонтрагента.Наименование;
	    ТекСтрока.Отправитель_Адрес 		= РеквизитыКонтрагента.Адрес;
	КонецЕсли;
	
КонецПроцедуры

//Евросиб(ДИТ) Антонова А.С. US 87497 ТА 104722 13.05.2025
Функция ПолучитьДанныеКонтрагента(КонтрагентСсылка)

	РеквизитыКонтрагента = Новый Структура("ИНН, Наименование, Адрес");
	
	ВсеСведения = ПечатьБухгалтерскихДокументов.СведенияОЮрФизЛице(КонтрагентСсылка, ТекущаяДата());
	РеквизитыКонтрагента.ИНН 			= ВсеСведения.ИНН;  
	РеквизитыКонтрагента.Наименование 	= ВсеСведения.ПолноеНаименование;
	РеквизитыКонтрагента.Адрес 			= ВсеСведения.ЮридическийАдрес;
	
	Возврат РеквизитыКонтрагента;
	
КонецФункции 

//Евросиб(ДИТ) Антонова А.С. US 87497 ТА 104722 13.05.2025
&НаКлиенте
Процедура АвтоТранпортПолучательПриИзменении(Элемент)
	
	ТекСтрока = Элементы.АвтоТранпорт.ТекущиеДанные;
	Если ТекСтрока <> Неопределено и ЗначениеЗаполнено(ТекСтрока.Получатель) Тогда
		РеквизитыКонтрагента = ПолучитьДанныеКонтрагента(ТекСтрока.Получатель);
		ТекСтрока.Получатель_ИНН 			= РеквизитыКонтрагента.ИНН;
		ТекСтрока.Получатель_Наименование 	= РеквизитыКонтрагента.Наименование;
	    ТекСтрока.Получатель_Адрес 			= РеквизитыКонтрагента.Адрес;
	КонецЕсли;
	
КонецПроцедуры

