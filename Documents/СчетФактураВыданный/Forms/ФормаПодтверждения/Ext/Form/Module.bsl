&НаКлиенте
Функция ПроверитьНаличиеДокументовПоМорскомуТранспорту(СтрокаПоПодтверждающемуДокументу)
	
	Результат = Ложь;
	
	СтрокиМорскойТранспорт = Объект.МорскойТранспорт.НайтиСтроки(Новый Структура("КлючСтроки", СтрокаПоПодтверждающемуДокументу.КлючСтроки));
	Если СтрокиМорскойТранспорт.Количество() > 0 Тогда
		Результат = ЗначениеЗаполнено(СтрокиМорскойТранспорт[0].Коносамент);
	КонецЕсли;
	
	Возврат Результат;
	
