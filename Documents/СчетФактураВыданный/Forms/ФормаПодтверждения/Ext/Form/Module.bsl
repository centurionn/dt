&НаКлиенте
Процедура МорскойТранспортКоносаментПриИзменении(Элемент)
	
	ТекДанные = Элементы.МорскойТранспорт.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекДанные.Коносамент) Тогда
		ДанныеКоносамента = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(ТекДанные.Коносамент, "НомерТранспортногоДокумента, ДатаТранспортногоДокумента, Судно");
		Если ЗначениеЗаполнено(ДанныеКоносамента.НомерТранспортногоДокумента) Тогда
			ТекДанные.НомерДокумента = ДанныеКоносамента.НомерТранспортногоДокумента;
		Иначе ТекДанные.НомерДокумента = "";
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеКоносамента.ДатаТранспортногоДокумента) Тогда
			ТекДанные.ДатаДокумента = ДанныеКоносамента.ДатаТранспортногоДокумента;
		Иначе ТекДанные.ДатаДокумента = Неопределено;
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеКоносамента.Судно) Тогда
			ТекДанные.Судно = ДанныеКоносамента.Судно;
		Иначе ТекДанные.Судно = Неопределено;
		КонецЕсли;
	Иначе 
		ТекДанные.НомерДокумента = "";
		ТекДанные.ДатаДокумента = Неопределено;
		ТекДанные.Судно = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

// ДИТ Поморцева Задача 34586 23.06.2021
Процедура ЗаписьВРегистрКонтрольПолученияДокументовНДС0()
	
	Для Каждого Строка Из Объект.ПодтверждающиеДокументы Цикл
		Если Строка.ЖДН <> Документы.ТранспортныйДокумент.ПустаяСсылка() И Строка.ДокументыЕсть Тогда
			Набор = РегистрыСведений.КонтрольПолученияДокументовНДС0.СоздатьНаборЗаписей();
			Набор.Отбор.ЖДН.Установить(Строка.ЖДН, Истина);
			Набор.Прочитать();
			Для Каждого ЗаписьРегистра Из Набор Цикл
				Если НЕ ЗначениеЗаполнено(ЗаписьРегистра.ДатаПроверки) ИЛИ ЗаписьРегистра.ДатаПроверки = Дата("00010101") Тогда
					ЗаписьРегистра.ДатаПроверки = ТекущаяДата();
					ЗаписьРегистра.КтоПроверил = Пользователи.АвторизованныйПользователь();								
				КонецЕсли;
			КонецЦикла;
			Набор.Записать();
		КонецЕсли;
	КонецЦикла; 
КонецПроцедуры

&НаКлиенте
Процедура ПодтверждающиеДокументыНомерГТДОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	//Евросиб Каблов 30.06.2021 ( Ticket#0203749
	ДлинаНомера = СтрДлина(Текст);
	Если ДлинаНомера > 0 И ДлинаНомера <> 23 Тогда
		ТекСтрока = Элементы.ПодтверждающиеДокументы.ТекущиеДанные;
		Поле = СтрШаблон("Объект.ПодтверждающиеДокументы[%1].НомерГТД", ТекСтрока.НомерСтроки - 1);
		ТекстСообщения = СтрШаблон("Номер ГТД должен состоять из 23 знаков! Введено %1.", Строка(ДлинаНомера));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, Поле);
	КонецЕсли;
	//Евросиб Каблов 30.06.2021 )
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтверждающиеДокументыДокументыЕстьПриИзменении(Элемент)
	
	//Евросиб Каблов 30.06.2021 ( Ticket#0203749
	ТекДанные = Элементы.ПодтверждающиеДокументы.ТекущиеДанные;
	Если ТекДанные.ДокументыЕсть И (Объект.ВидПеревозки = ПредопределенноеЗначение("Справочник.ВидыПеревозок.ИмпортМоре") Или Объект.ВидПеревозки = ПредопределенноеЗначение("Справочник.ВидыПеревозок.ЭкспортМоре")) Тогда
		ЕстьДокПоМорскомуТранспорту = ПроверитьНаличиеДокументовПоМорскомуТранспорту(ТекДанные);
		Если Не ЕстьДокПоМорскомуТранспорту Тогда
			ТекДанные.ДокументыЕсть = Ложь;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указаны документы по морскому транспорту!");
		КонецЕсли;
	КонецЕсли;
	//Евросиб Каблов 30.06.2021 )
	
КонецПроцедуры

