&НаСервереБезКонтекста
Функция ПолучитьРаспределяемуюСуммуНаСервере(СчетФарктураСсылка)       
	
	СуммаСФ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетФарктураСсылка, "СуммаДокумента");
	
	ДокОснования = СчетФарктураСсылка.ДокументыОснования;
	Если ДокОснования.Количество() > 0 и ТипЗнч(ДокОснования[0].ДокументОснование) = Тип("ДокументСсылка.КорректировкаРеализации") и
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокОснования[0].ДокументОснование, "ВидОперации") = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение") Тогда
	    СуммаСФ = ДокОснования[0].СуммаУвеличение - ДокОснования[0].СуммаУменьшение;
	КонецЕсли;

	Возврат СуммаСФ;

КонецФункции 

