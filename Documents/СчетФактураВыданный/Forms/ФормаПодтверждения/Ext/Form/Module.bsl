Процедура ДобавитьКДокументу(Команда)
	
	// Евросиб(ДИТ) US 97291 ТА 97321 Сержантова А.С. Начало: 10.12.2024
	// Было: 
	//Если Элементы.МорскойТранспорт.ТекущиеДанные = Неопределено Тогда
	//	Возврат;
	//КонецЕсли;
	//   
	//СтрутураКоносамента = Новый Структура;
	//СтрутураКоносамента.Вставить("СтрокаКоносамента",Элементы.МорскойТранспорт.ТекущиеДанные); 
	//Стало:
	СтрокиМорскогоТранспорта = Новый Массив;
	СтруктураОтбора = Новый Структура("Флаг", Истина); 
	СтрокиКДобавлению = Объект.МорскойТранспорт.НайтиСтроки(СтруктураОтбора);  
	Если СтрокиКДобавлению.Количество() = 0 Тогда
		Возврат;
	КонецЕсли; 
	
	СтрутураКоносамента = Новый Структура;
	СтрутураКоносамента.Вставить("СтрокиКоносаментов",СтрокиКДобавлению); 
	
	Коносаменты_СнятьВсе(Неопределено);
	// Евросиб(ДИТ) US 97291 ТА 97321 Сержантова А.С. Конец: 10.12.2024
	
	СписокЖДН = Новый СписокЗначений;
	СписокЖДН.Добавить("Ссылка");
	СписокЖДН.Очистить();
	
	Для каждого СтрокаЖДН Из Объект.ПодтверждающиеДокументы Цикл
		Если ТекущийСписокЖДН.НайтиПоЗначению(СтрокаЖДН.ЖДН) = Неопределено Тогда
			//Евросиб Коханенко Н.А. 09.04.2024 (( #83236 
			//СписокЖДН.Добавить(СтрокаЖДН.ЖДН,Строка(СтрокаЖДН.КлючСтроки)); 
			СписокЖДН.Добавить(Новый Структура("Ссылка, Контейнер", СтрокаЖДН.ЖДН, Строка(СтрокаЖДН.Контейнер)), Строка(СтрокаЖДН.КлючСтроки)); 
			//Евросиб Коханенко Н.А. 09.04.2024 )) #83236 
		КонецЕсли; 
	КонецЦикла;
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораМорскихЖДНИзСписка", ЭтаФорма, СтрутураКоносамента);
	ОткрытьФорму("ОбщаяФорма.э_ФормаВыбораИзСписка",Новый Структура("Список,Заголовок,ОбъектВладелец",СписокЖДН,"Выберите список ЖДН для добавления морских документов",Объект.Ссылка),Объект.Ссылка,,,,ОпОп);
	
КонецПроцедуры

