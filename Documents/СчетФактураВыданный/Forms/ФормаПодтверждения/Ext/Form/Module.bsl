//Евросиб(ДИТ) Антонова А.С. US 87497 ТА 104722 13.05.2025
&НаКлиенте
Процедура АвтоТранпортПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока и ЗначениеЗаполнено(ЭтаФорма.Клиент) Тогда
		ТекСтрока = Элементы.АвтоТранпорт.ТекущиеДанные;	 
		Если ТекСтрока <> Неопределено Тогда
			РеквизитыКонтрагента = ПолучитьДанныеКонтрагента(ЭтаФорма.Клиент);
			ТекСтрока.Получатель				= ЭтаФорма.Клиент;
			ТекСтрока.Получатель_ИНН 			= РеквизитыКонтрагента.ИНН;
			ТекСтрока.Получатель_Наименование 	= РеквизитыКонтрагента.Наименование;
			ТекСтрока.Получатель_Адрес 			= РеквизитыКонтрагента.Адрес;
		КонецЕсли;		
	КонецЕсли;
КонецПроцедуры

