		// ДИТ Поморцева Т.П. Задача 0252360 07.12.2021. начало 
		И Элемент.ТекущиеДанные.ВыбратьСтрокуДляЗаполнения Тогда
		// ДИТ Поморцева Т.П. Задача 0252360 07.12.2021. конец
		ИмяТЧ = Элемент.Имя;
		ИмяПоля = Сред(Элемент.ТекущийЭлемент.Имя, СтрДлина(ИмяТЧ)+1);
		
		НовоеЗначение = Элементы.ПодтверждающиеДокументы.ТекущиеДанные[ИмяПоля];
	    ЗаполнитьПодтверждающиеДокументыПоПервойСтроке(ИмяПоля,НовоеЗначение);
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПодтверждающиеДокументыПоПервойСтроке(ИмяПоля,НовоеЗначение)
	
	Для Сч = 0 По Объект.ПодтверждающиеДокументы.Количество() - 1 Цикл
		РезПроверки = Элементы.ПодтверждающиеДокументы.ПроверитьСтроку(Объект.ПодтверждающиеДокументы[Сч].ПолучитьИдентификатор());
		текСтрока = Элементы.ПодтверждающиеДокументы.ДанныеСтроки(Объект.ПодтверждающиеДокументы[Сч].ПолучитьИдентификатор());
		Если РезПроверки = Истина И текСтрока.ВыбратьСтрокуДляЗаполнения Тогда
			
			Объект.ПодтверждающиеДокументы[Сч][ИмяПоля] = НовоеЗначение;
			
			// ДИТ Поморцева Т.П. 0252360 07.12.21. начало
			Если ИмяПоля = "СтранаНазначения" Тогда
				Объект.ПодтверждающиеДокументы[Сч]["СтанцияНазначения"]	= ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
			ИначеЕсли ИмяПоля = "СтранаОтправления" Тогда
				Объект.ПодтверждающиеДокументы[Сч]["СтанцияОтправления"]	= ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
			КонецЕсли; 
			// ДИТ Поморцева Т.П. 0252360 07.12.21. конец	
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

