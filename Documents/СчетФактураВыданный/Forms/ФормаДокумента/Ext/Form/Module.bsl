	ТекущийОбъект.ДополнительныеСвойства.Вставить("ДопСвойстваОбъекта", ДопСвойстваОбъекта);
	//Евросиб Каблов 22.07.2020 ( TASK 23506
	ЗначениеПараметра = Неопределено;
	Если ПараметрыЗаписи.Свойство("РазрешенаЗаписьВыставленного", ЗначениеПараметра) Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("РазрешенаЗаписьВыставленного", ЗначениеПараметра);
	КонецЕсли;
	Если ПараметрыЗаписи.Свойство("СнятьПризнакВыставленУОснований", ЗначениеПараметра) Тогда
