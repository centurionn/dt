&НаСервере
Функция	ПолучитьПСЦПоУчДокументу(ДокументОснование)
	
	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	СделкаДоходы.ПСЦ КАК ПСЦ
	               |ИЗ
	               |	Документ.Сделка.Доходы КАК СделкаДоходы
	               |ГДЕ
	               |	СделкаДоходы.УчДокумент = &УчДокумент";
	Запрос.УстановитьПараметр("УчДокумент", ДокументОснование);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ПСЦ;
	Иначе
		Возврат Неопределено;
	КонецЕсли; 
КонецФункции
