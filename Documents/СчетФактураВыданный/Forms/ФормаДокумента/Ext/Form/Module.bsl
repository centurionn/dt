Функция РазрешеноУстановитьФлаг()
	Если Объект.УдалитьВключатьВОтчетДляФНС Тогда 
		ДокОснование = Объект.ДокументОснование;
		Если НЕ ЗначениеЗаполнено(ДокОснование) Тогда 
			Возврат Истина;
		КонецЕсли; 
		МассивКорректировок = КорректировкиРТУСервер.ПолучитьКорректировкуПоОснованию(ДокОснование.Ссылка);
		Если МассивКорректировок.Количество()>0 Тогда
			Для Каждого КорректировкаПоОснованию из МассивКорректировок Цикл 
				Если КорректировкаПоОснованию.ПометкаУдаления Тогда 
					Продолжить;
				КонецЕсли;
				Если КорректировкаПоОснованию.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение Тогда 
					ДокИСФ = БухгалтерскийУчетОбщиеПроцедурыСервер.НайтиПодчиненныйСчетФактуру(КорректировкаПоОснованию);
					Если ЗначениеЗаполнено( ДокИСФ ) Тогда 
						Сообщить("Не забудьте установить отметку, в связанной корректировке по согласованию, ИСФ: "
						+ ДокИСФ );	
					КонецЕсли;	
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Пока Истина Цикл
			Если НЕ ЗначениеЗаполнено(ДокОснование) Тогда 
				Прервать;
			КонецЕсли;
			Если ТипЗнч(ДокОснование)<>Тип("ДокументСсылка.КорректировкаРеализации") Тогда
				Прервать;
			Иначе
				Если ДокОснование.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение Тогда 
					ДокИСФ = БухгалтерскийУчетОбщиеПроцедурыСервер.НайтиПодчиненныйСчетФактуру(ДокОснование.ДокументРеализации);
					Если ЗначениеЗаполнено(ДокИСФ) Тогда 
						Если НЕ ДокИСФ.УдалитьВключатьВОтчетДляФНС Тогда 
							Сообщить("Чтобы установить отметку, вам необходимо, так же, установить ее в предыдущей, связанной ИСФ: "
							+ ДокИСФ );
							Объект.УдалитьВключатьВОтчетДляФНС = Ложь;
							Возврат Ложь;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли; 
			КонецЕсли;
			ДокОснование = ДокОснование.ДокументРеализации;
		КонецЦикла;
	КонецЕсли;
	Возврат Истина;
КонецФункции
