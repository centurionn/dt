&НаКлиенте
Процедура ОбновитьОтображение()

	Если Объект.ВидСчетаФактуры = ПредопределенноеЗначение("Перечисление.ВидСчетаФактурыВыставленного.Корректировочный") Тогда
		Объект.ПлатежноРасчетныеДокументы.Очистить(); 
		Элементы.ПлатежноРасчетныйДокумент.Видимость = Ложь;
		Элементы.ДанныеКорректировки.Видимость = Истина;
		Элементы.ДокументыОснованияКорректировка.Видимость = Истина;
		Элементы.Исправление.Видимость = Истина;
		Элементы.ИсправляемыйСчетФактура.Видимость = Ложь;
		Элементы.НомерИсправления.Видимость = Объект.Исправление;
		Элементы.ИсправляемыйКорретировочный.Видимость = Объект.Исправление;
	Иначе	
		Элементы.ПлатежноРасчетныйДокумент.Видимость = Истина;
		Элементы.ДанныеКорректировки.Видимость = Ложь;
		Элементы.ИсправляемыйКорретировочный.Видимость = Ложь;
		Элементы.ДокументыОснованияКорректировка.Видимость = Ложь;
		Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
			Элементы.Исправление.Видимость = Истина;
			Элементы.ИсправляемыйСчетФактура.Видимость = Объект.Исправление;
			Элементы.НомерИсправления.Видимость = Объект.Исправление;
		Иначе
			Элементы.Исправление.Видимость = Ложь;
			Элементы.ИсправляемыйСчетФактура.Видимость = Ложь;
			Элементы.НомерИсправления.Видимость = Ложь;
		КонецЕсли; 
	КонецЕсли; 

	ОбновитьОтображениеНДС0();
	
КонецПроцедуры

