&НаСервере
Процедура НастроитьДоступностьФрахта()
	// Евросиб Фролов (01.12.2021 Task №43170
	
	ЕстьПравоНДС0 = Пользователи.РолиДоступны("dc_РаботаСНДС0");
	
	// Запретить редактирование реквизитов блока ндс0, всем кроме роли НДС0 и полных прав.
	Элементы.ДанныеДляФНС.ТолькоПросмотр = Не ЕстьПравоНДС0;  
	
	//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 109942 Начало 26.05.2025
	Элементы.СтраницаИтогПодтвержденияНДС0.Видимость = ЕстьПравоНДС0 и Объект.СуммаНДСДокумента = 0;
	//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 109942 Конец 26.05.2025
	
	// Сделать возможным проставления признака фрахт ролью "dc_РаботаСНДС0",
	// где в перечне ГТД в виде перевозок указан Морской импорт или экспорт,
	// и в строчках перечня  не заполнены номера ЖД-накладных.
	МассивЖДН = Объект.ПодтверждающиеДокументы.Выгрузить().ВыгрузитьКолонку("ЖДН");
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТранспортныйДокумент.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	|ГДЕ
	|	ТранспортныйДокумент.Ссылка В(&МассивЖДН)
	|	И ТранспортныйДокумент.НомерТранспортногоДокумента <> """"";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("МассивЖДН", МассивЖДН);
	
	Результат = Запрос.Выполнить();
	
	ЕстьЗаполненныеНомераЖДН = Не Результат.Пустой();
	
	Элементы.Фрахт.ТолькоПросмотр = Ложь;
	
	Если (Объект.ВидПеревозки = Справочники.ВидыПеревозок.ИмпортМоре
		ИЛИ Объект.ВидПеревозки = Справочники.ВидыПеревозок.ЭкспортМоре)
		И ЕстьЗаполненныеНомераЖДН = Ложь Тогда
		Если ЕстьПравоНДС0 Тогда
			Элементы.Фрахт.ТолькоПросмотр = Ложь;
		Иначе
			Элементы.Фрахт.ТолькоПросмотр = Истина;
		КонецЕсли;
	КонецЕсли;	
	// Евросиб Фролов)

КонецПроцедуры

