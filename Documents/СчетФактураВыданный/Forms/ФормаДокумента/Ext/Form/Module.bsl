&НаСервере
Процедура ЗаполнитьИтоговыеДанныеПодтвержденияНДС0()

	ИтоговаяТаблицаПеречняГТД.Очистить();  
	
	Если не ЗначениеЗаполнено(Объект.Ссылка) 
		или Объект.СуммаНДСДокумента <> 0 Тогда
	    Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СчетФактураВыданныйПодтверждающиеДокументы.ВключатьВОтчетДляФНС КАК ВключатьВОтчетДляФНС,
		|	СчетФактураВыданныйПодтверждающиеДокументы.СуммаПоКТК КАК Сумма,
		|	СчетФактураВыданныйПодтверждающиеДокументы.ДатаОтчетаДляФНС КАК ДатаОтчетаДляФНС
		|ПОМЕСТИТЬ ВТ_ВсеПодтвержедние
		|ИЗ
		|	Документ.СчетФактураВыданный.ПодтверждающиеДокументы КАК СчетФактураВыданныйПодтверждающиеДокументы
		|ГДЕ
		|	СчетФактураВыданныйПодтверждающиеДокументы.Ссылка = &Ссылка
		|	И НЕ СчетФактураВыданныйПодтверждающиеДокументы.Ссылка.Авто 
		|	И НЕ СчетФактураВыданныйПодтверждающиеДокументы.Ссылка.Фрахт
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СчетФактураВыданныйМорскойТранспорт.ВключатьВОтчетДляФНС,
		|	СчетФактураВыданныйМорскойТранспорт.СуммаПоКТК,
		|	СчетФактураВыданныйМорскойТранспорт.ДатаОтчетаДляФНС
		|ИЗ
		|	Документ.СчетФактураВыданный.МорскойТранспорт КАК СчетФактураВыданныйМорскойТранспорт
		|ГДЕ
		|	СчетФактураВыданныйМорскойТранспорт.Ссылка = &Ссылка
		|	И СчетФактураВыданныйМорскойТранспорт.Ссылка.Фрахт
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СчетФактураВыданныйАвтоТранпорт.ВключатьВОтчетДляФНС,
		|	СчетФактураВыданныйАвтоТранпорт.Сумма,
		|	СчетФактураВыданныйАвтоТранпорт.ДатаОтчетаДляФНС
		|ИЗ
		|	Документ.СчетФактураВыданный.АвтоТранпорт КАК СчетФактураВыданныйАвтоТранпорт
		|ГДЕ
		|	СчетФактураВыданныйАвтоТранпорт.Ссылка = &Ссылка
		|	И СчетФактураВыданныйАвтоТранпорт.Ссылка.Авто
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ВсеПодтвержедние.ВключатьВОтчетДляФНС КАК ВключеноВОтчет,
		|	СУММА(ВТ_ВсеПодтвержедние.Сумма) КАК Сумма,
		|	ВТ_ВсеПодтвержедние.ДатаОтчетаДляФНС КАК ДатаОтчетаДляФНС
		|ИЗ
		|	ВТ_ВсеПодтвержедние КАК ВТ_ВсеПодтвержедние
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ВсеПодтвержедние.ВключатьВОтчетДляФНС,
		|	ВТ_ВсеПодтвержедние.ДатаОтчетаДляФНС
		|
		|ИМЕЮЩИЕ
		|	СУММА(ВТ_ВсеПодтвержедние.Сумма) <> 0";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить(); 
	
	Если не РезультатЗапроса.Пустой() Тогда
		ИтоговаяТаблицаПеречняГТД.Загрузить(РезультатЗапроса.Выгрузить());	
	КонецЕсли;

