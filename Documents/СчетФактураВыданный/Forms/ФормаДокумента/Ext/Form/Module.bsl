&НаСервере
Процедура ЗаписатьДанныеПоГТД()
	
	УстановитьПривилегированныйРежим(Истина);
	Если Объект.Проведен Тогда
		РежимЗаписи = РежимЗаписиДокумента.Проведение;
	Иначе
		РежимЗаписи = РежимЗаписиДокумента.Запись;
	КонецЕсли;
	//Евросиб Каблов 22.07.2020 ( TASK 23506
	//Записать(Новый Структура("РежимЗаписи, РежимПроведения", РежимЗаписи, РежимПроведенияДокумента.Неоперативный));
	ПараметрыЗаписи = Новый Структура("РежимЗаписи, РежимПроведения", РежимЗаписи, РежимПроведенияДокумента.Неоперативный);
	ПараметрыЗаписи.Вставить("РазрешенаЗаписьВыставленного", Истина);
//Евросиб Гудкова( 18.09.2020 Ticket№ 0207438
	СтрокиБезДокументов = Объект.ПодтверждающиеДокументы.НайтиСтроки(Новый Структура("ДокументыЕсть", Ложь));
	Если Объект.ПодтверждающиеДокументы.Количество() > 0 И СтрокиБезДокументов.Количество() = 0 И Не ЗначениеЗаполнено(Объект.УдалитьДатаПолногоПодтвержденияНДС0) Тогда
		Объект.УдалитьДатаПолногоПодтвержденияНДС0 = ТекущаяДата();
	ИначеЕсли Объект.ПодтверждающиеДокументы.Количество() > 0 И СтрокиБезДокументов.Количество() > 0 И ЗначениеЗаполнено(Объект.УдалитьДатаПолногоПодтвержденияНДС0) Тогда 
		Объект.УдалитьДатаПолногоПодтвержденияНДС0 = Неопределено;
	КонецЕсли;
// Евросиб Гудкова) 	
	Записать(ПараметрыЗаписи);
	//Евросиб Каблов 22.07.2020 )
	УстановитьПривилегированныйРежим(Ложь);
		
КонецПроцедуры

