				//(
				//СведенияОДокументе.ПредставлениеПоставщика = Выборка.Продавец.ГоловнаяОрганизация.НаименованиеПолное+Символы.ПС+СтрокаАгента;
				НаименованиеНаДатуГоловнаяОрганизация = Справочники.Организации.НаименованияНаДату(Выборка.Продавец.ГоловнаяОрганизация, Выборка.ДатаДокумента);
				НаименованиеНаДатуОрганизация = Справочники.Организации.НаименованияНаДату(Выборка.Продавец, Выборка.ДатаДокумента);
				СведенияОДокументе.ПредставлениеПоставщика = НаименованиеНаДатуГоловнаяОрганизация.НаименованиеПолное+Символы.ПС+СтрокаАгента;
				//)
				//Евросиб - АСуслов 06.09.2023 14:00:10 #74705
//Евросиб ) Литвинов 21.01.2021 #30025
				СведенияОДокументе.АдресПоставщика = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Выборка.Продавец.ГоловнаяОрганизация,
						?(ТипЗнч(Выборка.Продавец)=Тип("СправочникСсылка.Контрагенты"),Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента,Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации),Выборка.ДатаДокумента,Истина);
				//Евросиб - АСуслов 06.09.2023 14:02:08 #74705
				//(
				//СведенияОДокументе.ИННПоставщика = Выборка.Продавец.ГоловнаяОрганизация.ИНН+"/"+Выборка.КПППродавца;
				СведенияОДокументе.ИННПоставщика = Выборка.Продавец.ГоловнаяОрганизация.ИНН+"/"+НаименованиеНаДатуОрганизация.КПП;
				//)
				//Евросиб - АСуслов 06.09.2023 14:02:10 #74705		
//Евросиб ( Литвинов 21.01.2021 #30025
