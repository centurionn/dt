Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	НомерЪ = ?(ЗначениеЗаполнено(Данные.НомерДляПечати), Данные.НомерДляПечати, Данные.Номер);
	ДатаЪ = ?(ЗначениеЗаполнено(Данные.ДатаДокумента), Данные.ДатаДокумента, Данные.Дата);
	
	Представление = "Счет-фактура выданный " + НомерЪ + " от " + Формат(ДатаЪ, "ДФ='dd.MM.yy ЧЧ:мм'");
