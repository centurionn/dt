Функция ПолучитьТаблицуСведенийСчетФактуры(Документ) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаСведений = ПечатьБухгалтерскихДокументов.ПолучитьОписаниеСчетФактуры();
	ТаблицаДокумента = ПечатьБухгалтерскихДокументов.ПолучитьОписаниеТаблицыСчетФактуры();
	
	//Евросиб Каблов 20.01.2021 ( Ticket#0218605
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Авансы.СчетФактура КАК СчетФактура,
	|	Авансы.ДокументОплаты КАК ДокументОплаты,
	|	Авансы.ДокументОплаты.НомерВходящегоДокумента КАК НомерПП,
	|	Авансы.ДокументОплаты.ДатаВходящегоДокумента КАК ДатаПП
	|ИЗ
	|	(ВЫБРАТЬ
	|		СчетФактураВыданныйДокументыОснования.Ссылка КАК СчетФактура,
	|		СчетФактураВыданныйДокументыОснования.ДокументОснование КАК Реализация,
	|		ПоступлениеНаРасчетныйСчетДокументыОплаты.Ссылка КАК ДокументОплаты
	|	ИЗ
	|		Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеНаРасчетныйСчет.ДокументыОплаты КАК ПоступлениеНаРасчетныйСчетДокументыОплаты
	|			ПО СчетФактураВыданныйДокументыОснования.ДокументОснование = ПоступлениеНаРасчетныйСчетДокументыОплаты.ДокументРеализации
	|	ГДЕ
	|		СчетФактураВыданныйДокументыОснования.Ссылка = &Документ
	|		И ПоступлениеНаРасчетныйСчетДокументыОплаты.ДокументРеализации.ДатаДокумента > ПоступлениеНаРасчетныйСчетДокументыОплаты.Ссылка.ДатаВходящегоДокумента
	|		И ПоступлениеНаРасчетныйСчетДокументыОплаты.Ссылка.Проведен
	|	
	|	СГРУППИРОВАТЬ ПО
	|		СчетФактураВыданныйДокументыОснования.Ссылка,
	|		СчетФактураВыданныйДокументыОснования.ДокументОснование,
	|		ПоступлениеНаРасчетныйСчетДокументыОплаты.Ссылка
	|	
	|	ИМЕЮЩИЕ
	|		СУММА(ПоступлениеНаРасчетныйСчетДокументыОплаты.СуммаОплаты) > 0) КАК Авансы";
	Запрос.УстановитьПараметр("Документ", Документ);
	ТаблицаАвансов = Запрос.Выполнить().Выгрузить();
	//Евросиб Каблов 20.01.2021 )
	
	ТекстЗапроса = ПолучитьТекстЗапросаДляПечатиСчетаФактуры();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.Текст = ТекстЗапроса;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СведенияОДокументе = ТаблицаСведений.Добавить();
		ЗаполнитьЗначенияСвойств(СведенияОДокументе,Выборка);
		//Евросиб - АСуслов 14.09.2022 11:50:32 #
		//(
		ФакторингСервер.ЗаполнитьПараметрыФакторинга(СведенияОДокументе);
		//)
