#Область ИнициализацияДанныхДляПроведения   

//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 101301 17.04.2025   
Процедура ИнициализироватьДанныеДокумента(ДокументОбъект, ДополнительныеСвойства) Экспорт

	//"ТаблицаДляДвижений" - структура, которая будет содержать таблицы значений с данными для выполнения движений
	ДополнительныеСвойства.Вставить("ТаблицыДляДвижений", Новый  Структура); 
	
	//Запросы для получения данных для выполнения движений
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументОбъект, ДополнительныеСвойства);
	
	ТекстыЗапроса = Новый СписокЗначений;  
	ТекстЗапросаТаблицаПодтверждающиеДокументыНДС0_Море(ТекстыЗапроса);	
	ТекстЗапросаТаблицаПодтверждающиеДокументыНДС0_ЖД(ТекстыЗапроса);
	ТекстЗапросаТаблицаПодтверждающиеДокументыНДС0_Авто(ТекстыЗапроса);
	ТекстЗапросаТаблицаКонтрольПолученияДокументовНДС0(ТекстыЗапроса);
	
	//Выполняем запросы и помещаем в Таблицы для движений
	ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений,Истина,Истина,Ложь);

КонецПроцедуры 

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументОбъект, ДополнительныеСвойства)
	
	
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка); 
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОбъект.ДокументОснование);   
	
КонецПроцедуры        

Процедура ТекстЗапросаТаблицаПодтверждающиеДокументыНДС0_Море(ТекстыЗапроса)

	ИмяРегистра = "ПодтверждающиеДокументыНДС0_Море";
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	СчетФактураВыданный.Ссылка КАК СчетФактура,
	|	СчетФактураВыданный.Контрагент КАК Контрагент,
	|	СчетФактураВыданный.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ВЫБОР
	|		КОГДА СчетФактураВыданныйМорскойТранспорт.ТипДокумента = ИСТИНА
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыПодтверждающихМорскихДокументов.Поручение)
