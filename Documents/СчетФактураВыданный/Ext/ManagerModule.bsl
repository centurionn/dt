		//	СтрокаАгента = "(Через " + Выборка.Организация.НаименованиеПолное+ ", ИНН/КПП "+Выборка.Организация.ИНН+"/"+Выборка.Организация.КПП+")";
		//Иначе
			СТрокаАгента = "";
		//КонецЕсли;
		Если ТипЗнч(Выборка.Продавец) = Тип("СправочникСсылка.Организации") Тогда
			Если ЗначениеЗаполнено(Выборка.Продавец.ГоловнаяОрганизация) Тогда
//Евросиб ( Литвинов 21.01.2021 #30025                                                                                                          
