
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Автор = Пользователи.ТекущийПользователь();
	Создано = ТекущаяДата();
	Организация = Константы.ОсновнаяОрганизация.Получить();
	//Евросиб Каблов 09.04.2025 ( #105407
	//ПериодВО = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериод(Организация);
	ПериодВО = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериодДоходов(Организация);
	//Евросиб Каблов 09.04.2025 )
	//	СтруктураПодписантовПоДоверенности = БухгалтерскийУчетОбщиеПроцедурыСервер.НайтиДействующиеДоверенностиНаПодпись(ТекущаяДата(),"Счет фактура выданный");
	//	ДоверенностьЗаРуководителя = СтруктураПодписантовПоДоверенности.ДоверенностьЗаРуководителя;
	//	ДоверенностьЗаГлБухгалтера = СтруктураПодписантовПоДоверенности.ДоверенностьЗаГБ;
	//
	Если ЗначениеЗаполнено(ДанныеЗаполнения) И ТипЗнч(ДанныеЗаполнения) <> Тип("Структура") Тогда
		СчФ = БухгалтерскийУчетОбщиеПроцедурыСервер.НайтиПодчиненныйСчетФактуру(ДанныеЗаполнения.Ссылка, "СчетФактураВыданный");
		Если СчФ = Неопределено Тогда
			БухгалтерскийУчетОбщиеПроцедурыСервер.ЗаполнитьРеквизитыСчФПоОснованию(ДанныеЗаполнения, ЭтотОбъект);
		Иначе
			Комментарий = "ОТКАЗ";
			Сообщить("Уже существует счет-фактура, введенный на основании данного документа.")
		КонецЕсли;
	КонецЕсли;
	
	Маршрутизировать = Константы.МаршрутизироватьСФВ.Получить();

	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДоговорКонтрагента, "ПравилоФормированияДатыУслуги, ПериодичностьВыставленияДокументов, ДатаПаспортаСделки");
	Если ТипЗнч(ДанныеЗаполнения) <> Тип("ДокументСсылка.КорректировкаРеализации") Тогда //Евросиб(ДИТ), Беляев СЮ, US 115224 / TA 115264, 25-07-2025, добавил условие
		ДатаДокумента = ФормированиеДатДокументов.УстановкаДатыДокумента(ЭтотОбъект, РеквизитыДоговора.ПравилоФормированияДатыУслуги,
																				 РеквизитыДоговора.ПериодичностьВыставленияДокументов,
																				 РеквизитыДоговора.ДатаПаспортаСделки);
	КонецЕсли;
	//ДатаДокумента = ФормированиеДатДокументов.УстановкаДатыДокумента(ЭтотОбъект,ДоговорКонтрагента.ПравилоФормированияДатыУслуги);
	
КонецПроцедуры

