				Если ЗначениеЗаполнено(ЦифровойИндексПодразделения) Тогда
					ЦифровойИндексПодразделения = "/" + Строка(ЦифровойИндексПодразделения);
					ДлинаИндекса = СтрДлина(ЦифровойИндексПодразделения);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// Евросиб Фролов (26.01.2022 Ticket №0258238 
		НомерДокументаОснования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "Номер");
		НомерСсылки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Номер");
		
		// Евросиб Фролов (31.01.2022 Ticket №0258238
		// Если это СФ на вознаграждение по отчету комитенту, то номер нужно взять из реквизита "РезервНомераВознаграждение" 
		Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
