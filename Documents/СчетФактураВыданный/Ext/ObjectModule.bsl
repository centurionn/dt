Процедура ПодготовитьНаборыЗаписейКРегистрацииДвижений(Документ)
	
	ИменаРегистровДляЗаписи = Новый Массив;
	
	РегистрыКОбработке = Документ.Метаданные().Движения;
	НаборыЗаписейКОбработке = Документ.Движения;
	
	Для Каждого НаборЗаписей Из НаборыЗаписейКОбработке Цикл
		
		// Очистим наборы записей от "старых записей" (ситуация возможна только в толстом клиенте)
		Если ЗначениеЗаполнено(НаборЗаписей) И Не НаборЗаписей.Записывать Тогда
			НаборЗаписей.Очистить();
		КонецЕсли;
		
	КонецЦикла;
	
	// Взведем флаг записи у наборов, по которым документ имеет движения
	Если Не Документ.ЭтоНовый() Тогда
		
		МассивИменРегистров = Новый Массив;
		МассивИменРегистров.Добавить("ПодтверждающиеДокументыНДС0_Море"); 
		МассивИменРегистров.Добавить("ПодтверждающиеДокументыНДС0_ЖД");
		МассивИменРегистров.Добавить("ПодтверждающиеДокументыНДС0_Авто");
		МассивИменРегистров.Добавить("ДокументыПодтвержденныеВОтчетеФНС");
		
		Для Каждого ИмяРегистра Из МассивИменРегистров Цикл
			Документ.Движения[ИмяРегистра].Записывать = Истина;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 101301 18.04.2025 
// Загружает ТаблицыДляДвижений в наборы записей регистров движений документа.
//
// Параметры:
//  ДополнительныеСвойства	 - Структура - Структура с дополнительными свойствами документа, используемыми при проведении.
//  										В структуре обязательно должен быть ключ "ТаблицыДляДвижений" содержащий массив таблиц значений.
//  Движения				 - КоллекцияДвижений - Коллекция движений документа.
//  НеЗагружатьТаблицы		 - Строка			 - Имена регистров, для которых не нужно загружать движения.
//
Процедура ЗагрузитьТаблицыДвижений(ДополнительныеСвойства, Движения, НеЗагружатьТаблицы = "") Экспорт
	
	Если НЕ ДополнительныеСвойства.Свойство("ТаблицыДляДвижений") Тогда
		Возврат;
	КонецЕсли;
	
	СписокИсключений = Новый Структура(НеЗагружатьТаблицы);
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	Для Каждого Таблица Из ТаблицыДляДвижений Цикл
		
		ИмяРегистра = Таблица.Ключ;
		Если ВРег(Лев(ИмяРегистра,7))= "ТАБЛИЦА" Тогда
			ИмяРегистра = Прав(ИмяРегистра, СтрДлина(ИмяРегистра)-7);
		КонецЕсли;
		
		Если СписокИсключений.Свойство(ИмяРегистра) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Таблица.Значение.Количество() > 0 И Движения.Найти(ИмяРегистра) <> Неопределено Тогда
			Движения[ИмяРегистра].Записывать = Истина;
			Движения[ИмяРегистра].Загрузить(Таблица.Значение);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

//Евросиб(ДИТ) Антонова А.С. US 90779 ТА 101301 18.04.2025
Процедура ЗаписатьДвиженияРегистровСведений(ДополнительныеСвойства)

	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	Для Каждого Таблица Из ТаблицыДляДвижений Цикл  
		
		ИмяРегистра = Таблица.Ключ;
		Если ВРег(Лев(ИмяРегистра,7))= "ТАБЛИЦА" Тогда
			ИмяРегистра = Прав(ИмяРегистра, СтрДлина(ИмяРегистра)-7);
		КонецЕсли;     
		
		Если Движения.Найти(ИмяРегистра) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Таблица.Значение.Количество() > 0 Тогда
			
			Если ИмяРегистра = "КонтрольПолученияДокументовНДС0" Тогда 
				
				Для каждого СтрокаЗаписи Из ТаблицыДляДвижений["ТАБЛИЦА" + ИмяРегистра] Цикл
					Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
					Набор.Отбор.ЖДН.Установить(СтрокаЗаписи.ЖДН, Истина);
					Набор.Прочитать();	
