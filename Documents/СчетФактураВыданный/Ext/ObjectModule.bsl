			КонецЕсли;
		КонецЕсли;
		// Евросиб Фролов)
		
		Если НомерДокументаОснования <> Номер
			ИЛИ Номер <> НомерСсылки Тогда
			Номер = НомерДокументаОснования;
			НомерДляПечати = "";
		КонецЕсли;
