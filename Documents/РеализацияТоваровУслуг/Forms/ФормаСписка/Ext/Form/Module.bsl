

&НаКлиенте
Процедура ГрупповаяПечать(Команда)
	
	// Евросиб US 89967 TA 91565 Рыбьяков К.А. 25.10.2024 ((
	МассивСсылок = Элементы.Список.ВыделенныеСтроки;
	НеДоступныДляПечати = ПечатьБухгалтерскихДокументов.ДоступныеДляПечатиИОтправкиПоЭдо(МассивСсылок);
	Если НеДоступныДляПечати.Количество() > 0 Тогда
		Для Каждого Документ Из НеДоступныДляПечати Цикл
			ТекстОшибки = НСтр("ru = 'Запрещено отправлять документы клиентам до сдачи декларации по НДС за отчётный квартал 
				|(до ""%1 числа"" месяца, следующего за отчётным). %2'");
			ТекстОшибки = СтрШаблон(ТекстОшибки, Документ.Число, Документ.Ссылка);
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 25.10.2024 ))
	
	//Евросиб СубботинВ #117888 09.09.2025 Начало 
	МассивДокументовДляПроведения = Новый Массив;
	
	Для Каждого ДокументКПечати из МассивСсылок Цикл
		Если НЕ ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(ДокументКПечати,"Проведен") Тогда
			МассивДокументовДляПроведения.Добавить(ДокументКПечати);
			//ОбщегоНазначенияКлиент.СообщитьПользователю("Документ " + ДокументКПечати +  " не проведен. Для печати необходимо провести документы из пакета.");
		КонецЕсли;
	КонецЦикла;
	
	Если МассивДокументовДляПроведения.Количество()> 0 Тогда
		Обработчик = Новый ОписаниеОповещения("ПродолжитьВыполнениеКомандыПослеПодтверждениеПроведения", ЭтотОбъект, Новый Структура("МассивДокументовДляПроведения",МассивДокументовДляПроведения));
		Кнопки = Новый СписокЗначений;                                                                              
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Продолжить'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);
		Если МассивДокументовДляПроведения.Количество() = 1 Тогда
			ТекстВопроса = НСтр("ru = 'Для выполнения команды необходимо предварительно провести документ. Выполнить проведение документа и продолжить?'");
		Иначе
			ТекстВопроса = НСтр("ru = 'Для выполнения команды необходимо предварительно провести документы. Выполнить проведение документов и продолжить?'");
		КонецЕсли;
		ПоказатьВопрос(Обработчик, ТекстВопроса, Кнопки);
		Возврат;
	КонецЕсли;
		
	//Евросиб СубботинВ #117888 09.09.2025 Конец
	
//Евросиб Литвинов 05.02.21 task 28203 (
	//ВыделенныеСтр = Элементы.Список.ВыделенныеСтроки;
	//
	//НетПовторов = ПроверитьОдинаковыеДанные(ВыделенныеСтр);
	НетПовторов = э_ОбщиеСервер.ГрупповаяПечать(Элементы.Список.ВыделенныеСтроки);
//Евросиб Литвинов 05.02.21 task 28203 )

	Если ТипЗнч(НетПовторов) = Тип("Структура") Тогда
		ОткрытьФорму("ОбщаяФорма.ВыборПодписантов",НетПовторов, ЭтотОбъект);
	Иначе
		ОткрытьФорму("ОбщаяФорма.ВыборПодписантов",, ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

