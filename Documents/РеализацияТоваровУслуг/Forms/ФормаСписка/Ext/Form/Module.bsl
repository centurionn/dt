Функция ПроверитьВозможностьПечатиРТУ(ВыделенныеСтр)
	
	Возврат Документы.РеализацияТоваровУслуг.ПроверитьВозможностьПечатиРТУ(ВыделенныеСтр, Истина)
	
КонецФункции

&НаКлиенте
Процедура ОбработкаОтветаПользователяПоИсключениюРТУ(ОтветПользователя = Неопределено, ДопПараметры = Неопределено) Экспорт
	
	Если ОтветПользователя = Неопределено Тогда Возврат; КонецЕсли; 
	Если ОтветПользователя = КодВозвратаДиалога.ОК Тогда
		
		ВыделенныеСтр = ДопПараметры.ВыделенныеСтр;
		ШтрафныеРТУ = ДопПараметры.ШтрафныеРТУ;
		ВыбранноеЗначение = ДопПараметры.ВыбранноеЗначение;
		
		СписокРТУНаПечать = ОбщегоНазначенияКлиентСервер.РазностьМассивов(ВыделенныеСтр,ШтрафныеРТУ);
		ПродолжениеОбработкиВыбора(СписокРТУНаПечать, ВыбранноеЗначение);
	КонецЕсли;	
	
КонецПроцедуры
&НаКлиенте
Процедура ПродолжениеОбработкиВыбора(ВыделенныеСтр,ВыбранноеЗначение)
	// перенес код из Процедура ОбработкаВыбора
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда	
		МассивДокументов = СозданиеТаблицыДокументов(ВыделенныеСтр, ВыбранноеЗначение);		
	Иначе
		МассивДокументов = СозданиеТаблицыДокументов(ВыделенныеСтр, Неопределено);		
	КонецЕсли;
	
	ПараметрКоманды = Новый Массив;
	Для Каждого Элем Из ВыделенныеСтр Цикл
		ПараметрКоманды.Добавить(Элем);
	КонецЦикла;
	
	ПечатьКомплектаДокументов.НапечататьКомплект(МассивДокументов,ПараметрКоманды);	

КонецПроцедуры	
//Евросиб Коханенко Н.А. #61705 09.12.2022 )

