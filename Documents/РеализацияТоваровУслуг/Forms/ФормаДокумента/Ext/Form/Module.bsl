&НаКлиенте
Процедура ДатаДокументаПриИзменении(Элемент)
	// ДИТ US 51148 TA 64324 Евсенкин М.А. Начало: 19.01.2023
	Если Не КонтрольДоступностиДокументов_сервер.ПроверитьДоступностьРоли("dc_РазрешитьРедактированиеИСФ") Тогда // разрешить редактировать без учета разрешенного периода
		Если КонтрольДоступностиДокументов_сервер.ПроверитьДоступностьРоли("dc_РаботаСДокументамиКлиентов") Тогда // только в разрешенном периоде и периоде ВО
			Если Объект.ДатаДокумента < Объект.ПериодВО Тогда  
				Если Объект.ДатаДокумента >= ДатаНачалаРазрешенногоПериодаПереноса
					И Объект.ДатаДокумента <= ДатаОкончанияРазрешенногоПериодаПереноса 
					Или КонтрольДоступностиДокументов_сервер.ПроверитьДоступностьРоли("dc_РедактированиеДатыДокумента") Тогда // Евросиб US 89967 TA 91565 Рыбьяков К.А. 03.10.2024 ((
					//Все ок
				Иначе       
					Ошибки = Неопределено;
					ТекстОшибки = СтрШаблон("Дата документа может быть перенесена в период %1 - %2",Формат(ДатаНачалаРазрешенногоПериодаПереноса,"ДФ=dd.MM.yyyy"),Формат(ДатаОкончанияРазрешенногоПериодаПереноса,"ДФ=dd.MM.yyyy"));
					ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,"Объект.ДатаДокумента",ТекстОшибки);
					ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки);
					Объект.ДатаДокумента = ДатаДокументаТекущая; 
					Возврат;	
				КонецЕсли;
			КонецЕсли;
		Иначе  
			Объект.ДатаДокумента = ДатаДокументаТекущая;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	// ДИТ US 51148 TA 64324 Евсенкин М.А. Конец: 19.01.2023
	
	
//	Объект.ПериодВО = НачалоМесяца(Объект.ДатаДокумента);
	//Период = Формат(Объект.ПериодВО,"ДФ='ММММ гггг'") + " г.";
	//Евросиб - АСуслов 24.01.2022 16:52:15 #0258238
	//(
	Если Год(Объект.ДатаДокумента) <> Год(ДатаДокументаТекущая) Тогда
		//системную дату поставим в конец года выбранной даты        
		//или текущую, если год совпадает с текущим годом
		Если Год(Объект.ДатаДокумента) = Год(ТекущаяДата()) Тогда
			Объект.Дата = ТекущаяДата();
		Иначе
			Объект.Дата = КонецГода(Объект.ДатаДокумента);
		КонецЕсли;
		//очистим номер, чтобы при записи он заполнился с учетом новой даты
		//ДИТ, Беляев СЮ, Ticket#0316040, 04-07-2023, начало (закоментировал, перенёс в модуль документа)
		//Объект.Номер = "";
		//Объект.НомерДляПечати = "";
		//ДИТ, Беляев СЮ, Ticket#0316040, 04-07-2023, конец
	КонецЕсли;                     
	ДатаДокументаТекущая = Объект.Дата;
	//)
	//Евросиб - АСуслов 24.01.2022 16:52:46 #0258238
	
	//Субботин 83554 12.04.2024 начало 
	Если Объект.УслугиПрошлыхПериодов Тогда
		 Объект.УслугиПрошлыхПериодов = Ложь;
	КонецЕсли; 
	//Субботин 83554 12.04.2024 Конец	 

	// Евросиб US 89967 TA 91565 Рыбьяков К.А. 03.10.2024 ((
	Если Объект.ДатаДокумента < Объект.ПериодВО Тогда
		Элементы.ПричинаИзмененияДатыДокумента.АвтоОтметкаНезаполненного = Истина;
	КонецЕсли;
	ПроверитьНаЗапретПечати = Истина;
	// Евросиб Рыбьяков К.А. 03.10.2024 ))
	
