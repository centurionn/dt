&НаСервере
Процедура ЗаполнитьДоплатныеПСЦ()
	// Евросиб Фролов (23.11.2021 Ticket№ 0244435
	
	//Элементы.ФормаПечатьСлужебнойЗаписки.Доступность = Истина;
		
	ТаблицаКонтейнеровУслуг = Новый ТаблицаЗначений;
	ТаблицаКонтейнеровУслуг.Колонки.Добавить("КТК", ОбщегоНазначения.ОписаниеТипаСтрока(11));
	ТаблицаКонтейнеровУслуг.Колонки.Добавить("НомерСтроки", ОбщегоНазначения.ОписаниеТипаЧисло(10));
	//Евросиб СубботинВ #84453 02.07.2024 Начало // получение сделки
	ТаблицаКонтейнеровУслуг.Колонки.Добавить("Сделка", Новый ОписаниеТипов("ДокументСсылка.Сделка"));
	//Евросиб СубботинВ #84453 02.07.2024 Конец
	Для Каждого ТекущаяСтрока Из Объект.Услуги Цикл
		
		МассивПредставленийКТК = СтрРазделить(ТекущаяСтрока.СписокТЕ, ";", Ложь);
		Для Каждого ПредставлениеКТК из МассивПредставленийКТК Цикл
		
			СтрокаКТК = ТаблицаКонтейнеровУслуг.Добавить();
			СтрокаКТК.КТК = ПредставлениеКТК;
			СтрокаКТК.НомерСтроки = ТекущаяСтрока.НомерСтроки;
		    //Евросиб СубботинВ #84453 02.07.2024 Начало
            СтрокаКТК.Сделка = ТекущаяСтрока.Сделка; 
			//Евросиб СубботинВ #84453 02.07.2024 Конец
		КонецЦикла;		
		
	КонецЦикла;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Услуги.КТК КАК КТК,
	|	Услуги.НомерСтроки КАК НомерСтроки,
	//Евросиб СубботинВ #84453 02.07.2024 Начало
	|	Услуги.Сделка КАК Сделка
	//Евросиб СубботинВ #84453 02.07.2024 Конец
	|ПОМЕСТИТЬ втУслуги
	|ИЗ
	|	&Услуги КАК Услуги
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЕ.Ссылка КАК КТК,
	|	втУслуги.НомерСтроки КАК НомерСтроки,
	//Евросиб СубботинВ #84453 02.07.2024 Начало
	|	втУслуги.Сделка КАК Сделка
	//Евросиб СубботинВ #84453 02.07.2024 Конец
	|ПОМЕСТИТЬ втТаблицаКонтейнеров
	|ИЗ
	|	втУслуги КАК втУслуги
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТЕ КАК ТЕ
	|		ПО втУслуги.КТК = ТЕ.Наименование
	|			И (НЕ ТЕ.ПометкаУдаления)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	втТаблицаКонтейнеров.КТК КАК КТК,
	|	втТаблицаКонтейнеров.НомерСтроки КАК НомерСтроки,
	|	СделкаСвязьУчетныхЕдиниц.Доплата_ПСЦ КАК Доплата_ПСЦ
	|ИЗ
	|	втТаблицаКонтейнеров КАК втТаблицаКонтейнеров
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|		ПО втТаблицаКонтейнеров.КТК = СделкаСвязьУчетныхЕдиниц.Контейнер 
	//Евросиб СубботинВ #84453 02.07.2024 Начало	
	//|			И (СделкаСвязьУчетныхЕдиниц.Ссылка = &Сделка)
	|			И (втТаблицаКонтейнеров.Сделка = СделкаСвязьУчетныхЕдиниц.Ссылка)
	//Евросиб СубботинВ #84453 02.07.2024 Конец
	|ГДЕ
	|	СделкаСвязьУчетныхЕдиниц.Доплата_ПСЦ <> ЗНАЧЕНИЕ(Документ.ПСЦ.ПустаяСсылка)";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса; 
	//Евросиб СубботинВ #84453 02.07.2024 Начало
    //Запрос.УстановитьПараметр("Сделка", Объект.Сделка);
	//Евросиб СубботинВ #84453 02.07.2024 Конец

	Запрос.УстановитьПараметр("Услуги", ТаблицаКонтейнеровУслуг);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл		
		СтрокаДанных = Объект.Услуги[Выборка.НомерСтроки - 1];
		СтрокаДанных.Доплата_ПСЦ = Выборка.Доплата_ПСЦ;		
	КонецЦикла;	

	// Евросиб Фролов)
КонецПроцедуры	

&НаКлиенте
Процедура ПечатьСлужебнойЗаписки(Команда)
	// Евросиб Фролов (23.11.2021 Ticket№ 0244435

	// По строковым представлениям получим список КТК для печати служебной записки
	ВыделенныеСтроки = Элементы.Услуги1.ВыделенныеСтроки;
	
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Не выделены строки в списке услуг для печати служебной записи.");
		Возврат;
	КонецЕсли;	
	
	ПротоколыРазные = Ложь;
	Протокол = ПредопределенноеЗначение("Документ.ПСЦ.ПустаяСсылка");
	//МассивПредставленийКТК = Новый Массив;
	МассивСтрок = Новый Массив;
    МассивКТК = Новый Массив;
	Для Каждого ИндексВыделеннойСтроки Из ВыделенныеСтроки Цикл
		
		СтрокаДанных = Объект.Услуги[ИндексВыделеннойСтроки];
		
		Если ЗначениеЗаполнено(СтрокаДанных.Доплата_ПСЦ)
			И ЗначениеЗаполнено(Протокол)
			И СтрокаДанных.Доплата_ПСЦ <> Протокол Тогда
			ПротоколыРазные = Истина;
			Прервать;
		КонецЕсли;	
		
		Протокол = СтрокаДанных.Доплата_ПСЦ;		
		
		СписокСделок = Новый СписокЗначений;
		СписокСделок.Добавить(Объект.Сделка);
		
		СписокСФ = Новый СписокЗначений;
		СписокСФ.Добавить(БухгалтерскийУчетОбщиеПроцедурыСервер.НайтиПодчиненныйСчетФактуру(Объект.Ссылка, "СчетФактураВыданный"));
		
		СписокКлиентов = Новый СписокЗначений;
		СписокКлиентов.Добавить(Объект.Контрагент);
		
		МассивПредставленийКТКСтроки = СтрРазделить(СтрокаДанных.СписокТЕ, ";", Ложь);		
		КонтейнерыСтроки = ПолучитьМассивКТК(МассивПредставленийКТКСтроки);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивКТК, КонтейнерыСтроки, Истина);
		
		СтруктураСтроки = Новый Структура;
		СтруктураСтроки.Вставить("Сделки", 				СписокСделок);
		СтруктураСтроки.Вставить("СчетаФактуры", 		СписокСФ);
		СтруктураСтроки.Вставить("Контейнеры", 			КонтейнерыСтроки);
		СтруктураСтроки.Вставить("ДатаРаскредитации", 	Дата(1, 1, 1));
		СтруктураСтроки.Вставить("Клиенты", 			СписокКлиентов);
		
		МассивСтрок.Добавить(СтруктураСтроки);
		
	КонецЦикла;
	
	Если ПротоколыРазные Тогда
		ПоказатьПредупреждение(, "В выбранных строках отличаются доплатные протоколы.
								|Проверьте данные.");
		Возврат;
	КонецЕсли;	
	
	//МассивКТК = ПолучитьМассивКТК(МассивПредставленийКТК);
	
	СписокКТК = Новый СписокЗначений;	
	СписокКТК.ЗагрузитьЗначения(МассивКТК);

	//ДатыСозданияИСФ = "";
	
	ПараметрыФормыПечати = Новый Структура;
	ПараметрыФормыПечати.Вставить("СписокКТК", 			СписокКТК);
	ПараметрыФормыПечати.Вставить("Протокол", 			Протокол);
	ПараметрыФормыПечати.Вставить("МассивСтрок", 		МассивСтрок);
	//ПараметрыФормыПечати.Вставить("ТаблицаРТУ", 		ПолучитьТаблицуРТУ(ДатыСозданияИСФ));
	//ПараметрыФормыПечати.Вставить("ДатыСозданияИСФ", 	ДатыСозданияИСФ);
	
	ОткрытьФорму("Обработка.ПечатьСлужебныхЗаписокПоДоплатнымКТК.Форма", ПараметрыФормыПечати);
	// Евросиб Фролов)
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивКТК(МассивПредставленийКТК)
	// Евросиб Фролов (23.11.2021 Ticket№ 0244435

	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТЕ.Ссылка КАК КТК
	|ИЗ
	|	Справочник.ТЕ КАК ТЕ
	|ГДЕ
	|	ТЕ.Наименование В(&МассивПредставленийКТК)
	|	И НЕ ТЕ.ПометкаУдаления";	

	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("МассивПредставленийКТК", МассивПредставленийКТК);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	МассивКТК = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("КТК");
	
	Возврат МассивКТК;
	
	// Евросиб Фролов)
КонецФункции	

