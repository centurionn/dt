	               |	СделкаСвязьУчетныхЕдиниц.Ссылка.СтанцияНазначения КАК ПунктНазначения,
	               |	СделкаСвязьУчетныхЕдиниц.ГУИД КАК ГУИД,
	               |	СделкаСвязьУчетныхЕдиниц.Ссылка КАК Ссылка,
	               |	СделкаСвязьУчетныхЕдиниц.ВесГрузаНетто КАК ФактическийВес,
	               |	СделкаСвязьУчетныхЕдиниц.ВесГрузаНетто КАК РасчетныйВес,
	               |	СделкаСвязьУчетныхЕдиниц.Заявка.ВидПеревозки КАК ВидПеревозки,
	               |	СделкаСвязьУчетныхЕдиниц.ЖДН.НакладнаяЭТРАН КАК ЖДННакладнаяЭТРАН
	               |ИЗ
	               |	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	               |ГДЕ
	               |	СделкаСвязьУчетныхЕдиниц.Ссылка = &Ссылка
	               |	И СделкаСвязьУчетныхЕдиниц.Контейнер В(&СписокКТК)";
	Запрос.УстановитьПараметр("Ссылка", Объект.Сделка);
	Запрос.УстановитьПараметр("СписокКТК", СписокТЕ);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		НСтр = Объект.РасшифровкаУслугПоТС.Добавить();
		ЗаполнитьЗначенияСвойств(НСтр, Ответ);
		НСтр.Услуга = Услуга;
		Для каждого Стр из Ответ.ЖДННакладнаяЭТРАН.Контейнеры Цикл
			
			Если Стр.НомерКонтейнера = Строка(Ответ.Контейнер) Тогда
				НСтр.ФактическийВес = Стр.МассыВКгНетто;
				НСтр.РасчетныйВес = Стр.МассыВКгНетто;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;

		
	КонецЦикла;
	
КонецПроцедуры

