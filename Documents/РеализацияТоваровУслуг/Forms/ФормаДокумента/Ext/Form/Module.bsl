&НаКлиенте
Процедура ДоговорКонтрагентаПриИзменении(Элемент)
	СтараяВалюта = Объект.ВалютаДокумента;
	СтарыйКурс = Объект.КурсВзаиморасчетов;
	СтараяКратность = Объект.КратностьВзаиморасчетов;
	
	НадоОчиститьРСчета = Ложь;
	
	Если ЗначениеЗаполнено(Объект.ДоговорКонтрагента) Тогда
		СтрПараметров = КонтрагентыДоговоры_сервер.ПолучитьВалютуДоговора(Объект.ДоговорКонтрагента, Объект.Дата);
		НадоОчиститьРСчета = (Объект.ВалютаДокумента <> СтрПараметров.Валюта);
		Объект.ВалютаДокумента = СтрПараметров.Валюта;
		Объект.КурсВзаиморасчетов = СтрПараметров.Курс;
		Объект.КратностьВзаиморасчетов = СтрПараметров.Кратность;
	КонецЕсли;
	
	Если НадоОчиститьРСчета Тогда
		Объект.БанковскийСчетОрганизации = неопределено;
	КонецЕсли;
	Если СтараяВалюта <> Объект.ВалютаДокумента  или СтарыйКурс <> Объект.КурсВзаиморасчетов  Тогда
		СтруктураТекущая = Новый Структура;
		СтруктураТекущая.Вставить("Валюта",СтараяВалюта);
		СтруктураТекущая.Вставить("Курс",СтарыйКурс);
		СтруктураТекущая.Вставить("Кратность",СтараяКратность);
		СтруктураНовая = Новый Структура;
		СтруктураНовая.Вставить("Валюта",Объект.ВалютаДокумента);
		СтруктураНовая.Вставить("Курс",Объект.КурсВзаиморасчетов);
		СтруктураНовая.Вставить("Кратность",Объект.КратностьВзаиморасчетов);
		
		ПересчитатьСуммыДокументаПоВалютеВзаиморасчетов(СтруктураТекущая, СтруктураНовая);
		Для каждого Стр из Объект.Услуги Цикл
			БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(Стр,Объект.СуммаВключаетНДС);
		КонецЦикла;

		РассчитатьСуммыВсегоПоДокументу();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСуммыДокументаПоВалютеВзаиморасчетов(СтруктураТекущая,СтруктураНовая)
	//ДИТ, Беляев СЮ, BUG 76518 / TA 76823, 03-11-2023, начало
	ОкруглениеКурса = Справочники.ФормированиеФинДокументов.ПолучитьЗначениеОкругленияКурсаИзПравил(Объект.ПравилоФормирования);
	//ДИТ, Беляев СЮ, BUG 76518 / TA 76823, 03-11-2023, конец
	Для каждого Стр из Объект.Услуги Цикл
		Всего = Стр.Сумма +?(Объект.СуммаВключаетНДС,0,Стр.СуммаНДС);
		//Всего = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Всего, СтруктураТекущая,СтруктураНовая);
		//ДИТ, Беляев СЮ, BUG 76518 / TA 76823, 03-11-2023, начало
		Всего = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Всего, СтруктураТекущая,СтруктураНовая, , ОкруглениеКурса);
		//ДИТ, Беляев СЮ, BUG 76518 / TA 76823, 03-11-2023, конец
		Стр.Сумма = ?(Объект.СуммаВключаетНДС, Всего,Всего/(1+(БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Стр.СтавкаНДС)/100)));
		Стр.СуммаНДС = ?(Объект.СуммаВключаетНДС,  Всего*БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Стр.СтавкаНДС)/100,Всего- Стр.Сумма);
		Стр.Цена = Стр.Сумма/Стр.Количество;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура КонтрагентПриИзмененииНаСервере()
	ДанныеПоУмолчанию = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСчетДоговорПоУмолчанию(Объект.Контрагент);
	Если ЗначениеЗаполнено(ДанныеПоУмолчанию.Договор) Тогда 
		Объект.ДоговорКонтрагента = ДанныеПоУмолчанию.Договор;
	КонецЕсли;     
	
	//ДИТ Авдеева В.С. 43329 29.04.2022 Начало     
	СтруктураРуководитель = ОтветственныеЛица_сервер.ПолучитьРуководителя(Объект.Контрагент, ТекущаяДата());
	Объект.РуководительКонтрагента = СтруктураРуководитель.Ссылка;
	//ДИТ Авдеева В.С. 43329 29.04.2022 Конец  

КонецПроцедуры

