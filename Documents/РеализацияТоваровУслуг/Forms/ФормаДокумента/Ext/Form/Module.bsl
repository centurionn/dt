&НаКлиенте
Процедура УстановкаОтветственных(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	Для Каждого Стр Из Параметр1 Цикл
		НовСтр = Объект.Состояния.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,Стр);		
	КонецЦикла;
	Параметры.СохранитьДанныеСостояний = Истина;
	
	СтруктураЗаписиДанных = Новый СТруктура;
	СтруктураЗаписиДанных.Вставить("СостоянияИзменены",Истина);
	
	Записать(СтруктураЗаписиДанных);

КонецПроцедуры

&НаСервере
Функция ПроверитьНеобходимостьМаршрутизации()

	ДляДанногоОбъектаТребуетсяПеремаршрутизация = 
	НЕ ЗначениеЗаполнено(Объект.Ссылка) ИЛИ 
	Объект.Ссылка.Организация <> Объект.Организация ИЛИ 
	Объект.Ссылка.Контрагент <> Объект.Контрагент ИЛИ
	Объект.Ссылка.ДоговорКонтрагента <> Объект.ДоговорКонтрагента ИЛИ Объект.Состояния.Количество() = 0;
	
	Возврат ДляДанногоОбъектаТребуетсяПеремаршрутизация;
	
КонецФункции

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	//Евросиб Литвинов ( 30.12.21 #44592 Ticket#0254477 #44587 
	Если НЕ ЗначениеЗаполнено(ТекущийОбъект.Ссылка) Тогда
		ТекущийОбъект.ДатаСоставления = ТекущийОбъект.ДатаДокумента;
	Иначе
		ДатаДокументаВБазе = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущийОбъект.Ссылка, "ДатаДокумента");
		Если ТекущийОбъект.ДатаДокумента <> ДатаДокументаВБазе Тогда
			//Евросиб Каблов 09.04.2025 ( #105407			
			//Запрос = Новый Запрос;
			//Запрос.УстановитьПараметр("Период", НачалоМесяца(ТекущийОбъект.ДатаДокумента));
			//Запрос.Текст = 
			//"ВЫБРАТЬ ПЕРВЫЕ 1
			//|	1 КАК Поле1
			//|ИЗ
			//|	РегистрСведений.ЗакрытыеПериоды КАК ЗакрытыеПериоды
			//|ГДЕ
			//|	ЗакрытыеПериоды.Период >= &Период";   
			//Если НЕ Запрос.Выполнить().Пустой() Тогда
			ДатаОткрытогоПериода = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериодДоходов(ТекущийОбъект.Организация);
			Если ТекущийОбъект.ДатаДокумента < ДатаОткрытогоПериода Тогда
			//Евросиб Каблов 09.04.2025 )
				Если ЗначениеЗаполнено(ДатаДокументаВБазе) И Год(ТекущийОбъект.ДатаДокумента) <> Год(ДатаДокументаВБазе) Тогда
					ТекущийОбъект.ДатаСоставления = Мин(КонецМесяца(ТекущийОбъект.ПериодВО), ТекущийОбъект.Создано);
				Иначе
					ТекущийОбъект.ДатаСоставления = Мин(КонецМесяца(ТекущийОбъект.ПериодВО), ТекущийОбъект.Дата);
				КонецЕсли;
			Иначе
				ТекущийОбъект.ДатаСоставления = ТекущийОбъект.ДатаДокумента;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//Евросиб Литвинов) 	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ДопСвойстваОбъекта", ДопСвойстваОбъекта);
	//Евросиб Каблов 28.07.2020 (
	ЗначениеПараметра = Неопределено;
	Если ПараметрыЗаписи.Свойство("СнятьПризнакВыставленУСчетаФактуры", ЗначениеПараметра) Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("СнятьПризнакВыставленУСчетаФактуры", ЗначениеПараметра);
	КонецЕсли;
	//Евросиб Каблов 11.07.2020 )
	
	//Евросиб Каблов 02.12.2020 ( Ticket#0215459
	ИзмененияЗапрещены = Отказ;
	ТекРежимЗаписи = Неопределено;
	ТекРежимПроведения = Неопределено;
	ПараметрыЗаписи.Свойство("РежимЗаписи", ТекРежимЗаписи);
	ПараметрыЗаписи.Свойство("РежимПроведения", ТекРежимПроведения);
