			И НЕ Объект.Выставлен Тогда
			Элементы.ДатаДокумента.ТолькоПросмотр = Ложь;
			Элементы.ПричинаИзмененияДатыДокумента.ТолькоПросмотр = Ложь;
		Иначе
			Элементы.ДатаДокумента.ТолькоПросмотр = Истина;
			Элементы.ПричинаИзмененияДатыДокумента.ТолькоПросмотр = Истина;
