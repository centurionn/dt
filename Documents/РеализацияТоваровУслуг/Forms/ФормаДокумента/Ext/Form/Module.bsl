&НаСервере
Процедура ЗаполнитьДанныеОбОтправкиДокумента() //Евросиб Шевченко А.В. US 108619 TA 113566 15.07.2025
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СобытияДокументовВПакетахАктуальныйСрезПоследних.СпособОтправки КАК СпособОтправки,
		|	СобытияДокументовВПакетахАктуальныйСрезПоследних.Событие КАК Событие,
		|	СобытияДокументовВПакетахАктуальныйСрезПоследних.ДатаОтправки КАК ДатаОтправки,
		|	СобытияДокументовВПакетахАктуальныйСрезПоследних.ДатаВозврата КАК ДатаВозврата,
		|	СобытияДокументовВПакетахАктуальныйСрезПоследних.Подписан КАК Подписан,
		|	СобытияДокументовВПакетахАктуальныйСрезПоследних.Пользователь КАК Пользователь,
		|	РАЗНОСТЬДАТ(СобытияДокументовВПакетахАктуальныйСрезПоследних.ДатаОтправки, ВЫБОР
		|			КОГДА СобытияДокументовВПакетахАктуальныйСрезПоследних.ДатаВозврата = ДАТАВРЕМЯ(1, 1, 1)
		|				ТОГДА &ТекущаяДата
		|			ИНАЧЕ СобытияДокументовВПакетахАктуальныйСрезПоследних.ДатаВозврата
		|		КОНЕЦ, ДЕНЬ) КАК КолвоДнейОжидания,
		|	ВЫБОР
		|		КОГДА НЕ СобытияДокументовВПакетахАктуальныйСрезПоследних.Событие В (ЗНАЧЕНИЕ(Перечисление.СобытияОтправкиДокументов.Возвращен), ЗНАЧЕНИЕ(Перечисление.СобытияОтправкиДокументов.Аннулирован))
		|				И РАЗНОСТЬДАТ(СобытияДокументовВПакетахАктуальныйСрезПоследних.ДатаОтправки, &ТекущаяДата, ДЕНЬ) > СобытияДокументовВПакетахАктуальныйСрезПоследних.ДоговорКонтрагента.СрокВозвратаДокументовКонтрагентомДни
		|			ТОГДА РАЗНОСТЬДАТ(СобытияДокументовВПакетахАктуальныйСрезПоследних.ДатаОтправки, &ТекущаяДата, ДЕНЬ) - СобытияДокументовВПакетахАктуальныйСрезПоследних.ДоговорКонтрагента.СрокВозвратаДокументовКонтрагентомДни
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КолвоДнейПросрочки
		|ИЗ
		|	РегистрСведений.СобытияДокументовВПакетахАктуальный.СрезПоследних КАК СобытияДокументовВПакетахАктуальныйСрезПоследних
		|ГДЕ
		|	СобытияДокументовВПакетахАктуальныйСрезПоследних.Документ = &Документ";
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.УстановитьПараметр("Документ", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ЭтотОбъект,ВыборкаДетальныеЗаписи)
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Функция ПолучитьДатуПодписанияДиадок(ДокСсылка)
	
	СчФ = БухгалтерскийУчетОбщиеПроцедурыСервер.НайтиПодчиненныйСчетФактуру(ДокСсылка, "СчетФактураВыданный");
	
	Если НЕ ЗначениеЗаполнено(СчФ) Тогда
		Возврат Дата(1,1,1);
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Диадок_Документы.DocumentId КАК DocumentId
		|ПОМЕСТИТЬ ВТ_Исх
		|ИЗ
		|	Справочник.Диадок_Документы КАК Диадок_Документы
		|ГДЕ
		|	Диадок_Документы.Документ = &Документ
		|	И Диадок_Документы.Направление = ""Исходящее""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕстьNull(Диадок_Документы.ДатаПодписиКонтрагентом,ДАТАВРЕМЯ(1,1,1)) КАК ДатаПодписиКонтрагентом
		|ИЗ
		|	ВТ_Исх КАК ВТ_Исх
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Диадок_Документы КАК Диадок_Документы
		|		ПО ВТ_Исх.DocumentId = Диадок_Документы.DocumentId
		|			И Диадок_Документы.Направление = ""Входящее""";
	
	Запрос.УстановитьПараметр("Документ", СчФ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.ДатаПодписиКонтрагентом;
	КонецЦикла;
		
	Возврат Дата(1,1,1);
	
КонецФункции	

