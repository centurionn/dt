&НаСервере
Процедура УстановитьОграниченияСтатусыОтправкиИПодписанияРТУ()
	
	Перем мПараметрыВыбора, Параметр, мДоступныеСтатусы;
	
	мПараметрыВыбора = Новый Массив();
	
	Если НеОтслеживать Тогда
		
		мДоступныеСтатусы = Новый Массив();
		мДоступныеСтатусы.Добавить(Перечисления.СтатусыОтправкиИПодписанияРТУ.ДокументНеВРаботеИНеТребуетНачалаРаботы);
		
		Параметр = Новый ПараметрВыбора(
				"Отбор.Ссылка",
		    	    	Новый ФиксированныйМассив(мДоступныеСтатусы)
			);
			
		мПараметрыВыбора.Добавить(Параметр); 
	Иначе
		
		мДоступныеСтатусы = Новый Массив();
		мДоступныеСтатусы.Добавить(Перечисления.СтатусыОтправкиИПодписанияРТУ.КонтрагентОтказалВПодписи);
		мДоступныеСтатусы.Добавить(Перечисления.СтатусыОтправкиИПодписанияРТУ.ВРаботе);
		мДоступныеСтатусы.Добавить(Перечисления.СтатусыОтправкиИПодписанияРТУ.НеОтправлен);
		мДоступныеСтатусы.Добавить(Перечисления.СтатусыОтправкиИПодписанияРТУ.НеОтправленПослеEmail);
		мДоступныеСтатусы.Добавить(Перечисления.СтатусыОтправкиИПодписанияРТУ.НеПолучен);
		мДоступныеСтатусы.Добавить(Перечисления.СтатусыОтправкиИПодписанияРТУ.ОжидаетсяПодписьКонтрагента);
		мДоступныеСтатусы.Добавить(Перечисления.СтатусыОтправкиИПодписанияРТУ.ТребуетсяАннулирование);
		мДоступныеСтатусы.Добавить(Перечисления.СтатусыОтправкиИПодписанияРТУ.ТребуетсяУточнение);
		мДоступныеСтатусы.Добавить(Перечисления.СтатусыОтправкиИПодписанияРТУ.ДокументНеВРаботеИНеТребуетНачалаРаботы);
		
				
		Параметр = Новый ПараметрВыбора(
				"Отбор.Ссылка",
		    	    	Новый ФиксированныйМассив(мДоступныеСтатусы)
			);
			
		мПараметрыВыбора.Добавить(Параметр); 
		
	КонецЕсли;
	
	ЭтаФорма.Элементы.ВРаботеПоСтатусуОтправкиИПодписания.ПараметрыВыбора = Новый ФиксированныйМассив(мПараметрыВыбора);
	
КонецПроцедуры
