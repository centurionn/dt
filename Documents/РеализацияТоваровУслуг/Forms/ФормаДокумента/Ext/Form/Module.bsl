&НаКлиенте
Процедура РазрешитьРедактированиеВыгруженногоДокумента(Команда)  
	
	//Евросиб Дубская 27.10.2022 ( Ticket#0287875
	//СнятьПризнакВыгруженНаСервере(); 
	Ссылка = Объект.Ссылка;
	
	//Проверка доступности по Периоду ВО
	ДокументВЗакрытомПериоде = КонтрольДоступностиДокументов_сервер.ПроверкаДоступностиПоПериоду(Ссылка);
	Если ДокументВЗакрытомПериоде Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Редактирование документа запрещено, так как он в закрытом периоде!");
		Возврат;
	КонецЕсли;     
	
	//Проверка доступности по наличию привязанных оплат
	Если ЕстьПривязанныеОплаты(Ссылка) Тогда
		Если КонтрольДоступностиДокументов_сервер.ПроверитьДоступностьРоли("dc_РазрешитьРедактированиеИСФ") Тогда
			ОповещениеОтветаВопроса = Новый ОписаниеОповещения("ОбработкаВопросаПривязанныхОплат", ЭтаФорма);
			ПоказатьВопрос(ОповещениеОтветаВопроса, "Есть привязанные оплаты. Разрешить редактирование?", РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Нет);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запрещено редактирование документа из-за наличия привязанных оплат.");
		КонецЕсли;
		Возврат;
	КонецЕсли;   
	
	СнятьПризнакВыгруженНаСервере();
	//Евросиб Дубская 27.10.2022 ) 
	
КонецПроцедуры
