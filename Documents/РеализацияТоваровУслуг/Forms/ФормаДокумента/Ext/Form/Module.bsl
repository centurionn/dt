&НаКлиенте
Процедура РассчитатьСуммыВсегоПоДокументу()
	ИтогоНДС = ?(Объект.Товары.Количество()>0, Объект.Товары.Итог("СуммаНДС"),0)+?(Объект.Услуги.Количество()>0,Объект.Услуги.Итог("СуммаНДС"),0)+?(Объект.АгентскиеУслуги.Количество()>0,Объект.АгентскиеУслуги.Итог("СуммаНДС"),0);
	ИтогоВсего = ?(Объект.Товары.Количество()>0, Объект.Товары.Итог("Сумма"),0)+ ?(Объект.Услуги.Количество()>0,Объект.Услуги.Итог("Сумма"),0)+ ?(Объект.АгентскиеУслуги.Количество()>0,Объект.АгентскиеУслуги.Итог("Сумма"),0)+?(Объект.СуммаВключаетНДС,0,ИтогоНДС);
	Попытка
		Объект.СуммаДокумента = ИтогоВсего;
	Исключение
		// недостаточно прав для обновления полей
	КонецПопытки;
	Элементы.Валюта.Заголовок = Объект.ВалютаДокумента;
КонецПроцедуры

&НаКлиенте
Процедура СчФНадписьНажатие(Элемент)
	
	ОповещениеОтветаВопроса = Новый ОписаниеОповещения("ОбработкаВопросаЗаписи", ЭтаФорма);
	РеквизитыСФ = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьРеквизитыСчетФактуры(Объект,"СчетФактураВыданный");
	Если РеквизитыСФ <> Неопределено и ЭтаФорма.Модифицированность Тогда
		ПоказатьВопрос(ОповещениеОтветаВопроса, "Документ был изменен, будет выполнена запись документа с актуализацией данных подчиненной счет-фактуры. Продолжить?", РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Нет);	
	КонецЕсли;
	Если РеквизитыСФ = Неопределено и ЭтаФорма.Модифицированность Тогда
	//	ОповещениеОтветаВопроса = Новый ОписаниеОповещения("ОбработкаВопросаЗаписи", ЭтаФорма);
		ПоказатьВопрос(ОповещениеОтветаВопроса, "Перед созданием счет-фактуры документ необходимо записать. Продолжить?", РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Нет);
	ИначеЕсли РеквизитыСФ = Неопределено Тогда
		ОбработкаВопросаЗаписи(КодВозвратаДиалога.Да, Истина);
	КонецЕсли;	
	Если РеквизитыСф <> Неопределено и Не ЭтаФорма.Модифицированность Тогда
		БухгалтерскийУчетОбщиеПроцедурыКлиент.ОткрытьСчетФактуру(Объект,ЭтаФорма,"СчетФактураВыданный");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаЗаписи(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;
	
	Если Параметр2 = неопределено Тогда
		ЗаписатьДокументРеализации();
	конецЕсли;
	БухгалтерскийУчетОбщиеПроцедурыКлиент.ВвестиСчетФактуру(Объект,ЭтаФорма,"СчетФактураВыданный");
	РеквизитыСФ = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьРеквизитыСчетФактуры(Объект,"СчетФактураВыданный");
	Если РеквизитыСФ <> Неопределено Тогда
		Элементы.СчФНадпись.Заголовок = БухгалтерскийУчетОбщиеПроцедурыКлиент.ЗаполнитьНадписьСчФ(РеквизитыСФ);
	КонецЕсли;
	БухгалтерскийУчетОбщиеПроцедурыКлиент.ОткрытьСчетФактуру(Объект,ЭтаФорма,"СчетФактураВыданный");	
КонецПроцедуры

