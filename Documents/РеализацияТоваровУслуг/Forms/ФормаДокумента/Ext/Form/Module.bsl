&НаСервере
Функция НайтиМаксимальнуюДатуТД(Реквизит);
	СтрокаТД = "";
	Для каждого Стр из Объект.Услуги Цикл
		СтрокаТД = СтрокаТД+?(СтрокаТД = "","",";")+Стр.СписокТД;
	КонецЦикла;
	МассивНомеровТД = СтрРазделить(СтрокаТД,";",Ложь);
	ДатаМакс = ЗапросПоТД(МассивНомеровТД,Реквизит);	
	
	Возврат ДатаМакс;
КонецФункции

&НаСервере
Функция ЗапросПоТД(МассивТД,Реквизит)
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	МАКСИМУМ(ТранспортныйДокумент."+Реквизит+") КАК Дата
	                      |ИЗ
	                      |	Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	                      |ГДЕ
	                      |	ТранспортныйДокумент.Номер В(&МассивНомеров)");
	Запрос.УстановитьПараметр("МассивНомеров",МассивТД);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат ?(Выборка.Дата = NULL, Дата('00010101'), Выборка.Дата);
	КонецЕсли;
	Возврат Дата('00010101');

КонецФункции

