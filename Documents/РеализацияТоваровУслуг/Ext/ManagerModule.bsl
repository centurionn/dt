Функция ПроверитьВозможностьПечатиРТУ(СписокРТУ, ВызовИсключения = Ложь) Экспорт
	
	//Евросиб СубботинВ #119324 07.10.2025 Начало
	НоменклатурыБлокировкиПечатиРТУ = Константы.СписокНоменклатурыБлокировкиПечатиРТУ.Получить().Получить();
	//Евросиб СубботинВ #119324 07.10.2025 Конец

	
	
	МассивШтрафныхДокументов = Новый Массив;
	Если СписокРТУ.Количество() = 1 Тогда 
		//Евросиб СубботинВ #119324 07.10.2025 Начало
		РеквизитыРТУ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СписокРТУ[0],"Штраф, Услуги, Ссылка");
		//Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СписокРТУ[0],"Штраф",) Тогда
		Если РеквизитыРТУ.Штраф Тогда	
		//Евросиб СубботинВ #119324 07.10.2025 Конец	
			Если ВызовИсключения Тогда
				ВызватьИсключение("Недостаточно прав для выполнения операции. Документ " + СписокРТУ[0].Ссылка + " имеет признак Штраф");
			Иначе МассивШтрафныхДокументов.Добавить(СписокРТУ[0].Ссылка);				
			КонецЕсли;
		КонецЕсли;
		//Евросиб СубботинВ #119324 07.10.2025 Начало
		Для Каждого СтрокаУслуг из РеквизитыРТУ.Услуги.Выгрузить() Цикл
			Если НЕ НоменклатурыБлокировкиПечатиРТУ.НайтиПоЗначению(СтрокаУслуг.Номенклатура) = Неопределено Тогда
				МассивШтрафныхДокументов.Добавить(РеквизитыРТУ.Ссылка);
				Прервать;
				//ВызватьИсключение("Печать РТУ с номенклатурой: " + СтрокаУслуг.Номенклатура + " Запрещена");
			КонецЕсли;
		КонецЦикла;
		//Евросиб СубботинВ #119324 07.10.2025 Конец
	ИначеЕсли СписокРТУ.Количество() > 1 Тогда		
		Для Каждого РТУ из СписокРТУ Цикл
			//Евросиб СубботинВ #119324 07.10.2025 Начало
			РеквизитыРТУ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РТУ,"Штраф, Услуги");
			//Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РТУ,"Штраф",) Тогда
			Для Каждого СтрокаУслуг из РеквизитыРТУ.Услуги.Выгрузить() Цикл
				Если НЕ НоменклатурыБлокировкиПечатиРТУ.НайтиПоЗначению(СтрокаУслуг.Номенклатура) = Неопределено Тогда
					МассивШтрафныхДокументов.Добавить(РТУ);
					Прервать;
					//ВызватьИсключение("Печать РТУ с номенклатурой: " + СтрокаУслуг.Номенклатура + " Запрещена");
				КонецЕсли;
			КонецЦикла;			
			Если РеквизитыРТУ.Штраф Тогда
			//Евросиб СубботинВ #119324 07.10.2025 Конец
				МассивШтрафныхДокументов.Добавить(РТУ);
			КонецЕсли;
		КонецЦикла;		
	КонецЕсли;
	Возврат МассивШтрафныхДокументов
	
КонецФункции
