	//Евросиб Каблов 31.05.2022 ( Task 45436
	|	,Доходы.ДокументФФД КАК ДокументФФД,
	|	ЕСТЬNULL(ФормированиеФинДокументов.ЗаменятьСтанциюНаОсновную, ЛОЖЬ) КАК ЗаменятьСтанциюНаОсновную
	//Евросиб Каблов 31.05.2022 )
	|ИЗ
	|	Документ.Сделка.Доходы КАК Доходы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.ДоходыКТК КАК СделкаДоходыКТК
	//Евросиб - АСуслов 25.07.2022 10:51:05 #
	//(
	//|		ПО Доходы.Ссылка = СделкаДоходыКТК.Ссылка
	//|			И Доходы.ГУИД = СделкаДоходыКТК.ГУИД
	//|			И Доходы.ГУИД = СделкаДоходыКТК.ГУИД
	//|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.ДоходыВагоны КАК СделкаДоходыВагоны
	//|		ПО Доходы.Ссылка = СделкаДоходыВагоны.Ссылка
	|		ПО Доходы.ГУИД = СделкаДоходыКТК.ГУИД
	|			И Доходы.Ссылка = СделкаДоходыКТК.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.ДоходыВагоны КАК СделкаДоходыВагоны
	|		ПО Доходы.ГУИД = СделкаДоходыВагоны.ГУИД
	|			И Доходы.Ссылка = СделкаДоходыВагоны.Ссылка
