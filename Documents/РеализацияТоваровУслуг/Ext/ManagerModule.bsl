Функция ДокументыСКорректировкойДолга(МассивДокументов) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КорректировкаДолгаДебиторскаяЗадолженность.Сделка КАК Сделка
	|ПОМЕСТИТЬ втДокументы
	|ИЗ
	|	Документ.КорректировкаДолга.ДебиторскаяЗадолженность КАК КорректировкаДолгаДебиторскаяЗадолженность
	|ГДЕ
	|	КорректировкаДолгаДебиторскаяЗадолженность.Сделка В(&МассивДокументов)
	|	И КорректировкаДолгаДебиторскаяЗадолженность.Ссылка.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КорректировкаДолгаКредиторскаяЗадолженность.Сделка
	|ИЗ
	|	Документ.КорректировкаДолга.КредиторскаяЗадолженность КАК КорректировкаДолгаКредиторскаяЗадолженность
	|ГДЕ
	|	КорректировкаДолгаКредиторскаяЗадолженность.Сделка В(&МассивДокументов)
	|	И КорректировкаДолгаКредиторскаяЗадолженность.Ссылка.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	втДокументы.Сделка КАК Сделка
	|ИЗ
	|	втДокументы КАК втДокументы";
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	МассивДокументовСКорректировкой = РезультатЗапроса.ВыгрузитьКолонку("Сделка");
	
	Возврат МассивДокументовСКорректировкой;
КонецФункции
