#Область ПЕЧАТЬ

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода,Знач СтруктураПодписантов = Неопределено) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктСдачиПриемки") Тогда
		
		ПараметрыПечати.Вставить("ВидДокументаПечати",  "РеализацияТоваровУслуг");
		ПараметрыПечати.Вставить("ИмяПараметровПечати", "ПАРАМЕТРЫ_ПЕЧАТИ_РеализацияТоваровУслуг_Акт");
		ПараметрыПечати.Вставить("ИмяМакетаПечати",     "Документ.РеализацияТоваровУслуг.ПФ_MXL_АктСдачиПриемки");

		СформироватьПечатнуюФормуАкта(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, "АктСдачиПриемки", "Акт сдачи-приемки",
		ОбъектыПечати, ПараметрыВывода,СтруктураПодписантов);
		
	КонецЕсли;                                                                                      	
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "УниверсальныйПередаточныйДокумент981") Тогда
		
		СформироватьПечатнуюФормуУПД(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм,"УниверсальныйПередаточныйДокумент981", "Универсальный передаточный документ",
		ОбъектыПечати, ПараметрыВывода,СтруктураПодписантов);
		
	КонецЕсли;
	
КонецПроцедуры	

Процедура СформироватьПечатнуюФормуУПД (МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ИмяМакета, СинонимМакета, ОбъектыПечати, ПараметрыВывод,СтруктураПодписантов)
	
	Для каждого ЭлМассива из МассивОбъектов Цикл
		
//Евросиб Литвинов 19.08.2021 ( #35933 #36212
		Если ПечатьКомплектаДокументов.ПолучитьПечатнуюФормуИзДиадок(КоллекцияПечатныхФорм, ЭлМассива, ИмяМакета, СинонимМакета) Тогда
			Продолжить;
		КонецЕсли;
//Евросиб Литвинов 19.08.2021 ) #35933 #36212 

		ТаблицаСведенийСчетФактуры = ПолучитьТаблицуСведенийДляУПД(ЭлМассива);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, ИмяМакета, СинонимМакета,
		ПечатьБухгалтерскихДокументов.ПечатьУПД981(ТаблицаСведенийСчетФактуры, ОбъектыПечати,ПараметрыПечати,СтруктураПодписантов),,"ОбщийМакет.ПФ_MXL_УниверсальныйПередаточныйДокумент981");
		
	КонецЦикла;	
	
КонецПроцедуры

Функция ПолучитьТаблицуСведенийДляУПД(Документ)
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаСведений = ПечатьБухгалтерскихДокументов.ПолучитьОписаниеСчетФактуры();
	ТаблицаДокумента = ПечатьБухгалтерскихДокументов.ПолучитьОписаниеТаблицыСчетФактуры();
	
	ТекстЗапроса = ПолучитьТекстЗапросаДляПечатиУПД();
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	ЗАпрос.УстановитьПараметр("Документ",Документ);
	// Субботин TASK 72390 18.07.2023  Начало
	ВалютаРегУчета = Константы.ВалютаРегламентированногоУчета.Получить();	
	Запрос.УстановитьПараметр("КодВалютаДляДоговоров_в_УЕ", ВалютаРегУчета.Код);
    Запрос.УстановитьПараметр("НаименованиеВалютаДляДоговоров_в_УЕ", ВалютаРегУчета.Наименование);
	// Субботин TASK 72390 18.07.2023  Конец
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СведенияОДокументе = ТаблицаСведений.Добавить();
		ЗаполнитьЗначенияСвойств(СведенияОДокументе,Выборка);            
		//Евросиб - АСуслов 14.09.2022 11:47:17 #
		//(
		ФакторингСервер.ЗаполнитьПараметрыФакторинга(СведенияОДокументе);
		//)
		//Евросиб - АСуслов 14.09.2022 11:47:18 #
		СведенияОДокументе.ПредставлениеПоставщика = Выборка.Продавец.НаименованиеПолное;
		СведенияОДокументе.АдресПоставщика = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Выборка.Продавец,
		?(ТипЗнч(Выборка.Продавец)=Тип("СправочникСсылка.Контрагенты"),Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента,Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации),Выборка.ДатаДокумента,Истина);
		СведенияОДокументе.ПредставлениеГрузоотправителя = "-";
		СведенияОДокументе.ПредставлениеГрузополучателя  = "-";
		СведенияОДокументе.ПредставлениеПокупателя = Выборка.Контрагент.НаименованиеПолное;
		СведенияОДокументе.ИННПоставщика = Выборка.ИННПоставщика+"/"+Выборка.КПППродавца;
		СведенияОДокументе.ПоДокументу = "К платежно-расчетному документу №"+?(ЗначениеЗаполнено(СведенияОДокументе.НомерПлатежноРасчетногоДокумента),СведенияОДокументе.НомерПлатежноРасчетногоДокумента,"_______")
		+"от"+?(СведенияОДокументе.ДатаПлатежноРасчетногоДокумента<>Дата('00010101'),СведенияОДокументе.ДатаПлатежноРасчетногоДокумента,"_______");
		СведенияОДокументе.АдресПокупателя = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Выборка.Контрагент,Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента,Выборка.ДатаДокумента,Истина);
		СведенияОДокументе.ИННПокупателя =Выборка.ИННПокупателя+"/"+Выборка.КПППокупателя;
		СведенияОДокументе.ДоверенностьЗаРуководителя = Выборка.ДоверенностьЗаРуководителя;
		СведенияОДокументе.ДоверенностьЗаГлБухгалтера = Выборка.ДоверенностьЗаГлБухгалтера;
		
		ТекстЗАпроса = ПолучитьТекстЗапросаДляПечатиТаблицыУПД();
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("Документ",Документ);
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		Пока РезультатЗапроса.Следующий() Цикл
			Строка = ТаблицаДокумента.Добавить();
			ЗаполнитьЗначенияСвойств(Строка,РезультатЗапроса);
			Строка.Всего = ?(РезультатЗапроса.СуммаВключаетНДС,РезультатЗапроса.Сумма, РезультатЗапроса.Сумма + РезультатЗапроса.СуммаНДС);
		КонецЦикла;
		СведенияОДокументе.ТаблицаДокумента = ТаблицаДокумента;
	КонецЦикла;	
	
	Возврат ТаблицаСведений;
КонецФункции

Функция ПолучитьТекстЗапросаДляПечатиУПД()
	ТекстЗапроса = 
	"ВЫБРАТЬ
	//|	РеализацияТоваровУслуг.Номер КАК Номер,
	|	РеализацияТоваровУслуг.НомерДляПечати КАК Номер,				   
	//|	РеализацияТоваровУслуг.Дата КАК ДатаДокумента,
	|	РеализацияТоваровУслуг.ДатаДокумента КАК ДатаДокумента,
	|	РеализацияТоваровУслуг.Организация КАК Организация,
	|	РеализацияТоваровУслуг.Контрагент КАК Контрагент,
	|	РеализацияТоваровУслуг.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	РеализацияТоваровУслуг.ВалютаДокумента КАК ВалютаДокумента,
	|	РеализацияТоваровУслуг.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	РеализацияТоваровУслуг.КурсВзаиморасчетов КАК КурсВзаиморасчетов,
	|	РеализацияТоваровУслуг.КратностьВзаиморасчетов КАК КратностьВзаиморасчетов,
	|	РеализацияТоваровУслуг.Руководитель КАК Руководитель,
	|	РеализацияТоваровУслуг.ЗаРуководителяНаОсновании КАК ЗаРуководителяНаОсновании,
	|	РеализацияТоваровУслуг.ЗаГлавногоБухгалтераНаОсновании КАК ЗаГлавногоБухгалтераНаОсновании,
	|	РеализацияТоваровУслуг.ГлавныйБухгалтер КАК ГлавныйБухгалтер,
	|	РеализацияТоваровУслуг.Ссылка КАК Документ,
	|	ЛОЖЬ КАК Исправление,
	|	ЗНАЧЕНИЕ(Перечисление.ВидСчетаФактурыВыставленного.НаРеализацию) КАК ВидСчетаФактуры,
	|	РеализацияТоваровУслуг.ДоговорКонтрагента.Номер КАК НомерДоговора,
	|	РеализацияТоваровУслуг.ДоговорКонтрагента.Дата КАК ДатаДоговора,
	|	РеализацияТоваровУслуг.Контрагент.КПП КАК КПППокупателя,
	|	РеализацияТоваровУслуг.Организация.КПП КАК КПППродавца,
	|	РеализацияТоваровУслуг.Организация.ИНН КАК ИННПоставщика,
	|	РеализацияТоваровУслуг.Контрагент.ИНН КАК ИННПокупателя,
	|	ВЫБОР
	|		КОГДА РеализацияТоваровУслуг.ДоговорКонтрагента.РасчетыВУсловныхЕдиницах
	|			ТОГДА &КодВалютаДляДоговоров_в_УЕ
