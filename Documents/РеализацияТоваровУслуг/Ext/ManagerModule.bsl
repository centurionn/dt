#Область СтандартныеПроцедуры

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Поля = Новый Массив;
	Поля.Добавить("НомерДляПечати");
	Поля.Добавить("Номер");
	Поля.Добавить("Дата");
	Поля.Добавить("ДатаДокумента");
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	НомерЪ = ?(ЗначениеЗаполнено(Данные.НомерДляПечати), Данные.НомерДляПечати, Данные.Номер);
	ДатаЪ = ?(ЗначениеЗаполнено(Данные.ДатаДокумента), Данные.ДатаДокумента, Данные.Дата);
	
	Представление = "Реализация " + НомерЪ + " от " + Формат(ДатаЪ, "ДФ='dd.MM.yy ЧЧ:мм'");
	
КонецПроцедуры

#КонецОбласти

