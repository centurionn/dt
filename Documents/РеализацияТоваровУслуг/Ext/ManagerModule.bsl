	|	ЕСТЬNULL(ИсторияФакторинга.ДоговорКомпанииФактор.ДополнительнаяИнформацияФакторинг, """") КАК ДополнительнаяИнформацияФакторинг,
	|	ВЫБОР
	|		КОГДА ИсторияФакторинга.ДоговорКомпанииФактор ЕСТЬ NULL
