//Евросиб Каблов 26.08.2025 #111011
Процедура ЗаполнитьВидыДоходовПоСчетам(СчетаНаОплатуПокупателям) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеализацияТоваровУслугСчетаНаОплатуПокупателям.НомерСтроки КАК НомерСтроки,
	|	РеализацияТоваровУслугСчетаНаОплатуПокупателям.СчетПокупателю КАК СчетПокупателю,
	|	РеализацияТоваровУслугСчетаНаОплатуПокупателям.Номенклатура КАК Номенклатура,
	|	РеализацияТоваровУслугСчетаНаОплатуПокупателям.Сумма КАК Сумма,
	|	РеализацияТоваровУслугСчетаНаОплатуПокупателям.Количество КАК Количество,
	|	РеализацияТоваровУслугСчетаНаОплатуПокупателям.Контейнер КАК Контейнер
	|ПОМЕСТИТЬ Счета
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.СчетаНаОплатуПокупателям КАК РеализацияТоваровУслугСчетаНаОплатуПокупателям
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Счета.НомерСтроки КАК НомерСтроки,
	|	Счета.СчетПокупателю КАК СчетПокупателю,
	|	Счета.Номенклатура КАК Номенклатура,
	|	Счета.Сумма КАК Сумма,
	|	Счета.Количество КАК Количество,
	|	Счета.Контейнер КАК Контейнер,
	|	СчетНаОплатуПокупателюТовары.Калькуляция КАК Калькуляция
	|ПОМЕСТИТЬ УслугиСчетов
	|ИЗ
	|	Счета КАК Счета
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетНаОплатуПокупателю.Товары КАК СчетНаОплатуПокупателюТовары
	|		ПО Счета.СчетПокупателю = СчетНаОплатуПокупателюТовары.Ссылка
	|			И Счета.Номенклатура = СчетНаОплатуПокупателюТовары.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Счета.НомерСтроки КАК НомерСтроки,
	|	Счета.СчетПокупателю КАК СчетПокупателю,
	|	Счета.Номенклатура КАК Номенклатура,
	|	Счета.Сумма КАК Сумма,
	|	Счета.Количество КАК Количество,
	|	Счета.Контейнер КАК Контейнер,
	|	ЗначенияДополнительныхАналитикДокументов.Значение КАК ВидДохода
	|ПОМЕСТИТЬ ВидыДоходовСчетов
	|ИЗ
	|	Счета КАК Счета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхАналитикДокументов КАК ЗначенияДополнительныхАналитикДокументов
	|		ПО Счета.СчетПокупателю = ЗначенияДополнительныхАналитикДокументов.Документ
	|			И (ЗначенияДополнительныхАналитикДокументов.Аналитика = &АналитикаВидЗадолженности)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УслугиСчетов.НомерСтроки КАК НомерСтроки,
	|	УслугиСчетов.СчетПокупателю КАК СчетПокупателю,
	|	УслугиСчетов.Номенклатура КАК Номенклатура,
	|	УслугиСчетов.Сумма КАК Сумма,
	|	УслугиСчетов.Количество КАК Количество,
	|	УслугиСчетов.Контейнер КАК Контейнер,
	|	УслугиСчетов.Калькуляция КАК Калькуляция,
	|	УслугиСчетов.ВидДоходов КАК ВидДоходов,
	|	УслугиСчетов.Приоритет КАК Приоритет
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВидыДоходовСчетов.НомерСтроки КАК НомерСтроки,
	|		ВидыДоходовСчетов.СчетПокупателю КАК СчетПокупателю,
	|		ВидыДоходовСчетов.Номенклатура КАК Номенклатура,
	|		ВидыДоходовСчетов.Сумма КАК Сумма,
	|		ВидыДоходовСчетов.Количество КАК Количество,
	|		ВидыДоходовСчетов.Контейнер КАК Контейнер,
	|		NULL КАК Калькуляция,
	|		ВидыДоходовСчетов.ВидДохода КАК ВидДоходов,
	|		0 КАК Приоритет
	|	ИЗ
	|		ВидыДоходовСчетов КАК ВидыДоходовСчетов
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		УслугиСчетов.НомерСтроки,
	|		УслугиСчетов.СчетПокупателю,
	|		УслугиСчетов.Номенклатура,
	|		УслугиСчетов.Сумма,
	|		УслугиСчетов.Количество,
	|		УслугиСчетов.Контейнер,
	|		УслугиСчетов.Калькуляция,
	|		ВЫБОР
	|			КОГДА ДокументКалькуляция.ТипКалькуляции = ЗНАЧЕНИЕ(Перечисление.ТипыКалькуляций.Доплатные)
	|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыЗадолженности.Доплата)
	|			КОГДА ДокументКалькуляция.ТипКалькуляции = ЗНАЧЕНИЕ(Перечисление.ТипыКалькуляций.Субсидии)
	|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыЗадолженности.Субсидии)
	|			КОГДА ДокументКалькуляция.ТипКалькуляции = ЗНАЧЕНИЕ(Перечисление.ТипыКалькуляций.Премии)
	|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыЗадолженности.Премии)
	|			КОГДА ДокументКалькуляция.ТипКалькуляции = ЗНАЧЕНИЕ(Перечисление.ТипыКалькуляций.ВыдачаКткВРынок)
	|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыЗадолженности.ВыдачаКткВРынок)
	|			ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыЗадолженности.ОсновнойДолг)
	|		КОНЕЦ,
	|		1
	|	ИЗ
	|		УслугиСчетов КАК УслугиСчетов
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Калькуляция КАК ДокументКалькуляция
	|			ПО УслугиСчетов.Калькуляция = ДокументКалькуляция.Ссылка
	|				И УслугиСчетов.Номенклатура = ДокументКалькуляция.ОсновнаяУслуга
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Калькуляция.ММ_КалькуляцияМультимодальнойЦепочки КАК КалькуляцияММ_КалькуляцияМультимодальнойЦепочки
	|			ПО УслугиСчетов.Калькуляция = КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка
	|				И (КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.НомерСтроки = 1)
	|				И УслугиСчетов.Номенклатура = КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.ВыставляемаяУслуга
	|	ГДЕ
	|		(НЕ ДокументКалькуляция.Ссылка ЕСТЬ NULL
	|				ИЛИ НЕ КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.ВыставляемаяУслуга ЕСТЬ NULL
	|				ИЛИ УслугиСчетов.Номенклатура = &УслугаФрахт)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		УслугиСчетов.НомерСтроки,
	|		УслугиСчетов.СчетПокупателю,
	|		УслугиСчетов.Номенклатура,
	|		УслугиСчетов.Сумма,
	|		УслугиСчетов.Количество,
	|		УслугиСчетов.Контейнер,
	|		УслугиСчетов.Калькуляция,
	|		ВЫБОР
	|			КОГДА КалькуляцияЖД_УслугиВнеСтавки.ТипСтавки = ЗНАЧЕНИЕ(Перечисление.ТипыСтавокПротокола.Ставка)
	|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыЗадолженности.ДопУслуга)
	|			ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыЗадолженности.ДопУслугаВР)
	|		КОНЕЦ,
	|		2
	|	ИЗ
	|		УслугиСчетов КАК УслугиСчетов
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Калькуляция.ЖД_УслугиВнеСтавки КАК КалькуляцияЖД_УслугиВнеСтавки
	|			ПО УслугиСчетов.Калькуляция = КалькуляцияЖД_УслугиВнеСтавки.Ссылка
	|				И УслугиСчетов.Номенклатура = КалькуляцияЖД_УслугиВнеСтавки.Услуга) КАК УслугиСчетов
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.РеализацияТоваровУслуг.СчетаНаОплатуПокупателям", "&СчетаНаОплатуПокупателям");	
	Запрос.УстановитьПараметр("СчетаНаОплатуПокупателям", СчетаНаОплатуПокупателям);
	Запрос.УстановитьПараметр("АналитикаВидЗадолженности", ПланыВидовХарактеристик.ДополнительныеАналитикиДокументов.ВидЗадолженности);
	Запрос.УстановитьПараметр("УслугаФрахт", Константы.УслугаФрахтаДляКалькуляции.Получить());
	ТаблицаВидовДоходов = Запрос.Выполнить().Выгрузить();
	
	ПараметрыОтбора = Новый Структура("НомерСтроки");
	Для Каждого Стр Из СчетаНаОплатуПокупателям Цикл
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, Стр);
		НайденныеСтроки = ТаблицаВидовДоходов.НайтиСтроки(ПараметрыОтбора);
		Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
			Стр.ВидДоходов = НайденныеСтроки[0].ВидДоходов;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


