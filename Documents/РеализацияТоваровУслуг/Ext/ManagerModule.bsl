Функция ЕстьПривязанныеОплаты(Ссылка) Экспорт
	
	//Проверка доступности по наличию привязанных оплат
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоступлениеНаРасчетныйСчетДокументыОплаты.Ссылка КАК Ссылка,
	|	СУММА(ПоступлениеНаРасчетныйСчетДокументыОплаты.СуммаОплаты) КАК СуммаОплаты
	|ИЗ
	|	Документ.ПоступлениеНаРасчетныйСчет.ДокументыОплаты КАК ПоступлениеНаРасчетныйСчетДокументыОплаты
	|ГДЕ
	|	ПоступлениеНаРасчетныйСчетДокументыОплаты.ДокументРеализации = &ДокументРеализации
	|	И ПоступлениеНаРасчетныйСчетДокументыОплаты.Ссылка.Проведен
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеНаРасчетныйСчетДокументыОплаты.Ссылка
	|
	|ИМЕЮЩИЕ
	|	СУММА(ПоступлениеНаРасчетныйСчетДокументыОплаты.СуммаОплаты) <> 0";
	Запрос.УстановитьПараметр("ДокументРеализации", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка.Количество() > 0;
	
