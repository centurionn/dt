Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	//Евросиб Каблов 14.08.2025 ( #111016
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеализацияТоваровУслугСчетаНаОплатуПокупателям.НомерСтроки КАК НомерСтроки,
	|	РеализацияТоваровУслугСчетаНаОплатуПокупателям.СчетПокупателю КАК СчетПокупателю
	|ПОМЕСТИТЬ СчетаНаОплатуПокупателям
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.СчетаНаОплатуПокупателям КАК РеализацияТоваровУслугСчетаНаОплатуПокупателям
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетаНаОплатуПокупателям.НомерСтроки КАК НомерСтроки,
	|	СчетаНаОплатуПокупателям.СчетПокупателю КАК СчетПокупателю,
	|	СчетНаОплатуПокупателю.Проведен КАК Проведен,
	|	СчетНаОплатуПокупателю.Представление КАК Представление
	|ИЗ
	|	СчетаНаОплатуПокупателям КАК СчетаНаОплатуПокупателям
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю
	|		ПО СчетаНаОплатуПокупателям.СчетПокупателю = СчетНаОплатуПокупателю.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КорректировкаРеализации.Ссылка КАК Ссылка,
	|	КорректировкаРеализации.ВидОперации КАК ВидОперации,
	|	КорректировкаРеализацииСчетаНаОплатуПокупателям.СчетПокупателю КАК СчетПокупателю,
	|	ЕСТЬNULL(КорректировкаРеализацииСчетаНаОплатуПокупателям.СчетПокупателю.Проведен, ЛОЖЬ) КАК СчетПокупателюПроведен
	|ИЗ
	|	Документ.КорректировкаРеализации КАК КорректировкаРеализации
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации.СчетаНаОплатуПокупателям КАК КорректировкаРеализацииСчетаНаОплатуПокупателям
	|		ПО КорректировкаРеализации.Ссылка = КорректировкаРеализацииСчетаНаОплатуПокупателям.Ссылка
	|ГДЕ
	|	КорректировкаРеализации.ИсходныйДокументРеализации = &Реализация";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.РеализацияТоваровУслуг.СчетаНаОплатуПокупателям", "&СчетаНаОплату");	
	Запрос.УстановитьПараметр("СчетаНаОплату", СчетаНаОплатуПокупателям.Выгрузить(, "НомерСтроки, СчетПокупателю"));
	Запрос.УстановитьПараметр("Реализация", Ссылка);
	Результаты = Запрос.ВыполнитьПакет();
	
	ВыборкаСчетов = Результаты[1].Выбрать();
	Если ВыборкаСчетов.Количество() > 0 Тогда
		Пока ВыборкаСчетов.Следующий() Цикл
			Если Не ВыборкаСчетов.Проведен Тогда
				ПутьКПолюТЧ = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СчетаНаОплатуПокупателям", ВыборкаСчетов.НомерСтроки, "СчетПокупателю");
							ТекстСообщения = СтрШаблон("В строке №%1 выбран счет, который непроведен!", ВыборкаСчетов.НомерСтроки, "");
							ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПутьКПолюТЧ, "Объект", Отказ);
			КонецЕсли;
		КонецЦикла;
	Иначе
		//Разрешать проведение РТУ без счета при наличии связного КорРТУ с видом операции:
		//    а)  Исправление в первичных документах/Корректировка по согласованию сторон и актуального счета в в нем
		//    б)  Аннулирование - без ограничений			
		РазрешитьПроведение = Ложь;
		ВыборкаКорректировок = Результаты[2].Выбрать();
		Пока ВыборкаКорректировок.Следующий() Цикл
			Если ВыборкаКорректировок.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование
					Или ВыборкаКорректировок.СчетПокупателюПроведен Тогда
				РазрешитьПроведение = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не РазрешитьПроведение Тогда
			ОбщегоНазначения.СообщитьПользователю("На вкладке ""Счета покупателям"" не привязаны счета покупателю. Для проведения добавьте хотя - бы один счет",,,, Отказ);
		КонецЕсли;
		
	КонецЕсли;
	//Евросиб Каблов 14.08.2025 ) #111016
	
КонецПроцедуры

