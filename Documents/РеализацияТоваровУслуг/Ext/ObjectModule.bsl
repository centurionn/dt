//Евросиб Каблов 28.11.2025 #111016
Процедура ПроверитьОстаткиПоСчетамПокупателей(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеализацияТоваровУслугСчетаНаОплатуПокупателям.НомерСтроки КАК НомерСтроки,
	|	РеализацияТоваровУслугСчетаНаОплатуПокупателям.СчетПокупателю КАК СчетПокупателю,
	|	РеализацияТоваровУслугСчетаНаОплатуПокупателям.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.СчетаНаОплатуПокупателям КАК РеализацияТоваровУслугСчетаНаОплатуПокупателям
	|ГДЕ
	|	РеализацияТоваровУслугСчетаНаОплатуПокупателям.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетаПокупателейОстатки.СчетПокупателю КАК СчетПокупателю,
	|	СчетаПокупателейОстатки.Номенклатура КАК Номенклатура,
	|	-СчетаПокупателейОстатки.СуммаОстаток КАК СуммаОстаток,
	|	ВТ.НомерСтроки КАК НомерСтроки,
	|	СчетаПокупателейОстатки.СчетПокупателю.НомерДляПечати КАК СчетПокупателюНомерДляПечати,
	|	СчетаПокупателейОстатки.СчетПокупателю.Номер КАК СчетПокупателюНомер,
	|	СчетаПокупателейОстатки.СчетПокупателю.Дата КАК СчетПокупателюДата
	|ИЗ
	|	РегистрНакопления.СчетаПокупателей.Остатки(
	|			,
	|			(СчетПокупателю, Номенклатура) В
	|				(ВЫБРАТЬ
	|					ВТ.СчетПокупателю КАК СчетПокупателю,
	|					ВТ.Номенклатура КАК Номенклатура
	|				ИЗ
	|					ВТ КАК ВТ)) КАК СчетаПокупателейОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ КАК ВТ
	|		ПО СчетаПокупателейОстатки.СчетПокупателю = ВТ.СчетПокупателю
	|			И СчетаПокупателейОстатки.Номенклатура = ВТ.Номенклатура
	|ГДЕ
	|	СчетаПокупателейОстатки.СуммаОстаток < 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	СчетПокупателю,
	|	Номенклатура,
	|	НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.СледующийПоЗначениюПоля("СчетПокупателю") Цикл
