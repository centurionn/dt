Функция НайтиАвансовыйСчет(ДокСделка,Контрагент,Договор)
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СчетНаОплатуПокупателюТовары.Ссылка КАК Ссылка,
	                      |	СчетНаОплатуПокупателюТовары.Сумма КАК Сумма,
	                      |	СчетНаОплатуПокупателюТовары.СтрокаДоходовСделки КАК СтрокаДоходовСделки
	                      |ИЗ
	                      |	Документ.СчетНаОплатуПокупателю.Товары КАК СчетНаОплатуПокупателюТовары
	                      |ГДЕ
	                      |	СчетНаОплатуПокупателюТовары.Ссылка.Контрагент = &Контрагент
	                      |	И СчетНаОплатуПокупателюТовары.Ссылка.ДоговорКонтрагента = &ДоговорКонтрагента
	                      |	И СчетНаОплатуПокупателюТовары.Ссылка.Сделка = &Сделка
	                      |	И СчетНаОплатуПокупателюТовары.Ссылка.АвансовыйСчет = ИСТИНА
	                      |	И СчетНаОплатуПокупателюТовары.Ссылка.ПометкаУдаления = ЛОЖЬ");	
	Запрос.УстановитьПараметр("Сделка", ДокСделка);
	Запрос.УстановитьПараметр("Контрагент",Контрагент);
	Запрос.УстановитьПараметр("ДоговорКонтрагента",Договор);
	
	Выборка = Запрос.Выполнить().Выгрузить();
	Если Выборка.Количество() > 0 Тогда
		Возврат Выборка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
		
КонецФункции

