//Евросиб(ДИТ), Беляев СЮ, BUG 112789 / TA 112793, 25-06-2025, начало
Процедура СформироватьНомерДляПечати()
	
	Если ЭтоНовый() Тогда
		Если НЕ ЗначениеЗаполнено(Номер) Тогда
			УстановитьНовыйНомер();
		КонецЕсли;
		УстановитьНовыйНомерДляПечати();
		Возврат;
	КонецЕсли;
	
	ТребуетсяУстановитьНовыйНомерДляПечати = НЕ ЗначениеЗаполнено(НомерДляПечати);
	РеквизитыДокументаБыло = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "ДатаДокумента, НомерДляПечати, СчетаНаОплатуПокупателям.СчетПокупателю");
	
	Если ЗначениеЗаполнено(НомерДляПечати) Тогда
		
		//контроль смены года
		ГодаРавны = Год(РеквизитыДокументаБыло.ДатаДокумента) = Год(ДатаДокумента);
		Если НЕ ГодаРавны Тогда
			Номер = "";
			НомерДляПечати = "";
			ТребуетсяУстановитьНовыйНомерДляПечати = Истина;
		КонецЕсли;
		
		//проверка ограничений (закрытые период, выгружен в УПП)
		ЕстьОграничения = КонтрольДоступностиДокументов_сервер.ДатаПопадаетВЗакрытыйПериодДоходов(ПериодВО, Организация);
		Если НЕ ЕстьОграничения Тогда
			РезультатПроверки = РегистрыСведений.ПротоколОбменов.ПроверитьВыгрузку(Ссылка, Перечисления.УзлыОбмена.УПП, Перечисления.ДействияПриОбмене.ВыгрузкаДанных);
			ЕстьОграничения = ЕстьОграничения ИЛИ ЗначениеЗаполнено(РезультатПроверки.Ссылка);
		КонецЕсли;
		
		//проверка изменения списка счетов
		Если НЕ ЕстьОграничения И НЕ ТребуетсяУстановитьНовыйНомерДляПечати Тогда
			МассивСчетовБыло = РеквизитыДокументаБыло.СчетаНаОплатуПокупателямСчетПокупателю.Выгрузить().ВыгрузитьКолонку("СчетПокупателю");
			Взаимодействия.УдалитьПовторяющиесяЭлементыМассива(МассивСчетовБыло, Истина);
			МассивСчетов = СчетаНаОплатуПокупателям.ВыгрузитьКолонку("СчетПокупателю");
			Взаимодействия.УдалитьПовторяющиесяЭлементыМассива(МассивСчетов, Истина);
			ИзменилсяСоставСчетов = Не ОбщегоНазначения.КоллекцииИдентичны(МассивСчетовБыло, МассивСчетов);
			ТребуетсяУстановитьНовыйНомерДляПечати = ТребуетсяУстановитьНовыйНомерДляПечати ИЛИ ИзменилсяСоставСчетов;
		КонецЕсли;
			
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Номер) Тогда
		УстановитьНовыйНомер();
		ТребуетсяУстановитьНовыйНомерДляПечати = Истина;
	КонецЕсли;
	
	Если ТребуетсяУстановитьНовыйНомерДляПечати Тогда
		УстановитьНовыйНомерДляПечати();
	КонецЕсли;
	
	НомерДляПечатиДоИзменения = РеквизитыДокументаБыло.НомерДляПечати;
	Если НомерДляПечати <> НомерДляПечатиДоИзменения Тогда
		ДокументВЗакрытомПериоде = КонтрольДоступностиДокументов_сервер.ДатаПопадаетВЗакрытыйПериодДоходов(ПериодВО, Организация);
		Если НЕ ДокументВЗакрытомПериоде Тогда
			//Удаление признака выгрузки
			ЗаписьПротоколаОбмена = РегистрыСведений.ПротоколОбменов.СоздатьМенеджерЗаписи();
			ЗаписьПротоколаОбмена.УзелОбмена = Перечисления.УзлыОбмена.УПП;
			ЗаписьПротоколаОбмена.Объект = Ссылка;
			ЗаписьПротоколаОбмена.ДействиеПриОбмене = Перечисления.ДействияПриОбмене.ВыгрузкаДанных;
			ЗаписьПротоколаОбмена.Удалить();
			ОбщегоНазначения.СообщитьПользователю("Изменился номер для печати, признак выгрузки снят. Был номер " + НомерДляПечатиДоИзменения + " стал " + НомерДляПечати);
		Иначе
			НомерДляПечати = НомерДляПечатиДоИзменения;
			ОбщегоНазначения.СообщитьПользователю("Документ выгружен во внешнюю систему, номер для печати не будет изменен");
		КонецЕсли; 
	КонецЕсли;
		
КонецПроцедуры
//Евросиб(ДИТ), Беляев СЮ, BUG 112789 / TA 112793, 25-06-2025, конец

//Евросиб(ДИТ), Беляев СЮ, BUG 112789 / TA 112793, 25-06-2025, начало
Процедура УстановитьНовыйНомерДляПечати()
	
	ПервоначальныйНомерСчета = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СчетаНаОплатуПокупателям.СчетПокупателю КАК СчетПокупателю
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&СчетаНаОплатуПокупателям КАК СчетаНаОплатуПокупателям
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДокументСчетНаОплатуПокупателю.ПервоначальныйНомер КАК ПервоначальныйНомер,
	|	ДокументСчетНаОплатуПокупателю.СуммаДокумента КАК СуммаДокумента,
	|	1 КАК Приоритет,
	|	ДокументСчетНаОплатуПокупателю.АвансовыйСчет КАК АвансовыйСчет,
	|	ДокументСчетНаОплатуПокупателю.ДатаДокумента КАК ДатаДокумента
	|ИЗ
	|	ВТ КАК ВТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетНаОплатуПокупателю КАК ДокументСчетНаОплатуПокупателю
	|		ПО (ДокументСчетНаОплатуПокупателю.Ссылка = ВТ.СчетПокупателю)
	|			И (ДокументСчетНаОплатуПокупателю.АвансовыйСчет)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДокументСчетНаОплатуПокупателю.ПервоначальныйНомер,
	|	ДокументСчетНаОплатуПокупателю.СуммаДокумента,
	|	2,
	|	ДокументСчетНаОплатуПокупателю.АвансовыйСчет,
	|	ДокументСчетНаОплатуПокупателю.ДатаДокумента
	|ИЗ
	|	ВТ КАК ВТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетНаОплатуПокупателю КАК ДокументСчетНаОплатуПокупателю
	|		ПО (ДокументСчетНаОплатуПокупателю.Ссылка = ВТ.СчетПокупателю)
	|			И (НЕ ДокументСчетНаОплатуПокупателю.АвансовыйСчет)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет,
	|	СуммаДокумента УБЫВ,
	|	ДатаДокумента";
	
	Запрос.УстановитьПараметр("СчетаНаОплатуПокупателям", СчетаНаОплатуПокупателям.Выгрузить(,"СчетПокупателю"));
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ПервоначальныйНомерСчета = Выборка.ПервоначальныйНомер;
	КонецЕсли;
	
	КонтрагентСтранаРегистрации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "СтранаРегистрации");
	НомерДляПечати = Номер + "/" + ?(ПервоначальныйНомерСчета <> "", ПервоначальныйНомерСчета+"/", "") + ?(КонтрагентСтранаРегистрации = Справочники.СтраныМира.Россия, "Р", "Н");
	
	Если ЗначениеЗаполнено(ПравилоФормирования) Тогда
		РазделительЭлементовНомераДляПечати = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПравилоФормирования, "РазделительЭлементовНомераДляПечати");
		Если ЗначениеЗаполнено(РазделительЭлементовНомераДляПечати) Тогда
			НомерДляПечати = СтрЗаменить(НомерДляПечати, "/", РазделительЭлементовНомераДляПечати)
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
//Евросиб(ДИТ), Беляев СЮ, BUG 112789 / TA 112793, 25-06-2025, конец

