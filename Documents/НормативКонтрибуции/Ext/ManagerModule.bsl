Процедура ИнициализироватьДанныеДокумента(Ссылка,ДополнительныеСвойства) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НормативКонтрибуцииНормативы.Ссылка КАК Регистратор,
	|	НормативКонтрибуцииНормативы.Ссылка.Дата КАК Период,
	|	НормативКонтрибуцииНормативы.Продукт КАК Продукт,
	|	НормативКонтрибуцииНормативы.ОфисПродаж КАК ОфисПродаж,
	|	НормативКонтрибуцииНормативы.УчетноеНаправление КАК УчетноеНаправление,
	|	НормативКонтрибуцииНормативы.ПунктОтправления КАК ПунктОтправления,
	|	НормативКонтрибуцииНормативы.ПунктНазначения КАК ПунктНазначения,
	|	ВТ_ТабЧастьКлиенты.Клиент КАК Клиент,
	|	НормативКонтрибуцииНормативы.Ссылка.ДатаНачалаПериодаДействия КАК ДатаНачалаПериодаДействия,
	|	НормативКонтрибуцииНормативы.Ссылка.ДатаОкончанияПериодаДействия КАК ДатаОкончанияПериодаДействия,
	|	НормативКонтрибуцииНормативы.НормативнаяСтавка КАК НормативнаяСтавка,
	|	НормативКонтрибуцииНормативы.ГУИД КАК ГУИД,
	|	НормативКонтрибуцииНормативы.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.НормативКонтрибуции.Нормативы КАК НормативКонтрибуцииНормативы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НормативКонтрибуции.Клиенты КАК ВТ_ТабЧастьКлиенты
	|		ПО НормативКонтрибуцииНормативы.ГУИД = ВТ_ТабЧастьКлиенты.ГУИД
	|			И (ВТ_ТабЧастьКлиенты.Ссылка = &Ссылка)
	|ГДЕ
	|	НормативКонтрибуцииНормативы.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	ДополнительныеСвойства.Вставить("ТаблицаДляДвижения",РезультатЗапроса);
	
КонецПроцедуры	