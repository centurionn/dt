		|			И ВТ_Итог.Клиент = ТабЧасть1.Клиент
		|ИТОГИ ПО
		|	НомерГруппировки";
	
	Запрос.УстановитьПараметр("ТЗ", ЭтотОбъект.Нормативы.Выгрузить());
	Запрос.УстановитьПараметр("ТЗКлиенты", ЭтотОбъект.Клиенты.Выгрузить());
	
