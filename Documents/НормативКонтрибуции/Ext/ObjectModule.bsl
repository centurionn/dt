#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
		
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ПроверитьОбязательныеПоля(Отказ);
	КонецЕсли;	
	
	Редактор = Пользователи.ТекущийПользователь();
	Изменено = ТекущаяДата();
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Автор = Пользователи.ТекущийПользователь();
	ДатаНачалаПериодаДействия 		= Дата(1,1,1);
	ДатаОкончанияПериодаДействия  	= Дата(1,1,1);
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если ЭтоНовый() Тогда
		Автор  = Пользователи.ТекущийПользователь();
		Создано = ТекущаяДата();
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроверитьПересечениеСтавок(Отказ);
	
	Документы.НормативКонтрибуции.ИнициализироватьДанныеДокумента(Ссылка,ДополнительныеСвойства);
	
	СформироватьЗаписиРегистраСведенийСтавкиНормативовКонтрибуции();
	
	ОтложенноеИзменениеСервер.ПоставитьСвязанныеОбъектыВОчередьИзменения(Ссылка);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс
// Код процедур и функций
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Процедура ПроверитьОбязательныеПоля(Отказ)
	Если НЕ ЗначениеЗаполнено(ДатаНачалаПериодаДействия) ИЛИ НЕ ЗначениеЗаполнено(ДатаОкончанияПериодаДействия) Тогда
		ОбщегоНазначения.СообщитьПользователю("Перед проведением необходимо заполнить Период действия." , ЭтотОбъект, ,"Объект.ДатаНачалаПериодаДействия" , Отказ);
	КонецЕсли;	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Запрос = Новый Запрос;
