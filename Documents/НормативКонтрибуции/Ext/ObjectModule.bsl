		|			И ТабЧасть.ПунктОтправления = ТабЧасть1.ПунктОтправления
		|			И ТабЧасть.ПунктНазначения = ТабЧасть1.ПунктНазначения
		|			И ТабЧасть.Клиент = ТабЧасть1.Клиент
		|			И ТабЧасть.ГУИД <> ТабЧасть1.ГУИД
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабЧасть1.НомерСтроки КАК НомерСтроки,
		|	ВТ_Итог.НомерГруппировки КАК НомерГруппировки
		|ИЗ
		|	ВТ_Итог КАК ВТ_Итог
		|		ЛЕВОЕ СОЕДИНЕНИЕ ТабЧасть КАК ТабЧасть1
		|		ПО ВТ_Итог.Продукт = ТабЧасть1.Продукт
		|			И ВТ_Итог.ОфисПродаж = ТабЧасть1.ОфисПродаж
		|			И ВТ_Итог.УчетноеНаправление = ТабЧасть1.УчетноеНаправление
		|			И ВТ_Итог.ПунктОтправления = ТабЧасть1.ПунктОтправления
