Процедура СформироватьЗаписиРегистраСведенийСтавкиНормативовКонтрибуции()
	
	Если НЕ ДополнительныеСвойства.Свойство("ТаблицаДляДвижения") Тогда
		Возврат;
	КонецЕсли;	
	
	Движения.СтавкиНормативовКонтрибуции.Записывать = Истина;
	Движения.СтавкиНормативовКонтрибуции.Загрузить(ДополнительныеСвойства.ТаблицаДляДвижения);
	Движения.Записать();
	
КонецПроцедуры	

Процедура ОбработкаУдаленияПроведения(Отказ)
	Движения.СтавкиНормативовКонтрибуции.Записывать = Истина;
	Движения.СтавкиНормативовКонтрибуции.Очистить();
	Движения.Записать();
КонецПроцедуры

Процедура ПроверитьПересечениеСтавок(Отказ)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НормативКонтрибуции.Ссылка КАК Ссылка,
		|	НормативКонтрибуции.ДатаНачалаПериодаДействия КАК ДатаНачалаПериодаДействия,
		|	НормативКонтрибуции.ДатаОкончанияПериодаДействия КАК ДатаОкончанияПериодаДействия
		|ПОМЕСТИТЬ ВТ_Документ
		|ИЗ
		|	Документ.НормативКонтрибуции КАК НормативКонтрибуции
		|ГДЕ
		|	НормативКонтрибуции.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НормативКонтрибуцииНормативы.Продукт КАК Продукт,
		|	НормативКонтрибуцииНормативы.ОфисПродаж КАК ОфисПродаж,
		|	НормативКонтрибуцииНормативы.УчетноеНаправление КАК УчетноеНаправление,
		|	НормативКонтрибуцииНормативы.ПунктОтправления КАК ПунктОтправления,
		|	НормативКонтрибуцииНормативы.ПунктНазначения КАК ПунктНазначения,
		|	ЕСТЬNULL(ВТ_ТабЧастьКлиенты.Клиент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Клиент,
		|	НормативКонтрибуцииНормативы.Ссылка КАК Ссылка,
		|	НормативКонтрибуцииНормативы.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ ВТ_ДокументТЧ
		|ИЗ
		|	Документ.НормативКонтрибуции.Нормативы КАК НормативКонтрибуцииНормативы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НормативКонтрибуции.Клиенты КАК ВТ_ТабЧастьКлиенты
		|		ПО НормативКонтрибуцииНормативы.ГУИД = ВТ_ТабЧастьКлиенты.ГУИД
		|			И (ВТ_ТабЧастьКлиенты.Ссылка = &Ссылка)
		|ГДЕ
		|	НормативКонтрибуцииНормативы.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
