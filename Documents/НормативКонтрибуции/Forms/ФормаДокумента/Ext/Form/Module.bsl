Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДоступныеТипыЛокаций = ПолучитьТипыЛокаций();
	
КонецПроцедуры

&НаКлиенте
Процедура НормативыПриИзменении(Элемент)
	ТекД = Элементы.Нормативы.ТекущиеДанные;
	
	Если ЗаполнятьПоПервойСтроке Тогда
		ИмяТЧ = Элемент.Имя;
		ИмяПоля = Сред(Элемент.ТекущийЭлемент.Имя, СтрДлина(ИмяТЧ)+1);
		
		НовоеЗначение = ТекД[ИмяПоля];
		
		Для Сч = 0 По Объект[ИмяТЧ].Количество() - 1 Цикл
			РезПроверки = Элементы.Нормативы.ПроверитьСтроку(Объект[ИмяТЧ][Сч].ПолучитьИдентификатор());
			Если РезПроверки = Истина Тогда
				
				Если Сч=0 тогда 
					продолжить;
				КонецЕсли;
				Элементы.Нормативы.ТекущаяСтрока = Объект[ИмяТЧ][Сч].ПолучитьИдентификатор();
				Объект[ИмяТЧ][Сч][ИмяПоля] = НовоеЗначение;	
				
			КонецЕсли; 
			
		КонецЦикла;

	КонецЕсли;
КонецПроцедуры

