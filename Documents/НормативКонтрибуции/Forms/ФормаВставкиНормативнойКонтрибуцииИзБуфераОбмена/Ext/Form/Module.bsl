    ОткрытьФорму("Справочник.Локации.ФормаВыбора",П,Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВТаблицу(Команда)
	Отказ = Ложь;
	
	Результат = Новый Массив;
	
	Для Каждого Строка Из ТаблицаНормативы Цикл
		Если Не ЗначениеЗаполнено(Строка.Продукт) Тогда
			Индекс = ТаблицаНормативы.Индекс(Строка);
			ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Необходимо заполнить продукт.'"), 
			, 
			"ТаблицаНормативы[" + Индекс + "].Продукт", , Отказ);
		КонецЕсли;
		
		//Если Не ЗначениеЗаполнено(Строка.ОфисПродаж) Тогда
		//	Индекс = ТаблицаНормативы.Индекс(Строка);
		//	ОбщегоНазначенияКлиент.СообщитьПользователю(
		//	НСтр("ru = 'Необходимо заполнить Офис продаж.'"), 
		//	, 
		//	"ТаблицаНормативы[" + Индекс + "].ОфисПродаж", , Отказ);
		//КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Строка.УчетноеНаправление) Тогда
			Индекс = ТаблицаНормативы.Индекс(Строка);
			ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Необходимо заполнить Учетное направление.'"), 
			, 
			"ТаблицаНормативы[" + Индекс + "].УчетноеНаправление", , Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Строка.ПунктОтправления) Тогда
			Индекс = ТаблицаНормативы.Индекс(Строка);
			ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Необходимо заполнить Пункт отправления'"), 
			, 
			"ТаблицаНормативы[" + Индекс + "].ПунктОтправления", , Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Строка.ПунктНазначения) Тогда
			Индекс = ТаблицаНормативы.Индекс(Строка);
			ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Необходимо заполнить Пункт назначения.'"), 
			, 
			"ТаблицаНормативы[" + Индекс + "].ПунктНазначения", , Отказ);
		КонецЕсли;
		
		//Если Не ЗначениеЗаполнено(Строка.Клиент) Тогда
		//	Индекс = ТаблицаНормативы.Индекс(Строка);
		//	ОбщегоНазначенияКлиент.СообщитьПользователю(
		//	НСтр("ru = 'Необходимо заполнить Клиента.'"), 
		//	, 
		//	"ТаблицаНормативы[" + Индекс + "].Клиент", , Отказ);
		//КонецЕсли;
		Если Не ЗначениеЗаполнено(Строка.НормативнаяСтавка) Тогда
			Индекс = ТаблицаНормативы.Индекс(Строка);
			ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Необходимо заполнить Нормативную ставку.'"), 
			, 
			"ТаблицаНормативы[" + Индекс + "].НормативнаяСтавка", , Отказ);
		КонецЕсли;
		
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("Продукт", Строка.Продукт);
		СтруктураДанных.Вставить("ОфисПродаж", Строка.ОфисПродаж);
		СтруктураДанных.Вставить("УчетноеНаправление", Строка.УчетноеНаправление);
		СтруктураДанных.Вставить("ПунктОтправления", Строка.ПунктОтправления);
		СтруктураДанных.Вставить("ПунктНазначения", Строка.ПунктНазначения);
		СтруктураДанных.Вставить("Клиент", Строка.Клиент);
		СтруктураДанных.Вставить("НормативнаяСтавка", Строка.НормативнаяСтавка);
		СтруктураДанных.Вставить("ГУИД", Новый УникальныйИдентификатор);
		Результат.Добавить(СтруктураДанных);
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Закрыть(Результат);
КонецПроцедуры
