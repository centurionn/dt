
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОкноСИнструкциями(Форма, Команда)
	ИнструкцииКлиент.ОткрытьОкноСИнструкциями(ЭтаФорма, Команда);
КонецПроцедуры

&НаКлиенте
Процедура Прочитать(Команда)
	ПрочитатьДанныНаСервере()
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДанныНаСервере()
	
	Счетчик = 2;
	ТаблицаНормативы.Очистить();
	
	ПрочитаннаяСтрока = Excel.Область("R" + Счетчик + "C1").Текст + Excel.Область("R" + Счетчик + "C3").Текст + Excel.Область("R" + Счетчик + "C4").Текст + Excel.Область("R" + Счетчик + "C5").Текст + Excel.Область("R" + Счетчик + "C6").Текст;
	
	Пока ПрочитаннаяСтрока <> "" Цикл
		
		НоваяСтрока = ТаблицаНормативы.Добавить();
		
		тПродукт = Excel.Область("R" + Счетчик + "C1").Текст;
		Если тПродукт <> "" Тогда
			Продукт = ПодобратьПродукт(тПродукт);
		КонецЕсли;
		
		тУчетноеНаправление = Excel.Область("R" + Счетчик + "C3").Текст;
		Если тУчетноеНаправление <> "" Тогда
			УчетноеНаправление = ПодобратьУчетноеНаправления(тУчетноеНаправление);
		КонецЕсли;
		
		тПунктОтправления = Excel.Область("R" + Счетчик + "C4").Текст;
		Если тПунктОтправления <> "" Тогда
			ПунктОтправления = ПодобратьПункт(тПунктОтправления);
		КонецЕсли;
		
		тПунктНазначения = Excel.Область("R" + Счетчик + "C5").Текст;
		Если тПунктНазначения <> "" Тогда
			ПунктНазначения = ПодобратьПункт(тПунктНазначения);
		КонецЕсли;
		
		тКлиент = Excel.Область("R" + Счетчик + "C6").Текст;
		Если тКлиент <> "" Тогда
			Клиент = ПодобратьКлиента(тКлиент);
		КонецЕсли;
		
		тНормативнаяСтавка = Excel.Область("R" + Счетчик + "C7").Текст;
		Если тНормативнаяСтавка <> "" Тогда
			НормативнаяСтавка = Число(тНормативнаяСтавка);
		КонецЕсли;
		
		НоваяСтрока.Продукт = Продукт;
		НоваяСтрока.УчетноеНаправление = УчетноеНаправление;
		НоваяСтрока.ПунктОтправления = ПунктОтправления;
		НоваяСтрока.ПунктНазначения = ПунктНазначения;
		НоваяСтрока.НормативнаяСтавка = НормативнаяСтавка;
		НоваяСтрока.Клиент = Клиент;
		
		Счетчик = Счетчик + 1;
		
		ПрочитаннаяСтрока = Excel.Область("R" + Формат(Счетчик, "ЧГ=0") + "C1").Текст;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПодобратьПункт(ЛокацияНаим)
	Ответ = Справочники.Локации.ПустаяСсылка();
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Локации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Локации КАК Локации
		|ГДЕ
		|	Локации.Наименование ПОДОБНО &Наименование
		|	И НЕ Локации.ПометкаУдаления
		|	И Локации.Тип = ЗНАЧЕНИЕ(Справочник.ТипыЛокаций.СтанцияЖД)
		|;
		|ВЫБРАТЬ
		|	Локации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Локации КАК Локации
		|ГДЕ
		|	Локации.Наименование ПОДОБНО &Наименование
		|	И НЕ Локации.ПометкаУдаления
		|	И Локации.Тип = ЗНАЧЕНИЕ(Справочник.ТипыЛокаций.НаселенныйПункт)
		|;
		|ВЫБРАТЬ
		|	Локации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Локации КАК Локации
		|ГДЕ
		|	Локации.Наименование ПОДОБНО &Наименование
		|	И НЕ Локации.ПометкаУдаления
		|	И Локации.Тип = ЗНАЧЕНИЕ(Справочник.ТипыЛокаций.Регион)
		|;
		|ВЫБРАТЬ
		|	Локации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Локации КАК Локации
		|ГДЕ
		|	Локации.Наименование ПОДОБНО &Наименование
		|	И НЕ Локации.ПометкаУдаления
		|	И Локации.Тип = ЗНАЧЕНИЕ(Справочник.ТипыЛокаций.Страна)";
	
	Запрос.УстановитьПараметр("Наименование", "%" + ЛокацияНаим + "%");	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаСтанцияЖД = РезультатЗапроса[0].Выбрать();
	ВыборкаНаселенныйПункт = РезультатЗапроса[1].Выбрать();
	ВыборкаРегион = РезультатЗапроса[2].Выбрать();
	ВыборкаСтрана = РезультатЗапроса[3].Выбрать();
	
	Если ВыборкаСтанцияЖД.Количество() > 1 Тогда
		Возврат Ответ;
	КонецЕсли;
	
	Пока ВыборкаСтанцияЖД.Следующий() Цикл
		Возврат ВыборкаСтанцияЖД.Ссылка;
	КонецЦикла;
	
	Если ВыборкаНаселенныйПункт.Количество() > 1 Тогда
		Возврат Ответ;
	КонецЕсли;
	
	Пока ВыборкаНаселенныйПункт.Следующий() Цикл
		Возврат ВыборкаНаселенныйПункт.Ссылка;
	КонецЦикла;
	
	Если ВыборкаРегион.Количество() > 1 Тогда
		Возврат Ответ;
	КонецЕсли;
	
	Пока ВыборкаРегион.Следующий() Цикл
		Возврат ВыборкаРегион.Ссылка;
	КонецЦикла;
	
	Если ВыборкаСтрана.Количество() > 1 Тогда
		Возврат Ответ;
	КонецЕсли;
	
	Пока ВыборкаСтрана.Следующий() Цикл
		Возврат ВыборкаСтрана.Ссылка;
	КонецЦикла;
	
	Возврат Ответ;
	
КонецФункции

&НаСервере
Функция ПодобратьПродукт(Продукт)
	Ответ = Справочники.ПродуктыДКП.ПустаяСсылка();
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПродуктыДКП.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ПродуктыДКП КАК ПродуктыДКП
		|ГДЕ
		|	ПродуктыДКП.Наименование = &Наименование
		|	И НЕ ПродуктыДКП.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Наименование", Продукт);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Количество() > 1 Тогда
		Возврат Ответ;
	КонецЕсли;	
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Возврат Ответ;
	
КонецФункции

