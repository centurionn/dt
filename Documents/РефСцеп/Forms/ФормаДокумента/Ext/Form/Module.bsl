&НаКлиенте
Процедура ПодобратьЗаявкиДляКТК(Команда)

	Если не объект.Проведен Тогда 
		ОбщегоНазначенияКлиент.СообщитьПОльзователю("Подбор заявок возможен только для проведенного документа.");
		Возврат;
	КонецЕсли;	
	
	Если ЭтаФорма.Модифицированность или не Объект.Проведен Тогда 
		ОписаниеОповещения = Новый ОписаниеОповещения("ПодборЗаявокПодтверждено", ЭтаФорма);
		ПоказатьВопрос(ОписаниеОповещения, "Для продолжения подбора заявок требуется записать данные. Записать данные?"
			, РежимДиалогаВопрос.ДаНет);
	Иначе 
		ПодборЗаявокПродолжение();
	КонецЕсли;	
КонецПроцедуры 

&НаКлиенте
Процедура ПодборЗаявокПодтверждено(П1 = неопределено, П2 = неопределено) Экспорт 
	
	Если П1 <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;

	Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
	
	ПодборЗаявокПродолжение();

КонецПроцедуры
	
&НаКлиенте
Процедура ПодборЗаявокПродолжение()
	//Субботин 76108 25.10.2023 начало// поменял алгоритм на поиск по ктк
	//ПодобратьЗаявкиНаСервере();
	  ПодобратьЗаявкиПоКткНаСервере();
	//Субботин 76108 25.10.2023 начало// 
	
	// Евросиб(ДИТ) US 85028 ТА 87358 Сержантова А.С. Начало: 01.07.2024
	УстановитьОтборДетализацияПоГрузуПоТЧ("Контейнеры");
	// Евросиб(ДИТ) US 85028 ТА 87358 Сержантова А.С. Конец: 01.07.2024
КонецПроцедуры

&НаСервере
Процедура ПодобратьЗаявкиНаСервере()
	
	МассивКлючейАналитикиЗаявокРефСцепа 
		= РефСцепСервер.ПолучитьЗаявкиПоКлючамАналитикиРефСцепа(ВсеКлючиАналитикиПеревозкиРефСцепа(), Объект.Ссылка).Выгрузить().ВыгрузитьКолонку("КлючАналитикиПеревозки");
		
	ДанныеЗаявокДляПобора       = РефСцепСервер.ПолучитьСписокЗаявокДляДобавленияКонтейнеров(РефСцепСервер.ПолучитьДанныеРефСцепаДляОтбораЗаявок(Объект, Истина));
		
	МассивЗаявокДляПодбора 	    = ДанныеЗаявокДляПобора.СписокЗаявок;
	ЗаявкиДляПодбора    	    = ЗаявкиДляПодбора(МассивЗаявокДляПодбора);
	//Субботин 71114 06.09.2023 начало
	МассивКонтейнеровПоЗаявкам  = ДанныеЗаявокДляПобора.СписокЗаявокСКлючамиАналитики;
	
	Для каждого стрЗаявка из ЗаявкиДляПодбора Цикл 
		ПараметрыОтбора = Новый Структура("Ссылка", стрЗаявка.Заявка);
		МассивКТКПоЗаявке = МассивКонтейнеровПоЗаявкам.найтиСТроки(ПараметрыОтбора);
		
		Для каждого СтрКонтейнерРефСцепа из Объект.Контейнеры Цикл
			Для каждого СтрКонтейнер из МассивКТКПоЗаявке цикл
				Если не СтрКонтейнер.Контейнер = СтрКонтейнерРефСцепа.Контейнер Тогда 
					продолжить;
				КонецЕсли;
	//Субботин 71114 06.09.2023 Конец			
				Если Значениезаполнено(СтрКонтейнерРефСцепа.ПеренесенВРефСцеп) Тогда
					Продолжить;
				КонецЕсли;     
				Если МассивКлючейАналитикиЗаявокРефСцепа.Найти(СтрКонтейнерРефСцепа.КлючаналитикиПеревозки) <> Неопределено тОгда
					Продолжить;
				КонецЕсли;     
				Если СтрКонтейнерРефСцепа.Заявка <> Документы.Заявка.ПустаяСсылка() Тогда
					Продолжить;
				КонецЕсли;     
				
				Если СтрКонтейнерРефСцепа.Клиент <> стрЗаявка.Контрагент Тогда
					Продолжить;
				КонецЕсли;     
				
				СтрКонтейнерРефСцепа.ЗаявкаПодбора = стрЗаявка.Заявка;
				
				СтрКонтейнерРефСцепа.Заявка        = стрЗаявка.Заявка;
				
				Сообщить("В подобранном в строку " +СтрКонтейнерРефСцепа.НомерСтроки + " документе " + СтрКонтейнерРефСцепа.ЗаявкаПодбора + " контейнер должен появится в течении часа после проведения документа реф.сцеп.");
				
				МассивКлючейАналитикиЗаявокРефСцепа.Добавить(СтрКонтейнерРефСцепа.КлючАналитикиПеревозки);
				
				ЭтаФорма.Модифицированность = Истина;
			КонецЦикла;	
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Функция ЗаявкиДляПодбора(МассивЗаявокДляДобавления)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Заявка.Ссылка КАК Ссылка,
		|	Заявка.Контрагент КАК Контрагент,
		|	Заявка.Дата КАК Дата
		|ПОМЕСТИТЬ вт_Заявки
		|ИЗ
		|	Документ.Заявка КАК Заявка
		|ГДЕ
		|	Заявка.Ссылка В(&МассивЗаявок)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_Заявки.Контрагент КАК Контрагент,
		|	МАКСИМУМ(вт_Заявки.Дата) КАК Дата
		|ПОМЕСТИТЬ вт_МаксДатыПоКонтрагентам
		|ИЗ
		|	вт_Заявки КАК вт_Заявки
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_Заявки.Контрагент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_Заявки.Ссылка КАК Заявка,
		|	вт_Заявки.Контрагент КАК Контрагент
		|ИЗ
		|	вт_Заявки КАК вт_Заявки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт_МаксДатыПоКонтрагентам КАК вт_МаксДатыПоКонтрагентам
		|		ПО вт_Заявки.Контрагент = вт_МаксДатыПоКонтрагентам.Контрагент
		|			И вт_Заявки.Дата = вт_МаксДатыПоКонтрагентам.Дата";
	
	Запрос.УстановитьПараметр("МассивЗаявок", МассивЗаявокДляДобавления); 
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Процедура ПодобратьЗаявкиПоКткНаСервере() 
	
	СписокНайденыхЗаявокКлючей = ПодобратьЗаявкиПоКТК();
	Для Каждого СтрокаКонтейнера Из Объект.Контейнеры Цикл 
		Если Значениезаполнено(СтрокаКонтейнера.ПеренесенВРефСцеп) Тогда
			Продолжить;
		КонецЕсли;
		ПараметрыОтбора = Новый Структура("Контейнер", СтрокаКонтейнера.Контейнер);
		НайденаяЗаявкаПоКтк = СписокНайденыхЗаявокКлючей.НайтиСтроки(ПараметрыОтбора);
		Если НайденаяЗаявкаПоКтк.Количество() >0 Тогда
			СтрокаКонтейнера.Заявка = НайденаяЗаявкаПоКтк[0].Заявка; 
			СтрокаКонтейнера.ЗаявкаПодбора = НайденаяЗаявкаПоКтк[0].Заявка;
			// Евросиб(ДИТ) US 85028 ТА 87358 Сержантова А.С. Начало: 27.06.2024 
			//Было:
			//СтрокаКонтейнера.КлючАналитикиПеревозки = НайденаяЗаявкаПоКтк[0].КлючАналитикиПеревозки;
			//Стало:
			//Если были строки по детализации, то заменим в них старый ключ на новый 
			СтруктураПоискаДетализации = Новый Структура("КлючАналитикиПеревозки", СтрокаКонтейнера.КлючАналитикиПеревозки); 
			СтрокиПоДетализации = ДетализацияПоГрузу.НайтиСтроки(СтруктураПоискаДетализации);
			Для каждого СтрДетализацииГруза Из СтрокиПоДетализации Цикл
				СтрДетализацииГруза.КлючАналитикиПеревозки = НайденаяЗаявкаПоКтк[0].КлючАналитикиПеревозки; 
			КонецЦикла;
			СтрокаКонтейнера.КлючАналитикиПеревозки = НайденаяЗаявкаПоКтк[0].КлючАналитикиПеревозки;
			
			РеквизитыКлюча = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НайденаяЗаявкаПоКтк[0].КлючАналитикиПеревозки,
								"Груз, ВесГруза,КоличествоМест, ДетализацияПоГрузу,ВерсияДанных"); 
			СтрокаКонтейнера.ВерсияКлюча = РеквизитыКлюча.ВерсияДанных;
			Если не ЗначениеЗаполнено(СтрокаКонтейнера.Груз) Тогда
				СтрокаКонтейнера.Груз = РеквизитыКлюча.Груз;
				СтрокаКонтейнера.КодЕТСНГ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыКлюча.Груз, "ЕТСНГ"); 
				СтрокаКонтейнера.СостояниеКонтейнера = Перечисления.СостоянияКТК.Груженый;
				ВыборкадетализацияГруза = РеквизитыКлюча.ДетализацияПоГрузу.Выбрать(); 
				Пока ВыборкадетализацияГруза.Следующий() Цикл 
					НС = ДетализацияПоГрузу.Добавить();
					ЗаполнитьЗначенияСвойств(НС, ВыборкадетализацияГруза);  
					НС.КлючАналитикиПеревозки = НайденаяЗаявкаПоКтк[0].КлючАналитикиПеревозки; 
				КонецЦикла;
			КонецЕсли; 
			Если не ЗначениеЗаполнено(СтрокаКонтейнера.ВесКонтейнераНетто) Тогда
				СтрокаКонтейнера.ВесКонтейнераНетто = РеквизитыКлюча.ВесГруза;
			КонецЕсли;
			Если не ЗначениеЗаполнено(СтрокаКонтейнера.КоличествоМестКонтейнера) Тогда
				СтрокаКонтейнера.КоличествоМестКонтейнера = РеквизитыКлюча.КоличествоМест;
			КонецЕсли;
			// Евросиб(ДИТ) US 85028 ТА 87358 Сержантова А.С. Конец: 27.06.2024
			ЭтаФорма.Модифицированность = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

  //Субботин 76108 25.10.2023 начало//
&НаСервере
 Функция ПодобратьЗаявкиПоКТК()
	  
	СписокКтк = Объект.Контейнеры.Выгрузить(,"Контейнер");
	СписокКонтрагентов = Объект.Контейнеры.Выгрузить(,"Клиент");
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Заявка.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_заявкиПоКлиентамРефсцепа
		|ИЗ
		|	Документ.Заявка КАК Заявка
		|ГДЕ
		|	Заявка.Контрагент В(&Контрагенты)
		|	И Заявка.Ссылка.Проведен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗаявкаСоставУслуги.Ссылка КАК Заявка,
		|	ЗаявкаСоставУслуги.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	ЗаявкаСоставУслуги.Ссылка.Дата КАК Дата,
		|	ЗаявкаСоставУслуги.НомерКТК КАК НомерКТК
		|ПОМЕСТИТЬ ВТ_НайденныеЗаявки
		|ИЗ
		|	ВТ_заявкиПоКлиентамРефсцепа КАК ВТ_заявкиПоКлиентамРефсцепа
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
		|		ПО ВТ_заявкиПоКлиентамРефсцепа.Ссылка = ЗаявкаСоставУслуги.Ссылка
		|			И (ЗаявкаСоставУслуги.КлючАналитикиПеревозки <> ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПеревозки.ПустаяСсылка))
		|			И (ЗаявкаСоставУслуги.ПеренесенВЗаявку = ЗНАЧЕНИЕ(Документ.Заявка.ПустаяСсылка))
		|			И (ЗаявкаСоставУслуги.НомерКТК В (&СписокКтк))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(ВТ_НайденныеЗаявки.Дата) КАК Дата,
		|	ВТ_НайденныеЗаявки.НомерКТК КАК НомерКТК
		|ПОМЕСТИТЬ ВТ_максДатыПоКтк
		|ИЗ
		|	ВТ_НайденныеЗаявки КАК ВТ_НайденныеЗаявки
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_НайденныеЗаявки.НомерКТК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_НайденныеЗаявки.Заявка КАК Заявка,
		|	ВТ_НайденныеЗаявки.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	ВТ_НайденныеЗаявки.НомерКТК КАК Контейнер
		|ИЗ
		|	ВТ_НайденныеЗаявки КАК ВТ_НайденныеЗаявки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_максДатыПоКтк КАК ВТ_максДатыПоКтк
		|		ПО ВТ_НайденныеЗаявки.Дата = ВТ_максДатыПоКтк.Дата
		|			И ВТ_НайденныеЗаявки.НомерКТК = ВТ_максДатыПоКтк.НомерКТК";
		
	Запрос.УстановитьПараметр("СписокКтк", СписокКтк);
	Запрос.УстановитьПараметр("Контрагенты", СписокКонтрагентов);
	Возврат Запрос.Выполнить().Выгрузить(); 
	
КонецФункции

//Субботин 78646 13.12.2023 Начало
Процедура ЗаполнитьПризнакЭксплуатации()
	
	ТаблицаКТК = Объект.Контейнеры.Выгрузить(,"Контейнер");
	ТаблицаВагонов = Объект.ВагоныРефСцепа.Выгрузить(,"Контейнер"); 
	Для каждого СтрокаКТК из ТаблицаВагонов Цикл
		НовСтрока = ТаблицаКТК.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаКТК);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	стоки_ТекущиеДанныеСрезПоследних.тек_ВЭксплуатации КАК тек_ВЭксплуатации,
		|	стоки_ТекущиеДанныеСрезПоследних.КТК КАК КТК
		|ИЗ
		|	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних(, КТК В (&ТаблицаКТК)) КАК стоки_ТекущиеДанныеСрезПоследних";
	
	Запрос.УстановитьПараметр("ТаблицаКТК", ТаблицаКТК);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить(); 
	Для Каждого ктк из Объект.Контейнеры Цикл 
		НайденнаяСтрока = РезультатЗапроса.Найти(Ктк.Контейнер,"КТК");
		Если НайденнаяСтрока<> Неопределено Тогда
			ктк.ПризнакЭксплуатации = НайденнаяСтрока.тек_ВЭксплуатации;
		КонецЕсли;
	КонецЦикла;  
	
	Для Каждого Ктк из Объект.ВагоныРефСцепа Цикл 
		НайденнаяСтрока = РезультатЗапроса.Найти(Ктк.Контейнер,"КТК");
		Если НайденнаяСтрока<> Неопределено Тогда
			Ктк.ПризнакЭксплуатации = НайденнаяСтрока.тек_ВЭксплуатации;
		КонецЕсли;
	КонецЦикла; 


КонецПроцедуры	

&НаКлиенте
Процедура КонтейнерыПринадлежностьКонтейнераОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ТекДанные = Элементы.Контейнеры.ТекущиеДанные;
	Если ТекДанные.ПризнакЭксплуатации и ВыбранноеЗначение = ПредопределенноеЗначение("Перечисление.ПринадлежностьТЕ.КТКлиента") тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("У контейнера имеется открытый подрядческий цикл и изменение принадлежности в рамках текущего цикла невозможно");
		СтандартнаяОбработка = Ложь;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ВагоныРефСцепаПринадлежностьОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
		ТекДанные = Элементы.ВагоныРефСцепа.ТекущиеДанные;
	Если ТекДанные.ПризнакЭксплуатации и ВыбранноеЗначение = ПредопределенноеЗначение("Перечисление.ПринадлежностьТЕ.КТКлиента") тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("У контейнера имеется открытый подрядческий цикл и изменение принадлежности в рамках текущего цикла невозможно");
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
КонецПроцедуры
//Субботин 78646 13.12.2023 Конец

//Субботин 78028 21.12.2023 начало добавил аткуализацию ключей толькко при записи/проведении документа
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)

	// ДИТ US 83041 ТА 83043 Сержантова А.С. Начало: 02.05.2024       
	ВыполнитьПроверкиКорректностиДанныхДляКлючаНаСервере(Отказ); 
	
	Если Отказ Тогда
		Возврат;	
	КонецЕсли;   
	
	Если не ПараметрыЗаписи.Свойство("ВопросВыставленныеСчетаЗадан") Тогда 
		МассивВыставленныхСчетов = ПроверитьВыставленныеПоЗаявкамСчета();  
		Если МассивВыставленныхСчетов.Количество() Тогда
			Отказ = Истина;
			Оповещение = Новый ОписаниеОповещения("ПоказатьВопросПродолжениеЗаписиЗавершение", ЭтаФорма, ПараметрыЗаписи);	
			СчетаСтрока = СтрСоединить(МассивВыставленныхСчетов, ", ");
			ТекстВопроса = "Внимание, вы изменяете данные по заявке, на которую имеются выставленные счета: " + СчетаСтрока;
			СписокКнопок = Новый СписокЗначений;
			СписокКнопок.Добавить(КодВозвратаДиалога.Да, "Продолжить");
			СписокКнопок.Добавить(КодВозвратаДиалога.Отмена, "Отмена");
			ПоказатьВопрос(Оповещение, ТекстВопроса, СписокКнопок,,КодВозвратаДиалога.Да);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	// ДИТ US 83041 ТА 83043 Сержантова А.С. Конец: 02.05.2024
	
	Для Каждого СтрокаТЧ Из Объект.Контейнеры Цикл 
		Если ЗначениеЗаполнено(СтрокаТЧ.Контейнер) Тогда
			СтруктураПоиска = Новый Структура("Контейнер", СтрокаТЧ.Контейнер);
			Если Объект.Контейнеры.НайтиСтроки(СтруктураПоиска).Количество() + Объект.ВагоныРефСцепа.НайтиСтроки(СтруктураПоиска).Количество() > 1  Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю("Контейнер "+ СтрокаТЧ.Контейнер + "  добавлен в рефсцеп дважды. Удалите строку или замените ктк.",,,,Отказ);
				Возврат
			КонецЕсли;
		КонецЕсли;
		НайтиКлючАналитикиПеревозкиКлиент(СтрокаТЧ, "Контейнеры");
	КонецЦикла;
	
	Для Каждого СтрокаТЧ Из Объект.ВагоныРефСцепа Цикл
		Если ЗначениеЗаполнено(СтрокаТЧ.Контейнер) Тогда			
			СтруктураПоиска = Новый Структура("Контейнер", СтрокаТЧ.Контейнер);
			Если Объект.ВагоныРефСцепа.НайтиСтроки(СтруктураПоиска).Количество() + Объект.Контейнеры.НайтиСтроки(СтруктураПоиска).Количество() > 1 Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю("Контейнер "+ СтрокаТЧ.Контейнер + "  добавлен в рефсцеп дважды. Удалите строку или замените ктк.",,,,Отказ);
				Возврат
			КонецЕсли;
		КонецЕсли;
		НайтиКлючАналитикиПеревозкиКлиент(СтрокаТЧ, "ВагоныРефСцепа");
	КонецЦикла;		
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник) 
	
	Если ИмяСобытия = "НеобходимоОбновитьДанныеКлючейАналитикиПеревозки" Тогда	
		Если Источник <> Неопределено и Источник.УникальныйИдентификатор <> ЭтаФорма.УникальныйИдентификатор Тогда
			ПроверитьАктуальностьКлючаАналитики();
			//Евросиб Коханенко Н.А. 09.10.2024 (( #90312
