&НаКлиенте
Процедура СозданиеЗаявкиДГКПродолжение()
	
	//Субботин 76108 25.10.2023 начало// формируем ключи аналитики  перевозки для ктк при формировании заявки 
	 //Субботин 77659 25.01.2024 Начало убрал т.к перед записью
	//Для каждого строка из Объект.Контейнеры цикл
	//	НайтиКлючАналитикиПеревозкиКлиент(строка, "Контейнеры")
	//КонецЦикла;
	 //Субботин 77659 25.01.2024 Конец
	Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
	//Субботин 76108 25.10.2023 Конец
	
	ЭтоКонтейнерСДГК = Истина;
    // Заодно установим снимем отметку
	МассивКонтейнеров = ПолучитьМассивКонтейнеровДляЗаявкиДГК("ВагоныРефСцепа", Новый Массив());
	
	ОчиститьПометкиБезОрганичений();
	
	Если ОшибкаПроверкиДанныхПередСозданиемЗаявки(ЭтоКонтейнерСДГК) Тогда
		Возврат;
	КонецЕсли;	
	
	ПараметрыФормы = Новый Структура("Основание, ЭтоСозданиеЗаявкиИзРефСцепа, МассивКонтейнеров, ДГК"
		, Объект.Ссылка
		, Истина
		, МассивКонтейнеров
		, Истина);
		
	ОткрытьФорму("Документ.Заявка.Форма.ФормаДокумента", ПараметрыФормы);

КонецПроцедуры 

&НаКлиенте
Процедура ОчиститьПометкиБезОрганичений()
	Для Сч = 0 По Объект.ВагоныРефСцепа.Количество() - 1 Цикл
		Объект.ВагоныРефСцепа[Сч].Отметка = Ложь;
	КонецЦикла;
	Для Сч = 0 По Объект.Контейнеры.Количество() - 1 Цикл
		Объект.Контейнеры[Сч].Отметка = Ложь;
	КонецЦикла;
КонецПроцедуры	

&НаКлиенте
Функция ПолучитьМассивКонтейнеровДляЗаявкиДГК(ИмяТЧ, МассивКонтейнеров)
	
	Для Сч = 0 По Объект[ИмяТЧ].Количество() - 1 Цикл
		Если Объект[ИмяТЧ][Сч].ЭтоКонтейнерСДГК или Объект[ИмяТЧ][Сч].ЭтоТанкКонтейнер Тогда 
			МассивКонтейнеров.Добавить(Объект[ИмяТЧ][Сч].Контейнер);
			Объект[ИмяТЧ][Сч].Отметка = Истина;
		Иначе
			Объект[ИмяТЧ][Сч].Отметка = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивКонтейнеров;
	
КонецФункции

#КонецОбласти             

#Область КлючиАналитики
&НаКлиенте
Процедура НайтиКлючАналитикиПеревозкиКлиент(ТекСтр, ИмяТЧ) 
	
	//Субботин 79281 10.01.2024 начало // добавил поля	
	//Структура = Новый Структура("КлючАналитикиПеревозки, Контейнер, Груз, ВерсияКлюча");
	Структура = Новый Структура("КлючАналитикиПеревозки, Контейнер, Груз, ВерсияКлюча, ВесКонтейнераНетто, КоличествоМестКонтейнера");
	//Субботин 79281 10.01.2024 конец 

	ЗаполнитьЗначенияСвойств(Структура, ТекСтр);
		
	Если ТекСтр.ВерсияКлюча = "" Или ТекСтр.ВерсияКлюча = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(ТекСтр.КлючАналитикиПеревозки,"ВерсияДанных") Тогда 
		КлючАналитикиПеревозки = НайтиКлючАналитикиПеревозки(Структура);
	Иначе 
		КлючАналитикиПеревозки = ОбновитьДанныеКлючаАналитикиПеревозки(Структура, ИмяТЧ);
		ОбщегоНазначенияКлиент.СообщитьПользователю("Версия ключа аналитики перевозки устарела, подгружены актуальные данные по строке.");	
	КонецЕсли;	                   
	
	ТекСтр.КлючАналитикиПеревозки = КлючАналитикиПеревозки.КлючАналитикиПеревозки;  
	ТекСтр.ВерсияКлюча 			  = КлючАналитикиПеревозки.ВерсияДанных;
	
КонецПроцедуры

&НаСервере
Функция ОбновитьДанныеКлючаАналитикиПеревозки(ТекСтр, ИмяТЧ)
	
	Структура = Новый Структура("КлючАналитикиПеревозки, ВерсияКлюча");	
	НайденоТЧ = Объект[ИмяТЧ].НайтиСтроки(Новый Структура("КлючАналитикиПеревозки",ТекСтр.КлючАналитикиПеревозки));  
	
	// Евросиб(ДИТ) US 85028 ТА 87358 Сержантова А.С. Начало: 27.06.2024
	//По коду ниже заменено "ТекСтр.КлючАналитикиПеревозки" на "РеквизитыКлючаАналитики"
	РеквизитыКлючаАналитики = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекСтр.КлючАналитикиПеревозки,
								"Груз,ВесГруза,КоличествоМест,Заявка,ВерсияДанных,Контейнер,ДетализацияПоГрузу");
	// Евросиб(ДИТ) US 85028 ТА 87358 Сержантова А.С. Конец: 27.06.2024
	
	Если НайденоТЧ.Количество() Тогда  
		
		Стр 			= НайденоТЧ[0]; 
		Стр.Груз 		= РеквизитыКлючаАналитики.Груз;
		Стр.ВерсияКлюча = РеквизитыКлючаАналитики.ВерсияДанных;
		//Субботин 79281 10.01.2024 начало
		Стр.Контейнер   = РеквизитыКлючаАналитики.Контейнер;
		//Субботин 79281 10.01.2024 Конец 
		
		//Субботин 78028 23.01.2024 Начало
		Стр.ВесКонтейнераНетто   = РеквизитыКлючаАналитики.ВесГруза;
		Стр.КоличествоМестКонтейнера = РеквизитыКлючаАналитики.КоличествоМест;
		//Тестово
		Если ИмяТЧ = "Контейнеры" Тогда
			Стр.ЗаявкаПодбора = РеквизитыКлючаАналитики.Заявка;
		КонецЕсли;		
		//Субботин 78028 23.01.2024 Конец   
		
		// Евросиб(ДИТ) US 85028 ТА 87358 Сержантова А.С. Начало: 27.06.2024
		ТекущиеСтрокиДетализации = ДетализацияПоГрузу.НайтиСтроки(Новый Структура("КлючАналитикиперевозки", ТекСтр.КлючАналитикиПеревозки));
		Для каждого СтрДетализации Из ТекущиеСтрокиДетализации Цикл
			ДетализацияПоГрузу.Удалить(СтрДетализации);	
		КонецЦикла;  
		Если не РеквизитыКлючаАналитики.ДетализацияПоГрузу.Пустой() Тогда
			ВыборкаДетализации = РеквизитыКлючаАналитики.ДетализацияПоГрузу.Выбрать();
			Пока ВыборкаДетализации.Следующий() Цикл
				НС = ДетализацияПоГрузу.Добавить();	
				ЗаполнитьЗначенияСвойств(НС,ВыборкаДетализации); 
				НС.КлючАналитикиПеревозки = ТекСтр.КлючАналитикиПеревозки;
			КонецЦикла;
		КонецЕсли;
		// Евросиб(ДИТ) US 85028 ТА 87358 Сержантова А.С. Конец: 27.06.2024
		
		Структура 		= Новый Структура("КлючАналитикиПеревозки, ВерсияДанных"
			, Стр.КлючАналитикиПеревозки, Стр.ВерсияКлюча);
		
	КонецЕсли;
	
	мДетализацияПоГрузу = РеквизитФормыВЗначение("ДетализацияПоГрузу", Тип("ТаблицаЗначений"));
	
	НайденоГруз = мДетализацияПоГрузу.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки", ТекСтр.КлючАналитикиПеревозки));
	Для Каждого СтрНайденоГруз Из НайденоГруз Цикл 
		мДетализацияПоГрузу.Удалить(СтрНайденоГруз);	
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(Справочники.КлючиАналитикиПеревозки.ПолучитьДетализациюПоГрузу(ТекСтр.КлючАналитикиПеревозки),мДетализацияПоГрузу);
	ЗначениеВРеквизитФормы(мДетализацияПоГрузу, "ДетализацияПоГрузу");
	
	Возврат Структура;
	
КонецФункции

&НаСервере
Функция НайтиКлючАналитикиПеревозки(ТекСтр)
	
	СтруктураКлючаАналитикиПеревозки = Справочники.КлючиАналитикиПеревозки.СтруктураКлючаАналитикиПеревозки();
	СтруктураКлючаАналитикиПеревозки.КлючАналитики = ТекСтр.КлючАналитикиПеревозки; 
	СтруктураКлючаАналитикиПеревозки.Контейнер 	   = ТекСтр.Контейнер;
	//СтруктураКлючаАналитикиПеревозки.РефСцеп	   = Объект.Ссылка;
	СтруктураКлючаАналитикиПеревозки.Груз 		   = ТекСтр.Груз; 
	//Субботин 79281 10.01.2024 начало
	СтруктураКлючаАналитикиПеревозки.ВесГруза      = ТекСтр.ВесКонтейнераНетто;
	СтруктураКлючаАналитикиПеревозки.КоличествоМест = ТекСтр.КоличествоМестКонтейнера;
	//Субботин 79281 10.01.2024 Конец
	
	мДетализацияПоГрузу = РеквизитФормыВЗначение("ДетализацияПоГрузу",Тип("ТаблицаЗначений"));
   	ТЗДетализацияПоГрузу = мДетализацияПоГрузу.СкопироватьКолонки();
	МассивСтрок = ДетализацияПоГрузу.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки", ТекСтр.КлючАналитикиПеревозки));
	Для Каждого СтрМассивСтрок Из МассивСтрок Цикл
		ЗаполнитьЗначенияСвойств(ТЗДетализацияПоГрузу.Добавить(), СтрМассивСтрок);
	КонецЦикла;
	СтруктураКлючаАналитикиПеревозки.ТЧДетализацияПоГрузу = ТЗДетализацияПоГрузу;
	
	// Евросиб(ДИТ) US 85028 ТА 87358 Сержантова А.С. Начало: 27.06.2024
	СтруктураКлючаАналитикиПеревозки.ИзменятьТЧДетализацияПоГрузу = Истина;
	// Евросиб(ДИТ) US 85028 ТА 87358 Сержантова А.С. Конец: 27.06.2024
	
	КлючАналитикиПеревозки = Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлючаАналитикиПеревозки);
	
	Возврат КлючАналитикиПеревозки;
	
КонецФункции

&НаСервере
Процедура ОбновитьДанныеКлючаНаФормеСервер() 
	ОбновитьДанныеКлючаНаФормеПоТЧСервер("ВагоныРефСцепа"); 
	ОбновитьДанныеКлючаНаФормеПоТЧСервер("Контейнеры"); 
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеКлючаНаФормеПоТЧСервер(ИмяТЧ) 
	МассивКлючей = Новый Массив;
	Для Каждого Стр Из Объект[ИмяТЧ] Цикл
		Если ЗначениеЗаполнено(Стр.КлючАналитикиПеревозки) Тогда 
			мМассив = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Стр.КлючАналитикиПеревозки);
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивКлючей, мМассив, Истина); 
		КонецЕсли;
	КонецЦикла;
	// Евросиб(ДИТ) US 85028 ТА 87358 Сержантова А.С. 27.06.2024 + ДетализацияПоГрузу
	Соответствие = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивКлючей,"Груз, Контейнер, КоличествоМест, ВесГруза, Заявка, ВерсияДанных, ДетализацияПоГрузу");
	Для Каждого Стр Из Объект[ИмяТЧ] Цикл 
		Структура = Соответствие.Получить(Стр.КлючАналитикиПеревозки);
		Если Структура <> Неопределено Тогда 
			Стр.Груз = Структура.Груз;
			//Субботин 79281 10.01.2024 начало
			стр.ВерсияКлюча = Структура.ВерсияДанных;
			стр.КоличествоМестКонтейнера = Структура.КоличествоМест;
			стр.Заявка = Структура.Заявка;
			стр.ВесКонтейнераНетто = Структура.ВесГруза;
				//Субботин 78028 23.01.2024 Начало
			стр.Контейнер = Структура.Контейнер;
			Если ИмяТЧ = "Контейнеры" Тогда
				Стр.ЗаявкаПодбора = Структура.Заявка;
			КонецЕсли;
				//Субботин 78028 23.01.2024 Конец
			//Субботин 79281 10.01.2024 Конец
			
			// Евросиб(ДИТ) US 85028 ТА 87358 Сержантова А.С. Начало: 27.06.2024
			ТекущиеСтрокиДетализации = ДетализацияПоГрузу.НайтиСтроки(Новый Структура("КлючАналитикиперевозки", Стр.КлючАналитикиПеревозки));
			Для каждого СтрДетализации Из ТекущиеСтрокиДетализации Цикл
				ДетализацияПоГрузу.Удалить(СтрДетализации);	
			КонецЦикла;  
			Если не Структура.ДетализацияПоГрузу.Пустой() Тогда
				ВыборкаДетализации = Структура.ДетализацияПоГрузу.Выбрать();
				Пока ВыборкаДетализации.Следующий() Цикл
					НС = ДетализацияПоГрузу.Добавить();	
					ЗаполнитьЗначенияСвойств(НС,ВыборкаДетализации); 
					НС.КлючАналитикиПеревозки = стр.КлючАналитикиПеревозки;
				КонецЦикла;
			КонецЕсли;
			// Евросиб(ДИТ) US 85028 ТА 87358 Сержантова А.С. Конец: 27.06.2024
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры 

&НаСервере
Процедура ДетализацияПоГрузуИзКлючей()
	МассивКлючей = Новый Массив;
	ДополнитьМассивКлючей(МассивКлючей, "ВагоныРефСцепа");
	ДополнитьМассивКлючей(МассивКлючей, "Контейнеры");
	ТЗ = Справочники.КлючиАналитикиПеревозки.ПолучитьДетализациюПоГрузу(МассивКлючей); 
	ДетализацияПоГрузу.Загрузить(ТЗ); 
КонецПроцедуры	

&НаСервере
Процедура ДополнитьМассивКлючей(МассивКлючей, ИмяТЧ)

	Для Каждого Стр Из Объект[ИмяТЧ] Цикл
		Если ЗначениеЗаполнено(Стр.КлючАналитикиПеревозки) Тогда 
			мМассив = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Стр.КлючАналитикиПеревозки);
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивКлючей, мМассив, Истина); 
		КонецЕсли;
	КонецЦикла;	

КонецПроцедуры	

#КонецОбласти

#Область Задачи

&НаСервере
Процедура ЗакрытьЗадачу(Состояние)
	тзСостояния = Объект.Состояния.Выгрузить();
	
	мСостояния = тзСостояния.НайтиСтроки(Новый Структура("Состояние", Состояние));
	ЕстьИзменения = Ложь;
	Для каждого стр из мСостояния Цикл
		СтатусВыполнен = Перечисления.СтатусыЭтапов.Выполнен;
		Если Стр.Статус <> СтатусВыполнен Тогда
			Стр.Статус = СтатусВыполнен;
			Стр.ВыполнениеЗафиксировано = Истина; 
			ЕстьИзменения = Истина;
			Прервать;	
		КонецЕсли;	
	КонецЦикла;      
	Если мСостояния.Количество()>0 Тогда
		// Ставим задачу на первое место, что б выполнение не обнулялось после записи;
		тзСостояния.Сдвинуть(Стр, - тзСостояния.Индекс(Стр));
		
	КонецЕсли;
	
	Если ЕстьИзменения Тогда
		Объект.Состояния.Загрузить(тзСостояния);
	КонецЕсли;	
	
КонецПроцедуры

