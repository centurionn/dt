#Область ДетализацияПоГрузу

&НаКлиенте
Процедура ДетализацияПоГрузуПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		Если Элементы.КонтейнерыДетализацияПоГрузу.Пометка Тогда
			Если ЗначениеЗаполнено(Элементы.Контейнеры.ТекущиеДанные.КлючАналитикиПеревозки) Тогда
				Элементы.ДетализацияПоГрузу.ТекущиеДанные.КлючАналитикиПеревозки 
					= Элементы.Контейнеры.ТекущиеДанные.КлючАналитикиПеревозки;
			КонецЕсли;		
		Иначе
			Если ЗначениеЗаполнено(Элементы.ВагоныРефСцепа.ТекущиеДанные.КлючАналитикиПеревозки) Тогда
				Элементы.ДетализацияПоГрузу.ТекущиеДанные.КлючАналитикиПеревозки 
					= Элементы.ВагоныРефСцепа.ТекущиеДанные.КлючАналитикиПеревозки;
			КонецЕсли;		
		КонецЕсли;	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КонтейнерыГрузОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	ГрузОбработкаВыбора(ВыбранноеЗначение, СтандартнаяОбработка, "Контейнеры");

КонецПроцедуры

&НаКлиенте
Процедура ВагоныРефСцепаГрузОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ГрузОбработкаВыбора(ВыбранноеЗначение, СтандартнаяОбработка, "ВагоныРефСцепа");
КонецПроцедуры

&НаКлиенте
Процедура ГрузОбработкаВыбора(ВыбранноеЗначение, СтандартнаяОбработка, ИмяТЧ)

	ТекущиеДанные = Элементы[ИмяТЧ].ТекущиеДанные;

	Если ВыбранноеЗначение <> ПредопределенноеЗначение("Справочник.Грузы.СборнаяКонтейнернаяОтправка") 
		и ТекущиеДанные.Груз = ПредопределенноеЗначение("Справочник.Грузы.СборнаяКонтейнернаяОтправка") 
		Тогда
		
		Найдено = ДетализацияПоГрузу.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки",ТекущиеДанные.КлючАналитикиПеревозки));
		Для Каждого СтрНайдено Из Найдено Цикл 
			ДетализацияПоГрузу.Удалить(ДетализацияПоГрузу.Индекс(СтрНайдено));
		КонецЦикла;
	КонецЕсли;
	//Субботин 78028 21.12.2023 убираем изменения ключей везде кроме проведения/записи
	//НайтиКлючАналитикиПеревозкиКлиент(ТекущиеДанные, ИмяТЧ);
    //Субботин 78028 21.12.2023 конец
КонецПроцедуры

&НаКлиенте
Функция ЕстьВозможностьДетализацииПоГрузу(ИмяКнопки, ИмяТЧ)
	
	Если (не Элементы[ИмяТЧ].ТекущиеДанные.Груз
			= ПредопределенноеЗначение("Справочник.Грузы.СборнаяКонтейнернаяОтправка"))
			и (не Элементы[ИмяТЧ].ТекущиеДанные.Контейнер
				= ПредопределенноеЗначение("Справочник.ТЕ.ПустаяСсылка"))
				Тогда	
			
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Для детализации по грузу в строке значение груза должно быть ""Сборная контейнерная отправка"".");
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции
	
&НаКлиенте
Процедура ДетализацияПоГрузу(Команда)
	
	Если не ЕстьВозможностьДетализацииПоГрузу("КонтейнерыДетализацияПоГрузу", "Контейнеры") Тогда
		Возврат;
	КонецЕсли;	
	
	Элементы.КонтейнерыДетализацияПоГрузу.Пометка 
		= не Элементы.КонтейнерыДетализацияПоГрузу.Пометка;

	Элементы.ВагоныРефСцепаДетализацияПоГрузу.Пометка
		= не Элементы.КонтейнерыДетализацияПоГрузу.Пометка 
		и (Элементы.КонтейнерыДетализацияПоГрузу.Пометка = Истина);
		
	Элементы.ДетализацияПоГрузу.Видимость 
		= Элементы.КонтейнерыДетализацияПоГрузу.Пометка
		или Элементы.ВагоныРефСцепаДетализацияПоГрузу.Пометка;
		
	УстановитьОтборДетализацияПоГрузуПоТЧ("Контейнеры");
	
КонецПроцедуры

&НаКлиенте
Процедура ДетализацияПоГрузуВагоны(Команда)
	
	Если не ЕстьВозможностьДетализацииПоГрузу("ВагоныРефСцепаДетализацияПоГрузу", "ВагоныРефСцепа") Тогда
		Возврат;
	КонецЕсли;	
	
	Элементы.ВагоныРефСцепаДетализацияПоГрузу.Пометка
		= не Элементы.ВагоныРефСцепаДетализацияПоГрузу.Пометка;	
	
	Элементы.КонтейнерыДетализацияПоГрузу.Пометка 
		= не Элементы.ВагоныРефСцепаДетализацияПоГрузу.Пометка 
		и (Элементы.ВагоныРефСцепаДетализацияПоГрузу.Пометка = Истина);	

	Элементы.ДетализацияПоГрузу.Видимость 
		= Элементы.КонтейнерыДетализацияПоГрузу.Пометка
		или Элементы.ВагоныРефСцепаДетализацияПоГрузу.Пометка;
		
	УстановитьОтборДетализацияПоГрузуПоТЧ("ВагоныРефСцепа");

КонецПроцедуры

&НаКлиенте
Процедура ДетализацияПоГрузуПриИзменении(Элемент)
	Если Элементы.КонтейнерыДетализацияПоГрузу.Пометка Тогда
		ОбновитьДанныеПоДетализацииПоГрузу("Контейнеры");
	Иначе
		ОбновитьДанныеПоДетализацииПоГрузу("ВагоныРефСцепа");
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанныеПоДетализацииПоГрузу(ИмяТЧ)

	ТекущиеДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
	
		Возврат;
	
	КонецЕсли; 

	МассивСтрокДетализацииПоГрузу = ДетализацияПоГрузу.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки"
		, ТекущиеДанные.КлючАналитикиПеревозки) );
	ВсегоКол = 0; ВсегоВес = 0;
	Для каждого Стр Из МассивСтрокДетализацииПоГрузу Цикл
	
		ВсегоКол = ВсегоКол + Стр.КоличествоМест;
		ВсегоВес = ВсегоВес + Стр.ВесГруза;
		
	КонецЦикла; 
	
	Если ВсегоКол <> 0 Тогда
	
		ТекущиеДанные.КоличествоМестКонтейнера = ВсегоКол;
	
	КонецЕсли; 
	
	Если ВсегоВес <> 0 Тогда
	
		ТекущиеДанные.ВесКонтейнераНетто = ВсегоВес;
	
	КонецЕсли;
	//Субботин 78028 21.12.2023 убираем изменения ключей везде кроме проведения/записи
	//НайтиКлючАналитикиПеревозкиКлиент(ТекущиеДанные, ИмяТЧ);
	//Субботин 78028 21.12.2023
	УстановитьОтборДетализацияПоГрузу(ИмяТЧ);	
	
КонецПроцедуры 

&НаКлиенте
Процедура КонтейнерыПриАктивизацииСтроки(Элемент)
	// Евросиб(ДИТ) US 85028 ТА 87358 Сержантова А.С. Начало: 01.07.2024
	ТекСтрока = Элементы.Контейнеры.ТекущиеДанные;
	Если ТекСтрока = Неопределено или не ЗначениеЗаполнено(ТекСтрока.КлючАналитикиПеревозки) Тогда
		Возврат;
	КонецЕсли;
	// Евросиб(ДИТ) US 85028 ТА 87358 Сержантова А.С. Конец: 01.07.2024
	УстановитьОтборДетализацияПоГрузуПоТЧ("Контейнеры");
КонецПроцедуры 

&НаКлиенте
Процедура ВагоныРефСцепаПриАктивизацииСтроки(Элемент)     
	// Евросиб(ДИТ) US 85028 ТА 87358 Сержантова А.С. Начало: 01.07.2024
	ТекСтрока = Элементы.ВагоныРефСцепа.ТекущиеДанные;
	Если ТекСтрока = Неопределено или не ЗначениеЗаполнено(ТекСтрока.КлючАналитикиПеревозки) Тогда
		Возврат;
	КонецЕсли;
	// Евросиб(ДИТ) US 85028 ТА 87358 Сержантова А.С. Конец: 01.07.2024

	УстановитьОтборДетализацияПоГрузуПоТЧ("ВагоныРефСцепа"); 
	
	Для Каждого стр из Объект.ВагоныРефСцепа Цикл
		стр.ЭтоТекущаяСтрока = Ложь;
	КонецЦикла;
	
	Попытка
		Элементы.ВагоныРефСцепа.ТекущиеДанные.ЭтоТекущаяСтрока = Истина;
	Исключение
	КонецПопытки;	
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборДетализацияПоГрузуПоТЧ(ИмяТЧ)
	
	Если Элементы.КонтейнерыДетализацияПоГрузу.Пометка 
		и ИмяТЧ = "Контейнеры" Тогда
		УстановитьОтборДетализацияПоГрузу(ИмяТЧ);
	ИначеЕсли Элементы.ВагоныРефСцепаДетализацияПоГрузу.Пометка
		и ИмяТЧ = "ВагоныРефСцепа" Тогда
		УстановитьОтборДетализацияПоГрузу(ИмяТЧ);
	КонецЕсли;	

КонецПроцедуры	

&НаКлиенте
Процедура УстановитьОтборДетализацияПоГрузу(ИмяТЧ)
	
	Элементы.ДетализацияПоГрузу.ОтборСтрок 
		= Новый ФиксированнаяСтруктура("КлючАналитикиПеревозки"
		, Элементы[ИмяТЧ].ТекущиеДанные.КлючАналитикиПеревозки);

КонецПроцедуры	

&НаКлиенте
Процедура КонтейнерыГрузПриИзменении(Элемент)
	ПриИзмененииГруза("Контейнеры")
КонецПроцедуры

&НаКлиенте
Процедура ВагоныРефСцепаГрузПриИзменении(Элемент)
 	ПриИзмененииГруза("ВагоныРефСцепа");
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииГруза(ИмяТЧ)
	
	ТекущиеДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Груз) Тогда
		ТекущиеДанные.СостояниеКонтейнера = ПредопределенноеЗначение("Перечисление.СостоянияКТК.Груженый");
	Иначе
		ТекущиеДанные.СостояниеКонтейнера = ПредопределенноеЗначение("Перечисление.СостоянияКТК.Порожний");
	КонецЕсли;	     
	
	// Детализация по грузу
	Если ТекущиеДанные.Груз <> ПредопределенноеЗначение("Справочник.Грузы.СборнаяКонтейнернаяОтправка") Тогда
		Если ИмяТЧ = "ВагоныРефСцепа" Тогда
			Элементы.ВагоныРефСцепаДетализацияПоГрузу.Пометка = Ложь;	
			Элементы.ДетализацияПоГрузу.Видимость 			  = Ложь;
			//Субботин 78028 21.12.2023 убираем изменения ключей везде кроме проведения/записи
			//Субботин 76108 25.10.2023 начало заполняем ключ только в тч ВагоныРефСцепа
			//НайтиКлючАналитикиПеревозкиКлиент(ТекущиеДанные, ИмяТЧ);
			//Субботин 76108 25.10.2023 Конец
			//Субботин 78028 21.12.2023 конец
		Иначе
			Если значениеЗаполнено(ТекущиеДанные.КлючАналитикиПеревозки) тогда
			//Субботин 78028 21.12.2023 убираем изменения ключей везде кроме проведения/записи
			//	НайтиКлючАналитикиПеревозкиКлиент(ТекущиеДанные, ИмяТЧ)
			//Субботин 78028 21.12.2023 конец
			КонецЕсли;
			Элементы.КонтейнерыДетализацияПоГрузу.Пометка 	  = Ложь;	
			Элементы.ДетализацияПоГрузу.Видимость 			  = Ложь;
		КонецЕсли;
	КонецЕсли;
	//Субботин 76108 25.10.2023 начало убираем заполнения ключа при изменении груза в ТЧ контейнеры
	//НайтиКлючАналитикиПеревозкиКлиент(ТекущиеДанные, ИмяТЧ);
	//Субботин 76108 25.10.2023 Конец убираем закполнения ключа при изменении Ктк
КонецПроцедуры

