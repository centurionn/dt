&НаКлиенте
Процедура ПеренестиВДругойРефСцеп(Команда)
	
	ЕстьОтмеченные = Ложь;
	
	Для Сч = 0 По Объект.Контейнеры.Количество() - 1 Цикл
		Если Объект.Контейнеры[Сч].Отметка
			и не ЗначениеЗаполнено(Объект.Контейнеры[Сч].ПеренесенВРефСцеп)
			Тогда 
			
			ЕстьОтмеченные = Истина;	
			
		КонецЕсли;
	КонецЦикла;
	
	Если не ЕстьОтмеченные Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Отметьте контейнеры для переноса в другой реф.сцеп!",,"Отметка");
		Возврат;
	КонецЕсли;	
	
	СтандартнаяОбработка = Ложь;
	
	Настройки = Новый НастройкиКомпоновкиДанных;

	Элемент = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Элемент.Использование = Истина;
	Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
	Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	Элемент.ПравоеЗначение = Объект.Ссылка;
	Элемент.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный;

	Элемент = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Элемент.Использование = Истина;
	Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("РейсЗавершен");
	Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Элемент.ПравоеЗначение = Ложь;
	Элемент.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный;

	Элемент = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Элемент.Использование = Истина;
	Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПометкаУдаления");
	Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Элемент.ПравоеЗначение = Ложь;
	Элемент.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ФиксированныеНастройки", Настройки);
	
	ДополнительныеПараметры = Новый Структура;
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ПеренестиВДругойРефСцепЗавершение"
		, ЭтаФорма, ДополнительныеПараметры);
	
	ОткрытьФорму("Документ.РефСцеп.ФормаВыбора", ПараметрыФормы,
		,ЭтаФорма.УникальныйИдентификатор,,
		,ОписаниеОповещения
		,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПеренестиВДругойРефСцепЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если не ЗаписанДляОтложенногоПеренесенияВДругойРефСцеп(Результат, ДополнительныеПараметры) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Ошибка записи реф.сцепа для переноса!",,"ПеренесенВРефсцеп");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ЗаписанДляОтложенногоПеренесенияВДругойРефСцеп(Результат, ДополнительныеПараметры)
	
	Если ТипЗнч(Результат) <> Тип("ДокументСсылка.РефСцеп") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяТЧ = "Контейнеры";
	Для Сч = 0 По Объект[ИмяТЧ].Количество() - 1 Цикл
		Если Объект[ИмяТЧ][Сч].Отметка Тогда
			Объект[ИмяТЧ][Сч].ПеренесенВРефсцеп = Результат;
			Объект[ИмяТЧ][Сч].Отметка			= Ложь;
		КонецЕсли; 
	КонецЦикла;
	
	ЭтаФорма.Модифицированность = Истина;
	
	Возврат Истина;
	
КонецФункции

