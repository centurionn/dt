&НаСервере
Функция ПроверитьВыставленныеПоЗаявкамСчета()

	МассивСчетов = Новый Массив;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВагоныРефСцепа.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	ВагоныРефСцепа.Контейнер КАК Контейнер
		|ПОМЕСТИТЬ ВТ_Вагоны
		|ИЗ
		|	&ВагоныРефСцепа КАК ВагоныРефСцепа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Контейнеры.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	Контейнеры.Контейнер КАК Контейнер
		|ПОМЕСТИТЬ ВТ_Контейнеры
		|ИЗ
		|	&Контейнеры КАК Контейнеры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Вагоны.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	ВТ_Вагоны.Контейнер КАК Контейнер
		|ПОМЕСТИТЬ ВТ_ДанныеСФормы
		|ИЗ
		|	ВТ_Вагоны КАК ВТ_Вагоны
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТ_Контейнеры.КлючАналитикиПеревозки,
		|	ВТ_Контейнеры.Контейнер
		|ИЗ
		|	ВТ_Контейнеры КАК ВТ_Контейнеры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КлючиАналитикиПеревозки.Ссылка КАК Ссылка,
		|	КлючиАналитикиПеревозки.Контейнер КАК Контейнер,
		|	КлючиАналитикиПеревозки.Заявка КАК Заявка
		|ПОМЕСТИТЬ ВТ_ИзмененныеКонтейнеры
		|ИЗ
		|	ВТ_Вагоны КАК ВТ_ДанныеСФормы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки КАК КлючиАналитикиПеревозки
		|		ПО ВТ_ДанныеСФормы.КлючАналитикиПеревозки = КлючиАналитикиПеревозки.Ссылка
		|ГДЕ
		|	ВТ_ДанныеСФормы.Контейнер <> КлючиАналитикиПеревозки.Контейнер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ИзмененныеКонтейнеры.Ссылка КАК Ссылка
		|ИЗ
		|	ВТ_ИзмененныеКонтейнеры КАК ВТ_ИзмененныеКонтейнеры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СчетНаОплатуПокупателюДокументыОснования.Ссылка.Представление КАК ПредставлениеСчета,
		|	СчетНаОплатуПокупателюДокументыОснования.Ссылка КАК Ссылка
		|ИЗ
		|	ВТ_ИзмененныеКонтейнеры КАК ВТ_ИзмененныеКонтейнеры
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетНаОплатуПокупателю.ДокументыОснования КАК СчетНаОплатуПокупателюДокументыОснования
		|		ПО ВТ_ИзмененныеКонтейнеры.Заявка = СчетНаОплатуПокупателюДокументыОснования.Документ
		|ГДЕ
		|	НЕ СчетНаОплатуПокупателюДокументыОснования.Ссылка.ПометкаУдаления
		|	И СчетНаОплатуПокупателюДокументыОснования.Ссылка.Проведен";
	
	Запрос.УстановитьПараметр("ВагоныРефСцепа", Объект.ВагоныРефСцепа.Выгрузить(, "Контейнер, КЛючАналитикиПеревозки"));
	запрос.УстановитьПараметр("Контейнеры", Объект.Контейнеры.Выгрузить(, "Контейнер, КЛючАналитикиПеревозки"));
	
	Результат = Запрос.ВыполнитьПакет();   
	РезультатИзменениеКТК = Результат[4];
	Если РезультатИзменениеКТК.Пустой() Тогда
		Возврат МассивСчетов;
	КонецЕсли; 
	
	РезультатЗапроса = Результат[5];
	Если не РезультатЗапроса.Пустой() Тогда
		ВыборкаСчетов = РезультатЗапроса.Выбрать();
		Пока ВыборкаСчетов.Следующий() Цикл
			МассивСчетов.Добавить(ВыборкаСчетов.ПредставлениеСчета);
		КонецЦикла;
	КонецЕсли;

	Возврат МассивСчетов;
КонецФункции 

