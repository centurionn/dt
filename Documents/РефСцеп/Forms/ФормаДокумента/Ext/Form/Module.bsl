&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//Евросиб Коханенко Н.А. #61705 20.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 20.12.2022 )
	
	КонтрольДоступностиДокументов_сервер.ОбработатьБлокировкуЭлементовФормы(Объект.Ссылка, Элементы);
	
	// Обновляем панель текущего пользователя и панель состояний
	ОбновитьПанельТекущегоПользователя();
	ОбновитьПанельСостояний();
	// - Состояния            
	
	ЦветТекста_Исходный   = WebЦвета.Черный;
	ЦветТекста_Выделенный = WebЦвета.Красный;
    ЦветТекста_Кнопки     = ЦветаСтиля.ЦветТекстаКнопки; 
	
	//Субботин 71114 начало 06.09.2023 переделал алгоритм
	//ЗаполнитьСписокПолейЗаполнятьВниз();
	//Субботин 71114 Конец 06.09.2023 переделал алгоритм

	Если Параметры.Ключ.Пустая() Тогда
		ОбновитьДанныеФормыПоВагонам();	
	КонецЕсли;	
	
	// Управляем видимостью полей Передислокации
	ВидимостьПередислокаций = РеквизитЗаполненВОднойИзСтрокВагонаИлиВсейТЧ(, 
		"ПотребовалсяПодсылПорожнегоВагона"); 
	
	ОпределитьАктуальныеДатыИСтанции();
	
	УстановитьДоступностьЭлементовФормыНаСервере();
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.ИндексПоезда = ПолучитьИндексПоезда();
	КонецЕсли;
	ПоследнийЗаполненныйРейс = Объект.Рейс; 
	
	//Субботин 78646 13.12.2023 Начало	
	ЗаполнитьПризнакЭксплуатации()
	//Субботин 78646 13.12.2023 Конец 	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	//ОбновитьВидимостьПредупрежденияБлокировки();
	
	//ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	
	УстановитьГруппировкуПоВагонамЦветомТекста();
	
	Элементы.ПредупреждениеРедактирования.Видимость = ПроверитьУсловияРейсЗавершен(); 
	Элементы.ПредупреждениеРедактирования.Заголовок 
		= "Реф.сцеп расформирован. Дальнейшая работа с документом невозможна. При наличии контейнеров перенесите их в другой реф.сцеп.";
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если не Параметры.Ключ.Пустая() Тогда
		ОбновитьДанныеФормыПоВагонам();	
	КонецЕсли;	
	
	ПроверитьПревышениеКонтейнеровВВагонеПоТЭУ();	
	
	ПодсвечиваниеПолейОбъектов.НастроитьПодсвечиваниеПолей(ТекущийОбъект, ИмяФормы, ЭтаФорма, УсловноеОформление);	

	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	
	Если не Объект.ЕстьСделкаЗаявкиПоРефСцепу Тогда
		
		тзЗаявок = РефСцепСервер.ПолучитьЗаявкиПоКлючамАналитикиРефСцепа(ВсеКлючиАналитикиПеревозкиРефСцепа(), Объект.Ссылка).Выгрузить();
		тзЗаявок.Свернуть("Заявка");
		
		Объект.ЕстьСделкаЗаявкиПоРефСцепу 
			= РефСцепСервер.ПроверитьЕстьЛиПроведеннаяСделкаЗаявокПоРефсцепу(тзЗаявок.ВыгрузитьКолонку("Заявка"));
		
	КонецЕсли;
                    
	Объект.ВагоныРефСцепа.Загрузить(РефСцепСервер.ПолучитьТЧВагоныСПодсыламиЖДН(
		ПолучитьтзДанныеДокументаВагоныДляЖДНПодсыла(), Объект.ВагоныРефСцепа.Выгрузить(), Объект.Ссылка)
		.ТаблицаДоИзменений);
		
	ОбновитьДанныеКлючаНаФормеСервер();
	ДетализацияПоГрузуИзКлючей();
	
    ВерсияКлючаТЧ("ВагоныРефСцепа");
    ВерсияКлючаТЧ("Контейнеры");
	
	Если ПроверитьУсловияРейсЗавершен() Тогда
		Объект.РейсЗавершен = Истина;
	КонецЕсли;
	
	//Субботин 78646 13.12.2023 Начало	
	ЗаполнитьПризнакЭксплуатации()
	//Субботин 78646 13.12.2023 Конец 
	
КонецПроцедуры

&НаСервере
