КонецПроцедуры	


&НаКлиенте
Функция ПолучитьМассивКонтейнеровДляЗаявки(ИмяТЧ, МассивКонтейнеров)
	
	Для Сч = 0 По Объект[ИмяТЧ].Количество() - 1 Цикл
		Если не Объект[ИмяТЧ][Сч].Отметка Тогда Продолжить; КонецЕсли;
		Если ИмяТЧ = "ВагоныРефСцепа" Тогда
			Если (Объект[ИмяТЧ][Сч].ЭтоКонтейнерСДГК или Объект[ИмяТЧ][Сч].ЭтоТанкКонтейнер) Тогда Продолжить; КонецЕсли;		
		КонецЕсли;	
		МассивКонтейнеров.Добавить(Объект[ИмяТЧ][Сч].Контейнер);
	КонецЦикла;
	
	Если ИмяТЧ = "ВагоныРефСцепа" Тогда
		Возврат ПолучитьМассивКонтейнеровДляЗаявки("Контейнеры", МассивКонтейнеров); 
	КонецЕсли;	
	
	Возврат МассивКонтейнеров;
	
КонецФункции

&НаКлиенте
Функция ОшибкаПроверкиДанныхПередСозданиемЗаявки(ЭтоКонтенерСДГК = Ложь)
	
	Если не ЭтоКонтенерСДГК Тогда
		Если не (ЕстьПометкаКлиент("Контейнеры") или ЕстьПометкаКлиент("ВагоныРефСцепа")) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				"Перед формированием заявки отметьте строки верхей или нижней таблиц.");
			Возврат Истина;	
		КонецЕсли;	
	КонецЕсли;	

	Возврат ЕстьНезаполненноеПоле("Контейнеры", "Контейнер") или ЕстьНезаполненноеПоле("ВагоныРефСцепа", "Контейнер")
	    или ЕстьНезаполненноеПоле("Контейнеры", "Клиент") или ЕстьНезаполненноеПоле("ВагоныРефСцепа", "Клиент")
		или ЕстьРазныеКлиенты("ВагоныРефСцепа", ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка"))
		или ЕстьОтмеченныеСЗаявками("Контейнеры") или ЕстьОтмеченныеСЗаявками("ВагоныРефСцепа");
	
КонецФункции

&НаКлиенте
Функция ЕстьНезаполненноеПоле(ИмяТЧ, ИмяПоля)
	ошибка = Ложь;
	Для Сч = 0 По Объект[ИмяТЧ].Количество() - 1 Цикл
		Если (не ЗначениеЗаполнено(Объект[ИмяТЧ][Сч][ИмяПоля]))
			и Объект[ИмяТЧ][Сч].Отметка Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				"В строке №" + Объект[ИмяТЧ][Сч].НомерСтроки + " таблицы " +
				?(ИмяТЧ = "ВагоныРефСцепа","Верхней таблицы", "Нижней таблицы")
				+" не заполнен " + ИмяПоля,,ИмяПоля );
			ошибка = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат ошибка;
КонецФункции

&НаКлиенте
Функция ЕстьРазныеКлиенты(ИмяТЧ, КонтрольныйКлиент)
	
	Для Сч = 0 По Объект[ИмяТЧ].Количество() - 1 Цикл
		
		Если не Объект[ИмяТЧ][Сч].Отметка Тогда Продолжить; КонецЕсли;
		
		Если КонтрольныйКлиент = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка") Тогда
			КонтрольныйКлиент = Объект[ИмяТЧ][Сч].Клиент;
		КонецЕсли;	
		
		Если КонтрольныйКлиент <> ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка")
			и КонтрольныйКлиент <> Объект[ИмяТЧ][Сч].Клиент Тогда

			ОбщегоНазначенияКлиент.СообщитьПользователю(
				"В строке №" + Объект[ИмяТЧ][Сч].НомерСтроки + " таблицы " +
				?(ИмяТЧ = "ВагоныРефСцепа","Верхней таблицы", "Нижней таблицы")
				+" не совпадает клиент. В отмеченных строках должно быть не более одного наименования клиента для создания заявки ");
			
			Возврат Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ИмяТЧ = "ВагоныРефСцепа" Тогда
		Возврат ЕстьРазныеКлиенты("Контейнеры", КонтрольныйКлиент); 
	КонецЕсли;	
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция ЕстьОтмеченныеСЗаявками(ИмяТЧ)
	ошибка = Ложь;
	Для Сч = 0 По Объект[ИмяТЧ].Количество() - 1 Цикл
		Если (ЗначениеЗаполнено(Объект[ИмяТЧ][Сч].Заявка))
			и Объект[ИмяТЧ][Сч].Отметка Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				"В строке №" + Объект[ИмяТЧ][Сч].НомерСтроки + " таблицы " +
				?(ИмяТЧ = "ВагоныРефСцепа","Верхней таблицы", "Нижней таблицы")
				+ " Контейнер " +  Объект[ИмяТЧ][Сч].Контейнер + " уже добавлен в заявку " 
				+ ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(Объект[ИмяТЧ][Сч].Заявка,"Номер"));
			ошибка = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат ошибка;
КонецФункции

&НаКлиенте
Процедура ДобавитьВЗаявку(Команда)

	Если не объект.Проведен Тогда 
		ОбщегоНазначенияКлиент.СообщитьПОльзователю("Добавление в заявку возможно только для проведенного документа.");
		Возврат;
	КонецЕсли;	
	
	Если ЭтаФорма.Модифицированность Тогда 
		ОписаниеОповещения = Новый ОписаниеОповещения("ДобавлениеЗаявкиПодтверждено", ЭтаФорма);
		ПоказатьВопрос(ОписаниеОповещения, "Для продолжения добавления заявки требуется записать данные. Записать данные?"
			, РежимДиалогаВопрос.ДаНет);
	Иначе 
		ДобавлениеЗаявкиПродолжение();
	КонецЕсли;	
КонецПроцедуры 

&НаКлиенте
Процедура ДобавлениеЗаявкиПодтверждено(ОтветПользователя = неопределено, ДопПараметры = неопределено) Экспорт 
	
	Если ОтветПользователя <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;

	//Субботин 76108 25.10.2023 начало// переносим запись дока после создания ключенй аналитики запись 
	//Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
	//Субботин 76108 25.10.2023 Конец

	ДобавлениеЗаявкиПродолжение();

КонецПроцедуры
	
&НаКлиенте
Процедура ДобавлениеЗаявкиПродолжение() 
	
	//Субботин 76108 25.10.2023 начало// формируем ключи аналитики  перевозки для ктк при формировании заявки
	 //Субботин 77659 25.01.2024 Начало убрал т.к выполняется при записи
	//Для каждого строка из Объект.Контейнеры цикл
	//	НайтиКлючАналитикиПеревозкиКлиент(строка, "Контейнеры")
	//КонецЦикла;
	 //Субботин 77659 25.01.2024 Конец
	Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
	//Субботин 76108 25.10.2023 Конец
	
	Если ОшибкаПроверкиДанныхПередСозданиемЗаявки() Тогда
		Возврат;
	КонецЕсли;	

	МассивКонтейнеров = ПолучитьМассивКонтейнеровДляЗаявки("ВагоныРефСцепа", Новый Массив());
	
	СтандартнаяОбработка = Ложь;
	
	МассивЗаявокДляДобавления = ПолучитьСписокЗаявокДляДобавленияКонтейнеровНасЕрвере();
	
	Если не МассивЗаявокДляДобавления.Количество() > 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю
			("Нет заявок, соответствующих условиям данного реф.сцепа. Попробуйте создать заявки");
		Возврат;
	КонецЕсли;
	
	СписокЗаявокДляДобавления = Новый СписокЗначений;
	СписокЗаявокДляДобавления.ЗагрузитьЗначения(МассивЗаявокДляДобавления);
	
	Настройки = Новый НастройкиКомпоновкиДанных;

	Элемент = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Элемент.Использование     = Истина;
	Элемент.ЛевоеЗначение     = Новый ПолеКомпоновкиДанных("Ссылка");
	Элемент.ВидСравнения      = ВидСравненияКомпоновкиДанных.ВСписке;
	Элемент.ПравоеЗначение    = СписокЗаявокДляДобавления;
	Элемент.РежимОтображения  = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ФиксированныеНастройки", Настройки);
	ПараметрыФормы.Вставить("ЭтоДобавлениеКТКРефСцепаВЗаявку",Истина);
	
	ДополнительныеПараметры = Новый Структура("МассивКонтейнеров", МассивКонтейнеров);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ДобавитьВЗаявкуПриВыбореЗавершение"
		, ЭтаФорма, ДополнительныеПараметры);
	
	ОткрытьФорму("Документ.Заявка.Форма.ФормаВыбора", ПараметрыФормы,
		, ЭтаФорма.УникальныйИдентификатор, ,
		, ОписаниеОповещения
		, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаСервере
Функция ПолучитьСписокЗаявокДляДобавленияКонтейнеровНасЕрвере()
	
	Возврат РефСцепСервер.ПолучитьСписокЗаявокДляДобавленияКонтейнеров(
		РефСцепСервер.ПолучитьДанныеРефСцепаДляОтбораЗаявок(Объект)).СписокЗаявок;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьВЗаявкуПриВыбореЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("ДокументСсылка.Заявка") Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю
			("Не выбрана заявка, соответствущая условиям данного реф.сцепа. Действие завершено.");
		Возврат ; 
	КонецЕсли;	
	
	ПараметрыФормы = Новый Структура("Ключ,
		| Основание,
		| ЭтоДобавлениеВЗаявкуИзРефСцепа,
		| МассивКонтейнеров"
		, Результат
		, Объект.Ссылка
		, Истина
		, ДополнительныеПараметры.МассивКонтейнеров);

		
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ДобавитьВЗаявкуЗавершение"
		, ЭтаФорма, ДополнительныеПараметры);
	
	ОткрытьФорму("Документ.Заявка.Форма.ФормаДокумента", ПараметрыФормы,
		, ЭтаФорма.УникальныйИдентификатор, ,
		, ОписаниеОповещения
		, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры	

&НаКлиенте
Процедура ДобавитьВЗаявкуЗавершение(Результат, ДополнительныеПараметры) Экспорт

	ЗаполнитьЗаявкиПоРефСцепу();
	
КонецПроцедуры	

