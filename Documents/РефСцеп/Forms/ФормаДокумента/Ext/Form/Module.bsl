&НаКлиенте
Процедура УдалитьСтрокиКонтейнеров(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("УдалениеПодтверждено", ЭтаФорма);
	ПоказатьВопрос(ОписаниеОповещения, "Вы действительно хотите удалить выбранные строки?", РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура УдалениеПодтверждено(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;
	
	УдаляемыеСтроки = Новый Массив;
	
	Для каждого Стр из Объект.Контейнеры Цикл
		Если Стр.Отметка Тогда
			Если ЗначениеЗаполнено(Стр.Заявка) Тогда
				ОбщегоНазначенияКлиент.СообщитьПОльзователю("В строке №" 
					+ Стр.НомерСтроки + " удаление невозможно. Контейнер удаляемой строки входит в заявку " 
					+ ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(Стр.Заявка, "Номер")
					+". Удалите контейнер из заявки, либо перенесите его в другой Реф. сцеп.");
				Продолжить;
			КонецЕсли;	
			УдаляемыеСтроки.Добавить(Стр);
			//Евросиб Коханенко Н.А. 10.10.2024 (( #90312
			СтрокаКлюча = ТаблицаУдаляемыхКлючей.Добавить();
			СтрокаКлюча.КлючАналитикиПеревозки = Стр.КлючАналитикиПеревозки;
			//Евросиб Коханенко Н.А. 10.10.2024 )) #90312 
		КонецЕсли;	
	КонецЦикла; 
	
	Для каждого Стр2 из УдаляемыеСтроки Цикл
		Объект.Контейнеры.Удалить(Стр2);             
	КонецЦикла;
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура СвязатьСВагономНаСервере(ВагонДляСвязи)
	
	// Добавляем контейнеры к вагонам
	
	МассивКонтейнеровДляСвязи 	  = Новый Массив;
	
	Для каждого Стр из Объект.Контейнеры Цикл
		Если Стр.Отметка Тогда
			МассивКонтейнеровДляСвязи.Добавить(Стр.Контейнер);
		КонецЕсли;	
	КонецЦикла;

	Если МассивКонтейнеровДляСвязи.Количество() = 0 Тогда 
		
		ОбщегоНазначения.СообщитьПользователю("Отметьте контейнеры для связи с вагонами!",,"Отметка");
		
		Возврат;
		
	КонецЕсли;	
	
	тзКонтейнеры 			  = Объект.Контейнеры.Выгрузить(); 
	тзВагоны	 			  = Объект.ВагоныРефСцепа.Выгрузить(); 
	ИсходнаяСтрокаВагона      = тзВагоны.Найти(ВагонДляСвязи,"Вагон");
	Для каждого Стр из тзКонтейнеры Цикл
		Если Стр.Отметка Тогда
			НоваяСтрока = тзВагоны.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ИсходнаяСтрокаВагона,,"ЭтоКонтейнерСДГК, ЭтоТанкКонтейнер, КлючАналитикиПеревозки");
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
			НоваяСтрока.Вагон = ВагонДляСвязи;
		КонецЕсли;	
	КонецЦикла;
	
	// Удалим пустую строку без контейнера
	Отбор = Новый Структура("Вагон, Контейнер", ВагонДляСвязи, Справочники.ТЕ.ПустаяСсылка()); 
	ПустыеСтроки = тзВагоны.НайтиСтроки(Отбор);
	Для Каждого Стр из ПустыеСтроки Цикл
		тзВагоны.Удалить(Стр);
	КонецЦикла;	
	
	тзВагоны.Сортировать("ПорядковыйНомерВСцепе, НомерСтроки");
	
	Объект.ВагоныРефСцепа.Загрузить(тзВагоны);

	// Удаляем уже связанные строки из ТЧ Контейнеры
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ *
		|ПОМЕСТИТЬ вт_Контейнеры
		|ИЗ
		|	&Контейнеры КАК РефСцепКонтейнеры
		|ГДЕ
		|	не РефСцепКонтейнеры.Контейнер В(&МассивКонтейнеровДляСвязи)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ *
		|ИЗ
		|	вт_Контейнеры КАК вт_Контейнеры";
	
	Запрос.УстановитьПараметр("Контейнеры", Объект.Контейнеры.Выгрузить());
	Запрос.УстановитьПараметр("МассивКонтейнеровДляСвязи", МассивКонтейнеровДляСвязи);
	
	Объект.Контейнеры.Загрузить(Запрос.Выполнить().Выгрузить()); 

	ПроверитьПревышениеКонтейнеровВВагонеПоТЭУ();
	
КонецПроцедуры

// 1.6
&НаСервере
Процедура ПроверитьПревышениеКонтейнеровВВагонеПоТЭУ()
	
	тзВагоны = Объект.ВагоныРефСцепа.Выгрузить();
	тзВагоны.ЗаполнитьЗначения(Истина, "НетПревышенияПоТЭУ");
	Объект.ВагоныРефСцепа.Загрузить(тзВагоны);
	
	ВыборкаПревышеныПоТЭУ = РефСцепСервер.ПолучитьДанныеПревышенияПоТЕУ(Объект.ВагоныРефСцепа.Выгрузить());
	
	Пока ВыборкаПревышеныПоТЭУ.Следующий() Цикл
		
		Если ВыборкаПревышеныПоТЭУ.ВагонРазмерВТЕУ = 0 Тогда

			ОбщегоНазначения.СообщитьПользователю("Для вагона " + 
				ВыборкаПревышеныПоТЭУ.ПредставлениеВагона + " не задан или ошибочный типоразмер.
				|Проверка на превышение для вагона в ТЕУ отменена.");
				
			Продолжить;	
			
		КонецЕсли;	
		
		мСтрокПревышенияПоТЭУ = Объект.ВагоныРефСцепа.НайтиСтроки(Новый Структура("Вагон", ВыборкаПревышеныПоТЭУ.Вагон));
		
		Для Каждого стр из мСтрокПревышенияПоТЭУ Цикл
			
			Стр.НетПревышенияПоТЭУ = Ложь;
			
		КонецЦикла;	
		
	КонецЦикла;
	
КонецПроцедуры	

&НаКлиенте
Процедура СвязатьСВагоном(Команда)

	СписокВагоновРефСцепа = Новый СписокЗначений;
	
	Для Каждого стр из Объект.ВагоныРефСцепа Цикл
		Если СписокВагоновРефСцепа.НайтиПоЗначению(стр.Вагон) = Неопределено
			и Стр.ЕстьВагонВРегистреНаФорме Тогда
			СписокВагоновРефСцепа.Добавить(стр.Вагон);
		КонецЕсли;	
	КонецЦикла;
	
	ОповещениеПослеВыбораЭлемента = Новый ОписаниеОповещения(
	    "СвязатьКонтейнерыСВагономЗавершение", ЭтотОбъект);

	СписокВагоновРефСцепа.ПоказатьВыборЭлемента(
	    ОповещениеПослеВыбораЭлемента,
	    "Выберите вагон для связи с контейнерами");
		
КонецПроцедуры

&НаКлиенте
Процедура СвязатьКонтейнерыСВагономЗавершение(Элемент, Параметры) Экспорт
	
	Если Элемент <> Неопределено Тогда

		ВагонДляСвязи = Элемент.Значение;

		СвязатьСВагономНаСервере(ВагонДляСвязи);
		
		УстановитьГруппировкуПоВагонамЦветомТекста();
		
		ОчиститьПометкиБезОрганичений();
		
		ЭтаФорма.Модифицированность = Истина;
		
	КонецЕсли;

КонецПроцедуры 

&НаСервере
Процедура ОбновитьДанныеФормыПоВагонам()
	//Субботин 71114 08.09.2023 начало
	//ЭтоОбновлениеДанныхИзРегистра = Ложь;
	//Субботин 71114 08.09.2023 начало 
	ЭтоОбновлениеДанныхИзРегистра = Истина;
	//Субботин 77510 21.11.2023 начало// не актуализируем информацию у уже завершенных рейсов
	Если Объект.РейсЗавершен Тогда 
		ЭтоОбновлениеДанныхИзРегистра = Ложь;	
	КонецЕсли;
	//Субботин 77510 21.11.2023 Конец 
	
	Объект.ВагоныРефСцепа.Загрузить(РефСцепСервер
	.ПолучитьДанныеФормыРегистраБазыДокумента(
	Объект.ВагоныРефСцепа.Выгрузить()
	, Объект.РефСцеп
	, ЭтоОбновлениеДанныхИзРегистра
	, Объект.Ссылка));
		
	ПроверитьПревышениеКонтейнеровВВагонеПоТЭУ();

	ЗаполнитьЗаявкиПоРефСцепу();
	
КонецПроцедуры               

&НаСервере
Функция ВсеКлючиАналитикиПеревозкиРефСцепа()
	
	МассивКлючейАаналитикиПеревозки = Объект.ВагоныРефСцепа.Выгрузить(, "КлючАналитикиПеревозки")
		.ВыгрузитьКолонку("КлючАналитикиПеревозки");
		
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивКлючейАаналитикиПеревозки
		, Объект.Контейнеры.Выгрузить(, "КлючАналитикиПеревозки").ВыгрузитьКолонку("КлючАналитикиПеревозки") 
		, Истина);
	 
	Возврат МассивКлючейАаналитикиПеревозки; 
		
КонецФункции                     

&НаСервере
Процедура ОтвязатьКонтейнерыОтВагоновНаСервере(Программно = Ложь) 

	тзВагоны	 			  		= Объект.ВагоныРефСцепа.Выгрузить(); 
	МассивКонтейнеровДляОтменыСвязи = Новый Массив;
	Для каждого Стр из Объект.ВагоныРефСцепа Цикл
		Если Стр.Отметка и ЗначениеЗаполнено(Стр.Контейнер) Тогда
			МассивКонтейнеровДляОтменыСвязи.Добавить(Стр.Контейнер);
		КонецЕсли;	
	КонецЦикла;

	Если МассивКонтейнеровДляОтменыСвязи.Количество() = 0 и не Программно Тогда 
		Сообщить("Отметьте контейнеры для отмены связи с вагонами!");
		Возврат;
	КонецЕсли;	
	
	тзКонтейнеры = Объект.Контейнеры.Выгрузить(); 
	Для каждого Стр из тзВагоны Цикл
		Если Стр.Отметка и не (Стр.ЭтоКонтейнерСДГК или Стр.ЭтоТанкКонтейнер) Тогда
			НоваяСтрока = тзКонтейнеры.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		КонецЕсли;	
	КонецЦикла;
	
	Объект.Контейнеры.Загрузить(тзКонтейнеры);

	// Удаляем уже отвязанные строки из ТЧ Вагоны и контейнеры
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ *
		|ПОМЕСТИТЬ вт_Вагоны
		|ИЗ
		|	&Вагоны КАК РефСцепВагоны
		|ГДЕ
		|	не РефСцепВагоны.Контейнер В(&МассивКонтейнеровДляОтменыСвязи)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ *
		|ИЗ
		|	вт_Вагоны КАК вт_Вагоны";
		
	тзВагоныПервоначальная = Объект.ВагоныРефСцепа.Выгрузить();
	Запрос.УстановитьПараметр("Вагоны", Объект.ВагоныРефСцепа.Выгрузить());
	Запрос.УстановитьПараметр("МассивКонтейнеровДляОтменыСвязи", МассивКонтейнеровДляОтменыСвязи);
	тзБезОтмеченныхКонтейнеров = Запрос.Выполнить().Выгрузить();

	// при отсутствии контейнеров в вагоне оставляем вагон без контейнера
	
	Для каждого стр из тзВагоныПервоначальная Цикл
		
		Если тзБезОтмеченныхКонтейнеров.НайтиСтроки(Новый Структура("Вагон", Стр.Вагон)).Количество() = 0 Тогда
			
			ЗаполнитьЗначенияСвойств(тзБезОтмеченныхКонтейнеров.Добавить(),
				Стр,,"Контейнер, 
				|ПринадлежностьКонтейнера,
				|СостояниеКонтейнера,
				|Груз,
				|Ответственный,
				|ВесКонтейнераБрутто,
				|ВесКонтейнераНетто,
				|КоличествоМестКонтейнера,
				|Клиент, 
				|Заявка, 
				|ПеренесенВРефСцеп, 
				|ДопИнформация, 
				//Субботин 76108 25.10.2023 начало
				|КлючАналитикиПеревозки");
				//Субботин 76108 25.10.2023 Конец

		КонецЕсли;

	КонецЦикла;
	
	тзБезОтмеченныхКонтейнеров.Сортировать("ПорядковыйНомерВСцепе, НомерСтроки");

	Объект.ВагоныРефСцепа.Загрузить(тзБезОтмеченныхКонтейнеров);
	
	ПроверитьПревышениеКонтейнеровВВагонеПоТЭУ();	

КонецПроцедуры

