&НаКлиенте
Процедура ЗаполнитьПринадлежность(ИмяТЧ)
	
	ТекущиеДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	
	Если не ЗначениеЗаполнено(ТекущиеДанные.ПринадлежностьКонтейнера) и ЗначениеЗаполнено(ТекущиеДанные.Контейнер) Тогда
	
		ТекущиеДанные.ПринадлежностьКонтейнера = ПолучитьПринадлежностьНаСервере(ТекущиеДанные.Контейнер);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПринадлежностьНаСервере(Контейнер)
	
	Если Константы.ИспользоватьАРМКТК.Получить() = Истина Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	стоки_ТекущиеДанныеСрезПоследних.тек_ВидСобственности КАК тек_ВидСобственности,
		|	стоки_ТекущиеДанныеСрезПоследних.тек_ВЭксплуатации КАК тек_ВЭксплуатации
		|ИЗ
		|	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних(, КТК = &КТК) КАК стоки_ТекущиеДанныеСрезПоследних";
		Запрос.УстановитьПараметр("КТК", Контейнер);
		Ответ = Запрос.Выполнить().Выбрать();
		Если Ответ.Следующий() Тогда
			//Субботин 78646 12.12.2023 начало переделал на возврат структуры т.к требуется проставлять блокировку по значению признака "В эксплуатации"
			//+ по фт поменял возврат местами, ктк клиента при клиентском, остальные варианты = евросиб
			Если Ответ.тек_ВидСобственности = Перечисления.ВариантыСобственности.Клиентский Тогда
				Возврат Новый Структура("ПризнакЭксплуатации, Принадлежность", Ответ.тек_ВЭксплуатации, Перечисления.ПринадлежностьТЕ.КТКлиента);
			Иначе	
				Возврат Новый Структура("ПризнакЭксплуатации, Принадлежность", Ответ.тек_ВЭксплуатации, Перечисления.ПринадлежностьТЕ.КТЕвросиба);
			КонецЕсли;
		КонецЕсли;
	Иначе
			
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Контейнер", Контейнер);
		Запрос.УстановитьПараметр("ПериодСегодня", ТекущаяДата());
		Запрос.Текст = "ВЫБРАТЬ
		               |	ПризнакСобственностиВагонаСрезПоследних.ПризнакСобственности КАК ПризнакСобственности,
		               |	ПризнакСобственностиВагонаСрезПоследних.ВЭксплуатации КАК ВЭксплуатации
		               |ИЗ
		               |	РегистрСведений.КонтейнерыНаСлежении.СрезПоследних(&ПериодСегодня, Контейнер = &Контейнер) КАК ВагоныНаСлеженииСрезПоследних
		               |		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакСобственностиКонтейнера.СрезПоследних(&ПериодСегодня, Контейнер = &Контейнер) КАК ПризнакСобственностиВагонаСрезПоследних
		               |		ПО ВагоныНаСлеженииСрезПоследних.Контейнер = ПризнакСобственностиВагонаСрезПоследних.Контейнер";

		Ответ = Запрос.Выполнить().Выбрать();

		Если Ответ.Следующий() Тогда
			Если Ответ.ПризнакСобственности = Перечисления.ВариантыСобственности.Собственный Тогда
				Возврат Новый Структура("ПризнакЭксплуатации, Принадлежность", Ответ.тек_ВЭксплуатации, Перечисления.ПринадлежностьТЕ.КТЕвросиба);
			Иначе	
