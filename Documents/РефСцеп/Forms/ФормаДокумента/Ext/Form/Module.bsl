&НаСервере
Процедура ПроверитьАктуальностьКлючаАналитики()   
	НужноОбновлениеКлюча = Ложь;
	Для каждого СтрокаТЧ Из Объект.ВагоныРефСцепа Цикл
		АктуальнаяВерсия = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.КлючАналитикиПеревозки, "ВерсияДанных");
		Если СтрокаТЧ.ВерсияКлюча <> АктуальнаяВерсия Тогда
			НужноОбновлениеКлюча = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Для каждого СтрокаТЧ Из Объект.Контейнеры Цикл
		АктуальнаяВерсия = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.КлючАналитикиПеревозки, "ВерсияДанных");
		Если СтрокаТЧ.ВерсияКлюча <> АктуальнаяВерсия Тогда
			НужноОбновлениеКлюча = Истина;
		КонецЕсли;
	КонецЦикла;	
	
	Если НужноОбновлениеКлюча Тогда  
		ОбновитьДанныеКлючаНаФормеСервер();
		ОбщегоНазначения.СообщитьПользователю("Версия ключа аналитики перевозки устарела, подгружены актуальные данные");
	КонецЕсли; 
КонецПроцедуры
