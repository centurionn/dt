&НаКлиенте
Процедура УстановитьГруппировкуПоВагонамЦветомТекста()
	
	Вагон = ПредопределенноеЗначение("Справочник.ТС.ПустаяСсылка"); 
	
	Для Сч = 0 По Объект.ВагоныРефСцепа.Количество() - 1 Цикл
		
		ВходитВОтбор = Элементы.ВагоныРефСцепа.ПроверитьСтроку
			(Объект.ВагоныРефСцепа[Сч].ПолучитьИдентификатор());
			
		//Евросиб Коханенко Н.А. 07.10.2024 (( #90312
		//переменная ВходитВОтбор может принимать значение Неопределено
		//Если ВходитВОтбор Тогда
		Если ВходитВОтбор = Истина Тогда
		//Евросиб Коханенко Н.А. 07.10.2024 )) #90312
			Если Объект.ВагоныРефСцепа[Сч].Вагон = Вагон Тогда
				Объект.ВагоныРефСцепа[Сч].НеПерваяСтрокаВагонаДляГруппировки = Истина;
			Иначе
				Объект.ВагоныРефСцепа[Сч].НеПерваяСтрокаВагонаДляГруппировки = Ложь;
			КонецЕсли;
			Вагон = Объект.ВагоныРефСцепа[Сч].Вагон;			
		Иначе 
			Объект.ВагоныРефСцепа[Сч].НеПерваяСтрокаВагонаДляГруппировки = Ложь;
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВагоныРефСцепаПослеУдаления(Элемент)
	УстановитьГруппировкуПоВагонамЦветомТекста();
КонецПроцедуры
