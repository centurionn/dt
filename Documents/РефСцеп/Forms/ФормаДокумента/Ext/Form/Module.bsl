	ОбновитьДанныеКлючаНаФормеСервер(); 
	
	//Евросиб Коханенко Н.А. 16.09.2024 (( #90312
	ТаблицаКлючей = РеквизитФормыВЗначение("ТаблицаУдаляемыхКлючей");
	Для каждого Ключ из ТаблицаКлючей Цикл
		УдалитьСсылкуНаРефИзКлючаАналитики(Ключ.КлючАналитикиПеревозки);
	КонецЦикла; 
	//Евросиб Коханенко Н.А. 16.09.2024 )) #90312

КонецПроцедуры

