// ++ Дудоров С.В. 13.12.2022 №57543
&НаСервере
Функция ПолучитьИндексПоезда()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РефСцепВагоныРефСцепа.ИндексПоезда КАК ИндексПоезда
		|ПОМЕСТИТЬ вт_Вагоны
		|ИЗ
		|	&ТЧВагоны КАК РефСцепВагоныРефСцепа
		|ГДЕ
		|	РефСцепВагоныРефСцепа.ЭтоКонтейнерСДГК = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_Вагоны.ИндексПоезда КАК ИндексПоезда
		|ИЗ
		|	вт_Вагоны КАК вт_Вагоны";
	
	Запрос.УстановитьПараметр("ТЧВагоны",Объект.ВагоныРефСцепа.Выгрузить(,"ЭтоКонтейнерСДГК, ИндексПоезда"));
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.ИндексПоезда;
	КонецЦикла;

	Возврат "";	

КонецФункции

&НаКлиенте
Процедура СтанцияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	РефСцепКлиент.ОткрытьВыборЛокацийСЖДСтанциями(Элемент, ДанныеВыбора, СтандартнаяОбработка);
КонецПроцедуры

#Область ФактическиеДаты

&НаСервере
Процедура ОпределитьАктуальныеДатыИСтанции()
	
	Если ЗначениеЗаполнено(Объект.Рейс) Тогда
		ВсеЖДН = РефСцепСервер.ПолучитьЖДНСделкиПоРейсу(Объект.Рейс);
		Объект.ПланируемоеОтправление = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Рейс, "ДатаОтправления");
		Объект.ПланируемоеПрибытие    = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Рейс, "ДатаПрибытия");
		Объект.СтанцияОтправления	  = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Рейс, "ПунктОтправления");
		Объект.СтанцияНазначения      = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Рейс, "ПунктНазначения");
	Иначе	
    	Возврат;
	КонецЕсли;
	
	Выборка = РефСцепСервер.ОпределитьПоздниеФактическиеДатыСпискаЖДН(ВсеЖДН);
	
	Пока Выборка.Следующий() Цикл		
		Объект.Сделка = Выборка.Сделка;
		Объект.ТранспортныйДокумент = Выборка.ТранспортныйДокумент;
		Если не Выборка.ДатаИВремяОтправленияГруза > ТекущаяДата() Тогда
				Объект.ФактическоеОтправление = Выборка.ДатаИВремяОтправленияГруза;
		Иначе
			ОбщегоНазначения.СообщитьПользователю("Фактическая дата отправления " 
			+ Формат(Выборка.ДатаИВремяОтправленияГруза,"ДФ=") + " больше текущей даты " +	
			+ Формат(ТекущаяДата(),"ДФ=")); 
		КонецЕсли;
		Если не Выборка.ДатаИВремяПрибытияГрузаМестная>ТекущаяДата() Тогда
			
			Объект.ФактическоеПрибытие = Выборка.ДатаИВремяПрибытияГрузаМестная;
			
			Объект.ФактическоеПрибытиеИзмененоВручную = Ложь;
			
		Иначе
			ОбщегоНазначения.СообщитьПользователю("Фактическая дата прибытия " 
			+ Формат(Выборка.ДатаИВремяПрибытияГрузаМестная,"ДФ=") + " больше текущей даты " +	
			+ Формат(ТекущаяДата(),"ДФ=")); 
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ФактическоеОтправлениеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ДатыБольшеТекущей(ВыбранноеЗначение, СтандартнаяОбработка, "ФактическоеОтправление") Тогда
		Возврат;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ФактическоеПрибытиеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ДатыБольшеТекущей(ВыбранноеЗначение, СтандартнаяОбработка, "ФактическоеПрибытие") Тогда
		Возврат;
	КонецЕсли;	

	Если Объект.ФактическоеПрибытие <> ВыбранноеЗначение Тогда
		ФактическоеПрибытиеИзмененоВручную = Истина;
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Функция ДатыБольшеТекущей(ВыбранноеЗначение, СтандартнаяОбработка, ИмяРеквизитаФормы)
	
	Если ВыбранноеЗначение > ТекущаяДата() Тогда

		ОбщегоНазначенияКлиент.СообщитьПользователю(
	   		НСтр("ru = 'Вводимая дата не может быть позже текущей!'"), ,
	   		ИмяРеквизитаФормы);

		СтандартнаяОбработка = Ложь;
		
		Возврат Истина;
		
	КонецЕсли;	

	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура РейсПриИзменении(Элемент)

	Если ЗначениеЗаполнено(Объект.Рейс) Тогда
       	ОпределитьАктуальныеДатыИСтанции();
		ПоследнийЗаполненныйРейс = Объект.Рейс;
	Иначе	
		
		Если (ПоследнийЗаполненныйРейс <> ПредопределенноеЗначение("Справочник.РейсыЖД.ПустаяСсылка") 
			и Объект.СтанцияОтправления  = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(ПоследнийЗаполненныйРейс, "ПунктОтправления") 
			и Объект.СтанцияНазначения   = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(ПоследнийЗаполненныйРейс, "ПунктНазначения"))
			или ПоследнийЗаполненныйРейс = ПредопределенноеЗначение("Справочник.РейсыЖД.ПустаяСсылка") Тогда
			    Объект.СтанцияОтправления = Неопределено;
			    Объект.СтанцияНазначения  = Неопределено;
		КонецЕсли;	  
			  
		Объект.ПланируемоеОтправление  = Дата(1,1,1);	
		Объект.ПланируемоеПрибытие	   = Дата(1,1,1);	
		Объект.ФактическоеОтправление  = Дата(1,1,1);
		Если не Объект.ФактическоеПрибытиеИзмененоВручную Тогда 
			Объект.ФактическоеПрибытие = Дата(1,1,1);
		КонецЕсли;	
	КонецЕсли;	
	
	УстановитьДоступностьЭлементовФормы(); 
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьЭлементовФормы() 
	
	УстановитьДоступностьЭлементовФормыНаСервере();
	
КонецПроцедуры 

&НаСервере
Процедура УстановитьДоступностьЭлементовФормыНаСервере() 
	
	РольДоступнаПОлныеПрава = РольДоступна("ПолныеПрава"); 
	
	ЗапретДоступаПоРолям = РольДоступна("dc_РаботаСЗаявками") 
	и не РольДоступна("dc_УправлениеРефСцепами")
	И не РольДоступнаПОлныеПрава;
	Элементы.ВагоныРефСцепаОбновитьДанныеОВагонахВРефСцепе.Доступность = не ЗапретДоступаПоРолям;
	//
	Элементы.ПланируемоеОтправление.ТолькоПросмотр = ЗначениеЗаполнено(Объект.Рейс) или ЗапретДоступаПоРолям; 
	Элементы.ПланируемоеПрибытие.ТолькоПросмотр    = ЗначениеЗаполнено(Объект.Рейс) или ЗапретДоступаПоРолям;
	Элементы.ФактическоеОтправление.ТолькоПросмотр = Истина;
	Элементы.ФактическоеПрибытие.ТолькоПросмотр    = Объект.ЕстьСделкаЗаявкиПоРефСцепу или ЗапретДоступаПоРолям;
	Элементы.Рейс.ТолькоПросмотр    			   = Объект.ЕстьСделкаЗаявкиПоРефСцепу или ЗапретДоступаПоРолям;
	
КонецПроцедуры

#КонецОбласти

#Область ОбновлениеПолейВагонов
// 2.2, 2.3, 2.4
&НаКлиенте
Процедура ОбновитьДанныеОВагонахВРефСцепе(Команда)
	
	Если не Объект.Проведен Тогда
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(                          
			"Обновление данных не выполнено т.к. документ не проведен.");
		
		Возврат;
		
	ИначеЕсли Объект.РейсЗавершен Тогда
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(                          
			"Обновление данных не выполнено т.к. перевозка завершена.");

		Возврат;
		
	КонецЕсли;	
	
	ОбновитьДанныеОВагонахПоРегиструНаСервере();
	
	ЭтаФорма.Модифицированность = Истина; 
	
	УстановитьГруппировкуПоВагонамЦветомТекста();
	
	ОчиститьПометкиБезОрганичений();
	
	//Субботин 78646 13.12.2023 Начало	
	ЗаполнитьПризнакЭксплуатации()
	//Субботин 78646 13.12.2023 Конец	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеОВагонахПоРегиструНаСервере()
	
	// Обновляем данные с учетом регистра ВагоныРефСцепа
	
	ЭтоОбновлениеДанныхИзРегистра = Истина;
	
	Объект.ВагоныРефСцепа.Загрузить(
		РефСцепСервер.ПолучитьДанныеФормыРегистраБазыДокумента
		(Объект.ВагоныРефСцепа.Выгрузить()
		, Объект.РефСцеп
		, Истина
		, Объект.Ссылка)
		);
	// Удаляем контейнеры вагонов, которых нет в регистре Вагоны реф.сцепа
	
	//Если не ЗначениеЗаполнено(Объект.ФактическоеОтправление) Тогда
	
		Для каждого стр из Объект.ВагоныРефСцепа Цикл
			Если Стр.Контейнер = Справочники.ТЕ.ПустаяСсылка() Тогда Продолжить; КонецЕсли;
			Стр.Отметка = не Стр.ЕстьВагонВРегистреНаФорме;
		КонецЦикла;	
		
		ОтвязатьКонтейнерыОтВагоновНаСервере(Истина);

	//КонецЕсли;	
	
    УдалитьВагоныНеВходящиеВРефСцеп();
	
	ПроверитьПревышениеКонтейнеровВВагонеПоТЭУ();
	
	Если ПроверитьУсловияРейсЗавершен() Тогда
		Объект.РейсЗавершен = Истина;
	КонецЕсли;	
	
	ПроверитьДобавитьДГК(); 
	
	ЗакрытьЗадачу(Справочники.Состояния.ОбновитьДанныеОВагонахВРефСцепе);	
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьДобавитьТанкКонтейнер(ДГК, ДанныеСтрокиСДГК)
	ТанкКонтейнер = РефСцепСервер.ПолучитьТанкКонтейнерНаСервере(ДГК);
	Если ТанкКонтейнер <> Справочники.ТЕ.ПустаяСсылка() Тогда
		мТанкКонтейнера = Объект.ВагоныРефСцепа.НайтиСтроки(Новый Структура("Контейнер", ТанкКонтейнер));
		Если мТанкКонтейнера.Количество()= 0 Тогда
			НоваяСтрока = Объект.ВагоныРефСцепа.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеСтрокиСДГК,, "Клиент,  
			|Груз,
			|Клиент,
			|ВесКонтейнераБрутто,
			|Отметка,
			|ВесКонтейнераНетто,
			|ПеренесенВРефСцеп,
			|ЭтоКонтейнерСДГК,
			//|Заявка
			|КлючАналитикиПеревозки"); 
			НоваяСтрока.Контейнер  		 = ТанкКонтейнер;
			НоваяСтрока.ЭтоТанкКонтейнер = Истина; 
			НоваяСтрока.Типоразмер 		 = НоваяСтрока.Контейнер.ТипТЕ; 
			НоваяСтрока.Клиент 	 		 = Константы.КонтрагентДирекцияКонтейнерныхПеревозок.Получить();
			НоваяСтрока.Ответственный 	 = Объект.Автор;
            //Субботин 78028 21.12.2023 убираем изменения ключей везде кроме проведения/записи
			//ОбновитьДанныеКлючаАналитикиПеревозки(НоваяСтрока, "ВагоныРефСцепа");
			//Субботин 78028 21.12.2023 Конец
			НоваяСтрока.СостояниеКонтейнера = Перечисления.СостоянияКТК.Порожний;
			
		Иначе
			Для Каждого Стр из мТанкКонтейнера Цикл
				Стр.ЭтоТанкКонтейнер = Истина; 
				Если не ЗначениеЗаполнено(Стр.Ответственный) Тогда
					Стр.Клиент 	     = Константы.КонтрагентДирекцияКонтейнерныхПеревозок.Получить();
					Стр.Ответственный = Объект.Автор;
				КонецЕсли;
				//Субботин 78028 21.12.2023 убираем изменения ключей везде кроме проведения/записи
				//ОбновитьДанныеКлючаАналитикиПеревозки(Стр, "ВагоныРефСцепа");
				//Субботин 78028 21.12.2023 конец
			КонецЦикла;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры 

&НаСервере
Процедура ПроверитьТанкКонтейнерыБезДГК()
	КонтейнерыБезДГК = РефСцепСервер.ПроверитьТанкКонтейнерыБезДГК(Объект.ВагоныРефСцепа.Выгрузить());
	Для каждого стр из КонтейнерыБезДГК Цикл
		ТанкКонтейнерыБезДГКВТЧВагоны = Объект.ВагоныРефСцепа.НайтиСтроки(Новый Структура("Контейнер", стр ));
		Для каждого СтрокаТанкКонтейнерБезДГК_ТЧ из ТанкКонтейнерыБезДГКВТЧВагоны Цикл
			Если ЗначениеЗаполнено(СтрокаТанкКонтейнерБезДГК_ТЧ.Заявка) Тогда
				СтрокаТанкКонтейнерБезДГК_ТЧ.Отметка = Истина;
				Сообщить("Не обнаружен ДГК контейнер у Танк-контейнера №" + СтрокаТанкКонтейнерБезДГК_ТЧ.Контейнер 
					+ ". Он отмечен для отвязки от вагона.");
			Иначе
				Сообщить("Не обнаружен ДГК контейнер у Танк-контейнера №" + СтрокаТанкКонтейнерБезДГК_ТЧ.Контейнер 
					+ ". Танк-контейнер удален.");
				Объект.ВагоныРефСцепа.Удалить(СтрокаТанкКонтейнерБезДГК_ТЧ);
			КонецЕсли;
		КонецЦикла;	
	КонецЦикла;	

КонецПроцедуры


&НаСервере
Процедура ПроверитьДобавитьДГК()
	
	ВыборкаКонтейнерДГК = РефСцепСервер.ПолучитьДанныеДГКВагоновРефСцепа
		(РефСцепСервер.ПолучитьДанныеПоВагонамРефСцепаРегистра(Объект.РефСцеп)
		, Объект.РефСцеп);
		
	Если ВыборкаКонтейнерДГК = Неопределено Тогда	
		Возврат;
	КонецЕсли;	
	// Добавление ДГК 	
	КлиентДирекцияЕвросиб = Константы.КонтрагентДирекцияКонтейнерныхПеревозок.Получить();
	//Субботин 76064 20.10.2023 Начало 
	Если ВыборкаКонтейнерДГК.Следующий() тогда
		КонтейнерДГК = ВыборкаКонтейнерДГК; 
	КОнецЕсли;
	
	//Проверка располжения ДГК: возвращает "Истину" если расположен верно
	// 							 возвращает "Ложь" если ДГК не был найден или был привязан к другому вагону и строка была очищена и нужно привязать
	РасположениеДГКП = ПроверитьРасположениеДГК(КонтейнерДГК);
	Если РасположениеДГКП = ложь тогда
		ПризнакМонтированГДК = 2; // в соответствии с регистром вагоны в реф.сцепах
		//Субботин 76064 20.10.2023 Конец
		//Пока ВыборкаКонтейнерДГК.Следующий() Цикл
		мСтрокДГК = Объект.ВагоныРефСцепа.НайтиСтроки(
		Новый Структура("Вагон, ПризнакВагона"
		, КонтейнерДГК.Вагон, ПризнакМонтированГДК));
		
		Если мСтрокДГК.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(мСтрокДГК[0], КонтейнерДГК,,"Вагон");
			мСтрокДГК[0].Клиент 	              = КлиентДирекцияЕвросиб;
			мСтрокДГК[0].Ответственный            = Объект.Автор;
			мСтрокДГК[0].ПринадлежностьКонтейнера = Перечисления.ПринадлежностьТЕ.КТЕвросиба;
			
			Объект.ИндексПоезда = мСтрокДГК[0].ИндексПоезда;
			ПроверитьДобавитьТанкКонтейнер(мСтрокДГК[0].Контейнер, мСтрокДГК[0]);
		ИначеЕсли мСтрокДГК.Количество() = 0 Тогда
			мСтрокБезДГК = Объект.ВагоныРефСцепа.НайтиСтроки(
			Новый Структура("Вагон"
			, КонтейнерДГК.Вагон)); 
			
			Для каждого стр из мСтрокБезДГК Цикл
				Если не ЗначениеЗаполнено(Стр.Контейнер) Тогда
					ЗаполнитьЗначенияСвойств(стр, КонтейнерДГК,,"Вагон");
					стр.Клиент 	                 = КлиентДирекцияЕвросиб;
					стр.Ответственный            = Объект.Автор;
					стр.ПринадлежностьКонтейнера = Перечисления.ПринадлежностьТЕ.КТЕвросиба;
					ПроверитьДобавитьТанкКонтейнер(стр.Контейнер, стр);
					Объект.ИндексПоезда          = стр.ИндексПоезда;
					Прервать;
				Иначе
					НоваяСтрока = Объект.ВагоныРефСцепа.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, стр, "Вагон,  
					|ПорядковыйНомерВСцепе,
					|ПотребовалсяПодсылПорожнегоВагона,
					|СтанцияОтправленияПодсыла,
					|ИндексПоезда,
					|ЖДНакладная"); 
					ЗаполнитьЗначенияСвойств(НоваяСтрока, КонтейнерДГК,"Контейнер, ПризнакВагона, ЭтоКонтейнерСДГК"); 
					НоваяСтрока.Клиент 	                 = КлиентДирекцияЕвросиб;
					НоваяСтрока.Ответственный            = Объект.Автор;
					НоваяСтрока.ПринадлежностьКонтейнера = Перечисления.ПринадлежностьТЕ.КТЕвросиба;
					ПроверитьДобавитьТанкКонтейнер(НоваяСтрока.Контейнер, НоваяСтрока);
					Объект.ИндексПоезда = НоваяСтрока.ИндексПоезда;
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;
		//КонецЦикла;
	КонецЕсли;
	ПроверитьТанкКонтейнерыБезДГК();
	Объект.ВагоныРефСцепа.Сортировать("ПорядковыйНомерВСцепе, НомерСтроки");
КонецПроцедуры

//Субботин 76064 20.10.2023 Начало
Функция ПроверитьРасположениеДГК(ДанныеКонтейнераДГК)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВТ_ДанныеДГК.Контейнер КАК Контейнер,
		|	ВТ_ДанныеДГК.Вагон КАК Вагон,
		|	ВТ_ДанныеДГК.ПризнакВагона КАК ПризнакВагона,
		|	ВТ_ДанныеДГК.ЭтоКонтейнерСДГК КАК ЭтоКонтейнерСДГК
		|ПОМЕСТИТЬ ДанныеДГК
		|ИЗ
		|	&ВТ_ДанныеДГК КАК ВТ_ДанныеДГК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеРефсцепа.Контейнер КАК Контейнер,
		|	ДанныеРефсцепа.Вагон КАК Вагон,
		|	ДанныеРефсцепа.ПризнакВагона КАК ПризнакВагона,
		|	ДанныеРефсцепа.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ ДанныеРефсцепа
		|ИЗ
		|	&ДанныеРефсцепа КАК ДанныеРефсцепа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеРефсцепа.Контейнер КАК Контейнер,
		|	ВЫБОР
		|		КОГДА ДанныеРефсцепа.Вагон = ДанныеДГК.Вагон
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ДанныеРефсцепа.Вагон
		|	КОНЕЦ КАК Вагон
		|ИЗ
		|	ДанныеДГК КАК ДанныеДГК
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДанныеРефсцепа КАК ДанныеРефсцепа
		|		ПО ДанныеДГК.Контейнер = ДанныеРефсцепа.Контейнер";
	
	Запрос.УстановитьПараметр("ВТ_ДанныеДГК", ДанныеКонтейнераДГК);
	Запрос.УстановитьПараметр("ДанныеРефсцепа", Объект.ВагоныРефСцепа.Выгрузить());
	РезультатЗапроса = Запрос.Выполнить();
	
	ПравильнаяСтрока = Ложь;
	Если РезультатЗапроса.Пустой() тогда
		Возврат ПравильнаяСтрока;
	Иначе
		СтруктураОбнуления = Новый Структура("Контейнер, ПринадлежностьКонтейнера,СостояниеКонтейнера,  Груз,Ответственный, ВесКонтейнераБрутто,
		| ВесКонтейнераНетто, КоличествоМестКонтейнера, Клиент, Заявка, ПеренесенВРефСцеп, ДопИнформация, Клиент, Ответственный, ПринадлежностьКонтейнера, КлючАналитикиПеревозки, ЭтоКонтейнерСДГК");
   		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() цикл
			Если ВыборкаДетальныеЗаписи.Вагон <> Истина тогда
				СтрокиДляОчистики = Объект.ВагоныРефСцепа.НайтиСтроки(Новый Структура("Вагон", ВыборкаДетальныеЗаписи.Вагон));
				Для каждого СтрокаДляОчистики из СтрокиДляОчистики Цикл
					ЗаполнитьЗначенияСвойств(СтрокаДляОчистики, СтруктураОбнуления);
				КонецЦикла;
			Иначе
				ПравильнаяСтрока = Истина;				
			КонецЕсли;
		КонецЦикла;		  
		Возврат ПравильнаяСтрока
	КонецЕсли;
	
КонецФункции
//Субботин 76064 20.10.2023 Конец

&НаСервере
Функция ПроверитьУсловияРейсЗавершен()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РефСцепВагоныРефСцепа.ЕстьВагонВРегистреНаФорме КАК ЕстьВагонВРегистреНаФорме
		|ПОМЕСТИТЬ вт_Вагоны
		|ИЗ
		|	&тзВагоны КАК РефСцепВагоныРефСцепа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_Вагоны.ЕстьВагонВРегистреНаФорме КАК ЕстьВагонВРегистреНаФорме
		|ИЗ
		|	вт_Вагоны КАК вт_Вагоны
		|ГДЕ
		|	вт_Вагоны.ЕстьВагонВРегистреНаФорме = Истина";
	
	Запрос.УстановитьПараметр("тзВагоны", Объект.ВагоныРефСцепа.Выгрузить());
	Возврат Запрос.Выполнить().Пустой(); 
КонецФункции
	
&НаСервере
Процедура УдалитьВагоныНеВходящиеВРефСцеп()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ *
		|ПОМЕСТИТЬ вт_Вагоны
		|ИЗ
		|	&тз_Вагоны КАК тз_Вагоны
		|ГДЕ
		|	НЕ(&ФактическоеОтправление = ДАТАВРЕМЯ(1, 1, 1)
