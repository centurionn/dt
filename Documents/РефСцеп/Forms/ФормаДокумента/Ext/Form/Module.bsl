	Запрос.УстановитьПараметр("тз_Вагоны", Объект.ВагоныРефСцепа.Выгрузить()); 
	Запрос.УстановитьПараметр("ФактическоеОтправление", Объект.ФактическоеОтправление); 
	Объект.ВагоныРефСцепа.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры	

