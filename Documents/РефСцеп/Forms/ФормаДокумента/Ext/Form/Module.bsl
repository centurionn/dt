&НаСервере
Функция ПолучитьтзДанныеДокументаВагоныДляЖДНПодсыла()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	РефСцепВагоныРефСцепа.Вагон.Наименование КАК НомерВагона,
	               |	РефСцепВагоныРефСцепа.Ссылка.ФактическоеОтправление КАК ФактическоеОтправление,
	               |	РефСцепВагоныРефСцепа.Ссылка.СтанцияОтправления.КодЖДСтанции КАК КодЖДСтанции,
	               |	РефСцепВагоныРефСцепа.Вагон КАК Вагон,
	               |	РефСцепВагоныРефСцепа.Ссылка.ПланируемоеОтправление КАК ПланируемоеОтправление,
	               |	РефСцепВагоныРефСцепа.Ссылка КАК РефСцеп
	               |ИЗ
	               |	Документ.РефСцеп.ВагоныРефСцепа КАК РефСцепВагоныРефСцепа
	               |ГДЕ
	               |	РефСцепВагоныРефСцепа.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ОБъект.Ссылка);
	
	Возврат Запрос.Выполнить().Выгрузить(); 

КонецФункции

&НаКлиенте
Процедура ЗаполнитьРеквизитСтрокВагона(Вагон, ИмяРеквизита, ЗначениеРеквизита) 
	мСтрокВагона = Объект.ВагоныРефСцепа.НайтиСтроки(Новый Структура("Вагон", Вагон));
	Для Каждого Стр из мСтрокВагона Цикл
		Стр[ИмяРеквизита] = ЗначениеРеквизита;
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Функция РеквизитЗаполненВОднойИзСтрокВагонаИлиВсейТЧ(Вагон = Неопределено, ИмяРеквизита)
	
	Если ЗначениеЗаполнено(Вагон) Тогда
		// С отбором по вагону
		мСтрокВагона = Объект.ВагоныРефСцепа.НайтиСтроки(Новый Структура("Вагон", Вагон));
	Иначе
		мСтрокВагона = Объект.ВагоныРефСцепа;
	КонецЕсли;	
	
	Для Каждого Стр из мСтрокВагона Цикл
		Если ТипЗнч(Стр[ИмяРеквизита]) = Тип("Булево") Тогда
			Если Стр[ИмяРеквизита] Тогда
				Возврат Истина;
			КонецЕсли;
		Иначе
			Если ЗначениеЗаполнено(Стр[ИмяРеквизита]) Тогда
				Возврат Истина;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти

#Область УправлениеПорядкомКонтейнеровВВагоне 
// п 1.11

&НаКлиенте
Процедура ПереместитьВниз(Команда)
	
	ТекущиеДанные = Элементы.ВагоныРефСцепа.ТекущиеДанные;
	
	НомерСтроки = ТекущиеДанные.НомерСтроки; 
	
	Вагон       = ТекущиеДанные.Вагон;
	
	ПереместитьНаСервере(НомерСтроки, Вагон, Истина); 
	
	УстановитьГруппировкуПоВагонамЦветомТекста();
	
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьВверх(Команда)

	ТекущиеДанные = Элементы.ВагоныРефСцепа.ТекущиеДанные;
	
	НомерСтроки = ТекущиеДанные.НомерСтроки; 
	
	Вагон       = ТекущиеДанные.Вагон;
	
	ПереместитьНаСервере(НомерСтроки, Вагон, Ложь);
	
	УстановитьГруппировкуПоВагонамЦветомТекста(); 
	
КонецПроцедуры

&НаСервере
Процедура ПереместитьНаСервере(НомерСтроки, Вагон, Вниз)

	Если ЭтоКорректноеПеремещенияСтрок(Вагон, НомерСтроки, Вниз) Тогда
	
		Если Вниз Тогда Шаг = 1 Иначе Шаг = -1 КонецЕсли;
		
		Объект.ВагоныРефСцепа.Сдвинуть(НомерСтроки-1, Шаг); 
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Функция ЭтоКорректноеПеремещенияСтрок(Вагон, НомерСтроки, Вниз)

	тзВагоны = ОБъект.ВагоныРефСцепа.Выгрузить();
	
	// Не должен выходить за границы массива
	
	Если (((НомерСтроки) >= тзВагоны.Количество()) и Вниз)
		или ((НомерСтроки) <= 1 и не Вниз) Тогда
		
		Возврат Ложь;

	КонецЕсли;

	// Если количество контейнеров в вагоне = 1 нет смысла перемещения
	// так как меняется порядок вагонов, а не контейнеров в вагоне
	
    тзКоличествоКонтейнеровВВагонах = КоличествоКонтейнеровВВагонах(тзВагоны);
	
	Если не тзКоличествоКонтейнеровВВагонах.Найти(Вагон, "Вагон").КоличествоКонтейнеровВВагоне > 1 Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	// Если вниз
	Если Вниз Тогда Шаг = 1; Иначе Шаг = -1 КонецЕсли;
	
	НомерСтрокиПриемника = НомерСтроки + Шаг;
	
	// При перемещении контейнер должен оставаться внутри вагона.
	Если тзВагоны.Найти(НомерСтрокиПриемника, "НомерСтроки").Вагон<>Вагон Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция КоличествоКонтейнеровВВагонах(тзВагоны) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	1 КАК КоличествоКонтейнеровВВагоне,
		|	РефСцепВагоныРефСцепа.Вагон КАК Вагон
		|ПОМЕСТИТЬ вт_Контейнеры
		|ИЗ
		|	Документ.РефСцеп.ВагоныРефСцепа КАК РефСцепВагоныРефСцепа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(вт_Контейнеры.КоличествоКонтейнеровВВагоне) КАК КоличествоКонтейнеровВВагоне,
		|	вт_Контейнеры.Вагон КАК Вагон
		|ИЗ
		|	вт_Контейнеры КАК вт_Контейнеры
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_Контейнеры.Вагон";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

