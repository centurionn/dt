&НаКлиенте
Процедура ЗагрузитьИзExcelЗавершение(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 <> неопределено Тогда 
			 
		Для Сч = 0 по Параметр1.КТК.Количество()-1 Цикл
			
			Если ЕстьДублиНовыхКонтейнеров("Контейнеры", Параметр1.КТК[Сч]) Тогда Продолжить; КонецЕсли;
			
			НоваяСтрока = Объект.Контейнеры.Добавить();
			
            НоваяСтрока.Контейнер = РаботаСКонтейнерамиСервер.НайтиКТК(Параметр1.КТК[Сч]);
			
			// Субботин 79931 19.01.2024 начало 	
			//НоваяСтрока.ПринадлежностьКонтейнера = ПредопределенноеЗначение("Перечисление.ПринадлежностьТЕ.КТКлиента");
			ДанныеПоКТК = ПолучитьПринадлежностьНаСервере(Параметр1.КТК[Сч]);
			НоваяСтрока.ПринадлежностьКонтейнера = ДанныеПоКТК.Принадлежность;
			// Субботин 79931 19.01.2024 Конец 
			
			Если ЗначениеЗаполнено(НоваяСтрока.Груз) Тогда
				НоваяСтрока.СостояниеКонтейнера = ПредопределенноеЗначение("Перечисление.СостоянияКТК.Груженый");
			Иначе
				НоваяСтрока.СостояниеКонтейнера = ПредопределенноеЗначение("Перечисление.СостоянияКТК.Порожний");
			КонецЕсли;	     
			//Субботин 78028 21.12.2023 убираем изменения ключей везде кроме проведения/записи
			//НоваяСтрока.КлючАналитикиПеревозки = РефСцепСервер.НайтиСоздатьКлючАналитикиПеревозки(НоваяСтрока.Контейнер);
			//Субботин 78028 21.12.2023 конец	
		КонецЦикла;
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
	//Субботин 78646 13.12.2023 Начало	
	ЗаполнитьПризнакЭксплуатации()
	//Субботин 78646 13.12.2023 Конец 	
КонецПроцедуры         

&НаКлиенте
Процедура КонтейнерыКонтейнерПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Контейнеры.ТекущиеДанные;
	//Субботин 78646 12.12.2023 Конец 
	//ТекущиеДанные.ПринадлежностьКонтейнера = ПолучитьПринадлежностьНаСервере(ТекущиеДанные.Контейнер);
	ДанныеПоКТК = ПолучитьПринадлежностьНаСервере(ТекущиеДанные.Контейнер);	
	ТекущиеДанные.ПринадлежностьКонтейнера = ДанныеПоКТК.Принадлежность;
	ТекущиеДанные.ПризнакЭксплуатации = ДанныеПоКТК.ПризнакЭксплуатации;
	//Субботин 78646 12.12.2023 Конец
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Груз) Тогда
		ТекущиеДанные.СостояниеКонтейнера = ПредопределенноеЗначение("Перечисление.СостоянияКТК.Груженый");
	Иначе
		ТекущиеДанные.СостояниеКонтейнера = ПредопределенноеЗначение("Перечисление.СостоянияКТК.Порожний");
	КонецЕсли; 
	//Субботин 76108 25.10.2023 
	Если ЗначениеЗаполнено(ТекущиеДанные.КлючАналитикиПеревозки) Тогда
		Если ТекущиеДанные.Контейнер <> ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(ТекущиеДанные.КлючАналитикиПеревозки,"Контейнер") Тогда  
			// Евросиб(ДИТ) US 85028 ТА 87358 Сержантова А.С. Начало: 02.07.2024
			Если ЗначениеЗаполнено(ТекущиеДанные.КлючАналитикиПеревозки) Тогда
				ТекущиеСтрокиДетализации = ДетализацияПоГрузу.НайтиСтроки(Новый Структура("КлючАналитикиперевозки", ТекущиеДанные.КлючАналитикиПеревозки));
				Для каждого СтрДетализации Из ТекущиеСтрокиДетализации Цикл
					ДетализацияПоГрузу.Удалить(СтрДетализации);	
				КонецЦикла; 
			КонецЕсли;
			// Евросиб(ДИТ) US 85028 ТА 87358 Сержантова А.С. Конец: 02.07.2024
			//Евросиб Коханенко Н.А. 19.09.2024 (( #90312
			УдалитьСсылкуНаРефИзКлючаАналитики(ТекущиеДанные.КлючАналитикиПеревозки);
			//Евросиб Коханенко Н.А. 19.09.2024 )) #90312 
			ТекущиеДанные.КлючАналитикиПеревозки = Неопределено;
			ТекущиеДанные.Груз = Неопределено;  
		//Субботин 78028 21.12.2023 Начало 	
			ТекущиеДанные.ВесКонтейнераНетто = 0;
			ТекущиеДанные.КоличествоМестКонтейнера  = 0;
			ТекущиеДанные.ЗаявкаПодбора = ПредопределенноеЗначение("Документ.Заявка.ПустаяСсылка");
			ТекущиеДанные.Заявка = ПредопределенноеЗначение("Документ.Заявка.ПустаяСсылка");
			ТекущиеДанные.ВерсияКлюча = "";
		//Субботин 78028 21.12.2023 конец 
		КонецЕсли;
	КонецЕсли;
	//Субботин 76108 25.10.2023 конец
	
	//Субботин 76108 25.10.2023 начало убираем закполнения ключа при изменении Ктк
	//НайтиКлючАналитикиПеревозкиКлиент(ТекущиеДанные, "Контейнеры");
   //Субботин 76108 25.10.2023 конец
