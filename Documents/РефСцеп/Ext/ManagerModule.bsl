Процедура НайтиСоздатьЗадачиУдаленияЧужихКонтейнеровЗаявокРефСцепа(РефСцепОбъект
				, НеобходимаЗаписьОбъекта = Ложь);
				
	УдаляемыеКТКИзЗаявкиПоРефСцепуЗадачПоОтвественным = УдаляемыеКТКИзЗаявкиПоРефСцепуЗадачПоОтвественным
		(РефСцепОБъект);	
	тзУдаляемыхКТКИзЗаявкиПоРефСцепу = УдаляемыеКТКИзЗаявкиПоРефСцепуЗадачПоОтвественным.тзУдаляемыхКТКИзЗаявкиПоРефСцепу;
	тзЗаявкиПоОтветсвенным 			 = УдаляемыеКТКИзЗаявкиПоРефСцепуЗадачПоОтвественным.тзЗаявкиПоОтветсвенным;
	мОтветственные                   = УдаляемыеКТКИзЗаявкиПоРефСцепуЗадачПоОтвественным.мОтветственные;
	тзСостояния 					 = РефСцепОБъект.Состояния.Выгрузить();
	СтатусВыполнен 					  = Перечисления.СтатусыЭтапов.Выполнен;
	СтатусНаВыполнение				  = Перечисления.СтатусыЭтапов.НаВыполнение;	
	ОсновнаяЧастьНаименования 		  = "УдалитьКТКИзЗаявкиСоздатьНовуюЗаявку";
	МассивОднотипныхСостояний		  = РефСцепСервер.МассивОднотипныхСостояний(ОсновнаяЧастьНаименования,9);
	
	Если не тзУдаляемыхКТКИзЗаявкиПоРефСцепу.Количество() > 0 Тогда 
	//  Закрываем задачи на удаление заявок
		Для каждого стр из тзСостояния Цикл	
			Если МассивОднотипныхСостояний.Найти(Стр.Состояние)= Неопределено Тогда Продолжить; КонецЕсли;	
			НеобходимаЗаписьОбъекта = Истина;
			Стр.Статус = СтатусВыполнен;
		КонецЦикла;	
		тзСостояния = СдвигНевыполненныхСостоянийВКонецСписка(тзСостояния);
		РефСцепОБъект.Состояния.Загрузить(тзСостояния);
		Возврат; 
	КонецЕсли;	
		
	
	Для каждого СтрОтветственный из мОтветственные Цикл
		
		мЗаявкиПоОтветсвенным = тзЗаявкиПоОтветсвенным.НайтиСтроки(
			НОвый Структура("Ответственный", СтрОтветственный));
		
		МассивЗаявокПоОтветственномуДляКомментария = НОвый Массив;
		
		Для каждого СтрЗаявки из мЗаявкиПоОтветсвенным Цикл 

			МассивКТКПоОтветственномуДляКомментария = НОвый Массив;

			мУдаляемыхКТКИзЗаявкиПоРефСцепу = тзУдаляемыхКТКИзЗаявкиПоРефСцепу.НайтиСтроки(
				НОвый Структура("Ответственный, Заявка", СтрОтветственный, СтрЗаявки.Заявка ));

			Для каждого СтрКТК из мУдаляемыхКТКИзЗаявкиПоРефСцепу Цикл
				Если СокрЛП(СтрКТК.КонтейнерНаименование) = "" Тогда Продолжить; КонецЕсли; 
				МассивКТКПоОтветственномуДляКомментария.Добавить( СтрКТК.КонтейнерНаименование + ", " );
			КонецЦикла;	
			
			МассивЗаявокПоОтветственномуДляКомментария.Добавить("КТК:" + стрСоединить(МассивКТКПоОтветственномуДляКомментария, ", ") 
				+ "Заявка:" + СтрЗаявки.Номер + " от " + Формат(СтрКТК.Дата,"ДФ=""dd.MM.yyyy"""));
		КонецЦикла;		
		
		Комментарий = стрСоединить(МассивЗаявокПоОтветственномуДляКомментария, ", "); 
		
		МассивСостоянийНаУдалениеИзСделки = тзСостояния.НайтиСтроки(Новый Структура("Исполнитель", СтрОтветственный));	
		
		ЕстьСостоянияНаУдалениеИзЗаявкиПоОтветсвенному = Ложь;
			
		Для каждого стр из МассивСостоянийНаУдалениеИзСделки Цикл	
		
			Если МассивОднотипныхСостояний.Найти(Стр.Состояние)= Неопределено Тогда Продолжить; КонецЕсли;	
			
			Если не ЕстьСостоянияНаУдалениеИзЗаявкиПоОтветсвенному Тогда
				ЕстьСостоянияНаУдалениеИзЗаявкиПоОтветсвенному = Истина;    	
			КонецЕсли;	
			
			Если стр.Комментарий <> Комментарий и СокрЛП(Комментарий) <> "" и Стр.Статус <> СтатусНаВыполнение Тогда
				НеобходимаЗаписьОбъекта = Истина;
				Стр.Статус = СтатусНаВыполнение;
			    стр.Комментарий = Комментарий;
			ИначеЕсли стр.Комментарий <> Комментарий и СокрЛП(Комментарий) = "" и Стр.Статус <> СтатусВыполнен Тогда
				НеобходимаЗаписьОбъекта = Истина;
				Стр.Статус = СтатусВыполнен;
			КонецЕсли;	
			
		КонецЦикла;
		Если СокрЛП(Комментарий) <> "" и не ЕстьСостоянияНаУдалениеИзЗаявкиПоОтветсвенному Тогда
			НеобходимаЗаписьОбъекта = Истина;
			НоваяЗадача = тзСостояния.Добавить();
			НоваяЗадача.Исполнитель = СтрОтветственный;
			НоваяЗадача.Наблюдатель = СтрОтветственный;
			НоваяЗадача.Статус		= Перечисления.СтатусыЭтапов.НаВыполнение;
			НоваяЗадача.ВидНормативаИсполнения = Перечисления.ВидыНормативовИспользования.ЧасовСМоментаСозданияДокумента;
			НоваяЗадача.Состояние	= РефСцепСервер.ОчередноеСостояниеОдинаковых(
				тзСостояния, ОсновнаяЧастьНаименования, 9);
			НоваяЗадача.Комментарий = Комментарий; 
		КонецЕсли;	
		
	КонецЦикла;	
	
	
	Если НеобходимаЗаписьОбъекта = Истина Тогда
		тзСостояния = СдвигНевыполненныхСостоянийВКонецСписка(тзСостояния);
		РефСцепОБъект.Состояния.Загрузить(тзСостояния);
	КонецЕсли;	

КонецПроцедуры 

Функция УдаляемыеКТКИзЗаявкиПоРефСцепуЗадачПоОтвественным(РефСцепОбъект);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	РефСцепКонтейнеры.Контейнер КАК Контейнер,
		|	РефСцепКонтейнеры.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	РефСцепКонтейнеры.Ссылка КАК РефСцеп
		|ПОМЕСТИТЬ вт_КонтейнерыПеренесенныеВЭтотРефСцеп
		|ИЗ
		|	Документ.РефСцеп.Контейнеры КАК РефСцепКонтейнеры
		|ГДЕ
		|	РефСцепКонтейнеры.Ссылка.РейсЗавершен = ЛОЖЬ
		|	И РефСцепКонтейнеры.ПеренесенВРефСцеп = &ЭтотРефСцеп
		|	И РефСцепКонтейнеры.Контейнер <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
		|	И РефСцепКонтейнеры.ПеренесенВРефСцеп <> ЗНАЧЕНИЕ(Документ.РефСцеп.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	вт_КонтейнерыПеренесенныеВЭтотРефСцеп.Контейнер КАК Контейнер,
		|	ЗаявкаСоставУслуги.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	ЗаявкаСоставУслуги.Ссылка КАК Заявка,
		|	ЗаявкаСоставУслуги.Ссылка.ОтветственныйМенеджер КАК Ответственный,
		|	ЗаявкаСоставУслуги.Ссылка.Номер КАК Номер,
		|	ЗаявкаСоставУслуги.Ссылка.Дата КАК Дата,
		|	вт_КонтейнерыПеренесенныеВЭтотРефСцеп.Контейнер.Наименование КАК КонтейнерНаименование,
		|	ЗаявкаСоставУслуги.ПеренесенВЗаявку КАК ПеренесенВЗаявку
		|ПОМЕСТИТЬ вт_КонтейнерыЗаявкиКУдалению0
		|ИЗ
		|	Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт_КонтейнерыПеренесенныеВЭтотРефСцеп КАК вт_КонтейнерыПеренесенныеВЭтотРефСцеп
		|		ПО ЗаявкаСоставУслуги.КлючАналитикиПеревозки = вт_КонтейнерыПеренесенныеВЭтотРефСцеп.КлючАналитикиПеревозки
		|ГДЕ
		|	ЗаявкаСоставУслуги.КлючАналитикиПеревозки <> ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПеревозки.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗаявкаСоставУслуги.Заявка КАК Заявка
		|ПОМЕСТИТЬ вт_КонтейнерыЗаявкиВСделках
		|ИЗ
		|	вт_КонтейнерыЗаявкиКУдалению0 КАК ЗаявкаСоставУслуги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
		|		ПО ЗаявкаСоставУслуги.Заявка = СделкаСвязьУчетныхЕдиниц.Заявка
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗаявкаСоставУслуги.ПеренесенВЗаявку
		|ИЗ
		|	вт_КонтейнерыЗаявкиКУдалению0 КАК ЗаявкаСоставУслуги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
		|		ПО ЗаявкаСоставУслуги.Заявка = СделкаСвязьУчетныхЕдиниц.Заявка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	вт_КонтейнерыЗаявкиКУдалению.Контейнер КАК Контейнер,
		|	вт_КонтейнерыЗаявкиКУдалению.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	вт_КонтейнерыЗаявкиКУдалению.Заявка КАК Заявка,
		|	вт_КонтейнерыЗаявкиКУдалению.Ответственный КАК Ответственный,
		|	вт_КонтейнерыЗаявкиКУдалению.Номер КАК Номер,
		|	вт_КонтейнерыЗаявкиКУдалению.Дата КАК Дата,
		|	вт_КонтейнерыЗаявкиКУдалению.КонтейнерНаименование КАК КонтейнерНаименование
		|ПОМЕСТИТЬ вт_КонтейнерыЗаявкиКУдалению
		|ИЗ
		|	вт_КонтейнерыЗаявкиКУдалению0 КАК вт_КонтейнерыЗаявкиКУдалению
		|		ЛЕВОЕ СОЕДИНЕНИЕ вт_КонтейнерыЗаявкиВСделках КАК вт_КонтейнерыЗаявкиВСделках
		|		ПО вт_КонтейнерыЗаявкиКУдалению.Заявка = вт_КонтейнерыЗаявкиВСделках.Заявка
		|ГДЕ
		|	вт_КонтейнерыЗаявкиВСделках.Заявка ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	вт_КонтейнерыЗаявкиКУдалению.Контейнер КАК Контейнер,
		|	вт_КонтейнерыЗаявкиКУдалению.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	вт_КонтейнерыЗаявкиКУдалению.Заявка КАК Заявка,
		|	вт_КонтейнерыЗаявкиКУдалению.Ответственный КАК Ответственный,
		|	вт_КонтейнерыЗаявкиКУдалению.Номер КАК Номер,
		|	вт_КонтейнерыЗаявкиКУдалению.Дата КАК Дата,
		|	вт_КонтейнерыЗаявкиКУдалению.КонтейнерНаименование КАК КонтейнерНаименование
		|ИЗ
		|	вт_КонтейнерыЗаявкиКУдалению КАК вт_КонтейнерыЗаявкиКУдалению
		|ГДЕ
		|	вт_КонтейнерыЗаявкиКУдалению.Заявка <> ЗНАЧЕНИЕ(Документ.Заявка.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	вт_КонтейнерыЗаявкиКУдалению.Заявка КАК Заявка,
		|	вт_КонтейнерыЗаявкиКУдалению.Ответственный КАК Ответственный,
		|	вт_КонтейнерыЗаявкиКУдалению.Номер КАК Номер,
		|	вт_КонтейнерыЗаявкиКУдалению.Дата КАК Дата
		|ИЗ
		|	вт_КонтейнерыЗаявкиКУдалению КАК вт_КонтейнерыЗаявкиКУдалению
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СделкаСостояния.Исполнитель КАК Ответственный
		|ПОМЕСТИТЬ вт_Состояния
		|ИЗ
		|	&тзСостояния КАК СделкаСостояния
		|ГДЕ
		|	ЕСТЬNULL(СделкаСостояния.Исполнитель, ЗНАЧЕНИЕ(Справочник.ПОльзователи.Пустаяссылка)) <> ЗНАЧЕНИЕ(Справочник.ПОльзователи.Пустаяссылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	вт_КонтейнерыЗаявкиКУдалению.Ответственный КАК Ответственный
		|ИЗ
		|	вт_КонтейнерыЗаявкиКУдалению КАК вт_КонтейнерыЗаявкиКУдалению
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	вт_Состояния.Ответственный
		|ИЗ
		|	вт_Состояния КАК вт_Состояния";
	
	Запрос.УстановитьПараметр("ЭтотРефСцеп", РефСцепОбъект.Ссылка);
	Запрос.УстановитьПараметр("тзСостояния", РефСцепОбъект.Состояния.Выгрузить());
	
	Результат = Запрос.ВыполнитьПакет();
	
	Возврат Новый Структура("тзУдаляемыхКТКИзЗаявкиПоРефСцепу, тзЗаявкиПоОтветсвенным, мОтветственные"
		, Результат[4].Выгрузить(), Результат[5].Выгрузить(), Результат[7].Выгрузить().ВыгрузитьКолонку("Ответственный"))

	КонецФункции				
	
Функция СдвигНевыполненныхСостоянийВКонецСписка(тзСостояния)
	тзСостояния.Колонки.Добавить("НомерСтрокиДляСдвига");
	Для каждого Стр из тзСостояния Цикл
		Если  Стр.Статус = Перечисления.СтатусыЭтапов.Выполнен Тогда
			Стр.НомерСтрокиДляСдвига = Стр.НомерСтроки ;
		Иначе	
			Стр.НомерСтрокиДляСдвига = Стр.НомерСтроки +100;
		КонецЕсли;	
	КонецЦикла;
	тзСостояния.Сортировать("НомерСтрокиДляСдвига");
	Возврат тзСостояния;
КонецФункции 

Процедура УдалитьКонтейнерыПеренесенныеВДругойРефСцеп(РефСцепОбъект
	, вт_НаУдалениеИзРефСцепаПослеУдаленияИзЗаявок)

	тзКонтейнеры = РефСцепОбъект.Контейнеры.Выгрузить();
	
	КлючиАналитикиУжеПеренесенныеКУдалению = КлючиАналитикиУжеПеренесенныеКУдалению(тзКонтейнеры, РефСцепОбъект.Ссылка);
	НеобходимаЗаписьОбъекта = Ложь;
	
	Пока КлючиАналитикиУжеПеренесенныеКУдалению.Следующий() Цикл
		
		// Если есть заявки без сделок с неудаленными перенесенными контейнерами - пропускаем
		
		Если вт_НаУдалениеИзРефСцепаПослеУдаленияИзЗаявок.Найти(КлючиАналитикиУжеПеренесенныеКУдалению.КлючАналитикиПеревозки, "КлючАналитикиПеревозки") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		СтрокиКУдалению = тзКонтейнеры.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки"
			, КлючиАналитикиУжеПеренесенныеКУдалению.КлючАналитикиПеревозки));
			
		Для каждого стр из СтрокиКУдалению Цикл
			НеобходимаЗаписьОбъекта = Истина;
			тзКонтейнеры.Удалить(Стр);
		КонецЦикла;
	КонецЦикла;	
			
	Если НеобходимаЗаписьОбъекта Тогда
		РефСцепОбъект.Контейнеры.Загрузить(тзКонтейнеры);
	КонецЕсли;	

КонецПроцедуры

Функция КлючиАналитикиУжеПеренесенныеКУдалению(тзКонтейнеры, РефСцепОбъектСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РефСцепКонтейнеры.ПеренесенВРефСцеп КАК ПеренесенВРефСцеп,
		|	РефСцепКонтейнеры.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки
		|ПОМЕСТИТЬ вт_РефСцепТекущий
		|ИЗ
		|	&тзКонтейнеры КАК РефСцепКонтейнеры
		|ГДЕ
		|	РефСцепКонтейнеры.ПеренесенВРефСцеп <> ЗНАЧЕНИЕ(Документ.РефСцеп.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РефСцепКонтейнеры.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки
		|ИЗ
		|	Документ.РефСцеп.Контейнеры КАК РефСцепКонтейнеры
