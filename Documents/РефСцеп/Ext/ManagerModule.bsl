
Функция ПолучитьПараметрыМаршрутизации(Объект) Экспорт
	
		ПараметрыЗапроса = Новый Соответствие;
		ПараметрыЗапроса.Вставить("Организация", Объект.Организация);
		Возврат ПараметрыЗапроса;
	
КонецФункции

#Область ОотложенноеЗаполнение 
// Отложенное изменение клиентов при смене ответвенного в договоре
Функция  ИзменитьИсполнителейПоДоговору(РефСцепОбъект, Договор) Экспорт
	
	НеобходимаЗаписьОбъекта   = Ложь;
	ЦФО 					  = РефСцепОбъект.ЦФО;
	Клиент 					  = Договор.Владелец;	
	НОвыйОтветственныйКлиента = КонтрагентыДоговоры_Сервер.ПолучитьОтветственногоПоДоговору(Договор, ЦФО
		, Перечисления.ТипыОтветственных.ОтветственныйЗаСопровождение);

	ЗаполнитьОтветственныхПоКлиентам(РефСцепОбъект, Клиент, НовыйОтветственныйКлиента, "ВагоныРефсцепа", НеобходимаЗаписьОбъекта);
	ЗаполнитьОтветственныхПоКлиентам(РефСцепОбъект, Клиент, НовыйОтветственныйКлиента, "Контейнеры", НеобходимаЗаписьОбъекта);
	
	Возврат НеобходимаЗаписьОбъекта;
	
КонецФункции

Процедура ЗаполнитьОтветственныхПоКлиентам(РефСцепОбъект, Клиент, НовыйОтветственныйКлиента, ИмяТЧ, НеобходимаЗаписьОбъекта)
	
	тзВыгруженнаяТЧ = РефСцепОбъект[ИмяТЧ].Выгрузить();
	мВыгруженнаяТЧ  = тзВыгруженнаяТЧ.НайтиСтроки(Новый Структура("Клиент", Клиент));
	Для каждого Стр из мВыгруженнаяТЧ Цикл
		Стр.Ответственный 		= НовыйОтветственныйКлиента;
		НеобходимаЗаписьОбъекта = Истина;
	КонецЦикла;
	РефСцепОбъект[ИмяТЧ].Загрузить(тзВыгруженнаяТЧ);
	
КонецПроцедуры	

// Отложенное изменение клиентов при смене контрагента в заявке
Функция  ИзменитьРефСцепПоЗаявке(РефСцепОбъект, Заявка) Экспорт
	
	НеобходимаЗаписьОбъекта  = Ложь;
	
	ОчиститьЗаявкиПодбораВРефСцепе(РефСцепОбъект, Заявка, НеобходимаЗаписьОбъекта);
	
	Если НеобходимаЗаписьОбъекта Тогда Возврат Истина; КонецЕсли;
	
	ДанныеЗаявкиДляИзменения = ПолучитьПоляИзмененияРефСцепаПоЗаявке(Заявка, РефСцепОбъект);
	
	// Изменения шапки
	Для каждого Стр из ДанныеЗаявкиДляИзменения Цикл 
		Если не ЗначениеЗаполнено(РефСцепОбъект.Рейс) Тогда
			ПроверитьНаСовпадениеПрисвоитьЗначение(РефСцепОбъект, "Отправка", Стр.Отправка
				,"ПланируемоеОтправление", РефСцепОбъект.ПланируемоеОтправление, НеобходимаЗаписьОбъекта);
			ПроверитьНаСовпадениеПрисвоитьЗначение(РефСцепОбъект, "Прибытие", Стр.Прибытие
				,"ПланируемоеПрибытие", РефСцепОбъект.ПланируемоеОтправление, НеобходимаЗаписьОбъекта);
			ПроверитьНаСовпадениеПрисвоитьЗначение(РефСцепОбъект, "СтанцияОтправления", Стр.СтанцияОтправления
				,"СтанцияОтправления", РефСцепОбъект.ПланируемоеОтправление, НеобходимаЗаписьОбъекта);
			ПроверитьНаСовпадениеПрисвоитьЗначение(РефСцепОбъект, "СтанцияНазначения", Стр.СтанцияНазначения
				,"СтанцияНазначения", РефСцепОбъект.ПланируемоеОтправление, НеобходимаЗаписьОбъекта);
		КонецЕсли;
        Прервать;
    КонецЦикла;
	
	МассивПОлейТЧНаИзменениеПоЗаявке = Новый Массив;
	МассивПОлейТЧНаИзменениеПоЗаявке.Добавить("Контейнер");
	МассивПОлейТЧНаИзменениеПоЗаявке.Добавить("ПринадлежностьКонтейнера");
	МассивПОлейТЧНаИзменениеПоЗаявке.Добавить("ВесКонтейнераНетто");
	МассивПОлейТЧНаИзменениеПоЗаявке.Добавить("КоличествоМестКонтейнера");
	МассивПОлейТЧНаИзменениеПоЗаявке.Добавить("Клиент");
	МассивПОлейТЧНаИзменениеПоЗаявке.Добавить("СостояниеКонтейнера");
	ЗаполнитьРеквизитПоЗаявкеКлючейАналитики(РефСцепОбъект, Заявка, "ВагоныРефсцепа"
		, НеобходимаЗаписьОбъекта, МассивПОлейТЧНаИзменениеПоЗаявке, ДанныеЗаявкиДляИзменения);
	ЗаполнитьРеквизитПоЗаявкеКлючейАналитики(РефСцепОбъект, Заявка, "Контейнеры"	   
		, НеобходимаЗаписьОбъекта, МассивПОлейТЧНаИзменениеПоЗаявке, ДанныеЗаявкиДляИзменения);
	
	Возврат НеобходимаЗаписьОбъекта;
	
КонецФункции

Процедура ОчиститьЗаявкиПодбораВРефСцепе(РефСцепОбъект, Заявка, НеобходимаЗаписьОбъекта)
	Для каждого Стр из РефСцепОбъект.Контейнеры Цикл
		Если Стр.ЗаявкаПодбора <> Документы.Заявка.ПустаяСсылка() Тогда
			НеобходимаЗаписьОбъекта = Истина;
			Стр.ЗаявкаПодбора = Документы.Заявка.ПустаяСсылка();
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры

Функция ПроверитьНаСовпадениеПрисвоитьЗначение(ИзменяемыйОбъект, ИмяРеквизитаЗаявки, РеквизитЗаявки
	, ИмяРеквизитаРефСцепа, ЗначениеРеквизитаРефСцепа , НеобходимаЗаписьОбъекта)
	
	Если ИзменяемыйОбъект[ИмяРеквизитаРефСцепа] <> РеквизитЗаявки и ЗначениеЗаполнено(РеквизитЗаявки) Тогда
		ИзменяемыйОбъект[ИмяРеквизитаРефСцепа] = РеквизитЗаявки;
        НеобходимаЗаписьОбъекта = Истина;
	КонецЕсли;
	
	Возврат НеобходимаЗаписьОбъекта ;
	
КонецФункции

Функция ПолучитьПоляИзмененияРефСцепаПоЗаявке(Заявка, РефСцепОбъект)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВагоныРефСцепа.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки
		|ПОМЕСТИТЬ вт_КлючиВРефСцепах
		|ИЗ
		|	&тзВагоныРефСцепа КАК ВагоныРефСцепа
		|ГДЕ
		|	ВагоныРефСцепа.КлючАналитикиПеревозки <> ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПеревозки.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РефСцепКонтейнеры.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки
		|ПОМЕСТИТЬ вт_РефСцепКонтейнеры
		|ИЗ
		|	&тзКонтейнеры КАК РефСцепКонтейнеры
		|ГДЕ
		|	РефСцепКонтейнеры.КлючАналитикиПеревозки <> ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПеревозки.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВагоныРефСцепа.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки
		|ПОМЕСТИТЬ КлючиВРефСцепах
		|ИЗ
		|	вт_КлючиВРефСцепах КАК ВагоныРефСцепа
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РефСцепКонтейнеры.КлючАналитикиПеревозки
		|ИЗ
		|	вт_РефСцепКонтейнеры КАК РефСцепКонтейнеры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаявкаСоставУслуги.НомерКТК КАК Контейнер,
		|	ЗаявкаСоставУслуги.Ссылка КАК Заявка,
		|	ЗаявкаСоставУслуги.Ссылка.Отправка КАК Отправка,
		|	ЗаявкаСоставУслуги.Ссылка.Прибытие КАК Прибытие,
		|	ЗаявкаСоставУслуги.СтанцияОтправления КАК СтанцияОтправления,
		|	ЗаявкаСоставУслуги.СтанцияНазначения КАК СтанцияНазначения,
		|	ЗаявкаСоставУслуги.ПринадлежностьТЕ КАК ПринадлежностьКонтейнера,
		|	ЗаявкаСоставУслуги.ВесГрузаНетто КАК ВесКонтейнераНетто,
		|	ЗаявкаСоставУслуги.КоличествоМест КАК КоличествоМестКонтейнера,
		|	ЗаявкаСоставУслуги.Ссылка.Контрагент КАК Клиент,
		|	ЗаявкаСоставУслуги.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки
		|ПОМЕСТИТЬ вт_ЗаявкаСоставУслуги
		|ИЗ
		|	Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
		|ГДЕ
		|	ЗаявкаСоставУслуги.Ссылка = &Ссылка
		|	И ЗаявкаСоставУслуги.КлючАналитикиПеревозки <> ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПеревозки.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ЗаявкаСоставУслуги.Заявка КАК Заявка,
		|	СУММА(ВЫБОР
		|			КОГДА ЕСТЬNULL(КлючиВРефСцепах.КлючАналитикиПеревозки, ЗНАЧЕНИЕ(СПравочник.КлючиАналитикиПеревозки.ПустаяСсылка)) = ЗНАЧЕНИЕ(СПравочник.КлючиАналитикиПеревозки.ПустаяСсылка)
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК КоличествоНеВходящихКлючейЗаявкиВРефСцепе
		|ПОМЕСТИТЬ вт_Заявки
		|ИЗ
		|	вт_ЗаявкаСоставУслуги КАК вт_ЗаявкаСоставУслуги
		|		ЛЕВОЕ СОЕДИНЕНИЕ КлючиВРефСцепах КАК КлючиВРефСцепах
		|		ПО вт_ЗаявкаСоставУслуги.КлючАналитикиПеревозки = КлючиВРефСцепах.КлючАналитикиПеревозки
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_ЗаявкаСоставУслуги.Заявка
		|
		|ИМЕЮЩИЕ
		|	СУММА(ВЫБОР
		|			КОГДА ЕСТЬNULL(КлючиВРефСцепах.КлючАналитикиПеревозки, ЗНАЧЕНИЕ(СПравочник.КлючиАналитикиПеревозки.ПустаяСсылка)) = ЗНАЧЕНИЕ(СПравочник.КлючиАналитикиПеревозки.ПустаяСсылка)
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) = 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаявкаСоставУслуги.НомерКТК КАК Контейнер,
		|	ЗаявкаСоставУслуги.Ссылка.Отправка КАК Отправка,
		|	ЗаявкаСоставУслуги.Ссылка.Прибытие КАК Прибытие,
		|	ЗаявкаСоставУслуги.СтанцияОтправления КАК СтанцияОтправления,
		|	ЗаявкаСоставУслуги.СтанцияНазначения КАК СтанцияНазначения,
		|	ЗаявкаСоставУслуги.ПринадлежностьТЕ КАК ПринадлежностьКонтейнера,
		|	ЗаявкаСоставУслуги.ВесГрузаНетто КАК ВесКонтейнераНетто,
		|	ЗаявкаСоставУслуги.КоличествоМест КАК КоличествоМестКонтейнера,
		|	ЗаявкаСоставУслуги.Ссылка.Контрагент КАК Клиент,
		|	ЗаявкаСоставУслуги.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	ЗаявкаСоставУслуги.Груженый КАК Груженый
		|ИЗ
		|	Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт_Заявки КАК вт_Заявки
		|		ПО ЗаявкаСоставУслуги.Ссылка = вт_Заявки.Заявка";
	
	Запрос.УстановитьПараметр("Ссылка", Заявка);
	Запрос.УстановитьПараметр("тзКонтейнеры", РефСцепОбъект.Контейнеры.Выгрузить());
	Запрос.УстановитьПараметр("тзВагоныРефСцепа", РефСцепОбъект.ВагоныРефСцепа.Выгрузить());
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции	

Процедура ЗаполнитьРеквизитПоЗаявкеКлючейАналитики(РефСцепОбъект, Заявка, ИмяТЧ, НеобходимаЗаписьОбъекта
	, МассивПОлейТЧНаИзменениеПоЗаявке, ДанныеЗаявкиДляИзменения)
	
	тзВыгруженнаяТЧ = РефСцепОбъект[ИмяТЧ].Выгрузить();
	
	Для каждого  СтрДанныеЗаявкиДляИзменения из ДанныеЗаявкиДляИзменения Цикл
		
		мВыгруженнаяТЧ  = тзВыгруженнаяТЧ.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки"
			, СтрДанныеЗаявкиДляИзменения.КлючАналитикиПеревозки));
			
		Для каждого Стр из мВыгруженнаяТЧ Цикл
			Для Каждого ИмяЭлемента из МассивПолейТЧНаИзменениеПоЗаявке Цикл 
				Если не ИмяЭлемента = "СостояниеКонтейнера" Тогда
					НеобходимаЗаписьОбъекта = ПроверитьНаСовпадениеПрисвоитьЗначение(Стр, ИмяЭлемента, СтрДанныеЗаявкиДляИзменения[ИмяЭлемента]
						, ИмяЭлемента, Стр[ИмяЭлемента], НеобходимаЗаписьОбъекта);
				Иначе
					Если СтрДанныеЗаявкиДляИзменения.Груженый 
						и Стр.СостояниеКонтейнера = Перечисления.СостоянияКТК.Порожний Тогда
						НеобходимаЗаписьОбъекта = Истина;
						Стр.СостояниеКонтейнера = Перечисления.СостоянияКТК.Груженый;
					ИначеЕсли не СтрДанныеЗаявкиДляИзменения.Груженый 
						и Стр.СостояниеКонтейнера = Перечисления.СостоянияКТК.Груженый Тогда
						НеобходимаЗаписьОбъекта = Истина;
						Стр.СостояниеКонтейнера = Перечисления.СостоянияКТК.Порожний;						
					КонецЕсли;	
				КонецЕсли;	
			КонецЦикла;		
		КонецЦикла;
		
	КонецЦикла;
	
	РефСцепОбъект[ИмяТЧ].Загрузить(тзВыгруженнаяТЧ);
	
КонецПроцедуры	

// Отложенная запись контейнера из другого реф.сцепа
Функция  ДобавитьКонтейнерИзДругогоРефСцепа(РефСцепОбъект, РефСцепИсходныйСсылка) Экспорт
	
	НеобходимаЗаписьОбъекта = Ложь;

	ДобавитьКонтейнерыИсходногоРефСцепа(РефСцепОбъект
		, РефСцепСервер.ДанныеКонтейнеровИсходногоРефСцепа(
		РефСцепИсходныйСсылка, РефСцепОбъект.Ссылка) 
		, НеобходимаЗаписьОбъекта );
		
	//Если НеобходимаЗаписьОбъекта и ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РефСцепИсходныйСсылка, "ФактическоеОтправление") = Дата(1,1,1)  Тогда
	Если НеобходимаЗаписьОбъекта Тогда
		УдалениеСтрокИсходногоРефСцепа( РефСцепИсходныйСсылка, РефСцепОбъект.Ссылка);	
	КонецЕсли;	
		
	Возврат НеобходимаЗаписьОбъекта;
	
КонецФункции 

Процедура УдалениеСтрокИсходногоРефСцепа(РефСцепИсходныйСсылка, РефСцепОбъектСсылка)
	
	//Субботин 76108 31.10.2023 Начало  убрал неотрабатывающее изменение исходного сцепа, сделал удаление сразу
	//ОтложенноеИзменениеСервер.ПоставитьЗаявкуСделкуПоРефСцепуВОчередьИзменения(
	//	РефСцепИсходныйСсылка, РефСцепОбъектСсылка);
	
	Изменен = Ложь; 
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РефСцепИсходныйСсылка, "ФактическоеОтправление") = Дата(1,1,1)  Тогда
		РефОбъект = РефСцепИсходныйСсылка.ПолучитьОбъект();
		СтруктураДляПоиска = Новый Структура("ПеренесенВРефСцеп", РефСцепОбъектСсылка); 
		СтрокиПодУдаление = РефОбъект.Контейнеры.НайтиСтроки(СтруктураДляПоиска);
		Для каждого СтрокаПодУдаление Из СтрокиПодУдаление Цикл
			Изменен = Истина;
			РефОбъект.Контейнеры.Удалить(СтрокаПодУдаление);
		КонецЦикла;
		
		Если Изменен Тогда
			Если РефОбъект.Проведен Тогда
				Попытка
					РефОбъект.Записать(РежимЗаписиДокумента.Проведение); 
				Исключение
					РефОбъект.Записать();
				КонецПопытки;
			Иначе
				РефОбъект.Записать();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//Субботин 76108 31.10.2023 Конец	
	
КонецПроцедуры 

Процедура ДобавитьКонтейнерыИсходногоРефСцепа(РефСцепОбъект, ДанныеКонтейнеровИсходногоРефСцепа, НеобходимаЗаписьОбъекта)
	
	тзКонтейнеры = РефСцепОбъект.Контейнеры.Выгрузить();
	
	Пока ДанныеКонтейнеровИсходногоРефСцепа.Следующий() Цикл
		НеобходимаЗаписьОбъекта = Истина;
		СтрокаПолучателя = тзКонтейнеры.Найти(ДанныеКонтейнеровИсходногоРефСцепа.КлючАналитикиПеревозки
			, "КлючАналитикиПеревозки");
			
		Если СтрокаПолучателя = Неопределено Тогда
			СтрокаПолучателя = тзКонтейнеры.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПолучателя, ДанныеКонтейнеровИсходногоРефСцепа, , "ПеренесенВРефСцеп, ДопИнформация");
		Иначе
			ЗаполнитьЗначенияСвойств(СтрокаПолучателя, ДанныеКонтейнеровИсходногоРефСцепа, , "ПеренесенВРефСцеп, ДопИнформация");
			СтрокаПолучателя.ПеренесенВРефСцеп = Документы.РефСцеп.ПустаяСсылка();
			//СтрокаПолучателя.ДопИнформация = СтрокаПолучателя.ДопИнформация +
			//	"Был возврат из " + РефСцепОбъект.Номер + " от " + Формат(РефСцепОбъект.Дата, "ДФ=dd.MM.yyyy""");
		КонецЕсли;  
		
		//Евросиб Коханенко Н.А. 07.10.2024 (( #90312
		СтруктураКлючаАналитикиПеревозки = Справочники.КлючиАналитикиПеревозки.СтруктураКлючаАналитикиПеревозки();
		СтруктураКлючаАналитикиПеревозки.КлючАналитики = ДанныеКонтейнеровИсходногоРефСцепа.КлючАналитикиПеревозки;  
		СтруктураКлючаАналитикиПеревозки.РейсРефСцепа = РефСцепОбъект.Ссылка;
		КлючАналитикиПеревозки = Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлючаАналитикиПеревозки);
		//Евросиб Коханенко Н.А. 07.10.2024 )) #90312 
	КонецЦикла;	
			
	Если НеобходимаЗаписьОбъекта Тогда
		РефСцепОбъект.Контейнеры.Загрузить(тзКонтейнеры);
	КонецЕсли;	
			
КонецПроцедуры

#КонецОбласти


#Область Задачи 

Процедура ОбработкаЗадачПриИзмененииОтветственных(РефСцепОбъект) Экспорт
	
	ДанныеОтветственных = ПолучитьДанныеОтветственныхДляЗадач(РефСцепОбъект);
	Если РефСцепОбъект.Состояния.НайтиСтроки(Новый Структура("Состояние, Статус"
		, Справочники.Состояния.НаборГрузовойБазыВРефСцеп
		, Перечисления.СтатусыЭтапов.Выполнен)).Количество()>0 Тогда 
		НайтиСоздатьНовыеЗадачиОтветственным(РефСцепОбъект
					, ДанныеОтветственных.Ответственные
					, ДанныеОтветственных.ВсеДанныеФормыПоОтветственным
					, ДанныеОтветственных.ЗаявкиПОключам);
	КонецЕсли;	

	ОтложенноеПеренесениеСтрокВДругойРефСцеп(ДанныеОтветственных.вт_ДляПеренесенияВДругойРефсцеп, РефСцепОбъект.Ссылка);
	
	// 2.10 Есть сделки заявок	
	ОтложенноеУдалениеСтрокКонтейнеровЗаявокСделок(ДанныеОтветственных.ЗаявкиНаУдалениеКонтейнеров, РефСцепОбъект.Ссылка);
	
	ОтложенноеУдалениеСтрокКонтейнеровЗаявокСделок(ДанныеОтветственных.СделкиНаУдалениеКонтейнеров, РефСцепОбъект.Ссылка);
	
	// 2.10 Нет сделки заявок
	НайтиСоздатьЗадачиУдалениячужихКонтейнеровЗаявокРефСцепа(РефСцепОбъект);
				
	Если РефСцепОбъект.ФактическоеОтправление = Дата(1,1,1) Тогда	
		УдалитьКонтейнерыПеренесенныеВДругойРефСцеп(РефСцепОбъект, ДанныеОтветственных.вт_НаУдалениеИзРефСцепаПослеУдаленияИзЗаявок);	
	КонецЕсли;	
			
КонецПроцедуры

Функция ПолучитьДанныеОтветственныхДляЗадач(РефСцепОбъект)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РефСцепВагоныРефСцепа.Клиент КАК Клиент,
		|	РефСцепВагоныРефСцепа.Ответственный КАК Ответственный,
		|	РефСцепВагоныРефСцепа.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	РефСцепВагоныРефСцепа.ПеренесенВРефСцеп КАК ПеренесенВРефСцеп,
		|	РефСцепВагоныРефСцепа.Контейнер КАК Контейнер
		|ПОМЕСТИТЬ вт_ОтветственныеВагоны
		|ИЗ
		|	&тзВагоныРефСцепа КАК РефСцепВагоныРефСцепа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РефСцепКонтейнеры.Клиент КАК Клиент,
		|	РефСцепКонтейнеры.Ответственный КАК Ответственный,
		|	РефСцепКонтейнеры.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	РефСцепКонтейнеры.ПеренесенВРефСцеп КАК ПеренесенВРефСцеп,
		|	РефСцепКонтейнеры.Контейнер КАК Контейнер
		|ПОМЕСТИТЬ вт_ОтветственныеКонтейнеры
		|ИЗ
		|	&тзКонтейнеры КАК РефСцепКонтейнеры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ОтветственныеВагоны.Клиент КАК Клиент,
		|	вт_ОтветственныеВагоны.Ответственный КАК Ответственный,
		|	вт_ОтветственныеВагоны.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	вт_ОтветственныеВагоны.ПеренесенВРефСцеп КАК ПеренесенВРефСцеп,
		|	вт_ОтветственныеВагоны.Контейнер КАК Контейнер
		|ПОМЕСТИТЬ вт_ОтветственныеКлиентов
		|ИЗ
		|	вт_ОтветственныеВагоны КАК вт_ОтветственныеВагоны
		|ГДЕ
		|	вт_ОтветственныеВагоны.Контейнер <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	вт_ОтветственныеКонтейнеры.Клиент,
		|	вт_ОтветственныеКонтейнеры.Ответственный,
		|	вт_ОтветственныеКонтейнеры.КлючАналитикиПеревозки,
		|	вт_ОтветственныеКонтейнеры.ПеренесенВРефСцеп,
		|	вт_ОтветственныеКонтейнеры.Контейнер
		|ИЗ
		|	вт_ОтветственныеКонтейнеры КАК вт_ОтветственныеКонтейнеры
		|ГДЕ
		|	вт_ОтветственныеКонтейнеры.Контейнер <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(вт_ОтветственныеКлиентов.Клиент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Клиент,
		|	ЕСТЬNULL(вт_ОтветственныеКлиентов.Ответственный, ЗНАЧЕНИЕ(Справочник.ПОльзователи.ПустаяСсылка)) КАК Ответственный,
		|	ЕСТЬNULL(вт_ОтветственныеКлиентов.КлючАналитикиПеревозки, ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПеревозки.ПустаяСсылка)) КАК КлючАналитикиПеревозки,
		|	ЕСТЬNULL(вт_ОтветственныеКлиентов.ПеренесенВРефСцеп, ЗНАЧЕНИЕ(Документ.РефСцеп.ПустаяСсылка)) КАК ПеренесенВРефСцеп,
		|	ЕСТЬNULL(вт_ОтветственныеКлиентов.Контейнер, ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)) КАК Контейнер
		|ПОМЕСТИТЬ вт_ДанныеФормы
		|ИЗ
		|	вт_ОтветственныеКлиентов КАК вт_ОтветственныеКлиентов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ОтветственныеКлиентов.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	вт_ОтветственныеКлиентов.Клиент КАК Клиент,
		|	вт_ОтветственныеКлиентов.Ответственный КАК Ответственный,
		|	вт_ОтветственныеКлиентов.Контейнер КАК Контейнер,
		|	вт_ОтветственныеКлиентов.ПеренесенВРефСцеп КАК ПеренесенВРефСцеп,
		|	Контрагенты.Наименование КАК КлиентНаименование,
		|	ТЕ.Наименование КАК КонтейнерНаименование
		|ИЗ
		|	вт_ОтветственныеКлиентов КАК вт_ОтветственныеКлиентов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|		ПО вт_ОтветственныеКлиентов.Клиент = Контрагенты.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТЕ КАК ТЕ
		|		ПО вт_ОтветственныеКлиентов.Контейнер = ТЕ.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	вт_ДанныеФормы.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	ЗаявкаСоставУслуги.Ссылка КАК Заявка,
		|	ЗаявкаСоставУслуги.ПеренесенВЗаявку КАК ПеренесенВЗаявку,
		|	вт_ДанныеФормы.Контейнер КАК Контейнер,
		|	вт_ДанныеФормы.ПеренесенВРефСцеп КАК ПеренесенВРефСцеп
		|ПОМЕСТИТЬ вт_Заявки
		|ИЗ
		|	вт_ДанныеФормы КАК вт_ДанныеФормы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
		|		ПО вт_ДанныеФормы.КлючАналитикиПеревозки = ЗаявкаСоставУслуги.КлючАналитикиПеревозки
		|			И (ЗаявкаСоставУслуги.Ссылка.ПометкаУдаления = ЛОЖЬ)
		|			И (ЕСТЬNULL(вт_ДанныеФормы.КлючАналитикиПеревозки, ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПеревозки.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПеревозки.ПустаяСсылка))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(СделкаСвязьУчетныхЕдиниц.Ссылка, ЗНАЧЕНИЕ(Документ.Сделка.Пустаяссылка)) КАК Сделка,
		|	ЕСТЬNULL(СделкаСвязьУчетныхЕдиниц.Заявка, ЗНАЧЕНИЕ(Документ.Заявка.Пустаяссылка)) КАК Заявка,
		|	СделкаСвязьУчетныхЕдиниц.Контейнер КАК Контейнер,
		|	вт_ДанныеФормы.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	вт_ДанныеФормы.ПеренесенВРефСцеп КАК ПеренесенВРефСцеп,
		|	вт_Заявки.ПеренесенВЗаявку КАК ПеренесенВЗаявку
		|ПОМЕСТИТЬ вт_ЗаявкиСоСделкамиРефСцепа
		|ИЗ
		|	вт_ДанныеФормы КАК вт_ДанныеФормы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
		|		ПО вт_ДанныеФормы.Контейнер = СделкаСвязьУчетныхЕдиниц.Контейнер
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт_Заявки КАК вт_Заявки
		|		ПО вт_ДанныеФормы.КлючАналитикиПеревозки = вт_Заявки.КлючАналитикиПеревозки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_СделкиЗаявкиНаОтложенноеУдаление.Сделка КАК Сделка,
		|	вт_СделкиЗаявкиНаОтложенноеУдаление.Заявка КАК Заявка,
		|	вт_СделкиЗаявкиНаОтложенноеУдаление.Контейнер КАК Контейнер,
		|	вт_СделкиЗаявкиНаОтложенноеУдаление.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	вт_СделкиЗаявкиНаОтложенноеУдаление.ПеренесенВЗаявку КАК ПеренесенВЗаявку
		|ПОМЕСТИТЬ вт_СделкиЗаявкиНаОтложенноеУдаление
		|ИЗ
		|	вт_ЗаявкиСоСделкамиРефСцепа КАК вт_СделкиЗаявкиНаОтложенноеУдаление
		|ГДЕ
		|	вт_СделкиЗаявкиНаОтложенноеУдаление.ПеренесенВРефСцеп <> ЗНАЧЕНИЕ(Документ.РефСцеп.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	вт_Заявки.Заявка КАК ОбрабатываемыйОбъектСсылка,
		|	вт_Заявки.Заявка КАК Заявка
		|ИЗ
		|	вт_Заявки КАК вт_Заявки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт_СделкиЗаявкиНаОтложенноеУдаление КАК вт_СделкиЗаявкиНаОтложенноеУдаление
		|		ПО вт_Заявки.Заявка = вт_СделкиЗаявкиНаОтложенноеУдаление.ПеренесенВЗаявку
		|			И вт_Заявки.КлючАналитикиПеревозки = вт_СделкиЗаявкиНаОтложенноеУдаление.КлючАналитикиПеревозки
		|ГДЕ
		|	вт_СделкиЗаявкиНаОтложенноеУдаление.Сделка <> ЗНАЧЕНИЕ(Документ.Сделка.ПустаяСсылка)
		|	И вт_СделкиЗаявкиНаОтложенноеУдаление.ПеренесенВЗаявку <> ЗНАЧЕНИЕ(Документ.Заявка.ПустаяСсылка)
		|	И вт_Заявки.Заявка <> &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	вт_СделкиЗаявкиНаОтложенноеУдаление.Сделка КАК ОбрабатываемыйОбъектСсылка,
		|	вт_СделкиЗаявкиНаОтложенноеУдаление.Заявка КАК Заявка
		|ИЗ
		|	вт_СделкиЗаявкиНаОтложенноеУдаление КАК вт_СделкиЗаявкиНаОтложенноеУдаление
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт_Заявки КАК вт_Заявки
		|		ПО вт_СделкиЗаявкиНаОтложенноеУдаление.Заявка = вт_Заявки.Заявка
		|			И вт_СделкиЗаявкиНаОтложенноеУдаление.КлючАналитикиПеревозки = вт_Заявки.КлючАналитикиПеревозки
		|ГДЕ
		|	вт_СделкиЗаявкиНаОтложенноеУдаление.Сделка <> ЗНАЧЕНИЕ(Документ.Сделка.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	вт_Заявки.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	вт_Заявки.Заявка КАК Заявка,
		|	вт_Заявки.Заявка.ДокументОснование КАК ЗаявкаДокументОснование,
		|	вт_Заявки.Контейнер КАК Контейнер
		|ИЗ
		|	вт_Заявки КАК вт_Заявки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	вт_ДанныеФормы.Ответственный КАК Ответственный
		|ИЗ
		|	вт_ДанныеФормы КАК вт_ДанныеФормы
		|ГДЕ
		|	вт_ДанныеФормы.Ответственный <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	вт_Заявки.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	вт_Заявки.Заявка.ОтветственныйМенеджер КАК ЗаявкаОтветственныйМенеджер,
		|	вт_Заявки.Заявка КАК Заявка,
		|	вт_Заявки.Контейнер КАК Контейнер
		|ИЗ
		|	вт_Заявки КАК вт_Заявки
		|		ЛЕВОЕ СОЕДИНЕНИЕ вт_ЗаявкиСоСделкамиРефСцепа КАК вт_ЗаявкиСоСделкамиРефСцепа
		|		ПО вт_Заявки.Заявка = вт_ЗаявкиСоСделкамиРефСцепа.Заявка
		|ГДЕ
		|	ЕСТЬNULL(вт_ЗаявкиСоСделкамиРефСцепа.Заявка, ЗНАЧЕНИЕ(Документ.Заявка.ПустаяСсылка)) = ЗНАЧЕНИЕ(Документ.Заявка.ПустаяСсылка)
		|	И вт_Заявки.ПеренесенВРефСцеп <> ЗНАЧЕНИЕ(Документ.РефСцеп.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РефСцепКонтейнеры.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	вт_ДанныеФормы.ПеренесенВРефСцеп КАК ПеренесенВРефСцеп
		|ПОМЕСТИТЬ вт_КлючиАналитикиПеренесенных
		|ИЗ
		|	Документ.РефСцеп.Контейнеры КАК РефСцепКонтейнеры
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт_ДанныеФормы КАК вт_ДанныеФормы
		|		ПО РефСцепКонтейнеры.Ссылка = вт_ДанныеФормы.ПеренесенВРефСцеп
		|			И РефСцепКонтейнеры.КлючАналитикиПеревозки = вт_ДанныеФормы.КлючАналитикиПеревозки
		|ГДЕ
		|	РефСцепКонтейнеры.ПеренесенВРефСцеп = ЗНАЧЕНИЕ(Документ.РефСцеп.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	вт_ДанныеФормы.ПеренесенВРефСцеп КАК ПеренесенВРефСцеп
		|ИЗ
		|	вт_ДанныеФормы КАК вт_ДанныеФормы
		|		ЛЕВОЕ СОЕДИНЕНИЕ вт_КлючиАналитикиПеренесенных КАК вт_КлючиАналитикиПеренесенных
		|		ПО вт_ДанныеФормы.КлючАналитикиПеревозки = вт_КлючиАналитикиПеренесенных.КлючАналитикиПеревозки
		|			И вт_ДанныеФормы.ПеренесенВРефСцеп = вт_КлючиАналитикиПеренесенных.ПеренесенВРефСцеп
		|ГДЕ
		|	вт_ДанныеФормы.ПеренесенВРефСцеп <> ЗНАЧЕНИЕ(Документ.РефСцеп.ПустаяСсылка)
		|	И ЕСТЬNULL(вт_КлючиАналитикиПеренесенных.КлючАналитикиПеревозки, ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПеревозки.Пустаяссылка)) = ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПеревозки.Пустаяссылка)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	РефСцепКонтейнеры.Ссылка
		|ИЗ
		|	Документ.РефСцеп.Контейнеры КАК РефСцепКонтейнеры
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт_ДанныеФормы КАК вт_ДанныеФормы
		|		ПО РефСцепКонтейнеры.Ссылка = вт_ДанныеФормы.ПеренесенВРефСцеп
		|			И РефСцепКонтейнеры.КлючАналитикиПеревозки = вт_ДанныеФормы.КлючАналитикиПеревозки
		|ГДЕ
		|	РефСцепКонтейнеры.ПеренесенВРефСцеп = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", РефСцепОбъект.Ссылка);
	Запрос.УстановитьПараметр("тзВагоныРефСцепа", РефСцепОбъект.ВагоныРефСцепа.Выгрузить());
	Запрос.УстановитьПараметр("тзКонтейнеры", РефСцепОбъект.Контейнеры.Выгрузить());
	
	Результат = Запрос.ВыполнитьПакет();
	
	ВозВрат Новый Структура("ВсеДанныеФормыПоОтветственным, ЗаявкиНаУдалениеКонтейнеров, СделкиНаУдалениеКонтейнеров
		| , ЗаявкиПоКлючам, Ответственные , вт_НаУдалениеИзРефСцепаПослеУдаленияИзЗаявок, вт_ДляПеренесенияВДругойРефсцеп"
		, Результат[4].Выгрузить()
		, Результат[8].Выбрать()
		, Результат[9].Выбрать()
		, Результат[10].Выгрузить()
		, Результат[11].Выбрать()
		, Результат[12].Выгрузить()
		, Результат[14].Выбрать());      
	
КонецФункции 

Процедура НайтиСоздатьНовыеЗадачиОтветственным(РефСцепОбъект
										, Ответственные
										, ВсеДанныеФормыПоОтветственным
										, ЗаявкиПоКлючам) 

	ОтветственныйПустой 			 = Справочники.Пользователи.ПустаяСсылка();
	СтатусВыполнен					 = Перечисления.СтатусыЭтапов.Выполнен;
	МассивСостоянийНаСозданиеЗаявки  = РефСцепСервер.МассивОднотипныхСостояний("СоздатьЗаявкиНаКТКИзРефСцепа");
	ПустойКлючАналитики              = Справочники.КлючиАналитикиПеревозки.ПустаяСсылка();
	Наблюдатель						 = Справочники.ГруппыПользователей.РуководительГруппыРефрижераторныхПеревозок;
	
	Пока Ответственные.Следующий() Цикл
		
		МассивКомментария = Новый Массив;

		мСтрокиОтветственных = ВсеДанныеФормыПоОтветственным.НайтиСтроки(
			Новый Структура("Ответственный", Ответственные.Ответственный));
			
		Для Каждого СтрОтв из мСтрокиОтветственных Цикл 
			Если СтрОтв.Ответственный = ОтветственныйПустой Тогда 
				Продолжить;
			КонецЕсли;	
			Если ЗначениеЗаполнено(СтрОтв.ПеренесенВРефСцеп) Тогда 
				Продолжить; 
			КонецЕсли;                       
			Если ЗаявкиПоКлючам.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки"
					, СтрОтв.КлючАналитикиПеревозки)).Количество() > 0 Тогда 
				Продолжить; 
			КонецЕсли;                       
			
			МассивКомментария.Добавить(СтрОтв.КлиентНаименование + ":" + СтрОтв.КонтейнерНаименование);
			
		КонецЦикла;
		
		ЗадачиОтветственным = РефСцепОбъект.Состояния.НайтиСтроки(Новый Структура("Исполнитель"
			, Ответственные.Ответственный));
		
		ЕстьЗадачиОтветственногоПоСозданиюЗаявок = Ложь;	
		Если ЗадачиОтветственным.Количество()>0 Тогда
			Для Каждого СтрЗадачи Из ЗадачиОтветственным Цикл
				Если МассивСостоянийНаСозданиеЗаявки.Найти(СтрЗадачи.Состояние)= Неопределено Тогда Продолжить; КонецЕсли;	
				//Если СтрЗадачи.Статус = СтатусВыполнен ТОгда ПРодолжить; КонецЕсли;
				ЕстьЗадачиОтветственногоПоСозданиюЗаявок = Истина;
				Комментарий = стрСоединить(МассивКомментария, ", ");	
				Если МассивКомментария.Количество() > 0  Тогда
					СтрЗадачи.Исполнитель = Ответственные.Ответственный;
					СтрЗадачи.Комментарий = Комментарий;
					СтрЗадачи.Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;	
		Если (не ЕстьЗадачиОтветственногоПоСозданиюЗаявок и не ЗадачиОтветственным.Количество() > 0)
			или не ЗадачиОтветственным.Количество() > 0 Тогда
			Если МассивКомментария.Количество() > 0 Тогда
				НоваяЗадача = РефСцепОбъект.Состояния.Добавить();
				НоваяЗадача.Исполнитель = Ответственные.Ответственный;
				НоваяЗадача.Наблюдатель = ?(Наблюдатель = Справочники.Пользователи.ПустаяСсылка()
					, РефСцепОбъект.Автор, Наблюдатель);
				НоваяЗадача.Статус		= Перечисления.СтатусыЭтапов.НаВыполнение;
				НоваяЗадача.ВидНормативаИсполнения = Перечисления.ВидыНормативовИспользования.ЧасовСМоментаСозданияДокумента;
				НоваяЗадача.Состояние	= РефСцепСервер.ОчередноеСостояниеОдинаковых(
					РефСцепОбъект.Состояния.Выгрузить().ВыгрузитьКолонку("Состояние"), "СоздатьЗаявкиНаКТКИзРефСцепа");
				НоваяЗадача.Комментарий = стрСоединить(МассивКомментария, ", "); 
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
	УдалениеЗадачОтветственным(РефСцепОбъект, МассивСостоянийНаСозданиеЗаявки);
	
    ЗакрытиеЗадачПоОтветственным(РефСцепОбъект, МассивСостоянийНаСозданиеЗаявки);

КонецПроцедуры

Процедура УдалениеЗадачОтветственным(РефСцепОбъект, МассивСостоянийНаСозданиеЗаявки)
	
	// Удаляем задачи удаленных отвественных если состояние не равно Заполнение грузовой базы или обновить данные реф.сцепа
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РефСцепВагоныРефСцепа.Ответственный КАК Ответственный
		|ПОМЕСТИТЬ вт_ОтветственныеПоКлючам01
		|ИЗ
		|	&тзВагоны КАК РефСцепВагоныРефСцепа
		|ГДЕ
		|	РефСцепВагоныРефСцепа.ПеренесенВРефСцеп = ЗНАЧЕНИЕ(Документ.Рефсцеп.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РефСцепКонтейнеры.Ответственный КАК Ответственный
		|ПОМЕСТИТЬ вт_ОтветственныеПоКлючам02
		|ИЗ
		|	&тзКонтейнеры КАК РефСцепКонтейнеры
		|ГДЕ
		|	РефСцепКонтейнеры.ПеренесенВРефСцеп = ЗНАЧЕНИЕ(Документ.Рефсцеп.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ОтветственныеПоКлючам01.Ответственный КАК Ответственный
		|ПОМЕСТИТЬ вт_ОтветственныеПоКлючам
		|ИЗ
		|	вт_ОтветственныеПоКлючам01 КАК вт_ОтветственныеПоКлючам01
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	вт_ОтветственныеПоКлючам02.Ответственный
		|ИЗ
		|	вт_ОтветственныеПоКлючам02 КАК вт_ОтветственныеПоКлючам02
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РефСцепСостояния.Исполнитель КАК Исполнитель
		|ПОМЕСТИТЬ вт_Состояния
		|ИЗ
		|	&тзСостояния КАК РефСцепСостояния
		|ГДЕ
		|	РефСцепСостояния.Состояние В(&МассивСостоянийНаСозданиеЗаявки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РефСцепСостояния.Исполнитель КАК Исполнитель,
		|	вт_ОтветственныеПоКлючам.Ответственный КАК Ответственный
		|ИЗ
		|	вт_Состояния КАК РефСцепСостояния
		|		ЛЕВОЕ СОЕДИНЕНИЕ вт_ОтветственныеПоКлючам КАК вт_ОтветственныеПоКлючам
		|		ПО РефСцепСостояния.Исполнитель = вт_ОтветственныеПоКлючам.Ответственный
		|ГДЕ
		|	ЕСТЬNULL(вт_ОтветственныеПоКлючам.Ответственный, ЗНАЧЕНИЕ(Справочник.ПОльзователи.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.ПОльзователи.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("тзВагоны", РефСцепОбъект.ВагоныРефСцепа.Выгрузить()); 
	Запрос.УстановитьПараметр("тзКонтейнеры", РефСцепОбъект.Контейнеры.Выгрузить());
	Запрос.УстановитьПараметр("тзСостояния", РефСцепОбъект.Состояния.Выгрузить());
	Запрос.УстановитьПараметр("МассивСостоянийНаСозданиеЗаявки", МассивСостоянийНаСозданиеЗаявки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		мСостояния = РефСцепОбъект.Состояния.НайтиСТроки(Новый Структура("Исполнитель", ВыборкаДетальныеЗаписи.Исполнитель));
		Для каждого Стр из мСостояния Цикл
			РефСцепОбъект.Состояния.Удалить(Стр);
		КонецЦикла;	
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗакрытиеЗадачПоОтветственным(РефСцепОбъект, МассивСостоянийНаСозданиеЗаявки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РефСцепВагоныРефСцепа.Ответственный КАК Ответственный,
		|	РефСцепВагоныРефСцепа.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки
		|ПОМЕСТИТЬ вт_ОтветственныеПоКлючам01
		|ИЗ
		|	&тзВагоны КАК РефСцепВагоныРефСцепа
		|ГДЕ
		|	РефСцепВагоныРефСцепа.ПеренесенВРефСцеп = ЗНАЧЕНИЕ(Документ.Рефсцеп.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РефСцепКонтейнеры.Ответственный КАК Ответственный,
		|	РефСцепКонтейнеры.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки
		|ПОМЕСТИТЬ вт_ОтветственныеПоКлючам02
		|ИЗ
		|	&тзКонтейнеры КАК РефСцепКонтейнеры
		|ГДЕ
		|	РефСцепКонтейнеры.ПеренесенВРефСцеп = ЗНАЧЕНИЕ(Документ.Рефсцеп.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ОтветственныеПоКлючам01.Ответственный КАК Ответственный,
		|	вт_ОтветственныеПоКлючам01.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки
		|ПОМЕСТИТЬ вт_ОтветственныеПоКлючам
		|ИЗ
		|	вт_ОтветственныеПоКлючам01 КАК вт_ОтветственныеПоКлючам01
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	вт_ОтветственныеПоКлючам02.Ответственный,
		|	вт_ОтветственныеПоКлючам02.КлючАналитикиПеревозки
		|ИЗ
		|	вт_ОтветственныеПоКлючам02 КАК вт_ОтветственныеПоКлючам02
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_ОтветственныеПоКлючам.Ответственный КАК Ответственный
		|ИЗ
		|	вт_ОтветственныеПоКлючам КАК вт_ОтветственныеПоКлючам
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
		|		ПО вт_ОтветственныеПоКлючам.КлючАналитикиПеревозки = ЗаявкаСоставУслуги.КлючАналитикиПеревозки
		//|			И (ЗаявкаСоставУслуги.Ссылка.ДокументОснование = &РефСцепСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	вт_ОтветственныеПоКлючам.Ответственный
		|
		|ИМЕЮЩИЕ
		|	СУММА(ВЫБОР
		|			КОГДА ЕСТЬNULL(ЗаявкаСоставУслуги.Ссылка, ЗНАЧЕНИЕ(Документ.Заявка.ПустаяСсылка)) = ЗНАЧЕНИЕ(Документ.Заявка.ПустаяСсылка)
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) = 0";
	
	Запрос.УстановитьПараметр("тзВагоны", РефСцепОбъект.ВагоныРефСцепа.Выгрузить()); 
	Запрос.УстановитьПараметр("тзКонтейнеры", РефСцепОбъект.Контейнеры.Выгрузить());
	Запрос.УстановитьПараметр("РефСцепСсылка", РефСцепОбъект.Ссылка); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		мСостояния = РефСцепОбъект.Состояния.НайтиСТроки(Новый Структура("Исполнитель", ВыборкаДетальныеЗаписи.Ответственный));
		Для каждого Стр из мСостояния Цикл
			Если не Стр.Статус = Перечисления.СтатусыЭтапов.Выполнен 
				и не МассивСостоянийНаСозданиеЗаявки.Найти(Стр.Состояние)=Неопределено Тогда
				Стр.Статус = Перечисления.СтатусыЭтапов.Выполнен;
			КонецЕсли;	
		КонецЦикла;	
	КонецЦикла;
	
	РефСцепОбъект.Состояния.Загрузить(СдвигНевыполненныхСостоянийВКонецСписка(РефСцепОбъект.Состояния.Выгрузить()));
	
КонецПроцедуры	

Процедура ОтложенноеПеренесениеСтрокВДругойРефСцеп(вт_ДляПеренесенияВДругойРефсцеп, РефСцепОбъектСсылка)
	Пока вт_ДляПеренесенияВДругойРефсцеп.Следующий() Цикл
		ОтложенноеИзменениеСервер.ПоставитьРефСцепВОчередьИзменения(
			вт_ДляПеренесенияВДругойРефсцеп.ПеренесенВРефСцеп, РефСцепОбъектСсылка);
	КонецЦикла;	

КонецПроцедуры	

Процедура ОтложенноеУдалениеСтрокКонтейнеровЗаявокСделок(ВыборкаЗаявокСделок, РефСцепОбъектСсылка) 
	Пока ВыборкаЗаявокСделок.Следующий() Цикл
		ОтложенноеИзменениеСервер.ПоставитьЗаявкуСделкуПоРефСцепуВОчередьИзменения(
					ВыборкаЗаявокСделок.ОбрабатываемыйОбъектСсылка, РефСцепОбъектСсылка);
	КонецЦикла;	
