
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	#Область ТиповойФункционалДокументов

	Автор 			 = Пользователи.ТекущийПользователь();
	ЦФО 			 = Автор.ЦФО;
	Подразделение    = Автор.Подразделение;
	Организация 	 = Константы.ОсновнаяОрганизация.Получить();
	Создано 		 = ТекущаяДата();
	Маршрутизировать = Константы.МаршрутизироватьРефСцеп.Получить();
	
	
	#КонецОбласти
	
	#Область ПервоначальноеЗаполнение
	Если ТипЗнч(ДанныеЗаполнения) <> Тип("СправочникСсылка.РефСцепы") Тогда 
         ВызватьИсключение "Создание документа возможно только из регистра Вагоны реф.сцепов!"; 
	КонецЕсли;	
	
	
	Если не ЗначениеЗаполнено(ДанныеЗаполнения) Тогда 
         ВызватьИсключение "Не заполнен Реф.сцеп. Обратитесь к администратору системы!";
	КонецЕсли;	 
	
	РефСцеп = ДанныеЗаполнения;
	
	ДанныеПоВагонамРефСцепаРегистра = РефСцепСервер
		.ПолучитьДанныеПоВагонамРефСцепаРегистра(РефСцеп);
	
	ВагоныРефСцепа.Загрузить(РефСцепСервер
		.ПолучитьДанныеДислокацииВагоновРефСцепа(ДанныеПоВагонамРефСцепаРегистра)); 
		
		
	// Добавление ДГК 	
	ВыборкаКонтейнерДГК = РефСцепСервер.ПолучитьДанныеДГКВагоновРефСцепа(ДанныеПоВагонамРефСцепаРегистра, РефСцеп);
	КлиентДирекцияЕвросиб = Константы.КонтрагентДирекцияКонтейнерныхПеревозок.Получить();
	Если ВыборкаКонтейнерДГК <> Неопределено Тогда	
		Пока ВыборкаКонтейнерДГК.Следующий() Цикл
			СтрокаДГК = ВагоныРефСцепа.Найти(ВыборкаКонтейнерДГК.Вагон, "Вагон");
			ЗаполнитьЗначенияСвойств(СтрокаДГК, ВыборкаКонтейнерДГК);
			СтрокаДГК.Клиент 	               = КлиентДирекцияЕвросиб;
			СтрокаДГК.Ответственный            = Автор;
			СтрокаДГК.ПринадлежностьКонтейнера = Перечисления.ПринадлежностьТЕ.КТЕвросиба;
			СтрокаДГК.КлючАналитикиПеревозки   = РефСцепСервер.НайтиСоздатьКлючАналитикиПеревозки(СтрокаДГК.Контейнер);

			ТанкКонтейнер = РефСцепСервер.ПолучитьТанкКонтейнерНаСервере(СтрокаДГК.Контейнер);
			Если ТанкКонтейнер <> Справочники.ТЕ.ПустаяСсылка() Тогда
				НоваяСтрока = ВагоныРефСцепа.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДГК, "Вагон,  
				|ПорядковыйНомерВСцепе,
				|ПотребовалсяПодсылПорожнегоВагона,
				|СтанцияОтправленияПодсыла,
				|ПризнакВагона,
				|ЖДНакладная",
				"КлючАналитикиПеревозки"); 
				НоваяСтрока.Контейнер 	 	         = ТанкКонтейнер;
				НоваяСтрока.ЭтоТанкКонтейнер         = Истина;
				НоваяСтрока.Клиент 	                 = КлиентДирекцияЕвросиб;
				НоваяСтрока.Ответственный            = Автор;
				НоваяСтрока.ПринадлежностьКонтейнера = Перечисления.ПринадлежностьТЕ.КТЕвросиба;
				НоваяСтрока.КлючАналитикиПеревозки   = РефСцепСервер.НайтиСоздатьКлючАналитикиПеревозки(НоваяСтрока.Контейнер);
				
			КонецЕсли;	
			
		КонецЦикла;	
    КонецЕсли;
	#КонецОбласти
	

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если РейсЗавершен и Контейнеры.Количество() > 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю
			("Необходимо удалить/перенести контейнеры нижней табличной части из расформированного реф. сцепа");	
	КонецЕсли;
	
	Редактор = Пользователи.ТекущийПользователь();
	Изменено = ТекущаяДата();  
	
	// проверяем корректность перечня состояний в ТЧ Состояния
	Если СогласованиеСервер.ЕстьДублиСостояний(Состояния.Выгрузить()) Тогда
		Сообщить("Ошибка: одно состояние может встречаться в документе только один раз!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения
		или РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Если РейсЗавершен и НетКонтейнеровПривязанныхКВагонам() Тогда
			Сообщить("Реф. сцеп расформирован. Дальнейшая работа с документом невозможна. При наличии контейнеров перенесите их в другой Реф. сцеп");
			Отказ = Истина;
		КонецЕсли;	

	КонецЕсли;
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		ПроверкаПередПроведением(Отказ);
		
	ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Если ЕстьКонтейнерыВЗаявках() Тогда
			Сообщить("Отмена проведения невозможна. Есть контейнеры в заявках. Перенесите контейнеры в другой реф.сцеп и повторите операцию");
			Отказ = Истина;	
		КонецЕсли;	
	КонецЕсли; 
	
	// убрать после отладки
	Маршрутизировать = Константы.МаршрутизироватьРефСцеп.Получить();

	// Маршрутизация заявки
	//МаршрутизацияСервер.ПараллельноеСогласование(Состояния); //ДИТ, Беляев СЮ, Ticket#0344187, 06-03-2024, закомментировал (перенёс ниже)
	
	ДляДанногоОбъектаТребуетсяПеремаршрутизация = МаршрутизацияСервер.ТребуетсяПеремаршрутизацияДляОбъекта(ЭтотОбъект); 
	
	Если Маршрутизировать И ДляДанногоОбъектаТребуетсяПеремаршрутизация Тогда
		ПараметрыЗапроса = Документы.РефСцеп.ПолучитьПараметрыМаршрутизации(ЭтотОбъект);
		РезультатЗапроса = МаршрутизацияСервер.МаршрутизироватьРефСцеп(ПараметрыЗапроса, Дата);
		Если РезультатЗапроса.Количество() > 0 Тогда
			УказанныеВручнуюИспНаблюдатель = Новый СписокЗначений;
			Если ДополнительныеСвойства.Свойство("ДопСвойстваОбъекта") тогда
				УказанныеВручнуюИспНаблюдатель = ДополнительныеСвойства.ДопСвойстваОбъекта;
			КонецЕсли;
			МаршрутизацияСервер.ПрименитьМаршрут(ЭтотОбъект, РезультатЗапроса, Автор, УказанныеВручнуюИспНаблюдатель);			
		КонецЕсли;
		
	КонецЕсли;
	
	//ДИТ, Беляев СЮ, Ticket#0344187, 06-03-2024, начало
	МаршрутизацияСервер.ПараллельноеСогласование(Состояния);
	//ДИТ, Беляев СЮ, Ticket#0344187, 06-03-2024, конец
	
	Для каждого Стр из Состояния Цикл
		Если Стр.ПримечаниеЗадачаИсполнителю Тогда
			// если текст примечания изменился, то создать новое сообщение. если остался прежним, то не менять
			// т.к. состояние уникально, ищем по нему
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Состояние",Стр.Состояние);
			НайденнаяСтр = Ссылка.Состояния.НайтиСтроки(ПараметрыОтбора);
			Если НайденнаяСтр.Количество()>0 Тогда
				Если НЕ НайденнаяСтр[0].Комментарий = Стр.Комментарий Тогда
					
					// +Шейко ОЕ [Ticket#0204385] Личные сообщения пользователям
					ДатаСообщения = ТекущаяДата();
					АвторСообщения = Пользователи.ТекущийПользователь();
					ТекстСообщения = Стр.Комментарий;
					ГУИДСообщения = Новый УникальныйИдентификатор();
					
					ГУИДТемы = Новый УникальныйИдентификатор;
					
					РассылкаПоЛичнымЦелям.СформироватьЛичноеСообщение(ГУИДТемы, , Ссылка, ДатаСообщения, АвторСообщения, ТекстСообщения, , ГУИДСообщения, Стр.Исполнитель);
					// -Шейко ОЕ [Ticket#0204385] Личные сообщения пользователям
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Документы.РефСцеп.ОбработкаЗадачПриИзмененииОтветственных(ЭтотОбъект);
	
	МаршрутизацияСервер.ПостобработкаТЧСостояний(ЭтотОбъект, Автор);
	
	
КонецПроцедуры

Процедура ПриЗаписи()
	
	ПоставитьЗаявкиПодбораВОчередьНаИзменение(); 
	
	//Евросиб Коханенко Н.А. 16.09.2024 (( #90312 
	Если ПометкаУдаления Тогда
		Для Каждого Стр Из ВагоныРефСцепа Цикл
			Если НЕ ЗначениеЗаполнено(Стр.ПеренесенВРефСцеп) Тогда //для перенесенных КТК ссылку на реф в ключах не затираем
				СтруктураКлючаАналитикиПеревозки = Справочники.КлючиАналитикиПеревозки.СтруктураКлючаАналитикиПеревозки();
				СтруктураКлючаАналитикиПеревозки.КлючАналитики = Стр.КлючАналитикиПеревозки; 
				СтруктураКлючаАналитикиПеревозки.РейсРефСцепа = Справочники.КлючиАналитикиПеревозки.ПустаяСсылка();
				КлючАналитикиПеревозки = Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлючаАналитикиПеревозки);
			КонецЕсли;
		КонецЦикла;
	
		Для Каждого Стр Из Контейнеры Цикл
			Если НЕ ЗначениеЗаполнено(Стр.ПеренесенВРефСцеп) Тогда //для перенесенных КТК  ссылку на реф в ключах не затираем
				СтруктураКлючаАналитикиПеревозки = Справочники.КлючиАналитикиПеревозки.СтруктураКлючаАналитикиПеревозки();
				СтруктураКлючаАналитикиПеревозки.КлючАналитики = Стр.КлючАналитикиПеревозки;  
				СтруктураКлючаАналитикиПеревозки.РейсРефСцепа = Справочники.КлючиАналитикиПеревозки.ПустаяСсылка();
				КлючАналитикиПеревозки = Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлючаАналитикиПеревозки);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	//Евросиб Коханенко Н.А. 16.09.2024 )) #90312 
	
КонецПроцедуры	

// 1.22
Процедура ПроверкаПередПроведением(Отказ)

// А. 

	Отказ1 = ПроверкаПересеченияПериодовПоКонтейнерам();

// Б.	

	Отказ2 = ПроверкаПревышенияПоТЭУ();
	
// В.	

	Отказ3 = ПроверкаДатПрибытияОтправленияПоВагонам();
	
	Отказ  = Отказ1 или Отказ2 или Отказ3;   
	
	
КонецПроцедуры	

// А. 

Функция ПроверкаПересеченияПериодовПоКонтейнерам()
	
	
	 //Применяем СКД (удобно свертывать контейнеры в строку документа в сообщении)
	
	Результат = РефСцепСервер.ПолучитьДанныеЧерезМакетСКД
		(Документы.РефСцеп.ПолучитьМакет("ПересечениеРабочихПериодовДокРефСцепПоКонтейнерам"),
		Новый Структура("тзКонтейнерыТекущегоДокумента,
		| ФактическоеОтправление,
		| ФактическоеПрибытие,
		| ПланируемоеОтправление,
		| ПланируемоеПрибытие,
		| Ссылка",
		ВагоныРефСцепа.Выгрузить(),
		ФактическоеОтправление,
		ФактическоеПрибытие,
		ПланируемоеОтправление,
		ПланируемоеПрибытие,
		Ссылка ));
		
	Ошибка = Ложь;	
	Для каждого Стр из Результат Цикл 
		
		Если ЗначениеЗаполнено(Стр.ТипДат) и ЗначениеЗаполнено(Стр.Ссылка) Тогда
			
			ОбщегоНазначения.СообщитьПользователю("Контейнер " + СтрЗаменить(Стр.СписокКонтейнеров, "<Пустое значение>", "")  
				+ " находится в реф. сцепе." + Стр.Номер 
				+ " и дата " + Стр.ТипДат + " текущего реф.сцепа входит в его рабочий период "  
				+ " Контейнер не может быть добавлен в текущий документ.");
				
			Ошибка = Истина;
			
		КонецЕсли;
		
	КонецЦикла;

	Возврат Ошибка;
	
КонецФункции

// Б.	

Функция	ПроверкаПревышенияПоТЭУ()

	Ошибка = Ложь;
	
	ВыборкаПревышеныПоТЭУ = РефСцепСервер.ПолучитьДанныеПревышенияПоТЕУ(ВагоныРефСцепа.Выгрузить());
	
	Пока ВыборкаПревышеныПоТЭУ.Следующий() Цикл
		
		Если ВыборкаПревышеныПоТЭУ.ВагонРазмерВТЕУ = 0 Тогда

			ОбщегоНазначения.СообщитьПользователю("Для вагона " + 
				ВыборкаПревышеныПоТЭУ.Вагон + " не задан или ошибочный типоразмер. Проверка на превышение в ТЕУ отменена.");
				
			Продолжить;	
			
		КонецЕсли;	
		
		РазницаВТЕУ = ВыборкаПревышеныПоТЭУ.РазмерКТКвТЭУ - ВыборкаПревышеныПоТЭУ.ВагонРазмерВТЕУ; 
		
		ОбщегоНазначения.СообщитьПользователю("Количество контейнеров, размещенных на вагоне " 
			+ ВыборкаПревышеныПоТЭУ.ПредставлениеВагона + " приводят к превышению его максимальной вместимости на " 
			+ РазницаВТЕУ + " ТЕУ"	);
				
		Ошибка = Истина;
		
	КонецЦикла;

	Возврат Ошибка;
	
КонецФункции

// В.	

Функция	ПроверкаДатПрибытияОтправленияПоВагонам()

	 //Применяем СКД (удобно свертывать контейнеры в строку документа в сообщении)
	
	Результат = РефСцепСервер.ПолучитьДанныеЧерезМакетСКД
		(Документы.РефСцеп.ПолучитьМакет("ПересечениеРабочихПериодовДокРефСцепПоВагонам"),
		Новый Структура("тзВагоныТекущегоДокумента,
		| ФактическоеОтправление,
		| ФактическоеПрибытие,
		| ПланируемоеОтправление,
		| ПланируемоеПрибытие,
		| Ссылка",
		ВагоныРефСцепа.Выгрузить(),
		ФактическоеОтправление,
		ФактическоеПрибытие,
		ПланируемоеОтправление,
		ПланируемоеПрибытие,
		Ссылка ));
		
	Ошибка = Ложь;	
	Для каждого Стр из Результат Цикл 
		
		Если ЗначениеЗаполнено(Стр.ТипДат) и ЗначениеЗаполнено(Стр.Ссылка) Тогда
			
			Если Стр.ДатаПрошлогоРефСцепа < Дата Тогда
				ОбщегоНазначения.СообщитьПользователю("Дата отправления вагона " + СтрЗаменить(Стр.СписокВагонов, "<Пустое значение>", "")  
					+ " в составе текущего реф. Сцепа " + Формат(Стр.ОтправлениеТекущегоДокумента, "ДФ=dd.MM.yyyy") 
					+ " не может быть раньше даты его прибытия в составе реф. сцепа " + Стр.Номер 
					+ " - " + Формат(Стр.Прибытие, "ДФ=dd.MM.yyyy")); 
					
				Ошибка = Истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;

	Возврат Ошибка;
	
КонецФункции	


Процедура ОбработкаПроведения()
	
	Если не РейсЗавершен Тогда 
		ПараметрыОтбора = Новый Структура("ЕстьВагонВРегистреНаФорме", Истина);
		//Субботин 71114 Начало 08.09.2023
		МассивНеИсключенныхСтрок = ВагоныРефСцепа.найтиСтроки(ПараметрыОтбора);
		Если ЗначениеЗаполнено(ФактическоеПрибытие) или МассивНеИсключенныхСтрок.количество() = 0  Тогда
		//Субботин 71114 Конец 08.09.2023
			РейсЗавершен = Истина;
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры	

Функция ЕстьКонтейнерыВЗаявках()

	мВсеКонтейнерыРефсцепа = ВагоныРефсцепа.Выгрузить().ВыгрузитьКолонку("Контейнер");
	ОбщегоНазначенияКлиентСервер.дополнитьМассив(мВсеКонтейнерыРефсцепа, Контейнеры.Выгрузить().ВыгрузитьКолонку("Контейнер"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗаявкаСоставУслуги.Ссылка КАК Заявка,
		|	ЗаявкаСоставУслуги.НомерКТК КАК Контейнер
		|ИЗ
		|	Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
		|ГДЕ
		|	ЗаявкаСоставУслуги.Ссылка.ДокументОснование = &РефСеп
		|	И ЗаявкаСоставУслуги.НомерКТК <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
		|	И ЗаявкаСоставУслуги.НомерКТК В(&ВсеКонтейнерыРефСцепа)";
	
	Запрос.УстановитьПараметр("РефСеп", Ссылка);
	
	Запрос.УстановитьПараметр("ВсеКонтейнерыРефСцепа", мВсеКонтейнерыРефсцепа);
	
	Возврат не Запрос.Выполнить().Пустой();

КонецФункции	

Процедура ПоставитьЗаявкиПодбораВОчередьНаИзменение()
	
	ЗаявкиПодбораВОчередьНаИзменение = ПОлучитьЗаявкиПодбораВОчередьНаИзменение();
	
	Пока ЗаявкиПодбораВОчередьНаИзменение.Следующий() Цикл
		ОтложенноеИзменениеСервер.ПоставитьЗаявкуСделкуПоРефСцепуВОчередьИзменения(
			ЗаявкиПодбораВОчередьНаИзменение.ЗаявкаПодбора, Ссылка);
	КонецЦикла;	
	
КонецПроцедуры

Функция ПОлучитьЗаявкиПодбораВОчередьНаИзменение()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РефСцепКонтейнеры.ЗаявкаПодбора КАК ЗаявкаПодбора
		|ПОМЕСТИТЬ вт_Заявки
		|ИЗ
		|	Документ.РефСцеп.Контейнеры КАК РефСцепКонтейнеры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	вт_Заявки.ЗаявкаПодбора КАК ЗаявкаПодбора
		|ИЗ
		|	вт_Заявки КАК вт_Заявки";
	
	Запрос.УстановитьПараметр("тзКонтейнеры", Контейнеры.Выгрузить()); 
	
	Возврат Запрос.Выполнить().Выбрать();

КонецФункции	

Функция НетКонтейнеровПривязанныхКВагонам()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РефСцепВагоныРефСцепа.Контейнер КАК Контейнер
		|ПОМЕСТИТЬ вт_Контейнеры
		|ИЗ
		|	&тзВагоны КАК РефСцепВагоныРефСцепа
		|ГДЕ
		|	РефСцепВагоныРефСцепа.Контейнер <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяССылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_Контейнеры.Контейнер КАК Контейнер
		|ИЗ
		|	вт_Контейнеры КАК вт_Контейнеры";
	
	Запрос.УстановитьПараметр("тзВагоны", ВагоныРефСцепа.Выгрузить());
	
	Возврат Запрос.Выполнить().Пустой();

КонецФункции	
