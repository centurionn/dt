
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект); 
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	//КонтрольДоступностиДокументов_сервер.ОбработатьБлокировкуЭлементовФормы(Объект.Ссылка, Элементы);
	
	// Обновляем панель текущего пользователя и панель состояний
	ОбновитьПанельТекущегоПользователя();
	ОбновитьПанельСостояний();
	
	ПериодБлокировки = Формат(Объект.ПериодБлокировки, "ДФ='ММММ гггг'");
	
	Элементы.ВключитьРассылку.ТолькоПросмотр = Не РольДоступна("ПолныеПрава"); 
	
	УстановитьПредупреждениеРедактирования();
	
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НастроитьОтображениеКоличестваДокументов();
	ОбновитьОтображениеТекстаНадписи();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ОбновитьПанельТекущегоПользователя();
	ОбновитьПанельСостояний();
	
	УстановитьПредупреждениеРедактирования();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПредупреждениеРедактирования()
	
	Если РольДоступна("ПолныеПрава") Тогда
		Элементы.ПредупреждениеРедактирования.Заголовок = "Документ проведен. Редактирование не рекомендуется!";
	КонецЕсли;
	Элементы.ПредупреждениеРедактирования.Видимость = Объект.Проведен;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПанельТекущегоПользователя()
	
	МаршрутизацияСервер.ОбновитьПанельТекущегоПользователя(Объект, ТекущийИсполнитель_Статус, ТекущийИсполнитель_Состояние, ТекущийИсполнитель_Исполнитель, ТекущийИсполнитель_Наблюдатель);
	
КонецПроцедуры

// Функция обновляет панель состояний документа для графического отражения его движения по состояниям
&НаСервере
Процедура ОбновитьПанельСостояний()
	
	МаршрутизацияСервер.ОбновитьПанельСостояний(ЭтотОбъект);
	
КонецПроцедуры

// Этот обработчик вызывается при нажатии на состояния на панели состояний
// Ссылка на него устанавливается кодом, поэтому при проверке конфигурации 1с может сказать, что эта функция не испольузется
// Не верьте 1с!
&НаКлиенте
Процедура ОбработчикНажатияПлитокСостояния(П1 = неопределено, П2 = неопределено) Экспорт
	МаршрутизацияКлиент.ОбработчикНажатияНаПлиткуОбщий(П1, П2);
КонецПроцедуры

&НаКлиенте
Процедура ТекущийИсполнитель_СтатусПриИзменении(Элемент)
	
	// обновляем информацию по состоянию 
	МаршрутизацияКлиент.ТекущийИсполнитель_СтатусПриИзменении(Объект, ТекущийИсполнитель_Состояние, ТекущийИсполнитель_Статус, ТекущийИсполнитель_Исполнитель, ТекущийИсполнитель_Наблюдатель);
	
	ОбновитьПанельСостояний();
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодБлокировкиРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Объект.ПериодБлокировки = НачалоМесяца(ДобавитьМесяц(Объект.ПериодБлокировки, Направление));
	Модифицированность = Истина;
	
	ПериодБлокировки = Формат(Объект.ПериодБлокировки, "ДФ='ММММ гггг'");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНЗП(Команда)	
	
	Если Объект.НЗППредыдущихПериодов.Количество() > 0 Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаЗаполнениеНЗП", ЭтотОбъект, Параметры);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Список НЗП предыдущих периодов будет перезаполнен.
                                         |Продолжить?'"), Режим, 0);		
	Иначе
		ВыполнитьЗаполнениеНЗП();
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаЗаполнениеНЗП(Результат, Параметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

    ВыполнитьЗаполнениеНЗП();

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗаполнениеНЗП()
    ЗаполнитьНЗПНаСервере();
	НастроитьОтображениеКоличестваДокументов();
	ОбновитьОтображениеТекстаНадписи();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНЗПНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НезавершенноеПроизводствоОстатки.Акцепт КАК Акцепт,
	|	НезавершенноеПроизводствоОстатки.Акцепт.ПериодВО КАК АкцептПериодВО,
	|	НезавершенноеПроизводствоОстатки.Акцепт.ПериодБУ КАК АкцептПериодБУ,
	|	НезавершенноеПроизводствоОстатки.Акцепт.Дата КАК АкцептДата,
	|	НезавершенноеПроизводствоОстатки.Акцепт.Поступление КАК Поступление,
	|	НезавершенноеПроизводствоОстатки.Сделка КАК АкцептСделка
	|ПОМЕСТИТЬ АкцептыСНЗП
	|ИЗ
	|	РегистрНакопления.НезавершенноеПроизводство.Остатки(&Период, Поступление.Проведен) КАК НезавершенноеПроизводствоОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	АкцептыСНЗП.Поступление КАК ПТУ,
	|	АкцептыСНЗП.Поступление.Дата КАК ПоступлениеДата,
	|	АкцептыСНЗП.Акцепт КАК Акцепт,
	|	АкцептыСНЗП.АкцептПериодВО КАК АкцептПериодВО,
	|	АкцептыСНЗП.АкцептПериодБУ КАК АкцептПериодБУ,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СделкаДоходы.УчДокумент.Проведен, ЛОЖЬ)
	|				И Аннулирование.Ссылка ЕСТЬ NULL
	|			ТОГДА СделкаДоходы.УчДокумент 
	|		КОГДА ЕСТЬNULL(СделкаДоходы.УчДокумент.Проведен, ЛОЖЬ)
	|				И НЕ Аннулирование.Ссылка ЕСТЬ NULL
	|				И КонецПериода(Аннулирование.ПериодВО, Месяц) = &Период
	|			ТОГДА СделкаДоходы.УчДокумент 
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК РТУ,
	|	СделкаДоходы.УчДокумент.ПериодВО КАК ПериодВО_РТУ
	|ИЗ
	|	АкцептыСНЗП КАК АкцептыСНЗП
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Акцепт.Услуги КАК АкцептУслуги
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.Расходы КАК СделкаРасходы
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьДоходовИРасходов КАК СделкаСвязьДоходовИРасходов
	|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.Доходы КАК СделкаДоходы  
	|						ЛЕВОЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации КАК Аннулирование
	|						ПО СделкаДоходы.УчДокумент = Аннулирование.ДокументРеализации
	|							И (Аннулирование.Проведен)
	|							И (Аннулирование.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование))
	|					ПО СделкаСвязьДоходовИРасходов.Ссылка = СделкаДоходы.Ссылка
	|						И СделкаСвязьДоходовИРасходов.Доходы = СделкаДоходы.ГУИД
	|				ПО СделкаРасходы.Ссылка = СделкаСвязьДоходовИРасходов.Ссылка
	|					И СделкаРасходы.ГУИД = СделкаСвязьДоходовИРасходов.Расходы
	|			ПО АкцептУслуги.Сделка = СделкаРасходы.Ссылка
	|				И АкцептУслуги.ИдентификаторСтрокиРасходовВСделке = СделкаРасходы.ГУИД
	|		ПО АкцептыСНЗП.Акцепт = АкцептУслуги.Ссылка
	|ГДЕ
	|	АкцептУслуги.ВидЗатрат = ЗНАЧЕНИЕ(Перечисление.ВидыЗатрат.НезавершенноеПроизводство)
	|	И СделкаДоходы.УчДокумент.ПериодВО <= &Период
	|	И НЕ ВЫБОР
	|		КОГДА ЕСТЬNULL(СделкаДоходы.УчДокумент.Проведен, ЛОЖЬ)
	|				И Аннулирование.Ссылка ЕСТЬ NULL
	|			ТОГДА СделкаДоходы.УчДокумент 
	|		КОГДА ЕСТЬNULL(СделкаДоходы.УчДокумент.Проведен, ЛОЖЬ)
	|				И НЕ Аннулирование.Ссылка ЕСТЬ NULL
	|				И КонецПериода(Аннулирование.ПериодВО, Месяц) = &Период
	|			ТОГДА СделкаДоходы.УчДокумент 
	|		ИНАЧЕ NULL
	|	КОНЕЦ есть NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПоступлениеДата,
	|	АкцептПериодВО,
	|	АкцептПериодБУ,
	|	ПериодВО_РТУ";
	
	Запрос.УстановитьПараметр("Период", КонецМесяца(Объект.ПериодБлокировки));

	Результат = Запрос.Выполнить();
	
	ТаблицаДокументов = Результат.Выгрузить();
	
	Объект.НЗППредыдущихПериодов.Загрузить(ТаблицаДокументов);
	
	Объект.АкцептыДозаполнены = Ложь;
	Объект.ЗакрытиеНЗППредыдущихПериодов = Истина;
	
КонецПроцедуры	

&НаКлиенте
Процедура НастроитьОтображениеКоличестваДокументов()
	КоличествоСтрок = Объект.НЗППредыдущихПериодов.Количество();
	Элементы.ГруппаНЗППредыдущихПериодов.Заголовок = СтрШаблон(НСтр("ru = 'НЗП предыдущих периодов (%1 шт.)'"), КоличествоСтрок);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеТекстаНадписи()
	
	ЗакрытиеНЗПДоИзменения = Объект.ЗакрытиеНЗППредыдущихПериодов;
	
	Элементы.НадписьАкцептыСозданы.Видимость = Объект.ЗакрытиеНЗППредыдущихПериодов
											И Объект.НЗППредыдущихПериодов.Количество() > 0;
	
	Если Объект.АкцептыДозаполнены Тогда
		Элементы.НадписьАкцептыСозданы.Заголовок = "По ПТУ, которые указаны в документе, созданы актуальные акцепты";
		Элементы.НадписьАкцептыСозданы.ЦветТекста = Новый Цвет(0, 150, 70);
	Иначе
		Элементы.НадписьАкцептыСозданы.Заголовок = "По ПТУ, которые указаны в документе, необходимо обновить акцепты (кнопка ""Создать актуальные акцепты"")";
		Элементы.НадписьАкцептыСозданы.ЦветТекста = Новый Цвет(255, 0, 0);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьАктуальныеАкцепты(Команда)
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаСоздатьАкцепты", ЭтотОбъект, Параметры);
	ПоказатьВопрос(Оповещение, "Акцепты будут заполнены данными по РТУ. Продолжить?", Режим, 0);		
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаСоздатьАкцепты(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
    КонецЕсли;
	
	Объект.АкцептыДозаполнены = Ложь;
	
    РезультатВыполнения = ВыполнитьСозданиеАкцептов();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ТекстСообщения = "Выполняется заполнение акцептов.
										|Это может занять продолжительное время.";
	ОповещениеОЗавершении = Новый ОписаниеОповещения("СозданиеАкцептовЗавершение", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

&НаСервере
Функция ВыполнитьСозданиеАкцептов()
	
	Если РезультатВыполнения <> Неопределено
		И ЗначениеЗаполнено(РезультатВыполнения.ИдентификаторЗадания) Тогда
		ДлительныеОперации.ОтменитьВыполнениеЗадания(РезультатВыполнения.ИдентификаторЗадания);
	КонецЕсли;
		
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение = 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Создание актуальных акцептов при закрытии периода БУ'");
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	РезультатВыполнения = ДлительныеОперации.ВыполнитьВФоне("Документы.ЗакрытиеПериодаБУ.СоздатьАтуальныеАкцепты",
		Объект.НЗППредыдущихПериодов.Выгрузить(), ПараметрыВыполнения);
	
	Если РезультатВыполнения.Статус = "Ошибка" Тогда
		ВызватьИсключение РезультатВыполнения.КраткоеПредставлениеОшибки;
	КонецЕсли;
	
	Возврат РезультатВыполнения;
	
КонецФункции

&НаКлиенте
Процедура СозданиеАкцептовЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ЗагрузитьПодготовленныеДанные();
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		ВызватьИсключение Результат.КраткоеПредставлениеОшибки;
	КонецЕсли;
	
	ОбновитьОтображениеТекстаНадписи();
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПодготовленныеДанные()
	Результат = ПолучитьИзВременногоХранилища(РезультатВыполнения.АдресРезультата);
	
	ТаблицаНЗП = Результат.ТаблицаНЗП;
	Объект.НЗППредыдущихПериодов.Загрузить(ТаблицаНЗП);
	Объект.АкцептыДозаполнены = Истина;	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОкноСИнструкциями(Форма, Команда)
	ИнструкцииКлиент.ОткрытьОкноСИнструкциями(ЭтаФорма, Команда);
КонецПроцедуры  

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
    ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат)
    ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Объект, Результат);
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытиеНЗППредыдущихПериодовПриИзменении(Элемент)
	
	Если Объект.НЗППредыдущихПериодов.Количество() > 0
			И Не Объект.ЗакрытиеНЗППредыдущихПериодов Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаЗакрытиеНЗППредыдущихПериодов", ЭтотОбъект, Параметры);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Список НЗП предыдущих периодов будет очищен.
                                     	|Продолжить?'"), Режим, 0);
	Иначе
		ОбновитьОтображениеТекстаНадписи();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаЗакрытиеНЗППредыдущихПериодов(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Объект.НЗППредыдущихПериодов.Очистить();                     
		
		НастроитьОтображениеКоличестваДокументов();
		ОбновитьОтображениеТекстаНадписи();
        Возврат;
    КонецЕсли;

    Объект.ЗакрытиеНЗППредыдущихПериодов = Истина;
    ОбновитьОтображениеТекстаНадписи();
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
    ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры

&НаКлиенте
Процедура НЗППредыдущихПериодовПриИзменении(Элемент)
	НастроитьОтображениеКоличестваДокументов();
	ОбновитьОтображениеТекстаНадписи();
КонецПроцедуры

&НаКлиенте
Процедура НЗППредыдущихПериодовПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.НЗППредыдущихПериодов.ТекущиеДанные;
	
	Элементы.ГруппаТекстОшибки.Заголовок = "Нет ошибок создания акцептов";
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Если НЕ ПустаяСтрока(ТекущиеДанные.Ошибка) Тогда
		Элементы.ГруппаТекстОшибки.Заголовок = "Подробный текст ошибки";	
	КонецЕсли;
	
КонецПроцедуры

