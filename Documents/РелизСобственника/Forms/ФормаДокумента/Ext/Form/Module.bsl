&НаКлиенте
Процедура ЗадатьВопросПользователю(Отказ, ПараметрыЗаписи)
	
	Если Не ПараметрыЗаписи.Свойство("ВопросУжеБылЗадан") Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтотОбъект, ПараметрыЗаписи);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'При отмене проведения будут удалена история записей КТК по данному Релизу. Вы действительно хотите продолжить?';"), Режим);
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Параметры.Вставить("ВопросУжеБылЗадан", Истина);
	Записать(Параметры);
	
КонецПроцедуры
