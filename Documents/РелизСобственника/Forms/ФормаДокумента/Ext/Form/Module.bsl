			//Евросиб(ДИТ), Беляев СЮ, BUG 94917 / TA 96390, 27-11-2024, начало
			МассивКонтейнеровПоКоторымРелизАктуален = ПолучитьМассивКонтейнеровПоКоторымРелизАктуален(Объект[ИмяТЧ]);
			//Евросиб(ДИТ), Беляев СЮ, BUG 94917 / TA 96390, 27-11-2024, конец
			
			Для Сч = 0 По Объект[ИмяТЧ].Количество() - 1 Цикл
				РезПроверки = Элементы.Номинации.ПроверитьСтроку(Объект[ИмяТЧ][Сч].ПолучитьИдентификатор());
				Если РезПроверки = Истина Тогда
					//++ Зубов US 33131 TA 43877 15.12.2021
					Если ИмяПоля = "ТипКТК" ИЛИ ИмяПоля = "тек_СобственностьКТК" ИЛИ ИмяПоля = "ДатаВзятия" ИЛИ ИмяПоля = "НормативВозврата" 
						ИЛИ ИмяПоля = "Ставка" ИЛИ ИмяПоля = "Валюта" ИЛИ ИмяПоля = "СНП" ИЛИ ИмяПоля = "допл_Калькуляция"
						ИЛИ ИмяПоля = "СтавкаНДС" ИЛИ ИмяПоля = "НДСВключая" Тогда
						
						Если НЕ (ИмяПоля = "ТипКТК" И ЗначениеЗаполнено(Объект[ИмяТЧ][Сч]["Контейнер"])) Тогда
							Объект[ИмяТЧ][Сч][ИмяПоля] = НовоеЗначение;
						КонецЕсли;
						//++ Зубов US 33131 TA 38910 01.11.2021
						//Объект[ИмяТЧ][Сч].ДатаАктуальностиЗаписи = ТекущаяДата();
						//Если НЕ ЦиклЗакрыт(ТекД.Контейнер,ТекД.ДатаАктуальностиЗаписи) Тогда
						//	Объект[ИмяТЧ][Сч].ДатаАктуальностиЗаписи = ТекущаяДата();
						//КонецЕсли;
						//ДИТ, Беляев СЮ, BUG 69275 / TASK 77103, 29-11-2023, начало
						СтрокаТаблицы = Объект[ИмяТЧ][Сч];
						//Если НЕ ЦиклЗакрыт(СтрокаТаблицы.Контейнер, СтрокаТаблицы.ДатаАктуальностиЗаписи) Тогда
						//	СтрокаТаблицы.ДатаАктуальностиЗаписи = ТекущаяДата();
						//КонецЕсли;
						//Евросиб(ДИТ), Беляев СЮ, BUG 94917 / TA 96390, 27-11-2024, начало
						Если МассивКонтейнеровПоКоторымРелизАктуален.Найти(СтрокаТаблицы.Контейнер) <> Неопределено Тогда
		                	СтрокаТаблицы.ДатаАктуальностиЗаписи = ТекущаяДата();
						КонецЕсли;
						//Евросиб(ДИТ), Беляев СЮ, BUG 94917 / TA 96390, 27-11-2024, конец
						//ДИТ, Беляев СЮ, BUG 69275 / TASK 77103, 29-11-2023, конец
						//-- Зубов US 33131 TA 38910 01.11.2021
					КонецЕсли;
					//-- Зубов US 33131 TA 43877 15.12.2021
					//++ Зубов US 45162 TA 45703 28.01.2022
					Если ИмяПоля = "Ставка" Тогда
						Для каждого СтрокаНоминации из Объект.Номинации Цикл
							Если НЕ ТекД.тек_СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.Спот") Тогда
								СтрокаНоминации.Ставка = НовоеЗначение;
							Иначе
								Если СтрокаНоминации.тек_СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.Спот") Тогда
									СтрокаНоминации.Ставка = НовоеЗначение;
								КонецЕсли;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
					//++ Зубов US 45162 TA 45703 28.01.2022
					
					//++ Зубов US 45162 TA 45703 21.01.2022
					Если ИмяПоля = "НулеваяСтавка" Тогда
						Для каждого СтрокаНоминации из Объект.Номинации Цикл
							Если НЕ ТекД.тек_СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.Спот") Тогда
								СтрокаНоминации.НулеваяСтавка = НовоеЗначение;
								Если НовоеЗначение = Истина Тогда
									СтрокаНоминации.Ставка = 0;
								КонецЕсли;
							Иначе
								Если СтрокаНоминации.тек_СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.Спот") Тогда
									СтрокаНоминации.НулеваяСтавка = НовоеЗначение;
									Если НовоеЗначение = Истина Тогда
										СтрокаНоминации.Ставка = 0;
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
					//-- Зубов US 45162 TA 45703 21.01.2022
				КонецЕсли; 
			КонецЦикла;
		КонецЕсли;
		//++ Зубов BUG 40946 TA 41043 25.10.2021
		Если НЕ ЗначениеЗаполнено(ТекД.ГУИДСтроки) Тогда
			ТекД.ГУИДСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
		//-- Зубов BUG 40946 TA 41043 25.10.202
		//++ Зубов US 33131 TA 38910 27.10.2021
		ОбновитьДоступностьРелиза();
		ПересчитатьДополнительныеДанные();
		//-- Зубов US 33131 TA 38910 27.10.2021 
		
		//++ Зубов US 33131 TA 43877 16.12.2021
		Если Объект.ДоплатныеКТК Тогда
			// ДИТ 65580 Давудов М.А. Начало: 23.02.2023
			//Было:
			//ТекД.тек_СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.Доплатные");
			//Стало:
			ТекД.тек_СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.СпотДоплатный");
			// ДИТ 65580 Давудов М.А. Конец: 23.02.2023
		ИначеЕсли Объект.МорскиеКТК Тогда
			ТекД.тек_СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.Спот");
		//++ Дудоров С.В. TASK 66585 17.03.2023	
		ИначеЕсли Объект.СобственныеКТК Тогда
			ТекД.тек_СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.Собственный");
		//-- Дудоров С.В. TASK 66585 17.03.2023	
		КонецЕсли;
		//-- Зубов US 33131 TA 43877 16.12.2021
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьРелиза()
	//++ Зубов US 33131 TA 38910 27.10.2021
	//ЕстьХотьОдинСлот = Ложь;
	//Для каждого Стр из Объект.Номинации Цикл
	//	ЕстьХотьОдинСлот = ЕстьХотьОдинСлот ИЛИ НЕ ЗначениеЗаполнено(Стр.Контейнер);
	//КонецЦикла;
	ЕстьПустаяДатаВзятия = Ложь;
	Для каждого Стр из Объект.Номинации Цикл
		ЕстьПустаяДатаВзятия = ЕстьПустаяДатаВзятия ИЛИ НЕ ЗначениеЗаполнено(Стр.ДатаВзятия);
	КонецЦикла;
	//-- Зубов US 33131 TA 38910 27.10.2021	
	//++ Зубов US 33131 TA 38910 26.10.2021
	//Объект.Заполненность = ?(ЕстьХотьОдинСлот, ПредопределенноеЗначение("Перечисление.СтатусыЗаполненностиРелиза.Открыт"), ПредопределенноеЗначение("Перечисление.СтатусыЗаполненностиРелиза.Исчерпан"));
	//++ Зубов US 45162 TA 45703 21.01.2022
	//Объект.Реализованность = ?(ЕстьПустаяДатаВзятия, ПредопределенноеЗначение("Перечисление.СтатусыЗаполненностиРелиза.Открыт"), ПредопределенноеЗначение("Перечисление.СтатусыЗаполненностиРелиза.Исчерпан"));
	Объект.Реализованность = ?(ЕстьПустаяДатаВзятия ИЛИ Объект.Номинации.Количество()=0, ПредопределенноеЗначение("Перечисление.СтатусыЗаполненностиРелиза.Открыт"), ПредопределенноеЗначение("Перечисление.СтатусыЗаполненностиРелиза.Исчерпан"));
	//-- Зубов US 45162 TA 45703 21.01.2022
	//-- Зубов US 33131 TA 38910 26.10.2021
	//++ Зубов US 33131 TA 38910 27.10.2021
	//++ Зубов US 45162 TA 45703 21.01.2022
	//Если Объект.ОкончаниеДействия <= ТекущаяДата() Тогда
	//Если Объект.Проведен Тогда
		Если Объект.ОкончаниеДействия <= ТекущаяДата() И ЗначениеЗаполнено(ПериодДействия) Тогда
		//-- Зубов US 45162 TA 45703 21.01.2022
			Если Объект.Реализованность = ПредопределенноеЗначение("Перечисление.СтатусыЗаполненностиРелиза.Открыт") Тогда
				Объект.Активность = ПредопределенноеЗначение("Перечисление.СтатусАктивностиРелиза.Просрочен");
			Иначе
				Объект.Активность = ПредопределенноеЗначение("Перечисление.СтатусАктивностиРелиза.Закрыт");
			КонецЕсли;
		Иначе
			Объект.Активность = ПредопределенноеЗначение("Перечисление.СтатусАктивностиРелиза.Активен");
		КонецЕсли;
	//Иначе
	//	Объект.Активность = ПредопределенноеЗначение("Перечисление.СтатусАктивностиРелиза.Активен");
	//КонецЕсли;
	//-- Зубов US 33131 TA 38910 27.10.2021
КонецПроцедуры

