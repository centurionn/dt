&НаКлиенте
Процедура НоминацииСтавка0ПриИзменении(Элемент)
	ТекД = Элементы.Номинации.ТекущиеДанные;
	Если НЕ ТекД = Неопределено Тогда
		Если ТекД.тек_СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.Спот") Тогда
			Если ТекД.НулеваяСтавка Тогда
				ТекД.Ставка = 0;
			КонецЕсли;
		Иначе
			ТекД.НулеваяСтавка = НЕ ТекД.НулеваяСтавка;
			Сообщить("Нулевая ставка разрешена только для вида собственности Спот!");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Номинациитек_СобственностьКТКПриИзменении(Элемент)
	ТекД = Элементы.Номинации.ТекущиеДанные;
	Если НЕ ТекД = Неопределено Тогда
		Если НЕ ТекД.тек_СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.Спот") Тогда
			ТекД.НулеваяСтавка = Ложь;
		КонецЕсли;
		// Евросиб(ДИТ) US 97286 ТА 97320 Сержантова А.С. Начало: 19.12.2024
		Если ТекД.тек_СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.СпотДоплатный") 
			и Объект.ДоплатныеКТК и ТекД.Ставка > 0 Тогда
		    ТекД.Ставка = (-1) * ТекД.Ставка;
		КонецЕсли;
		// Евросиб(ДИТ) US 97286 ТА 97320 Сержантова А.С. Конец: 19.12.2024
	КонецЕсли;
КонецПроцедуры
