&НаКлиенте
Процедура НоминацииПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	//ДИТ, Беляев СЮ, BUG 64837 / TA 73560, 17-08-2023, начало
	ФлагСНПСкопирован = Ложь;
	//ДИТ, Беляев СЮ, BUG 64837 / TA 73560, 17-08-2023, конец
	Если НоваяСтрока И ЗаполнятьПоПервойСтроке Тогда
		Если Объект.Номинации.Количество()>0 Тогда
			ПерваяСтрока = Объект.Номинации[0]; 
			ТекД = Элементы.Номинации.ТекущиеДанные;
			Если НЕ ЗначениеЗаполнено(ПерваяСтрока.Контейнер) Тогда
				ТекД.ТипКТК = ПерваяСтрока.ТипКТК;
			КонецЕсли;
			ТекД.тек_СобственностьКТК = ПерваяСтрока.тек_СобственностьКТК;
			ТекД.ДатаВзятия = ПерваяСтрока.ДатаВзятия;
			ТекД.НормативВозврата = ПерваяСтрока.НормативВозврата; 
			ТекД.Ставка = ПерваяСтрока.Ставка;
			ТекД.Валюта = ПерваяСтрока.Валюта;
			ТекД.СНП = ПерваяСтрока.СНП;
			ТекД.допл_Калькуляция = ПерваяСтрока.допл_Калькуляция;
			ТекД.СтавкаНДС = ПерваяСтрока.СтавкаНДС;
			ТекД.НДСВключая = ПерваяСтрока.НДСВключая;
			//Если НЕ ЦиклЗакрыт(ПерваяСтрока.Контейнер,ПерваяСтрока.ДатаАктуальностиЗаписи) Тогда
			//	ТекД.ДатаАктуальностиЗаписи = ТекущаяДата();
			//КонецЕсли;
			//Евросиб(ДИТ), Беляев СЮ, BUG 94917 / TA 96390, 27-11-2024, начало
			Если РелизПоКонтейнеруАктуален(Объект.Ссылка, ПерваяСтрока.Контейнер) Тогда
	        	ТекД.ДатаАктуальностиЗаписи = ТекущаяДата();
			КонецЕсли;
			//Евросиб(ДИТ), Беляев СЮ, BUG 94917 / TA 96390, 27-11-2024, конец
			//ДИТ, Беляев СЮ, BUG 64837 / TA 73560, 17-08-2023, начало
			ТекД.ГУИДСтроки = Новый УникальныйИдентификатор;
			СкопироватьСНП(ПерваяСтрока.ГУИДСтроки, ТекД.ГУИДСтроки);
			ФлагСНПСкопирован = Истина;
			//ДИТ, Беляев СЮ, BUG 64837 / TA 73560, 17-08-2023, конец
		КонецЕсли;		
	КонецЕсли;
	//++ Зубов US 45162 TA 45703 21.01.2022
	Если Копирование Тогда
		ТекД = Элементы.Номинации.ТекущиеДанные;
		ТекД.ДатаВзятия = Дата("00010101");
		ТекД.Контейнер = ПредопределенноеЗначение("Справочник.ТЕ.ПустаяСсылка"); 
		// ++ ДИТ_Агафонов_task 54348 15.07.2022
		ТекД.РелизКлиента = Неопределено;
		ТекД.РелизКлиентаНеСовпадаетТипоразмерКТК = Ложь;
		ТекД.РелизКлиентаНеСовпадаетТипоразмерКТК_Выполнено = Ложь;
		ТекД.РелизКлиентаНоваяЗаписьКТК = Ложь;
		ТекД.РелизКлиентаНоваяЗаписьКТК_Выполнено = Ложь;
		// -- ДИТ_Агафонов_task 54348 15.07.2022
		// Евросиб US ***** TA ***** Рыбьяков К.А. 21.11.2024 ((
		ТекД.КлючАналитики = Неопределено;
		//ТекД.ГУИДСтроки = Неопределено;
		// Евросиб Рыбьяков К.А. 21.11.2024 ))
		//ДИТ Авдеева В.С. 48864 21.04.2022 Начало
		//ТекД.ГУИДСтроки = Новый УникальныйИдентификатор;  
		//НоминацииСНППриИзменении(Неопределено);
		//ДИТ Авдеева В.С. 48864 21.04.2022 Конец
		//ДИТ, Беляев СЮ, BUG 64837 / TA 73560, 17-08-2023, начало
		Если НЕ ФлагСНПСкопирован Тогда
			ГУИДСтрокиИсточник = ТекД.ГУИДСтроки;
			ТекД.ГУИДСтроки = Новый УникальныйИдентификатор;
			СкопироватьСНП(ГУИДСтрокиИсточник, ТекД.ГУИДСтроки);
		КонецЕсли;
		//ДИТ, Беляев СЮ, BUG 64837 / TA 73560, 17-08-2023, конец	
	КонецЕсли;
	//-- Зубов US 45162 TA 45703 21.01.2022
КонецПроцедуры

//ДИТ, Беляев СЮ, BUG 64837 / TA 73560, 17-08-2023, начало
&НаКлиенте
Процедура СкопироватьСНП(ГУИДСтрокиИсточник, ГУИДСтрокиПриемник)
	НайденныеСтроки = Объект.СНП.НайтиСтроки(Новый Структура("ГУИДСтроки", ГУИДСтрокиИсточник));
	Для каждого СтрСНП из НайденныеСтроки Цикл
		НСтр = Объект.СНП.Добавить();
		ЗаполнитьЗначенияСвойств(НСтр, СтрСНП, ,"ГУИДСтроки");
		НСтр.ГУИДСтроки = ГУИДСтрокиПриемник;	
	КонецЦикла;	
