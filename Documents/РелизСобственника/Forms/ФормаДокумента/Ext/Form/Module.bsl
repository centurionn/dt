	|	Контейнеры.СтокВыдачи КАК СтокВыдачи,
	|	Контейнеры.ДатаВозвратаКлиентом КАК ДатаВозвратаКлиентом,
	|	СделкаСвязьУчетныхЕдиниц.ЖДН.НакладнаяЭТРАН.СтанцияОтправления КАК ПунктОтправления,
	|	СделкаСвязьУчетныхЕдиниц.ЖДН.НакладнаяЭТРАН.СтанцияНазначения КАК ПунктНазначения,
	|	СделкаСвязьУчетныхЕдиниц.Заявка КАК Заявка,
	|	СделкаСвязьУчетныхЕдиниц.Ссылка.ТипЗаказа КАК ТипЗаказа,
	|	СделкаДоходы.ГУИД КАК ИдентификаторСтрокиДоходовСделки
	|ИЗ
	|	Контейнеры КАК Контейнеры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|		ПО Контейнеры.Сделка = СделкаСвязьУчетныхЕдиниц.Ссылка
	|			И Контейнеры.Контейнер = СделкаСвязьУчетныхЕдиниц.Контейнер
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьДоходовИРасходов КАК СделкаСвязьДоходовИРасходов
	|		ПО (СделкаСвязьУчетныхЕдиниц.ГУИД = СделкаСвязьДоходовИРасходов.СвязьУчетныхЕдиниц)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.Доходы КАК СделкаДоходы
	|		ПО (СделкаСвязьДоходовИРасходов.Доходы = СделкаДоходы.ГУИД)
	|ГДЕ
	|	СделкаСвязьУчетныхЕдиниц.ВидТранспортногоСообщения = ЗНАЧЕНИЕ(Перечисление.ВидыТранспортныхСообщений.ЖД)
	|	И СделкаДоходы.ДоплатныеКТК
	|	И Контейнеры.Реализация = Неопределено";
	
	ТаблицаКонтейнеров = Запрос.Выполнить().Выгрузить();
	АдресТаблицыКТК = ПоместитьВоВременноеХранилище(ТаблицаКонтейнеров, Новый УникальныйИдентификатор);
	Параметры = Новый Структура("КТКВХранилище", АдресТаблицыКТК);
	
	Возврат Параметры;
	// Евросиб Рыбьяков К.А. 14.07.2025 ))
КонецФункции

// Евросиб US 115057 TA 117286 Рыбьяков К.А. 19.08.2025 ((
Процедура РассчитатьОбщуюСуммуСНП()
	
	Для Каждого Строка Из Объект.Номинации Цикл
		Если ЗначениеЗаполнено(Строка.ДатаВозвратаСобственнику) 
			И Строка.ДатаВозвратаСобственнику > Строка.ДатаВзятия + Строка.НормативВозврата * 86400 Тогда
			Строка.ОбщаяCуммаСНП = ((Строка.ДатаВозвратаСобственнику - Строка.ДатаВзятия) / 86400 - Строка.НормативВозврата) * Строка.СНП;
		ИначеЕсли Не ЗначениеЗаполнено(Строка.ДатаВозвратаСобственнику) И ЗначениеЗаполнено(Строка.ДатаВзятия)
			И ТекущаяДатаСеанса() > Строка.ДатаВзятия + Строка.НормативВозврата * 86400 Тогда
			Строка.ОбщаяCуммаСНП = ((НачалоДня(ТекущаяДатаСеанса()) - Строка.ДатаВзятия) / 86400 - Строка.НормативВозврата) * Строка.СНП;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // Евросиб Рыбьяков К.А. 19.08.2025 ))

