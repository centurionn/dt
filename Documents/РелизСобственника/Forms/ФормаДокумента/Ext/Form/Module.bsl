&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПериодДействия.ДатаНачала = Объект.НачалоДействия;
	ПериодДействия.ДатаОкончания = Объект.ОкончаниеДействия;
	ПересчитатьСуммыСНП();
	ОбновитьДанныеПослКлиентовИЗаявок();
	//ДИТ Авдеева В.С. 48934 21.04.2022 Начало
	//ОбновитьДоступностьРелиза();
	//ДИТ Авдеева В.С. 48934 21.04.2022 Конец
	//++ Зубов US 33131 TA 38910 26.10.2021
	Элементы.Сток.Видимость = ЗначениеЗаполнено(Объект.Локация);
	Элементы.ПунктыСдачи.Видимость = ЗначениеЗаполнено(Объект.ЛокацияСдачи);
	Элементы.ПСЦ.Видимость = ЗначениеЗаполнено(Объект.Договор);
	ОбновитьДатыВозвратаСобственникуИИнструкции();
	//ДИТ Авдеева В.С. 48934 21.04.2022 Начало
	//ПересчитатьДополнительныеДанные();
	//ДИТ Авдеева В.С. 48934 21.04.2022 Конец
	//-- Зубов US 33131 TA 38910 26.10.2021
	
	//++ Зубов US 33131 TA 43877 15.12.2021
	//++ Дудоров С.В. TASK 66585 17.03.2023	
	//Элементы.ДоплатныеКТК.ТолькоПросмотр = Объект.Проведен ИЛИ Объект.МорскиеКТК;
	//Элементы.МорскиеКТК.ТолькоПросмотр = Объект.Проведен ИЛИ Объект.ДоплатныеКТК;
	//Элементы.Номинациитек_СобственностьКТК.ТолькоПросмотр = Объект.ДоплатныеКТК ИЛИ Объект.МорскиеКТК;
	
	Элементы.ДоплатныеКТК.ТолькоПросмотр   = Объект.Проведен ИЛИ Объект.МорскиеКТК или Объект.СобственныеКТК;
	Элементы.МорскиеКТК.ТолькоПросмотр     = Объект.Проведен ИЛИ Объект.ДоплатныеКТК или Объект.СобственныеКТК;
	
	Элементы.Номинациитек_СобственностьКТК.ТолькоПросмотр = Объект.ДоплатныеКТК ИЛИ Объект.МорскиеКТК
		или Объект.СобственныеКТК;
	
	Элементы.СобственныеКТК.ТолькоПросмотр = Объект.Проведен ИЛИ Объект.ДоплатныеКТК ИЛИ Объект.МорскиеКТК;
	ВидимостьПолейПриСобственномКТК();
	//-- Дудоров С.В. TASK 66585 17.03.2023	
	Элементы.НоминацииГруппаДанныеДоплатныхКТК.Видимость = Объект.ДоплатныеКТК;
	
	Элементы.НоминацииДатаАктуальностиЗаписи.Видимость = ПроверкаРоли("ПолныеПрава");
	
	НовыйМассив = Новый Массив();
	Если Объект.ДоплатныеКТК Тогда                                                           
				                            
		//ДИТ, Маршев ЕС, Ticket#0274112, 10-04-2024, начало
		НовыйПараметр = Новый ПараметрВыбора("Отбор.ВидДоговора", ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем"));
		НовыйМассив.Добавить(НовыйПараметр);
		//ДИТ, Маршев ЕС, Ticket#0274112, 10-04-2024, конец

	Иначе
		НовыйПараметр = Новый ПараметрВыбора("Отбор.ВидДоговора", ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком"));
		НовыйМассив.Добавить(НовыйПараметр);
	КонецЕсли;	
	НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
	Элементы.Договор.ПараметрыВыбора = НовыеПараметры;
	//-- Зубов US 33131 TA 43877 15.12.2021
	
	// ++ ДИТ_Агафонов_task 50388 08.07.2022
	Если Объект.КолвоРелизКлиентаНеСовпадаетТипоразмерКТК>0 или Объект.КолвоРелизКлиентаНоваяЗаписьКТК Тогда
		КолвоРелизКлиентаНеСовпадаетТипоразмерКТК_КолвоНаПроверку=0;
		КолвоРелизКлиентаНеСовпадаетТипоразмерКТК_СписокСтрок="";
		КолвоРелизКлиентаНоваяЗаписьКТК_КолвоНаПроверку=0;
		КолвоРелизКлиентаНоваяЗаписьКТК_СписокСтрок="";
		ВсегоКолво = Объект.Номинации.Количество();
		Для каждого СтрокаНоминации Из Объект.Номинации Цикл
			Если СтрокаНоминации.РелизКлиентаНеСовпадаетТипоразмерКТК и не СтрокаНоминации.РелизКлиентаНеСовпадаетТипоразмерКТК_Выполнено Тогда
				КолвоРелизКлиентаНеСовпадаетТипоразмерКТК_КолвоНаПроверку = КолвоРелизКлиентаНеСовпадаетТипоразмерКТК_КолвоНаПроверку +1;
				КолвоРелизКлиентаНеСовпадаетТипоразмерКТК_СписокСтрок = КолвоРелизКлиентаНеСовпадаетТипоразмерКТК_СписокСтрок +
				" "+СтрокаНоминации.НомерСтроки+";";
			КонецЕсли;
			Если СтрокаНоминации.РелизКлиентаНоваяЗаписьКТК и не СтрокаНоминации.РелизКлиентаНоваяЗаписьКТК_Выполнено Тогда
				КолвоРелизКлиентаНоваяЗаписьКТК_КолвоНаПроверку = КолвоРелизКлиентаНоваяЗаписьКТК_КолвоНаПроверку +1;
				КолвоРелизКлиентаНоваяЗаписьКТК_СписокСтрок = КолвоРелизКлиентаНоваяЗаписьКТК_СписокСтрок +
				" "+СтрокаНоминации.НомерСтроки+";";
			КонецЕсли;
		КонецЦикла;	
		Если КолвоРелизКлиентаНеСовпадаетТипоразмерКТК_КолвоНаПроверку>0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Обнаружено несоответствие типоразмера для "+КолвоРелизКлиентаНеСовпадаетТипоразмерКТК_КолвоНаПроверку+" КТК при сравнении данных из сообщений CODECO c данными DC. Проверьте строки:"+КолвоРелизКлиентаНеСовпадаетТипоразмерКТК_СписокСтрок	
			);
		КонецЕсли;
		Если КолвоРелизКлиентаНоваяЗаписьКТК_КолвоНаПроверку>0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Из-за отсутствия соотв. номера КТК либо несоотв. типоразмера КТК в релиз добавлены доп. строки из связанного релиза клиента:"+ КолвоРелизКлиентаНоваяЗаписьКТК_СписокСтрок
			+Символы.ПС+" Необходимо уменьшить общее кол-во строк в релизе собственника для приведения к исходному значению – "+Строка(ВсегоКолво-КолвоРелизКлиентаНоваяЗаписьКТК_КолвоНаПроверку)+", либо принять текущее значение – "+ВсегоКолво+", а также проверить необходимость согласования изменения условий аренды КТК и корректировки связанных документов"
			);
		КонецЕсли;
	КонецЕсли;
	// -- ДИТ_Агафонов_task 50388 08.07.2022 
	
	//ДИТ Авдеева В.С. 53518 19.08.2022 Начало
	ПересчитатьОсталосьКВозврату();
	//ДИТ Авдеева В.С. 53518 19.08.2022 Конец 	
	
	//ДИТ, Беляев СЮ, US 83045 / TA 85275, 16-05-2024, начало
	МассивТиповЛокаций = Новый Массив;
	МассивТиповЛокаций.Добавить(ПредопределенноеЗначение("Справочник.ТипыЛокаций.НаселенныйПункт"));
	МассивТиповЛокаций.Добавить(ПредопределенноеЗначение("Справочник.ТипыЛокаций.Регион"));
	МассивТиповЛокаций.Добавить(ПредопределенноеЗначение("Справочник.ТипыЛокаций.Страна"));
	
	МассивПараметровВыбора = Новый Массив;
	МассивПараметровВыбора.Добавить(Новый ПараметрВыбора("Отбор.Тип", Новый ФиксированныйМассив(МассивТиповЛокаций)));

	Элементы.ЛокацияСдачи.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);
	//ДИТ, Беляев СЮ, US 83045 / TA 85275, 16-05-2024, конец
	
	// Евросиб US 88643 TA 88646 Рыбьяков К.А. 10.09.2024 ((
	УстановитьДоступность();
