&НаКлиенте
Процедура ОбработкаВставкиExcel(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	
	Если Параметр1 <> неопределено И Параметр2 <> неопределено И Параметр2.Свойство("КТК") Тогда
		
		Для Сч = 0 по Параметр1.КТК.Количество()-1 Цикл
			//++ Зубов US 33131 TA 38910 01.11.2021
			//Если НЕ СтатусКТКВозвращен(Параметр1.КТК[Сч]) Тогда
			//	Сообщить("Необходимо закрыть предыдущий цикл пользования контейнером "+Параметр1.КТК[Сч]+" перед внесением его номера в карточку релиза");
			//Иначе
			//-- Зубов US 33131 TA 38910 01.11.2021
				//++ Зубов US 33131 TA 38910 27.10.2021
				ПОтбора = Новый СТруктура("Контейнер",Параметр1.КТК[Сч]);
				НайденныеСтроки = Объект.Номинации.НайтиСтроки(ПОтбора);
				Если НайденныеСтроки.Количество()>0 Тогда
					Сообщить("Данный контейнер: "+Параметр1.КТК[Сч]+" уже добавлен!");
				Иначе
				//-- Зубов US 33131 TA 38910 27.10.2021
				НСтр = Объект.Номинации.Добавить();
				НСтр.Контейнер = Параметр1.КТК[Сч];
				//ТипИРазмер = РаботаСКонтейнерамиСервер.ПолучитьТипИРазмер(НСтр.Контейнер);
				// Евросиб US 121115 TA 121177 Рыбьяков К.А. 08.10.2025 ((
				//НСтр.ТипКТК = Параметр1.РазмерКТК[Сч];
				НСтр.ТипКТК = РаботаСКонтейнерамиСервер.ПолучитьТипИРазмер(НСтр.Контейнер).Тип;
				// Евросиб Рыбьяков К.А. 08.10.2025 ))
				
				// Евросиб US 88643 TA 88646 Рыбьяков К.А. 10.12.2024 ((
				ДанныеЗаполнения = ДанныеПоОсновнойСтавке(НСтр.ТипКТК);
				ЗаполнитьЗначенияСвойств(НСтр, ДанныеЗаполнения);
				// Евросиб Рыбьяков К.А. 10.12.2024 ))
				
				//НСтр.ДатаАктуальностиЗаписи = ТекущаяДата();
				//Евросиб(ДИТ), Беляев СЮ, BUG 94917 / TA 96390, 27-11-2024, начало
				Если РелизПоКонтейнеруАктуален(Объект.Ссылка, НСтр.Контейнер) Тогда
					НСтр.ДатаАктуальностиЗаписи = ТекущаяДата();
				КонецЕсли;
				//Евросиб(ДИТ), Беляев СЮ, BUG 94917 / TA 96390, 27-11-2024, конец
							
				//++ Зубов BUG 40946 TA 41043 25.10.2021
				НСтр.ГУИДСтроки = Новый УникальныйИдентификатор;
				//-- Зубов BUG 40946 TA 41043 25.10.2021
				//++ Зубов US 33131 TA 38910 27.10.2021
				
				//++ Зубов US 45162 TA 45703 21.01.2022
				Если (Параметр1.ДатыКТК[Сч] >= ПериодДействия.ДатаНачала И Параметр1.ДатыКТК[Сч] <= ПериодДействия.ДатаОкончания) ИЛИ Параметр1.ДатыКТК[Сч] = Дата("00010101") ИЛИ Объект.СобственныеКТК Тогда
					НСтр.ДатаВзятия = Параметр1.ДатыКТК[Сч];
				Иначе
					Сообщить("По КТК "+Параметр1.КТК[Сч]+" дата взятия "+Параметр1.ДатыКТК[Сч]+" не будет перенесена в документ, так как она не входит в период действия релиза "+ПериодДействия);
				КонецЕсли;
				//-- Зубов US 45162 TA 45703 21.01.2022
				// ДИТ US 93168 ТА 95626 Лаврентьев О.М. Начало: 26.11.2024  
				НСтр.ДатаИзготовленияКТК = Параметр1.ДатаИзготовленияКТК[Сч];
				//ЗаписатьДатуИзготовленияКонтейнера(НСтр.Контейнер, НСтр.ДатаИзготовленияКТК); //Евросиб(ДИТ), Беляев СЮ, BUG 97038 / TA 97047, 06-12-2024, закомментировал
				// ДИТ US 93168 ТА 95626 Лаврентьев О.М. Конец: 26.11.2024
					//++ Зубов US 33131 TA 43877 16.12.2021
					Если Объект.ДоплатныеКТК Тогда
						// ДИТ 65580 Давудов М.А. Начало: 23.02.2023
						//Было:
						//НСтр.тек_СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.Доплатные");
						//Стало:
						НСтр.тек_СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.СпотДоплатный");
						// ДИТ 65580 Давудов М.А. Конец: 23.02.2023
					ИначеЕсли Объект.МорскиеКТК Тогда
						НСтр.тек_СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.Спот");
						// Евросиб Ситников К.А. 09.07.2025 Task 113980
		            ИначеЕсли Объект.СобственныеКТК Тогда
			            НСтр.тек_СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.Собственный");		
		                // Евросиб Ситников К.А. 09.07.2025 Task 113980
					КонецЕсли;
					//-- Зубов US 33131 TA 43877 16.12.2021
					//++ Зубов Ticket#0257074 17.01.2022
					Если ЗаполнятьПоПервойСтроке Тогда
						Если Объект.Номинации.Количество()>0 Тогда
							ПерваяСтрока = Объект.Номинации[0]; 
							НСтр.тек_СобственностьКТК = ПерваяСтрока.тек_СобственностьКТК;
							НСтр.ДатаВзятия = ПерваяСтрока.ДатаВзятия;
							НСтр.НормативВозврата = ПерваяСтрока.НормативВозврата; 
							НСтр.Ставка = ПерваяСтрока.Ставка;
							НСтр.Валюта = ПерваяСтрока.Валюта;
							НСтр.СНП = ПерваяСтрока.СНП;
							НСтр.допл_Калькуляция = ПерваяСтрока.допл_Калькуляция;
							НСтр.СтавкаНДС = ПерваяСтрока.СтавкаНДС;
							НСтр.НДСВключая = ПерваяСтрока.НДСВключая; 
							// ДИТ US 93168 ТА 95626 Лаврентьев О.М. Начало: 26.11.2024  
							НСтр.ДатаИзготовленияКТК = ПерваяСтрока.ДатаИзготовленияКТК;
							// ДИТ US 93168 ТА 95626 Лаврентьев О.М. Конец: 26.11.2024

						КонецЕсли;		
					КонецЕсли;
					//-- Зубов Ticket#0257074 17.01.2022
				КонецЕсли;
				//-- Зубов US 33131 TA 38910 27.10.2021
			//КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	//++ Зубов US 33131 TA 38910 27.10.2021
	ОбновитьДоступностьРелиза();
	ПересчитатьДополнительныеДанные();
	
	ОбновитьДатыВозвратаСобственникуИИнструкции();
	ОбновитьДанныеПослКлиентовИЗаявок();
	//-- Зубов US 33131 TA 38910 27.10.2021	
	// Евросиб US 88643 TA 88646 Рыбьяков К.А. 30.10.2024 ((
	СравнитьТаблицыПоКонтейнерам();
	// Евросиб Рыбьяков К.А. 30.10.2024 ))
КонецПроцедуры

&НаКлиенте
Процедура НоминацииСНПОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекД = Элементы.Номинации.ТекущиеДанные;
	Если ТекД <> неопределено тогда
		
		ТаблицаТекущихСНП = Новый Массив;
		Для каждого Стр из Объект.СНП Цикл
			//++ Зубов BUG 40946 TA 41043 25.10.2021
			//Если Стр.ИсхНомерСтроки = ТекД.ИсходныйНомерСтроки Тогда
			Если Стр.ГУИДСтроки = ТекД.ГУИДСтроки Тогда
			//-- Зубов BUG 40946 TA 41043 25.10.2021
				ТаблицаТекущихСНП.Добавить(Новый Структура("От, До, Стоимость", Стр.От, Стр.До, Стр.Стоимость));
			КонецЕсли;
		КонецЦикла;
		ОпОп = Новый ОписаниеОповещения("ОбработкаТаблицыСНП", ЭтаФорма);
		ОткрытьФорму("Документ.ПСЦ.Форма.ФормаПрогрессивнойШкалыСНП", Новый Структура("ТаблицаТекущихСНП", ТаблицаТекущихСНП),, ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаТаблицыСНП(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = неопределено Тогда Возврат; КонецЕсли;
	
	НайдСтроки = Новый Массив;
	Для каждого Стр из Объект.СНП Цикл
		//++ Зубов BUG 40946 TA 41043 25.10.2021
		//Если Стр.ИсхНомерСтроки = Элементы.Номинации.ТекущиеДанные.ИсходныйНомерСтроки Тогда
		Если Стр.ГУИДСтроки = Элементы.Номинации.ТекущиеДанные.ГУИДСтроки Тогда
		//-- Зубов BUG 40946 TA 41043 25.10.2021
			НайдСтроки.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;
	
	Если ЗаполнятьПоПервойСтроке Тогда
		Объект.СНП.Очистить();
	Иначе
		Для каждого Стр из НайдСтроки Цикл Объект.СНП.Удалить(Стр); КонецЦикла;
	КонецЕсли;
	
	СписокДобавляемыхСтрок = Новый массив;
	Если ЗаполнятьПоПервойСтроке Тогда
		Для каждого Стр из Объект.Номинации Цикл
			//++ Зубов BUG 40946 TA 41043 25.10.2021
			//СписокДобавляемыхСтрок.Добавить(Стр.ИсходныйНомерСтроки);
			СписокДобавляемыхСтрок.Добавить(Стр.ГУИДСтроки);
			//-- Зубов BUG 40946 TA 41043 25.10.2021
		КонецЦикла;
	Иначе
		//++ Зубов BUG 40946 TA 41043 25.10.2021
		//СписокДобавляемыхСтрок.Добавить(Элементы.Номинации.ТекущиеДанные.ИсходныйНомерСтроки);
		СписокДобавляемыхСтрок.Добавить(Элементы.Номинации.ТекущиеДанные.ГУИДСтроки);
		//-- Зубов BUG 40946 TA 41043 25.10.2021
	КонецЕсли;
	
	Для каждого ИсхНСтроки из СписокДобавляемыхСтрок Цикл
		
		Для каждого Стр из П1 Цикл
			
			НСтр = Объект.СНП.Добавить();
			//++ Зубов BUG 40946 TA 41043 25.10.2021
			//НСтр.ИсхНомерСтроки = ИсхНСтроки;
			НСтр.ГУИДСтроки = ИсхНСтроки;
			//-- Зубов BUG 40946 TA 41043 25.10.2021
			НСтр.От = Стр.От;
			НСтр.До = Стр.До;
			НСтр.Стоимость = Стр.Стоимость;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ПересчитатьСуммыСНП();
	
КонецПроцедуры


&НаКлиенте
Процедура НоминацииСНППриИзменении(Элемент)
	
	ТекД = Элементы.Номинации.ТекущиеДанные;
	НайдСтроки = Новый Массив;
	Для каждого Стр из Объект.СНП Цикл
		//++ Зубов BUG 40946 TA 41043 25.10.2021
		//Если Стр.ИсхНомерСтроки = ТекД.ИсходныйНомерСтроки Тогда
		Если Стр.ГУИДСтроки = ТекД.ГУИДСтроки Тогда
		//-- Зубов BUG 40946 TA 41043 25.10.2021
			НайдСтроки.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;
	
	
	Если ЗаполнятьПоПервойСтроке Тогда
		Объект.СНП.Очистить();
	Иначе
		Для каждого Стр из НайдСтроки Цикл Объект.СНП.Удалить(Стр); КонецЦикла;
	КонецЕсли;
	
	Если ТекД.СНП <> 0 Тогда
		
		НСтр = Объект.СНП.Добавить();
		//++ Зубов BUG 40946 TA 41043 25.10.2021
		//НСтр.ИсхНомерСтроки = ТекД.ИсходныйНомерСтроки;
		НСтр.ГУИДСтроки = ТекД.ГУИДСтроки;
		//-- Зубов BUG 40946 TA 41043 25.10.2021
		НСтр.От = 0;
		НСтр.До = 999999;
		НСтр.Стоимость = ТекД.СНП;
		
		Если ЗаполнятьПоПервойСтроке Тогда
			Для каждого Стр из Объект.Номинации Цикл
				//++ Зубов BUG 40946 TA 41043 25.10.2021
				//Если Стр.ИсходныйНомерСтроки <> ТекД.ИсходныйНомерСтроки Тогда
				Если Стр.ГУИДСтроки <> ТекД.ГУИДСтроки Тогда
				//-- Зубов BUG 40946 TA 41043 25.10.2021
					НСтр = Объект.СНП.Добавить();
					//++ Зубов BUG 40946 TA 41043 25.10.2021
					//НСтр.ИсхНомерСтроки = Стр.ИсходныйНомерСтроки;
					НСтр.ГУИДСтроки = Стр.ГУИДСтроки;
					//-- Зубов BUG 40946 TA 41043 25.10.2021
					НСтр.От = 0;
					НСтр.До = 999999;
					НСтр.Стоимость = ТекД.СНП;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	ПересчитатьСуммыСНП();
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСуммыСНП()
	
	// Евросиб US 89887 TA 93716 Рыбьяков К.А. 05.03.2025 ((
	Для каждого СтрокаНоминации из Объект.Номинации Цикл
		
		// Евросиб US 112646 TA 112819 Рыбьяков К.А. 06.07.2025 ((
		Если Не ЗначениеЗаполнено(СтрокаНоминации.ВалютаСНП) И Не Объект.НаОсновании Тогда
			СтрокаНоминации.ВалютаСНП = СтрокаНоминации.Валюта;
		КонецЕсли;
		// Евросиб Рыбьяков К.А. 06.07.2025 ))
		
		ИтогСумма = 0;
		НайдСтроки = Новый Массив;
		
		Если СтрокаНоминации.СтавкаПрогрессивная Тогда
			
			УстановитьТекстСтавки(СтрокаНоминации);
			
		Иначе
			// Евросиб Рыбьяков К.А. 05.03.2025 ))
			
			Для Каждого СтрокаСНП иЗ Объект.СНП Цикл
				//++ Зубов BUG 40946 TA 41043 25.10.2021
				//Если Стр2.ИсхНомерСтроки = Стр.ИсходныйНомерСтроки Тогда
				Если СтрокаСНП.ГУИДСтроки = СтрокаНоминации.ГУИДСтроки Тогда
					//++ Зубов BUG 40946 TA 41043 25.10.2021
					НайдСтроки.Добавить(СтрокаСНП);
				КонецЕсли;
			КонецЦикла;
			Для Каждого СтрокаСНП Из НайдСтроки Цикл 
				ИтогСумма = Макс(ИтогСумма, СтрокаСНП.Стоимость); 
			КонецЦикла;
			СтрокаНоминации.СНП = ИтогСумма;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТекстСтавки(СтрокаНоминации, СтрокиШкалы = Неопределено)
	
	// Евросиб US 89887 TA 93716 Рыбьяков К.А. 05.03.2025 ((
	Если СтрокиШкалы = Неопределено Тогда
		СтрокиШкалы = Объект.СНП.НайтиСтроки(Новый Структура("ГУИДСтроки", СтрокаНоминации.ГУИДСтроки));
	КонецЕсли;
	
	ТекстСтавкиБезНДС = "";
	Для каждого Стр из СтрокиШкалы Цикл
			
		Если Стр.От = 0 И Стр.До = 0 Тогда
			ТекстСтавкиБезНДС = Строка(Стр.Стоимость);
		ИначеЕсли Стр.От = 0 И Стр.До <> 0 Тогда
			ТекстСтавкиБезНДС = "От 0 до " + Стр.До + " - " + Стр.Стоимость + Символы.ПС;
		ИначеЕсли Стр.От <> 0 И Стр.До <> 0 Тогда
			ТекстСтавкиБезНДС = ТекстСтавкиБезНДС + "С " + Стр.От + " до " + Стр.До + " - " + Стр.Стоимость + Символы.ПС;
		ИначеЕсли Стр.От <> 0 И Стр.До = 0 Тогда
			ТекстСТавкиБезНДС = ТекстСтавкиБезНДС + "С " + Стр.От + " и далее - " + Стр.Стоимость;
		КонецЕсли;
		
	КонецЦикла;
	
	СтрокаНоминации.СНППрогрессивная = ТекстСтавкиБезНДС;
	// Евросиб Рыбьяков К.А. 05.03.2025 ))
КонецПроцедуры

