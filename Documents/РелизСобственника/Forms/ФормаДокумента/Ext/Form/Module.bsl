КонецПроцедуры

&НаСервере
Функция ВидыПеревозок(Калькуляции)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Калькуляция.ПС_ВидПеревозки КАК ВидПеревозки
	|ИЗ
	|	Документ.Калькуляция КАК Калькуляция
	|ГДЕ
	|	Калькуляция.Ссылка В(&Калькуляции)
	|
	|СГРУППИРОВАТЬ ПО
	|	Калькуляция.ПС_ВидПеревозки";
	
	Запрос.УстановитьПараметр("Калькуляции", Калькуляции);
	
	Выгрузка = Запрос.Выполнить().Выгрузить();
	
	Если Выгрузка.Количество() = 1 Тогда
		Результат = Выгрузка[0].ВидПеревозки;
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ДанныеЗаполненияДляПротокола()

	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("Подразделение", 
		Справочники.Подразделения.ПолучитьСсылку(Новый УникальныйИдентификатор("215f577d-d5f2-11e9-b813-00155dfba800")));
	ДанныеЗаполнения.Вставить("Контрагент", Объект.Контрагент);
	ДанныеЗаполнения.Вставить("Договор", Объект.Договор);
	ДанныеЗаполнения.Вставить("Основание", Объект.Ссылка);
	
	КоличествоСтавокНДС = Объект.Номинации.Выгрузить(, "СтавкаНДС");
	КоличествоСтавокНДС.Свернуть("СтавкаНДС");
	Если КоличествоСтавокНДС.Количество() = 1 Тогда
		ДанныеЗаполнения.Вставить("СтавкаНДС", КоличествоСтавокНДС[0].СтавкаНДС);
	КонецЕсли;
	
	КоличествоСтавокВключаютНДС = Объект.Номинации.Выгрузить(, "НДСВключая");
	КоличествоСтавокВключаютНДС.Свернуть("НДСВключая");
	Если КоличествоСтавокВключаютНДС.Количество() = 1 Тогда
		ДанныеЗаполнения.Вставить("НДСВключая", КоличествоСтавокВключаютНДС[0].НДСВключая);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Калькуляция.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.Калькуляция КАК Калькуляция
	               |ГДЕ
	               |	Калькуляция.Договор = &Договор
	               |	И Калькуляция.Организация = &Организация
	               |	И Калькуляция.Контрагент = &Контрагент
	               |	И Калькуляция.ДокументОснование = &ДокументОснование
	               |	И НЕ Калькуляция.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ДокументОснование", Объект.Ссылка);
	Запрос.УстановитьПараметр("Договор", Объект.Договор);
	Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	КалькуляцииДоплатныхКТК = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ОбщегоНазначенияКлиентСервер.УдалитьВсеВхожденияЗначенияИзМассива(КалькуляцииДоплатныхКТК, Документы.Калькуляция.ПустаяСсылка());
	ДанныеЗаполнения.Вставить("Калькуляции", КалькуляцииДоплатныхКТК);
	ДанныеЗаполнения.Вставить("ВидПеревозки", ВидыПеревозок(КалькуляцииДоплатныхКТК));
	
	Возврат ДанныеЗаполнения;

КонецФункции 

&НаСервере
Функция ДанныеЗаполненияСчетаНаОплату(ВыбранныеСтроки)
		
	Возврат Документы.РелизСобственника.ДанныеЗаполненияСчетаНаОплату(ВыбранныеСтроки, Объект.Ссылка);
	
КонецФункции

&НаСервере
Процедура ЗаписатьСчетВКлючиАналитики(СчетНаОплату, КлючиАналитики)
	
	УстановитьПривилегированныйРежим(Истина);
	Для Каждого Ключ Из КлючиАналитики Цикл
		КлючАналитикиСтроки = Ключ.ПолучитьОбъект();
		КлючАналитикиСтроки.СчетНаОплатуПокупателю = СчетНаОплату;
		КлючАналитикиСтроки.Записать();
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ПослеСозданияСчетаНаОплатуПокупателю(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	Иначе
		ЗаписатьСчетВКлючиАналитики(Результат, Параметры);
	КонецЕсли;
	
	ЭтаФорма.Прочитать();

КонецПроцедуры

&НаКлиенте
Процедура ПослеСозданияПротокола(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	Иначе
		Объект.ПСЦ = Результат;
		Если Объект.Проведен Тогда
			РезультатЗаписи = Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
		Иначе
			РезультатЗаписи = Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись));
		КонецЕсли;
		Если Не РезультатЗаписи Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ЭтаФорма.Прочитать();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуПоКлючамАналитики()
	
	Ключи = Новый Массив;
	
	Для Каждого Строка из Объект.Номинации Цикл
		Ключи.Добавить(Строка.КлючАналитики);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КлючиАналитикиНоминацийРелиза.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю,
	|	КлючиАналитикиНоминацийРелиза.Калькуляция КАК Калькуляция,
	|	КлючиАналитикиНоминацийРелиза.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
	|	КлючиАналитикиНоминацийРелиза.СтокВыдачи КАК СтокВыдачи,
	|	КлючиАналитикиНоминацийРелиза.ДатаВозвратаКлиентом КАК ДатаВозвратаКлиентом,
	// Евросиб US 88677 TA 88681 Рыбьяков К.А. 12.12.2024 ((
	|	КлючиАналитикиНоминацийРелиза.КлючАналитикиПеревозки.КлючАналитикиСоставаПоезда.Сделка КАК Сделка,
	// Евросиб Рыбьяков К.А. 12.12.2024 ))
	|	КлючиАналитикиНоминацийРелиза.Ссылка КАК КлючАналитики
	|ИЗ
	|	Справочник.КлючиАналитикиНоминацийРелиза КАК КлючиАналитикиНоминацийРелиза
	|ГДЕ
	|	КлючиАналитикиНоминацийРелиза.Ссылка В(&Ключи)";
	
	Запрос.УстановитьПараметр("Ключи", Ключи);
	
	РеквизитыКлюча = Запрос.Выполнить().Выбрать();
		
	Пока РеквизитыКлюча.Следующий() Цикл
		НайденныеСтроки = Объект.Номинации.НайтиСтроки(Новый Структура("КлючАналитики", РеквизитыКлюча.КлючАналитики));
		НайденныеСтроки[0].допл_СчетНаОплату = РеквизитыКлюча.СчетНаОплатуПокупателю;
		НайденныеСтроки[0].допл_Калькуляция = РеквизитыКлюча.Калькуляция;
		// Евросиб US 88677 TA 88681 Рыбьяков К.А. 12.12.2024 ((	
		//НайденныеСтроки[0].допл_Сделка = РеквизитыКлюча.Сделка;
		// Евросиб Рыбьяков К.А. 12.12.2024 ))
		НайденныеСтроки[0].допл_СтокВыдачи = РеквизитыКлюча.СтокВыдачи;
		НайденныеСтроки[0].допл_ДатаВозвратаКлиентом = РеквизитыКлюча.ДатаВозвратаКлиентом;
	КонецЦикла;
	
КонецПроцедуры

