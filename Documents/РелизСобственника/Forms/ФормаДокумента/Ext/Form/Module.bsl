&НаКлиенте
Процедура ОчиститьПоляПриСобственномКТК()
	мПоляНевидимыеПриСобственномКТК = ПоляНевидимыеПриСобственномКТК.ВыгрузитьЗначения();
	Для каждого Поле из мПоляНевидимыеПриСобственномКТК Цикл
		Если Поле = "ПунктыСдачи" Тогда
			Объект.ВозможныеСтокиСдачи = ПустоеЗначениеТипа(ТипЗнч(Объект.ВозможныеСтокиСдачи));
		ИначеЕсли Поле = "ПериодДействия" Тогда	
			ПериодДействия.ДатаНачала    = '00010101';
			ПериодДействия.ДатаОкончания = '00010101';
			Объект.НачалоДействия        = '00010101';
			Объект.ОкончаниеДействия     = '00010101';
		ИначеЕсли Поле = "Заполненность" Тогда	
			Объект.Реализованность   = ПустоеЗначениеТипа(ТипЗнч(Объект.Реализованность));
		// ДИТ_Алексеев А.А. 2024-07-26 #0360281 Начало
		// была ошибка при получении незаполненного значения для поля составного типа (напр. "ЛокацияСдачи")
		ИначеЕсли Объект[Поле] = Неопределено Тогда
			Продолжить;
		// ДИТ_Алексеев А.А. 2024-07-26 #0360281 Конец
		Иначе	
			Объект[Поле] = ПустоеЗначениеТипа(ТипЗнч(Объект[Поле]));
		КонецЕсли;
	КонецЦикла;

	мПоляНевидимыеПриСобственномКТК = ПоляНоминацииНевидимыеПриСобственномКТК.ВыгрузитьЗначения();
	Для Каждого СтрНоменации из Объект.Номинации Цикл
		Для каждого Реквизит из мПоляНевидимыеПриСобственномКТК Цикл
			СтрНоменации[Реквизит] = ПустоеЗначениеТипа(ТипЗнч(СтрНоменации[Реквизит]));
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

