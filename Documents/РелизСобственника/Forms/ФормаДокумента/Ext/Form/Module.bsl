&НаКлиенте
Процедура ПересчитатьДополнительныеДанные()
	Объект.ОбщееКоличествоВРелизе = Объект.Номинации.Количество();
	КоличествоНомерных = 0;
	КоличествоБезномерных = 0;
	ОсталосьКВыдаче = 0;
	ОсталосьКВозврату = 0;
	Для каждого СтрокаНоминации из Объект.Номинации Цикл
		Если ЗначениеЗаполнено(СтрокаНоминации.Контейнер) Тогда
			КоличествоНомерных = КоличествоНомерных+1;
		Иначе
			КоличествоБезномерных = КоличествоБезномерных+1;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаНоминации.ДатаВзятия) Тогда
			Если Не ЗначениеЗаполнено(СтрокаНоминации.ДатаВозвратаСобственнику) Тогда
				ОсталосьКВозврату = ОсталосьКВозврату+1;
			КонецЕсли;
		Иначе
			ОсталосьКВыдаче = ОсталосьКВыдаче+1;
		КонецЕсли;
	КонецЦикла;
	Объект.КоличествоБезномерных = КоличествоБезномерных;
	Объект.КоличествоНомерных = КоличествоНомерных;
	Объект.ОсталосьКВыдаче = ОсталосьКВыдаче;
КонецПроцедуры


