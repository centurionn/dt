//Евросиб(ДИТ), Беляев СЮ, BUG 94917 / TA 96390, 27-11-2024, начало
&НаКлиенте
Функция ПолучитьМассивКонтейнеровПоКоторымРелизАктуален(ТабЧасть)
	МассивКонтейнеров = Новый Массив;
	
	Для Сч = 0 По ТабЧасть.Количество() - 1 Цикл
		СтрокаТаблицы = ТабЧасть[Сч];
		МассивКонтейнеров.Добавить(СтрокаТаблицы.Контейнер);
	КонецЦикла;
	
	Возврат МассивКонтейнеровПоКоторымРелизАктуален(Объект.Ссылка, МассивКонтейнеров);
	
КонецФункции
//Евросиб(ДИТ), Беляев СЮ, BUG 94917 / TA 96390, 27-11-2024, конец

