// Евросиб US 88677 TA 88681 Рыбьяков К.А. 12.12.2024 ((
&НаСервере
Процедура ЗаполнитьСтокСдачиИзРСАРМТекущиеДанные()
	
	МассивКонтейнеров = Новый Массив;
	
	Для Каждого СтрокаНоминаций Из Объект.Номинации Цикл
		Если ЗначениеЗаполнено(СтрокаНоминаций.Контейнер) Тогда
			МассивКонтейнеров.Добавить(СтрокаНоминаций.Контейнер);
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	стоки_ТекущиеДанныеСрезПоследних.КТК КАК КТК,
	|	стоки_ТекущиеДанныеСрезПоследних.тек_СтокСдачи КАК СтокСдачи
	|ИЗ
	|	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних(
	|			&Дата,
	|			тек_Релиз = &Релиз
	|				И КТК В (&Контейнеры)
	|				И тек_СтокСдачи <> Значение(Справочник.Локации.ПустаяСсылка)) КАК стоки_ТекущиеДанныеСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Контейнеры", МассивКонтейнеров);
	Запрос.УстановитьПараметр("Релиз", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Для Каждого СтрокаНоминаций Из Объект.Номинации Цикл
			Если Выборка.КТК = СтрокаНоминаций.Контейнер Тогда
				СтрокаНоминаций.СтокCдачи = Выборка.СтокСдачи;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

