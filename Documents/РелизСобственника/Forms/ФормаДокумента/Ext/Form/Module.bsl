&НаКлиенте
Процедура НоминацииПриАктивизацииСтроки(Элемент)
	ТекД = Элементы.Номинации.ТекущиеДанные;
	Если НЕ ТекД = Неопределено Тогда
		Если ЗначениеЗаполнено(ТекД.ДатаВозвратаСобственнику) И УжеВведенРелизсПозднейДатой(ТекД.Контейнер,ТекД.ДатаВзятия) Тогда
			Элементы.НоминацииГруппаДанныеКТК.ТолькоПросмотр = Истина;
			Элементы.НоминацииГруппаНоминирование.ТолькоПросмотр = Истина;
			Элементы.НоминацииГруппаДанныеДоплатныхКТК.ТолькоПросмотр = Истина;
		Иначе
			Если ЗначениеЗаполнено(ТекД.Контейнер) И ЗначениеЗаполнено(ТекД.ТипКТК) Тогда
				Если ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(ТекД.Контейнер,"ТипТЕ").ТипТЕ = ТекД.ТипКТК Тогда
					Элементы.НоминацииТипКТК.ТолькоПросмотр = Истина;
				Иначе
					Элементы.НоминацииТипКТК.ТолькоПросмотр = Ложь;
				КонецЕсли;
			Иначе
				Элементы.НоминацииТипКТК.ТолькоПросмотр = Ложь;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(ТекД.Контейнер) Тогда
				Элементы.НоминацииДатаВзятия.ТолькоПросмотр = Истина;
			Иначе
				Элементы.НоминацииДатаВзятия.ТолькоПросмотр = Ложь;
			КонецЕсли;
			Элементы.НоминацииГруппаДанныеКТК.ТолькоПросмотр = Ложь;
			Элементы.НоминацииГруппаНоминирование.ТолькоПросмотр = Ложь;
			Элементы.НоминацииГруппаДанныеДоплатныхКТК.ТолькоПросмотр = Ложь;
		КонецЕсли;
		//++ Зубов US 45162 TA 45219 20.01.2022
		//Если ТекД.тек_СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.Спот") Тогда
		//	Элементы.НоминацииСтавка0.ТолькоПросмотр = Ложь;
		//Иначе
		//	Элементы.НоминацииСтавка0.ТолькоПросмотр = Истина;
		//КонецЕсли;
		//-- Зубов US 45162 TA 45219 20.01.2022
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция УжеВведенРелизсПозднейДатой(КТК,ДатаВзятия)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РелизСобственникаНоминации.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
		|ГДЕ
		|	РелизСобственникаНоминации.Контейнер = &КТК
		|	И РелизСобственникаНоминации.ДатаВзятия > &ДатаВзятия
		|	И РелизСобственникаНоминации.Ссылка.Проведен";
	
	Запрос.УстановитьПараметр("ДатаВзятия", ДатаВзятия);
	Запрос.УстановитьПараметр("КТК", КТК);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Количество()>0 Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ОбновитьДатыВозвратаСобственникуИИнструкции()
	Для каждого СтрокаНоминации из Объект.Номинации Цикл
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	стоки_ТекущиеДанныеСрезПоследних.тек_ДатаСдачиВСток КАК тек_ДатаСдачиВСток,
			|	стоки_ТекущиеДанныеСрезПоследних.тек_ИнструкцияПоСдаче КАК тек_ИнструкцияПоСдаче
			|ИЗ
			|	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних(
			|			,
			|			КТК = &КТК
			|				И тек_Релиз = &тек_Релиз) КАК стоки_ТекущиеДанныеСрезПоследних";
		
		Запрос.УстановитьПараметр("КТК", СтрокаНоминации.Контейнер);
		Запрос.УстановитьПараметр("тек_Релиз", Объект.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			СтрокаНоминации.ДатаВозвратаСобственнику = ВыборкаДетальныеЗаписи.тек_ДатаСдачиВСток;
			СтрокаНоминации.ИнструкцииПоСдаче = ВыборкаДетальныеЗаписи.тек_ИнструкцияПоСдаче;
		Иначе
			СтрокаНоминации.ДатаВозвратаСобственнику = Дата("00010101");
			// Евросиб 89887 TA 89889 Рыбьяков К.А. 02.04.2025 (( закомментировал
			//СтрокаНоминации.ИнструкцииПоСдаче = "";
			// Евросиб Рыбьяков К.А. 02.04.2025 ))
		КонецЕсли;
		
		ПослДанные = ПолучитьПослДанныеКТК(СтрокаНоминации.Контейнер);
		СтрокаНоминации.ПослКлиент = ПослДанные.ПослКлиент;
		СтрокаНоминации.ПослЗаявка = ПослДанные.ПослЗаявка;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеКТКизАРМКТК(НомерКТК)
	Результат = Новый Структура("тек_ИнструкцияПоСдаче,кл_ДатаВозврата,кл_Клиент,Заявка");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТЕ.Ссылка КАК КТК,
	               |	стоки_ТекущиеДанныеСрезПоследних.тек_ИнструкцияПоСдаче КАК тек_ИнструкцияПоСдаче,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.кл_ДатаВозврата КАК кл_ДатаВозврата,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.кл_Клиент КАК кл_Клиент,
	               |	ВложенныйЗапрос.Ссылка КАК Заявка
	               |ИЗ
	               |	Справочник.ТЕ КАК ТЕ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.стоки_ТекущиеДанные.СрезПоследних КАК стоки_ТекущиеДанныеСрезПоследних
	               |		ПО ТЕ.Ссылка = стоки_ТекущиеДанныеСрезПоследних.КТК
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.стоки_КлиентскоеОперирование.СрезПоследних КАК стоки_КлиентскоеОперированиеСрезПоследних
	               |		ПО ТЕ.Ссылка = стоки_КлиентскоеОперированиеСрезПоследних.КТК
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ЗаякаСоставУслуги.Ссылка КАК Ссылка,
	               |			МАКСИМУМ(ПереченьРейсов.Рейс) КАК Рейс,
	               |			ЗаякаСоставУслуги.Контейнер КАК Контейнер
	               |		ИЗ
	               |			(ВЫБРАТЬ
	               |				МаксимальнаяДатаЗаявки.Контейнер КАК Контейнер,
	               |				МАКСИМУМ(Заявка.Ссылка) КАК Ссылка
	               |			ИЗ
	               |				Документ.Заявка КАК Заявка
	               |					ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |						ЗаякаСоставУслуги.НомерКТК КАК Контейнер,
	               |						МАКСИМУМ(Заявка.Дата) КАК Дата
	               |					ИЗ
	               |						Документ.Заявка КАК Заявка
	               |							ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Заявка.СоставУслуги КАК ЗаякаСоставУслуги
	               |							ПО (ЗаякаСоставУслуги.Ссылка = Заявка.Ссылка)
	               |					ГДЕ
	               |						Заявка.ПометкаУдаления = ЛОЖЬ
	               |					
	               |					СГРУППИРОВАТЬ ПО
	               |						ЗаякаСоставУслуги.НомерКТК) КАК МаксимальнаяДатаЗаявки
	               |					ПО (МаксимальнаяДатаЗаявки.Дата = Заявка.Дата)
	               |			
	               |			СГРУППИРОВАТЬ ПО
	               |				МаксимальнаяДатаЗаявки.Контейнер) КАК ЗаякаСоставУслуги
	               |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Заявка.ПереченьРейсов КАК ПереченьРейсов
	               |				ПО ЗаякаСоставУслуги.Ссылка = ПереченьРейсов.Ссылка
	               |		ГДЕ
	               |			ПереченьРейсов.Рейс ССЫЛКА Справочник.РейсыЖД
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ЗаякаСоставУслуги.Ссылка,
	               |			ЗаякаСоставУслуги.Контейнер) КАК ВложенныйЗапрос
	               |		ПО ТЕ.Ссылка = ВложенныйЗапрос.Контейнер
	               |ГДЕ
	               |	ТЕ.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", НомерКТК);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Ответ);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура НоминацииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекД = Элементы.Номинации.ТекущиеДанные;
	Если Поле = Элементы.НоминацииПослКлиент Тогда
		Если ЗначениеЗаполнено(ТекД.ПослКлиент) Тогда
			ОткрытьЗначение(ТекД.ПослКлиент);
		КонецЕсли;
	ИначеЕсли Поле = Элементы.НоминацииПослЗаявка Тогда
		Если ЗначениеЗаполнено(ТекД.ПослЗаявка) Тогда
			ОткрытьЗначение(ТекД.ПослЗаявка);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


