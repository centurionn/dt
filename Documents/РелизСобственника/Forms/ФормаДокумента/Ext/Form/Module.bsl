&НаКлиенте
Процедура Номинациидопл_СделкаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекД = Элементы.Номинации.ТекущиеДанные;
	
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ТекД.Контейнер) Тогда
		ТекстСообщения = НСтр("ru = 'Нельзя изменять протокол не помеченный на удаление.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "ПСЦ", "Объект.Номинации[0]");
		Возврат;
	КонецЕсли;	
		
	мСделки = ПолучитьСписокСделок(ТекД.Контейнер);
	
	СписокСделок = Новый СписокЗначений;
	СписокСделок.ЗагрузитьЗначения(мСделки);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор",Новый Структура("СписокСделок", СписокСделок));
	
	ОбработкаВыбора = Новый ОписаниеОповещения("ПриЗакрытииФормыВыбораСделки", ЭтаФорма, ПараметрыФормы);
	ОткрытьФорму("Документ.Сделка.ФормаВыбора", ПараметрыФормы, ЭтотОбъект,,,, ОбработкаВыбора);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокСделок(КТК)
	
	мОтвет = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СделкаСвязьУчетныхЕдиниц.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|ГДЕ
	|	СделкаСвязьУчетныхЕдиниц.Контейнер = &Контейнер
	|	И НЕ СделкаСвязьУчетныхЕдиниц.Клиент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	И СделкаСвязьУчетныхЕдиниц.ВидТранспортногоСообщения = Значение(Перечисление.ВидыТранспортныхСообщений.ЖД)
	|	И СделкаСвязьУчетныхЕдиниц.Ссылка.Проведен
	|	И НЕ СделкаСвязьУчетныхЕдиниц.Ссылка.Служебная
	|	И НЕ СделкаСвязьУчетныхЕдиниц.Ссылка.ПодсылПорожних";
	
	Запрос.УстановитьПараметр("Контейнер", КТК);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		мОтвет.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
	КонецЦикла;
	
	Возврат мОтвет;
	
КонецФункции	

