&НаКлиенте
Процедура ЛокацияСдачиНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	//ДИТ Шевченко А.В. US 98893 ТА 100521 03.02.2025
	Если ТипЗнч(Объект.ЛокацияСдачи) = Тип("СправочникСсылка.Локации") Тогда
		СтандартнаяОбработка = Ложь;
		ПараметрыОтбора = Новый Структура;
		Локации = Новый СписокЗначений;
		Локации.Добавить(ПредопределенноеЗначение("Справочник.ТипыЛокаций.Страна"));
		ПараметрыОтбора.Вставить("ТипЛокации",Локации);
		ПараметрыОтбора.Вставить("Отбор",Новый Структура("ТипЛокации",Локации));
		
		ОткрытьФорму("Справочник.Локации.ФормаВыбора", ПараметрыОтбора,Элемент);
	КонецЕсли;
	Если ТипЗнч(Объект.ЛокацияСдачи) = Тип("СправочникСсылка.Мультилокации") Тогда
		СтандартнаяОбработка = Ложь;
		ПараметрыОтбора = Новый Структура;
		Локации = Новый Массив;
		Локации.Добавить(ПредопределенноеЗначение("Справочник.ТипыЛокаций.Страна"));
		ПараметрыОтбора.Вставить("ТипыЛокаций",Локации);
		
		ОткрытьФорму("Справочник.Мультилокации.ФормаВыбора", ПараметрыОтбора,Элемент);
	КонецЕсли;
	//ДИТ Шевченко А.В. US 98893 ТА 100521 03.02.2025
КонецПроцедуры

&НаКлиенте
Процедура ЛокацияСдачиОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	//ДИТ Шевченко А.В. US 98893 ТА 100521 03.02.2025
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Тип") Тогда
		Если ПолучитьИмяТипа(ВыбранноеЗначение) = "Справочник.Локации" Тогда
			СтандартнаяОбработка = Ложь;
			ПараметрыОтбора = Новый Структура;
			Локации = Новый СписокЗначений;
			Локации.Добавить(ПредопределенноеЗначение("Справочник.ТипыЛокаций.Страна"));
			ПараметрыОтбора.Вставить("ТипЛокации",Локации);
			ПараметрыОтбора.Вставить("Отбор",Новый Структура("ТипЛокации",Локации));
			
			ОткрытьФорму("Справочник.Локации.ФормаВыбора", ПараметрыОтбора,Элемент);
		КонецЕсли;
		Если ПолучитьИмяТипа(ВыбранноеЗначение) = "Справочник.Мультилокации" Тогда
			СтандартнаяОбработка = Ложь;
			ПараметрыОтбора = Новый Структура;
			Локации = Новый Массив;
			Локации.Добавить(ПредопределенноеЗначение("Справочник.ТипыЛокаций.Страна"));
			ПараметрыОтбора.Вставить("ТипыЛокаций",Локации);
			
			ОткрытьФорму("Справочник.Мультилокации.ФормаВыбора", ПараметрыОтбора,Элемент);
		КонецЕсли;
	КонецЕсли;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Локации") Тогда
		Если НЕ ЭтоСтрана(ВыбранноеЗначение) Тогда
			Сообщить("Допускается выбор локации только с типом страна");
			СтандартнаяОбработка = Ложь;
		КонецЕсли;	
	КонецЕсли;
	//ДИТ Шевченко А.В. US 98893 ТА 100521 03.02.2025
КонецПроцедуры

