&НаСервере
Функция ПроверитьНезакрытыеЦиклыКонтейнеров(МассивКонтейнеров, СсылкаНаДокумент) 
	
	//ДИТ Шевченко А.В. 62541 09.03.2023 -начало
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	стоки_ТекущиеДанныеСрезПоследних.КТК КАК КТК
	|ИЗ
	|	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних(
	|			&ДатаДокумента,
	|			КТК В (&МассивКонтейнеров)
	|				И тек_Релиз = &Релиз) КАК стоки_ТекущиеДанныеСрезПоследних
	|ГДЕ
	|	стоки_ТекущиеДанныеСрезПоследних.тек_ДатаСдачиВСток <> ДАТАВРЕМЯ(1, 1, 1)";
	
	Запрос.УстановитьПараметр("ДатаДокумента", ТекущаяДата());
	Запрос.УстановитьПараметр("МассивКонтейнеров", МассивКонтейнеров);
	Запрос.УстановитьПараметр("Релиз", СсылкаНаДокумент);
	
	МассивКонтейнеровНаУдал = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("КТК");
	
	Для Каждого МассивЗнч Из МассивКонтейнеровНаУдал Цикл 
		Индекс = МассивКонтейнеров.Найти(МассивЗнч);
		МассивКонтейнеров.Удалить(Индекс);
	КонецЦикла;	
		
	Запрос = Новый Запрос;
	Запрос.Текст =
	// ДИТ US 55475 ТА 58122 Сержантова А.С. Начало: 09.04.2024
	"ВЫБРАТЬ
	|	Номинации.Контейнер КАК Контейнер,
	|	Номинации.ДатаВзятия КАК ДатаВзятия
	|ПОМЕСТИТЬ ВТ_ДатыВзятияПоКонтейнерам
	|ИЗ
	|	&ТабДокумента КАК Номинации 
	|;
    |
	|///////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДатыВзятияПоКонтейнерам.Контейнер
	|ПОМЕСТИТЬ ВТ_исключить
	|ИЗ
	|	ВТ_ДатыВзятияПоКонтейнерам
	|ГДЕ
	|	ВТ_ДатыВзятияПоКонтейнерам.ДатаВзятия = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|	И &КонецПериодаДействия <= &ДатаДокумента
	|;
    |
	|////////////////////////////////////////////////////////////////////////////////
	// ДИТ US 55475 ТА 58122 Сержантова А.С. Конец: 09.04.2024
	|ВЫБРАТЬ
	|	стоки_ТекущиеДанныеСрезПоследних.тек_ДатаПриемаВПользование КАК тек_ДатаПриемаВПользование,
	|	стоки_ТекущиеДанныеСрезПоследних.тек_ДатаСдачиВСток КАК тек_ДатаСдачиВСток,
	|	стоки_ТекущиеДанныеСрезПоследних.КТК КАК КТК,
	// Евросиб Bug 88460 Рыбьяков К.А. 05.08.2024 ((
	|	стоки_ТекущиеДанныеСрезПоследних.тек_ВЭксплуатации КАК тек_ВЭксплуатации
	// Евросиб Рыбьяков К.А. 05.08.2024 ))
	|ПОМЕСТИТЬ Данные
	|ИЗ
	|	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних(
	|			&ДатаДокумента,
	|			КТК В (&МассивКонтейнеров)
	|				И НЕ тек_Релиз = &Релиз) КАК стоки_ТекущиеДанныеСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Данные.КТК КАК КТК
	|ИЗ
	|	Данные КАК Данные
	|ГДЕ
	|	Данные.тек_ДатаПриемаВПользование <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|	И Данные.тек_ДатаСдачиВСток = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	// ДИТ US 55475 ТА 58122 Сержантова А.С. Начало: 09.04.2024
	|	И не Данные.КТК В (ВЫБРАТЬ Т.Контейнер из ВТ_исключить КАК Т)
	// Евросиб Bug 88460 Рыбьяков К.А. 05.08.2024 ((
	|	И Данные.тек_ВЭксплуатации = Истина";
	// Евросиб Рыбьяков К.А. 05.08.2024 ))
	Запрос.УстановитьПараметр("КонецПериодаДействия", ПериодДействия.ДатаОкончания);
	Запрос.УстановитьПараметр("ТабДокумента", Объект.Номинации.Выгрузить(,"Контейнер, ДатаВзятия"));
	// ДИТ US 55475 ТА 58122 Сержантова А.С. Конец: 09.04.2024
	
	Запрос.УстановитьПараметр("ДатаДокумента", ТекущаяДата());
	Запрос.УстановитьПараметр("МассивКонтейнеров", МассивКонтейнеров);
	Запрос.УстановитьПараметр("Релиз", СсылкаНаДокумент);
	
	МассивКТКСОшибками = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("КТК"); 

	Возврат МассивКТКСОшибками; 
	//ДИТ Шевченко А.В. 62541 09.03.2023 -конец
КонецФункции //ДИТ Авдеева В.С. 0281647 07.09.2022 Конец

