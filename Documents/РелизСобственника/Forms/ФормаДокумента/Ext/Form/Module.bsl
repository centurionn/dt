Процедура ОбработкаЗагрузкиДатыВзятия(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	
	Если Параметр1 <> неопределено И Параметр2 <> неопределено И Параметр2.Свойство("КТК") Тогда
		
		//Евросиб(ДИТ), Беляев СЮ, BUG 94917 / TA 96390, 27-11-2024, начало
		МассивКонтейнеровПоКоторымРелизАктуален = ПолучитьМассивКонтейнеровПоКоторымРелизАктуален(Объект.Номинации);
		//Евросиб(ДИТ), Беляев СЮ, BUG 94917 / TA 96390, 27-11-2024, конец
		
		Для каждого Стр из Параметр1 Цикл
			ИндексКТК = 0;
			Для каждого ЗначениеКТК из Стр.Значение Цикл
				Для каждого Стр2 из Объект.Номинации Цикл
					Если ЗначениеЗаполнено(Стр2.Контейнер) И НЕ (ЗначениеЗаполнено(Стр2.ДатаВозвратаСобственнику) И УжеВведенРелизсПозднейДатой(Стр2.Контейнер,Стр2.ДатаВзятия)) Тогда
						Если Стр2.Контейнер = ЗначениеКТК Тогда
							
							//Стр2.ДатаВзятия = Параметр1.ДатыКТК[ИндексКТК];
							//Евросиб(ДИТ), Беляев СЮ, BUG 97038 / TA 97047, 06-12-2024, начало
							ДатаВзятияУстанавливаемая = Параметр1.ДатыКТК[ИндексКТК];
							Если ЗначениеЗаполнено(ДатаВзятияУстанавливаемая) Тогда
								Стр2.ДатаВзятия = ДатаВзятияУстанавливаемая;
							КонецЕсли;
							//Евросиб(ДИТ), Беляев СЮ, BUG 97038 / TA 97047, 06-12-2024, конец
							 //ДИТ US 93168 ТА 95626 Лаврентьев О.М. Начало: 26.11.2024
							Стр2.ДатаИзготовленияКТК = Параметр1.ДатаИзготовленияКТК[ИндексКТК];
							//ЗаписатьДатуИзготовленияКонтейнера(Стр2.Контейнер, Стр2.ДатаИзготовленияКТК); //Евросиб(ДИТ), Беляев СЮ, BUG 97038 / TA 97047, 06-12-2024, закомментировал
							 //ДИТ US 93168 ТА 95626 Лаврентьев О.М. Конец: 26.11.2024
							//++ Зубов US 33131 TA 38910 01.11.2021
							//Если НЕ ЦиклЗакрыт(Стр2.Контейнер,Стр2.ДатаАктуальностиЗаписи) Тогда
							//	Стр2.ДатаАктуальностиЗаписи = ТекущаяДата();
							//КонецЕсли;
							//-- Зубов US 33131 TA 38910 01.11.2021
							//Евросиб(ДИТ), Беляев СЮ, BUG 94917 / TA 96390, 27-11-2024, начало
							Если МассивКонтейнеровПоКоторымРелизАктуален.Найти(Стр2.Контейнер) <> Неопределено Тогда
                            	Стр2.ДатаАктуальностиЗаписи = ТекущаяДата();
							КонецЕсли;
							//Евросиб(ДИТ), Беляев СЮ, BUG 94917 / TA 96390, 27-11-2024, конец
							Прервать;
							
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				ИндексКТК = ИндексКТК+1;
			КонецЦикла;	
		КонецЦикла;
		
	КонецЕсли;

