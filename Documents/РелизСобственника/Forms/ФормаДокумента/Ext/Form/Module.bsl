&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	//Евросиб(ДИТ), Беляев СЮ, BUG 97038 / TA 97047, 04-12-2024, начало
	ДатаНачалаПроверкиЗаполненияДатыИзготовленияКТК = ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьЗначениеКонстанты("ДатаНачалаПроверкиЗаполненияДатыИзготовленияКТК");
	//Евросиб(ДИТ), Беляев СЮ, BUG 97038 / TA 97047, 04-12-2024, конец
	
	Если Объект.Дата >= ДатаНачалаПроверкиЗаполненияДатыИзготовленияКТК Тогда
		// ДИТ US 93168 ТА 95626 Лаврентьев О.М. Начало: 25.11.2024
		Для каждого СтрокаТЧНоминации Из Объект.Номинации Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаТЧНоминации.Контейнер) Тогда
				Продолжить;
			КонецЕсли;
			Если СтрокаТЧНоминации.тек_СобственностьКТК = Перечисления.ВариантыСобственности.АрендаДлительная 
				Или СтрокаТЧНоминации.тек_СобственностьКТК = Перечисления.ВариантыСобственности.Собственный Тогда
				Если НЕ ЗначениеЗаполнено(СтрокаТЧНоминации.ДатаИзготовленияКТК) Тогда
					текстСообщения = СтрШаблон("Для контрейнера %1 в табличной части номинации номер строки %2 не указана дата изготовления КТК",
													СтрокаТЧНоминации.Контейнер,СтрокаТЧНоминации.НомерСтроки);
					ОбщегоНазначения.СообщитьПользователю(текстСообщения, , ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Номинации", СтрокаТЧНоминации.НомерСтроки, "ДатаИзготовленияКТК"), "Объект", Отказ);
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
		// ДИТ US 93168 ТА 95626 Лаврентьев О.М. Конец: 25.11.2024
	КонецЕсли;
	
	// Евросиб US 95846 TA 93176 Рыбьяков К.А. 08.12.2024 ((
	ВидДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "ВидДоговора");
	Если ВидДоговора <> Неопределено Тогда
		Если Объект.ДоплатныеКТК И ВидДоговора <> Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда
			ТекстСообщения = НСтр("ru = 'Необходимо заменить вид договора с ""с поставщиком"" на ""с покупателем"".'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Договор", "Объект", Отказ);
		ИначеЕсли НЕ Объект.ДоплатныеКТК И ВидДоговора <> Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда
			ТекстСообщения = НСтр("ru = 'Необходимо заменить вид договора с ""с покупателем"" на ""с поставщиком"".'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Договор", "Объект", Отказ);
		КонецЕсли;
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 14.11.2024 ))
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Объект.НачалоДействия = ПериодДействия.ДатаНачала;
	Объект.ОкончаниеДействия = ПериодДействия.ДатаОкончания;    

	//++ Зубов US 33131 TA 43877 16.12.2021
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		// Евросиб US 104907 TA 105520 Рыбьяков К.А. 01.04.2025 ((
		ЗадатьВопросПользователю(Отказ, ПараметрыЗаписи)
		// Евросиб Рыбьяков К.А. 01.04.2025 ))
		//Режим = РежимДиалогаВопрос.ДаНет;
		//Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтотОбъект, Параметры);
		//ПоказатьВопрос(Оповещение, НСтр("ru = 'При отмене проведения будут удалена история записей КТК по данному Релизу. Вы действительно хотите продолжить?';"), Режим);
	КонецЕсли;
	//-- Зубов US 33131 TA 43877 16.12.2021   
	
	// Евросиб US 95138 TA 89887 Рыбьяков К.А. 14.11.2024 ((
	Если Объект.НаОсновании И НЕ ЗначениеЗаполнено(Объект.ПСЦ) Тогда
		ТекстСообщения = НСтр("ru = 'Необходимо заполнить протокол.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "ПСЦ", "Объект", Отказ);
		Возврат;
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 14.11.2024 ))
	
	//ДИТ Авдеева В.С. 0281647 07.09.2022 Начало                
	ПропуститьВопросОНезакрытыхЦиклах = ПараметрыЗаписи.Свойство("ПропуститьВопросОНезакрытыхЦиклах");
	//ЭтоПолноправныйПользователь()
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда  
		МассивКонтейнеров = Новый Массив;
		Для Каждого СтрокаНоминации Из Объект.Номинации Цикл 
			Если ЗначениеЗаполнено(СтрокаНоминации.Контейнер) Тогда
				МассивКонтейнеров.Добавить(СтрокаНоминации.Контейнер);  
			КонецЕсли;
		КонецЦикла;
		КонтейнерыСОшибками = ПроверитьНезакрытыеЦиклыКонтейнеров(МассивКонтейнеров, Объект.Ссылка);		
		
		Если ЗначениеЗаполнено(КонтейнерыСОшибками) Тогда  
			Если ЭтоПолноправныйПользователь() Тогда  
				Если Не ПропуститьВопросОНезакрытыхЦиклах Тогда 
					СтруктураРезультата = Новый Структура;
					СтруктураРезультата.Вставить("ПараметрыЗаписи", ПараметрыЗаписи);
					ОписаниеОповещения = Новый ОписаниеОповещения("ПродолжитьПередЗаписьюПослеОтветаНаВопросОНезакрытыхЦиклах", ЭтаФорма, СтруктураРезультата);
					ПоказатьВопрос(ОписаниеОповещения, "Есть контейнеры с незавершенным циклом пользования
							|"+СтрСоединить(КонтейнерыСОшибками,Символы.ПС)+"
							|Продолжить?", РежимДиалогаВопрос.ДаНет);
					Отказ = Истина;
					
				КонецЕсли;
			Иначе    
				Для Каждого СтрКонтейнер Из КонтейнерыСОшибками Цикл 
					ТекстСообщения = СтрШаблон("Необходимо закрыть предыдущий цикл пользования контейнером %1 перед внесением его номера в карточку релиза", СтрКонтейнер);
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,Отказ);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		// Евросиб US 100954 TA 117458 Рыбьяков К.А. 09.01.2026 ((
		ПроверитьКорректностьСтавок(Отказ);
		// Евросиб Рыбьяков К.А. 09.01.2026 ))
	КонецЕсли;
	//ДИТ Авдеева В.С. 0281647 07.09.2022 Конец  
	
	//Евросиб(ДИТ), Беляев СЮ, BUG 94917 / TA 96390, 27-11-2024, начало
	МассивСостояниеЦикловКонтейнеров = ПолучитьСостояниеЦикловКонтейнеровНаСервере();
	Для Каждого ДанныеПоКонтейнеру Из МассивСостояниеЦикловКонтейнеров Цикл
		Если НЕ ЗначениеЗаполнено(ДанныеПоКонтейнеру.Контейнер) Тогда
			Продолжить;
		КонецЕсли;
		КонтейнерБезЗаписейПоРегиструВЭтомРелизе = ДанныеПоКонтейнеру.ПорядковыйНомерЦиклаАрендыКТК_ТекущегоРелиза = 0;
		Если НЕ ДанныеПоКонтейнеру.РелизАктуален 
				И КонтейнерБезЗаписейПоРегиструВЭтомРелизе 
				И ЗначениеЗаполнено(ДанныеПоКонтейнеру.ДатаВзятия) Тогда
			ТекстСообщения = СтрШаблон("Необходимо закрыть предыдущий цикл пользования контейнером %1 перед внесением его номера в карточку релиза с заполненной Датой взятия", ДанныеПоКонтейнеру.Контейнер);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		КонецЕсли;
	КонецЦикла;
	//Евросиб(ДИТ), Беляев СЮ, BUG 94917 / TA 96390, 27-11-2024, конец
	
	// Евросиб US 88677 TA 88681 Рыбьяков К.А. 12.12.2024 ((
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение 
		И Объект.ДоплатныеКТК 
		И НЕ ЗначениеЗаполнено(Объект.ВозможныеСтокиСдачи) Тогда
		//ДИТ Шевченко А.В. US 98893 ТА 100521 03.02.2025
		//ТекстСообщения = НСтр("ru = 'Возможные стоки сдачи является обязательным для Релиза собственника на доплатные КТК. Проведение невозможно.'");
		ТекстСообщения = НСтр("ru = 'Возможные локации сдачи является обязательным для Релиза собственника на доплатные КТК. Проведение невозможно.'");
		//ДИТ Шевченко А.В. US 98893 ТА 100521 03.02.2025
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "ВозможныеСтокиСдачи", "Объект", Отказ);
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 12.12.2024 ))
	
	//Евросиб Коханенко Н.А. 11.01.2024 (( #79617 
	ПересчитатьОсталосьКВозврату();
	//Евросиб Коханенко Н.А. 11.01.2024 )) #79617 

КонецПроцедуры

