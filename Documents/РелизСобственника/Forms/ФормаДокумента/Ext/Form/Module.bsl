&НаКлиенте
Процедура Номинациитек_СобственностьКТКОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка) //Евросиб(ДИТ) US 91364 ТА 95290 Шевченко А.В. Начало: 28.11.2024
	//СтандартнаяОбработка = ложь; //Евросиб(ДИТ), Беляев СЮ, Ticket#0382670, 14-01-2025, закомментировал
	Если ВыбранноеЗначение <> Неопределено Тогда 
		ТекД = Элементы.Номинации.ТекущиеДанные;
		//Евросиб(ДИТ) US 91364 ТА 95290 Шевченко А.В. Начало: 28.11.2024
		ЗначениеДоИзм = ТекД.тек_СобственностьКТК;
		//Евросиб(ДИТ) US 91364 ТА 95290 Шевченко А.В. Конец: 28.11.2024
		ТекД.тек_СобственностьКТК = ВыбранноеЗначение;	
		//Евросиб(ДИТ) US 91364 ТА 95290 Шевченко А.В. Начало: 28.11.2024
		Если НЕ ПроверкаНаИзменениеСобственности(ВыбранноеЗначение) Тогда
			ТекД.тек_СобственностьКТК = ЗначениеДоИзм;
			//Евросиб(ДИТ), Беляев СЮ, Ticket#0382670, 14-01-2025, начало
			СтандартнаяОбработка = ложь;
			//Евросиб(ДИТ), Беляев СЮ, Ticket#0382670, 14-01-2025, конец
			Возврат;
		КонецЕсли;
		
		Оп = Новый ОписаниеОповещения("ВыполнитьПослеОкончанияПредупрежденияСобственностьКТКПриИзменении", ЭтотОбъект,ТекД.тек_СобственностьКТК);
		Если ТекД.тек_СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.СпотДоплатный") Тогда
			Объект.ДоплатныеКТК = Истина;
			Объект.МорскиеКТК = Ложь;
			Объект.СобственныеКТК = Ложь;
			//Евросиб(ДИТ), Беляев СЮ, Ticket#0382670, 14-01-2025, начало
			СтандартнаяОбработка = ложь;
			//Евросиб(ДИТ), Беляев СЮ, Ticket#0382670, 14-01-2025, конец
			ПоказатьПредупреждение(Оп,"«При выборе вида собственности - «Спот доплатный» будет установлен флаг «Доплатные КТК» и по всем КТК будет проставлен вид собственности «Спот доплатный».");	
		КонецЕсли;
		Если ТекД.тек_СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.Собственный") Тогда
			Объект.СобственныеКТК = Истина;
			Объект.ДоплатныеКТК = Ложь;
			Объект.МорскиеКТК = Ложь;
			//Евросиб(ДИТ), Беляев СЮ, Ticket#0382670, 14-01-2025, начало
			СтандартнаяОбработка = ложь;
			//Евросиб(ДИТ), Беляев СЮ, Ticket#0382670, 14-01-2025, конец
			ПоказатьПредупреждение(Оп,"«При выборе вида собственности «Собственный» будет установлен флаг «Собственные КТК» и по всем КТК будет проставлен вид собственности «Собственный».");
		КонецЕсли;
		
		//Евросиб(ДИТ) US 91364 ТА 95290 Шевченко А.В. Конец: 28.11.2024
		//проверка на НЕ Спот перенесена из обработчика Номинациитек_СобственностьКТКПриИзменении,
		//который более не функционален после применения немодального выбора из списка
		Если НЕ ТекД.тек_СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.Спот") Тогда
			ТекД.НулеваяСтавка = Ложь;
		КонецЕсли;
		// Евросиб US 100954 TA 117458 Рыбьяков К.А. 09.01.2026 ((
		Если Объект.ДоплатныеКТК И Не ТекД.тек_СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.СпотДоплатный") Тогда
			Объект.ДоплатныеКТК = Ложь;
		КонецЕсли;
		// Евросиб Рыбьяков К.А. 09.01.2026 ))
	КонецЕсли;
КонецПроцедуры

// Предназначена для получения пустого значения заданного типа:
//	примитивного, или ссылочного. Используется
//
// Параметры:
//	ЗаданныйТип - Тип, Строка - Тип пустого значения или строка с его идентификатором.
//
&НаКлиенте
Функция ПустоеЗначениеТипа(ЗаданныйТип) Экспорт
	
	Если ЗаданныйТип = Тип("Число") Тогда
		
		Результат = 0;
		
	ИначеЕсли ЗаданныйТип = Тип("Строка") Тогда
		
		Результат = "";
		
	ИначеЕсли ЗаданныйТип = Тип("Дата") Тогда
		
		Результат = '00010101';
		
	ИначеЕсли ЗаданныйТип = Тип("Булево") Тогда
		
		Результат = Ложь;
		
	ИначеЕсли ЗаданныйТип = Тип("Неопределено") Тогда
		
		Результат = Неопределено;
		
	Иначе
		
		Результат = Новый (ЗаданныйТип);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

