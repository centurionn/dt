&НаСервереБезКонтекста
Функция ПолучитьДанныеКТКИзАРМ(Контейнер)
	
	Результат = Новый Структура("ТипКТК,НормативВозврата,Ставка,Валюта,тек_Собственник,ДатаВзятия,допл_Клиент,допл_Договор,допл_Калькуляция,допл_ПСЦ,тек_Примечание,тек_СобственностьКТК");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	стоки_ТекущиеДанныеСрезПоследних.КТК.ТипТЕ КАК ТипКТК,
	               |	стоки_ТекущиеДанныеСрезПоследних.тек_ВидСобственности КАК тек_СобственностьКТК,
	               |	стоки_ТекущиеДанныеСрезПоследних.тек_ДатаВзятияИзСтока КАК ДатаВзятия,
	               |	стоки_ТекущиеДанныеСрезПоследних.тек_СрокВозврата КАК НормативВозврата,
	               |	стоки_ТекущиеДанныеСрезПоследних.комм_Ставка КАК Ставка,
	               |	стоки_ТекущиеДанныеСрезПоследних.комм_Валюта КАК Валюта,
	               |	стоки_ТекущиеДанныеСрезПоследних.тек_Примечание КАК тек_Примечание,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.допл_Клиент КАК допл_Клиент,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.допл_Договор КАК допл_Договор,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.допл_Калькуляция КАК допл_Калькуляция,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.допл_ПСЦ КАК допл_ПСЦ,
	               |	стоки_ТекущиеДанныеСрезПоследних.тек_Собственник КАК тек_Собственник
	               |ИЗ
	               |	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних(, КТК = &Контейнер) КАК стоки_ТекущиеДанныеСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.стоки_КлиентскоеОперирование.СрезПоследних КАК стоки_КлиентскоеОперированиеСрезПоследних
	               |		ПО стоки_ТекущиеДанныеСрезПоследних.КТК = стоки_КлиентскоеОперированиеСрезПоследних.КТК";
	Запрос.УстановитьПараметр("Контейнер", Контейнер);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

