&НаСервере
Функция СтатусКТКВозвращен(Контейнер)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	стоки_ТекущиеДанныеСрезПоследних.тек_Статус КАК тек_Статус
		|ИЗ
		|	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних(
		|			&ДатаАктуальности,
		|			КТК = &Контейнер
		|				И НЕ тек_Релиз = &ТекРелиз) КАК стоки_ТекущиеДанныеСрезПоследних";
	
	Запрос.УстановитьПараметр("ДатаАктуальности", ТекущаяДата());
	Запрос.УстановитьПараметр("Контейнер", Контейнер);
	Запрос.УстановитьПараметр("ТекРелиз", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.тек_Статус = Перечисления.СтатусыКТК.Возвращен;
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции

&НаСервере
Функция БылПустойКТК(НомерСтроки)
	Если Объект.Ссылка.Номинации.Количество()>=НомерСтроки Тогда
		КТК = Объект.Ссылка.Номинации[НомерСТроки-1].Контейнер;
		Если КТК = Справочники.ТЕ.ПустаяСсылка() Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Возврат Истина;
	КонецЕсли;
КонецФункции

&НаСервере
Функция ПолучитьСтарыйКонтейнер(НомерСтроки)
	Если Объект.Ссылка.Номинации.Количество()>=НомерСтроки Тогда
		КТК = Объект.Ссылка.Номинации[НомерСТроки-1].Контейнер;
		Если КТК = Справочники.ТЕ.ПустаяСсылка() Тогда
			Возврат "Пустой";
		Иначе
			Возврат КТК;
		КонецЕсли;
	Иначе
		Возврат "Пустой";
	КонецЕсли;
КонецФункции

