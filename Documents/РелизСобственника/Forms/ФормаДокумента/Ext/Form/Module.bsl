&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Евросиб Фролов (30.05.2022 Task №49741
	Если Параметры.Ключ.Пустая() Тогда		
		ЗаполнитьРелизыКлиентов();
	КонецЕсли;
	// Евросиб Фролов)
	
	//ДИТ, Беляев СЮ, Ticket#0339496, 29-01-2024, начало
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если Параметры.Свойство("НомерДокумента") Тогда
			Объект.НомерДокумента = Параметры.НомерДокумента;
		КонецЕсли;
		Если Параметры.Свойство("МассивКонтейнеровСтруктура") Тогда
			Для каждого текСтрока из Параметры.МассивКонтейнеровСтруктура Цикл
				//НОМИНАЦИИ
				НоваяСтрокаНоминации = Объект.Номинации.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаНоминации, текСтрока);
				НоваяСтрокаНоминации.Контейнер = текСтрока.КТК;
				НоваяСтрокаНоминации.ТипКТК = текСтрока.ТипТЕ;
				НоваяСтрокаНоминации.НормативВозврата = текСтрока.СрокВозврата;
				НоваяСтрокаНоминации.тек_СобственностьКТК = текСтрока.ВидСобственности;
				НоваяСтрокаНоминации.ДатаАктуальностиЗаписи = ТекущаяДата();
				НоваяСтрокаНоминации.ГУИДСтроки = Новый УникальныйИдентификатор;
				
				//СНП
				НоваяСтрокаСНП = Объект.СНП.Добавить();
				НоваяСтрокаСНП.ГУИДСтроки = НоваяСтрокаНоминации.ГУИДСтроки;
				НоваяСтрокаСНП.От = 0;
				НоваяСтрокаСНП.До = 999999;
				НоваяСтрокаСНП.Стоимость = текСтрока.СНП;
				
				//РЕКВИЗИТЫ ШАПКИ
				Объект.Контрагент = текСтрока.Собственник;
			КонецЦикла
		КонецЕсли;
	КонецЕсли;
	//ДИТ, Беляев СЮ, Ticket#0339496, 29-01-2024, конец
	
	// ++ ДИТ_Агафонов_task 50388 06.07.2022
	// + Состояния
	// Обновляем панель текущего пользователя и панель состояний
	ОбновитьПанельТекущегоПользователя();
	ОбновитьПанельСостояний();
	// - Состояния
	// -- ДИТ_Агафонов_task 50388 06.07.2022

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
	
	//++ Дудоров С.В. TASK 66585 17.03.2023	
	ЗаполнитьСпискиПолейНевидимыхПриСобственномКТК(); 
	//-- Дудоров С.В. TASK 66585 17.03.2023	
	
	//Евросиб Коханенко Н.А. 26.05.2023 (( #70111 
	Элементы.Контрагент.РедактированиеТекста = НЕ Объект.СобственныеКТК; 
    //Евросиб Коханенко Н.А. 26.05.2023 )) #70111
	
	//Евросиб - АСуслов 08.09.2023 15:02:47 #74148
	//(
	Элементы.НоминацииСвязатьСоСтоками.Видимость = Ложь;
	//)
	//Евросиб - АСуслов 08.09.2023 15:02:51 #74148
	
	//ДИТ, Беляев СЮ, US 83120/TA 83233, 01-04-2024, начало
	Элементы.НоминацииВалюта.РежимВыбораИзСписка = Истина;
	Элементы.НоминацииВалюта.СписокВыбора.ЗагрузитьЗначения(Валюта_сервер.ПолучитьМассивОсновныхВалют());
	//ДИТ, Беляев СЮ, US 83120/TA 83233, 01-04-2024, конец
	
	//Евросиб Коханенко Н.А. 31.07.2025 (( #115716 
	Элементы.НоминацииВалютаСНП.РежимВыбораИзСписка = Истина;
	Элементы.НоминацииВалютаСНП.СписокВыбора.ЗагрузитьЗначения(Валюта_сервер.ПолучитьМассивОсновныхВалют());
	//Евросиб Коханенко Н.А. 31.07.2025 )) #115716 
	
	// Евросиб US 88643 TA 88646 Рыбьяков К.А. 17.09.2024 ((
	СравнитьТаблицыПоЛокациям(Ложь);
	// Евросиб Рыбьяков К.А. 17.09.2024 ))
	
	//ДИТ Шевченко А.В. US 88683 TA 88689 19.02.2025
	УстановитьСвязьПараметровВыбораКалькуляции(); 
	Элементы.ПСЦ.РедактированиеТекста = НЕ Объект.ДоплатныеКТК;
	//ДИТ Шевченко А.В. US 88683 TA 88689 19.02.2025
	
	// Евросиб US 89887 TA 93716 Рыбьяков К.А. 23.04.2025 ((
	Если ТипЗнч(Объект.ПСЦ) = Тип("ДокументСсылка.ПСЦПоставщика") Тогда
		ВидУслуг = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ПСЦ, "ВидУслугПоставщика");
		Если ВидУслуг = Справочники.ВидыУслугПоставщиков.Контейнеры Тогда
			Элементы.Группа13.ТолькоПросмотр = Истина;
		КонецЕсли;
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 23.04.2025 ))
	
	// Евросиб US 115057 TA 117286 Рыбьяков К.А. 19.08.2025 ((
	РассчитатьОбщуюСуммуСНП();
	// Евросиб Рыбьяков К.А. 19.08.2025 ))
	
КонецПроцедуры

Процедура УстановитьСвязьПараметровВыбораКалькуляции() //ДИТ Шевченко А.В. US 88683 TA 88689 19.02.2025
	
	СписокКалькуляцийИзПротокола.Очистить();
	
	Если Объект.ДоплатныеКТК Тогда
		
		Если ЗначениеЗаполнено(Объект.ПСЦ) Тогда
			Если ТипЗнч(Объект.ПСЦ) = Тип("ДокументСсылка.ПСЦ") Тогда
				
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	ПСЦКалькуляции.Калькуляция КАК Калькуляция
				|ИЗ
				|	Документ.ПСЦ.Калькуляции КАК ПСЦКалькуляции
				|ГДЕ
				|	ПСЦКалькуляции.Ссылка = &ПСЦ";
				
				Запрос.УстановитьПараметр("ПСЦ", Объект.ПСЦ);
				
				РезультатЗапроса = Запрос.Выполнить();
				
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					СписокКалькуляцийИзПротокола.Добавить(ВыборкаДетальныеЗаписи.Калькуляция);
				КонецЦикла;
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры	

