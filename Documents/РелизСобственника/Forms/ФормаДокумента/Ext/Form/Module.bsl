&НаСервере
Функция ДанныеПоОсновнойСтавке(Тип)
	
	Отбор = Новый Структура;
	Отбор.Вставить("ОсновнаяСтавка", Истина);
	Отбор.Вставить("ТипКТК", Тип);
	ТаблицаСтрок = Объект.СтавкиДоплатныхКТК.Выгрузить(Отбор);
	
	Результат = Новый Структура;
	Если ТаблицаСтрок.Количество() > 0 Тогда
		Результат.Вставить("НДСВключая", ТаблицаСтрок[0].НДСвключен);
		Результат.Вставить("Ставка", ТаблицаСтрок[0].Ставка);
		Результат.Вставить("Валюта", ТаблицаСтрок[0].Валюта);
		Результат.Вставить("СтавкаНДС", ТаблицаСтрок[0].СтавкаНДС);	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
