&НаКлиенте
Процедура СтавкиДоплатныеКТКОсновнаяСтавкаПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.СтавкиДоплатныхКТК.ТекущиеДанные;
	НовоеЗначение = СтрокаТабличнойЧасти.ОсновнаяСтавка;
	ТипКонтейнера = СтрокаТабличнойЧасти.ТипКТК;
	
	Для Каждого Строка Из Объект.СтавкиДоплатныхКТК Цикл
		Если Строка.ТипКТК = ТипКонтейнера Тогда
			Строка.ОсновнаяСтавка = Ложь;
		КонецЕсли;
	КонецЦикла;
	СтрокаТабличнойЧасти.ОсновнаяСтавка = НовоеЗначение;
	
	ОбновитьНоминации(СтрокаТабличнойЧасти);

КонецПроцедуры

&НаСервере
Процедура СравнитьТаблицыПоКонтейнерам()
	
	ТипыКТКВНоминациях = Объект.Номинации.Выгрузить(,"ТипКТК");
	ТипыКТКВНоминациях.Свернуть("ТипКТК");
	
	ТипыКТКВСтавках = Объект.СтавкиДоплатныхКТК.Выгрузить(,"ТипКТК");
	ТипыКТКВСтавках.Свернуть("ТипКТК");
	
	КоллекцииИдентичны = ОбщегоНазначения.КоллекцииИдентичны(ТипыКТКВНоминациях, ТипыКТКВСтавках);
	
	Если Не КоллекцииИдентичны Тогда
		Если Объект.ВозможныеСтокиСдачи <> Неопределено Тогда
			//СтокиСдачиВозможные = Объект.ВозможныеСтокиСдачи.Локации.Выгрузить();
			//СтокиСдачиВозможные.Свернуть("Локация");
			
			//ДИТ Шевченко А.В. US 98893 ТА 100521 03.02.2025
			Если ТипЗнч(Объект.ВозможныеСтокиСдачи) = Тип("СправочникСсылка.Мультилокации") Тогда
				СтокиСдачиВозможные = Объект.ВозможныеСтокиСдачи.Локации.Выгрузить();
				СтокиСдачиВозможные.Свернуть("Локация");
			Иначе
				Если Объект.ВозможныеСтокиСдачи <> Неопределено Тогда
					СтокиСдачиВозможные = Новый ТаблицаЗначений;
					СтокиСдачиВозможные.Колонки.Добавить("Локация");
					НовСтрока = СтокиСдачиВозможные.Добавить();
					НовСтрока.Локация = Объект.ВозможныеСтокиСдачи;
				Иначе
					СтокиСдачиВозможные = Новый ТаблицаЗначений;
					СтокиСдачиВозможные.Колонки.Добавить("Локация");
				КонецЕсли;
			КонецЕсли;
			//ДИТ Шевченко А.В. US 98893 ТА 100521 03.02.2025
			
			ОбновитьТаблицуСтавокДоплатныхКТК(ТипыКТКВНоминациях, СтокиСдачиВозможные, Ложь);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СравнитьТаблицыПоЛокациям(НужноСообщение = Истина)
	
	СтокиСдачиВСтавках = Объект.СтавкиДоплатныхКТК.Выгрузить(,"СтокСдачи");
	СтокиСдачиВСтавках.Свернуть("СтокСдачи");
	СтокиСдачиВСтавках.Колонки.СтокСдачи.Имя = "Локация";
	//ДИТ Шевченко А.В. US 98893 ТА 100521 03.02.2025
	Если ТипЗнч(Объект.ВозможныеСтокиСдачи) = Тип("СправочникСсылка.Мультилокации") Тогда
		СтокиСдачиВозможные = Объект.ВозможныеСтокиСдачи.Локации.Выгрузить();
		СтокиСдачиВозможные.Свернуть("Локация");
	Иначе
		Если Объект.ВозможныеСтокиСдачи <> Неопределено Тогда
			СтокиСдачиВозможные = Новый ТаблицаЗначений;
			СтокиСдачиВозможные.Колонки.Добавить("Локация");
			НовСтрока = СтокиСдачиВозможные.Добавить();
			НовСтрока.Локация = Объект.ВозможныеСтокиСдачи;
		Иначе
			СтокиСдачиВозможные = Новый ТаблицаЗначений;
			СтокиСдачиВозможные.Колонки.Добавить("Локация");
		КонецЕсли;
	КонецЕсли;
	//ДИТ Шевченко А.В. US 98893 ТА 100521 03.02.2025
	
	КоллекцииИдентичны = ОбщегоНазначения.КоллекцииИдентичны(СтокиСдачиВСтавках, СтокиСдачиВозможные);
	
	Если Не КоллекцииИдентичны Или ЗначениеЗаполнено(Объект.ЛокацияСдачи) Тогда
		ТипыКТКВНоминациях = Объект.Номинации.Выгрузить(,"ТипКТК");
		ТипыКТКВНоминациях.Свернуть("ТипКТК");
		ОбновитьТаблицуСтавокДоплатныхКТК(ТипыКТКВНоминациях, СтокиСдачиВозможные, НужноСообщение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНоминации(ДанныеСтроки)
	
	ТипКонтейнера = ДанныеСтроки.ТипКТК;
	
	Для Каждого Строка Из Объект.Номинации Цикл
		Если Строка.ТипКТК = ТипКонтейнера Тогда
			Строка.Ставка = ДанныеСтроки.Ставка;
			Строка.СтавкаНДС = ДанныеСтроки.СтавкаНДС;
			Строка.НДСВключая = ДанныеСтроки.НДСвключен;
			Строка.Валюта = ДанныеСтроки.Валюта;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицуСтавокДоплатныхКТК(ТипыКонтейнеров, СтокиСдачи, СообщитьПользователю)
		
	Если ТипыКонтейнеров.Количество() = 0 Тогда
		Объект.СтавкиДоплатныхКТК.Очистить();
		Возврат;
	КонецЕсли;
	
	ЛокацииМультилокции = Новый ТаблицаЗначений;
	Если ТипЗнч(Объект.ЛокацияСдачи) = Тип("СправочникСсылка.Мультилокации") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	МультилокацииЛокации.Локация КАК Локация
			|ИЗ
			|	Справочник.Мультилокации.Локации КАК МультилокацииЛокации
			|ГДЕ
			|	МультилокацииЛокации.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", Объект.ЛокацияСдачи);
		
		ЛокацииМультилокции = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	НеОбновленнаяТаблица = Объект.СтавкиДоплатныхКТК.Выгрузить();
	Объект.СтавкиДоплатныхКТК.Очистить();
	
	НевозможноПодобратьЛокаций = Новый ТаблицаЗначений;
	НевозможноПодобратьЛокаций.Колонки.Добавить("Локация1", Новый ОписаниеТипов("СправочникСсылка.Локации"));
	НевозможноПодобратьЛокаций.Колонки.Добавить("Локация2", Новый ОписаниеТипов("СправочникСсылка.Локации"));
	
	Если ЛокацииМультилокции.Количество() = 0 Тогда
		Для Каждого Тип Из ТипыКонтейнеров Цикл
			Если Не ЗначениеЗаполнено(Тип.ТипКТК) Тогда
				Продолжить;
			КонецЕсли;
			Если СтокиСдачи.Количество() = 0 Тогда
				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("ТипКТК", Тип.ТипКТК);
				НайденныеСтроки = НеОбновленнаяТаблица.НайтиСтроки(ПараметрыОтбора);
				Если НайденныеСтроки.Количество() > 0 Тогда
					НоваяСтрока = Объект.СтавкиДоплатныхКТК.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденныеСтроки[0], , "СтокСдачи, ЛокацияСдачи");
					НоваяСтрока.ЛокацияСдачи = Объект.ЛокацияСдачи;
				Иначе
					НоваяСтрока = Объект.СтавкиДоплатныхКТК.Добавить();
					НоваяСтрока.ТипКТК = Тип.ТипКТК;
					НоваяСтрока.ЛокацияСдачи = Объект.ЛокацияСдачи;
					НоваяСтрока.СтокСдачи = Неопределено;
				КонецЕсли;
			Иначе
				Для Каждого Сток Из СтокиСдачи Цикл
					ДобавитьКомбинацию = Ложь;
					ПараметрыОтбора = Новый Структура;
					ПараметрыОтбора.Вставить("ТипКТК", Тип.ТипКТК);
					ПараметрыОтбора.Вставить("СтокСдачи", Сток.Локация);
					ПараметрыОтбора.Вставить("ЛокацияСдачи", Объект.ЛокацияСдачи);
					НайденныеСтроки = НеОбновленнаяТаблица.НайтиСтроки(ПараметрыОтбора);
					Если НайденныеСтроки.Количество() > 0 Тогда
						НоваяСтрока = Объект.СтавкиДоплатныхКТК.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденныеСтроки[0]);
					Иначе
						РеквизитыСтокаСдачи = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Сток.Локация, "Тип, ЛокацияВышестоящегоУровня, Страна");
						Если РеквизитыСтокаСдачи.Тип = Справочники.ТипыЛокаций.Страна
							И РеквизитыСтокаСдачи.Страна = Объект.ЛокацияСдачи
							Или Сток.Локация = Объект.ЛокацияСдачи Тогда
							ДобавитьКомбинацию = Истина;
						Иначе
							ЛокацияВышестоящегоУровняСтока = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сток.Локация, "ЛокацияВышестоящегоУровня");
							Пока ЗначениеЗаполнено(ЛокацияВышестоящегоУровняСтока) Цикл
								Если ЛокацияВышестоящегоУровняСтока = Объект.ЛокацияСдачи Тогда
									ДобавитьКомбинацию = Истина;
									Прервать;
								Иначе
									ЛокацияВышестоящегоУровняСтока = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
										ЛокацияВышестоящегоУровняСтока, 
										"ЛокацияВышестоящегоУровня");
								КонецЕсли;
							КонецЦикла;
						КонецЕсли;
						Если ДобавитьКомбинацию Тогда
							НоваяСтрока = Объект.СтавкиДоплатныхКТК.Добавить();
							НоваяСтрока.ТипКТК = Тип.ТипКТК;
							НоваяСтрока.ЛокацияСдачи = Объект.ЛокацияСдачи;
							НоваяСтрока.СтокСдачи = Сток.Локация;
						Иначе
							Если СообщитьПользователю Тогда
								НоваяСтрока = НевозможноПодобратьЛокаций.Добавить();
								НоваяСтрока.Локация1 = Объект.ЛокацияСдачи;
								НоваяСтрока.Локация2 = Сток.Локация;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого Тип Из ТипыКонтейнеров Цикл
			Если Не ЗначениеЗаполнено(Тип.ТипКТК) Тогда
				Продолжить;
			КонецЕсли;
			Если СтокиСдачи.Количество() = 0 Тогда
				Для Каждого Строка Из ЛокацииМультилокции Цикл
					ПараметрыОтбора = Новый Структура;
					ПараметрыОтбора.Вставить("ТипКТК", Тип.ТипКТК);
					ПараметрыОтбора.Вставить("ЛокацияСдачи", Строка.Локация);
					НайденныеСтроки = НеОбновленнаяТаблица.НайтиСтроки(ПараметрыОтбора);
					Если НайденныеСтроки.Количество() > 0 Тогда
						НоваяСтрока = Объект.СтавкиДоплатныхКТК.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденныеСтроки[0], , "СтокСдачи, ЛокацияСдачи");
						НоваяСтрока.ЛокацияСдачи = Строка.Локация;
					Иначе
						НоваяСтрока = Объект.СтавкиДоплатныхКТК.Добавить();
						НоваяСтрока.ТипКТК = Тип.ТипКТК;
						НоваяСтрока.ЛокацияСдачи = Строка.Локация;
						НоваяСтрока.СтокСдачи = Неопределено;
					КонецЕсли;
				КонецЦикла;
			Иначе
				Для Каждого Строка Из ЛокацииМультилокции Цикл
					РеквизитыЛокацииСдачи = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Строка.Локация, "Тип, ЛокацияВышестоящегоУровня, Страна");
					Для Каждого Сток Из СтокиСдачи Цикл
						ДобавитьКомбинацию = Ложь;
						ПараметрыОтбора = Новый Структура;
						ПараметрыОтбора.Вставить("ТипКТК", Тип.ТипКТК);
						ПараметрыОтбора.Вставить("СтокСдачи", Сток.Локация);
						ПараметрыОтбора.Вставить("ЛокацияСдачи", Строка.Локация);
						НайденныеСтроки = НеОбновленнаяТаблица.НайтиСтроки(ПараметрыОтбора);
						Если НайденныеСтроки.Количество() > 0 Тогда
							НоваяСтрока = Объект.СтавкиДоплатныхКТК.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденныеСтроки[0]);
						Иначе
							РеквизитыСтокаСдачи = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Сток.Локация, "Тип, ЛокацияВышестоящегоУровня, Страна");
							Если РеквизитыСтокаСдачи.Тип = Справочники.ТипыЛокаций.Страна
								И РеквизитыСтокаСдачи.Страна = Строка.Локация
										Или Сток.Локация = Строка.Локация Тогда
								ДобавитьКомбинацию = Истина;
							Иначе
								ЛокацияВышестоящегоУровняСтока = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сток.Локация, "ЛокацияВышестоящегоУровня");
								Пока ЗначениеЗаполнено(ЛокацияВышестоящегоУровняСтока) Цикл
									Если ЛокацияВышестоящегоУровняСтока = Строка.Локация Тогда
										ДобавитьКомбинацию = Истина;
										Прервать;
									Иначе
										ЛокацияВышестоящегоУровняСтока = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
											ЛокацияВышестоящегоУровняСтока, 
											"ЛокацияВышестоящегоУровня");
									КонецЕсли;
								КонецЦикла;
							КонецЕсли;
							Если ДобавитьКомбинацию Тогда
								НоваяСтрока = Объект.СтавкиДоплатныхКТК.Добавить();
								НоваяСтрока.ТипКТК = Тип.ТипКТК;
								НоваяСтрока.ЛокацияСдачи = Строка.Локация;
								НоваяСтрока.СтокСдачи = Сток.Локация;
							Иначе
								Если СообщитьПользователю Тогда
									НоваяСтрока = НевозможноПодобратьЛокаций.Добавить();
									НоваяСтрока.Локация1 = Строка.Локация;
									НоваяСтрока.Локация2 = Сток.Локация;
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если СообщитьПользователю Тогда
		НевозможноПодобратьЛокаций.Свернуть("Локация1, Локация2");
		ТекущийИндекс = НевозможноПодобратьЛокаций.Количество() - 1;
		Пока ТекущийИндекс >= 0 Цикл
			Отбор = Новый Структура;
			Отбор.Вставить("СтокСдачи", НевозможноПодобратьЛокаций[ТекущийИндекс].Локация2);
			НайденныеСтроки = Объект.СтавкиДоплатныхКТК.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда
				НевозможноПодобратьЛокаций.Удалить(ТекущийИндекс);
			КонецЕсли;
			ТекущийИндекс = ТекущийИндекс - 1;
		КонецЦикла;
		Для Каждого Строка Из НевозможноПодобратьЛокаций Цикл
			//ДИТ Шевченко А.В. US 98893 ТА 100521 03.02.2025
			//Текст = НСтр("ru = 'Невозможно подобрать сочетание ""%1"" и ""%2"" для указания ставки. Внесите изменения в Локации/Стоки сдачи.'");
			Текст = НСтр("ru = 'Невозможно подобрать сочетание ""%1"" и ""%2"" для указания ставки. Внесите изменения в Страны/ Локации сдачи.'");
			//ДИТ Шевченко А.В. US 98893 ТА 100521 03.02.2025
			Текст = СтрШаблон(Текст, Строка.Локация1, Строка.Локация2); 
			ОбщегоНазначения.СообщитьПользователю(Текст);
		КонецЦикла;
	КонецЕсли;
	
	Объект.СтавкиДоплатныхКТК.Сортировать("ТипКТК");
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВозможныхПунктовСдачи(П1 = Неопределено, П2 = Неопределено) Экспорт
	
	Если ТипЗнч(П2) = Тип("Структура") Тогда
		Если П2.Свойство("НужноСообщение") Тогда
			СравнитьТаблицыПоЛокациям(Истина);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

