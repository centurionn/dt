	//Евросиб(ДИТ) US 91364 ТА 95290 Шевченко А.В. Конец: 28.11.2024
	Элементы.ДоплатныеКТК.ТолькоПросмотр = Объект.СобственныеКТК;
	Элементы.МорскиеКТК.ТолькоПросмотр   = Объект.СобственныеКТК;
	Элементы.Номинациитек_СобственностьКТК.ТолькоПросмотр = Объект.СобственныеКТК;

	ВидимостьПолейПриСобственномКТК();
	
	Если Объект.СобственныеКТК Тогда
		Для каждого СтрокаНоминации из Объект.Номинации Цикл
		    СтрокаНоминации.тек_СобственностьКТК 
				= ПредопределенноеЗначение("Перечисление.ВариантыСобственности.Собственный");
		КонецЦикла;
		ОчиститьПоляПриСобственномКТК();
	Иначе
		Для Каждого СтрокаНоминации из Объект.Номинации Цикл
			СтрокаНоминации.тек_СобственностьКТК 
				= ПустоеЗначениеТипа(ТипЗнч(СтрокаНоминации.тек_СобственностьКТК));
				
		КонецЦикла;
	КонецЕсли;
	
	Если не Объект.СобственныеКТК Тогда
		ЛокацияПриИзменении(Элементы.Локация);
	    ЛокацияСдачиПриИзменении(Элементы.ЛокацияСдачи);
	КонецЕсли; 
	
	//Евросиб Коханенко Н.А. 24.05.2023 (( #70111
	Если Объект.СобственныеКТК Тогда
		Если ЗначениеЗаполнено(Объект.Контрагент) И НЕ ЭтоСобственныйКонтрагент(Объект.Контрагент) Тогда
			Объект.Контрагент = ПустоеЗначениеТипа(ТипЗнч(Объект.Контрагент));	
		КонецЕсли;
		Если ЗначениеЗаполнено(Объект.Договор) Тогда
			Объект.Договор = ПустоеЗначениеТипа(ТипЗнч(Объект.Договор));
		КонецЕсли;
	КонецЕсли; 
	Элементы.Контрагент.РедактированиеТекста = НЕ Объект.СобственныеКТК; 
	//Евросиб Коханенко Н.А. 24.05.2023 )) #70111 
	
КонецПроцедуры

