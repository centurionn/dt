&НаСервере
Функция ПолучитьСписокРодителейЛокации(Мультилокация)
	РодителиЛокации = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МультилокацииЛокации.Локация КАК Локация
		|ИЗ
		|	Справочник.Мультилокации.Локации КАК МультилокацииЛокации
		|ГДЕ
		|	МультилокацииЛокации.Ссылка = &Мультилокация";
	
	Запрос.УстановитьПараметр("Мультилокация", Мультилокация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		РодителиЛокации.Добавить(ВыборкаДетальныеЗаписи.Локация);
	КонецЦикла;
	
	Возврат РодителиЛокации;

