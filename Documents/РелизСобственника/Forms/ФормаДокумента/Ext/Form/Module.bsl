&НаКлиенте
Функция ПроверкаНаИзменениеСобственности(тек_СобственностьКТК)
	
	Если ЭтоПолныеПрава() Тогда
		Возврат Истина;
	КонецЕсли;	
	
	мНомераСтрок = Новый Массив;
	
	Для Каждого Стр Из Объект.Номинации Цикл
		Если ЗначениеЗаполнено(Стр.тек_СобственностьКТК) И Стр.тек_СобственностьКТК <> тек_СобственностьКТК Тогда
			мНомераСтрок.Добавить(Стр.НомерСтроки);	
		КонецЕсли;	
	КонецЦикла;	
	
	Если мНомераСтрок.Количество() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("«В строке %1 уже установлен другой вид собственности, необходимо очистить поле или поменять вид собственности».",СтрСоединить(мНомераСтрок,",")));
		Возврат Ложь;
	КонецЕсли;	
	
	Возврат Истина;
	
КонецФункции	

&НаСервереБезКонтекста
Функция ЭтоПолныеПрава()
	Если РольДоступна("ПолныеПрава") Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции	

&НаКлиенте
Процедура ВыполнитьПослеОкончанияПредупрежденияСобственностьКТКПриИзменении(тек_СобственностьКТК) Экспорт
	Если тек_СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.СпотДоплатный") Тогда
		ДоплатныеКТКПриИзменении(Элементы.ДоплатныеКТК);
	КонецЕсли;
	Если тек_СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.Собственный") Тогда
		СобственныеКТКПриИзменении(Элементы.СобственныеКТК);
	КонецЕсли;		
КонецПроцедуры
	
// Евросиб(ДИТ) US 91364 ТА 95290 Шевченко А.В. Конец: 28.11.2024
&НаКлиенте
Процедура НоминацииСтавкаПриИзменении(Элемент)
	ТекД = Элементы.Номинации.ТекущиеДанные;
	Если НЕ ТекД = Неопределено Тогда
		Если ТекД.Ставка = 0 И НЕ ТекД.тек_СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.Спот") Тогда
			Сообщить("Нельзя устанавливать 0 Ставку для вида собственности не Спот");
			ТекД.Ставка = 0;
		Иначе
			Если ЗаполнятьПоПервойСтроке И ТекД.НомерСтроки = 1 Тогда
				Для каждого Строка из Объект.Номинации Цикл
					Если ТекД.тек_СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.Спот") Тогда
						Если Строка.тек_СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.Спот") Тогда
							Если ТекД.Ставка = 0 Тогда
								Строка.НулеваяСтавка = Истина;
							Иначе
								Строка.НулеваяСтавка = Ложь;
							КонецЕсли;
						КонецЕсли;
					Иначе
						Если ТекД.Ставка = 0 Тогда
							Строка.НулеваяСтавка = Истина;
						Иначе
							Строка.НулеваяСтавка = Ложь;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			Иначе
				Если ТекД.Ставка = 0 Тогда
					ТекД.НулеваяСтавка = Истина;
				Иначе
					ТекД.НулеваяСтавка = Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли; 
		
		// Евросиб(ДИТ) US 97286 ТА 97320 Сержантова А.С. Начало: 19.12.2024
		Если Объект.ДоплатныеКТК и ТекД.тек_СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.СпотДоплатный") 
			и ТекД.Ставка > 0 Тогда
			ТекД.Ставка = (-1) * ТекД.Ставка;
		КонецЕсли;
		// Евросиб(ДИТ) US 97286 ТА 97320 Сержантова А.С. Конец: 19.12.2024
		// Евросиб US 100954 TA 117458 Рыбьяков К.А. 09.01.2026 ((
		Если ТекД.Ставка < 0 Тогда
			Объект.ДоплатныеКТК = Истина;
			СобственностьКТК = ПредопределенноеЗначение("Перечисление.ВариантыСобственности.СпотДоплатный");
			Для Каждого Строка Из Объект.Номинации Цикл
				Строка.тек_СобственностьКТК = СобственностьКТК;
			КонецЦикла;
		КонецЕсли;
		// Евросиб Рыбьяков К.А. 09.01.2026 ))
	КонецЕсли;
КонецПроцедуры

// Евросиб Фролов (30.05.2022 Task №49741
&НаСервере
Процедура ЗаполнитьРелизыКлиентов()
		
	Если Объект.Номинации.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	ИдентификаторыСтрок = Объект.Номинации.Выгрузить().ВыгрузитьКолонку("ГУИДСтроки");
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СвязьРелизов.РелизКлиента КАК РелизКлиента,
	|	СвязьРелизов.ГУИДСтроки КАК ГУИДСтроки
	|ИЗ
	|	РегистрСведений.СвязьРелизов КАК СвязьРелизов
	|ГДЕ
	|	СвязьРелизов.РелизСобственника = &РелизСобственника
	|	И СвязьРелизов.ГУИДСтроки В(&МассивИдетификаторов)";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("РелизСобственника", Объект.Ссылка);
	Запрос.УстановитьПараметр("МассивИдетификаторов", ИдентификаторыСтрок);
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаРелизов = РезультатЗапроса.Выгрузить();
		
	Для Каждого СтрокаТаблицы Из Объект.Номинации Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.ГУИДСтроки) Тогда
			
			СтрокаРелиза = ТаблицаРелизов.Найти(СтрокаТаблицы.ГУИДСтроки, "ГУИДСтроки");
			
			Если СтрокаРелиза <> Неопределено Тогда
				СтрокаТаблицы.РелизКлиента = СтрокаРелиза.РелизКлиента;
			КонецЕсли;	
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

