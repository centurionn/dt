&НаСервере
Функция ПолучитьТипыЛокаций(ТолькоСток)
	Если ТолькоСток Тогда
		ТипыЛокацийКромеСтока = Новый СписокЗначений;
		ТипыЛокацийКромеСтока.Добавить(Справочники.ТипыЛокаций.Сток);
		Возврат ТипыЛокацийКромеСтока;
	Иначе
		ТипыЛокацийКромеСтока = Новый СписокЗначений;
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТипыЛокаций.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ТипыЛокаций КАК ТипыЛокаций
			//Евросиб Трундуков С.А. 02.02.2026 #129338 Начало
			|ГДЕ
			|	ТипыЛокаций.Ссылка В (ЗНАЧЕНИЕ(Справочник.ТипыЛокаций.АдресВНаселенномПункте), ЗНАЧЕНИЕ(Справочник.ТипыЛокаций.НаселенныйПункт), ЗНАЧЕНИЕ(Справочник.ТипыЛокаций.Порт), ЗНАЧЕНИЕ(Справочник.ТипыЛокаций.Регион), ЗНАЧЕНИЕ(Справочник.ТипыЛокаций.Страна))";
		    //Евросиб Трундуков С.А. 02.02.2026 #129338 Конец
			
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если НЕ ВыборкаДетальныеЗаписи.Ссылка = Справочники.ТипыЛокаций.Сток Тогда
				ТипыЛокацийКромеСтока.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
			КонецЕсли;
		КонецЦикла;
		
		Возврат ТипыЛокацийКромеСтока;
	КонецЕсли;
КонецФункции


