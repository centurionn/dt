&НаКлиенте
Процедура Номинациидопл_КалькуляцияНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка) 
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.Номинации.ТекущиеДанные;
	
	РазмерКТК = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(ТекДанные.ТипКТК, "РазмерКТК");
	РазмерКТК = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(РазмерКТК, "Размер");
	РазмерКТК = Строка(РазмерКТК);
	
	МассивКалькуляций = Новый Массив;
	
	Для Каждого Калькуляция Из СписокКалькуляцийИзПротокола Цикл
		ТарифицируемыйРазмерКТК = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(Калькуляция.Значение, "ТарифицируемыйРазмерКТК");
		Если РазмерКТК = "20" И ТарифицируемыйРазмерКТК = "20" Тогда
			МассивКалькуляций.Добавить(Калькуляция.Значение);
		ИначеЕсли РазмерКТК = "40" И ТарифицируемыйРазмерКТК = "40" Тогда
			МассивКалькуляций.Добавить(Калькуляция.Значение);
		ИначеЕсли ТарифицируемыйРазмерКТК = "2040" Тогда
			МассивКалькуляций.Добавить(Калькуляция.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ДоступныеКалькуляции", МассивКалькуляций);
	ДопПараметры.Вставить("СтандартнаяОбработка", СтандартнаяОбработка);
	
	ОбработкаВыбора = Новый ОписаниеОповещения("ПриЗакрытииФормыВыбораКалькуляции", ЭтаФорма, ДопПараметры);
	ОткрытьФорму("Документ.Калькуляция.ФормаВыбора", ДопПараметры, ЭтаФорма, , , ,ОбработкаВыбора , РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);

КонецПроцедуры

