Процедура ЗаполнитьДатыИзготовленияКТК()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номинации.Контейнер КАК Контейнер,
		|	Номинации.ДатаИзготовленияКТК КАК ДатаИзготовленияКТК
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&Номинации КАК Номинации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Контейнер КАК Контейнер,
		|	ТЕ.ДатаИзготовленияКТК КАК ДатаИзготовленияКТК
		|ИЗ
		|	ВТ КАК ВТ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТЕ КАК ТЕ
		|		ПО ВТ.Контейнер = ТЕ.Ссылка
		|			И ВТ.ДатаИзготовленияКТК <> ТЕ.ДатаИзготовленияКТК
		|ГДЕ
		|	ВТ.Контейнер <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("Номинации", Объект.Номинации.Выгрузить(,"Контейнер,ДатаИзготовленияКТК"));
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтрокиНоминации = Объект.Номинации.НайтиСтроки(Новый Структура("Контейнер", ВыборкаДетальныеЗаписи.Контейнер));
		СтрокиНоминации[0].ДатаИзготовленияКТК = ВыборкаДетальныеЗаписи.ДатаИзготовленияКТК;
	КонецЦикла;
	
КонецПроцедуры
