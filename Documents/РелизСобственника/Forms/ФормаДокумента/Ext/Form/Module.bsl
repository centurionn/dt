&НаКлиенте
Процедура СоздатьПротоколНаДоплатныеКТК(Команда)
	
	Если ЗначениеЗаполнено(Объект.ПСЦ) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Протокол уже заполнен.'"), , "ПСЦ", "Объект");
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда
		Если Объект.Проведен Тогда
			РезультатЗаписи = Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
		Иначе
			РезультатЗаписи = Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись));
		КонецЕсли;
		Если Не РезультатЗаписи Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ДанныеЗаполнения = ДанныеЗаполненияДляПротокола();
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Основание", ДанныеЗаполнения);
	
	//ОписаниеОповещения = Новый ОписаниеОповещения("ПослеСозданияПротокола", ЭтаФорма);
	
	ОткрытьФорму("Документ.ПСЦ.ФормаОбъекта", 
		ПараметрыФормы, 
		ЭтаФорма, 
		ЭтаФорма.УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНаВсеКТК(Команда)
	
	ВыбранныеСтроки = Новый Массив;
	
	ВключаяНДСИлиНет = Неопределено;	
	
	Для Каждого Строка Из Объект.Номинации Цикл
		СчетНаОплатуВКлюче = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(Строка.КлючАналитики, "СчетНаОплатуПокупателю");
		Если Не ЗначениеЗаполнено(СчетНаОплатуВКлюче) И ЗначениеЗаполнено(Строка.Контейнер) Тогда
			ВключаяНДСИлиНет = Строка.НДСВключая;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Строка Из Объект.Номинации Цикл
		СчетНаОплатуВКлюче = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(Строка.КлючАналитики, "СчетНаОплатуПокупателю");
		Если Не ЗначениеЗаполнено(СчетНаОплатуВКлюче) 
			И Строка.НДСВключая = ВключаяНДСИлиНет 
			И ЗначениеЗаполнено(Строка.Контейнер) Тогда
			ВыбранныеСтроки.Добавить(Строка.КлючАналитики);
		КонецЕсли;
	КонецЦикла;
	
	Если ВыбранныеСтроки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'У всех строк есть счета на оплату.'"));
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда
		Если Объект.Проведен Тогда
			РезультатЗаписи = Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
		Иначе
			РезультатЗаписи = Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись));
		КонецЕсли;
		Если Не РезультатЗаписи Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ДанныеЗаполнения = ДанныеЗаполненияСчетаНаОплату(ВыбранныеСтроки);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Основание", ДанныеЗаполнения);
	
	ОписаниеОповещения = Новый 
		ОписаниеОповещения("ПослеСозданияСчетаНаОплатуПокупателю", ЭтаФорма, ДанныеЗаполнения.КлючиАналитики);
	
	ОткрытьФорму("Документ.СчетНаОплатуПокупателю.ФормаОбъекта", 
		ПараметрыФормы, 
		ЭтаФорма, 
		ЭтаФорма.УникальныйИдентификатор, 
		, 
		, 
		ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНаВыбранныеКТК(Команда)
	
	Если Модифицированность Тогда
		Если Объект.Проведен Тогда
			РезультатЗаписи = Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
		Иначе
			РезультатЗаписи = Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись));
		КонецЕсли;
		Если Не РезультатЗаписи Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
