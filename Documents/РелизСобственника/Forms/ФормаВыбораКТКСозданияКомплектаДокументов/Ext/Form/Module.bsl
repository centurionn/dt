
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	КТКВХранилище = Параметры.КТКВХранилище;

	Клиент = Параметры.Клиент;
	Договор = Параметры.Договор;
	РелизСобственника = Параметры.РелизСобственника;
	
	ДанныеИзРелиза = ПолучитьИзВременногоХранилища(КТКВХранилище);
	ТаблицаКонтейнеров.Загрузить(ДанныеИзРелиза);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьКомплектДокументов(Команда)
	
	ПараметрыФормы = ПодготовитьПараметрыФормыСозданияКомплектаДокументов();
	ПараметрыФормы.Вставить("РелизСобственника", РелизСобственника);
	Если ПараметрыФормы <> Неопределено Тогда
		ОткрытьФорму("Документ.Сделка.Форма.ФормаСозданияКомплектаДокументов", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВсе(Команда)
	Для Каждого Строка Из ТаблицаКонтейнеров Цикл
		Строка.Выбрать = Истина;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	Для Каждого Строка Из ТаблицаКонтейнеров Цикл
		Строка.Выбрать = Ложь;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

&НаСервере
Функция ПодготовитьПараметрыФормыСозданияКомплектаДокументов()
	// Евросиб US 82073 TA 114490 Рыбьяков К.А. 14.07.2025 ((
	РеестрСогласования = СоздатьРеестрСогласования();
	
	Если ЗначениеЗаполнено(РеестрСогласования) Тогда
		Для Каждого Строка Из ТаблицаКонтейнеров Цикл
			Строка.РеестрСогласования = РеестрСогласования;
		КонецЦикла;
	КонецЕсли;
	
	ТаблицаВыбранных = ТаблицаКонтейнеров.Выгрузить(Новый Структура("Выбрать", Истина));
	
	ПараметрыФормы =  Новый Структура;
	
	Если ТаблицаВыбранных.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбраны строки для создания комплекта документов");
		Возврат Неопределено;
	Конецесли;
	
	ПоляТаблицыНаправлений = "ПунктОтправления, ПунктНазначения";
	Направления = ТаблицаВыбранных.Скопировать(, ПоляТаблицыНаправлений);
	Направления.Свернуть(ПоляТаблицыНаправлений);
	Если Направления.Количество() > 1 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выбраны строки с разными направлениями. Необходимо выбрать строки по одному направлению.");
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокиБезДоходов = ТаблицаВыбранных.Скопировать(Новый Структура("ИдентификаторСтрокиДоходовСделки", ""));
	Если СтрокиБезДоходов.Количество() > 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выбраны строки по которым не сформирована экономика в сделках.");
		Возврат Неопределено;
	КонецЕсли;
	
	ПоляТаблицыДоходовСделок = "Сделка, ИдентификаторСтрокиДоходовСделки";
	ДоходыСделок = ТаблицаВыбранных.Скопировать(, ПоляТаблицыДоходовСделок);
	ДоходыСделок.Свернуть(ПоляТаблицыДоходовСделок);
	
	МассивСтрок = Обработки.ЗагрузкаРеестраВСК.ПодготовитьТаблицуПоДокументам1(РеестрСогласования, ДоходыСделок, РелизСобственника);
	ПараметрыФормы.Вставить("МассивСтрок", МассивСтрок);
	ПараметрыФормы.Вставить("ИзРелиза", Истина);
	
	Таблица = ТаблицаВыбранных.Скопировать(, "Заявка, Сделка, Контейнер, ПунктОтправления, ПунктНазначения, РеестрСогласования");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаКонтейнеров", Таблица);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаКонтейнеров.Заявка КАК Заявка,
	|	ТаблицаКонтейнеров.Сделка КАК Сделка,
	|	ТаблицаКонтейнеров.Контейнер КАК Контейнер,
	|	ТаблицаКонтейнеров.РеестрСогласования КАК Реестр,
	|	ТаблицаКонтейнеров.ПунктОтправления КАК ПунктОтправления,
	|	ТаблицаКонтейнеров.ПунктНазначения КАК ПунктНазначения
	|ПОМЕСТИТЬ Контейнеры
	|ИЗ
	|	&ТаблицаКонтейнеров КАК ТаблицаКонтейнеров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Контейнеры.Заявка КАК Заявка,
	|	Контейнеры.Сделка КАК Сделка,
	|	Контейнеры.Контейнер КАК Контейнер,
	|	РеестрыСогласования.Наименование КАК НомерРеестра,
	|	ПунктыОтправления.Наименование + ""-"" + ПунктыНазначения.Наименование КАК Маршрут,
	|	ДокСделка.ТипЗаказа КАК ТипЗаказа
	|ИЗ
	|	Контейнеры КАК Контейнеры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РеестрыСогласования КАК РеестрыСогласования
	|		ПО Контейнеры.Реестр = РеестрыСогласования.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Локации КАК ПунктыОтправления
	|		ПО Контейнеры.ПунктОтправления = ПунктыОтправления.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Локации КАК ПунктыНазначения
	|		ПО Контейнеры.ПунктНазначения = ПунктыНазначения.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка КАК ДокЗаявка
	|		ПО Контейнеры.Заявка = ДокЗаявка.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка КАК ДокСделка
	|		ПО Контейнеры.Сделка = ДокСделка.Ссылка";
	
	Таблица = Запрос.Выполнить().Выгрузить();
	АдресТаблицыКТК = ПоместитьВоВременноеХранилище(Таблица, Новый УникальныйИдентификатор);
	ПараметрыФормы.Вставить("КТКВХранилище", АдресТаблицыКТК);
	ПараметрыФормы.Вставить("РеестрКлиента", РеестрСогласования);
	
	Возврат ПараметрыФормы;
	// Евросиб Рыбьяков К.А. 14.07.2025 ))
КонецФункции

&НаСервере
Функция СоздатьРеестрСогласования()
	
	Направления = ТаблицаКонтейнеров.Выгрузить(Новый Структура("Выбрать", Истина), "ПунктОтправления, ПунктНазначения");
	Направления.Свернуть("ПунктОтправления, ПунктНазначения");
	
	РеестрСсылка = Справочники.РеестрыСогласования.ПустаяСсылка();
	
	Для Каждого Направление Из Направления Цикл
		
		НовыйРеестр = Справочники.РеестрыСогласования.СоздатьЭлемент();
		
		НаименованиеРеестра = СтрШаблон("%1_%2", Формат(ТекущаяДата(), "ДФ=dd.MM.yy"), Клиент);
		Если ЗначениеЗаполнено(ПериодРеестра.ДатаНачала) И ЗначениеЗаполнено(ПериодРеестра.ДатаОкончания) Тогда
			НаименованиеРеестра = СтрШаблон("№ %1_%2", Формат(ПериодРеестра.ДатаНачала, "ДФ=dd.MM.yy"), Формат(ПериодРеестра.ДатаОкончания, "ДФ=dd.MM.yy"));
		КонецЕсли;  
		НаименованиеРеестра = Сред(НаименованиеРеестра, 1, Метаданные.Справочники.РеестрыСогласования.ДлинаНаименования);
		НаименованиеРеестра = НаименованиеРеестра;
		НовыйРеестр.Наименование = НаименованиеРеестра;
		
		НовыйРеестр.Клиент = Клиент;
		НовыйРеестр.Договор = Договор;
		НовыйРеестр.Организация = Константы.ОсновнаяОрганизация.Получить();
		НовыйРеестр.ПериодРеестраНачало = ПериодРеестра.ДатаНачала;
		НовыйРеестр.ПериодРеестраОкончание = НачалоДня(ПериодРеестра.ДатаОкончания);
		
		СтрокиПоНаправлению = ТаблицаКонтейнеров.НайтиСтроки(Новый Структура("Выбрать, ПунктОтправления, ПунктНазначения", Истина, Направление.ПунктОтправления, Направление.ПунктНазначения));
		Для Каждого СтрокаПоНаправлению Из СтрокиПоНаправлению Цикл
			НайденныеСтрокиРеестра = НовыйРеестр.ПереченьКонтейнеров.НайтиСтроки(Новый Структура("ПунктОтправления, ПунктНазначения, Контейнер", СтрокаПоНаправлению.ПунктОтправления, СтрокаПоНаправлению.ПунктНазначения, СтрокаПоНаправлению.Контейнер));
			Если ЗначениеЗаполнено(НайденныеСтрокиРеестра) Тогда
				СтрокаРеестра = НайденныеСтрокиРеестра[0];
			Иначе
				СтрокаРеестра = НовыйРеестр.ПереченьКонтейнеров.Добавить();
				СтрокаРеестра.ПунктОтправления = СтрокаПоНаправлению.ПунктОтправления;
				СтрокаРеестра.ПунктНазначения = СтрокаПоНаправлению.ПунктНазначения;
				СтрокаРеестра.Маршрут = "" + Строка(СтрокаПоНаправлению.ПунктОтправления) + "-" + Строка(СтрокаПоНаправлению.ПунктНазначения);
				СтрокаРеестра.Контейнер = СтрокаПоНаправлению.Контейнер;
				СтрокаРеестра.ЗаявкаВСистеме = СтрокаПоНаправлению.Заявка;
			КонецЕсли;
		КонецЦикла;
		
		НовыйРеестр.Записать();
		
		РеестрСсылка = НовыйРеестр.Ссылка;
		
	КонецЦикла;
	
	Возврат РеестрСсылка;
	
КонецФункции

