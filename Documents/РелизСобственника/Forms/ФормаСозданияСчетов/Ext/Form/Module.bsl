
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	
	РелизСсылка = Параметры.Ключ;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	РелизСобственникаНоминации.Валюта КАК Валюта,
	|	РелизСобственникаНоминации.ГУИДСтроки КАК ГУИДСтроки,
	|	РелизСобственникаНоминации.ДатаВзятия КАК ДатаВзятия,
	|	РелизСобственникаНоминации.Контейнер КАК Контейнер,
	|	РелизСобственникаНоминации.НДСВключая КАК НДСВключая,
	|	РелизСобственникаНоминации.НормативВозврата КАК НормативВозврата,
	|	РелизСобственникаНоминации.НулеваяСтавка КАК НулеваяСтавка,
	|	РелизСобственникаНоминации.Ставка КАК Ставка,
	|	РелизСобственникаНоминации.СтавкаНДС КАК СтавкаНДС,
	|	РелизСобственникаНоминации.ТипКТК КАК ТипКТК,
	|	РелизСобственникаНоминации.Ссылка КАК Релиз,
	|	РелизСобственникаНоминации.КлючАналитики КАК КлючАналитики
	|ИЗ
	|	Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	|ГДЕ
	|	РелизСобственникаНоминации.Ссылка = &Ссылка
	|	И РелизСобственникаНоминации.КлючАналитики.СчетНаОплатуПокупателю = ЗНАЧЕНИЕ(Документ.СчетНаОплатуПокупателю.ПустаяСсылка)
	|	И РелизСобственникаНоминации.Контейнер <> Значение(Справочник.ТЕ.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("Ссылка", РелизСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ДоступныеСтрокиДляСоздания.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьВсе(Команда)
	Для Каждого Строка Из ДоступныеСтрокиДляСоздания Цикл
		Строка.Выбрать = Истина;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	Для Каждого Строка Из ДоступныеСтрокиДляСоздания Цикл
		Строка.Выбрать = Ложь;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьСчета(Команда)
	
	ВыбранныеСтроки = Новый Массив;
	
	ВключаяНДСИлиНет = Неопределено;
	
	Для Каждого Строка Из ДоступныеСтрокиДляСоздания Цикл
		Если Строка.Выбрать Тогда
			ВключаяНДСИлиНет = Строка.НДСВключая;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Строка Из ДоступныеСтрокиДляСоздания Цикл
		Если Строка.НДСВключая = ВключаяНДСИлиНет И Строка.Выбрать Тогда
			ВыбранныеСтроки.Добавить(Строка.КлючАналитики);
		КонецЕсли;
	КонецЦикла;
	
	Если ВыбранныеСтроки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбрано ни одной строки.'"));
		Возврат;
	КонецЕсли;
	
	ДанныеЗаполнения = ДанныеЗаполненияСчетаНаОплату(ВыбранныеСтроки);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Основание", ДанныеЗаполнения);
	
	ОписаниеОповещения = Новый 
		ОписаниеОповещения("ПослеЗакрытияСчетаНаОплатуПокупателю", ЭтаФорма, ВыбранныеСтроки);
	
	ОткрытьФорму("Документ.СчетНаОплатуПокупателю.ФормаОбъекта", 
		ПараметрыФормы, 
		ЭтаФорма, 
		, 
		, 
		, 
		ОписаниеОповещения);
		
	Закрыть();
		
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОкноСИнструкциями(Форма, Команда)
	ИнструкцииКлиент.ОткрытьОкноСИнструкциями(ЭтаФорма, Команда);
КонецПроцедуры  

&НаКлиенте
Процедура УказатьКТКДляСчета(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КТК", Истина);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаУказанияКТКДляСчета", ЭтаФорма, Новый Структура("КТК", Истина));
	
	ОткрытьФорму("ОбщаяФорма.ВставкаИзБуфераОбмена", 
		ПараметрыФормы, 
		, 
		ЭтаФорма.УникальныйИдентификатор, 
		, 
		, 
		ОписаниеОповещения, 
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ДанныеЗаполненияСчетаНаОплату(ВыбранныеСтроки)
	
	Возврат Документы.РелизСобственника.ДанныеЗаполненияСчетаНаОплату(ВыбранныеСтроки, РелизСсылка);
	
КонецФункции

&НаСервере
Процедура ЗаписатьСчетВКлючиАналитики(СчетНаОплату, КлючиАналитики) Экспорт
	
	
	Для Каждого Ключ Из КлючиАналитики Цикл
		КлючАналитикиСтроки = Ключ.ПолучитьОбъект();
		КлючАналитикиСтроки.СчетНаОплатуПокупателю = СчетНаОплату;
		УстановитьПривилегированныйРежим(Истина);
		КлючАналитикиСтроки.Записать();
		УстановитьПривилегированныйРежим(Ложь);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияСчетаНаОплатуПокупателю(Результат, Параметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	Иначе
		ЗаписатьСчетВКлючиАналитики(Результат, Параметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаУказанияКТКДляСчета(Параметр1 = Неопределено, Параметр2 = Неопределено) Экспорт
	
	Если Параметр1 <> Неопределено И Параметр2 <> Неопределено И Параметр2.Свойство("КТК") Тогда
		Для Каждого Контейнер из Параметр1 Цикл
			НайденныеСтроки = ДоступныеСтрокиДляСоздания.НайтиСтроки(Новый Структура("Контейнер", Контейнер));
			Если НайденныеСтроки.Количество() > 0 Тогда
				НайденныеСтроки[0].Выбрать = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

