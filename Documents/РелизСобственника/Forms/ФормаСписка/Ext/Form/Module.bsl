		//	Список.Параметры.УстановитьЗначениеПараметра("ПустойСписокКТК",Ложь);
		//	Список.Параметры.УстановитьЗначениеПараметра("СписокКТК",СписокКТКОтбор);
		//КонецЕсли;
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Ссылка.Номинации.Контейнер", СписокКТКОтбор, 
																			ВидСравненияКомпоновкиДанных.ВСписке,, (СписокКТКОтбор.Количество() > 0)); 
