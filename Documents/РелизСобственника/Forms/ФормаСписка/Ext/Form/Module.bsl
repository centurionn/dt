
&НаКлиенте
Процедура СписокСтоковПриАктивизацииСтроки(Элемент)
	
	ТекД = Элементы.СписокСтоков.ТекущиеДанные;
	
	Если ТекД = неопределено Тогда Возврат; КонецЕсли;
	
	// остатки по стокам
	ОтборРегион = неопределено;
	Если ТекД.Свойство("Ссылка") Тогда
		ОтборРегион = ТекД.Ссылка;
	ИначеЕсли ТекД.Свойство("ГруппировкаСтроки") Тогда
		ОтборРегион = ТекД.ГруппировкаСтроки.Ключ;
	КонецЕсли;
	
	//Евросиб Коханенко Н.А. 11.07.2024 (( #88014 
	//Список.Параметры.УстановитьЗначениеПараметра("СтокВыбр", ОтборРегион);
	//Список.Параметры.УстановитьЗначениеПараметра("СтокНеОграничен", НЕ ТолькоДанныеПоСтоку);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Сток", ОтборРегион, 
																			ВидСравненияКомпоновкиДанных.ВИерархии,, ТолькоДанныеПоСтоку); 
	//Евросиб Коханенко Н.А. 11.07.2024 )) #88014
	
КонецПроцедуры

