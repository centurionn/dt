&НаКлиенте
Процедура ТабличнаяЧастьПриИзменении(Элемент)
	
	СтрокиОтображающиесяПослеОтбора = Новый Массив;
	ИмяТЧ = Элемент.Имя;
	ИмяПоля = Сред(Элемент.ТекущийЭлемент.Имя, СтрДлина(ИмяТЧ) + 1);
	ЗначениеТекущейСтроки = Элемент.ТекущиеДанные[ИмяПоля];

	Для Каждого Строка Из ТабличнаяЧасть Цикл
		Если Элементы.ТабличнаяЧасть.ПроверитьСтроку(Строка.ПолучитьИдентификатор()) Тогда
			СтрокиОтображающиесяПослеОтбора.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	
	Если ЗаполнятьВоВсехСтроках Тогда
		Для Каждого Строка Из СтрокиОтображающиесяПослеОтбора Цикл
			Строка[ИмяПоля] = ЗначениеТекущейСтроки;
			ИндексСтроки = ТабличнаяЧасть.Индекс(Строка);
			//Попытка
			//	Выполнить("" + Элемент.ТекущийЭлемент.Имя + "ПриИзменении" + "(Элементы[ИмяТЧ][ИмяПоля])");
			//Исключение
			//КонецПопытки
		КонецЦикла;
	КонецЕсли;

	Если ЗаполнятьВниз Тогда
		ИндексТекущейСтроки = ТабличнаяЧасть.Индекс(Элемент.ТекущиеДанные);
		Для Счетчик = ИндексТекущейСтроки + 1 По ТабличнаяЧасть.Количество() - 1 Цикл
			ТабличнаяЧасть[Счетчик][ИмяПоля] = ЗначениеТекущейСтроки;
			//Попытка
			//	Выполнить("" + Элемент.ТекущийЭлемент.Имя + "ПриИзменении" + "([ИмяТЧ][ИндексСтроки])");
			//Исключение
			//КонецПопытки
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличнаяЧастьСтокСдачиАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если ВозможныеСтокиСдачи.Количество() > 0 Тогда
		ДанныеВыбора = ВозможныеСтокиСдачи;
	ИначеЕсли ЛокацииСдачи.Количество() > 0 Тогда
		ДанныеВыбора = ЛокацииСдачи;
	Иначе
		СтандартнаяОбработка = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличнаяЧастьСтокСдачиОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Текст) Тогда
		СтандартнаяОбработка = Ложь;
		Если ВозможныеСтокиСдачи.Количество() > 0 Тогда
			ДанныеВыбора = ВозможныеСтокиСдачи;
		ИначеЕсли ЛокацииСдачи.Количество() > 0 Тогда
			ДанныеВыбора = ЛокацииСдачи;
		Иначе
			СтандартнаяОбработка = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

