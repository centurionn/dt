&НаКлиенте
Процедура ЗагрузитьДанныеОСдачеКТК(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаДобавленияКТК", ЭтаФорма);
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ", РелизСобственникаСсылка);
	ПараметрыФормы.Вставить("ВозможныеСтокиСдачи", ВозможныеСтокиСдачи);
	ПараметрыФормы.Вставить("ЛокацииСдачи", ЛокацииСдачи);
	ПараметрыФормы.Вставить("РелизДоплатный", РелизДоплатный);
	ОткрытьФорму("Документ.РелизСобственника.Форма.ФормаВставкиИзБуфераОбмена", ПараметрыФормы, , ЭтаФорма.УникальныйИдентификатор, ,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

