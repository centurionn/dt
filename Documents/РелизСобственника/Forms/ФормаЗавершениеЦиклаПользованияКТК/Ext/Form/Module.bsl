#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьТабличнуЧасть()
	
	ТабличнаяЧасть.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	РелизСобственникаНоминации.Контейнер КАК Контейнер,
	|	КлючиАналитикиНоминацийРелиза.СтокВыдачи КАК СтокВыдачи,
	|	КлючиАналитикиНоминацийРелиза.ДатаВозвратаКлиентом КАК ДатаВозвратаКлиентом,
	|	РелизСобственникаНоминации.ДатаВзятия КАК ДатаВзятия
	|ПОМЕСТИТЬ ВТ_ДанныеРелиза
	|ИЗ
	|	Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиНоминацийРелиза КАК КлючиАналитикиНоминацийРелиза
	|		ПО (РелизСобственникаНоминации.КлючАналитики = КлючиАналитикиНоминацийРелиза.Ссылка)
	|ГДЕ
	|	РелизСобственникаНоминации.Ссылка = &Ссылка
	|	И РелизСобственникаНоминации.ДатаВзятия <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|	И РелизСобственникаНоминации.Контейнер <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	стоки_ТекущиеДанныеСрезПоследних.тек_ДатаСдачиВСток КАК тек_ДатаСдачиВСток,
	|	стоки_ТекущиеДанныеСрезПоследних.КТК КАК КТК,
	|	стоки_ТекущиеДанныеСрезПоследних.тек_СтокСдачи КАК тек_СтокСдачи
	|ПОМЕСТИТЬ ВТ_ДатаВозвратаСобственнику
	|ИЗ
	|	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних(
	|			,
	|			КТК В (ВЫБРАТЬ
	|						ВТ_ДанныеРелиза.Контейнер
	|					ИЗ
	|						ВТ_ДанныеРелиза)
	|				И тек_Релиз = &Ссылка) КАК стоки_ТекущиеДанныеСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеРелиза.Контейнер КАК Контейнер,
	|	ВТ_ДанныеРелиза.СтокВыдачи КАК СтокВыдачи,
	|	ВТ_ДанныеРелиза.ДатаВозвратаКлиентом КАК ДатаВозвратаКлиентом,
	|	ВТ_ДанныеРелиза.ДатаВзятия КАК ДатаВзятия,
	|	ВТ_ДатаВозвратаСобственнику.тек_ДатаСдачиВСток КАК тек_ДатаСдачиВСток,
	|	ВТ_ДатаВозвратаСобственнику.тек_СтокСдачи КАК тек_СтокСдачи
	|ИЗ
	|	ВТ_ДанныеРелиза КАК ВТ_ДанныеРелиза
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДатаВозвратаСобственнику КАК ВТ_ДатаВозвратаСобственнику
	|		ПО (ВТ_ДанныеРелиза.Контейнер = ВТ_ДатаВозвратаСобственнику.КТК)
	|ГДЕ
	|	ВТ_ДатаВозвратаСобственнику.тек_ДатаСдачиВСток = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)";
	
	Запрос.УстановитьПараметр("Ссылка", РелизСобственникаСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТабличнаяЧасть.Добавить();
		НоваяСтрока.Контейнер = Выборка.Контейнер;
		НоваяСтрока.СтокСдачиПорожКТКНаТерминал = Выборка.СтокВыдачи;
		НоваяСтрока.ДатаСдачиПорожКТКНаТерминал = Выборка.ДатаВозвратаКлиентом;
		НоваяСтрока.ДатаВзятия = Выборка.ДатаВзятия;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция КорректныДатыПериодаПриемаСдачи(КТК, ДатаВзятия, ДатаВозвратаСобственнику)

	Результат = Истина;
	
	Если ЗначениеЗаполнено(ДатаВозвратаСобственнику) И ДатаВозвратаСобственнику < ДатаВзятия Тогда
		СтрокаСообщения = СтрШаблон("Для КТК %1 дата возврата %2 меньше даты приема %3 в пользование. Запись отменена.", 
									КТК, 
									ФорматДатыБезВремени(ДатаВозвратаСобственнику),
									ФорматДатыБезВремени(ДатаВзятия));
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрокаСообщения);
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ФорматДатыБезВремени(Дата)
	Возврат Формат(Дата, "ДФ=dd.MM.yyyy");
КонецФункции

&НаСервере
Процедура ЗаполнитьВозможныеСтокиСдачиДляПроверок()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", РелизСобственникаСсылка);
	
	//Если РелизДоплатный Тогда
		Запрос.Текст = "ВЫБРАТЬ
		|	МультилокацииЛокации.Локация КАК Локация
		|ИЗ
		|	Документ.РелизСобственника КАК РелизСобственника
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Мультилокации.Локации КАК МультилокацииЛокации
		|		ПО (РелизСобственника.ВозможныеСтокиСдачи = МультилокацииЛокации.Ссылка)
		|ГДЕ
		|	РелизСобственника.Ссылка = &Ссылка
		|	И НЕ МультилокацииЛокации.Локация ЕСТЬ NULL";
		
		ВозможныеСтоки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Локация");
		
		Если ВозможныеСтоки.Количество() > 0 Тогда
			ВозможныеСтокиСдачи.ЗагрузитьЗначения(ВозможныеСтоки);
			
			НовыеЗначения = Новый ФиксированныйМассив(ВозможныеСтоки);
			НовыйПараметр = Новый ПараметрВыбора("Отбор.Ссылка", НовыеЗначения);
			НовыйМассив = Новый Массив();
			НовыйМассив.Добавить(НовыйПараметр);
			
			НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
			Элементы.ТабличнаяЧастьСтокСдачи.ПараметрыВыбора = НовыеПараметры;
			
		Иначе
			Запрос.Текст = "ВЫБРАТЬ
			|	ВЫБОР 
			|		КОГДА РелизСобственника.ЛокацияСдачи ССЫЛКА Справочник.Мультилокации
			|			ТОГДА МультилокацииЛокации.Локация
			|			ИНАЧЕ РелизСобственника.ЛокацияСдачи
			|	КОНЕЦ КАК Локация
			|ИЗ
			|	Документ.РелизСобственника КАК РелизСобственника
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Мультилокации.Локации КАК МультилокацииЛокации
			|		ПО (РелизСобственника.ЛокацияСдачи = МультилокацииЛокации.Ссылка)
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Локации КАК СправочникЛокации
			|		ПО (РелизСобственника.ЛокацияСдачи = СправочникЛокации.Ссылка)
			|ГДЕ
			|	РелизСобственника.Ссылка = &Ссылка";
			
			Стоки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Локация");
			
			Если Стоки.Количество() > 0 Тогда
				ЛокацииСдачи.ЗагрузитьЗначения(Стоки);
				
				НовыеЗначения = Новый ФиксированныйМассив(Стоки);
				НовыйПараметр = Новый ПараметрВыбора("Отбор.Ссылка", НовыеЗначения);
				НовыйМассив = Новый Массив();
				НовыйМассив.Добавить(НовыйПараметр);
				
				НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
				Элементы.ТабличнаяЧастьСтокСдачи.ПараметрыВыбора = НовыеПараметры;
			КонецЕсли;
		КонецЕсли;
	//Иначе
		//Запрос.Текст = "ВЫБРАТЬ
		//|	ВЫБОР 
		//|		КОГДА РелизСобственника.ЛокацияСдачи ССЫЛКА Справочник.Мультилокации
		//|			ТОГДА МультилокацииЛокации.Локация
		//|			ИНАЧЕ РелизСобственника.ЛокацияСдачи
