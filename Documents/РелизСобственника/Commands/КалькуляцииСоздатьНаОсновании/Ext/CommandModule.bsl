	КонецЕсли;
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, 
		РелизСсылка, 
		ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Объект.СтавкиДоплатныхКТК", ДополнительныеДанные.НомерСтрокиДляСообщения, "НомерСтроки"));
	
