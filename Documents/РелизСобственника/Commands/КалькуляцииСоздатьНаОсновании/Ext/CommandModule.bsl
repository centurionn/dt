&НаСервере
Функция ОтсортироватьСтрокуЧисел(Строка)
	
	Подстроки = СтрРазделить(Строка, ", ", Ложь);
	
	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.ЗагрузитьЗначения(Подстроки);
	СписокЗначений.СортироватьПоЗначению();
	Массив = СписокЗначений.ВыгрузитьЗначения(); 
	
	ОбработаннаяСтрока = СтрСоединить(Массив, ", ");
	
	Возврат ОбработаннаяСтрока;
	
КонецФункции

&НаСервере
Процедура УбратьИзВыгрузкиПараметрыУжеСозданныхКалькуляций(Таблица, Релиз, НомераСтрок, НомерСтрокиДляСообщения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Калькуляция.Ссылка КАК Ссылка,
	|	Калькуляция.Валюта КАК Валюта,
	|	Калькуляция.СтавкаНДС КАК СтавкаНДС,
	|	Калькуляция.СуммаВключаетНДС КАК НДСвключен,
	|	Калькуляция.Суша_ПунктОтправления КАК Локация,
	|	Калькуляция.Суша_ПунктНазначения КАК ЛокацияСдачиИзСтавок,
	|	КалькуляцияСписокСтанцийНазначения.Станция КАК СтокСдачи,
	|	Калькуляция.ММ_Вознаграждение КАК ММ_Вознаграждение,
	|	Калькуляция.ММ_Вознаграждение40 КАК ММ_Вознаграждение40,
	|	Калькуляция.ТарифицируемыйРазмерКТК КАК ТарифицируемыйРазмерКТК,
	|	Калькуляция.Договор КАК Договор,
	|	Калькуляция.Контрагент КАК Контрагент,
	|	Калькуляция.Организация КАК Организация
	|ИЗ
	|	Документ.Калькуляция КАК Калькуляция
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Калькуляция.СписокСтанцийНазначения КАК КалькуляцияСписокСтанцийНазначения
	|		ПО Калькуляция.Ссылка = КалькуляцияСписокСтанцийНазначения.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Калькуляция.СписокСтанцийОтправления КАК КалькуляцияСписокСтанцийОтправления
	|		ПО Калькуляция.Ссылка = КалькуляцияСписокСтанцийОтправления.Ссылка
	|ГДЕ
	|	Калькуляция.ДокументОснование = &Релиз
	|	И НЕ Калькуляция.ПометкаУдаления";

	Запрос.УстановитьПараметр("Релиз", Релиз);
			
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();

	ТаблицаОтбора = Таблица.Скопировать();
	ТаблицаОтбора.Очистить();
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.ТарифицируемыйРазмерКТК = "2040" Тогда
			НоваяСтрока = ТаблицаОтбора.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			НоваяСтрока.Ставка = Выборка.ММ_Вознаграждение;
			НоваяСтрока.РазмерКТК = Справочники.РазмерыКТК.К20;
			
			НоваяСтрока2 = ТаблицаОтбора.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока2, Выборка);
			НоваяСтрока2.Ставка = Выборка.ММ_Вознаграждение40;
			НоваяСтрока2.РазмерКТК = Справочники.РазмерыКТК.К40;
		ИначеЕсли Выборка.ТарифицируемыйРазмерКТК = "20" Тогда
			НоваяСтрока = ТаблицаОтбора.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			НоваяСтрока.Ставка = Выборка.ММ_Вознаграждение;
			НоваяСтрока.РазмерКТК = Справочники.РазмерыКТК.К20;
		ИначеЕсли Выборка.ТарифицируемыйРазмерКТК = "40" Тогда
			НоваяСтрока = ТаблицаОтбора.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			НоваяСтрока.Ставка = Выборка.ММ_Вознаграждение40;
			НоваяСтрока.РазмерКТК = Справочники.РазмерыКТК.К40;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Строка Из ТаблицаОтбора Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("Валюта", Строка.Валюта);
		Отбор.Вставить("СтавкаНДС", Строка.СтавкаНДС);
		Отбор.Вставить("НДСВключен", Строка.НДСВключен);
		Отбор.Вставить("Локация", Строка.Локация);
		Отбор.Вставить("ЛокацияСдачиИзСтавок", Строка.ЛокацияСдачиИзСтавок);
		Отбор.Вставить("СтокСдачи", Строка.СтокСдачи);
		Отбор.Вставить("Ставка", Строка.Ставка);
		Отбор.Вставить("Договор", Строка.Договор);
		Отбор.Вставить("Контрагент", Строка.Контрагент);
		Отбор.Вставить("Организация", Строка.Организация);
		Отбор.Вставить("РазмерКТК", Строка.РазмерКТК);
		
		НайденныеСтроки = Таблица.НайтиСтроки(Отбор);
		Для Каждого СтрокаТаблицы Из НайденныеСтроки Цикл
			НомерСтрокиДляСообщения = ?(СтрокаТаблицы.НомерСтроки > НомерСтрокиДляСообщения, СтрокаТаблицы.НомерСтроки, НомерСтрокиДляСообщения);
			НомераСтрок = НомераСтрок + Строка(СтрокаТаблицы.НомерСтроки) + ", ";
			Таблица.Удалить(СтрокаТаблицы);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти