&НаСервере
Функция ЕстьПодходящаяКалькуляция(Параметры, Территория, РелизСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Калькуляция.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Калькуляция КАК Калькуляция
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Калькуляция.СписокСтанцийНазначения КАК КалькуляцияСписокСтанцийНазначения
	|		ПО (КалькуляцияСписокСтанцийНазначения.Ссылка = Калькуляция.Ссылка)
	|ГДЕ
	|	Калькуляция.Договор = &Договор
	|	И Калькуляция.Организация = &Организация
	|	И Калькуляция.Контрагент = &Контрагент
	|	И Калькуляция.СтавкаНДС = &СтавкаНДС
	|	И Калькуляция.СуммаВключаетНДС = &СуммаВключаетНДС
	|	И (Калькуляция.Суша_ПунктНазначения = &Суша_ПунктНазначения 
	|		ИЛИ Калькуляция.Суша_ПунктНазначения = Неопределено)
	|	И Калькуляция.Суша_ПунктОтправления = &Суша_ПунктОтправления
	|	И Калькуляция.Валюта = &Валюта
	|	И Калькуляция.ТерриторияМаршрута = &ТерриторияМаршрута
	|	И Калькуляция.ММ_Вознаграждение40 = &ММ_Вознаграждение40
	|	И Калькуляция.ММ_Вознаграждение = &ММ_Вознаграждение
	|	И Калькуляция.ТарифицируемыйРазмерКТК = &РазмерКТК
	|	И Калькуляция.ДокументОснование = &ДокументОснование
	|	И (КалькуляцияСписокСтанцийНазначения.Станция В(&Станция)
	|			ИЛИ КалькуляцияСписокСтанцийНазначения.Ссылка ЕСТЬ NULL)
	|	И Калькуляция.ПометкаУдаления = Ложь";
	
	Запрос.УстановитьПараметр("ДокументОснование", РелизСсылка);
	Запрос.УстановитьПараметр("Валюта", Параметры.Валюта);
	Запрос.УстановитьПараметр("Договор", Параметры.Договор);
	Запрос.УстановитьПараметр("Контрагент", Параметры.Контрагент);
	Запрос.УстановитьПараметр("Организация", Параметры.Организация);
	Запрос.УстановитьПараметр("СтавкаНДС", Параметры.СтавкаНДС);
	Запрос.УстановитьПараметр("СуммаВключаетНДС", Параметры.НДСвключен);
	Запрос.УстановитьПараметр("Станция", Параметры.СтокиСдачи);
	Запрос.УстановитьПараметр("РазмерКТК", Параметры.РазмерКТК);
	Запрос.УстановитьПараметр("Суша_ПунктНазначения", Параметры.ЛокацияСдачиИзСтавок);
	Запрос.УстановитьПараметр("Суша_ПунктОтправления", Параметры.Локация);
	Запрос.УстановитьПараметр("ТерриторияМаршрута", Территория);
	Если Параметры.РазмерКТК = "20" Тогда
		Запрос.УстановитьПараметр("ММ_Вознаграждение", Параметры.Ставка20);
		Запрос.УстановитьПараметр("ММ_Вознаграждение40", 0);
	ИначеЕсли Параметры.РазмерКТК = "40" Тогда
		Запрос.УстановитьПараметр("ММ_Вознаграждение", 0);
		Запрос.УстановитьПараметр("ММ_Вознаграждение40", Параметры.Ставка40);
	ИначеЕсли Параметры.РазмерКТК = "2040" Тогда
		Запрос.УстановитьПараметр("ММ_Вознаграждение", Параметры.Ставка20);
		Запрос.УстановитьПараметр("ММ_Вознаграждение40", Параметры.Ставка40);
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = Ложь;
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ДополнительныеДанные(Данные, РелизСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	РелизСобственникаСтавкиДоплатныхКТК.НомерСтроки КАК НомерСтроки,
	|	РелизСобственникаСтавкиДоплатныхКТК.Ставка КАК Ставка,
	|	ПРЕДСТАВЛЕНИЕ(МАКСИМУМ(РелизСобственникаСтавкиДоплатныхКТК.ТипКТК.РазмерКТК)) КАК ТипКТК
	|ИЗ
	|	Документ.РелизСобственника.СтавкиДоплатныхКТК КАК РелизСобственникаСтавкиДоплатныхКТК
	|ГДЕ
	|	РелизСобственникаСтавкиДоплатныхКТК.Ссылка = &Релиз
	|	И РелизСобственникаСтавкиДоплатныхКТК.СтокСдачи = &СтокСдачи
	|	И РелизСобственникаСтавкиДоплатныхКТК.Валюта = &Валюта
	|	И РелизСобственникаСтавкиДоплатныхКТК.СтавкаНДС = &СтавкаНДС
	|	И РелизСобственникаСтавкиДоплатныхКТК.НДСвключен = &НДСвключен 
	|СГРУППИРОВАТЬ ПО
	|	РелизСобственникаСтавкиДоплатныхКТК.НомерСтроки,
	|	РелизСобственникаСтавкиДоплатныхКТК.Ставка";
	
	Запрос.УстановитьПараметр("Релиз", РелизСсылка);
	Запрос.УстановитьПараметр("Валюта", Данные.Валюта);
	Запрос.УстановитьПараметр("НДСвключен", Данные.НДСвключен);
	Запрос.УстановитьПараметр("СтавкаНДС", Данные.СтавкаНДС);
	Запрос.УстановитьПараметр("СтокСдачи", Данные.СтокСдачи);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	РезультатСтруктура = Новый Структура;
	
	НомераСтрок = "";
	Пока Выборка.Следующий() Цикл
		Номер = Строка(Выборка.НомерСтроки) + ", ";
		НомераСтрок = НомераСтрок + Номер;
		Если Выборка.ТипКТК = "20" Тогда
			РезультатСтруктура.Вставить("Ставка20", Выборка.Ставка);
			РезультатСтруктура.Вставить("Ставка40", 0);
		КонецЕсли;
		Если Выборка.ТипКТК = "40" Тогда
			РезультатСтруктура.Вставить("Ставка20", 0);
			РезультатСтруктура.Вставить("Ставка40", Выборка.Ставка);
		КонецЕсли;
	КонецЦикла;
	
	РезультатСтруктура.Вставить("НомерСтрокиДляСообщения", Строка(Выборка.НомерСтроки));
	РезультатСтруктура.Вставить("НомераСтрок", НомераСтрок);
	//РезультатСтруктура.Вставить("СтокиСдачи", НомераСтрок);

	Возврат РезультатСтруктура;
	
КонецФункции

&НаСервере
Функция СобратьНаборКалькуляцийДляСоздания(Выгрузка)
	
	МассивКалькуляции = Новый Массив;
	
	Выгрузка.Колонки.Добавить("СтрокаДобавлена", Новый ОписаниеТипов("Булево"));
	
	Для Каждого ПоисковаяСтрока Из Выгрузка Цикл
		
		Калькуляция = Новый Массив;

		Если ПоисковаяСтрока.СтрокаДобавлена Тогда
			Продолжить;
		Иначе
			СтруктураСтроки = СтруктураСтроки();
			ЗаполнитьЗначенияСвойств(СтруктураСтроки, ПоисковаяСтрока);
			Калькуляция.Добавить(СтруктураСтроки);
			ПоисковаяСтрока.СтрокаДобавлена = Истина;
		КонецЕсли;
		
		Отбор = Новый Структура;
		Отбор.Вставить("РазмерКТК", ПоисковаяСтрока.РазмерКТК);
		Отбор.Вставить("СтавкаНДС", ПоисковаяСтрока.СтавкаНДС);
		Отбор.Вставить("Валюта", ПоисковаяСтрока.Валюта);
		Отбор.Вставить("ЛокацияСдачиИзСтавок", ПоисковаяСтрока.ЛокацияСдачиИзСтавок);
		Отбор.Вставить("Ставка", ПоисковаяСтрока.Ставка);
		Отбор.Вставить("НДСвключен", ПоисковаяСтрока.НДСвключен);
		
		ПодходятПоРазмеруИКлючевымПараметрам = Выгрузка.НайтиСтроки(Отбор);
		Для Каждого Строка Из ПодходятПоРазмеруИКлючевымПараметрам Цикл
			Если Строка.СтрокаДобавлена Тогда
				Продолжить;
			Иначе
				СтруктураСтроки = СтруктураСтроки();
				ЗаполнитьЗначенияСвойств(СтруктураСтроки, Строка);
				Калькуляция.Добавить(СтруктураСтроки);
				Строка.СтрокаДобавлена = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Отбор2 = Новый Структура;
		Отбор2.Вставить("СтавкаНДС", ПоисковаяСтрока.СтавкаНДС);
		Отбор2.Вставить("Валюта", ПоисковаяСтрока.Валюта);
		Отбор2.Вставить("НДСвключен", ПоисковаяСтрока.НДСвключен);
		Отбор2.Вставить("ЛокацияСдачиИзСтавок", ПоисковаяСтрока.ЛокацияСдачиИзСтавок);
		Отбор2.Вставить("СтрокаДобавлена", Ложь);
		
		ПодходящаяСтрокаНайдена = Ложь;
		
		ПодходятПоКлючевымПараметрам = Выгрузка.НайтиСтроки(Отбор2);
		Для Каждого Строка Из ПодходятПоКлючевымПараметрам Цикл
			Если ПодходящаяСтрокаНайдена = Ложь Тогда
				Если Строка.РазмерКТК <> ПоисковаяСтрока.РазмерКТК Тогда
					ПодходящаяСтрокаНайдена = Истина;
				Иначе
					Продолжить;
				КонецЕсли;

				СтруктураСтроки = СтруктураСтроки();
				ЗаполнитьЗначенияСвойств(СтруктураСтроки, Строка);
				Калькуляция.Добавить(СтруктураСтроки);
				Строка.СтрокаДобавлена = Истина;
				
				Отбор3 = Новый Структура;
				Отбор3.Вставить("РазмерКТК", Строка.РазмерКТК);
				Отбор3.Вставить("СтавкаНДС", Строка.СтавкаНДС);
				Отбор3.Вставить("Валюта", Строка.Валюта);
				Отбор3.Вставить("ЛокацияСдачиИзСтавок", ПоисковаяСтрока.ЛокацияСдачиИзСтавок);
				Отбор3.Вставить("Ставка", Строка.Ставка);
				Отбор3.Вставить("НДСвключен", Строка.НДСвключен);
				
				ПодходятПоКлючевымПараметрам2 = Выгрузка.НайтиСтроки(Отбор3);
				Для Каждого Строка Из ПодходятПоКлючевымПараметрам2 Цикл
					Если Строка.СтрокаДобавлена Тогда
						Продолжить;
					Иначе
						СтруктураСтроки = СтруктураСтроки();
						ЗаполнитьЗначенияСвойств(СтруктураСтроки, Строка);
						Калькуляция.Добавить(СтруктураСтроки);
						Строка.СтрокаДобавлена = Истина;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		МассивКалькуляции.Добавить(Калькуляция);
	КонецЦикла;
	
	Возврат МассивКалькуляции;
	
КонецФункции

&НаСервере
Функция ОбработатьПодготовленныеСтроки(МассивСтрок)
	
	Результат = Новый Структура;
	Результат.Вставить("НомераСтрок", "");
	Результат.Вставить("НомерСтрокиДляСообщения", "");
	Результат.Вставить("РазмерКТК", "");
	Результат.Вставить("Ставка20", 0);
	Результат.Вставить("Ставка40", 0);
	Результат.Вставить("Валюта", Неопределено);
	Результат.Вставить("СтокиСдачи", Новый Массив);
	Результат.Вставить("СтавкаНДС", Неопределено);
	Результат.Вставить("НДСвключен", Ложь);
	Результат.Вставить("ЛокацияСдачиИзСтавок", Неопределено);
	Результат.Вставить("Контрагент", Неопределено);
	Результат.Вставить("Договор", Неопределено);
	Результат.Вставить("Локация", Неопределено);
	Результат.Вставить("ЛокацияСдачи", Неопределено);
	Результат.Вставить("НомерДокумента", Неопределено);
	Результат.Вставить("Организация", Неопределено);
	Результат.Вставить("Номер", Неопределено);
	
	РазмерыВКалькуляции = Новый ТаблицаЗначений;
	РазмерыВКалькуляции.Колонки.Добавить("РазмерКТК");
	СтокиСдачи = Новый ТаблицаЗначений;
	СтокиСдачи.Колонки.Добавить("СтокСдачи");
	
	КлючевыеПоляЗаполнены = Ложь;
	
	НомераСтрок = "";
	
	Для Каждого Строка Из МассивСтрок Цикл
		Если Не КлючевыеПоляЗаполнены Тогда
			ЗаполнитьЗначенияСвойств(Результат, Строка, , "РазмерКТК");
			КлючевыеПоляЗаполнены = Истина;
		КонецЕсли;
		НомераСтрок = НомераСтрок + Строка(Строка.НомерСтроки) + ", ";
		Результат.НомерСтрокиДляСообщения = Строка(Строка.НомерСтроки);
		НоваяСтрокаРазмер = РазмерыВКалькуляции.Добавить();
		НоваяСтрокаРазмер.РазмерКТК = Строка.РазмерКТК;
		Если Строка.РазмерКТК = Справочники.РазмерыКТК.К20 Тогда
			Результат.Ставка20 = Строка.Ставка;
		Иначе
			Результат.Ставка40 = Строка.Ставка;
		КонецЕсли;
		Если ЗначениеЗаполнено(Строка.СтокСдачи) Тогда
			НоваяСтрокаСтоки = СтокиСдачи.Добавить();
			НоваяСтрокаСтоки.СтокСдачи = Строка.СтокСдачи;
		КонецЕсли;
	КонецЦикла;
	
	ТарифКалькуляции = "";
	РазмерыВКалькуляции.Свернуть("РазмерКТК");
	Если РазмерыВКалькуляции.Количество() > 1 Тогда
		ТарифКалькуляции = "2040";
	Иначе
		ТарифКалькуляции = Строка(РазмерыВКалькуляции[0].РазмерКТК);
	КонецЕсли;
	Результат.РазмерКТК = ТарифКалькуляции;
	
	СтокиСдачи.Свернуть("СтокСдачи");
	Результат.СтокиСдачи = СтокиСдачи.ВыгрузитьКолонку("СтокСдачи");
	НомераСтрок = Лев(НомераСтрок, СтрДлина(НомераСтрок) - 2);
	Результат.НомераСтрок = НомераСтрок;
	
	Возврат Результат;
	
КонецФункции

