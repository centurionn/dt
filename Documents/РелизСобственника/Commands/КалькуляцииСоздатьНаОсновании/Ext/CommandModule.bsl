		Строка2 = НовыйЭлементТерриторияМаршрута.Страны.Добавить();
		Строка2.Страна = СтранаНазначения;
	КонецЕсли;
	
	НовыйЭлементТерриторияМаршрута.Записать();
	СсылкаСозданногоЭлемента = НовыйЭлементТерриторияМаршрута.Ссылка;
	
	Возврат СсылкаСозданногоЭлемента;
	
