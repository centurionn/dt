
#Область ОбработчикиСобытий

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	СоздатьКалькуляцииНаОснованииРелиза(ПараметрКоманды);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СоздатьКалькуляцииНаОснованииРелиза(ТекущийРелиз)
	
	Если ЕстьНеЗаполненныеСтроки(ТекущийРелиз) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	РелизСобственникаСтавкиДоплатныхКТК.НомерСтроки КАК НомерСтроки,
	|	РелизСобственникаСтавкиДоплатныхКТК.ТипКТК.РазмерКТК КАК РазмерКТК,
	|	РелизСобственникаСтавкиДоплатныхКТК.Ставка КАК Ставка,
	|	РелизСобственникаСтавкиДоплатныхКТК.Валюта КАК Валюта,
	|	РелизСобственникаСтавкиДоплатныхКТК.СтокСдачи КАК СтокСдачи,
	|	РелизСобственникаСтавкиДоплатныхКТК.СтавкаНДС КАК СтавкаНДС,
	|	РелизСобственникаСтавкиДоплатныхКТК.НДСвключен КАК НДСвключен,
	|	РелизСобственникаСтавкиДоплатныхКТК.ЛокацияСдачи КАК ЛокацияСдачиИзСтавок,
	|	РелизСобственникаСтавкиДоплатныхКТК.Ссылка.Контрагент КАК Контрагент,
	|	РелизСобственникаСтавкиДоплатныхКТК.Ссылка.Договор КАК Договор,
	|	РелизСобственникаСтавкиДоплатныхКТК.Ссылка.Локация КАК Локация,
	|	РелизСобственникаСтавкиДоплатныхКТК.Ссылка.ЛокацияСдачи КАК ЛокацияСдачи,
	|	РелизСобственникаСтавкиДоплатныхКТК.Ссылка.НомерДокумента КАК НомерДокумента,
	|	РелизСобственникаСтавкиДоплатныхКТК.Ссылка.Организация КАК Организация,
	|	РелизСобственникаСтавкиДоплатныхКТК.Ссылка.Номер КАК Номер
	|ИЗ
	|	Документ.РелизСобственника.СтавкиДоплатныхКТК КАК РелизСобственникаСтавкиДоплатныхКТК
	|ГДЕ
	|	РелизСобственникаСтавкиДоплатныхКТК.Ссылка = &Релиз";
	
	Запрос.УстановитьПараметр("Релиз", ТекущийРелиз);
	
	Выгрузка = Запрос.Выполнить().Выгрузить();
	
	НомерСтрокиДляСообщения = 0;
	НомераСтрокСКалькуляциями = "";
	
	УбратьИзВыгрузкиПараметрыУжеСозданныхКалькуляций(Выгрузка, ТекущийРелиз, НомераСтрокСКалькуляциями, НомерСтрокиДляСообщения);
	
	НаборКалькуляции = СобратьНаборКалькуляцийДляСоздания(Выгрузка);
	
	УстановитьПривилегированныйРежим(Истина);
	
	НомераКалькуляций = Новый Массив;
	
	Для Каждого ДанныеКалькуляции Из НаборКалькуляции Цикл
		
		ПараметрыКалькуляции = ОбработатьПодготовленныеСтроки(ДанныеКалькуляции);
		
		СтранаПунктаОтправления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыКалькуляции.Локация, "Страна");
		Если ТипЗнч(ПараметрыКалькуляции.ЛокацияСдачиИзСтавок) = Тип("СправочникСсылка.Мультилокации") Тогда
			СтранаПунктаНазначения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыКалькуляции.ЛокацияСдачиИзСтавок.Локации[0].Локация, "Страна");
		Иначе
			СтранаПунктаНазначения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыКалькуляции.ЛокацияСдачиИзСтавок, "Страна");
		КонецЕсли;
		
		ТерриторияМаршрута = ТерриторияМаршрута(СтранаПунктаОтправления, СтранаПунктаНазначения);
		
		НоваяКалькуляция = Документы.Калькуляция.СоздатьДокумент();
		НоваяКалькуляция.Автор = Пользователи.ТекущийПользователь();
		НоваяКалькуляция.Дата = ТекущаяДатаСеанса();
		НоваяКалькуляция.Контрагент = ПараметрыКалькуляции.Контрагент;
		НоваяКалькуляция.Договор = ПараметрыКалькуляции.Договор;
		НоваяКалькуляция.СтавкаНДС = ПараметрыКалькуляции.СтавкаНДС;
		НоваяКалькуляция.СуммаВключаетНДС = ПараметрыКалькуляции.НДСвключен;
		НоваяКалькуляция.ТарифицируемыйРазмерКТК = ПараметрыКалькуляции.РазмерКТК;
		Если ПараметрыКалькуляции.РазмерКТК = "20" Тогда
			НоваяКалькуляция.ММ_Вознаграждение = ПараметрыКалькуляции.Ставка20;
		ИначеЕсли ПараметрыКалькуляции.РазмерКТК = "40" Тогда
			НоваяКалькуляция.ММ_Вознаграждение40 = ПараметрыКалькуляции.Ставка40;
		ИначеЕсли ПараметрыКалькуляции.РазмерКТК = "2040" Тогда
			НоваяКалькуляция.ММ_Вознаграждение = ПараметрыКалькуляции.Ставка20;
			НоваяКалькуляция.ММ_Вознаграждение40 = ПараметрыКалькуляции.Ставка40;
		КонецЕсли;
		НоваяКалькуляция.ТипКалькуляции = Перечисления.ТипыКалькуляций.Доплатные;
		НоваяКалькуляция.ОсновнаяУслуга = Справочники.Номенклатура.ТЭУ;
		НоваяКалькуляция.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ктк;
		НоваяКалькуляция.Суша_ПунктОтправления = ПараметрыКалькуляции.Локация;
		НоваяКалькуляция.Суша_ПунктНазначения = ПараметрыКалькуляции.ЛокацияСдачиИзСтавок;
		НоваяКалькуляция.Валюта = ПараметрыКалькуляции.Валюта;
		НоваяКалькуляция.Организация = ПараметрыКалькуляции.Организация;
		НоваяКалькуляция.веб_ДляКТКЕвросиб = Истина;
		НоваяКалькуляция.ТипЗаказа = Справочники.ТипыЗаказов.КонтейнерныйПоезд;
		НоваяКалькуляция.ЖД_ПринадлежностьПС = Перечисления.ПринадлежностьПС.Собственный;
		НоваяКалькуляция.УсловияПеревозки_Отправление = Перечисления.УсловияПеревозкиКТК.DOOR;
		НоваяКалькуляция.УсловияПеревозки_Прибытие = Перечисления.УсловияПеревозкиКТК.DOOR;
		НоваяКалькуляция.ДатаКурса = ТекущаяДатаСеанса();
		
		ШаблонСообщения = НСтр("ru = 'Релиз %1 %2 %3 %4 %5 %6'");
		ТекстКомментария = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонСообщения, 
			ПараметрыКалькуляции.Номер, 
			ПараметрыКалькуляции.НомерДокумента, 
			?(ПараметрыКалькуляции.РазмерКТК = "2040", "20/40", ПараметрыКалькуляции.РазмерКТК), 
			?(ПараметрыКалькуляции.Ставка20 <> 0, ПараметрыКалькуляции.Ставка20, ""),
			?(ПараметрыКалькуляции.Ставка40 <> 0, ПараметрыКалькуляции.Ставка40, ""),
			ПараметрыКалькуляции.Валюта);
		ТекстКомментария = СтрЗаменить(ТекстКомментария, "  ", " ");
			
		НоваяКалькуляция.Комментарий = ТекстКомментария;
		НоваяКалькуляция.ДокументОснование = ТекущийРелиз;
		
		Для Каждого СтокСдачи Из ПараметрыКалькуляции.СтокиСдачи Цикл
			СтрокаСпискаСтанцийНазначения = НоваяКалькуляция.СписокСтанцийНазначения.Добавить();
			СтрокаСпискаСтанцийНазначения.Станция = СтокСдачи;
		КонецЦикла;
	
		НоваяКалькуляция.ТерриторияМаршрута = ТерриторияМаршрута;
		
		НоваяКалькуляция.ПС_ВидПеревозки = УчетноеНаправлениеВидПеревозки(СтранаПунктаОтправления, СтранаПунктаНазначения);
		НоваяКалькуляция.УчетноеНаправление = УчетноеНаправлениеВидПеревозки(СтранаПунктаОтправления, СтранаПунктаНазначения, Истина);
		
		НоваяКалькуляция.ММ_КалькуляцияЖДСоставляющей.Очистить();
		НоваяКалькуляция.Состояния.Очистить();
		
		ЖД_Себестоимость20 = 0;
		ЖД_Себестоимость40 = 0;
		ММ_СебестоимостьСуши20 = 0;
		ММ_СебестоимостьСуши = 0;
		
		// Пересчет будет необходим только в случае добавления строк в табличную часть ЖД_КалькуляцияСебестоимости
		//КалькуляцииЗаявкиПСЦСервер.РасчитатьСебестоимостьЖД(НоваяКалькуляция, ЖД_Себестоимость20, ЖД_Себестоимость40);
		
		ПараметрыПересчета = Новый Структура;
		ПараметрыПересчета.Вставить("ЖД_Себестоимость20", ЖД_Себестоимость20);
		ПараметрыПересчета.Вставить("ЖД_Себестоимость40", ЖД_Себестоимость40);
		ПараметрыПересчета.Вставить("ММ_СебестоимостьСуши20", ММ_СебестоимостьСуши20);
		ПараметрыПересчета.Вставить("ММ_СебестоимостьСуши", ММ_СебестоимостьСуши);
		Ответ = КалькуляцииЗаявкиПСЦСервер.ПересчитатьРеквизитыИтогов(НоваяКалькуляция, ПараметрыПересчета);
		ЗаполнитьЗначенияСвойств(НоваяКалькуляция, Ответ);
		
		Попытка
			НоваяКалькуляция.Записать(РежимЗаписиДокумента.Проведение);
			НомераКалькуляций.Добавить(НоваяКалькуляция.Номер);
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Выполнение операции'"),
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
				
			ОбработатьСообщениеОшибки(ПараметрыКалькуляции, ТекущийРелиз);
			Продолжить;
		КонецПопытки;
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если НомераСтрокСКалькуляциями <> "" Тогда
		НомераСтрокСКалькуляциями = ОтсортироватьСтрокуЧисел(НомераСтрокСКалькуляциями);
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Для строк %1 есть подходящие калькуляции.'"), НомераСтрокСКалькуляциями);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, 
			ТекущийРелиз,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Объект.СтавкиДоплатныхКТК", НомерСтрокиДляСообщения, "НомерСтроки"));
	КонецЕсли;
	
	Если НомераКалькуляций.Количество() > 0 Тогда
		Калькуляции = "";
		Для Каждого Номер Из НомераКалькуляций Цикл
			Калькуляции = Калькуляции + "Калькуляция " + Номер + "; ";
		КонецЦикла;
		Калькуляции = Лев(Калькуляции, СтрДлина(Калькуляции) - 2);
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Созданы калькуляции: %1.'"), Калькуляции);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЕстьНеЗаполненныеСтроки(Релиз)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	РелизСобственникаСтавкиДоплатныхКТК.Ставка КАК Ставка,
	|	РелизСобственникаСтавкиДоплатныхКТК.Валюта КАК Валюта,
	|	РелизСобственникаСтавкиДоплатныхКТК.СтавкаНДС КАК СтавкаНДС,
	|	РелизСобственникаСтавкиДоплатныхКТК.НомерСтроки КАК НомерСтроки,
	|	РелизСобственникаСтавкиДоплатныхКТК.СтокСдачи КАК СтокСдачи
	|ИЗ
	|	Документ.РелизСобственника.СтавкиДоплатныхКТК КАК РелизСобственникаСтавкиДоплатныхКТК
	|ГДЕ
	|	РелизСобственникаСтавкиДоплатныхКТК.Ссылка = &Релиз";
	
	Запрос.УстановитьПараметр("Релиз", Релиз);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СтрокиСОшибкой = Новый Массив;
	
	Результат = Ложь;
	
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.Ставка)
			ИЛИ НЕ ЗначениеЗаполнено(Выборка.Валюта)
			ИЛИ НЕ ЗначениеЗаполнено(Выборка.СтокСдачи)
			ИЛИ НЕ ЗначениеЗаполнено(Выборка.СтавкаНДС) Тогда
			СтрокиСОшибкой.Добавить(Выборка.НомерСтроки);
		КонецЕсли;
	КонецЦикла;
	
	Если СтрокиСОшибкой.Количество() > 0 Тогда
		Результат = Истина;
		НомераСтрок = "";
		Для Каждого Номер Из СтрокиСОшибкой Цикл
			НомераСтрок = НомераСтрок + "№" + Номер + ", ";
		КонецЦикла;
		НомераСтрок = Лев(НомераСтрок, СтрДлина(НомераСтрок) - 2);
		ТекстСообщения = СтрШаблон(НСтр("ru = 'В строке %1. отсутствуют данные для создания калькуляции. Заполните значения и повторите процесс.'"), НомераСтрок);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция УчетноеНаправлениеВидПеревозки(СтранаПунктаОтправления, СтранаПунктаНазначения, УчетноеНаправление = Ложь)
	
	Результат = Неопределено;
	
	СтранаРоссия = Справочники.СтраныМира.Россия;
	
	Если СтранаПунктаОтправления = СтранаРоссия И СтранаПунктаНазначения = СтранаРоссия Тогда
		Если УчетноеНаправление Тогда
			Результат = Справочники.УчетныеНаправления.ВРП;
		Иначе
			Результат = Справочники.ВидыПеревозок.Внутрироссийская;
		КонецЕсли;
	ИначеЕсли СтранаПунктаОтправления = СтранаРоссия И СтранаПунктаНазначения <> СтранаРоссия Тогда
		Если УчетноеНаправление Тогда
			Результат = Справочники.УчетныеНаправления.ЭкспортСухопутный;
		Иначе
			Результат = Справочники.ВидыПеревозок.Экспорт;
		КонецЕсли;
	Иначе
		Если УчетноеНаправление Тогда
			Результат = Справочники.УчетныеНаправления.ИмпортСухопутный;
		Иначе
			Результат = Справочники.ВидыПеревозок.Импорт;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ТерриторияМаршрута(СтранаПунктаОтправления, СтранаПунктаНазначения)
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ТерриторииМаршрутаСтраны.Ссылка КАК Ссылка,
	|	МАКСИМУМ(ТерриторииМаршрутаСтраны.НомерСтроки) КАК Количество
	|ПОМЕСТИТЬ ВТ_КоличествоСтрок
	|ИЗ
	|	Справочник.ТерриторииМаршрута.Страны КАК ТерриторииМаршрутаСтраны
	|
	|СГРУППИРОВАТЬ ПО
	|	ТерриторииМаршрутаСтраны.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТерриторииМаршрутаСтраны.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Отправления
	|ИЗ
	|	Справочник.ТерриторииМаршрута.Страны КАК ТерриторииМаршрутаСтраны
	|ГДЕ
	|	ТерриторииМаршрутаСтраны.Страна = &СтранаОтправления
	|	И ТерриторииМаршрутаСтраны.НомерСтроки = 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТерриторииМаршрутаСтраны.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ТерриторииМаршрута.Страны КАК ТерриторииМаршрутаСтраны
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоСтрок КАК ВТ_КоличествоСтрок
	|		ПО ТерриторииМаршрутаСтраны.Ссылка = ВТ_КоличествоСтрок.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Отправления КАК ВТ_Отправления
	|		ПО ТерриторииМаршрутаСтраны.Ссылка = ВТ_Отправления.Ссылка
	|ГДЕ
	|	ТерриторииМаршрутаСтраны.Страна = &СтранаНазначения
	|	И ТерриторииМаршрутаСтраны.НомерСтроки = ВТ_КоличествоСтрок.Количество
	|	И ВТ_КоличествоСтрок.Количество <= 2
	|	И НЕ ТерриторииМаршрутаСтраны.Ссылка.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("СтранаОтправления", СтранаПунктаОтправления);

	Если СтранаПунктаНазначения = Неопределено Тогда
		Запрос.УстановитьПараметр("СтранаНазначения", СтранаПунктаОтправления);
	Иначе
		Запрос.УстановитьПараметр("СтранаНазначения", СтранаПунктаНазначения);
	КонецЕсли;

	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	Иначе
		СозданныйМаршрут = СоздатьТерриториюМаршрута(СтранаПунктаОтправления, СтранаПунктаНазначения);
		Результат = СозданныйМаршрут;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

