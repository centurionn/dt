	               |	И ПСЦПоставщикаУчетныеЕдиницы.УчетнаяЕдиница.ТипТЕ = &ТипТЕ";
	
	Запрос.УстановитьПараметр("ИдентификаторСтрокиУслуг", Строка.ИдентификаторСтрокиУслуг);
	Запрос.УстановитьПараметр("ТипТЕ", Строка.ТипКТК);

