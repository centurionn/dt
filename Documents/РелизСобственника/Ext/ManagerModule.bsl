Функция ПолучитьПараметрыМаршрутизации(Объект) Экспорт
	ПараметрыЗапроса = Новый Соответствие;
	ПараметрыЗапроса.Вставить("Организация", Объект.Организация);
	ПараметрыЗапроса.Вставить("Контрагент", Объект.Контрагент);
	ПараметрыЗапроса.Вставить("Договор", Объект.Договор);
	ПараметрыЗапроса.Вставить("ЦФО", Объект.ЦФО);
	ПараметрыЗапроса.Вставить("КолвоРелизКлиентаНеСовпадаетТипоразмерКТК", Объект.КолвоРелизКлиентаНеСовпадаетТипоразмерКТК);
	ПараметрыЗапроса.Вставить("КолвоРелизКлиентаНоваяЗаписьКТК", Объект.КолвоРелизКлиентаНоваяЗаписьКТК);
	Возврат ПараметрыЗапроса;
КонецФункции
