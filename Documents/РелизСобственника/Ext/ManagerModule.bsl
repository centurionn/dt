Процедура ДобавитьУдалитьСтроки(СтрокаПСЦ, ДокументСсылка, КоличествоСтрокВРелизе, ЗаписываемыеОбъекты)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РелизСобственника.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РелизСобственника КАК РелизСобственника
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	|		ПО РелизСобственника.Ссылка = РелизСобственникаНоминации.Ссылка
	|ГДЕ
	|	РелизСобственника.ПСЦ = &Документ
	|	И НЕ РелизСобственника.ПометкаУдаления
	|	И РелизСобственникаНоминации.ИдентификаторСтрокиПСЦПоставщика = &Идентификатор";
	
	Запрос.УстановитьПараметр("Документ", ДокументСсылка);
	Запрос.УстановитьПараметр("Идентификатор", СтрокаПСЦ.ИдентификаторСтрокиУслуг);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		РелизОбъект = ЗаписываемыеОбъекты.Получить(Выборка.Ссылка);
		Если РелизОбъект = Неопределено Тогда
			РелизОбъект = Выборка.Ссылка.ПолучитьОбъект();
		КонецЕсли;
		Разница = СтрокаПСЦ.КоличествоКТК - КоличествоСтрокВРелизе;
		Если Разница > 0 Тогда
			// Добавляем недостающие строки
			Для Счетчик = 1 По Разница Цикл
				НоваяСтрока = РелизОбъект.Номинации.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПСЦ);
				НоваяСтрока.НДСВключая = СтрокаПСЦ.СуммаВключаетНДС;
				НоваяСтрока.ГУИДСтроки = Новый УникальныйИдентификатор;
				НоваяСтрока.ДатаАктуальностиЗаписи = ТекущаяДатаСеанса();
				НоваяСтрока.ИдентификаторСтрокиПСЦПоставщика = СтрокаПСЦ.ИдентификаторСтрокиУслуг;
			КонецЦикла;
		ИначеЕсли Разница < 0 Тогда
			// Удаляем лишние строки (начиная с последних)
			РазницаУдаления = -Разница;
			СтрокиДляУдаления = Новый Массив;
			
			Отбор = Новый Структура;
			Отбор.Вставить("ИдентификаторСтрокиПСЦПоставщика", СтрокаПСЦ.ИдентификаторСтрокиУслуг);
			Отбор.Вставить("ТипКТК", СтрокаПСЦ.ТипКТК);
			Отбор.Вставить("Контейнер", Справочники.ТЕ.ПустаяСсылка());
			НайденныеСтроки = РелизОбъект.Номинации.НайтиСтроки(Отбор);
			
			Для Счетчик = 0 По РазницаУдаления - 1 Цикл
				Индекс = НайденныеСтроки.Количество() - 1 - Счетчик;
				Если Индекс >= 0 Тогда
					СтрокиДляУдаления.Добавить(НайденныеСтроки[Индекс]);
				КонецЕсли;
			КонецЦикла;
			
			Для Каждого СтрокаИзМассива Из СтрокиДляУдаления Цикл
				РелизОбъект.Номинации.Удалить(СтрокаИзМассива);
			КонецЦикла;
		КонецЕсли;
		ЗаписываемыеОбъекты.Вставить(РелизОбъект.Ссылка, РелизОбъект);
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьСтроки(Строка, ДокументОснование, ЗаписываемыеОбъекты)
	
	Релиз = НайтиРелизПоПараметрам(Строка, ДокументОснование);
	
	Если Релиз = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РелизОбъект = ЗаписываемыеОбъекты.Получить(Релиз);
	
	Если РелизОбъект = Неопределено Тогда
		РелизОбъект = Релиз.ПолучитьОбъект();
	КонецЕсли;
	
	МассивДляУдаленияНоминаций = Новый Массив;
	МассивДляУдаленияСНП = Новый Массив;
	
	Для Каждого СтрокаНоминаций Из РелизОбъект.Номинации Цикл
		Если СтрокаНоминаций.ИдентификаторСтрокиПСЦПоставщика = Строка.ИдентификаторСтрокиУслуг
			И СтрокаНоминаций.ТипКТК = Строка.ТипКТК Тогда
			МассивДляУдаленияНоминаций.Добавить(СтрокаНоминаций);
			СтрокиСНП = РелизОбъект.СНП.НайтиСтроки(Новый Структура("ГУИДСтроки", СтрокаНоминаций.ГУИДСтроки));
			Для Каждого СтрокаСНП Из СтрокиСНП Цикл
				МассивДляУдаленияСНП.Добавить(СтрокаСНП);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаСНП Из МассивДляУдаленияСНП Цикл
		РелизОбъект.СНП.Удалить(СтрокаСНП);
	КонецЦикла;
	
	Для Каждого СтрокаНоминаций Из МассивДляУдаленияНоминаций Цикл
		РелизОбъект.Номинации.Удалить(СтрокаНоминаций);
	КонецЦикла;
	
	Если РелизОбъект.Номинации.Количество() = 0 Тогда
		РелизОбъект.ПометкаУдаления = Истина;
		Если РелизОбъект.Проведен Тогда
			РелизОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Иначе;
			РелизОбъект.Записать();
		КонецЕсли;
		РеквизитыРелиза = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РелизОбъект.Ссылка, "ПСЦ, Ссылка");
		СвязанныеДокументыСервер.УдалитьСвязи(РеквизитыРелиза.ПСЦ, РеквизитыРелиза.Ссылка);
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Релиз %1 был помечен на удаление.'"), РелизОбъект.Ссылка);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, РелизОбъект.Ссылка);
	Иначе
		РелизОбъект.Записать();
	КонецЕсли;
	
	ЗаписываемыеОбъекты.Вставить(РелизОбъект.Ссылка, РелизОбъект);
	
КонецПроцедуры

Функция ЕстьСозданныеРелизы(ПротоколСсылка)
	
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РелизСобственника.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РелизСобственника КАК РелизСобственника
		|ГДЕ
		|	РелизСобственника.ПСЦ = &ПСЦ
		|	И НЕ РелизСобственника.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ПСЦ", ПротоколСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтавкиСНП(ПротоколСсылка)
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ПСЦПоставщикаУслуги.ПунктНазначенияГород) = ТИП(Справочник.Мультилокации)
	|			ТОГДА Мультилокации.Локация
	|		ИНАЧЕ ПСЦПоставщикаУслуги.ПунктНазначенияГород
	|	КОНЕЦ ВозможныеСтокиСдачи
	|ПОМЕСТИТЬ ВТ_ВозможныеСтокиСдачи
	|ИЗ
	|	Документ.ПСЦПоставщика.Услуги КАК ПСЦПоставщикаУслуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Мультилокации.Локации КАК Мультилокации
	|		ПО ПСЦПоставщикаУслуги.ПунктНазначенияГород = Мультилокации.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПСЦПоставщика.КритерииУслуг КАК ПСЦПоставщикаКритерииУслуг
	|		ПО ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг = ПСЦПоставщикаКритерииУслуг.ИдентификаторСтрокиУслуг
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПСЦПоставщика.ШкалаСтавок КАК ПСЦПоставщикаШкалаСтавок
	|		ПО ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг = ПСЦПоставщикаШкалаСтавок.ИдентификаторСтрокиУслуг
	|ГДЕ
	|	ПСЦПоставщикаУслуги.Ссылка = &Документ
	|	И ПСЦПоставщикаУслуги.Номенклатура В(&Номенклатура)
	|;
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПСЦПоставщикаКритерииУслуг.ТипоразмерКТК КАК ТипоразмерКТК,
	|	ЕСТЬNULL(ПСЦПоставщикаШкалаСтавок.От, 0) КАК От,
	|	ЕСТЬNULL(ПСЦПоставщикаШкалаСтавок.До, 0) КАК До,
	|	ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ПСЦПоставщикаУслуги.СтавкаПрогрессивная КАК СтавкаПрогрессивная,
	|	ЕСТЬNULL(ПСЦПоставщикаШкалаСтавок.СтоимостьБезНДС, 0) КАК СтоимостьБезНДСИзШкалы,
	|	ЕСТЬNULL(ПСЦПоставщикаУслуги.СтоимостьБезНДС, 0) КАК СтоимостьБезНДСИзУслуг,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ПСЦПоставщикаУслуги.ПунктОтправленияСтрана) = ТИП(Справочник.Мультилокации)
	|			ТОГДА Мультилокации.Локация
	|		ИНАЧЕ ПСЦПоставщикаУслуги.ПунктОтправленияСтрана
	|	КОНЕЦ КАК ЛокацияСтрана,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ПСЦПоставщикаУслуги.ПунктОтправленияГород) = ТИП(Справочник.Мультилокации)
	|			ТОГДА Мультилокации.Локация
	|		ИНАЧЕ ПСЦПоставщикаУслуги.ПунктОтправленияГород
	|	КОНЕЦ КАК ЛокацияГород,
	|	ПСЦПоставщикаУслуги.ПунктНазначенияСтрана КАК ЛокацияСдачи,
	|	ПСЦПоставщикаУслуги.ПунктНазначенияГород КАК ВозможныеСтокиСдачиМультилокация,
	|	ВТ_ВозможныеСтокиСдачи.ВозможныеСтокиСдачи КАК ВозможныеСтокиСдачи,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ПСЦПоставщикаУслуги.ПунктОтправления) = ТИП(Справочник.Мультилокации)
	|			ТОГДА Мультилокации.Локация
	|		ИНАЧЕ ПСЦПоставщикаУслуги.ПунктОтправления
	|	КОНЕЦ КАК Сток
	|ИЗ
	|	Документ.ПСЦПоставщика.Услуги КАК ПСЦПоставщикаУслуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Мультилокации.Локации КАК Мультилокации
	|		ПО (ПСЦПоставщикаУслуги.ПунктОтправления = Мультилокации.Ссылка
	|				ИЛИ ПСЦПоставщикаУслуги.ПунктОтправленияГород = Мультилокации.Ссылка
	|				ИЛИ ПСЦПоставщикаУслуги.ПунктОтправленияСтрана = Мультилокации.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПСЦПоставщика.КритерииУслуг КАК ПСЦПоставщикаКритерииУслуг
	|		ПО ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг = ПСЦПоставщикаКритерииУслуг.ИдентификаторСтрокиУслуг
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПСЦПоставщика.ШкалаСтавок КАК ПСЦПоставщикаШкалаСтавок
	|		ПО ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг = ПСЦПоставщикаШкалаСтавок.ИдентификаторСтрокиУслуг 
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВозможныеСтокиСдачи КАК ВТ_ВозможныеСтокиСдачи
	|		ПО ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг = ВТ_ВозможныеСтокиСдачи.ИдентификаторСтрокиУслуг
	|
	|ГДЕ
	|	ПСЦПоставщикаУслуги.Ссылка = &Документ
	|	И ПСЦПоставщикаУслуги.Номенклатура В(&Номенклатура)
	|
	|УПОРЯДОЧИТЬ ПО
	|	От";
	
	МассивНоменклатур = Новый Массив;
	МассивНоменклатур.Добавить(Константы.УслугаСНППоКТК.Получить());
	
	Запрос.УстановитьПараметр("Номенклатура", МассивНоменклатур);
	Запрос.УстановитьПараметр("Документ", ПротоколСсылка);
	
	Выгрузка = Запрос.Выполнить().Выгрузить();
	
	Возврат Выгрузка;
	
КонецФункции

Функция ДобавитьСтавкуСНПКСтроке(ДокументОбъект, Строка, Ставки, ВалютаСНП)
	
	ОтборСтавки = Новый Структура;
	ОтборСтавки.Вставить("ТипоразмерКТК", Строка.ТипКТК);
	ОтборСтавки.Вставить("ЛокацияСдачи", ДокументОбъект.ЛокацияСдачи);
	ОтборСтавки.Вставить("Сток", ДокументОбъект.Сток);
	ТипЛокацииВыдачи = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.Локация, "Тип");
	Если ТипЛокацииВыдачи = Справочники.ТипыЛокаций.НаселенныйПункт Тогда
		ОтборСтавки.Вставить("ЛокацияГород", ДокументОбъект.Локация);
	ИначеЕсли ТипЛокацииВыдачи = Справочники.ТипыЛокаций.Страна Тогда
		ОтборСтавки.Вставить("ЛокацияСтрана", ДокументОбъект.Локация);
	КонецЕсли;
	Если ТипЗнч(ДокументОбъект.ВозможныеСтокиСдачи) = Тип("СправочникСсылка.Мультилокации") Тогда
		ОтборСтавки.Вставить("ВозможныеСтокиСдачиМультилокация", ДокументОбъект.ВозможныеСтокиСдачи);
	Иначе
		ОтборСтавки.Вставить("ВозможныеСтокиСдачи", ДокументОбъект.ВозможныеСтокиСдачи);
	КонецЕсли;
	
	НайденныеСтроки = Ставки.НайтиСтроки(ОтборСтавки);
	
	ОшибкаСтавки = Истина;
	
	ЭталонныйИдентификатор = Неопределено;
	Если НайденныеСтроки.Количество() <> 0 Тогда
		ЭталонныйИдентификатор = НайденныеСтроки[0].ИдентификаторСтрокиУслуг;
	КонецЕсли;
	
	Для Каждого СтрокаСтавки Из НайденныеСтроки Цикл
		Если СтрокаСтавки.ИдентификаторСтрокиУслуг <> ЭталонныйИдентификатор Тогда
			Возврат ОшибкаСтавки;
		КонецЕсли;
	КонецЦикла;
	
	// Удаляем старые строки по гуиду
	СтарыеСтрокиСНП = ДокументОбъект.СНП.НайтиСтроки(Новый Структура("ГУИДСтроки", Строка.ГУИДСтроки));
	Для Каждого СтрокаСНП Из СтарыеСтрокиСНП Цикл
		ДокументОбъект.СНП.Удалить(СтрокаСНП);
	КонецЦикла;
	
	Для Каждого СтрокаСтавки Из НайденныеСтроки Цикл
		Если СтрокаСтавки.СтавкаПрогрессивная Тогда
			НоваяСтрокаСНП = ДокументОбъект.СНП.Добавить();
			НоваяСтрокаСНП.ГУИДСтроки = Строка.ГУИДСтроки;
			НоваяСтрокаСНП.Стоимость = СтрокаСтавки.СтоимостьБезНДСИзШкалы;
			Строка.ВалютаСНП = ВалютаСНП;
			Строка.СтавкаПрогрессивная = Истина;
			НоваяСтрокаСНП.От = СтрокаСтавки.От;
			НоваяСтрокаСНП.До = СтрокаСтавки.До;
		Иначе
			УжеСуществуетТакаяСтрока = ДокументОбъект.СНП.НайтиСтроки(Новый Структура("ГУИДСтроки, Стоимость", Строка.ГУИДСтроки, СтрокаСтавки.СтоимостьБезНДСИзУслуг));
			Если УжеСуществуетТакаяСтрока.Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрокаСНП = ДокументОбъект.СНП.Добавить();
			НоваяСтрокаСНП.ГУИДСтроки = Строка.ГУИДСтроки;
			НоваяСтрокаСНП.Стоимость = СтрокаСтавки.СтоимостьБезНДСИзУслуг;
			Строка.ВалютаСНП = ВалютаСНП;
		КонецЕсли;
		ОшибкаСтавки = Ложь;
	КонецЦикла;
	
	Возврат ОшибкаСтавки;
	
КонецФункции

Функция ПроверитьКонтейнерНаНаличиеВРелизе(Контейнер, Идентификатор, Релиз)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РелизСобственникаНоминации.Ссылка КАК Ссылка,
	|	РелизСобственникаНоминации.Контейнер КАК Контейнер
	|ИЗ
	|	Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	|ГДЕ
	|	РелизСобственникаНоминации.ИдентификаторСтрокиПСЦПоставщика = &ИдентификаторСтрокиПСЦПоставщика
	|	И РелизСобственникаНоминации.Контейнер = &Контейнер
	|	И НЕ РелизСобственникаНоминации.Ссылка.ПометкаУдаления
	|	И РелизСобственникаНоминации.Ссылка = &Релиз";
	
	Запрос.УстановитьПараметр("ИдентификаторСтрокиПСЦПоставщика", Идентификатор);
	Запрос.УстановитьПараметр("Контейнер", Контейнер);
	Запрос.УстановитьПараметр("Релиз", Релиз);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Ответ = Ложь;
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Ответ = Истина;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

Процедура ИзмененияВКТК(ДокументСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПСЦПоставщикаУчетныеЕдиницы.УчетнаяЕдиница КАК Контейнер,
	|	ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг
	|ПОМЕСТИТЬ ВТ_ДанныеПСЦ
	|ИЗ   
	|	Документ.ПСЦПоставщика.УчетныеЕдиницы КАК ПСЦПоставщикаУчетныеЕдиницы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПСЦПоставщика.Услуги КАК ПСЦПоставщикаУслуги 
	|		ПО ПСЦПоставщикаУчетныеЕдиницы.ИдентификаторСтрокиУслуг = ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг
	|ГДЕ
	|	ПСЦПоставщикаУчетныеЕдиницы.Ссылка = &Документ
	|
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	1 КАК Индикатор,
	|	ВТ_ДанныеПСЦ.Контейнер КАК Контейнер,
	|	ВТ_ДанныеПСЦ.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиПСЦПоставщика
	|ПОМЕСТИТЬ ВТ_СтрокиКИзменению
	|ИЗ
	|	ВТ_ДанныеПСЦ КАК ВТ_ДанныеПСЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	-1,
	|	РелизСобственникаНоминации.Контейнер,
	|	РелизСобственникаНоминации.ИдентификаторСтрокиПСЦПоставщика
	|ИЗ
	|	Документ.РелизСобственника КАК РелизСобственника
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	|		ПО РелизСобственника.Ссылка = РелизСобственникаНоминации.Ссылка
	|ГДЕ
	|	РелизСобственника.ПСЦ = &Документ
	|	И РелизСобственникаНоминации.Контейнер <> Значение(Справочник.ТЕ.ПустаяСсылка)
	|
	|;	
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СУММА(ВТ_СтрокиКИзменению.Индикатор) КАК Индикатор,
	|	ВТ_СтрокиКИзменению.Контейнер КАК Контейнер, 
	|	ВТ_СтрокиКИзменению.ИдентификаторСтрокиПСЦПоставщика,
	|	РелизСобственникаНоминации.Ссылка КАК РелизСобственника
	|ИЗ
	|	ВТ_СтрокиКИзменению КАК ВТ_СтрокиКИзменению
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	|		ПО ВТ_СтрокиКИзменению.ИдентификаторСтрокиПСЦПоставщика = РелизСобственникаНоминации.ИдентификаторСтрокиПСЦПоставщика
	|	
	|СГРУППИРОВАТЬ ПО
	|	ВТ_СтрокиКИзменению.Контейнер,
	|	ВТ_СтрокиКИзменению.ИдентификаторСтрокиПСЦПоставщика,
	|	РелизСобственникаНоминации.Ссылка
	|ИМЕЮЩИЕ
	|	СУММА(ВТ_СтрокиКИзменению.Индикатор) <> 0";

	Запрос.УстановитьПараметр("Документ", ДокументСсылка);
		
	Ответ = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Строка Из Ответ Цикл
		РелизОбъект = Строка.РелизСобственника.ПолучитьОбъект();
		Если Строка.Индикатор < 0 Тогда
			НайденнаяСтрока = РелизОбъект.Номинации.Найти(Строка.Контейнер, "Контейнер");
			Если НайденнаяСтрока <> Неопределено Тогда
				РелизОбъект.Номинации.Удалить(НайденнаяСтрока);
			КонецЕсли;
		Иначе
			НайденнаяСтрока = РелизОбъект.Номинации.Найти(Строка.ИдентификаторСтрокиПСЦПоставщика, "ИдентификаторСтрокиПСЦПоставщика");
			Если НайденнаяСтрока <> Неопределено Тогда
				НайденнаяСтрока.Контейнер = Строка.Контейнер;
			КонецЕсли;
		КонецЕсли;
		РелизОбъект.Записать();
	КонецЦикла;
	
КонецПроцедуры

Функция ЕстьИзмененияВКонтейнерах(ДокументСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	1 КАК Идентификатор,
	|	ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ПСЦПоставщикаУчетныеЕдиницы.УчетнаяЕдиница КАК УчетнаяЕдиница
	|ПОМЕСТИТЬ ВТ_ВременнаяТаблица
	|ИЗ
	|	Документ.ПСЦПоставщика.Услуги КАК ПСЦПоставщикаУслуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПСЦПоставщика.УчетныеЕдиницы КАК ПСЦПоставщикаУчетныеЕдиницы
	|		ПО ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг = ПСЦПоставщикаУчетныеЕдиницы.ИдентификаторСтрокиУслуг
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПСЦПоставщика.КритерииУслуг КАК ПСЦПоставщикаКритерииУслуг
	|		ПО ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг = ПСЦПоставщикаКритерииУслуг.ИдентификаторСтрокиУслуг
	|ГДЕ
	|	ПСЦПоставщикаУслуги.Ссылка = &Документ
	|	И ПСЦПоставщикаУслуги.Номенклатура В(&Номенклатура)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	| 
	|ВЫБРАТЬ
	|	-1 КАК Идентификатор,
	|	РелизСобственникаНоминации.ИдентификаторСтрокиПСЦПоставщика КАК ИдентификаторСтрокиПСЦПоставщика,
	|	РелизСобственникаНоминации.Контейнер КАК Контейнер
	|ИЗ
	|	Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	|ГДЕ
	|	РелизСобственникаНоминации.Ссылка.ПСЦ = &Документ
	|	И НЕ РелизСобственникаНоминации.Ссылка.ПометкаУдаления 
	|	И РелизСобственникаНоминации.Контейнер <> Значение(Справочник.ТЕ.ПустаяСсылка)
	|;
	| 
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ 
	|	СУММА(ВТ_ВременнаяТаблица.Идентификатор) КАК Идентификатор,
	|	ВТ_ВременнаяТаблица.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ВТ_ВременнаяТаблица.УчетнаяЕдиница КАК УчетнаяЕдиница	
	|ИЗ
	|	ВТ_ВременнаяТаблица КАК ВТ_ВременнаяТаблица
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ВременнаяТаблица.ИдентификаторСтрокиУслуг,
	|	ВТ_ВременнаяТаблица.УчетнаяЕдиница
	|
	|ИМЕЮЩИЕ
	|	СУММА(ВТ_ВременнаяТаблица.Идентификатор) <> 0";
	
	МассивНоменклатур = Новый Массив;
	МассивНоменклатур.Добавить(Справочники.Номенклатура.АрендаКонтейнеров);
	МассивНоменклатур.Добавить(Справочники.Номенклатура.ПредоставлениеКТК);
	
	Запрос.УстановитьПараметр("Номенклатура", МассивНоменклатур);
	Запрос.УстановитьПараметр("Документ", ДокументСсылка);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Ответ = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		Элемент = Ответ.Найти(Выборка.ИдентификаторСтрокиУслуг);
		Если Элемент = Неопределено Тогда
			Ответ.Добавить(Выборка.ИдентификаторСтрокиУслуг);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Строка Из Ответ Цикл
		РелизОбъект = Строка.РелизСобственника.ПолучитьОбъект();
		Если Строка.Индикатор < 0 Тогда
			НайденнаяСтрока = РелизОбъект.Номинации.Найти(Строка.Контейнер, "Контейнер");
			Если НайденнаяСтрока <> Неопределено Тогда
				РелизОбъект.Номинации.Удалить(НайденнаяСтрока);
			КонецЕсли;
		Иначе
			НайденнаяСтрока = РелизОбъект.Номинации.Найти(Строка.ИдентификаторСтрокиПСЦПоставщика, "ИдентификаторСтрокиПСЦПоставщика");
			Если НайденнаяСтрока <> Неопределено Тогда
				НайденнаяСтрока.Контейнер = Строка.Контейнер;
			КонецЕсли;
		КонецЕсли;
		РелизОбъект.Записать();
	КонецЦикла;
	
	Возврат Ответ;
	
КонецФункции

//Евросиб(ДИТ), Беляев СЮ, BUG 94917 / TA 96390, 27-11-2024, начало
Функция СостояниеЦикловКонтейнеровРелиза(РелизСсылка, Контейнеры, ВидРезультата = "ТаблицаЗначений") Экспорт
	
	РезультатФункции = Неопределено;
	
	ТЗКонтейнеры = Новый ТаблицаЗначений;
	ТЗКонтейнеры.Колонки.Добавить("Контейнер", Новый ОписаниеТипов("СправочникСсылка.ТЕ"));
	ТЗКонтейнеры.Колонки.Добавить("ДатаВзятия", Новый ОписаниеТипов("Дата"));
	
	Если ТипЗнч(Контейнеры) = Тип("ТаблицаЗначений") Тогда
		ТЗКонтейнеры = Контейнеры;
	ИначеЕсли ТипЗнч(Контейнеры) = Тип("Массив") Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицуИзМассива(ТЗКонтейнеры, Контейнеры, "Контейнер");
	ИначеЕсли ТипЗнч(Контейнеры) = Тип("СправочникСсылка.ТЕ") Тогда
		ТЗКонтейнеры.Добавить().Контейнер = Контейнеры;
	КонецЕсли;
	
	Если ТЗКонтейнеры.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЗКонтейнеры.Контейнер КАК Контейнер,
		|	ТЗКонтейнеры.ДатаВзятия КАК ДатаВзятия,
		|	&Релиз КАК Релиз
		|ПОМЕСТИТЬ ВТКонтейнеры
		|ИЗ
		|	&ТЗКонтейнеры КАК ТЗКонтейнеры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	стоки_ТекущиеДанные.КТК КАК Контейнер,
		|	МАКСИМУМ(стоки_ТекущиеДанные.ПорядковыйНомерЦиклаАрендыКТК) КАК ПорядковыйНомерЦиклаАрендыКТК
		|ПОМЕСТИТЬ ВТНомераЦикловТекущегоРелиза
		|ИЗ
		|	РегистрСведений.стоки_ТекущиеДанные КАК стоки_ТекущиеДанные
		|ГДЕ
		|	стоки_ТекущиеДанные.КТК В
		|			(ВЫБРАТЬ
		|				ВТКонтейнеры.Контейнер
		|			ИЗ
		|				ВТКонтейнеры КАК ВТКонтейнеры)
		|	И стоки_ТекущиеДанные.тек_Релиз = &Релиз
		|
		|СГРУППИРОВАТЬ ПО
		|	стоки_ТекущиеДанные.КТК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	стоки_ТекущиеДанныеСрезПоследних.КТК КАК КТК,
		|	стоки_ТекущиеДанныеСрезПоследних.ПорядковыйНомерЦиклаАрендыКТК КАК ПорядковыйНомерЦиклаАрендыКТК,
		|	стоки_ТекущиеДанныеСрезПоследних.тек_ВЭксплуатации КАК тек_ВЭксплуатации
		|ПОМЕСТИТЬ ВТНомераАктуальныхЦиклов
		|ИЗ
		|	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних(
		|			,
		|			КТК В
		|				(ВЫБРАТЬ
		|					ВТКонтейнеры.Контейнер
		|				ИЗ
		|					ВТКонтейнеры КАК ВТКонтейнеры)) КАК стоки_ТекущиеДанныеСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТКонтейнеры.Контейнер КАК Контейнер,
		|	ВТКонтейнеры.ДатаВзятия КАК ДатаВзятия,
		|	ЕСТЬNULL(ВТНомераАктуальныхЦиклов.ПорядковыйНомерЦиклаАрендыКТК, 0) КАК ПорядковыйНомерЦиклаАрендыКТК_Актуальный,
		|	ЕСТЬNULL(ВТНомераЦикловТекущегоРелиза.ПорядковыйНомерЦиклаАрендыКТК, 0) КАК ПорядковыйНомерЦиклаАрендыКТК_ТекущегоРелиза,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТНомераЦикловТекущегоРелиза.ПорядковыйНомерЦиклаАрендыКТК, 0) = 0
		|				И ЕСТЬNULL(ВТНомераАктуальныхЦиклов.ПорядковыйНомерЦиклаАрендыКТК, 0) = 0
		|			ТОГДА ИСТИНА
		|		КОГДА ЕСТЬNULL(ВТНомераЦикловТекущегоРелиза.ПорядковыйНомерЦиклаАрендыКТК, 0) = 0
		|				И НЕ ЕСТЬNULL(ВТНомераАктуальныхЦиклов.тек_ВЭксплуатации, ЛОЖЬ)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЕСТЬNULL(ВТНомераАктуальныхЦиклов.ПорядковыйНомерЦиклаАрендыКТК, 0) = ЕСТЬNULL(ВТНомераЦикловТекущегоРелиза.ПорядковыйНомерЦиклаАрендыКТК, 0)
		|	КОНЕЦ КАК РелизАктуален
		|ПОМЕСТИТЬ ВТРезультат
		|ИЗ
		|	ВТКонтейнеры КАК ВТКонтейнеры
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТНомераЦикловТекущегоРелиза КАК ВТНомераЦикловТекущегоРелиза
		|		ПО ВТКонтейнеры.Контейнер = ВТНомераЦикловТекущегоРелиза.Контейнер
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТНомераАктуальныхЦиклов КАК ВТНомераАктуальныхЦиклов
		|		ПО ВТКонтейнеры.Контейнер = ВТНомераАктуальныхЦиклов.КТК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТРезультат.Контейнер КАК Контейнер,
		|	ВТРезультат.ДатаВзятия КАК ДатаВзятия,
		|	ВТРезультат.ПорядковыйНомерЦиклаАрендыКТК_Актуальный КАК ПорядковыйНомерЦиклаАрендыКТК_Актуальный,
		|	ВТРезультат.ПорядковыйНомерЦиклаАрендыКТК_ТекущегоРелиза КАК ПорядковыйНомерЦиклаАрендыКТК_ТекущегоРелиза,
		|	ВТРезультат.РелизАктуален КАК РелизАктуален
		|ИЗ
		|	ВТРезультат КАК ВТРезультат
		|ГДЕ
		|	ВТРезультат.РелизАктуален = &РелизАктуален";
	
	Если ВидРезультата = "МассивКонтейнеровПоКоторымРелизАктуален" Тогда
		Запрос.УстановитьПараметр("РелизАктуален", Истина);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВТРезультат.РелизАктуален = &РелизАктуален", "Истина");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ТЗКонтейнеры", ТЗКонтейнеры);
	Запрос.УстановитьПараметр("Релиз", РелизСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если ВидРезультата = "ТаблицаЗначений" Тогда
		РезультатФункции = РезультатЗапроса.Выгрузить();
	ИначеЕсли ВидРезультата = "СостояниеЦиклаКонтейнера" Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		РезультатФункции = Выборка.РелизАктуален;
	ИначеЕсли ВидРезультата = "МассивКонтейнеровПоКоторымРелизАктуален" Тогда
		РезультатФункции = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Контейнер");
	ИначеЕсли ВидРезультата = "МассивИзТаблицыЗначений" Тогда
		РезультатФункции = ОбщегоНазначения.ТаблицаЗначенийВМассив(РезультатЗапроса.Выгрузить());
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции
//Евросиб(ДИТ), Беляев СЮ, BUG 94917 / TA 96390, 27-11-2024, конец

// Евросиб US 104907 TA 105520 Рыбьяков К.А. 01.04.2025 (( перенес из модуля формы
Процедура УдалитьЗаписиРегистров(ОтменаПроведения, Объект) Экспорт
	Если ОтменаПроведения Тогда
		Отказ = Ложь;
		МассивКТК = Новый Массив;
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	стоки_ТекущиеДанныеСрезПоследних.ПорядковыйНомерЦиклаАрендыКТК КАК ПорядковыйНомерЦиклаАрендыКТК,
			|	стоки_ТекущиеДанныеСрезПоследних.КТК КАК КТК
			|ПОМЕСТИТЬ НомерЦикла
			|ИЗ
			|	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних(&Дата, тек_Релиз = &Релиз) КАК стоки_ТекущиеДанныеСрезПоследних
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	стоки_ТекущиеДанные.ГУИДЗаписи КАК ГУИДЗаписи,
			|	НомерЦикла.КТК КАК КТК,
			|	стоки_ТекущиеДанные.ИсточникЗаписи КАК ИсточникЗаписи
			|ИЗ
			|	НомерЦикла КАК НомерЦикла
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.стоки_ТекущиеДанные КАК стоки_ТекущиеДанные
			|		ПО НомерЦикла.КТК = стоки_ТекущиеДанные.КТК
			|			И НомерЦикла.ПорядковыйНомерЦиклаАрендыКТК = стоки_ТекущиеДанные.ПорядковыйНомерЦиклаАрендыКТК
			|ГДЕ
			//ДИТ Авдеева В.С. 53975 16.08.2022 Начало 
			|	стоки_ТекущиеДанные.Период >= &ДатаНачалаДействияРелиза И
			//ДИТ Авдеева В.С. 53975 16.08.2022 Конец 
			//|	стоки_ТекущиеДанные.ИсточникЗаписи ПОДОБНО ""%Заявка%""";
			//ДИТ, Беляев СЮ, Ticket#0323876, 11-09-2023, начало
			|	стоки_ТекущиеДанные.ИсточникЗаписи ПОДОБНО ""Заявка %""";
			//ДИТ, Беляев СЮ, Ticket#0323876, 11-09-2023, конец
		
		Запрос.УстановитьПараметр("Дата", ТекущаяДата());
		Запрос.УстановитьПараметр("Релиз", Объект.Ссылка);
		//ДИТ Авдеева В.С. 53975 16.08.2022 Начало 
		Запрос.УстановитьПараметр("ДатаНачалаДействияРелиза", Объект.НачалоДействия);//ПериодДействия.ДатаНачала);
		//ДИТ Авдеева В.С. 53975 16.08.2022 Конец 
		
		РезультатЗапроса = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса[1].Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				Сообщить("КТК "+ВыборкаДетальныеЗаписи.КТК+" выдан клиенту по "+ВыборкаДетальныеЗаписи.ИсточникЗаписи+". Отмена проведения невозможна.");
				Отказ = Истина;
		КонецЦикла;
		
		Если НЕ Отказ Тогда
			ВыборкаКТК = РезультатЗапроса[0].Выбрать();
			Пока ВыборкаКТК.Следующий() Цикл
				МассивКТК.Добавить(ВыборкаКТК.КТК);
			КонецЦикла;
			МассивПериодов = Новый Массив;
			Для каждого ЭлементМассива из МассивКТК Цикл
				СтокиТекущиеДанные = РегистрыСведений.стоки_ТекущиеДанные.СоздатьНаборЗаписей();
				СтокиТекущиеДанные.Отбор.КТК.Установить(ЭлементМассива);
				СтокиТекущиеДанные.Прочитать();			
				МассивСтрокКУдалению = Новый Массив;
				Для каждого ЗаписьСтокиТекущиеДанные из СтокиТекущиеДанные Цикл
					Если ЗаписьСтокиТекущиеДанные.тек_Релиз = Объект.Ссылка Тогда
						МассивПериодов.Добавить(ЗаписьСтокиТекущиеДанные.Период);
						МассивСтрокКУдалению.Добавить(ЗаписьСтокиТекущиеДанные);
					КонецЕсли;
				КонецЦикла;
				Для каждого СтрокаКУдалению из МассивСтрокКУдалению Цикл
					СтокиТекущиеДанные.Удалить(СтрокаКУдалению);
				КонецЦикла;
				СтокиТекущиеДанные.Записать();
			КонецЦикла;
			МассивГУИД = Новый Массив;	
			Для каждого ЭлементПериодов из МассивПериодов Цикл
				КлиентскоеОперирование = РегистрыСведений.стоки_КлиентскоеОперирование.СоздатьНаборЗаписей();
				КлиентскоеОперирование.Отбор.Период.Установить(ЭлементПериодов);
				КлиентскоеОперирование.Прочитать();
				Для каждого ЗаписьКлиентскоеОперирование из КлиентскоеОперирование Цикл
					МассивГУИД.Добавить(ЗаписьКлиентскоеОперирование.ГУИДЗаписи);
				КонецЦикла;
				КлиентскоеОперирование.Очистить();
				КлиентскоеОперирование.Записать();
			КонецЦикла;
			Для каждого ГУИД из МассивГУИД Цикл
				СтокиТекущиеДанныеСНП = РегистрыСведений.стоки_ТекущиеДанные_СНП.СоздатьНаборЗаписей();
				СтокиТекущиеДанныеСНП.Отбор.ГУИДЗаписи.Установить(ГУИД);
				СтокиТекущиеДанныеСНП.Очистить();
				СтокиТекущиеДанныеСНП.Записать();
			КонецЦикла;
		Иначе
			ДокОбъект = Объект.Ссылка.ПолучитьОбъект();
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
	Иначе
		ДокОбъект = Объект.Ссылка.ПолучитьОбъект();
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;
КонецПроцедуры
