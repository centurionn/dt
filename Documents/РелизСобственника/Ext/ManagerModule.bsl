// Евросиб US 89887 TA 93716 Рыбьяков К.А. 18.11.2024 ((
Процедура ЗаполнитьРелизСобственникаНаОснованииПСЦПоставщика(ДокументОснование, ЕстьИзменения = Ложь, Отказ = Ложь) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПСЦПоставщика.ВидУслугПоставщика КАК ВидУслугПоставщика,
	|	ПСЦПоставщика.СтатусДокумента КАК СтатусДокумента,
	|	ПСЦПоставщика.Проведен КАК Проведен,
	|	ПСЦПоставщика.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ПСЦПоставщика.Типовой КАК Типовой,
	|	ПСЦПоставщика.Договор.ВалютаВзаиморасчетов КАК ВалютаСНП
	|ИЗ
	|	Документ.ПСЦПоставщика КАК ПСЦПоставщика
	|ГДЕ
	|	ПСЦПоставщика.Ссылка = &Документ";
	
	Запрос.УстановитьПараметр("Документ", ДокументОснование);
	
	РеквизитыШапкиПСЦ = Запрос.Выполнить().Выбрать();
	
	СуммаВключаетНДС = Ложь;
	
	Пока РеквизитыШапкиПСЦ.Следующий() Цикл
		
		Если ЕстьИзменения И Не ЕстьСозданныеРелизы(ДокументОснование) Тогда
			Если Не РеквизитыШапкиПСЦ.Типовой Тогда
				Текст = НСтр("ru = 'Тип протокола должен быть ""Типовой"".'");
				ОбщегоНазначения.СообщитьПользователю(Текст,,,, Отказ);
			КонецЕсли;
			Если Не РеквизитыШапкиПСЦ.Проведен Тогда
				Текст = НСтр("ru = 'Протокол не проведен.'");
				ОбщегоНазначения.СообщитьПользователю(Текст,,,, Отказ);
			КонецЕсли;
			Если (РеквизитыШапкиПСЦ.СтатусДокумента <> Перечисления.СтатусыСогласования.СогласованоБезЗамечаний 
				И РеквизитыШапкиПСЦ.СтатусДокумента <> Перечисления.СтатусыСогласования.СогласованСКомментариями
				И РеквизитыШапкиПСЦ.СтатусДокумента <> Перечисления.СтатусыСогласования.Подписано) Тогда
				Текст = НСтр("ru = 'Протокол должен быть согласован или подписан.'");
				ОбщегоНазначения.СообщитьПользователю(Текст,,,, Отказ);
			КонецЕсли;
			Если РеквизитыШапкиПСЦ.ВидУслугПоставщика <> Справочники.ВидыУслугПоставщиков.Контейнеры Тогда
				Текст = НСтр("ru = '""Вид услуг поставщика"" должен быть ""Контейнеры""'");
				ОбщегоНазначения.СообщитьПользователю(Текст,,,, Отказ);
			КонецЕсли;
		КонецЕсли;
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		СуммаВключаетНДС = РеквизитыШапкиПСЦ.СуммаВключаетНДС;
		// Евросиб US 112646 TA 112819 Рыбьяков К.А. 06.07.2025 ((
		ВалютаСНП = РеквизитыШапкиПСЦ.ВалютаСНП;
		// Евросиб Рыбьяков К.А. 06.07.2025 ))
	КонецЦикла;
	
	Если ЕстьИзменения Тогда
		
		ЗапросТекущиеДанныеПСЦ = Новый Запрос;
		ЗапросТекущиеДанныеПСЦ.Текст = "ВЫБРАТЬ
		|	ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПСЦПоставщикаУчетныеЕдиницы.УчетнаяЕдиница) КАК Количество
		|ПОМЕСТИТЬ ВТ_КоличествоКТКВСтроке
		|ИЗ
		|	Документ.ПСЦПоставщика.Услуги КАК ПСЦПоставщикаУслуги
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПСЦПоставщика.УчетныеЕдиницы КАК ПСЦПоставщикаУчетныеЕдиницы
		|		ПО ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг = ПСЦПоставщикаУчетныеЕдиницы.ИдентификаторСтрокиУслуг
		|ГДЕ
		|	ПСЦПоставщикаУслуги.Ссылка = &Документ
		|	И ПСЦПоставщикаУслуги.Номенклатура В(&Номенклатура)
		|
		|СГРУППИРОВАТЬ ПО
		|	ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЕСТЬNULL(ПСЦПоставщикаКритерииУслуг.ТипоразмерКТК, ЗНАЧЕНИЕ(Справочник.ТипоразмерыТЕ.ПустаяСсылка))) КАК Количество
		|ПОМЕСТИТЬ ВТ_КоличествоТипов
		|ИЗ
		|	Документ.ПСЦПоставщика.Услуги КАК ПСЦПоставщикаУслуги
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПСЦПоставщика.КритерииУслуг КАК ПСЦПоставщикаКритерииУслуг
		|		ПО ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг = ПСЦПоставщикаКритерииУслуг.ИдентификаторСтрокиУслуг
		|ГДЕ
		|	ПСЦПоставщикаУслуги.Ссылка = &Документ
		|	И ПСЦПоставщикаУслуги.Номенклатура В(&Номенклатура)
		|
		|СГРУППИРОВАТЬ ПО
		|	ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПСЦПоставщикаУслуги.НомерСтроки КАК НомерСтроки,
		|	ПСЦПоставщикаУслуги.Количество / ВТ_КоличествоТипов.Количество КАК КоличествоКТК,
		|	ВЫБОР
		|		КОГДА ПСЦПоставщикаУслуги.ВидСобственности = Значение(Перечисление.ВариантыСобственности.Собственный)
		|			ТОГДА Значение(Справочник.Локации.ПустаяСсылка)   
		|		ИНАЧЕ
		|			ВЫБОР
		|				КОГДА ТИПЗНАЧЕНИЯ(ПСЦПоставщикаУслуги.ПунктОтправленияСтрана) = ТИП(Справочник.Мультилокации)
		|					ТОГДА Мультилокации.Локация
		|				ИНАЧЕ ПСЦПоставщикаУслуги.ПунктОтправленияСтрана 
		|			КОНЕЦ
		|	КОНЕЦ КАК ЛокацияСтрана,
		|	ВЫБОР
