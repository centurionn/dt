// Евросиб US 88643 TA 88646 Рыбьяков К.А. 04.09.2024 ((
Функция СоздатьКлючАналитикиСтрокиНоминаций(СсылкаРелиз,Контейнер) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	НовыйЭлемент = Справочники.КлючиАналитикиНоминацийРелиза.СоздатьЭлемент();
	НовыйЭлемент.Заполнить(Неопределено);
	//Евросиб СубботинВ #102687 24.02.2025 Начало// добавил 2 новых поля для рассылки выведенных из оперирования
	НовыйЭлемент.РелизСобственника = СсылкаРелиз;
	НовыйЭлемент.Контейнер = Контейнер; 
	//Евросиб СубботинВ #102687 24.02.2025 Конец
	НовыйЭлемент.Наименование = Новый УникальныйИдентификатор;
	НовыйЭлемент.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	КлючАналитики = НовыйЭлемент.Ссылка;
	
	Возврат КлючАналитики;
	
КонецФункции

Процедура ОбновитьРеквизитКлючаАналитики(КлючАналитикиСтроки, СтруктураРеквизитовЗначений, РазмерКТК = "") Экспорт //ДИТ Шевченко А.В. US 88683 TA 88689 19.02.2025
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если РазмерКТК = "20" Тогда
		СтруктураРеквизитовЗначений.Вставить("Ставка", СтруктураРеквизитовЗначений.Ставка20);
	ИначеЕсли РазмерКТК = "40" Тогда
		СтруктураРеквизитовЗначений.Вставить("Ставка", СтруктураРеквизитовЗначений.Ставка40);
	КонецЕсли;
	
	РеквизитыКлючаИзменились = Ложь;
	
	Для Каждого ЭлементСтруктуры Из СтруктураРеквизитовЗначений Цикл
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта(ЭлементСтруктуры.Ключ, КлючАналитикиСтроки.Метаданные()) Тогда
			Если ЭлементСтруктуры.Ключ = "Сделка" Тогда
				Продолжить;
			КонецЕсли;
			Если КлючАналитикиСтроки[ЭлементСтруктуры.Ключ] <> ЭлементСтруктуры.Значение Тогда
				РеквизитыКлючаИзменились = Истина;
			КонецЕсли;
			КлючАналитикиСтроки[ЭлементСтруктуры.Ключ] = ЭлементСтруктуры.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Если СтруктураРеквизитовЗначений.Свойство("Сделка") Тогда
		Если РеквизитыКлючаИзменились ИЛИ КлючАналитикиСтроки.Сделка <> СтруктураРеквизитовЗначений.Сделка Тогда
			Если ЗначениеЗаполнено(СтруктураРеквизитовЗначений.Сделка) Тогда
				ОтложенноеИзменениеСервер.ПоставитьОбъектВОчередьИзменения(СтруктураРеквизитовЗначений.Сделка, КлючАналитикиСтроки.Ссылка);
			КонецЕсли;
			Если ЗначениеЗаполнено(КлючАналитикиСтроки.Сделка) И КлючАналитикиСтроки.Сделка <> СтруктураРеквизитовЗначений.Сделка Тогда
				ОтложенноеИзменениеСервер.ПоставитьОбъектВОчередьИзменения(КлючАналитикиСтроки.Сделка, КлючАналитикиСтроки.Ссылка);
			КонецЕсли;
		КонецЕсли;
		КлючАналитикиСтроки.Сделка = СтруктураРеквизитовЗначений.Сделка;
	КонецЕсли;
	
	КлючАналитикиСтроки.Записать();
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ДанныеЗаполненияСчетаНаОплату(КлючАналитики, РелизСсылка) Экспорт
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РелизСсылка, "
		|Дата,
		|Организация, 
		|ЦФО, 
		|Подразделение, 
		|Контрагент, 
		|Договор, 
		|ПСЦ");
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("Основание", РелизСсылка);
	ДанныеЗаполнения.Вставить("Дата", Реквизиты.Дата);
	ДанныеЗаполнения.Вставить("Организация", Реквизиты.Организация);
	ДанныеЗаполнения.Вставить("ЦФО", Реквизиты.ЦФО);
	ДанныеЗаполнения.Вставить("Подразделение", Реквизиты.Подразделение);
	ДанныеЗаполнения.Вставить("Контрагент", Реквизиты.Контрагент);
	ДанныеЗаполнения.Вставить("Договор", Реквизиты.Договор);
	ДанныеЗаполнения.Вставить("Протокол", Реквизиты.ПСЦ);
	РеквизитыПротокола = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Реквизиты.ПСЦ, "Валюта, ВидПеревозки");
	ДанныеЗаполнения.Вставить("Валюта", РеквизитыПротокола.Валюта);
	ДанныеЗаполнения.Вставить("ВидПеревозки", РеквизитыПротокола.ВидПеревозки);

	МинимальнаяДата = Дата("00010101");
	МаксимальнаяДата = Дата("00010101");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РелизСобственникаНоминации.ДатаВзятия КАК ДатаВзятия,
	|	РелизСобственникаНоминации.НормативВозврата КАК НормативВозврата
	|ИЗ
	|	Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	|ГДЕ
	|	РелизСобственникаНоминации.КлючАналитики В(&КлючАналитики)
	|	И РелизСобственникаНоминации.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("КлючАналитики", КлючАналитики);
	Запрос.УстановитьПараметр("Ссылка", РелизСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ПромежуточнаяДата = Выборка.ДатаВзятия + Выборка.НормативВозврата * 86400;
		Если ПромежуточнаяДата > МаксимальнаяДата И ЗначениеЗаполнено(Выборка.ДатаВзятия) Тогда
			МаксимальнаяДата = ПромежуточнаяДата;
			МинимальнаяДата = Выборка.ДатаВзятия;
		КонецЕсли;
	КонецЦикла;
	
	ДанныеЗаполнения.Вставить("Отправка", МинимальнаяДата);
	ДанныеЗаполнения.Вставить("Прибытие", МаксимальнаяДата);
	ДанныеЗаполнения.Вставить("КлючиАналитики", КлючАналитики);

	Возврат ДанныеЗаполнения;
	
КонецФункции
