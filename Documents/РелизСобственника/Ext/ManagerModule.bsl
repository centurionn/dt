Функция НайтиРелизПоПараметрам(Строка, ДокументСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РелизСобственника.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РелизСобственника КАК РелизСобственника
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	|		ПО РелизСобственника.Ссылка = РелизСобственникаНоминации.Ссылка
	|ГДЕ
	|	РелизСобственника.ПСЦ = &Документ
	|	И РелизСобственника.Локация = &Локация
	|	И РелизСобственника.ЛокацияСдачи = &ЛокацияСдачи
	|	И РелизСобственника.Контрагент = &Контрагент
	|	И РелизСобственника.Договор = &Договор
	|	И РелизСобственника.Организация = &Организация
	|	И РелизСобственника.ЦФО = &ЦФО
	|	И НЕ РелизСобственника.ПометкаУдаления
	|	И РелизСобственника.ВозможныеСтокиСдачи = &ВозможныеСтокиСдачи
	|	И РелизСобственника.Сток = &Сток
	|	И РелизСобственникаНоминации.ТипКТК = &ТипКТК
	|	И РелизСобственникаНоминации.тек_СобственностьКТК = &тек_СобственностьКТК";
	
	Запрос.УстановитьПараметр("Документ", ДокументСсылка);
	Запрос.УстановитьПараметр("Контрагент", Строка.Контрагент);
	Запрос.УстановитьПараметр("Договор", Строка.Договор);
	Запрос.УстановитьПараметр("Организация", Строка.Организация);
	Запрос.УстановитьПараметр("ЦФО", Строка.ЦФО);
	Запрос.УстановитьПараметр("ТипКТК", Строка.ТипКТК);
	Если ЗначениеЗаполнено(Строка.ЛокацияГород) Тогда
		Запрос.УстановитьПараметр("Локация", Строка.ЛокацияГород);
	ИначеЕсли Строка.ЛокацияСтрана <> Неопределено Тогда
		Запрос.УстановитьПараметр("Локация", Строка.ЛокацияСтрана);
	КонецЕсли;
	Запрос.УстановитьПараметр("ЛокацияСдачи", Строка.ЛокацияСдачи);
	Запрос.УстановитьПараметр("ВозможныеСтокиСдачи", Строка.ВозможныеСтокиСдачи);
	Запрос.УстановитьПараметр("Сток", Строка.Сток);
	Запрос.УстановитьПараметр("тек_СобственностьКТК", Строка.тек_СобственностьКТК);
		
	Выборка = Запрос.Выполнить().Выбрать();

	Ответ = Неопределено;
	
	Пока Выборка.Следующий() Цикл
		Ответ = Выборка.Ссылка;
	КонецЦикла;
	
	Возврат Ответ;
	
