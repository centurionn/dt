		КонецЦикла;
		
		МассивЗаписываемыхОбъектов = Новый Соответствие;
		
		Если ВыгрузкаСтрокиПСЦТекущие.Количество() > 0 И ВыгрузкаДанныеВРелизах.Количество() > 0 Тогда
			ЕстьИзменениеВШапке = Ложь;
			ЕстьИзменениеВШапке = ЕстьИзменениеВШапке Или (ВыгрузкаСтрокиПСЦТекущие[0].СуммаВключаетНДС <> ВыгрузкаДанныеВРелизах[0].НДСВключая);
			ЕстьИзменениеВШапке = ЕстьИзменениеВШапке Или (ВыгрузкаСтрокиПСЦТекущие[0].Организация <> ВыгрузкаДанныеВРелизах[0].Организация);
			ЕстьИзменениеВШапке = ЕстьИзменениеВШапке Или (ВыгрузкаСтрокиПСЦТекущие[0].ЦФО <> ВыгрузкаДанныеВРелизах[0].ЦФО);
			ЕстьИзменениеВШапке = ЕстьИзменениеВШапке Или (ВыгрузкаСтрокиПСЦТекущие[0].Подразделение <> ВыгрузкаДанныеВРелизах[0].Подразделение);
			ЕстьИзменениеВШапке = ЕстьИзменениеВШапке Или (ВыгрузкаСтрокиПСЦТекущие[0].Контрагент <> ВыгрузкаДанныеВРелизах[0].Контрагент);
			ЕстьИзменениеВШапке = ЕстьИзменениеВШапке Или (ВыгрузкаСтрокиПСЦТекущие[0].Договор <> ВыгрузкаДанныеВРелизах[0].Договор);
			ЕстьИзменениеВШапке = ЕстьИзменениеВШапке Или (ВыгрузкаСтрокиПСЦТекущие[0].НачалоДействия <> ВыгрузкаДанныеВРелизах[0].НачалоДействия);
			ЕстьИзменениеВШапке = ЕстьИзменениеВШапке Или (ВыгрузкаСтрокиПСЦТекущие[0].ОкончаниеДействия <> ВыгрузкаДанныеВРелизах[0].ОкончаниеДействия);
			Если ЕстьИзменениеВШапке Тогда
				ИзменитьОбщиеРеквизитыРелиза(ВыгрузкаСтрокиПСЦТекущие, ДокументОснование, МассивЗаписываемыхОбъектов);
			КонецЕсли;
		КонецЕсли;
		
		Для Каждого СтрокаПСЦ Из ВыгрузкаСтрокиПСЦТекущие Цикл
			ПроверитьЛокацииВСтроке(СтрокаПСЦ);
			Отбор = Новый Структура;
			Отбор.Вставить("ИдентификаторСтрокиУслуг", СтрокаПСЦ.ИдентификаторСтрокиУслуг);
			Отбор.Вставить("ТипКТК", СтрокаПСЦ.ТипКТК);
			Если ЗначениеЗаполнено(СтрокаПСЦ.ЛокацияГород) Тогда
				Отбор.Вставить("ЛокацияГород", СтрокаПСЦ.ЛокацияГород);
			Иначе
				Отбор.Вставить("ЛокацияГород", СтрокаПСЦ.ЛокацияСтрана);
			КонецЕсли;
			Отбор.Вставить("ЛокацияСдачи", СтрокаПСЦ.ЛокацияСдачи);
			Отбор.Вставить("ВозможныеСтокиСдачи", СтрокаПСЦ.ВозможныеСтокиСдачи);
			Отбор.Вставить("Сток", СтрокаПСЦ.Сток);
			Отбор.Вставить("тек_СобственностьКТК", СтрокаПСЦ.тек_СобственностьКТК);
			НайденныеСтроки = ВыгрузкаДанныеВРелизах.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() = 0 Тогда
				СоздатьСтроки(СтрокаПСЦ, ДокументОснование, ТаблицаСтавокСНП, ВалютаСНП);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого СтрокаРелиза Из ВыгрузкаДанныеВРелизах Цикл
			Отбор = Новый Структура;
			Отбор.Вставить("ИдентификаторСтрокиУслуг", СтрокаРелиза.ИдентификаторСтрокиУслуг);
			Отбор.Вставить("ТипКТК", СтрокаРелиза.ТипКТК);
			ТипЛокации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаРелиза.ЛокацияГород, "Тип");
			Если ТипЗнч(ТипЛокации) = Справочники.ТипыЛокаций.Страна Тогда
				Отбор.Вставить("ЛокацияСтрана", СтрокаРелиза.ЛокацияГород);
			Иначе
				Отбор.Вставить("ЛокацияГород", СтрокаРелиза.ЛокацияГород);
			КонецЕсли;
			Отбор.Вставить("ЛокацияСдачи", СтрокаРелиза.ЛокацияСдачи);
			Отбор.Вставить("ВозможныеСтокиСдачи", СтрокаРелиза.ВозможныеСтокиСдачи);
			Отбор.Вставить("Сток", СтрокаРелиза.Сток);
			Отбор.Вставить("тек_СобственностьКТК", СтрокаРелиза.тек_СобственностьКТК);
			НайденныеСтроки = ВыгрузкаСтрокиПСЦТекущие.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() = 0 Тогда
				УдалитьСтроки(СтрокаРелиза, ДокументОснование, МассивЗаписываемыхОбъектов);
			КонецЕсли;
		КонецЦикла;
		
		ВыгрузкаДетализацияКТКВРелизах = ЗапросДетализацияКТКРелиза.Выполнить().Выгрузить();
		
		Для Каждого СтрокаРелиза Из ВыгрузкаДетализацияКТКВРелизах Цикл
			Отбор = Новый Структура;
			Отбор.Вставить("ИдентификаторСтрокиУслуг", СтрокаРелиза.ИдентификаторСтрокиУслуг);
			Отбор.Вставить("ТипКТК", СтрокаРелиза.ТипКТК);
			Отбор.Вставить("Контейнер", СтрокаРелиза.Контейнер);
			НайденныеСтроки = ВыгрузкаДетализацияКТКПСЦ.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() = 0 Тогда
				КонтенерыКУдалению.Добавить(СтрокаРелиза.Контейнер);
			КонецЕсли;
		КонецЦикла;
		
		Если КонтенерыКУдалению.Количество() > 0 Тогда
			УдалитьКонтейнеры(КонтенерыКУдалению, ДокументОснование, МассивЗаписываемыхОбъектов);
		КонецЕсли;
		
		Для Каждого СтрокаПСЦСКТК Из ВыгрузкаДетализацияКТКПСЦ Цикл
			Отбор = Новый Структура;
			Отбор.Вставить("ИдентификаторСтрокиУслуг", СтрокаПСЦСКТК.ИдентификаторСтрокиУслуг);
			Отбор.Вставить("ТипКТК", СтрокаПСЦСКТК.ТипКТК);
			Отбор.Вставить("Контейнер", СтрокаПСЦСКТК.Контейнер);
			НайденныеСтроки = ВыгрузкаДетализацияКТКВРелизах.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() = 0 Тогда
				Контейнер = Новый Структура;
				Контейнер.Вставить("ИдентификаторСтрокиУслуг", СтрокаПСЦСКТК.ИдентификаторСтрокиУслуг);
				Контейнер.Вставить("Контейнер", СтрокаПСЦСКТК.Контейнер);
				Контейнер.Вставить("ТипКТК", СтрокаПСЦСКТК.ТипКТК);
				КонтенерыКДобавлению.МассивКонтейнеров.Добавить(Контейнер);
				КонтенерыКДобавлению.ИдентификаторыСтрокУслуг.Добавить(СтрокаПСЦСКТК.ИдентификаторСтрокиУслуг);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого СтрокаПСЦСКоличеством Из ВыгрузкаСтрокиПСЦТекущие Цикл
			СтрокаРелиза = СоответствиеСтрокРелизов.Получить(СтрокаПСЦСКоличеством.ИдентификаторСтрокиУслуг);	
			Если СтрокаРелиза = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ЕстьИзменениеВКоличествеКТК = Ложь;
			ЕстьИзменениеВКоличествеКТК = (СтрокаПСЦСКоличеством.КоличествоКТК <> СтрокаРелиза.КоличествоКТК);
			Если ЕстьИзменениеВКоличествеКТК Тогда
				ДобавитьУдалитьСтроки(СтрокаПСЦСКоличеством, ДокументОснование, СтрокаРелиза.КоличествоКТК, МассивЗаписываемыхОбъектов);
			КонецЕсли;
		КонецЦикла;
		
		Если КонтенерыКДобавлению.МассивКонтейнеров.Количество() > 0 Тогда
			Добавитьконтейнеры(КонтенерыКДобавлению, ДокументОснование, МассивЗаписываемыхОбъектов);
		КонецЕсли;
		
		Для Каждого ЗаписываемыйОбъект Из МассивЗаписываемыхОбъектов Цикл
			ЗаписываемыйОбъект.Значение.Записать();
		КонецЦикла;
		
		Для Каждого СтрокаПСЦ Из ВыгрузкаСтрокиПСЦТекущие Цикл
			СтрокаРелиза = СоответствиеСтрокРелизов.Получить(СтрокаПСЦ.ИдентификаторСтрокиУслуг);
			Если СтрокаРелиза = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ЕстьИзменение = Ложь;
			ЕстьИзменение = ЕстьИзменение Или (СтрокаПСЦ.Валюта <> СтрокаРелиза.Валюта);
			ЕстьИзменение = ЕстьИзменение Или (СтрокаПСЦ.НормативВозврата <> СтрокаРелиза.НормативВозврата);
			ЕстьИзменение = ЕстьИзменение Или (СтрокаПСЦ.Ставка <> СтрокаРелиза.Ставка);
			ЕстьИзменение = ЕстьИзменение Или (СтрокаПСЦ.СтавкаНДС <> СтрокаРелиза.СтавкаНДС);
			ЕстьИзменение = ЕстьИзменение Или (СтрокаПСЦ.тек_СобственностьКТК <> СтрокаРелиза.тек_СобственностьКТК);
			ЕстьИзменение = ЕстьИзменение Или (СтрокаПСЦ.тек_Примечание <> СтрокаРелиза.тек_Примечание);
			ЕстьИзменение = ЕстьИзменение Или (СтрокаПСЦ.ИнструкцииПоСдаче <> СтрокаРелиза.ИнструкцииПоСдаче);
			Если ЕстьИзменение Тогда
				СтрокиКИзменению.Добавить(СтрокаПСЦ);
			КонецЕсли;
		КонецЦикла;
		
		ВыгрузкаДанныеВРелизах = ЗапросДанныеВРелизах.Выполнить().Выгрузить();
		ВыгрузкаДанныеСНПРелизах = ЗапросСНПРелиза.Выполнить().Выгрузить();
		
		Для Каждого СтрокаСтавкаПСЦ Из ТаблицаСтавокСНП Цикл
			ОтборПоискаСтавки = Новый Структура;
			ОтборПоискаСтавки.Вставить("От", СтрокаСтавкаПСЦ.От);
			ОтборПоискаСтавки.Вставить("До", СтрокаСтавкаПСЦ.До);
			ОтборПоискаСтавки.Вставить("ЛокацияСдачи", СтрокаСтавкаПСЦ.ЛокацияСдачи);
			ОтборПоискаСтавки.Вставить("Сток", СтрокаСтавкаПСЦ.Сток);
			ОтборПоискаСтавки.Вставить("ВозможныеСтокиСдачи", СтрокаСтавкаПСЦ.ВозможныеСтокиСдачи);
			Если ЗначениеЗаполнено(СтрокаСтавкаПСЦ.ЛокацияГород) Тогда
				ОтборПоискаСтавки.Вставить("ЛокацияГород", СтрокаСтавкаПСЦ.ЛокацияГород);
			ИначеЕсли ЗначениеЗаполнено(СтрокаСтавкаПСЦ.ЛокацияСтрана) Тогда
				ОтборПоискаСтавки.Вставить("ЛокацияСтрана", СтрокаСтавкаПСЦ.ЛокацияСтрана);
			КонецЕсли;
			Если СтрокаСтавкаПСЦ.СтавкаПрогрессивная Тогда
				ОтборПоискаСтавки.Вставить("Стоимость", СтрокаСтавкаПСЦ.СтоимостьБезНДСИзШкалы);
			Иначе
				ОтборПоискаСтавки.Вставить("Стоимость", СтрокаСтавкаПСЦ.СтоимостьБезНДСИзУслуг);
			КонецЕсли;
			ОтборПоискаСтавки.Вставить("ТипоразмерКТК", СтрокаСтавкаПСЦ.ТипоразмерКТК);
			ОтборПоискаСтавки.Вставить("СтавкаПрогрессивная", СтрокаСтавкаПСЦ.СтавкаПрогрессивная);
			ЕстьСтавка = ВыгрузкаДанныеСНПРелизах.НайтиСтроки(ОтборПоискаСтавки);
			//Если такая ставка уже есть то ничего не делаем
			Если ЕстьСтавка.Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;
			ОтборСтавки = Новый Структура;
			ОтборСтавки.Вставить("ТипКТК", СтрокаСтавкаПСЦ.ТипоразмерКТК);
			ОтборСтавки.Вставить("ЛокацияСдачи", СтрокаСтавкаПСЦ.ЛокацияСдачи);
			ОтборСтавки.Вставить("Сток", СтрокаСтавкаПСЦ.Сток);
			ОтборСтавки.Вставить("ВозможныеСтокиСдачи", СтрокаСтавкаПСЦ.ВозможныеСтокиСдачи);
			Если ЗначениеЗаполнено(СтрокаСтавкаПСЦ.ЛокацияГород) Тогда
				ОтборСтавки.Вставить("ЛокацияГород", СтрокаСтавкаПСЦ.ЛокацияГород);
			ИначеЕсли ЗначениеЗаполнено(СтрокаСтавкаПСЦ.ЛокацияСтрана) Тогда
				ОтборСтавки.Вставить("ЛокацияСтрана", СтрокаСтавкаПСЦ.ЛокацияСтрана);
			КонецЕсли;
			СтрокиСИзмененнойСтавкой = ВыгрузкаДанныеВРелизах.НайтиСтроки(ОтборСтавки);
			Для Каждого СтрокаКИзменению Из СтрокиСИзмененнойСтавкой Цикл
				СтрокиКИзменению.Добавить(СтрокаКИзменению);
			КонецЦикла;
			Если ТипЗнч(СтрокаСтавкаПСЦ.ВозможныеСтокиСдачиМультилокация) = Тип("СправочникСсылка.Мультилокации") Тогда
				ОтборСтавки.Удалить("ВозможныеСтокиСдачи");
				ОтборСтавки.Вставить("ВозможныеСтокиСдачи", СтрокаСтавкаПСЦ.ВозможныеСтокиСдачиМультилокация);
			КонецЕсли;
			СтрокиСИзмененнойСтавкой = ВыгрузкаДанныеВРелизах.НайтиСтроки(ОтборСтавки);
			Для Каждого СтрокаКИзменению Из СтрокиСИзмененнойСтавкой Цикл
				СтрокиКИзменению.Добавить(СтрокаКИзменению);
			КонецЦикла;
		КонецЦикла;
		
		Для Каждого СтрокаРелиза Из ВыгрузкаДанныеСНПРелизах Цикл
			ОтборПоискаСтавки = Новый Структура;
			ОтборПоискаСтавки.Вставить("От", СтрокаРелиза.От);
			ОтборПоискаСтавки.Вставить("До", СтрокаРелиза.До);
			ОтборПоискаСтавки.Вставить("ЛокацияСдачи", СтрокаРелиза.ЛокацияСдачи);
			ОтборПоискаСтавки.Вставить("Сток", СтрокаРелиза.Сток);
			ОтборПоискаСтавки.Вставить("ВозможныеСтокиСдачи", СтрокаРелиза.ВозможныеСтокиСдачи);
			Если ЗначениеЗаполнено(СтрокаРелиза.ЛокацияГород) Тогда
				ОтборПоискаСтавки.Вставить("ЛокацияГород", СтрокаРелиза.ЛокацияГород);
			ИначеЕсли ЗначениеЗаполнено(СтрокаРелиза.ЛокацияСтрана) Тогда
				ОтборПоискаСтавки.Вставить("ЛокацияСтрана", СтрокаРелиза.ЛокацияСтрана);
			КонецЕсли;
			Если СтрокаРелиза.СтавкаПрогрессивная Тогда
				ОтборПоискаСтавки.Вставить("СтоимостьБезНДСИзШкалы", СтрокаРелиза.Стоимость);
			Иначе
				ОтборПоискаСтавки.Вставить("СтоимостьБезНДСИзУслуг", СтрокаРелиза.Стоимость);
			КонецЕсли;
			ОтборПоискаСтавки.Вставить("ТипоразмерКТК", СтрокаРелиза.ТипоразмерКТК);
			ОтборПоискаСтавки.Вставить("СтавкаПрогрессивная", СтрокаРелиза.СтавкаПрогрессивная);
			// Если не нашли ставку по параметрам то добавляем строку к изменению
			НайденныеСтроки = ТаблицаСтавокСНП.НайтиСтроки(ОтборПоискаСтавки);
			Если НайденныеСтроки.Количество() = 0 Тогда
				ОтборСтрок = Новый Структура;
				ОтборСтрок.Вставить("ИдентификаторСтрокиУслуг", СтрокаРелиза.ИдентификаторСтрокиУслуг);
				СтрокиСИзмененнойСтавкой = ВыгрузкаДанныеВРелизах.НайтиСтроки(ОтборСтрок);
				Для Каждого СтрокаКИзменению Из СтрокиСИзмененнойСтавкой Цикл
					Если СтрокиКИзменению.Найти(СтрокаКИзменению) = Неопределено Тогда
						СтрокиКИзменению.Добавить(СтрокаКИзменению);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого Строка Из СтрокиКИзменению Цикл
			ИзменитьСтроки(Строка, ДокументОснование, ТаблицаСтавокСНП, ВалютаСНП);
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

Процедура СоздатьСтроки(Строка, ДокументОснование, СтавкиСНП, ВалютаСНП)
	
	ВывестиСообщениеОбОшибке = Ложь;
	КоличествоКТК = Строка.КоличествоКТК;
	ПривязаныеКТККСтрокеПСЦ = НайтиПривязаныеКТККСтроке(Строка);
	
	Релиз = НайтиРелизПоПараметрам(Строка, ДокументОснование);
	РелизОбъект = Неопределено;
	ОшибкаСтавки = Ложь;
	
	Если Релиз <> Неопределено Тогда
		РелизОбъект = Релиз.ПолучитьОбъект();
	Иначе
		РелизОбъект = Документы.РелизСобственника.СоздатьДокумент();
		ЗаполнитьЗначенияСвойств(РелизОбъект, Строка);
		РелизОбъект.ПСЦ = ДокументОснование;
		РелизОбъект.НаОсновании = Истина;
		РелизОбъект.Дата = ТекущаяДатаСеанса();
		РелизОбъект.Создано = ТекущаяДатаСеанса();
		РелизОбъект.Изменено = ТекущаяДатаСеанса();
		РелизОбъект.Автор = Пользователи.ТекущийПользователь();
		РелизОбъект.Редактор = Пользователи.ТекущийПользователь();
		РелизОбъект.ПСЦ = ДокументОснование;
		Если ЗначениеЗаполнено(Строка.ЛокацияГород) Тогда
			РелизОбъект.Локация = Строка.ЛокацияГород;
		Иначе
			РелизОбъект.Локация = Строка.ЛокацияСтрана;
		КонецЕсли;
		Если Строка.тек_СобственностьКТК = Перечисления.ВариантыСобственности.Собственный Тогда
			РелизОбъект.СобственныеКТК = Истина;
			РелизОбъект.Локация = Неопределено;
			РелизОбъект.ЛокацияСдачи = Неопределено;
			РелизОбъект.ВозможныеСтокиСдачи = Неопределено;
			РелизОбъект.Сток = Неопределено;
		ИначеЕсли Строка.тек_СобственностьКТК = Перечисления.ВариантыСобственности.СпотДоплатный Тогда
			РелизОбъект.ДоплатныеКТК = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Для Счетчик = 1 По КоличествоКТК Цикл
		
		НоваяСтрока = РелизОбъект.Номинации.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.ГУИДСтроки = Новый УникальныйИдентификатор;
		НоваяСтрока.НДСВключая = Строка.СуммаВключаетНДС;
		НоваяСтрока.ДатаАктуальностиЗаписи = ТекущаяДатаСеанса();
		НоваяСтрока.ИдентификаторСтрокиПСЦПоставщика = Строка.ИдентификаторСтрокиУслуг;
		
		Если ПривязаныеКТККСтрокеПСЦ.Количество() > 0 Тогда
			КонтейнерЕсть = ПроверитьКонтейнерНаНаличиеВРелизе(ПривязаныеКТККСтрокеПСЦ[0].Контейнер, Строка.ИдентификаторСтрокиУслуг, РелизОбъект.Ссылка);
			Если НЕ КонтейнерЕсть Тогда
				НоваяСтрока.Контейнер = ПривязаныеКТККСтрокеПСЦ[0].Контейнер;
				НоваяСтрока.ТипКТК = ПривязаныеКТККСтрокеПСЦ[0].ТипКТК;
				ПривязаныеКТККСтрокеПСЦ.Удалить(0);
			КонецЕсли;
		КонецЕсли;
		
		ОшибкаСтавки = ДобавитьСтавкуСНПКСтроке(РелизОбъект, НоваяСтрока, СтавкиСНП, ВалютаСНП);
		
	КонецЦикла;
	
	РелизОбъект.Записать();
	
	Если Релиз = Неопределено Тогда
		Если ОшибкаСтавки Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Создан релиз %1. Проверьте ставки СНП в релизе.'"), РелизОбъект.Ссылка);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, РелизОбъект.Ссылка);
		Иначе
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Создан релиз %1'"), РелизОбъект.Ссылка);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, РелизОбъект.Ссылка);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьЛокацииВСтроке(Строка)
	
	Если ЗначениеЗаполнено(Строка.Сток) Тогда
		НаселенныйПункт = Неопределено;
		Страна = Неопределено;
		ЛокацияВышестоящегоУровня = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Строка.Сток, "ЛокацияВышестоящегоУровня");
		ТипЛокацииВышестоящегоУровня = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЛокацияВышестоящегоУровня, "Тип");
		Пока ЗначениеЗаполнено(ЛокацияВышестоящегоУровня) Цикл
			Если ТипЛокацииВышестоящегоУровня = Справочники.ТипыЛокаций.НаселенныйПункт И НаселенныйПункт = Неопределено Тогда
				НаселенныйПункт = ЛокацияВышестоящегоУровня;
			ИначеЕсли ТипЛокацииВышестоящегоУровня = Справочники.ТипыЛокаций.Страна И Страна = Неопределено Тогда
				Страна = ЛокацияВышестоящегоУровня;
			КонецЕсли;
			ЛокацияВышестоящегоУровня = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЛокацияВышестоящегоУровня, "ЛокацияВышестоящегоУровня");
			ТипЛокацииВышестоящегоУровня = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЛокацияВышестоящегоУровня, "Тип");
		КонецЦикла;
		Строка.ЛокацияГород = НаселенныйПункт;
		Строка.ЛокацияСтрана = Страна;
	ИначеЕсли ЗначениеЗаполнено(Строка.ЛокацияГород) И Не ЗначениеЗаполнено(Строка.ЛокацияСтрана) Тогда
		Страна = Неопределено;
		ЛокацияВышестоящегоУровня = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Строка.ЛокацияГород, "ЛокацияВышестоящегоУровня");
		ТипЛокацииВышестоящегоУровня = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЛокацияВышестоящегоУровня, "Тип");
		Пока ЗначениеЗаполнено(ЛокацияВышестоящегоУровня) Цикл
			Если ТипЛокацииВышестоящегоУровня = Справочники.ТипыЛокаций.Страна И Страна = Неопределено Тогда
				Страна = ЛокацияВышестоящегоУровня;
			КонецЕсли;
			ЛокацияВышестоящегоУровня = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЛокацияВышестоящегоУровня, "ЛокацияВышестоящегоУровня");
			ТипЛокацииВышестоящегоУровня = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЛокацияВышестоящегоУровня, "Тип");
		КонецЦикла;
		Строка.ЛокацияСтрана = Страна;
	КонецЕсли;
	
КонецПроцедуры

Процедура ИзменитьСтроки(Строка, ДокументОснование, СтавкиСНП, ВалютаСНП)
	
	ВывестиСообщениеОбОшибке = Ложь;
	КоличествоКТК = Строка.КоличествоКТК;
	ПривязаныеКТККСтрокеПСЦ = НайтиПривязаныеКТККСтроке(Строка);
	
	Релиз = НайтиРелизПоПараметрам(Строка, ДокументОснование);
	
	Если Релиз <> Неопределено Тогда
		РелизОбъект = Релиз.ПолучитьОбъект();
		Если Строка.тек_СобственностьКТК = Перечисления.ВариантыСобственности.Собственный Тогда
			РелизОбъект.СобственныеКТК = Истина;
			РелизОбъект.Локация = Справочники.Локации.ПустаяСсылка();
			РелизОбъект.ВозможныеСтокиСдачи = Неопределено;
			РелизОбъект.ЛокацияСдачи = Неопределено;
			РелизОбъект.Сток = Справочники.Локации.ПустаяСсылка();
		Иначе
			РелизОбъект.СобственныеКТК = Ложь;
			Если ЗначениеЗаполнено(Строка.ЛокацияГород) Тогда
				РелизОбъект.Локация = Строка.ЛокацияГород;
			Иначе
				РелизОбъект.Локация = Строка.ЛокацияСтрана;
			КонецЕсли;
			РелизОбъект.ВозможныеСтокиСдачи = Строка.ВозможныеСтокиСдачи;
			РелизОбъект.ЛокацияСдачи = Строка.ЛокацияСдачи;
			РелизОбъект.Сток = Строка.Сток;
		КонецЕсли;
		Отбор = Новый Структура;
		Отбор.Вставить("ИдентификаторСтрокиПСЦПоставщика", Строка.ИдентификаторСтрокиУслуг);
		Отбор.Вставить("ТипКТК", Строка.ТипКТК);
		НайденныеСтроки = РелизОбъект.Номинации.НайтиСтроки(Отбор);
		Для Каждого СтрокаНоминаций Из НайденныеСтроки Цикл
			ЗаполнитьЗначенияСвойств(СтрокаНоминаций, Строка);
			Если ПривязаныеКТККСтрокеПСЦ.Количество() > 0 Тогда
				КонтейнерЕсть = ПроверитьКонтейнерНаНаличиеВРелизе(ПривязаныеКТККСтрокеПСЦ[0].Контейнер, Строка.ИдентификаторСтрокиУслуг, РелизОбъект.Ссылка);
				Если КонтейнерЕсть Тогда
					СтрокаНоминаций.Контейнер = ПривязаныеКТККСтрокеПСЦ[0].Контейнер;
					СтрокаНоминаций.ТипКТК = ПривязаныеКТККСтрокеПСЦ[0].ТипКТК;
					ПривязаныеКТККСтрокеПСЦ.Удалить(0);
				КонецЕсли;
			КонецЕсли;
			ОшибкаСтавки = ДобавитьСтавкуСНПКСтроке(РелизОбъект, СтрокаНоминаций, СтавкиСНП, ВалютаСНП);
		КонецЦикла;
		
		Если КоличествоКТК <> НайденныеСтроки.Количество() Тогда
			Разница = КоличествоКТК - НайденныеСтроки.Количество();
			Если Разница > 0 Тогда
				Для Счетчик = 1 По Разница Цикл
					НоваяСтрока = РелизОбъект.Номинации.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
					НоваяСтрока.ГУИДСтроки = Новый УникальныйИдентификатор;
					НоваяСтрока.ДатаАктуальностиЗаписи = ТекущаяДатаСеанса();
					НоваяСтрока.ИдентификаторСтрокиПСЦПоставщика = Строка.ИдентификаторСтрокиУслуг;
					
					Если ПривязаныеКТККСтрокеПСЦ.Количество() > 0 Тогда
						КонтейнерЕсть = ПроверитьКонтейнерНаНаличиеВРелизе(ПривязаныеКТККСтрокеПСЦ[0].Контейнер, Строка.ИдентификаторСтрокиУслуг, РелизОбъект.Ссылка);
						Если НЕ КонтейнерЕсть Тогда
							НоваяСтрока.Контейнер = ПривязаныеКТККСтрокеПСЦ[0].Контейнер;
							НоваяСтрока.ТипКТК = ПривязаныеКТККСтрокеПСЦ[0].ТипКТК;
							ПривязаныеКТККСтрокеПСЦ.Удалить(0);
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			ИначеЕсли Разница < 0 Тогда
				РазницаУдаления = -Разница;
				СтрокиДляУдаления = Новый Массив;
				
				Для Счетчик = 0 По РазницаУдаления - 1 Цикл
					Индекс = НайденныеСтроки.Количество() - 1 - Счетчик;
					Если Индекс >= 0 Тогда
						СтрокиДляУдаления.Добавить(НайденныеСтроки[Индекс]);
					КонецЕсли;
				КонецЦикла;
				
				Для Каждого СтрокаИзМассива Из СтрокиДляУдаления Цикл
					Если ЗначениеЗаполнено(СтрокаИзМассива.Контейнер) Тогда
						ПривязаныеКТККСтрокеПСЦ.Добавить(СтрокаИзМассива.Контейнер);
					КонецЕсли;
					РелизОбъект.Номинации.Удалить(СтрокаИзМассива);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		РелизОбъект.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПроверитьСтрокиПСЦНаОшибки(ВыгрузкаДетализацияКТКПСЦ, ВыгрузкаСтрокиПСЦТекущие, Отказ)
	
	СтрокиСОшибками = Новый Массив;
	Для Каждого СтрокаДетализацииКТК Из ВыгрузкаДетализацияКТКПСЦ Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("ИдентификаторСтрокиУслуг", СтрокаДетализацииКТК.ИдентификаторСтрокиУслуг);
		Отбор.Вставить("ТипКТК", СтрокаДетализацииКТК.ТипКТК);
		НайденныеСтроки = ВыгрузкаСтрокиПСЦТекущие.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() = 0 Тогда
			СтрокиСОшибками.Добавить(СтрокаДетализацииКТК.НомерСтроки);
		КонецЕсли;
	КонецЦикла;
	
	СтрокиСОшибками = ОбщегоНазначенияКлиентСервер.СвернутьМассив(СтрокиСОшибками);
	СортироватьМассив(СтрокиСОшибками);
	
	Если СтрокиСОшибками.Количество() > 0 Тогда
		НомераСтрок = "";
		Для Каждого Номер Из СтрокиСОшибками Цикл
			НомераСтрок = НомераСтрок + "№" + Номер + ", ";
		КонецЦикла;
		НомераСтрок = Лев(НомераСтрок, СтрДлина(НомераСтрок) - 2);
		Текст = СтрШаблон(НСтр("ru = 'Невозможно создать релиз собственника, т.к. отличаются типоразмеры КТК по строке %1 с данными КТК в детализации'"), 
			НомераСтрок);
		ОбщегоНазначения.СообщитьПользователю(Текст,,,, Отказ);
	КонецЕсли;
	
	СтрокиСОшибкамиВКоличестве = Новый Массив;
	Для Каждого СтрокаПСЦ Из ВыгрузкаСтрокиПСЦТекущие Цикл
		Если СтрокаПСЦ.КоличествоКТК % 1 <> 0 Тогда
			СтрокиСОшибкамиВКоличестве.Добавить(СтрокаПСЦ.НомерСтроки);
		КонецЕсли;
	КонецЦикла;
	
	СтрокиСОшибкамиВКоличестве = ОбщегоНазначенияКлиентСервер.СвернутьМассив(СтрокиСОшибкамиВКоличестве);
	СортироватьМассив(СтрокиСОшибкамиВКоличестве);
	
	Если СтрокиСОшибкамиВКоличестве.Количество() > 0 Тогда
		НомераСтрок = "";
		Для Каждого Номер Из СтрокиСОшибкамиВКоличестве Цикл
			НомераСтрок = НомераСтрок + "№" + Номер + ", ";
		КонецЦикла;
		НомераСтрок = Лев(НомераСтрок, СтрДлина(НомераСтрок) - 2);
		Текст = СтрШаблон(НСтр("ru = 'Невозможно создать релиз собственника, указаны разные типоразмеры по строке %1'"), 
			НомераСтрок);
		ОбщегоНазначения.СообщитьПользователю(Текст,,,, Отказ);
	КонецЕсли;
	
	СтрокиСОшибкамиВДетализации = Новый Массив;
	Для Каждого СтрокаПСЦ Из ВыгрузкаСтрокиПСЦТекущие Цикл
		Если СтрокаПСЦ.КоличествоКТК < СтрокаПСЦ.КоличествоКТКВДетализации Тогда
			СтрокиСОшибкамиВДетализации.Добавить(СтрокаПСЦ.НомерСтроки);
		КонецЕсли;
	КонецЦикла;
	
	СтрокиСОшибкамиВДетализации = ОбщегоНазначенияКлиентСервер.СвернутьМассив(СтрокиСОшибкамиВДетализации);
	СортироватьМассив(СтрокиСОшибкамиВДетализации);
	
	Если СтрокиСОшибкамиВДетализации.Количество() > 0 Тогда
		НомераСтрок = "";
		Для Каждого Номер Из СтрокиСОшибкамиВДетализации Цикл
			НомераСтрок = НомераСтрок + "№" + Номер + ", ";
		КонецЦикла;
		НомераСтрок = Лев(НомераСтрок, СтрДлина(НомераСтрок) - 2);
		Текст = СтрШаблон(НСтр("ru = 'Невозможно создать релиз собственника, количество учетных единиц в детализации по строке %1 больше чем указано в строке'"), 
			НомераСтрок);
		ОбщегоНазначения.СообщитьПользователю(Текст,,,, Отказ);
	КонецЕсли;
	
	СтрокиСОшибкамиКоличествоКТК0 = Новый Массив;
	Для Каждого СтрокаПСЦ Из ВыгрузкаСтрокиПСЦТекущие Цикл
		Если СтрокаПСЦ.КоличествоКТК = 0 Тогда
			СтрокиСОшибкамиКоличествоКТК0.Добавить(СтрокаПСЦ.НомерСтроки);
		КонецЕсли;
	КонецЦикла;
	
	СтрокиСОшибкамиКоличествоКТК0 = ОбщегоНазначенияКлиентСервер.СвернутьМассив(СтрокиСОшибкамиКоличествоКТК0);
	СортироватьМассив(СтрокиСОшибкамиКоличествоКТК0);
	
	Если СтрокиСОшибкамиКоличествоКТК0.Количество() > 0 Тогда
		НомераСтрок = "";
		Для Каждого Номер Из СтрокиСОшибкамиКоличествоКТК0 Цикл
			НомераСтрок = НомераСтрок + "№" + Номер + ", ";
		КонецЦикла;
		НомераСтрок = Лев(НомераСтрок, СтрДлина(НомераСтрок) - 2);
		Текст = СтрШаблон(НСтр("ru = 'Невозможно создать релиз собственника, т.к. количество КТК по строке %1 = 0'"), 
			НомераСтрок);
		ОбщегоНазначения.СообщитьПользователю(Текст,,,, Отказ);
	КонецЕсли;
	
	Возврат Отказ;
	
КонецФункции

