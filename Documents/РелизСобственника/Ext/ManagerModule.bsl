Процедура ДобавитьКонтейнеры(Данные, ДокументСсылка, ЗаписываемыеОбъекты)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РелизСобственника.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РелизСобственника КАК РелизСобственника
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	|		ПО РелизСобственника.Ссылка = РелизСобственникаНоминации.Ссылка
	|ГДЕ
	|	РелизСобственника.ПСЦ = &Документ
	|	И НЕ РелизСобственника.ПометкаУдаления
	|	И РелизСобственникаНоминации.ИдентификаторСтрокиПСЦПоставщика В(&ИдентификаторыСтрокУслуг)";
	
	Запрос.УстановитьПараметр("Документ", ДокументСсылка);
	Запрос.УстановитьПараметр("ИдентификаторыСтрокУслуг", Данные.ИдентификаторыСтрокУслуг);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		РелизОбъект = ЗаписываемыеОбъекты.Получить(Выборка.Ссылка);
		Если РелизОбъект = Неопределено Тогда
			РелизОбъект = Выборка.Ссылка.ПолучитьОбъект();
		КонецЕсли;
		Для Каждого СтрокаНоминации Из РелизОбъект.Номинации Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаНоминации.Контейнер) Тогда
				Для Каждого СтруктураКТК Из Данные.МассивКонтейнеров Цикл
					Если СтруктураКТК.ТипКТК = СтрокаНоминации.ТипКТК 
						И СтруктураКТК.ИдентификаторСтрокиУслуг = СтрокаНоминации.ИдентификаторСтрокиПСЦПоставщика Тогда
						СтрокаНоминации.Контейнер = СтруктураКТК.Контейнер;
						ИндексЗначенияМассива = Данные.МассивКонтейнеров.Найти(СтруктураКТК);
						Данные.МассивКонтейнеров.Удалить(ИндексЗначенияМассива);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		ЗаписываемыеОбъекты.Вставить(РелизОбъект.Ссылка, РелизОбъект);
	КонецЦикла;

