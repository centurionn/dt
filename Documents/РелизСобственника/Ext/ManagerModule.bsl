Функция КонтейнерыРелизаСобственника(РелизСобственника) Экспорт
	// Евросиб Фролов (06.12.2021 TASK№ №42618, РелизКлиента
	
	// Получим таблицу контейнеров релиза собственника с указанием релиза клиента
	// по каждому КТК.
		
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Номинации.Контейнер КАК Контейнер,
	|	Номинации.ТипКТК КАК ТипоразмерКТК,
	|	Номинации.тек_СобственностьКТК КАК тек_СобственностьКТК,
	|	Номинации.ДатаВзятия КАК ДатаВзятия,
	|	Номинации.Ссылка КАК РелизСобственника
	|ПОМЕСТИТЬ втНоминации
	|ИЗ
	|	Документ.РелизСобственника.Номинации КАК Номинации
	|ГДЕ
	|	Номинации.Ссылка = &РелизСобственника
	// Евросиб Фролов (14.03.2022 Ticket №0264362
	|	И Номинации.Контейнер <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
	|	И Номинации.ДатаВзятия <> ДАТАВРЕМЯ(1, 1, 1)
	// Евросиб Фролов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втНоминации.Контейнер КАК Контейнер,
	|	втНоминации.ТипоразмерКТК КАК ТипоразмерКТК,
	|	втНоминации.ДатаВзятия КАК ДатаВывоза,
	|	втНоминации.тек_СобственностьКТК КАК ВидСобственности,
	|	ЕСТЬNULL(РелизКлиентаКонтейнеры.Ссылка, ЗНАЧЕНИЕ(Документ.РелизКлиента.ПустаяСсылка)) КАК РелизКлиента
	|ИЗ
	|	втНоминации КАК втНоминации
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РелизКлиента.Контейнеры КАК РелизКлиентаКонтейнеры
	|		ПО втНоминации.РелизСобственника = РелизКлиентаКонтейнеры.Ссылка.РелизСобственника
	//ДИТ Шевченко А.В. US 62421 26.05.2023 -Начало
	|			И втНоминации.Контейнер = РелизКлиентаКонтейнеры.КлючАналитикиПеревозки.Контейнер";
	//ДИТ Шевченко А.В. US 62421 26.05.2023 -Конец
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("РелизСобственника", РелизСобственника);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Возврат РезультатЗапроса;
	
	// Евросиб Фролов)
КонецФункции

