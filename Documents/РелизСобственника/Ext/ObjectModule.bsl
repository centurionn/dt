		////++ Зубов US 33131 TA 43877 15.12.2021
		//	Если ЕстьНезаполненныеРеквизиты Тогда
		//		ТекстНезаполненныеРеквизитыТЧСтрока = ТекстНезаполненныеРеквизитыТЧСтрока+", ";
		//	КонецЕсли;
		//	ТекстНезаполненныеРеквизитыТЧСтрока = ТекстНезаполненныеРеквизитыТЧСтрока+"Ставка";
		//	ЕстьНезаполненныеРеквизиты = Истина;
		//КонецЕсли;
		//-- Зубов US 45162 TA 45703 21.01.2022
		Если НЕ ТекстНезаполненныеРеквизитыТЧСтрока = "" Тогда
			ТекстНезаполненныеРеквизитыТЧ = ТекстНезаполненныеРеквизитыТЧ+"По строке "+СтрокаНоминации.НомерСтроки+": "+ТекстНезаполненныеРеквизитыТЧСтрока+Символы.ПС;
		КонецЕсли;
	КонецЦикла; 
	
	Если НЕ ТекстНезаполненныеРеквизиты = "" Тогда
		Сообщить("В документе есть незаполненные реквизиты: "+ТекстНезаполненныеРеквизиты+". Проведение невозможно!");
	КонецЕсли;
	Если НЕ ТекстНезаполненныеРеквизитыТЧ = "" Тогда
		Сообщить("В табличной части документа есть незаполненные реквизиты. Проведение невозможно!");
		Сообщить(ТекстНезаполненныеРеквизитыТЧ);
	КонецЕсли;
	Возврат ЕстьНезаполненныеРеквизиты;
КонецФункции

