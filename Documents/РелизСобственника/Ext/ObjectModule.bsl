Функция ВписатьКТКВРелиз(МассивКТК) Экспорт
	
	Результат = Новый Соответствие;
	
	Для каждого Стр из МассивКТК Цикл
		
		НайдСтроки = Номинации.НайтиСтроки(Новый Структура("Контейнер", Стр.Ключ));
		Если НайдСтроки.Количество() = 0 Тогда
			
			Строки1Приоритета_МенеджерПлюсКлиент = Новый Массив;
			Строки2Приоритета_ТолькоКлиент = Новый Массив;
			Строки3Приоритета_МенеджерПустойКлиент = Новый Массив;
			Строки4Приоритета_ПустыеСтроки = Новый Массив;
			
			ТекМенеджер = Пользователи.ТекущийПользователь();
			
			Для каждого СтрНом из Номинации Цикл
				
				Если ЗначениеЗаполнено(СтрНом.Контейнер) Тогда Продолжить; КонецЕсли;
				
				Если СтрНом.НоминированныйМенеджер = ТекМенеджер И СтрНом.НоминированныйКлиент = Стр.Значение.Клиент Тогда
					Строки1Приоритета_МенеджерПлюсКлиент.Добавить(СтрНом);
				ИначеЕсли СтрНом.НоминированныйКлиент = Стр.Значение.Клиент Тогда
					Строки2Приоритета_ТолькоКлиент.Добавить(СтрНом);
				ИначеЕсли НЕ ЗначениеЗаполнено(СтрНом.НоминированныйКлиент) И СтрНом.НоминированныйМенеджер = ТекМенеджер Тогда
					Строки3Приоритета_МенеджерПустойКлиент.Добавить(СтрНом);
				ИначеЕсли НЕ ЗначениеЗаполнено(СтрНом.НоминированныйКлиент) И НЕ ЗначениеЗаполнено(СтрНом.НоминированныйМенеджер) Тогда
					Строки4Приоритета_ПустыеСтроки.Добавить(СтрНом);
				КонецЕсли;
				
			КонецЦикла;
			
			Если Строки1Приоритета_МенеджерПлюсКлиент.Количество() > 0 Тогда
				Строки1Приоритета_МенеджерПлюсКлиент[0].Контейнер = Стр.Ключ;
				Строки1Приоритета_МенеджерПлюсКлиент[0].ДатаАктуальностиЗаписи = ТекущаяДата();
				Результат.Вставить(Стр.Ключ, Ссылка);
			ИначеЕсли Строки2Приоритета_ТолькоКлиент.Количество() > 0 Тогда
				Строки2Приоритета_ТолькоКлиент[0].Контейнер = Стр.Ключ;
				Строки2Приоритета_ТолькоКлиент[0].ДатаАктуальностиЗаписи = ТекущаяДата();
				Результат.Вставить(Стр.Ключ, Ссылка);
			ИначеЕсли Строки3Приоритета_МенеджерПустойКлиент.Количество() > 0 Тогда
				Строки3Приоритета_МенеджерПустойКлиент[0].Контейнер = Стр.Ключ;
				Строки3Приоритета_МенеджерПустойКлиент[0].ДатаАктуальностиЗаписи = ТекущаяДата();
				Результат.Вставить(Стр.Ключ, Ссылка);
			ИначеЕсли Строки4Приоритета_ПустыеСтроки.Количество() > 0 Тогда
				Строки4Приоритета_ПустыеСтроки[0].Контейнер = Стр.Ключ;
				Строки4Приоритета_ПустыеСтроки[0].ДатаАктуальностиЗаписи = ТекущаяДата();
				Результат.Вставить(Стр.Ключ, Ссылка);
			Иначе
				Сообщить("По КТК " + Стр.Ключ + " нет слота в релизе! Релиз присвоен не будет!", СтатусСообщения.ОченьВажное);
			КонецЕсли;
			
		Иначе
			//++ Зубов Ticket#0249431 09.11.2021
			//НайдСтроки[0].ДатаАктуальностиЗаписи = ТекущаяДата();
			//Результат.Вставить(НайдСтроки[0].Контейнер, Ссылка);
			//-- Зубов Ticket#0249431 09.11.2021	
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

