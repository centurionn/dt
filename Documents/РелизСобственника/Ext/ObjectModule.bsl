Процедура АктуализироватьРелизКлиента(Отказ)
	
	// Евросиб Фролов (30.05.2022 Task №49741
	// Если запись инициирована из релиза клиента, то релиз клиента не обновляем.
	Если ДополнительныеСвойства.Свойство("ЗаписьИзРелизаКлиента") Тогда
		Возврат;
	КонецЕсли;	
	// Евросиб Фролов)
	
	// Евросиб Фролов (06.12.2021 TASK№ №42618, РелизКлиента
	
	// Перезаполняем и проводим релизы клиента (только если они не помечены на удаление).

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РелизКлиента.Ссылка КАК РелизКлиента,
	|	РелизКлиента.ЛокацияВыдачи КАК ЛокацияВыдачи,
	|	РелизКлиента.СтокВыдачи КАК СтокВыдачи,
	|	РелизКлиента.СобственникКТК КАК СобственникКТК,
	|	РелизКлиента.Заявка КАК Заявка,
	|	РелизКлиента.Контейнеры.(
	//|		Контейнер КАК Контейнер,
	|       КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
	|		ВидСобственности КАК ВидСобственности,
	//|		ДатаВывоза КАК ДатаВывоза,
	|		ИдентификаторСтроки КАК ИдентификаторСтроки,
	|		ТипоразмерКТК КАК ТипоразмерКТК
	|	) КАК Контейнеры
	|ИЗ
	|	Документ.РелизКлиента КАК РелизКлиента
	|ГДЕ
	|	РелизКлиента.РелизСобственника = &РелизСобственника
	|	И РелизКлиента.ПометкаУдаления = ЛОЖЬ";
		
	Запрос.УстановитьПараметр("РелизСобственника", Ссылка);
		
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ТаблицаНоминаций = Документы.РелизСобственника.КонтейнерыРелизаСобственника(Ссылка);
	
	Пока Выборка.Следующий() Цикл
		
	//ТаблицаКТКРелизаКлиента = Выборка.Контейнеры.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЗ.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	ТЗ.ВидСобственности КАК ВидСобственности,
		|	ТЗ.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	ТЗ.ТипоразмерКТК КАК ТипоразмерКТК
		|ПОМЕСТИТЬ ВТ_ТЗ
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТЗ.ВидСобственности КАК ВидСобственности,
		|	ВТ_ТЗ.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	ВТ_ТЗ.ТипоразмерКТК КАК ТипоразмерКТК,
		|	КлючиАналитикиПеревозкиМили.Ссылка.Контейнер КАК Контейнер,
		|	КлючиАналитикиПеревозкиМили.ДатаВыдачиКТКСТерминала КАК ДатаВывоза
		|ИЗ
		|	ВТ_ТЗ КАК ВТ_ТЗ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозкиМили
		|		ПО ВТ_ТЗ.КлючАналитикиПеревозки = КлючиАналитикиПеревозкиМили.Ссылка";
	Запрос.УстановитьПараметр("ТЗ",Выборка.Контейнеры.Выгрузить());
	ТаблицаКТКРелизаКлиента = Запрос.Выполнить().Выгрузить();
		
		ТаблицаКТКРелизаСобственника = ТаблицаКТКРелизаКлиента.СкопироватьКолонки();
		Для Каждого СтрокаКТК Из ТаблицаНоминаций Цикл
			Если СтрокаКТК.РелизКлиента = Выборка.РелизКлиента
				ИЛИ СтрокаКТК.РелизКлиента = Документы.РелизКлиента.ПустаяСсылка() Тогда
				ЗаполнитьЗначенияСвойств(ТаблицаКТКРелизаСобственника.Добавить(), СтрокаКТК);
			КонецЕсли;
		КонецЦикла;
		
		// ++ ДИТ_Агафонов_task 50388 24.06.2022
		//Убираем в коммент
		//ТаблицыИдентичны = ОбщегоНазначения.КоллекцииИдентичны(ТаблицаКТКРелизаКлиента, ТаблицаКТКРелизаСобственника, "Контейнер, ВидСобственности, ДатаВывоза");
		//Меняем на поиск только не соответсвий ВидСобственности 	
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ТаблицаКТКРелизаСобственника.Контейнер КАК Контейнер,
		               |	ТаблицаКТКРелизаСобственника.ВидСобственности КАК ВидСобственности
		               |ПОМЕСТИТЬ ТаблицаКТКРелизаСобственника
		               |ИЗ
		               |	&ТаблицаКТКРелизаСобственника КАК ТаблицаКТКРелизаСобственника
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ТаблицаКТКРелизаКлиента.Контейнер КАК Контейнер,
		               |	ТаблицаКТКРелизаКлиента.ВидСобственности КАК ВидСобственности
		               |ПОМЕСТИТЬ ТаблицаКТКРелизаКлиента
		               |ИЗ
		               |	&ТаблицаКТКРелизаКлиента КАК ТаблицаКТКРелизаКлиента
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ТаблицаКТКРелизаКлиента.Контейнер КАК Контейнер,
		               |	ТаблицаКТКРелизаКлиента.ВидСобственности КАК ВидСобственности,
		               |	ТаблицаКТКРелизаСобственника.Контейнер КАК Контейнер1,
		               |	ТаблицаКТКРелизаСобственника.ВидСобственности КАК ВидСобственности1
		               |ИЗ
		               |	ТаблицаКТКРелизаКлиента КАК ТаблицаКТКРелизаКлиента
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаКТКРелизаСобственника КАК ТаблицаКТКРелизаСобственника
		               |		ПО ТаблицаКТКРелизаКлиента.Контейнер = ТаблицаКТКРелизаСобственника.Контейнер
		               |ГДЕ
		               |	ТаблицаКТКРелизаКлиента.ВидСобственности <> ТаблицаКТКРелизаСобственника.ВидСобственности";
		
		Запрос.УстановитьПараметр("ТаблицаКТКРелизаКлиента", ТаблицаКТКРелизаКлиента);
		Запрос.УстановитьПараметр("ТаблицаКТКРелизаСобственника", ТаблицаКТКРелизаСобственника);
		
		Результат = Запрос.Выполнить();
		ТаблицыИдентичны = Результат.Пустой();
		//Дальше уже есть изменения в процедуре ЗаполнитьРелизКлиентаПоРелизуСобственника
		// -- ДИТ_Агафонов_task 50388 24.06.2022
		
		Если Контрагент <> Выборка.СобственникКТК
			// ++ ДИТ_Агафонов_task 50388 24.06.2022
			//Убираем в коммент, эти поля уже не обновляются в ЗаполнитьРелизКлиентаПоРелизуСобственника 
			//ИЛИ Сток <> Выборка.СтокВыдачи
			//ИЛИ Локация <> Выборка.ЛокацияВыдачи
			// -- ДИТ_Агафонов_task 50388 24.06.2022
			ИЛИ НЕ ТаблицыИдентичны Тогда
			
			// Евросиб Фролов (30.05.2022 Task №49741
			// Убрана проверка
			// Если в релизе клиента есть контейнеры, которые добавлены в заявку, но их нет в релизе собственника,
			// то такие контейнеры должны быть удалены в релизе клиента вручную.
			//ПроверитьКонтейнеры(ТаблицаКТКРелизаКлиента, ТаблицаКТКРелизаСобственника, Выборка.Заявка, Выборка.РелизКлиента, Отказ);
			// Евросиб Фролов)	
			Если Отказ Тогда
				Продолжить;
			КонецЕсли;	
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("Документ.РелизКлиента");
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Выборка.РелизКлиента);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Блокировка.Заблокировать();
			
			ДокументОбъект = Выборка.РелизКлиента.ПолучитьОбъект();
			Документы.РелизКлиента.ЗаполнитьРелизКлиентаПоРелизуСобственника(ДокументОбъект, ТаблицаКТКРелизаСобственника);			
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
			// В таблице значений "ТаблицаНоминаций" могут быть КТК без релиза клиента.
			// Такие строки будут привязаны к релизу клиента при первом проходе цикла.
			// Поэтому в строках, в которых не проставлен релиз клиента, заполним релиз клиента значением "Выборка.РелизКлиента"
			// (при втором и последующих проходах цикла строк с пустым релизом клиента не будет).
			СтрокиБезРелизаКлиента = ТаблицаНоминаций.НайтиСтроки(Новый Структура("РелизКлиента", Документы.РелизКлиента.ПустаяСсылка()));
			Для Каждого СтрокаБезРелизаКлиента Из СтрокиБезРелизаКлиента Цикл
				СтрокаБезРелизаКлиента.РелизКлиента = Выборка.РелизКлиента; 
			КонецЦикла;	
			
		КонецЕсли;	
	
	КонецЦикла;
	
	// Евросиб Фролов)
КонецПроцедуры

