	//КонецЕсли;
	// Евросиб Фролов)   
	
	// ДИТ US 76956 ТА 76966 Сержантова А.С. Начало: 02.11.2023
	Если Номинации.Количество() = 0 Тогда  
		Если ЕстьНезаполненныеРеквизиты Тогда
			ТекстНезаполненныеРеквизиты = ТекстНезаполненныеРеквизиты+", ";
		КонецЕсли;
		ТекстНезаполненныеРеквизиты = ТекстНезаполненныеРеквизиты+"таблица Номинации";
		ЕстьНезаполненныеРеквизиты = Истина;
	КонецЕсли;
	// ДИТ US 76956 ТА 76966 Сержантова А.С. Конец: 02.11.2023

	Для каждого СтрокаНоминации из Номинации Цикл
		ТекстНезаполненныеРеквизитыТЧСтрока = "";
		
		//Евросиб Коханенко Н.А. 22.05.2023 (( #70111
		Если НЕ СобственныеКТК Тогда
		//Евросиб Коханенко Н.А. 22.05.2023 )) #70111 
			
			//проверка незаполненности сроков возврата
			Если НЕ ЗначениеЗаполнено(СтрокаНоминации.НормативВозврата) Тогда
				Если ЕстьНезаполненныеРеквизиты Тогда
