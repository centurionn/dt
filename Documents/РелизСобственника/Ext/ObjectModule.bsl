Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	// исходный код в ПроверитьЗаполненностьРеквизитов со всеми комментариями
	
	// эти реквизиты проверяются признаком реквизита
	//ПроверяемыеРеквизиты.Добавить("НомерДокумента");
	//ПроверяемыеРеквизиты.Добавить("Контрагент");	
	//ПроверяемыеРеквизиты.Добавить("Номинации");
	//ПроверяемыеРеквизиты.Добавить("Номинации.ТипКТК");
	//ПроверяемыеРеквизиты.Добавить("Номинации.тек_СобственностьКТК");
	
	Если НЕ СобственныеКТК Тогда
		
		Если НЕ ЗначениеЗаполнено(НачалоДействия) ИЛИ НЕ ЗначениеЗаполнено(ОкончаниеДействия) Тогда 
			Отказ = Истина;
			ОбщегоНазначения.СообщитьПользователю("Не заполнено значение Период действия",,"ПериодДействия");
			Возврат;
		КонецЕсли;
		ПроверяемыеРеквизиты.Добавить("Локация");
		ПроверяемыеРеквизиты.Добавить("ЛокацияСдачи");
		ПроверяемыеРеквизиты.Добавить("Договор");
		
		ПроверяемыеРеквизиты.Добавить("Номинации.НормативВозврата");
		ПроверяемыеРеквизиты.Добавить("Номинации.Валюта");
		
		//проверка незаполненности ставки СНП
		Для Каждого СтрокаНоминации из Номинации Цикл
			ПОтбора = Новый Структура("ГУИДСтроки",СтрокаНоминации.ГУИДСтроки);
			СтрокиСНП = СНП.НайтиСтроки(ПОтбора);
			Если СтрокиСНП.Количество()= 0 Тогда
				ОбщегоНазначения.СообщитьПользователю("В строке " + СтрокаНоминации.НомерСтроки + " незаполнена ставка СНП",,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Номинации", СтрокаНоминации.НомерСтроки,"СНП"),"Объект",Отказ);
			КонецЕсли;
		КонецЦикла;
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	Иначе
	//Евросиб Ситников К.А. Task 113980 29.07.2025
	    ВалютаСНП = ПроверяемыеРеквизиты.Найти("Номинации.ВалютаСНП");
		ПроверяемыеРеквизиты.Удалить(ВалютаСНП);
	//Евросиб Ситников К.А. Task 113980 29.07.2025
    	ПроверяемыеРеквизиты.Добавить("Номинации.Контейнер");
	КонецЕсли;
	
	Отказ = ?(НЕ СобственныеКТК, ПроверитьНулевуюСтавку(), Отказ);
	

КонецПроцедуры 
