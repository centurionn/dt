		КонецЦикла;
	КонецЦикла;
	
	Для Каждого СтрокаВыгрузки Из ТаблицаСделок Цикл
		Если МассивКонтейнеров.Найти(СтрокаВыгрузки.Контейнер) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НайденныеСтроки = Номинации.НайтиСтроки(Новый Структура("Контейнер", СтрокаВыгрузки.Контейнер));
		Сделка = Неопределено;
		Для Каждого СтрокаНоминации Из НайденныеСтроки Цикл
			Сделка = ПодобратьСделку(СтрокаНоминации, ТаблицаСделок);
		КонецЦикла;
		Если Сделка <> Неопределено Тогда
			КлючАналитики = СтрокаНоминации.КлючАналитики.ПолучитьОбъект();
			СтатусПротокола = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПСЦ, "СтатусДокумента");
			Если ЗначениеЗаполнено(КлючАналитики.Калькуляция) 
				И СтатусПротокола = Перечисления.СтатусыСогласования.СогласованоБезЗамечаний
					Или СтатусПротокола = Перечисления.СтатусыСогласования.Подписано
					Или СтатусПротокола = Перечисления.СтатусыСогласования.СогласованСКомментариями Тогда
				СтрокаНоминации.допл_Сделка = Сделка.Сделка;
				Документы.РелизСобственника.ОбновитьРеквизитКлючаАналитики(КлючАналитики, 
							Новый Структура("Сделка, КлючАналитикиСоставаПоезда", Сделка.Сделка, Сделка.КлючАналитикиСоставаПоезда));
				ОтложенноеИзменениеСервер.ПоставитьСвязанныеОбъектыВОчередьИзменения(КлючАналитики);
			КонецЕсли;
		КонецЕсли;
		Индекс = МассивКонтейнеров.Найти(СтрокаВыгрузки.Контейнер);
		Если Индекс <> Неопределено Тогда
			МассивКонтейнеров.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // Евросиб Рыбьяков К.А. 13.05.2025 ))

Функция ПодобратьСделку(СтрокаНоминации, ТаблицаСделок) Экспорт
	
	ПодобраннаяСделка = Неопределено;
	
	ПодходящиеСделки = Новый Массив;
	
	// Шаг 1: Фильтрация сделок по КТК номинации
	ОтфильтрованныеСделки = Новый Массив;
	Для Каждого СтрокаСделки Из ТаблицаСделок Цикл
		Если СтрокаСделки.Контейнер = СтрокаНоминации.Контейнер Тогда
			ОтфильтрованныеСделки.Добавить(СтрокаСделки);
		КонецЕсли;
	КонецЦикла;
	
	// Шаг 2: Проверка пересечения периодов
	ПересекающиесяСделки = Новый Массив;
	Для Каждого Сделка Из ОтфильтрованныеСделки Цикл
		Если Сделка.ДатаОтправления <= СтрокаНоминации.ДатаВозвратаСобственнику 
			И Сделка.ДатаПрибытия >= СтрокаНоминации.ДатаВзятия Тогда
			ПересекающиесяСделки.Добавить(Сделка);
		КонецЕсли;
	КонецЦикла;
	
	// Шаг 3: Нет пересечений
	Если ПересекающиесяСделки.Количество() = 0 Тогда
		Возврат ПодобраннаяСделка; 
	КонецЕсли;
	
	// Шаг 4: Подбор подходящей сдлеки
	Для Каждого Сделка Из ПересекающиесяСделки Цикл
		СледующаяСделка = НайтиСледующуюСделку(Сделка, ОтфильтрованныеСделки);
		Если СледующаяСделка = Неопределено Тогда
			//ПодобраннаяСделка = Сделка;
			//Прервать;
			//Возврат Сделка;
			ПодходящиеСделки.Добавить(Сделка);
		ИначеЕсли СтрокаНоминации.ДатаВозвратаСобственнику <= СледующаяСделка.ДатаПрибытия 
				Или Не ЗначениеЗаполнено(СледующаяСделка.ДатаПрибытия) Тогда
			//ПодобраннаяСделка = Сделка;
			//Прервать;
			//Возврат Сделка;
			ПодходящиеСделки.Добавить(Сделка);
		//ИначеЕсли СтрокаНоминации.ДатаВозвратаСобственнику > СледующаяСделка.ДатаПрибытия 
		//	И СтрокаНоминации.ДатаВзятия <= СледующаяСделка.ДатаОтправления Тогда
		//	Прервать;
			//Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	
	// Шаг 5: Определение единственной подходящей сделки
	Если ПодходящиеСделки.Количество() = 1 Тогда
		ПодобраннаяСделка = ПодходящиеСделки[0];
		//Возврат ПодходящиеСделки[0];
	ИначеЕсли ПодходящиеСделки.Количество() > 1 Тогда
		// Проверяем, что все подходящая сделка не совпадает с 
		ПодобраннаяСделка = ПодходящиеСделки[0];
		Для i = 1 По ПодходящиеСделки.Количество() - 1 Цикл
			Если ПодобраннаяСделка.ДатаПрибытия = ПодходящиеСделки[i].ДатаПрибытия Тогда
				ПодобраннаяСделка = Неопределено;
				Прервать;
			КонецЕсли;
			//Если Не (ПерваяСделка.ДатаОтправления = ПодходящиеСделки[i].ДатаОтправления 
			//	И ПерваяСделка.ДатаПрибытия = ПодходящиеСделки[i].ДатаПрибытия) Тогда
			//	// Периоды разные - неоднозначность
			//	Возврат Неопределено;
			//КонецЕсли;
		КонецЦикла;
		//ПодобраннаяСделка = ПерваяСделка;
	КонецЕсли;
	
	Возврат ПодобраннаяСделка; 
	
КонецФункции

Функция НайтиСледующуюСделку(ТекущаяСделка, Сделки)
	
	МинимальнаяДата = Макс(ТекущаяСделка.ДатаОтправления, Дата(3999, 12, 31));
	СледующаяСделка = Неопределено;
	
	Для Каждого Сделка Из Сделки Цикл
		Если Сделка.ДатаПрибытия > ТекущаяСделка.ДатаПрибытия 
			И Сделка.ДатаОтправления < МинимальнаяДата Тогда
			МинимальнаяДата = Сделка.ДатаОтправления;
			СледующаяСделка = Сделка;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СледующаяСделка;
	
КонецФункции

Функция ПолучитьПараметрыКалькуляции(Калькуляция)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КалькуляцияСписокСтанцийНазначения.Ссылка КАК Калькуляция,
	|	КалькуляцияСписокСтанцийНазначения.Ссылка.СтавкаНДС КАК СтавкаНДС,
	|	КалькуляцияСписокСтанцийНазначения.Ссылка.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	КалькуляцияСписокСтанцийНазначения.Ссылка.Валюта КАК Валюта,
	//|	СУММА(КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Цена20) + КалькуляцияСписокСтанцийНазначения.Ссылка.ММ_Вознаграждение КАК Ставка20,
	//|	СУММА(КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Цена40) + КалькуляцияСписокСтанцийНазначения.Ссылка.ММ_Вознаграждение40 КАК Ставка40,
	|	КалькуляцияСписокСтанцийНазначения.Ссылка.ТарифицируемыйРазмерКТК КАК ТарифицируемыйРазмерКТК,
	|	КалькуляцияСписокСтанцийНазначения.Ссылка.ММ_ИтогоВознаграждение КАК Ставка40,
	|	КалькуляцияСписокСтанцийНазначения.Ссылка.ММ_ИтогоВознаграждение20 КАК Ставка20
	|ИЗ
	|	Документ.Калькуляция.СписокСтанцийНазначения КАК КалькуляцияСписокСтанцийНазначения
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Калькуляция.ММ_КалькуляцияМультимодальнойЦепочки КАК КалькуляцияММ_КалькуляцияМультимодальнойЦепочки
	|		ПО КалькуляцияСписокСтанцийНазначения.Ссылка = КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка
	|ГДЕ
	|	КалькуляцияСписокСтанцийНазначения.Ссылка В (&Калькуляция)
	|
	|СГРУППИРОВАТЬ ПО
	|	КалькуляцияСписокСтанцийНазначения.Ссылка,
	|	КалькуляцияСписокСтанцийНазначения.Ссылка.СтавкаНДС,
	|	КалькуляцияСписокСтанцийНазначения.Ссылка.СуммаВключаетНДС,
	|	КалькуляцияСписокСтанцийНазначения.Ссылка.Валюта,
	|	КалькуляцияСписокСтанцийНазначения.Станция,
	|	КалькуляцияСписокСтанцийНазначения.Ссылка.ТарифицируемыйРазмерКТК,
	|	КалькуляцияСписокСтанцийНазначения.Ссылка.ММ_ИтогоВознаграждение,
	|	КалькуляцияСписокСтанцийНазначения.Ссылка.ММ_ИтогоВознаграждение20";
	
	Запрос.УстановитьПараметр("Калькуляция", Калькуляция);
	
	Выгрузка = Запрос.Выполнить().Выгрузить();
	
	ДанныеКалькуляции = Новый Структура;
	ДанныеКалькуляции.Вставить("Калькуляция", Документы.Калькуляция.ПустаяСсылка());
	ДанныеКалькуляции.Вставить("СтавкаНДС", Перечисления.СтавкиНДС.ПустаяСсылка());
	ДанныеКалькуляции.Вставить("СуммаВключаетНДС", Ложь);
	ДанныеКалькуляции.Вставить("Валюта", Справочники.Валюты.ПустаяСсылка());
	ДанныеКалькуляции.Вставить("Ставка20", 0);
	ДанныеКалькуляции.Вставить("Ставка40", 0);
	
	Для Каждого Строка Из Выгрузка Цикл
		ДанныеКалькуляции = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Строка);
	КонецЦикла;
	
	Возврат ДанныеКалькуляции;
	
КонецФункции

Функция ПолучитьКлючАналитикиСоставаПоезда(Сделка, Контейнер)
	
	КлючАналитикиСоставаПоезда = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СделкаСвязьУчетныхЕдиниц.КлючАналитикиСоставаПоезда КАК КлючАналитикиСоставаПоезда
	|ИЗ
	|	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|ГДЕ
	|	СделкаСвязьУчетныхЕдиниц.Контейнер = &Контейнер
	|	И СделкаСвязьУчетныхЕдиниц.Ссылка = &Сделка";
	
	Запрос.УстановитьПараметр("Контейнер", Контейнер);
	Запрос.УстановитьПараметр("Сделка", Сделка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		КлючАналитикиСоставаПоезда = ВыборкаДетальныеЗаписи.КлючАналитикиСоставаПоезда;
	КонецЦикла;
	
	Возврат КлючАналитикиСоставаПоезда;
	
КонецФункции


