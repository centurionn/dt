Функция ПроверитьНулевуюСтавку()
	ЕстьОшибки = Ложь;
	
		Для каждого Стр из Номинации Цикл
			Если Стр.тек_СобственностьКТК = Перечисления.ВариантыСобственности.Спот Тогда
				Если Стр.Ставка = 0 И НЕ Стр.НулеваяСтавка Тогда
					ЕстьОшибки = Истина;
					//Евросиб СубботинВ #102567 18.02.2025 Начало
					//Сообщить("По строке "+Стр.НомерСтроки+" заполните значение Ставки или проставьте признак Ставка = 0");
					ОбщегоНазначения.СообщитьПользователю("По строке "+Стр.НомерСтроки+" заполните значение Ставки или проставьте признак Ставка = 0",,
					ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Номинации", Стр.НомерСтроки,"Ставка"),"Объект");
					//Евросиб СубботинВ #102567 18.02.2025 Конец
				КонецЕсли;
			Иначе
				Если Стр.Ставка = 0 Тогда
					ЕстьОшибки = Истина;
					//Евросиб СубботинВ #102567 18.02.2025 Начало
					//Сообщить("По строке "+Стр.НомерСтроки+" заполните значение Ставки");
					ОбщегоНазначения.СообщитьПользователю("По строке "+Стр.НомерСтроки+" заполните значение Ставки",,
					ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Номинации", Стр.НомерСтроки,"Ставка"),"Объект");
					//Евросиб СубботинВ #102567 18.02.2025 Конец
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

	Возврат ЕстьОшибки;
КонецФункции
