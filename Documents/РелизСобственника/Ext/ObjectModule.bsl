Функция ПолучитьСтатусКТК(Контейнер,ДатаАктуальности)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	стоки_ТекущиеДанныеСрезПоследних.тек_Статус КАК тек_Статус
		|ИЗ
		|	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних(&ДатаАктуальности, КТК = &Контейнер) КАК стоки_ТекущиеДанныеСрезПоследних";
	
	Запрос.УстановитьПараметр("ДатаАктуальности", ДатаАктуальности);
	Запрос.УстановитьПараметр("Контейнер", Контейнер);
	
	РезультатЗапроса = Запрос.Выполнить();  
	
	// Евросиб(ДИТ) BUG 99736 ТА 99737 Сержантова А.С. Начало: 21.01.2025
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Истина;
	КонецЕсли;
	// Евросиб(ДИТ) BUG 99736 ТА 99737 Сержантова А.С. Конец: 21.01.2025
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.тек_Статус = Перечисления.СтатусыКТК.Возвращен ИЛИ НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.тек_Статус);
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции 

