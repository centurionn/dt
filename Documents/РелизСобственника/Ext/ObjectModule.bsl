			ЕстьНезаполненныеРеквизиты = Истина;
		КонецЕсли;
		//Если НЕ ЗначениеЗаполнено(ОкончаниеДействия) Тогда
		//	Если ЕстьНезаполненныеРеквизиты Тогда
		//		ТекстНезаполненныеРеквизиты = ТекстНезаполненныеРеквизиты+", ";
		//	КонецЕсли;
		//	ТекстНезаполненныеРеквизиты = ТекстНезаполненныеРеквизиты+"Период действия";
		//	ЕстьНезаполненныеРеквизиты = Истина;
		//КонецЕсли;
