		//Евросиб Коханенко Н.А. 22.05.2023 (( #70111 
		КонецЕсли;
		//Евросиб Коханенко Н.А. 22.05.2023 )) #70111 
	
		Если НЕ ЗначениеЗаполнено(СтрокаНоминации.ТипКТК) Тогда
			Если ЕстьНезаполненныеРеквизиты Тогда
				ТекстНезаполненныеРеквизитыТЧСтрока = ТекстНезаполненныеРеквизитыТЧСтрока+", ";
