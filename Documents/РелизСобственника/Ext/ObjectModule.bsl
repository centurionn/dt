			ТекстНезаполненныеРеквизиты = ТекстНезаполненныеРеквизиты+"Страна сдачи";
			//ДИТ Шевченко А.В. US 98893 ТА 100521 03.02.2025
			ЕстьНезаполненныеРеквизиты = Истина;
		КонецЕсли;
