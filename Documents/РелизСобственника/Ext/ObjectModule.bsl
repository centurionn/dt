	ТекстНезаполненныеРеквизиты = "";
	ТекстНезаполненныеРеквизитыТЧ = "";
	ЕстьНезаполненныеРеквизиты = Ложь;
	
	//Евросиб Коханенко Н.А. 19.05.2023 (( #70111
	Если НЕ СобственныеКТК Тогда
