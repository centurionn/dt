Процедура ПриЗаписи(Отказ)
	Если Не Отказ Тогда
		МассивКонтейнеров = Номинации.ВыгрузитьКолонку("Контейнер");
		РаботаСКонтейнерамиСервер.ДобавитьИнформациюОбИсточникеСозднияКонтейнеров(МассивКонтейнеров, Ссылка); 
		//Евросиб Коханенко Н.А. 02.04.2024 (( #80513 
		//ЗаполнитьРегистрСвязанныеОбъектыПоРелизуСобственника(); // Рыбьяков К.А. Перенес в общий модуль СвязанныеДокументыСервер
		//Евросиб Коханенко Н.А. 02.04.2024 )) #80513 
		//Евросиб СубботинВ #131884 02.03.2026 Начало
		Если ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ 
			|	РелизСобственникаИзменения.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.РелизСобственника.Изменения КАК РелизСобственникаИзменения
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
			|		ПО РелизСобственникаИзменения.Ссылка = ПротоколОбменов.Объект
			|			И (ПротоколОбменов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных))
			|			И (ПротоколОбменов.УзелОбмена = &УзелОбмена)
			|			И (ПротоколОбменов.ЗагрузкаПодтверждена)
			|ГДЕ 
			|	РелизСобственникаИзменения.Ссылка = &Ссылка
			|		И ВЫБОР
			|			КОГДА ЕСТЬNULL(ПротоколОбменов.ЗагрузкаПодтверждена, ЛОЖЬ) = Истина
			|				ТОГДА РелизСобственникаИзменения.Ссылка.Проведен
			|			ИНАЧЕ ИСТИНА
			|		КОНЕЦ";
			
			Запрос.УстановитьПараметр("УзелОбмена", Перечисления.УзлыОбмена.DX);
			Запрос.УстановитьПараметр("Ссылка", Ссылка);
			РезультатЗапроса = Запрос.Выполнить();			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда				
				ПланыОбмена.ВыгрузкаДанных.УдалитьРегистрациюИзменений(Ссылка, Перечисления.УзлыОбмена.DX); 
			КонецЕсли;
		ИначеЕсли ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда			
			// Евросиб(ДИТ) US 86002 ТА 87080 Сержантова А.С. Начало: 29.07.2024  
			ПланыОбмена.ВыгрузкаДанных.ЗарегистрироватьИзмененияПоДокументу(Ссылка, Перечисления.УзлыОбмена.DX);
			// Евросиб(ДИТ) US 86002 ТА 87080 Сержантова А.С. Конец: 29.07.2024
			//Евросиб СубботинВ #131884 02.03.2026 Начало
		КонецЕсли;
		//Евросиб СубботинВ #131884 02.03.2026 Конец

		// Евросиб US 114211 TA 114223 Рыбьяков К.А. 14.07.2025 ((
		Для Каждого СтрокаНоминации Из Номинации Цикл
			РеквизитыКлюча = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаНоминации.КлючАналитики, "Контейнер, РелизСобственника");
			Если СтрокаНоминации.Контейнер <> РеквизитыКлюча.Контейнер 
				Или Ссылка <> РеквизитыКлюча.РелизСобственника Тогда
				Параметры = Новый Структура;
				Параметры.Вставить("РелизСобственника", Ссылка);
				Параметры.Вставить("Контейнер", СтрокаНоминации.Контейнер);
				КлючАналитикиОбъект = СтрокаНоминации.КлючАналитики.ПолучитьОбъект();
				Документы.РелизСобственника.ОбновитьРеквизитКлючаАналитики(КлючАналитикиОбъект, Параметры);
			КонецЕсли;
		КонецЦикла;
		// Евросиб Рыбьяков К.А. 14.07.2025 ))
	КонецЕсли;
	
	// Евросиб US 95138 TA 89887 Рыбьяков К.А. 14.11.2024 ((
	РеквизитыРелиза = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "ПСЦ, ПометкаУдаления");
	Если ТипЗнч(РеквизитыРелиза.ПСЦ) = Тип("ДокументСсылка.ПСЦПоставщика")
		И РеквизитыРелиза.ПометкаУдаления Тогда
		СвязанныеДокументыСервер.УдалитьСвязи(РеквизитыРелиза.ПСЦ, Ссылка);
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 14.11.2024 ))
	
	//Евросиб(ДИТ), Беляев СЮ, BUG 97038 / TA 97047, 06-12-2024, начало
	ЗаписатьДатыИзготовленияКТКвКонтейнеры();
	//Евросиб(ДИТ), Беляев СЮ, BUG 97038 / TA 97047, 06-12-2024, конец
	
КонецПроцедуры
