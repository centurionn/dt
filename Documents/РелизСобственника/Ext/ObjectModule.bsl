	//Евросиб Коханенко Н.А. 19.05.2023 (( #70111
	КонецЕсли;
	//Евросиб Коханенко Н.А. 19.05.2023 )) #70111
	
	Если НЕ ЗначениеЗаполнено(НомерДокумента) Тогда
		//ДИТ Шевченко А.В. US 98893 ТА 100521 03.02.2025
		Если ЕстьНезаполненныеРеквизиты Тогда
			ТекстНезаполненныеРеквизиты = ТекстНезаполненныеРеквизиты+", ";
