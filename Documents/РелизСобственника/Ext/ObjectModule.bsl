//Евросиб(ДИТ), Беляев СЮ, BUG 97038 / TA 97047, 06-12-2024, начало
Процедура ЗаписатьДатыИзготовленияКТКвКонтейнеры()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номинации.Контейнер КАК Контейнер,
		|	Номинации.ДатаИзготовленияКТК КАК ДатаИзготовленияКТК
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&Номинации КАК Номинации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Контейнер КАК Контейнер,
		|	ВТ.ДатаИзготовленияКТК КАК ДатаИзготовленияКТК
		|ИЗ
		|	ВТ КАК ВТ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТЕ КАК ТЕ
		|		ПО ВТ.Контейнер = ТЕ.Ссылка
		|			И ВТ.ДатаИзготовленияКТК <> ТЕ.ДатаИзготовленияКТК
		|ГДЕ
		|	ВТ.Контейнер <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
		|	И ВТ.ДатаИзготовленияКТК <> ДАТАВРЕМЯ(1, 1, 1)";
	
	Запрос.УстановитьПараметр("Номинации", Номинации.Выгрузить(,"Контейнер,ДатаИзготовленияКТК"));
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СправочникКонтейнер = ВыборкаДетальныеЗаписи.Контейнер.ПолучитьОбъект();
		СправочникКонтейнер.ДатаИзготовленияКТК = ВыборкаДетальныеЗаписи.ДатаИзготовленияКТК;
		СправочникКонтейнер.УстановитьКомментарийВерсииИсторииДанных("Запись из Релиза собственника "+Номер + " от "+Дата);
		СправочникКонтейнер.Записать();
		
	КонецЦикла;
	
КонецПроцедуры
