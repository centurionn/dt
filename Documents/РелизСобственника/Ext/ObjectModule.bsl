Процедура ПроверитьСостояния(МаршрутизацияЗаново = Ложь) Экспорт
	
	Если МаршрутизацияЗаново Тогда
		Для каждого СтрокаНоминация Из Номинации Цикл
			Если СтрокаНоминация.РелизКлиентаНеСовпадаетТипоразмерКТК Тогда
				РелизКлиентаНеСовпадаетТипоразмерКТК_Выполнено = Ложь;
			КонецЕсли;
			Если СтрокаНоминация.РелизКлиентаНоваяЗаписьКТК Тогда
				РелизКлиентаНоваяЗаписьКТК_Выполнено = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	//Нам нужно не стандарт для маршрутов - возвращать или отменять задачи
	СтрокаКорректировка = Состояния.Найти(Справочники.Состояния.КорректировкаТипоразмераКТК,"Состояние");	
	Если СтрокаКорректировка <> Неопределено Тогда
	СтрокаКорректировка.Комментарий = "Обнаружено несоответствие типоразмера КТК при сравнении данных из сообщений CODECO c данными DC";	
	Если КолвоРелизКлиентаНеСовпадаетТипоразмерКТК=0 Тогда
		//Значит задача не нужна
		Если не СтрокаКорректировка.Статус=Перечисления.СтатусыЭтапов.Выполнен 
			и не СтрокаКорректировка.Статус=Перечисления.СтатусыЭтапов.Отклонен 
			Тогда
			СтрокаКорректировка.Статус = Перечисления.СтатусыЭтапов.Отклонен;
			СтрокаКорректировка.ПричинаОтказа = "Нет новых записей на проверку типоразмера КТК";
			СтрокаКорректировка.ЗавершениеРаботы = ТекущаяДата();
		КонецЕсли;
	ИначеЕсли КолвоРелизКлиентаНеСовпадаетТипоразмерКТК>Ссылка.КолвоРелизКлиентаНеСовпадаетТипоразмерКТК 
		и (СтрокаКорректировка.Статус=Перечисления.СтатусыЭтапов.Выполнен
		или СтрокаКорректировка.Статус=Перечисления.СтатусыЭтапов.Отклонен)
		Тогда
		СтрокаКорректировка.Статус = ПримененныйМаршрут.НачальныйСтатус;
		СтрокаКорректировка.НачалоРаботы = ТекущаяДата();
		СтрокаКорректировка.ЗавершениеРаботы = Дата(1,1,1);
	ИначеЕсли (СтрокаКорректировка.Статус=Перечисления.СтатусыЭтапов.Выполнен
		или СтрокаКорректировка.Статус=Перечисления.СтатусыЭтапов.Отклонен) Тогда
		Для каждого СтрокаНоминация Из Номинации Цикл
			Если СтрокаНоминация.РелизКлиентаНеСовпадаетТипоразмерКТК Тогда
				СтрокаНоминация.РелизКлиентаНеСовпадаетТипоразмерКТК_Выполнено = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	КонецЕсли;
	СтрокаКорректировка = Состояния.Найти(Справочники.Состояния.КорректировкаКоличестваКТК,"Состояние");	
	Если СтрокаКорректировка <>Неопределено Тогда
	СтрокаКорректировка.Комментарий = "В релиз собственника добавлены доп. строки с КТК из связанного релиза клиента. Необходимо уменьшить общее количество строк в релизе собственника либо принять текущее значение, а также проверить необходимость согласования изменения условий аренды КТК и корректировки связанных документов";	
	Если КолвоРелизКлиентаНоваяЗаписьКТК=0 Тогда
		//Значит задача не нужна
		Если не СтрокаКорректировка.Статус=Перечисления.СтатусыЭтапов.Выполнен 
			и не СтрокаКорректировка.Статус=Перечисления.СтатусыЭтапов.Отклонен 
			Тогда
			СтрокаКорректировка.Статус = Перечисления.СтатусыЭтапов.Отклонен;
			СтрокаКорректировка.ПричинаОтказа = "Нет новых записей КТК на проверку";
			СтрокаКорректировка.ЗавершениеРаботы = ТекущаяДата();
		КонецЕсли;
	ИначеЕсли КолвоРелизКлиентаНоваяЗаписьКТК>Ссылка.КолвоРелизКлиентаНоваяЗаписьКТК 
		и (СтрокаКорректировка.Статус=Перечисления.СтатусыЭтапов.Выполнен
		или СтрокаКорректировка.Статус=Перечисления.СтатусыЭтапов.Отклонен)
		//Значит задачу нужно вернуть
		Тогда
		СтрокаКорректировка.Статус = ПримененныйМаршрут.НачальныйСтатус;
		СтрокаКорректировка.НачалоРаботы = ТекущаяДата();
		СтрокаКорректировка.ЗавершениеРаботы = Дата(1,1,1);
	ИначеЕсли (СтрокаКорректировка.Статус=Перечисления.СтатусыЭтапов.Выполнен
		или СтрокаКорректировка.Статус=Перечисления.СтатусыЭтапов.Отклонен) Тогда
		Для каждого СтрокаНоминация Из Номинации Цикл
			Если СтрокаНоминация.РелизКлиентаНоваяЗаписьКТК Тогда
				СтрокаНоминация.РелизКлиентаНоваяЗаписьКТК_Выполнено = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	КонецЕсли;
	//Нам нужно не стандартн для маршрутов возвращать или отменять задачи
КонецПроцедуры
//-- Зубов US 33131 TA 43877 16.12.2021   

Функция ПолучитьСтрокиБезКТКИДатыВзятия(ТипКТК) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РелизСобственникаНоминации.ГУИДСтроки КАК ГУИДСтроки
	|ПОМЕСТИТЬ ВТ_РелизСобственникаНоминации
	|ИЗ
	|	&РелизСобственникаНоминации КАК РелизСобственникаНоминации
	|ГДЕ
	|	РелизСобственникаНоминации.Контейнер = ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
	|	И РелизСобственникаНоминации.ТипКТК = &ТипКТК
	|	И РелизСобственникаНоминации.ДатаВзятия = ДАТАВРЕМЯ(1, 1, 1)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_РелизСобственникаНоминации.ГуидСтроки КАК ГуидСтроки
	|ИЗ
	|	ВТ_РелизСобственникаНоминации КАК ВТ_РелизСобственникаНоминации";
	Запрос.УстановитьПараметр("ТипКТК", ТипКТК);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	МассивСтрокНоминаций = Новый Массив;
	Пока Выборка.Следующий() Цикл
		СтрокаНоминации = Номинации.Найти(Выборка.ГУИДСтроки);
		МассивСтрокНоминаций.Добавить(СтрокаНоминации);
	КонецЦикла;                                        
	Возврат МассивСтрокНоминаций;
	
КонецФункции
