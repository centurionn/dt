Процедура ОчиститьЗаписиУдаленныхСтрок()
	Отказ = Ложь;
	МассивКТК = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	стоки_ТекущиеДанныеСрезПоследних.ПорядковыйНомерЦиклаАрендыКТК КАК ПорядковыйНомерЦиклаАрендыКТК,
		|	стоки_ТекущиеДанныеСрезПоследних.КТК КАК КТК
		|ПОМЕСТИТЬ НомерЦикла
		|ИЗ
		|	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних(
		|			&Дата,
		|			тек_Релиз = &Релиз
		|				И НЕ КТК В (&СписокКТК)) КАК стоки_ТекущиеДанныеСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	стоки_ТекущиеДанные.ГУИДЗаписи КАК ГУИДЗаписи,
		|	НомерЦикла.КТК КАК КТК,
		|	стоки_ТекущиеДанные.ИсточникЗаписи КАК ИсточникЗаписи
		|ИЗ
		|	НомерЦикла КАК НомерЦикла
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.стоки_ТекущиеДанные КАК стоки_ТекущиеДанные
		|		ПО НомерЦикла.КТК = стоки_ТекущиеДанные.КТК
		|			И НомерЦикла.ПорядковыйНомерЦиклаАрендыКТК = стоки_ТекущиеДанные.ПорядковыйНомерЦиклаАрендыКТК
		|ГДЕ
		//ДИТ Авдеева В.С. 53975 16.08.2022 Начало 
		|	стоки_ТекущиеДанные.Период >= &ДатаНачалаДействияРелиза И
		//ДИТ Авдеева В.С. 53975 16.08.2022 Конец 
		//|	стоки_ТекущиеДанные.ИсточникЗаписи ПОДОБНО ""%Заявка%""";
		//ДИТ, Беляев СЮ, Ticket#0323876, 11-09-2023, начало
		|	стоки_ТекущиеДанные.ИсточникЗаписи ПОДОБНО ""Заявка %""";
		//ДИТ, Беляев СЮ, Ticket#0323876, 11-09-2023, конец
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("Релиз", Ссылка);
	Запрос.УстановитьПараметр("СписокКТК", Номинации.ВыгрузитьКолонку("Контейнер"));
	//ДИТ Авдеева В.С. 53975 16.08.2022 Начало 
	Запрос.УстановитьПараметр("ДатаНачалаДействияРелиза", НачалоДействия);
	//ДИТ Авдеева В.С. 53975 16.08.2022 Конец 
	
	РезультатЗапроса = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса[1].Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Сообщить("КТК "+ВыборкаДетальныеЗаписи.КТК+" выдан клиенту по "+ВыборкаДетальныеЗаписи.ИсточникЗаписи+". Отмена проведения невозможна.");
			Отказ = Истина;
	КонецЦикла;
	
	Если НЕ Отказ Тогда
		ВыборкаКТК = РезультатЗапроса[0].Выбрать();
		Пока ВыборкаКТК.Следующий() Цикл
			МассивКТК.Добавить(ВыборкаКТК.КТК);
		КонецЦикла;  
		//Евросиб(ДИТ) Антонова А.С. US 77172 ТА 103142 Начало 12.03.2025
		ЭтотОбъект.ДополнительныеСвойства.Вставить("УдаленныеКТК", МассивКТК); 
		//Евросиб(ДИТ) Антонова А.С. US 77172 ТА 103142 Конец 12.03.2025
		МассивПериодов = Новый Массив;
		Для каждого ЭлементМассива из МассивКТК Цикл
			СтокиТекущиеДанные = РегистрыСведений.стоки_ТекущиеДанные.СоздатьНаборЗаписей();
			СтокиТекущиеДанные.Отбор.КТК.Установить(ЭлементМассива);
			СтокиТекущиеДанные.Прочитать();			
			МассивСтрокКУдалению = Новый Массив;
			Для каждого ЗаписьСтокиТекущиеДанные из СтокиТекущиеДанные Цикл
				Если ЗаписьСтокиТекущиеДанные.тек_Релиз = Ссылка Тогда
					МассивПериодов.Добавить(ЗаписьСтокиТекущиеДанные.Период);
					МассивСтрокКУдалению.Добавить(ЗаписьСтокиТекущиеДанные);
				КонецЕсли;
			КонецЦикла;
			Для каждого СтрокаКУдалению из МассивСтрокКУдалению Цикл
				СтокиТекущиеДанные.Удалить(СтрокаКУдалению);
			КонецЦикла;
			СтокиТекущиеДанные.Записать();
		КонецЦикла;
		МассивГУИД = Новый Массив;	
		Для каждого ЭлементПериодов из МассивПериодов Цикл
			КлиентскоеОперирование = РегистрыСведений.стоки_КлиентскоеОперирование.СоздатьНаборЗаписей();
			КлиентскоеОперирование.Отбор.Период.Установить(ЭлементПериодов);
			КлиентскоеОперирование.Прочитать();
			Для каждого ЗаписьКлиентскоеОперирование из КлиентскоеОперирование Цикл
				МассивГУИД.Добавить(ЗаписьКлиентскоеОперирование.ГУИДЗаписи);
			КонецЦикла;
			КлиентскоеОперирование.Очистить();
			КлиентскоеОперирование.Записать();
		КонецЦикла;
		Для каждого ГУИД из МассивГУИД Цикл
			СтокиТекущиеДанныеСНП = РегистрыСведений.стоки_ТекущиеДанные_СНП.СоздатьНаборЗаписей();
			СтокиТекущиеДанныеСНП.Отбор.ГУИДЗаписи.Установить(ГУИД);
			СтокиТекущиеДанныеСНП.Очистить();
			СтокиТекущиеДанныеСНП.Записать();
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры
