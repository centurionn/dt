Функция ПроверкаПередУстановкойПометкиУдаления()
	
	ПометкаУдаленияЗапрещена = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СвязанныеОбъекты.Ссылка КАК Ссылка,
		|	ТИПЗНАЧЕНИЯ(СвязанныеОбъекты.Ссылка) КАК ТипСвязанногоДокумента,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(СвязанныеОбъекты.Ссылка) = ЗНАЧЕНИЕ(Документ.Акцепт)
		|			ТОГДА ВЫРАЗИТЬ(СвязанныеОбъекты.Ссылка КАК Документ.Акцепт).Дата
		|		КОГДА ТИПЗНАЧЕНИЯ(СвязанныеОбъекты.Ссылка) = ЗНАЧЕНИЕ(Документ.Заявка)
		|			ТОГДА ВЫРАЗИТЬ(СвязанныеОбъекты.Ссылка КАК Документ.Заявка).Дата
		|		КОГДА ТИПЗНАЧЕНИЯ(СвязанныеОбъекты.Ссылка) = ЗНАЧЕНИЕ(Документ.ПоступлениеТоваровУслуг)
		|			ТОГДА ВЫРАЗИТЬ(СвязанныеОбъекты.Ссылка КАК Документ.ПоступлениеТоваровУслуг).Дата
		|		КОГДА ТИПЗНАЧЕНИЯ(СвязанныеОбъекты.Ссылка) = ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг)
		|			ТОГДА ВЫРАЗИТЬ(СвязанныеОбъекты.Ссылка КАК Документ.РеализацияТоваровУслуг).Дата
		|		КОГДА ТИПЗНАЧЕНИЯ(СвязанныеОбъекты.Ссылка) = ЗНАЧЕНИЕ(Документ.СчетНаОплатуПокупателю)
		|			ТОГДА ВЫРАЗИТЬ(СвязанныеОбъекты.Ссылка КАК Документ.СчетНаОплатуПокупателю).Дата
		|	КОНЕЦ КАК Дата,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(СвязанныеОбъекты.Ссылка) = ЗНАЧЕНИЕ(Документ.Акцепт)
		|			ТОГДА ВЫРАЗИТЬ(СвязанныеОбъекты.Ссылка КАК Документ.Акцепт).Номер
		|		КОГДА ТИПЗНАЧЕНИЯ(СвязанныеОбъекты.Ссылка) = ЗНАЧЕНИЕ(Документ.Заявка)
		|			ТОГДА ВЫРАЗИТЬ(СвязанныеОбъекты.Ссылка КАК Документ.Заявка).Номер
		|		КОГДА ТИПЗНАЧЕНИЯ(СвязанныеОбъекты.Ссылка) = ЗНАЧЕНИЕ(Документ.ПоступлениеТоваровУслуг)
		|			ТОГДА ВЫРАЗИТЬ(СвязанныеОбъекты.Ссылка КАК Документ.ПоступлениеТоваровУслуг).Номер
		|		КОГДА ТИПЗНАЧЕНИЯ(СвязанныеОбъекты.Ссылка) = ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг)
		|			ТОГДА ВЫРАЗИТЬ(СвязанныеОбъекты.Ссылка КАК Документ.РеализацияТоваровУслуг).Номер
		|		КОГДА ТИПЗНАЧЕНИЯ(СвязанныеОбъекты.Ссылка) = ЗНАЧЕНИЕ(Документ.СчетНаОплатуПокупателю)
		|			ТОГДА ВЫРАЗИТЬ(СвязанныеОбъекты.Ссылка КАК Документ.СчетНаОплатуПокупателю).Номер
		|	КОНЕЦ КАК Номер
		|ИЗ
		|	РегистрСведений.СвязанныеОбъекты КАК СвязанныеОбъекты
		|ГДЕ
		|	СвязанныеОбъекты.Основание = &РелизСобственника
		|	И ВЫБОР
		|			КОГДА ТИПЗНАЧЕНИЯ(СвязанныеОбъекты.Ссылка) = ЗНАЧЕНИЕ(Документ.Акцепт)
		|				ТОГДА ВЫРАЗИТЬ(СвязанныеОбъекты.Ссылка КАК Документ.Акцепт).Проведен
		//Евросиб Коханенко Н.А. 26.05.2025 (( #110274 
		//Акцепт должен быть не только проведен, но и связанные с ним ПТУ/КоррПТУ не должны иметь пометки на удаление. 
		//Тогда запрет удаления релиза активен.
		|					И НЕ Выразить(СвязанныеОбъекты.Ссылка КАК Документ.Акцепт).Поступление.ПометкаУдаления
		//Евросиб Коханенко Н.А. 26.05.2025 )) #110274
		|			КОГДА ТИПЗНАЧЕНИЯ(СвязанныеОбъекты.Ссылка) = ЗНАЧЕНИЕ(Документ.Заявка)
		|				ТОГДА ВЫРАЗИТЬ(СвязанныеОбъекты.Ссылка КАК Документ.Заявка).Проведен
		|			КОГДА ТИПЗНАЧЕНИЯ(СвязанныеОбъекты.Ссылка) = ЗНАЧЕНИЕ(Документ.ПоступлениеТоваровУслуг)
		|				ТОГДА ВЫРАЗИТЬ(СвязанныеОбъекты.Ссылка КАК Документ.ПоступлениеТоваровУслуг).Проведен
		|			КОГДА ТИПЗНАЧЕНИЯ(СвязанныеОбъекты.Ссылка) = ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг)
		|				ТОГДА ВЫРАЗИТЬ(СвязанныеОбъекты.Ссылка КАК Документ.РеализацияТоваровУслуг).Проведен
		|			КОГДА ТИПЗНАЧЕНИЯ(СвязанныеОбъекты.Ссылка) = ЗНАЧЕНИЕ(Документ.СчетНаОплатуПокупателю)
		|				ТОГДА ВЫРАЗИТЬ(СвязанныеОбъекты.Ссылка КАК Документ.СчетНаОплатуПокупателю).Проведен
		|		КОНЕЦ
		|ИТОГИ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Ссылка)
		|ПО
		|	ТипСвязанногоДокумента";
	
	Запрос.УстановитьПараметр("РелизСобственника", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если не РезультатЗапроса.Пустой() Тогда 
		ШаблонТекстаОшибки = "Нельзя удалить релиз собственника, если он связан с заявкой, РТУ, счетом на оплату покупателю, ПТУ или акцептом." +
		                      Символы.ПС + "Список документов: ";
		Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока Выборка.Следующий() Цикл
			КоличествоДокументов = Выборка.Ссылка;
			ТипДокументов = Выборка.ТипСвязанногоДокумента; 
			
			МассивСвязанныхДокументов = Новый Массив;
			ВыборкаДетали = Выборка.Выбрать();
			Пока ВыборкаДетали.Следующий() Цикл
				МассивСвязанныхДокументов.Добавить("" + ВыборкаДетали.Номер + " от " + Формат(ВыборкаДетали.Дата, "ДФ=dd.MM.yyyy"));	
			КонецЦикла; 
			Если МассивСвязанныхДокументов.Количество() Тогда
				ШаблонТекстаОшибки = ШаблонТекстаОшибки + ТипДокументов + ?(КоличествоДокументов>1," (" + КоличествоДокументов + ")", "") + " - ";
				ШаблонТекстаОшибки = ШаблонТекстаОшибки + СтрСоединить(МассивСвязанныхДокументов, ", ") + Символы.ПС;
			КонецЕсли;
		КонецЦикла; 
		ПометкаУдаленияЗапрещена = Истина; 
		ОбщегоНазначения.СообщитьПользователю(ШаблонТекстаОшибки);
	КонецЕсли;     
	
	// Евросиб US 104907 TA 105520 Рыбьяков К.А. 24.03.2025 ((
	Если Проведен Тогда
		ЗапретУдаленияПриНаличииКТКВЭксплуатации(ПометкаУдаленияЗапрещена);
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 24.03.2025 ))
	
	Возврат ПометкаУдаленияЗапрещена;

КонецФункции 

