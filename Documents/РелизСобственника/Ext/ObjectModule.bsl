			ЕстьНезаполненныеРеквизиты = Истина;
		КонецЕсли;
		//++ Зубов US 45162 TA 45703 21.01.2022
		////++ Зубов US 33131 TA 43877 15.12.2021
		////Если НЕ ЗначениеЗаполнено(СтрокаНоминации.Ставка) Тогда
