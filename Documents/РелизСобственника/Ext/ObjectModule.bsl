
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Дата 			= ТекущаяДата();
	Автор 			= Пользователи.ТекущийПользователь();
	Создано 		= ТекущаяДата();
	Организация 	= Константы.ОсновнаяОрганизация.Получить();
	Активность 		= Перечисления.СтатусАктивностиРелиза.Активен;
	
	//++ Зубов US 33131 TA 38910 27.10.2021
	//Заполненность 	= Перечисления.СтатусыЗаполненностиРелиза.Открыт;
	Реализованность 	= Перечисления.СтатусыЗаполненностиРелиза.Открыт;
	//-- Зубов US 33131 TA 38910 27.10.2021
	
	// ++ ДИТ_Агафонов_task 50388 06.07.2022
	ЦФО = Автор.ЦФО;
	// -- ДИТ_Агафонов_task 50388 06.07.2022
	
	// Евросиб US 89887 TA 89889 Рыбьяков К.А. 28.10.2024 ((
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПСЦПоставщика") Тогда
		Документы.РелизСобственника.ЗаполнитьРелизСобственникаНаОснованииПСЦПоставщика(ДанныеЗаполнения, ЭтотОбъект);
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 28.10.2024 ))
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	//ДИТ, Беляев СЮ, US 83045 / TA 85275, 16-05-2024, начало
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	//ДИТ, Беляев СЮ, US 83045 / TA 85275, 16-05-2024, конец    
	
	//Евросиб(ДИТ) Сержантова А.С. US 97699 ТА 97731 Начало 29.01.2025  
	ПометкаДоЗаписи = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "ПометкаУдаления, ПСЦ"); // Евросиб US 115383 TA 115384 Рыбьяков К.А. 27.07.2025 (( добавил ПСЦ
	Если ПометкаУдаления и не ПометкаДоЗаписи.ПометкаУдаления и ПроверкаПередУстановкойПометкиУдаления() Тогда
		Отказ = Истина;
	КонецЕсли;
	//Евросиб(ДИТ) Сержантова А.С. US 97699 ТА 97731 Конец 29.01.2025
	
	// Евросиб US 115383 TA 115384 Рыбьяков К.А. 27.07.2025 ((
	Если ПСЦ <> ПометкаДоЗаписи.ПСЦ Тогда
		СвязанныеДокументыСервер.УдалитьСвязи(ПометкаДоЗаписи.ПСЦ, Ссылка);
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 27.07.2025 ))
	
	//Евросиб(ДИТ), Беляев СЮ, US 93174 / TA 96664, 16-12-2024, начало
	ДоступнаРаботаСАрендованнымПарком = РольДоступна("dc_РаботаСАрендованнымПарком") ИЛИ РольДоступна("ПолныеПрава");
	Если НЕ ДоступнаРаботаСАрендованнымПарком Тогда
		СтрокаАрендаДлительная = Номинации.Найти(Перечисления.ВариантыСобственности.АрендаДлительная, "тек_СобственностьКТК");
		Если СтрокаАрендаДлительная <> Неопределено Тогда
			ОбщегоНазначения.СообщитьПользователю("Документ содержит Вид собственности <АрендаДлительная>, недостаточно прав доступа для работы с арендованным парком.",,
													ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Номинации",СтрокаАрендаДлительная.НомерСтроки,"тек_СобственностьКТК"),,Отказ);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	//Евросиб(ДИТ), Беляев СЮ, US 93174 / TA 96664, 16-12-2024, конец
	
	КоличествоНомерных = 0;
	КоличествоБезномерных = 0; 
	//ДИТ Авдеева В.С. 53518 19.08.2022 Начало
	ОсталосьКВыдаче = 0;
	//ДИТ Авдеева В.С. 53518 19.08.2022 Конец 
	//++ Дудоров С.В. TASK 66585 17.03.2023
	
	//Евросиб СубботинВ #102567 18.02.2025 Начало// перенес в проверку заполнения
	//// ДИТ_Алексеев А.А. 2024-07-26 #0360281 Начало	
	//Если СобственныеКТК Тогда
	//	ДанныеНоминацииПоНезаполненнымКонтейнерам = ПолучитьДанныеНоминацииПоНезаполненнымКонтейнерам();  
	//	Если не ДанныеНоминацииПоНезаполненнымКонтейнерам.ВсеКонтейнерыЗаполнены Тогда
	//		ОшибкиНезаполненныхКонтейнеров = ДанныеНоминацииПоНезаполненнымКонтейнерам.ОшибкиНезаполненныхКонтейнеров;
	//		Пока ОшибкиНезаполненныхКонтейнеров.Следующий() Цикл
	//		//Евросиб СубботинВ #102567 18.02.2025 Начало	
	//			//Сообщить("Ошибка: Не заполнен контейнер в строке №" + ОшибкиНезаполненныхКонтейнеров.НомерСтроки + ".");
	//			ОбщегоНазначения.СообщитьПользователю("Ошибка: Не заполнен контейнер в строке №" + ОшибкиНезаполненныхКонтейнеров.НомерСтроки + ".",,
	//			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Номинации", ОшибкиНезаполненныхКонтейнеров.НомерСтроки,"Контейнер"),"Объект")
	//		//Евросиб СубботинВ #102567 18.02.2025 Конец
	//		КонецЦикла;	
	//		Отказ = Истина;
	//		Возврат;
	//	КонецЕсли;
	//КонецЕсли;
	//// ДИТ_Алексеев А.А. 2024-07-26 #0360281 Конец
	//Евросиб СубботинВ #102567 18.02.2025 Конец

	//-- Дудоров С.В. TASK 66585 17.03.2023	
	Для каждого Стр из Номинации Цикл
		Если ЗначениеЗаполнено(Стр.Контейнер) Тогда
			КоличествоНомерных = КоличествоНомерных + 1;
		Иначе
			КоличествоБезномерных = КоличествоБезномерных + 1;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Стр.ДатаАктуальностиЗаписи) Тогда
			Стр.ДатаАктуальностиЗаписи = ТекущаяДата();
		КонецЕсли;
		//ДИТ Авдеева В.С. 53518 19.08.2022 Начало
		Если Не ЗначениеЗаполнено(Стр.ДатаВзятия) Тогда
			ОсталосьКВыдаче = ОсталосьКВыдаче + 1;
		КонецЕсли;
		////ДИТ Авдеева В.С. 53518 19.08.2022 Конец 
		////Евросиб СубботинВ #102687 24.02.2025 Начало перенес в конец после всех проверок 
		//// Евросиб US 88643 TA 88646 Рыбьяков К.А. 04.09.2024 ((
		//Если Не ЗначениеЗаполнено(Стр.КлючАналитики) Тогда
		//	КлючАналитики = Документы.РелизСобственника.СоздатьКлючАналитикиСтрокиНоминаций();
		//	Стр.КлючАналитики = КлючАналитики;
		//КонецЕсли;
		//// Евросиб Рыбьяков К.А. 04.09.2024 ))
		////Евросиб СубботинВ #102687 24.02.2025 Конец 
	КонецЦикла;       
	
	//ДИТ Авдеева В.С. 53518 19.08.2022 Начало
	ОбщееКоличествоВРелизе = Номинации.Количество();
	//ДИТ Авдеева В.С. 53518 19.08.2022 Конец

	ЕстьХотьОдинСлот = Ложь;
	Для каждого Стр из Номинации Цикл
		ЕстьХотьОдинСлот = ЕстьХотьОдинСлот ИЛИ НЕ ЗначениеЗаполнено(Стр.Контейнер);
	КонецЦикла;

	//++ Зубов US 45162 TA 45703 21.01.2022
	//++ Зубов US 33131 TA 38910 27.10.2021
	//Заполненность = ?(ЕстьХотьОдинСлот, ПредопределенноеЗначение("Перечисление.СтатусыЗаполненностиРелиза.Открыт"), ПредопределенноеЗначение("Перечисление.СтатусыЗаполненностиРелиза.Исчерпан"));
	//Реализованность = ?(ЕстьХотьОдинСлот, ПредопределенноеЗначение("Перечисление.СтатусыЗаполненностиРелиза.Открыт"), ПредопределенноеЗначение("Перечисление.СтатусыЗаполненностиРелиза.Исчерпан"));
    Реализованность = ?(ЕстьХотьОдинСлот ИЛИ Номинации.Количество()=0, ПредопределенноеЗначение("Перечисление.СтатусыЗаполненностиРелиза.Открыт"), ПредопределенноеЗначение("Перечисление.СтатусыЗаполненностиРелиза.Исчерпан"));
	//-- Зубов US 33131 TA 38910 27.10.2021
    //-- Зубов US 45162 TA 45703 21.01.2022
	
	//Если ОбменДанными.Загрузка Тогда //ДИТ, Беляев СЮ, US 83045 / TA 85275, 16-05-2024, перенес выше
	//	Возврат;
	//КонецЕсли;
	
	Редактор 		= Пользователи.ТекущийПользователь();
	Изменено 		= ТекущаяДата();
	//++ Зубов US 45162 TA 45703 21.01.2022
	//Если Активность = Перечисления.СтатусАктивностиРелиза.Просрочен И ОкончаниеДействия > ТекущаяДата() Тогда
	//	Активность = Перечисления.СтатусАктивностиРелиза.Активен;
	//ИначеЕсли Активность = Перечисления.СтатусАктивностиРелиза.Активен И ОкончаниеДействия < ТекущаяДата() Тогда
	//	Активность = Перечисления.СтатусАктивностиРелиза.Просрочен;
	//КонецЕсли;
	Если ОкончаниеДействия <= ТекущаяДата() И ЗначениеЗаполнено(ОкончаниеДействия) Тогда
		Если Реализованность = ПредопределенноеЗначение("Перечисление.СтатусыЗаполненностиРелиза.Открыт") Тогда
			Активность = ПредопределенноеЗначение("Перечисление.СтатусАктивностиРелиза.Просрочен");
		Иначе
			Активность = ПредопределенноеЗначение("Перечисление.СтатусАктивностиРелиза.Закрыт");
		КонецЕсли;
	Иначе
		Активность = ПредопределенноеЗначение("Перечисление.СтатусАктивностиРелиза.Активен");
	КонецЕсли;
	//-- Зубов US 45162 TA 45703 21.01.2022
	Для каждого Стр из Номинации Цикл
		
		Если ЗначениеЗаполнено(Стр.Контейнер) И ЗначениеЗаполнено(Стр.ТипКТК) И НЕ ЗначениеЗаполнено(Стр.Контейнер.ТипТЕ) Тогда
			КОб = Стр.Контейнер.ПолучитьОбъект();
			КОб.ТипТЕ = Стр.ТипКТК;
			КОб.Записать();
		КонецЕсли;
		
		//++ Зубов US 33131 TA 38910 26.10.2021
		//Если ЗначениеЗаполнено(Стр.Контейнер) Тогда
		//	ДанныеАРМКТК = УправлениеКТКВСтокахСервер.ПолучитьДанныеКТКизАРМКТК(Стр.Контейнер);
		//	Если ЗначениеЗаполнено(ДанныеАРМКТК.тек_Собственник) Тогда
		//		Стр.тек_Собственник = ДанныеАРМКТК.тек_Собственник;
		//	КонецЕсли;
		//КонецЕсли;
		//-- Зубов US 33131 TA 38910 26.10.2021
	КонецЦикла;
	
	// ++ ДИТ_Агафонов_task 50388 07.07.2022
	// + Состояния
	КолвоРелизКлиентаНеСовпадаетТипоразмерКТК=0;	
	КолвоРелизКлиентаНоваяЗаписьКТК=0;
	Для каждого СтрокаНоминации Из Номинации Цикл
		Если СтрокаНоминации.РелизКлиентаНеСовпадаетТипоразмерКТК Тогда
			КолвоРелизКлиентаНеСовпадаетТипоразмерКТК = КолвоРелизКлиентаНеСовпадаетТипоразмерКТК + 1;
		КонецЕсли;
		Если СтрокаНоминации.РелизКлиентаНоваяЗаписьКТК Тогда
			КолвоРелизКлиентаНоваяЗаписьКТК = КолвоРелизКлиентаНоваяЗаписьКТК + 1;
		КонецЕсли;
	КонецЦикла; 
	
	// ДИТ US 76956 ТА 76963 Сержантова А.С. Начало: 03.11.2023
	СтрокиСПустойДатойВзятия = Новый Массив;  
	СтрокиДоПроведения = Новый Массив;
	Для каждого Стр Из Ссылка.Номинации Цикл 
		Если не ЗначениеЗаполнено(стр.ДатаВзятия) Тогда
			СтрокиСПустойДатойВзятия.Добавить(стр.ГУИДСтроки);	
		КонецЕсли; 
		СтрокиДоПроведения.Добавить(стр.ГУИДСтроки);
	КонецЦикла;
	ДополнительныеСвойства.Вставить("ПустыеДатыВзятия", СтрокиСПустойДатойВзятия); 
	ДополнительныеСвойства.Вставить("СтрокиДоПроведения", СтрокиДоПроведения); 
	// ДИТ US 76956 ТА 76963 Сержантова А.С. Конец: 03.11.2023
	
	Маршрутизировать = КолвоРелизКлиентаНеСовпадаетТипоразмерКТК > 0 или КолвоРелизКлиентаНоваяЗаписьКТК > 0;
	МаршрутизироватьЗаново = Ложь;
	Если не Маршрутизировать Тогда
		ПроверитьСостояния(МаршрутизироватьЗаново);
	Иначе	
	// проверяем корректность перечня состояний в ТЧ Состояния
	Для Сч = 0 По Состояния.Количество() - 2 Цикл
		ТекСостояние = Состояния[Сч].Состояние;
		Для ТекСч = Сч + 1 По Состояния.Количество() - 1 Цикл
			Если Состояния[ТекСч].Состояние = ТекСостояние Тогда
				Сообщить("Ошибка: одно состояние может встречаться в документе только один раз!");
				Отказ = Истина;
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
		
	//МаршрутизацияСервер.ПараллельноеСогласование(Состояния); //ДИТ, Беляев СЮ, Ticket#0344187, 06-03-2024, закомментировал (перенёс ниже)
		
	// Маршрутизация заказа
	ДляДанногоОбъектаТребуетсяПеремаршрутизация = МаршрутизацияСервер.ТребуетсяПеремаршрутизацияДляОбъекта(ЭтотОбъект); 
	
	Если Маршрутизировать И ДляДанногоОбъектаТребуетсяПеремаршрутизация Тогда
		
		ПараметрыЗапроса = Документы.РелизСобственника.ПолучитьПараметрыМаршрутизации(ЭтотОбъект);
		РезультатЗапроса = МаршрутизацияСервер.МаршрутизироватьРелизСобственника(ПараметрыЗапроса, Дата);
		Если РезультатЗапроса.Количество() > 0 и ПримененныйМаршрут<>РезультатЗапроса[0].Ссылка Тогда
			УказанныеВручнуюИспНаблюдатель = Новый СписокЗначений;
			Если ДополнительныеСвойства.Свойство("ДопСвойстваОбъекта") тогда
				УказанныеВручнуюИспНаблюдатель = ДополнительныеСвойства.ДопСвойстваОбъекта;
			КонецЕсли;
			МаршрутизацияСервер.ПрименитьМаршрут(ЭтотОбъект, РезультатЗапроса, Автор, УказанныеВручнуюИспНаблюдатель);			
			МаршрутизироватьЗаново = Истина;
		КонецЕсли;
	КонецЕсли;
	
	//ДИТ, Беляев СЮ, Ticket#0344187, 06-03-2024, начало
	МаршрутизацияСервер.ПараллельноеСогласование(Состояния);
	//ДИТ, Беляев СЮ, Ticket#0344187, 06-03-2024, конец
	
	ПроверитьСостояния(МаршрутизироватьЗаново);
	
	МаршрутизацияСервер.ПостобработкаТЧСостояний(ЭтотОбъект, Автор);
	
	// если исполнитель пустой, то проставляем тек пользователя
	Для каждого Стр из Состояния Цикл
		Если Стр.ПримечаниеЗадачаИсполнителю Тогда
			// если текст примечания изменился, то создать новое сообщение. если остался прежним, то не менять
			// т.к. состояние уникально, ищем по нему
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Состояние",Стр.Состояние);
			НайденнаяСтр = Ссылка.Состояния.НайтиСтроки(ПараметрыОтбора);
			Если НайденнаяСтр.Количество()>0 Тогда
				Если НЕ НайденнаяСтр[0].Комментарий = Стр.Комментарий Тогда
					
					// +Шейко ОЕ [Ticket#0204385] Личные сообщения пользователям
					ДатаСообщения = ТекущаяДата();
					АвторСообщения = Пользователи.ТекущийПользователь();
					ТекстСообщения = Стр.Комментарий;
					ГУИДСообщения = Новый УникальныйИдентификатор();
					
					ГУИДТемы = Новый УникальныйИдентификатор;
					
					РассылкаПоЛичнымЦелям.СформироватьЛичноеСообщение(ГУИДТемы, , Ссылка, ДатаСообщения, АвторСообщения, ТекстСообщения, , ГУИДСообщения, Стр.Исполнитель);
					// -Шейко ОЕ [Ticket#0204385] Личные сообщения пользователям
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	КонецЕсли;	
	// - Состояния	
	// -- ДИТ_Агафонов_task 50388 07.07.2022
	
	
	//Евросиб СубботинВ #102687 24.02.2025 Начало перенес в конец после всех проверок
	Если не ЗначениеЗаполнено(Ссылка) тогда
		НовыйГуид = Документы.РелизСобственника.ПолучитьСсылку(Новый УникальныйИдентификатор());
		ЭтотОбъект.УстановитьСсылкуНового(НовыйГуид);
		СсылкаРелиз = ПолучитьСсылкуНового();
	Иначе
		СсылкаРелиз = Ссылка;
	КонецЕсли;
	Для каждого СтрокаНоминации Из Номинации Цикл		
		Если Не ЗначениеЗаполнено(СтрокаНоминации.КлючАналитики) Тогда
			КлючАналитики = Документы.РелизСобственника.СоздатьКлючАналитикиСтрокиНоминаций(СсылкаРелиз,СтрокаНоминации.Контейнер);
			СтрокаНоминации.КлючАналитики = КлючАналитики;
		КонецЕсли;
		// Евросиб US 112646 TA 112819 Рыбьяков К.А. 06.07.2025 ((
		Если Не ЗначениеЗаполнено(СтрокаНоминации.ВалютаСНП) И Не НаОсновании Тогда
			СтрокаНоминации.ВалютаСНП = СтрокаНоминации.Валюта;
		КонецЕсли;
		// Евросиб Рыбьяков К.А. 06.07.2025 ))
	КонецЦикла;
	//Евросиб СубботинВ #102687 24.02.2025 Конец
	
