Процедура ЗаполнитьРазмерКТК()
	
	//Тип20 = Справочники.ТипоразмерыТЕ.ПолучитьСсылку(Новый УникальныйИдентификатор("7a4ef4c2-cee1-11e9-b810-00155d152369")); //000000004 20DC
	//Тип40 = Справочники.ТипоразмерыТЕ.ПолучитьСсылку(Новый УникальныйИдентификатор("3f4c229e-cee1-11e9-b810-00155d152369")); //000000001 40HC
	//ДИТ, Беляев СЮ, BUG 67118 / TASK 69529, 02-05-2023, начало
	СтруктураРазмера20 = РаботаСКонтейнерамиСервер.НайтиТипПоРазмеру("20");
	Тип20 = СтруктураРазмера20.Тип;
	СтруктураРазмера40 = РаботаСКонтейнерамиСервер.НайтиТипПоРазмеру("40");
	Тип40 = СтруктураРазмера40.Тип;
	//ДИТ, Беляев СЮ, BUG 67118 / TASK 69529, 02-05-2023, конец
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("НомерКонтейнера", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(11, ДопустимаяДлина.Переменная))); 
	ТЗ.Колонки.Добавить("Футовость", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(11, 0, ДопустимыйЗнак.Любой)));
	
	Для Каждого Стр Из Контейнеры Цикл 
		Если ЗначениеЗаполнено(Стр.НомерКонтейнера) И ЗначениеЗаполнено(Стр.ФутовостьКрупнотоннажногоКонтейнера) Тогда 
			НоваяСтрока = ТЗ.Добавить();
			НоваяСтрока.НомерКонтейнера = Стр.НомерКонтейнера;
			НоваяСтрока.Футовость = Стр.ФутовостьКрупнотоннажногоКонтейнера;
		КонецЕсли;	
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЗ.НомерКонтейнера КАК НомерКонтейнера,
		|	ТЗ.Футовость КАК Футовость
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТЕ.Ссылка КАК КТК,
		|	ВЫБОР
		|		КОГДА ВТ.Футовость = 40
		|			ТОГДА &Тип40
		|		КОГДА ВТ.Футовость = 20
		|			ТОГДА &Тип20
		|	КОНЕЦ КАК ТипТЕ
		|ИЗ
		|	ВТ КАК ВТ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТЕ КАК ТЕ
		|		ПО ВТ.НомерКонтейнера = ТЕ.Наименование
		|			И (ТЕ.ТипТЕ = ЗНАЧЕНИЕ(Справочник.ТипоразмерыТЕ.ПустаяСсылка))
		|ГДЕ
		|	ВТ.Футовость В (20, 40)
		//ДИТ, Беляев СЮ, BUG 67118 / TASK 69529, 02-05-2023, начало (типоразмеры Тип20, Тип40 определяеюся по настройкам в справочнике, исключаем случай установки пустого значения в КТК)
		|	И ВЫБОР
		|			КОГДА ВТ.Футовость = 40
		|				ТОГДА &Тип40
		|			КОГДА ВТ.Футовость = 20
		|				ТОГДА &Тип20
		|		КОНЕЦ <> НЕОПРЕДЕЛЕНО";
		//ДИТ, Беляев СЮ, BUG 67118 / TASK 69529, 02-05-2023, конец
	
	Запрос.УстановитьПараметр("ТЗ",ТЗ);
	Запрос.УстановитьПараметр("Тип20", Тип20);
	Запрос.УстановитьПараметр("Тип40", Тип40);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		КТКОбъект = ВыборкаДетальныеЗаписи.КТК.ПолучитьОбъект();                                     
		КТКОбъект.ТипТЕ = ВыборкаДетальныеЗаписи.ТипТЕ;
		КТКОбъект.УстановитьКомментарийВерсииИсторииДанных("Заполнение ""Тип ТЕ"" на основании ЖДН");
		КТКОбъект.Записать();
	КонецЦикла;
	
КонецПроцедуры	
