Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекСтрокаОтметки Из СпециальныеОтметки Цикл
		Если ТекСтрокаОтметки.ОтметкаИД = 1224 ИЛИ
			ТекСтрокаОтметки.ОтметкаИД = 1212 ИЛИ
			ТекСтрокаОтметки.ОтметкаИД = 1213 Тогда
			Ремонт = ТекСтрокаОтметки.ОтметкаИД;
		ИначеЕсли ТекСтрокаОтметки.ОтметкаИД = 991 Тогда
			КонтейнерныйПоезд = Истина;
		КонецЕсли;
	КонецЦикла;
	
	КонтейнерыЗПУСтрока.Очистить();
	
	Для Каждого ТекЗПУ Из КонтейнерЗПУ Цикл
		Если ЗначениеЗаполнено(ТекЗПУ.Знаки) Тогда
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("НомерКонтейнера",ТекЗПУ.НомерКонтейнера);
			НайденныеСтроки = КонтейнерыЗПУСтрока.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() = 0 Тогда
				НовСтр = КонтейнерыЗПУСтрока.Добавить();
				НовСтр.НомерКонтейнера = ТекЗПУ.НомерКонтейнера;
				НовСтр.ЗПУ = ТекЗПУ.Знаки;
			Иначе
				ТекСтр = НайденныеСтроки[0];
				ТекСтр.ЗПУ = ТекСтр.ЗПУ + ";" + ТекЗПУ.Знаки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	СуммаНаВагон.Очистить();
	СуммаНаКонтейнер.Очистить();
	
	СуммаКРаспределению = 0;
	СуммаКРаспределениюПрибытие = 0;
	
	// платежи по отправлению
	Для Каждого Стр Из ПровозныеПлатежиИСборыПоОтправлению Цикл
		Если ЗначениеЗаполнено(Стр.НомерВагона) Тогда
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("НомерВагона",Стр.НомерВагона);
			НайденныеСтроки = СуммаНаВагон.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() = 0 Тогда
				НовСтр = СуммаНаВагон.Добавить();
				НовСтр.НомерВагона = Стр.НомерВагона;
				НовСтр.СуммаПоОтправлению = Стр.СуммаВРублях;
			Иначе
				ТекСтр = НайденныеСтроки[0];
				ТекСтр.СуммаПоОтправлению = ТекСтр.СуммаПоОтправлению + Стр.СуммаВРублях;
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(Стр.НомерКонтейнера) Тогда
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("НомерКонтейнера",Стр.НомерКонтейнера);
			НайденныеСтроки = СуммаНаКонтейнер.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() = 0 Тогда
				НовСтр = СуммаНаКонтейнер.Добавить();
				НовСтр.НомерКонтейнера = Стр.НомерКонтейнера;
				НовСтр.СуммаПоОтправлению = Стр.СуммаВРублях;
			Иначе
				ТекСтр = НайденныеСтроки[0];
				ТекСтр.СуммаПоОтправлению = ТекСтр.СуммаПоОтправлению + Стр.СуммаВРублях;
			КонецЕсли;
		// если в строке не указан ни вагон ни КТК, то сумму разделить пропорционально по вагонам в накладной
		// (если таблица вагонов не заполнена, то разнести по КТК)
		Иначе
			// сохраняем значение в переменную
			СуммаКРаспределению = СуммаКРаспределению + Стр.СуммаВРублях;
		КонецЕсли;
		
	КонецЦикла;
	
	
	// платежи по прибытию
	Для Каждого Стр Из ПровозныеПлатежиИСборыПоПрибытию Цикл
		Если ЗначениеЗаполнено(Стр.НомерВагона) Тогда
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("НомерВагона",Стр.НомерВагона);
			НайденныеСтроки = СуммаНаВагон.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() = 0 Тогда
				НовСтр = СуммаНаВагон.Добавить();
				НовСтр.НомерВагона = Стр.НомерВагона;
				НовСтр.СуммаПоРаскредитации = Стр.СуммаВРублях;
			Иначе
				ТекСтр = НайденныеСтроки[0];
				ТекСтр.СуммаПоРаскредитации = ТекСтр.СуммаПоРаскредитации + Стр.СуммаВРублях;
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(Стр.НомерКонтейнера) Тогда
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("НомерКонтейнера",Стр.НомерКонтейнера);
			НайденныеСтроки = СуммаНаКонтейнер.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() = 0 Тогда
				НовСтр = СуммаНаКонтейнер.Добавить();
				НовСтр.НомерКонтейнера = Стр.НомерКонтейнера;
				НовСтр.СуммаПоРаскредитации = Стр.СуммаВРублях;
			Иначе
				ТекСтр = НайденныеСтроки[0];
				ТекСтр.СуммаПоРаскредитации = ТекСтр.СуммаПоРаскредитации + Стр.СуммаВРублях;
			КонецЕсли;
		// если в строке не указан ни вагон ни КТК, то сумму разделить пропорционально по вагонам в накладной
		// (если таблица вагонов не заполнена, то разнести по КТК)
		Иначе
			// сохраняем значение в переменную
			СуммаКРаспределениюПрибытие = СуммаКРаспределениюПрибытие + Стр.СуммаВРублях;
		КонецЕсли;
		
	КонецЦикла;
	
	НаВагон = 0;
	НаКонтейнер = 0;
	НаВагонПрибытие = 0;
	НаКонтейнерПрибытие = 0;
	
	Если СуммаКРаспределению >0 Тогда
		// сначала попытка распределить по вагонам
		Если Вагоны.Количество()>0 Тогда
			НаВагон = Окр(СуммаКРаспределению/Вагоны.Количество(),3);
			// если сумма не делится ровно, то на последний вагон она будет больше
			СуммаНаПоследнийВагон = НаВагон + (СуммаКРаспределению-НаВагон*Вагоны.Количество());
		Иначе
			НаКонтейнер = Окр(СуммаКРаспределению/Контейнеры.Количество(),3);
			// если сумма не делится ровно, то на последний КТК она будет больше
			СуммаНаПоследнийКонтейнер = НаКонтейнер + (СуммаКРаспределению-НаКонтейнер*Контейнеры.Количество());
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ СуммаКРаспределениюПрибытие = 0 Тогда
		// сначала попытка распределить по вагонам
		Если Вагоны.Количество()>0 Тогда
			НаВагонПрибытие = Окр(СуммаКРаспределениюПрибытие/Вагоны.Количество(),3);
			// если сумма не делится ровно, то на последний вагон она будет больше
			СуммаНаПоследнийВагонПрибытие = НаВагонПрибытие + (СуммаКРаспределениюПрибытие-НаВагонПрибытие*Вагоны.Количество());
		Иначе
			НаКонтейнерПрибытие = Окр(СуммаКРаспределениюПрибытие/Контейнеры.Количество(),3);
			// если сумма не делится ровно, то на последний КТК она будет больше
			СуммаНаПоследнийКонтейнерПрибытие = НаКонтейнерПрибытие + (СуммаКРаспределениюПрибытие-НаКонтейнерПрибытие*Контейнеры.Количество());
		КонецЕсли;
	КонецЕсли;
	
	// сумма по отправлению
	Если НаВагон>0 Тогда
		Для ШагЦикла = 0 По Вагоны.Количество()-1 Цикл
			Стр = Вагоны[ШагЦикла];
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("НомерВагона",Стр.НомерВагона);
			НайденныеСтроки = СуммаНаВагон.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() = 0 Тогда
				НовСтр = СуммаНаВагон.Добавить();
				НовСтр.НомерВагона = Стр.НомерВагона;
				НовСтр.СуммаПоОтправлению = ?(ШагЦикла = Вагоны.Количество()-1,СуммаНаПоследнийВагон,НаВагон);
			Иначе
				ТекСтр = НайденныеСтроки[0];
				ТекСтр.СуммаПоОтправлению = ТекСтр.СуммаПоОтправлению + ?(ШагЦикла = Вагоны.Количество()-1,СуммаНаПоследнийВагон,НаВагон);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если НаКонтейнер>0 Тогда
		Для ШагЦикла = 0 По Контейнеры.Количество()-1 Цикл
			Стр = Контейнеры[ШагЦикла];
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("НомерКонтейнера",Стр.НомерКонтейнера);
			НайденныеСтроки = СуммаНаКонтейнер.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() = 0 Тогда
				НовСтр = СуммаНаКонтейнер.Добавить();
				НовСтр.НомерКонтейнера = Стр.НомерКонтейнера;
				НовСтр.СуммаПоОтправлению = ?(ШагЦикла = Контейнеры.Количество()-1,СуммаНаПоследнийКонтейнер,НаКонтейнер);
			Иначе
				ТекСтр = НайденныеСтроки[0];
				ТекСтр.СуммаПоОтправлению = ТекСтр.СуммаПоОтправлению + ?(ШагЦикла = Контейнеры.Количество()-1,СуммаНаПоследнийКонтейнер,НаКонтейнер);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// сумма по прибытию
	Если НаВагонПрибытие>0 Тогда
		Для ШагЦикла = 0 По Вагоны.Количество()-1 Цикл
			Стр = Вагоны[ШагЦикла];
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("НомерВагона",Стр.НомерВагона);
			НайденныеСтроки = СуммаНаВагон.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() = 0 Тогда
				НовСтр = СуммаНаВагон.Добавить();
				НовСтр.НомерВагона = Стр.НомерВагона;
				НовСтр.СуммаПоРаскредитации = ?(ШагЦикла = Вагоны.Количество()-1,СуммаНаПоследнийВагонПрибытие,НаВагонПрибытие);
			Иначе
				ТекСтр = НайденныеСтроки[0];
				ТекСтр.СуммаПоРаскредитации = ТекСтр.СуммаПоРаскредитации + ?(ШагЦикла = Вагоны.Количество()-1,СуммаНаПоследнийВагонПрибытие,НаВагонПрибытие);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если НаКонтейнерПрибытие>0 Тогда
		Для ШагЦикла = 0 По Контейнеры.Количество()-1 Цикл
			Стр = Контейнеры[ШагЦикла];
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("НомерКонтейнера",Стр.НомерКонтейнера);
			НайденныеСтроки = СуммаНаКонтейнер.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() = 0 Тогда
				НовСтр = СуммаНаКонтейнер.Добавить();
				НовСтр.НомерКонтейнера = Стр.НомерКонтейнера;
				НовСтр.СуммаПоРаскредитации = ?(ШагЦикла = Контейнеры.Количество()-1,СуммаНаПоследнийКонтейнерПрибытие,НаКонтейнерПрибытие);
			Иначе
				ТекСтр = НайденныеСтроки[0];
				ТекСтр.СуммаПоРаскредитации = ТекСтр.СуммаПоРаскредитации + ?(ШагЦикла = Контейнеры.Количество()-1,СуммаНаПоследнийКонтейнерПрибытие,НаКонтейнерПрибытие);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ГруженаяНакладная = ГрузыЖД.Итог("МассаГруза") > 0;
	
	Если Вагоны.Количество() = 0 Тогда
		НакладнаяБезВагонов = Истина;
//Евросиб Гудкова( 30.03.2022 Ticket№ 48859
	Иначе
		НакладнаяБезВагонов = Ложь;
// Евросиб Гудкова)
	КонецЕсли;
	
	ТекущееСостояниеНакладнойДействующийСтатус = ТекущееСостояниеНакладной.ДействующийСтатус;
	
	//ДИТ, Беляев СЮ, TA51481, 18-05-2022, начало
	//УнифицированныйНомерНакладной = ПолучитьУнифицированныйНомерНакладной(НакладнаяНомер);
	УнифицированныйНомерНакладной = э_ОбщиеСервер.ПолучитьУнифицированныйНомерНакладной(НакладнаяНомер);
	//ДИТ, Беляев СЮ, TA51481, 18-05-2022, конец
	
	// ДИТ BUG 67118 TA 68321 Евсенкин М.А. Начало: 10.04.2023
	ЗаполнитьРазмерКТК();	
	// ДИТ BUG 67118 TA 68321 Евсенкин М.А. Конец: 10.04.2023
КонецПроцедуры        

