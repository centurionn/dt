			МЗ = РегистрыСведений.ТрДокПрибыл.СоздатьМенеджерЗаписи();
			МЗ.ТрДок = Выборка.Ссылка;
			МЗ.ДатаПрибыл = ДатаИВремяПрибытияГруза;
