

Процедура ПриЗаписи(Отказ)  
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
    СоздатьТранспортныйДокумент();
	
	НаборЗаписей = РегистрыСведений.э_ИсторияНакладных.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Период.Установить(Дата);
	Запись = НаборЗаписей.Добавить();
	Запись.Период								= Дата;
	Запись.НомерНакладной						= Номер;
	Запись.ИДНакладной							= НакладнаяИД;
	Запись.ИДСостояниеНакладной					= ТекущегоСостояниеНакладнойИД;
	Запись.CостояниеНакладной					= ТекущееСостояниеНакладной;
	Запись.ДатаПоследнейОперацииНадДокументом	= ДатаПоследнейОперацииНадДокументом;
	НаборЗаписей.Записать();

КонецПроцедуры


