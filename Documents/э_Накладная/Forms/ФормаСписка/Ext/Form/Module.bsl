&НаКлиенте
Функция ПолучитьТекстИзЭТРАН(НакладнаяИД,БинарныйТекст,Тест = Ложь)
	
	Ошибка = "";
	
	ИмяВременногоФайлаТекстДанных = ПолучитьИмяВременногоФайла();
	ТекДок = Новый ТекстовыйДокумент;  
	ТекДок.УстановитьТекст("");
	ТекДок.Записать(ИмяВременногоФайлаТекстДанных,"windows-1251");
	
	РезультатЗапросаДанных = ПолучитьИмяВременногоФайлаИнформацияОДокументе(НакладнаяИД,Истина); 	
	
	ИнформацияОДокументе = 	"";
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(РезультатЗапросаДанных);
	Пока ЧтениеXML.Прочитать() Цикл  		
		Если ЧтениеXML.Имя = "error" Тогда
			ИнформацияОДокументе = ЧтениеXML.ПолучитьАтрибут("value");
			Ошибка = РезультатЗапросаДанных;
			ИмяВременногоФайлаТекстДанных = Неопределено; 
			прервать;
		КонецЕсли;
		Если  ЧтениеXML.Имя = "textBinary" Тогда
			ИнформацияОДокументе = ЧтениеXML.ПолучитьАтрибут("value"); 				
			прервать;
		КонецЕсли;
	КонецЦикла;  
	
	
	//Для подписания информации текстом
	ИнформацияОДокументе = СтрЗаменить(ИнформацияОДокументе,"  ",""); 
	ИнформацияОДокументе = Base64Строка(Base64Значение(ИнформацияОДокументе));

	ТекДок.УстановитьТекст(ИнформацияОДокументе);
	ТекДок.Записать(ИмяВременногоФайлаТекстДанных,"windows-1251"); 	
		
	
	//ЗаписьДанных = Base64Значение(ИнформацияОДокументе);
	//ЗаписьДанных.Записать(ИмяВременногоФайлаТекстДанных);
	
	//Если ИнформацияОДокументе = "" Тогда
	//Иначе
	//	ИнформацияОДокументе = СтрЗаменить(ИнформацияОДокументе,"  ",Символ(13)+Символ(10));  
	//	ТекДок.УстановитьТекст(ИнформацияОДокументе);
	//	ТекДок.Записать(ИмяВременногоФайлаТекстДанных,"windows-1251"); 
	//КонецЕсли;
			 
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяВременногоФайлаТекстДанных",ИмяВременногоФайлаТекстДанных);
	Результат.Вставить("Ошибка",Ошибка); 
	
	Возврат Результат;   	
	
	
КонецФункции
