#Область ЭЦП

&НаКлиенте
Процедура ПолучитьДокументыТребующиеЭЦП(Команда)
	
	ПолучитьДокументыТребующиеЭЦПНаСервере();
	
КонецПроцедуры
&НаСервере
Процедура ПолучитьДокументыТребующиеЭЦПНаСервере()
	
	Рез = э_ОбщиеСервер.ПолучитьОтветНаЗапрос("<ECPWaitDocStatus><fromDate>"+Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy")+"</fromDate> </ECPWaitDocStatus>");
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(Рез);		
	
	СписокНакладныхЭЦП.Очистить();
	СтрокаНов = "";
	ИмяРеквизита = "";
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Имя = ЧтениеXML.Имя;  				
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			Если  Имя = "#text" и не ИмяРеквизита = "" Тогда
				СтрокаНов[ИмяРеквизита] = ЧтениеXML.Значение;
			КонецЕсли;     			
			
			Если Имя = "DOC_ID" Тогда
				СтрокаНов = СписокНакладныхЭЦП.Добавить();
				ИмяРеквизита = "ИДДокумента";
			ИначеЕсли Имя = "DocDescription" Тогда
				ИмяРеквизита = "Наименование";
			ИначеЕсли Имя = "ECPDocTypeName" Тогда
				ИмяРеквизита = "ОписаниеДокумента";
			ИначеЕсли Имя = "ECPDate" Тогда
				ИмяРеквизита = "ДатаЭЦП";
			ИначеЕсли Имя = "WaitECPDate" Тогда
				ИмяРеквизита = "ДатаЭЦПОжидания";				
			Иначе 
				ИмяРеквизита = "";
			КонецЕсли;
			
		КонецЕсли;  		
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.Текст и не ИмяРеквизита = "" Тогда
			СтрокаНов[ИмяРеквизита] = ЧтениеXML.Значение;
		КонецЕсли;
		
	КонецЦикла; 	
	
	
КонецПроцедуры
&НаКлиенте 
Процедура Подписать(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ПодписатьНакладную",ЭтотОбъект);
	ПоказатьВопрос(Оповещение,"Выбранный документ будет подписан в ЭТРАН!",РежимДиалогаВопрос.ОКОтмена);
	
КонецПроцедуры  
&НаКлиенте
Процедура ПодписатьНакладную(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Отмена Тогда
        Возврат;
    КонецЕсли;	
	
	ТекСтрока = Элементы.СписокНакладныхЭЦП.ТекущиеДанные;
	ИмяВременногоФайлаТекстДанных = Неопределено;
	ИДНакладной = ТекСтрока.ИДДокумента;
	
	Если  ТекСтрока = Неопределено	Тогда
		Сообщить("Не выбран документ!");
		Возврат; 
	Иначе 	
		ИмяВременногоФайлаТекстДанных = ПолучитьДанныеНакладной(ИДНакладной);
	КонецЕсли;
	
	Если ИмяВременногоФайлаТекстДанных = Неопределено Тогда
		Сообщить("Не удалось получить данные документа из ЭТРАН!");
		Возврат;
	КонецЕсли;
	
	//получение временного файла ЭЦП
	ИмяВременногоФайлаЭЦП = ПолучитьИмяВременногоФайла("b64");
	ФайлЗапросаЭЦП = Новый ТекстовыйДокумент;
	ФайлЗапросаЭЦП.УстановитьТекст("");
	ФайлЗапросаЭЦП.Записать(ИмяВременногоФайлаЭЦП);
	//получение временного файла Хеш	
	ИмяВременногоФайлаХеш = ПолучитьИмяВременногоФайла();
	ТДХеш = Новый ТекстовыйДокумент;
	ТДХеш.УстановитьТекст("");
	ТДХеш.Записать(ИмяВременногоФайлаХеш,"windows-1251");
	//получение временного файла Запроса Штампа
	ИмяВременногоФайлаЗапросаШтампа = ПолучитьИмяВременногоФайла("tsq");
	ФайлЗапросаШтамп = Новый ТекстовыйДокумент;
	ФайлЗапросаШтамп.УстановитьТекст("");
	ФайлЗапросаШтамп.Записать(ИмяВременногоФайлаЗапросаШтампа);
	//получение временного файла Штампа	
	ИмяВременногоФайлаШтампа = ПолучитьИмяВременногоФайла("tsr");
	ФайлШтамп = Новый ТекстовыйДокумент;
	ФайлШтамп.УстановитьТекст("");
	ФайлШтамп.Записать(ИмяВременногоФайлаШтампа);  	
	
	//получение ЭЦП
	//Перед подпислью, преобразовываем в текст
	ТекстДляПодписи = Новый ТекстовыйДокумент;
	ТекстДляПодписи.Прочитать(ИмяВременногоФайлаТекстДанных);
	ИнформацияОДокументе = ТекстДляПодписи.ПолучитьТекст();
	
	ЗаписьДанных = Base64Значение(ИнформацияОДокументе);
	ЗаписьДанных.Записать(ИмяВременногоФайлаТекстДанных);

	
	Сртификат = ПолучитьСертификат(); 	
	ДвоичныеДанные = ПодписатьНаКлиенте(Сртификат, ИмяВременногоФайлаТекстДанных);
	ДвоичныеДанные.Записать(ИмяВременногоФайлаЭЦП);
	//Base64
	Base64 = Base64Строка(ДвоичныеДанные); 	
	ФайлЗапросаЭЦП.УстановитьТекст(Base64);
	ФайлЗапросаЭЦП.Записать(ИмяВременногоФайлаЭЦП);
	Base64 = СтрЗаменить(Base64,Символ(182),Символ(13)+Символ(10));	
	
	//получение Хеш
	oHash    = Новый COMОбъект("CAPICOM.HashedData");
	oHash.Algorithm  = "CAPICOM_HASH_ALGORITHM_SHA1";
	oHash.Hash(Base64);		
	ХешДД = ПолучитьДвоичныеДанныеИзHexСтроки(oHash.Value);	
	ХешДД.Записать(ИмяВременногоФайлаХеш);
	
	TSAAddress = ПолучитьАдресаШтампаВремени();
	
	//Получение запроса на штамп
	СтрокаЗапуска = "C:\Program Files (x86)\Crypto Pro\SDK\bin\tsputil.exe mr --f=base64 --alg=1.3.14.3.2.26 --cert-req --input-type=hash  " +  ИмяВременногоФайлаХеш + " " + ИмяВременногоФайлаЗапросаШтампа;
	КОдВозврата = "";
	ЗапуститьПриложение(СтрокаЗапуска,"C:\Program Files (x86)\Crypto Pro\SDK\bin\",Истина,КОдВозврата);
	Если не КОдВозврата = 0 Тогда
		Сообщить("Ошибка создания запроса штампа времени!");
		Сообщить("Код ошибки: " + КОдВозврата);
		Возврат;    
	КонецЕсли;  	
	//Получение штампа
	СтрокаЗапуска = "C:\Program Files (x86)\Crypto Pro\SDK\bin\tsputil.exe sr --format=base64 --url=" +TSAAddress+" " + ИмяВременногоФайлаЗапросаШтампа+" " + ИмяВременногоФайлаШтампа;
	КОдВозврата = ""; 
	ЗапуститьПриложение(СтрокаЗапуска,"C:\Program Files (x86)\Crypto Pro\SDK\bin\",Истина,КОдВозврата);
	Если не КОдВозврата = 0 Тогда
		Сообщить("Ошибка получения штампа времени!");
		Сообщить("Код ошибки: " + КОдВозврата);
		Возврат;
	КонецЕсли;  	
	ФайлШтамп.Прочитать(ИмяВременногоФайлаШтампа);
	//ТекстШтампа
	ТекстШтампа = ФайлШтамп.ПолучитьТекст();
	  	
	//ФайлЗапросаЭЦП.Прочитать(ИмяВременногоФайлаЭЦП);
	//Base64 = ФайлЗапросаЭЦП.ПолучитьТекст();
	
	
	Попытка 		                                                                                                                              //БинарныйТекст
		//Результат = ЗапросПроведенияЭЦПНадДокументомНаСервере(СтрЗаменить(ИДНакладной, Символы.НПП, ""), СтрЗаменить(ИнформацияОДокументе,"""","&quot;"),Base64,ТекстШтампа, Ложь);
		//Результат = ЗапросПроведенияЭЦПНадДокументомНаСервере(СтрЗаменить(ИДНакладной, Символы.НПП, ""),  СтрЗаменить(ИнформацияОДокументе,"  ",Символ(13)+Символ(10)),Base64,ТекстШтампа, Истина);
		Результат = ЗапросПроведенияЭЦПНадДокументомНаСервере(СтрЗаменить(ИДНакладной, Символы.НПП, ""),  ИнформацияОДокументе,Base64,ТекстШтампа, Истина);
	
	Исключение
		Ошибка = ОписаниеОшибки();
		Инфо = ИнформацияОбОшибке();
		Результат = ПодробноеПредставлениеОшибки(Инфо);
		Сообщить("Ошибка запроса на создание ЭЦП в ЭТРАН!"); 
	КонецПопытки;

	
	Если СтрНайти(Результат,"error")>0 Тогда
		Сообщить(Результат);
	Иначе
		Сообщить("Документ подписан, ИД: " + ИДНакладной);
	КонецЕсли;  	

	ПолучитьДокументыТребующиеЭЦПНаСервере(); 
	
	
КонецПроцедуры
