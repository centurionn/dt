	РезультатДлительнойОперации = ДлительныеОперации.ВыполнитьВФоне("э_ОбщиеСервер.ЗагрузитьНакладнуюПоНомеруВагона", НомерВагона, ПараметрыВыполненияВФоне);
КонецПроцедуры

&НаСервере
Функция НетЗапущеныхРанееЗаданий(КлючПоискаФоновогоЗадания)
	
	Если КлючПоискаФоновогоЗадания = "ЗагрузитьИзЭТРАНПоНомеруНаСервере" Тогда 
		КлючФоновогоЗадания = "ЗагрузкаНакладнойИзЭТРАНПоНомеру";
		Если ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Ключ,Состояние", КлючФоновогоЗадания, СостояниеФоновогоЗадания.Активно)).Количество() > 0 Тогда 
			Возврат Ложь;
		КонецЕсли; 
	КонецЕсли;
	
	Если КлючПоискаФоновогоЗадания = "ЗагрузитьИзЭТРАНПоНомеруВагонаНаСервере" Тогда
		КлючФоновогоЗадания = "ЗагрузкаНакладнойИзЭТРАНПоНомеруВагона";
		Если ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Ключ,Состояние", КлючФоновогоЗадания, СостояниеФоновогоЗадания.Активно)).Количество() > 0 Тогда 
			Возврат Ложь;
		КонецЕсли; 	
	КонецЕсли;
	
	Возврат Истина;

КонецФункции


