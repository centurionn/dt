Процедура ПерепровестиВсеНаСервере()
	
	Запрос = Новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	э_Накладная.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.э_Накладная КАК э_Накладная
	               |ГДЕ
	               |	НЕ э_Накладная.ПометкаУдаления";
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		ОтветСсылка = Ответ.Ссылка.ПолучитьОбъект();
		ОтветСсылка.Записать(РежимЗаписиДокумента.Запись);
		
	КонецЦикла;
	
