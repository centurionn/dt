&НаКлиенте
Процедура Подключаемый_ПроверитьВыполнениеЗадания(Результат = "", ДополнительныеПараметры = "") Экспорт
	Попытка
		Если РезультатДлительнойОперации.Статус = "Выполнено" Или ЗаданиеВыполнено(РезультатДлительнойОперации.ИдентификаторЗадания) Тогда 
			РезультатВыполнения = ПолучитьИзВременногоХранилища(РезультатДлительнойОперации.АдресРезультата);
			Если Не РезультатВыполнения = Неопределено Тогда 
				Если РезультатВыполнения.Свойство("МассивРезультатов") Тогда
					Если РезультатВыполнения.МассивРезультатов.Количество() = 0 Тогда 
						Сообщить("По вагону " + Строка(РезультатВыполнения.НомерВагона) + " не найдено накладных");
						Возврат;
					КонецЕсли;
					Для Каждого РезультатИзМассива из РезультатВыполнения.МассивРезультатов Цикл 
						СообщениеПользователю = Новый СообщениеПользователю;
						СообщениеПользователю.КлючДанных = РезультатИзМассива.Ссылка;
						СообщениеПользователю.Текст = РезультатИзМассива.Сообщение;
						СообщениеПользователю.Сообщить();
						Если ЗначениеЗаполнено(РезультатИзМассива.Ссылка) Тогда 
							ПоказатьОповещениеПользователя(РезультатВыполнения.Сообщение, ПолучитьНавигационнуюСсылку(РезультатИзМассива.Ссылка));
						КонецЕсли;
					КонецЦикла;
				Иначе
					СообщениеПользователю = Новый СообщениеПользователю;
					СообщениеПользователю.КлючДанных = РезультатВыполнения.Ссылка;
					СообщениеПользователю.Текст = РезультатВыполнения.Сообщение;
					СообщениеПользователю.Сообщить();
					Если ЗначениеЗаполнено(РезультатВыполнения.Ссылка) Тогда 
						ПоказатьОповещениеПользователя(РезультатВыполнения.Сообщение, ПолучитьНавигационнуюСсылку(РезультатВыполнения.Ссылка));
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		Иначе
			ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
			ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
			ПараметрыОжидания.Интервал = 3;
			ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатДлительнойОперации, Новый ОписаниеОповещения("Подключаемый_ПроверитьВыполнениеЗадания", ЭтотОбъект),ПараметрыОжидания);
		КонецЕсли;
	Исключение        
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

