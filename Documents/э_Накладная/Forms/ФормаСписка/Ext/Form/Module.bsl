&НаКлиенте
Процедура НомерВагонаОтборПриИзменении(Элемент)
	СписокСсылок = ПолучитьСписокоДокументовПоВагону();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СписокВходящие.Отбор, "Ссылка", СписокСсылок, ВидСравненияКомпоновкиДанных.ВСписке,, ЗначениеЗаполнено(НомерВагонаОтбор));
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокоДокументовПоВагону()
	Если ЗначениеЗаполнено(НомерВагонаОтбор) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	э_НакладнаяВагоны.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.э_Накладная.Вагоны КАК э_НакладнаяВагоны
		|ГДЕ
		|	(э_НакладнаяВагоны.Вагон = &Вагон
		|			ИЛИ э_НакладнаяВагоны.НомерВагона = &НомерВагона)
		|
		|СГРУППИРОВАТЬ ПО
		|	э_НакладнаяВагоны.Ссылка";
		
		Запрос.УстановитьПараметр("Вагон", НомерВагонаОтбор);
		Запрос.УстановитьПараметр("НомерВагона", НомерВагонаОтбор.Код);
		
		Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Иначе
		Возврат Документы.э_Накладная.ПустаяСсылка();
	КонецЕсли;
КонецФункции

