Функция ПолучитьТаблицуДвиженийСчетаПокупателейПоУчетнымЕдиницам()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
			|	ОтчетКомитентуОПродажахТовары.Ссылка.Организация КАК Организация,
			|	ОтчетКомитентуОПродажахТовары.Ссылка.Контрагент КАК Контрагент,
			|	ОтчетКомитентуОПродажахТовары.Ссылка.ДоговорКонтрагента КАК ДоговорКонтрагента,
			//Евросиб Шевченко А.В. US 112685 TA 114398 22.07.2025
			//|	ОтчетКомитентуОПродажахТовары.Ссылка.СчетНаОплатуПокупателю КАК СчетПокупателю,
			|	ЕстьNULL(ОтчетКомитентуОПродажахСчетаНаОплатуПокупателям.СчетПокупателю,ЗНАЧЕНИЕ(Документ.СчетНаОплатуПокупателю.ПустаяСсылка)) КАК СчетПокупателю,
			//Евросиб Шевченко А.В. US 112685 TA 114398 22.07.2025
			|	ОтчетКомитентуОПродажахТовары.Ссылка.Дата КАК Период,
			|	ОтчетКомитентуОПродажахТовары.Ссылка.Сделка КАК Сделка,
			|	ОтчетКомитентуОПродажахТовары.Номенклатура КАК Номенклатура,
			|	СУММА(ВЫБОР
			|			КОГДА ОтчетКомитентуОПродажахТовары.Ссылка.СуммаВключаетНДС
			|				ТОГДА ОтчетКомитентуОПродажахТовары.Сумма
			|			ИНАЧЕ ОтчетКомитентуОПродажахТовары.Сумма + ОтчетКомитентуОПродажахТовары.СуммаНДС
			|		КОНЕЦ) КАК Сумма,
			|	ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Контейнер КАК Контейнер,
			|	СУММА(ОтчетКомитентуОПродажахТовары.Количество) КАК Количество
			|ИЗ
			|	Документ.ОтчетКомитентуОПродажах.Товары КАК ОтчетКомитентуОПродажахТовары
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтчетКомитентуОПродажах.РасшифровкаУслугПоТС КАК ОтчетКомитентуОПродажахРасшифровкаУслугПоТС
			|		ПО ОтчетКомитентуОПродажахТовары.Ссылка = ОтчетКомитентуОПродажахРасшифровкаУслугПоТС.Ссылка
