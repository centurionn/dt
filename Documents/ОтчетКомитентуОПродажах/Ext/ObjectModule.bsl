Процедура СформироватьДвиженияВзаиморасчетыСПокупателями() Экспорт

	ВзаиморасчетыСПокупателями = Движения.ВзаиморасчетыСПокупателями;
	ВзаиморасчетыСПокупателями.Записывать = Истина;
	
	Если ВидОперации = Перечисления.ВидыОперацийОтчетКомитентуОПродажах.ОтчетОЗакупках Тогда
		
		Для Каждого СтрокаТЧ Из Товары Цикл
			
			Движение = ВзаиморасчетыСПокупателями.ДобавитьРасход();
			Движение.Период = Макс(ДатаДокумента, ПериодВО);
			Движение.Организация = Организация;
			Движение.Контрагент = Контрагент;
			Движение.Договор = ДоговорКонтрагента;
			Движение.ВалютаРасчетов = ВалютаДокумента;
			Движение.ДатаРасчетов = ДатаДокумента;
			Движение.ДокументВзаиморасчетов = Ссылка;
			Движение.ВидЗадолженности = СтрокаТЧ.ВидЗадолженности;
			
			Движение.СуммаБезНДС = ?(СуммаВключаетНДС, СтрокаТЧ.Сумма - СтрокаТЧ.СуммаНДС, СтрокаТЧ.Сумма);
			Движение.СуммаНДС = СтрокаТЧ.СуммаНДС;
			Движение.СуммаСНДС = ?(СуммаВключаетНДС, СтрокаТЧ.Сумма, СтрокаТЧ.Сумма + СтрокаТЧ.СуммаНДС);
			//Движение.СуммаБезНДСРуб = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Движение.СуммаБезНДС, ПараметрыКурсаДокумента, ПараметрыКурсаРегл);
			//Движение.СуммаНДСРуб = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Движение.СуммаНДС, ПараметрыКурсаДокумента, ПараметрыКурсаРегл);
			//Движение.СуммаСНДСРуб = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Движение.СуммаСНДС, ПараметрыКурсаДокумента, ПараметрыКурсаРегл);
			Движение.ЭтоВР = Истина;
			
			// Вознагражение
			Если СпособРасчетаКомиссионногоВознаграждения <> Перечисления.СпособыРасчетаКомиссионногоВознаграждения.НеРассчитывается Тогда
				
				Движение = Движения.ВзаиморасчетыСПокупателями.Добавить();
				Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
				Движение.Период = Макс(ДатаДокумента, ПериодВО);
				Движение.Организация = Организация;
				Движение.Контрагент = Контрагент;
				Движение.Договор = ДоговорКонтрагента;
				Движение.ВалютаРасчетов = ВалютаДокумента;
				Движение.ДатаРасчетов = ДатаДокумента;
				Движение.ДокументВзаиморасчетов = Ссылка;
				Движение.ВидЗадолженности = СтрокаТЧ.ВидЗадолженности;
				
				Движение.СуммаБезНДС = ?(СуммаВознагражденияВключаетНДС, СтрокаТЧ.СуммаВознаграждения - СтрокаТЧ.СуммаНДСВознаграждения, СтрокаТЧ.СуммаВознаграждения);
				Движение.СуммаНДС = СтрокаТЧ.СуммаНДСВознаграждения;
				Движение.СуммаСНДС = ?(СуммаВознагражденияВключаетНДС, СтрокаТЧ.СуммаВознаграждения, СтрокаТЧ.СуммаВознаграждения + СтрокаТЧ.СуммаНДСВознаграждения);
				//Движение.СуммаБезНДСРуб = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Движение.СуммаБезНДС, ПараметрыКурсаДокумента, ПараметрыКурсаРегл);
				//Движение.СуммаНДСРуб = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Движение.СуммаНДС, ПараметрыКурсаДокумента, ПараметрыКурсаРегл);
				//Движение.СуммаСНДСРуб = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Движение.СуммаСНДС, ПараметрыКурсаДокумента, ПараметрыКурсаРегл);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
		
КонецПроцедуры

