Функция НайтиСчетНаОплату(КомиссионныеУслуги)
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СчетНаОплатуПокупателю.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Документ.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю
	                      |ГДЕ
	                      |	СчетНаОплатуПокупателю.КомиссионныеУслуги = &КомиссионныеУслуги
	                      |	И СчетНаОплатуПокупателю.ДокументыОснования.Документ = &ДокументОснование");
	Запрос.УстановитьПараметр("ДокументОснование", Ссылка);
	Запрос.УстановитьПараметр("КомиссионныеУслуги", КомиссионныеУслуги);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Счет = Выборка.Ссылка;
	Иначе
		Счет = Документы.СчетНаОплатуПокупателю.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Счет;
КонецФункции

Функция ВыписатьСчетФактуру(ДокументОснование, ДокументПартии = Неопределено) Экспорт
	СчФ = Документы.СчетФактураВыданный.СоздатьДокумент();
	БухгалтерскийУчетОбщиеПроцедурыСервер.ЗаполнитьРеквизитыСчФПоОснованию(ДокументОснование,СчФ,ДокументПартии);

	СчФ.Записать();
	Возврат СчФ;
КонецФункции

