		СчФ = БухгалтерскийУчетОбщиеПроцедурыСервер.НайтиПодчиненныйСчетФактуру(Ссылка,"СчетФактураВыданный",Стр.Партия);
		Если СчФ <> Неопределено Тогда
			ОбСчФ = СчФ.ПолучитьОбъект();
			Если Не ОбСчФ.ПометкаУдаления Тогда
