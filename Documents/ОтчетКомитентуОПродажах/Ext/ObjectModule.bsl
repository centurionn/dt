Процедура СформироватьНомерДляПечати()
	//Евросиб Шевченко А.В. US 112685 TA 114398 22.07.2025
	//СчетАв = СчетНаОплатуПокупателю;
	СчетАв = Документы.СчетНаОплатуПокупателю.ПустаяСсылка();
	Если СчетаНаОплатуПокупателям.Количество()>0 Тогда
		СчетАв = СчетаНаОплатуПокупателям[0].СчетПокупателю;
	КонецЕсли;
	//Евросиб Шевченко А.В. US 112685 TA 114398 22.07.2025
	НомерДляПечатиДоИзменения = НомерДляПечати;
	НомерДляПечатиВознаграждениеДоИзменения = НомерДляПечатиВознаграждение;
	НомерДляПечати = СтрШаблон("%1/%2/%3",
								Номер,
								СчетАВ.Номер,
								?(Контрагент.СтранаРегистрации = Справочники.СтраныМира.Россия,"Р","Н"));
	Если ЗначениеЗаполнено(РезервНомераВознаграждение) Тогда
		НомерДляПечатиВознаграждение= СтрШаблон("%1/%2/%3",
												РезервНомераВознаграждение.Номер,
												СчетАВ.Номер,
												?(Контрагент.СтранаРегистрации = Справочники.СтраныМира.Россия,"Р","Н"));
	КонецЕсли;											
	Если ЗначениеЗаполнено(Ссылка) И (НомерДляПечати <> НомерДляПечатиДоИзменения ИЛИ НомерДляПечати <> НомерДляПечатиДоИзменения) Тогда
		ДокументВЗакрытомПериоде = КонтрольДоступностиДокументов_сервер.ПроверкаДоступностиПоПериоду(Ссылка);
		Если НЕ ДокументВЗакрытомПериоде Тогда
			//Удаление признака выгрузки
			ЗаписьПротоколаОбмена = РегистрыСведений.ПротоколОбменов.СоздатьМенеджерЗаписи();
			ЗаписьПротоколаОбмена.УзелОбмена = Перечисления.УзлыОбмена.УПП;
			ЗаписьПротоколаОбмена.Объект = Ссылка;
			ЗаписьПротоколаОбмена.ДействиеПриОбмене = Перечисления.ДействияПриОбмене.ВыгрузкаДанных;
			ЗаписьПротоколаОбмена.Удалить();
			ОбщегоНазначения.СообщитьПользователю("Изменился номер для печати, признак выгрузки снят. Был номер " + НомерДляПечатиДоИзменения + " стал " + НомерДляПечати);
		Иначе
			НомерДляПечати = НомерДляПечатиДоИзменения;
			НомерДляПечатиВознаграждение = НомерДляПечатиВознаграждениеДоИзменения;
			ОбщегоНазначения.СообщитьПользователю("Документ выгружен во внешнюю систему, номер для печати не будет изменен");
		КонецЕсли; 
	КонецЕсли; 
	
	СтруктураПоиска = Новый Структура("СчетПокупателю",СчетАв);
	
	НайденныеСтроки = СчетаНаОплатуПокупателям.НайтиСтроки(СтруктураПоиска);
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		НайденнаяСтрока.НомерДляПечати = НомерДляПечати;
	КонецЦикла;	
	
КонецПроцедуры

