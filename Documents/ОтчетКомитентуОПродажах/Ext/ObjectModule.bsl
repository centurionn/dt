				ОбменДанными.Загрузка = Ложь;
				Сообщить("Документ счет-фактура № " + СчФ.Номер + " от " + Формат(СчФ.Дата,"ДФ=dd.MM.yyyy") + " на перевыставляемые услуги записан в базу.");
			КонецЕсли;
		Иначе
			Если Не ПометкаУдаления	Тогда
			СчФ = Стр.СчетФактура;
			
			БухгалтерскийУчетОбщиеПроцедурыСервер.ЗаполнитьРеквизитыСчФПоОснованию(Ссылка,СчФ,Стр.Партия);
			
