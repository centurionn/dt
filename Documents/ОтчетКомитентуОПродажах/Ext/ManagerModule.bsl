Функция ПолучитьПоступление(Ссылка) Экспорт
	
	РезультатПоступление = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ОтчетКомитентуОПродажахПоставщики.Партия КАК Партия
		|ИЗ
		|	Документ.ОтчетКомитентуОПродажах.Поставщики КАК ОтчетКомитентуОПродажахПоставщики
		|ГДЕ
		|	ОтчетКомитентуОПродажахПоставщики.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		РезультатПоступление = ВыборкаДетальныеЗаписи.Партия;
	КонецЕсли;
	
	Возврат РезультатПоступление;
	
КонецФункции
//Евросиб(ДИТ), Беляев СЮ, US 89714 / TA 89717, 09-12-2024, конец

//Евросиб(ДИТ), Беляев СЮ, US 88169 / TA 88173, 26-03-2025, начало
Функция ОпределитьДатыДокументов(Организация, Подрядчик, Контрагент, Договор, ДатаВСФ, ДатаОтчетаКомитенту = Неопределено) Экспорт
	
	//Евросиб Каблов 09.04.2025 ( #105407
	//ПериодВО = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериод(Организация);
	ПериодВО = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериодДоходов(Организация);
	//Евросиб Каблов 09.04.2025 )
	
	Даты = Новый Структура;
	Даты.Вставить("ДатаОтчетаЭкспедитора", Неопределено);
	Даты.Вставить("ДатаИСФнаВР", Неопределено);
	Даты.Вставить("ДатаИСФнаВознаграждение", Неопределено);
	
	ПодрядчикРезидент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Подрядчик, "СтранаРегистрации") = Справочники.СтраныМира.Россия;
	КонтрагентРезидент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "СтранаРегистрации") = Справочники.СтраныМира.Россия;
	КатегорияДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "КатегорияДоговора");
	
	ДатаИСФнаВР_равнаДатеВСФ = Ложь;
	
	Если ПодрядчикРезидент И КонтрагентРезидент Тогда
		Если КатегорияДоговора = Справочники.КатегорииДоговоров.ТЭУслуги Тогда
			
				Если ДатаВСФ >= НачалоМесяца(ПериодВО)  Тогда
					
					Даты.ДатаОтчетаЭкспедитора = ДатаВСФ;
					//Даты.ДатаИСФнаВР = ДатаВСФ;
					//Даты.ДатаИСФнаВознаграждение = ДатаВСФ;
					ДатаИСФнаВР_равнаДатеВСФ = Истина;
					
				ИначеЕсли ТекущаяДата() > КонецМесяца(ПериодВО) Тогда
					
					Даты.ДатаОтчетаЭкспедитора = КонецМесяца(ПериодВО);
					//Даты.ДатаИСФнаВР = КонецМесяца(ПериодВО);
					//Даты.ДатаИСФнаВознаграждение = КонецМесяца(ПериодВО);
					
				Иначе
					
					Даты.ДатаОтчетаЭкспедитора = ТекущаяДата();
					//Даты.ДатаИСФнаВР = ТекущаяДата();
					//Даты.ДатаИСФнаВознаграждение = ТекущаяДата();
					
				КонецЕсли;
				
			
		//ИначеЕсли КатегорияДоговора = Справочники.КатегорииДоговоров.ПредоставлениеВагонов Тогда
		Иначе //в правилах определения дат вариант с Справочники.КатегорииДоговоров.ПредоставлениеВагонов справедлив для всех остальных договоров
			
				Если ДатаВСФ >= НачалоМесяца(ПериодВО)  Тогда
					
					Даты.ДатаОтчетаЭкспедитора = ДатаВСФ;
					//Даты.ДатаИСФнаВР = ДатаВСФ;
					//Даты.ДатаИСФнаВознаграждение = ДатаВСФ;
					ДатаИСФнаВР_равнаДатеВСФ = Истина;
					
				ИначеЕсли ТекущаяДата() > КонецМесяца(ПериодВО) Тогда
					
					Даты.ДатаОтчетаЭкспедитора = КонецМесяца(ПериодВО);
					//Даты.ДатаИСФнаВР = ДатаВСФ;
					//Даты.ДатаИСФнаВознаграждение = КонецМесяца(ПериодВО);
					ДатаИСФнаВР_равнаДатеВСФ = Истина;
					
				Иначе
					
					Даты.ДатаОтчетаЭкспедитора = ТекущаяДата();
					//Даты.ДатаИСФнаВР = ДатаВСФ;
					//Даты.ДатаИСФнаВознаграждение = ТекущаяДата();
					ДатаИСФнаВР_равнаДатеВСФ = Истина;
					
				КонецЕсли;
				
		КонецЕсли;
		
	ИначеЕсли НЕ ПодрядчикРезидент И КонтрагентРезидент Тогда
		
		Если ДатаВСФ >= НачалоМесяца(ПериодВО)  Тогда
			
			Даты.ДатаОтчетаЭкспедитора = ДатаВСФ;
			//Даты.ДатаИСФнаВР = ДатаВСФ;
			//Даты.ДатаИСФнаВознаграждение = ДатаВСФ;
			ДатаИСФнаВР_равнаДатеВСФ = Истина;
			
		ИначеЕсли ТекущаяДата() > КонецМесяца(ПериодВО) Тогда
			
			Даты.ДатаОтчетаЭкспедитора = КонецМесяца(ПериодВО);
			//Даты.ДатаИСФнаВР = КонецМесяца(ПериодВО);
			//Даты.ДатаИСФнаВознаграждение = КонецМесяца(ПериодВО);
			
		Иначе
			
			Даты.ДатаОтчетаЭкспедитора = ТекущаяДата();
			//Даты.ДатаИСФнаВР = ТекущаяДата();
			//Даты.ДатаИСФнаВознаграждение = ТекущаяДата();
			
		КонецЕсли;
		
	Иначе
		
		Если ДатаВСФ >= НачалоМесяца(ПериодВО)  Тогда
			
			Даты.ДатаОтчетаЭкспедитора = ДатаВСФ;
			//Даты.ДатаИСФнаВР = ДатаВСФ;
			//Даты.ДатаИСФнаВознаграждение = ДатаВСФ;
			ДатаИСФнаВР_равнаДатеВСФ = Истина;
			
		ИначеЕсли ТекущаяДата() > КонецМесяца(ПериодВО) Тогда
			
			Даты.ДатаОтчетаЭкспедитора = КонецМесяца(ПериодВО);
			//Даты.ДатаИСФнаВР = КонецМесяца(ПериодВО);
			//Даты.ДатаИСФнаВознаграждение = КонецМесяца(ПериодВО);
			
		Иначе
			
			Даты.ДатаОтчетаЭкспедитора = ТекущаяДата();
			//Даты.ДатаИСФнаВР = ТекущаяДата();
			//Даты.ДатаИСФнаВознаграждение = ТекущаяДата();
			
		КонецЕсли;
		
	КонецЕсли;
	
	Даты.ДатаИСФнаВознаграждение = Даты.ДатаОтчетаЭкспедитора;
	Даты.ДатаИСФнаВР = Даты.ДатаОтчетаЭкспедитора;
	Если ДатаОтчетаКомитенту <> Неопределено Тогда
		Даты.ДатаИСФнаВР = ДатаОтчетаКомитенту; //установили равной дату из уже записанного Отчета комитенту
	КонецЕсли;
	Если ДатаИСФнаВР_равнаДатеВСФ Тогда
		Даты.ДатаИСФнаВР = ДатаВСФ;
	КонецЕсли;
	
	
	Возврат Даты;
	
КонецФункции
//Евросиб(ДИТ), Беляев СЮ, US 88169 / TA 88173, 26-03-2025, конец