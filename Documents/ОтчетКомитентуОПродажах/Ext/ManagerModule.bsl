Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода,Знач СтруктураПодписантов = Неопределено) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ОтчетАгента") Тогда
		СформироватьПечатнуюФорму(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, "ОтчетАгента", "Отчет агента",
			ОбъектыПечати, ПараметрыВывода,СтруктураПодписантов);
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "УниверсальныйПередаточныйДокумент981") Тогда
		СформироватьПечатнуюФормуУПД(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм,"УниверсальныйПередаточныйДокумент981", "Универсальный передаточный документ",
		ОбъектыПечати, ПараметрыВывода);

	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктСдачиПриемки") Тогда
								ПараметрыПечати.Вставить("ВидДокументаПечати",  "ОтчетКомитентуОПродажах");
				ПараметрыПечати.Вставить("ИмяПараметровПечати", "ПАРАМЕТРЫ_ПЕЧАТИ_ОтчетКомитентуОПродажах_Акт");
				ПараметрыПечати.Вставить("ИмяМакетаПечати",     "Документ.ОтчетКомитентуОПродажах.ПФ_MXL_АктСдачиПриемки");
				СформироватьПечатнуюФормуАкта(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, "АктСдачиПриемки", "Акт сдачи-приемки",
			ОбъектыПечати, ПараметрыВывода,СтруктураПодписантов);
	КонецЕсли;                    

КонецПроцедуры

Процедура СформироватьПечатнуюФормуУПД (МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ИмяМакета, СинонимМакета, ОбъектыПечати, ПараметрыВывод)
	Для каждого ЭлМассива из МассивОбъектов Цикл
		
			ТаблицаСведенийСчетФактуры = ПолучитьТаблицуСведенийДляУПД(ЭлМассива);
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, ИмяМакета, СинонимМакета,
			ПечатьБухгалтерскихДокументов.ПечатьУПД981(ТаблицаСведенийСчетФактуры, ОбъектыПечати,ПараметрыПечати),,"ОбщийМакет.ПФ_MXL_УниверсальныйПередаточныйДокумент981");
			КонецЦикла;	
	
	
КонецПроцедуры

Процедура СформироватьПечатнуюФормуАкта(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ИмяМакета, СинонимМакета, ОбъектыПечати, ПараметрыВывода,СтруктураПодписантов)
	Для каждого ЭлМассива из МассивОбъектов Цикл
//Евросиб Литвинов 19.08.2021 ( #35933 #36212
		Если ПечатьКомплектаДокументов.ПолучитьПечатнуюФормуИзДиадок(КоллекцияПечатныхФорм, ЭлМассива, ИмяМакета, СинонимМакета) Тогда
			Продолжить;
		КонецЕсли;
//Евросиб Литвинов 19.08.2021 ) #35933 #36212 
		ТаблицаСведенийАктаОбОказанииУслуг = ПолучитьТаблицуСведенийАктаОбОказанииУслуг(ЭлМассива);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "АктСдачиПриемки", "Акт сдачи-приемки", 
					ПечатьБухгалтерскихДокументов.ПечатьАктаОбОказанииУслуг(ТаблицаСведенийАктаОбОказанииУслуг, ОбъектыПечати, ПараметрыПечати,СтруктураПодписантов),, 
							"Документ.РеализацияТоваровУслуг.ПФ_MXL_АктСдачиПриемки");
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьТаблицуСведенийАктаОбОказанииУслуг(Документ) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	ТаблицаСведений = ПечатьБухгалтерскихДокументов.ПолучитьОписаниеАктаОбОказанииУслуг();
	Запрос = Новый Запрос();
	Запрос.Текст = ПолучитьТекстЗапросаДляФормированияТаблицыСведенийАктаОбОказанииУслуг();
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("Продавец", Справочники.Контрагенты.ПустаяСсылка());
	Запрос.УстановитьПараметр("ДатаСреза",Документ.Дата);
	//ДИТ, Беляев СЮ, TA48059, 12-04-2022, начало
	ДоговорКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "ДоговорКонтрагента"); 
	Запрос.УстановитьПараметр("БанковскийСчетОрганизации", ОбщегоНазначенияВызовСервера.РасчетныйСчетПоДоговору(ДоговорКонтрагента)); 
	//ДИТ, Беляев СЮ, TA48059, 12-04-2022, конец
	РезультатыЗапроса = Запрос.ВыполнитьПакет();

	Выборка = РезультатыЗапроса[0].Выбрать();
	СтрокиДокументов = РезультатыЗапроса[1].Выгрузить();
	СТрокиРасшифровки = РезультатыЗапроса[2].Выгрузить();
	ВалютаРегУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Пока Выборка.Следующий() Цикл
		
		СведенияОДокументе = ТаблицаСведений.Добавить();
		ЗаполнитьЗначенияСвойств(СведенияОДокументе, Выборка);
		СведенияОДокументе.ДоверенностьЗаРуководителя = Выборка.ДоверенностьЗаРуководителя;
		СведенияОДокументе.ДоверенностьЗаГлБухгалтера = Выборка.ДоверенностьЗаГлБухгалтера;
		ТаблицаДокумента = ПечатьБухгалтерскихДокументов.ПолучитьОписаниеТаблицыАктаОбОказанииУслуг();
		ТаблицаРасшифровки = ПечатьБухгалтерскихДокументов.ПолучитьОписаниеТаблицыРасшифровки();

		
		Для Каждого Строка Из СтрокиДокументов Цикл
			
			СтрокаТаблицыДокумента = ТаблицаДокумента.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицыДокумента, Строка);

		КонецЦикла;
	    СведенияОДокументе.ТаблицаДокумента = ТаблицаДокумента;
		Для каждого Строка из СТрокиРасшифровки Цикл
			СтрТаблицы = ТаблицаРасшифровки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрТаблицы, Строка);
		КонецЦикла;
		СведенияОДокументе.ТаблицаРасшифровки =  ТаблицаРасшифровки;
	КонецЦикла;
	

	Возврат ТаблицаСведений;
		
КонецФункции

