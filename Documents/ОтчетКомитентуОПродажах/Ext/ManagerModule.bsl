Функция ПолучитьТаблицуСведенийДляУПД(Документ)
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаСведений = ПечатьБухгалтерскихДокументов.ПолучитьОписаниеСчетФактуры();
	ТаблицаДокумента = ПечатьБухгалтерскихДокументов.ПолучитьОписаниеТаблицыСчетФактуры();
	
	ТекстЗапроса = ПолучитьТекстЗапросаДляПечатиУПД();
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	ЗАпрос.УстановитьПараметр("Документ",Документ);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СведенияОДокументе = ТаблицаСведений.Добавить();
		ЗаполнитьЗначенияСвойств(СведенияОДокументе,Выборка);
//Евросиб ( Литвинов 21.01.2021 #30025
		//СведенияОДокументе.ПредставлениеПоставщика = Выборка.Продавец.НаименованиеПолное;
		//Евросиб - АСуслов 06.09.2023 13:53:22 #74705
		//(
		//СведенияОДокументе.ПредставлениеПоставщика = Справочники.Организации.НаименованияНаДату(Выборка.Продавец, Выборка.ДатаДокумента, Выборка.Продавец.НаименованиеПолное).НаименованиеПолное;
		НаименованияНаДату = Справочники.Организации.НаименованияНаДату(Выборка.Продавец, Выборка.ДатаДокумента, Выборка.Продавец.НаименованиеПолное);
		СведенияОДокументе.ПредставлениеПоставщика = НаименованияНаДату.НаименованиеПолное;
		//)
		//Евросиб - АСуслов 06.09.2023 13:53:25 #74705
//Евросиб ) Литвинов 21.01.2021 #30025
		СведенияОДокументе.АдресПоставщика = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Выборка.Продавец,
		?(ТипЗнч(Выборка.Продавец)=Тип("СправочникСсылка.Контрагенты"),Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента,Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации),Выборка.ДатаДокумента,Истина);
		СведенияОДокументе.ПредставлениеГрузоотправителя = "-";
		СведенияОДокументе.ПредставлениеГрузополучателя  = "-";
		СведенияОДокументе.ПредставлениеПокупателя = Выборка.Контрагент.НаименованиеПолное;
		//Евросиб - АСуслов 06.09.2023 13:54:16 #74705
		//(
		//СведенияОДокументе.ИННПоставщика = Выборка.ИННПоставщика+"/"+Выборка.КПППродавца;
		СведенияОДокументе.ИННПоставщика = Выборка.ИННПоставщика+"/"+НаименованияНаДату.КПП;
		//)
		//Евросиб - АСуслов 06.09.2023 13:54:18 #74705
		СведенияОДокументе.ПоДокументу = "К платежно-расчетному документу №"+?(ЗначениеЗаполнено(СведенияОДокументе.НомерПлатежноРасчетногоДокумента),СведенияОДокументе.НомерПлатежноРасчетногоДокумента,"_______")
		+"от"+?(СведенияОДокументе.ДатаПлатежноРасчетногоДокумента<>Дата('00010101'),СведенияОДокументе.ДатаПлатежноРасчетногоДокумента,"_______");
		СведенияОДокументе.АдресПокупателя = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Выборка.Контрагент,Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента,Выборка.ДатаДокумента,Истина);
		СведенияОДокументе.ИННПокупателя =Выборка.ИННПокупателя+"/"+Выборка.КПППокупателя;
		
		ТекстЗАпроса = ПолучитьТекстЗапросаДляПечатиТаблицыУПД();
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("Документ",Документ);
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		Пока РезультатЗапроса.Следующий() Цикл
			Строка = ТаблицаДокумента.Добавить();
			ЗаполнитьЗначенияСвойств(Строка,РезультатЗапроса);
			Строка.Цена = РезультатЗАпроса.Стоимость;
			Строка.Всего = РезультатЗапроса.Сумма;//?(РезультатЗапроса.СуммаВключаетНДС,РезультатЗапроса.Сумма, РезультатЗапроса.Стоимость + РезультатЗапроса.СуммаНДС);
		КонецЦикла;
		СведенияОДокументе.ТаблицаДокумента = ТаблицаДокумента;
	КонецЦикла;	
	
	Возврат ТаблицаСведений;
КонецФункции

Функция ПолучитьТекстЗапросаДляПечатиУПД()
	ТекстЗапроса = "ВЫБРАТЬ
	|	ЛОЖЬ КАК Исправление,
	|	ЗНАЧЕНИЕ(Перечисление.ВидСчетаФактурыВыставленного.НаРеализацию) КАК ВидСчетаФактуры,
	//  |	ОтчетКомитентуОПродажах.Номер КАК Номер,
	|	ОтчетКомитентуОПродажах.НомерДляПечати КАК Номер,
	//   |	ОтчетКомитентуОПродажах.Дата КАК ДатаДокумента,
	|	ОтчетКомитентуОПродажах.ДатаДокумента КАК ДатаДокумента,
	|	ОтчетКомитентуОПродажах.Ссылка КАК Документ,
	|	ОтчетКомитентуОПродажах.Организация КАК Организация,
	|	ОтчетКомитентуОПродажах.Контрагент КАК Контрагент,
	|	ОтчетКомитентуОПродажах.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ОтчетКомитентуОПродажах.ВалютаДокумента КАК ВалютаДокумента,
	|	ОтчетКомитентуОПродажах.КурсВзаиморасчетов КАК КурсВзаиморасчетов,
	|	ОтчетКомитентуОПродажах.КратностьВзаиморасчетов КАК КратностьВзаиморасчетов,
	|	ОтчетКомитентуОПродажах.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ОтчетКомитентуОПродажах.Ответственный КАК Ответственный,
	|	ОтчетКомитентуОПродажах.ДоговорКонтрагента.Номер КАК НомерДоговора,
	|	ОтчетКомитентуОПродажах.ДоговорКонтрагента.Дата КАК ДатаДоговора,
	|	ОтчетКомитентуОПродажах.Организация КАК Продавец,
	|	ОтчетКомитентуОПродажах.Контрагент.КПП КАК КПППокупателя,
	|	ОтчетКомитентуОПродажах.Организация.КПП КАК КПППродавца,
	|	ОтчетКомитентуОПродажах.Организация.ИНН КАК ИННПоставщика,
	|	ОтчетКомитентуОПродажах.Контрагент.ИНН КАК ИННПокупателя,
	|	ОтчетКомитентуОПродажах.ВалютаДокумента.Код КАК ВалютаКод,
	|	ОтчетКомитентуОПродажах.ВалютаДокумента.Наименование КАК ВалютаНаименование
	|ИЗ
	|	Документ.ОтчетКомитентуОПродажах КАК ОтчетКомитентуОПродажах
	|ГДЕ
	|	ОтчетКомитентуОПродажах.Ссылка = &Документ";	
	Возврат ТекстЗАпроса;
КонецФункции

