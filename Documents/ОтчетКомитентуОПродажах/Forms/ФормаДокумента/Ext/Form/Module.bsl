&НаСервере
Процедура СоздатьСчетНаОплатуНаВРНаСервере(ОбФормыСчета)
	СтруктураПараметровСчетаНаОплату = ПолучитьСтруктуруПараметровДляЗаполненияСчетаНаОплату();
	ДокОбъект = ДанныеФормыВЗначение(ОбФормыСчета,Тип("ДокументОбъект.СчетНаОплатуПокупателю"));
	
	ДокОбъект.Заполнить(СтруктураПараметровСчетаНаОплату);
	ЗначениеВДанныеФормы(ДокОбъект,ОбФормыСчета);
	
КонецПроцедуры


&НаКлиенте
Процедура СоздатьСчетНаОплатуНаВР(Команда)
	ФормаСчета = ПолучитьФорму("Документ.СчетНаОплатуПокупателю.Форма.ФормаДокумента");
	ОбФормыСчета = ФормаСчета.Объект;
	СоздатьСчетНаОплатуНаВРНаСервере(ОбФормыСчета);
	
	КопироватьДанныеФормы(ОбФормыСчета,ФормаСчета.Объект);
	ФормаСчета.Модифицированность = Истина;
	ФормаСчета.Открыть();
КонецПроцедуры

