			Если СтрТ.КлючСтроки = КлючСтроки Тогда
				СуммаНДСПоСтрокеПартии = СуммаНДСПоСтрокеПартии+СтрТ.СуммаНДС;
				СуммаИтогоПоСтрокеПартии = СуммаИтогоПоСтрокеПартии+СтрТ.Сумма+?(Объект.СуммаВключаетНДС,0,СтрТ.СуммаНДС);
			КонецЕсли;
		КонецЦикла;
		Стр.Всего = СуммаИтогоПоСтрокеПартии;
