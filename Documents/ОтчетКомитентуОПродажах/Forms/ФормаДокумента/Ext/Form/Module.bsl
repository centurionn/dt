&НаСервере
Процедура ВыписатьСчФВыданныеДляКомитентаНаСервере()
Для каждого Стр из Объект.Поставщики Цикл	
	Если Не ЗначениеЗаполнено(Стр.СчетФактура) Тогда
	    СчФ = БухгалтерскийУчетОбщиеПроцедурыСервер.НайтиПодчиненныйСчетФактуру(Объект.Ссылка,"СчетФактураВыданный",Стр.Партия);
		Если СчФ <> Неопределено Тогда
			Если СчФ.ПометкаУдаления Тогда
				ОбСФ = СчФ.ПолучитьОбъект();
				ОБСФ.ПометкаУдаления = Ложь;
				БухгалтерскийУчетОбщиеПроцедурыСервер.ЗаполнитьРеквизитыСчФПоОснованию(Объект.Ссылка,СчФ,Стр.Партия);
			Иначе
				БухгалтерскийУчетОбщиеПроцедурыСервер.ЗаполнитьРеквизитыСчФПоОснованию(Объект.Ссылка,СчФ,Стр.Партия);
			КонецЕсли;
		Иначе
		//	Если Не ЗначениеЗаполнено(Стр.СчетФактура) Тогда
			 СчФ = ВыписатьСчетФактуру(Объект,Стр.Партия);
		КонецЕсли;
		Если СчФ <> Неопределено Тогда
			 Стр.СчетФактура = СчФ.Ссылка;
			 Объект.НомерДляПечати = СчФ.НомерДляПечати;
		КонецЕсли;
	Иначе
		
		 СчФ = Стр.СчетФактура;
		 БухгалтерскийУчетОбщиеПроцедурыСервер.ЗаполнитьРеквизитыСчФПоОснованию(Объект.Ссылка,СчФ,Стр.Партия);
		 Объект.НомерДляПечати = СчФ.НомерДляПечати;
	 КонецЕсли;
 КонецЦикла;
  ЗаписатьДокумент();
КонецПроцедуры

&НаСервере
Функция ВыписатьСчетФактуру(ДокументОснование, ДокументПартии) Экспорт
	СчФ = Документы.СчетФактураВыданный.СоздатьДокумент();
	БухгалтерскийУчетОбщиеПроцедурыСервер.ЗаполнитьРеквизитыСчФПоОснованию(Объект.Ссылка,СчФ,ДокументПартии);
	СчФ.Записать();
	Возврат СчФ;
КонецФункции

&НаКлиенте
Процедура ВыписатьСчФВыданныеДляКомитента(Команда)
	ОповещениеОтветаВопроса = Новый ОписаниеОповещения("ОбработкаВопросаЗаписиПередВыполнениемКоманды", ЭтаФорма);
	Если Не ЗначениеЗаполнено(Объект.Ссылка) или ЭтаФорма.Модифицированность Тогда
		ПоказатьВопрос(ОповещениеОтветаВопроса, "Перед созданием счетов-фактур документ необходимо записать. Продолжить?", РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Нет);
	Иначе
		ВыписатьСчФВыданныеДляКомитентаНаСервере();
		Для каждого Стр из Объект.Товары Цикл
			БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(Стр,Объект.СуммаВключаетНДС);
			//Евросиб СубботинВ #120291 24.09.2025 Начало
			//Стр.ВсегоВознаграждения = Стр.СуммаВознаграждения + ?(Объект.СуммаВключаетНДС,0,Стр.СуммаНДСВознаграждения);
			Стр.ВсегоВознаграждения = Стр.СуммаВознаграждения + ?(Объект.СуммаВознагражденияВключаетНДС, Стр.СуммаНДСВознаграждения, 0);
			//Евросиб СубботинВ #120291 24.09.2025 Конец
		КонецЦикла;

		РассчитатьСуммыВсегоПоДокументу();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаЗаписиПередВыполнениемКоманды(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;
	
	Если Параметр2 = неопределено Тогда
		ЗаписатьДокумент();
		ВыписатьСчФВыданныеДляКомитентаНаСервере();
		РассчитатьСуммыВсегоПоДокументу();
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДокумент()
	ЭтотОбъект.Записать();
КонецПроцедуры

&НаКлиенте
Процедура Товары1СтавкаНДСПриИзменении(Элемент)
	СтрТЧ = Элементы.Товары1.ТекущиеДанные;
	БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуСтрокиТабличнойЧасти(СтрТЧ);
	СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиент.ПолучитьСуммуНДС(СтрТЧ.Сумма, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(СТрТЧ.СтавкаНДС), Объект.УчитыватьНДС, Объект.СуммаВключаетНДС);
	СтрТч.СуммаНДС = СуммаНДС;
	БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(СтрТЧ,Объект.СуммаВключаетНДС);
	РасчитатьВознаграждение();
	РассчитатьСуммыВсегоПоДокументу();

КонецПроцедуры

