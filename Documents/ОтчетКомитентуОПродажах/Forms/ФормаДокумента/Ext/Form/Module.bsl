&НаКлиенте
Процедура ОткрытьФормуВыбораРеализации(СпособЗаполнения)
	
	ПараметрыОтбора = Новый Структура("Организация",	Объект.Организация);
	ПараметрыФормы = Новый Структура("Отбор, МножественныйВыбор", ПараметрыОтбора, Ложь);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("СпособЗаполнения", СпособЗаполнения);
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ЗаполнитьПоРеализацииНаКлиентеЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Документ.РеализацияТоваровУслуг.ФормаВыбора", ПараметрыФормы, ЭтаФорма,,,, ОповещениеОЗакрытии);

КонецПроцедуры
	
&НаКлиенте
Процедура ЗаполнитьПоРеализацииНаКлиентеЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	СпособЗаполнения = ДополнительныеПараметры.СпособЗаполнения; 
	
	Реализация = РезультатЗакрытия;
	
	Если НЕ ЗначениеЗаполнено(Реализация) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПроданнымиНаСервере(СпособЗаполнения, Реализация);
	Если ЗначениеЗаполнено(Объект.СтавкаНДСВознаграждения) и Объект.ПроцентКомиссионногоВознаграждения>0 Тогда
		РасчитатьВознаграждение();
	КонецЕсли;
	Для каждого Стр из Объект.Товары Цикл
		
		БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(Стр,Объект.СуммаВключаетНДС);
		//Евросиб СубботинВ #120291 24.09.2025 Начало
		//Стр.ВсегоВознаграждения = Стр.СуммаВознаграждения + ?(Объект.СуммаВключаетНДС,0,Стр.СуммаНДСВознаграждения);
		Стр.ВсегоВознаграждения = Стр.СуммаВознаграждения + ?(Объект.СуммаВознагражденияВключаетНДС, Стр.СуммаНДСВознаграждения, 0);
		//Евросиб СубботинВ #120291 24.09.2025 Конец 	

	КонецЦикла;
	
	РассчитатьСуммыВсегоПоДокументу();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПроданнымиНаСервере(СпособЗаполнения = "ЗаполнитьПоРеализации", Реализация = Неопределено)
		Объект.Товары.Очистить();
		МаксимальныйКлючСтроки = 0;
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Организация",Объект.Организация);
		СтруктураПараметров.Вставить("Реализация",Реализация);
		СтруктураПараметров.Вставить("Контрагент",Объект.Контрагент);
		РезультатЗапроса = Документы.ОтчетКомитентуОПродажах.ЗаполнитьПоРеализации(СтруктураПараметров);
		
		ВыборкаТовары = РезультатЗапроса.Выбрать();
		Если Реализация.ВалютаДокумента <> Объект.ВалютаДокумента Тогда
			Пока ВыборкаТовары.Следующий() Цикл
				
				СтрТовары = Объект.Товары.Добавить();
				СтрТовары.Номенклатура = ВыборкаТовары.Номенклатура;
				СтрТовары.Количество = ВыборкаТовары.Количество;
				СтрТовары.СтавкаНДС = ВыборкаТовары.СтавкаНДС;
				СтрТовары.Сумма = РаботаСКурсамиВалют.ПересчитатьВВалюту(ВыборкаТовары.СуммаНДС,Реализация.ВалютаДокумента,Объект.ВалютаДокумента,Объект.ДатаДокумента);
				СтрТовары.Цена =СтрТовары.Сумма/СтрТовары.Количество;
				СтрТовары.Содержание = ВыборкаТовары.Содержание;
				СтрТовары.Покупатель = ВыборкаТовары.Контрагент;
				СтрТовары.ДатаРеализации = ВыборкаТовары.Дата;
				СтрТовары.КлючСтроки = МаксимальныйКлючСтроки;
			КонецЦикла;
		Иначе			
			Пока ВыборкаТовары.Следующий() Цикл
				
				СтрТовары = Объект.Товары.Добавить();
				СтрТовары.Номенклатура = ВыборкаТовары.Номенклатура;
				СтрТовары.Количество = ВыборкаТовары.Количество;
				СтрТовары.СтавкаНДС = ВыборкаТовары.СтавкаНДС;
				СтрТовары.Сумма = ВыборкаТовары.Сумма;
				СтрТовары.СуммаНДС = ВыборкаТовары.СуммаНДС;
				СтрТовары.Цена = ВыборкаТовары.Цена;
				СтрТовары.Содержание = ВыборкаТовары.Содержание;
				СтрТовары.Покупатель = ВыборкаТовары.Контрагент;
				СтрТовары.ДатаРеализации = ВыборкаТовары.Дата;
				СтрТовары.КлючСтроки = МаксимальныйКлючСтроки;
			КонецЦикла;
		КонецЕсли;
		ОБъект.ДокументОснование = Реализация;
	//Объект.ВалютаДокумента = Реализация.ВалютаДокумента;
		Объект.СуммаДокумента  = Объект.Товары.Итог("Сумма") + ?(Объект.СуммаВключаетНДС,0,Объект.Товары.Итог("СуммаНДС"));
	
			
КонецПроцедуры

