&НаСервере
Процедура ПересчитатьСуммыДокументаПоВалютеВзаиморасчетов(ТекущаяСтруктура, НоваяСтруктура)
	//ДИТ, Беляев СЮ, BUG 76518 / TA 76823, 03-11-2023, начало
	ОкруглениеКурса = Справочники.ФормированиеФинДокументов.ПолучитьЗначениеОкругленияКурсаИзПравил(Объект.ПравилоФормирования);
	//ДИТ, Беляев СЮ, BUG 76518 / TA 76823, 03-11-2023, конец
	Для каждого Стр из Объект.Товары Цикл
		//Стр.Всего = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Стр.Всего, ТекущаяСтруктура,НоваяСтруктура);
		//ДИТ, Беляев СЮ, BUG 76518 / TA 76823, 03-11-2023, начало
		Стр.Всего = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Стр.Всего, ТекущаяСтруктура,НоваяСтруктура, , ОкруглениеКурса);
		//ДИТ, Беляев СЮ, BUG 76518 / TA 76823, 03-11-2023, конец
		Стр.Сумма = ?(Объект.СуммаВключаетНДС, Стр.Всего,Стр.Всего/(1+(БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Стр.СтавкаНДС)/100)));
		Стр.СуммаНДС = ?(Объект.СуммаВключаетНДС,  Стр.Всего*БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Стр.СтавкаНДС)/100,Стр.Всего- Стр.Сумма);
		Стр.Цена = Стр.Сумма/Стр.Количество;
	КонецЦикла;
КонецПроцедуры
	
