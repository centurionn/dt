&НаКлиенте
Процедура УстановитьВидимостьСтраниц()
	Если ЗначениеЗаполнено(Объект.ВидОперации) Тогда
		
		Если ЭтоЗакупка() Тогда
			Элементы.СтраницаТоварыПродажа.Видимость = Ложь;
			Элементы.СтраницаТоварыЗакупка.Видимость = Истина;
			Элементы.ГруппаПодвалТоварыУслугиОзакупках.Видимость = Истина;
			Элементы.ДенежныеСредства.Видимость = Ложь;
		Иначе
			Элементы.СтраницаТоварыПродажа.Видимость = Истина;
			Элементы.СтраницаТоварыЗакупка.Видимость = Ложь;
			Элементы.ГруппаПодвалТоварыУслугиОзакупках.Видимость = Ложь;
			Элементы.ДенежныеСредства.Видимость = Истина;
		КонецЕсли;		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьДоступностьЭлементов()
	
	СпособНеРасчитывать = (Объект.СпособРасчетаКомиссионногоВознаграждения = ПредопределенноеЗначение("Перечисление.СпособыРасчетаКомиссионногоВознаграждения.НеРассчитывается"));
	СпособУказыватьСуммы = (Объект.СпособРасчетаКомиссионногоВознаграждения = ПредопределенноеЗначение("Перечисление.СпособыРасчетаКомиссионногоВознаграждения.УказываютсяСуммы"));
	
	Элементы.ГруппаВознаграждениеПравая.Видимость = НЕ СпособНеРасчитывать;
	Элементы.СчетФактураПросмотр.Видимость = НЕ СпособНеРасчитывать;
	Элементы.ИтогиПоВознаграждению.Видимость = НЕ СпособНеРасчитывать;
	Элементы.ТоварыСуммаВознаграждения.Видимость = НЕ СпособНеРасчитывать;
	Элементы.ТоварыСуммаНДСВознаграждения.Видимость = НЕ СпособНеРасчитывать;
	Элементы.ТоварыВсегоВознаграждения.Видимость = НЕ СпособНеРасчитывать;
	Элементы.ГруппаВознаграждениеПравая.Доступность = НЕ СпособНеРасчитывать;
	Элементы.СчетФактураПросмотр.Доступность = НЕ СпособНеРасчитывать;
	Элементы.ИтогиПоВознаграждению.Доступность = НЕ СпособНеРасчитывать;
	Элементы.ТоварыСуммаВознаграждения.Доступность = НЕ СпособНеРасчитывать;
	Элементы.ТоварыСуммаНДСВознаграждения.Доступность = НЕ СпособНеРасчитывать;
	Элементы.ТоварыВсегоВознаграждения.Доступность = НЕ СпособНеРасчитывать;
	
	Элементы.ПроцентКомиссионногоВознаграждения.Видимость = Не СпособУказыватьСуммы;
	
КонецПроцедуры

&НаСервере
Функция ЭтоЗакупка()
	Если Объект.ВидОперации = Перечисления.ВидыОперацийОтчетКомитентуОПродажах.ОтчетОЗакупках Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
		
КонецФункции

&НаКлиенте
Процедура УчитыватьНДСНажатие(Элемент)
	ОбъектА = ЭтотОбъект.Объект;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("УчитыватьНДС", ОбъектА.УчитыватьНДС);
	ПараметрыФормы.Вставить("СуммаВключаетНДС", ОбъектА.СуммаВключаетНДС);
	ОткрытьФорму("ОбщаяФорма.УчетНДСВДокументах",ПараметрыФормы,ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура СпособРасчетаКомиссионногоВознагражденияПриИзменении(Элемент)
	
	СпособНеРасчитывать = (Объект.СпособРасчетаКомиссионногоВознаграждения = ПредопределенноеЗначение("Перечисление.СпособыРасчетаКомиссионногоВознаграждения.НеРассчитывается"));
	

	Если НЕ СпособНеРасчитывать Тогда
		Если Объект.ПроцентКомиссионногоВознаграждения > 0 Тогда
			Если Объект.УчитыватьНДС Тогда
				Если ЗначениеЗаполнено(Объект.СтавкаНДСВознаграждения) Тогда
					РасчитатьВознаграждение();
				КонецЕсли;
			Иначе
				РасчитатьВознаграждение();
			КонецЕсли;
		КонецЕСли;	
				
	КонецЕсли;
	Если НЕ СпособНеРасчитывать Тогда
		РеквизитыСФ = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьРеквизитыСчетФактуры(Объект,"СчетФактураВыданный");
		Если РеквизитыСФ <> Неопределено Тогда
			Если РеквизитыСф.ПОметкаУдаления = Истина Тогда
				Элементы.ВвестиСчетФактуру.Заголовок = "Ввести счет-фактуру";
				Иначе
				Элементы.ВвестиСчетФактуру.Заголовок = БухгалтерскийУчетОбщиеПроцедурыКлиент.ЗаполнитьНадписьСчФ(РеквизитыСФ);
				КонецЕсли;
			КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция РассчитыватьПроцентом(СпособРасчета)
	Если СпособРасчета = Перечисления.СпособыРасчетаКомиссионногоВознаграждения.НеРассчитывается Тогда
		Возврат Ложь;
	Иначе Возврат Истина;
	КонецЕсли;
КонецФункции

&НаСервере
Функция РассчитыватьВознаграждение(СпособРасчета)
	Если СпособРасчета = Перечисления.СпособыРасчетаКомиссионногоВознаграждения.НеРассчитывается Тогда
		Возврат Ложь;
	Иначе Возврат Истина;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ОбработкаВыбораУчетНДС(Форма, ВыбранноеЗначение, ИсточникВыбора)
	ЗаполнитьЗначенияСвойств(Объект, ВыбранноеЗначение);
	Если не Объект.УчитыватьНДС Тогда
	Элементы.СтавкаНДСВознаграждения.Доступность = Ложь;
	Элементы.Товары1СуммаНДСВознаграждения.Доступность = Ложь;
	Элементы.СтавкаНДСВознаграждения.Видимость = Ложь;
	Элементы.Товары1СуммаНДСВознаграждения.Видимость = Ложь;
КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
		Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.УчетНДСВДокументах" Тогда
		ОбработкаВыбораУчетНДС(ЭтаФорма,ВыбранноеЗначение,ИсточникВыбора);
			ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.КурсВалютыВДокументах" Тогда
		ОбработкаВыбораКурсыВалют(ЭтаФорма,ВыбранноеЗначение,ИсточникВыбора);
	

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораКурсыВалют(Форма, ВыбранноеЗначение, ИсточникВыбора)
	СтараяВалюта = Объект.ВалютаДокумента;
	СтарыйКурс = Объект.КурсВзаиморасчетов;
	СтараяКратность = Объект.КратностьВзаиморасчетов;
	
	Объект.ВалютаДокумента = ВыбранноеЗначение.ВалютаДокумента;
	Объект.КратностьВзаиморасчетов = ВыбранноеЗначение.КратностьВзаиморасчетов;
	Объект.КурсВзаиморасчетов = ВыбранноеЗначение.КурсВзаиморасчетов;
	//Евросиб - АСуслов 21.09.2021 12:58:32 #
	//(
	Объект.ДатаКурса = ВыбранноеЗначение.ДатаДокумента;
	//)
	//Евросиб - АСуслов 21.09.2021 12:58:33 #
	Если СтараяВалюта <> Объект.ВалютаДокумента или СтарыйКурс <> Объект.КурсВзаиморасчетов Тогда
		СтруктураТекущая = Новый Структура;
		СтруктураТекущая.Вставить("Валюта",СтараяВалюта);
		СтруктураТекущая.Вставить("Курс",СтарыйКурс);
		СтруктураТекущая.Вставить("Кратность",СтараяКратность);
		СтруктураНовая = Новый Структура;
		СтруктураНовая.Вставить("Валюта",Объект.ВалютаДокумента);
		СтруктураНовая.Вставить("Курс",Объект.КурсВзаиморасчетов);
		СтруктураНовая.Вставить("Кратность",Объект.КратностьВзаиморасчетов);
		
		ПересчитатьСуммыДокументаПоВалютеВзаиморасчетов(СтруктураТекущая,СтруктураНовая);
		РасчитатьВознаграждение();
		РассчитатьСуммыВсегоПоДокументу();
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
			
	УстановитьВидимостьСтраниц();
КонецПроцедуры

&НаКлиенте
Процедура ПроцентКомиссионногоВознагражденияПриИзменении(Элемент)
	Если Объект.УчитыватьНДС Тогда
		Если (ЗначениеЗаполнено(Объект.СтавкаНДСВознаграждения)) и Объект.ПроцентКомиссионногоВознаграждения > 0 Тогда
			РасчитатьВознаграждение();
		КонецЕсли;
	Иначе
		РасчитатьВознаграждение();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СтавкаНДСВознагражденияПриИзменении(Элемент)
	Если Объект.ПроцентКомиссионногоВознаграждения > 0 Тогда
		РасчитатьВознаграждение();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РасчитатьВознаграждение()
	Для каждого СТр из Объект.Товары Цикл
		Если Объект.СпособРасчетаКомиссионногоВознаграждения = ПредопределенноеЗначение("Перечисление.СпособыРасчетаКомиссионногоВознаграждения.ПроцентОтРазностиСуммПродажиИПоступления") 
			ИЛИ Объект.СпособРасчетаКомиссионногоВознаграждения = ПредопределенноеЗначение("Перечисление.СпособыРасчетаКомиссионногоВознаграждения.ПроцентОтСуммыПродажи") Тогда	
			//Евросиб СубботинВ #120291 24.09.2025 Начало
            //Стр.СуммаВознаграждения = (Стр.Сумма - Стр.СуммаНДС)*Объект.ПроцентКомиссионногоВознаграждения/100;
			Стр.СуммаВознаграждения = (Стр.Сумма - ?(Объект.СуммаВключаетНДС, Стр.СуммаНДС, 0))*Объект.ПроцентКомиссионногоВознаграждения/100;
			//Евросиб СубботинВ #120291 24.09.2025 Конец
				//Стр.СуммаВознаграждения = Стр.Сумма*Объект.ПроцентКомиссионногоВознаграждения/100;
		//Евросиб Шевченко 16.09.2025
