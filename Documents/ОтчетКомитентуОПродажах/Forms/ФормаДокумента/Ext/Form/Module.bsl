	//ИтогиВознаграждение = Объект.Товары.Итог("СуммаВознаграждения") + ИтогиНДСВознаграждение;
	//Евросиб СубботинВ #120291 24.09.2025 Начало 
	//ИтогиНДСВознаграждение = Объект.Товары.Итог("СуммаНДСВознаграждения");
	//Если Объект.СуммаВознагражденияВключаетНДС Тогда
	//	ИтогиВознаграждение = Объект.Товары.Итог("СуммаВознаграждения");
	//Иначе
	//	ИтогиВознаграждение = Объект.Товары.Итог("СуммаВознаграждения") + ИтогиНДСВознаграждение;
	//КонецЕсли;
	//БазаРасчета = Объект.Товары.Итог("СуммаВознаграждения");
	//
	////расчет ндс в рамках задачи реализован так, что ндс всегда "сверху" базы расчета, и  включен он или нет, влияет только на саму сумму вознаграждения
	//ИтогиНДСВознаграждение = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСуммуНДС(БазаРасчета,
