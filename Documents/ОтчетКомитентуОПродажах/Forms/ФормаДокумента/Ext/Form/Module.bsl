	ИтогиНДСВознаграждение = Объект.Товары.Итог("СуммаНДСВознаграждения");
	ИтогиВознаграждение = Объект.Товары.Итог("СуммаВознаграждения") + ?(Объект.СуммаВознагражденияВключаетНДС, ИтогиНДСВознаграждение, 0);
