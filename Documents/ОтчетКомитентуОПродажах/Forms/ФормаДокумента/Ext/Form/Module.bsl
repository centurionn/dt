		БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(Стр,Объект.СуммаВключаетНДС); 
		//Евросиб СубботинВ #120291 24.09.2025 Начало
		//Стр.ВсегоВознаграждения = Стр.СуммаВознаграждения + ?(Объект.СуммаВключаетНДС,0,Стр.СуммаНДСВознаграждения);
		Стр.ВсегоВознаграждения = Стр.СуммаВознаграждения + ?(Объект.СуммаВознагражденияВключаетНДС, Стр.СуммаНДСВознаграждения, 0);
		//Евросиб СубботинВ #120291 24.09.2025 Конец 	

	КонецЦикла;
	
	УстановитьДатыДокумента();
	РассчитатьСуммыВсегоПоДокументу();
	
