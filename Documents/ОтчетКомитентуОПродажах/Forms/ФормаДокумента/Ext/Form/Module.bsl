	СтруктураПараметров = Новый Структура("НомерДляПечати,Организация,Контрагент,ДоговорКонтрагента,ПодразделениеОрганизации,ВалютаДокумента,КурсВзаиморасчетов,КратностьВзаиморасчетов,УчитыватьНДС,СуммаВключаетНДС");
	ЗаполнитьЗначенияСвойств(СтруктураПараметров,Объект);
	СтруктураПараметров.Вставить("ДокументОснование",Объект.Ссылка);
	СтруктураПараметров.Вставить("ТаблицаДокумента",Объект.Товары.Выгрузить());
	Возврат СтруктураПараметров;
КонецФункции

