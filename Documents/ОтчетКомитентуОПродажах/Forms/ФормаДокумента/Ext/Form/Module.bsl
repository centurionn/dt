&НаСервере
Процедура ЗаполнитьЗакупленнымиНаСервере(СпособЗаполнения = "ЗаполнитьПоПоступлению", Поступление = Неопределено)
		Объект.Товары.Очистить();
		Объект.Поставщики.Очистить();
		МаксимальныйКлючСтроки = 0;
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Организация",Объект.Организация);
		СтруктураПараметров.Вставить("Поступление",Поступление);
		
		РезультатЗапроса = Документы.ОтчетКомитентуОПродажах.ЗаполнитьПоПоступлению(СтруктураПараметров);
		
		ВыборкаПоставщики = РезультатЗапроса[0].Выбрать();
		ВыборкаТовары = РезультатЗапроса[1].Выгрузить();
		
		Пока ВыборкаПоставщики.Следующий() Цикл
			МаксимальныйКлючСтроки = МаксимальныйКлючСтроки+1;
			НовСтр = Объект.Поставщики.Добавить();
			НовСтр.Поставщик = ВыборкаПоставщики.Поставщик;
			НовСтр.Партия = ВыборкаПоставщики.Партия;
			НовСтр.ПолученСФ = ?(ЗначениеЗаполнено(ВыборкаПоставщики.НомерСчетаФактуры),Истина,Ложь);
			НовСтр.ДатаСФ = ВыборкаПоставщики.ДатаСФ;
			НовСтр.НомерСчетаФактуры = ВыборкаПоставщики.НомерСчетаФактуры;
			НовСтр.КПППоставщика = ВыборкаПоставщики.КПППоставщика;
			НовСтр.КлючСтроки = МаксимальныйКлючСтроки;
			ОтборСтрокТовары = Новый Структура;
			ОтборСтрокТовары.Вставить("Партия",ВыборкаПоставщики.Партия);
			Товары = ВыборкаТовары.НайтиСтроки(ОтборСтрокТовары);
				
			Если Товары.Количество()>0 Тогда
				Если ВыборкаПоставщики.ВалютаДокумента <> Объект.ВалютаДокумента Тогда
					Для каждого Эл Из Товары Цикл
						СтрТовары = Объект.Товары.Добавить();
						СтрТовары.Номенклатура = Эл.Номенклатура;
						СтрТовары.Количество = Эл.Количество;
						СтрТовары.СтавкаНДС = Эл.СтавкаНДС;
						СтрТовары.Содержание = Эл.Содержание;
						СтрТовары.КлючСтроки = МаксимальныйКлючСтроки;
						СтрТовары.Сумма = РаботаСКурсамиВалют.ПересчитатьВВалюту(Эл.Сумма,ВыборкаПоставщики.ВалютаДокумента,Объект.ВалютаДокумента,Объект.ДатаДокумента);
						СтрТовары.СуммаНДС = РаботаСКурсамиВалют.ПересчитатьВВалюту(Эл.СуммаНДС,ВыборкаПоставщики.ВалютаДокумента,Объект.ВалютаДокумента,Объект.ДатаДокумента);
						СтрТовары.Цена = СтрТовары.Сумма/СтрТовары.Количество;
						СтрТовары.ГУИДПТУ = Эл.ГУИДПТУ;
					КонецЦикла;
				Иначе
					Для каждого Эл Из Товары Цикл
						СтрТовары = Объект.Товары.Добавить();
						СтрТовары.Номенклатура = Эл.Номенклатура;
						СтрТовары.Количество = Эл.Количество;
						СтрТовары.СтавкаНДС = Эл.СтавкаНДС;
						СтрТовары.Сумма = Эл.Сумма;
						СтрТовары.СуммаНДС = Эл.СуммаНДС;
						СтрТовары.Цена = Эл.Цена;
						СтрТовары.Содержание = Эл.Содержание;
						СтрТовары.КлючСтроки = МаксимальныйКлючСтроки;
						СтрТовары.ГУИДПТУ = Эл.ГУИДПТУ;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Объект.ДокументОснование = Поступление;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоПоступлению(Команда)
		Если Объект.Товары.Количество() + Объект.Поставщики.Количество() > 0 Тогда
			ТекстВопроса = НСтр("ru = 'Перед заполнением табличная часть будет очищена. Заполнить?'") ;
			Оповещение = Новый ОписаниеОповещения("ВопросПередЗаполнениеПоПоступлениюЗавершение", ЭтотОбъект);
			ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Да, Заголовок);
		Иначе
			ОткрытьФормуВыбораПоступления("ЗаполнитьПоПоступлению");
		КонецЕсли;

КонецПроцедуры

