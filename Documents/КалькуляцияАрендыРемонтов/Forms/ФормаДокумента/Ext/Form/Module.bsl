КонецПроцедуры

&НаСервере
Процедура СформироватьТЗСОтбором(ОтборУстановлен)
	
	Если ОтборУстановлен Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ВремТЧ.Вагон КАК Вагон,
		               |	ВремТЧ.СутокАренды КАК СутокАренды,
		               |	ВремТЧ.ТехПеремещение КАК ТехПеремещение,
		               |	ВремТЧ.КоммПеремещение КАК КоммПеремещение,
		               |	ВремТЧ.НеКоммПеремещение КАК НеКоммПеремещение,
		               |	ВремТЧ.КоммПростой КАК КоммПростой,
		               |	ВремТЧ.Ремонт КАК Ремонт,
		               |	ВремТЧ.СНП КАК СНП,
		               |	ВремТЧ.НекоммерческийПростой КАК НекоммерческийПростой,
		               |	ВремТЧ.ПересечениеДанных КАК ПересечениеДанных
		               |ПОМЕСТИТЬ ВТ
		               |ИЗ
		               |	&ВремТЧ КАК ВремТЧ
		               |ГДЕ
		               |	ВремТЧ.ПересечениеДанных > 0
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВТ.Вагон КАК Вагон,
		               |	ВТ.СутокАренды КАК СутокАренды,
		               |	ВТ.ТехПеремещение КАК ТехПеремещение,
		               |	ВТ.КоммПеремещение КАК КоммПеремещение,
		               |	ВТ.НеКоммПеремещение КАК НеКоммПеремещение,
		               |	ВТ.КоммПростой КАК КоммПростой,
		               |	ВТ.Ремонт КАК Ремонт,
		               |	ВТ.СНП КАК СНП,
		               |	ВТ.НекоммерческийПростой КАК НекоммерческийПростой,
		               |	ВТ.ПересечениеДанных КАК ПересечениеДанных
		               |ИЗ
		               |	ВТ КАК ВТ";
		Запрос.УстановитьПараметр("ВремТЧ",ТЧСводно.Выгрузить());
		ТЗ = Запрос.Выполнить().Выгрузить();
		ТЧСводно.Загрузить(ТЗ);
		
		ФильтрСтруктура = Новый ФиксированнаяСтруктура("ПересечениеДанных", Истина);
		Элементы.ТЧ.ОтборСтрок = ФильтрСтруктура;
	Иначе
		Элементы.ТЧ.ОтборСтрок = Неопределено;
		
		ТЗ = Объект.ТЧ.Выгрузить();
		// сворачиваем таблицу, если по вагону было несколько операций
		ТЗ.Свернуть("Вагон,СутокАренды","ТехПеремещение,КоммПеремещение,НеКоммПеремещение,КоммПростой,Ремонт,СНП,НекоммерческийПростой,ПересечениеДанных");
		ТЧСводно.Загрузить(ТЗ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВагоныИзEXCEL(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаДобавленияНомерныхПозиций", ЭтаФорма, Новый Структура("Вагоны", Истина));
	ОткрытьФорму("ОбщаяФорма.ВставкаИзБуфераОбмена", Новый Структура("Вагоны", Истина), , ЭтаФорма.УникальныйИдентификатор, ,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаДобавленияНомерныхПозиций(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если параметр1 = Неопределено тогда 
		возврат; 
	КонецЕсли;
	
	Для каждого Стр из параметр1 Цикл
		ЭтаФорма.ВагоныОтбор.Добавить(Стр);
	КонецЦикла;
	
КонецПроцедуры

