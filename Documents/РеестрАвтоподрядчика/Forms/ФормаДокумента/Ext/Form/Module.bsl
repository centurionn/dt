		|ГДЕ
		|	СборнаяТаблица.БазоваяСтавкаНадбавка = ЛОЖЬ
		|	И СборнаяТаблица.НомерКТК <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
		|	И СборнаяТаблица.ТипКТК <> ЗНАЧЕНИЕ(Справочник.ТипоразмерыТЕ.ПустаяСсылка)
		|	И СборнаяТаблица.АдресПогрузкиВыгрузки <> ЗНАЧЕНИЕ(Справочник.АдресаВНаселенныхПунктах.ПустаяСсылка)
		|	И СборнаяТаблица.ТипОперацииНаТерминалеПостановки = ЗНАЧЕНИЕ(Перечисление.ТипОперацииНаТерминале.ПриемПорожнегоКТК)
		|	И СборнаяТаблица.ТипОперацииНаТерминалеСдачи = ЗНАЧЕНИЕ(Перечисление.ТипОперацииНаТерминале.СдачаГруженогоКТК)
		|	И СборнаяТаблица.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.АвтоперевозкаГруженыйКонтейнер)
		|	И СборнаяТаблица.СовпадениеПунктОтправления = ЛОЖЬ
		|	И СборнаяТаблица.СовпадениеПунктНазначения = ИСТИНА
		|	И СборнаяТаблица.СовпаденииеАдресов = ИСТИНА";

	Запрос.УстановитьПараметр("ТаблицаРеестра", Объект.Заказы.Выгрузить());
	ПакетРезультатовЗапросов = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	ТаблицаОсновныхСтавок = ПакетРезультатовЗапросов[10].Выгрузить();
	ТаблицаНаличияКотировок = ПакетРезультатовЗапросов[9].Выгрузить(); 
	Ошибки = Неопределено;
	
	Для ИндексСтроки = ?(Перезаполнить, 0,Элементы.РеестрАвтоподрядчика.ТекущаяСтрока) По ?(ЗаполнятьВниз ИЛИ Перезаполнить, Объект.Заказы.Количество() - 1, Элементы.РеестрАвтоподрядчика.ТекущаяСтрока) Цикл
		СтрокаЗаказа = Объект.Заказы[ИндексСтроки];	
		СтруктураПоиска = Новый Структура();
		СтруктураПоиска.Вставить("КлючАналитики", СтрокаЗаказа.КлючАналитики);
		СтруктураПоиска.Вставить("ЗапросНаАвто", СтрокаЗаказа.ЗапросНаАвто);
		СтруктураПоиска.Вставить("ИдентификаторСтрокиЗапросаНаАвтоперевозку", СтрокаЗаказа.ИдентификаторСтрокиЗапросаНаАвтоперевозку);

		СтрокиОсновнойСтавки = ТаблицаОсновныхСтавок.НайтиСтроки(СтруктураПоиска);
		
		Если СтрокиОсновнойСтавки.Количество() = 0 Тогда
			СтрокаЗаказа.ОсновнаяСтавка = 0;
			СтрокаЗаказа.ОсновнаяСтавкаОшибка = "Ставка не найдена";
			СтруктураПоиска.Вставить("Номенклатура", Справочники.Номенклатура.АвтоперевозкаГруженыйКонтейнер);
			ОтсутствиеКотировок = ТаблицаНаличияКотировок.НайтиСтроки(СтруктураПоиска).Количество() = 0;
			СтруктураПоиска.Удалить("Номенклатура");
			Если СтрокаЗаказа.БазоваяСтавкаНадбавка Тогда
				
				ТекстОшибки = СтрШаблон("В строке №%1 невозможно подобрать основную ставку - при наличии Базовой ставки расчет не возможен", СтрокаЗаказа.НомерСтроки);
				
			ИначеЕсли СтрокаЗаказа.ТипКТК = Справочники.ТипоразмерыТЕ.ПустаяСсылка() ИЛИ СтрокаЗаказа.НомерКТК = Справочники.ТЕ.ПустаяСсылка() Тогда
				
				ТекстОшибки = СтрШаблон("В строке №%1 невозможно применить ставку по номенклатуре «АвтоперевозкаГруженый КТК»/«АвтоперевозкаПорожнийКТК»", СтрокаЗаказа.НомерСтроки);
				
			ИначеЕсли СтрокаЗаказа.АдресПогрузкиВыгрузкиСсылка = Справочники.АдресаВНаселенныхПунктах.ПустаяСсылка() Тогда
				
				Если СтрокаЗаказа.ТерминалПостановки = Справочники.Локации.ПустаяСсылка() 
					ИЛИ СтрокаЗаказа.ТерминалСдачи = Справочники.Локации.ПустаяСсылка() Тогда
					
					ТекстОшибки = СтрШаблон("В строке №%1 не найдена ставка по перевозке груженого КТК, т.к. не указан склад погрузки/выгрузки или отсутствует пункт выдачи/сдачи в маршруте", СтрокаЗаказа.НомерСтроки);
				
				ИначеЕсли СтрокаЗаказа.ТипОперацииНаТерминалеСдачи = Перечисления.ТипОперацииНаТерминале.СдачаГруженогоКТК 
					И СтрокаЗаказа.ТипОперацииНаТерминалеПостановки = Перечисления.ТипОперацииНаТерминале.ПриемГруженогоКТК Тогда
					
					ТекстОшибки = СтрШаблон("В строке №%1 не найдена ставка за перевозку по средней миле, т.к. не найдено совпадения по маршруту", СтрокаЗаказа.НомерСтроки);
					
				ИначеЕсли СтрокаЗаказа.ТипОперацииНаТерминалеСдачи = Перечисления.ТипОперацииНаТерминале.СдачаПорожнегоКТК
					И СтрокаЗаказа.ТипОперацииНаТерминалеПостановки = Перечисления.ТипОперацииНаТерминале.ПриемПорожнегоКТК Тогда
					
					ТекстОшибки = СтрШаблон("В строке №%1 не найдена ставка за перевозку порожнего КТК, т.к. не найдено совпадения по маршруту", СтрокаЗаказа.НомерСтроки);	
					
				Иначе
					
					ТекстОшибки = СтрШаблон("В строке №%1 не найдена ставка по перевозке груженого КТК, т.к. не указан склад погрузки/выгрузки или отсутствует пункт выдачи/сдачи в маршруте", СтрокаЗаказа.НомерСтроки);	
					
				КонецЕсли;
				
			ИначеЕсли (СтрокаЗаказа.ТипОперацииНаТерминалеСдачи = Перечисления.ТипОперацииНаТерминале.СдачаГруженогоКТК 
				И СтрокаЗаказа.ТипОперацииНаТерминалеПостановки = Перечисления.ТипОперацииНаТерминале.ПриемГруженогоКТК)
				ИЛИ (СтрокаЗаказа.ТипОперацииНаТерминалеСдачи = Перечисления.ТипОперацииНаТерминале.СдачаПорожнегоКТК
				И СтрокаЗаказа.ТипОперацииНаТерминалеПостановки = Перечисления.ТипОперацииНаТерминале.ПриемПорожнегоКТК) Тогда
				
				ТекстОшибки = СтрШаблон("В строке №%1 не найдена ставка, т.к. не найдено совпадения по маршруту и отсутствует один из пунктов выдачи/сдачи КТК", СтрокаЗаказа.НомерСтроки);
				
			ИначеЕсли ОтсутствиеКотировок Тогда
				ТекстОшибки = СтрШаблон("В строке №%1 в ПСЦ по строке Реестра нет котировки по «АвтоперевозкаГруженыйКонтейнер»", СтрокаЗаказа.НомерСтроки);
			Иначе
				ТекстОшибки = СтрШаблон("В строке №%1 Не найдена ставка за перевозку груженого КТК», т.к. не найдено совпадения по маршруту", СтрокаЗаказа.НомерСтроки);		
			КонецЕсли;
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки, ,ТекстОшибки);
		ИначеЕсли СтрокиОсновнойСтавки.Количество() > 1 Тогда
			СтруктураПоиска.Вставить("ПолноеСовпадениеМаршрута",Истина);
			СтрокиОсновнойСтавки = ТаблицаОсновныхСтавок.НайтиСтроки(СтруктураПоиска);
						
			Если СтрокиОсновнойСтавки.Количество() = 1 Тогда
				СтрокаЗаказа.ОсновнаяСтавка = СтрокиОсновнойСтавки[0].Стоимость;
				СтрокаЗаказа.ОсновнаяСтавкаОшибка = "";
			Иначе
				СтрокаЗаказа.ОсновнаяСтавка = 0;
				СтрокаЗаказа.ОсновнаяСтавкаОшибка = "Ставка не найдена";
