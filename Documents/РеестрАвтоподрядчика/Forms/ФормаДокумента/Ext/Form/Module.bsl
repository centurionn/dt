					КолонкаДляУдаления = РезультатЗапросаБезПунктовНазначения.Колонки.Найти("СовпадениеПунктНазначения");
					РезультатЗапросаБезПунктовНазначения.Колонки.Удалить(КолонкаДляУдаления);
					РезультатЗапросаБезПунктовНазначения.Свернуть("КлючАналитики, ЗапросНаАвто, Номенклатура, СовпаденииеАдресов, СовпадениеПунктОтправления, НормаЗагрузкиКТК, Стоимость");
					
					МассивСтрок = РезультатЗапросаБезПунктовНазначения.НайтиСтроки(СтруктураПоиска);
					Если МассивСтрок.Количество() <> 0 Тогда
						ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивПодобранныхСтрок, МассивСтрок);		
					КонецЕсли;
					
					Если МассивПодобранныхСтрок.Количество() = 1 Тогда
						СтрокаСтоимостиПерегруз = МассивПодобранныхСтрок[0];	
					ИначеЕсли МассивПодобранныхСтрок.Количество() > 1 Тогда
						СтрокаСтоимостиПерегруз = "Ошибка";	
					КонецЕсли;
				КонецЕсли;
				
				СтруктураПоиска.Удалить("СовпаденииеАдресов");
				СтруктураПоиска.Удалить("СовпадениеПунктОтправления");
				СтруктураПоиска.Удалить("СовпадениеПунктНазначения");
				
				Если НЕ ЗначениеЗаполнено(СтрокаСтоимостиПерегруз) Тогда 
					СтруктураПоиска.Вставить("ПустаяСсылкаМаршрута", Истина);
					МассивСтрок = РезультатЗапроса.НайтиСтроки(СтруктураПоиска);
					Если МассивСтрок.Количество() <> 0 Тогда
						СтрокаСтоимостиПерегруз = МассивСтрок[0];		
					КонецЕсли;
				КонецЕсли;
				
				СтруктураПоиска.Удалить("ПустаяСсылкаМаршрута");
				
			КонецЕсли;

			Если ЗначениеЗаполнено(СтрокаСтоимостиПерегруз) И СтрокаСтоимостиПерегруз <> "Ошибка" Тогда
		    	СтрокаЗаказа.НормаЗагрузкиКТК = СтрокаСтоимостиПерегруз.НормаЗагрузкиКТК;
				Перегруз = ?(СтрокаЗаказа.НормаЗагрузкиКТК <> Справочники.ВесаПоТипоразмерам.ПустаяСсылка(), СтрокаЗаказа.ВесНетто - ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаСтоимостиПерегруз.НормаЗагрузкиКТК,"Вес"), 0);
				СтрокаЗаказа.Перегруз = ?(Перегруз > 0, Перегруз, 0);
				СтрокаЗаказа.ПерегрузРуб = СтрокаЗаказа.Перегруз * СтрокаСтоимостиПерегруз.Стоимость / 1000;
				СтрокаЗаказа.ПерегрузОшибка = "";
			Иначе
				СтрокаЗаказа.НормаЗагрузкиКТК = Справочники.ВесаПоТипоразмерам.ПустаяСсылка();
				СтрокаЗаказа.Перегруз = 0;
				СтрокаЗаказа.ПерегрузРуб = 0;
				СтрокаЗаказа.ПерегрузОшибка = "Ставка не найдена";
				
				Если СтрокаСтоимостиПерегруз = "Ошибка" Тогда
					ТекстСообщения = СтрШаблон("Не найдена ставка за «Перегруз» в строке №%1, т.к. в ПСЦ есть несколько тарифов, отвечающих запросу, необходимо уточнить маршрут", СтрокаЗаказа.НомерСтроки);
				Иначе
					ТекстСообщения = СтрШаблон("В строке %1 Не найдена ставка для расчета перегруза , т.к. не найдено совпадения по маршруту", СтрокаЗаказа.НомерСтроки);
				КонецЕсли;

				ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки, ,ТекстСообщения);
			КонецЕсли;
			
			
			
			СтрокаЗаказа.ЭкспедированиеРуб = ?(СтрокаЗаказа.Экспедирование,ПолучитьСтоимостьПоНоменклатура(РезультатЗапроса, СтруктураПоиска, Справочники.Номенклатура.ЭкспедированиеАвтотранспорт), 0);
			СтрокаЗаказа.ДопАдресРуб = ?(СтрокаЗаказа.ДопАдресаКоличество <> 0, СтрокаЗаказа.ДопАдресаКоличество * ПолучитьСтоимостьПоНоменклатура(РезультатЗапроса, СтруктураПоиска, Справочники.Номенклатура.ДопАдрес), 0);
			СтрокаЗаказа.БазоваяСтавкаНадбавкаРуб = ?(СтрокаЗаказа.БазоваяСтавкаНадбавка, ПолучитьСтоимостьПоНоменклатура(РезультатЗапроса, СтруктураПоиска, Справочники.Номенклатура.БазоваяСтавкаАвто), 0);
			
			ВремяНаПогрузкеМин = Цел((СтрокаЗаказа.ДатаИВремяУбытияСПогрузкиВыгрузки - СтрокаЗаказа.ДатаИВремяПрибытияНаПогрузкуВыгрузку)/60);
			СтрокаЗаказа.ВремяНаПогрузкеЗагрузке = ?(ВремяНаПогрузкеМин < 1440, ПолучитьЧасыМинутыСтрокой(ВремяНаПогрузкеМин), "");
			СтрокаЗаказа.НормативныйСрокПогрузкиВыгрузкиСтрока = ПолучитьЧасыМинутыСтрокой(СтрокаЗаказа.НормативныйСрокПогрузкиВыгрузки * 60);
    	КонецЕсли;
	КонецЦикла;
	
	Если Ошибки <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки);	
	КонецЕсли;
	РассчитатьСуммуВСтроках();
	РасчетСуммы();

КонецФункции                                                                      

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьЧасыМинутыСтрокой(Минут)
	
	Если Минут > 0 Тогда
		Часы = Цел(Минут / 60);
		Минуты = Минут % 60;
		ПараметрыФорматаЧасы = ?(Часы > 99, "ЧЦ=3; ЧН=00; ЧВН=", "ЧЦ=2; ЧН=00; ЧВН=");
		ЧасыСтрокой = Формат(Часы, ПараметрыФорматаЧасы);
		МинутыСтрокой = Формат(Минуты, "ЧЦ=2; ЧН=00; ЧВН=");
		
		ЧасыМинутыСтрокой = СтрШаблон("%1:%2", ЧасыСтрокой, МинутыСтрокой);
	Иначе
		ЧасыМинутыСтрокой = "";
	КонецЕсли;
	
	Возврат ЧасыМинутыСтрокой;
		
КонецФункции 

&НаСервере
Процедура РасчетСуммы()
	КолВоСтрокСНДС = Объект.Заказы.НайтиСтроки(Новый Структура("СтоимостьСНДС",Истина)).Количество();
	КолВоСтрокБезНДС = Объект.Заказы.НайтиСтроки(Новый Структура("СтоимостьСНДС",Ложь)).Количество();
	Если КолВоСтрокСНДС > 0 И КолВоСтрокБезНДС > 0 Тогда
		СуммаСНДС = 0;
		СуммаБезНДС = 0;
		ОбщегоНазначения.СообщитьПользователю("Невозможно рассчитать итоговую сумму, т.к. разные значения в поле «Стоимость с НДС»");		
	ИначеЕсли КолВоСтрокСНДС > 0 Тогда
		СуммаСНДС = Объект.Заказы.Итог("ИтоговаяСтоимостьПеревозкиРуб");
		СуммаБезНДС = 0;
	ИначеЕсли КолВоСтрокБезНДС > 0 Тогда
		СуммаСНДС = 0;
		СуммаБезНДС = Объект.Заказы.Итог("ИтоговаяСтоимостьПеревозкиРуб");
	Иначе
		СуммаСНДС = 0;
		СуммаБезНДС = 0;
	КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВниз()
	ТекД = Элементы.РеестрАвтоподрядчика.ТекущиеДанные;
	ИндексСтроки = Элементы.РеестрАвтоподрядчика.ТекущаяСтрока;
	Если Текд <> Неопределено Тогда
		
		ИмяЭлемента = Элементы.РеестрАвтоподрядчика.ТекущийЭлемент.Имя;
		
		Если ИмяЭлемента = "РеестрАвтоподрядчикаНомерПСЦ" Тогда
			Для Индекс = ИндексСтроки По Объект.Заказы.Количество()-1 Цикл
				Объект.Заказы[Индекс].ПСЦПоставщика = ТекД.ПСЦПоставщика;	
			КонецЦикла;
		ИначеЕсли ИмяЭлемента = "РеестрАвтоподрядчикаНормативныйСрокПогрузкиВыгрузкиСтрока" Тогда
			Для Индекс = ИндексСтроки По Объект.Заказы.Количество()-1 Цикл
				Объект.Заказы[Индекс].НормативныйСрокПогрузкиВыгрузки = ТекД.НормативныйСрокПогрузкиВыгрузки;	
			КонецЦикла;
		ИначеЕсли ИмяЭлемента = "РеестрАвтоподрядчикаБазоваяСтавкаНадбавка" Тогда
			Для Индекс = ИндексСтроки По Объект.Заказы.Количество()-1 Цикл
				Объект.Заказы[Индекс].БазоваяСтавкаНадбавка = ТекД.БазоваяСтавкаНадбавка;	
			КонецЦикла;
		ИначеЕсли ИмяЭлемента = "РеестрАвтоподрядчикаДатаВремяПодачиКТКПлан" Тогда
			Для Индекс = ИндексСтроки По Объект.Заказы.Количество()-1 Цикл
				Объект.Заказы[Индекс].ДатаВремяПодачиКТКПлан = ТекД.ДатаВремяПодачиКТКПлан;	
			КонецЦикла;
		ИначеЕсли ИмяЭлемента = "РеестрАвтоподрядчикаДопАдресКол" Тогда
			Для Индекс = ИндексСтроки По Объект.Заказы.Количество()-1 Цикл
				Объект.Заказы[Индекс].ДопАдресаКоличество = ТекД.ДопАдресаКоличество;	
			КонецЦикла;
		КонецЕсли;
		ЗаполнитьРасчетныеПоляТаблицаРеестрАвтоподрядчика();
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбработатьИзменениеНормыВремениНаПогрузкуВыгрузку(ТекДанные)
	
	Строки = СтрРазделить(ТекДанные.НормативныйСрокПогрузкиВыгрузкиСтрока, ":");
	Часов = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Строки[0]);
	Если Строки.Количество() > 1 Тогда
		Минут = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Строки[1]);
	Иначе
		Минут = 0;
	КонецЕсли;
	ТекДанные.НормативныйСрокПогрузкиВыгрузкиСтрока =ПолучитьЧасыМинутыСтрокой(Часов * 60 + Минут);
				
	ДробнаяЧасть = Окр(Минут / 60, 2);	
	НормативЧисло = Часов + ДробнаяЧасть;
	
	ТекДанные.НормативныйСрокПогрузкиВыгрузки = НормативЧисло;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСчетФактуру(СсылкаПТУ)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СчетФактураПолученный.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.СчетФактураПолученный КАК СчетФактураПолученный
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|		ПО СчетФактураПолученный.ДокументОснование = ПоступлениеТоваровУслуг.Ссылка
		|			И (СчетФактураПолученный.ДокументОснование = &ДокументОснование)
		|			И СчетФактураПолученный.НомерВходящегоДокумента = ПоступлениеТоваровУслуг.НомерВходящегоДокумента
		|ГДЕ
		|	СчетФактураПолученный.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("ДокументОснование", СсылкаПТУ);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		Возврат Документы.СчетФактураПолученный.ПустаяСсылка();
	КонецЕсли;
КонецФункции

&НаСервере
Функция ПолучитьСтоимостьПоНоменклатура(ТаблицаРезультатов, СтруктураПоиска, ВидНоменклатуры)
	СтруктураПоиска.Вставить("Номенклатура", ВидНоменклатуры);
	МассивСтрок = ТаблицаРезультатов.НайтиСтроки(СтруктураПоиска);
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат 0;	
	Иначе
		СтрокаСтоимости = МассивСтрок[0];
		Возврат СтрокаСтоимости.Стоимость;	
	КонецЕсли
КонецФункции

&НаКлиенте
Процедура ПроверитьЗаполненностьНормативногоСрокаПогрузкиВыгрузки()
	СтруктураПоиска = Новый Структура();
	СтруктураПоиска.Вставить("НормативныйСрокПогрузкиВыгрузки", 0);
	НезаполненныеСтроки = Объект.Заказы.НайтиСтроки(СтруктураПоиска);
	Если НезаполненныеСтроки.Количество() = 1 Тогда
		ТекстСообщения = "Заполните нормативный срок погрузки/выгрузки на вкладке ""Реестр автоподрядчика"" в строке №" + НезаполненныеСтроки[0].НомерСтроки;	
	ИначеЕсли НезаполненныеСтроки.Количество() > 1 Тогда
		НомераСтрок = "";
		Для Каждого Строка Из НезаполненныеСтроки Цикл
			НомераСтрок = ?(ЗначениеЗаполнено(НомераСтрок), НомераСтрок + ", " + Строка.НомерСтроки, НомераСтрок + Строка.НомерСтроки);  
		КонецЦикла;
		
		ТекстСообщения = "Заполните нормативный срок погрузки/выгрузки на вкладке ""Реестр автоподрядчика"" в строках №" + НомераСтрок;
	Иначе
		Возврат
	КонецЕсли;
	
	ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

//Временное решение пока решается вопрос с сыллками на адреса
&НаСервере
Процедура ЗаполнитьСсылкаНаАдреса()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ТЧРеестра.КлючАналитики КАК Справочник.КлючиАналитикиПеревозки) КАК КлючАналитики,
		|	ТЧРеестра.ЗапросНаАвто КАК ЗапросНаАвто,
		|	ТЧРеестра.АдресПогрузкиВыгрузки КАК АдресПогрузкиВыгрузки
		|ПОМЕСТИТЬ ГуидЗаказаНаТС
		|ИЗ
		|	&ТаблицаРеестра КАК ТЧРеестра
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ГуидЗаказаНаТС.КлючАналитики КАК КлючАналитики,
		|	ГуидЗаказаНаТС.ЗапросНаАвто КАК ЗапросНаАвто,
		|	АдресаВНаселенныхПунктах.Ссылка КАК Ссылка
		|ИЗ
		|	ГуидЗаказаНаТС КАК ГуидЗаказаНаТС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.АдресаВНаселенныхПунктах КАК АдресаВНаселенныхПунктах
		|		ПО ГуидЗаказаНаТС.АдресПогрузкиВыгрузки = АдресаВНаселенныхПунктах.Адрес
		|ГДЕ
		|	АдресаВНаселенныхПунктах.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("ТаблицаРеестра", Объект.Заказы.Выгрузить());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтрокиЗаполнения = Объект.Заказы.НайтиСтроки(Новый Структура("КлючАналитики, ЗапросНаАвто, ИдентификаторСтрокиЗапросаНаАвтоперевозку",
			ВыборкаДетальныеЗаписи.КлючАналитики, ВыборкаДетальныеЗаписи.ЗапросНаАвто, ВыборкаДетальныеЗаписи.ИдентификаторСтрокиЗапросаНаАвтоперевозку));
		
		Если СтрокиЗаполнения.количество() = 0 Тогда
			Продолжить;			
		КонецЕсли;
		
		
		СтрокаЗаполнения = СтрокиЗаполнения[0];
		Если СтрокаЗаполнения.АдресПогрузкиВыгрузкиСсылка = Справочники.АдресаВНаселенныхПунктах.ПустаяСсылка() Тогда
			СтрокаЗаполнения.АдресПогрузкиВыгрузкиСсылка = ВыборкаДетальныеЗаписи.Ссылка;
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОсновнуюСтавку(Перезаполнить = Ложь)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаРеестра.КлючАналитики КАК КлючАналитики,
		|	ТаблицаРеестра.ЗапросНаАвто КАК ЗапросНаАвто,
		|	ТаблицаРеестра.ИдентификаторСтрокиЗапросаНаАвтоперевозку КАК ИдентификаторСтрокиЗапросаНаАвтоперевозку,
		|	ТаблицаРеестра.ТипКТК КАК ТипКТК,
		|	ТаблицаРеестра.ПСЦПоставщика КАК СсылкиПСЦ,
