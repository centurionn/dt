&НаКлиенте
Функция ПараметрыФормыВыбораПСЦ()
	НастройкиКД = Новый НастройкиКомпоновкиДанных;
	
	Если НЕ Объект.Договор =ПредопределенноеЗначение("Справочник.ДоговорыКонтрагентов.ПустаяСсылка") Тогда
		ЭлементОтбора = НастройкиКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Договор");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = Объект.Договор;
		ЭлементОтбора.Использование = Истина;
	КонецЕсли;

	ЭлементОтбора = НастройкиКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Проведен");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Истина;
	ЭлементОтбора.Использование = Истина;
	
	ЭлементОтбора = НастройкиКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПометкаУдаления");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Ложь;
	ЭлементОтбора.Использование = Истина;

	ЭлементОтбора = НастройкиКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВидУслугПоставщика");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = ПредопределенноеЗначение("Справочник.ВидыУслугПоставщиков.Автоперевозки");
	ЭлементОтбора.Использование = Истина;
	
	ГруппаЭлементовОтбора = НастройкиКД.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаЭлементовОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	 
	ЭлементОтбора = ГруппаЭлементовОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СтатусДокумента");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = ПредопределенноеЗначение("Перечисление.СтатусыСогласования.Подписано");
	
	ЭлементОтбора = ГруппаЭлементовОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СтатусДокумента");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = ПредопределенноеЗначение("Перечисление.СтатусыСогласования.СогласованоБезЗамечаний"); 
		
	ПараметрыФормы = Новый Структура("ФиксированныеНастройки", НастройкиКД);
	
	Возврат ПараметрыФормы
КонецФункции

&НаСервере
Процедура ПослеВыбораПСЦ(Результат, ДопПараметры)
	Если Результат = Неопределено Тогда
		Возврат
	КонецЕсли;
	Объект.ПСЦПоставщика = Результат;
	Если ДопПараметры = Истина Тогда
		Для Каждого Стр ИЗ Объект.Заказы Цикл
			Стр.ПСЦПоставщика = Объект.ПСЦПоставщика;
		КонецЦикла;
	Иначе
		ИндексСтроки = Элементы.РеестрАвтоподрядчика.ТекущаяСтрока;
		Если ЗаполнятьВниз Тогда
			Для Индекс = ИндексСтроки По Объект.Заказы.Количество()-1 Цикл
				Объект.Заказы[Индекс].ПСЦПоставщика = Результат;	
			КонецЦикла;	
		Иначе
			Объект.Заказы[ИндексСтроки].ПСЦПоставщика = Результат
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьРасчетныеПоляТаблицаРеестрАвтоподрядчика();
	ЗаполнитьОсновнуюСтавку(Истина);
	ОбновлениеПредставленияПСЦ();
	СравнениеДанныхКолонкиТЧиЗначенияВШапке("ПСЦПоставщика");
	СравнениеДанныхКолонкиТЧиЗначенияВШапке("СтавкаНДС");
КонецПроцедуры

&НаКлиенте
Процедура РеестрАвтоподрядчикаХолостойПрогонПриИзменении(Элемент)
	ПересчитатьХолостойПрогон();
	РассчитатьСуммуВСтроках();
	РасчетСуммы();
КонецПроцедуры

&НаСервере
Процедура ПересчитатьХолостойПрогон(Перезаполнить = Ложь)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ТЧРеестра.КлючАналитики КАК Справочник.КлючиАналитикиПеревозки) КАК КлючАналитики,
		|	ТЧРеестра.ЗапросНаАвто КАК ЗапросНаАвто,
		|	ТЧРеестра.ИдентификаторСтрокиЗапросаНаАвтоперевозку КАК ИдентификаторСтрокиЗапросаНаАвтоперевозку,
		|	ТЧРеестра.ДатаВремяПодачиКТКПлан КАК ДатаВремяПодачиКТКПлан,
		|	ВЫРАЗИТЬ(ТЧРеестра.ПСЦПоставщика КАК Документ.ПСЦПоставщика) КАК ПСЦСсылка
		|ПОМЕСТИТЬ ГуидЗаказаНаТС
		|ИЗ
		|	&ТаблицаРеестра КАК ТЧРеестра
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ГуидЗаказаНаТС.КлючАналитики КАК КлючАналитики,
		|	ГуидЗаказаНаТС.ЗапросНаАвто КАК ЗапросНаАвто,
		|	ГуидЗаказаНаТС.ИдентификаторСтрокиЗапросаНаАвтоперевозку КАК ИдентификаторСтрокиЗапросаНаАвтоперевозку,
		|	ВЫБОР
		|		КОГДА ПСЦПоставщика.СуммаВключаетНДС
		|			ТОГДА ТарифыПоставщиков.СтоимостьСНДС
		|		ИНАЧЕ ТарифыПоставщиков.СтоимостьБезНДС
		|	КОНЕЦ КАК Стоимость
		|ИЗ
		|	РегистрСведений.ТарифыПоставщиков КАК ТарифыПоставщиков
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПСЦПоставщика КАК ПСЦПоставщика
		|		ПО ТарифыПоставщиков.Регистратор = ПСЦПоставщика.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ГуидЗаказаНаТС КАК ГуидЗаказаНаТС
		|		ПО ТарифыПоставщиков.Регистратор = ГуидЗаказаНаТС.ПСЦСсылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КритерииУслугПоставщиков КАК КритерииУслугПоставщиков
		|		ПО ТарифыПоставщиков.Критерий = КритерииУслугПоставщиков.Ссылка
		|			И (КритерииУслугПоставщиков.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.АвтоперевозкаХолостойПрогон))";
	
	Запрос.УстановитьПараметр("ТаблицаРеестра", Объект.Заказы.Выгрузить());
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Для ИндексСтроки = ?(Перезаполнить, 0,Элементы.РеестрАвтоподрядчика.ТекущаяСтрока) По ?(ЗаполнятьВниз ИЛИ Перезаполнить, Объект.Заказы.Количество() - 1, Элементы.РеестрАвтоподрядчика.ТекущаяСтрока) Цикл
		СтрокаЗаказа = Объект.Заказы[ИндексСтроки];
		Если НЕ ЗначениеЗаполнено(СтрокаЗаказа.ХолостойПрогон) ИЛИ СтрокаЗаказа.ХолостойПрогон = Перечисления.ВидыПрогонаТС.ГруженыйПрогон  Тогда
			СтрокаЗаказа.ХолостойПрогонРуб = 0;
			Продолжить;
		КонецЕсли;
		
		СтруктураПоиска = Новый Структура();
		СтруктураПоиска.Вставить("КлючАналитики", СтрокаЗаказа.КлючАналитики);
		СтруктураПоиска.Вставить("ЗапросНаАвто", СтрокаЗаказа.ЗапросНаАвто);
		СтруктураПоиска.Вставить("ИдентификаторСтрокиЗапросаНаАвтоперевозку", СтрокаЗаказа.ИдентификаторСтрокиЗапросаНаАвтоперевозку);

		Строка = РезультатЗапроса.НайтиСтроки(СтруктураПоиска);
		Если Строка.Количество() = 0 Тогда
			СтрокаЗаказа.ХолостойПрогонРуб = 0;	
		Иначе
			СтрокаЗаказа.ХолостойПрогонРуб = Строка[0].Стоимость;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти