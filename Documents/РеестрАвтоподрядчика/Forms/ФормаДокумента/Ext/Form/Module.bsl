#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// СтандартныеПодсистемы.ПодключаемыеКоманды 
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект); 
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды 
	
	ПериодРеестра.ДатаНачала = Объект.ДатаНачала;
	ПериодРеестра.ДатаОкончания = Объект.ДатаОкончания;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	ПроверитьЗаполненностьНормативногоСрокаПогрузкиВыгрузки();
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Объект.СуммаСНДС = СуммаСНДС;	
	КонецЕсли
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	ЗаполнитьТаблицаРеестрАвтоподрядчика();
КонецПроцедуры
 
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	ЗаполнитьТаблицаРеестрАвтоподрядчика();
	ОбновлениеПредставленияПСЦ()
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	    // СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	Объект.ОтветственныйМенеджер = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(Объект.Договор,"ОтветственныйЗаДоговор");
	ЗаполнитьРасчетныеПоляТаблицаРеестрАвтоподрядчика();
КонецПроцедуры

&НаКлиенте
Процедура ПериодРеестраПриИзменении(Элемент)
	Объект.ДатаНачала = ПериодРеестра.ДатаНачала;
	Объект.ДатаОкончания = ПериодРеестра.ДатаОкончания;
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеПриИзменении(Элемент)
	Объект.ЦФО = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(Объект.Подразделение,"ЦФО");
КонецПроцедуры

&НаКлиенте
Процедура ПТУПриИзменении(Элемент)
	Объект.ВСФ = ПолучитьСчетФактуру(Объект.ПТУ);
КонецПроцедуры

&НаКлиенте
Процедура СтавкаНДСПриИзменении(Элемент)
	СравнениеДанныхКолонкиТЧиЗначенияВШапке("СтавкаНДС");
КонецПроцедуры

&НаКлиенте
Процедура ПСЦНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	ОпОп = Новый ОписаниеОповещения("ПослеВыбораПСЦ", ЭтаФорма, Истина);
	СтандартнаяОбработка = Ложь;

    ПараметрыФормы = ПараметрыФормыВыбораПСЦ();
	ОткрытьФорму("Документ.ПСЦПоставщика.ФормаВыбора",ПараметрыФормы, , , , ,ОпОп);	
КонецПроцедуры

&НаКлиенте
Процедура ПСЦОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПоказатьЗначение(,Объект.ПСЦПоставщика);
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРеестрАвтоподрядчик

&НаКлиенте
Процедура РеестрАвтоподрядчикаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Элементы.РеестрАвтоподрядчика.ТекущиеДанные = Неопределено Тогда
		Возврат
	КонецЕсли;
	СоответствиеИмен = Новый Соответствие;
	СоответствиеИмен.Вставить("РеестрАвтоподрядчикаЗапросНаАвто", Элементы.РеестрАвтоподрядчика.ТекущиеДанные.ЗапросНаАвто);
	СоответствиеИмен.Вставить("РеестрАвтоподрядчикаНомерКТК", Элементы.РеестрАвтоподрядчика.ТекущиеДанные.НомерКТК);
	СоответствиеИмен.Вставить("РеестрАвтоподрядчикаТипКТК", Элементы.РеестрАвтоподрядчика.ТекущиеДанные.ТипКТК);
	СоответствиеИмен.Вставить("РеестрАвтоподрядчикаКлиент", Элементы.РеестрАвтоподрядчика.ТекущиеДанные.Клиент);
	СоответствиеИмен.Вставить("РеестрАвтоподрядчикаТерминалПостановки", Элементы.РеестрАвтоподрядчика.ТекущиеДанные.ТерминалПостановки);
	СоответствиеИмен.Вставить("РеестрАвтоподрядчикаТерминалСдачи", Элементы.РеестрАвтоподрядчика.ТекущиеДанные.ТерминалСдачи);
	СоответствиеИмен.Вставить("РеестрАвтоподрядчикаТипОперацииНаТерминалеФПостановки", Элементы.РеестрАвтоподрядчика.ТекущиеДанные.ТипОперацииНаТерминалеПостановки);
	СоответствиеИмен.Вставить("РеестрАвтоподрядчикаНормаЗагрузкиКТК", Элементы.РеестрАвтоподрядчика.ТекущиеДанные.НормаЗагрузкиКТК);
	
	ОткрываемоеЗначение = СоответствиеИмен.Получить(Поле.Имя);
	Если ОткрываемоеЗначение <> Неопределено Тогда
		ПоказатьЗначение(, ОткрываемоеЗначение);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РеестрАвтоподрядчикаПриИзменении(Элемент)
	Если ЗаполнятьВниз Тогда
		ЗаполнитьВниз();
	КонецЕсли;
	ЗаполнитьРасчетныеПоляТаблицаРеестрАвтоподрядчика();
		
	Если Элемент.ТекущийЭлемент.Имя = "РеестрАвтоподрядчикаБазоваяСтавкаНадбавка" ИЛИ Элемент.ТекущийЭлемент.Имя = "РеестрАвтоподрядчикаНомерПСЦ" Тогда
		ЗаполнитьОсновнуюСтавку();		
	КонецЕсли;
	
	СравнениеДанныхКолонкиТЧиЗначенияВШапке("ПСЦПоставщика");
	СравнениеДанныхКолонкиТЧиЗначенияВШапке("СтавкаНДС");
КонецПроцедуры

&НаКлиенте
Процедура РеестрАвтоподрядчикаНормативныйСрокПогрузкиВыгрузкиСтрокаРегулирование(Элемент, Направление, СтандартнаяОбработка)
	Строка = Элементы.РеестрАвтоподрядчика.ТекущиеДанные;
	НовоеЗначение = Строка.НормативныйСрокПогрузкиВыгрузки + 0.5 * Направление;
	Если НовоеЗначение <= 0 Тогда
		Строка.НормативныйСрокПогрузкиВыгрузкиСтрока = ПолучитьЧасыМинутыСтрокой(0);
		Строка.НормативныйСрокПогрузкиВыгрузки = 0;
	Иначе
		Строка.НормативныйСрокПогрузкиВыгрузкиСтрока = ПолучитьЧасыМинутыСтрокой(НовоеЗначение*60);
		Строка.НормативныйСрокПогрузкиВыгрузки = НовоеЗначение;
	КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура РеестрАвтоподрядчикаНормативныйСрокПогрузкиВыгрузкиСтрокаПриИзменении(Элемент)
	ТекДанные = Элементы.РеестрАвтоподрядчика.ТекущиеДанные;
	ОбработатьИзменениеНормыВремениНаПогрузкуВыгрузку(ТекДанные);
КонецПроцедуры

&НаКлиенте
Процедура РеестрАвтоподрядчикаНомерПСЦПриИзменении(Элемент)

	ИзменениеПСЦВТЧ(Элементы.РеестрАвтоподрядчика.ТекущиеДанные.ПСЦПоставщика);
    ОбновлениеПредставленияПСЦ();
КонецПроцедуры

&НаКлиенте
Процедура РеестрАвтоподрядчикаНомерПСЦНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	ОпОп = Новый ОписаниеОповещения("ПослеВыбораПСЦ", ЭтаФорма, Ложь);
	СтандартнаяОбработка = Ложь;

    ПараметрыФормы = ПараметрыФормыВыбораПСЦ();
	ОткрытьФорму("Документ.ПСЦПоставщика.ФормаВыбора",ПараметрыФормы, , , , ,ОпОп);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы
// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.НачатьВыполнениеКоманды(ЭтотОбъект, Команда, Объект);   
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗаполнитьТаблицаРеестрАвтоподрядчика()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ТЧРеестра.КлючАналитики КАК Справочник.КлючиАналитикиПеревозки) КАК КлючАналитики,
		|	ТЧРеестра.ЗапросНаАвто КАК ЗапросНаАвто,
		|	ТЧРеестра.ДатаВремяПодачиКТКПлан КАК ДатаВремяПодачиКТКПлан,
		|	ТЧРеестра.ХолостойПрогон КАК ХолостойПрогон,
		|	ТЧРеестра.ПСЦПоставщика КАК ПСЦСсылка,
		|	ТЧРеестра.ИдентификаторСтрокиЗапросаНаАвтоперевозку КАК ИдентификаторСтрокиЗапросаНаАвтоперевозку
		|ПОМЕСТИТЬ ГуидЗаказаНаТС
		|ИЗ
		|	&ТаблицаРеестра КАК ТЧРеестра
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КлючиАналитикиПеревозкиМили.НомерЗаказаНаТС КАК НомерЗаказаНаТС,
		|	ЗапросНаАвтоперевозкуКонтейнеры.СтатусЗаказаНаТС КАК СтатусЗаказаНаТС,
		|	КлючиАналитикиПеревозкиМили.РегНомерТС КАК НомерАвто,
		|	КлючиАналитикиПеревозкиМили.ФИОВодителя КАК Водитель,
		|	КлючиАналитикиПеревозкиМили.ЗапросНаАвто.Контрагент КАК Клиент,
		|	КлючиАналитикиПеревозкиМили.Ссылка.Контейнер КАК НомерКТК,
		|	ЗапросНаАвтоперевозкуКонтейнеры.ТерминалВыдачиФакт КАК ТерминалПостановки,
		|	ЗапросНаАвтоперевозкуКонтейнеры.АдресСкладаФакт КАК АдресПогрузкиВыгрузкиСсылка,
		|	ЗапросНаАвтоперевозкуКонтейнеры.УдалитьАдресСкладаФакт КАК АдресПогрузкиВыгрузки,
		|	ЗапросНаАвтоперевозкуКонтейнеры.ТерминалСдачиФакт КАК ТерминалСдачи,
		|	КлючиАналитикиПеревозкиМили.ДатаИВремяПрибытияНаПогрузкуВыгрузку КАК ДатаИВремяПрибытияНаПогрузкуВыгрузку,
		|	ЗапросНаАвтоперевозкуКонтейнеры.ДатаЗавершенияОперацииНаСкладеКлиента КАК ДатаИВремяУбытияСПогрузкиВыгрузки,
		|	КлючиАналитикиПеревозкиМили.ЭкспедированиеФакт КАК Экспедирование,
		|	КлючиАналитикиПеревозкиМили.ОперацияНаТерминалеПостановкиФакт КАК ТипОперацииНаТерминалеПостановки,
		|	КлючиАналитикиПеревозкиМили.ОперацияНаСкладеКлиентаФакт КАК ТипОперацииНаСкладеКлиента,
		|	КлючиАналитикиПеревозкиМили.ОперацияНаТерминалеСдачиФакт КАК ТипОперацииНаТерминалеСдачи,
		|	КлючиАналитикиПеревозкиМили.КомментарийДиспЕвросиб КАК КомментарийЕвросиб,
		|	КлючиАналитикиПеревозкиМили.КомментарийПеревозчика КАК КомментарийПеревозчика,
		|	РАЗНОСТЬДАТ(КлючиАналитикиПеревозкиМили.ДатаИВремяПрибытияНаПогрузкуВыгрузку, ЗапросНаАвтоперевозкуКонтейнеры.ДатаЗавершенияОперацииНаСкладеКлиента, МИНУТА) КАК ВремяНаПогрузке,
		|	КлючиАналитикиПеревозкиМили.ВесНеттоФакт КАК ВесНетто,
		|	КлючиАналитикиПеревозкиМили.ЗапросНаАвто КАК ЗаказНаТССсылка,
		|	КлючиАналитикиПеревозкиМили.Ссылка.Контейнер.ТипТЕ КАК ТипКТК,
		|	КлючиАналитикиПеревозкиМили.Ссылка КАК КлючАналитики,
		|	КлючиАналитикиПеревозкиМили.ЗапросНаАвто КАК ЗапросНаАвто,
		|	ВЫБОР
		|		КОГДА НАЧАЛОПЕРИОДА(КлючиАналитикиПеревозкиМили.ДатаИВремяПрибытияНаПогрузкуВыгрузку, ДЕНЬ) <> КлючиАналитикиПеревозкиМили.ДатаИВремяПрибытияНаПогрузкуВыгрузку
		|				И НАЧАЛОПЕРИОДА(ГуидЗаказаНаТС.ДатаВремяПодачиКТКПлан, ДЕНЬ) <> ГуидЗаказаНаТС.ДатаВремяПодачиКТКПлан
		|				И КлючиАналитикиПеревозкиМили.ДатаИВремяПрибытияНаПогрузкуВыгрузку > ГуидЗаказаНаТС.ДатаВремяПодачиКТКПлан
		|			ТОГДА РАЗНОСТЬДАТ(ГуидЗаказаНаТС.ДатаВремяПодачиКТКПлан, КлючиАналитикиПеревозкиМили.ДатаИВремяПрибытияНаПогрузкуВыгрузку, МИНУТА)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ОпозданиеНаПогрузкуВыгрузку,
		|	КлючиАналитикиПеревозкиМили.ПротоколПоставщика КАК ПСЦПоставщика,
		|	ВЫБОР
		|		КОГДА &РольСменыХолостогоПрогона 
		|				ИЛИ ГуидЗаказаНаТС.ХолостойПрогон = ЗНАЧЕНИЕ(Перечисление.ВидыПрогонаТС.ХолостойПрогонСКТК)  
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ДоступностьХолостогоПрогонаРуб,
		|	ГуидЗаказаНаТС.ИдентификаторСтрокиЗапросаНаАвтоперевозку КАК ИдентификаторСтрокиЗапросаНаАвтоперевозку
		|ИЗ
		|	ГуидЗаказаНаТС КАК ГуидЗаказаНаТС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗапросНаАвтоперевозку.Контейнеры КАК ЗапросНаАвтоперевозкуКонтейнеры
		|		ПО (ЗапросНаАвтоперевозкуКонтейнеры.КлючАналитикиПеревозки = ГуидЗаказаНаТС.КлючАналитики)
		|			И (ЗапросНаАвтоперевозкуКонтейнеры.Ссылка = ГуидЗаказаНаТС.ЗапросНаАвто)
		|			И (ЗапросНаАвтоперевозкуКонтейнеры.ИдентификаторСтрокиТЧ = ГуидЗаказаНаТС.ИдентификаторСтрокиЗапросаНаАвтоперевозку)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозкиМили
		|		ПО ГуидЗаказаНаТС.КлючАналитики = КлючиАналитикиПеревозкиМили.Ссылка
		|			И ГуидЗаказаНаТС.ЗапросНаАвто = КлючиАналитикиПеревозкиМили.ЗапросНаАвто";
	
	Запрос.УстановитьПараметр("ТаблицаРеестра", Объект.Заказы.Выгрузить());
	Запрос.УстановитьПараметр("РольСменыХолостогоПрогона", РольДоступна("dc_АРМРеестрАвтоподрядчикаКорректировкаСуммы") ИЛИ РольДоступна("ПолныеПрава"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтрокиЗаполнения = Объект.Заказы.НайтиСтроки(Новый Структура("КлючАналитики, ЗапросНаАвто, ИдентификаторСтрокиЗапросаНаАвтоперевозку",
			ВыборкаДетальныеЗаписи.КлючАналитики, ВыборкаДетальныеЗаписи.ЗапросНаАвто, ВыборкаДетальныеЗаписи.ИдентификаторСтрокиЗапросаНаАвтоперевозку));
		
		Если СтрокиЗаполнения.количество() = 0 Тогда
			Продолжить;	
		КонецЕсли;
		
		СтрокаЗаполнения = СтрокиЗаполнения[0];
		ИсключенияЗаполнения ="КлючАналитики, ЗапросНаАвто, ПСЦПоставщика";

		ЗаполнитьЗначенияСвойств(СтрокаЗаполнения, ВыборкаДетальныеЗаписи,, ИсключенияЗаполнения);
		
		СтрокаЗаполнения.НомерЗаказаНаТС = Лев(ВыборкаДетальныеЗаписи.НомерЗаказаНаТС,25);
		СтрокаЗаполнения.ОпозданиеНаПогрузкуВыгрузкуСтрока = ?(ВыборкаДетальныеЗаписи.ОпозданиеНаПогрузкуВыгрузку < 1440 И ВыборкаДетальныеЗаписи.ОпозданиеНаПогрузкуВыгрузку > 0, ПолучитьЧасыМинутыСтрокой(ВыборкаДетальныеЗаписи.ОпозданиеНаПогрузкуВыгрузку), "");
	КонецЦикла;
	ЗаполнитьСсылкаНаАдреса();
	ЗаполнитьРасчетныеПоляТаблицаРеестрАвтоподрядчика();                    
	                            
КонецФункции

