			КонецЕсли;
			
            СтруктураПоиска.Удалить("ПолноеСовпадениеМаршрута");
		Иначе
			СтрокаЗаказа.ОсновнаяСтавка = СтрокиОсновнойСтавки[0].Стоимость;
