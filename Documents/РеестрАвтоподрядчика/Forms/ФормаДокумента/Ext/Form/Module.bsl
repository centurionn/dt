	КонецЕсли;
	
	РассчитатьСуммуВСтроках();
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммуВСтроках()
	Для Каждого СтрокаЗаказа Из Объект.Заказы Цикл
		СтрокаЗаказа.ИтоговаяСтоимостьПеревозкиРуб = СтрокаЗаказа.ПростойСверхНормыРуб + СтрокаЗаказа.ПерегрузРуб + СтрокаЗаказа.ЭкспедированиеРуб 
															+ СтрокаЗаказа.ДопАдресРуб + СтрокаЗаказа.БазоваяСтавкаНадбавкаРуб + СтрокаЗаказа.ОсновнаяСтавка + СтрокаЗаказа.ХолостойПрогонРуб;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ИзменениеПСЦВТЧ(ВыбранныйПСЦ)
	Если НЕ Объект.ПСЦПоставщика.Пустая() И ВыбранныйПСЦ <> Объект.ПСЦПоставщика Тогда
		Объект.ПСЦПоставщика = Документы.ПСЦПоставщика.ПустаяСсылка();
		ОбщегоНазначения.СообщитьПользователю("Значение по номеру Протокола поставщика в табличной части Реестра отличается от значения в Основных данных, поэтому в Основных данных поле очищено");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СравнениеДанныхКолонкиТЧиЗначенияВШапке(ИмяКолонки)
	Если ИмяКолонки <> "СтавкаНДС" И  ИмяКолонки <> "ПСЦПоставщика" Тогда
		Возврат
	КонецЕсли;
	
	Список = Объект.Заказы.Выгрузить(,ИмяКолонки);
	Список.Свернуть(ИмяКолонки);
	МассивПротоколов = Список.ВыгрузитьКолонку(ИмяКолонки);
	Если МассивПротоколов.Количество() = 1 Тогда
		Объект[ИмяКолонки] = ?(ИмяКолонки = "СтавкаНДС", Справочники.СтавкиНДС.НайтиПоРеквизиту("СтавкаНДС", МассивПротоколов[0]), МассивПротоколов[0]);
	Иначе
		Объект[ИмяКолонки] = ?(ИмяКолонки = "СтавкаНДС", Справочники.СтавкиНДС.ПустаяСсылка(), Документы[ИмяКолонки].ПустаяСсылка());
	КонецЕсли;
	ОбновлениеПредставленияПСЦ();
КонецПроцедуры

&НаСервере
Процедура ОбновлениеПредставленияПСЦ()
	Если Объект.ПСЦПоставщика = Документы.ПСЦПоставщика.ПустаяСсылка() Тогда
		ПредставлениеПСЦСтрокой = "";
	Иначе
		ДанныеПСЦДляПредставления = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ПСЦПоставщика,"Дата, НомерПСЦ");
		ПредставлениеПСЦСтрокой = СтрШаблон("%1 от %2", ДанныеПСЦДляПредставления.НомерПСЦ, Формат(ДанныеПСЦДляПредставления.Дата, "ДЛФ=Д"));
	КонецЕсли;
КонецПроцедуры

