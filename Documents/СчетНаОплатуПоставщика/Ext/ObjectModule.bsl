Процедура ПриЗаписи(Отказ)  
	
	//<< Евросиб - Витвицкий 23.07.2019
	Если ДополнительныеСвойства.Свойство("СтруктураДанных") Тогда
		
		СтруктураДанных = ДополнительныеСвойства.СтруктураДанных;
		
		Если СтруктураДанных.Свойство("ДвоичныйФайл") Тогда
		
			ФайлВоВременномХранилище = ПоместитьВоВременноеХранилище(СтруктураДанных.ДвоичныйФайл); 
			
		ИначеЕсли СтруктураДанных.Свойство("ДвоичныеДанные") Тогда
			
			ФайлВоВременномХранилище = ПоместитьВоВременноеХранилище(СтруктураДанных.ДвоичныеДанные);
			
		Иначе
			
			Возврат;
		
		КонецЕсли; 
		СтруктураИмениФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(СтруктураДанных.ИмяФайла);
		ПараметрыФайла = Новый Структура;
		ПараметрыФайла.Вставить("Автор", Автор);
		ПараметрыФайла.Вставить("ВладелецФайлов", Ссылка);
		ПараметрыФайла.Вставить("ИмяБезРасширения", СтруктураИмениФайла.ИмяБезРасширения);
		ПараметрыФайла.Вставить("РасширениеБезТочки", ОбщегоНазначенияКлиентСервер.РасширениеБезТочки(СтруктураИмениФайла.Расширение));
		ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное", Создано);
		
		РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, ФайлВоВременномХранилище,, "ЭДО");
		
		//ЕСОбменСервер.ЗаписатьСостояниеДокументаВДиадоке(Ссылка, СтруктураДанных.СостояниеДокументооборота, Создано);		
	КонецЕсли;	
