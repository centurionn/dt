
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Маршрутизировать = Константы.МаршрутизироватьСчетПоставщика.Получить();
	
	Автор = Пользователи.ТекущийПользователь();
	Создано = ТекущаяДата();
//Евросиб Гудкова( 01.06.2021 Ticket№ 35135
	Дата = НачалоДня(ТекущаяДата());	               	
// Евросиб Гудкова) 	
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		// Заполнение шапки
		БанковскийСчетКонтрагента = ДанныеЗаполнения.БанковскийСчетКонтрагента;
		БанковскийСчетОрганизации = ДанныеЗаполнения.БанковскийСчетОрганизации;
		ВалютаДокумента = ДанныеЗаполнения.ВалютаДокумента;
		ДоговорКонтрагента = ДанныеЗаполнения.ДоговорКонтрагента;
		Контрагент = ДанныеЗаполнения.Контрагент;
		КратностьВзаиморасчетов = ДанныеЗаполнения.КратностьВзаиморасчетов;
		КурсВзаиморасчетов = ДанныеЗаполнения.КурсВзаиморасчетов;
		Организация = ДанныеЗаполнения.Организация;
		ПодразделениеОрганизации = ДанныеЗаполнения.ПодразделениеОрганизации;
		СуммаВключаетНДС = ДанныеЗаполнения.СуммаВключаетНДС;
		СуммаДокумента = ДанныеЗаполнения.СуммаДокумента;
		УчитыватьНДС = ДанныеЗаполнения.УчитыватьНДС;
		ЦФО = ДанныеЗаполнения.ЦФО;
		ВСоставеКомплекта = Истина;
		Для Каждого ТекСтрокаУслуги Из ДанныеЗаполнения.Услуги Цикл
			НоваяСтрока = Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрокаУслуги);
			//НоваяСтрока.Количество = ТекСтрокаУслуги.Количество;
			//НоваяСтрока.Номенклатура = ТекСтрокаУслуги.Номенклатура;
			//НоваяСтрока.Содержание = ТекСтрокаУслуги.Содержание;
			//НоваяСтрока.СтавкаНДС = ТекСтрокаУслуги.СтавкаНДС;
			//НоваяСтрока.Сумма = ТекСтрокаУслуги.Сумма;
			//НоваяСтрока.СуммаНДС = ТекСтрокаУслуги.СуммаНДС;
			//НоваяСтрока.Цена = ТекСтрокаУслуги.Цена;
		КонецЦикла;
		//Евросиб Гудкова( 20.09.2020 Ticket№ 0207337
		ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
			И ДанныеЗаполнения.Свойство("Шапка") Тогда
				ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения.Шапка[0]);
				// Дата = ТекущаяДата();     // Евросиб Гудкова 01.06.2021 Ticket№ 35135
				Для Каждого ТекСтрокаУслуги Из ДанныеЗаполнения.Услуги Цикл
					НоваяСтрока = Товары.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрокаУслуги);
				КонецЦикла;
// Евросиб Гудкова) 		
	Иначе	
		ЦФО = Автор.ЦФО;
		ПодразделениеОрганизации = Автор.Подразделение;
		Организация = Константы.ОсновнаяОрганизация.Получить();
		ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
		//БанковскийСчетОрганизации = Организация.ОсновнойБанковскийСчет; //ДИТ, Беляев СЮ, TA48059, 12-04-2022, закомментировал
		
		РезультатВалюта = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаДокумента, ТекущаяДата());
		КратностьВзаиморасчетов = РезультатВалюта.Кратность;
		КурсВзаиморасчетов = РезультатВалюта.Курс;
		УчитыватьНДС = Организация.УчитыватьНДСВДокументах;
	//Евросиб Гудкова( 24.07.2020 Ticket№ 0201305
		Если УчитыватьНДС Тогда
			СуммаВключаетНДС = Истина;
		КонецЕсли; 
	// Евросиб Гудкова) 	
		ДатаОплаты = Создано;	
	КонецЕсли;
	
	//Евросиб Каблов 12.08.2022 ( Task 55578
	Ответственный = ДоговорКонтрагента.ОтветственныйЗаДоговор;
	//Евросиб Каблов 12.08.2022 )
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Маршрутизировать = Константы.МаршрутизироватьСчетПоставщика.Получить();
	Автор = Пользователи.ТекущийПользователь();
	Создано = ТекущаяДата();
	Редактор = неопределено;
	Изменено = неопределено;
	Состояния.Очистить();
//Евросиб Гудкова( 01.06.2021 Ticket№ 35135
	Дата = НачалоДня(ТекущаяДата());	               	
// Евросиб Гудкова) 	
	
КонецПроцедуры


