
Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Поля = Новый Массив;
	Поля.Добавить("Контрагент");
	Поля.Добавить("Дата");
	Поля.Добавить("Номер");
	Поля.Добавить("ДатаВходящегоДокумента");
	Поля.Добавить("НомерВходящегоДокумента");
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Представление = "Счет поставщика " + Данные.Контрагент + " № " + Данные.НомерВходящегоДокумента + " от " + Формат(Данные.ДатаВходящегоДокумента, "ДФ=dd.MM.yy") + " (№ " + Данные.Номер + " создан " + Формат(Данные.Дата, "ДФ=dd.MM.yy") + ")";
	
КонецПроцедуры
