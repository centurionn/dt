Функция ОбновитьНомерДатуЗаказаУПП(Ссылка)

	НомерИДата = "";
	Запрос = Новый Запрос;
	//Евросиб СубботинВ #118799 09.10.2025 Начало
	//Запрос.Текст = "ВЫБРАТЬ
	//               |	ПротоколОбменов.НомерДатаВБУ КАК НомерДатаВБУ
	//               |ИЗ
	//               |	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	//               |ГДЕ
	//               |	ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(перечисление.УзлыОбмена.УППЗаказ)
	//               |	И ПротоколОбменов.Объект = &Ссылка";
	//Запрос.УстановитьПараметр("ссылка", Ссылка);
	//Результат = Запрос.Выполнить().Выбрать();
	//Если Результат.Следующий() Тогда		
	//	НомерИДата = " " + Результат.НомерДатаВБУ;	
	//КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПротоколОбменов.НомерДатаВБУ КАК НомерДатаВБУ
	               |ИЗ
	               |	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	               |ГДЕ
	               |	ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(перечисление.УзлыОбмена.УППЗаказ)
	               |	И ПротоколОбменов.Объект = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ФиксацияИзмененийСчетаПоступления.Ссылка КАК Ссылка,
	               |	ПротоколОбменов.НомерДатаВБУ КАК НомерДатаВБУ
	               |ИЗ
	               |	Справочник.ФиксацияИзмененийСчетаПоступления КАК ФиксацияИзмененийСчетаПоступления
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	               |		ПО ФиксацияИзмененийСчетаПоступления.Ссылка = ПротоколОбменов.Объект
	               |			И (ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УППЗаказ))
	               |ГДЕ
	               |	ФиксацияИзмененийСчетаПоступления.ИзменяемыйДокумент = &Ссылка
	               |	И НЕ ФиксацияИзмененийСчетаПоступления.ПометкаУдаления";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Результат = Запрос.ВыполнитьПакет();
	НомерДатаСчетаВБУ =  Результат[0].Выбрать();
	Если НомерДатаСчетаВБУ.Следующий() Тогда		
		НомерИДата = " " + НомерДатаСчетаВБУ.НомерДатаВБУ;	
	КонецЕсли;
	Если НЕ НомерИДата = "" и НЕ Результат[1].пустой() Тогда
		НомерИДата = НомерИДата + "/";
	КонецЕсли;
	
	НомерДатаКЗПВБУ =  Результат[1].Выбрать(); 
	Пока НомерДатаКЗПВБУ.Следующий() Цикл		
		НомерИДата = НомерИДата + НомерДатаКЗПВБУ.НомерДатаВБУ + "; " ;	
	КонецЦикла; 
	
	
	//Евросиб СубботинВ #118799 09.10.2025 Конец

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СвязанныеДокументы.Ссылка КАК ЗаявкаНаОплату,
	|	ПротоколОбменов.ПроведенВБУ КАК ПроведенВБУ,
	|	ПротоколОбменов.НомерДатаВБУ КАК НомерДатаВБУ
	|ИЗ
	|	КритерийОтбора.СвязанныеДокументы(&Документ) КАК СвязанныеДокументы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	|		ПО СвязанныеДокументы.Ссылка = ПротоколОбменов.Объект
	|			И (ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(перечисление.УзлыОбмена.УПП))
	|			И (ПротоколОбменов.ДействиеПриОбмене = ЗНАЧЕНИЕ(перечисление.ДействияПриОбмене.ВыгрузкаДанных))
	|ГДЕ
	|	СвязанныеДокументы.Ссылка ССЫЛКА Документ.ЗаявкаНаОплату";
	Запрос.УстановитьПараметр("Документ", Ссылка);
	РезультатЗапроса = Запрос.Выполнить();        
	ВыборкаРезультатаЗапроса = РезультатЗапроса.Выбрать();
	МассивНомеров = Новый Массив;
	Пока ВыборкаРезультатаЗапроса.Следующий() Цикл
		МассивНомеров.Добавить(ВыборкаРезультатаЗапроса.НомерДатаВБУ);
	КонецЦикла;                                                       
	СтрокаНомераВБУ = СтрСоединить(МассивНомеров, ";");
	НомерИДата = НомерИДата + СтрокаНомераВБУ;
	Возврат НомерИДата;

КонецФункции
 
