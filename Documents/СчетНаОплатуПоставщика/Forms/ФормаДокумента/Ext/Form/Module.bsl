		ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
	КонецЕсли;
	ОткрытьФорму("Документ.ЗаявкаНаОплату.ФормаОбъекта", ПараметрыФормы, ЭтаФорма);
	
