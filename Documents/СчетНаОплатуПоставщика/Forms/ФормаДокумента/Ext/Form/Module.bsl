&НаКлиенте
Процедура СоздатьЗаявкиНаОплату(Команда, ВопросЗадан = Ложь)
	
	ДокументВыгруженВУПП = ПроверитьДокументВыгруженВУППНаСервере(Объект.Ссылка);
	Если Не ДокументВыгруженВУПП Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("По данному документу не создан Заказ в УПП. Создание заявки на оплату отменено.");
		Возврат;
	КонецЕсли;
	
	
	Ставка = СтрЗаменить(Команда.Имя,"СоздатьНаОснованииЗаявкуНаОплатуПоСтавке","");
	Если Ставка = "БезНДС" Тогда
		Ставка = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС");
	Иначе
		Ставка = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС"+Ставка);
	КонецЕсли;
	СтрокиКРазнесению = ПолучитьСоответствиеСтавокНДС(Объект.Ссылка);
	СтрокиПоТекущейСтавке = СтрокиКРазнесению.Получить(Ставка);
	Если СтрокиПоТекущейСтавке <> Неопределено Тогда
		
		//Поиск существующих заявок по ставке 
		Если Не ВопросЗадан Тогда
			Результат = ПолучитьСуществующуюЗаявкуПоДокументуНаСервере(СтрокиПоТекущейСтавке, Ставка); 
			СтрокиКРазнесению = Новый Соответствие;
			СтрокиКРазнесению.Вставить(Ставка,СтрокиПоТекущейСтавке);
		Иначе Результат = Неопределено;
		КонецЕсли;
		
		Если Результат = Неопределено Тогда			
			НоваяЗаявка = СоздатьЗаявкиПоРазнымНДС(СтрокиКРазнесению);
			Если НЕ НоваяЗаявка = Неопределено Тогда
				ПоказатьЗначение(,НоваяЗаявка);
			КонецЕсли;
		Иначе
			ОписаниеОповещения = Новый ОписаниеОповещения("ПродолжитьПослеНайденнойЗаявки", ЭтотОбъект, Новый Структура("СуществующаяЗаявка, Команда", Результат, Команда));
			СписокКнопок = Новый СписокЗначений;
			СписокКнопок.Добавить("ОткрытьДляРедактирования", "Открыть найденную заявку");
			СписокКнопок.Добавить("СоздатьНовую", "Создать новую заявку");
			СписокКнопок.Добавить("Отмена", "Отмена");

			ПоказатьВопрос(ОписаниеОповещения, "Найдена существующая заявка по выбранной ставке НДС.
												|Открыть для редактирования или создать новую?",СписокКнопок, 60);
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры


&НаКлиенте
Процедура ПродолжитьПослеНайденнойЗаявки(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = Неопределено Тогда
		Возврат
	ИначеЕсли РезультатВопроса = "ОткрытьДляРедактирования" Тогда
		ПоказатьЗначение(,ДополнительныеПараметры.СуществующаяЗаявка);
		
	ИначеЕсли  РезультатВопроса = "СоздатьНовую" Тогда
		СоздатьЗаявкиНаОплату(ДополнительныеПараметры.Команда, Истина);
	ИначеЕсли РезультатВопроса = "Отмена" Тогда
		Возврат	
	КонецЕсли;

КонецПроцедуры

