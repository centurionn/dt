
&НаКлиенте
Процедура УчитыватьНДСНажатие(Элемент)
	ОбъектА = ЭтотОбъект.Объект;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("УчитыватьНДС", ОбъектА.УчитыватьНДС);
	ПараметрыФормы.Вставить("СуммаВключаетНДС", ОбъектА.СуммаВключаетНДС);
	ОткрытьФорму("ОбщаяФорма.УчетНДСВДокументах",ПараметрыФормы,ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура КурсВалютыНажатие(Элемент)
	ОбъектА = ЭтотОбъект.Объект;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВалютаДокумента", ОбъектА.ВалютаДокумента);
	ПараметрыФормы.Вставить("КурсВзаиморасчетов", ОбъектА.КурсВзаиморасчетов);
	ПараметрыФормы.Вставить("КратностьВзаиморасчетов", ОбъектА.КратностьВзаиморасчетов);
	ПараметрыФормы.Вставить("ДатаДокумента", ОбъектА.Дата);
	ОткрытьФорму("ОбщаяФорма.КурсВалютыВДокументах",ПараметрыФормы,ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.УчетНДСВДокументах" Тогда
		ОбработкаВыбораУчетНДС(ЭтаФорма,ВыбранноеЗначение,ИсточникВыбора);
	ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.КурсВалютыВДокументах" Тогда
		ОбработкаВыбораКурсыВалют(ЭтаФорма,ВыбранноеЗначение,ИсточникВыбора);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораУчетНДС(Форма, ВыбранноеЗначение, ИсточникВыбора)
	ЗаполнитьЗначенияСвойств(Объект, ВыбранноеЗначение);
	Для каждого Стр из Объект.Товары Цикл
		БухгалтерскийУчетОбщиеПроцедурыКлиент.ПересчитатьСуммыНДС(Стр,Объект.УчитыватьНДС,Объект.СуммаВключаетНДС);
		БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(Стр,Объект.СуммаВключаетНДС);
		
	КонецЦикла;
	
	//Для каждого Стр из Объект.Услуги Цикл
	//	БухгалтерскийУчетОбщиеПроцедурыКлиент.ПересчитатьСуммыНДС(Стр,Объект.УчитыватьНДС,Объект.СуммаВключаетНДС);
	//	БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(Стр,Объект.СуммаВключаетНДС);

	//КонецЦикла;
	РассчитатьСуммыВсегоПоДокументу();
	УстановитьВидимостьКолонокНДС();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораКурсыВалют(Форма, ВыбранноеЗначение, ИсточникВыбора)
	СтараяВалюта = Объект.ВалютаДокумента;
	СтарыйКурс = Объект.КурсВзаиморасчетов;
	СтараяКратность = Объект.КратностьВзаиморасчетов;
	
	Объект.ВалютаДокумента = ВыбранноеЗначение.ВалютаДокумента;
	Объект.КратностьВзаиморасчетов = ВыбранноеЗначение.КратностьВзаиморасчетов;
	Объект.КурсВзаиморасчетов = ВыбранноеЗначение.КурсВзаиморасчетов;
	Если СтараяВалюта <> Объект.ВалютаДокумента или СтарыйКурс <> Объект.КурсВзаиморасчетов Тогда
		СтруктураТекущая = Новый Структура;
		СтруктураТекущая.Вставить("Валюта",СтараяВалюта);
		СтруктураТекущая.Вставить("Курс",СтарыйКурс);
		СтруктураТекущая.Вставить("Кратность",СтараяКратность);
		СтруктураНовая = Новый Структура;
		СтруктураНовая.Вставить("Валюта",Объект.ВалютаДокумента);
		СтруктураНовая.Вставить("Курс",Объект.КурсВзаиморасчетов);
		СтруктураНовая.Вставить("Кратность",Объект.КратностьВзаиморасчетов);
		
		ПересчитатьСуммыДокументаПоВалютеВзаиморасчетов(СтруктураТекущая,СтруктураНовая);
		Для каждого Стр из Объект.Товары Цикл
			БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(Стр,Объект.СуммаВключаетНДС);
		КонецЦикла;

		РассчитатьСуммыВсегоПоДокументу();
	КонецЕсли;
	
	РассчитатьСуммыВсегоПоДокументу();
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммыВсегоПоДокументу()
	ИтогоНДС = ?(Объект.Товары.Количество()>0, Объект.Товары.Итог("СуммаНДС"),0);//+?(Объект.Услуги.Количество()>0,Объект.Услуги.Итог("СуммаНДС"),0);
	ИтогоВсего = ?(Объект.Товары.Количество()>0, Объект.Товары.Итог("Сумма"),0)+?(Объект.СуммаВключаетНДС,0,ИтогоНДС);//+ ?(Объект.Услуги.Количество()>0,Объект.Услуги.Итог("Сумма"),0)+?(Объект.СуммаВключаетНДС,0,ИтогоНДС);
	Если ДоступноРедактирование() Тогда
		Объект.СуммаДокумента = ИтогоВсего;
	КонецЕсли;
	Элементы.Валюта.Заголовок = Объект.ВалютаДокумента;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДоступноРедактирование()
	Возврат ПравоДоступа("Редактирование", Метаданные.Документы.СчетНаОплатуПоставщика);
КонецФункции

&НаКлиенте
Процедура УстановитьВидимостьКолонокНДС()
	Если Не Объект.УчитыватьНДС Тогда
		Элементы.Товары1СтавкаНДС.Видимость = Ложь;
		Элементы.Товары1СуммаНДС.Видимость = Ложь;
		//Элементы.Услуги1СтавкаНДС.Видимость = Ложь;
		//Элементы.Услуги1СуммаНДС.Видимость = Ложь;
	Иначе
		Элементы.Товары1СтавкаНДС.Видимость = Истина;
		Элементы.Товары1СуммаНДС.Видимость = Истина;
		//Элементы.Услуги1СтавкаНДС.Видимость = Истина;
		//Элементы.Услуги1СуммаНДС.Видимость = Истина;		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Товары1КоличествоПриИзменении(Элемент)
	СтрТЧ = Элементы.Товары1.ТекущиеДанные;
	БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуСтрокиТабличнойЧасти(СтрТЧ);
	БухгалтерскийУчетОбщиеПроцедурыКлиент.ПересчитатьСуммыНДС(СтрТЧ,Объект.УчитыватьНДС,Объект.СуммаВключаетНДС);
	БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(СтрТЧ,Объект.СуммаВключаетНДС);
	РассчитатьСуммыВсегоПоДокументу();

КонецПроцедуры

