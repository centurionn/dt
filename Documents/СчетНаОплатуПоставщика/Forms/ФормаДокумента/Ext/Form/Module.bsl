&НаКлиенте
Процедура ДоговорКонтрагентаПриИзменении(Элемент)
	СтараяВалюта = Объект.ВалютаДокумента;
	СтарыйКурс = Объект.КурсВзаиморасчетов;
	СтараяКратность = Объект.КратностьВзаиморасчетов;
	
	НадоОчиститьРСчета = Ложь;
	
	Если ЗначениеЗаполнено(Объект.ДоговорКонтрагента) Тогда
		СтрПараметров = КонтрагентыДоговоры_сервер.ПолучитьВалютуДоговора(Объект.ДоговорКонтрагента, Объект.Дата);
		НадоОчиститьРСчета = (Объект.ВалютаДокумента <> СтрПараметров.Валюта);
		Объект.ВалютаДокумента = СтрПараметров.Валюта;
		Объект.КурсВзаиморасчетов = СтрПараметров.Курс;
		Объект.КратностьВзаиморасчетов = СтрПараметров.Кратность;
	КонецЕсли;
	
	Если НадоОчиститьРСчета Тогда
		Объект.БанковскийСчетКонтрагента = неопределено;
		Объект.БанковскийСчетОрганизации = неопределено;
	КонецЕсли;
	
	Если СтараяВалюта <> Объект.ВалютаДокумента  или СтарыйКурс <> Объект.КурсВзаиморасчетов  Тогда
		СтруктураТекущая = Новый Структура;
		СтруктураТекущая.Вставить("Валюта",СтараяВалюта);
		СтруктураТекущая.Вставить("Курс",СтарыйКурс);
		СтруктураТекущая.Вставить("Кратность",СтараяКратность);
		СтруктураНовая = Новый Структура;
		СтруктураНовая.Вставить("Валюта",Объект.ВалютаДокумента);
		СтруктураНовая.Вставить("Курс",Объект.КурсВзаиморасчетов);
		СтруктураНовая.Вставить("Кратность",Объект.КратностьВзаиморасчетов);
		
		ПересчитатьСуммыДокументаПоВалютеВзаиморасчетов(СтруктураТекущая, СтруктураНовая);
		Для каждого Стр из Объект.Товары Цикл
			БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(Стр,Объект.СуммаВключаетНДС);
		КонецЦикла;

		РассчитатьСуммыВсегоПоДокументу();
	КонецЕсли;
	
	//Евросиб Каблов 12.08.2022 ( Task 55578
	Если ЗначениеЗаполнено(Объект.ДоговорКонтрагента) Тогда
		Объект.Ответственный = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(Объект.ДоговорКонтрагента, "ОтветственныйЗаДоговор");
	КонецЕсли;
	//Евросиб Каблов 12.08.2022 )
	
