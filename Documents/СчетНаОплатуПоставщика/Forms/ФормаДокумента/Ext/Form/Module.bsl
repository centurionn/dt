&НаСервере
Процедура ВыгрузитьКЗП()  
	
	МассивДокументов = Новый Массив;
	МассивДокументов.Добавить(Объект.Ссылка);
	ЕСОбменСервер.ВыгрузитьКЗПвУПП(МассивДокументов, Тип("ДокументСсылка.СчетНаОплатуПоставщика"));
	ОбновитьНомерДатуЗаказаУПП(Объект.Ссылка);
	ЗаявкиНаОплатуСервер.ПроверитьКомандыВыгрузкиВУПП(Этаформа, Тип("ДокументСсылка.СчетНаОплатуПоставщика"), Объект.Ссылка);
    
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКЗП(Команда)
	
	ВыгрузитьКЗП();
	
