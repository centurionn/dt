	КонецЕсли;
	АдресТаблицыОпераций = ДополнительныеПараметры.АдресТаблицыОпераций;
	//Закрыть(Новый Структура("Результат, АдресТаблицыОпераций", Истина, ДополнительныеПараметры.АдресТаблицыОпераций));
