	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаТС.ТС КАК ТС,
		|	ТаблицаТС.ТекущееМестоположение КАК ТекущееМестоположение,
		|	ТаблицаТС.ДатаОперации КАК ДатаОперации,
		|	ТаблицаТС.ДатаОтправления КАК ДатаОтправления,
		|	ТаблицаТС.ПунктНазначения КАК ПунктНазначения,
		|	ТаблицаТС.Груженый КАК Груженый
		|ПОМЕСТИТЬ СписокТС
		|ИЗ
		|	&ТаблицаТС КАК ТаблицаТС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СписокТС.ТС КАК ТС,
		|	СписокТС.ТекущееМестоположение КАК ТекущееМестоположение,
		|	СписокТС.ДатаОперации КАК ДатаОперации,
		|	СписокТС.ДатаОтправления КАК ДатаОтправления,
		|	СписокТС.ПунктНазначения КАК ПунктНазначения,
		|	СписокТС.Груженый КАК Груженый
		|ИЗ
		|	СписокТС КАК СписокТС
		|ИТОГИ
		|	МАКСИМУМ(ТС),
		|	МАКСИМУМ(ДатаОтправления),
		|	МАКСИМУМ(ПунктНазначения),
		|	МАКСИМУМ(Груженый)
		|ПО
		|	ТекущееМестоположение,
		|	ДатаОперации";
	
	Запрос.УстановитьПараметр("ТаблицаТС",ТЗ);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаТекущееМестоположение = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаТекущееМестоположение.Следующий() Цикл
		ВыборкаДатаОперации = ВыборкаТекущееМестоположение.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаДатаОперации.Следующий() Цикл
			
			// Новая операция
			НоваяОперация = Документы.Операция.СоздатьДокумент();
			НоваяОперация.Дата = ТекущаяДата();
			
			НоваяОперация.Заполнить(Неопределено);
			
			НоваяОперация.РейсЖД = РейсЖД;
			НоваяОперация.ПланФакт = Перечисления.ПланФактСчет.План;

//Евросиб Каблов М.Б. 13.11.2019 (
			//Запрос = Новый Запрос;
			//Запрос.Текст = 
			//	"ВЫБРАТЬ
			//	|	ВидыОпераций.Ссылка КАК Ссылка
			//	|ИЗ
			//	|	Справочник.ВидыОпераций КАК ВидыОпераций
			//	|ГДЕ
			//	|	ВидыОпераций.Наименование = &Наименование";
			//
			//Запрос.УстановитьПараметр("Наименование", "ЖД отправка");
			//
			//РезультатЗапроса = Запрос.Выполнить();
			//
			//ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			//
			//Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			//	УслугаЖД = ВыборкаДетальныеЗаписи.Ссылка;
			//КонецЕсли;
			//
			//НоваяОперация.Услуга = УслугаЖД;
			НоваяОперация.Услуга = Справочники.ВидыОпераций.ЖДОтправка;
//Евросиб Каблов М.Б. 13.11.2019 )
			НоваяОперация.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
		
			НоваяОперация.ПунктОтправления = ВыборкаДатаОперации.ТекущееМестоположение;
			НоваяОперация.ПунктНазначения = ВыборкаДатаОперации.ПунктНазначения;
			
			НоваяОперация.ДатаОтправления = ВыборкаДатаОперации.ДатаОперации;
			НоваяОперация.ДатаНазначения = ВыборкаДатаОперации.ДатаОтправления;
			НоваяОперация.ТипДлительности = Перечисления.ЕдиницаИзмеренияДлительности.КалендарныйДень;
			
			Выборка = ВыборкаДатаОперации.Выбрать();
			Пока Выборка.Следующий() Цикл
				
				// Заполняем ТЧ Грузы в операции
				НовСтрГрузы = НоваяОперация.Грузы.Добавить();
				ТСГУИД = Строка(Новый УникальныйИдентификатор);
				НовСтрГрузы.ТСГУИД = ТСГУИД;
