&НаСервереБезКонтекста
Функция ПолучитьГрузополучателяИРС(Грузоотправитель)
	ГрузополучательИРС = Неопределено;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	dbo_ES_vConsignors.Ссылка КАК Ссылка
	|ИЗ
	|	ВнешнийИсточникДанных.ИРС.Таблица.dbo_ES_vConsignors КАК dbo_ES_vConsignors
	|ГДЕ
	|	dbo_ES_vConsignors.ОКПО = &КодПоОКПО
	|	И dbo_ES_vConsignors.ИНН <> """"";
	Запрос.УстановитьПараметр("КодПоОКПО", Грузоотправитель.КодПоОКПО);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ГрузополучательИРС = РезультатЗапроса.Выгрузить()[0].Ссылка; 	
	КонецЕсли; 
	Возврат ГрузополучательИРС;
	
КонецФункции


