//Евросиб Каблов М.Б. 14.11.2019 ( Необходимо создавать отдельные ЖД отправки (операции) на каждый вагон
&НаСервере
Функция ПодготовитьТаблицуОпераций(ЕстьНайденныеОперации = Ложь)
	
	Если ЗначениеЗаполнено(РейсЖД) Тогда
		ИРС_ГрузоотправительВРейсеЖД = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РейсЖД, "ИРС_Грузоотправитель");
		Если ИРС_ГрузоотправительВРейсеЖД <> ИРС_Грузополучатель Тогда
			РейсЖДОбъект = РейсЖД.ПолучитьОбъект();
			РейсЖДОбъект.ИРС_Грузоотправитель = ИРС_Грузополучатель;
			РейсЖДОбъект.Записать();
		Конецесли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаТС.ТекущееМестоположение КАК ТекущееМестоположение,
	|	ТаблицаТС.ПунктНазначения КАК ПунктНазначения,
	|	ТаблицаТС.ДатаОперации КАК ДатаОперации,
	|	ТаблицаТС.ДатаОтправления КАК ДатаОтправления,
	|	ТаблицаТС.ТС КАК ТС,
	|	ТаблицаТС.Грузополучатель КАК Грузополучатель,
	|	ТаблицаТС.НомерГУ КАК НомерГУ,
	|	ТаблицаТС.Груженый КАК Груженый
	|ПОМЕСТИТЬ ТаблицаТС
	|ИЗ
	|	&ТаблицаТС КАК ТаблицаТС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТС.ТекущееМестоположение КАК ТекущееМестоположение,
	|	ТаблицаТС.ПунктНазначения КАК ПунктНазначения,
	|	ТаблицаТС.ДатаОперации КАК ДатаОперации,
	|	ТаблицаТС.ДатаОтправления КАК ДатаОтправления,
	|	ТаблицаТС.ТС КАК ТС,
	|	ТаблицаТС.Грузополучатель КАК Грузополучатель,
	|	ТаблицаТС.НомерГУ КАК НомерГУ,
	|	ТаблицаТС.Груженый КАК Груженый,
	|	ОперацияГрузы.Ссылка КАК Операция,
	|	СправочникТС.ТипТС КАК ТипТС,
	|	ПротоколОбменов.УИДИсточника КАК КодНазначенияИРС,
	|	ОперацияГрузы.Ссылка.Примечание КАК Примечание,
	|	ЛОЖЬ КАК ВыгруженаВИРС
	|ИЗ
	|	ТаблицаТС КАК ТаблицаТС
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Операция.Грузы КАК ОперацияГрузы
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТС КАК СправочникТС
	|			ПО ОперацияГрузы.ТС = СправочникТС.Ссылка
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	|			ПО ОперацияГрузы.Ссылка = ПротоколОбменов.Объект
	|				И (ПротоколОбменов.ДействиеПриОбмене = НЕОПРЕДЕЛЕНО)
	|				И (ПротоколОбменов.УзелОбмена = НЕОПРЕДЕЛЕНО)
	|		ПО ТаблицаТС.ТС = ОперацияГрузы.ТС
	|			И ТаблицаТС.ДатаОтправления = ОперацияГрузы.Ссылка.ДатаНазначения
	|			И ТаблицаТС.ТекущееМестоположение = ОперацияГрузы.Ссылка.ПунктОтправления
	|			И ТаблицаТС.ПунктНазначения = ОперацияГрузы.Ссылка.ПунктНазначения
	|			И (ОперацияГрузы.Ссылка.Услуга = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.ЖДОтправка))";
	Запрос.УстановитьПараметр("ТаблицаТС", ТаблицаТС.Выгрузить());
	
	ТаблицаОпераций = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТаблицы Из ТаблицаОпераций Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.Операция) Тогда
			ЕстьНайденныеОперации = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОпераций, УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура СоздатьИВыгрузитьОперации(АдресТаблицы, ОбрабатыватьТолькоНеНайденные = Ложь, ЕстьОшибки = Ложь)
	
	ТаблицаОпераций = ПолучитьИзВременногоХранилища(АдресТаблицы);
	
	ТекДата = ТекущаяДатаСеанса();
	ВалютаРеглУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Для Каждого СтрТаблицы Из ТаблицаОпераций Цикл
		
		Если ЗначениеЗаполнено(СтрТаблицы.Операция) Тогда
			
			ОперацияСсылка = СтрТаблицы.Операция;
			
			Если ОбрабатыватьТолькоНеНайденные Тогда
				СтрокаСозданнойОперации = СписокОпераций.Добавить();
				СтрокаСозданнойОперации.Операция = ОперацияСсылка;
				СтрокаСозданнойОперации.Сообщение = "ЖД отправка уже есть.";
				Продолжить;
			КонецЕсли;
			
			ОперацияОбъект = ОперацияСсылка.ПолучитьОбъект();
			ОперацияОбъект.Примечание = ?(ЗначениеЗаполнено(СтрТаблицы.НомерГУ),СтрТаблицы.НомерГУ,Примечание);
			ОперацияОбъект.Записать(РежимЗаписиДокумента.Запись);
			
		Иначе
			ОперацияОбъект = Документы.Операция.СоздатьДокумент();
			ОперацияОбъект.Дата = ТекДата;
			ОперацияОбъект.Заполнить(Неопределено);
			ОперацияОбъект.РейсЖД = РейсЖД;
			ОперацияОбъект.Услуга = Справочники.ВидыОпераций.ЖДОтправка;
			ОперацияОбъект.Валюта = ВалютаРеглУчета;
			
			ОперацияОбъект.ПунктОтправления = СтрТаблицы.ТекущееМестоположение;
			ОперацияОбъект.ПунктНазначения = СтрТаблицы.ПунктНазначения;			
			ОперацияОбъект.ДатаОтправления = СтрТаблицы.ДатаОперации;
			ОперацияОбъект.ДатаНазначения = СтрТаблицы.ДатаОтправления;
			ОперацияОбъект.Примечание = ?(ЗначениеЗаполнено(СтрТаблицы.НомерГУ),СтрТаблицы.НомерГУ,Примечание);
			ОперацияОбъект.ТипДлительности = Перечисления.ЕдиницаИзмеренияДлительности.КалендарныйДень;
					
			НовСтрГрузы = ОперацияОбъект.Грузы.Добавить();
			НовСтрГрузы.ТСГУИД = Строка(Новый УникальныйИдентификатор);
			НовСтрГрузы.ТС = СтрТаблицы.ТС;
			НовСтрГрузы.ТипТС = СтрТаблицы.ТипТС;
			НовСтрГрузы.ГруженоеТС = СтрТаблицы.Груженый;
			НовСтрГрузы.Грузополучатель = СтрТаблицы.Грузополучатель;
			
			ОперацияОбъект.Записать(РежимЗаписиДокумента.Запись);
			
			ОперацияСсылка = ОперацияОбъект.Ссылка;
			
		КонецЕсли;		
		
		ТекстСообщения = "";
		Если ПолучитьФункциональнуюОпцию("ОтправлятьНазначенияВИРС") Тогда			
						
			Успешно = Ложь;			
			ЕСОбменСервер.ВыгрузитьНазначениеВИРС(ОперацияСсылка, ?(ЗначениеЗаполнено(СтрТаблицы.Грузополучатель), СтрТаблицы.Грузополучатель, ИРС_Грузополучатель), ТипНазначения, Успешно, ТекстСообщения);
			
			Если Успешно Тогда
				ТекстСообщения = "ЖД отправка создана/перезаписана. " + ТекстСообщения;
				ОперацияОбъект.Записать(РежимЗаписиДокумента.Проведение);
				СтрТаблицы.ВыгруженаВИРС = Истина;
			КонецЕсли;
			
		Иначе
			ТекстСообщения = "ЖД отправка создана.";
			ОперацияОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
		
		СтрокаСозданнойОперации = СписокОпераций.Добавить();
		СтрокаСозданнойОперации.Операция = ОперацияСсылка;
		СтрокаСозданнойОперации.Сообщение = ТекстСообщения;		
		
		// Связать вагоны и рейс
		Если ЗначениеЗаполнено(РейсЖД) Тогда
			МЗ = РегистрыСведений.ВагоныВОтправке.СоздатьМенеджерЗаписи();
			МЗ.Вагон = СтрТаблицы.ТС;
			МЗ.Отправка = РейсЖД;
			МЗ.Период = ТекДата;
			МЗ.Записать(Истина);
		КонецЕсли;
				
	КонецЦикла;
	АдресТаблицы = ПоместитьВоВременноеХранилище(ТаблицаОпераций, Новый УникальныйИдентификатор());
	ЕстьОшибки = ТаблицаОпераций.НайтиСтроки(Новый Структура("ВыгруженаВИРС", Ложь)).Количество() > 0;
КонецПроцедуры
