&НаКлиенте
Процедура СоздатьОперацию(Команда)
	
	СписокОпераций.Очистить();
	
	Если ТаблицаТС.Количество()>0 Тогда
		
//Евросиб Каблов М.Б. 21.11.2019 (
		//Если НЕ ЗначениеЗаполнено(РейсЖД) Тогда
		//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось создать операции! Не указан Рейс ЖД!");
		//	Возврат;			
		//КонецЕсли;
		
		//Если Не ЗначениеЗаполнено(ИРС_Грузополучатель) Тогда
		//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось создать операции! Не указан Грузополучатель (ИРС)!");
		//	Возврат;
		//КонецЕсли;
		Для каждого СтрокаТаблица Из ТаблицаТС Цикл
			Если Не ЗначениеЗаполнено(СтрокаТаблица.Грузополучатель) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось создать операции! Не указан Грузополучатель (ИРС)!");
				Возврат;
			КонецЕсли; 
		КонецЦикла; 

		ЕстьНайденныеОперации = Ложь;
		АдресТаблицыОпераций = ПодготовитьТаблицуОпераций(ЕстьНайденныеОперации);
		
		Если ЕстьНайденныеОперации Тогда
			ОповещениеОВыборе = Новый ОписаниеОповещения("СоздатьОперацииПродолжение", ЭтаФорма, Новый Структура("АдресТаблицыОпераций", АдресТаблицыОпераций));
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить("Перезаписать", "Перезаписать");
			КнопкаПоУмолчанию = Кнопки.Добавить("ТолькоСоздатьНовые", "Только создать новые");
			Кнопки.Добавить("Отмена");
			ПоказатьВопрос(ОповещениеОВыборе, "Уже есть ЖД отправки по выбранным вагонам. Перезаписать их?", Кнопки,, "ТолькоСоздатьНовые");
		Иначе
			ЕстьОшибки = Ложь;
			СоздатьИВыгрузитьОперации(АдресТаблицыОпераций,,ЕстьОшибки);
			Если ЕстьОшибки = Ложь Тогда
				Закрыть(Новый Структура("Результат, АдресТаблицыОпераций", Истина, АдресТаблицыОпераций));
			КонецЕсли; 
		КонецЕсли;
//Евросиб Каблов М.Б. 21.11.2019 )
		
	Иначе
		СозданиеСделки();		
	КонецЕсли;
	
	Если СписокОпераций.Количество()>0 Тогда
		Элементы.ГруппаОперации.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьОперацииПродолжение(Результат, ДополнительныеПараметры) Экспорт
	
	ЕстьОшибки = Ложь;
	Если Результат = "Перезаписать" Тогда
