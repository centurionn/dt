&НаСервере
Процедура СозданиеСделки()
	
	// Ищем транспортную схему в регистре
	ЗапросТСх = Новый Запрос;
	ЗапросТСх.Текст = 
		"ВЫБРАТЬ
		|	ТехнологическаяСхема.ТСх КАК ТСх
		|ИЗ
		|	РегистрСведений.ТехнологическаяСхема КАК ТехнологическаяСхема
		|ГДЕ
		|	ТехнологическаяСхема.ПредметТСх = &ПредметТСх
		|	И ТехнологическаяСхема.Вариант = &Вариант";
	
	ЗапросТСх.УстановитьПараметр("Вариант", "Фактическая");
	ЗапросТСх.УстановитьПараметр("ПредметТСх", Сделка);
	
	РезультатЗапросаТСх = ЗапросТСх.Выполнить();
	
	Если РезультатЗапросаТСх.Пустой() Тогда
		// Если не нашли сделку, то создать новую сделку и технологическую схему
		// Сделка
		НоваяСделка = Документы.Сделка.СоздатьДокумент();
		НоваяСделка.Дата = ТекущаяДата();
		НоваяСделка.Заполнить(Неопределено);
		НоваяСделка.СтанцияОтправления = ПунктОтправления;
		НоваяСделка.СтанцияНазначения = СтанцияНазначения;
		НоваяСделка.ПерваяОперация = ДатаОтправления;
		НоваяСделка.ЖДОтправка = ДатаОтправления;
		
		НоваяСделка.Записать(РежимЗаписиДокумента.Запись);
		Сделка = НоваяСделка.Ссылка;
		
		Сообщить("Создана сделка " + Сделка);
		
		// Технологическая схема
		НоваяТСх = Справочники.ТехнологическаяСхема.СоздатьЭлемент();
		НоваяТСх.Записать();
		
		МЗ = РегистрыСведений.ТехнологическаяСхема.СоздатьМенеджерЗаписи();
		МЗ.Период = ТекущаяДата();
		МЗ.ПредметТСх = Сделка;
		МЗ.ТСх = НоваяТСх.Ссылка;
		МЗ.Вариант = "Фактическая";
		МЗ.Записать(Истина);
		
	Иначе
		ВыборкаДетальныеЗаписиТСх = РезультатЗапросаТСх.Выбрать();
		Если ВыборкаДетальныеЗаписиТСх.Следующий() Тогда
			НоваяТСх = ВыборкаДетальныеЗаписиТСх.ТСх.ПолучитьОбъект();
		КонецЕсли;
	КонецЕсли;
	
	СтрТЧ = НоваяТСх.ТЧ.Добавить();
	
	// Новая операция
	НоваяОперация = Документы.Операция.СоздатьДокумент();
	НоваяОперация.Дата = ТекущаяДата();
	
	НоваяОперация.Заполнить(Неопределено);
	
	НоваяОперация.ПланФакт = Перечисления.ПланФактСчет.План;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыОпераций.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ВидыОпераций КАК ВидыОпераций
		|ГДЕ
		|	ВидыОпераций.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Наименование", "ЖД отправка");
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		УслугаЖД = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	НоваяОперация.Услуга = УслугаЖД;
	НоваяОперация.Сделка = Сделка;
	НоваяОперация.Валюта = Сделка.Валюта;
	НоваяОперация.ПунктОтправления = ПунктОтправления;
	НоваяОперация.ПунктНазначения = СтанцияНазначения;
	
	НоваяОперация.ДатаОтправления = ДатаОтправления;
	НоваяОперация.ТипДлительности = Перечисления.ЕдиницаИзмеренияДлительности.КалендарныйДень;
	
	// Заполняем ТЧ Грузы в операции
	НовСтрГрузы = НоваяОперация.Грузы.Добавить();
	ТСГУИД = Строка(Новый УникальныйИдентификатор);
	НовСтрГрузы.ТСГУИД = ТСГУИД;
	НовСтрГрузы.ТС = ТС;
	НовСтрГрузы.ТипТС = ТС.ТипТС;
	НовСтрГрузы.ГруженоеТС = Груженый;
	
	// Связать вагоны и рейс
	Если ЗначениеЗаполнено(РейсЖД) Тогда
		МЗ = РегистрыСведений.ВагоныВОтправке.СоздатьМенеджерЗаписи();
		МЗ.Вагон = ТС;
		МЗ.Отправка = РейсЖД;
		МЗ.Период = ТекущаяДата();
		МЗ.Записать(Истина);
	КонецЕсли;
	
	// Если на вагоне есть контейнеры, то заполняем по таблице контейнеров
	Для Каждого Стр Из ТаблицаТЕ Цикл
		НовСтрГрузы = НоваяОперация.Грузы.Добавить();
		НовСтрГрузы.ТСГУИД = ТСГУИД;
		НовСтрГрузы.ТС = ТС;
		НовСтрГрузы.ТипТС = ТС.ТипТС;
		НовСтрГрузы.ГруженоеТС = Груженый;
		
		ТЕГУИД = Строка(Новый УникальныйИдентификатор);
		НовСтрГрузы.ТЕГУИД = ТЕГУИД;
		НовСтрГрузы.ТЕ = Стр.ТЕ;
		НовСтрГрузы.ГруженоеТЕ = Истина;
		
	КонецЦикла;
		
	НоваяОперация.Записать(РежимЗаписиДокумента.Проведение);
	
	СозданнаяОперация = НоваяОперация.Ссылка;
	
	ЕдиничнаяОперация = СозданнаяОперация;
	
	Сообщить("Создана операция " + ЕдиничнаяОперация);
	
	// Заполняем табличную чать ТЧ в технологической схеме
	ЗаполнитьЗначенияСвойств(СтрТЧ,НоваяОперация); 
	СтрТЧ.ГУИД = ТСГУИД;
	СтрТЧ.Операция = СозданнаяОперация;
	
	НоваяТСх.Записать();
	
	//// Редактирование СДЕЛКИ
	ТекСделка = Сделка.ПолучитьОбъект();
	// Добавить в сделке в тч СвязьУчетныхЕдиниц Номер вагона
	Для Каждого Стр Из ТаблицаТЕ Цикл
		ТЧ_Тс_Те = ТекСделка.СвязьУчетныхЕдиниц.Добавить();
		ТЧ_Тс_Те.Вагон = ТС;
		ТЧ_Тс_Те.Контейнер = Стр.ТЕ;
	КонецЦикла;
	
	// Добавить в сделке расходы
	ТЧРасх = ТекСделка.Расходы.Добавить();
	ТЧРасх.Услуга = УслугаЖД;
	ТЧРасх.Груз = Груз;
	ТЧРасх.Операция = СозданнаяОперация;
	ТЧРасх.ГУИД = Строка(Новый УникальныйИдентификатор);
	ТЧРасх.Валюта = СозданнаяОперация.Валюта;
	ТЧРасх.НДСВключенВСтоимость = СозданнаяОперация.ВключаетНДС;
	ТЧРасх.Количество = 1;
	ТЧРасх.Себестоимость = СтоимостьПеревозки;
	//Евросиб СубботинВ #125845 09.12.2025 Начало // Добавить условие по дате?
	ТЧРасх.СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
	
	ТЧРасх.СебестоимостьИтого	= ТЧРасх.Себестоимость * ТЧРасх.Количество;
	ТЧРасх.СуммаНДС = ПолучитьСуммуНДС(ТЧРасх.СебестоимостьИтого, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(ТЧРасх.СтавкаНДС), Истина, ТЧРасх.НДСВключенВСтоимость);
	ТЧРасх.СуммаИтого = ТЧРасх.СебестоимостьИтого + ?(ТЧРасх.НДСВключенВСтоимость, 0, ТЧРасх.СуммаНДС);
	
	ПериодБлокировки8 = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериод(Сделка.Организация);
	
	ТЧРасх.ПериодВО = ПериодБлокировки8;
	
	Попытка
		ТекСделка.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ТекСделка.Записать(РежимЗаписиДокумента.Запись);
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСуммуНДС(Сумма, СтавкаНДС, УчитыватьНДС, СуммаВключаетНДС) Экспорт
		Если (УчитыватьНДС) и (СуммаВключаетНДС) Тогда
			СуммаБезНДС = 100 * Сумма / (100 + СтавкаНДС);
			СуммаНДС = Сумма - СуммаБезНДС;
		Иначе
			СуммаБезНДС = Сумма;
		КонецЕсли;

		Если УчитыватьНДС Тогда 
			Если НЕ СуммаВключаетНДС Тогда
				СуммаНДС = СуммаБезНДС * СтавкаНДС / 100;
			КонецЕсли;
		Иначе
			СуммаНДС = 0;
		КонецЕсли;

		Возврат СуммаНДС;

КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
//Евросиб Каблов М.Б. 21.11.2019 (
	Параметры.Свойство("СтанцияНазначения", СтанцияНазначения);
	Параметры.Свойство("ДатаОтправления", ДатаОтправления);
	Параметры.Свойство("РейсЖД", РейсЖД);
	
	ИРС_Грузополучатель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РейсЖД, "ИРС_Грузоотправитель");
//Евросиб Каблов М.Б. 21.11.2019 )
	
	Если Параметры.Свойство("СписокВагонов") Тогда
		//Евросиб Каблов М.Б. 08.01.2020 (
		Если Параметры.Свойство("Повагонка") Тогда
			ТаблицаВагонов = Параметры.СписокВагонов.Выгрузить(Новый Структура("Пометка", Истина), 
																		"НомерВагона,
																		|СтанцияНазначения,
																		|СтанцияПодачи,
																		|ДатаПлановогоОтправленияСоСтанцииПодачи,
																		|Грузоотправитель,
																		|НомерГУ");
			ТаблицаВагонов.Колонки.НомерВагона.Имя = "Вагон";
			ТаблицаВагонов.Колонки.СтанцияНазначения.Имя = "ТекЛокация";
			ТаблицаВагонов.Колонки.СтанцияПодачи.Имя = "ЛокацияНазначения";
			ТаблицаВагонов.Колонки.ДатаПлановогоОтправленияСоСтанцииПодачи.Имя = "ДатаОтправления";
			СоздаватьНазначенияВнутриОднойСтанции = Истина;
		Иначе
