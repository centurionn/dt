
&НаКлиенте
Процедура ТСПриИзменении(Элемент)
	
	ОчиститьРеквизитыФормы();
	
	Элементы.ГруппаОперации.Видимость = Ложь;
	
	Если ЗначениеЗаполнено(ТС) Тогда
		ПоискДислокации();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьРеквизитыФормы()
	
	МассивРеквизитов = ЭтаФорма.ПолучитьРеквизиты();
	Для Каждого Элем Из МассивРеквизитов Цикл
		
		Если Элем.Имя = "ТС" Тогда
			Продолжить;
		КонецЕсли;
		Если Элем.Имя = "Груженый" Тогда
			Груженый = 1;
			Продолжить;
		КонецЕсли;
		
		Попытка 
			ЭтаФорма[Элем.Имя] = "" 
		Исключение 
		КонецПопытки;
		Попытка 
			ЭтаФорма[Элем.Имя] = Неопределено 
		Исключение 
		КонецПопытки;
		Попытка 
			ЭтаФорма[Элем.Имя].Очистить() 
		Исключение 
		КонецПопытки;
		Попытка 
			ЭтаФорма[Элем.Имя].Строки.Очистить() 
		Исключение 
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры
	
&НаСервере
Процедура ПоискДислокации()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДислокацияВагоновСрезПоследних.СтанцияОперации КАК ТекущееМестоположение,
		|	ДислокацияВагоновСрезПоследних.СтанцияНазначения КАК ПунктНазначения,
		|	ДислокацияВагоновСрезПоследних.Период КАК ДатаОперации,
		|	ДислокацияВагоновСрезПоследних.Груз КАК Груз,
		|	ДислокацияВагоновСрезПоследних.Груженый КАК Груженый,
		|	ДислокацияВагоновСрезПоследних.РабочийПарк КАК РабочийПарк,
		|	ДислокацияВагоновСрезПоследних.ВесГруза КАК ВесГруза,
		|	ДислокацияВагоновСрезПоследних.ОперацияСВагоном КАК ОперацияСВагоном
		|ИЗ
		|	РегистрСведений.ДислокацияВагонов.СрезПоследних(, Вагон = &НомерТС) КАК ДислокацияВагоновСрезПоследних";
	
	Запрос.УстановитьПараметр("НомерТС", ТС);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтаФорма,ВыборкаДетальныеЗаписи);
		ПунктОтправления = ВыборкаДетальныеЗаписи.ПунктНазначения;
		
	КонецЕсли;
	
	// Получить контейнеры по вагону из дислокации
	ЗапросКнт = Новый Запрос;
	ЗапросКнт.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДислокацияКонтейнеровСрезПоследних.Контейнер КАК ТЕ,
		|	ДислокацияКонтейнеровСрезПоследних.Груженый КАК Груженый
		|ИЗ
		|	РегистрСведений.ДислокацияКонтейнеров.СрезПоследних(, Вагон = &НомерВагона) КАК ДислокацияКонтейнеровСрезПоследних";
	
	ЗапросКнт.УстановитьПараметр("НомерВагона", ТС);
	
	РезультатЗапросаКнт = ЗапросКнт.Выполнить();
	
	ВыборкаДетальныеЗаписиКнт = РезультатЗапросаКнт.Выбрать();
	
	Пока ВыборкаДетальныеЗаписиКнт.Следующий() Цикл
		НовСтр = ТаблицаТЕ.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,ВыборкаДетальныеЗаписиКнт);
	КонецЦикла;
	
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	Закрыть(Новый Структура("Результат, АдресТаблицыОпераций", Истина, АдресТаблицыОпераций));

КонецПроцедуры

&НаКлиенте
Процедура ПодборСделки(Команда)
	
	ПараметрыОтбора = Новый Структура("СтанцияОтправления,СтанцияНазначения,ДатаОтправления",ПунктОтправления,СтанцияНазначения,ДатаОтправления);
	Оповещение = Новый ОписаниеОповещения("ОкончаниеВыбораСделки", ЭтаФорма);
	ОткрытьФорму("Документ.Операция.Форма.ФормаПодборСделки",ПараметрыОтбора,, ЭтаФорма,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОкончаниеВыбораСделки(Результат = Неопределено, Параметр2 = Неопределено) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		Сделка = Результат.Сделка;
		РейсЖД = Результат.РейсЖД;
		СлужебнаяСделка = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
