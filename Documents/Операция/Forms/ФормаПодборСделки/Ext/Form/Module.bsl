
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("СтанцияОтправления") И Параметры.Свойство("СтанцияНазначения") Тогда
		
		СписокСделок.Очистить();
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТабельныеРасписанияРЖДРасписание.Ссылка КАК Ссылка,
			|	ТабельныеРасписанияРЖДРасписание.Станция КАК СтанцияНазначения,
			|	ТабельныеРасписанияРЖДРасписание.НомерСтроки КАК НомерСтрокиНазначения,
			|	ВложенныйЗапрос.СтанцияОтправления КАК СтанцияОтправления,
			|	ВложенныйЗапрос.НомерСтрокиОтправления КАК НомерСтрокиОтправления
			|ПОМЕСТИТЬ ТабРасписание
			|ИЗ
			|	(ВЫБРАТЬ
			|		ТабельныеРасписанияРЖДРасписание.Ссылка КАК Ссылка,
			|		ТабельныеРасписанияРЖДРасписание.Станция КАК СтанцияОтправления,
			|		ТабельныеРасписанияРЖДРасписание.НомерСтроки КАК НомерСтрокиОтправления
			|	ИЗ
			|		Справочник.ТабельныеРасписанияРЖД.Расписание КАК ТабельныеРасписанияРЖДРасписание
			|	ГДЕ
			|		ТабельныеРасписанияРЖДРасписание.Станция = &СтанцияОтправления) КАК ВложенныйЗапрос
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТабельныеРасписанияРЖД.Расписание КАК ТабельныеРасписанияРЖДРасписание
			|		ПО ВложенныйЗапрос.Ссылка = ТабельныеРасписанияРЖДРасписание.Ссылка
			|			И ВложенныйЗапрос.НомерСтрокиОтправления < ТабельныеРасписанияРЖДРасписание.НомерСтроки
			|ГДЕ
			|	ТабельныеРасписанияРЖДРасписание.Станция = &СтанцияНазначения
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	РейсыЖД.УсловнаяДлинаСостава КАК УсловнаяДлинаСостава,
			|	РейсыЖД.Ссылка КАК Операция,
			|	ТабРасписание.Ссылка КАК ТабРасписание
			|ПОМЕСТИТЬ ДлинаСостава
			|ИЗ
			|	ТабРасписание КАК ТабРасписание
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РейсыЖД КАК РейсыЖД
			|		ПО ТабРасписание.Ссылка = РейсыЖД.ТабельноеРасписание
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СУММА(ВагоныВОтправке.Вагон.ТипТС.УсловнаяДлина) КАК ДлинаВсехВагонов,
			|	ДлинаСостава.Операция КАК Операция
			|ПОМЕСТИТЬ ДлинаВагонов
			|ИЗ
			|	ДлинаСостава КАК ДлинаСостава
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ВагоныВОтправке КАК ВагоныВОтправке
			|		ПО ДлинаСостава.Операция = ВагоныВОтправке.Отправка
			|
			|СГРУППИРОВАТЬ ПО
			|	ДлинаСостава.Операция
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ДлинаВагонов.ДлинаВсехВагонов КАК ДлинаВсехВагонов,
			|	ДлинаВагонов.Операция КАК Операция,
			|	ДлинаСостава.УсловнаяДлинаСостава КАК УсловнаяДлинаСостава,
			|	ДлинаСостава.ТабРасписание КАК ТабРасписание
			|ПОМЕСТИТЬ ОперацияДлины
			|ИЗ
			|	ДлинаСостава КАК ДлинаСостава
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДлинаВагонов КАК ДлинаВагонов
			|		ПО ДлинаСостава.Операция = ДлинаВагонов.Операция
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ОперацияДлины.ДлинаВсехВагонов КАК РазмеченнаяДлина,
			|	ОперацияДлины.Операция КАК РейсЖД,
			|	ОперацияДлины.УсловнаяДлинаСостава КАК УсловнаяДлинаСостава,
			|	СделкаРейсы.Ссылка КАК Сделка,
			|	ОперацияДлины.ТабРасписание КАК ТабРасписание
			|ПОМЕСТИТЬ Сделки
			|ИЗ
			|	ОперацияДлины КАК ОперацияДлины
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.Рейсы КАК СделкаРейсы
			|		ПО ОперацияДлины.Операция = СделкаРейсы.Рейс
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	СделкаСвязьУчетныхЕдиниц.Вагон КАК Вагон
			|ПОМЕСТИТЬ ВагонСделки
			|ИЗ
			|	Сделки КАК Сделки
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
			|		ПО Сделки.Сделка = СделкаСвязьУчетныхЕдиниц.Ссылка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ДислокацияВагоновСрезПоследних.СтанцияОперации КАК СтанцияОперацииСделки,
			|	ДислокацияВагоновСрезПоследних.Период КАК Период
			|ПОМЕСТИТЬ ДислокацияВагонаСделки
			|ИЗ
			|	РегистрСведений.ДислокацияВагонов.СрезПоследних(
			|			,
			|			Вагон В
			|				(ВЫБРАТЬ
			|					ВагонСделки.Вагон
			|				ИЗ
			|					ВагонСделки КАК ВагонСделки)) КАК ДислокацияВагоновСрезПоследних
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТабельныеРасписанияРЖДРасписание.Ссылка КАК Ссылка,
			|	ТабельныеРасписанияРЖДРасписание.Станция КАК СтанцияНазначенияВагонаСделки,
			|	ТабельныеРасписанияРЖДРасписание.НомерСтроки КАК НомерСтрокиНазначенияВагонаСделки,
			|	ВложенныйЗапрос.НомерСтрокиОтправленияВагонаСделки КАК НомерСтрокиОтправленияВагонаСделки
			|ПОМЕСТИТЬ ТабРасписаниеСделка
			|ИЗ
			|	(ВЫБРАТЬ
			|		ТабельныеРасписанияРЖДРасписание.Ссылка КАК Ссылка,
			|		ТабельныеРасписанияРЖДРасписание.Станция КАК СтанцияОтправленияВагонаСделки,
			|		ТабельныеРасписанияРЖДРасписание.НомерСтроки КАК НомерСтрокиОтправленияВагонаСделки
			|	ИЗ
			|		Справочник.ТабельныеРасписанияРЖД.Расписание КАК ТабельныеРасписанияРЖДРасписание
			|	ГДЕ
			|		ТабельныеРасписанияРЖДРасписание.Станция В
			|				(ВЫБРАТЬ
			|					ДислокацияВагонаСделки.СтанцияОперацииСделки
			|				ИЗ
			|					ДислокацияВагонаСделки КАК ДислокацияВагонаСделки)
			|		И ТабельныеРасписанияРЖДРасписание.Ссылка В
			|				(ВЫБРАТЬ
			|					ТабРасписание.Ссылка
			|				ИЗ
			|					ТабРасписание КАК ТабРасписание)) КАК ВложенныйЗапрос
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТабельныеРасписанияРЖД.Расписание КАК ТабельныеРасписанияРЖДРасписание
			|		ПО ВложенныйЗапрос.Ссылка = ТабельныеРасписанияРЖДРасписание.Ссылка
			|ГДЕ
			|	ТабельныеРасписанияРЖДРасписание.Станция = &СтанцияОтправления
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТабРасписаниеСделка.Ссылка КАК ТабРасписание,
			|	СУММА(ТабельныеРасписанияРЖДРасписание.ДоСледующейСтанции) КАК ДоПунктаОтправления
			|ПОМЕСТИТЬ РасстояниеВТабеле
			|ИЗ
			|	ТабРасписаниеСделка КАК ТабРасписаниеСделка
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТабельныеРасписанияРЖД.Расписание КАК ТабельныеРасписанияРЖДРасписание
			|		ПО ТабРасписаниеСделка.Ссылка = ТабельныеРасписанияРЖДРасписание.Ссылка
			|			И (ТабельныеРасписанияРЖДРасписание.НомерСтроки МЕЖДУ ТабРасписаниеСделка.НомерСтрокиОтправленияВагонаСделки И ТабРасписаниеСделка.НомерСтрокиНазначенияВагонаСделки)
			|
			|СГРУППИРОВАТЬ ПО
			|	ТабРасписаниеСделка.Ссылка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	РасстояниеВТабеле.ТабРасписание КАК ТабРасписание,
			|	РасстояниеВТабеле.ДоПунктаОтправления КАК ДоПунктаОтправления,
			|	Сделки.РазмеченнаяДлина КАК РазмеченнаяДлина,
			|	Сделки.РейсЖД КАК РейсЖД,
			|	Сделки.УсловнаяДлинаСостава КАК УсловнаяДлинаСостава,
			|	Сделки.Сделка КАК Сделка,
			|	ДОБАВИТЬКДАТЕ(ДислокацияВагонаСделки.Период, ЧАС, РасстояниеВТабеле.ДоПунктаОтправления) КАК ДатаПрибытияСостава
			|ИЗ
			|	РасстояниеВТабеле КАК РасстояниеВТабеле
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Сделки КАК Сделки
			|		ПО РасстояниеВТабеле.ТабРасписание = Сделки.ТабРасписание,
			|	ДислокацияВагонаСделки КАК ДислокацияВагонаСделки";
		
		Запрос.УстановитьПараметр("СтанцияНазначения", Параметры.СтанцияНазначения);
		Запрос.УстановитьПараметр("СтанцияОтправления", Параметры.СтанцияОтправления);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если ВыборкаДетальныеЗаписи.ДатаПрибытияСостава>=Параметры.ДатаОтправления И ЗначениеЗаполнено(Параметры.ДатаОтправления) Тогда
				НовСтр = СписокСделок.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр,ВыборкаДетальныеЗаписи);
			КонецЕсли;
		КонецЦикла;
		Элементы.СписокСделокДатаПрибытияСостава.Заголовок = "План. прибытие на ст. " + СокрЛП(Строка(Параметры.СтанцияОтправления));
		
	КонецЕсли;
	

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры

