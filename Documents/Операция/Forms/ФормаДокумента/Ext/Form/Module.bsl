&НаКлиенте
Процедура ЗаписатьСтроку(Строка)
	
	НСтр = Объект.Грузы.Добавить();
	ЗаполнитьЗначенияСвойств(НСтр, Строка);
	Для каждого Стр из Строка.ПолучитьЭлементы() Цикл
		ЗаписатьСтроку(Стр);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если СделкаЗакрыта Тогда
		УстановитьДоступностьКарточкиОперации(Ложь);
	КонецЕсли;
		
	РаскрытьДеревоГрузов();
	Элементы.ГруппаЛичныеЦели.Заголовок = "Личные цели ("+Объект.ЛичныеЦели.Количество()+")";
	
КонецПроцедуры

&НаКлиенте
Процедура РаскрытьДеревоГрузов()
	Для каждого Стр из ДеревоГрузов.ПолучитьЭлементы() Цикл
		Элементы.ДеревоГрузов.Развернуть(Стр.ПолучитьИдентификатор(), Истина);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьТС(Команда)
	
	НСтр = ДеревоГрузов.ПолучитьЭлементы().Добавить();
	НСтр.ТСГУИД = Строка(Новый УникальныйИдентификатор);
	Элементы.ДеревоГрузов.ТекущаяСтрока = НСтр.ПолучитьИдентификатор();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьТЕ(Команда)
	
	ТекД = Элементы.ДеревоГрузов.ТекущиеДанные;
	Если ТекД <> неопределено И НЕ ЗначениеЗаполнено(ТекД.ТЕГУИД) Тогда
		ТекД.ГруженоеТС = Истина;
		НСтр = ТекД.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(НСтр, ТекД, "ТСГУИД,ТипТС,ТС");
		НСтр.ТЕГУИД = Строка(Новый УникальныйИдентификатор);
		НСтр.ГруженоеТЕ = Истина;
		РаскрытьДеревоГрузов();
	Иначе
		Сообщить("Выберите строку с вагоном и повторите попытку.");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоГрузовТипТСПриИзменении(Элемент)
	
	ТекД = Элементы.ДеревоГрузов.ТекущиеДанные;
	Для каждого Стр из ТекД.ПолучитьЭлементы() Цикл
		УстановитьРеквизитРекурсивно(Стр, "ТипТС", ТекД.ТипТС);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьРеквизитРекурсивно(Строка, ИмяРеквизита, ЗначениеРеквизита)
	
	Строка[ИмяРеквизита] = ЗначениеРеквизита;
	Для каждого Стр из Строка.ПолучитьЭлементы() Цикл
		УстановитьРеквизитРекурсивно(Стр, ИмяРеквизита, ЗначениеРеквизита);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоГрузовТСПриИзменении(Элемент)
	
	ТекД = Элементы.ДеревоГрузов.ТекущиеДанные;
	Для каждого Стр из ТекД.ПолучитьЭлементы() Цикл
		УстановитьРеквизитРекурсивно(Стр, "ТС", ТекД.ТС);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("ИзмениласьОперация", Объект.Ссылка);
	ЭтаФорма.ОбновитьОтображениеДанных();
	
