&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Объект.Сделка) Тогда
		СделкаЗакрыта = ЗначениеЗаполнено(Объект.Сделка.ДатаЗакрытияСделки);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		СоответствиеОперацийТСГУИД = Новый Соответствие;
		СоответствиеОперацийТЕГУИД = Новый Соответствие;
		
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Операция", Объект.Ссылка);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ОперацияГрузы.ТСГУИД КАК ТСГУИД,
		               |	ОперацияГрузы.ТипТС КАК ТипТС,
		               |	ОперацияГрузы.ТС КАК ТС,
		               |	ОперацияГрузы.ТЕГУИД КАК ТЕГУИД,
		               |	ОперацияГрузы.ТипТЕ КАК ТипТЕ,
		               |	ОперацияГрузы.ТЕ КАК ТЕ,
		               |	ОперацияГрузы.НомерЖДН КАК НомерЖДН,
		               |	ОперацияГрузы.ГруженоеТС КАК ГруженоеТС,
		               |	ОперацияГрузы.ГруженоеТЕ КАК ГруженоеТЕ,
		               |	ОперацияГрузы.ДатаОтправления КАК ДатаОтправления,
		               |	ОперацияГрузы.ДатаПрибытия КАК ДатаПрибытия
		               |ИЗ
		               |	Документ.Операция.Грузы КАК ОперацияГрузы
		               |ГДЕ
		               |	ОперацияГрузы.Ссылка = &Операция
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ТСГУИД,
		               |	ТЕГУИД";
		Ответ = Запрос.Выполнить().Выбрать();
		Пока Ответ.Следующий() Цикл
			Если ЗначениеЗаполнено(Ответ.ТСГУИД) и НЕ ЗначениеЗаполнено(Ответ.ТЕГУИД) Тогда
				НСтр = ДеревоГрузов.ПолучитьЭлементы().Добавить();
				ЗаполнитьЗначенияСвойств(НСтр, Ответ,, "НомерЖДН");
				СоответствиеОперацийТСГУИД.Вставить(Ответ.ТСГУИД, НСтр);
			ИначеЕсли ЗначениеЗаполнено(Ответ.ТСГУИД) и ЗначениеЗаполнено(Ответ.ТЕГУИД) Тогда
				НСтр = СоответствиеОперацийТСГУИД[Ответ.ТСГУИД].ПолучитьЭлементы().Добавить();
				ЗаполнитьЗначенияСвойств(НСтр, Ответ);
				СоответствиеОперацийТЕГУИД.Вставить(Ответ.ТЕГУИД, НСтр);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	// Обновляем панель текущего пользователя и панель состояний
	ОбновитьПанельТекущегоПользователя();
	ОбновитьПанельСостояний();
	// - Состояния
	
	ДоступныеЛичныеЦели = ЛичныеЦелиСервер.ПолучитьДействующиеЦелиДляРучнойОтметки(Объект.Ссылка);
	Для каждого Стр из ДоступныеЛичныеЦели Цикл
		НСтр = Объект.ЛичныеЦели.Добавить();
		ЗаполнитьЗначенияСвойств(НСтр, Стр);
	КонецЦикла;
		

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры

