	Элементы.ГруппаОрганПодрПоставщик.Доступность = Доступность;
	Элементы.Валюта.Доступность = Доступность;
	Элементы.ГруппаСтавкаНДС.Доступность = Доступность;
	Элементы.Регламентный.Доступность = Доступность;
	Элементы.ГруппаДвижениеСтоимость.Доступность = Доступность;
	Элементы.ГруппаСтраницы.Доступность = Доступность;
	
