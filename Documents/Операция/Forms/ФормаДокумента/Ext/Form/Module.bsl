&НаСервере
Процедура СторноНаСервере()
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПозицияВагоновФактОстатки.Локация КАК Локация,
	               |	ПозицияВагоновФактОстатки.Вагон КАК Вагон,
	               |	ПозицияВагоновФактОстатки.ТипВагона КАК ТипВагона,
	               |	ПозицияВагоновФактОстатки.ФактОстаток КАК Остаток
	               |ИЗ
	               |	РегистрНакопления.ПозицияВагоновФакт.Остатки(&Период, ) КАК ПозицияВагоновФактОстатки";
	Запрос.УстановитьПараметр("Период", Объект.ДатаНазначенияФакт-1);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		НСтр = Объект.КорректировкаВагоны.Добавить();
		ЗаполнитьЗначенияСвойств(НСтр, Ответ);
		НСтр.Остаток = -НСтр.Остаток;
		НСтр.ПериодЪ = Объект.ДатаНазначенияФакт;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПоДислокации(Команда)
	Объект.КорректировкаВагоны.Очистить();
	УстановитьПоДислокацииНаСервере();
КонецПроцедуры

&НаСервере
Процедура УстановитьПоДислокацииНаСервере()
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДислокацияВагоновСрезПоследних.Вагон КАК Вагон,
	               |	ДислокацияВагоновСрезПоследних.СтанцияОперации КАК Локация,
	               |	ДислокацияВагоновСрезПоследних.Вагон.ТипТС КАК ТипВагона,
	               |	ДислокацияВагоновСрезПоследних.Груженый КАК Груженый,
	               |	ДислокацияВагоновСрезПоследних.Период КАК Период
	               |ИЗ
	               |	РегистрСведений.ДислокацияВагонов.СрезПоследних(&период, ) КАК ДислокацияВагоновСрезПоследних";
	Запрос.УстановитьПараметр("Период", Объект.ДатаНазначенияФакт-1);
	Ответ = Запрос.Выполнить().Выбрать();
	
	МассивОтработанныхВагонов = Новый Массив;
	
	Пока Ответ.Следующий() Цикл
		
		Если МассивОтработанныхВагонов.Найти(Ответ.Вагон) <> неопределено Тогда Продолжить; КонецЕсли;
		
		НСтр = Объект.КорректировкаВагоны.Добавить();
		ЗаполнитьЗначенияСвойств(НСтр, Ответ);
		НСтр.ПериодЪ = Ответ.Период;
		НСтр.Остаток = 1;
		
		МассивОтработанныхВагонов.Добавить(Ответ.Вагон);
		
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура ТипВагонаДляВсех(Команда)
	
	Для Сч = 1 По Объект.КорректировкаВагоны.Количество()-1 Цикл
		Если НЕ ЗначениеЗаполнено(Объект.КорректировкаВагоны[Сч].ТипВагона) Тогда
			Объект.КорректировкаВагоны[Сч].ТипВагона = Объект.КорректировкаВагоны[0].ТипВагона;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОтправленияФактПриИзменении(Элемент)
	
	Для каждого Стр1 из ДеревоГрузов.ПолучитьЭлементы() Цикл
		Если НЕ ЗначениеЗаполнено(Стр1.ДатаОтправления) Тогда Стр1.ДатаОтправления = Объект.ДатаОтправленияФакт; КонецЕсли;
		Для каждого Стр2 из Стр1.ПолучитьЭлементы() Цикл
			Если НЕ ЗначениеЗаполнено(Стр2.ДатаОтправления) Тогда Стр2.ДатаОтправления = Объект.ДатаОтправленияФакт; КонецЕсли;
			Для каждого Стр3 из Стр2.ПолучитьЭлементы() Цикл
				Если НЕ ЗначениеЗаполнено(Стр3.ДатаОтправления) Тогда Стр3.ДатаОтправления = Объект.ДатаОтправленияФакт; КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

