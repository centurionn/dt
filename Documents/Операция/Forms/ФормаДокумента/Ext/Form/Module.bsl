&НаКлиенте
Процедура ОбработкаВставкиExcel(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 <> неопределено И Параметр2 <> неопределено И Параметр2.Свойство("Вагоны") Тогда
		
		Для каждого Стр из Параметр1 Цикл
			ТССсылка = ПолучитьТС(Стр);
			Если Объект.Грузы.НайтиСтроки(Новый Структура("ТС", ТССсылка)).Количество() > 0 Тогда Продолжить; КонецЕсли;
			НСтр = ДеревоГрузов.ПолучитьЭлементы().Добавить();
			НСтр.ТСГУИД = Строка(Новый УникальныйИдентификатор);
			НСтр.ТС = ТССсылка;
			НСтр.ТипТС = ПолучитьТипТС(ТССсылка);
		КонецЦикла;
		
	ИначеЕсли Параметр1 <> неопределено И Параметр2 <> неопределено И Параметр2.Свойство("КТК") Тогда
		
		Для каждого Стр из Параметр1 Цикл
			ТЕСсылка = ПолучитьТЕ(Стр);
			Если Объект.Грузы.НайтиСтроки(Новый Структура("ТЕ", ТЕСсылка)).Количество() > 0 Тогда Продолжить; КонецЕсли;
			ТекД = Элементы.ДеревоГрузов.ТекущиеДанные;
			НСтр = ТекД.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(НСтр, ТекД, "ТСГУИД,ТипТС,ТС");
			НСтр.ТЕГУИД = Строка(Новый УникальныйИдентификатор);
			НСтр.ТЕ = ТЕСсылка;
			НСтр.ТипТЕ = ПолучитьТипТЕ(ТЕСсылка);
		КонецЦикла;
		
	КонецЕсли;
	
	РаскрытьДеревоГрузов();
	
КонецПроцедуры

