		//ЗапросСт.УстановитьПараметр("Операция",Ссылка);
		//Если НЕ ЗапросСт.Выполнить().Пустой() Тогда
		//	ПеремещениеВСток = Истина;
		//КонецЕсли;
		//
		//// проверка, разрешает ли операция возврат владельцу
		//ВозвратВладельцу = Ложь;
		//
		//ЗапросСт = Новый Запрос;
		//ЗапросСт.Текст = "ВЫБРАТЬ
		//                 |	ТехнологическаяСхемаТЧ.Ссылка КАК Ссылка
		//                 |ИЗ
		//                 |	Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
		//                 |ГДЕ
		//                 |	ТехнологическаяСхемаТЧ.Операция = &Операция
		//                 |	И ТехнологическаяСхемаТЧ.Услуга.ОперацияВозвращаетКТКВладельцу";
		//ЗапросСт.УстановитьПараметр("Операция",Ссылка);
		//Если НЕ ЗапросСт.Выполнить().Пустой() Тогда
		//	ВозвратВладельцу = Истина;
		//КонецЕсли;
		
		// контейнеры
		Запрос.Текст = "ВЫБРАТЬ
		               |	МАКСИМУМ(ОперацияГрузы.ТипТЕ) КАК ТипТЕ,
		               |	ОперацияГрузы.ТЕГУИД КАК ТЕГУИД,
		               |	МАКСИМУМ(ОперацияГрузы.ТЕ) КАК ТЕ,
		               |	МАКСИМУМ(ОперацияГрузы.ГруженоеТЕ) КАК ГруженоеТЕ,
		               |	МАКСИМУМ(ОперацияГрузы.ДатаПрибытия) КАК ДатаПрибытия,
		               |	МАКСИМУМ(ОперацияГрузы.ДатаОтправления) КАК ДатаОтправления
		               |ПОМЕСТИТЬ ВТ
		               |ИЗ
		               |	Документ.Операция.Грузы КАК ОперацияГрузы
		               |ГДЕ
		               |	ОперацияГрузы.Ссылка = &Ссылка
		               |	И ОперацияГрузы.ТипТЕ <> ЗНАЧЕНИЕ(Справочник.ТипоразмерыТЕ.ПустаяСсылка)
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ОперацияГрузы.ТЕГУИД
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВТ.ТипТЕ КАК ТипТЕ,
		               |	ВТ.ТЕГУИД КАК ТЕГУИД,
		               |	ВТ.ТЕ КАК ТЕ,
		               |	ВТ.ГруженоеТЕ КАК ГруженоеТЕ,
		               |	ПризнакСобственностиКонтейнераСрезПоследних.ВладелецКТК КАК ВладелецКТК,
		               |	ПризнакСобственностиКонтейнераСрезПоследних.ДокументРегистратор.ДокументОснование КАК Заявка,
