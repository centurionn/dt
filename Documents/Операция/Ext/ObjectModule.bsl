			Если ЗначениеЗаполнено(ДатаНазначения) И НЕ ЗначениеЗаполнено(ДатаНазначенияФакт) Тогда
				// плановое прибытие
				
				Движение 			= Движения.ПозицияКонтейнеровПлан.ДобавитьПриход();
