		               |	ВладелецКонт.ВладелецКТК КАК ВладелецКТК,
		               |	ЗаявкаСоставУслуги.ПунктОтправления КАК Сток,
		               |	ЗаявкаСоставУслуги.ПунктНазначения КАК ПунктНазначения,
		               |	ВладелецКонт.ДатаОтправления КАК ДатаОтправления,
		               |	ВладелецКонт.ДатаПрибытия КАК ДатаПрибытия
		               |ИЗ
		               |	ВладелецКонт КАК ВладелецКонт
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
		               |		ПО ВладелецКонт.ТЕ = ЗаявкаСоставУслуги.НомерКТК
		               |			И ВладелецКонт.ВладелецКТК = ЗаявкаСоставУслуги.ВладелецКТК
		               |			И ВладелецКонт.Заявка = ЗаявкаСоставУслуги.Ссылка";
		Ответ = Запрос.Выполнить().Выбрать();
		Пока Ответ.Следующий() Цикл
			
			Если ЗначениеЗаполнено(ДатаОтправления) И НЕ ЗначениеЗаполнено(ДатаОтправленияФакт) Тогда
				// плановое отправление
				
				Движение 			= Движения.ПозицияКонтейнеровПлан.ДобавитьРасход();
				Движение.Контейнер	= Ответ.ТЕ;
				Движение.Локация 	= ПунктОтправления;
				Движение.Период 	= ДатаОтправления;
				Движение.План 		= 1;
				Движение.ТипКТК 	= Ответ.ТипТЕ;
				Движение.Сделка		= Сделка;
				Движение.Груженое	= Ответ.ГруженоеТЕ;
				
			ИначеЕсли ЗначениеЗаполнено(ДатаОтправленияФакт) Тогда
				// фактическое отправление
				
				Движение 			= Движения.ПозицияКонтейнеровФакт.ДобавитьРасход();
				Движение.Контейнер	= Ответ.ТЕ;
				Движение.Локация 	= ПунктОтправления;
				Движение.Период 	= ДатаОтправленияФакт;
				Движение.Факт 		= 1;
				Движение.ТипКТК		= Ответ.ТипТЕ;
				Движение.Сделка		= Сделка;
				Движение.Груженое	= Ответ.ГруженоеТЕ;
				
				// движения по регистрам для стоков только по тем операциям, которые разрешают перемещение в сток
				Если Услуга.ОперацияРазрешаетПеремещениеВСток И ЗначениеЗаполнено(Ответ.ДатаОтправления) Тогда
					Движение = Движения.СтатусыКТК.Добавить();
