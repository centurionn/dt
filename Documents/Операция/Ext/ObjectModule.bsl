				//КонецЕсли;	

			
			Если ЗначениеЗаполнено(ДатаОтправления) И НЕ ЗначениеЗаполнено(ДатаОтправленияФакт) Тогда
				// плановое отправление
				
				Движение 			= Движения.ПозицияВагоновПлан.ДобавитьРасход();
				Движение.Вагон 		= Ответ.ТС;
				Движение.Локация 	= ПунктОтправления;
				Движение.Период 	= ДатаОтправления;
				Движение.План 		= 1;
				Движение.ТипВагона 	= Ответ.ТипТС;
				Движение.Сделка		= Сделка;
				Движение.Груженое	= Ответ.ГруженоеТС;
				
			ИначеЕсли ЗначениеЗаполнено(ДатаОтправленияФакт) Тогда
				// фактическое отправление
				
				Движение 			= Движения.ПозицияВагоновФакт.ДобавитьРасход();
				Движение.Вагон 		= Ответ.ТС;
