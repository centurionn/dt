		               |	И ОперацияГрузы.ТипТС <> ЗНАЧЕНИЕ(Справочник.ТипоразмерыТС.ПустаяСсылка)
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ОперацияГрузы.ТСГУИД";
		Ответ = Запрос.Выполнить().Выбрать();
		Пока Ответ.Следующий() Цикл
			
				// трекинг транспорта
				Если ЗначениеЗаполнено(Ответ.ТС) И ЗначениеЗаполнено(ДатаОтправленияФакт) Тогда
					МЗ = РегистрыСведений.ТректингТранспорта.СоздатьМенеджерЗаписи();
					МЗ.Период = ДатаОтправленияФакт;
