				Движение.Сделка		= Сделка;
				Движение.Груженое	= Ответ.ГруженоеТС;
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДатаНазначения) И НЕ ЗначениеЗаполнено(ДатаНазначенияФакт) Тогда
				// плановое прибытие
				
				Движение 			= Движения.ПозицияВагоновПлан.ДобавитьПриход();
				Движение.Вагон 		= Ответ.ТС;
				Движение.Локация 	= ПунктНазначения;
				Движение.Период 	= ДатаНазначения;
				Движение.План 		= 1;
				Движение.ТипВагона 	= Ответ.ТипТС;
				Движение.Сделка		= Сделка;
				Движение.Груженое	= Ответ.ГруженоеТС;
				
			ИначеЕсли ЗначениеЗаполнено(ДатаНазначенияФакт) Тогда
				// фактическое прибытие
				
				Движение 			= Движения.ПозицияВагоновФакт.ДобавитьПриход();
				Движение.Вагон 		= Ответ.ТС;
				Движение.Локация 	= ПунктНазначения;
				Движение.Период 	= ДатаНазначенияФакт;
				Движение.Факт 		= 1;
				Движение.ТипВагона 	= Ответ.ТипТС;
				Движение.Сделка		= Сделка;
				Движение.Груженое	= Ответ.ГруженоеТС;
				
			КонецЕсли;
			
		КонецЦикла;
		
		//// проверка, разрешает ли операция перемещение в сток
