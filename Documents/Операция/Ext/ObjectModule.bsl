		Движение.ТипВагона = стр.ТипВагона;
		Движение.Факт = ?(стр.Остаток > 0, стр.Остаток, -стр.Остаток);
		Движение.Период = стр.ПериодЪ;
		
	КонецЦикла;
	
	
	////////////////////////////////////////////////////////////////////
	
	МассивУЕ = Новый Массив;
	Для каждого Стр из Грузы Цикл
		Если ЗначениеЗаполнено(Стр.ТС) И МассивУЕ.Найти(Стр.ТС) = неопределено Тогда МассивУЕ.Добавить(Стр.ТС); КонецЕсли;
		Если ЗначениеЗаполнено(Стр.ТЕ) И МассивУЕ.Найти(Стр.ТЕ) = неопределено Тогда МассивУЕ.Добавить(Стр.ТЕ); КонецЕсли;
	КонецЦикла;
		
	// 1. Пытаемся закрыть открытые треки, если они есть
	Если ЗначениеЗаполнено(ДатаНазначенияФакт) И ПланФакт = Перечисления.ПланФактСчет.Факт И Услуга.ОперацияФормируетНесписываемуюМаржинальность Тогда
		
		Запрос = Новый запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	НесписываемаяМаржинальностьОстатки.УчастокНакопленияМаржинальности КАК УчастокНакопленияМаржинальности,
		               |	НесписываемаяМаржинальностьОстатки.УчетнаяЕдиница КАК УчетнаяЕдиница,
		               |	НесписываемаяМаржинальностьОстатки.КлючОперация КАК КлючОперация,
		               |	НесписываемаяМаржинальностьОстатки.СуммаМаржинальностиОстаток КАК СуммаМаржинальностиОстаток,
		               |	НесписываемаяМаржинальностьОстатки.ТрекЗакрытОстаток КАК ТрекЗакрытОстаток,
		               |	НесписываемаяМаржинальностьОстатки.СоставляющаяСделки КАК СоставляющаяСделки
		               |ИЗ
		               |	РегистрНакопления.НесписываемаяМаржинальность.Остатки(&Период, УчетнаяЕдиница В (&СписокУЕ)) КАК НесписываемаяМаржинальностьОстатки
		               |ГДЕ
		               |	НесписываемаяМаржинальностьОстатки.УчастокНакопленияМаржинальности.ТочкаПодсчетаИтогаНакопления = &ТочкаПодсчетаИтогаНакопления
		               |	И НесписываемаяМаржинальностьОстатки.ТрекЗакрытОстаток = 0";
		Запрос.УстановитьПараметр("ТочкаПодсчетаИтогаНакопления", ПунктНазначения);
		Запрос.УстановитьПараметр("СписокУЕ", МассивУЕ);
		Запрос.УстановитьПараметр("Период", ДатаНазначенияФакт-1);
		Ответ = Запрос.Выполнить().Выбрать();
		Пока Ответ.Следующий() Цикл
			Движение = Движения.НесписываемаяМаржинальность.ДобавитьПриход();
			Движение.КлючОперация = Ответ.КлючОперация;
			Движение.Период = ДатаНазначенияФакт;
			Движение.Регистратор = Ссылка;
			Движение.СоставляющаяСделки = Ответ.СоставляющаяСделки;
			Движение.ТрекЗакрыт = 1;
			Движение.УчастокНакопленияМаржинальности = Ответ.УчастокНакопленияМаржинальности;
			Движение.УчетнаяЕдиница = Ответ.УчетнаяЕдиница;
		КонецЦикла;
		
	КонецЕсли;
	
	// 2. открываем новые треки, если с текущей точки начинаются новые треки
	Если ЗначениеЗаполнено(ДатаОтправленияФакт) И ПланФакт = Перечисления.ПланФактСчет.Факт И Услуга.ОперацияФормируетНесписываемуюМаржинальность Тогда
		
		МаржинальностьНаКТК = 2;
		МаржинальностьНаВагон = 1;
		
		Запрос = Новый запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	УчасткиНакопленияМаржинальности.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.УчасткиНакопленияМаржинальности КАК УчасткиНакопленияМаржинальности
		               |ГДЕ
		               |	НЕ УчасткиНакопленияМаржинальности.ПометкаУдаления
		               |	И УчасткиНакопленияМаржинальности.ТочкаНачалаНакопления = &ТочкаНачалаНакопления";
		Запрос.УстановитьПараметр("ТочкаНачалаНакопления", ПунктОтправления);
		Участки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		
		Для каждого Участок из Участки Цикл
			Для каждого УЕ из МассивУЕ Цикл
				
				Движение = Движения.НесписываемаяМаржинальность.ДобавитьПриход();
				Движение.КлючОперация = Ссылка;
				Движение.Период = ДатаОтправленияФакт;
				Движение.Регистратор = Ссылка;
				Движение.СуммаМаржинальности = ?( ТипЗнч(УЕ) = Тип("СправочникСсылка.ТС"), ПолучитьМаржинальностьНаВагон(Сделка, УЕ), ПолучитьМаржинальностьНаКонтейнер(Сделка, УЕ) );
				Движение.УчастокНакопленияМаржинальности = Участок;
				Движение.УчетнаяЕдиница = УЕ;
				Движение.СоставляющаяСделки = Сделка;
				
			КонецЦикла;
		КонецЦикла;
		
		
	КонецЕсли;	
	
	// 3. к пункту 3 дорисовываем дополнительную маржинальность, полученную от продолжения движения состава по маршрутам через другие сделки
	Если ЗначениеЗаполнено(ДатаНазначенияФакт) И ПланФакт = Перечисления.ПланФактСчет.Факт И Услуга.ОперацияФормируетНесписываемуюМаржинальность Тогда
		
		МаржинальностьНаКТК = 2;
		МаржинальностьНаВагон = 1;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	НесписываемаяМаржинальностьОстатки.УчастокНакопленияМаржинальности КАК УчастокНакопленияМаржинальности,
		               |	НесписываемаяМаржинальностьОстатки.УчетнаяЕдиница КАК УчетнаяЕдиница,
		               |	НесписываемаяМаржинальностьОстатки.КлючОперация КАК КлючОперация,
		               |	НесписываемаяМаржинальностьОстатки.СоставляющаяСделки КАК СоставляющаяСделки,
		               |	НесписываемаяМаржинальностьОстатки.СуммаМаржинальностиОстаток КАК СуммаМаржинальностиОстаток,
		               |	НесписываемаяМаржинальностьОстатки.ТрекЗакрытОстаток КАК ТрекЗакрытОстаток
		               |ИЗ
		               |	РегистрНакопления.НесписываемаяМаржинальность.Остатки(&Период, УчетнаяЕдиница В (&СписокУЕ)) КАК НесписываемаяМаржинальностьОстатки
		               |ГДЕ
		               |	НесписываемаяМаржинальностьОстатки.ТрекЗакрытОстаток = 0
		               |	И НесписываемаяМаржинальностьОстатки.УчастокНакопленияМаржинальности.ТочкаНачалаНакопления <> &ТочкаНачалаНакопления";
		Запрос.УстановитьПараметр("СписокУЕ", МассивУЕ);
		Запрос.УстановитьПараметр("Период", ДатаНазначенияФакт-1);
		Запрос.УстановитьПараметр("ТочкаНачалаНакопления", ПунктОтправления);
		Ответ = Запрос.Выполнить().Выбрать();
		ТекСделкаНайдена = Ложь;
		СписокУчастков = Новый Массив;
		Пока Ответ.Следующий() Цикл
			Если Ответ.СоставляющаяСделки = Сделка Тогда ТекСделкаНайдена = Истина; КонецЕсли;
			СписокУчастков.Добавить(Ответ.УчастокНакопленияМаржинальности);
		КонецЦикла;
		Если НЕ ТекСделкаНайдена Тогда
			Для каждого УЕ из МассивУЕ Цикл
				Для каждого УНМ из СписокУчастков Цикл
					Движение = Движения.НесписываемаяМаржинальность.ДобавитьПриход();
					Движение.КлючОперация = Ссылка;
					Движение.Период = ДатаНазначенияФакт;
					Движение.Регистратор = Ссылка;
					Движение.СоставляющаяСделки = Сделка;
					Движение.СуммаМаржинальности = ?( ТипЗнч(УЕ) = Тип("СправочникСсылка.ТС"), ПолучитьМаржинальностьНаВагон(Сделка, УЕ), ПолучитьМаржинальностьНаКонтейнер(Сделка, УЕ) );
					Движение.УчастокНакопленияМаржинальности = УНМ;
					Движение.УчетнаяЕдиница = УЕ;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПланФакт = Перечисления.ПланФактСчет.Факт И Услуга.ОперацияДвижетсяПоСлежениюРЖД И НЕ ЗначениеЗаполнено(ДатаНазначенияФакт) Тогда
		Движение = Движения.ОперацииДляДвиженияПоСлежению.Добавить();
		Движение.ДатаНачала = ?(ЗначениеЗаполнено(ДатаОтправленияФакт), ДатаОтправленияФакт, ДатаОтправления);
		Движение.ДатаОкончания = ДатаНазначения;
		Движение.Операция = Ссылка;
		Движение.ВидДвиженияПоСлежению = Перечисления.ВидыДвиженийПоОперациямСлежения.ПрохождениеСтанции;
		Движение.ОперацияНачата = ЗначениеЗаполнено(ДатаОтправленияФакт);
		Движение.Регистратор = Ссылка;
		Движение.СписокТЕ = СписокТЕ;
		Движение.СписокТС = СписокТС;
	КонецЕсли;
	
	
	// ОперацииДляДвиженияПоСлежению
	Для Каждого Стр Из Грузы Цикл
		Если ПланФакт = Перечисления.ПланФактСчет.Факт И НЕ ЗначениеЗаполнено(Стр.ДатаПрибытия) И
			ЗначениеЗаполнено(Стр.ТС) И
			(Услуга.КомплекснаяУслугаПоТерминaльнойОбработке
				ИЛИ (Услуга.ПодсылПорожнегоВагона И НЕ Стр.ГруженоеТС)
				ИЛИ (Услуга.ПеревозкаПорожнихВагоновПодПогрузку И НЕ Стр.ГруженоеТС)) Тогда
		
			Если Услуга.КомплекснаяУслугаПоТерминaльнойОбработке Тогда	
				ВидДвиж = Перечисления.ВидыДвиженийПоОперациямСлежения.Погрузка;	
			ИначеЕсли Услуга.ПодсылПорожнегоВагона	Тогда
				ВидДвиж = Перечисления.ВидыДвиженийПоОперациямСлежения.Подсыл;	
			ИначеЕсли Услуга.ПеревозкаПорожнихВагоновПодПогрузку Тогда	
				ВидДвиж = Перечисления.ВидыДвиженийПоОперациямСлежения.Порожний;	
			КонецЕсли;	

			Движение = Движения.ОперацииДляДвиженияПоСлежению.Добавить();
			Движение.ДатаНачала = Стр.ДатаОтправления;
			Движение.Операция = Ссылка;
			Движение.ВидДвиженияПоСлежению = ВидДвиж;
			Движение.ОперацияНачата = ЗначениеЗаполнено(Стр.ДатаОтправления);
			Движение.Регистратор = Ссылка;
			Движение.СписокТЕ = СписокТЕ;
			Движение.СписокТС = СписокТС;
			Движение.Вагон = Стр.ТС;
		КонецЕсли;
		
	КонецЦикла; // ОперацииДляДвиженияПоСлежению
	
	
	Движение = Движения.ОперацииВСделках.Добавить();
	Движение.Операция = Ссылка;
	Движение.Сделка = Сделка;
	Движение.ДатаОтправления = ДатаОтправления;
	Движение.ДатаНазначения = ДатаНазначения;
	Движение.ДатаОтправленияФакт = ДатаОтправленияФакт;
	Движение.ДатаНазначенияФакт = ДатаНазначенияФакт;
	Если ЗначениеЗаполнено(ДатаОтправленияФакт) Тогда
		Движение.ПланФакт = Перечисления.ПланФактСчет.Факт;
	Иначе
		Движение.ПланФакт = Перечисления.ПланФактСчет.План;
	КонецЕсли;
	ТекущийИсполнитель_Статус = Перечисления.СтатусыЭтапов.Новый;
	ТекущийНаблюдатель = неопределено;
	Для каждого Стр из Состояния Цикл
		Если Стр.Состояние = ТекущееСостояние Тогда
			ТекущийИсполнитель_Статус = Стр.Статус;
			ТекущийИсполнитель_Исполнитель = Стр.Исполнитель;
			Движение.Состояние = Стр.Состояние;
			ТекущийНаблюдатель = Стр.Наблюдатель;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Движение.Статус = ТекущийИсполнитель_Статус;
	Движение.Исполнитель = ТекущийИсполнитель_Исполнитель;
	Движение.Наблюдатель = ТекущийНаблюдатель;
	Движение.Себестоимость = Себестоимость;
	// переписать заполнение!!! фактическая себестоимость = ПТУ-РТУ
	Движение.СебестоимостьФакт = Себестоимость;

	
	///////////////////////////////////////////////////////////////////////
	// блок маршрутизации
	
	// проверка наличия присоединенных документов
	// установить "момент времени" для проверки документа.
	// создаем массив, т.к. операция может заполняться не последовательно, а сразу несколько дат,
	// можем потерять какие-то события
	МассивМоментовВремени = Новый Массив;
	
	Если ЗначениеЗаполнено(ДатаОтправления) ИЛИ
		ЗначениеЗаполнено(ДатаОтправленияФакт) Тогда
		МассивМоментовВремени.Добавить(Перечисления.ТипМоментаВремени.ДоНачалаОперации);
		МассивМоментовВремени.Добавить(Перечисления.ТипМоментаВремени.ПослеНачалаОперации);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаНазначенияФакт) ИЛИ
		ЗначениеЗаполнено(ДатаНазначения) Тогда
		МассивМоментовВремени.Добавить(Перечисления.ТипМоментаВремени.ПослеОкончанияОперации);
		МассивМоментовВремени.Добавить(Перечисления.ТипМоментаВремени.ДоОкончанияОперации);
	КонецЕсли;
		
	// необходимо удалить из РС оперативные задачи все данные по ранее внесенным документам
	ТаблицаВыполненныхЗадач = Новый ТаблицаЗначений;
	ТаблицаВыполненныхЗадач.Колонки.Добавить("ВидДокумента",Новый ОписаниеТипов("СправочникСсылка.ВидДокумента"));
	ТаблицаВыполненныхЗадач.Колонки.Добавить("ДатаВыполнения",Новый ОписаниеТипов("Дата"));
	ТаблицаВыполненныхЗадач.Колонки.Добавить("Учтено",Новый ОписаниеТипов("Булево"));
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОперативныеЗадачи.Исполнитель КАК Исполнитель,
		|	ОперативныеЗадачи.Задача КАК Задача,
		|	ОперативныеЗадачи.Документ КАК Документ,
		|	ОперативныеЗадачи.Наблюдатель КАК Наблюдатель,
		|	ОперативныеЗадачи.ВидДокумента КАК ВидДокумента,
		|	ОперативныеЗадачи.Вагон КАК Вагон,
		|	ОперативныеЗадачи.Контейнер КАК Контейнер,
		|	ОперативныеЗадачи.ДокументОснование КАК ДокументОснование,
		|	ОперативныеЗадачи.Статус КАК Статус,
		|	ОперативныеЗадачи.ДатаВыполнения КАК ДатаВыполнения
		|ИЗ
		|	РегистрСведений.ОперативныеЗадачи КАК ОперативныеЗадачи
		|ГДЕ
		|	ОперативныеЗадачи.ДокументОснование = &ДокументОснование
		|	И ОперативныеЗадачи.ОбластьПрименения = ЗНАЧЕНИЕ(Перечисление.ОбластьПрименения.Документы)";
	Запрос.УстановитьПараметр("ДокументОснование",Ссылка);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		Если Ответ.Статус = Перечисления.СтатусыЭтапов.Выполнен Тогда
			НовСтр = ТаблицаВыполненныхЗадач.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр,Ответ,"ВидДокумента,ДатаВыполнения");
			НовСтр.Учтено = Ложь;
		КонецЕсли;
		МЗ = РегистрыСведений.ОперативныеЗадачи.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МЗ, Ответ);
		МЗ.Удалить();
	КонецЦикла;
	
	// считаем количество прикрепленных файлов нужного типа для данной операции
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВидыОперацийТребуемыеДокументы.ВидДокумента КАК ВидДокумента,
	               |	ВидыОперацийТребуемыеДокументы.ЖелтыйПорог КАК ЖелтыйПорог,
	               |	ВидыОперацийТребуемыеДокументы.КрасныйПорог КАК КрасныйПорог,
	               |	ВидыОперацийТребуемыеДокументы.МоментВремени КАК МоментВремени,
	               |	ВидыОперацийТребуемыеДокументы.НаименованиеЗадачиСпециалисту КАК НаименованиеЗадачиСпециалисту,
	               |	ВидыОперацийДополнительныеУсловия.ДопУсловиеНаименование КАК ДопУсловиеНаименование,
	               |	ВидыОперацийДополнительныеУсловия.ДопУсловиеНаименование.ТипДополнительногоУсловия КАК ТипДополнительногоУсловия,
	               |	ВидыОперацийТребуемыеДокументы.ГУИД КАК ГУИД,
	               |	ВидыОперацийТребуемыеДокументы.ВидОперации КАК ВидОперации,
	               |	ВидыОперацийТребуемыеДокументы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ВидыОперацийТребуемыеДокументы.УчитыватьДляВсейОперации КАК УчитыватьДляВсейОперации,
	               |	ВидыОперацийТребуемыеДокументы.ПорядокТребованияДокументов КАК ПорядокТребованияДокументов
	               |ПОМЕСТИТЬ ДокументыКОформлению
	               |ИЗ
	               |	Справочник.ВидыОпераций.ТребуемыеДокументы КАК ВидыОперацийТребуемыеДокументы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыОпераций.ДополнительныеУсловия КАК ВидыОперацийДополнительныеУсловия
	               |		ПО ВидыОперацийТребуемыеДокументы.ГУИД = ВидыОперацийДополнительныеУсловия.ГУИДТребуемыеДокументы
	               |ГДЕ
	               |	ВидыОперацийТребуемыеДокументы.Ссылка = &Ссылка
	               |	И (ВидыОперацийТребуемыеДокументы.МоментВремени В (&МоментВремени)
	               |				И ВидыОперацийТребуемыеДокументы.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.ПустаяСсылка)
	               |			ИЛИ НЕ ВидыОперацийТребуемыеДокументы.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.ПустаяСсылка)
	               |			ИЛИ ВидыОперацийТребуемыеДокументы.МоментВремени = ЗНАЧЕНИЕ(Перечисление.ТипМоментаВремени.ДоНачалаПредыдущейОперации))
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Файлы.Ссылка) КАК КоличествоФайлов,
	               |	Файлы.ВидДокумента КАК ВидДокумента
	               |ПОМЕСТИТЬ ИмеющиесяФайлы
	               |ИЗ
	               |	ДокументыКОформлению КАК ДокументыКОформлению
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Файлы КАК Файлы
	               |		ПО ДокументыКОформлению.ВидДокумента = Файлы.ВидДокумента
	               |			И (Файлы.ВладелецФайла = &ВладелецФайла)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Файлы.ВидДокумента
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДокументыКОформлению.ВидДокумента КАК ВидДокумента,
	               |	ДокументыКОформлению.ЖелтыйПорог КАК ЖелтыйПорог,
	               |	ДокументыКОформлению.КрасныйПорог КАК КрасныйПорог,
	               |	ДокументыКОформлению.МоментВремени КАК МоментВремени,
	               |	ДокументыКОформлению.НаименованиеЗадачиСпециалисту КАК НаименованиеЗадачиСпециалисту,
	               |	ДокументыКОформлению.ДопУсловиеНаименование КАК ДопУсловиеНаименование,
	               |	ДокументыКОформлению.ТипДополнительногоУсловия КАК ТипДополнительногоУсловия,
	               |	ДокументыКОформлению.ГУИД КАК ГУИД,
	               |	ДокументыКОформлению.ВидОперации КАК ВидОперации,
	               |	ДокументыКОформлению.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ДокументыКОформлению.УчитыватьДляВсейОперации КАК УчитыватьДляВсейОперации,
	               |	ДокументыКОформлению.ПорядокТребованияДокументов КАК ПорядокТребованияДокументов,
	               |	ИмеющиесяФайлы.КоличествоФайлов КАК КоличествоФайлов
	               |ИЗ
	               |	ДокументыКОформлению КАК ДокументыКОформлению
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ИмеющиесяФайлы КАК ИмеющиесяФайлы
	               |		ПО ДокументыКОформлению.ВидДокумента = ИмеющиесяФайлы.ВидДокумента
	               |ИТОГИ ПО
	               |	УчитыватьДляВсейОперации,
	               |	ГУИД";
	Запрос.УстановитьПараметр("ВладелецФайла", Ссылка);
	Запрос.УстановитьПараметр("МоментВремени", МассивМоментовВремени);
	Запрос.УстановитьПараметр("Ссылка", Ссылка.Услуга);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаУчитыватьДляВсейОперации = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаУчитыватьДляВсейОперации.Следующий() Цикл
			ВыборкаГУИД = ВыборкаУчитыватьДляВсейОперации.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
			РаботаСМаршрутизациейДокументов.РазборДополнительныхУсловий(ВыборкаГУИД,Ссылка,МассивМоментовВремени,"ТребуемыеДокументы",Неопределено,Ссылка,Неопределено,ТаблицаВыполненныхЗадач);
		КонецЦикла;
	КонецЕсли;
	
	
	// запрос по задачам
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыОперацийПостановкаЗадач.ТипОбъектаСистемы КАК ТипОбъектаСистемы,
		|	ВидыОперацийПостановкаЗадач.ЖелтыйПорог КАК ЖелтыйПорог,
		|	ВидыОперацийПостановкаЗадач.КрасныйПорог КАК КрасныйПорог,
		|	ВидыОперацийПостановкаЗадач.МоментВремени КАК МоментВремени,
		|	ВидыОперацийПостановкаЗадач.НаименованиеЗадачиСпециалисту КАК НаименованиеЗадачиСпециалисту,
		|	ВидыОперацийДополнительныеУсловия.ДопУсловиеНаименование КАК ДопУсловиеНаименование,
		|	ВидыОперацийДополнительныеУсловия.ДопУсловиеНаименование.ТипДополнительногоУсловия КАК ТипДополнительногоУсловия,
		|	ВидыОперацийПостановкаЗадач.ГУИД КАК ГУИД,
		|	ВидыОперацийПостановкаЗадач.ВидОперации КАК ВидОперации,
		|	ВидыОперацийПостановкаЗадач.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ВидыОперацийПостановкаЗадач.УчитыватьДляВсейОперации КАК УчитыватьДляВсейОперации
		|ИЗ
		|	Справочник.ВидыОпераций.ПостановкаЗадач КАК ВидыОперацийПостановкаЗадач
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыОпераций.ДополнительныеУсловия КАК ВидыОперацийДополнительныеУсловия
		|		ПО ВидыОперацийПостановкаЗадач.ГУИД = ВидыОперацийДополнительныеУсловия.ГУИДТребуемыеДокументы
		|ГДЕ
		|	ВидыОперацийПостановкаЗадач.Ссылка = &Ссылка
		|	И ВидыОперацийПостановкаЗадач.МоментВремени В(&МоментВремени)
		|	И ВидыОперацийПостановкаЗадач.ТипОбъектаСистемы = ЗНАЧЕНИЕ(Перечисление.ОбъектСистемыДляЗадач.Операция)
		|ИТОГИ ПО
		|	УчитыватьДляВсейОперации,ГУИД";
	
	Запрос.УстановитьПараметр("МоментВремени", МассивМоментовВремени);
	Запрос.УстановитьПараметр("Ссылка", Ссылка.Услуга);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаУчитыватьДляВсейОперации = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаУчитыватьДляВсейОперации.Следующий() Цикл
			ВыборкаГУИД = ВыборкаУчитыватьДляВсейОперации.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			РаботаСМаршрутизациейДокументов.РазборДополнительныхУсловий(ВыборкаГУИД,Ссылка,МассивМоментовВремени,"ПостановкаЗадач",Неопределено,Ссылка,Неопределено,Неопределено);
		КонецЦикла;		
	КонецЕсли;
	////////////////////////////////////////////////////////////////////////// блок маршрутизации
	
		
КонецПроцедуры

Функция ПолучитьМаржинальностьНаВагон(Сделка, Вагон)
	
	Результат = 0;
	
	МассивГУИДДоходов = Новый Массив;
	Для каждого стр из Сделка.ДоходыВагоны Цикл
		Если СтрНайти(стр.Вагон, Строка(Вагон)) <> 0 Тогда МассивГУИДДоходов.Добавить(стр.ГУИД); КонецЕсли;
	КонецЦикла;
	
	Для каждого Стр из сделка.Доходы Цикл
		
		Если МассивГУИДДоходов.Найти(стр.ГУИД) <> неопределено Тогда
			результат = результат + (стр.Вознаграждение);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьМаржинальностьНаКонтейнер(Сделка, Контейнер)
	
	Результат = 0;
	
	МассивГУИДДоходов = Новый Массив;
	Для каждого стр из Сделка.ДоходыКТК Цикл
		Если СтрНайти(стр.КТК, Строка(Контейнер)) <> 0 Тогда МассивГУИДДоходов.Добавить(стр.ГУИД); КонецЕсли;
	КонецЦикла;
	
	Для каждого Стр из сделка.Доходы Цикл
		
		Если МассивГУИДДоходов.Найти(стр.ГУИД) <> неопределено Тогда
			результат = результат + (стр.Вознаграждение);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

