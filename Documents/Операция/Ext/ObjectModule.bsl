					МЗ.ТС = Ответ.ТС;
					МЗ.Местоположение = ПунктОтправления;
					МЗ.Записать();
				КонецЕсли;
				Если ЗначениеЗаполнено(Ответ.ТС) И ЗначениеЗаполнено(ДатаНазначенияФакт) Тогда
					МЗ = РегистрыСведений.ТректингТранспорта.СоздатьМенеджерЗаписи();
					МЗ.Период = ДатаНазначенияФакт;
					МЗ.Операция = Ссылка;
					МЗ.ТС = Ответ.ТС;
					МЗ.Местоположение = ПунктНазначения;
					МЗ.Записать();
				КонецЕсли;
				//Если ЗначениеЗаполнено(Ответ.ТС) И ЗначениеЗаполнено(Ответ.ДатаОтправления) Тогда
				//	Движение = Движения.КалькуляцияРемонтАренда.Добавить();
				//	Движение.Вагон = Ответ.ТС;
