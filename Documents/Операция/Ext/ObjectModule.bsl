			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	ОперацияГрузы.Ссылка КАК Ссылка,
			               |	ОперацияГрузы.ТС КАК ТС
			               |ИЗ
			               |	Документ.Операция.Грузы КАК ОперацияГрузы
			               |ГДЕ
			               |	ОперацияГрузы.Ссылка В(&Операции)
			               |	И ОперацияГрузы.ТС В(&НедостающиеТС)";
			Запрос.УстановитьПараметр("Операции", МассивВсехДочерних);
			Запрос.УстановитьПараметр("НедостающиеТС", МассивНедостающихТС);
			Ответ = Запрос.Выполнить().Выбрать();
			Пока Ответ.Следующий() Цикл
				НСтр = ТаблицаНедостающихТСТЕ.Добавить();
				НСтр.Операция = Ответ.Ссылка;
				НСтр.НедостающееТСТЕ = Ответ.ТС;
			КонецЦикла;
			
			Запрос.Текст = "ВЫБРАТЬ
			               |	ОперацияГрузы.Ссылка КАК Ссылка,
			               |	ОперацияГрузы.ТЕ КАК ТЕ
			               |ИЗ
			               |	Документ.Операция.Грузы КАК ОперацияГрузы
			               |ГДЕ
			               |	ОперацияГрузы.Ссылка В(&Операции)
			               |	И ОперацияГрузы.ТЕ В(&НедостающиеТЕ)";
			Запрос.УстановитьПараметр("Операции", МассивВсехДочерних);
			Запрос.УстановитьПараметр("НедостающиеТЕ", МассивНедостающихТЕ);
			Ответ = Запрос.Выполнить().Выбрать();
			Пока Ответ.Следующий() Цикл
				НСтр = ТаблицаНедостающихТСТЕ.Добавить();
				НСтр.Операция = Ответ.Ссылка;
				НСтр.НедостающееТСТЕ = Ответ.ТЕ;
			КонецЦикла;
			
			/////////////////////////////////////////////////////////////
				
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("Таблица", ТаблицаНедостающихТСТЕ);
			Запрос.Текст = "ВЫБРАТЬ
			               |	Таблица.Операция КАК Операция,
			               |	Таблица.НедостающееТСТЕ КАК ТСТЕ
			               |ПОМЕСТИТЬ Т1
			               |ИЗ
			               |	&Таблица КАК Таблица
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	Т1.Операция КАК Операция,
			               |	Т1.ТСТЕ КАК ТСТЕ
			               |ИЗ
			               |	Т1 КАК Т1
			               |ИТОГИ ПО
			               |	Операция";
			
			РезультатЗапроса = Запрос.Выполнить();
			ВыборкаОперация = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаОперация.Следующий() Цикл
				
				МассивПолучателейПисьма = Новый Массив;
				МассивПолучателейПисьма.Добавить(ВыборкаОперация.Операция.Сделка.Автор);
				
				Для каждого Стр из ВыборкаОперация.Операция.Состояния Цикл
					Если ЗначениеЗаполнено(Стр.Исполнитель) Тогда 
						
						Если ТипЗнч(Стр.Исполнитель) = Тип("СправочникСсылка.Пользователи") Тогда
							
							Если МассивПолучателейПисьма.Найти(Стр.Исполнитель) = неопределено Тогда МассивПолучателейПисьма.Добавить(Стр.Исполнитель); КонецЕсли;
							
						Иначе
							
							СписокПользователей = Пользователи_sd_сервер.ПолучитьПользователейГруппы(Стр.Исполнитель);
							Для каждого Стр8 из СписокПользователей Цикл
								
								Если МассивПолучателейПисьма.Найти(Стр8) = неопределено Тогда МассивПолучателейПисьма.Добавить(Стр8); КонецЕсли;
								
							КонецЦикла;
							
						КонецЕсли;
						
						
					КонецЕсли;
				КонецЦикла;
				
				//Строка
				
				МассивТСТЕ = Новый Массив;
				
				ВыборкаДетальныеЗаписи = ВыборкаОперация.Выбрать();
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					
					Если МассивТСТЕ.Найти(ВыборкаДетальныеЗаписи.ТСТЕ) = неопределено Тогда МассивТСТЕ.Добавить(ВыборкаДетальныеЗаписи.ТСТЕ); КонецЕсли;
					
				КонецЦикла;
				
				ТекстПисьма = "Обратите внимание: по сделке " + Сделка + " из операции " + Ссылка + " были исключены учетные единицы.<br><br>";
				
				ТекстПисьма = ТекстПисьма + "Следующие ТС / ТЕ были исключены: " + СтрСоединить(МассивТСТЕ, ", ") + "<br><br>";
				
				ТекстПисьма = ТекстПисьма + "Операция: " + ВыборкаОперация.Операция + "<br><br>";
				
				Отправить_Письмо_Сервер(МассивПолучателейПисьма, ТекстПисьма);
				
			КонецЦикла;
	
			
			
		КонецЕсли;
		
	КонецЕсли;
	
	////////////////////////////////////////////
	// Алгоритм автоматической отметки начала и окончания операций фактической ТСх.
	Если ПланФакт = Перечисления.ПланФактСчет.Факт Тогда
		
		ОперацииДляИзменения = АвтоматическаяУстановкаДатОпераций.ПроверкаОперацииНаВыполнениеУсловий(ЭтотОбъект);
		
		ЗаписатьДатыОперацийВДокумент(ОперацииДляИзменения);
		
	КонецЕсли;
	
	// найти максимальную дату ТСх по всем операциям в ней и записать в сделку для маршрутизации
	Если ЗначениеЗаполнено(Ссылка) И Ссылка.ДатаНазначения<>ДатаНазначения Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ТехнологическаяСхемаТЧ.Ссылка КАК ТСх
		               |ПОМЕСТИТЬ НужнаяТСх
		               |ИЗ
		               |	Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
		               |ГДЕ
		               |	ТехнологическаяСхемаТЧ.Операция = &Операция
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ТехнологическаяСхемаТЧ.Ссылка КАК Ссылка,
		               |	ТехнологическаяСхемаТЧ.Операция.ДатаНазначения КАК ОперацияДатаНазначения,
		               |	ТехнологическаяСхема.ПредметТСх КАК СделкаВладелец,
		               |	ВЫБОР
		               |		КОГДА ТехнологическаяСхемаТЧ.Операция = &Операция
		               |			ТОГДА 1
		               |		ИНАЧЕ 0
		               |	КОНЕЦ КАК ЭтоТекущаяОперация
		               |ПОМЕСТИТЬ Итоговая
		               |ИЗ
		               |	РегистрСведений.ТехнологическаяСхема КАК ТехнологическаяСхема
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
		               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ НужнаяТСх КАК НужнаяТСх
		               |			ПО (НужнаяТСх.ТСх = ТехнологическаяСхемаТЧ.Ссылка)
		               |		ПО ТехнологическаяСхема.ТСх = ТехнологическаяСхемаТЧ.Ссылка
		               |ГДЕ
		               |	ТехнологическаяСхема.ПредметТСх ССЫЛКА Документ.Сделка
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ ПЕРВЫЕ 1
		               |	Итоговая.Ссылка КАК Ссылка,
		               |	Итоговая.ОперацияДатаНазначения КАК ОперацияДатаНазначения,
		               |	Итоговая.СделкаВладелец КАК СделкаВладелец,
		               |	Итоговая.ЭтоТекущаяОперация КАК ЭтоТекущаяОперация
		               |ИЗ
		               |	Итоговая КАК Итоговая
		               |ГДЕ
		               |	НЕ Итоговая.ОперацияДатаНазначения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ЭтоТекущаяОперация,
		               |	ОперацияДатаНазначения УБЫВ";
		
		Запрос.УстановитьПараметр("Операция",Ссылка);
		Ответ = Запрос.Выполнить().Выбрать();
		// если дата текущей операции больше всех других дат ТСх, то нужно обновить эту дату в сделке
		// ИЛИ если не нашли других операций, то нужно обновить данные согласно текущей
		Если Ответ.Следующий() Тогда
			Если (Ответ.ЭтоТекущаяОперация = 0 И Ответ.ОперацияДатаНазначения<ДатаНазначения) ИЛИ
				Ответ.ЭтоТекущаяОперация = 1 Тогда
					
				ПолучОб = Ответ.СделкаВладелец.ПолучитьОбъект();
				ПолучОб.ДатаПрибытияОтправки = ДатаНазначения;
				ПолучОб.Записать();
				
			// ИЛИ дата текущей раньше была самой большой, а теперь стала меньше и ее нужно заменить на самую позднюю
			ИначеЕсли Ответ.ЭтоТекущаяОперация = 0 И 
				Ответ.ОперацияДатаНазначения>ДатаНазначения И 
				Ответ.СделкаВладелец.ДатаПрибытияОтправки<>Ответ.ОперацияДатаНазначения Тогда
					
				ПолучОб = Ответ.СделкаВладелец.ПолучитьОбъект();
				ПолучОб.ДатаПрибытияОтправки = Ответ.ОперацияДатаНазначения;
				ПолучОб.Записать();
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	ЛичныеЦелиСервер.ОчиститьЗаписиЛичныхЦелей(Ссылка);
	
КонецПроцедуры

Процедура ЗаписатьДатыОперацийВДокумент(ОперацииДляИзменения)

	// получаем запросом сгруппированные операции и изменяем в них данные.
	// если для операции несколько дат отправлений, то берем меньшую.
	// если несколько дат назначений, берем большую.
	// если заполнен номер КТК и даты для него, то проставляем их в ТЧ Грузы
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВремТЧ.Операция КАК Операция,
		|	ВремТЧ.Контейнер КАК Контейнер,
		|	ВремТЧ.ДатаОтправленияФакт КАК ДатаОтправленияФакт,
		|	ВремТЧ.ДатаНазначенияФакт КАК ДатаНазначенияФакт
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ВремТЧ КАК ВремТЧ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Операция КАК Операция,
		|	ВТ.Контейнер КАК Контейнер,
		|	ВТ.ДатаОтправленияФакт КАК ДатаОтправленияФакт,
		|	ВТ.ДатаНазначенияФакт КАК ДатаНазначенияФакт
		|ИЗ
		|	ВТ КАК ВТ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаОтправленияФакт,
		|	ДатаНазначенияФакт УБЫВ
		|ИТОГИ ПО
		|	Операция";
	
	Запрос.УстановитьПараметр("ВремТЧ",ОперацииДляИзменения);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОперация = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаОперация.Следующий() Цикл
		
		// если нужно изменить текущую операцию, то получать объект не нужно, меняем в рамках текущей ссылки
		Если ВыборкаОперация.Операция = Ссылка Тогда
			ПолучОб = ЭтотОбъект;
		Иначе
			ПолучОб = ВыборкаОперация.Операция.ПолучитьОбъект();
		КонецЕсли;
		
		ДатаОтпр = Неопределено;
		ДатаПриб = Неопределено;
		
		ВыборкаДетальныеЗаписи = ВыборкаОперация.Выбрать();
	
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			// записывать нужно только если переменные еще не были заполнены и если номер КТК не заполнен
			Если НЕ ЗначениеЗаполнено(ДатаОтпр) И НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Контейнер) Тогда
				ДатаОтпр = ВыборкаДетальныеЗаписи.ДатаОтправленияФакт;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(ДатаПриб) И НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Контейнер) Тогда
				ДатаПриб = ВыборкаДетальныеЗаписи.ДатаНазначенияФакт;
			КонецЕсли;
			
			// ТЧ грузы заполняем, если заполнен КТК
			Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Контейнер) Тогда
				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("ТЕ",ВыборкаДетальныеЗаписи.Контейнер);
				НайденныйКТК = ПолучОб.Грузы.НайтиСтроки(ПараметрыОтбора);
				Если НайденныйКТК.Количество()>0 Тогда
					Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ДатаОтправленияФакт) Тогда
						НайденныйКТК[0].ДатаОтправления = ВыборкаДетальныеЗаписи.ДатаОтправленияФакт;
					КонецЕсли;
					Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ДатаНазначенияФакт) Тогда
						НайденныйКТК[0].ДатаПрибытия = ВыборкаДетальныеЗаписи.ДатаНазначенияФакт;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		ПолучОб.ДатаОтправленияФакт = ?(ЗначениеЗаполнено(ДатаОтпр),ДатаОтпр,ПолучОб.ДатаОтправленияФакт);
		ПолучОб.ДатаНазначенияФакт = ?(ЗначениеЗаполнено(ДатаПриб),ДатаПриб,ПолучОб.ДатаНазначенияФакт);
		
		// принудительно записываем только ДРУГУЮ операцию, эта запишется сама
		Если НЕ ВыборкаОперация.Операция = Ссылка Тогда
			Попытка
				ПолучОб.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ПолучОб.Записать(РежимЗаписиДокумента.Запись);
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция Отправить_Письмо_Сервер(ПолучателиЗапросаПользователи, ТекстПисьма)
	
	Результат = Ложь;
	
	МассивПолучателейСотрудников_м = Новый Массив;
	МассивПолучателейКонтрагентов_м = Новый Массив;

	Для каждого Стр из ПолучателиЗапросаПользователи Цикл
		Для каждого Стр2 из Стр.КонтактнаяИнформация Цикл
			Если ЗначениеЗаполнено(Стр2.АдресЭП) Тогда
				МассивАдресовЭП = СтрРазделить(Стр2.АдресЭП, ";", Ложь);
				Для каждого ЕМЕЙЛ из МассивАдресовЭП Цикл
					МассивПолучателейСотрудников_м.Добавить(Новый Структура("Представление, Адрес", Строка(Стр), ЕМЕЙЛ));
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// первичная проверка на то, что мы вообще можем что-то отправить
	УчетнаяЗаписьПоУмолчанию = РаботаСПочтовымиСообщениями.ПроверитьСистемнаяУчетнаяЗаписьДоступна();
	
	Если не УчетнаяЗаписьПоУмолчанию Тогда возврат Результат; КонецЕсли;
	СистемнаяУчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	ПараметрыОтправкиПисьма = новый Структура;
	ПараметрыОтправкиПисьма.Вставить("Тема", "В операциях имеются назначенные ТС / ТЕ, которые были исключены из перевозки!");
	ПараметрыОтправкиПисьма.Вставить("Тело", ТекстПисьма);
	ПараметрыОтправкиПисьма.Вставить("ТипТекста", "HTML");
	//ПолучателиПисьма.Добавить(Новый Структура("Представление, Адрес", Строка(Ответ.Пользователь), EMAIL));
	ПараметрыОтправкиПисьма.Вставить("Кому", МассивПолучателейСотрудников_м);
	
	Результат = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(СистемнаяУчетнаяЗапись, ПараметрыОтправкиПисьма);
	Возврат Результат;
		
КонецФункции

Процедура ПриКопировании(ОбъектКопирования)
	
	Автор = Пользователи.ТекущийПользователь();
	Создано = ТекущаяДата();
	Маршрутизировать = Константы.МаршрутизироватьОперации.Получить();
	Редактор = неопределено;
	Изменено = неопределено;
	Состояния.Очистить();
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если НЕ ПроисходитЗаписьОперацииИзТСх Тогда
		
		МассивРеквизитовДляПроверки = Новый Массив;
		МассивРеквизитовДляПроверки.Добавить("Услуга");
		МассивРеквизитовДляПроверки.Добавить("ПунктОтправления");
		МассивРеквизитовДляПроверки.Добавить("ПунктНазначения");
		МассивРеквизитовДляПроверки.Добавить("ДатаОтправления");
		МассивРеквизитовДляПроверки.Добавить("ДатаНазначения");
		МассивРеквизитовДляПроверки.Добавить("ТипДлительности");
		МассивРеквизитовДляПроверки.Добавить("Срок");
		МассивРеквизитовДляПроверки.Добавить("Поставщик");
		МассивРеквизитовДляПроверки.Добавить("Договор");
		МассивРеквизитовДляПроверки.Добавить("Себестоимость");
		МассивРеквизитовДляПроверки.Добавить("Валюта");
		МассивРеквизитовДляПроверки.Добавить("СтавкаНДС");
		МассивРеквизитовДляПроверки.Добавить("ВключаетНДС");
		МассивРеквизитовДляПроверки.Добавить("ДатаОтправленияФакт");
		МассивРеквизитовДляПроверки.Добавить("ДатаНазначенияФакт");
		МассивРеквизитовДляПроверки.Добавить("Регламентный");
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	ТехнологическаяСхемаТЧ.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
		               |ГДЕ
		               |	ТехнологическаяСхемаТЧ.Операция = &Операция";
		Запрос.УстановитьПараметр("Операция", Ссылка);
		Ответ = Запрос.Выполнить().Выбрать();
		Пока Ответ.Следующий() Цикл
			
			ТСхТребуетПерезаписи = Ложь;
			ТСхОбъект = Ответ.Ссылка.ПолучитьОбъект();
			Для каждого Стр из ТСхОбъект.ТЧ Цикл
				Если Стр.Операция <> Ссылка тогда Продолжить; КонецЕсли;
				
				Для каждого ПроверяемыйРеквизит из МассивРеквизитовДляПроверки Цикл
					Если Стр[ПроверяемыйРеквизит] <> ЭтотОбъект[ПроверяемыйРеквизит] Тогда
						Стр[ПроверяемыйРеквизит] = ЭтотОбъект[ПроверяемыйРеквизит];
						ТСхТребуетПерезаписи = Истина;
					КонецЕсли;
				КонецЦикла;
				
			КонецЦикла;
			
			Если ТСхТребуетПерезаписи Тогда
				ТСхОбъект.Записать();
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ОперацияВыполнена Тогда
		ОперацииСервер.ЗапуститьСледующиеОперации(Ссылка);
	КонецЕсли;
	
	
	////////////////////////////////////////////
	// Алгоритм автоматической отметки начала и окончания операций фактической ТСх.
	Если ПланФакт = Перечисления.ПланФактСчет.Факт Тогда
		
		ОперацииДляИзменения = АвтоматическаяУстановкаДатОпераций.ПроверкаСоседнихОперацийНаВыполнениеУсловий(ЭтотОбъект);
		
		ЗаписатьДатыОперацийВДокумент(ОперацииДляИзменения);
		
	КонецЕсли;
	
	ЛичныеЦелиСервер.ДобавитьЗаписиЛичныхЦелей(Ссылка);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.ПозицияВагоновПлан.Записывать = Истина;
	Движения.ПозицияВагоновФакт.Записывать = Истина;
