&НаКлиенте
Процедура ОтменаСогласования(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;  
	
	ПараметрыЗапроса = ПолучитьПараметрыМаршрутизацииНаСервере(Объект);
	РезультатЗапроса = МаршрутизацияСервер.МаршрутизироватьПСЦ(ПараметрыЗапроса, объект.Дата); 
	
	Для Каждого Стр Из РезультатЗапроса Цикл  
		Если Не ЗначениеЗаполнено(Стр.Исполнитель) Тогда
			Продолжить;
		КонецЕсли;
		Отбор = Новый Структура("Состояние", Стр.Состояние);
		НайденныеСтроки = Объект.Состояния.НайтиСтроки(Отбор);
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл 
			НайденнаяСтрока.Исполнитель = Стр.Исполнитель;
		КонецЦикла;
	КонецЦикла;
	
	Оповещение = Новый ОписаниеОповещения("ОтменаСогласованияПродолжение", ЭтаФорма);	
	ОткрытьФорму("ОбщаяФорма.ОтзывСогласования",, ЭтаФорма,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменаСогласованияПродолжение(Комментарий, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Комментарий) Тогда		
		Возврат;
	КонецЕсли;  
	
	ПараметрыЗапроса = ПолучитьПараметрыМаршрутизацииНаСервере(Объект);
	РезультатЗапроса = МаршрутизацияСервер.МаршрутизироватьПСЦПоставщика(ПараметрыЗапроса, объект.Дата); 
	
	Для Каждого Стр Из РезультатЗапроса Цикл  
		
		Если Не ЗначениеЗаполнено(Стр.Исполнитель) Тогда
			Продолжить;
		КонецЕсли;
		
		Отбор = Новый Структура("Состояние", Стр.Состояние);
		НайденныеСтроки = Объект.Состояния.НайтиСтроки(Отбор);
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл 
			НайденнаяСтрока.Исполнитель = Стр.Исполнитель;
		КонецЦикла;
		
	КонецЦикла;
	
	ВозвращаемыеЗадачи = Новый Массив;
	Если Объект.Состояния.Количество() > 0 Тогда
		СтрСостояния = Объект.Состояния[0];
		СтрСостояния.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.ВРаботе");
		СтрСостояния.ВыполнениеЗафиксировано = Ложь;
		ВозвращаемыеЗадачи.Добавить(СтрСостояния.Состояние);
	КонецЕсли;
	
	Для Сч = 1 По Объект.Состояния.Количество()-1 Цикл
		
		Объект.Состояния[Сч].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Новый");
		Если ЗначениеЗаполнено(Объект.Состояния[Сч].СтатусСогласования) Тогда
			Объект.Состояния[Сч].СтатусСогласования = ПредопределенноеЗначение("Перечисление.СтатусыСогласования.Планируется");
			Объект.Состояния[Сч].Комментарий = Комментарий;
		КонецЕсли;
		
		Объект.Состояния[Сч].ВыполнениеЗафиксировано = Ложь;
		ВозвращаемыеЗадачи.Добавить(Объект.Состояния[Сч].Состояние);
		
	КонецЦикла;
	
	Объект.ДатаСогласования=Дата(1,1,1);	
	
	ЗаписатьОтменуСогласования(ВозвращаемыеЗадачи);
	
	ОбновитьПанельТекущегоПользователя();
	ОбновитьПанельСостояний();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьОтменуСогласования(ВозвращаемыеЗадачи)
	
	УстановитьПривилегированныйРежим(Истина);

	ПараметрыЗаписи = Новый Структура("РежимЗаписи, ИзмененыТолькоРазрешенныеПоля", РежимЗаписиДокумента.ОтменаПроведения, Истина);	
	ПараметрыЗаписи.Вставить("ВозвращаемыеЗадачи", ВозвращаемыеЗадачи);
	
	Записать(ПараметрыЗаписи);

	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

