&НаСервереБезКонтекста
Функция ПроверитьНаличиеСверокВПСЦПоставщиков(Ссылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПротоколСНормативнымиСтавкамиНаУслугиПоставщиковКритерииУслуг.КлючАналитикиСтрокиПротокола КАК КлючАналитикиСтрокиПротокола
	|ПОМЕСТИТЬ Ключи
	|ИЗ
	|	Документ.ПротоколСНормативнымиСтавкамиНаУслугиПоставщиков.КритерииУслуг КАК ПротоколСНормативнымиСтавкамиНаУслугиПоставщиковКритерииУслуг
	|ГДЕ
	|	ПротоколСНормативнымиСтавкамиНаУслугиПоставщиковКритерииУслуг.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПСЦПоставщикаКритерииУслуг.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПСЦПоставщика.КритерииУслуг КАК ПСЦПоставщикаКритерииУслуг
	|ГДЕ
	|	ПСЦПоставщикаКритерииУслуг.КлючНормативнойСтавки В
	|			(ВЫБРАТЬ
	|				Ключи.КлючАналитикиСтрокиПротокола КАК КлючАналитикиСтрокиПротокола
	|			ИЗ
	|				Ключи КАК Ключи)
	|	И ПСЦПоставщикаКритерииУслуг.Ссылка.Проведен";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ЗаменитьИсполнителя(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) тогда
		ПоказатьПредупреждение(, "Сначала необходимо сохранить Протокол");
		Возврат;
	КонецЕсли;
	
	ИсходныйПользователь = неопределено;
	Для каждого Стр из Объект.Состояния Цикл
		Если Стр.Состояние = ПредопределенноеЗначение("Справочник.Состояния.ПроверкаРезультатовСогласования") Тогда ИсходныйПользователь = Стр.Исполнитель; КонецЕсли;
	КонецЦикла;
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораЗаменыСогласующего", ЭтаФорма);
	
	ОткрытьФорму("Документ.ПСЦ.Форма.ФормаЗаменыИсполнителяВПротоколе", Новый Структура("ИсходныйПользователь", ИсходныйПользователь),,ЭтаФорма.УникальныйИдентификатор,,, ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораЗаменыСогласующего(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = неопределено Тогда Возврат; КонецЕсли;
	
	ИсхП = П1.ИсходныйПользователь;
	КонП = П1.КонечныйПользователь;
	
	ЗаменятьИсполнителя = П1.ЗаменятьИсполнителя;
	ЗаменятьНаблюдателя = П1.ЗаменятьНаблюдателя;
	
	ЗаменяемыеСтатусы = П1.ЗаменяемыеСтатусы;
	
	Для каждого Стр из Объект.Состояния Цикл
		
		Если ЗаменяемыеСтатусы.Найти(Стр.Статус) <> неопределено Тогда
			Если Стр.Исполнитель = ИсхП И ЗаменятьИсполнителя Тогда Стр.Исполнитель = КонП; КонецЕсли;
			Если Стр.Наблюдатель = ИсхП И ЗаменятьНаблюдателя Тогда Стр.Наблюдатель = КонП; КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ТакжеЗаменитьВКарточкеСогласования(П1, Объект.Ссылка);
	
	ОбновитьПанельСостояний();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ТакжеЗаменитьВКарточкеСогласования(П1, Ссылка)
	
	ТекПроцессСогл = ПечатьБухгалтерскихДокументов.ПроверитьНаличиеПроцесса(Ссылка);
	Если НЕ ЗначениеЗаполнено(ТекПроцессСогл) Тогда Возврат; КонецЕсли;
	
	ПроцессО = ТекПроцессСогл.ПолучитьОбъект();
	
	ИсхП = П1.ИсходныйПользователь;
	КонП = П1.КонечныйПользователь;
	
	ЗаменятьИсполнителя = П1.ЗаменятьИсполнителя;
	ЗаменятьНаблюдателя = П1.ЗаменятьНаблюдателя;
	
	ЗаменяемыеСтатусы = П1.ЗаменяемыеСтатусы;
	
	Для каждого Стр из ПроцессО.Состояния Цикл
		
		Если ЗаменяемыеСтатусы.Найти(Стр.Статус) <> неопределено Тогда
			Если Стр.Исполнитель = ИсхП И ЗаменятьИсполнителя Тогда Стр.Исполнитель = КонП; КонецЕсли;
			Если Стр.Наблюдатель = ИсхП И ЗаменятьНаблюдателя Тогда Стр.Наблюдатель = КонП; КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ПроцессО.Записать();
	
КонецПроцедуры

