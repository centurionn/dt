&НаСервереБезКонтекста
Функция ПолучитьВидыОтправок()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыОтправок.Ссылка КАК Ссылка,
		|	ВидыОтправок.Порядок КАК Порядок
		|ИЗ
		|	Перечисление.ВидыОтправок КАК ВидыОтправок
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок";
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Возврат Таблица.ВыгрузитьКолонку("Ссылка");
	
