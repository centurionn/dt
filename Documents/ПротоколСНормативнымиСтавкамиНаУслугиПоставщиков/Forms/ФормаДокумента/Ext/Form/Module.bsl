&НаКлиенте
Процедура УслугиТипоразмерыВагоновСтрокойНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Модифицированность = Истина;
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	ТекСтрока = Элементы.Услуги.ТекущаяСтрока;
	
	ОписаниеПоля = ПараметрыВидаУслуг.ПоляТаблицыУслуг.Получить("ТипоразмерыВагоновСтрокой");
	Если ОписаниеПоля <> Неопределено И ЗначениеЗаполнено(ОписаниеПоля.СписокВыбора) Тогда
		Типоразмеры = ОписаниеПоля.СписокВыбора.ВыгрузитьЗначения();
		СписокТипоразмеров = Новый СписокЗначений;
		СписокТипоразмеров.ЗагрузитьЗначения(Типоразмеры);
	Иначе
		Типоразмеры = ПолучитьТипоразмерыВагонов();
		СписокТипоразмеров = Новый СписокЗначений;
		СписокТипоразмеров.ЗагрузитьЗначения(Типоразмеры);
	КонецЕсли;
	
	Для Каждого ЭлементСписка Из СписокТипоразмеров Цикл
		ВыбранныйЭлемент = ТекДанные.ТипоразмерыВагонов.НайтиПоЗначению(ЭлементСписка.Значение);
		Если ВыбранныйЭлемент <> Неопределено Тогда
			ЭлементСписка.Пометка = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;	
	ПараметрыФормы.Вставить("ТекущийСписок", СписокТипоразмеров);
	ПараметрыФормы.Вставить("ПоказыватьПометку", Истина);
	ПараметрыФормы.Вставить("ИзменятьСоставСтрок", Ложь);
	
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ИдентификаторСтроки", ТекСтрока);
	
	ОповещениеОЗакрытииФормыСписка = Новый ОписаниеОповещения("ПриЗакрытииФормыРедактированияСпискаТипоразмеровВагонов", ЭтаФорма, ПараметрыОповещения);	
	ОткрытьФорму("ОбщаяФорма.ФормаРедактированияСпискаЗначений", ПараметрыФормы, Этаформа,,,, ОповещениеОЗакрытииФормыСписка, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыРедактированияСпискаТипоразмеровВагонов(СписокТипоразмеров, ДополнительныеПараметры) Экспорт
	
	Если СписокТипоразмеров <> Неопределено Тогда
		
		ТекСтрока = ДополнительныеПараметры.ИдентификаторСтроки;
		ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ТекСтрока);
		ТекДанные.ТипоразмерыВагонов.Очистить();		
		
		Для Каждого ЭлементСписка Из СписокТипоразмеров Цикл
			Если ЭлементСписка.Пометка Тогда
				ТекДанные.ТипоразмерыВагонов.Добавить(ЭлементСписка.Значение);
			КонецЕсли;
		КонецЦикла;
		
		УслугиТипоразмерыВагоновПриИзмененииСервер(ТекСтрока);
	
		Если ЗаполнятьВниз Тогда
			ВыполнитьЗаполнениеВниз();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

