		АдресКэшаНастроекПолейПоУмолчанию = ПоместитьВоВременноеХранилище(НастройкиПолейПоУмолчанию, АдресКэшаНастроекПолейПоУмолчанию);
	Иначе
		АдресКэшаНастроекПолейПоУмолчанию = ПоместитьВоВременноеХранилище(НастройкиПолейПоУмолчанию, Новый УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДинамическиеПоляТаблицыУслугПоСтроке(ТекДанные, ОбновитьПоляТЧКритерии = Ложь)
	
	СтрокиУслуг = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТекДанные);
	ОбновитьДинамическиеПоляТаблицыУслуг(СтрокиУслуг, ОбновитьПоляТЧКритерии);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДинамическиеПоляТаблицыУслуг(СтрокиУслуг = Неопределено, ОбновитьПоляТЧКритерии = Ложь)
	
	ТипоразмерКТКПустаяСсылка = Справочники.ТипоразмерыТЕ.ПустаяСсылка();
	ТипоразмерыТСПустаяСсылка = Справочники.ТипоразмерыТС.ПустаяСсылка(); //Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025
	ВидОтправкиПустаяСсылка = Перечисления.ВидыОтправок.ПустаяСсылка(); //Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025
	
	ТаблицаКритерииУслуг = Объект.КритерииУслуг.Выгрузить();
	ТаблицаКритерииУслуг.Индексы.Добавить("ИдентификаторСтрокиУслуг");
	
	Если СтрокиУслуг <> Неопределено Тогда
		Услуги = СтрокиУслуг;
	Иначе
		Услуги = Объект.Услуги;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Услуги.НомерСтроки КАК НомерСтроки,
	|	Услуги.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	Услуги.ПунктОтправления КАК ПунктОтправления,
	|	Услуги.ПунктНазначения КАК ПунктНазначения
	|ПОМЕСТИТЬ Услуги
	|ИЗ
	|	&Услуги КАК Услуги
	|;
	|
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Услуги.ПунктОтправления КАК Станция,
	|	ВЫБОР
	|		КОГДА МультилокацииЛокации.Локация.ЖелезнаяДорога <> &ДорогаПустаяСсылка
	|			ТОГДА МультилокацииЛокации.Локация.ЖелезнаяДорога.Наименование
	|		ИНАЧЕ МультилокацииЛокации.Локация.ЛокацияВышестоящегоУровня.ЖелезнаяДорога.Наименование
	|	КОНЕЦ КАК ЖелезнаяДорога
	|ИЗ
	|	Услуги КАК Услуги
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Мультилокации.Локации КАК МультилокацииЛокации
	|		ПО Услуги.ПунктОтправления = МультилокацииЛокации.Ссылка
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Услуги.ПунктОтправления,
	|	ВЫБОР
	|		КОГДА Локации.ЖелезнаяДорога <> &ДорогаПустаяСсылка
	|			ТОГДА Локации.ЖелезнаяДорога.Наименование
	|		ИНАЧЕ Локации.ЛокацияВышестоящегоУровня.ЖелезнаяДорога.Наименование
	|	КОНЕЦ
	|ИЗ
	|	Услуги КАК Услуги
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Локации КАК Локации
	|		ПО Услуги.ПунктОтправления = Локации.Ссылка
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Услуги.ПунктНазначения,
	|	ВЫБОР
	|		КОГДА МультилокацииЛокации.Локация.ЖелезнаяДорога <> &ДорогаПустаяСсылка
	|			ТОГДА МультилокацииЛокации.Локация.ЖелезнаяДорога.Наименование
	|		ИНАЧЕ МультилокацииЛокации.Локация.ЛокацияВышестоящегоУровня.ЖелезнаяДорога.Наименование
	|	КОНЕЦ
	|ИЗ
	|	Услуги КАК Услуги
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Мультилокации.Локации КАК МультилокацииЛокации
	|		ПО Услуги.ПунктНазначения = МультилокацииЛокации.Ссылка
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Услуги.ПунктНазначения,
	|	ВЫБОР
	|		КОГДА Локации.ЖелезнаяДорога <> &ДорогаПустаяСсылка
	|			ТОГДА Локации.ЖелезнаяДорога.Наименование
	|		ИНАЧЕ Локации.ЛокацияВышестоящегоУровня.ЖелезнаяДорога.Наименование
	|	КОНЕЦ
	|ИЗ
	|	Услуги КАК Услуги
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Локации КАК Локации
	|		ПО Услуги.ПунктНазначения = Локации.Ссылка";
	
	ПоляТаблицыУслуг = "НомерСтроки, ИдентификаторСтрокиУслуг, ПунктОтправления, ПунктНазначения";
	Запрос.УстановитьПараметр("Услуги", Объект.Услуги.Выгрузить(СтрокиУслуг, ПоляТаблицыУслуг));
	
	Запрос.УстановитьПараметр("ДорогаПустаяСсылка", Справочники.ЖелезныеДороги.ПустаяСсылка());
	
	Результаты = Запрос.ВыполнитьПакет();
	КоличествоРезультатов = Результаты.Количество();	
	ТаблицаДорог = Результаты[КоличествоРезультатов - 1].Выгрузить();
	
	Для Каждого СтрокаУслуги Из Услуги Цикл
		
		КритерииПоУслуге = Новый Массив;
		// Евросиб US 98207 TA 100593 Рыбьяков К.А. 19.03.2025 ((
		Продукты = Новый Массив;
		// Евросиб Рыбьяков К.А. 19.03.2025 ))
		УчетныеНаправления = Новый Массив;
		СтрокиТаблицыКритериев = ТаблицаКритерииУслуг.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", СтрокаУслуги.ИдентификаторСтрокиУслуг));
		//Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025
		
		ТаблицаКритериевПоСтрокеУслуги = ТаблицаКритерииУслуг.Скопировать(Новый Структура("ИдентификаторСтрокиУслуг", СтрокаУслуги.ИдентификаторСтрокиУслуг));
		
		Если ОбновитьПоляТЧКритерии Тогда
			
			ВидыОтправок = ТаблицаКритериевПоСтрокеУслуги.ВыгрузитьКолонку("ВидОтправки");
			ВидыОтправок = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ВидыОтправок);
			ОбщегоНазначенияКлиентСервер.УдалитьВсеВхожденияЗначенияИзМассива(ВидыОтправок, ВидОтправкиПустаяСсылка);
			СтрокаУслуги.ВидыОтправок.ЗагрузитьЗначения(ВидыОтправок);
			СтрокаУслуги.ВидыОтправокСтрокой = СтрСоединить(ВидыОтправок, "; ");
			
			ТипоразмерыКТК = ТаблицаКритериевПоСтрокеУслуги.ВыгрузитьКолонку("ТипоразмерКТК");
			ТипоразмерыКТК = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ТипоразмерыКТК);
			ОбщегоНазначенияКлиентСервер.УдалитьВсеВхожденияЗначенияИзМассива(ТипоразмерыКТК, ТипоразмерКТКПустаяСсылка);
			СтрокаУслуги.ТипоразмерыКТК.ЗагрузитьЗначения(ТипоразмерыКТК);
			СтрокаУслуги.ТипоразмерыКТКСтрокой = СтрСоединить(ТипоразмерыКТК, "; ");
			
			ТаблицаТипоразмерыВагонов = ТаблицаКритериевПоСтрокеУслуги.Скопировать(, "ТипоразмерВагона");
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТЗТипорамерыТС.ТипоразмерВагона КАК ТипоразмерВагона
			|ПОМЕСТИТЬ ВТ_ТипоразмерыВагонов
			|ИЗ
			|	&ТЗТипорамерыТС КАК ТЗТипорамерыТС
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_ТипоразмерыВагонов.ТипоразмерВагона КАК ТипоразмерВагона,
			|	ТипоразмерыТС.Код КАК ТипоразмерВагонаКод
			|ИЗ
			|	ВТ_ТипоразмерыВагонов КАК ВТ_ТипоразмерыВагонов
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТипоразмерыТС КАК ТипоразмерыТС
			|		ПО ВТ_ТипоразмерыВагонов.ТипоразмерВагона = ТипоразмерыТС.Ссылка";
			
			Запрос.УстановитьПараметр("ТЗТипорамерыТС",ТаблицаТипоразмерыВагонов);
			ТаблицаТипоразмерыВагонов = Запрос.Выполнить().Выгрузить();		
			
			ТаблицаТипоразмерыВагонов.Свернуть("ТипоразмерВагона,ТипоразмерВагонаКод");
			ПустыеСтроки = ТаблицаТипоразмерыВагонов.НайтиСтроки(Новый Структура("ТипоразмерВагона", ТипоразмерыТСПустаяСсылка));
			Для Каждого Стр Из ПустыеСтроки Цикл
				ТаблицаТипоразмерыВагонов.Удалить(Стр);
			КонецЦикла;
			ТаблицаТипоразмерыВагонов.Сортировать("ТипоразмерВагонаКод");
			ТипоразмерыВагонов = ТаблицаТипоразмерыВагонов.ВыгрузитьКолонку("ТипоразмерВагона");
			СтрокаУслуги.ТипоразмерыВагонов.ЗагрузитьЗначения(ТипоразмерыВагонов);
			СтрокаУслуги.ТипоразмерыВагоновСтрокой = СтрСоединить(ТаблицаТипоразмерыВагонов.ВыгрузитьКолонку("ТипоразмерВагонаКод"), "; ");
			Если ТипоразмерыВагонов.Количество() = 1 Тогда
				СтрокаУслуги.ТипоразмерВагона = ТипоразмерыВагонов[0];
			Иначе
				СтрокаУслуги.ТипоразмерВагона = ТипоразмерыТСПустаяСсылка;
			КонецЕсли;
		КонецЕсли;
		//Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025
		Для Каждого СтрокаТаблицыКритериев Из СтрокиТаблицыКритериев Цикл
			
			Если ОбновитьПоляТЧКритерии Тогда
				
				Если СтрокаТаблицыКритериев.РазмерКТК = "20" Тогда
					СтрокаУслуги.ТипоразмерКТК20 = СтрокаТаблицыКритериев.ТипоразмерКТК;
					СтрокаУслуги.СтоимостьБезНДС_КТК20 = СтрокаТаблицыКритериев.СтоимостьБезНДС;
					СтрокаУслуги.СтоимостьСНДС_КТК20 = СтрокаТаблицыКритериев.СтоимостьСНДС;
					//Евросиб Шевченко А.В. US 100317 TA 126448 22.12.2025
					СтрокаУслуги.СтавкаЗаКМ20FutБезНДС = СтрокаТаблицыКритериев.СтавкаЗаКМ20FutБезНДС;
					//Евросиб Шевченко А.В. US 100317 TA 126448 22.12.2025
				ИначеЕсли СтрокаТаблицыКритериев.РазмерКТК = "40" Тогда
					СтрокаУслуги.ТипоразмерКТК40 = СтрокаТаблицыКритериев.ТипоразмерКТК;
					СтрокаУслуги.СтоимостьБезНДС_КТК40 = СтрокаТаблицыКритериев.СтоимостьБезНДС;
					СтрокаУслуги.СтоимостьСНДС_КТК40 = СтрокаТаблицыКритериев.СтоимостьСНДС;
					//Евросиб Шевченко А.В. US 100317 TA 126448 22.12.2025
					СтрокаУслуги.СтавкаЗаКМ40FutБезНДС = СтрокаТаблицыКритериев.СтавкаЗаКМ40FutБезНДС;
					//Евросиб Шевченко А.В. US 100317 TA 126448 22.12.2025
				Иначе
					СтрокаУслуги.ТипоразмерКТК20 = ТипоразмерКТКПустаяСсылка;
					СтрокаУслуги.ТипоразмерКТК40 = ТипоразмерКТКПустаяСсылка;
					СтрокаУслуги.СтоимостьБезНДС = СтрокаТаблицыКритериев.СтоимостьБезНДС;
					СтрокаУслуги.СтоимостьСНДС = СтрокаТаблицыКритериев.СтоимостьСНДС;
					СтрокаУслуги.СтоимостьЗаСуткиБезНДС = СтрокаТаблицыКритериев.СтоимостьЗаСуткиБезНДС;
					//Евросиб Шевченко А.В. US 100317 TA 126448 22.12.2025
					СтрокаУслуги.СтавкаЗаКМ40FutБезНДС = СтрокаТаблицыКритериев.СтавкаЗаКМ40FutБезНДС;
					СтрокаУслуги.СтавкаЗаКМ20FutБезНДС = СтрокаТаблицыКритериев.СтавкаЗаКМ20FutБезНДС;
					//Евросиб Шевченко А.В. US 100317 TA 126448 22.12.2025
				КонецЕсли;
				
				Если ЗначениеЗаполнено(СтрокаТаблицыКритериев.Критерий) Тогда
					КритерииПоУслуге.Добавить(СтрокаТаблицыКритериев.Критерий);
				КонецЕсли;
				
				// Евросиб US 98207 TA 100593 Рыбьяков К.А. 19.03.2025 ((
				Если ЗначениеЗаполнено(СтрокаТаблицыКритериев.Продукт) Тогда
					Продукты.Добавить(СтрокаТаблицыКритериев.Продукт);
				КонецЕсли;
				// Евросиб Рыбьяков К.А. 19.03.2025 ))
				
				Если ЗначениеЗаполнено(СтрокаТаблицыКритериев.УчетноеНаправление) Тогда
					УчетныеНаправления.Добавить(СтрокаТаблицыКритериев.УчетноеНаправление);
				КонецЕсли;
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаУслуги.ПунктОтправления) Тогда			
				Дороги = ТаблицаДорог.Скопировать(Новый Структура("Станция", СтрокаУслуги.ПунктОтправления));
				НаименованияДорог = Дороги.ВыгрузитьКолонку("ЖелезнаяДорога");
				СтрокаДороги = СтрСоединить(НаименованияДорог, "; ");
				СтрокаУслуги.ДорогаОтправления = СтрокаДороги;
			Иначе
				СтрокаУслуги.ДорогаОтправления = "";
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаУслуги.ПунктНазначения) Тогда
				Дороги = ТаблицаДорог.Скопировать(Новый Структура("Станция", СтрокаУслуги.ПунктНазначения));
				НаименованияДорог = Дороги.ВыгрузитьКолонку("ЖелезнаяДорога");
				СтрокаДороги = СтрСоединить(НаименованияДорог, "; ");
				СтрокаУслуги.ДорогаНазначения = СтрокаДороги;
			Иначе
				СтрокаУслуги.ДорогаНазначения = "";
			КонецЕсли;
			
		КонецЦикла;
		
		Если ОбновитьПоляТЧКритерии Тогда
			Продукты = ОбщегоНазначенияКлиентСервер.СвернутьМассив(Продукты);
			// Евросиб US 98207 TA 100593 Рыбьяков К.А. 19.03.2025 ((
			СтрокаУслуги.Продукт.ЗагрузитьЗначения(Продукты);
			// Евросиб Рыбьяков К.А. 19.03.2025 ))
			СтрокаУслуги.ПродуктСтрокой = СтрСоединить(Продукты, ", ");
			
			УчетныеНаправления = ОбщегоНазначенияКлиентСервер.СвернутьМассив(УчетныеНаправления);
			СтрокаУслуги.УчетныеНаправления.ЗагрузитьЗначения(УчетныеНаправления);
			СтрокаУслуги.УчетныеНаправленияСтрокой = СтрСоединить(УчетныеНаправления, ", ");
			
			СтрокаУслуги.Критерии.ЗагрузитьЗначения(КритерииПоУслуге);
			// Евросиб US 98207 TA 100593 Рыбьяков К.А. 03.04.2025 ((
			КритерииПоУслуге = ОбщегоНазначенияКлиентСервер.СвернутьМассив(КритерииПоУслуге);
			СтрокаУслуги.КритерииСтрокой = СтрСоединить(КритерииПоУслуге, Символы.ПС);
			// Евросиб Рыбьяков К.А. 03.04.2025 ))
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовГруппы(ГруппаЭлементов, Видимость, Исключения)
	
	ТипГруппаФормы = Тип("ГруппаФормы");
	
	Для Каждого Элемент Из ГруппаЭлементов.ПодчиненныеЭлементы Цикл
		
		Если Исключения.Найти(Элемент.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(Элемент) = ТипГруппаФормы Тогда
			УстановитьВидимостьЭлементовГруппы(Элемент, Видимость, Исключения);
		КонецЕсли;
		
		Элемент.Видимость = Видимость;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
