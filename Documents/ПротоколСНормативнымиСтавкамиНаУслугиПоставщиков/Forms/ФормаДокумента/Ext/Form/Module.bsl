&НаСервере
Процедура ОбработатьИзменениеПродуктовУслуг(ТекДанные)
	
	//Евросиб Каблов 26.05.2025 ( # Строки критериев формируются перед записью
	//// Евросиб US 98207 TA 100593 Рыбьяков К.А. 19.03.2025 ((
	//СформироватьСтрокиКритериевПоПродуктамТаблицыУслуг(ТекДанные);
	//// Евросиб Рыбьяков К.А. 19.03.2025 ))
	//Евросиб Каблов 26.05.2025 )
	ТекДанные.ПродуктСтрокой = СтрСоединить(ТекДанные.Продукт.ВыгрузитьЗначения(), "; ");
	
КонецПроцедуры

&НаСервере
Процедура СформироватьСтрокиКритериевПоПродуктамТаблицыУслуг(СтрокаТЧ)
	// Евросиб US 98207 TA 100593 Рыбьяков К.А. 19.03.2025 ((
	СтрокиКритериев = Объект.КритерииУслуг.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", СтрокаТЧ.ИдентификаторСтрокиУслуг));
	
	ЗаполненныеСтроки = Новый Массив;
	Если ЗначениеЗаполнено(СтрокаТЧ.Продукт) Тогда			
		Для Каждого ЭлементСписка Из СтрокаТЧ.Продукт Цикл
			Продукт = ЭлементСписка.Значение;
			НайденныеСтроки = Объект.КритерииУслуг.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг, Продукт", СтрокаТЧ.ИдентификаторСтрокиУслуг, Продукт));
			Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
				ЗаполненныеСтроки.Добавить(НайденныеСтроки[0].ПолучитьИдентификатор());
			Иначе
				НоваяСтрока = Объект.КритерииУслуг.Добавить();
				НоваяСтрока.ИдентификаторСтрокиУслуг = СтрокаТЧ.ИдентификаторСтрокиУслуг;
				НоваяСтрока.Продукт = Продукт;
				ЗаполненныеСтроки.Добавить(НоваяСтрока.ПолучитьИдентификатор());
			КонецЕсли;
		КонецЦикла;
	Иначе			
		НайденныеСтроки = Объект.КритерииУслуг.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг, Продукт", СтрокаТЧ.ИдентификаторСтрокиУслуг, Справочники.ПродуктыДКП.ПустаяСсылка()));
		Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
			ЗаполненныеСтроки.Добавить(НайденныеСтроки[0].ПолучитьИдентификатор());
		Иначе
			НоваяСтрока = Объект.КритерииУслуг.Добавить();
			НоваяСтрока.ИдентификаторСтрокиУслуг = СтрокаТЧ.ИдентификаторСтрокиУслуг;
			ЗаполненныеСтроки.Добавить(НоваяСтрока.ПолучитьИдентификатор());
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого НайденнаяСтрока Из СтрокиКритериев Цикл
		Если ЗаполненныеСтроки.Найти(НайденнаяСтрока.ПолучитьИдентификатор()) = Неопределено Тогда
			Объект.КритерииУслуг.Удалить(НайденнаяСтрока);
		КонецЕсли;
	КонецЦикла;
	// Евросиб Рыбьяков К.А. 19.03.2025 ))
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиУчетныеНаправленияСтрокойНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Модифицированность = Истина;
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	ТекСтрока = Элементы.Услуги.ТекущаяСтрока;
	
	ПараметрыОтбораУчетныхНаправлений = Новый Структура;
	ПараметрыОтбораУчетныхНаправлений.Вставить("Дата", ?(ЗначениеЗаполнено(Объект.ДатаПСЦ), Объект.ДатаПСЦ, ТекущаяДата()));
	
	ДоступныеЗначения = ПолучитьУчетныеНаправления(ПараметрыОтбораУчетныхНаправлений);
	ВыбираемыеЗначения = Новый СписокЗначений;
	ВыбираемыеЗначения.ЗагрузитьЗначения(ДоступныеЗначения);
		
	Для Каждого ЭлементСписка Из ВыбираемыеЗначения Цикл
		ВыбранныйЭлемент = ТекДанные.УчетныеНаправления.НайтиПоЗначению(ЭлементСписка.Значение);
		Если ВыбранныйЭлемент <> Неопределено Тогда
			ЭлементСписка.Пометка = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;	
	ПараметрыФормы.Вставить("ТекущийСписок", ВыбираемыеЗначения);
	ПараметрыФормы.Вставить("ПоказыватьПометку", Истина);
	ПараметрыФормы.Вставить("ИзменятьСоставСтрок", Ложь);
	
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ИдентификаторСтроки", ТекСтрока);
	
	ОповещениеОЗакрытииФормыСписка = Новый ОписаниеОповещения("ПриЗакрытииФормыРедактированияСпискаУчетныхНаправлений", ЭтаФорма, ПараметрыОповещения);	
	ОткрытьФорму("ОбщаяФорма.ФормаРедактированияСпискаЗначений", ПараметрыФормы, Этаформа,,,, ОповещениеОЗакрытииФормыСписка, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьУчетныеНаправления(ПараметрыОтбора)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УчетныеНаправления.Ссылка КАК Ссылка,
		|	УчетныеНаправления.Код КАК Код
		|ИЗ
		|	Справочник.УчетныеНаправления КАК УчетныеНаправления
		|ГДЕ
		|	НЕ УчетныеНаправления.ПометкаУдаления
		|	И (УчетныеНаправления.ДатаНеИспользовать = &ПустаяДата
		|			ИЛИ УчетныеНаправления.ДатаНеИспользовать >= &Дата)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Код";
	
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	Запрос.УстановитьПараметр("Дата", ПараметрыОтбора.Дата);
	
	ТаблицаПродуктов = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаПродуктов.ВыгрузитьКолонку("Ссылка");
	
КонецФункции

&НаКлиенте
Процедура ПриЗакрытииФормыРедактированияСпискаУчетныхНаправлений(СписокУчетныхНаправлений, ДополнительныеПараметры) Экспорт
	
	Если СписокУчетныхНаправлений <> Неопределено Тогда
		
		ТекСтрока = ДополнительныеПараметры.ИдентификаторСтроки;
		ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ТекСтрока);
		ТекДанные.УчетныеНаправления.Очистить();		
		
		Для Каждого ЭлементСписка Из СписокУчетныхНаправлений Цикл
			Если ЭлементСписка.Пометка Тогда
				ТекДанные.УчетныеНаправления.Добавить(ЭлементСписка.Значение);
			КонецЕсли;
		КонецЦикла;
		
		УслугиУчетныеНаправленияПриИзмененииСервер(ТекСтрока);
	
		Если ЗаполнятьВниз Тогда
			ВыполнитьЗаполнениеВниз();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

