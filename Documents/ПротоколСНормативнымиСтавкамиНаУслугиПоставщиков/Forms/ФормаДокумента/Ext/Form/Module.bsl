&НаСервереБезКонтекста
Функция ПолучитьТипоразмерыКТК()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТипоразмерыТЕ.Ссылка КАК Ссылка,
		|	ТипоразмерыТЕ.Код КАК Код
		|ИЗ
		|	Справочник.ТипоразмерыТЕ КАК ТипоразмерыТЕ
		|ГДЕ
		|	НЕ ТипоразмерыТЕ.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Код";
	
	ТаблицаТипоразмеров = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаТипоразмеров.ВыгрузитьКолонку("Ссылка");
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТипоразмерыВагонов()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТипоразмерыТС.Ссылка КАК Ссылка,
	|	ТипоразмерыТС.Код КАК Код
	|ИЗ
	|	Справочник.ТипоразмерыТС КАК ТипоразмерыТС
	|ГДЕ
	|	НЕ ТипоразмерыТС.ПометкаУдаления
	|	И ТипоразмерыТС.Родитель = &ТипоразмерТСПустаяСсылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код";
	
	Запрос.УстановитьПараметр("ТипоразмерТСПустаяСсылка", Справочники.ТипоразмерыТС.ПустаяСсылка());
	ТаблицаТипоразмеров = Запрос.Выполнить().Выгрузить();
	
