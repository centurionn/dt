
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбновитьБлокировкуЭлементов();
	
	Если НЕ Пользователи.РолиДоступны("ПолныеПрава",, Ложь) Тогда
		РазрешитьРедактированиеСостояния = Пользователи.РолиДоступны("dc_РазрешитьРедактированиеСостоянияПСЦПоставщика",, Ложь);
		РегистрыСведений.СостоянияДокументов.УстановитьДоступностьТаблицыСостояния(Элементы.ГруппаСостояния, "Состояния", "СостоянияИсполнитель", РазрешитьРедактированиеСостояния);
	КонецЕсли;
	
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	
	ОбновитьПанельТекущегоПользователя();
	ОбновитьПанельСостояний();
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		НастроитьКолонкиТаблицыУслугПоВидуУслугПоставщика();
		ОбновитьДинамическиеПоляТаблицыУслуг(, Истина);
		
		Элементы.ОкончаниеДействия.АвтоОтметкаНезаполненного = Не Объект.ДействуетДоСогласованияНовыхУсловий;
		
	КонецЕсли;
	
	КлючАналитикиДляПереходаКСтрокеУслуг = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "КлючАналитикиДляПереходаКСтрокеУслуг");
	Если ЗначениеЗаполнено(КлючАналитикиДляПереходаКСтрокеУслуг) Тогда
		СтрокиТаблицыКритериев = Объект.КритерииУслуг.НайтиСтроки(Новый Структура("КлючАналитикиСтрокиПротокола", КлючАналитикиДляПереходаКСтрокеУслуг));
		Если ЗначениеЗаполнено(СтрокиТаблицыКритериев) Тогда
			СтрокиТаблицыУслуг = Объект.Услуги.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", СтрокиТаблицыКритериев[0].ИдентификаторСтрокиУслуг));
			Если ЗначениеЗаполнено(СтрокиТаблицыУслуг) Тогда
				Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаУслугиПоставщика;				
				Элементы.Услуги.ТекущаяСтрока = СтрокиТаблицыУслуг[0].ПолучитьИдентификатор();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	НастроитьКолонкиТаблицыУслугПоВидуУслугПоставщика();
	ОбновитьДинамическиеПоляТаблицыУслуг(, Истина);
	
	Элементы.ОкончаниеДействия.АвтоОтметкаНезаполненного = Не Объект.ДействуетДоСогласованияНовыхУсловий;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ТребуетсяПеречитатьУказанныйДокумент" И Параметр = Объект.Ссылка Тогда
		ЭтаФорма.Прочитать();
		ОбновитьПанельТекущегоПользователя();
		ОбновитьПанельСостояний();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	СоздатьСтрокиКритериевУслуг();
	
КонецПроцедуры

&НаСервере
Процедура СоздатьСтрокиКритериевУслуг()
	
	//Для Каждого Стр Из Объект.Услуги Цикл		
	//	СформироватьСтрокиКритериевПоТипоразмерамКТКСтрокиТаблицыУслуг(Стр);		
	//КонецЦикла;
	
	ТипМультилокация = Тип("СправочникСсылка.Мультилокации");
	
	ЛокацияПустаяСсылка = Справочники.Локации.ПустаяСсылка();
	
	ТипИерархииГород = Перечисления.ТипыИерархииЛокации.НаселенныйПункт;
	ТипИерархииСтрана = Перечисления.ТипыИерархииЛокации.Страна;
	
	ТипоразмерыТЕПустаяСсылка = ПредопределенноеЗначение("Справочник.ТипоразмерыТЕ.ПустаяСсылка");
	ТипоразмерыТСПустаяСсылка = ПредопределенноеЗначение("Справочник.ТипоразмерыТС.ПустаяСсылка"); //Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025
	РазмерКТК20 = "20";
	РазмерКТК40 = "40";
	
	Запрос = Новый Запрос;
	
	#Область ТекстЗапроса
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПСЦПоставщикаУслуги.НомерСтроки КАК НомерСтроки,
	|	ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ПСЦПоставщикаУслуги.ПунктОтправления КАК ПунктОтправления,
	|	ПСЦПоставщикаУслуги.ПунктОтправленияГород КАК ПунктОтправленияГород,
	|	ПСЦПоставщикаУслуги.ПунктОтправленияСтрана КАК ПунктОтправленияСтрана,
	|	ПСЦПоставщикаУслуги.ПунктНазначения КАК ПунктНазначения,
	|	ПСЦПоставщикаУслуги.ПунктНазначенияГород КАК ПунктНазначенияГород,
	|	ПСЦПоставщикаУслуги.ЛокацияОказанияУслуги КАК ЛокацияОказанияУслуги,
	|	ПСЦПоставщикаУслуги.ПунктНазначенияСтрана КАК ПунктНазначенияСтрана,
	//Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025
	|	ПСЦПоставщикаУслуги.ВидТранспорта КАК ВидТранспорта,
	//Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025
	//Евросиб Шевченко А.В. US 100317 TA 126448 22.12.2025
	|	ПСЦПоставщикаУслуги.Километраж КАК Километраж
	//Евросиб Шевченко А.В. US 100317 TA 126448 22.12.2025
	|ПОМЕСТИТЬ Услуги
	|ИЗ
	|	Документ.ПротоколСНормативнымиСтавкамиНаУслугиПоставщиков.Услуги КАК ПСЦПоставщикаУслуги
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Услуги.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ЕСТЬNULL(МультилокацииЛокации.Локация, Услуги.ЛокацияОказанияУслуги) КАК ЛокацияОказанияУслуги
	|ПОМЕСТИТЬ ЛокацииОказанияУслуги
	|ИЗ
	|	Услуги КАК Услуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Мультилокации.Локации КАК МультилокацииЛокации
	|		ПО Услуги.ЛокацияОказанияУслуги = МультилокацииЛокации.Ссылка
	|;
	//Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаВидовОтправок.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ТаблицаВидовОтправок.ВидОтправки КАК ВидОтправки
	|ПОМЕСТИТЬ ТаблицаВидовОтправок
	|ИЗ
	|	&ТаблицаВидовОтправок КАК ТаблицаВидовОтправок
	|;
	//Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаПродуктов.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ТаблицаПродуктов.Продукт КАК Продукт
	|ПОМЕСТИТЬ ТаблицаПродуктов
	|ИЗ
	|	&ТаблицаПродуктов КАК ТаблицаПродуктов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаУчетныхНаправлений.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ТаблицаУчетныхНаправлений.УчетноеНаправление КАК УчетноеНаправление
	|ПОМЕСТИТЬ ТаблицаУчетныхНаправлений
	|ИЗ
	|	&ТаблицаУчетныхНаправлений КАК ТаблицаУчетныхНаправлений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТипоразмеровКТК.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ТаблицаТипоразмеровКТК.РазмерКТК КАК РазмерКТК,
	|	ТаблицаТипоразмеровКТК.ТипоразмерКТК КАК ТипоразмерКТК,
	//Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025
	|	ТаблицаТипоразмеровКТК.ТипоразмерВагона КАК ТипоразмерВагона,
	//Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025
	|	ТаблицаТипоразмеровКТК.СтоимостьБезНДС КАК СтоимостьБезНДС,
	|	ТаблицаТипоразмеровКТК.СтоимостьСНДС КАК СтоимостьСНДС,
	|	ТаблицаТипоразмеровКТК.СтоимостьЗаСуткиБезНДС КАК СтоимостьЗаСуткиБезНДС,
	//Евросиб Шевченко А.В. US 100317 TA 126448 22.12.2025
	|	ТаблицаТипоразмеровКТК.СтавкаЗаКМ40FutБезНДС КАК СтавкаЗаКМ40FutБезНДС,
	|	ТаблицаТипоразмеровКТК.СтавкаЗаКМ20FutБезНДС КАК СтавкаЗаКМ20FutБезНДС
	//Евросиб Шевченко А.В. US 100317 TA 126448 22.12.2025
	|ПОМЕСТИТЬ ТаблицаТипоразмеровКТК
	|ИЗ
	|	&ТаблицаТипоразмеровКТК КАК ТаблицаТипоразмеровКТК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Услуги.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ЕСТЬNULL(МультилокацииЛокации.Локация, Услуги.ПунктОтправления) КАК ПунктОтправления
	|ПОМЕСТИТЬ ПунктыОтправления
	|ИЗ
	|	Услуги КАК Услуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Мультилокации.Локации КАК МультилокацииЛокации
	|		ПО Услуги.ПунктОтправления = МультилокацииЛокации.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Услуги.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ЕСТЬNULL(МультилокацииЛокации.Локация, Услуги.ПунктОтправленияГород) КАК ПунктОтправленияГород
	|ПОМЕСТИТЬ ГородаОтправления
	|ИЗ
	|	Услуги КАК Услуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Мультилокации.Локации КАК МультилокацииЛокации
	|		ПО Услуги.ПунктОтправленияГород = МультилокацииЛокации.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Услуги.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ЕСТЬNULL(МультилокацииЛокации.Локация, Услуги.ПунктОтправленияСтрана) КАК ПунктОтправленияСтрана
	|ПОМЕСТИТЬ СтраныОтправления
	|ИЗ
	|	Услуги КАК Услуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Мультилокации.Локации КАК МультилокацииЛокации
	|		ПО Услуги.ПунктОтправленияСтрана = МультилокацииЛокации.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПунктыОтправления.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ПунктыОтправления.ПунктОтправления КАК ПунктОтправления,
	|	ИерархияЛокацийГорода.ЛокацияВышестоящегоУровня КАК ЛокацияВышестоящегоУровняГород,
	|	ИерархияЛокацийСтраны.ЛокацияВышестоящегоУровня КАК ЛокацияВышестоящегоУровняСтрана
	|ПОМЕСТИТЬ ПунктыОтправленияСИерархией
	|ИЗ
	|	ПунктыОтправления КАК ПунктыОтправления
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИерархияЛокаций КАК ИерархияЛокацийГорода
	|		ПО ПунктыОтправления.ПунктОтправления = ИерархияЛокацийГорода.Локация
	|			И (ИерархияЛокацийГорода.ТипИерархии = &ТипИерархииГород)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИерархияЛокаций КАК ИерархияЛокацийСтраны
	|		ПО ПунктыОтправления.ПунктОтправления = ИерархияЛокацийСтраны.Локация
	|			И (ИерархияЛокацийСтраны.ТипИерархии = &ТипИерархииСтрана)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГородаОтправления.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ГородаОтправления.ПунктОтправленияГород КАК ПунктОтправленияГород,
	|	ИерархияЛокаций.ЛокацияВышестоящегоУровня КАК ЛокацияВышестоящегоУровняСтрана
	|ПОМЕСТИТЬ ГородаОтправленияСИерархией
	|ИЗ
	|	ГородаОтправления КАК ГородаОтправления
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИерархияЛокаций КАК ИерархияЛокаций
	|		ПО ГородаОтправления.ПунктОтправленияГород = ИерархияЛокаций.Локация
	|			И (ИерархияЛокаций.ТипИерархии = &ТипИерархииСтрана)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПунктыОтправленияСИерархией.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ПунктыОтправленияСИерархией.ПунктОтправления КАК ПунктОтправления,
	|	ГородаОтправленияСИерархией.ПунктОтправленияГород КАК ПунктОтправленияГород,
	|	ЕСТЬNULL(ГородаОтправленияСИерархией.ЛокацияВышестоящегоУровняСтрана, ПунктыОтправленияСИерархией.ЛокацияВышестоящегоУровняСтрана) КАК ЛокацияВышестоящегоУровняСтрана
	|ПОМЕСТИТЬ ПунктГородОтправления
	|ИЗ
	|	ПунктыОтправленияСИерархией КАК ПунктыОтправленияСИерархией
	|		ЛЕВОЕ СОЕДИНЕНИЕ ГородаОтправленияСИерархией КАК ГородаОтправленияСИерархией
	|		ПО ПунктыОтправленияСИерархией.ИдентификаторСтрокиУслуг = ГородаОтправленияСИерархией.ИдентификаторСтрокиУслуг
	|			И (ВЫБОР
	|				КОГДА ПунктыОтправленияСИерархией.ПунктОтправления = &ЛокацияПустаяСсылка
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ПунктыОтправленияСИерархией.ЛокацияВышестоящегоУровняГород = ГородаОтправленияСИерархией.ПунктОтправленияГород
	|			КОНЕЦ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПунктГородОтправления.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ПунктГородОтправления.ПунктОтправления КАК ПунктОтправления,
	|	ПунктГородОтправления.ПунктОтправленияГород КАК ПунктОтправленияГород,
	|	СтраныОтправления.ПунктОтправленияСтрана КАК ПунктОтправленияСтрана
	|ПОМЕСТИТЬ ПунктГородСтранаОтправления
	|ИЗ
	|	ПунктГородОтправления КАК ПунктГородОтправления
	|		ЛЕВОЕ СОЕДИНЕНИЕ СтраныОтправления КАК СтраныОтправления
	|		ПО ПунктГородОтправления.ИдентификаторСтрокиУслуг = СтраныОтправления.ИдентификаторСтрокиУслуг
	|			И (ВЫБОР
	|				КОГДА ПунктГородОтправления.ПунктОтправления = &ЛокацияПустаяСсылка
	|						И ПунктГородОтправления.ПунктОтправленияГород = &ЛокацияПустаяСсылка
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ПунктГородОтправления.ЛокацияВышестоящегоУровняСтрана = СтраныОтправления.ПунктОтправленияСтрана
	|			КОНЕЦ)
	|;
	|
