&НаСервере
Процедура ПолучитьДопДанныеЛокации(Локация, ДанныеЛокации) 

	Если ЗначениеЗаполнено(Локация) Тогда
		
		Если ТипЗнч(Локация) = Тип("СправочникСсылка.Локации") Тогда
			
			Если ДанныеЛокации.Свойство("Адрес") Тогда
				ДанныеЛокации.Адрес = ОбщегоНазначенияВызовСервера.ЗначениеРеквизитаОбъекта(Локация, "Адрес");
			КонецЕсли;		
			Если ДанныеЛокации.Свойство("Город") Тогда
				ДанныеЛокации.Город = ПолучитьЛокациюВышестоящегоУровня(Локация, Перечисления.ТипыИерархииЛокации.НаселенныйПункт);
			КонецЕсли;
			Если ДанныеЛокации.Свойство("Страна") Тогда
				ДанныеЛокации.Страна = ПолучитьЛокациюВышестоящегоУровня(Локация, Перечисления.ТипыИерархииЛокации.Страна);
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(Локация) = Тип("СправочникСсылка.Мультилокации") Тогда
			
			Если ДанныеЛокации.Свойство("Город") Тогда				
				Города = ПолучитьЛокацииВышестоящегоУровняПоМультилокации(Локация, Перечисления.ТипыИерархииЛокации.НаселенныйПункт);
				Если Города.Количество() = 1 Тогда
					ДанныеЛокации.Город = Города[0];
				Иначе
					ДанныеЛокации.Город = Справочники.Локации.ПустаяСсылка();
				КонецЕсли;
			КонецЕсли;
			
			Если ДанныеЛокации.Свойство("Страна") Тогда
				Страны = ПолучитьЛокацииВышестоящегоУровняПоМультилокации(Локация, Перечисления.ТипыИерархииЛокации.Страна);
				Если Страны.Количество() = 1 Тогда
					ДанныеЛокации.Страна = Страны[0];
				Иначе
					ДанныеЛокации.Страна = Справочники.Локации.ПустаяСсылка();
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЛокациюВышестоящегоУровня(Локация, ТипИерархии)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИерархияЛокаций.ЛокацияВышестоящегоУровня КАК ЛокацияВышестоящегоУровня
	|ИЗ
	|	РегистрСведений.ИерархияЛокаций КАК ИерархияЛокаций
	|ГДЕ
	|	ИерархияЛокаций.Локация = &Локация
	|	И ИерархияЛокаций.ТипИерархии = &ТипИерархии";
	Запрос.УстановитьПараметр("Локация", Локация);
	Запрос.УстановитьПараметр("ТипИерархии", ТипИерархии);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЛокацияВышестоящегоУровня = Выборка.ЛокацияВышестоящегоУровня;
	Иначе
		ЛокацияВышестоящегоУровня = Справочники.Локации.ПустаяСсылка();
	КонецЕсли;
	
	Возврат ЛокацияВышестоящегоУровня;
	
КонецФункции

&НаСервере
Функция ПолучитьЛокацииВышестоящегоУровняПоМультилокации(Мультилокация, ТипИерархии)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИерархияЛокаций.ЛокацияВышестоящегоУровня КАК ЛокацияВышестоящегоУровня
	|ИЗ
	|	Справочник.Мультилокации.Локации КАК МультилокацииЛокации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИерархияЛокаций КАК ИерархияЛокаций
	|		ПО МультилокацииЛокации.Локация = ИерархияЛокаций.Локация
	|			И (ИерархияЛокаций.ТипИерархии = &ТипИерархии)
	|ГДЕ
	|	МультилокацииЛокации.Ссылка = &Мультилокация";
	Запрос.УстановитьПараметр("Мультилокация", Мультилокация);
	Запрос.УстановитьПараметр("ТипИерархии", ТипИерархии);
	
	ТаблицаЛокаций = Запрос.Выполнить().Выгрузить();
	ЛокацииВышестоящегоУровня = ТаблицаЛокаций.ВыгрузитьКолонку("ЛокацияВышестоящегоУровня");
	
	Возврат ЛокацииВышестоящегоУровня;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаВыбораТипаПоляЛокации(ВыбранныйТип, ДопПараметры) Экспорт
	
	Если ВыбранныйТип <> Неопределено Тогда
		
		ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ДопПараметры.ИдентификаторТекСтроки);
		ИмяПоля = ДопПараметры.ИмяПоля;
		Если ВыбранныйТип.Значение = Тип("СправочникСсылка.Мультилокации") Тогда
			ТекДанные[ИмяПоля] = ПредопределенноеЗначение("Справочник.Мультилокации.ПустаяСсылка");
		Иначе
			ТекДанные[ИмяПоля] = ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьНачалоВыбораЛокации(Элемент, ИмяПоля, СтандартнаяОбработка)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	
	Если ТекДанные[ИмяПоля] = Неопределено Тогда
		
		ИдентификаторТекСтроки = ТекДанные.ПолучитьИдентификатор();
		
		СписокТипов = новый СписокЗначений;
		
		ДоступныеТипы = Элемент.ОграничениеТипа.Типы();
		Если ЗначениеЗаполнено(ДоступныеТипы) Тогда
			СписокТипов.ЗагрузитьЗначения(ДоступныеТипы);
		Иначе
			СписокТипов.Добавить(Тип("СправочникСсылка.Локации"));
			СписокТипов.Добавить(Тип("СправочникСсылка.Мультилокации"));
		КонецЕсли;
	
		Если СписокТипов.Количество() > 1 Тогда
			
			СтандартнаяОбработка = Ложь;
			
			ДопПараметры = Новый Структура("ИдентификаторТекСтроки, ИмяПоля", ИдентификаторТекСтроки, ИмяПоля);
			ОповещениеОВыборе = Новый ОписаниеОповещения("ОбработкаВыбораТипаПоляЛокации", ЭтаФорма, ДопПараметры);
			
			СписокТипов.ПоказатьВыборЭлемента(ОповещениеОВыборе, "Выбор типа данных");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗаполнениеВниз(Элемент = Неопределено)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		
		ПроверенныеСтроки = Новый Массив;
		ИндексСледующейСтроки = Объект.Услуги.Индекс(ТекДанные) + 1;
		ИндексПоследнейСтроки = Объект.Услуги.Количество() - 1;
		Для ИндексСтроки = ИндексСледующейСтроки По ИндексПоследнейСтроки Цикл
			СтрокаТЧ = Объект.Услуги[ИндексСтроки];
			ИдентификаторСтроки = СтрокаТЧ.ПолучитьИдентификатор();
			РезПроверки = Элементы.Услуги.ПроверитьСтроку(ИдентификаторСтроки);
			Если РезПроверки Тогда
				ПроверенныеСтроки.Добавить(ИдентификаторСтроки);
			КонецЕсли;					
		КонецЦикла;			
		
		Если ЗначениеЗаполнено(ПроверенныеСтроки) Тогда
			ТекСтрока = Элементы.Услуги.ТекущаяСтрока;
			ИмяТекущегоЭлемента = Элементы.Услуги.ТекущийЭлемент.Имя;
			ВыполнитьЗаполнениеВнизСервер(ТекСтрока, ПроверенныеСтроки, ИмяТекущегоЭлемента);
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ВыполнитьЗаполнениеВнизСервер(ТекСтрока, ПроверенныеСтроки, ИмяЭлемента)
	
	ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ТекСтрока);
	ТекЭлемент = Элементы[ИмяЭлемента];
	НомерСимволаНачалаИмениПоля = 7;
	ИмяПоля = Сред(ИмяЭлемента, НомерСимволаНачалаИмениПоля);
	ИмяПоляТЧ = СтрЗаменить(ТекЭлемент.ПутьКДанным, "Объект.Услуги.", "");
	УстановитьСтавкуНДС = Ложь;//Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025
	ТипСписокЗначений = Тип("СписокЗначений");
	
	ДанныеЗаполнения = Новый Структура;
	
	Если ИмяПоля = "УчетныеНаправленияСтрокой" Тогда
		
		ИмяПоляТЧ = "УчетныеНаправления";
		
	ИначеЕсли ИмяПоля = "Номенклатура" Тогда
		УстановитьСтавкуНДС = Истина; //Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025
		ЗначенияРеквизитовНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекДанные.Номенклатура, "ЕдиницаИзмерения");				
		Если ЗначениеЗаполнено(ЗначенияРеквизитовНоменклатуры.ЕдиницаИзмерения) Тогда
			ДанныеЗаполнения.Вставить("ЕдиницаИзмерения", ЗначенияРеквизитовНоменклатуры.ЕдиницаИзмерения);
		КонецЕсли;
		
		ОписаниеПоляВидСобственности = ПараметрыВидаУслуг.ПоляТаблицыУслуг.Получить("ВидСобственности");
		Если ОписаниеПоляВидСобственности <> Неопределено Тогда
			Если ТекДанные.Номенклатура = Справочники.Номенклатура.АрендаКонтейнеров Тогда
				ДанныеЗаполнения.Вставить("ВидСобственности", Перечисления.ВариантыСобственности.АрендаДлительная);
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ИмяПоля = "ПунктОтправления" Тогда
		
		ДанныеЛокации = Новый Структура;
		ПоляТаблицыУслуг = ПараметрыВидаУслуг.ПоляТаблицыУслуг;
		ОписаниеПоля = ПоляТаблицыУслуг.Получить("АдресТерминалаВыдачиПостановкиКТК");	
		Если ОписаниеПоля <> Неопределено Тогда
			ДанныеЛокации.Вставить("Адрес");
		КонецЕсли;		
		ОписаниеПоляГород = ПоляТаблицыУслуг.Получить("ПунктОтправленияГород");
		Если ОписаниеПоляГород <> Неопределено Тогда
			ДанныеЛокации.Вставить("Город");
		КонецЕсли;		
		ОписаниеПоляСтрана = ПоляТаблицыУслуг.Получить("ПунктОтправленияСтрана");
		Если ОписаниеПоляСтрана <> Неопределено Тогда
			ДанныеЛокации.Вставить("Страна");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеЛокации) Тогда			
			ПолучитьДопДанныеЛокации(ТекДанные.ПунктОтправления, ДанныеЛокации);
			Если ДанныеЛокации.Свойство("Адрес") Тогда
				ДанныеЗаполнения.Вставить("АдресТерминалаВыдачиПостановкиКТК", ДанныеЛокации.Адрес);
			КонецЕсли;		
			Если ДанныеЛокации.Свойство("Город") Тогда
				ДанныеЗаполнения.Вставить("ПунктОтправленияГород", ДанныеЛокации.Город);
			КонецЕсли;
			Если ДанныеЛокации.Свойство("Страна") Тогда
				ДанныеЗаполнения.Вставить("ПунктОтправленияСтрана", ДанныеЛокации.Страна);
			КонецЕсли;			
		КонецЕсли;
		
	ИначеЕсли ИмяПоля = "ПунктНазначения" Тогда
		
		ДанныеЛокации = Новый Структура;
		ПоляТаблицыУслуг = ПараметрыВидаУслуг.ПоляТаблицыУслуг;
		ОписаниеПоля = ПоляТаблицыУслуг.Получить("АдресТерминалаСдачиКТК");	
		Если ОписаниеПоля <> Неопределено Тогда
			ДанныеЛокации.Вставить("Адрес");
		КонецЕсли;		
		ОписаниеПоляГород = ПоляТаблицыУслуг.Получить("ПунктНазначенияГород");
		Если ОписаниеПоляГород <> Неопределено Тогда
			ДанныеЛокации.Вставить("Город");
		КонецЕсли;		
		ОписаниеПоляСтрана = ПоляТаблицыУслуг.Получить("ПунктНазначенияСтрана");
		Если ОписаниеПоляСтрана <> Неопределено Тогда
			ДанныеЛокации.Вставить("Страна");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеЛокации) Тогда			
			ПолучитьДопДанныеЛокации(ТекДанные.ПунктНазначения, ДанныеЛокации);
			Если ДанныеЛокации.Свойство("Адрес") Тогда
				ДанныеЗаполнения.Вставить("АдресТерминалаСдачиКТК", ДанныеЛокации.Адрес);
			КонецЕсли;		
			Если ДанныеЛокации.Свойство("Город") Тогда
				ДанныеЗаполнения.Вставить("ПунктНазначенияГород", ДанныеЛокации.Город);
			КонецЕсли;
			Если ДанныеЛокации.Свойство("Страна") Тогда
				ДанныеЗаполнения.Вставить("ПунктНазначенияСтрана", ДанныеЛокации.Страна);
			КонецЕсли;			
		КонецЕсли;
		
	ИначеЕсли ИмяПоля = "ПунктОтправленияГород" Тогда
		
		ЛокацияПустаяСсылка = Справочники.Локации.ПустаяСсылка();
		
		ПоляТаблицыУслуг = ПараметрыВидаУслуг.ПоляТаблицыУслуг;
		ОписаниеПоля = ПоляТаблицыУслуг.Получить("ПунктОтправленияСтрана");	
		Если ОписаниеПоля <> Неопределено  Тогда
			Если ЗначениеЗаполнено(ТекДанные.ПунктОтправленияГород) Тогда
				Если ТипЗнч(ТекДанные.ПунктОтправленияГород) = Тип("СправочникСсылка.Локации") Тогда				
					ПунктОтправленияСтрана = ПолучитьЛокациюВышестоящегоУровня(ТекДанные.ПунктОтправленияГород, Перечисления.ТипыИерархииЛокации.Страна);
				ИначеЕсли ТипЗнч(ТекДанные.ПунктОтправленияГород) = Тип("СправочникСсылка.Мультилокации") Тогда					
					Страны = ПолучитьЛокацииВышестоящегоУровняПоМультилокации(ТекДанные.ПунктОтправленияГород, Перечисления.ТипыИерархииЛокации.Страна);
					Если Страны.Количество() = 1 Тогда
						ПунктОтправленияСтрана = Страны[0];
					Иначе
						ПунктОтправленияСтрана = ЛокацияПустаяСсылка
					КонецЕсли;
				КонецЕсли;
			Иначе
				ПунктОтправленияСтрана = ЛокацияПустаяСсылка;
			КонецЕсли;
			ДанныеЗаполнения.Вставить("ПунктОтправленияСтрана", ПунктОтправленияСтрана);
		КонецЕсли;
		ДанныеЗаполнения.Вставить("ПунктОтправления", ЛокацияПустаяСсылка);
		
	ИначеЕсли ИмяПоля = "ПунктНазначенияГород" Тогда
		
		ЛокацияПустаяСсылка = Справочники.Локации.ПустаяСсылка();
		
		ПоляТаблицыУслуг = ПараметрыВидаУслуг.ПоляТаблицыУслуг;
		ОписаниеПоля = ПоляТаблицыУслуг.Получить("ПунктНазначенияСтрана");	
		Если ОписаниеПоля <> Неопределено  Тогда
			Если ЗначениеЗаполнено(ТекДанные.ПунктНазначенияГород) Тогда
				Если ТипЗнч(ТекДанные.ПунктНазначенияГород) = Тип("СправочникСсылка.Локации") Тогда				
					ПунктНазначенияСтрана = ПолучитьЛокациюВышестоящегоУровня(ТекДанные.ПунктНазначенияГород, Перечисления.ТипыИерархииЛокации.Страна);
				ИначеЕсли ТипЗнч(ТекДанные.ПунктНазначенияГород) = Тип("СправочникСсылка.Мультилокации") Тогда
					Страны = ПолучитьЛокацииВышестоящегоУровняПоМультилокации(ТекДанные.ПунктНазначенияГород, Перечисления.ТипыИерархииЛокации.Страна);
					Если Страны.Количество() = 1 Тогда
						ПунктНазначенияСтрана = Страны[0];
					Иначе
						ПунктНазначенияСтрана = ЛокацияПустаяСсылка;
					КонецЕсли;
				КонецЕсли;
			Иначе
				ПунктНазначенияСтрана = ЛокацияПустаяСсылка;
			КонецЕсли;
			ДанныеЗаполнения.Вставить("ПунктНазначенияСтрана", ПунктНазначенияСтрана);
		КонецЕсли;
		ДанныеЗаполнения.Вставить("ПунктНазначения", ЛокацияПустаяСсылка);
		
	ИначеЕсли ИмяПоля = "ПунктОтправленияСтрана" Тогда
		
		ЛокацияПустаяСсылка = Справочники.Локации.ПустаяСсылка();
		ДанныеЗаполнения.Вставить("ПунктОтправления", ЛокацияПустаяСсылка);
		ДанныеЗаполнения.Вставить("ПунктОтправленияГород", ЛокацияПустаяСсылка);
		
	ИначеЕсли ИмяПоля = "ПунктНазначенияСтрана" Тогда
		
		ЛокацияПустаяСсылка = Справочники.Локации.ПустаяСсылка();
		ДанныеЗаполнения.Вставить("ПунктНазначения", ЛокацияПустаяСсылка);
		ДанныеЗаполнения.Вставить("ПунктНазначенияГород", ЛокацияПустаяСсылка);
	//Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025	
	ИначеЕсли ИмяПоля = "ТипоразмерыКТК" Или ИмяПоля = "ТипоразмерыКТКСтрокой" Тогда
		
		ИмяПоляТЧ = "ТипоразмерыКТК";
		СоответствиеВесовТипоразмерам = ПолучитьСоответствиеВесовТипоразмерам();
		ДанныеЗаполнения.Вставить("ПроверкаСтавок", Перечисления.РезультатыПроверки.НеОсуществлялась);
		
	ИначеЕсли ИмяПоля = "ТипоразмерыВагонов" Или ИмяПоля = "ТипоразмерыВагоновСтрокой" Или ИмяПоля = "ТипоразмерВагона" Тогда
		
		ИмяПоляТЧ = "ТипоразмерыВагонов";
		
	КонецЕсли;
	//Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025
	НовоеЗначение = ТекДанные[ИмяПоляТЧ];
	
	Если ТипЗнч(НовоеЗначение) = ТипСписокЗначений Тогда
		ЗначенияСписка = НовоеЗначение.ВыгрузитьЗначения();
	Иначе
		ЗначенияСписка = Неопределено;
	КонецЕсли;
	
	ОбработанныеСтроки = Новый Массив;
	
	Для Каждого ИдентификаторСтроки Из ПроверенныеСтроки Цикл
		
		СтрокаТЧ = Объект.Услуги.НайтиПоИдентификатору(ИдентификаторСтроки);
		
		РезПроверки = Истина;
		
		Если ЗначенияСписка = Неопределено И СтрокаТЧ[ИмяПоляТЧ] = НовоеЗначение Тогда
			РезПроверки = Ложь;
		КонецЕсли;
		
		Если РезПроверки Тогда
			//Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025
			Если УстановитьСтавкуНДС Тогда
				ЗаполнитьСтавкуНДСВСтрокеУслуг(СтрокаТЧ);
			КонецЕсли;
			//Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025
			Если ЗначенияСписка <> Неопределено Тогда
				СтрокаТЧ[ИмяПоляТЧ].ЗагрузитьЗначения(ЗначенияСписка);
			Иначе
				СтрокаТЧ[ИмяПоляТЧ] = НовоеЗначение;
			КонецЕсли;
			
			Если ИмяПоля = "Продукт" Или ИмяПоля = "ПродуктСтрокой" Тогда
				
				ОбработатьИзменениеПродуктовУслуг(СтрокаТЧ);
				
			ИначеЕсли ИмяПоля = "УчетныеНаправления" Или ИмяПоля = "УчетныеНаправленияСтрокой" Тогда
				
				ОбработатьИзменениеУчетныхНаправленийСтрокиУслуг(СтрокаТЧ);
				
			ИначеЕсли ИмяПоля = "СтоимостьБезНДС" Тогда
				
				ОбработатьИзменениеСтоимостиБезНДСВСтрокеУслуг(СтрокаТЧ);
			//Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025	
			ИначеЕсли ИмяПоля = "ТипоразмерыКТК" Или ИмяПоля = "ТипоразмерыКТКСтрокой" Тогда
				
				ОбработатьИзмененияТипоразмеровКТКСтрокиУслуг(СтрокаТЧ);
				
			ИначеЕсли ИмяПоляТЧ = "ТипоразмерыВагонов" Или ИмяПоля = "ТипоразмерыВагоновСтрокой" Тогда
				
				ОбработатьИзменениеТипоразмеровВагоновСтрокиУслуг(СтрокаТЧ);
			//Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025	
			ИначеЕсли ИмяПоля = "СтоимостьСНДС" Тогда
				
				ОбработатьИзменениеСтоимостиСНДСВСтрокеУслуг(СтрокаТЧ);
				
			ИначеЕсли ИмяПоля = "СтоимостьБезНДС_КТК20" Тогда
				
				ПересчитатьСтоимостьСУчетомСтавкиНДС(СтрокаТЧ, "СтоимостьБезНДС_КТК20", "СтоимостьСНДС_КТК20", "СтоимостьСНДС_КТК20");
					
			 	//Евросиб Шевченко А.В. US 100317 TA 126448 22.12.2025
				Если ЗначениеЗаполнено(СтрокаТЧ.Километраж) Тогда
					СтрокаТЧ.СтавкаЗаКМ20FutБезНДС = СтрокаТЧ.СтоимостьБезНДС_КТК20 / СтрокаТЧ.Километраж;	
				КонецЕсли;
				//Евросиб Шевченко А.В. US 100317 TA 126448 22.12.2025
				
			ИначеЕсли ИмяПоля = "СтоимостьСНДС_КТК20" Тогда
								
				ПересчитатьСтоимостьСУчетомСтавкиНДС(СтрокаТЧ, "СтоимостьБезНДС_КТК20", "СтоимостьСНДС_КТК20", "СтоимостьБезНДС_КТК20");
				
			ИначеЕсли ИмяПоля = "СтоимостьБезНДС_КТК40" Тогда
				
				ПересчитатьСтоимостьСУчетомСтавкиНДС(СтрокаТЧ, "СтоимостьБезНДС_КТК40", "СтоимостьСНДС_КТК40", "СтоимостьСНДС_КТК40");
				
				//Евросиб Шевченко А.В. US 100317 TA 126448 22.12.2025
				Если ЗначениеЗаполнено(СтрокаТЧ.Километраж) Тогда
					СтрокаТЧ.СтавкаЗаКМ40FutБезНДС = СтрокаТЧ.СтоимостьБезНДС_КТК40 / СтрокаТЧ.Километраж;	
				КонецЕсли;
				//Евросиб Шевченко А.В. US 100317 TA 126448 22.12.2025
				
			ИначеЕсли ИмяПоля = "СтоимостьСНДС_КТК40" Тогда
								
				ПересчитатьСтоимостьСУчетомСтавкиНДС(СтрокаТЧ, "СтоимостьБезНДС_КТК40", "СтоимостьСНДС_КТК40", "СтоимостьБезНДС_КТК40");
			
			ИначеЕсли ИмяПоля = "СтавкаНДС" Тогда
				
				ПересчитатьСтоимостьСУчетомСтавкиНДС(СтрокаТЧ);
				
			ИначеЕсли ИмяПоля = "НормаПользования" Тогда
				
				ОбработатьИзменениеНормыПользованияВСтрокеУслуг(СтрокаТЧ);
				
			ИначеЕсли ИмяПоля = "Километраж" Тогда //Евросиб Шевченко А.В. US 100317 TA 126448 22.12.2025
				
				Если ЗначениеЗаполнено(СтрокаТЧ.СтоимостьБезНДС_КТК40) И ЗначениеЗаполнено(СтрокаТЧ.Километраж) Тогда
					СтрокаТЧ.СтавкаЗаКМ40FutБезНДС = СтрокаТЧ.СтоимостьБезНДС_КТК40 / СтрокаТЧ.Километраж;
				КонецЕсли;	
				Если ЗначениеЗаполнено(СтрокаТЧ.СтоимостьБезНДС_КТК20) И ЗначениеЗаполнено(СтрокаТЧ.Километраж) Тогда
					СтрокаТЧ.СтавкаЗаКМ20FutБезНДС = СтрокаТЧ.СтоимостьБезНДС_КТК20 / СтрокаТЧ.Километраж;	
				КонецЕсли;	
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
				ЗаполнитьЗначенияСвойств(СтрокаТЧ, ДанныеЗаполнения);
			КонецЕсли;
			
			ОбработанныеСтроки.Добавить(СтрокаТЧ);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ОбработанныеСтроки) Тогда
		ОбновитьДинамическиеПоляТаблицыУслуг(ОбработанныеСтроки, Ложь);
	КонецЕсли;
		
КонецПроцедуры 

