&НаСервере
Процедура ПересчитатьСтоимостьСУчетомСтавкиНДС(СтрокаУслуг, ИмяПоляСтоимостьБезНДС = "", ИмяПоляСтоимостьСНДС = "", ИмяРассчитываемогоПоля = "")
	
	// Евросиб US 98207 TA 100593 Рыбьяков К.А. 04.04.2025 ((
	Если Объект.ВидУслугПоставщика = ПредопределенноеЗначение("Справочник.ВидыУслугПоставщиков.НормативыДляКалькуляций") 
		И (ЗначениеЗаполнено(СтрокаУслуг.СтоимостьСНДС) ИЛИ ЗначениеЗаполнено(СтрокаУслуг.СтоимостьБезНДС)) Тогда
		Возврат;
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 04.04.2025 ))
	
	ЗначениеСтавкиНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСтавкуНДС(СтрокаУслуг.СтавкаНДС);
	
	Если ЗначениеЗаполнено(ИмяПоляСтоимостьБезНДС) И ЗначениеЗаполнено(ИмяПоляСтоимостьБезНДС) И ЗначениеЗаполнено(ИмяРассчитываемогоПоля) Тогда
		
		СтрокаУслуг[ИмяРассчитываемогоПоля] = 0;
		РассчитатьСтоимостьПоСтавкеНДС(СтрокаУслуг, ЗначениеСтавкиНДС, ИмяПоляСтоимостьБезНДС, ИмяПоляСтоимостьСНДС);
		
	Иначе
		
		РассчитатьСтоимостьПоСтавкеНДС(СтрокаУслуг, ЗначениеСтавкиНДС, "СтоимостьБезНДС", "СтоимостьСНДС");
		РассчитатьСтоимостьПоСтавкеНДС(СтрокаУслуг, ЗначениеСтавкиНДС, "СтоимостьБезНДС_КТК20", "СтоимостьСНДС_КТК20");
		РассчитатьСтоимостьПоСтавкеНДС(СтрокаУслуг, ЗначениеСтавкиНДС, "СтоимостьБезНДС_КТК40", "СтоимостьСНДС_КТК40");
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьСтоимостьПоСтавкеНДС(СтрокаУслуг, ЗначениеСтавкиНДС, ИмяПоляСтоимостьБезНДС, ИмяПоляСтоимостьСНДС)
	
	ПоляТаблицыУслуг = ПараметрыВидаУслуг.ПоляТаблицыУслуг;
	ОписаниеПоляСтоимостьБезНДС = ПоляТаблицыУслуг.Получить(ИмяПоляСтоимостьБезНДС);
	ОписаниеПоляСтоимостьСНДС = ПоляТаблицыУслуг.Получить(ИмяПоляСтоимостьСНДС);
	Если ОписаниеПоляСтоимостьБезНДС <> Неопределено И ОписаниеПоляСтоимостьСНДС <> Неопределено Тогда
		Если ЗначениеЗаполнено(СтрокаУслуг[ИмяПоляСтоимостьБезНДС]) Тогда
			СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСуммуНДС(СтрокаУслуг[ИмяПоляСтоимостьБезНДС], ЗначениеСтавкиНДС, Истина, Ложь);
			СтрокаУслуг[ИмяПоляСтоимостьСНДС] = СтрокаУслуг[ИмяПоляСтоимостьБезНДС] + СуммаНДС;
		ИначеЕсли ЗначениеЗаполнено(СтрокаУслуг[ИмяПоляСтоимостьСНДС]) Тогда
			СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСуммуНДС(СтрокаУслуг[ИмяПоляСтоимостьСНДС], ЗначениеСтавкиНДС, Истина, Истина);
			СтрокаУслуг[ИмяПоляСтоимостьБезНДС] = СтрокаУслуг[ИмяПоляСтоимостьСНДС] - СуммаНДС;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

