&НаСервере
Процедура ЗагрузитьПрочитаннуюТаблицу(АдресТаблицы)
	
	Таблица = ПолучитьИзВременногоХранилища(АдресТаблицы);
	УдалитьИзВременногоХранилища(АдресТаблицы);
	
	//Евросиб Шевченко А.В. US 100317 TA 126448 22.12.2025
	Если ЗначениеЗаполнено(ПараметрыВидаУслуг.ВалютаПоУмолчанию) Тогда
		ВалютаПоУмолчанию = ПараметрыВидаУслуг.ВалютаПоУмолчанию;
	Иначе
		ВалютаПоУмолчанию = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "ВалютаВзаиморасчетов");
	КонецЕсли;
	//Евросиб Шевченко А.В. US 100317 TA 126448 22.12.2025
	
	// Евросиб US 98207 TA 105661 Рыбьяков К.А. 02.04.2025 ((
	Если Таблица.Колонки.Найти("ПродуктыСписок") <> Неопределено Тогда
		ЗагружатьПродуктыСписок = Истина;
	Иначе
		ЗагружатьПродуктыСписок = Ложь;
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 02.04.2025 ))
	
	//Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025
	Если Таблица.Колонки.Найти("ТипоразмерыКТК") <> Неопределено И Таблица.Колонки.Найти("ТипоразмерыКТКСписок") <> Неопределено Тогда
		ЗагружатьТипоразмерыКТК = Истина;
	Иначе
		ЗагружатьТипоразмерыКТК = Ложь;
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("ТипоразмерыКТКСтрокой") <> Неопределено И Таблица.Колонки.Найти("ТипоразмерыКТКСписок") <> Неопределено Тогда
		ЗагружатьТипоразмерыКТКСтрокой = Истина;
	Иначе
		ЗагружатьТипоразмерыКТКСтрокой = Ложь;
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("ТипоразмерыВагоновСписок") <> Неопределено Тогда
		ЗагружатьТипоразмерыВагоновСписок = Истина;
	Иначе
		ЗагружатьТипоразмерыВагоновСписок = Ложь;
	КонецЕсли;
	//Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025
	
	СписокИсключаемыхИзЗаполненияПолей = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		ОписаниеПоля = ПараметрыВидаУслуг.ПоляТаблицыУслуг.Получить(Колонка.Имя);
		Если ОписаниеПоля <> Неопределено И ОписаниеПоля.ТолькоПросмотр Тогда
			СписокИсключаемыхИзЗаполненияПолей.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	ИсключаемыеИзЗаполненияПоля = СтрСоединить(СписокИсключаемыхИзЗаполненияПолей, ",");
	
	Для Каждого Стр Из Таблица Цикл
		
		ТекДанные = Объект.Услуги.Добавить();
		ИдентификаторСтроки = ТекДанные.ПолучитьИдентификатор();
		ЗаполнитьЗначенияСвойств(ТекДанные, Стр,, ИсключаемыеИзЗаполненияПоля);
		ТекДанные.ИдентификаторСтрокиУслуг = Строка(Новый УникальныйИдентификатор);
		
		Для Каждого Элемент Из ПараметрыВидаУслуг.ЗначенияПолейПоУмолчанию Цикл
			Если Не ЗначениеЗаполнено(ТекДанные[Элемент.Ключ]) Тогда
				ТекДанные[Элемент.Ключ] = Элемент.Значение;
			КонецЕсли;
		КонецЦикла;
		//Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025
		Если ЗагружатьТипоразмерыКТКСтрокой И ЗначениеЗаполнено(Стр.ТипоразмерыКТКСписок) Тогда
			ТекДанные.ТипоразмерыКТК.ЗагрузитьЗначения(Стр.ТипоразмерыКТКСписок.ВыгрузитьЗначения());
			ОбработатьИзмененияТипоразмеровКТКСтрокиУслуг(ТекДанные);
		КонецЕсли;
		
		Если ЗагружатьТипоразмерыКТК И ЗначениеЗаполнено(Стр.ТипоразмерыКТКСписок) Тогда
			ТекДанные.ТипоразмерыКТК.ЗагрузитьЗначения(Стр.ТипоразмерыКТКСписок.ВыгрузитьЗначения());
			ОбработатьИзмененияТипоразмеровКТКСтрокиУслуг(ТекДанные);
		КонецЕсли;
		
		Если ЗагружатьТипоразмерыВагоновСписок И ЗначениеЗаполнено(Стр.ТипоразмерыВагоновСписок) Тогда
			ТекДанные.ТипоразмерыВагонов.ЗагрузитьЗначения(Стр.ТипоразмерыВагоновСписок.ВыгрузитьЗначения());
			ОбработатьИзменениеТипоразмеровВагоновСтрокиУслуг(ТекДанные);
		КонецЕсли;
		//Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025
		Если ЗначениеЗаполнено(ТекДанные.Номенклатура) Тогда
			ОбработатьИзменениеНоменклатурыВСтроке(ТекДанные);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекДанные.ПунктОтправления) Тогда
			ОбработатьИзменениеПунктаОтправленияВСтроке(ТекДанные);
		ИначеЕсли ЗначениеЗаполнено(ТекДанные.ПунктОтправленияГород) Тогда
			ОбработатьИзменениеГородаОтправленияВСтроке(ТекДанные);
		КонецЕсли;
		//Евросиб Шевченко А.В. US 100317 TA 126448 22.12.2025
		Если Не ЗначениеЗаполнено(ТекДанные.Валюта) Тогда
			ТекДанные.Валюта = ВалютаПоУмолчанию;
		КонецЕсли;
		//Евросиб Шевченко А.В. US 100317 TA 126448 22.12.2025
		Если ЗначениеЗаполнено(ТекДанные.ПунктНазначения) Тогда
			ОбработатьИзменениеПунктаНазначенияВСтроке(ТекДанные);
		ИначеЕсли ЗначениеЗаполнено(ТекДанные.ПунктНазначенияГород) Тогда
			ОбработатьИзменениеГородаНазначенияВСтроке(ТекДанные);
		КонецЕсли;
		
		// Евросиб US 98207 TA 105661 Рыбьяков К.А. 02.04.2025 ((
		Если ЗагружатьПродуктыСписок И ЗначениеЗаполнено(Стр.ПродуктыСписок) Тогда
			ТекДанные.Продукт.ЗагрузитьЗначения(Стр.ПродуктыСписок.ВыгрузитьЗначения());
			ОбработатьИзменениеПродуктовУслуг(ТекДанные);
		КонецЕсли;
		// Евросиб Рыбьяков К.А. 02.04.2025 ))
		
		ПересчитатьСтоимостьСУчетомСтавкиНДС(ТекДанные);
		
		РассчитатьСтоимостьЗаСуткиБезНДС(ТекДанные);
		
		ПересчетСтавкиЗаКМБезНДССервер(ТекДанные); //Евросиб Шевченко А.В. US 100317 TA 126448 22.12.2025
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЛокациюИзПоляТаблицыУслуг(Элемент, СтандартнаяОбработка)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	ИмяПоля = Сред(Элемент.Имя, 7);
	Локация = ТекДанные[ИмяПоля];
	Если ЗначениеЗаполнено(Локация) Тогда
		Если ТипЗнч(Локация) = Тип("СправочникСсылка.Мультилокации") Тогда
			СтандартнаяОбработка = Ложь;
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Ключ", Локация);
			ПараметрыВыбораЛокаций = ОбщегоНазначенияКлиентСервер.СкопироватьМассив(Элемент.ПараметрыВыбора);
			ПараметрыФормы.Вставить("ПараметрыВыбораЛокаций", ПараметрыВыбораЛокаций);
			ОткрытьФорму("Справочник.Мультилокации.ФормаОбъекта", ПараметрыФормы);
		КонецЕсли;
	КонецЕсли;
	
