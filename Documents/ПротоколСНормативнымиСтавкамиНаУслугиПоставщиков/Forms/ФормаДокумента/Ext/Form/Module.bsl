&НаКлиенте
Процедура ОткрытьОкноСИнструкциями(Форма, Команда)
	ИнструкцииКлиент.ОткрытьОкноСИнструкциями(ЭтаФорма, Команда);
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьНаСогласование(Команда)
	
	Если ЭтаФорма.Модифицированность Тогда 
		Записать(); 
	КонецЕсли;
		  
	ЕстьСогласованиеВСтатусеОтличнымОтПланируется = Ложь;
	
	ДанныеЕсть = Ложь;
	Для Каждого Стр Из объект.Состояния Цикл
		Если ЭтоСогласование(Стр.Состояние) Тогда
			ДанныеЕсть = Истина;
	
			Если Стр.Статус <> ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Новый") Тогда
				ЕстьСогласованиеВСтатусеОтличнымОтПланируется = Истина;
			КонецЕсли;
	
		КонецЕсли;
	КонецЦикла;
	Если ДанныеЕсть = Ложь Тогда
		Сообщить("В таблице Состояния нет ни одного согласования!");
		Возврат;
	КонецЕсли;
    
	Если Не ЕстьСогласованиеВСтатусеОтличнымОтПланируется Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("ПСЦ не передан на согласование, необходимо выполнить предшествующие этапы");
		Возврат;
	КонецЕсли;
	
	//Если Не Объект.Типовой И НЕ ПроверкаНаПрикрепленные(Объект.Ссылка) Тогда
	//	Сообщить("Протокол является нетиповым! Прикрепите файлы!");
	//	Возврат;
	//КонецЕсли;

	ОповещениеОСогласовании = Новый ОписаниеОповещения("ОбработкаСогласования", ЭтаФорма);
	
	ТекПроцессСогл = ПечатьБухгалтерскихДокументов.ПроверитьНаличиеПроцесса(Объект.Ссылка);
	Если ТекПроцессСогл = ПредопределенноеЗначение("Справочник.ПроцессСогласования.ПустаяСсылка") Тогда
		ПараметрыФормы = Новый Структура("ДокументСогласования", Объект.Ссылка);
	Иначе
		ПараметрыФормы = Новый Структура("Ключ", ТекПроцессСогл);
	КонецЕсли;
	
	ОткрытьФорму("Справочник.ПроцессСогласования.ФормаОбъекта", ПараметрыФормы,ЭтаФорма, ЭтаФорма.УникальныйИдентификатор,,,ОповещениеОСогласовании, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаСогласования(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	ЭтаФорма.ОбновитьОтображениеДанных();
	ОбновитьБлокировкуЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыдатьНомерДокумента(Команда)
	
	Если ЗначениеЗаполнено(Объект.НомерПСЦ) Тогда
		Сообщить("Перед выдачей нового номера Протокола, предыдущий нужно очистить!");
		Возврат;
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Перед выдачей номера Протокола необходимо записать документ!");
		Возврат;
	КонецЕсли;  
	
	Отказ = Ложь;
	Если НЕ ЗначениеЗаполнено(Объект.ДатаПСЦ) Тогда Сообщить("Укажите дату ПСЦ!"); Отказ = Истина; КонецЕсли;
	
	Если Не Отказ Тогда	
		ОчереднойНомер = ПолучитьОчереднойДокумента(Объект.ДатаПСЦ, Объект.ВидУслугПоставщика, Объект.Ссылка);
		Объект.НомерПСЦ = ОчереднойНомер;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтозватьСогласование(Команда)
	
	ЕстьСверкиВПСЦПоставщиков = ПроверитьНаличиеСверокВПСЦПоставщиков(Объект.Ссылка);
	Если ЕстьСверкиВПСЦПоставщиков Тогда
		АдминистративныеПрава = ЕстьПолныеПрава();
		Если Не АдминистративныеПрава Тогда
			ПоказатьПредупреждение(, "Нормативные ставки этого протокола применены при проверке ставок Протоколов поставщиков! Отзыв согласования запрещен.",, "Отзыв согласования");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ОповещениеОбОтменеСогласования = Новый ОписаниеОповещения("ОтменаСогласования", ЭтаФорма);
	Если ЕстьСверкиВПСЦПоставщиков Тогда
		ТекстСообщения = "Внимание! Нормативные ставки этого протокола применены при проверке ставок Протоколов поставщиков!"
					+ Символы.ПС + "Протокол будет возвращен на этап ввода, а информация о результатах согласования стерта. Продолжить?";
	Иначе
		ТекстСообщения = "Протокол будет возвращен на этап ввода, а информация о результатах согласования стерта. Продолжить?";
	КонецЕсли;
	ПоказатьВопрос(ОповещениеОбОтменеСогласования, ТекстСообщения, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

