&НаСервере
Процедура ПересчетСтавкиЗаКМБезНДССервер(ТекДанные) //Евросиб Шевченко А.В. US 100317 TA 126448 22.12.2025
		
	Если ЗначениеЗаполнено(ТекДанные.СтоимостьБезНДС_КТК40) И ЗначениеЗаполнено(ТекДанные.Километраж) Тогда
		ТекДанные.СтавкаЗаКМ40FutБезНДС = ТекДанные.СтоимостьБезНДС_КТК40 / ТекДанные.Километраж;
	КонецЕсли;	
	Если ЗначениеЗаполнено(ТекДанные.СтоимостьБезНДС_КТК20) И ЗначениеЗаполнено(ТекДанные.Километраж) Тогда
		ТекДанные.СтавкаЗаКМ20FutБезНДС = ТекДанные.СтоимостьБезНДС_КТК20 / ТекДанные.Километраж	
	КонецЕсли;	
	
КонецПроцедуры

