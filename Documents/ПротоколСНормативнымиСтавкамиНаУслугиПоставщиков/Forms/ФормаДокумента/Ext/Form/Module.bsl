		ДобавленаСтрокаПоТипоразмерам = Ложь;
		Если ЗначениеЗаполнено(Стр.ТипоразмерКТК20) Или ЗначениеЗаполнено(Стр.СтоимостьБезНДС_КТК20) Или ЗначениеЗаполнено(Стр.СтоимостьСНДС_КТК20) Тогда			
			НоваяСтрока = ТаблицаТипоразмеровКТК.Добавить();
			НоваяСтрока.ИдентификаторСтрокиУслуг = Стр.ИдентификаторСтрокиУслуг;								
			НоваяСтрока.ТипоразмерКТК = Стр.ТипоразмерКТК20;
			НоваяСтрока.ТипоразмерВагона = ТипоразмерыТЕПустаяСсылка; //Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025
			НоваяСтрока.РазмерКТК = РазмерКТК20;
			НоваяСтрока.СтоимостьБезНДС = Стр.СтоимостьБезНДС_КТК20;
			НоваяСтрока.СтоимостьСНДС = Стр.СтоимостьСНДС_КТК20;
			Если Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Автоперевозки Тогда
				НоваяСтрока.СтоимостьСНДС = 0;
			КонецЕсли;	
			НоваяСтрока.СтавкаЗаКМ20FutБезНДС = Стр.СтавкаЗаКМ20FutБезНДС; //Евросиб Шевченко А.В. US 100317 TA 126448 22.12.2025
			ДобавленаСтрокаПоТипоразмерам = Истина;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.ТипоразмерКТК40) Или ЗначениеЗаполнено(Стр.СтоимостьБезНДС_КТК40) Или ЗначениеЗаполнено(Стр.СтоимостьСНДС_КТК40) Тогда			
			НоваяСтрока = ТаблицаТипоразмеровКТК.Добавить();
			НоваяСтрока.ИдентификаторСтрокиУслуг = Стр.ИдентификаторСтрокиУслуг;
			НоваяСтрока.ТипоразмерКТК = Стр.ТипоразмерКТК40;
			НоваяСтрока.ТипоразмерВагона = ТипоразмерыТСПустаяСсылка; //Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025
			НоваяСтрока.РазмерКТК = РазмерКТК40;
			НоваяСтрока.СтоимостьБезНДС = Стр.СтоимостьБезНДС_КТК40;
			НоваяСтрока.СтоимостьСНДС = Стр.СтоимостьСНДС_КТК40;
			Если Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Автоперевозки Тогда
				НоваяСтрока.СтоимостьСНДС = 0;
			КонецЕсли;
			НоваяСтрока.СтавкаЗаКМ40FutБезНДС = Стр.СтавкаЗаКМ40FutБезНДС; //Евросиб Шевченко А.В. US 100317 TA 126448 22.12.2025
			ДобавленаСтрокаПоТипоразмерам = Истина;
		КонецЕсли;
		
		//Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025
		Если (Стр.ТипоразмерыКТК.Количество() ИЛИ Стр.ТипоразмерыВагонов.Количество()) И (Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.ТЭО ИЛИ Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Вагоны) Тогда
			
			Для Каждого ЭлмТипоразмерыКТК из Стр.ТипоразмерыКТК Цикл
				НовСтрокаКТК = пТаблицаТипоразмеровКТК.Добавить();
				НовСтрокаКТК.ИдентификаторСтрокиУслуг = Стр.ИдентификаторСтрокиУслуг;;
				НовСтрокаКТК.ТипоразмерКТК = ЭлмТипоразмерыКТК.Значение;
			КонецЦикла;
			
			Для Каждого ЭлмТипоразмерыВагона из Стр.ТипоразмерыВагонов Цикл
				НовСтрокаВагоны = пТаблицаТипоразмеровВагона.Добавить();
				НовСтрокаВагоны.ИдентификаторСтрокиУслуг = Стр.ИдентификаторСтрокиУслуг;;
				НовСтрокаВагоны.ТипоразмерВагона = ЭлмТипоразмерыВагона.Значение;
			КонецЦикла;
			
			тЗапрос = Новый Запрос;
			тЗапрос.Текст = 
			"ВЫБРАТЬ
			|	&Иднтификатор КАК ИдентификаторСтрокиУслуг,
			|	&СтоимостьБезНДС КАК СтоимостьБезНДС
			|ПОМЕСТИТЬ ВТ_СтрокаУслуг
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТаблицаКТК.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
			|	ТаблицаКТК.ТипоразмерКТК КАК ТипоразмерКТК
			|ПОМЕСТИТЬ ВТ_Контейнеры
			|ИЗ
			|	&ТаблицаКТК КАК ТаблицаКТК
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТаблицаВыгоны.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
			|	ТаблицаВыгоны.ТипоразмерВагона КАК ТипоразмерВагона
			|ПОМЕСТИТЬ ВТ_Вагоны
			|ИЗ
			|	&ТаблицаВыгоны КАК ТаблицаВыгоны
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_СтрокаУслуг.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
			|	ВТ_СтрокаУслуг.СтоимостьБезНДС КАК СтоимостьБезНДС,
			|	ВТ_Контейнеры.ТипоразмерКТК КАК ТипоразмерКТК,
			|	ВТ_Вагоны.ТипоразмерВагона КАК ТипоразмерВагона
			|ИЗ
			|	ВТ_СтрокаУслуг КАК ВТ_СтрокаУслуг
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Контейнеры КАК ВТ_Контейнеры
			|		ПО ВТ_СтрокаУслуг.ИдентификаторСтрокиУслуг = ВТ_Контейнеры.ИдентификаторСтрокиУслуг
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Вагоны КАК ВТ_Вагоны
			|		ПО ВТ_СтрокаУслуг.ИдентификаторСтрокиУслуг = ВТ_Вагоны.ИдентификаторСтрокиУслуг";
			
			тЗапрос.УстановитьПараметр("Иднтификатор", Стр.ИдентификаторСтрокиУслуг);
			тЗапрос.УстановитьПараметр("СтоимостьБезНДС", Стр.СтоимостьБезНДС);
			тЗапрос.УстановитьПараметр("ТаблицаКТК", пТаблицаТипоразмеровКТК);
			тЗапрос.УстановитьПараметр("ТаблицаВыгоны", пТаблицаТипоразмеровВагона);
			
			тРезультатЗапроса = тЗапрос.Выполнить();
			
			тВыборкаДетальныеЗаписи = тРезультатЗапроса.Выбрать();
			
			Пока тВыборкаДетальныеЗаписи.Следующий() Цикл
				
				НоваяСтрока = ТаблицаТипоразмеровКТК.Добавить();
				НоваяСтрока.РазмерКТК = "";
				НоваяСтрока.ИдентификаторСтрокиУслуг = Стр.ИдентификаторСтрокиУслуг;
				НоваяСтрока.ТипоразмерКТК = тВыборкаДетальныеЗаписи.ТипоразмерКТК;
				НоваяСтрока.ТипоразмерВагона = тВыборкаДетальныеЗаписи.ТипоразмерВагона;
				НоваяСтрока.СтоимостьБезНДС = Стр.СтоимостьБезНДС;
				НоваяСтрока.СтоимостьСНДС = 0;
				НоваяСтрока.СтоимостьЗаСуткиБезНДС = Стр.СтоимостьЗаСуткиБезНДС;
				НоваяСтрока.СтавкаЗаКМ40FutБезНДС = 0; //Евросиб Шевченко А.В. US 100317 TA 126448 22.12.2025
				НоваяСтрока.СтавкаЗаКМ20FutБезНДС = 0; //Евросиб Шевченко А.В. US 100317 TA 126448 22.12.2025
				ДобавленаСтрокаПоТипоразмерам = Истина;
				
			КонецЦикла;
			
		КонецЕсли;
		//Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025
		
		Если НЕ ДобавленаСтрокаПоТипоразмерам Или ЗначениеЗаполнено(Стр.СтоимостьБезНДС) Или ЗначениеЗаполнено(Стр.СтоимостьСНДС) Или ЗначениеЗаполнено(Стр.СтоимостьЗаСуткиБезНДС) Тогда
			Если ДобавленаСтрокаПоТипоразмерам И (Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.ТЭО ИЛИ Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Вагоны) Тогда //Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025
			Иначе
				НоваяСтрока = ТаблицаТипоразмеровКТК.Добавить();
				НоваяСтрока.ИдентификаторСтрокиУслуг = Стр.ИдентификаторСтрокиУслуг;
				НоваяСтрока.РазмерКТК = "";
				НоваяСтрока.СтоимостьБезНДС = Стр.СтоимостьБезНДС;
				НоваяСтрока.СтоимостьСНДС = Стр.СтоимостьСНДС;
				Если Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Автоперевозки Тогда
					НоваяСтрока.СтоимостьСНДС = 0;
				КонецЕсли;
				НоваяСтрока.СтоимостьЗаСуткиБезНДС = Стр.СтоимостьЗаСуткиБезНДС;
			КонецЕсли;	
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ТаблицаПродуктов", ТаблицаПродуктов);
	Запрос.УстановитьПараметр("ТаблицаУчетныхНаправлений", ТаблицаУчетныхНаправлений);
	Запрос.УстановитьПараметр("ТаблицаТипоразмеровКТК", ТаблицаТипоразмеровКТК);
	Запрос.УстановитьПараметр("ТаблицаВидовОтправок", ТаблицаВидовОтправок); //Евросиб Шевченко А.В. US 115181 TA 115183 30.07.2025
	
	
	Запрос.УстановитьПараметр("ЛокацияПустаяСсылка", ЛокацияПустаяСсылка);
	Запрос.УстановитьПараметр("ТипИерархииГород", ТипИерархииГород);
	Запрос.УстановитьПараметр("ТипИерархииСтрана", ТипИерархииСтрана);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Объект.КритерииУслуг.Очистить();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.КритерииУслуг.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ЗначениеЗаполнено(ТекущийОбъект.НомерПСЦ) Тогда
		НомерПСЦУникален = Документы.ПротоколСНормативнымиСтавкамиНаУслугиПоставщиков.ПроверитьУникальностьНомераДокумента(ТекущийОбъект);
		Если Не НомерПСЦУникален Тогда
			ОбщегоНазначения.СообщитьПользователю("Уже есть Протокол нормативных ставок с таким Номером!",, "НомерПСЦ", "Объект", Отказ);
		КонецЕсли;
	Иначе
		ТекущийОбъект.НомерПСЦ = Документы.ПротоколСНормативнымиСтавкамиНаУслугиПоставщиков.ПолучитьОчереднойНомерДокумента(ТекущийОбъект.ДатаПСЦ, ТекущийОбъект.ВидУслугПоставщика, ТекущийОбъект.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ОбновитьБлокировкуЭлементов();
	
	ОбновитьПанельТекущегоПользователя();
	ОбновитьПанельСостояний();
	
	ОбновитьДинамическиеПоляТаблицыУслуг(, Истина);
	
КонецПроцедуры

#КонецОбласти

