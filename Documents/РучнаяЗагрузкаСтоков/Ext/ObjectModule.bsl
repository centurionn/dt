
#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Автор = Пользователи.ТекущийПользователь();
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
    
	Редактор = Пользователи.ТекущийПользователь();
	Изменено = ТекущаяДата();  
	ОбщееКоличествоКТК = ДанныеПоСтокам.Количество();
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;  

    Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Если Проведен Тогда
			Отказ = Истина;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя перепроводить документ! Все изменения следует выполнять, только через отмену проведения документа");
			Возврат;
		КонецЕсли;
	ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда	
		Если не Пользователи.РолиДоступны("АдминистраторСистемы",, Ложь) Тогда
			Отказ = Истина;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запись была проведена, корректировка не возможна. Для корректировки данных просим загрузить корректную информацию через инструмент «ручная загрузка стоков");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		ВыполнитьПроверкуПередПроведением(Отказ);				
		
	КонецЕсли
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Автор = Пользователи.ТекущийПользователь();
	Редактор = Неопределено;
	Изменено = Неопределено;
	ДанныеПоСтокамПредполагаемыйВывоз.Очистить();
	//ДИТ Шевченко А.В. 61437 08.12.22 //Добавил ВидТранспорта,НомерТранспорта,ФИОВодителя,НомерРелиза
	ДанныеПоСтокам.Загрузить(ОбъектКопирования.ДанныеПоСтокам.Выгрузить(,"Статус,ДатаВвозаВывоза,Контейнер,РазмерКТК,ТипКТК,ПодстокЛинияСобственника,Состояние,Поврежден,ВидТранспорта,НомерТранспорта,ФИОВодителя,НомерРелиза,Комментарий"));
КонецПроцедуры

//++ДИТ_Агафонов_task 52828 20.06.22
Процедура ОбработкаУдаленияПроведения(Отказ)
	ОчисткаРегистра();
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// ++ ДИТ_Агафонов_task 56318 04.09.2022
	Если ДанныеПоСтокам.Количество()=0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Нельзя проводить документ с незаполненными данными по стокам!");
		Отказ = Истина;	
	КонецЕсли;
	// -- ДИТ_Агафонов_task 56318 04.09.2022
	
	НачатьТранзакцию();
	
	ОчисткаРегистра();
	ТекДата = ТекущаяДата();
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	
	// ДИТ 65310 Давудов М.А. Начало: 16.02.2023
	Если ЗначениеЗаполнено(Терминал) Тогда
		КодТерминала = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Терминал, "ПредставлениеВCodeco");
	Иначе
		КодТерминала = "";
	КонецЕсли;
	// ДИТ 	 Давудов М.А. Конец: 16.02.2023
	
	Для каждого СтрокаЗагрузки Из ДанныеПоСтокам Цикл
		
		Если СтрокаЗагрузки.ПроверкаПоПредыдущимЗаписям = 5 
			ИЛИ
			СтрокаЗагрузки.ПроверкаПоПредыдущимЗаписям = 2
			Или (СтрокаЗагрузки.ПроверкаПоПредыдущимЗаписям=3 и СтрокаЗагрузки.РешениеПоПредыдущимЗаписям_3<>Перечисления.ВариантОтветаДаНет.Да) 
			Или (СтрокаЗагрузки.ПроверкаПоПредыдущимЗаписям=4 и СтрокаЗагрузки.РешениеПоПредыдущимЗаписям_4<>Перечисления.ВариантОтветаДаНет.Да) 
			Или (СтрокаЗагрузки.НетКарточкиКТК и СтрокаЗагрузки.ЗагружатьБезКарточкиКТК<>Перечисления.ВариантОтветаДаНет.Да)
			Или (СтрокаЗагрузки.ДругойТерминалАвто и СтрокаЗагрузки.РешениеПоДругомуТерминалу<>Перечисления.ВариантОтветаДаНет.Да) 
			Тогда
		    Продолжить;
		КонецЕсли;	
		
		МенеджерЗаписи = РегистрыСведений.ИнформацияОтТерминалов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Контейнер = СтрокаЗагрузки.КонтейнерСсылка;
		
		// ++ ДИТ_Агафонов_task 54348 15.07.2022
		//Если СтрокаЗагрузки.НетКарточкиКТК Тогда
		//	МенеджерЗаписи.НомерКонтейнера = СтрокаЗагрузки.Контейнер;
		//Иначе
		//	МенеджерЗаписи.НомерКонтейнера = "";
		//КонецЕсли;
		МенеджерЗаписи.НомерКонтейнера = СтрокаЗагрузки.Контейнер;
		// -- ДИТ_Агафонов_task 54348 15.07.2022
		
		Если СтрокаЗагрузки.ПроверкаПоПредыдущимЗаписям=3 Тогда
			МенеджерЗаписи.Период = СтрокаЗагрузки.ДатаВвозаВывоза2;
			МенеджерЗаписи.Прочитать();
		ИначеЕсли  СтрокаЗагрузки.ПроверкаПоПредыдущимЗаписям=4 Тогда
			МенеджерЗаписи.Период = СтрокаЗагрузки.ДатаВвозаВывоза1;
			МенеджерЗаписи.Прочитать();
		КонецЕсли;
		Если СтрокаЗагрузки.ПроверкаПоПредыдущимЗаписям=3 и ЗначениеЗаполнено(СтрокаЗагрузки.Статус2) Тогда
			МенеджерЗаписи.Период = СтрокаЗагрузки.ДатаВвозаВывоза;
		Иначе
			//ДИТ Шевченко А.В. 61437 08.12.22 //Добавил ВидТранспорта,НомерТранспорта,ФИОВодителя,НомерРелиза
			МенеджерЗаписи.Период = СтрокаЗагрузки.ДатаВвозаВывоза;
			//Евросиб Шевченко А.В. BUG 131012 TA 131013 20.03.2026
			Если СтрокаЗагрузки.ПроверкаПоПредыдущимЗаписям = 6 Тогда
				МенеджерЗаписи.Период = СтрокаЗагрузки.ДатаВвозаВывоза+1;
			КонецЕсли;	
			//Евросиб Шевченко А.В. BUG 131012 TA 131013 20.03.2026
			// ДИТ 65310 Давудов М.А. Начало: 16.02.2023
			МенеджерЗаписи.КодТерминала = КодТерминала;
			// ДИТ 65310 Давудов М.А. Конец: 16.02.2023
			МенеджерЗаписи.Терминал = Терминал;
			МенеджерЗаписи.Статус = СтрокаЗагрузки.Статус;
			МенеджерЗаписи.Подсток = СтрокаЗагрузки.ПодстокЛинияСобственника;
			МенеджерЗаписи.Состояние = СтрокаЗагрузки.Состояние;
			МенеджерЗаписи.Поврежден = СтрокаЗагрузки.Поврежден;
			МенеджерЗаписи.Транспорт = СтрокаЗагрузки.ВидТранспорта;
			МенеджерЗаписи.НомерТранспорта = СтрокаЗагрузки.НомерТранспорта;
			МенеджерЗаписи.ФИОВодителя = СтрокаЗагрузки.ФИОВодителя;
			МенеджерЗаписи.НомерРелиза = СтрокаЗагрузки.НомерРелиза;
			МенеджерЗаписи.Комментарий = СтрокаЗагрузки.Комментарий;
		КонецЕсли;	
		
		Если СтрокаЗагрузки.НеСовпадаетРазмерКТК или СтрокаЗагрузки.НеСовпадаетТипКТК Тогда
			Если СтрокаЗагрузки.ЗагружатьДругойТипоразмер = Перечисления.ВариантОтветаДаНет.Да Тогда
				Если ЗначениеЗаполнено(СтрокаЗагрузки.РазмерКТК) и СтрокаЗагрузки.НеСовпадаетРазмерКТК и ЗначениеЗаполнено(СтрокаЗагрузки.ТипКТК) и СтрокаЗагрузки.НеСовпадаетТипКТК Тогда
				//	МенеджерЗаписи.КомментарийКОшибке = "Рамер КТК и Тип КТК из поля ContSize и ContType не совпадает со значением в DC: контейнер <"+СтрокаЗагрузки.Контейнер+">";
					МенеджерЗаписи.РазмерКТК = СтрокаЗагрузки.РазмерКТК;
					МенеджерЗаписи.ТипКТК = СтрокаЗагрузки.ТипКТК;
				ИначеЕсли ЗначениеЗаполнено(СтрокаЗагрузки.РазмерКТК) и СтрокаЗагрузки.НеСовпадаетРазмерКТК Тогда 
					//МенеджерЗаписи.КомментарийКОшибке = "Рамер КТК из поля ContSize не совпадает со значением в DC: контейнер <"+СтрокаЗагрузки.Контейнер+">";
					МенеджерЗаписи.РазмерКТК = СтрокаЗагрузки.РазмерКТК;
					МенеджерЗаписи.ТипКТК = СтрокаЗагрузки.База_ТипКТК;
				ИначеЕсли ЗначениеЗаполнено(СтрокаЗагрузки.ТипКТК) и СтрокаЗагрузки.НеСовпадаетТипКТК Тогда
					//МенеджерЗаписи.КомментарийКОшибке = "Тип КТК из поля ContType не совпадает со значением в DC: контейнер <"+СтрокаЗагрузки.Контейнер+">";
					МенеджерЗаписи.ТипКТК = СтрокаЗагрузки.ТипКТК;
					МенеджерЗаписи.РазмерКТК = СтрокаЗагрузки.База_РазмерКТК;
				Иначе
					МенеджерЗаписи.ТипКТК = СтрокаЗагрузки.База_ТипКТК;
					МенеджерЗаписи.РазмерКТК = СтрокаЗагрузки.База_РазмерКТК;
				КонецЕсли;
			ИначеЕсли СтрокаЗагрузки.ПроверкаПоПредыдущимЗаписям = 1 Тогда 
				МенеджерЗаписи.ТипКТК = СтрокаЗагрузки.База_ТипКТК;
				МенеджерЗаписи.РазмерКТК = СтрокаЗагрузки.База_РазмерКТК;
			КонецЕсли;
		Иначе
			МенеджерЗаписи.РазмерКТК = СтрокаЗагрузки.РазмерКТК;
			МенеджерЗаписи.ТипКТК = СтрокаЗагрузки.ТипКТК;
			//Если Не ЗначениеЗаполнено(СтрокаЗагрузки.ТипКТК_DC) и СтрокаЗагрузки.НетКарточкиКТК=Ложь Тогда
			//	Если ЗначениеЗаполнено(СтрокаЗагрузки.РазмерКТК) и ЗначениеЗаполнено(СтрокаЗагрузки.ТипКТК) Тогда
			//		МенеджерЗаписи.КомментарийКОшибке= "Не удалось сравнить размер КТК и тип КТК из поля ContSize и ContType со значением в DC: в найденном контейнере не указан типоразмер";
			//	ИначеЕсли ЗначениеЗаполнено(СтрокаЗагрузки.РазмерКТК) Тогда
			//		МенеджерЗаписи.КомментарийКОшибке= "Не удалось сравнить размер КТК из поля ContSize со значением в DC: в найденном контейнере не указан типоразмер";
			//	ИначеЕсли ЗначениеЗаполнено(СтрокаЗагрузки.ТипКТК) Тогда
			//		МенеджерЗаписи.КомментарийКОшибке= "Не удалось сравнить тип КТК из поля ContType со значением в DC: в найденном контейнере не указан типоразмер";
			//	КонецЕсли;
			//КонецЕсли;
		КонецЕсли;

		МенеджерЗаписи.ДатаВнесенияДанных = ТекДата;
		МенеджерЗаписи.ФИОСотрудникаЕвросиб = ТекПользователь;
		МенеджерЗаписи.ТипИсточникаИнформации = Терминал.ТипПодрядчика;
		МенеджерЗаписи.СпособВнесенияДанных = Перечисления.СпособыВнесенияДанныхТерминал.Ручной;
		Если СтрокаЗагрузки.ПроверкаПоПредыдущимЗаписям=4
			или СтрокаЗагрузки.ПроверкаПоПредыдущимЗаписям=3 и ЗначениеЗаполнено(СтрокаЗагрузки.Статус2) Тогда
		Иначе	
			МенеджерЗаписи.РегистраторЗагрузка = Ссылка;
		КонецЕсли;

		Если СтрокаЗагрузки.НетКарточкиКТК и СтрокаЗагрузки.ЗагружатьБезКарточкиКТК=Перечисления.ВариантОтветаДаНет.Да Тогда
			МенеджерЗаписи.НомерКонтейнера = СтрокаЗагрузки.Контейнер;
			МенеджерЗаписи.Контейнер = Неопределено;
			МенеджерЗаписи.Ошибка = Истина;
			//МенеджерЗаписи.КомментарийКОшибке = "указан номер контейнера <"+СтрокаЗагрузки.Контейнер+">, которого нет в справочнике DataCore";
		КонецЕсли;	
		
		МенеджерЗаписи.Записать();	
		
		// ДИТ 65310 Давудов М.А. Начало: 16.02.2023
		СоответствиеТерминаловКодам = Новый Соответствие;
		// ДИТ 65310 Давудов М.А. Конец: 16.02.2023
		
		Если СтрокаЗагрузки.ДругойТерминалРучн и СтрокаЗагрузки.РешениеПоДругомуТерминалу=Перечисления.ВариантОтветаДаНет.Да Тогда
		
			МенеджерЗаписи = РегистрыСведений.ИнформацияОтТерминалов.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Период = СтрокаЗагрузки.ДатаВвозаВывоза4;
			МенеджерЗаписи.Контейнер = СтрокаЗагрузки.КонтейнерСсылка;
            //ДИТ Шевченко А.В. 61437 08.12.22 //Добавил ВидТранспорта,НомерТранспорта,ФИОВодителя,НомерРелиза
			// ДИТ 65310 Давудов М.А. Начало: 16.02.2023
			Если ЗначениеЗаполнено(СтрокаЗагрузки.Терминал4) Тогда
				Если СоответствиеТерминаловКодам.Получить(СтрокаЗагрузки.Терминал4) = Неопределено Тогда
					КодТерминала4 = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаЗагрузки.Терминал4, "ПредставлениеВCodeco");
					СоответствиеТерминаловКодам.Вставить(СтрокаЗагрузки.Терминал4, КодТерминала);
				Иначе
					КодТерминала = СоответствиеТерминаловКодам.Получить(СтрокаЗагрузки.Терминал4);
				КонецЕсли;
			Иначе
				КодТерминала4 = "";
			КонецЕсли;
			МенеджерЗаписи.КодТерминала = КодТерминала4;
			// ДИТ 65310 Давудов М.А. Конец: 16.02.2023
			МенеджерЗаписи.Терминал = СтрокаЗагрузки.Терминал4;
			МенеджерЗаписи.Статус = СтрокаЗагрузки.Статус4;
			МенеджерЗаписи.Подсток = СтрокаЗагрузки.ПодстокЛинияСобственника4;
			МенеджерЗаписи.Состояние = СтрокаЗагрузки.Состояние4;
			МенеджерЗаписи.Поврежден = СтрокаЗагрузки.Поврежден4;
			МенеджерЗаписи.Транспорт = СтрокаЗагрузки.ВидТранспорта4;
			МенеджерЗаписи.НомерТранспорта = СтрокаЗагрузки.НомерТранспорта4;
			МенеджерЗаписи.ФИОВодителя = СтрокаЗагрузки.ФИОВодителя4;
			МенеджерЗаписи.НомерРелиза = СтрокаЗагрузки.НомерРелиза4;
			МенеджерЗаписи.Комментарий = СтрокаЗагрузки.Комментарий4;
			МенеджерЗаписи.РазмерКТК = СтрокаЗагрузки.РазмерКТК4;
			МенеджерЗаписи.ТипКТК = СтрокаЗагрузки.ТипКТК4;

			МенеджерЗаписи.ДатаВнесенияДанных = ТекДата;
			МенеджерЗаписи.ФИОСотрудникаЕвросиб = ТекПользователь;
			МенеджерЗаписи.ТипИсточникаИнформации = Терминал.ТипПодрядчика;
			МенеджерЗаписи.СпособВнесенияДанных = Перечисления.СпособыВнесенияДанныхТерминал.Ручной;
			МенеджерЗаписи.РегистраторЗагрузка = Ссылка;

			МенеджерЗаписи.НомерКонтейнера = СтрокаЗагрузки.Контейнер;
			
			Если СтрокаЗагрузки.НетКарточкиКТК Тогда
				МенеджерЗаписи.Контейнер = Неопределено;
				МенеджерЗаписи.Ошибка = Истина;
				//МенеджерЗаписи.КомментарийКОшибке = "указан номер контейнера <"+СтрокаЗагрузки.Контейнер+">, которого нет в справочнике DataCore";
			КонецЕсли;
			
		МенеджерЗаписи.Записать();
		
		КонецЕсли;
	КонецЦикла;
	
	Для каждого СтрокаВывоза Из ДанныеПоСтокамПредполагаемыйВывоз Цикл
		Если СтрокаВывоза.РешениеПоВывозу <> Перечисления.ВариантОтветаДаНет.Да Тогда
			Продолжить;
		КонецЕсли;
		
		МенеджерЗаписи = РегистрыСведений.ИнформацияОтТерминалов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период = СтрокаВывоза.ДатаВвозаВывоза1;
		МенеджерЗаписи.Контейнер = СтрокаВывоза.КонтейнерСсылка;
        //ДИТ Шевченко А.В. 61437 08.12.22 //Добавил ВидТранспорта,НомерТранспорта,ФИОВодителя,НомерРелиза
		// ДИТ 65310 Давудов М.А. Начало: 16.02.2023
		МенеджерЗаписи.КодТерминала = КодТерминала;
		// ДИТ 65310 Давудов М.А. Конец: 16.02.2023
		МенеджерЗаписи.Терминал = Терминал;
		МенеджерЗаписи.Статус = СтрокаВывоза.Статус1;
		МенеджерЗаписи.Подсток = СтрокаВывоза.ПодстокЛинияСобственника1;
		МенеджерЗаписи.Состояние = СтрокаВывоза.Состояние1;
		МенеджерЗаписи.Поврежден = СтрокаВывоза.Поврежден1;
		МенеджерЗаписи.Транспорт = СтрокаВывоза.ВидТранспорта1;
		МенеджерЗаписи.НомерТранспорта = СтрокаВывоза.НомерТранспорта1;
		МенеджерЗаписи.ФИОВодителя = СтрокаВывоза.ФИОВодителя1;
		МенеджерЗаписи.НомерРелиза = СтрокаВывоза.НомерРелиза1;
		МенеджерЗаписи.Комментарий = СтрокаВывоза.Комментарий1;
		МенеджерЗаписи.РазмерКТК = СтрокаВывоза.РазмерКТК1;
		МенеджерЗаписи.ТипКТК = СтрокаВывоза.ТипКТК1;

		МенеджерЗаписи.ДатаВнесенияДанных = ТекДата;
		МенеджерЗаписи.ФИОСотрудникаЕвросиб = ТекПользователь;
		МенеджерЗаписи.ТипИсточникаИнформации = Терминал.ТипПодрядчика;
		МенеджерЗаписи.СпособВнесенияДанных = Перечисления.СпособыВнесенияДанныхТерминал.Ручной;
		МенеджерЗаписи.РегистраторЗагрузка = Ссылка;

		МенеджерЗаписи.НомерКонтейнера = СтрокаВывоза.Контейнер;
		
		Если СтрокаВывоза.НетКарточкиКТК Тогда
			МенеджерЗаписи.Контейнер = Неопределено;
			МенеджерЗаписи.Ошибка = Истина;
			//МенеджерЗаписи.КомментарийКОшибке = "указан номер контейнера <"+СтрокаВывоза.Контейнер+">, которого нет в справочнике DataCore";
		КонецЕсли;
		
		МенеджерЗаписи.Записать();
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
	Если ЗначениеЗаполнено(ПоследнееСообщениеОбОшибке) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ПоследнееСообщениеОбОшибке);
	КонецЕсли;
	
КонецПроцедуры
