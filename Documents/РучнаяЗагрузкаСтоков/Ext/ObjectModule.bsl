#КонецОбласти

//++ДИТ_Агафонов_task 52828 17.06.22
Процедура ВыполнитьПроверкуПередПроведением(Отказ = Ложь, ВсегдаСообщать = ложь) Экспорт
	
	СообщениеОбОшибке = "";
	
	ТЗ_ДанныеПоСтокам = ДанныеПоСтокам.Выгрузить();
	ЗначениеНЕТ = Перечисления.ВариантОтветаДаНет.Нет;
	ЗначениеДА = Перечисления.ВариантОтветаДаНет.Да;
	
	#Область ПроверкаСоответствияПодстокЛинияСобственникаТерминалу
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗагрузкаДанныхПоСтокамДанныеПоСтокам.НомерСтроки КАК НомерСтроки,
	               |	&Терминал КАК Терминал,
	               |	ЗагрузкаДанныхПоСтокамДанныеПоСтокам.ПодстокЛинияСобственника КАК ПодстокЛинияСобственника
	               |ПОМЕСТИТЬ ТаблицаДанныеПоСтокам
	               |ИЗ
	               |	&ЗагрузкаДанныхПоСтокамДанныеПоСтокам КАК ЗагрузкаДанныхПоСтокамДанныеПоСтокам
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаДанныеПоСтокам.НомерСтроки КАК НомерСтроки,
	               |	ТаблицаДанныеПоСтокам.Терминал КАК Терминал,
	               |	ТаблицаДанныеПоСтокам.ПодстокЛинияСобственника КАК ПодстокЛинияСобственника,
	               |	ПодстокиКонтейнеров.НаименованиеПодстока КАК НаименованиеПодстока,
	               |	ТаблицаДанныеПоСтокам.ПодстокЛинияСобственника <> """"
	               |		И ПодстокиКонтейнеров.НаименованиеПодстока ЕСТЬ NULL КАК НеверныйПодсток
	               |ИЗ
	               |	ТаблицаДанныеПоСтокам КАК ТаблицаДанныеПоСтокам
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПодстокиКонтейнеров КАК ПодстокиКонтейнеров
	               |		ПО ТаблицаДанныеПоСтокам.Терминал = ПодстокиКонтейнеров.Локация
	               |			И ТаблицаДанныеПоСтокам.ПодстокЛинияСобственника = ПодстокиКонтейнеров.НаименованиеПодстока
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки";
	
	Запрос.УстановитьПараметр("ЗагрузкаДанныхПоСтокамДанныеПоСтокам", ТЗ_ДанныеПоСтокам);
	Запрос.УстановитьПараметр("Терминал", Терминал);
	
	Результат = Запрос.Выполнить().Выгрузить();
	ДанныеПоСтокам.ЗагрузитьКолонку(Результат.ВыгрузитьКолонку("НеверныйПодсток"),"НеверныйПодсток");
	//ДанныеПоСтокам.ЗагрузитьКолонку(Результат.ВыгрузитьКолонку("НеверныйПодсток"),"ЕстьПроблема");
	СтрокиОшибка = Результат.НайтиСтроки(Новый Структура("НеверныйПодсток",Истина));
	Если СтрокиОшибка.Количество()>0 Тогда
		//Отказ = Истина;
		СообщениеОбОшибке = СообщениеОбОшибке +?(ЗначениеЗаполнено(СообщениеОбОшибке),Символы.ПС,"")+"Не верный подсток в строках: ";
		Для каждого СтрокаОшибки Из СтрокиОшибка Цикл
			СообщениеОбОшибке = СообщениеОбОшибке + СтрокаОшибки.НомерСтроки+";"; 
		КонецЦикла;
	КонецЕсли;
	#КонецОбласти

	#Область ПроверкаКонтейнера
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗагрузкаДанныхПоСтокамДанныеПоСтокам.НомерСтроки КАК НомерСтроки,
	               |	ЗагрузкаДанныхПоСтокамДанныеПоСтокам.Контейнер КАК Контейнер,
	               |	ЗагрузкаДанныхПоСтокамДанныеПоСтокам.РазмерКТК КАК РазмерКТК,
	               |	ЗагрузкаДанныхПоСтокамДанныеПоСтокам.ТипКТК КАК ТипКТК
	               |ПОМЕСТИТЬ ТаблицаДанныеПоСтокам
	               |ИЗ
	               |	&ЗагрузкаДанныхПоСтокамДанныеПоСтокам КАК ЗагрузкаДанныхПоСтокамДанныеПоСтокам
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаДанныеПоСтокам.НомерСтроки КАК НомерСтроки,
	               |	ТаблицаДанныеПоСтокам.Контейнер КАК Контейнер,
	               |	ТаблицаДанныеПоСтокам.РазмерКТК КАК РазмерКТК,
	               |	ТаблицаДанныеПоСтокам.ТипКТК КАК ТипКТК,
	               |	ВложенныйЗапрос.КонтейнерСсылка КАК КонтейнерСсылка,
	               |	ВложенныйЗапрос.КонтейнерСсылка.ТипТЕ КАК ТипТЕСсылка,
	               |	ISNULL(ВложенныйЗапрос.КонтейнерСсылка.ТипТЕ.Наименование,"""") КАК База_ТипТЕНаименование,
	               |	ВложенныйЗапрос.КонтейнерСсылка.ТипТЕ.РазмерКТК КАК РазмерКТКСсылка,
	               |	ISNULL(ВложенныйЗапрос.КонтейнерСсылка.ТипТЕ.РазмерКТК.Наименование,"""") КАК База_РазмерКТКНаименование,
	               |	ISNULL(ВложенныйЗапрос.КонтейнерСсылка.ТипТЕ.РазмерКТК.Размер, 0) КАК База_РазмерКТКЧисло
	               |ИЗ
	               |	ТаблицаДанныеПоСтокам КАК ТаблицаДанныеПоСтокам
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ТЕ.Наименование КАК КонтейнерНаименование,
	               |			МАКСИМУМ(ТЕ.Ссылка) КАК КонтейнерСсылка
	               |		ИЗ
	               |			Справочник.ТЕ КАК ТЕ
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ТЕ.Наименование) КАК ВложенныйЗапрос
	               |		ПО ТаблицаДанныеПоСтокам.Контейнер = ВложенныйЗапрос.КонтейнерНаименование
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки";
	
	Запрос.УстановитьПараметр("ЗагрузкаДанныхПоСтокамДанныеПоСтокам", ТЗ_ДанныеПоСтокам);
	
	Результат = Запрос.Выполнить().Выгрузить();
	ДанныеПоСтокам.ЗагрузитьКолонку(Результат.ВыгрузитьКолонку("КонтейнерСсылка"),"КонтейнерСсылка");
	
	СписокСтрокНеКорректныйНомерКТК = ""; 
	СписокСтрокЗагружатьБезКарточкиКТК = ""; 
	СписокСтрокЗагружатьДругойТипоразмер = ""; 
		
	Для каждого СтрокаРезультат Из Результат Цикл
		
		ДанныеПоСтокамСтрокаОбхода = ДанныеПоСтокам[СтрокаРезультат.НомерСтроки-1]; 
		
		Если СтрокаРезультат.КонтейнерСсылка = NULL  Тогда
			
			ДанныеПоСтокамСтрокаОбхода.НетКарточкиКТК = Истина;
			ДанныеПоСтокамСтрокаОбхода.НеСовпадаетТипоразмер = Ложь;
			ДанныеПоСтокамСтрокаОбхода.НеСовпадаетРазмерКТК = Ложь;
			ДанныеПоСтокамСтрокаОбхода.НеСовпадаетТипКТК = Ложь;
			ДанныеПоСтокамСтрокаОбхода.ЗагружатьДругойТипоразмер = Неопределено; 
			
			Попытка
				РасчетноеКонтрольноеЧисло = РаботаСКонтейнерамиСервер.ПолучитьКонтрольноеЧисло(Лев(СтрокаРезультат.Контейнер,4), Сред(СтрокаРезультат.Контейнер,5,6));
				КонтрольноеЧислоПользователя = Прав(СтрокаРезультат.Контейнер,1);  
			Исключение
				РасчетноеКонтрольноеЧисло = "Неверно";
			КонецПопытки;
			
			Если РасчетноеКонтрольноеЧисло = "Неверно" Тогда
				ДанныеПоСтокамСтрокаОбхода.НеКорректныйНомерКТК = Истина;
				ДанныеПоСтокамСтрокаОбхода.НеКорректныйКонтрольныйСимвол = Ложь;
				ДанныеПоСтокамСтрокаОбхода.ЗагружатьБезКарточкиКТК = ЗначениеНЕТ;
				СписокСтрокНеКорректныйНомерКТК = СписокСтрокНеКорректныйНомерКТК+СтрокаРезультат.НомерСтроки+";";
			Иначе	
				ДанныеПоСтокамСтрокаОбхода.НеКорректныйНомерКТК = Ложь;
				ДанныеПоСтокамСтрокаОбхода.НеКорректныйКонтрольныйСимвол = (РасчетноеКонтрольноеЧисло <> КонтрольноеЧислоПользователя);
				Если Не ЗначениеЗаполнено(ДанныеПоСтокамСтрокаОбхода.ЗагружатьБезКарточкиКТК) Тогда
					ДанныеПоСтокамСтрокаОбхода.ЕстьПроблема = Истина;
					СписокСтрокЗагружатьБезКарточкиКТК = СписокСтрокЗагружатьБезКарточкиКТК+СтрокаРезультат.НомерСтроки+";";
				КонецЕсли;  
			КонецЕсли;      
			
		Иначе
			ДанныеПоСтокамСтрокаОбхода.НетКарточкиКТК = Ложь;
			ДанныеПоСтокамСтрокаОбхода.НеКорректныйНомерКТК = Ложь;
			ДанныеПоСтокамСтрокаОбхода.НеКорректныйКонтрольныйСимвол = Ложь;
			ДанныеПоСтокамСтрокаОбхода.ЗагружатьБезКарточкиКТК = Неопределено;
			
			ДанныеПоСтокамСтрокаОбхода.НеСовпадаетТипоразмер = Ложь;
			ДанныеПоСтокамСтрокаОбхода.НеСовпадаетРазмерКТК = Ложь;
			ДанныеПоСтокамСтрокаОбхода.НеСовпадаетРазмерКТК = Ложь;

			ДанныеПоСтокамСтрокаОбхода.ТипКТК_DC = СтрокаРезультат.База_ТипТЕНаименование;
			
			Если ЗначениеЗаполнено(СтрокаРезультат.База_ТипТЕНаименование) Тогда
				//База_РазмерКТК=Формат(СтрокаРезультат.База_РазмерКТКЧисло,"ЧГ=0");
				База_РазмерКТК=СтрокаРезультат.База_РазмерКТКНаименование;
				Если ЗначениеЗаполнено(СтрокаРезультат.РазмерКТК) и СтрокаРезультат.РазмерКТК<>База_РазмерКТК Тогда
					ДанныеПоСтокамСтрокаОбхода.НеСовпадаетРазмерКТК = Истина;
					ДанныеПоСтокамСтрокаОбхода.НеСовпадаетТипоразмер = Истина;	
				КонецЕсли;
				
				Попытка
					База_ТипКТК = Сред(СтрокаРезультат.База_ТипТЕНаименование,СтрДлина(База_РазмерКТК)+1);
				Исключение
					База_ТипКТК = "";
				КонецПопытки;
				Если ЗначениеЗаполнено(СтрокаРезультат.ТипКТК) и СтрокаРезультат.ТипКТК<>База_ТипКТК Тогда
					ДанныеПоСтокамСтрокаОбхода.НеСовпадаетТипКТК = Истина;
					ДанныеПоСтокамСтрокаОбхода.НеСовпадаетТипоразмер = Истина;
				КонецЕсли;
				Если (ДанныеПоСтокамСтрокаОбхода.НеСовпадаетРазмерКТК или ДанныеПоСтокамСтрокаОбхода.НеСовпадаетТипКТК) 
					и не ЗначениеЗаполнено(ДанныеПоСтокамСтрокаОбхода.ЗагружатьДругойТипоразмер) Тогда
					ДанныеПоСтокамСтрокаОбхода.ЕстьПроблема = Истина;	
					СписокСтрокЗагружатьДругойТипоразмер = СписокСтрокЗагружатьДругойТипоразмер+СтрокаРезультат.НомерСтроки+";";
				КонецЕсли;
				ДанныеПоСтокамСтрокаОбхода.База_РазмерКТК = База_РазмерКТК;
				ДанныеПоСтокамСтрокаОбхода.База_ТипКТК = База_ТипКТК;
			Иначе
				ДанныеПоСтокамСтрокаОбхода.НеСовпадаетТипоразмер = Ложь;
				ДанныеПоСтокамСтрокаОбхода.НеСовпадаетРазмерКТК = Ложь;
				ДанныеПоСтокамСтрокаОбхода.НеСовпадаетТипКТК = Ложь;
				ДанныеПоСтокамСтрокаОбхода.ЗагружатьДругойТипоразмер = Неопределено;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(СписокСтрокЗагружатьБезКарточкиКТК) Тогда
		СообщениеОбОшибке = СообщениеОбОшибке +?(ЗначениеЗаполнено(СообщениеОбОшибке),Символы.ПС,"")+"Не найдена карточка КТК в системе! Требуется решение по строкам: ";
		СообщениеОбОшибке = СообщениеОбОшибке + СписокСтрокЗагружатьБезКарточкиКТК;
		Отказ = Истина;
	КонецЕсли;                                                                                           		

	Если ЗначениеЗаполнено(СписокСтрокНеКорректныйНомерКТК) Тогда
		СообщениеОбОшибке = СообщениеОбОшибке +?(ЗначениеЗаполнено(СообщениеОбОшибке),Символы.ПС,"")+"Не корректный номер контейнера! Не будут загружены данные по строкам: ";
		СообщениеОбОшибке = СообщениеОбОшибке + СписокСтрокНеКорректныйНомерКТК;
	КонецЕсли;                                                                                           		
	
	Если ЗначениеЗаполнено(СписокСтрокЗагружатьДругойТипоразмер) Тогда
		СообщениеОбОшибке = СообщениеОбОшибке +?(ЗначениеЗаполнено(СообщениеОбОшибке),Символы.ПС,"")+"Отличается типоразмер в карточке КТК! Требуется решение по строкам: ";
		СообщениеОбОшибке = СообщениеОбОшибке + СписокСтрокЗагружатьДругойТипоразмер;
		Отказ = Истина;
	КонецЕсли;                                                                                           		
	
	#КонецОбласти                                                                                                                                      

	#Область ПроверкаПредыдущихЗаписей
	
	//ДИТ Шевченко А.В. 61437 08.12.22 //Добавил в запрос ВидТранспорта,НомерТранспорта,ФИОВодителя,НомерРелиза
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗагрузкаДанныхПоСтокамДанныеПоСтокам.НомерСтроки КАК НомерСтроки,
	               |	ЗагрузкаДанныхПоСтокамДанныеПоСтокам.КонтейнерСсылка КАК Контейнер,
	               |	ЗагрузкаДанныхПоСтокамДанныеПоСтокам.Контейнер КАК НомерКонтейнера,
	               |	ЗагрузкаДанныхПоСтокамДанныеПоСтокам.НетКарточкиКТК КАК НетКарточкиКТК,
	               |	ЗагрузкаДанныхПоСтокамДанныеПоСтокам.ДатаВвозаВывоза КАК ДатаВвозаВывоза,
	               |	ЗагрузкаДанныхПоСтокамДанныеПоСтокам.Состояние КАК Состояние
	               |ПОМЕСТИТЬ ТаблицаДанныеПоСтокам
	               |ИЗ
	               |	&ЗагрузкаДанныхПоСтокамДанныеПоСтокам КАК ЗагрузкаДанныхПоСтокамДанныеПоСтокам
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВложенныйЗапрос.НомерСтроки КАК НомерСтроки,
	               |	ВложенныйЗапрос.Контейнер КАК Контейнер,
