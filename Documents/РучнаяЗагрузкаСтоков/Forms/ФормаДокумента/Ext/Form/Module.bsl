#Область ОбработчикиКомандФормы    

&НаКлиенте
Процедура ЗагрузитьКТКИзExcel(Команда)  
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗагрузитьКТКИзExcelЗавершение", ЭтаФорма);
	ОткрытьФорму("Документ.РучнаяЗагрузкаСтоков.Форма.ВставкаИзБуфераОбмена",Новый Структура("Терминал", Объект.Терминал),,ЭтаФорма.УникальныйИдентификатор,,,
							ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры 
						
&НаКлиенте
Процедура ЗагрузитьКТКИзExcelЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> Неопределено И ТипЗнч(Результат) = Тип("Структура") Тогда
		Объект.Терминал = Результат.Терминал;
		Для Каждого СтрМассива Из Результат.МассивСтрок Цикл 
			НС = Объект.ДанныеПоСтокам.Добавить();
			ЗаполнитьЗначенияСвойств(НС, СтрМассива);  
			Если СтрМассива.ПодстокЛинияСобственникаОшибка Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Неверное наименование подстока (линии собственника)");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИнформациюПоСтокам(Команда)
 
	ПроверитьИнформациюПоСтокамСервер();	
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьИнформациюПоСтокамСервер()
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ВыполнитьПроверкуПередПроведением(,Истина);
    ЗначениеВРеквизитФормы(ДокументОбъект,"Объект");
КонецПроцедуры

&НаКлиенте
Процедура НетКарточкиКТК_Загружать(Команда)
	ЗначениеДляЗаполнения = ?(Команда.Имя = "НетКарточкиКТК_ЗагружатьДА",ЗначениеДа,ЗначениеНет);
	Для каждого ТекСтрока Из Объект.ДанныеПоСтокам Цикл
		Если ТекСтрока.НетКарточкиКТК и Не ТекСтрока.НеКорректныйНомерКТК Тогда
			ТекСтрока.ЗагружатьБезКарточкиКТК = ЗначениеДляЗаполнения;
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура НеКорректныйТипоразмер_Загружать(Команда)
	ЗначениеДляЗаполнения = ?(Команда.Имя = "НеКорректныйТипоразмер_ЗагружатьДА",ЗначениеДа,ЗначениеНет);
	Для каждого ТекСтрока Из Объект.ДанныеПоСтокам Цикл
		Если ТекСтрока.НеСовпадаетРазмерКТК или ТекСтрока.НеСовпадаетТипКТК Тогда
			ТекСтрока.ЗагружатьДругойТипоразмер = ЗначениеДляЗаполнения;
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ПредыдущаяЗаписьВозврат_Загружать(Команда)
	ЗначениеДляЗаполнения = ?(Команда.Имя = "ПредыдущаяЗаписьВозврат_ЗагружатьДА",ЗначениеДа,ЗначениеНет);
	Для каждого ТекСтрока Из Объект.ДанныеПоСтокам Цикл
		Если ТекСтрока.ПроверкаПоПредыдущимЗаписям = 3 и ТекСтрока.Терминал2=Объект.Терминал Тогда
			ТекСтрока.РешениеПоПредыдущимЗаписям_3 = ЗначениеДляЗаполнения;
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ПредыдущаяЗаписьЗавоз_Загружать(Команда)
	ЗначениеДляЗаполнения = ?(Команда.Имя = "ПредыдущаяЗаписьЗавоз_ЗагружатьДА",ЗначениеДа,ЗначениеНет);
	Для каждого ТекСтрока Из Объект.ДанныеПоСтокам Цикл
		Если ТекСтрока.ПроверкаПоПредыдущимЗаписям = 4 Тогда
		ТекСтрока.РешениеПоПредыдущимЗаписям_4 = ЗначениеДляЗаполнения;
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура РешениеПоВывозу(Команда)
	ЗначениеДляЗаполнения = ?(Команда.Имя = "РешениеПоВывозу_ДА",ЗначениеДа,ЗначениеНет);
	Для каждого ТекСтрока Из Объект.ДанныеПоСтокамПредполагаемыйВывоз Цикл
