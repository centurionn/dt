
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УстановитьУсловноеОформление();	
	Если объект.Проведен и не Пользователи.РолиДоступны("АдминистраторСистемы",, Ложь) Тогда
		ЭтаФорма.Элементы.ДанныеПоСтокамПроверка.ТолькоПросмотр = Истина;
		ЭтаФорма.Элементы.ДанныеПоСтокамПроверкаТипоразмера.ТолькоПросмотр = Истина;
		ЭтаФорма.Элементы.ДанныеПоСтокамПредыдущаяЗаписьВозврат.ТолькоПросмотр = Истина;
		ЭтаФорма.Элементы.ДанныеПоСтокамПредыдущаяЗаписьЗавоз.ТолькоПросмотр = Истина;
		ЭтаФорма.Элементы.ДанныеПоСтокамРешениеПоДругомуТерминалуАвто.ТолькоПросмотр = Истина;
		ЭтаФорма.Элементы.ДанныеПоСтокамРешениеПоДругомуТерминалуРучн.ТолькоПросмотр = Истина;
		
		//Евросиб Коханенко Н.А. 12.11.2024 (( #95370
		//у кнопки нет свойства ТолькоПросмотр
		//ЭтаФорма.Элементы.ДанныеПоСтокамЗагрузитьКТКИзExcel.ТолькоПросмотр = Истина;
		ЭтаФорма.Элементы.ДанныеПоСтокамЗагрузитьКТКИзExcel.Доступность = Ложь;
	    //Евросиб Коханенко Н.А. 12.11.2024 )) #95370 
	КонецЕсли;
	
	ЭтаФорма.ЗначениеДа = Перечисления.ВариантОтветаДаНет.Да;
	ЭтаФорма.ЗначениеНет = Перечисления.ВариантОтветаДаНет.Нет;
	
	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры   

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ТекДанные = Элементы.ДанныеПоСтокам.ТекущиеДанные;
	Если ТекДанные <> Неопределено И ЗначениеЗаполнено(ТекДанные.РазмерКТК) Тогда     
		МассивТиповКТК = ПолучитьМассивТиповКТК(ТекДанные.РазмерКТК);
		Элементы.ДанныеПоСтокамТипКТК.СписокВыбора.ЗагрузитьЗначения(МассивТиповКТК); 
	КонецЕсли;
	ЭтаФорма.Элементы.ДанныеПоСтокамПроверка.ОтборСтрок = Новый ФиксированнаяСтруктура("НетКарточкиКТК", Истина); 
	ЭтаФорма.Элементы.ДанныеПоСтокамПроверкаТипоразмера.ОтборСтрок = Новый ФиксированнаяСтруктура("НеСовпадаетТипоразмер", Истина); 
	ЭтаФорма.Элементы.ДанныеПоСтокамПредыдущаяЗаписьВозврат.ОтборСтрок = Новый ФиксированнаяСтруктура("ПредЗаписьПроблемныйВывоз", Истина); 
	ЭтаФорма.Элементы.ДанныеПоСтокамПредыдущаяЗаписьЗавоз.ОтборСтрок = Новый ФиксированнаяСтруктура("ПроверкаПоПредыдущимЗаписям", 4); 
	ЭтаФорма.Элементы.ДанныеПоСтокамРешениеПоДругомуТерминалуАвто.ОтборСтрок = Новый ФиксированнаяСтруктура("ДругойТерминалАвто", Истина); 
	ЭтаФорма.Элементы.ДанныеПоСтокамРешениеПоДругомуТерминалуРучн.ОтборСтрок = Новый ФиксированнаяСтруктура("ДругойТерминалРучн", Истина); 
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийТаблицыДанныеПоСтокам

&НаКлиенте
Процедура ДанныеПоСтокамПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)  
	
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	Если НоваяСтрока Тогда
		ТекущаяСтрока.Статус = ПредопределенноеЗначение("Справочник.ОперацииСВагонами.ЗавозНаКонтейнерныйПункт");
	КонецЕсли;                          
	Если Копирование Тогда
		ТекущаяСтрока.ЕстьПроблема = Ложь;	
		ТекущаяСтрока.НеверныйПодсток = Ложь;	
		ТекущаяСтрока.НетКарточкиКТК = Ложь;	
		ТекущаяСтрока.НеКорректныйНомерКТК = Ложь;	
		ТекущаяСтрока.НеКорректныйКонтрольныйСимвол = Ложь;	
		ТекущаяСтрока.ЗагружатьБезКарточкиКТК = Неопределено;	
		ТекущаяСтрока.ТипКТК_DC = "";	
		ТекущаяСтрока.НеСовпадаетТипоразмер = Ложь;	
		ТекущаяСтрока.НеСовпадаетРазмерКТК = Ложь;	
		ТекущаяСтрока.НеСовпадаетТипКТК = Ложь;	
		ТекущаяСтрока.ЗагружатьДругойТипоразмер = Неопределено;	
	КонецЕсли;
КонецПроцедуры      

&НаКлиенте
Процедура ДанныеПоСтокамПриИзменении(Элемент)  
	ТекД = Элементы.ДанныеПоСтокам.ТекущиеДанные;
	Если ЗаполнятьВниз Тогда
		ИмяТЧ = Элемент.Имя;
		ИмяПоля = Сред(Элемент.ТекущийЭлемент.Имя, СтрДлина(ИмяТЧ)+1);
		
		НовоеЗначение = ТекД[ИмяПоля];
		
		СтрокаПройдена = Ложь;		
		Для Сч = 0 По Объект[ИмяТЧ].Количество() - 1 Цикл
			РезПроверки = Элементы.ДанныеПоСтокам.ПроверитьСтроку(Объект[ИмяТЧ][Сч].ПолучитьИдентификатор());
			
			СтрокаПройдена = СтрокаПройдена Или Элементы.ДанныеПоСтокам.ТекущаяСтрока = Объект[ИмяТЧ][Сч].ПолучитьИдентификатор();
			
			Если РезПроверки = Истина И СтрокаПройдена = Истина Тогда
				
				Объект[ИмяТЧ][Сч][ИмяПоля] = НовоеЗначение;
				
			КонецЕсли; 
			
		КонецЦикла;
		
	КонецЕсли;
КонецПроцедуры

