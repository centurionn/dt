&НаСервереБезКонтекста
Функция ПолучитьМассивТиповКТК(РазмерКТК) 
	МассивТиповКТК = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТипоразмерыТЕ.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ТипоразмерыТЕ КАК ТипоразмерыТЕ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РазмерыКТК КАК РазмерыКТК
	|		ПО ТипоразмерыТЕ.РазмерКТК = РазмерыКТК.Ссылка
	|ГДЕ
	|	РазмерыКТК.Наименование = &РазмерКТК";     
	
	Запрос.УстановитьПараметр("РазмерКТК", РазмерКТК);     
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл   
			Типоразмер = Сред(СокрЛП(Выборка.Наименование), 3);
			МассивТиповКТК.Добавить(Типоразмер);
		КонецЦикла;
	КонецЕсли;
	
	Возврат МассивТиповКТК;
	
КонецФункции

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	// Вставить содержимое обработчика.
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
	    Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			Если Объект.Проведен Тогда
				Отказ = Истина;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя перепроводить документ! Все изменения следует выполнять, только через отмену проведения документа");
				Возврат;
			КонецЕсли;
		ИначеЕсли ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда	
			Если не Пользователи.РолиДоступны("АдминистраторСистемы",, Ложь) Тогда
				Отказ = Истина;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запись была проведена, корректировка не возможна. Для корректировки данных просим загрузить корректную информацию через инструмент «ручная загрузка стоков");
				Возврат;
			КонецЕсли;
		КонецЕсли;
		ДокументОбъект = РеквизитФормыВЗначение("Объект");
		ДокументОбъект.ВыполнитьПроверкуПередПроведением(Отказ);
	    ЗначениеВРеквизитФормы(ДокументОбъект,"Объект");
		Если Отказ Тогда
			ЭтаФорма.Модифицированность = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

