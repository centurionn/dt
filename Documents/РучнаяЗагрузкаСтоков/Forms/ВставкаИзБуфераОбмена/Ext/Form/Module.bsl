&НаСервере
Процедура EXCELВТабличныйДокумент(ДвоичныеДанные, Расширение)

	ФайлEXCELНаСервере = ПолучитьИмяВременногоФайла(Расширение);
	ДвоичныеДанные.Записать(ФайлEXCELНаСервере);

	ДокументРезультат = Новый ТабличныйДокумент;
	ДокументРезультат.Прочитать(ФайлEXCELНаСервере);
	УдалитьФайлы(ФайлEXCELНаСервере);
	//ОбластьТаблицы = ТабличныйДокумент.Область(8, 1, ТабличныйДокумент.ВысотаТаблицы, ТабличныйДокумент.ШиринаТаблицы);

	//ПостроительЗапроса = Новый ПостроительЗапроса;
	//ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(ОбластьТаблицы);
	//ПостроительЗапроса.Выполнить();
	//ТаблицаДанных = ПостроительЗапроса.Результат.Выгрузить();

	//// теперь поссмторим что в Таблице
	//Возврат ТаблицаЗначенийВТабличныйДокумент(ТаблицаДанных);
 	ШиринаДокумента = ДокументРезультат.ШиринаТаблицы; 
	ВысотаДокумента = ДокументРезультат.ВысотаТаблицы; 
	
	МассивЗаголовков = Новый Массив;
	МассивЗаголовков.Добавить("Контейнер");	
	МассивЗаголовков.Добавить("Размер КТК");	
	МассивЗаголовков.Добавить("Тип КТК");	
	МассивЗаголовков.Добавить("Подсток линия собственника");
	МассивЗаголовков.Добавить("Дата ввоза\вывоза");	
	МассивЗаголовков.Добавить("Состояние");	
	МассивЗаголовков.Добавить("Поврежден");	
	МассивЗаголовков.Добавить("Комментарий");	
	
	СчетчикПоиска = 0;
	Для каждого ЗаголовокПоиска Из МассивЗаголовков Цикл
		СчетчикПоиска = СчетчикПоиска + 1;
		НомерКолонки = 0;
		Для Счетчик = 1 по ШиринаДокумента Цикл
			Если ДокументРезультат.Область(1,Счетчик).Текст	= ЗаголовокПоиска Тогда
				НомерКолонки = Счетчик;
				Прервать;
			КонецЕсли;		
		КонецЦикла;	
		Если НомерКолонки = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найден заголовок: "+ЗаголовокПоиска);
			Продолжить;
		Иначе
			Если ЗаголовокПоиска = "Состояние" Тогда
				Для Счетчик2 = 2 По ВысотаДокумента Цикл
					ТекстЯчейки = ВРег(ДокументРезультат.Область(Счетчик2,НомерКолонки).текст);
					Если ТекстЯчейки = "ДА" Тогда
						ДокументРезультат.Область(Счетчик2,НомерКолонки).текст = "ГРУЖЕНЫЙ";
					ИначеЕсли ТекстЯчейки = "НЕТ" Тогда
						ДокументРезультат.Область(Счетчик2,НомерКолонки).текст = "ПОРОЖНИЙ";
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			ТД.ВставитьОбласть(ДокументРезультат.Область(2,НомерКолонки,ВысотаДокумента,НомерКолонки),ТД.Область(2,СчетчикПоиска));	
		КонецЕсли;	
	КонецЦикла;

КонецПроцедуры 

