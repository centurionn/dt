&НаКлиенте
Процедура ПеренестиВДокументКлиент()
	
	РезультатИтого = Новый Массив;
	ВсеХорошо = Истина;
	
	
	ЗавозНаКонтейнерныйПункт = ПредопределенноеЗначение("Справочник.ОперацииСВагонами.ЗавозНаКонтейнерныйПункт");  
	
	Для каждого Стр из Результат Цикл  
		
		Стр.Статус = ЗавозНаКонтейнерныйПункт;
		
		Если Не ЗначениеЗаполнено(Стр.Ошибка)
			Или ЗначениеЗаполнено(Стр.Ошибка) 
			И Не Стр.БлокирующаяОшибка Тогда
			
			текСтр = Новый Структура(ОписаниеВозвРезультата);
			ЗаполнитьЗначенияСвойств(текСтр, Стр); 
			РезультатИтого.Добавить(текСтр);  
		Иначе
			ВсеХорошо = Ложь;
		КонецЕсли;
		
	КонецЦикла;     
	
	СтруктураВозврата = Новый Структура("МассивСтрок, Терминал", РезультатИтого, Терминал);
	
	Если ВсеХорошо Тогда
		Закрыть(СтруктураВозврата);
	Иначе
		ОпОп = Новый ОписаниеОповещения("ВопросПереноса", ЭтаФорма, Новый Структура("СтруктураВозврата", СтруктураВозврата));
		ПоказатьВопрос(ОпОп, "Перенос данных будет проведен только по строкам, не имеющим ошибок. Продолжить?", РежимДиалогаВопрос.ДаНет, 30, КодВозвратаДиалога.Нет,, КодВозвратаДиалога.Нет);
	КонецЕсли;

КонецПроцедуры 

