Процедура ДобавитьАналитикуВидЗадолженностиДоплатныеПВПоДокументамРасчетов()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА КАК ЕстьДоплатныеПВ
		|ИЗ
		|	Документ.КорректировкаДолга.ДебиторскаяЗадолженность КАК КорректировкаДолгаДебиторскаяЗадолженность
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхАналитикДокументов КАК ЗначенияДополнительныхАналитикДокументов
		|		ПО (ЗначенияДополнительныхАналитикДокументов.Документ = КорректировкаДолгаДебиторскаяЗадолженность.Сделка)
		|			И (ТИПЗНАЧЕНИЯ(КорректировкаДолгаДебиторскаяЗадолженность.Сделка) = ТИП(Документ.РеализацияТоваровУслуг))
		|			И (ЗначенияДополнительныхАналитикДокументов.Аналитика = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ДополнительныеАналитикиДокументов.ВидЗадолженности))
		|			И (ЗначенияДополнительныхАналитикДокументов.Значение = ЗНАЧЕНИЕ(Перечисление.ВидыЗадолженности.ДоплатныеПВ))
		|ГДЕ
		|	КорректировкаДолгаДебиторскаяЗадолженность.Ссылка = &Ссылка
		|	И НЕ ЗначенияДополнительныхАналитикДокументов.Значение ЕСТЬ NULL";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ЗаписатьВидЗадолженностиПоДокументу(Ссылка, ПредопределенноеЗначение("Перечисление.ВидыЗадолженности.ДоплатныеПВ"));
	КонецЕсли;
	
КонецПроцедуры //Евросиб Коханенко Н.А. 20.08.2025 )) #115687 




