Функция ПолучитьСуммуНДС(Сумма, Знач СтавкаНДС, УчитыватьНДС, СуммаВключаетНДС) Экспорт
	
	СтавкаНДС = ПолучитьСтавкуНДС(СтавкаНДС);
	
	Если (УчитыватьНДС) и (СуммаВключаетНДС) Тогда
			СуммаБезНДС = 100 * Сумма / (100 + СтавкаНДС);
			СуммаНДС = Сумма - СуммаБезНДС;
		Иначе
			СуммаБезНДС = Сумма;
		КонецЕсли;

		Если УчитыватьНДС Тогда 
			Если НЕ СуммаВключаетНДС Тогда
				СуммаНДС = СуммаБезНДС * СтавкаНДС / 100;
			КонецЕсли;
		Иначе
			СуммаНДС = 0;
		КонецЕсли;

		Возврат СуммаНДС;

КонецФункции

Функция ПолучитьСтавкуНДС(СтавкаНДС) Экспорт
	Если СтавкаНДС = Перечисления.СтавкиНДС.НДС20 ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС20_120 Тогда
		Возврат 20;
		
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС10 ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС10_110 Тогда
		Возврат 10;
		
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС18 ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС18_118 Тогда
		Возврат 18;    
		
	// Евросиб(ДИТ) US 96051 ТА 96052 Сержантова А.С. Начало: 25.12.2024
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС5 ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС5_105 Тогда
		Возврат 5; 
		
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС7 ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС7_107 Тогда
		Возврат 7; 
	// Евросиб(ДИТ) US 96051 ТА 96052 Сержантова А.С. Конец: 25.12.2024	
	//Евросиб СубботинВ #125845 09.12.2025 Начало
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС22 ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС22_122 Тогда
		Возврат 22;
	//Евросиб СубботинВ #125845 09.12.2025 Конец

	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	//Евросиб(ДИТ), Беляев СЮ, BUG 106982 / TA 106985, 18-04-2025, начало
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	//Евросиб(ДИТ), Беляев СЮ, BUG 106982 / TA 106985, 18-04-2025, конец
	
	СуммаДтЗадолженности = ДебиторскаяЗадолженность.Итог("Сумма");
	СуммаКтЗадолженности = КредиторскаяЗадолженность.Итог("Сумма");
	
	//Евросиб СубботинВ #83828 08.08.2024 Начало
	Для Каждого СтрД Из ДебиторскаяЗадолженность Цикл
		Если НЕ ЗначениеЗаполнено(СтрД.ГУИД) Тогда
			СтрД.ГУИД = Новый УникальныйИдентификатор;
		КонецЕсли;
	КонецЦикла;
	
	Если Проведен Тогда 
		ДвиженияРазнесения = Движения.РазнесениеСчетовПокупателейПоВходящимПлатежам;
		ДвиженияРазнесения.Записать();
	КонецЕсли;
	//Евросиб СубботинВ #103438 24.02.2025 Начало //
	Если Не РучнаяКорректировкаРасшифровкиДебиторскойЗадолженности и Не ДополнительныеСвойства.Свойство("ЗагруженИзРитм") Тогда
		//Проверка не загружен ли док ранее 
		Если ЗначениеЗаполнено(Ссылка) Тогда
			УзлыОбмена = РегистрыСведений.ПротоколОбменов.ПолучитьУзлыОбменаОбъектаПротоколаОбмена(Ссылка,Перечисления.ДействияПриОбмене.ЗагрузкаДанных);
			Если УзлыОбмена = Неопределено Тогда
				ТребуетсяЗаполнениеРасшифровки = Истина;
			Иначе	
				СтруктураПоиска = Новый Структура("УзелОбмена", Перечисления.УзлыОбмена.РИТМ);
				УзлыОбмена = УзлыОбмена.НайтиСтроки(СтруктураПоиска);
				Если УзлыОбмена.Количество() = 0 Тогда
					ТребуетсяЗаполнениеРасшифровки = Истина;
				Иначе
					ТребуетсяЗаполнениеРасшифровки = Ложь;
				КонецЕсли;
			КонецЕсли;
		Иначе
			ТребуетсяЗаполнениеРасшифровки = Истина; 
		КонецЕсли;
		
		Если ТребуетсяЗаполнениеРасшифровки Тогда			
			Документы.КорректировкаДолга.ЗаполнитьРасшифровкуДебиторскойЗадолжености(ЭтотОбъект);
		КонецЕсли;
	КонецЕсли;
	//Евросиб СубботинВ #103438 24.02.2025 Конец
	//Евросиб СубботинВ #83828 08.08.2024 Конец 
		
КонецПроцедуры 

