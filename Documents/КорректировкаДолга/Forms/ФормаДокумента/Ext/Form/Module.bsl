&НаКлиенте
Процедура ЗаполнитьДокумент(Команда)
	ТекстВопроса = "";
	Если Объект.ДебиторскаяЗадолженность.Количество() > 0 или Объект.КредиторскаяЗадолженность.Количество() > 0 Тогда
		ТекстВопроса = "Перед заполнением табличные части будут очищены. Заполнить?";
	КонецЕсли;
	Если ТекстВопроса <> "" Тогда
		Оповещение = Новый ОписаниеОповещения("ВопросПередЗаполнениемТабличнойЧастиЗавершение",ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да );

	Иначе
		ЗаполнитьДокументНаСервере();
	КонецЕсли;
	Разница = Объект.СуммаДтЗадолженности - Объект.СуммаКтЗадолженности;
КонецПроцедуры

&НаКлиенте
Процедура ВопросПередЗаполнениемТабличнойЧастиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда

		ЗаполнитьДокументНаСервере();

	КонецЕсли;
КонецПроцедуры

