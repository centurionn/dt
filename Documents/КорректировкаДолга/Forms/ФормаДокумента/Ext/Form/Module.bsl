	//Евросиб Каблов 03.03.2026 ( #83826
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Для Каждого СтрокаДЗ Из Объект.ДебиторскаяЗадолженность Цикл
			
			СуммаПоСтрокеДЗ = СтрокаДЗ.Сумма;
			СуммаПоСтрокамРасшифровки = 0;
			Счета = Новый Массив;
			СтрокиРасшифровки = Объект.РасшифровкаДебиторскойЗадолженности.НайтиСтроки(Новый Структура("ГУИДДебиторскаяЗадолженность", СтрокаДЗ.ГУИД));
			Для Каждого СтрокаРасшифровки Из СтрокиРасшифровки Цикл
				СуммаПоСтрокамРасшифровки = СуммаПоСтрокамРасшифровки + СтрокаРасшифровки.Сумма;
				Счета.Добавить(СтрокаРасшифровки.ДокументРасшифровки);
			КонецЦикла;
			
			Если СуммаПоСтрокеДЗ < СуммаПоСтрокамРасшифровки Тогда
				СуммаПревышения = СуммаПоСтрокамРасшифровки - СуммаПоСтрокеДЗ;
				СчетаСтрокой = СтрСоединить(Счета, ", ");
				ТекстСообщения = СтрШаблон(НСтр("ru = 'Для документа %1 превышена сумма корректировки по %2 на %3. Проведение отменено.'"), СтрокаДЗ.Сделка, СчетаСтрокой, СуммаПревышения);
				Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ДебиторскаяЗадолженность", СтрокаДЗ.НомерСтроки, "Сделка");
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, Поле, "Объект", Отказ);
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	//Евросиб Каблов 03.03.2026 )
	
КонецПроцедуры
 
