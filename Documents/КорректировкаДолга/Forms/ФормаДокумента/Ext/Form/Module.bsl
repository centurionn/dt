&НаСервереБезКонтекста
Функция ПолучитьСписокВыбораНаСервере(Сделка)

	МасРез = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КорректировкаПоступленияСвязанныеСчетаПоставщиков.Ссылка КАК Ссылка,
	               |	КорректировкаПоступленияСвязанныеСчетаПоставщиков.СчетПоставщика КАК СчетПоставщика,
	               |	КорректировкаПоступленияСвязанныеСчетаПоставщиков.СуммаНаПТУ КАК СуммаНаПТУ
	               |ИЗ
	               |	Документ.КорректировкаПоступления.СвязанныеСчетаПоставщиков КАК КорректировкаПоступленияСвязанныеСчетаПоставщиков
	               |ГДЕ
	               |	КорректировкаПоступленияСвязанныеСчетаПоставщиков.Ссылка В(&Сделка)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПоступлениеТоваровУслугСвязанныеСчетаПоставщиков.Ссылка,
	               |	ПоступлениеТоваровУслугСвязанныеСчетаПоставщиков.СчетПоставщика,
	               |	ПоступлениеТоваровУслугСвязанныеСчетаПоставщиков.СуммаНаПТУ
	               |ИЗ
	               |	Документ.ПоступлениеТоваровУслуг.СвязанныеСчетаПоставщиков КАК ПоступлениеТоваровУслугСвязанныеСчетаПоставщиков
	               |ГДЕ
	               |	ПоступлениеТоваровУслугСвязанныеСчетаПоставщиков.Ссылка В(&Сделка)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СписаниеСРасчетногоСчетаРасшифровкаПлатежа.Ссылка,
	               |	СписаниеСРасчетногоСчетаРасшифровкаПлатежа.Сделка,
	               |	СписаниеСРасчетногоСчетаРасшифровкаПлатежа.СуммаПлатежа
	               |ИЗ
	               |	Документ.СписаниеСРасчетногоСчета.РасшифровкаПлатежа КАК СписаниеСРасчетногоСчетаРасшифровкаПлатежа
	               |ГДЕ
	               |	СписаниеСРасчетногоСчетаРасшифровкаПлатежа.Ссылка В(&Сделка)";
	
	Запрос.УстановитьПараметр("Сделка", Сделка);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
	
		МасРез.Добавить(Выборка.СчетПоставщика ); // Новый Структура("ДокРасч, ДокРасш", Выборка.Ссылка, 
	
	КонецЦикла;
	
	Возврат МасРез;

КонецФункции // ПолучитьСписокВыбораНаСервере(Сделка)

