Процедура КредиторскаяЗадолженностьПриАктивизацииПоля(Элемент)
	
	Если Врег(Прав(Элемент.ТекущийЭлемент.Имя, 19)) = ВРег("ДокументРасшифровка") Тогда
		
		ТекДан = Элемент.ТекущиеДанные;
		
		Если ЗначениеЗаполнено(ТекДан.Сделка) Тогда
		
			Рез = ПолучитьСписокВыбораНаСервере(ТекДан.Сделка);
			
			Элемент.ТекущийЭлемент.СписокВыбора.ЗагрузитьЗначения(Рез);
			
		Иначе
		
			Элемент.ТекущийЭлемент.СписокВыбора.Очистить();
		
		КонецЕсли; 
		
