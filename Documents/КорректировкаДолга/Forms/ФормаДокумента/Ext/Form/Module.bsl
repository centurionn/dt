&НаСервере
Процедура ПересчетВалютыИСуммыВСтроке(ИмяТЧ, ИДСтроки)

	ИскСтр = Объект[ИмяТЧ].НайтиПоИдентификатору(ИДСтроки);
	Если ЗначениеЗаполнено(ИскСтр.ДоговорКонтрагента) Тогда
	
		СтруктураКурса = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ИскСтр.ДоговорКонтрагента.ВалютаВзаиморасчетов, ИскСтр.ДатаВзаиморасчетов);
		
		ИскСтр.КурсВзаиморасчетов = СтруктураКурса.Курс;
		ИскСтр.КратностьВзаиморасчетов = СтруктураКурса.Кратность;
		
		Если ЗначениеЗаполнено(Объект.ВалютаДокумента) Тогда
		
			СтруктураТекущая = СтруктураКурса; 
			СтруктураНовая = Новый Структура("Курс, Кратность, Валюта", Объект.КурсДокумента, Объект.КратностьДокумента, Объект.ВалютаДокумента) ;
			
			ИскСтр.СуммаВзаиморасчетов = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(ИскСтр.Сумма, СтруктураТекущая, СтруктураНовая);
			
		КонецЕсли; 
		
	Иначе
	
		ИскСтр.КурсВзаиморасчетов = 0;
		ИскСтр.КратностьВзаиморасчетов = 0;
	
	КонецЕсли;

КонецПроцедуры

