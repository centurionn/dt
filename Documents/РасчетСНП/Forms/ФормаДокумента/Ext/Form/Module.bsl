
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОбновитьПанельТекущегоПользователя();
	ОбновитьПанельСостояний();
	
	Элементы.ТекущийИсполнитель_ПричинаВозврата.Видимость = Ложь;
	Для каждого СтрокаСостояния из Объект.Состояния Цикл
		Если СтрокаСостояния.Исполнитель = ПараметрыСеанса.ТекущийПользователь И НЕ СтрокаСостояния.Комментарий = "" Тогда
			ТекущийИсполнитель_ПричинаВозврата = СтрокаСостояния.Комментарий;
			Элементы.ТекущийИсполнитель_ПричинаВозврата.Видимость = Истина;
		КонецЕсли;
	КонецЦикла;
	Если НЕ Пользователи.РолиДоступны("ПолныеПрава",, Ложь) Тогда
		РегистрыСведений.СостоянияДокументов.УстановитьДоступностьТаблицыСостояния(Элементы.ГруппаСостояния, "Состояния", "СостоянияИсполнитель", Ложь);
	КонецЕсли;
	
	ПараметрыГиперссылки = РаботаСФайлами.ГиперссылкаФайлов();
	ПараметрыГиперссылки.Размещение = "ГруппаРазмещения";
	ДобавляемыеЭлементы = Новый Массив;
	ДобавляемыеЭлементы.Добавить(ПараметрыГиперссылки);	
	РаботаСФайлами.ПриСозданииНаСервере(ЭтотОбъект, ДобавляемыеЭлементы);
	
	Элементы.ОбоснованиеКорректировки.ТолькоПросмотр = НЕ Объект.ЭтоКорректировка;
	Элементы.ТипКорректировки.ТолькоПросмотр = НЕ Объект.ЭтоКорректировка;
	
	ОбновитьБлокировкуЭлементов();
	
	УстановитьСвязиПараметровВыбораПСЦ();
	УстановитьСвязиПараметровВыбораСчета();
	УстановитьВидимостьПСЦ();
		
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПСЦ();
	Элементы.ПСЦ.ТолькоПросмотр = НЕ Объект.ЭтоКорректировка ИЛИ (Объект.ЭтоКорректировка И Объект.ОбоснованиеКорректировки <> "Изменение условий ПСЦ (льготного периода)");
КонецПроцедуры	

&НаСервере
Процедура УстановитьСвязиПараметровВыбораПСЦ()
	СвязиПСЦ = Новый Массив;
	
	ПолучитьКлиентДоговор(Объект.КлючАналитикиПеревозки,Клиент,Договор);
	
	СвязиПСЦ.Добавить(Новый СвязьПараметраВыбора("Отбор.Контрагент", "Клиент"));
	СвязиПСЦ.Добавить(Новый СвязьПараметраВыбора("Отбор.Договор", "Договор"));
	Элементы.ПСЦ.СвязиПараметровВыбора    = Новый ФиксированныйМассив(СвязиПСЦ);
КонецПроцедуры

&НаСервере
Процедура УстановитьСвязиПараметровВыбораСчета()
	СвязиСчет = Новый Массив;
	
	ПолучитьКлиентДоговор(Объект.КлючАналитикиПеревозки,Клиент,Договор);
	
	СвязиСчет.Добавить(Новый СвязьПараметраВыбора("Отбор.Контрагент", "Клиент"));
	СвязиСчет.Добавить(Новый СвязьПараметраВыбора("Отбор.ДоговорКонтрагента", "Договор"));
	Элементы.Счет.СвязиПараметровВыбора    = Новый ФиксированныйМассив(СвязиСчет);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПолучитьКлиентДоговор(КлючАналитикиПеревозки,Клиент,Договор)
	
	Клиент = Справочники.Контрагенты.ПустаяСсылка();
	Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КлючиАналитикиПеревозки.Заявка.Контрагент КАК ЗаявкаКонтрагент,
		|	КлючиАналитикиПеревозки.Заявка.Договор КАК ЗаявкаДоговор
		|ИЗ
		|	Справочник.КлючиАналитикиПеревозки КАК КлючиАналитикиПеревозки
		|ГДЕ
		|	КлючиАналитикиПеревозки.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", КлючАналитикиПеревозки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Клиент = ВыборкаДетальныеЗаписи.ЗаявкаКонтрагент;
		Договор = ВыборкаДетальныеЗаписи.ЗаявкаДоговор;
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Процедура ОбновитьПанельТекущегоПользователя()
	
	МаршрутизацияСервер.ОбновитьПанельТекущегоПользователя(Объект, ТекущийИсполнитель_Статус, ТекущийИсполнитель_Состояние, ТекущийИсполнитель_Исполнитель, ТекущийИсполнитель_Наблюдатель);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикНажатияПлитокСостояния(П1 = неопределено, П2 = неопределено) Экспорт
	МаршрутизацияКлиент.ОбработчикНажатияНаПлиткуОбщий(П1, П2);
КонецПроцедуры

&НаСервере
Процедура ОбновитьПанельСостояний()
	
	МаршрутизацияСервер.ОбновитьПанельСостояний(ЭтотОбъект); 
		
КонецПроцедуры

&НаКлиенте
Процедура ТекущийИсполнитель_СтатусПриИзменении(Элемент)
	
	// обновляем информацию по состоянию 
	МаршрутизацияКлиент.ТекущийИсполнитель_СтатусПриИзменении(Объект, ТекущийИсполнитель_Состояние, ТекущийИсполнитель_Статус, ТекущийИсполнитель_Исполнитель, ТекущийИсполнитель_Наблюдатель);
	ОбновитьПанельСостояний();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьБлокировкуЭлементов()
	
	КонтрольДоступностиДокументов_сервер.ОбработатьБлокировкуЭлементовФормы(Объект.Ссылка, Элементы, Объект);
	
	Элементы.ФормаОбщаяКомандаВернутьЗадачу.Доступность = Истина;
	Элементы.УправлениеПрисоединеннымиФайламиЗагрузитьФайл0.Доступность = Истина;
	Элементы.УправлениеПрисоединеннымиФайламиОткрытьСписок0.Доступность = Истина;
	Элементы.ФормаПровести.Доступность = Истина;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) 
		И ЗначениеЗаполнено(Элементы.ПредупреждениеРедактирования.Заголовок) Тогда
		Элементы.ГруппаИнформацияОДокументе.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	РаботаСФайламиКлиент.ПоказатьПодтверждениеЗакрытияФормыСФайлами(ЭтотОбъект, Отказ, ЗавершениеРаботы, Объект.Ссылка);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// СтандартныеПодсистемы.РаботаСФайлами
	РаботаСФайламиКлиент.ПриОткрытии(ЭтотОбъект, Отказ);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
	Элементы.ГруппаРазмещения.Видимость = Объект.ОбоснованиеКорректировки = "Скидка";
	
КонецПроцедуры

