				Запрос.УстановитьПараметр("ГУИДСтрокиПротокола", ПараметрГУИДСтрокиПротокола);
			Иначе
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "И (ПСЦСверхнормативноеПользование.ГУИДСтроки = &ГУИДСтрокиПротокола)", "");
			КонецЕсли;
			
			Результаты = Запрос.ВыполнитьПакет();
			
			КоличествоЗапросов = Результаты.Количество();
			ПараметрыСНП = Результаты[КоличествоЗапросов - 2].Выбрать();
			ТаблицаСтавок = Результаты[КоличествоЗапросов - 1].Выгрузить();
			ТаблицаСтавок.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
