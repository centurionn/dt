Функция ПоместитьПОВХранилище()
	
	ТаблицаПродуктов = Объект.Продукты.Выгрузить(, "Продукт,Количество,КоличествоПоИсхДокументу,Отправка,Количество40,СтавкаЗа20,СтавкаЗа40,КонтрибуцияЗа20,КонтрибуцияЗа40,ПлановаяДатаУслуги");
	// если не нужно показывать то, что загрузили ранее, то эту строку откомментить
	//ТаблицаПродуктов.Очистить();
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаПродуктов, УникальныйИдентификатор);
	
КонецФункции

