Процедура ЗаполнитьПоПериоду(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ОбработчикВыбораСП", ЭтаФорма);
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода;
	Диалог.Показать(ОпОп);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВыбораСП(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = неопределено Тогда Возврат; КонецЕсли;
	
	Объект.ДатаНачала = П1.ДатаНачала;
	Объект.ДатаОкончания = П1.ДатаОкончания;
	
	РезСтруктура = ПолучитьСтруктуруОтправокПоПериоду(П1.ДатаНачала, П1.ДатаОкончания);
	
	Для каждого Стр из РезСтруктура Цикл
		
		Если Объект.Продукты.НайтиСтроки(Новый Структура("Отправка", Стр.Отправка)).Количество() > 0 Тогда Продолжить; КонецЕсли;
		
		НСтр 					= Объект.Продукты.Добавить();
		НСтр.Отправка 			= Стр.Отправка;
		НСтр.Продукт 			= Стр.Продукт;
		НСтр.Количество 		= Стр.ВсегоТЕУ;
		НСтр.ПлановаяДатаУслуги = Стр.ДатаУслуги;
		НСтр.Количество20 		= Стр.Двадцаток;
		НСтр.Количество40 		= Стр.Сороковок;
		НСтр.ГУИДСтроки 		= Строка(Новый УникальныйИдентификатор);
		
	КонецЦикла;
	
	ПодобратьКалькуляцииИСтавкиНаСервере();
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаСервереБезКонтекста
Функция ПолучитьСтруктуруОтправокПоПериоду(ДатаНачала, ДатаОкончания)
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РейсыЖД.Ссылка КАК Ссылка,
	               |	РейсыЖД.ДатаПрибытия КАК ДатаПрибытия,
	               |	РейсыЖД.КоличествоТЕУ КАК КоличествоТЕУ,
	               |	РейсыЖД.Продукт КАК Продукт
	               |ИЗ
	               |	Справочник.РейсыЖД КАК РейсыЖД
	               |ГДЕ
	               |	РейсыЖД.ДатаПрибытия МЕЖДУ &Дата1 И &Дата2
	               |	И НЕ РейсыЖД.ПометкаУдаления
	               |	И НЕ РейсыЖД.РейсОтменен
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаПрибытия";
	Запрос.УстановитьПараметр("Дата1", ДатаНачала);
	Запрос.УстановитьПараметр("Дата2", ДатаОкончания);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		КоличествоДвадцаток = 0;
		СтруктураПроданныхКТК = Отправки_сервер.ПолучитьТаблицуПривязанныхКонтейнеров(Ответ.Ссылка);
		Для каждого Стр из СтруктураПроданныхКТК Цикл
			Если Стр.ТипКТК.ТЕУ = 1 Тогда
				КоличествоДвадцаток = КоличествоДвадцаток + Стр.КоличествоКТК;
			КонецЕсли;
		КонецЦикла;
		Результат.Добавить(Новый Структура("Отправка, Продукт, ДатаУслуги, ВсегоТЕУ, Двадцаток, Сороковок", Ответ.Ссылка, Ответ.Продукт, Ответ.ДатаПрибытия, Ответ.КоличествоТЕУ, КоличествоДвадцаток, (Ответ.КоличествоТЕУ-КоличествоДвадцаток)/2));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции
