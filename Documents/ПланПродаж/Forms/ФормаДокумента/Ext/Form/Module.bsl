	ПараметрыПодбора.Вставить("КонецПериода", Объект.ДатаОкончания);

	ОткрытьФорму("Обработка.ПланыОтправок.Форма.ФормаВыбора", ПараметрыПодбора, ЭтаФорма);
	
КонецПроцедуры

