#КонецОбласти

&НаКлиенте
Процедура ЗаполнитьПоРегламентуПродуктов(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораРП", ЭтаФорма);
	ОткрытьФорму("Документ.РегламентПродуктов.ФормаВыбора",,,ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&наКлиенте
Процедура ОбработкаВыбораРП(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = неопределено Тогда Возврат; КонецЕсли;
	
	ЗаполнитьНаСервере(П1);
	Для каждого Стр из объект.Продукты Цикл
		ПродуктыКоличество20ПриИзменении(неопределено, Стр);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере(П1)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РегламентПродуктовПродукты.Продукт КАК Продукт,
	               |	РегламентПродуктовПродукты.СвободныхМест КАК СвободныхМест,
	               |	РегламентПродуктовПродукты.ДатаНачала КАК ДатаНачала,
	               |	РегламентПродуктовПродукты.Продукт.Контрибуция20 КАК Контрибуция20,
	               |	РегламентПродуктовПродукты.Продукт.Реализация20 КАК Реализация20,
	               |	РегламентПродуктовПродукты.Продукт.Контрибуция40 КАК Контрибуция40,
	               |	РегламентПродуктовПродукты.Продукт.Реализация40 КАК Реализация40
	               |ИЗ
	               |	Документ.РегламентПродуктов.Продукты КАК РегламентПродуктовПродукты
	               |ГДЕ
	               |	РегламентПродуктовПродукты.Действует
	               |	И РегламентПродуктовПродукты.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", П1);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		НСтр 							= Объект.Продукты.Добавить();
		НСтр.ГУИДСтроки					= Строка(Новый УникальныйИдентификатор);
		НСтр.Продукт 					= Ответ.Продукт;
		НСтр.Количество 				= Ответ.СвободныхМест;
		НСтр.КоличествоПоИсхДокументу 	= Ответ.СвободныхМест;
		НСтр.ПлановаяДатаУслуги 		= Ответ.ДатаНачала;
		
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура ЗаполнитьПоПлануОтправок(Команда)
	
    //ПараметрыФормы  = Новый Структура("РежимВыбора, ЗакрыватьПриВыборе", Истина, Истина);
	
	//Оповещение = Новый ОписаниеОповещения("ЗаполнениеПоПлануОтправок", ЭтотОбъект);
	//ОткрытьФорму("Обработка.ПланыОтправок.Форма.ФормаВыбора",ПараметрыФормы,,ЭтаФорма.УникальныйИдентификатор,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	ПланыОтправокВХранилище = ПоместитьПОВХранилище();
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("ПланыОтправокВХранилище", ПланыОтправокВХранилище);
