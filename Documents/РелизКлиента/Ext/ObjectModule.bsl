Функция ПроверитьОтсутствиеДублейКТКВКлючахАналитики(Отказ, ДанныеДляОбновленияКлючейАналитики = Неопределено) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЗ.КлючАналитикиПеревозки КАК Ключ,
		|	ТЗ.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ ВТ_Контейнеры
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Контейнеры.НомерСтроки КАК НомерСтроки,
		|	ЕстьNULL(КлючиАналитикиПеревозки.Контейнер,ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)) КАК Контейнер
		|ПОМЕСТИТЬ ВТ_Контейнер
		|ИЗ
		|	ВТ_Контейнеры КАК ВТ_Контейнеры
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки КАК КлючиАналитикиПеревозки
		|		ПО ВТ_Контейнеры.Ключ <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
		|           И ВТ_Контейнеры.Ключ = КлючиАналитикиПеревозки.Ссылка
		|ГДЕ 
		|	ЕстьNULL(КлючиАналитикиПеревозки.Контейнер,ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)	
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Контейнер.Контейнер КАК Контейнер
		|ПОМЕСТИТЬ Дубли_КТК
		|ИЗ
		|	ВТ_Контейнер КАК ВТ_Контейнер
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Контейнер.Контейнер
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(1) > 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Дубли_КТК.Контейнер КАК Контейнер,
		|	ВТ_Контейнер.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	Дубли_КТК КАК Дубли_КТК
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Контейнер КАК ВТ_Контейнер
		|		ПО Дубли_КТК.Контейнер = ВТ_Контейнер.Контейнер
		|ИТОГИ ПО
		|	Контейнер";
	
	Запрос.УстановитьПараметр("ТЗ",Контейнеры.Выгрузить(,"КлючАналитикиПеревозки,НомерСтроки"));  
	// ДИТ US 76935 ТА 77189 Сержантова А.С. Начало: 07.12.2023 - данные были обновлены с формы
	Если ДанныеДляОбновленияКлючейАналитики <> Неопределено Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЗ.Контейнер КАК Контейнер,
		|	ТЗ.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ ВТ_Контейнер
		|ИЗ
		|	&ТЗ КАК ТЗ
		|ГДЕ
		|	ТЗ.Контейнер <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Контейнер.Контейнер КАК Контейнер
		|ПОМЕСТИТЬ Дубли_КТК
		|ИЗ
		|	ВТ_Контейнер КАК ВТ_Контейнер
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Контейнер.Контейнер
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(1) > 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Дубли_КТК.Контейнер КАК Контейнер,
		|	ВТ_Контейнер.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	Дубли_КТК КАК Дубли_КТК
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Контейнер КАК ВТ_Контейнер
		|		ПО Дубли_КТК.Контейнер = ВТ_Контейнер.Контейнер
		|ИТОГИ ПО
		|	Контейнер";
		Запрос.УстановитьПараметр("ТЗ", ДанныеДляОбновленияКлючейАналитики.Скопировать(,"Контейнер,НомерСтроки"));  
	КонецЕсли;
	// ДИТ US 76935 ТА 77189 Сержантова А.С. Конец: 07.12.2023
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаКонтейнер = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	МассивСообщений = Новый Массив;
	МассивНомеровСтрок = Новый Массив;
	
	Пока ВыборкаКонтейнер.Следующий() Цикл
		
	  		
		ВыборкаДетальныеЗаписи = ВыборкаКонтейнер.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			МассивНомеровСтрок.Добавить(ВыборкаДетальныеЗаписи.НомерСтроки);
		КонецЦикла;
		
		МассивСообщений.Добавить(СтрШаблон("Значения %1 повторяются в строках %2.",ВыборкаКонтейнер.Контейнер,СтрСоединить(МассивНомеровСтрок,",")));
		
	КонецЦикла;
	
	Возврат МассивСообщений;
	
КонецФункции	

Функция ЗаполнитьКонтейнерыПоИнформацииОтТерминалов() Экспорт
	НеобходимаЗаписьОбъекта = Ложь;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(РелизКлиентаКонтейнеры.КлючАналитикиПеревозки КАК Справочник.КлючиАналитикиПеревозки) КАК КлючАналитикиПеревозки
	|ПОМЕСТИТЬ ВТ_РелизКлиентаКонтейнеры
	|ИЗ
