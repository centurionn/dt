Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения)= Тип("ДокументСсылка.Заявка") Тогда
		//ДИТ Шевченко А.В. 59982 12.12.2022 -начало
		ДоговорДействует = Истина;
		Если ЗначениеЗаполнено(ДанныеЗаполнения.Договор) И ЗначениеЗаполнено(ДанныеЗаполнения.Отправка) и НЕ ЗначениеЗаполнено(ДанныеЗаполнения.Прибытие) Тогда
			ДоговорДействует = Справочники.ДоговорыКонтрагентов.ПроверитьПериодДействияДоговора(ДанныеЗаполнения.Договор,ДанныеЗаполнения.Отправка,Дата(1,1,1),Истина);
		ИначеЕсли ЗначениеЗаполнено(ДанныеЗаполнения.Договор) И НЕ ЗначениеЗаполнено(ДанныеЗаполнения.Отправка) и ЗначениеЗаполнено(ДанныеЗаполнения.Прибытие) Тогда
			ДоговорДействует = Справочники.ДоговорыКонтрагентов.ПроверитьПериодДействияДоговора(ДанныеЗаполнения.Договор,ДанныеЗаполнения.Прибытие,Дата(1,1,1),Истина);
		ИначеЕсли ЗначениеЗаполнено(ДанныеЗаполнения.Договор) И ЗначениеЗаполнено(ДанныеЗаполнения.Отправка) и ЗначениеЗаполнено(ДанныеЗаполнения.Прибытие) Тогда
			ДоговорДействует = Справочники.ДоговорыКонтрагентов.ПроверитьПериодДействияДоговора(ДанныеЗаполнения.Договор,ДанныеЗаполнения.Отправка,ДанныеЗаполнения.Прибытие);
		ИначеЕсли ЗначениеЗаполнено(ДанныеЗаполнения.Договор) И НЕ ЗначениеЗаполнено(ДанныеЗаполнения.Отправка) и НЕ ЗначениеЗаполнено(ДанныеЗаполнения.Прибытие) Тогда
			ДоговорДействует = Справочники.ДоговорыКонтрагентов.ПроверитьПериодДействияДоговора(ДанныеЗаполнения.Договор,ДанныеЗаполнения.Дата,Дата(1,1,1),Истина);
		КонецЕсли;
		
		Если НЕ ДоговорДействует Тогда
			Автопролонгация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения.Договор,"Автопролонгация");
			Если Автопролонгация Тогда
				СообщениеТекст = "Документ не может быть создан. Договор не продлен на текущий год, необходимо продлить договор через отдел делопроизводства";
			Иначе
				СообщениеТекст = "Документ не может быть создан. Срок действия договора истек, необходимо оформить ДС на продления срока действия договора";
			КонецЕсли;
			ВызватьИсключение СообщениеТекст;
		КонецЕсли;
	КонецЕсли;
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И ДанныеЗаполнения.Свойство("Заявка")  Тогда
		ЗаполнитьПоЗаявке(ДанныеЗаполнения);		
	КонецЕсли;
	
	Организация	= Константы.ОсновнаяОрганизация.Получить();
	Создано 	= ТекущаяДатаСеанса();
	Автор 		= Пользователи.ТекущийПользователь();	
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	//++ДИТ Моисеенко Ю.В. task#60109 09.11.2022
	НепроверяемыеРеквизиты = Новый Массив;
	
	РеквизитыЛокации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЛокацияВыдачи, "Тип,Страна");
	//ДИТ Шевченко А.В. 11.01.23 63921 -начало
	//Если РеквизитыЛокации.Тип = Справочники.ТипыЛокаций.Субъект И РеквизитыЛокации.Страна = Справочники.СтраныМира.КИТАЙ Тогда
	//Евросиб - АСуслов 05.05.2023 11:40:02 #67492
	//(
	//Если РеквизитыЛокации.Тип = Справочники.ТипыЛокаций.Субъект И НЕ РеквизитыЛокации.Страна = Справочники.СтраныМира.Россия Тогда
	Если РеквизитыЛокации.Тип = Справочники.ТипыЛокаций.НаселенныйПункт И НЕ РеквизитыЛокации.Страна = Справочники.СтраныМира.Россия Тогда
	//)
	//Евросиб - АСуслов 05.05.2023 11:40:08 #67492
	//ДИТ Шевченко А.В. 11.01.23 63921 -конец	
		НепроверяемыеРеквизиты.Добавить("ТерминалВыдачи");
		НепроверяемыеРеквизиты.Добавить("Автоперевозка");
		
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	//--ДИТ Моисеенко Ю.В. task#60109 09.11.2022
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	ОчиститьПодстокиКонтейнеров();											
	
	// Если это отмена проведения или установлена пометка удаления, то проверим, что КТК не добавлены в заявку.
	// Если добавлены, то запрещаем действие.
	
	//ДИТ Шевченко А.В. 51340 17.10.2022 -начало
	Если Проведен И ПометкаУдаления Тогда	
		ТекстОшибки = "Перед пометкой на удаление необходимо отменить проведение документа!";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
															ТекстОшибки,
															ЭтотОбъект,
															,
															,
															Отказ);
	КонецЕсли;
	//ДИТ Шевченко А.В. 51340 17.10.2022 -конец
	
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения
		ИЛИ РежимЗаписи = РежимЗаписиДокумента.Запись И ПометкаУдаления Тогда 
		ШаблонСообщения = "Контейнер %1 добавлен в заявку %2.
					|Необходимо удалить контейнер из заявки перед отменой проведения документа";
		МассивИдентификаторов = Контейнеры.Выгрузить().ВыгрузитьКолонку("ИдентификаторСтроки");
		ЗаявкиСтрок = Документы.РелизКлиента.ПолучитьЗаявки(МассивИдентификаторов);
		Для Каждого ТекущийКТК Из Контейнеры Цикл
			ЗаявкаТекущегоКТК = ЗаявкиСтрок.Получить(ТекущийКТК.ИдентификаторСтроки);
			Если ЗаявкаТекущегоКТК <> Неопределено Тогда
				//ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23 -начало
				//ТекстОшибки = СтрШаблон(ШаблонСообщения, ТекущийКТК.КонтейнерУдалить, ЗаявкаТекущегоКТК);
				ТекстОшибки = СтрШаблон(ШаблонСообщения, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущийКТК.КлючАналитикиПеревозки,"Контейнер"), ЗаявкаТекущегоКТК);
				//ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23 -конец
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
															ТекстОшибки,
															ЭтотОбъект,
															ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Контейнеры", ТекущийКТК.НомерСтроки, "Контейнер"),
															,
															Отказ);
			КонецЕсли;	
		КонецЦикла;  
		
	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		// Task №45185. При отмене проведения документа Релиз клиента у которого имеются контейнеры в 
		// ТЧ – по таким контейнерам необходимо устанавливать статус "Свободен" в АРМ КТК Текущие данные.
		//ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23 -начало
		ТаблицаКонтейнеров = ПолучитьТаблицуКТКИзКлючейАналитикиТЧ();
		//ПроставитьСтатусКТК(Контейнеры.ВыгрузитьКолонку("Контейнер"),  Перечисления.СтатусыКТК.Свободен);
		ПроставитьСтатусКТК(ТаблицаКонтейнеров.ВыгрузитьКолонку("Контейнер"),  Перечисления.СтатусыКТК.Свободен);
		//ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23 -конец       
		
		//Евросиб(ДИТ) Сержантова А.С. US 77172 ТА 101741 Начало 07.02.2025
		УдаленныеКТК = ОбщегоНазначенияКлиентСервер.СвернутьМассив( ТаблицаКонтейнеров.ВыгрузитьКолонку("Контейнер"));
		ДополнительныеСвойства.Вставить("УдаленныеКТК", УдаленныеКТК);
		//Евросиб(ДИТ) Сержантова А.С. US 77172 ТА 101741 Конец 07.02.2025
	КонецЕсли;	
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда  
		
		// ДИТ US 76935 ТА 77189 Сержантова А.С. Начало: 07.12.2023 - если были изменения на форме, то берем данные ключей собранные перед записью на форме
		Если не ДополнительныеСвойства.Свойство("ДанныеДляОбновленияКлючейАналитики") Тогда 
		// ДИТ US 76935 ТА 77189 Сержантова А.С. Конец: 07.12.2023
		
		//ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23 -начало 
		//РаботаСТабличнымиЧастями.ПроверитьОтсутствиеДублейВТабличнойЧасти(ЭтотОбъект, "Контейнеры", Новый Структура("Контейнер"), Отказ);
		МассивСообщений = ПроверитьОтсутствиеДублейКТКВКлючахАналитики(Отказ);
		
		Для Каждого СообщениеДуль Из МассивСообщений Цикл
			ОбщегоНазначения.СообщитьПользователю(СообщениеДуль);
		КонецЦикла;
		//ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23 -конец  
		// ДИТ US 76935 ТА 77189 Сержантова А.С. Начало: 07.12.2023
		КонецЕсли;
		// ДИТ US 76935 ТА 77189 Сержантова А.С. Конец: 07.12.2023
		
		// Евросиб Фролов (16.02.2022 Task №46605
		// Если локация сдачи (мультилокация) содержит сток, то сообщим об этом пользователю. 
		Если ЛокацияПодходит(ЛокацияСдачи, Истина) Тогда
			ОбщегоНазначения.СообщитьПользователю("Локация сдачи содержит сток. Сохранение документа невозможно.",
													ЭтотОбъект,
													"ЛокацияСдачи",
													,
													Отказ);
		КонецЕсли;
		// Если сток сдачи (мультилокация) содержит типы локации отличные от стока, то сообщим об этом пользователю. 
		Если ЛокацияПодходит(СтокСдачи, Ложь) Тогда
			ОбщегоНазначения.СообщитьПользователю("Сток сдачи содержит типы локаций отличные от стока. Сохранение документа невозможно.",
													ЭтотОбъект,
													"СтокСдачи",
													,
													Отказ);
		КонецЕсли;										
		// Евросиб Фролов)
		
		// ++ ДИТ_Агафонов_task 50388 01.07.2022
		//Убираем
		//Если ВыдачаОтСобственника И НомернаяВыдача Тогда
		//	ОбщегоНазначения.СообщитьПользователю("Запрещена одновременная установка признаков ""Выдача от собственника"" и ""Номерная выдача""",
		//										ЭтотОбъект,
		//										"ВыдачаОтСобственника",
		//										,
		//										Отказ);
		//КонецЕсли;
		// -- ДИТ_Агафонов_task 50388 01.07.2022
		
		//++ДИТ Моисеенко Ю.В. task#60109 09.11.2022
		РеквизитыЛокации 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЛокацияВыдачи, "Тип,Страна");
		//ДИТ Шевченко А.В. 11.01.23 63921 -начало
		//ЭтоЛокацияКитай 	= (РеквизитыЛокации.Тип = Справочники.ТипыЛокаций.Субъект И РеквизитыЛокации.Страна = Справочники.СтраныМира.КИТАЙ);
		//Евросиб - АСуслов 05.05.2023 11:39:21 #67492
		//(
		//ЭтоЛокацияНеРоссия 	= (РеквизитыЛокации.Тип = Справочники.ТипыЛокаций.Субъект И НЕ РеквизитыЛокации.Страна = Справочники.СтраныМира.Россия);
		ЭтоЛокацияНеРоссия 	= (РеквизитыЛокации.Тип = Справочники.ТипыЛокаций.НаселенныйПункт И НЕ РеквизитыЛокации.Страна = Справочники.СтраныМира.Россия);
		//)
		//Евросиб - АСуслов 05.05.2023 11:39:23 #67492
		НеВыполнятьПроверкиЛокацииНеРоссия = ЭтоЛокацияНеРоссия И РежимЗаписи = РежимЗаписиДокумента.Проведение;
		//ДИТ Шевченко А.В. 11.01.23 63921 -конец
		//--ДИТ Моисеенко Ю.В. task#60109 09.11.2022
	
		Если ВыдачаОтСобственника Тогда
			Если Не ЗначениеЗаполнено(РелизСобственника) Тогда
		
				ОбщегоНазначения.СообщитьПользователю("Не заполнен релиз собственника",
												ЭтотОбъект,
												"РелизСобственника",
												,
												Отказ);
			КонецЕсли;										
		
			Если Не ЗначениеЗаполнено(СобственникКТК) Тогда
		
				ОбщегоНазначения.СообщитьПользователю("Не заполнен собственник КТК",
												ЭтотОбъект,
												"СобственникКТК",
												,
												Отказ);
			КонецЕсли;
		Иначе
			
			//++ДИТ Моисеенко Ю.В. task#60109 09.11.2022
			//Если Не ЗначениеЗаполнено(СтокВыдачи) Тогда
			Если Не НеВыполнятьПроверкиЛокацииНеРоссия И Не ЗначениеЗаполнено(СтокВыдачи) Тогда
			//--ДИТ Моисеенко Ю.В. task#60109 09.11.2022
			
				ОбщегоНазначения.СообщитьПользователю("Не заполнен сток выдачи",
												ЭтотОбъект,
												"СтокВыдачи",
												,
												Отказ);
			КонецЕсли;	
			
		КонецЕсли; 
		
		// ДИТ US 76935 ТА 77189 Сержантова А.С. Начало: 07.12.2023 
		//проверку по ключам аналитики проводим, если нет изменений данных ключей на форме  
		Если не ДополнительныеСвойства.Свойство("ДанныеДляОбновленияКлючейАналитики") Тогда
		// ДИТ US 76935 ТА 77189 Сержантова А.С. Конец: 07.12.2023
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	КлючиАналитикиПеревозкиМили.Ссылка КАК КлючАналитикиПеревозки,
		|	КлючиАналитикиПеревозкиМили.ЭтапПеревозки КАК ЭтапПеревозки,
		|	КлючиАналитикиПеревозкиМили.ДатаВыдачиКТКСТерминала КАК ДатаВыдачиКТКСТерминала,
		|	КлючиАналитикиПеревозкиМили.ДатаСдачиКТКНаТерминал КАК ДатаСдачиКТКНаТерминал,
		|	КлючиАналитикиПеревозкиМили.ДатаВыездаКТКСоСклада КАК ДатаВыездаКТКСоСклада,
		|	КлючиАналитикиПеревозкиМили.ФИОВодителя КАК ФИОВодителя,
		|	КлючиАналитикиПеревозкиМили.ПаспортныеДанные КАК ПаспортныеДанные,
		|	КлючиАналитикиПеревозкиМили.РегНомерТС КАК РегНомерТС,
		|	КлючиАналитикиПеревозкиМили.Автоперевозчик КАК Автоперевозчик,
		|	КлючиАналитикиПеревозкиМили.ИНН КАК ИНН,
		|	КлючиАналитикиПеревозкиМили.КПП КАК КПП,
		|	КлючиАналитикиПеревозкиМили.АдресКлиента КАК АдресКлиента
		|ИЗ
		|	Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозкиМили
		|ГДЕ
		|	КлючиАналитикиПеревозкиМили.Ссылка В(&Ссылка)
		|	И КлючиАналитикиПеревозкиМили.ЭтапПеревозки = ЗНАЧЕНИЕ(Перечисление.ЭтапыПеревозки.ПерваяМиля)
		|	;
		|	ВЫБРАТЬ
		|	КлючиАналитикиПеревозкиМили.Ссылка КАК КлючАналитикиПеревозки,
		|	КлючиАналитикиПеревозкиМили.ЭтапПеревозки КАК ЭтапПеревозки,
		|	КлючиАналитикиПеревозкиМили.ДатаВыдачиКТКСТерминала КАК ДатаВыдачиКТКСТерминала,
		|	КлючиАналитикиПеревозкиМили.ДатаСдачиКТКНаТерминал КАК ДатаСдачиКТКНаТерминал,
		|	КлючиАналитикиПеревозкиМили.ДатаВыездаКТКСоСклада КАК ДатаВыездаКТКСоСклада,
		|	КлючиАналитикиПеревозкиМили.ФИОВодителя КАК ФИОВодителя,
		|	КлючиАналитикиПеревозкиМили.ПаспортныеДанные КАК ПаспортныеДанные,
		|	КлючиАналитикиПеревозкиМили.РегНомерТС КАК РегНомерТС,
		|	КлючиАналитикиПеревозкиМили.Автоперевозчик КАК Автоперевозчик,
		|	КлючиАналитикиПеревозкиМили.ИНН КАК ИНН,
		|	КлючиАналитикиПеревозкиМили.КПП КАК КПП,
		|	КлючиАналитикиПеревозкиМили.АдресКлиента КАК АдресКлиента
		|ИЗ
		|	Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозкиМили
		|ГДЕ
		|	КлючиАналитикиПеревозкиМили.Ссылка В(&Ссылка)
		|	И КлючиАналитикиПеревозкиМили.ЭтапПеревозки = ЗНАЧЕНИЕ(Перечисление.ЭтапыПеревозки.ПоследняяМиля)";
		
		Запрос.УстановитьПараметр("Ссылка", Контейнеры.ВыгрузитьКолонку("КлючАналитикиПеревозки"));
		
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		
		ТЗПерваяМиляКлючиАналитики = РезультатЗапроса[0].Выгрузить();
		ТЗПоследняяМиляКлючиАналитики = РезультатЗапроса[1].Выгрузить();
		
		//ТЗПерваяМиляКлючиАналитики 	  = Справочники.КлючиАналитикиПеревозки.КлючиАналитикиЗначенияПолейПоЭтапуПеревозки(Контейнеры.ВыгрузитьКолонку("КлючАналитикиПеревозки"),Перечисления.ЭтапыПеревозки.ПерваяМиля);
		//ТЗПоследняяМиляКлючиАналитики = Справочники.КлючиАналитикиПеревозки.КлючиАналитикиЗначенияПолейПоЭтапуПеревозки(Контейнеры.ВыгрузитьКолонку("КлючАналитикиПеревозки"),Перечисления.ЭтапыПеревозки.ПоследняяМиля);
		
		Для Каждого ТекущаяСтрока Из Контейнеры Цикл
			
			ДатаВозвратаКлиентомП = Дата(1,1,1);
			ДатаВывозаП = Дата(1,1,1);	
			
			Если ЗначениеЗаполнено(ТекущаяСтрока.КлючАналитикиПеревозки) Тогда
				НайденнаяСтрокаТЗПерваяМиля 	= ТЗПерваяМиляКлючиАналитики.Найти(ТекущаяСтрока.КлючАналитикиПеревозки);
				Если НайденнаяСтрокаТЗПерваяМиля <> Неопределено Тогда
					ДатаВывозаП = НайденнаяСтрокаТЗПерваяМиля.ДатаВыдачиКТКСТерминала;
				КонецЕсли;
				НайденнаяСтрокаТЗПоследняяМиля 	= ТЗПоследняяМиляКлючиАналитики.Найти(ТекущаяСтрока.КлючАналитикиПеревозки);
				Если НайденнаяСтрокаТЗПоследняяМиля <> Неопределено Тогда
					ДатаВозвратаКлиентомП = НайденнаяСтрокаТЗПоследняяМиля.ДатаСдачиКТКНаТерминал;
				КонецЕсли;
			КонецЕсли;	
			
			Если ЗначениеЗаполнено(ДатаВозвратаКлиентомП) Тогда	
				
				// Если заполнена дата возврата контейнера и не заполнена дата вывоза, то ошибка
				Если Не ЗначениеЗаполнено(ДатаВывозаП) Тогда
					ОбщегоНазначения.СообщитьПользователю(
												"Не указана дата вывоза контейнера при заполненной дате возврата для него",
												ЭтотОбъект,
												ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Контейнеры", ТекущаяСтрока.НомерСтроки, "ДатаВывоза"),
												,
												Отказ);
				КонецЕсли;
			
			КонецЕсли;
			
			//ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23 -начало
			//Если Не ЗначениеЗаполнено(ТекущаяСтрока.КонтейнерУдалить) Тогда
			Если Не ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущаяСтрока.КлючАналитикиПеревозки,"Контейнер")) Тогда
			//ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23 -конец	
				
				Если Не ПустаяСтрока(ТекущаяСтрока.ИдентификаторСтрокиТС)
					ИЛИ Не ПустаяСтрока(ТекущаяСтрока.СдачаКонтейнераФИОВодителяУдалить)
					ИЛИ Не ПустаяСтрока(ТекущаяСтрока.СдачаКонтейнераРегНомерТСУдалить)
					ИЛИ (ЗначениеЗаполнено(ДатаВывозаП) И Не ВыдачаОтСобственника)
					ИЛИ ЗначениеЗаполнено(ДатаВозвратаКлиентомП)
					ИЛИ ЗначениеЗаполнено(ТекущаяСтрока.ИдентификаторСтрокиПеревозчика) Тогда
					ОбщегоНазначения.СообщитьПользователю(
												"Поле ""Контейнер"" не заполнено",
												ЭтотОбъект,
												ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Контейнеры", ТекущаяСтрока.НомерСтроки, "Контейнер"),
												,
												Отказ);
				КонецЕсли;
			
			КонецЕсли;
		
		КонецЦикла;	
		
		Если Не НомернаяВыдача
			Или НомернаяВыдача И СтатусСогласованияСпискаКТК = Перечисления.СтатусыСогласованияСпискаКТКСТерминалами.Согласован Тогда
			ПроверитьКоличествоТранспортныхСредств(Отказ);
		КонецЕсли;
											
		Если НомернаяВыдача Тогда
			
			Если СтатусСогласованияСпискаКТК = Перечисления.СтатусыСогласованияСпискаКТКСТерминалами.Согласован Тогда // по новому ФТ, было без проверки статуса согласования				
				// Проверим, что количество строк с заполненными КТК совпадает с общим количеством КТК
				//ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23 -начало
				//СтрокиБезКТК = Контейнеры.НайтиСтроки(Новый Структура("Контейнер", Справочники.те.ПустаяСсылка()));
					
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	ТЗ.КлючАналитикиПеревозки КАК Ключ
				|ПОМЕСТИТЬ ВТ_Ключи
				|ИЗ
				|	&ТЗ КАК ТЗ
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ВТ_Ключи.Ключ КАК Ключ
				|ИЗ
				|	ВТ_Ключи КАК ВТ_Ключи
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки КАК КлючиАналитикиПеревозки
				|		ПО ВТ_Ключи.Ключ = КлючиАналитикиПеревозки.Ссылка
				|ГДЕ
				|	КлючиАналитикиПеревозки.Контейнер = &Контейнер";
				
				Запрос.УстановитьПараметр("ТЗ", Контейнеры.Выгрузить(,"КлючАналитикиПеревозки"));
				Запрос.УстановитьПараметр("Контейнер", Справочники.ТЕ.ПустаяСсылка());
				
				РезультатЗапроса = Запрос.Выполнить().Выгрузить();
				СтрокиБезКТК = РезультатЗапроса.Количество();

				//КоличествоСтрокСКТК = Контейнеры.Количество() - СтрокиБезКТК.Количество();
				КоличествоСтрокСКТК = Контейнеры.Количество() - СтрокиБезКТК;
				//ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23 -конец
				Если КоличествоСтрокСКТК <> ОбщееКоличествоКТКВРелизе Тогда
					//ОбщегоНазначения.СообщитьПользователю("Заполненное количество контейнеров не совпадает с общим количество контейнеров в релизе",
					ОбщегоНазначения.СообщитьПользователю("Количество контейнеров не соответствует указанному в поле ""Общее количество КТК в релизе"". Проведение невозможно",
												ЭтотОбъект,
												"ОбщееКоличествоКТКВРелизе",
												,
												Отказ);
				КонецЕсли;			
			Иначе
				// Если номерная выдача и статус согласования КТК "Не согласовано", то в АРМ КТК будет добвлен статус "Предварительный резерв".
				// Зафиксируем в документе дату простановки этого статуса, чтобы потом ориентироваться на нее при отправке уведомлений по почте.
				
				//КТКБезДатыВывоза = Контейнеры.НайтиСтроки(Новый Структура("ДатаВывоза", Дата(1, 1, 1)));
				//ДатаРезерва = ТекущаяДата();	
				//Для Каждого ТекКТКБезДатыВывоза Из КТКБезДатыВывоза Цикл
				//	ТекКТКБезДатыВывоза.ДатаПредварительногоРезерва = ДатаРезерва;
				//КонецЦикла;
				
				ДатаРезерва = ТекущаяДата();
				МассивКлючей = Контейнеры.ВыгрузитьКолонку("КлючАналитикиПеревозки");
				
				ТаблицаПолейКлючей = Справочники.КлючиАналитикиПеревозки.КлючиАналитикиЗначенияПолейПоЭтапуПеревозки(МассивКлючей,Перечисления.ЭтапыПеревозки.ПерваяМиля);
				
				Для Каждого СтрокаК Из Контейнеры Цикл
					СтрокаЭтапаПеревозки = ТаблицаПолейКлючей.Найти(СтрокаК.КлючАналитикиПеревозки,"КлючАналитикиПеревозки");
					Если СтрокаЭтапаПеревозки = Неопределено ИЛИ СтрокаЭтапаПеревозки.ДатаВыдачиКТКСТерминала = Дата(1,1,1) Тогда
						СтрокаК.ДатаПредварительногоРезерва = ДатаРезерва;
					КонецЕсли;	
				КонецЦикла;	
				
			КонецЕсли;
			
			// По удаленным КТК проставим статус "Свободен"
			ПроверитьУдаленныеКТК(ДополнительныеСвойства);
		КонецЕсли;	 
		
		// ДИТ US 76935 ТА 77189 Сержантова А.С. Начало: 07.12.2023
		КонецЕсли;
		// ДИТ US 76935 ТА 77189 Сержантова А.С. Конец: 07.12.2023
		
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Если НЕ ОбщегоНазначенияВызовСервера.ЗначениеРеквизитаОбъекта(Ссылка,"Проведен") //ДИТ Шевченко А.В. 51340 12.10.2022	
				И Не СтатусОтправкиПолученияОтветаТерминала = Справочники.СибурСтатусыЗаявок.НеОтправлен Тогда // ДИТ US 57149 TA 66036 Евсенкин М.А. 28.02.2023
				ИзмененыКлючевыеПоля = Истина;
				СтатусОтправкиПолученияОтветаТерминала = Справочники.СибурСтатусыЗаявок.ВерсияОтправкиУстарела;
				ПисьмоНаЗапрос = Документы.ЭлектронноеПисьмоИсходящее.ПустаяСсылка();			
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;	

	// Заполним редактора и дату изменения
	Если Не ЭтоНовый() Тогда
   		Изменено = ТекущаяДатаСеанса();
		Редактор = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	// Заполним номер релиза
	Если Не ЗначениеЗаполнено(НомерРелиза) Тогда
		// Евросиб Фролов (29.04.2022 Ticket №0270765
		//НомерРелиза = Документы.РелизКлиента.ПолучитьНомерРелиза(ЭтотОбъект, ВыдачаОтСобственника, РелизСобственника, Номер);
		НомерРелиза = Документы.РелизКлиента.ПолучитьНомерРелиза(ЭтотОбъект, ВыдачаОтСобственника, РелизСобственника);
		// Евросиб Фролов)
		
		// Проверим, что номер релиза заполнился
		Если Не ЗначениеЗаполнено(НомерРелиза) 
			// Евросиб Фролов (30.05.2022 Task №49741
			И РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			// Евросиб Фролов)
			ОбщегоНазначения.СообщитьПользователю("Не заполнен номер релиза",
												ЭтотОбъект,
												"НомерРелиза",
												,
												Отказ);
		КонецЕсли;
	КонецЕсли;
	
	Если Не ВыдачаОтСобственника Тогда
		РелизСобственника = Документы.РелизСобственника.ПустаяСсылка();
	КонецЕсли;	

	Если Не НомернаяВыдача Тогда
		СтатусСогласованияСпискаКТК = Перечисления.СтатусыСогласованияСпискаКТКСТерминалами.ПустаяСсылка();
	Иначе
		Если Не ЗначениеЗаполнено(СтатусСогласованияСпискаКТК) Тогда
			СтатусСогласованияСпискаКТК = Перечисления.СтатусыСогласованияСпискаКТКСТерминалами.НеСогласован;
		КонецЕсли;	
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(ДатаОтправкиЗапросаТерминалу) Тогда
		ИзмененыКлючевыеПоля = Ложь;
	КонецЕсли;	     
	
	// ДИТ US 76935 ТА 77189 Сержантова А.С. Начало: 07.12.2023 ПроверкаИЗаписьДанныхКлючейАналитикиПеревозки
	//Убрали из формы интерактивную запись ключей аналитики при изменении реквизитов ТЧ. 
	//Теперь все изменения в форме фиксируются в доп свойствах "ДанныеДляОбновленияКлючейАналитики"
	//Здесь сначала проверим корректность заполнения данных для ключей, потом запишем их.
	#Область ПроверкаИЗаписьДанныхКлючейАналитикиПеревозки  
	Если ДополнительныеСвойства.Свойство("ДанныеДляОбновленияКлючейАналитики") Тогда
		
		ДанныеДляОбновленияКлючейАналитики = ДополнительныеСвойства.ДанныеДляОбновленияКлючейАналитики; 
		Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда   
			МассивСообщений = ПроверитьОтсутствиеДублейКТКВКлючахАналитики(Отказ, ДанныеДляОбновленияКлючейАналитики);
			Для Каждого СообщениеДубль Из МассивСообщений Цикл
				ОбщегоНазначения.СообщитьПользователю(СообщениеДубль);
			КонецЦикла;	
			
			Для Каждого ТекущаяСтрока Из ДанныеДляОбновленияКлючейАналитики Цикл
				
				ДатаВозвратаКлиентомП = Дата(1,1,1);
				ДатаВывозаП = Дата(1,1,1);	
				
				СтрокаТЗПерваяМиля = ТекущаяСтрока.ДанныеКлюча.СтруктураТЧМилиПерваяМиляКлючаАналитики;
				ДатаВывозаП = СтрокаТЗПерваяМиля.ДатаВыдачиКТКСТерминала;
				
				СтрокаТЗПоследняяМиля 	= ТекущаяСтрока.ДанныеКлюча.СтруктураТЧМилиПоследняяМиляКлючаАналитики;
				ДатаВозвратаКлиентомП = СтрокаТЗПоследняяМиля.ДатаСдачиКТКНаТерминал;
				
				Если ЗначениеЗаполнено(ДатаВозвратаКлиентомП) Тогда	
					
					// Если заполнена дата возврата контейнера и не заполнена дата вывоза, то ошибка
					Если Не ЗначениеЗаполнено(ДатаВывозаП) Тогда
						ОбщегоНазначения.СообщитьПользователю(
						"Не указана дата вывоза контейнера при заполненной дате возврата для него в строке " + ТекущаяСтрока.НомерСтроки,,,, Отказ);
					КонецЕсли;
					
				КонецЕсли;  
				
				ТекущаяСтрокаТЧ = Контейнеры.Найти(ТекущаяСтрока.НомерСтроки, "НомерСтроки");
				
				Если Не ЗначениеЗаполнено(ТекущаяСтрока.Контейнер) Тогда
					
					Если Не ПустаяСтрока(ТекущаяСтрокаТЧ.ИдентификаторСтрокиТС)
						ИЛИ Не ПустаяСтрока(ТекущаяСтрокаТЧ.СдачаКонтейнераФИОВодителяУдалить)
						ИЛИ Не ПустаяСтрока(ТекущаяСтрокаТЧ.СдачаКонтейнераРегНомерТСУдалить)
						ИЛИ (ЗначениеЗаполнено(ДатаВывозаП) И Не ВыдачаОтСобственника)
						ИЛИ ЗначениеЗаполнено(ДатаВозвратаКлиентомП)
						ИЛИ ЗначениеЗаполнено(ТекущаяСтрокаТЧ.ИдентификаторСтрокиПеревозчика) Тогда
						ОбщегоНазначения.СообщитьПользователю(
						"Поле ""Контейнер"" не заполнено в строке " + ТекущаяСтрока.НомерСтроки,,,,Отказ);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;	
						
			Если НомернаяВыдача Тогда
				
				Если СтатусСогласованияСпискаКТК = Перечисления.СтатусыСогласованияСпискаКТКСТерминалами.Согласован Тогда // по новому ФТ, было без проверки статуса согласования				
					// Проверим, что количество строк с заполненными КТК совпадает с общим количеством КТК
					
					СтрокиСПустымКТК = ДанныеДляОбновленияКлючейАналитики.НайтиСтроки(Новый Структура("Контейнер", Справочники.ТЕ.ПустаяСсылка()));
					СтрокиБезКТК = СтрокиСПустымКТК.Количество(); 
					
					КоличествоСтрокСКТК = Контейнеры.Количество() - СтрокиБезКТК;
					Если КоличествоСтрокСКТК <> ОбщееКоличествоКТКВРелизе Тогда
						ОбщегоНазначения.СообщитьПользователю("Количество контейнеров не соответствует указанному в поле ""Общее количество КТК в релизе"". Проведение невозможно",
						ЭтотОбъект,
						"ОбщееКоличествоКТКВРелизе",
						,
						Отказ);
					КонецЕсли;			
				Иначе
					// Если номерная выдача и статус согласования КТК "Не согласовано", то в АРМ КТК будет добвлен статус "Предварительный резерв".
					// Зафиксируем в документе дату простановки этого статуса, чтобы потом ориентироваться на нее при отправке уведомлений по почте.
					
					ДатаРезерва = ТекущаяДата();   
					
					Для каждого ТекущаяСтрока Из Контейнеры Цикл
						СтрокаДанныхКлюча = ДанныеДляОбновленияКлючейАналитики.Найти(ТекущаяСтрока.НомерСтроки, "НомерСтроки");	
						СтрокаДанныхПерваяМиля = СтрокаДанныхКлюча.ДанныеКлюча.СтруктураТЧМилиПерваяМиляКлючаАналитики;
					    Если СтрокаДанныхПерваяМиля.ДатаВыдачиКТКСТерминала = Дата(1,1,1) Тогда
							ТекущаяСтрока.ДатаПредварительногоРезерва = ДатаРезерва;
						КонецЕсли;	
					КонецЦикла;
					
				КонецЕсли;
				
				// По удаленным КТК проставим статус "Свободен"
				ПроверитьУдаленныеКТК(ДополнительныеСвойства);
			КонецЕсли;	 	
			
		КонецЕсли;  
		
		// все проверки пройдены, записываем ключи
		Если не Отказ и (РежимЗаписи = РежимЗаписиДокумента.Запись
			или РежимЗаписи = РежимЗаписиДокумента.Проведение) Тогда  
			//Евросиб(ДИТ) Сержантова А.С. US 77172 ТА 101741 Начало 07.02.2025
			КонтейнерыДоЗаписи = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(Ссылка.Контейнеры.Выгрузить().ВыгрузитьКолонку("КлючАналитикиПеревозки"), "Контейнер");
			//Евросиб(ДИТ) Сержантова А.С. US 77172 ТА 101741 Конец 07.02.2025
			Для каждого ТекущаяСтрока Из Контейнеры Цикл  
				СтрокаДляОбновления = ДанныеДляОбновленияКлючейАналитики.Найти(ТекущаяСтрока.НомерСтроки, "НомерСтроки");   
				ВерсияКлючаДоОбновления = СтрокаДляОбновления.КлючАналитикиПеревозки.ВерсияДанных; 
				ОбновленныйКлюч = Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтрокаДляОбновления.ДанныеКлюча); 
				ТекущаяСтрока.КлючАналитикиПеревозки = ОбновленныйКлюч.КлючАналитикиПеревозки;   
			КонецЦикла; 
			
			//Евросиб(ДИТ) Сержантова А.С. US 77172 ТА 101741 Начало 07.02.2025 
			КонтейнерыПослеЗаписи = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(Контейнеры.Выгрузить().ВыгрузитьКолонку("КлючАналитикиПеревозки"), "Контейнер");
			УдаленныеКТК = Новый Массив;
			Если КонтейнерыПослеЗаписи.Количество() < КонтейнерыДоЗаписи.Количество() Тогда   
				Для каждого КлючИКТК Из КонтейнерыДоЗаписи Цикл
					Если ЗначениеЗаполнено(КлючИКТК.Значение) и КонтейнерыПослеЗаписи.Получить(КлючИКТК.Ключ) = Неопределено Тогда
						УдаленныеКТК.Добавить(КлючИКТК.Значение);	
					КонецЕсли;
				КонецЦикла;		
			КонецЕсли;
			Если УдаленныеКТК.Количество() > 0 Тогда
				Если ДополнительныеСвойства.Свойство("УдаленныеКТК") = Истина Тогда
					ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДополнительныеСвойства.УдаленныеКТК, УдаленныеКТК, Истина);
				Иначе
					ДополнительныеСвойства.Вставить("УдаленныеКТК", УдаленныеКТК);
				КонецЕсли;
			КонецЕсли;
			//Евросиб(ДИТ) Сержантова А.С. US 77172 ТА 101741 Конец 07.02.2025
		КонецЕсли;  
		
	КонецЕсли;
	#КонецОбласти   
	// ДИТ US 76935 ТА 77189 Сержантова А.С. Конец: 07.12.2023
	
	// Если водители или перевозчики были удалены из табличных частей,
	// то нужно удалить их привязку с КТК.
	//Для Каждого ТекущийКТК Из Контейнеры Цикл
	//	Если ТранспортныеСредстваУдалить.Найти(ТекущийКТК.ИдентификаторСтрокиТС, "ИдентификаторСтроки") = Неопределено Тогда
	//		ТекущийКТК.ИдентификаторСтрокиТС = "";
	//	КонецЕсли;
	//КонецЦикла;
	
	// Евросиб Фролов (14.02.2022 Ticket№ 46606
	// При отмене проведения уведомляем терминал.
	// Уведомляем если отмена выполнена успешно.
	//Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения 
	//	И Не Отказ
	//	И ЗапросОтправленТерминалу Тогда
	//	УведомитьТерминалОбОтмене();
	//КонецЕсли;
	// Евросиб Фролов)
	
	Для Каждого ТекКТК Из Контейнеры Цикл
		Если Не ЗначениеЗаполнено(ТекКТК.ИдентификаторСтроки) Тогда
			ТекКТК.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;	
	КонецЦикла;    
	
	Документы.РелизКлиента.ОбновитьИтоги(ЭтотОбъект);	

	// Евросиб Фролов (28.02.2022 Task №46354	
	ДополнительныеСвойства.Вставить("ОбъектДоЗаписи", ПодсвечиваниеПолейОбъектов.ПолучитьСтруктуруРеквизитовОбъекта(Ссылка));
	ДополнительныеСвойства.Вставить("ЭтоНовый", ЭтоНовый());
	//ОчищатьЗаписиРегистраПодсветки = ВнутреннийСтатусЗапроса = Перечисления.ВнутренниеСтатусыЗапросовНаКТК.Отработан
	//								И ВнутреннийСтатусЗапроса <> Ссылка.ВнутреннийСтатусЗапроса;
	//ДополнительныеСвойства.Вставить("ОчищатьЗаписиРегистраПодсветки", ОчищатьЗаписиРегистраПодсветки);
	// Евросиб Фролов)

	// ++ ДИТ_Агафонов_task 57613 19.10.2022
	//Остальное в обработке проведения
	Если Не Отказ и РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		ПроверитьУдалитьСвязьРелизов(Истина);    
	КонецЕсли;
	// -- ДИТ_Агафонов_task 57613 19.10.2022
	
	//ДИТ Шевченко А.В. US 62489 ТА 68009 02.05.2023 -Начало
	Если НЕ Отказ И ЗначениеЗаполнено(Ссылка) Тогда
		Если СтатусОтправкиПолученияОтветаТерминала <> Ссылка.СтатусОтправкиПолученияОтветаТерминала Тогда
			ОбновитьСтатусОтправкиВСвязанныхЗапросахНаАвтоперевозку();
		КонецЕсли;
	КонецЕсли;	
	//ДИТ Шевченко А.В. US 62489 ТА 68009 02.05.2023 -Конец  
	
	// ДИТ US 80736 ТА 81088 Сержантова А.С. Начало: 27.02.2024
	Если не Отказ и (не ЗначениеЗаполнено(Ссылка) или Ссылка.ТерминалВыдачи <> ТерминалВыдачи или Ссылка.СтокСдачи <> СтокСдачи) Тогда
		ПроверитьЗапросНаАвтоСоздатьЗадачуНаОбновление();
	КонецЕсли;
	// ДИТ US 80736 ТА 81088 Сержантова А.С. Конец: 27.02.2024
КонецПроцедуры

Процедура ПриЗаписи(Отказ, РежимЗаписи)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ИдентификаторСтрокиЗаявки = "";
	ДополнительныеСвойства.Свойство("ИдентификаторСтрокиЗаявки", ИдентификаторСтрокиЗаявки);
	
	Если Не Отказ
		И ЗначениеЗаполнено(Заявка)
		И ТипЗнч(ИдентификаторСтрокиЗаявки) = Тип("Строка")
		И Не ПустаяСтрока(ИдентификаторСтрокиЗаявки) Тогда
		РегистрыСведений.РелизыКлиентовЗапросовНаКТК.ПривязатьРелизКЗапросу(Заявка, ИдентификаторСтрокиЗаявки, Ссылка, Отказ);
		//Евросиб Коханенко Н.А. 02.04.2024 (( #80513 			
		//ЗаполнитьРегистрСвязанныеОбъектыПоРелизуКлиента(); // Рыбьяков К.А. Перенес в общий модуль СвязанныеДокументыСервер
		//Евросиб Коханенко Н.А. 02.04.2024 )) #80513 
	КонецЕсли;        
	
	//Евросиб(ДИТ) Сержантова А.С. US 77172 ТА 83838 Начало 06.02.2025 
	Если не Отказ и ДополнительныеСвойства.Свойство("УдаленныеКТК") и ДополнительныеСвойства.УдаленныеКТК.Количество() Тогда
		СтатусыКТКСервер.ПроверитьИзменениеИЗаписатьСтатусыКТК(Ссылка, ДополнительныеСвойства);
	КонецЕсли;
	//Евросиб(ДИТ) Сержантова А.С. US 77172 ТА 83838 Конец 06.02.2025
		
