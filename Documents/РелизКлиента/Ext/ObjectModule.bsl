		// ДИТ US 80736 ТА 81088 Сержантова А.С. Начало 05.03.2024
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "|	И НЕ ЗапросНаАвтоперевозкуКонтейнеры.НеТребуетсяТерминалВыдачи", "");
