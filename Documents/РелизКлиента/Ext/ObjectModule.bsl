Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	//ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23 -начало
	//МассивКонтейнеров = Контейнеры.ВыгрузитьКолонку("Контейнер");
	ТаблицаКонтейнеров = ПолучитьТаблицуКТКИзКлючейАналитикиТЧ();
	МассивКонтейнеров = ТаблицаКонтейнеров.ВыгрузитьКолонку("Контейнер");
	//ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23 -начало
	
	ТаблицаСведенийТекущиеДанные = СведенияПоКТКИзАРМ(МассивКонтейнеров);
	//ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23 -начало
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КлючиАналитикиПеревозкиМили.Ссылка КАК КлючАналитикиПеревозки,
		|	КлючиАналитикиПеревозкиМили.ЭтапПеревозки КАК ЭтапПеревозки,
		|	КлючиАналитикиПеревозкиМили.ДатаВыдачиКТКСТерминала КАК ДатаВыдачиКТКСТерминала,
		|	КлючиАналитикиПеревозкиМили.ДатаСдачиКТКНаТерминал КАК ДатаСдачиКТКНаТерминал,
		|	КлючиАналитикиПеревозкиМили.ДатаВыездаКТКСоСклада КАК ДатаВыездаКТКСоСклада,
		|	КлючиАналитикиПеревозкиМили.ФИОВодителя КАК ФИОВодителя,
		|	КлючиАналитикиПеревозкиМили.ПаспортныеДанные КАК ПаспортныеДанные,
		|	КлючиАналитикиПеревозкиМили.РегНомерТС КАК РегНомерТС,
		|	КлючиАналитикиПеревозкиМили.Автоперевозчик КАК Автоперевозчик,
		|	КлючиАналитикиПеревозкиМили.ИНН КАК ИНН,
		|	КлючиАналитикиПеревозкиМили.КПП КАК КПП,
		|	КлючиАналитикиПеревозкиМили.АдресКлиента КАК АдресКлиента
		|ИЗ
		|	Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозкиМили
		|ГДЕ
		|	КлючиАналитикиПеревозкиМили.Ссылка В(&Ссылка)
		|	И КлючиАналитикиПеревозкиМили.ЭтапПеревозки = ЗНАЧЕНИЕ(Перечисление.ЭтапыПеревозки.ПерваяМиля)
		|	И КлючиАналитикиПеревозкиМили.Ссылка.Контейнер <> Значение(Справочник.ТЕ.ПустаяСсылка)
		|	;
		|	ВЫБРАТЬ
		|	КлючиАналитикиПеревозкиМили.Ссылка КАК КлючАналитикиПеревозки,
		|	КлючиАналитикиПеревозкиМили.ЭтапПеревозки КАК ЭтапПеревозки,
		|	КлючиАналитикиПеревозкиМили.ДатаВыдачиКТКСТерминала КАК ДатаВыдачиКТКСТерминала,
		|	КлючиАналитикиПеревозкиМили.ДатаСдачиКТКНаТерминал КАК ДатаСдачиКТКНаТерминал,
		|	КлючиАналитикиПеревозкиМили.ДатаВыездаКТКСоСклада КАК ДатаВыездаКТКСоСклада,
		|	КлючиАналитикиПеревозкиМили.ФИОВодителя КАК ФИОВодителя,
		|	КлючиАналитикиПеревозкиМили.ПаспортныеДанные КАК ПаспортныеДанные,
		|	КлючиАналитикиПеревозкиМили.РегНомерТС КАК РегНомерТС,
		|	КлючиАналитикиПеревозкиМили.Автоперевозчик КАК Автоперевозчик,
		|	КлючиАналитикиПеревозкиМили.ИНН КАК ИНН,
		|	КлючиАналитикиПеревозкиМили.КПП КАК КПП,
		|	КлючиАналитикиПеревозкиМили.АдресКлиента КАК АдресКлиента
		|ИЗ
		|	Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозкиМили
		|ГДЕ
		|	КлючиАналитикиПеревозкиМили.Ссылка В(&Ссылка)
		|	И КлючиАналитикиПеревозкиМили.ЭтапПеревозки = ЗНАЧЕНИЕ(Перечисление.ЭтапыПеревозки.ПоследняяМиля)
		|	И КлючиАналитикиПеревозкиМили.Ссылка.Контейнер <> Значение(Справочник.ТЕ.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("Ссылка", Контейнеры.ВыгрузитьКолонку("КлючАналитикиПеревозки"));
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ТЗПерваяМиляКлючиАналитики = РезультатЗапроса[0].Выгрузить();
    ТЗПоследняяМиляКлючиАналитики = РезультатЗапроса[1].Выгрузить();
	
	//ТЗПерваяМиляКлючиАналитики 	  = Справочники.КлючиАналитикиПеревозки.КлючиАналитикиЗначенияПолейПоЭтапуПеревозки(Контейнеры.ВыгрузитьКолонку("КлючАналитикиПеревозки"),Перечисления.ЭтапыПеревозки.ПерваяМиля);
	//ТЗПоследняяМиляКлючиАналитики = Справочники.КлючиАналитикиПеревозки.КлючиАналитикиЗначенияПолейПоЭтапуПеревозки(Контейнеры.ВыгрузитьКолонку("КлючАналитикиПеревозки"),Перечисления.ЭтапыПеревозки.ПоследняяМиля);
	//ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23 -конец
	ВыполнитьЗаписьВКлиентскоеОперирование(МассивКонтейнеров, Отказ);
	
	Для Каждого ТекущийКТК Из Контейнеры Цикл
		//ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23 -начало	
		ВыполнитьЗаписьВТекущиеДанные(ТекущийКТК, Отказ, ТаблицаСведенийТекущиеДанные,ТЗПерваяМиляКлючиАналитики,ТЗПоследняяМиляКлючиАналитики);
		//ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23 -конец
		Если ДополнительныеСвойства.Свойство("МассивУдаленныхКТК") = Истина Тогда
			ПроставитьСтатусКТК(ДополнительныеСвойства.МассивУдаленныхКТК,  Перечисления.СтатусыКТК.Свободен);
		КонецЕсли;	
		
	КонецЦикла; 
	
	//Евросиб(ДИТ) Сержантова А.С. US 77172 ТА 83838 Начало 06.02.2025
	СтатусыКТКСервер.ПроверитьИзменениеИЗаписатьСтатусыКТК(Ссылка, ДополнительныеСвойства); 
	//Евросиб(ДИТ) Сержантова А.С. US 77172 ТА 83838 Конец 06.02.2025
	
	// Евросиб Фролов (28.02.2022 Task №46354
	ДвиженияПодсветкаФормДокументов(Отказ, РежимПроведения);
	// Евросиб Фролов)
	
	// ++ ДИТ_Агафонов_task 57613 19.10.2022
	//Нужно выполнять всегда, могут снять флажок ВыдачаОтСобственника
	ПроверитьУдалитьСвязьРелизов();
	// -- ДИТ_Агафонов_task 57613 19.10.2022
	
	// Евросиб Фролов (30.05.2022 Task №49741
	Если ВыдачаОтСобственника Тогда
		ОбновитьРелизСобственника(КонтейнерыДляРелизаСобственника(), Отказ);
	КонецЕсли;	
	// Евросиб Фролов)
	
	//ДИТ Шевченко А.В. BUG 75526 TA 75527 02.10.23 -Начало
	Документы.РелизКлиента.ЗакрытьЗадачиВЗаявке(Заявка,СтатусОтправкиПолученияОтветаТерминала);
	//ДИТ Шевченко А.В. BUG 75526 TA 75527 02.10.23 -Конец 
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	стоки_КлиентскоеОперирование.Период КАК Период,
	|	стоки_КлиентскоеОперирование.КТК КАК КТК
	|ПОМЕСТИТЬ втЗаписиСРелизом
	|ИЗ
	|	РегистрСведений.стоки_КлиентскоеОперирование КАК стоки_КлиентскоеОперирование
	|ГДЕ
	|	стоки_КлиентскоеОперирование.кл_Релиз = &Релиз
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	стоки_КлиентскоеОперирование.Период КАК Период,
	|	стоки_КлиентскоеОперирование.КТК КАК КТК
	|ИЗ
	|	 втЗаписиСРелизом КАК втЗаписиСРелизом
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.стоки_КлиентскоеОперирование КАК стоки_КлиентскоеОперирование
	|		ПО втЗаписиСРелизом.КТК = стоки_КлиентскоеОперирование.КТК
	|			И втЗаписиСРелизом.Период <= стоки_КлиентскоеОперирование.Период";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Релиз", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.стоки_КлиентскоеОперирование.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Период.Установить(Выборка.Период);
		НаборЗаписей.Отбор.КТК.Установить(Выборка.КТК);
		НаборЗаписей.Записать();
		
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции	

Процедура ОбновитьСтатусОтправкиВСвязанныхЗапросахНаАвтоперевозку() //ДИТ Шевченко А.В. US 62489 ТА 68009 02.05.2023
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗапросНаАвтоперевозкуКонтейнеры.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗапросНаАвтоперевозку.Контейнеры КАК ЗапросНаАвтоперевозкуКонтейнеры
		|ГДЕ
		|	ЗапросНаАвтоперевозкуКонтейнеры.Релиз = &Релиз
		|	И ЗапросНаАвтоперевозкуКонтейнеры.Ссылка.Проведен
		|	И НЕ ЗапросНаАвтоперевозкуКонтейнеры.Ссылка.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Релиз", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	СтрокиКвыгрузке = Новый ТаблицаЗначений;
	СтрокиКвыгрузке.Колонки.Добавить("ИдентификаторСтрокиТабличнойЧасти");
	СтрокиКвыгрузке.Колонки.Добавить("ИдентификаторСтрокиТЧ");
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗапросОб = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		СтрокиКвыгрузке.Очистить();
		Для Каждого СтрокаК Из ЗапросОб.Контейнеры Цикл
			Если СтрокаК.Релиз = Ссылка Тогда
				СтатусДоИзменения = СтрокаК.СтатусОтправкиЗапросаНаТерминалВыдачи;
				Документы.ЗапросНаАвтоперевозку.ЗаполнитьСтатусОтправкиЗапросаНаТерминалВыдачиПоРелизу(СтрокаК,ЭтотОбъект);
				Если СтрокаК.СтатусЗапросаНаАвтоперевозку <> Перечисления.СтатусЗапросаНаПеревозку.Отменен
					И СтрокаК.СтатусЗаказаНаТС <> Перечисления.СтатусЗаказаНаТс.ВыданВРейс
					И СтрокаК.СтатусЗаказаНаТС <> Перечисления.СтатусЗаказаНаТс.Закрыт Тогда
					Если СтрокаК.СтатусЗапросаНаАвтоперевозку = Перечисления.СтатусЗапросаНаПеревозку.Отправлен Тогда
						Если СтрокаК.СтатусОтправкиЗапросаНаТерминалВыдачи <> СтатусДоИзменения Тогда
							ЗаполнитьЗначенияСвойств(СтрокиКвыгрузке.Добавить(),СтрокаК);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;		
			КонецЕсли;	
		КонецЦикла;
		Попытка
			ЗапросОб.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ЗаписьЖурналаРегистрации("ОшибкаЗаписиЗапросаНаАвто"
				, УровеньЖурналаРегистрации.Ошибка, ЗапросОб.Метаданные(), ЗапросОб.Ссылка, ОписаниеОшибки());
			Документы.ЗапросНаАвтоперевозку.ОтправитьПисьмоОбОшибкахЗаписиЗапросаНаАвто("Ошибка записи запроса на авто при изменение статуса отправки/получения статуса от терминала.",ЗапросОб.Ссылка);
			Возврат;
		КонецПопытки;
		Если СтрокиКвыгрузке.Количество() Тогда
			ПараметрыВыгрузки = Новый Структура("СсылкаЗапросНаАвтоперевозку, СтрокиКВыгрузке", ЗапросОб.Ссылка, СтрокиКвыгрузке);
			ЕСОбменСервер.ПередатьЗапросыНаАвтоВТЛ(ПараметрыВыгрузки);
		КонецЕсли;	
	КонецЦикла;
		
КонецПроцедуры

Процедура ЗаполнитьПоЗаявке(ДанныеЗаполнения)

	РеквизитыДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заявка, "Организация");
	Организация = РеквизитыДокументаОснования.Организация;
	//ДИТ Шевченко А.В. US 62421 TA 68370 10.04.2023 -Начало
	//ТаблицаТранспортныхСредств = ДанныеЗаполнения.ТранспортныеСредства.Получить();	
	
	//ТранспортныеСредстваУдалить.Загрузить(ТаблицаТранспортныхСредств);
	//ДИТ Шевченко А.В. 59364 13.03.2023 -начало
	//ТаблицаТранспортныхСредствПоследняяМиля = ДанныеЗаполнения.ТранспортныеСредстваПоследняяМиля.Получить();	
	//ТранспортныеСредстваПоследняяМиляУдалить.Загрузить(ТаблицаТранспортныхСредствПоследняяМиля);
	//ДИТ Шевченко А.В. 59364 13.03.2023 -конец
	
	МассивКлючейИтог = Новый Массив;
	ТаблицаТранспортныхСредств = ДанныеЗаполнения.ТранспортныеСредства.Получить();
	Для Каждого Стр Из ТаблицаТранспортныхСредств Цикл
		МассивКлючейИтог.Добавить(Стр.КлючАналитикиПеревозки);
	КонецЦикла;	
	ТаблицаТранспортныхСредствПоследняяМиля = ДанныеЗаполнения.ТранспортныеСредстваПоследняяМиля.Получить();
	Для Каждого Стр Из ТаблицаТранспортныхСредствПоследняяМиля Цикл
		МассивКлючейИтог.Добавить(Стр.КлючАналитикиПеревозки);
	КонецЦикла;
	//ДИТ Шевченко А.В. US 62421 TA 68370 10.04.2023 -Конец
	//ДИТ Шевченко А.В. US 62421 TA 64347 21.02.2023 -начало
	МассивКлючей = ПолучитьКлючиИзЗапросаНаАвтоперевозку(ДанныеЗаполнения.Заявка,ДанныеЗаполнения.ИдентификаторСтроки);
	//ДИТ Шевченко А.В. 59364 13.03.2023 -начало
	Для Каждого КлючМ Из МассивКлючей Цикл
		МассивКлючейИтог.Добавить(КлючМ);
	КонецЦикла;  
	
	// ДИТ US 78243 ТА 80591 Сержантова А.С. Начало: 07.02.2024
	МассивКлючейИтог = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивКлючейИтог);
	// ДИТ US 78243 ТА 80591 Сержантова А.С. Конец: 07.02.2024
	
	Для Каждого КлючМ Из МассивКлючейИтог Цикл
		НовСтрока = Контейнеры.Добавить();
		НовСтрока.КлючАналитикиПеревозки = КлючМ;
	КонецЦикла;
	
	//Субботин 77659 15.12.2023 Начало
	//КолДобавляемыхСтрок = ДанныеЗаполнения.ОбщееКоличествоКТКВРелизе - МассивКлючейИтог.Количество();
	//Для Инд = 1 По КолДобавляемыхСтрок Цикл
	//	НовСтрока = Контейнеры.Добавить();
	//	СтруктураКлюча  = Справочники.КлючиАналитикиПеревозки.СтруктураКлючаАналитикиПеревозки(); 
	//	СтруктураКлюча.Вставить("Заявка",ДанныеЗаполнения.Заявка);
	//	СтрОтвет = Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлюча);
	//	НовСтрока.КлючАналитикиПеревозки = СтрОтвет.КлючАналитикиПеревозки;
	//КонецЦикла; 
	//
	//Субботин 77659 15.12.2023 Начало 
	Если ДанныеЗаполнения.МассивКТК.Количество() = 0 тогда  
		КолДобавляемыхСтрок = ДанныеЗаполнения.ОбщееКоличествоКТКВРелизе - МассивКлючейИтог.Количество();
		Для Инд = 1 По КолДобавляемыхСтрок Цикл
			НовСтрока = Контейнеры.Добавить();
			СтруктураКлюча  = Справочники.КлючиАналитикиПеревозки.СтруктураКлючаАналитикиПеревозки(); 
			СтруктураКлюча.Вставить("Заявка",ДанныеЗаполнения.Заявка);
			СтрОтвет = Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлюча);
			НовСтрока.КлючАналитикиПеревозки = СтрОтвет.КлючАналитикиПеревозки;
		КонецЦикла;
	Иначе
		Для Каждого Ктк Из ДанныеЗаполнения.МассивКТК Цикл
			СуществющийКлюч = Контейнеры.Найти(ДанныеЗаполнения.СоответствиеКлючейАналитики.Получить(Ктк), "КлючАналитикиПеревозки");
			Если СуществющийКлюч = Неопределено Тогда 
				КлючДляДобавления = ДанныеЗаполнения.СоответствиеКлючейАналитики.Получить(Ктк);
				Если ЗначениеЗаполнено(КлючДляДобавления) Тогда	
					НовСтрока = Контейнеры.Добавить(); 
					НовСтрока.КлючАналитикиПеревозки = КлючДляДобавления;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	//Субботин 77659 15.12.2023 Конец
	
	//ДИТ Шевченко А.В. US 62421 TA 68370 10.04.2023 -Конец	
	//ДИТ Шевченко А.В. US 62421 TA 64347 21.02.2023 -конец
КонецПроцедуры

Функция ПолучитьКлючиИзЗапросаНаАвтоперевозку(Заявка,ИдентификаторСтроки) Экспорт //ДИТ Шевченко А.В. US 62421 TA 64347 21.02.2023		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗапросНаАвтоперевозкуКонтейнеры.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки
		|ИЗ
		|	Документ.ЗапросНаАвтоперевозку.Контейнеры КАК ЗапросНаАвтоперевозкуКонтейнеры
		|ГДЕ
		|	НЕ ЗапросНаАвтоперевозкуКонтейнеры.Ссылка.ПометкаУдаления  
		// ДИТ US 79950 ТА 79951 Сержантова А.С. Начало: 22.02.2024
		|	И ЗапросНаАвтоперевозкуКонтейнеры.СтатусЗапросаНаАвтоперевозку <> ЗНАЧЕНИЕ(Перечисление.СтатусЗапросаНаПеревозку.Отменен)
		// ДИТ US 79950 ТА 79951 Сержантова А.С. Конец: 22.02.2024
		|	И ЗапросНаАвтоперевозкуКонтейнеры.ИдентификаторСтрокиЗапроса = &ИдентификаторСтрокиЗапроса
		|	И ЗапросНаАвтоперевозкуКонтейнеры.Ссылка.Заявка = &Заявка";
	
	Запрос.УстановитьПараметр("Заявка", Заявка);
	Запрос.УстановитьПараметр("ИдентификаторСтрокиЗапроса", ИдентификаторСтроки);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("КлючАналитикиПеревозки");
	
КонецФункции	

Процедура ПроверитьУдаленныеКТК(ДополнительныеСвойства)
	
	// Доп. требования по Task №45185
	// Если в релизе клиента имеется галка "Номерная выдача", то при удалении контейнера из ТЧ проведенного
	// релиза клиента и при проведении документа необходимо устанавливать статус "Свободен" по этому контейнеру в АРМ КТК Текущие данные.
	
	// В доп. свойства документа поместим КТК, которые были удалены и передадим их в процедуру проведения.
	
	#Область СтарыйЗапрос
	//ТекстЗапроса =
	//"ВЫБРАТЬ
	//|	РелизКлиентаКонтейнеры.Контейнер КАК Контейнер
	//|ПОМЕСТИТЬ втКТКСсылки
	//|ИЗ
	//|	Документ.РелизКлиента.Контейнеры КАК РелизКлиентаКонтейнеры
	//|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.стоки_ТекущиеДанные.СрезПоследних КАК стоки_ТекущиеДанныеСрезПоследних
	//|		ПО РелизКлиентаКонтейнеры.Контейнер = стоки_ТекущиеДанныеСрезПоследних.КТК
	//|ГДЕ
	//|	РелизКлиентаКонтейнеры.Ссылка.Проведен
	//|	И РелизКлиентаКонтейнеры.Ссылка = &Ссылка
	//|	И стоки_ТекущиеДанныеСрезПоследних.тек_Статус <> &Свободен
	//|;
	//|
	//|////////////////////////////////////////////////////////////////////////////////
	//|ВЫБРАТЬ
	//|	КонтейнерыОбъекта.Контейнер КАК Контейнер
	//|ПОМЕСТИТЬ втКТКОбъекта
	//|ИЗ
	//|	&КонтейнерыОбъекта КАК КонтейнерыОбъекта
	//|;
	//|
	//|////////////////////////////////////////////////////////////////////////////////
	//|ВЫБРАТЬ
	//|	втКТКСсылки.Контейнер КАК Контейнер
	//|ИЗ
	//|	втКТКСсылки КАК втКТКСсылки
	//|		ЛЕВОЕ СОЕДИНЕНИЕ втКТКОбъекта КАК втКТКОбъекта
	//|		ПО втКТКСсылки.Контейнер = втКТКОбъекта.Контейнер
	//|ГДЕ
	//|	втКТКОбъекта.Контейнер ЕСТЬ NULL";
	#КонецОбласти
	
	//ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23 -начало
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	РелизКлиентаКонтейнеры.КлючАналитикиПеревозки.Контейнер КАК Контейнер
	|ПОМЕСТИТЬ втКТКСсылки
	|ИЗ
	|	Документ.РелизКлиента.Контейнеры КАК РелизКлиентаКонтейнеры
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.стоки_ТекущиеДанные.СрезПоследних КАК стоки_ТекущиеДанныеСрезПоследних
	|		ПО РелизКлиентаКонтейнеры.КлючАналитикиПеревозки.Контейнер = стоки_ТекущиеДанныеСрезПоследних.КТК
	|ГДЕ
	|	РелизКлиентаКонтейнеры.Ссылка.Проведен
	|	И РелизКлиентаКонтейнеры.Ссылка = &Ссылка
	|	И стоки_ТекущиеДанныеСрезПоследних.тек_Статус <> &Свободен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ   
	// ДИТ US 76935 ТА 77189 Сержантова А.С. Начало: 08.12.2023
	// Было:
	//|	ВЫРАЗИТЬ(КонтейнерыОбъекта.КлючАналитикиПеревозки КАК СПравочник.КлючиАналитикиПеревозки) КАК Ключ 
	//Стало:
	|	ВЫРАЗИТЬ(КонтейнерыОбъекта.КлючАналитикиПеревозки КАК Справочник.КлючиАналитикиПеревозки).Контейнер КАК Контейнер
	// ДИТ US 76935 ТА 77189 Сержантова А.С. Конец: 08.12.2023
	//|	КонтейнерыОбъекта.КлючАналитикиПеревозки.Контейнер КАК Контейнер
	|ПОМЕСТИТЬ втКТКОбъекта1
	|ИЗ
	|	&КонтейнерыОбъекта КАК КонтейнерыОбъекта 
	|;
	|ВЫБРАТЬ  
	// ДИТ US 76935 ТА 77189 Сержантова А.С. Начало: 08.12.2023
	// Было:
	//|	втКТКОбъекта1.Ключ.Контейнер КАК Контейнер 
	//Стало:
	|	втКТКОбъекта1.Контейнер КАК Контейнер
	// ДИТ US 76935 ТА 77189 Сержантова А.С. Конец: 08.12.2023
	|ПОМЕСТИТЬ втКТКОбъекта
	|ИЗ
	|	втКТКОбъекта1 КАК втКТКОбъекта1
	// ДИТ US 76935 ТА 77189 Сержантова А.С. Начало: 08.12.2023
	|ГДЕ
	|	НЕ &ЕстьИзмененияНаФорме
	|
	|Объединить
	|
	|ВЫБРАТЬ
	|	ТЧФормы.Контейнер
	|ИЗ
	|	втКТКОбъекта1 КАК ТЧФормы
	|ГДЕ
	|	&ЕстьИзмененияНаФорме
	// ДИТ US 76935 ТА 77189 Сержантова А.С. Конец: 08.12.2023
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втКТКСсылки.Контейнер КАК Контейнер
	|ИЗ
	|	втКТКСсылки КАК втКТКСсылки
	|		ЛЕВОЕ СОЕДИНЕНИЕ втКТКОбъекта КАК втКТКОбъекта
	|		ПО втКТКСсылки.Контейнер = втКТКОбъекта.Контейнер
	|ГДЕ
	|	втКТКОбъекта.Контейнер ЕСТЬ NULL";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка); 
	Запрос.УстановитьПараметр("КонтейнерыОбъекта", Контейнеры.Выгрузить());
	Запрос.УстановитьПараметр("Свободен", Перечисления.СтатусыКТК.Свободен); 
	
	// ДИТ US 76935 ТА 77189 Сержантова А.С. Начало: 08.12.2023  
	// если данные ключа обновлены из формы документа, то берем КТК из данных формы 
	Если ДополнительныеСвойства.Свойство("ДанныеДляОбновленияКлючейАналитики") Тогда   
		КТКСФормы = ДополнительныеСвойства.ДанныеДляОбновленияКлючейАналитики.Скопировать(, "Контейнер"); 
		Запрос.Текст = СтрЗаменить(Запрос.Текст, 
					"ВЫРАЗИТЬ(КонтейнерыОбъекта.КлючАналитикиПеревозки КАК Справочник.КлючиАналитикиПеревозки)",
					"КонтейнерыОбъекта");
		Запрос.УстановитьПараметр("КонтейнерыОбъекта", КТКСФормы); 
		Запрос.УстановитьПараметр("ЕстьИзмененияНаФорме", Истина);
	Иначе
		Запрос.УстановитьПараметр("ЕстьИзмененияНаФорме", Ложь);
	КонецЕсли;
	// ДИТ US 76935 ТА 77189 Сержантова А.С. Конец: 08.12.2023
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		МассивУдаленныхКТК = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Контейнер");
		ДополнительныеСвойства.Вставить("МассивУдаленныхКТК", МассивУдаленныхКТК); 
	КонецЕсли;	
	
КонецПроцедуры

Процедура ПроставитьСтатусКТК(МассивКТК,  СтатусКТК)	
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	стоки_ТекущиеДанныеСрезПоследних.КТК КАК КТК
	|ИЗ
	|	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних(, КТК В (&МассивКТК)) КАК стоки_ТекущиеДанныеСрезПоследних
	|ГДЕ
	|	стоки_ТекущиеДанныеСрезПоследних.тек_Статус <> &СтатусКТК";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("МассивКТК", МассивКТК);
	Запрос.УстановитьПараметр("СтатусКТК", СтатусКТК);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ТекущиеДанные = Новый Соответствие;
			ТекущиеДанные.Вставить("тек_Статус", СтатусКТК);
			ТекущиеДанные.Вставить("ИсточникЗаписи", "Добавлено " + Пользователи.ТекущийПользователь() + " " + ТекущаяДата());
			РегистрыСведений.стоки_ТекущиеДанные.ДобавитьЗапись(Выборка.КТК, ТекущиеДанные);			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОчиститьПодстокиКонтейнеров()
	
	// Подсток выдачи
	Если Не ЗначениеЗаполнено(СтокВыдачи) Тогда
		// Евросиб Фролов (28.03.2022 Task №49126
		//УдалитьПодстокВыдачи = "";
		ПодстокиВыдачи.Очистить();
		// Евросиб Фролов)
	Иначе
		СобственныйСток = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтокВыдачи, "СобственныйСток");
	
		Если СобственныйСток = Ложь Тогда
			// Евросиб Фролов (28.03.2022 Task №49126
			//УдалитьПодстокВыдачи = "";
			ПодстокиВыдачи.Очистить();
			// Евросиб Фролов)
		КонецЕсли;
	КонецЕсли;
	
	// Подсток сдачи
	Если Не ЗначениеЗаполнено(СтокСдачи) Тогда
		// Евросиб Фролов (28.03.2022 Task №49126
		//УдалитьПодстокСдачи = "";
		ПодстокиСдачи.Очистить();
		// Евросиб Фролов)
	Иначе
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	МультилокацииЛокации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Мультилокации.Локации КАК МультилокацииЛокации
		|ГДЕ
		|	МультилокацииЛокации.Ссылка = &СтокСдачи
		|	И МультилокацииЛокации.Локация.СобственныйСток";
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("СтокСдачи", СтокСдачи);
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
		   	// Евросиб Фролов (28.03.2022 Task №49126
			//УдалитьПодстокСдачи = "";
			ПодстокиСдачи.Очистить();
			// Евросиб Фролов)
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьКоличествоТранспортныхСредств(Отказ)
	
	КоличествоТранспортныхСредств = 0;
		
	//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -Начало  
	МассивКлючей = Новый Массив;
	Для Каждого Стр Из Контейнеры Цикл
		МассивКлючей.Добавить(Стр.КлючАналитикиПеревозки);	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КлючиАналитикиПеревозкиМили.ФИОВодителя КАК ФИОВодителя,
		|	КлючиАналитикиПеревозкиМили.РегНомерТС КАК РегНомерТС,
		|	КлючиАналитикиПеревозкиМили.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозкиМили
		|ГДЕ
		|	КлючиАналитикиПеревозкиМили.Ссылка В(&Ссылка)";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);  
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если Не ПустаяСтрока(ВыборкаДетальныеЗаписи.ФИОВодителя) И ПустаяСтрока(ВыборкаДетальныеЗаписи.РегНомерТС) Тогда
			стр = Контейнеры.Найти(ВыборкаДетальныеЗаписи.Ссылка,"КлючАналитикиПеревозки");
			ОбщегоНазначения.СообщитьПользователю(
												"В строке №" + стр.НомерСтроки + " данных об автоперевозке не заполнено поле ""Рег. № ТС""",
												ЭтотОбъект,
												ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТранспортныеСредства", стр.НомерСтроки, "РегНомерТС"),
												,
												Отказ);
			ИначеЕсли ПустаяСтрока(ВыборкаДетальныеЗаписи.ФИОВодителя) И Не ПустаяСтрока(ВыборкаДетальныеЗаписи.РегНомерТС) Тогда
			стр = Контейнеры.Найти(ВыборкаДетальныеЗаписи.Ссылка,"КлючАналитикиПеревозки");									
			ОбщегоНазначения.СообщитьПользователю(
												"В строке №" + стр.НомерСтроки + " данных об автоперевозке не заполнено поле ""ФИО водителя""",
												ЭтотОбъект,
												ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТранспортныеСредства", стр.НомерСтроки, "ФИОВодителя"),
												,
												Отказ);
		Иначе
			// заполнены и ФИО, и номер ТС
			КоличествоТранспортныхСредств = КоличествоТранспортныхСредств + 1;	
		КонецЕсли;
	КонецЦикла;
	
	//Для Каждого ТекущаяСтрока Из ТранспортныеСредстваУдалить Цикл
	//	
	//	Если Не ПустаяСтрока(ТекущаяСтрока.ФИОВодителя) И ПустаяСтрока(ТекущаяСтрока.РегНомерТС) Тогда
	//		ОбщегоНазначения.СообщитьПользователю(
	//											"В строке №" + ТекущаяСтрока.НомерСтроки + " данных об автоперевозке не заполнено поле ""Рег. № ТС""",
	//											ЭтотОбъект,
	//											ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТранспортныеСредства", ТекущаяСтрока.НомерСтроки, "РегНомерТС"),
	//											,
	//											Отказ);
	//	ИначеЕсли ПустаяСтрока(ТекущаяСтрока.ФИОВодителя) И Не ПустаяСтрока(ТекущаяСтрока.РегНомерТС) Тогда
	//		ОбщегоНазначения.СообщитьПользователю(
	//											"В строке №" + ТекущаяСтрока.НомерСтроки + " данных об автоперевозке не заполнено поле ""ФИО водителя""",
	//											ЭтотОбъект,
	//											ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТранспортныеСредства", ТекущаяСтрока.НомерСтроки, "ФИОВодителя"),
	//											,
	//											Отказ);
	//	Иначе
	//		// заполнены и ФИО, и номер ТС
	//		КоличествоТранспортныхСредств = КоличествоТранспортныхСредств + 1;	
	//	КонецЕсли;
