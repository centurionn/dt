	КонецЕсли;  
	Запрос.УстановитьПараметр("КлючиВРелизе", КлючиВРелизе);
	Запрос.УстановитьПараметр("ОтборПоМиле", ОтборПоМиле);
	
	Результат = Запрос.Выполнить();
	Если не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();  
		СостояниеДляЗадачиОбновления = Справочники.Состояния.НеобходимоОбновитьДанные;
