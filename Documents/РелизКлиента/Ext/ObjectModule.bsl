Функция ПолучитьТаблицуКТКИзКлючейАналитикиТЧ() Экспорт //ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23 
			
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЗ.КлючАналитикиПеревозки КАК Ключ,
		|	ТЗ.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ ВТ_Контейнеры
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Контейнеры.НомерСтроки КАК НомерСтроки,
		|	КлючиАналитикиПеревозки.Контейнер КАК Контейнер
		|ИЗ
		|	ВТ_Контейнеры КАК ВТ_Контейнеры
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки КАК КлючиАналитикиПеревозки
		|		ПО ВТ_Контейнеры.Ключ = КлючиАналитикиПеревозки.Ссылка
		|ГДЕ
		|	КлючиАналитикиПеревозки.Контейнер <> Значение(Справочник.ТЕ.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("ТЗ",Контейнеры.Выгрузить(,"КлючАналитикиПеревозки,НомерСтроки"));
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции	

