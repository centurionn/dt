Процедура ПроверитьУдалитьСвязьРелизов(ЭтоОтменаПроведения = ложь)

	//Нам нужно проверить и удалить записи
	//которые не соответствуют релизу собственника из шапки(смена или очистка релиза собственника в шапке)
	//гуиды, которых теперь уже нет в релизе клиента (удалили строку в релизе клиента)
	//по которым теперь пустая дата (очистили дату в релизе клиента)
	Запрос = Новый Запрос;
	Запрос.Текст =
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 -начало
	//"ВЫБРАТЬ
	//|	Контейнеры.Контейнер КАК Контейнер,
	//|	Контейнеры.ТипоразмерКТК КАК ТипоразмерКТК,
	//|	Контейнеры.ИдентификаторСтроки КАК ИдентификаторСтроки,
	//|	Контейнеры.ДатаВывоза КАК ДатаВывоза
	//|ПОМЕСТИТЬ втКТК
	//|ИЗ
	//|	&Контейнеры КАК Контейнеры
	//|;
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Контейнеры.КлючАналитикиПеревозки КАК СПравочник.КлючиАналитикиПеревозки) КАК КлючАналитикиПеревозки,
	|	Контейнеры.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ втКТК_1
	|ИЗ
	|	&Контейнеры КАК Контейнеры
	|;
	|ВЫБРАТЬ
	|	втКТК_1.КлючАналитикиПеревозки.Контейнер КАК Контейнер,
	|	втКТК_1.КлючАналитикиПеревозки.Контейнер.ТипТЕ КАК ТипоразмерКТК,
	|	втКТК_1.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ЕСТЬNULL(КлючиАналитикиПеревозкиМили.ДатаВыдачиКТКСТерминала, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаВывоза
	|ПОМЕСТИТЬ втКТК
	|ИЗ
	|	втКТК_1 КАК втКТК_1
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозкиМили
	|		ПО втКТК_1.КлючАналитикиПеревозки = КлючиАналитикиПеревозкиМили.Ссылка
	|	    	И КлючиАналитикиПеревозкиМили.ЭтапПеревозки = Значение(Перечисление.ЭтапыПеревозки.ПерваяМиля)
	|;
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 -начало
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СвязьРелизов.РелизСобственника КАК РелизСобственника,
	|	СвязьРелизов.ГУИДСтроки КАК ГУИДСтроки,
	|	СвязьРелизов.РелизКлиента КАК РелизКлиента,
	|	СвязьРелизов.Контейнер КАК Контейнер,
	|	СвязьРелизов.ГУИД_СтрокиРелизКлиента КАК ГУИД_СтрокиРелизКлиента,
	|	СвязьРелизов.БылУстановленКТКизРелизаКлиента КАК БылУстановленКТКизРелизаКлиента
	|ПОМЕСТИТЬ ТаблицаСвязей
	|ИЗ
	|	РегистрСведений.СвязьРелизов КАК СвязьРелизов
	|ГДЕ
	|	СвязьРелизов.РелизКлиента = &РелизКлиента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаСвязей.РелизСобственника КАК РелизСобственника,
	|	ТаблицаСвязей.ГУИДСтроки КАК ГУИДСтроки,
	|	ТаблицаСвязей.РелизКлиента КАК РелизКлиента,
	|	ТаблицаСвязей.Контейнер КАК Контейнер,
	|	ТаблицаСвязей.ГУИД_СтрокиРелизКлиента КАК ГУИД_СтрокиРелизКлиента,
	|	ТаблицаСвязей.БылУстановленКТКизРелизаКлиента КАК БылУстановленКТКизРелизаКлиента,
	|	ВЫБОР
	|		КОГДА ТаблицаСвязей.РелизСобственника <> &РелизСобственника
	|			ТОГДА 1
	|		КОГДА втКТК.ИдентификаторСтроки ЕСТЬ NULL
	|			ТОГДА 2
	|		КОГДА втКТК.ДатаВывоза = ДАТАВРЕМЯ(1, 1, 1)
	|				ИЛИ втКТК.Контейнер = ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
	|			ТОГДА 3
	|		ИНАЧЕ 4
	|	КОНЕЦ КАК СостояниеПоЗаписи
	|ИЗ
	|	ТаблицаСвязей КАК ТаблицаСвязей
	|		ЛЕВОЕ СОЕДИНЕНИЕ втКТК КАК втКТК
	|		ПО ТаблицаСвязей.ГУИД_СтрокиРелизКлиента = втКТК.ИдентификаторСтроки
	|			И (&ЭтоОтменаПроведения = ЛОЖЬ)
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ТаблицаСвязей.РелизСобственника <> &РелизСобственника
	|				ТОГДА 1
	|			КОГДА втКТК.ИдентификаторСтроки ЕСТЬ NULL
	|				ТОГДА 2
	|			КОГДА втКТК.ДатаВывоза = ДАТАВРЕМЯ(1, 1, 1)
	|					ИЛИ втКТК.Контейнер = ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
	|				ТОГДА 3
	|			ИНАЧЕ 4
	|		КОНЕЦ < 4
	|
	|УПОРЯДОЧИТЬ ПО
	|	РелизСобственника,
	|	СостояниеПоЗаписи
	|ИТОГИ ПО
	|	РелизСобственника";	
	
	Запрос.УстановитьПараметр("Контейнеры",Контейнеры);
	Запрос.УстановитьПараметр("РелизСобственника",РелизСобственника);
	Запрос.УстановитьПараметр("РелизКлиента",Ссылка);
	Запрос.УстановитьПараметр("ЭтоОтменаПроведения",ЭтоОтменаПроведения);
	
	//ТаблицаСвязейНаУдаление = Запрос.Выполнить().Выгрузить();
	ВыборкаРелизСобственника = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	УстановитьПривилегированныйРежим(Истина);
	Пока ВыборкаРелизСобственника.Следующий() Цикл
		РелизСобственникаОбъект = ВыборкаРелизСобственника.РелизСобственника.ПолучитьОбъект();
		ПроводитьРелизСобственника = Ложь;
		БылаОшибкаПоРелизуСобственника = Ложь;
		Если РелизСобственникаОбъект.Проведен Тогда
			РежимЗаписиРелиза = РежимЗаписиДокумента.Проведение;
		Иначе		
			РежимЗаписиРелиза = РежимЗаписиДокумента.Запись;
		КонецЕсли;
		//Если РелизСобственникаОбъект = Неопределено Тогда
		//	РелизСобственникаОбъект = Документы.РелизСобственника.СоздатьДокумент();
		//КонецЕсли;
		СтрокаСвязи = ВыборкаРелизСобственника.Выбрать();	
		
		//Сначала попробуем изменеить релизы собственника
		Пока СтрокаСвязи.Следующий() Цикл
			СтрокаНоминации = РелизСобственникаОбъект.Номинации.Найти(СтрокаСвязи.ГУИДСтроки);
			Если не СтрокаНоминации = Неопределено и СтрокаНоминации.Контейнер = СтрокаСвязи.Контейнер Тогда
				Если СтрокаНоминации.РелизКлиентаНоваяЗаписьКТК Тогда
					РелизСобственникаОбъект.Номинации.Удалить(СтрокаНоминации);	
				ИначеЕсли СтрокаСвязи.БылУстановленКТКизРелизаКлиента Тогда	
					СтрокаНоминации.Контейнер = Справочники.ТЕ.ПустаяСсылка();
					СтрокаНоминации.ДатаВзятия = Дата(1,1,1);
				Иначе
					СтрокаНоминации.ДатаВзятия = Дата(1,1,1);
				КонецЕсли;
				ПроводитьРелизСобственника = Истина;	
			КонецЕсли;
		КонецЦикла;
		Если ПроводитьРелизСобственника Тогда
			РелизСобственникаОбъект.ДополнительныеСвойства.Вставить("ЗаписьИзРелизаКлиента", Истина);
			Попытка
				РелизСобственникаОбъект.Записать(РежимЗаписиРелиза);
			Исключение
				ОбщегоНазначения.СообщитьПользователю("Ошибка при попытке изменения "+ВыборкаРелизСобственника.РелизСобственника+". Внесите изменения по контейнерам вручную.");
				ОбщегоНазначения.СообщитьПользователю("Описание ошибки: "+ОписаниеОшибки());
				БылаОшибкаПоРелизуСобственника = Истина;
			КонецПопытки;
		КонецЕсли;	
		
		//Если все ок с релизами собственника, то нужно отработать вручную.
		Если не БылаОшибкаПоРелизуСобственника Тогда
		СтрокаСвязи.Сбросить();
		СписокКТК = Новый СписокЗначений;
		Пока СтрокаСвязи.Следующий() Цикл
		//Для каждого СтрокаСвязи Из ТаблицаСвязейНаУдаление Цикл
			МенеджерЗаписиСвязи = РегистрыСведений.СвязьРелизов.СоздатьМенеджерЗаписи();	
			МенеджерЗаписиСвязи.РелизСобственника = СтрокаСвязи.РелизСобственника;
			МенеджерЗаписиСвязи.ГУИДСтроки = СтрокаСвязи.ГУИДСтроки;
			МенеджерЗаписиСвязи.Прочитать();
			Если МенеджерЗаписиСвязи.Выбран() Тогда
				МенеджерЗаписиСвязи.Удалить();	
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаСвязи.Контейнер) Тогда
				СписокКТК.Добавить(СтрокаСвязи.Контейнер);
			КонецЕсли;
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	стоки_ТекущиеДанные.Период КАК Период,
		|	стоки_ТекущиеДанные.КТК КАК КТК,
		|	стоки_ТекущиеДанные.тек_Релиз КАК тек_Релиз
		|ИЗ
		|	РегистрСведений.стоки_ТекущиеДанные КАК стоки_ТекущиеДанные
		|ГДЕ
		|	стоки_ТекущиеДанные.тек_Релиз = &тек_Релиз
		|	И стоки_ТекущиеДанные.КТК В(&СписокКТК)";
		
		Запрос.УстановитьПараметр("СписокКТК", СписокКТК);
		Запрос.УстановитьПараметр("тек_Релиз", ВыборкаРелизСобственника.РелизСобственника);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			МенеджерЗаписиСвязи = РегистрыСведений.стоки_ТекущиеДанные.СоздатьМенеджерЗаписи();	
			МенеджерЗаписиСвязи.КТК = Выборка.КТК;
			МенеджерЗаписиСвязи.Период = Выборка.Период;
			МенеджерЗаписиСвязи.Прочитать();
			Если МенеджерЗаписиСвязи.Выбран() Тогда
				МенеджерЗаписиСвязи.Удалить();	
			КонецЕсли;
		КонецЦикла;
		
		КонецЕсли;
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры
