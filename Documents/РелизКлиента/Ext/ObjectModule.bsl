	|		ЛЕВОЕ СОЕДИНЕНИЕ втКлиентскоеОперирование КАК втКлиентскоеОперирование
	|		ПО втКонтейнеры.КТК = втКлиентскоеОперирование.КТК
	|ГДЕ
	|	(втКлиентскоеОперирование.кл_Релиз <> втКонтейнеры.кл_Релиз
	|			ИЛИ втКлиентскоеОперирование.кл_ДатаВыдачи <> втКонтейнеры.кл_ДатаВыдачи
	|			ИЛИ втКлиентскоеОперирование.кл_СрокПользования <> втКонтейнеры.кл_СрокПользования
	|			ИЛИ втКлиентскоеОперирование.кл_ВодительЗабор <> втКонтейнеры.кл_ВодительЗабор
	|			ИЛИ втКлиентскоеОперирование.кл_НомерТСЗабор <> втКонтейнеры.кл_НомерТСЗабор
	|			ИЛИ втКлиентскоеОперирование.кл_ВодительСдача <> втКонтейнеры.кл_ВодительСдача
	|			ИЛИ втКлиентскоеОперирование.кл_НомерТССдача <> втКонтейнеры.кл_НомерТССдача
	|			ИЛИ втКлиентскоеОперирование.допл_ИнструкцииПоСдачеДопл <> втКонтейнеры.допл_ИнструкцииПоСдачеДопл
	|			ИЛИ втКлиентскоеОперирование.кл_ДатаВозврата <> втКонтейнеры.кл_ДатаВозврата
	//ДИТ, Беляев СЮ, BUG 72360, 24-07-2023, начало
	|			ИЛИ втКлиентскоеОперирование.кл_Клиент <> втКонтейнеры.кл_Клиент
	|			ИЛИ втКлиентскоеОперирование.кл_Договор <> втКонтейнеры.кл_Договор
	//ДИТ, Беляев СЮ, BUG 72360, 24-07-2023, конец
	|			ИЛИ втКлиентскоеОперирование.КТК ЕСТЬ NULL)";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("МассивКТК", 	МассивКТК);
	Запрос.УстановитьПараметр("Ссылка", 	Ссылка);
	//ДИТ, Беляев СЮ, BUG 72360, 24-07-2023, начало
	Запрос.УстановитьПараметр("ЗаявкаСсылка", 	Заявка);
	//ДИТ, Беляев СЮ, BUG 72360, 24-07-2023, конец
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		КлиентскоеОперирование = Новый Соответствие;
		КлиентскоеОперирование.Вставить("кл_Релиз", 					Ссылка);
		КлиентскоеОперирование.Вставить("кл_ДатаВыдачи", 				Выборка.кл_ДатаВыдачи);
		КлиентскоеОперирование.Вставить("кл_СрокПользования",			СрокИспользованияКТК);
		КлиентскоеОперирование.Вставить("кл_ВодительЗабор", 			Выборка.кл_ВодительЗабор);
		КлиентскоеОперирование.Вставить("кл_НомерТСЗабор", 				Выборка.кл_НомерТСЗабор);
		КлиентскоеОперирование.Вставить("кл_ВодительСдача", 			Выборка.кл_ВодительСдача);
		КлиентскоеОперирование.Вставить("кл_НомерТССдача", 				Выборка.кл_НомерТССдача);
		КлиентскоеОперирование.Вставить("допл_ИнструкцииПоСдачеДопл", 	Выборка.допл_ИнструкцииПоСдачеДопл);
		КлиентскоеОперирование.Вставить("кл_ДатаВозврата", 				Выборка.кл_ДатаВозврата);
		//ДИТ, Беляев СЮ, BUG 72360, 24-07-2023, начало
		КлиентскоеОперирование.Вставить("кл_Клиент", 					Выборка.кл_Клиент); 
		КлиентскоеОперирование.Вставить("кл_Договор", 					Выборка.кл_Договор); 
		//ДИТ, Беляев СЮ, BUG 72360, 24-07-2023, конец
		
		//РегистрыСведений.стоки_КлиентскоеОперирование.ДобавитьЗапись(Выборка.КТК, КлиентскоеОперирование);
		//ДИТ, Беляев СЮ, BUG 72360 / TA 72948, 31-07-2023, начало
		Если ЗначениеЗаполнено(Выборка.кл_Клиент) Тогда
			РегистрыСведений.стоки_КлиентскоеОперирование.ДобавитьЗапись(Выборка.КТК, КлиентскоеОперирование);
		Иначе
			РегистрыСведений.стоки_КлиентскоеОперирование.УдалитьЗаписиПоВыбранномуКТКиРелизу(Выборка.КТК, Ссылка);
		КонецЕсли;
		//ДИТ, Беляев СЮ, BUG 72360 / TA 72948, 31-07-2023, конец	
	КонецЦикла;	
		
КонецПроцедуры

//ДИТ, Беляев СЮ, BUG 72360, 24-07-2023, начало
Процедура ВыполнитьЗаписьВКлиентскоеОперированиеПоДокументу() Экспорт
	ТаблицаКонтейнеров = ПолучитьТаблицуКТКИзКлючейАналитикиТЧ();
	МассивКонтейнеров = ТаблицаКонтейнеров.ВыгрузитьКолонку("Контейнер");
	ВыполнитьЗаписьВКлиентскоеОперирование(МассивКонтейнеров, "");
КонецПроцедуры
//ДИТ, Беляев СЮ, BUG 72360, 24-07-2023, конец

Процедура ВыполнитьЗаписьВТекущиеДанные(ТекущийКТК, Отказ, ТаблицаСведений,ТЗПерваяМиляКлючиАналитики,ТЗПоследняяМиляКлючиАналитики)
	//ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23 -начало
	СведенияПоКТК = ТаблицаСведений.Найти(ТекущийКТК.КлючАналитикиПеревозки.Контейнер, "КТК");
	
	ДатаВывозаП = Дата(1,1,1);
	ДатаВозвратаКлиентомП = Дата(1,1,1);
	Если ЗначениеЗаполнено(ТекущийКТК.КлючАналитикиПеревозки) Тогда
		НайденнаяСтрокаТЗПерваяМиля 	= ТЗПерваяМиляКлючиАналитики.Найти(ТекущийКТК.КлючАналитикиПеревозки);
		Если НайденнаяСтрокаТЗПерваяМиля <> Неопределено Тогда
			ДатаВывозаП = НайденнаяСтрокаТЗПерваяМиля.ДатаВыдачиКТКСТерминала;
		КонецЕсли;
		НайденнаяСтрокаТЗПоследняяМиля 	= ТЗПоследняяМиляКлючиАналитики.Найти(ТекущийКТК.КлючАналитикиПеревозки);
		Если НайденнаяСтрокаТЗПоследняяМиля <> Неопределено Тогда
			ДатаВозвратаКлиентомП = НайденнаяСтрокаТЗПоследняяМиля.ДатаСдачиКТКНаТерминал;
		КонецЕсли;
	КонецЕсли;	
	//ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23 -конец
	ТекущийСтатус = Неопределено;
	ТекущийСток = Неопределено;
	Если СведенияПоКТК <> Неопределено Тогда
		ТекущийСтатус = СведенияПоКТК.Статус;
		ТекущийСток = СведенияПоКТК.Сток;
	КонецЕсли;	
	
	// РС "ТекущиеДанные"
	ТекущиеДанные = Новый Соответствие;
	
	// Если "Номерная выдача" и стоит статус "Не согласован" в поле "Статус согласования списка КТК с терминалом"
	// и имеются контейнеры с не заполненным полем "Дата взятия", то необходимо таким контейнерам устанавливать
	// статус "Предварит. резерв" в поле "Статус" АРМ КТК Текущие данные.
	// Если статус "Согласован", то таким контейнерам устанавливать статус "Зарезервирован"
	Если НомернаяВыдача И Не ЗначениеЗаполнено(ДатаВывозаП) Тогда //ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23
		// Статус "Не согласован" не проверяем, т.к. их всего два "Согласован" и "Не согласован" и заполняется обязательно при номерной выдаче.
		НовыйСтатусКТК = Перечисления.СтатусыКТК.ПредварительныйРезерв;
		Если СтатусСогласованияСпискаКТК = Перечисления.СтатусыСогласованияСпискаКТКСТерминалами.Согласован Тогда
			НовыйСтатусКТК = Перечисления.СтатусыКТК.Зарезервирован;
		КонецЕсли;	
		
		Если НовыйСтатусКТК <> ТекущийСтатус Тогда
			ТекущиеДанные.Вставить("тек_Статус", НовыйСтатусКТК);
		КонецЕсли;	
	КонецЕсли;
	
	//// Если установлена галка "Номерная выдача" и в табличной части не заполнено поле "Дата вывоза",
	//// то необходимо устанавливать контейнерам статус "Зарезервирован" в АРМ КТК Текущие данные.
	//Если НомернаяВыдача И Не ЗначениеЗаполнено(ТекущийКТК.ДатаВывоза) Тогда
	//	ТекущиеДанные.Вставить("тек_Статус", Перечисления.СтатусыКТК.Зарезервирован);
	//КонецЕсли;
	
	// Если в строке табличной части заполнено поле "Дата вывоза", не заполнено поле "Дата возврата клиентом"
	// и значение в поле "Автоперевозка" равно "Силами клиента" либо "Силами Евросиб",
	// то устанавливать статус "В движении" в АРМ КТК Текущие данные.
	Если ЗначениеЗаполнено(ДатаВывозаП) И Не ЗначениеЗаполнено(ДатаВозвратаКлиентомП) //ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23
		И Автоперевозка <> Перечисления.ВариантыАвтоперевозки.НеТребуется
		И ТекущийСтатус <> Перечисления.СтатусыКТК.ВДвижении Тогда
		ТекущиеДанные.Вставить("тек_Статус", Перечисления.СтатусыКТК.ВДвижении);
	КонецЕсли;	
	
	// Если в строке заполнена дата вывоза и при этом заполнена дата возврата клиентом, необходимо:
	// - устанавливать статус "Свободен" по таким контейнерам в АРМ КТК Текущие данные;
	// - в поле "Тек. сток" в АРМ КТК перенести данные из поля "Сток сдачи" релиза клиента.
	Если ЗначениеЗаполнено(ДатаВывозаП) И ЗначениеЗаполнено(ДатаВозвратаКлиентомП) Тогда //ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23
		Если ТекущийСтатус <> Перечисления.СтатусыКТК.Свободен Тогда
			ТекущиеДанные.Вставить("тек_Статус", Перечисления.СтатусыКТК.Свободен);
		КонецЕсли;
		Если ТекущийСток <> СтокСдачи Тогда
			ТекущиеДанные.Вставить("тек_Сток", СтокСдачи);
		КонецЕсли;	
	КонецЕсли;	
	
	Если ТекущиеДанные.Количество() > 0 Тогда
		ТекущиеДанные.Вставить("ИсточникЗаписи", "Добавлено " + Пользователи.ТекущийПользователь() + " " + ТекущаяДата());
		//ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23 -начало
		//РегистрыСведений.стоки_ТекущиеДанные.ДобавитьЗапись(ТекущийКТК.Контейнер, ТекущиеДанные);
		РегистрыСведений.стоки_ТекущиеДанные.ДобавитьЗапись(ТекущийКТК.КлючАналитикиПеревозки.Контейнер, ТекущиеДанные);
		//ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23 -конец
	КонецЕсли;	
	
КонецПроцедуры	

Функция СведенияПоКТКИзАРМ(МассивКТК)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	стоки_ТекущиеДанныеСрезПоследних.КТК КАК КТК,
	|	стоки_ТекущиеДанныеСрезПоследних.тек_Статус КАК Статус,
	|	стоки_ТекущиеДанныеСрезПоследних.тек_Сток КАК Сток
	|ИЗ
	|	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних(, КТК В (&МассивКТК)) КАК стоки_ТекущиеДанныеСрезПоследних";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("МассивКТК", МассивКТК);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции
	
Функция ЛокацияПодходит(Локация, СодержитСток)
	// Евросиб Фролов (16.02.2022 Task №46605
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	МультилокацииЛокации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Мультилокации.Локации КАК МультилокацииЛокации
	|ГДЕ
	|	МультилокацииЛокации.Ссылка = &Локация
	|	И МультилокацииЛокации.Локация.Тип = ЗНАЧЕНИЕ(Справочник.ТипыЛокаций.Сток)";
	
	Если СодержитСток = Ложь Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
									"И МультилокацииЛокации.Локация.Тип = ЗНАЧЕНИЕ(Справочник.ТипыЛокаций.Сток)",
									"И МультилокацииЛокации.Локация.Тип <> ЗНАЧЕНИЕ(Справочник.ТипыЛокаций.Сток)");
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Локация", Локация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();
	// Евросиб Фролов)
КонецФункции	

Функция КонтейнерыДляРелизаСобственника()
	// Евросиб Фролов (30.05.2022 Task №49741
    ТекстЗапроса = 
	//ДИТ Шевченко А.В. US 62421 TA 64347 23.01.23
	//"ВЫБРАТЬ
	//|	Контейнеры.Контейнер КАК Контейнер,
	//// ++ ДИТ_Агафонов_task 50388 29.06.2022
	//|	Контейнеры.Контейнер.ТипТЕ КАК ТипоразмерКТК,
	//|	Контейнеры.ИдентификаторСтроки КАК ИдентификаторСтроки
	//// -- ДИТ_Агафонов_task 50388 29.06.2022
	//|ПОМЕСТИТЬ втКТК
	//|ИЗ
	//|	&Контейнеры КАК Контейнеры
	//|;
	"ВЫБРАТЬ
	//ДИТ Шевченко А.В. US 62421 TA 64347 23.01.23
	|	ВЫРАЗИТЬ(Контейнеры.КлючАналитикиПеревозки КАК СПравочник.КлючиАналитикиПеревозки) КАК КлючиАналитикиПеревозки,
	// ++ ДИТ_Агафонов_task 50388 29.06.2022
	|	Контейнеры.ИдентификаторСтроки КАК ИдентификаторСтроки
	// -- ДИТ_Агафонов_task 50388 29.06.2022
	|ПОМЕСТИТЬ втКТК
	|ИЗ
	|	&Контейнеры КАК Контейнеры
	|	ГДЕ
	|		ВЫРАЗИТЬ(Контейнеры.КлючАналитикиПеревозки КАК СПравочник.КлючиАналитикиПеревозки).Контейнер <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
	|;
	//ДИТ Шевченко А.В. US 62421 TA 64347 23.01.23
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втКТК.КлючиАналитикиПеревозки.Контейнер КАК Контейнер,
	// ++ ДИТ_Агафонов_task 50388 29.06.2022
	|	втКТК.КлючиАналитикиПеревозки.Контейнер.ТипТЕ КАК ТипоразмерКТК,
	|	втКТК.ИдентификаторСтроки КАК ИдентификаторСтроки,
	// -- ДИТ_Агафонов_task 50388 29.06.2022
	//ДИТ Шевченко А.В. US 62421 TA 64347 23.01.23
	|	ЕстьNULL(КлючиАналитикиПеревозкиТ.ДатаВыдачиКТКСТерминала,ДАТАВРЕМЯ(1,1,1)) КАК ДатаВывоза
	//ДИТ Шевченко А.В. US 62421 TA 64347 23.01.23
	|ИЗ
	|	втКТК КАК втКТК
	//ДИТ Шевченко А.В. US 62421 TA 64347 23.01.23
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозкиТ
	|		ПО КлючиАналитикиПеревозкиТ.Ссылка = втКТК.КлючиАналитикиПеревозки
	|	    	И КлючиАналитикиПеревозкиТ.ЭтапПеревозки = Значение(Перечисление.ЭтапыПеревозки.ПерваяМиля)
	|				И ЕстьNULL(КлючиАналитикиПеревозкиТ.ДатаВыдачиКТКСТерминала,ДАТАВРЕМЯ(1,1,1)) <> ДАТАВРЕМЯ(1, 1, 1)";
	//ДИТ Шевченко А.В. US 62421 TA 64347 23.01.23
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Контейнеры", Контейнеры);
	
	Результат = Запрос.Выполнить();
	
	ТаблицаКТК = Результат.Выгрузить();
	
	Возврат ТаблицаКТК;	
	// Евросиб Фролов)	
КонецФункции

Процедура ОбновитьРелизСобственника(Контейнеры, Отказ)
    // Евросиб Фролов (30.05.2022 Task №49741

	// Запросом получаем строки релиза собстевнника, которые не были добавлена или обновлены из релиза клиента.
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	РелизСобственникаНоминации.Ссылка КАК Ссылка,
	|	РелизСобственникаНоминации.ГУИДСтроки КАК ГУИДСтроки
	|ПОМЕСТИТЬ втНоминации
	|ИЗ
	|	Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	|ГДЕ
	|	РелизСобственникаНоминации.Ссылка = &РелизСобственника
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втНоминации.ГУИДСтроки КАК ГУИДСтроки,
	// ++ ДИТ_Агафонов_task 50388 25.06.2022
	|	СвязьРелизов.РелизКлиента КАК РелизКлиента
	// -- ДИТ_Агафонов_task 50388 25.06.2022
	|ИЗ
	|	втНоминации КАК втНоминации
