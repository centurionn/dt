Функция ПроверитьДатуВывоза(Объект) Экспорт //ДИТ Шевченко А.В. 51340 12.10.2022
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 –начало
	МассивКлючей = Новый Массив;
	Для Каждого СтрокаТЧ Из Объект.Контейнеры Цикл
		Если ЗначениеЗаполнено(СтрокаТЧ.КлючАналитикиПеревозки) Тогда
			МассивКлючей.Добавить(СтрокаТЧ.КлючАналитикиПеревозки);
		КонецЕсли;
	КонецЦикла;
	КоличествоСтрокБезДат = ПолучитьКоличествоСтрокСЗаполненойДатойВывоза(МассивКлючей);
	//СтруктураПоиска = Новый Структура("ДатаВывоза",Дата(1,1,1));
	//НайденСтроки = Объект.Контейнеры.НайтиСтроки(СтруктураПоиска);
	Возврат КоличествоСтрокБезДат < Объект.Контейнеры.Количество();	
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 –конец	
