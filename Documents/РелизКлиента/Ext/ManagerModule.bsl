	               |	РелизКлиентаКонтейнеры.Ссылка КАК Ссылка,
	               |	РелизКлиентаКонтейнеры.НомерСтроки КАК НомерСтроки,
	               |	КлючиАналитикиПеревозкиМили.ФИОВодителя КАК ФИОВодителя,
	               |	ЕстьNULL(КлючиАналитикиПеревозкиМили.РегНомерТС,"""") КАК РегНомерТС,
	               |	ЕстьNULL(КлючиАналитикиПеревозкиМили.ПаспортныеДанные,"""") КАК ПаспортныеДанные,
	               |	РелизКлиентаКонтейнеры.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	ЕстьNULL(КлючиАналитикиПеревозкиМили.ИНН,"""") КАК ИНН,
	               |	ЕстьNULL(КлючиАналитикиПеревозкиМили.КПП,"""") КАК КПП,
				   |	ЛОЖЬ КАК Выведен,
	               |	КлючиАналитикиПеревозкиМили.Автоперевозчик КАК Автоперевозчик,
				   |	КлючиАналитикиПеревозкиМили.Ссылка.Контейнер КАК Контейнер
	               |ИЗ
	               |	Документ.РелизКлиента.Контейнеры КАК РелизКлиентаКонтейнеры
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозкиМили
	               |		ПО (КлючиАналитикиПеревозкиМили.Ссылка = РелизКлиентаКонтейнеры.КлючАналитикиПеревозки)
	               |			И (КлючиАналитикиПеревозкиМили.Ссылка.Контейнер <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
	               |				ИЛИ КлючиАналитикиПеревозкиМили.ФИОВодителя <> """"
	               |				ИЛИ (КлючиАналитикиПеревозкиМили.Автоперевозчик <> """"
	               |					И КлючиАналитикиПеревозкиМили.Автоперевозчик <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) И КлючиАналитикиПеревозкиМили.Автоперевозчик <> Неопределено))
	               |			И (КлючиАналитикиПеревозкиМили.ЭтапПеревозки = ЗНАЧЕНИЕ(Перечисление.ЭтапыПеревозки.ПерваяМиля))
	               |ГДЕ
	               |	РелизКлиентаКонтейнеры.Ссылка = &Ссылка";

	Запрос.УстановитьПараметр("Ссылка",РелизКлиента);
	
	ТаблицаТС = Запрос.Выполнить().Выгрузить();
	Возврат ТаблицаТС;
	
	
