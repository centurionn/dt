Процедура ОбновитьИтоги(Объект) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Контейнеры.КлючАналитикиПеревозки КАК Справочник.КлючиАналитикиПеревозки) КАК КлючАналитикиПеревозки
	|ПОМЕСТИТЬ втТаблицаКТК_1
	|ИЗ
	|	&Контейнеры КАК Контейнеры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТаблицаКТК_1.КлючАналитикиПеревозки.Контейнер КАК Контейнер,
	//ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23 -начало
	|	ЕСТЬNULL(КлючиАналитикиПеревозкиМили.ДатаВыдачиКТКСТерминала, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаВывоза,
	//|	втТаблицаКТК_1.ДатаВозвратаКлиентом КАК ДатаВозвратаКлиентом
	|	ЕСТЬNULL(КлючиАналитикиПеревозкиМилиПоследняя.ДатаСдачиКТКНаТерминал, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаВозвратаКлиентом
	//ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23 -конец
	|ПОМЕСТИТЬ втТаблицаКТК
	|ИЗ
	|	втТаблицаКТК_1 КАК втТаблицаКТК_1
	//ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23 -начало
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозкиМили
	|		ПО втТаблицаКТК_1.КлючАналитикиПеревозки = КлючиАналитикиПеревозкиМили.Ссылка 
	|           И КлючиАналитикиПеревозкиМили.ЭтапПеревозки = ЗНАЧЕНИЕ(Перечисление.ЭтапыПеревозки.ПерваяМиля)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозкиМилиПоследняя
	|		ПО втТаблицаКТК_1.КлючАналитикиПеревозки = КлючиАналитикиПеревозкиМилиПоследняя.Ссылка
	|           И КлючиАналитикиПеревозкиМилиПоследняя.ЭтапПеревозки = ЗНАЧЕНИЕ(Перечисление.ЭтапыПеревозки.ПоследняяМиля)
	//ДИТ Шевченко А.В. US 62421 TA 64347 20.01.23 -конец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ВЫБОР
	|			КОГДА втТаблицаКТК.Контейнер <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
	|					И втТаблицаКТК.ДатаВывоза <> ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Выдано,
	|	СУММА(ВЫБОР
	|			КОГДА втТаблицаКТК.ДатаВозвратаКлиентом = ДАТАВРЕМЯ(1, 1, 1)
	|					И втТаблицаКТК.ДатаВывоза <> ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ОсталосьКТККВозврату
	|ИЗ
	|	втТаблицаКТК КАК втТаблицаКТК";

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Контейнеры", Объект.Контейнеры.Выгрузить());
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда	
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
	
		Объект.ВыданоКТКПоРелизу = Выборка.Выдано;
		Объект.ОсталосьКВыдачеКТК = Объект.ОбщееКоличествоКТКВРелизе - Объект.ВыданоКТКПоРелизу;
		Объект.ОсталосьКТККВозврату = Выборка.ОсталосьКТККВозврату;
		
		ПредставлениеКоличестваКТК = СтрШаблон("%1/%2", Объект.ВыданоКТКПоРелизу, Объект.ОбщееКоличествоКТКВРелизе);
		
	КонецЕсли;
	
КонецПроцедуры

