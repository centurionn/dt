Процедура ОбновитьКлючиВУслугахЗаявки(Заявка,МассивСтруктур,РелизСсылка) Экспорт   
	
	// ДИТ US 79950 ТА 79951 Сержантова А.С. Начало: 19.02.2024
	ТипоразмерКТК = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РелизСсылка, "ТипоразмерКТК");
	// ДИТ US 79950 ТА 79951 Сержантова А.С. Конец: 19.02.2024
	ЗаявкаОб = Заявка.ПолучитьОбъект();
	НужноЗаписать = Ложь;      
	МассивКлючей = Новый Массив;
	Для Каждого ЗнчМ Из МассивСтруктур Цикл
		//Субботин 77659 20.12.2023 Начало // удалил поиск по релизу для актуализации ключей
		//СтруктураПоиска = Новый Структура("КлючАналитикиПеревозки,Релиз",ЗнчМ.Ключ,РелизСсылка); 
		СтруктураПоиска = Новый Структура("КлючАналитикиПеревозки",ЗнчМ.Ключ);
        //Субботин 77659 20.12.2023 Конец
		МассивКлючей.Добавить(ЗнчМ.Ключ);
		НайденныеСтроки = ЗаявкаОб.СоставУслуги.НайтиСтроки(СтруктураПоиска);
		//Евросиб Коханенко Н.А. 30.07.2024 (( #88606 
		//Если НайденныеСтроки.Количество() = 0 Тогда
		ЗаявкаСсылкаИзКлюча = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗнчМ.Ключ, "Заявка");
		Если НайденныеСтроки.Количество() = 0 
			И ЗначениеЗаполнено(ЗаявкаСсылкаИзКлюча) Тогда
		//Евросиб Коханенко Н.А. 30.07.2024 )) #88606 
			НовСтрока = ЗаявкаОб.СоставУслуги.Добавить();
			НовСтрока.КлючАналитикиПеревозки = ЗнчМ.Ключ; 
			// ДИТ US 78243 ТА 80591 Сержантова А.С. Начало: 06.02.2024 - заполняем КТК, иначе он затирается при записи заявки
			НовСтрока.НомерКТК = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗнчМ.Ключ, "Контейнер");
			// ДИТ US 78243 ТА 80591 Сержантова А.С. Конец: 06.02.2024    
			// ДИТ US 79950 ТА 79951 Сержантова А.С. Начало: 19.02.2024
			НовСтрока.РазмерКТК = ТипоразмерКТК.РазмерКТК; 
			НовСтрока.ТипКТК = ТипоразмерКТК; 
			// ДИТ US 79950 ТА 79951 Сержантова А.С. Конец: 19.02.2024
			НовСтрока.ПринадлежностьТЕ = ПредопределенноеЗначение("Перечисление.ПринадлежностьТЕ.КТЕвросиба");
			НовСтрока.ИдентификаторСтрокиРелизаКлиента = ЗнчМ.ИдентификаторСтроки;
			НовСтрока.ГУИДСтроки = Строка(Новый УникальныйИдентификатор());
			НовСтрока.Релиз = РелизСсылка; 
			// ДИТ US 79950 ТА 79951 Сержантова А.С. Начало: 19.02.2024 
			МилиКлюча = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗнчМ.Ключ, "Мили").Выбрать(); 
			Пока МилиКлюча.Следующий() Цикл
				Если МилиКлюча.ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПерваяМиля Тогда
					НовСтрока.ДатаВыдачи = МилиКлюча.ДатаВыдачиКТКСТерминала
				Иначе	
					НовСтрока.ДатаВозвратаКлиентом = МилиКлюча.ДатаСдачиКТКНаТерминал;
				КонецЕсли;
			КонецЦикла;
			// ДИТ US 79950 ТА 79951 Сержантова А.С. Конец: 19.02.2024
			НужноЗаписать = Истина;
		//Субботин 77659 20.12.2023 Начало // добавил иначе
		Иначе
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл 
				Если не ЗначениеЗаполнено(НайденнаяСтрока.Релиз) тогда
					НайденнаяСтрока.Релиз = РелизСсылка;   
					НужноЗаписать = Истина;
				КонецЕсли; 
				// ДИТ US 79950 ТА 79951 Сержантова А.С. Начало: 19.02.2024 
				НужноЗаписать = Истина;
				НайденнаяСтрока.НомерКТК = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗнчМ.Ключ, "Контейнер");
				Если не ЗначениеЗаполнено(НайденнаяСтрока.НомерКТК) Тогда
					НайденнаяСтрока.РазмерКТК = ТипоразмерКТК.РазмерКТК;
					НайденнаяСтрока.ТипКТК = ТипоразмерКТК;
				КонецЕсли;   
				МилиКлюча = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗнчМ.Ключ, "Мили").Выбрать(); 
				Пока МилиКлюча.Следующий() Цикл
					Если МилиКлюча.ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПерваяМиля Тогда
						НайденнаяСтрока.ДатаВыдачи = МилиКлюча.ДатаВыдачиКТКСТерминала
					Иначе	
					    НайденнаяСтрока.ДатаВозвратаКлиентом = МилиКлюча.ДатаСдачиКТКНаТерминал;
					КонецЕсли;
				КонецЦикла;
				// ДИТ US 79950 ТА 79951 Сержантова А.С. Конец: 19.02.2024
			КонецЦикла;		
		//Субботин 77659 20.12.2023 Конец 
		КонецЕсли;	
	КонецЦикла;
	
	// ДИТ US 79950 ТА 79951 Сержантова А.С. Начало: 21.02.2024
	МассивУдаляемыхСтрок = Новый Массив;
	Для Каждого СтрокаУ Из ЗаявкаОб.СоставУслуги Цикл
		Если СтрокаУ.Релиз = РелизСсылка и МассивКлючей.Найти(СтрокаУ.КлючАналитикиПеревозки) = Неопределено Тогда
			МассивУдаляемыхСтрок.Добавить(СтрокаУ);
		КонецЕсли;	
	КонецЦикла;	
	Для Каждого ЗнчМ Из МассивУдаляемыхСтрок Цикл
		ЗаявкаОб.СоставУслуги.Удалить(ЗнчМ);
		НужноЗаписать = Истина;
	КонецЦикла; 
	// ДИТ US 79950 ТА 79951 Сержантова А.С. Конец: 21.02.2024
	
	// ДИТ BUG 76435 Сержантова А.С. Начало: 23.11.2023
	// Обновим поля Срок использования клиентом, пункт отправления и пункт назначения в связанных по ключу аналитики перевозки строках
	ДанныеДляЗаполнения = Новый СписокЗначений;
	ДанныеДляЗаполнения.Добавить(РелизСсылка.СрокИспользованияКТК, "НормативноеИспользование");
	//Субботин 77659 20.12.2023 Начало
	ДанныеДляЗаполнения.Добавить(РелизСсылка.Автоперевозка, "ПерваяМиля");
	ДанныеДляЗаполнения.Добавить(РелизСсылка.АвтоперевозкаПоследняяМиля, "ПоследняяМиля");
	//Субботин 77659 20.12.2023 Конец
	СписокКонтейнеровРелиза = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РелизСсылка, "Контейнеры"); 
	ВыборкаКонтейнеровРелиза = СписокКонтейнеровРелиза.Выбрать(); 
	Пока ВыборкаКонтейнеровРелиза.Следующий() Цикл
		СтрокаПоКлючу = ЗаявкаОб.СоставУслуги.Найти(ВыборкаКонтейнеровРелиза.КлючАналитикиПеревозки, "КлючАналитикиПеревозки");
		Если СтрокаПоКлючу <> Неопределено Тогда
			Для каждого Реквизит Из ДанныеДляЗаполнения Цикл  
				Если СтрокаПоКлючу[Реквизит.Представление] <> Реквизит.Значение Тогда
					СтрокаПоКлючу[Реквизит.Представление] = Реквизит.Значение;  
					НужноЗаписать = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли; 
	КонецЦикла; 
	// ДИТ BUG 76435 Сержантова А.С. Конец: 23.11.2023
	
	Если НужноЗаписать Тогда
		ЗаявкаОб.Записать();
	КонецЕсли;	  

КонецПроцедуры	  

