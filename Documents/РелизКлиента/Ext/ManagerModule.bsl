	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТЕ.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ втКТК
	|ИЗ
	|	Справочник.ТЕ КАК ТЕ
	|ГДЕ
	|	ТЕ.Ссылка В(&МассивКонтейнеров)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втКТК.Ссылка КАК КТК,
	|	стоки_ТекущиеДанныеСрезПоследних.тек_ИнструкцияПоСдаче КАК тек_ИнструкцияПоСдаче,
	|	стоки_ТекущиеДанныеСрезПоследних.тек_Собственник КАК тек_Собственник,
	|	стоки_ТекущиеДанныеСрезПоследних.тек_ВидСобственности КАК тек_ВидСобственности
	|ИЗ
	|	втКТК КАК втКТК
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.стоки_ТекущиеДанные.СрезПоследних(, ) КАК стоки_ТекущиеДанныеСрезПоследних
	|		ПО втКТК.Ссылка = стоки_ТекущиеДанныеСрезПоследних.КТК";
		
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("МассивКонтейнеров", МассивКонтейнеров);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ДанныеКТК = Новый Структура;
		ДанныеКТК.Вставить("ИнструкцияПоСдачеИзАРМ", 	СокрЛП(Выборка.тек_ИнструкцияПоСдаче));
		//ДанныеКТК.Вставить("ИнструкцияПоСдаче",			СокрЛП(ИнструкцииПоСдаче));
		ДанныеКТК.Вставить("СобственникКТК", 			Выборка.тек_Собственник);
		ДанныеКТК.Вставить("ВидСобственности", 			Выборка.тек_ВидСобственности);
		
		Инструкции.Вставить(Выборка.КТК, ДанныеКТК);
	КонецЦикла;	
	
	Возврат Инструкции;
	
