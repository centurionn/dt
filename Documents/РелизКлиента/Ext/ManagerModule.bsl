		Возврат;
	КонецЕсли;
	
	Если ТаблицаНоминаций = Неопределено Тогда
		// Получим таблицу номинаций релиза собственника и оставим в ней только те контейнеры,
		// которые не добавлены в другие релизы клиентов
		ТаблицаНоминацийИсходная = Документы.РелизСобственника.КонтейнерыРелизаСобственника(Объект.РелизСобственника);
		ТаблицаНоминаций = ТаблицаНоминацийИсходная.СкопироватьКолонки();
		Для Каждого СтрокаКТК Из ТаблицаНоминацийИсходная Цикл
			Если СтрокаКТК.РелизКлиента = Объект.Ссылка
				ИЛИ СтрокаКТК.РелизКлиента = Документы.РелизКлиента.ПустаяСсылка() Тогда
				ЗаполнитьЗначенияСвойств(ТаблицаНоминаций.Добавить(), СтрокаКТК);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
		
	// Евросиб Фролов (30.05.2022 Task №49741
