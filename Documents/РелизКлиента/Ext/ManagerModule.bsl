#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов  - Массив    - ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы (выходной параметр).
//  ОбъектыПечати         - СписокЗначений  - значение - ссылка на объект;
//                                            представление - имя области в которой был выведен объект (выходной
//                                                            параметр);
//  ПараметрыВывода       - Структура       - дополнительные параметры сформированных табличных документов (выходной
//                                            параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	// Запрос на терминал
	НужноПечататьМакет = УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ЗапросНаТерминал");
	
	Если НужноПечататьМакет Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
												КоллекцияПечатныхФорм,
		  										"ЗапросНаТерминал",
												"Запрос на терминал",
												ПечатьЗапроса(МассивОбъектов, ОбъектыПечати, ПараметрыПечати),
												,
												"Документ.РелизКлиента.ПФ_MXL_ЗапросНаТерминал");
																						
	КонецЕсли;
		
КонецПроцедуры

// Функция возвращает табличный документ запроса на терминал
//
// Параметры:
//  МассивОбъектов - Массив - объекты, по которым требуется сформировать печатную форму;
//  ОбъектыПечати  - СписокЗначений - разметка табличных документов по печатаемым объектам:
//   * Значение      - ЛюбаяСсылка - печатаемый объект;
//   * Представление - Строка - имя области, соответствующее объекту.
// 
// Возвращаемое значение:
//  ТабличныйДокумент - печатная форма.
//
Функция ПечатьЗапроса(МассивОбъектов, ОбъектыПечати, ПараметрыПечати) Экспорт
	// ДИТ US 58592 TA 60724 Евсенкин М.А. Начало: 13.12.2022	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Подсветка.РеквизитФормы КАК РеквизитФормы,
		|	Подсветка.ОформляемыйДокумент КАК ОформляемыйДокумент
		|ИЗ
		|	РегистрСведений.ПодсветкаФормДокументов.СрезПоследних(
		|			,
		|			ОформляемыйДокумент В (&ОформляемыйДокумент)
		|				И РеквизитФормы В (""ДатаОтправленияПоЖДПлан"", ""СтанцияНазначенияПоЖД"")) КАК Подсветка";
	
	Запрос.УстановитьПараметр("ОформляемыйДокумент", МассивОбъектов);
	
	ТЗПодсветка = Запрос.Выполнить().Выгрузить();
	// ДИТ US 58592 TA 60724 Евсенкин М.А. Конец: 13.12.2022

	// Создаем табличный документ и устанавливаем имя параметров печати.
    ТабличныйДокумент = Новый ТабличныйДокумент;
    ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ЗапросНаТерминал";
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.РелизКлиента.ПФ_MXL_ЗапросНаТерминал");
	//ДИТ Шевченко А.В. 59945 06.10.2022 -Начало
	// Получаем запросом необходимые данные.
    Запрос = Новый Запрос();
    Запрос.Текст =
    "ВЫБРАТЬ
    |	РелизКлиента.Ссылка КАК Ссылка,
    |	РелизКлиента.НомерРелиза КАК НомерРелиза,
    |	РелизКлиента.ОбщееКоличествоКТКВРелизе КАК ОбщееКоличествоКТКВРелизе,
    |	РелизКлиента.ТипоразмерКТК КАК ТипоразмерКТК,
    |	РелизКлиента.СостояниеКТК КАК СостояниеКТК,
    |	РелизКлиента.ТерминалВыдачи КАК ТерминалВыдачи,
    |	РелизКлиента.ЛокацияВыдачи КАК ЛокацияВыдачи,
    |	РелизКлиента.СтокСдачи КАК СтокСдачи,
    |	РелизКлиента.ДействиеРелизаНачало КАК ДействиеРелизаНачало,
    |	РелизКлиента.ДействиеРелизаОкончание КАК ДействиеРелизаОкончание,
    |	РелизКлиента.НомернаяВыдача КАК НомернаяВыдача,
    |	РелизКлиента.Комментарий КАК Комментарий,
    |	РелизКлиента.СтокВыдачи КАК СтокВыдачи,
    |	РелизКлиента.Автоперевозка КАК Автоперевозка,
	// ДИТ СтанцияНазначенияПоЖД Евсенкин М.А. Начало: 13.12.2022
	|	РелизКлиента.СтанцияНазначенияПоЖД КАК СтанцияНазначенияПоЖД,
	|	РелизКлиента.ДатаОтправленияПоЖДПлан КАК ДатаОтправленияПоЖДПлан,
	// ДИТ СтанцияНазначенияПоЖД Евсенкин М.А. Конец: 13.12.2022
    //|	РелизКлиента.ПодстокВыдачи КАК ПодстокВыдачи, // Евросиб Фролов (28.03.2022 Task №49126
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 -начало
    |	РелизКлиента.Контейнеры.(
    |		Ссылка КАК Ссылка,
    |		НомерСтроки КАК НомерСтроки,
    |		КлючАналитикиПеревозки.Контейнер КАК Контейнер,
    |		ТипоразмерКТК КАК ТипоразмерКТК,
    |		ВидСобственности КАК ВидСобственности,
    |		СобственникКТК КАК СобственникКТК,
   // |		ДатаВывозаУдалить КАК ДатаВывоза,
   // |		ДатаВозвратаКлиентомУдалить КАК ДатаВозвратаКлиентом,
   // |		СдачаКонтейнераФИОВодителя КАК СдачаКонтейнераФИОВодителя,
   // |		СдачаКонтейнераРегНомерТС КАК СдачаКонтейнераРегНомерТС,
    |		ИдентификаторСтроки КАК ИдентификаторСтроки,
    |		ИдентификаторСтрокиТС КАК ИдентификаторСтрокиТС,
    |		ИдентификаторСтрокиПеревозчика КАК ИдентификаторСтрокиПеревозчика,
    |		КлючАналитикиПеревозки.ИнструкцияПоСдаче КАК ИнструкцияПоСдаче
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 -конец
    |	) КАК Контейнеры,
	//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -Начало
	//|	РелизКлиента.ТранспортныеСредства.(
	//|		Ссылка КАК Ссылка,
	//|		НомерСтроки КАК НомерСтроки,
	//|		ФИОВодителя КАК ФИОВодителя,
	//|		РегНомерТС КАК РегНомерТС,
	//// Евросиб Фролов (16.02.2022 Task №44768
	//|		ПаспортныеДанные КАК ПаспортныеДанные,
	//|		Автоперевозчик КАК Автоперевозчик,
	//|		ИНН КАК ИНН,
	//|		КПП КАК КПП,
	//// Евросиб Фролов)
	//|		ИдентификаторСтроки КАК ИдентификаторСтроки
	//|	) КАК ТранспортныеСредства,
	// Евросиб Фролов (28.03.2022 Task №49126
	//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -Конец
	|	РелизКлиента.ПодстокиВыдачи.(
    |		Ссылка КАК Ссылка,
    |		НомерСтроки КАК НомерСтроки,
    |		НаименованиеПодстока КАК НаименованиеПодстока
    |	) КАК ПодстокиВыдачи,
	|	РелизКлиента.ПодстокиСдачи.(
    |		Ссылка КАК Ссылка,
    |		НомерСтроки КАК НомерСтроки,
    |		НаименованиеПодстока КАК НаименованиеПодстока
    |	) КАК ПодстокиСдачи
	// Евросиб Фролов)
    |ИЗ
    |	Документ.РелизКлиента КАК РелизКлиента
    |ГДЕ
    |	РелизКлиента.Ссылка В(&МассивОбъектов)"; 
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Шапка = Запрос.Выполнить().Выбрать();
	
	ПервыйДокумент = Истина;
	
	Пока Шапка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
            // Все документы нужно выводить на разных страницах.
            ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
        КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		// Запомним номер строки, с которой начали выводить текущий документ.
        НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
        
		/////////////////////////////////////////////////////////////
		// ДИТ US 62421 TA 64346 Евсенкин М.А. Начало: 03.02.2023
		// Было:
		//ТаблицаКТК 				= Шапка.Контейнеры.Выгрузить();
		//Стало:
		ТаблицаКТК				= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Шапка.Ссылка,"Контейнеры").Выгрузить();
		// ДИТ US 62421 TA 64346 Евсенкин М.А. Конец: 03.02.2023
		ТаблицаТС 				= ПолучитьТаблицуТСДокумента(Шапка.Ссылка);       
		//ДИТ, Беляев СЮ, ТА49361, 30-03-2022, начало
		//ТаблицаПеревозчиков.Колонки.Добавить("Выведен", Новый ОписаниеТипов("Булево"));
		//ДИТ, Беляев СЮ, ТА49361, 30-03-2022, конец
		
		//ДИТ Шевченко А.В. US 62479 ТА 59963 24.04.2023 -Начало
		СтруктураТЗОформления  					= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Шапка.Ссылка,"ТаблицаДляОформленияПФЗапросНаТерминал").Получить();
		Если СтруктураТЗОформления <> Неопределено И ТипЗнч(СтруктураТЗОформления) = Тип("Структура") Тогда
			ТаблицаДляОформленияДоизменения  		= СтруктураТЗОформления.ТаблицаДляОформленияПФЗапросНаТерминал;
			ТаблицаДляОформленияДоизмененияШапка  	= СтруктураТЗОформления.ТаблицаДляОформленияПФЗапросНаТерминалШапка;
		Иначе
			ТаблицаДляОформленияДоизменения  		= Неопределено;
			ТаблицаДляОформленияДоизмененияШапка  	= Неопределено;
		КонецЕсли;
		ТаблицаДляОформления = Новый ТаблицаЗначений;
		ОбластьМакетаСтрока = Макет.ПолучитьОбласть("Строка");
		Для Каждого ОбластьЗ Из ОбластьМакетаСтрока.Области Цикл 
			ТаблицаДляОформления.Колонки.Добавить(ОбластьЗ.Имя);	
		КонецЦикла;
		ТаблицаДляОформления.Колонки.Добавить("КлючАналитикиПеревозки"); 
		
		ТаблицаДляОформленияШапка = Новый ТаблицаЗначений;
		ОбластьМакетаШапка = Макет.ПолучитьОбласть("Шапка");
		Для Каждого ОбластьЗ Из ОбластьМакетаШапка.Области Цикл 
			ТаблицаДляОформленияШапка.Колонки.Добавить(ОбластьЗ.Имя);	
		КонецЦикла;
		//ДИТ Шевченко А.В. US 62479 ТА 59963 24.04.2023 -Конец
		
		ПериодДействияРелиза 	= Формат(Шапка.ДействиеРелизаНачало, "ДФ=dd.MM.yyyy") + " - " + Формат(Шапка.ДействиеРелизаОкончание, "ДФ=dd.MM.yyyy");
		Исполнитель 			= Пользователи.ТекущийПользователь();
		ЭлАдресИсполнителя 		= УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(Исполнитель, Справочники.ВидыКонтактнойИнформации.EmailПользователя);
		
		// Евросиб Фролов (28.03.2022 Task №49126
		МассивПодстоковВыдачи = Шапка.ПодстокиВыдачи.Выгрузить().ВыгрузитьКолонку("НаименованиеПодстока");
		ПодстокВыдачи = СтрСоединить(МассивПодстоковВыдачи, "; ");
		// Евросиб Фролов)
		
		ДанныеПечати = Новый Структура;

		ДанныеПечати.Вставить("ОтправительЗапроса", 	"АО Евросиб СПб-ТС");
		ДанныеПечати.Вставить("ДатаСозданияЗапроса", 	ПараметрыПечати.ДатаПечати);
		ДанныеПечати.Вставить("ТерминалВыдачи",			Шапка.ТерминалВыдачи);
        ДанныеПечати.Вставить("ЛокацияВыдачи", 			Шапка.ЛокацияВыдачи);
		ДанныеПечати.Вставить("СтокВыдачи", 			Шапка.СтокВыдачи);
		ДанныеПечати.Вставить("НомерРелиза", 			Шапка.НомерРелиза);
		ДанныеПечати.Вставить("КоличествоКТК", 			Шапка.ОбщееКоличествоКТКВРелизе);
		ДанныеПечати.Вставить("ТипоразмерКТК", 			Шапка.ТипоразмерКТК);
		ДанныеПечати.Вставить("СостояниеКТК", 			Шапка.СостояниеКТК);
		ДанныеПечати.Вставить("ПериодДействияРелиза", 	ПериодДействияРелиза);
		ДанныеПечати.Вставить("Исполнитель", 			Исполнитель);
        ДанныеПечати.Вставить("ЭлАдресИсполнителя", 	ЭлАдресИсполнителя);
		ДанныеПечати.Вставить("Комментарий", 			Шапка.Комментарий);
		ДанныеПечати.Вставить("НомернаяВыдача",			?(Шапка.НомернаяВыдача, "Номерная выдача", ""));
		// Евросиб Фролов (28.03.2022 Task №49126
		//ДанныеПечати.Вставить("ПодстокВыдачи", 		Шапка.ПодстокВыдачи);
		ДанныеПечати.Вставить("ПодстокВыдачи", 			ПодстокВыдачи);
		// Евросиб Фролов)
		// ДИТ US 58592 TA 60724 Евсенкин М.А. Начало: 13.12.2022
		ДанныеПечати.Вставить("СтанцияНазначенияПоЖД",  Шапка.СтанцияНазначенияПоЖД);
		ДанныеПечати.Вставить("ДатаОтправленияПоЖДПлан",Шапка.ДатаОтправленияПоЖДПлан);
		// ДИТ US 58592 TA 60724 Евсенкин М.А. Конец: 13.12.2022
												
		МассивОбластейМакета = Новый Массив;
		
		МассивОбластейМакета.Добавить("Шапка");
		МассивОбластейМакета.Добавить("Строка");
								
		Для Каждого ИмяОбласти Из МассивОбластейМакета Цикл
			
			ОбластьМакета = Макет.ПолучитьОбласть(ИмяОбласти);
			
			Если ИмяОбласти <> "Строка" Тогда
				ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ДанныеПечати);
				
				Если Шапка.Автоперевозка <> Перечисления.ВариантыАвтоперевозки.НеТребуется Тогда
					Если ИмяОбласти = "Шапка" Тогда
						
						//ДИТ Шевченко А.В. US 62479 ТА 59963 24.04.2023 -Начало
						Если НЕ ТаблицаДляОформленияДоизмененияШапка = Неопределено Тогда
							Если ТаблицаДляОформленияДоизмененияШапка.Количество() Тогда
								Для Каждого КолонкаТ Из ТаблицаДляОформленияШапка.Колонки Цикл
									попытка
										Если ТаблицаДляОформленияДоизмененияШапка[0][КолонкаТ.Имя] <> ОбластьМакета.Параметры[КолонкаТ.Имя] Тогда
											ОбластьМакета.Области[КолонкаТ.Имя].ЦветФона = Новый Цвет(255,200,200);		
										КонецЕсли;
									Исключение
										//нет параметра в макете
									КонецПопытки;	
								КонецЦикла;		
							КонецЕсли;
						КонецЕсли;
						ЗаполнитьЗначенияСвойств(ТаблицаДляОформленияШапка.Добавить(),ОбластьМакета.Параметры);
						
						//ДИТ Шевченко А.В. US 62479 ТА 59963 24.04.2023 -Конец
						
						// ДИТ US 58592 TA 60724 Евсенкин М.А. Начало: 13.12.2022 Полей стало больше, организую цикл
						// Было:
						//БезГраницы = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
						//ОблатьЗаголовок = ОбластьМакета.Области.АвтоперевозкаЗаголовок;
						//ОбластьЗначение = ОбластьМакета.Области.АвтоперевозкаЗначение;
						//
						//ОблатьЗаголовок.Текст = "";
						//ОбластьЗначение.Текст = "";
						//
						//ОблатьЗаголовок.ГраницаСнизу = БезГраницы;
						//ОблатьЗаголовок.ГраницаСправа = БезГраницы;
						//ОблатьЗаголовок.ГраницаСлева = БезГраницы;
						//ОблатьЗаголовок.ГраницаСверху = БезГраницы;
						//
						//ОбластьЗначение.ГраницаСнизу = БезГраницы;
						//ОбластьЗначение.ГраницаСправа = БезГраницы;
						//ОбластьЗначение.ГраницаСлева = БезГраницы;
						//ОбластьЗначение.ГраницаСверху = БезГраницы; 
						//Стало:
						МассивПолей = Новый Массив;
						МассивПолей.Добавить("Автоперевозка");
						МассивПолей.Добавить("ДатаОтправленияПоЖДПлан");
						МассивПолей.Добавить("СтанцияНазначенияПоЖД");
						
						БезГраницы = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
						
						Для Каждого СтрМассивПолей Из МассивПолей Цикл 
							ОблатьЗаголовок = ОбластьМакета.Области[СтрМассивПолей+"Заголовок"];
							ОбластьЗначение = ОбластьМакета.Области[СтрМассивПолей+"Значение"];
							ОблатьЗаголовок.Текст = "";
