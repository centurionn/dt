Процедура ОпределитьИзменитьСтатус(Ссылка,Письмо) Экспорт //ДИТ Шевченко А.В. 51340 17.10.2022
	
	Если Ссылка.ПисьмоНаЗапрос <> Письмо Тогда
		Возврат;
	КонецЕсли;	
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Документ.РелизКлиента");
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	
	EdiОбмен     	 = Ссылка.ТерминалВыдачи.EDIОбменСТерминалами;
	ВерсияОбмена 	 = Ссылка.ТерминалВыдачи.XmlВерсияРелизаКлиента;
	ОтветОтТЕрминала = Ссылка.ТерминалВыдачи.ОбрабатыватьОтветыEDIОтТерминала;
	
	Если ВерсияОбмена = Перечисления.XmlВерсияРелизаКлиента.ПустаяСсылка() Тогда
		ВерсияОбмена = Перечисления.XmlВерсияРелизаКлиента.ЕдиныйФайлXml;
	КонецЕсли;	
	
	Если EdiОбмен и ВерсияОбмена = Перечисления.XmlВерсияРелизаКлиента.НесколькоФайловXml Тогда
		Сч = 0;
		//Для Каждого СТрокаТЧ Из Ссылка.ТранспортныеСредства Цикл
		Для Каждого СТрокаТЧ Из Ссылка.Контейнеры Цикл
			КонтейнерП = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СТрокаТЧ.КлючАналитикиПеревозки,"Контейнер");
			КлючиМ = Новый Массив;
			КлючиМ.Добавить(СТрокаТЧ.КлючАналитикиПеревозки);
			ТЗ = Справочники.КлючиАналитикиПеревозки.КлючиАналитикиЗначенияПолейПоЭтапуПеревозки(КлючиМ,Перечисления.ЭтапыПеревозки.ПерваяМиля);
			Если ТЗ.Количество() Тогда
				Если Ссылка.НомернаяВыдача Тогда
					//Если ЗначениеЗаполнено(СТрокаТЧ.ИНН) И ЗначениеЗаполнено(СТрокаТЧ.Автоперевозчик) И ЗначениеЗаполнено(СТрокаТЧ.Контейнер) Тогда
					Если ЗначениеЗаполнено(ТЗ[0].ИНН) И ЗначениеЗаполнено(ТЗ[0].Автоперевозчик) И ЗначениеЗаполнено(КонтейнерП) Тогда
						Сч = Сч + 1;                                        
					КонецЕсли;
				Иначе
					//Если ЗначениеЗаполнено(СТрокаТЧ.ИНН) И ЗначениеЗаполнено(СТрокаТЧ.Автоперевозчик) Тогда
					Сч = Сч + 1;                                        
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если Сч = Ссылка.ОбщееКоличествоКТКВРелизе Тогда
			Если ОтветОтТЕрминала Тогда
				Статус = Справочники.СибурСтатусыЗаявок.ОтправленБезОтвета;
			Иначе
				Статус = Справочники.СибурСтатусыЗаявок.Отправлен;
			КонецЕсли;
		Иначе
			Если ОтветОтТЕрминала Тогда
				Статус = Справочники.СибурСтатусыЗаявок.ЧастичноОтправленБезОтвета;
			Иначе
				Статус = Справочники.СибурСтатусыЗаявок.ЧастичноОтправлен;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	
	Если EdiОбмен и ВерсияОбмена = Перечисления.XmlВерсияРелизаКлиента.ЕдиныйФайлXml Тогда
		Сч = 0;
		//Для Каждого СТрокаТЧ Из Ссылка.ТранспортныеСредства Цикл
		Для Каждого СТрокаТЧ Из Ссылка.Контейнеры Цикл
			КлючиМ = Новый Массив;
			КлючиМ.Добавить(СТрокаТЧ.КлючАналитикиПеревозки);
			ТЗ = Справочники.КлючиАналитикиПеревозки.КлючиАналитикиЗначенияПолейПоЭтапуПеревозки(КлючиМ,Перечисления.ЭтапыПеревозки.ПерваяМиля);
			//Если ЗначениеЗаполнено(СТрокаТЧ.ФИОВодителя) И ЗначениеЗаполнено(СТрокаТЧ.РегНомерТС) Тогда
			Если ТЗ.Количество() Тогда
				Если ЗначениеЗаполнено(ТЗ[0].ФИОВодителя) И ЗначениеЗаполнено(ТЗ[0].РегНомерТС) Тогда
					Сч = Сч + 1;                                        
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если Сч = Ссылка.ОбщееКоличествоКТКВРелизе Тогда
			Если ОтветОтТЕрминала Тогда
				Статус = Справочники.СибурСтатусыЗаявок.ОтправленБезОтвета;
			Иначе
				Статус = Справочники.СибурСтатусыЗаявок.Отправлен;
			КонецЕсли;
		Иначе
			Если ОтветОтТЕрминала Тогда
				Статус = Справочники.СибурСтатусыЗаявок.ЧастичноОтправленБезОтвета;
			Иначе
				Статус = Справочники.СибурСтатусыЗаявок.ЧастичноОтправлен;
			КонецЕсли;
		КонецЕсли	
	КонецЕсли;
	
	Если Не EdiОбмен И Ссылка.Проведен Тогда
		// ДИТ US 61614 TA 65194 Евсенкин М.А. Начало: 27.02.2023
		// Было:
		//Статус = Справочники.СибурСтатусыЗаявок.Отправлен; 
		//Стало:
		Сч = 0;
		//Для Каждого СТрокаТЧ Из Ссылка.ТранспортныеСредства Цикл
		Для Каждого СТрокаТЧ Из Ссылка.Контейнеры Цикл
			КлючиМ = Новый Массив;
			КлючиМ.Добавить(СТрокаТЧ.КлючАналитикиПеревозки);
			ТЗ = Справочники.КлючиАналитикиПеревозки.КлючиАналитикиЗначенияПолейПоЭтапуПеревозки(КлючиМ,Перечисления.ЭтапыПеревозки.ПерваяМиля);
			Если ТЗ.Количество() Тогда
				//Если ЗначениеЗаполнено(СТрокаТЧ.ФИОВодителя) И ЗначениеЗаполнено(СТрокаТЧ.РегНомерТС) Тогда
				Если ЗначениеЗаполнено(ТЗ[0].ФИОВодителя) И ЗначениеЗаполнено(ТЗ[0].РегНомерТС) Тогда
					Сч = Сч + 1;                                        
				КонецЕсли; 
			КонецЕсли;
		КонецЦикла;
		Если Сч = Ссылка.ОбщееКоличествоКТКВРелизе Или Ссылка.ЛокацияВыдачи.Страна <> Справочники.СтраныМира.Россия Тогда
			Статус = Справочники.СибурСтатусыЗаявок.Отправлен;    
		Иначе
			Статус = Справочники.СибурСтатусыЗаявок.ЧастичноОтправлен;
		КонецЕсли
		// ДИТ US 61614 TA 65194 Евсенкин М.А. Конец: 27.02.2023
		
	КонецЕсли;	
	
	Если НЕ Ссылка.Проведен Тогда
		Статус = Справочники.СибурСтатусыЗаявок.Удалено;
	КонецЕсли;
	
	ДокументОбъект = Ссылка.ПолучитьОбъект();
	ДокументОбъект.СтатусОтправкиПолученияОтветаТерминала = Статус;
	
	//ДИТ Шевченко А.В. US 62489 ТА 68009 02.05.2023 -начало
	
	//ДИТ Шевченко А.В. US 62489 ТА 68009 02.05.2023 -конец
	
	ДокументОбъект.ЗапросОтправленТерминалу = Истина;
	ДокументОбъект.ДатаОтправкиЗапросаТерминалу = ТекущаяДата();
	ДокументОбъект.ИзмененыКлючевыеПоля = Ложь;
	//ДИТ Шевченко А.В. US 62479 ТА 59963 24.04.2023 -Начало
	ТЗ = ДокументОбъект.ТаблицаДляОформленияПФЗапросНаТерминалПромежуточная.Получить();
	ХранилищеЗнч   = Новый ХранилищеЗначения(ТЗ,Новый СжатиеДанных(9));
	ДокументОбъект.ТаблицаДляОформленияПФЗапросНаТерминал    = ХранилищеЗнч;

	//ДИТ Шевченко А.В. US 62479 ТА 59963 24.04.2023 -Конец
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	
КонецПроцедуры  

Функция ПолучитьКонтакты(Ссылка) Экспорт
	
	ТаблицаОтвет = Новый ТаблицаЗначений;
	ТаблицаОтвет.Колонки.Добавить("Контакт");
	ТаблицаОтвет.Колонки.Добавить("Представление");
	ТаблицаОтвет.Колонки.Добавить("Адрес");
	
	НовСтрока = ТаблицаОтвет.Добавить();
	НовСтрока.Адрес = Ссылка.ТерминалВыдачи.EmailОбменаСТерминалами;
КонецФункции	

Функция ПолучитьКоличествоСтрокСЗаполненойДатойВывоза(МКлючей) Экспорт //ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КлючиАналитикиПеревозки.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_Ключи
		|ИЗ
		|	Справочник.КлючиАналитикиПеревозки КАК КлючиАналитикиПеревозки
		|ГДЕ
		|	КлючиАналитикиПеревозки.Ссылка В(&Ссылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕстьNULL(КлючиАналитикиПеревозкиМили.ДатаВыдачиКТКСТерминала,ДАТАВРЕМЯ(1,1,1)) КАК ДатаВывоза,
		|	ВТ_Ключи.Ссылка КАК Ссылка
		|ИЗ
		|	ВТ_Ключи КАК ВТ_Ключи
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозкиМили
		|		ПО ВТ_Ключи.Ссылка = КлючиАналитикиПеревозкиМили.Ссылка
		|			И КлючиАналитикиПеревозкиМили.ЭтапПеревозки = ЗНАЧЕНИЕ(Перечисление.ЭтапыПеревозки.ПерваяМиля)
		|ГДЕ
		|	ЕстьNULL(КлючиАналитикиПеревозкиМили.ДатаВыдачиКТКСТерминала,ДАТАВРЕМЯ(1,1,1)) = &ДатаВывоза";
	
	Запрос.УстановитьПараметр("ДатаВывоза", Дата(1,1,1));
	Запрос.УстановитьПараметр("Ссылка", МКлючей);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Возврат ВыборкаДетальныеЗаписи.Количество();
	
КонецФункции

Процедура ЗакрытьЗадачиВЗаявке(ЗаявкаСсылка,СтатусОтправкиНаТерминал) Экспорт //ДИТ Шевченко А.В. BUG 75526 TA 75527 02.10.23
	
	ЗадачиДляОтметкиВыполнения = Новый Массив;
	ЗадачиДляОтметкиВыполнения.Добавить(Справочники.Состояния.БронированиеКТК);
	
	Если СтатусОтправкиНаТерминал <> Справочники.СибурСтатусыЗаявок.ВерсияОтправкиУстарела И СтатусОтправкиНаТерминал <> Справочники.СибурСтатусыЗаявок.НеОтправлен Тогда
		ЗадачиДляОтметкиВыполнения.Добавить(Справочники.Состояния.РелизНаВыдачуКТККлиенту);	
	КонецЕсли;
	
	МаршрутизацияСервер.ОтметитьВыполнениеЗадачПоСсылке(ЗаявкаСсылка, ЗадачиДляОтметкиВыполнения);
	
КонецПроцедуры	

