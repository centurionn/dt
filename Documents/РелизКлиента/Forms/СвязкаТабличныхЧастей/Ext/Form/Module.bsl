&НаКлиенте
Процедура СвязатьСтроки(Команда)
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Связать", Истина);
	
    СтрокиДляСвязиКТК = Контейнеры.НайтиСтроки(ПараметрыОтбора);
	
	Если ПривязкаКВодителям Тогда
		
		// Связываем водителей с КТК
		
		СтрокиДляСвязиВодители = ТранспортныеСредства.НайтиСтроки(ПараметрыОтбора);		
		
		Если СтрокиДляСвязиКТК.Количество() = 0
			ИЛИ СтрокиДляСвязиВодители.Количество() = 0 Тогда
			ПоказатьПредупреждение(, "Не выбраны строки для связи");
			Возврат;
		КонецЕсли;
					
		СтрокаКТК = СтрокиДляСвязиКТК[0];
		СтрокаВодителя = СтрокиДляСвязиВодители[0];
		
		ИдентификаторСтрокиВодителя = СтрокаВодителя.ИдентификаторСтроки;
		
		// Если уже есть строки КТК с таким водителем, то нужно спросить о необходимости перепривязать водителя
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить(ИдентификаторСтрокиТСИмя, ИдентификаторСтрокиВодителя);
		
		СвязанныеСтроки = Контейнеры.НайтиСтроки(ПараметрыОтбора);
		
		Если СвязанныеСтроки.Количество() > 0 Тогда
			Режим = РежимДиалогаВопрос.ДаНет;
			
			ПараметрыПривязки = Новый Структура();
			ПараметрыПривязки.Вставить("СтрокаКТК", 			СтрокаКТК);
			ПараметрыПривязки.Вставить("ИдентификаторСтроки", 	СтрокаВодителя.ИдентификаторСтроки);
			ПараметрыПривязки.Вставить("СвязанныеСтроки", 		СвязанныеСтроки);
			
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОПерепривязке", ЭтотОбъект, ПараметрыПривязки);
			ПоказатьВопрос(Оповещение, "Привязка строки с данными по автоперевозке с нескольким контейнерам невозможна. 
							|Перепривязать данные по водителю " + СтрокаВодителя.ФИОВодителя + " (" + СтрокаВодителя.РегНомерТС + ") к контейнеру " + СтрокаКТК.Контейнер + "?" , Режим, 0);
		Иначе
			СтрокаКТК[ИдентификаторСтрокиТСИмя] = СтрокаВодителя.ИдентификаторСтроки;
			СтрокаКТК.Привязан = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьОтборКТК();
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборТолькоНепривязанные(Команда)
	ТолькоНепривязанные = Не ТолькоНепривязанные;
	УстановитьОтборКТК();	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПослеЗакрытияВопросаОПерепривязке(Результат, ДопПараметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;
	
	// Уберем идентификатор водителя в ранее привязанных строках
	СвязанныеСтроки = ДопПараметры.СвязанныеСтроки;
	Для Каждого ТекущаяСтрока Из СвязанныеСтроки Цикл
		ТекущаяСтрока[ИдентификаторСтрокиТСИмя] = "";
		ТекущаяСтрока.Привязан = Ложь;
	КонецЦикла;	
	
	ДопПараметры.СтрокаКТК[ИдентификаторСтрокиТСИмя] = ДопПараметры.ИдентификаторСтроки;
	ДопПараметры.СтрокаКТК.Привязан = Истина;
	
КонецПроцедуры

&НаСервере
Функция СтруктураВозвращаемыхДанных()
	
	СтруктураВозврата = Новый Структура;
	
	РеквизитыФормы = ПолучитьРеквизиты();
	Для Каждого РеквизитФормы Из РеквизитыФормы Цикл
		
		СтруктураВозврата.Вставить(РеквизитФормы.Имя, ЭтотОбъект[РеквизитФормы.Имя]);
		
	КонецЦикла;
	
	Возврат СтруктураВозврата;
	
КонецФункции

&НаСервере
Процедура УстановитьОтборКТК()
	
	Элементы.КонтейнерыОтборТолькоНепривязанные.Пометка = ТолькоНепривязанные;
	
	Если ТолькоНепривязанные Тогда
		ОтборСтрок = Новый ФиксированнаяСтруктура("Привязан", Ложь);
		Элементы.Контейнеры.ОтборСтрок = ОтборСтрок;
	Иначе
		Элементы.Контейнеры.ОтборСтрок = Неопределено;
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура НастроитьВидимостьЭлементов()	
	Элементы.ТранспортныеСредства.Видимость = ПривязкаКВодителям;
КонецПроцедуры	

