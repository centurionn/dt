&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	Контейнеры.Загрузить(Параметры.ДокументОбъект.Контейнеры.Выгрузить());
	//ДИТ Шевченко А.В. TASK 51973 03.06.2022 -Начало
	ТранспортныеСредстваИмяТЧ = Параметры.ТранспортныеСредстваИмяТЧ;
	ИдентификаторСтрокиТСИмя  		   = Параметры.ИдентификаторСтрокиТСИмя;
	ПроверитьКорректностьПараметров(Отказ,ТранспортныеСредстваИмяТЧ,ИдентификаторСтрокиТСИмя);
	ТранспортныеСредства.Загрузить(Параметры.ДокументОбъект[ТранспортныеСредстваИмяТЧ].Выгрузить());
	//ДИТ Шевченко А.В. TASK 51973 03.06.2022 -Конец	
	ПривязкаКВодителям = Параметры.ПривязкаКВодителям;
	ПроставитьПризнакПривязки();	
	
	ТолькоНепривязанные = Истина;
	УстановитьОтборКТК();
	

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры

//Евросиб Коханенко Н.А. #61705 09.12.2022 (
&НаКлиенте
Процедура ОткрытьОкноСИнструкциями(Форма, Команда)
	ИнструкцииКлиент.ОткрытьОкноСИнструкциями(ЭтаФорма, Команда);
КонецПроцедуры  
//Евросиб Коханенко Н.А. #61705 09.12.2022 )


&НаСервереБезКонтекста
Процедура ПроверитьКорректностьПараметров(Отказ,ТранспортныеСредстваИмяТЧ,ИдентификаторСтрокиТСИмя)
	Если ТранспортныеСредстваИмяТЧ <> "ТранспортныеСредства" И ТранспортныеСредстваИмяТЧ <> "ТранспортныеСредстваПоследняяМиля" Тогда
		Отказ = Истина;
	КонецЕсли;
	Если ИдентификаторСтрокиТСИмя <> "ИдентификаторСтрокиТС" И ИдентификаторСтрокиТСИмя <> "ИдентификаторСтрокиТСПоследняяМиля" Тогда
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры	

&НаСервере
Процедура ПроставитьПризнакПривязки();
	
	// Проставим признак "Привязан" в строках контейнеров.
	// Он потребуется для установки фильтра "Только непривязанные".
	
	Для Каждого ТекущаяСтрока Из Контейнеры Цикл
		Если ПривязкаКВодителям Тогда
			ТекущаяСтрока.Привязан = ЗначениеЗаполнено(ТекущаяСтрока[ИдентификаторСтрокиТСИмя]);
		//ДИТ Шевченко А.В. 06.10.2022 -начало	
		//Иначе
		//	ТекущаяСтрока.Привязан = ЗначениеЗаполнено(ТекущаяСтрока[ИдентификаторСтрокиПеревозчикаИмя]);
		//ДИТ Шевченко А.В. 06.10.2022 -конец	
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры	

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	НастроитьВидимостьЭлементов();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Не ВыполняетсяЗакрытие И Модифицированность И Не СохранитьПараметры Тогда
		
		СохранитьПараметры = Ложь;
		Оповещение = Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект);
		ТекстПредупреждения = НСтр("ru = 'Привязка контейнеров была изменена. Перенести изменения?'");
		
		ОбщегоНазначенияКлиент.ПоказатьПодтверждениеЗакрытияФормы(Оповещение, Отказ, ЗавершениеРаботы, ТекстПредупреждения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ВыполняетсяЗакрытие = Истина;
	СохранитьПараметры  = Истина;
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если СохранитьПараметры И Не ЗавершениеРаботы Тогда
		
		ОповеститьОВыборе(СтруктураВозвращаемыхДанных());
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыКонтейнеры

&НаКлиенте
Процедура КонтейнерыСвязатьПриИзменении(Элемент)
	
	// Если выполняется привязка КТК к водителям, то можно выделить только одну строку
	// Если выполняется привязка КТК в автоперевозчикам, то можно выделить несколько строк КТК и одну строку автоперевозчика.
	Если ПривязкаКВодителям = Ложь Тогда
		Возврат;
	КонецЕсли;	
	
	ТекущиеДанные = Элементы.Контейнеры.ТекущиеДанные;
	
	Если ТекущиеДанные.Связать Тогда
		Для Каждого ТекСтрока Из Контейнеры Цикл
			ТекСтрока.Связать = Ложь;
		КонецЦикла;
		ТекущиеДанные.Связать = Истина;
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыТранспортныеСредства

&НаКлиенте
Процедура ТранспортныеСредстваСвязатьПриИзменении(Элемент)
	
	// Для связки можно выбрать только одного водителя
	
	ТекущиеДанные = Элементы.ТранспортныеСредства.ТекущиеДанные;
	
	Если ТекущиеДанные.Связать Тогда
		Для Каждого ТекСтрока Из ТранспортныеСредства Цикл
			ТекСтрока.Связать = Ложь;
		КонецЦикла;
		ТекущиеДанные.Связать = Истина;
	КонецЕсли;
	
КонецПроцедуры

