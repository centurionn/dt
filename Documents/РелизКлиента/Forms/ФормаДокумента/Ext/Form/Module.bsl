	// открытой форме могли выбрать этот релиз в заявке и сохранить данные.
	ОпределитьИдентификаторРелиза();
	
	Если Не ЗначениеЗаполнено(ИдентификаторСтрокиЗаявки) Тогда
		ПоказатьПредупреждение(, "Не определена строка запроса на КТК, по которой был создан данный релиз.
									|Обновить данные невозможно.");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Заявка) Тогда
		ПоказатьПредупреждение(, "Не указана заявка.
									|Обновить данные невозможно.");
		Возврат;
	КонецЕсли;
	
	ЕстьУдаленныеДанные = Ложь;
	//ПроверитьУдаленныеДанныеВЗапросе(ЕстьУдаленныеДанные);
	
	Если ЕстьУдаленныеДанные Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОПерезаполненииПоЗапросу", ЭтотОбъект, Параметры);
		ПоказатьВопрос(Оповещение, "При обновлении будет произведена очистка связки номера контейнера с водителем и/или перевозчикау по отсутствующим в запросе на КТК водителям. Продолжить?", Режим, 0);
	Иначе	
		ОбновитьДанныеИзЗапросаНаСервере();
		// ДИТ US 58592 TA 60724 Евсенкин М.А. Начало: 21.12.2022
		НастроитьДоступностьЭлементовШапки();
		// ДИТ US 58592 TA 60724 Евсенкин М.А. Конец: 21.12.2022
	КонецЕсли;   
	
	// ДИТ US 79950 ТА 79951 Сержантова А.С. Начало: 21.02.2024
	Оповестить("НеобходимоОбновитьФормуЗаявкиДляРаботыСЗапросомКТК", , ЭтаФорма);
	ЗаполнитьТаблицуПоКлючамАналитики();
	// ДИТ  US 79950 ТА 79951 Сержантова А.С. Конец: 21.02.2024
	
КонецПроцедуры

