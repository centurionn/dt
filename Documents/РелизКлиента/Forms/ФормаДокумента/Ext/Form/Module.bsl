&НаСервереБезКонтекста
Процедура ПолучитьСписокДляОтбораРодителей(ЛокацияСдачи,МассивЛокаций)
	МассивМультилокации = Справочники.Мультилокации.СоставМультилокации(ЛокацияСдачи);
	
	МассивСубъектов = Новый Массив;
	
	Для Каждого ЗнчМульти Из МассивМультилокации Цикл 
		//Евросиб - АСуслов 05.05.2023 11:40:43 #67492
		//(
		//Если ЗнчМульти.Тип = Справочники.ТипыЛокаций.Субъект Тогда
		Если ЗнчМульти.Тип = Справочники.ТипыЛокаций.НаселенныйПункт Тогда
		//)
		//Евросиб - АСуслов 05.05.2023 11:40:45 #67492
			Если МассивСубъектов.Найти(ЗнчМульти) = неопределено Тогда
				МассивСубъектов.Добавить(ЗнчМульти);
			КонецЕсли;
		КонецЕсли;
		
		Если ЗнчМульти.Тип = Справочники.ТипыЛокаций.Терминал Тогда
			Если МассивЛокаций.НайтиПоЗначению(ЗнчМульти) = неопределено Тогда
				МассивЛокаций.Добавить(ЗнчМульти);
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;	
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Локации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Локации КАК Локации
		|ГДЕ
		|	Локации.Родитель В(&Родитель)
		|	И НЕ Локации.ПометкаУдаления
		|	И Локации.Тип = &Тип";
	
	Запрос.УстановитьПараметр("Родитель", МассивСубъектов);
	Запрос.УстановитьПараметр("Тип", Справочники.ТипыЛокаций.Терминал);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если МассивЛокаций.НайтиПоЗначению(ВыборкаДетальныеЗаписи.Ссылка) = неопределено Тогда
			МассивЛокаций.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
		КонецЕсли;	
	КонецЦикла;

КонецПроцедуры	

&НаКлиенте
Процедура ПодстокиСдачиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	// Евросиб Фролов (28.03.2022 Task №49126
	// Для выбора подстоков предлагаем только те терминалы, которые являются родителями выбранных стоков сдачи.
	СтандартнаяОбработка = Ложь;
	
	СтокиСдачи = ПолучитьТерминалыСтоковСдачи(Объект.СтокСдачи);
	
	Если СтокиСдачи.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Нет доступных для выбора подстоков для указанных локаций сдачи.");
		Возврат;
	КонецЕсли;	
	
	ПараметрыФормыВыбора = Новый Структура;
	ПараметрыФормыВыбора.Вставить("Заголовок", "Выбор подстоков сдачи");
	ПараметрыФормыВыбора.Вставить("СписокЛокаций", СтокиСдачи);
	ПараметрыФормыВыбора.Вставить("ВыбранныеПодстоки", ПодстокиСдачи.ВыгрузитьЗначения());
	
	ОткрытьФорму("Документ.РелизКлиента.Форма.ВыборПодстока", ПараметрыФормыВыбора, Элемент,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	// Евросиб Фролов)
КонецПроцедуры

