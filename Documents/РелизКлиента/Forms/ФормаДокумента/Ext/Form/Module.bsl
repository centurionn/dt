Процедура ИзмененыКлючевыеПоля() //ДИТ Шевченко А.В. 51340 12.10.2022
		
	МассивСтатусов = Новый Массив;
	МассивСтатусов.Добавить(Справочники.СибурСтатусыЗаявок.Отправлен);
	МассивСтатусов.Добавить(Справочники.СибурСтатусыЗаявок.ЧастичноОтправлен);
	МассивСтатусов.Добавить(Справочники.СибурСтатусыЗаявок.ОтправленБезОтвета);
	МассивСтатусов.Добавить(Справочники.СибурСтатусыЗаявок.ЧастичноОтправленБезОтвета);
	МассивСтатусов.Добавить(Справочники.СибурСтатусыЗаявок.ЧастичноПринят);
	МассивСтатусов.Добавить(Справочники.СибурСтатусыЗаявок.Принят);
	МассивСтатусов.Добавить(Справочники.СибурСтатусыЗаявок.ВерсияОтправкиУстарела);
	МассивСтатусов.Добавить(Справочники.СибурСтатусыЗаявок.НеПринят); 
	
	Если МассивСтатусов.Найти(Объект.СтатусОтправкиПолученияОтветаТерминала) <> Неопределено Тогда
		Объект.ИзмененыКлючевыеПоля = Истина;
		Объект.СтатусОтправкиПолученияОтветаТерминала = Справочники.СибурСтатусыЗаявок.ВерсияОтправкиУстарела;
		Объект.ПисьмоНаЗапрос = Документы.ЭлектронноеПисьмоИсходящее.ПустаяСсылка();
	КонецЕсли;

