&НаКлиенте
Процедура КонтейнерыПередНачаломИзменения(Элемент, Отказ)    
	ТекСтрока = Элементы.Контейнеры.ТекущиеДанные; 
	Если ТекСтрока <> Неопределено Тогда
		ПроверитьАктуальностьКлючаАналитики(Элементы.Контейнеры.ТекущаяСтрока);
	КонецЕсли;
КонецПроцедуры     

// ДИТ US 76935 ТА 77189 Сержантова А.С. 08.12.2023     
&НаСервере
Процедура ПроверитьАктуальностьКлючаАналитики(ИдентификаторСтроки = Неопределено)   
	
	СтрокиДляОбновления = Новый Массив;
	Если ИдентификаторСтроки = Неопределено Тогда
		СтрокиДляОбновления = Объект.Контейнеры;	
	Иначе
	    СтрокиДляОбновления.Добавить(Объект.Контейнеры.НайтиПоИдентификатору(ИдентификаторСтроки));
	КонецЕсли;	
	
	БылоОбновлениеКлюча = Ложь;
	Для каждого СтрокаТЧ Из СтрокиДляОбновления Цикл
		АктуальнаяВерсия = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.КлючАналитикиПеревозки, "ВерсияДанных");
		Если СтрокаТЧ.ВерсияКлюча <> АктуальнаяВерсия Тогда
			ЗаполнитьТаблицуПоКлючамАналитики(СтрокаТЧ.КлючАналитикиПеревозки); 
			БылоОбновлениеКлюча = Истина;
		КонецЕсли;
	КонецЦикла;	
	Если БылоОбновлениеКлюча Тогда 
		ОбщегоНазначения.СообщитьПользователю("Версия ключа аналитики перевозки устарела, подгружены актуальные данные");		
	КонецЕсли; 
	
КонецПроцедуры
