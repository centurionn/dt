&НаСервереБезКонтекста
Функция ПроверитьСтрокиКлючейНаМиле(МассивКлючейП,ЭтапПеревозки,МассивПроверяемыхКолонок) //ДИТ Шевченко А.В. US 62421 TA 68370 10.04.2023
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КлючиАналитикиПеревозкиМили.Ссылка КАК КлючАналитикиПеревозки,
	               |	КлючиАналитикиПеревозкиМили.ФИОВодителя КАК ФИОВодителя,
	               |	КлючиАналитикиПеревозкиМили.РегНомерТС КАК РегНомерТС,
	               |	КлючиАналитикиПеревозкиМили.Автоперевозчик КАК Автоперевозчик,
	               |	КлючиАналитикиПеревозкиМили.ИНН КАК ИНН,
	               |	КлючиАналитикиПеревозкиМили.Ссылка.Контейнер КАК Контейнер
	               |ИЗ
	               |	Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозкиМили
	               |ГДЕ
	               |	КлючиАналитикиПеревозкиМили.Ссылка В(&МассивКлючей)
	               |	И (КлючиАналитикиПеревозкиМили.Ссылка.Контейнер <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
	               |			ИЛИ КлючиАналитикиПеревозкиМили.ФИОВодителя <> """"
	               |			ИЛИ (КлючиАналитикиПеревозкиМили.Автоперевозчик <> """"
	               |				И КлючиАналитикиПеревозкиМили.Автоперевозчик <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) И КлючиАналитикиПеревозкиМили.Автоперевозчик <> Неопределено))
	               |	И КлючиАналитикиПеревозкиМили.ЭтапПеревозки = &ЭтапПеревозки";

	Запрос.УстановитьПараметр("ЭтапПеревозки",ЭтапПеревозки);
	Запрос.УстановитьПараметр("МассивКлючей",МассивКлючейП);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	МассивКлючей = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		ДобавитьКлюч = Истина;
		Для Каждого ЗнчМассив Из МассивПроверяемыхКолонок Цикл
			Если НЕ ЗначениеЗаполнено(Выборка[ЗнчМассив]) Тогда
				ДобавитьКлюч = Ложь;
				Продолжить;
			КонецЕсли;	
		КонецЦикла;
		Если ДобавитьКлюч Тогда
			МассивКлючей.Добавить(Выборка.КлючАналитикиПеревозки);
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат МассивКлючей;
	
КонецФункции

