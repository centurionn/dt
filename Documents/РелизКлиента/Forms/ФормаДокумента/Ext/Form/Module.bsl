&НаКлиенте
Процедура ПоказатьДиалогОтправкиПоПочте(ПараметрыТерминала)
	
	ТекущаяДатаВНужномФормате = Формат(ТекущаяДата(),"ДФ='dd.MM.yyyy ЧЧ.мм.сс'");
	ДатаДокументаВНужномФормате = Формат(Объект.Дата,"ДФ='dd.MM.yyyy ЧЧ.мм.сс'"); 
	//ДИТ Шевченко А.В. 03.10.2022 57967 -начало
	МассивВлож = Новый Массив;
	Если ПараметрыТерминала.XmlВерсияРелизаКлиента = ПредопределенноеЗначение("Перечисление.XmlВерсияРелизаКлиента.НесколькоФайловXml") Тогда
		// ДИТ US 58592 TA 60724 Евсенкин М.А. Начало: 22.12.2022
		// Было:
		// СтрокиКВыгрузке = ПолучитьСтрокиКВыгрузке(Объект.НомернаяВыдача); 
		//Стало:
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("НомернаяВыдача",Объект.НомернаяВыдача);
		СтруктураПараметров.Вставить("ВариантыАвтоперевозкиНеТребуется",ПараметрыТерминала.ВариантыАвтоперевозкиНеТребуется);
		
		СтрокиКВыгрузке = ПолучитьСтрокиКВыгрузке(СтруктураПараметров);
		// ДИТ US 58592 TA 60724 Евсенкин М.А. Конец: 22.12.2022
		Если УжеЕстьОтправленныеПисьма(Объект.Ссылка) Тогда
			ПризнакОбновления = Истина;
		Иначе
			ПризнакОбновления = Ложь;
		КонецЕсли;	
		
		Если СтрокиКВыгрузке.Количество() > 0 Тогда
			// ДИТ US 58592 TA 60724 Евсенкин М.А. Начало: 22.12.2022
			// Было:
			//ПараметрыВыгрузки = Новый Структура("СсылкаРелизКлиента, СтрокиКВыгрузке, НомернаяВыдача,ОбовлениеРелиза,УдалениеРелиза", Объект.Ссылка, СтрокиКВыгрузке, Объект.НомернаяВыдача,ПризнакОбновления,ПараметрыТерминала.Свойство("УдалениеРелиза"));	 
			//Стало:
			ПараметрыВыгрузки = Новый Структура;
			ПараметрыВыгрузки.Вставить("СсылкаРелизКлиента",				Объект.Ссылка);
			ПараметрыВыгрузки.Вставить("СтрокиКВыгрузке",					СтрокиКВыгрузке);
			ПараметрыВыгрузки.Вставить("НомернаяВыдача",					Объект.НомернаяВыдача);
			ПараметрыВыгрузки.Вставить("ОбовлениеРелиза",					ПризнакОбновления);
			ПараметрыВыгрузки.Вставить("УдалениеРелиза",					ПараметрыТерминала.Свойство("УдалениеРелиза"));
			ПараметрыВыгрузки.Вставить("ВариантыАвтоперевозкиНеТребуется",	ПараметрыТерминала.ВариантыАвтоперевозкиНеТребуется);
			// ДИТ US 58592 TA 60724 Евсенкин М.А. Конец: 22.12.2022
			ЕСОбменСервер.ВыгрузитьXMLНаТерминал(МассивВлож,ПараметрыВыгрузки);   
		КонецЕсли;
	ИначеЕсли ПараметрыТерминала.XmlВерсияРелизаКлиента = ПредопределенноеЗначение("Перечисление.XmlВерсияРелизаКлиента.ЕдиныйФайлXml") Тогда	
		Адрес = ВыгрузитьВXMLНаСервере(ПараметрыТерминала.Свойство("УдалениеРелиза"));
		ИмяФайла = Строка(Объект.НомерРелиза)+"_"+Строка(ДатаДокументаВНужномФормате)+".xml";
		СтруктураВложения = Новый Структура("Представление,АдресВоВременномХранилище",ИмяФайла,Адрес);
		МассивВлож.Добавить(СтруктураВложения);
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыТерминала.ЭлектронныйАдресТерминала) = Тип("Строка") Тогда
		Получатели = СокрЛП(ПараметрыТерминала.ЭлектронныйАдресТерминала);
	Иначе
		Получатели = ПараметрыТерминала.ЭлектронныйАдресТерминала;
	КонецЕсли;	
	
	СписокВложений = МассивВлож;      
	//ДИТ Шевченко А.В. 03.10.2022 57967 -конец
	
	ТекстПисьма = "";   
	Если УжеЕстьОтправленныеПисьма(Объект.Ссылка) Тогда
		ШаблонТемы = "Корректировка запроса от %1 на выдачу контейнеров по релизу Евросиб: %2 в xml формате";
	Иначе
		ШаблонТемы = "Запрос от %1 на выдачу контейнеров по релизу Евросиб: %2 в xml формате";
	КонецЕсли;
	
	Если ПараметрыТерминала.Свойство("ЗапросНаОтмену") 
		И ПараметрыТерминала.ЗапросНаОтмену Тогда
		ШаблонТемы = "Отмена. Запрос от %1 на выдачу контейнеров по релизу Евросиб: %2";
		
		Если ПараметрыТерминала.Свойство("ТекстПисьма") 
			И ЗначениеЗаполнено(ПараметрыТерминала.ТекстПисьма) Тогда
			ТекстПисьма = ПараметрыТерминала.ТекстПисьма;	
		КонецЕсли;
	КонецЕсли;
	
	ТемаПисьма = СтрШаблон(ШаблонТемы, ТекущаяДатаВНужномФормате, Объект.НомерРелиза);
	
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.РаботаСПочтовымиСообщениями") Тогда
		МодульРаботаСПочтовымиСообщениямиКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("РаботаСПочтовымиСообщениямиКлиент");
		ПараметрыОтправки = МодульРаботаСПочтовымиСообщениямиКлиент.ПараметрыОтправкиПисьма();
		ПараметрыОтправки.Тема = ТемаПисьма;   
		ПараметрыОтправки.Текст = ТекстПисьма;
		ПараметрыОтправки.Получатель = Получатели;
		ПараметрыОтправки.Вложения = СписокВложений; 
		ПараметрыОтправки.Предмет = Объект.Ссылка;
		МодульРаботаСПочтовымиСообщениямиКлиент.СоздатьНовоеПисьмо(ПараметрыОтправки);
	КонецЕсли;
КонецПроцедуры
