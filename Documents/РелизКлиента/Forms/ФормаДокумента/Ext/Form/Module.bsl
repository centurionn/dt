//Также на форму добавлена команда и кнопка ПодобратьИзРелизаСобственника
&НаКлиенте
Процедура ПодобратьИзРелизаСобственника(Команда)
	ДоступноеКоличество = Объект.ОбщееКоличествоКТКВРелизе - Объект.Контейнеры.Количество();

	Если ДоступноеКоличество <= 0 Тогда
		ПоказатьПредупреждение(, "В документе уже заполнено максимально возмозможное количество КТК.");
		Возврат;
	КонецЕсли;
	
	ПараметрыЧтения = Новый Структура;
	ПараметрыЧтения.Вставить("КоличествоСтрок", ДоступноеКоличество);
	ПараметрыЧтения.Вставить("ТипоразмерКТК", 	Объект.ТипоразмерКТК);
	ПараметрыЧтения.Вставить("СтокВыдачи", 		Объект.СтокВыдачи);
	ПараметрыЧтения.Вставить("РелизКлиента", 	Объект.Ссылка);
	ПараметрыЧтения.Вставить("РелизСобственника",Объект.РелизСобственника);
	ПараметрыЧтения.Вставить("МассивКТК", 		ПолучитьМассивКТК());
	
	ОповещениеДляЗагрузкиКТК = Новый ОписаниеОповещения("РезультатЧтенияКТКИзТабДокумента", ЭтаФорма);
	ОткрытьФорму("Документ.РелизКлиента.Форма.ДобавлениеКонтейнеровРелизаСобственника", ПараметрыЧтения, ЭтаФорма, ЭтаФорма.УникальныйИдентификатор,,,ОповещениеДляЗагрузкиКТК, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

