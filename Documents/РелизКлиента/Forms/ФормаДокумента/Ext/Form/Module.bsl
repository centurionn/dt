Процедура УдалитьСтрокиИзРелизаСобственника()
	Запрос = Новый Запрос;
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 -начало
	//Запрос.Текст = "ВЫБРАТЬ
