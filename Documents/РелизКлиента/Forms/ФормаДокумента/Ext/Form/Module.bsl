	// Евросиб Фролов (30.05.2022 Task №49741
	
	Если ЗначениеЗаполнено(Объект.РелизСобственника) Тогда
		Объект.СобственникКТК = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РелизСобственника, "Контрагент");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИдентификаторСтрокиЗаявки)
		ИЛИ Не ЗначениеЗаполнено(Объект.Заявка) Тогда
		Возврат;
	КонецЕсли;

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЗаявкаСписокЗапросНаКТК.ЛокацияВыдачи КАК ЛокацияВыдачи
	|ИЗ
	|	Документ.Заявка.СписокЗапросНаКТК КАК ЗаявкаСписокЗапросНаКТК
	|ГДЕ
	|	ЗаявкаСписокЗапросНаКТК.Ссылка = &Заявка
	|	И ЗаявкаСписокЗапросНаКТК.ИдентификаторСтроки = &ИдентификаторСтроки";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Заявка", Объект.Заявка);
	Запрос.УстановитьПараметр("ИдентификаторСтроки", ИдентификаторСтрокиЗаявки);
	
	РезультаЗапроса = Запрос.Выполнить();
		
	ВыборкаШапка = РезультаЗапроса.Выбрать();
	Если ВыборкаШапка.Следующий() Тогда
		
		ЛокацияВыдачиДоИзменения = Объект.ЛокацияВыдачи;
		Объект.ЛокацияВыдачи = ВыборкаШапка.ЛокацияВыдачи;
		
		// Если локация выдачи изменилась, то сток и терминал выдачи необходимо очистить.
		Если ЛокацияВыдачиДоИзменения <> Объект.ЛокацияВыдачи Тогда
			Объект.СтокВыдачи = Справочники.Локации.ПустаяСсылка();
			Объект.ТерминалВыдачи = Справочники.Локации.ПустаяСсылка();
			
			ЦветПодсветки = Новый Цвет(255, 0, 0);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЛокацияВыдачи", "ЦветТекстаЗаголовка", ЦветПодсветки);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЛокацияВыдачи", "ЦветТекста", ЦветПодсветки);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЛокацияВыдачи", "ЦветРамки", ЦветПодсветки);
			
			ИзмененыКлючевыеПоля(); //ДИТ Шевченко А.В. 51340 12.10.2022
			НастроитьТекстКнопкиПечати();
		КонецЕсли;	
		
	КонецЕсли;

	// Евросиб Фролов)
КонецПроцедуры
