&НаКлиенте
Процедура РезультатЧтенияТранспортныхСредств(ДанныеДляЗагрузки, ДополнительныеПараметры) Экспорт
	
	Если ДанныеДляЗагрузки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивСведений = ДанныеДляЗагрузки.Результат;
	
	Для Каждого ТекущаяЗапись Из МассивСведений Цикл
		
		НоваяСтрока = Объект[ДополнительныеПараметры.ИмяТЧ].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяЗапись);
		НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатЧтенияКТКИзТабДокумента(ДанныеДляЗагрузки, ДополнительныеПараметры) Экспорт
	// Заполнение табличной части Контейнеры в результате загрузки из Excel
	
	Если ДанныеДляЗагрузки = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	// Евросиб Фролов (14.02.2022 Ticket№ 46606
	ИнструкцияПоСдаче = Неопределено;
	Если ЗаполнятьПоПервойСтроке Тогда
		Если Объект.Контейнеры.Количество() > 0 Тогда
			ПерваяСтрока = Объект.Контейнеры[0];
			//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 -начало
			ИнструкцияПоСдачеПерваяСтрока = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(ПерваяСтрока.КлючАналитикиПеревозки,"ИнструкцияПоСдаче");
			//Если ЗначениеЗаполнено(ПерваяСтрока.ИнструкцияПоСдаче) Тогда
			//	ИнструкцияПоСдаче = ПерваяСтрока.ИнструкцияПоСдаче;
			Если ЗначениеЗаполнено(ПерваяСтрока.ИнструкцияПоСдаче) Тогда
				ИнструкцияПоСдаче = ИнструкцияПоСдачеПерваяСтрока;
			КонецЕсли;
			//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 -конец
		КонецЕсли;		
	КонецЕсли;
	// Евросиб Фролов)
	
	МассивСведений = ДанныеДляЗагрузки.Результат;   
	
	// ДИТ US 76619 ТА 76735 Сержантова А.С. Начало: 13.11.2023
	Если ДанныеДляЗагрузки.Свойство("ТипЗаполнения") и ДанныеДляЗагрузки.ТипЗаполнения = 1 Тогда
		//Сначала посчитаем сколько строк нужно заполнить, если нет выделенных строк или всего одна выделенная   
		МассивИдентификаторов = Новый Массив;  
		КоличествоВыделенныхСтрок = Элементы.Контейнеры.ВыделенныеСтроки.Количество();  
		КоличествоВставляемыхКТК = МассивСведений.Количество();
		Если КоличествоВыделенныхСтрок <= 1 Тогда
			НачальныйНомерЗаполнения = 0;	
			Если КоличествоВыделенныхСтрок = 1 Тогда
				НачальныйНомерЗаполнения = Элементы.Контейнеры.ВыделенныеСтроки[0];
			КонецЕсли;  
			Пока НачальныйНомерЗаполнения <= (Объект.Контейнеры.Количество() - 1) Цикл  
				МассивИдентификаторов.Добавить(НачальныйНомерЗаполнения);
				НачальныйНомерЗаполнения = НачальныйНомерЗаполнения + 1;	
			КонецЦикла;
		КонецЕсли;   
		КоличествоСтрокЕслиНеВыделены = МассивИдентификаторов.Количество();    
		СтрокиКЗаполнению = ?(КоличествоСтрокЕслиНеВыделены = 0, Элементы.Контейнеры.ВыделенныеСтроки, МассивИдентификаторов);
		
		//Если ввели больше строк КТК, чем выделено или чем есть в документе, то предупреждаем, что перенесем не все 
		Если (КоличествоВыделенныхСтрок > 1 
			и КоличествоВыделенныхСтрок < КоличествоВставляемыхКТК)
			или (КоличествоСтрокЕслиНеВыделены > 0 и КоличествоСтрокЕслиНеВыделены < КоличествоВставляемыхКТК) Тогда
			НеПеренесемКоличество = ?(КоличествоСтрокЕслиНеВыделены = 0,
									КоличествоВставляемыхКТК - КоличествоВыделенныхСтрок,
									КоличествоВставляемыхКТК - КоличествоСтрокЕслиНеВыделены);  
			ПараметрыПереноса = Новый Структура("СтрокиКЗаполнению, ДанныеБуфера"); 
			ПараметрыПереноса.СтрокиКЗаполнению = СтрокиКЗаполнению;
			ПараметрыПереноса.ДанныеБуфера = МассивСведений;
			ОповещениеПослеВопроса = Новый ОписаниеОповещения("ПослеВопросаОПереносе_ЗаполнениеПустыхСтрокКТК", ЭтаФорма, ПараметрыПереноса); 	
			ТекстВопроса = СтрШаблон("Количество выделенных в документе строк для вставки меньше количества добавленных из буфера обмена контейнеров, 
			| %1 последних по списку контейнеров не будут перенесены в табличную часть документа.", НеПеренесемКоличество); 
			ПоказатьВопрос(ОповещениеПослеВопроса, ТекстВопроса,РежимДиалогаВопрос.ОКОтмена);  
			Возврат;
		КонецЕсли;
		
		ЗаполнитьПустыеСтрокиНомерамиКТКИзБуфера(СтрокиКЗаполнению, МассивСведений);
		Возврат;
	Иначе
	// ДИТ US 76619 ТА 76735 Сержантова А.С. Конец: 13.11.2023
	
	//ДИТ Шевченко А.В. BUG 75898 TA 75908 10.10.2023   
	Если МассивСведений.Количество() Тогда
		МассивКлючей = Новый Массив;
		Для Каждого СтрокаТЧ Из Объект.Контейнеры Цикл
			МассивКлючей.Добавить(СтрокаТЧ.КлючАналитикиПеревозки);
		КонецЦикла;
		МассивКлючейСПустымКонтейнером = ПолучитьМассивКлючейСПустымКонтейнером(МассивКлючей);
	КонецЕсли; 
	ОбработанныеКлючи = Новый Массив;
	//ДИТ Шевченко А.В. BUG 75898 TA 75908 10.10.2023
	
	Для Каждого ТекущаяЗапись Из МассивСведений Цикл
		//ДИТ Шевченко А.В. BUG 75898 TA 75908 10.10.2023
		//НоваяСтрока = Объект.Контейнеры.Добавить();
		////ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 -начало
		//Ответ = СоздатьКлючАналитики(Объект.Заявка,ТекущаяЗапись.Контейнер);
		//НоваяСтрока.КлючАналитикиПеревозки = Ответ.КлючАналитикиПеревозки;
		//НоваяСтрока.ВерсияКлюча 		   = Ответ.ВерсияДанных;
		//ЭтаФорма.Модифицированность = Истина;
		//ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяЗапись);
		//НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		//// Евросиб Фролов (14.02.2022 Ticket№ 46606
		//Если ИнструкцияПоСдаче <> Неопределено Тогда
		//	НоваяСтрока.ИнструкцияПоСдаче = ИнструкцияПоСдаче;
		//	ДобавитьЗначениеРеквизитаВКлюч(НоваяСтрока.КлючАналитикиПеревозки,ИнструкцияПоСдаче,"ИнструкцияПоСдаче",,,НоваяСтрока.ВерсияКлюча);
		//КонецЕсли;
		
		Для Каждого КлючСсылка Из МассивКлючейСПустымКонтейнером Цикл
			Если ОбработанныеКлючи.Найти(КлючСсылка) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;	
			
			СтруктураОтбора = Новый Структура("КлючАналитикиПеревозки",КлючСсылка);
			СтрокиТЧКонтейнеры = Объект.Контейнеры.НайтиСтроки(СтруктураОтбора);
			
			Для Каждого СтрокаТЧ Из СтрокиТЧКонтейнеры Цикл
				ЭтаФорма.Модифицированность = Истина;
				ЗаполнитьЗначенияСвойств(СтрокаТЧ, ТекущаяЗапись); 
				// ДИТ US 76935 ТА 77189 Сержантова А.С. Начало: 05.12.2023
				//ДобавитьЗначениеРеквизитаВКлюч(КлючСсылка,ТекущаяЗапись.Контейнер,"Контейнер",,,СтрокаТЧ.ВерсияКлюча); 
				// ДИТ US 76935 ТА 77189 Сержантова А.С. Конец: 05.12.2023
				Если ИнструкцияПоСдаче <> Неопределено Тогда
					СтрокаТЧ.ИнструкцияПоСдаче = ИнструкцияПоСдаче;  
					// ДИТ US 76935 ТА 77189 Сержантова А.С. Начало: 05.12.2023
					//ДобавитьЗначениеРеквизитаВКлюч(КлючСсылка,ИнструкцияПоСдаче,"ИнструкцияПоСдаче",,,СтрокаТЧ.ВерсияКлюча); 
					// ДИТ US 76935 ТА 77189 Сержантова А.С. Конец: 05.12.2023
				КонецЕсли;
			КонецЦикла;	
			
			ОбработанныеКлючи.Добавить(КлючСсылка);
			Прервать;
		КонецЦикла;	
		
		//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 -конец
		// Евросиб Фролов)
		//ДИТ Шевченко А.В. BUG 75898 TA 75908 10.10.2023
	КонецЦикла;    

	// ДИТ US 76619 ТА 76735 Сержантова А.С. Начало: 13.11.2023
	КонецЕсли; 
    // ДИТ US 76619 ТА 76735 Сержантова А.С. Конец: 13.11.2023
	
	ЗаполнитьДобавленныеКолонки("ВидСобственности, СобственникКТК, ИнструкцияПоСдачеИзАРМ");
	
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 -начало  
	//ЗаполнитьТаблицуПоКлючамАналитики();                // ДИТ US 76935 ТА 77189 Сержантова А.С. 08.12.2023 Закомментировала
