	// Обновим контакты терминала
	
	Если НЕ ЗначениеЗаполнено(Объект.ТерминалВыдачи) Тогда
		КонтактыТерминалаВыдачи.Очистить();
	Иначе
		ПредставлениеКИ = АдресаЭлектроннойПочтыТерминала(Объект.ТерминалВыдачи);
		Адреса = СтрРазделить(ПредставлениеКИ, ";", Ложь);
		КонтактыТерминалаВыдачи.ЗагрузитьЗначения(Адреса);
	КонецЕсли;
	
	// Евросиб Фролов (28.03.2022 Task №49126
	Объект.СтокВыдачи = Неопределено;
	ПодстокиВыдачи.Очистить();
	Объект.ПодстокиВыдачи.Очистить();
	// Евросиб Фролов)
	
	ИзмененыКлючевыеПоля(); //ДИТ Шевченко А.В. 51340 12.10.2022
	НастроитьТекстКнопкиПечати();
КонецПроцедуры

&НаКлиенте
Процедура РелизСобственникаПриИзменении(Элемент)
	
	// Евросиб Фролов (30.05.2022 Task №49741
	// Контейнеры теперь не заполняем по релизу собственника.
	// Заполнем только локацию выдачи.
	ОпределитьИдентификаторРелиза();
	
	Если Не ЗначениеЗаполнено(ИдентификаторСтрокиЗаявки) Тогда
		ПоказатьПредупреждение(, "Не определена строка запроса на КТК, по которой был создан данный релиз.
									|Обновить данные невозможно.");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Заявка) Тогда
		ПоказатьПредупреждение(, "Не указана заявка.
									|Обновить данные невозможно.");
		Возврат;
	КонецЕсли;
	
	ОбновитьЛокациюВыдачиИзЗапросаНаСервере();
	//ВыполнитьЗаполнениеПоРелизуСобственника(); закомментировал
	// Евросиб Фролов)
	
	ИзмененыКлючевыеПоля(); //ДИТ Шевченко А.В. 51340 12.10.2022
	НастроитьТекстКнопкиПечати();
	// Евросиб Фролов (28.03.2022 Task №49126
	ЗаполнитьНомерРелиза();
	// Евросиб Фролов)
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 -начало
	ЗаполнитьТаблицуПоКлючамАналитики();
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 -конец
	
КонецПроцедуры

