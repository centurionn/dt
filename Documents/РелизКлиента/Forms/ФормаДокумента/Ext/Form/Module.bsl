				СписокТиповЛокаций.Добавить(ПредопределенноеЗначение("Справочник.ТипыЛокаций.Сток"));
				
				ПараметрыОткрытияФормы = Новый Структура();
				ПараметрыОткрытияФормы.Вставить("МультилокацияРодителей", 	Объект.ЛокацияСдачи);
				// Евросиб Bug 93272 TA 93294 Рыбьяков К.А. 22.10.2024 ((
				//ПараметрыОткрытияФормы.Вставить("СписокТиповЛокаций", 		СписокТиповЛокаций);
				ПараметрыОткрытияФормы.Вставить("ТипыЛокаций", 		СписокТиповЛокаций);
				
