		ДокОб = РеквизитФормыВЗначение("Объект");
		МассивКлючей = ДокОб.ПолучитьКлючиИзЗапросаНаАвтоперевозку(Объект.Заявка,ИдентификаторСтрокиЗаявки);
		Для Каждого КлючМ Из МассивКлючей Цикл
			МассивКлючейИтог.Добавить(КлючМ);
		КонецЦикла;     
		// ДИТ US 79950 ТА 79951 Сержантова А.С. Начало: 16.02.2024 
		СоставУслугИзЗаявки = РезультаЗапроса[4].Выбрать();
