&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ИдентификаторСтрокиЗаявки", ИдентификаторСтрокиЗаявки); 
	
	// ДИТ US 83041 ТА 83043 Сержантова А.С. Начало: 25.04.2024       
	ТЗдляПроверки = Объект.Контейнеры.Выгрузить().Скопировать(,"Контейнер, КлючАналитикиПеревозки");
	КлючиАналитикиПеревозкиСервер.ПроверитьСоответствиеКонтейнераФутовостиВКалькуляции(ТЗдляПроверки, Отказ); 
	
	ТЗДляПроверки.Колонки.Добавить("Заявка", Новый ОписаниеТипов("ДокументСсылка.Заявка"));
	Для каждого Стр Из ТЗДляПроверки Цикл
		Стр.Заявка = Объект.Заявка;
	КонецЦикла;
	КТКЕстьВДругойЗаявке = КлючиАналитикиПеревозкиСервер.ПроверитьКТКвДругойЗаявке(ТЗдляПроверки);
	Для каждого Ответ Из КТКЕстьВДругойЗаявке Цикл
		Сообщить("!!! КТК № " + Ответ.НомерКТК + " встречается также в заявке " + Ответ.Заявка + ". Проверьте, не ошибка ли это!", СтатусСообщения.Внимание);
	КонецЦикла;
	// ДИТ US 83041 ТА 83043 Сержантова А.С. Конец: 25.04.2024
	
	// ДИТ US 76935 ТА 77189 Сержантова А.С. Начало: 05.12.2023    
	//Проверяем изменились ли ключи аналитики
	//Есть обработчик оповещения и обновления данных ключей на форме, но мало ли... вдруг за 5 секунд кто то поменял ключ
	БылоОбновлениеКлюча = Ложь;
	Для каждого СтрокаТЧ Из Объект.Контейнеры Цикл
		АктуальнаяВерсия = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.КлючАналитикиПеревозки, "ВерсияДанных");
		Если СтрокаТЧ.ВерсияКлюча <> "" и СтрокаТЧ.ВерсияКлюча <> АктуальнаяВерсия Тогда
			ЗаполнитьТаблицуПоКлючамАналитики(СтрокаТЧ.КлючАналитикиПеревозки); 
			БылоОбновлениеКлюча = Истина;
		КонецЕсли;
	КонецЦикла;	
	Если БылоОбновлениеКлюча Тогда 
		ОбщегоНазначения.СообщитьПользователю("Перед записью релиза обнаружено, что ключи аналитики перевозки изменились. Данные перезаполнены, внесите необходимые корректировки");		
		Отказ = Истина;
	КонецЕсли;  
	
	Если не Отказ Тогда 
		ЗаблокироватьКлючиАналитикиПеревозкиДляРедактирования();
		ДанныеОбновленияКлючей = ЗаполнитьДанныеДляОбновленияКлючейАналитикиПеревозки();
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ДанныеДляОбновленияКлючейАналитики", ДанныеОбновленияКлючей); 
	КонецЕсли; 
	// ДИТ US 76935 ТА 77189 Сержантова А.С. Конец: 05.12.2023
КонецПроцедуры 

