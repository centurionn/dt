	//Субботин 77659 18.12.2023 Начало
	Если НЕ МассивКтк.Количество() <> 0 Тогда
		
		//ДИТ Шевченко А.В. US 62421 ТА 70357 24.05.2023 -Начало
		ТранспортныеСредства 			  = РезультаЗапроса[1].Выгрузить();
		ТранспортныеСредстваПоследняяМиля = РезультаЗапроса[2].Выгрузить();
		
		МассивКлючейИтог = Новый Массив;
		Для Каждого Стр Из ТранспортныеСредства Цикл
			МассивКлючейИтог.Добавить(Стр.КлючАналитикиПеревозки);
