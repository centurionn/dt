	// ДИТ 65580 Давудов М.А. Конец: 23.02.2023
	МассивВариантовСобственности.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыСобственности.Спот"));
	// ДИТ 65580 Давудов М.А. Начало: 23.02.2023
	//Было:
	//МассивВариантовСобственности.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыСобственности.Море"));
