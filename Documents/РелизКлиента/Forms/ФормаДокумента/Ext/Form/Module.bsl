				ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,"Объект.Контейнеры[%1].ИНН","Отсутствует ИНН автоперевозчика","ИНН",ИндексСтроки,"Отсутствует ИНН автоперевозчика в строке %1");
			КонецЦикла;
			//ДИТ Шевченко А.В. US 62421 TA 68370 10.04.2023 -Конец
			ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки,Отказ);
			
			Если Не Ошибки = Неопределено Тогда 
				МассивСтрок = Новый Массив;
				МассивОшибокДляПредупреждения = Новый Массив;
				Для Каждого СтрОшибка Из Ошибки.СписокОшибок Цикл 
					МассивОшибокДляПредупреждения.Добавить(СтрШаблон(СтрОшибка.ТекстДляНесколькихОшибок,СтрОшибка.НомерСтроки+1));
					Если МассивСтрок.Найти(СтрОшибка.НомерСтроки) = Неопределено Тогда 
						МассивСтрок.Добавить(СтрОшибка.НомерСтроки);                
					КонецЕсли;
				КонецЦикла;	
			КонецЕсли;	
			
			Если Отказ
				И МассивСтрок.Количество() <> 0
				//ДИТ Шевченко А.В. US 62421 TA 68370 10.04.2023 -Начало
				//И (МассивСтрок.Количество() <> Объект.ТранспортныеСредства.Количество()) Тогда
				И (МассивСтрок.Количество() <> СтруктураОтвет.КоличествоПроверяемыхСтрок) Тогда
				//ДИТ Шевченко А.В. US 62421 TA 68370 10.04.2023 -Конец
				ОписаниеОповещения = новый ОписаниеОповещения("ПослеЗакрытияПредупреждение",ЭтотОбъект,ПараметрыТерминала);
				СписокКнопок = Новый СписокЗначений;
				СписокКнопок.Добавить("ПродолжитьОтправку","Продолжить отправку");
				СписокКнопок.Добавить("Отмена","Отмена");
				ПоказатьВопрос(ОписаниеОповещения,СтрСоединить(МассивОшибокДляПредупреждения, Символы.ПС),СписокКнопок,60,"Отмена","Данные на терминал не будут отправлены по причине","Отмена");
			КонецЕсли;	
			
			Если Отказ Тогда 
				Возврат;	
			КонецЕсли; 
			
		КонецЕсли;
		// ДИТ US 58592 TA 60724 Евсенкин М.А. Конец: 21.12.2022 
		
		ПоказатьДиалогОтправкиПоПочте(ПараметрыТерминала);	
		Возврат
		
		// ДИТ US 61614 TA 65194 Евсенкин М.А. Начало: 02.03.2023
	Иначе 
		//Рез = ПроверитьСтрокиПоВодителям();
		//Если НЕ рез Тогда
		//	ПоказатьПредупреждение(,"Запрос не может быть отправлен на терминал, т.к. не заполнена ни одна строка в данных по автоперевозке на первой миле");
		//	Возврат;
		//КонецЕсли; 
		// ДИТ US 61614 TA 65194 Евсенкин М.А. Конец: 02.03.2023
	КонецЕсли;
	//ДИТ Шевченко А.В. 03.10.2022 57967 -конец
	//ДИТ, Беляев СЮ, ТА49361, 30-03-2022, конец
	ОписаниеКоманды_Идентификатор = "ЗапросНаТерминал";
	
	ОписаниеКоманды_ОбъектыПечати = Новый Массив;
	ОписаниеКоманды_ОбъектыПечати.Добавить(Объект.Ссылка);
	
	ДополнительныеПараметрыПечати = Новый Структура;
	ДополнительныеПараметрыПечати.Вставить("ДатаПечати", ТекущаяДата());
	//ДИТ Шевченко А.В. US 62479 ТА 59963 24.04.2023 -Начало
	ДополнительныеПараметрыПечати.Вставить("ПечатьДляПисьма", Истина);
	//ДИТ Шевченко А.В. US 62479 ТА 59963 24.04.2023 -Конец
	УправлениеПечатьюКлиент.ВыполнитьКомандуПечати("Документ.РелизКлиента", ОписаниеКоманды_Идентификатор, ОписаниеКоманды_ОбъектыПечати,
		ЭтаФорма, ДополнительныеПараметрыПечати);
		
	ЭтаФорма.Прочитать(); //ДИТ Шевченко А.В. US 62479 ТА 59963 24.04.2023	
КонецПроцедуры

