	МассивВариантовСобственности.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыСобственности.СпотМорской"));
	МассивВариантовСобственности.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыСобственности.СпотДоплатный"));
	// ДИТ 65580 Давудов М.А. Конец: 23.02.2023
	
	ПараметрыОтбор = Новый Структура;
	ПараметрыОтбор.Вставить("ВариантСобственности", МассивВариантовСобственности);
	ПараметрыОтбор.Вставить("Статус", ПредопределенноеЗначение("Перечисление.СтатусыКТК.Свободен"));
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", ПараметрыОтбор);
	
	ОткрытьФорму("Справочник.ТЕ.ФормаВыбора", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
