// Процедура - Показать список перевозчиков
//
// Параметры:
//  ТЧМили	 - Строка - Имя табличной части автоперевозчиков первой или последней мили
//
&НаКлиенте
Процедура ПоказатьСписокПеревозчиков(ТЧМили)
	СписокПеревозчиков = Новый СписокЗначений;
	
	Для Каждого ТекущийПеревозчик Из Объект[ТЧМили] Цикл
		Если ЗначениеЗаполнено(ТекущийПеревозчик.Перевозчик) Тогда
			СписокПеревозчиков.Добавить(ТекущийПеревозчик.ИдентификаторСтроки, ТекущийПеревозчик.Перевозчик);
		КонецЕсли;	
	КонецЦикла;	
	
	Если СписокПеревозчиков.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Нет перевозчиков для выбора");
		Возврат;
	КонецЕсли;	
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораПеревозчика", ЭтотОбъект, Элементы.Контейнеры.ТекущиеДанные);
	СписокПеревозчиков.ПоказатьВыборЭлемента(Оповещение, "Выберите перевозчика.");
КонецПроцедуры	

