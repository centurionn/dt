// ДИТ US 76935 ТА 77189 Сержантова А.С. 05.12.2023  
&НаСервере
Функция ЗаполнитьДанныеДляОбновленияКлючейАналитикиПеревозки() 
	
	ДанныеОбновленияКлючейАналитики = Новый ТаблицаЗначений;   
	ДанныеОбновленияКлючейАналитики.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	ДанныеОбновленияКлючейАналитики.Колонки.Добавить("КлючАналитикиПеревозки", Новый ОписаниеТипов("СправочникСсылка.КлючиАналитикиПеревозки"));  
	ДанныеОбновленияКлючейАналитики.Колонки.Добавить("Контейнер", Новый ОписаниеТипов("СправочникСсылка.ТЕ"));
	ДанныеОбновленияКлючейАналитики.Колонки.Добавить("ДанныеКлюча"); 
	
	//Евросиб(ДИТ) Сержантова А.С. US 77172 ТА 83838 Начало 06.02.2025  
	МассивКлючей = Объект.Контейнеры.Выгрузить().ВыгрузитьКолонку("КлючАналитикиПеревозки");
	ДанныеКлючейПоПервойМиле = Справочники.КлючиАналитикиПеревозки.КлючиАналитикиЗначенияПолейПоЭтапуПеревозки(МассивКлючей, Перечисления.ЭтапыПеревозки.ПерваяМиля);
	//Евросиб(ДИТ) Сержантова А.С. US 77172 ТА 83838 Конец 06.02.2025
	
	Для каждого СтрокаТЧ Из Объект.Контейнеры Цикл
		СтруктураКлючаАналитикиПеревозки = Справочники.КлючиАналитикиПеревозки.СтруктураКлючаАналитикиПеревозки(); 
		
		МилиКлючаПервая = Новый Структура;
		МилиКлючаПервая.Вставить("ДатаВыдачиКТКСТерминала", СтрокаТЧ.ДатаВывоза);
		//МилиКлючаПервая.ДатаСдачиКТКНаТерминал = ;
		МилиКлючаПервая.Вставить("ФИОВодителя", СтрокаТЧ.ВывозКонтейнераФИОВодителя);
		МилиКлючаПервая.Вставить("РегНомерТС", СтрокаТЧ.ВывозКонтейнераРегНомерТС); 
		МилиКлючаПервая.Вставить("Автоперевозчик", СтрокаТЧ.Автоперевозчик);
		Если ЗначениеЗаполнено(СтрокаТЧ.Автоперевозчик) 
			и ТипЗнч(СтрокаТЧ.Автоперевозчик) = Тип("СправочникСсылка.Контрагенты") Тогда
			МилиКлючаПервая.Вставить("ИНН",ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.Автоперевозчик,"ИНН"));
			МилиКлючаПервая.Вставить("КПП",ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.Автоперевозчик,"КПП"));
		КонецЕсли;
		
		МилиКлючаПоследняя = Новый Структура;
		МилиКлючаПоследняя.Вставить("ДатаСдачиКТКНаТерминал", СтрокаТЧ.ДатаВозвратаКлиентом);
		МилиКлючаПоследняя.Вставить("ФИОВодителя", СтрокаТЧ.СдачаКонтейнераФИОВодителя);
		МилиКлючаПоследняя.Вставить("РегНомерТС", СтрокаТЧ.СдачаКонтейнераРегНомерТС);
		МилиКлючаПоследняя.Вставить("Автоперевозчик", СтрокаТЧ.АвтоперевозчикПоследняяМиля);
		Если ЗначениеЗаполнено(СтрокаТЧ.АвтоперевозчикПоследняяМиля) 
			и ТипЗнч(СтрокаТЧ.АвтоперевозчикПоследняяМиля) = Тип("СправочникСсылка.Контрагенты")Тогда
			МилиКлючаПоследняя.Вставить("ИНН",ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.АвтоперевозчикПоследняяМиля,"ИНН"));
			МилиКлючаПоследняя.Вставить("КПП",ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.АвтоперевозчикПоследняяМиля,"КПП"));	
		КонецЕсли;
		
		СтруктураКлючаАналитикиПеревозки.КлючАналитики = СтрокаТЧ.КлючАналитикиПеревозки;
		//Евросиб Коханенко Н.А. 30.07.2024 (( #88606
		//не нужно обновлять поле Заявка в ключе из Релиза. Это делает сама Заявка
		//СтруктураКлючаАналитикиПеревозки.Заявка = Объект.Заявка;
		//Евросиб Коханенко Н.А. 30.07.2024 )) #88606
		СтруктураКлючаАналитикиПеревозки.Контейнер = СтрокаТЧ.Контейнер;
		СтруктураКлючаАналитикиПеревозки.ИнструкцияПоСдаче = СтрокаТЧ.ИнструкцияПоСдаче;
		//Евросиб(ДИТ) Сержантова А.С. US 77172 ТА 83838 Начало 05.02.2025
		СтруктураКлючаАналитикиПеревозки.ДатаДобавленияВРелиз = СтрокаТЧ.ДатаДобавленияВРелиз; 
		//Евросиб(ДИТ) Антонова А.С. US 77172 ТА 110410 Начало 26.05.2025
		СтруктураКлючаАналитикиПеревозки.ИсточникЗаписи = Объект.Ссылка;
		//Евросиб(ДИТ) Антонова А.С. US 77172 ТА 110410 Конец 26.05.2025
		Если РаботаСЗаявкамиВызовСервера.Проверка_ДатаВозвратаИзПервойМили(СтрокаТЧ.Контейнер, Объект.Заявка) Тогда 
			СтрПервойМили = ДанныеКлючейПоПервойМиле.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки", СтрокаТЧ.КлючАналитикиПеревозки));  
			Если СтрПервойМили.Количество() = 1 Тогда
				СтруктураКлючаАналитикиПеревозки.ДатаСдачиКТКНаТерминал = СтрПервойМили.ДатаСдачиКТКНаТерминал;
			КонецЕсли;
		Иначе
			СтруктураКлючаАналитикиПеревозки.ДатаСдачиКТКНаТерминал = СтрокаТЧ.ДатаВозвратаКлиентом;
		КонецЕсли;
		//Евросиб(ДИТ) Сержантова А.С. US 77172 ТА 83838 Конец 05.02.2025
		ЗаполнитьЗначенияСвойств(СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиПерваяМиляКлючаАналитики, МилиКлючаПервая);
		ЗаполнитьЗначенияСвойств(СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиПоследняяМиляКлючаАналитики, МилиКлючаПоследняя);  
		
		НС = ДанныеОбновленияКлючейАналитики.Добавить(); 
		НС.НомерСтроки 				= СтрокаТЧ.НомерСтроки;
		НС.КлючАналитикиПеревозки 	= СтрокаТЧ.КлючАналитикиПеревозки;  
		НС.Контейнер 				= СтрокаТЧ.Контейнер;
		НС.ДанныеКлюча 				= СтруктураКлючаАналитикиПеревозки;
	КонецЦикла;    
	
	Возврат ДанныеОбновленияКлючейАналитики;
	
КонецФункции

// ДИТ US 76935 ТА 77189 Сержантова А.С. 05.12.2023  
&НаСервере 
Процедура ЗаблокироватьКлючиАналитикиПеревозкиДляРедактирования()

	Для каждого СтрКлюча Из Объект.Контейнеры Цикл
		ЗаблокироватьДанныеДляРедактирования(СтрКлюча.КлючАналитикиПеревозки); 	
	КонецЦикла;	

КонецПроцедуры 

// ДИТ US 76935 ТА 77189 Сержантова А.С. 05.12.2023  
&НаСервере 
Процедура СнятьБлокировкуКлючейАналитикиПеревозкиДляРедактирования()

	Для каждого СтрКлюча Из Объект.Контейнеры Цикл
		РазблокироватьДанныеДляРедактирования(СтрКлюча.КлючАналитикиПеревозки); 	
	КонецЦикла;	

КонецПроцедуры

&НаСервере
Процедура ВыполнитьЗаполнениеСтроки(СтрокаТЧ) //ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23
		
		СтрокаТЧ.Контейнер = СтрокаТЧ.КлючАналитикиПеревозки.Контейнер;
		СтрокаТЧ.ТипоразмерКТК = СтрокаТЧ.КлючАналитикиПеревозки.Контейнер.ТипТЕ; 
		СтрокаТЧ.ИнструкцияПоСдаче = СтрокаТЧ.КлючАналитикиПеревозки.ИнструкцияПоСдаче;  
		//Евросиб(ДИТ) Сержантова А.С. US 77172 ТА 83838 Начало 05.02.2025
		СтрокаТЧ.ДатаДобавленияВРелиз = СтрокаТЧ.КлючАналитикиПеревозки.ДатаДобавленияВРелиз;   
		СтрокаТЧ.ДатаВозвратаКлиентом = СтрокаТЧ.КлючАналитикиПеревозки.ДатаСдачиКТКНаТерминал;
		//Евросиб(ДИТ) Сержантова А.С. US 77172 ТА 83838 Конец 05.02.2025
		СтрокаТЧ.ВерсияКлюча = СтрокаТЧ.КлючАналитикиПеревозки.ВерсияДанных; 
		ТЧ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.КлючАналитикиПеревозки,"Мили");
		Если ТЧ <> Неопределено Тогда
			Выборка = ТЧ.Выбрать();
			Пока Выборка.Следующий() Цикл
				Если Выборка.ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПерваяМиля Тогда  
					
					// Евросиб(ДИТ) BUG 95213 ТА 95214 Сержантова А.С. Начало: 12.12.2024
					// Было:
					////БИТ Белинский Д.А. -начало
					//Если РаботаСЗаявкамиВызовСервера.ЭтоЗаявкаНаАвтоРейс(Объект.Заявка) Тогда
					//	СтрокаТЧ.ДатаВозвратаКлиентом = Выборка.ДатаСдачиКТКНаТерминал;
					//Иначе
					//	СтрокаТЧ.ДатаВывоза = Выборка.ДатаВыдачиКТКСТерминала;
					//КонецЕсли; 
					//Стало:
					СтрокаТЧ.ДатаВывоза = Выборка.ДатаВыдачиКТКСТерминала;  
					//Евросиб(ДИТ) Сержантова А.С. US 77172 ТА 83838 Начало 06.02.2025
					//перенесено вне цикла обхода миль, берем значение из реквизита шапки. Если не заполнилось из шапки, оставляем заполнение из миль
					Если не ЗначениеЗаполнено(СтрокаТЧ.ДатаВозвратаКлиентом) 
					    и РаботаСЗаявкамиВызовСервера.Проверка_ДатаВозвратаИзПервойМили(СтрокаТЧ.Контейнер, Объект.Заявка) Тогда
						СтрокаТЧ.ДатаВозвратаКлиентом = Выборка.ДатаСдачиКТКНаТерминал;
					КонецЕсли;
					//// Евросиб(ДИТ) BUG 95213 ТА 95214 Сержантова А.С. Конец: 12.12.2024 
					//Евросиб(ДИТ) Сержантова А.С. US 77172 ТА 83838 Конец 06.02.2025
					СтрокаТЧ.ВывозКонтейнераФИОВодителя = Выборка.ФИОВодителя;
					СтрокаТЧ.ВывозКонтейнераРегНомерТС = Выборка.РегНомерТС;
					СтрокаТЧ.Автоперевозчик = Выборка.Автоперевозчик;
				//Евросиб Коханенко Н.А. 24.01.2025 (( #91409 
				//Иначе
				ИначеЕсли Выборка.ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПоследняяМиля Тогда  
                //Евросиб Коханенко Н.А. 24.01.2025 )) #91409 
				
					//Евросиб(ДИТ) Сержантова А.С. US 77172 ТА 83838 Начало 06.02.2025
					//перенесено вне цикла обхода миль, берем значение из реквизита шапки
					// Евросиб(ДИТ) BUG 95213 ТА 95214 Сержантова А.С. Начало: 12.12.2024
					// Было:
					//СтрокаТЧ.ДатаВозвратаКлиентом = Выборка.ДатаСдачиКТКНаТерминал; 
					//Стало:
					Если не ЗначениеЗаполнено(СтрокаТЧ.ДатаВозвратаКлиентом) Тогда
						Если РаботаСЗаявкамиВызовСервера.Проверка_ДатаВозвратаИзПервойМили(СтрокаТЧ.Контейнер, Объект.Заявка) Тогда
						Иначе
							СтрокаТЧ.ДатаВозвратаКлиентом = Выборка.ДатаСдачиКТКНаТерминал;	
						КонецЕсли;
					КонецЕсли;
					// Евросиб(ДИТ) BUG 95213 ТА 95214 Сержантова А.С. Конец: 12.12.2024  
					//Евросиб(ДИТ) Сержантова А.С. US 77172 ТА 83838 Конец 06.02.2025
					СтрокаТЧ.СдачаКонтейнераФИОВодителя = Выборка.ФИОВодителя;
					СтрокаТЧ.СдачаКонтейнераРегНомерТС = Выборка.РегНомерТС;
					СтрокаТЧ.АвтоперевозчикПоследняяМиля = Выборка.Автоперевозчик;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьТаблицуПоКлючамАналитики(Ключ = Неопределено) //ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23
	Если ЗначениеЗаполнено(Ключ) Тогда
		СтруктураПоиска = Новый Структура("КлючАналитикиПеревозки",Ключ);
		МассивСтрок = Объект.Контейнеры.НайтиСтроки(СтруктураПоиска);
		Если МассивСтрок.Количество() > 0 Тогда
			ВыполнитьЗаполнениеСтроки(МассивСтрок[0]);
		КонецЕсли;	
	Иначе	
	Для Каждого СтрокаТЧ Из Объект.Контейнеры Цикл
		ВыполнитьЗаполнениеСтроки(СтрокаТЧ);		
	КонецЦикла;
	КонецЕсли;		
КонецПроцедуры	

&НаСервере
Процедура ДобавитьЗначениеРеквизитаВКлюч(Ключ,ЗначениеПоля,ИмяПоля,ЭтапПеревозки = Неопределено,СтруктураПолейТЧМили = Неопределено,ВерсияДанных = Неопределено) //ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23
	
	Если ВерсияДанных <> Ключ.ВерсияДанных Тогда 
		ЗаполнитьТаблицуПоКлючамАналитики(Ключ);
		ОбщегоНазначения.СообщитьПользователю("Версия ключа аналитики перевозки устарела, подгружены актуальные данные по строке.");	
	КонецЕсли;
	
	СтруктураКлюча  = Справочники.КлючиАналитикиПеревозки.СтруктураКлючаАналитикиПеревозки();	
	СтруктураКлюча.Вставить("КлючАналитики",Ключ);
	
	Если ЭтапПеревозки = Неопределено Тогда
		СтруктураКлюча.Вставить(ИмяПоля,ЗначениеПоля);
		ВерсияДанных = Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлюча).ВерсияДанных;
	КонецЕсли;
	
	Если ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПерваяМиля Тогда
		ЗаполнитьЗначенияСвойств(СтруктураКлюча.СтруктураТЧМилиПерваяМиляКлючаАналитики,СтруктураПолейТЧМили);
		ВерсияДанных = Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлюча).ВерсияДанных;
	КонецЕсли;
	
	Если ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПоследняяМиля Тогда
		ЗаполнитьЗначенияСвойств(СтруктураКлюча.СтруктураТЧМилиПоследняяМиляКлючаАналитики,СтруктураПолейТЧМили); 
		ВерсияДанных = Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлюча).ВерсияДанных;
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Функция ОбновитьДанныеКлючаАналитикиПеревозки(ТекСтр)
	Структура = Новый Структура("КлючАналитикиПеревозки,ВерсияКлюча");	
	НайденоУслуги = Объект.СоставУслуги.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки",ТекСтр.КлючАналитикиПеревозки));
	
	Если НайденоУслуги.Количество() Тогда  
		Стр = НайденоУслуги[0]; 
		Стр.Груз = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекСтр.КлючАналитикиПеревозки,"Груз");
		Стр.ВерсияКлюча = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекСтр.КлючАналитикиПеревозки,"ВерсияДанных");
		Стр.ИнструкцииПоСдачеПорожнего = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекСтр.КлючАналитикиПеревозки,"ИнструкцияПоСдаче");
		Структура = Новый Структура("КлючАналитикиПеревозки,ВерсияДанных",Стр.КлючАналитикиПеревозки,Стр.ВерсияКлюча);
	КонецЕсли;
	мДетализацияПоГрузу = РеквизитФормыВЗначение("ДетализацияПоГрузу",Тип("ТаблицаЗначений"));
	НайденоГруз = мДетализацияПоГрузу.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки",ТекСтр.КлючАналитикиПеревозки));
	Для Каждого СтрНайденоГруз Из НайденоГруз Цикл 
		мДетализацияПоГрузу.Удалить(СтрНайденоГруз);	
	КонецЦикла;
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(Справочники.КлючиАналитикиПеревозки.ПолучитьДетализациюПоГрузу(ТекСтр.КлючАналитикиПеревозки),мДетализацияПоГрузу);
	ЗначениеВРеквизитФормы(мДетализацияПоГрузу,"ДетализацияПоГрузу");
	
	Возврат Структура;
КонецФункции

&НаСервереБезКонтекста
Функция СоздатьКлючАналитики(Заявка,Контейнер) //ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23
	
	СтруктураКлюча  = Справочники.КлючиАналитикиПеревозки.СтруктураКлючаАналитикиПеревозки(); 
	СтруктураКлюча.Вставить("Заявка",Заявка);
	СтруктураКлюча.Вставить("Контейнер",Контейнер);
	Возврат Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлюча);
		
КонецФункции
	
&НаКлиенте
Процедура ВопросОбОтменеПроведения(Результат, ДополнительныеПараметры) Экспорт //ДИТ Шевченко А.В. 51340 14.10.2022
	Если Результат = КодВозвратаДиалога.Да Тогда

		ПараметрыТерминала = Новый Структура("ЭлектронныйАдресТерминала,XmlВерсияРелизаКлиента,ЗапросНаОтмену,ТекстПисьма,УдалениеРелиза,ВариантыАвтоперевозкиНеТребуется","","",Истина,"",Истина,Ложь);
		Если ПоВыбранномуТерминалуТребуетсяОтправкаXML(ПараметрыТерминала) Тогда
			ПоказатьДиалогОтправкиПоПочте(ПараметрыТерминала);
		Иначе
			ПараметрыТерминала.ТекстПисьма = "Запрос на выдачу контейнеров отменен. Просьба удалить резервирование контейнеров для выдачи по данному релизу";
			МассивПолучателей = СтрРазделить(Объект.КонтактТерминала, ";", Ложь);
			СписокПолучателей = Новый СписокЗначений;
			Для Каждого ЗнчПолучатель Из МассивПолучателей Цикл
				СписокПолучателей.Добавить(ЗнчПолучатель,ЗнчПолучатель);
			КонецЦикла;	
			ПараметрыТерминала.ЭлектронныйАдресТерминала = СписокПолучателей;
			ПоказатьДиалогОтправкиПоПочте(ПараметрыТерминала);
		КонецЕсли;
		
		
		ПараметрыЗаписи = ДополнительныеПараметры.ПараметрыЗаписи;
		ПараметрыЗаписи.Вставить("ПропуститьПроверку", Истина);
		ЭтотОбъект.Прочитать();
		Записать(ПараметрыЗаписи);
	Иначе
		Возврат;
	КонецЕсли;
КонецПроцедуры

