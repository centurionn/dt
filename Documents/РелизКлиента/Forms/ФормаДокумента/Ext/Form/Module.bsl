			КонецЕсли;	
			//Евросиб Коханенко Н.А. 20.08.2024 )) #88606
			МассивКлючейИтог.Добавить(СоставУслугИзЗаявки.КлючАналитикиПеревозки);	
		КонецЦикла;   
		МассивКлючейИтог = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивКлючейИтог);
		// ДИТ US 79950 ТА 79951 Сержантова А.С. Конец: 16.02.2024

		Для Каждого КлючМ Из МассивКлючейИтог Цикл
			Если НЕ Объект.Контейнеры.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки",КлючМ)).Количество() Тогда
				Если Объект.Контейнеры.Количество() < Объект.ОбщееКоличествоКТКВРелизе Тогда
					НовСтрока = Объект.Контейнеры.Добавить();
					НовСтрока.КлючАналитикиПеревозки = КлючМ;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;   
		
		//Евросиб Коханенко Н.А. 20.08.2024 (( #88606
		//если количество ктк в запросе ив ТЧ совпадает, то ничего не удаляем
		Если Объект.Контейнеры.Количество() <> Объект.ОбщееКоличествоКТКВРелизе Тогда  
