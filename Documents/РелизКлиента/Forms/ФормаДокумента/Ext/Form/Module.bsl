#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	//Субботин 77659 15.12.2023 Начало // перенес в при создании на сервере из при чтении
	ЗаполнитьТаблицуПоКлючамАналитики();	
	//Субботин 77659 15.12.2023 Конец
	УстановитьУсловноеОформление();	
	
	Если Не ПустаяСтрока(Объект.КонтактТерминала) Тогда
		Адреса = СтрРазделить(Объект.КонтактТерминала, ";", Ложь);
		КонтактыТерминалаВыдачи.ЗагрузитьЗначения(Адреса);
	КонецЕсли;
	
	СозданиеРелизаИзЗаявки = Параметры.СозданиеРелизаИзЗаявки;
	СозданиеРелизаИзАРМ = Параметры.СозданиеРелизаИзАРМ;
	// ДИТ US 58592 TA 60724 Евсенкин М.А. Начало: 13.12.2022
	Если СозданиеРелизаИзАРМ Или СозданиеРелизаИзЗаявки Тогда 
		Объект.ДатаОтправленияПоЖДПлан 	= Параметры.ЗначенияЗаполнения.ДатаОтправленияПоЖДПлан;
		Объект.СтанцияНазначенияПоЖД 	= Параметры.ЗначенияЗаполнения.СтанцияНазначенияПоЖД;
	КонецЕсли;	
	// ДИТ US 58592 TA 60724 Евсенкин М.А. Конец: 13.12.2022
	Если Параметры.Ключ.Пустая() Тогда
		// Если открывается новая формы, то пытаемся прочитать идентификатор из параметров,
		// т.к. форма может создаваться из заявки, откуда передается этот параметр.
		ИдентификаторСтрокиЗаявки = Параметры.ИдентификаторСтрокиЗаявки; // используется для обновления данных из запроса на КТК (заявки) - это идентификатор строки запроса на КТК заявки
	Иначе
		// Если открывается форма существующего документа, то ищем идентификатор в регистре
		ОпределитьИдентификаторРелиза();
	КонецЕсли;
	
	// Евросиб Фролов (28.03.2022 Task №49126
	МассивПодстоковВыдачи = Объект.ПодстокиВыдачи.Выгрузить().ВыгрузитьКолонку("НаименованиеПодстока");
	ПодстокиВыдачи.ЗагрузитьЗначения(МассивПодстоковВыдачи);  
	
	МассивПодстоковСдачи = Объект.ПодстокиСдачи.Выгрузить().ВыгрузитьКолонку("НаименованиеПодстока");
	ПодстокиСдачи.ЗагрузитьЗначения(МассивПодстоковСдачи);
	// Евросиб Фролов)
	
	// Евросиб Фролов (28.04.2022 Task №50233
	УправлениеФормой();
	// Евросиб Фролов)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	//ДИТ Шевченко А.В. 51340 14.10.2022 -начало
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.СтатусОтправкиПолученияОтветаТерминала = Справочники.СибурСтатусыЗаявок.НеОтправлен;
	КонецЕсли;                                  
	//ДИТ Шевченко А.В. 51340 14.10.2022 -конец

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
	
КонецПроцедуры

//Евросиб Коханенко Н.А. #61705 09.12.2022 (
&НаКлиенте
Процедура ОткрытьОкноСИнструкциями(Форма, Команда)
	ИнструкцииКлиент.ОткрытьОкноСИнструкциями(ЭтаФорма, Команда);
КонецПроцедуры  
//Евросиб Коханенко Н.А. #61705 09.12.2022 )

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОпределитьСтатусРелиза();
	
	НастроитьТекстКнопкиПечати();
	НастроитьЗависимыеОтАвтоперевозкиЭлементы();	
	НастроитьДоступностьЭлементовШапки();
	НастроитьВидимостьПодстокаВыдачи();
	НастроитьВидимостьПодстокаСдачи();
	
	Для Каждого ТекущаяСтрока Из Объект.Контейнеры Цикл
		
		// Если текст инструкции в АРМ и в документе отличается, то уведомим об этом пользователя
		Если ЗначениеЗаполнено(ТекущаяСтрока.ИнструкцияПоСдачеИзАРМ)
			//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 -начало
			И СокрЛП(ТекущаяСтрока.ИнструкцияПоСдачеИзАРМ) <> СокрЛП(ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(ТекущаяСтрока.КлючАналитикиПеревозки,"ИнструкцияПоСдаче")) Тогда
			//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 -конец
				ТекстСообщения = СтрШаблон("Инструкции по сдаче в строке %1 отличаются от указанных в АРМ КТК", ТекущаяСтрока.НомерСтроки);
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		
	КонецЦикла;	
	
	НастроитьВидимостьКолонкиИнструкцииАРМ(); 
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	СброситьТипы(); //ДИТ Шевченко А.В. 63318 07.03.2023  
	
	//ДИТ, Беляев СЮ, US 83045 / TA 85275, 16-05-2024, начало
	МассивТиповЛокаций = Новый Массив;
	МассивТиповЛокаций.Добавить(ПредопределенноеЗначение("Справочник.ТипыЛокаций.НаселенныйПункт"));
	МассивТиповЛокаций.Добавить(ПредопределенноеЗначение("Справочник.ТипыЛокаций.Регион"));
	МассивТиповЛокаций.Добавить(ПредопределенноеЗначение("Справочник.ТипыЛокаций.Страна"));
	
	МассивПараметровВыбора = Новый Массив;
	МассивПараметровВыбора.Добавить(Новый ПараметрВыбора("Отбор.Тип", Новый ФиксированныйМассив(МассивТиповЛокаций)));

	Элементы.ЛокацияСдачи.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);
	//ДИТ, Беляев СЮ, US 83045 / TA 85275, 16-05-2024, конец
	
КонецПроцедуры     

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если СозданиеРелизаИзЗаявки
		ИЛИ СозданиеРелизаИзАРМ Тогда
		ПараметрыОповещения = Новый Структура;
		ПараметрыОповещения.Вставить("Релиз", 						Объект.Ссылка);
		ПараметрыОповещения.Вставить("ИдентификаторСтрокиЗаявки", 	ИдентификаторСтрокиЗаявки);
		//ДИТ Шевченко А.В. BUG 75898 TA 75908 10.10.2023
		ПараметрыОповещения.Вставить("Автоперевозка", 	Объект.Автоперевозка);
		ПараметрыОповещения.Вставить("АвтоперевозкаПоследняяМиля", 	Объект.АвтоперевозкаПоследняяМиля);
		//ДИТ Шевченко А.В. BUG 75898 TA 75908 10.10.2023        
		// ДИТ BUG 76435  Сержантова А.С. Начало: 23.11.2023
		ПараметрыОповещения.Вставить("НормативноеИспользование", 	Объект.СрокИспользованияКТК);
		// ДИТ BUG 76435  Сержантова А.С. Конец: 23.11.2023
		
		// ДИТ US 79950 ТА 79951 Сержантова А.С. Начало: 12.02.2024
		ПараметрыОповещения.Вставить("ТипКТК", 	Объект.ТипоразмерКТК);
		ПараметрыОповещения.Вставить("РазмерКТК", ОбщегоНазначенияВызовСервера.ЗначениеРеквизитаОбъекта(Объект.ТипоразмерКТК, "РазмерКТК"));
		// ДИТ US 79950 ТА 79951 Сержантова А.С. Конец: 12.02.2024                               
		
		//ДИТ Шевченко А.В. US 62482 ТА 68277 17.04.2023 -Начало
		МассивСтруктур = Новый Массив;
		Для Каждого СтрокаК Из Объект.Контейнеры Цикл
			СтруктураОтвет = Новый Структура("Ключ,ИдентификаторСтроки",СтрокаК.КлючАналитикиПеревозки,СтрокаК.ИдентификаторСтроки);
			МассивСтруктур.Добавить(СтруктураОтвет);
		КонецЦикла;	
		ПараметрыОповещения.Вставить("МассивКлючей",МассивСтруктур);
		//ДИТ Шевченко А.В. US 62482 ТА 68277 17.04.2023 -Конец
		
		Оповестить("СозданиеРелизаКлиентаИзЗаявки", ПараметрыОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
    Если ИсточникВыбора.ИмяФормы = "Справочник.ТЕ.Форма.ФормаВыбора" Тогда
		
		Если ВыбранноеЗначение <> Неопределено Тогда
			НоваяСтрока = Объект.Контейнеры.Добавить();
			//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 –начало
			//НоваяСтрока.Контейнер = ВыбранноеЗначение;
			Если НЕ ЗначениеЗаполнено(НоваяСтрока.КлючАналитикиПеревозки) Тогда
				Ответ = СоздатьКлючАналитики(Объект.Заявка,ВыбранноеЗначение);
				НоваяСтрока.КлючАналитикиПеревозки  = Ответ.КлючАналитикиПеревозки;
				НоваяСтрока.ВерсияКлюча 			= Ответ.ВерсияДанных;
				ЭтаФорма.Модифицированность = Истина;
			КонецЕсли;
			НоваяСтрока.Контейнер = ВыбранноеЗначение;
			//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 –конец
			НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
			ЗаполнитьИнструкциюПоСдачеТекущегоКонтейнера(НоваяСтрока);
		КонецЕсли;
		
		Модифицированность = Истина;
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Документ.РелизКлиента.Форма.СвязкаТабличныхЧастей" Тогда
		
		Если ВыбранноеЗначение <> Неопределено Тогда
			ЗаполнитьКонтейнерыПослеСвязки(ВыбранноеЗначение);
		КонецЕсли;
		
		Модифицированность = Истина;
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Документ.РелизКлиента.Форма.ФормаПодбораКонтейнеровВТС" Тогда
		
		Если ВыбранноеЗначение <> Неопределено Тогда
			ЗаполнитьКонтейнерыВодителейПослеСвязки(ВыбранноеЗначение);
		КонецЕсли;
		
		Модифицированность = Истина;
					
	КонецЕсли;
	
	ОтключитьОтметкуНезаполненного();
	
	Если Окно <> Неопределено Тогда
		Окно.Активизировать();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_ЭлектронноеПисьмоИсходящее" Тогда
		// Из формы отправки электронного письма отправлено оповещение о записи
		ЭтаФорма.Прочитать();  
	// ДИТ US 76935 ТА 77189 Сержантова А.С. Начало: 25.12.2023
	ИначеЕсли ИмяСобытия = "НеобходимоОбновитьДанныеКлючейАналитикиПеревозки" Тогда	
		Если Источник <> Неопределено и Источник.УникальныйИдентификатор <> ЭтаФорма.УникальныйИдентификатор Тогда
			ПроверитьАктуальностьКлючаАналитики();
		КонецЕсли;
	// ДИТ US 76935 ТА 77189 Сержантова А.С. Конец: 25.12.2023
	КонецЕсли;  
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)	
	// Заполняем в табличной части только текст иннструкции из АРМ Управление КТК
	ЗаполнитьДобавленныеКолонки("ИнструкцияПоСдачеИзАРМ, ВидСобственности, СобственникКТК");

	// Евросиб Фролов (28.02.2022 Task №46354
	ПодсвечиваниеПолейОбъектов.НастроитьПодсвечиваниеПолей(ТекущийОбъект, ИмяФормы, ЭтаФорма, УсловноеОформление);	
	// Евросиб Фролов)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 -начало
	ЗаполнитьТаблицуПоКлючамАналитики();
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 -конец
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	//ДИТ Шевченко А.В. 51340 12.10.2022 - Начало
	Если ПараметрыЗаписи.Свойство("ПропуститьПроверку") 
		И ПараметрыЗаписи.ПропуститьПроверку Тогда
		Возврат;
	КонецЕсли;
	
	//ДИТ Шевченко А.В. US 62421 TA 64347 16.03.2023 -начало
	Если ИзмененияВодителя И НЕ ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		МассивНомеровСтрок = Новый Массив;
		Для Каждого СтрокаТЧ из Объект.Контейнеры Цикл
			Если СтрокаТЧ.ВерсияКлюча <> ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(СтрокаТЧ.КлючАналитикиПеревозки,"ВерсияДанных") Тогда 
				ЗаполнитьТаблицуПоКлючамАналитики(СтрокаТЧ.КлючАналитикиПеревозки);
				МассивНомеровСтрок.Добавить(СтрокаТЧ.НомерСтроки);	
			КонецЕсли;
		КонецЦикла;
		ИзмененияВодителя = Ложь;
		Если МассивНомеровСтрок.Количество() Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Версия ключа аналитики перевозки в строках № %1 устарела, подгружены актуальные данные по строке.",СтрСоединить(МассивНомеровСтрок,",")),,,,Отказ);
		КонецЕсли;	
	КонецЕсли;	
	//ДИТ Шевченко А.В. US 62421 TA 64347 16.03.2023 -конец
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения ИЛИ (Объект.Проведен И Объект.ПометкаУдаления) Тогда
		Если Объект.СтатусОтправкиПолученияОтветаТерминала <> ПредопределенноеЗначение("Справочник.СибурСтатусыЗаявок.НеОтправлен") Тогда
			Отказ = ПроверитьДатуВывоза();
			Если Отказ Тогда
				ТекстОшибки = СтрШаблон("По документу Релиз клиента %1 осуществлена выдача КТК. Отмена проведения или удаление документа невозможно",Объект.НомерРелиза);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				ТекстОшибки,
				// ++ ДИТ_Агафонов_task 51340 24.10.2022
				//ЭтотОбъект,
				Объект.Ссылка,
				// -- ДИТ_Агафонов_task 51340 24.10.2022
				,
				,
				Отказ);
			Иначе
				Отказ = Истина;
				ТекстВопроса = НСтр("ru = 'На терминал будет отправлен запрос об отмене выдачи по РК?'");	
				СписокКнопок = Новый СписокЗначений;
				СписокКнопок.Добавить(КодВозвратаДиалога.Да, "Да, отправить и отменить проведение");
				СписокКнопок.Добавить(КодВозвратаДиалога.Нет, "Нет, оставить проведение");
				ДополнительныеПараметры = Новый Структура; 
				ДополнительныеПараметры.Вставить("ПараметрыЗаписи", ПараметрыЗаписи);
				ДополнительныеПараметры.Вставить("ЗначениеЕслиДа", Ложь);
				ДополнительныеПараметры.Вставить("ЗначениеЕслиНет", Истина);
				Оповещение = Новый ОписаниеОповещения("ВопросОбОтменеПроведения", ЭтотОбъект, ДополнительныеПараметры);
				ПоказатьВопрос(Оповещение, ТекстВопроса, СписокКнопок);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//ДИТ Шевченко А.В. 51340 12.10.2022 - Конец
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		// Если запрос терминалу был отправлен (заполнена дата отправки) и изменены поля, которые
		// указываются в запросе, то выдвдим предупреждение.
		Если Объект.ИзмененыКлючевыеПоля И ЗначениеЗаполнено(Объект.ДатаОтправкиЗапросаТерминалу) Тогда
			ПоказатьПредупреждение(, "Данные в релизе изменены после отправки запроса на релиз терминалу. Необходимо направить терминалу скорректированный запрос на выдачу контейнеров по релизу.");
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(Объект.ТерминалВыдачи)
			//Евросиб Шевченко А.В. US 73357 TA 115689 04.08.2025
			И КонтактыТерминалаВыдачи.Количество() = 0  И НЕ Объект.ВыдачаОтСобственника Тогда  
			// ДИТ US 76995 ТА 76997 Сержантова А.С. Начало: 07.11.2023
			// Было:
			//ОбщегоНазначенияКлиент.СообщитьПользователю(
			//"Не заполнены контакты терминала выдачи",
			//,
			//"КонтактыТерминалаВыдачи",, Отказ);    
			// ДИТ US 76995 ТА 76997 Сержантова А.С. Конец: 07.11.2023
			ОбщегоНазначенияКлиент.СообщитьПользователю(
			"Не заполнены контакты терминала выдачи",
			,
			"КонтактыТерминалаВыдачи",, Отказ);
