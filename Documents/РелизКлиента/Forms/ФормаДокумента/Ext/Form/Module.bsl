&НаКлиенте
Процедура КонтейнерыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	// Евросиб Фролов (14.02.2022 Ticket№ 46606
	
	Если НоваяСтрока И ЗаполнятьПоПервойСтроке Тогда
		Если Объект.Контейнеры.Количество() > 0 Тогда
			ПерваяСтрока = Объект.Контейнеры[0];
			//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 –начало
			//Если ЗначениеЗаполнено(ПерваяСтрока.ИнструкцияПоСдаче) Тогда
			//	ТекущиеДанные = Элементы.Контейнеры.ТекущиеДанные;
			//	ТекущиеДанные.ИнструкцияПоСдаче = ПерваяСтрока.ИнструкцияПоСдаче;
			//КонецЕсли;
			ИнструкцияПоСдачеТек = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(ПерваяСтрока.КлючАналитикиПеревозки,"ИнструкцияПоСдаче");
			Если ЗначениеЗаполнено(ИнструкцияПоСдачеТек) Тогда
				ТекущиеДанные = Элементы.Контейнеры.ТекущиеДанные;  
				// ДИТ US 76935 ТА 77189 Сержантова А.С. Начало: 05.12.2023
				//ДобавитьЗначениеРеквизитаВКлюч(ТекущиеДанные.КлючАналитикиПеревозки,ИнструкцияПоСдачеТек,"ИнструкцияПоСдаче",,,ТекущиеДанные.ВерсияКлюча); 
				// ДИТ US 76935 ТА 77189 Сержантова А.С. Конец: 05.12.2023
			КонецЕсли;
			//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 –конец
		КонецЕсли;		
	КонецЕсли;
	
	// Евросиб Фролов)
