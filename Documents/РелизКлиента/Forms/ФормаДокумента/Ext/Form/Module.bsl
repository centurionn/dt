&НаКлиенте
//++ДИТ Моисеенко Ю.В. task#60109 09.11.2022
//Процедура ПослеВыбораВодителя(ВыбранныйВодитель, ТекущиеДанные) Экспорт
Процедура ПослеВыбораВодителя(ВыбранныйВодитель, ДополнительныеПараметры) Экспорт
//--ДИТ Моисеенко Ю.В. task#60109 09.11.2022

    Если ВыбранныйВодитель = Неопределено Тогда
        ПоказатьПредупреждение(, "Водитель не выбран.");
    Иначе
		//++ДИТ Моисеенко Ю.В. task#60109 09.11.2022
		//ЧастиПредставления = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ВыбранныйВодитель.Представление, ", ТС ");
	    ЧастиПредставления = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ВыбранныйВодитель.Представление, ",");
		//--ДИТ Моисеенко Ю.В. task#60109 09.11.2022
		
		//++ДИТ Моисеенко Ю.В. task#60109 09.11.2022
	    ТекущиеДанные 	= ДополнительныеПараметры.ТекущиеДанные;
		ВывозКонтейнера = ДополнительныеПараметры.ВывозКонтейнера;

		Если ВывозКонтейнера Тогда
		//--ДИТ Моисеенко Ю.В. task#60109 09.11.2022
			ТекущиеДанные.ИдентификаторСтрокиТС = ВыбранныйВодитель.Значение;
			ТекущиеДанные.ВывозКонтейнераФИОВодителя = ЧастиПредставления[0];
			//++ДИТ Моисеенко Ю.В. task#60109 09.11.2022
			//ТекущиеДанные.ВывозКонтейнераРегНомерТС = ЧастиПредставления[1];
			ТекущиеДанные.ВывозКонтейнераРегНомерТС = СтрЗаменить(ЧастиПредставления[1], " ТС ", "");
		    ТекущиеДанные.Автоперевозчик 			= СтрЗаменить(ЧастиПредставления[2], " ", "");
			//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 начало
			СтруктураТЧМили = Новый Структура;
			СтруктураТЧМили.Вставить("ФИОВодителя",ЧастиПредставления[0]);
			СтруктураТЧМили.Вставить("РегНомерТС",СтрЗаменить(ЧастиПредставления[1], " ТС ", ""));
			СтруктураТЧМили.Вставить("Автоперевозчик",СтрЗаменить(ЧастиПредставления[2], " ", ""));  
			// ДИТ US 76935 ТА 77189 Сержантова А.С. Начало: 05.12.2023
			//ДобавитьЗначениеРеквизитаВКлюч(ТекущиеДанные.КлючАналитикиПеревозки,ЧастиПредставления[0],"ФИОВодителя",ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПерваяМиля"),СтруктураТЧМили,ТекущиеДанные.ВерсияКлюча);
			// ДИТ US 76935 ТА 77189 Сержантова А.С. Конец: 05.12.2023
			//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 конец
		Иначе
			ТекущиеДанные.ИдентификаторСтрокиТСПоследняяМиля = ВыбранныйВодитель.Значение;
			ТекущиеДанные.СдачаКонтейнераФИОВодителя 	= ЧастиПредставления[0];
			ТекущиеДанные.СдачаКонтейнераРегНомерТС 	= СтрЗаменить(ЧастиПредставления[1], " ТС ", "");
		    ТекущиеДанные.АвтоперевозчикПоследняяМиля 	= СтрЗаменить(ЧастиПредставления[2], " ", "");
			//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 начало
			СтруктураТЧМили = Новый Структура;
			СтруктураТЧМили.Вставить("ФИОВодителя",ЧастиПредставления[0]);
			СтруктураТЧМили.Вставить("РегНомерТС",СтрЗаменить(ЧастиПредставления[1], " ТС ", ""));
			СтруктураТЧМили.Вставить("Автоперевозчик",СтрЗаменить(ЧастиПредставления[2], " ", ""));
			// ДИТ US 76935 ТА 77189 Сержантова А.С. Начало: 05.12.2023
