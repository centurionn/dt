&НаСервереБезКонтекста
Функция ПолучитьТерминалыСтоковСдачи(Мультилокация)
	// Евросиб Фролов (28.03.2022 Task №49126
	//ДИТ Шевченко А.В. 63318 19.01.2023 - начало
	Если ТипЗнч(Мультилокация) = Тип("СправочникСсылка.Мультилокации") Тогда
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	МультилокацииЛокации.Локация.Родитель КАК Терминал
		|ИЗ
		|	Справочник.Мультилокации.Локации КАК МультилокацииЛокации
		|ГДЕ
		|	МультилокацииЛокации.Ссылка = &Мультилокация
		|	И МультилокацииЛокации.Локация.Родитель.Тип = &ТипТерминал";
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("Мультилокация", Мультилокация);
		Запрос.УстановитьПараметр("ТипТерминал", Справочники.ТипыЛокаций.Терминал);
		
		Результат = Запрос.Выполнить();
		
		МассивТерминалов = Результат.Выгрузить().ВыгрузитьКолонку("Терминал");
		
		СписокТерминалов = Новый СписокЗначений;
		СписокТерминалов.ЗагрузитьЗначения(МассивТерминалов);
		Возврат СписокТерминалов;
	ИначеЕсли ТипЗнч(Мультилокация) = Тип("СправочникСсылка.Локации") Тогда
		Если Мультилокация.Родитель.Тип = Справочники.ТипыЛокаций.Терминал Тогда
			СписокТерминалов = Новый СписокЗначений;
			СписокТерминалов.Добавить(Мультилокация.Родитель);
			Возврат СписокТерминалов;
		КонецЕсли;	
	КонецЕсли;
	Возврат СписокТерминалов;
	// Евросиб Фролов)
КонецФункции

&НаКлиенте
Функция ИзменениеВидаРелизаВозможно()
	// Евросиб Фролов (28.03.2022 Task №49126
	// Запретить смену состояния галок "Выдача от собственника" и "Номерная выдача" при наличии в табличной части
	// релиза клиента хотя бы одной строки с заполненным значением в поле "Дата вывоза".
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 –начало
	МассивКлючей = Новый Массив;
	Для Каждого СтрокаТЧ Из Объект.Контейнеры Цикл
		Если ЗначениеЗаполнено(СтрокаТЧ.КлючАналитикиПеревозки) Тогда
			МассивКлючей.Добавить(СтрокаТЧ.КлючАналитикиПеревозки);
		КонецЕсли;
	КонецЦикла;	
	
	КоличествоСтрокБезДат = ПолучитьКоличествоСтрокСЗаполненойДатойВывоза(МассивКлючей);
	//ПараметрыПоиска = Новый Структура;
	//ПараметрыПоиска.Вставить("ДатаВывоза", Дата(1, 1, 1));
	//СтрокиБезДаты = Объект.Контейнеры.НайтиСтроки(ПараметрыПоиска);
	//Если СтрокиБезДаты.Количество() <> Объект.Контейнеры.Количество() Тогда
	Если КоличествоСтрокБезДат <> Объект.Контейнеры.Количество() Тогда
		ПоказатьПредупреждение(, "В списке контейнеров есть строки с заполненной датой вывоза. Изменение галок ""Выдача от собственника"" и ""Номерная выдача"" запрещено.");
		Возврат Ложь;
	КонецЕсли;
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 –конец
	Возврат Истина;
	// Евросиб Фролов)
КонецФункции	

