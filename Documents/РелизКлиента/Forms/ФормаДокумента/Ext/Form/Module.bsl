	//               |ВЫБРАТЬ
	//               |	ТаблицаКТК.НомерСтроки КАК НомерСтроки,
	//               |	ТаблицаКТК.Контейнер КАК Контейнер
	//               |ИЗ
	//               |	ТаблицаКТК КАК ТаблицаКТК
	//			   |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	//               |		ПО ТаблицаКТК.Контейнер = РелизСобственникаНоминации.Контейнер
	//			   |			И РелизСобственникаНоминации.Ссылка = &РелизСобственника
	//			   |			И РелизСобственникаНоминации.Контейнер <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
	//               |
	//               |УПОРЯДОЧИТЬ ПО
	//               |	НомерСтроки УБЫВ";
	//ДИТ, Беляев СЮ, Ticket#0330059, 30-10-2023, начало
	Запрос.Текст = "ВЫБРАТЬ
	               |	РелизКлиентаКонтейнеры.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
	               |	РелизКлиентаКонтейнеры.НомерСтроки КАК НомерСтроки
	               |ПОМЕСТИТЬ ТаблицаКТК
	               |ИЗ
	               |	&РелизКлиентаКонтейнеры КАК РелизКлиентаКонтейнеры
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаКТК.НомерСтроки КАК НомерСтроки,
	               |	КлючиАналитикиПеревозки.Контейнер КАК Контейнер
	               |ИЗ
	               |	ТаблицаКТК КАК ТаблицаКТК
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки КАК КлючиАналитикиПеревозки
	               |		ПО (КлючиАналитикиПеревозки.Ссылка = ТаблицаКТК.КлючАналитикиПеревозки)
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	               |		ПО (КлючиАналитикиПеревозки.Контейнер = РелизСобственникаНоминации.Контейнер)
	               |			И (РелизСобственникаНоминации.Ссылка = &РелизСобственника)
	               |			И (РелизСобственникаНоминации.Контейнер <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка))
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки УБЫВ";
	//ДИТ, Беляев СЮ, Ticket#0330059, 30-10-2023, конец
	
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 -начало
	//Запрос.УстановитьПараметр("РелизКлиентаКонтейнеры", Объект.Контейнеры.Выгрузить(,"Контейнер,НомерСтроки"));
	Запрос.УстановитьПараметр("РелизКлиентаКонтейнеры", Объект.Контейнеры.Выгрузить(,"КлючАналитикиПеревозки,НомерСтроки"));
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 -конец
	Запрос.УстановитьПараметр("РелизСобственника", Объект.РелизСобственника);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Объект.Контейнеры.Удалить(Выборка.НомерСтроки-1);	
	КонецЦикла;

