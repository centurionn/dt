&НаКлиенте
Процедура ЗагрузитьИзExcel(Команда)
	
	// Евросиб Фролов (30.05.2022 Task №49741
	// Закомментировал: разрешить загрузку из Excel если выдача от собственника.
	//Если Объект.ВыдачаОтСобственника Тогда
	//	ПоказатьПредупреждение(, "Запрещено добавлять строки при выдаче от собственника");
	//	Возврат;
	//КонецЕсли;
	// Евросиб Фролов)
	//ДИТ Шевченко А.В. BUG 75898 TA 75908 10.10.2023
	//ДоступноеКоличество = Объект.ОбщееКоличествоКТКВРелизе - Объект.Контейнеры.Количество();

	//Если ДоступноеКоличество <= 0 Тогда
	//	ПоказатьПредупреждение(, "В документе уже заполнено максимально возмозможное количество КТК.");
	//	Возврат;
	//КонецЕсли;
		
	МассивКлючей = Новый Массив;
	Для Каждого СтрокаТЧ Из Объект.Контейнеры Цикл
		МассивКлючей.Добавить(СтрокаТЧ.КлючАналитикиПеревозки);
	КонецЦикла;
	КлючиСПустымКонтейнером = ПолучитьМассивКлючейСПустымКонтейнером(МассивКлючей);
	
	ПараметрыЧтения = Новый Структура;
	//ПараметрыЧтения.Вставить("КоличествоСтрок", ДоступноеКоличество);
	ПараметрыЧтения.Вставить("КоличествоСтрок", КлючиСПустымКонтейнером.Количество());
	//ДИТ Шевченко А.В. BUG 75898 TA 75908 10.10.2023
	ПараметрыЧтения.Вставить("ТипоразмерКТК", 	Объект.ТипоразмерКТК);
	ПараметрыЧтения.Вставить("СтокВыдачи", 		Объект.СтокВыдачи);
	
	ОповещениеДляЗагрузкиКТК = Новый ОписаниеОповещения("РезультатЧтенияКТКИзТабДокумента", ЭтаФорма);
	ОткрытьФорму("Документ.РелизКлиента.Форма.ДобавлениеКонтейнеров", ПараметрыЧтения, ЭтаФорма, ЭтаФорма.УникальныйИдентификатор,,,ОповещениеДляЗагрузкиКТК, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

