&НаСервере
Функция ПроверитьВыставленныеПоЗаявкеСчета(СсылкаЗаявки)

	МассивСчетов = Новый Массив;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеНаФорме.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	ДанныеНаФорме.Контейнер КАК Контейнер
		|ПОМЕСТИТЬ ВТ_ДанныеСФормы
		|ИЗ
		|	&ДанныеНаФорме КАК ДанныеНаФорме
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КлючиАналитикиПеревозки.Ссылка КАК Ссылка,
		|	КлючиАналитикиПеревозки.Контейнер КАК Контейнер
		|ИЗ
		|	ВТ_ДанныеСФормы КАК ВТ_ДанныеСФормы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки КАК КлючиАналитикиПеревозки
		|		ПО ВТ_ДанныеСФормы.КлючАналитикиПеревозки = КлючиАналитикиПеревозки.Ссылка
		|ГДЕ
		|	КлючиАналитикиПеревозки.Контейнер <> ВТ_ДанныеСФормы.Контейнер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СчетНаОплатуПокупателюДокументыОснования.Ссылка КАК Ссылка,
		|	СчетНаОплатуПокупателюДокументыОснования.Ссылка.Представление КАК ПредставлениеСчета
		|ИЗ
		|	Документ.СчетНаОплатуПокупателю.ДокументыОснования КАК СчетНаОплатуПокупателюДокументыОснования
		|ГДЕ
		|	СчетНаОплатуПокупателюДокументыОснования.Документ = &Документ
		|	И НЕ СчетНаОплатуПокупателюДокументыОснования.Ссылка.ПометкаУдаления
		|	И СчетНаОплатуПокупателюДокументыОснования.Ссылка.Проведен";
	
	Запрос.УстановитьПараметр("Документ", СсылкаЗаявки);
	запрос.УстановитьПараметр("ДанныеНаФорме", Объект.Контейнеры.Выгрузить(, "Контейнер, КЛючАналитикиПеревозки"));
	
	Результат = Запрос.ВыполнитьПакет();   
	РезультатИзменениеКТК = Результат[1];
	Если РезультатИзменениеКТК.Пустой() Тогда
		Возврат МассивСчетов;
	КонецЕсли; 
	
	РезультатЗапроса = Результат[2];
	Если не РезультатЗапроса.Пустой() Тогда
		ВыборкаСчетов = РезультатЗапроса.Выбрать();
		Пока ВыборкаСчетов.Следующий() Цикл
			МассивСчетов.Добавить(ВыборкаСчетов.ПредставлениеСчета);
		КонецЦикла;
	КонецЕсли;

	Возврат МассивСчетов;
КонецФункции 

