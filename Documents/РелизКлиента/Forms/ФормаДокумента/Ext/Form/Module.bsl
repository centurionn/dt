&НаСервере
Процедура ОпределитьСтатусРелиза()
	
	ТекущаяДата = НачалоДня(ТекущаяДатаСеанса()); // Евросиб Фролов (14.03.2022 Ticket №0263596, привел к началу дня
	
	Если Объект.ДействиеРелизаОкончание >= ТекущаяДата // Евросиб Фролов (14.03.2022 Ticket №0263596, ">=" вместо ">" 
		И Объект.ВыданоКТКПоРелизу < Объект.ОбщееКоличествоКТКВРелизе Тогда
		СтатусРелиза = СтрШаблон("%1: %2/%3", "Активен", Объект.ВыданоКТКПоРелизу, Объект.ОбщееКоличествоКТКВРелизе);		
	КонецЕсли;
	
	Если Объект.ДействиеРелизаОкончание < ТекущаяДата И Объект.ВыданоКТКПоРелизу > 1
		ИЛИ Объект.ДействиеРелизаОкончание > ТекущаяДата И Объект.ВыданоКТКПоРелизу = Объект.ОбщееКоличествоКТКВРелизе Тогда
		СтатусРелиза = СтрШаблон("%1: %2/%3", "Реализован", Объект.ВыданоКТКПоРелизу, Объект.ОбщееКоличествоКТКВРелизе);		
	КонецЕсли;
	
	Если Объект.ДействиеРелизаОкончание < ТекущаяДата
		И Объект.ВыданоКТКПоРелизу = 0 Тогда
		СтатусРелиза = СтрШаблон("%1: %2/%3", "Аннулирован", Объект.ВыданоКТКПоРелизу, Объект.ОбщееКоличествоКТКВРелизе);		
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьИнструкциюПоСдачеТекущегоКонтейнера(ТекущиеДанные)
	
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 –начало 
	// ДИТ US 76935 ТА 77189 Сержантова А.С. Начало: 07.12.2023
	// Было:
	//ТекущиеДанныеКонтейнер = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(ТекущиеДанные.КлючАналитикиПеревозки,"Контейнер"); 
	//Стало:
	ТекущиеДанныеКонтейнер = ТекущиеДанные.Контейнер;
	// ДИТ US 76935 ТА 77189 Сержантова А.С. Конец: 07.12.2023
	
	МассивКонтейнеров = Новый Массив;
	МассивКонтейнеров.Добавить(ТекущиеДанныеКонтейнер);
	ДанныеПоКТК = ПолучитьИнструкции(МассивКонтейнеров);
	
	ДанныеТекущегоКТК = ДанныеПоКТК.Получить(ТекущиеДанныеКонтейнер);
	Если ДанныеТекущегоКТК <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеТекущегоКТК); // заполняем все поля, т.к. сюда попадаем после выбора КТК в строке или при его добавлении в табличную часть
		// ДИТ US 76935 ТА 77189 Сержантова А.С. Начало: 05.12.2023
		//ДобавитьЗначениеРеквизитаВКлюч(ТекущиеДанные.КлючАналитикиПеревозки,ДанныеТекущегоКТК.ИнструкцияПоСдачеИзАРМ,"ИнструкцияПоСдаче",,,ТекущиеДанные.ВерсияКлюча);
		// ДИТ US 76935 ТА 77189 Сержантова А.С. Конец: 05.12.2023
	Иначе
		ТекущиеДанные.СобственникКТК 	= ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
		ТекущиеДанные.ВидСобственности	= ПредопределенноеЗначение("Перечисление.ВариантыСобственности.ПустаяСсылка");
	КонецЕсли;
	
	// Евросиб Фролов (14.02.2022 Ticket№ 46606
	Если ЗаполнятьПоПервойСтроке Тогда
		Если Объект.Контейнеры.Количество() > 1 Тогда
			ПерваяСтрока = Объект.Контейнеры[0];
			Если ЗначениеЗаполнено(ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(ПерваяСтрока.КлючАналитикиПеревозки,"ИнструкцияПоСдаче")) Тогда
				//ТекущиеДанные.ИнструкцияПоСдаче = ПерваяСтрока.ИнструкцияПоСдаче;  
				// ДИТ US 76935 ТА 77189 Сержантова А.С. Начало: 05.12.2023
				//ДобавитьЗначениеРеквизитаВКлюч(ТекущиеДанные.КлючАналитикиПеревозки,ПерваяСтрока.ИнструкцияПоСдаче,"ИнструкцияПоСдаче",,,ТекущиеДанные.ВерсияКлюча);
				// ДИТ US 76935 ТА 77189 Сержантова А.С. Конец: 05.12.2023
			КонецЕсли;	
		КонецЕсли;		
	КонецЕсли;
	// Евросиб Фролов)
	
	// Если текст инструкции в АРМ и в документе отличается, то уведомим об этом пользователя
	Если ЗначениеЗаполнено(ТекущиеДанные.ИнструкцияПоСдачеИзАРМ)
		//И СокрЛП(ТекущиеДанные.ИнструкцияПоСдачеИзАРМ) <> СокрЛП(ТекущиеДанные.ИнструкцияПоСдаче) Тогда
		И СокрЛП(ТекущиеДанные.ИнструкцияПоСдачеИзАРМ) <> СокрЛП(ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(ТекущиеДанные.КлючАналитикиПеревозки,"ИнструкцияПоСдаче")) Тогда
		ТекстСообщения = СтрШаблон("Инструкции по сдаче в строке %1 отличаются от указанных в АРМ КТК", ТекущиеДанные.НомерСтроки);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	НастроитьВидимостьКолонкиИнструкцииАРМ();
	
	// ДИТ US 76935 ТА 77189 Сержантова А.С. Начало: 07.12.2023
	// Было:
	//ТекущиеДанные.ТипоразмерКТК = ОбщегоНазначенияВызовСервера.ЗначениеРеквизитаОбъекта(ТекущиеДанные.КлючАналитикиПеревозки, "Контейнер.ТипТЕ"); 
	//Стало:
	ТекущиеДанные.ТипоразмерКТК = ОбщегоНазначенияВызовСервера.ЗначениеРеквизитаОбъекта(ТекущиеДанные.Контейнер, "ТипТЕ");
	// ДИТ US 76935 ТА 77189 Сержантова А.С. Конец: 07.12.2023
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 –конец
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьВидимостьКолонкиИнструкцииАРМ()
	
	СтрокиСПустойИнструкцией = Объект.Контейнеры.НайтиСтроки(Новый Структура("ИнструкцияПоСдачеИзАРМ", ""));
	ЕстьЗаполненныеИнструкции = СтрокиСПустойИнструкцией.Количество() <> Объект.Контейнеры.Количество();
		
	Элементы.КонтейнерыИнструкцияПоСдачеИзАРМ.Видимость = ЕстьЗаполненныеИнструкции;	
	
КонецПроцедуры	

