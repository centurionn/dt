//ДИТ, Беляев СЮ, ТА49361, 30-03-2022, начало
&НаСервере
Функция ВыгрузитьВXMLНаСервере(ЭтоУдаление)
    ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml"); // получаем имя временного файла на сервере
	
	ЗначениеМодификацииДокумента = "Original";
	Если Объект.ЗапросОтправленТерминалу И ЗначениеЗаполнено(Объект.ДатаОтправкиЗапросаТерминалу) Тогда
		ЗначениеМодификацииДокумента = "Update";
	КонецЕсли;	             
	
	Если ЭтоУдаление Тогда
		ЗначениеМодификацииДокумента = "Delete";
	КонецЕсли;	
	
	ОтправительПочтовогоСообщения = ПараметрыСеанса.ТекущийПользователь;
	
	ПочтаОтправителяПочтовогоСообщения = "";
	КонтактнаяИнформация = ПараметрыСеанса.ТекущийПользователь.КонтактнаяИнформация.Найти(Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты, "Тип");
	Если КонтактнаяИнформация <> Неопределено Тогда
		 ПочтаОтправителяПочтовогоСообщения = КонтактнаяИнформация.Представление;
	КонецЕсли;
	
	Запись = Новый ЗаписьXML;
	
	Запись.ОткрытьФайл(ИмяВременногоФайла, "windows-1251");    
	Запись.ЗаписатьОбъявлениеXML();
    Запись.ЗаписатьНачалоЭлемента("MultiRelease");
	
	//ШАПКА
	Запись.ЗаписатьНачалоЭлемента("DocHead");  
	ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "CustomerCompany", Строка(Объект.Организация));   
	ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "DocNumber", Строка(Объект.НомерРелиза));
	ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "DocDate", ПривестиДатуКФормату(Объект.Дата));
	ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "Modification", Строка(ЗначениеМодификацииДокумента));
	ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "ActionType", Строка("Release"));
	ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "CustomerName", Строка(ОтправительПочтовогоСообщения));
	ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "CustomerEmail", Строка(ПочтаОтправителяПочтовогоСообщения));
	ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "Comments", Строка(Объект.Комментарий));
	ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "StartDate", ПривестиДатуКФормату(НачалоДня(Объект.ДействиеРелизаНачало)));
	ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "ExpireDate", ПривестиДатуКФормату(КонецДня(Объект.ДействиеРелизаОкончание)));				
	Запись.ЗаписатьКонецЭлемента(); //DocHead

	//ТЕРМИНАЛЫ       
	МассивПодстоков = Объект.ПодстокиВыдачи.Выгрузить().ВыгрузитьКолонку("НаименованиеПодстока");
	СтрокаПодстоков = СтрСоединить(МассивПодстоков,";");
	Запись.ЗаписатьНачалоЭлемента("Terminal");  
	ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "LocationName", Строка(Объект.ЛокацияВыдачи.Наименование)); 
	ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "LocationCode", Строка(Объект.ЛокацияВыдачи.Код));
	//Евросиб Коханенко Н.А. 18.07.2023 (( #72668
	//лишние слова, типа: (станция), (сток) - не отправляем
	//ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "TerminalName", Строка(Объект.ТерминалВыдачи));
	ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "TerminalName", Строка(Объект.ТерминалВыдачи.Наименование));
	//Евросиб Коханенко Н.А. 18.07.2023 )) #72668 
	ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "TerminalCode", Строка(Объект.ТерминалВыдачи.Код));
	ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "StockName", Строка(Объект.СтокВыдачи));
	ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "StockCode", Строка(Объект.СтокВыдачи.Код));
	ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "SubStockName", Строка(СтрокаПодстоков));
	Запись.ЗаписатьКонецЭлемента(); //Terminal
	
	//КОНТЕЙНЕРЫ     
	СостояниеКТК = 0;
	Если Объект.СостояниеКТК = Перечисления.СостоянияКТК.Груженый Тогда
		СостояниеКТК = 1;
	КонецЕсли;
	Запись.ЗаписатьНачалоЭлемента("Containers");
    ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "ContainerQuantity", Строка(Объект.ОбщееКоличествоКТКВРелизе));
	ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "ContTypeSize", Строка(Объект.ТипоразмерКТК));
	ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "ContTypeSizeISO", Строка(Объект.ТипоразмерКТК.КодISO));
	ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "IsRef", Строка(?(Объект.ТипоразмерКТК.Рефрижераторный,1,0)));
	ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "IsState", Строка(СостояниеКТК));   
	ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "IsNumbered", Строка(?(Объект.НомернаяВыдача,1,0)));
	Запись.ЗаписатьКонецЭлемента(); //Containers
	Запись.ЗаписатьНачалоЭлемента("ContainerList");
	
	// ДИТ US 62421 TA 64346 Евсенкин М.А. Начало: 03.02.2023
	МассивКлючей = РеквизитФормыВЗначение("Объект").Контейнеры.ВыгрузитьКолонку("КлючАналитикиПеревозки");
	ТЗПерваяМиляКлючиАналитики 	= Справочники.КлючиАналитикиПеревозки.КлючиАналитикиЗначенияПолейПоЭтапуПеревозки(МассивКлючей,Перечисления.ЭтапыПеревозки.ПерваяМиля);
	// ДИТ US 62421 TA 64346 Евсенкин М.А. Конец: 03.02.2023
	
	Для Каждого СтрДокумента Из Объект.Контейнеры Цикл
		//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 –начало
		ДатаВывозаП = Дата(1,1,1);
		Если ЗначениеЗаполнено(СтрДокумента.КлючАналитикиПеревозки) Тогда
			НайденнаяСтрокаТЗПерваяМиля 	= ТЗПерваяМиляКлючиАналитики.Найти(СтрДокумента.КлючАналитикиПеревозки);
			Если НайденнаяСтрокаТЗПерваяМиля <> Неопределено Тогда
				ДатаВывозаП = НайденнаяСтрокаТЗПерваяМиля.ДатаВыдачиКТКСТерминала;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ Объект.НомернаяВыдача И НЕ ЗначениеЗаполнено(ДатаВывозаП) Тогда
			Продолжить;
		КонецЕсли;
		Атрибуты = Неопределено;
		Если ЗначениеЗаполнено(ДатаВывозаП) Тогда
			Атрибуты = Новый Структура("ReleaseDate", ПривестиДатуКФормату(ДатаВывозаП));
		КонецЕсли;   
		ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "ContainerName", Строка(СтрДокумента.КлючАналитикиПеревозки.Контейнер), Атрибуты); 
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента(); //ContainerList
       	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 –конец
	//ПЕРЕВОЗЧИКИ   
	
	ТипТранспорта = 1;
	Если Объект.Автоперевозка = Перечисления.ВариантыАвтоперевозки.НеТребуется Тогда
		ТипТранспорта = 2;
	КонецЕсли; 
	
	// ДИТ US 58592 TA 60724 Евсенкин М.А. Начало: 19.12.2022
	Если ТипТранспорта = 2 Тогда 
		// Дата отправления и Станция назначения
		Запись.ЗаписатьНачалоЭлемента("Railway");
		ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "DestinationStation", Строка(Объект.СтанцияНазначенияПоЖД));
		ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "DepartureDate", ПривестиДатуКФормату(Объект.ДатаОтправленияПоЖДПлан));
		ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "OutputTransport", Строка(ТипТранспорта));
		Запись.ЗаписатьКонецЭлемента();
	КонецЕсли;
	// ДИТ US 58592 TA 60724 Евсенкин М.А. Конец: 19.12.2022

	Запись.ЗаписатьНачалоЭлемента("ForwarderList");
		
	//ДИТ Шевченко А.В. 58552 05.10.2022 -начало
	ВыборкаТранспортныхСредствНеПривязанныхККонтейнерам = ПолучитьТранспортныхСредствНеПривязанныхККонтейнерам(Объект.Ссылка);
	Пока ВыборкаТранспортныхСредствНеПривязанныхККонтейнерам.Следующий() Цикл       
		Запись.ЗаписатьНачалоЭлемента("Forwarder");
		ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "OutputTransport", Строка(ТипТранспорта)); 
		ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "TransportCompleted", 0);
		ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "DriverName", Строка(ВыборкаТранспортныхСредствНеПривязанныхККонтейнерам.ФИОВодителя)); 	
		ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "TransportNum", Строка(ВыборкаТранспортныхСредствНеПривязанныхККонтейнерам.РегНомерТС)); 	
		ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "PassportNumber", Строка(ВыборкаТранспортныхСредствНеПривязанныхККонтейнерам.ПаспортныеДанные));
		ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "ForwarderName", Строка(ВыборкаТранспортныхСредствНеПривязанныхККонтейнерам.Автоперевозчик));
		ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "ForwarderINN", Строка(ВыборкаТранспортныхСредствНеПривязанныхККонтейнерам.ИНН));
		ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "ForwarderKPP", Строка(ВыборкаТранспортныхСредствНеПривязанныхККонтейнерам.КПП));
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;	 
	ВыборкаТСиПеревозчиковПривязанныхККонтейнерам = ПолучитьТСиПеревозчиковПривязанныхККонтейнерам(Объект.Ссылка);
	Пока ВыборкаТСиПеревозчиковПривязанныхККонтейнерам.Следующий() Цикл  
		Запись.ЗаписатьНачалоЭлемента("Forwarder");	
		ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "OutputTransport", Строка(ТипТранспорта)); 		    
		TransportCompleted = ?(ВыборкаТСиПеревозчиковПривязанныхККонтейнерам.Вывезен,1,0); //общий случай для транспортных средств
		//Если ЗначениеЗаполнено(ВыборкаТСиПеревозчиковПривязанныхККонтейнерам.ИдентификаторСтрокиПеревозчика) Тогда
		//	//TransportCompleted = 1, если указан Перевозчик и все Контейнеры по этому перевозчику доставлены
		//	Если ВыборкаТСиПеревозчиковПривязанныхККонтейнерам.КоличествоНеВывезенныхКонтейнеров>0 Тогда
		//		TransportCompleted = 0;
		//	КонецЕсли;
		//КонецЕсли;
		ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "TransportCompleted", TransportCompleted);
		ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "DriverName", Строка(ВыборкаТСиПеревозчиковПривязанныхККонтейнерам.ФИОВодителя)); 	
		ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "TransportNum", Строка(ВыборкаТСиПеревозчиковПривязанныхККонтейнерам.РегНомерТС)); 	
		ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "PassportNumber", Строка(ВыборкаТСиПеревозчиковПривязанныхККонтейнерам.ПаспортныеДанные));		
		ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "ForwarderName", Строка(ВыборкаТСиПеревозчиковПривязанныхККонтейнерам.Перевозчик)); 	    
		ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "ForwarderINN", Строка(ВыборкаТСиПеревозчиковПривязанныхККонтейнерам.ИНН)); 
		ЕСОбменСервер.ДобавитьЭлементВФайл(Запись, "ForwarderKPP", Строка(ВыборкаТСиПеревозчиковПривязанныхККонтейнерам.КПП));
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	//ДИТ Шевченко А.В. 58552 05.10.2022 -конец

	Запись.ЗаписатьКонецЭлемента(); //ForwarderList
	
	Запись.ЗаписатьКонецЭлемента(); //MultiRelease
	Запись.Закрыть();
	
	// передаем заполненный на сервере файлик назад на клиент через временноехранилище:    
    Двоичное=Новый ДвоичныеДанные(ИмяВременногоФайла);  // получаем двоичные данные из файла
    Адрес = ПоместитьВоВременноеХранилище(Двоичное, ЭтаФорма.УникальныйИдентификатор); // кидаем двоичные данные во врем. хранилище
    Возврат Адрес;
КонецФункции 
//ДИТ, Беляев СЮ, ТА49361, 30-03-2022, конец

//ДИТ, Беляев СЮ, ТА49361, 30-03-2022, начало
&НаСервере
Функция ПолучитьТранспортныхСредствНеПривязанныхККонтейнерам(вхДокумент)
	//ДИТ Шевченко А.В. US 62421 TA 68370 10.04.2023 -Начало
	//ДИТ Шевченко А.В. 58552 05.10.2022 -начало добавил условие на пустого водителя и номерТС
	//Запрос = Новый Запрос;
	//Запрос.Текст = 
	//	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	//	|	РелизКлиентаКонтейнеры.ИдентификаторСтрокиТС КАК ИдентификаторСтрокиТС
	//	|ПОМЕСТИТЬ ВТСвязьВКонтейнерах
	//	|ИЗ
	//	|	Документ.РелизКлиента.Контейнеры КАК РелизКлиентаКонтейнеры
	//	|ГДЕ
	//	|	РелизКлиентаКонтейнеры.Ссылка = &Ссылка
	//	|;
	//	|
	//	|////////////////////////////////////////////////////////////////////////////////
	//	|ВЫБРАТЬ
	//	|	РелизКлиентаТранспортныеСредства.Ссылка КАК Ссылка,
	//	|	РелизКлиентаТранспортныеСредства.НомерСтроки КАК НомерСтроки,
	//	|	РелизКлиентаТранспортныеСредства.ФИОВодителя КАК ФИОВодителя,
	//	|	РелизКлиентаТранспортныеСредства.РегНомерТС КАК РегНомерТС,
	//	|	РелизКлиентаТранспортныеСредства.ПаспортныеДанные КАК ПаспортныеДанные,
	//	|	РелизКлиентаТранспортныеСредства.ИдентификаторСтроки КАК ИдентификаторСтроки,
	//	|	РелизКлиентаТранспортныеСредства.ИНН КАК ИНН,
	//	|	РелизКлиентаТранспортныеСредства.КПП КАК КПП,
	//	|	РелизКлиентаТранспортныеСредства.Автоперевозчик КАК Автоперевозчик
	//	|ИЗ
	//	|	Документ.РелизКлиента.ТранспортныеСредства КАК РелизКлиентаТранспортныеСредства
	//	|ГДЕ
	//	|	РелизКлиентаТранспортныеСредства.Ссылка = &Ссылка
	//	|	И НЕ РелизКлиентаТранспортныеСредства.ИдентификаторСтроки В
	//	|				(ВЫБРАТЬ
	//	|					ВТСвязьВКонтейнерах.ИдентификаторСтрокиТС
	//	|				ИЗ
	//	|					ВТСвязьВКонтейнерах КАК ВТСвязьВКонтейнерах)
	//	|	И НЕ РелизКлиентаТранспортныеСредства.ФИОВодителя = """"
	//	|	И НЕ РелизКлиентаТранспортныеСредства.РегНомерТС = """"";
	//
	//Запрос.УстановитьПараметр("Ссылка", вхДокумент);
	//
	//РезультатЗапроса = Запрос.Выполнить();
	//
	//ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	//
	//Возврат ВыборкаДетальныеЗаписи;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РелизКлиентаКонтейнеры.Ссылка КАК Ссылка,
	               |	РелизКлиентаКонтейнеры.НомерСтроки КАК НомерСтроки,
	               |	КлючиАналитикиПеревозкиМили.ФИОВодителя КАК ФИОВодителя,
	               |	КлючиАналитикиПеревозкиМили.РегНомерТС КАК РегНомерТС,
	               |	КлючиАналитикиПеревозкиМили.ПаспортныеДанные КАК ПаспортныеДанные,
	               |	РелизКлиентаКонтейнеры.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	КлючиАналитикиПеревозкиМили.ИНН КАК ИНН,
	               |	КлючиАналитикиПеревозкиМили.КПП КАК КПП,
	               |	КлючиАналитикиПеревозкиМили.Автоперевозчик КАК Автоперевозчик
	               |ИЗ
	               |	Документ.РелизКлиента.Контейнеры КАК РелизКлиентаКонтейнеры
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозкиМили
	               |		ПО (КлючиАналитикиПеревозкиМили.Ссылка = РелизКлиентаКонтейнеры.КлючАналитикиПеревозки)
	               |			И (КлючиАналитикиПеревозкиМили.Ссылка.Контейнер <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
	               |				ИЛИ КлючиАналитикиПеревозкиМили.ФИОВодителя <> """"
	               |				ИЛИ (КлючиАналитикиПеревозкиМили.Автоперевозчик <> """"
	               |					И КлючиАналитикиПеревозкиМили.Автоперевозчик <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) И КлючиАналитикиПеревозкиМили.Автоперевозчик <> Неопределено))
	               |			И (КлючиАналитикиПеревозкиМили.ЭтапПеревозки = ЗНАЧЕНИЕ(Перечисление.ЭтапыПеревозки.ПерваяМиля))
	               |ГДЕ
	               |	РелизКлиентаКонтейнеры.Ссылка = &Ссылка
	               |	И НЕ КлючиАналитикиПеревозкиМили.ФИОВодителя = """"
