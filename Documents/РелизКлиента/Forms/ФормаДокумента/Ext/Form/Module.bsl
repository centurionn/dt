&НаСервереБезКонтекста
Функция ВыполнитьПроверкуПередОтправкой(ТаблицаКлючей,НомернаяВыдача)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КлючиАналитикиПеревозкиМили.Ссылка КАК КлючАналитикиПеревозки,
	               |	КлючиАналитикиПеревозкиМили.Автоперевозчик КАК Автоперевозчик,
	               |	КлючиАналитикиПеревозкиМили.ИНН КАК ИНН,
	               |	КлючиАналитикиПеревозкиМили.Ссылка.Контейнер КАК Контейнер
	               |ПОМЕСТИТЬ ВТ_Ключи
	               |ИЗ
	               |	Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозкиМили
	               |ГДЕ
	               |	КлючиАналитикиПеревозкиМили.Ссылка В(&МассивКлючей)
	               |	И (КлючиАналитикиПеревозкиМили.Ссылка.Контейнер <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
	               |			ИЛИ КлючиАналитикиПеревозкиМили.ФИОВодителя <> """"
	               |			ИЛИ (КлючиАналитикиПеревозкиМили.Автоперевозчик <> """"
	               |				И КлючиАналитикиПеревозкиМили.Автоперевозчик <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) И КлючиАналитикиПеревозкиМили.Автоперевозчик <> Неопределено))
	               |	И КлючиАналитикиПеревозкиМили.ЭтапПеревозки = ЗНАЧЕНИЕ(Перечисление.ЭтапыПеревозки.ПерваяМиля)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Ключи.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки
	               |ИЗ
	               |	ВТ_Ключи КАК ВТ_Ключи
	               |ГДЕ
	               |	ВТ_Ключи.Контейнер = ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
	               |	И &НомернаяВыдача
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Ключи.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки
	               |ИЗ
	               |	ВТ_Ключи КАК ВТ_Ключи
	               |ГДЕ
	               |	(ВТ_Ключи.Автоперевозчик = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	               |			ИЛИ ВТ_Ключи.Автоперевозчик = """")
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Ключи.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки
	               |ИЗ
	               |	ВТ_Ключи КАК ВТ_Ключи
	               |ГДЕ
	               |	ВТ_Ключи.ИНН = """"
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_Ключи.КлючАналитикиПеревозки) КАК КлючАналитикиПеревозки
	               |ИЗ
	               |	ВТ_Ключи КАК ВТ_Ключи";
	
	Запрос.УстановитьПараметр("МассивКлючей",ТаблицаКлючей);
	Запрос.УстановитьПараметр("НомернаяВыдача",НомернаяВыдача);
	
	Результат = Запрос.ВыполнитьПакет();
	
	МассивПустыхКонтейнеров = Результат[1].Выгрузить().ВыгрузитьКолонку("КлючАналитикиПеревозки");
	МассивПустыхАвтоперевозчиков = Результат[2].Выгрузить().ВыгрузитьКолонку("КлючАналитикиПеревозки");
	МассивПустыхИНН = Результат[3].Выгрузить().ВыгрузитьКолонку("КлючАналитикиПеревозки");
	КоличествоПроверяемыхСтрок = Результат[4].Выгрузить().Количество();
	
	
	Возврат Новый Структура("МассивПустыхКонтейнеров,МассивПустыхАвтоперевозчиков,МассивПустыхИНН,КоличествоПроверяемыхСтрок",МассивПустыхКонтейнеров,МассивПустыхАвтоперевозчиков,МассивПустыхИНН,КоличествоПроверяемыхСтрок); 
	
КонецФункции	

