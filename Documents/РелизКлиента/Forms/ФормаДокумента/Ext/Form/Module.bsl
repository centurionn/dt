		//Элементы.ПодстокВыдачи.Видимость = Истина;
		Элементы.ПодстокиВыдачи.Видимость = Истина;
		// Евросиб Фролов)
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьПодстокаСдачи()
	
	// Евросиб Фролов (28.03.2022 Task №49126
	//Элементы.ПодстокСдачи.Видимость = Ложь;
	Элементы.ПодстокиСдачи.Видимость = Ложь;
	// Евросиб Фролов)
	
	Если Не ЗначениеЗаполнено(Объект.СтокСдачи) Тогда
		Возврат;
	КонецЕсли;
	
	// Евросиб Фролов (16.02.2022 Task №46605
	// Подсток сдачи отображаем в случае, если в составе мультилокации есть собственный сток.
	//ДИТ Шевченко А.В. 63318 19.01.2023 - начало
	Если ТипЗнч(Объект.СтокСдачи) = Тип("СправочникСсылка.Мультилокации") Тогда
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	МультилокацииЛокации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Мультилокации.Локации КАК МультилокацииЛокации
		|ГДЕ
		|	МультилокацииЛокации.Ссылка = &СтокСдачи
		|	И МультилокацииЛокации.Локация.СобственныйСток";
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("СтокСдачи", Объект.СтокСдачи);
		РезультатЗапроса = Запрос.Выполнить();
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
			// Евросиб Фролов (28.03.2022 Task №49126
			//Элементы.ПодстокСдачи.Видимость = Истина;
			Элементы.ПодстокиСдачи.Видимость = Истина;
			// Евросиб Фролов)
		КонецЕсли;
	ИначеЕсли ТипЗнч(Объект.СтокСдачи) = Тип("СправочникСсылка.Локации") Тогда
		Элементы.ПодстокиСдачи.Видимость = Объект.СтокСдачи.СобственныйСток;
	КонецЕсли;
	//ДИТ Шевченко А.В. 63318 19.01.2023 - конец
		
КонецПроцедуры

