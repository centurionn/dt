// ДИТ US 76619 ТА 76735 Сержантова А.С. 07.11.2023  
&НаКлиенте
Асинх Процедура ЗаполнитьПустыеСтрокиНомерамиКТКИзБуфера(МассивИдентификаторов, ДанныеВставки)   
	
	ИменаЗаполненныхПолей = "";
	
	ИнструкцияПоСдаче = Неопределено;
	КоличествоВставляемыхКТК = ДанныеВставки.Количество();
	Если ЗаполнятьПоПервойСтроке Тогда
		Если Объект.Контейнеры.Количество() > 0 Тогда
			ПерваяСтрока = Объект.Контейнеры[0];
			ИнструкцияПоСдачеПерваяСтрока = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(ПерваяСтрока.КлючАналитикиПеревозки,"ИнструкцияПоСдаче");
			Если ЗначениеЗаполнено(ПерваяСтрока.ИнструкцияПоСдаче) Тогда
				ИнструкцияПоСдаче = ИнструкцияПоСдачеПерваяСтрока;
			КонецЕсли;
		КонецЕсли;		
	КонецЕсли;
	
    НомерСтроки = 0;
	ОтветПользователя_Перезаполнить = Неопределено;
	МассивИдентификаторовДляСортировки = Новый СписокЗначений;
	МассивИдентификаторовДляСортировки.ЗагрузитьЗначения(МассивИдентификаторов);
	МассивИдентификаторовДляСортировки.СортироватьПоЗначению(НаправлениеСортировки.Возр);
	МассивИдентификаторов = МассивИдентификаторовДляСортировки.ВыгрузитьЗначения();
	
	Для каждого ИдентификаторСтроки Из МассивИдентификаторов Цикл 
		Если КоличествоВставляемыхКТК = НомерСтроки Тогда // больше нет контейнеров для вставки
			Прервать;
		КонецЕсли; 
		
		СтрокаУслуги = Объект.Контейнеры.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если ЗначениеЗаполнено(СтрокаУслуги.Контейнер) Тогда            
			//не задавали вопрос
			Если ОтветПользователя_Перезаполнить = Неопределено Тогда
				// здесь надо спросить у пользователя перезаполнить или пропустить?  
				КнопкиВопроса = Новый СписокЗначений();
				КнопкиВопроса.Добавить(КодВозвратаДиалога.Нет, "Пропустить");
				КнопкиВопроса.Добавить(КодВозвратаДиалога.Да, "Перезаполнить");
				КнопкиВопроса.Добавить(КодВозвратаДиалога.ОК, "Перезаполнить все" + Символы.ПС + "выделенные строки");
				КнопкиВопроса.Добавить(КодВозвратаДиалога.Отмена, "Отмена");
				ТекстВопроса = СтрШаблон("Поле ""Номер КТК"" заполнено в строке № %1." +
							Символы.ПС+ "Перезаполнить номер контейнера в указанной строке" +
							Символы.ПС+ "или пропустить её?",
				ИдентификаторСтроки + 1);    
				Обещание = Ждать ВопросАсинх(ТекстВопроса, КнопкиВопроса,,,"В строке уже заполнен КТК"); 
				Если Обещание = КодВозвратаДиалога.Нет Тогда      //Пропускаем одну строку
					Продолжить;
				ИначеЕсли Обещание = КодВозвратаДиалога.Да Тогда  //Перезаполнить одну строку
					СтрокаВставки = ДанныеВставки[НомерСтроки];
					ЗаполнитьСтрокуДаннымиВставкиИзБуфера(ИдентификаторСтроки, СтрокаВставки, ИнструкцияПоСдаче);
					НомерСтроки = НомерСтроки + 1;
					Продолжить;
				ИначеЕсли Обещание = КодВозвратаДиалога.Отмена Тогда  //Прерываем последующее исполнение	
					Прервать; 
				ИначеЕсли Обещание = КодВозвратаДиалога.ОК Тогда  //Перезаполнить все выделенные строки
					СтрокаВставки = ДанныеВставки[НомерСтроки];
					ЗаполнитьСтрокуДаннымиВставкиИзБуфера(ИдентификаторСтроки, СтрокаВставки, ИнструкцияПоСдаче);
					НомерСтроки = НомерСтроки + 1;  
					ОтветПользователя_Перезаполнить = КодВозвратаДиалога.ОК;
					Продолжить;
				КонецЕсли;    
			//был получен ответ по всем строкам	
			Иначе
				Если ОтветПользователя_Перезаполнить = КодВозвратаДиалога.ОК Тогда
					СтрокаВставки = ДанныеВставки[НомерСтроки];
					ЗаполнитьСтрокуДаннымиВставкиИзБуфера(ИдентификаторСтроки, СтрокаВставки, ИнструкцияПоСдаче); 
					НомерСтроки = НомерСтроки + 1; 
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		Иначе	
			СтрокаВставки = ДанныеВставки[НомерСтроки];	
			ЗаполнитьСтрокуДаннымиВставкиИзБуфера(ИдентификаторСтроки, СтрокаВставки, ИнструкцияПоСдаче); 
			НомерСтроки = НомерСтроки + 1;
		КонецЕсли;
	КонецЦикла; 
	
	ОповеститьОбИзменении(Тип("СправочникСсылка.КлючиАналитикиПеревозки")); 
	ЗаполнитьДобавленныеКолонки("ВидСобственности, СобственникКТК, ИнструкцияПоСдачеИзАРМ"); 
	// ДИТ US 76935 ТА 77189 Сержантова А.С. Начало: 08.12.2023
	//ЗаполнитьТаблицуПоКлючамАналитики();
	// ДИТ US 76935 ТА 77189 Сержантова А.С. Конец: 08.12.2023
	
КонецПроцедуры  

// ДИТ US 76619 ТА 76735 Сержантова А.С. 07.11.2023 
&НаКлиенте
Процедура ЗаполнитьСтрокуДаннымиВставкиИзБуфера(ИдентификаторСтроки, СтрокаВставки, ИнструкцияПоСдаче) 
	
	ЭтаФорма.Модифицированность = Истина;
	СтрокаКТК = Объект.Контейнеры.НайтиПоИдентификатору(ИдентификаторСтроки);
	КлючСсылка = СтрокаКТК.КлючАналитикиПеревозки;
	
	ЗаполнитьЗначенияСвойств(СтрокаКТК, СтрокаВставки);  
	//Евросиб(ДИТ) Сержантова А.С. US 77172 ТА 83838 Начало 05.02.2025
	СтрокаКТК.ДатаДобавленияВРелиз = ТекущаяДата();
	//Евросиб(ДИТ) Сержантова А.С. US 77172 ТА 83838 Конец 05.02.2025  
	
	// ДИТ US 76935 ТА 77189 Сержантова А.С. Начало: 05.12.2023
	//ДобавитьЗначениеРеквизитаВКлюч(КлючСсылка,СтрокаВставки.Контейнер,"Контейнер",,,СтрокаКТК.ВерсияКлюча);  
	// ДИТ US 76935 ТА 77189 Сержантова А.С. Конец: 05.12.2023
	Если ИнструкцияПоСдаче <> Неопределено Тогда
		СтрокаКТК.ИнструкцияПоСдаче = ИнструкцияПоСдаче;    
		// ДИТ US 76935 ТА 77189 Сержантова А.С. Начало: 05.12.2023
		//ДобавитьЗначениеРеквизитаВКлюч(КлючСсылка,ИнструкцияПоСдаче,"ИнструкцияПоСдаче",,,СтрокаКТК.ВерсияКлюча);
		// ДИТ US 76935 ТА 77189 Сержантова А.С. Конец: 05.12.2023
	КонецЕсли;   
	
	ОповеститьОбИзменении(Тип("СправочникСсылка.КлючиАналитикиПеревозки"));

КонецПроцедуры

