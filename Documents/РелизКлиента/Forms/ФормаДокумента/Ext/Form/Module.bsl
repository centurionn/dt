		ИндексСтроки = Объект.Контейнеры.Количество() - 1;   
		Пока ИндексСтроки >= 0 Цикл
			КлючВСтроке = Объект.Контейнеры[ИндексСтроки].КлючАналитикиПеревозки; 
			
			Если МассивКлючейИтог.Найти(КлючВСтроке) = Неопределено Тогда 
				
				//Евросиб Коханенко Н.А. 21.08.2024 (( #88606
				//Объект.Контейнеры.Удалить(ИндексСтроки);
				//если ктк в ключе привязан к заявке (любой), то такую строку не удалять
				//если ктк удален из заявки (пусто и в ДобавленВЗаявку и в Заявке в ключе, то такую строку не удалять 
				ЗаявкаВКлюче = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КлючВСтроке, "Заявка");
				Если Не ЗначениеЗаполнено(ЗаявкаВКлюче) 
					И ЗначениеЗаполнено(Объект.Контейнеры[ИндексСтроки].ДобавленВЗаявку) Тогда 
					Объект.Контейнеры.Удалить(ИндексСтроки);
				КонецЕсли; 
				//Евросиб Коханенко Н.А. 21.08.2024 )) #88606
			КонецЕсли; 
			
			ИндексСтроки = ИндексСтроки - 1;
		КонецЦикла;
		// ДИТ US 79950 ТА 79951 Сержантова А.С. Конец: 22.02.2024 
		
		//Евросиб Коханенко Н.А. 20.08.2024 (( #88606
		КонецЕсли; 
		//Евросиб Коханенко Н.А. 20.08.2024 )) #88606 

		КолДобавляемыхСтрок = Объект.ОбщееКоличествоКТКВРелизе - МассивКлючейИтог.Количество();
		Для Инд = 1 По КолДобавляемыхСтрок Цикл  
			НовСтрока = Объект.Контейнеры.Добавить();
			СтруктураКлюча  = Справочники.КлючиАналитикиПеревозки.СтруктураКлючаАналитикиПеревозки(); 
			СтруктураКлюча.Вставить("Заявка",Объект.Заявка);
			СтрОтвет = Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлюча);
			НовСтрока.КлючАналитикиПеревозки = СтрОтвет.КлючАналитикиПеревозки; 
		КонецЦикла;
		
		Если Объект.ОбщееКоличествоКТКВРелизе < Объект.Контейнеры.Количество() Тогда
			МассивКлючейП = Новый Массив;
			Для Каждого СтрокаТЧ Из Объект.Контейнеры Цикл
				МассивКлючейП.Добавить(СтрокаТЧ.КлючАналитикиПеревозки);
			КонецЦикла;	
			
			КлючиПустыхСтрок = ВернутьСтрокиСПустымиКлючами(МассивКлючейП);  
			// ДИТ US 79950 ТА 79951 Сержантова А.С. Начало: 21.02.2024 - сначала убираем ключи без контейнеров
			КлючиПустыхСтрокБезКонтейнеров = Новый Массив;
			Для каждого ПустойКлюч Из КлючиПустыхСтрок Цикл
				Если не ЗначениеЗаполнено(ПустойКлюч.Контейнер) Тогда
					КлючиПустыхСтрокБезКонтейнеров.Добавить(ПустойКлюч);
				КонецЕсли;
			КонецЦикла;
			// ДИТ US 79950 ТА 79951 Сержантова А.С. Конец: 21.02.2024
			МассивУдаляемыхСтрок = Новый Массив; 
			КолУдаляемых = Объект.Контейнеры.Количество() - Объект.ОбщееКоличествоКТКВРелизе;  
			
			// ДИТ US 79950 ТА 79951 Сержантова А.С. Начало: 21.02.2024   
			Для Каждого СтрокаТч Из Объект.Контейнеры Цикл
				Если КолУдаляемых = 0 Тогда
					Прервать;
				КонецЕсли;
				Если КлючиПустыхСтрокБезКонтейнеров.Найти(СтрокаТч.КлючАналитикиПеревозки) <> Неопределено Тогда
					МассивУдаляемыхСтрок.Добавить(СтрокаТч);
					КолУдаляемых = КолУдаляемых - 1;  
				КонецЕсли;
			КонецЦикла;
			// ДИТ US 79950 ТА 79951 Сержантова А.С. Конец: 21.02.2024
				
			Для Каждого СтрокаТч Из Объект.Контейнеры Цикл
				Если КолУдаляемых = 0 Тогда 
					// ДИТ US 79950 ТА 79951 Сержантова А.С. Начало: 21.02.2024
					// Было:
					//Продолжить; 
					//Стало:
					Прервать;
					// ДИТ US 79950 ТА 79951 Сержантова А.С. Конец: 21.02.2024
				КонецЕсли;	    
				Если КлючиПустыхСтрок.Найти(СтрокаТч.КлючАналитикиПеревозки) <> Неопределено   
				// ДИТ US 79950 ТА 79951 Сержантова А.С. Начало: 21.02.2024
				    и МассивУдаляемыхСтрок.Найти(СтрокаТч) = Неопределено Тогда
				// ДИТ US 79950 ТА 79951 Сержантова А.С. Конец: 21.02.2024
					МассивУдаляемыхСтрок.Добавить(СтрокаТч);
					КолУдаляемых = КолУдаляемых - 1;
				КонецЕсли;	
			КонецЦикла;	
			
			Для Каждого ЗнчМ Из МассивУдаляемыхСтрок Цикл
				Объект.Контейнеры.Удалить(ЗнчМ);
			КонецЦикла;	
			
		КонецЕсли;	
		//ДИТ Шевченко А.В. US 62421 ТА 70357 24.05.2023 -Конец
	//Субботин 77659 18.12.2023 	
	Иначе
		ТаблицаКлючейАналитики = РезультаЗапроса[3].Выгрузить();
		Для Каждого КТК из МассивКтк Цикл
			СтруктураПоиска = Новый Структура ("Контейнер", КТК);
			РезПоиска = Объект.Контейнеры.НайтиСтроки(СтруктураПоиска);
			Если РезПоиска.Количество() = 0 Тогда 
				НовСтрока = Объект.Контейнеры.Добавить();
				НайденныйКлюч = ТаблицаКлючейАналитики.Найти(КТК,"НомерКТК");
				Если НЕ НайденныйКлюч = Неопределено Тогда 
					НовСтрока.КлючАналитикиПеревозки = НайденныйКлюч.КлючАналитикиПеревозки;
				КонецЕсли; 
				НовСтрока.Контейнер = КТК;
				НовСтрока.ТипоразмерКТК = Объект.ТипоразмерКТК;
			КонецЕсли;
		КонецЦикла;
		МассивКТКОбъекта = Новый Массив;
		ТЧКонтейнеры = Объект.Контейнеры;
		Для Каждого СтрокаТЧ из ТЧКонтейнеры Цикл
			Если ЗначениеЗаполнено(СтрокаТЧ.Контейнер) Тогда
				МассивКТКОбъекта.Добавить(СтрокаТЧ.Контейнер);
			КонецЕсли;
		КонецЦикла;
		ЛишниеСтроки = ОбщегоНазначенияКлиентСервер.РазностьМассивов(МассивКТКОбъекта, МассивКтк);
		Для Каждого ЛишнийКТК Из ЛишниеСтроки Цикл
			СтруктураПоиска = Новый Структура ("Контейнер", ЛишнийКТК);
			НайденныеСтроки = ТЧКонтейнеры.НайтиСтроки(СтруктураПоиска);
			Для Каждого НайденнаяСтрока из НайденныеСтроки Цикл
				ТЧКонтейнеры.Удалить(НайденнаяСтрока);
			КонецЦикла;
		КонецЦикла;	
	КонецЕсли;
	//Субботин 77659 18.12.2023 Конец   
	
	НастроитьЗависимыеОтАвтоперевозкиЭлементы();
	
	// Евросиб Фролов (28.02.2022 Task №46354
	Для Каждого ТекПоле Из ПодсвечиваемыеПоляДоИзменения Цикл
		Если ТекПоле.Значение <> ПодсвечиваемыеПоляПослеИзменения[ТекПоле.Ключ] Тогда
			ЦветПодсветки = Новый Цвет(255, 0, 0);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ТекПоле.Ключ, "ЦветТекстаЗаголовка", ЦветПодсветки);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ТекПоле.Ключ, "ЦветТекста", ЦветПодсветки);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ТекПоле.Ключ, "ЦветРамки", ЦветПодсветки);
		КонецЕсли;	
	КонецЦикла;	
	// Евросиб Фролов)
	
	// Евросиб Фролов (14.03.2022 Ticket №0263596
	// Обновлять статус релиза при обновлении сведений из заявки
	ОпределитьСтатусРелиза();
	// Евросиб Фролов)
	//ДИТ Шевченко А.В. TASK 59945 06.10.2022 -конец
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьТаблицуИзЗапроса(ИмяТабличнойЧасти, ТаблицаЗапроса, ИмяРеквизитаСвязи)
	
	// Евросиб Фролов (28.02.2022 Task №46354
	ТаблицаДоИзменения = Объект[ИмяТабличнойЧасти].Выгрузить();	
	// Евросиб Фролов)
	
	УдаляемыеСтроки = Новый Массив;
	Для Каждого СтрокаТабличнойЧасти Из Объект[ИмяТабличнойЧасти] Цикл
		Если Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.ИдентификаторСтроки) Тогда
			// строка добавлена вручную
			Продолжить;
		КонецЕсли;
		
		НайденнаяСтрокаЗапроса = ТаблицаЗапроса.Найти(СтрокаТабличнойЧасти.ИдентификаторСтроки, "ИдентификаторСтроки");
		Если НайденнаяСтрокаЗапроса <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, НайденнаяСтрокаЗапроса);
		Иначе
			// Если строка не привязана к КТК, то удаляем строку.
			НайденнаяСтрокаКТК = Объект.Контейнеры.НайтиСтроки(Новый Структура(ИмяРеквизитаСвязи, СтрокаТабличнойЧасти.ИдентификаторСтроки));
			Если НайденнаяСтрокаКТК.Количество() > 0 Тогда
				Для Каждого ТекущийКТК Из НайденнаяСтрокаКТК Цикл
					//ДИТ Шевченко А.В. TASK 51973 03.06.2022 -Начал
					ТекущийКТК[ИмяРеквизитаСвязи] = "";
					//ДИТ Шевченко А.В. TASK 51973 03.06.2022 -Конец
				КонецЦикла;	
			КонецЕсли;
			УдаляемыеСтроки.Добавить(СтрокаТабличнойЧасти.ИдентификаторСтроки);
			
			Если ИмяТабличнойЧасти = "ТранспортныеСредства" Тогда
				ОбщегоНазначения.СообщитьПользователю("Удалено транспортное средство первой мили: водитель - " + СтрокаТабличнойЧасти.ФИОВодителя + ", рег. № ТС " + СтрокаТабличнойЧасти.РегНомерТС + ", паспорт " + СтрокаТабличнойЧасти.ПаспортныеДанные);	
			ИначеЕсли ИмяТабличнойЧасти = "ТранспортныеСредстваПоследняяМиля" Тогда
				ОбщегоНазначения.СообщитьПользователю("Удалено транспортное средство последней мили: водитель - " + СтрокаТабличнойЧасти.ФИОВодителя + ", рег. № ТС " + СтрокаТабличнойЧасти.РегНомерТС + ", паспорт " + СтрокаТабличнойЧасти.ПаспортныеДанные);	
			КонецЕсли;
			// Евросиб Фролов) 

		КонецЕсли;	
		
	КонецЦикла;	
	
	// Удаляем строки
	Если УдаляемыеСтроки.Количество() > 0 Тогда
		Индекс = Объект[ИмяТабличнойЧасти].Количество() - 1;
		Пока Индекс >= 0 Цикл
			Если УдаляемыеСтроки.Найти(Объект[ИмяТабличнойЧасти][Индекс].ИдентификаторСтроки) <> Неопределено Тогда
				Объект[ИмяТабличнойЧасти].Удалить(Индекс);
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
	КонецЕсли;
	
	// Добавляем новые строки
	Для Каждого СтрокаПолученнойТаблицы Из ТаблицаЗапроса Цикл
		НайденныеСтроки = Объект[ИмяТабличнойЧасти].НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаПолученнойТаблицы.ИдентификаторСтроки));
		Если НайденныеСтроки.Количество() = 0 Тогда
			НоваяСтрока = Объект[ИмяТабличнойЧасти].Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПолученнойТаблицы);
		КонецЕсли;	
	КонецЦикла;
	
	ПоляДляОформления = Новый Соответствие;
	КолонкиТабличнойЧасти = ТаблицаДоИзменения.Колонки;
	Для Каждого ТекСтрока Из Объект[ИмяТабличнойЧасти] Цикл
		
		СтрокаДоИзменений = ТаблицаДоИзменения.Найти(ТекСтрока.ИдентификаторСтроки, "ИдентификаторСтроки");
		
		Если СтрокаДоИзменений = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
				
		Для Каждого ТекКолонка Из КолонкиТабличнойЧасти Цикл
			Если ТекКолонка.Имя = "НомерСтроки" Или ТекКолонка.Имя = "ИдентификаторСтроки" Или ТекКолонка.Имя = "ИсходныйНомерСтроки"Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТекСтрока[ТекКолонка.Имя] <> СтрокаДоИзменений[ТекКолонка.Имя] Тогда
				
				Поле = ПоляДляОформления.Получить(ТекКолонка.Имя);
				
				Если Поле = Неопределено Тогда
					СписокИдентификаторовСтрок = Новый СписокЗначений;
					СписокИдентификаторовСтрок.Добавить(ТекСтрока.ИдентификаторСтроки);
					ПоляДляОформления.Вставить(ТекКолонка.Имя, СписокИдентификаторовСтрок);
				Иначе
					Поле.Вставить(ТекСтрока.ИдентификаторСтроки);
				КонецЕсли;	
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого ТекПоле Из ПоляДляОформления Цикл
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ПолеЭлемента = ЭлементУО.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяТабличнойЧасти + ТекПоле.Ключ); 
		
		ОтборЭлемента = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяТабличнойЧасти + ".ИдентификаторСтроки");
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		ОтборЭлемента.ПравоеЗначение = ТекПоле.Значение;
		
		ЦветПодсветки = Новый Цвет(250, 0, 0);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветПодсветки);
	КонецЦикла;
	// Евросиб Фролов)
	
КонецПроцедуры	

&НаСервере
Процедура ОпределитьИдентификаторРелиза()

	Если НЕ ЗначениеЗаполнено(Объект.Заявка) 
		//ДИТ Авдеева В.С. 0282363 18.08.2022 Начало 
		Или Не ЗначениеЗаполнено(Объект.Ссылка)
		//ДИТ Авдеева В.С. 0282363 18.08.2022 Конец
		Тогда
		Возврат;
	КонецЕсли;	
		
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	РелизыКлиентовЗапросовНаКТК.ИдентификаторСтрокиЗаявки КАК ИдентификаторСтрокиЗаявки
	|ИЗ
	|	РегистрСведений.РелизыКлиентовЗапросовНаКТК КАК РелизыКлиентовЗапросовНаКТК
	|ГДЕ
	|	РелизыКлиентовЗапросовНаКТК.РелизКлиента = &РелизКлиента
	|	И РелизыКлиентовЗапросовНаКТК.Заявка = &Заявка";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("РелизКлиента", 	Объект.Ссылка);
	Запрос.УстановитьПараметр("Заявка", 		Объект.Заявка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ИдентификаторСтрокиЗаявки = Выборка.ИдентификаторСтрокиЗаявки;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура НастроитьТекстКнопкиПечати()
	
	ЗаголовокКнопки = "Запрос на терминал";
	
	Если Объект.ИзмененыКлючевыеПоля И ЗначениеЗаполнено(Объект.ДатаОтправкиЗапросаТерминалу) Тогда
		ЗаголовокКнопки = "Отправить скорректированный запрос на терминал";
	КонецЕсли;	
	
	Элементы.ФормаЗапросНаТерминал.Заголовок = ЗаголовокКнопки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОПерезаполненииПоЗапросу(Результат, Параметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

    ОбновитьДанныеИзЗапросаНаСервере();

КонецПроцедуры

//ДИТ, Беляев СЮ, Ticket#0330059, 30-10-2023, закомменитровал неиспользуемую процедуру ПроверитьУдаленныеДанныеВЗапросе()
//&НаСервере
//Процедура ПроверитьУдаленныеДанныеВЗапросе(ЕстьУдаленныеДанные)
//	
//	//ДИТ Шевченко А.В. TASK 59945 06.10.2022 -Начало
