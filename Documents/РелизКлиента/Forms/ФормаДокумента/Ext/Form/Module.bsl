&НаКлиенте
Функция ПроверитьСтрокиПоВодителям()
	
	СтрокиКвыгрузке = Новый Массив;
	//ДИТ Шевченко А.В. US 62421 TA 68370 10.04.2023 -Начало
	//Для Каждого СтрокаТЗ из Объект.ТранспортныеСредства Цикл
	//	Если ЗначениеЗаполнено(СтрокаТЗ.ФИОВодителя) И ЗначениеЗаполнено(СтрокаТЗ.РегНомерТС) Тогда
	//		СтрокиКвыгрузке.Добавить(СтрокаТЗ.ИдентификаторСтроки);
	//	КонецЕсли;		
	//КонецЦикла;
	
	МассивПроверяемыхКолонок = Новый массив;
	МассивПроверяемыхКолонок.Добавить("ФИОВодителя");
	МассивПроверяемыхКолонок.Добавить("РегНомерТС");
	МассивКлючейП = Новый Массив;
	Для Каждого Стр Из Объект.Контейнеры Цикл
		МассивКлючейП.Добавить(Стр.КлючАналитикиПеревозки);
	КонецЦикла;	
	МассивКлючей = ПроверитьСтрокиКлючейНаМиле(МассивКлючейП,ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПерваяМиля"),МассивПроверяемыхКолонок);
	
	Для Каждого МассивЗнч Из МассивКлючей Цикл
		СтрокаТЧ = Объект.Контейнеры.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки",МассивЗнч));
		СтрокиКвыгрузке.Добавить(СтрокаТЧ[0].ИдентификаторСтроки);
	КонецЦикла;
	//ДИТ Шевченко А.В. US 62421 TA 68370 10.04.2023 -Конец	
	// ДИТ US 58592 TA 60724 Евсенкин М.А. Начало: 19.12.2022
	// Было:
	//Возврат СтрокиКвыгрузке.Количество() > 0;
	//Стало:
	Если Не Объект.Автоперевозка = ПредопределенноеЗначение("Перечисление.ВариантыАвтоперевозки.НеТребуется") Тогда 
		Ответ = СтрокиКвыгрузке.Количество() > 0;                                                                                                           
	Иначе 
		Ответ = Истина;
	КонецЕсли;
	// ДИТ US 58592 TA 60724 Евсенкин М.А. Конец: 19.12.2022
	Возврат Ответ;	
КонецФункции	

