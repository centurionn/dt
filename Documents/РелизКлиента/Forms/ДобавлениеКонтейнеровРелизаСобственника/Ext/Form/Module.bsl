&НаСервере
Процедура ПолучитьСведенияПоКТК()
	
	ТекстЗапроса =
	//ДИТ Шевченко А.В. US 62421 TA 64347 01.03.23 –начало
	"ВЫБРАТЬ
	|	РелизСобственникаНоминации.Контейнер КАК Контейнер,
	|	РелизСобственникаНоминации.ТипКТК КАК ТипКТК
	|ПОМЕСТИТЬ КТК_РелизСобственника
	|ИЗ
	|	Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 –начало
	|			РелизКлиентаКонтейнеры.КлючАналитикиПеревозки.Контейнер КАК Контейнер
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 –конец
	|		ИЗ
	|			(ВЫБРАТЬ
	|				РелизКлиента.Ссылка КАК Ссылка
	|			ИЗ
	|				Документ.РелизКлиента КАК РелизКлиента
	|			ГДЕ
	|				РелизКлиента.ВыдачаОтСобственника = ИСТИНА
	|				И РелизКлиента.РелизСобственника = &РелизСобственника
	|				И РелизКлиента.ПометкаУдаления = ЛОЖЬ
	|				И НЕ РелизКлиента.Ссылка = &РелизКлиента) КАК ВложенныйЗапрос
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РелизКлиента.Контейнеры КАК РелизКлиентаКонтейнеры
	|				ПО ВложенныйЗапрос.Ссылка = РелизКлиентаКонтейнеры.Ссылка) КАК КТК_ВДругихРелизахКлиентов
	|		ПО РелизСобственникаНоминации.Контейнер = КТК_ВДругихРелизахКлиентов.Контейнер
	|ГДЕ
	|	РелизСобственникаНоминации.Ссылка = &РелизСобственника
	|	И КТК_ВДругихРелизахКлиентов.Контейнер ЕСТЬ NULL	
	|	И РелизСобственникаНоминации.Контейнер <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
	|	И НЕ РелизСобственникаНоминации.Контейнер В (&СписокКТК)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КТК_РелизСобственника.Контейнер КАК Контейнер,
	|	КТК_РелизСобственника.ТипКТК КАК ТипоразмерКТК,
	|	стоки_ТекущиеДанныеСрезПоследних.тек_Сток КАК ТекущийСток,
	|	стоки_ТекущиеДанныеСрезПоследних.тек_Статус КАК Статус,
	|	стоки_ТекущиеДанныеСрезПоследних.тек_Собственник КАК тек_Собственник,
	|	стоки_ТекущиеДанныеСрезПоследних.тек_ВидСобственности КАК тек_ВидСобственности
	|ИЗ
	|	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних КАК стоки_ТекущиеДанныеСрезПоследних
	|		ПРАВОЕ СОЕДИНЕНИЕ КТК_РелизСобственника КАК КТК_РелизСобственника
	|		ПО КТК_РелизСобственника.Контейнер = стоки_ТекущиеДанныеСрезПоследних.КТК";
	//ДИТ Шевченко А.В. US 62421 TA 64347 01.03.23 –конец
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("СписокКТК", СписокКТК);
