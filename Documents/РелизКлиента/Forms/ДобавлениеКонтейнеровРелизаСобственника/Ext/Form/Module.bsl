&НаКлиенте
Функция ПроверитьДопустимыеСимволы(СтрокаПроверки)
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("1234567890");
	МассивСтрок.Добавить("qwertyuiopasdfghjklzxcvbnm");
	МассивСтрок.Добавить("абвгдеёжзийклмнопрстуфхцчшщыьъэюя");
	МассивСтрок.Добавить(" .-");
	
	СтрокаДопустимыхСимволов = СтрСоединить(МассивСтрок);
	СтрокаДопустимыхСимволов = ВРег(СтрокаДопустимыхСимволов);
	
	Для НомерСимвола = 1 по СтрДлина(СтрокаПроверки) Цикл
		Если Найти(СтрокаДопустимыхСимволов, ВРег(Сред(СтрокаПроверки, НомерСимвола, 1))) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции		

&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

    ВыполнитьПеренос();

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПеренос()

	Результат = Новый Массив;
	КолДобавляемыхСтрок = 0;
	Для каждого СтрокаДанных из РаспознанныеДанные Цикл
		
		Если НЕ СтрокаДанных.ПеренестиВРелизКлиента Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураСведений = Новый Структура("Контейнер, ТипоразмерКТК");
		ЗаполнитьЗначенияСвойств(СтруктураСведений, СтрокаДанных);
		Результат.Добавить(СтруктураСведений);
		КолДобавляемыхСтрок = КолДобавляемыхСтрок + 1;
	КонецЦикла;
	
	Если КоличествоСтрок < КолДобавляемыхСтрок Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Количество выбранных для переноса в релиз клиента контейнеров превышает максимально возможное количество КТК по этому релизу.");
		Возврат;
	КонецЕсли;	
	
	Закрыть(Новый Структура("Результат", Результат));
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПрочитатьДанные(Неопределено);
КонецПроцедуры
