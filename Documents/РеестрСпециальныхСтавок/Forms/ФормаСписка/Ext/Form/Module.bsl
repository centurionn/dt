
&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РеестрСпециальныхСтавокРейсы.Ссылка КАК Ссылка,
		|	ЕСТЬNULL(Представление(РеестрСпециальныхСтавокРейсы.Рейс), """") КАК Рейс
		|ИЗ
		|	Документ.РеестрСпециальныхСтавок.Рейсы КАК РеестрСпециальныхСтавокРейсы
		|ГДЕ
		|	РеестрСпециальныхСтавокРейсы.Ссылка В(&Ссылка)";
	
	Запрос.УстановитьПараметр("Ссылка", Строки.ПолучитьКлючи());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтрокаСписка = Строки[Выборка.Ссылка];
		СтрокаСписка.Данные.Рейсы = Выборка.Рейс + "; " + СтрокаСписка.Данные.Рейсы;
	КонецЦикла;
	
	Для Каждого Строка Из Строки Цикл
		Строка.Значение.Данные.Рейсы = Лев(Строка.Значение.Данные.Рейсы, СтрДлина(Строка.Значение.Данные.Рейсы) - 2);
	КонецЦикла;
	
КонецПроцедуры

