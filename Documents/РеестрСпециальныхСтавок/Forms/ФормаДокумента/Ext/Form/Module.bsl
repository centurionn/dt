&НаСервере
Процедура ВвестиНадбавкиСкидкиНаСервере()
	
	Отказ = ПроверитьЗаполненностьСтавокНадбавокСкидок();
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если НадбавкиСкидки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = СтруктураПараметровПеревозкиКЗаполнению();
	
	Для Каждого СтрокаКонтрагенты Из СтруктураПараметров.МассивКонтрагентов Цикл
		Для Каждого СтрокаПунктОтправленияЖД Из СтруктураПараметров.МассивОтправленийЖД Цикл
			Для Каждого СтрокаПунктНазначенияЖД Из СтруктураПараметров.МассивНазначенийЖД Цикл
				Для Каждого СтрокаПортОтправления Из СтруктураПараметров.МассивОтправленийФрахт Цикл
					Для Каждого СтрокаПортОтгрузки Из СтруктураПараметров.МассивОтгрузокФрахт Цикл
						Для Каждого СтрокаПортНазначения Из СтруктураПараметров.МассивНазначенийФрахт Цикл
							
							ПоследняяИтерация = НайтиПоследнююИтерацию();
							
							Для Каждого СтрокаНадбавкиСкидки Из НадбавкиСкидки Цикл
								
								ЕстьСтавкиФрахт = ЗначениеЗаполнено(СтрокаНадбавкиСкидки.Ставка20Фрахт) Или ЗначениеЗаполнено(СтрокаНадбавкиСкидки.Ставка40Фрахт);
								ЕстьСтавкиЖД = ЗначениеЗаполнено(СтрокаНадбавкиСкидки.Ставка20ЖД) Или ЗначениеЗаполнено(СтрокаНадбавкиСкидки.Ставка40ЖД);
								
								Если (Не ЕстьСтавкиЖД) И (СтрокаПунктОтправленияЖД <> СтруктураПараметров.МассивОтправленийЖД[0] 
									Или СтрокаПунктНазначенияЖД <> СтруктураПараметров.МассивНазначенийЖД[0]) Тогда
									Продолжить;
								КонецЕсли;
								
								Если (Не ЕстьСтавкиФрахт) И (СтрокаПортОтправления <> СтруктураПараметров.МассивОтправленийФрахт[0] 
									Или СтрокаПортОтгрузки <> СтруктураПараметров.МассивОтгрузокФрахт[0] 
									Или СтрокаПортНазначения <> СтруктураПараметров.МассивНазначенийФрахт[0]) Тогда
									Продолжить;
								КонецЕсли;
								
								СтруктураПоиска = Новый Структура;
								СтруктураПоиска.Вставить("Контрагент", СтрокаКонтрагенты);
								СтруктураПоиска.Вставить("ПлановыйОбъемTEU", Объект.ПлановыйОбъемTEU);
								СтруктураПоиска.Вставить("ПунктОтправления", ?(ЕстьСтавкиЖД, СтрокаПунктОтправленияЖД, Справочники.Локации.ПустаяСсылка()));
								СтруктураПоиска.Вставить("ПунктНазначения", ?(ЕстьСтавкиЖД, СтрокаПунктНазначенияЖД, Справочники.Локации.ПустаяСсылка()));
								СтруктураПоиска.Вставить("ПортОтправления", ?(ЕстьСтавкиФрахт, СтрокаПортОтправления, Справочники.Локации.ПустаяСсылка()));
								СтруктураПоиска.Вставить("ПортНазначения", ?(ЕстьСтавкиФрахт, СтрокаПортНазначения, Справочники.Локации.ПустаяСсылка()));
								СтруктураПоиска.Вставить("ПортОтгрузки", ?(ЕстьСтавкиФрахт, СтрокаПортОтгрузки, Справочники.Локации.ПустаяСсылка()));
								
								ПринадлежностьСтрокой = ?(СтрокаНадбавкиСкидки.SOCCOC = Перечисления.ПринадлежностьТЕ.КТЕвросиба, "COC", "SOC");
								
								Если ЗначениеЗаполнено(СтрокаНадбавкиСкидки.Ставка20Фрахт) И СтруктураПараметров.ЕстьФрахт Тогда
									
									ТекущийТипСтавки = ?(СтрокаНадбавкиСкидки.Ставка20Фрахт < 0, Перечисления.ТипыСтавок.Скидка, Перечисления.ТипыСтавок.Надбавка);
									СтруктураПоиска.Вставить("ТипСтавки", ТекущийТипСтавки);
									
									ИмяКолонки = "НадбавкаСкидка20Фрахт" + ПринадлежностьСтрокой;
									МассивИтераций = ПолучитьИтерацииДляСлияния(СтруктураПоиска, ИмяКолонки);
									Если МассивИтераций.Количество() = 0 Тогда
										МассивИтераций.Добавить(ПоследняяИтерация + 1);
									КонецЕсли;
									
									НайденныйПараметрПеревозки = Справочники.ПараметрыПеревозки.НайтиПараметрПеревозки(Справочники.РазмерыКТК.К20, СтрокаНадбавкиСкидки.SOCCOC, СтрокаНадбавкиСкидки.ВалютаФрахт, Перечисления.ВидыТранспортныхСообщений.Море);
									
									Если ЗначениеЗаполнено(НайденныйПараметрПеревозки) Тогда
										Для Каждого ТекИтерация Из МассивИтераций Цикл
											
											ОтборБД = Новый Структура;
											Для Каждого ЭлементОтбора Из СтруктураПоиска Цикл
												ОтборБД.Вставить(ЭлементОтбора.Ключ, ЭлементОтбора.Значение);
											КонецЦикла;
											ОтборБД.Вставить("ПараметрПеревозки", НайденныйПараметрПеревозки);
											ОтборБД.Вставить("ИтерацияДобавления", ТекИтерация);
											
											НайденныеВБД = Объект.СпециальныеСтавки.НайтиСтроки(ОтборБД);
											Если НайденныеВБД.Количество() > 0 Тогда
												СтрокаТаблицыСпецСтавки = НайденныеВБД[0];
											Иначе
												СтрокаТаблицыСпецСтавки = Объект.СпециальныеСтавки.Добавить();
												СтрокаТаблицыСпецСтавки.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
												СтрокаТаблицыСпецСтавки.ИтерацияДобавления = ТекИтерация;
											КонецЕсли;
											
											СтрокаТаблицыСпецСтавки.Контрагент = СтрокаКонтрагенты;
											СтрокаТаблицыСпецСтавки.ТипСтавки = ТекущийТипСтавки;
											СтрокаТаблицыСпецСтавки.ПлановыйОбъемTEU = Объект.ПлановыйОбъемTEU;
