&НаСервере
Процедура ЗаполнитьПараметрыПеревозки(Данные)
	
	Для Каждого Структура Из Данные Цикл
		
		Если ЗначениеЗаполнено(Структура.ПлановыйОбъемTEU) Тогда
			Объект.ПлановыйОбъемTEU = Структура.ПлановыйОбъемTEU;
		КонецЕсли;
		Если ЗначениеЗаполнено(Структура.УсловияПеревозкиОтправление) Тогда
			Объект.УсловияПеревозкиОтправление = Структура.УсловияПеревозкиОтправление;
		КонецЕсли;
		Если ЗначениеЗаполнено(Структура.УсловияПеревозкиПрибытие) Тогда
			Объект.УсловияПеревозкиПрибытие = Структура.УсловияПеревозкиПрибытие;
		КонецЕсли;
		Если ЗначениеЗаполнено(Структура.УсловияПогрузки) Тогда
			Объект.УсловияПогрузки = Структура.УсловияПогрузки;
		КонецЕсли;
		Если ЗначениеЗаполнено(Структура.УсловияВыгрузки) Тогда
			Объект.УсловияВыгрузки = Структура.УсловияВыгрузки;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Структура.Контрагент) Тогда
			СтрокаТаблицы = Объект.Контрагенты.Добавить();
			СтрокаТаблицы.Контрагент = Структура.Контрагент;
		КонецЕсли;
		Если ЗначениеЗаполнено(Структура.ПунктОтправления) Тогда
			СтрокаТаблицы = Объект.ПунктыОтправленияЖД.Добавить();
			СтрокаТаблицы.ПунктОтправления = Структура.ПунктОтправления;
		КонецЕсли;
		Если ЗначениеЗаполнено(Структура.ПунктНазначения) Тогда
			СтрокаТаблицы = Объект.ПунктыНазначенияЖД.Добавить();
			СтрокаТаблицы.ПунктНазначения = Структура.ПунктНазначения;
		КонецЕсли;
		Если ЗначениеЗаполнено(Структура.ПортОтправленияФРАХТ) Тогда
			СтрокаТаблицы = Объект.ПортыОтправленияФрахт.Добавить();
			СтрокаТаблицы.ПортОтправления = Структура.ПортОтправленияФРАХТ;
		КонецЕсли;
		Если ЗначениеЗаполнено(Структура.ПортОтгрузкиФРАХТ) Тогда
			СтрокаТаблицы = Объект.ПортыОтгрузкиФрахт.Добавить();
			СтрокаТаблицы.ПортОтгрузки = Структура.ПортОтгрузкиФРАХТ;
		КонецЕсли;
		Если ЗначениеЗаполнено(Структура.ПортНазначенияФРАХТ) Тогда
			СтрокаТаблицы = Объект.ПортыНазначенияФрахт.Добавить();
			СтрокаТаблицы.ПортНазначения = Структура.ПортНазначенияФРАХТ;
		КонецЕсли;
		
	КонецЦикла;
	
	ВременнаяТаблица = Объект.Контрагенты.Выгрузить();
	ВременнаяТаблица.Свернуть("Контрагент");
	Объект.Контрагенты.Загрузить(ВременнаяТаблица);
	
	ВременнаяТаблица = Объект.ПунктыОтправленияЖД.Выгрузить();
	ВременнаяТаблица.Свернуть("ПунктОтправления");
	Объект.ПунктыОтправленияЖД.Загрузить(ВременнаяТаблица);
	
	ВременнаяТаблица = Объект.ПунктыНазначенияЖД.Выгрузить();
	ВременнаяТаблица.Свернуть("ПунктНазначения");
	Объект.ПунктыНазначенияЖД.Загрузить(ВременнаяТаблица);
	
	ВременнаяТаблица = Объект.ПортыОтправленияФрахт.Выгрузить();
	ВременнаяТаблица.Свернуть("ПортОтправления");
	Объект.ПортыОтправленияФрахт.Загрузить(ВременнаяТаблица);
	
	ВременнаяТаблица = Объект.ПортыОтгрузкиФрахт.Выгрузить();
	ВременнаяТаблица.Свернуть("ПортОтгрузки");
	Объект.ПортыОтгрузкиФрахт.Загрузить(ВременнаяТаблица);
	
	ВременнаяТаблица = Объект.ПортыНазначенияФрахт.Выгрузить();
	ВременнаяТаблица.Свернуть("ПортНазначения");
	Объект.ПортыНазначенияФрахт.Загрузить(ВременнаяТаблица);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыЗагрузкиСтавокИзExcel(РезультатМассивСтруктур, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(РезультатМассивСтруктур) = Тип("Массив") Тогда
		Для Каждого Структура Из РезультатМассивСтруктур Цикл
			СтрокаТаблицыСтавки = Ставки.Добавить();
			Если Структура.РазмерностьКТК = ПредопределенноеЗначение("Справочник.РазмерыКТК.К20") Тогда
				СтрокаТаблицыСтавки.Ставка20ЖД = Структура.СтавкаЖД;
				СтрокаТаблицыСтавки.Ставка20Фрахт = Структура.СтавкаФрахт;
				ЗаполнитьЗначенияСвойств(СтрокаТаблицыСтавки, Структура);
			Иначе
				СтрокаТаблицыСтавки.Ставка40ЖД = Структура.СтавкаЖД;
				СтрокаТаблицыСтавки.Ставка40Фрахт = Структура.СтавкаФрахт;
				ЗаполнитьЗначенияСвойств(СтрокаТаблицыСтавки, Структура);
			КонецЕсли;
		КонецЦикла;
		ВвестиСтавкиНаСервере();
		СформироватьТаблицуФормы();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьЗаполненностьСтавокНадбавокСкидок()
	
	Ответ = Ложь;
	
	ТекстСообщенияВалюта = НСтр("ru = 'Не заполнена валюта.'");
	ТекстСообщенияПринадлежность = НСтр("ru = 'Не заполнена принадлежность.'");
	
	Для Каждого СтрокаСтавок Из Ставки Цикл
		Если Не ЗначениеЗаполнено(СтрокаСтавок.SOCCOC) Тогда
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщенияПринадлежность, , "Ставки[" + Строка(Ставки.Индекс(СтрокаСтавок)) + "].SOCCOC", , Ответ);
		КонецЕсли;
		Если (ЗначениеЗаполнено(СтрокаСтавок.Ставка20ЖД) Или ЗначениеЗаполнено(СтрокаСтавок.Ставка40ЖД)) 
			И Не ЗначениеЗаполнено(СтрокаСтавок.ВалютаЖД) Тогда
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщенияВалюта, , "Ставки[" + Строка(Ставки.Индекс(СтрокаСтавок)) + "].ВалютаЖД", , Ответ);
		КонецЕсли;
		Если (ЗначениеЗаполнено(СтрокаСтавок.Ставка20Фрахт) Или ЗначениеЗаполнено(СтрокаСтавок.Ставка40Фрахт)) 
			И Не ЗначениеЗаполнено(СтрокаСтавок.ВалютаФрахт) Тогда
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщенияВалюта, , "Ставки[" + Строка(Ставки.Индекс(СтрокаСтавок)) + "].ВалютаФрахт", , Ответ);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаСтавок.ВалютаЖД)
			И (Не ЗначениеЗаполнено(СтрокаСтавок.Ставка20ЖД) И Не ЗначениеЗаполнено(СтрокаСтавок.Ставка40ЖД)) Тогда
			ТекстСообщения = НСтр("ru = 'Заполните как минимум одну из ставок ЖД.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Ставки[" + Ставки.Индекс(СтрокаСтавок) + "].Ставка20ЖД", , Ответ);
