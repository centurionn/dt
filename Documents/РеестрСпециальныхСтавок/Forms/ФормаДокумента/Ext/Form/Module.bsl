	|			И ВТ_БезИдентификатора.СтавкаНДС = ВТ_СИдентификатором.СтавкаНДС
	|			И ВТ_БезИдентификатора.СуммаВключаетНДС = ВТ_СИдентификатором.СуммаВключаетНДС
	|			И ВТ_БезИдентификатора.ИдентификаторСтроки = ВТ_СИдентификатором.ИдентификаторСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ВременнаяТаблица.Контрагент КАК Контрагент,
	|	ВТ_ВременнаяТаблица.ПлановыйОбъемTEU КАК ПлановыйОбъемTEU,
	|	ВТ_ВременнаяТаблица.ТипСтавки КАК ТипСтавки,
	|	ВТ_ВременнаяТаблица.ПунктОтправления КАК ПунктОтправления,
	|	ВТ_ВременнаяТаблица.ПунктНазначения КАК ПунктНазначения,
	|	ВТ_ВременнаяТаблица.УсловияПеревозкиОтправление КАК УсловияПеревозкиОтправление,
	|	ВТ_ВременнаяТаблица.УсловияПеревозкиПрибытие КАК УсловияПеревозкиПрибытие,
	|	ВТ_ВременнаяТаблица.ПортОтправления КАК ПортОтправления,
	|	ВТ_ВременнаяТаблица.ПортОтгрузки КАК ПортОтгрузки,
	|	ВТ_ВременнаяТаблица.ПортНазначения КАК ПортНазначения,
	|	ВТ_ВременнаяТаблица.УсловияПогрузки КАК УсловияПогрузки,
	|	ВТ_ВременнаяТаблица.УсловияВыгрузки КАК УсловияВыгрузки,
	|	ВТ_ВременнаяТаблица.СтавкаНДС КАК СтавкаНДС,
	|	ВТ_ВременнаяТаблица.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ВТ_ВременнаяТаблица.ВременныйИдентификаторСтроки КАК ВременныйИдентификаторСтроки,
	|	ВТ_ВременнаяТаблица.ПараметрПеревозки КАК ПараметрПеревозки,
	|	ВТ_ВременнаяТаблица.Ставка КАК Ставка,
	|	ВТ_ВременнаяТаблица.НадбавкаСкидка КАК НадбавкаСкидка,
	|	ВТ_ВременнаяТаблица.ЭтоПроцентОтСуммы КАК ЭтоПроцентОтСуммы,
	|	ВТ_ВременнаяТаблица.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ВТ_ВременнаяТаблица.ИтерацияДобавления КАК ИтерацияДобавления
	|ИЗ
	|	ВТ_ВременнаяТаблица КАК ВТ_ВременнаяТаблица
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВременныйИдентификаторСтроки,
	|	Контрагент,
	|	ПунктОтправления,
	|	ПунктНазначения,
	|	ПортОтправления,
	|	ПортОтгрузки,
	|	ПортНазначения
	|ИТОГИ ПО
	|	Контрагент,
	|	ПлановыйОбъемTEU,
	|	ТипСтавки";
	
	Запрос.УстановитьПараметр("ТаблицаСтавокСИдентификатором", ВыгрузкаСтавокСИдентификатором);
	Запрос.УстановитьПараметр("ТаблицаСтавок", ВыгрузкаСтавок);
	
	ВыборкаКонтрагент = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Счетчик = 1;
	
	Пока ВыборкаКонтрагент.Следующий() Цикл
		ВыборкаПлановыйОбъемTEU = ВыборкаКонтрагент.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПлановыйОбъемTEU.Следующий() Цикл
			ВыборкаТипСтавки = ВыборкаПлановыйОбъемTEU.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаТипСтавки.Следующий() Цикл
				ВыборкаДетальныеЗаписи = ВыборкаТипСтавки.Выбрать();
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					Если ВыборкаДетальныеЗаписи.ПараметрПеревозки.ВидТранспортногоСообщения = Перечисления.ВидыТранспортныхСообщений.ЖД Тогда
						ВидТранспортногоСообщения = "ЖД";
					Иначе
						ВидТранспортногоСообщения = "Фрахт";
					КонецЕсли;
					Строка = ПодобратьПодходящуюСтрокуВТаблицеФормы(ВыборкаДетальныеЗаписи, ВыборкаДетальныеЗаписи.ПараметрПеревозки, ВидТранспортногоСообщения, Истина);
					Если Строка <> Неопределено Тогда
						ЗаполнитьСтрокуРезультата(Строка, ВыборкаДетальныеЗаписи, ВидТранспортногоСообщения);
					Иначе
						НоваяСтрока = СпециальныеСтавкиФорма.Добавить();
						НоваяСтрока.НомерСтроки = Счетчик;
						НоваяСтрока.ИтерацияДобавления = ВыборкаДетальныеЗаписи.ИтерацияДобавления;
						ЗаполнитьСтрокуРезультата(НоваяСтрока, ВыборкаДетальныеЗаписи, ВидТранспортногоСообщения);
						Счетчик = Счетчик + 1;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	СинхронизироватьКалькуляцииНаФорме();
	
КонецПроцедуры

&НаСервере
Функция ПодобратьПодходящуюСтрокуВТаблицеФормы(Запись, ПараметрПеревозки, ВидТранспортногоСообщения, ПоискВТаблицеФормы = Ложь)
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Контрагент", Запись.Контрагент);
	СтруктураОтбора.Вставить("ПлановыйОбъемTEU", Запись.ПлановыйОбъемTEU);
	СтруктураОтбора.Вставить("ТипСтавки", Запись.ТипСтавки);
	СтруктураОтбора.Вставить("ПунктОтправления", Запись.ПунктОтправления);
	СтруктураОтбора.Вставить("ПунктНазначения", Запись.ПунктНазначения);
	СтруктураОтбора.Вставить("ПортОтправления", Запись.ПортОтправления);
	СтруктураОтбора.Вставить("ПортНазначения", Запись.ПортНазначения);
	СтруктураОтбора.Вставить("ПортОтгрузки", Запись.ПортОтгрузки);
	
	Если ПоискВТаблицеФормы Тогда
		СтруктураОтбора.Вставить("ИтерацияДобавления", Запись.ИтерацияДобавления);	
		НайденнаяСтрока = СпециальныеСтавкиФорма.НайтиСтроки(СтруктураОтбора);
	Иначе
		СтруктураОтбора.Вставить("ПараметрПеревозки", ПараметрПеревозки);
		НайденнаяСтрока = Объект.СпециальныеСтавки.НайтиСтроки(СтруктураОтбора);
	КонецЕсли;
	
	Возврат ?(НайденнаяСтрока.Количество() > 0, НайденнаяСтрока[0], Неопределено);
	
КонецФункции

&НаСервере
Функция НайтиПоследнююИтерацию()
	
	ПоследняяИтерация = 0;
	
	Для Каждого Строка Из Объект.СпециальныеСтавки Цикл
		Если Строка.ИтерацияДобавления > ПоследняяИтерация Тогда
			ПоследняяИтерация = Строка.ИтерацияДобавления;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПоследняяИтерация;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСтрокуРезультата(СтрокаСпециальныеСтавкиФорма, Запись, ВидыТранспортныхСообщений)
	
	СтрокаСпециальныеСтавкиФорма.ИтерацияДобавления = Запись.ИтерацияДобавления;
	СтрокаСпециальныеСтавкиФорма.Контрагент = Запись.Контрагент;
	СтрокаСпециальныеСтавкиФорма.ТипСтавки = Запись.ТипСтавки;
	СтрокаСпециальныеСтавкиФорма.ПлановыйОбъемTEU = Запись.ПлановыйОбъемTEU;
	СтрокаСпециальныеСтавкиФорма.ЭтоПроцентОтСуммы = Запись.ЭтоПроцентОтСуммы;
		
	СтрокаСпециальныеСтавкиФорма.ПунктОтправления = Запись.ПунктОтправления;
	СтрокаСпециальныеСтавкиФорма.ПунктНазначения = Запись.ПунктНазначения;
	СтрокаСпециальныеСтавкиФорма.ПортОтправления = Запись.ПортОтправления;
	СтрокаСпециальныеСтавкиФорма.ПортНазначения = Запись.ПортНазначения;
	СтрокаСпециальныеСтавкиФорма.ПортОтгрузки = Запись.ПортОтгрузки;
	СтрокаСпециальныеСтавкиФорма.УсловияПогрузки = Запись.УсловияПогрузки;
	СтрокаСпециальныеСтавкиФорма.УсловияВыгрузки = Запись.УсловияВыгрузки;
	СтрокаСпециальныеСтавкиФорма.УсловияПеревозкиОтправление = Запись.УсловияПеревозкиОтправление;
	СтрокаСпециальныеСтавкиФорма.УсловияПеревозкиПрибытие = Запись.УсловияПеревозкиПрибытие;
	СтрокаСпециальныеСтавкиФорма.ИдентификаторыСтрок.Добавить(Запись.ИдентификаторСтроки);
	
	СтрокаПоиска = Запись.ПараметрПеревозки.РазмерКТК.Наименование 
		+ ВидыТранспортныхСообщений
		+ ?(Запись.ПараметрПеревозки.ПринадлежностьТЕ = Перечисления.ПринадлежностьТЕ.КТЕвросиба, "COC", "SOC");
	
	Если СтрокаСпециальныеСтавкиФорма.ТипСтавки = Перечисления.ТипыСтавок.СпециальнаяСтавка Тогда
		СтрокаСпециальныеСтавкиФорма["Ставка" + СтрокаПоиска] = Запись.Ставка;
		СтрокаСпециальныеСтавкиФорма["СтавкаНДС" + СтрокаПоиска] = Запись.СтавкаНДС;
		СтрокаСпециальныеСтавкиФорма["СуммаВключаетНДС" + СтрокаПоиска] = Запись.СуммаВключаетНДС;
	ИначеЕсли СтрокаСпециальныеСтавкиФорма.ТипСтавки = Перечисления.ТипыСтавок.Скидка 
			Или СтрокаСпециальныеСтавкиФорма.ТипСтавки = Перечисления.ТипыСтавок.Надбавка Тогда
		СтрокаСпециальныеСтавкиФорма["НадбавкаСкидка" + СтрокаПоиска] = Запись.НадбавкаСкидка;
	КонецЕсли;
	
	Если СтрокаСпециальныеСтавкиФорма.ТипСтавки = Перечисления.ТипыСтавок.СпециальнаяСтавка Тогда
		СтрокаСпециальныеСтавкиФорма["Валюта" + ВидыТранспортныхСообщений] = Запись.ПараметрПеревозки.Валюта;
	ИначеЕсли СтрокаСпециальныеСтавкиФорма.ТипСтавки = Перечисления.ТипыСтавок.Скидка 
			Или СтрокаСпециальныеСтавкиФорма.ТипСтавки = Перечисления.ТипыСтавок.Надбавка Тогда
		СтрокаСпециальныеСтавкиФорма["ВалютаНадбавкаСкидка" + ВидыТранспортныхСообщений] = Запись.ПараметрПеревозки.Валюта;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СинхронизироватьКалькуляцииНаФорме()
	
	Для Каждого СтрокаТЧ Из СпециальныеСтавкиФорма Цикл
		СтрокаТЧ.Калькуляции20ЖДSOC.Очистить();
		СтрокаТЧ.Калькуляции20ЖДCOC.Очистить();
		СтрокаТЧ.Калькуляции40ЖДSOC.Очистить();
		СтрокаТЧ.Калькуляции40ЖДCOC.Очистить();
		СтрокаТЧ.Калькуляции20ФрахтSOC.Очистить();
		СтрокаТЧ.Калькуляции20ФрахтCOC.Очистить();
		СтрокаТЧ.Калькуляции40ФрахтSOC.Очистить();
		СтрокаТЧ.Калькуляции40ФрахтCOC.Очистить();
		
		Для Каждого Идентификатор Из СтрокаТЧ.ИдентификаторыСтрок Цикл
			Найденные = Объект.Калькуляции.НайтиСтроки(Новый Структура("ИдентификаторСтрокиСпецСтавок", Идентификатор.Значение));
			Для Каждого СтрК Из Найденные Цикл
				Если СтрК.Удалена Или Не ЗначениеЗаполнено(СтрК.ПараметрПеревозки) Тогда
					Продолжить;
				КонецЕсли;
				
				РазмерКТК = ?(СтрК.ПараметрПеревозки.РазмерКТК = Справочники.РазмерыКТК.К20, "20", "40");
				ВидТранспорта = ?(СтрК.ПараметрПеревозки.ВидТранспортногоСообщения = Перечисления.ВидыТранспортныхСообщений.ЖД, "ЖД", "Фрахт");
				Принадлежность = ?(СтрК.ПараметрПеревозки.ПринадлежностьТЕ = Перечисления.ПринадлежностьТЕ.КТКлиента, "SOC", "COC");
				
				ИмяСписка = "Калькуляции" + РазмерКТК + ВидТранспорта + Принадлежность;
				
				Если СтрокаТЧ[ИмяСписка].НайтиПоЗначению(СтрК.Калькуляция) = Неопределено Тогда
					СтрокаТЧ[ИмяСписка].Добавить(СтрК.Калькуляция);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ЗаполнитьКалькуляцииСтрокой();
	
КонецПроцедуры

&НаСервере
Процедура АктуализироватьКалькуляции(ЦелевойОбъект = Неопределено)
	
	ТекущийОбъект = ?(ЦелевойОбъект <> Неопределено, ЦелевойОбъект, Объект);
	
	Если ЗначениеЗаполнено(ТекущийОбъект.Применяется) И ТипЗнч(ТекущийОбъект.Применяется) = Тип("ДокументСсылка.ПСЦ") Тогда
		ЗаполнитьКалькуляцииНотиса();
	Иначе
		КалькуляцииНотиса.Очистить();
	КонецЕсли;
	
	ТаблицаВалидных = Новый ТаблицаЗначений;
	ТаблицаВалидных.Колонки.Добавить("ИдентификаторСтрокиСпецСтавок");
	ТаблицаВалидных.Колонки.Добавить("ПараметрПеревозки");
	ТаблицаВалидных.Колонки.Добавить("Калькуляция");
	
	Для Каждого Запись Из ТекущийОбъект.СпециальныеСтавки Цикл
		
		ЕстьЖД = ЗначениеЗаполнено(Запись.ПунктОтправления) Или ЗначениеЗаполнено(Запись.ПунктНазначения);
		ЕстьФрахт = ЗначениеЗаполнено(Запись.ПортОтправления) Или ЗначениеЗаполнено(Запись.ПортНазначения) Или ЗначениеЗаполнено(Запись.ПортОтгрузки);
		
		Размер20 = (Запись.ПараметрПеревозки.РазмерКТК = Справочники.РазмерыКТК.К20);
		ЭтоSOC   = (Запись.ПараметрПеревозки.ПринадлежностьТЕ = Перечисления.ПринадлежностьТЕ.КТКлиента);
		
		СтруктураОтбора = Новый Структура;
		
		Если Размер20 Тогда
			СтруктураОтбора.Вставить("Размер20", Истина);
		Иначе
			СтруктураОтбора.Вставить("Размер40", Истина);
		КонецЕсли;
		
		СтруктураОтбора.Вставить("ПунктОтправления", Запись.ПунктОтправления);
		СтруктураОтбора.Вставить("ПунктНазначения", Запись.ПунктНазначения);
		СтруктураОтбора.Вставить("ПортНазначения", Запись.ПортНазначения);
		СтруктураОтбора.Вставить("ПортОтгрузки", Запись.ПортОтгрузки);
		СтруктураОтбора.Вставить("ПортОтправления", Запись.ПортОтправления);
		
		Если ЕстьЖД Тогда
			СтруктураОтбора.Вставить("УсловияПеревозкиОтправление", Запись.УсловияПеревозкиОтправление);
			СтруктураОтбора.Вставить("УсловияПеревозкиПрибытие", Запись.УсловияПеревозкиПрибытие);
			
			Если Размер20 Тогда
				СтруктураОтбора.Вставить("Выбрано20ЖД", Истина);
			Иначе
				СтруктураОтбора.Вставить("Выбрано40ЖД", Истина);
			КонецЕсли;
			
			Если ЭтоSOC Тогда
				СтруктураОтбора.Вставить("SOCЖД", Истина);
			Иначе
				СтруктураОтбора.Вставить("COCЖД", Истина);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЕстьФрахт Тогда
			СтруктураОтбора.Вставить("УсловияПогрузки", Запись.УсловияПогрузки);
			СтруктураОтбора.Вставить("УсловияВыгрузки", Запись.УсловияВыгрузки);
			
			Если Размер20 Тогда
				СтруктураОтбора.Вставить("Выбрано20Фрахт", Истина);
			Иначе
				СтруктураОтбора.Вставить("Выбрано40Фрахт", Истина);
			КонецЕсли;
			
			Если ЭтоSOC Тогда
				СтруктураОтбора.Вставить("SOCФрахт", Истина);
			Иначе
				СтруктураОтбора.Вставить("COCФрахт", Истина);
			КонецЕсли;
	
		КонецЕсли;
		
		НайденныеКалькуляцииНотиса = КалькуляцииНотиса.НайтиСтроки(СтруктураОтбора);
		Для Каждого СтрокаКалькуляции Из НайденныеКалькуляцииНотиса Цикл
			НоваяСтрокаВалидных = ТаблицаВалидных.Добавить();
			НоваяСтрокаВалидных.ИдентификаторСтрокиСпецСтавок = Запись.ИдентификаторСтроки;
			НоваяСтрокаВалидных.ПараметрПеревозки = Запись.ПараметрПеревозки;
			НоваяСтрокаВалидных.Калькуляция = СтрокаКалькуляции.Калькуляция;
		КонецЦикла;
		
	КонецЦикла;
	
	Индекс = ТекущийОбъект.Калькуляции.Количество() - 1;
	Пока Индекс >= 0 Цикл
		СтрокаКалькуляции = ТекущийОбъект.Калькуляции[Индекс];
		Отбор = Новый Структура("ИдентификаторСтрокиСпецСтавок, ПараметрПеревозки, Калькуляция");
		Отбор.ИдентификаторСтрокиСпецСтавок = СтрокаКалькуляции.ИдентификаторСтрокиСпецСтавок;
		Отбор.ПараметрПеревозки = СтрокаКалькуляции.ПараметрПеревозки;
		Отбор.Калькуляция = СтрокаКалькуляции.Калькуляция;
		
		Если ТаблицаВалидных.НайтиСтроки(Отбор).Количество() = 0 Тогда
			ТекущийОбъект.Калькуляции.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
	Для Каждого СтрокаВалидных Из ТаблицаВалидных Цикл
		Отбор = Новый Структура("ИдентификаторСтрокиСпецСтавок, ПараметрПеревозки, Калькуляция");
		Отбор.ИдентификаторСтрокиСпецСтавок = СтрокаВалидных.ИдентификаторСтрокиСпецСтавок;
		Отбор.ПараметрПеревозки = СтрокаВалидных.ПараметрПеревозки;
		Отбор.Калькуляция = СтрокаВалидных.Калькуляция;
		
		Если ТекущийОбъект.Калькуляции.НайтиСтроки(Отбор).Количество() = 0 Тогда
			НоваяКалькуляция = ТекущийОбъект.Калькуляции.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяКалькуляция, СтрокаВалидных);
			НоваяКалькуляция.Удалена = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьКалькуляцииСтрокой();
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиНадбавкиСкидки(Команда)
	УдалитьПустыеСтрокиВПараметрахПеревозки();
	ВвестиНадбавкиСкидкиНаСервере();
	СвернутьТаблицуСпецСтавок();
	СформироватьТаблицуФормы();
	УпорядочитьСписокСпецСтавок();
КонецПроцедуры

&НаСервере
Функция СтруктураПараметровПеревозкиКЗаполнению()
	
	ЕстьКонтрагенты = Объект.Контрагенты.Количество() > 0;
	ЕстьОтправлениеЖД = Объект.ПунктыОтправленияЖД.Количество() > 0;
	ЕстьНазначениеЖД = Объект.ПунктыНазначенияЖД.Количество() > 0;
	ЕстьОтправление = Объект.ПортыОтправленияФрахт.Количество() > 0;
	ЕстьОтгрузка = Объект.ПортыОтгрузкиФрахт.Количество() > 0;
	ЕстьНазначение = Объект.ПортыНазначенияФрахт.Количество() > 0;
	
	МассивКонтрагентов = Новый Массив;
	Если ЕстьКонтрагенты Тогда
		Для Каждого СтрокаКонтрагенты Из Объект.Контрагенты Цикл
			МассивКонтрагентов.Добавить(СтрокаКонтрагенты.Контрагент);
		КонецЦикла;
	Иначе
		МассивКонтрагентов.Добавить(Справочники.Контрагенты.ПустаяСсылка());
	КонецЕсли;
	
	МассивОтправленийЖД = Новый Массив;
	Если ЕстьОтправлениеЖД Тогда
		Для Каждого СтрокаОтправленияЖД Из Объект.ПунктыОтправленияЖД Цикл
			МассивОтправленийЖД.Добавить(СтрокаОтправленияЖД.ПунктОтправления);
		КонецЦикла;
	Иначе
		МассивОтправленийЖД.Добавить(Справочники.Локации.ПустаяСсылка());
	КонецЕсли;
	
	МассивНазначенийЖД = Новый Массив;
	Если ЕстьНазначениеЖД Тогда
		Для Каждого СтрокаНазначенияЖД Из Объект.ПунктыНазначенияЖД Цикл
			МассивНазначенийЖД.Добавить(СтрокаНазначенияЖД.ПунктНазначения);
		КонецЦикла;
	Иначе
		МассивНазначенийЖД.Добавить(Справочники.Локации.ПустаяСсылка());
	КонецЕсли;
	
	МассивОтправленийФрахт = Новый Массив;
	Если ЕстьОтправление Тогда
		Для Каждого СтрокаОтправления Из Объект.ПортыОтправленияФрахт Цикл
			МассивОтправленийФрахт.Добавить(СтрокаОтправления.ПортОтправления);
		КонецЦикла;
	Иначе
		МассивОтправленийФрахт.Добавить(Справочники.Локации.ПустаяСсылка());
	КонецЕсли;
	
	МассивОтгрузокФрахт = Новый Массив;
	Если ЕстьОтгрузка Тогда
		Для Каждого СтрокаОтгрузки Из Объект.ПортыОтгрузкиФрахт Цикл
			МассивОтгрузокФрахт.Добавить(СтрокаОтгрузки.ПортОтгрузки);
		КонецЦикла;
	Иначе
		МассивОтгрузокФрахт.Добавить(Справочники.Локации.ПустаяСсылка());
	КонецЕсли;
	
	МассивНазначенийФрахт = Новый Массив;
	Если ЕстьНазначение Тогда
		Для Каждого СтрокаНазначения Из Объект.ПортыНазначенияФрахт Цикл
			МассивНазначенийФрахт.Добавить(СтрокаНазначения.ПортНазначения);
		КонецЦикла;
	Иначе
		МассивНазначенийФрахт.Добавить(Справочники.Локации.ПустаяСсылка());
	КонецЕсли;
	
	ЕстьФрахт = (ЕстьОтправление Или ЕстьНазначение Или ЕстьОтгрузка);
	ЕстьЖД = (ЕстьОтправлениеЖД Или ЕстьНазначениеЖД);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("МассивОтправленийЖД", МассивОтправленийЖД);
	СтруктураПараметров.Вставить("МассивНазначенийЖД", МассивНазначенийЖД);
	СтруктураПараметров.Вставить("МассивОтправленийФрахт", МассивОтправленийФрахт);
	СтруктураПараметров.Вставить("МассивОтгрузокФрахт", МассивОтгрузокФрахт);
	СтруктураПараметров.Вставить("МассивНазначенийФрахт", МассивНазначенийФрахт);
	СтруктураПараметров.Вставить("МассивКонтрагентов", МассивКонтрагентов);
	
	СтруктураПараметров.Вставить("ЕстьФрахт", ЕстьФрахт);
	СтруктураПараметров.Вставить("ЕстьЖД", ЕстьЖД);
	
	Возврат СтруктураПараметров;
	
КонецФункции

&НаКлиенте
Процедура ПунктыСпециальныхСтавокТекстПунктаРусНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
