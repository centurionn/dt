&НаКлиенте
Процедура СпециальныеСтавкиФормаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И Копирование Тогда
		НоваяСтрокаФормы = Элементы.СпециальныеСтавкиФорма.ТекущиеДанные;
		ИдентификаторыСтрокиКопирования = НоваяСтрокаФормы.ИдентификаторыСтрок.ВыгрузитьЗначения();
		НоваяСтрокаФормы.ИдентификаторыСтрок.Очистить();
		Для Каждого ИдентификаторСтроки Из ИдентификаторыСтрокиКопирования Цикл
			НайденнаяСтрока = Объект.СпециальныеСтавки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
			НоваяСтрокаОбъекта = Объект.СпециальныеСтавки.Добавить();
			НоваяСтрокаОбъекта.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
			ЗаполнитьЗначенияСвойств(НоваяСтрокаОбъекта, НайденнаяСтрока[0], , "ИдентификаторСтроки");
			НоваяСтрокаФормы.ИдентификаторыСтрок.Добавить(НоваяСтрокаОбъекта.ИдентификаторСтроки);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтозватьСогласование(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ОтменаСогласования", ЭтаФорма);
	ПоказатьВопрос(ОпОп, "Протокол будет возвращен на этап ввода, а информация о результатах согласования стерта. Продолжить?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменаСогласования(П1 = Неопределено, П2 = Неопределено) Экспорт
	
	Если П1 <> КодВозвратаДиалога.Да Тогда 
		Возврат;
	КонецЕсли;
	
	ПараметрыЗапроса = ПолучитьПараметрыМаршрутизацииНаСервере(Объект);
	РезультатЗапроса = МаршрутизацияСервер.МаршрутизироватьРеестрСпециальныхСтавок(ПараметрыЗапроса, Объект.Дата); 
	
	Для Каждого Стр Из РезультатЗапроса Цикл
		Если Не ЗначениеЗаполнено(Стр.Исполнитель) Тогда
			Продолжить;
		КонецЕсли;
		Отбор = Новый Структура("Состояние", Стр.Состояние);
		НайденныеСтроки = Объект.Состояния.НайтиСтроки(Отбор);
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл 
			НайденнаяСтрока.Исполнитель = Стр.Исполнитель;
		КонецЦикла;
	КонецЦикла;
	
	Оповещение = Новый ОписаниеОповещения("ОтменаСогласованияПродолжение", ЭтаФорма);	
	ОткрытьФорму("ОбщаяФорма.ОтзывСогласования", , ЭтаФорма, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПараметрыМаршрутизацииНаСервере(Знач Объект)
	Возврат Документы.РеестрСпециальныхСтавок.ПолучитьПараметрыМаршрутизации(Объект);
КонецФункции

&НаКлиенте
Процедура ОтменаСогласованияПродолжение(Комментарий, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Комментарий) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЗапроса = ПолучитьПараметрыМаршрутизацииНаСервере(Объект);
	РезультатЗапроса = МаршрутизацияСервер.МаршрутизироватьРеестрСпециальныхСтавок(ПараметрыЗапроса, Объект.Дата);
	
	Для Каждого Стр Из РезультатЗапроса Цикл
		
		Если Не ЗначениеЗаполнено(Стр.Исполнитель) Тогда
			Продолжить;
		КонецЕсли;
		
		Отбор = Новый Структура("Состояние", Стр.Состояние);
		НайденныеСтроки = Объект.Состояния.НайтиСтроки(Отбор);
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			НайденнаяСтрока.Исполнитель = Стр.Исполнитель;
		КонецЦикла;
		
	КонецЦикла;
	
	ВозвращаемыеЗадачи = Новый Массив;
	Если Объект.Состояния.Количество() > 0 Тогда
		СтрСостояния = Объект.Состояния[0];
		СтрСостояния.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.ВРаботе");
		СтрСостояния.ВыполнениеЗафиксировано = Ложь;
		ВозвращаемыеЗадачи.Добавить(СтрСостояния.Состояние);
	КонецЕсли;
	
	Для Сч = 1 По Объект.Состояния.Количество() - 1 Цикл
		
		Объект.Состояния[Сч].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Новый");
		Объект.Состояния[Сч].Комментарий = "";
		Если ЗначениеЗаполнено(Объект.Состояния[Сч].СтатусСогласования) Тогда
			Объект.Состояния[Сч].СтатусСогласования = ПредопределенноеЗначение("Перечисление.СтатусыСогласования.Планируется");
		КонецЕсли;
		
		Объект.Состояния[Сч].ВыполнениеЗафиксировано = Ложь;
		ВозвращаемыеЗадачи.Добавить(Объект.Состояния[Сч].Состояние);
		
	КонецЦикла;
	
	ПараметрыОтменыСогласования = Новый Структура;
	ПараметрыОтменыСогласования.Вставить("ВозвращаемыеЗадачи", ВозвращаемыеЗадачи);
	ПараметрыОтменыСогласования.Вставить("Комментарий", Комментарий);
	ЗаписатьОтменуСогласования(ПараметрыОтменыСогласования);
	
	ОбновитьПанельТекущегоПользователя();
	ОбновитьПанельСостояний();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьОтменуСогласования(ПараметрыОтменыСогласования)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекДата = ТекущаяДатаСеанса();
	ТекПользователь = Пользователи.ТекущийПользователь();
	ДанныеПроцессаСогласования = СогласованиеСервер.ПолучитьПроцессСогласованияОбъекта(Объект.Ссылка);
	
	НачатьТранзакцию();
	
	Попытка
		ПараметрыЗаписи = Новый Структура("РежимЗаписи, ИзмененыТолькоРазрешенныеПоля", РежимЗаписиДокумента.ОтменаПроведения, Истина);	
		ПараметрыЗаписи.Вставить("ВозвращаемыеЗадачи", ПараметрыОтменыСогласования.ВозвращаемыеЗадачи);
		
		Записать(ПараметрыЗаписи);
		
		МЗ = РегистрыСведений.Рецензирование.СоздатьМенеджерЗаписи();
		МЗ.ЦиклСогласования = ДанныеПроцессаСогласования.ШагЦикла;
		МЗ.РецензОбъект = Объект.Ссылка;
		МЗ.Рецензент = ТекПользователь;
		МЗ.ТаймШтамп = ТекДата;
		МЗ.Комментарии = ПараметрыОтменыСогласования.Комментарий;
		МЗ.Действие = Перечисления.СтатусыЭтапов.Отозван;
		МЗ.СтатусОбъекта = Перечисления.СтатусыСогласования.Планируется;
		Если ТекПользователь = Объект.Автор Тогда
			МЗ.РольИсполнителя = "Автор документа";
		Иначе
			
			Для Каждого Стр Из Объект.ПримененныйМаршрут.Состояния Цикл
				Если ТипЗнч(Стр.Исполнитель) = Тип("СправочникСсылка.ГруппыПользователей") Тогда
					МассивИсполнителей = Пользователи_sd_сервер.ПолучитьПользователейГруппы(Стр.Исполнитель, ТекДата, Истина);
					Если МассивИсполнителей.Найти(ТекПользователь) <> Неопределено Тогда
						МЗ.РольИсполнителя = Стр.Исполнитель; 
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			Если Не ЗначениеЗаполнено(МЗ.РольИсполнителя) Тогда
				ГруппыПользователя = Пользователи_sd_сервер.ПолучитьСписокМоихГрупп(ТекПользователь, Ложь);
				Для Каждого ГруппаПользователя Из ГруппыПользователя Цикл
					Если ТипЗнч(ГруппаПользователя) = Тип("СправочникСсылка.ГруппыПользователей")
						И ГруппаПользователя <> Справочники.ГруппыПользователей.ВсеПользователи Тогда
						МЗ.РольИсполнителя = ГруппаПользователя;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
		
		МЗ.Записать(Истина);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура СпециальныеСтавкиФормаУниверсальныйПриИзменении(Элемент)
	Если ЗаполнятьПоПервойСтроке Тогда
		ВыполнитьЗаполнениеПоПервойСтроке(Элемент);
	КонецЕсли;
КонецПроцедуры



&НаСервере
Функция ПолучитьИтерацииДляСлияния(СтруктураПоиска, ИмяКолонкиСтавки)
	
	МассивИтераций = Новый Массив;
	НайденныеСтроки = СпециальныеСтавкиФорма.НайтиСтроки(СтруктураПоиска);
	
	Для Каждого СтрокаФормы Из НайденныеСтроки Цикл
		Если Не ЗначениеЗаполнено(СтрокаФормы[ИмяКолонкиСтавки]) Тогда
			МассивИтераций.Добавить(СтрокаФормы.ИтерацияДобавления);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивИтераций;
	
КонецФункции

&НаСервере
Процедура ВвестиСтавкиНаСервере()
	
	Отказ = ПроверитьЗаполненностьСтавокНадбавокСкидок();
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Ставки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = СтруктураПараметровПеревозкиКЗаполнению();
	
	Для Каждого СтрокаКонтрагенты Из СтруктураПараметров.МассивКонтрагентов Цикл
		Для Каждого СтрокаПунктОтправленияЖД Из СтруктураПараметров.МассивОтправленийЖД Цикл
			Для Каждого СтрокаПунктНазначенияЖД Из СтруктураПараметров.МассивНазначенийЖД Цикл
				Для Каждого СтрокаПортОтправления Из СтруктураПараметров.МассивОтправленийФрахт Цикл
					Для Каждого СтрокаПортОтгрузки Из СтруктураПараметров.МассивОтгрузокФрахт Цикл
						Для Каждого СтрокаПортНазначения Из СтруктураПараметров.МассивНазначенийФрахт Цикл
							
							ПоследняяИтерация = НайтиПоследнююИтерацию();
							
							Для Каждого СтрокаСтавок Из Ставки Цикл
								
								ЕстьСтавкиФрахт = ЗначениеЗаполнено(СтрокаСтавок.Ставка20Фрахт) Или ЗначениеЗаполнено(СтрокаСтавок.Ставка40Фрахт);
								ЕстьСтавкиЖД = ЗначениеЗаполнено(СтрокаСтавок.Ставка20ЖД) Или ЗначениеЗаполнено(СтрокаСтавок.Ставка40ЖД);
								
								Если (Не ЕстьСтавкиЖД) И (СтрокаПунктОтправленияЖД <> СтруктураПараметров.МассивОтправленийЖД[0] 
									Или СтрокаПунктНазначенияЖД <> СтруктураПараметров.МассивНазначенийЖД[0]) Тогда
									Продолжить;
								КонецЕсли;
								
								Если (Не ЕстьСтавкиФрахт) И (СтрокаПортОтправления <> СтруктураПараметров.МассивОтправленийФрахт[0] 
									Или СтрокаПортОтгрузки <> СтруктураПараметров.МассивОтгрузокФрахт[0] 
									Или СтрокаПортНазначения <> СтруктураПараметров.МассивНазначенийФрахт[0]) Тогда
									Продолжить;
								КонецЕсли;
								
								СтруктураПоиска = Новый Структура;
								СтруктураПоиска.Вставить("Контрагент", СтрокаКонтрагенты);
								СтруктураПоиска.Вставить("ПлановыйОбъемTEU", Объект.ПлановыйОбъемTEU);
								СтруктураПоиска.Вставить("ТипСтавки", Перечисления.ТипыСтавок.СпециальнаяСтавка);
								СтруктураПоиска.Вставить("ПунктОтправления", ?(ЕстьСтавкиЖД, СтрокаПунктОтправленияЖД, Справочники.Локации.ПустаяСсылка()));
								СтруктураПоиска.Вставить("ПунктНазначения", ?(ЕстьСтавкиЖД, СтрокаПунктНазначенияЖД, Справочники.Локации.ПустаяСсылка()));
								СтруктураПоиска.Вставить("ПортОтправления", ?(ЕстьСтавкиФрахт, СтрокаПортОтправления, Справочники.Локации.ПустаяСсылка()));
								СтруктураПоиска.Вставить("ПортНазначения", ?(ЕстьСтавкиФрахт, СтрокаПортНазначения, Справочники.Локации.ПустаяСсылка()));
								СтруктураПоиска.Вставить("ПортОтгрузки", ?(ЕстьСтавкиФрахт, СтрокаПортОтгрузки, Справочники.Локации.ПустаяСсылка()));
								
								ПринадлежностьСтрокой = ?(СтрокаСтавок.SOCCOC = Перечисления.ПринадлежностьТЕ.КТЕвросиба, "COC", "SOC");
								
								Если ЗначениеЗаполнено(СтрокаСтавок.Ставка20Фрахт) И СтруктураПараметров.ЕстьФрахт Тогда
									
									ИмяКолонки = "Ставка20Фрахт" + ПринадлежностьСтрокой;
									МассивИтераций = ПолучитьИтерацииДляСлияния(СтруктураПоиска, ИмяКолонки);
									Если МассивИтераций.Количество() = 0 Тогда
										МассивИтераций.Добавить(ПоследняяИтерация + 1);
									КонецЕсли;
									
									НайденныйПараметрПеревозки = Справочники.ПараметрыПеревозки.НайтиПараметрПеревозки(Справочники.РазмерыКТК.К20, СтрокаСтавок.SOCCOC, СтрокаСтавок.ВалютаФрахт, Перечисления.ВидыТранспортныхСообщений.Море);
									
									Если ЗначениеЗаполнено(НайденныйПараметрПеревозки) Тогда
										Для Каждого ТекИтерация Из МассивИтераций Цикл
											
											ОтборБД = Новый Структура;
											Для Каждого ЭлементОтбора Из СтруктураПоиска Цикл
												ОтборБД.Вставить(ЭлементОтбора.Ключ, ЭлементОтбора.Значение);
											КонецЦикла;
											ОтборБД.Вставить("ПараметрПеревозки", НайденныйПараметрПеревозки);
											ОтборБД.Вставить("ИтерацияДобавления", ТекИтерация);
											
											НайденныеВБД = Объект.СпециальныеСтавки.НайтиСтроки(ОтборБД);
											Если НайденныеВБД.Количество() > 0 Тогда
												СтрокаТаблицыСпецСтавки = НайденныеВБД[0];
											Иначе
												СтрокаТаблицыСпецСтавки = Объект.СпециальныеСтавки.Добавить();
												СтрокаТаблицыСпецСтавки.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
												СтрокаТаблицыСпецСтавки.ИтерацияДобавления = ТекИтерация;
											КонецЕсли;
											
											СтрокаТаблицыСпецСтавки.Контрагент = СтрокаКонтрагенты;
											СтрокаТаблицыСпецСтавки.ТипСтавки = Перечисления.ТипыСтавок.СпециальнаяСтавка;
											СтрокаТаблицыСпецСтавки.ПлановыйОбъемTEU = Объект.ПлановыйОбъемTEU;
											Если ЕстьСтавкиЖД Тогда
												СтрокаТаблицыСпецСтавки.ПунктОтправления = СтрокаПунктОтправленияЖД;
												СтрокаТаблицыСпецСтавки.ПунктНазначения = СтрокаПунктНазначенияЖД;
												СтрокаТаблицыСпецСтавки.УсловияПеревозкиОтправление = Объект.УсловияПеревозкиОтправление;
												СтрокаТаблицыСпецСтавки.УсловияПеревозкиПрибытие = Объект.УсловияПеревозкиПрибытие;
											КонецЕсли;
											СтрокаТаблицыСпецСтавки.ПортОтправления = СтрокаПортОтправления;
											СтрокаТаблицыСпецСтавки.ПортОтгрузки = СтрокаПортОтгрузки;
											СтрокаТаблицыСпецСтавки.ПортНазначения = СтрокаПортНазначения;
											СтрокаТаблицыСпецСтавки.Ставка = СтрокаСтавок.Ставка20Фрахт;
											СтрокаТаблицыСпецСтавки.ПараметрПеревозки = НайденныйПараметрПеревозки;
											СтрокаТаблицыСпецСтавки.УсловияПогрузки = Объект.УсловияПогрузки;
											СтрокаТаблицыСпецСтавки.УсловияВыгрузки = Объект.УсловияВыгрузки;
											СтрокаТаблицыСпецСтавки.СуммаВключаетНДС = Объект.СуммаВключаетНДС;
											СтрокаТаблицыСпецСтавки.СтавкаНДС = Объект.СтавкаНДС;
										КонецЦикла;
									КонецЕсли;
								КонецЕсли;
								
								Если ЗначениеЗаполнено(СтрокаСтавок.Ставка40Фрахт) И СтруктураПараметров.ЕстьФрахт Тогда
									
									ИмяКолонки = "Ставка40Фрахт" + ПринадлежностьСтрокой;
									МассивИтераций = ПолучитьИтерацииДляСлияния(СтруктураПоиска, ИмяКолонки);
									Если МассивИтераций.Количество() = 0 Тогда
										МассивИтераций.Добавить(ПоследняяИтерация + 1);
									КонецЕсли;
									
									НайденныйПараметрПеревозки = Справочники.ПараметрыПеревозки.НайтиПараметрПеревозки(Справочники.РазмерыКТК.К40, СтрокаСтавок.SOCCOC, СтрокаСтавок.ВалютаФрахт, Перечисления.ВидыТранспортныхСообщений.Море);
									
									Если ЗначениеЗаполнено(НайденныйПараметрПеревозки) Тогда
										Для Каждого ТекИтерация Из МассивИтераций Цикл
											
											ОтборБД = Новый Структура;
