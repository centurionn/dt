
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);

	ФонВыполненногоСостояния = ЦветаСтиля.ФонВыполненногоСостояния;
	ФонБудущегоСостояния = ЦветаСтиля.ФонБудущегоСостояния;
	ЦветКнопки_Исходный = Элементы.ЗаполнятьПоПервойСтроке.ЦветФона;
	ЦветКнопки_Выделенный = WebЦвета.Розовый;
	ОбновитьПанельТекущегоПользователя();
	ОбновитьПанельСостояний();
	
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	
	НастроитьКолонкиТаблицыСпециальныхСтавок();
		
	СтатусДокументаПервичный = ТекущийИсполнитель_Статус;
	СостояниеДокументаПервичное = ТекущийИсполнитель_Состояние;
	
	Если ЗначениеЗаполнено(Объект.Применяется) 
		И ТипЗнч(Объект.Применяется) = Тип("ДокументСсылка.ПСЦ") Тогда
		ЗаполнитьКалькуляцииНотиса();
		Элементы.ВидПеревозки.ТолькоПросмотр = Истина;
		Элементы.НаправлениеПеревозки.ТолькоПросмотр = Истина;
		Элементы.РейсыРейсы.ТолькоПросмотр = Истина;
		Элементы.ДобавитьРейс.Доступность = Ложь;
	КонецЕсли;
	
	ПользовательСПолнымиПравами = РольДоступна("ПолныеПрава");
	Элементы.ГруппаПечать.Видимость = ПользовательСПолнымиПравами;
	Элементы.ГруппаОтладка.Видимость = ПользовательСПолнымиПравами;
	Элементы.ГруппаСостояния.ТолькоПросмотр = Не ПользовательСПолнымиПравами;
	
	ПользовательСПравами = РольДоступна("dc_СозданиеРедактированиеДокументовСпециальнаяСтавка");
	Если Не ПользовательСПравами И Не ПользовательСПолнымиПравами Тогда
		Элементы.ВставкаПараметровПеревозкиИзEXCEL.Доступность = Ложь;
		Элементы.ВставкаСтавокИзEXCEL.Доступность = Ложь;
		Элементы.ОчиститьПараметры.Доступность = Ложь;
		Элементы.Ставки.ТолькоПросмотр = Истина;
		Элементы.НадбавкиСкидки.ТолькоПросмотр = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	
	ПериодДействия.ДатаНачала = Объект.НачалоДействия;
	ПериодДействия.ДатаОкончания = Объект.ОкончаниеДействия;
	
	СформироватьТаблицуФормы();
	
	ЗаполнитьКалькуляцииСтрокой();
	УпорядочитьСписокСпецСтавок();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПодсвечиваниеПолейОбъектов.НастроитьПодсвечиваниеПолей(ТекущийОбъект, ИмяФормы, ЭтаФорма, УсловноеОформление);	

	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	
	УпорядочитьСписокСпецСтавок();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Объект.НачалоДействия = ПериодДействия.ДатаНачала;
	Объект.ОкончаниеДействия = ПериодДействия.ДатаОкончания;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если Не ЗначениеЗаполнено(СостояниеДокументаПервичное) Тогда
		СостояниеДокументаПервичное = ТекущийИсполнитель_Состояние;
	КонецЕсли;
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("СостояниеДокументаПервичное", СостояниеДокументаПервичное);
	ТекущийОбъект.ДополнительныеСвойства.Вставить("СтатусДокументаПервичный", СтатусДокументаПервичный);
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ТекущийСтатус", ТекущийИсполнитель_Статус);
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ЗаписьИзФормы", Истина);
	
	АктуализироватьКалькуляции(ТекущийОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ОбновитьПанельТекущегоПользователя();
	ОбновитьПанельСостояний();
	
	ПодсвечиваниеПолейОбъектов.НастроитьПодсвечиваниеПолей(ТекущийОбъект, ИмяФормы, ЭтаФорма, УсловноеОформление);
	
	СинхронизироватьКалькуляцииНаФорме();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ТипЗнч(Объект.Применяется) = Тип("ДокументСсылка.ПСЦ") Тогда
		ПроверяемыеРеквизиты.Добавить("ПериодДействия");
	Иначе
		ПроверяемыеРеквизиты.Добавить("ВидПеревозки");
	КонецЕсли;
	
	ПроверитьЗаполненностьТаблицыСпецСтавок(Отказ);
	
	ПроверитьДублиСтрок(НаименованияКолонокДляПроверки(), Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ТребуетсяПеречитатьУказанныйДокумент" И Параметр = Объект.Ссылка Тогда
		ЭтаФорма.Прочитать();
		ОбновитьПанельТекущегоПользователя();
		ОбновитьПанельСостояний();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	
	Если Команда.Имя = "ПодменюПечатьОбычное_СпециальноеПредложение" Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ДокументСсылка", Объект.Ссылка);
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Команда", Команда);
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПриЗакрытииФормыВыбораКлиента", ЭтаФорма, ДополнительныеПараметры);
	
		ОткрытьФорму("Документ.РеестрСпециальныхСтавок.Форма.ФормаВыбораКлиента", ПараметрыФормы, ЭтаФорма, , , ,
															ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыВыбораКлиента(ВыбранныеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеЗначение <> Неопределено Тогда
		ВыбранныеКонтрагенты.ЗагрузитьЗначения(ВыбранныеЗначение);
	Иначе
		Возврат;
	КонецЕсли;
	
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, ДополнительныеПараметры.Команда, Объект);
	
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат)
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Объект, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры

