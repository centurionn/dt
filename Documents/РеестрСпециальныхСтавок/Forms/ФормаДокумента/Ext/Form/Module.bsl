&НаСервере
Процедура ПроверитьДублиСтрок(ПроверяемыеРеквизиты, Отказ)
	
	ТаблицаДокумента = СпециальныеСтавкиФорма.Выгрузить();
	
	СоответствиеКлючей = Новый Соответствие;
	
	Для Каждого СтрокаТЧ Из ТаблицаДокумента Цикл
		
		Ключ = "";
		Стр = СокрЛП(ПроверяемыеРеквизиты);
		Пока СтрНайти(Стр, ",") > 0 Цикл
			НаимРеквизита = СокрЛП(Лев(Стр, СтрНайти(Стр, ",") - 1));
			Стр = Прав(Стр, СтрДлина(Стр) - СтрНайти(Стр, ","));
			
			Значение = СтрокаТЧ[НаимРеквизита];
			Ключ = Ключ + "|" + Строка(Значение);
		КонецЦикла;
		
		ПоследнийРеквизит = СокрЛП(Стр);
		Значение = СтрокаТЧ[ПоследнийРеквизит];
		Ключ = Ключ + "|" + Строка(Значение);
		
		СписокНомеров = СоответствиеКлючей[Ключ];
		Если СписокНомеров = Неопределено Тогда
			СписокНомеров = Новый СписокЗначений;
			СоответствиеКлючей.Вставить(Ключ, СписокНомеров);
		КонецЕсли;
		
		СписокНомеров.Добавить(СтрокаТЧ.НомерСтроки);
		
	КонецЦикла;
	
	Для Каждого КлючИзСоответствия Из СоответствиеКлючей Цикл
		
		СписокНомеров = КлючИзСоответствия.Значение;
		
		Если СписокНомеров.Количество() > 1 Тогда
			
			НомераСтрок = "";
			Для Каждого Номер Из СписокНомеров Цикл
				Если НомераСтрок <> "" Тогда
					НомераСтрок = НомераСтрок + ", ";
				КонецЕсли;
				НомераСтрок = НомераСтрок + Номер.Значение;
			КонецЦикла;
			
			СтрокаДляПримера = Неопределено;
			Для Каждого СтрокаТЧ Из ТаблицаДокумента Цикл
				КлючСтроки = "";
				Стр = СокрЛП(ПроверяемыеРеквизиты);
				Пока СтрНайти(Стр, ",") > 0 Цикл
					НаимРеквизита = СокрЛП(Лев(Стр, СтрНайти(Стр, ",") - 1));
					Стр = Прав(Стр, СтрДлина(Стр) - СтрНайти(Стр, ","));
					КлючСтроки = КлючСтроки + "|" + Строка(СтрокаТЧ[НаимРеквизита]);
				КонецЦикла;
				ПоследнийРеквизит = СокрЛП(Стр);
				КлючСтроки = КлючСтроки + "|" + Строка(СтрокаТЧ[ПоследнийРеквизит]);
				
				Если КлючСтроки = КлючИзСоответствия.Ключ Тогда
					СтрокаДляПримера = СтрокаТЧ;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если СтрокаДляПримера <> Неопределено Тогда
				
				Стр = СокрЛП(ПроверяемыеРеквизиты);
				Пока СтрНайти(Стр, ",") > 0 Цикл
					НаимРеквизита = СокрЛП(Лев(Стр, СтрНайти(Стр, ",") - 1));
					Стр = Прав(Стр, СтрДлина(Стр) - СтрНайти(Стр, ","));
				КонецЦикла; 
				
				ПоследнийРеквизит = СокрЛП(Стр);
				ЗначениеПоследнего = СтрокаДляПримера[ПоследнийРеквизит];
				Если ЗначениеПоследнего = Неопределено Тогда
					ЗначениеПоследнего = "";
				КонецЕсли;
				
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Найдены дубли строк, повторяющиеся строки : " + НомераСтрок;
				Сообщение.Сообщить();
				
				Отказ = Истина;
				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

