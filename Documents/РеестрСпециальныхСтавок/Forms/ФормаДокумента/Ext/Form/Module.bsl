Процедура СпециальныеСтавкиФормаПередУдалением(Элемент, Отказ)
	
	СпециальныеСтавкиФормаПередУдалениемНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СпециальныеСтавкиФормаПередУдалениемНаСервере()
	
	МассивУдаляемыхСтрок = Элементы.СпециальныеСтавкиФорма.ВыделенныеСтроки; 
	КоличествоСтрок = МассивУдаляемыхСтрок.Количество();
	Пока КоличествоСтрок > 0 Цикл
		НайденнаяСтрока = СпециальныеСтавкиФорма.НайтиПоИдентификатору(МассивУдаляемыхСтрок[КоличествоСтрок - 1]);
		Для Каждого Идентификатор Из НайденнаяСтрока.ИдентификаторыСтрок Цикл
			
			Отбор = Новый Структура("ИдентификаторСтроки", Идентификатор.Значение);
			НайденныеСтроки = Объект.СпециальныеСтавки.НайтиСтроки(Отбор);
			Для Каждого Строка Из НайденныеСтроки Цикл
				ИндексСтроки = Объект.СпециальныеСтавки.Индекс(Строка);
				Объект.СпециальныеСтавки.Удалить(ИндексСтроки);
			КонецЦикла;
			
			ОтборКалькуляций = Новый Структура("ИдентификаторСтрокиСпецСтавок", Идентификатор.Значение);
			НайденныеКалькуляции = Объект.Калькуляции.НайтиСтроки(ОтборКалькуляций);
			Для Каждого СтрКальк Из НайденныеКалькуляции Цикл
				Объект.Калькуляции.Удалить(Объект.Калькуляции.Индекс(СтрКальк));
			КонецЦикла;
			
		КонецЦикла;
		КоличествоСтрок = КоличествоСтрок - 1;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПрименяетсяНотис(Значение)
	
	РеквизитыПСЦ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Значение, "ВидПеревозки, 
																		|НаправлениеНотиса, 
																		|НачалоДействия, 
																		|ПунктыПСЦ, 
																		|ОкончаниеДействия");
	Объект.ВидПеревозки = РеквизитыПСЦ.ВидПеревозки;
	Объект.НаправлениеПеревозки = РеквизитыПСЦ.НаправлениеНотиса;
	Объект.НачалоДействия = РеквизитыПСЦ.НачалоДействия;
	Объект.ОкончаниеДействия = РеквизитыПСЦ.ОкончаниеДействия;
	Объект.ПунктыПечатиСпециальныхСтавок.Загрузить(РеквизитыПСЦ.ПунктыПСЦ.Выгрузить());
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименяетсяПриИзменении(Элемент  = Неопределено)
	
	Модифицированность = Истина;
	
	Если ТипЗнч(Объект.Применяется) = Тип("ДокументСсылка.ПСЦ") Тогда
		Элементы.ВидПеревозки.ТолькоПросмотр = Истина;
		Элементы.НаправлениеПеревозки.ТолькоПросмотр = Истина;
		ПериодДействия.ДатаНачала = Объект.НачалоДействия;
		ПериодДействия.ДатаОкончания = Объект.ОкончаниеДействия;
		Элементы.РейсыРейсы.ТолькоПросмотр = Истина;
		Элементы.ДобавитьРейс.Доступность = Ложь;
		Объект.Рейсы.Очистить();
	Иначе
		Элементы.ВидПеревозки.ТолькоПросмотр = Ложь;
		Элементы.ВидПеревозки.АвтоОтметкаНезаполненного = Истина;
		Элементы.НаправлениеПеревозки.ТолькоПросмотр = Ложь;
		Элементы.РейсыРейсы.ТолькоПросмотр = Ложь;
		ДоступныеТипы = Новый Массив;
		ДоступныеТипы.Добавить(Тип("СправочникСсылка.РейсыЖД"));
		ДоступныеТипы.Добавить(Тип("СправочникСсылка.РейсыМоре"));
		Элементы.РейсыРейсы.ОграничениеТипа = Новый ОписаниеТипов(ДоступныеТипы);
		Элементы.ДобавитьРейс.Доступность = Истина;
		Объект.ПунктыПечатиСпециальныхСтавок.Очистить();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СпециальныеСтавкиФормаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СпециальныеСтавкиФорма.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяПоляФормы = СтрЗаменить(Элементы.СпециальныеСтавкиФорма.ТекущийЭлемент.Имя, "СпециальныеСтавкиФорма", "");
	
	ИзменениеКолонкиДоступно(ТекущиеДанные, ИмяПоляФормы);
	Если ЗаполнятьПоПервойСтрокеНевозможно Тогда
		ТекстСообщения = НСтр("ru = 'Для изменения этого поля необходимо изменить тип ставки.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ,
			"СпециальныеСтавкиФорма[" + Строка(ТекущиеДанные.НомерСтроки - 1) + "].ТипСтавки");
		ТекущиеДанные[ИмяПоляФормы] = Неопределено;
		Возврат;
	КонецЕсли;
	
	СпециальныеСтавкиФормаПриИзмененииНаСервере(ИмяПоляФормы);
	
КонецПроцедуры

&НаСервере
Процедура СпециальныеСтавкиФормаПриИзмененииНаСервере(ИмяПоляФормы)
	
	ИдентификаторСтроки = Элементы.СпециальныеСтавкиФорма.ТекущаяСтрока;
	ТекущиеДанные = СпециальныеСтавкиФорма.НайтиПоИдентификатору(ИдентификаторСтроки);
	ЗначениеДляЗаполнения = ТекущиеДанные[ИмяПоляФормы];
	
	ЭтоКолонкаСтавки = ((СтрНайти(ИмяПоляФормы, "20") > 0 Или СтрНайти(ИмяПоляФормы, "40") > 0)
					 И (СтрНайти(ИмяПоляФормы, "SOC") > 0 Или СтрНайти(ИмяПоляФормы, "COC") > 0));
	
	ИмяПоляТабличнойЧасти = ИмяПоляФормы;
	ПараметрПеревозки = Неопределено;
	
	Если ЭтоКолонкаСтавки Тогда

		Если СтрНайти(ИмяПоляФормы, "СтавкаНДС") > 0 Тогда
			ИмяПоляТабличнойЧасти = "СтавкаНДС";
		ИначеЕсли СтрНайти(ИмяПоляФормы, "Ставка") > 0 Тогда
			ИмяПоляТабличнойЧасти = "Ставка";
		ИначеЕсли СтрНайти(ИмяПоляФормы, "СуммаВключаетНДС") > 0 Тогда
			ИмяПоляТабличнойЧасти = "СуммаВключаетНДС";
		ИначеЕсли СтрНайти(ИмяПоляФормы, "НадбавкаСкидка") > 0 Тогда
			ИмяПоляТабличнойЧасти = "НадбавкаСкидка";
		ИначеЕсли СтрНайти(ИмяПоляФормы, "Калькуляции") > 0 Тогда
			ИмяПоляТабличнойЧасти = СтрЗаменить(ИмяПоляТабличнойЧасти, "Строкой", "");
		КонецЕсли;
		
		ПараметрПеревозки = РазложитьСтрокуНаПараметрПеревозки(ИмяПоляФормы, ТекущиеДанные);
		
		СтрокаНашлась = Ложь;
		Для Каждого Идентификатор Из ТекущиеДанные.ИдентификаторыСтрок Цикл
			СтруктураОтбора = Новый Структура("ИдентификаторСтроки, ПараметрПеревозки");
			СтруктураОтбора.ИдентификаторСтроки = Идентификатор.Значение;
			СтруктураОтбора.ПараметрПеревозки = ПараметрПеревозки;
			
			НайденнаяСтрока = Объект.СпециальныеСтавки.НайтиСтроки(СтруктураОтбора);
			Если НайденнаяСтрока.Количество() > 0 Тогда
				НайденнаяСтрока[0][ИмяПоляТабличнойЧасти] = ЗначениеДляЗаполнения;
				СтрокаНашлась = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если Не СтрокаНашлась И ЗначениеЗаполнено(ЗначениеДляЗаполнения) Тогда
			НоваяСтрока = Объект.СпециальныеСтавки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущиеДанные);
			НоваяСтрока[ИмяПоляТабличнойЧасти] = ЗначениеДляЗаполнения;
			НоваяСтрока.ПараметрПеревозки = ПараметрПеревозки;
			НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
			ТекущиеДанные.ИдентификаторыСтрок.Добавить(НоваяСтрока.ИдентификаторСтроки);
		КонецЕсли;
		
	Иначе

		Для Каждого Идентификатор Из ТекущиеДанные.ИдентификаторыСтрок Цикл
			НайденнаяСтрока = Объект.СпециальныеСтавки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", Идентификатор.Значение));
			Если НайденнаяСтрока.Количество() > 0 Тогда
				
				СтрБД = НайденнаяСтрока[0];
				
				Если СтрНайти(ИмяПоляФормы, "Валюта") = 1 Тогда
					СтарыйПараметр = СтрБД.ПараметрПеревозки;
					
					Если ЗначениеЗаполнено(СтарыйПараметр) Тогда
						ЭтоФрахт = (СтарыйПараметр.ВидТранспортногоСообщения = Перечисления.ВидыТранспортныхСообщений.Море);
						ЭтоЖД = (СтарыйПараметр.ВидТранспортногоСообщения = Перечисления.ВидыТранспортныхСообщений.ЖД);
						ЭтоНадбавкаСкидка = (СтрБД.ТипСтавки = Перечисления.ТипыСтавок.Надбавка Или СтрБД.ТипСтавки = Перечисления.ТипыСтавок.Скидка);
						
						ОбновлятьПараметр = Ложь;
						Если ИмяПоляФормы = "ВалютаФрахт" 
							И ЭтоФрахт 
							И Не ЭтоНадбавкаСкидка Тогда 
							ОбновлятьПараметр = Истина;
						КонецЕсли;
						Если ИмяПоляФормы = "ВалютаЖД"
							И ЭтоЖД 
							И Не ЭтоНадбавкаСкидка Тогда
							ОбновлятьПараметр = Истина;
						КонецЕсли;
						Если ИмяПоляФормы = "ВалютаНадбавкаСкидкаФрахт" 
							И ЭтоФрахт 
							И ЭтоНадбавкаСкидка Тогда
							ОбновлятьПараметр = Истина;
						КонецЕсли;
						Если ИмяПоляФормы = "ВалютаНадбавкаСкидкаЖД" 
							И ЭтоЖД 
							И ЭтоНадбавкаСкидка Тогда
							ОбновлятьПараметр = Истина;
						КонецЕсли;
						
						Если ОбновлятьПараметр Тогда
							НовыйПараметр = Справочники.ПараметрыПеревозки.НайтиПараметрПеревозки(
								СтарыйПараметр.РазмерКТК,
								СтарыйПараметр.ПринадлежностьТЕ,
								ЗначениеДляЗаполнения,
								СтарыйПараметр.ВидТранспортногоСообщения
							);
							СтрБД.ПараметрПеревозки = НовыйПараметр;
						КонецЕсли;
					КонецЕсли;
					
				Иначе
					СтрБД[ИмяПоляФормы] = ЗначениеДляЗаполнения;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ОбновитьНумерациюСтрокТаблицыСпецСтавок();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗаполнениеПоПервойСтроке(Элемент = Неопределено)
	
	ТекДанные = Элементы.СпециальныеСтавкиФорма.ТекущиеДанные;
	
	Если ТекДанные <> Неопределено Тогда
	
		ИмяПоляФормы = Сред(Элемент.Имя, 23);
		
		ИзменениеКолонкиДоступно(ТекДанные, ИмяПоляФормы);
		Если ЗаполнятьПоПервойСтрокеНевозможно Тогда
			ЗаполнятьПоПервойСтрокеНевозможно = Ложь;
			Возврат;
		КонецЕсли;
		
		ИдентификаторСтроки = Элементы.СпециальныеСтавкиФорма.ТекущаяСтрока;
		ТекДанные = СпециальныеСтавкиФорма.НайтиПоИдентификатору(ИдентификаторСтроки);
		
		ВыполнитьЗаполнениеПоПервойСтрокеНаСервере(ИмяПоляФормы);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьЗаполнениеПоПервойСтрокеНаСервере(ИмяПоляФормы)
	
	ИдентификаторСтроки = Элементы.СпециальныеСтавкиФорма.ТекущаяСтрока;
	ТекДанные = СпециальныеСтавкиФорма.НайтиПоИдентификатору(ИдентификаторСтроки);
	ЗначениеДляЗаполнения = ТекДанные[ИмяПоляФормы];
	
	ЭтоКолонкаСтавки = ((СтрНайти(ИмяПоляФормы, "20") > 0 Или СтрНайти(ИмяПоляФормы, "40") > 0)
					 И (СтрНайти(ИмяПоляФормы, "SOC") > 0 Или СтрНайти(ИмяПоляФормы, "COC") > 0));
	
	ИмяПоляТабличнойЧасти = ИмяПоляФормы;
	ПараметрПеревозки = Неопределено;
	
	Если ЭтоКолонкаСтавки Тогда
		Если СтрНайти(ИмяПоляФормы, "СтавкаНДС") > 0 Тогда
			ИмяПоляТабличнойЧасти = "СтавкаНДС";
		ИначеЕсли СтрНайти(ИмяПоляФормы, "Ставка") > 0 Тогда
			ИмяПоляТабличнойЧасти = "Ставка";
		ИначеЕсли СтрНайти(ИмяПоляФормы, "СуммаВключаетНДС") > 0 Тогда
			ИмяПоляТабличнойЧасти = "СуммаВключаетНДС";
		ИначеЕсли СтрНайти(ИмяПоляФормы, "НадбавкаСкидка") > 0 Тогда
			ИмяПоляТабличнойЧасти = "НадбавкаСкидка";
		КонецЕсли;
		
		ПараметрПеревозки = РазложитьСтрокуНаПараметрПеревозки(ИмяПоляФормы, ТекДанные);
	КонецЕсли;
	
	ИндексСледующейСтроки = СпециальныеСтавкиФорма.Индекс(ТекДанные) + 1;
	ИндексПоследнейСтроки = СпециальныеСтавкиФорма.Количество() - 1;
	
	ПоследняяИтерация = НайтиПоследнююИтерацию();
	
	Для ИндексСтроки = ИндексСледующейСтроки По ИндексПоследнейСтроки Цикл
		СтрокаТЧ = СпециальныеСтавкиФорма[ИндексСтроки];
		
		Если СтрокаТЧ.ТипСтавки = ТекДанные.ТипСтавки 
			Или ИмяПоляФормы = "ТипСтавки" 
			Или Не ЗначениеЗаполнено(СтрокаТЧ.ТипСтавки) Тогда
			
			Если Не ЗначениеЗаполнено(СтрокаТЧ.ТипСтавки) Тогда
				СтрокаТЧ.ТипСтавки = ТекДанные.ТипСтавки;
			КонецЕсли;
			
			СтрокаТЧ[ИмяПоляФормы] = ЗначениеДляЗаполнения;
			
			Если ЭтоКолонкаСтавки Тогда
				
				СтрокаНашлась = Ложь; 
				
				Для Каждого Идентификатор Из СтрокаТЧ.ИдентификаторыСтрок Цикл
					СтруктураОтбора = Новый Структура("ИдентификаторСтроки, ПараметрПеревозки");
					СтруктураОтбора.ИдентификаторСтроки = Идентификатор.Значение;
					СтруктураОтбора.ПараметрПеревозки = ПараметрПеревозки;
					
					НайденнаяСтрока = Объект.СпециальныеСтавки.НайтиСтроки(СтруктураОтбора);
					Если НайденнаяСтрока.Количество() > 0 Тогда
						НайденнаяСтрока[0][ИмяПоляТабличнойЧасти] = ЗначениеДляЗаполнения;
						СтрокаНашлась = Истина;
					КонецЕсли;
				КонецЦикла;
				
				Если Не СтрокаНашлась И ЗначениеЗаполнено(ЗначениеДляЗаполнения) Тогда 
					
					Если СтрокаТЧ.ИтерацияДобавления = 0 Тогда
						ПоследняяИтерация = ПоследняяИтерация + 1;
						СтрокаТЧ.ИтерацияДобавления = ПоследняяИтерация;
					КонецЕсли;
					
					НоваяСтрока = Объект.СпециальныеСтавки.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ); 
					НоваяСтрока[ИмяПоляТабличнойЧасти] = ЗначениеДляЗаполнения;
					НоваяСтрока.ПараметрПеревозки = ПараметрПеревозки;
					НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
					СтрокаТЧ.ИдентификаторыСтрок.Добавить(НоваяСтрока.ИдентификаторСтроки);
				КонецЕсли;
				
			Иначе
				
				Для Каждого Идентификатор Из СтрокаТЧ.ИдентификаторыСтрок Цикл
					НайденнаяСтрока = Объект.СпециальныеСтавки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", Идентификатор.Значение));
					Если НайденнаяСтрока.Количество() > 0 Тогда
						
						СтрБД = НайденнаяСтрока[0];
						
						Если СтрНайти(ИмяПоляФормы, "Валюта") = 1 Тогда
							СтарыйПараметр = СтрБД.ПараметрПеревозки;
							
							Если ЗначениеЗаполнено(СтарыйПараметр) Тогда
								ЭтоФрахт = (СтарыйПараметр.ВидТранспортногоСообщения = Перечисления.ВидыТранспортныхСообщений.Море);
								ЭтоЖД = (СтарыйПараметр.ВидТранспортногоСообщения = Перечисления.ВидыТранспортныхСообщений.ЖД);
								ЭтоНадбавкаСкидка = (СтрБД.ТипСтавки = Перечисления.ТипыСтавок.Надбавка Или СтрБД.ТипСтавки = Перечисления.ТипыСтавок.Скидка);
								
								ОбновлятьПараметр = Ложь;
								Если ИмяПоляФормы = "ВалютаФрахт" 
									И ЭтоФрахт 
									И Не ЭтоНадбавкаСкидка Тогда
									ОбновлятьПараметр = Истина;
								КонецЕсли;
								Если ИмяПоляФормы = "ВалютаЖД"
									И ЭтоЖД 
									И Не ЭтоНадбавкаСкидка Тогда
									ОбновлятьПараметр = Истина;
								КонецЕсли;
								Если ИмяПоляФормы = "ВалютаНадбавкаСкидкаФрахт" 
									И ЭтоФрахт 
									И ЭтоНадбавкаСкидка Тогда
									ОбновлятьПараметр = Истина;
								КонецЕсли;
								Если ИмяПоляФормы = "ВалютаНадбавкаСкидкаЖД" 
									И ЭтоЖД 
									И ЭтоНадбавкаСкидка Тогда
									ОбновлятьПараметр = Истина;
								КонецЕсли;
								
								Если ОбновлятьПараметр Тогда
									НовыйПараметр = Справочники.ПараметрыПеревозки.НайтиПараметрПеревозки(
										СтарыйПараметр.РазмерКТК,
										СтарыйПараметр.ПринадлежностьТЕ,
										ЗначениеДляЗаполнения,
										СтарыйПараметр.ВидТранспортногоСообщения
									);
									СтрБД.ПараметрПеревозки = НовыйПараметр;
								КонецЕсли;
							КонецЕсли;
							
						Иначе
							СтрБД[ИмяПоляФормы] = ЗначениеДляЗаполнения;
						КонецЕсли;
						
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеКолонкиДоступно(ТекущиеДанные, ИмяИзменяемогоПоляТЧ)
	
	Если СтрНайти(ИмяИзменяемогоПоляТЧ, "НадбавкаСкидка") > 0
		И ТекущиеДанные.ТипСтавки = ПредопределенноеЗначение("Перечисление.ТипыСтавок.СпециальнаяСтавка") Тогда
		ЗаполнятьПоПервойСтрокеНевозможно = Истина;
	ИначеЕсли СтрНайти(ИмяИзменяемогоПоляТЧ, "Ставка") > 0 И СтрНайти(ИмяИзменяемогоПоляТЧ, "СтавкаНДС") = 0 
		И (ТекущиеДанные.ТипСтавки = ПредопределенноеЗначение("Перечисление.ТипыСтавок.Надбавка")
			Или ТекущиеДанные.ТипСтавки = ПредопределенноеЗначение("Перечисление.ТипыСтавок.Скидка")) Тогда
		ЗаполнятьПоПервойСтрокеНевозможно = Истина;
	ИначеЕсли ТекущиеДанные.ТипСтавки <> ПредопределенноеЗначение("Перечисление.ТипыСтавок.СпециальнаяСтавка") 
		И (СтрНайти(ИмяИзменяемогоПоляТЧ, "СуммаВключаетНДС") > 0 Или СтрНайти(ИмяИзменяемогоПоляТЧ, "СтавкаНДС") > 0) Тогда
		ЗаполнятьПоПервойСтрокеНевозможно = Истина;
	Иначе
		ЗаполнятьПоПервойСтрокеНевозможно = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СпециальныеСтавкиФормаКалькуляцииСтрокойНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Модифицированность = Истина;
	ТекДанные = Элементы.СпециальныеСтавкиФорма.ТекущиеДанные;
	ТекСтрока = Элементы.СпециальныеСтавкиФорма.ТекущаяСтрока;
	
	Если СтрНайти(Элемент.Имя, "ЖД") > 0 Тогда
		ИмяПоля = Лев(Сред(Элемент.Имя, 23), 18);
	Иначе
		ИмяПоля = Лев(Сред(Элемент.Имя, 23), 21);
	КонецЕсли;
	
	ПараметрПеревозки = РазложитьСтрокуНаПараметрПеревозки(ИмяПоля, ТекДанные);
	
	ИдентификаторыСтрок = ТекДанные.ИдентификаторыСтрок.ВыгрузитьЗначения();
	Результат = ПолучитьСписокКалькуляций(ИдентификаторыСтрок, ПараметрПеревозки);
	СписокКалькуляций = Новый СписокЗначений;
	СписокКалькуляций.ЗагрузитьЗначения(Результат.МассивКалькуляций);
	
	Для Каждого ЭлементСписка Из СписокКалькуляций Цикл
		ВыбранныйЭлемент = ТекДанные[ИмяПоля].НайтиПоЗначению(ЭлементСписка.Значение);
		Если ВыбранныйЭлемент <> Неопределено Тогда
			ЭлементСписка.Пометка = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТекущийСписок", СписокКалькуляций);
	ПараметрыФормы.Вставить("ПоказыватьПометку", Истина);
	ПараметрыФормы.Вставить("ИзменятьСоставСтрок", Ложь);
	
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ИдентификаторСтроки", ТекСтрока);
	ПараметрыОповещения.Вставить("ИмяПоля", ИмяПоля);
	ПараметрыОповещения.Вставить("СоответствиеКалькуляцийКИдентификаторам", Результат.СоответствиеКалькуляцийКИдентификаторам);
	
	ОповещениеОЗакрытииФормыСписка = Новый ОписаниеОповещения("ПриЗакрытииФормыРедактированияСпискаКалькуляции", ЭтаФорма, ПараметрыОповещения);	
	ОткрытьФорму("ОбщаяФорма.ФормаРедактированияСпискаЗначений", ПараметрыФормы, Этаформа, , , , ОповещениеОЗакрытииФормыСписка, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция РазложитьСтрокуНаПараметрПеревозки(Строка, Данные)
	
	Если СтрНайти(Строка, "20") <> 0 Тогда
		РазмерКТК = ПредопределенноеЗначение("Справочник.РазмерыКТК.К20");
	Иначе
		РазмерКТК = ПредопределенноеЗначение("Справочник.РазмерыКТК.К40");
	КонецЕсли;
	Если СтрНайти(Строка, "ЖД") <> 0 Тогда
		ВидСообщенияТекст = "ЖД";
		ВидТранспортногоСообщения = ПредопределенноеЗначение("Перечисление.ВидыТранспортныхСообщений.ЖД");
	Иначе
		ВидСообщенияТекст = "Фрахт";
		ВидТранспортногоСообщения = ПредопределенноеЗначение("Перечисление.ВидыТранспортныхСообщений.Море");
	КонецЕсли;
	Если СтрНайти(Строка, "SOC") <> 0 Тогда
		Принадлежность = ПредопределенноеЗначение("Перечисление.ПринадлежностьТЕ.КТКлиента");
	Иначе
		Принадлежность = ПредопределенноеЗначение("Перечисление.ПринадлежностьТЕ.КТЕвросиба");
	КонецЕсли;
	Если Данные.ТипСтавки = ПредопределенноеЗначение("Перечисление.ТипыСтавок.Надбавка") 
		Или Данные.ТипСтавки = ПредопределенноеЗначение("Перечисление.ТипыСтавок.Скидка") Тогда
		Валюта = Данные["ВалютаНадбавкаСкидка" + ВидСообщенияТекст];
	Иначе
		Валюта = Данные["Валюта" + ВидСообщенияТекст];
	КонецЕсли;
	
	Возврат НайтиПараметрПеревозки(РазмерКТК, 
		Принадлежность,
		Валюта,
		ВидТранспортногоСообщения);
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиПараметрПеревозки(РазмерКТК, Принадлежность, Валюта, ВидТранспортногоСообщения)
	
	НайденныйПараметрПеревозки = Справочники.ПараметрыПеревозки.НайтиПараметрПеревозки(РазмерКТК, 
		Принадлежность,
		Валюта,
		ВидТранспортногоСообщения);
	
	Возврат НайденныйПараметрПеревозки;
	
КонецФункции

&НаКлиенте
Процедура ПриЗакрытииФормыРедактированияСпискаКалькуляции(СписокКалькуляций, ДополнительныеПараметры) Экспорт
	
	Если СписокКалькуляций <> Неопределено Тогда
		
		СоответствиеКалькуляцийКИдентификаторам = ДополнительныеПараметры.СоответствиеКалькуляцийКИдентификаторам;
		ТекСтрока = ДополнительныеПараметры.ИдентификаторСтроки;
		ТекДанные = СпециальныеСтавкиФорма.НайтиПоИдентификатору(ТекСтрока);
		ИмяПоля = ДополнительныеПараметры.ИмяПоля;
		ТекДанные[ИмяПоля].Очистить();
		
		Для Каждого ЭлементСписка Из СписокКалькуляций Цикл
			Для Каждого Соответствие Из СоответствиеКалькуляцийКИдентификаторам Цикл
				ИдентификаторСтроки = Соответствие.Получить(ЭлементСписка.Значение);
				Строка = Объект.Калькуляции.НайтиСтроки(Новый Структура("ИдентификаторСтрокиСпецСтавок", ИдентификаторСтроки));
				Если ЭлементСписка.Пометка Тогда
					Строка[0].Удалена = Ложь;
					ТекДанные[ИмяПоля].Добавить(ЭлементСписка.Значение);
				Иначе
					Строка[0].Удалена = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		СпециальныеСтавкиФормаКалькуляции20ЖДSOCПриИзменении(ТекСтрока, ИмяПоля);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокКалькуляций(ИдентификаторыСтрок, ПараметрПеревозки)
	
	Ответ = Новый Структура;
	Ответ.Вставить("МассивКалькуляций");
	Ответ.Вставить("СоответствиеКалькуляцийКИдентификаторам", Новый Массив);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗ_Калькуляции.Калькуляция КАК Калькуляция,
	|	ТЗ_Калькуляции.ПараметрПеревозки КАК ПараметрПеревозки,
	|	ТЗ_Калькуляции.ИдентификаторСтрокиСпецСтавок КАК ИдентификаторСтрокиСпецСтавок
	|ПОМЕСТИТЬ ВТ_Калькуляции
	|ИЗ
	|	&ТаблицаКалькуляций КАК ТЗ_Калькуляции
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Калькуляции.Калькуляция КАК Калькуляция,
	|	ВТ_Калькуляции.ИдентификаторСтрокиСпецСтавок КАК ИдентификаторСтрокиСпецСтавок
	|ИЗ
	|	ВТ_Калькуляции КАК ВТ_Калькуляции
	|ГДЕ
	|	ВТ_Калькуляции.ИдентификаторСтрокиСпецСтавок В(&ИдентификаторСтрокиСпецСтавок)
	|	И ВТ_Калькуляции.ПараметрПеревозки = &ПараметрПеревозки";
	
	Запрос.УстановитьПараметр("ТаблицаКалькуляций", Объект.Калькуляции.Выгрузить(,"Калькуляция, ПараметрПеревозки, ИдентификаторСтрокиСпецСтавок"));
	Запрос.УстановитьПараметр("ИдентификаторСтрокиСпецСтавок", ИдентификаторыСтрок);
	Запрос.УстановитьПараметр("ПараметрПеревозки", ПараметрПеревозки);
	
	Выгрузка = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Строка Из Выгрузка Цикл
		Соответствие = Новый Соответствие;
		Соответствие.Вставить(Строка.Калькуляция, Строка.ИдентификаторСтрокиСпецСтавок);
		Ответ.СоответствиеКалькуляцийКИдентификаторам.Добавить(Соответствие);
	КонецЦикла;
	
	МассивКалькуляций = Выгрузка.ВыгрузитьКолонку("Калькуляция");
	МассивКалькуляций = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивКалькуляций);
	
	Ответ.МассивКалькуляций = МассивКалькуляций;
	Возврат Ответ;
	
КонецФункции

&НаКлиенте
Процедура СпециальныеСтавкиФормаКалькуляции20ЖДSOCСтрокойОчистка(Элемент, СтандартнаяОбработка)
	
	ТекДанные = Элементы.СпециальныеСтавкиФорма.ТекущиеДанные;
	ТекСтрока = Элементы.СпециальныеСтавкиФорма.ТекущаяСтрока;
	
	Если СтрНайти(Элемент.Имя, "ЖД") > 0 Тогда
		ИмяПоля = Лев(Сред(Элемент.Имя, 23), 18);
	Иначе
		ИмяПоля = Лев(Сред(Элемент.Имя, 23), 21);
	КонецЕсли;
	
	ТекДанные[ИмяПоля].Очистить();
	
	СпециальныеСтавкиФормаКалькуляции20ЖДSOCПриИзменении(ТекСтрока, ИмяПоля);
	
КонецПроцедуры

&НаСервере
Процедура СпециальныеСтавкиФормаКалькуляции20ЖДSOCПриИзменении(ТекСтрока, ИмяПоля)
	
	ТекДанные = СпециальныеСтавкиФорма.НайтиПоИдентификатору(ТекСтрока);
	ОбработатьИзмененияКалькуляций(ТекДанные, ИмяПоля);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзмененияКалькуляций(ТекДанные, ИмяПоля)
	
	ТекДанные[ИмяПоля + "Строкой"]  = СтрСоединить(ТекДанные[ИмяПоля].ВыгрузитьЗначения(), "; " + Символы.ПС);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКалькуляцииСтрокой()
	
	Для Каждого Строка Из СпециальныеСтавкиФорма Цикл
		
		Калькуляции20ЖДSOC = Строка.Калькуляции20ЖДSOC.ВыгрузитьЗначения();
		Калькуляции20ЖДSOC = ОбщегоНазначенияКлиентСервер.СвернутьМассив(Калькуляции20ЖДSOC);
		Строка.Калькуляции20ЖДSOCСтрокой = СтрСоединить(Калькуляции20ЖДSOC, "; " + Символы.ПС);
		
		Калькуляции20ЖДCOC = Строка.Калькуляции20ЖДCOC.ВыгрузитьЗначения();
		Калькуляции20ЖДCOC = ОбщегоНазначенияКлиентСервер.СвернутьМассив(Калькуляции20ЖДCOC);
		Строка.Калькуляции20ЖДCOCСтрокой = СтрСоединить(Калькуляции20ЖДCOC, "; " + Символы.ПС);
		
		Калькуляции40ЖДCOC = Строка.Калькуляции40ЖДCOC.ВыгрузитьЗначения();
		Калькуляции40ЖДCOC = ОбщегоНазначенияКлиентСервер.СвернутьМассив(Калькуляции40ЖДCOC);
		Строка.Калькуляции40ЖДCOCСтрокой = СтрСоединить(Калькуляции40ЖДCOC, "; " + Символы.ПС);
		
		Калькуляции40ЖДSOC = Строка.Калькуляции40ЖДSOC.ВыгрузитьЗначения();
		Калькуляции40ЖДSOC = ОбщегоНазначенияКлиентСервер.СвернутьМассив(Калькуляции40ЖДSOC);
		Строка.Калькуляции40ЖДSOCСтрокой = СтрСоединить(Калькуляции40ЖДSOC, "; " + Символы.ПС);
		
		Калькуляции20ФрахтCOC = Строка.Калькуляции20ФрахтCOC.ВыгрузитьЗначения();
		Калькуляции20ФрахтCOC = ОбщегоНазначенияКлиентСервер.СвернутьМассив(Калькуляции20ФрахтCOC);
		Строка.Калькуляции20ФрахтCOCСтрокой = СтрСоединить(Калькуляции20ФрахтCOC, "; " + Символы.ПС);
		
		Калькуляции20ФрахтSOC = Строка.Калькуляции20ФрахтSOC.ВыгрузитьЗначения();
		Калькуляции20ФрахтSOC = ОбщегоНазначенияКлиентСервер.СвернутьМассив(Калькуляции20ФрахтSOC);
		Строка.Калькуляции20ФрахтSOCСтрокой = СтрСоединить(Калькуляции20ФрахтSOC, "; " + Символы.ПС);
		
		Калькуляции40ФрахтCOC = Строка.Калькуляции40ФрахтCOC.ВыгрузитьЗначения();
		Калькуляции40ФрахтCOC = ОбщегоНазначенияКлиентСервер.СвернутьМассив(Калькуляции40ФрахтCOC);
		Строка.Калькуляции40ФрахтCOCСтрокой = СтрСоединить(Калькуляции40ФрахтCOC, "; " + Символы.ПС);
		
		Калькуляции40ФрахтSOC = Строка.Калькуляции40ФрахтSOC.ВыгрузитьЗначения();
		Калькуляции40ФрахтSOC = ОбщегоНазначенияКлиентСервер.СвернутьМассив(Калькуляции40ФрахтSOC);
		Строка.Калькуляции40ФрахтSOCСтрокой = СтрСоединить(Калькуляции40ФрахтSOC, "; " + Символы.ПС);
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УдалитьПустыеСтрокиВПараметрахПеревозки()
	
	КонтрагентыКоличество = Объект.Контрагенты.Количество();
	ПунктыОтправленияЖДКоличество = Объект.ПунктыОтправленияЖД.Количество();
	ПунктыНазначенияЖДКоличество = Объект.ПунктыНазначенияЖД.Количество();
	ПортыОтправленияФрахтКоличество = Объект.ПортыОтправленияФрахт.Количество();
	ПортыОтгрузкиФрахтКоличество = Объект.ПортыОтгрузкиФрахт.Количество();
	ПортыНазначенияФрахтКоличество = Объект.ПортыНазначенияФрахт.Количество();
	
	Пока КонтрагентыКоличество > 0 Цикл
		КонтрагентыКоличество = КонтрагентыКоличество - 1;
		Строка = Объект.Контрагенты[КонтрагентыКоличество];
		Если Не ЗначениеЗаполнено(Строка.Контрагент) Тогда
			Объект.Контрагенты.Удалить(КонтрагентыКоличество);
		КонецЕсли;
	КонецЦикла;
	
	Пока ПунктыОтправленияЖДКоличество > 0 Цикл
		ПунктыОтправленияЖДКоличество = ПунктыОтправленияЖДКоличество - 1;
		Строка = Объект.ПунктыОтправленияЖД[ПунктыОтправленияЖДКоличество];
		Если Не ЗначениеЗаполнено(Строка.ПунктОтправления) Тогда
			Объект.ПунктыОтправленияЖД.Удалить(ПунктыОтправленияЖДКоличество);
		КонецЕсли;
	КонецЦикла;
	
	Пока ПунктыНазначенияЖДКоличество > 0 Цикл
		ПунктыНазначенияЖДКоличество = ПунктыНазначенияЖДКоличество - 1;
		Строка = Объект.ПунктыНазначенияЖД[ПунктыНазначенияЖДКоличество];
		Если Не ЗначениеЗаполнено(Строка.ПунктНазначения) Тогда
			Объект.ПунктыНазначенияЖД.Удалить(ПунктыНазначенияЖДКоличество);
		КонецЕсли;
	КонецЦикла;
	
	Пока ПортыОтправленияФрахтКоличество > 0 Цикл
		ПортыОтправленияФрахтКоличество = ПортыОтправленияФрахтКоличество - 1;
		Строка = Объект.ПортыОтправленияФрахт[ПортыОтправленияФрахтКоличество];
		Если Не ЗначениеЗаполнено(Строка.ПортОтправления) Тогда
			Объект.ПортыОтправленияФрахт.Удалить(ПортыОтправленияФрахтКоличество);
		КонецЕсли;
	КонецЦикла;
	
	Пока ПортыОтгрузкиФрахтКоличество > 0 Цикл
		ПортыОтгрузкиФрахтКоличество = ПортыОтгрузкиФрахтКоличество - 1;
		Строка = Объект.ПортыОтгрузкиФрахт[ПортыОтгрузкиФрахтКоличество];
		Если Не ЗначениеЗаполнено(Строка.ПортОтгрузки) Тогда
			Объект.ПортыОтгрузкиФрахт.Удалить(ПортыОтгрузкиФрахтКоличество);
		КонецЕсли;
	КонецЦикла;
	
	Пока ПортыНазначенияФрахтКоличество > 0 Цикл
		ПортыНазначенияФрахтКоличество = ПортыНазначенияФрахтКоличество - 1;
		Строка = Объект.ПортыНазначенияФрахт[ПортыНазначенияФрахтКоличество];
		Если Не ЗначениеЗаполнено(Строка.ПортНазначения) Тогда
			Объект.ПортыНазначенияФрахт.Удалить(ПортыНазначенияФрахтКоличество);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ТекстЗапросаДанныхКалькуляцийНотиса()
	
	Возврат "ВЫБРАТЬ
	|	ДокументКалькуляция.Ссылка КАК Калькуляция,
	|	ДокументКалькуляция.веб_ДляКТКЕвросиб КАК COCЖД,
	|	ДокументКалькуляция.веб_ДляКТККлиента КАК SOCЖД,
	|	ДокументКалькуляция.УсловияПеревозки_Отправление КАК УсловияПеревозки_Отправление,
	|	ДокументКалькуляция.УсловияПеревозки_Прибытие КАК УсловияПеревозки_Прибытие,
	|	ВЫБОР
	|		КОГДА ДокументКалькуляция.ТарифицируемыйРазмерКТК В (""20"", ""2040"")
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Размер20,
	|	ВЫБОР
	|		КОГДА ДокументКалькуляция.ТарифицируемыйРазмерКТК В (""40"", ""2040"")
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Размер40,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЕСТЬNULL(МультимодальнаяЦепочка.Итого20, 0) <> 0
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК Итого20Заполнено,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЕСТЬNULL(МультимодальнаяЦепочка.Итого40, 0) <> 0
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК Итого40Заполнено,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЕСТЬNULL(МультимодальнаяЦепочка.Итого20, 0) <> 0
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК Выбрано20ЖД,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЕСТЬNULL(МультимодальнаяЦепочка.Итого40, 0) <> 0
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК Выбрано40ЖД
	|ПОМЕСТИТЬ ВТ_БазовыеДанныеКалькуляции
	|ИЗ
	|	Документ.Калькуляция КАК ДокументКалькуляция
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Калькуляция.ММ_КалькуляцияМультимодальнойЦепочки КАК МультимодальнаяЦепочка
	|		ПО ДокументКалькуляция.Ссылка = МультимодальнаяЦепочка.Ссылка
	|ГДЕ
	|	ДокументКалькуляция.Ссылка В(&СсылкиКалькуляций)
	|СГРУППИРОВАТЬ ПО
	|	ДокументКалькуляция.Ссылка,
	|	ДокументКалькуляция.веб_ДляКТКЕвросиб,
	|	ДокументКалькуляция.веб_ДляКТККлиента,
	|	ДокументКалькуляция.УсловияПеревозки_Отправление,
	|	ДокументКалькуляция.УсловияПеревозки_Прибытие,
	|	ДокументКалькуляция.ТарифицируемыйРазмерКТК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка КАК Калькуляция,
	|	Суша_ПунктОтправления КАК Станция
	|ПОМЕСТИТЬ ВТ_СтанцииОтправления
	|ИЗ
	|	Документ.Калькуляция
	|ГДЕ
	|	Ссылка В(&СсылкиКалькуляций)
	|	И Суша_ПунктОтправления <> ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Ссылка,
	|	Станция
	|ИЗ
	|	Документ.Калькуляция.СписокСтанцийОтправления
	|ГДЕ
	|	Ссылка В(&СсылкиКалькуляций)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка КАК Калькуляция,
	|	Суша_ПунктНазначения КАК Станция
	|ПОМЕСТИТЬ ВТ_СтанцииНазначения
	|ИЗ
	|	Документ.Калькуляция
	|ГДЕ
	|	Ссылка В(&СсылкиКалькуляций)
	|	И Суша_ПунктНазначения <> ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Ссылка,
	|	Станция
	|ИЗ
	|	Документ.Калькуляция.СписокСтанцийНазначения
	|ГДЕ
	|	Ссылка В(&СсылкиКалькуляций)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка КАК Калькуляция,
	|	ВЫБОР
	|		КОГДА SOCCOC = ""SOC""
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК SOCФрахт,
	|	ВЫБОР
	|		КОГДА SOCCOC = ""COC""
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК COCФрахт,
	|	Выбрано20 КАК Выбрано20Фрахт,
	|	Выбрано40 КАК Выбрано40Фрахт,
	|	Порт КАК ПортОтправления,
	|	ПортВыгрузкиОтгрузки КАК ПортОтгрузки,
	|	Ссылка.Море_УсловияПогрузки КАК УсловияПогрузки,
	|	Ссылка.Море_УсловияВыгрузки КАК УсловияВыгрузки
	|ПОМЕСТИТЬ ВТ_ДанныеФрахта
	|ИЗ
	|	Документ.Калькуляция.НФ_ВыбранныеСтавки
	|ГДЕ
	|	Ссылка В(&СсылкиКалькуляций)
	|	И (Выбрано20 ИЛИ Выбрано40)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка КАК Калькуляция,
	|	Порт
	|ПОМЕСТИТЬ ВТ_ПортыНазначения
	|ИЗ
	|	Документ.Калькуляция.ММ_ПортыОтправленияНазначения
	|ГДЕ
	|	Ссылка В(&СсылкиКалькуляций)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Ссылка,
	|	Порт
	|ИЗ
	|	Документ.Калькуляция.НФ_ПортыОтправленияНазначения
	|ГДЕ
	|	Ссылка В(&СсылкиКалькуляций)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	БазовыеДанные.Калькуляция КАК Калькуляция,
	|	БазовыеДанные.COCЖД КАК COCЖД,
	|	БазовыеДанные.SOCЖД КАК SOCЖД,
	|	ЕСТЬNULL(ДанныеФрахта.COCФрахт, ЛОЖЬ) КАК COCФрахт,
	|	ЕСТЬNULL(ДанныеФрахта.SOCФрахт, ЛОЖЬ) КАК SOCФрахт,
	|	БазовыеДанные.УсловияПеревозки_Отправление КАК УсловияПеревозкиОтправление,
	|	БазовыеДанные.УсловияПеревозки_Прибытие КАК УсловияПеревозкиПрибытие,
	|	БазовыеДанные.Размер20 КАК Размер20,
	|	БазовыеДанные.Размер40 КАК Размер40,
	|	БазовыеДанные.Итого20Заполнено КАК Итого20Заполнено,
	|	БазовыеДанные.Итого40Заполнено КАК Итого40Заполнено,
	|	БазовыеДанные.Выбрано20ЖД КАК Выбрано20ЖД,
	|	БазовыеДанные.Выбрано40ЖД КАК Выбрано40ЖД,
	|	ЕСТЬNULL(ДанныеФрахта.Выбрано20Фрахт, ЛОЖЬ) КАК Выбрано20Фрахт,
	|	ЕСТЬNULL(ДанныеФрахта.Выбрано40Фрахт, ЛОЖЬ) КАК Выбрано40Фрахт,
	|	ЕСТЬNULL(СтанцииОтправления.Станция, ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка)) КАК ПунктОтправления,
	|	ЕСТЬNULL(СтанцииНазначения.Станция, ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка)) КАК ПунктНазначения,
	|	ЕСТЬNULL(ДанныеФрахта.ПортОтправления, ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка)) КАК ПортОтправления,
	|	ЕСТЬNULL(ДанныеФрахта.ПортОтгрузки, ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка)) КАК ПортОтгрузки,
	|	ЕСТЬNULL(ПортыНазначения.Порт, ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка)) КАК ПортНазначения,
	|	ЕСТЬNULL(ДанныеФрахта.УсловияПогрузки, ЗНАЧЕНИЕ(Перечисление.УсловияПеревозкиПоПортам.ПустаяСсылка)) КАК УсловияПогрузки,
	|	ЕСТЬNULL(ДанныеФрахта.УсловияВыгрузки, ЗНАЧЕНИЕ(Перечисление.УсловияПеревозкиПоПортам.ПустаяСсылка)) КАК УсловияВыгрузки
	|ИЗ
	|	ВТ_БазовыеДанныеКалькуляции КАК БазовыеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтанцииОтправления КАК СтанцииОтправления
	|		ПО БазовыеДанные.Калькуляция = СтанцииОтправления.Калькуляция
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтанцииНазначения КАК СтанцииНазначения
	|		ПО БазовыеДанные.Калькуляция = СтанцииНазначения.Калькуляция
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДанныеФрахта КАК ДанныеФрахта
	|		ПО БазовыеДанные.Калькуляция = ДанныеФрахта.Калькуляция
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПортыНазначения КАК ПортыНазначения
	|		ПО БазовыеДанные.Калькуляция = ПортыНазначения.Калькуляция";

КонецФункции


