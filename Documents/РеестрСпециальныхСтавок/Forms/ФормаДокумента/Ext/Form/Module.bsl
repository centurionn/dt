	ЭтаФорма.ОбновитьОтображениеДанных();
	ОбновитьПанельСостояний();
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьКалькуляцииНотиса()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПСЦКалькуляции.Калькуляция КАК Калькуляция
	|ИЗ
	|	Документ.ПСЦ.Калькуляции КАК ПСЦКалькуляции
	|ГДЕ
	|	ПСЦКалькуляции.Ссылка = &Ссылка";

	Запрос.УстановитьПараметр("Ссылка", Объект.Применяется);
	
	МассивКалькуляций = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Калькуляция");
	
	ТекстЗапроса = ТекстЗапросаДанныхКалькуляцийНотиса();
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("СсылкиКалькуляций", МассивКалькуляций);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = КалькуляцииНотиса.Добавить();
		НоваяСтрока.Калькуляция = Выборка.Калькуляция;
		НоваяСтрока.SOCЖД = Выборка.SOCЖД;
		НоваяСтрока.COCЖД = Выборка.COCЖД;
		НоваяСтрока.SOCФрахт = Выборка.SOCФрахт;
		НоваяСтрока.COCФрахт = Выборка.COCФрахт;
		Если Выборка.Размер20 И ЗначениеЗаполнено(Выборка.Итого20Заполнено) Тогда
			НоваяСтрока.Размер20 = Истина;
		КонецЕсли;
		Если Выборка.Размер40 И ЗначениеЗаполнено(Выборка.Итого40Заполнено) Тогда
			НоваяСтрока.Размер40 = Истина;
		КонецЕсли;
		НоваяСтрока.Выбрано20ЖД = Выборка.Выбрано20ЖД;
		НоваяСтрока.Выбрано40ЖД = Выборка.Выбрано40ЖД;
		НоваяСтрока.Выбрано20Фрахт = Выборка.Выбрано20Фрахт;
		НоваяСтрока.Выбрано40Фрахт = Выборка.Выбрано40Фрахт;
		НоваяСтрока.ПортОтправления = Выборка.ПортОтправления;
		НоваяСтрока.ПортНазначения = Выборка.ПортНазначения;
		НоваяСтрока.ПортОтгрузки = Выборка.ПортОтгрузки;
		НоваяСтрока.ПунктОтправления = Выборка.ПунктОтправления;
		НоваяСтрока.ПунктНазначения = Выборка.ПунктНазначения;
		НоваяСтрока.УсловияПеревозкиОтправление = Выборка.УсловияПеревозкиОтправление;
		НоваяСтрока.УсловияПеревозкиПрибытие = Выборка.УсловияПеревозкиПрибытие;
		НоваяСтрока.УсловияПогрузки = Выборка.УсловияПогрузки;
		НоваяСтрока.УсловияВыгрузки = Выборка.УсловияВыгрузки;
	КонецЦикла;
	
КонецПроцедуры

