КонецПроцедуры

&НаКлиенте
Процедура ДобавитьРейс(Команда)
	ПроверитьКорректностьДобавленияРейса();
КонецПроцедуры

&НаКлиенте
Процедура ВвестиСтавки(Команда)
	УдалитьПустыеСтрокиВПараметрахПеревозки();
	ВвестиСтавкиНаСервере();
	СвернутьТаблицуСпецСтавок();
	СформироватьТаблицуФормы();
	УпорядочитьСписокСпецСтавок();
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ПроверитьЗаполненностьТаблицыСпецСтавок(Отказ)
	
	Для Каждого Строка Из Объект.СпециальныеСтавки Цикл
		Если Строка.ПараметрПеревозки.ВидТранспортногоСообщения = Перечисления.ВидыТранспортныхСообщений.Море 
			И (Не ЗначениеЗаполнено(Строка.УсловияВыгрузки) 
				Или Не ЗначениеЗаполнено(Строка.УсловияПогрузки)) Тогда
			Для Каждого СтрокаФормы Из СпециальныеСтавкиФорма Цикл
				НайденИдентификатор = СтрокаФормы.ИдентификаторыСтрок.НайтиПоЗначению(Строка.ИдентификаторСтроки);
				Если НайденИдентификатор <> Неопределено Тогда
					Если Не ЗначениеЗаполнено(Строка.УсловияВыгрузки) Тогда
						ТекстСообщения = НСтр("ru = 'Не заполнено условие выгрузки'");
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ,
							"СпециальныеСтавкиФорма[" + СтрокаФормы.ПолучитьИдентификатор() + "].УсловияВыгрузки", , Отказ);
					КонецЕсли;
					Если Не ЗначениеЗаполнено(Строка.УсловияПогрузки) Тогда
						ТекстСообщения = НСтр("ru = 'Не заполнено условие погрузки'");
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ,
							"СпециальныеСтавкиФорма[" + СтрокаФормы.ПолучитьИдентификатор() + "].УсловияПогрузки", , Отказ);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Строка.ПараметрПеревозки.ВидТранспортногоСообщения = Перечисления.ВидыТранспортныхСообщений.ЖД 
			И (Не ЗначениеЗаполнено(Строка.УсловияПеревозкиОтправление) 
				Или Не ЗначениеЗаполнено(Строка.УсловияПеревозкиПрибытие)) Тогда
			Для Каждого СтрокаФормы Из СпециальныеСтавкиФорма Цикл
				НайденИдентификатор = СтрокаФормы.ИдентификаторыСтрок.НайтиПоЗначению(Строка.ИдентификаторСтроки);
				Если НайденИдентификатор <> Неопределено Тогда
					Если Не ЗначениеЗаполнено(Строка.УсловияПеревозкиОтправление) Тогда
						ТекстСообщения = НСтр("ru = 'Не заполнено условие отправления'");
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ,
							"СпециальныеСтавкиФорма[" + СтрокаФормы.ПолучитьИдентификатор() + "].УсловияПеревозкиОтправление", , Отказ);
					КонецЕсли;
					Если Не ЗначениеЗаполнено(Строка.УсловияПеревозкиПрибытие) Тогда
						ТекстСообщения = НСтр("ru = 'Не заполнено условие прибытия'");
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ,
							"СпециальныеСтавкиФорма[" + СтрокаФормы.ПолучитьИдентификатор() + "].УсловияПеревозкиПрибытие", , Отказ);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьКолонкиТаблицыСпециальныхСтавок()
	
	Для Каждого Элемент Из Элементы Цикл
		Если СтрНайти(Элемент.Имя, "СпециальныеСтавкиКалькуляции") > 0 И ТипЗнч(Элемент) = Тип("ПолеФормы") Тогда
			Элемент.ОграничениеТипа = Новый ОписаниеТипов("ДокументСсылка.Калькуляция");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОкноСИнструкциями(Форма, Команда)
	ИнструкцииКлиент.ОткрытьОкноСИнструкциями(ЭтаФорма, Команда);
КонецПроцедуры

&НаСервере
Процедура УпорядочитьСписокСпецСтавок()
	
	СпециальныеСтавкиФорма.Сортировать("ПунктОтправления, ПунктНазначения, ПортОтправления, ПортОтгрузки, ПортНазначения");
	ОбновитьНумерациюСтрокТаблицыСпецСтавок();

КонецПроцедуры

&НаСервере
Процедура ОбновитьНумерациюСтрокТаблицыСпецСтавок()
	
	Для Счетчик = 1 По СпециальныеСтавкиФорма.Количество() Цикл
		СпециальныеСтавкиФорма[Счетчик - 1].НомерСтроки = Счетчик;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СвернутьТаблицуСпецСтавок()
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ОбщегоНазначенияКлиентСервер.СвернутьТабличнуюЧасть(ДокументОбъект, "СпециальныеСтавки", "Ставка,ПлановыйОбъемTEU,НадбавкаСкидка");
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
КонецПроцедуры

&НаКлиенте
Процедура РейсыРейсыОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.ПСЦ") 
		И Объект.Рейсы.Количество() > 0 Тогда
		ТекстСообщения = НСтр("ru = 'В перечне рейсов может быть только один Нотис'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКорректностьДобавленияРейса()
	
	Если ВРейсахЕстьНотис() Тогда
		ТекстСообщения = НСтр("ru = 'В перечне рейсов может быть только один Нотис'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	Иначе
		Элементы.Рейсы.ДобавитьСтроку();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВРейсахЕстьНотис()
	
	Результат = Ложь;
	
	Если Объект.Рейсы.Количество() > 0 
		И ТипЗнч(Объект.Рейсы[0].Рейс) = Тип("ДокументСсылка.ПСЦ") Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ТекущийИсполнитель_СтатусПриИзменении(Элемент)

	МаршрутизацияКлиент.ТекущийИсполнитель_СтатусПриИзменении(Объект, ТекущийИсполнитель_Состояние, ТекущийИсполнитель_Статус, ТекущийИсполнитель_Исполнитель, ТекущийИсполнитель_Наблюдатель);
	
	ОбновитьПанельСостояний();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПанельСостояний()
	
	МаршрутизацияСервер.ОбновитьПанельСостояний(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПанельТекущегоПользователя()
	
	МаршрутизацияСервер.ОбновитьПанельТекущегоПользователя(Объект, ТекущийИсполнитель_Статус, ТекущийИсполнитель_Состояние, ТекущийИсполнитель_Исполнитель, ТекущийИсполнитель_Наблюдатель);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикНажатияПлитокСостояния(Параметр1 = Неопределено, Параметр2 = Неопределено) Экспорт
	МаршрутизацияКлиент.ОбработчикНажатияНаПлиткуОбщий(Параметр1, Параметр2);
КонецПроцедуры

&НаКлиенте
Процедура Делегировать(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ВыборДелегирования", ЭтаФорма);
	ОткрытьФорму("Справочник.Пользователи.Форма.ФормаВыбора", , , ЭтаФорма.УникальныйИдентификатор, , , ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборДелегирования(Параметр1 = Неопределено, Параметр2 = Неопределено) Экспорт
	
	Если Параметр1 = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Для Сч = 0 По Объект.Состояния.Количество() - 1 Цикл
		Если Объект.Состояния[Сч].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение") ИЛИ Объект.Состояния[Сч].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.ВРаботе") Тогда
			Объект.Состояния[Сч].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Новый");
			НСтр = Объект.Состояния.Вставить(Сч);
			НСтр.Состояние = ПредопределенноеЗначение("Справочник.Состояния.ДелегированноеСогласование");
			НСтр.Исполнитель = Параметр1;
			НСтр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение");
			ОбновитьПанельСостояний();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

