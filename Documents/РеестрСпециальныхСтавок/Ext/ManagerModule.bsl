Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт 
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "СпециальноеПредложение";
	КомандаПечати.Представление = НСтр("ru = 'Специальное предложение'");
	КомандаПечати.Обработчик    = "ДополнительныйМодульКлиент.ВыполнитьКомандуПечати";
	КомандаПечати.СписокФорм    = "ФормаСписка,ФормаДокумента";
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Применяется = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыПечати.СсылкаНаДокументПервоначальная, "Применяется");
	
	Если ТипЗнч(Применяется) = Тип("ДокументСсылка.ПСЦ") Тогда
		
		КоллекцияПечатныхФорм = УправлениеПечатью.ПодготовитьКоллекциюПечатныхФорм("ПСЦ_Нотис");
		
		Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПСЦ_Нотис") Тогда  
			
			Если КоллекцияПечатныхФорм.Количество() > 0 Тогда
				ИмяФайлаПечатнойФормы = "Документы.ПСЦ.ПФ_MXL_Нотис";
				ДопПараметры = Новый Структура;
				ДопПараметры.Вставить("ВыводитьФаксимиле", Ложь);
				ДопПараметры.Вставить("СпецСтавки", ПараметрыПечати.СсылкаНаДокументПервоначальная);
				МассивОбъектов = Новый Массив;
				МассивОбъектов.Добавить(Применяется);
				ТабличныйДокумент = Документы.ПСЦ.ИнтеллектуальныйОпределительФорматаПротокола(МассивОбъектов, ДопПараметры, ОбъектыПечати);
				УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПСЦ_Нотис", "Нотис ВРП", ТабличныйДокумент,,ИмяФайлаПечатнойФормы);
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СпециальноеПредложение") Тогда
			
			Если КоллекцияПечатныхФорм.Количество() > 0 Тогда
				ИмяФайлаПечатнойФормы = "Документы.РеестрСпециальныхСтавок.ПФ_MXL_СпециальноеПредложение";
				ДопПараметры = Новый Структура;
				ДопПараметры.Вставить("ВыводитьФаксимиле", Ложь);
				УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "СпециальноеПредложение", "Специальное предложение", 
												ОпределительФорматаПротокола(МассивОбъектов, ДопПараметры, ОбъектыПечати),,ИмяФайлаПечатнойФормы);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

