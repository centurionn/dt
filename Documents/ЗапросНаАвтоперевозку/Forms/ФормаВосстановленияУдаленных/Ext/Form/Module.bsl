		Тч = ПолучитьИзВременногоХранилища(Параметры.АдрезХранилищаТЧ);
		Для Каждого СтрокаТч Из ТЧ Цикл
			//Евросиб Коханенко Н.А. 15.05.2024 (( #83866
			Если Параметры.Свойство("МассивГУИДыПеренесенныхКТК")
					И Параметры.МассивГУИДыПеренесенныхКТК.Найти(СтрокаТч.ИдентификаторСтрокиУслуги) <> Неопределено Тогда 
				Продолжить;
			КонецЕсли;
			//Евросиб Коханенко Н.А. 15.05.2024 )) #83866 
			НовСтрока = Контейнеры.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока,СтрокаТч);
		КонецЦикла;	
