&НаКлиенте
Процедура КонтейнерыПередНачаломИзменения(Элемент, Отказ)
	ТекД = Элементы.Контейнеры.ТекущиеДанные;
	
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТЧ = Элемент.Имя;
	ИмяПоля = Сред(Элемент.ТекущийЭлемент.Имя, СтрДлина(ИмяТЧ)+1);
	Если ИмяПоля = "НеТребуетсяТерминалВыдачи" ИЛИ ИмяПоля = "НеТребуетсяТерминалСдачи" ИЛИ ИмяПоля = "НеТребуетсяАдрес" Тогда	
		МожноУстановить = ПроверитьВозможностьУстановкиПоляНеТребуется(ТекД,ТекД[ИмяПоля]);
		Если НЕ МожноУстановить Тогда
			Отказ = Истина;
		КонецЕсли;
		Если ИмяПоля = "НеТребуетсяТерминалВыдачи" И Не Отказ Тогда
			Если НЕ ТекД[ИмяПоля] Тогда
				ТекД.СтатусОтправкиЗапросаНаТерминалВыдачи = ПредопределенноеЗначение("Перечисление.СтатусОтправкиЗапросаНаТерминалВыдачи.НеТребуется");
			Иначе
				Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
					ТекД.СтатусОтправкиЗапросаНаТерминалВыдачи = ПолучитьСтатусОтправкиЗапросаНаТерминалВыдачиДоИзменения(Объект.Ссылка,ТекД.КлючАналитикиПеревозки);
					Если ТекД.СтатусОтправкиЗапросаНаТерминалВыдачи = ПредопределенноеЗначение("Перечисление.СтатусОтправкиЗапросаНаТерминалВыдачи.НеТребуется") Тогда
						ТекД.СтатусОтправкиЗапросаНаТерминалВыдачи = ПредопределенноеЗначение("Перечисление.СтатусОтправкиЗапросаНаТерминалВыдачи.НеОтправлен");
					КонецЕсли;	
				Иначе
					ТекД.СтатусОтправкиЗапросаНаТерминалВыдачи = ПредопределенноеЗначение("Перечисление.СтатусОтправкиЗапросаНаТерминалВыдачи.НеОтправлен");
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяПоля = "Отметка" И НЕ ТекД.Отметка Тогда
		//Отказ = (ТекД.СтатусЗаказаНаТС = ПредопределенноеЗначение("Перечисление.СтатусЗаказаНаТс.Закрыт") 
		//		ИЛИ ТекД.СтатусЗаказаНаТС = ПредопределенноеЗначение("Перечисление.СтатусЗаказаНаТс.ВыданВРейс")) 
		//		И НЕ ЗначениеЗаполнено(ТекД.КонтейнерФакт);
		//Если Отказ Тогда
		//	ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Отправка запроса на автоперевозку невозможна, так как заказ на ТС имеет статус ""%1""",ТекД.СтатусЗаказаНаТС));
		//	Возврат;
		//КонецЕсли;
		//Отказ = ТекД.СтатусЗапросаНаАвтоперевозку = ПредопределенноеЗначение("Перечисление.СтатусЗапросаНаПеревозку.Отменен");
		//Если Отказ Тогда
		//	ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Отправка запроса на автоперевозку невозможна, так как статус запроса ""%1""",ТекД.СтатусЗапросаНаАвтоперевозку));
		//	Возврат;
		//КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

