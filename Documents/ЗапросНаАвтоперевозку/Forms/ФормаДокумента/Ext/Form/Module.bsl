&НаСервере
Функция ПолучитьТаблицуЗапросыНаКТК(ЗаявкаПараметр)
	
	//ДИТ Шевченко А.В. 60951 11.11.2022 //Добавил поле СтокСдачи
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЗ.Релиз КАК Релиз,
		|	ТЗ.Количество КАК Количество
		|ПОМЕСТИТЬ ВТ_НеОтмененныеТЗ
		|ИЗ
		|	&НеОтмененныеТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РелизыКлиентовЗапросовНаКТК.РелизКлиента КАК РелизКлиента
		|ПОМЕСТИТЬ ВТ_РелизыПоЗаявке
		|ИЗ
		|	РегистрСведений.РелизыКлиентовЗапросовНаКТК КАК РелизыКлиентовЗапросовНаКТК
		|ГДЕ
		|	РелизыКлиентовЗапросовНаКТК.Заявка = &Заявка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РелизыКлиентовЗапросовНаКТК.РелизКлиента КАК РелизКлиента,
		|	СУММА(ВЫБОР
		|			КОГДА ЗапросНаАвтоперевозкуКонтейнеры.Ссылка ЕСТЬ NULL
		|				ТОГДА 0
		|			ИНАЧЕ 1
		|		КОНЕЦ) КАК КоличествоВЗапросах,
		|	МАКСИМУМ(РелизыКлиентовЗапросовНаКТК.РелизКлиента.ОбщееКоличествоКТКВРелизе) КАК ОбщееКоличествоКТКВРелизе
		|ПОМЕСТИТЬ ВТ_ОбщееКолКТКСУчетомЗапросов
		|ИЗ
		|	РегистрСведений.РелизыКлиентовЗапросовНаКТК КАК РелизыКлиентовЗапросовНаКТК
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_РелизыПоЗаявке КАК ВТ_РелизыПоЗаявке
		|		ПО РелизыКлиентовЗапросовНаКТК.РелизКлиента = ВТ_РелизыПоЗаявке.РелизКлиента
		|			И (РелизыКлиентовЗапросовНаКТК.РелизКлиента <> ЗНАЧЕНИЕ(Документ.РелизКлиента.ПустаяСсылка))
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗапросНаАвтоперевозку.Контейнеры КАК ЗапросНаАвтоперевозкуКонтейнеры
		|		ПО РелизыКлиентовЗапросовНаКТК.Заявка = ЗапросНаАвтоперевозкуКонтейнеры.Ссылка.Заявка
		|			И РелизыКлиентовЗапросовНаКТК.ИдентификаторСтрокиЗаявки = ЗапросНаАвтоперевозкуКонтейнеры.ИдентификаторСтрокиЗапроса
		|			И (ЗапросНаАвтоперевозкуКонтейнеры.СтатусЗапросаНаАвтоперевозку <> ЗНАЧЕНИЕ(Перечисление.СтатусЗапросаНаПеревозку.Отменен))
		|			И РелизыКлиентовЗапросовНаКТК.РелизКлиента = ЗапросНаАвтоперевозкуКонтейнеры.Релиз
		|			И (ЗапросНаАвтоперевозкуКонтейнеры.Ссылка.ЭтапПеревозки = &ЭтапПеревозки)
		|			И (ЗапросНаАвтоперевозкуКонтейнеры.Ссылка.Проведен)
		|			И (ЗапросНаАвтоперевозкуКонтейнеры.Ссылка <> &ТекЗапрос)
		|
		|СГРУППИРОВАТЬ ПО
		|	РелизыКлиентовЗапросовНаКТК.РелизКлиента 
		// ДИТ  Сержантова А.С. US 78243 ТА 79842 Начало: 31.01.2024
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_РелизыПоЗаявке.РелизКлиента КАК РелизКлиента,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаявкаСоставУслуги.НомерСтроки) КАК КолвоВУслугах
		|ПОМЕСТИТЬ ВТ_КолвоКТКпоВариантуАвтоперевозкиВУслугах
		|ИЗ
		|	ВТ_РелизыПоЗаявке КАК ВТ_РелизыПоЗаявке
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
		|		ПО ВТ_РелизыПоЗаявке.РелизКлиента = ЗаявкаСоставУслуги.Релиз
		|			И ВТ_РелизыПоЗаявке.РелизКлиента.Заявка = ЗаявкаСоставУслуги.Ссылка
		|ГДЕ
		|	&МиляВУслугах = ЗНАЧЕНИЕ(Перечисление.ВариантыАвтоперевозки.СиламиЕвросиб)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_РелизыПоЗаявке.РелизКлиента
		// ДИТ  Сержантова А.С. US 78243 ТА 79842 Конец: 31.01.2024
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ОбщееКолКТКСУчетомЗапросовИТекЗапроса.РелизКлиента КАК РелизКлиента,
		//|	ВТ_ОбщееКолКТКСУчетомЗапросовИТекЗапроса.КоличествоВЗапросах + ЕСТЬNULL(ВТ_НеОтмененныеТЗ.Количество, 0) КАК КоличествоВЗапросах,
		|	ВТ_ОбщееКолКТКСУчетомЗапросовИТекЗапроса.КоличествоВЗапросах КАК КоличествоВЗапросах,        
		// ДИТ  Сержантова А.С. US 78243 ТА 79842 Начало: 31.01.2024
		// Было:
		//|	ВТ_ОбщееКолКТКСУчетомЗапросовИТекЗапроса.ОбщееКоличествоКТКВРелизе КАК ОбщееКоличествоКТКВРелизе 
		//Стало:
		|	ЕстьNULL(ВТ_КолвоКТКпоВариантуАвтоперевозкиВУслугах.КолвоВУслугах, 0) КАК ОбщееКоличествоКТКВРелизе
		// ДИТ  Сержантова А.С. US 78243 ТА 79842 Конец: 31.01.2024
		|ИЗ
		|	ВТ_ОбщееКолКТКСУчетомЗапросов КАК ВТ_ОбщееКолКТКСУчетомЗапросовИТекЗапроса
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НеОтмененныеТЗ КАК ВТ_НеОтмененныеТЗ
		|		ПО ВТ_ОбщееКолКТКСУчетомЗапросовИТекЗапроса.РелизКлиента = ВТ_НеОтмененныеТЗ.Релиз 
		// ДИТ US 78243 ТА 79842 Сержантова А.С. Начало: 31.01.2024
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КолвоКТКпоВариантуАвтоперевозкиВУслугах КАК ВТ_КолвоКТКпоВариантуАвтоперевозкиВУслугах
		|		ПО (ВТ_ОбщееКолКТКСУчетомЗапросовИТекЗапроса.РелизКлиента = ВТ_КолвоКТКпоВариантуАвтоперевозкиВУслугах.РелизКлиента)
		// ДИТ US 78243 ТА 79842 Сержантова А.С. Конец: 31.01.2024
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////    
		|ВЫБРАТЬ
		|	ЗаявкаСписокЗапросНаКТК.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	ЗаявкаСписокЗапросНаКТК.КоличествоКТК КАК КоличествоКТК,
		|	ЗаявкаСписокЗапросНаКТК.ТипКТК КАК ТипКТК,
		|	ЗаявкаСписокЗапросНаКТК.ЛокацияВыдачи КАК ЛокацияВыдачи,
		|	ЗаявкаСписокЗапросНаКТК.Ссылка КАК Заявка
		|ПОМЕСТИТЬ ВТ_ИдентификаторыЗапросов
		|ИЗ
		|	Документ.Заявка.СписокЗапросНаКТК КАК ЗаявкаСписокЗапросНаКТК
		|ГДЕ
		|	ЗаявкаСписокЗапросНаКТК.Ссылка = &Заявка   
		// ДИТ US 78243 ТА 79842 Сержантова А.С. Начало: 31.01.2024  //BUG 81219 ТА 81220 раскомментировать!
		|	И &Миля = ЗНАЧЕНИЕ(Перечисление.ВариантыАвтоперевозки.СиламиЕвросиб) 
		// ДИТ US 78243 ТА 79842 Сержантова А.С. Конец: 31.01.2024
		|; 
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РелизыКлиентовЗапросовНаКТК.РелизКлиента КАК РелизКлиента,
		|	РелизыКлиентовЗапросовНаКТК.Заявка КАК Заявка
		|ПОМЕСТИТЬ втРелизыКлиентов
		|ИЗ
		|	РегистрСведений.РелизыКлиентовЗапросовНаКТК КАК РелизыКлиентовЗапросовНаКТК
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ИдентификаторыЗапросов КАК ВТ_ИдентификаторыЗаявок
		|		ПО РелизыКлиентовЗапросовНаКТК.ИдентификаторСтрокиЗаявки = ВТ_ИдентификаторыЗаявок.ИдентификаторСтроки
		|			И РелизыКлиентовЗапросовНаКТК.Заявка = ВТ_ИдентификаторыЗаявок.Заявка
		|ГДЕ
		|	РелизыКлиентовЗапросовНаКТК.РелизКлиента <> ЗНАЧЕНИЕ(Документ.РелизКлиента.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РелизКлиентаКонтейнеры.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	втРелизыКлиентов.РелизКлиента КАК РелизКлиента
		|ПОМЕСТИТЬ ВТ_РелизыИдентификаторыСтрок
		|ИЗ
		|	втРелизыКлиентов КАК втРелизыКлиентов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РелизКлиента.Контейнеры КАК РелизКлиентаКонтейнеры
		|		ПО втРелизыКлиентов.РелизКлиента = РелизКлиентаКонтейнеры.Ссылка
		|ГДЕ
		|	НЕ РелизКлиентаКонтейнеры.ИдентификаторСтроки ЕСТЬ NULL
		|
		|СГРУППИРОВАТЬ ПО
		|	РелизКлиентаКонтейнеры.ИдентификаторСтроки,
		|	втРелизыКлиентов.РелизКлиента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_РелизыИдентификаторыСтрок.РелизКлиента КАК РелизКлиента,
		|	ЗаявкаСоставУслуги.Ссылка КАК Заявка,
		|	1 КАК КоличествоКонтейнеров
		|ПОМЕСТИТЬ ВТ_КоличествоКонтейнеровВЗаявках
		|ИЗ
		|	ВТ_РелизыИдентификаторыСтрок КАК ВТ_РелизыИдентификаторыСтрок
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
		|		ПО ВТ_РелизыИдентификаторыСтрок.ИдентификаторСтроки = ЗаявкаСоставУслуги.ИдентификаторСтрокиРелизаКлиента
		|			И (ЗаявкаСоставУслуги.Ссылка <> &Заявка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_КоличествоКонтейнеровВЗаявках.РелизКлиента КАК РелизКлиента,
		|	СУММА(ВТ_КоличествоКонтейнеровВЗаявках.КоличествоКонтейнеров) КАК КоличествоКонтейнеров
		|ПОМЕСТИТЬ ВТ_КоличествоКонтейнеровВДругихЗаявках
		|ИЗ
		|	ВТ_КоличествоКонтейнеровВЗаявках КАК ВТ_КоличествоКонтейнеровВЗаявках
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_КоличествоКонтейнеровВЗаявках.РелизКлиента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_КоличествоКонтейнеровВЗаявках.Заявка КАК Заявка,
		|	ВТ_КоличествоКонтейнеровВЗаявках.Заявка.Номер КАК ЗаявкаНомер,
		|	СУММА(ВТ_КоличествоКонтейнеровВЗаявках.КоличествоКонтейнеров) КАК КоличествоКонтейнеров
		|ИЗ
		|	ВТ_КоличествоКонтейнеровВЗаявках КАК ВТ_КоличествоКонтейнеровВЗаявках
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_КоличествоКонтейнеровВЗаявках.Заявка,
		|	ВТ_КоличествоКонтейнеровВЗаявках.Заявка.Номер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ИдентификаторыЗапросов.ИдентификаторСтроки КАК ИдентификаторСтрокиЗапроса,
		|	ВТ_ИдентификаторыЗапросов.КоличествоКТК - ЕСТЬNULL(ВТ_КоличествоКонтейнеровВДругихЗаявках.КоличествоКонтейнеров, 0) КАК КоличествоКТК,
		|	ВТ_ИдентификаторыЗапросов.ТипКТК КАК ТипКТК,     
		//ДИТ Шевченко А.В. US 62515 ТА 69551 11.05.2023 -начало
		|	ЕСТЬNULL(ВЫБОР КОГДА &ЭтапПеревозки = ЗНАЧЕНИЕ(Перечисление.ЭтапыПеревозки.ПерваяМиля) ТОГДА РелизыКлиентовЗапросовНаКТК.РелизКлиента.ТерминалВыдачи ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка) КОНЕЦ, ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка)) КАК ТерминалВыдачи,
		//ДИТ Шевченко А.В. US 62515 ТА 69551 11.05.2023 -конец
		|	ЕСТЬNULL(РелизыКлиентовЗапросовНаКТК.РелизКлиента.СтокСдачи, ЗНАЧЕНИЕ(Справочник.Мультилокации.ПустаяСсылка)) КАК СтокСдачи,
		|	ЕСТЬNULL(РелизыКлиентовЗапросовНаКТК.РелизКлиента, ЗНАЧЕНИЕ(Документ.РелизКлиента.ПустаяСсылка)) КАК Релиз
		|ИЗ
		|	ВТ_ИдентификаторыЗапросов КАК ВТ_ИдентификаторыЗапросов
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоКонтейнеровВДругихЗаявках КАК ВТ_КоличествоКонтейнеровВДругихЗаявках
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ втРелизыКлиентов КАК втРелизыКлиентов
		|			ПО (втРелизыКлиентов.РелизКлиента = ВТ_КоличествоКонтейнеровВДругихЗаявках.РелизКлиента)
		|		ПО (ВТ_ИдентификаторыЗапросов.Заявка = втРелизыКлиентов.Заявка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РелизыКлиентовЗапросовНаКТК КАК РелизыКлиентовЗапросовНаКТК
		|		ПО ВТ_ИдентификаторыЗапросов.ИдентификаторСтроки = РелизыКлиентовЗапросовНаКТК.ИдентификаторСтрокиЗаявки
		|			И ВТ_ИдентификаторыЗапросов.Заявка = РелизыКлиентовЗапросовНаКТК.Заявка
		|			И (РелизыКлиентовЗапросовНаКТК.РелизКлиента <> ЗНАЧЕНИЕ(Документ.РелизКлиента.ПустаяСсылка))"; 
	
	Если Объект.ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПерваяМиля Тогда
		// ДИТ US 78243 ТА 79842 Сержантова А.С. Начало: 31.01.2024
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&МиляВУслугах","ЗаявкаСоставУслуги.ПерваяМиля");
		// ДИТ US 78243 ТА 79842 Сержантова А.С. Конец: 31.01.2024
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&Миля","ЗаявкаСписокЗапросНаКТК.Автоперевозка");
	Иначе
		// ДИТ US 78243 ТА 79842 Сержантова А.С. Начало: 31.01.2024
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&МиляВУслугах","ЗаявкаСоставУслуги.ПоследняяМиля");
		// ДИТ US 78243 ТА 79842 Сержантова А.С. Конец: 31.01.2024
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&Миля","ЗаявкаСписокЗапросНаКТК.ПоследняяМиля");   
	КонецЕсли;	
	
	ТаблицаТекОтмененныхСтрокВРазрезеРелизов = Новый ТаблицаЗначений;
	ТаблицаТекОтмененныхСтрокВРазрезеРелизов.Колонки.Добавить("Релиз",Новый ОписаниеТипов("ДокументСсылка.РелизКлиента"));
	ТаблицаТекОтмененныхСтрокВРазрезеРелизов.Колонки.Добавить("Количество",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10)));
	
	Для Каждого СтрокаТЧ Из Объект.Контейнеры Цикл
		Если ЗначениеЗаполнено(СтрокаТч.Релиз) И СтрокаТЧ.СтатусЗапросаНаАвтоперевозку = Перечисления.СтатусЗапросаНаПеревозку.Отменен И ЗначениеЗаполнено(СтрокаТч.ИдентификаторСтрокиЗапроса) Тогда
			НовСтрока = ТаблицаТекОтмененныхСтрокВРазрезеРелизов.Добавить();
			НовСтрока.Релиз = СтрокаТч.Релиз;
			НовСтрока.Количество 		 = 1;
		КонецЕсли;	
	КонецЦикла;	
	
	ТаблицаТекОтмененныхСтрокВРазрезеРелизов.Свернуть("Релиз","Количество");
	
	Запрос.УстановитьПараметр("НеОтмененныеТЗ", ТаблицаТекОтмененныхСтрокВРазрезеРелизов);
	Запрос.УстановитьПараметр("ТекЗапрос", Объект.Ссылка);
	Запрос.УстановитьПараметр("ЭтапПеревозки", Объект.ЭтапПеревозки);
	Запрос.УстановитьПараметр("Заявка", ЗаявкаПараметр);
	
	ПакетыЗапросов = Запрос.ВыполнитьПакет();
	
	// ДИТ US 78243 ТА 79842 Сержантова А.С. 31.01.2024 сдвинула нумерацию пакетов на 1 вперед. Было 3,9,10
	ТЗКоличествоКонтейнеровВРелизахСУчетомЗапросов  = ПакетыЗапросов[4].Выгрузить();
	ТЗКоличествоКонтейнеровВДругихРелизах 			= ПакетыЗапросов[10].Выгрузить();
	РезультатЗапроса = ПакетыЗапросов[11].Выгрузить();	
	
	СтруктураОтвет = Новый Структура("ТЗКоличествоКонтейнеровВДругихРелизах,ТаблицаЗапросыНаКТК,ТЗКоличествоКонтейнеровВРелизахСУчетомЗапросов"
									,ТЗКоличествоКонтейнеровВДругихРелизах
									,РезультатЗапроса
									,ТЗКоличествоКонтейнеровВРелизахСУчетомЗапросов);
	
	Возврат СтруктураОтвет;
	
КонецФункции	

