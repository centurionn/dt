&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ИсточникВыбора.ИмяФормы = "Документ.ЗапросНаАвтоперевозку.Форма.ФормаВосстановленияУдаленных" Тогда
		Если ВыбранноеЗначение.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;	
		
		МассивНеВосстановленныхНомеровСтрок = ПроверитьСтрокиНаВозможностьВосстановления(ВыбранноеЗначение,Объект.Заявка,Объект.ЭтапПеревозки);
		
		Если МассивНеВосстановленныхНомеровСтрок.Количество() > 0 Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Ранее удаленные строки № %1 не были добавлены в Запрос на автоперевозку по причине несоответствия данных для добавления. Проверьте отсутствие таких контейнеров в Услугах текущей и других Заявок, а также наличие статуса «Силами Евросиб» для соответствующего этапа автоперевозки",СтрСоединить(МассивНеВосстановленныхНомеровСтрок,",")));
		КонецЕсли;
		
		УстановитьВидимостьКомандыДобавитьУдаленныеКТКВЗапрос();
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	ОповеститьОЗаписиНового(Объект.Ссылка);
	
	ДанныеХран = ПолучитьИзВременногоХранилища(АдресХранильщаОтметки);
	Если ДанныеХран <> Неопределено Тогда
		Для Каждого СтрокаД Из ДанныеХран Цикл
			СтруктураПоиска = Новый Структура("ИдентификаторСтрокиТЧ",СтрокаД);
			НайденныеСтроки = Объект.Контейнеры.НайтиСтроки(СтруктураПоиска);
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				НайденнаяСтрока.Отметка = Истина;
			КонецЦикла;	
		КонецЦикла;
	КонецЕсли;
	Оповестить("ТребуетсяПеречитатьУказанныйДокумент", Объект.Заявка); //ДИТ Шевченко А.В. US 62482 ТА 72737 19.07.2023 -Начало
	УстановитьПросмотрСтатусОтправкиЗапросаНаТерминалВыдачи(); //ДИТ Шевченко А.В. US 62487 ТА 68012 04.05.2023 
	
	// ДИТ US 76935 ТА 78648 Сержантова А.С. Начало: 11.12.2023
	ОповеститьОбИзменении(Тип("СправочникСсылка.КлючиАналитикиПеревозки"));   
	Оповестить("НеобходимоОбновитьДанныеКлючейАналитикиПеревозки", , ЭтаФорма);
	// ДИТ US 76935 ТА 78648 Сержантова А.С. Конец: 11.12.2023       
	
	//// ДИТ US 80736 ТА 81088 Сержантова А.С. Начало: 01.03.2024
	//Если БылоОбновлениеИзЗаявки Тогда
	//	ТекущийИсполнитель_Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Выполнен");
	//КонецЕсли;
	//// ДИТ US 80736 ТА 81088 Сержантова А.С. Конец: 01.03.2024  
	// ДИТ US 81881 ТА 84217 Сержантова А.С. Начало: 26.04.2024
	СтатусАктивнойЗадачи = Неопределено;
	Для каждого СтрСостояния Из Объект.Состояния Цикл
		Если СтрСостояния.Статус <> ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Выполнен") Тогда
			СтатусАктивнойЗадачи = СтрСостояния.Статус;	
			Прервать;
		КонецЕсли;
	КонецЦикла; 
	Если СтатусАктивнойЗадачи = Неопределено Тогда
	    ТекущийИсполнитель_Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Выполнен");
	Иначе	
	    ТекущийИсполнитель_Статус = СтатусАктивнойЗадачи;
	КонецЕсли;
	// ДИТ US 81881 ТА 84217 Сержантова А.С. Конец: 26.04.2024
	
	// ДИТ US 82176 ТА 82559 Сержантова А.С. Начало: 28.03.2024
    ЭтаФорма.МодифицированностьФормы = Ложь;
	// ДИТ US 82176 ТА 82559 Сержантова А.С. Конец: 28.03.2024
КонецПроцедуры

