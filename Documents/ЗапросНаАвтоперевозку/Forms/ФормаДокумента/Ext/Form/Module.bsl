&НаСервере
Процедура УстановитьПодсветкуСтрокПоИзменениям()

	МассивИмен = Новый Массив;	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();	
	ИмяПодчиненногоЭлемента(Элементы.Контейнеры.ПодчиненныеЭлементы,МассивИмен);
	Для Каждого МассивИмя Из МассивИмен Цикл
		ПолеЭлемента = ЭлементУО.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(МассивИмя);
	КонецЦикла;  
	
	ГруппаОтбора = ЭлементУО.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ; 
	
	ОтборЭлемента = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Контейнеры.ВерсияКлючаАналитикиОтправленоВТЛ");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	ОтборЭлемента = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Контейнеры.ОбновленыИсходныеДанные");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;  
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.ЖелтоЗеленый);

КонецПроцедуры

&НаСервере
Процедура УстановитьПросмотрСтатусОтправкиЗапросаНаТерминалВыдачи(МассивКлючей=Неопределено,УстановитьТолькоПризнакПросмотра = Истина,НовоеЗначение = Неопределено) //ДИТ Шевченко А.В. US 62487 ТА 68012 04.05.2023
	
	Если МассивКлючей = Неопределено Тогда
		МассивКлючей = Объект.Контейнеры.Выгрузить(,"КлючАналитикиПеревозки").ВыгрузитьКолонку("КлючАналитикиПеревозки");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КлючиАналитикиПеревозки.Контейнер КАК Контейнер,
		|	КлючиАналитикиПеревозки.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_КлючКонтейнер
		|ИЗ
		|	Справочник.КлючиАналитикиПеревозки КАК КлючиАналитикиПеревозки
		|ГДЕ
		|	КлючиАналитикиПеревозки.Контейнер <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
		|	И  КлючиАналитикиПеревозки.Ссылка В (&МассивКлючей)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_КлючКонтейнер.Ссылка КАК Ссылка,
		|	ВТ_КлючКонтейнер.Контейнер КАК Контейнер,
		|	стоки_ТекущиеДанныеСрезПоследних.тек_ВидСобственности КАК тек_ВидСобственности
		|ИЗ
		|	ВТ_КлючКонтейнер КАК ВТ_КлючКонтейнер
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.стоки_ТекущиеДанные.СрезПоследних КАК стоки_ТекущиеДанныеСрезПоследних
		|		ПО ВТ_КлючКонтейнер.Контейнер = стоки_ТекущиеДанныеСрезПоследних.КТК";
	
	Запрос.УстановитьПараметр("МассивКлючей",МассивКлючей);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПринадлежностьТЕ = АРМ_Сервер.ОпределитьПринадлежностьПоВидуСобственности(ВыборкаДетальныеЗаписи.тек_ВидСобственности);
		СтруктураПоискаСтроки = Новый Структура("КлючАналитикиПеревозки",ВыборкаДетальныеЗаписи.Ссылка);
		НайденнаяСтрока = Объект.Контейнеры.НайтиСтроки(СтруктураПоискаСтроки);
		
		НайденнаяСтрока[0].УсловияДоступностиСтатусаОтправкиЗапросаНаТерминалВыдачи = Объект.ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПерваяМиля И ПринадлежностьТЕ = Перечисления.ПринадлежностьТЕ.КТЕвросиба;
		НайденнаяСтрока[0].УсловияДоступностиСтатусаОтправкиЗапросаНаТерминалВыдачи = Объект.ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПерваяМиля И ЗначениеЗаполнено(НайденнаяСтрока[0].Релиз) и НЕ Пользователи.РолиДоступны("ПолныеПрава",, Ложь);
		
		Если НЕ УстановитьТолькоПризнакПросмотра И НЕ НайденнаяСтрока[0].УсловияДоступностиСтатусаОтправкиЗапросаНаТерминалВыдачи Тогда
			НайденнаяСтрока[0].СтатусОтправкиЗапросаНаТерминалВыдачи = НовоеЗначение;
		КонецЕсли
		
	КонецЦикла;
КонецПроцедуры	

&НаСервере
Процедура УстановитьТолькоПросмотрПоСтатусуЗаказа()
	СписокСтатусов = Новый СписокЗначений;
	СписокСтатусов.Добавить(Перечисления.СтатусЗаказаНаТс.ВыданВРейс);
	СписокСтатусов.Добавить(Перечисления.СтатусЗаказаНаТс.Закрыт);
	МассивИмен = Новый Массив;	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();	
	ИмяПодчиненногоЭлемента(Элементы.Контейнеры.ПодчиненныеЭлементы,МассивИмен);
	Для Каждого МассивИмя Из МассивИмен Цикл
		ПолеЭлемента = ЭлементУО.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(МассивИмя);
	КонецЦикла;
	ГруппаОтбора1 = ЭлементУО.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора1.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	
	ОтборЭлемента = ГруппаОтбора1.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Контейнеры.СтатусЗаказаНаТС");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	ОтборЭлемента.ПравоеЗначение = СписокСтатусов;
	
	ОтборЭлемента = ГруппаОтбора1.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Контейнеры.СтатусЗапросаНаАвтоперевозку");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.СтатусЗапросаНаПеревозку.Отменен;
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	// ДИТ US 76935 ТА 78648 Сержантова А.С. Начало: 21.12.2023
	Если не Пользователи.РолиДоступны("ПолныеПрава") Тогда       
		ЭлементУО = УсловноеОформление.Элементы.Добавить();    
		ПолеЭлемента = ЭлементУО.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("КонтейнерыСтатусЗапросаНаАвтоперевозку"); 
		ОтборЭлемента = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Контейнеры.СтатусЗапросаНаАвтоперевозку");
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;  
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина); 	
	КонецЕсли;
	// ДИТ US 76935 ТА 78648 Сержантова А.С. Конец: 21.12.2023
КонецПроцедуры

&НаСервере
Процедура ИмяПодчиненногоЭлемента(ПодчиненныеЭлементы,МассивИмен)
	Для Каждого Элем Из ПодчиненныеЭлементы Цикл
		Если Элем.Имя = "КонтейнерыОтметка" Тогда
			Продолжить;
		КонецЕсли;
		МассивИмен.Добавить(Элем.Имя);
		Если ТипЗнч(Элем) = Тип("ГруппаФормы") Тогда
			ИмяПодчиненногоЭлемента(Элем.ПодчиненныеЭлементы,МассивИмен);
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры	

