&НаСервере
Процедура УстановитьУсловноеОформлениеШапки(Красный=0,Зеленый=0,Синий=0)
	ЦветПодсветки = Новый Цвет(Красный, Зеленый, Синий);
	Для Каждого СписокЗнч Из СписокРекОформленияШапки Цикл 
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, СписокЗнч.Значение, "ЦветТекстаЗаголовка", ЦветПодсветки);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, СписокЗнч.Значение, "ЦветТекста", ЦветПодсветки);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, СписокЗнч.Значение, "ЦветРамки", ЦветПодсветки);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполниитьПоУпрощенномуАлгоритму(ИтоговаяТаблица,ТаблицаУслуг)
	Для Каждого СтрокаТчУслуга Из ТаблицаУслуг Цикл	
			НовСтрока = ИтоговаяТаблица.Добавить(); 
			ЗаполнитьЗначенияСвойств(НовСтрока,СтрокаТчУслуга);
			НовСтрока.ТерминалСдачи = ПолучитьТерминалСдачиПоСтокуСдачиИзРелиза(СтрокаТчУслуга.СтокСдачи); //ДИТ Шевченко А.В. 60951 11.11.2022
			НовСтрока.СтатусЗапросаНаАвтоперевозку = Перечисления.СтатусЗапросаНаПеревозку.Черновик;
			НовСтрока.СтатусОтправкиЗапросаНаТерминалВыдачи = Перечисления.СтатусОтправкиЗапросаНаТерминалВыдачи.НеОтправлен; //ДИТ Шевченко А.В. US 62487 ТА 68012 04.05.2023
	КонецЦикла;
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьСлужебныеСообщения() //ДИТ Шевченко А.В. 59965 28.11.22
	
	ЕстьНаВыполнении = Ложь;
	МассивНомеровСтрок = новый Массив;
	Для Каждого СтрокаС Из Объект.Состояния Цикл
		Если СтрокаС.Состояние = Справочники.Состояния.ПередатьКлиентуДанныеПоАвтоперевозке Тогда
			Если СтрокаС.Статус = Перечисления.СтатусыЭтапов.НаВыполнение Тогда
				ЕстьНаВыполнении = Истина;
				Прервать;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	
	Если ЕстьНаВыполнении Тогда
		МассивНомеровСтрок = ПолучитьНомераСтрокДляПередачиКлиентуДанныхПоАвтоперевозке();	
	КонецЕсли;	

	Если МассивНомеровСтрок.Количество() > 0 Тогда
		СтрСообщение = СтрШаблон("По строке %1 появились/изменились данные по автоперевозке, необходимо направить информацию клиенту, сформировав печатную форму запроса на автоперевозку",СтрСоединить(МассивНомеровСтрок,","));
		Элементы.СлужебныеСообщения.Заголовок = СтрСообщение;
		Элементы.СлужебныеСообщения.Видимость = Истина;
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Функция ПолучитьНомераСтрокДляПередачиКлиентуДанныхПоАвтоперевозке()
	
	МассивНомеровСтрок = Новый Массив;
	
	МассивКолонокДляПроверки = Новый Массив;
	МассивКолонокДляПроверки.Добавить("Перевозчик");
	МассивКолонокДляПроверки.Добавить("НомерАвто");
	МассивКолонокДляПроверки.Добавить("ПаспортныеДанные");
	МассивКолонокДляПроверки.Добавить("ФИОВодителя");
		
	СтруктураПоиска = Новый Структура("СтатусЗаказаНаТС",Перечисления.СтатусЗаказаНаТс.ГотовКВыдачеВРейс);
	НайденныеСтроки = Объект.Контейнеры.НайтиСтроки(СтруктураПоиска);
	Для Каждого СтрокаТЧ Из НайденныеСтроки Цикл
		ОбЗапрос = РеквизитФормыВЗначение("Объект");
		ПринадлежностьТЕ = ОбЗапрос.ПолучитьПринадлежностьТЕКТКПоЗаявке(Объект.Заявка,СтрокаТЧ.КлючАналитикиПеревозки.Контейнер,СтрокаТЧ.ИдентификаторСтрокиУслуги);
		Если ПринадлежностьТЕ = Неопределено ИЛИ ПринадлежностьТЕ = Перечисления.ПринадлежностьТЕ.КТЕвросиба Тогда
			Продолжить;
		КонецЕсли;			
		СтруктураПоиска = Новый Структура("ИдентификаторСтрокиТЧ",СтрокаТч.ИдентификаторСтрокиТЧ);
		НайденныеСтрокиОфор = ТаблицаОформленияКолонок.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтрокиОфор.Количество() > 0 Тогда
			МассивКолонок = СтрРазделить(НайденныеСтрокиОфор[0].ИменаКолонок,";");
			Для Каждого ПолеПроверки Из МассивКолонокДляПроверки Цикл
				Если МассивКолонок.Найти(ПолеПроверки) <> Неопределено Тогда
					МассивНомеровСтрок.Добавить(СтрокаТЧ.НомерСтроки);
					Прервать;
				КонецЕсли;	
			КонецЦикла;		
		КонецЕсли;				
	КонецЦикла;
	
	Возврат МассивНомеровСтрок;
	
КонецФункции	

&НаКлиенте
