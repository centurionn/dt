		|ИЗ
		|	ВТ_ТаблицаГуид КАК ВТ_ТаблицаГуид
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗапросНаАвтоперевозку.Контейнеры КАК ЗапросНаАвтоКонтейнеры
		|		ПО ВТ_ТаблицаГуид.ИдентификаторСтрокиЗапроса = ЗапросНаАвтоКонтейнеры.ИдентификаторСтрокиЗапроса
		|			И (НЕ ЗапросНаАвтоКонтейнеры.Ссылка.ПометкаУдаления)
		|ГДЕ
		|	ЗапросНаАвтоКонтейнеры.КлючАналитикиПеревозки <> ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПеревозки.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("ТаблицаКлючейПоЗапросамИзГуидов",ТаблицаКлючейПоЗапросамИзГуидов);
	
	ТаблицаКлючейПоЗапросамИзГуидов = Запрос.Выполнить().Выгрузить();	
	
КонецПроцедуры	

&НаСервере
Процедура ПолучитьКлючиПоРелизам(ТаблицаРелизов)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаРелизов.Релиз КАК Релиз
		|ПОМЕСТИТЬ ВТ_ТаблицаРелизов
		|ИЗ
		|	&ТаблицаРелизов КАК ТаблицаРелизов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_ТаблицаРелизов.Релиз КАК Релиз,
		|	РелизКлиентаКонтейнеры.КлючАналитикиПеревозки КАК Ключ,
		|	ЛОЖЬ КАК Обработан
		|ИЗ
		|	ВТ_ТаблицаРелизов КАК ВТ_ТаблицаРелизов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РелизКлиента.Контейнеры КАК РелизКлиентаКонтейнеры
		|		ПО ВТ_ТаблицаРелизов.Релиз = РелизКлиентаКонтейнеры.Ссылка
		|ГДЕ
		|	РелизКлиентаКонтейнеры.КлючАналитикиПеревозки <> ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПеревозки.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("ТаблицаРелизов",ТаблицаРелизов);
	
	ТаблицаРелизов = Запрос.Выполнить().Выгрузить();
	
КонецПроцедуры	

