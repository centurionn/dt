&НаКлиенте
Процедура КонтейнерыГрузПриИзменении(Элемент) //ДИТ Шевченко А.В. US 62421 TA 64345 20.01.23
	ТекД = Элементы.Контейнеры.ТекущиеДанные;
		
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда	
		ТекД.ОбновленыИсходныеДанные = Истина;
		МассивИзменяемыхИдентификаторов = Новый Массив;
		МассивИзменяемыхИдентификаторов.Добавить(ТекД.ИдентификаторСтрокиТЧ);
		ПроверитьИзменениеИОформить(Объект.Ссылка,"Груз",ТекД.Груз,"ИдентификаторСтрокиТЧ",МассивИзменяемыхИдентификаторов,"Контейнеры",ЛОЖЬ);
	КонецЕсли;
	
	Если ТекД.Груз <> ПредопределенноеЗначение("Справочник.Грузы.СборнаяКонтейнернаяОтправка") Тогда
		СтруктураПоиска = Новый Структура("Ключ",ТекД.КлючАналитикиПеревозки);
		МассивСтрокДляУдаления = ДетализацияПоГрузу.НайтиСтроки(СтруктураПоиска);
		Для Каждого ЗнчМ Из МассивСтрокДляУдаления Цикл
			ДетализацияПоГрузу.Удалить(ЗнчМ);
		КонецЦикла;	
		ОбновитьВидимостьДетализацияПоГрузу(); 
	// ДИТ US 78234 ТА 78241 Сержантова А.С. Начало: 12.12.2023   
	Иначе
		Если ДетализацияПоГрузу.Количество() Тогда
			Найдено = ДетализацияПоГрузу.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки",ТекД.КлючАналитикиПеревозки));
			КоличествоМест = 0;
			ВесГруза = 0;
			Для Каждого СтрНайдено Из Найдено Цикл 
				КоличествоМест = КоличествоМест + СтрНайдено.КоличествоМест;
				ВесГруза = ВесГруза + СтрНайдено.ВесГруза;
			КонецЦикла;	 
			ТекСтрока = Объект.Контейнеры.НайтиПоИдентификатору(Элементы.Контейнеры.ТекущаяСтрока);     
			ТекСтрока.ВесГрузаНетто = ВесГруза;
			ТекСтрока.КоличествоМест = КоличествоМест;
		КонецЕсли;
	// ДИТ US 78234 ТА 78241 Сержантова А.С. Конец: 12.12.2023
	КонецЕсли;  
	// ДИТ US 76935 ТА 78648 Сержантова А.С. Начало: 11.12.2023
	// Было:
	//ДобавитьЗначениеРеквизитаВКлюч(ТекД.КлючАналитикиПеревозки,ТекД.Груз,"Груз",,ДетализацияПоГрузу,ТекД.ВерсияКлюча);   
	// ДИТ US 76935 ТА 78648 Сержантова А.С. Конец: 11.12.2023
	Если ТекД <> неопределено Тогда
		ОбновитьВидимостьДетализацияПоГрузу();
	КонецЕсли;
КонецПроцедуры 

