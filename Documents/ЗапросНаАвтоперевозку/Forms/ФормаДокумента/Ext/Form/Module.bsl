		//Евросиб Коханенко Н.А. 07.06.2024 )) #83866
		// ДИТ BUG 76919 ТА 77021 Сержантова А.С. Конец: 17.11.2023
			МассивНомераСтатусЗапросаНаАвтоперевозкуОтменен.Добавить(СтрокаТч.НомерСтроки);
			СтрокаТч.Отметка = Ложь;
		КонецЕсли;
		Если СтрокаТч.СтатусЗапросаНаАвтоперевозку = ПредопределенноеЗначение("Перечисление.СтатусЗапросаНаПеревозку.Отправлен") И НЕ СтрокаТч.ОбновленыИсходныеДанные Тогда
			МассивНомераОтправленыхБезИзменений.Добавить(СтрокаТч.НомерСтроки);
			СтрокаТч.Отметка = Ложь;
