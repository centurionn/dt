&НаКлиенте
Процедура ПослеВводаАдреса(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	ВыделенныеСтроки = Элементы.Контейнеры.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() > 1 Тогда
		Для Каждого НомерВыделеннойСтрокиТЧКонтейнеры Из ВыделенныеСтроки Цикл
			
			ВыделеннаяСтрокаКТК = Объект.Контейнеры[НомерВыделеннойСтрокиТЧКонтейнеры];
			ВыделеннаяСтрокаКТК.ОбновленыИсходныеДанные = Истина;
			
			НайденныеСтроки = Объект.ДополнительныеАдресаКлиента.НайтиСтроки(Новый Структура("QueryID", ВыделеннаяСтрокаКТК.ИдентификаторСтрокиТЧ));
			КоличествоНайденныхСтрок = НайденныеСтроки.Количество(); 
			Если КоличествоНайденныхСтрок = 0 Тогда
				ИзменитьПервуюСтрокуВДополнительныеАдресаКлиента(ВыделеннаяСтрокаКТК.ИдентификаторСтрокиТЧ, ВыделеннаяСтрокаКТК.АдресКлиента, ВыделеннаяСтрокаКТК.ТипОперацииНаСкладеКлиента);
				КоличествоНайденныхСтрок = КоличествоНайденныхСтрок + 1;
			КонецЕсли;
			
			НоваяСтрокаТЧДопАдреса = Объект.ДополнительныеАдресаКлиента.Добавить();
			НоваяСтрокаТЧДопАдреса.ТипОперацииНаСкладеКлиента = Параметр1.ТипОперацииНаСкладеКлиента; 
			НоваяСтрокаТЧДопАдреса.QueryID = ВыделеннаяСтрокаКТК.ИдентификаторСтрокиТЧ;
			НоваяСтрокаТЧДопАдреса.АдресСкладаКлиента = Параметр1.АдресСкладаКлиента;
			НоваяСтрокаТЧДопАдреса.Регион = ПолучитьЗначениеТопонима(НоваяСтрокаТЧДопАдреса.АдресСкладаКлиента, "province");
			НоваяСтрокаТЧДопАдреса.Номер = КоличествоНайденныхСтрок + 1;
			
		КонецЦикла; 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеАдресаКлиентаПослеУдаления(Элемент)
	//перенумерация после удаления строки
	НайденныеСтроки = Объект.ДополнительныеАдресаКлиента.НайтиСтроки(Новый Структура("QueryID",Элементы.ДополнительныеАдресаКлиента.ОтборСтрок.QueryID));
	ТекНомер = 1; 
	Для Каждого ТекСтрока Из НайденныеСтроки Цикл
		ТекСтрока.Номер = ТекНомер;
