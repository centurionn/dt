Процедура КонтейнерыНеТребуетсяАдресПриИзменении(Элемент)
	ОбновитьДоступностьКомандыДобавитьАдресКлиента();
КонецПроцедуры

&НаКлиенте
Процедура ДействияКонтейнерыАдресКлиентаПриИзменении();
	//перенесено из обработчика КонтейнерыАдресКлиентаПриИзменении 
	//ДИТ Шевченко А.В. US 62421 ТА 67386 18.05.2023
	ТекД = Элементы.Контейнеры.ТекущиеДанные;
		Если ЗначениеЗаполнено(Объект.Ссылка) Тогда	
			ТекД.ОбновленыИсходныеДанные = Истина;
			МассивИзменяемыхИдентификаторов = Новый Массив;
			МассивИзменяемыхИдентификаторов.Добавить(ТекД.ИдентификаторСтрокиТЧ);
			ПроверитьИзменениеИОформить(Объект.Ссылка,"АдресКлиента",ТекД.АдресКлиента,"ИдентификаторСтрокиТЧ",МассивИзменяемыхИдентификаторов,"Контейнеры",ЛОЖЬ);
		КонецЕсли;    
	// ДИТ US 76935 ТА 78648 Сержантова А.С. Начало: 11.12.2023
	// Было:
	//ДобавитьЗначениеРеквизитаВКлюч(ТекД.КлючАналитикиПеревозки,ТекД.АдресКлиента,"АдресКлиента",Объект.ЭтапПеревозки,,ТекД.ВерсияКлюча); 
	// ДИТ US 76935 ТА 78648 Сержантова А.С. Конец: 11.12.2023

 КонецПроцедуры
//Евросиб Коханенко Н.А. 05.10.2023 )) US 75549 TA 75773 

&НаКлиенте
Процедура КонтейнерыДополнительнаяИнформацияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОпОп = Новый ОписаниеОповещения("ОбработкаВводаДополнительнаяИнформация", ЭтаФорма,Элемент.ТекстРедактирования);
	ПоказатьВводСтроки(ОпОп, Элемент.ТекстРедактирования,"Дополнительная информация",,Истина);
КонецПроцедуры

&НаКлиенте
Процедура КонтейнерыПриАктивизацииСтроки(Элемент)
	Если Элементы.Контейнеры.ТекущиеДанные <> Неопределено Тогда
		ОбновитьВидимостьДетализацияПоГрузу();
		ОбновитьДоступностьУдаленияСтрокиИСозданияДопЗапроса(); 
		Элементы.ДетализацияПоГрузу.ОтборСтрок = Новый ФиксированнаяСтруктура("Ключ", Элементы.Контейнеры.ТекущиеДанные.КлючАналитикиПеревозки);		
		Элементы.КонтейнерыСтатусОтправкиЗапросаНаТерминалВыдачи.ТолькоПросмотр = Элементы.Контейнеры.ТекущиеДанные.УсловияДоступностиСтатусаОтправкиЗапросаНаТерминалВыдачи; //ДИТ Шевченко А.В. US 62487 ТА 68012 04.05.2023
		//Евросиб Коханенко Н.А. 04.10.2023 (( US 75549 TA 75773 
		ОбновитьДоступностьКомандыДобавитьАдресКлиента();  
		Элементы.ДополнительныеАдресаКлиента.ОтборСтрок = Новый ФиксированнаяСтруктура("QueryID", Элементы.Контейнеры.ТекущиеДанные.ИдентификаторСтрокиТЧ);
		//Евросиб Коханенко Н.А. 04.10.2023 )) US 75549 TA 75773 
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура КонтейнерыПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура КонтейнерыПриИзменении(Элемент)
	
	ТекД = Элементы.Контейнеры.ТекущиеДанные;
	ЭтоПолеАдреса = Ложь;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;	   
	
	// ++ ДИТ BUG 76919 ТА 77021 Сержантова А.С. 20.11.2023
    //Евросиб Коханенко Н.А. 11.02.2026 (( BUG 130030 TA 130694 
    //перенес выставление Модифицированности в обработчик КонтейнерыПриОкончанииРедактирования
	//в ней осуществляется проверка, игнорирующая изменения в колонках "Отметка" и "Обновлены исходные данные"
	//ЭтаФорма.Модифицированность = Истина;   
	//МодифицированностьФормы = Истина;
	//Евросиб Коханенко Н.А. 11.02.2026 )) BUG 130030 TA 130694 
	// -- ДИТ BUG 76919 ТА 77021 Сержантова А.С. 20.11.2023
	
	МассивИзменяемыхИдентификаторов = Новый Массив;
	МассивИзменяемыхИдентификаторов.Добавить(ТекД.ИдентификаторСтрокиТЧ);
	МассивНеОформляемыхПолей = Новый Массив;
	
	МассивНеОформляемыхПолей.Добавить("Отметка");  
	// ДИТ US 78233 TA 79764 Сержантова А.С. Начало: 26.01.2024
	// Было:
	//МассивНеОформляемыхПолей.Добавить("Груз");
	// ДИТ US 78233 TA 79764 Сержантова А.С. Конец: 26.01.2024
	МассивКлючей = Новый Массив;
	
	
	Если ЗаполнятьВниз Тогда
				
		ИмяТЧ = Элемент.Имя;
		ИмяПоля = Сред(Элемент.ТекущийЭлемент.Имя, СтрДлина(ИмяТЧ)+1);
		
		Если СтрНайти(ИмяПоля,"ИнформацияПолеКонтейнеры") > 0 Тогда
			Возврат;
		КонецЕсли;	
		
		НовоеЗначение = ТекД[ИмяПоля];
		
		СтрокаПройдена = Ложь;		
		Для Сч = 0 По Объект[ИмяТЧ].Количество() - 1 Цикл
			РезПроверки = Элементы.Контейнеры.ПроверитьСтроку(Объект[ИмяТЧ][Сч].ПолучитьИдентификатор());
			
			СтрокаПройдена = СтрокаПройдена ИЛИ Элементы.Контейнеры.ТекущаяСтрока = Объект[ИмяТЧ][Сч].ПолучитьИдентификатор();
			
			Если РезПроверки = Истина И СтрокаПройдена = Истина Тогда
				
				Если Элементы.Контейнеры.ТекущаяСтрока = Объект[ИмяТЧ][Сч].ПолучитьИдентификатор() Тогда      
					// ДИТ US 76935 ТА 78648 Сержантова А.С. Начало: 19.12.2023 - в первой строке тоже ставим, что исх. данные обновлены
					Если ИмяПоля <> "Отметка" Тогда
						Объект[ИмяТЧ][Сч].ОбновленыИсходныеДанные = Истина;
					КонецЕсли;
					// ДИТ US 76935 ТА 78648 Сержантова А.С. Конец: 19.12.2023
					Продолжить;
				КонецЕсли;	
				
				Если Объект[ИмяТЧ][Сч].СтатусЗаказаНаТС = ПредопределенноеЗначение("Перечисление.СтатусЗаказаНаТс.ВыданВРейс") ИЛИ Объект[ИмяТЧ][Сч].СтатусЗаказаНаТС = ПредопределенноеЗначение("Перечисление.СтатусЗаказаНаТс.Закрыт") Тогда
					Продолжить;	
				КонецЕсли;
				
				Если Объект[ИмяТЧ][Сч].СтатусЗапросаНаАвтоперевозку = ПредопределенноеЗначение("Перечисление.СтатусЗапросаНаПеревозку.Отменен") Тогда
					Продолжить;	
				КонецЕсли;
				
				Если ИмяПоля = "НеТребуетсяТерминалВыдачи" Тогда	
					МожноУстановить = ПроверитьВозможностьУстановкиПоляНеТребуется(Объект[ИмяТЧ][Сч],НЕ НовоеЗначение);
					Если НЕ МожноУстановить Тогда
						Продолжить;
					КонецЕсли;
					Если ТекД[ИмяПоля] Тогда
						Объект[ИмяТЧ][Сч].СтатусОтправкиЗапросаНаТерминалВыдачи = ПредопределенноеЗначение("Перечисление.СтатусОтправкиЗапросаНаТерминалВыдачи.НеТребуется");
					Иначе
						Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
							Объект[ИмяТЧ][Сч].СтатусОтправкиЗапросаНаТерминалВыдачи = ПолучитьСтатусОтправкиЗапросаНаТерминалВыдачиДоИзменения(Объект.Ссылка,Объект[ИмяТЧ][Сч].КлючАналитикиПеревозки);
							Если Объект[ИмяТЧ][Сч].СтатусОтправкиЗапросаНаТерминалВыдачи = ПредопределенноеЗначение("Перечисление.СтатусОтправкиЗапросаНаТерминалВыдачи.НеТребуется") Тогда
								Объект[ИмяТЧ][Сч].СтатусОтправкиЗапросаНаТерминалВыдачи = ПредопределенноеЗначение("Перечисление.СтатусОтправкиЗапросаНаТерминалВыдачи.НеОтправлен");
							КонецЕсли;	
						Иначе
							Объект[ИмяТЧ][Сч].СтатусОтправкиЗапросаНаТерминалВыдачи = ПредопределенноеЗначение("Перечисление.СтатусОтправкиЗапросаНаТерминалВыдачи.НеОтправлен");
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				Если ИмяПоля = "НеТребуетсяТерминалСдачи" Тогда
					МожноУстановить = ПроверитьВозможностьУстановкиПоляНеТребуется(Объект[ИмяТЧ][Сч],НЕ НовоеЗначение);
					Если НЕ МожноУстановить Тогда
						Продолжить;
					КонецЕсли;	
				КонецЕсли;
				Если ИмяПоля = "НеТребуетсяАдрес" Тогда
					
					МожноУстановить = ПроверитьВозможностьУстановкиПоляНеТребуется(Объект[ИмяТЧ][Сч],НЕ НовоеЗначение);
					Если НЕ МожноУстановить Тогда
						Продолжить;
					КонецЕсли;	
				КонецЕсли;
				
				Если ИмяПоля = "СтатусОтправкиЗапросаНаТерминалВыдачи" Тогда
					МассивКлючей.Добавить(Объект[ИмяТЧ][Сч].КлючАналитикиПеревозки);	
				КонецЕсли;	
				
				Объект[ИмяТЧ][Сч][ИмяПоля] = НовоеЗначение;
				//ДИТ Шевченко А.В. US 62421 ТА 67386 18.05.2023 -Начало
				Если ИмяПоля = "АдресКлиента" Тогда
					//Евросиб - АСуслов 14.07.2023 15:55:50 #локации
					//(
					//ДобавитьЗначениеРеквизитаВКлюч(Объект[ИмяТЧ][Сч].КлючАналитикиПеревозки,НовоеЗначение,"АдресКлиента",Объект.ЭтапПеревозки,Объект[ИмяТЧ][Сч].ВерсияДанных);
					// ДИТ US 76935 ТА 78648 Сержантова А.С. Начало: 11.12.2023
					// Было:
					//ДобавитьЗначениеРеквизитаВКлюч(Объект[ИмяТЧ][Сч].КлючАналитикиПеревозки,НовоеЗначение,"АдресКлиента",Объект.ЭтапПеревозки,Объект[ИмяТЧ][Сч].ВерсияКлюча);
					// ДИТ US 76935 ТА 78648 Сержантова А.С. Конец: 11.12.2023
					//)
					//Евросиб - АСуслов 14.07.2023 15:55:52 #локации
				КонецЕсли;	
				//ДИТ Шевченко А.В. US 62421 ТА 67386 18.05.2023 -Конец 
				// ДИТ ТА 72097 BUG 68407 Сержантова А.С. Начало: 29.06.2023
				Если ИмяПоля = "Груз" Тогда   
					Если НовоеЗначение <> ПредопределенноеЗначение("Справочник.Грузы.СборнаяКонтейнернаяОтправка") Тогда
						СтруктураПоиска = Новый Структура("Ключ",Объект[ИмяТЧ][Сч].КлючАналитикиПеревозки);
						МассивСтрокДляУдаления = ДетализацияПоГрузу.НайтиСтроки(СтруктураПоиска);
						Для Каждого ЗнчМ Из МассивСтрокДляУдаления Цикл
							ДетализацияПоГрузу.Удалить(ЗнчМ);
						КонецЦикла;	
					КонецЕсли;
					// ДИТ US 76935 ТА 78648 Сержантова А.С. Начало: 11.12.2023
					// Было:
					//ДобавитьЗначениеРеквизитаВКлюч(Объект[ИмяТЧ][Сч].КлючАналитикиПеревозки,НовоеЗначение,"Груз",,ДетализацияПоГрузу,Объект[ИмяТЧ][Сч].ВерсияКлюча);
					//ДобавитьЗначениеРеквизитаВКлюч(Объект[ИмяТЧ][Сч].КлючАналитикиПеревозки,НовоеЗначение,"Груз",,,Объект[ИмяТЧ][Сч].ВерсияКлюча);
					// ДИТ US 76935 ТА 78648 Сержантова А.С. Конец: 11.12.2023
				КонецЕсли;
				// ДИТ ТА 72097 BUG 68407 Сержантова А.С. Конец: 29.06.2023
				
				// ДИТ US 78233 TA 78240 Сержантова А.С. Начало: 10.01.2024
				// Было:
				//Объект[ИмяТЧ][Сч].ОбновленыИсходныеДанные = Истина; 
				//Стало:
				Если ИмяПоля <> "Отметка" Тогда
					Объект[ИмяТЧ][Сч].ОбновленыИсходныеДанные = Истина;
				КонецЕсли;
				// ДИТ US 78233 TA 78240 Сержантова А.С. Конец: 10.01.2024
				
				МассивИзменяемыхИдентификаторов.Добавить(Объект[ИмяТЧ][Сч].ИдентификаторСтрокиТЧ);
				
			КонецЕсли; 
			
		КонецЦикла;
		
	КонецЕсли;
	
	УстановитьВидимостьКомандыДобавитьУдаленныеКТКВЗапрос();
	
	ИмяТЧ = Элемент.Имя;
	ИмяПоля = Сред(Элемент.ТекущийЭлемент.Имя, СтрДлина(ИмяТЧ)+1);
	
	Если ИмяПоля = "НеТребуетсяТерминалВыдачи" ИЛИ ИмяПоля = "НеТребуетсяТерминалСдачи" ИЛИ ИмяПоля = "НеТребуетсяАдрес" Тогда
		Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
			ТекД.ОбновленыИсходныеДанные = Истина;
			УстановитьОформлениеПоПолямНеТребуется(ИмяТЧ,ИмяПоля,ТекД,МассивИзменяемыхИдентификаторов,ЭтоПолеАдреса);
			Возврат;
		КонецЕсли;
	КонецЕсли;	
	
	Если ИмяПоля = "СтатусОтправкиЗапросаНаТерминалВыдачи" Тогда
		МассивКлючей.Добавить(ТекД["КлючАналитикиПеревозки"]);
		УстановитьПросмотрСтатусОтправкиЗапросаНаТерминалВыдачи(МассивКлючей,Ложь,ТекД[ИмяПоля]); //ДИТ Шевченко А.В. US 62487 ТА 68012 04.05.2023	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда	
		Если МассивНеОформляемыхПолей.Найти(ИмяПоля) = Неопределено Тогда
			ТекД.ОбновленыИсходныеДанные = Истина;
			ПроверитьИзменениеИОформить(Объект.Ссылка,ИмяПоля,ТекД[ИмяПоля],"ИдентификаторСтрокиТЧ",МассивИзменяемыхИдентификаторов,ИмяТЧ,ЭтоПолеАдреса);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОформлениеПоПолямНеТребуется(ИмяТЧ,ИмяПоля,ТекД,МассивИзменяемыхИдентификаторов,ЭтоПолеАдреса)
	
	Если ИмяПоля = "НеТребуетсяТерминалВыдачи" Тогда
		ЗначениеДляОтбора1 = ТекД["ТерминалВыдачи"];
		ЗначениеДляОтбора2 = ТекД["ТипОперацииНаТерминалеВыдачи"];
		Если ТекД[ИмяПоля] = Истина Тогда
			ЗначениеДляОтбора1 = ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
			ЗначениеДляОтбора2 = ПредопределенноеЗначение("Перечисление.ТипОперацииНаТерминале.ПустаяСсылка");
		КонецЕсли;	
		ПроверитьИзменениеИОформить(Объект.Ссылка,"ТерминалВыдачи",ЗначениеДляОтбора1,"ИдентификаторСтрокиТЧ",МассивИзменяемыхИдентификаторов,ИмяТЧ,ЭтоПолеАдреса);
		//ТекД["ТерминалВыдачи"] = ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
		ПроверитьИзменениеИОформить(Объект.Ссылка,"ТипОперацииНаТерминалеВыдачи",ЗначениеДляОтбора2,"ИдентификаторСтрокиТЧ",МассивИзменяемыхИдентификаторов,ИмяТЧ,ЭтоПолеАдреса);
		//ТекД["ТипОперацииНаТерминалеВыдачи"] = ПредопределенноеЗначение("Перечисление.ТипОперацииНаТерминале.ПустаяСсылка");
	КонецЕсли;
	Если ИмяПоля = "НеТребуетсяТерминалСдачи" Тогда
		ЗначениеДляОтбора1 = ТекД["ТерминалСдачи"];
		ЗначениеДляОтбора2 = ТекД["ТипОперацииНаТерминалеСдачи"];
		Если ТекД[ИмяПоля] = Истина Тогда
			ЗначениеДляОтбора1 = ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
			ЗначениеДляОтбора2 = ПредопределенноеЗначение("Перечисление.ТипОперацииНаТерминале.ПустаяСсылка");
		КонецЕсли;
		ПроверитьИзменениеИОформить(Объект.Ссылка,"ТерминалСдачи",ЗначениеДляОтбора1,"ИдентификаторСтрокиТЧ",МассивИзменяемыхИдентификаторов,ИмяТЧ,ЭтоПолеАдреса);
		//ТекД["ТерминалСдачи"] = ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
		ПроверитьИзменениеИОформить(Объект.Ссылка,"ТипОперацииНаТерминалеСдачи",ЗначениеДляОтбора2,"ИдентификаторСтрокиТЧ",МассивИзменяемыхИдентификаторов,ИмяТЧ,ЭтоПолеАдреса);
		//ТекД["ТипОперацииНаТерминалеСдачи"] = ПредопределенноеЗначение("Перечисление.ТипОперацииНаТерминале.ПустаяСсылка");
	КонецЕсли; 
	
	Если ИмяПоля = "НеТребуетсяАдрес" Тогда
		Если КонтактнаяИнформацияОписаниеДополнительныхРеквизитов.Количество() > 0 Тогда
			//ДИТ Шевченко А.В. US 62421 ТА 67386 18.05.2023 -начало
			//ИмяПоляАдреса = КонтактнаяИнформацияОписаниеДополнительныхРеквизитов[0].ИмяРеквизита;
			//ЗначениеДляОтбора1 = ТекД[ИмяПоляАдреса];
			ЗначениеДляОтбора1 = ТекД["АдресКлиента"];
