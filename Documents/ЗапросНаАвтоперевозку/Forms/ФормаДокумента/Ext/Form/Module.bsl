&НаКлиенте
Процедура ЗаменитьКонтейнерИКонтейнерФакт(Источник,Приемник,ИдентификаторСтрокиТЧ,ИмяПоля,НомерЗаказаНаТС = Неопределено,ТипКТК = Неопределено,КлючАналитикиПеревозки = Неопределено,ВерсияКлюча = неопределено)
	
	МассивИзменяемыхИдентификаторов = Новый Массив;
	МассивИзменяемыхИдентификаторов.Добавить(ИдентификаторСтрокиТЧ);
	
	Если ТипЗнч(Приемник) = Тип("СправочникСсылка.ТЕ") Тогда
		КТК = РаботаСКонтейнерамиСервер.НайтиКТК(Источник, Ложь);
		Если КТК <> Неопределено Тогда
			Приемник = КТК; 
			// ДИТ US 76935 ТА 78648 Сержантова А.С. Начало: 12.12.2023
			// Было:
			//ДобавитьЗначениеРеквизитаВКлюч(КлючАналитикиПеревозки,Приемник,"Контейнер",,,ВерсияКлюча); 
			// ДИТ US 76935 ТА 78648 Сержантова А.С. Конец: 12.12.2023
			Возврат;
		Иначе
			Приемник = РаботаСКонтейнерамиСервер.СоздатьКТК(Источник, ТипКТК);     
			// ДИТ US 76935 ТА 78648 Сержантова А.С. Начало: 12.12.2023
			// Было:
			//ДобавитьЗначениеРеквизитаВКлюч(КлючАналитикиПеревозки,Приемник,"Контейнер",,,ВерсияКлюча);
			// ДИТ US 76935 ТА 78648 Сержантова А.С. Конец: 12.12.2023
			МассивКонтейнеров = Новый Массив;
			МассивКонтейнеров.Добавить(Приемник);
			РаботаСКонтейнерамиСервер.ДобавитьИнформациюОбИсточникеСозднияКонтейнеров(МассивКонтейнеров, "Заказ на ТС № " + НомерЗаказаНаТС);
		КонецЕсли;
		
	Иначе
		Приемник = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(Источник,"Наименование");
		Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
			ПроверитьИзменениеИОформить(Объект.Ссылка,ИмяПоля,Приемник,"ИдентификаторСтрокиТЧ",МассивИзменяемыхИдентификаторов,"Контейнеры");
			ОбновленыИсходныеДанные = Истина;
		КонецЕсли;
	КонецЕсли;	
	
	
КонецПроцедуры	

&НаКлиенте
Процедура УдалитьКонтактнуюИнформациюПоТекДанным(ТекД,ИмяПоля = "")
	//ДИТ Шевченко А.В. US 62421 ТА 67386 18.05.2023
	//Если КонтактнаяИнформацияОписаниеДополнительныхРеквизитов.Количество() = 0 Тогда
