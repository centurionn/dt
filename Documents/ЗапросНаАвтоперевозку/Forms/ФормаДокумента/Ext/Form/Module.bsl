		|	ВТ_ДанныеУслуг.ИдентификаторСтрокиУслуги КАК ИдентификаторСтрокиУслуги,
		|	ВТ_ДанныеУслуг.Релиз КАК Релиз,
		|	ВТ_ДанныеУслуг.Релиз.СтокСдачи КАК СтокСдачи,
		|	ВТ_ДанныеУслуг.ПринадлежностьТЕ КАК ПринадлежностьТЕ,
		|	ВТ_ДанныеУслуг.ИдентификаторСтрокиРелизаКлиента КАК ИдентификаторСтрокиРелизаКлиента,    
		// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Начало: 22.03.2024
		|	ВТ_ДанныеУслуг.ИдентификаторСтрокиЗапросаНаКТК КАК ИдентификаторСтрокиЗапросаНаКТК, 
		// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Конец: 22.03.2024
		// ДИТ BUG 77633 ТА 77634 Сержантова А.С. Начало: 24.11.2023
		|	ВТ_ДанныеУслуг.НомерСтроки КАК НомерСтроки,
		// ДИТ BUG 77633 ТА 77634 Сержантова А.С. Конец: 24.11.2023   
		//Евросиб Коханенко Н.А. 24.04.2024 (( #84617 
		|	ВТ_ДанныеУслуг.УчетноеНаправление КАК УчетноеНаправление,
		//Евросиб Коханенко Н.А. 24.04.2024 )) #84617 
		|	ВТ_ДанныеУслуг.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки
		|ИЗ
		|	ВТ_ДанныеУслуг КАК ВТ_ДанныеУслуг
		//Евросиб Коханенко Н.А. 25.07.2024 (( #83866   
		|	&УсловиеПоНаличиюВЗапросе
		//Евросиб Коханенко Н.А. 25.07.2024 )) #83866 
		|";
	
	Если Объект.ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПерваяМиля Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&Миля","ЗаявкаСоставУслуги.ПерваяМиля");
		//Запрос.Текст = СтрЗаменить(Запрос.Текст,"&УсловияПоМили"
		//		  ,"ЛЕВОЕ СОЕДИНЕНИЕ Документ.РелизКлиента.ТранспортныеСредства КАК РелизКлиентаТранспортныеСредства
		//|			ПО РелизКлиентаКонтейнеры.ИдентификаторСтрокиТС = РелизКлиентаТранспортныеСредства.ИдентификаторСтроки");
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&УсловияПоМили"
				  ,"ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозкиМили
	|				ПО РелизКлиентаКонтейнеры.КлючАналитикиПеревозки = КлючиАналитикиПеревозкиМили.Ссылка
	|	    			И КлючиАналитикиПеревозкиМили.ЭтапПеревозки = Значение(Перечисление.ЭтапыПеревозки.ПерваяМиля)");		  
		
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&Миля","ЗаявкаСоставУслуги.ПоследняяМиля");
		//Запрос.Текст = СтрЗаменить(Запрос.Текст,"&УсловияПоМили"
		//		  ,"ЛЕВОЕ СОЕДИНЕНИЕ Документ.РелизКлиента.ТранспортныеСредстваПоследняяМиля КАК РелизКлиентаТранспортныеСредства
		//|			ПО РелизКлиентаКонтейнеры.ИдентификаторСтрокиТСПоследняяМиля = РелизКлиентаТранспортныеСредства.ИдентификаторСтроки");
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&УсловияПоМили"
				  ,"ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозкиМили
	|				ПО РелизКлиентаКонтейнеры.КлючАналитикиПеревозки = КлючиАналитикиПеревозкиМили.Ссылка
	|	    			И КлючиАналитикиПеревозкиМили.ЭтапПеревозки = Значение(Перечисление.ЭтапыПеревозки.ПоследняяМиля)");
	КонецЕсли;  
	
	//Евросиб Коханенко Н.А. 25.07.2024 (( #83866   
	//добавляем условие, не позволяющее вставлять в запрос контейнеры, если они уже добавлены в запрос (по данным ключа аналитики)
	Если Объект.ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПерваяМиля Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&УсловиеПоНаличиюВЗапросе",
			"ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозкиМили
		|	ПО ВТ_ДанныеУслуг.КлючАналитикиПеревозки = КлючиАналитикиПеревозкиМили.Ссылка
		|		И КлючиАналитикиПеревозкиМили.ЭтапПеревозки = Значение(Перечисление.ЭтапыПеревозки.ПерваяМиля)
		|		И (КлючиАналитикиПеревозкиМили.ЗапросНаАвто = Значение(Документ.ЗапросНаАвтоперевозку.ПустаяСсылка)	
		|			ИЛИ КлючиАналитикиПеревозкиМили.ЗапросНаАвто = &ЗапросСсылка)");	
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&УсловиеПоНаличиюВЗапросе",
			"ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозкиМили
		|	ПО ВТ_ДанныеУслуг.КлючАналитикиПеревозки = КлючиАналитикиПеревозкиМили.Ссылка
		|		И КлючиАналитикиПеревозкиМили.ЭтапПеревозки = Значение(Перечисление.ЭтапыПеревозки.ПоследняяМиля)
		|		И (КлючиАналитикиПеревозкиМили.ЗапросНаАвто = Значение(Документ.ЗапросНаАвтоперевозку.ПустаяСсылка)	
		|			ИЛИ КлючиАналитикиПеревозкиМили.ЗапросНаАвто = &ЗапросСсылка)");	
	КонецЕсли;  

	Запрос.УстановитьПараметр("ЗапросСсылка", Объект.Ссылка);
	//Евросиб Коханенко Н.А. 25.07.2024 )) #83866 
	
	Запрос.УстановитьПараметр("ЭтапПеревозки", Объект.ЭтапПеревозки);
	Запрос.УстановитьПараметр("Ссылка", ЗаявкаПараметр);
	
	ПакетыЗапросов = Запрос.ВыполнитьПакет();
		
	ТаблицаДанныхИзРелиза 			= ПакетыЗапросов[2].Выгрузить();
	ТаблицаУслуг 					= ПакетыЗапросов[3].Выгрузить();	

	СтруктураОтвет = Новый Структура("ТаблицаДанныхИзРелиза,ТаблицаУслуг"
									,ТаблицаДанныхИзРелиза
									,ТаблицаУслуг);
	
	Возврат СтруктураОтвет;
	
КонецФункции	

&НаСервере
Функция ПолучитьИтоговуюТаблицу(ПараметрыФункции,КоличествоНеДобавленных)
	
	ТаблицаЗапросыНаКТК 			  = ПараметрыФункции.ТаблицаЗапросыНаКТК;
	ТаблицаУслуг					  = ПараметрыФункции.ТаблицаУслуг;
	ТаблицаОбщееКоличествоКонтВРелизе = ПараметрыФункции.ТаблицаОбщееКоличествоКонтВРелизе;
	
	ИтоговаяТаблица = Объект.Контейнеры.Выгрузить();
	ИтоговаяТаблица.Очистить();
	ИтоговаяТаблица.Колонки.Добавить("ИдентификаторСтрокиРелизаКлиента",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36)));
	ИтоговаяТаблица.Колонки.Добавить("ТипКТКДоУслуги",Новый ОписаниеТипов("СправочникСсылка.ТипоразмерыТЕ"));
	ИтоговаяТаблица.Колонки.Добавить("ТерминалВыдачиКТКДоУслуги",Новый ОписаниеТипов("СправочникСсылка.Локации"));  
	ИтоговаяТаблица.Колонки.Добавить("НомерРелизаЕвросибДоУслуги",Новый ОписаниеТипов("ДокументСсылка.РелизКлиента"));
	ИтоговаяТаблица.Колонки.Удалить("ИдентификаторСтрокиТЧ");
	Если Объект.УпрощенныйАлгоритмЗаполненияПоследнейМили Тогда
		ЗаполниитьПоУпрощенномуАлгоритму(ИтоговаяТаблица,ТаблицаУслуг);
		Возврат ИтоговаяТаблица;
	КонецЕсли;	
	
	Для Каждого СтрокаЗапросов Из ТаблицаЗапросыНаКТК Цикл
		ЗапросБезРелиза = Ложь;
		СтруктураПоиска = Новый Структура("РелизКлиента",СтрокаЗапросов.Релиз);
		НайденнаяСтрока = ТаблицаОбщееКоличествоКонтВРелизе.НайтиСтроки(СтруктураПоиска);
		ЗапросСвязанСРелизомКлиента = НайденнаяСтрока.Количество() > 0;
		Если ЗапросСвязанСРелизомКлиента Тогда
			КоличествоВЗапросах      = НайденнаяСтрока[0].КоличествоВЗапросах;
			КоличествоКТККДобавлению = НайденнаяСтрока[0].ОбщееКоличествоКТКВРелизе - КоличествоВЗапросах;
		КонецЕсли;		
		индМакс = СтрокаЗапросов.КоличествоКТК;
		Для  инд = 1 По индМакс Цикл
			
			Если ЗапросСвязанСРелизомКлиента Тогда
				Если КоличествоКТККДобавлению = 0 Тогда
					КоличествоНеДобавленных = КоличествоНеДобавленных + 1;
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			НовСтрока = ИтоговаяТаблица.Добавить(); 
			ЗаполнитьЗначенияСвойств(НовСтрока,СтрокаЗапросов);  
			// ДИТ US 81881 ТА 83581 Сержантова А.С. Начало: 08.04.2024
			НовСтрока.ТерминалВыдачиКТКДоУслуги = СтрокаЗапросов.ТерминалВыдачи;
			// ДИТ US 81881 ТА 83581 Сержантова А.С. Конец: 08.04.2024
			НовСтрока.ТерминалСдачи = ПолучитьТерминалСдачиПоСтокуСдачиИзРелиза(СтрокаЗапросов.СтокСдачи); //ДИТ Шевченко А.В. 60951 11.11.2022
			НовСтрока.СтатусЗапросаНаАвтоперевозку = Перечисления.СтатусЗапросаНаПеревозку.Черновик;
			НовСтрока.СтатусОтправкиЗапросаНаТерминалВыдачи = Перечисления.СтатусОтправкиЗапросаНаТерминалВыдачи.НеОтправлен; //ДИТ Шевченко А.В. US 62487 ТА 68012 04.05.2023
			Если ЗапросСвязанСРелизомКлиента Тогда
				КоличествоВЗапросах      = КоличествоВЗапросах + 1;
				КоличествоКТККДобавлению = КоличествоКТККДобавлению - 1;
			КонецЕсли;
		КонецЦикла;
		Если ЗапросСвязанСРелизомКлиента Тогда
			НайденнаяСтрока[0].КоличествоВЗапросах = КоличествоВЗапросах;
		КонецЕсли;
	КонецЦикла;  
	
	// ДИТ BUG 81219 ТА 81220 Сержантова А.С. Начало: 15.02.2024
	ИтоговаяТаблица.Колонки.Добавить("УслугаЗаполненаВСтроке", Новый ОписаниеТипов("Булево"));
	// ДИТ BUG 81219 ТА 81220 Сержантова А.С. Конец: 15.02.2024

	Для Каждого СтрокаТчУслуга Из ТаблицаУслуг Цикл	  
		
		////ДИТ Шевченко А.В. US 62482 ТА 72737 19.07.2023 -Начало   // ДИТ US 78243 ТА 80825 Сержантова А.С. Закомментировала 08.02.2024
		//Если НЕ ЗначениеЗаполнено(СтрокаТчУслуга.Контейнер) Тогда
		//	Продолжить;
		//КонецЕсли;	
		////ДИТ Шевченко А.В. US 62482 ТА 72737 19.07.2023 -Конец     
		
			// ДИТ BUG 81219 ТА 81220 Сержантова А.С. Начало: 15.02.2024
			// Было:
			//СтруктураОтбора = Новый Структура("Релиз,Контейнер",СтрокаТчУслуга.Релиз,Справочники.ТЕ.ПустаяСсылка()); 
			//Стало:
			СтруктураОтбора = Новый Структура("Релиз,Контейнер, УслугаЗаполненаВСтроке",СтрокаТчУслуга.Релиз,Справочники.ТЕ.ПустаяСсылка(), Ложь);
			// ДИТ BUG 81219 ТА 81220 Сержантова А.С. Конец: 15.02.2024      
			// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Начало: 22.03.2024
			Если ЗначениеЗаполнено(СтрокаТчУслуга.ИдентификаторСтрокиЗапросаНаКТК) Тогда
				СтруктураОтбора.Вставить("ИдентификаторСтрокиЗапроса", СтрокаТчУслуга.ИдентификаторСтрокиЗапросаНаКТК);
			КонецЕсли;
			// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Конец: 22.03.2024
			НайденныеСтроки = ИтоговаяТаблица.НайтиСтроки(СтруктураОтбора);
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				НайденныеСтроки[0].ТипКТКДоУслуги             = НайденныеСтроки[0].ТипКТК;
				НайденныеСтроки[0].НомерРелизаЕвросибДоУслуги = НайденныеСтроки[0].Релиз;
				ЗаполнитьЗначенияСвойств(НайденныеСтроки[0],СтрокаТчУслуга);
				НайденныеСтроки[0].ТерминалСдачи = ПолучитьТерминалСдачиПоСтокуСдачиИзРелиза(СтрокаТчУслуга.СтокСдачи); //ДИТ Шевченко А.В. 60951 11.11.2022
				// ДИТ BUG 81219 ТА 81220 Сержантова А.С. Начало: 15.02.2024
				НайденныеСтроки[0].УслугаЗаполненаВСтроке = Истина; 
				// ДИТ BUG 81219 ТА 81220 Сержантова А.С. Конец: 15.02.2024
			Иначе
				//ДИТ Шевченко А.В. US 73869 ТА 73870 21.08.2023 -начало
				//Если СтрокаТчУслуга.ПринадлежностьТЕ = Перечисления.ПринадлежностьТЕ.КТКлиента ИЛИ ЗначениеЗаполнено(СтрокаТчУслуга.Релиз) Тогда
				Если СтрокаТчУслуга.ПринадлежностьТЕ = Перечисления.ПринадлежностьТЕ.КТКлиента 
					// ДИТ US 78243 ТА 79842 Сержантова А.С. Начало: 31.01.2024
					или ((СтрокаТчУслуга.ПринадлежностьТЕ = Перечисления.ПринадлежностьТЕ.КТЕвросиба
						и ЗначениеЗаполнено(СтрокаТчУслуга.Релиз)) или ЭтаФорма.ДобавлятьСтрокиБезРелиза) Тогда
					// ДИТ US 78243 ТА 79842 Сержантова А.С. Конец: 31.01.2024
				//ДИТ Шевченко А.В. US 73869 ТА 73870 21.08.2023 -конец
					НовСтрока = ИтоговаяТаблица.Добавить(); 
					// ДИТ BUG 81219 ТА 81220 Сержантова А.С. Начало: 15.02.2024
					НовСтрока.УслугаЗаполненаВСтроке = Истина; 
					// ДИТ BUG 81219 ТА 81220 Сержантова А.С. Конец: 15.02.2024
					ЗаполнитьЗначенияСвойств(НовСтрока,СтрокаТчУслуга);
					НовСтрока.ТерминалСдачи = ПолучитьТерминалСдачиПоСтокуСдачиИзРелиза(СтрокаТчУслуга.СтокСдачи); //ДИТ Шевченко А.В. 60951 11.11.2022	
					НовСтрока.СтатусЗапросаНаАвтоперевозку = Перечисления.СтатусЗапросаНаПеревозку.Черновик;
					НовСтрока.СтатусОтправкиЗапросаНаТерминалВыдачи = Перечисления.СтатусОтправкиЗапросаНаТерминалВыдачи.НеОтправлен; //ДИТ Шевченко А.В. US 62487 ТА 68012 04.05.2023
				КонецЕсли;	
			КонецЕсли;
			
	КонецЦикла;   
		
	// ДИТ BUG 77633 ТА 77634 Сержантова А.С. Начало: 24.11.2023 - пронумеруем строки без КТК
	// Было:
	// ИтоговаяТаблица.Сортировать("ИдентификаторСтрокиЗапроса Убыв,ИдентификаторСтрокиУслуги Убыв"); 
	// Стало:
	СтрокиБезНумерации = ИтоговаяТаблица.НайтиСтроки(Новый Структура("НомерСтроки", 0));
	НомерСтроки = 1;
	Для каждого СтрБезНомера Из СтрокиБезНумерации Цикл    
		НомерСтроки = 1;
		НомерНайден = Ложь;
		Пока не НомерНайден Цикл
			Если ИтоговаяТаблица.Найти(НомерСтроки, "НомерСтроки") = Неопределено Тогда
				СтрБезНомера.НомерСтроки = НомерСтроки;  
				НомерНайден = Истина; Прервать;
			КонецЕсли;     
			НомерСтроки = НомерСтроки + 1;
		КонецЦикла;
	КонецЦикла; 
	ИтоговаяТаблица.Сортировать("НомерСтроки");
	// ДИТ BUG 77633 ТА 77634 Сержантова А.С. Конец: 24.11.2023
	
	Возврат ИтоговаяТаблица;
	
КонецФункции	

&НаСервере
Функция ПолучитьТерминалСдачиПоСтокуСдачиИзРелиза(СтокСдачи) //ДИТ Шевченко А.В. 60951 11.11.2022	
	Если Объект.ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПоследняяМиля Тогда
		Если ЗначениеЗаполнено(СтокСдачи) Тогда
			//ДИТ Шевченко А.В. 63318 19.01.2023 - начало
			Если ТипЗнч(СтокСдачи) = Тип("СправочникСсылка.Мультилокации") Тогда
				МассивЛокацийСдачи = Справочники.Мультилокации.СоставМультилокации(СтокСдачи);
				Если МассивЛокацийСдачи.Количество() > 0 Тогда
					Возврат МассивЛокацийСдачи[0].Родитель;	
				КонецЕсли;
			ИначеЕсли ТипЗнч(СтокСдачи) = Тип("СправочникСсылка.Локации") Тогда
				Возврат СтокСдачи.Родитель;
			КонецЕсли;
			//ДИТ Шевченко А.В. 63318 19.01.2023 - конец
		КонецЕсли;
	//БИТ Белинский Д.А. 14.04.2023 -начало 
	ИначеЕсли Объект.ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПерваяМиля Тогда
		
		ЕстьРейсАвто = Ложь;
		ЕстьДругиеРейсы = Ложь;
		Для Каждого СтрокаРейсы Из Объект.Заявка.ПереченьРейсов Цикл
			Если ТипЗнч(СтрокаРейсы.Рейс) = Тип("СправочникСсылка.РейсыАвто") Тогда
				ЕстьРейсАвто = Истина;
			Иначе
				ЕстьДругиеРейсы = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если ЕстьРейсАвто и НЕ ЕстьДругиеРейсы Тогда 
			Если ЗначениеЗаполнено(СтокСдачи) Тогда
				Если ТипЗнч(СтокСдачи) = Тип("СправочникСсылка.Мультилокации") Тогда
					МассивЛокацийСдачи = Справочники.Мультилокации.СоставМультилокации(СтокСдачи);
					Если МассивЛокацийСдачи.Количество() > 0 Тогда
						Возврат МассивЛокацийСдачи[0].Родитель;	
					КонецЕсли;
				ИначеЕсли ТипЗнч(СтокСдачи) = Тип("СправочникСсылка.Локации") Тогда
					Возврат СтокСдачи.Родитель;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	//БИТ Белинский Д.А. 14.04.2023 -конец 
	КонецЕсли;
	
	Возврат Справочники.Локации.ПустаяСсылка();
КонецФункции	

