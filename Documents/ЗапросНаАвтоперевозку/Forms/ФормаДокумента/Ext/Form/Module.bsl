// ДИТ US 76935 ТА 78648 Сержантова А.С. 11.12.2023  
&НаСервере
Функция ЗаполнитьДанныеДляОбновленияКлючейАналитикиПеревозки() 
	
	ДанныеОбновленияКлючейАналитики = Новый ТаблицаЗначений;   
	ДанныеОбновленияКлючейАналитики.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	ДанныеОбновленияКлючейАналитики.Колонки.Добавить("КлючАналитикиПеревозки", Новый ОписаниеТипов("СправочникСсылка.КлючиАналитикиПеревозки"));  
	ДанныеОбновленияКлючейАналитики.Колонки.Добавить("Контейнер", Новый ОписаниеТипов("СправочникСсылка.ТЕ"));
	ДанныеОбновленияКлючейАналитики.Колонки.Добавить("ДанныеКлюча"); 
	
	Для каждого СтрокаТЧ Из Объект.Контейнеры Цикл
		СтруктураКлючаАналитикиПеревозки = Справочники.КлючиАналитикиПеревозки.СтруктураКлючаАналитикиПеревозки();   
		
		Если ДетализацияПоГрузу.Количество() Тогда 
			// ДИТ US 78233 TA 79764 Сержантова А.С. Начало: 23.01.2024
			//Было
			//СтрокиДетализацииПоГрузу = ДетализацияПоГрузу.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки",СтрокаТЧ.КлючАналитикиПеревозки));
			//Стало
			СтрокиДетализацииПоГрузу = ДетализацияПоГрузу.НайтиСтроки(Новый Структура("Ключ",СтрокаТЧ.КлючАналитикиПеревозки));
			// ДИТ US 78233 TA 79764 Сержантова А.С. Конец: 23.01.2024
			Если СтрокиДетализацииПоГрузу.Количество() Тогда
				СтруктураКлючаАналитикиПеревозки.ИзменятьТЧДетализацияПоГрузу = Истина;
				
				ДетализацияПоГрузуВКлюч = СтруктураКлючаАналитикиПеревозки.ТЧДетализацияПоГрузу;
				Для каждого СтрокаДетализацииГруза Из СтрокиДетализацииПоГрузу Цикл
					НС = ДетализацияПоГрузуВКлюч.Добавить(); 
					ЗаполнитьЗначенияСвойств(НС, СтрокаДетализацииГруза); 
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;    
		
		МилиКлюча = Новый Структура;
		МилиКлюча.Вставить("ДатаВыдачиКТКСТерминала", СтрокаТЧ.ДатаИВремяВывоза);
		МилиКлюча.Вставить("ДатаСдачиКТКНаТерминал", СтрокаТЧ.ДатаИВремяСдачи);
		МилиКлюча.Вставить("ДатаВыездаКТКСоСклада", СтрокаТЧ.ДатаЗавершенияОперацииНаСкладеКлиента);
		МилиКлюча.Вставить("ФИОВодителя", СтрокаТЧ.ФИОВодителя);
		МилиКлюча.Вставить("ПаспортныеДанные", СтрокаТЧ.ПаспортныеДанные);
		МилиКлюча.Вставить("РегНомерТС", СтрокаТЧ.НомерАвто);
		МилиКлюча.Вставить("Автоперевозчик", СтрокаТЧ.Перевозчик);
		Если ЗначениеЗаполнено(СтрокаТЧ.Перевозчик) 
			и ТипЗнч(СтрокаТЧ.Перевозчик) = Тип("СправочникСсылка.Контрагенты") Тогда
			МилиКлюча.Вставить("ИНН",ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.Перевозчик,"ИНН"));
			МилиКлюча.Вставить("КПП",ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.Перевозчик,"КПП"));
		КонецЕсли;
		МилиКлюча.Вставить("АдресКлиента", СтрокаТЧ.АдресКлиента);

		СтруктураКлючаАналитикиПеревозки.КлючАналитики = СтрокаТЧ.КлючАналитикиПеревозки;
		СтруктураКлючаАналитикиПеревозки.Контейнер = СтрокаТЧ.Контейнер;   
		СтруктураКлючаАналитикиПеревозки.Груз = СтрокаТЧ.Груз;
		СтруктураКлючаАналитикиПеревозки.ИнструкцияПоСдаче = СтрокаТЧ.ИнструкцияПоСдаче;
		// ДИТ US 78234 ТА 78241 Сержантова А.С. Начало: 14.12.2023
		СтруктураКлючаАналитикиПеревозки.ВесГруза = СтрокаТЧ.ВесГрузаНетто;
		СтруктураКлючаАналитикиПеревозки.КоличествоМест = СтрокаТЧ.КоличествоМест;
		// ДИТ US 78234 ТА 78241 Сержантова А.С. Конец: 14.12.2023  
		
		Если Объект.ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПерваяМиля Тогда
			ЗаполнитьЗначенияСвойств(СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиПерваяМиляКлючаАналитики, МилиКлюча);
		//Евросиб Коханенко Н.А. 15.01.2025 (( #97950 
		ИначеЕсли Объект.ЭтапПеревозки = Перечисления.ЭтапыПеревозки.СредняяМиля Тогда
			ЗаполнитьЗначенияСвойств(СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиСредняяМиляКлючаАналитики, МилиКлюча);
		//Евросиб Коханенко Н.А. 15.01.2025 )) #97950 
		Иначе	
		    ЗаполнитьЗначенияСвойств(СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиПоследняяМиляКлючаАналитики, МилиКлюча);
		КонецЕсли;
		
		НС = ДанныеОбновленияКлючейАналитики.Добавить(); 
		НС.НомерСтроки 				= СтрокаТЧ.НомерСтроки;
		НС.КлючАналитикиПеревозки 	= СтрокаТЧ.КлючАналитикиПеревозки;  
		НС.Контейнер 				= СтрокаТЧ.Контейнер;
		НС.ДанныеКлюча 				= СтруктураКлючаАналитикиПеревозки;
	КонецЦикла;    
	
	Возврат ДанныеОбновленияКлючейАналитики;
	
КонецФункции

// ДИТ US 76935 ТА 78648 Сержантова А.С. 11.12.2023  
