&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект); //ДИТ Шевченко А.В. US 62492 ТА 68150 25.04.2023
	
	Если Параметры.Свойство("СоздатьНаОснованииЗаявки") Тогда
		ЗаявкаПараметр = Параметры.СоздатьНаОснованииЗаявки;
		Если ЗначениеЗаполнено(ЗаявкаПараметр) Тогда
			Если НЕ Параметры.Свойство("ЭтапПеревозки") Тогда
				Отказ = Истина;
				Возврат;
			КонецЕсли;
			Если НЕ Параметры.Свойство("ПростойАлгоритмЗаполнения") Тогда
				Объект.УпрощенныйАлгоритмЗаполненияПоследнейМили = Ложь;
			Иначе
				Объект.УпрощенныйАлгоритмЗаполненияПоследнейМили = Параметры.ПростойАлгоритмЗаполнения;
			КонецЕсли;
			// ДИТ US 78243 ТА 80825 Сержантова А.С. Начало: 08.02.2024 
			Если Параметры.Свойство("ДобавлятьСтрокиБезРелиза") Тогда
				ЭтаФорма.ДобавлятьСтрокиБезРелиза = Истина;
			КонецЕсли;
			// ДИТ US 78243 ТА 80825 Сержантова А.С. Конец: 08.02.2024
			Объект.ЭтапПеревозки = Параметры.ЭтапПеревозки;
			
			ЗаполнитьНаОснованииЗаявки(ЗаявкаПараметр);
			УстановитьПросмотрСтатусОтправкиЗапросаНаТерминалВыдачи(); //ДИТ Шевченко А.В. US 62487 ТА 68012 04.05.2023
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьПанельТекущегоПользователя();
	ОбновитьПанельСостояний();
	
	УстановитьРежимыВыбораДляТабличнойЧасти();
		
	// СтандартныеПодсистемы.КонтактнаяИнформация
    ДополнительныеПараметры = УправлениеКонтактнойИнформацией.ПараметрыКонтактнойИнформации();
    ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "КонтейнерыГруппаКонтактнаяИнформация");
    УправлениеКонтактнойИнформацией.ПриСозданииНаСервере(ЭтотОбъект, Объект, ДополнительныеПараметры);
    // Конец СтандартныеПодсистемы.КонтактнаяИнформация
	УстановитьОформлениеДляПолейНеТребуется();
	УстановитьТолькоПросмотрПоСтатусуЗаказа();
	
	Если НЕ Пользователи.РолиДоступны("ПолныеПрава",, Ложь) Тогда
		РазрешитьРедактированиеСостоянияЗапроса = Пользователи.РолиДоступны("dc_РазрешитьРедактированиеСостоянияЗапросаНаАвтоперевозку",, Ложь);
		РегистрыСведений.СостоянияДокументов.УстановитьДоступностьТаблицыСостояния(Элементы.ГруппаСостояния, "Состояния", "СостоянияИсполнитель", РазрешитьРедактированиеСостоянияЗапроса);
		Элементы.КонтейнерыОбновленыИсходныеДанные.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	ЗаполнитьСлужебныеСообщения(); //ДИТ Шевченко А.В. 59965 28.11.22
	
	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
	
	//БИТ Белинский Д.А. 26.06.2023 -начало
	УстановитьВидимостьПолейПоДирекцииКонтенерныхПеревозок();

	Если ЭтоДирекцияКонтейнерныхПеревозок() Тогда 
		ВыбранКонтрагентДирекцияКонтейнерныхПеревозок = Истина;
	КонецЕсли;
	//БИТ Белинский Д.А. 26.06.2023 -конец 
	//Евросиб - АСуслов 14.07.2023 15:54:50 #локации
	//(
	Элементы.КонтейнерыСкопироватьАдрес.Видимость = Ложь;
	Элементы.КонтейнерыВставитьАдрес.Видимость = Ложь;
	//)
	//Евросиб - АСуслов 14.07.2023 15:54:52 #локации  
	
	// ДИТ US 80736 ТА 81088 Сержантова А.С. Начало: 27.02.2024
	ОповеститьОНеобходимостиОбновленияДанных();
	// ДИТ US 80736 ТА 81088 Сержантова А.С. Конец: 27.02.2024
	
	//Евросиб Коханенко Н.А. 07.12.2023 (( US 75549 TA 77390 
	УстановитьВидимостьПолейВДополнительныхАдресах();
	//Евросиб Коханенко Н.А. 07.12.2023 )) US 75549 TA 77390 
	
	//Евросиб Коханенко Н.А. 07.02.2024 (( #80805 
	УстановитьЗначенияТиповОперацийНаТерминалеПоУмолчанию();
	//Евросиб Коханенко Н.А. 07.02.2024 )) #80805 
	
	//Евросиб Коханенко Н.А. 12.03.2024 (( #82185 
	УстановитьОбязательностьЗаполненияПолейДляИмпортМоре();
	//Евросиб Коханенко Н.А. 12.03.2024 )) #82185  
	
	//Евросиб Коханенко Н.А. 07.08.2024 (( #87840
	УстановитьСвойстваЭлементовФормыДляСреднейМили();
	//Евросиб Коханенко Н.А. 07.08.2024 )) #87840 
	
	//Евросиб Коханенко Н.А. 17.12.2025 (( #125251
	УстановитьВидимостьПолейАдресаСкладаФакт();
	//Евросиб Коханенко Н.А. 17.12.2025 )) #125251 

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если Объект.ЭтапПеревозки = ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПерваяМиля") Тогда
		ЗаголовокМиля = "Первая миля";
		Элементы.КонтейнерыГрузоотправительГрузопоолучательКонтакты.Заголовок = "Грузоотправитель, контакты"; //ДИТ Шевченко А.В. US 62515 ТА 69139 25.04.2023 
	//Евросиб Коханенко Н.А. 07.08.2024 (( #87840
	ИначеЕсли Объект.ЭтапПеревозки = ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.СредняяМиля") Тогда
		ЗаголовокМиля = "Средняя миля";
		Элементы.КонтейнерыГрузоотправительГрузопоолучательКонтакты.Заголовок = "Грузополучатель, контакты";
	//Евросиб Коханенко Н.А. 07.08.2024 )) #87840
	Иначе
		ЗаголовокМиля = "Последняя миля";
		Элементы.КонтейнерыГрузоотправительГрузопоолучательКонтакты.Заголовок = "Грузополучатель, контакты"; //ДИТ Шевченко А.В. US 62515 ТА 69139 25.04.2023
	КонецЕсли;	
	ЭтаФорма.Заголовок = СтрШаблон("(%1)",ЗаголовокМиля);
	УстановитьВидимостьКомандыДобавитьУдаленныеКТКВЗапрос();
	ОбновитьДоступностьУдаленияСтрокиИСозданияДопЗапроса();
	
	Если КонтактнаяИнформацияОписаниеДополнительныхРеквизитов.Количество() > 0 Тогда
		ИмяПоля = КонтактнаяИнформацияОписаниеДополнительныхРеквизитов[0].ИмяРеквизита;
		Элементы[ИмяПоля].РедактированиеТекста = Ложь;
	КонецЕсли;	 
	
	// ДИТ US 81881 ТА 81882 Сержантова А.С. Начало: 04.04.2024 
	//если было заполнение заявки и есть дубли терминалов выдачи, то спрашиваем у пользователя какой установить терминал выдачи в Контейнерах
	Если СписокДублейТерминаловИзРейса.Количество() Тогда
		ВопросВыборТерминаловВыдачи();
	КонецЕсли;
	// ДИТ US 81881 ТА 81882 Сержантова А.С. Конец: 04.04.2024
	
КонецПроцедуры                           

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ОтветСтруктура = ТекущийОбъект.ПолучитьТаблицыОформленияИзХранилища();
	
	// ДИТ US 78233 TA 79764 Сержантова А.С. Начало: 23.01.2024 
	ВосстановитьОтправленныеВТЛДанные();
	// ДИТ US 78233 TA 79764 Сержантова А.С. Конец: 23.01.2024
	
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 -начало
	ЗаполнитьТаблицуПоКлючамАналитики(, Истина);
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 -конец
	
	Если ОтветСтруктура.ТаблицаОформленияТЧ <> Неопределено Тогда
		Для Каждого СтрокаТЗ Из ОтветСтруктура.ТаблицаОформленияТЧ Цикл
			ЗаполнитьЗначенияСвойств(ТаблицаОформленияКолонок.Добавить(),СтрокаТЗ);
		КонецЦикла;		
	КонецЕсли;	
	
	Если ОтветСтруктура.СписокОформленияШапки <> Неопределено Тогда
		Для Каждого ЗначениеСписка Из ОтветСтруктура.СписокОформленияШапки Цикл
			СписокРекОформленияШапки.Добавить(ЗначениеСписка.Значение);
		КонецЦикла;		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЗаполнитьНомерДатуЗаказаНаТС();
	КонецЕсли;
		
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация

    УстановитьУсловноеОформлениеТЧ();
	УстановитьУсловноеОформлениеШапки(255,0,0);
	УстановитьПросмотрСтатусОтправкиЗапросаНаТерминалВыдачи(); //ДИТ Шевченко А.В. US 62487 ТА 68012 04.05.2023
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	// СтандартныеПодсистемы.КонтактнаяИнформация
    УправлениеКонтактнойИнформацией.ОбработкаПроверкиЗаполненияНаСервере(ЭтотОбъект, Объект, Отказ);
    // Конец СтандартныеПодсистемы.КонтактнаяИнформация
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)	
	ТЗОформления = РеквизитФормыВЗначение("ТаблицаОформленияКолонок");
	ТекущийОбъект.ПоместитьТаблицыОформленияВХранилище(ТЗОформления,СписокРекОформленияШапки);
	// СтандартныеПодсистемы.КонтактнаяИнформация
    УправлениеКонтактнойИнформацией.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
    // Конец СтандартныеПодсистемы.КонтактнаяИнформация  
	
	//Евросиб Коханенко Н.А. 07.12.2023 (( US 75549 TA 78231
	//удалим пустые строки из Доп Адресов Клиента
	ОтборПоПустымСтрокам = Новый Структура;
	ОтборПоПустымСтрокам.Вставить("АдресСкладаКлиента", Справочники.АдресаВНаселенныхПунктах.ПустаяСсылка());
	МассивПустыхСтрок = ТекущийОбъект.ДополнительныеАдресаКлиента.НайтиСтроки(ОтборПоПустымСтрокам); 
	Для Каждого ПустаяСтрока Из  МассивПустыхСтрок Цикл
		ТекущийОбъект.ДополнительныеАдресаКлиента.Удалить(ПустаяСтрока);
	КонецЦикла;
	//Евросиб Коханенко Н.А. 07.12.2023 )) US 75549 TA 78231 

	//Евросиб Коханенко Н.А. 01.03.2024 (( #80981 
	ТаблицаДанныхИзКалькуляций = ПолучитьСтоимостьИСтавкуНДС(ТекущийОбъект);
	Для Каждого СтрокаКонтейнеры Из ТекущийОбъект.Контейнеры Цикл
		СтруктураПоиска = Новый Структура("ИдентификаторСтрокиУслуги", СтрокаКонтейнеры.ИдентификаторСтрокиУслуги);
		НайденныеСтроки = ТаблицаДанныхИзКалькуляций.НайтиСтроки(СтруктураПоиска);
		ЗапросСвязанСКалькуляцией = НайденныеСтроки.Количество() > 0;
		НовоеЗначениеСтавкиНДС = ?(ЗапросСвязанСКалькуляцией, НайденныеСтроки[0].СтавкаНДС, Перечисления.СтавкиНДС.ПустаяСсылка());
		НовоеЗначениеСтоимости = ?(ЗапросСвязанСКалькуляцией, НайденныеСтроки[0].СтоимостьАвтоперевозкиЗаложеннаяПриРасчете, 0);
		Если СтрокаКонтейнеры.СтавкаНДС <> НовоеЗначениеСтавкиНДС Тогда
			СтрокаКонтейнеры.СтавкаНДС = НовоеЗначениеСтавкиНДС;
			СтрокаКонтейнеры.ОбновленыИсходныеДанные = Истина;
		КонецЕсли;
		Если СтрокаКонтейнеры.СтоимостьАвтоперевозкиЗаложеннаяПриРасчете <> НовоеЗначениеСтоимости Тогда
			СтрокаКонтейнеры.СтоимостьАвтоперевозкиЗаложеннаяПриРасчете = НовоеЗначениеСтоимости;
			СтрокаКонтейнеры.ОбновленыИсходныеДанные = Истина;
		КонецЕсли;
	КонецЦикла;
	//Евросиб Коханенко Н.А. 01.03.2024 )) #80981   
	
	// ДИТ US 80736 ТА 81088 Сержантова А.С. Начало: 27.02.2024
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ВыполнитьЗадачуОбновления", БылоОбновлениеИзЗаявки);	
	// ДИТ US 80736 ТА 81088 Сержантова А.С. Конец: 27.02.2024
	
	// ДИТ US 76935 ТА 78648 Сержантова А.С. Начало: 11.12.2023    
	//Проверяем изменились ли ключи аналитики
	БылоОбновлениеКлюча = Ложь;
	Для каждого СтрокаТЧ Из Объект.Контейнеры Цикл
		АктуальнаяВерсия = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.КлючАналитикиПеревозки, "ВерсияДанных");
		Если СтрокаТЧ.ВерсияКлюча <> "" и СтрокаТЧ.ВерсияКлюча <> АктуальнаяВерсия Тогда
			ЗаполнитьТаблицуПоКлючамАналитики(СтрокаТЧ.КлючАналитикиПеревозки); 
			БылоОбновлениеКлюча = Истина;
		КонецЕсли;
	КонецЦикла;	
	Если БылоОбновлениеКлюча Тогда 
		ОбщегоНазначения.СообщитьПользователю("Перед записью запроса на авто обнаружено, что ключи аналитики перевозки изменились. Данные перезаполнены, внесите необходимые корректировки");		
		Отказ = Истина;
	КонецЕсли;  
	
	Если не Отказ Тогда 
		ЗаблокироватьКлючиАналитикиПеревозкиДляРедактирования();
		ДанныеОбновленияКлючей = ЗаполнитьДанныеДляОбновленияКлючейАналитикиПеревозки();
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ДанныеДляОбновленияКлючейАналитики", ДанныеОбновленияКлючей); 
	КонецЕсли; 
	// ДИТ US 76935 ТА 78648 Сержантова А.С. Конец: 11.12.2023
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)	
	ОбновитьПанельТекущегоПользователя();
	ОбновитьПанельСостояний();
	// СтандартныеПодсистемы.КонтактнаяИнформация
    УправлениеКонтактнойИнформацией.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект);
    // Конец СтандартныеПодсистемы.КонтактнаяИнформация	
	
	ЗаполнитьТаблицуПоКлючамАналитики();
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЗаполнитьНомерДатуЗаказаНаТС();
	КонецЕсли;       
	
	// ДИТ US 76935 ТА 78648 Сержантова А.С. Начало: 11.12.2023
	СнятьБлокировкуКлючейАналитикиПеревозкиДляРедактирования();
	// ДИТ US 76935 ТА 78648 Сержантова А.С. Конец: 11.12.2023
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ПроверитьСоответствиеВесаДетализацииПоГрузу(Отказ);	
	
	ВыводитьСообщение = Ложь;
	
	//Для Каждого СтрокаТЧ Из Объект.Контейнеры Цикл
	//	СтруктураПоиска = Новый Структура("ИдентификаторСтрокиТЧ",СтрокаТЧ.ИдентификаторСтрокиТЧ);
	//	НайденныеСтроки = ТаблицаОформленияКолонок.НайтиСтроки(СтруктураПоиска);
	//	Если НайденныеСтроки.Количество() = 0 Тогда
	//		СтрокаТЧ.ОбновленыИсходныеДанные = Ложь;
	//	КонецЕсли;	
	//КонецЦикла;	
	
	//БИТ Белинский Д.А. 10.04.2023 -начало  TASK 66201 
	Если ЭтоДирекцияКонтейнерныхПеревозок() Тогда
		Если ЗначениеЗаполнено(Объект.Заявка) Тогда 
			ПСЦ = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(Объект.Заявка, "ПСЦ");
			Если ЗначениеЗаполнено(ПСЦ) И ЭтоМежсервисныеРасходы(ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(ПСЦ, "ТипКалькуляции")) Тогда
				Если Объект.Проведен = Ложь И ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
					Если РаботаСЗаявкамиВызовСервера.ЭтоЗаявкаНаАвтоРейс(Объект.Заявка) Тогда
						ОбновитьИзЗаявкиНаСервере()
					КонецЕсли;
				КонецЕсли; 
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//БИТ Белинский Д.А. 10.04.2023 -конец  TASK 66201 
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
