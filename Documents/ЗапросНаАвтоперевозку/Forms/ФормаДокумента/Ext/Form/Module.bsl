			НайденныеСтрокиКонтейнеров = Объект.Контейнеры.НайтиСтроки(СтруктураПоиска);
			Для Каждого НайденнаяСтрокаКонтейнеры Из НайденныеСтрокиКонтейнеров Цикл
				НовСтрока.Ключ = НайденнаяСтрокаКонтейнеры.Ключ;
				НомерСтроки = НомерСтроки + 1;
				НовСтрока.НомерСтрокиПоГуидам = НомерСтроки;
			КонецЦикла;
