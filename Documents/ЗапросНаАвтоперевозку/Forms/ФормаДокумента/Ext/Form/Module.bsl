&НаКлиенте
Процедура СоздатьДополнительныйЗапрос(Команда)
	Если Элементы.Контейнеры.ТекущиеДанные <> Неопределено Тогда
		ТекСтрока = Элементы.Контейнеры.ТекущиеДанные;
		ИдентСтроки = ТекСтрока.ПолучитьИдентификатор();	
		СтрокаКонтейнер = Объект.Контейнеры.НайтиПоИдентификатору(ИдентСтроки);
		НовСтрока = Объект.Контейнеры.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока,СтрокаКонтейнер);
		НовСтрока.ИдентификаторСтрокиТЧ = Новый УникальныйИдентификатор;
		НовСтрока.ИдентификаторСтрокиТабличнойЧасти = НовСтрока.ПолучитьИдентификатор();
		НовСтрока.СтатусЗапросаНаАвтоперевозку = ПредопределенноеЗначение("Перечисление.СтатусЗапросаНаПеревозку.Черновик");
		НовСтрока.СтатусЗаказаНаТС = ПредопределенноеЗначение("Перечисление.СтатусЗаказаНаТс.ПустаяСсылка");
		НовСтрока.НомерАвто 				 = "";
		НовСтрока.НомерПрицепа 				 = "";
		НовСтрока.ФИОВодителя 				 = "";
		НовСтрока.ПаспортныеДанные 			 = "";
		НовСтрока.Перевозчик 				 = "";
		НовСтрока.ИтоговаяСтоимостьПеревозки = 0;
        НовСтрока.ДатаИВремяВывоза 			 = Дата(1,1,1);
		НовСтрока.КонтейнерФакт 			 = "";
		ОбновитьТаблицуОформления("","ИдентификаторСтрокиТЧ",НовСтрока.ИдентификаторСтрокиТЧ,"Контейнеры");
	КонецЕсли;	
КонецПроцедуры

