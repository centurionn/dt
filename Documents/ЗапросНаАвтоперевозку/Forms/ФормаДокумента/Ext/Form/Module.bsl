&НаСервереБезКонтекста
Функция ПолучитьСтатусОтправкиЗапросаНаТерминалВыдачиДоИзменения(СсылкаД,КлючАналитикиПеревозки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗапросНаАвтоперевозкуКонтейнеры.СтатусОтправкиЗапросаНаТерминалВыдачи КАК СтатусОтправкиЗапросаНаТерминалВыдачи
		|ИЗ
		|	Документ.ЗапросНаАвтоперевозку.Контейнеры КАК ЗапросНаАвтоперевозкуКонтейнеры
		|ГДЕ
		|	ЗапросНаАвтоперевозкуКонтейнеры.Ссылка = &Ссылка
		|	И ЗапросНаАвтоперевозкуКонтейнеры.КлючАналитикиПеревозки = &КлючАналитикиПеревозки";
	
	Запрос.УстановитьПараметр("КлючАналитикиПеревозки", КлючАналитикиПеревозки);
	Запрос.УстановитьПараметр("Ссылка", СсылкаД);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.СтатусОтправкиЗапросаНаТерминалВыдачи;
	КонецЦикла;
	
КонецФункции	

&НаСервере
Процедура ДобавитьЗначениеРеквизитаВКлюч(Ключ,ЗначениеПоля,ИмяПоля,ЭтапПеревозки = Неопределено,Знач ДетализацияПоГрузу = Неопределено,ВерсияДанных=Неопределено) //ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23
	
	Если ВерсияДанных <> Ключ.ВерсияДанных Тогда 
		ЗаполнитьТаблицуПоКлючамАналитики(Ключ);
		ОбщегоНазначения.СообщитьПользователю("Версия ключа аналитики перевозки устарела, подгружены актуальные данные по строке.");	
	КонецЕсли;
	
	СтруктураКлюча  = Справочники.КлючиАналитикиПеревозки.СтруктураКлючаАналитикиПеревозки(); 
	СтруктураКлюча.Вставить("КлючАналитики",Ключ);
	
	Если ЭтапПеревозки = Неопределено Тогда
		Если ЗначениеПоля <> Неопределено И ЗначениеЗаполнено(ИмяПоля) Тогда
			СтруктураКлюча.Вставить(ИмяПоля,ЗначениеПоля);
		КонецЕсли;
		Если ДетализацияПоГрузу <> Неопределено Тогда
			СтруктураПоиска = Новый Структура("Ключ",Ключ);
			СтруктураКлюча.ТЧДетализацияПоГрузу = ДетализацияПоГрузу.Выгрузить(ДетализацияПоГрузу.НайтиСтроки(СтруктураПоиска));
			СтруктураКлюча.Вставить("ИзменятьТЧДетализацияПоГрузу",Истина);
		КонецЕсли;
		ВерсияДанных = Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлюча).ВерсияДанных;
	КонецЕсли;
	
	Если ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПерваяМиля Тогда
		СтруктураКлюча.СтруктураТЧМилиПерваяМиляКлючаАналитики.Вставить(ИмяПоля,ЗначениеПоля);
		ВерсияДанных = Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлюча).ВерсияДанных;
	КонецЕсли;
	
	Если ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПоследняяМиля Тогда
		СтруктураКлюча.СтруктураТЧМилиПоследняяМиляКлючаАналитики.Вставить(ИмяПоля,ЗначениеПоля);
		ВерсияДанных = Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлюча).ВерсияДанных;
	КонецЕсли;	
	
КонецПроцедуры

