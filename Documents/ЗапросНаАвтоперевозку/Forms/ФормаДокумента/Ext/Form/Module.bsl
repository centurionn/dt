	МассивПроверкиКолонокТС.Добавить("НомерАвто");
	МассивПроверкиКолонокТС.Добавить("НомерПрицепа");
	МассивПроверкиКолонокТС.Добавить("ФИОВодителя");
	МассивПроверкиКолонокТС.Добавить("ПаспортныеДанные");
	МассивПроверкиКолонокТС.Добавить("Перевозчик");
	МассивПроверкиКолонокТС.Добавить("КонтейнерФакт");
	МассивПроверкиКолонокТС.Добавить("ДатаИВремяВывоза");
	МассивПроверкиКолонокТС.Добавить("ДатаИВремяСдачи");
