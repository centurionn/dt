&НаСервере
Процедура ПроверитьАктуальностьКлючаАналитики(ИдентификаторСтроки = Неопределено)   
	БылоОбновлениеКлюча = Ложь;
	Если ИдентификаторСтроки = Неопределено Тогда
		Для каждого СтрокаТЧ Из Объект.Контейнеры Цикл
			АктуальнаяВерсия = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.КлючАналитикиПеревозки, "ВерсияДанных");
			Если СтрокаТЧ.ВерсияКлюча <> АктуальнаяВерсия Тогда
				БылоОбновлениеКлюча = Истина;
			КонецЕсли;
		КонецЦикла;  
		Если БылоОбновлениеКлюча Тогда
			ЗаполнитьТаблицуПоКлючамАналитики(, Истина);
		КонецЕсли;
	Иначе
	    СтрокаТЧ = Объект.Контейнеры.НайтиПоИдентификатору(ИдентификаторСтроки);
		АктуальнаяВерсия = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.КлючАналитикиПеревозки, "ВерсияДанных");
		Если СтрокаТЧ.ВерсияКлюча <> АктуальнаяВерсия Тогда
			ЗаполнитьТаблицуПоКлючамАналитики(СтрокаТЧ.КлючАналитикиПеревозки, Истина); 
			БылоОбновлениеКлюча = Истина;
		КонецЕсли;
	КонецЕсли;	
	
	Если БылоОбновлениеКлюча Тогда 
		ОбщегоНазначения.СообщитьПользователю("Версия ключа аналитики перевозки устарела, подгружены актуальные данные");
	КонецЕсли; 
