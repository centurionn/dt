&НаКлиенте
Процедура ДетализацияПоГрузу(Команда)
	Элементы.ДетализацияПоГрузу.Видимость = НЕ Элементы.ДетализацияПоГрузу.Видимость;
	//Евросиб Коханенко Н.А. 05.10.2023 (( US 75549 TA 75773 
	//показываем только одну таблицу из двух ниже таблицы Контейнеры
	Если Элементы.ДополнительныеАдресаКлиента.Видимость И Элементы.ДетализацияПоГрузу.Видимость Тогда
		Элементы.ДополнительныеАдресаКлиента.Видимость = Ложь;
	КонецЕсли;
	//Евросиб Коханенко Н.А. 05.10.2023 )) US 75549 TA 75773
КонецПроцедуры

&НаКлиенте
Процедура Отметить(Команда)
	Для Каждого СтрокаТЧ из Объект.Контейнеры Цикл
		
		Пропустить = (СтрокаТЧ.СтатусЗаказаНаТС = ПредопределенноеЗначение("Перечисление.СтатусЗаказаНаТс.Закрыт") 
		ИЛИ СтрокаТЧ.СтатусЗаказаНаТС = ПредопределенноеЗначение("Перечисление.СтатусЗаказаНаТс.ВыданВРейс")) 
		И НЕ ЗначениеЗаполнено(СтрокаТЧ.КонтейнерФакт);
		
		Если Пропустить Тогда
			Продолжить;
		КонецЕсли;	
		
		Пропустить = СтрокаТЧ.СтатусЗапросаНаАвтоперевозку = ПредопределенноеЗначение("Перечисление.СтатусЗапросаНаПеревозку.Отменен");
		
		Если Пропустить Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТЧ.Отметка = Истина;
	КонецЦикла;
	МодифицированностьФормы = ЭтаФорма.Модифицированность;
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметку(Команда)
	Для Каждого СтрокаТЧ из Объект.Контейнеры Цикл 
		СтрокаТЧ.Отметка = Ложь;
	КонецЦикла;
	МодифицированностьФормы = ЭтаФорма.Модифицированность;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтроки(Команда)
	
	СтруктураОтбора = Новый Структура("Отметка",Истина);
	НайденныеСтроки = Объект.Контейнеры.НайтиСтроки(СтруктураОтбора);
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	Для Каждого СтрокаТч Из НайденныеСтроки Цикл
		Если СтрокаТч.СтатусЗапросаНаАвтоперевозку = ПредопределенноеЗначение("Перечисление.СтатусЗапросаНаПеревозку.Отменен") Тогда
			Продолжить;
		КонецЕсли;	
		НомераНеУдаленныхСтрок  				= Новый Массив;
		НомераСтрокСоСтатусомЗаказаВыданВРейс 	= Новый Массив;
		НомераСтрокСоСтатусомЗаказаЗакрыт 		= Новый Массив;
		Если НЕ ЗначениеЗаполнено(СтрокаТч.ИдентификаторСтрокиУслуги) Тогда
			Если СтрокаТч.СтатусЗаказаНаТС = ПредопределенноеЗначение("Перечисление.СтатусЗаказаНаТс.ВыданВРейс") Тогда
				НомераСтрокСоСтатусомЗаказаВыданВРейс.Добавить(СтрокаТч.НомерСтроки);
				Продолжить;
			КонецЕсли;
			Если СтрокаТч.СтатусЗаказаНаТС = ПредопределенноеЗначение("Перечисление.СтатусЗаказаНаТс.Закрыт") Тогда
				НомераСтрокСоСтатусомЗаказаЗакрыт.Добавить(СтрокаТч.НомерСтроки);
				Продолжить;
			КонецЕсли;
			СтрокаТч.СтатусЗапросаНаАвтоперевозку = ПредопределенноеЗначение("Перечисление.СтатусЗапросаНаПеревозку.Отменен");
			
            МассивНомеровСтрок = ПолучитьНомераСтрокДляПередачиКлиентуДанныхПоАвтоперевозке();
			Если МассивНомеровСтрок.Количество() = 0 Тогда
				МассивНаУдаление = Новый Массив;
				НайденноеСостояние = Объект.Состояния.НайтиСтроки(Новый Структура("Состояние",ПредопределенноеЗначение("Справочник.Состояния.ПередатьКлиентуДанныеПоАвтоперевозке")));
				Если НайденноеСостояние.Количество() > 0 Тогда
					Если НЕ НайденноеСостояние[0].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Выполнен") Тогда
						МассивНаУдаление.Добавить(НайденноеСостояние[0]);	
					КонецЕсли;	
				КонецЕсли;
				Если МассивНаУдаление.Количество() > 0 Тогда
					Объект.Состояния.Удалить(МассивНаУдаление);
				КонецЕсли;
			КонецЕсли;
				
			Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
				СтрокаТч.ОбновленыИсходныеДанные = Истина;
			КонецЕсли;
			СтрокаТч.Отметка = Ложь;	
			ОбновитьТаблицуОформления("СтатусЗапросаНаАвтоперевозку","ИдентификаторСтрокиТЧ",СтрокаТч.ИдентификаторСтрокиТЧ,"Контейнеры");				
		Иначе
			НомераНеУдаленныхСтрок.Добавить(СтрокаТч.НомерСтроки);		
		КонецЕсли;		
	КонецЦикла;		
	
	Если НомераНеУдаленныхСтрок.Количество() > 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Строки %1 не были удалены, так как ручное удаление доступно только для строк, добавленных из запроса на КТК и отсутствующих на закладке Услуги в Заявке.",СтрСоединить(НомераНеУдаленныхСтрок,",")));
	КонецЕсли;
	
	Для Каждого СтрокаМ Из НомераСтрокСоСтатусомЗаказаВыданВРейс Цикл
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Удаление строки %1 невозможно, так как текущий статус заказа на ТС ""Выдан в рейс"" и не допускает внесения изменений.",СтрокаМ));	
	КонецЦикла;
	
	Для Каждого СтрокаМ Из НомераСтрокСоСтатусомЗаказаЗакрыт Цикл
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Удаление строки %1 невозможно, так как текущий статус заказа на ТС ""Закрыт"" и не допускает внесения изменений.",СтрокаМ));	
	КонецЦикла;
	
	УстановитьВидимостьКомандыДобавитьУдаленныеКТКВЗапрос();
	
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнятьВнизДействие(Команда)
	Элементы.КонтейнерыЗаполнятьВниз.Пометка = НЕ Элементы.КонтейнерыЗаполнятьВниз.Пометка;
	ЗаполнятьВниз = Элементы.КонтейнерыЗаполнятьВниз.Пометка;	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИзЗаявки(Команда)
	
	ЭтаФорма.Прочитать(); 
	
	//Евросиб Коханенко Н.А. 25.12.2024 (( #97950 
	Если Объект.ЭтапПеревозки = ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.СредняяМиля") Тогда
		Ответ = ОбновитьЗапросПоСреднейМилеИзЗаявкиНаСервере();    
		Возврат;
	КонецЕсли;
	//Евросиб Коханенко Н.А. 25.12.2024 )) #97950 

	// ДИТ US 78243 ТА 80825 Сержантова А.С. Начало: 08.02.2024 
	//для первой мили проверяем есть ли строки, которые имеют значение "Силами Евросиб" в способе автоперевозки 
	//И имеют принадлежность = "КТК Евросиб" И имеют не заполненное поле "Релиз" ссылкой на документ релиз клиента
	Если Объект.ЭтапПеревозки = ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПерваяМиля") Тогда
	    НомераСтрокБезРелиза = ОпределитьСтрокиПоУсловиюПустогоРелиза(); 
		Если НомераСтрокБезРелиза.Количество() > 0 Тогда
		    Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОСоставеСтрокВЗаявкеНаАвто", ЭтотОбъект,);
			Если НомераСтрокБезРелиза.Количество() = 1 Тогда
				ТекстВопроса = СтрШаблон("Строка №%1 в заявке не связана с релизом клиента.
				|Продолжить перенос таких строк в запрос на автоперевозку?", НомераСтрокБезРелиза[0]);
			Иначе
			    ТекстВопроса = СтрШаблон("Строки №%1 в заявке не связаны с релизом клиента.
				|Продолжить перенос таких строк в запрос на автоперевозку?", СтрСоединить(НомераСтрокБезРелиза, ", "));
			КонецЕсли;                        
			КнопкиОтветов = Новый СписокЗначений;
			КнопкиОтветов.Добавить(КодВозвратаДиалога.Да, "Продолжить");
			КнопкиОтветов.Добавить(КодВозвратаДиалога.Отмена, "Отмена");
			ПоказатьВопрос(Оповещение, ТекстВопроса, КнопкиОтветов, 0);
	    	Возврат; 
		КонецЕсли;
	КонецЕсли;
	// ДИТ US 78243 ТА 80825 Сержантова А.С. Конец: 08.02.2024
		
	Ответ = ОбновитьИзЗаявкиНаСервере();    
	
	// ДИТ US 81881 ТА 81882 Сержантова А.С. Начало: 04.04.2024 
	//если было заполнение заявки и есть дубли терминалов выдачи, то спрашиваем у пользователя какой установить терминал выдачи в Контейнерах
	Если СписокДублейТерминаловИзРейса.Количество() Тогда
		ВопросВыборТерминаловВыдачи();
	КонецЕсли;
	// ДИТ US 81881 ТА 81882 Сержантова А.С. Конец: 04.04.2024
	
	// ДИТ US 80736 ТА 81088 Сержантова А.С. Начало: 27.02.2024
	БылоОбновлениеИзЗаявки = Истина;
	// ДИТ US 80736 ТА 81088 Сержантова А.С. Конец: 27.02.2024
	
	Если Ответ.МассивНомеровСтрокВыданВРейс.Количество() > 0 ИЛИ Ответ.МассивНомеровСтрокЗакрыт.Количество() > 0 Тогда
		
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить(КодВозвратаДиалога.Да,"Да");
		СписокКнопок.Добавить(КодВозвратаДиалога.Нет,"Нет");
		ТекстВопроса = "";
		Если Ответ.МассивНомеровСтрокВыданВРейс.Количество() > 0 Тогда
			ТекстВопроса = СтрШаблон("Обновление данных по строке %1 невозможно, так как текущий статус заказа на ТС Выдан в рейс.",СтрСоединить(Ответ.МассивНомеровСтрокВыданВРейс,","));
			ТекстВопроса = ТекстВопроса + Символы.ПС  + Символы.ПС;
		КонецЕсли;
		Если Ответ.МассивНомеровСтрокЗакрыт.Количество() > 0 Тогда	
			ТекстВопроса = ТекстВопроса + СтрШаблон("Обновление данных по строке %1 невозможно, так как текущий статус заказа на ТС Закрыт.",СтрСоединить(Ответ.МассивНомеровСтрокЗакрыт,","));
			ТекстВопроса = ТекстВопроса + Символы.ПС + Символы.ПС;
		КонецЕсли;
		ТекстВопроса = ТекстВопроса + "Произвести обновление доступных строк ?";
		
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбОбновлении", ЭтотОбъект, Новый Структура("АдресХранилища,КоличествоНеДобавленных",Ответ.АдресХранилища,Ответ.КоличествоНеДобавленных));
		ПоказатьВопрос(Оповещение, ТекстВопроса, СписокКнопок, 60,КодВозвратаДиалога.Нет,,КодВозвратаДиалога.Нет);
	КонецЕсли;
	
	УстановитьВидимостьКомандыДобавитьУдаленныеКТКВЗапрос();
	УстановитьПросмотрСтатусОтправкиЗапросаНаТерминалВыдачи(); //ДИТ Шевченко А.В. US 62487 ТА 68012 04.05.2023
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 -начало
	ЗаполнитьТаблицуПоКлючамАналитики(,Истина); // ДИТ US 78243 ТА 80825 Сержантова А.С. 08.02.2024)
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 -конец
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЗаполнитьНомерДатуЗаказаНаТС();
	КонецЕсли;
	
	//Евросиб Коханенко Н.А. 07.02.2024 (( #80805
	Для Каждого СтрокаКонтейнеры Из Объект.Контейнеры Цикл 
		Если НЕ СтрокаКонтейнеры.НеТребуетсяТерминалВыдачи Тогда
			СтрокаКонтейнеры.ТипОперацииНаТерминалеВыдачи = ТипОперацииНаТерминалеВыдачиПоУмолчанию;
		КонецЕсли;
		Если НЕ СтрокаКонтейнеры.НеТребуетсяАдрес Тогда
			СтрокаКонтейнеры.ТипОперацииНаСкладеКлиента = ТипОперацииНаСкладеКлиентаПоУмолчанию;
		КонецЕсли;
		Если НЕ СтрокаКонтейнеры.НеТребуетсяТерминалСдачи Тогда
			СтрокаКонтейнеры.ТипОперацииНаТерминалеСдачи = ТипОперацииНаТерминалеСдачиПоУмолчанию;
		КонецЕсли;
	КонецЦикла;
	//Евросиб Коханенко Н.А. 07.02.2024 )) #80805 

	//БИТ Белинский Д.А. 10.04.2023 -начало
	КонтрагентДирекцияКонтейнерныхПеревозок = Ложь;
	Если ЭтоДирекцияКонтейнерныхПеревозок() Тогда 
		КонтрагентДирекцияКонтейнерныхПеревозок = Истина;	
	КонецЕсли;
	
	Если КонтрагентДирекцияКонтейнерныхПеревозок Тогда
		Для Каждого СтрокаКонтейнеры Из Объект.Контейнеры Цикл
			СтрокаКонтейнеры.НеТребуетсяАдрес = Истина;
			СтрокаКонтейнеры.ТипОперацииНаТерминалеВыдачи = ПредопределенноеЗначение("Перечисление.ТипОперацииНаТерминале.ПриемПорожнегоКТК");
			СтрокаКонтейнеры.ТипОперацииНаТерминалеСдачи = ПредопределенноеЗначение("Перечисление.ТипОперацииНаТерминале.СдачаПорожнегоКТК");
		КонецЦикла;
		ВыбранКонтрагентДирекцияКонтейнерныхПеревозок = Истина;
	ИначеЕсли ВыбранКонтрагентДирекцияКонтейнерныхПеревозок Тогда
		Для Каждого СтрокаКонтейнеры Из Объект.Контейнеры Цикл
			СтрокаКонтейнеры.НеТребуетсяАдрес = Ложь;
			СтрокаКонтейнеры.ТипОперацииНаТерминалеВыдачи = Неопределено;
			СтрокаКонтейнеры.ТипОперацииНаТерминалеСдачи = Неопределено;
		КонецЦикла;
		ВыбранКонтрагентДирекцияКонтейнерныхПеревозок = Ложь;
    КонецЕсли;
	
	УстановитьВидимостьПолейПоДирекцииКонтенерныхПеревозок();
	//БИТ Белинский Д.А. 10.04.2023 -конец          

	//Евросиб Коханенко Н.А. 12.03.2024 (( #82185 
	УстановитьОбязательностьЗаполненияПолейДляИмпортМоре();
	//Евросиб Коханенко Н.А. 12.03.2024 )) #82185 
	
	//Евросиб Коханенко Н.А. 24.04.2024 (( #84617
	ОбновитьУчетныеНаправленияИзЗаявкиНаСервере();
	//Евросиб Коханенко Н.А. 24.04.2024 )) #84617 
	
КонецПроцедуры   

// ДИТ US 78243 ТА 80825 Сержантова А.С. 08.02.2024
&НаСервере
Функция ОпределитьСтрокиПоУсловиюПустогоРелиза()
	
	Результат = Новый Массив;
	ТаблицаУслуг = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Заявка, "СоставУслуги");
	ТаблицаДляПроверки = ТаблицаУслуг.Выгрузить();  
	// Евросиб(ДИТ) BUG 89499 ТА 89615 Сержантова А.С. Начало: 08.08.2024 
	// Проверяем релиз для всех строк, а не только для новых добавленных. Иначе строки Отменяются(
	//ТаблицаТекущихСтрок = Объект.Контейнеры.Выгрузить(,"ИдентификаторСтрокиУслуги"); 
	// Евросиб(ДИТ) BUG 89499 ТА 89615 Сержантова А.С. Конец: 08.08.2024
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СоставУслуги.НомерСтроки КАК НомерСтроки,
		|	СоставУслуги.ГУИДСтроки КАК ГУИДСтроки,
		|	СоставУслуги.ПерваяМиля КАК ПерваяМиля,
		|	СоставУслуги.ПринадлежностьТЕ КАК ПринадлежностьТЕ,
		|	СоставУслуги.Релиз КАК Релиз
		|ПОМЕСТИТЬ ВТ_ИсходныеДанные
		|ИЗ
		|	&СоставУслуги КАК СоставУслуги
		|;
		|
		// Евросиб(ДИТ) BUG 89499 ТА 89615 Сержантова А.С. Начало: 08.08.2024
		// Было:
		//|////////////////////////////////////////////////////////////////////////////////
		//|ВЫБРАТЬ
		//|	ТекущиеСтроки.ИдентификаторСтрокиУслуги КАК ГУИДСтроки
		//|ПОМЕСТИТЬ ВТ_ПеренесенныеСтроки
		//|ИЗ
		//|	&ПеренесенныеСтроки КАК ТекущиеСтроки
		//|;
		//|  
		// Евросиб(ДИТ) BUG 89499 ТА 89615 Сержантова А.С. Конец: 08.08.2024
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_ИсходныеДанные.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	ВТ_ИсходныеДанные КАК ВТ_ИсходныеДанные
		|ГДЕ
		|	ВТ_ИсходныеДанные.ПерваяМиля = ЗНАЧЕНИЕ(Перечисление.ВариантыАвтоперевозки.СиламиЕвросиб)
		|	И ВТ_ИсходныеДанные.ПринадлежностьТЕ = ЗНАЧЕНИЕ(Перечисление.ПринадлежностьТЕ.КТЕвросиба)
		|	И ВТ_ИсходныеДанные.Релиз В (ЗНАЧЕНИЕ(Документ.РелизКлиента.ПустаяСсылка), ЗНАЧЕНИЕ(Документ.РелизСобственника.ПустаяСсылка), НЕОПРЕДЕЛЕНО)";
		// Евросиб(ДИТ) BUG 89499 ТА 89615 Сержантова А.С. Начало: 08.08.2024
		// Было:
		//|	И НЕ ВТ_ИсходныеДанные.ГУИДСтроки В
		//|				(ВЫБРАТЬ
		//|					Т.ГУИДСтроки
		//|				ИЗ
		//|					ВТ_ПеренесенныеСтроки КАК Т)"; 
		// Евросиб(ДИТ) BUG 89499 ТА 89615 Сержантова А.С. Конец: 08.08.2024
	Запрос.УстановитьПараметр("СоставУслуги", ТаблицаДляПроверки);     
	// Евросиб(ДИТ) BUG 89499 ТА 89615 Сержантова А.С. Начало: 08.08.2024
	//Запрос.УстановитьПараметр("ПеренесенныеСтроки", ТаблицаТекущихСтрок); 
	// Евросиб(ДИТ) BUG 89499 ТА 89615 Сержантова А.С. Конец: 08.08.2024
	РезультатЗапроса = Запрос.Выполнить();
	Если не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Выборка.НомерСтроки);			
		КонецЦикла;
	КонецЕсли;   
	
	Возврат Результат;

КонецФункции

// ДИТ US 78243 ТА 80825 Сержантова А.С. 08.02.2024
&НаКлиенте
Процедура ПослеЗакрытияВопросаОСоставеСтрокВЗаявкеНаАвто(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;  
	
	ЭтаФорма.ДобавлятьСтрокиБезРелиза = Истина; 
	
	// этот код дублируется из процедуры ОбновитьИзЗаявки
	Ответ = ОбновитьИзЗаявкиНаСервере();    
	
	// ДИТ US 81881 ТА 81882 Сержантова А.С. Начало: 04.04.2024 
	//если было заполнение заявки и есть дубли терминалов выдачи, то спрашиваем у пользователя какой установить терминал выдачи в Контейнерах
	Если СписокДублейТерминаловИзРейса.Количество() Тогда
		ВопросВыборТерминаловВыдачи();
	КонецЕсли;
	// ДИТ US 81881 ТА 81882 Сержантова А.С. Конец: 04.04.2024
	
	// ДИТ US 80736 ТА 81088 Сержантова А.С. Начало: 27.02.2024
	БылоОбновлениеИзЗаявки = Истина;
	// ДИТ US 80736 ТА 81088 Сержантова А.С. Конец: 27.02.2024
	
	Если Ответ.МассивНомеровСтрокВыданВРейс.Количество() > 0 ИЛИ Ответ.МассивНомеровСтрокЗакрыт.Количество() > 0 Тогда
		
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить(КодВозвратаДиалога.Да,"Да");
		СписокКнопок.Добавить(КодВозвратаДиалога.Нет,"Нет");
		ТекстВопроса = "";
		Если Ответ.МассивНомеровСтрокВыданВРейс.Количество() > 0 Тогда
			ТекстВопроса = СтрШаблон("Обновление данных по строке %1 невозможно, так как текущий статус заказа на ТС Выдан в рейс.",СтрСоединить(Ответ.МассивНомеровСтрокВыданВРейс,","));
			ТекстВопроса = ТекстВопроса + Символы.ПС  + Символы.ПС;
		КонецЕсли;
		Если Ответ.МассивНомеровСтрокЗакрыт.Количество() > 0 Тогда	
			ТекстВопроса = ТекстВопроса + СтрШаблон("Обновление данных по строке %1 невозможно, так как текущий статус заказа на ТС Закрыт.",СтрСоединить(Ответ.МассивНомеровСтрокЗакрыт,","));
			ТекстВопроса = ТекстВопроса + Символы.ПС + Символы.ПС;
		КонецЕсли;
		ТекстВопроса = ТекстВопроса + "Произвести обновление доступных строк ?";
		
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбОбновлении", ЭтотОбъект, Новый Структура("АдресХранилища,КоличествоНеДобавленных",Ответ.АдресХранилища,Ответ.КоличествоНеДобавленных));
		ПоказатьВопрос(Оповещение, ТекстВопроса, СписокКнопок, 60,КодВозвратаДиалога.Нет,,КодВозвратаДиалога.Нет);
	КонецЕсли;
	
	УстановитьВидимостьКомандыДобавитьУдаленныеКТКВЗапрос();
	УстановитьПросмотрСтатусОтправкиЗапросаНаТерминалВыдачи(); 
	ЗаполнитьТаблицуПоКлючамАналитики(,Истина);
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЗаполнитьНомерДатуЗаказаНаТС();
	КонецЕсли;
	
	//Евросиб Коханенко Н.А. 07.02.2024 (( #80805
	Для Каждого СтрокаКонтейнеры Из Объект.Контейнеры Цикл 
		Если НЕ СтрокаКонтейнеры.НеТребуетсяТерминалВыдачи Тогда
			СтрокаКонтейнеры.ТипОперацииНаТерминалеВыдачи = ТипОперацииНаТерминалеВыдачиПоУмолчанию;
		КонецЕсли;
		Если НЕ СтрокаКонтейнеры.НеТребуетсяАдрес Тогда
			СтрокаКонтейнеры.ТипОперацииНаСкладеКлиента = ТипОперацииНаСкладеКлиентаПоУмолчанию;
		КонецЕсли;
		Если НЕ СтрокаКонтейнеры.НеТребуетсяТерминалСдачи Тогда
			СтрокаКонтейнеры.ТипОперацииНаТерминалеСдачи = ТипОперацииНаТерминалеСдачиПоУмолчанию;
		КонецЕсли;
	КонецЦикла;
	//Евросиб Коханенко Н.А. 07.02.2024 )) #80805 

	КонтрагентДирекцияКонтейнерныхПеревозок = Ложь;
	Если ЭтоДирекцияКонтейнерныхПеревозок() Тогда 
		КонтрагентДирекцияКонтейнерныхПеревозок = Истина;	
	КонецЕсли;
	
	Если КонтрагентДирекцияКонтейнерныхПеревозок Тогда
