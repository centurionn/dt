		Ответ = Ложь;
		ВыводитОбщееСообщение = Истина;
	КонецЕсли;
	Если МассивНомераСтатусЗапросаНаАвтоперевозкуЧерновик.Количество() > 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Отправка запроса на автоперевозку невозможна, так как запрос в строке %1 находится в статусе Черновик. Для появления возможности отправки запроса необходимо заполнить все обязательные поля в перечисленных строках и провести документ",СтрСоединить(МассивНомераСтатусЗапросаНаАвтоперевозкуЧерновик,",")));
		Ответ = Ложь;
		ВыводитОбщееСообщение = Истина;
	КонецЕсли;
	Если МассивНомераСтатусЗапросаНаАвтоперевозкуОтменен.Количество() > 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Отправка запроса на автоперевозку невозможна, так как запрос в строке %1 находится в статусе Отменен, то есть строка была удалена из запроса на автоперевозку",СтрСоединить(МассивНомераСтатусЗапросаНаАвтоперевозкуОтменен,",")));
		Ответ = Ложь;
		ВыводитОбщееСообщение = Истина;
	КонецЕсли;
	Если МассивНомераОтправленыхБезИзменений.Количество() > 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Данные по строке %1 уже были отправлены в ИС ""Транспортная логистика"" и поэтому повторно отправлены не будут",СтрСоединить(МассивНомераОтправленыхБезИзменений,",")));
		Ответ = Ложь;
		ВыводитОбщееСообщение = Истина;
	КонецЕсли;
	Если МассивНомераРазныйПланФактКТК.Количество() > 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Отправка запроса на автоперевозку невозможна, так как в запросе по строке %1 различаются значения полей ""Контейнер"" и ""Контейнер (факт.)""",СтрСоединить(МассивНомераРазныйПланФактКТК,",")));
		Ответ = Ложь;
		ВыводитОбщееСообщение = Истина;
