&НаКлиенте
Процедура ОбработкаВводаДополнительнаяИнформация(СтрокаЗнач, ДополнительныеПараметры) Экспорт
	Если СтрокаЗнач = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	ТекД = Элементы.Контейнеры.ТекущиеДанные;
	Если СтрокаЗнач <> ДополнительныеПараметры Тогда //ДИТ Шевченко А.В. 27.01.23 64884
		ТекД.ДополнительнаяИнформация = СтрокаЗнач;
		КонтейнерыПриИзменении(Элементы.Контейнеры); //ДИТ Шевченко А.В. 27.01.23 64884
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры


&НаСервере
Процедура ОбновитьОформлениеПослеЗапроса(ДатаОтправкиЗапроса)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПротоколОбменов.УИДИсточника КАК УИДИсточника 
		// ДИТ US 78233 TA 78240 Сержантова А.С. Начало: 23.01.2024
		|ПОМЕСТИТЬ ВТ_ГУИДыОтправленныхСтрок
		// ДИТ US 78233 TA 78240 Сержантова А.С. Конец: 23.01.2024
		|ИЗ
		|	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
		|ГДЕ
		|	(ВЫРАЗИТЬ(ПротоколОбменов.Объект КАК Документ.ЗапросНаАвтоперевозку)) = &Объект
		|	И ПротоколОбменов.УзелОбмена        = &УзелОбмена
		|	И ПротоколОбменов.ДействиеПриОбмене = &ДействиеПриОбмене
		|	И ПротоколОбменов.ДатаОбмена        >= &ДатаОбмена
		// ДИТ US 78233 TA 78240 Сержантова А.С. Начало: 23.01.2024 - выберем сразу все данные для фиксирования отправленных данных
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗапросНаАвтоперевозкуКонтейнеры.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	ВТ_ГуидыОтправленныхСтрок.УИДИсточника КАК ИдентификаторСтрокиТЧ,
		|	КлючиАналитикиПеревозки.Груз.ЕТСНГ КАК ГрузЕТСНГ,
		|	КлючиАналитикиПеревозки.Груз КАК Груз,
		|	КлючиАналитикиПеревозки.Контейнер КАК Контейнер,
		|	КлючиАналитикиПеревозки.ВесГруза КАК ВесГруза,
		|	КлючиАналитикиПеревозки.КоличествоМест КАК КоличествоМест,
		|	КлючиАналитикиПеревозки.ИнструкцияПоСдаче КАК ИнструкцияПоСдаче,
		|	КлючиАналитикиПеревозкиМили.АдресКлиента КАК АдресКлиента
		|ИЗ
		|	ВТ_ГуидыОтправленныхСтрок КАК ВТ_ГуидыОтправленныхСтрок
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗапросНаАвтоперевозку.Контейнеры КАК ЗапросНаАвтоперевозкуКонтейнеры
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки КАК КлючиАналитикиПеревозки
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозкиМили
		|				ПО (КлючиАналитикиПеревозки.Ссылка = КлючиАналитикиПеревозкиМили.Ссылка)
		|					И (КлючиАналитикиПеревозкиМили.ЭтапПеревозки = &ЭтапПеревозки)
		|			ПО (ЗапросНаАвтоперевозкуКонтейнеры.КлючАналитикиПеревозки = КлючиАналитикиПеревозки.Ссылка)
		|		ПО (ВТ_ГуидыОтправленныхСтрок.УИДИсточника = ЗапросНаАвтоперевозкуКонтейнеры.ИдентификаторСтрокиТЧ)
		|ГДЕ
		|	ЗапросНаАвтоперевозкуКонтейнеры.Ссылка = &Объект  
		|;
		| 
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗапросНаАвтоперевозкуКонтейнеры.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	ВТ_ГуидыОтправленныхСтрок.УИДИсточника КАК ИдентификаторСтрокиТЧ,
		|	КлючиАналитикиПеревозкиДетализацияПоГрузу.Груз КАК Груз,
		|	КлючиАналитикиПеревозкиДетализацияПоГрузу.Груз.ЕТСНГ КАК ГрузЕТСНГ,
		|	КлючиАналитикиПеревозкиДетализацияПоГрузу.КоличествоМест КАК КоличествоМест,
		|	КлючиАналитикиПеревозкиДетализацияПоГрузу.ВесГруза КАК ВесГруза
		|ИЗ
		|	ВТ_ГуидыОтправленныхСтрок КАК ВТ_ГуидыОтправленныхСтрок
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗапросНаАвтоперевозку.Контейнеры КАК ЗапросНаАвтоперевозкуКонтейнеры
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки.ДетализацияПоГрузу КАК КлючиАналитикиПеревозкиДетализацияПоГрузу
		|			ПО (ЗапросНаАвтоперевозкуКонтейнеры.КлючАналитикиПеревозки = КлючиАналитикиПеревозкиДетализацияПоГрузу.Ссылка)
		|		ПО (ВТ_ГуидыОтправленныхСтрок.УИДИсточника = ЗапросНаАвтоперевозкуКонтейнеры.ИдентификаторСтрокиТЧ)
		|ГДЕ
		|	ЗапросНаАвтоперевозкуКонтейнеры.Ссылка = &Объект  
		|ИТОГИ ПО
		|	ИдентификаторСтрокиТЧ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ГуидыОтправленныхСтрок.УИДИсточника КАК УИДИсточника
		|ИЗ
		|	ВТ_ГуидыОтправленныхСтрок КАК ВТ_ГуидыОтправленныхСтрок";
	Запрос.УстановитьПараметр("ЭтапПеревозки", Объект.ЭтапПеревозки);	
	// ДИТ US 78233 TA 78240 Сержантова А.С. Конец: 23.01.2024
	
	Запрос.УстановитьПараметр("ДатаОбмена", ДатаОтправкиЗапроса);
	Запрос.УстановитьПараметр("ДействиеПриОбмене", Перечисления.ДействияПриОбмене.ВыгрузкаДанных);
	Запрос.УстановитьПараметр("Объект", Объект.Ссылка);
	Запрос.УстановитьПараметр("УзелОбмена", Перечисления.УзлыОбмена.ТЛ);
	
	// ДИТ US 78233 TA 78240 Сержантова А.С. Начало: 23.01.2024
	// Было:
	//РезультатЗапроса = Запрос.Выполнить(); 
	//Стало:  
	ПакетРезультатов = Запрос.ВыполнитьПакет();   
	РезультатОтправленныеСтроки = ПакетРезультатов[1];
	РезультатОтправленнаяДетализациГруза = ПакетРезультатов[2];
	РезультатЗапроса = ПакетРезультатов[3];
	// ДИТ US 78233 TA 78240 Сержантова А.С. Конец: 23.01.2024
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		УстановитьУсловноеОформлениеШапки();
		СписокРекОформленияШапки.Очистить();
	КонецЕсли;	
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтруктураПоиска = Новый Структура("ИдентификаторСтрокиТЧ",ВыборкаДетальныеЗаписи.УИДИсточника);
		МассивСтрок = ТаблицаОформленияКолонок.НайтиСтроки(СтруктураПоиска);
		Если МассивСтрок.Количество() > 0 Тогда    
			// ДИТ US 78243 ТА 80825 Сержантова А.С. Начало: 08.02.2024
			// Было:
			//ТаблицаОформленияКолонок.Удалить(МассивСтрок[0]); 
			//Стало:
			Для каждого СтрокаОформления Из МассивСтрок Цикл
				ТаблицаОформленияКолонок.Удалить(СтрокаОформления);
			КонецЦикла;
			// ДИТ US 78243 ТА 80825 Сержантова А.С. Конец: 08.02.2024
		КонецЕсли;
		МассивСтрокКонтейнеры = Объект.Контейнеры.НайтиСтроки(СтруктураПоиска);
		Если МассивСтрокКонтейнеры.Количество() > 0 Тогда
			МассивСтрокКонтейнеры[0].ОбновленыИсходныеДанные = Ложь;
			Если НЕ МассивСтрокКонтейнеры[0].СтатусЗапросаНаАвтоперевозку = Перечисления.СтатусЗапросаНаПеревозку.Отменен Тогда
				МассивСтрокКонтейнеры[0].СтатусЗапросаНаАвтоперевозку = Перечисления.СтатусЗапросаНаПеревозку.Отправлен;
			КонецЕсли;  
			// ДИТ US 78233 TA 78240 Сержантова А.С. Начало: 26.01.2024
			ВерсияКлюча = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(МассивСтрокКонтейнеры[0].КлючАналитикиПеревозки, "ВерсияДанных");
			МассивСтрокКонтейнеры[0].ВерсияКлючаАналитикиОтправленоВТЛ = ВерсияКлюча;
			// ДИТ US 78233 TA 78240 Сержантова А.С. Конец: 26.01.2024
		КонецЕсли;
	КонецЦикла;  
	
	// ДИТ US 78233 TA 78240 Сержантова А.С. Начало: 23.01.2024  
	// Здесь фиксируем данные ключа, отправленные в ТЛ для дальнейшего подсвечивания измененных  
	ВыборкаОтправленныеСтроки = РезультатОтправленныеСтроки.Выбрать();
	Пока ВыборкаОтправленныеСтроки.Следующий() Цикл
		СтруктураПоиска = Новый Структура("ИдентификаторСтрокиТЧ",ВыборкаОтправленныеСтроки.ИдентификаторСтрокиТЧ);
		ОтправленныеСтроки = ДанныеКлючейОтправленныхВТЛ.НайтиСтроки(СтруктураПоиска);    
		Если ОтправленныеСтроки.Количество() > 0 Тогда 
			ЗаполнитьЗначенияСвойств(ОтправленныеСтроки[0], ВыборкаОтправленныеСтроки);
		Иначе
			НС = ДанныеКлючейОтправленныхВТЛ.Добавить();
			ЗаполнитьЗначенияСвойств(НС, ВыборкаОтправленныеСтроки);
		КонецЕсли;
	КонецЦикла;	
	ВыборкаОтправленныеСтроки = РезультатОтправленнаяДетализациГруза.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаОтправленныеСтроки.Следующий() Цикл
		СтруктураПоиска = Новый Структура("ИдентификаторСтрокиТЧ",ВыборкаОтправленныеСтроки.ИдентификаторСтрокиТЧ);
		ОтправленныеСтроки = ДетализацияПоГрузуОтправленоВТЛ.НайтиСтроки(СтруктураПоиска);    
		Если ОтправленныеСтроки.Количество() > 0 Тогда
			Для каждого СтрДетализацииПоКлючу Из ОтправленныеСтроки Цикл
				ДетализацияПоГрузуОтправленоВТЛ.Удалить(СтрДетализацииПоКлючу);	
			КонецЦикла;
		КонецЕсли;  
		ВыборкаДетализацииКлючаОтправлено = ВыборкаОтправленныеСтроки.Выбрать();
		Пока ВыборкаДетализацииКлючаОтправлено.Следующий() Цикл
			НС = ДетализацияПоГрузуОтправленоВТЛ.Добавить();
			ЗаполнитьЗначенияСвойств(НС, ВыборкаДетализацииКлючаОтправлено);
		КонецЦикла;
	КонецЦикла;  
	// ДИТ US 78233 TA 78240 Сержантова А.С. Конец: 23.01.2024
	
    УстановитьУсловноеОформлениеТЧ();
	// ДИТ US 78233 TA 78240 Сержантова А.С. Начало: 26.01.2024
	// Было:  
	//СтруктураЗаписи = Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение);
	//ЭтотОбъект.Записать(СтруктураЗаписи); 
	//Стало:    
	ЗапросОб = РеквизитФормыВЗначение("Объект");     
	ТабКлючей = РеквизитФормыВЗначение("ДанныеКлючейОтправленныхВТЛ");   
	ТабДетализацияПоГрузу = РеквизитФормыВЗначение("ДетализацияПоГрузуОтправленоВТЛ");
	ЗапросОб.ПоместитьОтправленныеДанныеВТЛВХранилище(ТабКлючей, ТабДетализацияПоГрузу); 
	// ДИТ US 78243 ТА 80825 Сержантова А.С. Начало: 08.02.2024
	ТЗОформления = РеквизитФормыВЗначение("ТаблицаОформленияКолонок");
	ЗапросОб.ПоместитьТаблицыОформленияВХранилище(ТЗОформления,СписокРекОформленияШапки);
	// ДИТ US 78243 ТА 80825 Сержантова А.С. Конец: 08.02.2024
	Попытка
		ЗапросОб.Записать(РежимЗаписиДокумента.Проведение);    
	Исключение    
		Сообщить("Не удалось записать отправленные в ТЛ данные. Проведите документ");
	КонецПопытки;      
	// ДИТ US 78243 ТА 80825 Сержантова А.С. Начало: 08.02.2024
	// Было:
	//ЭтаФорма.Прочитать();  
	//Стало:          
	ЗначениеВРеквизитФормы(ЗапросОб, "Объект");  
	ЭтаФорма.Прочитать();
	// ДИТ US 78243 ТА 80825 Сержантова А.С. Конец: 08.02.2024
	// ДИТ US 78233 TA 78240 Сержантова А.С. Конец: 26.01.2024
	
	ЗаполнитьНомерДатуЗаказаНаТС();
КонецПроцедуры	

&НаКлиенте
Функция ПроверитьВозможностьУстановкиПоляНеТребуется(ТекД,ТекПолеЗначение,КолличествоУстановленных = 0)
	
	Если ТекПолеЗначение Тогда
		Возврат Истина;
	КонецЕсли;	
	
	Если ТекД.НеТребуетсяТерминалВыдачи Тогда
		КолличествоУстановленных = КолличествоУстановленных + 1;
	КонецЕсли;
	Если ТекД.НеТребуетсяТерминалСдачи Тогда
		КолличествоУстановленных = КолличествоУстановленных + 1;
	КонецЕсли;
	Если ТекД.НеТребуетсяАдрес Тогда
		КолличествоУстановленных = КолличествоУстановленных + 1;
	КонецЕсли;
	
	Если КолличествоУстановленных >= 2 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Исключение более двух пунктов из маршрута перевозки невозможно",,,,);	
	КонецЕсли;	
	
	Возврат КолличествоУстановленных < 2;
	
КонецФункции	

&НаКлиенте
Процедура ПослеЗакрытияВопросаОбОбновлении(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет или Результат = КодВозвратаДиалога.Таймаут Тогда
        Возврат;
	КонецЕсли;
	ПолучитьПромежуточнуюИзХранилищаИОбновить(Параметры.АдресХранилища,Параметры.КоличествоНеДобавленных);	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаПланФактКТК(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет или Результат = КодВозвратаДиалога.Таймаут Тогда
        Возврат;
	КонецЕсли;
	ВыгрузитьЗаказНаАвтоПоИзменениямПланФактКТК(Параметры.МассивГуидовТЧ);	
КонецПроцедуры

&НаСервере
Процедура ПроверитьИзменениеИОформить(СсылкаЗапрос,ИмяПоля,НовоеЗначение,ПолеУсловия,МассивИзменяемыхИдентификаторов,ИмяТЧ,ЭтоАдрес = Ложь)
	
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 начало
	Если ИмяПоля = "Груз" ИЛИ ИмяПоля = "Контейнер" 
		// ДИТ US 76935 ТА 78648 Сержантова А.С. Начало: 18.12.2023
		или ИмяПоля = "ИнструкцияПоСдаче" Тогда
		// ДИТ US 76935 ТА 78648 Сержантова А.С. Конец: 18.12.2023
		ИмяПоля = "КлючАналитикиПеревозки." + ИмяПоля;	
	КонецЕсли;	
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 конец
	
	//ДИТ Шевченко А.В. US 62421 ТА 67386 18.05.2023 -Начало
	//Если ЭтоАдрес Тогда
	//	
	//	ТекстЗапроса = 
	//	"ВЫБРАТЬ
	//	|	ЗапросНаАвтоперевозкуКонтейнеры.ИдентификаторСтрокиТабличнойЧасти КАК ИдентификаторСтрокиТабличнойЧасти,
	//	|	ЗапросНаАвтоперевозкуКонтейнеры.ИдентификаторСтрокиТЧ КАК ИдентификаторСтрокиТЧ
	//	|ПОМЕСТИТЬ ВТ_СтрокаТЧ
	//	|ИЗ
	//	|	Документ.ЗапросНаАвтоперевозку.Контейнеры КАК ЗапросНаАвтоперевозкуКонтейнеры
	//	|ГДЕ
	//	|	ЗапросНаАвтоперевозкуКонтейнеры.ИдентификаторСтрокиТЧ В(&ИдентификаторСтрокиТЧ)
	//	|	И ЗапросНаАвтоперевозкуКонтейнеры.Ссылка = &Ссылка
	//	|;
	//	|
	//	|////////////////////////////////////////////////////////////////////////////////
	//	|ВЫБРАТЬ
	//	|	ЕСТЬNULL(ЗапросНаАвтоперевозкуКонтактнаяИнформация.Представление, """") КАК ИмяПоля,
	//	|	ВТ_СтрокаТЧ.ИдентификаторСтрокиТЧ КАК ИдентификаторСтрокиТЧ
	//	|ИЗ
	//	|	ВТ_СтрокаТЧ КАК ВТ_СтрокаТЧ
	//	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗапросНаАвтоперевозку.КонтактнаяИнформация КАК ЗапросНаАвтоперевозкуКонтактнаяИнформация
	//	|		ПО ВТ_СтрокаТЧ.ИдентификаторСтрокиТабличнойЧасти = ЗапросНаАвтоперевозкуКонтактнаяИнформация.ИдентификаторСтрокиТабличнойЧасти";
	
	Запрос = Новый Запрос;
	
	Если ИмяПоля = "АдресКлиента" Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	КлючМили."+ИмяПоля+" КАК ИмяПоля,
		|	ЗапросНаАвтоперевозкуКонтейнеры.ИдентификаторСтрокиТЧ КАК ИдентификаторСтрокиТЧ
		|ИЗ
		|	Документ.ЗапросНаАвтоперевозку."+ИмяТЧ+" КАК ЗапросНаАвтоперевозкуКонтейнеры
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки.Мили КАК КлючМили
		|				ПО ЗапросНаАвтоперевозкуКонтейнеры.КлючАналитикиПеревозки = КлючМили.Ссылка
		|					И КлючМили.ЭтапПеревозки = &ЭтапПеревозки
		|ГДЕ
		|	ЗапросНаАвтоперевозкуКонтейнеры.Ссылка = &Ссылка
		|	И ЗапросНаАвтоперевозкуКонтейнеры.ИдентификаторСтрокиТЧ В(&ИдентификаторСтрокиТЧ)";
		
		Запрос.УстановитьПараметр("ЭтапПеревозки", Объект.ЭтапПеревозки);
	//ДИТ Шевченко А.В. US 62421 ТА 67386 18.05.2023 -конец	
	Иначе
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ЗапросНаАвтоперевозкуКонтейнеры."+ИмяПоля+" КАК ИмяПоля,
		|	ЗапросНаАвтоперевозкуКонтейнеры.ИдентификаторСтрокиТЧ КАК ИдентификаторСтрокиТЧ
		|ИЗ
		|	Документ.ЗапросНаАвтоперевозку."+ИмяТЧ+" КАК ЗапросНаАвтоперевозкуКонтейнеры
		|ГДЕ
		|	ЗапросНаАвтоперевозкуКонтейнеры.Ссылка = &Ссылка
		|	И ЗапросНаАвтоперевозкуКонтейнеры.ИдентификаторСтрокиТЧ В(&ИдентификаторСтрокиТЧ)";
		
	КонецЕсли;	
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("ИдентификаторСтрокиТЧ", МассивИзменяемыхИдентификаторов);
	Запрос.УстановитьПараметр("Ссылка", СсылкаЗапрос);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		
	Для Каждого ИдентифСтроки Из МассивИзменяемыхИдентификаторов Цикл
		СтруктураПоиска = Новый Структура("ИдентификаторСтрокиТЧ",ИдентифСтроки);
		НайденныеСтроки = РезультатЗапроса.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() > 0 Тогда
			Если НайденныеСтроки[0].ИмяПоля = НовоеЗначение И НЕ ЭтоАдрес Тогда
				//УдалитьСтрокуИзТаблицыОформления(ИмяПоля,ПолеУсловия,ИдентифСтроки,ИмяТЧ);
				Продолжить;
			КонецЕсли;
			ОбновитьТаблицуОформления(ИмяПоля,ПолеУсловия,ИдентифСтроки,ИмяТЧ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьНомерДатуЗаказаНаТС()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		//Евросиб Коханенко Н.А. 06.06.2024 (( #83866 
		//|	ПротоколОбменов.ДатаОбмена КАК ДатаСозданияЗаказаНаТС,
		|	ПротоколОбменов.ДатаОбмена КАК ДатаОбновленияЗаказаНаТС,
		//Евросиб Коханенко Н.А. 06.06.2024 )) #83866 
		|	ПротоколОбменов.НомерДатаВБУ КАК НомерЗаказаНаТС,
		|	ПротоколОбменов.УИДИсточника КАК ИдентификаторСтрокиТЧ
		|ИЗ
		|	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
		|ГДЕ
		|	(ВЫРАЗИТЬ(ПротоколОбменов.Объект КАК Документ.ЗапросНаАвтоперевозку)) = &Объект
		|	И ПротоколОбменов.УзелОбмена = &УзелОбмена";
	
	Запрос.УстановитьПараметр("Объект", Объект.Ссылка);
	Запрос.УстановитьПараметр("УзелОбмена", Перечисления.УзлыОбмена.ТЛ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтруктураПоиска = Новый Структура("ИдентификаторСтрокиТЧ",ВыборкаДетальныеЗаписи.ИдентификаторСтрокиТЧ);
		НайденыеСтроки = Объект.Контейнеры.НайтиСтроки(СтруктураПоиска);
		Если НайденыеСтроки.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(НайденыеСтроки[0],ВыборкаДетальныеЗаписи);
		КонецЕсли;	
	КонецЦикла;
	Модифицированность = ЭтаФорма.Модифицированность;
КонецПроцедуры	

&НаСервере
Функция ПроверитьСтрокиНаВозможностьВосстановления(ГуидыДляВосставновления,Заявка,ЭтапПеревозки)
	
	МассивСтрокДобавленныеИзУслуг      = Новый Массив;
	МассивСтрокДобавленныеИзЗапросаКТК = Новый Массив;
	Для Каждого ГуидСтрокиДляВосставновления Из ГуидыДляВосставновления Цикл
		СтруктураОтбора = Новый Структура("ИдентификаторСтрокиТЧ",ГуидСтрокиДляВосставновления);
		НайденныеСтроки = Объект.Контейнеры.НайтиСтроки(СтруктураОтбора);
		
		Если НайденныеСтроки.Количество() > 0 Тогда			
			СтрокаДляВосставновления = НайденныеСтроки[0];
			Если ЗначениеЗаполнено(СтрокаДляВосставновления.ИдентификаторСтрокиУслуги) Тогда
				МассивСтрокДобавленныеИзУслуг.Добавить(СтрокаДляВосставновления);
			Иначе
				МассивСтрокДобавленныеИзЗапросаКТК.Добавить(СтрокаДляВосставновления);
			КонецЕсли;		
		КонецЕсли;			
	КонецЦикла;
	
	Если МассивСтрокДобавленныеИзУслуг.Количество() > 0 Тогда
		МассивГуидовУслугиИтог = ПроверитВозможностьВосстановленияИзУслуг(МассивСтрокДобавленныеИзУслуг,Заявка,ЭтапПеревозки);
		Для Каждого МассивГуид из МассивГуидовУслугиИтог Цикл
			СтруктураПоиска = Новый Структура("ИдентификаторСтрокиТЧ",МассивГуид);
			НайденнаяСтрока = Объект.Контейнеры.НайтиСтроки(СтруктураПоиска);
			Если НайденнаяСтрока.Количество() > 0 Тогда
				НайденнаяСтрока[0].СтатусЗапросаНаАвтоперевозку = Перечисления.СтатусЗапросаНаПеревозку.Черновик;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	
	Если МассивСтрокДобавленныеИзЗапросаКТК.Количество() > 0 Тогда
		МассивГуидовЗапросИтог = ПроверитВозможностьВосстановленияИзЗапроса(МассивСтрокДобавленныеИзЗапросаКТК,Заявка,ЭтапПеревозки);
		Для Каждого МассивГуид из МассивГуидовЗапросИтог Цикл
			СтруктураПоиска = Новый Структура("ИдентификаторСтрокиТЧ",МассивГуид);
			НайденнаяСтрока = Объект.Контейнеры.НайтиСтроки(СтруктураПоиска);
			Если НайденнаяСтрока.Количество() > 0 Тогда
				НайденнаяСтрока[0].СтатусЗапросаНаАвтоперевозку = Перечисления.СтатусЗапросаНаПеревозку.Черновик;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	
	МассивНеВосстановленныхНомеровСтрок = Новый Массив;
	
	Для Каждого МассивЗнч Из МассивСтрокДобавленныеИзУслуг Цикл
		Если МассивГуидовУслугиИтог.Найти(МассивЗнч.ИдентификаторСтрокиТЧ) = Неопределено Тогда
			МассивНеВосстановленныхНомеровСтрок.Добавить(МассивЗнч.НомерСтроки);			
		КонецЕсли;	
	КонецЦикла;
	
	Для Каждого МассивЗнч Из МассивСтрокДобавленныеИзЗапросаКТК Цикл
		Если МассивГуидовЗапросИтог.Найти(МассивЗнч.ИдентификаторСтрокиТЧ) = Неопределено Тогда
			МассивНеВосстановленныхНомеровСтрок.Добавить(МассивЗнч.НомерСтроки);			
		КонецЕсли;	
	КонецЦикла;
	
	Возврат МассивНеВосстановленныхНомеровСтрок;
	
КонецФункции	

&НаСервереБезКонтекста
Функция ПроверитВозможностьВосстановленияИзУслуг(МассивСтрокДобавленныеИзУслуг,Заявка,ЭтапПеревозки)
	
	Тз = Новый ТаблицаЗначений;
	Тз.Колонки.Добавить("ИдентификаторСтрокиУслуги",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36)));
	Тз.Колонки.Добавить("ИдентификаторСтрокиТЧ",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36)));
	Для Каждого СтрокаМ Из МассивСтрокДобавленныеИзУслуг Цикл
		ЗаполнитьЗначенияСвойств(Тз.Добавить(),СтрокаМ);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТЗ.ИдентификаторСтрокиУслуги КАК ИдентификаторСтрокиУслуги,
	               |	ТЗ.ИдентификаторСтрокиТЧ КАК ИдентификаторСтрокиТЧ
	               |ПОМЕСТИТЬ ВТ_СтрокиДляВосстановления
	               |ИЗ
	               |	&ТЗ КАК ТЗ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_СтрокиДляВосстановления.ИдентификаторСтрокиУслуги КАК ИдентификаторСтрокиУслуги,
	               |	ВТ_СтрокиДляВосстановления.ИдентификаторСтрокиТЧ КАК ИдентификаторСтрокиТЧ
	               |ИЗ
	               |	ВТ_СтрокиДляВосстановления КАК ВТ_СтрокиДляВосстановления
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
	               |		ПО ВТ_СтрокиДляВосстановления.ИдентификаторСтрокиУслуги = ЗаявкаСоставУслуги.ГУИДСтроки
	               |ГДЕ
	               |	ЗаявкаСоставУслуги.Ссылка = &Ссылка
	               |	И &Миля = ЗНАЧЕНИЕ(Перечисление.ВариантыАвтоперевозки.СиламиЕвросиб)";
	
	Запрос.УстановитьПараметр("ТЗ",Тз);
	Запрос.УстановитьПараметр("Ссылка",Заявка);
	Если ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПерваяМиля Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&Миля","ЗаявкаСоставУслуги.ПерваяМиля");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&Миля","ЗаявкаСоставУслуги.ПоследняяМиля");
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаРезультата = РезультатЗапроса.Выбрать();
	
	МассивДляВозврата = Новый Массив;
	Пока ВыборкаРезультата.Следующий() Цикл
		МассивДляВозврата.Добавить(ВыборкаРезультата.ИдентификаторСтрокиТЧ);
	КонецЦикла;	
	
	Возврат МассивДляВозврата;
	
КонецФункции	

&НаСервере
Функция ПроверитВозможностьВосстановленияИзЗапроса(МассивСтрокДобавленныеИзЗапросаКТК,Заявка,ЭтапПеревозки)
	
	ТаблицаСтрокКонтейнеровДляВосст = Новый ТаблицаЗначений;
	ТаблицаСтрокКонтейнеровДляВосст.Колонки.Добавить("ИдентификаторСтрокиЗапроса",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36)));
	ТаблицаСтрокКонтейнеровДляВосст.Колонки.Добавить("ИдентификаторСтрокиТЧ",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36)));
	ТаблицаСтрокКонтейнеровДляВосст.Колонки.Добавить("Релиз",Новый ОписаниеТипов("ДокументСсылка.РелизКлиента"));
	ТаблицаСтрокКонтейнеровДляВосст.Колонки.Добавить("НеВосстанавливать",Новый ОписаниеТипов("булево"));
	ТаблицаСтрокКонтейнеровДляВосст.Колонки.Добавить("Количество",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10)));
	
	Для Каждого МассивЗнч Из МассивСтрокДобавленныеИзЗапросаКТК Цикл
		СтруктураПоиска = Новый Структура("ИдентификаторСтрокиТЧ",МассивЗнч.ИдентификаторСтрокиТЧ);
		НайденныеСтроки = Объект.Контейнеры.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() > 0 Тогда
			НовСтрока = ТаблицаСтрокКонтейнеровДляВосст.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока,НайденныеСтроки[0]);
			НовСтрока.Количество = 1;
		КонецЕсли;	
	КонецЦикла;	
	
	ИдентификаторыСИзмененнымСтатусом = ПроверитьИзменениеСтатусаСиламиЕвросибвЗаявке(ТаблицаСтрокКонтейнеровДляВосст.ВыгрузитьКолонку("ИдентификаторСтрокиЗапроса"),Заявка,ЭтапПеревозки);
	
	Для Каждого Идентиф Из ИдентификаторыСИзмененнымСтатусом Цикл
		СтруктураПоиска = Новый Структура("ИдентификаторСтрокиЗапроса",Идентиф);
		НайденныеСтроки = ТаблицаСтрокКонтейнеровДляВосст.НайтиСтроки(СтруктураПоиска);
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			НайденнаяСтрока.НеВосстанавливать = Истина;
		КонецЦикла;	
	КонецЦикла;	
	
	
	ТаблицаТекНеОтмененныхСтрокВРазрезеРелизов                = ТаблицаСтрокКонтейнеровДляВосст.СкопироватьКолонки("Релиз,Количество");         //Для восстановления строк с релизами
	ТаблицаТекНеОтмененныхСтрокВРазрезеИдентификаторовЗапроса = ТаблицаСтрокКонтейнеровДляВосст.СкопироватьКолонки("ИдентификаторСтрокиЗапроса,Количество"); //Для восстановления строк без релизов
	МассивРелизовСтрокНаВосстановление = ТаблицаСтрокКонтейнеровДляВосст.ВыгрузитьКолонку("Релиз");
	
	Для Каждого СтрокаТЧ Из Объект.Контейнеры Цикл
		Если ЗначениеЗаполнено(СтрокаТч.Релиз) И СтрокаТЧ.СтатусЗапросаНаАвтоперевозку <> Перечисления.СтатусЗапросаНаПеревозку.Отменен Тогда
			НовСтрока = ТаблицаТекНеОтмененныхСтрокВРазрезеРелизов.Добавить();
			НовСтрока.Релиз = СтрокаТч.Релиз;
			НовСтрока.Количество 		 = 1;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаТч.Релиз) И СтрокаТЧ.СтатусЗапросаНаАвтоперевозку <> Перечисления.СтатусЗапросаНаПеревозку.Отменен Тогда
			НовСтрока = ТаблицаТекНеОтмененныхСтрокВРазрезеИдентификаторовЗапроса.Добавить();
			НовСтрока.ИдентификаторСтрокиЗапроса = СтрокаТч.ИдентификаторСтрокиЗапроса;
			НовСтрока.Количество 		 = 1;
		КонецЕсли;
	КонецЦикла;	
	
	ТаблицаТекНеОтмененныхСтрокВРазрезеРелизов.Свернуть("Релиз","Количество");	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТЗ.ИдентификаторСтрокиЗапроса КАК ИдентификаторСтрокиЗапроса,
	               |	ТЗ.Количество КАК Количество
	               |ПОМЕСТИТЬ ВТ_НеОтмененныеТЗБезРелизов
	               |ИЗ
	               |	&ТЗБезРелизов КАК ТЗ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЗаявкаСписокЗапросНаКТК.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	МАКСИМУМ(ЗаявкаСписокЗапросНаКТК.КоличествоКТК) КАК КоличествоКТК,
	               |	СУММА(ЕстьNull(ВТ_НеОтмененныеТЗБезРелизов.Количество,0)) КАК Количество
	               |ПОМЕСТИТЬ ВТ_КоличествоСтрокПоИндетификаторам
	               |ИЗ
	               |	Документ.Заявка.СписокЗапросНаКТК КАК ЗаявкаСписокЗапросНаКТК
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_НеОтмененныеТЗБезРелизов КАК ВТ_НеОтмененныеТЗБезРелизов
	               |		ПО ЗаявкаСписокЗапросНаКТК.ИдентификаторСтроки = ВТ_НеОтмененныеТЗБезРелизов.ИдентификаторСтрокиЗапроса
	               |ГДЕ
	               |	ЗаявкаСписокЗапросНаКТК.Ссылка = &ТекЗаявка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаявкаСписокЗапросНаКТК.ИдентификаторСтроки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТЗ.Релиз КАК Релиз,
	               |	ТЗ.Количество КАК Количество
	               |ПОМЕСТИТЬ ВТ_НеОтмененныеТЗ
	               |ИЗ
	               |	&ТЗ КАК ТЗ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	РелизКлиента.Ссылка КАК Релиз,
	               |	РелизКлиента.ОбщееКоличествоКТКВРелизе - ЕСТЬNULL(ВТ_НеОтмененныеТЗ.Количество, 0) КАК КоличествоКТКВРелизеСУчетомЗапроса
	               |ПОМЕСТИТЬ ВТ_НеОтмененные
	               |ИЗ
	               |	Документ.РелизКлиента КАК РелизКлиента
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НеОтмененныеТЗ КАК ВТ_НеОтмененныеТЗ
	               |		ПО (ВТ_НеОтмененныеТЗ.Релиз = РелизКлиента.Ссылка)
	               |ГДЕ
	               |	РелизКлиента.Ссылка В(&МассивРелизовСтрокНаВосстановление)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	РелизыКлиентовЗапросовНаКТК.РелизКлиента КАК РелизКлиента,
	               |	СУММА(1) КАК КоличествоВДругихЗапросах
	               |ПОМЕСТИТЬ ВТ_КоличествоИзСвязаныхСРелизомЗапросов
	               |ИЗ
	               |	РегистрСведений.РелизыКлиентовЗапросовНаКТК КАК РелизыКлиентовЗапросовНаКТК
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_НеОтмененные КАК ВТ_НеОтмененные
	               |		ПО РелизыКлиентовЗапросовНаКТК.РелизКлиента = ВТ_НеОтмененные.Релиз
	               |			И (РелизыКлиентовЗапросовНаКТК.Заявка <> &ТекЗаявка)
	               |			И (РелизыКлиентовЗапросовНаКТК.РелизКлиента <> ЗНАЧЕНИЕ(Документ.РелизКлиента.ПустаяСсылка))
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗапросНаАвтоперевозку.Контейнеры КАК ЗапросНаАвтоперевозкуКонтейнеры
	               |		ПО РелизыКлиентовЗапросовНаКТК.Заявка = ЗапросНаАвтоперевозкуКонтейнеры.Ссылка.Заявка
	               |			И РелизыКлиентовЗапросовНаКТК.ИдентификаторСтрокиЗаявки = ЗапросНаАвтоперевозкуКонтейнеры.ИдентификаторСтрокиЗапроса
	               |			И (ЗапросНаАвтоперевозкуКонтейнеры.СтатусЗапросаНаАвтоперевозку <> ЗНАЧЕНИЕ(Перечисление.СтатусЗапросаНаПеревозку.Отменен))
	               |			И РелизыКлиентовЗапросовНаКТК.РелизКлиента = ЗапросНаАвтоперевозкуКонтейнеры.Релиз
	               |			И (ЗапросНаАвтоперевозкуКонтейнеры.Ссылка.ЭтапПеревозки = &ЭтапПеревозки)
	               |			И (ЗапросНаАвтоперевозкуКонтейнеры.Ссылка.Проведен)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РелизыКлиентовЗапросовНаКТК.РелизКлиента
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_НеОтмененные.Релиз КАК Релиз,
	               |	ВТ_НеОтмененные.КоличествоКТКВРелизеСУчетомЗапроса - ЕСТЬNULL(ВТ_КоличествоИзСвязаныхСРелизомЗапросов.КоличествоВДругихЗапросах, 0) КАК Количество
	               |ИЗ
	               |	ВТ_НеОтмененные КАК ВТ_НеОтмененные
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоИзСвязаныхСРелизомЗапросов КАК ВТ_КоличествоИзСвязаныхСРелизомЗапросов
	               |		ПО ВТ_НеОтмененные.Релиз = ВТ_КоличествоИзСвязаныхСРелизомЗапросов.РелизКлиента
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_КоличествоСтрокПоИндетификаторам.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	ВТ_КоличествоСтрокПоИндетификаторам.КоличествоКТК - ВТ_КоличествоСтрокПоИндетификаторам.Количество КАК Количество
	               |ИЗ
	               |	ВТ_КоличествоСтрокПоИндетификаторам КАК ВТ_КоличествоСтрокПоИндетификаторам";
	
	Запрос.УстановитьПараметр("МассивРелизовСтрокНаВосстановление", МассивРелизовСтрокНаВосстановление);
	Запрос.УстановитьПараметр("ТЗ", ТаблицаТекНеОтмененныхСтрокВРазрезеРелизов);
	Запрос.УстановитьПараметр("ТЗБезРелизов", ТаблицаТекНеОтмененныхСтрокВРазрезеИдентификаторовЗапроса);
	Запрос.УстановитьПараметр("ТекЗаявка", Заявка);
	Запрос.УстановитьПараметр("ЭтапПеревозки", ЭтапПеревозки);
	РезультатЗапроса = Запрос.ВыполнитьПакет(); 
	ВыборкаРезультатаСРелизами  = РезультатЗапроса[5].Выбрать();
	ВыборкаРезультатаБезРелизов = РезультатЗапроса[6].Выбрать();
	
	Пока ВыборкаРезультатаСРелизами.Следующий() Цикл
		
		ОбщееКоличествоКТКВРелизе = ВыборкаРезультатаСРелизами.Количество;	
		
		СтруктураПоиска = Новый Структура("Релиз,НеВосстанавливать",ВыборкаРезультатаСРелизами.Релиз,Ложь);
		НайденныеСтроки = ТаблицаСтрокКонтейнеровДляВосст.НайтиСтроки(СтруктураПоиска);
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			Если ОбщееКоличествоКТКВРелизе <= 0 Тогда
				НайденнаяСтрока.НеВосстанавливать = Истина;
			КонецЕсли;	
			ОбщееКоличествоКТКВРелизе = ОбщееКоличествоКТКВРелизе - 1;
		КонецЦикла;	
		
	КонецЦикла;
	
	Пока ВыборкаРезультатаБезРелизов.Следующий() Цикл
		
		ОбщееКоличествоКТКВЗапросе = ВыборкаРезультатаБезРелизов.Количество;	
		
		СтруктураПоиска = Новый Структура("ИдентификаторСтрокиЗапроса,НеВосстанавливать",ВыборкаРезультатаБезРелизов.ИдентификаторСтроки,Ложь);
		НайденныеСтроки = ТаблицаСтрокКонтейнеровДляВосст.НайтиСтроки(СтруктураПоиска);
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			Если ОбщееКоличествоКТКВЗапросе <= 0 Тогда
				НайденнаяСтрока.НеВосстанавливать = Истина;
			КонецЕсли;	
			ОбщееКоличествоКТКВЗапросе = ОбщееКоличествоКТКВЗапросе - 1;
		КонецЦикла;	
		
	КонецЦикла;
	
	ТаблицаПредварительная = ТаблицаСтрокКонтейнеровДляВосст.Скопировать(Новый Структура("НеВосстанавливать",Ложь),"ИдентификаторСтрокиТЧ");
	МассивВозврата = ТаблицаПредварительная.ВыгрузитьКолонку("ИдентификаторСтрокиТЧ");
	Возврат МассивВозврата;
КонецФункции	

&НаСервере
Функция ПроверитьИзменениеСтатусаСиламиЕвросибвЗаявке(ИдентЗапроса,Заявка,ЭтапПеревозки)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаявкаСписокЗапросНаКТК.ИдентификаторСтроки КАК ИдентификаторСтроки
		|ИЗ
		|	Документ.Заявка.СписокЗапросНаКТК КАК ЗаявкаСписокЗапросНаКТК
		|ГДЕ
		|	ЗаявкаСписокЗапросНаКТК.Ссылка = &Ссылка
		|	И ЗаявкаСписокЗапросНаКТК.ИдентификаторСтроки В(&ИдентификаторСтроки)
		|	И &Миля <> ЗНАЧЕНИЕ(Перечисление.ВариантыАвтоперевозки.СиламиЕвросиб)";
	
    Если ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПерваяМиля Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&Миля","ЗаявкаСписокЗапросНаКТК.Автоперевозка");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&Миля","ЗаявкаСписокЗапросНаКТК.ПоследняяМиля");
	КонецЕсли;
	Запрос.УстановитьПараметр("ИдентификаторСтроки", ИдентЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Заявка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	МассивОтвет = Новый Массив;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МассивОтвет.Добавить(ВыборкаДетальныеЗаписи.ИдентификаторСтроки);
	КонецЦикла;
	
	Возврат МассивОтвет;
	
КонецФункции	

&НаСервере
Функция ПолучитьАдресТЧ()
	СтруктураОтбора = Новый Структура("СтатусЗапросаНаАвтоперевозку",Перечисления.СтатусЗапросаНаПеревозку.Отменен);
	НайденныеСтроки = Объект.Контейнеры.НайтиСтроки(СтруктураОтбора);
	Возврат ПоместитьВоВременноеХранилище(НайденныеСтроки,ЭтаФорма.УникальныйИдентификатор);
КонецФункции	

&НаКлиенте
Процедура УстановитьВидимостьКомандыДобавитьУдаленныеКТКВЗапрос()
	
	СтруктураПоиска = Новый Структура("СтатусЗапросаНаАвтоперевозку",ПредопределенноеЗначение("Перечисление.СтатусЗапросаНаПеревозку.Отменен"));
	НайденныеСтроки = Объект.Контейнеры.НайтиСтроки(СтруктураПоиска);
	
	//Евросиб Коханенко Н.А. 16.05.2024 (( #83866 
	МассивГУИДыПеренесенныхКТК = ПолучитьМассивГУИДовПеренесенныхКТК(Объект.Заявка);
	КоличествоСтрок = НайденныеСтроки.Количество()-1;
    ИндексСтроки = КоличествоСтрок;
	Для Счетчик = 0 по КоличествоСтрок Цикл
		СтрокаКТК = НайденныеСтроки[ИндексСтроки];
		Если МассивГУИДыПеренесенныхКТК.Найти(СтрокаКТК.ИдентификаторСтрокиУслуги) <> Неопределено Тогда
			НайденныеСтроки.Удалить(ИндексСтроки);	
		КонецЕсли;
       	ИндексСтроки = ИндексСтроки - 1;
	КонецЦикла;
	//Евросиб Коханенко Н.А. 16.05.2024 )) #83866 

	Элементы.КонтейнерыДобавитьУдаленныеКТКВЗапрос.Видимость = НайденныеСтроки.Количество() > 0; 
	
КонецПроцедуры	

&НаСервере
Процедура УстановитьРежимыВыбораДляТабличнойЧасти()
	
	Элементы.КонтейнерыТипОперацииНаТерминалеВыдачи.РежимВыбораИзСписка = Истина;
    Элементы.КонтейнерыТипОперацииНаТерминалеВыдачи.СписокВыбора.Добавить(Перечисления.ТипОперацииНаТерминале.ПриемПорожнегоКТК);
    Элементы.КонтейнерыТипОперацииНаТерминалеВыдачи.СписокВыбора.Добавить(Перечисления.ТипОперацииНаТерминале.ПриемГруженогоКТК);
	
	Элементы.КонтейнерыТипОперацииНаСкладеКлиента.РежимВыбораИзСписка = Истина;
    Элементы.КонтейнерыТипОперацииНаСкладеКлиента.СписокВыбора.Добавить(Перечисления.ТипОперацииНаТерминале.ЗагрузкаПорожнегоКТК);
    Элементы.КонтейнерыТипОперацииНаСкладеКлиента.СписокВыбора.Добавить(Перечисления.ТипОперацииНаТерминале.РазгрузкаГруженогоКТК);
	
	Элементы.КонтейнерыТипОперацииНаТерминалеСдачи.РежимВыбораИзСписка = Истина;                             
    Элементы.КонтейнерыТипОперацииНаТерминалеСдачи.СписокВыбора.Добавить(Перечисления.ТипОперацииНаТерминале.СдачаПорожнегоКТК);
    Элементы.КонтейнерыТипОперацииНаТерминалеСдачи.СписокВыбора.Добавить(Перечисления.ТипОперацииНаТерминале.СдачаГруженогоКТК);
	
	ТипыЛокаций.Добавить(Справочники.ТипыЛокаций.Терминал);
	ТипыЛокаций.Добавить(Справочники.ТипыЛокаций.Порт);
	ТипыЛокаций.Добавить(Справочники.ТипыЛокаций.СтанцияЖД);
	
	//Евросиб Коханенко Н.А. 04.10.2023 (( US 75549 TA 75773 
	Элементы.ДополнительныеАдресаКлиентаТипОперацииНаСкладеКлиента.РежимВыбораИзСписка = Истина;                             
    Элементы.ДополнительныеАдресаКлиентаТипОперацииНаСкладеКлиента.СписокВыбора.Добавить(Перечисления.ТипОперацииНаТерминале.ЗагрузкаПорожнегоКТК);
    Элементы.ДополнительныеАдресаКлиентаТипОперацииНаСкладеКлиента.СписокВыбора.Добавить(Перечисления.ТипОперацииНаТерминале.РазгрузкаГруженогоКТК);
	//Евросиб Коханенко Н.А. 04.10.2023 )) US 75549 TA 75773 
	
КонецПроцедуры	

&НаКлиенте
Процедура ПроверитьСоответствиеВесаДетализацииПоГрузу(Отказ)
	СтруктураОтбора = Новый Структура("Груз",ПредопределенноеЗначение("Справочник.Грузы.СборнаяКонтейнернаяОтправка"));
	
	НайденныеСтроки = Объект.Контейнеры.НайтиСтроки(СтруктураОтбора);
	
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Если НайденнаяСтрока.СтатусЗапросаНаАвтоперевозку = ПредопределенноеЗначение("Перечисление.СтатусЗапросаНаПеревозку.Отменен") Тогда
			Продолжить;
		КонецЕсли;
		
		ВесГрузаНетто  = НайденнаяСтрока.ВесГрузаНетто;
		КоличествоМест = НайденнаяСтрока.КоличествоМест;
		
		//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 начало
		//СтруктураОтбораДГ = Новый Структура("ГУИДСтроки",НайденнаяСтрока.ИдентификаторСтрокиТЧ);
		//НайденыеСтрокиДГ = Объект.ДетализацияПоГрузу.НайтиСтроки(СтруктураОтбораДГ);
		
		СтруктураОтбораДГ = Новый Структура("Ключ",НайденнаяСтрока.КлючАналитикиПеревозки);
		НайденыеСтрокиДГ = ДетализацияПоГрузу.НайтиСтроки(СтруктураОтбораДГ);
		//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 конец
		
		ВесГруза 		= 0;
		КоличествоМестД  = 0;
		
		Для Каждого СтрокаДГ Из НайденыеСтрокиДГ Цикл
			ВесГруза = ВесГруза + СтрокаДГ.ВесГруза;
			КоличествоМестД = КоличествоМестД + СтрокаДГ.КоличествоМест;
		КонецЦикла;	
		
		Если ВесГрузаНетто <> ВесГруза Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Несоответствие общего веса груза в строке %1 с суммой значений веса в таблице Детализация по грузу",НайденнаяСтрока.НомерСтроки));
		КонецЕсли;
		
		Если КоличествоМест <> КоличествоМестД Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Несоответствие количества мест груза в строке %1 с суммой значений количества мест в таблице Детализация по грузу",НайденнаяСтрока.НомерСтроки));
		КонецЕсли;
		
	КонецЦикла;   
	
	// ДИТ US 76935 ТА 78648 Сержантова А.С. Начало: 18.12.2023
	// если поле Груз не заполнено, тогда отказ! (проверка из процедуры ОбработкаПроверкиЗаполнения)  
	СтатусыНепроверяемыхСтрок = Новый Массив;
	СтатусыНепроверяемыхСтрок.Добавить(ПредопределенноеЗначение("Перечисление.СтатусЗапросаНаПеревозку.Отменен"));
	СтатусыНепроверяемыхСтрок.Добавить(ПредопределенноеЗначение("Перечисление.СтатусЗапросаНаПеревозку.Черновик"));
	
	ТекстОшибки = "Не заполнена колонка %1 в строке %2 списка ""Контейнеры""";
	
	Для каждого СтрокаТЧ Из Объект.Контейнеры Цикл   
		
		Если СтатусыНепроверяемыхСтрок.Найти(СтрокаТЧ.СтатусЗапросаНаАвтоперевозку) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;            
		
		Если не ЭтоДирекцияКонтейнерныхПеревозок() 
			//Евросиб Коханенко Н.А. 19.02.2025 (( #102955 
			И НЕ Объект.ЭтапПеревозки = ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.СредняяМиля")
			//Евросиб Коханенко Н.А. 19.02.2025 )) #102955 
			и Не ЗначениеЗаполнено(СтрокаТЧ.Груз) Тогда
			Отказ = Истина;  
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(ТекстОшибки, "Груз", СтрокаТЧ.НомерСтроки)); 
		КонецЕсли;	
	КонецЦикла;
	// ДИТ US 76935 ТА 78648 Сержантова А.С. Конец: 18.12.2023
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьНаОснованииЗаявки(ЗаявкаПараметр)
	
	ЗаполнитьШапку(ЗаявкаПараметр);
	ЗаполнитьКонтейнеры(ЗаявкаПараметр);
	
	//БИТ Белинский Д.А. 10.04.2023 -начало
	УстановитьВидимостьПолейПоДирекцииКонтенерныхПеревозок();
	//БИТ Белинский Д.А. 10.04.2023 -конец
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьШапку(ЗаявкаПараметр)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Заявка.Ссылка КАК Заявка,
	|	Заявка.Контрагент КАК Контрагент,
	|	Заявка.Договор КАК Договор
	|ИЗ
	|	Документ.Заявка КАК Заявка
	|ГДЕ
	|	Заявка.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ЗаявкаПараметр);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Объект,ВыборкаДетальныеЗаписи);
	КонецЦикла;	   
	
	// ДИТ US 81881 ТА 81882 Сержантова А.С. Начало: 01.04.2024 
	Объект.ОриентировочнаяДатаЖДРейса = Дата("00010101");
	Объект.ОриентировочнаяДатаМорскогоРейса = Дата("00010101");
	ЖДРейсИзЗаявки = НайтиРейсЗаявки(ЗаявкаПараметр); 
	МорскойРейсИзЗаявки = НайтиРейсЗаявки(ЗаявкаПараметр, Истина); 
	Объект.ОриентировочнаяДатаЖДРейса = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЖДРейсИзЗаявки, "ДатаПрибытия"); 
	Объект.ОриентировочнаяДатаМорскогоРейса = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(МорскойРейсИзЗаявки, "ДатаПрибытия");
	// ДИТ US 81881 ТА 81882 Сержантова А.С. Конец: 01.04.2024
	
КонецПроцедуры	    

// ДИТ US 81881 ТА 81882 Сержантова А.С. 01.04.2024
&НаСервере
Функция НайтиРейсЗаявки(ЗаявкаПараметр, Морской = Ложь)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаявкаПереченьРейсов.Рейс КАК Рейс
		|ПОМЕСТИТЬ Вт_РейсыЗаявки
		|ИЗ
		|	Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
		|ГДЕ
		|	ЗаявкаПереченьРейсов.Ссылка = &Ссылка
		|	И ВЫБОР
		|			КОГДА &ВыбратьМорской = ИСТИНА
		|				ТОГДА ТИПЗНАЧЕНИЯ(ЗаявкаПереченьРейсов.Рейс) = ЗНАЧЕНИЕ(Справочник.РейсыМоре)
		|			ИНАЧЕ ТИПЗНАЧЕНИЯ(ЗаявкаПереченьРейсов.Рейс) = ЗНАЧЕНИЕ(Справочник.РейсыЖД)
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РейсыЖД.ДатаПрибытия КАК ДатаПрибытия,
		|	РейсыЖД.Ссылка КАК Рейс
		|ИЗ
		|	Вт_РейсыЗаявки КАК Вт_РейсыЗаявки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РейсыЖД КАК РейсыЖД
		|		ПО Вт_РейсыЗаявки.Рейс = РейсыЖД.Ссылка
		|ГДЕ
		|	НЕ РейсыЖД.РейсОтменен
		|	И НЕ РейсыЖД.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РейсыМоре.ДатаПрибытия,
		|	РейсыМоре.Ссылка
		|ИЗ
		|	Вт_РейсыЗаявки КАК Вт_РейсыЗаявки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РейсыМоре КАК РейсыМоре
		|		ПО Вт_РейсыЗаявки.Рейс = РейсыМоре.Ссылка
		|ГДЕ
		|	НЕ РейсыМоре.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаПрибытия";
	
	Запрос.УстановитьПараметр("ВыбратьМорской", Морской);
	Запрос.УстановитьПараметр("Ссылка", ЗаявкаПараметр);
	
	РезультатЗапроса = Запрос.Выполнить(); 
	Рейс = Справочники.РейсыЖД.ПустаяСсылка();
	Если не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Рейс = Выборка.Рейс;
	КонецЕсли; 
	
	Возврат Рейс;

КонецФункции 

&НаСервере
Процедура ЗаполнитьКонтейнеры(ЗаявкаПараметр)
	
	КоличествоНеДобавленных = 0;
	
	СтруктураОтвет       = ПолучитьТаблицуЗапросыНаКТК(ЗаявкаПараметр);	
	СтруктураОтветУслуги = ПолучитьТаблицуУслуг(ЗаявкаПараметр);
 
	ПараметрыФункции = Новый Структура("ТаблицаЗапросыНаКТК,ТаблицаУслуг,ТаблицаОбщееКоличествоКонтВРелизе"
									,СтруктураОтвет.ТаблицаЗапросыНаКТК
									,СтруктураОтветУслуги.ТаблицаУслуг
									,СтруктураОтвет.ТЗКоличествоКонтейнеровВРелизахСУчетомЗапросов);
	
	ИтоговаяТаблица      = ПолучитьИтоговуюТаблицу(ПараметрыФункции,КоличествоНеДобавленных);	
	
	ТаблицаРелизов = ИтоговаяТаблица.Скопировать(,"Релиз");
	ТаблицаРелизов.Колонки.Добавить("Ключ");
	ТаблицаРелизов.Колонки.Добавить("Обработан");
	ТаблицаКлючейПоЗапросамИзГуидов = ИтоговаяТаблица.Скопировать(,"ИдентификаторСтрокиЗапроса");
	ТаблицаКлючейПоЗапросамИзГуидов.Колонки.Добавить("Ключ");
	ТаблицаКлючейПоЗапросамИзГуидов.Колонки.Добавить("Обработан");
	
	ПолучитьКлючиПоРелизам(ТаблицаРелизов);
	ПолучитьКлючиПоСозданнымЗапросам(ТаблицаКлючейПоЗапросамИзГуидов);
	
	//БИТ Белинский Д.А. 14.04.2023 -начало
	КонтрагентДирекцияКонтейнерныхПеревозок = Ложь;
	Если ЭтоДирекцияКонтейнерныхПеревозок() Тогда 
		КонтрагентДирекцияКонтейнерныхПеревозок = Истина;
		ВыбранКонтрагентДирекцияКонтейнерныхПеревозок = Истина;
	КонецЕсли;
	//БИТ Белинский Д.А. 14.04.2023 -конец 
	
	//Евросиб Коханенко Н.А. 07.02.2024 (( #80805 
	УстановитьЗначенияТиповОперацийНаТерминалеПоУмолчанию();
	//Евросиб Коханенко Н.А. 07.02.2024 )) #80805 
	
	// ДИТ US 81881 ТА 81882 Сержантова А.С. Начало: 02.04.2024 - в ТЧ контейнеров заполняем Терминал выдачи и Дату и время подачи КТК из рейса 
	ЗаполнитьРеквизитыТЧКонтейнеровПоРейсу(ИтоговаяТаблица, ЗаявкаПараметр);
	// ДИТ US 81881 ТА 81882 Сержантова А.С. Конец: 02.04.2024
	
	Для Каждого СтрокаИтог Из ИтоговаяТаблица Цикл
		НовСтрока = Объект.Контейнеры.Добавить(); 
		ЗаполнитьЗначенияСвойств(НовСтрока,СтрокаИтог);
		
		//Евросиб Коханенко Н.А. 07.02.2024 (( #80805
		Если НЕ НовСтрока.НеТребуетсяТерминалВыдачи Тогда
			НовСтрока.ТипОперацииНаТерминалеВыдачи = ТипОперацииНаТерминалеВыдачиПоУмолчанию;
		КонецЕсли;
		Если НЕ НовСтрока.НеТребуетсяАдрес Тогда
			НовСтрока.ТипОперацииНаСкладеКлиента = ТипОперацииНаСкладеКлиентаПоУмолчанию;
		КонецЕсли;
		Если НЕ НовСтрока.НеТребуетсяТерминалСдачи Тогда
			НовСтрока.ТипОперацииНаТерминалеСдачи = ТипОперацииНаТерминалеСдачиПоУмолчанию;
		КонецЕсли;
		//Евросиб Коханенко Н.А. 07.02.2024 )) #80805 
		
		//БИТ Белинский Д.А. 14.04.2023 -начало
		Если КонтрагентДирекцияКонтейнерныхПеревозок Тогда
			НовСтрока.НеТребуетсяАдрес = Истина;
			НовСтрока.ТипОперацииНаТерминалеВыдачи = Перечисления.ТипОперацииНаТерминале.ПриемПорожнегоКТК;
			НовСтрока.ТипОперацииНаТерминалеСдачи = Перечисления.ТипОперацииНаТерминале.СдачаПорожнегоКТК;
		КонецЕсли;
		//БИТ Белинский Д.А. 14.04.2023 -конец 
		//ДИТ Шевченко А.В. US 62421 TA 65316 17.02.23
		Если НЕ ЗначениеЗаполнено(СтрокаИтог.КлючАналитикиПеревозки) И ЗначениеЗаполнено(СтрокаИтог.Релиз) Тогда
			СтруктураОтбора = Новый Структура("Обработан,Релиз",Ложь,СтрокаИтог.Релиз);
			СтрокиРелизыКлючи = ТаблицаРелизов.НайтиСтроки(СтруктураОтбора);
			Если СтрокиРелизыКлючи.Количество() > 0 Тогда
				НовСтрока.КлючАналитикиПеревозки = СтрокиРелизыКлючи[0].Ключ;  
				СтрокиРелизыКлючи[0].Обработан = Истина; 
			КонецЕсли;
		// ДИТ BUG 77633 Сержантова А.С. Начало: 23.11.2023
		ИначеЕсли ЗначениеЗаполнено(СтрокаИтог.КлючАналитикиПеревозки) И ЗначениеЗаполнено(СтрокаИтог.Релиз) Тогда 
			СтруктураОтбораСКлючом = Новый Структура("Обработан,Релиз,Ключ",Ложь,СтрокаИтог.Релиз, НовСтрока.КлючАналитикиПеревозки);
			СтрокиРелизовПоКлючу = ТаблицаРелизов.НайтиСтроки(СтруктураОтбораСКлючом); 
			Если СтрокиРелизовПоКлючу.Количество() Тогда
				СтрокиРелизовПоКлючу[0].Обработан = Истина; 		
			КонецЕсли;	
		// ДИТ BUG 77633 Сержантова А.С. Конец: 23.11.2023
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(СтрокаИтог.КлючАналитикиПеревозки) И НЕ ЗначениеЗаполнено(СтрокаИтог.Релиз) Тогда
			
			СтруктураОтбора = Новый Структура("Обработан,ИдентификаторСтрокиЗапроса",Ложь,СтрокаИтог.ИдентификаторСтрокиЗапроса);
			СтрокиЗапросыКлючи = ТаблицаКлючейПоЗапросамИзГуидов.НайтиСтроки(СтруктураОтбора);
			Если СтрокиЗапросыКлючи.Количество() > 0 Тогда
				НовСтрока.КлючАналитикиПеревозки = СтрокиЗапросыКлючи[0].Ключ;
				СтрокиЗапросыКлючи[0].Обработан = Истина;
			Иначе
				СтруктураКлюча  = Справочники.КлючиАналитикиПеревозки.СтруктураКлючаАналитикиПеревозки();
				СтруктураКлюча.Вставить("Заявка",Объект.Заявка);
				Ответ = Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлюча);
				НовСтрока.КлючАналитикиПеревозки = Ответ.КлючАналитикиПеревозки;
				НовСтрока.ВерсияКлюча = Ответ.ВерсияДанных;
			КонецЕсли;
		// ДИТ BUG 77633 Сержантова А.С. Начало: 23.11.2023
		ИначеЕсли ЗначениеЗаполнено(СтрокаИтог.КлючАналитикиПеревозки) И не ЗначениеЗаполнено(СтрокаИтог.Релиз) Тогда 
			СтруктураОтбораСКлючом = Новый Структура("Обработан,ИдентификаторСтрокиЗапроса,Ключ",
									Ложь,СтрокаИтог.ИдентификаторСтрокиЗапроса, НовСтрока.КлючАналитикиПеревозки);
			СтрокиРелизовПоКлючу = ТаблицаКлючейПоЗапросамИзГуидов.НайтиСтроки(СтруктураОтбораСКлючом); 
			Если СтрокиРелизовПоКлючу.Количество() Тогда
				СтрокиРелизовПоКлючу[0].Обработан = Истина; 		
			КонецЕсли;	
		// ДИТ BUG 77633 Сержантова А.С. Конец: 23.11.2023
		КонецЕсли;
		//ДИТ Шевченко А.В. US 62421 TA 65316 17.02.23
		НовСтрока.ИдентификаторСтрокиТЧ = Новый УникальныйИдентификатор();
		НовСтрока.ИдентификаторСтрокиТабличнойЧасти = НовСтрока.ПолучитьИдентификатор();
	КонецЦикла;	
	
	//ЗаполнитьДетализациюПоГрузу(ИтоговаяТаблица.ВыгрузитьКолонку("ИдентификаторСтрокиУслуги"),ЗаявкаПараметр);
	
	Для Каждого СтрокаСообщение Из СтруктураОтвет.ТЗКоличествоКонтейнеровВДругихРелизах Цикл     
		//Евросиб Коханенко Н.А. 14.06.2024 (( #83866
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("в заявке: %1 есть %2 КТК из текущего запроса на КТК",
														СтрокаСообщение.Заявка, 
														СтрокаСообщение.КоличествоКонтейнеров));
		//Евросиб Коханенко Н.А. 14.06.2024 )) #83866 
	КонецЦикла;	
	
	Если КоличествоНеДобавленных > 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("В запрос на автоперевозку добавлено максимально возможное количество строк из связанного с запросом на КТК релиза клиента");
	КонецЕсли;	
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 -начало
	ЗаполнитьТаблицуПоКлючамАналитики();
	//ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23 -конец
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЗаполнитьНомерДатуЗаказаНаТС();
	КонецЕсли;
КонецПроцедуры	

// ДИТ US 81881 ТА 81882 Сержантова А.С. 02.04.2024
&НаСервере
Процедура ЗаполнитьРеквизитыТЧКонтейнеровПоРейсу(ИтоговаяТаблица, ЗаявкаПараметр)
	
	Для каждого СтрокаИтога Из ИтоговаяТаблица Цикл      
		//оставляем заполненными только данные из релизов
		Если не ЗначениеЗаполнено(СтрокаИтога.ТерминалВыдачиКТКДоУслуги) Тогда
			СтрокаИтога.ТерминалВыдачи = Справочники.Локации.ПустаяСсылка();	
	    КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		// Евросиб(ДИТ) ТА 86904 Сержантова А.С. Начало: 17.06.2024
		// Было:
		//"ВЫБРАТЬ
		//|	ВЫРАЗИТЬ(Контейнеры.Контейнер КАК Справочник.ТЕ) КАК Контейнер
		//|ПОМЕСТИТЬ ВТ_Контейнеры
		//|ИЗ
		//|	&ИтоговаяТаблица КАК Контейнеры
		//|;
		//|
		//|////////////////////////////////////////////////////////////////////////////////  
		// Евросиб(ДИТ) ТА 86904 Сержантова А.С. Конец: 17.06.2024
		"ВЫБРАТЬ
		|	ЗаявкаПереченьРейсов.Рейс КАК Рейс
		|ПОМЕСТИТЬ Вт_РейсыЗаявки
		|ИЗ
		|	Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
		|ГДЕ
		|	ЗаявкаПереченьРейсов.Ссылка = &Заявка
		|	И ТИПЗНАЧЕНИЯ(ЗаявкаПереченьРейсов.Рейс) = ЗНАЧЕНИЕ(Справочник.РейсыМоре)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗаявкаПереченьРейсов.Рейс
		|ИЗ
		|	Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
