&НаСервере
Процедура ОпределитьИзменениеОтправленныхВТЛДанных(НужноУведомлениеПользователя = Ложь)
	
	НомераСтрокСИзмененнымКлючом = Новый Массив;
	
	СтруктураПоискаСтроки = Новый Структура("ИдентификаторСтрокиТЧ");  
	МассивКлючей = Объект.Контейнеры.Выгрузить(, "КлючАналитикиПеревозки").ВыгрузитьКолонку("КлючАналитикиПеревозки");
	ДанныеКлючейАналитики = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивКлючей,
							"Контейнер, Груз, ВесГруза, КоличествоМест, Мили, ИнструкцияПоСдаче");
	Для каждого СтрокаКонтейнеров Из Объект.Контейнеры Цикл     
		ЗаполнитьЗначенияСвойств(СтруктураПоискаСтроки, СтрокаКонтейнеров);
		СтрОтправленыВТЛ = ДанныеКлючейОтправленныхВТЛ.НайтиСтроки(СтруктураПоискаСтроки);
		Если СтрОтправленыВТЛ.Количество() > 0 Тогда   
			ДанныеПоКлючу = ДанныеКлючейАналитики.Получить(СтрокаКонтейнеров.КлючАналитикиПеревозки);
			ОтправленныеДанные = СтрОтправленыВТЛ[0];    
			ВыборкаМили = ДанныеПоКлючу.Мили.Выбрать();  
			ИзменилсяАдресКлиента = Ложь;
			Если ВыборкаМили.НайтиСледующий(Новый Структура("ЭтапПеревозки", Объект.ЭтапПеревозки)) Тогда
				Если ВыборкаМили.АдресКлиента <> ОтправленныеДанные.АдресКлиента Тогда
					ИзменилсяАдресКлиента = Истина;
				КонецЕсли;	
			КонецЕсли;
			Если ИзменилсяАдресКлиента или ОтправленныеДанные.Контейнер <> ДанныеПоКлючу.Контейнер
				или ОтправленныеДанные.Груз <> ДанныеПоКлючу.Груз 
				или ОтправленныеДанные.ВесГруза <> ДанныеПоКлючу.ВесГруза 
				или ОтправленныеДанные.КоличествоМест <> ДанныеПоКлючу.КоличествоМест 
				или ОтправленныеДанные.ГрузЕТСНГ <> ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеПоКлючу.Груз, "ЕТСНГ") 
				или ОтправленныеДанные.ИнструкцияПоСдаче <> ДанныеПоКлючу.ИнструкцияПоСдаче Тогда  
				СтрокаКонтейнеров.ОбновленыИсходныеДанные = Истина;
				НомераСтрокСИзмененнымКлючом.Добавить(СтрокаКонтейнеров.НомерСтроки);
			КонецЕсли;		
		КонецЕсли;
	КонецЦикла; 
	
	Если НужноУведомлениеПользователя и НомераСтрокСИзмененнымКлючом.Количество() > 0 Тогда
		ТекстСообщения = СтрШаблон("Произошли изменения по %1 %2, %3 необходимо отправить в ИС ""Транспортная логистика""", 
		?(НомераСтрокСИзмененнымКлючом.Количество() = 1, "строке", "строкам"),
		СтрСоединить(НомераСтрокСИзмененнымКлючом, ", "),
		?(НомераСтрокСИзмененнымКлючом.Количество() = 1, "ее", "их"));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;	

КонецПроцедуры

