	//Таблица.Свернуть(ВсеКолонки, "Знак, Счёт");
	//
	//Ответ = Таблица.Скопировать(Новый Структура("Счёт", 1), ВсеКолонки + ", Знак");
	//
	//Ответ.Свернуть("ГУИДСтроки");	

	//Для Каждого СтрокаОтвет Из Ответ Цикл
	//	СтруктураПоиска = Новый Структура;
	//	СтруктураПоиска.Вставить("ИдентификаторСтрокиТЧ",СтрокаОтвет.ГУИДСтроки);
	//	НайденнаяСтрока = Объект.Контейнеры.НайтиСтроки(СтруктураПоиска);
	//	Если НайденнаяСтрока.Количество() > 0 Тогда
	//		ОбновитьТаблицуОформления("Груз","ИдентификаторСтрокиТЧ",НайденнаяСтрока[0].ИдентификаторСтрокиТЧ,"Контейнеры");
	//	КонецЕсли;
	//КонецЦикла;	
	
	Если Объект.ДанныеДетализацииГрузаБылиИзменены Тогда
		Возврат;
	КонецЕсли;
	
	МассивКлючей = Новый Массив;
	Для Каждого СтрокаКонтейнер Из Объект.Контейнеры Цикл
		Если ЗначениеЗаполнено(СтрокаКонтейнер.КлючАналитикиПеревозки) Тогда
			МассивКлючей.Добавить(СтрокаКонтейнер.ИдентификаторСтрокиУслуги);
		КонецЕсли;	
	КонецЦикла;
	
	ДетализацияДоИзменения 		= ДетализацияПоГрузу.Выгрузить();
	ЗаполнитьДетализациюПоГрузу(МассивКлючей,Объект.Заявка);
	ДетализацияПослеИзменения 	= ДетализацияПоГрузу.Выгрузить();
	
	ВсеКолонки = "";
	Для Каждого Колонка Из ДетализацияДоИзменения.Колонки Цикл 
		ВсеКолонки = ВсеКолонки + ", " + Колонка.Имя
	КонецЦикла;
	ВсеКолонки = Сред(ВсеКолонки, 2);	
	Таблица = ДетализацияПослеИзменения.Скопировать();    	
	Таблица.Колонки.Добавить("Знак", Новый ОписаниеТипов("Число"));	
	Таблица.ЗаполнитьЗначения(1, "Знак");	
	Для Каждого Строка Из ДетализацияДоИзменения Цикл
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Строка) 
	КонецЦикла;
	
	Таблица.Колонки.Добавить("Счёт");
	Таблица.ЗаполнитьЗначения(1, "Счёт");
	
	Таблица.Свернуть(ВсеКолонки, "Знак, Счёт");
	
	Ответ = Таблица.Скопировать(Новый Структура("Счёт", 1), ВсеКолонки + ", Знак");
	
	Ответ.Свернуть("Ключ");	

	Для Каждого СтрокаОтвет Из Ответ Цикл
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("КлючАналитикиПеревозки",СтрокаОтвет.Ключ);
		НайденнаяСтрока = Объект.Контейнеры.НайтиСтроки(СтруктураПоиска);
		Если НайденнаяСтрока.Количество() > 0 Тогда
			ОбновитьТаблицуОформления("Груз","ИдентификаторСтрокиТЧ",НайденнаяСтрока[0].ИдентификаторСтрокиТЧ,"Контейнеры");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Процедура ОбновитьШапку()
	ПоляДоИзменения    = Новый Структура;
	ПоляПослеИзменения = Новый Структура;
	
	ПоляДоИзменения.Вставить("Контрагент",Неопределено);
	ПоляДоИзменения.Вставить("Договор",Неопределено);
	ПоляПослеИзменения.Вставить("Контрагент",Неопределено);
	ПоляПослеИзменения.Вставить("Договор",Неопределено); 
	//Евросиб Коханенко Н.А. 27.12.2024 (( #97950 
	ПоляДоИзменения.Вставить("ОриентировочнаяДатаМорскогоРейса",Неопределено);
	ПоляПослеИзменения.Вставить("ОриентировочнаяДатаМорскогоРейса",Неопределено);
	//Евросиб Коханенко Н.А. 27.12.2024 )) #97950 
	
	ЗаполнитьЗначенияСвойств(ПоляДоИзменения,Объект);
	ЗаполнитьШапку(Объект.Заявка);
	ЗаполнитьЗначенияСвойств(ПоляПослеИзменения,Объект);
	Для Каждого ПолеДоИзменения Из ПоляДоИзменения Цикл
		Если ПолеДоИзменения.Значение <> ПоляПослеИзменения[ПолеДоИзменения.Ключ] Тогда
			Если СписокРекОформленияШапки.НайтиПоЗначению(ПолеДоИзменения.Ключ) = Неопределено Тогда
				СписокРекОформленияШапки.Добавить(ПолеДоИзменения.Ключ);
			КонецЕсли;
			ЭтаФорма.Модифицированность = Истина;
		КонецЕсли;
	КонецЦикла;	
	
	УстановитьУсловноеОформлениеШапки(255,0,0);
	
КонецПроцедуры	

&НаСервере
Процедура ПроверитьИзменениеРеквизитаШапки(ИмяЭлемента,Значение)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗапросНаАвтоперевозку."+ИмяЭлемента+" КАК ОриентировочнаяДатаМорскогоРейса
		|ИЗ
		|	Документ.ЗапросНаАвтоперевозку КАК ЗапросНаАвтоперевозку
		|ГДЕ
		|	ЗапросНаАвтоперевозку.Ссылка = &Ссылка
		|	И ЗапросНаАвтоперевозку."+ИмяЭлемента+" = &Парам";
	
	Запрос.УстановитьПараметр("Парам", Значение);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Если СписокРекОформленияШапки.НайтиПоЗначению(ИмяЭлемента) = Неопределено Тогда
			СписокРекОформленияШапки.Добавить(ИмяЭлемента);
		КонецЕсли;
	КонецЕсли;	
	
	УстановитьУсловноеОформлениеШапки(255,0,0);
		
КонецПроцедуры

&НаСервере
Процедура ПометитьНаОтменуНеОбработанныеСтроки(ПромежуточнаяКонтейнеры)
	СтруктураПоиска = Новый Структура("Обработана",Ложь);	
	
	НайденныеСтроки = ПромежуточнаяКонтейнеры.НайтиСтроки(СтруктураПоиска);
	
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Если НайденнаяСтрока.СтатусЗапросаНаАвтоперевозку = Перечисления.СтатусЗапросаНаПеревозку.Отменен Тогда
			Продолжить;
		КонецЕсли;
		НайденнаяСтрока.СтатусЗапросаНаАвтоперевозку = Перечисления.СтатусЗапросаНаПеревозку.Отменен;
		НайденнаяСтрока.ОбновленыИсходныеДанные = Истина;
		ОбновитьТаблицуОформления("СтатусЗапросаНаАвтоперевозку","ИдентификаторСтрокиТЧ",НайденнаяСтрока.ИдентификаторСтрокиТЧ,"Контейнеры");
	КонецЦикла;	
	
КонецПроцедуры	

&НаСервере
Процедура ДобавитьСтрокуВПромежуточную(СтрокаСОбновлениями,ПромежуточнаяКонтейнеры)
	
	НовСтрока = ПромежуточнаяКонтейнеры.Добавить();
	ЗаполнитьЗначенияСвойств(НовСтрока,СтрокаСОбновлениями);	
	//НовСтрока.ИдентификаторСтрокиТЧ = Новый УникальныйИдентификатор();
	НовСтрока.СтатусЗапросаНаАвтоперевозку = Перечисления.СтатусЗапросаНаПеревозку.Черновик;	
	НовСтрока.Обработана = Истина;
	НовСтрока.ОбновленыИсходныеДанные = Истина;
	
КонецПроцедуры	

&НаСервере
Процедура НайтиСтрокиПоПолямИЗаполнить(СтруктураПоиска,СтрокаСОбновлениями,ПромежуточнаяКонтейнеры,КолНайденныхСтрок)
	
	КолНайденныхСтрок = 0;
	НайденныеСтроки = ПромежуточнаяКонтейнеры.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		
		Если НайденнаяСтрока.Обработана Тогда
			Продолжить;
		КонецЕсли;
		
		Если НайденнаяСтрока.СтатусЗапросаНаАвтоперевозку = Перечисления.СтатусЗапросаНаПеревозку.Отменен Тогда 
			// ДИТ US 79950 ТА 79951 Сержантова А.С. Начало: 27.02.2024
			НайденнаяСтрока.СтатусЗапросаНаАвтоперевозку = Перечисления.СтатусЗапросаНаПеревозку.Черновик;
			// ДИТ US 79950 ТА 79951 Сержантова А.С. Конец: 27.02.2024
			КолНайденныхСтрок = КолНайденныхСтрок + 1;
			НайденнаяСтрока.Обработана = Истина;
		КонецЕсли;
		
		ОбновитьСтроку(НайденнаяСтрока,СтрокаСОбновлениями);		
		Если НЕ ЗначениеЗаполнено(СтрокаСОбновлениями.ИдентификаторСтрокиУслуги) И ЗначениеЗаполнено(НайденнаяСтрока.ИдентификаторСтрокиУслуги) Тогда
			НайденнаяСтрока.Контейнер 		  = Справочники.ТЕ.ПустаяСсылка();
			НайденнаяСтрока.ИдентификаторСтрокиУслуги  = "";		
		КонецЕсли;		
		НайденнаяСтрока.Обработана = Истина;
		КолНайденныхСтрок = КолНайденныхСтрок + 1;
		
		Если ЗначениеЗаполнено(СтрокаСОбновлениями.ИдентификаторСтрокиУслуги) И ЗначениеЗаполнено(НайденнаяСтрока.ИдентификаторСтрокиУслуги) Тогда
			Продолжить;		
		КонецЕсли;
		
		Прервать;
	КонецЦикла;	
	
КонецПроцедуры	

&НаСервере
Процедура ОбновитьСтроку(НайденнаяСтрока,СтрокаСОбновлениями)

	ПоляДоИзменения    = Новый Структура;
	ПоляПослеИзменения = Новый Структура;
	
	МассивПерезаролняемыхПолей = Новый Массив;
	МассивПерезаролняемыхПолей.Добавить("Контейнер");
	МассивПерезаролняемыхПолей.Добавить("ТипКТК");
	МассивПерезаролняемыхПолей.Добавить("ТерминалВыдачи");
	МассивПерезаролняемыхПолей.Добавить("Груз");
	МассивПерезаролняемыхПолей.Добавить("ВесГрузаНетто");
	МассивПерезаролняемыхПолей.Добавить("КоличествоМест");
	МассивПерезаролняемыхПолей.Добавить("Релиз");
	МассивПерезаролняемыхПолей.Добавить("ТерминалСдачи"); //ДИТ Шевченко А.В. 60951 11.11.2022
	МассивПерезаролняемыхПолей.Добавить("ДатаВремяПодачиКТК"); // ДИТ US 81881 ТА 83581 Сержантова А.С. 09.04.2024
	МассивПерезаролняемыхПолей.Добавить("ИдентификаторСтрокиУслуги"); //Евросиб Коханенко Н.А. 16.12.2024 (( #97222 
	
	Для Каждого ТекКолонка Из МассивПерезаролняемыхПолей Цикл			
		ПоляДоИзменения.Вставить(ТекКолонка, Неопределено);
		ПоляПослеИзменения.Вставить(ТекКолонка, Неопределено)
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(ПоляДоИзменения,НайденнаяСтрока);
	ЗаполнитьЗначенияСвойств(ПоляПослеИзменения,СтрокаСОбновлениями);
	
	Если ЗначениеЗаполнено(НайденнаяСтрока.ИдентификаторСтрокиТЧ) Тогда
		СтруктураПоиска = Новый Структура("ИдентификаторСтрокиТЧ",НайденнаяСтрока.ИдентификаторСтрокиТЧ);
		НайденныеСтроки = ТаблицаОформленияКолонок.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() = 0 Тогда
			МассивПолейДляОформления = Новый Массив;	
		КонецЕсли;	
		Для Каждого СтрокаОформления Из НайденныеСтроки Цикл
			МассивПолейДляОформления = СтрРазделить(СтрокаОформления.ИменаКолонок,";");
		КонецЦикла;
	Иначе
		МассивПолейДляОформления = Новый Массив;
	КонецЕсли;	
	
	Для Каждого ПолеДоИзменения Из ПоляДоИзменения Цикл
		Если ПолеДоИзменения.Значение <> ПоляПослеИзменения[ПолеДоИзменения.Ключ] Тогда
			
			//Если Не ЗначениеЗаполнено(СтрокаСОбновлениями[ПолеДоИзменения.Ключ]) Тогда
			//		Продолжить;
			//КонецЕсли;
			Если ПолеДоИзменения.Ключ = "ИдентификаторСтрокиТЧ" Тогда	
				Продолжить;
			КонецЕсли;
			
			//ДИТ Шевченко А.В. 60951 11.11.2022 //Добавил ТерминалСдачи в условие  
			Если (ПолеДоИзменения.Ключ = "Груз" ИЛИ ПолеДоИзменения.Ключ = "ВесГрузаНетто" ИЛИ ПолеДоИзменения.Ключ = "КоличествоМест"  ИЛИ ПолеДоИзменения.Ключ = "ТерминалВыдачи" ИЛИ ПолеДоИзменения.Ключ = "ТерминалСдачи")
				И НЕ ЗначениеЗаполнено(СтрокаСОбновлениями[ПолеДоИзменения.Ключ]) Тогда
				Продолжить;
			КонецЕсли;  
			
			//// ДИТ US 81881 ТА 83581 Сержантова А.С. Начало: 15.04.2024
			Если Объект.ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПерваяМиля и ПолеДоИзменения.Ключ = "ДатаВремяПодачиКТК" 
				И не ЗначениеЗаполнено(СтрокаСОбновлениями[ПолеДоИзменения.Ключ]) и ЗначениеЗаполнено(ПолеДоИзменения.Значение) Тогда
				Продолжить;
			КонецЕсли;  
			//// ДИТ US 81881 ТА 83581 Сержантова А.С. Конец: 15.04.2024
			
			Если ПолеДоИзменения.Ключ = "ТерминалВыдачи" И НайденнаяСтрока.НеТребуетсяТерминалВыдачи Тогда
				Продолжить;
			КонецЕсли;	
			
			//ДИТ Шевченко А.В. 60951 11.11.2022 -начало
			Если ПолеДоИзменения.Ключ = "ТерминалСдачи" И НайденнаяСтрока.НеТребуетсяТерминалСдачи Тогда
				Продолжить;
			КонецЕсли;
			//ДИТ Шевченко А.В. 60951 11.11.2022 -конец
			
			НайденнаяСтрока[ПолеДоИзменения.Ключ] = СтрокаСОбновлениями[ПолеДоИзменения.Ключ];
			Если НайденнаяСтрока.СтатусЗаказаНаТС = Перечисления.СтатусЗаказаНаТс.ВыданВРейс ИЛИ НайденнаяСтрока.СтатусЗаказаНаТС = Перечисления.СтатусЗаказаНаТс.Закрыт Тогда
				НайденнаяСтрока.СтатусЗаказаНаТСЗапрет = Истина;
			КонецЕсли;
			Если НайденнаяСтрока.СтатусЗапросаНаАвтоперевозку = Перечисления.СтатусЗапросаНаПеревозку.Отменен Тогда
				НайденнаяСтрока.СтатусЗаказаОтменен = Истина;
			КонецЕсли;	
			Если МассивПолейДляОформления.Найти(ПолеДоИзменения.Ключ) = Неопределено Тогда
				МассивПолейДляОформления.Добавить(ПолеДоИзменения.Ключ);                       
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
	НайденнаяСтрока.СписокПолейКОформлению = СтрСоединить(МассивПолейДляОформления,";");
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицуОформления(ПолеОформления,ПолеУсловия,ЗначениеСравнения,ИмяТабличнойЧасти = "")
	
	ОбработкаОб = РеквизитФормыВЗначение("Объект");
	ОбработкаОб.ОбновитьТаблицуОформленияДокумента(ТаблицаОформленияКолонок,ПолеОформления,ЗначениеСравнения);	
	
	УстановитьЦветИзменения(ПолеОформления,ПолеУсловия,ЗначениеСравнения,ИмяТабличнойЧасти,Новый Цвет(250, 0, 0));
	
КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокуИзТаблицыОформления(ПолеОформления,ПолеУсловия,ЗначениеСравнения,ИмяТабличнойЧасти = "")
	СтруктураПоиска = Новый Структура("ИдентификаторСтрокиТЧ",ЗначениеСравнения);
	НайденныеСтроки = ТаблицаОформленияКолонок.НайтиСтроки(СтруктураПоиска);
	Для Каждого СтрокаОформления Из НайденныеСтроки Цикл
		МассивПолейТаблицы = СтрРазделить(СтрокаОформления.ИменаКолонок,";");
		ПолеНайдено = МассивПолейТаблицы.Найти(ПолеОформления);
		Если ПолеНайдено <> Неопределено Тогда
			МассивПолейТаблицы.Удалить(ПолеНайдено);
		КонецЕсли;	
		СтрокаОформления.ИменаКолонок = СтрСоединить(МассивПолейТаблицы,";");
	КонецЦикла;
	
	Если СтрокаОформления.ИменаКолонок = "" Тогда
		ТаблицаОформленияКолонок.Удалить(СтрокаОформления);
	КонецЕсли;	
	
	УстановитьЦветИзменения(ПолеОформления,ПолеУсловия,ЗначениеСравнения,ИмяТабличнойЧасти,Новый Цвет(0, 0, 0))
	
КонецПроцедуры	

&НаСервере
Процедура УстановитьУсловноеОформлениеТЧ()
	
	УсловноеОформление.Элементы.Очистить();	
	
	Для Каждого СтрокаОформления Из ТаблицаОформленияКолонок Цикл
		МассивПолей = СтрРазделить(СтрокаОформления.ИменаКолонок,";");
		Для Каждого МассивЗнч Из МассивПолей Цикл
