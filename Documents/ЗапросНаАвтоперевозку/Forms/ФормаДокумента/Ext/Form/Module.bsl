	СтруктураПоиска = Новый Структура("СтатусЗаказаНаТСЗапрет,СтатусЗаказаНаТС",Истина,Перечисления.СтатусЗаказаНаТс.Закрыт);
	НайденныеСтроки = ПромежуточнаяКонтейнеры.НайтиСтроки(СтруктураПоиска);
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		МассивНомеровСтрокЗакрыт.Добавить(НайденнаяСтрока.НомерСтроки);
	КонецЦикла;
	
	Ответ.МассивНомеровСтрокВыданВРейс = МассивНомеровСтрокВыданВРейс;
	Ответ.МассивНомеровСтрокЗакрыт 	   = МассивНомеровСтрокЗакрыт;
	
	//ДИТ Шевченко А.В. US 62487 ТА 68012 04.05.2023 -Начало
	Для Каждого СтрокаП Из ПромежуточнаяКонтейнеры Цикл
		Если Объект.ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПерваяМиля И ЗначениеЗаполнено(СтрокаП.Релиз) Тогда
			Документы.ЗапросНаАвтоперевозку.ЗаполнитьСтатусОтправкиЗапросаНаТерминалВыдачиПоРелизу(СтрокаП,СтрокаП.Релиз);
		КонецЕсли;
	КонецЦикла;
	//ДИТ Шевченко А.В. US 62487 ТА 68012 04.05.2023 -Конец  
	
	Если МассивНомеровСтрокВыданВРейс.Количество() = 0 И МассивНомеровСтрокЗакрыт.Количество() = 0 Тогда
		ОбновитьСтрокиИзПромежуточнойТаблицы(ПромежуточнаяКонтейнеры,КоличествоНеДобавленных);	
		Возврат Ответ;
	Иначе
		АдресХранилища = ПоместитьВоВременноеХранилище(ПромежуточнаяКонтейнеры,ЭтаФорма.УникальныйИдентификатор);
		Ответ.АдресХранилища = АдресХранилища;
		Возврат Ответ;
	КонецЕсли;	
	
КонецФункции

&НаСервере
Процедура ПолучитьПромежуточнуюИзХранилищаИОбновить(АдресХранилища,КоличествоНеДобавленных)
	
	ПромежуточнаяКонтейнеры = ПолучитьИзВременногоХранилища(АдресХранилища);
	ОбновитьСтрокиИзПромежуточнойТаблицы(ПромежуточнаяКонтейнеры,КоличествоНеДобавленных)
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтрокиИзПромежуточнойТаблицы(ПромежуточнаяКонтейнеры,КоличествоНеДобавленных)
	ПометитьНаОтменуНеОбработанныеСтроки(ПромежуточнаяКонтейнеры);	
	// ДИТ US 78243 ТА 79842 Сержантова А.С. Начало: 31.01.2024 - удалим из КоличествоНеДобавленных не обработанные строки - они добавлены, изменится статус на отменено
	КоличествоНеобработанных = ПромежуточнаяКонтейнеры.НайтиСтроки(Новый Структура("Обработана", Ложь)); 
	КоличествоНеДобавленных = КоличествоНеДобавленных - КоличествоНеобработанных.Количество();
	// ДИТ US 78243 ТА 79842 Сержантова А.С. Конец: 31.01.2024
	МассивОбработанныхГуидов = Новый Массив;
	//ДИТ Шевченко А.В. US 62421 TA 65316 17.02.23
	ТаблицаРелизов = ПромежуточнаяКонтейнеры.Скопировать(,"Релиз");
	ТаблицаРелизов.Колонки.Добавить("Ключ");
	ТаблицаРелизов.Колонки.Добавить("Обработан");	
	ПолучитьКлючиПоРелизам(ТаблицаРелизов);
	
	ТаблицаКлючейПоЗапросамИзГуидов = ПромежуточнаяКонтейнеры.Скопировать(,"ИдентификаторСтрокиЗапроса");
	ТаблицаКлючейПоЗапросамИзГуидов.Колонки.Добавить("Ключ");
	ТаблицаКлючейПоЗапросамИзГуидов.Колонки.Добавить("Обработан");
	
	ПолучитьКлючиПоСозданнымЗапросам(ТаблицаКлючейПоЗапросамИзГуидов);
	
	Для Каждого СтрокаРелизыКлючи Из ТаблицаРелизов Цикл
		СтруктураПоиска = Новый Структура("КлючАналитикиПеревозки",СтрокаРелизыКлючи.Ключ);
		МассивСтрок = ПромежуточнаяКонтейнеры.НайтиСтроки(СтруктураПоиска);
		СтрокаРелизыКлючи.Обработан = МассивСтрок.Количество() > 0;	
	КонецЦикла;
	Для Каждого СтрокаЗапросКлючи Из ТаблицаКлючейПоЗапросамИзГуидов Цикл
		СтруктураПоиска = Новый Структура("КлючАналитикиПеревозки",СтрокаЗапросКлючи.Ключ);
		МассивСтрок = ПромежуточнаяКонтейнеры.НайтиСтроки(СтруктураПоиска);
		СтрокаЗапросКлючи.Обработан = МассивСтрок.Количество() > 0;	
	КонецЦикла;
	
	//ДИТ Шевченко А.В. US 62421 TA 65316 17.02.23
	Для Каждого ПромежуточнаяСтрока Из ПромежуточнаяКонтейнеры Цикл
		
		//Евросиб Коханенко Н.А. 17.12.2024 (( #97222 
		//Если ЗначениеЗаполнено(ПромежуточнаяСтрока.ИдентификаторСтрокиУслуги) И ЗначениеЗаполнено(ПромежуточнаяСтрока.ИдентификаторСтрокиЗапроса) Тогда
		Если ЗначениеЗаполнено(ПромежуточнаяСтрока.КлючАналитикиПеревозки) Тогда
			СтруктураПоиска = Новый Структура("КлючАналитикиПеревозки",
			ПромежуточнаяСтрока.КлючАналитикиПеревозки);
		ИначеЕсли ЗначениеЗаполнено(ПромежуточнаяСтрока.ИдентификаторСтрокиУслуги) И ЗначениеЗаполнено(ПромежуточнаяСтрока.ИдентификаторСтрокиЗапроса) Тогда	
		//Евросиб Коханенко Н.А. 17.12.2024 )) #97222 
			СтруктураПоиска = Новый Структура("ИдентификаторСтрокиЗапроса,ИдентификаторСтрокиУслуги",
			ПромежуточнаяСтрока.ИдентификаторСтрокиЗапроса,
			ПромежуточнаяСтрока.ИдентификаторСтрокиУслуги);
		ИначеЕсли ЗначениеЗаполнено(ПромежуточнаяСтрока.ИдентификаторСтрокиЗапроса) И НЕ ЗначениеЗаполнено(ПромежуточнаяСтрока.ИдентификаторСтрокиУслуги) Тогда
			СтруктураПоиска = Новый Структура("ИдентификаторСтрокиЗапроса",
			ПромежуточнаяСтрока.ИдентификаторСтрокиЗапроса);
		ИначеЕсли НЕ ЗначениеЗаполнено(ПромежуточнаяСтрока.ИдентификаторСтрокиЗапроса) И ЗначениеЗаполнено(ПромежуточнаяСтрока.ИдентификаторСтрокиУслуги) Тогда
			СтруктураПоиска = Новый Структура("ИдентификаторСтрокиУслуги",
			ПромежуточнаяСтрока.ИдентификаторСтрокиУслуги);
		КонецЕсли;
		
		НайденныеСтроки = Объект.Контейнеры.НайтиСтроки(СтруктураПоиска);          
		ПромежуточнаяОбновлена = Ложь;
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			Если МассивОбработанныхГуидов.Найти(НайденнаяСтрока.ИдентификаторСтрокиТЧ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;	
			
			ПромежуточнаяОбновлена = Истина;
			Если НЕ ЗначениеЗаполнено(НайденнаяСтрока.ИдентификаторСтрокиТЧ) Тогда 
				НайденнаяСтрока.ИдентификаторСтрокиТЧ = Новый УникальныйИдентификатор();
				НайденнаяСтрока.ИдентификаторСтрокиТабличнойЧасти = НайденнаяСтрока.ПолучитьИдентификатор();
			КонецЕсли;
			МассивОбработанныхГуидов.Добавить(НайденнаяСтрока.ИдентификаторСтрокиТЧ);
			Если ПромежуточнаяСтрока.СтатусЗаказаНаТСЗапрет Тогда
				Прервать;
			КонецЕсли;
			
			Если ПромежуточнаяСтрока.СтатусЗаказаОтменен Тогда 
				Прервать;
			КонецЕсли;
			
			//Евросиб Коханенко Н.А. 05.07.2024 (( #83866
			//ЗаполнитьЗначенияСвойств(НайденнаяСтрока,ПромежуточнаяСтрока);
			//нельзя отменять строки, по которым уже начато движение
			Если НЕ ЗначениеЗаполнено(НайденнаяСтрока.ДатаИВремяВывоза) 
				И НЕ ЗначениеЗаполнено(НайденнаяСтрока.ДатаЗавершенияОперацииНаСкладеКлиента) Тогда
				ЗаполнитьЗначенияСвойств(НайденнаяСтрока,ПромежуточнаяСтрока);
			КонецЕсли;
			//Евросиб Коханенко Н.А. 05.07.2024 )) #83866 
			
			
			МассивПолейДляОфрмления = СтрРазделить(ПромежуточнаяСтрока.СписокПолейКОформлению,";");
			
			Для Каждого ЗнчМассива Из МассивПолейДляОфрмления Цикл
				Если НЕ ЗнчМассива = "" Тогда
					ОбновитьТаблицуОформления(ЗнчМассива,"ИдентификаторСтрокиТЧ",НайденнаяСтрока.ИдентификаторСтрокиТЧ,"Контейнеры");
					НайденнаяСтрока.ОбновленыИсходныеДанные = Истина;
					ЭтаФорма.Модифицированность = Истина;
				КонецЕсли;
			КонецЦикла;
			Прервать;
		КонецЦикла;
		Если НЕ ПромежуточнаяОбновлена Тогда
			НовСтрока = Объект.Контейнеры.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока,ПромежуточнаяСтрока);
			//ДИТ Шевченко А.В. US 62421 TA 65316 17.02.23	
			Если НЕ ЗначениеЗаполнено(ПромежуточнаяСтрока.КлючАналитикиПеревозки) И ЗначениеЗаполнено(ПромежуточнаяСтрока.Релиз) Тогда
				СтруктураОтбора = Новый Структура("Обработан,Релиз",Ложь,ПромежуточнаяСтрока.Релиз);
				СтрокиРелизыКлючи = ТаблицаРелизов.НайтиСтроки(СтруктураОтбора);
				Если СтрокиРелизыКлючи.Количество() > 0 Тогда
					НовСтрока.КлючАналитикиПеревозки = СтрокиРелизыКлючи[0].Ключ;
					СтрокиРелизыКлючи[0].Обработан = Истина;
				КонецЕсли;	
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ПромежуточнаяСтрока.КлючАналитикиПеревозки) И НЕ ЗначениеЗаполнено(ПромежуточнаяСтрока.Релиз) Тогда
				
				СтруктураОтбора = Новый Структура("Обработан,ИдентификаторСтрокиЗапроса",Ложь,ПромежуточнаяСтрока.ИдентификаторСтрокиЗапроса);
				СтрокиЗапросыКлючи = ТаблицаКлючейПоЗапросамИзГуидов.НайтиСтроки(СтруктураОтбора);
				Если СтрокиЗапросыКлючи.Количество() > 0 Тогда
					НовСтрока.КлючАналитикиПеревозки = СтрокиЗапросыКлючи[0].Ключ;
					СтрокиЗапросыКлючи[0].Обработан = Истина;
				Иначе		
					СтруктураКлюча  = Справочники.КлючиАналитикиПеревозки.СтруктураКлючаАналитикиПеревозки();
					СтруктураКлюча.Вставить("Заявка",Объект.Заявка);
					Если Объект.ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПерваяМиля Тогда
						Ответ = Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлюча);
						НовСтрока.КлючАналитикиПеревозки = Ответ.КлючАналитикиПеревозки;
						НовСтрока.ВерсияКлюча = Ответ.ВерсияДанных;
					Иначе
						Ответ = Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлюча);
						НовСтрока.КлючАналитикиПеревозки = Ответ.КлючАналитикиПеревозки;
						НовСтрока.ВерсияКлюча = Ответ.ВерсияДанных;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			//ДИТ Шевченко А.В. US 62421 TA 65316 17.02.23
			НовСтрока.ИдентификаторСтрокиТЧ = Новый УникальныйИдентификатор();
			НовСтрока.ИдентификаторСтрокиТабличнойЧасти = НовСтрока.ПолучитьИдентификатор();
			МассивОбработанныхГуидов.Добавить(НовСтрока.ИдентификаторСтрокиТЧ);
			ЭтаФорма.Модифицированность = Истина;
			ОбновитьТаблицуОформления("","ИдентификаторСтрокиТЧ",НовСтрока.ИдентификаторСтрокиТЧ,"Контейнеры");
		КонецЕсли;	
	КонецЦикла;
	
	//Евросиб Коханенко Н.А. 23.08.2024 (( #89393 
	//Если КоличествоНеДобавленных > 0 Тогда
	//	ОбщегоНазначения.СообщитьПользователю(СтрШаблон("В запрос на автоперевозку не добавлено строк: %1 по причине их нахождения в других запросах на автоперевозку",КоличествоНеДобавленных));
	//КонецЕсли;
	//Евросиб Коханенко Н.А. 23.08.2024 )) #89393 
	
	ОбновитьДетализациюПоГрузу();	
КонецПроцедуры	

&НаСервере
Процедура ПривязатьУслугуКСвободнойСтроке(СтруктураПоиска,СтрокаСОбновлениями,ПромежуточнаяКонтейнеры,НайденныйРелиз,КолНайденныхСтрок)
	
	КолНайденныхСтрок = 0;
	НайденныеСтроки = ПромежуточнаяКонтейнеры.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьОбновлениеСтроки = Ложь;
	
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		
		Если НайденнаяСтрока.Обработана Тогда
			Продолжить;
		КонецЕсли;	
		
		Если НайденнаяСтрока.СтатусЗапросаНаАвтоперевозку = Перечисления.СтатусЗапросаНаПеревозку.Отменен Тогда
			КолНайденныхСтрок = КолНайденныхСтрок + 1;
			Продолжить;
		КонецЕсли;
		
		ВыполнитьОбновлениеСтроки = Ложь;
		
		Если НайденнаяСтрока.Контейнер = НайденныйРелиз.Контейнер 
			И НайденнаяСтрока.ДатаИВремяВывоза = НайденныйРелиз.ДатаВывоза 
			И НайденнаяСтрока.НомерАвто = НайденныйРелиз.РегНомерТС Тогда
			ВыполнитьОбновлениеСтроки = Истина;	
		КонецЕсли;
		
		Если НайденнаяСтрока.Контейнер = НайденныйРелиз.Контейнер 
			И НайденнаяСтрока.ДатаИВремяВывоза = НайденныйРелиз.ДатаВывоза 
			И НайденнаяСтрока.ФИОВодителя = НайденныйРелиз.ФИОВодителя Тогда
			ВыполнитьОбновлениеСтроки = Истина;	
		КонецЕсли;
		
		Если НайденнаяСтрока.Контейнер = НайденныйРелиз.Контейнер 
			И НайденнаяСтрока.ДатаИВремяВывоза = НайденныйРелиз.ДатаВывоза 
			И НайденнаяСтрока.Перевозчик = НайденныйРелиз.Перевозчик Тогда
			ВыполнитьОбновлениеСтроки = Истина;	
		КонецЕсли;
		
			
		Если ВыполнитьОбновлениеСтроки Тогда
			ОбновитьСтроку(НайденнаяСтрока,СтрокаСОбновлениями);
			НайденнаяСтрока.Обработана = Истина;
			КолНайденныхСтрок = КолНайденныхСтрок + 1; 
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ВыполнитьОбновлениеСтроки Тогда
		ОбщегоНазначения.СообщитьПользователю("Не одна строка запроса на автоперевозку не была сопоставлена с новой строкой услуги.");
	КонецЕсли;
	
	
	
КонецПроцедуры

