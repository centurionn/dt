	Возврат МассивПроверкиКолонокТС;
	
КонецФункции	

&НаКлиенте
Процедура ПослеЗакрытияВопросаСнятииОформленияКолонокТС(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет или Результат = КодВозвратаДиалога.Таймаут Тогда
		Параметры.ПараметрыЗаписи.Вставить("ПропуститьВопросПоОформлению",Истина);
		Записать(Параметры.ПараметрыЗаписи);
	Иначе
		
		МассивПроверкиКолонокТС = ПолучитьМассивПроверкиКолонокТС();
		МассивУдлСтрокОформлени = Новый Массив;	
		Для Каждого СтрокаОф Из ТаблицаОформленияКолонок Цикл
			МассивОформленныхКолонок = СтрРазделить(СтрокаОф.ИменаКолонок,";");
			НовыйМассивОформленныхКолонок = Новый Массив;
			Для Каждого ЭлМассива Из МассивОформленныхКолонок Цикл	
				Если МассивПроверкиКолонокТС.Найти(ЭлМассива) = Неопределено Тогда
					НовыйМассивОформленныхКолонок.Добавить(ЭлМассива);	
				КонецЕсли;
			КонецЦикла;
			Если НовыйМассивОформленныхКолонок.Количество() = 0 Тогда
				МассивУдлСтрокОформлени.Добавить(СтрокаОф);
			КонецЕсли;	
			СтрокаОф.ИменаКолонок = СтрСоединить(НовыйМассивОформленныхКолонок,";");
		КонецЦикла;
		
		Для Каждого СтрУд Из МассивУдлСтрокОформлени Цикл
			ТаблицаОформленияКолонок.Удалить(СтрУд);
		КонецЦикла;	
		
		Параметры.ПараметрыЗаписи.Вставить("ПропуститьВопросПоОформлению",Истина);
		Записать(Параметры.ПараметрыЗаписи);
		УстановитьУсловноеОформлениеТЧ();
	КонецЕсли;
КонецПроцедуры	

