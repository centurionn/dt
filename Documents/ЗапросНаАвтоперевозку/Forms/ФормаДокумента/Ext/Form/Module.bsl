&НаКлиенте
Процедура ОтправитьЗапросВИСТранспортнаяЛогистика(Команда)
	
	Если НЕ ОтправкаВозможна() Тогда
		Возврат;
	КонецЕсли;		
	НеЗаписан = ЭтаФорма.Модифицированность или Не Объект.Проведен;
	ОповещениеОтветаВопроса = Новый ОписаниеОповещения("ОбработкаВопросаЗапрос", ЭтаФорма, НеЗаписан);
	Если НеЗаписан Тогда
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить(КодВозвратаДиалога.Да,"Да");
		СписокКнопок.Добавить(КодВозвратаДиалога.Нет,"Нет");
		ПоказатьВопрос(ОповещениеОтветаВопроса, "Перед выгрузкой заказ необходимо провести. Продолжить?", СписокКнопок, 60, КодВозвратаДиалога.Нет,,КодВозвратаДиалога.Нет);
	Иначе
		ОбработкаВопросаЗапрос(КодВозвратаДиалога.Да, НеЗаписан);
	КонецЕсли; 

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаЗапрос(Ответ = неопределено, НеЗаписан = Неопределено) Экспорт
	
	Если Не Ответ = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ЗаписатьИВыгрузитьЗаказНаАвто(НеЗаписан); 
	
	// ДИТ US 78233 TA 79764 Сержантова А.С. Начало: 23.01.2024
	ОповеститьОбИзменении(Тип("СправочникСсылка.КлючиАналитикиПеревозки"));   
	Оповестить("НеобходимоОбновитьДанныеКлючейАналитикиПеревозки", , ЭтаФорма);
	// ДИТ US 78233 TA 79764 Сержантова А.С. Конец: 23.01.2024
	
КонецПроцедуры
&НаСервере
Процедура ЗаписатьИВыгрузитьЗаказНаАвто(НеЗаписан)

	СтрокиКВыгрузке = НайтиСтрокиСОтметкой();
	//ДИТ Шевченко А.В. Ticket#0307346 14.04.2023 -Начало
	Рез = Истина;
	Если НеЗаписан Тогда
		СтруктураЗаписи = Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение);
		Рез = ЭтотОбъект.Записать(СтруктураЗаписи);	
	КонецЕсли;
	Если Рез Тогда
		ДатаОтправкиЗапроса = ТекущаяДата();
		ПараметрыВыгрузки = Новый Структура("СсылкаЗапросНаАвтоперевозку, СтрокиКВыгрузке", Объект.Ссылка, СтрокиКВыгрузке);
		ЕСОбменСервер.ПередатьЗапросыНаАвтоВТЛ(ПараметрыВыгрузки);	
		ОбновитьОформлениеПослеЗапроса(ДатаОтправкиЗапроса);  
	КонецЕсли;
	//ДИТ Шевченко А.В. Ticket#0307346 14.04.2023 -Конец
КонецПроцедуры

&НаСервере
Процедура ВыгрузитьЗаказНаАвтоПоИзменениямПланФактКТК(МассивГуиды)
	
	СтрокиКВыгрузке = ПолучитьСтрокиКВыгрузкеПоГУИД(МассивГуиды);
	
	ДатаОтправкиЗапроса = ТекущаяДата();
	ПараметрыВыгрузки = Новый Структура("СсылкаЗапросНаАвтоперевозку, СтрокиКВыгрузке", Объект.Ссылка, СтрокиКВыгрузке);
	ЕСОбменСервер.ПередатьЗапросыНаАвтоВТЛ(ПараметрыВыгрузки);	
   	ОбновитьОформлениеПослеЗапроса(ДатаОтправкиЗапроса);	
КонецПроцедуры	

&НаСервере
Функция НайтиСтрокиСОтметкой()
	
	СтрокиКвыгрузке = Новый ТаблицаЗначений;
	СтрокиКвыгрузке.Колонки.Добавить("ИдентификаторСтрокиТабличнойЧасти");
	СтрокиКвыгрузке.Колонки.Добавить("ИдентификаторСтрокиТЧ");
	
	СтруктураПоиска = Новый Структура("Отметка", Истина);
	НайденныеСтроки = Объект.Контейнеры.НайтиСтроки(СтруктураПоиска);
	Для каждого Строка Из НайденныеСтроки Цикл
		Стр = СтрокиКВыгрузке.Добавить();
		ЗаполнитьЗначенияСвойств(Стр, Строка);
	КонецЦикла;
  	Возврат СтрокиКВыгрузке;
	
КонецФункции // НайтиСтрокиСОтметкой()

&НаСервере
Функция ПолучитьСтрокиКВыгрузкеПоГУИД(МассивГуиды)
	
	СтрокиКвыгрузке = Новый ТаблицаЗначений;
	СтрокиКвыгрузке.Колонки.Добавить("ИдентификаторСтрокиТабличнойЧасти");
	СтрокиКвыгрузке.Колонки.Добавить("ИдентификаторСтрокиТЧ");
	
	Для Каждого ЗнчМ Из МассивГуиды Цикл
		СтруктураПоиска = Новый Структура("ИдентификаторСтрокиТЧ", ЗнчМ);
		НайденныеСтроки = Объект.Контейнеры.НайтиСтроки(СтруктураПоиска);
		Для каждого Строка Из НайденныеСтроки Цикл
			Стр = СтрокиКВыгрузке.Добавить();
			ЗаполнитьЗначенияСвойств(Стр, Строка);
		КонецЦикла;
	КонецЦикла;
  	Возврат СтрокиКВыгрузке;
	
