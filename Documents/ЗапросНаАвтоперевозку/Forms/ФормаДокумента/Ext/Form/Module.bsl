		//ДИТ Шевченко А.В. US 62421 TA 64345 20.01.23 -начало
		КонтейнерП = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(СтрокаТЧ.КлючАналитикиПеревозки,"Контейнер");
		
		Если ЗначениеЗаполнено(КонтейнерП) И ЗначениеЗаполнено(СтрокаТч.КонтейнерФакт) Тогда
			Если Строка(КонтейнерП) <> СтрокаТч.КонтейнерФакт Тогда
				МассивНомераРазныйПланФактКТК.Добавить(СтрокаТч.НомерСтроки);
				СтрокаТч.Отметка = Ложь;
			КонецЕсли;
		КонецЕсли;
		//ДИТ Шевченко А.В. US 62421 TA 64345 20.01.23 -конец
		
		//Евросиб Коханенко Н.А. 29.11.2023 (( US 75549 TA 75773 
		//Евросиб Коханенко Н.А. 12.03.2024 (( #82185 
		//Если Не ЗначениеЗаполнено(СтрокаТч.АдресКлиента) И Не СтрокаТч.НеТребуетсяАдрес Тогда
		Если НЕ ЗначениеЗаполнено(СтрокаТч.АдресКлиента) 
			И НЕ СтрокаТч.НеТребуетсяАдрес 
			И НЕ ЭтоИмпортМоре Тогда
		//Евросиб Коханенко Н.А. 12.03.2024 )) #82185 
			МассивНомераНеЗаполненАдресКлиентаИлиНеТребуется.Добавить(СтрокаТч.НомерСтроки);
			СтрокаТч.Отметка = Ложь;
		КонецЕсли;
		//Евросиб Коханенко Н.А. 29.11.2023 )) US 75549 TA 75773 
	КонецЦикла;	
	
	//Евросиб Коханенко Н.А. 29.11.2023 (( US 75549 TA 75773 
 	Если МассивНомераНеЗаполненАдресКлиентаИлиНеТребуется.Количество() > 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Отправка запроса на автоперевозку невозможна, так как в запросе по строке %1 необходимо заполнить ""Адрес склада клиента"" или выбрать ""Не требуется""",СтрСоединить(МассивНомераНеЗаполненАдресКлиентаИлиНеТребуется,",")));
		Ответ = Ложь;
		ВыводитОбщееСообщение = Истина;
	КонецЕсли;
   //Евросиб Коханенко Н.А. 29.11.2023 )) US 75549 TA 75773 
    		
	Если МассивНомераСтрокСтатусЗаказаНаТСВыданВРейс.Количество() > 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Отправка запроса на автоперевозку невозможна, так как запрос в строке %1 уже ""Выдан в рейс""",СтрСоединить(МассивНомераСтрокСтатусЗаказаНаТСВыданВРейс,",")));
		Ответ = Ложь;
		ВыводитОбщееСообщение = Истина;
	КонецЕсли;
	Если МассивНомераСтрокСтатусЗаказаНаТСЗакрыт.Количество() > 0 Тогда
