Функция ОбновитьЗапросПоСреднейМилеИзЗаявкиНаСервере()
	
	ОбновитьШапку(); //Договор, Контрагент из Заявки 
	
	МорскойРейсИзЗаявки = НайтиРейсЗаявки(Объект.Заявка, Истина); 
	Если ЗначениеЗаполнено(МорскойРейсИзЗаявки) Тогда
		ДанныеМорскогоРейсаИзЗаявки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(МорскойРейсИзЗаявки, "МестоРазгрузки, ДатаПрибытия");
	Иначе     
		ДанныеМорскогоРейсаИзЗаявки = Новый Структура("МестоРазгрузки, ДатаПрибытия", Справочники.РейсыМоре.ПустаяСсылка(), Дата(1,1,1));	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаявкаСоставУслуги.ДатаГотовностиКТККВывозуИзПорта КАК ДатаГотовностиКТККВывозуИзПорта,
		|	ЗаявкаСоставУслуги.РелизТерминалаPODДействуетДо КАК РелизТерминалаPODДействуетДо,
		|	ЗаявкаСоставУслуги.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	ЗаявкаСоставУслуги.СухойТерминалОтправления КАК ТерминалСдачи,
		|	ЗаявкаСоставУслуги.УчетноеНаправление КАК УчетноеНаправление,
		|	ЗаявкаСоставУслуги.ГУИДСтроки КАК ИдентификаторСтрокиУслуги,
		|	ЗаявкаСоставУслуги.НомерКТК КАК Контейнер,
		|	ЗаявкаСоставУслуги.ТипКТК КАК ТипКТК
		|ИЗ
		|	Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
		|ГДЕ
		|	ЗаявкаСоставУслуги.Ссылка = &Ссылка
		|	И ЗаявкаСоставУслуги.ДатаГотовностиКТККВывозуИзПорта <> ДАТАВРЕМЯ(1, 1, 1)
		|	И ЗаявкаСоставУслуги.РелизТерминалаPODДействуетДо <> ДАТАВРЕМЯ(1, 1, 1)
		|";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.Заявка);
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	ТЧКонтейнеры = Объект.Контейнеры;
	
	Пока Выборка.Следующий() Цикл 
		ЭтоНоваяСтрока = Ложь;
		ПараметрыОтбора = Новый Структура("КлючАналитикиПеревозки", Выборка.КлючАналитикиПеревозки); 
		НайденныеСтроки = ТЧКонтейнеры.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество() > 0 Тогда
			СтрокаТЧ = НайденныеСтроки[0];
		Иначе
			ЭтоНоваяСтрока = Истина;
			СтрокаТЧ = ТЧКонтейнеры.Добавить();
			СтрокаТЧ.ИдентификаторСтрокиТЧ = Новый УникальныйИдентификатор;
			СтрокаТЧ.ИдентификаторСтрокиТабличнойЧасти = ТЧКонтейнеры.Количество() - 1;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, Выборка); 
		
		Если ЭтоНоваяСтрока Тогда
			ДанныеИзКлючаАналитики = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТЧ.КлючАналитикиПеревозки, "КоличествоМест, ВесГруза, ИнструкцияПоСдаче, РелизКлиента");
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, ДанныеИзКлючаАналитики); 
			СтрокаТЧ.Релиз = ДанныеИзКлючаАналитики.РелизКлиента;
			СтрокаТЧ.ТипОперацииНаТерминалеВыдачи = Перечисления.ТипОперацииНаТерминале.ПриемГруженогоКТК;
			СтрокаТЧ.СтатусОтправкиЗапросаНаТерминалВыдачи = Перечисления.СтатусОтправкиЗапросаНаТерминалВыдачи.НеОтправлен;
			СтрокаТЧ.ТипОперацииНаТерминалеСдачи = Перечисления.ТипОперацииНаТерминале.СдачаГруженогоКТК;
			СтрокаТЧ.НеТребуетсяАдрес = Истина;
		КонецЕсли;
		
		//Евросиб Коханенко Н.А. 19.02.2025 (( #102955 
		//СтрокаТЧ.ТерминалВыдачи = ДанныеМорскогоРейсаИзЗаявки.МестоРазгрузки;
		//получаем ТерминалВыдачи и ВесГрузаНетто из Коносамента
		ДанныеИзКоносамента = ОбменДаннымиСредняяМиляСервер.ПолучитьДанныеИзКоносамента(Объект.Заявка, СтрокаТЧ.КлючАналитикиПеревозки);
		СтрокаТЧ.ТерминалВыдачи = ДанныеИзКоносамента.ТерминалВыдачи;
		//Евросиб Коханенко Н.А. 19.02.2025 )) #102955 

		СтрокаТЧ.ДатаВремяПодачиКТК = ДанныеМорскогоРейсаИзЗаявки.ДатаПрибытия;
		СтрокаТЧ.СтатусЗапросаНаАвтоперевозку = Перечисления.СтатусЗапросаНаПеревозку.ГотовКОтправке;
		СтрокаТЧ.ОбновленыИсходныеДанные = Истина;
		
	КонецЦикла;
	
	//выставим статус "Отменен" строкам, которых нет в заявке или у которых в заявке не заполнены две даты для средней мили
	МассивКлючейАналитикиИзЗаявки = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("КлючАналитикиПеревозки");
	Для Каждого СтрокаТЧ Из ТЧКонтейнеры Цикл
		Если МассивКлючейАналитикиИзЗаявки.Найти(СтрокаТЧ.КлючАналитикиПеревозки) = Неопределено Тогда
			СтрокаТЧ.СтатусЗапросаНаАвтоперевозку = Перечисления.СтатусЗапросаНаПеревозку.Отменен;
			СтрокаТЧ.ОбновленыИсходныеДанные = Истина;	
		КонецЕсли;
	КонецЦикла;
	
	ОбщегоНазначения.СообщитьПользователю("Данные в запросе на автоперевозку обновлены, необходимо отправить информацию об изменениях в ИС «Транспортная логистика».");	

КонецФункции //Евросиб Коханенко Н.А. 25.12.2024 )) #97950 

