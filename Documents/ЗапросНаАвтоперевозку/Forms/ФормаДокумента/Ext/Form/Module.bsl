		// ДИТ US 79379 Сержантова А.С. Конец: 18.03.2024
		
		СтруктураПоиска = Новый Структура("ОбновленыИсходныеДанные",Истина);
		НайденныеСтроки = Объект.Контейнеры.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() > 0 Тогда
			ВыводитьСообщение = Истина;
		КонецЕсли;
		Если СписокРекОформленияШапки.Количество() > 0 Тогда	
			ВыводитьСообщение = Истина;
		КонецЕсли;
		МассивГуидовТЧ = новый Массив;
		МассивНомеровСтрок = Новый Массив;
		Для Каждого СтрокаТЧ Из НайденныеСтроки Цикл
			//ДИТ Шевченко А.В. US 62421 TA 64345 20.01.23 -начало
			КонтейнерП = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(СтрокаТЧ.КлючАналитикиПеревозки,"Контейнер");
			
			Если НЕ ЗначениеЗаполнено(КонтейнерП) ИЛИ НЕ ЗначениеЗаполнено(СтрокаТЧ.КонтейнерФакт) Тогда
				Продолжить;
			КонецЕсли;
			Если Строка(КонтейнерП) <> СтрокаТЧ.КонтейнерФакт Тогда
				Продолжить;
			КонецЕсли;
			//ДИТ Шевченко А.В. US 62421 TA 64345 20.01.23 -конец
			СтруктураПоиска = Новый Структура("ИдентификаторСтрокиТЧ",СтрокаТч.ИдентификаторСтрокиТЧ);
			НайденныеСтрокиОфор = ТаблицаОформленияКолонок.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтрокиОфор.Количество() > 0 Тогда
				МассивКолонок = СтрРазделить(НайденныеСтрокиОфор[0].ИменаКолонок,";");
				Если МассивКолонок.Найти("КонтейнерФакт") <> Неопределено Тогда
					МассивГуидовТЧ.Добавить(СтрокаТч.ИдентификаторСтрокиТЧ); 
					МассивНомеровСтрок.Добавить(СтрокаТч.НомерСтроки);	
				КонецЕсли;	
			КонецЕсли;		
		КонецЦикла;
		
		Если ЗначениеЗаполнено(МассивГуидовТЧ) Тогда
			СписокКнопок = Новый СписокЗначений;
			СписокКнопок.Добавить(КодВозвратаДиалога.Да,"Да");
			СписокКнопок.Добавить(КодВозвратаДиалога.Нет,"Нет");	
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаПланФактКТК", ЭтотОбъект, Новый Структура("МассивГуидовТЧ",МассивГуидовТЧ));
			ПоказатьВопрос(Оповещение, СтрШаблон("Необходимо отправить обновленные данные по строке %1 в ИС Транспортная логистика. Отправить данные?",СтрСоединить(МассивНомеровСтрок,",")), СписокКнопок, 60,КодВозвратаДиалога.Нет,,КодВозвратаДиалога.Нет);
			ВыводитьСообщение = Ложь;
		КонецЕсли;
		
	КонецЕсли;   
	
	// ДИТ US 76935 ТА 78648 Сержантова А.С. Начало: 21.12.2023
	// Было:
	//Если ВыводитьСообщение Тогда 
	//Стало:
	Если ВыводитьСообщение и не Отказ Тогда
	// ДИТ US 76935 ТА 78648 Сержантова А.С. Конец: 21.12.2023
		ПоказатьПредупреждение(,"Данные в запросе на автоперевозку обновлены, необходимо отправить информацию об изменениях в ИС «Транспортная логистика».");
	КонецЕсли;	
	
	Если НЕ Отказ Тогда
		МассивГуидовОтметки = Новый Массив;
		СтруктураПоиска = Новый Структура("Отметка",Истина);
		НайденныеСтроки = Объект.Контейнеры.НайтиСтроки(СтруктураПоиска);
		Для Каждого СтрокаС Из НайденныеСтроки Цикл
			МассивГуидовОтметки.Добавить(СтрокаС.ИдентификаторСтрокиТЧ);
		КонецЦикла;	
		АдресХранильщаОтметки = ПоместитьВоВременноеХранилище(МассивГуидовОтметки,ЭтаФОрма.УникальныйИдентификатор);  
	КонецЕсли;	
	
КонецПроцедуры

