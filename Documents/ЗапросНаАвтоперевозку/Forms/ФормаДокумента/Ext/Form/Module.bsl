		//		ДополнительныеПараметры.Вставить("ПараметрыЗаписи", ПараметрыЗаписи);
		//		
		//		СписокКнопок = Новый СписокЗначений;
		//		СписокКнопок.Добавить(КодВозвратаДиалога.Да,"Да");
		//		СписокКнопок.Добавить(КодВозвратаДиалога.Нет,"Нет");	
		//		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаСнятииОформленияКолонокТС", ЭтотОбъект,ДополнительныеПараметры); 
		//		// "... красным цветом таких полей?" - изменен текст вопроса Сержантова А.С. 10.01.2023 US 78233 TA 78240
		//		ПоказатьВопрос(Оповещение,"Документ содержит обновленные данные из ИС «Транспортная логистика». Снять подсвечивание таких строк?", СписокКнопок, 60,КодВозвратаДиалога.Нет,,КодВозвратаДиалога.Нет); 	
		//		Отказ = Истина;
		//		Возврат;
