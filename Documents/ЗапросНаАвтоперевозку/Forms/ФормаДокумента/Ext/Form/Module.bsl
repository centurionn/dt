	РезультатXML=ОбщегоНазначения.ЗначениеВСтрокуXML(ОбщегоНазначения.ТаблицаЗначенийВМассив(ТЗ_XML));
	ЗаписьXML.ЗаписатьТекст(РезультатXML);
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.Закрыть();
	
	Файл = Новый Файл(ИмяВременногоФайла);	
