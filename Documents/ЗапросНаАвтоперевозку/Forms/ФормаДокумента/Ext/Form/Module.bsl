&НаСервере
Процедура ЗаполнитьТаблицуПоКлючамАналитики(Ключ = Неопределено, ИзменениеКлючаПоСобытию = Ложь) 
	
	ДетализацияПоГрузу.Очистить();    
	// ДИТ US 78233 TA 78240 Сержантова А.С. Начало: 26.01.2024
	НужнаПроверкаИзмененийВОтправленныхДанных = Ложь;
	// ДИТ US 78233 TA 78240 Сержантова А.С. Конец: 26.01.2024
	
	Если ЗначениеЗаполнено(Ключ) Тогда
		СтруктураПоиска = Новый Структура("КлючАналитикиПеревозки",Ключ);
		МассивСтрок = Объект.Контейнеры.НайтиСтроки(СтруктураПоиска);
		Если МассивСтрок.Количество() > 0 Тогда
			ВыполнитьЗаполнениеСтроки(МассивСтрок[0]);
			// ДИТ US 78233 TA 78240 Сержантова А.С. Начало: 28.12.2023
			Если ИзменениеКлючаПоСобытию и ЗначениеЗаполнено(МассивСтрок[0].ВерсияКлючаАналитикиОтправленоВТЛ) Тогда
			    НужнаПроверкаИзмененийВОтправленныхДанных = Истина;
			КонецЕсли;
			// ДИТ US 78233 TA 78240 Сержантова А.С. Конец: 28.12.2023
		КонецЕсли;	
	Иначе	 
		Для Каждого СтрокаТЧ Из Объект.Контейнеры Цикл
			ВыполнитьЗаполнениеСтроки(СтрокаТЧ);
			// ДИТ US 78233 TA 78240 Сержантова А.С. Начало: 28.12.2023
			Если ИзменениеКлючаПоСобытию и ЗначениеЗаполнено(СтрокаТЧ.ВерсияКлючаАналитикиОтправленоВТЛ) Тогда
            	НужнаПроверкаИзмененийВОтправленныхДанных = Истина;
			КонецЕсли;    
			// ДИТ US 78233 TA 78240 Сержантова А.С. Конец: 28.12.2023
		КонецЦикла; 
	КонецЕсли;
	
	// ДИТ US 78233 TA 78240 Сержантова А.С. Начало: 26.01.2024
	Если НужнаПроверкаИзмененийВОтправленныхДанных Тогда
		ОпределитьИзменениеОтправленныхВТЛДанных(Истина);	
	КонецЕсли;
	// ДИТ US 78233 TA 78240 Сержантова А.С. Конец: 26.01.2024
КонецПроцедуры

Процедура ВыполнитьЗаполнениеСтроки(СтрокаТЧ)
	 
	// ДИТ US 78239 Сержантова А.С. Начало: 05.12.2023 
	// Было:
	//СтрокаТЧ.Контейнер   = СтрокаТЧ.КлючАналитикиПеревозки.Контейнер;
	//СтрокаТЧ.Груз 		 = СтрокаТЧ.КлючАналитикиПеревозки.Груз;
	//СтрокаТЧ.ВерсияКлюча = СтрокаТЧ.КлючАналитикиПеревозки.ВерсияДанных;
	// Стало: 
	РеквизитыКлюча = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТЧ.КлючАналитикиПеревозки, "Контейнер, Груз, ВерсияДанных, ИнструкцияПоСдаче, КоличествоМест, ВесГруза");
	СтрокаТЧ.Контейнер   = РеквизитыКлюча.Контейнер; 
	// ДИТ BUG 81219 ТА 81220 Сержантова А.С. Начало: 16.02.2024
	Если ЗначениеЗаполнено(СтрокаТЧ.Контейнер) Тогда
		СтрокаТЧ.ТипКТК = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.Контейнер, "ТипТЕ");	
	КонецЕсли;
	// ДИТ BUG 81219 ТА 81220 Сержантова А.С. Конец: 16.02.2024
	СтрокаТЧ.Груз 		 = РеквизитыКлюча.Груз;
	СтрокаТЧ.ВерсияКлюча = РеквизитыКлюча.ВерсияДанных;
	СтрокаТЧ.ИнструкцияПоСдаче = РеквизитыКлюча.ИнструкцияПоСдаче;
	// ДИТ US 78239 Сержантова А.С. Конец: 05.12.2023   
	// ДИТ US 78234 ТА 78241 Сержантова А.С. Начало: 12.12.2023,
	//Если (ЗначениеЗаполнено(СтрокаТЧ.ВесГрузаНетто) и не ЗначениеЗаполнено(РеквизитыКлюча.ВесГруза)) 
	//	или (ЗначениеЗаполнено(СтрокаТЧ.КоличествоМест) и не ЗначениеЗаполнено(РеквизитыКлюча.КоличествоМест)) Тогда       
	//	ЭтаФорма.Модифицированность = Истина;
	//	ДобавитьЗначениеРеквизитаВКлюч(СтрокаТЧ.КлючАналитикиПеревозки,СтрокаТЧ.ВесГрузаНетто,"ВесГруза",,,СтрокаТЧ.ВерсияКлюча);   
	//	ДобавитьЗначениеРеквизитаВКлюч(СтрокаТЧ.КлючАналитикиПеревозки,СтрокаТЧ.КоличествоМест,"КоличествоМест",,,СтрокаТЧ.ВерсияКлюча);
	//Иначе	
		СтрокаТЧ.ВесГрузаНетто = РеквизитыКлюча.ВесГруза;
		СтрокаТЧ.КоличествоМест = РеквизитыКлюча.КоличествоМест;
	//КонецЕсли;
	// ДИТ US 78234 ТА 78241 Сержантова А.С. Конец: 12.12.2023
	ТЧ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.КлючАналитикиПеревозки,"Мили");
	ДетализацияПоГрузуТЧ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.КлючАналитикиПеревозки,"ДетализацияПоГрузу");
	Если ТЧ <> Неопределено Тогда
		Выборка = ТЧ.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.ЭтапПеревозки = Объект.ЭтапПеревозки Тогда
				СтрокаТЧ.ФИОВодителя = Выборка.ФИОВодителя;
				СтрокаТЧ.ПаспортныеДанные = Выборка.ПаспортныеДанные;
				СтрокаТЧ.Перевозчик = Выборка.Автоперевозчик;
				СтрокаТЧ.ДатаИВремяВывоза = Выборка.ДатаВыдачиКТКСТерминала;
				СтрокаТЧ.ДатаИВремяСдачи = Выборка.ДатаСдачиКТКНаТерминал;
				СтрокаТЧ.ДатаЗавершенияОперацииНаСкладеКлиента = Выборка.ДатаВыездаКТКСоСклада;
				СтрокаТЧ.АдресКлиента = Выборка.АдресКлиента; //ДИТ Шевченко А.В. US 62421 ТА 67386 18.05.2023
				СтрокаТЧ.НомерАвто    = Выборка.РегНомерТС;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ДетализацияПоГрузуТЧ <> Неопределено Тогда
		Выборка = ДетализацияПоГрузуТЧ.Выбрать();
		НомерСтрокиПоГуидам = 0;
		Пока Выборка.Следующий() Цикл
			НовДет = ДетализацияПоГрузу.Добавить();
			ЗаполнитьЗначенияСвойств(НовДет,Выборка);
			НовДет.Ключ = СтрокаТЧ.КлючАналитикиПеревозки; 
			НовДет.НомерСтрокиПоГуидам = НомерСтрокиПоГуидам + 1;
			НомерСтрокиПоГуидам = НомерСтрокиПоГуидам + 1;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры	

