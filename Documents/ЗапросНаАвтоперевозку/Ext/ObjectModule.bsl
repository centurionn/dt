Функция ПолучитьПринадлежностьТЕКТКПоЗаявке(Заявка,КТК,ИдентификаторСтрокиУслуги) Экспорт //ДИТ Шевченко А.В. 59965 25.11.2022
	Если НЕ ЗначениеЗаполнено(ИдентификаторСтрокиУслуги) Тогда
		Возврат Перечисления.ПринадлежностьТЕ.КТЕвросиба
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(КТК) И ЗначениеЗаполнено(ИдентификаторСтрокиУслуги) Тогда	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаявкаСоставУслуги.ПринадлежностьТЕ КАК ПринадлежностьТЕ
		|ИЗ
		|	Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
		|ГДЕ
		|	ЗаявкаСоставУслуги.Ссылка = &Ссылка
		|	И ЗаявкаСоставУслуги.ГУИДСтроки = &ГУИДСтроки
		|	И ЗаявкаСоставУслуги.НомерКТК = &НомерКТК";
		
		Запрос.УстановитьПараметр("ГУИДСтроки", ИдентификаторСтрокиУслуги);
		Запрос.УстановитьПараметр("Ссылка", Заявка);
		Запрос.УстановитьПараметр("НомерКТК", КТК);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Возврат ВыборкаДетальныеЗаписи.ПринадлежностьТЕ;
		КонецЦикла;
	КонецЕсли;	

	Возврат Неопределено;
	
КонецФункции	

Процедура ОбновитьТаблицуОформленияДокумента(ТаблицаОформленияКолонок,ПолеОформления,ЗначениеСравнения) Экспорт
	СтруктураПоиска = Новый Структура("ИдентификаторСтрокиТЧ",ЗначениеСравнения);
	НайденныеСтроки = ТаблицаОформленияКолонок.НайтиСтроки(СтруктураПоиска);
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		НовСтрока = ТаблицаОформленияКолонок.Добавить();
		НовСтрока.ИдентификаторСтрокиТЧ = ЗначениеСравнения;		
		НовСтрока.ИменаКолонок = ПолеОформления;		
	КонецЕсли;
	
	Для Каждого СтрокаОформления Из НайденныеСтроки Цикл
		МассивПолейТаблицы = СтрРазделить(СтрокаОформления.ИменаКолонок,";");
		ПолеНайдено = МассивПолейТаблицы.Найти(ПолеОформления);
		Если ПолеНайдено = Неопределено Тогда
			МассивПолейТаблицы.Добавить(ПолеОформления);
		КонецЕсли;	
		СтрокаОформления.ИменаКолонок = СтрСоединить(МассивПолейТаблицы,";");
	КонецЦикла;
КонецПроцедуры	

