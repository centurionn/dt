Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	//ДИТ Шевченко А.В. US 69272 ТА 69274 04.05.2023 -Начало
	ТзМилиПоКлючамСИзмДатыВывоза = Справочники.КлючиАналитикиПеревозки.КлючиАналитикиЗначенияПолейПоЭтапуПеревозки(МассивКлючейСИзменениемДатаИВремаВывоза,ЭтапПеревозки);
	ТзМилиПоКлючамСИзмДатыСдачи = Справочники.КлючиАналитикиПеревозки.КлючиАналитикиЗначенияПолейПоЭтапуПеревозки(МассивКлючейСИзменениемДатаИВремаСдачи,ЭтапПеревозки);
	ТзМилиПоКлючамСИзмДатыЗавНаСкладе = Справочники.КлючиАналитикиПеревозки.КлючиАналитикиЗначенияПолейПоЭтапуПеревозки(МассивКлючейСИзменениемДатаЗавершенияОперацииНСкладеКлиента,ЭтапПеревозки);
	//СлужебнаяТаблицаКлючейДат = Новый ТаблицаЗначений;
	//СлужебнаяТаблицаКлючейДат.Колонки.Добавить("КлючАналитикиПеревозки");
	//СлужебнаяТаблицаКлючейДат.Колонки.Добавить("ДатаВыдачиКТКСТерминала");
	//СлужебнаяТаблицаКлючейДат.Колонки.Добавить("ДатаСдачиКТКНаТерминал");
	//СлужебнаяТаблицаКлючейДат.Колонки.Добавить("ДатаВыездаКТКСоСклада");
	
	Для Каждого ЗнчМассива Из МассивКлючейСИзменениемДатаИВремаВывоза Цикл	
		СтруктураПоискаСтроки = Новый Структура("КлючАналитикиПеревозки",ЗнчМассива);
		НайденнаяСтрока = Контейнеры.НайтиСтроки(СтруктураПоискаСтроки);
		СтрокаМили      = ТзМилиПоКлючамСИзмДатыВывоза.НайтиСтроки(СтруктураПоискаСтроки);
		
		НаборЗаписей = РегистрыСведений.ИнформацияОтАвтоподрядчиков.СоздатьНаборЗаписей();
		
		НаборЗаписей.Отбор.Период.Установить(СтрокаМили[0].ДатаВыдачиКТКСТерминала);
		НаборЗаписей.Отбор.КлючАналитикиПеревозки.Установить(ЗнчМассива);
		НаборЗаписей.Отбор.Статус.Установить(Справочники.ОперацииСВагонами.ВывозКонтейнераСКонтПункта);
		
		Движение = НаборЗаписей.Добавить();
		Движение.КлючАналитикиПеревозки = ЗнчМассива;
		Движение.Период 				= СтрокаМили[0].ДатаВыдачиКТКСТерминала;
		Движение.ДатаВнесенияДанных 	= ТекущаяДата();
		Движение.Статус 				= Справочники.ОперацииСВагонами.ВывозКонтейнераСКонтПункта;  
		// ДИТ US 78243 ТА 84426 Сержантова А.С. Начало: 22.04.2024
		// Было:      
		//Движение.АдресМестаОперацииСКТК = НайденнаяСтрока[0].ТерминалВыдачи.Адрес;
		//Движение.Терминал 				= НайденнаяСтрока[0].ТерминалВыдачи; 
		//Стало:   
		Движение.АдресМестаОперацииСКТК = НайденнаяСтрока[0].ТерминалВыдачиФакт.Адрес;
		Движение.Терминал 				= НайденнаяСтрока[0].ТерминалВыдачиФакт; 
		// ДИТ US 78243 ТА 84426 Сержантова А.С. Конец: 22.04.2024
		Движение.Состояние 				= НайденнаяСтрока[0].ТипОперацииНаТерминалеВыдачи = Перечисления.ТипОперацииНаТерминале.ПриемГруженогоКТК;
		Движение.Нетто 					= НайденнаяСтрока[0].ВесГрузаНетто;
		Движение.НомерРелиза 			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НайденнаяСтрока[0].Релиз,"НомерРелиза");
		// ДИТ US 79379 ТА 80813 Сержантова А.С. Начало: 29.02.2024
		Движение.ФИОВодителя			= СтрокаМили[0].ФИОВодителя;
		Движение.НомерТранспорта		= СтрокаМили[0].РегНомерТС;
		// ДИТ US 79379 ТА 80813 Сержантова А.С. Конец: 29.02.2024
		НаборЗаписей.Записать(Истина);
		//НовСтрока = СлужебнаяТаблицаКлючейДат.Добавить();
		//НовСтрока.КлючАналитикиПеревозки = ЗнчМассива;
		//НовСтрока.ДатаВыдачиКТКСТерминала = СтрокаМили[0].ДатаВыдачиКТКСТерминала;
	КонецЦикла;
	Для Каждого ЗнчМассива Из МассивКлючейСИзменениемДатаИВремаСдачи Цикл
		СтруктураПоискаСтроки = Новый Структура("КлючАналитикиПеревозки",ЗнчМассива);
		НайденнаяСтрока = Контейнеры.НайтиСтроки(СтруктураПоискаСтроки);
		СтрокаМили      = ТзМилиПоКлючамСИзмДатыСдачи.НайтиСтроки(СтруктураПоискаСтроки);
		
		НаборЗаписей = РегистрыСведений.ИнформацияОтАвтоподрядчиков.СоздатьНаборЗаписей();
		
		НаборЗаписей.Отбор.Период.Установить(СтрокаМили[0].ДатаСдачиКТКНаТерминал);
