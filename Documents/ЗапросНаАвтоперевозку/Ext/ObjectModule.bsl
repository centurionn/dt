Процедура ПроверитьВозможностьОтменыДокумента(Отказ)
	
	МассивОтбор = Новый Массив;
	МассивОтбор.Добавить(Перечисления.СтатусЗаказаНаТс.ВыданВРейс);
	МассивОтбор.Добавить(Перечисления.СтатусЗаказаНаТс.Закрыт);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗапросНаАвтоперевозкуКонтейнеры.НомерСтроки КАК НомерСтроки,
		|	ЗапросНаАвтоперевозкуКонтейнеры.СтатусЗаказаНаТС КАК СтатусЗаказаНаТС
		|ИЗ
		|	Документ.ЗапросНаАвтоперевозку.Контейнеры КАК ЗапросНаАвтоперевозкуКонтейнеры
		|ГДЕ
		|	ЗапросНаАвтоперевозкуКонтейнеры.Ссылка = &Ссылка
		|	И ЗапросНаАвтоперевозкуКонтейнеры.СтатусЗаказаНаТС В(&СтатусЗаказаНаТС)
		|ИТОГИ ПО
		|	СтатусЗаказаНаТС";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("СтатусЗаказаНаТС", МассивОтбор);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаСтатусЗаказаНаТС = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСтатусЗаказаНаТС.Следующий() Цикл
	
		ВыборкаДетальныеЗаписи = ВыборкаСтатусЗаказаНаТС.Выбрать();
		
		МассивНомеровСтрок = Новый Массив;
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			МассивНомеровСтрок.Добавить(ВыборкаДетальныеЗаписи.НомерСтроки);
		КонецЦикла;
		
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Документ нельзя отменить! Строки %1 находятся в статусе: %2",СтрСоединить(МассивНомеровСтрок,","),ВыборкаСтатусЗаказаНаТС.СтатусЗаказаНаТС),,,,Отказ);
		
	КонецЦикла;
	
КонецПроцедуры	

