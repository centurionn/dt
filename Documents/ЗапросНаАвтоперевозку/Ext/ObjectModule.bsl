	Для Каждого СтрокаТЧ Из Контейнеры Цикл
		//ДИТ Шевченко А.В. 60147 03.11.22 -Начало
		Если СтатусыНепроверяемыхСтрок.Найти(СтрокаТЧ.СтатусЗапросаНаАвтоперевозку) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
			//Евросиб Коханенко Н.А. 12.03.2024 (( #82185 
			//ТаблицаОшибок = ПолучитьТаблицуОшибокПоСтроке(СтрокаТЧ);
			ТаблицаОшибок = ПолучитьТаблицуОшибокПоСтроке(СтрокаТЧ,, ЭтоИмпортМоре);
		    //Евросиб Коханенко Н.А. 12.03.2024 )) #82185 

		Для Каждого СтрокаОшибки Из ТаблицаОшибок Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ТекстОшибки,СтрокаОшибки.ИмяКолонки,СтрокаТЧ.НомерСтроки),ЭтотОбъект,"Контейнеры["+ Контейнеры.Индекс(СтрокаТЧ) +"]."+СтрокаОшибки.ИмяКолонкиМетаданных+"",,Отказ);
		КонецЦикла;
		//ДИТ Шевченко А.В. 60147 03.11.22 -Конец
	КонецЦикла;	
  ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
