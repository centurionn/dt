	
#Область ОписаниеПеременных

Перем МассивКлючейСИзменениемДатаИВремаВывоза;
Перем МассивКлючейСИзменениемДатаИВремаСдачи;
Перем МассивКлючейСИзменениемДатаЗавершенияОперацииНСкладеКлиента;

#КонецОбласти

#Область ПрограммныйИнтерфейс
// Код процедур и функций
#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если ЭтоНовый() Тогда
		Автор  = Пользователи.ТекущийПользователь();
		Создано = ТекущаяДата();
		ЦФО = Автор.ЦФО;
		Организация = Константы.ОсновнаяОрганизация.Получить();
		Подразделение = Автор.Подразделение;
	КонецЕсли;
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Автор = Пользователи.ТекущийПользователь();
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	МассивКлючейСИзменениемДатаИВремаВывоза = Новый Массив;
	МассивКлючейСИзменениемДатаИВремаСдачи = Новый Массив;
	МассивКлючейСИзменениемДатаЗавершенияОперацииНСкладеКлиента = Новый Массив;
	
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения ИЛИ ПометкаУдаления Тогда
		ПроверитьВозможностьОтменыДокумента(Отказ);
	КонецЕсли;   
	
	// ДИТ BUG 76919 ТА 77021 Сержантова А.С. Начало: 07.11.2023  
	// При пометке на удаление запроса на автоперевозку все связанные в ТЛ заказы на ТС  должны принимать статус "отменено"
	Если ПометкаУдаления и не Отказ Тогда  
		Для каждого СтрКонтейнера Из Контейнеры Цикл
			СтрКонтейнера.СтатусЗапросаНаАвтоперевозку = Перечисления.СтатусЗапросаНаПеревозку.Отменен;
		КонецЦикла; 
	КонецЕсли;       
	// ДИТ BUG 76919 ТА 77021 Сержантова А.С. Конец: 07.11.2023 
	
	Редактор = Пользователи.ТекущийПользователь();
	Изменено = ТекущаяДата();
	
	Для Каждого СтрокаТЧ Из Контейнеры Цикл
		Если СтрокаТЧ.НеТребуетсяТерминалВыдачи Тогда
			СтрокаТЧ.ТерминалВыдачи 			  = ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
			СтрокаТЧ.ТипОперацииНаТерминалеВыдачи = ПредопределенноеЗначение("Перечисление.ТипОперацииНаТерминале.ПустаяСсылка");
		КонецЕсли;
		Если СтрокаТЧ.НеТребуетсяТерминалСдачи Тогда
			СтрокаТЧ.ТерминалСдачи 			  	  = ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
			СтрокаТЧ.ТипОперацииНаТерминалеСдачи  = ПредопределенноеЗначение("Перечисление.ТипОперацииНаТерминале.ПустаяСсылка");
		КонецЕсли;
		Если СтрокаТЧ.НеТребуетсяАдрес Тогда
			СтруктураПоиска = Новый Структура("ИдентификаторСтрокиТабличнойЧасти",СтрокаТЧ.ИдентификаторСтрокиТабличнойЧасти);
			НайденныеСтрки = КонтактнаяИнформация.НайтиСтроки(СтруктураПоиска);
			Для Каждого НайденнаяСтрока Из НайденныеСтрки Цикл
				КонтактнаяИнформация.Удалить(НайденнаяСтрока);
			КонецЦикла;
			СтрокаТЧ.ТипОперацииНаСкладеКлиента   = ПредопределенноеЗначение("Перечисление.ТипОперацииНаТерминале.ПустаяСсылка");
		КонецЕсли;
	КонецЦикла;		
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда  
		// ДИТ US 76935 ТА 78648 Сержантова А.С. Начало: 20.12.2023
		// Было:
		//УстановитьГотовКОтправкеДляНовыхСтрок(); 
		//Стало:
		УстановитьГотовКОтправкеДляНовыхСтрок(ДополнительныеСвойства);
		// ДИТ US 76935 ТА 78648 Сержантова А.С. Конец: 20.12.2023
	КонецЕсли;	
	
	// ДИТ US 76935 ТА 78648 Сержантова А.С. Начало: 11.12.2023    
	//Убрали из формы интерактивную запись ключей аналитики при изменении реквизитов ТЧ. 
	//Теперь все изменения в форме фиксируются в доп свойствах "ДанныеДляОбновленияКлючейАналитики"
	//Здесь записываем данные в ключи аналитики
	#Область ПроверкаИЗаписьДанныхКлючейАналитикиПеревозки
	Если ДополнительныеСвойства.Свойство("ДанныеДляОбновленияКлючейАналитики") Тогда 
		ДанныеДляОбновленияКлючейАналитики = ДополнительныеСвойства.ДанныеДляОбновленияКлючейАналитики;  
		
		// ДИТ US 78233 TA 79764 Сержантова А.С. Начало: 29.01.2024 
		Если Контрагент <> Константы.КонтрагентДирекцияКонтейнерныхПеревозок.Получить() и РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда 
			Для каждого ТекущаяСтрока Из Контейнеры Цикл
				СтрокаДляОбновления = ДанныеДляОбновленияКлючейАналитики.Найти(ТекущаяСтрока.НомерСтроки, "НомерСтроки");  
				Если (ТекущаяСтрока.СтатусЗапросаНаАвтоперевозку = Перечисления.СтатусЗапросаНаПеревозку.Отправлен 
					или ТекущаяСтрока.СтатусЗапросаНаАвтоперевозку = Перечисления.СтатусЗапросаНаПеревозку.ГотовКОтправке)
					//Евросиб Коханенко Н.А. 19.02.2025 (( #102955 
					И НЕ ЭтапПеревозки = ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.СредняяМиля")
					//Евросиб Коханенко Н.А. 19.02.2025 )) #102955 
					и НЕ ЗначениеЗаполнено(СтрокаДляОбновления.ДанныеКлюча.Груз) Тогда
					Отказ = Истина; 
					ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Не заполнена колонка ""Груз"" в строке %1 списка ""Контейнеры""", ТекущаяСтрока.НомерСтроки));
				КонецЕсли;
			КонецЦикла;  
		КонецЕсли;
		// ДИТ US 78233 TA 79764 Сержантова А.С. Конец: 29.01.2024

		//Евросиб Коханенко Н.А. 23.07.2024 (( #88706
		Если Не ЗначениеЗаполнено(Ссылка) Тогда
			СсылкаНаЗапросНаАвто = Документы.ЗапросНаАвтоперевозку.ПолучитьСсылку();
			ЭтотОбъект.УстановитьСсылкуНового(СсылкаНаЗапросНаАвто);
		Иначе
			СсылкаНаЗапросНаАвто = Ссылка;
		КонецЕсли;
		//Евросиб Коханенко Н.А. 23.07.2024 )) #88706 

		Если не Отказ и (РежимЗаписи = РежимЗаписиДокумента.Запись
			или РежимЗаписи = РежимЗаписиДокумента.Проведение) Тогда 
			 
			Для каждого ТекущаяСтрока Из Контейнеры Цикл 
				СтрокаДляОбновления = ДанныеДляОбновленияКлючейАналитики.Найти(ТекущаяСтрока.НомерСтроки, "НомерСтроки");   
				ВерсияКлючаДоОбновления = СтрокаДляОбновления.КлючАналитикиПеревозки.ВерсияДанных; 
				//Евросиб Коханенко Н.А. 23.07.2024 (( #88706
				//запишем ссылку на запрос на авто в ключ аналитики 
				Если ТекущаяСтрока.СтатусЗапросаНаАвтоперевозку <> Перечисления.СтатусЗапросаНаПеревозку.Отменен Тогда
					Если ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПерваяМиля Тогда
						СтрокаДляОбновления.ДанныеКлюча.СтруктураТЧМилиПерваяМиляКлючаАналитики.ЗапросНаАвто = СсылкаНаЗапросНаАвто;
						//Евросиб Коханенко Н.А. 18.09.2025 (( #119413 
						СтрокаДляОбновления.ДанныеКлюча.СтруктураТЧМилиПерваяМиляКлючаАналитики.ИдентификаторСтрокиЗапросаНаАвтоперевозку = ТекущаяСтрока.ИдентификаторСтрокиТЧ;
						//Евросиб Коханенко Н.А. 18.09.2025 )) #119413 
					//Евросиб Коханенко Н.А. 13.08.2024 (( #87840 
					//Иначе
					//	СтрокаДляОбновления.ДанныеКлюча.СтруктураТЧМилиПоследняяМиляКлючаАналитики.ЗапросНаАвто = СсылкаНаЗапросНаАвто;	
					ИначеЕсли ЭтапПеревозки = Перечисления.ЭтапыПеревозки.СредняяМиля Тогда
						СтрокаДляОбновления.ДанныеКлюча.СтруктураТЧМилиСредняяМиляКлючаАналитики.ЗапросНаАвто = СсылкаНаЗапросНаАвто;		
						//Евросиб Коханенко Н.А. 18.09.2025 (( #119413 
						СтрокаДляОбновления.ДанныеКлюча.СтруктураТЧМилиСредняяМиляКлючаАналитики.ИдентификаторСтрокиЗапросаНаАвтоперевозку = ТекущаяСтрока.ИдентификаторСтрокиТЧ;
						//Евросиб Коханенко Н.А. 18.09.2025 )) #119413 
					ИначеЕсли ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПоследняяМиля Тогда
						СтрокаДляОбновления.ДанныеКлюча.СтруктураТЧМилиПоследняяМиляКлючаАналитики.ЗапросНаАвто = СсылкаНаЗапросНаАвто;		
						//Евросиб Коханенко Н.А. 18.09.2025 (( #119413 
						СтрокаДляОбновления.ДанныеКлюча.СтруктураТЧМилиПоследняяМиляКлючаАналитики.ИдентификаторСтрокиЗапросаНаАвтоперевозку = ТекущаяСтрока.ИдентификаторСтрокиТЧ;
						//Евросиб Коханенко Н.А. 18.09.2025 )) #119413 
					//Евросиб Коханенко Н.А. 13.08.2024 )) #87840 
					КонецЕсли;
				КонецЕсли;
				//Евросиб Коханенко Н.А. 23.07.2024 )) #88706 
				ОбновленныйКлюч = Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтрокаДляОбновления.ДанныеКлюча); 
				ТекущаяСтрока.КлючАналитикиПеревозки = ОбновленныйКлюч.КлючАналитикиПеревозки; 
				// ДИТ US 83871 ТА 84799 Сержантова А.С. Начало: 13.05.2024
				Справочники.РейсыАвто.ОбновитьДанныеВАвтоРейсеСтрокиЗапросаНаАвто(ТекущаяСтрока, Заявка, ЭтапПеревозки);
				// ДИТ US 83871 ТА 84799 Сержантова А.С. Конец: 13.05.2024
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	#КонецОбласти   
	// ДИТ US 76935 ТА 78648 Сержантова А.С. Конец: 11.12.2023
	
	//ДИТ Шевченко А.В. US 69272 ТА 69274 04.05.2023 -Начало
	Если ЗначениеЗаполнено(Ссылка) Тогда
		КонтейнерыДоИзменения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка,"Контейнеры").Выгрузить();
		Для Каждого СтрокаКонтейнеры Из Контейнеры Цикл
			СтруктураПоискаПоКлючу = Новый Структура("КлючАналитикиПеревозки",СтрокаКонтейнеры.КлючАналитикиПеревозки);
			НайденнаяСтрокаДоИзменения = КонтейнерыДоИзменения.НайтиСтроки(СтруктураПоискаПоКлючу);
			КлючКонтейнер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаКонтейнеры.КлючАналитикиПеревозки,"Контейнер");
			Если НайденнаяСтрокаДоИзменения.Количество() Тогда
				ТЧ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаКонтейнеры.КлючАналитикиПеревозки,"Мили");
				Если ТЧ <> Неопределено Тогда
					Выборка = ТЧ.Выбрать();
					Пока Выборка.Следующий() Цикл
						Если Выборка.ЭтапПеревозки = ЭтапПеревозки Тогда
							Если НайденнаяСтрокаДоИзменения[0].ДатаИВремяВывоза <> Выборка.ДатаВыдачиКТКСТерминала И ЗначениеЗаполнено(Выборка.ДатаВыдачиКТКСТерминала) Тогда
								Если ЗначениеЗаполнено(КлючКонтейнер) И КлючКонтейнер.Наименование = СтрокаКонтейнеры.КонтейнерФакт Тогда
									МассивКлючейСИзменениемДатаИВремаВывоза.Добавить(СтрокаКонтейнеры.КлючАналитикиПеревозки);
								КонецЕсли;
							КонецЕсли;
							Если НайденнаяСтрокаДоИзменения[0].ДатаИВремяСдачи <> Выборка.ДатаСдачиКТКНаТерминал И ЗначениеЗаполнено(Выборка.ДатаСдачиКТКНаТерминал) Тогда
								Если ЗначениеЗаполнено(КлючКонтейнер)Тогда
									МассивКлючейСИзменениемДатаИВремаСдачи.Добавить(СтрокаКонтейнеры.КлючАналитикиПеревозки);
								КонецЕсли;
							КонецЕсли;
							Если НайденнаяСтрокаДоИзменения[0].ДатаЗавершенияОперацииНаСкладеКлиента <> Выборка.ДатаВыездаКТКСоСклада И ЗначениеЗаполнено(Выборка.ДатаВыездаКТКСоСклада) Тогда
								Если ЗначениеЗаполнено(КлючКонтейнер)Тогда
									МассивКлючейСИзменениемДатаЗавершенияОперацииНСкладеКлиента.Добавить(СтрокаКонтейнеры.КлючАналитикиПеревозки);
								КонецЕсли;	
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли			
		КонецЦикла;		
	КонецЕсли;	
	//ДИТ Шевченко А.В. US 69272 ТА 69274 04.05.2023 -Начало 
	
	// ДИТ US 81881 ТА 84217 Сержантова А.С. Начало: 25.04.2024
	Если ДополнительныеСвойства.Свойство("ВыполнитьЗадачуОбновления") и ДополнительныеСвойства.ВыполнитьЗадачуОбновления Тогда
		СтрокиПоОбновлению = Состояния.НайтиСтроки(Новый Структура("Состояние",Справочники.Состояния.НеобходимоОбновитьДанные));
		Если СтрокиПоОбновлению.Количество() Тогда
			СтрокиПоОбновлению[0].ЗавершениеРаботы = ТекущаяДата();
			СтрокиПоОбновлению[0].Статус = Перечисления.СтатусыЭтапов.Выполнен;
		КонецЕсли;
	КонецЕсли;    
	СтрокаЗадачиОтменаРейса = Состояния.НайтиСтроки(Новый Структура("Состояние, Статус",
								Справочники.Состояния.ОтменаРейсаАктуализироватьТерминал, Перечисления.СтатусыЭтапов.Выполнен)); 
	Если СтрокаЗадачиОтменаРейса.Количество() = 1 Тогда
		СтрокаЗадачиОтменаРейса[0].ВыполнениеЗафиксировано = Истина;
		МассивВозвращаемыхЗадач = Новый Массив;
		МассивВозвращаемыхЗадач.Добавить(Справочники.Состояния.ОтменаРейсаАктуализироватьТерминал);
		ДополнительныеСвойства.Вставить("ВозвращаемыеЗадачи", МассивВозвращаемыхЗадач);	
	КонецЕсли;
	МаршрутизацияСервер.ПараллельноеСогласование(Состояния);
	МаршрутизацияСервер.ПостобработкаТЧСостояний(ЭтотОбъект, Автор);
	// ДИТ US 81881 ТА 84217 Сержантова А.С. Конец: 25.04.2024
	
КонецПроцедуры 

// ДИТ BUG 76919 ТА 77021 Сержантова А.С. 07.11.2023  
Процедура ПриЗаписи(Отказ) 
	
	Если ПометкаУдаления и не Отказ Тогда
		СтрокиКвыгрузке = Новый ТаблицаЗначений;
		СтрокиКвыгрузке.Колонки.Добавить("ИдентификаторСтрокиТабличнойЧасти");
		СтрокиКвыгрузке.Колонки.Добавить("ИдентификаторСтрокиТЧ");    
		
		// В ТЛ отменяем только те строки, которые были ранее отправлены
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		//Евросиб Коханенко Н.А. 06.06.2024 (( #83866 
		//|	ПротоколОбменов.ДатаОбмена КАК ДатаСозданияЗаказаНаТС,
		|	ПротоколОбменов.ДатаОбмена КАК ДатаОбновленияЗаказаНаТС,
		//Евросиб Коханенко Н.А. 06.06.2024 )) #83866 
		|	ПротоколОбменов.НомерДатаВБУ КАК НомерЗаказаНаТС,
		|	ПротоколОбменов.УИДИсточника КАК ИдентификаторСтрокиТЧ
		|ИЗ
		|	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
		|ГДЕ
		|	(ВЫРАЗИТЬ(ПротоколОбменов.Объект КАК Документ.ЗапросНаАвтоперевозку)) = &Объект
		|	И ПротоколОбменов.УзелОбмена = &УзелОбмена";
		
		Запрос.УстановитьПараметр("Объект", Ссылка);
		Запрос.УстановитьПараметр("УзелОбмена", Перечисления.УзлыОбмена.ТЛ);
		
		РезультатЗапроса = Запрос.Выполнить();
		Если не РезультатЗапроса.Пустой() Тогда
			ВыборкаЗаказовВтл = РезультатЗапроса.Выбрать(); 
			Пока ВыборкаЗаказовВтл.Следующий() Цикл
