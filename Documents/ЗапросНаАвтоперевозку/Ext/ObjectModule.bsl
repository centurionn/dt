		//ТаблицаОшибок = ПолучитьТаблицуОшибокПоСтроке(СтрокаТЧ);
		// Стало:
		Если ДанныеДляОбновленияКлючейАналитики <> Неопределено Тогда
			СтрокаДляОбновленияКлюча = ДанныеДляОбновленияКлючейАналитики.Найти(СтрокаТЧ.НомерСтроки, "НомерСтроки");
			СтрокаДляОбновленияКлюча = СтрокаДляОбновленияКлюча.ДанныеКлюча;
		Иначе
			СтрокаДляОбновленияКлюча = Неопределено;
		КонецЕсли;    
		ТаблицаОшибок = ПолучитьТаблицуОшибокПоСтроке(СтрокаТЧ, СтрокаДляОбновленияКлюча);
