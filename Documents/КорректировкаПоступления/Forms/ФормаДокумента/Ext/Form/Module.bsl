	Услуги1СуммаПриИзмененииНаСервере(СтрТЧ.ПолучитьИдентификатор());
	//--ДИТ Гаузер А.В. US 41390 TA 48685 22.03.2022
	
	РассчитатьСуммыВсегоПоДокументу();
