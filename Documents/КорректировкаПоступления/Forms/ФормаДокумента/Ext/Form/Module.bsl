	// Евросиб(ДИТ) US 93905 ТА 96654 Сержантова А.С. Начало: 27.12.2024
	Элементы.ПричинаОстановкиРаботы.Доступность = Пользователи.РолиДоступны(
			"ПолныеПрава,dc_РазрешитьУстанавливатьПричинуОстановкиРаботыНадДокументом",,Ложь);
	// Евросиб(ДИТ) US 93905 ТА 96654 Сержантова А.С. Конец: 27.12.2024
	
	
