&НаСервере
Процедура Услуги1РазницаВсегоКорректировкиПриИзмененииНаСервере(ИДРедСтроки)
	// ИЗМЕНЕНИЕ РазницаВсегоКорректировки
	ТекСтр = Объект.Услуги.НайтиПоИдентификатору(ИДРедСтроки);
	
	Если ЗначениеЗаполнено(ТекСтр.ВсегоДоКорректировки) Тогда
	
		ТекСтр.Всего = ТекСтр.ВсегоДоКорректировки + ТекСтр.РазницаВсегоКорректировки;
		
		ТекСтр.РазницаСуммаНДСКорректировки = 0;
		
		// Разобьем согласно НДСу:
		Если Объект.СуммаВключаетНДС Тогда
			
			ТекСтр.Сумма = ТекСтр.Всего;
			ТекСтр.СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(ТекСтр.Сумма, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(ТекСтр.СтавкаНДС), Объект.УчитыватьНДС, ИСТИНА);
			
		Иначе
			
			ТекСтр.СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(ТекСтр.Всего, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(ТекСтр.СтавкаНДС), Объект.УчитыватьНДС, Истина);
			ТекСтр.Сумма = ТекСтр.Всего - ТекСтр.СуммаНДС;
			
		КонецЕсли; 
		
		ТекСтр.РазницаСуммаКорректировки = ТекСтр.Сумма - ТекСтр.СуммаДоКорректировки;
		ТекСтр.РазницаСуммаНДСКорректировки = ТекСтр.СуммаНДС - ТекСтр.СуммаНДСДоКорректировки;
			
		ТекСтр.Цена = ТекСтр.Сумма / ?(ТекСтр.Количество=0, 1, ТекСтр.Количество);
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ТекСтр.ВсегоДоИзменения) Тогда
	
		ТекСтр.Всего = ТекСтр.ВсегоДоИзменения + ТекСтр.РазницаВсегоКорректировки;
		
		ТекСтр.РазницаСуммаНДСКорректировки = 0;
		
		// Разобьем согласно НДС-у:
		Если Объект.СуммаВключаетНДС Тогда
			
			ТекСтр.Сумма = ТекСтр.Всего;
			ТекСтр.СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(ТекСтр.Сумма, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(ТекСтр.СтавкаНДС), Объект.УчитыватьНДС, ИСТИНА);
			
		Иначе
			
