&НаКлиенте
Процедура ВычислитьЗаголовокОстатков()
	
	//// Расчет остатка
	СчетаПоставщиковСумма = Объект.СвязанныеСчетаПоставщиков.Итог("СуммаНаПТУ");
	
	//Евросиб Каблов 07.04.2025 ( #0389958
	//СуммаКотораяДолжнаБытьВ_СвязанныеСчетаПоставщиков = Объект.СуммаДокумента - ВсегоДоКорр;
	СуммаКотораяДолжнаБытьВ_СвязанныеСчетаПоставщиков = Объект.ПолнаяСуммаВСФ - ВсегоДоКорр;
	//Евросиб Каблов 07.04.2025 )
	
	Если СчетаПоставщиковСумма <> СуммаКотораяДолжнаБытьВ_СвязанныеСчетаПоставщиков Тогда
		Элементы.СвязанныеСчетаПоставщиковОстатокОплатитьНаОснованииПТУ.Заголовок = "Остаток (" + (СуммаКотораяДолжнаБытьВ_СвязанныеСчетаПоставщиков-СчетаПоставщиковСумма) + ") оплатить на основании ПТУ";
	Иначе
		Элементы.СвязанныеСчетаПоставщиковОстатокОплатитьНаОснованииПТУ.Заголовок = "Остаток (" + 0 + ") оплатить на основании ПТУ";
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Функция ЭтоИсправление(Операция)
	Если Операция = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура РассчитатьСуммыВсегоДоИзменения(ТЧ)
	
	Для Каждого СтрТЧ из Объект[ТЧ] Цикл
		
		Если СтрТЧ.ВсегоДоКорректировки <> СтрТЧ.СуммаДоКорректировки + ?(Объект.СуммаВключаетНДС,0,СтрТЧ.СуммаНДСДоКорректировки)
			ИЛИ СтрТЧ.ВсегоДоИзменения <> СтрТЧ.СуммаДоИзменения + ?(Объект.СуммаВключаетНДС,0,СтрТЧ.СуммаНДСДоИзменения) Тогда
		
			ЭтаФорма.Модифицированность = Истина;
			
			СтрТЧ.ВсегоДоКорректировки = СтрТЧ.СуммаДоКорректировки + ?(Объект.СуммаВключаетНДС,0,СтрТЧ.СуммаНДСДоКорректировки);
			СтрТЧ.ВсегоДоИзменения = СтрТЧ.СуммаДоИзменения + ?(Объект.СуммаВключаетНДС,0,СтрТЧ.СуммаНДСДоИзменения);		
		
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьКолонокНДС()
	
	Если Не Объект.УчитыватьНДС Тогда
		Элементы.Товары1СтавкаНДС.Видимость = Ложь;
		Элементы.Товары1СуммаНДС.Видимость = Ложь;
		Элементы.Услуги1СтавкаНДС.Видимость = Ложь;
		Элементы.Услуги1СуммаНДС.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммыВсегоПоДокументу()
	
	ИтогоНДС = ?(Объект.Товары.Количество()>0, Объект.Товары.Итог("СуммаНДС"),0)+?(Объект.Услуги.Количество()>0,Объект.Услуги.Итог("СуммаНДС"),0);
	ИтогоВсего = ?(Объект.Товары.Количество()>0, Объект.Товары.Итог("Сумма"),0)+ ?(Объект.Услуги.Количество()>0,Объект.Услуги.Итог("Сумма"),0)+?(Объект.СуммаВключаетНДС,0,ИтогоНДС);
	
	//Евросиб Каблов 12.05.2021 ( Ticket#0230586 
	//Попытка
	//	Объект.СуммаДокумента = ИтогоВсего;
	//	Объект.СуммаНДСДокумента = ИтогоНДС;
	//Исключение
	//	// недостаточно прав для обновления полей
	//КонецПопытки;
	//Евросиб Каблов 12.05.2021 )
	
	Элементы.Валюта.Заголовок = Объект.ВалютаДокумента;
	
КонецПроцедуры

//Евросиб Каблов 12.05.2021 Ticket#0230586
&НаКлиенте
Процедура РассчитатьСуммыДокумента()
	
	Объект.СуммаНДСДокумента = Объект.Товары.Итог("СуммаНДС") + Объект.Услуги.Итог("СуммаНДС");
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма") + ?(Объект.СуммаВключаетНДС, 0, Объект.СуммаНДСДокумента);
	
	Объект.ПолнаяСуммаВСФ = Объект.СуммаДокумента;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ДопСвойстваОбъекта.Очистить();
	Для каждого СтрТЧ из Объект.Товары Цикл
		БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(СтрТЧ,Объект.СуммаВключаетНДС);
	КонецЦикла;
	Для каждого СтрТЧ из Объект.Услуги Цикл
		БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(СтрТЧ,Объект.СуммаВключаетНДС);
	КонецЦикла;
	Если Объект.Товары.Количество()>0 Тогда 
		РассчитатьСуммыВсегоДоИзменения("Товары");
	ИначеЕсли Объект.Услуги.Количество()>0 Тогда
		РассчитатьСуммыВсегоДоИзменения("Услуги");
	КонецЕсли;
	РассчитатьСуммыВсегоПоДокументу();
	
	ОбновитьДетализацию(Неопределено);
	
	Для каждого СтрУслуги Из Объект.Услуги Цикл
	
		СтрУслуги.ИмеютсяИзменения = СтрУслуги.РазницаСуммаКорректировки <> 0 ИЛИ СтрУслуги.РазницаСуммаНДСКорректировки <> 0;
	
	КонецЦикла; 
	
	//++ДИТ Гаузер А.В. US 41390 TA 48051 05.03.2022  
	УстановитьДоступностьЭлементаВОчередиАвторазнесения();
	//--ДИТ Гаузер А.В. US 41390 TA 48051 05.03.2022

КонецПроцедуры

