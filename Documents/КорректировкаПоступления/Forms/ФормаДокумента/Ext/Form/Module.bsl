Процедура СвязанныеСчетаПоставщовСчетПоставщикаПриИзменении(Элемент)
	
	ТекД = Элементы.СвязанныеСчетаПоставщиков.ТекущиеДанные;
	СуммаТаблицыПривязанныхСчетов = 0;
	Для каждого Стр из Объект.СвязанныеСчетаПоставщиков Цикл
		СуммаТаблицыПривязанныхСчетов = СуммаТаблицыПривязанныхСчетов + Стр.СуммаНаПТУ;
	КонецЦикла;
	Если ЗначениеЗаполнено(ТекД.СчетПоставщика) Тогда
		ПолученнаяСуммаСчета = ПолучитьСуммуСчета(ТекД.СчетПоставщика);
		ТекД.СуммаНаПТУ = Макс(Мин(ПолученнаяСуммаСчета, Объект.СуммаДокумента - Объект.Услуги.Итог("СтрУслуги.ВсегоДоИзменения") - СуммаТаблицыПривязанныхСчетов), 0);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОстатокОплатитьНаОснованииПТУ(Команда)
	
	СчетаПоставщиковСумма = Объект.СвязанныеСчетаПоставщиков.Итог("СуммаНаПТУ");
	ОтнесеннаяСуммаОтнесенныхСчетов = 0;
	Для каждого Стр из Объект.СвязанныеСчетаПоставщиков Цикл
		Если ЗначениеЗаполнено(Стр.СчетПоставщика) Тогда ОтнесеннаяСуммаОтнесенныхСчетов = ОтнесеннаяСуммаОтнесенныхСчетов + Стр.СуммаНаПТУ; КонецЕсли;
	КонецЦикла;
	
	//Евросиб Каблов 07.04.2025 ( #0389958
	//Если (Объект.СуммаДокумента - Объект.Услуги.Итог("ВсегоДоИзменения") - ОтнесеннаяСуммаОтнесенныхСчетов) = 0 Тогда Возврат; КонецЕсли;
	Если (Объект.ПолнаяСуммаВСФ - Объект.Услуги.Итог("ВсегоДоИзменения") - ОтнесеннаяСуммаОтнесенныхСчетов) = 0 Тогда Возврат; КонецЕсли;
	//Евросиб Каблов 07.04.2025 )
	
	МассивНС = Объект.СвязанныеСчетаПоставщиков.НайтиСтроки(Новый Структура("СчетПоставщика", ПредопределенноеЗначение("Документ.СчетНаОплатуПоставщика.ПустаяСсылка")));
	Для каждого Стр из МассивНС Цикл
		Объект.СвязанныеСчетаПоставщиков.Удалить(Стр);
	КонецЦикла;
	
	//Евросиб Каблов 07.04.2025 ( #0389958
	//Если СчетаПоставщиковСумма <> Объект.СуммаДокумента Тогда
	Если СчетаПоставщиковСумма <> Объект.ПолнаяСуммаВСФ Тогда
	//Евросиб Каблов 07.04.2025 )
	
		НСтр = Объект.СвязанныеСчетаПоставщиков.Добавить();
		//Евросиб Каблов 07.04.2025 ( #0389958
		//НСтр.СуммаНаПТУ = Объект.СуммаДокумента - Объект.Услуги.Итог("ВсегоДоИзменения") - ОтнесеннаяСуммаОтнесенныхСчетов;
		НСтр.СуммаНаПТУ = Объект.ПолнаяСуммаВСФ - Объект.Услуги.Итог("ВсегоДоИзменения") - ОтнесеннаяСуммаОтнесенныхСчетов;
		//Евросиб Каблов 07.04.2025 )
		
		//ДИТ, Беляев СЮ, US 58086 / TA 68093, 11-08-2023, начало
		НСтр.СчетПоставщика = ПолучитьСчетПредыдущегоДокумента( Объект.ДокументПоступления );
		//ДИТ, Беляев СЮ, US 58086 / TA 68093, 11-08-2023, конец
	КонецЕсли; 
	 
	//НСтр = Объект.СвязанныеСчетаПоставщиков.Добавить();
	//НСтр.СуммаНаПТУ = Объект.СуммаДокумента - Объект.Услуги.Итог("ВсегоДоИзменения") - ОтнесеннаяСуммаОтнесенныхСчетов;
		
	СвязанныеСчетаПоставщиковПриИзменении(Неопределено);
	
КонецПроцедуры

