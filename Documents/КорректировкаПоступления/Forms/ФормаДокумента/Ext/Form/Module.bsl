	РазницаСуммаНДСКорректировкиИтог= Объект.Услуги.Итог("РазницаСуммаНДСКорректировки");
	РазницаСуммаКорректировкиИтог 	= Объект.Услуги.Итог("РазницаСуммаКорректировки");
	
	//Евросиб Каблов 21.12.2021 ( Ticket#0253815
	//СуммаРазница 	= СуммаПослеКорректировки - (СуммаДоКорректировки + СуммаДоИзм);
	//СуммаНДСРазница = СуммаНДС_ПослеКорректировки - (СуммаНДС_ДоКорректировки + СуммаНДСДоИзм);
	СуммаРазница 	= Объект.Услуги.Итог("РазницаСуммаКорректировки");
	СуммаНДСРазница= Объект.Услуги.Итог("РазницаСуммаНДСКорректировки");
	//Евросиб Каблов 21.12.2021 )
	
	ВсегоДоКорр 	= ?(Объект.Услуги.Итог("ВсегоДоКорректировки")=0, Объект.Услуги.Итог("ВсегоДоИзменения"), Объект.Услуги.Итог("ВсегоДоКорректировки"));
	ВсегоПослеКорр 	= Объект.Услуги.Итог("Всего");
	
	//Евросиб Каблов 21.12.2021 ( Ticket#0253815
	//ОбщаяРазность = ВсегоПослеКорр - ВсегоДоКорр;	
	ОбщаяРазность	= Объект.Услуги.Итог("РазницаВсегоКорректировки");	
	//Евросиб Каблов 21.12.2021 )
	
