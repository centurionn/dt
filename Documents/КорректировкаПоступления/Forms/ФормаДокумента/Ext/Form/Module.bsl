&НаКлиенте
Процедура СобратьИтогиПоДокументу()

	СуммаДоКорректировки = Объект.Услуги.Итог("СуммаДоКорректировки");
	СуммаНДС_ДоКорректировки = Объект.Услуги.Итог("СуммаНДСДоКорректировки");
	
	КоличествоДоИзм = Объект.Услуги.Итог("КоличествоДоИзменения");
	КоличествоПосле = Объект.Услуги.Итог("Количество");
	
	СуммаДоИзм 		= Объект.Услуги.Итог("СуммаДоИзменения");
	СуммаНДСДоИзм 	= Объект.Услуги.Итог("СуммаНДСДоИзменения");
	
	//Евросиб Каблов 21.12.2021 ( Ticket#0253815
	//ОбщСуммаДоКорректировки = СуммаДоКорректировки + СуммаДоИзм;
	//ОбщСуммаНДС_ДоКорректировки = СуммаНДС_ДоКорректировки + СуммаНДСДоИзм;
	ОбщСуммаДоКорректировки = ?(СуммаДоКорректировки = 0, СуммаДоИзм, СуммаДоКорректировки);
	ОбщСуммаНДС_ДоКорректировки = ?(СуммаНДС_ДоКорректировки = 0, СуммаНДСДоИзм, СуммаНДС_ДоКорректировки);
	//Евросиб Каблов 21.12.2021 )
	
	СуммаПослеКорректировки = Объект.Услуги.Итог("Сумма");
	СуммаНДС_ПослеКорректировки = Объект.Услуги.Итог("СуммаНДС");
	
