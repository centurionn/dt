&НаКлиенте
Процедура РазнестиАвтоматически(Команда)
	
	РазнестиАвтоматическиНаСервере();
	ОбновитьДетализацию(Неопределено);
	
КонецПроцедуры

&НаСервере
Процедура РазнестиАвтоматическиНаСервере()
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.РазнестиУслугиАвтоматически();
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
		
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДетализацию(Команда)
	
	Если Команда <> неопределено Тогда //заполнение по кнопке
		
		Объект.СвязьУслугИСчетов.Очистить();
		
		Для каждого СтрУслуги из Объект.Услуги Цикл
			Если НЕ ЗначениеЗаполнено(СтрУслуги.ГУИДПТУ) Тогда
				СтрУслуги.ГУИДПТУ = Строка(Новый УникальныйИдентификатор);
			КонецЕсли;
			
			СтрНайдена = Ложь;
			Для каждого СтрСвязи из Объект.СвязьУслугИСчетов Цикл
				Если СтрСвязи.ГУИДПТУ = СтрУслуги.ГУИДПТУ Тогда
					ЗаполнитьЗначенияСвойств(СтрСвязи, СтрУслуги, "Номенклатура,Содержание");
					СтрНайдена = Истина;
				КонецЕсли;
			КонецЦикла;
			
			Если НЕ СтрНайдена Тогда
				
				//Евросиб Каблов 16.09.2021 ( Ticket#0243069
				//Если (СтрУслуги.Всего - ?(СтрУслуги.ВсегоДоИзменения=0, СтрУслуги.ВсегоДоКорректировки, СтрУслуги.ВсегоДоИзменения)) <> 0 Тогда
				ВсегоКорр = СтрУслуги.Всего - ?(СтрУслуги.ВсегоДоКорректировки = 0, СтрУслуги.ВсегоДоИзменения, СтрУслуги.ВсегоДоКорректировки);
				
				Если ВсегоКорр <> 0 Тогда
				//Евросиб Каблов 16.09.2021 )
				
					НСтр = Объект.СвязьУслугИСчетов.Добавить();
					ЗаполнитьЗначенияСвойств(НСтр, СтрУслуги, "Номенклатура,Содержание,ГУИДПТУ,СтавкаНДС");
					//Евросиб Каблов 16.09.2021 ( Ticket#0243069
					//НСтр.Всего = СтрУслуги.Всего - ?(СтрУслуги.ВсегоДоКорректировки = 0, СтрУслуги.ВсегоДоИзменения, СтрУслуги.ВсегоДоКорректировки);
					НСтр.Всего = ВсегоКорр;
					//Евросиб Каблов 16.09.2021 )
					НСтр.ОтнесеннаяСумма = НСтр.Всего;
					//Евросиб Каблов 16.09.2021 ( Ticket#0243069
					//НСтр.СуммаНДС 			= СтрУслуги.СуммаНДС - СтрУслуги.СуммаНДСДоИзменения;
					НСтр.СуммаНДС 			= СтрУслуги.СуммаНДС - ?(СтрУслуги.СуммаНДСДоКорректировки = 0, СтрУслуги.СуммаНДСДоИзменения, СтрУслуги.СуммаНДСДоКорректировки);
					//КонецЕсли;
					//Евросиб Каблов 16.09.2021 )
				
				КонецЕсли; 
				//НСтр.Всего = СтрУслуги.Всего;
				//НСтр.СуммаНДС = СтрУслуги.СуммаНДС;
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе //обновление отображения
		
		Для каждого СтрУслуги из Объект.Услуги Цикл
			Для каждого СтрСвязи из Объект.СвязьУслугИСчетов Цикл
				Если СтрСвязи.ГУИДПТУ = СтрУслуги.ГУИДПТУ Тогда
					ЗаполнитьЗначенияСвойств(СтрСвязи, СтрУслуги, "Номенклатура,Содержание");
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСуммуСчета(СчетПоставщика)
	
	Рез = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПривязанныеСчетаПоставщиковОстатки.ПолнаяСуммаСчетаОстаток - ПривязанныеСчетаПоставщиковОстатки.ПривязаннаяСуммаОстаток КАК ОсталосьПривязать
	               |ИЗ
	               |	РегистрНакопления.ПривязанныеСчетаПоставщиков.Остатки(, СчетПоставщика = &СчетПоставщика) КАК ПривязанныеСчетаПоставщиковОстатки";
	Запрос.УстановитьПараметр("СчетПоставщика", СчетПоставщика);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Рез = Ответ.ОсталосьПривязать;
	КонецЕсли;
	
	Возврат Рез;
	
КонецФункции

&НаКлиенте
Процедура УстановитьВидимостьЭлементовКорректировки()

	ЭтоКорректировка = ТипЗнч(Объект.ДокументПоступления) = Тип("ДокументСсылка.КорректировкаПоступления");
	Элементы.Услуги1ВсегоДоИзменения.Видимость = Не ЭтоКорректировка;
	Элементы.Услуги1КоличествоДоИзменения.Видимость = Не ЭтоКорректировка;
	Элементы.Услуги1СодержаниеДоИзменения.Видимость = Не ЭтоКорректировка;
	Элементы.Услуги1СтавкаНДСДоИзменения.Видимость = Не ЭтоКорректировка;
	Элементы.Услуги1СуммаДоИзменения.Видимость = Не ЭтоКорректировка;
	Элементы.Услуги1СуммаНДСДоИзменения.Видимость = Не ЭтоКорректировка;
	Элементы.Услуги1ЦенаДоИзменения.Видимость = Не ЭтоКорректировка;
	
	Элементы.Услуги1ВсегоДоКорректировки.Видимость = ЭтоКорректировка;
	Элементы.Услуги1КоличествоДоКорректировки.Видимость = ЭтоКорректировка;
	Элементы.Услуги1СуммаДоКорректировки.Видимость = ЭтоКорректировка;
	Элементы.Услуги1СуммаНДСДоКорректировки.Видимость = ЭтоКорректировка;
	Элементы.Услуги1ЦенаДоКорректировки.Видимость = ЭтоКорректировка;
	
КонецПроцедуры // УстановитьВидимостьЭлементовКорректировки()

