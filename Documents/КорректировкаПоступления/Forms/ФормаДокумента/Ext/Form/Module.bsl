&НаКлиенте
Процедура ПроверитьВыгрузкуВУПП(Команда)
	
	Отказ = Ложь;
	
	ОчиститьСообщения();
	
	НеЗаписан = ЭтаФорма.Модифицированность или Не Объект.Проведен;
	ПараметрыОбработки = Новый Структура("НеЗаписан", НеЗаписан);
	ОповещениеОтветаВопроса = Новый ОписаниеОповещения("ОбработкаВопросаВыгрузка", ЭтаФорма, ПараметрыОбработки);
	Если НеЗаписан Тогда
		ПоказатьВопрос(ОповещениеОтветаВопроса, "Для выполнения проверки документ должен быть проведен. Продолжить?", РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Нет);
	Иначе		
		ОбработкаВопросаВыгрузка(КодВозвратаДиалога.Да, ПараметрыОбработки); 
		ПроверитьВыгрузкуВУППСервер();
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ОбработкаВопросаВыгрузка(Ответ = неопределено, Параметры) Экспорт
	
	Если Не Ответ = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Если Параметры.НеЗаписан Тогда
		ПровестиДокументКорректировкиПоступления();	
	КонецЕсли; 
	
КонецПроцедуры 

