&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Объект.Комментарий = "Отказ" Тогда Отказ = Истина; КонецЕсли;
	Если ТипЗнч(Объект.ДокументПоступления) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") или ТипЗнч(Объект.ДокументПоступления) = Тип("ДокументСсылка.СчетФактураПолученный") 
		ИЛИ ТипЗнч(Объект.ДокументПоступления) = Тип("ДокументСсылка.КорректировкаПоступления") Тогда
		Элементы.Товары1КоличествоДоКорректировки.Видимость = Ложь;
		Элементы.Товары1СуммаДоКорректировки.Видимость = Ложь;
		Элементы.Товары1СуммаНДСДоКорректировки.Видимость = Ложь;
		Элементы.Товары1ЦенаДоКорректировки.Видимость = Ложь;
		Элементы.Товары1ВсегоДоКорректировки.Видимость = Ложь;
		//Элементы.Товары1КатегорияРасходовДоКорректировки.Видимость = Ложь;
		
		Элементы.Услуги1КоличествоДоКорректировки.Видимость = Ложь;
		Элементы.Услуги1СуммаДоКорректировки.Видимость = Ложь;
		Элементы.Услуги1СуммаНДСДоКорректировки.Видимость = Ложь;
		Элементы.Услуги1ЦенаДоКорректировки.Видимость = Ложь;
		Элементы.Услуги1ВсегоДоКорректировки.Видимость = Ложь;
		//Элементы.Услуги1КатегорияРасходовДоКорректировки.Видимость = Ложь;
	КонецЕсли;
	
	Если Объект.Товары.Количество() = 0 Тогда
		Элементы.Товары.Видимость = Ложь;
	Иначе
		Для каждого СтрТЧ из Объект.Товары Цикл
			 БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(СтрТЧ,Объект.СуммаВключаетНДС);
		КонецЦикла;
		РассчитатьСуммыВсегоДоИзменения("Товары");
	КонецЕсли;
	Если Объект.Услуги.Количество() = 0 Тогда
		Элементы.Услуги.Видимость = Ложь;
	Иначе
		Для каждого СтрТЧ из Объект.Услуги Цикл
			 БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(СтрТЧ,Объект.СуммаВключаетНДС);
		КонецЦикла;
		РассчитатьСуммыВсегоДоИзменения("Услуги");
	КонецЕсли;
	Элементы.Валюта.Заголовок = Объект.ВалютаДокумента;
//	Отбор = Новый Структура("ПометкаУдаления", Ложь);
	РеквизитыСФ = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьРеквизитыСчетФактуры(Объект, "СчетФактураПолученный");//, Отбор);
	Если РеквизитыСФ <> Неопределено Тогда
		Элементы.СчетФактураНадпись.Заголовок = БухгалтерскийУчетОбщиеПроцедурыКлиент.ЗаполнитьНадписьСчФ(РеквизитыСФ);
//Евросиб Гудкова( 04.02.2021 Ticket№0218691 
		НомерВСФ = РеквизитыСФ.НомерВходящегоДокумента;
		ДатаВСФ = РеквизитыСФ.ДатаВходящегоДокумента;
// Евросиб Гудкова) 		
	КонецЕсли;
	Если ЭтоИсправление(Объект.ВидОперации) Тогда
		Элементы.Группа6.Видимость = Истина;
	КонецЕсли;

	УстановитьВидимостьКолонокНДС();
	
	//Евросиб Гудкова( 02.02.2020 
	УстановитьВидимостьЭлементовКорректировки();
	// Евросиб Гудкова) 	
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		РассчитатьСуммыВсегоПоДокументу();
		
	КонецЕсли;

	Для каждого СтрУслуги Из Объект.Услуги Цикл
	
		СтрУслуги.ИмеютсяИзменения = СтрУслуги.РазницаСуммаКорректировки <> 0 ИЛИ СтрУслуги.РазницаСуммаНДСКорректировки <> 0;
	
	КонецЦикла; 
	
	//Евросиб Каблов 02.09.2024 ( Ticket#0360646
	//СобратьИтогиПоДокументу_ВычислитьЗагОстатков();
	СобратьИтогиПоДокументу();
	ВычислитьЗаголовокОстатков();
	//Евросиб Каблов 02.09.2024 )
	
	//++ Зубов US45321 TA45322 27.01.2022
	ЗаполнитьПричинуВозврата();
	//-- Зубов US45321 TA45322 27.01.2022
КонецПроцедуры

