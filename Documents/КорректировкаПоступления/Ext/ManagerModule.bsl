Процедура СформироватьДвиженияЗаказПоставщику_ПП(ДокОбъект,Стр) Экспорт //ДИТ Шевченко А.В. US 58086 ТА 69951 20.07.2023 -Начало
	
	Движения = ДокОбъект.Движения;
	
	Движения.ЗаказПоставщику_ПП.Очистить();
	Движения.ЗаказПоставщику_ПП.Записывать = Истина;
	
	Движение = Движения.ЗаказПоставщику_ПП.ДобавитьПриход();
	Движение.Период 		= ДокОбъект.Дата;
	Движение.Организация 	= Стр.СчетПоставщика.Организация; 
	Движение.Контрагент		= Стр.СчетПоставщика.Контрагент; 
	Движение.Договор		= Стр.СчетПоставщика.ДоговорКонтрагента; 
	Движение.СчетПоставщика = Стр.СчетПоставщика;
	Движение.ДопРегистратор	= ДокОбъект.Ссылка;
	
	Если ДокОбъект.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки Тогда
		Движение.Сумма 			= -ДокОбъект.ДокументПоступления.ПолнаяСуммаВСФ;
		
		Движение = Движения.ЗаказПоставщику_ПП.ДобавитьПриход();
		Движение.Период 		= ДокОбъект.Дата;
		Движение.Организация 	= Стр.СчетПоставщика.Организация; 
		Движение.Контрагент		= Стр.СчетПоставщика.Контрагент; 
		Движение.Договор		= Стр.СчетПоставщика.ДоговорКонтрагента; 
		Движение.СчетПоставщика = Стр.СчетПоставщика;
		Движение.ДопРегистратор	= ДокОбъект.Ссылка;
		Движение.Сумма 			= ДокОбъект.СуммаДокумента;
	КонецЕсли;
	
	Если ДокОбъект.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение Тогда
		Движение.Сумма 			= Стр.СуммаНаПТУ;
	КонецЕсли;
	
КонецПроцедуры	

//ДИТ, Беляев СЮ, US 58086 / TA 68093, 11-08-2023, начало
Функция ПолучитьСчетПредыдущегоДокумента( ДокументПоступления ) Экспорт
	Результат = Неопределено;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КорректировкаПоступленияСвязанныеСчетаПоставщиков.СчетПоставщика КАК СчетПоставщика
	|ИЗ
	|	Документ.КорректировкаПоступления.СвязанныеСчетаПоставщиков КАК КорректировкаПоступленияСвязанныеСчетаПоставщиков
	|ГДЕ
	|	КорректировкаПоступленияСвязанныеСчетаПоставщиков.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ПоступлениеТоваровУслугСвязанныеСчетаПоставщиков.СчетПоставщика
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.СвязанныеСчетаПоставщиков КАК ПоступлениеТоваровУслугСвязанныеСчетаПоставщиков
	|ГДЕ
	|	ПоступлениеТоваровУслугСвязанныеСчетаПоставщиков.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ДокументПоступления);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Выборка.СчетПоставщика;
		Прервать;
	КонецЦикла;
	Возврат Результат;
КонецФункции
//ДИТ, Беляев СЮ, US 58086 / TA 68093, 11-08-2023, конец
