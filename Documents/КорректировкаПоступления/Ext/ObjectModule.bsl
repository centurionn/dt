Процедура ПроверитьИзмененияКлючевыхДанныхДляАкцепта(Отказ, Ошибки) Экспорт
	
	Если Не ЗначениеЗаполнено(ЭтотОбъект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	//Делаем только для исправления первички по условиям задачи 41390  
	Если не ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("ЗаписьИзАкцепта") Тогда
		//Если установлено это свойство, то запись происходит из акцепта
		//значит проверка не нужна.
		Возврат;
	КонецЕсли; 
	СостояниеРазнесения = Документы.Акцепт.ПолучитьДанныеПоследнегоПроведенногоАкцепта(Ссылка);
	Если СостояниеРазнесения.СтатусРазнесения = Перечисления.СостоянияАвторазнесения.НетАктуальногоАкцепта
		//Евросиб - АСуслов 30.11.2022 9:08:06 #0293538 
		//(
		ИЛИ СостояниеРазнесения.СтатусРазнесения = Перечисления.СостоянияАвторазнесения.АкцептНеСоздан
		//)
		//Евросиб - АСуслов 30.11.2022 9:08:08 #0293538 
		Тогда
		Возврат;
	КонецЕсли; 
	ИзмененныеРеквизиты = Неопределено;
	КонтрольДоступностиДокументов_сервер.ПроверитьИзмененияРеквизитовОбъекта(ЭтотОбъект, Отказ, Ложь, ПолучитьСписокПроверяемыхПолей(), ИзмененныеРеквизиты); 
	Если Отказ Тогда
		Ошибки = СтрШаблон("По ПТУ %2 от %3 существует актуальный акцепт, запись отменена, т.к. изменены ключевые поля в документе: %1
							|Перед записью документа необходимо сторнировать актуальный акцепт.", 
							СтроковыеФункцииКлиентСервер.СтрокаИзМассиваПодстрок(ИзмененныеРеквизиты),
							Номер,
							Формат(Дата, "ДФ=dd.MM.yyyy"));
	Иначе 
		
		//проверим изменения ТЧ Услуги
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПоступлениеТоваровУслугУслуги.Номенклатура КАК Номенклатура,
		|	ПоступлениеТоваровУслугУслуги.Содержание КАК Содержание,
		|	ПоступлениеТоваровУслугУслуги.Количество КАК Количество,
		|	ПоступлениеТоваровУслугУслуги.СтавкаНДС КАК СтавкаНДС,
		|	ПоступлениеТоваровУслугУслуги.Сумма КАК Сумма,
		|	ПоступлениеТоваровУслугУслуги.СуммаНДС КАК СуммаНДС,
		|	ПоступлениеТоваровУслугУслуги.Цена КАК Цена,
		// ++ ДИТ_Агафонов_task 41390 10.04.2023
		//Нет такого реквизита в корректировке
		//|	ПоступлениеТоваровУслугУслуги.УдПеревыставление КАК УдПеревыставление,
		// -- ДИТ_Агафонов_task 41390 10.04.2023
		|	ПоступлениеТоваровУслугУслуги.СписокТС КАК СписокТС,
		|	ПоступлениеТоваровУслугУслуги.СписокТЕ КАК СписокТЕ,
