Процедура ПроверитьВыгрузкуВУПП() Экспорт
	
 	СоответствиеОшибок = Новый Соответствие;
	СоответствиеОшибок.Вставить("ОшибкаВДатеМодификации", "Дата модификации меньше, чем дата обмена");
	СоответствиеОшибок.Вставить("ОшибкаВСтатусах", "Необходимо исправить статус ЭДО");  
	СоответствиеОшибок.Вставить("ОшибкаНеРазрешенаВыгрузка", "Выгрузка в УПП не разрешена");
	СоответствиеОшибок.Вставить("ОшибкаЭтоКопия", "Проверьте значение реквизита ""копия""");
   
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НЕ ВЫБОР
		|			КОГДА ЕСТЬNULL(ПротоколОбменов.ДатаОбмена, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ПротоколОбменов.ДатаОбмена < КорректировкаПоступления.ДатаМодификации
		|		КОНЕЦ КАК ОшибкаВДатеМодификации,
		|	НЕ ВЫБОР
		|			КОГДА КорректировкаПоступления.Контрагент.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
		|				ТОГДА НЕ КорректировкаПоступления.Копия
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ КАК ОшибкаЭтоКопия,
		|	НЕ КорректировкаПоступления.РазрешенаВыгрузкаВУПП КАК ОшибкаНеРазрешенаВыгрузка,
		|	НЕ ВЫБОР
		|			КОГДА Диадок_Документы.СостояниеДокументооборота ЕСТЬ NULL
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ Диадок_Документы.СостояниеДокументооборота = ""Подписан""
		|					ИЛИ Диадок_Документы.СостояниеДокументооборота = ""Откорректирован""
		|					ИЛИ Диадок_Документы.СостояниеДокументооборота = ""Документооборот завершен""
		|						И Диадок_Документы.СостояниеДокументооборотаДоп В (""Согласован"", """")
		|		КОНЕЦ КАК ОшибкаВСтатусах
		|ИЗ
		|	Документ.КорректировкаПоступления КАК КорректировкаПоступления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
		|		ПО КорректировкаПоступления.Ссылка = ПротоколОбменов.Объект
		|			И (ПротоколОбменов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных))
		|			И (ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УПП))
		|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК Контрагенты
		|		ПО КорректировкаПоступления.Контрагент = Контрагенты.Объект
		|			И (Контрагенты.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
		|			И (Контрагенты.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.БитФинанс))
		|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ДоговорыКонтрагентов
		|		ПО КорректировкаПоступления.ДоговорКонтрагента = ДоговорыКонтрагентов.Объект
		|			И (ДоговорыКонтрагентов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
		|			И (ДоговорыКонтрагентов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.БитФинанс))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияДокументовВДиадоке КАК Диадок_Документы
		|		ПО КорректировкаПоступления.Ссылка = Диадок_Документы.Документ
		|ГДЕ
		|	КорректировкаПоступления.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() <> 0 Тогда
		КоличествоОшибок = 0;
		Для каждого Колонка из Результат.Колонки Цикл
			Если Результат[0][Колонка.Имя] Тогда
				КоличествоОшибок = КоличествоОшибок+1;
				Сообщить(СоответствиеОшибок.Получить(Колонка.Имя));
			КонецЕсли;
		КонецЦикла
	КонецЕсли;
	
	Сообщить("Проверка готовности документа к выгрузке завершена, выявлено ошибок: " +КоличествоОшибок);
	
КонецПроцедуры
