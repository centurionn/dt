Процедура ЗаполнитьУслугиПоДокументуПоступления() Экспорт
	
	Услуги.Очистить();
	
	ТипДокументаПоступления = ТипЗнч(ДокументПоступления);
	Если ТипДокументаПоступления = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		Для Каждого ТекСтрокаУслуги Из ДокументПоступления.Услуги Цикл
			НоваяСтрока = Услуги.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрокаУслуги);
			НоваяСтрока.КоличествоДоИзменения	= ТекСтрокаУслуги.Количество;
			НоваяСтрока.СодержаниеДоИзменения 	= ТекСтрокаУслуги.Содержание;
			НоваяСтрока.СтавкаНДСДоИзменения 	= ТекСтрокаУслуги.СтавкаНДС;
			НоваяСтрока.СуммаДоИзменения		= ТекСтрокаУслуги.Сумма;
			НоваяСтрока.СуммаНДСДоИзменения		= ТекСтрокаУслуги.СуммаНДС;
			НоваяСтрока.ЦенаДоИзменения			= ТекСтрокаУслуги.Цена;
			НоваяСтрока.ВсегоДоИзменения		= ТекСтрокаУслуги.Всего;
			НоваяСтрока.ГУИДстроки 				= Строка(Новый УникальныйИдентификатор);
		КонецЦикла;
	ИначеЕсли ТипДокументаПоступления = Тип("ДокументСсылка.КорректировкаПоступления") Тогда
		Для Каждого ТекСтрокаУслуги Из ДокументПоступления.Услуги Цикл
			НоваяСтрока = Услуги.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрокаУслуги);
			НоваяСтрока.КоличествоДоИзменения 		= ТекСтрокаУслуги.Количество;
			НоваяСтрока.КоличествоДоКорректировки 	= ТекСтрокаУслуги.КоличествоДоИзменения;
			НоваяСтрока.СодержаниеДоИзменения 		= ТекСтрокаУслуги.Содержание;
			НоваяСтрока.СтавкаНДСДоИзменения 		= ТекСтрокаУслуги.СтавкаНДС;
			НоваяСтрока.СуммаДоИзменения 			= ТекСтрокаУслуги.Сумма;
			НоваяСтрока.СуммаНДСДоИзменения			= ТекСтрокаУслуги.СуммаНДС;
			НоваяСтрока.ЦенаДоИзменения 			= ТекСтрокаУслуги.Цена;
			НоваяСтрока.ЦенаДоКорректировки			= ТекСтрокаУслуги.Цена;
			НоваяСтрока.СуммаДоКорректировки 		= ТекСтрокаУслуги.Сумма;
			НоваяСтрока.СуммаНДСДоКорректировки 	= ТекСтрокаУслуги.СуммаНДС;
			НоваяСтрока.ВсегоДоИзменения			= ТекСтрокаУслуги.Всего;
			НоваяСтрока.РазницаВсегоКорректировки 	= 0;
			НоваяСтрока.РазницаСуммаКорректировки 	= 0;
			НоваяСтрока.РазницаСуммаНДСКорректировки = 0;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры
