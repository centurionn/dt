		|	ВТ_Услуги.ГУИДПТУ,
		|	-ВТ_Услуги.Всего,
		|	ВТ_Услуги.ИДТД,
		|	ВТ_Услуги.СтанцияОтправления,
		|	ВТ_Услуги.СтанцияНазначения
		|ИЗ
		|	ВТ_Услуги КАК ВТ_Услуги
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТаблицыСравнения.Номенклатура КАК Номенклатура,
		|	СУММА(ВТ_ТаблицыСравнения.Количество) КАК Количество,
		|	ВТ_ТаблицыСравнения.СтавкаНДС КАК СтавкаНДС,
		|	СУММА(ВТ_ТаблицыСравнения.Сумма) КАК Сумма,
		|	СУММА(ВТ_ТаблицыСравнения.СуммаНДС) КАК СуммаНДС,
		|	СУММА(ВТ_ТаблицыСравнения.Цена) КАК Цена,
		|	ВТ_ТаблицыСравнения.ГУИДПТУ КАК ГУИДПТУ,
		|	СУММА(ВТ_ТаблицыСравнения.Всего) КАК Всего,
		|	ВТ_ТаблицыСравнения.ИДТД КАК ИДТД,
		|	ВТ_ТаблицыСравнения.СтанцияОтправления КАК СтанцияОтправления,
		|	ВТ_ТаблицыСравнения.СтанцияНазначения КАК СтанцияНазначения,
		|	ВТ_ТаблицыСравнения.СписокТС КАК СписокТС,
		|	ВТ_ТаблицыСравнения.СписокТЕ КАК СписокТЕ,
		|	ВТ_ТаблицыСравнения.СписокТД КАК СписокТД,
		|	ВТ_ТаблицыСравнения.Содержание КАК Содержание
		|ИЗ
		|	ВТ_ТаблицыСравнения КАК ВТ_ТаблицыСравнения
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ТаблицыСравнения.Номенклатура,
		|	ВТ_ТаблицыСравнения.СтавкаНДС,
		|	ВТ_ТаблицыСравнения.ГУИДПТУ,
		|	ВТ_ТаблицыСравнения.ИДТД,
		|	ВТ_ТаблицыСравнения.СтанцияОтправления,
		|	ВТ_ТаблицыСравнения.СтанцияНазначения,
		|	ВТ_ТаблицыСравнения.СписокТС,
		|	ВТ_ТаблицыСравнения.СписокТЕ,
		|	ВТ_ТаблицыСравнения.СписокТД,
		|	ВТ_ТаблицыСравнения.Содержание
		|
		|ИМЕЮЩИЕ
		|	(СУММА(ВТ_ТаблицыСравнения.Сумма) <> 0
		|		ИЛИ СУММА(ВТ_ТаблицыСравнения.СуммаНДС) <> 0
		|		ИЛИ СУММА(ВТ_ТаблицыСравнения.Цена) <> 0
		|		ИЛИ СУММА(ВТ_ТаблицыСравнения.Всего) <> 0)";
		Запрос.УстановитьПараметр("ТЧУслуги",Услуги.Выгрузить());
		Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
		РезультатЗапроса = Запрос.Выполнить();
		Отказ = НЕ РезультатЗапроса.Пустой();
		Если Отказ Тогда
			Ошибки = Ошибки + СтрШаблон("По КоррПТУ существует актуальный акцепт, запись отменена, т.к. изменена ТЧ «Услуги»
										|Перед записью документа необходимо сторнировать актуальный акцепт."); 
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

