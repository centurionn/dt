	РассчитатьСуммыВсегоПоДокументу();
РасчитатьВознаграждение();
РассчитатьСуммуПоСФ(СтрТабЧасти.Сумма,СтрТабЧасти.СуммаНДС,СтрТабЧасти.КлючСтроки);

