	Если СпособРасчета = Перечисления.СпособыРасчетаКомиссионногоВознаграждения.НеРассчитывается Тогда
		Возврат Ложь;
	Иначе Возврат Истина;
	КонецЕсли;
КонецФункции

&НаСервере
Функция РассчитыватьПроцентом(СпособРасчета)
	Если СпособРасчета = Перечисления.СпособыРасчетаКомиссионногоВознаграждения.НеРассчитывается Тогда
		Возврат Ложь;
	Иначе Возврат Истина;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура РасчитатьВознаграждение();
	Для каждого СТр из Объект.Товары Цикл
		Стр.СуммаВознаграждения = Стр.Сумма*Объект.ПроцентКомиссионногоВознаграждения/100;
		Стр.СуммаНДСВознаграждения = БухгалтерскийУчетОбщиеПроцедурыКлиент.ПолучитьСуммуНДС(СТр.СуммаВознаграждения,БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Объект.СтавкаНДСВознаграждения),Объект.УчитыватьНДС,Объект.СуммаВключаетНДС);
	КонецЦикла;
	Для каждого СТр из Объект.Услуги Цикл
		Стр.СуммаВознаграждения = Стр.Сумма*Объект.ПроцентКомиссионногоВознаграждения/100;
		Стр.СуммаНДСВознаграждения = БухгалтерскийУчетОбщиеПроцедурыКлиент.ПолучитьСуммуНДС(СТр.СуммаВознаграждения,БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Объект.СтавкаНДСВознаграждения),Объект.УчитыватьНДС,Объект.СуммаВключаетНДС);
	КонецЦикла;

	ИтогВсегоВознаграждение = Объект.Товары.Итог("СуммаВознаграждения") + ?(Объект.СуммаВключаетНДС,0, Объект.Товары.Итог("СуммаНДСВознаграждения"))
	+ Объект.Услуги.Итог("СуммаВознаграждения") + ?(Объект.СуммаВключаетНДС,0, Объект.Услуги.Итог("СуммаНДСВознаграждения"));
	ИтогВсегоНДСВознаграждения = Объект.Товары.Итог("СуммаНДСВознаграждения")+Объект.Услуги.Итог("СуммаНДСВознаграждения");
	Объект.СуммаВознаграждения = Объект.Товары.Итог("СуммаВознаграждения");
КонецПроцедуры

&НаКлиенте
Процедура ПроцентКомиссионногоВознагражденияПриИзменении(Элемент)
	
	Если Объект.УчитыватьНДС Тогда
		Если (ЗначениеЗаполнено(Объект.СтавкаНДСВознаграждения)) и Объект.ПроцентКомиссионногоВознаграждения > 0 Тогда
			РасчитатьВознаграждение();
		КонецЕсли;
	Иначе
		РасчитатьВознаграждение();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СтавкаНДСВознагражденияПриИзменении(Элемент)
	Если Объект.ПроцентКомиссионногоВознаграждения > 0 Тогда
		РасчитатьВознаграждение();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УслугиКоличествоПриИзменении(Элемент)
	СтрТЧ = Элементы.Услуги.ТекущиеДанные;
	БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуСтрокиТабличнойЧасти(СтрТЧ);
	БухгалтерскийУчетОбщиеПроцедурыКлиент.ПересчитатьСуммыНДС(СтрТЧ,Объект.УчитыватьНДС,Объект.СуммаВключаетНДС);
	РассчитатьСуммыВсегоПоДокументу();
	РасчитатьВознаграждение();
	РассчитатьСуммуПоСФ(СтрТЧ.Сумма,СтрТЧ.СуммаНДС,СтрТЧ.КлючСтроки);
КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммуПоСФ(Сумма,СуммаНДС,Ключ)
	ПараметрыОтбора = Новый Структура("КлючСтроки", Ключ);
	МассивСтрок = Объект.Покупатели.НайтиСтроки(ПараметрыОтбора);
	Если МассивСтрок.Количество() > 0 Тогда
		МассивСтрок[0].ВсегоПоСФ = Объект.Услуги.Итог("Сумма")+Объект.Товары.Итог("Сумма");//МассивСтрок[0].ВсегоПоСФ + Сумма;
		МассивСтрок[0].НДСПоСФ = Объект.Услуги.Итог("СуммаНДС")+Объект.Товары.Итог("СуммаНДС");//МассивСтрок[0].НДСПоСФ + СуммаНДС;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммыВсегоПоДокументу()
	ИтогНДСОтгрузки = ?(Объект.Товары.Количество()>0, Объект.Товары.Итог("СуммаНДС"),0)+?(Объект.Услуги.Количество()>0,Объект.Услуги.Итог("СуммаНДС"),0);
	ИтогСуммаОтгрузки = ?(Объект.Товары.Количество()>0, Объект.Товары.Итог("Сумма"),0)+ ?(Объект.Услуги.Количество()>0,Объект.Услуги.Итог("Сумма"),0)+?(Объект.СуммаВключаетНДС,0,ИтогНДСОтгрузки);
	Объект.СуммаДокумента = ИтогСуммаОтгрузки;
	Элементы.ВалютаДокументаРеализация.Заголовок = Объект.ВалютаДокумента;
	РасчитатьВознаграждение();
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	СтрТЧ = Элементы.Товары.ТекущиеДанные;
	БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуСтрокиТабличнойЧасти(СтрТЧ);
	БухгалтерскийУчетОбщиеПроцедурыКлиент.ПересчитатьСуммыНДС(СтрТЧ,Объект.УчитыватьНДС,Объект.СуммаВключаетНДС);
	РассчитатьСуммыВсегоПоДокументу();
РасчитатьВознаграждение();
РассчитатьСуммуПоСФ(СтрТЧ.Сумма,СтрТЧ.СуммаНДС,СтрТЧ.КлючСтроки);


КонецПроцедуры

