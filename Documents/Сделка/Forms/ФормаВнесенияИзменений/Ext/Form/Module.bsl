
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Сделка = Параметры.Сделка;
	НомСтр = 1;
	ТЧДоходы = Сделка.Доходы.Выгрузить();
	Для каждого Стр из ТЧДоходы Цикл
		Если Не Стр.Перевыставляемая Тогда
			НовСтр = Доходы.Добавить();
			НовСтр.НомерСтроки = НомСтр;
			ЗаполнитьЗначенияСвойств(НовСтр,Стр);
			НовСтр.СебестоимостьПосле = Стр.Себестоимость;
			НовСтр.ВознаграждениеПосле = Стр.Вознаграждение;
			НовСтр.ВалютаПосле = Стр.Валюта;
			НовСтр.СтавкаПосле = Стр.Ставка;
			НовСтр.КоличествоПосле  = Стр.Количество;
			НовСтр.СебестоимостьИтогоПосле = Стр.Себестоимость;
			НовСтр.ВознаграждениеИтогоПосле = Стр.Вознаграждение;
			НовСтр.СтавкаИтогоПосле = Стр.СтавкаИтого;
			НовСтр.СтавкаНДСПосле =  Стр.СтавкаНДС;
			НовСтр.СуммаНДСПосле = Стр.СуммаНДС;
			НовСтр.СуммаИтогоПосле  =  Стр.СуммаИтого;
			НовСтр.ПеревыставляемаяПосле  =  Стр.Перевыставляемая;
			ДокКор = НайтиДокКорректировки(СТр.УчДокумент,Сделка);
			Если ДокКор <> Неопределено Тогда
				НовСтр.ДокументКорректировки = ДокКор;
			КонецЕсли;
			Если ЗначениеЗаполнено(НовСтр.ДокументКорректировки) Тогда
				СтрКорректировки = ДокКор.Услуги.Найти(НовСтр.ГУИД,"СтрокаДоходовСделки");
				Если СтрКорректировки <> Неопределено Тогда
					
					НовСтр.СтавкаПосле = СтрКорректировки.Цена;
					НовСтр.КоличествоПосле  = СтрКорректировки.Количество;
					НовСтр.СтавкаИтогоПосле = СтрКорректировки.Сумма;
					НовСтр.СтавкаНДСПосле =  СтрКорректировки.СтавкаНДС;
					НовСтр.СуммаНДСПосле = СтрКорректировки.СуммаНДС;
					НовСтр.СуммаИтогоПосле = НовСтр.СтавкаИтогоПосле + ?(НовСтр.НДСВключенВСтоимость, 0, НовСтр.СуммаНДСПосле);
					
					
				КонецЕсли;
				ПересчитатьСуммы();
			КонецЕсли;	
			НовСтр.СебестоимостьПослеИзм = НовСтр.СебестоимостьПосле;
			НовСтр.ВознаграждениеПослеИзм = НовСтр.ВознаграждениеПосле;
			НовСтр.ВалютаПослеИзм = НовСтр.ВалютаПосле;
			НовСтр.СтавкаПослеИзм = НовСтр.СтавкаПосле;
			НовСтр.КоличествоПослеИзм  = НовСтр.КоличествоПосле;
			НовСтр.СебестоимостьИтогоПослеИЗм = НовСтр.СебестоимостьПосле;
			НовСтр.ВознаграждениеИтогоПослеИзм = НовСтр.ВознаграждениеПосле;
			НовСтр.СтавкаИтогоПослеИзм = НовСтр.СтавкаИтогоПосле;
			НовСтр.СтавкаНДСПослеИзм =  НовСтр.СтавкаНДСПосле;
			НовСтр.СуммаНДСПослеИзм = НовСтр.СуммаНДСПосле;
			НовСтр.СуммаИтогоПослеИзм  =  НовСтр.СуммаИтогоПосле;
			
		КонецЕсли;
		НомСтр = НомСтр+1;
	КонецЦикла;

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры

