&НаКлиенте
Процедура валюта_ДатаКурсаПриИзменении(Элемент)
	
	Для каждого Стр из ТЧ Цикл
		
		ПересчетСуммыИСФНаДатуСчета = ОбщегоНазначенияВызовСервера.ЗначениеРеквизитаОбъекта(Стр.ПСЦ, "ПересчетСуммыИСФНаДатуСчета");
		Если Стр.ФиксКурсВалюты > 0 
			И (СтрНайти(Стр.ВидДокумента,"Счет покупателю") > 0 
			ИЛИ ПересчетСуммыИСФнаДатуСчета) Тогда
			Стр.ДатаКурса = Дата(1,1,1);
			Стр.КурсВалюты = Стр.ФиксКурсВалюты;
			Стр.ФиксКурсВалюты = Стр.ФиксКурсВалюты;
		ИначеЕсли (СтрНайти(Стр.ВидДокумента, "Счет покупателю") > 0
			ИЛИ ПересчетСуммыИСФнаДатуСчета) Тогда 
			Стр.ДатаКурса = валюта_ДатаКурса;
			Стр.КурсВалюты = ПолучитьКурсВалютыПСЦНаДату(Стр.ДатаКурса, Стр.ПСЦ); 
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

