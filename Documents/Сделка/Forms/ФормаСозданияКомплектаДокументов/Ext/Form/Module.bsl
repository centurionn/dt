Функция НайтиУдаленныйДокументОтчетКомитентуПоСделке(Сделка, Клиент, Договор, Партия);
	НайдДокумент = Неопределено;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОтчетКомитентуОПродажах.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОтчетКомитентуОПродажах КАК ОтчетКомитентуОПродажах
	|ГДЕ
	|	ОтчетКомитентуОПродажах.Сделка = &Сделка
	|	И ОтчетКомитентуОПродажах.Контрагент = &Контрагент
	|	И ОтчетКомитентуОПродажах.ДоговорКонтрагента = &ДоговорКонтрагента
	|	И ОтчетКомитентуОПродажах.ПометкаУдаления
	|	И ОтчетКомитентуОПродажах.Поставщики.Партия = &Партия
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОтчетКомитентуОПродажах.Дата";
	Запрос.УстановитьПараметр("Сделка", Сделка);
	Запрос.УстановитьПараметр("Контрагент", Клиент);
	Запрос.УстановитьПараметр("ДоговорКонтрагента", Договор);
	Запрос.УстановитьПараметр("Партия", Партия);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		НайдДокумент = РезультатЗапроса.Выгрузить()[0].Ссылка; 	
	КонецЕсли; 
	Возврат НайдДокумент;
	
КонецФункции

&НаКлиенте
Процедура ОтправитьЭДО(Команда)
	
	//80515 Субботин 20.02.2024 начало
	Если НЕ КонтрольДоступностиДокументов_сервер.РольДоступнаВызовСервера("dc_РазрешитьОтправкуШтрафныхРТУ") Тогда 
		ШтрафныеРТУ = ПроверитьВозможностьПечатиДокументов(Истина);
		Если ШтрафныеРТУ.Количество()>0 Тогда
			ВызватьИсключение("Недостаточно прав для выполнения операции. Среди выбранных документов есть РТУ с признаком Штраф");
		КонецЕсли;
	КонецЕсли;
	//80515 Субботин 20.02.2024 Конец
	
	мКонтрагентыЭДО = Новый Массив;
	СтрокиЭДО = ТЧ.НайтиСтроки(Новый Структура("ЭДО, Пометка", Истина, Истина));
	Если СтрокиЭДО.Количество() = 0 Тогда
		Возврат;
	КонецЕсли; 
	Для каждого СтрокаЭДО Из СтрокиЭДО Цикл
		Если мКонтрагентыЭДО.Найти(СтрокаЭДО.Контрагент) = Неопределено Тогда
			мКонтрагентыЭДО.Добавить(СтрокаЭДО.Контрагент);
		КонецЕсли; 
	КонецЦикла; 
	ПараметрыОткрытия = Новый Структура("ОтборПоКонтрагенту", мКонтрагентыЭДО);
	ОткрытьФорму("Обработка.КонтурЭДО.Форма.ФормаУправляемая", ПараметрыОткрытия);
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьОтборПоОтветственному(Команда)
	Если ВидОтбораПоОтветственному = 1 Тогда
		ВидОтбораПоОтветственному = 0;
	Иначе
		ВидОтбораПоОтветственному = 1;
	КонецЕсли; 
	УстановитьПредставлениеКнопкиВидОтветственного();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьПредставлениеКнопкиВидОтветственного()
	
	Если ВидОтбораПоОтветственному = 0 Тогда
		//все ответственные
		Элементы.ТЧПереключитьОтборПоОтветственному.Картинка = БиблиотекаКартинок.ВариантыОтчетовДоступныеВсемПользователям;
		//Элементы.ТЧ.ОтборСтрок = Новый ФиксированнаяСтруктура("ОтветственныйЗаУчет", Неопределено);
		Элементы.ТЧ.ОтборСтрок = Неопределено;
		
	Иначе
		ВидОтбораПоОтветственному = 1;
		//все ответственные
		Элементы.ТЧПереключитьОтборПоОтветственному.Картинка = БиблиотекаКартинок.СостояниеПользователя08;
		Элементы.ТЧ.ОтборСтрок = Новый ФиксированнаяСтруктура("ОтветственныйЗаУчет", ПользователиКлиент.ТекущийПользователь());
	КонецЕсли; 
	СохранитьЗначениеНастройкиНаСервере("ВидОтбораПоОтветственному", ВидОтбораПоОтветственному);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьЗначениеНастройкиНаСервере(Параметр, Значение);

	ХранилищеНастроекДанныхФорм.Сохранить("СозданиеКомплектаДокументов", Параметр, Значение);
	
КонецПроцедуры

