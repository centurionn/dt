&НаСервере
Функция ПолучитьДатуКурсаИзАвансовогоСчета(АС, Выборка)
	ДатаКурса = Неопределено;
	Если АС <> Неопределено Тогда
		АСК = НайтиАвансовыйСчетПоКоносаменту(АС, Выборка.Коносамент, Выборка.ГУИД);
		Если АСК.Количество() > 0 Тогда
			СтрокаСчетАванса = АСК.Найти(Выборка.Услуга, "Номенклатура");
			Если СтрокаСчетАванса <> Неопределено Тогда
				ДатаКурса = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаСчетАванса.СчетПокупателю, "ДатаДокумента");	
			КонецЕсли; 
		КонецЕсли;
		Если ДатаКурса = Неопределено Тогда
			СтрокиАванс = Неопределено;
			СчетАвансаПоКТК = НайтиАвансовыйСчетПоКТК(АС, Выборка.Услуга, Выборка.ГУИД);
			Если СчетАвансаПоКТК.Количество() > 0 Тогда
				СтрокиАванс = АС.НайтиСтроки(Новый Структура("СчетПокупателю, Номенклатура", СчетАвансаПоКТК[0].СчетПокупателю, Выборка.Услуга));
			КонецЕсли;
			Если СтрокиАванс = Неопределено ИЛИ СтрокиАванс.Количество() = 0 Тогда
				СтрокиАванс = АС.НайтиСтроки(Новый Структура("Номенклатура", Выборка.Услуга));
			КонецЕсли; 
			Если СтрокиАванс.Количество() > 0 Тогда
				СтрокаСчетАванса = СтрокиАванс[0]; 
				ДатаКурса = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаСчетАванса.СчетПокупателю, "ДатаДокумента");
			КонецЕсли; 
		КонецЕсли;
	КонецЕсли;
	Возврат ДатаКурса;				
КонецФункции
