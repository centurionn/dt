&НаСервере
Функция НайтиАвансовыйСчетПоКТК(Авансы, Номенклатура, ГуидДоходов)
	
	ДоходыКТК = Сделка.ДоходыКТК.Найти(ГуидДоходов, "ГУИД");
	Если ДоходыКТК <> Неопределено Тогда
		//КТК = СтрЗаменить(ДоходыКТК.КТК,";","");		
		МассивНомеровКТК = СтрРазделить(ДоходыКТК.КТК, ";");
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Авансы.СчетПокупателю КАК Документ.СчетНаОплатуПокупателю) КАК СчетПокупателю,
	|	Авансы.Номенклатура КАК Номенклатура,
	|	Авансы.СуммаОстаток КАК СуммаОстаток,
	|	Авансы.СуммаОстаток КАК Сумма
	|ПОМЕСТИТЬ ВТ_Авансы
	|ИЗ
	|	&Авансы КАК Авансы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	//ДИТ, Беляев СЮ, BUG 57290 / TA 58121 (Ticket#0266962), 28-03-2023, начало
	//Убирает счета, которые сформированы с заполненным ГУИД Дохода сделки и этот ГУИД не совпадает с текущим
	//Такая потребность возникла при формировании счетов из Сделки несколькими порциями с одинаковой Услугой и Списком КТК
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СчетНаОплатуПокупателюТовары.Ссылка КАК СчетНаОплатуПокупателю
	|ПОМЕСТИТЬ ВТСчетаПоТекущейСтрокеДохода
	|ИЗ
	|	Документ.СчетНаОплатуПокупателю.Товары КАК СчетНаОплатуПокупателюТовары
	|ГДЕ
	|	СчетНаОплатуПокупателюТовары.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ_Авансы.СчетПокупателю
	|			ИЗ
	|				ВТ_Авансы КАК ВТ_Авансы)
	|	И СчетНаОплатуПокупателюТовары.Номенклатура = &Номенклатура
	|	И СчетНаОплатуПокупателюТовары.СтрокаДоходовСделки = &СтрокаДоходовСделки
	|	И СчетНаОплатуПокупателюТовары.СтрокаДоходовСделки <> """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СчетНаОплатуПокупателюТовары.Ссылка КАК СчетНаОплатуПокупателю
	|ПОМЕСТИТЬ ВТСчетаСДругимиСтрокамиДоходов
	|ИЗ
	|	Документ.СчетНаОплатуПокупателю.Товары КАК СчетНаОплатуПокупателюТовары
	|ГДЕ
	|	СчетНаОплатуПокупателюТовары.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ_Авансы.СчетПокупателю
	|			ИЗ
	|				ВТ_Авансы КАК ВТ_Авансы)
	|	И СчетНаОплатуПокупателюТовары.Номенклатура = &Номенклатура
	|	И СчетНаОплатуПокупателюТовары.СтрокаДоходовСделки <> &СтрокаДоходовСделки
	|	И СчетНаОплатуПокупателюТовары.СтрокаДоходовСделки <> """"
	|	И НЕ СчетНаОплатуПокупателюТовары.Ссылка В
	|				(ВЫБРАТЬ
	|					ВТСчетаПоТекущейСтрокеДохода.СчетНаОплатуПокупателю
	|				ИЗ
	|					ВТСчетаПоТекущейСтрокеДохода КАК ВТСчетаПоТекущейСтрокеДохода)
	//ДИТ, Беляев СЮ, BUG 57290 / TA 58121 (Ticket#0266962), 28-03-2023, конец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Авансы.СчетПокупателю КАК СчетПокупателю,
	|	ВТ_Авансы.Номенклатура КАК Номенклатура,
	|	ВТ_Авансы.СуммаОстаток КАК СуммаОстаток,
	|	ВТ_Авансы.Сумма КАК Сумма
	|ИЗ
	|	ВТ_Авансы КАК ВТ_Авансы
	|ГДЕ
	|	ВТ_Авансы.Номенклатура = &Номенклатура
	|	И ВТ_Авансы.СчетПокупателю.УчетныеЕдиницы.УчетнаяЕдиница.Наименование В(&СписокНомеровКТК)
	//ДИТ, Беляев СЮ, BUG 57290 / TA 58121 (Ticket#0266962), 28-03-2023, начало
	|	И НЕ ВТ_Авансы.СчетПокупателю В
	|				(ВЫБРАТЬ
	|					ВТСчетаСДругимиСтрокамиДоходов.СчетНаОплатуПокупателю
	|				ИЗ
	|					ВТСчетаСДругимиСтрокамиДоходов КАК ВТСчетаСДругимиСтрокамиДоходов)";
	//ДИТ, Беляев СЮ, BUG 57290 / TA 58121 (Ticket#0266962), 28-03-2023, конец
	Запрос.УстановитьПараметр("Авансы", Авансы);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("СписокНомеровКТК", МассивНомеровКТК);
	//ДИТ, Беляев СЮ, BUG 57290 / TA 58121 (Ticket#0266962), 28-03-2023, начало
	Запрос.УстановитьПараметр("СтрокаДоходовСделки", ГуидДоходов);
	//ДИТ, Беляев СЮ, BUG 57290 / TA 58121 (Ticket#0266962), 28-03-2023, конец
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выгрузить();

