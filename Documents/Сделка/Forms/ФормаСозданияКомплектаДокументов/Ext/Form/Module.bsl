Функция	ПроверитьВозможностьПечатиДокументов(ПроверкаЭДО = Ложь) 
	
	Если ПроверкаЭДО = Ложь Тогда	
		ТЗДляПечати = ТЧ.Выгрузить(Новый Структура("Пометка", Истина));
	Иначе
		ТЗДляПечати = ТЧ.Выгрузить(Новый Структура("ЭДО, Пометка", Истина, Истина));
	КонецЕсли;
	РезультатПроверки = Новый Массив;
 
	МассивРТУ = Новый Массив;
	Для Каждого Док из ТЗДляПечати Цикл
		Если ЗначениеЗаполнено(Док.СсылкаНаДокумент) И ТипЗнч(Док.СсылкаНаДокумент) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			МассивРТУ.Добавить(Док.СсылкаНаДокумент);
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ МассивРТУ.Количество() = 0 Тогда	
		Если НЕ КонтрольДоступностиДокументов_сервер.РольДоступнаВызовСервера("dc_РазрешитьОтправкуШтрафныхРТУ") Тогда
			РезультатПроверки = Документы.РеализацияТоваровУслуг.ПроверитьВозможностьПечатиРТУ(МассивРТУ);
			Если РезультатПроверки.Количество() >0 Тогда
				//ВызватьИсключение("В списке выбранных документов выбраны РТУ с признаком Штраф. Нехватает прав для выполнения данного действия");	
				Возврат РезультатПроверки
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	Возврат РезультатПроверки
	
КонецФункции

&НаКлиенте
Процедура ЗадатьВопросПользователю(ШтрафныеРТУ) 
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаОтветаПользователяПоИсключениюРТУ",
	ЭтаФорма, Новый Структура("ШтрафныеРТУ", ШтрафныеРТУ));
	ПоказатьВопрос(ОпОп,"Среди выбранных РТУ есть документы с признаком Штраф.
	|Исключить эти документы и продолжить печать?", РежимДиалогаВопрос.ОКОтмена);		
	Возврат
	
КонецПроцедуры
&НаКлиенте
Процедура ОбработкаОтветаПользователяПоИсключениюРТУ(ОтветПользователя = Неопределено, ДопПараметры = Неопределено) Экспорт
	
	Если ОтветПользователя = Неопределено Тогда Возврат; КонецЕсли; 
	Если ОтветПользователя = КодВозвратаДиалога.ОК Тогда 	
		ШтрафныеРТУ = ДопПараметры.ШтрафныеРТУ;		
		МассивПФ = УдалитьШтрафныеПакетыДокументовИзСписка(ШтрафныеРТУ);
		НапечататьКомплектДокументов(МассивПФ, Неопределено);
	КонецЕсли;	
	
КонецПроцедуры 

Функция УдалитьШтрафныеПакетыДокументовИзСписка(ШтрафныеРТУ)
	
	ТЗДляПечати = ТЧ.Выгрузить(Новый Структура("Пометка", Истина));
	Для Каждого РТУ из ШтрафныеРТУ Цикл
		СтруктураПоиска = Новый Структура("СсылкаНаДокумент", РТУ);
		СтрокиПодУдаление = ТЗДляПечати.НайтиСтроки(СтруктураПоиска);
		Если НЕ СтрокиПодУдаление = 0 Тогда
			Для каждого СтрокаПодУдаление Из СтрокиПодУдаление Цикл
				ИдентификаторШтрафоногоПакета= СтрокаПодУдаление.ИдентификаторПакета;
				СтруктураПоискаДляОчистки = Новый Структура("ИдентификаторПакета",ИдентификаторШтрафоногоПакета);
				УдаляемыеСтрокиПакета = ТЗДляПечати.НайтиСтроки(СтруктураПоискаДляОчистки);
				Для каждого СтрокаТЗ Из УдаляемыеСтрокиПакета Цикл
					ТЗДляПечати.Удалить(СтрокаТЗ);
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат ПечатьКомплектаДокументов.НапечататьКомплектНаСервере(ТЗДляПечати, Неопределено, Истина);
КонецФункции 

&НаКлиенте
Процедура НапечататьКомплектДокументов(МассивПФ, ПараметрКоманды = Неопределено) 
	
	ПечатьКомплектаДокументов.НапечататьКомплект(МассивПФ, ПараметрКоманды);
	
КонецПроцедуры

