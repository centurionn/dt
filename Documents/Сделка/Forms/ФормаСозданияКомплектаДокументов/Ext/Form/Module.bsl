Процедура УменьшитьСуммуНаВеличинуАвансовогоСчетаПоАналогичнойНоменклатуре(АС, НовДок, НовСтр)
	Если АС <> Неопределено Тогда
		СтрокиАванс = АС.НайтиСтроки(Новый Структура("Номенклатура", НовСтр.Номенклатура));
		Если СтрокиАванс.Количество() > 0 Тогда
			Для каждого СтрокаАванс Из СтрокиАванс Цикл
				ПредыдущийСчет = СтрокаАванс.СчетПокупателю;
				СуммаОстаток = СтрокаАванс.СуммаОстаток;
				СтрокаАванс.СуммаОстаток = ?(СтрокаАванс.СуммаОстаток - НовСтр.Сумма > 0, СтрокаАванс.СуммаОстаток - НовСтр.Сумма, 0);
				НовСтр.Сумма = ?(НовСтр.Сумма - СуммаОстаток > 0, НовСтр.Сумма - СуммаОстаток, 0) ;
				НовСтр.СуммаНДС = НовСтр.Сумма * БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(НовСтр.СтавкаНДС)/?(НовДок.СуммаВключаетНДС, 120, 100);
				Если НовСтр.Сумма = 0 Тогда
					Прервать;
				КонецЕсли; 
			КонецЦикла;
		КонецЕсли; 
	КонецЕсли;
КонецПроцедуры
