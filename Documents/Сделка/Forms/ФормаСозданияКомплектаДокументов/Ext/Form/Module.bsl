&НаСервереБезКонтекста
Функция СоздатьПакетПФВоВременномХранилищеНаСервере(ТЧ, МассивДокументов)
	
	//ЭтаФорма.ТЧ.Очистить();
	//Евросиб - АСуслов 18.10.2021 11:20:15 #
	//(
	//Переделал на безконтекстный вызов, ТЧ передаётся в параметре
	//)
	//Евросиб - АСуслов 18.10.2021 11:20:19 #
	ТЧ.Очистить();
	Для каждого ДокументСсылка Из МассивДокументов Цикл
		ДокСсылка = ДокументСсылка;
		СтрокаТЧ = ТЧ.Добавить();
		СтрокаТЧ.Пометка = Истина;
		СтрокаТЧ.ГруппировкаДаты = Дата(1,1,1);
		СтрокаТЧ.ВидДокумента = ДокСсылка.Метаданные().Имя;
		СтрокаТЧ.СсылкаНаДокумент = ДокСсылка;
		// ++ ДИТ_Агафонов_task 25372 06.10.2022
		//Также добавлен реквизит в ТЧ на форме
		СтрокаТЧ.СсылкаНаДокументПервоначальная = ДокСсылка;
		// -- ДИТ_Агафонов_task 25372 06.10.2022
		СтрокаТЧ.ДокументыСформированы = Истина;
		СтрокаТЧ.Контрагент = ДокСсылка.Контрагент;
		СтрокаТЧ.Договор = ДокСсылка.ДоговорКонтрагента;
		// ДИТ US 51951 TA 61497 Евсенкин М.А. Начало: 29.11.2022
		// Было:
		//СтрокаТЧ.ОтветственныйЗаУчет = СтрокаТЧ.Договор.ОтветственныйЗаУчет; 
		//Стало:
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Договор",				СтрокаТЧ.Договор);
		СтруктураПараметров.Вставить("ЦФО",					Справочники.ЦентрыФинансовойОтветственности.ОсновнойЦФО);
		СтруктураПараметров.Вставить("ТипОтветственного",	Перечисления.ТипыОтветственных.ОтветственныйЗаУчет);  
		СтрокаТЧ.ОтветственныйЗаУчет = Справочники.ДоговорыКонтрагентов.ПолучитьОтветственного(СтруктураПараметров);
		// ДИТ US 51951 TA 61497 Евсенкин М.А. Конец: 29.11.2022
	КонецЦикла;
	
	Результат = НапечататьКомплектНаСервере(ТЧ, Неопределено);
	Адрес = ПоместитьВоВременноеХранилище(Результат);
	Возврат Адрес;
	
КонецФункции

//++ДИТ Гаузер А.В. US BUG 53640, TA 56068 18.08.2022
&НаСервере
Функция ПолучитьГУИДСтрокДоходовСделки(Выборка)
	
	МассивГУИД = Новый Массив;
	ВыборкаГУИД = Выборка.Выбрать();
	Пока ВыборкаГУИД.Следующий() Цикл
		МассивГУИД.Добавить(ВыборкаГУИД.ГУИД);
	КонецЦикла;
	Возврат МассивГУИД;
		
КонецФункции

&НаСервереБезКонтекста
Функция НайтиСчетОтчетПоГУИДСтроки(МассивГУИД)
	
	СтруктураОтчетСчет = Новый Структура;
	Отчет = Неопределено;
	Счет = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|РАЗЛИЧНЫЕ
	|	ОтчетКомитентуОПродажахТовары.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОтчетКомитентуОПродажах.Товары КАК ОтчетКомитентуОПродажахТовары
	|ГДЕ
	|	ОтчетКомитентуОПродажахТовары.СтрокаДоходовСделки В (&МассивГУИД)
	|	И НЕ ОтчетКомитентуОПродажахТовары.Ссылка.ПометкаУдаления
	|";
	Запрос.УстановитьПараметр("МассивГУИД", МассивГУИД);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Отчет = Выборка.Ссылка;
	КонецЕсли;
	
	СтруктураОтчетСчет.Вставить("Отчет",Отчет);
	СтруктураОтчетСчет.Вставить("Счет",?(Отчет = Неопределено, Неопределено, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет,"СчетНаОплатуПокупателю")));
	
	Возврат СтруктураОтчетСчет;
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиУдаленныйДокументОтчетКомитентуПоГУИДСтроки(МассивГУИД);
	НайдДокумент = Неопределено;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОтчетКомитентуОПродажахТовары.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОтчетКомитентуОПродажах.Товары КАК ОтчетКомитентуОПродажахТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтчетКомитентуОПродажах КАК ОтчетКомитентуОПродажах
	|		ПО ОтчетКомитентуОПродажахТовары.Ссылка = ОтчетКомитентуОПродажах.Ссылка
	|ГДЕ
	|	ОтчетКомитентуОПродажахТовары.СтрокаДоходовСделки В &МассивГУИД
	|	И ОтчетКомитентуОПродажах.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОтчетКомитентуОПродажах.Дата";
	Запрос.УстановитьПараметр("МассивГУИД", МассивГУИД);

	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		НайдДокумент = РезультатЗапроса.Выгрузить()[0].Ссылка; 	
	КонецЕсли; 
	Возврат НайдДокумент;
	
КонецФункции
