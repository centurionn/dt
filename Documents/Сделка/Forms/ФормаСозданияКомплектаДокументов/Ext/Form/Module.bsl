					СтрокиАванс.Добавить(НайденнаяСтрока);
				КонецЦикла;
			КонецЦикла;
			//Евросиб Каблов 31.08.2023 )
			
			ДополнительноеУсловиеПоДопУслуге = Истина;
			Если ВидыФормируемыхДокументов.ЕстьАкт Тогда //при формировании Счета с Актом добавлена проверка, чтобы услуга не была дополнительной (/Евросиб - АСуслов 11.03.2022 9:45:11 #45629)
				ДополнительноеУсловиеПоДопУслуге = НЕ Выборка.УслугаВнеСтавки;
			КонецЕсли;
			Если (СтрокиАванс = Неопределено ИЛИ СтрокиАванс.Количество() = 0) И ДополнительноеУсловиеПоДопУслуге Тогда			
				СтрокиАванс = АС.НайтиСтроки(Новый Структура("Номенклатура, СуммаОстаток, СчетПокупателю", НовСтр.Номенклатура, НовСтр.Сумма, ПредыдущийСчет));				
				Если СтрокиАванс.Количество() = 0 Тогда
					//2й вариант на всю сумму счета
					СтрокиАванс = АС.НайтиСтроки(Новый Структура("Номенклатура, СуммаОстаток", НовСтр.Номенклатура, НовСтр.Сумма));				
					Если СтрокиАванс.Количество() = 0 Тогда
						//3й вариант	
						ИспользоватьПоискТолькоПоНоменклатуре = НЕ (ВидыФормируемыхДокументов.ЕстьСчет И ВидыФормируемыхДокументов.ЕстьОтчет); //для вр отключаем поиск по только номенклатуре, будет создаваться счет. (//Евросиб - АСуслов 11.03.2022 9:33:33 #45629)
						Если ИспользоватьПоискТолькоПоНоменклатуре Тогда
							СтрокиАванс = АС.НайтиСтроки(Новый Структура("Номенклатура", НовСтр.Номенклатура));
						КонецЕсли;					
					КонецЕсли; 
				КонецЕсли; 
			КонецЕсли; 			
		КонецЕсли; 

		Если СтрокиАванс <> Неопределено И СтрокиАванс.Количество() > 0 Тогда
			УбратьСчетаВыставленныеИзСделкиПоДругимДоходнымСтрокам(СтрокиАванс, НовСтр.Номенклатура, Выборка.ГУИД);
			Для каждого СтрокаАванс Из СтрокиАванс Цикл
				ПредыдущийСчет = СтрокаАванс.СчетПокупателю;
				СуммаОстаток = СтрокаАванс.СуммаОстаток;
				СтрокаАванс.СуммаОстаток = ?(СтрокаАванс.СуммаОстаток - НовСтр.Сумма > 0, СтрокаАванс.СуммаОстаток - НовСтр.Сумма, 0);
				НовСтр.Сумма = ?(НовСтр.Сумма - СуммаОстаток > 0, НовСтр.Сумма - СуммаОстаток, 0) ;
				НовСтр.СуммаНДС = НовСтр.Сумма * БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(НовСтр.СтавкаНДС)/?(НовДок.СуммаВключаетНДС, 120, 100);
				Если ПересчитатьОсновнуюТаблицуАвансов Тогда
					СтрокиАвансОсновная = АС.НайтиСтроки(Новый Структура("СчетПокупателю, Номенклатура", СтрокаАванс.СчетПокупателю, СтрокаАванс.Номенклатура));	
					СтрокиАвансОсновная[0].СуммаОстаток = СтрокаАванс.СуммаОстаток;
				КонецЕсли; 
				Если НовСтр.Сумма = 0 Тогда
					Прервать;
				КонецЕсли; 
			КонецЦикла;
		КонецЕсли; 
	КонецЕсли; 	
КонецПроцедуры
