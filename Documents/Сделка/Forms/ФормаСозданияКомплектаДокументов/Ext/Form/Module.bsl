&НаСервереБезКонтекста
Функция ПолучитьНомерДатуДокумента(СсылкаДок)
	
	РеквизитыДок = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДок, "НомерДляПечати, ДатаДокумента");
	//НомерДок = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(РеквизитыДок.Номер);
	Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(" №%1 от %2", 
																РеквизитыДок.НомерДляПечати,
																Формат(РеквизитыДок.ДатаДокумента,"ДФ=dd.MM.yyyy"));
	
КонецФункции

&НаКлиенте
Процедура ВыбратьВсе(Команда)   
	//ДИТ, Беляев СЮ, Ticket#0259010, 01-02-2022, начало
	МассивКлиентов = Новый Массив;   
	//ДИТ, Беляев СЮ, Ticket#0259010, 01-02-2022, конец
	Для каждого Стр из ТЧ Цикл
		Если Элементы.ТЧ.ПроверитьСтроку(Тч.Индекс(Стр)) Тогда
			Стр.Пометка = Истина;           
			//ДИТ, Беляев СЮ, Ticket#0259010, 01-02-2022, начало
			МассивКлиентов.Добавить(Стр.Контрагент);
			//ДИТ, Беляев СЮ, Ticket#0259010, 01-02-2022, конец
		КонецЕсли; 
	КонецЦикла;
	//ДИТ, Беляев СЮ, Ticket#0259010, 01-02-2022, начало    
	МассивКлиентов = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивКлиентов);
	Для каждого ЭлМассива Из МассивКлиентов Цикл
		ИнформироватьПользователяОПодозрительныхСтроках(ЭлМассива);		
	КонецЦикла;	  
	//ДИТ, Беляев СЮ, Ticket#0259010, 01-02-2022, конец
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометки(Команда)
	
	Для каждого Стр из ТЧ Цикл
		Если Элементы.ТЧ.ПроверитьСтроку(Тч.Индекс(Стр)) Тогда
			Стр.Пометка = Ложь;
		КонецЕсли; 
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ТЧ.Количество() = 0 Тогда
		
		ПоказатьПредупреждение(, "Все возможные файлы по этой сделке уже созданы. Проверить их Вы можете через пункт меню ""Связанные документы"".");
		Элементы.ТЧСоздатьКомплект.Доступность = Ложь;
		Элементы.ФормаНапечататьКомплект.Доступность = Ложь;
		
	КонецЕсли;
	
	РежимРаботыСКурсомВалютПриИзменении(неопределено);
	УстановитьПредставлениеКнопкиВидОтветственного(); 
	
	//ДИТ, Беляев СЮ, Ticket#0285852/BUG 57782, 09-11-2022, начало
	Если ТекстПроблемСНаборомДокументовДляФормирования.КоличествоСтрок()>0 Тогда
		строкаПредупреждения = "Обратитесь в техподдержку, по клиентам невозможно сформировать документы:
										 |"+ТекстПроблемСНаборомДокументовДляФормирования.ПолучитьТекст();
		ПоказатьПредупреждение(, строкаПредупреждения);		
	КонецЕсли;
	//ДИТ, Беляев СЮ, Ticket#0285852/BUG 57782, 09-11-2022, конец
	
КонецПроцедуры

