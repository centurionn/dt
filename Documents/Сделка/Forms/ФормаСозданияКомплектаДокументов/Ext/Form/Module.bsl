//ДИТ, Беляев СЮ, BUG 57290 / TA 58121 (Ticket#0266962), 28-03-2023, начало
//Убирает счета, которые сформированы с заполненным ГУИД Дохода сделки и этот ГУИД не совпадает с текущим
//Такая потребность возникла при формировании счетов из Сделки несколькими порциями с одинаковой Услугой и Списком КТК
Процедура УбратьСчетаВыставленныеИзСделкиПоДругимДоходнымСтрокам(СтрокиАванс, Номенклатура, ГУИДстрокиДохода)
	МассивСчетов = Новый Массив;
	Для каждого СтрокаАванс Из СтрокиАванс Цикл
		МассивСчетов.Добавить(СтрокаАванс.СчетПокупателю);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СчетНаОплатуПокупателюТовары.Ссылка КАК СчетНаОплатуПокупателю
		|ПОМЕСТИТЬ ВТСчетаПоТекущейСтрокеДохода
		|ИЗ
		|	Документ.СчетНаОплатуПокупателю.Товары КАК СчетНаОплатуПокупателюТовары
		|ГДЕ
		|	СчетНаОплатуПокупателюТовары.Ссылка В(&МассивСчетов)
		|	И СчетНаОплатуПокупателюТовары.Номенклатура = &Номенклатура
		|	И СчетНаОплатуПокупателюТовары.СтрокаДоходовСделки = &СтрокаДоходовСделки
		|	И СчетНаОплатуПокупателюТовары.СтрокаДоходовСделки <> """"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СчетНаОплатуПокупателюТовары.Ссылка КАК СчетНаОплатуПокупателю
		|ИЗ
		|	Документ.СчетНаОплатуПокупателю.Товары КАК СчетНаОплатуПокупателюТовары
		|ГДЕ
		|	СчетНаОплатуПокупателюТовары.Ссылка В(&МассивСчетов)
		|	И СчетНаОплатуПокупателюТовары.Номенклатура = &Номенклатура
		|	И СчетНаОплатуПокупателюТовары.СтрокаДоходовСделки <> &СтрокаДоходовСделки
		|	И СчетНаОплатуПокупателюТовары.СтрокаДоходовСделки <> """"
		|	И НЕ СчетНаОплатуПокупателюТовары.Ссылка В
		|				(ВЫБРАТЬ
		|					ВТСчетаПоТекущейСтрокеДохода.СчетНаОплатуПокупателю
		|				ИЗ
		|					ВТСчетаПоТекущейСтрокеДохода КАК ВТСчетаПоТекущейСтрокеДохода)";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("МассивСчетов", МассивСчетов);
	Запрос.УстановитьПараметр("СтрокаДоходовСделки", ГУИДстрокиДохода);
	
	РезультатЗапроса = Запрос.Выполнить();
	МассивСчетовДляУдаления = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("СчетНаОплатуПокупателю");
	
	КоличествоЭлементов = СтрокиАванс.Количество();
	Пока КоличествоЭлементов > 0 Цикл
		Индекс = КоличествоЭлементов - 1;
		КоличествоЭлементов = КоличествоЭлементов - 1;
		Если МассивСчетовДляУдаления.Найти(СтрокиАванс[Индекс].СчетПокупателю)=Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокиАванс.Удалить(Индекс);
	КонецЦикла;
КонецПроцедуры
//ДИТ, Беляев СЮ, BUG 57290 / TA 58121 (Ticket#0266962), 28-03-2023, конец

