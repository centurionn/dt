Процедура ДобавитьВТаблицуИнформированияПоСчетам(ТаблицаИнформированияПоСчетам, СчетНаОплатуПокупателю, НомераКТК, ФлагСчетНовый)
	СтрокаТаблицыИнформирования = ТаблицаИнформированияПоСчетам.Добавить();
	СтрокаТаблицыИнформирования.СчетНаОплатуПокупателю = СчетНаОплатуПокупателю;
	СтрокаТаблицыИнформирования.НомераКТК = НомераКТК;
	СтрокаТаблицыИнформирования.ФлагСчетНовый = ФлагСчетНовый;
КонецПроцедуры
//Евросиб(ДИТ), Беляев СЮ, US 89710/TA 89712, 27-08-2024, конец

//Евросиб(ДИТ), Беляев СЮ, US 89710/TA 89712, 27-08-2024, начало
Процедура ВывестиСообщенияОСчетах(ТаблицаИнформированияПоСчетам)
	
	ВыведеноСообщениеОСозданииСчетов = Ложь;
	Для Каждого СтрокаТаблицы Из ТаблицаИнформированияПоСчетам.НайтиСтроки(Новый Структура("ФлагСчетНовый", Истина)) Цикл
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("%1 по части ктк %2 был создан", СтрокаТаблицы.СчетНаОплатуПокупателю, СтрокаТаблицы.НомераКТК));
		ВыведеноСообщениеОСозданииСчетов = Истина;
	КонецЦикла;
	
	Если Не ВыведеноСообщениеОСозданииСчетов Тогда
		Для Каждого СтрокаТаблицы Из ТаблицаИнформированияПоСчетам.НайтиСтроки(Новый Структура("ФлагСчетНовый", Ложь)) Цикл
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон("%1 по всем ктк %2 был создан ранее", СтрокаТаблицы.СчетНаОплатуПокупателю, СтрокаТаблицы.НомераКТК));
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры
//Евросиб(ДИТ), Беляев СЮ, US 89710/TA 89712, 27-08-2024, конец

//Евросиб(ДИТ), Беляев СЮ, US 89710/TA 89712, 27-08-2024, начало
Функция ПолучитьСтруктуру_ТаблицаИнформированияПоСчетам()
	ТаблицаИнформированияПоСчетам = Новый ТаблицаЗначений;
	ТаблицаИнформированияПоСчетам.Колонки.Добавить("СчетНаОплатуПокупателю", Новый ОписаниеТипов("ДокументСсылка.СчетНаОплатуПокупателю"));
	ТаблицаИнформированияПоСчетам.Колонки.Добавить("НомераКТК", Новый ОписаниеТипов("Строка"));
	ТаблицаИнформированияПоСчетам.Колонки.Добавить("ФлагСчетНовый", Новый ОписаниеТипов("Булево"));
	
	Возврат ТаблицаИнформированияПоСчетам;
КонецФункции
//Евросиб(ДИТ), Беляев СЮ, US 89710/TA 89712, 27-08-2024, конец

//Евросиб(ДИТ), Беляев СЮ, US 89710/TA 89712, 27-08-2024, начало
Процедура УменьшитьСуммуНаВеличинуАвансовогоСчетаПоВР(НовДок, ДанныеПоАвансовымСчетам, Выборка, НовСтр, ТаблицаИнформированияПоСчетам, ПредыдущийСчет)
	ТаблицаСчетовПокупателю = ПолучитьСчетаПокупателюИмеющиеся(ДанныеПоАвансовымСчетам, Выборка.ГУИД, Выборка.Услуга, Выборка.НомераКТК, Выборка.НомераВагонов);
	Если ТаблицаСчетовПокупателю.Количество() > 0 Тогда
		Для Каждого СтрокаСчета Из ТаблицаСчетовПокупателю Цикл
			ПредыдущийСчет = СтрокаСчета.СчетПокупателю;
			НовСтр.Сумма = ?(НовСтр.Сумма - СтрокаСчета.СуммаОстаток > 0, НовСтр.Сумма - СтрокаСчета.СуммаОстаток, 0);
			НовСтр.СуммаНДС = НовСтр.Сумма * БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(НовСтр.СтавкаНДС)/?(НовДок.СуммаВключаетНДС, 120, 100);
			ДобавитьВТаблицуИнформированияПоСчетам(ТаблицаИнформированияПоСчетам, СтрокаСчета.СчетПокупателю, Выборка.НомераКТК, Ложь);
			Если НовСтр.Сумма = 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры
 //80515 Субботин 14.02.2024 Конец

