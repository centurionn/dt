&НаСервере
Функция НайтиАвансовыеСчетаПоВР(ДокументСделка, Контрагент, Договор)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КлючевыеСобытияСделки.Документ КАК Ссылка
	|ПОМЕСТИТЬ ВТ_СчетаИзСобытийСделки
	|ИЗ
	|	РегистрСведений.КлючевыеСобытияСделки КАК КлючевыеСобытияСделки
	|ГДЕ
	|	НЕ КлючевыеСобытияСделки.Услуга = &УслугаФрахт
	|	И КлючевыеСобытияСделки.Событие = ""Создание счета""
	|	И КлючевыеСобытияСделки.Сделка В
	|			(ВЫБРАТЬ
	|				составпоезда.Заявка
	|			ИЗ
	|				документ.сделка.связьучетныхединиц КАК составпоезда
	|			ГДЕ
	|				составпоезда.Ссылка = &Сделка)
	|	И КлючевыеСобытияСделки.КТК В
	|			(ВЫБРАТЬ
	|				составпоезда.Контейнер
	|			ИЗ
	|				документ.сделка.связьучетныхединиц КАК составпоезда
	|			ГДЕ
	|				составпоезда.Ссылка = &Сделка)
	|	И НЕ КлючевыеСобытияСделки.Документ.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетаПокупателейОстатки.СчетПокупателю КАК СчетПокупателю
	|ПОМЕСТИТЬ ВТ_СчетаОтбор
	|ИЗ
	|	РегистрНакопления.СчетаПокупателей.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И СчетПокупателю В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						СчетНаОплатуПокупателюДокументыОснования.Ссылка
	|					ИЗ
	|						Документ.СчетНаОплатуПокупателю.ДокументыОснования КАК СчетНаОплатуПокупателюДокументыОснования
	|					ГДЕ
	|						СчетНаОплатуПокупателюДокументыОснования.Сделка = &Сделка)
	|				И Контрагент = &Контрагент
	|				И ДоговорКонтрагента = &ДоговорКонтрагента) КАК СчетаПокупателейОстатки
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	СчетаПокупателейОстатки.СчетПокупателю
	|ИЗ
	|	РегистрНакопления.СчетаПокупателей.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И СчетПокупателю В
	|					(ВЫБРАТЬ
	|						ВТ_СчетаИзСобытийСделки.Ссылка
	|					ИЗ
	|						ВТ_СчетаИзСобытийСделки КАК ВТ_СчетаИзСобытийСделки)
	|				И Контрагент = &Контрагент
	|				И ДоговорКонтрагента = &ДоговорКонтрагента) КАК СчетаПокупателейОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетаПокупателейОстатки.СчетПокупателю КАК СчетПокупателю,
	|	СчетаПокупателейОстатки.Номенклатура КАК Номенклатура,
	|	СчетаПокупателейОстатки.СуммаОстаток КАК СуммаОстаток
	|ИЗ
	|	РегистрНакопления.СчетаПокупателей.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И СчетПокупателю В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ВТ_Отбор.СчетПокупателю
	|					ИЗ
	|						ВТ_СчетаОтбор КАК ВТ_Отбор)
	|				И Контрагент = &Контрагент
	|				И ДоговорКонтрагента = &ДоговорКонтрагента) КАК СчетаПокупателейОстатки
	|
	|УПОРЯДОЧИТЬ ПО
	|	СуммаОстаток УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СчетаОтбор.СчетПокупателю КАК СчетПокупателю,
	|	СчетНаОплатуПокупателюУчетныеЕдиницы.УчетнаяЕдиница КАК УчетнаяЕдиница,
	|	СчетНаОплатуПокупателюУчетныеЕдиницы.УчетнаяЕдиница.Наименование КАК УчетнаяЕдиницаНаименование,
	|	СчетНаОплатуПокупателюТовары.Номенклатура КАК Номенклатура
	//Евросиб(ДИТ), Беляев СЮ, BUG 106023 / TA 106025, 27-05-2025, начало
	|	,СчетНаОплатуПокупателюТовары.СтрокаДоходовСделки КАК СтрокаДоходовСделки
	//Евросиб(ДИТ), Беляев СЮ, BUG 106023 / TA 106025, 27-05-2025, конец
