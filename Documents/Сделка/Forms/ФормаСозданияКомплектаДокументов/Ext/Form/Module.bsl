&НаСервереБезКонтекста
Функция НайтиУдаленныйДокументПоСделке(Сделка, Клиент, Договор);
	НайдДокумент = Неопределено;
	Запрос = Новый Запрос;
	//Евросиб СубботинВ #84453 02.07.2024 Начало // Сделку РТУ смотрим по ТЧ УСЛУГи

	//Запрос.Текст = 
	//"ВЫБРАТЬ
	//|	РеализацияТоваровУслуг.Ссылка КАК Ссылка
	//|ИЗ
	//|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	//|ГДЕ 
	//|	РеализацияТоваровУслуг.Сделка = &Сделка 
	//|	И РеализацияТоваровУслуг.Контрагент = &Контрагент
	//|	И РеализацияТоваровУслуг.ДоговорКонтрагента = &ДоговорКонтрагента
	//|	И РеализацияТоваровУслуг.ПометкаУдаления
	//|
	//|УПОРЯДОЧИТЬ ПО
	//|	РеализацияТоваровУслуг.Дата";
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РеализацияТоваровУслугУслуги.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Услуги КАК РеализацияТоваровУслугУслуги
	|ГДЕ 
	|	РеализацияТоваровУслугУслуги.Сделка = &Сделка 
	|	И РеализацияТоваровУслугУслуги.Ссылка.Контрагент = &Контрагент
	|	И РеализацияТоваровУслугУслуги.Ссылка.ДоговорКонтрагента = &ДоговорКонтрагента
	|	И РеализацияТоваровУслугУслуги.Ссылка.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	РеализацияТоваровУслугУслуги.Ссылка.Дата";
	//Евросиб СубботинВ #84453 02.07.2024 Конец

	Запрос.УстановитьПараметр("Сделка", Сделка);
	Запрос.УстановитьПараметр("Контрагент", Клиент);
	Запрос.УстановитьПараметр("ДоговорКонтрагента", Договор);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		НайдДокумент = РезультатЗапроса.Выгрузить()[0].Ссылка; 	
	КонецЕсли; 
	Возврат НайдДокумент;
	
КонецФункции

