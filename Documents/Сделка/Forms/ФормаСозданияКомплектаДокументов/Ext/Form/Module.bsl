	//	|	СчетНаОплатуПокупателю.КомиссионныеУслуги = ИСТИНА
	//	|	И СчетНаОплатуПокупателю.Партия = &Партия";
	//	//Евросиб - АСуслов 04.10.2020 15:59:24 #
	//	//(
	//	//Запрос.УстановитьПараметр("ДокументОснование",Отчет);
	//	//Переделал на поиск по партиям
	//	Запрос.УстановитьПараметр("Партия", Партия);
	//	//)
	//	//Евросиб - АСуслов 04.10.2020 15:59:24 #
	//	Выборка = Запрос.Выполнить().Выбрать();
	//	Если Выборка.Следующий() Тогда
	//		Счет = Выборка.Ссылка;
	//	КонецЕсли;
	//КонецЕсли;
	СтруктураОтчетСчет.Вставить("Отчет",Отчет);
	СтруктураОтчетСчет.Вставить("Счет",?(Отчет = Неопределено, Неопределено, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет,"СчетНаОплатуПокупателю")));
	
	Возврат СтруктураОтчетСчет;
