&НаСервере
Функция НайтиАвансовыйСчетПоКоносаменту(Авансы, Коносамент, ГуидДоходов)
	//ДИТ, Беляев СЮ, Ticket#0267171,04-04-2022, начало
	Если НЕ ЗначениеЗаполнено(Коносамент) Тогда
		ТЗПустойРезультат = Новый ТаблицаЗначений;
		ТЗПустойРезультат.Колонки.Добавить("СчетПокупателю");
		ТЗПустойРезультат.Колонки.Добавить("Номенклатура");
		ТЗПустойРезультат.Колонки.Добавить("СуммаОстаток");
		ТЗПустойРезультат.Колонки.Добавить("Сумма"); 
		Возврат ТЗПустойРезультат;
	КонецЕсли;
	//ДИТ, Беляев СЮ, Ticket#0267171,04-04-2022, конец

	ДоходыКТК = Сделка.ДоходыКТК.Найти(ГуидДоходов, "ГУИД");
	Если ДоходыКТК <> Неопределено Тогда
		//КТК = СтрЗаменить(ДоходыКТК.КТК,";","");		
		МассивНомеровКТК = СтрРазделить(ДоходыКТК.КТК, ";");
	КонецЕсли; 

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Авансы.СчетПокупателю КАК Документ.СчетНаОплатуПокупателю) КАК СчетПокупателю,
	|	Авансы.Номенклатура КАК Номенклатура,
	|	Авансы.СуммаОстаток КАК СуммаОстаток,
	|	Авансы.СуммаОстаток КАК Сумма
	|ПОМЕСТИТЬ ВТ_Авансы
	|ИЗ
	|	&Авансы КАК Авансы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Авансы.СчетПокупателю КАК СчетПокупателю,
	|	ВТ_Авансы.Номенклатура КАК Номенклатура,
	|	ВТ_Авансы.СуммаОстаток КАК СуммаОстаток,
	|	ВТ_Авансы.Сумма КАК Сумма
	|ИЗ
	|	ВТ_Авансы КАК ВТ_Авансы
	//|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетНаОплатуПокупателю.Товары КАК СчетНаОплатуПокупателюТовары
	//|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетНаОплатуПокупателю.УчетныеЕдиницы КАК СчетНаОплатуПокупателюУчетныеЕдиницы
	//|			ПО СчетНаОплатуПокупателюТовары.Ссылка = СчетНаОплатуПокупателюУчетныеЕдиницы.Ссылка
	//|				И СчетНаОплатуПокупателюТовары.Идентификатор = СчетНаОплатуПокупателюУчетныеЕдиницы.ИдентификаторСтрокиУслуг
	//|		ПО ВТ_Авансы.СчетПокупателю = СчетНаОплатуПокупателюТовары.Ссылка
	//|			И ВТ_Авансы.Номенклатура = СчетНаОплатуПокупателюТовары.Номенклатура
	|ГДЕ
	|	ВТ_Авансы.СчетПокупателю.УчетныеЕдиницы.УчетнаяЕдиница.Наименование В(&СписокНомеровКТК)
	|	И ВТ_Авансы.СчетПокупателю.ДокументыОснования.Коносамент = &Коносамент";
	Запрос.УстановитьПараметр("Авансы", Авансы);
	Запрос.УстановитьПараметр("Коносамент", Коносамент);
	Запрос.УстановитьПараметр("СписокНомеровКТК", МассивНомеровКТК);
