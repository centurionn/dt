Функция НайтиСчетОтчетПоСделкеПартии(Сделка, Клиент, Договор, Партия)
	СтруктураОтчетСчет = Новый Структура;
	Отчет = Неопределено;
	Счет = Неопределено;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОтчетКомитентуОПродажахПоставщики.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОтчетКомитентуОПродажах.Поставщики КАК ОтчетКомитентуОПродажахПоставщики
	|ГДЕ
	|	ОтчетКомитентуОПродажахПоставщики.Ссылка.Сделка = &Сделка
	|	И ОтчетКомитентуОПродажахПоставщики.Ссылка.Контрагент = &Контрагент
	|	И ОтчетКомитентуОПродажахПоставщики.Ссылка.ДоговорКонтрагента = &ДоговорКонтрагента
	|	И ОтчетКомитентуОПродажахПоставщики.Партия = &Партия
	|	И НЕ ОтчетКомитентуОПродажахПоставщики.Ссылка.ПометкаУдаления";
	Запрос.УстановитьПараметр("Сделка",Сделка);
	Запрос.УстановитьПараметр("Контрагент",Клиент);
	Запрос.УстановитьПараметр("ДоговорКонтрагента", Договор);
	Запрос.УстановитьПараметр("Партия", Партия);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Отчет = Выборка.Ссылка;
