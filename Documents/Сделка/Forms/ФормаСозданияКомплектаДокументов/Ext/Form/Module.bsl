Процедура РаспределитьКопейкиОтСуммыРассчитаннойБезОкругления( ТЧДокумента, СуммаБезОкругления, ИмяКолонкиТЧ )
	
	МассивСумм = ТЧДокумента.ВыгрузитьКолонку(ИмяКолонкиТЧ);
	
	РаспределениеСумм = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(ОКР(СуммаБезОкругления,2), МассивСумм);

	Если РаспределениеСумм <> Неопределено Тогда
		Для ИндексСтроки = 0 По ТЧДокумента.Количество() - 1 Цикл
			СтрокаОтчета = ТЧДокумента[ИндексСтроки];
			СтрокаОтчета[ИмяКолонкиТЧ] = РаспределениеСумм[ИндексСтроки];
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры
//Евросиб(ДИТ), Беляев СЮ, BUG 110097 / TA 110115, 21-05-2025, конец
