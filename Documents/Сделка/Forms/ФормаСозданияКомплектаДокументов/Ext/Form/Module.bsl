&НаСервере
Перем СписокКТК;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//ДИТ Пак И.Т. Task34787 (Ticket#0206504) 03.06.2021 Начало
	Если Параметры.Свойство("ВызовБезОткрытияФормы") И Параметры.ВызовБезОткрытияФормы = Истина Тогда
		Возврат;
	КонецЕсли;
	//ДИТ Пак И.Т. Task34787 (Ticket#0206504) 03.06.2021 Конец
	
	Если Параметры.Свойство("ИзОбработки") Тогда
		ИзОбработки = Параметры.ИзОбработки;
		КТКВХранилище = Параметры.КТКВХранилище;
		//Евросиб Каблов 29.08.2022 ( 56025
		//РеестрКлиента = Параметры.РеестрКлиента.Наименование;
		РеестрКлиента = Параметры.РеестрКлиента;
		//Евросиб Каблов 29.08.2022 )
	// Евросиб US 82073 TA 114490 Рыбьяков К.А. 22.07.2025 ((
	ИначеЕсли Параметры.Свойство("ИзРелиза") Тогда
		ИзРелиза = Параметры.ИзРелиза;
		КТКВХранилище = Параметры.КТКВХранилище;
		РеестрКлиента = Параметры.РеестрКлиента;
		РелизСобственника = Параметры.РелизСобственника;
		//Сделка = Параметры.Сделка;
		// Евросиб Рыбьяков К.А. 22.07.2025 ))
	ИначеЕсли Параметры.Свойство("Повагонка") Тогда
		Повагонка = Истина;
		ТЗ_Данные = Параметры.МассивСтрок;
		Для Каждого Эл Из ТЗ_Данные Цикл
			Если СписокСделокПовагонки.НайтиПоЗначению(Эл.Сделка) = Неопределено Тогда
				СписокСделокПовагонки.Добавить(Эл.Сделка);
			КонецЕсли;
		КонецЦикла;	
	Иначе
		Сделка = Параметры.Сделка;
	КонецЕсли;
	//Если ИзОбработки = Неопределено Тогда
	//Евросиб(ДИТ), Беляев СЮ, US 88163/TA 88167, 26-07-2024, начало
	// Евросиб US 82073 TA 114490 Рыбьяков К.А. 22.07.2025 (( добавил НЕ ИзРелиза
	Если НЕ ИзОбработки И НЕ ИзРелиза Тогда
	//Евросиб(ДИТ), Беляев СЮ, US 88163/TA 88167, 26-07-2024, конец
		МассивСтруктур = ПолучитьИзВременногоХранилища(Параметры.АдресХранилищаСчетовПоКоносаментам);
		ЭтаФорма.ВыставленныеКоносаменты.Очистить();
		Для каждого СтрокаМассива Из МассивСтруктур Цикл
			нСтрока = ЭтаФорма.ВыставленныеКоносаменты.Добавить();
			ЗаполнитьЗначенияСвойств(нСтрока, СтрокаМассива);
		КонецЦикла; 
		МассивСтруктур = ПолучитьИзВременногоХранилища(Параметры.АдресХранилищаСчетовПоЖД);
		ЭтаФорма.ВыставленныеЖД.Очистить();
		Для каждого СтрокаМассива Из МассивСтруктур Цикл
			нСтрока = ЭтаФорма.ВыставленныеЖД.Добавить();
			ЗаполнитьЗначенияСвойств(нСтрока, СтрокаМассива);
		КонецЦикла; 
	КонецЕсли; 
	//ДИТ, Беляев СЮ, Ticket#0259010, 31-01-2022, начало
	Если Параметры.Свойство("АдресХранилищаСтрокБезКалькуляций") Тогда
		МассивСтруктур = ПолучитьИзВременногоХранилища(Параметры.АдресХранилищаСтрокБезКалькуляций);
		Для каждого СтрокаМассива Из МассивСтруктур Цикл
			нСтрока = ЭтаФорма.ПодозрительныеСтрокиБезПравил.Добавить();
			ЗаполнитьЗначенияСвойств(нСтрока, СтрокаМассива);	
		КонецЦикла;
	КонецЕсли;
	//ДИТ, Беляев СЮ, Ticket#0259010, 31-01-2022, конец
	
	ПараметрыГалок = Новый Соответствие;
	Если Параметры.Свойство("ПараметрыГалок") Тогда ПараметрыГалок = Параметры.ПараметрыГалок; КонецЕсли;
	ДоступностьКнопкиЭДО = Ложь;
	МассивСтрок = Параметры.МассивСтрок;
	ДатаКурсаСчета = Неопределено;
	КурсСчета = Неопределено;
	
	//ДИТ, Беляев СЮ, Ticket#0285852/BUG 57782, 09-11-2022, начало
	МассивКлиентовБезВидовДокументовДляФормирования = Новый Массив;
	//ДИТ, Беляев СЮ, Ticket#0285852/BUG 57782, 09-11-2022, конец
	
	Для каждого Эл из МассивСтрок Цикл
		РеквизитыПСЦ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Эл.ПСЦ, "ФиксКурсВалюты, ПересчетСуммыИСФнаДатуСчета");
				
		//ДИТ, Беляев СЮ, Ticket#0285852/BUG 57782, 09-11-2022, начало
		Если Эл.СписокДокументов = Неопределено Тогда
			МассивКлиентовБезВидовДокументовДляФормирования.Добавить(Эл.Клиент);
			Продолжить;
		КонецЕсли;
		//ДИТ, Беляев СЮ, Ticket#0285852/BUG 57782, 09-11-2022, конец
		
		Для каждого ВД из Эл.СписокДокументов Цикл
			// ДИТ Поморцева Т.П. Задача 0233013 31.05.21. Начало
			Если ЗначениеЗаполнено(РеквизитыПСЦ.ПересчетСуммыИСФнаДатуСчета)				
			// ДИТ Поморцева Т.П. Задача 0233013 31.05.21. Конец
				И РеквизитыПСЦ.ПересчетСуммыИСФнаДатуСчета 
				И ВД.ВидДокумента = "Счет покупателю" 
				И ЗначениеЗаполнено(ВД.Документ) Тогда
				ДатаКурсаСчета = ВД.Документ.ДатаКурса;
				КурсСчета = ВД.Документ.КурсВзаиморасчетов;
			КонецЕсли; 
		КонецЦикла;
		
		Для каждого ВД из Эл.СписокДокументов Цикл
			
			НСтр = ТЧ.Добавить();
			НСтр.ДополнительныеУслуги = ?(Эл.Свойство("УслугаВнеСтавки"), Эл.УслугаВнеСтавки, Неопределено);
			нСтр.ГУИД = ?(Эл.Свойство("ГУИД"), Эл.ГУИД, "");
			нСтр.ГруппировкаДаты = ?(Эл.Свойство("ПериодВО"), Эл.ПериодВО, Дата(1,1,1));
			//НСтр.ВидДокумента = ВД;
			НСтр.ВидДокумента = ВД.ВидДокумента;
			//Евросиб СубботинВ #122887 14.11.2025 Начало 
			Если ТипЗнч(ВД.Документ) = Тип("ДокументСсылка.РеализацияТоваровУслуг") и Не ЗначениеЗаполнено(валюта_ДатаКурса) Тогда 
				 валюта_ДатаКурса = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВД.Документ, "ДатаДокумента");
			КонецЕсли;
			//Евросиб СубботинВ #122887 14.11.2025 Конец			
			нСтр.ДатаВыставления = ВД.ДатаВыставления;
			НСтр.ИдентификаторПакета = ВД.ИдентификаторПакета;
			НСтр.СсылкаНаДокумент = ВД.Документ;
			нСтр.ДокументыСформированы = ЗначениеЗаполнено(ВД.Документ);
			НСтр.Контрагент = Эл.Клиент; 
			Нстр.ЭтоФрахт = ВД.ЭтоФрахт;
			нСтр.ЭДО = Обработки.ДД_подключаемыйМодуль.ЕстьЭДОСКонтрагентом(Эл.Клиент);   
			//ДИТ, Беляев СЮ, Ticket#0252121, 22-12-2021 ++
			НСтр.ДокументФФД = Эл.ДокументФФД;             
			//ДИТ, Беляев СЮ, Ticket#0252121, 22-12-2021 --
			ВД.Свойство("Коносамент", НСтр.Коносамент);
			Если нСтр.ЭДО Тогда
				ДоступностьКнопкиЭДО = Истина;
			КонецЕсли; 
			НСтр.Договор = Эл.Договор;
			//Евросиб Каблов 12.09.2023 ( #68187
			Если Эл.Свойство("ЭтоСНП") Тогда
				НСтр.ЭтоСНП = Эл.ЭтоСНП;
			КонецЕсли;
			//Евросиб Каблов 12.09.2023 )
			// ДИТ US 51951 TA 61497 Евсенкин М.А. Начало: 29.11.2022
			// Было:
			//нСтр.ОтветственныйЗаУчет = эл.Договор.ОтветственныйЗаУчет; 
			//Стало: 
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("Договор",				эл.Договор);
			СтруктураПараметров.Вставить("ЦФО",					Справочники.ЦентрыФинансовойОтветственности.ОсновнойЦФО);
			СтруктураПараметров.Вставить("ТипОтветственного",	Перечисления.ТипыОтветственных.ОтветственныйЗаУчет);  
			нСтр.ОтветственныйЗаУчет = Справочники.ДоговорыКонтрагентов.ПолучитьОтветственного(СтруктураПараметров);
			// ДИТ US 51951 TA 61497 Евсенкин М.А. Конец: 29.11.2022
			
			ПараметрыТекСтроки = ПараметрыГалок.Получить(НСтр.Договор);
			Если ПараметрыТекСтроки <> неопределено Тогда
				НСтр.ГотовоКВыставлению = ПараметрыТекСтроки.ГотовоКВыставлению;
				//НСтр.ДокументыСформированы = ПараметрыТекСтроки.ДокументыСформированы;
				//НСтр.Пометка = (НСтр.ГотовоКВыставлению = Истина И НСтр.ДокументыСформированы = ЛОЖЬ И ПараметрыТекСтроки.ДокументыДляМеня = Истина);
			КонецЕсли;
			
			НСтр.ПСЦ = Эл.ПСЦ;
			// Евросиб US 82073 TA 114490 Рыбьяков К.А. 22.07.2025 ((
			//НСтр.СтавкаНДС = ?(Параметры.Свойство("ИзОбработки"), Неопределено, Эл.СтавкаНДС);
			Если Параметры.Свойство("ИзОбработки") Или Параметры.Свойство("ИзРелиза") Тогда
				НСтр.СтавкаНДС = Неопределено;
			Иначе
				НСтр.СтавкаНДС = Эл.СтавкаНДС;
			КонецЕсли;
			//НСтр.СтавкаНДС = ?(Параметры.Свойство("ИзОбработки"), Неопределено, Эл.СтавкаНДС);
			// Евросиб Рыбьяков К.А. 22.07.2025 ))
			// ДИТ Поморцева Т.П. Задача 0233013 31.05.21. Начало
			Если ЗначениеЗаполнено(РеквизитыПСЦ.ФиксКурсВалюты)
			// ДИТ Поморцева Т.П. Задача 0233013 31.05.21. Конец
				И РеквизитыПСЦ.ФиксКурсВалюты > 0 
				И (ВД.ВидДокумента = "Счет покупателю" 
					ИЛИ РеквизитыПСЦ.ПересчетСуммыИСФнаДатуСчета) Тогда
				нСтр.ДатаКурса = Дата(1,1,1);
				нСтр.КурсВалюты = РеквизитыПСЦ.ФиксКурсВалюты;
				нСтр.ФиксКурсВалюты = РеквизитыПСЦ.ФиксКурсВалюты;
			ИначеЕсли СтрНайти(ВД.ВидДокумента, "Счет покупателю") > 0
				И ЗначениеЗаполнено(ВД.Документ) Тогда
				нСтр.ДатаКурса = ВД.Документ.ДатаКурса;
				нСтр.КурсВалюты = ВД.Документ.КурсВзаиморасчетов;
				// ДИТ Поморцева Т.П. Задача 0233013 31.05.21. Начало
			ИначеЕсли ЗначениеЗаполнено(РеквизитыПСЦ.ПересчетСуммыИСФнаДатуСчета)
				// ДИТ Поморцева Т.П. Задача 0233013 31.05.21. Конец
				И (РеквизитыПСЦ.ПересчетСуммыИСФнаДатуСчета)
				И ЗначениеЗаполнено(КурсСчета) Тогда
				нСтр.ДатаКурса = ДатаКурсаСчета;
				нСтр.КурсВалюты = КурсСчета;
			Иначе
				нСтр.ДатаКурса = ВД.ДатаВыставления;
				нСтр.КурсВалюты = ПолучитьКурсВалютыПСЦНаДату(нСтр.ДатаКурса, нСтр.ПСЦ); 
			КонецЕсли; 
			Если Повагонка Тогда
				НСтр.ГУИД = Эл.ГУИД;
				НСтр.Сделка = Эл.Сделка;
			КонецЕсли;
			//Док = НайтиРанееСозданныеДокументыПоВидуДокумента(Эл.Клиент,Эл.Договор,ВД,Сделка);
			//Если Док <> Неопределено Тогда
			//	НСтр.СсылкаНаДокумент = Док;
			//	НСтр.СуммаДокумента = Док.СуммаДокумента;
			//КонецЕсли;
			//ДИТ Давудов М.А. Task32744 03.07.2021 Начало
			Если ТипЗнч(ВД) = Тип("Структура")
			   И ВД.Свойство("CreditNote") Тогда
				НСтр.CreditNote = ВД.CreditNote;	
			КонецЕсли;
			//ДИТ Давудов М.А. Task32744 03.07.2021 Конец   
			// ДИТ US 72708 ТА 72713 Сержантова А.С. Начало: 20.09.2023
			//НСтр.СсылкаНаДокументПервоначальная = Эл.УчДокумент;
			//ДИТ, Беляев СЮ, Ticket#0325648, 26-09-2023, начало
			НСтр.СсылкаНаДокументПервоначальная = ?(Эл.Свойство("УчДокумент"), Эл.УчДокумент, "");
			//ДИТ, Беляев СЮ, Ticket#0325648, 26-09-2023, конец
			// ДИТ US 72708 ТА 72713 Сержантова А.С. Конец: 20.09.2023
			//Евросиб(ДИТ), Беляев СЮ, US 88163/TA 88167, 26-07-2024, начало
			НСтр.ИдентификаторГруппировки = ?(Эл.Свойство("ИдентификаторГруппировки"), Эл.ИдентификаторГруппировки, "");
			//Евросиб(ДИТ), Беляев СЮ, US 88163/TA 88167, 26-07-2024, конец
			// Евросиб US 82073 TA 115104 Рыбьяков К.А. 09.09.2025 ((
			НСтр.ИзРелиза = Эл.ИзРелиза;
			НСтр.РелизСобственника = Эл.РелизСобственника;
			// Евросиб Рыбьяков К.А. 09.09.2025 ))
		КонецЦикла;
	КонецЦикла;
			
	//Для каждого КА из Параметры.Контрагенты Цикл
	//	Для каждого ВД из Параметры.ВидыДокументов Цикл
	//		
	//		НСтр = ТЧ.Добавить();
	//		НСтр.ВидДокумента = ВД;
	//		НСтр.Контрагент = КА;
	//		Док = НайтиРанееСозданныеДокументыПоВИдуДокумента(ВД);
	//	КонецЦикла;
	//КонецЦикла;
	
//Евросиб Гудкова( 03.01.2021 
	ЭтаФорма.Заголовок = Сделка;
// Евросиб Гудкова)
	ВидОтбораПоОтветственному = ХранилищеНастроекДанныхФорм.Загрузить("СозданиеКомплектаДокументов", "ВидОтбораПоОтветственному");
	
	//ДИТ, Беляев СЮ, Ticket#0285852/BUG 57782, 09-11-2022, начало
	Взаимодействия.УдалитьПовторяющиесяЭлементыМассива(МассивКлиентовБезВидовДокументовДляФормирования);
	Для Каждого ЭлМассива Из МассивКлиентовБезВидовДокументовДляФормирования Цикл
		ТекстПроблемСНаборомДокументовДляФормирования.ДобавитьСтроку("   - "+ЭлМассива);
	КонецЦикла;
	//ДИТ, Беляев СЮ, Ticket#0285852/BUG 57782, 09-11-2022, конец

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
	
	////Евросиб СубботинВ #122887 14.11.2025 Начало
	//ОткрытыйПериодБУ = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериодБУ();
	//ДатаСделки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сделка, "Дата");
	//Если ДатаСделки < ОткрытыйПериодБУ или НЕ КонтрольДоступностиДокументов_сервер.РольДоступнаВызовСервера("dc_РаботаСДокументамиКлиентов") Тогда
	//	Элементы.валюта_ДатаКурса.Доступность = Ложь;
	//КонецЕсли; 	
	////Евросиб СубботинВ #122887 14.11.2025 Конец

КонецПроцедуры
//Евросиб Коханенко Н.А. #61705 09.12.2022 )


&НаСервереБезКонтекста
Функция НайтиРанееСозданныеДокументыПоВИдуДокумента(Контрагент, ДоговорКонтрагента, ВидДокумента, Сделка)
	
	Запрос = Новый Запрос;
	
	Если ВидДокумента = "Счет покупателю" Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	СчетНаОплатуПокупателю.Ссылка КАК Ссылка
		               |ИЗ
		               |	Документ.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю
		               |ГДЕ
		               |	СчетНаОплатуПокупателю.Контрагент = &Контрагент
		               |	И СчетНаОплатуПокупателю.ДоговорКонтрагента = &ДоговорКонтрагента
		               |	И СчетНаОплатуПокупателю.Сделка = &Сделка
		               |	И СчетНаОплатуПокупателю.АвансовыйСчет = ЛОЖЬ";
		
	ИначеЕсли ВидДокумента = "Реализация товаров и услуг" Тогда 
		//Евросиб СубботинВ #84453 02.07.2024 Начало // Сделку РТУ смотрим по ТЧ УСЛУГ
		//Запрос.Текст = "ВЫБРАТЬ
		//               |	РеализацияТоваровУслуг.Ссылка КАК Ссылка
		//               |ИЗ
		//               |	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		//               |ГДЕ
		//               |	РеализацияТоваровУслуг.Контрагент = &Контрагент
		//               |	И РеализацияТоваровУслуг.ДоговорКонтрагента = &ДоговорКонтрагента
		//			   |	И РеализацияТоваровУслуг.Сделка = &Сделка";
					   
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
					   |	РеализацияТоваровУслугУслуги.Ссылка КАК Ссылка
		               |ИЗ
		               |	Документ.РеализацияТоваровУслуг.Услуги КАК РеализацияТоваровУслугУслуги
		               |ГДЕ
		               |	РеализацияТоваровУслугУслуги.Ссылка.Контрагент = &Контрагент
		               |	И РеализацияТоваровУслугУслуги.Ссылка.ДоговорКонтрагента = &ДоговорКонтрагента
		               |	И РеализацияТоваровУслугУслуги.Сделка = &Сделка
					   |";
		 //Евросиб СубботинВ #84453 02.07.2024 Конец 
		
	ИначеЕсли  ВидДокумента = "Отчет комитенту о закупках" Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	ОтчетКомитентуОПродажах.Ссылка КАК Ссылка
		               |ИЗ
		               |	Документ.ОтчетКомитентуОПродажах КАК ОтчетКомитентуОПродажах
		               |ГДЕ
		               |	ОтчетКомитентуОПродажах.Контрагент = &Контрагент
		               |	И ОтчетКомитентуОПродажах.ДоговорКонтрагента = &ДоговорКонтрагента
		               |	И ОтчетКомитентуОПродажах.Сделка = &Сделка";
	ИначеЕсли ВидДокумента = "Счет-фактура выданный" Тогда
	    Запрос.Текст = "ВЫБРАТЬ
	                   |	СчетФактураВыданный.Ссылка КАК Ссылка
	                   |ИЗ
	                   |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	                   |ГДЕ
	                   |	СчетФактураВыданный.ДоговорКонтрагента = &ДоговорКонтрагента
	                   |	И СчетФактураВыданный.Контрагент = &Контрагент
	                   |	И СчетФактураВыданный.ДокументОснование.Сделка = &Сделка";
	КонецЕсли;
	Запрос.УстановитьПараметр("Контрагент",Контрагент);
	Запрос.УстановитьПараметр("ДоговорКонтрагента",ДоговорКонтрагента);
	Запрос.УстановитьПараметр("Сделка",Сделка);
	
	Рез = Запрос.Выполнить().Выбрать();
	Если Рез.Следующий() Тогда
		Возврат Рез.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
		
КонецФункции

