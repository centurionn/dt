&НаСервере
Процедура ЗаполнитьСчетаНаОплатуПокупателямАкта(АС, Выборка, НовАкт, нСтр, ПредыдущийСчет)
	Если АС <> Неопределено Тогда
		ОстатокСуммы = нСтр.Сумма;
		АСК = НайтиАвансовыйСчетПоКоносаменту(АС, Выборка.Коносамент, Выборка.ГУИД);
		ПересчитатьОсновнуюТаблицуАвансов = Ложь;
		СтрокиСчетов = Неопределено;
		Если АСК.Количество() > 0 Тогда
			СтрокиСчетов = АСК.НайтиСтроки(Новый Структура("Номенклатура", нСтр.Номенклатура));
			ПересчитатьОсновнуюТаблицуАвансов = Истина;
		КонецЕсли; 
		Если СтрокиСчетов = Неопределено ИЛИ СтрокиСчетов.Количество() = 0 Тогда
			СчетАвансаПоКТК = НайтиАвансовыйСчетПоКТК(АС, Выборка.Услуга, Выборка.ГУИД);
			Если СчетАвансаПоКТК.Количество() > 0 Тогда
				СтрокиСчетов = Новый Массив;
				Для каждого СтрокаСчетАвансаПоКТК Из СчетАвансаПоКТК Цикл
					НайдСтрокиСчетов = АС.НайтиСтроки(Новый Структура("СчетПокупателю, Номенклатура", СтрокаСчетАвансаПоКТК.СчетПокупателю, Выборка.Услуга));
					Для каждого найдСтрокаСчетов Из НайдСтрокиСчетов Цикл
						СтрокиСчетов.Добавить(найдСтрокаСчетов);
					КонецЦикла; 
				КонецЦикла; 
			КонецЕсли;
			//приоритетный вариант - сумма на всю сумму счета, учитывая предыдущий счет, чтобы выбирать сумму из одного и того же счета
			Если СтрокиСчетов = Неопределено ИЛИ СтрокиСчетов.Количество() = 0 Тогда
				СтрокиСчетов = АС.НайтиСтроки(Новый Структура("Номенклатура, СуммаОстаток, СчетПокупателю", Выборка.Услуга, ОстатокСуммы, ПредыдущийСчет));
				//если сумма по счету не нашлась, то тогда по полному остатку суммы
				Если СтрокиСчетов.Количество() = 0 Тогда
					СтрокиСчетов = АС.НайтиСтроки(Новый Структура("Номенклатура, СуммаОстаток", Выборка.Услуга, ОстатокСуммы));
					//по услуге и счету
					Если СтрокиСчетов.Количество() = 0 Тогда
						СтрокиСчетов = АС.НайтиСтроки(Новый Структура("Номенклатура, СчетПокупателю", Выборка.Услуга, ПредыдущийСчет));
						//по услуге
						Если СтрокиСчетов.Количество() = 0 Тогда
							СтрокиСчетов = АС.НайтиСтроки(Новый Структура("Номенклатура", Выборка.Услуга));
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли; 
		КонецЕсли; 
		
		Для каждого СтрокаСчетов Из СтрокиСчетов Цикл
			Если СтрокаСчетов.СуммаОстаток > 0 Тогда
				ПредыдущийСчет = СтрокаСчетов.СчетПокупателю;
				нСтр.СчетНаОплатуПокупателю = СтрокаСчетов.СчетПокупателю;
				Если ОстатокСуммы <= СтрокаСчетов.СуммаОстаток Тогда
					СуммаСчета = ОстатокСуммы;
					СтрокаСчетов.СуммаОстаток = СтрокаСчетов.СуммаОстаток - ОстатокСуммы;
					ОстатокСуммы = 0;
				Иначе
					СуммаСчета = СтрокаСчетов.СуммаОстаток;
					ОстатокСуммы = ОстатокСуммы - СтрокаСчетов.СуммаОстаток;
				КонецЕсли; 
				//добавим в тч счета
				нСчет = НовАкт.СчетаНаОплатуПокупателям.Добавить();
				нСчет.Номенклатура = нСтр.Номенклатура;
				//Евросиб Каблов 28.11.2025 ( #111016
				//нСчет.Сделка = Сделка;
				//Евросиб Каблов 28.11.2025 ) #111016
				нСчет.СчетПокупателю = СтрокаСчетов.СчетПокупателю;
				нСчет.Сумма = СуммаСчета;
				//конец добавки
				Если ПересчитатьОсновнуюТаблицуАвансов Тогда
					СтрокиАвансОсновная = АС.НайтиСтроки(Новый Структура("СчетПокупателю, Номенклатура", СтрокаСчетов.СчетПокупателю, СтрокаСчетов.Номенклатура));	
					СтрокиАвансОсновная[0].СуммаОстаток = СтрокаСчетов.СуммаОстаток;
				КонецЕсли; 
				Если ОстатокСуммы = 0 Тогда
					Прервать;
				КонецЕсли; 
			КонецЕсли; 
		КонецЦикла; 
	КонецЕсли;	 	
КонецПроцедуры
