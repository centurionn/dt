Функция СоздатьНовыйСчетНаОплату(ПараметрыФФД, ДатаВыставленияДокументов)
	НовДок = Документы.СчетНаОплатуПокупателю.СоздатьДокумент();
	//Евросиб Каблов 12.09.2023 ( #68187
	НовДок.УстановитьСсылкуНового(Документы.СчетНаОплатуПокупателю.ПолучитьСсылку());
	//Евросиб Каблов 12.09.2023 )
	НовДок.Заполнить(Неопределено);
	НовДок.Дата = ТекущаяДата();
	//НовДок.ДатаДокумента = ТекущаяДата();
	Если ПараметрыФФД <> Неопределено 
		И ПараметрыФФД.ВыставлятьЗакрывающиеСчетаТекущейДатой = Истина Тогда
		НовДок.ДатаДокумента = ТекущаяДата();
	Иначе
		НовДок.ДатаДокумента = ДатаВыставленияДокументов;
	КонецЕсли; 
	//Евросиб Гудкова( 03.01.2021 Ticket№ 0218868
	Если Год(НовДок.ДатаДокумента) <> Год(НовДок.Дата) Тогда
		//НовДок.Дата = НовДок.ДатаДокумента;				
		//ДИТ, Беляев СЮ, Ticket#0297095, 11-01-2023, начало
		НовДок.Дата = КонецМесяца(НовДок.ДатаДокумента);
		//ДИТ, Беляев СЮ, Ticket#0297095, 11-01-2023, конец
		НовДок.УстановитьНовыйНомер();
	КонецЕсли; 
	// Евросиб Гудкова)
	//Евросиб Каблов 09.04.2025 ( #105407
	//НовДок.ПериодВО = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериод(НовДок.Организация);
	НовДок.ПериодВО = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериодДоходов(НовДок.Организация);
	//Евросиб Каблов 09.04.2025 )
	Возврат НовДок;
КонецФункции

