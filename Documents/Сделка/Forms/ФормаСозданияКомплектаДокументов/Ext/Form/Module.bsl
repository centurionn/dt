&НаКлиенте
Процедура ТЧПометкаПриИзменении(Элемент)
	ТД = Элементы.ТЧ.ТекущиеДанные;
	//Если НЕ ТД.ГотовоКВыставлению Тогда
	//	Сообщить("Можно выделять строки только готовые к выставлению");
	//	ТД.Пометка = Не ТД.Пометка;
	//КонецЕсли; 
	Если ТД.ВидДокумента = "Реализация товаров и услуг" Тогда
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Контрагент", ТД.Контрагент);
		СтруктураОтбора.Вставить("Договор", ТД.Договор);
		СтруктураОтбора.Вставить("ВидДокумента", "Счет покупателю");
		СтруктураОтбора.Вставить("ИдентификаторПакета", ТД.ИдентификаторПакета);
		Если ТД.Пометка Тогда
			МассивСтрок = ТЧ.НайтиСтроки(СтруктураОтбора);
			Если МассивСтрок.Количество() > 0  Тогда
				МассивСтрок[0].ПОметка = ТД.Пометка;
			КонецЕсли;
		КонецЕсли;
		Если не ТД.Пометка Тогда
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Контрагент", ТД.Контрагент);
			СтруктураОтбора.Вставить("Договор", ТД.Договор);
			СтруктураОтбора.Вставить("ВидДокумента", "Счет-фактура выданный");
			МассивСтрок = ТЧ.НайтиСтроки(СтруктураОтбора);
			
			Если МассивСтрок.Количество() > 0  Тогда
				Если МассивСтрок[0].Пометка Тогда
					Сообщить("В системе запрещено создание счетов-фактур без первичного документа.");
					ТД.Пометка = Истина;




				КонецЕсли;
			КонецЕсли;
		КонецЕсли;


	КонецЕсли;	
	
	Если ТД.ВидДокумента = "Счет покупателю" Тогда
		Если Не ТД.Пометка Тогда
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Контрагент", ТД.Контрагент);
			СтруктураОтбора.Вставить("Договор", ТД.Договор);
			СтруктураОтбора.Вставить("ВидДокумента", "Реализация товаров и услуг" );
			СтруктураОтбора.Вставить("ИдентификаторПакета", ТД.ИдентификаторПакета);
			МассивСтрок = ТЧ.НайтиСтроки(СтруктураОтбора);
			Если МассивСтрок.Количество()>0 Тогда
				Если МассивСтрок[0].Пометка Тогда
					Сообщить("В системе запрещено создание актов без счетов на оплату.");
					ТД.Пометка = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ТД.ВидДокумента = "Счет-фактура выданный" Тогда
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Контрагент", ТД.Контрагент);
		СтруктураОтбора.Вставить("Договор", ТД.Договор);
		СтруктураОтбора.Вставить("ИдентификаторПакета", ТД.ИдентификаторПакета);
		Если ТД.Пометка Тогда
			МассивСтрок = ТЧ.НайтиСтроки(СтруктураОтбора);
			Если МассивСтрок.Количество() > 0  Тогда
				Для каждого Эл Из МассивСтрок Цикл
				Если Эл.ВидДокумента <> "Реализация товаров и услуг" Тогда
					Эл.Пометка = ТД.Пометка;
				ИначеЕсли Эл.ВидДокумента <> "Отчет комитенту о закупках" Тогда
					Эл.Пометка = ТД.Пометка;
				КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;




	КонецЕсли;	
	
	Если ТД.ВидДокумента = "Отчет комитенту о закупках" Тогда
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Контрагент", ТД.Контрагент);
		СтруктураОтбора.Вставить("Договор", ТД.Договор);
		СтруктураОтбора.Вставить("ВидДокумента", "Счет покупателю");
		СтруктураОтбора.Вставить("ИдентификаторПакета", ТД.ИдентификаторПакета);
		Если ТД.Пометка Тогда
			МассивСтрок = ТЧ.НайтиСтроки(СтруктураОтбора);
			Если МассивСтрок.Количество() > 0  Тогда
				МассивСтрок[0].ПОметка = ТД.Пометка;
			КонецЕсли;
		КонецЕсли;
		Если Не ТД.Пометка Тогда
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Контрагент", ТД.Контрагент);
			СтруктураОтбора.Вставить("Договор", ТД.Договор);
			СтруктураОтбора.Вставить("ВидДокумента", "Счет-фактура выданный" );
			МассивСтрок = ТЧ.НайтиСтроки(СтруктураОтбора);
			Если МассивСтрок.Количество()>0 Тогда
				Если МассивСтрок[0].Пометка Тогда
					Сообщить("В системе запрещено создание счетов-фактур без первичного документа.");
					ТД.Пометка = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	//ДИТ, Беляев СЮ, Ticket#0259010, 01-02-2022, начало
	ИнформироватьПользователяОПодозрительныхСтроках(ТД.Контрагент); 
	//ДИТ, Беляев СЮ, Ticket#0259010, 01-02-2022, конец
КонецПроцедуры

