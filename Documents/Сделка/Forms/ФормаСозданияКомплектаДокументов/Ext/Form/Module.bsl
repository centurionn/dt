Функция НайтиАктПоКоносаменту(Коносамент, Сделка)
	
	Акт = Неопределено;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РеализацияТоваровУслугУслуги.Ссылка КАК Ссылка,
	|	СделкаДоходы.Коносамент КАК Коносамент,
	|	РеализацияТоваровУслугУслуги.Ссылка.Организация КАК Организация,
	|	РеализацияТоваровУслугУслуги.Ссылка.ДатаДокумента КАК ДатаДокумента
	|ИЗ
	|	Документ.Сделка.Доходы КАК СделкаДоходы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Услуги КАК РеализацияТоваровУслугУслуги
	|		ПО СделкаДоходы.УчДокумент = РеализацияТоваровУслугУслуги.Ссылка
	|			И (РеализацияТоваровУслугУслуги.СтрокаДоходовСделки = СделкаДоходы.ГУИД)
	|ГДЕ
	|	СделкаДоходы.Коносамент = &Коносамент
	|	И НЕ СделкаДоходы.Ссылка = &Сделка
	|	И РеализацияТоваровУслугУслуги.Ссылка.Проведен";
	Запрос.УстановитьПараметр("Коносамент", Коносамент);
	Запрос.УстановитьПараметр("Сделка", Сделка);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		СтрокаРезультата = РезультатЗапроса.Выгрузить()[0].Ссылка;
		//Если КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериод(СтрокаРезультата.Организация) < СтрокаРезультата.ДатаДокумента Тогда
		//ДИТ, Беляев СЮ, Ticket#0283330, 30-08-2022, начало
		//Евросиб Каблов 09.04.2025 ( #105407
		//Если КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериод(СтрокаРезультата.Организация) <= СтрокаРезультата.ДатаДокумента Тогда
		Если КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериодДоходов(СтрокаРезультата.Организация) <= СтрокаРезультата.ДатаДокумента Тогда
		//Евросиб Каблов 09.04.2025 )
		//ДИТ, Беляев СЮ, Ticket#0283330, 30-08-2022, конец
			Акт = СтрокаРезультата.Ссылка;
		КонецЕсли; 
	КонецЕсли; 
	Возврат Акт;
	
КонецФункции

