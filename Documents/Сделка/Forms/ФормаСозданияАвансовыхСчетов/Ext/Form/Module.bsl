&НаСервере
Функция НайтиСчетНаАвансПоСделке(ДокСделка,Контрагент,Договор)
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СчетНаОплатуПокупателю.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Документ.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю
	                      |ГДЕ
	                      |	СчетНаОплатуПокупателю.АвансовыйСчет = ИСТИНА
	                      |	И СчетНаОплатуПокупателю.Контрагент = &Контрагент
	                      |	И СчетНаОплатуПокупателю.ДоговорКонтрагента = &ДоговорКонтрагента
	                      |	И СчетНаОплатуПокупателю.Сделка = &Сделка
	                      |	И НЕ СчетНаОплатуПокупателю.ПометкаУдаления");
	Запрос.УстановитьПараметр("Сделка",ДокСделка);
	Запрос.УстановитьПараметр("Контрагент",Контрагент);
	Запрос.УстановитьПараметр("ДоговорКонтрагента",Договор);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Счет = Выборка.Ссылка;
	Иначе
		Счет = Неопределено;
	КонецЕсли;
	
	Возврат Счет;
КонецФункции

&НаКлиенте
Процедура ВыписатьСчетаНаАванс(Команда)
	
	Для каждого Стр из ТЧ Цикл
		Если Не Стр.Пометка Тогда Продолжить; КонецЕсли;
		Рез = СоздатьДокументСчетНаАванс(Сделка,Стр.контрагент,Стр.ДоговорКонтрагента,Стр.СчетНаОплату);
		Стр.СчетНаОплату = Рез[0].Ссылка;
		Стр.СуммаСчета = Рез[0].СуммаДок;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьДокументСчетНаАванс(ДокСделка,Контрагент,Договор,Счет)
	МассивРезультата = Новый Массив;
	СтруктураДок = Новый Структура;
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СделкаДоходы.Услуга КАК Услуга,
	                      |	СделкаДоходы.Услуга.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	                      |	СделкаДоходы.Количество КАК Количество,
	                      |	СделкаДоходы.СтавкаНДС КАК СтавкаНДС,
	                      |	СделкаДоходы.СуммаНДС КАК СуммаНДС,
	                      |	СделкаДоходы.СуммаИтого * СделкаДоходы.Договор.РазмерАванса / 100 КАК СуммаИтого,
	                      |	СделкаДоходы.ГУИД КАК ГУИД,
	                      |	СделкаДоходы.Валюта КАК Валюта,
	                      |	СделкаДоходы.НДСВключенВСтоимость КАК НДСВключенВСтоимость
	                      |ИЗ
	                      |	Документ.Сделка.Доходы КАК СделкаДоходы
	                      |ГДЕ
	                      |	СделкаДоходы.Ссылка = &Сделка
	                      |	И СделкаДоходы.Клиент = &Контрагент
	                      |	И СделкаДоходы.Договор = &Договор");	
	Запрос.УстановитьПараметр("Сделка", ДокСделка);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Договор", Договор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Счет = Документы.СчетНаОплатуПокупателю.ПустаяСсылка() Тогда
		НовДок = Документы.СчетНаОплатуПокупателю.СоздатьДокумент();
	Иначе
		НовДок = Счет.ПолучитьОбъект();
		НовДок.Товары.Очистить();
		НовДок.СуммаДокумента = 0;
		
	КонецЕсли;
	НовДок.Заполнить(Неопределено);
	НовДок.Дата = ТекущаяДата();
	НовДок.ДатаДокумента = ТекущаяДата();
	НовДок.Контрагент = Контрагент;
	НовДок.АвансовыйСчет = Истина;
	НовДок.ДоговорКонтрагента = Договор;
	НовДок.ВалютаДокумента = Договор.ВалютаВзаиморасчетов;
	Результат = РаботаСКурсамиВалют.ПолучитьКурсВалюты(НовДок.ВалютаДокумента, НовДок.Дата);
	НовДок.КурсВзаиморасчетов = Результат.Курс;
	НовДок.КратностьВзаиморасчетов = Результат.Кратность;
	НовДок.Сделка = ДокСделка;
	//НовДок.БанковскийСчетОрганизации = НовДок.Организация.ОсновнойБанковскийСчет;
	//ДИТ, Беляев СЮ, TA48059, 12-04-2022, начало (команда скрыта с формы, код не выполняется)
	НовДок.БанковскийСчетОрганизации = ОбщегоНазначенияВызовСервера.РасчетныйСчетПоДоговору(Договор); 
	//ДИТ, Беляев СЮ, TA48059, 12-04-2022, конец	
	НовДок.УчитыватьНДС = Истина;
	Пока Выборка.Следующий() Цикл

		НовДок.СуммаВключаетНДС = Выборка.НДСВключенВСтоимость;
		НовСтр = НовДок.Товары.Добавить();
		НовСтр.Номенклатура = Выборка.Услуга;
//Евросиб Гудкова( 13.02.2020 Ticket№ 0182894
		НовСтр.ЕдиницаИзмерения = Выборка.ЕдиницаИзмерения;
// Евросиб Гудкова) 		
		СодержаниеУслуги = Выборка.Услуга.НаименованиеПолное + " по направлению " + ДокСделка.СтанцияОтправления + " - " + ДокСделка.СтанцияНазначения;
				РейсВСделке = ДокСделка.Рейсы[0].Рейс;
				Если ЗначениеЗаполнено(РейсВСделке) Тогда
					НомерПоезда = ?(ТипЗнч(РейсВСделке) = Тип("СправочникСсылка.РейсыЖД")," КП №"+РейсВСделке.НомерПоезда,"");
					СодержаниеУслуги = СодержаниеУслуги +  НомерПоезда;
				КонецЕсли;
		
		Если ДокСделка.ТипЗаказа <> Справочники.ТипыЗаказов.ПовагоннаяОтправка Тогда
			 КТК = ДокСделка.ДоходыКТК.Найти(Выборка.ГУИД,"ГУИД");
			 Если КТК <> Неопределено Тогда
				 СодержаниеУслуги = СодержаниеУслуги + Символы.ПС + "Список контейнеров: " + КТК.КТК;
			 КонецЕсли;
		 Иначе
			 Вагоны = ДокСделка.ДоходыВагоны.Найти(Выборка.ГУИД,"ГУИД");
			 Если Вагоны <> Неопределено Тогда
				 СодержаниеУслуги = СодержаниеУслуги + Символы.ПС + "Список вагонов: " + Вагоны.Вагон;
			 КонецЕсли;
		КонецЕсли;
		НовСТр.Содержание = СодержаниеУслуги;
		НовСТр.Количество = Выборка.Количество;
		НовСТр.СтавкаНДС = Выборка.СтавкаНДС;
		ВалютаСтроки = Выборка.Валюта;
		Если ВалютаСтроки <> НовДок.ВалютаДокумента Тогда
			СуммаИтого = РаботаСКурсамиВалют.ПересчитатьВВалюту(Выборка.СуммаИтого,Выборка.Валюта,НовДок.ВалютаДокумента,НовДок.Дата);
		Иначе
			СуммаИтого = Выборка.СуммаИтого;
		КонецЕсли;
		НовСтр.СуммаНДС = СуммаИтого * БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Выборка.СтавкаНДС)/(100+БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Выборка.СтавкаНДС));
		НовСтр.Сумма = ?(Выборка.НДСВключенВСтоимость, СуммаИтого, СуммаИтого - НовСтр.СуммаНДС );
		НовСтр.Цена = НовСтр.Сумма/НовСТр.Количество;
		НовСтр.СтрокаДоходовСделки = Выборка.ГУИД;
		НовДок.СуммаДокумента = НовДок.СуммаДокумента+СуммаИтого; 


	КонецЦикла;
	НовДок.Записать(РежимЗаписиДокумента.Запись);
	СтруктураДок.Вставить("Ссылка", НовДок.Ссылка);
	СтруктураДок.Вставить("СуммаДок", НовДок.Ссылка.СуммаДокумента);
	МассивРезультата.Добавить(СтруктураДок);
	
	Возврат МассивРезультата;
КонецФункции

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если НЕ ЗавершениеРаботы Тогда
		Оповестить("ДокументыДляСделкиСозданы", Сделка);
	КонецЕсли;
	

КонецПроцедуры

