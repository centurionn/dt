
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("СписокОтклонений") Тогда
		СписокРасхождений.Загрузить(Параметры.СписокОтклонений.Выгрузить());		
	КонецЕсли;
	Если Параметры.Свойство("СтатьяРасхождений") Тогда
		СтатьяРасхождений = Параметры.СтатьяРасхождений;		
	КонецЕсли;

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры

