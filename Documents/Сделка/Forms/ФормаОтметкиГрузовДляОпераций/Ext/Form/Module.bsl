	Для каждого Стр из Параметры.ТЧ Цикл
		ЗаполнитьЗначенияСвойств(ТЧ.Добавить(), Стр);
	КонецЦикла;
	
	СписокОпераций.ЗагрузитьЗначения(Параметры.Операции);
	

