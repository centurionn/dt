&НаКлиенте
Процедура ТЗКоносаментыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если  Поле.Имя = "ТЗКоносаментыПодобранныеКоносаменты" Тогда
		СтандартнаяОбработка = Ложь;
		Если СтрНайти(Элемент.ТекущиеДанные.ПодобранныеКоносаменты, "Выберите") > 0 Тогда
			Оповещение = Новый ОписаниеОповещения("ПослеВыбораКоносаментаИзСписка", ЭтотОбъект);
			Элементы.ТЗКоносаменты.ТекущиеДанные.СписокКоносаментов.ПоказатьВыборЭлемента(Оповещение, "Выберите коносамент");
		ИначеЕсли СтрНайти(Элемент.ТекущиеДанные.ПодобранныеКоносаменты, "Коносамент" ) > 0 Тогда
			КоносаментИзСписка = Элементы.ТЗКоносаменты.ТекущиеДанные.СписокКоносаментов[0].Значение;
			Элементы.ТЗКоносаменты.ТекущиеДанные.Коносамент = КоносаментИзСписка;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
//ДИТ, Беляев СЮ, Ticket#0304948, 23-03-2023, конец

//ДИТ, Беляев СЮ, Ticket#0304948, 23-03-2023, начало
&НаКлиенте
Процедура ПослеВыбораКоносаментаИзСписка(ВыбранныйЭлемент, СписокПараметров) Экспорт
    Если ВыбранныйЭлемент <> Неопределено Тогда
        Элементы.ТЗКоносаменты.ТекущиеДанные.Коносамент = ВыбранныйЭлемент.Значение;
		ТЗКоносаментыКоносаментПриИзменении(Неопределено);
    КонецЕсли;
КонецПроцедуры
