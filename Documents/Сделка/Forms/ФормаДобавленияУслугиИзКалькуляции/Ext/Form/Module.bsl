&НаСервереБезКонтекста
Функция ПолучитьПСЦ(Калькуляция)
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПСЦКалькуляции.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ПСЦ.Калькуляции КАК ПСЦКалькуляции
	               |ГДЕ
	               |	ПСЦКалькуляции.Калькуляция = &Калькуляция
	               |	И НЕ ПСЦКалькуляции.Ссылка.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПСЦКалькуляции.Ссылка.Дата УБЫВ";
	Запрос.УстановитьПараметр("Калькуляция", Калькуляция);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


&НаКлиенте
Процедура ТЧВыбраноПриИзменении(Элемент)
	
	Для каждого Стр из ТЧ Цикл Стр.Выбрано = Ложь; КонецЦикла;
	Элементы.ТЧ.ТекущиеДанные.Выбрано = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьЪ(Команда)
	
	Результат = неопределено;
	Для каждого Стр из ТЧ Цикл
		Если Стр.Выбрано Тогда Результат = Новый Структура(
			"Клиент, Договор, Услуга, Калькуляция, ПСЦ, Количество, СтавкаНДС, НДСВключенВСтоимость, РазмерКТК, Валюта, ПроцентВознаграждения, СтавкаНДСВознаграждения, ВознаграждениеВключаетНДС, Себестоимость, СебестоимостьИтого, Вознаграждение, ВознаграждениеИтого, Ставка, СтавкаИтого, СуммаНДС, СуммаИтого, Расходы_Поставщик, Расходы_Договор, Расходы_Услуга, ПунктОтправления, ПунктНазначения, Расходы_СтавкаНДС, Расходы_НДСВключенВСтоимость, Расходы_Количество, Расходы_Валюта, ТипСтавки",
			
			Стр.Клиент,
			Стр.Договор,
			Стр.Услуга,
			Стр.Калькуляция,
			Стр.ПСЦ,
			1,
			Стр.СтавкаНДС,
			Стр.СуммаВключаетНДС,
			РазмерКТК,
			Стр.Валюта,
			Стр.ПроцентВознаграждения,
			Стр.СтавкаНДСВознаграждения,
			Стр.ВознаграждениеВключаетНДС,
			?(РазмерКТК = ПредопределенноеЗначение("Справочник.РазмерыКТК.К20"), Стр.Себестоимость20, Стр.Себестоимость40),
			?(РазмерКТК = ПредопределенноеЗначение("Справочник.РазмерыКТК.К20"), Стр.Себестоимость20, Стр.Себестоимость40),
			?(РазмерКТК = ПредопределенноеЗначение("Справочник.РазмерыКТК.К20"), Стр.Вознаграждение20, Стр.Вознаграждение40),
			?(РазмерКТК = ПредопределенноеЗначение("Справочник.РазмерыКТК.К20"), Стр.Вознаграждение20, Стр.Вознаграждение40),
			?(РазмерКТК = ПредопределенноеЗначение("Справочник.РазмерыКТК.К20"), Стр.Ставка20, Стр.Ставка40),
			?(РазмерКТК = ПредопределенноеЗначение("Справочник.РазмерыКТК.К20"), Стр.Ставка20, Стр.Ставка40),
			0,
			?(РазмерКТК = ПредопределенноеЗначение("Справочник.РазмерыКТК.К20"), Стр.Ставка20, Стр.Ставка40),
			Стр.Поставщик,
			Стр.Поставщик_Договор,
			Стр.Услуга,
			Стр.ПунктОтправления,
			Стр.ПунктНазначения,
			Стр.СтавкаНДС,
			Стр.СуммаВключаетНДС,
			1,
			Стр.Валюта,
			Стр.ТипСтавки
			
			); Прервать; КонецЕсли;
	КонецЦикла;
	Закрыть(Результат);
	
КонецПроцедуры
