
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РазмерКТК = Параметры.РазмерКТК;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КалькуляцияЖД_УслугиВнеСтавки.Ссылка.Контрагент КАК Клиент,
	               |	КалькуляцияЖД_УслугиВнеСтавки.Ссылка.Договор КАК Договор,
	               |	КалькуляцияЖД_УслугиВнеСтавки.Ссылка КАК Калькуляция,
	               |	КалькуляцияЖД_УслугиВнеСтавки.Услуга КАК Услуга,
	               |	КалькуляцияЖД_УслугиВнеСтавки.ПунктОтправления КАК ПунктОтправления,
	               |	КалькуляцияЖД_УслугиВнеСтавки.ПунктНазначения КАК ПунктНазначения,
	               |	КалькуляцияЖД_УслугиВнеСтавки.ВидРасходов КАК ВидРасходов,
	               |	КалькуляцияЖД_УслугиВнеСтавки.Валюта КАК Валюта,
	               |	КалькуляцияЖД_УслугиВнеСтавки.СтавкаНДС КАК СтавкаНДС,
	               |	КалькуляцияЖД_УслугиВнеСтавки.СуммаВключаетНДС КАК СуммаВключаетНДС,
	               |	КалькуляцияЖД_УслугиВнеСтавки.СтавкаНДСВознаграждения КАК СтавкаНДСВознаграждения,
	               |	КалькуляцияЖД_УслугиВнеСтавки.ВознаграждениеВключаетНДС КАК ВознаграждениеВключаетНДС,
	               |	КалькуляцияЖД_УслугиВнеСтавки.БазаДляРасчетаВР КАК БазаДляРасчетаВР,
	               |	КалькуляцияЖД_УслугиВнеСтавки.Себестоимость20 КАК Себестоимость20,
	               |	КалькуляцияЖД_УслугиВнеСтавки.Вознаграждение20 КАК Вознаграждение20,
	               |	КалькуляцияЖД_УслугиВнеСтавки.Ставка20 КАК Ставка20,
	               |	КалькуляцияЖД_УслугиВнеСтавки.Себестоимость40 КАК Себестоимость40,
	               |	КалькуляцияЖД_УслугиВнеСтавки.Вознаграждение40 КАК Вознаграждение40,
	               |	КалькуляцияЖД_УслугиВнеСтавки.Ставка40 КАК Ставка40,
	               |	КалькуляцияЖД_УслугиВнеСтавки.Поставщик КАК Поставщик,
	               |	КалькуляцияЖД_УслугиВнеСтавки.Договор КАК Поставщик_Договор,
	               |	КалькуляцияЖД_УслугиВнеСтавки.ТипСтавки КАК ТипСтавки,
	               |	КалькуляцияЖД_УслугиВнеСтавки.ПроцентВознаграждения КАК ПроцентВознаграждения
	               |ИЗ
	               |	Документ.Калькуляция.ЖД_УслугиВнеСтавки КАК КалькуляцияЖД_УслугиВнеСтавки
	               |ГДЕ
	               |	КалькуляцияЖД_УслугиВнеСтавки.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Параметры.Калькуляция);
	ПСЦ = ПолучитьПСЦ(Параметры.Калькуляция);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		НСтр = ТЧ.Добавить();
		ЗаполнитьЗначенияСвойств(НСтр, Ответ);
		НСтр.ПСЦ = ПСЦ;
		
	КонецЦикла;
	

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры

