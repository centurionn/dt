
&НаКлиенте
Процедура ПрочитатьЪ(Команда)
	
	ПрочитатьДанные_сервер();
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДанные_сервер()
	
	Сч = 3;
	Распозн.Очистить();
	
	ПрочСтрока = Excel.Область("R"+Сч+"C1").Текст;
	
	СоответствиеСтавкиНДС = Новый Соответствие;
	СоответствиеСтавкиНДС.Вставить("20", Перечисления.СтавкиНДС.НДС20);
	СоответствиеСтавкиНДС.Вставить("10", Перечисления.СтавкиНДС.НДС10);
	СоответствиеСтавкиНДС.Вставить("0", Перечисления.СтавкиНДС.НДС0);
	СоответствиеСтавкиНДС.Вставить("Без НДС", Перечисления.СтавкиНДС.БезНДС); 
	// Евросиб(ДИТ) US 96051 ТА 96052 Сержантова А.С. Начало: 25.12.2024
	СоответствиеСтавкиНДС.Вставить("5", Перечисления.СтавкиНДС.НДС5); 
	СоответствиеСтавкиНДС.Вставить("7", Перечисления.СтавкиНДС.НДС7);
	// Евросиб(ДИТ) US 96051 ТА 96052 Сержантова А.С. Конец: 25.12.2024
	//Евросиб СубботинВ #125845 09.12.2025 Начало
	СоответствиеСтавкиНДС.Вставить("22", Перечисления.СтавкиНДС.НДС22);
	//Евросиб СубботинВ #125845 09.12.2025 Конец
	
	ОписаниеТипаЧисло = Новый ОписаниеТипов("Число");
	
	Пока ПрочСтрока <> "" Цикл
		
		НСтр = Распозн.Добавить();
		
		Услуга = СокрЛП(Excel.Область("R"+Сч+"C1").Текст);
		НСтр.Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию(Услуга);
		
		Если Excel.Область("R"+Сч+"C2").Текст <> "" Тогда
			НСтр.Контрагент = КонтрагентыДоговоры_сервер.НайтиКонтрагентаПоНечеткомуУсловию(Excel.Область("R"+Сч+"C2").Текст);
		КонецЕсли;
		
		Если Excel.Область("R"+Сч+"C3").Текст <> "" Тогда
			НСтр.Договор = КонтрагентыДоговоры_сервер.ПолучитьДоговорКонтрагента(НСтр.Контрагент, Excel.Область("R"+Сч+"C3").Текст);
		КонецЕсли;
		
		Если Excel.Область("R"+Сч+"C4").Текст <> "" Тогда
			НСтр.ДокументОснование = Документы.ПоступлениеТоваровУслуг.НайтиПоНомеру(Excel.Область("R"+Сч+"C4").Текст, ТекущаяДата());
			Если НЕ ЗначениеЗаполнено(НСтр.ДокументОснование) Тогда
				НСтр.ДокументОснование = Документы.ПоступлениеТоваровУслуг.НайтиПоНомеру(Excel.Область("R"+Сч+"C4").Текст, ДобавитьМесяц(ТекущаяДата(), -12));
			КонецЕсли;
		КонецЕсли;
		
		Если Excel.Область("R"+Сч+"C7").Текст <> "" Тогда
			НСтр.ЕИ = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию(Excel.Область("R"+Сч+"C7").Текст);
		КонецЕсли;
		
		Если Excel.Область("R"+Сч+"C8").Текст <> "" Тогда
			НСтр.Количество = ОписаниеТипаЧисло.ПривестиЗначение(Excel.Область("R"+Сч+"C8").Текст);
		КонецЕсли;
		
		Если Excel.Область("R"+Сч+"C9").Текст <> "" Тогда
			НСтр.Ставка = ОписаниеТипаЧисло.ПривестиЗначение(Excel.Область("R"+Сч+"C9").Текст);
		КонецЕсли;
		
		Если Excel.Область("R"+Сч+"C10").Текст <> "" Тогда
			НСтр.СтавкаНДС = СоответствиеСтавкиНДС[Excel.Область("R"+Сч+"C10").Текст];
		КонецЕсли;
		
		Если Excel.Область("R"+Сч+"C11").Текст <> "" Тогда
			НСтр.НДСвТЧ = (ВРег(Excel.Область("R"+Сч+"C11").Текст) = "ДА");
		КонецЕсли;
		
		Если Excel.Область("R"+Сч+"C6").Текст <> "" Тогда
			
			СписокКТК = Excel.Область("R"+Сч+"C6").Текст;
			МассивКТК = СтрРазделить(СписокКТК, ";", Ложь);
			Для каждого Стр из МассивКТК Цикл
				
				КТК = РаботаСКонтейнерамиСервер.Нормализовать_и_НайтиКТК(Стр, неопределено);
				НСтр.СписокКТК.Добавить(КТК);
				
			КонецЦикла;
			
			
		КонецЕсли;
		
		Если Excel.Область("R"+Сч+"C5").Текст <> "" Тогда
			
			СписокВагонов = Excel.Область("R"+Сч+"C5").Текст;
			МассивВагонов = СтрРазделить(СписокВагонов, ";", Ложь);
			Для каждого Стр из МассивВагонов Цикл
				
				КТК = РаботаСКонтейнерамиСервер.ПолучитьВагонПоНомеру(Стр, Ложь);
				НСтр.СписокВагонов.Добавить(КТК);
				
			КонецЦикла;
			
			
		КонецЕсли;
		
		Сч = Сч + 1;
		ПрочСтрока = Excel.Область("R"+Формат(Сч, "ЧГ=0")+"C1").Текст;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВТаблицу(Команда)
	
	Результат = Новый Массив;
	Для каждого Стр из Распозн Цикл
		
		Результат.Добавить(Новый Структура("Услуга, Расходы_Услуга, Клиент, Договор, Расходы_Поставщик, Расходы_Договор, ПТУ, ЕдиницаИзмерения, Количество, Расходы_Количество, Себестоимость, СтавкаНДС, Расходы_СтавкаНДС, НДСВключенВСтоимость, Расходы_НДСВключенВСтоимость, СписокКТК, СписокВагонов", 
		Стр.Номенклатура, Стр.Номенклатура, Стр.Контрагент, Стр.Договор, Стр.Контрагент, Стр.Договор, Стр.ДокументОснование, Стр.ЕИ, Стр.Количество, Стр.Количество, Стр.Ставка, Стр.СтавкаНДС, Стр.СтавкаНДС, Стр.НДСвТЧ, Стр.НДСвТЧ, Стр.СписокКТК.ВыгрузитьЗначения(), Стр.СписокВагонов.ВыгрузитьЗначения()));
		
	КонецЦикла;
	
	Закрыть(результат);
	
КонецПроцедуры

