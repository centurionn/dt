&НаКлиенте
Процедура ВключитьРедактирование(Команда)
	
	Если Закрыта Тогда
		ПоказатьПредупреждение(, "Для закрытых сделок редактирование из ТСх запрещено. Отредактируйте из карточки операции или повторно откройте сделку.");
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СсылкаТСх) Тогда
		ЗахваченоДляРедактирования = истина;
	Иначе
		Заблокировать_сервер();
	КонецЕсли;
	
	ОбновитьОтображениеКнопокРедактирования();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьТСх(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Запишите сделку перед сохранением ТСх!");
		Возврат;
	КонецЕсли;
	
	Разблокировать_сервер();
	ТСХЭлемент = ЗаписатьДеревоВЭлемент();
	Элементы.ТСхОглавление.ТекущиеДанные.ЭлементТСх = ТСХЭлемент;
	ОбновитьОтображениеКнопокРедактирования();
	
КонецПроцедуры

&НаСервере
Функция ЗаписатьДеревоВЭлемент()
	
	Если ЗначениеЗаполнено(СсылкаТСх) Тогда
		ТСХОбъект = СсылкаТСх.ПолучитьОбъект();
	Иначе
		ТСХОбъект = Справочники.ТехнологическаяСхема.СоздатьЭлемент();
	КонецЕсли;
	
	ТСХОбъект.ТЧ.Очистить();
	Для каждого Стр из ТЧ Цикл
		ЗаполнитьЗначенияСвойств(ТСХОбъект.ТЧ.Добавить(), Стр);
	КонецЦикла;
	ТСХОбъект.ОбновлениеОперацийПоТСх = Истина;
	ТСХОбъект.Записать();
	
	МЗ = РегистрыСведений.ТехнологическаяСхема.СоздатьМенеджерЗаписи();
	МЗ.Период = ТекущаяДата();
	МЗ.ПредметТСх = Объект.Ссылка;
	МЗ.ТСх = ТСХОбъект.Ссылка;
	МЗ.Вариант = Вариант;
	МЗ.Записать(Истина);
	
	Возврат ТСХОбъект.Ссылка;
	
КонецФункции

&НаКлиенте
Процедура ОтменитьРедактирование(Команда)
	
	Разблокировать_сервер();
	ЗахваченоДляРедактирования = Ложь;
	ПостроитьДеревоПоЭлементу();
	ПерестроитьДеревоПоТЧ();
	ОбновитьОтображениеКнопокРедактирования();
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьОперации(Команда)
	
	Для каждого Стр из ТЧ Цикл
		Если НЕ ЗначениеЗаполнено(Стр.Операция) Тогда 
			СтруктураПараметров = Новый Структура;
			МассивРеквизитов = "Услуга,Регламентный,ПунктОтправления,ПунктНазначения,ДатаОтправления,ДатаНазначения,ТипДлительности,Срок,Поставщик,Договор,Тариф,Себестоимость,Валюта,СтавкаНДС,ВключаетНДС,ДатаОтправленияФакт,ДатаНазначенияФакт";
			Для каждого Стр7 из СтрРазделить(МассивРеквизитов, ",", Ложь) Цикл
				СтруктураПараметров.Вставить(Стр7, Стр[Стр7]);
			КонецЦикла;
			СтруктураПараметров.Вставить("Сделка", Объект.Ссылка);
			Если Элементы.ТСхОглавление.ТекущиеДанные <> неопределено И Строка(Элементы.ТСхОглавление.ТекущиеДанные.Вариант) = "Фактическая" Тогда
				СтруктураПараметров.Вставить("ПланФакт", ПредопределенноеЗначение("Перечисление.ПланФактСчет.Факт"));
			Иначе
				СтруктураПараметров.Вставить("ПланФакт", ПредопределенноеЗначение("Перечисление.ПланФактСчет.План"));
			КонецЕсли;
			
			Стр.Операция = ПостроительТСх_сервер.СоздатьОперацию(СтруктураПараметров);
			ОперацииСозданы = Истина;
		КонецЕсли;
	КонецЦикла;
	ПерестроитьДеревоПоТЧ();
	
КонецПроцедуры

&НаКлиенте
Процедура родитель_Отмена(Команда)
	
	ТекД = Элементы.Дерево.ТекущиеДанные;
	
	ТекГУИД = "";
	ПомеченныеРодители = Новый Массив;
	Для каждого Стр из дерево.ПолучитьЭлементы() Цикл
		СнятьТекущегоИСобратьРодителей(Стр, ТекГУИД, ПомеченныеРодители);
	КонецЦикла;

	Элементы.ДеревоРодитель.Видимость = Ложь;
	Элементы.ГруппаКоманднаяПанель2.Видимость = Ложь;
	Элементы.ГруппаКоманднаяПанель3.Видимость = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура родитель_Сохранить(Команда)
	
	ТекГУИД = "";
	ПомеченныеРодители = Новый Массив;
	Для каждого Стр из дерево.ПолучитьЭлементы() Цикл
		СнятьТекущегоИСобратьРодителей(Стр, ТекГУИД, ПомеченныеРодители);
	КонецЦикла;
	
	Для каждого Стр из ТЧ Цикл
		Если Стр.ГУИД = ТекГУИД Тогда
			Для Сч = 1 По 5 Цикл
				Стр["Родитель"+Сч] = "";
				Если ПомеченныеРодители.Количество() >= Сч Тогда Стр["Родитель"+Сч] = ПомеченныеРодители[Сч-1]; КонецЕсли;
			КонецЦикла;	
			Стр.НесколькоРодителей = ЗначениеЗаполнено(Стр.Родитель2);
		КонецЕсли;
	КонецЦикла;
	Элементы.ДеревоРодитель.Видимость = Ложь;
	Элементы.ГруппаКоманднаяПанель2.Видимость = Ложь;
	ПерестроитьДеревоПоТЧ();
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьТекущегоИСобратьРодителей(Стр, ТекГУИД, ПомеченныеРодители)
	
	Если Стр.ТекСтрока Тогда ТекГУИД = Стр.ГУИД; КонецЕсли;
	Стр.ТекСтрока = Ложь;
	Если Стр.Родитель Тогда ПомеченныеРодители.Добавить(Стр.ГУИД); КонецЕсли;
	Для каждого Стр2 из Стр.ПолучитьЭлементы() Цикл
		СнятьТекущегоИСобратьРодителей(Стр2, ТекГУИД, ПомеченныеРодители);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПунктНазначенияПриИзменении(Элемент)
	
	ТекД = Элементы.Дерево.ТекущиеДанные;
	
	Для каждого Стр из ТекД.ПолучитьЭлементы() Цикл
		Стр.ПунктОтправления = ТекД.ПунктНазначения;
	КонецЦикла;
	Для каждого Стр из Дерево.ПолучитьЭлементы() Цикл
		Если Стр.Родитель1 = ТекД.ГУИД ИЛИ Стр.Родитель2 = ТекД.ГУИД ИЛИ Стр.Родитель3 = ТекД.ГУИД ИЛИ Стр.Родитель4 = ТекД.ГУИД ИЛИ Стр.Родитель5 = ТекД.ГУИД Тогда
			Стр.ПунктОтправления = ТекД.ПунктНазначения;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоДатаНазначенияПриИзменении(Элемент)
	
	ТекД = Элементы.Дерево.ТекущиеДанные;
	ТекД.Срок = 0;
	
	Для каждого Стр из ТЧ Цикл
		Если Стр.ГУИД = ТекД.ГУИД Тогда 
			ЗаполнитьЗначенияСвойств(Стр, ТекД, "ДатаОтправления,Срок,ТипДлительности,ДатаНазначения"); 
			Прервать; 
		КонецЕсли;
	КонецЦикла;
	
	ПостроительТСх_клиент.ПересчитатьПоТаблице(ТЧ, ТекД.ГУИД);
	ПерестроитьДеревоПоТЧ();
	
КонецПроцедуры

&НаКлиенте
Процедура подобрать_ПоРейсуЖД(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораРейса", ЭтаФорма);
	ОткрытьФорму("Справочник.РейсыЖД.ФормаВыбора",,, ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораРейса(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	Если ТипЗнч(Параметр1) = Тип("ДокументСсылка.Заявка") Тогда
		Если Объект.Заявки.НайтиСтроки(Новый Структура("Заявка", Параметр1)).Количество() = 0 Тогда
			
			//Евросиб Каблов 28.06.2022 ( Task 53759
			Если Объект.ПодсылПорожних Тогда
				//ДИТ Шевченко А.В. 53486 02.09.2022 -начало
		        ЗаявкиСПодсыломПорожних = ПерезаполнениеСделкиСервер.ПолучитьЗаявкиКалькуляцииСПодсылом(Параметр1, "Заявка");
				//ДИТ Шевченко А.В. 53486 02.09.2022 -конец
				Если ЗаявкиСПодсыломПорожних.Количество() = 0 Тогда
					ТекстСообщения = "В калькуляциях не предусмотрено оформление порожней сделки.";
					ПоказатьПредупреждение(, ТекстСообщения);
					Возврат;
				КонецЕсли;  
			//ДИТ Авдеева В.С. 50072 Начало 08.09.2022	
			Иначе
				ЗаявкиВДругихСделках = ПерезаполнениеСделкиСервер.ПроверитьНаличиеЗаявкиВДругихСделках(Параметр1, Объект.Ссылка);
				
				Если ЗначениеЗаполнено(ЗаявкиВДругихСделках) Тогда  
					Для Каждого КлючИЗначение Из ЗаявкиВДругихСделках Цикл  
						Для Каждого Сообщение Из КлючИЗначение.Значение Цикл 
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение);
						КонецЦикла;
					КонецЦикла;
					Возврат;
				КонецЕсли;
			//ДИТ Авдеева В.С. 50072 Конец 08.09.2022	
			КонецЕсли;
			//Евросиб Каблов 28.06.2022 )
			
			//ДИТ Шевченко А.В. 59985 12.12.2022 -начало
			ДоговорДействует = Истина;
			СтруктураРек = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(Параметр1,"Договор,Отправка,Прибытие,Дата");
			Если ЗначениеЗаполнено(СтруктураРек.Договор) И ЗначениеЗаполнено(СтруктураРек.Отправка) и НЕ ЗначениеЗаполнено(СтруктураРек.Прибытие) Тогда
				ДоговорДействует = ПроверитьПериодДействияДоговора(СтруктураРек.Договор,СтруктураРек.Отправка,Дата(1,1,1),Истина);
			ИначеЕсли ЗначениеЗаполнено(СтруктураРек.Договор) И НЕ ЗначениеЗаполнено(СтруктураРек.Отправка) и ЗначениеЗаполнено(СтруктураРек.Прибытие) Тогда
				ДоговорДействует = ПроверитьПериодДействияДоговора(СтруктураРек.Договор,СтруктураРек.Прибытие,Дата(1,1,1),Истина);
			ИначеЕсли ЗначениеЗаполнено(СтруктураРек.Договор) И ЗначениеЗаполнено(СтруктураРек.Отправка) и ЗначениеЗаполнено(СтруктураРек.Прибытие) Тогда
				ДоговорДействует = ПроверитьПериодДействияДоговора(СтруктураРек.Договор,СтруктураРек.Отправка,СтруктураРек.Прибытие);	
			ИначеЕсли ЗначениеЗаполнено(СтруктураРек.Договор) И НЕ ЗначениеЗаполнено(СтруктураРек.Отправка) и НЕ ЗначениеЗаполнено(СтруктураРек.Прибытие) Тогда
				ДоговорДействует = ПроверитьПериодДействияДоговора(СтруктураРек.Договор,СтруктураРек.Дата,Дата(1,1,1),Истина);
			КонецЕсли;
			
			Если НЕ ДоговорДействует Тогда
				Автопролонгация = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(СтруктураРек.Договор,"Автопролонгация");
				Если Автопролонгация Тогда
					СообщениеТекст = "Заявка не добавлена. Договор в заявке не продлен на текущий год, необходимо продлить договор через отдел делопроизводства";
				Иначе
					СообщениеТекст = "Заявка не добавлена. Срок действия договора в заявке истек, необходимо оформить ДС на продления срока действия договора";
				КонецЕсли;
				ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеТекст);
				Возврат;
			КонецЕсли;
			//ДИТ Шевченко А.В. 59985 12.12.2022 -конец
			
			//Евросиб Коханенко Н.А. 03.07.2023 (( #72162 
			СтрНайдена = Ложь;
			КонтрагентСсылка = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(Параметр1, "Контрагент");  
			КонтрагентИзПараметраЭтоДирекция = КонтрагентыДоговоры_Сервер.КонтрагентЯвляетсяДирекциейКонтейнерныхПеревозок(КонтрагентСсылка.Контрагент); 
			Для каждого Стр из Объект.Заявки Цикл
				Если ЗначениеЗаполнено(Стр.Заявка) Тогда
					КонтрагентСсылкаВСтроке = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(Стр.Заявка, "Контрагент");
					КонтрагентИзСтрокиЭтоДирекция = КонтрагентыДоговоры_Сервер.КонтрагентЯвляетсяДирекциейКонтейнерныхПеревозок(КонтрагентСсылкаВСтроке.Контрагент);
					Если (КонтрагентИзПараметраЭтоДирекция И НЕ КонтрагентИзСтрокиЭтоДирекция) ИЛИ
						(НЕ КонтрагентИзПараметраЭтоДирекция И КонтрагентИзСтрокиЭтоДирекция)Тогда
						СтрНайдена = Истина;
						Прервать; 
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Если СтрНайдена Тогда
				//нельзя добавить заявку, если в сделке есть отличные от Дирекции Контрагенты
				ТекстСообщения = "Заявки на передислокацию КТК не могут находиться в одной сделке с коммерческими заявками." + Символы.ПС + 
										"Заявки на передислокацию КТК должны быть добавлены в отдельную сделку.";
				ПоказатьПредупреждение(, ТекстСообщения);
				Возврат;
			КонецЕсли;
			//Евросиб Коханенко Н.А. 03.07.2023 )) #72162 
			
			НСтр = Объект.Заявки.Добавить();
			НСтр.Заявка = Параметр1;
			Кальк = ПолучитьВсеКалькуляцииЗаявки(Параметр1, ПредопределенноеЗначение("Справочник.РейсыЖД.ПустаяСсылка"));
			Если Кальк.Количество() > 0 Тогда
				НСтр.Калькуляция = Кальк[0].Калькуляция;
			КонецЕсли;
			Для каждого СтрЪ из Кальк Цикл
				Если НЕ ЗначениеЗаполнено(Объект.ТипЗаказа) тогда
					Объект.ТипЗаказа = СтрЪ.ТипЗаказа;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(Объект.СтанцияОтправления) тогда
					Объект.СтанцияОтправления = СтрЪ.ПунктОтправления;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(Объект.СтанцияНазначения) тогда
					Объект.СтанцияНазначения = СтрЪ.ПунктНазначения;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Иначе
		
		СтрНайдена = Ложь;
		Для каждого Стр из Объект.Рейсы Цикл
			Если Стр.Рейс = Параметр1 Тогда СтрНайдена = Истина; КонецЕсли;
		КонецЦикла;
		Если НЕ СтрНайдена Тогда Объект.Рейсы.Добавить().Рейс = Параметр1; КонецЕсли;
		
		СписокЗаявок = ПолучитьЗаявки(Параметр1);
		//Евросиб Каблов 28.06.2022 ( Task 53759
		Если Объект.ПодсылПорожних Тогда
			//ДИТ Шевченко А.В. 53486 02.09.2022 -начало
			ЗаявкиСПодсыломПорожних = ПерезаполнениеСделкиСервер.ПолучитьЗаявкиКалькуляцииСПодсылом(СписокЗаявок, "Заявка");
			//ДИТ Шевченко А.В. 53486 02.09.2022 -начало
		//ДИТ Авдеева В.С. 50072 Начало 08.09.2022	
		Иначе
			ЗаявкиВДругихСделках = ПерезаполнениеСделкиСервер.ПроверитьНаличиеЗаявкиВДругихСделках(СписокЗаявок, Объект.Ссылка);
		//ДИТ Авдеева В.С. 50072 Конец 08.09.2022
		КонецЕсли;
		//Евросиб Каблов 28.06.2022 )
		Для каждого Элем из СписокЗаявок Цикл
			Если Объект.Заявки.НайтиСтроки(Новый Структура("Заявка", Элем)).Количество() = 0 Тогда
				
				//Евросиб Каблов 28.06.2022 ( Task 53759
				Если Объект.ПодсылПорожних Тогда
					Если ЗаявкиСПодсыломПорожних.Найти(Элем) = Неопределено Тогда
						ТекстСообщения = СтрШаблон("В калькуляциях (%1) не предусмотрено оформление порожней сделки", Элем);
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
						Продолжить;
					КонецЕсли;
				//ДИТ Авдеева В.С. 50072 Начало 08.09.2022	
				Иначе          
				    МассивСообщений = ЗаявкиВДругихСделках.Получить(Элем);
				    Если МассивСообщений <> Неопределено Тогда
						Для Каждого Сообщение Из МассивСообщений Цикл 
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение);
						КонецЦикла;
						Продолжить;
					КонецЕсли;
				//ДИТ Авдеева В.С. 50072 Конец 08.09.2022	
				КонецЕсли;
				//Евросиб Каблов 28.06.2022 )  
				
				// ДИТ US 79847 ТА 80505 Сержантова А.С. Начало: 29.05.2024
				ЗаявкаПроведена = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(Элем, "Проведен");
				Если не ЗаявкаПроведена Тогда
					ОбщегоНазначенияКлиент.СообщитьПользователю("" + Элем + " не проведена. Проведите заявку для добавления в документ."); 
					Продолжить;
				КонецЕсли;
				// ДИТ US 79847 ТА 80505 Сержантова А.С. Конец: 29.05.2024
				
				НСтр = Объект.Заявки.Добавить();
				НСтр.Заявка = Элем;
				Кальк = ПолучитьВсеКалькуляцииЗаявки(Элем, Параметр1);
				Если Кальк.Количество() > 0 Тогда
					НСтр.Калькуляция = Кальк[0].Калькуляция;
				КонецЕсли;
				Для каждого СтрЪ из Кальк Цикл
					Если НЕ ЗначениеЗаполнено(Объект.ТипЗаказа) тогда
						Объект.ТипЗаказа = СтрЪ.ТипЗаказа;
					КонецЕсли;
					Если НЕ ЗначениеЗаполнено(Объект.СтанцияОтправления) тогда
						Объект.СтанцияОтправления = СтрЪ.ПунктОтправления;
					КонецЕсли;
					Если НЕ ЗначениеЗаполнено(Объект.СтанцияНазначения) тогда
						Объект.СтанцияНазначения = СтрЪ.ПунктНазначения;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Для каждого Стр из Объект.Рейсы Цикл
		Если ТипЗнч(Стр.Рейс) = Тип("СправочникСсылка.РейсыЖД") Тогда
			НомерПоезда = ПолучитьНомерПоезда(Стр.Рейс);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьПериодДействияДоговора(Договор,ДатаНачала,ДатаОкончания,ПроверитьВхождениеОднойДаты = ложь) //ДИТ Шевченко А.В. 59985 12.12.2022		
	ДоговорДействует = Справочники.ДоговорыКонтрагентов.ПроверитьПериодДействияДоговора(Договор,ДатаНачала,ДатаОкончания,ПроверитьВхождениеОднойДаты);
	Возврат ДоговорДействует;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНомерПоезда(Рейс)
	Возврат Рейс.НомерПоезда;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьВсеКалькуляцииЗаявки(Заявка, Рейс)
	
	Результат = Новый Массив();
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаявкаСоставУслуги.Калькуляция КАК Калькуляция,
	               |	ЗаявкаСоставУслуги.Калькуляция.ТипЗаказа КАК ТипЗаказа,
	               |	ЗаявкаСоставУслуги.Калькуляция.Суша_ПунктОтправления КАК ПунктОтправления,
	               |	ЗаявкаСоставУслуги.Калькуляция.Суша_ПунктНазначения КАК ПунктНазначения
	               |ИЗ
	               |	Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
	               |ГДЕ
	               |	ЗаявкаСоставУслуги.Ссылка = &Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаявкаСоставУслуги.Калькуляция,
	               |	ЗаявкаСоставУслуги.Калькуляция.ТипЗаказа,
	               |	ЗаявкаСоставУслуги.Калькуляция.Суша_ПунктОтправления,
	               |	ЗаявкаСоставУслуги.Калькуляция.Суша_ПунктНазначения";
	Запрос.УстановитьПараметр("Ссылка", Заявка);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		Результат.Добавить(Новый Структура("Калькуляция, ТипЗаказа, ПунктОтправления, ПунктНазначения", Ответ.Калькуляция, Ответ.ТипЗаказа, Ответ.ПунктОтправления, Ответ.ПунктНазначения));
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЗаявки(Рейс)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЗаявкаПереченьРейсов.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
	               |ГДЕ
	               |	ЗаявкаПереченьРейсов.Рейс = &Рейс
	               |	И НЕ ЗаявкаПереченьРейсов.Ссылка.ПометкаУдаления";
	Запрос.УстановитьПараметр("Рейс", Рейс);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

&НаКлиенте
Процедура подобрать_ПоРейсуМоре(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораРейса", ЭтаФорма);
	ОткрытьФорму("Справочник.РейсыМоре.ФормаВыбора",,, ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура подобрать_ПоАвтоРейсу(Команда)
	
