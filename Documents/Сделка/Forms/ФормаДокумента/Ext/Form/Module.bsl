&НаКлиенте
Процедура ЗаявкиЗаявкаПриИзменении(Элемент)
	
	ТекД = Элементы.Заявки.ТекущиеДанные;
	//Евросиб Каблов 28.06.2022 ( Task 53759
	Если Объект.ПодсылПорожних Тогда
		//ДИТ Шевченко А.В. 53486 02.09.2022 -начало
        ЗаявкиСПодсыломПорожних = ПерезаполнениеСделкиСервер.ПолучитьЗаявкиКалькуляцииСПодсылом(ТекД.Заявка, "Заявка");
		//ДИТ Шевченко А.В. 53486 02.09.2022 -конец
		Если ЗаявкиСПодсыломПорожних.Количество() = 0 Тогда
			ТекД.Заявка = Неопределено;
			ТекстСообщения = "В калькуляциях не предусмотрено оформление порожней сделки.";
			ПоказатьПредупреждение(, ТекстСообщения);
			Возврат;
		КонецЕсли;   
	//ДИТ Авдеева В.С. 50072 Начало 08.09.2022	
	Иначе
		ЗаявкиВДругихСделках = ПерезаполнениеСделкиСервер.ПроверитьНаличиеЗаявкиВДругихСделках(ТекД.Заявка, Объект.Ссылка);
		
		Если ЗначениеЗаполнено(ЗаявкиВДругихСделках) Тогда  
			Для Каждого КлючИЗначение Из ЗаявкиВДругихСделках Цикл  
				Для Каждого Сообщение Из КлючИЗначение.Значение Цикл 
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение);
				КонецЦикла;
			КонецЦикла;
			ТекД.Заявка = Неопределено;
			Возврат;
		КонецЕсли;
	//ДИТ Авдеева В.С. 50072 Конец 08.09.2022		
	КонецЕсли;
	//Евросиб Каблов 28.06.2022 )
	Кальк = ПолучитьВсеКалькуляцииЗаявки(ТекД.Заявка,);
	Если Кальк.Количество() > 0 Тогда
		ТекД.Калькуляция = Кальк[0].Калькуляция;
	КонецЕсли;
	
	//Евросиб Коханенко Н.А. 17.07.2023 (( #72162 
	Если ПроверкаНаНеСовместимостьСлужебныхИКоммерческихЗаявок() Тогда    
		ТекстСообщения = "Заявки на передислокацию КТК не могут находиться в одной сделке с коммерческими заявками." + Символы.ПС + 
					"Заявки на передислокацию КТК должны быть добавлены в отдельную сделку.";
		ПоказатьПредупреждение(, ТекстСообщения);
		Объект.Заявки.Удалить(ТекД.НомерСтроки-1);
	КонецЕсли;
	//Евросиб Коханенко Н.А. 17.07.2023 )) #72162 
		
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьТолькоСвязанные(Команда)
	
	ПоказыватьТолькоСвязанныеСтрокиДР = НЕ ПоказыватьТолькоСвязанныеСтрокиДР;
	Элементы.РасходыПоказыватьТолькоСвязанные.ЦветФона = ?(ПоказыватьТолькоСвязанныеСтрокиДР, WebЦвета.Розовый, Элементы.РасходыОчиститьРасходы.ЦветФона);
	Если ПоказыватьТолькоСвязанныеСтрокиДР Тогда
		Элементы.Расходы.ОтборСтрок = Новый ФиксированнаяСтруктура("Пометка", Истина);
	Иначе
		Элементы.Расходы.ОтборСтрок = неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасходыПриИзменении(Элемент, Знач ТекД = неопределено)
	
	Если ТекД = неопределено Тогда
		ТекД = Элементы.Расходы.ТекущиеДанные;
	КонецЕсли;
	Если ТекД <> неопределено Тогда
		
		ТекД.СебестоимостьИтого		= ТекД.Себестоимость * ТекД.Количество;
		ТекД.СуммаНДС 				= БухгалтерскийУчетОбщиеПроцедурыКлиент.ПолучитьСуммуНДС(ТекД.СебестоимостьИтого, БухгалтерскийУчетОбщиеПроцедурыКлиент.ПолучитьСтавкуНДС(ТекД.СтавкаНДС), Истина, ТекД.НДСВключенВСтоимость);
		ТекД.СуммаИтого 			= ТекД.СебестоимостьИтого + ?(ТекД.НДСВключенВСтоимость, 0, ТекД.СуммаНДС);
		
	КонецЕсли;
	
КонецПроцедуры

