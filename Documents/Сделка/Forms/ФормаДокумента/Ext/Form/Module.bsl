&НаСервереБезКонтекста
Функция ПроверитьНаличиеРасходовПоКТК(ГУИД, Знач ОбъектСделка)
	МассивГУИД = Новый Массив;
	МассивГУИД.Добавить(ГУИД);
	
	МассивСтрок = Документы.Сделка.ПолучитьСтрокиРасходовПоСУЕСПривязаннымиУчДокументами(МассивГУИД, ОбъектСделка);
	
	Возврат МассивСтрок.Количество() > 0;	
КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьОтключениеРасходов(ГУИД, Знач ОбъектСделка)
	Возврат РаботаСоСделкамиСервер.ВсеРасходыКТКОтключены(ГУИД, ОбъектСделка);	
КонецФункции

&НаКлиенте
Процедура СвязьУчетныхЕдиницПередНачаломИзменения(Элемент, Отказ)
	
	// Если по КТК есть доходы или расходы, то галку не ставим.
	Если Элемент.ТекущийЭлемент.Имя = "СвязьУчетныхЕдиницОтключитьРасходы" Тогда
		
		ТекущиеДанные = Элементы.СвязьУчетныхЕдиниц.ТекущиеДанные;
		
		Если ТекущиеДанные.ОтключитьРасходы = Истина Тогда
			// Снимаем галку
			// Если все строки расходов отключены, то галку не снимаем.
			ВсеРасходыОтключены = ПроверитьОтключениеРасходов(ТекущиеДанные.ГУИД, Объект);
			Если ВсеРасходыОтключены Тогда
				Отказ = Истина;
				//ПоказатьПредупреждение(, "По данному КТК ранее были отключены расходы. Снимать галку запрещено.");
				ОбщегоНазначенияКлиент.СообщитьПользователю(
						СтрШаблон("По КТК %1 ранее были отключены расходы. Снимать галку запрещено.", ТекущиеДанные.Контейнер),
						,
						ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СвязьУчетныхЕдиниц", ТекущиеДанные.НомерСтроки, "Контейнер"),
						"Объект");
			КонецЕсли;
			
		Иначе
			// Устанавливаем галку
			МожноУстановитьПризнак = Истина;
			ТекстСообщения = "";
			
			Если ТекущиеДанные.ДокументыСформированы Тогда
				ТекстСообщения = "сформированы документы в доходной части.";
				МожноУстановитьПризнак = Ложь;
			КонецЕсли;	
			
			ЕстьРасходы = ПроверитьНаличиеРасходовПоКТК(ТекущиеДанные.ГУИД, Объект);
			Если ЕстьРасходы Тогда
				Если МожноУстановитьПризнак = Ложь Тогда
					ТекстСообщения = "сформированы документы в доходной и расходной частях";
				Иначе
					ТекстСообщения = "сформированы документы в расходной части";
				КонецЕсли;	
				МожноУстановитьПризнак = Ложь;
			КонецЕсли;
			
			Если МожноУстановитьПризнак = Ложь Тогда
				Отказ = Истина;
				//ПоказатьПредупреждение(, "Нельзя отключать расходы по данному КТК, т.к. по нему " + ТекстСообщения);
				ОбщегоНазначенияКлиент.СообщитьПользователю(
						СтрШаблон("Нельзя отключать расходы по КТК %1, т.к. по нему %2.", ТекущиеДанные.Контейнер, ТекстСообщения),
						,
						ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СвязьУчетныхЕдиниц", ТекущиеДанные.НомерСтроки, "Контейнер"),
						"Объект");
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
// Евросиб Фролов)

