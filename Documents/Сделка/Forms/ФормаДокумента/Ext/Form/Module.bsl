&НаКлиенте
Процедура ОбработкаСвязи(ВыбранныйЭл = неопределено, ДополнительныеПараметры = неопределено) Экспорт
	
	ТекД = Элементы.Дерево.ТекущиеДанные;
	Если ВыбранныйЭл = неопределено ИЛИ ТекД = неопределено Тогда Возврат; КонецЕсли;
	
	Если ВыбранныйЭл.Значение = "Добавить родителя" Тогда
		
		ТекД.ТекСтрока = Истина;
		МассивРодителей = Новый Массив;
		Если ЗначениеЗаполнено(ТекД.Родитель1) Тогда МассивРодителей.Добавить(ТекД.Родитель1); КонецЕсли;
		Если ЗначениеЗаполнено(ТекД.Родитель2) Тогда МассивРодителей.Добавить(ТекД.Родитель2); КонецЕсли;
		Если ЗначениеЗаполнено(ТекД.Родитель3) Тогда МассивРодителей.Добавить(ТекД.Родитель3); КонецЕсли;
		Если ЗначениеЗаполнено(ТекД.Родитель4) Тогда МассивРодителей.Добавить(ТекД.Родитель4); КонецЕсли;
		Если ЗначениеЗаполнено(ТекД.Родитель5) Тогда МассивРодителей.Добавить(ТекД.Родитель5); КонецЕсли;
		Для каждого Стр из Дерево.ПолучитьЭлементы() Цикл
			УстановитьПометкиРодителей(Стр, МассивРодителей);
		КонецЦикла;
		Элементы.ДеревоРодитель.Видимость = Истина;
		Элементы.ГруппаКоманднаяПанель2.Видимость = Истина;
		
	ИначеЕсли ВыбранныйЭл.Значение = "Внести перевозимый груз" Тогда
		
		Элементы.ДеревоРодитель.Видимость = Истина;
		Элементы.ГруппаКоманднаяПанель3.Видимость = Истина;

	ИначеЕсли ВыбранныйЭл.Значение = "Отметить исполнение операций по данным источников" Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.Ссылка) ИЛИ ЭтаФорма.Модифицированность Тогда
			ПоказатьПредупреждение(, "Перед продолжением запишите сделку!");
			Возврат;
		КонецЕсли;
		
		ОпОп = Новый ОписаниеОповещения("ОбработкаЗаполненияДат", ЭтаФорма, Новый Структура("Вариант", Элементы.ТСхОглавление.ТекущиеДанные.Вариант));
		ПоказатьВопрос(ОпОп, "Фактические даты операций будут перезаписаны данными внешних источников. Продолжить?", РежимДиалогаВопрос.ДаНет);
		
	ИначеЕсли ВыбранныйЭл.Значение = "Разложить фрахт по коносаментам" Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.Ссылка) ИЛИ ЭтаФорма.Модифицированность Тогда
			ПоказатьПредупреждение(, "Перед продолжением запишите сделку!");
			Возврат;
		КонецЕсли;
		
		ТекДанДер = Элементы.Дерево.ТекущиеДанные;
		
		Родители = Новый Структура("Родитель1, Родитель2, Родитель3, Родитель4, Родитель5") ;
		ЗаполнитьЗначенияСвойств(Родители, ТекДанДер);
		
		ОпОш = "";
		
		РазложитьФрахтНаСервере(ТекДанДер.Операция, ТекДанДер.ГУИД, Родители, ОпОш);
		
		Если ОпОш <> "" Тогда
		
			Сообщить(ОпОш);
		
		КонецЕсли; 
		
		Дерево.ПолучитьЭлементы().Очистить();
		ТЧ.Очистить();
		ПостроитьДеревоПоЭлементу();
		ПерестроитьДеревоПоТЧ();
		
	ИначеЕсли ВыбранныйЭл.Значение = "- сдачу КТК в сток по пунктам назначения" Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.Ссылка) ИЛИ ЭтаФорма.Модифицированность Тогда
			ПоказатьПредупреждение(, "Перед продолжением запишите сделку!");
			Возврат;
		КонецЕсли;
		
		ТекДанДер = Элементы.Дерево.ТекущиеДанные;
		
		Родители = Новый Структура("Родитель1, Родитель2, Родитель3, Родитель4, Родитель5") ;
		ЗаполнитьЗначенияСвойств(Родители, ТекДанДер);
		
		ОпОш = "";
		
		сдачаКТК_В_СтокПоПунктамНазначенияНаСервере(ТекДанДер.Операция, ТекДанДер.ГУИД, Родители, ОпОш);
		
		Если ОпОш <> "" Тогда
		
			Сообщить(ОпОш);
		
		КонецЕсли; 
		
		Дерево.ПолучитьЭлементы().Очистить();
		ТЧ.Очистить();
		ПостроитьДеревоПоЭлементу();
		ПерестроитьДеревоПоТЧ();
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура сдачаКТК_В_СтокПоПунктамНазначенияНаСервере(Операция, ТекГУИД, Родители, ОпОш)

	ОпОш = "";
	
	ИскСтрВ_ТСХ = СсылкаТСх.ТЧ.НайтиСтроки(Новый Структура("Операция", Операция));
	
	МасИтогоПодч = Новый Массив;
	Для Сч = 1 По 5 Цикл
		ИскСтрСпрР = СсылкаТСх.ТЧ.НайтиСтроки(Новый Структура("Родитель"+Сч, ТекГУИД) );
		Для каждого Стр Из ИскСтрСпрР Цикл
			МасИтогоПодч.Добавить( Стр );
		КонецЦикла; 
	КонецЦикла; 
	
	ОбТСХ = Неопределено;
	
	ТЗСочетСтокСдачи = Объект.СвязьУчетныхЕдиниц.Выгрузить(, "СтокСдачиПорожнего"); 
	ТЗСочетСтокСдачи.Свернуть("СтокСдачиПорожнего");
	
	НомРодит = 1;
	МасНовОп = Новый Массив;
	
	// создаем операции:
	Для каждого Стр Из ТЗСочетСтокСдачи Цикл
		
		Если ЗначениеЗаполнено(Стр.СтокСдачиПорожнего) Тогда
			
			Если ОбТСХ = Неопределено Тогда
			
				ОбТСХ = СсылкаТСх.ПолучитьОбъект();
			
			КонецЕсли; 
			
			НоваяОпер = Документы.Операция.СоздатьДокумент();
			НоваяОпер.Заполнить(неопределено);
			НоваяОпер.Дата 		= ТекущаяДата();
			НоваяОпер.Автор 	= Пользователи.ТекущийПользователь();
			НоваяОпер.ЦФО 		= НоваяОпер.Автор.ЦФО;
			НоваяОпер.Создано 	= ТекущаяДата();
			НоваяОпер.ТребуетсяМаршрутизироватьВОбходВсехПравил = Истина;
			
			ЗаполнитьЗначенияСвойств(НоваяОпер, Операция, "Услуга,ТипДлительности,Срок,Поставщик,Договор,Валюта,СтавкаНДС,ВключаетНДС,Регламентный,Маршрутизировать,ПланФакт,Подразделение,Сделка,РейсЖД,Организация" );
			
			НоваяОпер.ПунктОтправления= Операция.ПунктОтправления;
			НоваяОпер.ПунктНазначения = Стр.СтокСдачиПорожнего;
			
			НоваяОпер.ДатаОтправления 	 = Операция.ДатаОтправления;
			НоваяОпер.ДатаОтправленияФакт= Операция.ДатаОтправленияФакт;
			НоваяОпер.ДатаНазначения 	 = Операция.ДатаНазначения;
			НоваяОпер.ДатаНазначенияФакт = Операция.ДатаНазначенияФакт;
			
			// Заполнение ТЧ "Грузы":
			ИскМасСвязей = Объект.СвязьУчетныхЕдиниц.НайтиСтроки(Новый Структура("СтокСдачиПорожнего", Стр.СтокСдачиПорожнего) );
			
			Для каждого СтрТекСвязь Из ИскМасСвязей Цикл
				
				МасРезВыб = Операция.Грузы.НайтиСтроки(Новый Структура("ТЕ", СтрТекСвязь.Контейнер) );
				
				Для каждого РезВыб Из МасРезВыб Цикл
				
					// Заполняем родителя ТЕ
					ТСГУИД = РезВыб.ТСГУИД;
					ИскМас_ТСГУИД = Операция.Грузы.НайтиСтроки(Новый Структура("ТСГУИД, ТЕГУИД", ТСГУИД, "") );
					
					Для каждого ТекСтрПоГУИД Из ИскМас_ТСГУИД Цикл
						
						НовСтр = НоваяОпер.Грузы.Добавить();
						ЗаполнитьЗначенияСвойств(НовСтр, ТекСтрПоГУИД);
						
