&НаКлиенте
Процедура ВставкаДатыСоставПоезда(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = неопределено Тогда Возврат; КонецЕсли;
	
	МассивНайденныхЗаявок = Новый Массив;
	
	Для каждого Стр из П1 Цикл
		
		// ДИТ US 79847 ТА 80505 Сержантова А.С. Начало: 29.05.2024
		// Было:
		//НСтр = Объект.СвязьУчетныхЕдиниц.Добавить();
		//НСтр.Контейнер = РаботаСКонтейнерамиСервер.НайтиКТК(Стр);
		//РезПоиска = ДополнитьДаннымиЗаявки(НСтр.Контейнер);
		// Стало:     
		НайденныйКонтейнер = РаботаСКонтейнерамиСервер.НайтиКТК(Стр);
		РезПоиска = ДополнитьДаннымиЗаявки(НайденныйКонтейнер);  
		Если не ЗначениеЗаполнено(РезПоиска.Заявка) Тогда
			Продолжить;
		КонецЕсли;      
		НСтр = Объект.СвязьУчетныхЕдиниц.Добавить();
		НСтр.Контейнер = НайденныйКонтейнер;
		// ДИТ US 79847 ТА 80505 Сержантова А.С. Конец: 29.05.2024
		ЗаполнитьЗначенияСвойств(НСтр, РезПоиска);
		Если МассивНайденныхЗаявок.Найти(НСтр.Заявка) = неопределено Тогда МассивНайденныхЗаявок.Добавить(НСтр.Заявка); КонецЕсли;
		
	КонецЦикла;
	
	Для каждого Стр из МассивНайденныхЗаявок Цикл
		
		Если Объект.Заявки.НайтиСтроки(Новый Структура("Заявка", Стр)).Количество() = 0 Тогда
			
			Объект.Заявки.Добавить().Заявка = Стр;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДополнитьДаннымиЗаявки(Контейнер)
	
	// Евросиб Фролов (23.12.2021 TASK №44661: добавил "ГУИДСтрокиЗаявки"
	Результат = Новый Структура("Клиент,Договор,УсловияПеревозки,УсловияПеревозкиНазначение,Груз,Калькуляция,РазмерКТК,Заявка,ВесГрузаНетто,ПравилоГотовностиКВыставлению,Груженый,ГУИДСтрокиЗаявки");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаявкаСоставУслуги.Ссылка КАК Заявка,
	               |	ЗаявкаСоставУслуги.Ссылка.Контрагент КАК Клиент,
	               |	ЗаявкаСоставУслуги.Ссылка.Договор КАК Договор,
	               |	ЗаявкаСоставУслуги.Калькуляция.УсловияПеревозки_Отправление КАК УсловияПеревозки,
	               |	ЗаявкаСоставУслуги.Калькуляция.УсловияПеревозки_Прибытие КАК УсловияПеревозкиНазначение,
	               |	ЗаявкаСоставУслуги.Груженый КАК Груженый,
	               // ДИТ US 62421 TA 64346 Евсенкин М.А. Начало: 08.02.2023
				   // Было:
				   //|	ЗаявкаСоставУслуги.Груз КАК Груз, 
				   // Стало:
				   |	ЗаявкаСоставУслуги.КлючАналитикиПеревозки.Груз КАК Груз,
				   // ДИТ US 62421 TA 64346 Евсенкин М.А. Конец: 08.02.2023  
				   // ДИТ US 79847 ТА 80505 Сержантова А.С. Начало: 15.05.2024
				   |	ЗаявкаСоставУслуги.Ссылка.Проведен КАК Проведен,
				   // ДИТ US 79847 ТА 80505 Сержантова А.С. Конец: 15.05.2024
	               |	ЗаявкаСоставУслуги.Калькуляция КАК Калькуляция,
	               |	ЗаявкаСоставУслуги.РазмерКТК КАК РазмерКТК,
	               |	ЗаявкаСоставУслуги.ВесГрузаНетто КАК ВесГрузаНетто,
				   // Евросиб Фролов (23.12.2021 TASK №44661
	               |	ЗаявкаСоставУслуги.ГУИДСтроки КАК ГУИДСтрокиЗаявки
				   // Евросиб Фролов)
	               |ИЗ
	               |	Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
	               |ГДЕ
	               |	ЗаявкаСоставУслуги.НомерКТК = &НомерКТК
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЗаявкаСоставУслуги.Ссылка.Дата УБЫВ";
	Запрос.УстановитьПараметр("НомерКТК", Контейнер);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда  
		
		// ДИТ US 79847 ТА 80505 Сержантова А.С. Начало: 29.05.2024
		Если не Ответ.Проведен Тогда
			ОбщегоНазначения.СообщитьПользователю("" + Ответ.Заявка + " не проведена. Проведите заявку для добавления в документ."); 
		    Возврат Результат;
		КонецЕсли;
		// ДИТ US 79847 ТА 80505 Сержантова А.С. Конец: 29.05.2024
		
		ЗаполнитьЗначенияСвойств(Результат, Ответ);
		Результат.ПравилоГотовностиКВыставлению = Перечисления.ПравилоГотовностиКВыставлению.Вручную;
		
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПФ_ОперативныйПриказ(Команда)
	
	Если ЭтаФорма.Модифицированность Тогда
		Сообщить("Требуется запись документа!");
		Возврат;
	КонецЕсли; 
	
	Документ = ПФ_ОперативныйПриказНаСервере(Объект.Ссылка);
	
	Если Документ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторПечатнойФормы = "ОперативныйПриказ";
	НазваниеПечатнойФормы = НСтр("ru = 'Оперативный приказ'");
	
	Если Не ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.Печать") Тогда
		Документ.Показать(НазваниеПечатнойФормы);
		Возврат;
	КонецЕсли;
	
	МодульУправлениеПечатьюКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("УправлениеПечатьюКлиент");
	
	КоллекцияПечатныхФорм = МодульУправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм(ИдентификаторПечатнойФормы);
	ПечатнаяФорма = МодульУправлениеПечатьюКлиент.ОписаниеПечатнойФормы(КоллекцияПечатныхФорм, ИдентификаторПечатнойФормы);
	ПечатнаяФорма.СинонимМакета = НазваниеПечатнойФормы;
	ПечатнаяФорма.ТабличныйДокумент = Документ;
	ПечатнаяФорма.ИмяФайлаПечатнойФормы = НазваниеПечатнойФормы;
	
	ОбластиОбъектов = Новый СписокЗначений;
	МодульУправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм, ОбластиОбъектов);
	
КонецПроцедуры

