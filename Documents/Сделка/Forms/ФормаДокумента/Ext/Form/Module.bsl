&НаСервереБезКонтекста
Функция НайтиПТУ(ОбъектСсылка, СтрГУИД)
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ОбъектСсылка);
	Запрос.УстановитьПараметр("СтрокаРасходовСделки", СтрГУИД);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ПоступлениеТоваровУслугРазнесение.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ПоступлениеТоваровУслуг.Разнесение КАК ПоступлениеТоваровУслугРазнесение
	               |ГДЕ
	               |	ПоступлениеТоваровУслугРазнесение.Сделка = &Ссылка
	               |	И ПоступлениеТоваровУслугРазнесение.СтрокаРасходов = &СтрокаРасходовСделки
	               |	И НЕ ПоступлениеТоваровУслугРазнесение.Ссылка.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПоступлениеТоваровУслугРазнесение.Ссылка.Дата УБЫВ";
	Ответ = запрос.Выполнить().Выбрать();
	Если ответ.Следующий() Тогда
		Результат = ответ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
