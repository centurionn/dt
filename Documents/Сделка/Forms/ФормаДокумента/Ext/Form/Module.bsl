&НаКлиенте
Процедура ОткрытьУчетныйДокумент(Команда)
	Если Элементы.Доходы.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;                                  
	УчДокумент = Элементы.Доходы.ТекущиеДанные.УчДокумент;
	ПараметрыОткрытия = Новый Структура("Ключ", УчДокумент);
	Если ТипЗнч(УчДокумент) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		ИмяОткрываемойФормы = "Документ.РеализацияТоваровУслуг.ФормаОбъекта";
	Иначе
		ИмяОткрываемойФормы = "Документ.ОтчетКомитентуОПродажах.ФормаОбъекта";
	КонецЕсли;
	ОткрытьФорму(ИмяОткрываемойФормы, ПараметрыОткрытия,,,,,,РежимОткрытияОкнаФормы.Независимый); 
