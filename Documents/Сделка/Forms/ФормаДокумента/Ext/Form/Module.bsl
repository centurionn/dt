		               |			И (АкцептУслуги.Контейнер.Наименование = &КТК)
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	АкцептУслуги.Ссылка.Поступление";
		
		Запрос.УстановитьПараметр("КТК", Стр.Наименование);
		Запрос.УстановитьПараметр("ДатаЪ", Дата);
		Запрос.УстановитьПараметр("ТекСделкаСсылка", ТекСделкаСсылка);
		
		Ответ = Запрос.Выполнить().Выбрать();
		
