		Возврат;
	КонецЕсли;
	//Евросиб Трундуков С.А #123187 22.12.2025 Конец
	
	// Евросиб Фролов (14.10.2021 Ticket№ 40390
	// Запретить снимать галочку "Готово к выставлению" на вкладке состав поезда
	// если по КТК сформированы закрывающие документы
	// (заполнено поле "Уч. документ", РТУ проведена, не аннулирована и не помечена на удаление).
	// При попытке снять галочку "Готово к выставлению" при сформированных РТУ выводить сообщение
	Если ТекД.СформированыЗакрывающиеДокументы И Не ТекД.ГотовоКВыставлению Тогда
		ТекД.ГотовоКВыставлению = Истина;
		// Евросиб Фролов (09.03.2022 Task №44927
		// Вместо предупреждения сделал сообщение.
		//ПоказатьПредупреждение(, "По КТК сформирована РТУ.
		//                         |Сначала требуется отменить РТУ.
		//                         |Обратитесь к специалисту бэк-офиса.");
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(
						"По КТК сформирована РТУ. Сначала требуется отменить РТУ. Обратитесь к специалисту бэк-офиса.",
						,
						ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СвязьУчетныхЕдиниц", ТекД.НомерСтроки, "ГотовоКВыставлению"),
						"Объект");
		// Евросиб Фролов)				
		Возврат;
	КонецЕсли;	
	// Евросиб Фролов)

	Если Не Объект.Проведен И ТекД.ГотовоКВыставлению Тогда
