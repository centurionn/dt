&НаКлиенте
Процедура ОбработкаВставкиКТК(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(П1) Тогда Возврат; КонецЕсли;
	
	Для каждого Стр из П1 Цикл
		НСтр = Объект.СвязьУчетныхЕдиниц.Добавить();
		//нСтр.ГУИД = Новый УникальныйИдентификатор;
		ЗаполнитьЗначенияСвойств(НСтр, Стр);
		НСтр.УчастокПеревозки = ПредопределенноеЗначение("Перечисление.УчастокПеревозки.ОсновнаяПеревозка");
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОтобразитьОпцииСложнойПеревозки()
	
	ТребуетсяСложнаяСделка = Истина;
	
	Элементы.СвязьУчетныхЕдиницУчастокПеревозки.Видимость = ТребуетсяСложнаяСделка;
	Элементы.СвязьУчетныхЕдиницГруппа1.Видимость = ТребуетсяСложнаяСделка;
	
КонецПроцедуры

&наСервереБезКонтекста
Функция ПоКлиентамТребуетсяСложнаяСделка(МассивКонтрагентов)
	
	Результат = ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	МАКСИМУМ(ФормированиеФинДокументов.ПодсылИОсновнаяПеревозкаВОднойСделке) КАК ПодсылИОсновнаяПеревозкаВОднойСделке
	               |ИЗ
	               |	Справочник.ФормированиеФинДокументов КАК ФормированиеФинДокументов
	               |ГДЕ
	               |	ФормированиеФинДокументов.Контрагент В(&Контрагент)
	               |	И НЕ ФормированиеФинДокументов.ПометкаУдаления";
	Запрос.УстановитьПараметр("Контрагент", МассивКонтрагентов);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() И Ответ.ПодсылИОсновнаяПеревозкаВОднойСделке <> NULL ТОгда
		Результат = Ответ.ПодсылИОсновнаяПеревозкаВОднойСделке;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОперативныеЗадачиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекД = Элементы.ОперативныеЗадачи.ТекущиеДанные;
	Если ТекД <> неопределено Тогда
		ПоказатьЗначение(,ТекД.Документ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НайтиЗаявкиПодсылаДляГруженогоПлеча(Команда)
	
	МассивКТКГруженогоПлеча = Новый Массив;
	Для каждого Стр из Объект.СвязьУчетныхЕдиниц Цикл
		
		Если Стр.УчастокПеревозки = ПредопределенноеЗначение("Перечисление.УчастокПеревозки.ОсновнаяПеревозка") Тогда
			МассивКТКГруженогоПлеча.Добавить(Стр.Контейнер);
		КонецЕсли;
		
	КонецЦикла;
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаПоискаПорожнихПодсылов", ЭтаФорма);
	ОткрытьФорму("Документ.Сделка.Форма.ВставкаКонтейнеровГруженогоПлеча", Новый Структура("СписокГруженыхКТК, СделкаГруженая", МассивКТКГруженогоПлеча, Объект.Ссылка),,ЭтаФорма.УникальныйИдентификатор,,,ОпОп,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаПоискаПорожнихПодсылов(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = неопределено Тогда Возврат; КонецЕсли;
	
	Для каждого Стр из П1 Цикл
		
		НСтр = Объект.СвязьУчетныхЕдиниц.Добавить();
		ЗаполнитьЗначенияСвойств(НСтр, Стр);
		НСтр.УчастокПеревозки = ПредопределенноеЗначение("Перечисление.УчастокПеревозки.ПодсылКонтейнеров");
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВключитьРасходыПодсыла(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) ИЛИ Объект.ПодсылПорожних = Истина Тогда
		Возврат;
	КонецЕсли; 
	
	МассивКТК = Новый Массив; 
	Для каждого СтрД из Объект.СвязьУчетныхЕдиниц Цикл
		МассивКТК.Добавить(СтрД.Контейнер);
	КонецЦикла;
	ДопРасход = 0;
	КоличествоНовыхСтрок = 0;
	
	СоотРасходовПоКТК = ПолучитьМассивРасходовПоЭтомуКТКСделкиПодсыла(МассивКТК, Объект.Дата, Объект.Ссылка);
	//Проверка наличия связи с Связи Уч ед
	Для каждого Стр Из СоотРасходовПоКТК Цикл
		Если Стр.Значение.Соот_СвязьУчЕдиниц.Количество()=0 Тогда
			Сообщить("По КТ " + Стр + " обнаружено более одной связи с составом поезда (или ни одной)");
			Возврат;
		КонецЕсли; 
	КонецЦикла; 
	ИтогоДоб = 0;
	Для каждого Стр Из СоотРасходовПоКТК Цикл
		
		Для каждого СтрММ Из Стр.Значение.МассивРасходовПоКТК Цикл
			
			ДопРасход = ДопРасход + СтрММ.Себестоимость;
			КоличествоНовыхСтрок = КоличествоНовыхСтрок + 1;
			
			НСтр = Объект.Расходы.Добавить();
			ЗаполнитьЗначенияСвойств(НСтр, СтрММ);
			НСтр.ГУИД 		= СтрММ.NEW_ГУИД;
			НСтр.Количество = 1;
			НСтр.СписокКТК 	= Стр.Ключ;
			НСтр.Подсыл		= Истина;
			НСтр.СтрокаСвязьУчетныхЕдиниц = Стр.Значение.Соот_СвязьУчЕдиниц.Получить(Стр.Ключ);
			НСтр.ИсточникПоявленияСтрокиЭкономики = ПредопределенноеЗначение("Перечисление.ИсточникПоявленияСтрокиЭкономики.ЖДНПодсылаКТК");
			
			НСтр.СебестоимостьИтого		= НСтр.Себестоимость * НСтр.Количество;
			НСтр.СуммаНДС 				= БухгалтерскийУчетОбщиеПроцедурыКлиент.ПолучитьСуммуНДС(НСтр.СебестоимостьИтого, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(НСтр.СтавкаНДС), Истина, НСтр.НДСВключенВСтоимость);
			НСтр.СуммаИтого 			= НСтр.СебестоимостьИтого + ?(НСтр.НДСВключенВСтоимость, 0, НСтр.СуммаНДС);
			
			// Связи:
			// КТК
			НСтр3 = Объект.ДоходыКТК.Добавить();
			НСтр3.ГУИД = НСтр.ГУИД;
			НСтр3.КТК = Стр.Ключ;
			
			// Вагоны
			МасВаг = СтрММ.СоотВаг.Получить(Стр.Ключ);
			Для каждого СтрВаг Из МасВаг Цикл
				
				НСтр4 = Объект.ДоходыВагоны.Добавить();
				НСтр4.ГУИД = НСтр.ГУИД;
				НСтр4.Вагон = СтрВаг;
				
			КонецЦикла; 
			НСтр.СписокВагонов = СтрВаг;
			
			// ТД
			МасТД = СтрММ.СоотТД.Получить(Стр.Ключ);
			Для каждого СтрТД Из МасТД Цикл
				
				НСтр5 = Объект.ДоходыТД.Добавить();
				НСтр5.ГУИД = НСтр.ГУИД;
				НСтр5.ТД = СтрТД;
				
			КонецЦикла;
			НСтр.СписокТД = СтрТД;
			
			НСтр2 = Объект.СвязьДоходовИРасходов.Добавить();
			НСтр2.Расходы = НСтр.ГУИД;
			НСтр2.СвязьУчетныхЕдиниц = Стр.Значение.Соот_СвязьУчЕдиниц.Получить(Стр.Ключ);//СтрММ.ГУИД_СвязьУчетныхЕдиниц;
			НСтр2.Услуга = СтрММ.Услуга;
			
			ИтогоДоб = ИтогоДоб + 1;
			
		КонецЦикла; 
		
	КонецЦикла; 
	
	// Перенесем все акцепты
	Если ИтогоДоб > 0 Тогда
		
		ВсеОшибки = "";
		ПолучитьИсправитьАкцепты(Объект.Ссылка, СоотРасходовПоКТК, ВсеОшибки);
		
		Если ВсеОшибки <> "" Тогда
			
			Сообщить(ВсеОшибки);
			
		КонецЕсли; 
		
	КонецЕсли;
	
	Для каждого Стр из Объект.Расходы Цикл
		РасходыПриИзменении(неопределено, Стр)
	КонецЦикла;
	
КонецПроцедуры

