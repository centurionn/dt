					НСтр8.Доходы = Стр8.ГУИД;
					НСтр8.Расходы = НСтрРасходы.ГУИД;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.НомерПорожнейВагоннойЖДН) И Объект.Расходы.НайтиСтроки(Новый Структура("СписокТД", Стр.НомерПорожнейВагоннойЖДН)).Количество() = 0 И МассивНакладныхНаПодсылВагоновПодКТК.Найти(Стр.НомерПорожнейВагоннойЖДН) = неопределено Тогда
			
			МассивНакладныхНаПодсылВагоновПодКТК.Добавить(Стр.НомерПорожнейВагоннойЖДН);
			
			НСтрРасходы = Объект.Расходы.Добавить();
			НСтрРасходы.Услуга = услугаПодсылВагонов;
			
			НаклСсылка = ОбщегоНазначенияВызовСервера.НайтиНакладнуюПоНомеру(Стр.НомерПорожнейВагоннойЖДН);
						
