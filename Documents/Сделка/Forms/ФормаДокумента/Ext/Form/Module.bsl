		РезПоиска = Объект.СвязьУчетныхЕдиниц.НайтиСтроки(СтрокаПоиска);
		
		Если РезПоиска.Количество() = 1 Тогда
			
			ЗаполнитьЗначенияСвойств(РезПоиска[0], Стр);
			
			
		КонецЕсли;
		
	КонецЦикла;
	
