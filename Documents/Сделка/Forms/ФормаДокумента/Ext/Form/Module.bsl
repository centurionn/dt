&НаСервере
Процедура ОбработкаВыбораТСхДляЗаполнения_сервер(Параметр1)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТехнологическаяСхемаТЧ.Услуга КАК Услуга,
	               |	ТехнологическаяСхемаТЧ.Поставщик КАК Поставщик,
	               |	ТехнологическаяСхемаТЧ.Договор КАК Договор,
	               |	ТехнологическаяСхемаТЧ.Тариф КАК Тариф,
	               |	ТехнологическаяСхемаТЧ.Себестоимость КАК Себестоимость,
	               |	ТехнологическаяСхемаТЧ.Валюта КАК Валюта,
	               |	ТехнологическаяСхемаТЧ.СтавкаНДС КАК СтавкаНДС,
	               |	ТехнологическаяСхемаТЧ.ВключаетНДС КАК ВключаетНДС,
	               |	ТехнологическаяСхемаТЧ.Операция КАК Операция,
	               |	ТехнологическаяСхемаТЧ.Операция В
	               |		(ВЫБРАТЬ
	               |			ОперацияРасходы.Ссылка КАК Ссылка
	               |		ИЗ
	               |			Документ.Операция.Расходы КАК ОперацияРасходы
	               |		ГДЕ
	               |			ОперацияРасходы.Ссылка В
	               |				(ВЫБРАТЬ
	               |					ТехнологическаяСхемаТЧ.Операция КАК Операция
	               |				ИЗ
	               |					Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
	               |				ГДЕ
	               |					ТехнологическаяСхемаТЧ.Ссылка = &Ссылка)) КАК ОперацияСодержитДетали,
	               |	ТехнологическаяСхемаТЧ.Услуга.ОтноситьНаЗатраты КАК ОтнестиНаЗатраты
	               |ИЗ
	               |	Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
	               |ГДЕ
	               |	ТехнологическаяСхемаТЧ.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Параметр1);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		НСтр = Объект.Расходы.Добавить();
		НСтр.Регламентный = Истина;
		НСтр.ГУИД = Строка(Новый УникальныйИдентификатор);
		НСтр.Поставщик = Ответ.Поставщик;
		НСтр.Договор = Ответ.Договор;
		НСтр.Услуга = Ответ.Услуга;
		НСтр.Операция = Ответ.Операция;
		НСтр.Калькуляция = неопределено;
		НСтр.Груз = неопределено;
		НСтр.СписокВагонов = неопределено;
		НСтр.СписокТД = неопределено;
		НСтр.СписокКТК = неопределено;
		НСтр.Себестоимость = Ответ.Себестоимость;
		НСтр.Количество = 1;
		НСтр.СебестоимостьИтого = Ответ.Себестоимость;
		НСтр.НДСВключенВСтоимость = Ответ.ВключаетНДС;
		НСтр.СтавкаНДС = Ответ.СтавкаНДС;
		НСтр.СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(НСтр.СебестоимостьИтого, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(НСтр.СтавкаНДС), Истина, НСтр.НДСВключенВСтоимость);
		НСтр.СуммаИтого = НСтр.СебестоимостьИтого + ?(НСтр.НДСВключенВСтоимость, 0, НСтр.СуммаНДС);
		НСтр.ОтнестиНаЗатраты = Ответ.ОтнестиНаЗатраты;
	КонецЦикла;
	
КонецПроцедуры

