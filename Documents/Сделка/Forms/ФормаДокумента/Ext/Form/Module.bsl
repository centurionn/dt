&НаСервере
Функция ПолучитьСсылкиДокументовКонтейнеру(Контейнер,НомерТранспортногоДокумента=Неопределено)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТранспортныйДокументУчетныеЕдиницы.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ТранспортныйДокумент.УчетныеЕдиницы КАК ТранспортныйДокументУчетныеЕдиницы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
		|		ПО ТранспортныйДокументУчетныеЕдиницы.Ссылка = ТранспортныйДокумент.Ссылка
		|ГДЕ
		|	ТранспортныйДокументУчетныеЕдиницы.Контейнер = &Контейнер
		|	И ТранспортныйДокументУчетныеЕдиницы.НомерТранспортногоДокумента ПОДОБНО(&НомерТранспортногоДокумента)
		|	И ТранспортныйДокумент.Проведен";
	
	Запрос.УстановитьПараметр("Контейнер", Контейнер);    

	Если НЕ ЗначениеЗаполнено(НомерТранспортногоДокумента) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ТранспортныйДокументУчетныеЕдиницы.НомерТранспортногоДокумента ПОДОБНО(&НомерТранспортногоДокумента)", "");		
	Иначе
		Запрос.УстановитьПараметр("НомерТранспортногоДокумента", НомерТранспортногоДокумента+"%");
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда		
		ТЗ = РезультатЗапроса.Выгрузить();
		Возврат ?(ТЗ.Количество() > 1, ТЗ.ВыгрузитьКолонку("Ссылка"), ТЗ[0].Ссылка);
	Иначе
		Возврат Неопределено;		
	КонецЕсли;
		
КонецФункции

