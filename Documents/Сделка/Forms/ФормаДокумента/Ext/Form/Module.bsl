		Если Стр.ГотовоКВыставлению И НЕ Стр.ДокументыСформированы И
			НЕ Стр.НеАктивна И //ДИТ Гаузер А.В. BUG 53670, TA 53671 26.08.2022
			((Объект.КомуСтавитсяЗадачаПоДокументам = 0 И ТекПользователь = Объект.ЕдиныйОтветственныйОтУчета) ИЛИ (Объект.КомуСтавитсяЗадачаПоДокументам = 1 И ТекПользователь = Стр.ОтветственныйЗаУчет)) Тогда
		//ДИТ, Беляев СЮ, Ticket#0270072, 26-04-2022, конец	
			НСтр = СписокГотовыхКОформлениюДоговоров.Добавить();
			ЗаполнитьЗначенияСвойств(НСтр, Стр);
			
			Если ЗначениеЗаполнено(Стр.Коносамент) Тогда
				НСтр.НомерКоносамента = ПолучитьНомерКС(Стр.Коносамент);
			КонецЕсли;
						
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ Частично Тогда
		СтрокиКУдалению = Новый Массив;
		
		Для каждого Стр из Объект.Доходы Цикл
			
			Для каждого Стр2 из СписокГотовыхКОформлениюДоговоров Цикл
				
				Если Стр.Договор = СТр2.Договор И (НЕ ВСделкеИдетРаботаПоКоносаментам ИЛИ Стр2.НомерКоносамента = Стр.РеестрКлиента) Тогда
					
					СтрокиКУдалению.Добавить(Стр2);
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
		Для каждого Стр7 из СтрокиКУдалению Цикл 
			Если СписокГотовыхКОформлениюДоговоров.НайтиПоИдентификатору(Стр7.ПолучитьИдентификатор()) <> неопределено Тогда СписокГотовыхКОформлениюДоговоров.Удалить(Стр7); КонецЕсли;
		КонецЦикла;
		
		//Удалим неполные списки
		СтрокиДоговорыКУдалению = Новый Массив;
		Для каждого ГотовыйКОформлениюДоговор Из СписокГотовыхКОформлениюДоговоров Цикл
			НеГотовыеСтроки = Объект.СвязьУчетныхЕдиниц.НайтиСтроки(Новый Структура("Договор, ГотовоКВыставлению", ГотовыйКОформлениюДоговор.Договор, Ложь));
			Если НеГотовыеСтроки.Количество() > 0 Тогда
				СтрокиДоговорыКУдалению.Добавить(ГотовыйКОформлениюДоговор);
			КонецЕсли; 
		КонецЦикла; 
		Для каждого СтрокаДоговорыКУдалению Из СтрокиДоговорыКУдалению Цикл
			СписокГотовыхКОформлениюДоговоров.Удалить(СтрокаДоговорыКУдалению);
		КонецЦикла; 
		/////////////////////////
	КонецЕсли; 
	
	СписокКлиентов = Новый СписокЗначений;
	//Евросиб Коханенко Н.А. 10.04.2024 (( #83236
	//Для каждого СтрокаДоговор Из СписокГотовыхКОформлениюДоговоров Цикл
	//	Если СписокКлиентов.НайтиПоЗначению(СтрокаДоговор.Клиент) = Неопределено Тогда
	//		СписокКлиентов.Добавить(СтрокаДоговор.Клиент, СтрокаДоговор.Клиент, Истина);
	//	КонецЕсли; 
	//КонецЦикла; 
	СписокУникальныхГотовыхКОформлениюДоговоров = Новый СписокЗначений;
	Для каждого СтрокаДоговор Из СписокГотовыхКОформлениюДоговоров Цикл
		Если СписокУникальныхГотовыхКОформлениюДоговоров.НайтиПоЗначению(СтрокаДоговор.Клиент) = Неопределено Тогда
			СписокУникальныхГотовыхКОформлениюДоговоров.Добавить(СтрокаДоговор.Клиент, СтрокаДоговор.Клиент, Истина);
			СписокКлиентов.Добавить(Новый Структура("Ссылка", СтрокаДоговор.Клиент), Строка(СтрокаДоговор.Клиент), Истина);
		КонецЕсли; 
	КонецЦикла; 
	//Евросиб Коханенко Н.А. 10.04.2024 )) #83236 
	ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораКлиентовИзСписка", ЭтаФорма);
	//СписокКлиентов.ПоказатьОтметкуЭлементов(ОпОп, "Выберите клиентов для заполнения экономики сделки");
	//ДИТ, Беляев СЮ, Ticket#0286563 (US 58604), 04-10-2022, начало
	ОткрытьФорму("ОбщаяФорма.э_ФормаВыбораИзСписка",Новый Структура("Список,Заголовок,ОбъектВладелец",СписокКлиентов,"Выберите клиентов для заполнения экономики сделки",Объект.Ссылка),Объект.Ссылка,,,,ОпОп,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	//ДИТ, Беляев СЮ, Ticket#0286563 (US 58604), 04-10-2022, конец
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораКлиентовИзСписка(Параметр1, Параметр2) Экспорт
	
	Если Параметр1 = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	//Удалим не выбранных клиентов
	СтрокиДоговорыКУдалению = Новый Массив;
	Для каждого ГотовыйКОформлениюДоговор Из СписокГотовыхКОформлениюДоговоров Цикл
		//Если НЕ Параметр1.НайтиПоЗначению(ГотовыйКОформлениюДоговор.Клиент).Пометка Тогда
		//ДИТ, Беляев СЮ, Ticket#0286563 (US 58604), 04-10-2022, начало
		Если Параметр1.НайтиПоЗначению(ГотовыйКОформлениюДоговор.Клиент) = Неопределено Тогда
		//ДИТ, Беляев СЮ, Ticket#0286563 (US 58604), 04-10-2022, конец
			СтрокиДоговорыКУдалению.Добавить(ГотовыйКОформлениюДоговор);
		КонецЕсли; 
	КонецЦикла; 
	Для каждого СтрокаДоговорыКУдалению Из СтрокиДоговорыКУдалению Цикл
		СписокГотовыхКОформлениюДоговоров.Удалить(СтрокаДоговорыКУдалению);
	КонецЦикла;
	
	ЗаполнитьДоходыНаСервере();
	
	// SIV 07-06-21 добавляем также доплатные КТК, которые не заполнились основным алгоритмом при проведении сделки
	МассивГотовыхДоговоров = Новый Массив;
	Для каждого Стр из СписокГотовыхКОформлениюДоговоров Цикл
		МассивГотовыхДоговоров.Добавить(Стр.Договор);
	КонецЦикла;
	Для каждого Стр из Объект.СвязьУчетныхЕдиниц Цикл
		
		Если МассивГотовыхДоговоров.Найти(Стр.Договор) <> неопределено И КТКЕщеНеОформленВДоходах(Стр.Контейнер) И ЗначениеЗаполнено(Стр.Доплата_Калькуляция) И ЗначениеЗаполнено(Стр.Доплата_Доплата) Тогда
			
			// --> //////////////////////////////////////////
			
			ТЧДоходыНайдСтрока = НайтиДоходыДоплатыПоПараметрам(Стр.Доплата_Калькуляция, Стр.Доплата_ПСЦ); //Доходы.НайтиСтроки(Новый Структура("Калькуляция, ПСЦ, ДоплатныеКТК", ВыборкаДоплата_Валюта.Доплата_Калькуляция, ВыборкаДоплата_Валюта.Доплата_ПСЦ, Истина));
			
			МассивОтфактурованныхКТКДоплаты = Новый Массив;
			Для каждого СтрОтфКТКДопл из ТЧДоходыНайдСтрока Цикл
				Если НЕ ЗначениеЗаполнено(СтрОтфКТКДопл.УчДокумент) Тогда Продолжить; КонецЕсли;
				СписокКТКСтроки = НайтиДоходыКТК(СтрОтфКТКДопл.ГУИД);
				Если СписокКТКСтроки <> неопределено Тогда
					МассивКТКСтр = СтрРазделить(СписокКТКСтроки.КТК, ";", Ложь);
					Для каждого КТКСтрДляПоиска из МассивКТКСтр Цикл
						МассивОтфактурованныхКТКДоплаты.Добавить(КТКСтрДляПоиска);
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
			
			НДоходы = неопределено;
			Для каждого СтрНДоходыАнализ из ТЧДоходыНайдСтрока Цикл
				Если НЕ ЗначениеЗаполнено(СтрНДоходыАнализ.УчДокумент) Тогда
					НДоходы = СтрНДоходыАнализ;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если НДоходы = неопределено Тогда
				НДоходы = Объект.Доходы.Добавить();
				НДоходы.ГУИД = Строка(Новый УникальныйИдентификатор);
				//ДИТ, Беляев СЮ, ТА48688, 28-03-2022, начало 
				НДоходы.ДатаПоявленияСтрокиЭкономики = ТекущаяДата();
				//ДИТ, Беляев СЮ, ТА48688, 28-03-2022, конец
			КонецЕсли;
			
			ВыбрУслуга = НоменклатураДоплат;
			ВыбрКонтейнеры = Новый Массив;
			
			НайдСтр = неопределено;
			
			Если ЗначениеЗаполнено(НДоходы.ГУИД) Тогда
				НайдСтр = НайтиДоходыКТК(НДоходы.ГУИД);
				Если НайдСтр <> неопределено Тогда
					МассивКТКСтр = СтрРазделить(НайдСтр.КТК, ";", Ложь);
					Для каждого КТКСтрДляПоиска из МассивКТКСтр Цикл
						ВыбрКонтейнеры.Добавить(КТКСтрДляПоиска);
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
			
			Если ВыбрКонтейнеры.Найти(Строка(Стр.Контейнер)) = неопределено И МассивОтфактурованныхКТКДоплаты.Найти(Строка(Стр.Контейнер)) = неопределено Тогда
				ВыбрКонтейнеры.Добавить(Строка(Стр.Контейнер));
			КонецЕсли;
			НДоходы.Себестоимость = Стр.Доплата_Доплата;
				
			НДоходы.Клиент = Стр.Доплата_Клиент;
			НДоходы.Договор = Стр.Доплата_Договор;
			НДоходы.Услуга = ВыбрУслуга;
			НДоходы.Калькуляция = Стр.Доплата_Калькуляция;
			НДоходы.Количество = ВыбрКонтейнеры.Количество();
			
			Если НДоходы.Количество = 0 Тогда
				Объект.Доходы.Удалить(НДоходы);
				Продолжить;
			КонецЕсли;
			
			НДоходы_Калькуляция = ПолучитьДанныеКалькуляции(НДоходы.Калькуляция);
						
			НДоходы.СтавкаНДС = НДоходы_Калькуляция.СтавкаНДС;
			НДоходы.НДСВключенВСтоимость = НДоходы_Калькуляция.СуммаВключаетНДС;
			НДоходы.РазмерКТК = Стр.РазмерКТК;
			НДоходы.Валюта = Стр.Доплата_Валюта;
			НДоходы.ПСЦ = Стр.Доплата_ПСЦ;
			НДоходы.Комментарий = "Добавлено автоматически при записи сделки с доплатными КТК";
			НДоходы.ГУИДСтрокиДохода = НДоходы.ГУИД;
			НДоходы.УслугаВнеСтавки = Истина;
			НДоходы.ГотовоКВыставлению = Истина;
			НДоходы.ЕдиницаИзмерения = НДоходы_Калькуляция.ЕдиницаИзмерения;
			НДоходы.ИсточникПоявленияСтрокиЭкономики = ПредопределенноеЗначение("Перечисление.ИсточникПоявленияСтрокиЭкономики.ПроизвольнаяУслугаВручную");
			НДоходы.ДоплатныеКТК = Истина;
			НДоходы.НоменклатурнаяГруппа = РазнесениеЗатратСервер.ПодобратьНоменклатурнуюГруппуПоНаборуПараметров(Объект.ТипЗаказа, "");
			
			
			НДоходы.Ставка 				= НДоходы.Себестоимость + НДоходы.Вознаграждение;
			НДоходы.Рентабельность 		= НДоходы.Вознаграждение / ?(НДоходы.Ставка = 0, 1, НДоходы.Ставка);
			
			НДоходы.СебестоимостьИтого 	= НДоходы.Количество * НДоходы.Себестоимость;
			НДоходы.ВознаграждениеИтого 	= НДоходы.Количество * НДоходы.Вознаграждение;
			НДоходы.СтавкаИтого 			= НДоходы.Количество * НДоходы.Ставка;
			
			НДоходы.СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиент.ПолучитьСуммуНДС(НДоходы.СтавкаИтого, БухгалтерскийУчетОбщиеПроцедурыКлиент.ПолучитьСтавкуНДС(НДоходы.СтавкаНДС), Истина, НДоходы.НДСВключенВСтоимость);
			
			НДоходы.СуммаИтого = НДоходы.СтавкаИтого + ?(НДоходы.НДСВключенВСтоимость, 0, НДоходы.СуммаНДС);
			
			НДоходы.СписокКТК = СтрСоединить(ВыбрКонтейнеры, ";");
			
			Если НайдСтр = неопределено Тогда
				НСтр = Объект.ДоходыКТК.Добавить();
			Иначе
				НСтр = НайдСтр;
			КонецЕсли;
			
			НСтр.ГУИД = НДоходы.ГУИД;
			НСтр.КТК = НДоходы.СписокКТК;
			
		КонецЕсли;
		
	КонецЦикла;
	
	//Евросиб Каблов 23.12.2025 ( #126470
	//Для каждого Стр из Объект.Доходы Цикл
	//	ДоходыПриИзменении(неопределено, Стр);
	//КонецЦикла;
	//доходы_ПересчитатьПериоды(неопределено, Истина);
	доходы_ПересчитатьПериоды(неопределено, Истина);
	ВосстановитьДоходыИзТЧНаСервере();
	Для каждого Стр из Объект.Доходы Цикл
		ДоходыПриИзменении(неопределено, Стр);
	КонецЦикла;
	//Евросиб Каблов 23.12.2025 ) #126470
	ЗаполнитьЕстьВР();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеКалькуляции(НДоходы_Калькуляция)
	
	Возврат Новый Структура("СтавкаНДС, СуммаВключаетНДС, ЕдиницаИзмерения", НДоходы_Калькуляция.СтавкаНДС, НДоходы_Калькуляция.СуммаВключаетНДС, НДоходы_Калькуляция.ЕдиницаИзмерения);
	
КонецФункции

&НаКлиенте
Функция НайтиДоходыКТК(ГУИД_Доходов)
	
	Результат = неопределено;
	
	Для каждого Стр из Объект.ДоходыКТК Цикл
		Если Стр.ГУИД = ГУИД_Доходов Тогда
			Результат = Стр;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция НайтиДоходыДоплатыПоПараметрам(Доплата_Калькуляция, Доплата_ПСЦ)
	
	Результат = Новый Массив;
	
	Для каждого Стр из Объект.Доходы Цикл
		Если Стр.ДоплатныеКТК = Истина И Стр.Калькуляция = Доплата_Калькуляция И Стр.ПСЦ = Доплата_ПСЦ Тогда
			Результат.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция КТКЕщеНеОформленВДоходах(Контейнер)
	
	Результат = Истина;
	
	Для каждого Стр из Объект.Доходы Цикл
		Если Стр.ДоплатныеКТК = Истина И Стр.Услуга = НоменклатураДоплат И СтрНайти(Стр.СписокКТК, Контейнер) <> 0 Тогда
			Результат = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаВыбораКлиентовИзСпискаДопУслуги(Параметр1, Параметр2) Экспорт
	
	Если Параметр1 = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	//Удалим не выбранных клиентов
	СтрокиДоговорыКУдалению = Новый Массив;
	Для каждого ГотовыйКОформлениюДоговор Из СписокГотовыхКОформлениюДоговоров Цикл
		//Если НЕ Параметр1.НайтиПоЗначению(ГотовыйКОформлениюДоговор.Клиент).Пометка Тогда
		//ДИТ, Беляев СЮ, Ticket#0286563 (US 58604), 04-10-2022, начало
		Если Параметр1.НайтиПоЗначению(ГотовыйКОформлениюДоговор.Клиент) = Неопределено Тогда
		//ДИТ, Беляев СЮ, Ticket#0286563 (US 58604), 04-10-2022, конец
			СтрокиДоговорыКУдалению.Добавить(ГотовыйКОформлениюДоговор);
		КонецЕсли; 
	КонецЦикла; 
	Для каждого СтрокаДоговорыКУдалению Из СтрокиДоговорыКУдалению Цикл
		СписокГотовыхКОформлениюДоговоров.Удалить(СтрокаДоговорыКУдалению);
	КонецЦикла;
	
	ВключитьВДоходыРасходыУслугиНевключенныеВСтавкуНаСервере();
	ПересчитатьПериодыНаСервере();
	
	Для каждого Стр из Объект.Доходы Цикл
		ДоходыПриИзменении(неопределено, Стр);
	КонецЦикла;
	Для каждого Стр из Объект.Расходы Цикл
		РасходыПриИзменении(неопределено, Стр);
		//Евросиб(ДИТ), Беляев СЮ, BUG 102612 / TA 114549, 17-07-2025, начало (регистр ФактическиеСуммыНакладныхОтнесенныеНаЗатратыСделок не используется)
		//Стр.СуммаРасходовИзАРМКонтроляСписанийИзРегистра = Услуги_сервер.ПолучитьСуммуАРМКонтроляСписаний(Объект.Ссылка, Стр.ГУИД, Стр.СписокКТК, Стр.Услуга);
		//Евросиб(ДИТ), Беляев СЮ, BUG 102612 / TA 114549, 17-07-2025, конец
	КонецЦикла;
	
	ЗаполнитьЕстьВР();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокиВЭкономикеПоУдаленнымСтрокамСоставаПоезда()

	//Если есть удаленные/измененные строки поезда, то по этим договорам нужно очистить экономику
	УдаленныеСтроки = Объект.СвязьУчетныхЕдиниц.НайтиСтроки(Новый Структура("Удалена", Истина));
	Для каждого УдаленнаяСтрока Из УдаленныеСтроки Цикл
		найдСтроки = Объект.Доходы.НайтиСтроки(Новый Структура("Договор", УдаленнаяСтрока.Договор));
		Для каждого найдСтрока Из найдСтроки Цикл
			Если ЗначениеЗаполнено(НайдСтрока.УчДокумент) Тогда
				обУчДокумент = найдСтрока.УчДокумент.ПолучитьОбъект();
				обУчДокумент.УстановитьПометкуУдаления(Истина);
			КонецЕсли; 
			Объект.Доходы.Удалить(найдСтрока);
		КонецЦикла; 
	КонецЦикла; 
	ИзмененныеСтроки = Объект.СвязьУчетныхЕдиниц.НайтиСтроки(Новый Структура("Изменена", Истина));
	Для каждого УдаленнаяСтрока Из УдаленныеСтроки Цикл
		найдСтроки = Объект.Доходы.НайтиСтроки(Новый Структура("Договор", УдаленнаяСтрока.Договор));
		Для каждого найдСтрока Из найдСтроки Цикл
			Если ЗначениеЗаполнено(НайдСтрока.УчДокумент) Тогда
				обУчДокумент = найдСтрока.УчДокумент.ПолучитьОбъект();
				обУчДокумент.УстановитьПометкуУдаления(Истина);
			КонецЕсли; 
			Объект.Доходы.Удалить(найдСтрока);
		КонецЦикла; 
	КонецЦикла; 

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЭкономику_ТолькоГотовыеТолькоМои(Команда)
	
	ЗаполнитьЭкономику_ТолькоГотовыеТолькоМоиНаКлиенте();

КонецПроцедуры

&НаКлиенте
Процедура ДоходыПериодВОПриИзменении(Элемент)
	
	ТекД = Элементы.Доходы.ТекущиеДанные;
	ТекД.ПравилоОпределенияДатыДокумента = "Установлен вручную";
	
КонецПроцедуры

&НаКлиенте
Процедура СвязьУчетныхЕдиницПортОтправленияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекД = Элементы.СвязьУчетныхЕдиниц.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыборПорта(ТекД,Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СвязьУчетныхЕдиницПортНазначенияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекД = Элементы.СвязьУчетныхЕдиниц.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыборПорта(ТекД,Ложь);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ВыборПорта(ТекД,Отправление)

	СписокПортов = Новый СписокЗначений;
	СписокПортов.ЗагрузитьЗначения(ПолучитьСписокПодходящихПортов(ТекД.Калькуляция,Отправление));
	
	ПараметрыОтбора = Новый СТруктура;
	ПараметрыОтбора.Вставить("ПодходящиеПорты",СписокПортов);
	
	ДопПараметры = Новый СТруктура;
	ДопПараметры.Вставить("Отправление",Отправление);
	ДопПараметры.Вставить("ТекД",ТекД);
	
	ОпОп = новый ОписаниеОповещения("ОбработкаВыбораПорта", ЭтаФорма, ДопПараметры);
	ОткрытьФорму("Справочник.Локации.ФормаВыбора",ПараметрыОтбора,ЭтаФорма, ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораПорта(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если параметр1 = Неопределено тогда 
		возврат; 
	КонецЕсли;
	
	Если Параметр2.Отправление Тогда
		Параметр2.ТекД.ПортОтправления = Параметр1;
	Иначе
		Параметр2.ТекД.ПортНазначения = Параметр1;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокПодходящихПортов(ТекКалькуляция,Отправление)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА КалькуляцияНФ_ПортыОтправленияНазначения.Ссылка.ФрахтИмпорт
	               |			ТОГДА КалькуляцияНФ_ПортыОтправленияНазначения.Порт
	               |		ИНАЧЕ КалькуляцияНФ_ПортыОтправленияНазначения.Ссылка.ММ_ПортОтправления
	               |	КОНЕЦ КАК ПортОтправления,
	               |	ВЫБОР
	               |		КОГДА КалькуляцияНФ_ПортыОтправленияНазначения.Ссылка.ФрахтИмпорт
	               |			ТОГДА КалькуляцияНФ_ПортыОтправленияНазначения.Ссылка.ММ_ПортОтправления
	               |		ИНАЧЕ КалькуляцияНФ_ПортыОтправленияНазначения.Порт
	               |	КОНЕЦ КАК ПортНазначения
	               |ИЗ
	               |	Документ.Калькуляция.НФ_ПортыОтправленияНазначения КАК КалькуляцияНФ_ПортыОтправленияНазначения
	               |ГДЕ
	               |	КалькуляцияНФ_ПортыОтправленияНазначения.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",ТекКалькуляция);

	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Если Отправление Тогда
		ТЗ.Свернуть("ПортОтправления");
		МассивПортов = ТЗ.ВыгрузитьКолонку("ПортОтправления");
	Иначе
		ТЗ.Свернуть("ПортНазначения");
		МассивПортов = ТЗ.ВыгрузитьКолонку("ПортНазначения");
	КонецЕсли;
	
	Возврат МассивПортов;
	
КонецФункции	
	
&НаКлиенте
Процедура ВставитьДатуПрибытияНаТерминалИзExcel(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ВставкаДатыПрибытияНаТерминал", ЭтаФорма);
	
	ОткрытьФорму("ОбщаяФорма.ВставкаИзБуфераОбмена", Новый Структура("КТК, РазмерКТК, ПоказыватьДатуВзятия, ПередаватьИсходныеНомера, ФорматДаты", Истина, Истина, Истина, Истина, 2), ЭтаФорма.УникальныйИдентификатор,,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВставкаДатыПрибытияНаТерминал(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = неопределено Тогда Возврат; КонецЕсли;
	
	Для Сч = 0 по П1.КТК.Количество() - 1 Цикл
		
		КТКНайден = Ложь;
		Для каждого Стр из Объект.СвязьУчетныхЕдиниц Цикл
			
			Если ТипЗнч(П1.КТК[Сч]) = Тип("Строка") Тогда
				Если Строка(Стр.Контейнер) = П1.КТК[Сч] Тогда КТКНайден = Истина; Стр.ВремяПрибытияНаТерминал = П1.ДатыКТК[Сч]; КонецЕсли;
			Иначе
				Если Стр.Контейнер = П1.КТК[Сч] Тогда КТКНайден = Истина; Стр.ВремяПрибытияНаТерминал = П1.ДатыКТК[Сч]; КонецЕсли;
			КонецЕсли; 
			
		КонецЦикла;
		Если НЕ КТКНайден Тогда
			
			Сообщить("Данные по контейнеру " + П1.КТК[Сч] + " не удалось записать в документ. Контейнер не найден.");
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

