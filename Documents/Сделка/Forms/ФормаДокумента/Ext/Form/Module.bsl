&НаСервере                                   
Процедура СоздатьСчетаCreditNoteНаСервере()
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Перевыставляемая", Ложь);
	СтруктураОтбора.Вставить("НеВыставлятьКлиенту", Ложь);
	
	ТаблицаДляФормированияCreditNote = Объект.Доходы.Выгрузить(СтруктураОтбора);
	ТаблицаДляФормированияCreditNote.Свернуть("Клиент, Договор, УчДокумент");
	ТаблицаДляФормированияCreditNote.Колонки.Добавить("СчетНаОплатуПокупателю", Новый ОписаниеТипов("ДокументыСсылка.СчетНаОплатуПокупателю"));
	
	Для Каждого СтрокаТЧ из ТаблицаДляФормированияCreditNote Цикл
		//Евросиб Каблов 04.08.2025 ( #115153
		//СтрокаТЧ.СчетНаОплатуПокупателю = СтрокаТЧ.УчДокумент.СчетНаОплатуПокупателю;
		СчетаПокупателю = ПечатьКомплектаДокументов.НайтиСчетаПоСделке(СтрокаТЧ.УчДокумент);
		Если ЗначениеЗаполнено(СчетаПокупателю) Тогда
			СчетПокупателю = СчетаПокупателю[0];
		Иначе
			СчетПокупателю = Документы.СчетНаОплатуПокупателю.ПустаяСсылка();
		КонецЕсли;
		//Евросиб Каблов 04.08.2025 )
	КонецЦикла;
	
	ТаблицаДляФормированияCreditNote.Свернуть("Клиент, Договор, СчетНаОплатуПокупателю");
	
	Для Каждого СтрокаТЧ из ТаблицаДляФормированияCreditNote Цикл
		МассивКомплектов = Документы.Сделка.СформироватьСчетНаОплатуПокупателюCreditNote(
								Объект.Ссылка,
								СтрокаТЧ.Клиент,
								СтрокаТЧ.Договор,
								СтрокаТЧ.СчетНаОплатуПокупателю);
								
		ШаблонСообщения = НСтр("ru = 'Создан документ Credit note ""%1""'");						
		Для i = 0 по МассивКомплектов.Количество() - 1 Цикл
			ТекстСоощения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
								ШаблонСообщения,
								МассивКомплектов[i].CreditNote);
			ОбщегоНазначения.СообщитьПользователю(ТекстСоощения);
		КонецЦикла;							
	КонецЦикла;
	
КонецПроцедуры //ДИТ Давудов М.А. Task32744 03.07.2021 Конец

