&НаСервере
Процедура НайтиПоЭТРАНВагоныИЖДННаСервере()
	
	Для каждого Стр из Объект.СвязьУчетныхЕдиниц Цикл
		
		Если ЗначениеЗаполнено(Стр.Контейнер) И НЕ ЗначениеЗаполнено(Стр.Вагон) Тогда
			РЕЗ = Слежение_сервер.ПолучитьПоследнийВагонЖДНПоКонтейнеру(Стр.Контейнер);
			Стр.Вагон = РЕЗ.Вагон;
			Стр.НомерЖДН = РЕЗ.ЖДН;
			Стр.ЖДН = Рез.ЖДНСсылка;
		ИначеЕсли ЗначениеЗаполнено(Стр.Контейнер) И ЗначениеЗаполнено(Стр.Вагон) И НЕ (ЗначениеЗаполнено(Стр.НомерЖДН) И ЗначениеЗаполнено(Стр.ЖДН)) Тогда
			Рез = Слежение_сервер.ПолучитьЖДНПоВагонуИКТК(Стр.Вагон, Стр.Контейнер);
			Если Не ЗначениеЗаполнено(Стр.НомерЖДН) Тогда
				 Стр.НомерЖДН = Рез.ЖДН;
			КонецЕсли;
			Стр.ЖДН = Рез.ЖДНСсылка;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ГрузыВОперациях_ДобавитьГрузы(Команда)
	
	СписокОпераций = СобратьПомеченныеОперацииТСх();
	СписокТЧ = Новый Массив;
	Для каждого Стр из Объект.СвязьУчетныхЕдиниц Цикл
		Если Стр.НеАктивна Тогда Продолжить; КонецЕсли;
		СписокТЧ.Добавить(Новый Структура("Вагон, Контейнер, ЖДН, Коносамент, Клиент, Калькуляция", Стр.Вагон, Стр.Контейнер, Стр.ЖДН, Стр.Коносамент, Стр.Клиент, Стр.Калькуляция));
	КонецЦикла;
	ОткрытьФорму("Документ.Сделка.Форма.ФормаОтметкиГрузовДляОпераций", Новый Структура("ТЧ, Операции", СписокТЧ, СписокОпераций),,ЭтаФорма.УникальныйИдентификатор,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	родитель_Отмена(неопределено);
	
