	Для каждого Стр из П1 Цикл
		
		СтрокаПоиска = Новый Структура;
		
		Если ЗначениеЗаполнено(Стр.Контейнер) Тогда
			
			СтрокаПоиска.Вставить("Контейнер", Стр.Контейнер);
			
		ИначеЕсли ЗначениеЗаполнено(Стр.Вагон) Тогда
			
			СтрокаПоиска.Вставить("Вагон", Стр.Вагон);
			
		КонецЕсли;
		
