	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("СписокОтклонений",ТЗРасхождений);
	ПараметрыОтбора.Вставить("СтатьяРасхождений","Несоблюдение цены");
	ОткрытьФорму("Документ.Сделка.Форма.ФормаРезультатовАвтодиагностики",ПараметрыОтбора,, ЭтаФорма.УникальныйИдентификатор, ,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Процедура ЦенаПеревозкиСервер()
	
	Возврат;	
	
	// удаляем из таблицы только те данные, которые сейчас будем обновлять
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("СтатьяРасхождений","Несоблюдение цены");
	НайденныеСтроки = ТЗРасхождений.НайтиСтроки(ПараметрыОтбора);
	Для Каждого Стр Из НайденныеСтроки Цикл
		ТЗРасхождений.Удалить(Стр);		
	КонецЦикла;
	
	// проверка для каждого КТК, соответствует ли его плановая цена (из калькуляции) цене в таблице Расходы
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СделкаСвязьУчетныхЕдиниц.Контейнер КАК Контейнер,
	               |	ВЫБОР
	               |		КОГДА СделкаСвязьУчетныхЕдиниц.РазмерКТК = ЗНАЧЕНИЕ(Справочник.РазмерыКТК.К20)
	               |			ТОГДА СделкаСвязьУчетныхЕдиниц.Калькуляция.ММ_ИтогоВознаграждение20
	               |		ИНАЧЕ СделкаСвязьУчетныхЕдиниц.Калькуляция.ММ_ИтогоВознаграждение
	               |	КОНЕЦ КАК ВознаграждениеПлан,
	               |	ВЫБОР
	               |		КОГДА СделкаСвязьУчетныхЕдиниц.РазмерКТК = ЗНАЧЕНИЕ(Справочник.РазмерыКТК.К20)
	               |			ТОГДА СделкаСвязьУчетныхЕдиниц.Калькуляция.ММ_ИтогоРентабельность20
	               |		ИНАЧЕ СделкаСвязьУчетныхЕдиниц.Калькуляция.ММ_ИтогоРентабельность
	               |	КОНЕЦ КАК РентабельностьПлан,
	               |	ВЫБОР
	               |		КОГДА СделкаСвязьУчетныхЕдиниц.РазмерКТК = ЗНАЧЕНИЕ(Справочник.РазмерыКТК.К20)
	               |			ТОГДА СделкаСвязьУчетныхЕдиниц.Калькуляция.ММ_ИтогоСебестоимость20
	               |		ИНАЧЕ СделкаСвязьУчетныхЕдиниц.Калькуляция.ММ_ИтогоСебестоимость
	               |	КОНЕЦ КАК СебестоимостьПлан,
	               |	ВЫБОР
	               |		КОГДА СделкаСвязьУчетныхЕдиниц.РазмерКТК = ЗНАЧЕНИЕ(Справочник.РазмерыКТК.К20)
	               |			ТОГДА СделкаСвязьУчетныхЕдиниц.Калькуляция.ММ_ИтогоСтавка20
	               |		ИНАЧЕ СделкаСвязьУчетныхЕдиниц.Калькуляция.ММ_ИтогоСтавка
	               |	КОНЕЦ КАК СтоимостьПлан
	               |ПОМЕСТИТЬ ПлановыеСуммы
	               |ИЗ
	               |	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	               |ГДЕ
	               |	СделкаСвязьУчетныхЕдиниц.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СделкаРасходы.Себестоимость КАК СебестоимостьФакт,
	               |	СделкаРасходы.ВознаграждениеИтого / ВЫБОР
	               |		КОГДА ЕСТЬNULL(СделкаРасходы.Количество, 0) = 0
	               |				ИЛИ СделкаРасходы.Количество = 0
	               |			ТОГДА 1
	               |		ИНАЧЕ СделкаРасходы.Количество
	               |	КОНЕЦ КАК ВознаграждениеФакт,
	               |	СделкаРасходы.СуммаИтого / ВЫБОР
	               |		КОГДА ЕСТЬNULL(СделкаРасходы.Количество, 0) = 0
	               |				ИЛИ СделкаРасходы.Количество = 0
	               |			ТОГДА 1
	               |		ИНАЧЕ СделкаРасходы.Количество
	               |	КОНЕЦ КАК СтоимостьФакт,
	               |	СделкаДоходыКТК.КТК КАК КТК
	               |ПОМЕСТИТЬ ФактическиеСуммы
	               |ИЗ
	               |	Документ.Сделка.Расходы КАК СделкаРасходы
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.ДоходыКТК КАК СделкаДоходыКТК
	               |		ПО СделкаРасходы.Ссылка = СделкаДоходыКТК.Ссылка
	               |			И СделкаРасходы.ГУИД = СделкаДоходыКТК.ГУИД
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПлановыеСуммы.Контейнер КАК Контейнер,
	               |	СУММА(ФактическиеСуммы.СебестоимостьФакт) КАК СебестоимостьФакт,
	               |	СУММА(ФактическиеСуммы.ВознаграждениеФакт) КАК ВознаграждениеФакт,
	               |	СУММА(ФактическиеСуммы.СтоимостьФакт) КАК СтоимостьФакт,
	               |	СУММА(ВЫБОР
	               |			КОГДА НЕ ЕСТЬNULL(ФактическиеСуммы.СтоимостьФакт, 0) = 0
	               |					И НЕ ФактическиеСуммы.СтоимостьФакт = 0
	               |				ТОГДА ФактическиеСуммы.ВознаграждениеФакт / ФактическиеСуммы.СтоимостьФакт * 100
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК РентабельностьФакт
	               |ПОМЕСТИТЬ ФактическиеСуммыИтого
	               |ИЗ
	               |	ПлановыеСуммы КАК ПлановыеСуммы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ФактическиеСуммы КАК ФактическиеСуммы
	               |		ПО (ФактическиеСуммы.КТК ПОДОБНО ""%"" + ПлановыеСуммы.Контейнер.Наименование + ""%"")
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПлановыеСуммы.Контейнер
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПлановыеСуммы.Контейнер КАК Контейнер,
	               |	ПлановыеСуммы.ВознаграждениеПлан КАК ВознаграждениеПлан,
	               |	ПлановыеСуммы.РентабельностьПлан КАК РентабельностьПлан,
	               |	ПлановыеСуммы.СебестоимостьПлан КАК СебестоимостьПлан,
	               |	ПлановыеСуммы.СтоимостьПлан КАК СтоимостьПлан,
	               |	ФактическиеСуммыИтого.СебестоимостьФакт КАК СебестоимостьФакт,
	               |	ФактическиеСуммыИтого.ВознаграждениеФакт КАК ВознаграждениеФакт,
	               |	ФактическиеСуммыИтого.СтоимостьФакт КАК СтоимостьФакт,
	               |	ФактическиеСуммыИтого.РентабельностьФакт КАК РентабельностьФакт
	               |ИЗ
	               |	ПлановыеСуммы КАК ПлановыеСуммы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ФактическиеСуммыИтого КАК ФактическиеСуммыИтого
	               |		ПО ПлановыеСуммы.Контейнер = ФактическиеСуммыИтого.Контейнер";
	
	Запрос.УстановитьПараметр("Ссылка",Объект.Ссылка);
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Стр Из ТЗ Цикл
		Если Стр.ВознаграждениеПлан <> Стр.ВознаграждениеФакт ИЛИ
			Стр.РентабельностьПлан <> Стр.РентабельностьФакт ИЛИ
			Стр.СебестоимостьПлан <> Стр.СебестоимостьФакт ИЛИ
			Стр.СтоимостьПлан <> Стр.СтоимостьФакт Тогда
			НовСтр = ТЗРасхождений.Добавить();
			НовСтр.СтатьяРасхождений = "Несоблюдение цены";
			ЗаполнитьЗначенияСвойств(НовСтр,Стр);
		КонецЕсли;
	КонецЦикла;
	
	КартинкаОшибки = БиблиотекаКартинок.СостоянияРасширенийОшибка;
	КартинкаВерно = БиблиотекаКартинок.СостоянияРасширенийПодключено;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("СтатьяРасхождений","Несоблюдение цены");
	НайденныеСтр = ТЗРасхождений.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеСтр.Количество()>0 Тогда
		Элементы.прав_ЦенаПеревозки.Картинка = КартинкаОшибки;
	Иначе
		Элементы.прав_ЦенаПеревозки.Картинка = КартинкаВерно;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура лев_ЦенаПеревозки(Команда)
	
	ЦенаПеревозкиСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура лев_МаршрутПеревозки(Команда)
	
	МаршрутПеревозкиСервер();
	
