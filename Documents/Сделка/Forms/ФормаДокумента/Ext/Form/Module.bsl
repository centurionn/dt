&НаКлиенте
Процедура ДоходыПриИзменении(Элемент, Знач ТекД = неопределено)
	
	Если ТекД = неопределено Тогда
		ТекД = Элементы.Доходы.ТекущиеДанные;
	КонецЕсли;
	Если ТекД <> неопределено Тогда
		
		ТекД.Ставка 				= ТекД.Себестоимость + ТекД.Вознаграждение;
		
		//Евросиб Каблов 23.12.2025 ( #126470
		Начало2026года = '20260101';
		//Начало2026года = '20251201'; //тест
		СтавкаНДС20 = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20");
		СтавкаНДС22 = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22");
		
		Если ТекД.ДатаОказанияУслуги >= Начало2026года  Тогда
			
			Если ТекД.СтавкаНДС = СтавкаНДС20 Тогда
				ТекД.СтавкаНДС = СтавкаНДС22;
			КонецЕсли;
			
			Если ТекД.НДСВключенВСтоимость И ТекД.СтавкаНДСвКалькуляции = СтавкаНДС20 Тогда
				Если Не ТекД.ПересчитатьСтавкуУслугиВСчетНДС22 Тогда
					//Евросиб Каблов 14.01.2026 ( #127918
					//ТекД.Ставка = ТекД.Ставка * 122 / 120;
					СуммаНДС20 = Окр(БухгалтерскийУчетОбщиеПроцедурыКлиент.ПолучитьСуммуНДС(ТекД.Ставка, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(СтавкаНДС20), Истина, ТекД.НДСВключенВСтоимость), 2);
					СтавкаБезНДС20 = ТекД.Ставка - СуммаНДС20;
					СуммаНДС22 = Окр(БухгалтерскийУчетОбщиеПроцедурыКлиент.ПолучитьСуммуНДС(СтавкаБезНДС20, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(ТекД.СтавкаНДС), Истина, Ложь), 2);
					ТекД.Ставка = СтавкаБезНДС20 + СуммаНДС22;
					//Евросиб Каблов 14.01.2026 ) #127918
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ТекД.ДатаОказанияУслуги < Начало2026года Тогда
			
			Если ТекД.СтавкаНДС = СтавкаНДС22 Тогда
				ТекД.СтавкаНДС = СтавкаНДС20;
			КонецЕсли;
			
		КонецЕсли;		
		//Евросиб Каблов 23.12.2025 )
		
		ТекД.Рентабельность 		= ТекД.Вознаграждение / ?(ТекД.Ставка = 0, 1, ТекД.Ставка);
		
		ТекД.СебестоимостьИтого 	= ТекД.Количество * ТекД.Себестоимость;
		ТекД.ВознаграждениеИтого 	= ТекД.Количество * ТекД.Вознаграждение;
		ТекД.СтавкаИтого 			= ТекД.Количество * ТекД.Ставка;
		
		ТекД.СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиент.ПолучитьСуммуНДС(ТекД.СтавкаИтого, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(ТекД.СтавкаНДС), Истина, ТекД.НДСВключенВСтоимость);
		
		ТекД.СуммаИтого = ТекД.СтавкаИтого + ?(ТекД.НДСВключенВСтоимость, 0, ТекД.СуммаНДС);
		
		// Евросиб US 120100 TA 122907 Рыбьяков К.А. 10.11.2025 ((
		ЗаполнитьСвязаннуюСтрокуРасходов(ТекД);
		// Евросиб Рыбьяков К.А. 10.11.2025 ))
		
	КонецЕсли;
	
КонецПроцедуры

