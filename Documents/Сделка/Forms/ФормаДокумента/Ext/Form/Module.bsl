&НаКлиенте
Процедура СогласованиеБезМаршрутаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ ТипЗнч(Результат) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписатьДокумент = Ложь;
	
	ИндексСтроки = ДополнительныеПараметры.ИндексСтроки;
	
	Если Результат.Свойство("Исполнитель")
	   И ЗначениеЗаполнено(Результат.Исполнитель)
	   И Объект.Состояния[ИндексСтроки].Исполнитель <> Результат.Исполнитель Тогда
		Объект.Состояния[ИндексСтроки].Исполнитель = Результат.Исполнитель;
		ЗаписатьДокумент = Истина;
	Иначе
		Если Результат.Свойство("ОбновитьСтатус")
		   И Результат.ОбновитьСтатус = Истина Тогда
			Объект.Состояния[ИндексСтроки].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Выполнен");
			ЗаписатьДокумент = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗаписатьДокумент Тогда
		Записать();
		Прочитать();
	КонецЕсли;
	
КонецПроцедуры // ДИТ 64186 Давудов М.А. Конец: 07.03.2023

