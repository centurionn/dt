&НаКлиенте
Процедура оглавление_СкопироватьТСх(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораСхемы", ЭтаФорма);
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("Сделка", Объект.Ссылка);
	МассивТСх = Новый Массив;
	Для каждого Стр из ТСхОглавление.ПолучитьЭлементы() Цикл
		МассивТСх.Добавить(Новый Структура("Вариант, ЭлементТСх", Стр.Вариант, Стр.ЭлементТСх));
	КонецЦикла;
	СтруктураПараметров.Вставить("МассивТСх", МассивТСх);
	
	ОткрытьФорму("Документ.Сделка.Форма.ФормаКопированиеТСх", СтруктураПараметров,, ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
