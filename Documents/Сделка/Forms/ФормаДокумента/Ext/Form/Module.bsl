	ПараметрыОтбора.Вставить("СтатьяРасхождений","Несоблюдение операции");
	ОткрытьФорму("Документ.Сделка.Форма.ФормаРезультатовАвтодиагностики",ПараметрыОтбора,, ЭтаФорма.УникальныйИдентификатор, ,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

