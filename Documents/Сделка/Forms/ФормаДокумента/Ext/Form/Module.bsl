		               |	СделкаРасходы.Подсыл КАК Подсыл,
		               |	СделкаРасходы.ГУИД КАК ГУИД_СвязьУчетныхЕдиниц,
		               |	СделкаРасходы.ПунктОтправления КАК ПунктОтправления,
		               |	СделкаРасходы.ПунктНазначения КАК ПунктНазначения
		               |ПОМЕСТИТЬ РасходыИтого
		               |ИЗ
		               |	Т3 КАК Т3
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.Расходы КАК СделкаРасходы
		               |			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.ДоходыКТК КАК СделкаДоходыКТК
		               |			ПО СделкаРасходы.ГУИД = СделкаДоходыКТК.ГУИД
		               |				И СделкаРасходы.Ссылка = СделкаДоходыКТК.Ссылка
		               |		ПО Т3.Ссылка = СделкаРасходы.Ссылка
		               |ГДЕ
		               |	СделкаДоходыКТК.КТК ПОДОБНО &КТК
		               |	И СделкаРасходы.Подсыл
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	РасходыИтого.Ссылка КАК Ссылка,
		               |	РасходыИтого.НомерСтроки КАК НомерСтроки,
		               |	РасходыИтого.Поставщик КАК Поставщик,
		               |	РасходыИтого.Договор КАК Договор,
		               |	РасходыИтого.Услуга КАК Услуга,
		               |	РасходыИтого.Калькуляция КАК Калькуляция,
		               |	РасходыИтого.Себестоимость КАК Себестоимость,
		               |	РасходыИтого.Количество КАК Количество,
		               |	РасходыИтого.СебестоимостьИтого КАК СебестоимостьИтого,
		               |	РасходыИтого.СтавкаНДС КАК СтавкаНДС,
		               |	РасходыИтого.СуммаНДС КАК СуммаНДС,
		               |	РасходыИтого.НДСВключенВСтоимость КАК НДСВключенВСтоимость,
		               |	РасходыИтого.СуммаИтого КАК СуммаИтого,
		               |	РасходыИтого.ГУИД КАК ГУИД,
		               |	РасходыИтого.ТипВагонов КАК ТипВагонов,
		               |	РасходыИтого.ТипКТК КАК ТипКТК,
		               |	РасходыИтого.Груз КАК Груз,
		               |	РасходыИтого.Операция КАК Операция,
		               |	РасходыИтого.ВознаграждениеИтого КАК ВознаграждениеИтого,
		               |	РасходыИтого.ПериодВО КАК ПериодВО,
		               |	РасходыИтого.УчДокумент КАК УчДокумент,
		               |	РасходыИтого.ОтнестиНаЗатраты КАК ОтнестиНаЗатраты,
		               |	РасходыИтого.Валюта КАК Валюта,
		               |	РасходыИтого.Перевыставляемая КАК Перевыставляемая,
		               |	РасходыИтого.КатегорияРасходов КАК КатегорияРасходов,
		               |	РасходыИтого.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
		               |	РасходыИтого.Регламентный КАК Регламентный,
		               |	РасходыИтого.СуммаРасходовИзАРМКонтроляСписаний КАК СуммаРасходовИзАРМКонтроляСписаний,
		               |	РасходыИтого.Подсыл КАК Подсыл,
		               |	РасходыИтого.ПунктОтправления КАК ПунктОтправления,
		               |	РасходыИтого.ПунктНазначения КАК ПунктНазначения
		               |ИЗ
		               |	РасходыИтого КАК РасходыИтого
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	АкцептУслуги.Ссылка КАК АкцептСсылка,
		               |	АкцептУслуги.НомерСтроки КАК НомерСтроки,
		               |	АкцептУслуги.ИдентификаторСтрокиРасходовВСделке КАК ГУИДРасходовВСделке,
		               |	РасходыИтого.Ссылка КАК СделкаСсылка,
		               |	АкцептУслуги.Ссылка.Поступление КАК Поступление
		               |ИЗ
		               |	РасходыИтого КАК РасходыИтого
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Акцепт.Услуги КАК АкцептУслуги
		               |		ПО РасходыИтого.Ссылка = АкцептУслуги.Сделка
		               |			И РасходыИтого.ГУИД = АкцептУслуги.ИдентификаторСтрокиРасходовВСделке
		               |			И (АкцептУслуги.Контейнер.Наименование = &КТК)
		               |ГДЕ
		               |	АкцептУслуги.Ссылка В (&АктуальныеАкцепты)
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ДанТекСделки.ГУИД КАК ГУИД,
		               |	ДанТекСделки.НомерСтроки КАК НомерСтроки,
		               |	ДанТекСделки.Контейнер КАК Контейнер
		               |ИЗ
		               |	ДанТекСделки КАК ДанТекСделки
		               |ГДЕ
		               |	ДанТекСделки.Контейнер.Наименование = &КТК";
		Запрос.УстановитьПараметр("КТК", Стр.Наименование);
		Запрос.УстановитьПараметр("ДатаЪ", Дата);
		Запрос.УстановитьПараметр("ТекСделкаСсылка", ТекСделкаСсылка);
		Запрос.УстановитьПараметр("АктуальныеАкцепты", МасАктуальныеАкцепты);
		Резы = Запрос.ВыполнитьПакет();
		
		МасАкцептов = Новый Массив;
		СоотГУИД = Новый Соответствие;
		СоотСделкам = Новый Соответствие;
		Ответ = Резы[5].Выбрать();
		
		ТЗ_СоотвУчЕд = Резы[7].Выгрузить();
		
		МассивРасходовПоКТК = Новый Массив;
		Если Ответ.Количество() > 0 Тогда
			
			Соот_СвязьУчЕдиниц = Новый Соответствие;
			Если ТЗ_СоотвУчЕд.Количество() = 1 Тогда
				Соот_СвязьУчЕдиниц.Вставить(Стр, ТЗ_СоотвУчЕд[0].ГУИД);
			КонецЕсли; 
			
			Результат.Вставить(Стр, Новый Структура("МассивРасходовПоКТК, МасАкцептов, Соот_СвязьУчЕдиниц", МассивРасходовПоКТК, МасАкцептов, Соот_СвязьУчЕдиниц) );
			
		КонецЕсли; 
		
		Пока Ответ.Следующий() Цикл
			
			ИтогТЗВаг = Ответ.Ссылка.ДоходыВагоны.Выгрузить(Новый Структура("ГУИД", Ответ.ГУИД));
			
			СоотВаг = Новый Соответствие;
			СоотВаг.Вставить(Стр, ИтогТЗВаг.ВыгрузитьКолонку("Вагон"));
			
			ИтогТЗ_ТД = Ответ.Ссылка.ДоходыТД.Выгрузить(Новый Структура("ГУИД", Ответ.ГУИД));
			
			СоотТД = Новый Соответствие;
			СоотТД.Вставить(Стр, ИтогТЗ_ТД.ВыгрузитьКолонку("ТД"));
			
			NEW_ГУИД = Строка(Новый УникальныйИдентификатор());
			
			МассивРасходовПоКТК.Добавить(Новый Структура("СоотВаг, СоотТД, NEW_ГУИД,Сделка,Поставщик,Договор,Услуга,Калькуляция,Себестоимость,Количество,СебестоимостьИтого,СтавкаНДС,НДСВключенВСтоимость,ГУИД,ТипВагонов,ТипКТК,Груз,Операция,ПериодВО,ПунктОтправления,ПунктНазначения,УчДокумент,ОтнестиНаЗатраты,Валюта,Перевыставляемая,КатегорияРасходов,НоменклатурнаяГруппа,Регламентный",
			СоотВаг, СоотТД, NEW_ГУИД, Ответ.Ссылка,Ответ.Поставщик,Ответ.Договор,Ответ.Услуга,Ответ.Калькуляция,Ответ.Себестоимость,Ответ.Количество,Ответ.СебестоимостьИтого,Ответ.СтавкаНДС,Ответ.НДСВключенВСтоимость,Ответ.ГУИД,Ответ.ТипВагонов,Ответ.ТипКТК,Ответ.Груз,Ответ.Операция,Ответ.ПериодВО,Ответ.ПунктОтправления,Ответ.ПунктНазначения,Ответ.УчДокумент,Ответ.ОтнестиНаЗатраты,Ответ.Валюта,Ответ.Перевыставляемая,Ответ.КатегорияРасходов,Ответ.НоменклатурнаяГруппа,Ответ.Регламентный));
			
			СоотГУИД.Вставить(Ответ.ГУИД, NEW_ГУИД);
			
		КонецЦикла;
		
		ВыборкаАкцепты = Резы[6].Выбрать();
		
		СоотАктуальныеАкцепты = Новый Соответствие;
		
		Пока ВыборкаАкцепты.Следующий() Цикл
			
			ЗначАкцепт = СоотАктуальныеАкцепты.Получить( ВыборкаАкцепты.Поступление );
			
			Если ЗначАкцепт = Неопределено Тогда
				АктуальныйАкцепт = Документы.Акцепт.НайтиСоздатьАктуальныйАкцепт( ВыборкаАкцепты.Поступление );
				СоотАктуальныеАкцепты.Вставить(ВыборкаАкцепты.Поступление, АктуальныйАкцепт);
			Иначе
				АктуальныйАкцепт = ЗначАкцепт;
			КонецЕсли; 
			
			
			ЗнПоКл = СоотГУИД.Получить(ВыборкаАкцепты.ГУИДРасходовВСделке);
			NEW_ГУИД = ?(ЗнПоКл=Неопределено, "", ЗнПоКл);
			
			МасАкцептов.Добавить(Новый Структура("ГУИДРасходовВСделке, Сделка_OLD, Акцепт, НомерСтрАкц, NEW_ГУИД", 
					ВыборкаАкцепты.ГУИДРасходовВСделке, ВыборкаАкцепты.СделкаСсылка, ВыборкаАкцепты.АкцептСсылка, ВыборкаАкцепты.НомерСтроки, NEW_ГУИД) );
			
		КонецЦикла;
		
	КонецЦикла; 
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьПеревыставляемыеПоПТУ(Команда)
	
	ОпОп = новый ОписаниеОповещения("ОбрабокаПТУДляПеревыставления", ЭтаФорма);
	ОткрытьФорму("Документ.ПоступлениеТоваровУслуг.ФормаВыбора",,,ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбрабокаПТУДляПеревыставления(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	СтруктурыДанныхДляСделки = ПолучитьСтруктурыДанныхДляСделки(Параметр1);
	
	Для каждого Стр из СтруктурыДанныхДляСделки.Доходы Цикл
		НСтр = Объект.Доходы.Добавить();
		ЗаполнитьЗначенияСвойств(НСтр, Стр);
		//ДИТ, Беляев СЮ, ТА48688, 28-03-2022, начало 
		НСтр.ДатаПоявленияСтрокиЭкономики = ТекущаяДата();
		//ДИТ, Беляев СЮ, ТА48688, 28-03-2022, конец
	КонецЦикла;
	
	Для каждого Стр из СтруктурыДанныхДляСделки.Расходы Цикл
		НСтр = Объект.Расходы.Добавить();
		ЗаполнитьЗначенияСвойств(НСтр, Стр);
	КонецЦикла;
	
	Для каждого Стр из СтруктурыДанныхДляСделки.ДоходыКТК Цикл
		НСтр = Объект.ДоходыКТК.Добавить();
		ЗаполнитьЗначенияСвойств(НСтр, Стр);
	КонецЦикла;
	
	Для каждого Стр из СтруктурыДанныхДляСделки.СвязьДоходовИРасходов Цикл
		НСтр = Объект.СвязьДоходовИРасходов.Добавить();
		ЗаполнитьЗначенияСвойств(НСтр, Стр);
	КонецЦикла;
	
КонецПроцедуры

