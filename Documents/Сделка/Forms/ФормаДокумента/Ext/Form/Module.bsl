Функция ПолучитьСуммуАРМКонтроляСписаний(Сделка)

	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ
	                |	ФактическиеСуммыНакладныхОтнесенныеНаЗатратыСделок.Сделка КАК Сделка,
	                |	ФактическиеСуммыНакладныхОтнесенныеНаЗатратыСделок.ГУИДРасходов КАК ГУИДРасходов,
	                |	СУММА(ФактическиеСуммыНакладныхОтнесенныеНаЗатратыСделок.ОтнесеннаяСумма) КАК ОтнесеннаяСумма
	                |ИЗ
	                |	РегистрСведений.ФактическиеСуммыНакладныхОтнесенныеНаЗатратыСделок КАК ФактическиеСуммыНакладныхОтнесенныеНаЗатратыСделок
	                |ГДЕ
	                |	ФактическиеСуммыНакладныхОтнесенныеНаЗатратыСделок.Сделка = &Сделка
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	ФактическиеСуммыНакладныхОтнесенныеНаЗатратыСделок.Сделка,
	                |	ФактическиеСуммыНакладныхОтнесенныеНаЗатратыСделок.ГУИДРасходов" ;
	Запрос.УстановитьПараметр("Сделка", Сделка);
	Ответ = Запрос.Выполнить().Выгрузить();
	Ответ.Индексы.Добавить("Сделка, ГУИДРасходов");

	Возврат Ответ;
	
КонецФункции

