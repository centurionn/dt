	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура оглавление_ПрочитатьТСхПротоколов(Команда)
	
	МассивЗаявок = Новый Массив;
	Для каждого Сто из Объект.Заявки Цикл
		МассивЗаявок.Добавить(Сто.Заявка);
	КонецЦикла;
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораТСхДляПереноса", ЭтаФорма);
	ОткрытьФорму("Документ.Сделка.Форма.ФормаВыборТСхПротоколовДляПереноса", Новый Структура("МассивЗаявок", МассивЗаявок), , ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораТСхДляПереноса(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	Для каждого Стр из Параметр1 Цикл
		
		НСтр = ТСхОглавление.ПолучитьЭлементы().Добавить();
		НСтр.Вариант = Стр.Вариант + " " + Строка(новый УникальныйИдентификатор);
		НСхема = ПостроительТСх_сервер.СкопироватьТСх(Стр.ТСх);
		НСтр.ЭлементТСх = НСхема;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура оглавление_ПереименоватьТСх(Команда)
	
	ТекД = Элементы.ТСхОглавление.ТекущиеДанные;
	Если ТекД = неопределено Тогда Возврат; КонецЕсли;
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаПереименования", ЭтаФорма);
	ПоказатьВводСтроки(ОпОп, ТекД.Вариант, "Введите новое имя схемы", 20, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаПереименования(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	ТекД = Элементы.ТСхОглавление.ТекущиеДанные;
	ПостроительТСх_сервер.ПереименоватьТСх(Объект.Ссылка, ТекД.Вариант, Параметр1, ТекД.ЭлементТСх);
	ТекД.Вариант = Параметр1;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзмениласьОперация" Тогда
		ОпНайдена = Ложь;
		Для каждого стр из ТЧ Цикл
			Если стр.Операция = Параметр Тогда ОпНайдена = Истина; Прервать; КонецЕсли;
		КонецЦикла;
		Если ОпНайдена Тогда
			Дерево.ПолучитьЭлементы().Очистить();
			ТЧ.Очистить();
			ПостроитьДеревоПоЭлементу();
			ПерестроитьДеревоПоТЧ();
		КонецЕсли;
	//ИначеЕсли ИмяСобытия = "ДокументыДляСделкиСозданы" И Параметр = Объект.Ссылка Тогда //ДИТ, Беляев СЮ, Ticket#0335269, 04-04-2024, закомментировал блок ИмяСобытия = "ДокументыДляСделкиСозданы"
	//	выставление_НайтиИПривязатьРеализации(неопределено);
	//	Модифицированность = Истина;
	ИначеЕсли ИмяСобытия = "ПеречитатьСхему" Тогда
		ОтменитьРедактирование(неопределено);
	ИначеЕсли ИмяСОбытия = "КорректировкиВнесены" и ТипЗнч(Параметр) = Тип("Структура") Тогда
		Для каждого Эл из Параметр.Строки Цикл             
			Если Не ЗначениеЗаполнено(Эл.ДокументКорректировкиНовый) Тогда 
				Если (Эл.СуммаИтого <> Эл.СуммаИтогоПосле) Тогда
					СтруктураОтбора = Новый Структура;
					СтруктураОтбора.Вставить("ГУИД",Эл.ГУИД);
					СтрДок = Объект.Доходы.НайтиСтроки(СтруктураОтбора);
					Если СтрДок.Количество() > 0 Тогда
						СтрДок[0].Себестоимость = Эл.СебестоимостьПОсле;
						СтрДок[0].Вознаграждение = Эл.ВознаграждениеПОсле;
						СтрДок[0].Ставка    = Эл.СтавкаПОсле;
						СтрДок[0].Количество    = Эл.КоличествоПОсле;
					    СтрДок[0].СебестоимостьИтого   = Эл.СебестоимостьИтогоПОсле;
			            СтрДок[0].ВознаграждениеИтого   = Эл.ВознаграждениеИтогоПОсле;
						СтрДок[0].СтавкаИтого    = Эл.СтавкаИтогоПОсле;
						СтрДок[0].СтавкаНДС      = Эл.СтавкаНДСПОсле;
						СтрДок[0].СуммаНДС    = Эл.СуммаНДСПОсле;
						СтрДок[0].СуммаИтого   = Эл.СуммаИтогоПОсле;
					КонецЕсли;
				ИначеЕсли (Эл.СуммаИтогоПосле <> Эл.СуммаИтогоПослеИзм) Тогда
					СтруктураОтбора = Новый Структура;
					СтруктураОтбора.Вставить("ГУИД",Эл.ГУИД);
					СтрДок = Объект.Доходы.НайтиСтроки(СтруктураОтбора);
					Если СтрДок.Количество() > 0 Тогда
						СтрДок[0].Себестоимость = Эл.СебестоимостьПОслеИзм;
						СтрДок[0].Вознаграждение = Эл.ВознаграждениеПОслеИзм;
						СтрДок[0].Ставка    = Эл.СтавкаПОслеИзм;
						СтрДок[0].Количество    = Эл.КоличествоПОслеИзм;
					    СтрДок[0].СебестоимостьИтого   = Эл.СебестоимостьИтогоПОслеИзм;
			            СтрДок[0].ВознаграждениеИтого   = Эл.ВознаграждениеИтогоПОслеИзм;
						СтрДок[0].СтавкаИтого    = Эл.СтавкаИтогоПОслеИзм;
						СтрДок[0].СтавкаНДС      = Эл.СтавкаНДСПОслеИЗм;
						СтрДок[0].СуммаНДС    = Эл.СуммаНДСПОслеИзм;
						СтрДок[0].СуммаИтого   = Эл.СуммаИтогоПОслеИзм;
					КонецЕсли;
					
				КОнецЕсли;
			Иначе
				Если (Эл.СуммаИтогоПосле <> Эл.СуммаИтогоПослеИзм) Тогда//и Не ЗначениеЗаполнено(Эл.УчДокумент) Тогда
					СтруктураОтбора = Новый Структура;
					СтруктураОтбора.Вставить("ГУИД",Эл.ГУИД);
					СтрДок = Объект.Доходы.НайтиСтроки(СтруктураОтбора);
					Если СтрДок.Количество() > 0 Тогда
						СтрДок[0].Себестоимость = Эл.СебестоимостьПОслеИзм;
						СтрДок[0].Вознаграждение = Эл.ВознаграждениеПОслеИзм;
						СтрДок[0].Ставка    = Эл.СтавкаПОслеИзм;
						СтрДок[0].Количество    = Эл.КоличествоПОслеИзм;
					    СтрДок[0].СебестоимостьИтого   = Эл.СебестоимостьИтогоПОслеИзм;
			            СтрДок[0].ВознаграждениеИтого   = Эл.ВознаграждениеИтогоПОслеИзм;
						СтрДок[0].СтавкаИтого    = Эл.СтавкаИтогоПОслеИзм;
						СтрДок[0].СтавкаНДС      = Эл.СтавкаНДСПОслеИзм;
						СтрДок[0].СуммаНДС    = Эл.СуммаНДСПОслеИзм;
						СтрДок[0].СуммаИтого   = Эл.СуммаИтогоПОслеИзм;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Модифицированность = Истина;
	ИначеЕсли ИмяСобытия = "ОбновленыПризнакиРазрешенияКорректировокРТУ" Тогда
		КорректировкиРТУСерверУстановитьВидимостьДанныхКорректировки();
	ИначеЕсли ИмяСобытия = "ОповещениеОбИсключенииКТКИзСделки" И ЭтаФорма.УникальныйИдентификатор = Источник Тогда
		//ДИТ, Беляев СЮ, US 66796 / TA 72732, 20-07-2023, начало (закомментировал)
		//// Евросиб Фролов (15.04.2022 Task №48577
		//// Если КТК исключаются из сделки и не переносятся в другую сделку, то необходимо
		//// проверить наличие привязанных расходов.
		//Если ТипЗнч(Параметр) <> Тип("ДокументСсылка.Сделка") Тогда
