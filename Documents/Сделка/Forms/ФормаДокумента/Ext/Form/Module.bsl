	//ДИТ, Беляев СЮ, Ticket#0259010, 01-02-2022, конец
	
	// Евросиб US 120424 TA 122733 Рыбьяков К.А. 16.11.2025 ((
	ВключитьБлокировкуОчередиОтложенногоИзмененияНаСервере(Объект.Ссылка, 720);
	// Евросиб Рыбьяков К.А. 16.11.2025 ))
	
	//ОткрытьФорму("Документ.Сделка.Форма.ФормаСозданияКомплектаДокументов", ПараметрыФормы);
	//ДИТ, Беляев СЮ, Ticket#0335269, 04-04-2024, начало
	//ОткрытьФорму("Документ.Сделка.Форма.ФормаСозданияКомплектаДокументов", ПараметрыФормы,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); //не подходит вариант с блокировкой формы, пользователям надо возвращаться и проверять что-то
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаЗакрытияФормыСозданияКомплектаДокументов",ЭтаФорма);
	ФормаСозданияКомплекта = ОткрытьФорму("Документ.Сделка.Форма.ФормаСозданияКомплектаДокументов", ПараметрыФормы, ЭтаФорма,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.Независимый);
	УстановитьРежимФормыПриСозданииКомплектаДокументов( Истина );	
