&НаКлиенте
Процедура ОбработкаВыбораУчЕдиницы(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	Если Параметр2.Свойство("ТС") Тогда
		
		ЭТС = "";
		Для каждого Стр из Параметр1 Цикл
			ЭТС = ЭТС + ?(ЭТС = "", "", ";") + Строка(Стр);
		КонецЦикла;
		Элементы.Доходы.ТекущиеДанные.СписокВагонов = ЭТС;
		
	ИначеЕсли Параметр2.Свойство("ТЕ") Тогда
		
		ЭТС = "";
		Для каждого Стр из Параметр1 Цикл
			ЭТС = ЭТС + ?(ЭТС = "", "", ";") + Строка(Стр);
		КонецЦикла;
		Элементы.Доходы.ТекущиеДанные.СписокКТК = ЭТС;
		
	ИначеЕсли Параметр2.Свойство("ТД") Тогда
		
		ЭТС = "";
		Для каждого Стр из Параметр1 Цикл
			ЭТС = ЭТС + ?(ЭТС = "", "", ";") + ПолучитьКодТД(Стр);
		КонецЦикла;
		Элементы.Доходы.ТекущиеДанные.СписокТД = ЭТС;
		
	КонецЕсли;
	
КонецПроцедуры

