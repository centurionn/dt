&НаКлиенте
Процедура ОбработкаВыбораТСхИзПСЦДляКопирования(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = неопределено Тогда Возврат; КонецЕсли;
	
	НСтр = ТСхОглавление.ПолучитьЭлементы().Добавить();
	НСтр.Вариант = П1.Представление + " " + Строка(новый УникальныйИдентификатор);
	НСхема = ПостроительТСх_сервер.СкопироватьТСх(П1.Значение);
	НСтр.ЭлементТСх = НСхема;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокСхемПротоколов(МассивЗаявок)
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТехнологическаяСхема.Вариант КАК Вариант,
	               |	ТехнологическаяСхема.ТСх КАК ТСх
	               |ИЗ
	               |	РегистрСведений.ТехнологическаяСхема КАК ТехнологическаяСхема
	               |ГДЕ
	               |	ТехнологическаяСхема.ПредметТСх В
	               |			(ВЫБРАТЬ
	               |				ЗаявкаПереченьРейсов.Продукт КАК Продукт
	               |			ИЗ
	               |				Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
	               |			ГДЕ
	               |				ЗаявкаПереченьРейсов.Ссылка В (&Ссылка))";
	
	Запрос.УстановитьПараметр("Ссылка", МассивЗаявок);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		Результат.Добавить(Новый Структура("Название, Ссылка", Ответ.Вариант, Ответ.ТСх));
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьЕстьВР()
	
	ЕстьВР = Ложь;
	МассивСтрок = Объект.Доходы.НайтиСтроки(Новый структура("Перевыставляемая", Истина));
	Если МассивСтрок.Количество() > 0 Тогда
		ЕстьВР = Истина;
		Возврат;
	КонецЕсли;
	
	МассивСтрок = Объект.Расходы.НайтиСтроки(Новый структура("Перевыставляемая", Истина));
	Если МассивСтрок.Количество() > 0 Тогда
		ЕстьВР = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

