&НаКлиенте
Процедура ДобавитьСтратегию(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораСтратегии", Этаформа);
	ОткрытьФорму("Справочник.Стратегии.ФормаВыбора",,, ЭтаФорма.УникальныйИдентификатор, ,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораСтратегии(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 <> неопределено Тогда
		Найдено = Ложь;
		Для каждого Стр из Объект.Стратегии Цикл
			Найдено = Найдено ИЛИ Стр.Стратегия = Параметр1;
		КонецЦикла;
		Если НЕ Найдено Тогда
			Объект.Стратегии.Добавить().Стратегия = Параметр1;
			ПерерисоватьБлокСтратегий();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПерерисоватьБлокСтратегий()
	
	ГДЧ = Элементы.ГруппаДинамическаяЧасть;
	
	ПодчЭлементы = Новый Массив;
	Для каждого Стр из ГДЧ.ПодчиненныеЭлементы Цикл ПодчЭлементы.Добавить(Стр); КонецЦикла;
	Для каждого Элем из ПодчЭлементы Цикл
		Элементы.Удалить(Элем);
	КонецЦикла;
	
	Для каждого Стр из Объект.Стратегии Цикл
		ДанныеСтратегии = ПолучитьДанныеСтратегии(Стр.Стратегия);
		НЭлемент = Элементы.Добавить("Стр"+ДанныеСтратегии.Код, Тип("ДекорацияФормы"), ГДЧ);
		НЭлемент.Заголовок = ДанныеСтратегии.Наименование;
		НЭлемент.ЦветФона = Новый Цвет(ДанныеСтратегии.ЦветR, ДанныеСтратегии.ЦветG, ДанныеСтратегии.ЦветB);
		НЭлемент.Гиперссылка = Истина;
		НЭлемент.УстановитьДействие("Нажатие", "ОбработкаНажатияСтратегии");
	КонецЦикла;                                               
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаНажатияСтратегии(Параметр1 = неопределено, Параметр2 = неопределено)
	
	КодУдаляемойСтратегии = Сред(Параметр1.Имя, 4);
	ОпОп = Новый ОписаниеОповещения("СогласиеНаУдалениеСтратегии", ЭтаФорма, КодУдаляемойСтратегии);
	ПоказатьВопрос(ОпОп, "Удалить выбранную стратегию?", РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Нет,,КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура СогласиеНаУдалениеСтратегии(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = КодВозвратаДиалога.Да И Параметр2 <> неопределено Тогда
		СтратегияСсылка = ПолучитьСтратегиюПоКоду(Параметр2);
		Для каждого Стр из Объект.Стратегии Цикл
			Если Стр.Стратегия = СтратегияСсылка Тогда Объект.Стратегии.Удалить(Стр); Прервать; КонецЕсли;
		КонецЦикла;
		ПерерисоватьБлокСтратегий();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСтратегиюПоКоду(КодСтратегии)
	Возврат Стратегии_сервер.ПолучитьСтратегиюПоКоду(КодСтратегии);
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеСтратегии(Стратегия)
	
	Возврат Новый Структура("ЦветR, ЦветG, ЦветB, Наименование, Код", Стратегия.Цвет.Цвет_R, Стратегия.Цвет.Цвет_G, Стратегия.Цвет.Цвет_B, Стратегия.Наименование, Стратегия.Код);
	
КонецФункции

