&НаКлиенте
Процедура СоздатьЗаявкиИСчета(Команда)
	
	МКалькГрузов = Новый Массив;
	
	Для каждого Стр из Объект.СвязьУчетныхЕдиниц Цикл
		
		НайдСтрока = Ложь;
		
		Для каждого МКальк из МКалькГрузов Цикл
			
			Если МКальк.Калькуляция = Стр.Калькуляция Тогда
				
				НайдСтрока = Истина;
				Мкальк.Груз.Добавить(Новый Структура("Калькуляция, НомерКТК, ВесГрузаНетто, РазмерКТК, Вагон, Груженый, Протокол, ПринадлежностьТЕ", Стр.Калькуляция, Стр.Контейнер, Стр.ВесГрузаНетто, Стр.РазмерКТК, Стр.Вагон, Стр.Груженый, Стр.Протокол, Стр.ПринадлежностьТЕ));
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если НЕ НайдСтрока Тогда
			
			МассивДляЭлем = Новый Массив;
			МассивДляЭлем.Добавить(Новый Структура("Калькуляция, НомерКТК, ВесГрузаНетто, РазмерКТК, Вагон, Груженый, Протокол, ПринадлежностьТЕ", Стр.Калькуляция, Стр.Контейнер, Стр.ВесГрузаНетто, Стр.РазмерКТК, Стр.Вагон, Стр.Груженый, Стр.Протокол, Стр.ПринадлежностьТЕ));
			ЭлемКальк = Новый Структура("Калькуляция, Груз", Стр.Калькуляция, МассивДляЭлем);
			МКалькГрузов.Добавить(ЭлемКальк);
			
		КонецЕсли;
		
	КонецЦикла;
	
	РЕЗ = СоздатьЗаявки_Сервер(МКалькГрузов);
	Для каждого Стр из Рез Цикл
		
		Для каждого Стр2 из Объект.СвязьУчетныхЕдиниц.НайтиСтроки(Новый Структура("Калькуляция", Стр.Калькуляция)) Цикл
			
			СТр2.Заявка = Стр.Заявка;
			
		КонецЦикла;
		
		НСтрЗаявка = Объект.Заявки.Добавить();
		НСтрЗаявка.Заявка = Стр.Заявка;
		НСтрЗаявка.Калькуляция = Стр.Калькуляция;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьЗаявки_Сервер(МКалькГрузов)
	
	Результат = Новый Массив;
	
	Для каждого СТр из МКалькГрузов Цикл
		
		ПСЦкальк = ПолучитьПСЦКалькуляции(Стр.Калькуляция);
		
		
		НЗаявка = Документы.Заявка.СоздатьДокумент();
		НЗаявка.Заполнить(ПСЦкальк);
		Нзаявка.ВидПеревозки = Стр.Калькуляция.ПС_ВидПеревозки;
		НЗаявка.Дата = ТекущаяДата();
		НЗаявка.НеПроверятьВидСобственностиКТК = Истина;
		
		Для каждого Стр2 из Стр.Груз Цикл
			
			НСтрГруз = НЗаявка.СоставУслуги.Добавить();
			ЗаполнитьЗначенияСвойств(НСтрГруз, Стр2);
			НСтрГруз.ТипКТК = НСтрГруз.НомерКТК.ТипТЕ;
			НСтргруз.ТипВагона = НСтрГруз.Вагон.ТипТС;
			НСтрГруз.ПСЦ = НЗаявка.ПСЦ;
			// ДИТ 65580 Давудов М.А. Начало: 23.02.2023
			//Было:
			//НСтрГруз.ВидСобственности = ?(Стр2.ПринадлежностьТЕ = Перечисления.ПринадлежностьТЕ.КТЕвросиба, Перечисления.ВариантыСобственности.Спот, Перечисления.ВариантыСобственности.Прочее);
			//Стало:
			НСтрГруз.ВидСобственности = 
				?(Стр2.ПринадлежностьТЕ = Перечисления.ПринадлежностьТЕ.КТЕвросиба,
				Перечисления.ВариантыСобственности.Спот,
				Перечисления.ВариантыСобственности.Клиентский);
			// ДИТ 65580 Давудов М.А. Конец: 23.02.2023
			
		КонецЦикла;
		
		НЗаявка.Записать(РежимЗаписиДокумента.Запись);
		Попытка
			НЗаявка.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
		КонецПопытки;
		
		Результат.Добавить(Новый Структура("Заявка, Калькуляция", НЗаявка.Ссылка, Стр.Калькуляция));
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПСЦКалькуляции(Кальк)
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПСЦКалькуляции.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ПСЦ.Калькуляции КАК ПСЦКалькуляции
	               |ГДЕ
	               |	ПСЦКалькуляции.Калькуляция = &Калькуляция
	               |	И НЕ ПСЦКалькуляции.Ссылка.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПСЦКалькуляции.Ссылка.Дата УБЫВ";
	Запрос.УстановитьПараметр("Калькуляция", Кальк);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнятьСтрокиПоПервойСтроке(Команда)
	
	ЗаполнятьПоПервойСтроке = НЕ ЗаполнятьПоПервойСтроке;
	Элементы.СвязьУчетныхЕдиницЗаполнятьСтрокиПоПервойСтроке.ЦветФона = ?(ЗаполнятьПоПервойСтроке, ЦветКнопки_Выделенный, ЦветКнопки_Исходный);
	
КонецПроцедуры

&НаКлиенте
Процедура СвязьУчетныхЕдиницПриИзменении(Элемент)
	
	Если ЗаполнятьПоПервойСтроке Тогда
		ИмяТЧ = Элемент.Имя;
		ИмяПоля = Сред(Элемент.ТекущийЭлемент.Имя, СтрДлина(ИмяТЧ)+1);
		
		// ДИТ 64186 Давудов М.А. Начало: 07.03.2023
		Если Не ИмяПоля = "ПодтверждающиеДокументы" 
			//ДИТ, Беляев СЮ, Ticket#0320098, 14-08-2023, начало
			И НЕ ИмяПоля = "ГотовоКВыставлению" Тогда
			//ДИТ, Беляев СЮ, Ticket#0320098, 14-08-2023, конец
			// ДИТ 64186 Давудов М.А. Конец: 07.03.2023
			ЗначениеЗаполнения = Неопределено;
			Для Сч = 0 По Объект[ИмяТЧ].Количество() - 1 Цикл 
				СтрокаСоответствуетОтбору = Элемент.ПроверитьСтроку(Объект[ИмяТЧ][Сч].ПолучитьИдентификатор());
				Если Не СтрокаСоответствуетОтбору  Тогда
					Продолжить;
				КонецЕсли;
				Если ЗначениеЗаполнения = Неопределено Тогда
					ЗначениеЗаполнения = Объект[ИмяТЧ][Сч][ИмяПоля];
				КонецЕсли;
				//Субботин В.А. 58332 08.06.23  Начало
				Если Сч=0 тогда 
					продолжить;
				КонецЕсли;
				Элементы.СвязьУчетныхЕдиниц.ТекущаяСтрока = Объект[ИмяТЧ][Сч].ПолучитьИдентификатор();
				Объект[ИмяТЧ][Сч][ИмяПоля] = ЗначениеЗаполнения;
				Попытка
					Выполнить(""+Элемент.ТекущийЭлемент.Имя + "ПриИзменении"+"(Объект[ИмяТЧ][Сч])");
				Исключение 
				КонецПопытки
				//Субботин В.А. 58332 08.06.23  Конец 
			КонецЦикла;
			// ДИТ 64186 Давудов М.А. Начало: 07.03.2023
		КонецЕсли;
		// ДИТ 64186 Давудов М.А. Конец: 07.03.2023
		Элементы.СвязьУчетныхЕдиниц.ТекущаяСтрока = Объект[ИмяТЧ][0].ПолучитьИдентификатор();
	КонецЕсли;
	
	текД = Элементы.СвязьУчетныхЕдиниц.ТекущиеДанные;
	Если ТекД.ДокументыСформированы Тогда
		текД.Изменена = Истина;
	КонецЕсли; 
	
КонецПроцедуры

