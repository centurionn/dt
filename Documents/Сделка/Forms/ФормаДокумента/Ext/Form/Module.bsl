КонецПроцедуры
//ДИТ, Беляев СЮ, ТА54910, 19-07-2022, конец

&НаКлиенте
Процедура ОбработкаПодбораВагонныхЖДН(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	Для Каждого Эл Из П1 Цикл
		// колво записей в тч СвязьУчетныхЕдиниц и кол-во записей из выбранной накладной должно быть одинаковым
		ТекВагон = Эл.Вагон;
		КолвоКТК = Эл.СписокКТК.Количество();
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Вагон",ТекВагон);
		ПараметрыОтбора.Вставить("Контейнер",ПредопределенноеЗначение("Справочник.ТЕ.ПустаяСсылка"));
		ПараметрыОтбора.Вставить("НеАктивна",Ложь);
		НайденныеСтроки = Объект.СвязьУчетныхЕдиниц.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// если в сделке строк столько же, сколько найдено в накладной (считаем по КТК) или найдено 0 КТК			
		Если НайденныеСтроки.Количество() = КолвоКТК  ИЛИ КолвоКТК = 0 Тогда
			Для ШагЦикла = 0 По НайденныеСтроки.Количество()-1 Цикл
				Если (ШагЦикла + 1 <= КолвоКТК И КолвоКТК>0) ИЛИ (ШагЦикла = КолвоКТК И КолвоКТК = 0) Тогда
					Если КолвоКТК > 0 Тогда
						НайденныеСтроки[ШагЦикла].Контейнер = Эл.СписокКТК[ШагЦикла].Значение;
					КонецЕсли;
					НайденныеСтроки[ШагЦикла].НомерЖДН = Эл.Накладная;
					НайденныеСтроки[ШагЦикла].ЖДН = Эл.ТранспортныйДокумент;
				КонецЕсли;
			КонецЦикла;
		// если в сделке строк меньше, чем найдено в накладной, то добавить строки в сделку.
		ИначеЕсли НайденныеСтроки.Количество() < КолвоКТК Тогда
		    СтрокаШаблон = Неопределено;
			Для ШагЦикла = 0 По КолвоКТК-1 Цикл
				Если ШагЦикла + 1 <= НайденныеСтроки.Количество() Тогда
					НайденныеСтроки[ШагЦикла].Контейнер = Эл.СписокКТК[ШагЦикла].Значение;
					НайденныеСтроки[ШагЦикла].НомерЖДН = Эл.Накладная;
					НайденныеСтроки[ШагЦикла].ЖДН = Эл.ТранспортныйДокумент;
					// сохраним строку-шаблон, по которой будем	заполнять новые строки.
					СтрокаШаблон = НайденныеСтроки[ШагЦикла];
				Иначе
					Если НЕ СтрокаШаблон = Неопределено Тогда
						НовСтр = Объект.СвязьУчетныхЕдиниц.Добавить();
						ЗаполнитьЗначенияСвойств(НовСтр,СтрокаШаблон);
						НовСтр.Контейнер = Эл.СписокКТК[ШагЦикла].Значение;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПодобратьНакладныеЭТРАННовНаСервере()
	
	РЕЗ = РаботаСоСделкамиСервер.ПодобратьНакладныеВСделку(Объект, Объект.ГоризонтПоискаНакладных);
	Документы.Сделка.ЗаполнитьГрузыВТаблицеСвязьУчетныхЕдиниц(Объект.СвязьУчетныхЕдиниц);
	
	ОбновитьВладельцевВагонов();
