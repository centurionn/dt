&НаКлиенте
Функция ПроверкаСвязанныхСтрокРасходов( ТекД )
	//Пользователи должны иметь возможность проставить признак «Не выставлять клиенту» в доходной строке в случае наличия в связанной расходной строке актуального Акцепта в указанном уч. документе в следующих случаях:  
	//-      Если в дох.строке НЕ установлен признак «Перевыст.».
	//-      Если в дох. строке установлен признак «Доплата».
	//-      Если «Источник появления строки экономики» в дох.строке содержит:
	//o   «Произвольная услуга (вручную)», т.к. инициируется процесс отключения расходной строки и отвязки расходов.
	//-      Если «Источник появления строки экономики» в дох.строке НЕ содержит:
	//o   Добавлено из акцепта
	//o   Услуга вне ставки (автоматически)
	//o   АРМ Сверхнормативы
	
	Если ТекД.Перевыставляемая Тогда //проверяем Акцепты если установлен "Перевыставляемая"
		Возврат ЕстьАкцептованныеСвязанныеРасходы( ТекД.ГУИД );
	КонецЕсли;
	
	//"Доплата" можно не проверять, установленный разрешает установить галку, но надо проверять другие условия
	
	//"Произвольная услуга (вручную)" можно не проверять, разрешает установить галку, но надо проверять другие условия
	
	//Источникик появления строки для проверки Акцептов
	МассивБлокируемыхИсточниковСтрок = Новый Массив;
	МассивБлокируемыхИсточниковСтрок.Добавить(ПредопределенноеЗначение("Перечисление.ИсточникПоявленияСтрокиЭкономики.ДобавленоИзАкцепта"));
	МассивБлокируемыхИсточниковСтрок.Добавить(ПредопределенноеЗначение("Перечисление.ИсточникПоявленияСтрокиЭкономики.ДопУслугаАвтоматически"));
	МассивБлокируемыхИсточниковСтрок.Добавить(ПредопределенноеЗначение("Перечисление.ИсточникПоявленияСтрокиЭкономики.АРМСверхнормативы"));
	Если МассивБлокируемыхИсточниковСтрок.Найти(ТекД.ИсточникПоявленияСтрокиЭкономики) <> Неопределено Тогда
		Возврат ЕстьАкцептованныеСвязанныеРасходы( ТекД.ГУИД );
	КонецЕсли;
	
	Возврат Ложь;
КонецФункции
//ДИТ, Беляев СЮ, Ticket#0349218, 19-04-2024, конец

//ДИТ, Беляев СЮ, BUG 83819 / TA 83835, 11-04-2024, начало
&НаСервере
Функция ЕстьАкцептованныеСвязанныеРасходы( ГУИДстрокиДохода)
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	СделкаСвязьДоходовИРасходов.Расходы КАК Расходы
		|ПОМЕСТИТЬ ВТ_СвязьДоходовИРасходов
		|ИЗ
		|	&СвязьДоходовИРасходов КАК СделкаСвязьДоходовИРасходов
		|ГДЕ
		|	СделкаСвязьДоходовИРасходов.Доходы = &ГУИДстрокиДохода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Расходы.УчДокумент КАК УчДокумент,
		|	Расходы.ГУИД КАК ГУИД,
		|	Расходы.УслугаОтключена КАК УслугаОтключена
		|ПОМЕСТИТЬ ВТ_Расходы
		|ИЗ
		|	Документ.Сделка.Расходы КАК Расходы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	АктуальныеПривязкиАкцептовВСделки.Поступление КАК Поступление
		|ИЗ
		|	ВТ_Расходы КАК ВТ_Расходы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СвязьДоходовИРасходов КАК ВТ_СвязьДоходовИРасходов
		|		ПО ВТ_Расходы.ГУИД = ВТ_СвязьДоходовИРасходов.Расходы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АктуальныеПривязкиАкцептовВСделки КАК АктуальныеПривязкиАкцептовВСделки
		|		ПО (АктуальныеПривязкиАкцептовВСделки.Сделка = &СделкаСсылка)
		|			И ВТ_Расходы.ГУИД = АктуальныеПривязкиАкцептовВСделки.ИдентификаторСтрокиРасходовВСделке";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.Сделка.Расходы", "&Расходы");
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ГУИДстрокиДохода", ГУИДстрокиДохода);
	Запрос.УстановитьПараметр("СвязьДоходовИРасходов", Объект.СвязьДоходовИРасходов.Выгрузить());
	Запрос.УстановитьПараметр("Расходы", Объект.Расходы.Выгрузить(,"УчДокумент, ГУИД, УслугаОтключена"));
	Запрос.УстановитьПараметр("СделкаСсылка", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции
//ДИТ, Беляев СЮ, BUG 83819 / TA 83835, 11-04-2024, конец

&НаКлиенте
Процедура РасходыНеВключатьВПлановыеРасходыПриИзменении(Элемент)

	//установим аналогично флажки в доходах
	ТекД = Элементы.Расходы.ТекущиеДанные;
	Доходы = Объект.СвязьДоходовИРасходов.НайтиСтроки(Новый Структура("Расходы", ТекД.ГУИД));
	Для каждого СтрокаДоход Из Доходы Цикл
		СтрокиДоходов = Объект.Доходы.НайтиСтроки(Новый Структура("ГУИД", СтрокаДоход.Доходы));
		Для каждого СтрокаДоходов Из СтрокиДоходов Цикл 
			//ДИТ, Беляев СЮ, Ticket#0254869, 12-01-2022, ++   
			Если ТекД.НеВключатьВПлановыеРасходы = Истина И ЗначениеЗаполнено(СтрокаДоходов.УчДокумент) Тогда
				Продолжить;
			КонецЕсли;                               
			//ДИТ, Беляев СЮ, Ticket#0254869, 12-01-2022, --
			СтрокаДоходов.НеВыставлятьКлиенту = ТекД.НеВключатьВПлановыеРасходы;
		КонецЦикла; 
	КонецЦикла; 
