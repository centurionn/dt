	ОпОп = Новый ОписаниеОповещения("ОбработкаЗаменыДоговора", ЭтаФорма);
	ОткрытьФорму("Документ.Сделка.Форма.ЗаменаДоговораПоВыбраннымКонтейнерам", ,, ЭтаФорма.УникальныйИдентификатор,,,ОпОП, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
