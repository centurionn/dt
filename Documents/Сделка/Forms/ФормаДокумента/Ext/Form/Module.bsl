			Для каждого СтрокаСвязьУчетныхЕдиниц Из Объект.СвязьУчетныхЕдиниц Цикл
				Если СтрокаСвязьУчетныхЕдиниц.ГУИДСтрокиЗаявки = ТекД.ГУИДСтрокиЗаявки 
					И СтрокаСвязьУчетныхЕдиниц.ГотовоКВыставлению = Истина Тогда
					Если СтрокаСвязьУчетныхЕдиниц.ДокументыВыставлены Тогда
						ТекстСообщения = "Изменение признака «готово к выставлению» у выставленных документов запрещено";
						ОбщегоНазначенияКлиент.СообщитьПользователю(
									ТекстСообщения,
									,
									ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СвязьУчетныхЕдиниц", СтрокаСвязьУчетныхЕдиниц.НомерСтроки, "ГотовоКВыставлению"),
									"Объект");
						ТекД.ГотовоКВыставлению = Истина;
					Иначе	
						СтрокаСвязьУчетныхЕдиниц.ГотовоКВыставлению = Ложь;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		//)
		//Евросиб - АСуслов 05.10.2022 13:36:05 #тэуфрахт
		Возврат;
	КонецЕсли;
	
	//ДИТ, Беляев СЮ, US 80045, 07-02-2024, начало
	Если Объект.ПодсылПорожних И ТекД.ГотовоКВыставлению Тогда
		ТекД.ГотовоКВыставлению = Ложь;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
									"Сделка порожняя. Формирование доходов невозможно",
									,
									ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СвязьУчетныхЕдиниц", ТекД.НомерСтроки, "ГотовоКВыставлению"),
									"Объект");
		Возврат;
	КонецЕсли;
	//ДИТ, Беляев СЮ, US 80045, 07-02-2024, конец
	
	//++ Зубов 39709 24.09.2021
	// ДИТ Поморцева Т.П. Задача 38943 21.09.2021. начало
	//СтруктураПоиска = Новый Структура("Договор, Коносамент, Удалена", ТекД.Договор, ТекД.Коносамент, Ложь);
	//Если флКакПроставлятьГотовоКВыставлению = 2 Тогда
	//ДИТ, Беляев СЮ, Ticket#0320098, 14-08-2023, начало
	Если ЗаполнятьПоПервойСтроке Тогда
		СтруктураПоиска = Новый Структура("Удалена, НеАктивна", Ложь, Ложь);
	ИначеЕсли флКакПроставлятьГотовоКВыставлению = 2 Тогда
	//ДИТ, Беляев СЮ, Ticket#0320098, 14-08-2023, конец
		//СтруктураПоиска = Новый Структура("Договор, Коносамент, Удалена", ТекД.Договор, ТекД.Коносамент, Ложь);
		//ДИТ, Беляев СЮ, BUG 68322/TASK 68324, 07-04-2023, начало
		СтруктураПоиска = Новый Структура("Договор, Коносамент, Удалена, НеАктивна", ТекД.Договор, ТекД.Коносамент, Ложь, Ложь);
		//ДИТ, Беляев СЮ, BUG 68322/TASK 68324, 07-04-2023, конец
		Если ТекД.ВидСтавки = ПредопределенноеЗначение("Перечисление.ФрахтФинДокументы_ВидСтавки.ОтдельныеСтавки") Тогда
			СтруктураПоиска.Вставить("ВидТранспортногоСообщения", ТекД.ВидТранспортногоСообщения);
			Если ТекД.ВидТранспортногоСообщения = ПредопределенноеЗначение("Перечисление.ВидыТранспортныхСообщений.ЖД") Тогда
				СтруктураПоиска.Удалить("Коносамент");
			КонецЕсли;
		КонецЕсли;
	Иначе
		СтруктураПоиска = Новый Структура("ГУИД", ТекД.ГУИД);
	КонецЕсли;
	// ДИТ Поморцева Т.П. Задача 38943 21.09.2021. конец
	//ПроверитьПометитьСтрокиКВыставлению(СтруктураПоиска);
	//ДИТ, Беляев СЮ, Ticket#0318556, 04-08-2023, начало
	ТекстОповещения = "";
	//Евросиб, Трундуков СА, 118890, 17.09.2025, начало
	//ПроверитьПометитьСтрокиКВыставлению(СтруктураПоиска, ТекстОповещения);
	Ошибки = ПроверитьПометитьСтрокиКВыставлению(СтруктураПоиска, ТекстОповещения);
	Если Ошибки <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки);	
	КонецЕсли;
    //Евросиб, Трундуков СА, 118890, 17.09.2025, конец
	
	Если ЗначениеЗаполнено(ТекстОповещения) Тогда
		ТекстОповещения = "Внимание! в строках ЖД перевозки отсутствуют/не заполнены параметры: "
						+ Символы.ПС
						+ ТекстОповещения;
		ПоказатьПредупреждение(, ТекстОповещения, 30);
	КонецЕсли;
	//ДИТ, Беляев СЮ, Ticket#0318556, 04-08-2023, конец
	//-- Зубов 39709 24.09.2021                         
	//Евросиб - АСуслов 22.09.2022 15:48:01 #56288
	//(
	Если ТекД.ВидТранспортногоСообщения = ПредопределенноеЗначение("Перечисление.ВидыТранспортныхСообщений.Море") Тогда
		СвязьУчетныхЕдиницГотовоКВыставлениюФрахтПриИзменении(Неопределено);
	КонецЕсли;
	//)
