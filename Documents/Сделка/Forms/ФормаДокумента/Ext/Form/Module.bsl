&НаКлиенте
Процедура ЗаполнитьЭкономику_ТолькоГотовыеНаКлиенте(Частично = Ложь)
	
	ВСделкеИдетРаботаПоКоносаментам = Ложь;
	СписокГотовыхКОформлениюДоговоров.Очистить();
	Для каждого Стр из Объект.СвязьУчетныхЕдиниц Цикл
		
		Если ЗначениеЗаполнено(Стр.Коносамент) Тогда
			ВСделкеИдетРаботаПоКоносаментам = Истина;
		КонецЕсли;
		
		//++ДИТ Гаузер А.В. BUG 53670, TA 53671 26.08.2022
		//Если Стр.ГотовоКВыставлению И НЕ Стр.ДокументыВыставлены Тогда
		Если Стр.ГотовоКВыставлению И НЕ Стр.ДокументыВыставлены
		//Евросиб Каблов 12.12.2023 ( Ticket#0329972
		И Не Стр.ОтключитьРасходы
		//Евросиб Каблов 12.12.2023 )
		И НЕ Стр.НеАктивна Тогда
		//--ДИТ Гаузер А.В. BUG 53670, TA 53671 26.08.2022
		
			
			НСтр = СписокГотовыхКОформлениюДоговоров.Добавить();
			ЗаполнитьЗначенияСвойств(НСтр, Стр);
			
			Если ЗначениеЗаполнено(Стр.Коносамент) Тогда
				
				НСтр.НомерКоносамента = ПолучитьНомерКС(Стр.Коносамент);
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	СтрокиКУдалению = Новый Массив;
	
	Для каждого Стр из Объект.Доходы Цикл
		
		Для каждого Стр2 из СписокГотовыхКОформлениюДоговоров Цикл
			
			Если Стр.Договор = СТр2.Договор 
				И (НЕ ВСделкеИдетРаботаПоКоносаментам ИЛИ Стр2.НомерКоносамента = Стр.РеестрКлиента)
				Тогда
				
				СтрокиКУдалению.Добавить(Стр2);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если Не Частично Тогда
		Для каждого Стр7 из СтрокиКУдалению Цикл 
			Если СписокГотовыхКОформлениюДоговоров.НайтиПоИдентификатору(Стр7.ПолучитьИдентификатор()) <> неопределено Тогда СписокГотовыхКОформлениюДоговоров.Удалить(Стр7); КонецЕсли;
		КонецЦикла;
	КонецЕсли; 
	
	//Удалим неполные списки
	Если НЕ Частично Тогда
		СтрокиДоговорыКУдалению = Новый Массив;
		Для каждого ГотовыйКОформлениюДоговор Из СписокГотовыхКОформлениюДоговоров Цикл
			НеГотовыеСтроки = Объект.СвязьУчетныхЕдиниц.НайтиСтроки(Новый Структура("Договор, ГотовоКВыставлению,Удалена", ГотовыйКОформлениюДоговор.Договор, Ложь, Ложь));
			Если НеГотовыеСтроки.Количество() > 0 Тогда
				СтрокиДоговорыКУдалению.Добавить(ГотовыйКОформлениюДоговор);
			КонецЕсли; 
		КонецЦикла; 
		Для каждого СтрокаДоговорыКУдалению Из СтрокиДоговорыКУдалению Цикл
			СписокГотовыхКОформлениюДоговоров.Удалить(СтрокаДоговорыКУдалению);
		КонецЦикла; 
	КонецЕсли; 
	/////////////////////////
	
	СписокКлиентов = Новый СписокЗначений;
	//Евросиб Коханенко Н.А. 10.04.2024 (( #83236
	//Для каждого СтрокаДоговор Из СписокГотовыхКОформлениюДоговоров Цикл
	//	Если СписокКлиентов.НайтиПоЗначению(СтрокаДоговор.Клиент) = Неопределено Тогда
	//		СписокКлиентов.Добавить(СтрокаДоговор.Клиент, СтрокаДоговор.Клиент, Истина);
	//	КонецЕсли; 
	//КонецЦикла; 
	СписокУникальныхКлиентов = Новый СписокЗначений;
	Для каждого СтрокаДоговор Из СписокГотовыхКОформлениюДоговоров Цикл
		Если СписокУникальныхКлиентов.НайтиПоЗначению(СтрокаДоговор.Клиент) = Неопределено Тогда
			СписокУникальныхКлиентов.Добавить(СтрокаДоговор.Клиент, СтрокаДоговор.Клиент, Истина);
			СписокКлиентов.Добавить(Новый Структура("Ссылка", СтрокаДоговор.Клиент), Строка(СтрокаДоговор.Клиент), Истина);
		КонецЕсли; 
	КонецЦикла; 
	//Евросиб Коханенко Н.А. 10.04.2024 )) #83236 
	ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораКлиентовИзСписка", ЭтаФорма);
	//СписокКлиентов.ПоказатьОтметкуЭлементов(ОпОп, "Выберите клиентов для заполнения экономики сделки");
	//ДИТ, Беляев СЮ, Ticket#0286563 (US 58604), 04-10-2022, начало
	ОткрытьФорму("ОбщаяФорма.э_ФормаВыбораИзСписка",Новый Структура("Список,Заголовок,ОбъектВладелец",СписокКлиентов,"Выберите клиентов для заполнения экономики сделки",Объект.Ссылка),Объект.Ссылка,,,,ОпОп,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	//ДИТ, Беляев СЮ, Ticket#0286563 (US 58604), 04-10-2022, конец
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЭкономику_ТолькоГотовыеТолькоМоиНаКлиенте(Частично = Ложь)

	ТекПользователь = ПользователиКлиент.ТекущийПользователь();
	
	ВСделкеИдетРаботаПоКоносаментам = Ложь;
	СписокГотовыхКОформлениюДоговоров.Очистить();
	Для каждого Стр из Объект.СвязьУчетныхЕдиниц Цикл
		
		Если ЗначениеЗаполнено(Стр.Коносамент) Тогда
			ВСделкеИдетРаботаПоКоносаментам = Истина;
		КонецЕсли;
		
		//Если Стр.ГотовоКВыставлению И НЕ Стр.ДокументыСформированы И ((Объект.КомуСтавитсяЗадачаПоДокументам = 0 И ТекПользователь = Объект.ЕдиныйОтветственныйОтУчета) ИЛИ (Объект.КомуСтавитсяЗадачаПоДокументам = 1 И ТекПользователь = ПолучитьОтветственногоЗаУчет(Стр.Договор))) Тогда
