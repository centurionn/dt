//Евросиб - АСуслов 26.01.2023 9:09:15 #56259
Процедура ОбновитьКоносаментыНаСервере()
	
	СписокКоносаментов = Новый Массив;
	СопоставлениеДоговорМенеджер = Новый Соответствие;
	Для каждого Стр из Объект.СвязьУчетныхЕдиниц Цикл
		Если СписокКоносаментов.Найти(Стр.Коносамент) = неопределено Тогда СписокКоносаментов.Добавить(Стр.Коносамент); КонецЕсли;
		Если СопоставлениеДоговорМенеджер.Получить(Стр.Договор) = неопределено Тогда СопоставлениеДоговорМенеджер.Вставить(Стр.Договор, 1); КонецЕсли;
	КонецЦикла;
	Если СписокКоносаментов.Количество() = 0 Тогда Возврат; КонецЕсли;
		
	ПреобразованнаяТаблица = СформироватьПреобразованнуюТаблицу(СписокКоносаментов, СопоставлениеДоговорМенеджер);
	ВыставленныеКоносаменты.Очистить();
	Для каждого Стр из ПреобразованнаяТаблица Цикл
		Нстр = ВыставленныеКоносаменты.Добавить();
		ЗаполнитьЗначенияСвойств(Нстр, Стр); 
		Для каждого Стр2 из Объект.СвязьУчетныхЕдиниц Цикл
			Если Стр2.Коносамент = Стр.Коносамент Тогда 
				НСтр.ОтветственныйМенеджер = СопоставлениеДоговорМенеджер.Получить(Стр2.Договор); 
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьПреобразованнуюТаблицу(СписокКоносаментов, СопоставлениеДоговорМенеджер)
	// ДИТ US 51951 TA 61497 Евсенкин М.А. Начало: 14.12.2022
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ЦФО",					Справочники.ЦентрыФинансовойОтветственности.ОсновнойЦФО);
	СтруктураПараметров.Вставить("ТипОтветственного",	Перечисления.ТипыОтветственных.ОтветственныйЗаУчет);  
	
	Для каждого Стр из СопоставлениеДоговорМенеджер Цикл
		
		// Было:
		//СопоставлениеДоговорМенеджер.Вставить(Стр.Ключ, Стр.Ключ.ОтветственныйЗаУчет);
		//Стало:
		СтруктураПараметров.Вставить("Договор",				Стр.Ключ);
		мОтветственныйЗаУчет = Справочники.ДоговорыКонтрагентов.ПолучитьОтветственного(СтруктураПараметров);
		
		СопоставлениеДоговорМенеджер.Вставить(Стр.Ключ, мОтветственныйЗаУчет);
		// ДИТ US 51951 TA 61497 Евсенкин М.А. Конец: 14.12.2022
	КонецЦикла;
	
	Результат = Новый Массив;
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТранспортныйДокумент.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	               |ГДЕ
	               |	ТранспортныйДокумент.Ссылка В(&Ссылка)";
	Запрос.УстановитьПараметр("Ссылка", СписокКоносаментов);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		РезСчета = ПолучитьСчетаПоКоносаменту(Ответ.Ссылка);
		Если РезСчета.Количество() = 0 Тогда
			Результат.Добавить(Новый Структура("Коносамент, СчетПокупателю", Ответ.Ссылка, неопределено));
		Иначе
			Для каждого Стр2 из РезСчета Цикл
				Результат.Добавить(Стр2);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСчетаПоКоносаменту(Коносамент)
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	СчетНаОплатуПокупателюДокументыОснования.Ссылка КАК Ссылка,
	               |	СчетНаОплатуПокупателюДокументыОснования.Коносамент КАК Коносамент
	               |ИЗ
	               |	Документ.СчетНаОплатуПокупателю.ДокументыОснования КАК СчетНаОплатуПокупателюДокументыОснования
	               |ГДЕ
	               |	СчетНаОплатуПокупателюДокументыОснования.Коносамент = &Коносамент
	               |	И НЕ СчетНаОплатуПокупателюДокументыОснования.Ссылка.ПометкаУдаления";
	Запрос.УстановитьПараметр("Коносамент", Коносамент);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		Результат.Добавить(Новый Структура("Коносамент, СчетПокупателю", Ответ.Коносамент, Ответ.Ссылка));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

