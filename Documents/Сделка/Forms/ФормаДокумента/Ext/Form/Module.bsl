&НаСервере
Процедура МаршрутПеревозкиСервер()
	
	// удаляем из таблицы только те данные, которые сейчас будем обновлять
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("СтатьяРасхождений","Несоблюдение маршрута");
	НайденныеСтроки = ТЗРасхождений.НайтиСтроки(ПараметрыОтбора);
	Для Каждого Стр Из НайденныеСтроки Цикл
		ТЗРасхождений.Удалить(Стр);		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТехнологическаяСхема.Вариант КАК Вариант,
	               |	ТехнологическаяСхема.ТСх КАК ТСх,
	               |	ТехнологическаяСхемаТЧ.ПунктОтправления КАК ПунктОтправления,
	               |	ТехнологическаяСхемаТЧ.ПунктНазначения КАК ПунктНазначения,
	               |	ТехнологическаяСхема.ПредметТСх КАК ПредметТСх,
	               |	ЛОЖЬ КАК ЕстьФактОтпр,
	               |	ЛОЖЬ КАК ЕстьФактНазн,
	               |	ТехнологическаяСхемаТЧ.Операция КАК Операция
	               |ИЗ
	               |	РегистрСведений.ТехнологическаяСхема КАК ТехнологическаяСхема
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
	               |		ПО ТехнологическаяСхема.ТСх = ТехнологическаяСхемаТЧ.Ссылка
	               |ГДЕ
	               |	ТехнологическаяСхема.ПредметТСх = &ПредметТСх
	               |	И ТехнологическаяСхема.Вариант = ""Плановая""";
	Запрос.УстановитьПараметр("ПредметТСх",Объект.Ссылка);
	ТЗ_План = Запрос.Выполнить().Выгрузить();
	
	Запрос2 = Новый Запрос;
	Запрос2.Текст = "ВЫБРАТЬ
	                |	ТехнологическаяСхема.Вариант КАК Вариант,
	                |	ТехнологическаяСхема.ТСх КАК ТСх,
	                |	ТехнологическаяСхемаТЧ.ПунктОтправления КАК ПунктОтправления,
	                |	ТехнологическаяСхемаТЧ.ПунктНазначения КАК ПунктНазначения,
	                |	ТехнологическаяСхема.ПредметТСх КАК ПредметТСх,
	                |	ЛОЖЬ КАК ЕстьПланОтпр,
	                |	ЛОЖЬ КАК ЕстьПланНазн,
	                |	ТехнологическаяСхемаТЧ.Операция КАК Операция
	                |ИЗ
	                |	РегистрСведений.ТехнологическаяСхема КАК ТехнологическаяСхема
	                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
	                |		ПО ТехнологическаяСхема.ТСх = ТехнологическаяСхемаТЧ.Ссылка
	                |ГДЕ
	                |	ТехнологическаяСхема.ПредметТСх = &ПредметТСх
	                |	И ТехнологическаяСхема.Вариант = ""Фактическая""";
	Запрос2.УстановитьПараметр("ПредметТСх",Объект.Ссылка);
	ТЗ_Факт = Запрос2.Выполнить().Выгрузить();
	
	// проверить, какие пункты отправления и назначения есть в плане и в факте.
	// если данные совпадают, то установить соответствующие флаги
	Для Каждого Стр Из ТЗ_План Цикл
		// по отправлению
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ПунктОтправления",Стр.ПунктОтправления);
		НайденныйФакт = ТЗ_Факт.НайтиСтроки(ПараметрыОтбора);
		Если НайденныйФакт.Количество()>0 Тогда
			Стр.ЕстьФактОтпр = Истина;
		КонецЕсли;
		Для Каждого НФ Из НайденныйФакт Цикл
			НФ.ЕстьПланОтпр = Истина;
		КонецЦикла;
		
		// по назначению
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ПунктНазначения",Стр.ПунктНазначения);
		НайденныйФакт = ТЗ_Факт.НайтиСтроки(ПараметрыОтбора);
		Если НайденныйФакт.Количество()>0 Тогда
			Стр.ЕстьФактНазн = Истина;
		КонецЕсли;
		Для Каждого НФ Из НайденныйФакт Цикл
			НФ.ЕстьПланНазн = Истина;
		КонецЦикла;
		
	КонецЦикла;
	
	// добавляем данные в ТЗ расхождений
	Для Каждого Стр Из ТЗ_План Цикл
		Если Стр.ЕстьФактОтпр = Ложь Тогда
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("ПунктОтправления",Стр.ПунктОтправления);
			НайденныеСтр = ТЗРасхождений.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтр.Количество() = 0 Тогда
				НовСтр = ТЗРасхождений.Добавить();
				НовСтр.СтатьяРасхождений = "Несоблюдение маршрута";
				НовСтр.ПунктОтправления = Стр.ПунктОтправления;
				НовСтр.ОперацияРодитель = Стр.Операция;
				НовСтр.НетВФакте = Истина;
			КонецЕсли;
		КонецЕсли;
		Если Стр.ЕстьФактНазн = Ложь Тогда
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("ПунктНазначения",Стр.ПунктНазначения);
			НайденныеСтр = ТЗРасхождений.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтр.Количество() = 0 Тогда
				НовСтр = ТЗРасхождений.Добавить();
				НовСтр.СтатьяРасхождений = "Несоблюдение маршрута";
				НовСтр.ПунктНазначения = Стр.ПунктНазначения;
				НовСтр.ОперацияРодитель = Стр.Операция;
				НовСтр.НетВФакте = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из ТЗ_Факт Цикл
		Если Стр.ЕстьПланОтпр = Ложь Тогда
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("ПунктОтправления",Стр.ПунктОтправления);
			НайденныеСтр = ТЗРасхождений.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтр.Количество() = 0 Тогда
				НовСтр = ТЗРасхождений.Добавить();
				НовСтр.СтатьяРасхождений = "Несоблюдение маршрута";
				НовСтр.ПунктОтправления = Стр.ПунктОтправления;
				НовСтр.ОперацияРодитель = Стр.Операция;
				НовСтр.НетВПлане = Истина;
			КонецЕсли;
		КонецЕсли;
		Если Стр.ЕстьПланНазн = Ложь Тогда
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("ПунктНазначения",Стр.ПунктНазначения);
			НайденныеСтр = ТЗРасхождений.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтр.Количество() = 0 Тогда
				НовСтр = ТЗРасхождений.Добавить();
				НовСтр.СтатьяРасхождений = "Несоблюдение маршрута";
				НовСтр.ПунктНазначения = Стр.ПунктНазначения;
				НовСтр.ОперацияРодитель = Стр.Операция;
				НовСтр.НетВПлане = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// для каждой операции получаем список ее КТК
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("СтатьяРасхождений","Несоблюдение маршрута");
	НайденныеСтр = ТЗРасхождений.НайтиСтроки(ПараметрыОтбора);
	Для Каждого Стр Из НайденныеСтр Цикл
		ТекТЧ = Стр.ОперацияРодитель.Грузы;
		МассивКТК = Новый Массив;
		Для Каждого СтрКТК Из ТекТЧ Цикл
			Если ЗначениеЗаполнено(СтрКТК.ТЕ) Тогда
				МассивКТК.Добавить(СтрКТК.ТЕ);
			КонецЕсли;
		КонецЦикла;
		КТКОперация = СтрСоединить(МассивКТК, ";");
		Стр.КТКОперацияРодитель = КТКОперация;
	КонецЦикла;
	
	КартинкаОшибки = БиблиотекаКартинок.СостоянияРасширенийОшибка;
	КартинкаВерно = БиблиотекаКартинок.СостоянияРасширенийПодключено;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("СтатьяРасхождений","Несоблюдение маршрута");
	НайденныеСтр = ТЗРасхождений.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеСтр.Количество()>0 Тогда
		Элементы.прав_МаршрутПеревозки.Картинка = КартинкаОшибки;
	Иначе
		Элементы.прав_МаршрутПеревозки.Картинка = КартинкаВерно;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура прав_МаршрутПеревозки(Команда)
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("СписокОтклонений",ТЗРасхождений);
	ПараметрыОтбора.Вставить("СтатьяРасхождений","Несоблюдение маршрута");
	ОткрытьФорму("Документ.Сделка.Форма.ФормаРезультатовАвтодиагностики",ПараметрыОтбора,, ЭтаФорма.УникальныйИдентификатор, ,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура лев_ДополнительныеОперации(Команда)
	
	ДопОперацииСервер();
	
КонецПроцедуры

&НаСервере
Процедура ДопОперацииСервер()
	
	// удаляем из таблицы только те данные, которые сейчас будем обновлять
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("СтатьяРасхождений","Несоблюдение операции");
	НайденныеСтроки = ТЗРасхождений.НайтиСтроки(ПараметрыОтбора);
	Для Каждого Стр Из НайденныеСтроки Цикл
		ТЗРасхождений.Удалить(Стр);		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТехнологическаяСхема.Вариант КАК Вариант,
	               |	ТехнологическаяСхема.ТСх КАК ТСх,
	               |	ТехнологическаяСхема.ПредметТСх КАК ПредметТСх,
	               |	ТехнологическаяСхемаТЧ.Операция.Услуга КАК ОперацияУслуга,
	               |	ЛОЖЬ КАК ЕстьФакт,
	               |	ТехнологическаяСхемаТЧ.Операция КАК Операция
	               |ИЗ
	               |	РегистрСведений.ТехнологическаяСхема КАК ТехнологическаяСхема
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
	               |		ПО ТехнологическаяСхема.ТСх = ТехнологическаяСхемаТЧ.Ссылка
	               |ГДЕ
	               |	ТехнологическаяСхема.ПредметТСх = &ПредметТСх
	               |	И ТехнологическаяСхема.Вариант = ""Плановая""";
	Запрос.УстановитьПараметр("ПредметТСх",Объект.Ссылка);
	ТЗ_План = Запрос.Выполнить().Выгрузить();
	
	Запрос2 = Новый Запрос;
	Запрос2.Текст = "ВЫБРАТЬ
	                |	ТехнологическаяСхема.Вариант КАК Вариант,
	                |	ТехнологическаяСхема.ТСх КАК ТСх,
	                |	ТехнологическаяСхема.ПредметТСх КАК ПредметТСх,
	                |	ТехнологическаяСхемаТЧ.Операция.Услуга КАК ОперацияУслуга,
	                |	ЛОЖЬ КАК ЕстьПлан,
	                |	ТехнологическаяСхемаТЧ.Операция КАК Операция
	                |ИЗ
	                |	РегистрСведений.ТехнологическаяСхема КАК ТехнологическаяСхема
	                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
	                |		ПО ТехнологическаяСхема.ТСх = ТехнологическаяСхемаТЧ.Ссылка
	                |ГДЕ
	                |	ТехнологическаяСхема.ПредметТСх = &ПредметТСх
	                |	И ТехнологическаяСхема.Вариант = ""Фактическая""";
	Запрос2.УстановитьПараметр("ПредметТСх",Объект.Ссылка);
	ТЗ_Факт = Запрос2.Выполнить().Выгрузить();
	
	// проверить, какие услуги есть в плане и в факте.
	// если данные совпадают, то установить соответствующие флаги
	Для Каждого Стр Из ТЗ_План Цикл
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ОперацияУслуга",Стр.ОперацияУслуга);
		НайденныйФакт = ТЗ_Факт.НайтиСтроки(ПараметрыОтбора);
		Если НайденныйФакт.Количество()>0 Тогда
			Стр.ЕстьФакт = Истина;
		КонецЕсли;
		Для Каждого НФ Из НайденныйФакт Цикл
			НФ.ЕстьПлан = Истина;
		КонецЦикла;
		
	КонецЦикла;
	
	// добавляем данные в ТЗ расхождений
	Для Каждого Стр Из ТЗ_План Цикл
		Если Стр.ЕстьФакт = Ложь Тогда
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("ОперацияУслуга",Стр.ОперацияУслуга);
			НайденныеСтр = ТЗРасхождений.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтр.Количество() = 0 Тогда
				НовСтр = ТЗРасхождений.Добавить();
				НовСтр.СтатьяРасхождений = "Несоблюдение операции";
				НовСтр.ОперацияУслуга = Стр.ОперацияУслуга;
				НовСтр.ОперацияРодитель = Стр.Операция;
				НовСтр.НетВФакте = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из ТЗ_Факт Цикл
		Если Стр.ЕстьПлан = Ложь Тогда
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("ОперацияУслуга",Стр.ОперацияУслуга);
			НайденныеСтр = ТЗРасхождений.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтр.Количество() = 0 Тогда
				НовСтр = ТЗРасхождений.Добавить();
				НовСтр.СтатьяРасхождений = "Несоблюдение операции";
				НовСтр.ОперацияУслуга = Стр.ОперацияУслуга;
				НовСтр.ОперацияРодитель = Стр.Операция;
				НовСтр.НетВПлане = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// для каждой операции получаем список ее КТК
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("СтатьяРасхождений","Несоблюдение операции");
	НайденныеСтр = ТЗРасхождений.НайтиСтроки(ПараметрыОтбора);
	Для Каждого Стр Из НайденныеСтр Цикл
		ТекТЧ = Стр.ОперацияРодитель.Грузы;
		МассивКТК = Новый Массив;
		Для Каждого СтрКТК Из ТекТЧ Цикл
			Если ЗначениеЗаполнено(СтрКТК.ТЕ) Тогда
				МассивКТК.Добавить(СтрКТК.ТЕ);
			КонецЕсли;
		КонецЦикла;
		КТКОперация = СтрСоединить(МассивКТК, ";");
		Стр.КТКОперацияРодитель = КТКОперация;
	КонецЦикла;
	
	КартинкаОшибки = БиблиотекаКартинок.СостоянияРасширенийОшибка;
	КартинкаВерно = БиблиотекаКартинок.СостоянияРасширенийПодключено;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("СтатьяРасхождений","Несоблюдение операции");
	НайденныеСтр = ТЗРасхождений.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеСтр.Количество()>0 Тогда
		Элементы.прав_ДополнительныеОперации.Картинка = КартинкаОшибки;
	Иначе
		Элементы.прав_ДополнительныеОперации.Картинка = КартинкаВерно;
	КонецЕсли;
	
	
КонецПроцедуры	

