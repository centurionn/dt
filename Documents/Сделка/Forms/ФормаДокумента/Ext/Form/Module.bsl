&НаСервере
Процедура ПостроитьДеревоПоЭлементу()
	
	Если НЕ ЗначениеЗаполнено(СсылкаТСх) тогда Возврат; КонецЕсли;
	
	ТЧ.Очистить();
	Для каждого Стр из СсылкаТСх.ТЧ Цикл
		НСтр = ТЧ.Добавить();
		ЗаполнитьЗначенияСвойств(НСтр, Стр);
		Если ЗначениеЗаполнено(Стр.Операция) тогда
			НСтр.СписокТС = Стр.Операция.СписокТС;
			НСтр.СписокТЕ = Стр.Операция.СписокТЕ;
			НСтр.ТранспортныйДокумент = Стр.Операция.ТранспортныйДокумент;
			НСтр.Состояние = Стр.Операция.ТекущееСостояние;
			Для каждого Стр3 из Стр.Операция.Состояния Цикл
				Если Стр3.Состояние = НСтр.Состояние Тогда
					НСтр.Статус = Стр3.Статус;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПерестроитьКлиентов()
	
	Пока Элементы.ГруппаКлиенты.ПодчиненныеЭлементы.Количество() > 0 Цикл
		Элементы.Удалить(Элементы.ГруппаКлиенты.ПодчиненныеЭлементы[0]);
	КонецЦикла;
	
	МассивКлиентов = Новый Массив;
	Для каждого Стр из Объект.Заявки Цикл
		Если МассивКлиентов.Найти(Стр.Заявка.Контрагент) = неопределено И ЗначениеЗаполнено(Стр.Заявка.Контрагент) Тогда МассивКлиентов.Добавить(Стр.Заявка.Контрагент); КонецЕсли;
	КонецЦикла;
	
	Для каждого Стр из МассивКлиентов Цикл
		НЭлемент = Элементы.Добавить("Стр"+СокрП(Стр.Код), Тип("ДекорацияФормы"), Элементы.ГруппаКлиенты);
		НЭлемент.Заголовок = Стр.Наименование + " " + Стр.ИНН;
		НЭлемент.Гиперссылка = Истина;
		НЭлемент.УстановитьДействие("Нажатие", "ОбработкаНажатияКлиента");
	КонецЦикла;
	
	/////////////////////////////////////////
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(Заявка.ДоходностьЗаявки) КАК ДоходностьЗаявки,
	               |	СУММА(Заявка.КонтрибуцияЗаявки) КАК КонтрибуцияЗаявки
	               |ИЗ
	               |	Документ.Заявка КАК Заявка
	               |ГДЕ
	               |	Заявка.Ссылка В(&СписокЗаявок)";
	Запрос.УстановитьПараметр("СписокЗаявок", Объект.Заявки.Выгрузить().ВыгрузитьКолонку("Заявка"));
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Элементы.ЗаявкиЗаявкаДоходностьЗаявки.ТекстПодвала = Формат(Ответ.ДоходностьЗаявки, "ЧДЦ=2; ЧН=");
		Элементы.ЗаявкиЗаявкаКонтрибуцияЗаявки.ТекстПодвала = Формат(Ответ.КонтрибуцияЗаявки, "ЧДЦ=2; ЧН=");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаНажатияКлиента(Параметр1 = неопределено, Параметр2 = неопределено)
	
	Контрагент = НайтиКонтрагентаПоКоду(Сред(Параметр1.Имя, 4));
	ПоказатьЗначение(, Контрагент);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиКонтрагентаПоКоду(КодКонтрагента) Экспорт
	
	Возврат Справочники.Контрагенты.НайтиПоКоду(КодКонтрагента);
	
КонецФункции

&НаКлиенте
Процедура ЗаявкиПриИзменении(Элемент)
	
	ПерестроитьКлиентов();
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница = Элементы.ГруппаТехнологическиеСхемы Тогда
		ПерестроитьДеревоПоТЧ();
	КонецЕсли;
	Если ТекущаяСтраница = Элементы.ГруппаЗаявки Тогда
		МассивЗаявок = Новый Массив;
		Для Каждого Стр Из Объект.Заявки Цикл
			МассивЗаявок.Добавить(Стр.Заявка);
		КонецЦикла;
		
		МассивСтруктурПоЗаявке = ПолучитьФинансыПоЗаявке(МассивЗаявок);
		Для Каждого Структ Из МассивСтруктурПоЗаявке Цикл
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Заявка",Структ.Заявка);
			НайденныеСтроки = Объект.Заявки.НайтиСтроки(ПараметрыОтбора);
			Для Каждого Стр Из НайденныеСтроки Цикл
				Стр.Оплачено = Структ.РТУПолностьюОплачен;
				Стр.Отфактурована = Структ.РеализацияНаВсеКТК;
				Стр.ПСЦНеЗаполнен = Структ.ПСЦНеЗаполнен;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьФинансыПоЗаявке(МассивЗаявокТЧ)
	
	МЗ = Новый Массив;
	Для Каждого Элем ИЗ МассивЗаявокТЧ Цикл
		МЗ.Добавить(Элем);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СделкаСвязьУчетныхЕдиниц.Ссылка КАК Сделка,
	               |	СделкаСвязьУчетныхЕдиниц.Заявка КАК Заявка,
	               |	СделкаСвязьУчетныхЕдиниц.Контейнер КАК Контейнер,
				   // Евросиб Фролов (26.12.2021 TASK №44663
				   |	СделкаСвязьУчетныхЕдиниц.ГУИДСтрокиЗаявки КАК ГУИДСтрокиЗаявки,
				   // Евросиб Фролов)
	               |	1 КАК ЗаявкаВСделке
	               |ПОМЕСТИТЬ ВыборкаСделок
	               |ИЗ
	               |	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	               |ГДЕ
	               |	НЕ СделкаСвязьУчетныхЕдиниц.Ссылка.ПометкаУдаления
	               |	И СделкаСвязьУчетныхЕдиниц.Заявка В(&Заявка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВыборкаСделок.Заявка КАК Заявка,
				   |	ВыборкаСделок.Контейнер КАК Контейнер,
				   // Евросиб Фролов (26.12.2021 TASK №44663
				   |	ВыборкаСделок.ГУИДСтрокиЗаявки КАК ГУИДСтрокиЗаявки,
				   // Евросиб Фролов)
	               |	РеализацияТоваровУслугРасшифровкаУслугПоТС.Ссылка КАК РТУ,
	               |	РеализацияТоваровУслугРасшифровкаУслугПоТС.Ссылка.СуммаДокумента КАК СуммаРТУ,
	               |	ВыборкаСделок.Сделка КАК Сделка,
	               |	ВыборкаСделок.ЗаявкаВСделке КАК ЗаявкаВСделке,
	               |	РеализацияТоваровУслугРасшифровкаУслугПоТС.Цена КАК СуммаНаКТК
	               |ПОМЕСТИТЬ УчЕдиницыСделки
	               |ИЗ
	               |	ВыборкаСделок КАК ВыборкаСделок
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.РасшифровкаУслугПоТС КАК РеализацияТоваровУслугРасшифровкаУслугПоТС
	               |		ПО ВыборкаСделок.Контейнер = РеализацияТоваровУслугРасшифровкаУслугПоТС.Контейнер 
				   //Евросиб СубботинВ #84453 02.07.2024 Начало // 
				  // |			И ВыборкаСделок.Сделка = РеализацияТоваровУслугРасшифровкаУслугПоТС.Ссылка.Сделка
				  // Евросиб US 82073 TA 114490 Рыбьяков К.А. 24.07.2025 ((
				  //|		И ВыборкаСделок.Сделка = РеализацияТоваровУслугРасшифровкаУслугПоТС.УдалитьСделка 
				   |		И ВыборкаСделок.Сделка = РеализацияТоваровУслугРасшифровкаУслугПоТС.КлючАналитикиСоставаПоезда.Сделка 
				  // Евросиб Рыбьяков К.А. 24.07.2025 ))
				   //Евросиб СубботинВ #84453 02.07.2024 Конец // 
	               |ГДЕ
	               |	НЕ ВыборкаСделок.Заявка = ЗНАЧЕНИЕ(Документ.Заявка.ПустаяСсылка)
	               |	И РеализацияТоваровУслугРасшифровкаУслугПоТС.Ссылка.Проведен
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЗаявкаСоставУслуги.Ссылка КАК Заявка,
	               |	МИНИМУМ(ВЫБОР
	               |			КОГДА НЕ УчЕдиницыСделки.Контейнер = ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК РеализацияНаВсеКТК,
	               |	МАКСИМУМ(ВыборкаСделок.ЗаявкаВСделке) КАК ЗаявкаВСделке
	               |ПОМЕСТИТЬ КТКСРеализацией
	               |ИЗ
	               |	Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
	               |		ЛЕВОЕ СОЕДИНЕНИЕ УчЕдиницыСделки КАК УчЕдиницыСделки
	               |		ПО ЗаявкаСоставУслуги.Ссылка = УчЕдиницыСделки.Заявка
				   // Евросиб Фролов (26.12.2021 TASK №44663
				   //|			И ЗаявкаСоставУслуги.НомерКТК = УчЕдиницыСделки.Контейнер
				   |			И ЗаявкаСоставУслуги.ГУИДСтроки = УчЕдиницыСделки.ГУИДСтрокиЗаявки
				   // Евросиб Фролов)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВыборкаСделок КАК ВыборкаСделок
	               |		ПО ЗаявкаСоставУслуги.Ссылка = ВыборкаСделок.Заявка
	               |ГДЕ
	               |	НЕ ЗаявкаСоставУслуги.НомерКТК = ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяССылка)
	               |	И НЕ ЗаявкаСоставУслуги.Ссылка.ПометкаУдаления
	               |	И ЗаявкаСоставУслуги.Ссылка В(&Заявка)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаявкаСоставУслуги.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	КТКСРеализацией.Заявка КАК Заявка,
	               |	КТКСРеализацией.РеализацияНаВсеКТК КАК РеализацияНаВсеКТК,
	               |	КТКСРеализацией.ЗаявкаВСделке КАК ЗаявкаВСделке,
	               |	УчЕдиницыСделки.РТУ КАК РТУ,
	               |	УчЕдиницыСделки.СуммаРТУ КАК СуммаРТУ,
	               |	СУММА(УчЕдиницыСделки.СуммаНаКТК) КАК СуммаНаКТК
	               |ПОМЕСТИТЬ ЗаявкиИРТУ
	               |ИЗ
	               |	КТКСРеализацией КАК КТКСРеализацией
	               |		ЛЕВОЕ СОЕДИНЕНИЕ УчЕдиницыСделки КАК УчЕдиницыСделки
	               |		ПО КТКСРеализацией.Заявка = УчЕдиницыСделки.Заявка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	УчЕдиницыСделки.РТУ,
	               |	КТКСРеализацией.Заявка,
	               |	КТКСРеализацией.РеализацияНаВсеКТК,
	               |	КТКСРеализацией.ЗаявкаВСделке,
	               |	УчЕдиницыСделки.СуммаРТУ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПоступлениеНаРасчетныйСчетДокументыОплаты.СуммаОплаты КАК СуммаОплаты,
	               |	УчЕдиницыСделки.РТУ КАК РТУ,
	               |	СУММА(УчЕдиницыСделки.СуммаРТУ) КАК СуммаРТУ,
	               |	СУММА(УчЕдиницыСделки.СуммаНаКТК) КАК СуммаНаКТК
	               |ПОМЕСТИТЬ ОплатаРТУ
	               |ИЗ
	               |	УчЕдиницыСделки КАК УчЕдиницыСделки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеНаРасчетныйСчет.ДокументыОплаты КАК ПоступлениеНаРасчетныйСчетДокументыОплаты
	               |		ПО УчЕдиницыСделки.РТУ = ПоступлениеНаРасчетныйСчетДокументыОплаты.ДокументРеализации
	               |			И (ПоступлениеНаРасчетныйСчетДокументыОплаты.Ссылка.Проведен)
	               |ГДЕ
	               |	ПоступлениеНаРасчетныйСчетДокументыОплаты.Ссылка.Проведен
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	УчЕдиницыСделки.РТУ,
	               |	ПоступлениеНаРасчетныйСчетДокументыОплаты.СуммаОплаты
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОплатаРТУ.РТУ КАК РТУ,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(ОплатаРТУ.СуммаОплаты, 0) >= ЕСТЬNULL(ОплатаРТУ.СуммаНаКТК, 0)
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК РТУПолностьюОплачен,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(ОплатаРТУ.СуммаОплаты, 0) >= ЕСТЬNULL(ОплатаРТУ.СуммаНаКТК, 0)
	               |			ТОГДА 0
	               |		ИНАЧЕ ЕСТЬNULL(ОплатаРТУ.СуммаНаКТК, 0) - ЕСТЬNULL(ОплатаРТУ.СуммаОплаты, 0)
	               |	КОНЕЦ КАК ОстатокОплаты
	               |ПОМЕСТИТЬ ПолнаяОплатаРТУ
	               |ИЗ
	               |	ОплатаРТУ КАК ОплатаРТУ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЗаявкиИРТУ.РеализацияНаВсеКТК КАК РеализацияНаВсеКТК,
	               |	СУММА(ВЫБОР
	               |			КОГДА ЗаявкиИРТУ.РеализацияНаВсеКТК = 1
	               |				ТОГДА ПолнаяОплатаРТУ.ОстатокОплаты
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК РТУПолностьюОплачен,
	               |	ЗаявкиИРТУ.Заявка КАК Заявка,
	               |	ВЫБОР
	               |		КОГДА ЗаявкиИРТУ.Заявка.ПСЦ = ЗНАЧЕНИЕ(Документ.ПСЦ.ПустаяССылка)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ПСЦНеЗаполнен
	               |ИЗ
	               |	ЗаявкиИРТУ КАК ЗаявкиИРТУ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПолнаяОплатаРТУ КАК ПолнаяОплатаРТУ
	               |		ПО ЗаявкиИРТУ.РТУ = ПолнаяОплатаРТУ.РТУ
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаявкиИРТУ.Заявка,
	               |	ЗаявкиИРТУ.РеализацияНаВсеКТК,
	               |	ВЫБОР
	               |		КОГДА ЗаявкиИРТУ.Заявка.ПСЦ = ЗНАЧЕНИЕ(Документ.ПСЦ.ПустаяССылка)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ";
	Запрос.УстановитьПараметр("Заявка",МЗ);
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	МассивСтруктур = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТЗ);
	
	Возврат МассивСтруктур;
	
КонецФункции

&НаКлиенте
Процедура ПерестроитьДеревоПоТЧ()
	
	РеестрРодителей = Новый Соответствие;
	
	РеестрСоответствияКодов = Новый Соответствие;
	СчРодитель = 1;
	Для каждого Стр из ТЧ Цикл
		Если Стр.НесколькоРодителей Тогда
			Если ЗначениеЗаполнено(Стр.Родитель1) Тогда РеестрСоответствияКодов.Вставить(Стр.Родитель1, СчРодитель); СчРодитель = СчРодитель + 1; КонецЕсли;
			Если ЗначениеЗаполнено(Стр.Родитель2) Тогда РеестрСоответствияКодов.Вставить(Стр.Родитель2, СчРодитель); СчРодитель = СчРодитель + 1; КонецЕсли;
			Если ЗначениеЗаполнено(Стр.Родитель3) Тогда РеестрСоответствияКодов.Вставить(Стр.Родитель3, СчРодитель); СчРодитель = СчРодитель + 1; КонецЕсли;
			Если ЗначениеЗаполнено(Стр.Родитель4) Тогда РеестрСоответствияКодов.Вставить(Стр.Родитель4, СчРодитель); СчРодитель = СчРодитель + 1; КонецЕсли;
			Если ЗначениеЗаполнено(Стр.Родитель5) Тогда РеестрСоответствияКодов.Вставить(Стр.Родитель5, СчРодитель); СчРодитель = СчРодитель + 1; КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Дерево.ПолучитьЭлементы().Очистить();
	ОперацииСозданы = Истина;
	Для каждого Стр из ТЧ Цикл
		Если НЕ ЗначениеЗаполнено(Стр.Родитель1) ИЛИ Стр.НесколькоРодителей Тогда
			НСтр = Дерево.ПолучитьЭлементы().Добавить();
			НСтр.СвязьВх = 9;
			НСтр.СвязьИсх = 9;
			ЗаполнитьЗначенияСвойств(НСтр, Стр);
			РеестрРодителей.Вставить(НСтр.ГУИД, НСтр);
		Иначе
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Стр.Операция) Тогда ОперацииСозданы = Ложь; КонецЕсли;
		Если РеестрСоответствияКодов.Получить(НСтр.ГУИД) <> неопределено Тогда
			НСтр.МойНомер = РеестрСоответствияКодов.Получить(НСтр.ГУИД);
			НСтр.СвязьИсх = 0;
		КонецЕсли;
		Если НСтр.НесколькоРодителей Тогда
			НСтр.НомераРодителейСписком = "";
			НСтр.СвязьВх = 1;
			Если ЗначениеЗаполнено(НСтр.Родитель1) Тогда НСтр.НомераРодителейСписком = РеестрСоответствияКодов.Получить(НСтр.Родитель1); КонецЕсли;
			Если ЗначениеЗаполнено(НСтр.Родитель2) Тогда НСтр.НомераРодителейСписком = НСтр.НомераРодителейСписком + ?(НСтр.НомераРодителейСписком = "", "", ", ") + РеестрСоответствияКодов.Получить(НСтр.Родитель2); КонецЕсли;
			Если ЗначениеЗаполнено(НСтр.Родитель3) Тогда НСтр.НомераРодителейСписком = НСтр.НомераРодителейСписком + ?(НСтр.НомераРодителейСписком = "", "", ", ") + РеестрСоответствияКодов.Получить(НСтр.Родитель3); КонецЕсли;
			Если ЗначениеЗаполнено(НСтр.Родитель4) Тогда НСтр.НомераРодителейСписком = НСтр.НомераРодителейСписком + ?(НСтр.НомераРодителейСписком = "", "", ", ") + РеестрСоответствияКодов.Получить(НСтр.Родитель4); КонецЕсли;
			Если ЗначениеЗаполнено(НСтр.Родитель5) Тогда НСтр.НомераРодителейСписком = НСтр.НомераРодителейСписком + ?(НСтр.НомераРодителейСписком = "", "", ", ") + РеестрСоответствияКодов.Получить(НСтр.Родитель5); КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Для Сч = 0 По ТЧ.Количество()-1 Цикл
		Если РеестрРодителей.Получить(ТЧ[Сч].ГУИД) = неопределено И РеестрРодителей.Получить(ТЧ[Сч].Родитель1) <> неопределено Тогда
			НСтр = РеестрРодителей.Получить(ТЧ[Сч].Родитель1).ПолучитьЭлементы().Добавить();
			НСтр.СвязьВх = 9;
			НСтр.СвязьИсх = 9;
			ЗаполнитьЗначенияСвойств(НСтр, ТЧ[Сч]);
			
			Если РеестрСоответствияКодов.Получить(НСтр.ГУИД) <> неопределено Тогда
				НСтр.МойНомер = РеестрСоответствияКодов.Получить(НСтр.ГУИД);
				НСтр.СвязьИсх = 0;
			КонецЕсли;
			Если НСтр.НесколькоРодителей Тогда
				НСтр.НомераРодителейСписком = "";
				НСтр.СвязьВх = 1;
				Если ЗначениеЗаполнено(НСтр.Родитель1) Тогда НСтр.НомераРодителейСписком = РеестрСоответствияКодов.Получить(НСтр.Родитель1); КонецЕсли;
				Если ЗначениеЗаполнено(НСтр.Родитель2) Тогда НСтр.НомераРодителейСписком = НСтр.НомераРодителейСписком + ?(НСтр.НомераРодителейСписком = "", "", ", ") + РеестрСоответствияКодов.Получить(НСтр.Родитель2); КонецЕсли;
				Если ЗначениеЗаполнено(НСтр.Родитель3) Тогда НСтр.НомераРодителейСписком = НСтр.НомераРодителейСписком + ?(НСтр.НомераРодителейСписком = "", "", ", ") + РеестрСоответствияКодов.Получить(НСтр.Родитель3); КонецЕсли;
				Если ЗначениеЗаполнено(НСтр.Родитель4) Тогда НСтр.НомераРодителейСписком = НСтр.НомераРодителейСписком + ?(НСтр.НомераРодителейСписком = "", "", ", ") + РеестрСоответствияКодов.Получить(НСтр.Родитель4); КонецЕсли;
				Если ЗначениеЗаполнено(НСтр.Родитель5) Тогда НСтр.НомераРодителейСписком = НСтр.НомераРодителейСписком + ?(НСтр.НомераРодителейСписком = "", "", ", ") + РеестрСоответствияКодов.Получить(НСтр.Родитель5); КонецЕсли;
			КонецЕсли;

			РеестрРодителей.Вставить(НСтр.ГУИД, НСтр);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого Стр из Дерево.ПолучитьЭлементы() Цикл
		Элементы.Дерево.Развернуть(Стр.ПолучитьИдентификатор(), Истина);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПриИзменении(Элемент)
	
	Если Элементы.Дерево.ТекущиеДанные = неопределено Тогда Возврат; КонецЕсли;
	
	Для каждого Стр из ТЧ Цикл
		Если Элементы.Дерево.ТекущиеДанные.ГУИД = Стр.ГУИД Тогда 
			ЗаполнитьЗначенияСвойств(Стр,  Элементы.Дерево.ТекущиеДанные); 
			Прервать; 
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекД = Элементы.Дерево.ТекущиеДанные;
	
	Если НоваяСтрока Тогда
		
		НСтр = ТЧ.Добавить();
		ТекД.Регламентный = Истина;
		ТекД.Валюта = Объект.Валюта;
		ТекД.Картинка = 0;
		ТекД.СвязьВх = 9;
		ТекД.СвязьИсх = 9;
		ТекД.ГУИД = Строка(Новый УникальныйИдентификатор);
		ТекД.ТипДлительности = ПредопределенноеЗначение("Перечисление.ЕдиницаИзмеренияДлительности.КалендарныйДень");
		ТекД.Валюта = Объект.Валюта;
		Сч = 1;
		Для каждого Стр из ПослРодители Цикл
			ТекД["Родитель"+Сч] = Стр.Значение;
			Сч = Сч + 1;
			Если Сч > 5 Тогда Прервать; КонецЕсли;
		КонецЦикла;
		ТекД.НесколькоРодителей = (ПослРодители.Количество() > 1);
		ЗаполнитьЗначенияСвойств(НСтр, ТекД);
		Если ТекД.НесколькоРодителей Тогда
			ПерестроитьДеревоПоТЧ();
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПередУдалением(Элемент, Отказ)
	
	ТекД = Элементы.Дерево.ТекущиеДанные;
	МассивПодчиненных = ПостроительТСх_клиент.ПолучитьМассивПодчиненных(ТЧ, ТекД.ГУИД, Истина, Ложь);
	
	МассивУдаляемых = Новый Массив;
	
	Для каждого Стр из ТЧ Цикл
		Если МассивПодчиненных.Найти(Стр.ГУИД) <> неопределено Тогда
			МассивУдаляемых.Добавить(Стр);
		Иначе
			ХотьЧтоТоСтерли = Ложь;
			Если МассивПодчиненных.Найти(Стр.Родитель1) <> неопределено Тогда
				ХотьЧтоТоСтерли = Истина;
				Стр.Родитель1 = "";
			КонецЕсли;
			Если Стр.Родитель2 <> "" И МассивПодчиненных.Найти(Стр.Родитель2) <> неопределено Тогда
				ХотьЧтоТоСтерли = Истина;
				Стр.Родитель2 = "";
			КонецЕсли;
			Если Стр.Родитель3 <> "" И МассивПодчиненных.Найти(Стр.Родитель3) <> неопределено Тогда
				ХотьЧтоТоСтерли = Истина;
				Стр.Родитель3 = "";
			КонецЕсли;
			Если Стр.Родитель4 <> "" И МассивПодчиненных.Найти(Стр.Родитель4) <> неопределено Тогда
				ХотьЧтоТоСтерли = Истина;
				Стр.Родитель4 = "";
			КонецЕсли;
			Если Стр.Родитель5 <> "" И МассивПодчиненных.Найти(Стр.Родитель5) <> неопределено Тогда
				ХотьЧтоТоСтерли = Истина;
				Стр.Родитель5 = "";
			КонецЕсли;
			Если ХотьЧтоТоСтерли И Стр.Родитель1 = "" И Стр.Родитель2 = "" И Стр.Родитель3 = "" И Стр.Родитель4 = "" И Стр.Родитель5 = "" Тогда
				МассивУдаляемых.Добавить(Стр);
			ИначеЕсли ХотьЧтоТоСтерли Тогда
				ПостроительТСх_клиент.НормализоватьРодителейЭлемента(Стр);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для каждого Стр из МассивУдаляемых Цикл
		ТЧ.Удалить(Стр);
	КонецЦикла;
	
	ПерестроитьДеревоПоТЧ();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	ПослРодители.Очистить();
	Для каждого Стр из Элементы.Дерево.ВыделенныеСтроки Цикл
		ПослРодители.Добавить(Дерево.НайтиПоИдентификатору(Стр).ГУИД);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТСхОглавлениеПриАктивизацииСтроки(Элемент)
	
	ТекД = Элементы.ТСхОглавление.ТекущиеДанные;
	Если ТекД = неопределено ИЛИ (ТекД.ЭлементТСх = СсылкаТСх И ЗначениеЗаполнено(СсылкаТСх)) Тогда Возврат; КонецЕсли;
	
	Если ЗначениеЗаполнено(СсылкаТСх) Тогда
		Разблокировать_сервер();
		ЗахваченоДляРедактирования = Ложь;
	КонецЕсли;
	
	ОбновитьОтображениеКнопокРедактирования();
	
	СсылкаТСх = ТекД.ЭлементТСх;
	Вариант = ТекД.Вариант;
	Дерево.ПолучитьЭлементы().Очистить();
	ТЧ.Очистить();
	ПостроитьДеревоПоЭлементу();
	ПерестроитьДеревоПоТЧ();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеКнопокРедактирования()
	
	Если ЗахваченоДляРедактирования Тогда
		Элементы.ВключитьРедактирование.ЦветФона = WebЦвета.Розовый;
	Иначе
		Элементы.ВключитьРедактирование.ЦветФона = Элементы.ОтменитьРедактирование.ЦветФона;
	КонецЕсли;
	Элементы.общ_Связи.Доступность = ЗахваченоДляРедактирования;
	Элементы.Дерево.ТолькоПросмотр = НЕ ЗахваченоДляРедактирования;
	Элементы.СоздатьОперации.Доступность = ЗахваченоДляРедактирования;
	Элементы.Дерево_ДобавитьКорень.Доступность = ЗахваченоДляРедактирования;
	Элементы.НайтиПодсылы.Доступность = ЗахваченоДляРедактирования;
	
КонецПроцедуры

&НаСервере
Процедура Разблокировать_сервер()
	
	Попытка
		РазблокироватьДанныеДляРедактирования(СсылкаТСх, ЭтаФорма.УникальныйИдентификатор);
		ЗахваченоДляРедактирования = Ложь;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура Заблокировать_сервер()
	
	Попытка
		ЗаблокироватьДанныеДляРедактирования(СсылкаТСх,, ЭтаФорма.УникальныйИдентификатор);	
		ЗахваченоДляРедактирования = Истина;
	Исключение
		ОО = ОписаниеОшибки();
		Сообщить("Объект заблокирован: " + ОО);
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ТСхОглавлениеПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = истина;
	ОпОп = Новый ОписаниеОповещения("ОбработкаНовогоВарианта", ЭтаФорма);
	ПоказатьВводСтроки(ОпОп, , "Введите имя нового варианта", 20, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаНовогоВарианта(Параметр1 = неопределено, Параметр2 = неопределено) экспорт
	
	Если НЕ ЗначениеЗаполнено(Параметр1) Тогда Возврат;	КонецЕсли;
	
	Для каждого Стр из ТСхОглавление.ПолучитьЭлементы() Цикл
		Если Стр.Вариант = Параметр1 Тогда 
			Сообщить("Такой вариант уже есть!"); 
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	НСтр = ТСхОглавление.ПолучитьЭлементы().Добавить();
	НСтр.Вариант = Параметр1;
	Элементы.ТСхОглавление.ТекущаяСтрока = НСтр.ПолучитьИдентификатор();
	
	
	ТСхОглавлениеПриАктивизацииСтроки(неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ТСхОглавлениеПередУдалением(Элемент, Отказ)
	
	Отказ = истина;
	ОпОп = Новый ОписаниеОповещения("ОбработчикВопросаУдаления", ЭтаФорма);
	ПоказатьВопрос(ОпОп, "Вы действительно хотите удалить вариант ТСх?", РежимДиалогаВопрос.ДаНет, 30, КодВозвратаДиалога.Нет,, КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВопросаУдаления(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;
	
	Если ЗахваченоДляРедактирования Тогда
		Разблокировать_сервер();
	КонецЕсли;
	
	ПостроительТСх_сервер.Удалить_ТСх(СсылкаТСх);
	
	ТСхОглавление.ПолучитьЭлементы().Удалить(Элементы.ТСхОглавление.ТекущаяСтрока);
	
	ТСхОглавлениеПриАктивизацииСтроки(неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура Дерево_ДобавитьКорень(Команда)
	
	ПослРодители.Очистить();
	ТекД = Дерево.ПолучитьЭлементы().Добавить();
	ТекД.Регламентный = Истина;
	ТекД.Картинка = 0;
	ТекД.СвязьВх = 9;
	ТекД.СвязьИсх = 9;
	ТекД.ГУИД = Строка(Новый УникальныйИдентификатор);
	ТекД.ТипДлительности = ПредопределенноеЗначение("Перечисление.ЕдиницаИзмеренияДлительности.КалендарныйДень");
	ТекД.Валюта = Объект.Валюта;
	НСтр = ТЧ.Добавить();
	ЗаполнитьЗначенияСвойств(НСтр, ТекД);
	Элементы.Дерево.ТекущаяСтрока = ТекД.ПолучитьИдентификатор();
	
КонецПроцедуры

&НаКлиенте
Процедура общ_Открыть(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаОткрытия", ЭтаФорма);
	
	СписокВыбораОткрытие = Новый СписокЗначений;
