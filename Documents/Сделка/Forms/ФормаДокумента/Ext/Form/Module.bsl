	КонецЕсли;
	
	ОшибкиЗаполнения = Неопределено;
	ВидТСМоре = Ложь;
	
	Для	Каждого Эл ИЗ Результаты Цикл
		СтруктураПоиска = Новый Структура("Клиент", Эл);
		СтрокиКлиента = Объект.СвязьУчетныхЕдиниц.НайтиСтроки(СтруктураПоиска);
