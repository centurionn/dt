&НаКлиенте
Процедура ДоходыПередНачаломИзменения(Элемент, Отказ)

	ТекД = Элементы.Доходы.ТекущиеДанные;
	Если Элемент.ТекущийЭлемент.Имя = "ДоходыУчДокумент" Тогда
		Если ЗначениеЗаполнено(ТекД.УчДокумент) Тогда
			ПоказатьЗначение(,ТекД.УчДокумент);
			Отказ = Истина;
		КонецЕсли;
	ИначеЕсли Элемент.ТекущийЭлемент.Имя = "ДоходыПериодВО" Тогда
		Если ЗначениеЗаполнено(ТекД.УчДокумент) Тогда
			ПоказатьПредупреждение(,"Нельзя менять период ВО у строчек с сформированными документами");
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли; 

КонецПроцедуры

&НаКлиенте
Процедура РасходыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущаяСтрокаРасход = Объект.Расходы.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ТекущаяСтрокаРасход <> Неопределено И Поле.Имя = "РасходыУчДокумент" И ЗначениеЗаполнено(ТекущаяСтрокаРасход.УчДокумент) Тогда
		ПоказатьЗначение(, ТекущаяСтрокаРасход.УчДокумент);
	ИначеЕсли ТекущаяСтрокаРасход <> Неопределено И Поле.Имя = "РасходыКалькуляция" И ЗначениеЗаполнено(ТекущаяСтрокаРасход.Калькуляция) Тогда
		ПоказатьЗначение(, ТекущаяСтрокаРасход.Калькуляция);
	ИначеЕсли ТекущаяСтрокаРасход <> Неопределено И Поле.Имя = "РасходыУслуга" И ЗначениеЗаполнено(ТекущаяСтрокаРасход.Услуга) Тогда
		ПоказатьЗначение(, ТекущаяСтрокаРасход.Услуга);
	ИначеЕсли ТекущаяСтрокаРасход <> Неопределено И Поле.Имя = "РасходыТранспортныйДокумент" И ЗначениеЗаполнено(ТекущаяСтрокаРасход.ТранспортныйДокумент) Тогда
		ПоказатьЗначение(, ТекущаяСтрокаРасход.ТранспортныйДокумент);
	ИначеЕсли ТекущаяСтрокаРасход <> Неопределено И Поле.Имя = "РасходыПеренесеннаяСделка" И ЗначениеЗаполнено(ТекущаяСтрокаРасход.ПеренесеннаяСделка) Тогда
		ПоказатьЗначение(, ТекущаяСтрокаРасход.ПеренесеннаяСделка);
	ИначеЕсли ТекущаяСтрокаРасход <> Неопределено И Поле.Имя = "РасходыПунктОтправления" И ЗначениеЗаполнено(ТекущаяСтрокаРасход.ПунктОтправления) Тогда
		ПоказатьЗначение(, ТекущаяСтрокаРасход.ПунктОтправления);
	ИначеЕсли ТекущаяСтрокаРасход <> Неопределено И Поле.Имя = "РасходыПунктНазначения" И ЗначениеЗаполнено(ТекущаяСтрокаРасход.ПунктНазначения) Тогда
		ПоказатьЗначение(, ТекущаяСтрокаРасход.ПунктНазначения);
	ИначеЕсли ТекущаяСтрокаРасход <> Неопределено И Поле.Имя = "РасходыНеИспользовать" И ОбщегоНазначенияКлиент.РежимОтладки() Тогда
		ТекущаяСтрокаРасход.УслугаОтключена = НЕ ТекущаяСтрокаРасход.УслугаОтключена;
	КонецЕсли;
	
КонецПроцедуры

