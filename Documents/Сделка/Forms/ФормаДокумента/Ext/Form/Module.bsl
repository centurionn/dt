Процедура ЗаявкиКалькуляцияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекД = Элементы.Заявки.ТекущиеДанные;
	КалькТек = ТекД.Калькуляция;
	Элементы.ЗаявкиКалькуляция.СписокВыбора.Очистить();
	ВсеКалькуляции = ПолучитьВсеКалькуляцииЗаявки(ТекД.Заявка, ПредопределенноеЗначение("Справочник.РейсыЖД.ПустаяСсылка"));
	Для каждого Стр из ВсеКалькуляции цикл
		Элементы.ЗаявкиКалькуляция.СписокВыбора.Добавить(Стр.Калькуляция);
	КонецЦикла;
	
	ТекД.Калькуляция = КалькТек;
	
