			НСтрРасходы.СебестоимостьИтого = НСтрРасходы.Себестоимость;
			НСтрРасходы.СтавкаНДС = Перечисления.СтавкиНДС.НДС0;
			НСтрРасходы.СуммаИтого = НСтрРасходы.Себестоимость;
			НСтрРасходы.ГУИД = Строка(Новый УникальныйИдентификатор());
			НСтрРасходы.ТипВагонов = Стр.Вагон.ТипТС;
			НСтрРасходы.ТипКТК = Стр.Контейнер.ТипТЕ;
			НСтрРасходы.ПериодВО = ПериодБлокировки8;
			НСтрРасходы.Валюта = Справочники.Валюты.Рубль;
			НСтрРасходы.Регламентный = Истина;
			НСтрРасходы.Комментарий = "Добавлено автоматически по накладной " + Стр.НомерПорожнейВагоннойЖДН;
			НСтрРасходы.ПлановаяСтоимостьИзЖДН = Истина;
			НСтрРасходы.СписокВагонов = Стр.Вагон;
			НСтрРасходы.СписокКТК = Стр.Контейнер;
			НСтрРасходы.СписокТД = Стр.НомерПорожнейВагоннойЖДН;
			
			Для каждого Стр8 из Объект.Доходы Цикл
				Если СтрНайти(Стр.Контейнер, Стр8.СписокКТК) > 0 Тогда 
					НСтр8 = Объект.СвязьДоходовИРасходов.Добавить();
					НСтр8.Доходы = Стр8.ГУИД;
					НСтр8.Расходы = НСтрРасходы.ГУИД;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли; 
				
	КонецЦикла;	
	
КонецПроцедуры

