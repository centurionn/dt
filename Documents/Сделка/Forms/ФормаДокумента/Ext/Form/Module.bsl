					Если Стр7.Доходы = СтрДоходов.ГУИД Тогда МассивСоотвРасходов.Добавить(Стр7.Расходы); КонецЕсли;
				КонецЦикла;
				
				НайденаНужнаяНамУслуга = Ложь;
				Если НЕ НайденаНужнаяНамУслуга Тогда
					
					НСтр2 = Объект.Расходы.Добавить();
					НСтр2.ГУИД = Строка(Новый УникальныйИдентификатор);
					НСтр2.ПериодВО = СтрДоходов.ПериодВО;
