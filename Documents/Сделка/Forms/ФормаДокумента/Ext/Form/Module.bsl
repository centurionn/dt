&НаКлиенте
Процедура СвязьУчетныхЕдиницВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	// Евросиб Фролов (17.02.2022 Task №45918 
	// Для администратора разрешить изменять данные в составе поезда независимо от наличия закрывающих документов.
	Если ПользовательСПолнымиПравами Тогда
		Возврат;	
	КонецЕсли;		
	// Евросиб Фролов)
	
	// Евросиб Фролов (01.10.2021 Ticket№ 0244988
	МассивИсключений = Новый Массив();
	МассивИсключений.Добавить("РазмерКТК");
	МассивИсключений.Добавить("Контейнер");
	МассивИсключений.Добавить("Калькуляция");
	МассивИсключений.Добавить("Груз");
	МассивИсключений.Добавить("ЖДН");
	МассивИсключений.Добавить("НомерЖДН");
	МассивИсключений.Добавить("Доплата_ПСЦ");
	// Евросиб Фролов)
	
	// Евросиб Фролов (28.09.2021 Task№ 40023
	ИмяПроверяемогоПоля = СтрЗаменить(Поле.Имя, "СвязьУчетныхЕдиниц", "");
	
	// Евросиб Фролов (01.10.2021 Ticket№ 0244988
	Если МассивИсключений.Найти(ИмяПроверяемогоПоля) <> Неопределено 
		И НЕ Элементы.СвязьУчетныхЕдиниц.ТекущиеДанные.СформированыЗакрывающиеДокументы Тогда
		Возврат;
	КонецЕсли;
	// Евросиб Фролов)
	
	УИ = Новый УникальныйИдентификатор;
	СтруктураПроверки = Новый Структура(ИмяПроверяемогоПоля, УИ);
	ЗаполнитьЗначенияСвойств(СтруктураПроверки, Элементы.СвязьУчетныхЕдиниц.ТекущиеДанные);
	ЗначениеПоля = СтруктураПроверки[ИмяПроверяемогоПоля];
	Если ЗначениеПоля <> УИ Тогда
		Если ЗначениеСсылочногоТипа(ЗначениеПоля)
			И ЗначениеЗаполнено(ЗначениеПоля) Тогда
			ПоказатьЗначение(, ЗначениеПоля);
			СтандартнаяОбработка = Ложь;	
		КонецЕсли;
	КонецЕсли;
	// Евросиб Фролов)
	
КонецПроцедуры	

