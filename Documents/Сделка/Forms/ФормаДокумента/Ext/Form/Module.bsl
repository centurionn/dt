&НаКлиенте
Процедура ОбъединитьCтрокиДляВыставления(Команда)
	
	//Ограничения на группирование строк должно включать одинаковые значения реквизитов:
	//в Доходах: Клиент, Договор, СтавкаНДС, НДСВключенВСтоимость, СтавкаНДСВознаграждения, ВознаграждениеВключаетНДС, ПериодВО, ДокументФФД, Перевыставляемая, УслугаВнеСтавки
	//для ВР в Расходах: УчДокумент
	МассивГУИДСтрокДляОбработки = Новый Массив;
	ГУИДпервойВыделеннойСтроки = "";
	
	Для каждого Стр из Элементы.Доходы.ВыделенныеСтроки Цикл
		ТекСтрока = Объект.Доходы.НайтиПоИдентификатору(Стр);
		Если ТекСтрока.ИдентификаторГруппировки > 0 Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ТекСтрока.УслугаВнеСтавки Тогда
			Продолжить;
		КонецЕсли;
		Если ТекСтрока.ДоплатныеКТК Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекСтрока.УчДокумент) Тогда
			Продолжить;
		КонецЕсли;
		МассивГУИДСтрокДляОбработки.Добавить(ТекСтрока.ГУИД);
	КонецЦикла;
	
	МассивГУИДСтрокДляОбработки = ПолучитьСтрокиДоходовВозможныеДляГруппировки(МассивГУИДСтрокДляОбработки);
	
	Если МассивГУИДСтрокДляОбработки.Количество() <> Элементы.Доходы.ВыделенныеСтроки.Количество() Тогда
		текстСообщения = "Не удалось объединить все выбранные строки. Для успешного объединения должны быть выполнены условия: 
						|1) доходы по Доп.услугам или Перевыставляемые
						|2) совпадают значения полей: Клиент, Договор, Ставка НДС, НДС вкл. в ставку, Ставка НДС вознаграждения, Вознаграждение включает НДС, ПериодВО, Правило формирования документов
						|3) для Перевыставляемых учетные документы в расходах должны совпадать";
		ОбщегоНазначенияКлиент.СообщитьПользователю(текстСообщения);
	КонецЕсли;
	
	Если МассивГУИДСтрокДляОбработки.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;
	
	//Максимальный номер Группировки
	МаксимальныйИдентификаторГруппировки = 0;
	Для каждого Стр Из Объект.Доходы Цикл
		МаксимальныйИдентификаторГруппировки = Макс(МаксимальныйИдентификаторГруппировки, Цел(Стр.ИдентификаторГруппировки));
	КонецЦикла;
	
	НовыйИдентификаторГруппировки = МаксимальныйИдентификаторГруппировки + 1;
	
	ФлагИзменений = Ложь;
	
	Для каждого Стр из МассивГУИДСтрокДляОбработки Цикл
		Отбор = Новый Структура("ГУИД", Стр);
		ТекСтрока = Объект.Доходы.НайтиСтроки(Отбор)[0];
		ТекСтрока.ИдентификаторГруппировки = НовыйИдентификаторГруппировки;
		ФлагИзменений = Истина;
	КонецЦикла;
	
	Если ФлагИзменений Тогда
		Объект.Доходы.Сортировать("ИдентификаторГруппировки, Клиент, Договор");
		//Евросиб(ДИТ), Беляев СЮ, US 89710/TA 89712, 27-08-2024, начало
		Модифицированность = Истина;
		//Евросиб(ДИТ), Беляев СЮ, US 89710/TA 89712, 27-08-2024, конец
	КонецЕсли;
	
	УстановитьКартинкиОбъединеннымСтрокамДоходов();
	
КонецПроцедуры
//Евросиб(ДИТ), Беляев СЮ, US 88163/TA 88167, 26-07-2024, конец

//Евросиб(ДИТ), Беляев СЮ, US 88163/TA 88167, 26-07-2024, начало
&НаКлиенте
Процедура УстановитьКартинкиОбъединеннымСтрокамДоходов()
	
	//ФОРМИРОВАНИЕ СТРУКТУРЫ СГРУППИРОВАННЫХ СТРОК
	СгруппированныеСтроки = Новый Соответствие();
	Для Каждого СтрокаДохода Из Объект.Доходы Цикл
		Если СтрокаДохода.ИдентификаторГруппировки = 0 Тогда
			Продолжить;
		КонецЕсли;
		МассивИдентификаторовСтрок = Новый Массив();
		МассивИдентификаторовСтрок.Добавить(СтрокаДохода.ПолучитьИдентификатор());
			
		НайденнаяГруппа = СгруппированныеСтроки.Получить(СтрокаДохода.ИдентификаторГруппировки);
		Если НайденнаяГруппа = Неопределено Тогда
			СгруппированныеСтроки.Вставить(СтрокаДохода.ИдентификаторГруппировки, МассивИдентификаторовСтрок);
		Иначе
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(НайденнаяГруппа, МассивИдентификаторовСтрок);
			СгруппированныеСтроки.Вставить(СтрокаДохода.ИдентификаторГруппировки, НайденнаяГруппа);
		КонецЕсли;
	КонецЦикла;
	
	Элементы.ДоходыГруппаКартинокГруппировкиСтрок.Видимость = СгруппированныеСтроки.Количество() > 0;
	
	//УСТАНОВКА КАРТИНОК
	Для Каждого ТекГруппа Из СгруппированныеСтроки Цикл
		МассивИдентификаторовСтрок = ТекГруппа.Значение;
		счетчикСтрок = 0;
		ВсегоСтрок = МассивИдентификаторовСтрок.Количество();
		Для Каждого ИдентификаторСтроки Из МассивИдентификаторовСтрок Цикл
			счетчикСтрок = счетчикСтрок + 1;
			
			ТекСтрока = Объект.Доходы.НайтиПоИдентификатору(ИдентификаторСтроки);
			
			Если счетчикСтрок = 1 Тогда
				ТекСтрока.КартинкаГруппировки1 = БиблиотекаКартинок.КоннекторПравоНиз_Полужирный;
				ТекСтрока.КартинкаГруппировки2 = БиблиотекаКартинок.КоннекторВерхНиз_Полужирный;
				ТекСтрока.КартинкаГруппировки3 = БиблиотекаКартинок.КоннекторВерхНиз_Полужирный;
			ИначеЕсли счетчикСтрок = ВсегоСтрок Тогда
				ТекСтрока.КартинкаГруппировки1 = БиблиотекаКартинок.КоннекторВерхНиз_Полужирный;
				ТекСтрока.КартинкаГруппировки2 = БиблиотекаКартинок.КоннекторВерхНиз_Полужирный;
				ТекСтрока.КартинкаГруппировки3 = БиблиотекаКартинок.КоннекторВерхПраво_Полужирный;
			Иначе
				ТекСтрока.КартинкаГруппировки1 = БиблиотекаКартинок.КоннекторВерхНиз_Полужирный;
				ТекСтрока.КартинкаГруппировки2 = БиблиотекаКартинок.КоннекторВерхПравоНиз_Полужирный;
				ТекСтрока.КартинкаГруппировки3 = БиблиотекаКартинок.КоннекторВерхНиз_Полужирный;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры
//Евросиб(ДИТ), Беляев СЮ, US 88163/TA 88167, 26-07-2024, конец

//Евросиб(ДИТ), Беляев СЮ, US 88163/TA 88167, 26-07-2024, начало
&НаКлиенте
Процедура РазъединитьCтрокиДляВыставления(Команда)
	Для каждого Стр из Элементы.Доходы.ВыделенныеСтроки Цикл
		ТекСтрока = Объект.Доходы.НайтиПоИдентификатору(Стр);
		Если ТекСтрока.ИдентификаторГруппировки = 0 Тогда
			Продолжить;
		КонецЕсли;
		ТекСтрока.ИдентификаторГруппировки = 0;
		ТекСтрока.КартинкаГруппировки1 = Неопределено;
		ТекСтрока.КартинкаГруппировки2 = Неопределено;
		ТекСтрока.КартинкаГруппировки3 = Неопределено;
		//Евросиб(ДИТ), Беляев СЮ, US 89710/TA 89712, 27-08-2024, начало
		Модифицированность = Истина;
		//Евросиб(ДИТ), Беляев СЮ, US 89710/TA 89712, 27-08-2024, конец
	КонецЦикла;
	
	УстановитьКартинкиОбъединеннымСтрокамДоходов();
КонецПроцедуры
//Евросиб(ДИТ), Беляев СЮ, US 88163/TA 88167, 26-07-2024, конец      

//Евросиб Коханенко Н.А. 27.08.2024 (( #89951 
&НаСервере
Процедура УстановитьДоступностьПоляЖДНВСтрокахСТипомМоре()
