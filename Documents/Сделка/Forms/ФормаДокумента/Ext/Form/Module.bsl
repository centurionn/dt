&НаСервере
Процедура ОбновитьВладельцевВагонов()
	
	СписокВагонов = Новый Массив;
	СписокНомеровНакладных = Новый Массив;
	СписокЖДНдляТД = Новый Массив;
	
	Для каждого Стр из Объект.СвязьУчетныхЕдиниц Цикл
		Если ЗначениеЗаполнено(Стр.Вагон) Тогда 
			СписокВагонов.Добавить(Стр.Вагон); 
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.НомерЖДН) И СписокНомеровНакладных.Найти(Стр.НомерЖДН) = неопределено Тогда 
			СписокНомеровНакладных.Добавить(Стр.НомерЖДН);
			СписокЖДНдляТД.Добавить(Стр.ЖДН);
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.НомерВагоннойЖДН) И СписокНомеровНакладных.Найти(Стр.НомерВагоннойЖДН) = неопределено Тогда 
			СписокНомеровНакладных.Добавить(Стр.НомерВагоннойЖДН); 
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.НомерПорожнейЖДНКТК) И СписокНомеровНакладных.Найти(Стр.НомерПорожнейЖДНКТК) = неопределено Тогда 
			СписокНомеровНакладных.Добавить(Стр.НомерПорожнейЖДНКТК); 
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.НомерПорожнейВагоннойЖДН) И СписокНомеровНакладных.Найти(Стр.НомерПорожнейВагоннойЖДН) = неопределено Тогда 
			СписокНомеровНакладных.Добавить(Стр.НомерПорожнейВагоннойЖДН); 
		КонецЕсли;
	КонецЦикла;

	Результат = ПолучитьВладельцевУказанныхВагонов(СписокВагонов);
	РезультатТД = РаботаСоСделкамиСервер.ПолучитьНомераТДдляНакладных(СписокЖДНдляТД);
	
	Для каждого Стр из Объект.СвязьУчетныхЕдиниц Цикл
		Стр.ВладелецВагона = неопределено;
		Стр.АрендаторВагона = неопределено;
		Соотв = Результат[Стр.Вагон];
		Если Соотв <> неопределено Тогда
			ЗаполнитьЗначенияСвойств(Стр, Соотв);
		КонецЕсли;
		Соотв2 = РезультатТД.Получить(Стр.ЖДН);
		Если Соотв2 <> неопределено Тогда
			Стр.ТранспортныйДокумент = Соотв2;
		КонецЕсли;
	КонецЦикла;
	
	БуферЗапросовПоЖДН = Новый Соответствие;
	
	//получим массив всех накладных и по ним разово запросим локации
	СписокНакладных = Новый Массив;
	ТЗСоставПоезда = Объект.СвязьУчетныхЕдиниц.Выгрузить(, "ВагоннаяЖДН, ЖДН, ПорожняяЖДНКТК, ПорожняяВагоннаяЖДН");
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СписокНакладных, ТЗСоставПоезда.ВыгрузитьКолонку("ВагоннаяЖДН"), Истина);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СписокНакладных, ТЗСоставПоезда.ВыгрузитьКолонку("ЖДН"), Истина);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СписокНакладных, ТЗСоставПоезда.ВыгрузитьКолонку("ПорожняяЖДНКТК"), Истина);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СписокНакладных, ТЗСоставПоезда.ВыгрузитьКолонку("ПорожняяВагоннаяЖДН"), Истина);
	ТЗЛокацииНакладных = ПолучитьЛокацииПодсыльныхНакладныхПоСпискуНакладных(СписокНакладных);
	Если ТЗЛокацииНакладных <> Неопределено И ТЗЛокацииНакладных.Количество() > 1000 Тогда // ДИТ Поморцева, была ошиба при октрытии документа при тестировании задачи 32343 
		ТЗЛокацииНакладных.Индексы.Добавить("ЖДН");
	КонецЕсли;
	Для каждого Стр из Объект.СвязьУчетныхЕдиниц Цикл
		
		Если ЗначениеЗаполнено(Стр.ВагоннаяЖДН) Тогда
			
			ИскНомерНакладной = Стр.ВагоннаяЖДН;
			РезП = БуферЗапросовПоЖДН.Получить(ИскНомерНакладной);
			Если РезП = неопределено Тогда
				РезП = ТЗЛокацииНакладных.Найти(ИскНомерНакладной, "ЖДН"); 
				БуферЗапросовПоЖДН.Вставить(ИскНомерНакладной, РезП);
			КонецЕсли;
			Если РезП <> неопределено Тогда
				Стр.ПодсылВагона_СтОтправления = РезП.ПунктОтправления; 
				Стр.ПодсылВагона_СтПрибытия = РезП.ПунктНазначения; 
			КонецЕсли;

		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.ЖДН) Тогда 
			
			ИскНомерНакладной = Стр.ЖДН;
			РезП = БуферЗапросовПоЖДН.Получить(ИскНомерНакладной);
			Если РезП = неопределено Тогда
				РезП = ТЗЛокацииНакладных.Найти(ИскНомерНакладной, "ЖДН"); 
				БуферЗапросовПоЖДН.Вставить(ИскНомерНакладной, РезП);
			КонецЕсли;
			Если РезП <> неопределено Тогда
				Стр.ДействующийСтатус = РезП.ДействующийСтатус;
			КонецЕсли;

		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.ПорожняяЖДНКТК) Тогда 
			
			ИскНомерНакладной = Стр.ПорожняяЖДНКТК;
			РезП = БуферЗапросовПоЖДН.Получить(ИскНомерНакладной);
			Если РезП = неопределено Тогда
				РезП = ТЗЛокацииНакладных.Найти(ИскНомерНакладной, "ЖДН"); 
				БуферЗапросовПоЖДН.Вставить(ИскНомерНакладной, РезП);
			КонецЕсли;
			Если РезП <> Неопределено Тогда
				Стр.ПодсылКТК_СтОтправления = РезП.ПунктОтправления; 
				Стр.ПодсылКТК_СтПрибытие = РезП.ПунктНазначения; 
			КонецЕсли;

		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.ПорожняяВагоннаяЖДН) Тогда 
			
			ИскНомерНакладной = Стр.ПорожняяВагоннаяЖДН;
			РезП = БуферЗапросовПоЖДН.Получить(ИскНомерНакладной);
			Если РезП = неопределено Тогда
				РезП = ТЗЛокацииНакладных.Найти(ИскНомерНакладной, "ЖДН"); 
				БуферЗапросовПоЖДН.Вставить(ИскНомерНакладной, РезП);
			КонецЕсли;
			Если РезП <> неопределено Тогда
				Стр.ПодсылВагонаПодКТК_СтОтправления = РезП.ПунктОтправления; 
				Стр.ПодсылВагонаПодКТК_СтПрибытие = РезП.ПунктНазначения; 
			КонецЕсли;

		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВладельцевУказанныхВагонов(СписокВагонов)
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПаспортаВагоновСрезПоследних.Вагон КАК Вагон,
	               |	ПаспортаВагоновСрезПоследних.Собственник КАК Собственник,
	               |	ПаспортаВагоновСрезПоследних.Арендатор КАК Арендатор
	               |ИЗ
	               |	РегистрСведений.ПаспортаВагонов.СрезПоследних КАК ПаспортаВагоновСрезПоследних
	               |ГДЕ
	               |	ПаспортаВагоновСрезПоследних.Вагон В(&Вагоны)";
	Запрос.УстановитьПараметр("Вагоны", СписокВагонов);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		Результат.Вставить(Ответ.Вагон, Новый Структура("ВладелецВагона, АрендаторВагона", Ответ.Собственник, Ответ.Арендатор));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЛокацииПодсыльныхНакладных(СписокНомеровНакладных)
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	э_Накладная.Ссылка КАК Накладная,
	               |	э_Накладная.СтанцияОтправленияКод КАК ПунктОтправленияКод,
	               |	э_Накладная.СтанцияНазначенияКод КАК ПунктНазначенияКод,
	               |	ЛокацииОтпр.Ссылка КАК СтанцияОтправления,
	               |	ЛокацииНазн.Ссылка КАК СтанцияНазначения,
	               |	э_Накладная.НакладнаяНомер КАК НакладнаяНомер,
	               |	э_Накладная.ТекущееСостояниеНакладнойДействующийСтатус КАК ДействующийСтатус
	               |ИЗ
	               |	Документ.э_Накладная КАК э_Накладная
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Локации КАК ЛокацииОтпр
	               |		ПО (э_Накладная.СтанцияОтправленияКод ПОДОБНО ЛокацииОтпр.КодЖДСтанции)
	               |			И (НЕ ЛокацииОтпр.ПометкаУдаления)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Локации КАК ЛокацииНазн
	               |		ПО (э_Накладная.СтанцияНазначенияКод ПОДОБНО ЛокацииНазн.КодЖДСтанции)
	               |			И (НЕ ЛокацииНазн.ПометкаУдаления)
	               |ГДЕ
	               |	э_Накладная.НакладнаяНомер В(&НакладнаяНомер)
	               |	И э_Накладная.ТекущееСостояниеНакладнойДействующийСтатус";
	Запрос.УстановитьПараметр("НакладнаяНомер", СписокНомеровНакладных);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		Результат.Вставить(Ответ.НакладнаяНомер, Новый Структура("ПунктОтправления, ПунктНазначения, ДействующийСтатус", Ответ.СтанцияОтправления, Ответ.СтанцияНазначения, Ответ.ДействующийСтатус));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЛокацииПодсыльныхНакладныхПоСсылке(СсылкаЖДН, НомерЖДН)
	
	Результат = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ЛокацииОтпр.Ссылка КАК СтанцияОтправления,
	               |	ЛокацииНазн.Ссылка КАК СтанцияНазначения,
	               |	э_Накладная.ТекущееСостояниеНакладнойДействующийСтатус КАК ДействующийСтатус
	               |ИЗ
	               |	Документ.э_Накладная КАК э_Накладная
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Локации КАК ЛокацииОтпр
	               |		ПО (э_Накладная.СтанцияОтправленияКод ПОДОБНО ЛокацииОтпр.КодЖДСтанции)
	               |			И (НЕ ЛокацииОтпр.ПометкаУдаления)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Локации КАК ЛокацииНазн
	               |		ПО (э_Накладная.СтанцияНазначенияКод ПОДОБНО ЛокацииНазн.КодЖДСтанции)
	               |			И (НЕ ЛокацииНазн.ПометкаУдаления)
	               |ГДЕ
				   |	э_Накладная.Ссылка В (&СсылкаЖДН)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	э_Накладная.Дата УБЫВ";
	Если СсылкаЖДН = Неопределено Тогда
		Запрос.УстановитьПараметр("НомерЖДН", НомерЖДН);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "э_Накладная.Ссылка = &СсылкаЖДН", "э_Накладная.НакладнаяНомер = &НомерЖДН И э_Накладная.ТекущееСостояниеНакладнойДействующийСтатус"); 
	Иначе
		Запрос.УстановитьПараметр("СсылкаЖДН", СсылкаЖДН.НакладнаяЭТРАН);
	КонецЕсли;
		
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Новый Структура("ПунктОтправления, ПунктНазначения, ДействующийСтатус", Ответ.СтанцияОтправления, Ответ.СтанцияНазначения, Ответ.ДействующийСтатус);
	Иначе 
		Возврат Новый Структура("ПунктОтправления, ПунктНазначения, ДействующийСтатус");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЛокацииПодсыльныхНакладныхПоСпискуНакладных(СсылкиЖДН)
	
	Результат = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТранспортныйДокумент.Ссылка КАК ЖДН,
	               |	ТранспортныйДокумент.НакладнаяЭТРАН КАК НакладнаяЭТРАН
	               |ПОМЕСТИТЬ ВТ_ЖДН
	               |ИЗ
	               |	Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	               |ГДЕ
	               |	ТранспортныйДокумент.Ссылка В(&СсылкаЖДН) 
				   |    И НЕ ТранспортныйДокумент.Ссылка = Значение(Документ.ТранспортныйДокумент.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЕСТЬNULL(ЛокацииОтпр.СпрДатакор, Значение(Справочник.Локации.ПустаяСсылка)) КАК ПунктОтправления,
	               |	ЕСТЬNULL(ЛокацииНазн.СпрДатакор, Значение(Справочник.Локации.ПустаяСсылка)) КАК ПунктНазначения,
	               |	ВТ_ЖДН.ЖДН КАК ЖДН,
	               |	ВТ_ЖДН.НакладнаяЭТРАН.ТекущееСостояниеНакладной.ДействующийСтатус КАК ДействующийСтатус
	               |ИЗ
	               |	ВТ_ЖДН КАК ВТ_ЖДН 
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Связь_ЭТРАН_DC_Сопоставление КАК ЛокацииОтпр
				   |		ПО (ВТ_ЖДН.НакладнаяЭТРАН.СтанцияОтправления = ЛокацииОтпр.СпрЭтрана)
				   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Связь_ЭТРАН_DC_Сопоставление КАК ЛокацииНазн
				   |		ПО (ВТ_ЖДН.НакладнаяЭТРАН.СтанцияНазначения = ЛокацииНазн.СпрЭтрана)";
	
	
	Запрос.УстановитьПараметр("СсылкаЖДН", СсылкиЖДН);
	Результат = Неопределено;
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Результат = РезультатЗапроса.Выгрузить();
	КонецЕсли;
	Возврат Результат;	                                             
	
КонецФункции

// +++ БЛОК НОВОЙ МАРШРУТИЗАЦИИ

&НаКлиенте
Функция ПроверитьУказатьОтветственных(РезультатЗапроса, СобытиеПередЗаписью)
	
	ДопСвойстваОбъекта.Очистить();
	ЧтоНужноУказатьВручную = Новый Массив;
	Для каждого Стр из  РезультатЗапроса Цикл
		Исполнитель = Стр.Исполнитель;
		Если НЕ Стр.ТребуетсяУказатьИсполнителя И НЕ ЗначениеЗаполнено(Исполнитель) Тогда Исполнитель = Объект.Автор; КонецЕсли;
		Наблюдатель = Стр.Наблюдатель;
		Если НЕ Стр.ТребуетсяУказатьНаблюдателя И НЕ ЗначениеЗаполнено(Наблюдатель) Тогда Наблюдатель = Объект.Автор; КонецЕсли;
		
		Если Стр.ТребуетсяУказатьИсполнителя ИЛИ Стр.ТребуетсяУказатьНаблюдателя Тогда 
			ЧтоНужноУказатьВручную.Добавить(Новый Структура("Состояние, Исполнитель, Наблюдатель", Стр.Состояние, Исполнитель, Наблюдатель)); 
		КонецЕсли;
	КонецЦикла;
	Если ЧтоНужноУказатьВручную.Количество() > 0 Тогда
		ОпОп = Новый ОписаниеОповещения("ОбработкаУказанияОтветственных", ЭтаФорма, Новый Структура("РезультатЗапроса, СобытиеПередЗаписью", РезультатЗапроса, СобытиеПередЗаписью));
		ПараметрыОтбора = Новый СТруктура;
		ПараметрыОтбора.Вставить("ВыбраннаяМаршрутизация", ЧтоНужноУказатьВручную);
		ОткрытьФорму("Справочник.Маршрутизация.Форма.ФормаЗаполненияСостояний",ПараметрыОтбора,, ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		Если НЕ СобытиеПередЗаписью Тогда ПовторнаяМаршрутизация_сервер(РезультатЗапроса); КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаУказанияОтветственных(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = неопределено Тогда Возврат; КонецЕсли;
	ДопСвойстваОбъекта.ЗагрузитьЗначения(П1);
	Если П2.СобытиеПередЗаписью Тогда
		Записать();
	Иначе
		ПовторнаяМаршрутизация_сервер(П2.РезультатЗапроса);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПовторнаяМаршрутизация_сервер(РезультатЗапроса)
	
	ЭтотОбъектЪ = РеквизитФормыВЗначение("Объект");
	МаршрутизацияСервер.ПрименитьМаршрут(ЭтотОбъектЪ, РезультатЗапроса, Объект.Автор, ДопСвойстваОбъекта);
	ЗначениеВРеквизитФормы(ЭтотОбъектЪ, "Объект");
	
КонецПроцедуры

