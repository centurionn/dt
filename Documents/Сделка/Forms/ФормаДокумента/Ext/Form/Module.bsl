	массивИсточниковПоявленияСтрокиЭкономики.Добавить(Перечисления.ИсточникПоявленияСтрокиЭкономики.ПеремещениеКТК);
	//Запрос.УстановитьПараметр("Расходы", Объект.Расходы.Выгрузить(,"ИсточникПоявленияСтрокиЭкономики_Старая, ИсточникПоявленияСтрокиЭкономики, СтрокаСвязьУчетныхЕдиниц"));
	//ДИТ, Беляев СЮ, Ticket#0282283, 29-08-2022, начало	
	Запрос.УстановитьПараметр("Расходы", Объект.Расходы.Выгрузить(,"ИсточникПоявленияСтрокиЭкономики_Старая, ИсточникПоявленияСтрокиЭкономики, СтрокаСвязьУчетныхЕдиниц, УслугаОтключена"));
	//ДИТ, Беляев СЮ, Ticket#0282283, 29-08-2022, конец
	Запрос.УстановитьПараметр("ИсточникиПоявленияСтрокиЭкономики", массивИсточниковПоявленияСтрокиЭкономики);
	//РезультатЗапроса = Запрос.Выполнить();
	//ДИТ, Беляев СЮ, ТА54910, 19-07-2022, начало    
