&НаКлиенте
Процедура ОбработкаВыбораДопУслуг (П1 = неопределено, П2 = неопределено) Экспорт
	
	Если ТипЗнч(П1) <> Тип("Массив") Тогда Возврат; КонецЕсли;
	
	Для каждого Стр из П1 Цикл
		
		СписокВагонов = Новый Массив;
		СписокКТК = Новый Массив;
		СписокТД = Новый Массив;
		СтрокиДоходовПоКлиенту = Объект.СвязьУчетныхЕдиниц.НайтиСтроки(Новый Структура("Клиент", Стр.Контрагент));
		Для каждого Стр8 из СтрокиДоходовПоКлиенту Цикл
			
			Если ЗначениеЗаполнено(Стр8.Контейнер) И СписокКТК.Найти(Стр8.Контейнер) = неопределено Тогда СписокКТК.Добавить(Стр8.Контейнер); КонецЕсли;
			Если ЗначениеЗаполнено(Стр8.Вагон) И СписокВагонов.Найти(Стр8.Вагон) = неопределено Тогда СписокВагонов.Добавить(Стр8.Вагон); КонецЕсли;
			Если ЗначениеЗаполнено(Стр8.НомерЖДН) И СписокТД.Найти(Стр8.НомерЖДН) = неопределено Тогда СписокТД.Добавить(Стр8.НомерЖДН); КонецЕсли;
			
		КонецЦикла;
		
		СтрДоходы = Объект.Доходы.Добавить(); 
		//ДИТ, Беляев СЮ, ТА48688, 28-03-2022, начало 
		СтрДоходы.ДатаПоявленияСтрокиЭкономики = ТекущаяДата();
		//ДИТ, Беляев СЮ, ТА48688, 28-03-2022, конец
		СтрДоходы.Клиент = Стр.Контрагент;
		СтрДоходы.Договор = Стр.Договор;
		СтрДоходы.Услуга = Стр.Услуга;
		СтрДоходы.Калькуляция = Стр.Калькуляция;
		СтрДоходы.ПСЦ = Стр.ПСЦ;
		СтрДоходы.Себестоимость = Стр.Себестоимость;
		СтрДоходы.Вознаграждение = Стр.Вознаграждение;
		СтрДоходы.Ставка = Стр.Ставка;
		СтрДоходы.Количество = СтрокиДоходовПоКлиенту.Количество();
		СтрДоходы.СтавкаНДС = Стр.СтавкаНДС;
		СтрДоходы.НДСВключенВСтоимость = Стр.НДСВключенВСтоимость;
		СтрДоходы.ГУИД = Строка(Новый УникальныйИдентификатор());
		СтрДоходы.Валюта = Стр.Валюта;
		СтрДоходы.Перевыставляемая = Истина;
		СтрДоходы.СписокВагонов = СтрСоединить(СписокВагонов, ";");
		СтрДоходы.СписокКТК = СтрСоединить(СписокКТК, ";");
		СтрДоходы.СписокТД = СтрСоединить(СписокТД, ";");
		ДоходыПриИзменении(неопределено, СтрДоходы);
		
		СтрРасходы = Объект.Расходы.Добавить();
		СтрРасходы.Услуга = Стр.Услуга;
		СтрРасходы.Калькуляция = Стр.Калькуляция;
		СтрРасходы.Себестоимость = Стр.Себестоимость;		
		СтрРасходы.Количество = Объект.СвязьУчетныхЕдиниц.НайтиСтроки(Новый Структура("Клиент", СтрДоходы.Клиент)).Количество();
		СтрРасходы.СтавкаНДС = Стр.СтавкаНДС;
		СтрРасходы.НДСВключенВСтоимость = Стр.НДСВключенВСтоимость;
		СтрРасходы.Валюта = Стр.Валюта;
		СтрРасходы.Перевыставляемая = Истина;
		СтрРасходы.ГУИД = Строка(Новый УникальныйИдентификатор());
		СтрРасходы.СписокВагонов = СтрСоединить(СписокВагонов, ";");
		СтрРасходы.СписокКТК = СтрСоединить(СписокКТК, ";");
		СтрРасходы.СписокТД = СтрСоединить(СписокТД, ";");
		РасходыПриИзменении(неопределено, СтрРасходы);
		
		СтрСвязь = Объект.СвязьДоходовИРасходов.Добавить();
		СтрСвязь.Доходы = СтрДоходы.ГУИД;
		СтрСвязь.Расходы = СтрРасходы.ГУИД;
		
		
	КонецЦикла;
	
	доходы_ПересчитатьПериоды(неопределено, Истина);
	
	
КонецПроцедуры

