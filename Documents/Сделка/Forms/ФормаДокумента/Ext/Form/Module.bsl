	КонецЕсли;
	Если ЗначениеЗаполнено(ТекД.ЖДН) Тогда
		ДанныеНакладной = ПолучитьДанныеНакладной(ТекД.ЖДН, текД.Контейнер);
		ЗаполнитьЗначенияСвойств(ТекД, ДанныеНакладной);
	Иначе
		ТекД.НомерЖДН = Неопределено;
		ТекД.Вагон = Неопределено;
	КонецЕсли;
	
