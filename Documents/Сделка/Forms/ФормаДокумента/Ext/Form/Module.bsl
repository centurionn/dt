			КонецЕсли;
			
			Если Стр.СформированыЗакрывающиеДокументы Тогда
				ТекстСообщения = "По КТК сформирована РТУ. Сначала требуется отменить РТУ. Обратитесь к специалисту бэк-офиса.";
				ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(ОшибкиЗаполнения, "Объект." + ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СвязьУчетныхЕдиниц", Стр.НомерСтроки, "ГотовоКВыставлению") ,ТекстСообщения);		
				Продолжить;
			КонецЕсли;
			
			Если Стр.ДокументыВыставлены Тогда
				ТекстСообщения = "Изменение признака ""готово к выставлению"" у выставленных документов запрещено";
				ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(ОшибкиЗаполнения, "Объект." + ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СвязьУчетныхЕдиниц", Стр.НомерСтроки, "ГотовоКВыставлению") ,ТекстСообщения);
				Продолжить;
			КонецЕсли;
			
			Если НЕ Стр.ВидСтавки = ПредопределенноеЗначение("Перечисление.ФрахтФинДокументы_ВидСтавки.ОтдельныеСтавки") Тогда
				Для каждого СтрокаСвязьУчетныхЕдиниц Из Объект.СвязьУчетныхЕдиниц Цикл
					Если СтрокаСвязьУчетныхЕдиниц.ГУИДСтрокиЗаявки = Стр.ГУИДСтрокиЗаявки И СтрокаСвязьУчетныхЕдиниц.ГотовоКВыставлению = Истина Тогда
						Если СтрокаСвязьУчетныхЕдиниц.ДокументыВыставлены Тогда
							ТекстСообщения = "Изменение признака «готово к выставлению» у выставленных документов запрещено";
							ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(ОшибкиЗаполнения, "Объект." + ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СвязьУчетныхЕдиниц", СтрокаСвязьУчетныхЕдиниц.НомерСтроки, "ГотовоКВыставлению" ,ТекстСообщения));
							Продолжить;
						Иначе				
							СтрокаСвязьУчетныхЕдиниц.ГотовоКВыставлению = Ложь;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
            Стр.ГотовоКВыставлению = Ложь;
			Если Стр.ВидТранспортногоСообщения = ПредопределенноеЗначение("Перечисление.ВидыТранспортныхСообщений.Море") Тогда
				ВидТСМоре = Истина;	
			КонецЕсли
		КонецЦикла
	КонецЦикла;
	
	Если ОшибкиЗаполнения <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(ОшибкиЗаполнения);	
	КонецЕсли;
	
	ТекстОповещения = "";
	
	//Ошибки = ПроверитьПометитьСтрокиКВыставлению(Новый Структура("Удалена, НеАктивна", Ложь, Ложь), ТекстОповещения);
	//
	//Если Ошибки <> Неопределено Тогда
	//	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки);	
	//КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстОповещения) Тогда
		ТекстОповещения = "Внимание! в строках ЖД перевозки отсутствуют/не заполнены параметры: "
						+ Символы.ПС
						+ ТекстОповещения;
		ПоказатьПредупреждение(, ТекстОповещения, 30);
	КонецЕсли;

	Если ВидТСМоре Тогда
		СвязьУчетныхЕдиницГотовоКВыставлениюФрахтПриИзменении(Неопределено);
	КонецЕсли;
КонецПроцедуры 
