&НаСервере
Функция ПолучитьСписокКолонокДоходов()
	РезультатФункции = "";
	МассивКолонокИсключения = Новый Массив;
	МассивКолонокИсключения.Добавить("КартинкаГруппировки1");
	МассивКолонокИсключения.Добавить("КартинкаГруппировки2");
	МассивКолонокИсключения.Добавить("КартинкаГруппировки3");
	СтруктураКолонок = Объект.Доходы.Выгрузить(Новый Массив);
	Для Каждого ТекКолонка Из СтруктураКолонок.Колонки Цикл
		Если МассивКолонокИсключения.Найти(ТекКолонка.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		РезультатФункции = РезультатФункции + ТекКолонка.Имя + ",";
	КонецЦикла;
	Если Прав(РезультатФункции,1) = "," Тогда
		РезультатФункции = Лев(РезультатФункции, СтрДлина(РезультатФункции) - 1);
	КонецЕсли;
	Возврат РезультатФункции;
КонецФункции
