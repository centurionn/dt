&НаКлиенте
Процедура ОтвязатьАкцепты(Команда)	
	
	Если Не ЕстьПравоНаОтвязкуАкцептов() Тогда
		ПоказатьПредупреждение(, "У вас нет прав на групповую отвязку акцептов. Отвязка не выполнена.");
		Возврат;
	КонецЕсли;	
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбОтвязкиАкцептов", ЭтотОбъект, Параметры);
	ПоказатьВопрос(Оповещение, "Выполнить отвязку акцептов от данной сделки? Сделка при успешной отвязке будет помечена на удаление.", Режим, 0);	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьПравоНаОтвязкуАкцептов()
	Возврат Пользователи.РолиДоступны("dc_ГрупповаяОтвязкаАкцептов",, Ложь);
КонецФункции	

&НаКлиенте
Процедура ПослеЗакрытияВопросаОбОтвязкиАкцептов(Результат, Параметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;
    ВыполнитьОтвязкуАкцептов();
КонецПроцедуры

&НаСервере
Процедура ВыполнитьОтвязкуАкцептов()
	ЕстьОшибки = Ложь;
	// Евросиб Фролов (28.04.2022 Task №49949
	//Обработки.РоспускСделки.ОтменитьАкцептыНаСервере(Объект.Ссылка, ЕстьОшибки);
	МассивСтрокСделкиДляИзменения = Новый Массив;
	Обработки.РоспускСделки.ОтменитьАкцептыНаСервере(Объект.Ссылка, ЕстьОшибки, МассивСтрокСделкиДляИзменения);
	// Евросиб Фролов)
	
	Если ЕстьОшибки = Ложь Тогда
		// Евросиб Фролов (28.04.2022 Task №49949
		СтрокиРасходов = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивСтрокСделкиДляИзменения);
		ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
		Обработки.РоспускСделки.ОбновитьСделку(ОбъектНаСервере, СтрокиРасходов);
		ЗначениеВРеквизитФормы(ОбъектНаСервере, "Объект");
		// Евросиб Фролов)
		Попытка
			Объект.ПометкаУдаления = Истина;
			ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
			ОбщегоНазначения.СообщитьПользователю("Отвязка акцептов от сделки выполнена успешно. Сделка помечена на удаление.");			
		Исключение
			ОбщегоНазначения.СообщитьПользователю("Не удалось отвязать акцепты от сделки. " + ОписаниеОшибки());
		КонецПопытки;		
	Иначе
		ОбщегоНазначения.СообщитьПользователю("Не удалось отвязать акцепты от сделки.");
	КонецЕсли;
	
КонецПроцедуры	
