Функция ПолучитьКалькуляцииБезПризнакаПодсылПорожних(Калькуляции)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КалькуляцииСделки.Ссылка КАК Калькуляция,
	|	КалькуляцииСделки.Представление КАК КалькуляцияПредставление
	|ИЗ
	|	Документ.Калькуляция КАК КалькуляцииСделки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Калькуляция.ММ_КалькуляцияМультимодальнойЦепочки КАК КалькуляцияММ_КалькуляцияМультимодальнойЦепочки
	|		ПО КалькуляцииСделки.Ссылка = КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка
	|			И (КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.ПодсылПорожних)
	|ГДЕ
	|	КалькуляцииСделки.Ссылка В(&Калькуляции)
	|	И КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Калькуляции", Калькуляции);
	
	ТаблицаДокументов = Запрос.Выполнить().Выгрузить();
	
	СписокДокументов = ТаблицаДокументов.ВыгрузитьКолонку("КалькуляцияПредставление");
	
	Возврат СписокДокументов;
	
КонецФункции

