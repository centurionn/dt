&НаКлиенте
Процедура корр_СоздатьДокументКорректировки(Команда)
	
	//ДИТ Давудов М.А. Task32744 03.07.2021 Начало
	Если Модифицированность Тогда
		Сообщить("Требуется запись документа!");
		Возврат;
	КонецЕсли;
	//ДИТ Давудов М.А. Task32744 03.07.2021 Конец
	
	//++ Зубов 0238574 29.07.2021
	ТекД = ЭтаФорма.Элементы.Доходы.ТекущиеДанные;
	
	Если НЕ ЗначениеЗаполнено(ТекД.ГУИДИсправляемойСтроки) Тогда
		Сообщить("Ввод документа корректировки или исправления для данной строки невозможен!");
	Иначе
		
		//Евросиб(ДИТ), Беляев СЮ, US 113662 / TA 115172, 01-08-2025, начало
		Если НЕ КонтрольПериодаВОдляВыставленияКорректировок(ТекД) Тогда
			Возврат;
		КонецЕсли;
		//Евросиб(ДИТ), Беляев СЮ, US 113662 / TA 115172, 01-08-2025, конец
		
		//ДИТ Давудов М.А. Task32744 03.07.2021 Начало
		СтранаРегистрации = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(ТекД.Клиент, "СтранаРегистрации");
		ЗадатьВопросПоФормированиюCreditNote = Ложь;
		Если ТекД.Перевыставляемая = Ложь
		   И ТекД.НеВыставлятьКлиенту = Ложь
		   И СтранаРегистрации <> ПредопределенноеЗначение("Справочник.СтраныМира.Россия") Тогда
		   
		   СтруктураОтбора = Новый Структура;
		   СтруктураОтбора.Вставить("ГУИД", ТекД.ГУИДИсправляемойСтроки);
		   НайденныеСтроки = Объект.Доходы.НайтиСтроки(СтруктураОтбора);
		   
		   Если НайденныеСтроки.Количество() > 0 
			  И НайденныеСтроки[0].СуммаИтого > ТекД.СуммаИтого Тогда
			   ЗадатьВопросПоФормированиюCreditNote = Истина;
		   КонецЕсли;
		КонецЕсли;
		
		Если ЗадатьВопросПоФормированиюCreditNote Тогда
			Оповещение = Новый ОписаниеОповещения("ВопросОСозданииCreditNoteЗавершение", ЭтотОбъект);
			ТекстВопроса = "Корректировка реализации уменьшает сумму. Сформировать счета с признаком Credit Note";
			ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет); 
		Иначе
			//ок(
			//Евросиб Шевченко А.В. US 112687 TA 123181 25.11.2025
			Оповещение = Новый ОписаниеОповещения("ВопросОСозданииКорректировки", ЭтотОбъект, Ложь);
			ТекстВопроса = "Будет создан документ Корректировки реализации в сторону увеличения. Создать дополнительный новый счет покупателю на сумму разницы ?";
			ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
			//КорректировкиРТУКлиент.корр_СоздатьДокументКорректировки(ЭтаФорма);
			//Евросиб Шевченко А.В. US 112687 TA 123181 25.11.2025
			//ок)
		КонецЕсли;
		//ДИТ Давудов М.А. Task32744 03.07.2021 Конец
	КонецЕсли;
	//-- Зубов 0238574 29.07.2021
	
	//ДИТ Давудов М.А. Task32744 03.07.2021 Начало
	Модифицированность = Истина;
	//ДИТ Давудов М.А. Task32744 03.07.2021 Конец
	
КонецПроцедуры

