&НаСервере
Процедура ПеренестиРасходыВДругуюСделку(ТекущаяСделка, НоваяСделка, НоваяЗаявка, ТаблицаИсключаемыхКонтейнеров)
	
	// В новой сделке заполним расходы.
	РаботаСоСделкамиСервер.ЗаполнитьРасходы(НоваяСделка);
	
	МассивПереносимыхКТК = ТаблицаИсключаемыхКонтейнеров.ВыгрузитьКолонку("Контейнер");
	//Для Каждого ТекущийКТК Из СоответствиеКТКНовымГУИД Цикл
	//	МассивПереносимыхКТК.Добавить(ТекущийКТК.Ключ);
	//КонецЦикла;
	
	ТаблицаРасходовТекущейСделки = ТекущаяСделка.Расходы.Выгрузить();
	
	//СвязьУчетныхЕдиницТекущейСделки = ТекущаяСделка.СвязьУчетныхЕдиниц.Выгрузить(, "Контейнер, ГУИД, ГУИДСтрокиЗаявки, ВидТранспортногоСообщения");
	СвязьУчетныхЕдиницТекущейСделки = ТаблицаИсключаемыхКонтейнеров.Скопировать(, "Контейнер, ГУИД, ГУИДСтрокиЗаявки, ВидТранспортногоСообщения");
	СвязьУчетныхЕдиницНовойСделки = НоваяСделка.СвязьУчетныхЕдиниц.Выгрузить(Новый Структура("Заявка", НоваяЗаявка), "Контейнер, ГУИД, ГУИДСтрокиЗаявки, ВидТранспортногоСообщения");
	// Добавим к таблице КТК колонку с новыми ГУИД контейнеров (в новой сделке)
	//СвязьУчетныхЕдиницТекущейСделки.Колонки.Добавить("НовыйГУИД", ОбщегоНазначения.ОписаниеТипаСтрока(36));
	//Для Каждого ТекущаяСтрокаСУЕ Из СвязьУчетныхЕдиницТекущейСделки Цикл
	//	ТекущаяСтрокаСУЕ.НовыйГУИД = СоответствиеКТКНовымГУИД.Получить(ТекущаяСтрокаСУЕ.Контейнер)
	//КонецЦикла;	
	
	// Получаем расходы по КТК, которые были исключены.
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СвязьУчетныхЕдиниц.Контейнер КАК Контейнер,
	|	СвязьУчетныхЕдиниц.ГУИД КАК ГУИД,
	|	СвязьУчетныхЕдиниц.ГУИДСтрокиЗаявки КАК ГУИДСтрокиЗаявки,
	|	СвязьУчетныхЕдиниц.ВидТранспортногоСообщения КАК ВидТранспортногоСообщения
	|ПОМЕСТИТЬ втСУЕ_Текущая
	|ИЗ
	|	&СвязьУчетныхЕдиницТекущая КАК СвязьУчетныхЕдиниц
	|ГДЕ
	|	СвязьУчетныхЕдиниц.Контейнер В(&МассивКТК)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СвязьУчетныхЕдиниц.Контейнер КАК Контейнер,
	|	СвязьУчетныхЕдиниц.ГУИД КАК ГУИД,
	|	СвязьУчетныхЕдиниц.ГУИДСтрокиЗаявки КАК ГУИДСтрокиЗаявки,
	|	СвязьУчетныхЕдиниц.ВидТранспортногоСообщения КАК ВидТранспортногоСообщения
	|ПОМЕСТИТЬ втСУЕ_Новая
	|ИЗ
	|	&СвязьУчетныхЕдиницНовая КАК СвязьУчетныхЕдиниц
	|ГДЕ
	|	СвязьУчетныхЕдиниц.Контейнер В(&МассивКТК)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втСУЕ_Новая.Контейнер КАК Контейнер,
	|	втСУЕ_Новая.ГУИД КАК ГУИД_нов,
	|	втСУЕ_Новая.ГУИДСтрокиЗаявки КАК ГУИДСтрокиЗаявки,
	|	втСУЕ_Новая.ВидТранспортногоСообщения КАК ВидТранспортногоСообщения,
	|	втСУЕ_Текущая.ГУИД КАК ГУИД_тек
	|ПОМЕСТИТЬ втСУЕ
	|ИЗ
	|	втСУЕ_Текущая КАК втСУЕ_Текущая
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСУЕ_Новая КАК втСУЕ_Новая
	//Евросиб Каблов 01.11.2022 ( 52045
	//|		ПО втСУЕ_Текущая.ГУИДСтрокиЗаявки = втСУЕ_Новая.ГУИДСтрокиЗаявки
	|		ПО втСУЕ_Текущая.Контейнер = втСУЕ_Новая.Контейнер
	//Евросиб Каблов 01.11.2022 )
	|			И втСУЕ_Текущая.ВидТранспортногоСообщения = втСУЕ_Новая.ВидТранспортногоСообщения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасходыТекущейСделки.Контейнер КАК Контейнер,
	|	РасходыТекущейСделки.ГУИД КАК ГУИД,
	|	РасходыТекущейСделки.СтрокаСвязьУчетныхЕдиниц КАК СтрокаСвязьУчетныхЕдиниц,
	|	РасходыТекущейСделки.Услуга КАК Услуга,
	|	РасходыТекущейСделки.Калькуляция КАК Калькуляция,
	|	РасходыТекущейСделки.СтрокаКалькуляции КАК СтрокаКалькуляции,
	|	РасходыТекущейСделки.Вагон КАК Вагон,
	|	РасходыТекущейСделки.ТранспортныйДокумент КАК ТранспортныйДокумент,
	|	РасходыТекущейСделки.ВидЖДН КАК ВидЖДН,
	|	РасходыТекущейСделки.СуммаИтого КАК СуммаИтого,
	|	РасходыТекущейСделки.УчДокумент КАК УчДокумент
	|ПОМЕСТИТЬ втРасходыТекущейСделки
	|ИЗ
	|	&РасходыТекущейСделки КАК РасходыТекущейСделки
	//Евросиб Каблов 01.11.2022 ( 52045
	//|ГДЕ
	//|	РасходыТекущейСделки.УчДокумент <> ЗНАЧЕНИЕ(Документ.ПоступлениеТоваровУслуг.ПустаяСсылка)
	//Евросиб Каблов 01.11.2022 )
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втСУЕ1.ГУИД_нов КАК СтрокаСвязьУчетныхЕдиниц,
	|	втРасходыТекущейСделки.Контейнер КАК Контейнер,
	|	втРасходыТекущейСделки.ГУИД КАК СтрокаРасходов,
	|	втРасходыТекущейСделки.СтрокаСвязьУчетныхЕдиниц КАК СтрокаСУЕ,
	|	втРасходыТекущейСделки.Услуга КАК Услуга,
	|	втРасходыТекущейСделки.Калькуляция КАК Калькуляция,
	|	втРасходыТекущейСделки.СтрокаКалькуляции КАК СтрокаКалькуляции,
	|	втРасходыТекущейСделки.Вагон КАК Вагон,
	|	втРасходыТекущейСделки.ТранспортныйДокумент КАК ТранспортныйДокумент,
	|	втРасходыТекущейСделки.ВидЖДН КАК ВидЖДН,
	|	втРасходыТекущейСделки.СуммаИтого КАК СуммаИтого,
	|	втРасходыТекущейСделки.УчДокумент КАК УчДокумент,
	|	втСУЕ1.ГУИД_нов КАК ГУИД_нов
	|ИЗ
	|	втРасходыТекущейСделки КАК втРасходыТекущейСделки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСУЕ КАК втСУЕ1
	|		ПО (втСУЕ1.ГУИД_тек = втРасходыТекущейСделки.СтрокаСвязьУчетныхЕдиниц)";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("СвязьУчетныхЕдиницТекущая", 	СвязьУчетныхЕдиницТекущейСделки);
	Запрос.УстановитьПараметр("СвязьУчетныхЕдиницНовая", 	СвязьУчетныхЕдиницНовойСделки);
	Запрос.УстановитьПараметр("РасходыТекущейСделки",	ТаблицаРасходовТекущейСделки);
	Запрос.УстановитьПараметр("МассивКТК", 				МассивПереносимыхКТК);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		// Запишем сделку, т.к. КТК уже перенесены в нее.
		Документы.Сделка.ПересчитатьПериоды(НоваяСделка);  
		НоваяСделка.УстановитьКомментарийВерсииИсторииДанных("Перенос КТК из одной сделки в другую");
		НоваяСделка.Записать(РежимЗаписиДокумента.Проведение);
		Возврат;
	КонецЕсли;	
	
	// По перенесенным КТК заполним учетные документы в расходах новой сделки.
	
	Выборка = РезультатЗапроса.Выбрать();
		
	ТаблицаПТУ = Документы.Сделка.ПолучитьСтруктуруТаблицыПТУ();
			
	Пока Выборка.Следующий() Цикл
		
		ПараметрыПоискаСтрокиРасходов = Новый Структура("СтрокаСвязьУчетныхЕдиниц, Услуга, Калькуляция, СтрокаКалькуляции, Контейнер, Вагон, ТранспортныйДокумент, ВидЖДН, СуммаИтого");
		ЗаполнитьЗначенияСвойств(ПараметрыПоискаСтрокиРасходов, Выборка);
		
		МассивСтрокРасходовНовойСделки = НоваяСделка.Расходы.НайтиСтроки(ПараметрыПоискаСтрокиРасходов);
		КоличествоНайденныхСтрок = МассивСтрокРасходовНовойСделки.Количество();
			
		Если КоличествоНайденныхСтрок = 0 Тогда
			
			// В новой сделке строка расходов не найдена.
			// Переносим строку расходов из текущей сделки в новую.
			СтрокаРасходовТекущейСделки = ТаблицаРасходовТекущейСделки.Найти(Выборка.СтрокаРасходов, "ГУИД");
			
			// Уведомим пользователя, что строка была добавлена			
			ТекстСообщения = СтрШаблон("КТК %1. Строка расходов №%2. При переносе расходов в новую сделку не удалось найти подходящую для заполнения строку расходов и она была добавлена принудительно",
											СтрокаРасходовТекущейСделки.Контейнер,
											СтрокаРасходовТекущейСделки.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(
						ТекстСообщения,
						,
						ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Расходы", СтрокаРасходовТекущейСделки.НомерСтроки, "УчДокумент"),
						"Объект");
			//			
			
			СтрокаРасходовНовойСделки = НоваяСделка.Расходы.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаРасходовНовойСделки, СтрокаРасходовТекущейСделки);
			СтрокаРасходовНовойСделки.ГУИД 								= Новый УникальныйИдентификатор;
			СтрокаРасходовНовойСделки.СтрокаСвязьУчетныхЕдиниц 			= Выборка.СтрокаСвязьУчетныхЕдиниц;
			СтрокаРасходовНовойСделки.ИсточникПоявленияСтрокиЭкономики 	= Перечисления.ИсточникПоявленияСтрокиЭкономики.ПеремещениеКТК;
			СтрокаРасходовНовойСделки.СтрокаРасходовВПеренесеннойСделке = СтрокаРасходовТекущейСделки.ГУИД;
			СтрокаРасходовНовойСделки.ПеренесеннаяСделка 				= ТекущаяСделка.Ссылка;
			
			Документы.Сделка.СвязатьДоходыРасходыСУЕ(НоваяСделка, , СтрокаРасходовНовойСделки.ГУИД, СтрокаРасходовНовойСделки.СтрокаСвязьУчетныхЕдиниц); // доходы по переносимым КТК не переносим 
						
		Иначе
			// Строка расходов в новой сделке найдена, перенесем в эту строку учетный документ из старой строки расходов.
			Если КоличествоНайденныхСтрок > 1 Тогда
				ПредставлениеОтбора = "";
				Для Каждого ТекОтбор Из ПараметрыПоискаСтрокиРасходов Цикл
					ПредставлениеОтбора = ПредставлениеОтбора
										+ ?(ПустаяСтрока(ПредставлениеОтбора), "", ", ")
										+ ТекОтбор.Ключ + " = " + ТекОтбор.Значение;
				КонецЦикла;	
				ЗаписьЖурналаРегистрации("Изменение заявки (исключение КТК из сделки и перенос в другую сделку)",
							УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.Сделка, НоваяСделка, "В расходах сделки найдено несколько строк по следующим параметрам: " + ПредставлениеОтбора);
			КонецЕсли;	
			
			СтрокаРасходовНовойСделки = МассивСтрокРасходовНовойСделки[0];
			СтрокаРасходовНовойСделки.УчДокумент = Выборка.УчДокумент;
				
		КонецЕсли;
		
		//Евросиб Каблов 01.11.2022 ( 52045
		Если ЗначениеЗаполнено(СтрокаРасходовНовойСделки.УчДокумент) Тогда
		//Евросиб Каблов 01.11.2022 )
			нСтрокаТаблицаПТУ = ТаблицаПТУ.Добавить();
			нСтрокаТаблицаПТУ.ПТУ 										= СтрокаРасходовНовойСделки.УчДокумент;
			нСтрокаТаблицаПТУ.СделкаНовая 								= НоваяСделка.Ссылка;
			нСтрокаТаблицаПТУ.СделкаСтарая								= ТекущаяСделка.Ссылка;
			нСтрокаТаблицаПТУ.ИдентификаторСтрокиРасходовСделкиНовая 	= СтрокаРасходовНовойСделки.ГУИД;
			нСтрокаТаблицаПТУ.ИдентификаторСтрокиРасходовСделкиСтарая 	= Выборка.СтрокаРасходов;
		//Евросиб Каблов 01.11.2022 ( 52045
		КонецЕсли;
		//Евросиб Каблов 01.11.2022 )
		
		// В текущей сделке пометим строку как перенесенную.
		МассивСтрокРасходовТекущейСделкиОбъект = ТекущаяСделка.Расходы.НайтиСтроки(Новый Структура("ГУИД", Выборка.СтрокаРасходов));
		Если МассивСтрокРасходовТекущейСделкиОбъект.Количество() > 0 Тогда
			СтрокаРасходовТекущейСделкиОбъект = МассивСтрокРасходовТекущейСделкиОбъект[0];
			СтрокаРасходовТекущейСделкиОбъект.СтрокаРасходовВПеренесеннойСделке = СтрокаРасходовНовойСделки.ГУИД;
			СтрокаРасходовТекущейСделкиОбъект.ПеренесеннаяСделка 				= НоваяСделка.Ссылка;
			СтрокаРасходовТекущейСделкиОбъект.УчДокумент 						= Неопределено;
			
			СтрокаРасходовНовойСделки.ПеренесеннаяСделка = ТекущаяСделка.Ссылка;
			СтрокаРасходовНовойСделки.СтрокаРасходовВПеренесеннойСделке = СтрокаРасходовТекущейСделкиОбъект.ГУИД;
		КонецЕсли;
		
	КонецЦикла; 
		
	ТаблицаПТУ.Сортировать("ПТУ");
	ТаблицаСписокПТУ = ТаблицаПТУ.Скопировать(,"ПТУ");
	ТаблицаСписокПТУ.Свернуть("ПТУ");
	МассивЗаписываемыхАкцептов = Новый Массив;
	
	Для Каждого СтрокаСпискаПТУ Из ТаблицаСписокПТУ Цикл
		обАкцепт = Документы.Акцепт.НайтиСоздатьАктуальныйАкцепт(СтрокаСпискаПТУ.ПТУ, Ложь); 
		обАкцепт.ДополнительныеСвойства.Вставить("ЗаписьИзСделки");
		СтрокиДляОбработки = ТаблицаПТУ.НайтиСтроки(Новый Структура("ПТУ", СтрокаСпискаПТУ.ПТУ));
		Для Каждого СтрокаДляОбработки Из СтрокиДляОбработки Цикл
			СтрокиДляИзменения = обАкцепт.Услуги.НайтиСтроки(Новый Структура("Сделка, ИдентификаторСтрокиРасходовВСделке", СтрокаДляОбработки.СделкаСтарая, СтрокаДляОбработки.ИдентификаторСтрокиРасходовСделкиСтарая));
			Для Каждого СтрокаДляИзменения Из СтрокиДляИзменения Цикл
				СтрокаДляИзменения.Сделка = СтрокаДляОбработки.СделкаНовая;
				СтрокаДляИзменения.ИдентификаторСтрокиРасходовВСделке = СтрокаДляОбработки.ИдентификаторСтрокиРасходовСделкиНовая;
			КонецЦикла; 
		КонецЦикла;
		МассивЗаписываемыхАкцептов.Добавить(обАкцепт);
	КонецЦикла; 
	
    // Попытку в этом месте не пишем, т.к. вся процедура выполняется в одной транзакции (см. ее запуск).
	// Т.к. кроме сделок выполняется изменение авансового счета на оплату.
	Документы.Сделка.ПересчитатьПериоды(НоваяСделка);  
	НоваяСделка.УстановитьКомментарийВерсииИсторииДанных("Перенос КТК из одной сделки в другую");
	НоваяСделка.Записать(РежимЗаписиДокумента.Проведение);
		
	Для Каждого ЗаписываемыйАкцепт Из МассивЗаписываемыхАкцептов Цикл 
		ПериодАкцепта = Мин(ЗаписываемыйАкцепт.ПериодВО, ЗаписываемыйАкцепт.ПериодБУ);
		ПретензииИНеакцептыСервер.ДополнитьСтрокиАкцептовДаннымиСделки(ЗаписываемыйАкцепт, Истина, ПериодАкцепта);
		Если ЗначениеЗаполнено(ЗаписываемыйАкцепт.Ссылка) Тогда
			Документы.Акцепт.ЗаполнитьИзмененныеСуммыПТУпоАкцепту(ЗаписываемыйАкцепт.Поступление, ЗаписываемыйАкцепт.Ссылка);
		КонецЕсли;            
		ЗаписываемыйАкцепт.УстановитьКомментарийВерсииИсторииДанных("Перенос КТК из одной сделки в другую");
		ЗаписываемыйАкцепт.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла; 
					
КонецПроцедуры	

&НаСервереБезКонтекста
Функция МорскиеРейсыЗаявок(Сделка)
	
	// Получим все морские рейсы на все заявки из сделки.
	
	МассивЗаявок = Сделка.Заявки.Выгрузить().ВыгрузитьКолонку("Заявка");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТранспортныйДокументКоносаменты.НомерКТК КАК НомерКТК,
	|	ЗаявкаПереченьРейсов.Ссылка КАК Заявка,
	|	ТранспортныйДокументКоносаменты.Ссылка.МорскойРейс КАК МорскойРейс,
	|	ТранспортныйДокументКоносаменты.Ссылка КАК Коносамент,
	|	ТранспортныйДокументКоносаменты.Ссылка.СтанцияОтправления КАК СтанцияОтправления,
	|	ТранспортныйДокументКоносаменты.Ссылка.СтанцияНазначения КАК СтанцияНазначения
	|ИЗ
	|	Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент.Коносаменты КАК ТранспортныйДокументКоносаменты
	|		ПО ЗаявкаПереченьРейсов.Рейс = ТранспортныйДокументКоносаменты.Ссылка.МорскойРейс
	|ГДЕ
	|	ЗаявкаПереченьРейсов.Ссылка В(&МассивЗаявок)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТранспортныйДокументКоносаменты.Ссылка.ДатаТранспортногоДокумента УБЫВ";
	
	Запрос.УстановитьПараметр("МассивЗаявок", МассивЗаявок);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции	

&НаКлиенте
Процедура ФильтрСоставаПоездаПоКТК(Команда)
	Если Элементы.СвязьУчетныхЕдиниц.ОтборСтрок <> Неопределено Тогда
		// Фильтр по КТК установлен и нужно его снять.
		Элементы.СвязьУчетныхЕдиниц.ОтборСтрок = Неопределено;
		Элементы.СвязьУчетныхЕдиницФильтрСоставаПоездаПоКТК.Заголовок = "Фильтр по КТК";
	Иначе
		// Фильтра по КТК нет и нужно его установить.
		ОповещениеПослеВыбораКТК = Новый ОписаниеОповещения("ОбработатьФильтрСоставаПоездаПоКТК", ЭтаФорма);	
		ОткрытьФорму("ОбщаяФорма.ВставкаИзБуфераОбмена", Новый Структура("КТК", Истина), ЭтаФорма,,,, ОповещениеПослеВыбораКТК, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
КонецПроцедуры 

&НаКлиенте
Процедура ОбработатьФильтрСоставаПоездаПоКТК(РезультатВыбораФильтра, ДопПараметры) Экспорт
	
	Если РезультатВыбораФильтра = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекСтрока Из Объект.СвязьУчетныхЕдиниц Цикл
		ТекСтрока.ПодходитКОтбору = Ложь;
		Если РезультатВыбораФильтра.Найти(ТекСтрока.Контейнер) <> Неопределено Тогда
			ТекСтрока.ПодходитКОтбору = Истина;
		КонецЕсли;	
	КонецЦикла;	
	
	ФиксированнаяСтруктура = Новый ФиксированнаяСтруктура("ПодходитКОтбору", Истина);
	Элементы.СвязьУчетныхЕдиниц.ОтборСтрок = ФиксированнаяСтруктура;
		
	Элементы.СвязьУчетныхЕдиницФильтрСоставаПоездаПоКТК.Заголовок = "Фильтр по КТК (отменить)";
КонецПроцедуры

&НаСервере
Процедура ИзменитьПризнакАктивностиСтрокиСоставаПоезда(НовоеЗначение)
	СписокКонт = Новый Массив;
	ПараметрыОТбора = Новый Структура;
	ПараметрыОТбора.Вставить("БезЖДН",Истина);
	НайденныеСтроки = Объект.СвязьУчетныхЕдиниц.НайтиСтроки(ПараметрыОТбора);
	Для Каждого Стр Из НайденныеСтроки Цикл
		Стр.НеАктивна = НовоеЗначение;
	КонецЦикла;
КонецПроцедуры

