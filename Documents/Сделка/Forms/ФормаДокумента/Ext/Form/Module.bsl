&НаКлиенте
Процедура ОбработкаРаботыФильтра(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 <> неопределено Тогда
		
		Для каждого Стр из Объект.СвязьУчетныхЕдиниц Цикл
			
			РешениеНайдено = Ложь;
			Для каждого СтрРешение из Объект.ИсторияФильтрацииКонтейнеров Цикл
				Если Стр.Контейнер = СтрРешение.КТК И Стр.Заявка = СтрРешение.Заявка И СтрРешение.Решение <> 0 Тогда
					РешениеНайдено = Истина;
					Прервать; // по контейнерам, по которым уже принималось решение - их не удалять и не добавлять повторно, эти строчки должны оставаться неизменными
				КонецЕсли;
			КонецЦикла;
			Если РешениеНайдено Тогда Продолжить; КонецЕсли;
			
			Стр.Удалена = Ложь;
			ДобавитьВИсториюУдаленияРешениеПоКТК(Стр.Контейнер, Стр.Заявка, 1);
			
			КТКВыбран = Параметр1.СписокКТК.Найти(Стр.Контейнер) <> неопределено;
			
			Если НЕ ЗначениеЗаполнено(Стр.Коносамент) И Параметр1.КТКБезКоносаментов = 0 Тогда 
				Продолжить; 
			КонецЕсли;
			
			Если (КТКВыбран И Параметр1.ВыбранныеКТК = 1) ИЛИ (НЕ КТКВыбран И Параметр1.ВыбранныеКТК = 0) Тогда
				
				Стр.Удалена = Истина;
				ДобавитьВИсториюУдаленияРешениеПоКТК(Стр.Контейнер, Стр.Заявка, 2);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Объект.Доходы.Количество() = 0 И Объект.Расходы.Количество() = 0  Тогда
		
		МассивУдаляемых = Новый Массив;
		
		Для каждого Стр из Объект.СвязьУчетныхЕдиниц Цикл
			Если Стр.Удалена = Истина Тогда МассивУдаляемых.Добавить(Стр); КонецЕсли;
		КонецЦикла;
		
		Для каждого Стр из МассивУдаляемых Цикл
			Объект.СвязьУчетныхЕдиниц.Удалить(Стр);			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СвязьУчетныхЕдиницЖДНПриИзменении(Элемент)
	
	ТекД = Элементы.СвязьУчетныхЕдиниц.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
