	//	Результат.Вставить("Вагон", РаботаСКонтейнерамиСервер.ПолучитьВагонПоНомеру(РезЗапроса[0].НомерВагона));
	//КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТранспортныйДокумент.НомерТранспортногоДокумента КАК НомерТранспортногоДокумента
	|ИЗ
	|	Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	|ГДЕ
	|	ТранспортныйДокумент.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТранспортныйДокументУчетныеЕдиницы.Вагон КАК Вагон
	|ИЗ
	|	Документ.ТранспортныйДокумент.УчетныеЕдиницы КАК ТранспортныйДокументУчетныеЕдиницы
	|ГДЕ
	|	ТранспортныйДокументУчетныеЕдиницы.Ссылка = &Ссылка
	|	И ТранспортныйДокументУчетныеЕдиницы.Контейнер = &Контейнер
	|	И НЕ ТранспортныйДокументУчетныеЕдиницы.Контейнер = Значение(Справочник.ТЕ.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТранспортныйДокументУчетныеЕдиницы.Вагон КАК Вагон
	|ИЗ
	|	Документ.ТранспортныйДокумент.УчетныеЕдиницы КАК ТранспортныйДокументУчетныеЕдиницы
	|ГДЕ
	|	ТранспортныйДокументУчетныеЕдиницы.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ЖДН);
	Запрос.УстановитьПараметр("Контейнер", Контейнер);
	МассивРезультатов = Запрос.ВыполнитьПакет();
	Результат.Вставить("НомерЖДН", МассивРезультатов[0].Выгрузить()[0].НомерТранспортногоДокумента);
	Если НЕ МассивРезультатов[1].Пустой() Тогда
		Результат.Вставить("Вагон", МассивРезультатов[1].Выгрузить()[0].Вагон);
	ИначеЕсли НЕ МассивРезультатов[2].Пустой() Тогда
		ТаблицаВагонов = МассивРезультатов[2].Выгрузить();
		Если ТаблицаВагонов.Количество() = 1 Тогда
			Результат.Вставить("Вагон", ТаблицаВагонов[0].Вагон);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

