&НаСервереБезКонтекста
Функция ПолучитьДанныеДоплаты(КТК, ПериодЪ, ТекСделка = неопределено)
	
	Результат = Новый Структура("Доплата_Клиент, Доплата_Договор, Доплата_ПСЦ, Доплата_Калькуляция, Доплата_Доплата, Доплата_Валюта");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	стоки_КлиентскоеОперированиеСрезПоследних.допл_Клиент КАК Доплата_Клиент,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.допл_Договор КАК Доплата_Договор,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.допл_ПСЦ КАК Доплата_ПСЦ,
	               |	ВЫБОР
	               |		КОГДА стоки_ТекущиеДанныеСрезПоследних.комм_Ставка > 0
	               |			ТОГДА стоки_ТекущиеДанныеСрезПоследних.комм_Ставка
	               |		ИНАЧЕ -стоки_ТекущиеДанныеСрезПоследних.комм_Ставка
	               |	КОНЕЦ КАК Доплата_Доплата,
	               |	стоки_ТекущиеДанныеСрезПоследних.комм_Валюта КАК Доплата_Валюта,
	               |	стоки_КлиентскоеОперированиеСрезПоследних.допл_Калькуляция КАК Доплата_Калькуляция
	               |ИЗ
	               |	РегистрСведений.стоки_КлиентскоеОперирование.СрезПоследних(, КТК = &КТК) КАК стоки_КлиентскоеОперированиеСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.стоки_ТекущиеДанные.СрезПоследних КАК стоки_ТекущиеДанныеСрезПоследних
	               |		ПО стоки_КлиентскоеОперированиеСрезПоследних.КТК = стоки_ТекущиеДанныеСрезПоследних.КТК
	               |ГДЕ
	               |	НЕ стоки_КлиентскоеОперированиеСрезПоследних.допл_ПСЦ В
	               |				(ВЫБРАТЬ
	               |					СделкаСвязьУчетныхЕдиниц.Доплата_ПСЦ КАК Доплата_ПСЦ
	               |				ИЗ
	               |					Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	               |				ГДЕ
	               |					СделкаСвязьУчетныхЕдиниц.Ссылка.ПометкаУдаления = ЛОЖЬ
	               |					И СделкаСвязьУчетныхЕдиниц.Ссылка <> &ТекСделка
	               |					И СделкаСвязьУчетныхЕдиниц.Контейнер = &КТК)";
				   //|	И стоки_КлиентскоеОперированиеСрезПоследних.допл_Сделка = &ТекСделка"; //ДИТ, Беляев СЮ, Ticket#0271096, 04-05-2022 закомментировал - отбор не требуется и нет такого реквизита на рабочей базе
	
	Запрос.УстановитьПараметр("КТК", КТК);
	Запрос.УстановитьПараметр("ТекСделка", ТекСделка);
	
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() И ЗначениеЗаполнено(Ответ.Доплата_Клиент) Тогда
		
		ЗаполнитьЗначенияСвойств(Результат, Ответ);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

