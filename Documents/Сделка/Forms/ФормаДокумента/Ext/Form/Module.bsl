&НаКлиенте
Процедура ПодтверждениеУдаленияСтрокРасходов(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 <> КодВозвратаДиалога.Да тогда Возврат; КонецЕсли;
	
	МассивУдаляемыхСтрок = Новый Массив;
	МассивИдентификаторовУдаляемыхСтрок = Новый Массив; 
	//Субботин 69649 24.08.2023 Начало
	ВыделенныеСтроки = Элементы.Расходы.ВыделенныеСтроки;
	МассивПривязанныеСтрокИзАкцептов = ПолучениеГуидовАктуальныхАкцептов(Объект.Ссылка, ВыделенныеСтроки);
	МассивЗаблокированныхСтрок = Новый Массив;
	//Субботин 69649 24.08.2023 Конец
	Для каждого Стр из ВыделенныеСтроки Цикл
		Пропуск = ложь;
		// Подготовка по каждой строке
		ТекС = Объект.Расходы.НайтиПоИдентификатору(Стр);
		//Субботин 69649 24.08.2023 Начало
		Для каждого СтрокаМассива из МассивПривязанныеСтрокИзАкцептов цикл
			Если СтрокаМассива.Гуид = ТекС.ГУИД тогда
				МассивЗаблокированныхСтрок.Добавить(Новый Структура("НомерСтроки, ПТУ, Количество",  ТекС.НомерСтроки, СтрокаМассива.ПТУ, СтрокаМассива.Количество));
				Пропуск = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Пропуск тогда
			Продолжить;
		КонецЕсли;
		//Субботин 69649 24.08.2023 Конец
		
		//убираем по задаче-- //Субботин 69649 24.08.2023 Начало
		//Если ЗначениеЗаполнено(ТекС.УчДокумент) Тогда
		//	//сразу нет, если док проведен
		//	Если ОбщегоНазначенияВызовСервера.ЗначениеРеквизитаОбъекта(ТекС.УчДокумент, "Проведен") Тогда
		//		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("В строке расходов %1 заполнен учетный документ", ТекС.НомерСтроки));
		//		Продолжить;
		//	КонецЕсли; 
		//КонецЕсли;
		//убираем по задаче-- //Субботин 69649 24.08.2023 Конец
		
		Если ТекС.ЕстьОтчетКомитенту Тогда
			//сразу нет, если док проведен
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("По строке расходов %1 выставлен отчет комитенту", ТекС.НомерСтроки));
			Продолжить;
		КонецЕсли;
		
		МассивУдаляемыхСтрок.Добавить(ТекС);
		МассивИдентификаторовУдаляемыхСтрок.Добавить(ТекС.ГУИД);
	КонецЦикла;
	//Субботин 69649 24.08.2023 Начало
	Если МассивЗаблокированныхСтрок.Количество() > 0 Тогда 
		МаксКоличествоСообщений = 4;
		Для Индекс = 0 По Мин(МассивЗаблокированныхСтрок.Количество()-1, МаксКоличествоСообщений) цикл
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("По строке расходов %1 имеется привязанный Акцепт, для удаления строки отвяжите все привязанные ПТУ: %2",
			МассивЗаблокированныхСтрок[Индекс].НомерСтроки,
			?(МассивЗаблокированныхСтрок[Индекс].Количество = 1,МассивЗаблокированныхСтрок[Индекс].ПТУ," в количестве: " + МассивЗаблокированныхСтрок[Индекс].Количество ))); 
		КонецЦикла;
	КонецЕсли;
			
    ОчиститьДанныеВВспомогательныхТаблицахНаСервере(МассивИдентификаторовУдаляемыхСтрок, "Расходы");
	Для каждого УдаляемаяСтрока Из МассивУдаляемыхСтрок Цикл
		Объект.Расходы.Удалить(УдаляемаяСтрока);
	КонецЦикла; 
	
КонецПроцедуры

//Субботин 69649 24.08.2023 Начало
Функция ПолучениеГуидовАктуальныхАкцептов(Сделка, ВыделенныеСтроки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = ОтложенноеИзменениеСервер.ТекстЗапросаПолучениеГуидовСтрок();
	Запрос.УстановитьПараметр("Сделка", Сделка);
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	КоличествоРезультатов = МассивРезультатов.Количество();
	МассивСтрок = Новый Массив; 
	РезультатСтрокиСАкцептами =  МассивРезультатов[КоличествоРезультатов-3].Выгрузить();
	Для каждого ВыделеннаяСтрока из ВыделенныеСтроки цикл
		ТекС = Объект.Расходы.НайтиПоИдентификатору(ВыделеннаяСтрока);
		СтруктураПоиска = Новый Структура("ГУИД", ТекС.ГУИД);
		ПТУ_ПоСтроке = РезультатСтрокиСАкцептами.НайтиСтроки(СтруктураПоиска);
		Если ПТУ_ПоСтроке.Количество() = 1 тогда
			МассивСтрок.Добавить(Новый Структура("ГУИД, ПТУ, Количество", ТекС.ГУИД, ПТУ_ПоСтроке[0].Поступление, 1));
		ИначеЕсли ПТУ_ПоСтроке.Количество()> 0 тогда
			МассивСтрок.Добавить(Новый Структура("ГУИД, ПТУ, Количество", ТекС.ГУИД, Документы.ПоступлениеТоваровУслуг.ПустаяСсылка(), ПТУ_ПоСтроке.Количество()));
		КонецЕсли;
	КонецЦикла;
	Возврат МассивСтрок 
КонецФункции
//Субботин 69649 24.08.2023 конец


