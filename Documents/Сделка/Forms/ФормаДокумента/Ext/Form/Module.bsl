&НаКлиенте
Процедура расходы_СвязатьСтрокуДоходовСРасходами(Команда)
	
	ВыделенныеРасходы = Элементы.Расходы.ВыделенныеСтроки;
	ТекД = Элементы.Доходы.ТекущиеДанные;
	Для каждого ВыдСтрока Из ВыделенныеРасходы Цикл
		СтрокаРасход = Объект.расходы.НайтиПоИдентификатору(ВыдСтрока);
		СвязатьДоходыРасходыСУЕ(,
								СтрокаРасход.ГУИД,
								СтрокаРасход.СтрокаСвязьУчетныхЕдиниц,
								?(СтрокаРасход.ИсточникПоявленияСтрокиЭкономики = ПредопределенноеЗначение("Перечисление.ИсточникПоявленияСтрокиЭкономики.ОсновнаяУслугаАвтоматически"),Неопределено,СтрокаРасход.Услуга));
		СвязатьДоходыРасходыСУЕ(ТекД.ГУИД,
								,
								СтрокаРасход.СтрокаСвязьУчетныхЕдиниц,
								?(СтрокаРасход.ИсточникПоявленияСтрокиЭкономики = ПредопределенноеЗначение("Перечисление.ИсточникПоявленияСтрокиЭкономики.ОсновнаяУслугаАвтоматически"),Неопределено,СтрокаРасход.Услуга));
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура ДоходыПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("ОтключитьЭлементыКонтекстногоМенюДоходы",0.2,Истина);
	Если НЕ ПоказыватьТолькоСвязанныеСтрокиДР Тогда Возврат; КонецЕсли;
	
	Для каждого Стр из Объект.Доходы Цикл
		Стр.Пометка = Ложь;
	КонецЦикла;
	Для каждого Стр из Объект.Расходы Цикл
		Стр.Пометка = Ложь;
	КонецЦикла;
	
	ТекД = Элементы.Доходы.ТекущиеДанные;
	Если ТекД = неопределено Тогда Возврат; КонецЕсли;
	
	МассивСоотвРасходов = Новый массив;
	Для каждого Стр из Объект.СвязьДоходовИРасходов Цикл
		Если Стр.Доходы = ТекД.ГУИД Тогда МассивСоотвРасходов.Добавить(Стр.Расходы); КонецЕсли;
	КонецЦикла;
	
	Для каждого Стр из Объект.Расходы Цикл
		Стр.Пометка = (МассивСоотвРасходов.Найти(Стр.ГУИД) <> неопределено);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РасходыПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("ОтключитьЭлементыКонтекстногоМенюРасходы",0.2,Истина);
	Возврат;
	Если ПоказыватьТолькоСвязанныеСтрокиДР Тогда Возврат; КонецЕсли;
	
	Для каждого Стр из Объект.Доходы Цикл
		Стр.Пометка = Ложь;
	КонецЦикла;
	Для каждого Стр из Объект.Расходы Цикл
		Стр.Пометка = Ложь;
	КонецЦикла;
	
	ТекД = Элементы.Расходы.ТекущиеДанные;
	Если ТекД = неопределено Тогда Возврат; КонецЕсли;
	
	МассивСоотвДоходов = Новый массив;
	Для каждого Стр из Объект.СвязьДоходовИРасходов Цикл
		Если Стр.Расходы = ТекД.ГУИД Тогда МассивСоотвДоходов.Добавить(Стр.Доходы); КонецЕсли;
	КонецЦикла;
	
	Для каждого Стр из Объект.Доходы Цикл
		Стр.Пометка = (МассивСоотвДоходов.Найти(Стр.ГУИД) <> неопределено);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РасходыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекД = Элементы.Расходы.ТекущиеДанные;
	
	Если НоваяСтрока Тогда
		ТекД.ГУИД = Строка(Новый УникальныйИдентификатор());
		ТекД.Регламентный = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура выставление_ВыставитьСчетНаПредоплату(Команда)
	
	Если ЭтаФорма.Модифицированность Тогда Записать(); КонецЕсли;
	ОткрытьФорму("Документ.СчетНаОплатуПокупателю.ФормаОбъекта", Новый Структура("ЗаполнитьПоОснованию", Объект.Ссылка));
	
КонецПроцедуры

&НаКлиенте
Процедура выставление_СоздатьКомплектДокументов(Команда)
	
	выставление_НайтиИПривязатьРеализации(Неопределено);
	//проверим, что договоры не находятся в списках по претензиям
	ПроверитьДоговорыНаНаличиеПретензийНаСервере();
	Если Модифицированность Тогда
		ОпОп = Новый ОписаниеОповещения("ОбработкаОтветаНаВопросСохранения", ЭтаФорма);
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить("СохранитьИПродолжить", "Сохранить и продолжить");
		Кнопки.Добавить("Отменить", "Отменить");
		ПоказатьВопрос(ОпОп, "Документ изменен, перед созданием комплекта документов его необходимо сохранить.
		|Сохранить?", Кнопки);
	Иначе
		ПроверитьНаличиеДополнительныхУслуг();
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьДоговорыНаНаличиеПретензийНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(СделкаДоходы.Договор КАК Справочник.ДоговорыКонтрагентов) КАК Договор
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&СделкаДоходы КАК СделкаДоходы
	|ГДЕ
	|	СделкаДоходы.НеВыставлятьКлиенту = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Договор КАК Договор,
	|	ВТ.Договор.Владелец КАК Контрагент,
	|	ВЫБОР
	|		КОГДА НЕ ВТ.Договор.ПолученОригинал
	|				И ВТ.Договор.СрокПредоставленияОригиналаДата < &ТекущаяДата
	|			ТОГДА ИСТИНА
	|		КОГДА ИсторияСтатусовПДЗСрезПоследних.Статус ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		КОГДА ИсторияСтатусовПДЗСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПДЗ.ПретензионнаяЗадолженность)
	|			ТОГДА ИСТИНА
	|		КОГДА ИсторияСтатусовПДЗСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПДЗ.ВыставленаПретензия)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЗапрещенаОтгрузка,
	|	ВЫБОР
	|		КОГДА НЕ ВТ.Договор.ПолученОригинал
	|				И ВТ.Договор.СрокПредоставленияОригиналаДата < &ТекущаяДата
	|			ТОГДА ""НеПредоставленОригинал""
	|		КОГДА ИсторияСтатусовПДЗСрезПоследних.Статус ЕСТЬ NULL
	|			ТОГДА """"
	|		КОГДА ИсторияСтатусовПДЗСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПДЗ.ПретензионнаяЗадолженность)
	|			ТОГДА ""СудебнаяРабота""
	|		КОГДА ИсторияСтатусовПДЗСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПДЗ.ВыставленаПретензия)
	|			ТОГДА ""ВыставленаПретензия""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК Причина
	|ПОМЕСТИТЬ ВТ_Результат
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияСтатусовПДЗ.СрезПоследних КАК ИсторияСтатусовПДЗСрезПоследних
	|		ПО ВТ.Договор.Владелец = ИсторияСтатусовПДЗСрезПоследних.Договор.Владелец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Результат.Договор КАК Договор,
	|	ВТ_Результат.Контрагент КАК Контрагент,
	|	ВТ_Результат.ЗапрещенаОтгрузка КАК ЗапрещенаОтгрузка,
	|	ВТ_Результат.Причина КАК Причина
	|ИЗ
	|	ВТ_Результат КАК ВТ_Результат
	|ГДЕ
	|	ВТ_Результат.ЗапрещенаОтгрузка = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИсторияСтатусовПДЗСрезПоследних.Договор КАК Договор
	|ИЗ
	|	РегистрСведений.ИсторияСтатусовПДЗ.СрезПоследних КАК ИсторияСтатусовПДЗСрезПоследних
	|ГДЕ
	|	ИсторияСтатусовПДЗСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПДЗ.НеСтопЛист)";
	Запрос.УстановитьПараметр("СделкаДоходы", Объект.Доходы.Выгрузить());
	Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ТекущаяДата()));
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	Если РезультатЗапроса[2].Пустой() Тогда
		Возврат;
	КонецЕсли; 
	
	Выборка = РезультатЗапроса[2].Выбрать();
	МассивДоговоровВнеСтоплистов = РезультатЗапроса[3].Выгрузить().ВыгрузитьКолонку("Договор");
	Пока Выборка.Следующий() Цикл
		Если Выборка.Причина = "НеПредоставленОригинал" Тогда
			СообщениеПользователю = "По клиенту %1 истёк срок предоставления оригинала договора. Документы созданы не будут";
		ИначеЕсли Выборка.Причина = "СудебнаяРабота" Тогда
			СообщениеПользователю = "С клиентом %1 ведется судебная работа. Документы созданы не будут. Обратитесь в Финансовый отдел.";
		ИначеЕсли Выборка.Причина = "ВыставленаПретензия" Тогда
			СообщениеПользователю = "Клиенту %1 выставлена претензия. Документы созданы не будут. Обратитесь в Финансовый отдел";
		КонецЕсли; 
		СообщениеПользователю = СтрШаблон(СообщениеПользователю, Выборка.Контрагент);
		//найдем все договоры и установим галочки не выставлять клиенту
		СообщитьИнформациюПользователю = Ложь;
		Для каждого СтрокаДоход Из Объект.Доходы.НайтиСтроки(Новый Структура("Клиент", Выборка.Контрагент)) Цикл
			//если договор есть отдельно не в стоп листе, то по таким договорам документы можно выставлять
			Если МассивДоговоровВнеСтоплистов.Найти(СтрокаДоход.Договор) <> Неопределено Тогда
				//Возврат;
				//ДИТ, Беляев СЮ, Ticket#0254869, 12-01-2022, ++
				Прервать;
				//ДИТ, Беляев СЮ, Ticket#0254869, 12-01-2022, --
			Иначе                                           
				//СтрокаДоход.НеВыставлятьКлиенту = Истина;
				//СообщитьИнформациюПользователю = Истина;
				//ДИТ, Беляев СЮ, Ticket#0254869, 12-01-2022, ++
				Если НЕ ЗначениеЗаполнено(СтрокаДоход.УчДокумент) Тогда
					СтрокаДоход.НеВыставлятьКлиенту = Истина;
					СообщитьИнформациюПользователю = Истина;
				КонецЕсли;
				//ДИТ, Беляев СЮ, Ticket#0254869, 12-01-2022, --
			КонецЕсли; 
		КонецЦикла;
		Если СообщитьИнформациюПользователю Тогда
			ОбщегоНазначения.СообщитьПользователю(СообщениеПользователю);
		КонецЕсли; 
	КонецЦикла; 
	
КонецПроцедуры
 
&НаКлиенте
Процедура ОбработкаОтветаНаВопросСохранения(РезультатВопроса, ДопПараметры) Экспорт
	Если РезультатВопроса = "СохранитьИПродолжить" Тогда
		//ДИТ, Беляев СЮ, Ticket#0348041, 08-04-2024, начало
		Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
			ВерсияТекущегоОбъекта = Объект.ВерсияДанных;
			ВерсияДокументаНаСервере = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "ВерсияДанных");
			Если ВерсияТекущегоОбъекта <> ВерсияДокументаНаСервере Тогда
				СтрокаСообщения = "Внимание! Создание комплекта документов прервано. Сделка была изменена другим пользователем. Документ будет перечитан";
				ОбщегоНазначенияКлиент.СообщитьПользователю(СтрокаСообщения);
				ЗаписатьСобытиеВЖурналРегистрации(Объект.Ссылка, СтрокаСообщения);
				ЭтаФорма.Прочитать();
				Возврат;
			КонецЕсли;
		КонецЕсли;
		//ДИТ, Беляев СЮ, Ticket#0348041, 08-04-2024, конец
		
		Записан = Записать();
		Если Записан Тогда
			ПроверитьНаличиеДополнительныхУслуг();
		КонецЕсли; 
	КонецЕсли; 
КонецПроцедуры

//ДИТ, Беляев СЮ, Ticket#0348041, 08-04-2024, начало
&НаСервереБезКонтекста
Процедура ЗаписатьСобытиеВЖурналРегистрации(Ссылка, СтрокаСообщения)
	ЗаписьЖурналаРегистрации("Ошибка записи Сделки",
							УровеньЖурналаРегистрации.Ошибка, 
							Метаданные.Документы.Сделка, 
							Ссылка,
							СтрокаСообщения);
КонецПроцедуры
//ДИТ, Беляев СЮ, Ticket#0348041, 08-04-2024, конец

&НаКлиенте
Процедура ПроверитьНаличиеДополнительныхУслуг()

	ТекстСообщения = ПроверитьКоносаментыНаНеобходимостьВыставленияИзНесколькихСделок();
	Если ЗначениеЗаполнено(ТекстСообщения) Тогда
		ПоказатьПредупреждение(,ТекстСообщения,30);
	КонецЕсли; 
	СтруктураФормированиеУслуг = ЕстьНевыставленныеОсновныеИДопУслуги();
	Если СтруктураФормированиеУслуг.ОсновныеУслуги
		И СтруктураФормированиеУслуг.ДополнительныеУслуги Тогда
		ОпОп = Новый ОписаниеОповещения("ОбработкаОтветаНаВопросДопУслуги", ЭтаФорма);
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить("ЕдиныйКомплект", "Выставлять единым комплектом документов");
		Кнопки.Добавить("РазбитьКомплект", "Выставлять различные комплекты документов");
		Кнопки.Добавить("Отмена", "Отменить");
		ПоказатьВопрос(ОпОп, "В доходах найдены дополнительные услуги. Каким образом выставить комплект документов?", Кнопки);
	ИначеЕсли НЕ СтруктураФормированиеУслуг.ОсновныеУслуги 
		ИЛИ НЕ СтруктураФормированиеУслуг.ДополнительныеУслуги 
		Тогда
		СоздатьКомплектДокументовНаКлиенте("РазбитьКомплект")
	Иначе
		СоздатьКомплектДокументовНаКлиенте();
	КонецЕсли; 
КонецПроцедуры

&НаСервере
Функция ПроверитьКоносаментыНаНеобходимостьВыставленияИзНесколькихСделок()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СделкаДоходы.Клиент КАК Клиент,
	|	СделкаДоходы.Коносамент КАК Коносамент,
	|	СделкаДоходы.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Документ.Сделка.Доходы КАК СделкаДоходы
	|ГДЕ
	|	СделкаДоходы.Ссылка = &Ссылка
	|	И СделкаДоходы.НеВыставлятьКлиенту = ЛОЖЬ
	|	И НЕ СделкаДоходы.Коносамент = ЗНАЧЕНИЕ(Документ.ТранспортныйДокумент.ПустаяСсылка)
	|	И СделкаДоходы.Клиент В
	|			(ВЫБРАТЬ
	|				т.Контрагент
	|			ИЗ
	|				Справочник.ФормированиеФинДокументов КАК т
	|			ГДЕ
	|				т.ОбъединятьКоносаментыИзРазныхСделок
	|   			И НЕ т.ПометкаУдаления )
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПРЕДСТАВЛЕНИЕ(СделкаСвязьУчетныхЕдиниц.Ссылка) КАК Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(СделкаСвязьУчетныхЕдиниц.Клиент) КАК Клиент,
	|	ПРЕДСТАВЛЕНИЕ(СделкаСвязьУчетныхЕдиниц.Коносамент) КАК Коносамент,
	|	СделкаСвязьУчетныхЕдиниц.Клиент КАК Клиент1,
	|	СделкаСвязьУчетныхЕдиниц.Коносамент.НомерТранспортногоДокумента КАК НомерТД,
	|	СделкаСвязьУчетныхЕдиниц.Ссылка.Номер КАК СделкаНомер,
	|	СделкаСвязьУчетныхЕдиниц.Ссылка.Дата КАК СделкаДата
	|ИЗ
	|	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|ГДЕ
	|	НЕ СделкаСвязьУчетныхЕдиниц.Ссылка В
	|				(ВЫБРАТЬ
	|					т.Ссылка
	|				ИЗ
	|					ВТ КАК т)
	|	И СделкаСвязьУчетныхЕдиниц.Коносамент В
	|			(ВЫБРАТЬ
	|				т.Коносамент
	|			ИЗ
	|				ВТ КАК т)
	|	И СделкаСвязьУчетныхЕдиниц.ДокументыСформированы = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	СделкаСвязьУчетныхЕдиниц.Клиент";
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат "";
	КонецЕсли; 
	Выборка = РезультатЗапроса.Выбрать();
	ОбщийТекстСообщения = "";
	Пока Выборка.Следующий() Цикл
		ТекстСообщения = "Для клиента %1 по коносаменту %2 необходимо довыставить комплект документов из сделки №%3 от %4
		|";
		ТекстСообщения = СтрШаблон(ТекстСообщения, Выборка.Клиент, Выборка.НомерТД, ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Выборка.СделкаНомер), Формат(Выборка.СделкаДата,"ДФ=dd.MM.yyyy"));
		ОбщийТекстСообщения = ОбщийТекстСообщения + ТекстСообщения;
	КонецЦикла; 	
	ОбщийТекстСообщения = ОбщийТекстСообщения + "т.к. в правилах формирования клиентских документов включен параметр «Объединять коносаменты из разных сделок»";
	Возврат ОбщийТекстСообщения;
	
КонецФункции

&НаСервере
Функция ЕстьНевыставленныеОсновныеИДопУслуги()
	
	Запрос = Новый Запрос;
	
	//ДИТ, Беляев СЮ, Ticket#0278994, 18-07-2022, начало (каждый раз, когда есть хоть одна строка на доп. услуги, спрашивать пользователя об объединении в один комплект)
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СделкаДоходы.Услуга КАК Услуга
	|ИЗ
	|	Документ.Сделка.Доходы КАК СделкаДоходы
	|ГДЕ
	|	СделкаДоходы.Ссылка = &Ссылка
	|	И НЕ СделкаДоходы.УслугаВнеСтавки
	|	И (НЕ СделкаДоходы.УчДокумент.Проведен
	|			ИЛИ СделкаДоходы.УчДокумент.Ссылка ЕСТЬ NULL)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СделкаДоходы.Услуга КАК Услуга
	|ИЗ
	|	Документ.Сделка.Доходы КАК СделкаДоходы
	|ГДЕ
	|	СделкаДоходы.Ссылка = &Ссылка
	|	И СделкаДоходы.УслугаВнеСтавки
	|	И НЕ СделкаДоходы.НеВыставлятьКлиенту
	|	И (НЕ СделкаДоходы.УчДокумент.Проведен
	|			ИЛИ СделкаДоходы.УчДокумент.Ссылка ЕСТЬ NULL)";
	//ДИТ, Беляев СЮ, Ticket#0278994, 18-07-2022, конец
	
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Пакеты = Запрос.ВыполнитьПакет();
	//Возврат Новый Структура("ОсновныеУслуги, ДополнительныеУслуги", НЕ Пакеты[1].Пустой(), НЕ Пакеты[2].Пустой());
	//ДИТ, Беляев СЮ, Ticket#0278994, 18-07-2022, начало
	Возврат Новый Структура("ОсновныеУслуги, ДополнительныеУслуги", НЕ Пакеты[0].Пустой(), НЕ Пакеты[1].Пустой());
	//ДИТ, Беляев СЮ, Ticket#0278994, 18-07-2022, конец
КонецФункции

&НаКлиенте
Процедура ОбработкаОтветаНаВопросДопУслуги(РезультатВопроса, ДопПараметры) Экспорт
	Если РезультатВопроса = "Отмена" Тогда
		Возврат;
	КонецЕсли; 
	СоздатьКомплектДокументовНаКлиенте(РезультатВопроса);
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКомплектДокументовНаКлиенте(РежимВыставленияДокументовСДопУслугами = "ЕдиныйКомплект")
	
	// мы проверяем, что период разрешает выставление документов
	Отказ = Ложь;
