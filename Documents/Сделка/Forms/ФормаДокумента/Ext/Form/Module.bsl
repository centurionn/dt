// Этот обработчик вызывается при нажатии на состояния на панели состояний
// Ссылка на него устанавливается кодом, поэтому при проверке конфигурации 1с может сказать, что эта функция не испольузется
// Не верьте 1с!
&НаКлиенте
Процедура ОбработчикНажатияПлитокСостояния(П1 = неопределено, П2 = неопределено) Экспорт
	
	// ДИТ 64186 Давудов М.А. Начало: 07.03.2023
	ОчиститьСообщения();
	
	СогласованиеБезМаршрута = Ложь;
	СтрокаСостоянияНайдена = Ложь;
	i = -1; // Индекс строки состояний
	
	Если ТипЗнч(П1) = Тип("ДекорацияФормы") Тогда
		
		ТекущийПользователь = ПолучитьТекущегоПользователя();
		ЕстьПравоДелегировать = ПроверкаПраваДелегированияЗадачБезМаршрута(ТекущийПользователь);
		ЕстьПравоСогласовывать = Ложь;
		Исполнитель = ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка");
		
		ИмяЭлемента = П1.Имя;
		Родитель = П1.Родитель;
		
		Для Каждого ПодчиненныйЭлемент Из Родитель.ПодчиненныеЭлементы Цикл
			i = i + 1;
			Если ИмяЭлемента = ПодчиненныйЭлемент.Имя Тогда
				СтрокаСостоянияНайдена = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если СтрокаСостоянияНайдена Тогда
			СтрокаСостояния = Объект.Состояния[i];
			Если (СтрокаСостояния.Исполнитель = ТекущийПользователь ИЛИ ЕстьПравоДелегировать)
			   И СтрокаСостояния.ПредыдущиеЭтапы = "999"
			   И (СтрокаСостояния.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.ВРаботе")
					ИЛИ СтрокаСостояния.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение")) Тогда
				
				Если СтрокаСостояния.Исполнитель = ТекущийПользователь Тогда
					ЕстьПравоСогласовывать = Истина;
				КонецЕсли;
				
				Если Не ЭтоЗадачаПоГотовностиКомплектаДокументов(СтрокаСостояния.Состояние) Тогда
					ЕстьПравоДелегировать = Ложь;
				КонецЕсли;
				
				Если ЕстьПравоСогласовывать
				 ИЛИ ЕстьПравоДелегировать Тогда
					СогласованиеБезМаршрута = Истина;
				КонецЕсли;
				
				Исполнитель = СтрокаСостояния.Исполнитель;
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если СогласованиеБезМаршрута Тогда
		
		Отказ = Ложь;
		
		Если Модифицированность Тогда
			ТекстСообщений = НСтр("ru = 'Перед согласованием необходимо провести документ'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщений,,,, Отказ);
		ИначеЕсли НЕ Объект.Проведен Тогда
			ТекстСообщений = НСтр("ru = 'Перед согласованием необходимо провести документ'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщений,,,, Отказ);
		КонецЕсли;
		
		Если НЕ Отказ Тогда
			ПараметрыОповещения = Новый Структура;
			ПараметрыОповещения.Вставить("ИндексСтроки", i);
			Оповещение = Новый ОписаниеОповещения("СогласованиеБезМаршрутаЗавершение", ЭтотОбъект, ПараметрыОповещения);
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ТекстСостояния", П1.Заголовок);
			ПараметрыФормы.Вставить("Исполнитель", Исполнитель);
			ПараметрыФормы.Вставить("ЕстьПравоСогласовывать", ЕстьПравоСогласовывать);
			ПараметрыФормы.Вставить("ЕстьПравоДелегировать", ЕстьПравоДелегировать);
			ОткрытьФорму("Документ.Сделка.Форма.ФормаСогласования", ПараметрыФормы, ЭтотОбъект,,,, Оповещение);
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	// ДИТ 64186 Давудов М.А. Конец: 07.03.2023
	
	МаршрутизацияКлиент.ОбработчикНажатияНаПлиткуОбщий(П1, П2);
КонецПроцедуры

