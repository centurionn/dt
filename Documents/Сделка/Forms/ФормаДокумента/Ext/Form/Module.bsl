		СтруктураСтроки.СчетПокупателю = СтрокаСУЕ.СчетЖД;
		МассивСтрок.Добавить(СтруктураСтроки);
	КонецЦикла; 
	АдресХранилища = ПоместитьВоВременноеХранилище(МассивСтрок,Адрес);
