&НаСервереБезКонтекста
Функция ПолучитьМассивВозможныхЗадачДелегирования()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Состояния.Ссылка КАК Состояние
		|ИЗ
		|	Справочник.Состояния КАК Состояния
		|ГДЕ
		|	Состояния.Ссылка В ИЕРАРХИИ(&ГруппаЗадачаСсылка)
		|	И НЕ Состояния.ЭтоГруппа";
	Запрос.УстановитьПараметр("ГруппаЗадачаСсылка", Справочники.Состояния.ЗадачиДелегирования);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Состояние");
КонецФункции   
//ДИТ, Беляев СЮ, US 37052, 23-08-2022, конец

&НаКлиенте
Процедура ПослеВводаПримечания(Примечание, ДопПараметры) Экспорт
	
	Если Примечание = "" Тогда
		ПоказатьПредупреждение(,"Для делегирования задачи поле ""Примечание"" обязательно к заполнению!");
		Возврат;
	КонецЕсли;
	
	МассивИспользованныхСостояний = Новый Массив;
	Для Каждого ТекСостояние ИЗ Объект.Состояния Цикл
		МассивИспользованныхСостояний.Добавить(ТекСостояние.Состояние);	
	КонецЦикла;
	
	ИмеющаясяЗадачаИсполнителя = ДопПараметры.ИмеющаясяЗадачаИсполнителя;
	ТекущийПользователь = ПользователиКлиент.ТекущийПользователь();   
	
	Если ИмеющаясяЗадачаИсполнителя = Неопределено Тогда 
		ТекСтрокаПоЗадаче = Объект.Состояния.Добавить();
		ТекСтрокаПоЗадаче.Состояние = ВыдатьСвободноеСостояниеУчета_ДелегированноеСогласование(МассивИспользованныхСостояний);
		ТекСтрокаПоЗадаче.Исполнитель = ДопПараметры.ОтветственныйЗаУчет; 
	Иначе
		Отбор = Новый Структура("Состояние", ИмеющаясяЗадачаИсполнителя);
		ТекСтрокаПоЗадаче = Объект.Состояния.НайтиСтроки(Отбор)[0];		
	КонецЕсли; 
	ТекСтрокаПоЗадаче.Наблюдатель = ТекущийПользователь;
	ТекСтрокаПоЗадаче.Клиент = ДопПараметры.Клиент;
	ТекСтрокаПоЗадаче.Договор = ДопПараметры.Договор;
	ТекСтрокаПоЗадаче.Комментарий = СтрШаблон("%1; %2; %3; %4; %5", ТекущийПользователь,ДопПараметры.Клиент,ДопПараметры.Договор,ДопПараметры.Протокол,Примечание);
	ТекСтрокаПоЗадаче.НачалоРаботы = ТекущаяДата();		
	ТекСтрокаПоЗадаче.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение");

	//СНЯТИЕ ГАЛОК "ГотовоКВыставлению", на которых есть задача по созданию комплекта документов и не сформированы документы
	Отбор = Новый Структура("ЗадачаГотовностиКВыставлению, СформированыЗакрывающиеДокументы", ДопПараметры.ЗадачаГотовностиКВыставлению, Ложь);
	МассивСтрокДляСнятияГалок = Объект.СвязьУчетныхЕдиниц.НайтиСтроки(Отбор);
	Для Каждого Строка Из МассивСтрокДляСнятияГалок Цикл
		Строка.ГотовоКВыставлению = Ложь;
		//Евросиб(ДИТ), Беляев СЮ, BUG 92270 / TA 92454, 08-10-2024, начало
		ДобавитьОтключитьАвтоустановкуГотовоКВыставлениюВНастройки(Строка.ГУИД, "Делегирование задачи");
		//Евросиб(ДИТ), Беляев СЮ, BUG 92270 / TA 92454, 08-10-2024, конец
	КонецЦикла;   
		
	ОбновитьПанельСостояний();	
	Модифицированность = Истина;
	
КонецПроцедуры

//Евросиб(ДИТ), Беляев СЮ, BUG 92270 / TA 92454, 08-10-2024, начало
&НаКлиенте
Процедура ДобавитьОтключитьАвтоустановкуГотовоКВыставлениюВНастройки(вхГУИД, вхКомментарий = "")
	
	НайденныеСтроки = Объект.НастройкиСтрокСоставаПоезда.НайтиСтроки(Новый Структура("ГУИД", вхГУИД));
	Если НайденныеСтроки.Количество() = 0 Тогда
		НоваяСтрокаНастроек = Объект.НастройкиСтрокСоставаПоезда.Добавить();
		НоваяСтрокаНастроек.ГУИД = вхГУИД;
	Иначе
		НоваяСтрокаНастроек = НайденныеСтроки[0];
	КонецЕсли;
	НоваяСтрокаНастроек.ОтключитьАвтоустановкуГотовоКВыставлению = Истина;
	НоваяСтрокаНастроек.Пользователь = ПользователиКлиент.ТекущийПользователь();
	НоваяСтрокаНастроек.Комментарий = вхКомментарий;
	
КонецПроцедуры
