&НаСервере
Процедура НайтиПодсылыНаСервере()
	
	МассивРейсЖД = Новый Массив;
	Для Каждого Стр Из Объект.Рейсы Цикл
		МассивРейсЖД.Добавить(Стр.Рейс);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Операция.Ссылка КАК Операция,
		|	Операция.Услуга КАК Услуга,
		|	Операция.СписокТС КАК СписокТС,
		|	Операция.СписокТЕ КАК СписокТЕ,
		|	Операция.ПунктОтправления КАК ПунктОтправления,
		|	Операция.ПунктНазначения КАК ПунктНазначения,
		|	Операция.Срок КАК Срок,
		|	Операция.ТипДлительности КАК ТипДлительности,
		|	Операция.ДатаОтправления КАК ДатаОтправления,
		|	Операция.ДатаНазначения КАК ДатаНазначения,
		|	Операция.Поставщик КАК Поставщик,
		|	Операция.Договор КАК Договор,
		|	Операция.Себестоимость КАК Себестоимость,
		|	Операция.Валюта КАК Валюта,
		|	Операция.СтавкаНДС КАК СтавкаНДС,
		|	Операция.ВключаетНДС КАК ВключаетНДС,
		|	Операция.ДатаОтправленияФакт КАК ДатаОтправленияФакт,
		|	Операция.ДатаНазначенияФакт КАК ДатаНазначенияФакт,
		|	Операция.Тариф КАК Тариф,
		|	Операция.Регламентный КАК Регламентный
		|ИЗ
		|	Документ.Операция КАК Операция
		|ГДЕ
		|	Операция.РейсЖД В(&РейсЖД)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Операция.ДатаОтправления";
	
	Запрос.УстановитьПараметр("РейсЖД", МассивРейсЖД);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Подсылы = Новый Массив;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл

		ПослРодители.Очистить();
		ТекД = Дерево.ПолучитьЭлементы().Добавить();
		ТекД.Регламентный = Истина;
		ТекД.Картинка = 0;
		ТекД.СвязьВх = 9;
		ТекД.СвязьИсх = 9;
		ТекД.ГУИД = Строка(Новый УникальныйИдентификатор);
		ТекД.ТипДлительности = ПредопределенноеЗначение("Перечисление.ЕдиницаИзмеренияДлительности.КалендарныйДень");
		ТекД.Валюта = Объект.Валюта;
		ЗаполнитьЗначенияСвойств(ТекД,ВыборкаДетальныеЗаписи);
		НСтр = ТЧ.Добавить();
		ЗаполнитьЗначенияСвойств(НСтр, ТекД);
	КонецЦикла;
	
КонецПроцедуры

