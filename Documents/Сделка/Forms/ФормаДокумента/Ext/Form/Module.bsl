&НаКлиенте
Процедура ПовторнаяМаршрутизация(Команда)
	
	ОплатаПоОригиналу = ПолучитьОплатуПоОригиналу();
	
	Если Объект.Маршрутизировать Тогда
		ПараметрыЗапроса = Новый Соответствие;
		ПараметрыЗапроса.Вставить("Организация", Объект.Организация);
		ПараметрыЗапроса.Вставить("МаршрутизируемыйОбъект", Объект.Ссылка);
		ПараметрыЗапроса.Вставить("ОплатаПоОригиналу", ОплатаПоОригиналу);
		ПараметрыЗапроса.Вставить("ПодсылПорожних", Объект.ПодсылПорожних);
		ПараметрыЗапроса.Вставить("ПовагонныеОтправки", Объект.ПовагонныеОтправки);
		ПараметрыЗапроса.Вставить("ОтветственныйПоСделке", "НЕТ");
		 //Евросиб Фролов (12.04.2022 Task №46871
		ПараметрыЗапроса.Вставить("СлужебнаяСделка", Объект.Служебная);
		// Евросиб Фролов)

		РезультатЗапроса = МаршрутизацияСервер.МаршрутизироватьСделку(ПараметрыЗапроса, Объект.Дата);

		Если РезультатЗапроса.Количество() > 0 Тогда
			Отказ = ПроверитьУказатьОтветственных(РезультатЗапроса, Ложь);
		Иначе
			Сообщить("Для документа не найден подходящий маршрут. Изменения не внесены!");
		КонецЕсли;
		
		ОбновитьПанельСостояний();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьОплатуПоОригиналу()
	
	ОплатаПоОригиналу = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВремТЧ.Клиент КАК Клиент,
	               |	ВремТЧ.Договор КАК Договор,
	               |	""ЭтаСделка"" КАК Ссылка
	               |ПОМЕСТИТЬ ВТ
	               |ИЗ
	               |	&ВремТЧ КАК ВремТЧ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МАКСИМУМ(ВТ.Договор.ОплатаПоОригиналу) КАК ОплатаПоОригиналу,
	               |	ВТ.Ссылка КАК Ссылка
	               |ИЗ
	               |	ВТ КАК ВТ
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ.Ссылка";
	Запрос.УстановитьПараметр("ВремТЧ",Объект.СвязьУчетныхЕдиниц.Выгрузить());
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		ОплатаПоОригиналу = Ответ.ОплатаПоОригиналу;
