&НаСервереБезКонтекста
Функция ВыдатьСвободноеСостояниеУчета_ДелегированноеСогласование(МассивИспользованных)
	
	Для Сч = 2 по 10 Цикл		
		
		СостУчета = Справочники.Состояния["ДелегированноеСогласование"+Сч];	
		Если МассивИспользованных.Найти(СостУчета) = Неопределено Тогда
			МассивИспользованных.Добавить(СостУчета);
			Возврат СостУчета;
		КонецЕсли;
		
	КонецЦикла;	
	Возврат Неопределено;
	
КонецФункции 
