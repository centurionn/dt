	|				ИЛИ ВТ_Периоды_ВО_Расш.ВидСтавки = ЗНАЧЕНИЕ(Перечисление.ФрахтФинДокументы_ВидСтавки.КомплекснаяСтавкаНесколькимиСтроками)
	|			ТОГДА ВТ_Периоды_ВО_Расш.Коносамент
	|		ИНАЧЕ ЗНАЧЕНИЕ(Документ.ТранспортныйДокумент.ПустаяСсылка)
	|	КОНЕЦ,
	|	ВТ_Периоды_ВО_Расш.ГруппироватьСтрокиПоРазличнымПСЦ
	//Евросиб(ДИТ), Беляев СЮ, US 88163/TA 88167, 26-07-2024, начало
	|	,ВТ_Периоды_ВО_Расш.ИдентификаторГруппировки";
	//Евросиб(ДИТ), Беляев СЮ, US 88163/TA 88167, 26-07-2024, конец
	Если НЕ РежимВыставленияДокументовСДопУслугами = "ЕдиныйКомплект" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"ЛОЖЬ КАК УслугаВнеСтавки", "СделкаДоходы.УслугаВнеСтавки");
	КонецЕсли;
	
	Если ТаблицаДоходов.Колонки.Найти("Коносамент") = Неопределено Тогда
		ТаблицаДоходов.Колонки.Добавить("Коносамент", Новый ОписаниеТипов("ДокументСсылка.ТранспортныйДокумент"));
	КонецЕсли;
	Если ТаблицаДоходов.Колонки.Найти("ГУИД") = Неопределено Тогда
		ТаблицаДоходов.Колонки.Добавить("ГУИД", ОбщегоНазначения.ОписаниеТипаСтрока(36));
	КонецЕсли; 
	Запрос.УстановитьПараметр("Доходы", ТаблицаДоходов);
	Запрос.УстановитьПараметр("ДокументФФД", ?(ПараметрыФФД = Неопределено, Неопределено, ПараметрыФФД.Документ));
	ТаблицаДоходов = Запрос.Выполнить().Выгрузить();

