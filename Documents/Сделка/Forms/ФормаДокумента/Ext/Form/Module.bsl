																	Стр.ГотовоКВыставлению, 
																	Стр.ДокументыСформированы, 
																	((Объект.КомуСтавитсяЗадачаПоДокументам = 0 И ТекПользователь = Объект.ЕдиныйОтветственныйОтУчета) ИЛИ (Объект.КомуСтавитсяЗадачаПоДокументам = 1 И ТекПользователь = Стр.ОтветственныйЗаУчет))));
		//ДИТ, Беляев СЮ, Ticket#0270072, 26-04-2022, конец										
