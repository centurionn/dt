	ВыборкаПСЦ = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПСЦ.Следующий() Цикл
	
		ВыборкаДетальныеЗаписи = ВыборкаПСЦ.Выбрать();
		
		// заявку нужно создать одну. устанавливаем флаг, что заявка уже создана
		ЗаявкаСоздана = Ложь;
		НоваяЗаявка = Неопределено;
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если НЕ ЗаявкаСоздана Тогда
				НоваяЗаявка = ВыборкаДетальныеЗаписи.Заявка.Скопировать();
				НоваяЗаявка.Дата = ВыборкаДетальныеЗаписи.Заявка.Дата;
				ЗаявкаСоздана = Истина;
				ТЧЗаявка = НоваяЗаявка.СоставУслуги;
				ТЧЗаявка.Очистить();
			КонецЕсли;
			
			Если НЕ НоваяЗаявка = Неопределено Тогда
				
				НовСтр = ТЧЗаявка.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр,ВыборкаДетальныеЗаписи);

				// очистить рейсы
				НоваяЗаявка.ПереченьРейсов.Очистить();
				//сбросить маршрутизацию
				НоваяЗаявка.Состояния.Очистить();
				// записать,чтобы получить ссылку, но не проводить. провести только после проведения старой заявки
				НоваяЗаявка.Записать(РежимЗаписиДокумента.Запись);
				НоваяСсылка = НоваяЗаявка.Ссылка;
				
