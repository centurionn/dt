&НаСервере
Процедура УстановитьУсловноеОформление()
	
	//Евросиб Каблов 12.12.2023 ( Ticket#0329972
	//Элементы.СвязьУчетныхЕдиницОтключитьРасходы.Видимость = ПользовательСПолнымиПравами;
	Элементы.СвязьУчетныхЕдиницОтключитьРасходы.ТолькоПросмотр = Не ПользовательСПолнымиПравами;
	//Евросиб Каблов 12.12.2023 )
	
	// Евросиб Фролов (17.02.2022 Task №45918 
	// Для администратора разрешить изменять данные в составе поезда независимо от наличия закрывающих документов.
	Если ПользовательСПолнымиПравами Тогда
		Возврат;	
	КонецЕсли;		
	// Евросиб Фролов)
	
	УО = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = УО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.СвязьУчетныхЕдиниц.ДокументыВыставлены");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Истина;
	ЭлементОтбора.Использование = Истина;	
	
	ПоляИсключения = Новый Массив;
	ПоляИсключения.Добавить("СвязьУчетныхЕдиницДоплата_Клиент");
	ПоляИсключения.Добавить("СвязьУчетныхЕдиницДоплата_Договор");
	ПоляИсключения.Добавить("СвязьУчетныхЕдиницДоплата_ПСЦ");
	ПоляИсключения.Добавить("СвязьУчетныхЕдиницДоплата_Калькуляция");
	ПоляИсключения.Добавить("СвязьУчетныхЕдиницДоплата_Доплата");
	ПоляИсключения.Добавить("СвязьУчетныхЕдиницДоплата_Валюта");
	// ДИТ 64186 Давудов М.А. Начало: 07.03.2023
	Если ПараметрыСеанса.ТекущийПользователь = Объект.Автор
	// ДИТ 70325 Давудов М.А. Начало: 23.05.2023
	 ИЛИ РольДоступна("dc_УстановкаПризнакаПодтверждающиеДокументы") Тогда
	// ДИТ 70325 Давудов М.А. Конец: 23.05.2023
		ПоляИсключения.Добавить("СвязьУчетныхЕдиницПодтверждающиеДокументы");
	КонецЕсли;
	// ДИТ 64186 Давудов М.А. Конец: 07.03.2023
	Для каждого ПолеДанных Из Элементы.СвязьУчетныхЕдиниц.ПодчиненныеЭлементы Цикл
		Если ПоляИсключения.Найти(ПолеДанных.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли; 
		ПолеУО = УО.Поля.Элементы.Добавить();
		ПолеУО.Использование = Истина;
		ПолеУО.Поле = Новый ПолеКомпоновкиДанных(ПолеДанных.Имя);
	КонецЦикла; 
	
	УО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	// Евросиб Фролов (14.10.2021 Ticket№ 40390
	// Если сформированы закрывающие документы по КТК
	// (заполнено поле "Уч. документ", РТУ проведена, не аннулирована и не помечена на удаление),
	// то должен быть реализован запрет на изменение любых данных на вкладке «Состав поезда» по этим КТК.
	// Галку "Готово к выставлению" не устанавилваем в "Только просмотр", т.к. при ее отмене необходимо выдать предупреждение пользователю.
	ПоляИсключенияПриЗакрывающихДокументах = Новый Массив;
	ПоляИсключенияПриЗакрывающихДокументах.Добавить("СвязьУчетныхЕдиницГотовоКВыставлению");
	// Евросиб Фролов (21.04.2022 Task №49961
	ПоляИсключенияПриЗакрывающихДокументах.Добавить("СвязьУчетныхЕдиницГотовоКВыставлениюФрахт");
	// Евросиб Фролов)
	//Евросиб(ДИТ), Беляев СЮ, BUG 92553 / TA 93124, 10-12-2024, начало
	ПоляИсключенияПриЗакрывающихДокументах.Добавить("СвязьУчетныхЕдиницДатаВыдачиГрузаКлиенту");
	//Евросиб(ДИТ), Беляев СЮ, BUG 92553 / TA 93124, 10-12-2024, конец
	// ДИТ 64186 Давудов М.А. Начало: 07.03.2023
	Если ПараметрыСеанса.ТекущийПользователь = Объект.Автор
	// ДИТ 70325 Давудов М.А. Начало: 23.05.2023
	 ИЛИ РольДоступна("dc_УстановкаПризнакаПодтверждающиеДокументы") Тогда
	// ДИТ 70325 Давудов М.А. Конец: 23.05.2023
		ПоляИсключенияПриЗакрывающихДокументах.Добавить("СвязьУчетныхЕдиницПодтверждающиеДокументы");
	КонецЕсли;
	// ДИТ 64186 Давудов М.А. Конец: 07.03.2023
	
	Элемент = УсловноеОформление.Элементы.Добавить();

	Для Каждого ПолеДанных Из Элементы.СвязьУчетныхЕдиниц.ПодчиненныеЭлементы Цикл
		Если ПоляИсключенияПриЗакрывающихДокументах.Найти(ПолеДанных.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ПолеДанных.Имя);
	КонецЦикла;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.СвязьУчетныхЕдиниц.СформированыЗакрывающиеДокументы");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	// Евросиб Фролов)
	
	//Евросиб(ДИТ), Беляев СЮ, US 11365 / TA 114152, 31-07-2025, начало
	УстановитьУсловноеОформлениеПоКорректировкамВР();
	//Евросиб(ДИТ), Беляев СЮ, US 11365 / TA 114152, 31-07-2025, конец
		
КонецПроцедуры

