&НаКлиенте
Процедура СвязьУчетныхЕдиницЗаявкаОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		ТекущиеДанные = Элементы.СвязьУчетныхЕдиниц.ТекущиеДанные;
		ЗаявкаПроведена = ОбщегоНазначенияВызовСервера.ЗначениеРеквизитаОбъекта(ВыбранноеЗначение, "Проведен");
		Если не ЗаявкаПроведена Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				"" + ВыбранноеЗначение + " не проведена. Проведите заявку для добавления в документ.",
				,   
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СвязьУчетныхЕдиниц", ТекущиеДанные.НомерСтроки, "Заявка"),
				"Объект",
				СтандартнаяОбработка);   
			ВыбранноеЗначение = ТекущиеДанные.Заявка;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры         

