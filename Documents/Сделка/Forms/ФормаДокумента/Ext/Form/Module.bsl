		//СоответствиеДоговораИПараметров.Вставить(Стр.Договор, Новый Структура("ГотовоКВыставлению, ДокументыСформированы, ДокументыДляМеня", Стр.ГотовоКВыставлению, Стр.ДокументыСформированы, ((Объект.КомуСтавитсяЗадачаПоДокументам = 0 И ТекПользователь = Объект.ЕдиныйОтветственныйОтУчета) ИЛИ (Объект.КомуСтавитсяЗадачаПоДокументам = 1 И ТекПользователь = ПолучитьОтветственногоЗаУчет(Стр.Договор)))));
