		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|ГДЕ
		|	РеализацияТоваровУслуг.Ссылка В(&Ссылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ОтчетКомитентуОПродажах.Выставлен КАК Выставлен,
		|	ОтчетКомитентуОПродажах.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ОтчетКомитентуОПродажах КАК ОтчетКомитентуОПродажах
		|ГДЕ
		|	ОтчетКомитентуОПродажах.Ссылка В(&Ссылка)";
	
	Запрос.УстановитьПараметр("Ссылка", мУчДок);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		сОтвет = Новый Структура("УчДок,Признак",Неопределено,Ложь);
		сОтвет.Вставить("УчДок",ВыборкаДетальныеЗаписи.Ссылка);
		сОтвет.Вставить("Признак",ВыборкаДетальныеЗаписи.Выставлен);
		мОтвет.Добавить(сОтвет);
	КонецЦикла;
	
	Возврат мОтвет;
	
КонецФункции	

