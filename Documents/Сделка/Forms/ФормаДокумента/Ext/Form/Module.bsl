	Записать();
	//ДИТ Шевченко А.В. 16.09.2022 55882 -начало
	ОткрытьФорму("Обработка.АРМНакладные.Форма",,,ЭтаФорма.УникальныйИдентификатор);
	//ДИТ Шевченко А.В. 16.09.2022 55882 -конец
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьРейсВЗаявки(Команда)
	
	РейсЪ = неопределено;
	Для каждого Стр из Объект.Рейсы Цикл
		Если ТипЗнч(Стр.Рейс) = Тип("СправочникСсылка.РейсыЖД") Тогда РейсЪ = Стр.Рейс; КонецЕсли;
	КонецЦикла;
	Если РейсЪ = неопределено Тогда Возврат; КонецЕсли;
	
	СписокЗаявок = Новый Массив;
	Для каждого Стр из Объект.СвязьУчетныхЕдиниц Цикл
		
		Если СписокЗаявок.Найти(Стр.Заявка) = неопределено Тогда СписокЗаявок.Добавить(Стр.Заявка); КонецЕсли;
		
	КонецЦикла;
	
	ЗаписатьРейсВЗаявки_сервер(СписокЗаявок, РейсЪ);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаписатьРейсВЗаявки_сервер(СписокЗаявок, РейсЪ)
	
	Для каждого Заявка из СписокЗаявок Цикл
		
		ЗаявкаО = Заявка.ПолучитьОбъект();
		ЗаявкаО.НеПроверятьВидСобственностиКТК = Истина;
		Если ЗаявкаО.ПереченьРейсов.НайтиСтроки(Новый Структура("Рейс", РейсЪ)).Количество() = 0 Тогда
			
			НСтр = ЗаявкаО.ПереченьРейсов.Добавить();
			НСтр.Рейс = РейсЪ;
			НСтр.Продукт = РейсЪ.Продукт;
			Попытка
				ЗаявкаО.Записать(?(ЗаявкаО.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
			Исключение
				ОО = ОписаниеОшибки();
				Сообщить("Ошибка: " + ОО);
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Процедура ПФ_ОтправкаОперативныйПриказ(Команда)
	
	Если ЭтаФорма.Модифицированность Тогда
		Сообщить("Требуется запись документа!");
		Возврат;
	КонецЕсли; 
	
	Документ = ПФ_ОтправкаОперативныйПриказНаСервере(Объект.Ссылка);
	
	Если Документ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторПечатнойФормы = "КонсолидированнаяИнформацияПоСделке";
	НазваниеПечатнойФормы = НСтр("ru = 'Консолидированная информация по сделке'");
	
	Если Не ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.Печать") Тогда
		Документ.Показать(НазваниеПечатнойФормы);
		Возврат;
	КонецЕсли;
	
	МодульУправлениеПечатьюКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("УправлениеПечатьюКлиент");
	
	КоллекцияПечатныхФорм = МодульУправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм(ИдентификаторПечатнойФормы);
	ПечатнаяФорма = МодульУправлениеПечатьюКлиент.ОписаниеПечатнойФормы(КоллекцияПечатныхФорм, ИдентификаторПечатнойФормы);
	ПечатнаяФорма.СинонимМакета = НазваниеПечатнойФормы;
	ПечатнаяФорма.ТабличныйДокумент = Документ;
	ПечатнаяФорма.ИмяФайлаПечатнойФормы = НазваниеПечатнойФормы;
	
	ОбластиОбъектов = Новый СписокЗначений;
	МодульУправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм, ОбластиОбъектов);
	
КонецПроцедуры

