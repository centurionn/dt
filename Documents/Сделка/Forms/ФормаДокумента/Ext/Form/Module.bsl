	// Евросиб Фролов (15.04.2022 Task №48577
	// Все операции по исключению КТК выполняем в одной транзакции
	// чтобы в случае ошибки отменились все созданные документы.
	НачатьТранзакцию();
	Попытка
		ИсключениеВыполненоУспешно = Истина;
		//Евросиб Коханенко Н.А. 03.07.2024 (( #83866
		//ВыполнитьИсключениеКТКИзСделки(ЦелеваяЗаявка, ИсключениеВыполненоУспешно);
		ВыполнитьИсключениеКТКИзСделки(ЦелеваяЗаявка, ИсключениеВыполненоУспешно, КоличествоСвязанныхЗапросов);
		//Евросиб Коханенко Н.А. 03.07.2024 )) #83866
		
		Если ИсключениеВыполненоУспешно Тогда
			// Если исключение выполнено, то можно установить признак "НеАктивна".
			ИзменитьПризнакАктивностиСтрокиСоставаПоезда(Истина);
			
			ЭтаФорма.Записать();
			
			ЗафиксироватьТранзакцию();
		Иначе
			ОтменитьТранзакцию();
			// Если исключение не выполнено, то признак "НеАктивна" нужно снять.
			ИзменитьПризнакАктивностиСтрокиСоставаПоезда(Ложь);
		КонецЕсли;
	Исключение
		ОтменитьТранзакцию();
		
		// Если исключение не выполнено, то признак "НеАктивна" нужно снять.
		ИзменитьПризнакАктивностиСтрокиСоставаПоезда(Ложь);
		
		ЗаписьЖурналаРегистрации("Перенос КТК в новую сделку",
							УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.Сделка, Объект.Ссылка, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
							
		ТекстСообщения = СтрШаблон("Не удалось выполнить перенос КТК в другую сделку. Ошибка: %1",
													КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));				
		ИсключениеВыполненоУспешно = Ложь;
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецПопытки;
	// Евросиб Фролов)
	
