&НаКлиенте
Процедура ОбработкаПодбораСверхнорматива(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 <> неопределено Тогда
		Для Каждого Элем Из Параметр1 Цикл
			МассивДанных = ОбработкаПодбораСверхнормативаСервер(Объект.Ссылка,Элем.Контейнер);
			// Доходы
			НовСтр1 = Объект.Доходы.Добавить();			
			ЗаполнитьЗначенияСвойств(НовСтр1,Элем);  
			//ДИТ, Беляев СЮ, ТА48688, 28-03-2022, начало 
			НовСтр1.ДатаПоявленияСтрокиЭкономики = ТекущаяДата();
			//ДИТ, Беляев СЮ, ТА48688, 28-03-2022, конец
			НовСтр1.СписокКТК = Строка(Элем.Контейнер);
			НовСтр1.ТипКТК = МассивДанных.ТипТЕ;
			НовСтр1.РазмерКТК = МассивДанных.РазмерКТК;
			НовСтр1.Сверхнорматив = Истина;
			НовСтр1.Перевыставляемая = Истина;
			НовСтр1.ГУИД = Новый УникальныйИдентификатор;
			НовСтр1.Валюта = Объект.Валюта;
			НовСтр1.Себестоимость = МассивДанных.СуммаКлиенту;
			НовСтр1.Количество = НовСтр1.ДнейПросрочки;
			НовСтр1.СебестоимостьИтого = НовСтр1.Себестоимость*НовСтр1.Количество;
			НовСтр1.НоменклатурнаяГруппа = РазнесениеЗатратСервер.ПодобратьНоменклатурнуюГруппуПоНаборуПараметров(Объект.ТипЗаказа, Элем.Вагон);
			НовСтр1.Количество = НовСтр1.ДнейПросрочки;
			//Евросиб Каблов 09.04.2025 ( #105407
			//НовСтр1.ПериодВО = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериод(Объект.Организация);
			НовСтр1.ПериодВО = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериодДоходов(Объект.Организация);
			//Евросиб Каблов 09.04.2025 )
			НовСтр1.Услуга = УслугаКТКПоСНП;
			
			// Расходы
			НовСтр2 = Объект.Расходы.Добавить();
			НовСтр2.Регламентный = Истина;
			ЗаполнитьЗначенияСвойств(НовСтр2,Элем,,"Договор");
			НовСтр2.СписокКТК = Строка(Элем.Контейнер);
			НовСтр2.ТипКТК = МассивДанных.ТипТЕ;
			НовСтр2.Сверхнорматив = Истина;
			НовСтр2.ГУИД = Новый УникальныйИдентификатор;
			НовСтр2.Поставщик = МассивДанных.ВладелецКТК;
			НовСтр2.Себестоимость = МассивДанных.Сумма;
			НовСтр2.Количество = НовСтр2.ДнейПросрочки;
			НовСтр2.СебестоимостьИтого = НовСтр2.Себестоимость*НовСтр2.Количество;
			НовСтр2.Валюта = Объект.Валюта;
			НовСтр2.Перевыставляемая = Истина;
			НовСтр2.ПериодВО = НовСтр1.ПериодВО;
			НовСтр2.Услуга = УслугаКТКПоСНП;
			
			// Связь доходы-расходы
			НовСтр3 = Объект.СвязьДоходовИРасходов.Добавить();
			НовСтр3.Доходы = НовСтр1.ГУИД; 
			НовСтр3.Расходы = НовСтр2.ГУИД;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОбработкаПодбораСверхнормативаСервер(ТекСделка,ТекКТК)
	
	ДанныеДляРасходов = Новый Структура;
	
	// необходимо получить типТЕ, владельца КТК и тариф сверхнормативного использования из заявки->стока контейнеров->ПСЦ
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СделкаЗаявки.Заявка.Контрагент КАК ВладелецКТК,
	               |	ЗаявкаСоставУслуги.НомерКТК КАК Контейнер,
	               |	ЕСТЬNULL(СтокКонтейнеровКонтейнеры.ПСЦ.НевозвратКонтейнераСуммаНеустойкиВСутки, 0) КАК НевозвратКонтейнераСуммаНеустойкиВСутки,
	               |	ЗаявкаСоставУслуги.НомерКТК.ТипТЕ КАК ТипТЕ,
	               |	ЕСТЬNULL(ЗаявкаСоставУслуги.Ссылка.ПСЦ.НевозвратКонтейнераСуммаНеустойкиВСутки, 0) КАК СуммаНеустойкиВСуткиКлиенту
	               |ИЗ
	               |	Документ.Сделка.Заявки КАК СделкаЗаявки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Документ.СтокКонтейнеров.Контейнеры КАК СтокКонтейнеровКонтейнеры
	               |			ПО ЗаявкаСоставУслуги.НомерКТК = СтокКонтейнеровКонтейнеры.Контейнер
	               |				И ЗаявкаСоставУслуги.ДатаВыдачи = СтокКонтейнеровКонтейнеры.ДатаВзятияИзСтока
	               |		ПО СделкаЗаявки.Заявка = ЗаявкаСоставУслуги.Ссылка
	               |ГДЕ
	               |	СделкаЗаявки.Ссылка = &Ссылка
	               |	И ЗаявкаСоставУслуги.НомерКТК = &НомерКТК
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НевозвратКонтейнераСуммаНеустойкиВСутки УБЫВ";
	Запрос.УстановитьПараметр("Ссылка",ТекСделка);
	Запрос.УстановитьПараметр("НомерКТК",ТекКТК);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Если ТЗ.Количество()>0 Тогда
		ДанныеДляРасходов.Вставить("ТипТЕ",ТЗ[0].ТипТЕ);
		ДанныеДляРасходов.Вставить("ВладелецКТК",ТЗ[0].ВладелецКТК);
		ДанныеДляРасходов.Вставить("Сумма",ТЗ[0].НевозвратКонтейнераСуммаНеустойкиВСутки);
		ДанныеДляРасходов.Вставить("СуммаКлиенту",ТЗ[0].СуммаНеустойкиВСуткиКлиенту);
		ДанныеДляРасходов.Вставить("РазмерКТК",ТЗ[0].ТипТЕ.РазмерКТК);
	Иначе
		ДанныеДляРасходов.Вставить("ТипТЕ",Справочники.ТипоразмерыТЕ.ПустаяСсылка());
		ДанныеДляРасходов.Вставить("ВладелецКТК",Справочники.Контрагенты.ПустаяСсылка());
		ДанныеДляРасходов.Вставить("Сумма",0);
		ДанныеДляРасходов.Вставить("СуммаКлиенту",0);
		ДанныеДляРасходов.Вставить("РазмерКТК",Справочники.РазмерыКТК.ПустаяСсылка());
	КонецЕсли;	
	
	Возврат ДанныеДляРасходов;
	
КонецФункции

