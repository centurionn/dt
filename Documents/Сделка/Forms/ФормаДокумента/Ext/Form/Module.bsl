	массивИсточниковПриоритетПередРасходамиИзАкцепта = Новый Массив;
	массивИсточниковПриоритетПередРасходамиИзАкцепта.Добавить(Перечисления.ИсточникПоявленияСтрокиЭкономики.ПеремещениеКТК); 
	//если имеются расходы с ПеремещениеКТК и ДобавленоИзАкцепта, то по ним ОбъединениеСделок не проверяем, их не отвязать в таком случае
	массивИсточниковПриоритетПередРасходамиОбъединениеСделок = Новый Массив;
	массивИсточниковПриоритетПередРасходамиОбъединениеСделок.Добавить(Перечисления.ИсточникПоявленияСтрокиЭкономики.ДобавленоИзАкцепта);
	массивИсточниковПриоритетПередРасходамиОбъединениеСделок.Добавить(Перечисления.ИсточникПоявленияСтрокиЭкономики.ПеремещениеКТК);
	//если по строкам СформированыЗакрывающиеДокументы, то по ним не проверям возможность перезаполнения
	ОтборСформированыЗакрывающиеДокументы = Новый Структура("СформированыЗакрывающиеДокументы",Истина);
	МассивГУИДСформированыЗакрывающиеДокументы = Объект.СвязьУчетныхЕдиниц.Выгрузить(ОтборСформированыЗакрывающиеДокументы,"ГУИД").ВыгрузитьКолонку("ГУИД");
	Запрос.УстановитьПараметр("ИсточникПоявленияСтрокиЭкономики_ДобавленоИзАкцепта", Перечисления.ИсточникПоявленияСтрокиЭкономики.ДобавленоИзАкцепта);
	Запрос.УстановитьПараметр("ИсточникПоявленияСтрокиЭкономики_ОбъединениеПорожнейИГруженойСделок", Перечисления.ИсточникПоявленияСтрокиЭкономики.ОбъединениеПорожнейИГруженойСделок);
    Запрос.УстановитьПараметр("ИсточникиПриоритетПередРасходамиИзАкцепта", массивИсточниковПриоритетПередРасходамиИзАкцепта);  
	Запрос.УстановитьПараметр("ИсточникиПриоритетПередРасходамиОбъединениеСделок", массивИсточниковПриоритетПередРасходамиОбъединениеСделок);    
	Запрос.УстановитьПараметр("МассивГУИДСформированыЗакрывающиеДокументы", МассивГУИДСформированыЗакрывающиеДокументы);    
	РезультатЗапросаПакет = Запрос.ВыполнитьПакет();
	РезультатЗапроса = РезультатЗапросаПакет[1];    
	СтруктураДанныеПоЗапрещеннымДляПересчета.МассивДобавленоИзАкцепта = РезультатЗапросаПакет[2].Выгрузить().ВыгрузитьКолонку("СтрокаСвязьУчетныхЕдиниц");	  
	СтруктураДанныеПоЗапрещеннымДляПересчета.МассивОбъединениеПорожнейИГруженойСделок = РезультатЗапросаПакет[3].Выгрузить().ВыгрузитьКолонку("СтрокаСвязьУчетныхЕдиниц"); 
	//ДИТ, Беляев СЮ, ТА54910, 19-07-2022, конец
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	//Субботин 74397 04.09.2023 начало
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВремТЧ.Контейнер КАК Контейнер,
		|	ВремТЧ.Коносамент КАК Коносамент,
		|	ВремТЧ.МорскойРейс КАК МорскойРейс,
		|	ВремТЧ.ГУИДСтрокиЗаявки КАК ГУИДСтрокиЗаявки
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ВремТЧ КАК ВремТЧ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаявкаСоставУслуги.НомерКТК КАК НомерКТК,
		|	ЗаявкаСоставУслуги.Ссылка КАК Заявка,
		|	ЗаявкаСоставУслуги.ГУИДСтроки КАК ГУИДСтроки,
		|	ЗаявкаСоставУслуги.Коносамент КАК Коносамент
		|ПОМЕСТИТЬ ДанныеЗаявки
		|ИЗ
		|	Документ.Сделка.Заявки КАК СделкаЗаявки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
		|		ПО СделкаЗаявки.Заявка = ЗаявкаСоставУслуги.Ссылка
		|ГДЕ
		|	СделкаЗаявки.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ Различные
		//|	ВТ.Контейнер КАК Контейнер,
		//|	ВТ.Коносамент КАК Коносамент,
		//|	ВТ.МорскойРейс КАК МорскойРейс,
		|	ДанныеЗаявки.Заявка КАК Заявка
		//|	ДанныеЗаявки.ГУИДСтроки КАК ГУИДСтроки
		|ИЗ
		|	ВТ КАК ВТ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДанныеЗаявки КАК ДанныеЗаявки
		|		ПО ВТ.ГУИДСтрокиЗаявки = ДанныеЗаявки.ГУИДСтроки
		|			И ВТ.Коносамент <> ДанныеЗаявки.Коносамент";
	
	Запрос.УстановитьПараметр("ВремТЧ", Объект.Ссылка.СвязьУчетныхЕдиниц);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапроса.Следующий() Цикл 
		 ОтложенноеИзменениеСервер.ПоставитьЗаявкуВОчередьИзменения(РезультатЗапроса.Заявка, Объект.Ссылка);
	КонецЦикла;		
		
КонецПроцедуры
