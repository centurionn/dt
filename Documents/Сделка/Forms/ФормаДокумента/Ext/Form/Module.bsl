&НаСервереБезКонтекста
Процедура ПривязатьАвансовыеСчетаКНовойЗаявке(Запрос, НоваяЗаявка, Сделка)
	
	ТекстЗапроса =
	"ВЫБРАТЬ

	|	ВТ.Заявка КАК Заявка,

	|	ВТ.Контейнер КАК Контейнер,

	|	ЗаявкаСоставУслуги.Коносамент КАК Коносамент

	|ПОМЕСТИТЬ втЗаявки

	|ИЗ

	|	ВТ КАК ВТ

	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги

	|		ПО ВТ.Заявка = ЗаявкаСоставУслуги.Ссылка

	|			И ВТ.ГУИДСтрокиЗаявки = ЗаявкаСоставУслуги.ГУИДСтроки

	|;

	|

	|////////////////////////////////////////////////////////////////////////////////

	|ВЫБРАТЬ

	|	втЗаявки.Заявка КАК Заявка,

	|	втЗаявки.Контейнер КАК Контейнер,

	|	втЗаявки.Коносамент КАК Коносамент,

	|	СчетНаОплатуПокупателюДокументыОснования.Ссылка КАК Ссылка,

	|	СчетНаОплатуПокупателюТовары.Содержание КАК Содержание

	|ПОМЕСТИТЬ втСчета

	|ИЗ

	|	втЗаявки КАК втЗаявки

	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетНаОплатуПокупателю.ДокументыОснования КАК СчетНаОплатуПокупателюДокументыОснования

	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетНаОплатуПокупателю.Товары КАК СчетНаОплатуПокупателюТовары

	|			ПО СчетНаОплатуПокупателюДокументыОснования.Ссылка = СчетНаОплатуПокупателюТовары.Ссылка

	|		ПО втЗаявки.Заявка = СчетНаОплатуПокупателюДокументыОснования.Документ

	|			И (СчетНаОплатуПокупателюДокументыОснования.Ссылка.Проведен)

	|			И (СчетНаОплатуПокупателюДокументыОснования.Ссылка.АвансовыйСчет)

	|;

	|

	|////////////////////////////////////////////////////////////////////////////////

	|ВЫБРАТЬ РАЗЛИЧНЫЕ

	|	втСчета.Ссылка КАК СчетНаОплату,

	|	втСчета.Коносамент КАК Коносамент

	|ИЗ

	|	втСчета КАК втСчета

	|ГДЕ

	|	втСчета.Содержание ПОДОБНО ""%"" + втСчета.Контейнер.Наименование + ""%""

	|ИТОГИ ПО

	|	СчетНаОплату";
	
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаСчетов = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСчетов.Следующий() Цикл
		СчетОбъект = ВыборкаСчетов.СчетНаОплату.ПолучитьОбъект();
		
		ЗаписыватьСчет = Ложь;
		
		ВыборкаКоносамент = ВыборкаСчетов.Выбрать();
		Пока ВыборкаКоносамент.Следующий() Цикл
			
			НайденныеСтроки = СчетОбъект.ДокументыОснования.НайтиСтроки(Новый Структура("Документ, Сделка, Коносамент", НоваяЗаявка.Ссылка, Сделка, ВыборкаКоносамент.Коносамент)); 
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ДокументОснование = СчетОбъект.ДокументыОснования.Добавить();
			ДокументОснование.Документ = НоваяЗаявка.Ссылка;
			ДокументОснование.Сделка = Сделка;
			ДокументОснование.Коносамент = ВыборкаКоносамент.Коносамент;
			ЗаписыватьСчет = Истина;
		КонецЦикла;
		
		Если ЗаписыватьСчет Тогда
			СчетОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры	
// Евросиб Фролов)

&НаКлиенте
Процедура ОбъединитьСПорожнимиСделками(Команда)
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбъединитьСПорожними", ЭтотОбъект, Параметры);
	ПоказатьВопрос(Оповещение, "Будет выполнено объединение с порожними сделками. Продолжить?", Режим, 0);		
КонецПроцедуры    

&НаКлиенте
Процедура ПослеЗакрытияВопросаОбъединитьСПорожними(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
    КонецЕсли;
	
    РезультатВыполнения = ОбъединитьСПорожнимиСделкамиНаСервере();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ТекстСообщения = "Выполняется объединение сделок.
										|Это может занять продолжительное время.";
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбъединениеСделокЗавершение", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

&НаСервере
Функция ОбъединитьСПорожнимиСделкамиНаСервере()
	
	Если РезультатВыполнения <> Неопределено
		И ЗначениеЗаполнено(РезультатВыполнения.ИдентификаторЗадания) Тогда
		ДлительныеОперации.ОтменитьВыполнениеЗадания(РезультатВыполнения.ИдентификаторЗадания);
	КонецЕсли;
		
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение = 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Объединение груженых и порожних сделок'");
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	РезультатВыполнения = ДлительныеОперации.ВыполнитьВФоне("Документы.Сделка.ОбъединитьПорожниеИГруженыеСделки",
		Документы.Сделка.ПолучитьСписокПорожнихГруженыхСделокДляОбъединения(Новый Структура("Сделка", Объект.Ссылка)), ПараметрыВыполнения);
	
	Если РезультатВыполнения.Статус = "Ошибка" Тогда
		ВызватьИсключение РезультатВыполнения.КраткоеПредставлениеОшибки;
	КонецЕсли;
	
	Возврат РезультатВыполнения;
	
КонецФункции

&НаКлиенте
Процедура ОбъединениеСделокЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		СтруктураРезультата = ПолучитьИзВременногоХранилища(РезультатВыполнения.АдресРезультата);
		Если СтруктураРезультата.ЕстьРезультат = Истина Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Операция объединения выполнена. Список объединенных сделок:");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтруктураРезультата.СписокСделок); 
			ЭтаФорма.Прочитать();
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтруктураРезультата.РезультатОбъединения);
		КонецЕсли;
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		ВызватьИсключение Результат.КраткоеПредставлениеОшибки;
	КонецЕсли;
	
КонецПроцедуры

