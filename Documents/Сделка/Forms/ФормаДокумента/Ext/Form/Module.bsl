&НаСервере
Процедура ПоискЖДННомерныеКТК(СписокКТК)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтейнерыВОтправке.Отправка КАК Отправка,
	               |	КонтейнерыВОтправке.Контейнер КАК Контейнер,
	               |	КонтейнерыВОтправке.Отправка.ДатаОтправления КАК ДатаОтправления,
	               |	ДОБАВИТЬКДАТЕ(КонтейнерыВОтправке.Отправка.ДатаПрибытия, ДЕНЬ, 30) КАК ДатаПрибытия
	               |ПОМЕСТИТЬ СписокКТК
	               |ИЗ
	               |	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтейнерыВОтправке КАК КонтейнерыВОтправке
	               |		ПО СделкаСвязьУчетныхЕдиниц.Контейнер = КонтейнерыВОтправке.Контейнер
	               |ГДЕ
	               |	СделкаСвязьУчетныхЕдиниц.Ссылка = &Ссылка
	               |	И НЕ СделкаСвязьУчетныхЕдиниц.Контейнер = """"
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МИНИМУМ(СписокКТК.ДатаОтправления) КАК ДатаОтправления,
	               |	МАКСИМУМ(СписокКТК.ДатаПрибытия) КАК ДатаПрибытия,
	               |	СписокКТК.Контейнер КАК Контейнер
	               |ПОМЕСТИТЬ ДатыПоРейсу
	               |ИЗ
	               |	СписокКТК КАК СписокКТК
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СписокКТК.Контейнер
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ДатыПоРейсу.Контейнер КАК Контейнер,
	               |	МИНИМУМ(ДислокацияКонтейнеров.Период) КАК Период
	               |ПОМЕСТИТЬ НомераЖДН
	               |ИЗ
	               |	ДатыПоРейсу КАК ДатыПоРейсу
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДислокацияКонтейнеров КАК ДислокацияКонтейнеров
	               |		ПО ДатыПоРейсу.Контейнер = ДислокацияКонтейнеров.Контейнер
	               |			И (ДислокацияКонтейнеров.Период >= ДатыПоРейсу.ДатаОтправления)
	               |			И (ДислокацияКонтейнеров.Период <= ДатыПоРейсу.ДатаПрибытия)
	               |			И (ДислокацияКонтейнеров.ВесГруза > 0)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ДатыПоРейсу.Контейнер
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДислокацияКонтейнеровСрезПоследних.Контейнер КАК Контейнер,
	               |	ДислокацияКонтейнеровСрезПоследних.НомерНакладной КАК ЖДН,
	               |	ДислокацияКонтейнеровСрезПоследних.Вагон КАК Вагон
	               |ПОМЕСТИТЬ НомерНакладнойРС
	               |ИЗ
	               |	РегистрСведений.ДислокацияКонтейнеров.СрезПоследних(
	               |			,
	               |			(Период, Контейнер) В
	               |				(ВЫБРАТЬ
	               |					НомераЖДН.Период,
	               |					НомераЖДН.Контейнер
	               |				ИЗ
	               |					НомераЖДН КАК НомераЖДН)) КАК ДислокацияКонтейнеровСрезПоследних
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НомерНакладнойРС.Контейнер КАК Контейнер,
	               |	НомерНакладнойРС.ЖДН КАК ЖДН,
	               |	НомерНакладнойРС.Вагон КАК Вагон,
	               |	э_Накладная.ДатаИВремяОтправленияГруза КАК ДатаИВремяОтправленияГруза,
	               |	ДОБАВИТЬКДАТЕ(э_Накладная.ДатаИВремяОтправленияГруза, ДЕНЬ, -20) КАК МинимальнаяДатаПорожняка,
	               |	э_Накладная.Ссылка КАК СсылкаЖДН
	               |ПОМЕСТИТЬ ДанныеПоНакладной
	               |ИЗ
	               |	НомерНакладнойРС КАК НомерНакладнойРС
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.э_Накладная КАК э_Накладная
	               |		ПО НомерНакладнойРС.ЖДН = э_Накладная.Номер
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МАКСИМУМ(э_НакладнаяВагоны.Ссылка.ДатаИВремяПрибытияГруза) КАК ДатаИВремяПрибытияГруза,
	               |	э_НакладнаяВагоны.НомерВагона КАК НомерВагона
	               |ПОМЕСТИТЬ ДанныеПоВагНакладной
	               |ИЗ
	               |	ДанныеПоНакладной КАК ДанныеПоНакладной
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.э_Накладная.Вагоны КАК э_НакладнаяВагоны
	               |		ПО ДанныеПоНакладной.Вагон.Наименование = э_НакладнаяВагоны.НомерВагона
	               |			И (э_НакладнаяВагоны.Ссылка.ДатаИВремяПрибытияГруза МЕЖДУ ДанныеПоНакладной.МинимальнаяДатаПорожняка И ДанныеПоНакладной.ДатаИВремяОтправленияГруза)
	               |			И (НЕ э_НакладнаяВагоны.Ссылка.ДатаИВремяПрибытияГруза = ДАТАВРЕМЯ(1,1,1,0,0,0))
	               |			И (э_НакладнаяВагоны.МассыВКгНетто = 0)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	э_НакладнаяВагоны.НомерВагона
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	э_НакладнаяВагоны.Ссылка.НакладнаяНомер КАК НомерВагоннойЖДН,
	               |	ДанныеПоНакладной.Контейнер КАК Контейнер,
	               |	ДанныеПоНакладной.ЖДН КАК НомерЖДН,
	               |	ДанныеПоНакладной.Вагон КАК Вагон,
	               |	э_НакладнаяВагоны.Ссылка КАК Ссылка,
	               |	ТранспортныйДокумент.Ссылка КАК ЖДН
	               |ИЗ
	               |	ДанныеПоНакладной КАК ДанныеПоНакладной
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеПоВагНакладной КАК ДанныеПоВагНакладной
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Документ.э_Накладная.Вагоны КАК э_НакладнаяВагоны
	               |			ПО ДанныеПоВагНакладной.НомерВагона = э_НакладнаяВагоны.НомерВагона
	               |				И ДанныеПоВагНакладной.ДатаИВремяПрибытияГруза = э_НакладнаяВагоны.Ссылка.ДатаИВремяПрибытияГруза
	               |		ПО ДанныеПоНакладной.Вагон.Наименование = ДанныеПоВагНакладной.НомерВагона
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	               |		ПО ДанныеПоНакладной.СсылкаЖДН = ТранспортныйДокумент.НакладнаяЭТРАН
	               |			И (НЕ ТранспортныйДокумент.ПометкаУдаления)";
	Запрос.УстановитьПараметр("Ссылка",Объект.Ссылка);
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Стр Из Объект.СвязьУчетныхЕдиниц Цикл
		Если ЗначениеЗаполнено(Стр.Контейнер) Тогда
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Контейнер",Стр.Контейнер);
			НайденныеСтроки = ТЗ.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество()>0 Тогда
				ЗаполнитьЗначенияСвойств(Стр, НайденныеСтроки[0]);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоискЖДН(Команда)
	// массив с номерами КТК
	МассивКТК = Новый Массив;
	Для Каждого Стр Из Объект.СвязьУчетныхЕдиниц Цикл
		Если ЗначениеЗаполнено(Стр.Контейнер) Тогда
			МассивКТК.Добавить(Стр.Контейнер);
		КонецЕсли;
	КонецЦикла;
	
	// сначала обрабатываем КТК с номерами
	ПоискЖДННомерныеКТК(МассивКТК);
	
	// iwans.fix.(28.02.2020): для контейнеров, по которым нет слежения, надо искать через ЭТРАН
	Для каждого стр из Объект.СвязьУчетныхЕдиниц Цикл
		
		Если ЗначениеЗаполнено(Стр.Контейнер) И НЕ ЗначениеЗаполнено(Стр.Вагон) Тогда
			
			СтруктураРезультата = НайтиЖДНпоЭТРАН(Стр.Контейнер);
			Если ЗначениеЗаполнено(СтруктураРезультата.ЖДН) Тогда
				ЗаполнитьЗначенияСвойств(Стр, СтруктураРезультата);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// получаем таблицу без номеров КТК
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Контейнер", ПредопределенноеЗначение("Справочник.ТЕ.ПустаяСсылка"));
	НайденныеСтроки = Объект.СвязьУчетныхЕдиниц.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество()>0 тогда
		ОпОп = Новый ОписаниеОповещения("ОбработкаПодбораЖДН", Этаформа);
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Сделка", Объект.Ссылка);
		ОткрытьФорму("Документ.Сделка.Форма.ФормаПодборЖДН",ПараметрыОтбора,, ЭтаФорма.УникальныйИдентификатор, ,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;	
	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиЖДНпоЭТРАН(Контейнер)
	
	Результат = Новый Структура("НомерЖДН, Вагон, ЖДН, НомерВагоннойЖДН, НомерПорожнейЖДНКТК,НомерПорожнейВагоннойЖДН", неопределено, неопределено, неопределено, неопределено, неопределено);
	
	ЗапросСовсемПорожнего = Новый Запрос;
	ЗапросСовсемПорожнего.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	                        |	э_НакладнаяВагоны.Ссылка КАК ПорожняяНакладная,
	                        |	э_НакладнаяВагоны.Ссылка.Номер КАК Номер
	                        |ИЗ
	                        |	Документ.э_Накладная.Вагоны КАК э_НакладнаяВагоны
	                        |ГДЕ
	                        |	э_НакладнаяВагоны.НомерВагона = &НомерВагона
	                        |	И НЕ э_НакладнаяВагоны.Ссылка.ПометкаУдаления
	                        |	И НЕ э_НакладнаяВагоны.Ссылка.ДатаИВремяПрибытияГруза = ДАТАВРЕМЯ(1,1,1,0,0,0)
	                        |	И э_НакладнаяВагоны.Ссылка.ДатаИВремяПрибытияГруза МЕЖДУ &ДатаНач И &ДатаКон
	                        |
	                        |УПОРЯДОЧИТЬ ПО
	                        |	э_НакладнаяВагоны.Ссылка.ДатаИВремяПрибытияГруза УБЫВ";
	
	ЗапросПорожнего = Новый Запрос;
	ЗапросПорожнего.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	                        |	э_НакладнаяВагоны.Ссылка КАК ПорожняяНакладная,
	                        |	э_НакладнаяВагоны.Ссылка.Номер КАК Номер,
	                        |	э_НакладнаяВагоны.Ссылка.ДатаИВремяОтправленияГруза КАК ДатаИВремяОтправленияГруза
	                        |ИЗ
	                        |	Документ.э_Накладная.Вагоны КАК э_НакладнаяВагоны
	                        |ГДЕ
	                        |	э_НакладнаяВагоны.НомерВагона = &НомерВагона
	                        |	И НЕ э_НакладнаяВагоны.Ссылка.ПометкаУдаления
	                        |	И НЕ э_НакладнаяВагоны.Ссылка.ДатаИВремяПрибытияГруза = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	                        |	И э_НакладнаяВагоны.Ссылка.ДатаИВремяПрибытияГруза МЕЖДУ &ДатаНач И &ДатаКон
	                        |
	                        |УПОРЯДОЧИТЬ ПО
	                        |	э_НакладнаяВагоны.Ссылка.ДатаИВремяПрибытияГруза УБЫВ";
	
	ЗапросПорожнегоКТК = Новый Запрос;
	ЗапросПорожнегоКТК.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	                        |	э_НакладнаяКонтейнеры.Ссылка КАК ПорожняяНакладная,
	                        |	э_НакладнаяКонтейнеры.Ссылка.Номер КАК Номер
	                        |ИЗ
	                        |	Документ.э_Накладная.Контейнеры КАК э_НакладнаяКонтейнеры
	                        |ГДЕ
	                        |	э_НакладнаяКонтейнеры.НомерКонтейнера = &НомерКонтейнера
	                        |	И НЕ э_НакладнаяКонтейнеры.Ссылка.ПометкаУдаления
	                        |	И НЕ э_НакладнаяКонтейнеры.Ссылка.ДатаИВремяПрибытияГруза = ДАТАВРЕМЯ(1,1,1,0,0,0)
	                        |	И э_НакладнаяКонтейнеры.Ссылка.ДатаИВремяПрибытияГруза МЕЖДУ &ДатаНач И &ДатаКон
	                        |
	                        |УПОРЯДОЧИТЬ ПО
	                        |	э_НакладнаяКонтейнеры.Ссылка.ДатаИВремяПрибытияГруза УБЫВ";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	э_НакладнаяВагоны.НомерВагона КАК Вагон,
	               |	э_НакладнаяКонтейнеры.Ссылка.Номер КАК НомерЖДН,
	               |	э_НакладнаяКонтейнеры.Ссылка КАК ЖДН_Этран,
	               |	ТС.Ссылка КАК ВагонСсылка,
	               |	ТранспортныйДокумент.Ссылка КАК ЖДН,
	               |	э_НакладнаяВагоны.Ссылка.ДатаИВремяОтправленияГруза КАК ДатаИВремяОтправленияГруза
	               |ИЗ
	               |	Документ.э_Накладная.Контейнеры КАК э_НакладнаяКонтейнеры
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.э_Накладная.Вагоны КАК э_НакладнаяВагоны
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТС КАК ТС
	               |			ПО э_НакладнаяВагоны.НомерВагона = ТС.Наименование
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	               |			ПО (ТранспортныйДокумент.НакладнаяЭТРАН = э_НакладнаяВагоны.Ссылка)
	               |		ПО э_НакладнаяКонтейнеры.Ссылка = э_НакладнаяВагоны.Ссылка
	               |			И э_НакладнаяКонтейнеры.НомерВагонаДляКонтейнерногоПоезда = э_НакладнаяВагоны.ПорядковыйНомерВагонаВОтправке
	               |ГДЕ
	               |	э_НакладнаяКонтейнеры.НомерКонтейнера ПОДОБНО &НомерКонтейнера
	               |	И НЕ э_НакладнаяКонтейнеры.Ссылка.ПометкаУдаления
	               |	И э_НакладнаяКонтейнеры.Ссылка.ТекущееСостояниеНакладной.КатегорияДокументов <> ""Не действительны""
	               |	И НЕ ТранспортныйДокумент.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	э_НакладнаяКонтейнеры.Ссылка.Дата УБЫВ";
	Запрос.УстановитьПараметр("НомерКонтейнера", Строка(Контейнер));
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Ответ);
		Результат.Вагон = Ответ.ВагонСсылка;
		
		ЗапросПорожнего.УстановитьПараметр("НомерВагона", Ответ.Вагон);
		ЗапросПорожнего.УстановитьПараметр("ДатаНач", Ответ.ДатаИВремяОтправленияГруза-20*3600*24);
		ЗапросПорожнего.УстановитьПараметр("ДатаКон", Ответ.ДатаИВремяОтправленияГруза);
		ОтветПорожнего = ЗапросПорожнего.Выполнить().Выбрать();
		Если ОтветПорожнего.Следующий() Тогда
			
			Результат.НомерВагоннойЖДН = ОтветПорожнего.Номер;
			
			// заполнение параметров на запрос порожней накладной на вагон до подсыла КТК	
			ЗапросСовсемПорожнего.УстановитьПараметр("НомерВагона", Ответ.Вагон);
			ЗапросСовсемПорожнего.УстановитьПараметр("ДатаНач", ОтветПорожнего.ДатаИВремяОтправленияГруза-20*3600*24);
			ЗапросСовсемПорожнего.УстановитьПараметр("ДатаКон", ОтветПорожнего.ДатаИВремяОтправленияГруза);
			ОтветСовсемПорожнего = ЗапросСовсемПорожнего.Выполнить().Выбрать();
			Если ОтветСовсемПорожнего.Следующий() Тогда
				
				Результат.НомерПорожнейВагоннойЖДН = ОтветСовсемПорожнего.Номер;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ЗапросПорожнегоКТК.УстановитьПараметр("НомерКонтейнера", Строка(Контейнер));
		ЗапросПорожнегоКТК.УстановитьПараметр("ДатаНач", Ответ.ДатаИВремяОтправленияГруза-20*3600*24);
		ЗапросПорожнегоКТК.УстановитьПараметр("ДатаКон", Ответ.ДатаИВремяОтправленияГруза);
		ОтветПорожнегоКТК = ЗапросПорожнегоКТК.Выполнить().Выбрать();
		Если ОтветПорожнегоКТК.Следующий() Тогда
			
			Результат.НомерПорожнейЖДНКТК = ОтветПорожнегоКТК.Номер;
			
		КонецЕсли;
		
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаПодбораЖДН(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 <> неопределено Тогда
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Контейнер", ПредопределенноеЗначение("Справочник.ТЕ.ПустаяСсылка"));
		НайденныеСтроки = Объект.СвязьУчетныхЕдиниц.НайтиСтроки(ПараметрыОтбора);
		// смотря где меньше данных (в тч сделки или в выбранном массиве актуальных ЖДН), берем меньшее значение по проходам циклов
		Для ШагЦикла = 0 По ?(НайденныеСтроки.Количество()<Параметр1.Количество(),НайденныеСтроки.Количество()-1,Параметр1.Количество()-1) Цикл
			ЗаполнитьЗначенияСвойств(НайденныеСтроки[ШагЦикла],Параметр1[ШагЦикла]);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрольПовторногоИспользования(Команда)
	
	ТекД = Элементы.Дерево.ТекущиеДанные;
	Если ТекД <> неопределено И ЗначениеЗаполнено(ТекД.Операция) Тогда
		
		МассивРейсов = новый Массив;
		МассивКТК = Новый Массив;
		МассивВагонов = Новый Массив;
		
		Для каждого Стр из Объект.Рейсы Цикл
			МассивРейсов.Добавить(Стр.Рейс);
		КонецЦикла;
		
		ОткрытьФорму("Документ.Сделка.Форма.КонтрольПовторногоИспользования", Новый Структура("МассивРейсов, Операция", МассивРейсов, ТекД.Операция));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЭкономическиеПоказатели(Команда)
	ОбновитьСуммыЭкономикиНаСервере();
	РассылкаПоПланФактВагонов.РассылкаПоПФВагонов();
КонецПроцедуры

&НаСервере
Процедура ОбновитьСуммыЭкономикиНаСервере()
	
	СтруктураПлановыхСумм = ДанныеПоКалькуляцииНаСервере();
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма,СтруктураПлановыхСумм);
	
	фактСебестоимость = Объект.Расходы.Итог("СебестоимостьИтого");
	фактВознаграждение = Объект.Расходы.Итог("ВознаграждениеИтого");
	фактСтоимость = Объект.Расходы.Итог("СуммаИтого");
	Если фактСтоимость > 0 Тогда
		фактРентабельность = фактВознаграждение/фактСтоимость*100;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ДанныеПоКалькуляцииНаСервере()
	
	планСебестоимостьЪ = 0;
	планВознаграждениеЪ = 0;
	планРентабельностьЪ = 0;
	планСтоимостьЪ = 0;
	
	ЗапросКалькуляций = Новый Массив;
	Для Каждого Стр Из Объект.СвязьУчетныхЕдиниц Цикл
		ЗапросКалькуляций.Добавить(Стр.Калькуляция);
	КонецЦикла;
	ОтветКалькуляций = ПолучитьСоответствиеПоказателейКалькуляций(ЗапросКалькуляций);
	//Евросиб Шевченко А.В. US 99262 TA 121126 09.10.202
	ДатаНачалаНовогоРасчетаВознаграждения = Константы.ДатаНачалаРасчетаВознагражденияПоНовойФормулеВКалькуляциях.Получить();
	//Евросиб Шевченко А.В. US 99262 TA 121126 09.10.202
	Для Каждого Стр Из Объект.СвязьУчетныхЕдиниц Цикл
		Если ОтветКалькуляций[Стр.Калькуляция] = неопределено Тогда Продолжить; КонецЕсли;
		Если Стр.РазмерКТК = ПредопределенноеЗначение("Справочник.РазмерыКТК.К20") Тогда
			планСебестоимостьЪ = планСебестоимостьЪ + ОтветКалькуляций[Стр.Калькуляция].ММ_ИтогоСебестоимость20;	
			//Если ОтветКалькуляций[Стр.Калькуляция].Дата > ДатаНачалаНовогоРасчетаВознаграждения Тогда
				//планВознаграждениеЪ = планВознаграждениеЪ + ОтветКалькуляций[Стр.Калькуляция].ММ_ИтогоВознаграждение20;
				планВознаграждениеЪ = планВознаграждениеЪ + ОтветКалькуляций[Стр.Калькуляция].РасчетнаяКонтрибуция20;
			//Иначе
				//планВознаграждениеЪ = планВознаграждениеЪ + ОтветКалькуляций[Стр.Калькуляция].ММ_ИтогоВознаграждение20;
			//КонецЕсли;
			//Евросиб Шевченко А.В. US 99262 TA 121126 09.10.202
			планСтоимостьЪ = планСтоимостьЪ + ОтветКалькуляций[Стр.Калькуляция].ММ_ИтогоСтавка20;
		Иначе
			планСебестоимостьЪ = планСебестоимостьЪ + ОтветКалькуляций[Стр.Калькуляция].ММ_ИтогоСебестоимость;
			//Евросиб Шевченко А.В. US 99262 TA 121126 09.10.202
			//планВознаграждениеЪ = планВознаграждениеЪ + ОтветКалькуляций[Стр.Калькуляция].ММ_ИтогоВознаграждение;
			//Если ОтветКалькуляций[Стр.Калькуляция].Дата > ДатаНачалаНовогоРасчетаВознаграждения Тогда
				планВознаграждениеЪ = планВознаграждениеЪ + ОтветКалькуляций[Стр.Калькуляция].РасчетнаяКонтрибуция40;
			//Иначе
			//	планВознаграждениеЪ = планВознаграждениеЪ + ОтветКалькуляций[Стр.Калькуляция].ММ_ИтогоВознаграждение;
			//КонецЕсли;
			//Евросиб Шевченко А.В. US 99262 TA 121126 09.10.202
			планСтоимостьЪ = планСтоимостьЪ + ОтветКалькуляций[Стр.Калькуляция].ММ_ИтогоСтавка;
		КонецЕсли;
	КонецЦикла;
	
	Если планСтоимостьЪ <> 0 Тогда
		планРентабельностьЪ = планВознаграждениеЪ/планСтоимостьЪ*100;
	КонецЕсли;
	
	СтруктураРезультата = Новый Структура;
	СтруктураРезультата.Вставить("планСебестоимость",планСебестоимостьЪ);
	СтруктураРезультата.Вставить("планВознаграждение",планВознаграждениеЪ);
	СтруктураРезультата.Вставить("планРентабельность",планРентабельностьЪ);
	СтруктураРезультата.Вставить("планСтоимость",планСтоимостьЪ);
	
	Возврат СтруктураРезультата;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСоответствиеПоказателейКалькуляций(СписокКалькуляций)
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Калькуляция.Ссылка КАК Ссылка,
	               |	Калькуляция.ММ_ИтогоВознаграждение20 КАК ММ_ИтогоВознаграждение20,
	               |	Калькуляция.ММ_ИтогоСебестоимость20 КАК ММ_ИтогоСебестоимость20,
	               |	Калькуляция.ММ_ИтогоСтавка20 КАК ММ_ИтогоСтавка20,
	               |	Калькуляция.ММ_ИтогоСтавка КАК ММ_ИтогоСтавка,
	               |	Калькуляция.ММ_ИтогоСебестоимость КАК ММ_ИтогоСебестоимость,
	               |	Калькуляция.ММ_ИтогоВознаграждение КАК ММ_ИтогоВознаграждение,
				   //Евросиб Шевченко А.В. US 99262 TA 121126 09.10.2025
	               |	ЕСТЬNULL(ЗначенияДополнительныхАналитикДокументовКонтрибуция20.Значение, 0) КАК РасчетнаяКонтрибуция20,
	               |	ЕСТЬNULL(ЗначенияДополнительныхАналитикДокументовКонтрибуция40.Значение, 0) КАК РасчетнаяКонтрибуция40,
				   |	Калькуляция.Дата КАК Дата
				   //Евросиб Шевченко А.В. US 99262 TA 121126 09.10.2025
	               |ИЗ
	               |	Документ.Калькуляция КАК Калькуляция
				   //Евросиб Шевченко А.В. US 99262 TA 121126 09.10.2025
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхАналитикДокументов КАК ЗначенияДополнительныхАналитикДокументовКонтрибуция20
	               |		ПО Калькуляция.Ссылка = ЗначенияДополнительныхАналитикДокументовКонтрибуция20.Документ
	               |			И (ЗначенияДополнительныхАналитикДокументовКонтрибуция20.Аналитика = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ДополнительныеАналитикиДокументов.РасчетнаяКонтрибуция20))
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхАналитикДокументов КАК ЗначенияДополнительныхАналитикДокументовКонтрибуция40
	               |		ПО Калькуляция.Ссылка = ЗначенияДополнительныхАналитикДокументовКонтрибуция40.Документ
	               |			И (ЗначенияДополнительныхАналитикДокументовКонтрибуция40.Аналитика = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ДополнительныеАналитикиДокументов.РасчетнаяКонтрибуция40))
				   //Евросиб Шевченко А.В. US 99262 TA 121126 09.10.2025
	               |ГДЕ
	               |	Калькуляция.Ссылка В(&Ссылка)";
	Запрос.УстановитьПараметр("Ссылка", СписокКалькуляций);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		НСтрук = Новый Структура("ММ_ИтогоВознаграждение20,ММ_ИтогоСебестоимость20,ММ_ИтогоСтавка20,ММ_ИтогоСтавка,ММ_ИтогоСебестоимость,ММ_ИтогоВознаграждение,РасчетнаяКонтрибуция20,РасчетнаяКонтрибуция40,Дата");
		ЗаполнитьЗначенияСвойств(НСтрук, Ответ);
		Результат.Вставить(Ответ.Ссылка, НСтрук);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура лев_СрокиПеревозки(Команда)
	ПроверкаСоблюденияСроков();
КонецПроцедуры

&НаСервере
Процедура ПроверкаСоблюденияСроков()
	
	// удаляем из таблицы только те данные, которые сейчас будем обновлять
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("СтатьяРасхождений","Несоблюдение сроков");
	НайденныеСтроки = ТЗРасхождений.НайтиСтроки(ПараметрыОтбора);
	Для Каждого Стр Из НайденныеСтроки Цикл
		ТЗРасхождений.Удалить(Стр);		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТехнологическаяСхемаТЧ.Родитель1 КАК Родитель1,
	               |	ТехнологическаяСхемаТЧ.Родитель2 КАК Родитель2,
	               |	ТехнологическаяСхемаТЧ.Родитель3 КАК Родитель3,
	               |	ТехнологическаяСхемаТЧ.Родитель4 КАК Родитель4,
	               |	ТехнологическаяСхемаТЧ.Родитель5 КАК Родитель5,
	               |	ТехнологическаяСхемаТЧ.Операция КАК Операция,
	               |	ТехнологическаяСхемаТЧ.ГУИД КАК ГУИД,
	               |	ВЫБОР
	               |		КОГДА ТехнологическаяСхемаТЧ.ДатаОтправленияФакт = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |			ТОГДА ТехнологическаяСхемаТЧ.ДатаОтправления
	               |		ИНАЧЕ ТехнологическаяСхемаТЧ.ДатаОтправленияФакт
	               |	КОНЕЦ КАК ДатаОтправления,
	               |	ВЫБОР
	               |		КОГДА ТехнологическаяСхемаТЧ.ДатаНазначенияФакт = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |			ТОГДА ТехнологическаяСхемаТЧ.ДатаНазначения
	               |		ИНАЧЕ ТехнологическаяСхемаТЧ.ДатаНазначенияФакт
	               |	КОНЕЦ КАК ДатаНазначения
	               |ИЗ
	               |	Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
	               |ГДЕ
	               |	ТехнологическаяСхемаТЧ.Операция.Сделка = &Сделка";
	Запрос.УстановитьПараметр("Сделка",Объект.Ссылка);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Для Каждого Стр иЗ ТЗ Цикл
		// получаем для каждой операции список ее КТК
		ТекОперТЧ = Стр.Операция.Грузы;
		МассивКТК = Новый Массив;
		Для Каждого СтрКТК Из ТекОперТЧ Цикл
			Если ЗначениеЗаполнено(СтрКТК.ТЕ) Тогда
				МассивКТК.Добавить(СтрКТК.ТЕ);
			КонецЕсли;
		КонецЦикла;
		
		ШагЦикла = 1;
		Пока ШагЦикла<5 Цикл
			Если ЗначениеЗаполнено(Стр["Родитель"+Строка(ШагЦикла)]) Тогда
				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("ГУИД",Стр["Родитель"+Строка(ШагЦикла)]);
				НайденныеСтроки = ТЗ.НайтиСтроки(ПараметрыОтбора);
				Если НайденныеСтроки.Количество()>0 Тогда
					ДатаОперацииНазнРодитель = ?(ЗначениеЗаполнено(НайденныеСтроки[0].Операция.ДатаНазначенияФакт),НайденныеСтроки[0].Операция.ДатаНазначенияФакт,НайденныеСтроки[0].Операция.ДатаНазначения);
					Если ДатаОперацииНазнРодитель > Стр.ДатаОтправления Тогда
						НовСтр = ТЗРасхождений.Добавить();
						НовСтр.СтатьяРасхождений = "Несоблюдение сроков";
						НовСтр.ОперацияРодитель = НайденныеСтроки[0].Операция;
						НовСтр.ОперацияПодчиненная = Стр.Операция;
						КТКОперацияПодчиненная = СтрСоединить(МассивКТК, ";");
						НовСтр.КТКОперацияПодчиненная = КТКОперацияПодчиненная;
						
						// для каждой родительской операции получаем список ее КТК
						ТекРодТЧ = НайденныеСтроки[0].Операция.Грузы;
						МассивРодКТК = Новый Массив;
						Для Каждого СтрРодКТК Из ТекРодТЧ Цикл
							Если ЗначениеЗаполнено(СтрРодКТК.ТЕ) Тогда
								МассивРодКТК.Добавить(СтрРодКТК.ТЕ);
							КонецЕсли;
						КонецЦикла;
						КТКОперацияРод = СтрСоединить(МассивРодКТК, ";");
						НовСтр.КТКОперацияРодитель = КТКОперацияРод;
						
						НовСтр.ДатаРодОперации = ДатаОперацииНазнРодитель;
						НовСтр.ДатаПодчОперации = Стр.ДатаОтправления;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			ШагЦикла = ШагЦикла + 1;
		КонецЦикла;
	КонецЦикла;
	
	КартинкаОшибки = БиблиотекаКартинок.СостоянияРасширенийОшибка;
	КартинкаВерно = БиблиотекаКартинок.СостоянияРасширенийПодключено;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("СтатьяРасхождений","Несоблюдение сроков");
	НайденныеСтр = ТЗРасхождений.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеСтр.Количество()>0 Тогда
		Элементы.прав_СрокиПеревозки.Картинка = КартинкаОшибки;
	Иначе
		Элементы.прав_СрокиПеревозки.Картинка = КартинкаВерно;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура прав_СрокиПеревозки(Команда)
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("СписокОтклонений",ТЗРасхождений);
	ПараметрыОтбора.Вставить("СтатьяРасхождений","Несоблюдение сроков");
	ОткрытьФорму("Документ.Сделка.Форма.ФормаРезультатовАвтодиагностики",ПараметрыОтбора,, ЭтаФорма.УникальныйИдентификатор, ,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
