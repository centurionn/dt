Процедура ПоказатьРасходыПоСтроке(Команда)
	ТекД = Элементы.СвязьУчетныхЕдиниц.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;               
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаЭкономикаСделки;
	Элементы.Расходы.ОтборСтрок = Новый ФиксированнаяСтруктура("СтрокаСвязьУчетныхЕдиниц", ТекД.ГУИД);
	Элементы.ОтборПоСтрокеСоставаПоезда.Заголовок = СтрШаблон("отключить отбор по СУЕ: %1",ТекД.ГУИД);
	Элементы.ОтборПоСтрокеСоставаПоезда.Видимость = Истина;
	Элементы.ГруппаРасходы.Показать();
	Элементы.ГруппаДоходы.Скрыть();
	
