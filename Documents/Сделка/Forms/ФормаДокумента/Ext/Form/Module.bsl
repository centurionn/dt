	Результат = Новый Структура("Доходы, Расходы, ДоходыКТК, СвязьДоходовИРасходов", Новый Массив, Новый Массив, Новый Массив, Новый Массив);
	
	Запрос = Новый Запрос;
	//Запрос.Текст = 
	
	
	Возврат Результат;
	
КонецФункции

