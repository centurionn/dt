&НаКлиенте
Процедура СоставПоезда_Делегировать(Команда)  
	
	ДопПараметры = Новый Структура; 

	ТекСтрока = Элементы.СвязьУчетныхЕдиниц.ТекущиеДанные;  
	
	Если ТекСтрока = Неопределено 
		Или Не ТекСтрока.ГотовоКВыставлению
		Или ТекСтрока.СформированыЗакрывающиеДокументы Тогда 
		ПоказатьПредупреждение(,"Доступно только для строк с установленным ""Готово к выставлению"" и не сформированными РТУ");
		Возврат;
	КонецЕсли;
	
	//ДопПараметры.Вставить("ИндСтроки",ТекСтрока.ПолучитьИдентификатор());
	ДопПараметры.Вставить("Клиент",ТекСтрока.Клиент);
	ДопПараметры.Вставить("Договор",ТекСтрока.Договор);
	ДопПараметры.Вставить("Протокол",ТекСтрока.Протокол);
	ДопПараметры.Вставить("ЗадачаГотовностиКВыставлению",ТекСтрока.ЗадачаГотовностиКВыставлению);
	ОпОп = Новый ОписаниеОповещения("ПослеВыбораСотрудникаДляПередачиЗадачи", ЭтаФорма,ДопПараметры); 
	ЗначениеОтбораПользователей = Новый Структура("Недействителен", Ложь);
	ПараметрыВыбораПользователей = Новый Структура(); 
	ПараметрыВыбораПользователей.Вставить("Отбор",ЗначениеОтбораПользователей);
	ОткрытьФорму("Справочник.Пользователи.Форма.ФормаВыбора",ПараметрыВыбораПользователей,,ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораСотрудникаДляПередачиЗадачи(ВыбранныйИсполнитель = Неопределено, ДопПараметры = Неопределено) Экспорт
	
	Если ВыбранныйИсполнитель = Неопределено Тогда 
		Возврат; 
	КонецЕсли;		
	
	ИмеющаясяЗадачаИсполнителя = Неопределено;  
	ИмеющюесяПримечание = ""; 
	ИмеющаясяЗадачаВыполнена = Ложь;
	МассивВозможныхЗадачДелегирования = ПолучитьМассивВозможныхЗадачДелегирования();
	
	Отбор = Новый Структура("Исполнитель", ВыбранныйИсполнитель);
	ЗадачиПоВыбранномуИсполнителю = Объект.Состояния.НайтиСтроки(Отбор);
	Для Каждого ТекЗадача ИЗ ЗадачиПоВыбранномуИсполнителю Цикл    
		Если МассивВозможныхЗадачДелегирования.Найти(ТекЗадача.Состояние) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ИмеющаясяЗадачаИсполнителя = ТекЗадача.Состояние; 
		ИмеющюесяПримечание = ТекЗадача.Комментарий; 
		Если ТекЗадача.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Выполнен") Тогда
			ИмеющаясяЗадачаВыполнена = Истина;
		КонецЕсли;
		Прервать;
	КонецЦикла;	                                         
	
	ДопПараметры.Вставить("ОтветственныйЗаУчет", ВыбранныйИсполнитель);	
	ДопПараметры.Вставить("ИмеющаясяЗадачаИсполнителя", ИмеющаясяЗадачаИсполнителя);
	
	Если (ИмеющаясяЗадачаИсполнителя = Неопределено) ИЛИ (ИмеющаясяЗадачаВыполнена) Тогда
		ПоказатьДиалогВводаПримечания(ДопПараметры); 
	Иначе 
		ОповещениеПослеВопроса = Новый ОписаниеОповещения("ПослеВопросаОРедактированииЗадачиДелегирования", ЭтотОбъект, ДопПараметры);
		ТекстВопроса = "У "+ВыбранныйИсполнитель+" уже есть задача:
						|
						|"+ИмеющюесяПримечание+"
						|
						|Изменить содержание задачи?";
		ПоказатьВопрос(ОповещениеПослеВопроса, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;;
	
КонецПроцедуры  

