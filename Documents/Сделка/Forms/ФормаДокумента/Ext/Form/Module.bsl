&НаСервереБезКонтекста
Функция ПроверкаНаправления(УчДокумент)
	
	СтруктураОтвета = Новый Структура;
	Для Каждого СТр Из УчДокумент.РасшифровкаУслугПоТС Цикл
		// если в структуре уже есть какие-то записи, то проверить их совпадение. 
		// если не совпало, прекращаем цикл - в реализации разные направления
		Если СтруктураОтвета.Свойство("Отправление") Тогда
			Если НЕ СтруктураОтвета.Отправление = Стр.ПунктОтправления ИЛИ
				НЕ СтруктураОтвета.Назначение = Стр.ПунктНазначения Тогда
				// очищаем все из структуры
				СтруктураОтвета = Новый Структура;
				Прервать;
			КонецЕсли;
		Иначе
			СтруктураОтвета.Вставить("Отправление",Стр.ПунктОтправления);
			СтруктураОтвета.Вставить("Назначение",Стр.ПунктНазначения);
		КонецЕсли;
	КонецЦикла;

	Возврат СтруктураОтвета;
	
КонецФункции

