&НаСервере
Функция ПодготовитьТаблицуПоАвансамНаСервере()
	
	ТЗВспомогательная = Объект.Доходы.Выгрузить();
	ТЗВспомогательная.Свернуть("Клиент,Договор,ГУИД","СуммаИтого");
	Сч = ТЗВспомогательная.Количество();
	Пока Сч > 0 Цикл
		Если (Не ТЗВспомогательная[Сч-1].Договор.УсловиеОплаты = Перечисления.ВидыУсловийОплаты.Предоплата )
			или ( не ТЗВспомогательная[Сч-1].Договор.РазмерАванса > 0) Тогда
			ТЗВспомогательная.Удалить(Сч-1);
			Сч = Сч-1;
		Иначе
			ТЗВспомогательная[Сч-1].СуммаИтого = ТЗВспомогательная[Сч-1].СуммаИтого*ТЗВспомогательная[Сч-1].Договор.РазмерАванса/100;
			Сч = Сч-1;
		КонецЕсли;
		
	КонецЦикла;
	ТЗВспомогательная.Свернуть("Клиент,Договор","СуммаИтого");
		
	ИтоговыйМассив = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТЗВспомогательная);
	
	ВОзврат ИтоговыйМассив;
	
КонецФункции

