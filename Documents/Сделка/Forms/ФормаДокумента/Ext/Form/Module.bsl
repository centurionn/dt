&НаКлиенте
Процедура ПроверитьНаНаличиеАналогичнойСлужебнойСделки(Отказ = Ложь) 
	Если Объект.Заявки.Количество() > 0 Тогда
		КонтрагентСсылка = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(Объект.Заявки[0].Заявка, "Контрагент");
		Если КонтрагентыДоговоры_Сервер.КонтрагентЯвляетсяДирекциейКонтейнерныхПеревозок(КонтрагентСсылка) Тогда
			//проверим, заполнен ли рейс в сделке
			Если Объект.Рейсы.Количество() = 0 Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю("В сделке не выбран рейс. Проверьте заполнение рейса в добавленной заявке.");
				Отказ = Истина;
			Иначе
				//ищем, если ли другие сделки с рейсом из нашей служебной сделки
				НайденнаяСделка = ПоискСделкиСАналогичнымРейсомВЗаявке(); 
				//если в сделке есть заявка и рейс найден в служебной сделке, предложим открыть найденную сделку
				Если НайденнаяСделка <> Неопределено Тогда
					СтруктураПараметров = Новый Структура;
				    СтруктураПараметров.Вставить("Сделка", НайденнаяСделка);
					ОпОп = Новый ОписаниеОповещения("ОбработкаОтветаНаВопросОткрытияАналогичнойСлужебнойСделки", ЭтаФорма, СтруктураПараметров);
					Кнопки = Новый СписокЗначений;
					Кнопки.Добавить("ПерейтиВСделку", "Перейти в сделку");
					Кнопки.Добавить("Отмена", "Отмена");
					ПредставлениеСделки = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(НайденнаяСделка, "Представление");
					ПоказатьВопрос(ОпОп, "Служебная сделка (на передислокацию КТК) с аналогичным рейсом уже имеется. " + Символы.ПС + """" + ПредставлениеСделки + """" + Символы.ПС +   
						"Открыть указанную сделку для добавления в нее заявок на передислокацию КТК?", Кнопки);
					Отказ = Истина;
				Иначе
					//разрешим для коммерческих сделок
					Объект.РазрешитьРейсыДругихСделок = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПоискСделкиСАналогичнымРейсомВЗаявке()
	мРейсы = Новый Массив;
	Для каждого Рейс Из Объект.Рейсы Цикл
		мРейсы.Добавить(Рейс.Рейс);
	КонецЦикла; 
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СделкаРейсы.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Сделка.Рейсы КАК СделкаРейсы
		|ГДЕ
 		|	СделкаРейсы.Ссылка <> &Ссылка          
        |	И СделкаРейсы.Рейс В(&Рейс)
        |	И НЕ СделкаРейсы.Ссылка.ПометкаУдаления
		|	И СделкаРейсы.Ссылка.Проведен";
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.УстановитьПараметр("Рейс", мРейсы);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Количество() > 0 Тогда //есть еще одна сделка с таким же рейсом
		//и если находим, то смотрим, в какой сделке есть такой-же рейс
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			СделкаСАналогичнымРейсом = ВыборкаДетальныеЗаписи.Ссылка;
			//проверяем, служебная заявка или нет
			Если СделкаСАналогичнымРейсом.Заявки.Количество() > 0 
				И СделкаСАналогичнымРейсом.Заявки[0].Заявка <> Неопределено 
					И СделкаСАналогичнымРейсом.Заявки[0].Калькуляция <> Неопределено Тогда
				КонтрагентВЗаявкеНайденнойСделки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СделкаСАналогичнымРейсом.Заявки[0].Заявка, "Контрагент");
				ТипКалькуляцииВЗаявкеНайденнойСделки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СделкаСАналогичнымРейсом.Заявки[0].Калькуляция, "ТипКалькуляции");
				Если КонтрагентыДоговоры_Сервер.КонтрагентЯвляетсяДирекциейКонтейнерныхПеревозок(КонтрагентВЗаявкеНайденнойСделки) 
						И КалькуляцииЗаявкиПСЦСервер.ТипКалькуляцииЯвляетсяМежсервиснымиРасходами(ТипКалькуляцииВЗаявкеНайденнойСделки) Тогда
	        		Возврат СделкаСАналогичнымРейсом;
				Иначе
					Объект.РазрешитьРейсыДругихСделок = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Процедура ОбработкаОтветаНаВопросОткрытияАналогичнойСлужебнойСделки(РезультатВопроса, ДопПараметры) Экспорт
	Если РезультатВопроса = "ПерейтиВСделку" Тогда
		 Если НЕ ДопПараметры.Сделка.Пустая() Тогда
	        ПараметрыФормы = Новый Структура("Ключ", ДопПараметры.Сделка);                      
			ПерваяСтрокаТЧЗаявки = Объект.Заявки[0];
			Если ПерваяСтрокаТЧЗаявки <> Неопределено Тогда 
				ПараметрыФормы.Вставить("Заявка", 		ПерваяСтрокаТЧЗаявки.Заявка); 
				ПараметрыФормы.Вставить("Калькуляция", 	ПерваяСтрокаТЧЗаявки.Калькуляция); 
				ПараметрыФормы.Вставить("Оплачено", 	ПерваяСтрокаТЧЗаявки.Оплачено);  
				ПараметрыФормы.Вставить("Отфактурована",ПерваяСтрокаТЧЗаявки.Отфактурована);  
				ПараметрыФормы.Вставить("ПСЦНеЗаполнен",ПерваяСтрокаТЧЗаявки.ПСЦНеЗаполнен);
			КонецЕсли;	
			ОткрытьФорму("Документ.Сделка.Форма.ФормаДокумента", ПараметрыФормы);  
			ЭтаФорма.Модифицированность = Ложь;
			ЭтаФорма.Закрыть();
    	КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПроверкаНаНеСовместимостьСлужебныхИКоммерческихЗаявок();
	ЗаявкиНеСовместимы = Ложь;
	ТекущиеДанные = Элементы.Заявки.ТекущиеДанные;
	Если Объект.Заявки.Количество() > 1 И НЕ ТекущиеДанные.Заявка.Пустая() Тогда
		Если ТекущиеДанные.НомерСтроки > 1 Тогда
			НомерСтрокиСравнения = 0
		Иначе
			НомерСтрокиСравнения = 1
		КонецЕсли;
		КонтрагентЗаявкиПервойСтроки = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(Объект.Заявки[НомерСтрокиСравнения].Заявка, "Контрагент");
		КонтрагентЗаявкиТекущейСтроки = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(ТекущиеДанные.Заявка, "Контрагент");
		КонтрагентПервойСтрокиЯвляетсяДирекцией = КонтрагентыДоговоры_Сервер.КонтрагентЯвляетсяДирекциейКонтейнерныхПеревозок(КонтрагентЗаявкиПервойСтроки.Контрагент);
		КонтрагентТекущейСтрокиЯвляетсяДирекцией = КонтрагентыДоговоры_Сервер.КонтрагентЯвляетсяДирекциейКонтейнерныхПеревозок(КонтрагентЗаявкиТекущейСтроки.Контрагент);
		Если КонтрагентПервойСтрокиЯвляетсяДирекцией И НЕ КонтрагентТекущейСтрокиЯвляетсяДирекцией
				ИЛИ НЕ КонтрагентПервойСтрокиЯвляетсяДирекцией И КонтрагентТекущейСтрокиЯвляетсяДирекцией Тогда
			ЗаявкиНеСовместимы = Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат ЗаявкиНеСовместимы; 
КонецФункции
