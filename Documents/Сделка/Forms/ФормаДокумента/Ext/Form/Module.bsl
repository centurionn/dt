&НаСервере
Процедура ВосстановитьДоходыИзТЧНаСервере()
	
	//Евросиб Каблов 23.12.2025 ( #126470
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПСЦ.Ссылка КАК Ссылка,
	|	ПСЦ.РазрешенПересчетСтавкиУслугиВСчетНДС22 КАК РазрешенПересчетСтавкиУслугиВСчетНДС22
	|ИЗ
	|	Документ.ПСЦ КАК ПСЦ
	|ГДЕ
	|	ПСЦ.Ссылка В(&Протоколы)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Калькуляция.Ссылка КАК Ссылка,
	|	Калькуляция.СтавкаНДС КАК СтавкаНДС
	|ИЗ
	|	Документ.Калькуляция КАК Калькуляция
	|ГДЕ
	|	Калькуляция.Ссылка В(&Калькуляции)";
	ТаблицаДанныхТЧ = Объект.Доходы.Выгрузить(, "ПСЦ, Калькуляция");
	Запрос.УстановитьПараметр("Протоколы", ТаблицаДанныхТЧ.ВыгрузитьКолонку("ПСЦ"));
	Запрос.УстановитьПараметр("Калькуляции", ТаблицаДанныхТЧ.ВыгрузитьКолонку("Калькуляция"));
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	ТаблицаПротоколов = РезультатыЗапроса[0].Выгрузить();
	ТаблицаПротоколов.Индексы.Добавить("Ссылка");
	ТаблицаКалькуляций = РезультатыЗапроса[1].Выгрузить();
	ТаблицаКалькуляций.Индексы.Добавить("Ссылка");	
	//Евросиб Каблов 23.12.2025 ) #126470
	
	ИндексированнаяТЧДоходыВагоны = Объект.ДоходыВагоны.Выгрузить();
	ИндексированнаяТЧДоходыВагоны.Индексы.Добавить("ГУИД");
	
	ИндексированнаяТЧДоходыКТК = Объект.ДоходыКТК.Выгрузить();
	ИндексированнаяТЧДоходыКТК.Индексы.Добавить("ГУИД");

	ИндексированнаяТЧДоходыТД = Объект.ДоходыТД.Выгрузить();
	ИндексированнаяТЧДоходыТД.Индексы.Добавить("ГУИД");
	
	Для каждого Дх из Объект.Доходы Цикл
		ИскМасСтр = ИндексированнаяТЧДоходыВагоны.НайтиСтроки(Новый Структура("ГУИД", Дх.ГУИД) );
		Для каждого Вг Из ИскМасСтр Цикл
			Дх.СписокВагонов = Вг.Вагон;
		КонецЦикла;
		ИскМасСтр = ИндексированнаяТЧДоходыКТК.НайтиСтроки(Новый Структура("ГУИД", Дх.ГУИД) );
		Для каждого Ктк Из ИскМасСтр Цикл
			Дх.СписокКТК = Ктк.КТК;
		КонецЦикла;
		ИскМасСтр = ИндексированнаяТЧДоходыТД.НайтиСтроки(Новый Структура("ГУИД", Дх.ГУИД) );
		Для каждого ТД Из ИскМасСтр Цикл
			Дх.СписокТД = ТД.ТД;
		КонецЦикла;
		//Евросиб Каблов 23.12.2025 ( #126470
		НайденнаяСтрока = ТаблицаПротоколов.Найти(Дх.ПСЦ, "Ссылка");
		Если НайденнаяСтрока <> Неопределено Тогда
			Дх.РазрешенПересчетСтавкиУслугиВСчетНДС22 = НайденнаяСтрока.РазрешенПересчетСтавкиУслугиВСчетНДС22;
		КонецЕсли;
		НайденнаяСтрока = ТаблицаКалькуляций.Найти(Дх.Калькуляция, "Ссылка");
		Если НайденнаяСтрока <> Неопределено Тогда
			Дх.СтавкаНДСвКалькуляции = НайденнаяСтрока.СтавкаНДС;
		КонецЕсли;
		//Евросиб Каблов 23.12.2025 ) #126470
	КонецЦикла;
	
	Для каждого Дх из Объект.Расходы Цикл
		ИскМасСтр = ИндексированнаяТЧДоходыВагоны.НайтиСтроки(Новый Структура("ГУИД", Дх.ГУИД) );
		Для каждого Вг Из ИскМасСтр Цикл
			Дх.СписокВагонов = Вг.Вагон;
		КонецЦикла; 
		ИскМасСтр = ИндексированнаяТЧДоходыКТК.НайтиСтроки(Новый Структура("ГУИД", Дх.ГУИД) );
		Для каждого Ктк Из ИскМасСтр Цикл
			Дх.СписокКТК = Ктк.КТК;
		КонецЦикла; 
		ИскМасСтр = ИндексированнаяТЧДоходыТД.НайтиСтроки(Новый Структура("ГУИД", Дх.ГУИД) );
		Для каждого ТД Из ИскМасСтр Цикл
			Дх.СписокТД = ТД.ТД;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ПолучитьРежимУслугиЧерезКэш(Услуга)
	
	НайдЗн = -1;
	Для каждого Стр из КэшРежимовУслуги Цикл
		Если Стр.Услуга = Услуга Тогда НайдЗн = Стр.Режим; Прервать; КонецЕсли;
	КонецЦикла;
	Если НайдЗн = -1 Тогда
		НайдЗн = ПолучитьРежимУслуги(Услуга);
		НСтр = КэшРежимовУслуги.Добавить();
		НСтр.Услуга = Услуга;
		НСтр.Режим = НайдЗн;
	КонецЕсли;
	
	Возврат НайдЗн;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНомерТД(ТД)
	Возврат ?(ЗначениеЗаполнено(ТД), ТД.НомерТранспортногоДокумента, "");
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьРежимУслуги(Услуга)
	Возврат ?(ЗначениеЗаполнено(Услуга), Услуга.УслугаРасходовВыбираетсяПриУсловии, "");
КонецФункции

&НаКлиенте
Процедура ЗаписатьДоходыВТЧ()
	
	МассивГуидДоходы = Новый Массив;
	Для каждого Стр Из Объект.Доходы Цикл
		МассивГуидДоходы.Добавить(Стр.ГУИД);
	КонецЦикла; 
	СтрокиКУдалению = Новый Массив;
	Для каждого Стр Из Объект.ДоходыВагоны Цикл
		Если МассивГуидДоходы.Найти(Стр.ГУИД) <> Неопределено Тогда
			СтрокиКУдалению.Добавить(Стр);
		КонецЕсли; 
	КонецЦикла; 
	Для каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
		Объект.ДоходыВагоны.Удалить(СтрокаКУдалению);
	КонецЦикла; 
	
	СтрокиКУдалению = Новый Массив;
	Для каждого Стр Из Объект.ДоходыКТК Цикл
		Если МассивГуидДоходы.Найти(Стр.ГУИД) <> Неопределено Тогда
			СтрокиКУдалению.Добавить(Стр);
		КонецЕсли; 
	КонецЦикла; 
	Для каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
		Объект.ДоходыКТК.Удалить(СтрокаКУдалению);
	КонецЦикла; 
	
	СтрокиКУдалению = Новый Массив;
	Для каждого Стр Из Объект.ДоходыТД Цикл
		Если МассивГуидДоходы.Найти(Стр.ГУИД) <> Неопределено Тогда
			СтрокиКУдалению.Добавить(Стр);
		КонецЕсли; 
	КонецЦикла; 
	Для каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
		Объект.ДоходыТД.Удалить(СтрокаКУдалению);
	КонецЦикла; 
	Для каждого Стр из Объект.Доходы Цикл
		
		Если ЗначениеЗаполнено(Стр.СписокВагонов) Тогда 
			НСтр = Объект.ДоходыВагоны.Добавить(); 
			НСтр.ГУИД = Стр.ГУИД; 
			НСтр.Вагон = Стр.СписокВагонов; 
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.СписокКТК) Тогда 
			НСтр = Объект.ДоходыКТК.Добавить(); 
			НСтр.ГУИД = Стр.ГУИД; 
			НСтр.КТК = Стр.СписокКТК; 
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.СписокТД) Тогда 
			НСтр = Объект.ДоходыТД.Добавить(); 
			НСтр.ГУИД = Стр.ГУИД; 
			НСтр.ТД = Стр.СписокТД; 
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	//Евросиб Каблов 26.08.2022 ( 56193
	//ПроверитьЗаполнениеДанных(Отказ);
	//Евросиб Каблов 26.08.2022 )    
	
	//Евросиб Коханенко Н.А. 06.07.2023 (( #72162
	ПроверитьНаНаличиеАналогичнойСлужебнойСделки(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	//Евросиб Коханенко Н.А. 06.07.2023 )) #72162
	
	Объект.КоличествоКТКЕвросиб = 0;
	Объект.КоличествоКТККлиента = 0;
	МассивПосчитанныхСтрок = Новый Массив;
	Для каждого Стр из Объект.СвязьУчетныхЕдиниц Цикл
		
		//Если ЗначениеЗаполнено(МассивПосчитанныхСтрок.Найти(Стр.ГУИДСтрокиЗаявки)) Тогда
		//ДИТ, Беляев СЮ, Ticket#0312777, 07-06-2023, начало
		Если МассивПосчитанныхСтрок.Найти(Стр.ГУИДСтрокиЗаявки)<>Неопределено Тогда
		//ДИТ, Беляев СЮ, Ticket#0312777, 07-06-2023, конец
			Продолжить;
		КонецЕсли;
		Если Стр.ПринадлежностьТЕ = ПредопределенноеЗначение("Перечисление.ПринадлежностьТЕ.КТЕвросиба") И Стр.Удалена = Ложь
			И Стр.НеАктивна = Ложь Тогда // Евросиб Фролов, 15.04.2022 Task №48577
			Объект.КоличествоКТКЕвросиб = Объект.КоличествоКТКЕвросиб + 1;
		ИначеЕсли Стр.ПринадлежностьТЕ = ПредопределенноеЗначение("Перечисление.ПринадлежностьТЕ.КТКлиента") И Стр.Удалена = Ложь
			И Стр.НеАктивна = Ложь Тогда // Евросиб Фролов, 15.04.2022 Task №48577
			Объект.КоличествоКТККлиента = Объект.КоличествоКТККлиента + 1;
		КонецЕсли;
		МассивПосчитанныхСтрок.Добавить(Стр.ГУИДСтрокиЗаявки);
		
	КонецЦикла;
	
	ЗаписатьДоходыВТЧ();
	
	ДляДанногоОбъектаТребуетсяПеремаршрутизация = ПроверитьНеобходимостьМаршрутизации();
	Если Объект.Маршрутизировать И ДопСвойстваОбъекта.Количество() = 0 И ДляДанногоОбъектаТребуетсяПеремаршрутизация Тогда
		
		ОплатаПоОригиналу = ПолучитьОплатуПоОригиналу();
		
		ПараметрыЗапроса = Новый Соответствие;
		ПараметрыЗапроса.Вставить("Организация", Объект.Организация);
		ПараметрыЗапроса.Вставить("МаршрутизируемыйОбъект", Объект.Ссылка);
		ПараметрыЗапроса.Вставить("ОплатаПоОригиналу", ОплатаПоОригиналу);
		ПараметрыЗапроса.Вставить("ПодсылПорожних", Объект.ПодсылПорожних);
		ПараметрыЗапроса.Вставить("ПовагонныеОтправки", Объект.ПовагонныеОтправки);
		ПараметрыЗапроса.Вставить("ОтветственныйПоСделке", "НЕТ");
		// Евросиб Фролов (12.04.2022 Task №46871
		ПараметрыЗапроса.Вставить("СлужебнаяСделка", Объект.Служебная);
		// Евросиб Фролов)
		
		РезультатЗапроса = МаршрутизацияСервер.МаршрутизироватьСделку(ПараметрыЗапроса, Объект.Дата);
		Если РезультатЗапроса.Количество() > 0 Тогда
			Отказ = ПроверитьУказатьОтветственных(РезультатЗапроса, Истина);
		КонецЕсли;
		
	КонецЕсли;
	
	//перенес на сервер
	//Для каждого Строка Из Объект.Доходы Цикл
	//	Если Не Строка.Перевыставляемая И НЕ Строка.НеВыставлятьКлиенту
	//		И Не ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(Строка.Услуга, "Доходная") Тогда
	//		ОбщегоНазначенияКлиент.СообщитьПользователю("В строке " + Строка.НомерСтроки + " таблицы <Доходы> выбрана услуга, запрещенная к выбору для выставления клиенту.",,,, Отказ);
	//	КонецЕсли; 
	//КонецЦикла; 
	//При проведении реализована проверка заполнения погранперехода страны отправления\назначения,
	//если страна станции отправления\назначения не имеет признака "страна СНГ или балтии"	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		СтруктураОбязательныхРеквизитовШапки = Новый Структура("Организация, СтанцияОтправления, СтанцияНазначения,
		|ЦФО, Подразделение, Валюта, ТипЗаказа","Организация","Станция отправления", "Станция назначения", "ЦФО", "Подразделение", "Валюта", "Тип заказа");
		Для каждого ИмяПоля Из СтруктураОбязательныхРеквизитовШапки Цикл
			Если НЕ ЗначениеЗаполнено(Объект[ИмяПоля.Ключ]) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не заполнено поле '%1'",ИмяПоля.Значение),,ИмяПоля.Ключ,"Объект",Отказ);	
			КонецЕсли; 
		КонецЦикла; 
		
		Если Не Отказ Тогда
			РеквизитыСтанцииОтправления = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(Объект.СтанцияОтправления, "Страна.СтранаСССР, Тип, Страна");
			РеквизитыСтанцииНазначения = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(Объект.СтанцияНазначения, "Страна.СтранаСССР, Тип, Страна");
			ТипПорт = ПредопределенноеЗначение("Справочник.ТипыЛокаций.Порт");
			СтранаРоссия = ПредопределенноеЗначение("Справочник.СтраныМира.Россия");
			СтранаНеЗаполнена = ПредопределенноеЗначение("Справочник.СтраныМира.ПустаяСсылка");
			//Пункты отправления и назначения порты – не проверяем погранпереходы
			Если НЕ (РеквизитыСтанцииОтправления.Тип = ТипПорт И РеквизитыСтанцииНазначения.Тип = ТипПорт) Тогда
				НеПроверятьПогранПереходНазначения = Ложь;
				НеПроверятьПогранПереходОтправления = Ложь;
				//Пункт отправления порт РФ, не проверяем погранпереход назначения
				Если РеквизитыСтанцииОтправления.Тип = ТипПорт И РеквизитыСтанцииОтправления.Страна = СтранаРоссия Тогда
					НеПроверятьПогранПереходНазначения = Истина;
				КонецЕсли;
				//Пункт назначения порт РФ, не проверяем погранпереход отправления, если пункт отправления вне РФ
				Если РеквизитыСтанцииНазначения.Тип = ТипПорт 
					И РеквизитыСтанцииНазначения.Страна = СтранаРоссия // Евросиб Фролов (26.11.2021 Ticket№ 0250831
					И РеквизитыСтанцииОтправления.Страна <> СтранаРоссия Тогда
					НеПроверятьПогранПереходОтправления = Истина;
				КонецЕсли;
				
				// Евросиб Фролов (26.11.2021 Ticket№ 0250831
				// Не проверять погранпереход страны отправления если это страна бывшего СССР
				Если РеквизитыСтанцииОтправления.СтранаСтранаСССР = Истина Тогда // Евросиб Фролов (26.11.2021 Ticket №0252064, добавил "= Истина"
					НеПроверятьПогранПереходОтправления = Истина;
				КонецЕсли;
				// Не проверять погранпереход страны назначения если это страна бывшего СССР
				Если РеквизитыСтанцииНазначения.СтранаСтранаСССР = Истина Тогда // Евросиб Фролов (26.11.2021 Ticket №0252064, добавил "= Истина"
					НеПроверятьПогранПереходНазначения = Истина;
				КонецЕсли;
				// Евросиб Фролов)
				
				Если РеквизитыСтанцииОтправления.Страна <> СтранаНеЗаполнена
					И РеквизитыСтанцииОтправления.Страна <> СтранаРоссия 
					И НеПроверятьПогранПереходОтправления = Ложь Тогда
					Если НЕ ЗначениеЗаполнено(Объект.ПогранпереходИзСтраныОтправления) Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен погранпереход из страны отправления",,"ПогранпереходИзСтраныОтправления","Объект",Отказ);
					КонецЕсли; 
				КонецЕсли; 
				Если РеквизитыСтанцииНазначения.Страна <> СтранаНеЗаполнена
					И РеквизитыСтанцииНазначения.Страна <> СтранаРоссия 
					И НеПроверятьПогранПереходНазначения = Ложь Тогда
					Если НЕ ЗначениеЗаполнено(Объект.ПогранпереходВСтрануНазначения) Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен погранпереход в страну назначения",,"ПогранпереходВСтрануНазначения","Объект",Отказ);
					КонецЕсли; 
				КонецЕсли; 
			КонецЕсли; 
		КонецЕсли; 
	ИначеЕсли ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
			
			// ДИТ Поморцева Т.П. Задача 32343 18.10.2021. начало 
			СтруктураОбязательныхРеквизитовШапки = Новый Структура("ЦФО", "ЦФО");
			Для каждого ИмяПоля Из СтруктураОбязательныхРеквизитовШапки Цикл
				Если НЕ ЗначениеЗаполнено(Объект[ИмяПоля.Ключ]) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не заполнено поле '%1'",ИмяПоля.Значение),,ИмяПоля.Ключ,"Объект",Отказ);	
				КонецЕсли; 
			КонецЦикла;
			// ДИТ Поморцева Т.П. Задача 32343 18.10.2021. конец
	КонецЕсли; 
		

КонецПроцедуры

&НаКлиенте
Процедура УстановкаОтветственных(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	Для Каждого Стр Из Параметр1 Цикл
		НовСтр = Объект.Состояния.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,Стр);		
	КонецЦикла;
	Параметры.СохранитьДанныеСостояний = Истина;
	
	СтруктураЗаписиДанных = Новый СТруктура;
	СтруктураЗаписиДанных.Вставить("СостоянияИзменены",Истина);
	
	Записать(СтруктураЗаписиДанных);

КонецПроцедуры

&НаКлиенте
Функция ПроверитьНеобходимостьМаршрутизации()

	ДляДанногоОбъектаТребуетсяПеремаршрутизация = 
	НЕ ЗначениеЗаполнено(Объект.Ссылка) ИЛИ 
	Объект.Состояния.Количество() = 0;
	
	Возврат ДляДанногоОбъектаТребуетсяПеремаршрутизация;
	
КонецФункции

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	//Евросиб Каблов 26.08.2022 ( 56193
	Документы.Сделка.ПроверитьПериодВОДоходов(Объект.Доходы, ТекущийОбъект, Истина, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	//Евросиб Каблов 26.08.2022 )
	
	//перенес с клиента
	Для каждого Строка Из Объект.Доходы Цикл
		Если Не Строка.Перевыставляемая И НЕ Строка.НеВыставлятьКлиенту
			И Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Строка.Услуга, "Доходная") Тогда
			ОбщегоНазначения.СообщитьПользователю("В строке " + Строка.НомерСтроки + " таблицы <Доходы> выбрана услуга, запрещенная к выбору для выставления клиенту.",,,, Отказ);
		КонецЕсли; 
	КонецЦикла; 
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ДопСвойстваОбъекта", ДопСвойстваОбъекта);
	// Евросиб Фролов (14.04.2022 Task №50195
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ЗаписьСвязанныхОбъектов", Истина);
	// Евросиб Фролов)
	
	// SIV 07-10-2020 сохраним данные о дате выдачи груза клиенту из СвязьУчетныхЕдиниц в Заявки
	МассивЗаявок = Новый Массив;	
	Для каждого Стр из Объект.СвязьУчетныхЕдиниц Цикл
		Если МассивЗаявок.Найти(Стр.Заявка) = неопределено Тогда МассивЗаявок.Добавить(Стр.Заявка); КонецЕсли;
	КонецЦикла;
	Для каждого Заявка из МассивЗаявок Цикл
		Если НЕ ЗначениеЗаполнено(Заявка) Тогда Продолжить; КонецЕсли;
		ЗаявкаОбъект = Заявка.ПолучитьОбъект();
		НадоЗаписать = Ложь;
		Для каждого СтрКТК из Объект.СвязьУчетныхЕдиниц.НайтиСтроки(Новый Структура("Заявка", Заявка)) Цикл
			Для каждого СтрЗаявка из ЗаявкаОбъект.СоставУслуги Цикл
				// Евросиб Фролов (26.12.2021 TASK №44663
				//Если (СтрЗаявка.НомерКТК = СтрКТК.Контейнер ИЛИ СтрЗаявка.ГУИДСтроки = СтрКТК.ГУИД) И СтрКТК.ДатаВыдачиГрузаКлиенту <> СтрЗаявка.ДатаПодачиАвтоПодВыгрузку И ЗначениеЗаполнено(СтрКТК.ДатаВыдачиГрузаКлиенту) Тогда
				Если СтрЗаявка.ГУИДСтроки = СтрКТК.ГУИДСтрокиЗаявки И СтрКТК.ДатаВыдачиГрузаКлиенту <> СтрЗаявка.ДатаПодачиАвтоПодВыгрузку И ЗначениеЗаполнено(СтрКТК.ДатаВыдачиГрузаКлиенту) Тогда
				// Евросиб Фролов)	
					СтрЗаявка.ДатаПодачиАвтоПодВыгрузку = СтрКТК.ДатаВыдачиГрузаКлиенту;
					НадоЗаписать = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		Если НадоЗаписать Тогда
			ЗаявкаОбъект.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не Объект.ПовагонныеОтправки Тогда
		мРейсы = Новый Массив;
		Для каждого Рейс Из Объект.Рейсы Цикл
			мРейсы.Добавить(Рейс.Рейс);
		КонецЦикла; 
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	СделкаРейсы.Ссылка КАК Ссылка
		               |ИЗ
		               |	Документ.Сделка.Рейсы КАК СделкаРейсы
		               |ГДЕ
		               |	СделкаРейсы.Ссылка <> &Ссылка
		               |	И СделкаРейсы.Рейс В(&Рейс)
		               |	И НЕ СделкаРейсы.Ссылка.ПометкаУдаления
		               |	И НЕ СделкаРейсы.Ссылка.ПовагонныеОтправки
		               |	И НЕ СделкаРейсы.Рейс В (&СлужебныйРейсНеИспользуется)
		               |	И НЕ СделкаРейсы.Ссылка.РазрешитьРейсыДругихСделок";
		Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
		Запрос.УстановитьПараметр("Рейс", мРейсы);
		
		СлужебныйРейсНеИспользуется = Новый Массив;
		СлужебныйРейсНеИспользуется.Добавить(Справочники.РейсыЖД.БезРейса);
		СлужебныйРейсНеИспользуется.Добавить(Справочники.РейсыАвто.НеИспользуется);
		
		Запрос.УстановитьПараметр("СлужебныйРейсНеИспользуется", СлужебныйРейсНеИспользуется);
		Ответ = Запрос.Выполнить().Выбрать();
		Пока Ответ.Следующий() Цикл
			Если НЕ Объект.РазрешитьРейсыДругихСделок Тогда
	 			Сообщить("Рейсы этой сделки встречаются также в сделке: " + Ответ.Ссылка);
				Отказ = Истина;
				Прервать;
			Иначе
				обСделка = Ответ.Ссылка.ПолучитьОбъект();
				обСделка.РазрешитьРейсыДругихСделок = Истина;
				обСделка.ОбменДанными.Загрузка = Истина;
				обСделка.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли; 
		КонецЦикла;
	КонецЕсли;
	
	// Евросиб US 110878 TA 111503 Рыбьяков К.А. 15.06.2025 ((
	Если ДанныеДляДобавленияВРасчетДопРасходы <> Неопределено Тогда
		ДанныеРасчетов = ДанныеДляДобавленияВРасчетДопРасходы.Получить();
		Документы.РасчетДополнительныеРасходы.ЗаписатьДанныеВРасчет(ДанныеРасчетов);
		ДанныеДляДобавленияВРасчетДопРасходы = Неопределено;
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 15.06.2025 ))

КонецПроцедуры

&НаСервере
Процедура ЗаписатьДанныеВРС()

	// получить все данные из РС СрокиИспользованияКонтейнеров для данной сделки.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СрокиИспользованияКонтейнеров.Период КАК Период,
	               |	СрокиИспользованияКонтейнеров.Контейнер КАК Контейнер
	               |ИЗ
	               |	РегистрСведений.СрокиИспользованияКонтейнеров КАК СрокиИспользованияКонтейнеров
	               |ГДЕ
	               |	СрокиИспользованияКонтейнеров.ДокументСделка = &ДокументСделка";
	Запрос.УстановитьПараметр("ДокументСделка",Объект.Ссылка);
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Стр Из ТЗ Цикл
		// сначала очистить все записи о данной сделке в регистре
		СоответствиеПараметры = Новый Соответствие;
		СоответствиеПараметры.Вставить("ДокументСделка", Документы.Сделка.ПустаяСсылка());
		СоответствиеПараметры.Вставить("ГУИДДоход", "");
		СоответствиеПараметры.Вставить("ГУИДРасход", "");
		УправлениеКТКВСтокахСервер.ДобавитьЗаписьИспользованияКонтейнера(Стр.Период, Стр.Контейнер, СоответствиеПараметры, Ложь);
	КонецЦикла;
	
	// потом записать данные по сделке, по строкам, где стоит флаг "Сверхнорматив"
	// обязательно найти заявку с данным номером КТК и взять из нее дату выдачи клиенту. 
	// по этой дате можно получить уникальную запись в РС
	// 1. Доходы
	ПараметрыОтбораД = Новый Структура;
	ПараметрыОтбораД.Вставить("Сверхнорматив",Истина);
	НайденныеСтрокиД = Объект.Доходы.НайтиСтроки(ПараметрыОтбораД);
	Для Каждого СтрД Из НайденныеСтрокиД Цикл
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЗаявкаСоставУслуги.НомерКТК КАК НомерКТК,
		               |	СрокиИспользованияКонтейнеров.Период КАК Период
		               |ИЗ
		               |	Документ.Сделка.Заявки КАК СделкаЗаявки
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
		               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СрокиИспользованияКонтейнеров КАК СрокиИспользованияКонтейнеров
		               |			ПО ЗаявкаСоставУслуги.НомерКТК = СрокиИспользованияКонтейнеров.Контейнер
		               |				И ЗаявкаСоставУслуги.ДатаВзятия = СрокиИспользованияКонтейнеров.ВыдачаКлиенту
		               |		ПО СделкаЗаявки.Заявка = ЗаявкаСоставУслуги.Ссылка
		               |ГДЕ
		               |	СделкаЗаявки.Ссылка = &Ссылка
		               |	И &КТК ПОДОБНО ""%"" + ЗаявкаСоставУслуги.НомерКТК.Наименование + ""%""";
		Запрос.УстановитьПараметр("КТК",СтрД.СписокКТК);
		Запрос.УстановитьПараметр("Ссылка",Объект.Ссылка);
		ТЗ = Запрос.Выполнить().Выгрузить();
		Для Каждого СтрТЗ Из ТЗ Цикл
			СоответствиеПараметры = Новый Соответствие;
			СоответствиеПараметры.Вставить("ДокументСделка", Объект.Ссылка);
			СоответствиеПараметры.Вставить("ГУИДДоход", СтрД.ГУИД);
			УправлениеКТКВСтокахСервер.ДобавитьЗаписьИспользованияКонтейнера(СтрТЗ.Период, СтрТЗ.НомерКТК, СоответствиеПараметры, Ложь);
		КонецЦикла;
	КонецЦикла;
	// 2. Расходы
	ПараметрыОтбораР = Новый Структура;
	ПараметрыОтбораР.Вставить("Сверхнорматив",Истина);
	ПараметрыОтбораР = Объект.Расходы.НайтиСтроки(ПараметрыОтбораД);
	Для Каждого СтрР Из ПараметрыОтбораР Цикл
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЗаявкаСоставУслуги.НомерКТК КАК НомерКТК,
		               |	СрокиИспользованияКонтейнеров.Период КАК Период
		               |ИЗ
		               |	Документ.Сделка.Заявки КАК СделкаЗаявки
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
		               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СрокиИспользованияКонтейнеров КАК СрокиИспользованияКонтейнеров
		               |			ПО ЗаявкаСоставУслуги.НомерКТК = СрокиИспользованияКонтейнеров.Контейнер
		               |				И ЗаявкаСоставУслуги.ДатаВзятия = СрокиИспользованияКонтейнеров.ВыдачаКлиенту
		               |		ПО СделкаЗаявки.Заявка = ЗаявкаСоставУслуги.Ссылка
		               |ГДЕ
		               |	СделкаЗаявки.Ссылка = &Ссылка
		               |	И &КТК ПОДОБНО ""%"" + ЗаявкаСоставУслуги.НомерКТК.Наименование + ""%""";
		Запрос.УстановитьПараметр("КТК",СтрР.СписокКТК);
		Запрос.УстановитьПараметр("Ссылка",Объект.Ссылка);
		ТЗ = Запрос.Выполнить().Выгрузить();
		Для Каждого СтрТЗ Из ТЗ Цикл
			СоответствиеПараметры = Новый Соответствие;
			СоответствиеПараметры.Вставить("ДокументСделка", Объект.Ссылка);
			СоответствиеПараметры.Вставить("ГУИДРасход", СтрР.ГУИД);
			УправлениеКТКВСтокахСервер.ДобавитьЗаписьИспользованияКонтейнера(СтрТЗ.Период, СтрТЗ.НомерКТК, СоответствиеПараметры, Ложь);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры	

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ПеречитатьДанныеФормы();
	//Евросиб(ДИТ), Беляев СЮ, US 88163/TA 88167, 26-07-2024, начало
	УстановитьКартинкиОбъединеннымСтрокамДоходов();
	//Евросиб(ДИТ), Беляев СЮ, US 88163/TA 88167, 26-07-2024, конец
КонецПроцедуры

&НаКлиенте
Процедура ДоходыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекД = Элементы.Доходы.ТекущиеДанные;
	
	Если НоваяСтрока Тогда
		ТекД.ГУИД = Строка(Новый УникальныйИдентификатор());
		ТекД.Валюта = Объект.Валюта;
		ТекД.НоменклатурнаяГруппа = РазнесениеЗатратСервер.ПодобратьНоменклатурнуюГруппуПоНаборуПараметров(Объект.ТипЗаказа, ТекД.СписокВагонов);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПометитьНаУдалениеСозданныеУчетныеДокументы()
	
	Для каждого СтрокаДоход Из Объект.Доходы Цикл
		Если ЗначениеЗаполнено(СтрокаДоход.УчДокумент) И НЕ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаДоход.УчДокумент,"ПометкаУдаления") Тогда
			обУчДок = СтрокаДоход.УчДокумент.ПолучитьОбъект();
			обУчДок.УстановитьПометкуУдаления(Истина);
			СтрокаДоход.УчДокумент = Неопределено;
		КонецЕсли; 
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СвязатьДоходыРасходыСУЕ(ГУИДДоходы = Неопределено, ГУИДРасходы = Неопределено, ГУИДСУЕ, Услуга = Неопределено)

	Документы.Сделка.СвязатьДоходыРасходыСУЕ(Объект, ГУИДДоходы, ГУИДРасходы, ГУИДСУЕ, Услуга);

