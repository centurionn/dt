&НаСервере
Функция ПолучитьДанныеЗапрещенныхКУдалению(Заявка) Экспорт
	
	МассивУникальныхЗаявок = Новый Массив();
	МассивУникальныхЗаявок.Добавить(Заявка);
	
	СтруктураДанныеПоЗапрещеннымДляПересчета = Новый Структура("МассивДобавленоИзАкцепта, МассивОбъединениеПорожнейИГруженойСделок", Новый Массив, Новый Массив);
	Расходы = Объект.Расходы.Выгрузить();
	СвязьУчетныхЕдиниц = Объект.СвязьУчетныхЕдиниц.Выгрузить(Новый Структура("Заявка", Заявка));	
	СписокГУИДЗапрещенныхКПерезаполнению = ПерезаполнениеСделкиСервер.ПолучитьСписокГУИДЗапрещенныхКПерезаполнению(СтруктураДанныеПоЗапрещеннымДляПересчета, 
																													Расходы, 
																													СвязьУчетныхЕдиниц, 
																													МассивУникальныхЗаявок);

	Возврат СтруктураДанныеПоЗапрещеннымДляПересчета;
КонецФункции
//ДИТ, Беляев СЮ, US 66796 / TA 72732, 20-07-2023, конец

//ДИТ, Беляев СЮ, US 66796 / TA 72732, 20-07-2023, начало
&НаКлиенте
Процедура ПодтверждениеОтвязкиОбъединенныхСделокИОтключенияРасходовПередУдалениемЗаявки(П1 = неопределено, П2 = неопределено) Экспорт
	Если П1 <> КодВозвратаДиалога.Да тогда Возврат; КонецЕсли;
	
	Если Модифицированность Тогда
		Записать();
	КонецЕсли;
	
	ДополнительныеПараметры = П2;
	
	//ОТВЯЗКА РАСХОДОВ ИЗ АКЦЕПТОВ И РАЗЪЕДИНЕНИЕ СДЕЛОК
	СтруктураРезультата = ВыполнитьОтключениеРасходовИзАкцептаИВыполнитьРазъединение( ДополнительныеПараметры );
	
	ОчиститьСообщения();
	//Если СтруктураРезультата.ЕстьРезультатОтключенияРасходов <> Неопределено Тогда
	//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтруктураРезультата.РезультатОтключения);
	//КонецЕсли;
	
	Если СтруктураРезультата.ЕстьРезультатРазъединенияСделок <> Неопределено Тогда
		Если СтруктураРезультата.ЕстьРезультатРазъединенияСделок Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Операция разъединения выполнена. Список разъединенных сделок:");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтруктураРезультата.СписокСделок); 
		ИначеЕсли НЕ СтруктураРезультата.ЕстьРезультатРазъединенияСделок Тогда
			ПоказатьПредупреждение(,"Не удалось выполнить разъединение: "+СтруктураРезультата.РезультатРазъединения);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ЭтаФорма.Прочитать();
	
КонецПроцедуры
//ДИТ, Беляев СЮ, US 66796 / TA 72732, 20-07-2023, конец

