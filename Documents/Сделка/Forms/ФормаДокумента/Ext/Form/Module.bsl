//Евросиб(ДИТ), Беляев СЮ, US 98449 / TA 98451, 20-12-2024, начало
&НаКлиенте
Процедура КопироватьСтрокуДохода(Команда)
	ТекДанные = Элементы.Доходы.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекДанные.УслугаВнеСтавки Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекДанные.ИсточникПоявленияСтрокиЭкономики) Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрокаДоходовГУИД = Новый УникальныйИдентификатор;
	
	//ДОХОДЫ
	НоваяСтрокаДоходов = Объект.Доходы.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрокаДоходов, ТекДанные, ,"УчДокумент,ГУИД,ГУИДСтрокиДохода,ЗадачаГотовностиКВыставлению,ГотовоКВыставлению,КорректировкаДокумента,КорректировкаВознаграждения,ДатаПоявленияСтрокиЭкономики,ИдентификаторГруппировки");
	НоваяСтрокаДоходов.ГУИД = НоваяСтрокаДоходовГУИД;
	НоваяСтрокаДоходов.ДатаПоявленияСтрокиЭкономики = ТекущаяДата();
	НоваяСтрокаДоходов.УслугаВнеСтавки = Истина;
	
	//СВЯЗЬДОХОДОВИРАСХОДОВ
	МассивГУИД_СУЕ = Новый Массив; //запишем уникальные ГУИД СУЕ в Массив, чтобы не создавть одинаковые строки
	Для Каждого строкаСвязьДоходовИРасходов Из Объект.СвязьДоходовИРасходов.НайтиСтроки(Новый Структура("Доходы", ТекДанные.ГУИД)) Цикл
		Если МассивГУИД_СУЕ.Найти(строкаСвязьДоходовИРасходов.СвязьУчетныхЕдиниц) = Неопределено Тогда
			МассивГУИД_СУЕ.Добавить(строкаСвязьДоходовИРасходов.СвязьУчетныхЕдиниц);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ГУИД_СУЕ Из МассивГУИД_СУЕ Цикл
		НоваяСтрокаСвязьДоходовИРасходов = Объект.СвязьДоходовИРасходов.Добавить();
		НоваяСтрокаСвязьДоходовИРасходов.Доходы = НоваяСтрокаДоходовГУИД;
		НоваяСтрокаСвязьДоходовИРасходов.СвязьУчетныхЕдиниц = ГУИД_СУЕ;
		НоваяСтрокаСвязьДоходовИРасходов.Услуга = ?(ТекДанные.Услуга = УслугаФрахта, УслугаФрахта, Неопределено);
	КонецЦикла;
	
	//КОНТЕЙНЕРЫ
	Для Каждого строкаДоходыКТК Из Объект.ДоходыКТК.НайтиСтроки(Новый Структура("ГУИД", ТекДанные.ГУИД)) Цикл
		НоваяСтрокаДоходыКТК = Объект.ДоходыКТК.Добавить();
		НоваяСтрокаДоходыКТК.ГУИД = НоваяСтрокаДоходовГУИД;
		НоваяСтрокаДоходыКТК.КТК = строкаДоходыКТК.КТК;
	КонецЦикла;
	
	//ВАГОНЫ
	Для Каждого строкаДоходыВагоны Из Объект.ДоходыВагоны.НайтиСтроки(Новый Структура("ГУИД", ТекДанные.ГУИД)) Цикл
		НоваяСтрокаДоходыВагоны = Объект.ДоходыВагоны.Добавить();
		НоваяСтрокаДоходыВагоны.ГУИД = НоваяСтрокаДоходовГУИД;
		НоваяСтрокаДоходыВагоны.Вагон = строкаДоходыВагоны.Вагон;
	КонецЦикла;
	
	//ТД
	Для Каждого строкаДоходыТД Из Объект.ДоходыТД.НайтиСтроки(Новый Структура("ГУИД", ТекДанные.ГУИД)) Цикл
		НоваяСтрокаДоходыТД = Объект.ДоходыТД.Добавить();
		НоваяСтрокаДоходыТД.ГУИД = НоваяСтрокаДоходовГУИД;
		НоваяСтрокаДоходыТД.ТД = строкаДоходыТД.ТД;
	КонецЦикла;
	
КонецПроцедуры
//Евросиб(ДИТ), Беляев СЮ, US 98449 / TA 98451, 20-12-2024, конец

&НаКлиенте
Процедура ОткрытьРасчетСНП(Команда) //Евросиб Шевченко А.В. US 109279 TA 112025 04.07.2025
	ТекД = Элементы.Доходы.ТекущиеДанные;
	Если ТекД = неопределено Тогда Возврат; КонецЕсли;
	
	РасчетыСНП = ПолучитьРасчетСНП(ТекД.ГУИД);
	
	Если ЗначениеЗаполнено(РасчетыСНП.РасчетСНП) И НЕ ЗначениеЗаполнено(РасчетыСНП.КоррСНП) Тогда
		ОткрытьФорму("Документ.РасчетСНП.ФормаОбъекта",Новый Структура("Ключ",РасчетыСНП.РасчетСНП));
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(РасчетыСНП.РасчетСНП) И ЗначениеЗаполнено(РасчетыСНП.КоррСНП) Тогда
		МенюКнопки = Новый СписокЗначений();
		МенюКнопки.Добавить(0, "Открыть первоначальный расчет");
		МенюКнопки.Добавить(1, "Открыть корректировочный расчет");
		
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораИзМенюРасчетыСНП",ЭтаФорма , РасчетыСНП);
		ПоказатьВыборИзМеню(Оповещение, МенюКнопки);	
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораИзМенюРасчетыСНП(ВыбранныйЭлемент, Параметры) Экспорт //Евросиб Шевченко А.В. US 109279 TA 112025 04.07.2025
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Если ВыбранныйЭлемент.Значение = 0 Тогда
		ОткрытьФорму("Документ.РасчетСНП.ФормаОбъекта",Новый Структура("Ключ",Параметры.РасчетСНП));
	ИначеЕсли ВыбранныйЭлемент.Значение = 1 Тогда
		ОткрытьФорму("Документ.РасчетСНП.ФормаОбъекта",Новый Структура("Ключ",Параметры.КоррСНП));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьРасчетСНП(ГУИДСтрокиДохода) //Евросиб Шевченко А.В. US 109279 TA 112025 04.07.2025
	
	Ответ = Новый Структура("РасчетСНП,КоррСНП",Документы.РасчетСНП.ПустаяСсылка(),Документы.РасчетСНП.ПустаяСсылка());
	
	Если НЕ ЗначениеЗаполнено(ГУИДСтрокиДохода) Тогда
		Возврат Ответ;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РасчетСНП.Ссылка КАК Ссылка,
		|	ЕСТЬNULL(РасчетСНП1.Ссылка, ЗНАЧЕНИЕ(Документ.РасчетСНП.ПустаяСсылка)) КАК СсылкаКорр,
		|	ЕСТЬNULL(РасчетСНП1.ЭтоКорректировка, ЛОЖЬ) КАК ЭтоКорректировка
		|ИЗ
		|	Документ.РасчетСНП КАК РасчетСНП
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасчетСНП КАК РасчетСНП1
		|		ПО РасчетСНП1.ПервыйРасчет = РасчетСНП.Ссылка
		|			И РасчетСНП1.ЭтоКорректировка
		|ГДЕ
		|	РасчетСНП.ГУИДСтрокиДохода = &ГУИДСтрокиДохода";
	
	Запрос.УстановитьПараметр("ГУИДСтрокиДохода", ГУИДСтрокиДохода);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Ответ.Вставить("РасчетСНП",ВыборкаДетальныеЗаписи.Ссылка);
		Ответ.Вставить("КоррСНП",ВыборкаДетальныеЗаписи.СсылкаКорр);
	КонецЦикла;
	
	Возврат Ответ;
	
КонецФункции

