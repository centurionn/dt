&НаКлиенте
Процедура СвязьУчетныхЕдиницБезЖДНПриИзменении(Элемент)
	текД = Элементы.СвязьУчетныхЕдиниц.ТекущиеДанные;
	Для каждого СтрокаСвязьУчетныхЕдиниц Из Объект.СвязьУчетныхЕдиниц Цикл
		Если СтрокаСвязьУчетныхЕдиниц.ГУИДСтрокиЗаявки = текД.ГУИДСтрокиЗаявки Тогда
			СтрокаСвязьУчетныхЕдиниц.БезЖДН = ТекД.БезЖДН;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ИсключениеКТКВыбратьВсе(Команда)
	
	Для Каждого Стр Из Объект.СвязьУчетныхЕдиниц Цикл
		Если Не Стр.ГотовоКВыставлению И Не Стр.Удалена И Не Стр.НеАктивна И Элементы.СвязьУчетныхЕдиниц.ПроверитьСтроку(Стр.ПолучитьИдентификатор()) Тогда
			Стр.БезЖДН = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИсключениеКТКСнятьВсе(Команда)
	
	Для Каждого Стр Из Объект.СвязьУчетныхЕдиниц Цикл
		Если Элементы.СвязьУчетныхЕдиниц.ПроверитьСтроку(Стр.ПолучитьИдентификатор()) Тогда
			Стр.БезЖДН = Ложь;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявкиЗаявкаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка) //ДИТ Шевченко А.В. 59985 12.12.2022
	
	//Субботин В.А 68592 09.06.2023 начало
	Отказ = Ложь;		
	ПроверкаЗаявки(Отказ);       
	
	СтандартнаяОбработка = НЕ Отказ;   
	
	Если НЕ СтандартнаяОбработка тогда
		Возврат
	КонецЕсли;
	//Субботин В.А 68592 09.06.2023 конец     
	
	// ДИТ US 79847 ТА 80505 Сержантова А.С. Начало: 15.05.2024    
	ТекущиеДанные = Элементы.Заявки.ТекущиеДанные;  
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		ЗаявкаПроведена = ОбщегоНазначенияВызовСервера.ЗначениеРеквизитаОбъекта(ВыбранноеЗначение, "Проведен");
		Если не ЗаявкаПроведена Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				"" + ВыбранноеЗначение + " не проведена. Проведите заявку для добавления в документ.",
				,   
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Заявки", ТекущиеДанные.НомерСтроки, "Заявка"),
				"Объект",
				Отказ);    
			ВыбранноеЗначение = ПредопределенноеЗначение("Документ.Заявка.ПустаяСсылка");
			СтандартнаяОбработка = Истина;
			Возврат;
		КонецЕсли; 
	КонецЕсли;
	// ДИТ US 79847 ТА 80505 Сержантова А.С. Конец: 15.05.2024
	
	//ДИТ Шевченко А.В. 59985 12.12.2022 -начало
	Если ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.Заявка") Тогда
		ДоговорДействует = Истина;
		СтруктураРек = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(ВыбранноеЗначение,"Договор,Отправка,Прибытие,Дата");
		Если ЗначениеЗаполнено(СтруктураРек.Договор) И ЗначениеЗаполнено(СтруктураРек.Отправка) и НЕ ЗначениеЗаполнено(СтруктураРек.Прибытие) Тогда
			ДоговорДействует = ПроверитьПериодДействияДоговора(СтруктураРек.Договор,СтруктураРек.Отправка,Дата(1,1,1),Истина);
		ИначеЕсли ЗначениеЗаполнено(СтруктураРек.Договор) И НЕ ЗначениеЗаполнено(СтруктураРек.Отправка) и ЗначениеЗаполнено(СтруктураРек.Прибытие) Тогда
			ДоговорДействует = ПроверитьПериодДействияДоговора(СтруктураРек.Договор,СтруктураРек.Прибытие,Дата(1,1,1),Истина);
		ИначеЕсли ЗначениеЗаполнено(СтруктураРек.Договор) И ЗначениеЗаполнено(СтруктураРек.Отправка) и ЗначениеЗаполнено(СтруктураРек.Прибытие) Тогда
			ДоговорДействует = ПроверитьПериодДействияДоговора(СтруктураРек.Договор,СтруктураРек.Отправка,СтруктураРек.Прибытие);	
		ИначеЕсли ЗначениеЗаполнено(СтруктураРек.Договор) И НЕ ЗначениеЗаполнено(СтруктураРек.Отправка) и НЕ ЗначениеЗаполнено(СтруктураРек.Прибытие) Тогда
			ДоговорДействует = ПроверитьПериодДействияДоговора(СтруктураРек.Договор,СтруктураРек.Дата,Дата(1,1,1),Истина);
		КонецЕсли;
		Если НЕ ДоговорДействует Тогда
			Автопролонгация = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(СтруктураРек.Договор,"Автопролонгация");
			Если Автопролонгация Тогда
				СообщениеТекст = "Заявка не добавлена. Договор в заявке не продлен на текущий год, необходимо продлить договор через отдел делопроизводства";
			Иначе
				СообщениеТекст = "Заявка не добавлена. Срок действия договора в заявке истек, необходимо оформить ДС на продления срока действия договора";
			КонецЕсли;
			ВызватьИсключение СообщениеТекст;
		КонецЕсли;	
	КонецЕсли;
		//ДИТ Шевченко А.В. 59985 12.12.2022 -конец
КонецПроцедуры

&НаКлиенте
Процедура СвязьУчетныхЕдиницПодтверждающиеДокументыПриИзменении(Элемент)
	
	// ДИТ 64186 Давудов М.А. Начало: 07.03.2023
	ОчиститьСообщения();
	
	ТекущиеДанные = Элементы.СвязьУчетныхЕдиниц.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СнятьПризнак = НЕ ТекущиеДанные.ПодтверждающиеДокументы;
	
	Отказ = Ложь;
	
	Если Не СнятьПризнак Тогда
		Если Не Объект.Проведен Тогда
			ТекстСообщения = 
				НСтр("ru = 'Перед установкой признака ""Подтверждающие документы"" необходимо провести документ'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТекущиеДанные.Клиент) Тогда
			ТекстСообщения = 
				НСтр("ru = 'Перед установкой признака ""Подтверждающие документы"" необходимо указать клиента'");
			ПутьКДаннымСтроки = 
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Объект.СвязьУчетныхЕдиниц", ТекущиеДанные.НомерСтроки, "Клиент");
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				ТекстСообщения,
				,
				ПутьКДаннымСтроки,
				,
				Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТекущиеДанные.Контейнер) Тогда
			ТекстСообщения = 
				НСтр("ru = 'Перед установкой признака ""Подтверждающие документы"" необходимо указать контейнер'");
			ПутьКДаннымСтроки = 
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Объект.СвязьУчетныхЕдиниц", ТекущиеДанные.НомерСтроки, "Контейнер");
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				ТекстСообщения,
				,
				ПутьКДаннымСтроки,
				,
				Отказ);
		КонецЕсли;
	КонецЕсли;
	
	Если Отказ Тогда
		ТекущиеДанные.ПодтверждающиеДокументы = Ложь;
		Возврат;
	КонецЕсли;
	
	Если СнятьПризнак Тогда
		
		Если ЗаполнятьПоПервойСтроке Тогда
			Для Сч = 0 По Объект.СвязьУчетныхЕдиниц.Количество() - 1 Цикл
				ИдентификаторСтроки = Объект.СвязьУчетныхЕдиниц[Сч].ПолучитьИдентификатор();
				СтрокаСоответствуетОтбору = Элементы.СвязьУчетныхЕдиниц.ПроверитьСтроку(ИдентификаторСтроки);
				
				Если Не СтрокаСоответствуетОтбору
				 ИЛИ ТекущиеДанные.Клиент <> Объект.СвязьУчетныхЕдиниц[Сч].Клиент Тогда
					Продолжить;
				КонецЕсли;
				
				Объект.СвязьУчетныхЕдиниц[Сч].ПодтверждающиеДокументы = Ложь;
			КонецЦикла;
		КонецЕсли;
		
	Иначе
		
		МассивИдентификаторовСтрок = Новый Массив;
		
		Если Не ЗаполнятьПоПервойСтроке Тогда
			МассивИдентификаторовСтрок.Добавить(ТекущиеДанные.ПолучитьИдентификатор());
		Иначе
			Для Сч = 0 По Объект.СвязьУчетныхЕдиниц.Количество() - 1 Цикл 
				ИдентификаторСтроки = Объект.СвязьУчетныхЕдиниц[Сч].ПолучитьИдентификатор();
				СтрокаСоответствуетОтбору = Элементы.СвязьУчетныхЕдиниц.ПроверитьСтроку(ИдентификаторСтроки);
				
				Если Не СтрокаСоответствуетОтбору
				 ИЛИ ТекущиеДанные.Клиент <> Объект.СвязьУчетныхЕдиниц[Сч].Клиент
				 ИЛИ Не ЗначениеЗаполнено(Объект.СвязьУчетныхЕдиниц[Сч].Контейнер) Тогда
					Продолжить;
				КонецЕсли;
				
				МассивИдентификаторовСтрок.Добавить(ИдентификаторСтроки);
			КонецЦикла;
		КонецЕсли;
		
		Если МассивИдентификаторовСтрок.Количество() > 0 Тогда
			
			МассивПроверенныхКТК = ПолучитьМассивПроверенныхКТК(ТекущиеДанные.Клиент, МассивИдентификаторовСтрок);
			
			ШаблонСообщения = НСтр("ru = 'КТК № %1 не включен в реализацию'");
			
			Для Каждого ЭлементИдентификатор Из МассивИдентификаторовСтрок Цикл
				СтрокаТЧ = Объект.СвязьУчетныхЕдиниц.НайтиПоИдентификатору(ЭлементИдентификатор);
				
				Если МассивПроверенныхКТК.Найти(СтрокаТЧ.Контейнер) = Неопределено Тогда
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, СтрокаТЧ.Контейнер);
					ПутьКДаннымСтроки = 
						ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Объект.СвязьУчетныхЕдиниц", СтрокаТЧ.НомерСтроки, "Контейнер");
					
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, ПутьКДаннымСтроки);
					СтрокаТЧ.ПодтверждающиеДокументы = Ложь;
				Иначе
					СтрокаТЧ.ПодтверждающиеДокументы = Истина;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	// ДИТ 64186 Давудов М.А. Конец: 07.03.2023
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивПроверенныхКТК(ТекущиеДанныеКлиент, МассивИдентификаторовСтрок)
	
	// ДИТ 64186 Давудов М.А. Начало: 07.03.2023
	МассивКТК = Новый Массив;
	МассивПроверенныхКТК = Новый Массив;
	
	Для Каждого ЭлементИдентификатор Из МассивИдентификаторовСтрок Цикл
		СтрокаТЧ = Объект.СвязьУчетныхЕдиниц.НайтиПоИдентификатору(ЭлементИдентификатор);
		
		Если ЗначениеЗаполнено(СтрокаТЧ.Контейнер)
		   И МассивКТК.Найти(СтрокаТЧ.Контейнер) = Неопределено Тогда
			МассивКТК.Добавить(СтрокаТЧ.Контейнер);
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сделка", Объект.Ссылка);
	Запрос.УстановитьПараметр("Контрагент", ТекущиеДанныеКлиент);
	Запрос.УстановитьПараметр("МассивКТК", МассивКТК);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РеализацияТоваровУслугРасшифровкаУслугПоТС.Контейнер КАК Контейнер
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.РасшифровкаУслугПоТС КАК РеализацияТоваровУслугРасшифровкаУслугПоТС
	|ГДЕ
	|	РеализацияТоваровУслугРасшифровкаУслугПоТС.Ссылка.Проведен
	// Евросиб US 82073 TA 114490 Рыбьяков К.А. 24.07.2025 ((
	//|	И РеализацияТоваровУслугРасшифровкаУслугПоТС.УдалитьСделка = &Сделка
	|	И РеализацияТоваровУслугРасшифровкаУслугПоТС.КлючАналитикиСоставаПоезда.Сделка = &Сделка
	// Евросиб Рыбьяков К.А. 24.07.2025 ))
	|	И РеализацияТоваровУслугРасшифровкаУслугПоТС.Ссылка.Контрагент = &Контрагент
	|	И РеализацияТоваровУслугРасшифровкаУслугПоТС.Контейнер В(&МассивКТК)";
		
	Результат = Запрос.Выполнить();
	МассивПроверенныхКТК = Результат.Выгрузить().ВыгрузитьКолонку("Контейнер");
	
	Возврат МассивПроверенныхКТК;
	// ДИТ 64186 Давудов М.А. Конец: 07.03.2023
	
КонецФункции

&НаКлиенте
Процедура ПерейтиКСтрокеРасхода(Команда)
	ТекущиеДанные = Элементы.СвязьДоходовИРасходов.ТекущиеДанные;
	СтрокиПоИдентификаторуВСделке = Объект.Расходы.НайтиСтроки(Новый Структура("ГУИД", ТекущиеДанные.Расходы));
	Если ЗначениеЗаполнено(СтрокиПоИдентификаторуВСделке) Тогда                                  
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаЭкономикаСделки;
		Элементы.ГруппаДоходы.Скрыть();
		Элементы.ГруппаРасходы.Показать();
		Элементы.Расходы.ТекущаяСтрока = СтрокиПоИдентификаторуВСделке[0].ПолучитьИдентификатор();
	КонецЕсли;
КонецПроцедуры  

&НаКлиенте
