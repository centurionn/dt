&НаСервере
Процедура ОпределитьВидГруппировкиФрахта()
	
	МассивКонтрагентов = Объект.СвязьУчетныхЕдиниц.Выгрузить(, "Клиент").ВыгрузитьКолонку("Клиент");
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ФормированиеФинДокументов.Контрагент КАК Клиент,
	|	ВЫБОР
	|		КОГДА ФормированиеФинДокументов.ВидГруппировкиФрахта = ЗНАЧЕНИЕ(Перечисление.ФрахтФинДокументы_ВидГруппировкиФрахта.ПустаяСсылка)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ФрахтФинДокументы_ВидГруппировкиФрахта.НеРазделять)
	|		ИНАЧЕ ФормированиеФинДокументов.ВидГруппировкиФрахта
	|	КОНЕЦ КАК ВидГруппировкиФрахта,
	|	ФормированиеФинДокументов.ВидСтавки КАК ВидСтавки
	|ИЗ
	|	Справочник.ФормированиеФинДокументов КАК ФормированиеФинДокументов
	|ГДЕ
	|	НЕ ФормированиеФинДокументов.ПометкаУдаления
	|	И ФормированиеФинДокументов.ИспользоватьРасширенныеПараметры
	//|	И ФормированиеФинДокументов.ВидСтавки = &ВидСтавки
	|	И ФормированиеФинДокументов.Контрагент В(&МассивКонтрагентов)";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	//Запрос.УстановитьПараметр("ВидСтавки", Перечисления.ФрахтФинДокументы_ВидСтавки.ОтдельныеСтавки);
	Запрос.УстановитьПараметр("МассивКонтрагентов", МассивКонтрагентов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ПараметрыПоиска = Новый Структура;
			ПараметрыПоиска.Вставить("Клиент", Выборка.Клиент);
			НайденныеСтроки = Объект.СвязьУчетныхЕдиниц.НайтиСтроки(ПараметрыПоиска);
			
			Для Каждого ТекСтрока Из НайденныеСтроки Цикл
				ЗаполнитьЗначенияСвойств(ТекСтрока, Выборка,,"Клиент");
			КонецЦикла;
		КонецЦикла;	
	//Евросиб - АСуслов 22.09.2022 17:38:11 #56288
	//(
	//Иначе
	//	Элементы.СвязьУчетныхЕдиницГотовоКВыставлениюФрахт.Видимость = Ложь;
	//)
	//Евросиб - АСуслов 22.09.2022 17:38:13 #56288
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура СвязьУчетныхЕдиницГотовоКВыставлениюФрахтПриИзменении(Элемент)
	
	// При установке галочки галки также должны проставляться по всем КТК
	// в зависимости от группировки, указанной в настройке правил (по всем, по коносаментам, по направлениям).
	
	ТекущиеДанные = Элементы.СвязьУчетныхЕдиниц.ТекущиеДанные;
	
	Если ТекущиеДанные.ГотовоКВыставлениюФрахт И Не ЗначениеЗаполнено(ТекущиеДанные.ВидГруппировкиФрахта) Тогда
		ТекущиеДанные.ГотовоКВыставлениюФрахт = Ложь;
		ОбщегоНазначенияКлиент.СообщитьПользователю(
						"По клиенту не найдено правил формирования финансовых документов. Установить признак «Готово к выставлению» по строке «Море» невозможно.",
						,
						ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СвязьУчетныхЕдиниц", ТекущиеДанные.НомерСтроки, "ГотовоКВыставлению"),
						"Объект");
		Возврат;
	КонецЕсли;
	
	Если флКакПроставлятьГотовоКВыставлению = 2 Тогда
		
		ПараметрыПоиска = Новый Структура;
		ПараметрыПоиска.Вставить("Клиент", ТекущиеДанные.Клиент);
		//Евросиб - АСуслов 22.09.2022 18:52:05 #
		//(
		ПараметрыПоиска.Вставить("ВидТранспортногоСообщения", ПредопределенноеЗначение("Перечисление.ВидыТранспортныхСообщений.Море"));
		//)
		//Евросиб - АСуслов 22.09.2022 18:52:06 #
		
		Если  ТекущиеДанные.ВидСтавки = ПредопределенноеЗначение("Перечисление.ФрахтФинДокументы_ВидСтавки.ОтдельныеСтавки")
			И ТекущиеДанные.ВидГруппировкиФрахта = ПредопределенноеЗначение("Перечисление.ФрахтФинДокументы_ВидГруппировкиФрахта.ПоКоносаментам") Тогда
			ПараметрыПоиска.Вставить("Коносамент", ТекущиеДанные.Коносамент);
		ИначеЕсли ТекущиеДанные.ВидСтавки = ПредопределенноеЗначение("Перечисление.ФрахтФинДокументы_ВидСтавки.ОтдельныеСтавки")
			И ТекущиеДанные.ВидГруппировкиФрахта = ПредопределенноеЗначение("Перечисление.ФрахтФинДокументы_ВидГруппировкиФрахта.ПоНаправлениямПеревозки") Тогда
			ПараметрыПоиска.Вставить("ПортНазначения", ТекущиеДанные.ПортНазначения);	
		КонецЕсли;	
		
		ПодходящиеСтроки = Объект.СвязьУчетныхЕдиниц.НайтиСтроки(ПараметрыПоиска);
		
		Для Каждого ТекущаяСтрока Из ПодходящиеСтроки Цикл
			//ТекущаяСтрока.ГотовоКВыставлениюФрахт = ТекущиеДанные.ГотовоКВыставлениюФрахт;
			ТекущаяСтрока.ГотовоКВыставлениюФрахт = ТекущиеДанные.ГотовоКВыставлениюФрахт;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры
