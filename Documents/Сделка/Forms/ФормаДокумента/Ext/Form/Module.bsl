		//ДИТ, Беляев СЮ, ТА54910, 19-07-2022, начало
		ПоказатьПредупреждениеПриВыполненииПоКоманде("Даты в рейсах не заполнены! Заполните их и повторите попытку!", Команда);
		//ДИТ, Беляев СЮ, ТА54910, 19-07-2022, конец
		
	ИначеЕсли РЕЗ = 1 Тогда
		
		//ДИТ, Беляев СЮ, ТА54910, 19-07-2022, начало
		ПоказатьПредупреждениеПриВыполненииПоКоманде("Данные по отправкам обновлены!", Команда);
		//ДИТ, Беляев СЮ, ТА54910, 19-07-2022, конец
		
	ИначеЕсли ТипЗнч(РЕЗ) = Тип("Массив") Тогда
		
		ОпОп = Новый ОписаниеОповещения("ОбработкаПодбораВагонныхЖДН", ЭтаФорма);
