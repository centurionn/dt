&НаСервереБезКонтекста
Процедура ОбработкаЗаполненияДат_сервер(Сделка, Вариант)
	
	// Слежение по ЭТРАН
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТехнологическаяСхемаТЧ.Операция КАК Операция
	               |ИЗ
	               |	РегистрСведений.ТехнологическаяСхема КАК ТехнологическаяСхема
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
	               |		ПО ТехнологическаяСхема.ТСх = ТехнологическаяСхемаТЧ.Ссылка
	               |ГДЕ
	               |	ТехнологическаяСхема.ПредметТСх = &ПредметТСх
	               |	И ТехнологическаяСхема.Вариант = &Вариант
	               |	И ТехнологическаяСхемаТЧ.Операция.Услуга.ОперацияДвижетсяПоСлежениюРЖД";
	Запрос.УстановитьПараметр("ПредметТСх", Сделка);
	Запрос.УстановитьПараметр("Вариант", Вариант.Вариант);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		ОперацияОбъект = Ответ.Операция.ПолучитьОбъект();
		ОбнаруженоЗавершениеОперации = неопределено;
		
		НадоЗаписать = Ложь;
		Если ОперацияОбъект.Грузы.Количество() = 0 Тогда
			РезЗапроса = ПолучитьДатыПоСделке(Сделка);
			Если ЗначениеЗаполнено(РезЗапроса.ДатаНачала) И (ОперацияОбъект.ДатаОтправления <> РезЗапроса.ДатаНачала ИЛИ ОперацияОбъект.ДатаНазначения <> РезЗапроса.ДатаОкончания) Тогда
				НадоЗаписать = Истина;
				ОперацияОбъект.ДатаОтправления = РезЗапроса.ДатаНачала;
				ОперацияОбъект.ДатаНазначения = РезЗапроса.ДатаОкончания;
				ОбнаруженоЗавершениеОперации = ЗначениеЗаполнено(ОперацияОбъект.ДатаНазначения);
			КонецЕсли;
		Иначе
			Для каждого Стр из ОперацияОбъект.Грузы Цикл
				Если ЗначениеЗаполнено(Стр.ТС) Тогда
					РезЗапроса = ПолучитьДатыПоСделкеИВагону(Сделка, Стр.ТС);
					Если ЗначениеЗаполнено(РезЗапроса.ДатаНачала) Тогда
						НадоЗаписать = Истина;
						Стр.ДатаОтправления = РезЗапроса.ДатаНачала;
						Стр.ДатаПрибытия = РезЗапроса.ДатаОкончания;
					КонецЕсли;
				ИначеЕсли ЗначениеЗаполнено(Стр.ТЕ) Тогда
					РезЗапроса = ПолучитьДатыПоСделкеИКТК(Сделка, Стр.ТЕ);
					Если ЗначениеЗаполнено(РезЗапроса.ДатаНачала) Тогда
						НадоЗаписать = Истина;
						Стр.ДатаОтправления = РезЗапроса.ДатаНачала;
						Стр.ДатаПрибытия = РезЗапроса.ДатаОкончания;
					КонецЕсли;
				КонецЕсли;
				ОбнаруженоЗавершениеОперации = (ОбнаруженоЗавершениеОперации = Истина ИЛИ ОбнаруженоЗавершениеОперации = Неопределено) И ЗначениеЗаполнено(Стр.ДатаПрибытия);
			КонецЦикла;
		КонецЕсли;
		
		Если НадоЗаписать Тогда
			Если ОбнаруженоЗавершениеОперации = Истина Тогда
				Для каждого Стр из ОперацияОбъект.Состояния Цикл
					Если Стр.Состояние = Справочники.Состояния.Выполнение Тогда Стр.Статус = Перечисления.СтатусыЭтапов.Выполнен; КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Попытка
				ОперацияОбъект.Записать(?(ОперацияОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	///////////////////-------------------------------------
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТехнологическаяСхемаТЧ.Операция КАК Операция
	               |ИЗ
	               |	РегистрСведений.ТехнологическаяСхема КАК ТехнологическаяСхема
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
	               |		ПО ТехнологическаяСхема.ТСх = ТехнологическаяСхемаТЧ.Ссылка
	               |ГДЕ
	               |	ТехнологическаяСхема.ПредметТСх = &ПредметТСх
	               |	И ТехнологическаяСхема.Вариант = &Вариант
	               |	И ТехнологическаяСхемаТЧ.Операция.Услуга.ОперацияДвижетсяПоСлежениюSeaRates";
	Запрос.УстановитьПараметр("ПредметТСх", Сделка);
	Запрос.УстановитьПараметр("Вариант", Вариант.Вариант);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		ОперацияОбъект = Ответ.Операция.ПолучитьОбъект();
		НадоЗаписать = Ложь;
		Если ОперацияОбъект.Грузы.Количество() = 0 Тогда
			РезЗапроса = ПолучитьДатыПоСделкеПоКоносаментам(Сделка);
			Если ЗначениеЗаполнено(РезЗапроса.ДатаНачала) ИЛИ ЗначениеЗаполнено(РезЗапроса.ДатаНачалаПлан) Тогда
				НадоЗаписать = Истина;
				ОперацияОбъект.ДатаОтправленияФакт = РезЗапроса.ДатаНачала;
				ОперацияОбъект.ДатаНазначенияФакт = РезЗапроса.ДатаОкончания;
				ОперацияОбъект.ДатаОтправления = РезЗапроса.ДатаНачалаПлан;
				ОперацияОбъект.ДатаНазначения = РезЗапроса.ДатаОкончанияПлан;
			КонецЕсли;
		Иначе
			Для каждого Стр из ОперацияОбъект.Грузы Цикл
				Если ЗначениеЗаполнено(Стр.ТЕ) Тогда
					РезЗапроса = ПолучитьДатыПоСделкеИКоносаменту(Сделка, Стр.ТЕ);
					Если ЗначениеЗаполнено(РезЗапроса.ДатаНачала) ИЛИ ЗначениеЗаполнено(РезЗапроса.ДатаНачалаПлан) Тогда
						НадоЗаписать = Истина;
						Стр.ДатаОтправления = РезЗапроса.ДатаНачала;
						Стр.ДатаПрибытия = РезЗапроса.ДатаОкончания;
						ОперацияОбъект.ДатаОтправления = РезЗапроса.ДатаНачалаПлан;
						ОперацияОбъект.ДатаНазначения = РезЗапроса.ДатаОкончанияПлан;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если НадоЗаписать Тогда
			Если ОбнаруженоЗавершениеОперации = Истина Тогда
				Для каждого Стр из ОперацияОбъект.Состояния Цикл
					Если Стр.Состояние = Справочники.Состояния.Выполнение Тогда Стр.Статус = Перечисления.СтатусыЭтапов.Выполнен; КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Попытка
				ОперацияОбъект.Записать(?(ОперацияОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДатыПоСделке(Сделка)
	
	Результат = Новый Структура("ДатаНачала, ДатаОкончания");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	МИНИМУМ(СделкаСвязьУчетныхЕдиниц.ЖДН.ДатаОтправления) КАК ЖДНДатаОтправления,
	               |	МАКСИМУМ(СделкаСвязьУчетныхЕдиниц.ЖДН.ДатаПрибытия) КАК ЖДНДатаПрибытия
	               |ИЗ
	               |	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	               |ГДЕ
	               |	СделкаСвязьУчетныхЕдиниц.Ссылка = &Ссылка
	               |	И СделкаСвязьУчетныхЕдиниц.ЖДН <> ЗНАЧЕНИЕ(Документ.э_Накладная.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Ссылка", Сделка);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		
		Результат.ДатаНачала = Ответ.ЖДНДатаОтправления;
		Результат.ДатаОкончания = Ответ.ЖДНДатаПрибытия;
		
	КонецЕсли;
	
	Возврат Результат;
	
