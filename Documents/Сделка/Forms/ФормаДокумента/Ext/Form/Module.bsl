	Для каждого ПолеДанных Из ЭлементыДоходы Цикл
		Если ПоляИсключения.Найти(ПолеДанных.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли; 
		ПолеУО = УО.Поля.Элементы.Добавить();
		ПолеУО.Использование = Истина;
		ПолеУО.Поле = Новый ПолеКомпоновкиДанных(ПолеДанных.Имя);
		Если ТипЗнч(ПолеДанных) = Тип("ГруппаФормы") Тогда
			ДобавитьПоляБлокировкиРекурсивно(УО, ПоляИсключения, ПолеДанных.ПодчиненныеЭлементы);
		КонецЕсли;
	КонецЦикла; 
	
КонецПроцедуры
