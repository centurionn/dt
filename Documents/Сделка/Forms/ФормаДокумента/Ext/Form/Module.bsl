&НаКлиенте
Процедура ОбработкаВыбораСхемы(Параметр1 = неопределено, параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	Найдено = Ложь;
	Для каждого Стр из ТСхОглавление.ПолучитьЭлементы() Цикл
		Если Стр.Вариант = Параметр1.Вариант Тогда
			Стр.ЭлементТСх = Параметр1.ЭлементТСх;
			Найдено = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ Найдено Тогда
		ОбработкаНовогоВарианта(Параметр1.Вариант, неопределено);
		Для каждого Стр из ТСхОглавление.ПолучитьЭлементы() Цикл
			Если Стр.Вариант = Параметр1.Вариант Тогда
				Стр.ЭлементТСх = Параметр1.ЭлементТСх;
				Найдено = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ТСхОглавлениеПриАктивизацииСтроки(неопределено);
	
КонецПроцедуры

