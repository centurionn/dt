&НаКлиенте
Процедура ПерезаполнитьЭкономикуПодсыла(Команда)
	
	Объект.Доходы.Очистить();
	Объект.Расходы.Очистить();
	Объект.ДоходыВагоны.Очистить();
	Объект.ДоходыКТК.Очистить();
	Объект.ДоходыТД.Очистить();
	объект.СвязьДоходовИРасходов.Очистить();
	
	Для каждого Стр из Объект.СвязьУчетныхЕдиниц Цикл
		Если ЗначениеЗаполнено(Стр.Коносамент) Тогда
			ВСделкеИдетРаботаПоКоносаментам = Истина;
		КонецЕсли;
		НСтр = СписокГотовыхКОформлениюДоговоров.Добавить();
		ЗаполнитьЗначенияСвойств(НСтр, Стр);
		Если ЗначениеЗаполнено(Стр.Коносамент) Тогда
			НСтр.НомерКоносамента = ПолучитьНомерКС(Стр.Коносамент);
		КонецЕсли;
	КонецЦикла;
	
	СписокКлиентов = Новый СписокЗначений;
	Для каждого СтрокаДоговор Из СписокГотовыхКОформлениюДоговоров Цикл
		Если СписокКлиентов.НайтиПоЗначению(СтрокаДоговор.Клиент) = Неопределено Тогда
			СписокКлиентов.Добавить(СтрокаДоговор.Клиент, СтрокаДоговор.Клиент, Истина);
		КонецЕсли; 
	КонецЦикла;
	
	ОбработкаВыбораКлиентовИзСписка(СписокКлиентов, неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодсылПорожнихПриИзменении(Элемент)
	//Евросиб Каблов 28.06.2022 ( Task 53759
	Если Объект.ПодсылПорожних Тогда
		Калькуляции = Новый Массив;
		//ДИТ, Беляев СЮ, US 80045, 07-02-2024, начало
		БлокироватьИзменение = Ложь;
		СтрокаСообщения = "";
		//ДИТ, Беляев СЮ, US 80045, 07-02-2024, конец
		Для Каждого Стр Из Объект.СвязьУчетныхЕдиниц Цикл
			//ДИТ, Беляев СЮ, Ticket#0298676, 25-01-2023, начало
			Если Стр.НеАктивна Или Стр.Удалена Тогда
				Продолжить;
			КонецЕсли;
			//ДИТ, Беляев СЮ, Ticket#0298676, 25-01-2023, конец
			Если Калькуляции.Найти(Стр.Калькуляция) = Неопределено Тогда
				Калькуляции.Добавить(Стр.Калькуляция);
			КонецЕсли;
			//ДИТ, Беляев СЮ, US 80045, 07-02-2024, начало
			Если Стр.ГотовоКВыставлению Тогда
				БлокироватьИзменение = Истина;
				СтрокаСообщения = " указанного Готово к выставлению в Составе поезда";
			КонецЕсли;
			//ДИТ, Беляев СЮ, US 80045, 07-02-2024, конец
		КонецЦикла;
		КалькуляцииБезПодсыла = ПолучитьКалькуляцииБезПризнакаПодсылПорожних(Калькуляции);
		Если ЗначениеЗаполнено(КалькуляцииБезПодсыла) Тогда
			Объект.ПодсылПорожних = Ложь;
			ТекстСообщения = "В калькуляциях не предусмотрено оформление порожней сделки.";
			ПоказатьПредупреждение(, ТекстСообщения);
		КонецЕсли;
		
		//ДИТ, Беляев СЮ, US 80045, 07-02-2024, начало
		Для Каждого СтрДохода Из Объект.Доходы Цикл
			БлокироватьИзменение = Истина;
			СтрокаСообщения = СтрШаблон("%1%2 дох.строк в экономике",
										СтрокаСообщения,
										?(ЗначениеЗаполнено(СтрокаСообщения), ",", ""));
			Прервать;
		КонецЦикла;
		
		Если БлокироватьИзменение Тогда
			Объект.ПодсылПорожних = Ложь;
			ТекстСообщения = "Смена признака Груженое плечо невозможно по причине наличия "+СтрокаСообщения;
			ПоказатьПредупреждение(, ТекстСообщения);
		КонецЕсли;
		//ДИТ, Беляев СЮ, US 80045, 07-02-2024, конец
	Иначе 
		//ДИТ, Беляев СЮ, US 80045, 07-02-2024, начало
		БлокироватьИзменение = Ложь;
		Для Каждого СтрРасхода Из Объект.Расходы Цикл
			Если НЕ СтрРасхода.УслугаОтключена И СтрРасхода.Подсыл Тогда
				БлокироватьИзменение = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если БлокироватьИзменение Тогда
			Объект.ПодсылПорожних = Истина;
			ТекстСообщения = "Смена признака Порожнее плечо невозможно по причине наличия в расходах сделки НЕ отключенных строк с признаком Подсыл";
			ПоказатьПредупреждение(, ТекстСообщения);
		КонецЕсли;
		//ДИТ, Беляев СЮ, US 80045, 07-02-2024, конец
	КонецЕсли;
	//Евросиб Каблов 28.06.2022 )
	//Элементы.ДоходыПерезаполнитьЭкономикуПодсыла.Видимость = Объект.ПодсылПорожних; //ДИТ, Беляев СЮ, US 80045, 07-02-2024, закомментировал (не используется)
КонецПроцедуры

