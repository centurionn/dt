&НаКлиенте
Процедура excel_ЗаливкаЖДН(Команда)

	//ДИТ Шевченко А.В 26.07.2022 54378 -Начало	
	ПараметрыФормы = Новый Структура;
	ДатаМин = Дата(1,1,1);
	ДатаМакс = Дата(1,1,1);
	Для Каждого СтрокаРейс Из Объект.Рейсы Цикл
		Если ТипЗнч(СтрокаРейс.Рейс) = Тип("СправочникСсылка.РейсыЖД") Тогда
			ДатаМин  = Макс(ДатаМин, СтрокаРейс.ОтправлениеПлан);
			ДатаМакс = Макс(ДатаМакс, СтрокаРейс.ПрибытиеПлан);
		КонецЕсли;
	КонецЦикла;
	ПараметрыФормы.Вставить("ДатаНачалаПоискаНакладных", 	ДатаМин - ?(Объект.ГоризонтПоискаНакладных=0,40*24*3600,Объект.ГоризонтПоискаНакладных*24*3600));
