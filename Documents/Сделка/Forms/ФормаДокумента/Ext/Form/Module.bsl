Процедура ПолучитьИсправитьАкцепты(Сделка, Соответ, ВсеОшибки)
	
	СоотОбСделок = Новый Соответствие;
	
	ТЗСтрУдалено = Новый ТаблицаЗначений;
	ТЗСтрУдалено.Колонки.Добавить("Сделка");
	ТЗСтрУдалено.Колонки.Добавить("ИзнТабРасхода");
	ТЗСтрУдалено.Колонки.Добавить("УспехПроводки");
	
	Для каждого Стр Из Соответ Цикл
		
		// Удаление расхода по КТ из порожнего плеча:
		Для каждого СтрРасх Из Стр.Значение.МассивРасходовПоКТК Цикл
			
			РезПоискаОб = СоотОбСделок.Получить(СтрРасх.Сделка);
			Если РезПоискаОб = Неопределено Тогда
				ОБ = СтрРасх.Сделка.ПолучитьОбъект();
				СоотОбСделок.Вставить(СтрРасх.Сделка, ОБ);
			Иначе
				
				ОБ = РезПоискаОб;
				
			КонецЕсли; 
			
			ИскМасСтр = ОБ.Расходы.НайтиСтроки(Новый Структура("ГУИД", СтрРасх.ГУИД) );
			
			Для каждого ТекСтр Из ИскМасСтр Цикл
				
				//////// РАБОТАЕТ, ПОКА 1 СТРОКА РАСХОДА = 1 КТ
				РезПоискаСд = ТЗСтрУдалено.НайтиСтроки(Новый Структура("Сделка", СтрРасх.Сделка) );
				
				Если РезПоискаСд.Количество()=0 Тогда
					
					НовСтрДляПоиска = ТЗСтрУдалено.Добавить();
					НовСтрДляПоиска.Сделка = СтрРасх.Сделка;
					НовСтрДляПоиска.ИзнТабРасхода = ОБ.Расходы.Выгрузить(Новый Структура("ГУИД", СтрРасх.ГУИД) );
					
				Иначе
					
					ИзнТабРасхода = РезПоискаСд[0].ИзнТабРасхода;
					
					ПереносДан = ОБ.Расходы.Выгрузить(Новый Структура("ГУИД", СтрРасх.ГУИД) );
					
					Для каждого Стр_ПереносДан Из ПереносДан Цикл
					
						НовСтрДляПоиска = ИзнТабРасхода.Добавить();
						ЗаполнитьЗначенияСвойств(НовСтрДляПоиска, Стр_ПереносДан);
					
					КонецЦикла; 
					
				КонецЕсли; 
				////////
				
				Если ТекСтр.Количество > 1 Тогда
					
					Сообщить("По строке расхода обнаружено более 1 кол ед. Это ошибка!");
				Иначе
					ТекСтр.УслугаОтключена = Истина;
				КонецЕсли; 
			КонецЦикла; 
		КонецЦикла; 
	КонецЦикла; 
	
	// Проведение сделок
	Для каждого СтрСоот Из СоотОбСделок Цикл
		
		Об = СтрСоот.Значение;
		
		Ош = Ложь;
		ОпОш = "";
		
		Попытка
			
			Об.Записать(РежимЗаписиДокумента.Проведение);
			
		Исключение
			ОпОш = ОписаниеОшибки();
			Ош = Истина;
		КонецПопытки;
		
		Если ОпОш <> "" Тогда
			
			ВсеОшибки = ВсеОшибки + ?(ВсеОшибки="", "", "; ") + ОпОш;
			
		КонецЕсли;
		
		Если НЕ Ош Тогда
		
			ИскМасСд = ТЗСтрУдалено.НайтиСтроки(Новый Структура("Сделка", СтрСоот.Ключ) );
			Если ИскМасСд.Количество() = 0 Тогда
				// какие-то проблемы
				Продолжить;
			Иначе
				
				ИскМасСд[0].УспехПроводки = Истина; 
				
			КонецЕсли
		
		КонецЕсли; 
		
	КонецЦикла;
	
	Для каждого Стр Из Соответ Цикл
		
		// Удаление информации из Акцепта:
		Для каждого СтрАкц Из Стр.Значение.МасАкцептов Цикл
			
			ОбАкцепт = СтрАкц.Акцепт.ПолучитьОбъект();
			
			ТекСтрТЧ = ОбАкцепт.Услуги[СтрАкц.НомерСтрАкц-1];
			
			// Проверим, что старая сделка провелась без ошибок:
			ИскМасСд = ТЗСтрУдалено.НайтиСтроки(Новый Структура("Сделка", ТекСтрТЧ.Сделка) );
			Если ИскМасСд.Количество() = 0 Тогда
				// какие-то проблемы
				Продолжить;
			Иначе
				
				Если ИскМасСд[0].УспехПроводки = ИСТИНА Тогда
				
					// Все ГУД
				
				Иначе
				
					Продолжить;
				
				КонецЕсли; 
				
			КонецЕсли; 
			
			ТекСтрТЧ.Сделка = Сделка;
			ТекСтрТЧ.ИдентификаторСтрокиРасходовВСделке = СтрАкц.NEW_ГУИД;
			
			Ош = Ложь;
			ОпОш = "";
			
			Попытка
				
				ОбАкцепт.Записать(РежимЗаписиДокумента.Проведение);
				
			Исключение
				ОпОш = ОписаниеОшибки();
				Ош = Истина;
			КонецПопытки; 
			
			Если ОпОш <> "" Тогда
				
				ВсеОшибки = ВсеОшибки + ?(ВсеОшибки="", "", "; ") + ОпОш;
				
			КонецЕсли;
			
		КонецЦикла; 
		
	КонецЦикла;
	
КонецПроцедуры // ПолучитьИсправитьАкцепты(Сделка, Соответ, ВсеОшибки)

&НаСервереБезКонтекста
Функция ПолучитьСуммуНДС(Сумма, СтавкаНДС, УчитыватьНДС, СуммаВключаетНДС) Экспорт
	
	Если (УчитыватьНДС) и (СуммаВключаетНДС) Тогда
		СуммаБезНДС = 100 * Сумма / (100 + СтавкаНДС);
		СуммаНДС = Сумма - СуммаБезНДС;
	Иначе
		СуммаБезНДС = Сумма;
	КонецЕсли;
	
	Если УчитыватьНДС Тогда 
		Если НЕ СуммаВключаетНДС Тогда
			СуммаНДС = СуммаБезНДС * СтавкаНДС / 100;
		КонецЕсли;
	Иначе
		СуммаНДС = 0;
	КонецЕсли;
	
	Возврат СуммаНДС;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьМассивРасходовПоЭтомуКТКСделкиПодсыла(МассивКТК, Дата, ТекСделкаСсылка)//Стр, Дата, Соответствие)
	
	// Т.К. Сделка.ДоходыКТК.КТК имеет бесконечную длину, то невозможно исполнить одним запросом быстро (Используется ПОДОБНО)
	МасАктуальныеАкцепты = Новый Массив;
	// Первым делом обходим наши возможные акцепты и актуализируем их к текущему периоду БУ:
	Для каждого Стр Из МассивКТК Цикл
	
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	СделкаСвязьУчетныхЕдиниц.Ссылка КАК Ссылка,
		               |	СделкаСвязьУчетныхЕдиниц.Ссылка.Дата КАК Дата,
		               |	СделкаСвязьУчетныхЕдиниц.ГУИД КАК ГУИД
		               |ПОМЕСТИТЬ Т1
		               |ИЗ
		               |	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
		               |ГДЕ
		               |	НЕ СделкаСвязьУчетныхЕдиниц.НеАктивна
		               |	И НЕ СделкаСвязьУчетныхЕдиниц.Ссылка.ПометкаУдаления
		               |	И СделкаСвязьУчетныхЕдиниц.Ссылка.Дата < &ДатаЪ
		               |	И СделкаСвязьУчетныхЕдиниц.Контейнер.Наименование = &КТК
		               |	И СделкаСвязьУчетныхЕдиниц.Ссылка.ПодсылПорожних
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	МАКСИМУМ(Т1.Дата) КАК Дата
		               |ПОМЕСТИТЬ Т2
		               |ИЗ
		               |	Т1 КАК Т1
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	Т1.Ссылка КАК Ссылка,
		               |	Т1.Дата КАК Дата,
		               |	Т1.ГУИД КАК ГУИД
		               |ПОМЕСТИТЬ Т3
		               |ИЗ
		               |	Т2 КАК Т2
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Т1 КАК Т1
		               |		ПО (Т1.Дата = Т2.Дата)
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	СделкаРасходы.Ссылка КАК Ссылка,
		               |	СделкаРасходы.НомерСтроки КАК НомерСтроки,
		               |	СделкаРасходы.Поставщик КАК Поставщик,
		               |	СделкаРасходы.Договор КАК Договор,
		               |	СделкаРасходы.Услуга КАК Услуга,
		               |	СделкаРасходы.Калькуляция КАК Калькуляция,
		               |	СделкаРасходы.Себестоимость КАК Себестоимость,
		               |	СделкаРасходы.Количество КАК Количество,
		               |	СделкаРасходы.СебестоимостьИтого КАК СебестоимостьИтого,
		               |	СделкаРасходы.СтавкаНДС КАК СтавкаНДС,
		               |	СделкаРасходы.СуммаНДС КАК СуммаНДС,
		               |	СделкаРасходы.НДСВключенВСтоимость КАК НДСВключенВСтоимость,
		               |	СделкаРасходы.СуммаИтого КАК СуммаИтого,
		               |	СделкаРасходы.ГУИД КАК ГУИД,
