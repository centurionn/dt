&НаСервере
Функция ПолучитьВспомогательнуюТЗ()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_Доходы ИЗ &Доходы КАК Доходы;
	//|ВЫБРАТЬ * ИЗ ВТ_Доходы КАК ВТ_Доходы
	//Евросиб(ДИТ), Беляев СЮ, US 111815 / TA 111816, 23-06-2025, начало
	|ВЫБРАТЬ *, ВТ_Доходы.Калькуляция.ПС_ВидПеревозки КАК ВидПеревозки ИЗ ВТ_Доходы КАК ВТ_Доходы 
	//Евросиб(ДИТ), Беляев СЮ, US 111815 / TA 111816, 23-06-2025, конец
	|ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Доходы КАК ВТ_Доходы2
	|	ПО ВТ_Доходы.ГУИДИсправляемойСтроки = ВТ_Доходы2.ГУИД
	|  		И ВТ_Доходы2.КорректировкаДокумента.ВидОперации = Значение(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование)
	|ГДЕ ВТ_Доходы.Подсыл = Ложь
	|	И ВТ_Доходы.НеВыставлятьКлиенту = Ложь
	|   И (ВТ_Доходы.ГУИДИсправляемойСтроки = """" ИЛИ НЕ ВТ_Доходы2.ГУИД ЕСТЬ NULL)";
	//Запрос.УстановитьПараметр("Доходы", Объект.Доходы.Выгрузить());
	//Евросиб(ДИТ), Беляев СЮ, US 88163/TA 88167, 26-07-2024, начало
	Запрос.УстановитьПараметр("Доходы", Объект.Доходы.Выгрузить(,ПолучитьСписокКолонокДоходов()));
	//Евросиб(ДИТ), Беляев СЮ, US 88163/TA 88167, 26-07-2024, конец
	РезультатЗапроса = Запрос.Выполнить();                       
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

