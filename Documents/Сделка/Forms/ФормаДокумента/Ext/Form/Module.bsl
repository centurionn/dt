&НаКлиенте
Процедура ОткрытьАктуальныйАкцепт(Команда)

	ТекД = Элементы.Расходы.ТекущиеДанные;
	Если ТекД = Неопределено
		ИЛИ НЕ ЗначениеЗаполнено(ТекД.УчДокумент) Тогда
		Возврат;
	КонецЕсли;                                             
	Поступление = ТекД.УчДокумент;
	ПараметрыФормы = Новый Структура;
	АктуальныйАкцепт = ПолучитьАктуальныйАкцепт(Поступление);
	Если ЗначениеЗаполнено(АктуальныйАкцепт) Тогда		
		ПараметрыФормы.Вставить("Ключ", АктуальныйАкцепт);
		ПараметрыФормы.Вставить("СнятьПометкуУдаления", Ложь);
		ПараметрыФормы.Вставить("ПерейтиКСтрокеУслуг", ТекД.ГУИД);
	КонецЕсли;
	
	ОткрытьФорму("Документ.Акцепт.ФормаОбъекта", ПараметрыФормы);

КонецПроцедуры

