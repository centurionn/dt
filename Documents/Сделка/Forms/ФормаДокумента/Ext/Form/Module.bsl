&НаКлиенте
Процедура УстановитьЗаголовокФормы()
	Если ЭтаФорма.ТолькоПросмотр Тогда
		ЭтаФорма.Заголовок = "ТОЛЬКО ПРОСМОТР";
	Иначе
		ЭтаФорма.Заголовок = "";
	КонецЕсли;
КонецПроцедуры
