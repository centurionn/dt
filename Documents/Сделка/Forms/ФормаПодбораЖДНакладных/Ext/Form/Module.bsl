	ВозможныеНакладные.Очистить();
	
	СписокВагонов = Новый Массив;
	
	Для Каждого Стр Из ТаблицаВагоныНакладные Цикл
		СписокВагонов.Добавить(Стр.ВагонСтрока);
	КонецЦикла;
	
	ПодборНакладныхДляВагонов(СписокВагонов);
	
