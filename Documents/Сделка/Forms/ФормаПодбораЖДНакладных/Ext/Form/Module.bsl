&НаКлиенте
Процедура ТаблицаВагоныНакладныеПередУдалением(Элемент, Отказ)
	
	ТекДанные = Элементы.ТаблицаВагоныНакладные.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НайденныеСтрокиВагон = ТаблицаВагоныНакладные.НайтиСтроки(Новый Структура("Вагон", ТекДанные.Вагон));
	Если НайденныеСтрокиВагон.Количество() = 1 Тогда
		
		ТекДанные.Накладная = Неопределено;
		ТекДанные.НомерНакладной = "";
		ТекДанные.ТранспортныйДокумент = Неопределено;		
		ТекДанные.Контейнеры.Очистить();
		
		Отказ = Истина;
		
	КонецЕсли;
	
КонецПроцедуры
