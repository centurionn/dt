
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПроверятьДействующийСтатусГВЦ = Неопределено;
	Если Не Параметры.Свойство("ПроверятьДействующийСтатусГВЦ", ПроверятьДействующийСтатусГВЦ) Тогда
		ПроверятьДействующийСтатусГВЦ = Истина;
	КонецЕсли;
	
	Если Не Параметры.Свойство("ПодборНесколькихЖДННаВагон", ПодборНесколькихЖДННаВагон) Тогда
		ПодборНесколькихЖДННаВагон = Ложь;
	КонецЕсли;
	
	ПериодОтправленияНачало = Неопределено;
	Если Параметры.Свойство("ПериодОтправленияНачало", ПериодОтправленияНачало) Тогда
		ПериодОтправления.ДатаНачала = ПериодОтправленияНачало;
	КонецЕсли;
	
	ПериодОтправленияОкончание = Неопределено;
	Если Параметры.Свойство("ПериодОтправленияОкончание", ПериодОтправленияОкончание) Тогда
		ПериодОтправления.ДатаОкончания = ПериодОтправленияОкончание;
	КонецЕсли;
	
	ЗначениеПараметра = Неопределено;
	Параметры.Свойство("СтанцияОтправления", ЗначениеПараметра);
	//Евросиб Каблов 14.04.2021 ( Ticket#0224665
	//Если ТипЗнч(ЗначениеПараметра) = Тип("СправочникСсылка.Локации") Тогда
	//	Запрос = Новый Запрос;
	//	Запрос.Текст =
	//	"ВЫБРАТЬ
	//	|	э_Станции.Ссылка КАК Станция
	//	|ИЗ
	//	|	Справочник.Локации КАК Локации
	//	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.э_Станции КАК э_Станции
	//	|		ПО (ПОДСТРОКА(Локации.КодЖДСтанции, 1, 5) = ПОДСТРОКА(э_Станции.Код, 1, 5))
	//	|ГДЕ
	//	|	Локации.Ссылка = &Локация";
	//	Запрос.УстановитьПараметр("Локация", ЗначениеПараметра);
	//	Выборка = Запрос.Выполнить().Выбрать();
	//	Если Выборка.Следующий() Тогда
	//		СтанцияОтправления = Выборка.Станция;
	//	КонецЕсли;
	//Иначе
	//	СтанцияОтправления = ЗначениеПараметра;
	//КонецЕсли;
	СтанцияОтправления = ЗначениеПараметра;
	//Евросиб Каблов 14.04.2021 )
	
	Параметры.Свойство("СтанцияНазначения", ЗначениеПараметра);
	//Евросиб Каблов 14.04.2021 ( Ticket#0224665
	//Если ТипЗнч(ЗначениеПараметра) = Тип("СправочникСсылка.Локации") Тогда
	//	Запрос = Новый Запрос;
	//	Запрос.Текст =
	//	"ВЫБРАТЬ
	//	|	э_Станции.Ссылка КАК Станция
	//	|ИЗ
	//	|	Справочник.Локации КАК Локации
	//	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.э_Станции КАК э_Станции
	//	|		ПО (ПОДСТРОКА(Локации.КодЖДСтанции, 1, 5) = ПОДСТРОКА(э_Станции.Код, 1, 5))
	//	|ГДЕ
	//	|	Локации.Ссылка = &Локация";
	//	Запрос.УстановитьПараметр("Локация", ЗначениеПараметра);
	//	Выборка = Запрос.Выполнить().Выбрать();
	//	Если Выборка.Следующий() Тогда
	//		СтанцияНазначения = Выборка.Станция;
	//	КонецЕсли;
	//Иначе
	//	СтанцияНазначения = ЗначениеПараметра;
	//КонецЕсли;
	СтанцияНазначения = ЗначениеПараметра;
	//Евросиб Каблов 14.04.2021 )
	
	Если Параметры.Свойство("МассивВагоновБезКТК") Тогда
		ТаблицаВагоныНакладные.Очистить();
		Для Каждого Эл Из Параметры.МассивВагоновБезКТК Цикл
			НовСтр = ТаблицаВагоныНакладные.Добавить();
			Если ТипЗнч(Эл) = Тип("Строка") Тогда
				НовСтр.Вагон = Справочники.ТС.НайтиПоНаименованию(Эл);
				НовСтр.ВагонСтрока = Эл;
			Иначе
				НовСтр.Вагон = Эл;
				НовСтр.ВагонСтрока = Эл.Наименование;
			КонецЕсли;
			
		КонецЦикла;
		
		ПодборНакладныхДляВагонов(Параметры.МассивВагоновБезКТК);
		
	ИначеЕсли Параметры.Свойство("ВагоныДляПодбораНакладных") Тогда
		
		Для Каждого СтрокаПоВагону Из Параметры.ВагоныДляПодбораНакладных Цикл
			НоваяСтрока = ТаблицаВагоныНакладные.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПоВагону);
			Если ЗначениеЗаполнено(НоваяСтрока.Вагон) И Не ЗначениеЗаполнено(НоваяСтрока.ВагонСтрока) Тогда
				НоваяСтрока.ВагонСтрока = НоваяСтрока.Вагон.Наименование;
			ИначеЕсли Не ЗначениеЗаполнено(НоваяСтрока.Вагон) И ЗначениеЗаполнено(НоваяСтрока.ВагонСтрока) Тогда
				НоваяСтрока.Вагон = Справочники.ТС.НайтиПоНаименованию(НоваяСтрока.ВагонСтрока);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры

//Евросиб Коханенко Н.А. #61705 09.12.2022 (
&НаКлиенте
Процедура ОткрытьОкноСИнструкциями(Форма, Команда)
	ИнструкцииКлиент.ОткрытьОкноСИнструкциями(ЭтаФорма, Команда);
КонецПроцедуры  
//Евросиб Коханенко Н.А. #61705 09.12.2022 )


&НаСервере
Процедура ПодборНакладныхДляВагонов(СписокВагонов)
	
	
	Запрос = Новый Запрос;
	
	Если ЗначениеЗаполнено(ПериодОтправления) Тогда
		ДатаОтпрНач = ПериодОтправления.ДатаНачала;
		ДатаОтпрКон = ПериодОтправления.ДатаОкончания;
	Иначе
		ДатаОтпрНач = ТекущаяДата() - 180*3600*24;
		ДатаОтпрКон = ТекущаяДата();
	КонецЕсли;
	Запрос.УстановитьПараметр("ДатаОтпрНач",ДатаОтпрНач);
	Запрос.УстановитьПараметр("ДатаОтпрКон",ДатаОтпрКон);
	
	Запрос.УстановитьПараметр("НомерВагона",СписокВагонов);
	
	//Евросиб Каблов 14.04.2021 ( Ticket#0224665
	//Если ЗначениеЗаполнено(ПериодПрибытия) Тогда
	//	ДатаРаскрНач = ПериодПрибытия.ДатаНачала;
	//	ДатаРаскрКон = ПериодПрибытия.ДатаОкончания;
	//	ОтборыПериодПрибытия = "	И э_НакладнаяВагоны.Ссылка.ДатаИВремяРаскредитованияГрузаМестная МЕЖДУ &ДатаРаскрНач И &ДатаРаскрКон";
	//	Запрос.УстановитьПараметр("ДатаРаскрНач",ДатаРаскрНач);
	//	Запрос.УстановитьПараметр("ДатаРаскрКон",ДатаРаскрКон);
	//Иначе
	//	ОтборыПериодПрибытия = "";
	//КонецЕсли;
	//
	//Если ЗначениеЗаполнено(СтанцияОтправления) Тогда
	//	ОтборыСтанцияОтправления = "	И э_НакладнаяВагоны.Ссылка.СтанцияОтправления = &СтанцияОтправления";
	//	Запрос.УстановитьПараметр("СтанцияОтправления",СтанцияОтправления);
	//Иначе
	//	ОтборыСтанцияОтправления = "";
	//КонецЕсли;
	//
	//Если ЗначениеЗаполнено(СтанцияНазначения) Тогда
	//	ОтборыСтанцияНазначения = "	И э_НакладнаяВагоны.Ссылка.СтанцияНазначения = &СтанцияНазначения";
	//	Запрос.УстановитьПараметр("СтанцияНазначения",СтанцияНазначения);
	//Иначе
	//	ОтборыСтанцияНазначения = "";
	//КонецЕсли;
	//
	//Запрос.Текст = "ВЫБРАТЬ
	//               |	э_НакладнаяВагоны.Ссылка КАК Накладная,
	//               |	э_НакладнаяВагоны.Ссылка.СтанцияОтправления КАК СтанцияОтправления,
	//               |	э_НакладнаяВагоны.Ссылка.СтанцияНазначения КАК СтанцияНазначения,
	//               |	э_НакладнаяВагоны.Ссылка.ДатаИВремяОтправленияГруза КАК ДатаОтправления,
	//               |	э_НакладнаяВагоны.Ссылка.ДатаИВремяРаскредитованияГрузаМестная КАК ДатаРаскредитации,
	//               |	э_НакладнаяВагоны.Ссылка.ГруженаяНакладная КАК Груженый,
	//               |	э_НакладнаяВагоны.Ссылка.НакладнаяНомер КАК НомерНакладной,
	//               |	э_НакладнаяВагоны.НомерВагона КАК НомерВагона
	//               |ИЗ
	//               |	Документ.э_Накладная.Вагоны КАК э_НакладнаяВагоны
	//               |ГДЕ
	//               |	НЕ э_НакладнаяВагоны.Ссылка.ПометкаУдаления
	//               |	И э_НакладнаяВагоны.НомерВагона В(&НомерВагона)
	//               |	И (э_НакладнаяВагоны.Ссылка.ТекущееСостояниеНакладнойДействующийСтатус
	//               |			ИЛИ э_НакладнаяВагоны.Ссылка.ИсточникНакладной = ЗНАЧЕНИЕ(Перечисление.ИсточникЖДН.ГВЦ))
	//               |	И э_НакладнаяВагоны.Ссылка.ДатаИВремяОтправленияГруза МЕЖДУ &ДатаОтпрНач И &ДатаОтпрКон" + ОтборыПериодПрибытия + "
	//               |    " + ОтборыСтанцияОтправления + "
	//               |    " + ОтборыСтанцияНазначения;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Локации.Локация КАК Локация,
	|	э_Станции.Ссылка КАК Станция
	|ПОМЕСТИТЬ ВТСтанцииНазначения
	|ИЗ
	|	(ВЫБРАТЬ
	|		АналогиЛокаций.Локация КАК Локация,
	|		АналогиЛокаций.Локация.КодЖДСтанции КАК КодЖДСтанции
	|	ИЗ
	|		РегистрСведений.АналогиЛокаций КАК АналогиЛокаций
	|	ГДЕ
	|		АналогиЛокаций.Аналог = &СтанцияНазначения
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		АналогиЛокаций.Аналог,
	|		АналогиЛокаций.Аналог.КодЖДСтанции
	|	ИЗ
	|		РегистрСведений.АналогиЛокаций КАК АналогиЛокаций
	|	ГДЕ
	|		АналогиЛокаций.Локация = &СтанцияНазначения
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Локации.Ссылка,
	|		Локации.КодЖДСтанции
	|	ИЗ
	|		Справочник.Локации КАК Локации
	|	ГДЕ
	|		Локации.Ссылка = &СтанцияНазначения) КАК Локации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.э_Станции КАК э_Станции
	|		ПО (ПОДСТРОКА(Локации.КодЖДСтанции, 1, 5) = ПОДСТРОКА(э_Станции.Код, 1, 5))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Локации.Локация КАК Локация,
	|	э_Станции.Ссылка КАК Станция
	|ПОМЕСТИТЬ ВТСтанцииОтправления
	|ИЗ
	|	(ВЫБРАТЬ
	|		АналогиЛокаций.Локация КАК Локация,
	|		АналогиЛокаций.Локация.КодЖДСтанции КАК КодЖДСтанции
	|	ИЗ
	|		РегистрСведений.АналогиЛокаций КАК АналогиЛокаций
	|	ГДЕ
	|		АналогиЛокаций.Аналог = &СтанцияОтправления
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		АналогиЛокаций.Аналог,
	|		АналогиЛокаций.Аналог.КодЖДСтанции
	|	ИЗ
	|		РегистрСведений.АналогиЛокаций КАК АналогиЛокаций
	|	ГДЕ
	|		АналогиЛокаций.Локация = &СтанцияОтправления
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Локации.Ссылка,
	|		Локации.КодЖДСтанции
	|	ИЗ
	|		Справочник.Локации КАК Локации
	|	ГДЕ
	|		Локации.Ссылка = &СтанцияОтправления) КАК Локации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.э_Станции КАК э_Станции
	|		ПО (ПОДСТРОКА(Локации.КодЖДСтанции, 1, 5) = ПОДСТРОКА(э_Станции.Код, 1, 5))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	э_НакладнаяВагоны.Ссылка КАК Накладная,
	|	э_НакладнаяВагоны.Ссылка.СтанцияОтправления КАК СтанцияОтправления,
	|	э_НакладнаяВагоны.Ссылка.СтанцияНазначения КАК СтанцияНазначения,
	|	э_НакладнаяВагоны.Ссылка.ДатаИВремяОтправленияГруза КАК ДатаОтправления,
	|	э_НакладнаяВагоны.Ссылка.ДатаИВремяРаскредитованияГруза КАК ДатаРаскредитации,
	|	э_НакладнаяВагоны.Ссылка.ГруженаяНакладная КАК Груженый,
	|	э_НакладнаяВагоны.Ссылка.НакладнаяНомер КАК НомерНакладной,
	|	э_НакладнаяВагоны.НомерВагона КАК НомерВагона
	|ИЗ
	|	Документ.э_Накладная.Вагоны КАК э_НакладнаяВагоны
	|ГДЕ
	|	НЕ э_НакладнаяВагоны.Ссылка.ПометкаУдаления
	|	И э_НакладнаяВагоны.НомерВагона В(&НомерВагона)
	|	И (э_НакладнаяВагоны.Ссылка.ТекущееСостояниеНакладнойДействующийСтатус
	|			ИЛИ э_НакладнаяВагоны.Ссылка.ИсточникНакладной = ЗНАЧЕНИЕ(Перечисление.ИсточникЖДН.ГВЦ))
	|	И э_НакладнаяВагоны.Ссылка.ДатаИВремяОтправленияГруза МЕЖДУ &ДатаОтпрНач И &ДатаОтпрКон
	|	И э_НакладнаяВагоны.Ссылка.ДатаИВремяРаскредитованияГруза МЕЖДУ &ДатаРаскрНач И &ДатаРаскрКон
	|	И э_НакладнаяВагоны.Ссылка.СтанцияНазначения В
	|			(ВЫБРАТЬ
	|				ВТСтанцииНазначения.Станция КАК Станция
	|			ИЗ
	|				ВТСтанцииНазначения КАК ВТСтанцииНазначения)
	|	И э_НакладнаяВагоны.Ссылка.СтанцияОтправления В
	|			(ВЫБРАТЬ
	|				ВТСтанцииОтправления.Станция КАК Станция
	|			ИЗ
	|				ВТСтанцииОтправления КАК ВТСтанцииОтправления)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаОтправления УБЫВ";	
	
	Если ЗначениеЗаполнено(ПериодПрибытия) Тогда
		ДатаРаскрНач = ПериодПрибытия.ДатаНачала;
		ДатаРаскрКон = ПериодПрибытия.ДатаОкончания;
		Запрос.УстановитьПараметр("ДатаРаскрНач",ДатаРаскрНач);
		Запрос.УстановитьПараметр("ДатаРаскрКон",ДатаРаскрКон);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И э_НакладнаяВагоны.Ссылка.ДатаИВремяРаскредитованияГруза МЕЖДУ &ДатаРаскрНач И &ДатаРаскрКон", "");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтанцияОтправления) Тогда
		Запрос.УстановитьПараметр("СтанцияОтправления",СтанцияОтправления);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И э_НакладнаяВагоны.Ссылка.СтанцияОтправления = &СтанцияОтправления", "");
		ТекстУсловия =
		"И э_НакладнаяВагоны.Ссылка.СтанцияОтправления В
		|			(ВЫБРАТЬ
		|				ВТСтанцииОтправления.Станция КАК Станция
		|			ИЗ
		|				ВТСтанцииОтправления КАК ВТСтанцииОтправления)";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, ТекстУсловия, "");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтанцияНазначения) Тогда
		Запрос.УстановитьПараметр("СтанцияНазначения",СтанцияНазначения);
	Иначе
		ТекстУсловия =
		"И э_НакладнаяВагоны.Ссылка.СтанцияНазначения В
		|			(ВЫБРАТЬ
		|				ВТСтанцииНазначения.Станция КАК Станция
		|			ИЗ
		|				ВТСтанцииНазначения КАК ВТСтанцииНазначения)";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, ТекстУсловия, ""); 
	КонецЕсли;
	//Евросиб Каблов 14.04.2021 ) 
	
	Если ПроверятьДействующийСтатусГВЦ Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИЛИ э_НакладнаяВагоны.Ссылка.ИсточникНакладной = ЗНАЧЕНИЕ(Перечисление.ИсточникЖДН.ГВЦ)", "");
	КонецЕсли;
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	// сортируем тут, чтобы запрос можно было открыть по правой кнопке
	//ТЗ.Сортировать("ДатаОтправления УБЫВ");
	
	ВозможныеНакладные.Загрузить(ТЗ);	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСтанции(Локации)
	
	СоответствиеСтанций = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	э_Станции.Ссылка КАК Станция,
	|	Локации.Ссылка КАК Локация
	|ИЗ
	|	Справочник.Локации КАК Локации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.э_Станции КАК э_Станции
	|		ПО (ПОДСТРОКА(Локации.КодЖДСтанции, 1, 5) = ПОДСТРОКА(э_Станции.Код, 1, 5))
	|ГДЕ
	|	Локации.Ссылка В(&Локации)";
	
	Запрос.УстановитьПараметр("Локации", Локации);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СоответствиеСтанций.Вставить(Выборка.Локация, Выборка.Станция);
	КонецЦикла;
	
	Возврат СоответствиеСтанций;
		
КонецФункции

&НаКлиенте
