&НаКлиенте
Процедура УстановитьСоответствиеВагонЖДН()
	
	ТекД_Приемник = Элементы.ТаблицаВагоныНакладные.ТекущиеДанные;
	Если ТекД_Приемник = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекД_Источник = Элементы.ВозможныеНакладные.ТекущиеДанные;
	Если ТекД_Источник = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ПодборНесколькихЖДННаВагон Тогда
		
		НайденныеСтрокиВагонНакладная = ТаблицаВагоныНакладные.НайтиСтроки(Новый Структура("ВагонСтрока, Накладная", ТекД_Источник.НомерВагона, ТекД_Источник.Накладная));
		Если НайденныеСтрокиВагонНакладная.Количество() = 0 Тогда
			
			НайденныеСтрокиВагон = ТаблицаВагоныНакладные.НайтиСтроки(Новый Структура("ВагонСтрока", ТекД_Источник.НомерВагона));			
			РедактируемаяСтрока = Неопределено;
			
			Для Каждого СтрокаПоВагону Из НайденныеСтрокиВагон Цикл
				Если Не ЗначениеЗаполнено(СтрокаПоВагону.Накладная) Тогда
					РедактируемаяСтрока = СтрокаПоВагону;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если РедактируемаяСтрока = Неопределено Тогда
				ИндексПоследнейВМассиве = НайденныеСтрокиВагон.Количество() - 1;
				ИндексПоследнейСтрокиПоВагону = ТаблицаВагоныНакладные.Индекс(НайденныеСтрокиВагон[ИндексПоследнейВМассиве]);
				Если ИндексПоследнейСтрокиПоВагону >= 0 Тогда
					РедактируемаяСтрока = ТаблицаВагоныНакладные.Вставить(ИндексПоследнейСтрокиПоВагону + 1);
				КонецЕсли;
			КонецЕсли;
			
			Если РедактируемаяСтрока <> Неопределено Тогда
				
				ЗаполнитьЗначенияСвойств(РедактируемаяСтрока, НайденныеСтрокиВагон[0]);
				
				РедактируемаяСтрока.Накладная = ТекД_Источник.Накладная;
				РедактируемаяСтрока.НомерНакладной = ТекД_Источник.НомерНакладной;
				РедактируемаяСтрока.ТранспортныйДокумент = ПолучитьТД(ТекД_Источник.Накладная);
				
				МассивКТК = ПолучитьКонтейнерыИзЖДН(РедактируемаяСтрока.Накладная, РедактируемаяСтрока.ВагонСтрока);
				НомераКТК = Новый Массив;
				Для Каждого ДанныеКТК Из МассивКТК Цикл
					НомераКТК.Добавить(ДанныеКТК.НомерКонтейнера);
				КонецЦикла;
				НомераКонтейнеров = СтрСоединить(НомераКТК, ";");
				РедактируемаяСтрока.Контейнеры.Очистить();
				РедактируемаяСтрока.НомераКонтейнеров = НомераКонтейнеров;
				
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе	
		ТекД_Приемник.Накладная = ТекД_Источник.Накладная;
		ТекД_Приемник.НомерНакладной = ТекД_Источник.НомерНакладной;
		ТекД_Приемник.ТранспортныйДокумент = ПолучитьТД(ТекД_Источник.Накладная);
		
		МассивКТК = ПолучитьКонтейнерыИзЖДН(ТекД_Приемник.Накладная,ТекД_Приемник.ВагонСтрока);
		ТекД_Приемник.Контейнеры.Очистить();
		ТекД_Приемник.НомераКонтейнеров.Очистить();
		Для Каждого ДанныеКТК Из МассивКТК Цикл
			ТекД_Приемник.Контейнеры.Добавить(ДанныеКТК.Контейнер, ДанныеКТК.НомерКонтейнера);
			ТекД_Приемник.НомераКонтейнеров.Добавить(ДанныеКТК.НомерКонтейнера);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТД(Накладная)
	
	ТД = Документы.ТранспортныйДокумент.НайтиПоРеквизиту("НакладнаяЭТРАН",Накладная);
	
	Возврат ТД;
	
КонецФункции	
	
&НаКлиенте
Процедура ОчиститьСоответствие(Команда)
	
	ТекД = Элементы.ТаблицаВагоныНакладные.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекД.Накладная = ПредопределенноеЗначение("Документ.э_Накладная.ПустаяСсылка");
	ТекД.ТранспортныйДокумент = ПредопределенноеЗначение("Документ.ТранспортныйДокумент.ПустаяСсылка");
	ТекД.Контейнеры.Очистить();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКонтейнерыИзЖДН(Накладная,ВагонСтрока)
	
	МассивКТК = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	э_НакладнаяКонтейнеры.НомерКонтейнера КАК НомерКонтейнера,
	               |	ТЕ.Ссылка КАК Контейнер
	               |ИЗ
	               |	Документ.э_Накладная.Вагоны КАК э_НакладнаяВагоны
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.э_Накладная.Контейнеры КАК э_НакладнаяКонтейнеры
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТЕ КАК ТЕ
	               |			ПО э_НакладнаяКонтейнеры.НомерКонтейнера = ТЕ.Наименование
	               |		ПО э_НакладнаяВагоны.Ссылка = э_НакладнаяКонтейнеры.Ссылка
	               |			И (ВЫБОР
	               |				КОГДА э_НакладнаяКонтейнеры.НомерВагонаДляКонтейнерногоПоезда <> 0
	               |					ТОГДА э_НакладнаяКонтейнеры.НомерВагонаДляКонтейнерногоПоезда = э_НакладнаяВагоны.НомерСтроки
	               |				ИНАЧЕ э_НакладнаяВагоны.НомерСтроки = 1
	               |			КОНЕЦ)
	               |ГДЕ
	               |	э_НакладнаяКонтейнеры.Ссылка = &Ссылка
	               |	И э_НакладнаяВагоны.НомерВагона = &НомерВагона";
	Запрос.УстановитьПараметр("Ссылка",Накладная);
	Запрос.УстановитьПараметр("НомерВагона",ВагонСтрока);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивКТК.Добавить(Новый Структура("НомерКонтейнера, Контейнер", Выборка.НомерКонтейнера, Выборка.Контейнер));
	КонецЦикла;
	
	Возврат МассивКТК;
	
КонецФункции

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВСделку(Команда)
	
	МассивСтруктур = Новый Массив;
	
	Для Каждого Стр Из ТаблицаВагоныНакладные Цикл
		
		Если ЗначениеЗаполнено(Стр.Накладная) Тогда
			
			СтруктураОтвета = Новый Структура;
			СтруктураОтвета.Вставить("Вагон",Стр.Вагон);
			СтруктураОтвета.Вставить("Накладная",Стр.НомерНакладной);
			СтруктураОтвета.Вставить("ТранспортныйДокумент",Стр.ТранспортныйДокумент);
			СтруктураОтвета.Вставить("СписокКТК",Стр.Контейнеры);
			СтруктураОтвета.Вставить("НомераКонтейнеров", Стр.НомераКонтейнеров);
			
			МассивСтруктур.Добавить(СтруктураОтвета);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Закрыть(МассивСтруктур);
	
КонецПроцедуры

