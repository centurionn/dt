
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОперацияГрузы.ТС КАК ТС
	               |ИЗ
	               |	Документ.Операция.Грузы КАК ОперацияГрузы
	               |ГДЕ
	               |	ОперацияГрузы.Ссылка = &Ссылка
	               |	И ОперацияГрузы.ТС <> ЗНАЧЕНИЕ(Справочник.ТС.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Ссылка", Параметры.Операция);
	СписокТС = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ТС");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОперацияГрузы.ТЕ КАК ТЕ
	               |ИЗ
	               |	Документ.Операция.Грузы КАК ОперацияГрузы
	               |ГДЕ
	               |	ОперацияГрузы.Ссылка = &Ссылка
	               |	И ОперацияГрузы.ТЕ <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Ссылка", Параметры.Операция);
	СписокТЕ = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ТЕ");
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВагоныВОтправке.Отправка КАК Отправка,
	               |	ВагоныВОтправке.Вагон КАК Вагон,
	               |	NULL КАК Контейнер
	               |ИЗ
	               |	РегистрСведений.ВагоныВОтправке КАК ВагоныВОтправке
	               |ГДЕ
	               |	ВагоныВОтправке.Отправка В
	               |			(ВЫБРАТЬ
	               |				РейсыЖД.Ссылка КАК Ссылка
	               |			ИЗ
	               |				Справочник.РейсыЖД КАК РейсыЖД
	               |			ГДЕ
	               |				РейсыЖД.ПредыдущаяОтправка В (&ПредыдущаяОтправка))
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	КонтейнерыВОтправке.Отправка,
	               |	NULL,
	               |	КонтейнерыВОтправке.Контейнер
	               |ИЗ
	               |	РегистрСведений.КонтейнерыВОтправке КАК КонтейнерыВОтправке
	               |ГДЕ
	               |	КонтейнерыВОтправке.Отправка В
	               |			(ВЫБРАТЬ
	               |				РейсыЖД.Ссылка КАК Ссылка
	               |			ИЗ
	               |				Справочник.РейсыЖД КАК РейсыЖД
	               |			ГДЕ
	               |				РейсыЖД.ПредыдущаяОтправка В (&ПредыдущаяОтправка))";
	Запрос.УстановитьПараметр("ПредыдущаяОтправка", Параметры.МассивРейсов);
	ТЧ = Запрос.Выполнить().Выгрузить();
	
	/////////////////////
	
	Для каждого Стр из СписокТС Цикл
		НСтр = ТЗ.Добавить();
		НСтр.Вагон = Стр;
		НайдСтроки = ТЧ.НайтиСтроки(Новый Структура("Вагон", Стр));
		Для каждого Стр из НайдСтроки Цикл
			Если ЗначениеЗаполнено(Стр.Отправка) Тогда НСтр.ПоследующееИспользование = Стр.Отправка; КонецЕсли;
		КонецЦикла;

	КонецЦикла;
	Для каждого Стр из СписокТЕ Цикл
		НСтр = ТЗ.Добавить();
		НСтр.Контейнер = Стр;
		НайдСтроки = ТЧ.НайтиСтроки(Новый Структура("Контейнер", Стр));
		Для каждого Стр из НайдСтроки Цикл
			Если ЗначениеЗаполнено(Стр.Отправка) Тогда НСтр.ПоследующееИспользование = Стр.Отправка; КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры

