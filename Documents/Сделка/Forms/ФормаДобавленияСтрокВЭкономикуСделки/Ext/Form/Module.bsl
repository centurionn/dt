&НаКлиенте
Процедура ОбработкаВыбораУчЕдиницы(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	Если Параметр2.Свойство("ТС") Тогда
		
		Элементы.ТЧ.ТекущиеДанные.СписокВагонов.ЗагрузитьЗначения(Параметр1);
		ТЧСписокВагоновПриИзменении(неопределено);
		
	ИначеЕсли Параметр2.Свойство("ТЕ") Тогда
		
		ТекД = Элементы.ТЧ.ТекущиеДанные;
		СписокРазмеровКТК = ПолучитьСписокРазмеровКТК(Параметр1);
		Если СписокРазмеровКТК.Количество() > 1 Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Выбранные КТК имеют разную размерность", ,ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТЧ", ТЧ.Индекс(Элементы.ТЧ.ТекущиеДанные)+1, "СписокКТК"));
		КонецЕсли;
		ТекД.СписокКТК.ЗагрузитьЗначения(Параметр1); 
		ТЧСписокКТКПриИзменении(Неопределено);
		
	ИначеЕсли Параметр2.Свойство("ТД") Тогда
		
		Элементы.ТЧ.ТекущиеДанные.СписокТД.ЗагрузитьЗначения(Параметр1);
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ПолучитьСписокРазмеровКТК(СписокКТК)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТЕ.ТипТЕ.РазмерКТК КАК РазмерКТК
	|ИЗ
	|	Справочник.ТЕ КАК ТЕ
	|ГДЕ
	|	ТЕ.Ссылка В(&СписокКТК)";
	Запрос.УстановитьПараметр("СписокКТК", СписокКТК);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("РазмерКТК");
	
КонецФункции

