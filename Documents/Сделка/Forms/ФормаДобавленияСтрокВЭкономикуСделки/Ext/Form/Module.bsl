&НаКлиенте
Процедура ТЧПСЦПриИзменении(Элемент)
	текД = Элементы.ТЧ.ТекущиеДанные;
	Если ЗначениеЗаполнено(текД.ПСЦ) Тогда 
		текД.Калькуляция = Неопределено;
		//РеквизитыПСЦ = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(текД.ПСЦ, "Валюта, СтавкаНДС, СуммаВключаетНДС");
		//Евросиб(ДИТ), Беляев СЮ, US 105324 / TA 105326, 20-03-2025, начало
		РеквизитыПСЦ = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(текД.ПСЦ, "Валюта, СтавкаНДС, СуммаВключаетНДС, ВидПСЦ");
		//Евросиб(ДИТ), Беляев СЮ, US 105324 / TA 105326, 20-03-2025, конец
		ЗаполнитьЗначенияСвойств(текД, РеквизитыПСЦ);
		ТекД.НДСВключенВСтоимость = РеквизитыПСЦ.СуммаВключаетНДС;
		ЗаполнитьСписокВыбораКалькуляций(Элементы.ТЧКалькуляция.СписокВыбора, текД.ПСЦ);
		Если Элементы.ТЧКалькуляция.СписокВыбора.Количество() = 1 Тогда
			текД.Калькуляция = Элементы.ТЧКалькуляция.СписокВыбора[0].Значение;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

