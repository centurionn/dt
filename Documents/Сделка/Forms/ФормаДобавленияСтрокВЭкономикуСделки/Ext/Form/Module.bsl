&НаКлиенте
Процедура ОбработкаВставкиExcel(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = неопределено Тогда Возврат; КонецЕсли;
	Для каждого Стр из П1 Цикл
		
		НСтр = ТЧ.Добавить();
		ЗаполнитьЗначенияСвойств(НСтр, Стр);
		
		НСтр.СписокКТК.ЗагрузитьЗначения(Стр.СписокКТК);
		
		Если НСтр.СписокКТК.Количество() > 0 Тогда
			
			НСтр.РазмерКТК = ПолучитьРазмерКТК(НСтр.СписокКТК[0].Значение);
			
		КонецЕсли;
		
		НСтр.СписокВагонов.ЗагрузитьЗначения(Стр.СписокВагонов);
		
		НСтр.УслугаВнеСтавки = Истина;
		НСтр.ИсточникПоявленияСтрокиЭкономики = ПредопределенноеЗначение("Перечисление.ИсточникПоявленияСтрокиЭкономики.ПроизвольнаяУслугаВручную");
		НСтр.Доходы = Истина;
		НСтр.Расходы = Истина;
		
		ОбновитьМатематикуСтроки(НСтр);
		
	КонецЦикла;

	ОпределитьНоменклатурнуюГруппу();
	
КонецПроцедуры

