	//	ТекД.Расходы_СтавкаНДС = ТекД.СтавкаНДС;
	//	Расходы_СтавкаНДСИзменено = Истина;
	//КонецЕсли;
	//Расходы_ВалютаИзменено = Ложь;
	//Если ЗначениеЗаполнено(ТекД.Валюта) 
	//	И НЕ ЗначениеЗаполнено(ТекД.Расходы_Валюта) Тогда
	//	ТекД.Расходы_Валюта = ТекД.Валюта;
	//	Расходы_ВалютаИзменено = Истина;
	//КонецЕсли;
	//Расходы_УслугаИзменено = Ложь;
	//Если ЗначениеЗаполнено(ТекД.Услуга) 
	//	И НЕ ЗначениеЗаполнено(ТекД.Расходы_Услуга) Тогда
	//	ТекД.Расходы_Услуга = ТекД.Услуга;
	//	Расходы_УслугаИзменено = Истина;
	//КонецЕсли;
	
	ОбновитьМатематикуСтроки(ТекД);
	
	Если ВключенРежимГрупповогоИзменения Тогда
		
		Для каждого Стр из ТЧ Цикл
			
			//Если Стр.ГрупповоеИзменение = Истина Тогда 
				
