		//Евросиб Каблов 09.04.2025 ( #105407
		Иначе
			МассивУЕ = Новый Массив;
		//Евросиб Каблов 09.04.2025 )
		КонецЕсли;
		//Евросиб(ДИТ), Беляев СЮ, US 105324 / TA 105326, 20-03-2025, начало
		ЭтоОснованиеДляВозмещенияРасходов = Стр.ВидПСЦ = Справочники.ВидыПСЦ.ОснованиеДляВозмещенияРасходов;
		Если ЭтоОснованиеДляВозмещенияРасходов Тогда
			СтруктураПоиска = СтрЗаменить(СтруктураПоиска, "Договор, ", "");
