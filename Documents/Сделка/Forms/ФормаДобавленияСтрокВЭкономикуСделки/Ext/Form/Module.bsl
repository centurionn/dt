	|		Когда &УЕ = ""Вагон""
	|	Тогда СделкаСвязьУчетныхЕдиниц.Вагон <> Значение(Справочник.ТС.ПустаяСсылка)
	|	Конец";
	Запрос.УстановитьПараметр("УЕ", ПараметрыОтбора.УЕ);
	// ДИТ ТА 71953 Сержантова А.С. Конец: 27.06.2023
	
	//Евросиб Каблов 12.12.2023 ( Ticket#0329972
	Если ЗначениеЗаполнено(ПараметрыОтбора.ВидТранспортногоСообщения) Тогда
		Запрос.УстановитьПараметр("ВидТранспортногоСообщения", ПараметрыОтбора.ВидТранспортногоСообщения);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И СделкаСвязьУчетныхЕдиниц.ВидТранспортногоСообщения = &ВидТранспортногоСообщения", "");
	КонецЕсли;
	//Евросиб Каблов 12.12.2023 )
	
	Запрос.УстановитьПараметр("Сделка", ПараметрыОтбора.Сделка);
	Запрос.УстановитьПараметр("Клиент", ПараметрыОтбора.Клиент);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(ПараметрыОтбора.УЕ);
	
