			//СтрокиСП = Сделка.СвязьУчетныхЕдиниц.НайтиСтроки(Новый Структура(СтруктураПоиска, Стр.Договор, УЕ.Значение, Стр.ВидТранспортногоСообщения));
			
			//СтрокиСП = Сделка.СвязьУчетныхЕдиниц.НайтиСтроки(Новый Структура(СтруктураПоиска, Стр.Договор, УЕ.Значение, Стр.ВидТранспортногоСообщения, Ложь, Ложь, Ложь));
			//Евросиб(ДИТ), Беляев СЮ, US 105324 / TA 105326, 20-03-2025, начало
			Если ЭтоОснованиеДляВозмещенияРасходов Тогда
				СтрокиСП = Сделка.СвязьУчетныхЕдиниц.НайтиСтроки(Новый Структура(СтруктураПоиска, УЕ.Значение, Стр.ВидТранспортногоСообщения, Ложь, Ложь, Ложь));
