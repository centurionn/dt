Функция ПолучитьСписокУЕПоКлиентуНаСервере(ПараметрыОтбора)
//Евросиб Каблов 12.12.2023 )
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СделкаСвязьУчетныхЕдиниц.Контейнер КАК Контейнер,
	|	СделкаСвязьУчетныхЕдиниц.Вагон КАК Вагон
	|ИЗ
	|	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|ГДЕ  
	|   СделкаСвязьУчетныхЕдиниц.Ссылка = &Сделка 
	|	И СделкаСвязьУчетныхЕдиниц.Клиент = &Клиент
	//Евросиб Каблов 12.12.2023 ( Ticket#0329972
	|	И НЕ СделкаСвязьУчетныхЕдиниц.НеАктивна
	|	И НЕ СделкаСвязьУчетныхЕдиниц.Удалена
	|	И НЕ СделкаСвязьУчетныхЕдиниц.ОтключитьРасходы
	|	И СделкаСвязьУчетныхЕдиниц.ВидТранспортногоСообщения = &ВидТранспортногоСообщения
	//Евросиб Каблов 12.12.2023 )
