&НаСервереБезКонтекста
Функция ПолучитьСписокВидовТранспортногоСообщения(ПараметрыОтбора)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЕ.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ Контейнеры
	|ИЗ
	|	Справочник.ТЕ КАК ТЕ
	|ГДЕ
	|	ТЕ.Ссылка В(&Контейнеры)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТС.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ Вагоны
	|ИЗ
	|	Справочник.ТС КАК ТС
	|ГДЕ
	|	ТС.Ссылка В(&Вагоны)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СделкаСвязьУчетныхЕдиниц.ВидТранспортногоСообщения = ЗНАЧЕНИЕ(Перечисление.ВидыТранспортныхСообщений.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК Пустая,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СделкаСвязьУчетныхЕдиниц.ВидТранспортногоСообщения = ЗНАЧЕНИЕ(Перечисление.ВидыТранспортныхСообщений.ЖД)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЖД,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СделкаСвязьУчетныхЕдиниц.ВидТранспортногоСообщения = ЗНАЧЕНИЕ(Перечисление.ВидыТранспортныхСообщений.Море)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК Море,
	|	СделкаСвязьУчетныхЕдиниц.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВидыТС
	|ИЗ
	|	Контейнеры КАК Контейнеры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|		ПО Контейнеры.Ссылка = СделкаСвязьУчетныхЕдиниц.Контейнер
	|			И (СделкаСвязьУчетныхЕдиниц.Ссылка = &Сделка)
	|			И (НЕ СделкаСвязьУчетныхЕдиниц.НеАктивна)
	|			И (НЕ СделкаСвязьУчетныхЕдиниц.Удалена)
	|			И (НЕ СделкаСвязьУчетныхЕдиниц.ОтключитьРасходы)
	//|			И (СделкаСвязьУчетныхЕдиниц.Клиент = &Клиент)
	//Евросиб(ДИТ), Беляев СЮ, US 105324 / TA 105326, 20-03-2025, начало
	|			И (СделкаСвязьУчетныхЕдиниц.Клиент = &Клиент ИЛИ &ВидПСЦ = ЗНАЧЕНИЕ(Справочник.ВидыПСЦ.ОснованиеДляВозмещенияРасходов))
	//Евросиб(ДИТ), Беляев СЮ, US 105324 / TA 105326, 20-03-2025, конец
	|
	|СГРУППИРОВАТЬ ПО
	|	СделкаСвязьУчетныхЕдиниц.Ссылка,
	|	Контейнеры.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СделкаСвязьУчетныхЕдиниц.ВидТранспортногоСообщения = ЗНАЧЕНИЕ(Перечисление.ВидыТранспортныхСообщений.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ),
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СделкаСвязьУчетныхЕдиниц.ВидТранспортногоСообщения = ЗНАЧЕНИЕ(Перечисление.ВидыТранспортныхСообщений.ЖД)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ),
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СделкаСвязьУчетныхЕдиниц.ВидТранспортногоСообщения = ЗНАЧЕНИЕ(Перечисление.ВидыТранспортныхСообщений.Море)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ),
	|	СделкаСвязьУчетныхЕдиниц.Ссылка
	|ИЗ
	|	Вагоны КАК Вагоны
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|		ПО Вагоны.Ссылка = СделкаСвязьУчетныхЕдиниц.Вагон
	|			И (СделкаСвязьУчетныхЕдиниц.Ссылка = &Сделка)
	|			И (НЕ СделкаСвязьУчетныхЕдиниц.НеАктивна)
	|			И (НЕ СделкаСвязьУчетныхЕдиниц.Удалена)
	|			И (НЕ СделкаСвязьУчетныхЕдиниц.ОтключитьРасходы)
	//|			И (СделкаСвязьУчетныхЕдиниц.Клиент = &Клиент)
	//Евросиб(ДИТ), Беляев СЮ, US 105324 / TA 105326, 20-03-2025, начало
	|			И (СделкаСвязьУчетныхЕдиниц.Клиент = &Клиент ИЛИ &ВидПСЦ = ЗНАЧЕНИЕ(Справочник.ВидыПСЦ.ОснованиеДляВозмещенияРасходов))
	//Евросиб(ДИТ), Беляев СЮ, US 105324 / TA 105326, 20-03-2025, конец
	|
	|СГРУППИРОВАТЬ ПО
	|	СделкаСвязьУчетныхЕдиниц.Ссылка,
	|	Вагоны.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СделкаСвязьУчетныхЕдиниц.ВидТранспортногоСообщения = ЗНАЧЕНИЕ(Перечисление.ВидыТранспортныхСообщений.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ),
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СделкаСвязьУчетныхЕдиниц.ВидТранспортногоСообщения = ЗНАЧЕНИЕ(Перечисление.ВидыТранспортныхСообщений.ЖД)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ),
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СделкаСвязьУчетныхЕдиниц.ВидТранспортногоСообщения = ЗНАЧЕНИЕ(Перечисление.ВидыТранспортныхСообщений.Море)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ),
	|	СделкаСвязьУчетныхЕдиниц.Ссылка
	|ИЗ
	|	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|ГДЕ
	|	СделкаСвязьУчетныхЕдиниц.Ссылка = &Сделка
	//|	И СделкаСвязьУчетныхЕдиниц.Клиент = &Клиент
	//Евросиб(ДИТ), Беляев СЮ, US 105324 / TA 105326, 20-03-2025, начало
	|	И (СделкаСвязьУчетныхЕдиниц.Клиент = &Клиент ИЛИ &ВидПСЦ = ЗНАЧЕНИЕ(Справочник.ВидыПСЦ.ОснованиеДляВозмещенияРасходов))
	//Евросиб(ДИТ), Беляев СЮ, US 105324 / TA 105326, 20-03-2025, конец
	|	И НЕ СделкаСвязьУчетныхЕдиниц.НеАктивна
	|	И НЕ СделкаСвязьУчетныхЕдиниц.Удалена
	|	И НЕ СделкаСвязьУчетныхЕдиниц.ОтключитьРасходы
	|
	|СГРУППИРОВАТЬ ПО
	|	СделкаСвязьУчетныхЕдиниц.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МИНИМУМ(ВидыТС.Пустая) КАК Пустая,
	|	МИНИМУМ(ВидыТС.ЖД) КАК ЖД,
	|	МИНИМУМ(ВидыТС.Море) КАК Море,
	|	ВидыТС.Ссылка КАК Ссылка
	|ИЗ
	|	ВидыТС КАК ВидыТС
	|
	|СГРУППИРОВАТЬ ПО
	|	ВидыТС.Ссылка";
	
    Запрос.УстановитьПараметр("Контейнеры", ПараметрыОтбора.Контейнеры);
	Запрос.УстановитьПараметр("Вагоны", ПараметрыОтбора.Вагоны);	
	Запрос.УстановитьПараметр("Сделка", ПараметрыОтбора.Сделка);
	Запрос.УстановитьПараметр("Клиент", ПараметрыОтбора.Клиент);
	//Евросиб(ДИТ), Беляев СЮ, US 105324 / TA 105326, 20-03-2025, начало
	Запрос.УстановитьПараметр("ВидПСЦ", ПараметрыОтбора.ВидПСЦ);
	//Евросиб(ДИТ), Беляев СЮ, US 105324 / TA 105326, 20-03-2025, конец
	
	ВидыТС = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		Если Выборка.ЖД Тогда
			ВидыТС.Добавить(Перечисления.ВидыТранспортныхСообщений.ЖД);
		КонецЕсли;
		
		Если Выборка.Море Тогда
			ВидыТС.Добавить(Перечисления.ВидыТранспортныхСообщений.Море);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ВидыТС;
	
КонецФункции
