Процедура ТЧСписокВагоновПриИзменении(Элемент)
	
	ТекД = Элементы.ТЧ.ТекущиеДанные;
	Если ТекД <> неопределено Тогда
		
		ТекД.НоменклатурнаяГруппа = неопределено;
		ОпределитьНоменклатурнуюГруппу();
		
	КонецЕсли; 
	Если НЕ ЗначениеЗаполнено(ТекД.СписокКТК) Тогда
		ТекД.Количество = ТекД.СписокВагонов.Количество();
	КонецЕсли;
	ОбновитьМатематикуСтроки(ТекД);	
	
