
&НаКлиенте
Процедура замена_КалькуляцияПриИзменении(Элемент)
	
	Элементы.замена_ПСЦ.СписокВыбора.Очистить();
	Если ЗначениеЗаполнено(замена_Калькуляция) Тогда
		Элементы.замена_ПСЦ.СписокВыбора.ЗагрузитьЗначения(ПСЦ_по_калькуляции(замена_Калькуляция));
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПСЦ_по_калькуляции(замена_Калькуляция)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ПСЦКалькуляции.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ПСЦ.Калькуляции КАК ПСЦКалькуляции
	               |ГДЕ
	               |	ПСЦКалькуляции.Калькуляция = &Калькуляция
	               |	И НЕ ПСЦКалькуляции.Ссылка.ПометкаУдаления";
	Запрос.УстановитьПараметр("Калькуляция", замена_Калькуляция);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

&НаКлиенте
Процедура ПрочитатьДанные(Команда)
	
	Сч = 2;
	Распозн.Очистить();
	
	ПрочСтрока = Excel.Область("R"+Сч+"C1").Текст;
	
	Пока ПрочСтрока <> "" Цикл
		
		СтрокаКТК = СокрЛП(Excel.Область("R"+Сч+"C1").Текст);
		НСтр_КТК = РаботаСКонтейнерамиСервер.Нормализовать_и_НайтиКТК(СтрокаКТК, неопределено);
		Распозн.Добавить(НСтр_КТК);
		
		Сч = Сч + 1;
		ПрочСтрока = Excel.Область("R"+Формат(Сч, "ЧГ=0")+"C1").Текст;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Перенести(Команда)
	
	Результат = Новый Массив;
	Для каждого Стр из Распозн Цикл
		Результат.Добавить(Новый Структура("КТК, Клиент, Договор, Калькуляция, Протокол", Стр.Значение, замена_Контрагент, замена_Договор, замена_Калькуляция, замена_ПСЦ));
	КонецЦикла;
	Закрыть(Результат);
	
КонецПроцедуры

