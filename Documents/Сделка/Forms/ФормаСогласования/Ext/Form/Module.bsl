
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ТекстСостояния") Тогда
		ТекстСостояния = Параметры.ТекстСостояния;
	КонецЕсли;
	
	Если Параметры.Свойство("Исполнитель") Тогда
		Исполнитель = Параметры.Исполнитель;
	КонецЕсли;
	
	Если Параметры.Свойство("ЕстьПравоСогласовывать") Тогда
		ЕстьПравоСогласовывать = Параметры.ЕстьПравоСогласовывать;
	КонецЕсли;
	
	Если Параметры.Свойство("ЕстьПравоДелегировать") Тогда
		ЕстьПравоДелегировать = Параметры.ЕстьПравоДелегировать;
	КонецЕсли;
	
	Элементы.Исполнитель.Доступность = ЕстьПравоДелегировать;
	Элементы.Исполнитель.Видимость = ЕстьПравоДелегировать;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаВыполнено(Команда)
	
	ОчиститьСообщения();
	
	ПараметрыЗакрытия = Новый Структура;
	Если ЕстьПравоСогласовывать Тогда
		ПараметрыЗакрытия.Вставить("ОбновитьСтатус", Истина);
	КонецЕсли;
	Если ЕстьПравоДелегировать Тогда
		Если Не ЗначениеЗаполнено(Исполнитель) Тогда
			ТекстСообщения = НСтр("ru = 'Поле ""Исполнитель"" обязательно для заполнения'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Исполнитель");
			Возврат;
		Иначе
			ПараметрыЗакрытия.Вставить("Исполнитель", Исполнитель);
		КонецЕсли;
	КонецЕсли;
	
	ЭтотОбъект.Закрыть(ПараметрыЗакрытия);
	
КонецПроцедуры

#КонецОбласти