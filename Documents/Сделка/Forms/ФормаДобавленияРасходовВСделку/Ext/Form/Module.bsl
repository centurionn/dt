&НаКлиенте
Процедура ВставитьКТКИзExcel(Команда)
	
	Если Элементы.ТЧ.ТекущиеДанные = неопределено Тогда Возврат; КонецЕсли;
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаВставкиExcel2", ЭтаФорма, Новый Структура("КТК", Истина));
	ОткрытьФорму("ОбщаяФорма.ВставкаИзБуфераОбмена", Новый Структура("КТК", Истина), , ЭтаФорма.УникальныйИдентификатор, ,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВставкиExcel2(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	ТекД = Элементы.ТЧ.ТекущиеДанные;
	
	Если Параметр1 <> неопределено И Параметр2 <> неопределено И Параметр2.Свойство("Вагоны") Тогда
		
		ТекД.СписокВагонов.ЗагрузитьЗначения(Параметр1);
		
	ИначеЕсли Параметр1 <> неопределено И Параметр2 <> неопределено И Параметр2.Свойство("КТК") Тогда
		
		ТекД.СписокКТК.ЗагрузитьЗначения(Параметр1);
		
	ИначеЕсли Параметр1 <> неопределено И Параметр2 <> неопределено И Параметр2.Свойство("ТД") Тогда
		
		ТекД.СписокТД.ЗагрузитьЗначения(Параметр1);
		
	КонецЕсли;
	
КонецПроцедуры

