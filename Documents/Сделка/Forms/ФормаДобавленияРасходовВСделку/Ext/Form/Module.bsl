&НаКлиенте
Процедура ТЧПриИзменении(Элемент)
	
	ИмяТекПоля = Сред(Элементы.ТЧ.ТекущийЭлемент.Имя, 3);
	
	Если Элементы.ТЧ.ТекущиеДанные = неопределено Тогда Возврат; КонецЕсли;
	
	Расходы_КоличествоИзменено = Ложь;
	Если ЗначениеЗаполнено(Элементы.ТЧ.ТекущиеДанные.Количество) И НЕ ЗначениеЗаполнено(Элементы.ТЧ.ТекущиеДанные.Расходы_Количество) Тогда Элементы.ТЧ.ТекущиеДанные.Расходы_Количество = Элементы.ТЧ.ТекущиеДанные.Количество; Расходы_КоличествоИзменено = Истина; КонецЕсли;
	Расходы_СтавкаНДСИзменено = Ложь;
	Если ЗначениеЗаполнено(Элементы.ТЧ.ТекущиеДанные.СтавкаНДС) И НЕ ЗначениеЗаполнено(Элементы.ТЧ.ТекущиеДанные.Расходы_СтавкаНДС) Тогда Элементы.ТЧ.ТекущиеДанные.Расходы_СтавкаНДС = Элементы.ТЧ.ТекущиеДанные.СтавкаНДС; Расходы_СтавкаНДСИзменено = Истина; КонецЕсли;
	Расходы_ВалютаИзменено = Ложь;
	Если ЗначениеЗаполнено(Элементы.ТЧ.ТекущиеДанные.Валюта) И НЕ ЗначениеЗаполнено(Элементы.ТЧ.ТекущиеДанные.Расходы_Валюта) Тогда Элементы.ТЧ.ТекущиеДанные.Расходы_Валюта = Элементы.ТЧ.ТекущиеДанные.Валюта; Расходы_ВалютаИзменено = Истина; КонецЕсли;
	Расходы_УслугаИзменено = Ложь;
	Если ЗначениеЗаполнено(Элементы.ТЧ.ТекущиеДанные.Услуга) И НЕ ЗначениеЗаполнено(Элементы.ТЧ.ТекущиеДанные.Расходы_Услуга) Тогда Элементы.ТЧ.ТекущиеДанные.Расходы_Услуга = Элементы.ТЧ.ТекущиеДанные.Услуга; Расходы_УслугаИзменено = Истина; КонецЕсли;
	
	ОбновитьМатематикуСтроки(Элементы.ТЧ.ТекущиеДанные);
	
	Если Элементы.ТЧ.ТекущиеДанные.ГрупповоеИзменение = Истина И ИмяТекПоля <> "ГрупповоеИзменение" Тогда
		
		Для каждого Стр из ТЧ Цикл
			
			Если Стр.ГрупповоеИзменение = Истина Тогда 
				
				Стр[ИмяТекПоля] = Элементы.ТЧ.ТекущиеДанные[ИмяТекПоля];
				
				Если Расходы_КоличествоИзменено Тогда Стр["Расходы_Количество"] = Элементы.ТЧ.ТекущиеДанные["Расходы_Количество"]; КонецЕсли;
				Если Расходы_СтавкаНДСИзменено Тогда Стр["Расходы_СтавкаНДС"] = Элементы.ТЧ.ТекущиеДанные["Расходы_СтавкаНДС"]; КонецЕсли;
				Если Расходы_ВалютаИзменено Тогда Стр["Расходы_Валюта"] = Элементы.ТЧ.ТекущиеДанные["Расходы_Валюта"]; КонецЕсли;
				Если Расходы_УслугаИзменено Тогда Стр["Расходы_Услуга"] = Элементы.ТЧ.ТекущиеДанные["Расходы_Услуга"]; КонецЕсли;
				
				ОбновитьМатематикуСтроки(Стр);
				
			КонецЕсли;
			
		КонецЦикла;
		
	ИначеЕсли ЗаполнятьПоПервойСтроке Тогда
		
		Для Сч = 1 По ТЧ.Количество()-1 Цикл
			
			ТЧ[Сч][ИмяТекПоля] = ТЧ[0][ИмяТекПоля];
			ОбновитьМатематикуСтроки(ТЧ[Сч]);
			
		КонецЦикла;
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьМатематикуСтроки(ТекД)
	
	ТекД.Ставка 				= ТекД.Себестоимость + ТекД.Вознаграждение;
	ТекД.Рентабельность 		= ТекД.Вознаграждение / ?(ТекД.Ставка = 0, 1, ТекД.Ставка);
	
	ТекД.СебестоимостьИтого 	= ТекД.Количество * ТекД.Себестоимость;
	ТекД.ВознаграждениеИтого 	= ТекД.Количество * ТекД.Вознаграждение;
	ТекД.СтавкаИтого 			= ТекД.Количество * ТекД.Ставка;
	
	ТекД.СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиент.ПолучитьСуммуНДС(ТекД.СтавкаИтого, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(ТекД.СтавкаНДС), Истина, ТекД.НДСВключенВСтоимость);
	
	ТекД.СуммаИтого = ТекД.СтавкаИтого + ?(ТекД.НДСВключенВСтоимость, 0, ТекД.СуммаНДС);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбновитьМатематикуСтроки_Сервер(ТекД)
	
	ТекД.Ставка 				= ТекД.Себестоимость + ТекД.Вознаграждение;
	ТекД.Рентабельность 		= ТекД.Вознаграждение / ?(ТекД.Ставка = 0, 1, ТекД.Ставка);
	
	ТекД.СебестоимостьИтого 	= ТекД.Количество * ТекД.Себестоимость;
	ТекД.ВознаграждениеИтого 	= ТекД.Количество * ТекД.Вознаграждение;
	ТекД.СтавкаИтого 			= ТекД.Количество * ТекД.Ставка;
	
	ТекД.СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(ТекД.СтавкаИтого, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(ТекД.СтавкаНДС), Истина, ТекД.НДСВключенВСтоимость);
	
	ТекД.СуммаИтого = ТекД.СтавкаИтого + ?(ТекД.НДСВключенВСтоимость, 0, ТекД.СуммаНДС);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьСлужебнуюСделку(Команда)
	
	Если НЕ ЗначениеЗаполнено(ТипЗаказа) Тогда
		
		ПоказатьПредупреждение(, "Перед продолжением укажите тип создаваемого заказа!");
		Возврат;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Сделка) Тогда
		
		ПоказатьПредупреждение(, "Нельзя создать служебную сделку, если заполнено поле ""Сделка"".");
		Возврат;
		
	КонецЕсли;
	
	Сделка = РаботаСоСделкамиСервер.СоздатьСлужебнуюСделкуДляНакладных(ТипЗаказа);
	
КонецПроцедуры

