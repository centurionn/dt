&НаКлиенте
Процедура ТЧПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	НСтр = ТЧ.Добавить();
	НСтр.УслугаВнеСтавки = Истина;
	НСтр.ИсточникПоявленияСтрокиЭкономики = ПредопределенноеЗначение("Перечисление.ИсточникПоявленияСтрокиЭкономики.ПроизвольнаяУслугаВручную");
	НСтр.Доходы = Истина;
	НСтр.Расходы = Истина;
	НСтр.РазмерКТК = ПредопределенноеЗначение("Справочник.РазмерыКТК.К40");  
	
	// ДИТ US 71603 ТА 72312 Сержантова А.С. Начало: 14.07.2023
	Если Параметры.Свойство("УслугиЗаСчетЧистойПрибыли") Тогда
		НСтр.РасходыЗаСчетЧП = Истина;
	КонецЕсли;
	// ДИТ US 71603 ТА 72312 Сержантова А.С. Конец: 14.07.2023 
	
	ОпределитьНоменклатурнуюГруппу();
	
	
