&НаСервереБезКонтекста
Процедура ПересчитатьПериодыНаСервере(СделкаО, СохранитьИмеющиеся)
	
	//Евросиб Каблов 09.04.2025 ( #105407
	//ДатаОткрытогоПериода = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериод(СделкаО.Организация);
	ДатаОткрытогоПериода = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериодДоходов(СделкаО.Организация);
	//Евросиб Каблов 09.04.2025 )
	Для каждого Стр из СделкаО.Доходы Цикл
		Если (ЗначениеЗаполнено(Стр.ПериодВО) 
			И СохранитьИмеющиеся = Истина)
			ИЛИ ЗначениеЗаполнено(Стр.УчДокумент)
			Тогда Продолжить; КонецЕсли;
		РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Стр.Договор, "ПравилоФормированияДатыУслуги, ПериодичностьВыставленияДокументов, ДатаПаспортаСделки");
		СтруктураПараметров = Новый Структура("ПериодВО, Клиент, Дата, Номенклатура, СтрокаДоходовСделки, СписокТД, СписокТЕ, НомерСтроки, Коносамент");
		СтруктураПараметров.ПериодВО = ДатаОткрытогоПериода;
		СтруктураПараметров.Клиент = Стр.Клиент;
		СтруктураПараметров.Дата = ТекущаяДата();
		СтруктураПараметров.Номенклатура = Стр.Услуга;
		СтруктураПараметров.СтрокаДоходовСделки = Стр.ГУИД;
		СтруктураПараметров.СписокТД = ПолучитьЗначениеСписочнойТаблицы(СделкаО, "ДоходыТД", Стр.ГУИД);// Стр.СписокТД;
		СтруктураПараметров.СписокТЕ = ПолучитьЗначениеСписочнойТаблицы(СделкаО, "ДоходыКТК", Стр.ГУИД);//Стр.СписокКТК;
		СтруктураПараметров.НомерСтроки = Стр.НомерСтроки;
		СтруктураПараметров.Коносамент = Стр.Коносамент;
		Стр.ПериодВО = ФормированиеДатДокументов.УстановкаДатыДокумента(СделкаО.Ссылка,
														 РеквизитыДоговора.ПравилоФормированияДатыУслуги,
														 РеквизитыДоговора.ПериодичностьВыставленияДокументов,
														 РеквизитыДоговора.ДатаПаспортаСделки,
														 СтруктураПараметров);
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗначениеСписочнойТаблицы(СделкаОбъект, ИмяТаблицы, ИскомыйГУИД)
	
	Результат = "";
	
	НайдСтр = СделкаОбъект[ИмяТаблицы].Найти(ИскомыйГУИД, "ГУИД");
	
	Если НайдСтр <> неопределено Тогда
		Если ИмяТаблицы = "ДоходыВагоны" Тогда
			Результат = НайдСтр.Вагон;
		ИначеЕсли ИмяТаблицы = "ДоходыКТК" Тогда
			Результат = НайдСтр.КТК;
		ИначеЕсли ИмяТаблицы = "ДоходыТД" Тогда
			Результат = НайдСтр.ТД;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


&НаСервереБезКонтекста
Процедура ДоходыПриИзменении(Элемент, Знач ТекД = неопределено)
	
	Если ТекД <> неопределено Тогда
		
		ТекД.Ставка 				= ТекД.Себестоимость + ТекД.Вознаграждение;
		ТекД.Рентабельность 		= ТекД.Вознаграждение / ?(ТекД.Ставка = 0, 1, ТекД.Ставка);
		
		ТекД.СебестоимостьИтого 	= ТекД.Количество * ТекД.Себестоимость;
		ТекД.ВознаграждениеИтого 	= ТекД.Количество * ТекД.Вознаграждение;
		ТекД.СтавкаИтого 			= ТекД.Количество * ТекД.Ставка;
		
		ТекД.СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(ТекД.СтавкаИтого, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(ТекД.СтавкаНДС), Истина, ТекД.НДСВключенВСтоимость);
		
		ТекД.СуммаИтого = ТекД.СтавкаИтого + ?(ТекД.НДСВключенВСтоимость, 0, ТекД.СуммаНДС);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура РасходыПриИзменении(Элемент, Знач ТекД = неопределено)
	
	Если ТекД <> неопределено Тогда
		
		ТекД.СебестоимостьИтого		= ТекД.Себестоимость * ТекД.Количество;
		ТекД.СуммаНДС 				= БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(ТекД.СебестоимостьИтого, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(ТекД.СтавкаНДС), Истина, ТекД.НДСВключенВСтоимость);
		ТекД.СуммаИтого 			= ТекД.СебестоимостьИтого + ?(ТекД.НДСВключенВСтоимость, 0, ТекД.СуммаНДС);
		
	КонецЕсли;
	
	
КонецПроцедуры

