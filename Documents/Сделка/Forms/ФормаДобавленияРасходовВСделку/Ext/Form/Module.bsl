&НаКлиенте
Процедура ОпределитьНоменклатурнуюГруппу()
	
	Для каждого Стр из ТЧ Цикл
		
		Если НЕ ЗначениеЗаполнено(Стр.НоменклатурнаяГруппа) И ЗначениеЗаполнено(ТипЗаказа) Тогда
			
			Стр.НоменклатурнаяГруппа = РазнесениеЗатратСервер.ПодобратьНоменклатурнуюГруппуПоНаборуПараметров(ТипЗаказа, СтрСоединить(Стр.СписокВагонов.ВыгрузитьЗначения(), ";"));
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьИзКалькуляции(Команда)
	
	ТекД = Элементы.ТЧ.ТекущиеДанные;
	Если ТекД <> неопределено И ЗначениеЗаполнено(ТекД.Калькуляция) Тогда
		ПродолжитьОткрытиеВыбораУслуги(ТекД.Калькуляция);
	Иначе
		ОпОп = Новый ОписаниеОповещения("ПродолжитьОткрытиеВыбораУслуги", ЭтаФорма);
		ОткрытьФорму("Документ.Калькуляция.ФормаВыбора",,, ЭтаФорма.УникальныйИдентификатор,,, ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОткрытиеВыбораУслуги(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 <> неопределено Тогда
		ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораУслугиИзКалькуляции", ЭтаФорма);
		ОткрытьФорму("Документ.Сделка.Форма.ФормаДобавленияУслугиИзКалькуляции", Новый Структура("Калькуляция, РазмерКТК", П1, ?(Элементы.тч.ТекущиеДанные = неопределено, ПредопределенноеЗначение("Справочник.РазмерыКТК.К40"), Элементы.тч.ТекущиеДанные.РазмерКТК)),,ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораУслугиИзКалькуляции(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = неопределено Тогда Возврат; КонецЕсли;
	
	УслугаЕИ = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(П1.Услуга, "ЕдиницаИзмерения");
	
	НСтр = ТЧ.Добавить();
	ЗаполнитьЗначенияСвойств(НСтр, П1);
	НСтр.Перевыставляемая = П1.ТипСтавки <> ПредопределенноеЗначение("Перечисление.ТипыСтавокПротокола.Ставка");
	НСтр.УслугаВнеСтавки = Истина;
	НСтр.ЕдиницаИзмерения = УслугаЕИ.ЕдиницаИзмерения;
	НСтр.ИсточникПоявленияСтрокиЭкономики = ПредопределенноеЗначение("Перечисление.ИсточникПоявленияСтрокиЭкономики.ДопИзКалькуляцииВручную");
	НСтр.Доходы = Истина;
	НСтр.Расходы = Истина;
	
	ОпределитьНоменклатурнуюГруппу();
	
КонецПроцедуры

