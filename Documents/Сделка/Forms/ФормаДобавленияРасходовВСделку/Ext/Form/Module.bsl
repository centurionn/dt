Процедура ВставитьИзExcel(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаВставкиExcel", ЭтаФорма);
	ОткрытьФорму("Документ.Сделка.Форма.ФормаВставкиЭкономикиИзExcel",,,ЭтаФорма.УникальныйИдентификатор,,,ОпОП,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
