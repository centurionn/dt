Функция ПолучитьСведенияДоходовСделки(Сделка)
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	СделкаДоходы.Клиент КАК Клиент,
	               |	СделкаДоходы.Договор КАК Договор,
	               |	СделкаДоходы.Услуга КАК Услуга,
	               |	СделкаДоходы.Калькуляция КАК Калькуляция,
	               |	СделкаДоходы.ПСЦ КАК ПСЦ,
	               |	СделкаДоходы.РазмерКТК КАК РазмерКТК,
	               |	СделкаДоходы.ГУИД КАК ГУИД,
	               |	СделкаДоходы.УчДокумент КАК УчДокумент,
	               |	СделкаДоходы.СуммаИтого КАК СуммаИтого,
	               |	ВЫРАЗИТЬ(СделкаДоходыВагоны.Вагон КАК СТРОКА(1000)) КАК СписокВагонов,
	               |	ВЫРАЗИТЬ(СделкаДоходыКТК.КТК КАК СТРОКА(1000)) КАК СписокКТК,
	               |	ВЫРАЗИТЬ(СделкаДоходыТД.ТД КАК СТРОКА(1000)) КАК СписокТД,
	               |	СделкаДоходы.Количество КАК Количество,
	               |	СделкаДоходы.СтавкаНДС КАК СтавкаНДС,
	               |	СделкаДоходы.УслугаВнеСтавки КАК УслугаВнеСтавки,
	               |	СделкаДоходы.ГУИД КАК ГУИДСтрокиДоходов
	               |ИЗ
	               |	Документ.Сделка.Доходы КАК СделкаДоходы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.ДоходыВагоны КАК СделкаДоходыВагоны
	               |		ПО СделкаДоходы.Ссылка = СделкаДоходыВагоны.Ссылка
	               |			И СделкаДоходы.ГУИД = СделкаДоходыВагоны.ГУИД
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.ДоходыКТК КАК СделкаДоходыКТК
	               |		ПО СделкаДоходы.Ссылка = СделкаДоходыКТК.Ссылка
	               |			И СделкаДоходы.ГУИД = СделкаДоходыКТК.ГУИД
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.ДоходыТД КАК СделкаДоходыТД
	               |		ПО СделкаДоходы.Ссылка = СделкаДоходыТД.Ссылка
	               |			И СделкаДоходы.ГУИД = СделкаДоходыТД.ГУИД
	               |ГДЕ
	               |	СделкаДоходы.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Сделка);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		НСтрук = Новый Структура("ГУИДСтрокиДоходов, УслугаВнеСтавки, Клиент, Договор, Услуга, Калькуляция, ПСЦ, РазмерКТК, ГУИД, УчДокумент, СуммаИтого, СписокВагонов, СписокКТК, СписокТД, Количество, СтавкаНДС");
		ЗаполнитьЗначенияСвойств(НСтрук, Ответ);
		Результат.Добавить(НСтрук);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

