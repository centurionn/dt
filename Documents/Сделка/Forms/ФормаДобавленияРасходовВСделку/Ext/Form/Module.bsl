// ДИТ US 83693 ТА 83970 Сержантова А.С. 06.05.2024
&НаКлиенте
Процедура СвязатьПоВидуТранспортногоСообщенияПриИзменении(Элемент)     
	Для каждого Строка Из ТЧ Цикл
		Если Строка.ВидТранспортногоСообщения <> СвязатьПоВидуТранспортногоСообщения Тогда
			Строка.ТребуетсяУказатьСтрокуДоходов = Истина;
		КонецЕсли;
	КонецЦикла;
	СделкаПриИзменении(Неопределено);	
КонецПроцедуры

//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 114152, 04-08-2025, начало
&НаКлиенте
Процедура РежимДобавленияВозмещаемыхПриИзменении(Элемент)
	Если РежимДобавленияВозмещаемых = 1 Тогда
		ДанныеИзСП = Истина;
		Элементы.ТЧУказатьСтрокуДоходов.Заголовок = "Указать строку состава поезда";
		Элементы.ТЧТребуетсяУказатьСтрокуДоходов.Заголовок = "Укажите строку состава поезда";
		Элементы.ТЧГруппаДоходы.Заголовок = "Состав поезда";
		Элементы.ТЧГруппа31.Видимость = Истина;
	Иначе
		ДанныеИзСП = Ложь;
		Элементы.ТЧУказатьСтрокуДоходов.Заголовок = "Указать строку доходов";
		Элементы.ТЧТребуетсяУказатьСтрокуДоходов.Заголовок = "Укажите строку доходов";
		Элементы.ТЧГруппаДоходы.Заголовок = "Доходы сделки";
		Элементы.ТЧГруппа31.Видимость = Истина;
	КонецЕсли;
КонецПроцедуры
//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 114152, 04-08-2025, конец