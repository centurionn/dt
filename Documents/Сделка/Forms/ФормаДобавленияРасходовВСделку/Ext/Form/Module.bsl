&НаСервере
Процедура Автоподбор()
		
	УслугаФрахта = ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьЗначениеКонстанты("УслугаФрахтаДляКалькуляции");
	ДанныеСвязиУчетныхЕдиниц = ПолучитьСведенияСвязиУчетныхЕдиниц(Сделка); 
	
	ТЗ = Новый ТаблицаЗначений;
	
	Для Каждого Стр Из ДанныеСвязиУчетныхЕдиниц Цикл 
		
		Если ТЗ.Колонки.Количество() = 0 Тогда 
			Для Каждого СтрСтруктура Из Стр Цикл 
				ТЗ.Колонки.Добавить(СтрСтруктура.Ключ);
			КонецЦикла;
		КонецЕсли;	                          
		ЗаполнитьЗначенияСвойств(ТЗ.Добавить(),Стр);
	КонецЦикла;
	
	Если ТЗ.Колонки.Количество() Тогда 
		Для Каждого Стр Из ТЧ Цикл 
			Если Стр.ТребуетсяУказатьСтрокуДоходов Тогда 
				Отбор = Новый Структура;
				Если ЗначениеЗаполнено(Стр.Вагон) Тогда 
					Отбор.Вставить("СписокВагонов",Стр.Вагон);		
				КонецЕсли;	                                  
				Если ЗначениеЗаполнено(Стр.Контейнер) Тогда 
					Отбор.Вставить("Контейнер",Стр.Контейнер);		
				КонецЕсли;	
				// ДИТ ТА 71560 Сержантова А.С. Начало: 19.06.2023  
				// Было:
				//Если ЗначениеЗаполнено(Стр.ТранспортныйДокумент) Тогда 
				//	Отбор.Вставить("ЖДН",Стр.ТранспортныйДокумент);		
				//КонецЕсли;
				// Стало: 
				Если Стр.ТранспортныйДокумент.ВидОперации = Перечисления.ВидыОперацийТранспортныхДокументов.Коносамент Тогда
					 Отбор.Вставить("Коносамент",Стр.ТранспортныйДокумент);
				ИначеЕсли ЗначениеЗаполнено(Стр.ТранспортныйДокумент) Тогда 
					 Отбор.Вставить("ЖДН",Стр.ТранспортныйДокумент);
				КонецЕсли;
				// ДИТ ТА 71560 Сержантова А.С. Конец: 19.06.2023
				Если Стр.Услуга = УслугаФрахта Тогда 
					Отбор.Вставить("ВидТранспортногоСообщения",Перечисления.ВидыТранспортныхСообщений.Море); 
				// ДИТ US 83693 ТА 83970 Сержантова А.С. Начало: 26.04.2024
				ИначеЕсли ЗначениеЗаполнено(СвязатьПоВидуТранспортногоСообщения) Тогда	
					Отбор.Вставить("ВидТранспортногоСообщения", СвязатьПоВидуТранспортногоСообщения);	
				// ДИТ US 83693 ТА 83970 Сержантова А.С. Конец: 26.04.2024
				Иначе      
					Отбор.Вставить("ВидТранспортногоСообщения",Перечисления.ВидыТранспортныхСообщений.ЖД);	
				КонецЕсли;     
				
				МассивСтрок = ТЗ.НайтиСтроки(Отбор);
				Если МассивСтрок.Количество() = 1 Тогда 
					Стр.ТребуетсяУказатьСтрокуДоходов = Ложь;
					ЗаполнитьЗначенияСвойств(Стр,МассивСтрок[0],,"Контейнер,СписокВагонов"); 
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;	
    КонецЕсли;
КонецПроцедуры
