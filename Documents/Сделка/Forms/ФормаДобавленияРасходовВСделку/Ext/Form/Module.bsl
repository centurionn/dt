&НаКлиенте
Процедура ОбработкаВыбораСтрокиДоходовСделки(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 <> неопределено Тогда
		
		ТекД = Элементы.ТЧ.ТекущиеДанные;
		ТекД.ТребуетсяУказатьСтрокуДоходов = Ложь;
		//ДИТ Шевченко А.В. US 47112 ТА 69407 21.06.2023 -Начало
		Если НЕ ДанныеИзСП Тогда
			//ЗаполнитьЗначенияСвойств(ТекД, П1);
			//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 114152, 06-08-2025, начало
			Если РежимДобавленияВозмещаемых = 2 Тогда
				ЗаполнитьЗначенияСвойств(ТекД, П1, ,"Себестоимость,СуммаИтого");
			Иначе 
				ЗаполнитьЗначенияСвойств(ТекД, П1);
			КонецЕсли;
			//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 114152, 06-08-2025, конец
		Иначе
			ЗаполнитьЗначенияСвойств(ТекД, П1,,"СписокКТК,СписокВагонов,СписокТД");
		КонецЕсли;
		ТекД.ГУИДСтрокиДоходов = П1.ГУИДСтрокиДоходов;
		
		Если НЕ ДанныеИзСП Тогда
			МассивКТК = СтрРазделить(П1.СписокКТК, ";", Ложь);
			Для каждого Стр из МассивКТК Цикл
				КТК = РаботаСКонтейнерамиСервер.Нормализовать_и_НайтиКТК(Стр, неопределено);
				ТекД.СписокКТК.Добавить(КТК);
			КонецЦикла;
			
			МассивВагонов = СтрРазделить(П1.СписокВагонов, ";", Ложь);
			Для каждого Стр из МассивВагонов Цикл
				КТК = РаботаСКонтейнерамиСервер.ПолучитьВагонПоНомеру(Стр, Ложь);
				ТекД.СписокВагонов.Добавить(КТК);
			КонецЦикла;
		КонецЕсли;
		//ДИТ Шевченко А.В. US 47112 ТА 69407 21.06.2023 -Конец
