&НаКлиенте
Процедура ТЧВыбраноПриИзменении(Элемент)
	
	Для каждого Стр из ТЧ Цикл Стр.Выбрано = Ложь; КонецЦикла;
	Элементы.ТЧ.ТекущиеДанные.Выбрано = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьЪ(Команда)
	
	Результат = неопределено;
	ВыбранныеСтроки = ТЧ.НайтиСтроки(Новый Структура("Выбрано", Истина));
	Если ВыбранныеСтроки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбраны строки для переноса");
		Возврат;
	КонецЕсли; 
	Для каждого Стр из ТЧ Цикл
		Если Стр.Выбрано Тогда
			// ДИТ US 47112 TA 62979 Евсенкин М.А. Начало: 11.04.2023
			// Было:
			//Результат = Новый Структура("Клиент, Договор, Услуга, Калькуляция, ПСЦ, Количество, СписокКТК, СписокВагонов, СписокТД, СтавкаНДС, Себестоимость, СуммаИтого, ГУИДСтрокиДоходов",
			//Стр.Клиент, Стр.Договор, Стр.Услуга, Стр.Калькуляция, Стр.ПСЦ, Стр.Количество, Стр.СписокКТК, Стр.СписокВагонов, Стр.СписокТД, Стр.СтавкаНДС, Стр.СуммаИтого / ?(Стр.Количество = 0, 1, Стр.Количество), Стр.СуммаИтого, Стр.ГУИД
			//);
			//Стало:
			//ДИТ Шевченко А.В. US 68330 ТА 69907 16.05.2023 -Начало
			//Результат = Новый Структура("Клиент, Договор, Услуга, Калькуляция, ПСЦ, Количество, СписокКТК, СписокВагонов, СписокТД, СтавкаНДС, Себестоимость, СуммаИтого, ГУИДСтрокиДоходов,ВидТранспортногоСообщения,ТипКалькуляции");
			//ЗаполнитьЗначенияСвойств(Результат,Стр);
			//Результат.Вставить("Себестоимость",Стр.СуммаИтого / ?(Стр.Количество = 0, 1, Стр.Количество));
			//Результат.Вставить("ГУИДСтрокиДоходов",Стр.ГУИД);
			
			Результат = Новый Структура("Клиент, Договор, Калькуляция, ПСЦ, СписокКТК, СписокВагонов, СписокТД, ГУИДСтрокиДоходов,ВидТранспортногоСообщения,ТипКалькуляции");
			Если ДанныеИзСП Тогда
				ЗаполнитьЗначенияСвойств(Результат,Стр);
				Результат.Вставить("ГУИДСП",Стр.ГУИД);
			Иначе
				Результат.Вставить("Услуга");
				Результат.Вставить("СтавкаНДС");
				Результат.Вставить("СуммаИтого");
				Результат.Вставить("Количество",Стр.Количество);
				ЗаполнитьЗначенияСвойств(Результат,Стр);
				Результат.Вставить("Себестоимость",Стр.СуммаИтого / ?(Стр.Количество = 0, 1, Стр.Количество));
				Результат.Вставить("ГУИДСтрокиДоходов",Стр.ГУИД);
			КонецЕсли;
			//ДИТ Шевченко А.В. US 68330 ТА 69907 16.05.2023 -Конец
			// ДИТ US 47112 TA 62979 Евсенкин М.А. Конец: 11.04.2023
			Прервать; 
		КонецЕсли;
	КонецЦикла;
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть(Неопределено);
КонецПроцедуры

// ДИТ US 47112 TA 62979 Евсенкин М.А. Начало: 19.04.2023
&НаКлиенте
Процедура ПоказатьБезОтбора(Команда)
	ПоказатьБезОтбора = Не ПоказатьБезОтбора;
	Элементы.ФормаПоказатьБезОтбора.Пометка = ПоказатьБезОтбора;
	ПриСозданииНаСервереФрагмент();
КонецПроцедуры
// ДИТ US 47112 TA 62979 Евсенкин М.А. Конец: 19.04.2023
