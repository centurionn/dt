
&НаКлиенте
Процедура ПрочитатьЪ(Команда)
	
	ПрочитатьДанные_сервер();
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДанные_сервер()
	
	Сч = 2;
	Распозн.Очистить();
	
	ПрочСтрока = Excel.Область("R"+Сч+"C1").Текст;
	
	Пока ПрочСтрока <> "" Цикл
		
		НСтр = Распозн.Добавить();
		
		НомерКТК = Excel.Область("R"+Сч+"C1").Текст;
		НСтр.КТК = РаботаСКонтейнерамиСервер.НайтиКТК(НомерКТК, Ложь);
		
		НомерВагона = Excel.Область("R"+Сч+"C2").Текст;
		НСтр.Вагон = РаботаСКонтейнерамиСервер.ПолучитьВагонПоНомеру(НомерВагона, Ложь);
		
		Сч = Сч + 1;
		ПрочСтрока = Excel.Область("R"+Формат(Сч, "ЧГ=0")+"C1").Текст;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВТаблицу(Команда)
	
	Результат = Новый Массив;
	Для каждого Стр из Распозн Цикл
		
		Результат.Добавить(Новый Структура("КТК, Вагон", Стр.КТК, Стр.Вагон));
		
	КонецЦикла;
	
	Закрыть(результат);
	
КонецПроцедуры

