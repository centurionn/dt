
&НаКлиенте
Процедура ОК(Команда)
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Отметка",Истина);
	НайденныеСтроки = СписокЖДН.НайтиСтроки(ПараметрыОтбора);
	ОповеститьОВыборе(НайденныеСтроки);
	//Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Сделка") Тогда
		Сделка = Параметры.Сделка;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Сделка) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	АктуальныеЖДНОстатки.Контейнер КАК Контейнер,
	               |	АктуальныеЖДНОстатки.ЖДН КАК ЖДН,
	               |	АктуальныеЖДНОстатки.Вагон КАК Вагон
	               |ПОМЕСТИТЬ НомерНакладнойРС
	               |ИЗ
	               |	РегистрНакопления.АктуальныеЖДН.Остатки КАК АктуальныеЖДНОстатки
	               |ГДЕ
	               |	АктуальныеЖДНОстатки.НаличиеОстаток > 0
	               |	И НЕ АктуальныеЖДНОстатки.Контейнер.Наименование = ""0""
	               |	И НЕ АктуальныеЖДНОстатки.ЖДН = """"
	               |	И НЕ АктуальныеЖДНОстатки.Вагон = ЗНАЧЕНИЕ(Справочник.ТС.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НомерНакладнойРС.Контейнер КАК Контейнер,
	               |	НомерНакладнойРС.ЖДН КАК ЖДН,
	               |	НомерНакладнойРС.Вагон КАК Вагон,
	               |	э_Накладная.ДатаИВремяОтправленияГруза КАК ДатаИВремяОтправленияГруза,
	               |	ДОБАВИТЬКДАТЕ(э_Накладная.ДатаИВремяОтправленияГруза, ДЕНЬ, -20) КАК МинимальнаяДатаПорожняка
	               |ПОМЕСТИТЬ ДанныеПоНакладной
	               |ИЗ
	               |	НомерНакладнойРС КАК НомерНакладнойРС
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.э_Накладная КАК э_Накладная
	               |		ПО НомерНакладнойРС.ЖДН = э_Накладная.Номер
	               |ГДЕ
	               |	НЕ э_Накладная.ДатаИВремяОтправленияГруза = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МАКСИМУМ(э_НакладнаяВагоны.Ссылка.ДатаИВремяПрибытияГруза) КАК ДатаИВремяПрибытияГруза,
	               |	э_НакладнаяВагоны.НомерВагона КАК НомерВагона
	               |ПОМЕСТИТЬ ДанныеПоВагНакладной
	               |ИЗ
	               |	ДанныеПоНакладной КАК ДанныеПоНакладной
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.э_Накладная.Вагоны КАК э_НакладнаяВагоны
	               |		ПО ДанныеПоНакладной.Вагон.Наименование = э_НакладнаяВагоны.НомерВагона
	               |			И (э_НакладнаяВагоны.Ссылка.ДатаИВремяПрибытияГруза МЕЖДУ ДанныеПоНакладной.МинимальнаяДатаПорожняка И ДанныеПоНакладной.ДатаИВремяОтправленияГруза)
	               |			И (э_НакладнаяВагоны.МассыВКгНетто = 0)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	э_НакладнаяВагоны.НомерВагона
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МАКСИМУМ(э_НакладнаяВагоны.Ссылка.Номер) КАК НомерВагоннойЖДН,
	               |	ДанныеПоНакладной.Контейнер КАК Контейнер,
	               |	ДанныеПоНакладной.ЖДН КАК НомерЖДН,
	               |	ДанныеПоНакладной.Вагон КАК Вагон
	               |ИЗ
	               |	ДанныеПоНакладной КАК ДанныеПоНакладной
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеПоВагНакладной КАК ДанныеПоВагНакладной
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Документ.э_Накладная.Вагоны КАК э_НакладнаяВагоны
	               |			ПО ДанныеПоВагНакладной.НомерВагона = э_НакладнаяВагоны.НомерВагона
	               |				И ДанныеПоВагНакладной.ДатаИВремяПрибытияГруза = э_НакладнаяВагоны.Ссылка.ДатаИВремяПрибытияГруза
	               |		ПО ДанныеПоНакладной.Вагон.Наименование = ДанныеПоВагНакладной.НомерВагона
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ДанныеПоНакладной.ЖДН,
	               |	ДанныеПоНакладной.Вагон,
	               |	ДанныеПоНакладной.Контейнер";
	ТЗ = Запрос.Выполнить().Выгрузить();
	СписокЖДН.Загрузить(ТЗ);
	

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры

