Процедура УбратьНевыполненныеЗадачиПоДругимОтветственным(ОставляемыйОтветственныйПоЗадаче, ТекЗадача)
	Отбор = Новый Структура;
	Отбор.Вставить("ЗадачаГотовностиКВыставлению",ТекЗадача); 
	//// ДИТ Поморцева Т.П. Задача 37052 09.02.22. начало
