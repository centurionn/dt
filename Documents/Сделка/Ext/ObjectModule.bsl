	               |	ДислокацияКонтейнеров.ИндексПоезда КАК ИндексПоезда,
	               |	ДислокацияКонтейнеров.Вагон КАК Вагон,
	               |	э_Накладная.Ссылка КАК ЭТРАН_Ссылка,
	               |	ТранспортныйДокумент.Ссылка КАК ТД_Ссылка
	               |ИЗ
	               |	РегистрСведений.ДислокацияКонтейнеров КАК ДислокацияКонтейнеров
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.э_Накладная.Контейнеры КАК э_Накладная				   
				   |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	               |			ПО э_Накладная.Ссылка = ТранспортныйДокумент.НакладнаяЭТРАН
	               |		ПО ДислокацияКонтейнеров.НомерНакладной = э_Накладная.Ссылка.НакладнаяНомер
	               |ГДЕ
	               |	ДислокацияКонтейнеров.Контейнер = &Контейнер
	               |	И ДислокацияКонтейнеров.Груженый
	               |	И (ДислокацияКонтейнеров.СтанцияПогрузкиВагона = &СтанцияПогрузкиКонтейнера
	               |			ИЛИ ДислокацияКонтейнеров.СтанцияПогрузкиВагона = ЗНАЧЕНИЕ(СПравочник.Локации.ПустаяСсылка))
	               |	И ДислокацияКонтейнеров.СтанцияНазначения = &СтанцияНазначения
	               |	И ДислокацияКонтейнеров.Период МЕЖДУ &Дата1 И &Дата2
	               |	И ДислокацияКонтейнеров.ОперацияСВагоном.ОтправлениеСоСтанции
	               |	И э_Накладная.Ссылка.Дата МЕЖДУ &Дата1 И &Дата2
	               |	И НЕ э_Накладная.Ссылка.ПометкаУдаления
	               |	И э_Накладная.Ссылка.ТекущееСостояниеНакладнойДействующийСтатус
	               |УПОРЯДОЧИТЬ ПО
	               |	Период УБЫВ";
	Запрос.УстановитьПараметр("Контейнер", КТК);
	Запрос.УстановитьПараметр("СтанцияПогрузкиКонтейнера", СтанцияПогрузки);
	Запрос.УстановитьПараметр("СтанцияНазначения", СтанцияВыгрузки);
	Запрос.УстановитьПараметр("Дата1", НачалоПериода);
	Запрос.УстановитьПараметр("Дата2", КонецПериода);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		
		Результат.НомерЖДН = Ответ.НомерНакладной;
		Результат.СсылкаЖДН = Ответ.ТД_Ссылка;
		Результат.Вагон = Ответ.Вагон;
		
	КонецЕсли;
	
	Возврат Результат;
	
