Функция ПолучитьМассивИспользованныхСостоянийУчета(); 
	ИспользованныеСостоянияУчета = СвязьУчетныхЕдиниц.Выгрузить().ВыгрузитьКолонку("ЗадачаГотовностиКВыставлению");
	Для каждого СтрокаДоходов из Доходы Цикл
		Если ЗначениеЗаполнено(СтрокаДоходов.ЗадачаГотовностиКВыставлению) Тогда 
			ИспользованныеСостоянияУчета.Добавить(СтрокаДоходов.ЗадачаГотовностиКВыставлению); 
		КонецЕсли;
	КонецЦикла;
	Возврат ИспользованныеСостоянияУчета;
КонецФункции 
//ДИТ, Беляев СЮ, US 37052, 23-08-2022, конец

//ДИТ, Беляев СЮ, Ticket#0285445, 14-09-2022, начало
Процедура УдалитьЗадачиНеСвязанныеССоставомПоездаИДоходами() 
	Запрос = Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	СделкаСвязьУчетныхЕдиниц.ЗадачаГотовностиКВыставлению КАК ЗадачаГотовностиКВыставлению
	             |ПОМЕСТИТЬ ЗадачиСоставаПоезда
	             |ИЗ
	             |	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	СделкаДоходы.ЗадачаГотовностиКВыставлению КАК ЗадачаГотовностиКВыставлению
	             |ПОМЕСТИТЬ ЗадачиДоходов
	             |ИЗ
	             |	Документ.Сделка.Доходы КАК СделкаДоходы
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	СделкаСостояния.Состояние КАК Состояние
	             |ПОМЕСТИТЬ ТЧСостояния
	             |ИЗ
	             |	Документ.Сделка.Состояния КАК СделкаСостояния
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	ТЧСостояния.Состояние КАК Состояние
	             |ИЗ
	             |	ТЧСостояния КАК ТЧСостояния
	             |		ЛЕВОЕ СОЕДИНЕНИЕ ЗадачиСоставаПоезда КАК ЗадачиСоставаПоезда
	             |		ПО ТЧСостояния.Состояние = ЗадачиСоставаПоезда.ЗадачаГотовностиКВыставлению
	             |		ЛЕВОЕ СОЕДИНЕНИЕ ЗадачиДоходов КАК ЗадачиДоходов
	             |		ПО ТЧСостояния.Состояние = ЗадачиДоходов.ЗадачаГотовностиКВыставлению
	             |ГДЕ
	             |	(ТЧСостояния.Состояние В ИЕРАРХИИ (&ГруппаЗадачиСозданияКомплектаДокументов)
	             |			ИЛИ ТЧСостояния.Состояние В ИЕРАРХИИ (&ГруппаЗадачиТребуетсяПеревыставитьРасходы)
				 // Евросиб US 118350 TA 118403 Рыбьяков К.А. 05.09.2025 ((
				 |			ИЛИ ТЧСостояния.Состояние В ИЕРАРХИИ (&ГруппаЗадачиСозданияКомплектаДокументовДопРасходы))
				 // Евросиб Рыбьяков К.А. 05.09.2025 ))
	             |	И ЗадачиСоставаПоезда.ЗадачаГотовностиКВыставлению ЕСТЬ NULL
	             |	И ЗадачиДоходов.ЗадачаГотовностиКВыставлению ЕСТЬ NULL";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Сделка.СвязьУчетныхЕдиниц", "&СвязьУчетныхЕдиниц");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Сделка.Доходы", "&Доходы");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Сделка.Состояния", "&Состояния");
	Запрос.УстановитьПараметр("СвязьУчетныхЕдиниц", СвязьУчетныхЕдиниц.Выгрузить(,"ЗадачаГотовностиКВыставлению"));
	Запрос.УстановитьПараметр("Доходы", Доходы.Выгрузить(,"ЗадачаГотовностиКВыставлению"));
	Запрос.УстановитьПараметр("Состояния", Состояния.Выгрузить(,"Состояние"));	
	Запрос.УстановитьПараметр("ГруппаЗадачиСозданияКомплектаДокументов", Справочники.Состояния.ЗадачиСозданияКомплектаДокументов);
	Запрос.УстановитьПараметр("ГруппаЗадачиТребуетсяПеревыставитьРасходы", Справочники.Состояния.ЗадачиТребуетсяПеревыставитьРасходы);
	// Евросиб US 118350 TA 118403 Рыбьяков К.А. 05.09.2025 ((
	Запрос.УстановитьПараметр("ГруппаЗадачиСозданияКомплектаДокументовДопРасходы", Справочники.Состояния.ЗадачиТребуетсяСоздатьКомплектДокументовПоДопРасходам);
	// Евросиб Рыбьяков К.А. 05.09.2025 ))
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл                                             
		НайдСтрокаСостояния = Состояния.Найти(Выборка.Состояние, "Состояние");
		Если НайдСтрокаСостояния <> неопределено Тогда
			Состояния.Удалить(НайдСтрокаСостояния);
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры
