Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ЭтоНовый() Тогда
		Автор = Пользователи.ТекущийПользователь();
		ГоризонтПоискаНакладных = 40;
		НачалоПериодаИспользованияНовогоАлгоритмаЗаполненияРасходов = ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьЗначениеКонстанты("НачалоПериодаИспользованияНовогоАлгоритмаЗаполненияРасходов");
		Если ЗначениеЗаполнено(НачалоПериодаИспользованияНовогоАлгоритмаЗаполненияРасходов)
			И ТекущаяДата() >= НачалоПериодаИспользованияНовогоАлгоритмаЗаполненияРасходов Тогда
			НовыйАлгоритмЗаполненияРасходов = Истина;
		КонецЕсли;
	КонецЕсли;
	//Евросиб - АСуслов 07.01.2021 13:37:59 #0213891 
	//(
	//ЦФО = Автор.ЦФО;
	ЦФО = Справочники.ЦентрыФинансовойОтветственности.ОсновнойЦФО;
	//)
	//Евросиб - АСуслов 07.01.2021 13:38:00 #0213891 
	Подразделение = Автор.Подразделение;
	Создано = ТекущаяДата();
	Организация = Константы.ОсновнаяОрганизация.Получить();
	Маршрутизировать = Константы.МаршрутизироватьСделку.Получить();
	Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	ЕдиныйОтветственныйОтОРК = Автор;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Заявка") Тогда     
		
		//Евросиб(ДИТ), Беляев СЮ, BUG 86365/TA 86947, 08-08-2024, начало
		Если НЕ ДанныеЗаполнения.Проведен Тогда
			ВызватьИсключение "Запрещено создание Сделки на основании непроведенной Заявки";
		КонецЕсли;
		//Евросиб(ДИТ), Беляев СЮ, BUG 86365/TA 86947, 08-08-2024, конец
		
		//ДИТ Шевченко А.В. 59982 12.12.2022 -начало
		ДоговорДействует = Истина;
		Если ЗначениеЗаполнено(ДанныеЗаполнения.Договор) И ЗначениеЗаполнено(ДанныеЗаполнения.Отправка) и НЕ ЗначениеЗаполнено(ДанныеЗаполнения.Прибытие) Тогда
			ДоговорДействует = Справочники.ДоговорыКонтрагентов.ПроверитьПериодДействияДоговора(ДанныеЗаполнения.Договор,ДанныеЗаполнения.Отправка,Дата(1,1,1),Истина);
		ИначеЕсли ЗначениеЗаполнено(ДанныеЗаполнения.Договор) И НЕ ЗначениеЗаполнено(ДанныеЗаполнения.Отправка) и ЗначениеЗаполнено(ДанныеЗаполнения.Прибытие) Тогда
			ДоговорДействует = Справочники.ДоговорыКонтрагентов.ПроверитьПериодДействияДоговора(ДанныеЗаполнения.Договор,ДанныеЗаполнения.Прибытие,Дата(1,1,1),Истина);
		ИначеЕсли ЗначениеЗаполнено(ДанныеЗаполнения.Договор) И ЗначениеЗаполнено(ДанныеЗаполнения.Отправка) и ЗначениеЗаполнено(ДанныеЗаполнения.Прибытие) Тогда
			ДоговорДействует = Справочники.ДоговорыКонтрагентов.ПроверитьПериодДействияДоговора(ДанныеЗаполнения.Договор,ДанныеЗаполнения.Отправка,ДанныеЗаполнения.Прибытие);
		ИначеЕсли ЗначениеЗаполнено(ДанныеЗаполнения.Договор) И НЕ ЗначениеЗаполнено(ДанныеЗаполнения.Отправка) и НЕ ЗначениеЗаполнено(ДанныеЗаполнения.Прибытие) Тогда
			ДоговорДействует = Справочники.ДоговорыКонтрагентов.ПроверитьПериодДействияДоговора(ДанныеЗаполнения.Договор,ДанныеЗаполнения.Дата,Дата(1,1,1),Истина);
		КонецЕсли;
		
		Если НЕ ДоговорДействует Тогда
			Автопролонгация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения.Договор,"Автопролонгация");
			Если Автопролонгация Тогда
				СообщениеТекст = "Документ не может быть создан. Договор не продлен на текущий год, необходимо продлить договор через отдел делопроизводства";
			Иначе
				СообщениеТекст = "Документ не может быть создан. Срок действия договора истек, необходимо оформить ДС на продления срока действия договора";
			КонецЕсли;
			ВызватьИсключение СообщениеТекст;
		КонецЕсли;
		//ДИТ Шевченко А.В. 59982 12.12.2022 -конец
		
		//ДИТ Авдеева В.С. 50072 Начало 08.09.2022	 
		Если Не ПодсылПорожних Тогда
	 		ЗаявкиВДругихСделках = ПерезаполнениеСделкиСервер.ПроверитьНаличиеЗаявкиВДругихСделках(ДанныеЗаполнения, Ссылка);
				
			Если ЗначениеЗаполнено(ЗаявкиВДругихСделках) Тогда   
				ТекстИсключения = "";
				Для Каждого КлючИЗначение Из ЗаявкиВДругихСделках Цикл 
					ТекстИсключения = ТекстИсключения + СтрСоединить(КлючИЗначение.Значение, Символы.ПС);
				КонецЦикла;   
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстИсключения, ДанныеЗаполнения);
				ВызватьИсключение("Не удалось создать документ ""Сделка""");
			КонецЕсли;    
		КонецЕсли;
		//ДИТ Авдеева В.С. 50072 Конец 08.09.2022	
		
		//Евросиб Коханенко Н.А. 04.07.2023 (( #72162
		Если КонтрагентыДоговоры_Сервер.КонтрагентЯвляетсяДирекциейКонтейнерныхПеревозок(ДанныеЗаполнения.Контрагент) Тогда
		    //выставим поле Подразделение и Региональный ЦФО на вкладке Основное
			Подразделение = Справочники.Подразделения.НайтиПоНаименованию("Основное подразделение");
			РегиональныйЦФО = Справочники.РегиональныеЦФО.РасходыДКП;
			//по реквизиту Служебная будет происходить отбор маршрутов
			Служебная = Истина;
		Иначе
			//Евросиб - АСуслов 07.01.2021 13:37:59 #0213891 
			//(
			//ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения, "Организация,ЦФО,Подразделение");
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения, "Организация,Подразделение");
			//)
			//Евросиб - АСуслов 07.01.2021 13:38:00 #0213891
		КонецЕсли;
		//Евросиб Коханенко Н.А. 04.07.2023 )) #72162 

		НСтр = Заявки.Добавить();
		НСтр.Заявка = ДанныеЗаполнения;
		//ДИТ Шевченко А.В. Ticket#0278777 19.07.2022 -начало
		Если ДанныеЗаполнения.СоставУслуги.Количество() > 0 Тогда
			НСтр.Калькуляция = ДанныеЗаполнения.СоставУслуги[0].Калькуляция;
		Иначе
			ВызватьИсключение("Отсутствуют услуги в заявке, сделка не будет создана!");
		КонецЕсли;
		//ДИТ Шевченко А.В. Ticket#0278777 19.07.2022 -конец
		ТипЗаказа = НСтр.Калькуляция.ТипЗаказа; 
		// ДИТ US 83871 ТА 85268 Сержантова А.С. Начало: 21.05.2024
		// Было:
		//Если ДанныеЗаполнения.ПереченьРейсов.Количество() > 0 Тогда
		//	НСтр = Рейсы.Добавить();
		//	НСтр.Рейс = ДанныеЗаполнения.ПереченьРейсов[0].Рейс;
		//	СтанцияОтправления = НСтр.Рейс.ПунктОтправления;
		//	СтанцияНазначения = НСтр.Рейс.ПунктНазначения;
		//КонецЕсли; 
		//Стало:
		Для каждого СтрокаРейса Из ДанныеЗаполнения.ПереченьРейсов Цикл
			Если ТипЗнч(СтрокаРейса.Рейс) <> Тип("СправочникСсылка.РейсыАвто") Тогда
				НСтр = Рейсы.Добавить();
				НСтр.Рейс = СтрокаРейса.Рейс;
				СтанцияОтправления = НСтр.Рейс.ПунктОтправления;
				СтанцияНазначения = НСтр.Рейс.ПунктНазначения; 
				Прервать;
			КонецЕсли;
		КонецЦикла;
		// ДИТ US 83871 ТА 85268 Сержантова А.С. Конец: 21.05.2024
		
	КонецЕсли;
	
КонецПроцедуры

