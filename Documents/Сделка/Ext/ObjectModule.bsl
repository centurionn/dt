Функция НайтиДокДвиженияПоКТКИДате(КТК, ДатаЪ)
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	сток_ДвижениеПоСтокам.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.сток_ДвижениеПоСтокам КАК сток_ДвижениеПоСтокам
	               |ГДЕ
	               |	сток_ДвижениеПоСтокам.Дата = &Дата
	               |	И сток_ДвижениеПоСтокам.КТК = &КТК";
	Запрос.УстановитьПараметр("Дата", ДатаЪ);
	Запрос.УстановитьПараметр("КТК", КТК);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
