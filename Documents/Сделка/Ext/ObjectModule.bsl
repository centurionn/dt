	|	И ТЧСвязьУчетныхЕдиниц.ОтветственныйЗаУчет <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВременнаяТаблица.ЗадачаГотовностиКВыставлению КАК ЗадачаГотовностиКВыставлению,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВременнаяТаблица.ОтветственныйЗаУчет) КАК КоличествоОтветственных
	//// ДИТ Поморцева Т.П. Задача 37052 09.02.22. начало
	//|   ,ВременнаяТаблица.Клиент КАК Клиент,
	//|   ВременнаяТаблица.Договор КАК Договор,
	//|   ВременнаяТаблица.Протокол КАК Протокол
	//// ДИТ Поморцева Т.П. Задача 37052 09.02.22. конец
	|ИЗ
	|	ВременнаяТаблица КАК ВременнаяТаблица
	|
	|СГРУППИРОВАТЬ ПО
	|	ВременнаяТаблица.ЗадачаГотовностиКВыставлению
	//// ДИТ Поморцева Т.П. Задача 37052 09.02.22. начало
	//|   ,ВременнаяТаблица.Клиент,
	//|   ВременнаяТаблица.Договор,
	//|   ВременнаяТаблица.Протокол
	//// ДИТ Поморцева Т.П. Задача 37052 09.02.22. конец
	|"; 
	ТЧСвязьУчетныхЕдиниц = СвязьУчетныхЕдиниц.Выгрузить();
	Запрос.УстановитьПараметр("ТЧСвязьУчетныхЕдиниц", ТЧСвязьУчетныхЕдиниц);
	РезультатЗапроса = Запрос.Выполнить();               
	МассивЗадач = Новый Массив;
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.КоличествоОтветственных<=1 Тогда
			Продолжить;
		КонецЕсли;
		МассивЗадач.Добавить(ВыборкаДетальныеЗаписи.ЗадачаГотовностиКВыставлению);
		//// ДИТ Поморцева Т.П. Задача 37052 09.02.22. 
		//МассивЗадач.Добавить(ВыборкаДетальныеЗаписи);
	КонецЦикла;                                                           
	Если МассивЗадач.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	//ОЧИСТКА
	Для Каждого ТекЗадача ИЗ МассивЗадач Цикл         
		ПервыйОтветственныйСоСформированнымиДокументам = Неопределено;
		ПервыйОтветственныйПоЗадаче = Неопределено;
		Отбор = Новый Структура;   
		Отбор.Вставить("ЗадачаГотовностиКВыставлению",ТекЗадача);
		//// ДИТ Поморцева Т.П. Задача 37052 09.02.22. 
		//Отбор.Вставить("ЗадачаГотовностиКВыставлению",ТекЗадача.ЗадачаГотовностиКВыставлению);
		//Отбор.Вставить("Клиент",ТекЗадача.Клиент);
		//Отбор.Вставить("Договор",ТекЗадача.Договор);
		//Отбор.Вставить("Протокол",ТекЗадача.Протокол);
		//// ДИТ Поморцева Т.П. Задача 37052 09.02.22. 
		Отбор.Вставить("ДокументыСформированы",ИСТИНА);
		НайденныеСтрокиПоЗадаче = ТЧСвязьУчетныхЕдиниц.НайтиСтроки(Отбор);
		Для Каждого ТекСтрока Из НайденныеСтрокиПоЗадаче Цикл
			ПервыйОтветственныйСоСформированнымиДокументам = ТекСтрока.ОтветственныйЗаУчет; 
			Прервать;
		КонецЦикла;
		Если ПервыйОтветственныйСоСформированнымиДокументам <> Неопределено Тогда
			УбратьНевыполненныеЗадачиПоДругимОтветственным(ПервыйОтветственныйСоСформированнымиДокументам, ТекЗадача);
			Продолжить;
		КонецЕсли;
		Отбор = Новый Структура;
		Отбор.Вставить("ЗадачаГотовностиКВыставлению",ТекЗадача); 
		//// ДИТ Поморцева Т.П. Задача 37052 09.02.22. 
		//Отбор.Вставить("ЗадачаГотовностиКВыставлению",ТекЗадача.ЗадачаГотовностиКВыставлению);
		//Отбор.Вставить("Клиент",ТекЗадача.Клиент);
		//Отбор.Вставить("Договор",ТекЗадача.Договор);
		//Отбор.Вставить("Протокол",ТекЗадача.Протокол);
		//// ДИТ Поморцева Т.П. Задача 37052 09.02.22.
		Отбор.Вставить("ДокументыСформированы",ЛОЖЬ);
		НайденныеСтрокиПоЗадаче = ТЧСвязьУчетныхЕдиниц.НайтиСтроки(Отбор);
		Для Каждого ТекСтрока Из НайденныеСтрокиПоЗадаче Цикл
			ПервыйОтветственныйПоЗадаче = ТекСтрока.ОтветственныйЗаУчет; 
			Прервать;
		КонецЦикла;
		Если ПервыйОтветственныйПоЗадаче <> Неопределено Тогда
			УбратьНевыполненныеЗадачиПоДругимОтветственным(ПервыйОтветственныйПоЗадаче, ТекЗадача);  
			Продолжить;
		КонецЕсли;
	КонецЦикла;
