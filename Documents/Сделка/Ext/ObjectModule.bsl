// Евросиб Фролов (27.04.2022 Task №50551
Процедура ОтключитьРасходыПоОтмеченнымКТК()
	// Проверим, что по строкам КТК, где установлен признак "Отменить расходы",
	// не были сформированы документы.
	ОтключаемыеКТК = СвязьУчетныхЕдиниц.НайтиСтроки(Новый Структура("ОтключитьРасходы", Истина));
	МассивГУИД = СвязьУчетныхЕдиниц.Выгрузить(Новый Структура("ОтключитьРасходы", Истина), "ГУИД").ВыгрузитьКолонку("ГУИД");
	КТКСРасходами = Документы.Сделка.ПолучитьСтрокиРасходовПоСУЕСПривязаннымиУчДокументами(МассивГУИД, ЭтотОбъект);
	Для Каждого ТекущаяСтрока Из ОтключаемыеКТК Цикл
		Если ТекущаяСтрока.ДокументыСформированы
			Или КТКСРасходами.Найти(ТекущаяСтрока.ГУИД) <> Неопределено Тогда
			ТекущаяСтрока.ОтключитьРасходы = Ложь;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				"Для КТК " + ТекущаяСтрока.Контейнер + " были сформированы закрывающие документы. Расходы по этому КТК не были отключены.",
				ЭтотОбъект,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СвязьУчетныхЕдиниц", ТекущаяСтрока.НомерСтроки, "Контейнер"));
		КонецЕсли;	
	КонецЦикла;
	РаботаСоСделкамиСервер.ОтключитьСтрокиРасходовПоОтмеченнымКТК(ЭтотОбъект);
КонецПроцедуры	

