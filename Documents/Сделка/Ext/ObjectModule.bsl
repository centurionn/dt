Функция ПолучитьУслугуИзКалькуляции(вхКалькуляция)   
	Результат = Справочники.Номенклатура.ПустаяСсылка();   
	Если НЕ ЗначениеЗаполнено(вхКалькуляция) Тогда
		Возврат Результат;
	КонецЕсли;		
		
	Если вхКалькуляция.ММ_КалькуляцияМультимодальнойЦепочки.Количество() > 0 Тогда
		// Евросиб US 86792 TA 87489 Рыбьяков К.А. 02.07.2024 ((
		Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(вхКалькуляция, "ОсновнаяУслуга");
		//Результат = вхКалькуляция.ММ_КалькуляцияМультимодальнойЦепочки[0].ВыставляемаяУслуга;
		// Евросиб Рыбьяков К.А. 02.07.2024 ))	
	ИначеЕсли вхКалькуляция.НФ_ВыбранныеСтавки.Количество() > 0 Тогда
		Результат = Константы.УслугаФрахтаДляКалькуляции.Получить();
	КонецЕсли;	
	Возврат Результат;
КонецФункции    
