Процедура ДобавитьЗадачуВыставленияДокументовПоФрахту()
		
	СтрокиГотовоКВыставлениюФрахт = СвязьУчетныхЕдиниц.Выгрузить(Новый Структура("ГотовоКВыставлениюФрахт", Истина));
	Если СтрокиГотовоКВыставлениюФрахт.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	//ИспользованныеСостояния = СвязьУчетныхЕдиниц.Выгрузить().ВыгрузитьКолонку("ЗадачаГотовностиКВыставлению");
	//Для Каждого ТекущаяСтрока Из Доходы Цикл
	//	Если ЗначениеЗаполнено(ТекущаяСтрока.ЗадачаГотовностиКВыставлению) Тогда
	//		ИспользованныеСостояния.Добавить(ТекущаяСтрока.ЗадачаГотовностиКВыставлению);
	//	КонецЕсли;
	//КонецЦикла; 
	//ДИТ, Беляев СЮ, US 37052, 23-08-2022, начало
	ИспользованныеСостояния = ПолучитьМассивИспользованныхСостоянийУчета();
	//ДИТ, Беляев СЮ, US 37052, 23-08-2022, конец
	
	СтрокиГотовоКВыставлениюФрахт.Свернуть("Клиент, Договор");
	
	// Для каждого договора создадим задачу
	ТекстКомментария = "Фрахт";
	Для Каждого ТекущийДоговор Из СтрокиГотовоКВыставлениюФрахт Цикл
		
		// Т.к. по КТК уже может быть создана задача на выставление документов, то для того, чтобы отличать эти задачи, добавим комментарий.
		СостояниеСозданияКомплектаДокументов = ВыдатьСвободноеСостояниеУчета(ИспользованныеСостояния);
		НайденноеСостояние = Состояния.НайтиСтроки(Новый Структура("Состояние, Комментарий, Клиент, Договор", СостояниеСозданияКомплектаДокументов, ТекстКомментария, ТекущийДоговор.Клиент, ТекущийДоговор.Договор));
		Если НайденноеСостояние.Количество() = 0 Тогда
			Исполнитель = Автор;
			
			ДоговорСтроки = ТекущийДоговор.Договор;
			Если ЗначениеЗаполнено(ДоговорСтроки) Тогда
				// ДИТ US 51951 TA 61497 Евсенкин М.А. Начало: 29.11.2022
				// Было:
				//ОтветственныйЗаУчетПоДоговору = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорСтроки, "ОтветственныйЗаУчет");
				//Стало: 
				СтруктураПараметров = Новый Структура;
				СтруктураПараметров.Вставить("Договор",				ДоговорСтроки);
				СтруктураПараметров.Вставить("ЦФО",					Справочники.ЦентрыФинансовойОтветственности.ОсновнойЦФО);
				СтруктураПараметров.Вставить("ТипОтветственного",	Перечисления.ТипыОтветственных.ОтветственныйЗаУчет);  
				ОтветственныйЗаУчетПоДоговору = Справочники.ДоговорыКонтрагентов.ПолучитьОтветственного(СтруктураПараметров);
				// ДИТ US 51951 TA 61497 Евсенкин М.А. Конец: 29.11.2022
				Если ЗначениеЗаполнено(ОтветственныйЗаУчетПоДоговору)
					И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтветственныйЗаУчетПоДоговору, "Недействителен") = Ложь Тогда
					Исполнитель = ОтветственныйЗаУчетПоДоговору;
				КонецЕсли;
			КонецЕсли;
			
			СтрокаСостояния = Состояния.Добавить();
			СтрокаСостояния.Исполнитель = Исполнитель;
			СтрокаСостояния.Наблюдатель = СтрокаСостояния.Исполнитель;
			СтрокаСостояния.Комментарий = ТекстКомментария;																										  
			СтрокаСостояния.Состояние = СостояниеСозданияКомплектаДокументов;
			СтрокаСостояния.ВидНормативаИсполнения = Перечисления.ВидыНормативовИспользования.ЧасовСМоментаСозданияДокумента;
			СтрокаСостояния.Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
			СтрокаСостояния.Договор = ТекущийДоговор.Договор;
			СтрокаСостояния.Клиент = ТекущийДоговор.Клиент;
			
			ИспользованныеСостояния.Добавить(СостояниеСозданияКомплектаДокументов);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура ЗакрытьЗадачиВыставленияДокументовПоФрахту()

	ТаблицаСвязьУЕ = СвязьУчетныхЕдиниц.Выгрузить(Новый Структура("ГотовоКВыставлениюФрахт", Истина));
	
	Если ТаблицаСвязьУЕ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	Если Состояния.Найти("Фрахт", "Комментарий") = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СделкаСвязьДоходовИРасходов.Доходы КАК Доходы,
	|	СделкаСвязьДоходовИРасходов.СвязьУчетныхЕдиниц КАК СвязьУчетныхЕдиниц
	|ПОМЕСТИТЬ ВТ_СвязьДоходовИРасходов
	|ИЗ
	|	&ТЧСвязьДоходовИРасходов КАК СделкаСвязьДоходовИРасходов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СделкаДоходы.ГУИД КАК ГУИД,
	|	СделкаДоходы.НеВыставлятьКлиенту КАК НеВыставлятьКлиенту,
	|	СделкаДоходы.УчДокумент КАК УчДокумент,
	|	СделкаДоходы.ЗадачаГотовностиКВыставлению КАК ЗадачаГотовностиКВыставлению
	|ПОМЕСТИТЬ ВТ_Доходы
	|ИЗ
	|	&ТЧДоходы КАК СделкаДоходы
	|ГДЕ
	|	СделкаДоходы.ГУИДИсправляемойСтроки = """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СделкаСвязьУчетныхЕдиниц.ГУИД КАК ГУИД,
	|	СделкаСвязьУчетныхЕдиниц.Договор КАК Договор
	|ПОМЕСТИТЬ ВТ_СвязьУчетныхЕдиниц
	|ИЗ
	|	&ТЧСвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СделкаСвязьУчетныхЕдиниц.Договор КАК Договор,
	|	ЕСТЬNULL(СделкаДоходы.УчДокумент.Проведен, ЛОЖЬ) КАК ДокументыСформированы
	|ИЗ
	|	ВТ_СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СвязьДоходовИРасходов КАК СделкаСвязьДоходовИРасходов
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Доходы КАК СделкаДоходы
	|			ПО (СделкаДоходы.ГУИД = СделкаСвязьДоходовИРасходов.Доходы)
	|		ПО СделкаСвязьУчетныхЕдиниц.ГУИД = СделкаСвязьДоходовИРасходов.СвязьУчетныхЕдиниц
	|ГДЕ
	|	СделкаДоходы.НеВыставлятьКлиенту = ЛОЖЬ
	|	И НЕ СделкаДоходы.ГУИД ЕСТЬ NULL
	|	И СделкаДоходы.ЗадачаГотовностиКВыставлению = ЗНАЧЕНИЕ(Справочник.Состояния.ПустаяСсылка)
	|ИТОГИ
	|	МИНИМУМ(ДокументыСформированы)
	|ПО
	|	СделкаСвязьУчетныхЕдиниц.Договор";
	
	УслугаФрахт = ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьЗначениеКонстанты("УслугаФрахтаДляКалькуляции");
	
	Запрос.УстановитьПараметр("ТЧСвязьДоходовИРасходов", 	СвязьДоходовИРасходов.Выгрузить());
	Запрос.УстановитьПараметр("ТЧДоходы", 					Доходы.Выгрузить(Новый Структура("Услуга", УслугаФрахт)));
	Запрос.УстановитьПараметр("ТЧСвязьУчетныхЕдиниц", 		ТаблицаСвязьУЕ);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ДокументыСформированы = Истина Тогда
			
			СтрокиЗадачФрахта = Состояния.НайтиСтроки(Новый Структура("Договор, Комментарий", Выборка.Договор, "Фрахт"));
			Для Каждого ТекСтрока Из СтрокиЗадачФрахта Цикл
				ТекСтрока.Статус = Перечисления.СтатусыЭтапов.Выполнен;
			КонецЦикла;	
		
	    КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
