					ВНайденнойГруппеЗаполненПТУ = ВНайденнойГруппеЗаполненПТУ ИЛИ ЗначениеЗаполнено(Стр.УчДокумент);
				КонецЕсли;
			КонецЦикла;
			Если ВНайденнойГруппеЗаполненПТУ = Истина Тогда
				Для каждого Стр из НайденнаяГруппаСтрокРасходов Цикл
					Если НЕ ЗначениеЗаполнено(Стр.УчДокумент) Тогда
						Стр.УслугаОтключена = Истина;	
						СписокОтключенныхПроводок.Добавить(Стр.ГУИД);
						
						// SIV----------
						
						//ГУИДДоходов = неопределено;
						//Для каждого Стр78664 из СвязьДоходовИРасходов Цикл
						//	Если Стр78664.Расходы = Стр.ГУИД Тогда
						//		ГУИДДоходов = Стр78664.Доходы;
						//		Прервать;
						//	КонецЕсли;
						//КонецЦикла;
						//Если ГУИДДоходов <> неопределено Тогда
						//	Для каждого Стр37464 из Доходы Цикл
						//		Если Стр37464.ГУИД = ГУИДДоходов Тогда
						//			Стр37464.НеВыставлятьКлиенту = Истина;
						//			Прервать;
						//		КонецЕсли;
						//	КонецЦикла;
						//КонецЕсли;
						
