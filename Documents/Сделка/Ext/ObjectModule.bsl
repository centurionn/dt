Процедура ДобавитьЗадачуГотовностьКомплектаПодтверждающихДокументов()
	
	// ДИТ 64186 Давудов М.А. Начало: 07.03.2023
	СостояниеРодитель = Справочники.Состояния.ЗадачиГотовностьКомплектаПодтверждающихДокументов;
	ИспользованныеСостоянияУчета = Новый Массив;
	
	Для Каждого СтрокаСостояния Из Состояния Цикл
		Если СтрокаСостояния.Состояние.Родитель = СостояниеРодитель Тогда
			ИспользованныеСостоянияУчета.Добавить(СтрокаСостояния.Состояние);
		КонецЕсли;
	КонецЦикла;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ПодтверждающиеДокументы", Истина);
	ТЗГотовностиКомплектаДокументов = СвязьУчетныхЕдиниц.Выгрузить(СтруктураОтбора, "Клиент, Договор, Контейнер");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТЗГотовностиКомплектаДокументов", ТЗГотовностиКомплектаДокументов);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ЦФО", ЦФО);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТЗГотовностиКомплектаДокументов.Клиент КАК Клиент,
	|	ТЗГотовностиКомплектаДокументов.Договор КАК Договор,
	|	ТЗГотовностиКомплектаДокументов.Контейнер КАК Контейнер
	|ПОМЕСТИТЬ ВТ_ТекущиеДанные
	|ИЗ
	|	&ТЗГотовностиКомплектаДокументов КАК ТЗГотовностиКомплектаДокументов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СделкаСвязьУчетныхЕдиниц.Клиент КАК Клиент,
	|	СделкаСвязьУчетныхЕдиниц.Договор КАК Договор,
	|	СделкаСвязьУчетныхЕдиниц.Контейнер КАК Контейнер
	|ПОМЕСТИТЬ ВТ_СсылкаДанные
	|ИЗ
	|	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|ГДЕ
	|	СделкаСвязьУчетныхЕдиниц.Ссылка = &Ссылка
	|	И СделкаСвязьУчетныхЕдиниц.ПодтверждающиеДокументы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДоговорыКонтрагентовОтветственные.Ответственный КАК Ответственный,
	|	ВТ_ТекущиеДанные.Клиент КАК Клиент,
	|	ВТ_ТекущиеДанные.Контейнер КАК Контейнер
	|ИЗ
	|	ВТ_ТекущиеДанные КАК ВТ_ТекущиеДанные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов.Ответственные КАК ДоговорыКонтрагентовОтветственные
	|		ПО ВТ_ТекущиеДанные.Договор = ДоговорыКонтрагентовОтветственные.Ссылка
	|			И (ДоговорыКонтрагентовОтветственные.ЦФО = &ЦФО)
	|			И (ДоговорыКонтрагентовОтветственные.ТипОтветственного = ЗНАЧЕНИЕ(Перечисление.ТипыОтветственных.ОтветственныйЗаУчет))
	|ГДЕ
	|	НЕ (ВТ_ТекущиеДанные.Клиент, ВТ_ТекущиеДанные.Договор, ВТ_ТекущиеДанные.Контейнер) В
	|				(ВЫБРАТЬ
	|					ВТ_СсылкаДанные.Клиент КАК Клиент,
	|					ВТ_СсылкаДанные.Договор КАК Договор,
	|					ВТ_СсылкаДанные.Контейнер КАК Контейнер
	|				ИЗ
	|					ВТ_СсылкаДанные КАК ВТ_СсылкаДанные)
	|ИТОГИ ПО
	|	Ответственный,
	|	Клиент";
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ШаблонСообщений = 
		НСтр("ru = 'Готовность подтверждающих документов для %1 по КТК %2'");
	
	ВыборкаОтветственный = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Ответственный");
	
	Пока ВыборкаОтветственный.Следующий() Цикл
		ВыборкаКлиент = ВыборкаОтветственный.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Клиент");
		Пока ВыборкаКлиент.Следующий() Цикл
			Выборка = ВыборкаКлиент.Выбрать();
			
			МассивКТК = Новый Массив;
			
			Пока Выборка.Следующий() Цикл
				МассивКТК.Добавить(Выборка.Контейнер);
			КонецЦикла;
			
			СтрокаСостояния = Состояния.Добавить();
			СтрокаСостояния.Состояние = 
				ВыдатьСвободноеСостояниеУчетаГотовностьКомплектаПодтверждающихДокументов(ИспользованныеСостоянияУчета);
			СтрокаСостояния.Исполнитель = ВыборкаОтветственный.Ответственный;
			СтрокаСостояния.Наблюдатель = СтрокаСостояния.Исполнитель;
			СтрокаСостояния.ВидНормативаИсполнения = Перечисления.ВидыНормативовИспользования.ЧасовСМоментаСозданияДокумента;
			СтрокаСостояния.Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
			СтрокаСостояния.Клиент = ВыборкаКлиент.Клиент;
			//Евросиб - АСуслов 31.03.2023 11:31:43 #67901
			//(
			//независимая задача
			СтрокаСостояния.ПредыдущиеЭтапы = "999";
			//)
			//Евросиб - АСуслов 31.03.2023 11:31:57 #67901
			
			СтрокаСписокКТК = СтрСоединить(МассивКТК, ", ");
			СтрокаСостояния.Комментарий = 
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщений, ВыборкаКлиент.Клиент, СтрокаСписокКТК);
			
			ИспользованныеСостоянияУчета.Добавить(СтрокаСостояния.Состояние);
		КонецЦикла;
	КонецЦикла;
	// ДИТ 64186 Давудов М.А. Конец: 07.03.2023
	
КонецПроцедуры

Функция ВыдатьСвободноеСостояниеУчетаГотовностьКомплектаПодтверждающихДокументов(МассивИспользованных)
	
	// ДИТ 64186 Давудов М.А. Начало: 07.03.2023
	Для Сч = 1 по 40 Цикл
		
		СостУчета = Справочники.Состояния["ГотовностьКомплектаПодтверждающихДокументов"+Сч];
		Если МассивИспользованных.Найти(СостУчета) = Неопределено Тогда
			МассивИспользованных.Добавить(СостУчета);
			Возврат СостУчета;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	// ДИТ 64186 Давудов М.А. Конец: 07.03.2023
	
КонецФункции
