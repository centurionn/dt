Функция ПоДанномуКТКОткрытПланПодхода(КТК, Период)
	
	Результат = Новый Структура("Контейнер,Сток,Контрагент,Назначение,ДатаПриемаВСток,СрокВозврата,ПлановаяДатаПрибытия,Количество",,,,,,,,0);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПланируемыеКДоступностиКТКОстатки.Контейнер КАК Контейнер,
	               |	ПланируемыеКДоступностиКТКОстатки.Сток КАК Сток,
	               |	ПланируемыеКДоступностиКТКОстатки.Контрагент КАК Контрагент,
	               |	ПланируемыеКДоступностиКТКОстатки.Назначение КАК Назначение,
	               |	ПланируемыеКДоступностиКТКОстатки.ДатаПриемаВСток КАК ДатаПриемаВСток,
	               |	ПланируемыеКДоступностиКТКОстатки.СрокВозврата КАК СрокВозврата,
	               |	ПланируемыеКДоступностиКТКОстатки.ПлановаяДатаПрибытия КАК ПлановаяДатаПрибытия,
	               |	ПланируемыеКДоступностиКТКОстатки.КоличествоОстаток КАК Количество
	               |ИЗ
	               |	РегистрНакопления.ПланируемыеКДоступностиКТК.Остатки(&Период, Контейнер = &Контейнер) КАК ПланируемыеКДоступностиКТКОстатки";
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Контейнер", КТК);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
