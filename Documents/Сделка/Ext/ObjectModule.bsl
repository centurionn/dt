Процедура ЗаполнитьУчетныеДокументыВАкцепте()
	
	//Возврат;
	////Выносим в регламентное задание
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СделкаРасходы.УчДокумент КАК УчДокумент
	|ПОМЕСТИТЬ ВТ_СписокПТУ
	|ИЗ
	|	Документ.Сделка.Расходы КАК СделкаРасходы
	|ГДЕ
	|	СделкаРасходы.Ссылка = &Ссылка
	|	И НЕ СделкаРасходы.УчДокумент = ЗНАЧЕНИЕ(Документ.ПоступлениеТоваровУслуг.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СписокПТУ.УчДокумент КАК УчДокумент
	|ИЗ
	|	ВТ_СписокПТУ КАК ВТ_СписокПТУ
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КорректировкаПоступления.Ссылка
	|ИЗ
	|	Документ.КорректировкаПоступления КАК КорректировкаПоступления
	|ГДЕ
	|	КорректировкаПоступления.Проведен
	|	И КорректировкаПоступления.ИсправляемыйДокументПоступления В (ВЫБРАТЬ т.УчДокумент ИЗ ВТ_СписокПТУ КАК т)";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	
	//ВыборкаАкцепт = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаАкцепт = РезультатЗапроса.Выбрать();
	УстановитьПривилегированныйРежим(Истина);
	//ДокументИзменен = Истина;
	СписокПолей = Константы.СписокПолейСравненияАкцепта.Получить();
	Пока ВыборкаАкцепт.Следующий() Цикл
		ОбАкцепт = Документы.Акцепт.НайтиСоздатьАктуальныйАкцепт(ВыборкаАкцепт.УчДокумент, Ложь);
		ПредыдущийАкцепт = Документы.Акцепт.ПолучитьДанныеПоследнегоПроведенногоАкцепта(ВыборкаАкцепт.УчДокумент).АкцептСсылка;                    
		ИзмененийНет = ОбщегоНазначения.КоллекцииИдентичны(ПредыдущийАкцепт.Услуги.выгрузить(), ОбАкцепт.Услуги.выгрузить(),СписокПолей,, Истина);		
		Если ИзмененийНет = Ложь Тогда    
			обАкцепт.ДополнительныеСвойства.Вставить("ЗаписьИзСделки");
			ОбАкцепт.УстановитьКомментарийВерсииИсторииДанных("Запись из сделки (ЗаполнитьУчетныеДокументыВАкцепте)");
			обАкцепт.Записать(РежимЗаписиДокумента.Проведение);
			//ОбщегоНазначения.СообщитьПользователю(СтрШаблон("новый: %1; старый: %2", ОбАкцепт, ПредыдущийАкцепт));
		КонецЕсли; 
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ОтключитьДублиУслугСинонимовПриРазнесенииНаОднуИзУслугАкцепта()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПравилаСопоставленияНоменклатуры.ИсходнаяНоменклатура КАК ИсходнаяНоменклатура,
	               |	ПравилаСопоставленияНоменклатуры.РазрешитьСопоставлятьС КАК РазрешитьСопоставлятьС
