Функция ПроверитьИзменниеСтатусаЗадачиИсполнителя(Ответственный,ЗадачаСопровождения)
	
	ИзменитьСтатус = Истина;
	
	ВсеЗадачиИсполителя = Состояния.НайтиСтроки(Новый Структура("Исполнитель,Состояние", Ответственный,ЗадачаСопровождения));
	УникальныеЗадачиИсполителя = Новый Массив;
	Для Каждого Элемент Из ВсеЗадачиИсполителя Цикл	
		Если УникальныеЗадачиИсполителя.Найти(Элемент.Состояние.Наименование) = Неопределено Тогда
			УникальныеЗадачиИсполителя.Добавить(Элемент.Состояние.Наименование);
		КонецЕсли;
	КонецЦикла;
	
	Если УникальныеЗадачиИсполителя.Количество() > 1 Тогда
		ИзменитьСтатус = Ложь;
	КонецЕсли;
	Возврат ИзменитьСтатус;
КонецФункции
