Функция ПолучитьСписокГУИДовПоЭтомуКТК(КТК)
	
	Результат = Новый Массив;
	Для каждого Стр из ДоходыКТК Цикл
		Если Стр.КТК = КТК Тогда Результат.Добавить(Стр.ГУИД); КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьДоходыНевключенныеВСтавку(Данные, МассивКТК = Неопределено, МассивВагоны = Неопределено, МассивТД = Неопределено)
	нСтрокаДоход = Доходы.Добавить(); 
	//ДИТ, Беляев СЮ, Ticket#0272415, 09-06-2022, начало
	нСтрокаДоход.ДатаПоявленияСтрокиЭкономики = ТекущаяДата();
	//ДИТ, Беляев СЮ, Ticket#0272415, 09-06-2022, конец
	ЗаполнитьЗначенияСвойств(нСтрокаДоход, Данные);
	нСтрокаДоход.Договор = Данные.ДоговорКлиента;
	нСтрокаДоход.ГУИД = Новый УникальныйИдентификатор;
	
	Для каждого ЭлВагон Из МассивВагоны Цикл
		нСтрокаВагон = ДоходыВагоны.Добавить();
		нСтрокаВагон.Вагон = ЭлВагон;
		нСтрокаВагон.ГУИД = нСтрокаДоход.ГУИД;
	КонецЦикла;
	Для каждого ЭлКТК Из МассивКТК Цикл
		нСтрокаКТК = ДоходыКТК.Добавить();
		нСтрокаКТК.КТК = ЭлКТК;
		нСтрокаКТК.ГУИД = нСтрокаДоход.ГУИД;
	КонецЦикла;
	Для каждого ЭлТД Из МассивТД Цикл
		нСтрокаТД = ДоходыТД.Добавить();
		нСтрокаТД.ТД = ЭлТД;
		нСтрокаТД.ГУИД = нСтрокаДоход.ГУИД;
	КонецЦикла;
	нСтрокаДоход.НоменклатурнаяГруппа = РазнесениеЗатратСервер.ПодобратьНоменклатурнуюГруппуПоНаборуПараметров(ТипЗаказа, МассивВагоны[0]);
	Документы.Сделка.СвязатьДоходыРасходыСУЕ(ЭтотОбъект, нСтрокаДоход.ГУИД, , Данные.СтрокаСУЕ, Данные.Услуга);
КонецПроцедуры

Функция ПолучитьСписки(СтрокаПараметры)
	ПараметрПоиска = Новый Структура("Клиент, Договор, РазмерКТК, Груз, Калькуляция");
	ЗаполнитьЗначенияСвойств(ПараметрПоиска, СтрокаПараметры);
	ПараметрПоиска.Договор = СтрокаПараметры.ДоговорКлиента;
	СписокВагонов = "";
	СписокКТК = "";
	СписокТД = "";
	Для каждого СтрокаУЕ Из СвязьУчетныхЕдиниц.НайтиСтроки(ПараметрПоиска) Цикл
		СписокВагонов = СписокВагонов + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаУЕ.Вагон, "Наименование") + ";";
		СписокКТК = СписокКТК + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаУЕ.Контейнер, "Наименование") + ";";
		СписокТД = СписокТД + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаУЕ.ЖДН, "НомерТранспортногоДокумента") + ";";
	КонецЦикла;
	Возврат Новый Структура("СписокВагонов, СписокКТК, СписокТД", СписокВагонов, СписокКТК, СписокТД);
КонецФункции

Функция НайтиСтрокуДоходовДляАвансовогоСчета(Заявка, Сделка)
	
	Результат = "";
	
	ПСЦ = Заявка.ПСЦ;
	Услуга = неопределено;
	
	// логика такая: счет был сделан на основании заявки. Соответственно, я могу найти любой КТК из заявки в ТЧ Доходы при совпадении номенклатуры услуги и ее ГУИД прописать в счет
	МассивИскомыхКТК = Новый Массив;
	МассивИскомыхВагонов = Новый Массив;
	Для каждого Стр из Заявка.СоставУслуги Цикл
		Если ЗначениеЗаполнено(Стр.НомерКТК) Тогда
			МассивИскомыхКТК.Добавить(Стр.НомерКТК);
			Услуга = Стр.Услуга;
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.Вагон) Тогда
			МассивИскомыхВагонов.Добавить(Стр.Вагон);
			Услуга = Стр.Услуга;
		КонецЕсли;
	КонецЦикла;
	
	Если МассивИскомыхКТК.Количество() = 0 И МассивИскомыхВагонов.Количество() = 0 Тогда Возврат Результат; КонецЕсли;
	
	РандомныйВагонДляПоиска = "111111";
	РандомныйКТКДляПоиска = "111111";
	
	Если МассивИскомыхКТК.Количество() > 0 Тогда РандомныйКТКДляПоиска = МассивИскомыхКТК[0]; КонецЕсли;
	Если МассивИскомыхВагонов.Количество() > 0 Тогда РандомныйВагонДляПоиска = МассивИскомыхВагонов[0]; КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СделкаДоходы.ГУИД КАК ГУИД,
	               |	СделкаДоходыВагоны.Вагон КАК Вагон,
	               |	СделкаДоходыКТК.КТК КАК КТК
	               |ИЗ
	               |	Документ.Сделка.Доходы КАК СделкаДоходы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.ДоходыКТК КАК СделкаДоходыКТК
	               |		ПО СделкаДоходы.Ссылка = СделкаДоходыКТК.Ссылка
	               |			И СделкаДоходы.ГУИД = СделкаДоходыКТК.ГУИД
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.ДоходыВагоны КАК СделкаДоходыВагоны
	               |		ПО СделкаДоходы.Ссылка = СделкаДоходыВагоны.Ссылка
	               |			И СделкаДоходы.ГУИД = СделкаДоходыВагоны.ГУИД
	               |ГДЕ
	               |	СделкаДоходы.Ссылка = &Ссылка
	               |	И СделкаДоходы.Услуга = &Услуга
	               |	И СделкаДоходы.ПСЦ = &ПСЦ";
	Запрос.УстановитьПараметр("Ссылка", Сделка);
	Запрос.УстановитьПараметр("Услуга", Услуга);
	Запрос.УстановитьПараметр("ПСЦ", ПСЦ);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		Если Найти(Ответ.Вагон, РандомныйВагонДляПоиска) > 0 ИЛИ Найти(Ответ.КТК, РандомныйКТКДляПоиска) > 0 Тогда
			Результат = Ответ.ГУИД;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;	
	
	Возврат результат;
	
КонецФункции

Функция СформироватьТекстПисьма(ТаблицаРассылки)
	
	ТаблицаДокументов = Новый ТаблицаЗначений;
	ТаблицаДокументов.Колонки.Добавить("Сделка",,"Сделка");
	ТаблицаДокументов.Колонки.Добавить("Калькуляция",,"Калькуляция");
	ТаблицаДокументов.Колонки.Добавить("Номенклатура",,"Номенклатура");
	ТаблицаДокументов.Колонки.Добавить("КТК",,"КТК");
	ТаблицаДокументов.Колонки.Добавить("Вагон",,"Вагон");
	ТаблицаДокументов.Колонки.Добавить("ТД",,"ТД");
	ТаблицаДокументов.Колонки.Добавить("ПТУ",,"ПТУ");
	ТаблицаДокументов.Колонки.Добавить("ГУИД",,"Идентификатор строки расходов");
	ТаблицаДокументов.Колонки.Добавить("ГуидАкцепт",,"Идентификатор строки акцепта");
	Для каждого СтрокаРассылки Из ТаблицаРассылки Цикл
		нСтрокаТД = ТаблицаДокументов.Добавить();
		ЗаполнитьЗначенияСвойств(нСтрокаТД, СтрокаРассылки);
	КонецЦикла; 
	нСтрока = ТаблицаДокументов.Добавить();
	КодСтраницыХТМЛ = "<!DOCTYPE html><BODY>" + Символы.ПС + ПолучитьТаблицуХТМЛ(ТаблицаДокументов) + Символы.ПС + "</BODY></html>";
	Текст = "Реестр отвязанных строк сделки:
	|  "+ КодСтраницыХТМЛ;
	Возврат Текст;
	
КонецФункции

Функция ПолучитьТаблицуХТМЛ(ТабЗначений,СтруктураПараметрыТаблицыХТМЛ = Неопределено) Экспорт
	
	//СтруктураПараметрыТаблицыХТМЛ
	//
	//Общие параметры:
	//СтруктураПараметрыТаблицыХТМЛ.ШиринаТаблицы - общая ширина таблица
	//СтруктураПараметрыТаблицыХТМЛ.ЦветШапки - цвет шапки таблицы пример "eadbaf"
	//СтруктураПараметрыТаблицыХТМЛ.ПунктПорядкуИспользуется - по умолчанию ЛОЖЬ
	//
	//Индивиуальные для каждой колонки:
	//СтруктураПараметрыТаблицыХТМЛ.Заголовок1 - заголовок для первой колонки, цифра на конце обознает номер колонки (не с нуля)
	//СтруктураПараметрыТаблицыХТМЛ.Ширина1 - ширина для первой колонки, цифра на конце обознает номер колонки (не с нуля)
	//СтруктураПараметрыТаблицыХТМЛ.Положение1 - отвечает за положение текста в колонке (по умол. лево), передовать "center" или "right"
	
	//ТабЗначений = Новый ТаблицаЗначений;
	МассивИменКолонок = Новый Массив;
	
	Если ТипЗнч(СтруктураПараметрыТаблицыХТМЛ) <> Тип("Структура") Тогда
		СтруктураПараметрыТаблицыХТМЛ = Новый Структура;
	КонецЕсли;
				
	КоличествоКолонок = ТабЗначений.Колонки.Количество();
	ПунктПорядкуИспользуется = ?(СтруктураПараметрыТаблицыХТМЛ.Свойство("ПунктПорядкуИспользуется"),СтруктураПараметрыТаблицыХТМЛ.ПунктПорядкуИспользуется,ЛОЖЬ);	
	
	Если КоличествоКолонок < 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
			
	ЦветШапки = ?(СтруктураПараметрыТаблицыХТМЛ.Свойство("ЦветШапки")," bgcolor=""#" + СтруктураПараметрыТаблицыХТМЛ.ЦветШапки + """","");
	ШиринаТаблицы = ?(СтруктураПараметрыТаблицыХТМЛ.Свойство("ШиринаТаблицы")," style=""width:" + СтруктураПараметрыТаблицыХТМЛ.ШиринаТаблицы + "px""",""); 
	ТаблицаХТМЛ = "<table border=""1"" cellpadding=""1"" cellspacing=""0"" " + ШиринаТаблицы + ">
				|<tbody>
				|<tr>";
	
	//Первым выводим столбик П/П если он задан в шапку
	Если ПунктПорядкуИспользуется Тогда
		ТаблицаХТМЛ = ТаблицаХТМЛ + "
				|<td" + ЦветШапки + " style=""width:30px"" align=""center"">п/п</td>";	
	КонецЕсли;
	
	//Формируем шапку
	Для Счетчик = 1 по КоличествоКолонок Цикл
		ИмяСвойстваШирина = "Ширина" + Счетчик;
		ШиринаСтолбца = ?(СтруктураПараметрыТаблицыХТМЛ.Свойство(ИмяСвойстваШирина)," style=""width:" + СтруктураПараметрыТаблицыХТМЛ[ИмяСвойстваШирина] + "px""","");
		ИмяКолонки = ТабЗначений.Колонки[Счетчик-1].Имя;
		НаименованиеКолонки = ТабЗначений.Колонки[Счетчик-1].Заголовок;
		ИмяСвойстваЗаголовок = "Заголовок" + Счетчик;
