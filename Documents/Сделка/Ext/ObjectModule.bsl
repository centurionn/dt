Функция ПолучитьПараметрыПоКонтейнеру(Заявка, Контейнер)
	
	Результат = Новый Структура("ДатаМин, ДатаМакс, СтанцияОтправления, СтанцияПрибытия");
	
	Запрос = Новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	МИНИМУМ(ЗаявкаПереченьРейсов.Рейс.ДатаОтправления) КАК РейсДатаОтправления,
	               |	МАКСИМУМ(ЗаявкаПереченьРейсов.Рейс.ДатаПрибытия) КАК РейсДатаПрибытия,
	               |	ЗаявкаПереченьРейсов.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ Т1
	               |ИЗ
	               |	Документ.Заявка.ПереченьРейсов КАК ЗаявкаПереченьРейсов
	               |ГДЕ
	               |	ЗаявкаПереченьРейсов.Ссылка = &Ссылка
	               |	И ТИПЗНАЧЕНИЯ(ЗаявкаПереченьРейсов.Рейс) = ТИП(Справочник.РейсыЖД)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаявкаПереченьРейсов.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Т1.РейсДатаОтправления КАК РейсДатаОтправления,
	               |	Т1.РейсДатаПрибытия КАК РейсДатаПрибытия,
	               |	Т1.Ссылка КАК Ссылка,
	               |	ЗаявкаСоставУслуги.СтанцияОтправления КАК СтанцияОтправления,
	               |	ЗаявкаСоставУслуги.СтанцияНазначения КАК СтанцияНазначения
	               |ИЗ
	               |	Т1 КАК Т1
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
	               |		ПО (Т1.Ссылка = ЗаявкаСоставУслуги.Ссылка
	               |				И ЗаявкаСоставУслуги.НомерКТК = &НомерКТК)";
	Запрос.УстановитьПараметр("Ссылка", Заявка);
	Запрос.УстановитьПараметр("НомерКТК", Контейнер);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат.ДатаМин = Ответ.РейсДатаОтправления;
		Результат.ДатаМакс = Ответ.РейсДатаПрибытия;
		Результат.СтанцияОтправления = Ответ.СтанцияОтправления;
		Результат.СтанцияПрибытия = ОТвет.СтанцияНазначения;
	КонецЕсли;
	
	Возврат Результат;
	
