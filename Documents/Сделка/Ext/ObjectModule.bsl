				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	//Если ЗначениеЗаполнено(ЭтотОбъект.Ссылка) Тогда
	//	НЗ = РегистрыНакопления.РазнесениеЗатрат.СоздатьНаборЗаписей();
	//	НЗ.Отбор.Регистратор.Значение = ЭтотОбъект.Ссылка;
	//	НЗ.Прочитать();
