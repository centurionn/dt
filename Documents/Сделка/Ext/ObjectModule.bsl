//ДИТ, Беляев СЮ, Ticket#0343311, 28-02-2024, начало
Функция ПолучитьОписаниеПоНеакутальнымОтветственным()
	
	СтруктураПроблемПоСоставуПоезда = Документы.Сделка.ОтсутствующиеИНедействительныеОтветственные( ЭтотОбъект );
	МассивКлиентовБезОтветственного = СтруктураПроблемПоСоставуПоезда.МассивКлиентовБезОтветственного;
	МассивОтветственныхНедействительных = СтруктураПроблемПоСоставуПоезда.МассивОтветственныхНедействительных;
	
	НеактуальныеОтветственныеВДоходах = ПроверитьНеактуальныхОтветственныхПоЗадачамВДоходах();
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивОтветственныхНедействительных, НеактуальныеОтветственныеВДоходах, Истина);
	
	Взаимодействия.УдалитьПовторяющиесяЭлементыМассива(МассивОтветственныхНедействительных);
	Взаимодействия.УдалитьПовторяющиесяЭлементыМассива(МассивКлиентовБезОтветственного);
	
	СтрокаРезультат = "";
	
	Если МассивКлиентовБезОтветственного.Количество() > 0 Тогда
		СтрокаРезультат = СтрШаблон("Не заполнен ответственный:%1", СтрСоединить(МассивКлиентовБезОтветственного,","));
	КонецЕсли;		
	Если МассивОтветственныхНедействительных.Количество() > 0 Тогда
		СтрокаРезультат = ?(ЗначениеЗаполнено(СтрокаРезультат), СтрокаРезультат+", ", "") 
									+ СтрШаблон("Ответственный НЕ действителен:%1", СтрСоединить(МассивОтветственныхНедействительных,","));
	КонецЕсли;
	Возврат СтрокаРезультат;
КонецФункции
//ДИТ, Беляев СЮ, Ticket#0343311, 28-02-2024, конец

