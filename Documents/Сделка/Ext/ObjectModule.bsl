		|	ВТСостояния.Исполнитель КАК Исполнитель,
		|	ВТСостояния.Статус КАК Статус
		|ИЗ
		|	ВТЗадачиДоходы КАК ВТЗадачиДоходы
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСостояния КАК ВТСостояния
		|		ПО ВТЗадачиДоходы.ЗадачаГотовностиКВыставлению = ВТСостояния.Состояние
		//|			И (ВТСостояния.Статус <> &СтатусВыполнено) //ДИТ, Беляев СЮ, Ticket#0337314, 09-01-2024, закомментировал
		|ГДЕ
		|	ВТЗадачиДоходы.ЗадачаГотовностиКВыставлению <> ЗНАЧЕНИЕ(Справочник.Состояния.ПустаяСсылка)
		|	И (ВТСостояния.Состояние ЕСТЬ NULL
		//|			ИЛИ ВЫРАЗИТЬ(ВТСостояния.Исполнитель КАК Справочник.Пользователи).Недействителен)";
		//ДИТ, Беляев СЮ, Ticket#0337314, 09-01-2024, начало
		|			ИЛИ (ВЫРАЗИТЬ(ВТСостояния.Исполнитель КАК Справочник.Пользователи).Недействителен И ВТСостояния.Статус <> &СтатусВыполнено))";
		//ДИТ, Беляев СЮ, Ticket#0337314, 09-01-2024, конец
	
	Запрос.УстановитьПараметр("СтатусВыполнено", Перечисления.СтатусыЭтапов.Выполнен);
	Запрос.УстановитьПараметр("Доходы",Доходы.Выгрузить(,"ЗадачаГотовностиКВыставлению"));
	Запрос.УстановитьПараметр("Состояния",Состояния.Выгрузить());

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Исполнитель");
	
