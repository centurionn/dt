Процедура ПроверитьВозможностьОтменыПроведенияСделки(Отказ)
	Отказ = РаботаСоСделкамиСервер.ЕстьПроведенныеРТУКСделке(Ссылка);
	Если Отказ Тогда
		СообщениеОбОшибке = "К сделке есть выставленные РТУ, обратитесь в Бэк-офис.";
	КонецЕсли;
	Если Не Отказ Тогда
		Отказ = РаботаСоСделкамиСервер.ЕстьАктуальныеАкцептыКСделке(Ссылка);         
		СообщениеОбОшибке = "К сделке есть акцептованные расходы, обратитесь в Бэк-офис";
	КонецЕсли;                                                                           
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОбОшибке);
	КонецЕсли;
	
	// Евросиб Фролов (24.03.2022 US №40767, Task №48649
	ПроверитьВозможностьОтменыПроведенияДокумента(Отказ);
	// Евросиб Фролов)
КонецПроцедуры

Функция ПолучитьЗначениеТаблицыПоГУИДу(ИмяТаблицы, ГУИД)
	
	Результат = "";
	
	Для каждого Стр из ЭтотОбъект[ИмяТаблицы] Цикл
		
		Если Стр.ГУИД = ГУИД И ИмяТаблицы = "ДоходыВагоны" Тогда
			Результат = Стр.Вагон;
		ИначеЕсли Стр.ГУИД = ГУИД И ИмяТаблицы = "ДоходыКТК" Тогда
			Результат = Стр.КТК;
		ИначеЕсли Стр.ГУИД = ГУИД И ИмяТаблицы = "ДоходыТД" Тогда
			Результат = Стр.ТД;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

