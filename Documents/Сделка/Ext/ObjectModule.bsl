	Запрос.Текст = ТекстЗапроса;

	Запрос.УстановитьПараметр("СвязьУчетныхЕдиниц", СвязьУчетныхЕдиниц.Выгрузить(Новый Структура("ГУИДСтрокиЗаявки", "")));
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СтрокаСостава = СвязьУчетныхЕдиниц.Найти(Выборка.ГУИД, "ГУИД");
		Если СтрокаСостава <> Неопределено Тогда
			СтрокаСостава.ГУИДСтрокиЗаявки = Выборка.ГУИДСтрокиЗаявки;
		КонецЕсли;	
		
	КонецЦикла;
	
