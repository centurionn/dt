	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Сделка.СвязьУчетныхЕдиниц", "&СвязьУчетныхЕдиниц");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Сделка.НастройкиСтрокСоставаПоезда", "&НастройкиСтрокСоставаПоезда");
	Запрос.УстановитьПараметр("НастройкиСтрокСоставаПоезда", СделкаОбъект.НастройкиСтрокСоставаПоезда.Выгрузить());
