	Запрос.УстановитьПараметр("СвязьУчетныхЕдиниц", СделкаОбъект.СвязьУчетныхЕдиниц.Выгрузить());
	Запрос.УстановитьПараметр("ВидПеревозки", Справочники.ВидыПеревозок.ИмпортМоре);
	Запрос.УстановитьПараметр("УсловиеПеревозкиОтправления", Перечисления.УсловияПеревозкиКТК.CY);
