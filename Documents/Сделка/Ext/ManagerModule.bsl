
Функция Печать_ОтправкаОперативныйПриказ(ТекСсылка) Экспорт

	Рез = Новый ТабличныйДокумент;
	
	Макет = Документы.Сделка.ПолучитьМакет("Макет_ОтправкаОперативныйПриказ");
	ОблШапкаТаб = Макет.ПолучитьОбласть("ШапкаТаблицы");
	
	Рез.Вывести(ОблШапкаТаб);
				   
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СделкаСвязьУчетныхЕдиниц.Ссылка КАК Ссылка,
	               |	СделкаСвязьУчетныхЕдиниц.НомерСтроки КАК НПП,
	               |	СделкаСвязьУчетныхЕдиниц.Контейнер.Наименование КАК Контейнер,
	               |	СделкаСвязьУчетныхЕдиниц.ПортНазначения.КодПорта КАК КодПортаНазн,
	               |	СделкаСвязьУчетныхЕдиниц.Контейнер.ТипТЕ.КодISO КАК ISOкод,
	               |	СделкаСвязьУчетныхЕдиниц.НомерЖДН КАК Накладная,
	               |	"""" КАК СобственникКТК,
	               |	СделкаСвязьУчетныхЕдиниц.Вагон КАК Вагон,
	               |	СделкаСвязьУчетныхЕдиниц.Клиент КАК Клиент,
	               |	СделкаСвязьУчетныхЕдиниц.Договор КАК Договор,
	               |	СделкаСвязьУчетныхЕдиниц.УсловияПеревозки КАК УсловияПеревозки,
	               |	СделкаСвязьУчетныхЕдиниц.ВозвратныйКлиент КАК ВозвратныйКлиент,
	               |	СделкаСвязьУчетныхЕдиниц.УсловияПеревозкиНазначение КАК УсловияПеревозкиНазначение,
	               |	СделкаСвязьУчетныхЕдиниц.Груз КАК Груз,
	               |	СделкаСвязьУчетныхЕдиниц.Калькуляция КАК Калькуляция,
	               |	СделкаСвязьУчетныхЕдиниц.РазмерКТК КАК РазмерКТК,
	               |	СделкаСвязьУчетныхЕдиниц.НеАктивна КАК НеАктивна,
	               |	СделкаСвязьУчетныхЕдиниц.МорскойРейс КАК МорскойРейс,
	               |	СделкаСвязьУчетныхЕдиниц.Коносамент КАК Коносамент,
	               |	СделкаСвязьУчетныхЕдиниц.ЖДН КАК ЖДН,
	               |	СделкаСвязьУчетныхЕдиниц.НомерВагоннойЖДН КАК НомерВагоннойЖДН,
	               |	СделкаСвязьУчетныхЕдиниц.Заявка КАК Заявка,
	               |	СделкаСвязьУчетныхЕдиниц.НомерПорожнейЖДНКТК КАК НомерПорожнейЖДНКТК,
	               |	СделкаСвязьУчетныхЕдиниц.УчастокПеревозки КАК УчастокПеревозки,
	               |	СделкаСвязьУчетныхЕдиниц.НомерПорожнейВагоннойЖДН КАК НомерПорожнейВагоннойЖДН,
	               |	СделкаСвязьУчетныхЕдиниц.ДатаНачалаПериодаПовагонки КАК ДатаНачалаПериодаПовагонки,
	               |	СделкаСвязьУчетныхЕдиниц.ДатаОкончанияПериодаПовагонки КАК ДатаОкончанияПериодаПовагонки,
	               |	СделкаСвязьУчетныхЕдиниц.ДатаОтправки КАК ДатаОтправки,
	               |	СделкаСвязьУчетныхЕдиниц.ВесГрузаНетто КАК ВесГрузаНетто,
	               |	СделкаСвязьУчетныхЕдиниц.ГотовоКВыставлению КАК ГотовоКВыставлению,
	               |	СделкаСвязьУчетныхЕдиниц.ПравилоГотовностиКВыставлению КАК ПравилоГотовностиКВыставлению,
	               |	СделкаСвязьУчетныхЕдиниц.ЗадачаГотовностиКВыставлению КАК ЗадачаГотовностиКВыставлению,
	               |	СделкаСвязьУчетныхЕдиниц.ДокументыСформированы КАК ДокументыСформированы,
	               |	СделкаСвязьУчетныхЕдиниц.Груженый КАК Груженый,
	               |	СделкаСвязьУчетныхЕдиниц.ПортОтправления КАК ПортОтправления,
	               // ДИТ 89973 Давудов М.А. Начало: 21.08.2024
	               //ок(
	               //|	СделкаСвязьУчетныхЕдиниц.СобственностьПеревозимогоКТК КАК СобственностьПеревозимогоКТК,
	               //ок)
	               |	СделкаСвязьУчетныхЕдиниц.УдалитьСобственностьПеревозимогоКТК КАК УдалитьСобственностьПеревозимогоКТК,
	               |	СделкаСвязьУчетныхЕдиниц.ПринадлежностьТЕ КАК ПринадлежностьТЕ,
	               // ДИТ 89973 Давудов М.А. Конец: 21.08.2024
	               |	СделкаСвязьУчетныхЕдиниц.ВремяПрибытияНаТерминал КАК ВремяПрибытияНаТерминал,
	               |	СделкаСвязьУчетныхЕдиниц.Контейнер КАК КонтейнерСсылка,
	               |	СделкаСвязьУчетныхЕдиниц.ЖДН.НакладнаяЭТРАН КАК НакладнаяЭТРАН,
				   // Евросиб Фролов (26.12.2021 TASK №44663
                   |	СделкаСвязьУчетныхЕдиниц.ГУИДСтрокиЗаявки КАК ГУИДСтрокиЗаявки
				   // Евросиб Фролов)
	               |ПОМЕСТИТЬ ТЧСделки
	               |ИЗ
	               |	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	               |ГДЕ
	               |	СделкаСвязьУчетныхЕдиниц.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПаспортаВагоновСрезПоследних.Вагон КАК Вагон,
	               |	ПаспортаВагоновСрезПоследних.Собственник КАК Собственник,
	               |	ПаспортаВагоновСрезПоследних.Арендатор КАК Арендатор,
	               |	ПаспортаВагоновСрезПоследних.ВАренде КАК ВАренде
	               |ПОМЕСТИТЬ ПаспортаВагонов
	               |ИЗ
	               |	РегистрСведений.ПаспортаВагонов.СрезПоследних КАК ПаспортаВагоновСрезПоследних
	               |ГДЕ
	               |	ПаспортаВагоновСрезПоследних.Вагон В
	               |			(ВЫБРАТЬ
	               |				ТЧСделки.Вагон КАК Вагон
	               |			ИЗ
	               |				ТЧСделки КАК ТЧСделки
	               |			СГРУППИРОВАТЬ ПО
	               |				ТЧСделки.Вагон)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТЧСделки.Ссылка КАК Ссылка,
	               |	ТЧСделки.НПП КАК НПП,
	               |	ТЧСделки.Контейнер КАК Контейнер,
	               |	ТЧСделки.КодПортаНазн КАК КодПортаНазн,
	               |	ТЧСделки.ISOкод КАК ISOкод,
	               |	ТЧСделки.Накладная КАК Накладная,
	               |	ПаспортаВагонов.Собственник КАК СобственникВагона,
	               |	ТЧСделки.Вагон КАК Вагон,
	               |	ПОДСТРОКА(ТЧСделки.Вагон.Наименование, 1, 3) + ""-"" + ПОДСТРОКА(ТЧСделки.Вагон.Наименование, 4, 150) КАК Платформа,
	               |	ТЧСделки.Груз.Наименование КАК Груз,
	               |	ЗаявкаСоставУслуги.КоличествоМест КАК Мест,
	               |	ТЧСделки.ВесГрузаНетто КАК Нетто,
	               |	ЗаявкаСоставУслуги.Пломбы КАК Пломбы,
	               |	"""" КАК Стаффировка,
	               |	"""" КАК ГТД,
	               |	"""" КАК Экспедитор,
	               |	ТЧСделки.Клиент КАК Клиент,
	               |	ТЧСделки.Договор КАК Договор,
	               |	ТЧСделки.УсловияПеревозки КАК УсловияПеревозки,
	               |	ТЧСделки.ВозвратныйКлиент КАК ВозвратныйКлиент,
	               |	ТЧСделки.УсловияПеревозкиНазначение КАК УсловияПеревозкиНазначение,
	               |	ТЧСделки.Калькуляция КАК Калькуляция,
	               |	ТЧСделки.РазмерКТК КАК РазмерКТК,
	               |	ТЧСделки.НеАктивна КАК НеАктивна,
	               |	ТЧСделки.МорскойРейс КАК МорскойРейс,
	               |	ТЧСделки.Коносамент КАК Коносамент,
	               |	ТЧСделки.ЖДН КАК ЖДН,
	               |	ТЧСделки.НомерВагоннойЖДН КАК НомерВагоннойЖДН,
	               |	ТЧСделки.Заявка КАК Заявка,
	               |	ТЧСделки.НомерПорожнейЖДНКТК КАК НомерПорожнейЖДНКТК,
	               |	ТЧСделки.УчастокПеревозки КАК УчастокПеревозки,
	               |	ТЧСделки.НомерПорожнейВагоннойЖДН КАК НомерПорожнейВагоннойЖДН,
	               |	ТЧСделки.ДатаНачалаПериодаПовагонки КАК ДатаНачалаПериодаПовагонки,
	               |	ТЧСделки.ДатаОкончанияПериодаПовагонки КАК ДатаОкончанияПериодаПовагонки,
	               |	ТЧСделки.ДатаОтправки КАК ДатаОтправки,
	               |	ТЧСделки.ГотовоКВыставлению КАК ГотовоКВыставлению,
	               |	ТЧСделки.ПравилоГотовностиКВыставлению КАК ПравилоГотовностиКВыставлению,
	               |	ТЧСделки.ЗадачаГотовностиКВыставлению КАК ЗадачаГотовностиКВыставлению,
	               |	ТЧСделки.ДокументыСформированы КАК ДокументыСформированы,
	               |	ТЧСделки.Груженый КАК Груженый,
	               |	ТЧСделки.ПортОтправления КАК ПортОтправления,
	               // ДИТ 89973 Давудов М.А. Начало: 21.08.2024
	               //ок(
	               //|	ТЧСделки.СобственностьПеревозимогоКТК КАК СобственникКТК,
	               //ок)
	               |	ТЧСделки.УдалитьСобственностьПеревозимогоКТК КАК УдалитьСобственникКТК,
	               |	ТЧСделки.ПринадлежностьТЕ КАК ПринадлежностьТЕ,
	               // ДИТ 89973 Давудов М.А. Конец: 21.08.2024
	               |	ТЧСделки.ВремяПрибытияНаТерминал КАК ВремяПрибытияНаТерминал,
	               |	ТЧСделки.ЖДН.СтанцияОтправления КАК ЖДНСтанцияОтправления,
	               |	ТЧСделки.ЖДН.СтанцияОтправления.КодЖДСтанции + "" "" + ТЧСделки.ЖДН.СтанцияОтправления.Наименование КАК СтОтправления,
	               |	ТЧСделки.ЖДН.СтанцияНазначения КАК ЖДНСтанцияНазначения,
	               |	ТЧСделки.ЖДН.СтанцияНазначения.КодЖДСтанции + "" "" + ТЧСделки.ЖДН.СтанцияНазначения.Наименование КАК СтНазначения,
	               |	ТЧСделки.ЖДН.НакладнаяЭТРАН.Грузоотправитель КАК Отправитель,
	               |	ТЧСделки.ЖДН.НакладнаяЭТРАН.Грузополучатель КАК Получатель,
	               |	ТЧСделки.ЖДН.НакладнаяЭТРАН.ГрузоотправительАдрес КАК АдресОтправителя,
	               |	ТЧСделки.ЖДН.НакладнаяЭТРАН.ГрузополучательАдрес КАК АдресПолучателя,
	               |	ТЧСделки.ЖДН.НакладнаяЭТРАН КАК ЖДННакладнаяЭТРАН
	               |ИЗ
	               |	ТЧСделки КАК ТЧСделки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПаспортаВагонов КАК ПаспортаВагонов
	               |		ПО ТЧСделки.Вагон = ПаспортаВагонов.Вагон
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
	               |		ПО ТЧСделки.Заявка = ЗаявкаСоставУслуги.Ссылка
				   // Евросиб Фролов (26.12.2021 TASK №44663
				   // Сделал связь только по ГУИДу
				   //|			И ТЧСделки.КонтейнерСсылка = ЗаявкаСоставУслуги.НомерКТК
				   //|			И (ЗаявкаСоставУслуги.НомерКТК <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка))				  
                   |			И ТЧСделки.ГУИДСтрокиЗаявки = ЗаявкаСоставУслуги.ГУИДСтроки
				   // Евросиб Фролов)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НПП
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	э_НакладнаяГрузы.*
	               |ИЗ
	               |	Документ.э_Накладная.Грузы КАК э_НакладнаяГрузы
	               |ГДЕ
	               |	э_НакладнаяГрузы.Ссылка В
	               |			(ВЫБРАТЬ
	               |				ТЧСделки.НакладнаяЭТРАН КАК НакладнаяЭТРАН
	               |			ИЗ
	               |				ТЧСделки КАК ТЧСделки
	               |			СГРУППИРОВАТЬ ПО
	               |				ТЧСделки.НакладнаяЭТРАН)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	э_НакладнаяГрузыЖД.*
	               |ИЗ
	               |	Документ.э_Накладная.ГрузыЖД КАК э_НакладнаяГрузыЖД
	               |ГДЕ
	               |	э_НакладнаяГрузыЖД.Ссылка В
	               |			(ВЫБРАТЬ
	               |				ТЧСделки.НакладнаяЭТРАН КАК НакладнаяЭТРАН
	               |			ИЗ
	               |				ТЧСделки КАК ТЧСделки
	               |			СГРУППИРОВАТЬ ПО
	               |				ТЧСделки.НакладнаяЭТРАН)";
	
	Запрос.УстановитьПараметр("Ссылка", ТекСсылка);
	
	Резы = Запрос.ВыполнитьПакет();
	
	ТЗРез = Резы[2].Выгрузить();
	ТЗГрузы = Резы[3].Выгрузить();
	ТЗГрузыЖД = Резы[4].Выгрузить();
	
	Для каждого СтрТЗ Из ТЗРез Цикл
	
		ОблСтрокаТаб = Макет.ПолучитьОбласть("СтрокаТаблицы");
		ЗаполнитьЗначенияСвойств(ОблСтрокаТаб.Параметры, СтрТЗ);
		
		Если Не ЗначениеЗаполнено(СтрТЗ.ГТД) Тогда
		
			А = 1;
			
			ИскМас1 = ТЗГрузыЖД.НайтиСтроки(Новый Структура("Ссылка", СтрТЗ.ЖДННакладнаяЭТРАН) ) ;
			ТД = "";
			Если ИскМас1.Количество() > 0 Тогда
			
				Для каждого Стр_ТЗГрузыЖД Из ИскМас1 Цикл
					
					Если СокрЛП(Стр_ТЗГрузыЖД.НомерГТД) <> "" Тогда
					
						ТД = ТД + ?(ТД="", "", ", ") + Стр_ТЗГрузыЖД.НомерГТД;
					
					КонецЕсли; 
					
				КонецЦикла; 
			
			КонецЕсли; 
			
			ИскМас2 = ТЗГрузы.НайтиСтроки(Новый Структура("Ссылка", СтрТЗ.ЖДННакладнаяЭТРАН) );
			Если ИскМас2.Количество() > 0 Тогда
			
				Для каждого Стр_ТЗГрузы Из ИскМас2 Цикл
					
					Если СокрЛП(Стр_ТЗГрузы.НомерГТД) <> "" Тогда
					
						ТД = ТД + ?(ТД="", "", ", ") + Стр_ТЗГрузы.НомерГТД;
					
					КонецЕсли; 
					
				КонецЦикла; 
			
			КонецЕсли;
			
			ОблСтрокаТаб.Параметры.ГТД = ТД; 
			
		КонецЕсли; 
		
		Рез.Вывести(ОблСтрокаТаб);
	
	КонецЦикла;
	
	Возврат Рез;
	
КонецФункции // Печать_ОтправкаОперативныйПриказ(ТекОбъект) Экспорт
 
Функция ПолучитьВладельцевУказанныхВагонов(СписокВагонов)
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПаспортаВагоновСрезПоследних.Вагон КАК Вагон,
	               |	ПаспортаВагоновСрезПоследних.Собственник КАК Собственник,
	               |	ПаспортаВагоновСрезПоследних.Арендатор КАК Арендатор,
	               |	ПаспортаВагоновСрезПоследних.ВАренде КАК ВАренде
	               |ИЗ
	               |	РегистрСведений.ПаспортаВагонов.СрезПоследних КАК ПаспортаВагоновСрезПоследних
	               |ГДЕ
	               |	ПаспортаВагоновСрезПоследних.Вагон В(&Вагоны)";
	Запрос.УстановитьПараметр("Вагоны", СписокВагонов);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		Результат.Вставить(Ответ.Вагон, Новый Структура("ВладелецВагона, АрендаторВагона, ВАренде", Ответ.Собственник, Ответ.Арендатор, Ответ.ВАренде));
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Печать_ОперативныйПриказ(ТекСсылка) Экспорт

	Рез = Новый ТабличныйДокумент;
	
	Макет = Документы.Сделка.ПолучитьМакет("Макет_ОперативныйПриказ2");
	ОблШапкаТаб = Макет.ПолучитьОбласть("ШапкаТаблицы");
	
	Рез.Вывести(ОблШапкаТаб);
				   
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СделкаСвязьУчетныхЕдиниц.Ссылка КАК Ссылка,
	               |	СделкаСвязьУчетныхЕдиниц.НомерСтроки КАК НПП,
	               |	СделкаСвязьУчетныхЕдиниц.Контейнер.Наименование КАК Контейнер,
	               |	СделкаСвязьУчетныхЕдиниц.ПортНазначения.КодПорта КАК КодПортаНазн,
	               |	СделкаСвязьУчетныхЕдиниц.Контейнер.ТипТЕ КАК ТипКТК,
	               |	СделкаСвязьУчетныхЕдиниц.НомерЖДН КАК Накладная,
	               |	"""" КАК СобственникКТК,
	               |	СделкаСвязьУчетныхЕдиниц.Вагон КАК Вагон,
	               |	СделкаСвязьУчетныхЕдиниц.Клиент КАК Клиент,
	               |	СделкаСвязьУчетныхЕдиниц.Договор КАК Договор,
	               |	СделкаСвязьУчетныхЕдиниц.УсловияПеревозки КАК УсловияПеревозки,
	               |	СделкаСвязьУчетныхЕдиниц.ВозвратныйКлиент КАК ВозвратныйКлиент,
