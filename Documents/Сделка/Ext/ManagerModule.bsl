		Возврат Новый Массив();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Доходы.Клиент КАК Клиент,
	               |	Доходы.Договор КАК Договор,
	               |	Доходы.СтавкаНДС КАК СтавкаНДС,
	               |	Доходы.НДСВключенВСтоимость КАК НДСВключенВСтоимость,
	               |	Доходы.СтавкаНДСВознаграждения КАК СтавкаНДСВознаграждения,
	               |	Доходы.ВознаграждениеВключаетНДС КАК ВознаграждениеВключаетНДС,
	               |	Доходы.ПериодВО КАК ПериодВО,
	               |	Доходы.Перевыставляемая КАК Перевыставляемая,
	               |	Доходы.УслугаВнеСтавки КАК УслугаВнеСтавки,
	               |	Доходы.ДокументФФД КАК ДокументФФД,
	               |	Доходы.ГУИД КАК ГУИД
	               |ПОМЕСТИТЬ ВТ_Доходы
	               |ИЗ
	               |	&Доходы КАК Доходы
	               |ГДЕ
	               |	Доходы.ГУИД В(&МассивГУИДСтрокДляОбработки)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Расходы.ГУИД КАК ГУИД,
	               |	Расходы.УчДокумент КАК УчДокумент
	               |ПОМЕСТИТЬ ВТ_Расходы
	               |ИЗ
	               |	&Расходы КАК Расходы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СвязьДоходовИРасходов.Доходы КАК Доходы,
	               |	СвязьДоходовИРасходов.Расходы КАК Расходы
	               |ПОМЕСТИТЬ ВТ_СвязьДоходовИРасходов
	               |ИЗ
	               |	&СвязьДоходовИРасходов КАК СвязьДоходовИРасходов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
