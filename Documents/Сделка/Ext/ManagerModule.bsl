Процедура ЗаполнитьДокументыФФДвСоставеПоезда(Объект, СтруктураПоиска)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СделкаСвязьУчетныхЕдиниц.ГУИД КАК ГУИД,
	|	СделкаСвязьУчетныхЕдиниц.Клиент КАК Клиент,
	|	СделкаСвязьУчетныхЕдиниц.Калькуляция КАК Калькуляция,
	|	СделкаСвязьУчетныхЕдиниц.СчетЖД КАК СчетЖД
	|ПОМЕСТИТЬ ВТ_СвязьУчетныхЕдиниц
	|ИЗ
	|	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СвязьУчетныхЕдиниц.ГУИД КАК ГУИД,
	|	ЕСТЬNULL(ФФД_СчетЖД.Документ, ФФД_Правило.Документ) КАК ДокументФФД
	|ИЗ
	|	ВТ_СвязьУчетныхЕдиниц КАК ВТ_СвязьУчетныхЕдиниц
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФормированиеФинДокументов КАК ФормированиеФинДокументов
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ФормированиеФинДокументов КАК ФФД_Правило
	|			ПО ФормированиеФинДокументов.Ссылка = ФФД_Правило.Документ
	|		ПО ВТ_СвязьУчетныхЕдиниц.Клиент = ФормированиеФинДокументов.Контрагент
	|			И (ВЫБОР
	|				КОГДА &ПовагонныеОтправки
	|					ТОГДА ФормированиеФинДокументов.ПравилоДляПовагонныхОтправок
	|				ИНАЧЕ ФормированиеФинДокументов.ВидПеревозки = ВТ_СвязьУчетныхЕдиниц.Калькуляция.ПС_ВидПеревозки
	|			КОНЕЦ)
	|			И (ФормированиеФинДокументов.ПометкаУдаления = ЛОЖЬ)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФормированиеФинДокументов КАК ФФД_СчетЖД
	|		ПО ВТ_СвязьУчетныхЕдиниц.СчетЖД = ФФД_СчетЖД.Документ";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Сделка.СвязьУчетныхЕдиниц", "&СвязьУчетныхЕдиниц");
	Запрос.УстановитьПараметр("СвязьУчетныхЕдиниц", Объект.СвязьУчетныхЕдиниц.Выгрузить(СтруктураПоиска,"ГУИД,Клиент,Калькуляция,СчетЖД"));
	Запрос.УстановитьПараметр("ПовагонныеОтправки", Объект.ПовагонныеОтправки);
	ТЗДокументыФФД = Запрос.Выполнить().Выгрузить();

	СтрокиТЧСвязьУчетныхЕдиниц = Объект.СвязьУчетныхЕдиниц.НайтиСтроки(СтруктураПоиска);
	Для каждого СтрокаДляУстановкиПравилФормирования Из СтрокиТЧСвязьУчетныхЕдиниц Цикл
		ДокументФФД = ТЗДокументыФФД.Найти(СтрокаДляУстановкиПравилФормирования.ГУИД,"ГУИД").ДокументФФД;	
		СтрокаДляУстановкиПравилФормирования.ДокументФФД = ДокументФФД;
	КонецЦикла;
КонецПроцедуры
