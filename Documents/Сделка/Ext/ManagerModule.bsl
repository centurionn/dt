	               |	МАКСИМУМ(МаксимальныйИдентификаторГруппировки)
	               |ПО
	               |	НомерГруппы";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.Сделка.Доходы", "&Доходы");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.Сделка.Расходы", "&Расходы");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.Сделка.СвязьДоходовИРасходов", "&СвязьДоходовИРасходов");
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Доходы", СделкаОбъект.Доходы.Выгрузить(,"Клиент, Договор, СтавкаНДС, НДСВключенВСтоимость, СтавкаНДСВознаграждения, ВознаграждениеВключаетНДС, ПериодВО, Перевыставляемая, УслугаВнеСтавки, ДокументФФД, ГУИД, ДоплатныеКТК, УчДокумент, ИдентификаторГруппировки"));
	Запрос.УстановитьПараметр("Расходы", СделкаОбъект.Расходы.Выгрузить(,"ГУИД, УчДокумент"));
	Запрос.УстановитьПараметр("СвязьДоходовИРасходов", СделкаОбъект.СвязьДоходовИРасходов.Выгрузить(,"Доходы, Расходы"));
	
	РезультатЗапросаПакет = Запрос.ВыполнитьПакет();
	

	МаксимальныйИдентификаторГруппировки = 0;
	ВыборкаМаксимальныйИдентификаторГруппировки = РезультатЗапросаПакет[РезультатЗапросаПакет.Количество()-2].Выбрать();
	Пока ВыборкаМаксимальныйИдентификаторГруппировки.Следующий() Цикл
		//Евросиб(ДИТ), Беляев СЮ, Ticket#0366702, 16-09-2024, начало
		Если ВыборкаМаксимальныйИдентификаторГруппировки.ИдентификаторГруппировки = NULL Тогда
			Прервать;
		КонецЕсли;
		//Евросиб(ДИТ), Беляев СЮ, Ticket#0366702, 16-09-2024, конец
		МаксимальныйИдентификаторГруппировки = ВыборкаМаксимальныйИдентификаторГруппировки.ИдентификаторГруппировки;
	КонецЦикла;
	НовыйИдентификаторГруппировки = МаксимальныйИдентификаторГруппировки + 1;
	
	ФлагИзменений = Ложь;
	
	ВыборкаНомерГруппы = РезультатЗапросаПакет[РезультатЗапросаПакет.Количество()-1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаНомерГруппы.Следующий() Цикл
		
		ИдентификаторГруппировки = ВыборкаНомерГруппы.МаксимальныйИдентификаторГруппировки;
		Если ИдентификаторГруппировки = 0 Тогда
			ИдентификаторГруппировки = НовыйИдентификаторГруппировки;
			НовыйИдентификаторГруппировки = НовыйИдентификаторГруппировки + 1;
		КонецЕсли;
		
		ВыборкаДетальныеЗаписи = ВыборкаНомерГруппы.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Отбор = Новый Структура("ГУИД", ВыборкаДетальныеЗаписи.ГУИД);
			ТекСтрока = СделкаОбъект.Доходы.НайтиСтроки(Отбор)[0];
			ТекСтрока.ИдентификаторГруппировки = ИдентификаторГруппировки;
			ФлагИзменений = Истина;
		КонецЦикла;
		
	КонецЦикла;
	
	Если ФлагИзменений Тогда
		СделкаОбъект.Доходы.Сортировать("ИдентификаторГруппировки, Клиент, Договор");
	КонецЕсли;
	
КонецПроцедуры 
//Евросиб(ДИТ), Беляев СЮ, US 88163/TA 90886, 10-09-2024, конец

// Евросиб US 88683 TA 108959 Рыбьяков К.А. 06.06.2025 ((
Процедура УдалитьДоходнуюСтрокуСвязаннуюСДоплатнымиДанными(СделкаОбъект, Контейнер) Экспорт
	
	//Перед удалением заполним рту, чтобы не удалить строчку, по которой рту создана, но её нет в сделке
	Документы.Сделка.ЗаполнитьУчетныеДокументыВДоходах(СделкаОбъект);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СделкаСвязьУчетныхЕдиниц.Доплата_Клиент КАК Доплата_Клиент,
	|	СделкаСвязьУчетныхЕдиниц.Доплата_Договор КАК Доплата_Договор,
	|	СделкаСвязьУчетныхЕдиниц.Доплата_Калькуляция КАК Доплата_Калькуляция,
	|	СделкаСвязьУчетныхЕдиниц.ГУИД КАК ГУИД
	|ПОМЕСТИТЬ ВТ_СвязьУчетныхЕдиниц
	|ИЗ
	|	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|ГДЕ
	|	СделкаСвязьУчетныхЕдиниц.Доплата_РелизСобственника <> ЗНАЧЕНИЕ(Документ.РелизСобственника.ПустаяСсылка)
	|	И СделкаСвязьУчетныхЕдиниц.Контейнер = &Контейнер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СделкаДоходы.УчДокумент КАК УчДокумент,
	|	СделкаДоходы.Клиент КАК Клиент,
	|	СделкаДоходы.Договор КАК Договор,
	|	СделкаДоходы.Калькуляция КАК Калькуляция,
	|	СделкаДоходы.ГУИД КАК ГУИД
	|ПОМЕСТИТЬ ВТ_Доходы
	|ИЗ
	|	Документ.Сделка.Доходы КАК СделкаДоходы
	|ГДЕ
	|	СделкаДоходы.ДоплатныеКТК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СделкаСвязьДоходовИРасходов.Доходы КАК Доходы,
	|	СделкаСвязьДоходовИРасходов.СвязьУчетныхЕдиниц КАК СвязьУчетныхЕдиниц
	|ПОМЕСТИТЬ ВТ_СвязьДоходовИРасходов
	|ИЗ
	|	Документ.Сделка.СвязьДоходовИРасходов КАК СделкаСвязьДоходовИРасходов
	|ГДЕ
	|	СделкаСвязьДоходовИРасходов.Доходы <> """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Доходы.ГУИД КАК ГУИД
	|ИЗ
	|	ВТ_СвязьУчетныхЕдиниц КАК ВТ_СвязьУчетныхЕдиниц
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СвязьДоходовИРасходов КАК ВТ_СвязьДоходовИРасходов
	|		ПО ВТ_СвязьУчетныхЕдиниц.ГУИД = ВТ_СвязьДоходовИРасходов.СвязьУчетныхЕдиниц
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Доходы КАК ВТ_Доходы
	|		ПО (ВТ_СвязьДоходовИРасходов.Доходы = ВТ_Доходы.ГУИД)
	|			И ВТ_СвязьУчетныхЕдиниц.Доплата_Клиент = ВТ_Доходы.Клиент
	|			И ВТ_СвязьУчетныхЕдиниц.Доплата_Договор = ВТ_Доходы.Договор
	|			И ВТ_СвязьУчетныхЕдиниц.Доплата_Калькуляция = ВТ_Доходы.Калькуляция
	|ГДЕ
	|	(ВТ_Доходы.УчДокумент = НЕОПРЕДЕЛЕНО
	|				ИЛИ ВТ_Доходы.УчДокумент.Ссылка ЕСТЬ NULL)";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Сделка.СвязьУчетныхЕдиниц", "&СделкаСвязьУчетныхЕдиниц");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Сделка.Доходы", "&СделкаДоходы");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Сделка.СвязьДоходовИРасходов", "&СделкаСвязьДоходовИРасходов");
	Запрос.УстановитьПараметр("Контейнер", Контейнер);
	Запрос.УстановитьПараметр("СделкаСвязьУчетныхЕдиниц", СделкаОбъект.СвязьУчетныхЕдиниц.Выгрузить(,"ГУИД, Доплата_Клиент,
											|Доплата_Договор, Доплата_Калькуляция, Доплата_РелизСобственника, Контейнер"));
	Запрос.УстановитьПараметр("СделкаДоходы", СделкаОбъект.Доходы.Выгрузить(,"УчДокумент, ГУИД, Клиент, Договор, Калькуляция, 
																											|ДоплатныеКТК"));
	Запрос.УстановитьПараметр("СделкаСвязьДоходовИРасходов", СделкаОбъект.СвязьДоходовИРасходов.Выгрузить(,"Доходы, СвязьУчетныхЕдиниц"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	МассивУдаляемыхСтрок = Новый Массив;
	МассивИдентификаторовУдаляемыхСтрок = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		ТекущаяСтрока = СделкаОбъект.Доходы.НайтиСтроки(Новый Структура("ГУИД", Выборка.ГУИД))[0];
		МассивУдаляемыхСтрок.Добавить(ТекущаяСтрока);
		МассивИдентификаторовУдаляемыхСтрок.Добавить(ТекущаяСтрока.ГУИД);
	КонецЦикла;
	
	Документы.Сделка.ОчиститьДанныеВВспомогательныхТаблицахНаСервере(СделкаОбъект, МассивИдентификаторовУдаляемыхСтрок,  "Доходы");
	Для каждого УдаляемаяСтрока Из МассивУдаляемыхСтрок Цикл
		СделкаОбъект.Доходы.Удалить(УдаляемаяСтрока);
	КонецЦикла;
	
КонецПроцедуры
// Евросиб Рыбьяков К.А. 06.06.2025 ))
