	//Евросиб Каблов 20.05.2022 ( Task 45436
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФормированиеФинДокументов КАК ФормированиеФинДокументов
	|		ПО СделкаСвязьУчетныхЕдиниц.ДокументФФД = ФормированиеФинДокументов.Документ
	//Евросиб Каблов 20.05.2022 )
	|ГДЕ                                         
	|   СделкаСвязьУчетныхЕдиниц.Ссылка = &Ссылка 
	|	И ВЫБОР
	|			КОГДА &ПоискПоКТК
	|				ТОГДА СделкаСвязьУчетныхЕдиниц.Контейнер.Наименование = &Номер
	|			ИНАЧЕ СделкаСвязьУчетныхЕдиниц.Вагон.Наименование = &Номер
	|		КОНЕЦ
	|	И НЕ СделкаСвязьУчетныхЕдиниц.НеАктивна
	|   И ВЫБОР КОГДА &Контрагент = Неопределено ТОГДА ИСТИНА ИНАЧЕ СделкаСвязьУчетныхЕдиниц.Клиент = &Контрагент КОНЕЦ";
	Запрос.УстановитьПараметр("Номер", СокрЛП(Номер));
