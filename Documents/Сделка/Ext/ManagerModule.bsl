//Евросиб Каблов 20.01.2022 62514
Функция ПолучитьПризнакОплатаПоОригиналу(Сделка) Экспорт

	ОплатаПоОригиналу = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВремТЧ.Клиент КАК Клиент,
	               |	ВремТЧ.Договор КАК Договор,
	               |	""ЭтаСделка"" КАК Ссылка
	               |ПОМЕСТИТЬ ВТ
	               |ИЗ
	               |	&ВремТЧ КАК ВремТЧ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МАКСИМУМ(ВТ.Договор.ОплатаПоОригиналу) КАК ОплатаПоОригиналу,
	               |	ВТ.Ссылка КАК Ссылка
	               |ИЗ
	               |	ВТ КАК ВТ
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ.Ссылка";
	
	Если ТипЗнч(Сделка) = Тип("ДокументСсылка.Сделка") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВремТЧ КАК ВремТЧ", "Документ.Сделка.СвязьУчетныхЕдиниц КАК ВремТЧ ГДЕ ВремТЧ.Ссылка = &Ссылка");
		Запрос.УстановитьПараметр("Ссылка", Сделка);
	Иначе
		Запрос.УстановитьПараметр("ВремТЧ",Сделка.СвязьУчетныхЕдиниц.Выгрузить());
	КонецЕсли;
	
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		ОплатаПоОригиналу = Ответ.ОплатаПоОригиналу;
	КонецЕсли;
	
	Возврат ОплатаПоОригиналу;
		
КонецФункции

// ++ Евросиб Дудоров С.В. US 57543 30.01.2023
Функция ИзменитьСделкуПоРефСцепу(СделкаОбъект, РефСцепИсходный) Экспорт   
	
	НеобходимаЗаписьОбъекта = Ложь;

	ПостановкаЗадачиНаУдалениеКонтейнерыПоРефСцепу(СделкаОбъект
		, НеобходимаЗаписьОбъекта);
	
	Возврат НеобходимаЗаписьОбъекта;
	
КонецФункции	

Процедура ПостановкаЗадачиНаУдалениеКонтейнерыПоРефСцепу(СделкаОбъект, НеобходимаЗаписьОбъекта = Ложь) Экспорт
		
		
	УдаляемыеКТКИзСделкиПоРефСцепуПоОтветственным = УдаляемыеКТКИзСделкиПоРефСцепуПоОтветственным(СделкаОбъект);	
	тзУдаляемыхКТКИзСделкиПоРефСцепу = УдаляемыеКТКИзСделкиПоРефСцепуПоОтветственным.тзУдаляемыхКТКИзСделкиПоРефСцепу;
	мОтветственные                   = УдаляемыеКТКИзСделкиПоРефСцепуПоОтветственным.мОтветственные;
    тзРефСцепыПоОтветственным        = УдаляемыеКТКИзСделкиПоРефСцепуПоОтветственным.тзРефСцепыПоОтветственным;
	
	СтатусВыполнен 					 = Перечисления.СтатусыЭтапов.Выполнен;
	СтатусНаВыполнение				 = Перечисления.СтатусыЭтапов.НаВыполнение;	
	ОсновнаяЧастьНаименования 		 = "ИсключитьКТКИзСделкиВСвязиСоСменойРефСцепа";
	МассивОднотипныхСостояний		 = РефСцепСервер.МассивОднотипныхСостояний(ОсновнаяЧастьНаименования,9);
	тзСостояния 					 = СделкаОбъект.Состояния.Выгрузить();
		
	Если не тзУдаляемыхКТКИзСделкиПоРефСцепу.Количество() > 0 Тогда 
	//  Закрываем задачи на удаление заявок
		Для каждого стр из тзСостояния Цикл	
			Если МассивОднотипныхСостояний.Найти(Стр.Состояние)= Неопределено Тогда Продолжить; КонецЕсли;	
			НеобходимаЗаписьОбъекта = Истина;
			Стр.Статус 				= СтатусВыполнен;
		КонецЦикла;	

		СделкаОбъект.Состояния.Загрузить(тзСостояния);
		
		Возврат; 
	КонецЕсли;	
		
	Для каждого СтрОтветственный из мОтветственные Цикл
		
		мРефСцепыПоОтветсвенным = тзРефСцепыПоОтветственным.НайтиСтроки(
			НОвый Структура("Ответственный", СтрОтветственный));
		
		МассивРефСцеповКТКПоОтветственномуДляКомментария = НОвый Массив;
		
		Для каждого СтрРефСцепа из мРефСцепыПоОтветсвенным Цикл 

			МассивКТКПоОтветственномуДляКомментария = НОвый Массив;

			мУдаляемыхКТКИзСделкиПоРефСцепу = тзУдаляемыхКТКИзСделкиПоРефСцепу.НайтиСтроки(
				НОвый Структура("Ответственный, РефСцеп", СтрОтветственный, СтрРефСцепа.РефСцеп ));

			Для каждого СтрКТК из мУдаляемыхКТКИзСделкиПоРефСцепу Цикл
				Если СокрЛП(СтрКТК.КонтейнерНаименование) = "" Тогда Продолжить; КонецЕсли; 
				МассивКТКПоОтветственномуДляКомментария.Добавить( СтрКТК.КонтейнерНаименование + ", " );
			КонецЦикла;	
			
			МассивРефСцеповКТКПоОтветственномуДляКомментария.Добавить("КТК:" + стрСоединить(МассивКТКПоОтветственномуДляКомментария, ", ") 
				+ "Реф.сцеп:" + СтрРефСцепа.Номер + " от " + Формат(СтрКТК.Дата,"ДФ=""dd.MM.yyyy"""));
		КонецЦикла;		
		
		Комментарий = стрСоединить(МассивРефСцеповКТКПоОтветственномуДляКомментария, ", "); 
		
		МассивСостоянийНаУдалениеИзСделки = тзСостояния.НайтиСтроки(Новый Структура("Исполнитель", СтрОтветственный));	
		
		ЕстьСостоянияНаУдалениеИзСделкиПоОтветсвенному = Ложь;
			
		Для каждого стр из МассивСостоянийНаУдалениеИзСделки Цикл	
		
			Если МассивОднотипныхСостояний.Найти(Стр.Состояние)= Неопределено Тогда Продолжить; КонецЕсли;	
			
			ЕстьСостоянияНаУдалениеИзСделкиПоОтветсвенному = Истина;    	
			
			Если СокрЛП(Комментарий) <> "" и Стр.Статус <> СтатусНаВыполнение Тогда
				НеобходимаЗаписьОбъекта = Истина;
				Стр.Статус = СтатусНаВыполнение;
			    стр.Комментарий = Комментарий;
			ИначеЕсли СокрЛП(Комментарий) = "" и Стр.Статус <> СтатусВыполнен Тогда
				НеобходимаЗаписьОбъекта = Истина;
				Стр.Статус = СтатусВыполнен;
			КонецЕсли;	
			
		КонецЦикла;
		Если СокрЛП(Комментарий) <> "" и не ЕстьСостоянияНаУдалениеИзСделкиПоОтветсвенному Тогда
			НеобходимаЗаписьОбъекта = Истина;
			НоваяЗадача = тзСостояния.Добавить();
			НоваяЗадача.Исполнитель = СтрОтветственный;
			НоваяЗадача.Наблюдатель = СтрОтветственный;
			НоваяЗадача.Статус		= Перечисления.СтатусыЭтапов.НаВыполнение;
			НоваяЗадача.ВидНормативаИсполнения = Перечисления.ВидыНормативовИспользования.ЧасовСМоментаСозданияДокумента;
			НоваяЗадача.Состояние	= РефСцепСервер.ОчередноеСостояниеОдинаковых(
				тзСостояния, ОсновнаяЧастьНаименования, 9);
			НоваяЗадача.Комментарий = Комментарий; 
		КонецЕсли;	
		
	КонецЦикла;	
	Если НеобходимаЗаписьОбъекта = Истина Тогда
		СделкаОбъект.Состояния.Загрузить(тзСостояния);
	КонецЕсли;	
КонецПроцедуры	

Функция УдаляемыеКТКИзСделкиПоРефСцепуПоОтветственным(СделкаОбъект) 
	// 
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СделкаСвязьУчетныхЕдиниц.Заявка КАК Заявка,
		|	СделкаСвязьУчетныхЕдиниц.Контейнер КАК Контейнер
		|ПОМЕСТИТЬ вт_СделкаСвязьУчетныхЕдиниц0
		|ИЗ
		|	&тзСвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
		|ГДЕ
		|	СделкаСвязьУчетныхЕдиниц.НеАктивна = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СделкаСвязьУчетныхЕдиниц.Заявка КАК Заявка,
		|	ДокументЗаявка.ОтветственныйМенеджер КАК Ответственный,
		|	СделкаСвязьУчетныхЕдиниц.Контейнер КАК Контейнер
		|ПОМЕСТИТЬ вт_СделкаСвязьУчетныхЕдиниц
		|ИЗ
		|	вт_СделкаСвязьУчетныхЕдиниц0 КАК СделкаСвязьУчетныхЕдиниц
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Заявка КАК ДокументЗаявка
		|		ПО СделкаСвязьУчетныхЕдиниц.Заявка = ДокументЗаявка.Ссылка
		|			И (ДокументЗаявка.ДокументОснование ССЫЛКА Документ.РефСцеп)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РефСцепКонтейнеры.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	РефСцепКонтейнеры.ПеренесенВРефСцеп КАК ПеренесенВРефСцеп,
		|	РефСцепКонтейнеры.Контейнер КАК Контейнер,
		|	РефСцепКонтейнеры.Контейнер.Наименование КАК КонтейнерНаименование,
		|	РефСцепКонтейнеры.Ссылка.Номер КАК Номер,
		|	РефСцепКонтейнеры.Ссылка КАК РефСцеп,
		|	РефСцепКонтейнеры.Ссылка.Дата КАК Дата
		|ПОМЕСТИТЬ вт_РефСцепыПоКонтейнерам
		|ИЗ
		|	Документ.РефСцеп.Контейнеры КАК РефСцепКонтейнеры
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт_СделкаСвязьУчетныхЕдиниц КАК вт_СделкаСвязьУчетныхЕдиниц
		|		ПО РефСцепКонтейнеры.Контейнер = вт_СделкаСвязьУчетныхЕдиниц.Контейнер
		|ГДЕ
		|	РефСцепКонтейнеры.ПеренесенВРефСцеп <> ЗНАЧЕНИЕ(Документ.РефСцеп.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	вт_СделкаСвязьУчетныхЕдиниц.Ответственный КАК Ответственный,
		|	ЕСТЬNULL(вт_СделкаСвязьУчетныхЕдиниц.Заявка, ЗНАЧЕНИЕ(Документ.Заявка.ПустаяСсылка)) КАК Заявка,
		|	вт_РефСцепыПоКонтейнерам.КонтейнерНаименование КАК КонтейнерНаименование,
		|	вт_РефСцепыПоКонтейнерам.Номер КАК Номер,
		|	вт_РефСцепыПоКонтейнерам.Дата КАК Дата,
		|	вт_РефСцепыПоКонтейнерам.РефСцеп КАК РефСцеп
		|ПОМЕСТИТЬ вт_КонтейнерыКУдалениюПоОтвественным
		|ИЗ
		|	вт_РефСцепыПоКонтейнерам КАК вт_РефСцепыПоКонтейнерам
		|		ЛЕВОЕ СОЕДИНЕНИЕ вт_СделкаСвязьУчетныхЕдиниц КАК вт_СделкаСвязьУчетныхЕдиниц
		|		ПО вт_РефСцепыПоКонтейнерам.Контейнер = вт_СделкаСвязьУчетныхЕдиниц.Контейнер
		|ГДЕ
		|	ЕСТЬNULL(вт_СделкаСвязьУчетныхЕдиниц.Заявка, ЗНАЧЕНИЕ(Документ.Заявка.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Документ.Заявка.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
