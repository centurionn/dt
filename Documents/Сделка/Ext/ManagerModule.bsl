Процедура ИсправитьСвязиПоТЭУ(ОбъектСделка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СделкаДоходы.ДоплатныеКТК КАК ДоплатныеКТК,
	|	СделкаДоходы.ГУИД КАК ГУИД,
	|	СделкаДоходы.Услуга КАК Услуга,
	|	СделкаДоходы.УслугаВнеСтавки КАК УслугаВнеСтавки
	|ПОМЕСТИТЬ ВТ_Доходы
	|ИЗ
	|	&Доходы КАК СделкаДоходы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СделкаСвязьДоходовИРасходов.НомерСтроки КАК НомерСтроки,
	|	СделкаСвязьДоходовИРасходов.Доходы КАК Доходы,
	|	СделкаСвязьДоходовИРасходов.Расходы КАК Расходы,
	|	СделкаСвязьДоходовИРасходов.СвязьУчетныхЕдиниц КАК СвязьУчетныхЕдиниц,
	|	СделкаСвязьДоходовИРасходов.Услуга КАК Услуга
	|ПОМЕСТИТЬ ВТ_СвязьДоходовИРасходов
	|ИЗ
	|	&СвязьДоходовИРасходов КАК СделкаСвязьДоходовИРасходов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЛОЖЬ КАК УслугаВнеСтавки,
	|	СделкаДоходы.ГУИД КАК ГУИД,
	|	СделкаСвязьДоходовИРасходов.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.Сделка.Доходы КАК СделкаДоходы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьДоходовИРасходов КАК СделкаСвязьДоходовИРасходов
	|		ПО СделкаДоходы.ГУИД = СделкаСвязьДоходовИРасходов.Доходы
	|			И (СделкаСвязьДоходовИРасходов.Услуга = &УслугаТЭУ)
	|ГДЕ
	|	СделкаДоходы.Ссылка.Проведен
	|	И СделкаДоходы.УслугаВнеСтавки = ЛОЖЬ
	|	И СделкаДоходы.Услуга = &УслугаТЭУ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИСТИНА,
	|	СделкаДоходы.ГУИД,
	|	СделкаСвязьДоходовИРасходов.НомерСтроки
	|ИЗ
	|	ВТ_Доходы КАК СделкаДоходы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СвязьДоходовИРасходов КАК СделкаСвязьДоходовИРасходов
	|			ПО СделкаДоходы.ГУИД = СделкаСвязьДоходовИРасходов.Доходы
	|			И (СделкаСвязьДоходовИРасходов.Услуга = &ПустаяУслуга)
	|ГДЕ
	|	СделкаДоходы.УслугаВнеСтавки = ИСТИНА
	|	И СделкаДоходы.Услуга = &УслугаТЭУ
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("Доходы", ОбъектСделка.Доходы.Выгрузить());
	Запрос.УстановитьПараметр("СвязьДоходовИРасходов", ОбъектСделка.СвязьДоходовИРасходов.Выгрузить());
	Запрос.УстановитьПараметр("УслугаТЭУ", Справочники.Номенклатура.НайтиПоНаименованию("ТЭУ"));
	Запрос.УстановитьПараметр("ПустаяУслуга", Справочники.Номенклатура.ПустаяСсылка());
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.СледующийПоЗначениюПоля("НомерСтроки") Цикл
		СтрокаДоход = ОбъектСделка.СвязьДоходовИРасходов[Выборка.НомерСтроки-1];		
		СтрокаДоход.Услуга = ?(Выборка.УслугаВнеСтавки, Справочники.Номенклатура.НайтиПоНаименованию("ТЭУ"), Справочники.Номенклатура.ПустаяСсылка());
	КонецЦикла;
	
КонецПроцедуры

