Процедура ОчиститьУчетныеДокументыПоБитымСсылкамНаАкцептыВСделке(ОбъектСделка) Экспорт
                
                Запрос = Новый Запрос;
                Запрос.Текст = 
                "ВЫБРАТЬ
                |             АкцептУслуги.Ссылка.Поступление КАК Поступление,
                |             АкцептУслуги.Ссылка КАК Акцепт,
                |             АкцептУслуги.Сделка КАК Сделка,
                |             АкцептУслуги.ИдентификаторСтрокиРасходовВСделке КАК ИдентификаторСтрокиРасходовВСделке
                |ПОМЕСТИТЬ ВТАктуальныеАкцепты
                |ИЗ
                |             Документ.Акцепт.Услуги КАК АкцептУслуги
                |ГДЕ
                |             НЕ АкцептУслуги.Ссылка В
                |                                                             (ВЫБРАТЬ
                |                                                                            Акцепт.СторнируемыйАкцепт КАК СторнируемыйАкцепт
                |                                                             ИЗ
                |                                                                            Документ.Акцепт КАК Акцепт
                |                                                             ГДЕ
                |                                                                            Акцепт.Проведен)
                |             И АкцептУслуги.Ссылка.Проведен
                |             И АкцептУслуги.Ссылка.СторнируемыйАкцепт = ЗНАЧЕНИЕ(Документ.Акцепт.ПустаяСсылка)
                |             И АкцептУслуги.Сделка = &Сделка
                |
                |ИНДЕКСИРОВАТЬ ПО
                |             Сделка,
                |             ИдентификаторСтрокиРасходовВСделке
                |;
                |
                |////////////////////////////////////////////////////////////////////////////////
                |ВЫБРАТЬ
                |             &Сделка КАК Ссылка,
                |             СделкаРасходы.ГУИД КАК ГУИД,
                |             СделкаРасходы.УчДокумент КАК УчДокумент
                |ПОМЕСТИТЬ ВТ_Расходы
                |ИЗ
                |             &Расходы КАК СделкаРасходы
                |ГДЕ
                |             НЕ СделкаРасходы.УчДокумент = ЗНАЧЕНИЕ(Документ.ПоступлениеТоваровУслуг.ПустаяСсылка)
                |;
                |
                |////////////////////////////////////////////////////////////////////////////////
                |ВЫБРАТЬ
                |             ВТ_Расходы.Ссылка КАК Ссылка,
                |             ВТ_Расходы.ГУИД КАК ГУИД,
                |             ВТ_Расходы.УчДокумент КАК УчДокумент
                |ИЗ
                |             ВТ_Расходы КАК ВТ_Расходы
                |                             ЛЕВОЕ СОЕДИНЕНИЕ ВТАктуальныеАкцепты КАК ВТАктуальныеАкцепты
                |                             ПО ВТ_Расходы.Ссылка = ВТАктуальныеАкцепты.Сделка
                |                                             И ВТ_Расходы.ГУИД = ВТАктуальныеАкцепты.ИдентификаторСтрокиРасходовВСделке
                |ГДЕ
                |             ВТАктуальныеАкцепты.ИдентификаторСтрокиРасходовВСделке ЕСТЬ NULL";                       
                ТЗРасходы = ОбъектСделка.Расходы.Выгрузить();
                Запрос.УстановитьПараметр("Расходы", ТЗРасходы);
                Запрос.УстановитьПараметр("Сделка", ОбъектСделка.Ссылка);
                РезультатЗапроса = Запрос.Выполнить();
                Выборка = РезультатЗапроса.Выбрать();
                Пока Выборка.Следующий() Цикл
                               
                               СтрокаРасход = ТЗРасходы.Найти(Выборка.ГУИД, "ГУИД");
                               СтрокаРасход.УчДокумент = Документы.ПоступлениеТоваровУслуг.ПустаяСсылка();
                               
                КонецЦикла;
                ОбъектСделка.Расходы.Загрузить(ТЗРасходы);
                               
КонецПроцедуры

