//Евросиб Каблов 26.08.2022 56193
Процедура ПроверитьПериодВОДоходов(Доходы, Сделка = Неопределено, ИзФормыСделки = Ложь, Отказ) Экспорт

	Если ИзФормыСделки Тогда
		
		Для каждого СтрокаДоход Из Доходы Цикл
			Если НЕ СтрокаДоход.НеВыставлятьКлиенту
					И НЕ ЗначениеЗаполнено(СтрокаДоход.ПериодВО) Тогда
				ИндексСтроки = Доходы.Индекс(СтрокаДоход);
				ОбщегоНазначения.СообщитьПользователю("Не заполнен период ВО",,"Доходы["+ИндексСтроки+"].ПериодВО","Объект",Отказ);
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		ТаблицаОшибок = Доходы.ВыгрузитьКолонки("Клиент, Договор, ПравилоОпределенияДатыДокумента");
		
		Для каждого СтрокаДоход Из Доходы Цикл
			Если НЕ СтрокаДоход.НеВыставлятьКлиенту
					И НЕ ЗначениеЗаполнено(СтрокаДоход.ПериодВО) Тогда
				НайденныеСтрокиСОшибками = ТаблицаОшибок.НайтиСтроки(Новый Структура("Клиент, Договор, ПравилоОпределенияДатыДокумента", СтрокаДоход.Клиент, СтрокаДоход.Договор, СтрокаДоход.ПравилоОпределенияДатыДокумента));
				Если НайденныеСтрокиСОшибками.Количество() = 0 Тогда
					СтрокаТаблицыОшибок = ТаблицаОшибок.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаТаблицыОшибок, СтрокаДоход);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если ТаблицаОшибок.Количество() > 0 Тогда
			
			СделкаТип = ТипЗнч(Сделка);
			РеквизитыСделки = "Номер, Дата";
			Если СделкаТип = Тип("ДокументСсылка.Сделка") Тогда
				ЗначенияРеквизитовСделки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Сделка, РеквизитыСделки);
			ИначеЕсли СделкаТип = Тип("ДокументОбъект.Сделка") Тогда
				ЗначенияРеквизитовСделки = Новый Структура(РеквизитыСделки);
				ЗаполнитьЗначенияСвойств(ЗначенияРеквизитовСделки, Сделка);
			КонецЕсли;
			
			Для Каждого СтрокаТаблицыОшибок Из ТаблицаОшибок Цикл
				ТекстСообщения = СтрШаблон("В сделке %1 от %2 не заполнен период ВО по правилу %3 по клиенту %4 договору %5", ЗначенияРеквизитовСделки.Номер, Формат(ЗначенияРеквизитовСделки.Дата, "ДФ=dd.MM.yyyy"), СтрокаТаблицыОшибок.ПравилоОпределенияДатыДокумента, СтрокаТаблицыОшибок.Клиент, СтрокаТаблицыОшибок.Договор);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

