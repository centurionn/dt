	|	ЕСТЬNULL(ВТ_Доходы.УчДокумент.Ссылка, НЕОПРЕДЕЛЕНО) <> ЕСТЬNULL(ВТ_Документы.Ссылка, НЕОПРЕДЕЛЕНО)
	//Евросиб Каблов 22.05.2025 ( #110248	
	|	ИЛИ НАЧАЛОПЕРИОДА(ВТ_Доходы.ПериодВО, МЕСЯЦ) <> ВТ_Документы.ПериодВО";
