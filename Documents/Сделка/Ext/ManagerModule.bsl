Функция ПолучитьСтруктуруТаблицыПТУ() Экспорт
	
	ТаблицаПТУ = Новый ТаблицаЗначений;
	ТаблицаПТУ.Колонки.Добавить("ПТУ", Новый ОписаниеТипов("ДокументСсылка.ПоступлениеТоваровУслуг"));
	ТаблицаПТУ.Колонки.Добавить("СделкаНовая", Новый ОписаниеТипов("ДокументСсылка.Сделка"));
	ТаблицаПТУ.Колонки.Добавить("СделкаСтарая", Новый ОписаниеТипов("ДокументСсылка.Сделка"));
 	ТаблицаПТУ.Колонки.Добавить("ИдентификаторСтрокиРасходовСделкиНовая", Метаданные.ОпределяемыеТипы.ГУИД.Тип);
 	ТаблицаПТУ.Колонки.Добавить("ИдентификаторСтрокиРасходовСделкиСтарая", Метаданные.ОпределяемыеТипы.ГУИД.Тип);
	Возврат ТаблицаПТУ;
	
