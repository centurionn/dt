Функция НайтиСчетНаОплатуCreditNoteПоСчетуОснованию(Сделка, СчетОснование, Параметры) Экспорт
	
	Если СчетОснование = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Счет = Неопределено;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	СчетНаОплатуПокупателю.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю
	|ГДЕ
	|	СчетНаОплатуПокупателю.СчетНаОплатуCreditNote = &СчетОснование
	|	И СчетНаОплатуПокупателю.CreditNote
	|	И НЕ СчетНаОплатуПокупателю.ПометкаУдаления
	|   И СчетНаОплатуПокупателю.ДокументыОснования.Сделка = &Сделка
	//|	И СчетНаОплату.Сделка = &Сделка
	|	И СчетНаОплатуПокупателю.Контрагент = &Контрагент
	|	И СчетНаОплатуПокупателю.ДоговорКонтрагента = &ДоговорКонтрагента");	
	Запрос.УстановитьПараметр("Сделка", Сделка);
	Запрос.УстановитьПараметр("Контрагент", Параметры.Клиент);
	Запрос.УстановитьПараметр("ДоговорКонтрагента", Параметры.Договор);
	Запрос.УстановитьПараметр("СчетОснование", СчетОснование);
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Счет = Результат.Выгрузить()[0].Ссылка;
	КонецЕсли;
	
	Возврат Счет;
	
КонецФункции //ДИТ Давудов М.А. Task32744 03.07.2021 Конец

