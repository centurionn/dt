Процедура ЗаполнитьСсылкиНаВагоны_КТК_ТД_ВРасходах(ОбъектСделка) Экспорт
	
	Возврат;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СделкаРасходы.ГУИД КАК ГУИД,
	|	ВЫРАЗИТЬ(СделкаРасходы.Услуга КАК Справочник.Номенклатура) КАК Услуга,
	|	СделкаРасходы.СтрокаСвязьУчетныхЕдиниц КАК СтрокаСвязьУчетныхЕдиниц,
	|	СделкаРасходы.ИсточникПоявленияСтрокиЭкономики КАК ИсточникПоявленияСтрокиЭкономики,
	|	СделкаРасходы.Контейнер КАК Контейнер,
	|	СделкаРасходы.Вагон КАК Вагон,
	|	СделкаРасходы.ГруппаУслуг КАК ГруппаУслуг,
	|	ВЫРАЗИТЬ(СделкаРасходы.ТранспортныйДокумент КАК Документ.ТранспортныйДокумент) КАК ТранспортныйДокумент,
	|	СделкаРасходы.УслугаОтключена КАК УслугаОтключена
	|ПОМЕСТИТЬ ВТ_Расходы
	|ИЗ
	|	&Расходы КАК СделкаРасходы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СделкаДоходыВагоны.ГУИД КАК ГУИД,
	|	СделкаДоходыВагоны.Вагон КАК Вагон
	|ПОМЕСТИТЬ ВТ_ДоходыВагоны
	|ИЗ
	|	&ДоходыВагоны КАК СделкаДоходыВагоны
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СделкаДоходыКТК.ГУИД КАК ГУИД,
	|	СделкаДоходыКТК.КТК КАК КТК
	|ПОМЕСТИТЬ ВТ_ДоходыКТК
	|ИЗ
	|	&ДоходыКТК КАК СделкаДоходыКТК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СделкаДоходыТД.ГУИД КАК ГУИД,
	|	СделкаДоходыТД.ТД КАК ТД
	|ПОМЕСТИТЬ ВТ_ДоходыТД
	|ИЗ
	|	&ДоходыТД КАК СделкаДоходыТД
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СделкаСвязьУчетныхЕдиниц.ГУИД КАК ГУИД,
	|	СделкаСвязьУчетныхЕдиниц.Контейнер КАК Контейнер,
	|	СделкаСвязьУчетныхЕдиниц.НомерПорожнейВагоннойЖДН КАК НомерПорожнейВагоннойЖДН,
	|	СделкаСвязьУчетныхЕдиниц.НомерПорожнейЖДНКТК КАК НомерПорожнейЖДНКТК,
	|	СделкаСвязьУчетныхЕдиниц.НомерВагоннойЖДН КАК НомерВагоннойЖДН,
	|	СделкаСвязьУчетныхЕдиниц.ЖДН КАК ЖДН,
	|	СделкаСвязьУчетныхЕдиниц.НакладнаяПослеГруженогоПлеча КАК НакладнаяПослеГруженогоПлеча,
	|	ВЫРАЗИТЬ(СделкаСвязьУчетныхЕдиниц.НакладнаяПослеГружКТК КАК Документ.ТранспортныйДокумент) КАК НакладнаяПослеГружКТК,
	|	СделкаСвязьУчетныхЕдиниц.ЖДНПерестановкиДоГружКТК КАК ЖДНПерестановкиДоГружКТК,
	|	СделкаСвязьУчетныхЕдиниц.ЖДНПерестановкиДоПорКТК КАК ЖДНПерестановкиДоПорКТК,
	|	СделкаСвязьУчетныхЕдиниц.ВагоннаяЖДН КАК ВагоннаяЖДН,
	|	СделкаСвязьУчетныхЕдиниц.ПорожняяЖДНКТК КАК ПорожняяЖДНКТК,
	|	СделкаСвязьУчетныхЕдиниц.ПорожняяВагоннаяЖДН КАК ПорожняяВагоннаяЖДН,
	|	СделкаСвязьУчетныхЕдиниц.Коносамент КАК Коносамент,
	|	ВЫРАЗИТЬ(СделкаСвязьУчетныхЕдиниц.Вагон КАК Справочник.ТС) КАК Вагон
	|ПОМЕСТИТЬ ВТ_СвязьУчетныхЕдиниц
	|ИЗ
	|	&СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СделкаРасходы.ГУИД КАК ГУИД,
	|	СделкаРасходы.Контейнер КАК Контейнер,
	|	СделкаРасходы.Вагон КАК Вагон,
	|	СделкаРасходы.ТранспортныйДокумент КАК ТранспортныйДокумент,
	|	ВЫБОР
	|		КОГДА СделкаРасходы.ГруппаУслуг > 0
	|				И СделкаРасходы.Услуга.УслугаРасходовВыбираетсяПриУсловии = 2
	|			ТОГДА ТС.Ссылка
	|		КОГДА СделкаРасходы.ИсточникПоявленияСтрокиЭкономики = ЗНАЧЕНИЕ(Перечисление.ИсточникПоявленияСтрокиЭкономики.ЖДНПодсылаКТК)
	|			ТОГДА СделкаРасходы.Вагон
	|		ИНАЧЕ СделкаСвязьУчетныхЕдиниц.Вагон
	|	КОНЕЦ КАК ВагонСУЕ,
	|	ВЫБОР
	|		КОГДА СделкаРасходы.ИсточникПоявленияСтрокиЭкономики = ЗНАЧЕНИЕ(Перечисление.ИсточникПоявленияСтрокиЭкономики.ЖДНВозврата)
	|			ТОГДА СделкаРасходы.Контейнер
	|		ИНАЧЕ СделкаСвязьУчетныхЕдиниц.Контейнер
	|	КОНЕЦ КАК КонтейнерСУЕ,
	|	ВЫБОР
	|		КОГДА СделкаРасходы.ИсточникПоявленияСтрокиЭкономики = ЗНАЧЕНИЕ(Перечисление.ИсточникПоявленияСтрокиЭкономики.ЖДНПодсылаВагонов)
	|			ТОГДА СделкаСвязьУчетныхЕдиниц.ПорожняяВагоннаяЖДН
	|		КОГДА СделкаРасходы.ИсточникПоявленияСтрокиЭкономики = ЗНАЧЕНИЕ(Перечисление.ИсточникПоявленияСтрокиЭкономики.ЖДНПодсылаКТК)
	|			ТОГДА СделкаСвязьУчетныхЕдиниц.ПорожняяЖДНКТК
	|		КОГДА СделкаРасходы.ИсточникПоявленияСтрокиЭкономики = ЗНАЧЕНИЕ(Перечисление.ИсточникПоявленияСтрокиЭкономики.ПорожняяЖДН)
	|			ТОГДА СделкаСвязьУчетныхЕдиниц.ВагоннаяЖДН
	|		КОГДА СделкаРасходы.ИсточникПоявленияСтрокиЭкономики = ЗНАЧЕНИЕ(Перечисление.ИсточникПоявленияСтрокиЭкономики.ЖДНВозврата)
	|			ТОГДА СделкаСвязьУчетныхЕдиниц.НакладнаяПослеГруженогоПлеча
	|		КОГДА СделкаРасходы.ИсточникПоявленияСтрокиЭкономики = ЗНАЧЕНИЕ(Перечисление.ИсточникПоявленияСтрокиЭкономики.ЖДНВозвратаКТК)
	|			ТОГДА СделкаСвязьУчетныхЕдиниц.НакладнаяПослеГружКТК
	|		КОГДА СделкаРасходы.Услуга = &УслугаФрахт
	|			ТОГДА СделкаСвязьУчетныхЕдиниц.Коносамент
	|		КОГДА СделкаРасходы.ГруппаУслуг > 0
	|				И СделкаРасходы.Услуга.УслугаРасходовВыбираетсяПриУсловии = 1
	|			ТОГДА СделкаСвязьУчетныхЕдиниц.НакладнаяПослеГруженогоПлеча
	|		КОГДА СделкаРасходы.ГруппаУслуг > 0
	|				И СделкаРасходы.Услуга.УслугаРасходовВыбираетсяПриУсловии = 2
	|			ТОГДА СделкаСвязьУчетныхЕдиниц.НакладнаяПослеГружКТК
	|		КОГДА НЕ СделкаРасходы.ТранспортныйДокумент = ЗНАЧЕНИЕ(Документ.ТранспортныйДокумент.ПустаяСсылка)
	|			ТОГДА СделкаРасходы.ТранспортныйДокумент
	|		ИНАЧЕ СделкаСвязьУчетныхЕдиниц.ЖДН
	|	КОНЕЦ КАК ТД,
	|	СделкаРасходы.ИсточникПоявленияСтрокиЭкономики КАК ИсточникПоявленияСтрокиЭкономики
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	ВТ_Расходы КАК СделкаРасходы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДоходыВагоны КАК СделкаДоходыВагоны
	|		ПО СделкаРасходы.ГУИД = СделкаДоходыВагоны.ГУИД
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДоходыКТК КАК СделкаДоходыКТК
	|		ПО СделкаРасходы.ГУИД = СделкаДоходыКТК.ГУИД
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДоходыТД КАК СделкаДоходыТД
	|		ПО СделкаРасходы.ГУИД = СделкаДоходыТД.ГУИД
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|		ПО СделкаРасходы.СтрокаСвязьУчетныхЕдиниц = СделкаСвязьУчетныхЕдиниц.ГУИД
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.э_Накладная.Вагоны КАК э_НакладнаяВагоны
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТС КАК ТС
	|			ПО э_НакладнаяВагоны.НомерВагона = ТС.Наименование
	|				И (НЕ ТС.ПометкаУдаления)
	|		ПО СделкаСвязьУчетныхЕдиниц.НакладнаяПослеГружКТК.НакладнаяЭТРАН = э_НакладнаяВагоны.Ссылка
	//|ГДЕ
	//|	СделкаРасходы.УслугаОтключена = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.КонтейнерСУЕ КАК Контейнер2,
	|	ТрД.Ссылка КАК ТранспортныйДокумент1,
	|	ТС.Ссылка КАК Вагон2,
	|	ВТ.ГУИД КАК ГУИД,
	|	ВТ.ВагонСУЕ КАК Вагон,
	|	ВТ.КонтейнерСУЕ КАК Контейнер,
	|	ВТ.ТД КАК ТранспортныйДокумент,
	|	ВТ.Контейнер КАК Контейнер1,
	|	ВТ.Вагон КАК Вагон1,
	|	ВТ.ТранспортныйДокумент КАК ТранспортныйДокумент2
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТЕ КАК ТЕ
	|		ПО ВТ.КонтейнерСУЕ = ТЕ.Наименование
	|			И (НЕ ТЕ.ПометкаУдаления)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТС КАК ТС
	|		ПО ВТ.ВагонСУЕ = ТС.Наименование
	|			И (НЕ ТС.ПометкаУдаления)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент КАК ТрД
	|		ПО ВТ.ТД = ТрД.НомерТранспортногоДокумента
	|			И (НЕ ТрД.ПометкаУдаления)
	|ГДЕ
	|	НЕ(ВТ.Контейнер = ВТ.КонтейнерСУЕ
	|				И ВТ.Вагон = ВТ.ВагонСУЕ
	|				И ВТ.ТранспортныйДокумент = ВТ.ТД)";
	//Запрос.УстановитьПараметр("Сделка", ОбъектСделка.Ссылка);
	Запрос.УстановитьПараметр("Расходы", ОбъектСделка.Расходы.Выгрузить());
	Запрос.УстановитьПараметр("ДоходыВагоны", ОбъектСделка.ДоходыВагоны.Выгрузить());
	Запрос.УстановитьПараметр("ДоходыКТК", ОбъектСделка.ДоходыКТК.Выгрузить());
	Запрос.УстановитьПараметр("ДоходыТД", ОбъектСделка.ДоходыТД.Выгрузить());
	Запрос.УстановитьПараметр("СвязьУчетныхЕдиниц", ОбъектСделка.СвязьУчетныхЕдиниц.Выгрузить());
	Запрос.УстановитьПараметр("УслугаФрахт", Константы.УслугаФрахтаДляКалькуляции.Получить());
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли; 
	Выборка = РезультатЗапроса.Выбрать();
	ТЗРасходы = ОбъектСделка.Расходы.Выгрузить();
	Пока Выборка.Следующий() Цикл
		СтрокаРасход = ТЗРасходы.Найти(Выборка.ГУИД, "ГУИД");
		ЗаполнитьЗначенияСвойств(СтрокаРасход, Выборка, "Вагон, Контейнер, ТранспортныйДокумент");
	КонецЦикла;
	ОбъектСделка.Расходы.Загрузить(ТЗРасходы);
		
КонецПроцедуры

