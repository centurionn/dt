//ДИТ, Беляев СЮ, Ticket#0343311, 28-02-2024, начало
Функция ОтсутствующиеИНедействительныеОтветственные( Объект ) Экспорт
	РезультатЗапросаПакет = РезультатЗапросаОпределенияОтветственныхЗаУчет(Объект);
	
	СтруктураРезультат = Новый Структура;
	СтруктураРезультат.Вставить("МассивКлиентовБезОтветственного", РезультатЗапросаПакет[РезультатЗапросаПакет.Количество()-3].Выгрузить().ВыгрузитьКолонку("Клиент"));
	СтруктураРезультат.Вставить("МассивОтветственныхНедействительных", РезультатЗапросаПакет[РезультатЗапросаПакет.Количество()-2].Выгрузить().ВыгрузитьКолонку("ОтветственныйЗаУчет"));
	
	Возврат СтруктураРезультат;
КонецФункции
