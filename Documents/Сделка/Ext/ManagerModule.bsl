	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОтключитьАвтоустановку КАК ВТ_ОтключитьАвтоустановку
	|		ПО ВТ.ГУИД = ВТ_ОтключитьАвтоустановку.ГУИД
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.Клиент,
	|	ВТ.Договор
	|
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(ЕСТЬNULL(ВТ_ОтключитьАвтоустановку.ОтключитьАвтоустановкуГотовоКВыставлению, ЛОЖЬ)) = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ.Клиент КАК Клиент,
	|	ВТ.УсловияПеревозки КАК УсловияПеревозки,
	|	ВТ.УсловияПеревозкиНазначение КАК УсловияПеревозкиНазначение,
	|	ВТ.Калькуляция КАК Калькуляция
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОтключитьАвтоустановкуКлиентДоговор КАК ВТ_ОтключитьАвтоустановкуКлиентДоговор
	|		ПО ВТ.Клиент = ВТ_ОтключитьАвтоустановкуКлиентДоговор.Клиент
	|			И ВТ.Договор = ВТ_ОтключитьАвтоустановкуКлиентДоговор.Договор
	|ГДЕ
	|	НЕ ВТ.ОтключитьРасходы
	|	И НЕ ВТ.ГотовоКВыставлению
	|	И ВТ.УсловияПеревозки = &УсловиеПеревозкиОтправления
	|	И ВТ.УсловияПеревозкиНазначение В(&МассивУсловийПеревозкиНазначение)
	|	И ВТ.Клиент.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	|	И ВТ.Калькуляция.ПС_ВидПеревозки = &ВидПеревозки
