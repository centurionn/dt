	|   НайдПСЦ.ПСЦ.СтатусДокумента = &СтатусСогласованоСЗамечаниями КАК СогласованоСЗамечаниями
	|ИЗ
	|	НайдПСЦ КАК НайдПСЦ";
	
	//Запрос.УстановитьПараметр("Ссылка", Заявка);
	//Запрос.УстановитьПараметр("НомерКТК", Контейнер);
	Запрос.УстановитьПараметр("ТекДата", НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("Протокол", Протокол);
	//Евросиб - АСуслов 09.11.2020 18:33:34 #
	//(
	//Запрос.УстановитьПараметр("Повагонка", ПовагонныеОтправки);
	//)
	//Евросиб - АСуслов 09.11.2020 18:33:34 #
	РазрСтатусы = Новый Массив;
	//РазрСтатусы.Добавить(Перечисления.СтатусыСогласования.Подписано);
	РазрСтатусы.Добавить(Перечисления.СтатусыСогласования.СогласованоБезЗамечаний);
	РазрСтатусы.Добавить(Перечисления.СтатусыСогласования.СогласованСКомментариями);
	//Субботин 71862 26.06.2023 Начало
	 РазрСтатусы.Добавить(Перечисления.СтатусыСогласования.ПолучениеПодписанногоПСЦНевозможно);
