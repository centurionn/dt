&НаСервере
Функция СформироватьСчетНаОплатуПокупателюCreditNote(Сделка, Контрагент, Договор, СчетНаОплатуПокупателю) Экспорт
	
	МассивКомплектов = Новый Массив;
	
	// Определим данные для формирования документа
	
	// Получим данные по сделки
	ВыборкаДанных = ПолучитьВыборкуДанныхДляФормированияCreditNote(Сделка, СчетНаОплатуПокупателю);
	Пока ВыборкаДанных.Следующий() Цикл		
		Параметры = Новый Структура;
		Параметры.Вставить("Клиент", Контрагент);
		Параметры.Вставить("Договор", Договор);
		ДокументCreditNote = СоздатьДокументCreditNote(Сделка, ВыборкаДанных, Параметры);
		
		СтруктураСчет = новый Структура;
		СтруктураСчет.Вставить("CreditNote", ДокументCreditNote);
		СтруктураСчет.Вставить("Контрагент", Контрагент);
		СтруктураСчет.Вставить("Договор", Договор);
		МассивКомплектов.Добавить(СтруктураСчет);
	КонецЦикла;  
	
		
	Возврат МассивКомплектов;
	
КонецФункции //ДИТ Давудов М.А. Task32744 03.07.2021 Конец

