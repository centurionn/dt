Функция СоздатьДокументCreditNote(Сделка, ВыборкаДанных, Параметры)
	
	СчетОснование = ВыборкаДанных.СчетНаОплатуПокупателю;
	
	СчетCreditNote = НайтиСчетНаОплатуCreditNoteПоСчетуОснованию(Сделка, СчетОснование, Параметры);
	
	Если СчетCreditNote = Неопределено Тогда
		СчетCreditNoteОбъект = Документы.СчетНаОплатуПокупателю.СоздатьДокумент();
	Иначе
		СчетCreditNoteОбъект = СчетCreditNote.ПолучитьОбъект();
	КонецЕсли;
	
	СчетCreditNoteОбъект.Товары.Очистить();
	
	ЗаполнитьЗначенияСвойств(
		СчетCreditNoteОбъект, 
		СчетОснование, 
		"АдресДоставки, БанковскийСчетОрганизации, БезДоверенностей,
		|ВалютаДокумента, Грузоотправитель, Грузополучатель, ДоговорКонтрагента,
		|КомиссионныеУслуги, Контрагент, Организация, ПодразделениеОрганизации, Сделка,
		|СуммаВключаетНДС, УчитыватьНДС, ЦФО, Факторинг, Партия, ОкруглятьКурсДоКоличестваЗнаков, 
		|ВидСтавки, ВидГруппировкиФрахта");
		
	СчетCreditNoteОбъект.CreditNote = Истина;
	СчетCreditNoteОбъект.СчетНаОплатуCreditNote = СчетОснование;
	СчетCreditNoteОбъект.АвансовыйСчет = Ложь;
	СчетCreditNoteОбъект.Дата = ТекущаяДатаСеанса();
	СчетCreditNoteОбъект.ПериодВО = НачалоМесяца(ТекущаяДатаСеанса());
	СчетCreditNoteОбъект.Ответственный = Пользователи.ТекущийПользователь();
	СчетCreditNoteОбъект.Маршрутизировать = Истина;
	
	СтрПараметровРеглУчет = Новый Структура;
	СтрПараметровРеглУчет.Вставить("Валюта", Константы.ВалютаРегламентированногоУчета.Получить());
	СтрПараметровРеглУчет.Вставить("Курс", 1);
	СтрПараметровРеглУчет.Вставить("Кратность", 1);
	
	СтрПараметров = КонтрагентыДоговоры_сервер.ПолучитьВалютуДоговора(СчетCreditNoteОбъект.ДоговорКонтрагента, СчетCreditNoteОбъект.Дата);
	СчетCreditNoteОбъект.ВалютаДокумента = СтрПараметров.Валюта;
	СчетCreditNoteОбъект.КурсВзаиморасчетов = СтрПараметров.Курс;
	СчетCreditNoteОбъект.КратностьВзаиморасчетов = СтрПараметров.Кратность;
	
	Выборка = ВыборкаДанных.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = СчетCreditNoteОбъект.Товары.Добавить();	
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		НоваяСтрока.Количество = 1;
		НоваяСтрока.Цена = НоваяСтрока.Сумма;
		//Если НоваяСтрока.Количество > 0 Тогда
		//	НоваяСтрока.Цена = НоваяСтрока.Сумма/НоваяСтрока.Количество;
		//КонецЕсли;
		
		НоваяСтрока.СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(
								НоваяСтрока.Сумма,
								БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС),
								СчетCreditNoteОбъект.УчитыватьНДС,
								СчетCreditNoteОбъект.СуммаВключаетНДС);
	КонецЦикла;
	
	ИтогоВсегоНДС = ?(СчетCreditNoteОбъект.Товары.Количество() > 0, СчетCreditNoteОбъект.Товары.Итог("СуммаНДС"), 0);
	СчетCreditNoteОбъект.СуммаДокумента = ?(СчетCreditNoteОбъект.Товары.Количество() > 0, СчетCreditNoteОбъект.Товары.Итог("Сумма"), 0) +
		?(СчетCreditNoteОбъект.СуммаВключаетНДС, 0, ИтогоВсегоНДС);
		
	СчетCreditNoteОбъект.ДополнительныеСвойства.Вставить("ПрограммноеИзменение", Истина);
	СчетCreditNoteОбъект.Записать(РежимЗаписиДокумента.Проведение);

	Возврат СчетCreditNoteОбъект.Ссылка;
	
КонецФункции //ДИТ Давудов М.А. Task32744 03.07.2021 Конец

