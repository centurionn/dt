	|						ИЛИ ВТ_РезультатПроверки.Коносамент.СтанцияНазначения = КалькуляцияНФ_ВыбранныеСтавки.Порт
	|			КОНЕЦ) СтатусСоответствияПорта,
	|	//СОБСТВЕННОСТЬ
	|	МАКСИМУМ(ВЫБОР
	// ДИТ 89973 Давудов М.А. Начало: 21.08.2024
	//ок(
	//|			КОГДА ВТ_РезультатПроверки.СобственностьПеревозимогоКТК = ЗНАЧЕНИЕ(Перечисление.СобственностьПеревозимогоКонтейнера.SOC)
	//ок)
	|			КОГДА ВТ_РезультатПроверки.ПринадлежностьТЕ = ЗНАЧЕНИЕ(Перечисление.ПринадлежностьТЕ.КТКлиента)
	// ДИТ 89973 Давудов М.А. Конец: 21.08.2024
	|					ТОГДА ""SOC""
	|				ИНАЧЕ ""COC""
	|			КОНЕЦ = КалькуляцияНФ_ВыбранныеСтавки.SOCCOC) КАК СтатусСоответствияСобственностиПеревозимогоКТК
	|	//СТАВКА			
	|	,МАКСИМУМ(ВЫБОР
	|				КОГДА ВТ_РезультатПроверки.Контейнер.ТипТЕ.РазмерКТК = ЗНАЧЕНИЕ(Справочник.РазмерыКТК.К20)
	|					ТОГДА КалькуляцияНФ_ВыбранныеСтавки.Фрахт20
	|				ИНАЧЕ КалькуляцияНФ_ВыбранныеСтавки.Фрахт40
	|			КОНЕЦ > 0) КАК СтатусСуммаСтавкиУказана
	|ПОМЕСТИТЬ ВТ_ДанныеСНекорректнойКалькуляцией 
	//ДИТ, Беляев СЮ, US 61000/TA 61002, 20-12-2022, конец
	|ИЗ
	|	ВТ_РезультатПроверки КАК ВТ_РезультатПроверки
	//ДИТ, Беляев СЮ, US 61000/TA 61002, 20-12-2022, начало
	|	ЛЕВОЕ СОЕДИНЕНИЕ Документ.Калькуляция.НФ_ВыбранныеСтавки КАК КалькуляцияНФ_ВыбранныеСтавки
	|		ПО ВТ_РезультатПроверки.Калькуляция = КалькуляцияНФ_ВыбранныеСтавки.Ссылка И (КалькуляцияНФ_ВыбранныеСтавки.Выбрано40 ИЛИ КалькуляцияНФ_ВыбранныеСтавки.Выбрано20)
	//ДИТ, Беляев СЮ, US 61000/TA 61002, 20-12-2022, конец
	|ГДЕ
	|	НЕ ВТ_РезультатПроверки.КалькуляцияСоответствует
	|	И ВТ_РезультатПроверки.ВидТранспортногоСообщения = &ВидТранспортногоСообщения
	//ДИТ, Беляев СЮ, US 61000/TA 61002, 20-12-2022, начало
	|СГРУППИРОВАТЬ ПО
	|	ВТ_РезультатПроверки.ГУИД
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеСНекорректнойКалькуляцией.ГУИД КАК ГУИД,
	|  (ВЫБОР КОГДА ВТ_ДанныеСНекорректнойКалькуляцией.СтатусСоответствияПорта ТОГДА """" ИНАЧЕ ""порт; "" КОНЕЦ)
	|  +(ВЫБОР КОГДА ВТ_ДанныеСНекорректнойКалькуляцией.СтатусСоответствияСобственностиПеревозимогоКТК ТОГДА """" ИНАЧЕ ""собственность КТК; "" КОНЕЦ)
	|  +(ВЫБОР КОГДА ВТ_ДанныеСНекорректнойКалькуляцией.СтатусСуммаСтавкиУказана ТОГДА """" ИНАЧЕ ""ставка, соответствующая размеру КТК "" КОНЕЦ)КАК СтрокаИнформирования
    |ИЗ
	|	ВТ_ДанныеСНекорректнойКалькуляцией КАК ВТ_ДанныеСНекорректнойКалькуляцией";
	//ДИТ, Беляев СЮ, US 61000/TA 61002, 20-12-2022, конец
	//проверка наличия колонки "ВидТранспортногоСообщения", может быть пустой при вызове из формы "ФормаПодбораКоносамента"
	Если СвязьУчетныхЕдиницДляПроверки.Колонки.Найти("ВидТранспортногоСообщения") = Неопределено Тогда
		СвязьУчетныхЕдиницДляПроверки.Колонки.Добавить("ВидТранспортногоСообщения", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыТранспортныхСообщений"));
	КонецЕсли;
	Запрос.УстановитьПараметр("СвязьУчетныхЕдиниц", СвязьУчетныхЕдиницДляПроверки);
	Запрос.УстановитьПараметр("ВидТранспортногоСообщения", Перечисления.ВидыТранспортныхСообщений.Море);
	Запрос.УстановитьПараметр("УслугаФрахт", ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьЗначениеКонстанты("УслугаФрахтаДляКалькуляции"));
	РезультатПакет = Запрос.ВыполнитьПакет();
	РезультатСтруктура = Новый Структура;
	//РезультатСтруктура.Вставить("ДанныеИРезультатПроверки",РезультатПакет[РезультатПакет.Количество()-2].Выгрузить());
	//РезультатСтруктура.Вставить("МассивГУИДсНекорректнойКалькуляцией",РезультатПакет[РезультатПакет.Количество()-1].Выгрузить().ВыгрузитьКолонку("ГУИД"));
	//ДИТ, Беляев СЮ, US 61000/TA 61002, 20-12-2022, начало
	РезультатСтруктура.Вставить("ДанныеИРезультатПроверки",РезультатПакет[РезультатПакет.Количество()-3].Выгрузить());
	РезультатСтруктура.Вставить("ТаблицаДанныхСНекорректнойКалькуляцией",РезультатПакет[РезультатПакет.Количество()-1].Выгрузить());
	//ДИТ, Беляев СЮ, US 61000/TA 61002, 20-12-2022, клнец   
	//Евросиб - АСуслов 29.08.2023 13:54:16 #73836
	//(
	РезультатСтруктура.Вставить("МассивКалькуляцийПсевдофрахта", РезультатПакет[РезультатПакет.Количество()-4].Выгрузить().ВыгрузитьКолонку("Калькуляция"));
	//)
	//Евросиб - АСуслов 29.08.2023 13:54:22 #73836
	Возврат РезультатСтруктура; 
	
КонецФункции
