//ДИТ, Беляев СЮ, Ticket#0343311, 28-02-2024, начало
Функция РезультатЗапросаОпределенияОтветственныхЗаУчет(Объект, ДобавленныеСтроки = Неопределено)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЧСвязьУчетныхЕдиниц.ГУИД КАК ГУИД,
		|	ТЧСвязьУчетныхЕдиниц.Заявка КАК Заявка,
		|	ТЧСвязьУчетныхЕдиниц.Договор КАК Договор,
		|	ТЧСвязьУчетныхЕдиниц.ОтветственныйЗаУчет КАК ОтветственныйЗаУчет,
		|	ТЧСвязьУчетныхЕдиниц.Клиент КАК Клиент
		|ПОМЕСТИТЬ ВТСвязьУчетныхЕдиниц
		|ИЗ
		|	Документ.Сделка.СвязьУчетныхЕдиниц КАК ТЧСвязьУчетныхЕдиниц
		|ГДЕ
		|	1 = 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДоговорыКонтрагентовОтветственные.Ссылка КАК Договор,
		|	ДоговорыКонтрагентовОтветственные.Ответственный КАК ДоговорОтветственныйЗаУчет,
		|	ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка) КАК ДоговорОтветственныйЗаУчетНСК
		|ПОМЕСТИТЬ ВТ_Ответственные
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов.Ответственные КАК ДоговорыКонтрагентовОтветственные
		|ГДЕ
		|	ДоговорыКонтрагентовОтветственные.Ссылка В
		|			(ВЫБРАТЬ
		|				ВТСвязьУчетныхЕдиниц.Договор КАК Договор
		|			ИЗ
		|				ВТСвязьУчетныхЕдиниц КАК ВТСвязьУчетныхЕдиниц)
		|	И ДоговорыКонтрагентовОтветственные.ЦФО = ЗНАЧЕНИЕ(Справочник.ЦентрыФинансовойОтветственности.ОсновнойЦФО)
		|	И ДоговорыКонтрагентовОтветственные.ТипОтветственного = ЗНАЧЕНИЕ(Перечисление.ТипыОтветственных.ОтветственныйЗаУчет)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДоговорыКонтрагентовОтветственные.Ссылка,
		|	ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка),
		|	ДоговорыКонтрагентовОтветственные.Ответственный
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов.Ответственные КАК ДоговорыКонтрагентовОтветственные
		|ГДЕ
		|	ДоговорыКонтрагентовОтветственные.Ссылка В
		|			(ВЫБРАТЬ
		|				ВТСвязьУчетныхЕдиниц.Договор КАК Договор
		|			ИЗ
		|				ВТСвязьУчетныхЕдиниц КАК ВТСвязьУчетныхЕдиниц)
		|	И ДоговорыКонтрагентовОтветственные.ЦФО = ЗНАЧЕНИЕ(Справочник.ЦентрыФинансовойОтветственности.ТерминалНовосибирск)
		|	И ДоговорыКонтрагентовОтветственные.ТипОтветственного = ЗНАЧЕНИЕ(Перечисление.ТипыОтветственных.ОтветственныйЗаУчет)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Ответственные.Договор КАК Договор,
		|	МАКСИМУМ(ВТ_Ответственные.ДоговорОтветственныйЗаУчет) КАК ДоговорОтветственныйЗаУчет,
		|	МАКСИМУМ(ВТ_Ответственные.ДоговорОтветственныйЗаУчетНСК) КАК ДоговорОтветственныйЗаУчетНСК
		|ПОМЕСТИТЬ ВТ_ОтветственныеПолноеСоединение
		|ИЗ
		|	ВТ_Ответственные КАК ВТ_Ответственные
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Ответственные.Договор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ОтветственныеПолноеСоединение.ДоговорОтветственныйЗаУчет КАК ДоговорОтветственныйЗаУчет,
		|	ВТ_ОтветственныеПолноеСоединение.ДоговорОтветственныйЗаУчетНСК КАК ДоговорОтветственныйЗаУчетНСК,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТСвязьУчетныхЕдиниц.Заявка.ЦФО, ЗНАЧЕНИЕ(Справочник.ЦентрыФинансовойОтветственности.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.ЦентрыФинансовойОтветственности.ПустаяСсылка)
		|			ТОГДА ВТСвязьУчетныхЕдиниц.Заявка.ЦФО
		|		ИНАЧЕ &ЦФОСделки
		|	КОНЕЦ КАК ЦФОдляОпределенияОтветственного,
		|	ВТСвязьУчетныхЕдиниц.ГУИД КАК ГУИД,
		|	ВТСвязьУчетныхЕдиниц.Клиент КАК Клиент
		|ПОМЕСТИТЬ ВТОтветственныеИЦФО
		|ИЗ
		|	ВТСвязьУчетныхЕдиниц КАК ВТСвязьУчетныхЕдиниц
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОтветственныеПолноеСоединение КАК ВТ_ОтветственныеПолноеСоединение
		|		ПО ВТСвязьУчетныхЕдиниц.Договор = ВТ_ОтветственныеПолноеСоединение.Договор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТОтветственныеИЦФО.ГУИД КАК ГУИД,
		|	ВЫБОР
		|		КОГДА ВТОтветственныеИЦФО.ЦФОдляОпределенияОтветственного = ЗНАЧЕНИЕ(Справочник.ЦентрыФинансовойОтветственности.ОсновнойЦФО)
		|				ИЛИ ВТОтветственныеИЦФО.ЦФОдляОпределенияОтветственного = ЗНАЧЕНИЕ(Справочник.ЦентрыФинансовойОтветственности.ПустаяСсылка)
		|			ТОГДА ВТОтветственныеИЦФО.ДоговорОтветственныйЗаУчет
		|		ИНАЧЕ ВТОтветственныеИЦФО.ДоговорОтветственныйЗаУчетНСК
		|	КОНЕЦ КАК ОтветственныйЗаУчет,
		|	ВТСвязьУчетныхЕдиниц.ОтветственныйЗаУчет КАК ОтветственныйЗаУчетВСУЕ,
		|	ВТСвязьУчетныхЕдиниц.Клиент КАК Клиент,
		|	ВТСвязьУчетныхЕдиниц.Договор КАК Договор
		|ПОМЕСТИТЬ ВТОтветственныеИГУИДСтрок
		|ИЗ
		|	ВТОтветственныеИЦФО КАК ВТОтветственныеИЦФО
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСвязьУчетныхЕдиниц КАК ВТСвязьУчетныхЕдиниц
		|		ПО (ВТСвязьУчетныхЕдиниц.ГУИД = ВТОтветственныеИЦФО.ГУИД)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТОтветственныеИГУИДСтрок.Клиент КАК Клиент
		|ИЗ
		|	ВТОтветственныеИГУИДСтрок КАК ВТОтветственныеИГУИДСтрок
		|ГДЕ
		|	НЕ ВТОтветственныеИГУИДСтрок.Клиент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|	И НЕ ВТОтветственныеИГУИДСтрок.Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
		|	И ЕСТЬNULL(ВТОтветственныеИГУИДСтрок.ОтветственныйЗаУчет, ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТОтветственныеИГУИДСтрок.ОтветственныйЗаУчет КАК ОтветственныйЗаУчет
		|ИЗ
		|	ВТОтветственныеИГУИДСтрок КАК ВТОтветственныеИГУИДСтрок
		|ГДЕ
		|	НЕ ВТОтветственныеИГУИДСтрок.Клиент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|	И НЕ ВТОтветственныеИГУИДСтрок.Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
		|	И ВТОтветственныеИГУИДСтрок.ОтветственныйЗаУчет.Недействителен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТОтветственныеИГУИДСтрок.ГУИД КАК ГУИД,
		|	ВЫБОР
		|		КОГДА ВТОтветственныеИГУИДСтрок.ОтветственныйЗаУчет.Недействителен
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
		|		ИНАЧЕ ВТОтветственныеИГУИДСтрок.ОтветственныйЗаУчет
		|	КОНЕЦ КАК ОтветственныйЗаУчетПоДоговору,
		|	ВТОтветственныеИГУИДСтрок.ОтветственныйЗаУчет.НепосредственныйРуководитель КАК НепосредственныйРуководительНеактуальногоОтветственного,
		|	ВТОтветственныеИГУИДСтрок.ОтветственныйЗаУчетВСУЕ.НепосредственныйРуководитель КАК РуководительНедействительногоОтветственногоЗаУчетВСУЕ
		|ИЗ
		|	ВТОтветственныеИГУИДСтрок КАК ВТОтветственныеИГУИДСтрок
		|ГДЕ
		|	(ЕСТЬNULL(ВТОтветственныеИГУИДСтрок.ОтветственныйЗаУчет.Недействителен, ИСТИНА) = ЛОЖЬ
		|			ИЛИ ЕСТЬNULL(ВТОтветственныеИГУИДСтрок.ОтветственныйЗаУчет.НепосредственныйРуководитель.Недействителен, ИСТИНА) = ЛОЖЬ
		|			ИЛИ ВТОтветственныеИГУИДСтрок.ОтветственныйЗаУчетВСУЕ.Недействителен
		|				И ВТОтветственныеИГУИДСтрок.ОтветственныйЗаУчетВСУЕ.НепосредственныйРуководитель <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка))";
	
	Если ДобавленныеСтроки <> Неопределено Тогда  
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1", "ТЧСвязьУчетныхЕдиниц.ГУИД В (&ДобавленныеСтроки)");
		Запрос.УстановитьПараметр("ДобавленныеСтроки", ДобавленныеСтроки);	
	КонецЕсли;   
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Сделка.СвязьУчетныхЕдиниц", "&ТЧСвязьУчетныхЕдиниц");                       
	Запрос.УстановитьПараметр("ТЧСвязьУчетныхЕдиниц", Объект.СвязьУчетныхЕдиниц.Выгрузить(,"ГУИД,Заявка,Договор,ОтветственныйЗаУчет,Клиент"));
	Запрос.УстановитьПараметр("ЦФОСделки", Объект.ЦФО);
	РезультатЗапросаПакет = Запрос.ВыполнитьПакет();
	Возврат РезультатЗапросаПакет;
КонецФункции
