Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	Если РольДоступна("dc_ИзменитьПредставлениеДокументов") Тогда
		СтандартнаяОбработка = Ложь;
		Поля = Новый Массив;
		Поля.Добавить("СтанцияОтправления");
		Поля.Добавить("СтанцияНазначения");
		Поля.Добавить("Номер");
		Поля.Добавить("Дата");
		Поля.Добавить("ЖДОтправка");
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	Если РольДоступна("dc_ИзменитьПредставлениеДокументов") Тогда
		СтандартнаяОбработка = Ложь;
		Представление ="Сделка "+
		ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Данные.Номер)+"/"+Формат(Данные.Дата,"ДФ=yyyy")+" "+
		Данные.СтанцияОтправления.Наименование+"-"+Данные.СтанцияНазначения.Наименование+ " от "+
		Формат(Данные.ЖДОтправка,"ДФ=dd.MM.yyyy");
	КонецЕсли;

КонецПроцедуры
