	//|	э_НакладнаяГрузыЖД.НаименованиеГруза,
	//|	э_НакладнаяГрузыЖД.КодЕТСНГ,
	//|	ТранспортныйДокумент.Ссылка,
	//|	Грузы.Ссылка";
	
	//ДИТ, Беляев СЮ, Ticket#0342972, 28-02-2024, начало
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТранспортныйДокумент.Ссылка КАК ЖДН,
	|	э_НакладнаяГрузыЖД.КодЕТСНГ КАК КодЕТСНГ,
	|	э_НакладнаяГрузыЖД.КодГНГ КАК КодГНГ,
	|	э_НакладнаяГрузыЖД.НаименованиеГруза КАК НаименованиеГруза,
	|	СУММА(э_НакладнаяГрузыЖД.МассаГруза) КАК МассаГрузаКг
	|ПОМЕСТИТЬ ВТГрузыНакладных
	|ИЗ
	|	Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.э_Накладная.ГрузыЖД КАК э_НакладнаяГрузыЖД
	|		ПО ТранспортныйДокумент.НакладнаяЭТРАН = э_НакладнаяГрузыЖД.Ссылка
	|ГДЕ
	|	ТранспортныйДокумент.Ссылка В(&ЖДН)
	|
	|СГРУППИРОВАТЬ ПО
	|	э_НакладнаяГрузыЖД.КодГНГ,
	|	э_НакладнаяГрузыЖД.НаименованиеГруза,
	|	э_НакладнаяГрузыЖД.КодЕТСНГ,
	|	ТранспортныйДокумент.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТГрузыНакладных.КодЕТСНГ КАК КодЕТСНГ,
	|	МАКСИМУМ(Грузы.Ссылка) КАК ГрузСсылка
	|ПОМЕСТИТЬ ВТГрузыИзСправочника
	|ИЗ
	|	ВТГрузыНакладных КАК ВТГрузыНакладных
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Грузы КАК Грузы
	|		ПО (ПОДСТРОКА(ВТГрузыНакладных.КодЕТСНГ, 1, 5) = ПОДСТРОКА(Грузы.ЕТСНГ, 1, 5))
	|			И (НЕ Грузы.ПометкаУдаления)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТГрузыНакладных.КодЕТСНГ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТГрузыНакладных.ЖДН КАК ЖДН,
	|	ВТГрузыНакладных.КодЕТСНГ КАК КодЕТСНГ,
	|	ВТГрузыНакладных.КодГНГ КАК КодГНГ,
	|	ВТГрузыНакладных.НаименованиеГруза КАК НаименованиеГруза,
	|	ВТГрузыНакладных.МассаГрузаКг КАК МассаГрузаКг,
	|	ВТГрузыИзСправочника.ГрузСсылка КАК Груз
	|ИЗ
	|	ВТГрузыНакладных КАК ВТГрузыНакладных
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТГрузыИзСправочника КАК ВТГрузыИзСправочника
	|		ПО ВТГрузыНакладных.КодЕТСНГ = ВТГрузыИзСправочника.КодЕТСНГ";
	//ДИТ, Беляев СЮ, Ticket#0342972, 28-02-2024, конец
	
	ТаблицаЖДН = СвязьУчетныхЕдиниц.Выгрузить(, "ЖДН");
	ТаблицаЖДН.Свернуть("ЖДН");
	Запрос.УстановитьПараметр("ЖДН", ТаблицаЖДН.ВыгрузитьКолонку("ЖДН"));	
	ТаблицаГрузовЖДН = Запрос.Выполнить().Выгрузить();
	
	Для каждого Стр из СвязьУчетныхЕдиниц Цикл
		
		Если (НЕ ЗначениеЗаполнено(Стр.Груз) Или Не ЗначениеЗаполнено(Стр.ВесГрузаНетто)) И ЗначениеЗаполнено(Стр.ЖДН) Тогда
			
			// Евросиб Фролов (15.04.2022 Task №48577
			Если ДобавленныеСтроки <> Неопределено Тогда
				Если ДобавленныеСтроки.Найти(Стр.ГУИД) = Неопределено Тогда
					Продолжить;
				КонецЕсли;	
			КонецЕсли;	
			// Евросиб Фролов)
			
			ГрузыПоЖДН = ТаблицаГрузовЖДН.НайтиСтроки(Новый Структура("ЖДН", Стр.ЖДН));
			КоличествоСтрокГрузов = ГрузыПоЖДН.Количество();
			
			Если КоличествоСтрокГрузов = 1 Тогда
				
				ГрузПоЖДН = ГрузыПоЖДН[0];
				
				Если Не ЗначениеЗаполнено(Стр.Груз) Тогда
					Если ЗначениеЗаполнено(ГрузПоЖДН.Груз) Тогда
						Стр.Груз = ГрузПоЖДН.Груз;
					Иначе
						Стр.Груз = Справочники.Грузы.НайтиСоздатьГруз(ГрузПоЖДН.НаименованиеГруза, ГрузПоЖДН.КодЕТСНГ, ГрузПоЖДН.КодГНГ);
					КонецЕсли;
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(Стр.ВесГрузаНетто) Тогда
					Стр.ВесГрузаНетто = ГрузПоЖДН.МассаГрузаКг;
				КонецЕсли;
				
			ИначеЕсли КоличествоСтрокГрузов > 1 Тогда
				
				Если Не ЗначениеЗаполнено(Стр.Груз) Тогда
					Стр.Груз = Справочники.Грузы.НайтиПоРеквизиту("ЕТСНГ", "693231");
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(Стр.ВесГрузаНетто) Тогда
					
					ВесГрузаПоЖДН = 0;
					Для каждого ГрузПоЖДН Из ГрузыПоЖДН Цикл					
						ВесГрузаПоЖДН = ВесГрузаПоЖДН + ГрузПоЖДН.МассаГрузаКг;					
					КонецЦикла;
					
					Стр.ВесГрузаНетто = ВесГрузаПоЖДН;
					
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
		Груженый = Стр.ВесГрузаНетто > 0;
		Если Груженый <> Стр.Груженый Тогда
			Стр.Груженый = Груженый;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Евросиб Фролов (24.03.2022 US №40767, Task №40768
Функция ПолучитьКТКСРасходамиИзДругойСделки(МассивИдентификаторов, ОбъектСделка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СделкаРасходы.СтрокаСвязьУчетныхЕдиниц КАК СтрокаСвязьУчетныхЕдиниц
	|ПОМЕСТИТЬ втРасходы
	|ИЗ
	|	&Расходы КАК СделкаРасходы
	|ГДЕ
	|	СделкаРасходы.ПеренесеннаяСделка <> ЗНАЧЕНИЕ(Документ.Сделка.ПустаяСсылка)
	|	И (СделкаРасходы.СтрокаРасходовВПеренесеннойСделке <> """" 
	//Евросиб - АСуслов 15.12.2022 16:49:29 #62448
	//(
	|  ИЛИ СделкаРасходы.СтрокаРасходовВСделкеИсточник <> """")
	//)
	//Евросиб - АСуслов 15.12.2022 16:49:31 #62448
	|	И СделкаРасходы.СтрокаСвязьУчетныхЕдиниц В(&СтрокаСвязьУчетныхЕдиниц)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	втРасходы.СтрокаСвязьУчетныхЕдиниц КАК СтрокаСвязьУчетныхЕдиниц
	|ИЗ
	|	втРасходы КАК втРасходы";
	
	Запрос.УстановитьПараметр("Расходы", ОбъектСделка.Расходы.Выгрузить());
	Запрос.УстановитьПараметр("СтрокаСвязьУчетныхЕдиниц", МассивИдентификаторов);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("СтрокаСвязьУчетныхЕдиниц");

КонецФункции	
