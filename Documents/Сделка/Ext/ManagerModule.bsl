Процедура УстановитьГотовоКВыставлению(СделкаОбъект) Экспорт
	
	Если СделкаОбъект.ПодсылПорожних Тогда
		Возврат;
	КонецЕсли;
	
	Если СделкаОбъект.Дата < Дата(2024,08,01,0,0,0) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	//Евросиб(ДИТ), Беляев СЮ, US 90567 / TA 91744, 16-09-2024, начало
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Рейсы.Рейс КАК Рейс
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Документ.Сделка.Рейсы КАК Рейсы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Рейс КАК Рейс
	|ИЗ
	|	ВТ КАК ВТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РейсыЖД КАК РейсыЖД
	|		ПО ВТ.Рейс = РейсыЖД.Ссылка
	|			И (РейсыЖД.Ссылка <> ЗНАЧЕНИЕ(Справочник.РейсыЖД.БезРейса))";
	
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "Документ.Сделка.Рейсы", "&Рейсы");
	Запрос.УстановитьПараметр("Рейсы", СделкаОбъект.Рейсы.Выгрузить());
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	//Евросиб(ДИТ), Беляев СЮ, US 90567 / TA 91744, 16-09-2024, конец
	
	МассивУсловийПеревозкиНазначение = Новый Массив;
	МассивУсловийПеревозкиНазначение.Добавить(Перечисления.УсловияПеревозкиКТК.CY);
	МассивУсловийПеревозкиНазначение.Добавить(Перечисления.УсловияПеревозкиКТК.FOR);	
	
	//ТекстЗапроса = 
	//"ВЫБРАТЬ
	//|	СвязьУчетныхЕдиниц.Клиент КАК Клиент,
	//|	СвязьУчетныхЕдиниц.УсловияПеревозки КАК УсловияПеревозки,
	//|	СвязьУчетныхЕдиниц.УсловияПеревозкиНазначение КАК УсловияПеревозкиНазначение,
	//|	СвязьУчетныхЕдиниц.Калькуляция КАК Калькуляция,
	//|	СвязьУчетныхЕдиниц.ОтключитьРасходы КАК ОтключитьРасходы,
	//|	СвязьУчетныхЕдиниц.ГотовоКВыставлению КАК ГотовоКВыставлению
	//|ПОМЕСТИТЬ ВТ
	//|ИЗ
	//|	Документ.Сделка.СвязьУчетныхЕдиниц КАК СвязьУчетныхЕдиниц
	//|;
	//|
	//|////////////////////////////////////////////////////////////////////////////////
	//|ВЫБРАТЬ РАЗЛИЧНЫЕ
	//|	ВТ.Клиент КАК Клиент,
	//|	ВТ.УсловияПеревозки КАК УсловияПеревозки,
	//|	ВТ.УсловияПеревозкиНазначение КАК УсловияПеревозкиНазначение,
	//|	ВТ.Калькуляция КАК Калькуляция
	//|ИЗ
	//|	ВТ КАК ВТ
	//|ГДЕ
	//|	НЕ ВТ.ОтключитьРасходы
	//|	И НЕ ВТ.ГотовоКВыставлению
	//|	И ВТ.УсловияПеревозки = &УсловиеПеревозкиОтправления
	//|	И ВТ.УсловияПеревозкиНазначение В(&МассивУсловийПеревозкиНазначение)
	//|	И ВТ.Клиент.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	//|	И ВТ.Калькуляция.ПС_ВидПеревозки = &ВидПеревозки";
	//
