Функция ПСЦУспешноСогласован(Заявка)
	
	МассивЗавершенныхСтатусовПСЦ = Новый Массив;
	МассивЗавершенныхСтатусовПСЦ.Добавить(Перечисления.СтатусыСогласования.Подписано);
	МассивЗавершенныхСтатусовПСЦ.Добавить(Перечисления.СтатусыСогласования.СогласованоБезЗамечаний);
	МассивЗавершенныхСтатусовПСЦ.Добавить(Перечисления.СтатусыСогласования.СогласованСКомментариями);
	
	Возврат МассивЗавершенныхСтатусовПСЦ.Найти(Заявка.ПСЦ.СтатусДокумента) <> неопределено; 
	
КонецФункции

Функция ПолучитьСуммуДопУслугКалькуляции(Калькуляция, ТипКТК)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               //|	СУММА(КалькуляцияЖД_УслугиВнеСтавки.Ставка" + ТипКТК + ") КАК Ставка
				   //ДИТ, Беляев СЮ, Ticket#0291266, 10-11-2022, начало
				   |ЕстьNULL(СУММА(КалькуляцияЖД_УслугиВнеСтавки.Ставка" + ТипКТК + "),0) КАК Ставка
				   //ДИТ, Беляев СЮ, Ticket#0291266, 10-11-2022, конец
	               |ИЗ
	               |	Документ.Калькуляция.ЖД_УслугиВнеСтавки КАК КалькуляцияЖД_УслугиВнеСтавки
	               |ГДЕ
	               |	КалькуляцияЖД_УслугиВнеСтавки.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Калькуляция);
	
	Возврат Запрос.Выполнить().Выгрузить()[0].Ставка;

