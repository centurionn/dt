//ДИТ, Беляев СЮ, Ticket#0318556, 04-08-2023, начало
Процедура ЗаполнитьТекстОповещенияПриПометкеСтрок(Знач ВыборкаСтрокДляПроверки, ТекстОповещения)
	
	СписокПроверяемыхРеквизитов = Новый Соответствие;
	СписокПроверяемыхРеквизитов.Вставить("Дата выдачи груза", ЗначениеЗаполнено(ВыборкаСтрокДляПроверки.ДатаВыдачиАвто));
	СписокПроверяемыхРеквизитов.Вставить("Дата раскредитации", ЗначениеЗаполнено(ВыборкаСтрокДляПроверки.ДатаРаскредитации));
	СписокПроверяемыхРеквизитов.Вставить("Дата прибытия", ЗначениеЗаполнено(ВыборкаСтрокДляПроверки.ДатаПрибытия));
	СписокПроверяемыхРеквизитов.Вставить("Дата отправления", ЗначениеЗаполнено(ВыборкаСтрокДляПроверки.ДатаОтправления));
	СписокПроверяемыхРеквизитов.Вставить("ЖДН", ВыборкаСтрокДляПроверки.ЗаполненаГруженаяЖДН);
	СтрокаТекстаОповещения = "";
	Для Каждого ЗначениеПроверки Из СписокПроверяемыхРеквизитов Цикл
		Если НЕ ЗначениеПроверки.Значение Тогда
			СтрокаТекстаОповещения = СтрокаТекстаОповещения + ЗначениеПроверки.Ключ + ", ";
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(СтрокаТекстаОповещения) Тогда
		ТекстОповещения = ТекстОповещения 
		+ СтрШаблон("строка %1: %2", ВыборкаСтрокДляПроверки.НомерСтроки, СтрокаТекстаОповещения)
		+ Символы.ПС;
	КонецЕсли;

КонецПроцедуры
