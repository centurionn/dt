
&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	ТЧОтправки.Очистить();
	ТЧПлательщики.Очистить();
	
	ТекД = Элементы.Список.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьДочерниеТаблицы(ТекД);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДочерниеТаблицы(ТекД)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИсходящаяТелеграммаТЧ_Отправки.Ссылка КАК Ссылка,
	               |	ИсходящаяТелеграммаТЧ_Отправки.НомерСтроки КАК НомерСтроки,
	               |	ИсходящаяТелеграммаТЧ_Отправки.ГрузЕТСНГ КАК ГрузЕТСНГ,
	               |	ИсходящаяТелеграммаТЧ_Отправки.ГрузГНГ КАК ГрузГНГ,
	               |	ИсходящаяТелеграммаТЧ_Отправки.ВидОтправки КАК ВидОтправки,
	               |	ИсходящаяТелеграммаТЧ_Отправки.ПринадлежностьВагонаКТК КАК ПринадлежностьВагонаКТК,
	               |	ИсходящаяТелеграммаТЧ_Отправки.КоличествоВагоновКТК КАК КоличествоВагоновКТК,
	               |	ИсходящаяТелеграммаТЧ_Отправки.ВесТонны КАК ВесТонны,
	               |	ИсходящаяТелеграммаТЧ_Отправки.СтранаНазначения КАК СтранаНазначения,
	               |	ИсходящаяТелеграммаТЧ_Отправки.СтанцияНазначения КАК СтанцияНазначения,
	               |	ИсходящаяТелеграммаТЧ_Отправки.Порт КАК Порт,
	               |	ИсходящаяТелеграммаТЧ_Отправки.СтанцияВыходаИзРФ КАК СтанцияВыходаИзРФ,
	               |	ИсходящаяТелеграммаТЧ_Отправки.СтанцияВходаВыходаКЛГ КАК СтанцияВходаВыходаКЛГ,
	               |	ИсходящаяТелеграммаТЧ_Отправки.СтанцияВходаВыходаРЖД КАК СтанцияВходаВыходаРЖД,
	               |	ИсходящаяТелеграммаТЧ_Отправки.Грузополучатель КАК Грузополучатель,
	               |	ИсходящаяТелеграммаТЧ_Отправки.ФактическаяСуммаПоОтправке КАК ФактическаяСуммаПоОтправке,
	               |	ИсходящаяТелеграммаТЧ_Отправки.Валюта КАК Валюта
	               |ИЗ
	               |	Документ.ИсходящаяТелеграмма.ТЧ_Отправки КАК ИсходящаяТелеграммаТЧ_Отправки
	               |ГДЕ
	               |	ИсходящаяТелеграммаТЧ_Отправки.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",ТекД.Ссылка);
	ТЧОтправки.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИсходящаяТелеграммаТЧ_Плательщики.Ссылка КАК Ссылка,
	               |	ИсходящаяТелеграммаТЧ_Плательщики.НомерСтроки КАК НомерСтроки,
	               |	ИсходящаяТелеграммаТЧ_Плательщики.Плательщик КАК Плательщик,
	               |	ИсходящаяТелеграммаТЧ_Плательщики.ОКПО КАК ОКПО,
	               |	ИсходящаяТелеграммаТЧ_Плательщики.Страна КАК Страна
	               |ИЗ
	               |	Документ.ИсходящаяТелеграмма.ТЧ_Плательщики КАК ИсходящаяТелеграммаТЧ_Плательщики
	               |ГДЕ
	               |	ИсходящаяТелеграммаТЧ_Плательщики.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",ТекД.Ссылка);
	ТЧПлательщики.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаКлиенте
Процедура Поиск(Команда)
	
	Если НЕ ОтборСтатус = 0 ТОгда
		Если ОтборСтатус = 1 Тогда
			ЗначОтбора = ПредопределенноеЗначение("Перечисление.СтатусыИсходящихТелеграмм.Оформлена");
		ИначеЕсли ОтборСтатус = 2 Тогда
			ЗначОтбора = ПредопределенноеЗначение("Перечисление.СтатусыИсходящихТелеграмм.Создана");
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Статус", ЗначОтбора, ВидСравненияКомпоновкиДанных.Равно);
	Иначе
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Список, "Статус");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборКлиент) ТОгда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Клиент", ОтборКлиент, ВидСравненияКомпоновкиДанных.Равно);
	Иначе
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Список, "Клиент");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборОтветственный) ТОгда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Ответственный", ОтборОтветственный, ВидСравненияКомпоновкиДанных.Равно);
	Иначе
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Список, "Ответственный");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПериодПеревозки.ДатаНачала) ТОгда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ДатаНачалаПеревозки", ПериодПеревозки.ДатаНачала, ВидСравненияКомпоновкиДанных.БольшеИлиРавно);
	Иначе
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Список, "ДатаНачалаПеревозки");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПериодПеревозки.ДатаОкончания) ТОгда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ДатаОкончанияПеревозки", ПериодПеревозки.ДатаОкончания, ВидСравненияКомпоновкиДанных.МеньшеИлиРавно);
	Иначе
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Список, "ДатаОкончанияПеревозки");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПериодСоздания.ДатаНачала) ТОгда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ДатаНачалаПеревозки", ПериодСоздания.ДатаНачала, ВидСравненияКомпоновкиДанных.БольшеИлиРавно);
	Иначе
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Список, "ДатаНачалаПеревозки");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПериодСоздания.ДатаОкончания) ТОгда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ДатаОкончанияПеревозки", ПериодСоздания.ДатаОкончания, ВидСравненияКомпоновкиДанных.МеньшеИлиРавно);
	Иначе
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Список, "ДатаОкончанияПеревозки");
	КонецЕсли;
	
	
КонецПроцедуры

