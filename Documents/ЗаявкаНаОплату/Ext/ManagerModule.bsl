//Функция ПолучитьСуществующуюЗаявкуПоДокументу(ДокументОснование) Экспорт
Функция ПолучитьСуществующуюЗаявкуПоДокументу(ДокументОснование, Ставка = Неопределено) Экспорт
//Евросиб СубботинВ #102528 09.04.2025 Конец
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаявкаНаОплатуДокументыНаОплату.Ссылка КАК Ссылка,
	|	ЗаявкаНаОплатуДокументыНаОплату.Ссылка.Дата КАК Дата
	|ПОМЕСТИТЬ ВТ_Документы
	|ИЗ
	|	Документ.ЗаявкаНаОплату.ДокументыНаОплату КАК ЗаявкаНаОплатуДокументыНаОплату
	|ГДЕ
	|	ЗаявкаНаОплатуДокументыНаОплату.ОснованиеДляПлатежа В(&ОснованиеДляПлатежа)
	|	И ЗаявкаНаОплатуДокументыНаОплату.Ссылка.Проведен
	|	И &СтавкаНДС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтатусыОбъектовСрезПоследних.Объект КАК Объект
	|ПОМЕСТИТЬ ВТ_Статусы
	|ИЗ
	|	РегистрСведений.СтатусыОбъектов.СрезПоследних(
	|			,
	|			Объект В
	|				(ВЫБРАТЬ
	|					ВТ_Документы.Ссылка КАК Ссылка
	|				ИЗ
	|					ВТ_Документы КАК ВТ_Документы)) КАК СтатусыОбъектовСрезПоследних
	|ГДЕ
	|	СтатусыОбъектовСрезПоследних.Статус = &Статус
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ_Документы.Ссылка КАК Ссылка,
	|	ВТ_Документы.Дата КАК Дата
	|ИЗ
	|	ВТ_Документы КАК ВТ_Документы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Статусы КАК ВТ_Статусы
	|		ПО ВТ_Документы.Ссылка = ВТ_Статусы.Объект
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ"; 
	
	//Евросиб СубботинВ #102528 09.04.2025 Начало 
	ДокументыОснования = Новый Массив;
	Если ТипЗнч(ДокументОснование) = Тип("Массив") Тогда
		Для Каждого СтрокаМассива из  ДокументОснование Цикл
			ДокументыОснования.Добавить(СтрокаМассива.ОснованиеДляПлатежа);
		КонецЦикла;
	Иначе
		ДокументыОснования.Добавить(ДокументОснование);		
	КонецЕсли;	
	Запрос.УстановитьПараметр("Статус", Справочники.СтатусыДокументов.Подготовлена);
	Запрос.УстановитьПараметр("ОснованиеДляПлатежа", ДокументыОснования);
	Если НЕ Ставка = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&СтавкаНДС", "ЗаявкаНаОплатуДокументыНаОплату.СтавкаНДС = &СтавкаНДС");
		Запрос.УстановитьПараметр("СтавкаНДС", Ставка);
	Иначе
		Запрос.УстановитьПараметр("СтавкаНДС", Истина); 
	КонецЕсли;
	//Евросиб СубботинВ #102528 09.04.2025 Конец
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;               
	ВыборкаРезультатаЗапроса = РезультатЗапроса.Выбрать();
	ВыборкаРезультатаЗапроса.Следующий();
	Возврат ВыборкаРезультатаЗапроса.Ссылка;
	
КонецФункции

Функция ПолучитьПараметрыМаршрутизации(Объект) Экспорт
	
	ПараметрыЗапроса = Новый Соответствие;
	ПараметрыЗапроса.Вставить("Организация", Объект.Организация);
	Возврат ПараметрыЗапроса;
	
КонецФункции

// Евросиб(ДИТ) US 73033 ТА 87495 Сержантова А.С. 12.07.2024
Функция ПроверитьОплаченнуюЗаявкуПоДокументуОснованию(ДокументОснование) Экспорт
	
	РезультатПроверки = Новый Структура("ОплаченнаяЗаявка", Неопределено);

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ Различные
	|	ЗаявкаНаОплатуДокументыНаОплату.Ссылка КАК ЗаявкаНаОплату
	|ИЗ
	|	Документ.ЗаявкаНаОплату.ДокументыНаОплату КАК ЗаявкаНаОплатуДокументыНаОплату
	|ГДЕ
	|	ЗаявкаНаОплатуДокументыНаОплату.ОснованиеДляПлатежа = &ОснованиеДляПлатежа";
	Запрос.УстановитьПараметр("ОснованиеДляПлатежа", ДокументОснование);
	РезультатЗапроса = Запрос.Выполнить();
	Если не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		ЕстьОплаченнаяЗаявка = ложь;
		Пока Выборка.Следующий() Цикл
			РеквизитыИзУПП = РегистрыСведений.ПротоколОбменов.ПроверитьВыгрузку(Выборка.ЗаявкаНаОплату, Перечисления.УзлыОбмена.УПП, 
																				Перечисления.ДействияПриОбмене.ВыгрузкаДанных);
			Если ЗначениеЗаполнено(РеквизитыИзУПП.ДатаОплатыБУ) Тогда
				РезультатПроверки.ОплаченнаяЗаявка = Выборка.ЗаявкаНаОплату;
				Прервать;
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли; 
	Возврат РезультатПроверки;
	
КонецФункции 

