Процедура ПерезаполнитьСтавкуНДСВДокументахОснования(ПараметрыПерезаполнения, АдресРезультата = Неопределено) Экспорт
	Попытка
		НачатьТранзакцию();		
		Для Каждого ДокументОснование Из ПараметрыПерезаполнения.МассивДокументовОснования Цикл
			Если ТипЗнч(ДокументОснование.ОснованиеДляПлатежа) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
				Продолжить;
			КонецЕсли;
			ДокументОснованиеОбъект = ДокументОснование.ОснованиеДляПлатежа.ПолучитьОбъект(); 
			СуммаДокументаДоИзменения = ДокументОснованиеОбъект.СуммаДокумента;
			Для Каждого СтрокаТовар Из ДокументОснованиеОбъект.Товары Цикл
				СтрокаТовар.СтавкаНДС =  ДокументОснование.СтавкаНДС;				
				//Евросиб СубботинВ #102528 21.07.2025 Начало
				БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.РассчитатьСуммуСтрокиТабличнойЧасти(СтрокаТовар);
				СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСуммуНДС(СтрокаТовар.Сумма, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(СтрокаТовар.СтавкаНДС),
																						ДокументОснованиеОбъект.УчитыватьНДС, ДокументОснованиеОбъект.СуммаВключаетНДС);
				СтрокаТовар.СуммаНДС = СуммаНДС;
				
				//Евросиб СубботинВ #102528 21.07.2025 Конец	
			КонецЦикла;
		
			//Евросиб СубботинВ #102528 21.07.2025 Начало
			ИтогоВсегоНДС = ?(ДокументОснованиеОбъект.Товары.Количество()>0, ДокументОснованиеОбъект.Товары.Итог("СуммаНДС"),0);
			ДокументОснованиеОбъект.СуммаДокумента = ?(ДокументОснованиеОбъект.Товары.Количество()>0, ДокументОснованиеОбъект.Товары.Итог("Сумма"),0)+?(ДокументОснованиеОбъект.СуммаВключаетНДС,0,ИтогоВсегоНДС);
			
			Если НЕ СуммаДокументаДоИзменения = ДокументОснованиеОбъект.СуммаДокумента Тогда
				ОбщегоНазначения.СообщитьПользователю("В связи с изменением ставки НДС изменена общая сумма документа:" + ДокументОснование.ОснованиеДляПлатежа);
			КонецЕсли;
			//Евросиб СубботинВ #102528 21.07.2025 Конец
			
			ДокументОснованиеОбъект.ДополнительныеСвойства.Вставить("ПерезаполнениеСтавкиНДСИзЗаявки", Истина);
			ДокументОснованиеОбъект.Записать(РежимЗаписиДокумента.Проведение);
			ДокументОснованиеОбъект.Движения.Записать();

		КонецЦикла; 
		//Евросиб СубботинВ #102528 21.07.2025 Начало
		Если НЕ ПараметрыПерезаполнения.СвязанныеЗаявкиНаИзменение = Неопределено и ПараметрыПерезаполнения.СвязанныеЗаявкиНаИзменение.Количество() > 0 Тогда 
			Для Каждого СвязаннаяЗаявка Из ПараметрыПерезаполнения.СвязанныеЗаявкиНаИзменение Цикл 
				СвязаннаяЗаявкаОбъект =  СвязаннаяЗаявка.Заявка.ПолучитьОбъект();
				Для Каждого СтрокаОснований из СвязаннаяЗаявка.МассивСтруктурОснований Цикл
					//Для Каждого Основание из СтавкаОснованияДляПлатежаКИзменению.МассивДокументовВРазрезеСтавок Цикл
						Для Каждого ДокументНаОплату из СвязаннаяЗаявкаОбъект.ДокументыНаОплату Цикл 
							Если НЕ ДокументНаОплату.ОснованиеДляПлатежа = СтрокаОснований.Основание Тогда
								Продолжить;
							КонецЕсли;	
							ДокументНаОплату.СтавкаНДС = СтрокаОснований.СтавкаНДС;					
							УчитыватьНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументНаОплату.ОснованиеДляПлатежа, "УчитыватьНДС");
							ДокументНаОплату.СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСуммуНДС(ДокументНаОплату.СуммаОплаты,
							БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(ДокументНаОплату.СтавкаНДС), УчитыватьНДС, Истина);					
						КонецЦикла;
					//КонецЦикла;
				КонецЦикла;
					СвязаннаяЗаявкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
			КонецЦикла;
		КонецЕсли;
		//Евросиб СубботинВ #102528 21.07.2025 Конец		
		ЗафиксироватьТранзакцию();

		СтруктураРезультата = Новый Структура; 
		СтруктураРезультата.Вставить("ЕстьРезультат", Истина);
		СтруктураРезультата.Вставить("РезультатПерезаполнения", "Документы перезаполнены");
		ПоместитьВоВременноеХранилище(СтруктураРезультата, АдресРезультата);
	Исключение
		ОО = ОписаниеОшибки();
		ОтменитьТранзакцию();                 
		СтруктураРезультата = Новый Структура;
		СтруктураРезультата.Вставить("ЕстьРезультат", Ложь);
		СтруктураРезультата.Вставить("РезультатПерезаполнения", ОО);
		ПоместитьВоВременноеХранилище(СтруктураРезультата, АдресРезультата);
	КонецПопытки;	
КонецПроцедуры  

