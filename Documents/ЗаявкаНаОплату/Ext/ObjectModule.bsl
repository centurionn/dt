Функция ПолучитьИдентификаторСтроки()
	ИдентификаторСтроки = 0;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	т.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ ВТ_ТаблицаОплат
	|ИЗ
	|	&ТаблицаОплат КАК т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(т.ИдентификаторСтроки) КАК ИдентификаторСтроки
	|ИЗ
	|	ВТ_ТаблицаОплат КАК т"; 
	Запрос.УстановитьПараметр("ТаблицаОплат", ДокументыНаОплату.Выгрузить());
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаРезультатаЗапроса = РезультатЗапроса.Выбрать();
		ВыборкаРезультатаЗапроса.Следующий();
		ИдентификаторСтроки = ВыборкаРезультатаЗапроса.ИдентификаторСтроки + 1;
	КонецЕсли;                                                                 
	Возврат ИдентификаторСтроки;
КонецФункции 

