
Процедура ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;  
	
	// Евросиб(ДИТ) US 73033 ТА 87495 Сержантова А.С. Начало: 18.07.2024   
	Если не Отказ и ДополнительныеСвойства.Свойство("ЗарегистрироватьДляОтправкиВУПП") Тогда
		ПланыОбмена.ВыгрузкаДанных.ЗарегистрироватьИзмененияПоДокументу(Ссылка, Перечисления.УзлыОбмена.УПП);
	КонецЕсли;
	// Евросиб(ДИТ) US 73033 ТА 87495 Сержантова А.С. Конец: 18.07.2024
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;  

	Редактор = Пользователи.ТекущийПользователь();
	Изменено = ТекущаяДата();  
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// проверяем корректность перечня состояний в ТЧ Состояния
	Если СогласованиеСервер.ЕстьДублиСостояний(Состояния.Выгрузить()) Тогда
		Сообщить("Ошибка: одно состояние может встречаться в документе только один раз!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	//Евросиб СубботинВ #89527 30.10.2024 Начало
	Если НЕ РольДоступна("ПолныеПрава") Тогда
		ПодразделениеАвтора = Справочники.Пользователи.ПолучитьГруппуДКППользователя(Автор);
		Если ПодразделениеАвтора = Справочники.ГруппыПользователей.ПустаяСсылка() тогда 
		//	или ПодразделениеАвтора = Справочники.ГруппыПользователей.ДКПБезПодразделения Тогда
			ОбщегоНазначения.СообщитьПользователю("Требуется определить подразделение пользователя " + Автор + ". Создание отменено. Обратитесь к непосредственному руководителю");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	//Евросиб СубботинВ #89527 30.10.2024 Конец 
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		//ВыполнитьПроверкуПередПроведением(Отказ);				

	КонецЕсли;  
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения
		или (ЗначениеЗаполнено(Ссылка) и не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка,"ПометкаУдаления") и ПометкаУдаления) Тогда
		Если ДополнительныеСвойства.Свойство("СтатусДокумента") тогда
			ТекущийСтатус = ДополнительныеСвойства.СтатусДокумента;
		Иначе
			ТекущийСтатусСтруктура = РегистрыСведений.СтатусыОбъектов.ПолучитьПоследнее(, Новый Структура("Объект", Ссылка));
			ТекущийСтатус = ТекущийСтатусСтруктура.Статус;
		КонецЕсли;
		Если ТекущийСтатус = Справочники.СтатусыДокументов.Подготовлена Тогда
			ДанныеОбмена = РегистрыСведений.ПротоколОбменов.ПроверитьВыгрузку(Ссылка, Перечисления.УзлыОбмена.УПП, Перечисления.ДействияПриОбмене.ВыгрузкаДанных);
			Если ЗначениеЗаполнено(ДанныеОбмена.СтатусБУ) и НЕ (ДанныеОбмена.СтатусБУ = "Отклонен")  Тогда 
				ТекстОшибки = "Удаление и распроведение заявки доступно только в статусе документа «Подготовлена» и состоянию в УПП «Отклонен»";
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , "СостояниеЗаявкиУПП", "Объект.СостояниеЗаявкиУПП", Отказ); 
			КонецЕсли;   
			Если ДокументыНаОплату.Количество() <> 0 Тогда  
				ТекстОшибки = "Удаление/отмена проведение Заявки невозможно. Привязаны следующие документы: "; 
				МассивДокументов = Новый Массив;
				Для каждого СтрДокумента Из ДокументыНаОплату Цикл
					МассивДокументов.Добавить(СтрДокумента.ОснованиеДляПлатежа); 
				КонецЦикла;
				ТекстОшибки = ТекстОшибки + СтрСоединить(МассивДокументов, ", ");
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , , , Отказ); 
			КонецЕсли;
		Иначе
			ТекстОшибки = "Удаление и распроведение заявки доступно только в статусе документа «Подготовлена»";
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , "СтатусДокумента",, Отказ);
		КонецЕсли;		
	КонецЕсли;
	//Евросиб СубботинВ #102000 07.02.2025 Конец 
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	// Евросиб(ДИТ) US 73033 ТА 87495 Сержантова А.С. Конец: 12.07.2024
	
	// Маршрутизация заявки
	//МаршрутизацияСервер.ПараллельноеСогласование(Состояния); //ДИТ, Беляев СЮ, Ticket#0344187, 06-03-2024, закомментировал (перенёс ниже)
	
	ДляДанногоОбъектаТребуетсяПеремаршрутизация = МаршрутизацияСервер.ТребуетсяПеремаршрутизацияДляОбъекта(ЭтотОбъект); 
	
	//Евросиб СубботинВ #89527 30.10.2024 Начало
	Если ЗначениеЗаполнено(Ссылка) и ДополнительныеСвойства.Свойство("СтатусДокумента") Тогда
		СтатусДляСтартаМаршрутизации = Справочники.СтатусыДокументов.НаСогласование;	
		ТекущийСтатус = ДополнительныеСвойства.СтатусДокумента;
		УстановленНужныйСтатусДляМаршрутизации = СтатусДляСтартаМаршрутизации = ТекущийСтатус; 
	Иначе 
		УстановленНужныйСтатусДляМаршрутизации = Ложь;
	КонецЕсли;
	
	//Если Маршрутизировать И ДляДанногоОбъектаТребуетсяПеремаршрутизация Тогда
	Если Маршрутизировать И ДляДанногоОбъектаТребуетсяПеремаршрутизация и УстановленНужныйСтатусДляМаршрутизации Тогда
		//Евросиб СубботинВ #89527 30.10.2024 Конец 
		
		ПараметрыЗапроса = Документы.ЗаявкаНаОплату.ПолучитьПараметрыМаршрутизации(ЭтотОбъект);
		//Евросиб СубботинВ #89527 30.10.2024 Начало
		//РезультатЗапроса = МаршрутизацияСервер.МаршрутизироватьРефСцеп(ПараметрыЗапроса, Дата);
		ПараметрыЗапроса.Вставить("ВидОперации", ВидОперации);
		ПараметрыЗапроса.Вставить("ПодразделениеДКП", ПодразделениеДКП);

		РезультатЗапроса = МаршрутизацияСервер.МаршрутизироватьЗаявкуНаОплату(ПараметрыЗапроса, Дата);
		//Евросиб СубботинВ #89527 30.10.2024 Конец

		Если РезультатЗапроса.Количество() > 0 Тогда
			УказанныеВручнуюИспНаблюдатель = Новый СписокЗначений;
			Если ДополнительныеСвойства.Свойство("ДопСвойстваОбъекта") тогда
				УказанныеВручнуюИспНаблюдатель = ДополнительныеСвойства.ДопСвойстваОбъекта;
			КонецЕсли;
			МаршрутизацияСервер.ПрименитьМаршрут(ЭтотОбъект, РезультатЗапроса, Автор, УказанныеВручнуюИспНаблюдатель);			
		КонецЕсли;
		
	КонецЕсли;
	
	//ДИТ, Беляев СЮ, Ticket#0344187, 06-03-2024, начало
	МаршрутизацияСервер.ПараллельноеСогласование(Состояния);
	//ДИТ, Беляев СЮ, Ticket#0344187, 06-03-2024, конец
	
	Для каждого Стр из Состояния Цикл
		Если Стр.ПримечаниеЗадачаИсполнителю Тогда
			// если текст примечания изменился, то создать новое сообщение. если остался прежним, то не менять
			// т.к. состояние уникально, ищем по нему
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Состояние",Стр.Состояние);
			НайденнаяСтр = Ссылка.Состояния.НайтиСтроки(ПараметрыОтбора);
			Если НайденнаяСтр.Количество()>0 Тогда
				Если НЕ НайденнаяСтр[0].Комментарий = Стр.Комментарий Тогда
					
					// +Шейко ОЕ [Ticket#0204385] Личные сообщения пользователям
					ДатаСообщения = ТекущаяДата();
					АвторСообщения = Пользователи.ТекущийПользователь();
					ТекстСообщения = Стр.Комментарий;
					ГУИДСообщения = Новый УникальныйИдентификатор();
					
					ГУИДТемы = Новый УникальныйИдентификатор;
					
					РассылкаПоЛичнымЦелям.СформироватьЛичноеСообщение(ГУИДТемы, , Ссылка, ДатаСообщения, АвторСообщения, ТекстСообщения, , ГУИДСообщения, Стр.Исполнитель);
					// -Шейко ОЕ [Ticket#0204385] Личные сообщения пользователям
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	МаршрутизацияСервер.ПостобработкаТЧСостояний(ЭтотОбъект, Автор);
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		РаспределитьСуммыПоСтатьямДДС();
	КонецЕсли;     
	
	// Евросиб(ДИТ) US 73033 ТА 87495 Сержантова А.С. Начало: 18.07.2024  
	//Если дрокумент помечается на удаление или распроводится и он был ранее отправлен в УПП, то отправляем пометку удаления/удаление проведения в УПП.
	Если не Отказ и (ЗначениеЗаполнено(Ссылка) 
		и (не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка,"ПометкаУдаления") и ПометкаУдаления) 
		или РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения) Тогда
		ДанныеОбмена = РегистрыСведений.ПротоколОбменов.ПроверитьВыгрузку(Ссылка, Перечисления.УзлыОбмена.УПП, Перечисления.ДействияПриОбмене.ВыгрузкаДанных);
		Если ЗначениеЗаполнено(ДанныеОбмена.СтатусБУ) Тогда   
			ДополнительныеСвойства.Вставить("ЗарегистрироватьДляОтправкиВУПП", Истина);
		КонецЕсли;
	КонецЕсли;
	// Евросиб(ДИТ) US 73033 ТА 87495 Сержантова А.С. Конец: 18.07.2024
		
КонецПроцедуры   

Процедура РаспределитьСуммыПоСтатьямДДС()
	
	//Если ДокументыНаОплату.Итог("СуммаОплаты") = СтатьиДвиженияДенежныхСредств.Итог("Сумма") Тогда
	//	Возврат;
	//КонецЕсли;
	Для каждого ДокументНаОплату Из ДокументыНаОплату Цикл  
		// Евросиб(ДИТ) BUG 97336 ТА 97367 Сержантова А.С. Начало: 09.12.2024
		// Было:
		//Если Не ЗначениеЗаполнено(ДокументНаОплату.ИдентификаторСтроки) Тогда 
		//Стало:
		СтрокиСТакимЖеИдентификатором = ДокументыНаОплату.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ДокументНаОплату.ИдентификаторСтроки));
		Если Не ЗначениеЗаполнено(ДокументНаОплату.ИдентификаторСтроки) или СтрокиСТакимЖеИдентификатором.Количество() > 1 Тогда
		// Евросиб(ДИТ) BUG 97336 ТА 97367 Сержантова А.С. Конец: 09.12.2024
			ДокументНаОплату.ИдентификаторСтроки = ПолучитьИдентификаторСтроки();
		КонецЕсли;
	КонецЦикла;
	СтатьиДвиженияДенежныхСредств.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаявкаНаОплатуДокументыНаОплату.ОснованиеДляПлатежа КАК ОснованиеДляПлатежа,
	|	ЗаявкаНаОплатуДокументыНаОплату.СуммаОплаты КАК СуммаОплаты,
	|	ЗаявкаНаОплатуДокументыНаОплату.ИдентификаторСтроки КАК ИдентификаторСтроки
	//Евросиб СубботинВ #107729 18.04.2025 Начало
    |	,ЗаявкаНаОплатуДокументыНаОплату.СуммаНДС КАК СуммаНДС
	//Евросиб СубботинВ #107729 18.04.2025 Конец
	//Евросиб СубботинВ #102528 09.04.2025 Начало
    |	,ЗаявкаНаОплатуДокументыНаОплату.СтавкаНДС КАК СтавкаНДС
	//Евросиб СубботинВ #102528 09.04.2025 Конец
	|ПОМЕСТИТЬ ВТ_ЗаявкаНаОплатуДокументыНаОплату
	|ИЗ
	|	Документ.ЗаявкаНаОплату.ДокументыНаОплату КАК ЗаявкаНаОплатуДокументыНаОплату
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаявкаНаОплатуДокументыНаОплату.СуммаОплаты КАК СуммаОплаты,
	|	ПоступлениеТоваровУслугУслуги.Номенклатура.СтатьяДДС КАК СтатьяДДС,
	// Евросиб(ДИТ) BUG 91762 ТА 93140 Сержантова А.С. Начало: 17.10.2024
	// Было:
	//|	ПоступлениеТоваровУслугУслуги.Сумма КАК Сумма, 
	//Стало:
	|ВЫБОР
	|	КОГДА ПоступлениеТоваровУслугУслуги.Сумма <> 0
	|		ТОГДА ПоступлениеТоваровУслугУслуги.Сумма
	|	ИНАЧЕ ПоступлениеТоваровУслугУслуги.ПолнаяСумма
	|КОНЕЦ КАК Сумма,
	// Евросиб(ДИТ) BUG 91762 ТА 93140 Сержантова А.С. Конец: 17.10.2024
	|	ЗаявкаНаОплатуДокументыНаОплату.ИдентификаторСтроки КАК ИдентификаторСтроки
	//Евросиб СубботинВ #107729 18.04.2025 Начало
	|,ВЫБОР
	|	КОГДА ПоступлениеТоваровУслугУслуги.СуммаНДС <> 0
	|		ТОГДА ПоступлениеТоваровУслугУслуги.СуммаНДС
	|	ИНАЧЕ ПоступлениеТоваровУслугУслуги.ПолнаяСуммаНДС
	|КОНЕЦ КАК СуммаНДС
	|	,ЗаявкаНаОплатуДокументыНаОплату.СуммаНДС КАК СуммаНДСОбщая
	//Евросиб СубботинВ #107729 18.04.2025 Конец
	|ПОМЕСТИТЬ ВТ_ДляГруппировки
	|ИЗ
	|	ВТ_ЗаявкаНаОплатуДокументыНаОплату КАК ЗаявкаНаОплатуДокументыНаОплату
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.Услуги КАК ПоступлениеТоваровУслугУслуги
	|		ПО ЗаявкаНаОплатуДокументыНаОплату.ОснованиеДляПлатежа = ПоступлениеТоваровУслугУслуги.Ссылка 
	//Евросиб СубботинВ #102528 09.04.2025 Начало
	|		И  ЗаявкаНаОплатуДокументыНаОплату.СтавкаНДС = ПоступлениеТоваровУслугУслуги.СтавкаНДС
	//Евросиб СубботинВ #102528 09.04.2025 Конец
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗаявкаНаОплатуДокументыНаОплату.СуммаОплаты,
	|	СчетНаОплатуПоставщикаУслуги.Номенклатура.СтатьяДДС,
	|	СчетНаОплатуПоставщикаУслуги.Сумма,
	|	ЗаявкаНаОплатуДокументыНаОплату.ИдентификаторСтроки
	//Евросиб СубботинВ #107729 18.04.2025 Начало
    |	,СчетНаОплатуПоставщикаУслуги.СуммаНДС
	|	,ЗаявкаНаОплатуДокументыНаОплату.СуммаНДС КАК СуммаНДСОбщая
	//Евросиб СубботинВ #107729 18.04.2025 Конец
	|ИЗ
	|	ВТ_ЗаявкаНаОплатуДокументыНаОплату КАК ЗаявкаНаОплатуДокументыНаОплату
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетНаОплатуПоставщика.Товары КАК СчетНаОплатуПоставщикаУслуги
	|		ПО ЗаявкаНаОплатуДокументыНаОплату.ОснованиеДляПлатежа = СчетНаОплатуПоставщикаУслуги.Ссылка
		//Евросиб СубботинВ #102528 09.04.2025 Начало
	|		И  ЗаявкаНаОплатуДокументыНаОплату.СтавкаНДС = СчетНаОплатуПоставщикаУслуги.СтавкаНДС
	//Евросиб СубботинВ #102528 09.04.2025 Конец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВТ_ДляГруппировки.СуммаОплаты) КАК СуммаОплаты,
	|	ВТ_ДляГруппировки.СтатьяДДС КАК СтатьяДДС, 
	// Евросиб(ДИТ) BUG 91762 ТА 93140 Сержантова А.С. Начало: 28.10.2024
	// Было:
	//|	МАКСИМУМ(ВТ_ДляГруппировки.Сумма) КАК Сумма, 
	//Стало:
	|	СУММА(ВТ_ДляГруппировки.Сумма) КАК Сумма,
	// Евросиб(ДИТ) BUG 91762 ТА 93140 Сержантова А.С. Конец: 28.10.2024
	|	ВТ_ДляГруппировки.ИдентификаторСтроки КАК ИдентификаторСтроки
	//Евросиб СубботинВ #107729 18.04.2025 Начало
