Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	#Область ТиповойФункционалДокументов

	Автор 			 = Пользователи.ТекущийПользователь();
	Подразделение    = Автор.Подразделение;
	Организация 	 = Константы.ОсновнаяОрганизация.Получить();
	Создано 		 = ТекущаяДата();
	Маршрутизировать = Константы.МаршрутизироватьЗаявкуНаОплату.Получить();
	
	#КонецОбласти
	
	//Евросиб СубботинВ #102528 09.04.2025 Начало
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявкаНаОплату") или ТипЗнч(ДанныеЗаполнения)= Тип("ДанныеФормыСтруктура") Тогда 
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения,,
								"ДокументыНаОплату,Состояния,СтатьиДвиженияДенежныхСредств,Номер,Проведен,ПометкаУдаления,Создано,ПримененныйМаршрут");		
	Иначе 
	//Евросиб СубботинВ #102528 09.04.2025 Конец
		Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
			Если ДанныеЗаполнения.Свойство("Основание") Тогда 
				//Евросиб СубботинВ #102528 09.04.2025 Начало
				Если ДанныеЗаполнения.Свойство("НеЗаполнятьТЧ") Тогда
					ЗаполнятьТЧ = Ложь;
				Иначе 
					ЗаполнятьТЧ = Истина;
					КонецЕсли;
				//Евросиб СубботинВ #102528 09.04.2025 Конец
				Если ТипЗнч(ДанныеЗаполнения.Основание) = Тип("ДокументСсылка.СчетНаОплатуПоставщика") Тогда 
					//Евросиб СубботинВ #102528 09.04.2025 Начало
                   // ЗаполнитьПоДаннымСчетНаОплатуПоставщика(ДанныеЗаполнения.Основание);
					ЗаполнитьПоДаннымСчетНаОплатуПоставщика(ДанныеЗаполнения.Основание, ЗаполнятьТЧ);
					//Евросиб СубботинВ #102528 09.04.2025 Конец
				ИначеЕсли ТипЗнч(ДанныеЗаполнения.Основание) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
					//Евросиб СубботинВ #102528 09.04.2025 Начало
					//ЗаполнитьПоДаннымПоступлениеТоваровУслуг(ДанныеЗаполнения.Основание);
					ЗаполнитьПоДаннымПоступлениеТоваровУслуг(ДанныеЗаполнения.Основание, ЗаполнятьТЧ);
					//Евросиб СубботинВ #102528 09.04.2025 Конец
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДоговорКонтрагента) и Не ЗначениеЗаполнено(ПодразделениеДКП) Тогда
			ОтветственныйЗаДоговор = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорКонтрагента, "ОтветственныйЗаДоговор");	
			ПодразделениеДКП = Справочники.Пользователи.ПолучитьГруппуДКППользователя(ОтветственныйЗаДоговор);
		КонецЕсли;	
		
		Если ЭтотОбъект.ПодразделениеДКП = Справочники.ГруппыПользователей.ОтделАренды Тогда
			ЭтотОбъект.ВидОперации = Перечисления.ВидыОперацийЗаявкиНаОплату.ОплатаАренды;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ВидОперации) Тогда
			ВидОперации = Перечисления.ВидыОперацийЗаявкиНаОплату.ОплатаПоставщику;
		КонецЕсли; 
		
	//Евросиб СубботинВ #102528 09.04.2025 Начало
	КонецЕсли;
	//Евросиб СубботинВ #102528 09.04.2025 Конец	
	
	
