&НаКлиенте	
Процедура ОбработкаОтветаПользователяОчисткаЗаявки(ОтветПользователя = Неопределено, ДопПараметры = Неопределено)Экспорт
	
	Если ОтветПользователя = Неопределено или ОтветПользователя = КодВозвратаДиалога.Отмена Тогда
		Возврат;	 
	ИначеЕсли ОтветПользователя = КодВозвратаДиалога.Да Тогда 		
		Объект.ДокументыНаОплату.Очистить(); 
		СвязанныеПТУ.Очистить();
		Объект.ВидОперации = ДопПараметры.ВыбранноеЗначение;
		ВидОперацииПриИзменении(ДопПараметры.Элемент);
	КонецЕсли; 
	
КонецПроцедуры

