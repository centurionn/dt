// Евросиб US 106410 TA 106412 Рыбьяков К.А. 10.07.2025 ((
Процедура ЗаполнитьСтатусыЭДОДокументов(Таблица)
	
	МассивДокументов = Таблица.ВыгрузитьКолонку("ПТУ");
	ОбщегоНазначения.ЗаполнитьМассивУникальнымиЗначениями(МассивДокументов, Таблица.ВыгрузитьКолонку("КорПТУ"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Диадок_Документы.Документ КАК Документ,
	|	Диадок_Документы.Статус КАК Статус
	|ИЗ
	|	Справочник.Диадок_Документы КАК Диадок_Документы
	|ГДЕ
	|	Диадок_Документы.Документ В(&Документы)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Документ УБЫВ";
	
	Запрос.УстановитьПараметр("Документы", МассивДокументов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если ТипЗнч(Выборка.Документ) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
			СтруктураОтбора = Новый Структура("ПТУ", Выборка.Документ);
		Иначе
			СтруктураОтбора = Новый Структура("КорПТУ", Выборка.Документ);
		КонецЕсли;
		СтрокиТаблицы = Таблица.НайтиСтроки(СтруктураОтбора);
		Для Каждого Строка Из СтрокиТаблицы Цикл
			Строка.СтатусЭДО = Строка.СтатусЭДО + ?(ТипЗнч(Выборка.Документ) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг"), "ПТУ " + Выборка.Статус, "; КорПТУ " + Выборка.Статус);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры
