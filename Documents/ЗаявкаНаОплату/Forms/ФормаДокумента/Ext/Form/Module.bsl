&НаКлиенте
Процедура ЗаполнитьДанныеПоСтроке(ТекДанные, ВыбранноеЗначение = Неопределено)
	
	ЗаявкаЦФО = Неопределено;
	ОтветственныйЗаОплатуВыбранногоДокумента = Неопределено;
	ПодразделениеДКПОтветственного = Неопределено;
	
	Если ВыбранноеЗначение = Неопределено Тогда
		ВыбранноеЗначение = ТекДанные.ОснованиеДляПлатежа;
	КонецЕсли;	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") 
		или ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.СчетНаОплатуПоставщика") Тогда
		
		ЗначенияРеквизитов = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(ВыбранноеЗначение, "ЦФО, ДоговорКонтрагента");
		ЗаявкаЦФО = ЗначенияРеквизитов.ЦФО;
		ОтветственныйЗаОплатуВыбранногоДокумента = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(ЗначенияРеквизитов.ДоговорКонтрагента, "ОтветственныйЗаДоговор");
		Если ЗначениеЗаполнено(ОтветственныйЗаОплатуВыбранногоДокумента) Тогда
			ПодразделениеДКПОтветственного =  ПолучитьГруппуДКППользователя(ОтветственныйЗаОплатуВыбранногоДокумента);
		КонецЕсли;
		Если ТекДанные.НомерСтроки <> 1 Тогда
			Если ЗначениеЗаполнено(Объект.ЦФО) и ЗаявкаЦФО <> Объект.ЦФО Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю("По выбранным документам – основаниям разные ЦФО. Выбор отменен");
				СтандартнаяОбработка = Ложь;
				Возврат;
			КонецЕсли;
			Если ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
				ПТУСтрахование = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(ВыбранноеЗначение, "Страхование");
				//
				Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаявкиНаОплату.Страхование") 
					и НЕ ПТУСтрахование Тогда
					ВыбранноеЗначение = Неопределено;
					ОбщегоНазначенияКлиент.СообщитьПользователю("Выбранные ПТУ не являются страхованием. Добавление отменено");
					Возврат;
				КонецЕсли;				
			КонецЕсли;
		Иначе 
			Объект.ЦФО = ЗаявкаЦФО;
			ПроверитьВидОперации(ВыбранноеЗначение);
		КонецЕсли;
		ТекДанные.ЦФО = ЗаявкаЦФО;
		ТекДанные.ОтветственныйЗаОплату = ОтветственныйЗаОплатуВыбранногоДокумента;
		ТекДанные.ПодразделениеДКП = ПодразделениеДКПОтветственного;
		МассивДокументов = Новый Массив;
		МассивДокументов.Добавить(ВыбранноеЗначение);
		СтатусДокументовОснований = ПолучитьТекущиеСтатусыИСтатусыЭДО(МассивДокументов);
		СтруктураСтатусы = СтатусДокументовОснований.Получить(ВыбранноеЗначение);
		Если СтруктураСтатусы <> Неопределено
			и (СтруктураСтатусы.СтатусЭДО = "Аннулирован" 
			или СтруктураСтатусы.СтатусДокумента = ПредопределенноеЗначение("Перечисление.СтатусыДокументовПоступлений.Аннулирован")) Тогда
			ТекДанные.ДокументАннулирован = Истина;
		КонецЕсли; 
		//Евросиб СубботинВ #102528 09.04.2025 Начало	
		ЗафиксироватьНдсДоИзменения(ТекДанные.ПолучитьИдентификатор()); 
		//Евросиб СубботинВ #102528 09.04.2025 Начало
	КонецЕсли;

КонецПроцедуры

