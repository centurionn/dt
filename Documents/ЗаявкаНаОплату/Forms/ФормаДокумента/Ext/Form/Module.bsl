	//Евросиб СубботинВ #89527 30.10.2024 Конец
	//Евросиб СубботинВ #111466 09.06.2025 Начало
	|,	ПротоколОбменов.ДатаПланируемойОплаты КАК ДатаПланируемойОплатыУПП
	//Евросиб СубботинВ #111466 09.06.2025 Конец 
	|ИЗ
	|	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	|ГДЕ
	|	ПротоколОбменов.ДействиеПриОбмене = &ДействиеПриОбмене
	|	И ПротоколОбменов.УзелОбмена = &УзелОбмена
	|	И ПротоколОбменов.Объект В(&СписокОбъектов);
	//Евросиб СубботинВ #118799 09.10.2025 Начало // добавил пакет для КЗП 
	////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ФиксацияИзмененийСчетаПоступления.ИзменяемыйДокумент КАК ИзменяемыйДокумент,
	|	ПротоколОбменов.НомерДатаВБУ КАК НомерДатаВУПП
	|	ИЗ
	|	Справочник.ФиксацияИзмененийСчетаПоступления КАК ФиксацияИзмененийСчетаПоступления
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	|		ПО ФиксацияИзмененийСчетаПоступления.Ссылка = ПротоколОбменов.Объект
	|		И ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УППЗаказ)
	|ГДЕ
	|	ФиксацияИзмененийСчетаПоступления.ИзменяемыйДокумент В(&СписокОбъектов)
	|	И НЕ ФиксацияИзмененийСчетаПоступления.ПометкаУдаления;
	////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаявкиНаРасходованиеДенежныхСредствОстатки.СуммаОстаток КАК СуммаОстаток,
	|	ЗаявкиНаРасходованиеДенежныхСредствОстатки.ЗаявкаНаОплату КАК ЗаявкаНаОплату
	|ИЗ
	|	РегистрНакопления.ЗаявкиНаРасходованиеДенежныхСредств.Остатки КАК ЗаявкиНаРасходованиеДенежныхСредствОстатки
	|ГДЕ
	|	ЗаявкиНаРасходованиеДенежныхСредствОстатки.Договор = &Договор
	|   И ЗаявкиНаРасходованиеДенежныхСредствОстатки.ЗаявкаНаОплату В(&СписокОбъектов)
	|	И ЗаявкиНаРасходованиеДенежныхСредствОстатки.Валюта = &Валюта";	
	//Евросиб СубботинВ #118799 09.10.2025 Конец 
	
	Запрос.УстановитьПараметр("ДействиеПриОбмене", Перечисления.ДействияПриОбмене.ВыгрузкаДанных);
	Запрос.УстановитьПараметр("УзелОбмена", Узел);
	Запрос.УстановитьПараметр("СписокОбъектов", МассивОбъектов);
	//Евросиб СубботинВ #118799 09.10.2025 Начало
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("Валюта", Валюта);
	//ВыборкаРезультатаЗапроса = Запрос.Выполнить().Выбрать();
	РезультатаЗапроса = Запрос.ВыполнитьПакет();
    ВыборкаРезультатаЗапроса = РезультатаЗапроса[0].Выбрать();
	ВыборкаФиксацииИзменений = РезультатаЗапроса[1].Выгрузить(); 
	ВыборкаОстатокПоДоговору = РезультатаЗапроса[2].Выбрать();
	//Евросиб СубботинВ #118799 09.10.2025 Конец
	СоответствиеОбъектов = Новый Соответствие;
	Пока ВыборкаРезультатаЗапроса.Следующий() Цикл
		//Евросиб СубботинВ #111466 09.06.2025 Начало		
		//Евросиб СубботинВ #89527 30.10.2024 Начало добавил доп инфо, где лежит статус связанного с заявкой реестра
		//СтруктураДанных = Новый Структура("НомерДатаВУПП, ДатаОбменаВБУ, СостояниеЗаявкиУПП, ДатаОплатыУПП");
		//СтруктураДанных = Новый Структура("НомерДатаВУПП, ДатаОбменаВБУ, СостояниеЗаявкиУПП, ДатаОплатыУПП, СостояниеРеестраУПП");
		//Евросиб СубботинВ #89527 30.10.2024 Конец
		СтруктураДанных = Новый Структура("НомерДатаВУПП, ДатаОбменаВБУ, СостояниеЗаявкиУПП, ДатаОплатыУПП, СостояниеРеестраУПП, ДатаПланируемойОплатыУПП");
		//Евросиб СубботинВ #111466 09.06.2025 Конец
		//Евросиб СубботинВ #118799 09.10.2025 Начало
		НомерКЗП = "";
		ПараметрыОтбора = Новый Структура("ИзменяемыйДокумент", ВыборкаРезультатаЗапроса.Объект);
		СтрокиПоДокументу = ВыборкаФиксацииИзменений.НайтиСтроки(ПараметрыОтбора);
		Если СтрокиПоДокументу.Количество() > 0 Тогда
			НомерКЗП = "/";	
			Для Каждого ЗафиксированноеИзменение из ВыборкаФиксацииИзменений Цикл
				НомерКЗП = НомерКЗП + ЗафиксированноеИзменение.НомерДатаВУПП;
			КонецЦикла; 
		КонецЕсли;
		СтруктураДанных.Вставить("НомерКЗП", НомерКЗП);
		//Евросиб СубботинВ #118799 09.10.2025 Конец 
		//Евросиб СубботинВ #118799 09.10.2025 Начало
		Если ВыборкаОстатокПоДоговору.Следующий() Тогда
			СтруктураДанных.Вставить("НеоплаченныйОстаток", ВыборкаОстатокПоДоговору.СуммаОстаток);	
		КонецЕсли;
		//Евросиб СубботинВ #118799 09.10.2025 Конец
		
		ЗаполнитьЗначенияСвойств(СтруктураДанных, ВыборкаРезультатаЗапроса);
		СоответствиеОбъектов.Вставить(ВыборкаРезультатаЗапроса.Объект, СтруктураДанных);
	КонецЦикла;
	Возврат СоответствиеОбъектов;
	
КонецФункции

