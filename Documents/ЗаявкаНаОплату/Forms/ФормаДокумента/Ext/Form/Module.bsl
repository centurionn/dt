&НаКлиенте
Процедура ПерезаполнитьСтавкуНДСВДокументахОснования(Команда)
	
	//Евросиб СубботинВ #102528 09.04.2025 Начало
	Если Объект.ДокументыНаОплату.Количество()= 0 Тогда 
		ОбщегоНазначенияКлиент.СообщитьПользователю("Табличная часть документов на оплату незаполнена");
		Возврат;		
	КонецЕсли;	
	//Евросиб СубботинВ #102528 09.04.2025 Конец

	ОписаниеОповещения = Новый ОписаниеОповещения("ПродолжитьПерезаполнитьСтавкуНДСВДокументахОснования", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, "Ставка НДС в документах - основаниях Счет будет перезаполнена автоматически. Изменение ставки НДС для документов: Счет с несколькими ставками НДС, ПТУ требуется выполнить вручную. Продолжить?",РежимДиалогаВопрос.ДаНет, 60);
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПерезаполнитьСтавкуНДСВДокументахОснования(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	//Евросиб СубботинВ #102528 21.07.2025 Начало
	
	Результат = ПроверитьВозможностьИзмененияСтавки();

	Если НЕ Результат.РезультатПроверки Тогда
		ВызватьИсключение("Выполнение операции невозможно"); 
	КонецЕсли;	
	
	Если НЕ Результат.СвязанныеЗаявки.Количество() = 0 Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПерезаполнитьСтавкуНДСВДокументахОснованияИЗаявках", ЭтотОбъект, Новый Структура("СвязанныеЗаявки", Результат.СвязанныеЗаявки));
		ПоказатьВопрос(ОписаниеОповещения, Результат.Сообщение + ". Продолжить?"
					   , РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Нет);
		Возврат;			   
    КонецЕсли;
	//Евросиб СубботинВ #102528 21.07.2025 Конец

	
    РезультатВыполнения = ПерезаполнитьСтавкуНДСВДокументахОснованияНаСервере();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
