	// Евросиб(ДИТ) US 73033 ТА 87495 Сержантова А.С. Начало: 12.07.2024
	УстановитьУсловноеОформление();    
	// Евросиб(ДИТ) US 73033 ТА 87495 Сержантова А.С. Конец: 12.07.2024 
	    
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПодсвечиваниеПолейОбъектов.НастроитьПодсвечиваниеПолей(ТекущийОбъект, ИмяФормы, ЭтаФорма, УсловноеОформление);	

	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект); 
	
	ЗаполнитьДанныеБУ();
	ЗаполнитьДанныеДокументыНаОплату();  
	// Евросиб(ДИТ) US 73033 ТА 87495 Сержантова А.С. Начало: 15.07.2024
	ЗаполнитьТаблицуКорректировокПТУ();              
	УстановитьВидимостьДоступность();
	// Евросиб(ДИТ) US 73033 ТА 87495 Сержантова А.С. Конец: 15.07.2024
	
	//Евросиб СубботинВ #89541 16.10.2024 Начало
	Если  Объект.ВидОперации = Перечисления.ВидыОперацийЗаявкиНаОплату.ОплатаПоставщику и Объект.ДоговорКонтрагента.УсловиеОплаты = Перечисления.ВидыУсловийОплаты.ОплатаПоФакту Тогда
 		Элементы.ДанныеПТУ.Видимость = Истина;
		ЗаполнитьДанныеУППпоДокументам();
	КонецЕсли;
    //Евросиб СубботинВ #89541 16.10.2024 Конец
	
	//Евросиб СубботинВ #102528 09.04.2025 Начало	
	СформироватьКомандыСозданияЗаявокПоРазнымСтавкамНДС();	
	//Евросиб СубботинВ #102528 09.04.2025 Конец
	
	//Евросиб СубботинВ #102528 21.07.2025 Начало	
	ЗафиксироватьСтавкиДоИзменения();	
	//Евросиб СубботинВ #102528 21.07.2025 Конец
	
	//Евросиб СубботинВ #118799 09.10.2025 Начало
	 ЗаполнитьДокументыОплатыИСтатусОплаты();
	//Евросиб СубботинВ #118799 09.10.2025 Конец
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДатеОплатыНаСервере()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = ПолучитьТекстЗапросаСУчетомВидаОперации(Объект.ВидОперации);
	//Евросиб СубботинВ #89541 16.10.2024 Конец
	
	Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
	Запрос.УстановитьПараметр("ДоговорКонтрагента", Объект.ДоговорКонтрагента);
	Запрос.УстановитьПараметр("ДатаОплаты", Объект.ДатаПланируемойОплаты);
	
	РезультатЗапроса = Запрос.Выполнить();                              
	Если РезультатЗапроса.Пустой() Тогда
		//Евросиб СубботинВ #120624 01.10.2025 Начало 
		ОбщегоНазначения.СообщитьПользователю("Счетов, ПТУ с датой планируемой оплаты " + Формат(Объект.ДатаПланируемойОплаты,"ДФ=dd.MM.yyyy") + " не найдено.");
		//Евросиб СубботинВ #120624 01.10.2025 Конец		
		Возврат;
	КонецЕсли; 
	Объект.ДокументыНаОплату.Загрузить(РезультатЗапроса.Выгрузить());
	ЗаполнитьДанныеДокументыНаОплату();
	ПересчитатьВсегоПоЗаявкеНаСервере();
	
	//Евросиб СубботинВ #89541 16.10.2024 Начало
	ЗаполнитьДанныеУППпоДокументам();	
	//Евросиб СубботинВ #89541 16.10.2024 Конец
	
	//Евросиб СубботинВ #102528 21.07.2025 Начало
	Ставки = ОбщегоНазначения.ВыгрузитьКолонку(Объект.ДокументыНаОплату, "СтавкаНДС", Истина);
	//Ставки.Свернуть("СтавкаНДС");
	Если Ставки.Количество()> 1 Тогда
		Объект.ЗаявкаПоРазнымСтавкамНДС = истина;
	КонецЕсли;	
	//Евросиб СубботинВ #102528 21.07.2025 Конец


	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоДатеОплаты(Команда)
	
	//Евросиб СубботинВ #89541 16.10.2024 Начало
	Если Объект.ВидОперации =  ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаявкиНаОплату.ПустаяСсылка") Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Для заполнения по дате оплаты укажите вид операции заявки на оплату");
		Возврат
	КонецЕсли;
	//Евросиб СубботинВ #89541 16.10.2024 Конец	
	
	Если Объект.Проведен Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Заполнение по дате оплаты доступно только для непроведенного документа");
		Возврат;
	КонецЕсли;
	
	//Евросиб СубботинВ #120624 01.10.2025 Начало 
	Если Не ЗначениеЗаполнено(Объект.ДатаПланируемойОплаты) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнена дата планируемой оплаты. Установите дату и повторите действие.");
		Возврат;
	КонецЕсли;	
	//Евросиб СубботинВ #120624 01.10.2025 Конец	
	
	ЗаполнитьПоДатеОплатыНаСервере();
	
	//Евросиб СубботинВ #89541 16.10.2024 Начало
	Для Каждого СтрокаОснования из Объект.ДокументыНаОплату Цикл
		ЗаполнитьДанныеПоСтроке(СтрокаОснования);
	КонецЦикла;
	//Евросиб СубботинВ #89541 16.10.2024 Конец 
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнитьВалютуВДокументахОснования(Команда)
	ОписаниеОповещения = Новый ОписаниеОповещения("ПродолжитьПерезаполнитьВалютуВДокументахОснования", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, "Будет перезаполнена валюта во всех документах основания платежа. Продолжить?",РежимДиалогаВопрос.ДаНет, 60);
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПерезаполнитьВалютуВДокументахОснования(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;  
    РезультатВыполнения = ПерезаполнитьВалютуВДокументахОснованияНаСервере();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ТекстСообщения = "Выполняется перезаполнение валюты в документах основания.
										|Это может занять продолжительное время.";
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПерезаполнениеВалютыЗавершение", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);

	
КонецПроцедуры

&НаСервере
Функция ПерезаполнитьВалютуВДокументахОснованияНаСервере()
	
	Если РезультатВыполнения <> Неопределено
		И ЗначениеЗаполнено(РезультатВыполнения.ИдентификаторЗадания) Тогда
		ДлительныеОперации.ОтменитьВыполнениеЗадания(РезультатВыполнения.ИдентификаторЗадания);
	КонецЕсли; 
	
	//Евросиб СубботинВ #102528 21.07.2025 Начало 
	МассивДокументовОснований = Объект.ДокументыНаОплату.Выгрузить(,"ОснованиеДляПлатежа, НомерСтроки, СтавкаНДС");
	МассивДокументовОснований = Взаимодействия.УдалитьПовторяющиесяЭлементыМассива(МассивДокументовОснований);
	Результат = Документы.ЗаявкаНаОплату.ПолучитьЗаявкиПоДокументуОснованию(МассивДокументовОснований, Объект.ВалютаОплаты, Объект.Ссылка,,Истина); 
	Если НЕ Результат.РезультатПроверки Тогда
		ВызватьИсключение("Выполнение операции невозможно"); 
	КонецЕсли;	
	//Евросиб СубботинВ #102528 21.07.2025 Конец
		
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение = 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Перезаполнение валюты в документах основания'");
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	РезультатВыполнения = ДлительныеОперации.ВыполнитьВФоне("Документы.ЗаявкаНаОплату.ПерезаполнитьВалютуВДокументахОснования",
	//Евросиб СубботинВ #102528 21.07.2025 Начало 
		//Новый Структура("МассивДокументовОснования, Валюта", Объект.ДокументыНаОплату.Выгрузить(,"ОснованиеДляПлатежа").ВыгрузитьКолонку("ОснованиеДляПлатежа"), Объект.ВалютаОплаты), ПараметрыВыполнения);
	Новый Структура("МассивДокументовОснования, Валюта, СвязанныеЗаявкиНаИзменение",
					Объект.ДокументыНаОплату.Выгрузить(,"ОснованиеДляПлатежа").ВыгрузитьКолонку("ОснованиеДляПлатежа"), Объект.ВалютаОплаты, Результат.СвязанныеЗаявки), ПараметрыВыполнения);
	//Евросиб СубботинВ #102528 21.07.2025 Конец 
	Если РезультатВыполнения.Статус = "Ошибка" Тогда
		ВызватьИсключение РезультатВыполнения.КраткоеПредставлениеОшибки;
	КонецЕсли;
	
	Возврат РезультатВыполнения;
	
КонецФункции

&НаКлиенте
Процедура ПерезаполнениеВалютыЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		СтруктураРезультата = ПолучитьИзВременногоХранилища(РезультатВыполнения.АдресРезультата);
		Если СтруктураРезультата.ЕстьРезультат = Истина Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтруктураРезультата.РезультатПерезаполнения); 
			ЗаполнитьДанныеДокументыНаОплату();
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтруктураРезультата.РезультатПерезаполнения);
		КонецЕсли;
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		ВызватьИсключение Результат.КраткоеПредставлениеОшибки;
	КонецЕсли;
	
КонецПроцедуры

