&НаСервере
Функция ПроверитьПривязанныеПП()
	
	Результат = Новый Структура("КоличествоФайлов, ППнеПодтверждено");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Файлы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Файлы КАК Файлы
	|ГДЕ
	|	Файлы.ВладелецФайла = &ВладелецФайлов
	|	И НЕ Файлы.ПометкаУдаления;
	|//////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗначенияДополнительныхАналитикДокументов.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ЗначенияДополнительныхАналитикДокументов КАК ЗначенияДополнительныхАналитикДокументов
	|ГДЕ
	|	ЗначенияДополнительныхАналитикДокументов.Документ = &ВладелецФайлов
	|	И ЗначенияДополнительныхАналитикДокументов.Аналитика = &Аналитика";
	
	Запрос.УстановитьПараметр("Аналитика", ПланыВидовХарактеристик.ДополнительныеАналитикиДокументов.СтатусППНеПодтвержден);	
	Запрос.УстановитьПараметр("ВладелецФайлов", Объект.Ссылка);
	
	Выборка = Запрос.ВыполнитьПакет();
	Результат.КоличествоФайлов = Выборка[0].Выбрать().Количество(); 
	Подтвержение = Выборка[1].Выбрать();
	Если Подтвержение.Следующий() Тогда
		Результат.ППнеПодтверждено = Подтвержение.Значение;
	КонецЕсли;

	Возврат Результат;
	
КонецФункции	

