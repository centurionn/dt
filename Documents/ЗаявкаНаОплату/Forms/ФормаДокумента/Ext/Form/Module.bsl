Процедура ПроверитьВидОперации(ВыбранноеЗначение)
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаПроверкиМаршрутаКонтрагентЦФО();
    Запрос.УстановитьПараметр("ВидОперацииЗаявкиНаОплату", Перечисления.ВидыОперацийЗаявкиНаОплату.ОплатаПоставщикуОбщехозяйственные);
	Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
	Запрос.УстановитьПараметр("МаршрутизируемыйОбъект", Перечисления.МаршрутизируемыеОбъекты.ЗаявкаНаОплату); 
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"&ЦФО", "МаршрутизацияКонтрагентыИДоговоры.Ссылка.ЦФО = &ЦФО");
	Запрос.УстановитьПараметр("ЦФО", Объект.ЦФО);
	
	 Результат = Запрос.Выполнить();

	Если ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") и ВыбранноеЗначение.Страхование Тогда
		Объект.ВидОперации = Перечисления.ВидыОперацийЗаявкиНаОплату.Страхование;
	ИначеЕсли не Результат.Пустой() Тогда
		 Объект.ВидОперации = Перечисления.ВидыОперацийЗаявкиНаОплату.ОплатаПоставщикуОбщехозяйственные;
	КонецЕсли;

	

КонецПроцедуры 

