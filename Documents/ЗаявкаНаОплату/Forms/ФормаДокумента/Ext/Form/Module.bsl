&НаКлиенте
Процедура ДокументыНаОплатуОснованиеДляПлатежаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	//Евросиб СубботинВ #89541 16.10.2024 Начало
	Если Объект.ВидОперации =  ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаявкиНаОплату.ПустаяСсылка") Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Для выбора документа основания платежа укажите вид операции заявки на оплату");
		СтандартнаяОбработка = Ложь;
		Возврат
	КонецЕсли;
	
	ТекДанные = Элементы.ДокументыНаОплату.ТекущиеДанные;	
	Если ТекДанные.ОснованиеДляПлатежа = Неопределено Тогда		
		ИдентификаторТекСтроки = ТекДанные.ПолучитьИдентификатор();		
		СписокТипов = Новый СписокЗначений;
		Если НЕ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаявкиНаОплату.ОплатаПоставщикуОбщехозяйственные") Тогда			
			СписокТипов.Добавить(Тип("ДокументСсылка.ПоступлениеТоваровУслуг"));
		КонецЕсли;	
		Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаявкиНаОплату.ОплатаПоставщику") или 
			Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаявкиНаОплату.ОплатаПоставщикуОбщехозяйственные")Тогда			
			СписокТипов.Добавить(Тип("ДокументСсылка.СчетНаОплатуПоставщика"));
		КонецЕсли;		
		СтандартнаяОбработка = Ложь;
		
		ДопПараметры = Новый Структура("ИдентификаторТекСтроки", ИдентификаторТекСтроки);
		ОповещениеОВыборе = Новый ОписаниеОповещения("ДокументыНаОплатуОснованиеДляПлатежаОбработкаВыбораТипа", ЭтаФорма, ДопПараметры);		
		СписокТипов.ПоказатьВыборЭлемента(ОповещениеОВыборе, "Выбор типа данных");
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	СтруктураОтбора = Новый Структура;
	Если ЗначениеЗаполнено(Объект.ДоговорКонтрагента) Тогда
		СтруктураОтбора.Вставить("ДоговорКонтрагента", Объект.ДоговорКонтрагента); 
	КонецЕсли;		
	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		СтруктураОтбора.Вставить("Контрагент", Объект.Контрагент);
	КонецЕсли;
	
	Если ТипЗнч(ТекДанные.ОснованиеДляПлатежа) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда		
		Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаявкиНаОплату.ОплатаПретензий") Тогда
			СтруктураОтбора.Вставить("Претензия", Истина);
		ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаявкиНаОплату.ОплатаШтрафов") Тогда	 
			СтруктураОтбора.Вставить("Штраф", Истина);			
		Иначе
			СтруктураОтбора.Вставить("Претензия", Ложь);
			СтруктураОтбора.Вставить("Штраф", Ложь); 
		КонецЕсли;
		ОткрытьФорму("Документ.ПоступлениеТоваровУслуг.ФормаВыбора", Новый Структура("Отбор", СтруктураОтбора),Элемент,ЭтаФорма.УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);		
	ИначеЕсли ТипЗнч(ТекДанные.ОснованиеДляПлатежа) = Тип("ДокументСсылка.СчетНаОплатуПоставщика")Тогда
		ОткрытьФорму("Документ.СчетНаОплатуПоставщика.ФормаВыбора", Новый Структура("Отбор", СтруктураОтбора),Элемент,ЭтаФорма.УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	//Евросиб СубботинВ #89541 16.10.2024 Конец
	
КонецПроцедуры

                  
