	ЗаполнитьТаблицуМультивалютныхДоговоров(НЕ ЗначениеЗаполнено(Объект.Ссылка));
    ЗаполнитьДанныеДокументыНаОплату();
	ВалютаДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ДоговорКонтрагента, "ВалютаВзаиморасчетов");
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПересчитатьВсегоПоЗаявкеНаСервере();
	КонецЕсли;
	//УстановитьВидимостьДоступность();    
	// Евросиб(ДИТ) US 73033 ТА 87495 Сержантова А.С. Начало: 11.07.2024
	УстановитьТекущийСтатусДокумента(); 
	УстановитьВидимостьДоступность(); 
	ЗаполнитьТаблицуКорректировокПТУ();
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Для каждого ДокументОснование Из Объект.ДокументыНаОплату Цикл
			Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
				ДанныеПоКорПТУ = ПолучитьДанныеКорПТУ(ДокументОснование, Истина);
				Для каждого СтрокаКорПТУ Из ДанныеПоКорПТУ Цикл
					РеквизитыПТУиКорПТУ = СтрокаКорПТУ.Значение; 
					ТекстСообщения = "По ПТУ № "+РеквизитыПТУиКорПТУ.НомерПТУ+", дата "+РеквизитыПТУиКорПТУ.ДатаПТУ
					+", имеется КорПТУ № "+РеквизитыПТУиКорПТУ.НомерКорПТУ+", дата "+РеквизитыПТУиКорПТУ.ДатаКорПТУ 
					+". Проверьте сумму оплаты в Заявке";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);		
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		//Евросиб СубботинВ #89541 16.10.2024 Начало
		Если Объект.ВидОперации = Перечисления.ВидыОперацийЗаявкиНаОплату.ОплатаПоставщику и Объект.ДоговорКонтрагента.УсловиеОплаты = Перечисления.ВидыУсловийОплаты.ОплатаПоФакту Тогда
			Элементы.ДанныеПТУ.Видимость = Истина;
			ЗаполнитьДанныеУППпоДокументам();
		КонецЕсли;
		//Евросиб СубботинВ #89541 16.10.2024 Конец		
	КонецЕсли;
	// Евросиб(ДИТ) US 73033 ТА 87495 Сержантова А.С. Конец: 11.07.2024
	
	// Евросиб US 106410 TA 106412 Рыбьяков К.А. 11.08.2025 ((
	УсловиеОплаты = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ДоговорКонтрагента, "УсловиеОплаты");
	Если УсловиеОплаты <> Перечисления.ВидыУсловийОплаты.ОплатаПоФакту Тогда
		Элементы.ДокументыНаОплатуСтатусЭДО.Видимость = Ложь;
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 11.08.2025 )) 
	
	//Евросиб СубботинВ #102528 21.07.2025 Начало	
	ЗафиксироватьСтавкиДоИзменения();	
	//Евросиб СубботинВ #102528 21.07.2025 Конец


