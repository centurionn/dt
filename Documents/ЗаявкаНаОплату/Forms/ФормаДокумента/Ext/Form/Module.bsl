&НаСервере
Процедура ЗаполнитьТаблицуМультивалютныхДоговоров(УстановитьДанныеПоУмолчанию = Истина)

	ЗаявкаПоМультивалютномуДоговору = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ДоговорКонтрагента, "МультивалютныйДоговор");
	Если НЕ ЗаявкаПоМультивалютномуДоговору Тогда
		Возврат;
	КонецЕсли;
	СтруктураРезультата = МультивалютныеДоговорыСервер.ПолучитьТаблицуМультивалютныхДоговоров(Объект.ДоговорКонтрагента);
	Если СтруктураРезультата.ТаблицаМультивалютныхДоговоров <> Неопределено Тогда
		ТаблицаМультивалютныхДоговоров.Загрузить(СтруктураРезультата.ТаблицаМультивалютныхДоговоров);
	Иначе
		Возврат;
	КонецЕсли;
	Если УстановитьДанныеПоУмолчанию
		И СтруктураРезультата.ТаблицаДоговоровПоУмолчанию.Количество() > 0 Тогда
		Объект.ОплатаВИнойВалюте = Истина;
		//Объект.ДоговорОплаты = СтруктураРезультата.ТаблицаДоговоровПоУмолчанию[0].Договор;
		Объект.ВалютаОплаты = СтруктураРезультата.ТаблицаДоговоровПоУмолчанию[0].Валюта;
		Объект.ДоговорОплаты = СтруктураРезультата.ТаблицаДоговоровПоУмолчанию[0].Договор;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВалютаОплатыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	СписокЗначенийВалют = Новый СписокЗначений;
	Для каждого СтрокаМультивалютныхДоговоров Из ТаблицаМультивалютныхДоговоров Цикл
		СписокЗначенийВалют.Добавить(СтрокаМультивалютныхДоговоров.Валюта);	
	КонецЦикла;                                                            
	ДанныеВыбора = СписокЗначенийВалют;
КонецПроцедуры

&НаКлиенте
Процедура ОплатаВИнойВалютеПриИзменении(Элемент)
	Если Не Объект.ОплатаВИнойВалюте Тогда
		Объект.ВалютаОплаты = ВалютаДоговора;
	КонецЕсли;                               
	ВалютаОплатыПриИзмененииНаСервере();
	УстановитьВидимостьДоступность();
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьДанныеДокументыНаОплату()
	
	МассивДокументовНаОплату = Объект.ДокументыНаОплату.Выгрузить().ВыгрузитьКолонку("ОснованиеДляПлатежа");
	//ДатаОплатыДокументовНаОплату = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивДокументовНаОплату, "ДатаОплаты, ВалютаОплаты");
	НомерДатаВБУДокументовНаОплату = ПолучитьНомерДатаВБУДокументов(МассивДокументовНаОплату, Перечисления.УзлыОбмена.УППЗаказ);  
	// Евросиб(ДИТ) US 73033 ТА 87495 Сержантова А.С. Начало: 12.07.2024
	СтатусДокументовОснований = ПолучитьТекущиеСтатусыИСтатусыЭДО(МассивДокументовНаОплату);
	// Евросиб(ДИТ) US 73033 ТА 87495 Сержантова А.С. Конец: 12.07.2024
	Для каждого ДокументНаОплату Из Объект.ДокументыНаОплату Цикл 
		Если НЕ ЗначениеЗаполнено(ДокументНаОплату.ОснованиеДляПлатежа) Тогда
			Продолжить;
		КонецЕсли;
		//РеквизитыДокументаНаОплату = ДатаОплатыДокументовНаОплату.Получить(ДокументНаОплату.ОснованиеДляПлатежа);
		РеквизитыДокументаНаОплату = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументНаОплату.ОснованиеДляПлатежа, "ДатаОплаты, ВалютаОплаты, Товары, Услуги, НомерВходящегоДокумента, ДатаВходящегоДокумента");
       	Если РеквизитыДокументаНаОплату = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ДокументНаОплату.ДатаОплаты = РеквизитыДокументаНаОплату.ДатаОплаты;
