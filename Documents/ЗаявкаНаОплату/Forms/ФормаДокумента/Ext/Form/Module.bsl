&НаСервере
Функция ПроверитьНДСДляРазнесенияПоЗаявкам()
	
	СтрокиПоСтавкам = Новый Соответствие();

	ТаблицаДокументовОснований = Объект.ДокументыНаОплату.Выгрузить();
	Ставки = ТаблицаДокументовОснований.Скопировать(,"СтавкаНДС");
	Ставки.Свернуть("СтавкаНДС");
	Если Ставки.Количество()> 1 Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДокументыОснования.СтавкаНДС КАК СтавкаНДС,
		|	ДокументыОснования.ОснованиеДляПлатежа КАК Документ,
		|	ДокументыОснования.ИдентификаторСтроки КАК ИдентификаторСтроки
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ДокументыОснования КАК ДокументыОснования
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.СтавкаНДС КАК СтавкаНДС,
		|	ВТ.Документ КАК Документ,
		|	ВТ.ИдентификаторСтроки КАК ИдентификаторСтроки
		|ИЗ
		|	ВТ КАК ВТ";
		Запрос.УстановитьПараметр("ДокументыОснования",ТаблицаДокументовОснований);
		
				
		РезультатЗапроса = Запрос.Выполнить();		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.СледующийПоЗначениюПоля("СтавкаНДС") Цикл 
			МассивСтрок = Новый Массив(); 
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				 МассивСтрок.Добавить(ВыборкаДетальныеЗаписи.Документ);
			КонецЦикла;
			СтрокиПоСтавкам.Вставить(ВыборкаДетальныеЗаписи.СтавкаНДС, МассивСтрок);
		КонецЦикла;	
					
	КонецЕсли;
	Возврат СтрокиПоСтавкам
					
КонецФункции

 &НаКлиенте
Функция ЗадатьВопросПользователю(СтрокиКРазнесению, ПараметрыЗаписи) Экспорт

	СписокКнопок = Новый СписокЗначений;
    СписокКнопок.Добавить(КодВозвратаДиалога.Отмена, "Отмена");
	СписокКнопок.Добавить(КодВозвратаДиалога.Да, "Создать одну заявку");
	СписокКнопок.Добавить(КодВозвратаДиалога.ОК, "Перезаполнить ставку НДС в документах основаниях");

	ОпОп = Новый ОписаниеОповещения("ОбработкаОтветаПользователя", ЭтаФорма, Новый Структура("СтрокиКРазнесению, ПараметрыЗаписи", СтрокиКРазнесению, ПараметрыЗаписи));
    ПоказатьВопрос(ОпОп,"В списке документов на оплату разные Ставки НДС.
						|Выберите дальнейшее действие:",СписокКнопок,60,КодВозвратаДиалога.Да);
	
КонецФункции 

&НаКлиенте	
Процедура ОбработкаОтветаПользователя(ОтветПользователя = Неопределено, ДопПараметры = Неопределено)Экспорт

	Если ОтветПользователя = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	СоответствиеМассивовДокументовДляОтвязки = ДопПараметры.СтрокиКРазнесению;
	
	Если ОтветПользователя = КодВозвратаДиалога.Отмена Тогда
		//СоздатьЗаявкиПоРазнымНДС(СоответствиеМассивовДокументовДляОтвязки);
		Возврат
	ИначеЕсли ОтветПользователя = КодВозвратаДиалога.Да Тогда
		СоздатьОднуЗаявку(ДопПараметры.ПараметрыЗаписи);
	ИначеЕсли ОтветПользователя = КодВозвратаДиалога.ОК Тогда
        Выполнить("ПерезаполнитьСтавкуНДСВДокументахОснования(Истина)"); 
	КонецЕсли;

КонецПроцедуры 

&НаСервере
Функция СоздатьЗаявкиПоРазнымНДС(СоответствиеДляСтавки)
		
	//НачатьТранзакцию();
	//Попытка
	//	Документы.ЗаявкаНаОплату.СоздатьЗаявкиПоРазнымНДС(СоответствиеМассивовДокументовДляОтвязки, Объект);		
	//	Объект.ЗаявкаПоРазнымСтавкамНДС = Истина;
	//	ПересчитатьВсегоПоЗаявкеНаСервере();
	//	ЭтотОбъект.Записать();
	//	ЗафиксироватьТранзакцию();
	//	
	//Исключение
	//	ОбщегоНазначения.СообщитьПользователю("Ошибка создания заявок! " + ОписаниеОшибки());
	//	ОтменитьТранзакцию();
	//	
	//КонецПопытки; 
	
	Ответ = Неопределено;
	
	
	Для Каждого СтрокаПоСтавкеНДС из СоответствиеДляСтавки Цикл
		ОбрабатываемаяСтавка = СтрокаПоСтавкеНДС.Ключ;
		ОбрабатываемыеДокументы = СтрокаПоСтавкеНДС.Значение;
		
		НовЗаявка = Документы.ЗаявкаНаОплату.СоздатьДокумент();
		ДокументДляЗаполнения = ОбрабатываемыеДокументы[0].ОснованиеДляПлатежа;
		СтруктураЗаполнения = Новый Структура("Основание, НеЗаполнятьТЧ", ДокументДляЗаполнения, Истина);
		
		НовЗаявка.Заполнить(СтруктураЗаполнения);
		
		
		Для Каждого ОбрабатываемыйДокумент из ОбрабатываемыеДокументы Цикл;
			НовСтрокаДокументовОплаты = НовЗаявка.ДокументыНаОплату.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрокаДокументовОплаты, ОбрабатываемыйДокумент);
			НовСтрокаДокументовОплаты.ОснованиеДляПлатежа = ОбрабатываемыйДокумент.ОснованиеДляПлатежа;
			ЗаполнитьЗначенияСвойств(НовСтрокаДокументовОплаты, НовЗаявка);
			//ДокументДляЗаполнения = ОбрабатываемыйДокумент.ОснованиеДляПлатежа;				
		КонецЦикла;
		
		НовЗаявка.Дата = ТекущаяДата();
		
		НовЗаявка.ВсегоПоЗаявке = НовЗаявка.ДокументыНаОплату.Итог("СуммаОплаты"); 
		ВалютаДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НовЗаявка.ДоговорКонтрагента, "ВалютаВзаиморасчетов");
		НовЗаявка.ВсегоВВалютеОплаты = РаботаСКурсамиВалют.ПересчитатьВВалюту(НовЗаявка.ВсегоПоЗаявке, ВалютаДоговора, НовЗаявка.ВалютаОплаты, НовЗаявка.ДатаПланируемойОплаты);
		НовЗаявка.Записать(РежимЗаписиДокумента.Запись);
		РегистрыСведений.СтатусыОбъектов.ЗафиксироватьИзменениеСтатусаОбъекта(НовЗаявка.Ссылка, Справочники.СтатусыДокументов.Подготовлена);
	КонецЦикла;		
	
	Ответ =	НовЗаявка.Ссылка;
	
	Возврат Ответ; 	
	
КонецФункции
&НаСервере
