	Если ВыбранныйТип <> Неопределено Тогда
		
		ТекДанные = Объект.ДокументыНаОплату.НайтиПоИдентификатору(ДопПараметры.ИдентификаторТекСтроки);
		Если ВыбранныйТип.Значение = Тип("ДокументСсылка.СчетНаОплатуПоставщика") Тогда
			ТекДанные.ОснованиеДляПлатежа = ПредопределенноеЗначение("Документ.СчетНаОплатуПоставщика.ПустаяСсылка");
		Иначе
			ТекДанные.ОснованиеДляПлатежа = ПредопределенноеЗначение("Документ.ПоступлениеТоваровУслуг.ПустаяСсылка");
		КонецЕсли;		
	КонецЕсли;
	
