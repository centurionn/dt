КонецФункции

&НаСервере
Процедура СформироватьКомандыСозданияЗаявокПоРазнымСтавкамНДС()
		
	ВариантыСтавок = Перечисления.СтавкиНДС;
	Для Каждого ВидСтавки из ВариантыСтавок Цикл
		ВидСтавки = СтрЗаменить(ВидСтавки,"%","");
		ВидСтавки = СтрЗаменить(ВидСтавки,"/","_");
		ВидСтавки = СтрЗаменить(ВидСтавки," ","");

		ЗначениеДляПоиска = "ФормаДокументЗаявкаНаОплатуСоздатьНаОсновании" + ВидСтавки;
		
		НайденныйЭлементФормы = ЭтаФорма.Элементы.Найти(ЗначениеДляПоиска);
		Если НайденныйЭлементФормы <> Неопределено  Тогда
			ЭтаФорма.Элементы.Удалить(НайденныйЭлементФормы); 
		КонецЕсли; 
		ИмяКоманды = "СоздатьНаОснованииЗаявкуНаОплатуПоСтавке" + ВидСтавки;
		НайденныеКоманды = ЭтаФорма.Команды.Найти(ИмяКоманды);
		Если НайденныеКоманды <> Неопределено  Тогда
			ЭтаФорма.Команды.Удалить(НайденныеКоманды); 
		КонецЕсли;
	КонецЦикла;
	
	СтрокиКРазнесению = ПроверитьНДСДляРазнесенияПоЗаявкам();		
	Если СтрокиКРазнесению.Количество() >1 Тогда
		Для Каждого Ставка из СтрокиКРазнесению Цикл			
			СтавкаБезПроцента = ?(Ставка.Ключ = перечисления.СтавкиНДС.БезНДС, Ставка.Ключ, СтрЗаменить(Ставка.Ключ,"%",""));
			СтавкаБезПроцента = СтрЗаменить(СтавкаБезПроцента," ","");
			СтавкаПреобразованная = СтрЗаменить(СтавкаБезПроцента,"/","_");			
			ИмяКоманды = "СоздатьНаОснованииЗаявкуНаОплатуПоСтавке" + СтавкаПреобразованная;
			Команда = Команды.Добавить(ИмяКоманды);
			КнопкаЗаявкаНаОплатуСоздатьНаОсновании = Элементы.Добавить("ФормаДокументЗаявкаНаОплатуСоздатьНаОсновании" + СтавкаПреобразованная, Тип("КнопкаФормы"), Элементы.ГруппаФормированиеЗаявокНаОплату);
			КнопкаЗаявкаНаОплатуСоздатьНаОсновании.Заголовок = "По ставке НДС " + Ставка.Ключ; 
			КнопкаЗаявкаНаОплатуСоздатьНаОсновании.ИмяКоманды = ИмяКоманды;
			КнопкаЗаявкаНаОплатуСоздатьНаОсновании.РасширеннаяПодсказка.Заголовок = СтавкаПреобразованная;
			Команда.Действие = "СоздатьНаОснованииЗаявкаНаОплату";
		КонецЦикла;	
	КонецЕсли; 
		
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНаОснованииЗаявкаНаОплату(Команда) Экспорт
	
	Если Модифицированность Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПродолжитьПослеЗаписиМодифицированного", ЭтотОбъект, Новый Структура("Команда", Команда));
		ПоказатьВопрос(ОписаниеОповещения, "Документ изменен. Для продолжения необходимо записать документ. Продолжить?", РежимДиалогаВопрос.ДаНет, 60);
	Иначе 
		СоздатьЗаявкиНаОплату(Команда); 
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Процедура СоздатьЗаявкиНаОплату(Команда, ВопросЗадан = Ложь)

	Ставка = СтрЗаменить(Команда.Имя,"СоздатьНаОснованииЗаявкуНаОплатуПоСтавке","");
	Если Ставка = "БезНДС" Тогда
		Ставка = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС");
	Иначе
		Ставка = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС"+Ставка);
	КонецЕсли;
	
	НоваяЗаявка = СоздатьЗаявкуПоВыбраннойСтавке(Ставка);
		
	Если НЕ НоваяЗаявка = Неопределено Тогда
		ПоказатьЗначение(,НоваяЗаявка);
	КонецЕсли;
	
	
КонецПроцедуры 

&НаСервере
Функция СоздатьЗаявкуПоВыбраннойСтавке(Ставка)
	
	СтруктураПоиска = Новый Структура("СтавкаНДС",Ставка);
	СтрокиПоТекущейСтавке = Объект.ДокументыНаОплату.НайтиСтроки(СтруктураПоиска);
	СоответствиеДляСтавки = Новый Соответствие;
	
	НоваяЗаявка = Неопределено;
	Если СтрокиПоТекущейСтавке <> Неопределено Тогда 
		МассивДокументов = Новый Массив;
		МассивСтрокДляУдаления = Новый Массив;
		Для Каждого ДокументОснования из СтрокиПоТекущейСтавке Цикл
			МассивДокументов.Добавить(ДокументОснования);
			МассивСтрокДляУдаления.Добавить(ДокументОснования);
		КонецЦикла;
		СоответствиеДляСтавки.Вставить(Ставка, МассивДокументов);
		
		НачатьТранзакцию();
		Отказ = Ложь;
		Попытка 
			НоваяЗаявка = СоздатьЗаявкиПоРазнымНДС(СоответствиеДляСтавки);
		Исключение
			Отказ = Истина;
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
		КонецПопытки;	
		
		Если не Отказ Тогда
			Для Каждого УдаляемаяСтрока из МассивСтрокДляУдаления Цикл 
				Объект.ДокументыНаОплату.Удалить(УдаляемаяСтрока);
			КонецЦикла;
			СтрокиКРазнесению = ПроверитьНДСДляРазнесенияПоЗаявкам();		
			Если СтрокиКРазнесению.Количество() = 0 и Объект.ЗаявкаПоРазнымСтавкамНДС Тогда
				Объект.ЗаявкаПоРазнымСтавкамНДС = Ложь;
			КонецЕсли;
					
			ПересчитатьВсегоПоЗаявкеНаСервере();

			ПроверкаЗаписи = ЭтотОбъект.Записать();
			Если НЕ ПроверкаЗаписи Тогда 
				Отказ = Истина;
				ОбщегоНазначения.СообщитьПользователю("Не удалось записать изменения по документу " + Объект.Ссылка+ ". Перенос документов основания по ставке " + Ставка + " был отменен.");
			Иначе
				ОбщегоНазначения.СообщитьПользователю("Создана " + НоваяЗаявка);
			КонецЕсли;	
		КонецЕсли; 	
		
		Если Отказ Тогда
			ОтменитьТранзакцию();
			НоваяЗаявка = Неопределено;
		Иначе
			ЗафиксироватьТранзакцию();
		КонецЕсли;	
	КонецЕсли;
	Возврат НоваяЗаявка
	
КонецФункции

&НаКлиенте
Процедура ДокументыНаОплатуПослеУдаления(Элемент)
	
	Если Объект.ЗаявкаПоРазнымСтавкамНДС Тогда	
		СтрокиКРазнесению = ПроверитьНДС();		
		Если СтрокиКРазнесению.Количество() = 0 Тогда
			Объект.ЗаявкаПоРазнымСтавкамНДС = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявкаПоРазнымСтавкамНДСПриИзменении(Элемент)
	
	Если Объект.ЗаявкаПоРазнымСтавкамНДС Тогда
		Для Каждого ДокументНаОплату Из Объект.ДокументыНаОплату Цикл 
			ИдентификаторСтроки = ДокументНаОплату.ПолучитьИдентификатор();
			ВернутьСтавкуНдсДоИзменения(ИдентификаторСтроки);
			ЗаполнитьНДСПоСтроке(ИдентификаторСтроки);
		КонецЦикла;		
	Иначе
		ОписаниеОповещения = Новый ОписаниеОповещения("ПродолжитьПерезаполнитьСтавкуНДС", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, "Ставка НДС в Заявке будет перезаполнена по первой строке списка документов на оплату.
					   |Продолжить?", РежимДиалогаВопрос.ДаНет, 60);
		
	КонецЕсли;
	
КонецПроцедуры    

&НаКлиенте
Процедура ПродолжитьПерезаполнитьСтавкуНДС(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Нет или РезультатВопроса = Неопределено Тогда
		Объект.ЗаявкаПоРазнымСтавкамНДС = Истина;
		Возврат;
	КонецЕсли; 
	
	Если НЕ Объект.ЗаявкаПоРазнымСтавкамНДС и ЗначениеЗаполнено(Объект.ДокументыНаОплату[0].СтавкаНДС) Тогда
		СтавкаНДС = Объект.ДокументыНаОплату[0].СтавкаНДС;
		Для Каждого ДокументОснование Из Объект.ДокументыНаОплату Цикл
			Если ТипЗнч(ДокументОснование.ОснованиеДляПлатежа) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
				Продолжить;
			КонецЕсли;
			ДокументОснование.СтавкаНДС = СтавкаНДС;
			ИдентификаторСтроки = ДокументОснование.ПолучитьИдентификатор();
			ЗаполнитьНДСПоСтроке(ИдентификаторСтроки);
		КонецЦикла;	  
	КонецЕсли; 
	
КонецПроцедуры

