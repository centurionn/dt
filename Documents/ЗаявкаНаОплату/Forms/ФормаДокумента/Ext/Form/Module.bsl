	Если ПользовательВходитВГруппуРазрешенных 
		ИЛИ Пользователи.ТекущийПользователь() = Объект.Автор Тогда
	    Возврат Истина;
	Иначе	
	    Возврат Ложь;
	КонецЕсли;	
