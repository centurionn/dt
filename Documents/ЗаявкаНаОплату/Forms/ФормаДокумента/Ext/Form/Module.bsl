&НаСервере
Процедура УстановитьТекущийСтатусДокумента()
	
	СтатусДокумента = Справочники.СтатусыДокументов.Подготовлена;
	//Евросиб СубботинВ #103435 27.02.2025 Начало
	//ТекущийСтатус = РегистрыСведений.СтатусыОбъектов.ПолучитьПоследнее(, Новый Структура("Объект", Объект.Ссылка));
	ТекущийСтатус = РегистрыСведений.СтатусыОбъектов.ПолучитьПоследнееЗначениеСтатуса(Объект.Ссылка);
	 //Евросиб СубботинВ #103435 27.02.2025 Начало

	Если ЗначениеЗаполнено(ТекущийСтатус.Статус) Тогда
		СтатусДокумента = ТекущийСтатус.Статус;  
	КонецЕсли; 
	
	Если не ЗначениеЗаполнено(СтатусДокументаПервичный) и ЗначениеЗаполнено(ТекущийСтатус.Статус) Тогда
		СтатусДокументаПервичный = СтатусДокумента;
	КонецЕсли;
	
	//Евросиб СубботинВ #103435 27.02.2025 Начало
	////Евросиб СубботинВ #128762 04.02.2026 Начало 
	//Если ЗначениеЗаполнено(ТекущийСтатус.Комментарий)Тогда 
	Если ЗначениеЗаполнено(ТекущийСтатус.Комментарий)
		и (ТекущийСтатус.Статус = Справочники.СтатусыДокументов.ОтклоненаВУПП
		или ТекущийСтатус.Статус = Справочники.СтатусыДокументов.НеСогласована
		или ТекущийСтатус.Статус = Справочники.СтатусыДокументов.ВыгруженаВКЦ) Тогда
		////Евросиб СубботинВ #111466 09.06.2025 Начало
		//Если НЕ ТекущийСтатус.Статус = Справочники.СтатусыДокументов.ИзмененаДатаОплатыВУПП Тогда
		//Евросиб СубботинВ #128762 04.02.2026 Конец
		ПричинаОтклонения = СтрЗаменить(ТекущийСтатус.Комментарий, Символы.ПС, ". ");
		//Евросиб СубботинВ #128762 04.02.2026 Начало 
		//КонецЕсли;
		////Евросиб СубботинВ #111466 09.06.2025 Конец
		//Евросиб СубботинВ #128762 04.02.2026 Конец
	КонецЕсли;	
	//Евросиб СубботинВ #103435 27.02.2025 Конец
	
