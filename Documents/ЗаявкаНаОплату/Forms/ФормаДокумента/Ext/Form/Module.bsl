// Евросиб(ДИТ) US 73033 ТА 87495 Сержантова А.С. 12.07.2024  
&НаСервереБезКонтекста
Функция ПолучитьТекущиеСтатусыИСтатусыЭДО(МассивОбъектов) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Диадок_Документы.Документ КАК Объект,
		|	Диадок_Документы.Статус КАК СтатусЭДО,
		|	ПоступлениеТоваровУслуг.СтатусДокумента КАК СтатусДокумента
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Диадок_Документы КАК Диадок_Документы
		|		ПО ПоступлениеТоваровУслуг.Ссылка = Диадок_Документы.Документ
		|ГДЕ
		|	ПоступлениеТоваровУслуг.Ссылка В(&СписокОбъектов)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Диадок_Документы.Документ,
		|	Диадок_Документы.Статус,
		|	ЗНАЧЕНИЕ(Перечисление.СтатусыДокументовПоступлений.ПустаяСсылка)
		|ИЗ
		|	Документ.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Диадок_Документы КАК Диадок_Документы
		|		ПО СчетНаОплатуПокупателю.Ссылка = Диадок_Документы.Документ
		|ГДЕ
		|	СчетНаОплатуПокупателю.Ссылка В(&СписокОбъектов)";
	
	Запрос.УстановитьПараметр("СписокОбъектов", МассивОбъектов);
	
	РезультатЗапроса = Запрос.Выполнить(); 
	СоответствиеОбъектов = Новый Соответствие;
	Если не РезультатЗапроса.Пустой() Тогда
		ВыборкаРезультатаЗапроса = РезультатЗапроса.Выбрать();
		Пока ВыборкаРезультатаЗапроса.Следующий() Цикл
			СтруктураДанных = Новый Структура("СтатусЭДО, СтатусДокумента");
			ЗаполнитьЗначенияСвойств(СтруктураДанных, ВыборкаРезультатаЗапроса);
			СоответствиеОбъектов.Вставить(ВыборкаРезультатаЗапроса.Объект, СтруктураДанных);
		КонецЦикла;
	КонецЕсли;
	Возврат СоответствиеОбъектов;

КонецФункции     

// Евросиб(ДИТ) US 73033 ТА 87495 Сержантова А.С. 12.07.2024 
&НаСервереБезКонтекста
Функция ПолучитьДанныеКорПТУ(МассивОбъектов, КраткоеСодержание = Ложь)

	Если ТипЗнч(МассивОбъектов) <> Тип("Массив") Тогда
		МассивПТУ = Новый Массив;
		МассивПТУ.Добавить(МассивОбъектов);
	Иначе	
	    МассивПТУ = МассивОбъектов;
	КонецЕсли;
	
	СоответствиеОбъектов = Новый Соответствие;
	Если КраткоеСодержание Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДокументКорректировкаПоступления.Ссылка КАК Ссылка,
		|	ДокументКорректировкаПоступления.Номер КАК НомерКорПТУ,
		|	ДокументКорректировкаПоступления.Дата КАК ДатаКорПТУ,
		|	ПоступлениеТоваровУслуг.Номер КАК НомерПТУ,
		|	ПоступлениеТоваровУслуг.Дата КАК ДатаПТУ,
		|	ПоступлениеТоваровУслуг.Ссылка КАК ПТУ
		|ИЗ
		|	Документ.КорректировкаПоступления КАК ДокументКорректировкаПоступления
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураПолученный КАК СчетФактураПолученный
		|		ПО ДокументКорректировкаПоступления.Ссылка = СчетФактураПолученный.ДокументОснование
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|		ПО ДокументКорректировкаПоступления.ДокументПоступления = ПоступлениеТоваровУслуг.Ссылка
		|ГДЕ
		|	ДокументКорректировкаПоступления.ДокументПоступления В(&МассивПТУ)
		|	И ДокументКорректировкаПоступления.Проведен";
		
		Запрос.УстановитьПараметр("МассивПТУ", МассивПТУ);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			СтруктураДанных = Новый Структура("НомерПТУ, ДатаПТУ, НомерКорПТУ, ДатаКорПТУ");
			ЗаполнитьЗначенияСвойств(СтруктураДанных, Выборка);
			СоответствиеОбъектов.Вставить(Выборка.ПТУ, СтруктураДанных);	
		КонецЦикла;
		Возврат СоответствиеОбъектов;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДокументКорректировкаПоступления.ДокументПоступления КАК ПТУ,
		|	ДокументКорректировкаПоступления.Ссылка КАК КорректировкаПТУ,
		|	ЕстьNULL(СчетФактураПолученный.НомерВходящегоДокумента, """") КАК НомерВСФ,
		|	ЕстьNULL(СчетФактураПолученный.ДатаВходящегоДокумента, """") КАК ДатаВСФ,
		|	ЕстьNULL(СчетФактураПолученный.НомерИсходногоДокумента, """") КАК НомерИсходногоВСФ,
		|	ЕстьNULL(СчетФактураПолученный.ДатаИсходногоДокумента, """") КАК ДатаИсходногоВСФ,
		|	ДокументКорректировкаПоступления.ПолнаяСуммаВСФ КАК ПолнаяСуммаВСФ,
		|	ВЫБОР
		|		КОГДА СУММА(КорректировкаПоступленияУслуги.СуммаДоКорректировки) = 0
		|			ТОГДА СУММА(КорректировкаПоступленияУслуги.СуммаДоИзменения)
		|		ИНАЧЕ СУММА(КорректировкаПоступленияУслуги.СуммаДоКорректировки)
		|	КОНЕЦ КАК СуммаДоКорректировки,
		|	ВЫБОР
		|		КОГДА СУММА(КорректировкаПоступленияУслуги.СуммаНДСДоКорректировки) = 0
		|			ТОГДА СУММА(КорректировкаПоступленияУслуги.СуммаНДСДоИзменения)
		|		ИНАЧЕ СУММА(КорректировкаПоступленияУслуги.СуммаНДСДоКорректировки)
		|	КОНЕЦ КАК СуммаНДСДоКорректировки,
		|	ВЫБОР
		|		КОГДА СУММА(КорректировкаПоступленияУслуги.ВсегоДоКорректировки) = 0
		|			ТОГДА СУММА(КорректировкаПоступленияУслуги.ВсегоДоИзменения)
		|		ИНАЧЕ СУММА(КорректировкаПоступленияУслуги.ВсегоДоКорректировки)
		|	КОНЕЦ КАК ВсегоДоКорректировки,
		|	ЕстьNULL(СчетФактураПолученный.СуммаУвеличение, 0) КАК СуммаУвеличение,
		|	ЕстьNULL(СчетФактураПолученный.СуммаНДСУвеличение, 0) КАК СуммаНДСУвеличение,
		|	ЕстьNULL(СчетФактураПолученный.СуммаУменьшение, 0) КАК СуммаУменьшение,
		|	ЕстьNULL(СчетФактураПолученный.СуммаНДСУменьшение, 0) КАК СуммаНДСУменьшение,
		|	СУММА(КорректировкаПоступленияУслуги.РазницаВсегоКорректировки) КАК ОбщаяРазность,
		|	СУММА(КорректировкаПоступленияУслуги.Сумма) КАК СуммаПослеКорректировки,
		|	СУММА(КорректировкаПоступленияУслуги.СуммаНДС) КАК СуммаНДСПослеКорректировки,
		|	СУММА(КорректировкаПоступленияУслуги.Всего) КАК ВсегоПослеКорректировки
		|ИЗ
		|	Документ.КорректировкаПоступления.Услуги КАК КорректировкаПоступленияУслуги
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КорректировкаПоступления КАК ДокументКорректировкаПоступления
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураПолученный КАК СчетФактураПолученный
		|			ПО ДокументКорректировкаПоступления.Ссылка = СчетФактураПолученный.ДокументОснование
		|		ПО КорректировкаПоступленияУслуги.Ссылка = ДокументКорректировкаПоступления.Ссылка
		|ГДЕ
		|	ДокументКорректировкаПоступления.ДокументПоступления В(&МассивПТУ)
		|	И ДокументКорректировкаПоступления.Проведен
		|
		|СГРУППИРОВАТЬ ПО
		|	ДокументКорректировкаПоступления.Ссылка,
		|	СчетФактураПолученный.НомерВходящегоДокумента,
		|	СчетФактураПолученный.ДатаВходящегоДокумента,
		|	СчетФактураПолученный.НомерИсходногоДокумента,
		|	СчетФактураПолученный.ДатаИсходногоДокумента,
		|	ДокументКорректировкаПоступления.ПолнаяСуммаВСФ,
		|	СчетФактураПолученный.СуммаУвеличение,
		|	СчетФактураПолученный.СуммаНДСУвеличение,
		|	СчетФактураПолученный.СуммаУменьшение,
		|	СчетФактураПолученный.СуммаНДСУменьшение";
	
	Запрос.УстановитьПараметр("МассивПТУ", МассивПТУ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		СтруктураДанных = Новый Структура("ПТУ, КорректировкаПТУ, СуммаДоКорректировки, СуммаНДСДоКорректировки, ВсегоДоКорректировки,"
										  + "СуммаУвеличение, СуммаНДСУвеличение, СуммаУменьшение, СуммаНДСУменьшение, ОбщаяРазность,"
										  + "СуммаПослеКорректировки, СуммаНДСПослеКорректировки, ВсегоПослеКорректировки, НомерВСФ, ДатаВСФ,"
										  + "НомерИсходногоВСФ, ДатаИсходногоВСФ");
		ЗаполнитьЗначенияСвойств(СтруктураДанных, Выборка);
		СоответствиеОбъектов.Вставить(Выборка.ПТУ, СтруктураДанных);	
	КонецЦикла;
	Возврат СоответствиеОбъектов;

КонецФункции 

