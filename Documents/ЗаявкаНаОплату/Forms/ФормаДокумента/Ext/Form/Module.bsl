Функция ПользователюРазрешеноИзменитьСтатус()  
	
	ПользовательВходитВГруппуРазрешенных = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ГруппыПользователейСостав.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ГруппыПользователей.Состав КАК ГруппыПользователейСостав
		|ГДЕ
		|	ГруппыПользователейСостав.Ссылка = &Ссылка
		|	И ГруппыПользователейСостав.Пользователь = &Пользователь";
	
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	Запрос.УстановитьПараметр("Ссылка", Справочники.ГруппыПользователей.ПроизводственнаяДирекция);
	
	РезультатЗапроса = Запрос.Выполнить();
