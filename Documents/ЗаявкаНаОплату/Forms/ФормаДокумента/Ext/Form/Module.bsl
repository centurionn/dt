&НаСервере
Процедура ЗаполнитьДокументыОплатыИСтатусОплаты()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаявкиНаРасходованиеДенежныхСредствОбороты.Регистратор КАК ДокументОплаты,
		|	ВЫБОР
		|		КОГДА ЗаявкиНаРасходованиеДенежныхСредствОбороты.СуммаОборот < 0
		|			ТОГДА ЗаявкиНаРасходованиеДенежныхСредствОбороты.СуммаОборот * -1
		|		ИНАЧЕ ЗаявкиНаРасходованиеДенежныхСредствОбороты.СуммаОборот
		|	КОНЕЦ КАК СуммаВВалютеОплаты,
		|	ЗаявкиНаРасходованиеДенежныхСредствОбороты.Валюта КАК ВалютаОплаты,
		|	ВЫБОР
		|		КОГДА ЗаявкиНаРасходованиеДенежныхСредствОбороты.Регистратор ССЫЛКА Документ.ПоступлениеНаРасчетныйСчет
		|			ТОГДА ВЫРАЗИТЬ(ЗаявкиНаРасходованиеДенежныхСредствОбороты.Регистратор КАК Документ.ПоступлениеНаРасчетныйСчет).ВидОперации
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК ВидОперации,
		|	ДоговорыКонтрагентов.ВалютаВзаиморасчетов КАК ВалютаДоговора
		|ИЗ
		|	РегистрНакопления.ЗаявкиНаРасходованиеДенежныхСредств.Обороты(, , Регистратор, ЗаявкаНаОплату = &Ссылка) КАК ЗаявкиНаРасходованиеДенежныхСредствОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|		ПО ЗаявкиНаРасходованиеДенежныхСредствОбороты.ЗаявкаНаОплату.ДоговорКонтрагента = ДоговорыКонтрагентов.Ссылка
		|ГДЕ
		|	НЕ ЗаявкиНаРасходованиеДенежныхСредствОбороты.Регистратор = &Регистратор";
	
	Запрос.УстановитьПараметр("Регистратор", Объект.Ссылка);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	ДокументыОплаты.Загрузить(РезультатЗапроса);
	Для Каждого СтрокаОплаты из ДокументыОплаты Цикл
		  СтрокаОплаты.СуммаВВалютеДоговора = РаботаСКурсамиВалют.ПересчитатьВВалюту(СтрокаОплаты.СуммаВВалютеОплаты,
		 									  СтрокаОплаты.ВалютаОплаты, СтрокаОплаты.ВалютаДоговора, Объект.ДатаПланируемойОплаты);
	КонецЦикла;										  
	Если не РезультатЗапроса.Количество() =0 Тогда
		ПараметрыПоиска = Новый Структура("ВидОперации", Перечисления.ВидыОперацийПоступлениеДенежныхСредств.ВозвратОтПоставщика);
		Если РезультатЗапроса.НайтиСтроки(ПараметрыПоиска).Количество() > 0 Тогда
			Оплачен = Перечисления.СостоянияОплаты.Возврат;
		Иначе 
			СуммаОплат = РезультатЗапроса.Итог("СуммаВВалютеОплаты");
			Если СуммаОплат = Объект.ВсегоПоЗаявке Тогда
				Оплачен = Перечисления.СостоянияОплаты.ОплаченПолностью; 
			ИначеЕсли СуммаОплат > Объект.ВсегоПоЗаявке Тогда 
				Оплачен = Перечисления.СостоянияОплаты.Переплата;
			Иначе Оплачен = Перечисления.СостоянияОплаты.ОплаченЧастично;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
