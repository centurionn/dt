&НаКлиенте
Процедура ДоговорКонтрагентаПриИзменении(Элемент)
	
	//Евросиб СубботинВ #110279 23.07.2025 Начало
	Сч = 1;
	Пока Сч <= Объект.ДокументыНаОплату.Количество() Цикл
		Если Объект.ДокументыНаОплату[Сч - 1].ОснованиеДляПлатежа = Неопределено Тогда
			Объект.ДокументыНаОплату.Удалить(Сч - 1);
		Иначе
			Сч = Сч + 1;
		КонецЕсли;
	КонецЦикла;
	//Евросиб СубботинВ #110279 23.07.2025 Конец
	
	ЗаполнитьТаблицуМультивалютныхДоговоров(Истина);
	РеквизитыДоговораКонтрагента = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(Объект.ДоговорКонтрагента, "МультивалютныйДоговор, ВалютаВзаиморасчетов, ОтветственныйЗаДоговор");
	ЗаявкаПоМультивалютномуДоговору = РеквизитыДоговораКонтрагента.МультивалютныйДоговор;
	ВалютаДоговора = РеквизитыДоговораКонтрагента.ВалютаВзаиморасчетов;
	Объект.ОтветственныйЗаОплату = РеквизитыДоговораКонтрагента.ОтветственныйЗаДоговор;
	Объект.ОплатаВИнойВалюте = Ложь;
	УстановитьВидимостьДоступность();
	
	//Евросиб СубботинВ #89533 10.09.2024 Начало 
	Если ЗначениеЗаполнено(Объект.ОтветственныйЗаОплату) Тогда
		Объект.ПодразделениеДКП = ПолучитьГруппуДКППользователя(Объект.ОтветственныйЗаОплату);
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.ОтветственныйЗаОплату) Тогда
		Объект.ПодразделениеДКП = ПредопределенноеЗначение("Справочник.ГруппыПользователей.ПустаяСсылка");
	КонецЕсли;
	ПерезаполнитьДанныеТЧДокументыНаОплату(Объект.ОтветственныйЗаОплату, Объект.ПодразделениеДКП);
	//Евросиб СубботинВ #89533 10.09.2024 Конец 
	
	//Евросиб СубботинВ #89541 16.10.2024 Начало
	Если  Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаявкиНаОплату.ОплатаПоставщику") и ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(Объект.ДоговорКонтрагента,"УсловиеОплаты") = ПредопределенноеЗначение("Перечисление.ВидыУсловийОплаты.ОплатаПоФакту") Тогда
 		Элементы.ДанныеПТУ.Видимость = Истина;
	Иначе
		Элементы.ДанныеПТУ.Видимость = Ложь;
	КонецЕсли;
	//Евросиб СубботинВ #89541 16.10.2024 Конец 
	
	
	//Евросиб СубботинВ #96807 17.12.2024 Начало
	Если Объект.ПодразделениеДКП = ПредопределенноеЗначение("Справочник.ГруппыПользователей.ОтделАренды")Тогда
		Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаявкиНаОплату.ОплатаАренды"); 
	КонецЕсли;	
	//Евросиб СубботинВ #96807 17.12.2024 Конец
	
КонецПроцедуры

