		Запрос.УстановитьПараметр("ДатаНачала", ПериодОплаты.ДатаНачала);
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&ДатаНачала", "СтатусыОбъектовСрезПоследних.Объект.ДатаПланируемойОплаты >= &ДатаНачала");
	ИначеЕсли ВыбранныеДатыРеестра.Количество()>0 Тогда
		Запрос.УстановитьПараметр("ДатаНачала", ВыбранныеДатыРеестра);;
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&ДатаНачала", "СтатусыОбъектовСрезПоследних.Объект.ДатаПланируемойОплаты В (&ДатаНачала)");
	Иначе
		Запрос.УстановитьПараметр("ДатаНачала", Истина);			
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПериодОплаты.ДатаОкончания) Тогда
		Запрос.УстановитьПараметр("ДатаОкончания", ПериодОплаты.ДатаОкончания);
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&ДатаОкончания", "СтатусыОбъектовСрезПоследних.Объект.ДатаПланируемойОплаты <= &ДатаОкончания");
	Иначе 
		Запрос.УстановитьПараметр("ДатаОкончания", Истина);			
	КонецЕсли;
	
	СтатусыЭтапов = Новый Массив ;
	СтатусыЭтапов.Добавить(Перечисления.СтатусыЭтапов.НаВыполнение);
	СтатусыЭтапов.Добавить(Перечисления.СтатусыЭтапов.ВРаботе);
	СтатусыЭтапов.Добавить(СтатусЭтапаВыполнен);

    Запрос.УстановитьПараметр("СтатусыЭтапов", СтатусыЭтапов);
	
	//Евросиб СубботинВ #117172 18.08.2025 Начало
	ИсполнителиИЗамещения = Пользователи_sd_Сервер.ПодобратьЗамещениеОбратное(ТекущийПользователь, ТекущаяДата());
    //Запрос.УстановитьПараметр("ТекущийПользователь", ТекущийПользователь);
	Запрос.УстановитьПараметр("Пользователи", ИсполнителиИЗамещения);
	//Евросиб СубботинВ #117172 18.08.2025 Конец

	
	//Евросиб СубботинВ #103435 27.02.2025 Начало
	Запрос.УстановитьПараметр("ДКП", Справочники.ГруппыПользователей.ДирекцияКонтейнерныхПеревозок);
	Запрос.УстановитьПараметр("ВыводитьСогласованные", ВыводитьСогласованные);
	//Евросиб СубботинВ #103435 27.02.2025 Конец
  
	МассивСтатусовДляЗапроса = Новый Массив;
	МассивСтатусовДляЗапроса.Добавить(Справочники.СтатусыДокументов.НаСогласование);
	Если ВыводитьСогласованные Тогда
		МассивСтатусовДляЗапроса.Добавить(Справочники.СтатусыДокументов.Согласована);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Статус", МассивСтатусовДляЗапроса); 
	Запрос.УстановитьПараметр("ВалютаРубль", Константы.ВалютаРегламентированногоУчета.Получить());
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	СписокЗаявокНаОплату.Загрузить(РезультатЗапроса);
	
	ПодсчитатьИтоги();
КонецПроцедуры

&НаКлиенте
Процедура ПериодОплатыПриИзменении(Элемент)
	
	Если ВыбранныеДатыРеестра.Количество()>0 Тогда
		ВыбранныеДатыРеестра.Очистить();
	КонецЕсли;
	
//	СФормироватьСписокЗаявок();
КонецПроцедуры

&НаКлиенте
Процедура Согласовано(Команда)
	
	ОбработатьВыбранныеСтроки(СтатусЭтапаВыполнен);
	
КонецПроцедуры  

&НаСервере
Процедура ОбработатьВыбранныеСтроки(ПроставляемыйСтатус)
	
	СтруктураПоиска = Новый Структура("Выбрать", Истина);
	ВыбранныеСтроки = СписокЗаявокНаОплату.НайтиСтроки(СтруктураПоиска);
	// Евросиб US 106410 TA 106412 Рыбьяков К.А. 10.07.2025 ((
	Если ПроставляемыйСтатус = СтатусЭтапаВыполнен Тогда
		Отказ = ЕстьНеЗавершенныйДокументооборот(ВыбранныеСтроки);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 10.07.2025 ))
	Для Каждого ВыбраннаяСтрока из ВыбранныеСтроки Цикл		
		МассивЗадач = Новый Массив();
		МассивЗадач.Добавить(ВыбраннаяСтрока.Состояние);
		Если ПроставляемыйСтатус = СтатусЭтапаОтклонен Тогда
			//Евросиб СубботинВ #103435 27.02.2025 Начало // если нет причины отклонения, такую строчку пропускаем и информируем пользователя
			Если Не ЗначениеЗаполнено(ВыбраннаяСтрока.Комментарий) тогда
				ОбщегоНазначения.СообщитьПользователю("Для отклонения необходимо заполнить комментарий по строке с "+  ВыбраннаяСтрока.ЗаявкаНаОплату);
				Продолжить;	
			КонецЕсли;
			//Евросиб СубботинВ #103435 27.02.2025 Конец			
			ОтметитьВыполнениеЗадачПоСсылке(ВыбраннаяСтрока.ЗаявкаНаОплату, МассивЗадач, ПроставляемыйСтатус, Перечисления.СтатусыСогласования.ОтклоненоБезЗамечаний, Истина);
			//Евросиб СубботинВ #103435 27.02.2025 Начало //
			//РегистрыСведений.СтатусыОбъектов.ЗафиксироватьИзменениеСтатусаОбъекта(ВыбраннаяСтрока.ЗаявкаНаОплату, Справочники.СтатусыДокументов.НеСогласована); 
			РегистрыСведений.СтатусыОбъектов.ЗафиксироватьИзменениеСтатусаОбъекта(ВыбраннаяСтрока.ЗаявкаНаОплату, Справочники.СтатусыДокументов.НеСогласована,,,ВыбраннаяСтрока.Комментарий); 
			//Евросиб СубботинВ #103435 27.02.2025 Конец
			//Евросиб СубботинВ #107464 05.06.2025 Начало
			Если Справочники.СобытияОтправкиДокументов.ОтклонениеЗаявкиВDC.ОтправкаПисемПоСобытию Тогда
				РассылкаУведомленийПользователям.СформироватьЗаписиСобытийИзменений(ВыбраннаяСтрока.ЗаявкаНаОплату,
																				Справочники.СобытияОтправкиДокументов.ОтклонениеЗаявкиВDC);
			КонецЕсли;																	
			//Евросиб СубботинВ #107464 05.06.2025 Конец			
		ИначеЕсли ПроставляемыйСтатус = СтатусЭтапаВыполнен Тогда
			ОтметитьВыполнениеЗадачПоСсылке(ВыбраннаяСтрока.ЗаявкаНаОплату, МассивЗадач, ПроставляемыйСтатус, Перечисления.СтатусыСогласования.СогласованоБезЗамечаний);
			//РегистрыСведений.СтатусыОбъектов.ЗафиксироватьИзменениеСтатусаОбъекта(ВыбраннаяСтрока.ЗаявкаНаОплату, Справочники.СтатусыДокументов.Отклонен); 
			СтатусДокумента = ПроверкаСтатусаЗаявки(ВыбраннаяСтрока.ЗаявкаНаОплату);
			Если НЕ СтатусДокумента = Неопределено Тогда
				РегистрыСведений.СтатусыОбъектов.ЗафиксироватьИзменениеСтатусаОбъекта(ВыбраннаяСтрока.ЗаявкаНаОплату, СтатусДокумента);	
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
	СФормироватьСписокЗаявок();
	//Евросиб СубботинВ #125358 24.12.2025 Начало // после согласования/не согласования нужно вернуть галки по оставшимся фильтрам, как они были проставлены
	//СформироватьТаблицыДляОтбора(Истина);
	СформироватьТаблицыДляОтбора(, Истина);
	//Евросиб СубботинВ #125358 24.12.2025 Конец
    СформироватьОтборСтрок();
	// Евросиб US 106410 TA 106412 Рыбьяков К.А. 05.08.2025 ((
	СтатусыЭДОДокументовПТУ();
	// Евросиб Рыбьяков К.А. 05.08.2025 ))
КонецПроцедуры 
&НаСервере
Процедура ОтметитьВыполнениеЗадач(Объект, ЗадачиДляОтметкиВыполнения = Неопределено, ПроставляемыйСтатус, СтатусСогласования) Экспорт
	
	ДатаВыполнения = ТекущаяДата();	
	
	Для Каждого СтрокаТЧ Из Объект.Состояния Цикл
		Если ЗадачиДляОтметкиВыполнения.Найти(СтрокаТЧ.Состояние) <> Неопределено И СтрокаТЧ.Статус <> СтатусЭтапаВыполнен И СтрокаТЧ.Статус <> СтатусЭтапаОтклонен Тогда
			СтрокаТЧ.Статус = ПроставляемыйСтатус;
			СтрокаТЧ.ЗавершениеРаботы = ДатаВыполнения;
			СтрокаТЧ.Исполнитель = ТекущийПользователь;
			СтрокаТЧ.СтатусСогласования = СтатусСогласования;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
 &НаСервере
Процедура ОтметитьВыполнениеЗадачПоСсылке(Ссылка, ЗадачиДляОтметкиВыполнения = Неопределено, ПроставляемыйСтатус = Истина, СтатусСогласования = Неопределено, ЗадачаНаРедактирование = Ложь) Экспорт
	
	Объект = Ссылка.ПолучитьОбъект();
	ОтметитьВыполнениеЗадач(Объект, ЗадачиДляОтметкиВыполнения, ПроставляемыйСтатус, СтатусСогласования);
	
	//Евросиб СубботинВ #103435 27.02.2025 Начало
	Если ЗадачаНаРедактирование тогда
		ЗаявкиНаОплатуСервер.ОтправитьДокументНаРедактирование(Объект);
	КонецЕсли;
	//Евросиб СубботинВ #103435 27.02.2025 Конец	

	Если Объект.Модифицированность() Тогда
		Объект.ДополнительныеСвойства.Вставить("ЭтоЗакрытиеЗадач");
		Объект.Записать();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НеСогласовано(Команда)
	
	ОбработатьВыбранныеСтроки(СтатусЭтапаОтклонен);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьСписокЗаявокПоДатам(Команда)
	
	Если не ЗначениеЗаполнено(ПериодОплаты) и ВыбранныеДатыРеестра.Количество()=0 и ВыводитьСогласованные = Истина тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Укажите период оплаты документов");
		Возврат;
	КонецЕсли;

	СФормироватьСписокЗаявок();
	СформироватьТаблицыДляОтбора(Истина);
	СформироватьОтборСтрок();
	
КонецПроцедуры


 &НаСервере
Функция ПроверкаСтатусаЗаявки(Заявка)
	
	СтатусДокумента = Неопределено;
	ТаблицаСостояний = Заявка.Состояния.Выгрузить(); 
	Если НЕ ТаблицаСостояний.Количество() = 0 Тогда	
		СтруктураПоиска = Новый Структура("СтатусСогласования", Перечисления.СтатусыСогласования.СогласованоБезЗамечаний);
		СтатусыСогласовано = ТаблицаСостояний.НайтиСтроки(СтруктураПоиска);
		//СтруктураПоиска = Новый Структура("СтатусСогласования", Перечисления.СтатусыСогласования.ОтклоненоБезЗамечаний);
		//СтатусыОтклонено = ТаблицаСостояний.НайтиСтроки(СтруктураПоиска);
		Если СтатусыСогласовано.Количество() = ТаблицаСостояний.Количество() Тогда //Документ Согласован
			СтатусДокумента = Справочники.СтатусыДокументов.Согласована;
		//ИначеЕсли СтатусыОтклонено.Количество()>0 Тогда //Документ отклонен
		//		СтатусДокумента = Справочники.СтатусыДокументов.Отклонен;
		//ИначеЕсли (СтатусыСогласовано.Количество()> 0 и СтатусыСогласовано.Количество()< ТаблицаСостояний.Количество())
		//	и СтатусыОтклонено.Количество() = 0 Тогда //процесс согласования в процессеи и "отклонен" еще нет 
		КонецЕсли;		
	КонецЕсли;	
    Возврат СтатусДокумента
	
КонецФункции

&НаСервере
Процедура ПодсчитатьИтоги(ТолькоВыбранные = Ложь)
	
	Если НЕ ТолькоВыбранные Тогда 
		ЗаявленоКОплате = 0;
		СогласованоКОплате = 0;
		
		ЗаявленоКОплате = СписокЗаявокНаОплату.Итог("ВсегоПоЗаявкеВРублях");
		
		ПараметрыОтбора = Новый Структура("СтатусЗадачи", Перечисления.СтатусыЭтапов.Выполнен);
		ОбработанныеСтроки = СписокЗаявокНаОплату.Выгрузить(ПараметрыОтбора);
		СогласованоКОплате = ОбработанныеСтроки.Итог("ВсегоПоЗаявкеВРублях");
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура("Выбрать", Истина);
	Выбранные = СписокЗаявокНаОплату.Выгрузить(ПараметрыОтбора);
	СуммаПоОтобраннымСтрокам = Выбранные.Итог("ВсегоПоЗаявкеВРублях");
	
КонецПроцедуры	

