&НаКлиенте
Процедура УстановитьСнятьПометки(СписокЗначений, ЗначениеПометки)
	
	Для Каждого СтрокаСписка из ЭтаФорма[СписокЗначений] Цикл
		СтрокаСписка.Пометка = ЗначениеПометки;
	КонецЦикла;
	СформироватьОтборСтрок();

КонецПроцедуры

&НаСервере
Процедура СформироватьОтборСтрок()
	
	Для Каждого СтрокаТЧ из СписокЗаявокНаОплату Цикл
		СтрокаТЧ.ПопадаетВОтборы = Ложь;
	КонецЦикла;
	ОтборСтрок = Новый Структура("ПопадаетВОтборы", Истина);
	Элементы.СписокЗаявокНаОплату.ОтборСтрок = Новый ФиксированнаяСтруктура(ОтборСтрок);

	
	ТаблицаЗаявок = СписокЗаявокНаОплату.Выгрузить();	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаЗаявок.ЗаявкаНаОплату КАК ЗаявкаНаОплату,
	|	ТаблицаЗаявок.Статус КАК Статус,
	|	ТаблицаЗаявок.Состояние КАК Состояние,
	|	ТаблицаЗаявок.СтатусЗадачи КАК СтатусЗадачи,
	|	ТаблицаЗаявок.ВсегоПоЗаявке КАК ВсегоПоЗаявке,
	|	ТаблицаЗаявок.ПодразделениеДКП КАК ПодразделениеДКП,
	|	ТаблицаЗаявок.ДатаПланируемойОплаты КАК ДатаПланируемойОплаты,
	|	ТаблицаЗаявок.УсловиеОплаты КАК УсловиеОплаты,
	|	ТаблицаЗаявок.ВсегоПоЗаявкеВРублях КАК ВсегоПоЗаявкеВРублях
    |ПОМЕСТИТЬ ВТ_Заявки
	|ИЗ
	|	&ТаблицаЗаявок КАК ТаблицаЗаявок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Заявки.ЗаявкаНаОплату КАК ЗаявкаНаОплату,
	|	ВТ_Заявки.Статус КАК Статус,
	|	ВТ_Заявки.Состояние КАК Состояние,
	|	ВТ_Заявки.СтатусЗадачи КАК СтатусЗадачи,
	|	ВТ_Заявки.ВсегоПоЗаявке КАК ВсегоПоЗаявке,
	|	ВТ_Заявки.ПодразделениеДКП КАК ПодразделениеДКП,
	|	ВТ_Заявки.ДатаПланируемойОплаты КАК ДатаПланируемойОплаты,
	|	ВТ_Заявки.УсловиеОплаты КАК УсловиеОплаты,
	|	ВТ_Заявки.ВсегоПоЗаявкеВРублях КАК ВсегоПоЗаявкеВРублях
	|ИЗ
	|	ВТ_Заявки КАК ВТ_Заявки
	|ГДЕ
	|	&ДатаПланируемойОплаты
	|	и &УсловиеОплаты";
	
	Запрос.УстановитьПараметр("ТаблицаЗаявок", ТаблицаЗаявок);
	
	// отбор по датам
	МассивЗначенийПоДатам = Новый Массив;
	Для Каждого ЭлементСписка Из ОтборДатаОплаты Цикл
		Если ЭлементСписка.Пометка Тогда
			МассивЗначенийПоДатам.Добавить(ЭлементСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	//отборы по подразделениям
	МассивЗначенийПодразделений = Новый Массив;
	Для Каждого ЭлементСписка Из ОтборПодразделение Цикл
		Если ЭлементСписка.Пометка Тогда
			МассивЗначенийПодразделений.Добавить(ЭлементСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	
	// отбор условие оплаты
	МассивЗначенийУсловийОплаты = Новый Массив;
	Для Каждого ЭлементСписка Из ОтборУсловиеОплаты Цикл
		Если ЭлементСписка.Пометка Тогда
			МассивЗначенийУсловийОплаты.Добавить(ЭлементСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	Если МассивЗначенийПоДатам.Количество() = 0 И МассивЗначенийПодразделений.Количество() = 0 И МассивЗначенийУсловийОплаты.Количество() = 0 Тогда 
		Элементы.СписокЗаявокНаОплатуВсегоПоЗаявкеВРублях.ТекстПодвала = 0;
		Возврат
	Иначе 	
		//параметр запроса по дате
		Если МассивЗначенийПоДатам.Количество() Тогда		
			Запрос.УстановитьПараметр("ДатаПланируемойОплаты", МассивЗначенийПоДатам);
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДатаПланируемойОплаты", "ВТ_Заявки.ДатаПланируемойОплаты В(&ДатаПланируемойОплаты)");
		Иначе
			Запрос.УстановитьПараметр("ДатаПланируемойОплаты", Истина);
		КонецЕсли;	
		//параметр запроса по подразделению
		Если МассивЗначенийПодразделений.Количество() Тогда
			Запрос.УстановитьПараметр("ОтборГруппаПользователей", МассивЗначенийПодразделений);
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВТ_Заявки КАК ВТ_Заявки",
			"ВТ_Заявки КАК ВТ_Заявки
			|	Внутреннее СОЕДИНЕНИЕ Справочник.ГруппыПользователей.Состав КАК ГруппыПользователейСостав
			|	ПО (ГруппыПользователейСостав.Ссылка В (&ОтборГруппаПользователей))
			|	И (НЕ ГруппыПользователейСостав.Пользователь.Недействителен)
			|	И (НЕ ГруппыПользователейСостав.Пользователь.ПометкаУдаления)
			|	И (ВТ_Заявки.ЗаявкаНаОплату.ОтветственныйЗаОплату = ГруппыПользователейСостав.Пользователь)");
		КонецЕсли;
		// параметр запроса по условию оплаты
		Если МассивЗначенийУсловийОплаты.Количество() Тогда
			Запрос.УстановитьПараметр("УсловиеОплаты", МассивЗначенийУсловийОплаты);
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОплаты", "ВТ_Заявки.УсловиеОплаты В (&УсловиеОплаты)");
		Иначе 
			Запрос.УстановитьПараметр("УсловиеОплаты", Истина);
		КонецЕсли;
		
		Результат = Запрос.Выполнить().Выгрузить(); 
		
		Для Каждого СтрокаРезультата из Результат Цикл
			СтруктураПоиска = Новый Структура("ЗаявкаНаОплату", СтрокаРезультата.ЗаявкаНаОплату);
			НайденныеСтроки = СписокЗаявокНаОплату.НайтиСтроки(СтруктураПоиска);
			Для Каждого СтрокаПоЗаявке из НайденныеСтроки Цикл
				СтрокаПоЗаявке.ПопадаетВОтборы = Истина;
			КонецЦикла;			
		КонецЦикла;
		Элементы.СписокЗаявокНаОплатуВсегоПоЗаявкеВРублях.ТекстПодвала = Результат.Итог("ВсегоПоЗаявкеВРублях");
	КонецЕсли;
	

КонецПроцедуры	

Процедура СформироватьТаблицыДляОтбора(ПроставитьПометкиПоДате = Ложь, ВернутьПроставленныеОтборы = Ложь)
	
	//Евросиб СубботинВ #125358 24.12.2025 Начало
	Если ВернутьПроставленныеОтборы Тогда
		МассивТаблиц = Новый Массив;
		КопияОтборДаты = ОтборДатаОплаты.Скопировать();
		КопияОтборПодразделения = ОтборПодразделение.Скопировать();
		КопияОтборУсловиеОплаты = ОтборУсловиеОплаты.Скопировать();
	КонецЕсли;
	//Евросиб СубботинВ #125358 24.12.2025 Конец
	
	ОтборДатаОплаты.Очистить();
	ТЗДаты = СписокЗаявокНаОплату.Выгрузить(,"ДатаПланируемойОплаты");
	ТЗДаты.Свернуть("ДатаПланируемойОплаты");
	ТЗДаты.Сортировать("ДатаПланируемойОплаты Возр");
	Для Каждого ДатаОплаты из ТЗДаты Цикл
		ОтборДатаОплаты.Добавить(ДатаОплаты.ДатаПланируемойОплаты);
	КонецЦикла;
			
	ОтборПодразделение.Очистить();
	ТЗПодразделения = СписокЗаявокНаОплату.Выгрузить(,"ПодразделениеДКП");
	ТЗПодразделения.Свернуть("ПодразделениеДКП");
	Для Каждого ДКП из ТЗПодразделения Цикл
		ОтборПодразделение.Добавить(ДКП.ПодразделениеДКП);
	КонецЦикла;
	
    ОтборУсловиеОплаты.Очистить();
	ТЗДаты = СписокЗаявокНаОплату.Выгрузить(,"УсловиеОплаты");
	ТЗДаты.Свернуть("УсловиеОплаты");
	Для Каждого ДатаОплаты из ТЗДаты Цикл 
		ОтборУсловиеОплаты.Добавить(ДатаОплаты.УсловиеОплаты);
	КонецЦикла;
	
	Если ПроставитьПометкиПоДате Тогда
		 ОтборДатаОплаты.ЗаполнитьПометки(Истина);
	КонецЕсли;
	
	//Евросиб СубботинВ #125358 24.12.2025 Начало
	Если ВернутьПроставленныеОтборы Тогда
		МассивТаблиц.Добавить(Новый Структура("ТаблицаОтбора, КопияТаблицы", ОтборДатаОплаты, КопияОтборДаты));
		МассивТаблиц.Добавить(Новый Структура("ТаблицаОтбора, КопияТаблицы", ОтборПодразделение, КопияОтборПодразделения));
		МассивТаблиц.Добавить(Новый Структура("ТаблицаОтбора, КопияТаблицы", ОтборУсловиеОплаты, КопияОтборУсловиеОплаты));
		УстановитьФильтрыПослеОбновления(МассивТаблиц); 
	КонецЕсли;
	//Евросиб СубботинВ #125358 24.12.2025 Конец
		 
КонецПроцедуры	                    

