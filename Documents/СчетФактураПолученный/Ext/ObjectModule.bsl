
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") И ДанныеЗаполнения.ВидОперации = Перечисления.ВидыОперацийОтчетКомитентуОПродажах.ОтчетОЗакупках Тогда
		Комментарий = "ОТКАЗ";
		Сообщить("На основании отчета о закупках счет-фактура полученный не вводится. Операция отменена.")
	КонецЕсли;
	
	Автор = Пользователи.ТекущийПользователь();
	Создано = ТекущаяДата();
	Организация = Константы.ОсновнаяОрганизация.Получить();
	//	удПериодВО = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериод(Организация);
	
	Если ЗначениеЗаполнено(ДанныеЗаполнения) И ТипЗнч(ДанныеЗаполнения) <> Тип("Структура") Тогда
		
		СчФ = БухгалтерскийУчетОбщиеПроцедурыСервер.НайтиПодчиненныйСчетФактуру(ДанныеЗаполнения.Ссылка,"СчетФактураПолученный",,);
		Если СчФ = Неопределено 
			ИЛИ Ссылка = СчФ //Гудкова 
			Тогда
			//ЭтотОбъект.Дата = ДанныеЗаполнения.Дата;
			//ЭтотОбъект.Записать();
			БухгалтерскийУчетОбщиеПроцедурыСервер.ЗаполнитьРеквизитыСчФПоОснованию(ДанныеЗаполнения, ЭтотОбъект);
			
		Иначе
			Комментарий = "ОТКАЗ";
			Сообщить("Уже существует счет-фактура, введенный на основании данного документа.");
		КонецЕсли;
//Евросиб (Литвинов 13.05.2021 #30663	
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") И ДанныеЗаполнения.Свойство("ДокументОснование") Тогда
		БухгалтерскийУчетОбщиеПроцедурыСервер.ЗаполнитьРеквизитыСчФПоОснованию(ДанныеЗаполнения.ДокументОснование, ЭтотОбъект);
//Евросиб )Литвинов 13.05.2021 #30663	
	КонецЕсли;	                   	
	
	Маршрутизировать = Константы.МаршрутизироватьСФП.Получить();
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Редактор = Пользователи.ТекущийПользователь();
	Изменено = ТекущаяДата();
	
	Если НЕ ЗначениеЗаполнено(ДокументОснование) И ДокументыОснования.Количество() > 0 Тогда
		ДокументОснование = ДокументыОснования[0].ДокументОснование;
	КонецЕсли;

//Евросиб Литвинов ( 30.12.21 #44592 Ticket#0254477 #44587 
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг")
			ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.КорректировкаПоступления") Тогда
			ДатаСФХЖ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "ДатаСФХЖ");
			Если ДатаСФХЖ >= Дата(2022,1,1) Тогда
				ДатаВходящего = ДатаВходящегоДокумента;//ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "ДатаВходящегоДокумента");
				Разность = (НачалоДня(ДатаВходящего) - НачалоДня(ДатаСФХЖ)) / (24*60*60);
				Если Разность >= 1 И Разность <= 5 Тогда
					Сообщить("Дата счета-фактуры больше даты совершения факта хоз.жизни документа-основания на "+Разность+" дн.");
				ИначеЕсли НЕ Разность = 0 Тогда 
					Отказ = Истина;
					Сообщить("Дата счета-фактуры "+Формат(ДатаВходящего, "ДЛФ=DD")+" и дата совершения факта хоз.жизни в документе-основании "+Формат(ДатаСФХЖ, "ДЛФ=DD")+" не могут отличаться больше, чем на 5 дней в сторону более поздней даты СФ. Проверьте и исправьте Дату совершения факта хоз. жизни в документе-основании.");
