&НаКлиенте
Процедура ВалютаСчетаОтличнаОтВалютыОплатыПриИзменении(Элемент)
	ОбновитьВидимостьКолонокНаВкладкеРазнесениеПоСчетамПокупателям();
	Если Объект.ВалютаСчетаОтличнаОтВалютыОплаты Тогда
		Для Каждого ТекущиеДанные Из Объект.РазнесениеНаСчетаПокупателям Цикл
			//Евросиб СубботинВ #90789 16.08.2024 Начало // старые параметры функции, оставил на всякий случай
			//РасчитатьРазнесеннуюСуммуВСтроке(ТекущиеДанные, Ложь, НЕ ЗначениеЗаполнено(ТекущиеДанные.Валюта));
			РасчитатьРазнесеннуюСуммуВСтроке(ТекущиеДанные);
			//Евросиб СубботинВ #90789 16.08.2024 Конец 
		КонецЦикла;
	//Евросиб СубботинВ #126100 25.12.2025 Начало 
	Иначе
	    МассивСтрокДляУдаления = Новый Массив;
		МассивСчетовДляСообщения = Новый Массив;
		Для Каждого ТекущиеДанные Из Объект.РазнесениеНаСчетаПокупателям Цикл
			РеквизитыСчета = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(ТекущиеДанные.СчетПокупателю, "ДоговорКонтрагента, Номер, Дата");
			Если НЕ РеквизитыСчета.ДоговорКонтрагента = Объект.ДоговорКонтрагента Тогда 
				МассивСтрокДляУдаления.Добавить(ТекущиеДанные);
				МассивСчетовДляСообщения.Добавить(РеквизитыСчета.Номер + " От " + РеквизитыСчета.Дата);
			КонецЕсли;
		КонецЦикла;	
		Если МассивСтрокДляУдаления.Количество() > 0 Тогда
			МассивСчетовДляСообщения = УдалитьПовторяющиесяЭлементыМассива(МассивСчетовДляСообщения);
			ЗадатьВопросПользователю(Новый Структура ("МассивСчетовДляСообщения, МассивСтрок", МассивСчетовДляСообщения, МассивСтрокДляУдаления));
		КонецЕсли;	
		//Евросиб СубботинВ #126100 25.12.2025 Конец
	КонецЕсли;
	
	
	//Евросиб СубботинВ #128189 17.02.2026 Начало
