&НаСервере
Функция ЗаполнитьМассивОтбора()
	
	Запрос = Новый Запрос;
    Запрос.Текст =
	////Евросиб СубботинВ #126100 25.12.2025 Начало
	//"ВЫБРАТЬ
	//|	СчетНаОплатуПокупателю.Ссылка КАК Ссылка
	//|ИЗ
	//|	Документ.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю
	//|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РазнесениеСчетовПокупателейПоВходящимПлатежам.Остатки КАК РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки
	//|		ПО (РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.СчетПокупателю = СчетНаОплатуПокупателю.Ссылка)
	//|ГДЕ
	//|	СчетНаОплатуПокупателю.Проведен
	//|	И СчетНаОплатуПокупателю.Контрагент = &Контрагент
	//|	И СчетНаОплатуПокупателю.ДоговорКонтрагента = &ДоговорКонтрагента
	//|	И РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.НеразнесеннаяСуммаОстаток > 0";
	
	"ВЫБРАТЬ
	|	РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.СчетПокупателю КАК Ссылка
	|ИЗ
	|	РегистрНакопления.РазнесениеСчетовПокупателейПоВходящимПлатежам.Остатки(
	|			,
	|			Контрагент = &Контрагент
	|				И Договор В (&ДоговорКонтрагента)) КАК РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки
	|ГДЕ
	|	РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.НеразнесеннаяСуммаОстаток > 0";
	
	Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
	МассивДоговоров = Новый Массив;
	Если Объект.ВалютаСчетаОтличнаОтВалютыОплаты Тогда
		МассивДоговоров = ПолучитьСписокДоговоров(Объект.ДоговорКонтрагента, Объект.ВалютаДокумента);
	Иначе
		МассивДоговоров.Добавить(Объект.ДоговорКонтрагента);
	КонецЕсли;
	//Запрос.УстановитьПараметр("ДоговорКонтрагента", Объект.ДоговорКонтрагента);
	Запрос.УстановитьПараметр("ДоговорКонтрагента", МассивДоговоров);
	//Евросиб СубботинВ #126100 25.12.2025 Конец
    РезультатЗапроса = Запрос.Выполнить();    
    Выборка = РезультатЗапроса.Выбрать();
    МассивСчетов = Новый Массив;
    Пока Выборка.Следующий() Цикл
         МассивСчетов.Добавить(Выборка.Ссылка);                        
    КонецЦикла;
    
    Возврат МассивСчетов;
	
КонецФункции

&НаСервере
Процедура ОбработкаДанныхВыбора(Текст,ДанныеВыбора)
    ПараметрыПодбора = Новый Структура;
    ТЗОтборТипы = ЗаполнитьМассивОтбора();
    ПараметрыПодбора.Вставить("Отбор",Новый Структура("Ссылка",ТЗОтборТипы));
    ПараметрыПодбора.Вставить("СтрокаПоиска",Текст);
    ДанныеВыбора = Документы.СчетНаОплатуПокупателю.ПолучитьДанныеВыбора(ПараметрыПодбора);
КонецПроцедуры
 

