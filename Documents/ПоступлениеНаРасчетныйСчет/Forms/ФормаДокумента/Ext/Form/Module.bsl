    ОформляемоеПоле      = ЭлементОформления.Поля.Элементы.Добавить();
    ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("РасшифровкаПлатежа1ЗаявкаНаОплату");
	
