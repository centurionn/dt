Процедура ЗаполнитьДокументыПереносаДС()
		
	Элементы.ДокументыПереносаДенежныхСредств.Видимость = Ложь;
	

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РазнесениеВходящихПлатежейПоСчетамПокупателейОбороты.Регистратор КАК Документ,
		|	РазнесениеВходящихПлатежейПоСчетамПокупателейОбороты.СуммаРасход КАК Сумма,
		|	РазнесениеВходящихПлатежейПоСчетамПокупателейОбороты.Валюта КАК Валюта,
		|	РазнесениеВходящихПлатежейПоСчетамПокупателейОбороты.КурсВзаиморасчетов КАК КурсВзаиморасчетов,
		|	РазнесениеВходящихПлатежейПоСчетамПокупателейОбороты.Контрагент КАК Контрагент,
		|	РазнесениеВходящихПлатежейПоСчетамПокупателейОбороты.Договор КАК Договор,
		|	ВЫБОР
		|		КОГДА РазнесениеВходящихПлатежейПоСчетамПокупателейОбороты.Регистратор ССЫЛКА Документ.КорректировкаДолга
		|			ТОГДА ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(РазнесениеВходящихПлатежейПоСчетамПокупателейОбороты.Регистратор КАК Документ.КорректировкаДолга).ВидОперации)
		|		КОГДА РазнесениеВходящихПлатежейПоСчетамПокупателейОбороты.Регистратор ССЫЛКА Документ.ПоступлениеНаРасчетныйСчет
		|			ТОГДА ""Разнесение поступления""
		|	КОНЕЦ КАК ВидОперации,
		|	ВЫБОР
		|		КОГДА РазнесениеВходящихПлатежейПоСчетамПокупателейОбороты.Регистратор ССЫЛКА Документ.КорректировкаДолга
		|			ТОГДА ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(РазнесениеВходящихПлатежейПоСчетамПокупателейОбороты.Регистратор КАК Документ.КорректировкаДолга).ВидАвансаЗадолженности = ЗНАЧЕНИЕ(Перечисление.ВидыАвансаЗадолженности.АвансыПокупателя)
		|						ТОГДА ""Аванс""
		|					КОГДА ВЫРАЗИТЬ(РазнесениеВходящихПлатежейПоСчетамПокупателейОбороты.Регистратор КАК Документ.КорректировкаДолга).ВидАвансаЗадолженности = ЗНАЧЕНИЕ(Перечисление.ВидыАвансаЗадолженности.ЗадолженностьПокупателя)
		|						ТОГДА ""Задолженность""
		|				КОНЕЦ
		|	КОНЕЦ КАК ВидАвансаЗадолженности
		|ИЗ
		|	РегистрНакопления.РазнесениеВходящихПлатежейПоСчетамПокупателей.Обороты(, , Регистратор, Поступление = &Поступление) КАК РазнесениеВходящихПлатежейПоСчетамПокупателейОбороты
		|ГДЕ
		|	РазнесениеВходящихПлатежейПоСчетамПокупателейОбороты.СуммаРасход > 0
		|	И ТИПЗНАЧЕНИЯ(РазнесениеВходящихПлатежейПоСчетамПокупателейОбороты.Регистратор) В (&ТипыРегистраторов)";
	
	Запрос.УстановитьПараметр("Поступление", Объект.Ссылка);
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("ДокументСсылка.КорректировкаДолга"));
	МассивТипов.Добавить(Тип("ДокументСсылка.СписаниеСРасчетногоСчета"));

	Запрос.УстановитьПараметр("ТипыРегистраторов", МассивТипов);

	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если не РезультатЗапроса.Пустой() Тогда
		ВыгрузкаЗапроса = РезультатЗапроса.Выгрузить();
		ДокументыПереносаДенежныхСредств.Загрузить(ВыгрузкаЗапроса); 
		Элементы.ДокументыПереносаДенежныхСредств.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры		
