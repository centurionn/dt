&НаКлиенте
Процедура ОбработкаГрупповогоВыбораСчетов(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = неопределено Тогда Возврат; КонецЕсли;
	
	Для каждого Стр из П1 Цикл
		
		Если Объект.РазнесениеНаСчетаПокупателям.НайтиСтроки(Новый Структура("СчетПокупателю", Стр)).Количество() > 0 Тогда
			//Субботин 79718 /15.01.2024 Начало
			ОбщегоНазначенияКлиент.СообщитьПользователю(""+Стр + " уже добавлен. Выберите другой счет.");
            //Субботин 79718 /15.01.2024 Конец
			Продолжить;
		КонецЕсли;
		
		НСтр = Объект.РазнесениеНаСчетаПокупателям.Добавить();
		НСтр.СчетПокупателю = Стр;
		
		//Евросиб Коханенко Н.А. 10.04.2023 (( #67586        
		//НСтр.РазнесеннаяСумма = ПолучитьСуммуДокумента(НСтр.СчетПокупателю);
		
		//Евросиб СубботинВ #90789 16.08.2024 Начало // поменял последовательность из-за счены алгоритма 
		//Если Объект.ВалютаСчетаОтличнаОтВалютыОплаты Тогда 
		//	РасчитатьРазнесеннуюСуммуВСтроке(НСтр, Ложь, Истина);
		//Иначе
		//	НСтр.РазнесеннаяСумма = ПолучитьСуммуДокумента(НСтр.СчетПокупателю, НеРазнесеннаяСумма);
		//КонецЕсли;
		
		НСтр.РазнесеннаяСумма = ПолучитьСуммуДокумента(НСтр.СчетПокупателю, НеРазнесеннаяСумма);
		Если Объект.ВалютаСчетаОтличнаОтВалютыОплаты Тогда 
			РасчитатьРазнесеннуюСуммуВСтроке(НСтр);
		КонецЕсли; 
