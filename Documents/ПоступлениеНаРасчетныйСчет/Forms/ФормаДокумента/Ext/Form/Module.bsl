	Дубли = Объект.РазнесениеНаСчетаПокупателям.НайтиСтроки(СтруктураОтбора);
	Если Дубли.Количество() > 0 Тогда 
		ОбщегоНазначенияКлиент.СообщитьПользователю(""+ВыбранноеЗначение +" уже добавлен. Выберите другой счет");		
		СтандартнаяОбработка  = Ложь;
	КонецЕсли; 
