&НаСервереБезКонтекста
Функция ПолучитьСписокДоговоров(Договор, Валюта)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.Владелец = &Владелец
		//Евросиб СубботинВ #90789 16.08.2024 Начало // убрал для мультивалютки, должен быть полный выбор валют, добавил поиск договоров 
	//	|	И ДоговорыКонтрагентов.ВалютаВзаиморасчетов <> &ВалютаВзаиморасчетов
		|	И ДоговорыКонтрагентов.ВидДоговора = &ВидДоговора
		|	И ДоговорыКонтрагентов.Код = &Код
        //Евросиб СубботинВ #90789 16.08.2024 Конец
		//Евросиб СубботинВ #126100 26.12.2025 Начало
		|	И НЕ ДоговорыКонтрагентов.РасчетыВУсловныхЕдиницах
		//Евросиб СубботинВ #126100 26.12.2025 Конец
		|	И НЕ ДоговорыКонтрагентов.ПометкаУдаления";
		
	//Евросиб СубботинВ #90789 16.08.2024 Начало //
	//Запрос.УстановитьПараметр("Владелец", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "Владелец"));
	//Запрос.УстановитьПараметр("ВалютаВзаиморасчетов", Валюта);
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ВидДоговора, Код, Владелец");
	Запрос.УстановитьПараметр("Владелец", РеквизитыДоговора.Владелец);
	Запрос.УстановитьПараметр("ВидДоговора", РеквизитыДоговора.ВидДоговора);
    Запрос.УстановитьПараметр("Код", РеквизитыДоговора.Код);
	//Евросиб СубботинВ #90789 16.08.2024 Конец 
	
	РезультатЗапроса = Запрос.Выполнить();
    Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
