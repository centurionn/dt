 &НаКлиенте
Функция ЗадатьВопросПользователю(ДанныеСтрок) Экспорт
	
	МассивСчетовДляСообщения = ДанныеСтрок.МассивСчетовДляСообщения;
	МассивСтрок = ДанныеСтрок.МассивСтрок;
	 
	СписокКнопок = Новый СписокЗначений;
    СписокКнопок.Добавить(КодВозвратаДиалога.Да, "Да");
	СписокКнопок.Добавить(КодВозвратаДиалога.Нет, "Нет");
	ОпОп = Новый ОписаниеОповещения("ОбработкаОтветаПользователя", ЭтаФорма, Новый Структура("МассивСтрок", МассивСтрок));
	Сообщение = СтрШаблон("Договор в %1:%2 отличен от договора в поступлении. Строки с отличающимся договором буду очищены. Продолжить?",
				?(МассивСчетовДляСообщения.Количество()>1, "Счетах", "Счете"), СтрСоединить(МассивСчетовДляСообщения,","));
	ПоказатьВопрос(ОпОп, Сообщение, СписокКнопок,, КодВозвратаДиалога.Да);
	
КонецФункции

&НаКлиенте	
Процедура ОбработкаОтветаПользователя(ОтветПользователя = Неопределено, ДопПараметры = Неопределено)Экспорт
	
	Если ОтветПользователя = Неопределено или ОтветПользователя = КодВозвратаДиалога.Нет Тогда 
		Объект.ВалютаСчетаОтличнаОтВалютыОплаты = Истина;
		ВалютаСчетаОтличнаОтВалютыОплатыПриИзменении(Неопределено); 
		Возврат;
	КонецЕсли;
	
	МассивСтрок = ДопПараметры.МассивСтрок;
	
	Для Каждого СтрокаТч из МассивСтрок Цикл
		Объект.РазнесениеНаСчетаПокупателям.Удалить(СтрокаТч);
	КонецЦикла;;
	РазнесениеНаСчетаПокупателямПриИзменении(Неопределено);
	
КонецПроцедуры 
