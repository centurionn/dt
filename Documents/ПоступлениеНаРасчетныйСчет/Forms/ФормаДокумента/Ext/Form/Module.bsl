&НаСервере
Процедура УстановитьВидимостьГруппыДКС()
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеДенежныхСредств.ОплатаПокупателя") Тогда
		Элементы.ГруппаДКС.Видимость = Истина;
		Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
			ГруппаДКС = РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ПолучитьГруппуДКСпоДокументу(Объект.Ссылка);
		КонецЕсли;
	Иначе	                                  
		Элементы.ГруппаДКС.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры	

