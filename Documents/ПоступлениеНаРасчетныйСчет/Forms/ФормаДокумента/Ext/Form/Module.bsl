&НаСервере
Функция ПолучитьСчетПоНомеру(НомерСчета, Плательщик)
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СчетНаОплатуПокупателю.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю
	               |ГДЕ
	               |	СчетНаОплатуПокупателю.ПометкаУдаления = ЛОЖЬ
	               |	И СчетНаОплатуПокупателю.Контрагент = &Контрагент
	               |	И СчетНаОплатуПокупателю.НомерДляПечати ПОДОБНО &НомерДляПечати
				   //Евросиб СубботинВ #128189 17.02.2026 Начало
	               |	И СчетНаОплатуПокупателю.ДоговорКонтрагента В(&ДоговорКонтрагента)
				   //Евросиб СубботинВ #128189 17.02.2026 Конец
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СчетНаОплатуПокупателю.Дата УБЫВ";
	Запрос.УстановитьПараметр("Контрагент", Плательщик); 
	//Евросиб СубботинВ #128189 17.02.2026 Начало 
	Если Объект.ВалютаСчетаОтличнаОтВалютыОплаты Тогда
		ДоговораКонтрагента = ПолучитьСписокДоговоров(Объект.ДоговорКонтрагента, Объект.ВалютаДокумента);
	Иначе
		ДоговораКонтрагента = Новый массив;
		ДоговораКонтрагента.Добавить(Объект.ДоговорКонтрагента);
	КонецЕсли;	
	Запрос.УстановитьПараметр("ДоговорКонтрагента", ДоговораКонтрагента);
    //Евросиб СубботинВ #128189 17.02.2026 Конец
	Запрос.УстановитьПараметр("НомерДляПечати", "%"+НомерСчета+"%");
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЗаменитьИсполнителя(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) тогда
		ПоказатьПредупреждение(, "Сначала необходимо сохранить Платежку");
		Возврат;
	КонецЕсли;
	
	ИсходныйПользователь = неопределено;
	Для каждого Стр из Объект.Состояния Цикл
		ИсходныйПользователь = Стр.Исполнитель;
	КонецЦикла;
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораЗаменыСогласующего", ЭтаФорма);
	
	ОткрытьФорму("Документ.ПСЦ.Форма.ФормаЗаменыИсполнителяВПротоколе", Новый Структура("ИсходныйПользователь", ИсходныйПользователь),,ЭтаФорма.УникальныйИдентификатор, ,,ОпОп,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораЗаменыСогласующего(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = неопределено Тогда Возврат; КонецЕсли;
	
	ИсхП = П1.ИсходныйПользователь;
	КонП = П1.КонечныйПользователь;
	
	ЗаменятьИсполнителя = П1.ЗаменятьИсполнителя;
	ЗаменятьНаблюдателя = П1.ЗаменятьНаблюдателя;
	
	ЗаменяемыеСтатусы = П1.ЗаменяемыеСтатусы;
	
	Для каждого Стр из Объект.Состояния Цикл
		
		Если ЗаменяемыеСтатусы.Найти(Стр.Статус) <> неопределено Тогда
			Если Стр.Исполнитель = ИсхП И ЗаменятьИсполнителя Тогда Стр.Исполнитель = КонП; КонецЕсли;
			Если Стр.Наблюдатель = ИсхП И ЗаменятьНаблюдателя Тогда Стр.Наблюдатель = КонП; КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ОбновитьПанельСостояний();
	
КонецПроцедуры

