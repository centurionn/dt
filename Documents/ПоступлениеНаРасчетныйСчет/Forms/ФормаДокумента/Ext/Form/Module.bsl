&НаСервере
Функция ПолучитьСуммуДокумента(СчетПокупателю, НеРазнСумма)

	Если ЗначениеЗаполнено(СчетПокупателю) Тогда		
	    //Субботин 79718 15.01.2024 Начало
		//Сум = СчетПокупателю.СуммаДокумента; 
		СтруктураОтбора = Новый Структура("СчетПокупателю", СчетПокупателю);
		Остатки = РегистрыНакопления.РазнесениеСчетовПокупателейПоВходящимПлатежам.Остатки(,СтруктураОтбора,"СчетПокупателю","НеразнесеннаяСумма");
		//Евросиб СубботинВ #128189 17.02.2026 Начало
		//Сум = Остатки[0].НеразнесеннаяСумма;
		Если Остатки.Количество() > 0 Тогда
			Сум = Остатки[0].НеразнесеннаяСумма;
		Иначе
			Сум = 0;
		КонецЕсли;
		//Евросиб СубботинВ #128189 17.02.2026 Начало
		//Субботин 79718 15.01.2024 Конец
		//Евросиб СубботинВ #92045 01.10.2024 Начало // добавил перевод в валюту счета, т.к нам нужно выбирать меньшее при работе с валютными документами 
		ВалютаСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетПокупателю, "ВалютаДокумента");
		Если Объект.ВалютаДокумента <> ВалютаСчета Тогда
			Сум = РаботаСКурсамиВалют.ПересчитатьВВалюту(Сум, ВалютаСчета, Объект.ВалютаДокумента, Объект.ДатаВзаиморасчетов);
		КонецЕсли;
		//Евросиб СубботинВ #92045 01.10.2024 Конец 
	Иначе	
		Сум = 0;	
	КонецЕсли;
	Сум = Мин(Сум, НеРазнСумма);
	Возврат Сум;


КонецФункции // ()

