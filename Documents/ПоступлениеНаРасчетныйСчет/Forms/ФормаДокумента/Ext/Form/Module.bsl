		Возврат;
	КонецЕсли;
	ТекущиеДанные = Элементы.РазнесениеНаСчетаПокупателям.ТекущиеДанные;
	ЗначениеРазнесеннойСуммыПослеИзменения = ТекущиеДанные.РазнесеннаяСумма;
	Дельта = Объект.ТекущееЗначениеРазнесеннойСуммы - ЗначениеРазнесеннойСуммыПослеИзменения;
	Если Макс(Дельта, -Дельта) > 0.02 Тогда
		//Пересчитаем сумму в валюте автоматически		
		//Евросиб СубботинВ #90789 16.08.2024 Начало //  переделал на общий алгоритм работы с разнесенной суммой
		//ТекущиеДанные.СуммаВВалюте = ПересчитатьСуммуВВалюте(ТекущиеДанные);
		РасчитатьРазнесеннуюСуммуВСтроке();
		//Евросиб СубботинВ #90789 16.08.2024 Конец // 
	Иначе
		//Спросим у пользователя
		ТекстВопроса = "Пересчитать сумму в валюте?";
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПослеВопросаОПересчетеСуммыВВалюте", ЭтотОбъект);
		ДополнительныеПараметры = СтандартныеПодсистемыКлиент.ПараметрыВопросаПользователю();
		ДополнительныеПараметры.КнопкаПоУмолчанию = 1;
		ДополнительныеПараметры.КнопкаТаймаута  = 1;
		ДополнительныеПараметры.Заголовок = "Вопрос";
		ДополнительныеПараметры.ПредлагатьБольшеНеЗадаватьЭтотВопрос = Ложь;
		Кнопки = РежимДиалогаВопрос.ДаНет;
		СтандартныеПодсистемыКлиент.ПоказатьВопросПользователю(ОповещениеОЗакрытии, ТекстВопроса, Кнопки, ДополнительныеПараметры);
	КонецЕсли;
