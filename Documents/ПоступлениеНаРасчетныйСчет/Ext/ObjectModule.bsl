Функция ПолучитьНаборНеЗначСимв()

	Мас = Новый Массив;
	Мас.Добавить(" ");
	Мас.Добавить("/");
	Мас.Добавить("\");
	Мас.Добавить("(");  //Евросиб Фокеева( 17.10.2022 US №56989
	Мас.Добавить(")");
	Мас.Добавить("|");  // Евросиб Фокеева
	Мас.Добавить(Символы.ВК);
	Мас.Добавить(Символы.ВТаб);
	Мас.Добавить(Символы.НПП);
	Мас.Добавить(Символы.ПС);
	Мас.Добавить(Символы.ПФ);
	Мас.Добавить(Символы.Таб);
	
	Возврат Мас;

КонецФункции // ПолучитьНаборНеЗначСимв()
 
Функция УдалитьНеЗначащиеСимволы(СтрИзн, НаборНеЗначСимв)

	Если СтрИзн = "" Тогда
		
		ПреобразовСтр = "";
		
	Иначе
		ПреобразовСтр = "";
		// Убираем из строки все пробелы (мало ли в номере окажется)
		Для Сч = 1 По СтрДлина(СтрИзн) Цикл
			
			ТекСимв = Сред(СтрИзн, Сч, 1);
			
			Если НаборНеЗначСимв.Найти(ТекСимв) = Неопределено Тогда
				
				ПреобразовСтр = ПреобразовСтр + ТекСимв;
				
			Иначе
				
				
				
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли;

	Возврат ПреобразовСтр;
	
КонецФункции // УдалитьНеЗначащиеСимволы(СтрИзн, НаборНеЗначСимв)

