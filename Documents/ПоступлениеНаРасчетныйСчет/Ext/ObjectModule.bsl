
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Автор = Пользователи.ТекущийПользователь();
	ЦФО = Автор.ЦФО;
	Создано = ТекущаяДата();
	Маршрутизировать = Константы.МаршрутизироватьПоступлениеНаРС.Получить();
	ТребуетсяАвтоматическоеРазнесениеПоСчетам = Константы.АвторазнесениеВхПлатежейПоСчетамПокупателям.Получить();
	Организация = Константы.ОсновнаяОрганизация.Получить();
	ПериодВО = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериод(Организация);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Автор = Пользователи.ТекущийПользователь();
	Создано = ТекущаяДата();
	Маршрутизировать = Константы.МаршрутизироватьПоступлениеНаРС.Получить();
	Редактор = неопределено;
	Изменено = неопределено;
	Состояния.Очистить();
	
КонецПроцедуры

//ДИТ, Беляев СЮ, US 81912/ TA 82268, 03-04-2024, начало
&НаСервере
Функция ЕстьПравоПровестиНеПроведенныйДокумент(РежимЗаписи)
	ДокументМеняетСтатусНаПроведенный = (РежимЗаписи = РежимЗаписиДокумента.Проведение) И НЕ Проведен;
	Если НЕ ДокументМеняетСтатусНаПроведенный Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ПравоДоступа("ОтменаПроведения", ЭтотОбъект.Метаданные()); //Определяем по доступу на отмену проведения
КонецФункции
//ДИТ, Беляев СЮ, US 81912/ TA 82268, 03-04-2024, конец

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	//Евросиб СубботинВ #103438 24.02.2025 Начало
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РазнесениеВходящихПлатежейПоСчетамПокупателейОбороты.Регистратор КАК Документ,
	|	РазнесениеВходящихПлатежейПоСчетамПокупателейОбороты.СуммаРасход КАК Сумма,
	|	РазнесениеВходящихПлатежейПоСчетамПокупателейОбороты.Валюта КАК Валюта,
	|	РазнесениеВходящихПлатежейПоСчетамПокупателейОбороты.КурсВзаиморасчетов КАК КурсВзаиморасчетов
	|ИЗ
	|	РегистрНакопления.РазнесениеВходящихПлатежейПоСчетамПокупателей.Обороты(, , Регистратор, Поступление = &Поступление) КАК РазнесениеВходящихПлатежейПоСчетамПокупателейОбороты
	|ГДЕ
	|	РазнесениеВходящихПлатежейПоСчетамПокупателейОбороты.СуммаРасход > 0
	|	И РазнесениеВходящихПлатежейПоСчетамПокупателейОбороты.Регистратор ССЫЛКА Документ.КорректировкаДолга";
	
	Запрос.УстановитьПараметр("Поступление", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если не РезультатЗапроса.Пустой() Тогда
		ВыгрузкаЗапроса = РезультатЗапроса.Выгрузить();
		СуммаПеренесенныхДС = ВыгрузкаЗапроса.Итог("Сумма");
	Иначе
		СуммаПеренесенныхДС = 0;
	КонецЕсли;	
		
	РазнесеннаяСумма = РазнесениеНаСчетаПокупателям.Итог("РазнесеннаяСумма");
	
	Если РазнесеннаяСумма + СуммаПеренесенныхДС > СуммаДокумента Тогда
		//Сообщить("Сумма привязанных счетов покупателям (" + РазнесеннаяСумма + ") не должна превышать сумму документа ("+СуммаДокумента+"). Проведение отменено.");
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Сумма привязанных счетов покупателям (%1) %3 не должна превышать сумму документа (%2). Проведение отменено."
														,РазнесеннаяСумма, СуммаДокумента,
														?(СуммаПеренесенныхДС <> 0, "и сумма перенесенных средств ("+СуммаПеренесенныхДС+")","")));
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	//Евросиб СубботинВ #103438 24.02.2025 Конец
	
	
КонецПроцедуры

