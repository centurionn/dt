			СуммаРазнесения = Мин(ОстатокВВалютеОплаты, СтрокаПоРеализации.СуммаОплаты);			
			Если СуммаРазнесения > ОстатокСуммы Тогда
				Прервать;
			КонецЕсли;
			
			Если СуммаРазнесения <> 0 Тогда
				
				СтрокаПоРеализации.СуммаОплаты = СтрокаПоРеализации.СуммаОплаты - СуммаРазнесения;
				ОстатокСуммы = ОстатокСуммы - СуммаРазнесения;
