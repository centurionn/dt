//Евросиб СубботинВ #90789 16.08.2024 Начало      //Евросиб СубботинВ #92045 26.09.2024 Начало // добавил парам ЗаполнениеРазнесеннойСуммы
Процедура ЗаполнитьДанныеСтрокиПоМультивалютномуСчету(СтрокаРазнесений, ВалютаДокумента, ДатаВзаиморасчетов) Экспорт
	
	Если не ЗначениеЗаполнено(СтрокаРазнесений.ДатаКурса) Тогда
		СтрокаРазнесений.ДатаКурса = ДатаВзаиморасчетов;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтрокаРазнесений.Валюта) Тогда
		СтрокаРазнесений.Валюта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаРазнесений.СчетПокупателю, "ВалютаДокумента");
	КонецЕсли;			
	Если Не ЗначениеЗаполнено(СтрокаРазнесений.КурсОплаты) Тогда
		
		//Евросиб СубботинВ #90789 16.08.2024 Начало // доп правка добавил условия по валютам, т.к могут отличаться
		Если СтрокаРазнесений.Валюта = Константы.ВалютаРегламентированногоУчета.Получить() и ВалютаДокумента <> СтрокаРазнесений.Валюта Тогда			
			СтрокаРазнесений.КурсОплаты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаДокумента, СтрокаРазнесений.ДатаКурса).Курс;
		ИначеЕсли СтрокаРазнесений.Валюта = ВалютаДокумента Тогда
			СтрокаРазнесений.КурсОплаты = 1;
		Иначе
			СтрокаРазнесений.КурсОплаты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(СтрокаРазнесений.Валюта, СтрокаРазнесений.ДатаКурса).Курс;
		КонецЕсли;
		//Евросиб СубботинВ #90789 16.08.2024 Конец // доп правка добавил условия по валютам, т.к могут отличаться
	КонецЕсли;
	
	//Евросиб СубботинВ #92045 26.09.2024 Начало 	
	Если Не ЗначениеЗаполнено(СтрокаРазнесений.КурсВзаиморасчетов) Тогда
	      СтрокаРазнесений.КурсВзаиморасчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаРазнесений.СчетПокупателю, "КурсВзаиморасчетов");
		  Если Не ЗначениеЗаполнено(СтрокаРазнесений.КурсВзаиморасчетов) Тогда
             СтрокаРазнесений.КурсВзаиморасчетов = РаботаСКурсамиВалют.ПолучитьКурсВалюты(СтрокаРазнесений.Валюта,СтрокаРазнесений.ДатаКурса).Курс;
          КонецЕсли;			 
    КонецЕсли;	
	СтрокаРазнесений.СуммаВВалюте = РаботаСКурсамиВалют.ПересчитатьВВалюту(СтрокаРазнесений.РазнесеннаяСумма,
				ВалютаДокумента, СтрокаРазнесений.Валюта, СтрокаРазнесений.ДатаКурса);
	//Евросиб СубботинВ #92045 26.09.2024 Конец			
				
КонецПроцедуры
