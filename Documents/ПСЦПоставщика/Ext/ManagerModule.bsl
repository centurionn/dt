Процедура ОтправитьПСЦВДО(ПараметрыВыполнения, АдресРезультата) Экспорт   
	
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Подключение к вебсервису 1С:ДО'"),
				УровеньЖурналаРегистрации.Информация,,,
				"");
				
	ПСЦСсылка = ПараметрыВыполнения.ПСЦСсылка;    
	ЭтоЗавершениеСогласования = ПараметрыВыполнения.ЭтоЗавершениеСогласования;
	
	ОтправкаСканКопии = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПСЦ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Файлы КАК Файлы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПСЦ КАК ПСЦ
		|		ПО (ПСЦ.Ссылка = Файлы.ВладелецФайла)
		|			И (Файлы.ЭтоСканКопия)
		|ГДЕ
		|	ПСЦ.Ссылка = &Ссылка
		|	И НЕ Файлы.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Ссылка", ПСЦСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если не РезультатЗапроса.Пустой() Тогда
		ОтправкаСканКопии = Истина;
	КонецЕсли;	  
	
	РеквизитыПСЦ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПСЦСсылка, 
				"СсылкаНаВнутреннийДокументДО, СтатусДокумента, Организация, ПодписанСДвухСторон");
	
	Если (не ЗначениеЗаполнено(РеквизитыПСЦ.СсылкаНаВнутреннийДокументДО) ИЛИ ЭтоЗавершениеСогласования ИЛИ ОтправкаСканКопии)
		и (РеквизитыПСЦ.СтатусДокумента = Перечисления.СтатусыСогласования.СогласованоБезЗамечаний
		или РеквизитыПСЦ.СтатусДокумента = Перечисления.СтатусыСогласования.СогласованСКомментариями
		или РеквизитыПСЦ.СтатусДокумента = Перечисления.СтатусыСогласования.Подписано) Тогда
		
		ДанныеДляОтправки = ЕСОбменСервер.ПодготовитьТаблицуПСЦдляОтправкиДО(ПСЦСсылка);
		// ПСЦ поставщика отправляем в ДО после установки даты подписания с двух сторон 
		Если РеквизитыПСЦ.ПодписанСДвухСторон Тогда
			ЕСОбменСервер.СоздатьКарточкуПСЦвДО(ДанныеДляОтправки);
		КонецЕсли;
		
		Если СтрНайти(ДанныеДляОтправки[0].Сообщение, "ОК") <> 0 Тогда   
			Объект = ПСЦСсылка.ПолучитьОбъект();
			Объект.СсылкаНаВнутреннийДокументДО = ДанныеДляОтправки[0].Ссылка_В_ДО;  
			Попытка
				Объект.ОбменДанными.Загрузка = Истина;	
				Объект.Записать(РежимЗаписиДокумента.Запись);				
			Исключение
			    //Сообщить("Добавлена ссылка на внутренний документ в Документообороте. Необходимо записать Протокол!");
			КонецПопытки;
		КонецЕсли;
			
	КонецЕсли;	
	
КонецПроцедуры	

Функция ПолучитьПараметрыМаршрутизации(Объект) Экспорт
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Договор, "ВалютаВзаиморасчетов");
	
	ПараметрыЗапроса = Новый Соответствие;
	ПараметрыЗапроса.Вставить("Организация", Объект.Организация);
	ПараметрыЗапроса.Вставить("Контрагент", Объект.Контрагент);
	ПараметрыЗапроса.Вставить("Договор", Объект.Договор);
	ПараметрыЗапроса.Вставить("Валюта", РеквизитыДоговора.ВалютаВзаиморасчетов);
	ПараметрыЗапроса.Вставить("Нерезидент", Справочники.Контрагенты.КонтрагентНерезидент(Объект.Контрагент));
	ПараметрыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Договор, "ВидДоговора, КатегорияДоговора");
	ПараметрыЗапроса.Вставить("ВидДоговора", ПараметрыДоговора.ВидДоговора);
	ПараметрыЗапроса.Вставить("КатегорияДоговора", ПараметрыДоговора.КатегорияДоговора);
	ПараметрыЗапроса.Вставить("ЦФО", Объект.ЦФО);
	ПараметрыЗапроса.Вставить("Типовой", Объект.Типовой);
	ПараметрыЗапроса.Вставить("ВидУслугПоставщика", Объект.ВидУслугПоставщика);
	ПараметрыЗапроса.Вставить("КатегорияУслуг", Объект.КатегорияУслуг);
	ПараметрыЗапроса.Вставить("МестоОказанияУслуг", Объект.МестоОказанияУслуг);

	Возврат ПараметрыЗапроса;
	
КонецФункции

Процедура ЗаполнитьРеквизитыИзДоговора(Объект, Договор) Экспорт
	
	РеквизитыДоговора = Справочники.ДоговорыКонтрагентов.ПолучитьЗначенияРеквизитовДоговораПоУмолчанию(Договор);
	Объект.ВалютаОплаты = РеквизитыДоговора.ВалютаОплаты;
	Объект.ОтветственныйМенеджер = РеквизитыДоговора.ОтветственныйЗаДоговор;
	Если ЗначениеЗаполнено(РеквизитыДоговора.ФормаПротокола) Тогда
		Если РеквизитыДоговора.ФормаПротокола = Перечисления.ФормыДокументов.Типовая Тогда
			Объект.Типовой = Истина;
		Иначе
			Объект.Типовой = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Контейнеры И Объект.Типовой Тогда
		Объект.НаименованиеПодписиКонтрагента = Справочники.НаименованияПодписей.Исполнитель;
		Объект.НаименованиеПодписи = Справочники.НаименованияПодписей.Клиент;
	Иначе
		Объект.НаименованиеПодписиКонтрагента = РеквизитыДоговора.НаименованиеСтороны;
		Объект.НаименованиеПодписи = РеквизитыДоговора.НаименованиеCтороныЕвросиб;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьОчереднойНомерПСЦ(Договор, Ссылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(ПСЦПоставщика.Ссылка) КАК ПорядковыйНомер
	|ИЗ
	|	Документ.ПСЦПоставщика КАК ПСЦПоставщика
	|ГДЕ
	|	ПСЦПоставщика.Договор = &Договор
	|	И ПСЦПоставщика.Ссылка <> &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДокумента.Ссылка КАК Ссылка,
	|	ТаблицаДокумента.НомерПСЦ КАК НомерПСЦ
	|ИЗ
	|	Документ.ПСЦПоставщика КАК ТаблицаДокумента
	|ГДЕ
	|	ТаблицаДокумента.Договор = &Договор
	|	И ТаблицаДокумента.Ссылка <> &Ссылка";
	
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Результаты = Запрос.ВыполнитьПакет();
	Выборка = Результаты[0].Выбрать();
	ТаблицаЗанятыхНомеров = Результаты[1].Выгрузить();
	
	Если Выборка.Следующий() Тогда 
		ПорядковыйНомер = Выборка.ПорядковыйНомер + 1;
	Иначе
		ПорядковыйНомер = 1;
	КонецЕсли;
	
	Пока Истина Цикл
		
		Если ПорядковыйНомер <= 999 Тогда
			ПорядковыйНомерСтрокой = Формат(ПорядковыйНомер, "ЧЦ=3; ЧН=000; ЧВН=");
		Иначе
			ПорядковыйНомерСтрокой = Формат(ПорядковыйНомер, "ЧГ=0");
		КонецЕсли;		
		
		СтрокаЗанятогоНомера = ТаблицаЗанятыхНомеров.Найти(ПорядковыйНомерСтрокой, "НомерПСЦ");
		Если СтрокаЗанятогоНомера = Неопределено Тогда
			Прервать;
		Иначе
			ПорядковыйНомер = ПорядковыйНомер + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПорядковыйНомерСтрокой;
	
КонецФункции

Функция ПроверитьУникальностьНомераПСЦ(Объект) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПСЦПоставщика.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПСЦПоставщика КАК ПСЦПоставщика
		|ГДЕ
		|	ПСЦПоставщика.НомерПСЦ = &НомерПСЦ
		|	И ПСЦПоставщика.Договор = &Договор
		|	И ПСЦПоставщика.Ссылка <> &Ссылка
		|	И ПСЦПоставщика.Проведен = ИСТИНА";
	
	Запрос.УстановитьПараметр("НомерПСЦ", Объект.НомерПСЦ);
	Запрос.УстановитьПараметр("Договор", Объект.Договор);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();	
	Если РезультатЗапроса.Пустой() Тогда
		НомерУникален = Истина;
	Иначе
		НомерУникален = Ложь;
	КонецЕсли;
	
	Возврат НомерУникален;
	
КонецФункции

Функция ПолучитьДоверенностьДиректораПоПроизводству(ДатаДоверенности) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Доверенности.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Доверенности КАК Доверенности
	|ГДЕ
	|	Доверенности.ДатаНачалаДействия <= &ДатаДоверенности
	|	И Доверенности.ДатаОкончанияДейставия >= &ДатаДоверенности
	|	И Доверенности.Физлицо В
	|			(ВЫБРАТЬ
	|				ГруппыПользователейСостав.Пользователь.ФизическоеЛицо КАК ПользовательФизическоеЛицо
	|			ИЗ
	|				Справочник.ГруппыПользователей.Состав КАК ГруппыПользователейСостав
	|			ГДЕ
	|				ГруппыПользователейСостав.Ссылка = &ГруппаДиректорПоПроизводству)
	|	И НЕ Доверенности.ПометкаУдаления";
	Запрос.УстановитьПараметр("ГруппаДиректорПоПроизводству", Справочники.ГруппыПользователей.ДиректорПоПроизводству);
	Запрос.УстановитьПараметр("ДатаДоверенности", ДатаДоверенности);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Доверенность = Выборка.Ссылка;
	Иначе
		Доверенность = Справочники.Доверенности.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Доверенность;
	
КонецФункции

//Евросиб Коханенко Н.А. 30.11.2024 (( #89893
Функция НапечататьТиповойПротокол(МассивОбъектов, ДопПараметры=Неопределено) Экспорт
	
	ПечатьЗапрещена = Истина;
	ВыводитьФаксимиле = Ложь;
	Если ТипЗнч(ДопПараметры) = Тип("Структура") Тогда
		ДопПараметры.Свойство("ВыводитьФаксимиле", ВыводитьФаксимиле);
		Если ТипЗнч(ВыводитьФаксимиле) <> Тип("Булево") Тогда
			ВыводитьФаксимиле = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый ТабличныйДокумент;
	Результат.АвтоМасштаб = Истина;
	
	Первый = Истина;
