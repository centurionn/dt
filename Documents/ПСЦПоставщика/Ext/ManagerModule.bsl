	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИерархияЛокаций КАК ИерархияЛокаций
	|		ПО (ИерархияЛокаций.Локация = ПунктГородСтранаОтправления.ПунктОтправления)
	|			И (ИерархияЛокаций.ТипИерархии = ЗНАЧЕНИЕ(Перечисление.ТипыИерархииЛокации.РЕгион))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИерархияЛокаций КАК ИерархияЛокаций1
	|		ПО (ИерархияЛокаций1.Локация = ПунктГородСтранаНазначения.ПунктНазначения)
	|			И (ИерархияЛокаций1.ТипИерархии = ЗНАЧЕНИЕ(Перечисление.ТипыИерархииЛокации.РЕгион))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИерархияЛокаций КАК ИерархияЛокаций2
	|		ПО (ИерархияЛокаций2.Локация = ПунктГородСтранаОтправления.ПунктОтправления)
	|			И (ИерархияЛокаций2.ТипИерархии = ЗНАЧЕНИЕ(Перечисление.ТипыИерархииЛокации.НаселенныйПункт))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИерархияЛокаций КАК ИерархияЛокаций3
	|		ПО (ИерархияЛокаций3.Локация = ПунктГородСтранаНазначения.ПунктНазначения)
	|			И (ИерархияЛокаций3.ТипИерархии = ЗНАЧЕНИЕ(Перечисление.ТипыИерархииЛокации.НаселенныйПункт))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИерархияЛокаций КАК ИерархияЛокаций4
	|		ПО (ВЫБОР КОГДА ПунктГородСтранаОтправления.ПунктОтправления = &ЛокацияПустаяСсылка ТОГДА ИерархияЛокаций4.Локация = ПунктГородСтранаОтправления.ПунктОтправленияГород ИНАЧЕ ИерархияЛокаций4.Локация = ПунктГородСтранаОтправления.ПунктОтправления КОНЕЦ)
	|			И (ИерархияЛокаций4.ТипИерархии = ЗНАЧЕНИЕ(Перечисление.ТипыИерархииЛокации.Страна))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИерархияЛокаций КАК ИерархияЛокаций5
	|		ПО (ВЫБОР КОГДА ПунктГородСтранаНазначения.ПунктНазначения = &ЛокацияПустаяСсылка ТОГДА ИерархияЛокаций5.Локация = ПунктГородСтранаНазначения.ПунктНазначенияГород ИНАЧЕ ИерархияЛокаций5.Локация = ПунктГородСтранаНазначения.ПунктНазначения КОНЕЦ)
	|			И (ИерархияЛокаций5.ТипИерархии = ЗНАЧЕНИЕ(Перечисление.ТипыИерархииЛокации.Страна))
	//Евросиб Шевченко А.В. US 123730 TA 125663 15.12.2025
	//Евросиб Шевченко А.В. US 123730 TA 125713 15.12.2025
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИерархияЛокаций КАК ИерархияЛокацийОказанияУслуг
	|		ПО (ИерархияЛокацийОказанияУслуг.Локация = ЛокацииОказанияУслуги.ЛокацияОказанияУслуги)
	|			И (ИерархияЛокацийОказанияУслуг.ТипИерархии = ЗНАЧЕНИЕ(Перечисление.ТипыИерархииЛокации.РЕгион))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИерархияЛокаций КАК ИерархияЛокацийОказанияУслуг2
	|		ПО (ИерархияЛокацийОказанияУслуг2.Локация = ЛокацииОказанияУслуги.ЛокацияОказанияУслуги)
	|			И (ИерархияЛокацийОказанияУслуг2.ТипИерархии = ЗНАЧЕНИЕ(Перечисление.ТипыИерархииЛокации.НаселенныйПункт))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИерархияЛокаций КАК ИерархияЛокацийОказанияУслуг3
	|		ПО (ИерархияЛокацийОказанияУслуг3.Локация = ЛокацииОказанияУслуги.ЛокацияОказанияУслуги)
	|			И (ИерархияЛокацийОказанияУслуг3.ТипИерархии = ЗНАЧЕНИЕ(Перечисление.ТипыИерархииЛокации.Страна))
	//Евросиб Шевченко А.В. US 123730 TA 125713 15.12.2025
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	#КонецОбласти
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ПСЦПоставщика.Услуги", "&Услуги");
	Запрос.УстановитьПараметр("Услуги", Объект.Услуги.Выгрузить());
	Запрос.УстановитьПараметр("ДорогаПустаяСсылка", Справочники.ЖелезныеДороги.ПустаяСсылка());
	Запрос.УстановитьПараметр("ТипИерархииСтрана", Перечисления.ТипыИерархииЛокации.Страна);
	
	Запрос.УстановитьПараметр("ТаблицаВидовОтправок", ТаблицаВидовОтправок);
	Запрос.УстановитьПараметр("ТаблицаТипоразмеровКТК", ТаблицаТипоразмеровКТК);
	Запрос.УстановитьПараметр("ТаблицаТипоразмеровВагонов", ТаблицаТипоразмеровВагонов);
	
	Запрос.УстановитьПараметр("ЛокацияПустаяСсылка", ЛокацияПустаяСсылка);
	Запрос.УстановитьПараметр("ТипИерархииГород", ТипИерархииГород);
	Запрос.УстановитьПараметр("ТипИерархииСтрана", ТипИерархииСтрана);
	
	
	РезультатПакет = Запрос.ВыполнитьПакет();
	КоличествоРезультатов = РезультатПакет.Количество();
	Выборка = РезультатПакет[КоличествоРезультатов - 1].Выбрать();
	//Евросиб Шевченко А.В. US 123730 TA 126329 20.12.202
	ТаблицаДорог = РезультатПакет[КоличествоРезультатов - 21].Выгрузить();
	ЛокацияСтрана = РезультатПакет[КоличествоРезультатов - 23].Выгрузить();
	ТерминалыЖелезныеДороги = РезультатПакет[КоличествоРезультатов - 22].Выгрузить();
	//Евросиб Шевченко А.В. US 123730 TA 126329 20.12.202
	
	Объект.КритерииУслуг.Очистить();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.КритерииУслуг.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		СтруктураПоиска = Новый Структура("ИдентификаторСтрокиУслуг",Выборка.ИдентификаторСтрокиУслуг);
		НайденныеСтрокиУслуги = Объект.Услуги.НайтиСтроки(СтруктураПоиска);
		СтрУслуги = НайденныеСтрокиУслуги[0];
		
		ВыполнитьАвтоматическоеЗаполнениеПунктовГородовСтран(НоваяСтрока,Выборка,ПунктыИмена,СтрУслуги); //Евросиб Шевченко А.В. US 123730 TA 125663 15.12.2025
		ВыполнитьАвтоматическоеЗаполнениеЛокацииОказанияУслугГородовСтран(НоваяСтрока,Выборка,ПунктыИмена); //Евросиб Шевченко А.В. US 123730 TA 125713 15.12.2025
		
		ЗаполнитьДорогиЖД(Объект, НоваяСтрока,ТаблицаДорог,ЛокацияСтрана,ТерминалыЖелезныеДороги); //Евросиб Шевченко А.В. US 123730 TA 126329 20.12.202
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДорогиЖД(Объект, НоваяСтрока,ТаблицаДорог,ЛокацияСтрана,ТерминалыЖелезныеДороги) //Евросиб Шевченко А.В. US 123730 TA 126329 20.12.202
	
	Если Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Вагоны Тогда		
		Если ЗначениеЗаполнено(НоваяСтрока.ПунктОтправления) Тогда			
			Дороги = ТаблицаДорог.Скопировать(Новый Структура("Локация", НоваяСтрока.ПунктОтправления));
			
			Если Дороги.Количество() Тогда
				НоваяСтрока.ДорогаОтправления = Дороги[0].ЖелезнаяДорогаСсылка;
			КонецЕсли;

		КонецЕсли;
		
		Если ЗначениеЗаполнено(НоваяСтрока.ПунктНазначения) Тогда
			Дороги = ТаблицаДорог.Скопировать(Новый Структура("Локация", НоваяСтрока.ПунктНазначения));
			
			Если Дороги.Количество() Тогда
				НоваяСтрока.ДорогаНазначения = Дороги[0].ЖелезнаяДорогаСсылка;
			КонецЕсли;
			
		КонецЕсли;		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НоваяСтрока.ЛокацияОказанияУслуги) Тогда
		
		Если Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Порты ИЛИ Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Терминалы Тогда
			ЖелезныеДороги = Новый Массив;
			НайденныеСтроки = Новый Массив;
			Если ТипЗнч(НоваяСтрока.ЛокацияОказанияУслуги) = Тип("СправочникСсылка.Локации") Тогда
				НайденныеСтрокиСтраны = ЛокацияСтрана.НайтиСтроки(Новый Структура("Локация", НоваяСтрока.ЛокацияОказанияУслуги));
				Если НоваяСтрока.ЛокацияОказанияУслуги.Тип = Справочники.ТипыЛокаций.Порт Тогда
					НайденныеСтроки = ТерминалыЖелезныеДороги.НайтиСтроки(Новый Структура("Порт", НоваяСтрока.ЛокацияОказанияУслуги));
				КонецЕсли;
				Если НоваяСтрока.ЛокацияОказанияУслуги.Тип = Справочники.ТипыЛокаций.Терминал Тогда
					НайденныеСтроки = ТерминалыЖелезныеДороги.НайтиСтроки(Новый Структура("Локация", НоваяСтрока.ЛокацияОказанияУслуги));
				КонецЕсли;
				
				
				Для Каждого Стр Из НайденныеСтрокиСтраны Цикл
					ЭтоРОССИЯ = Ложь;
					Если Стр.Страна = Справочники.Локации.РОССИЯ Тогда
						ЭтоРОССИЯ = Истина;	
					КонецЕсли;
					Страна = Стр.Страна;
				КонецЦикла;	
				
				Для Каждого Стр Из НайденныеСтроки Цикл
					Если ЭтоРОССИЯ Тогда
						НоваяСтрока.ЖелезнаяДорога = Стр.ЖелезнаяДорога; 
					КонецЕсли;	
				КонецЦикла;	
				
				Если НЕ ЭтоРОССИЯ Тогда
					НоваяСтрока.ЖелезнаяДорога = Страна;
				КонецЕсли;				
			КонецЕсли;
		КонецЕсли;		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьАвтоматическоеЗаполнениеЛокацииОказанияУслугГородовСтран(НоваяСтрока,Выборка,ПунктыИмена) //Евросиб Шевченко А.В. US 123730 TA 125713 15.12.2025
	
	Если ПунктыИмена.Найти("ЛокацияОказанияУслуги") <> Неопределено Тогда
		
		Если Выборка.ТипПунктаЛокацияОказанияУслуг = 1 Тогда
			НоваяСтрока.ЛокацияОказанияУслугГород = НоваяСтрока.ЛокацияОказанияУслуги;
		ИначеЕсли Выборка.ТипПунктаЛокацияОказанияУслуг = 2 Тогда
			Если ЗначениеЗаполнено(Выборка.ПунктЛокацияОказанияУслугГород) Тогда
				НоваяСтрока.ЛокацияОказанияУслугГород = Выборка.ПунктЛокацияОказанияУслугГород;
			Иначе
				НоваяСтрока.ЛокацияОказанияУслугГород = Выборка.ПунктЛокацияОказанияУслугРегион;
			КонецЕсли;	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.ПунктЛокацияОказанияУслугСтрана) Тогда
			НоваяСтрока.ЛокацияОказанияУслугСтрана = Выборка.ПунктЛокацияОказанияУслугСтрана;
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура ВыполнитьАвтоматическоеЗаполнениеПунктовГородовСтран(НоваяСтрока,ВыборкаДетальныеЗаписи,ПунктыИмена,СтрУслуги) //Евросиб Шевченко А.В. US 123730 TA 125663 15.12.2025
		
	Если ЗначениеЗаполнено(НоваяСтрока.ПунктОтправления) И НЕ ЗначениеЗаполнено(НоваяСтрока.ПунктОтправленияГород) И ТипЗнч(НоваяСтрока.ПунктОтправления) = Тип("СправочникСсылка.Локации") Тогда
		Если ВыборкаДетальныеЗаписи.ТипПунктаОтправленияАвто = 1 Тогда
			НоваяСтрока.ПунктОтправленияГород = НоваяСтрока.ПунктОтправления;
		ИначеЕсли ВыборкаДетальныеЗаписи.ТипПунктаОтправленияАвто = 2 Тогда
			Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПунктОтправленияГородАвто) Тогда
				НоваяСтрока.ПунктОтправленияГород = ВыборкаДетальныеЗаписи.ПунктОтправленияГородАвто;
			Иначе
				НоваяСтрока.ПунктОтправленияГород = ВыборкаДетальныеЗаписи.ПунктОтправленияРегионАвто;
			КонецЕсли;	
		КонецЕсли;
		Если ПунктыИмена.Найти("ПунктОтправленияГород") <> Неопределено Тогда
			Если НЕ ЗначениеЗаполнено(СтрУслуги.ПунктОтправленияГород) И ТипЗнч(СтрУслуги.ПунктОтправления) = Тип("СправочникСсылка.Локации") Тогда
				СтрУслуги.ПунктОтправленияГород = НоваяСтрока.ПунктОтправленияГород;
			КонецЕсли;	                                                      
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НоваяСтрока.ПунктНазначения) И НЕ ЗначениеЗаполнено(НоваяСтрока.ПунктНазначенияГород) И ТипЗнч(НоваяСтрока.ПунктНазначения) = Тип("СправочникСсылка.Локации") Тогда
		Если ВыборкаДетальныеЗаписи.ТипПунктаНазначенияАвто = 1 Тогда
			НоваяСтрока.ПунктНазначенияГород = НоваяСтрока.ПунктНазначения;
		ИначеЕсли ВыборкаДетальныеЗаписи.ТипПунктаНазначенияАвто = 2 Тогда
			Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПунктНазначенияГородАвто) Тогда
				НоваяСтрока.ПунктНазначенияГород = ВыборкаДетальныеЗаписи.ПунктНазначенияГородАвто;
			Иначе
				НоваяСтрока.ПунктНазначенияГород = ВыборкаДетальныеЗаписи.ПунктНазначенияРегионАвто;
			КонецЕсли;	
		КонецЕсли;
		Если ПунктыИмена.Найти("ПунктНазначенияГород") <> Неопределено Тогда
			Если НЕ ЗначениеЗаполнено(СтрУслуги.ПунктНазначенияГород) И ТипЗнч(СтрУслуги.ПунктНазначения) = Тип("СправочникСсылка.Локации") Тогда
				СтрУслуги.ПунктНазначенияГород = НоваяСтрока.ПунктНазначенияГород;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НоваяСтрока.ПунктОтправленияГород) И НЕ ЗначениеЗаполнено(НоваяСтрока.ПунктОтправленияСтрана) И ТипЗнч(НоваяСтрока.ПунктОтправленияГород) = Тип("СправочникСсылка.Локации") Тогда
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПунктОтправленияСтранаАвто) Тогда
			НоваяСтрока.ПунктОтправленияСтрана = ВыборкаДетальныеЗаписи.ПунктОтправленияСтранаАвто;
		КонецЕсли;
		Если ПунктыИмена.Найти("ПунктОтправленияСтрана") <> Неопределено Тогда
			Если НЕ ЗначениеЗаполнено(СтрУслуги.ПунктОтправленияСтрана) И ТипЗнч(СтрУслуги.ПунктОтправленияГород) = Тип("СправочникСсылка.Локации") Тогда
				СтрУслуги.ПунктОтправленияСтрана = НоваяСтрока.ПунктОтправленияСтрана;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НоваяСтрока.ПунктНазначенияГород) И НЕ ЗначениеЗаполнено(НоваяСтрока.ПунктНазначенияСтрана) И ТипЗнч(НоваяСтрока.ПунктНазначенияГород) = Тип("СправочникСсылка.Локации") Тогда
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПунктНазначенияСтранаАвто) Тогда
			НоваяСтрока.ПунктНазначенияСтрана = ВыборкаДетальныеЗаписи.ПунктНазначенияСтранаАвто;
		КонецЕсли;
		Если ПунктыИмена.Найти("ПунктНазначенияСтрана") <> Неопределено Тогда
			Если НЕ ЗначениеЗаполнено(СтрУслуги.ПунктНазначенияСтрана) И ТипЗнч(СтрУслуги.ПунктНазначенияГород) = Тип("СправочникСсылка.Локации") Тогда
				СтрУслуги.ПунктНазначенияСтрана = НоваяСтрока.ПунктНазначенияСтрана;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
	
