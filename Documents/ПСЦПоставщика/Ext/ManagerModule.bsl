	МожноВыгружать = Ложь;
	Если ДокОбъект.Проведен И ЗначениеЗаполнено(ДокОбъект.ДатаСогласования) И ДокОбъект.ПодписанСДвухСторон Тогда
		МожноВыгружать = Истина;
	КонецЕсли;
	
	ИзмененияЕсть = Ложь;
	
	Если МожноВыгружать Тогда
		
		СписокРеквизитовДляСравнения = "ДатаСогласования, ДатаПСЦ, НомерПСЦ, НачалоДействия, ОкончаниеДействия, ДействуетДоСогласованияНовыхУсловий, Автор, ПодписанСДвухСторон, ОтветственныйМенеджер, Контрагент, Договор, Типовой";
		ЗначенияРеквизитовСсылки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокОбъект.Ссылка, СписокРеквизитовДляСравнения);
		ЗначенияРеквизитовОбъекта = Новый Структура(СписокРеквизитовДляСравнения);
		ЗаполнитьЗначенияСвойств(ЗначенияРеквизитовОбъекта, ДокОбъект);
		
		ИзмененияЕсть = Не ОбщегоНазначения.КоллекцииИдентичны(ЗначенияРеквизитовОбъекта, ЗначенияРеквизитовСсылки);
		
	КонецЕсли;
			
	Возврат ИзмененияЕсть;
	
