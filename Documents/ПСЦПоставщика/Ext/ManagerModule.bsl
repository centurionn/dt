Процедура ВыполнитьАвтоматическоеСогласование(Объект) Экспорт
	
	СтатусВыполнен = Перечисления.СтатусыЭтапов.Выполнен;
	СтатусВРаботе = Перечисления.СтатусыЭтапов.ВРаботе;
	СтатусНаВыполнение = Перечисления.СтатусыЭтапов.НаВыполнение;
	СогласованоБезЗамечаний = Перечисления.СтатусыСогласования.СогласованоБезЗамечаний;
	ТекущаяДата = ТекущаяДата();
	
	Если Объект.Типовой И Объект.СтатусДокумента = Перечисления.СтатусыСогласования.НаРассмотрении Тогда
			
		ВсеСтавкиПрошлиПроверку = Истина;
		Для Каждого Стр Из Объект.Услуги Цикл
			Если Стр.ПроверкаСтавок <> Перечисления.РезультатыПроверки.Пройдена Тогда
				ВсеСтавкиПрошлиПроверку = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ВсеСтавкиПрошлиПроверку Тогда
			
			АвтоматическиеСогласования = Новый Массив;
			//Для Каждого Стр Из Объект.Состояния Цикл
			//	Если Стр.Статус <> СтатусВыполнен Тогда
			//		Если Стр.Состояние.Согласование Тогда
			//			Стр.Статус = СтатусВыполнен;
			//			Стр.СтатусСогласования = СогласованоБезЗамечаний;
			//			Стр.ЗавершениеРаботы = ТекущаяДата;
			//			Стр.АвтоматическоеСогласование = Истина;
			//			АвтоматическиеСогласования.Добавить(Стр);
			//		КонецЕсли;
			//	КонецЕсли;
			//КонецЦикла;
			
			УсловиеВсеСтавкиПротоколаПрошлиПроверку = Справочники.УсловияАвтоматическогоВыполненияЗадач.ВсеСтавкиПротоколаПрошлиПроверку;
			НайденныеСтроки = Объект.Состояния.НайтиСтроки(Новый Структура("УсловиеАвтоматическогоВыполнения", УсловиеВсеСтавкиПротоколаПрошлиПроверку));
			Для Каждого Стр Из НайденныеСтроки Цикл
				Если Стр.Статус = СтатусВРаботе Или Стр.Статус = СтатусНаВыполнение Тогда
					Стр.Статус = СтатусВыполнен;
					Стр.СтатусСогласования = СогласованоБезЗамечаний;
					Стр.ЗавершениеРаботы = ТекущаяДата;
					Стр.АвтоматическоеСогласование = Истина;
					АвтоматическиеСогласования.Добавить(Стр);
				КонецЕсли;
			КонецЦикла;
			
			Если ЗначениеЗаполнено(АвтоматическиеСогласования) Тогда
			
				ДанныеПроцессаСогласования = СогласованиеСервер.ПолучитьПроцессСогласованияОбъекта(Объект.Ссылка);	
				Если ЗначениеЗаполнено(ДанныеПроцессаСогласования.Ссылка) Тогда
					ПроцессСогласования = ДанныеПроцессаСогласования.Ссылка.ПолучитьОбъект();
					ШагЦикла = ДанныеПроцессаСогласования.ШагЦикла;
				Иначе
					ПроцессСогласования = Справочники.ПроцессСогласования.СоздатьЭлемент();
					ПроцессСогласования.Заполнить(Объект.Ссылка);
					ШагЦикла = 1;
				КонецЕсли;
					
				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("ШагЦикла", ШагЦикла);

				Для Каждого Стр Из АвтоматическиеСогласования Цикл
					ПараметрыОтбора.Вставить("Состояние", Стр.Состояние);
					НайденныеСтроки = ПроцессСогласования.Состояния.НайтиСтроки(ПараметрыОтбора);
					Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
						СтрокаПроцесса = НайденныеСтроки[0];
						ЗаполнитьЗначенияСвойств(СтрокаПроцесса, Стр, "Статус, СтатусСогласования, ЗавершениеРаботы, АвтоматическоеСогласование");
					КонецЕсли;
