Функция ПолучитьТабДокЛистаСогласования(РецензОбъект, ТекущийЦикл = 1) Экспорт
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	Макет = ПолучитьМакет("ЛистСогласованияРеестрРазногласий");
	
	ШифрСеанса = Строка(Новый УникальныйИдентификатор);
	ИмяДокумента = Строка(РецензОбъект);
	ИмяДокументаЛС = ИмяДокумента;
	ИмяДокументаЛР = ИмяДокумента;
	Если ТипЗнч(РецензОбъект) = Тип("ДокументСсылка.ПСЦ") Тогда
		ДанныеПСЦ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РецензОбъект, "ВидПСЦ, НомерПСЦ, КлиентскийНомер, Контрагент, Номер, ДатаПСЦ");
		Префикс = ?(ЗначениеЗаполнено(ДанныеПСЦ.ВидПСЦ), Строка(ДанныеПСЦ.ВидПСЦ) + ": ", "ПК: ");
		НомерПСЦСтрока = ?(ЗначениеЗаполнено(ДанныеПСЦ.НомерПСЦ), Символы.ПС+Строка(ДанныеПСЦ.НомерПСЦ), "");
		КлиентскийНомерСтрока = ?(ЗначениеЗаполнено(ДанныеПСЦ.КлиентскийНомер), Символы.ПС+Строка(ДанныеПСЦ.КлиентскийНомер), "");
		Если НомерПСЦСтрока = КлиентскийНомерСтрока Тогда
			КлиентскийНомерСтрока = "";
		КонецЕсли;
		ИмяДокументаЛС = Префикс + ДанныеПСЦ.Контрагент + " №" + ДанныеПСЦ.Номер
						+ " от " + Формат(ДанныеПСЦ.ДатаПСЦ, "ДФ=dd.MM.yy") + НомерПСЦСтрока + КлиентскийНомерСтрока;
	КонецЕсли;
	ДатаПечати = ТекущаяДата();
	
	ШапкаЛС = Макет.ПолучитьОбласть("ШапкаЛС");
	ШапкаЛС.Параметры.ИмяДокумента = ИмяДокументаЛС;
	ШапкаЛС.Параметры.ДатаПечати = Формат(ДатаПечати, "ДФ='ЧЧ:мм дд.ММ.гг'");
	ТабДок.Вывести(ШапкаЛС);
	
	СчЭлементов = 0;
	
	ИмяМетаданных = РецензОбъект.Метаданные().Имя;
	ИмяКорняМД = ?(ИмяМетаданных = "ДоговорыКонтрагентов", "Справочник", "Документ");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", РецензОбъект);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СостоянияДокумента.Состояние КАК Состояние,
	|	СостоянияДокумента.Исполнитель КАК Исполнитель,
	|	СостоянияДокумента.СтатусСогласования КАК СтатусСогласования,
	|	СостоянияДокумента.НачалоРаботы КАК НачалоРаботы,
	|	СостоянияДокумента.ЗавершениеРаботы КАК ЗавершениеРаботы,
	|	СостоянияДокумента.ПричинаОтказа КАК ПричинаОтказа,
	|	СостоянияДокумента.АвтоматическоеСогласование КАК АвтоматическоеСогласование
	|ИЗ
	|	"+ИмяКорняМД+"."+ИмяМетаданных+".Состояния КАК СостоянияДокумента
	|ГДЕ
	|	СостоянияДокумента.Ссылка = &Ссылка
	|	И СостоянияДокумента.Состояние.Согласование";
	
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		СчЭлементов = СчЭлементов + 1;
		НСтр = Макет.ПолучитьОбласть("СтрокаЛС");
		НСтр.Параметры.Дата = Формат(Ответ.ЗавершениеРаботы, "ДФ='ЧЧ:мм дд.ММ.гг'");
		НСтр.Параметры.Этап = Ответ.Состояние;
		НСтр.Параметры.Согласующий = Ответ.Исполнитель;
		НСтр.Параметры.Результат = Ответ.СтатусСогласования;
		НСтр.Параметры.ПричинаОтказа = Ответ.ПричинаОтказа;
		НСтр.Параметры.АвтоматическоеСогласование = Формат(Ответ.АвтоматическоеСогласование, "БЛ=Нет; БИ=Да");
		ТабДок.Вывести(НСтр);
	КонецЦикла;
	
	ПодвалЛС = Макет.ПолучитьОбласть("ПодвалЛС");
	ПодвалЛС.Параметры.КоличествоСтрок = СчЭлементов;
	ПодвалЛС.Параметры.шифр = ШифрСеанса;
	ТабДок.Вывести(ПодвалЛС);
	
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Рецензирование.РецензОбъект КАК РецензОбъект,
	               |	Рецензирование.Рецензент КАК Рецензент,
	               |	Рецензирование.ТаймШтамп КАК ТаймШтамп,
	               |	Рецензирование.ИсходныйТекст КАК ИсходныйТекст,
	               |	Рецензирование.НоваяРедакция КАК НоваяРедакция,
	               |	Рецензирование.Комментарии КАК Комментарии,
	               |	Рецензирование.ОтветИнициатора КАК ОтветИнициатора
	               |ИЗ
	               |	РегистрСведений.Рецензирование КАК Рецензирование
	               |ГДЕ
	               |	(Рецензирование.РецензОбъект В
	               |				(ВЫБРАТЬ
	               |					СведенияОФайлах.Файл КАК Файл
	               |				ИЗ
	               |					РегистрСведений.СведенияОФайлах КАК СведенияОФайлах
	               |				ГДЕ
	               |					СведенияОФайлах.ВладелецФайла = &ВладелецФайла
	               |					И НЕ СведенияОФайлах.ПометкаУдаления
	               |					И НЕ СведенияОФайлах.Служебный)
	               |			ИЛИ Рецензирование.РецензОбъект = &ВладелецФайла)
	               |	И Рецензирование.ЦиклСогласования = &ЦиклСогласования
	               |ИТОГИ ПО
	               |	РецензОбъект";
	Запрос.УстановитьПараметр("ВладелецФайла", РецензОбъект);
	Запрос.УстановитьПараметр("ЦиклСогласования", ТекущийЦикл);
	Ответ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Ответ.Следующий() Цикл
		
		ШапкаЛР = Макет.ПолучитьОбласть("ШапкаЛР");
		ШапкаЛР.Параметры.ИмяДокумента = ИмяДокументаЛР;
		ШапкаЛР.Параметры.ИмяФайла = Ответ.РецензОбъект;
		
		ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		Табдок.Вывести(ШапкаЛР);
		СчЭлементов = 0;
		
		ПодОтвет = Ответ.Выбрать();
		Пока ПодОтвет.Следующий() Цикл
			
			СчЭлементов = СчЭлементов + 1;
			НСтр = Макет.ПолучитьОбласть("СтрокаЛР");
			НСтр.Параметры.Дата = Формат(ПодОтвет.ТаймШтамп, "ДФ='ЧЧ:мм дд.ММ.гг'");
			НСтр.Параметры.Согласующий = ПодОтвет.Рецензент;
			НСтр.Параметры.Исх = ПодОтвет.ИсходныйТекст;
			НСтр.Параметры.Нов = ПодОтвет.НоваяРедакция;
			НСтр.Параметры.Комментарий = ПодОтвет.Комментарии;
			НСтр.Параметры.ОтветИнииатора = ПодОтвет.ОтветИнициатора;
			ТабДок.Вывести(НСтр);
			
		КонецЦикла;
		
		ПодвалЛР = Макет.ПолучитьОбласть("ПодвалЛР");
		ПодвалЛР.Параметры.КоличествоСтрок = СчЭлементов;
		ПодвалЛР.Параметры.шифр = ШифрСеанса;
		ТабДок.Вывести(ПодвалЛР);
		
	КонецЦикла;
	
	Возврат ТабДок;
	
КонецФункции

Процедура СверитьУслугиПротоколаСНормативнымиСтавками(Протокол, ВызовИзФормы = Ложь) Экспорт
	
	Если Протокол.Услуги.Количество() > 0 Тогда
		
		ПроверкаНеОсуществлялась = Перечисления.РезультатыПроверки.НеОсуществлялась;
		ПроверкаПройдена = Перечисления.РезультатыПроверки.Пройдена;
		ПроверкаНеПройдена = Перечисления.РезультатыПроверки.НеПройдена;
		КлючНормативнойСтавкиПустаяСсылка = Справочники.КлючиАналитикиСтрокПротокола.ПустаяСсылка();
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПротоколСНормативнымиСтавкамиНаУслугиПоставщиков.Ссылка КАК Ссылка,
		|	ПротоколСНормативнымиСтавкамиНаУслугиПоставщиков.НачалоДействия КАК НачалоДействия
		|ИЗ
		|	Документ.ПротоколСНормативнымиСтавкамиНаУслугиПоставщиков КАК ПротоколСНормативнымиСтавкамиНаУслугиПоставщиков
		|ГДЕ
		|	ПротоколСНормативнымиСтавкамиНаУслугиПоставщиков.НачалоДействия <= &НачалоДействия
		|	И (ПротоколСНормативнымиСтавкамиНаУслугиПоставщиков.ДействуетДоСогласованияНовыхУсловий
		|			ИЛИ ПротоколСНормативнымиСтавкамиНаУслугиПоставщиков.ОкончаниеДействия >= &НачалоДействия)
		|	И ПротоколСНормативнымиСтавкамиНаУслугиПоставщиков.Проведен
		|	И ПротоколСНормативнымиСтавкамиНаУслугиПоставщиков.СтатусДокумента = &СтатусДокументаСогласован
		|	И ПротоколСНормативнымиСтавкамиНаУслугиПоставщиков.ВидУслугПоставщика = &ВидУслугПоставщика
		|
		|УПОРЯДОЧИТЬ ПО
		|	НачалоДействия УБЫВ,
		|	ПротоколСНормативнымиСтавкамиНаУслугиПоставщиков.МоментВремени УБЫВ";
		
		Запрос.УстановитьПараметр("ДатаПротокола", Протокол.ДатаПСЦ);
		Запрос.УстановитьПараметр("НачалоДействия", Протокол.НачалоДействия);
		Запрос.УстановитьПараметр("ВидУслугПоставщика", Протокол.ВидУслугПоставщика);
		
		СтатусДокументаСогласован = Перечисления.СтатусыСогласования.СогласованоБезЗамечаний;
		Запрос.УстановитьПараметр("СтатусДокументаСогласован", СтатусДокументаСогласован);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			
			ДействующийПротоколНормативныхСтавок = Выборка.Ссылка;
			
			НормативныеСтавки = ПолучитьНормативныеСтавкиДляУслугПротокола(Протокол);
			
			НомераСтрокБезНайденныхНормативов = Новый Массив;
			НомераСтрокСНеподошедшимиНормативами = Новый Массив;
			Для Каждого СтрокаУслуги Из Протокол.Услуги Цикл
				
				КоличествоПройденныхПроверок = 0;
				КоличествоНепройденныхПроверок = 0;
				КоличествоНевыполненныхПроверок = 0;
				
				Если ВызовИзФормы Тогда
					СтрокаУслуги.КлючиНеподошедшихНормативныхСтавок.Очистить();
				КонецЕсли;
				
				СтрокиКритериев = Протокол.КритерииУслуг.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", СтрокаУслуги.ИдентификаторСтрокиУслуг));
				Для Каждого СтрокаКритерия Из СтрокиКритериев Цикл
					
					НормативыНеПодошедшиеПоНормеПользования = Новый Массив;
					ПроверкаСтрокиПройдена = Неопределено;
					НайденныеНормативы = НормативныеСтавки.НайтиСтроки(Новый Структура("НомерСтрокиКритериев", СтрокаКритерия.НомерСтроки));
					Если ЗначениеЗаполнено(НайденныеНормативы) Тогда						
						
						Для Каждого Норматив Из НайденныеНормативы Цикл					
							Если ЗначениеЗаполнено(Норматив.КритерийНорматива) Тогда
								Если Норматив.НормаПользования = 0 
										Или (СтрокаУслуги.НормаПользования <> 0 И СтрокаУслуги.НормаПользования <= Норматив.НормаПользования) Тогда
									Если СтрокаУслуги.СтоимостьБезНДС <= Норматив.НормативСтоимостьБезНДС Тогда
										ПроверкаСтрокиПройдена = Истина;
									Иначе
										ПроверкаСтрокиПройдена = Ложь;
										Прервать;
									КонецЕсли;
								Иначе
									НормативыНеПодошедшиеПоНормеПользования.Добавить(Норматив);
								КонецЕсли;
							КонецЕсли;
						КонецЦикла;
						
						Если ПроверкаСтрокиПройдена = Неопределено Тогда
							Если ВызовИзФормы И ЗначениеЗаполнено(НормативыНеПодошедшиеПоНормеПользования) Тогда
								Для Каждого Стр Из НормативыНеПодошедшиеПоНормеПользования Цикл
									Если ЗначениеЗаполнено(Стр.ТипоразмерКТКПредставление) Тогда
										Представление = СтрШаблон("Нормативная ставка для %1 с нормой пользования %2 (Протокол:%3)", Стр.ТипоразмерКТКПредставление, Стр.НормаПользования, Стр.РегистраторНомер);
									Иначе
										Представление = СтрШаблон("Нормативная ставка с нормой пользования %1 (Протокол%2)", Стр.НормаПользования, Стр.РегистраторНомер);
									КонецЕсли;
									СтрокаУслуги.КлючиНеподошедшихНормативныхСтавок.Добавить(Стр.КлючНормативнойСтавки, Представление);
									НомераСтрокСНеподошедшимиНормативами.Добавить(СтрокаУслуги.НомерСтроки);
								КонецЦикла;
							КонецЕсли;
							СтрокаКритерия.КлючНормативнойСтавки = КлючНормативнойСтавкиПустаяСсылка;
						Иначе
							СтрокаКритерия.КлючНормативнойСтавки = Норматив.КлючНормативнойСтавки;
						КонецЕсли;
						
					Иначе
						СтрокаКритерия.КлючНормативнойСтавки = КлючНормативнойСтавкиПустаяСсылка;
						НомераСтрокБезНайденныхНормативов.Добавить(СтрокаУслуги.НомерСтроки);
					КонецЕсли;
					
					Если ПроверкаСтрокиПройдена = Истина Тогда
						КоличествоПройденныхПроверок = КоличествоПройденныхПроверок + 1;
					ИначеЕсли ПроверкаСтрокиПройдена = Ложь Тогда
						КоличествоНепройденныхПроверок = КоличествоНепройденныхПроверок + 1;
					Иначе
						КоличествоНевыполненныхПроверок = КоличествоНевыполненныхПроверок + 1;
					КонецЕсли;
					
				КонецЦикла;
				
				Если КоличествоНепройденныхПроверок > 0 Тогда
					СтрокаУслуги.ПроверкаСтавок = ПроверкаНеПройдена;
				ИначеЕсли КоличествоНевыполненныхПроверок > 0 Тогда
					СтрокаУслуги.ПроверкаСтавок = ПроверкаНеОсуществлялась;
				ИначеЕсли КоличествоПройденныхПроверок > 0 Тогда
					СтрокаУслуги.ПроверкаСтавок = ПроверкаПройдена;
				Иначе
					СтрокаУслуги.ПроверкаСтавок = ПроверкаНеОсуществлялась;
				КонецЕсли;
				
			КонецЦикла;
			
			Если ЗначениеЗаполнено(НомераСтрокСНеподошедшимиНормативами) Тогда				
				ПутьКПолюТЧ = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Услуги", НомераСтрокСНеподошедшимиНормативами[0], "КлючиНормативныхСтавокСтрокой");				
				НомераСтрокСНеподошедшимиНормативами = ОбщегоНазначенияКлиентСервер.СвернутьМассив(НомераСтрокСНеподошедшимиНормативами);
				НомераСтрок = СтрСоединить(НомераСтрокСНеподошедшимиНормативами, ", ");				
				ТекстСообщения = СтрШаблон("По строкам № %1 не найдено соответствия, т.к. отличается период предоставления от нормы пользования в нормативной ставке.", НомераСтрок);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Протокол.Ссылка, ПутьКПолюТЧ, "Объект");				
			КонецЕсли;
			
			Если ВызовИзФормы И ЗначениеЗаполнено(НомераСтрокБезНайденныхНормативов) Тогда
				ПутьКПолюТЧ = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Услуги", НомераСтрокБезНайденныхНормативов[0], "КлючиНормативныхСтавокСтрокой");
				НомераСтрокБезНайденныхНормативов = ОбщегоНазначенияКлиентСервер.СвернутьМассив(НомераСтрокБезНайденныхНормативов);
				НомераСтрок = СтрСоединить(НомераСтрокБезНайденныхНормативов, ", ");
				ШаблонСообщенияСАктуальнымПротоколом = "По строкам № %1 не найдено соответствия, т.к. не найден актуальный тариф на этот период.";				
				ТекстСообщения = СтрШаблон(ШаблонСообщенияСАктуальнымПротоколом, НомераСтрок);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Протокол.Ссылка, ПутьКПолюТЧ, "Объект");
				//ФорматированныйТекст = Новый ФорматированнаяСтрока(ТекстСообщения,, WebЦвета.Красный,, ПолучитьНавигационнуюСсылку(ДействующийПротоколНормативныхСтавок));
				//ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДействующийПротоколНормативныхСтавок);
			КонецЕсли;
			
		Иначе
			
			
			Для Каждого Стр Из Протокол.Услуги Цикл
				Стр.ПроверкаСтавок = ПроверкаНеОсуществлялась;
			КонецЦикла;
			
			Для Каждого СтрокаКритерия Из Протокол.КритерииУслуг Цикл
				СтрокаКритерия.КлючНормативнойСтавки = КлючНормативнойСтавкиПустаяСсылка;
			КонецЦикла;
			
			Если ВызовИзФормы Тогда
				ОбщегоНазначения.СообщитьПользователю("На период действия ПСЦ Поставщика не найден Протокол с нормативными ставками на услуги поставщика.");		
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьНормативныеСтавкиДляУслугПротокола(Протокол) Экспорт
	
	ПустаяДата = '00010101';
	ЛокацияПустаяСсылка = Справочники.Локации.ПустаяСсылка();
	
	ТипЛокацииГород = Справочники.ТипыЛокаций.НаселенныйПункт;
	ТипЛокацииСтрана = Справочники.ТипыЛокаций.Страна;
	
	ТипИерархииГород = Перечисления.ТипыИерархииЛокации.НаселенныйПункт;
	ТипИерархииСтрана = Перечисления.ТипыИерархииЛокации.Страна;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ПСЦПоставщикаУслуги.Валюта КАК Валюта,
	|	ПСЦПоставщикаУслуги.Номенклатура КАК Номенклатура,
	|	ПСЦПоставщикаУслуги.ВидСобственности КАК ВидСобственности,
	|	ПСЦПоставщикаУслуги.ПунктОтправления КАК ПунктОтправления,
	|	ПСЦПоставщикаУслуги.ПунктОтправленияГород КАК ПунктОтправленияГород,
	|	ПСЦПоставщикаУслуги.ПунктОтправленияСтрана КАК ПунктОтправленияСтрана,
	|	ПСЦПоставщикаУслуги.ПунктНазначения КАК ПунктНазначения,
	|	ПСЦПоставщикаУслуги.ПунктНазначенияГород КАК ПунктНазначенияГород,
	|	ПСЦПоставщикаУслуги.ПунктНазначенияСтрана КАК ПунктНазначенияСтрана,
	|	ПСЦПоставщикаУслуги.НормаПользования КАК НормаПользования,
	|	ПСЦПоставщикаУслуги.СтоимостьСНДС КАК СтоимостьСНДС,
	|	ПСЦПоставщикаУслуги.СтоимостьБезНДС КАК СтоимостьБезНДС
	|ПОМЕСТИТЬ ТЧУслуги
	|ИЗ
	|	Документ.ПСЦПоставщика.Услуги КАК ПСЦПоставщикаУслуги
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПСЦПоставщикаКритерииУслуг.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ПСЦПоставщикаКритерииУслуг.ТипоразмерКТК КАК ТипоразмерКТК,
	|	ПСЦПоставщикаКритерииУслуг.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ТЧКритерииУслуг
	|ИЗ
	|	Документ.ПСЦПоставщика.КритерииУслуг КАК ПСЦПоставщикаКритерииУслуг
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПСЦПоставщикаУслуги.СтоимостьСНДС КАК СтоимостьСНДС,
	|	ПСЦПоставщикаУслуги.СтоимостьБезНДС КАК СтоимостьБезНДС,
	|	ПСЦПоставщикаУслуги.Валюта КАК Валюта,
	|	ПСЦПоставщикаУслуги.Номенклатура КАК Номенклатура,
	|	ПСЦПоставщикаУслуги.ВидСобственности КАК ВидСобственности,
	|	ПСЦПоставщикаУслуги.ПунктОтправления КАК ПунктОтправления,
	|	ПСЦПоставщикаУслуги.ПунктОтправленияГород КАК ПунктОтправленияГород,
	|	ПСЦПоставщикаУслуги.ПунктОтправленияСтрана КАК ПунктОтправленияСтрана,
	|	ПСЦПоставщикаУслуги.ПунктНазначения КАК ПунктНазначения,
	|	ПСЦПоставщикаУслуги.ПунктНазначенияГород КАК ПунктНазначенияГород,
	|	ПСЦПоставщикаУслуги.ПунктНазначенияСтрана КАК ПунктНазначенияСтрана,
	|	ПСЦПоставщикаУслуги.НормаПользования КАК НормаПользования,
	|	ПСЦПоставщикаКритерииУслуг.ТипоразмерКТК КАК ТипоразмерКТК,
	|	ПСЦПоставщикаКритерииУслуг.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ТЧПротоколаПоставщика
	|ИЗ
	|	ТЧУслуги КАК ПСЦПоставщикаУслуги
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТЧКритерииУслуг КАК ПСЦПоставщикаКритерииУслуг
	|		ПО ПСЦПоставщикаУслуги.ИдентификаторСтрокиУслуг = ПСЦПоставщикаКритерииУслуг.ИдентификаторСтрокиУслуг
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЧПротоколаПоставщика.НомерСтроки КАК НомерСтроки,
