	|			И (НЕ СправочникКритерии.ПометкаУдаления)
	|			И (НЕ СправочникКритерии.НормативныйПоказатель)
	|			И Критерии.ДляГруженых = СправочникКритерии.ДляГруженых
	|			И Критерии.ДляПорожних = СправочникКритерии.ДляПорожних		
	|			И Критерии.КТКВагонОпределенногоСобственника = СправочникКритерии.КТКВагонОпределенногоСобственника
	|			И Критерии.Номенклатура = СправочникКритерии.Номенклатура
	|			И Критерии.ДетализацияКомплекснойСтавки = СправочникКритерии.ДетализацияКомплекснойСтавки
	|ГДЕ
	|	Критерии.Критерий <> ЕСТЬNULL(СправочникКритерии.Ссылка, НЕОПРЕДЕЛЕНО)
	|;
