	|	УслугиПоУчетнымЕдиницам.ШкалаСтоимостьСНДС КАК ШкалаСтоимостьСНДС,
	|	УслугиПоУчетнымЕдиницам.ШкалаСтоимостьБезНДС КАК ШкалаСтоимостьБезНДС,
	|	УслугиПоУчетнымЕдиницам.СтавкаПрогрессивная КАК СтавкаПрогрессивная,
	|	ТарифыПоставщиков.Регистратор КАК Регистратор,
	|	ТарифыПоставщиков.Регистратор.Представление КАК РегистраторПредставление,
	|	УслугиПоУчетнымЕдиницам.Комментарий КАК Комментарий,
	|	УслугиПоУчетнымЕдиницам.ДетализацияКомплекснойСтавки КАК ДетализацияКомплекснойСтавки,
	//Евросиб Шевченко А.В. US 125530 TA 125727 15.12.2025
	|	УслугиПоУчетнымЕдиницам.СтавкаЗаПСВСутСНДС КАК СтоимостьЗаСуткиСНДС,
	|	УслугиПоУчетнымЕдиницам.СтавкаЗаПСВСутБезНДС КАК СтоимостьЗаСуткиБезНДС
	//Евросиб Шевченко А.В. US 125530 TA 125727 15.12.2025
		//Евросиб СубботинВ #131884 02.03.2026 Начало 
	|	,УслугиПоУчетнымЕдиницам.КлючНормативнойСтавки КАК КлючАналитикиСтрокиПротокола
	//Евросиб СубботинВ #131884 02.03.2026 Конец
	|ИЗ
	|	УслугиПоУчетнымЕдиницам КАК УслугиПоУчетнымЕдиницам
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТарифыПоставщиков КАК ТарифыПоставщиков
	|		ПО УслугиПоУчетнымЕдиницам.Критерий = ТарифыПоставщиков.Критерий
	|			И (ТарифыПоставщиков.Период = &НачалоДействия)
	|			И (ТарифыПоставщиков.Регистратор <> &Регистратор)
	|			И &ТекстОтбораПоКлиентуЕвросиб
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки,
	|	УчетнаяЕдиница";
	
	//Евросиб Шевченко А.В. US 112958 TA 112963 02.07.2025 -начало
	Запрос.УстановитьПараметр("ТекстОтбораПоКлиентуЕвросиб", ИСТИНА);
	Если ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Автоперевозки ИЛИ ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Терминалы Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстОтбораПоКлиентуЕвросиб", "ТарифыПоставщиков.Критерий.КлиентЕвросиб = &КлиентЕвросиб");
		Запрос.УстановитьПараметр("КлиентЕвросиб", КлиентЕвросиб);	
	КонецЕсли;
	//Евросиб Шевченко А.В. US 112958 TA 112963 02.07.2025 -конец
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("НачалоДействия", НачалоДействия);
	Запрос.УстановитьПараметр("Регистратор", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если СтатусДокумента = Перечисления.СтатусыСогласования.СогласованоБезЗамечаний
			Или СтатусДокумента = Перечисления.СтатусыСогласования.СогласованСКомментариями
			Или СтатусДокумента = Перечисления.СтатусыСогласования.Подписано
		Тогда
		СтатусТарифа = Перечисления.СтатусыТарифовПоставщиков.СогласованПоПСЦ;
	Иначе
		СтатусТарифа = Перечисления.СтатусыТарифовПоставщиков.ПроведенПоПСЦ;
	КонецЕсли;
	
	//Евросиб СубботинВ #131884 02.03.2026 Начало
	//ЗаполняемыеПоляТарифа = "Критерий,СтоимостьБезНДС,СтоимостьСНДС,ШкалаСтоимостьБезНДС,ШкалаСтоимостьСНДС,ОкончаниеДействия,Комментарий,ДетализацияКомплекснойСтавки";
	ЗаполняемыеПоляТарифа = "Критерий,СтоимостьБезНДС,СтоимостьСНДС,ШкалаСтоимостьБезНДС,ШкалаСтоимостьСНДС,ОкончаниеДействия,Комментарий,ДетализацияКомплекснойСтавки,КлючАналитикиСтрокиПротокола";
	//Евросиб СубботинВ #131884 02.03.2026 Конец
	ЗаполняемыеПоляТарифаПоУчетнымЕдиницам = "Критерий,УчетнаяЕдиница,СтоимостьБезНДС,СтоимостьСНДС,ШкалаСтоимостьБезНДС,ШкалаСтоимостьСНДС,ОкончаниеДействия,ДетализацияКомплекснойСтавки,Комментарий";
	//Евросиб Шевченко А.В. US 125530 TA 125727 15.12.2025
	Если ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Вагоны Тогда
		ЗаполняемыеПоляТарифа = ЗаполняемыеПоляТарифа + ",СтоимостьЗаСуткиСНДС,СтоимостьЗаСуткиБезНДС";
		ЗаполняемыеПоляТарифаПоУчетнымЕдиницам = ЗаполняемыеПоляТарифаПоУчетнымЕдиницам + ",СтоимостьЗаСуткиСНДС,СтоимостьЗаСуткиБезНДС";	
	Конецесли;	
	//Евросиб Шевченко А.В. US 125530 TA 125727 15.12.2025
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.Регистратор) Тогда
			ПутьКПолюТЧ = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Услуги", Выборка.НомерСтроки, "НомерСтроки");
			ТекстСообщения = СтрШаблон("Данный тариф уже введен с такой же датой начала действия документом %1", Выборка.РегистраторПредставление);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПутьКПолюТЧ, "Объект", Отказ);
		КонецЕсли;
			
		Если ЗначениеЗаполнено(Выборка.УчетнаяЕдиница) Тогда
			Тариф = ТарифыПоставщиковПоУчетнымЕдиницам.Добавить();
			ЗаполнитьСтрокуТарифа(Тариф, Выборка, СтатусТарифа, ЗаполняемыеПоляТарифаПоУчетнымЕдиницам);
		Иначе
			Тариф = ТарифыПоставщиков.Добавить();
			ЗаполнитьСтрокуТарифа(Тариф, Выборка, СтатусТарифа, ЗаполняемыеПоляТарифа);
		КонецЕсли;			
			
	КонецЦикла;
	
КонецПроцедуры

