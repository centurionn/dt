			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПутьКПолюТЧ, "Объект", Отказ);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.ЕдиницаИзмерения) Тогда
			Единицы = РазрешенныеЕдиницы.Получить(Стр.Номенклатура);
			Если ЗначениеЗаполнено(Единицы) Тогда
				Если Единицы.Найти(Стр.ЕдиницаИзмерения) = Неопределено Тогда
					ПутьКПолюТЧ = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Услуги", Стр.НомерСтроки, "ЕдиницаИзмерения");
					ТекстСообщения = СтрШаблон("В строке №%1 единица измерения ""%2"" не соответствует разрешенным единицам измерения номенклатуры %3.", Стр.НомерСтроки, Стр.ЕдиницаИзмерения, Стр.Номенклатура);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПутьКПолюТЧ, "Объект", Отказ);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если Стр.ТребуетсяДетализацияКомплекснойСтавки Тогда
			
			Детализация = ДетализацияКомплекснойСтавки.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", Стр.ИдентификаторСтрокиУслуг));
			СуммаПоСтрокам = 0;
			Для Каждого СтрокаДетализации Из Детализация Цикл
				Если Не ЗначениеЗаполнено(СтрокаДетализации.ПроцентОтСтавки) Тогда
					ПутьКПолюТЧ = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Услуги", Стр.НомерСтроки, "ТребуетсяДетализацияКомплекснойСтавки");
					ТекстСообщения = СтрШаблон("В детализации комплексной ставки по строке №%1 не заполнено поле ""Процент от ставки""!", Стр.НомерСтроки);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПутьКПолюТЧ, "Объект", Отказ);
				Иначе
					СуммаПоСтрокам = СуммаПоСтрокам + СтрокаДетализации.ПроцентОтСтавки;
				КонецЕсли;
			КонецЦикла;
			
			Если СуммаПоСтрокам <> 100 Тогда
				ПутьКПолюТЧ = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Услуги", Стр.НомерСтроки, "ТребуетсяДетализацияКомплекснойСтавки");
				ТекстСообщения = СтрШаблон("В детализации комплексной ставки по строке №%1 сумма процентов участия услуг в комплексной ставке по всем строкам не равна 100%%!", Стр.НомерСтроки);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПутьКПолюТЧ, "Объект", Отказ);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтрокаСНПВагонов = Услуги.Найти(Справочники.Номенклатура.СНПвагонов, "Номенклатура");
	СтрокаСНПвагоновПогрузкаВыгрузка = Услуги.Найти(Справочники.Номенклатура.СНПвагоновПогрузкаВыгрузка, "Номенклатура");
	Если СтрокаСНПВагонов <> Неопределено И СтрокаСНПвагоновПогрузкаВыгрузка <> Неопределено Тогда
		ПутьКПолюТЧ = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Услуги", СтрокаСНПВагонов.НомерСтроки, "Номенклатура");
		ТекстСообщения = СтрШаблон("Ошибка по строкам №%1 (СНПВагонов) и №%2 (СНПвагоновПогрузкаВыгрузка). В протоколе может быть использован только один вид номенклатуры по Сверхнормативному пользованию.", СтрокаСНПВагонов.НомерСтроки, СтрокаСНПвагоновПогрузкаВыгрузка.НомерСтроки);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПутьКПолюТЧ, "Объект", Отказ);
	КонецЕсли; 
	
	//Евросиб Коханенко Н.А. 09.06.2025 (( #109338
	ЭлементВидПеревозки = ПроверяемыеРеквизиты.Найти("ВидПеревозки");
	Если ВидУслугПоставщика = ПредопределенноеЗначение("Справочник.ВидыУслугПоставщиков.Контейнеры") 
		И ЭлементВидПеревозки = Неопределено Тогда
		ПроверяемыеРеквизиты.Добавить("ВидПеревозки");
	ИначеЕсли ЭлементВидПеревозки <> Неопределено Тогда
		ПроверяемыеРеквизиты.Удалить(ЭлементВидПеревозки);
	КонецЕсли;
	//Евросиб Коханенко Н.А. 09.06.2025 )) #109338 
	
