	Запрос.УстановитьПараметр("Детализация", ДетализацияКомплекснойСтавки.Выгрузить());	
	ТаблицаДетализации = Запрос.Выполнить().Выгрузить();
	
	НовыеДетализации = Новый Массив;
	
	Для Каждого Стр Из Услуги Цикл
		
		Детализация = ТаблицаДетализации.Найти(Стр.ИдентификаторСтрокиУслуг, "ИдентификаторСтрокиУслуг");
		Если Детализация <> Неопределено Тогда
			Если ЗначениеЗаполнено(Детализация.Ссылка) Тогда
				
				Стр.ДетализацияКомплекснойСтавки = Детализация.Ссылка;
				
			Иначе
				
				СтрокиДетализации = ДетализацияКомплекснойСтавки.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", Стр.ИдентификаторСтрокиУслуг));
				КоличествоСтрок = СтрокиДетализации.Количество();
				
				НайденнаяДетализация = Неопределено;
				Для Каждого НоваяДетализация Из НовыеДетализации Цикл					
					Если НоваяДетализация.КоличествоСтрокДетализации = КоличествоСтрок Тогда
						ВсеСтрокиНайдены = Истина;
						Для Каждого СтрДетализации Из СтрокиДетализации Цикл
							//Евросиб Шевченко А.В. US 125530 TA 128244 13.02.2026
							//НайденныеСтроки = НоваяДетализация.Детализация.НайтиСтроки(Новый Структура("НоменклатураПоставщика,Номенклатура,ПроцентОтСтавки", СтрДетализации.НоменклатураПоставщика, СтрДетализации.Номенклатура, СтрДетализации.ПроцентОтСтавки));
							НайденныеСтроки = НоваяДетализация.Детализация.НайтиСтроки(Новый Структура("Номенклатура", СтрДетализации.Номенклатура));
							//Евросиб Шевченко А.В. US 125530 TA 128244 13.02.2026
							Если Не ЗначениеЗаполнено(НайденныеСтроки) Тогда
								ВсеСтрокиНайдены = Ложь;
								Прервать;
							КонецЕсли;
						КонецЦикла;
						Если ВсеСтрокиНайдены Тогда
							НайденнаяДетализация = НоваяДетализация;
							Прервать;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				
				Если НайденнаяДетализация <> Неопределено Тогда
					Стр.ДетализацияКомплекснойСтавки = НайденнаяДетализация.Ссылка;
				Иначе
					НоваяДетализация = Справочники.ДетализацияКомплексныхУслугПоставщиков.СоздатьЭлемент();
					Для Каждого СтрокаДетализации Из СтрокиДетализации Цикл
						НоваяСтрока = НоваяДетализация.Детализация.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДетализации);
					КонецЦикла;
					НоваяДетализация.Записать();
					НовыеДетализации.Добавить(НоваяДетализация);
					
					Стр.ДетализацияКомплекснойСтавки = НоваяДетализация.Ссылка;
				КонецЕсли;
				
			КонецЕсли;
		Иначе
			Стр.ДетализацияКомплекснойСтавки = ДетализацияПустаяСсылка;
		КонецЕсли;		
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция СоздатьНовуюШкалу(СтрокиШкалы, ИмяПоляЦена)
	
	НовыйЭлемент = Справочники.ШкалыЦен.СоздатьЭлемент();
	
	Для Каждого СтрокаШкалы Из СтрокиШкалы Цикл
		НоваяСтрока = НовыйЭлемент.Шкала.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаШкалы, "От, До");
		НоваяСтрока.Цена = СтрокаШкалы[ИмяПоляЦена];
	КонецЦикла;
	
	НовыйЭлемент.Записать();
	
	Возврат НовыйЭлемент.Ссылка;
	
КонецФункции

Функция НайтиНоменклатуруПоставщика(Наименование, Номенклатура)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НоменклатураПоставщиков.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.НоменклатураПоставщиков КАК НоменклатураПоставщиков
	|ГДЕ
	|	НоменклатураПоставщиков.Наименование = &Наименование
	|	И НоменклатураПоставщиков.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		НоменклатураПоставщика = Выборка.Ссылка;
	Иначе
		НоменклатураПоставщика = Справочники.НоменклатураПоставщиков.ПустаяСсылка();
	КонецЕсли;
	
	Возврат НоменклатураПоставщика;
	
КонецФункции

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
		
	ЕдиницаИзмеренияВагоноСутки = Справочники.КлассификаторЕдиницИзмерения.ВагоноСутки;
	ЕдиницаИзмеренияВагон = Справочники.КлассификаторЕдиницИзмерения.вагон;
	ЕдиницаИзмеренияКонтейнероСутки = Справочники.КлассификаторЕдиницИзмерения.КонтейнероСутки;
	ЕдиницаИзмеренияКонтейнер = Справочники.КлассификаторЕдиницИзмерения.ктк;
	
	Если ЗначениеЗаполнено(Контрагент) Тогда
		
		РеквизитыКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент, "ИсполнительУслуги, ТипКонтрагента_Подрядчик");
		
		//Если Не РеквизитыКонтрагента.ИсполнительУслуги Тогда
		//	//ПутьКПолюТЧ = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Услуги", Стр.НомерСтроки, Поле.Имя);
		//	ТекстСообщения = "Создание ПСЦ Поставщика с данным контрагентом невозможно, т.к. выбранный контрагент не является исполнителем услуг/подряда.";
		//	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "Контрагент", "Объект", Отказ);
		//КонецЕсли;
		
		Если Не РеквизитыКонтрагента.ТипКонтрагента_Подрядчик Тогда
			ТекстСообщения = "Контрагент не является Подрядчиком. Проведение документа запрещено.";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "Контрагент", "Объект", Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОкончаниеДействия) Тогда
		Если ОкончаниеДействия <= НачалоДействия Тогда
			ТекстСообщения = "Окончание действия должно быть больше Начала действия.";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "ОкончаниеДействия", "Объект", Отказ);
		КонецЕсли;
	КонецЕсли;
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ДатаНачалаДействияДоговора, СрокДействия");
	Если ЗначениеЗаполнено(РеквизитыДоговора.ДатаНачалаДействияДоговора) Тогда
		Если ДатаПСЦ < РеквизитыДоговора.ДатаНачалаДействияДоговора Или (ЗначениеЗаполнено(РеквизитыДоговора.СрокДействия) И ДатаПСЦ > РеквизитыДоговора.СрокДействия) Тогда
			ТекстСообщения = "Дата ПСЦ не входит в период действия договора.";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "ДатаПСЦ", "Объект", Отказ);
		КонецЕсли;
		Если НачалоДействия < РеквизитыДоговора.ДатаНачалаДействияДоговора Или (ЗначениеЗаполнено(РеквизитыДоговора.СрокДействия) И НачалоДействия > РеквизитыДоговора.СрокДействия) Тогда
			ТекстСообщения = "Дата Начала действия ПСЦ не входит в период действия договора.";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "НачалоДействия", "Объект", Отказ);
		КонецЕсли;
	КонецЕсли;	
	
	Если Не ДействуетДоСогласованияНовыхУсловий И Не ЗначениеЗаполнено(ОкончаниеДействия) Тогда
		ТекстСообщения = "Поле ""Окончание действия"" не заполнено";
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "ОкончаниеДействия", "Объект", Отказ);
	КонецЕсли;
	
	НастройкиВидаУслуг = Справочники.ВидыУслугПоставщиков.ПолучитьНастройкиВидаУслуг(ВидУслугПоставщика, "ПСЦПоставщика.Услуги");
	ПоляТаблицыУслуг = НастройкиВидаУслуг.ПоляТаблицыУслуг;
	ДопУсловия = НастройкиВидаУслуг.ДопУсловия;
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
	"ВЫБРАТЬ
	|	НоменклатураРазрешенныеЕИ.Ссылка КАК Номенклатура,
	|	НоменклатураРазрешенныеЕИ.Элемент КАК ЕдиницаИзмерения
	|ИЗ
	|	Справочник.Номенклатура.РазрешенныеЕИ КАК НоменклатураРазрешенныеЕИ
	|ГДЕ
	|	НоменклатураРазрешенныеЕИ.Ссылка В(&Номенклатура)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НоменклатураРазрешенныеЕИ.Ссылка";
	
	ТаблицаНоменклатуры = Услуги.Выгрузить(, "Номенклатура");
	ТаблицаНоменклатуры.Свернуть("Номенклатура");
	Запрос.УстановитьПараметр("Номенклатура", ТаблицаНоменклатуры.ВыгрузитьКолонку("Номенклатура"));
	
	РазрешенныеЕдиницы = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.СледующийПоЗначениюПоля("Номенклатура") Цикл
		Единицы = Новый Массив;
		Пока Выборка.СледующийПоЗначениюПоля("ЕдиницаИзмерения") Цикл
			Единицы.Добавить(Выборка.ЕдиницаИзмерения);
		КонецЦикла;
		РазрешенныеЕдиницы.Вставить(Выборка.Номенклатура, Единицы);
	КонецЦикла;
	
	Для Каждого Стр Из Услуги Цикл
		
		Для Каждого Поле Из ПоляТаблицыУслуг Цикл
			
			Если Поле.Обязательное Тогда
				//Евросиб Шевченко А.В. US 83101 TA 122833 07.11.2025
				ПоискДопУсловия = Новый Структура("Имя",Поле.Имя);
				НайденноеУсловие = ДопУсловия.НайтиСтроки(ПоискДопУсловия);
				Если НайденноеУсловие.Количество() Тогда
					Результат = ВыполнитьПроверкуУсловий(Стр,НайденноеУсловие[0]);
					Если Результат Тогда
						
						Если Поле.Имя = "ТипоразмерыКТК" Или Поле.Имя = "ТипоразмерыКТКСтрокой" Тогда
							СтрокаКритерия = КритерииУслуг.Найти(Стр.ИдентификаторСтрокиУслуг, "ИдентификаторСтрокиУслуг");
							Если СтрокаКритерия <> Неопределено Тогда
								Если Не ЗначениеЗаполнено(СтрокаКритерия.ТипоразмерКТК) Тогда
									ПутьКПолюТЧ = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Услуги", Стр.НомерСтроки, Поле.Имя);
									ТекстСообщения = СтрШаблон("В строке №%1 не заполнено обязательное поле: %2", Стр.НомерСтроки, Поле.Представление);
									ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПутьКПолюТЧ, "Объект", Отказ);
								КонецЕсли;
							КонецЕсли;
							Продолжить;
						КонецЕсли;
						
						Если Поле.Имя = "ТипоразмерыВагонов" Или Поле.Имя = "ТипоразмерыВагоновСтрокой" Или Поле.Имя = "ТипоразмерВагона" Тогда
							СтрокаКритерия = КритерииУслуг.Найти(Стр.ИдентификаторСтрокиУслуг, "ИдентификаторСтрокиУслуг");
