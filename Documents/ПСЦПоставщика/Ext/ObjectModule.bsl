Процедура НайтиЗаписатьШкалыЦен() Экспорт
	
	ШкалыЦенПустаяСсылка = Справочники.ШкалыЦен.ПустаяСсылка();
	
	ТипСтрока150 = Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(150));
	
	ТаблицаНаименований = Услуги.ВыгрузитьКолонки("ИдентификаторСтрокиУслуг");	
	ТаблицаНаименований.Колонки.Добавить("НаименованиеСНДС", ТипСтрока150);
	ТаблицаНаименований.Колонки.Добавить("НаименованиеБезНДС", ТипСтрока150);
	
	СтрокиУслуг = Новый Массив;
	
	Для Каждого СтрокаУслуги Из Услуги Цикл
		
		Если СтрокаУслуги.СтавкаПрогрессивная Тогда
			
			СтрокиУслуг.Добавить(СтрокаУслуги);
			
			СтрокиШкалы = ШкалаСтавок.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", СтрокаУслуги.ИдентификаторСтрокиУслуг));
			НаименованиеСНДС = Справочники.ШкалыЦен.ПолучитьПредставлениеШкалы(СтрокиШкалы, "СтоимостьСНДС");
			НаименованиеБезНДС = Справочники.ШкалыЦен.ПолучитьПредставлениеШкалы(СтрокиШкалы, "СтоимостьБезНДС");
			
			СтрокаТаблицыНаименований = ТаблицаНаименований.Добавить();
			СтрокаТаблицыНаименований.ИдентификаторСтрокиУслуг = СтрокаУслуги.ИдентификаторСтрокиУслуг;
			СтрокаТаблицыНаименований.НаименованиеСНДС = НаименованиеСНДС;
			СтрокаТаблицыНаименований.НаименованиеБезНДС = НаименованиеБезНДС;
			
		Иначе
			
			СтрокаУслуги.ШкалаСтоимостьСНДС = ШкалыЦенПустаяСсылка;
			СтрокаУслуги.ШкалаСтоимостьБезНДС = ШкалыЦенПустаяСсылка;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(СтрокиУслуг) Тогда
		Возврат;
	Конецесли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Наименования.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	Наименования.НаименованиеСНДС КАК НаименованиеСНДС,
	|	Наименования.НаименованиеБезНДС КАК НаименованиеБезНДС
	|ПОМЕСТИТЬ Наименования
	|ИЗ
	|	&Наименования КАК Наименования
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Наименования.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	Наименования.НаименованиеСНДС КАК НаименованиеСНДС,
	|	Наименования.НаименованиеБезНДС КАК НаименованиеБезНДС,
	|	ШкалыЦенСНДС.Ссылка КАК ШкалаЦенСНДС,
	|	ШкалыЦенБезНДС.Ссылка КАК ШкалаЦенБезНДС
	|ИЗ
	|	Наименования КАК Наименования
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШкалыЦен КАК ШкалыЦенСНДС
	|		ПО Наименования.НаименованиеСНДС = ШкалыЦенСНДС.Наименование
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШкалыЦен КАК ШкалыЦенБезНДС
	|		ПО Наименования.НаименованиеБезНДС = ШкалыЦенБезНДС.Наименование";
	
	Запрос.УстановитьПараметр("Наименования", ТаблицаНаименований);
	
	ТаблицаНайденныхШкал = Запрос.Выполнить().Выгрузить();
	ТаблицаНайденныхШкал.Индексы.Добавить("ИдентификаторСтрокиУслуг");
	
	НовыеШкалы = Новый Соответствие;
	
	Для Каждого СтрокаУслуги Из СтрокиУслуг Цикл
		
		НайденныеШкалы = ТаблицаНайденныхШкал.Найти(СтрокаУслуги.ИдентификаторСтрокиУслуг, "ИдентификаторСтрокиУслуг");
		
		Если ЗначениеЗаполнено(НайденныеШкалы.ШкалаЦенСНДС) Тогда
			СтрокаУслуги.ШкалаСтоимостьСНДС = НайденныеШкалы.ШкалаЦенСНДС;
		Иначе
			СозданнаяШкала = НовыеШкалы.Получить(НайденныеШкалы.НаименованиеСНДС);
			Если СозданнаяШкала <> Неопределено Тогда
				СтрокаУслуги.ШкалаСтоимостьСНДС = СозданнаяШкала;
			Иначе
				СтрокиШкалы = ШкалаСтавок.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", СтрокаУслуги.ИдентификаторСтрокиУслуг));
				НоваяШкала = СоздатьНовуюШкалу(СтрокиШкалы, "СтоимостьСНДС");
				НовыеШкалы.Вставить(НайденныеШкалы.НаименованиеСНДС, НоваяШкала);
				СтрокаУслуги.ШкалаСтоимостьСНДС = НоваяШкала;
			КонецЕсли;	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НайденныеШкалы.ШкалаЦенБезНДС) Тогда
			СтрокаУслуги.ШкалаСтоимостьБезНДС = НайденныеШкалы.ШкалаЦенБезНДС;
		Иначе
			СозданнаяШкала = НовыеШкалы.Получить(НайденныеШкалы.НаименованиеБезНДС);
			Если СозданнаяШкала <> Неопределено Тогда
				СтрокаУслуги.ШкалаСтоимостьБезНДС = СозданнаяШкала;
			Иначе
				СтрокиШкалы = ШкалаСтавок.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", СтрокаУслуги.ИдентификаторСтрокиУслуг));
				НоваяШкала = СоздатьНовуюШкалу(СтрокиШкалы, "СтоимостьБезНДС");
				НовыеШкалы.Вставить(НайденныеШкалы.НаименованиеБезНДС, НоваяШкала);
				СтрокаУслуги.ШкалаСтоимостьБезНДС = НоваяШкала;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

