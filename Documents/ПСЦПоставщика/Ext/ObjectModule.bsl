Процедура ЗаполнитьНоменклатуруПоставщиков()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Услуги.НомерСтроки КАК НомерСтроки,
	|	Услуги.НоменклатураПоставщика КАК НоменклатураПоставщика,
	|	Услуги.Номенклатура КАК Номенклатура,
	|	Услуги.НаименованиеНоменклатурыПоставщика КАК НаименованиеНоменклатурыПоставщика
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&Услуги КАК Услуги
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.НомерСтроки КАК НомерСтроки,
	|	ВТ.НоменклатураПоставщика КАК НоменклатураПоставщика,
	|	ВТ.Номенклатура КАК Номенклатура,
	|	ВТ.НаименованиеНоменклатурыПоставщика КАК НаименованиеНоменклатурыПоставщика,
	|	НоменклатураПоставщиков.Ссылка КАК НайденнаяНоменклатураПоставщика
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НоменклатураПоставщиков КАК НоменклатураПоставщиков
	|		ПО ВТ.Номенклатура = НоменклатураПоставщиков.Номенклатура
	|			И ВТ.НаименованиеНоменклатурыПоставщика = НоменклатураПоставщиков.Наименование
	|ГДЕ
	|	ВТ.НоменклатураПоставщика <> ЕСТЬNULL(НоменклатураПоставщиков.Ссылка, НЕОПРЕДЕЛЕНО)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Запрос.УстановитьПараметр("Услуги", Услуги.Выгрузить(, "НомерСтроки, НоменклатураПоставщика, Номенклатура, НаименованиеНоменклатурыПоставщика"));
	
	НоменклатураПоставщиковПустаяСсылка = Справочники.НоменклатураПоставщиков.ПустаяСсылка();
	Запрос.УстановитьПараметр("НоменклатураПоставщиковПустаяСсылка", НоменклатураПоставщиковПустаяСсылка);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	ТаблицаНовойНоменклатурыПоставщиков = Услуги.ВыгрузитьКолонки("Номенклатура, НаименованиеНоменклатурыПоставщика, НоменклатураПоставщика");
	ТаблицаНовойНоменклатурыПоставщиков.Индексы.Добавить("Номенклатура, НаименованиеНоменклатурыПоставщика");	
	СтруктураПоискаНовойНоменклатурыПоставщиков = Новый Структура("Номенклатура, НаименованиеНоменклатурыПоставщика");
	
	Пока Выборка.Следующий() Цикл
		
		ИндексСтроки = Выборка.НомерСтроки - 1;
		СтрокаТЧ = Услуги[ИндексСтроки];
		
		Если ЗначениеЗаполнено(Выборка.НайденнаяНоменклатураПоставщика) Тогда
			
			СтрокаТЧ.НоменклатураПоставщика = Выборка.НайденнаяНоменклатураПоставщика;
			
		ИначеЕсли ЗначениеЗаполнено(Выборка.Номенклатура) И ЗначениеЗаполнено(Выборка.НаименованиеНоменклатурыПоставщика) Тогда
			
			ЗаполнитьЗначенияСвойств(СтруктураПоискаНовойНоменклатурыПоставщиков, Выборка);
			НайденныеСтроки = ТаблицаНовойНоменклатурыПоставщиков.НайтиСтроки(СтруктураПоискаНовойНоменклатурыПоставщиков);
			Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
				СтрокаТЧ.НоменклатураПоставщика = НайденныеСтроки[0].НоменклатураПоставщика;
			Иначе
				
				НовыйЭлемент = Справочники.НоменклатураПоставщиков.СоздатьЭлемент();
				НовыйЭлемент.Наименование = Выборка.НаименованиеНоменклатурыПоставщика;
				НовыйЭлемент.Номенклатура = Выборка.Номенклатура;
				НовыйЭлемент.Записать();
				
				СтрокаТЧ.НоменклатураПоставщика = НовыйЭлемент.Ссылка;
				
				НоваяСтрока = ТаблицаНовойНоменклатурыПоставщиков.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураПоискаНовойНоменклатурыПоставщиков);
				НоваяСтрока.НоменклатураПоставщика = НовыйЭлемент.Ссылка;
				
			КонецЕсли;
			
		Иначе
			
			СтрокаТЧ.НоменклатураПоставщика = НоменклатураПоставщиковПустаяСсылка;
			
		КонецЕсли;
	
	КонецЦикла;
	
	
КонецПроцедуры

Функция ВыполнитьПроверкуУсловий(Стр,Условие) //Евросиб Шевченко А.В. US 83101 TA 122833 07.11.2025
	
	СтрокиДляВыгрузки = Новый Массив;
	СтрокиДляВыгрузки.Добавить(Стр);
	
	ТаблицаПараметр = Услуги.Выгрузить(СтрокиДляВыгрузки);
	//Евросиб Шевченко А.В. US 125530 TA 131571 12.03.2026
	ТаблицаТиповКТК	= КритерииУслуг.Выгрузить(,"ТипоразмерКТК, ИдентификаторСтрокиУслуг");
	//Евросиб Шевченко А.В. US 125530 TA 131571 12.03.2026
	СхемаКомпоновкиДанных = ПолучитьОбщийМакет("ДопУсловияОбязательныхПолейВидовУслугПоставщиков");
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных();
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
	КомпоновщикНастроек.ЗагрузитьНастройки(Условие.Условие.Получить());
	Настройки = КомпоновщикНастроек.Настройки;
	
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	
	СтруктураВнешнейТаблицы = Новый Структура("Услуги",ТаблицаПараметр);
	//Евросиб Шевченко А.В. US 125530 TA 131571 12.03.2026
	СтруктураВнешнейТаблицы.Вставить("ТипоразмерыКТК",ТаблицаТиповКТК);
	//Евросиб Шевченко А.В. US 125530 TA 131571 12.03.2026
	
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки,СтруктураВнешнейТаблицы , ДанныеРасшифровки);
	
	Результат = Новый ТабличныйДокумент();
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	
	ТзРезультат = Новый ТаблицаЗначений;
	
	ПроцессорВывода.УстановитьОбъект(ТзРезультат);
	
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);	
	
	Возврат ТзРезультат.Количество() <> 0;
	
КонецФункции	

