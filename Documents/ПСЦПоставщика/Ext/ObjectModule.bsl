	|	Критерии.Критерий КАК Критерий,
	|	ЕСТЬNULL(УчетныеЕдиницы.УчетнаяЕдиница, НЕОПРЕДЕЛЕНО) КАК УчетнаяЕдиница,
	//Евросиб Шевченко А.В. US 125530 TA 128244 13.02.2026
	|	ЕстьNull(КритерииУслугПоставщиков.ДетализацияКомплекснойСтавки,ЗНАЧЕНИЕ(Справочник.ДетализацияКомплексныхУслугПоставщиков.ПустаяСсылка)) КАК ДетализацияКомплекснойСтавки
	//Евросиб Шевченко А.В. US 125530 TA 128244 13.02.2026
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Услуги КАК Услуги
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Критерии КАК Критерии
	|		ПО Услуги.ИдентификаторСтрокиУслуг = Критерии.ИдентификаторСтрокиУслуг
	|		ЛЕВОЕ СОЕДИНЕНИЕ УчетныеЕдиницы КАК УчетныеЕдиницы
	|		ПО Услуги.ИдентификаторСтрокиУслуг = УчетныеЕдиницы.ИдентификаторСтрокиУслуг
	//Евросиб Шевченко А.В. US 125530 TA 128244 13.02.2026
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КритерииУслугПоставщиков КАК КритерииУслугПоставщиков
	|		ПО КритерииУслугПоставщиков.Ссылка = Критерии.Критерий
	//Евросиб Шевченко А.В. US 125530 TA 128244 13.02.2026
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ.НомерСтроки КАК НомерСтроки,
	|	ВТ.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	ВТ1.НомерСтроки КАК НомерСтроки1
	|ИЗ
	|	ВТ КАК ВТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ КАК ВТ1
	|		ПО ВТ.Критерий = ВТ1.Критерий
	//Евросиб Шевченко А.В. US 125530 TA 128244 13.02.2026
	|			И ВТ.ДетализацияКомплекснойСтавки = ВТ1.ДетализацияКомплекснойСтавки
	//Евросиб Шевченко А.В. US 125530 TA 128244 13.02.2026
	|			И ВТ.УчетнаяЕдиница = ВТ1.УчетнаяЕдиница
	|			И ВТ.НомерСтроки < ВТ1.НомерСтроки
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки1,
	|	НомерСтроки";
	
	Запрос.УстановитьПараметр("Услуги", Услуги);
	Запрос.УстановитьПараметр("Критерии", КритерииУслуг);
