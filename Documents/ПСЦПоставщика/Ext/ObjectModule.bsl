								Если Не ЗначениеЗаполнено(СтрокаКритерия.ТипоразмерВагона) Тогда
									ПутьКПолюТЧ = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Услуги", Стр.НомерСтроки, Поле.Имя);
									ТекстСообщения = СтрШаблон("В строке №%1 не заполнено обязательное поле: %2", Стр.НомерСтроки, Поле.Представление);
									ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПутьКПолюТЧ, "Объект", Отказ);
								КонецЕсли;
							КонецЕсли;
							Продолжить;
						КонецЕсли;
						
						Если Не ЗначениеЗаполнено(Стр[Поле.Имя]) Тогда
							//Евросиб Шевченко А.В. US 125530 TA 131571 12.03.2026
							ОсобоеСобщение = Ложь;
							
							Если Поле.Имя = "Комментарий" Тогда
								СтруктураП = Новый Структура("ИдентификаторСтрокиУслуг", Стр.ИдентификаторСтрокиУслуг);
								СтрокиКритерии = КритерииУслуг.НайтиСтроки(СтруктураП);
								Если СтрокиКритерии.Количество() Тогда
									Для Каждого СтрокаК Из СтрокиКритерии Цикл
										Если СтрокаК.ТипоразмерКТК = Справочники.ТипоразмерыТЕ.Другое Тогда
											ОсобоеСобщение = Истина;
											ПутьКПолюТЧ = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Услуги", Стр.НомерСтроки, Поле.Имя);
											ТекстСообщения = "Необходимо описать тип перевозимой установки";
											ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПутьКПолюТЧ, "Объект", Отказ);
											Прервать;
										КонецЕсли;
									КонецЦикла;	
								КонецЕсли;	

							КонецЕсли;
							
							Если НЕ ОсобоеСобщение Тогда
								ПутьКПолюТЧ = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Услуги", Стр.НомерСтроки, Поле.Имя);
								ТекстСообщения = СтрШаблон("В строке №%1 не заполнено обязательное поле: %2", Стр.НомерСтроки, Поле.Представление);
								ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПутьКПолюТЧ, "Объект", Отказ);
							КонецЕсли;
							//Евросиб Шевченко А.В. US 125530 TA 131571 12.03.2026
						КонецЕсли;
						
					КонецЕсли;	
				
				
				//Если Поле.Имя = "ТипоразмерыКТК" Или Поле.Имя = "ТипоразмерыКТКСтрокой" Тогда
				//	//Евросиб Ситников К.А. Task Task 113749
