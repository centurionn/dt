
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	КонтрольДоступностиДокументов_сервер.ПроверитьДоступностьПолейДляИзменения(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	//Евросиб Трундуков СА # 119893 22.09.2025 Начало
	Если ЗначениеЗаполнено(НомерПСЦ) И  РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		НомерПСЦУникален = Документы.ПСЦПоставщика.ПроверитьУникальностьНомераПСЦ(ЭтотОбъект);
		Если Не НомерПСЦУникален Тогда
			ОбщегоНазначения.СообщитьПользователю("Уже есть проведенный ПСЦ поставщика с таким Номером ПСЦ!",, "НомерПСЦ", "ЭтотОбъект", Отказ);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	//Евросиб Трундуков СА # 119893 22.09.2025 Конец
	
	Редактор = Пользователи.ТекущийПользователь();
	Изменено = ТекущаяДата();
	
	Если Не ЗначениеЗаполнено(НомерПСЦ) Тогда
		НомерПСЦ = Документы.ПСЦПоставщика.ПолучитьОчереднойНомерПСЦ(Договор, Ссылка);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЕдиницаИзмеренияНормативаНахожденияНаПогрузкеВыгрузке) Тогда
		ЕдиницаИзмеренияНормативаНахожденияНаПогрузкеВыгрузке = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидУслугПоставщика, "ЕдиницаИзмеренияНормативаНахожденияНаПогрузкеВыгрузке");
	КонецЕсли;
	
	ЛокацияПустаяСсылка = ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
	АдресПустаяСсылка = ПредопределенноеЗначение("Справочник.АдресаВНаселенныхПунктах.ПустаяСсылка");
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		ЗаполнитьНоменклатуруПоставщиков();
		
		Для Каждого Стр Из Услуги Цикл
			
			//Если Не ЗначениеЗаполнено(Стр.НоменклатураПоставщика) И ЗначениеЗаполнено(Стр.Номенклатура) И ЗначениеЗаполнено(Стр.НаименованиеНоменклатурыПоставщика) Тогда
			//	Стр.НоменклатураПоставщика = НайтиНоменклатуруПоставщика(Стр.НаименованиеНоменклатурыПоставщика, Стр.Номенклатура);
			//	Если Не ЗначениеЗаполнено(Стр.НоменклатураПоставщика) Тогда
			//		НоменклатураПоставщика = Справочники.НоменклатураПоставщиков.СоздатьЭлемент();
			//		НоменклатураПоставщика.Наименование = Стр.НаименованиеНоменклатурыПоставщика;
			//		НоменклатураПоставщика.Номенклатура = Стр.Номенклатура;
			//		НоменклатураПоставщика.Записать();
			//		Стр.НоменклатураПоставщика = НоменклатураПоставщика.Ссылка;
			//	КонецЕсли;
			//КонецЕсли;
			
			//Приоритет локаций при выборе. Возможность выбора мультилокаций после очисти поля.
			Если Не ЗначениеЗаполнено(Стр.ПунктОтправления) Тогда
				Стр.ПунктОтправления = ЛокацияПустаяСсылка;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Стр.ПунктНазначения) Тогда
				Стр.ПунктНазначения = ЛокацияПустаяСсылка;
			КонецЕсли;
				
			Если Не ЗначениеЗаполнено(Стр.СтанцииПогранпереходов) Тогда
				Стр.СтанцииПогранпереходов = ЛокацияПустаяСсылка;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Стр.ПунктОтправленияГород) Тогда
				Стр.ПунктОтправленияГород = ЛокацияПустаяСсылка;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Стр.ПунктНазначенияГород) Тогда
				Стр.ПунктНазначенияГород = ЛокацияПустаяСсылка;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Стр.ПунктОтправленияСтрана) Тогда
				Стр.ПунктОтправленияСтрана = ЛокацияПустаяСсылка;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Стр.ПунктНазначенияСтрана) Тогда
				Стр.ПунктНазначенияСтрана = ЛокацияПустаяСсылка;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Стр.АдресСкладаПогрузкиВыгрузки) Тогда
				Стр.АдресСкладаПогрузкиВыгрузки = АдресПустаяСсылка;
			КонецЕсли;
			
		КонецЦикла;
		
		//Евросиб Шевченко А.В. US 125530 TA 128244 13.02.2026
		НайтиЗаписатьШкалыЦен();
		НайтиЗаписатьДетализациюКомплексныхСтавок();
		//Евросиб Шевченко А.В. US 125530 TA 128244 13.02.2026
		
		СтрокиСНайденнымиКритериями = Неопределено;
		НайтиЗаписатьКритерии(СтрокиСНайденнымиКритериями);
		
		ПроверитьНаличиеДублейСтрок(Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокиСНайденнымиКритериями) Тогда
			ПроверитьНаличиеПредыдущихДействующихСтавок(СтрокиСНайденнымиКритериями);
		КонецЕсли;		
		
	КонецЕсли;
		
	РеквизитыПСЦДляСравнения = "Организация, ЦФО, Контрагент, Договор, ВидУслугПоставщика, КатегорияУслуг, МестоОказанияУслуг";
	ДляДанногоОбъектаТребуетсяПеремаршрутизация = МаршрутизацияСервер.ТребуетсяПеремаршрутизацияДляОбъекта(ЭтотОбъект, РеквизитыПСЦДляСравнения);
	
	Если Маршрутизировать И ДляДанногоОбъектаТребуетсяПеремаршрутизация Тогда
		ПараметрыЗапроса = Документы.ПСЦПоставщика.ПолучитьПараметрыМаршрутизации(ЭтотОбъект);
		РезультатЗапроса = МаршрутизацияСервер.МаршрутизироватьПСЦПоставщика(ПараметрыЗапроса, Дата);
		Если РезультатЗапроса.Количество() > 0 Тогда
			УказанныеВручнуюИспНаблюдатель = Новый СписокЗначений;
			Если ДополнительныеСвойства.Свойство("ДопСвойстваОбъекта") тогда
				УказанныеВручнуюИспНаблюдатель = ДополнительныеСвойства.ДопСвойстваОбъекта;
			КонецЕсли;
			МаршрутизацияСервер.ПрименитьМаршрут(ЭтотОбъект, РезультатЗапроса, Автор, УказанныеВручнуюИспНаблюдатель);			
		КонецЕсли;
	КонецЕсли;
	
	МаршрутизацияСервер.ПараллельноеСогласование(Состояния);
	МаршрутизацияСервер.ПостобработкаТЧСостояний(ЭтотОбъект, Автор,, РежимЗаписи);
	
	Если Проведен И (СтатусДокумента = Перечисления.СтатусыСогласования.СогласованоБезЗамечаний
			Или СтатусДокумента = Перечисления.СтатусыСогласования.Подписано
			Или СтатусДокумента = Перечисления.СтатусыСогласования.СогласованСКомментариями) Тогда
		СтатусТарифа = Перечисления.СтатусыТарифовПоставщиков.СозданПоПСЦ;
	ИначеЕсли Проведен Тогда
		СтатусТарифа = Перечисления.СтатусыТарифовПоставщиков.ПроведенПоПСЦ;
	ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		СтатусТарифа = Перечисления.СтатусыТарифовПоставщиков.ОтмененПоПСЦ;
	Иначе
		СтатусТарифа = Перечисления.СтатусыТарифовПоставщиков.СозданПоПСЦ;
	КонецЕсли;
			
	УстановитьСтатусДокумента();
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда 
		
		Документы.ПСЦПоставщика.СверитьУслугиПротоколаСНормативнымиСтавками(ЭтотОбъект);
		Документы.ПСЦПоставщика.ВыполнитьАвтоматическоеСогласование(ЭтотОбъект);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СканДоверенностиНаПодписантаКонтрагента) Тогда
		Если ЭтоНовый() Тогда
			ДополнительныеСвойства.Вставить("ПрисоединитьСканДоверенностиНаПодписантаКонтрагента", Истина);
		Иначе
			ПредыдущийСканДоверенностиНаПодписантаКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "СканДоверенностиНаПодписантаКонтрагента");
			Если ЗначениеЗаполнено(ПредыдущийСканДоверенностиНаПодписантаКонтрагента) И ПредыдущийСканДоверенностиНаПодписантаКонтрагента <> СканДоверенностиНаПодписантаКонтрагента Тогда
				
				ДополнительныеСвойства.Вставить("ПрисоединитьСканДоверенностиНаПодписантаКонтрагента", Истина);
				
				Запрос = Новый Запрос;
				Запрос.Текст =
				"ВЫБРАТЬ
				|	Файлы.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.Файлы КАК Файлы
				|ГДЕ
				|	Файлы.ВладелецФайла = &ВладелецФайла
				|	И Файлы.Наименование = &Наименование
				|	И НЕ Файлы.ПометкаУдаления";
				Запрос.УстановитьПараметр("ВладелецФайла", Ссылка);
				НаименованиеПредыдущегоСкана = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПредыдущийСканДоверенностиНаПодписантаКонтрагента, "Наименование");
				Запрос.УстановитьПараметр("Наименование", НаименованиеПредыдущегоСкана);
				
				Выборка = Запрос.Выполнить().Выбрать();
				Пока Выборка.Следующий() Цикл
					ПредыдущийПрисоединенныйСкан = Выборка.Ссылка;
					ПредыдущийСканОбъект = ПредыдущийПрисоединенныйСкан.ПолучитьОбъект();
					ПредыдущийСканОбъект.УстановитьПометкуУдаления(Истина);
				КонецЦикла;				
				
			КонецЕсли;			
				
		КонецЕсли;
	КонецЕсли;
	
	// Евросиб US 89887 TA 89889 Рыбьяков К.А. 18.11.2024 ((
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		ЕстьПроведенныеРелизы = ОбщегоНазначенияВызовСервера.НаОснованииДокументаСозданыРелизы(Ссылка);
		Если ЕстьПроведенныеРелизы Тогда
			ТекстСообщения = НСтр("ru = 'К ПСЦ есть Релиз собственника, требуется отменить его проведение.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		КонецЕсли;
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 18.11.2024 ))
	
	// Евросиб US 105219 TA 105220 Рыбьяков К.А. 16.04.2025 ((
	Если Не Отказ 
		И ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Автоперевозки 
		//Евросиб Коханенко Н.А. 24.09.2025 (( #119429 
		//И РежимЗаписи = РежимЗаписиДокумента.Проведение 
		//И (СтатусДокумента = Перечисления.СтатусыСогласования.СогласованоБезЗамечаний
		//	Или СтатусДокумента = Перечисления.СтатусыСогласования.Подписано
		//	Или СтатусДокумента = Перечисления.СтатусыСогласования.СогласованСКомментариями) Тогда
		И ((НЕ Ссылка.ПометкаУдаления 
			И ПометкаУдаления)
		ИЛИ РежимЗаписи = РежимЗаписиДокумента.Проведение 
		И (СтатусДокумента = Перечисления.СтатусыСогласования.СогласованоБезЗамечаний
			ИЛИ СтатусДокумента = Перечисления.СтатусыСогласования.Подписано
			ИЛИ СтатусДокумента = Перечисления.СтатусыСогласования.СогласованСКомментариями)) Тогда
		//Евросиб Коханенко Н.А. 24.09.2025 )) #119429 
		УзлыПланаОбмена = ПланыОбмена.ВыгрузкаДанных.ПолучитьУзелОбмена(Перечисления.УзлыОбмена.ТЛ);

		СтруктураЗаписи = Новый Структура;
		СтруктураЗаписи.Вставить("УзелИнформационнойБазы", УзлыПланаОбмена[0]);
		СтруктураЗаписи.Вставить("Ссылка", Договор);
		
		КлючевыеПоляДляОбменаИзменены = Ложь;
		ДоговорСуществуетВТранспортнойЛогистике = РегистрыСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов.ЗаписьЕстьВРегистре(СтруктураЗаписи);
		Если ДоговорСуществуетВТранспортнойЛогистике Тогда
			КлючевыеПоляДляОбменаИзменены = Документы.ПСЦ.ПроверитьИзменениеКлючевыхПолейПСЦДляОбмена(ЭтотОбъект);
		КонецЕсли;
		Если КлючевыеПоляДляОбменаИзменены  Тогда
			ДополнительныеСвойства.Вставить("ЗарегистрироватьвОбмене");
		КонецЕсли;
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 16.04.2025 ))
	
	//Евросиб Шевченко А.В. US 112958 TA 112962 01.07.2025 -начало
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение И ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Автоперевозки И Типовой тогда
		ДополнительноеОпределениеПризнакаНеТиповой(Типовой);
	КонецЕсли;
	//Евросиб Шевченко А.В. US 112958 TA 112962 01.07.2025 -начало
	
	//Евросиб Каблов 15.08.2025 ( #115001 Регистрируем при записи
	//Евросиб Каблов 17.12.2025 ( Ticket#0426699
	//НеобходимаРегистрация = ПроверитьНеобходимостьРегистрации();
	НеобходимаРегистрация = Документы.ПСЦПоставщика.ПроверитьИзменениеКлючевыхПолейДляОбменаСДО(ЭтотОбъект);
	//Евросиб Каблов 17.12.2025 ) Ticket#0426699
	ДополнительныеСвойства.Вставить("ЗарегистрироватьДляПередачиВДО", НеобходимаРегистрация);
	//Евросиб Каблов 15.08.2025 ) #115001
	
	//Евросиб СубботинВ #131884 02.03.2026 Начало
	СоздатьКлючиАналитикиСтрокПротокола(РежимЗаписи);
    //Евросиб СубботинВ #131884 02.03.2026 Конец
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ПрисоединитьСканДоверенностиНаПодписантаКонтрагента = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеСвойства, "ПрисоединитьСканДоверенностиНаПодписантаКонтрагента", Ложь);
	Если ПрисоединитьСканДоверенностиНаПодписантаКонтрагента Тогда
		ФайлДоверенности = СканДоверенностиНаПодписантаКонтрагента.Скопировать();
		ФайлДоверенности.ВладелецФайла = Ссылка;
		ФайлДоверенности.Записать();
	КонецЕсли;
	
	// Евросиб US 105219 TA 105220 Рыбьяков К.А. 16.04.2025 ((
	Если Не Отказ И ДополнительныеСвойства.Свойство("ЗарегистрироватьвОбмене") Тогда 
		ПланыОбмена.ВыгрузкаДанных.ЗарегистрироватьИзмененияПоДокументу(Ссылка, Перечисления.УзлыОбмена.ТЛ);
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 16.04.2025 ))
	
	//Евросиб Каблов 15.08.2025 ( #115001
	ЗарегистрироватьДляПередачиВДО = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеСвойства, "ЗарегистрироватьДляПередачиВДО", Ложь);
	Если Не Отказ И ЗарегистрироватьДляПередачиВДО Тогда 
		ПланыОбмена.ВыгрузкаДанных.ЗарегистрироватьИзмененияПоДокументу(Ссылка, Перечисления.УзлыОбмена.ДО);
	КонецЕсли;
	//Евросиб Каблов 15.08.2025 )
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Автор = Пользователи.ТекущийПользователь();
	//Маршрутизировать = Константы.МаршрутизироватьПСЦ.Получить();
	Маршрутизировать = Истина;
	
	Если ЗначениеЗаполнено(Автор) Тогда
		РеквизитыАвтора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Автор, "ЦФО, Подразделение");
		ЦФО = РеквизитыАвтора.ЦФО;
		Подразделение = РеквизитыАвтора.Подразделение;
	КонецЕсли;
	
	Организация = Константы.ОсновнаяОрганизация.Получить();
	Создано = ТекущаяДата();
	ДатаПСЦ = Создано;
	СтатусДокумента = Перечисления.СтатусыСогласования.Планируется;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РелизСобственника") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	РелизСобственника.Контрагент КАК Контрагент,
		|	РелизСобственника.Договор КАК Договор,
		// Евросиб US 89887 TA 103668 Рыбьяков К.А. 04.03.2025 ((
		|	РелизСобственника.ПСЦ КАК ПСЦ
		// Евросиб Рыбьяков К.А. 04.03.2025 ))
		|ИЗ
		|	Документ.РелизСобственника КАК РелизСобственника
		|ГДЕ
		|	РелизСобственника.Ссылка = &РелизСобственника
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РелизСобственникаНоминации.НомерСтроки КАК НомерСтроки,
		|	РелизСобственникаНоминации.ТипКТК КАК ТипоразмерКТК,
		|	РелизСобственникаНоминации.Контейнер КАК Контейнер,
		|	РелизСобственникаНоминации.тек_СобственностьКТК КАК ВидСобственности,
		|	РелизСобственникаНоминации.НормативВозврата КАК НормаПользования,
		|	РелизСобственникаНоминации.Ссылка.Локация КАК ЛокацияВыдачи,
		|	РелизСобственникаНоминации.Ссылка.ЛокацияСдачи КАК ЛокацияСдачи,
		|	РелизСобственникаНоминации.Ставка КАК Ставка,
		|	РелизСобственникаНоминации.СтавкаНДС КАК СтавкаНДС,
		|	РелизСобственникаНоминации.НДСВключая КАК НДСВключая,
		|	РелизСобственникаНоминации.Валюта КАК Валюта
		|ИЗ
		|	Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
		|ГДЕ
		|	РелизСобственникаНоминации.Ссылка = &РелизСобственника
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РелизСобственникаНоминации.НДСВключая КАК НДСВключая
		|ИЗ
		|	Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
		|ГДЕ
		|	РелизСобственникаНоминации.Ссылка = &РелизСобственника
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РелизСобственникаНоминации.СтавкаНДС КАК СтавкаНДС
		|ИЗ
		|	Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
		|ГДЕ
		|	РелизСобственникаНоминации.Ссылка = &РелизСобственника";
		
		Запрос.УстановитьПараметр("РелизСобственника", ДанныеЗаполнения.Ссылка);
		РезультатыЗапроса = Запрос.ВыполнитьПакет();
		
		Выборка = РезультатыЗапроса[0].Выбрать();		
		Если Выборка.Следующий() Тогда
			// Евросиб US 89887 TA 103668 Рыбьяков К.А. 04.03.2025 ((
			Если ЗначениеЗаполнено(Выборка.ПСЦ) Тогда
				ТекстСообщения = НСтр("ru = 'Протокол уже заполнен.'");
				ВызватьИсключение ТекстСообщения;
			КонецЕсли;
			// Евросиб Рыбьяков К.А. 04.03.2025 ))
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка, "Контрагент, Договор");
		КонецЕсли;
		
		Выборка = РезультатыЗапроса[2].Выбрать();		
		Если Выборка.Количество() = 1 Тогда
			Выборка.Следующий();
			СуммаВключаетНДС = Выборка.НДСВключая;
		КонецЕсли;
		
		Выборка = РезультатыЗапроса[3].Выбрать();		
		Если Выборка.Количество() = 1 Тогда
			Выборка.Следующий();
			СтавкаНДС = Выборка.СтавкаНДС;
		КонецЕсли;
		
		Выборка = РезультатыЗапроса[1].Выбрать();
		
		ИдентификаторСтрокиУслуг = 0;
		Пока Выборка.Следующий() Цикл
			
			НоваяСтрока = Услуги.Добавить();
			
			НоваяСтрока.ИдентификаторСтрокиУслуг = ИдентификаторСтрокиУслуг;
			ИдентификаторСтрокиУслуг = ИдентификаторСтрокиУслуг + 1;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
			ЧислоСтавкаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСтавкуНДС(Выборка.СтавкаНДС);
			СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСуммуНДС(Выборка.Ставка, ЧислоСтавкаНДС, Истина, Выборка.НДСВключая);
			НоваяСтрока.СтоимостьСНДС = ?(Выборка.НДСВключая, Выборка.Ставка, Выборка.Ставка + СуммаНДС);
			НоваяСтрока.СтоимостьБезНДС = ?(Выборка.НДСВключая, Выборка.Ставка - СуммаНДС, Выборка.Ставка);
			
			НоваяСтрока.СпособВводаУчетныхЕдиниц = Перечисления.СпособыВводаУчетныхЕдиниц.Построчно;
			
			Если ЗначениеЗаполнено(Выборка.Контейнер) Тогда
				НоваяСтрокаУчетнойЕдиницы = УчетныеЕдиницы.Добавить();
				НоваяСтрокаУчетнойЕдиницы.ИдентификаторСтрокиУслуг = НоваяСтрока.ИдентификаторСтрокиУслуг;
				НоваяСтрокаУчетнойЕдиницы.УчетнаяЕдиница = Выборка.Контейнер;
			КонецЕсли;
			
		КонецЦикла;
		
		Основание = ДанныеЗаполнения;		
		ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Контейнеры;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Контрагент) Тогда
		//РеквизитыКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент, "ИсполнительУслуги");		
		//Если Не РеквизитыКонтрагента.ИсполнительУслуги Тогда
		//	ТекстСообщения = "Не заполнена Карта инфраструктуры поставщика. Создание документа запрещено.";
		//	ВызватьИсключение ТекстСообщения;
		//КонецЕсли;
		РеквизитыКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент, "ТипКонтрагента_Подрядчик");		
		Если Не РеквизитыКонтрагента.ТипКонтрагента_Подрядчик Тогда
			ТекстСообщения = "Контрагент не является Подрядчиком. Создание документа запрещено.";
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
		
		ДатаДляОпределенияРуководителя = ?(ЗначениеЗаполнено(ДатаПСЦ), ДатаПСЦ, ТекущаяДата());
		ДанныеРуководителя = ОтветственныеЛица_сервер.ПолучитьРуководителя(Контрагент, ДатаДляОпределенияРуководителя, РуководительКонтрагента);		
		РуководительКонтрагента = ДанныеРуководителя.Ссылка;
		ДоверенностьНаПодписанта = ДанныеРуководителя.СканДоверенности;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Договор) Тогда
		Документы.ПСЦПоставщика.ЗаполнитьРеквизитыИзДоговора(ЭтотОбъект, Договор);
	КонецЕсли;
	
	ЗаполнитьДоверенностьЗаРуководителя();
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Маршрутизировать = Истина;
	Автор = Пользователи.ТекущийПользователь();
	Создано = ТекущаяДата();
	Редактор = неопределено;
	Изменено = неопределено;
	Состояния.Очистить();
		
	СтатусДокумента = Перечисления.СтатусыСогласования.Планируется;
	ТекущееСостояние = Неопределено;
	ПодписанСДвухСторон = Ложь;
	ДатаПолученияОригинала = '00010101';
	ДатаПереводаВСтатусПодписан = '00010101';
	ДатаСогласования = '00010101';
	НачалоДействия = '00010101';
	ДатаПСЦ = ТекущаяДата();
	НомерПСЦ = "";
	
	СсылкаНаВнутреннийДокументДО = "";
	
	ЗаполнитьДоверенностьЗаРуководителя();
	
	ПроверкаНеОсуществлялась = Перечисления.РезультатыПроверки.НеОсуществлялась;
	Для Каждого Стр Из Услуги Цикл
		Стр.ПроверкаСтавок = ПроверкаНеОсуществлялась;
		//Евросиб Шевченко А.В. US 112958 TA 112963 07.07.2025
		Стр.Критерий = Справочники.КритерииУслугПоставщиков.ПустаяСсылка()
		//Евросиб Шевченко А.В. US 112958 TA 112963 07.07.2025
	КонецЦикла;
	
	// Евросиб 89887 TA 89889 Рыбьяков К.А. 21.01.2025 ((
	ПрисвоитьНовыйИдентификаторСтрокамТЧ();
	// Евросиб Рыбьяков К.А. 21.01.2025 ))
	
	//Евросиб Шевченко А.В. US 112958 TA 112963 07.07.2025
	Для Каждого СтрокаК Из КритерииУслуг Цикл
		СтрокаК.Критерий = Справочники.КритерииУслугПоставщиков.ПустаяСсылка();               
	КонецЦикла;
	//Евросиб Шевченко А.В. US 112958 TA 112963 07.07.2025
	
КонецПроцедуры

Процедура ЗаполнитьДоверенностьЗаРуководителя() Экспорт
	
	Если Не ДоверенностьУказываетсяВручную Тогда
		ДатаДоверенности = ?(ЗначениеЗаполнено(ДатаПСЦ), ДатаПСЦ, ТекущаяДата());
		ДоверенностьЗаРуководителя = Документы.ПСЦПоставщика.ПолучитьДоверенностьДиректораПоПроизводству(ДатаДоверенности);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	//Евросиб Каблов 04.03.2025 ( #100116
	ФормаПротоколаВДоговоре = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "ФормаПротокола");
	Если Не ЗначениеЗаполнено(ФормаПротоколаВДоговоре) Тогда
		ДоговорОбъект = Договор.ПолучитьОбъект();
		Если Типовой Тогда
			ДоговорОбъект.ФормаПротокола = Перечисления.ФормыДокументов.Типовая;
		Иначе
			ДоговорОбъект.ФормаПротокола = Перечисления.ФормыДокументов.Нетиповая;
		КонецЕсли;
		ДоговорОбъект.Записать();
	КонецЕсли;
	//Евросиб Каблов 04.03.2025 )
	
	СформироватьДвижения(Отказ);
	
КонецПроцедуры

Процедура ДополнительноеОпределениеПризнакаНеТиповой(Типовой) //Евросиб Шевченко А.В. US 112958 TA 112962 01.07.2025
	
	мНоменклатуры = Новый Массив;
	мНоменклатуры.Добавить(Справочники.Номенклатура.АвтоперевозкаГруженыйКонтейнер);
	мНоменклатуры.Добавить(Справочники.Номенклатура.АвтоперевозкаПорожнийКонтейнер);
	мНоменклатуры.Добавить(Справочники.Номенклатура.АвтоперевозкаХолостойПрогон);
	мНоменклатуры.Добавить(Справочники.Номенклатура.БазоваяСтавкаАвто);
	мНоменклатуры.Добавить(Справочники.Номенклатура.ЭкспедированиеАвтотранспорт);
	мНоменклатуры.Добавить(Справочники.Номенклатура.СНПавтотранспорта);
	мНоменклатуры.Добавить(Справочники.Номенклатура.ПревышениеНормыЗагрузкиКонтейнера);
	мНоменклатуры.Добавить(Справочники.Номенклатура.ДопАдрес);
	
	Для Каждого СтрУслуги Из Услуги Цикл
		
		Если мНоменклатуры.Найти(СтрУслуги.Номенклатура) = Неопределено Тогда
			Типовой = Ложь;	
		КонецЕсли;	
		
	КонецЦикла;	
	
	
	
