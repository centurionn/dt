&НаСервереБезКонтекста
Функция ПолучитьГрузПоРеквизиту(ИмяРеквизита, ЗначениеРеквизита)
	
	РеквизитыГруза = Новый Структура("Груз, ЕТСНГ, ГНГ");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Грузы.Ссылка КАК Груз,
	|	Грузы.ЕТСНГ КАК ЕТСНГ,
	|	Грузы.ГНГ КАК ГНГ
	|ИЗ
	|	Справочник.Грузы КАК Грузы
	|ГДЕ
	|	Грузы.ЕТСНГ = &ЕТСНГ
	|	И НЕ Грузы.ПометкаУдаления";
	
	Если ИмяРеквизита = "ГНГ" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Грузы.ЕТСНГ = &ЕТСНГ", "Грузы.ГНГ = &ГНГ");
	КонецЕсли;
	
	Запрос.УстановитьПараметр(ИмяРеквизита, ЗначениеРеквизита);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(РеквизитыГруза, Выборка);
	КонецЕсли;
	
	Возврат РеквизитыГруза;
	
КонецФункции

