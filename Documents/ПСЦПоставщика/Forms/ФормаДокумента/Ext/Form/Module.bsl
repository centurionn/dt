				//Евросиб Шевченко А.В. US 110216 TA 112376 07.08.2025
				УстановитьПризнакИзмененияГруза(СтрокаТЧ);
				СтрокаТЧ.ГНГ = НовоеЗначение;
				Если НЕ ЗначениеЗаполнено(НовоеЗначение) Тогда
					СтрокаТЧ.ГрузГНГ = НовоеЗначение;
				КонецЕсли;
				УстановитьЗначениеПоляСостояниеГруженыйПорожний(СтрокаТЧ);
				//Евросиб Шевченко А.В. US 110216 TA 112376 07.08.2025
			ИначеЕсли ИмяПоля = "ГрузЕТСНГ" Тогда
				//Евросиб Шевченко А.В. US 110216 TA 112376 07.08.2025
				УстановитьПризнакИзмененияГруза(СтрокаТЧ); 
				СтрокаТЧ.ГрузЕТСНГ = НовоеЗначение;
				Если НЕ ЗначениеЗаполнено(НовоеЗначение) Тогда
					СтрокаТЧ.ЕТСНГ = НовоеЗначение;
				КонецЕсли;
				УстановитьЗначениеПоляСостояниеГруженыйПорожний(СтрокаТЧ);
				//Евросиб Шевченко А.В. US 110216 TA 112376 07.08.2025
			ИначеЕсли ИмяПоля = "ГрузГНГ" Тогда
				//Евросиб Шевченко А.В. US 110216 TA 112376 07.08.2025
				УстановитьПризнакИзмененияГруза(СтрокаТЧ); 
				СтрокаТЧ.ГрузГНГ = НовоеЗначение;
				Если НЕ ЗначениеЗаполнено(НовоеЗначение) Тогда
					СтрокаТЧ.ГНГ = НовоеЗначение;
				КонецЕсли;
				//Евросиб Шевченко А.В. US 110216 TA 112376 07.08.2025
				УстановитьЗначениеПоляСостояниеГруженыйПорожний(СтрокаТЧ);
				
			//Евросиб Шевченко А.В. US 110215 TA 120129 06.10.2025
			ИначеЕсли ИмяПоля = "ГрузТНВЭД" Тогда
				//Евросиб Шевченко А.В. US 110216 TA 112376 07.08.2025
				УстановитьПризнакИзмененияГруза(СтрокаТЧ); 
				СтрокаТЧ.ГрузТНВЭД = НовоеЗначение;
				Если НЕ ЗначениеЗаполнено(НовоеЗначение) Тогда
					СтрокаТЧ.КодТНВЭД = НовоеЗначение;
				КонецЕсли;
				УстановитьЗначениеПоляСостояниеГруженыйПорожний(СтрокаТЧ);
				//Евросиб Шевченко А.В. US 110216 TA 112376 07.08.2025
			ИначеЕсли ИмяПоля = "КодТНВЭД" Тогда
				//Евросиб Шевченко А.В. US 110216 TA 112376 07.08.2025
				УстановитьПризнакИзмененияГруза(СтрокаТЧ); 
				СтрокаТЧ.КодТНВЭД = НовоеЗначение;
				Если НЕ ЗначениеЗаполнено(НовоеЗначение) Тогда
					СтрокаТЧ.ГрузТНВЭД = НовоеЗначение;
				КонецЕсли;
				//Евросиб Шевченко А.В. US 110216 TA 112376 07.08.2025
				УстановитьЗначениеПоляСостояниеГруженыйПорожний(СтрокаТЧ);
				
			ИначеЕсли ИмяПоля = "ВесГруза" Тогда
				//Евросиб Шевченко А.В. US 86665 TA 120749 19.10.2025
				Если Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Порты ИЛИ Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Фрахт ИЛИ Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.ТЭО Тогда
					СтрокаТЧ.НормаЗагрузкиКТК = НовоеЗначение;
					СтрокаТЧ.БылиИзмененияГруза = Истина;
					УстановитьЗначениеПоляСостояниеГруженыйПорожний(СтрокаТЧ);
					ОбработатьИзменениеСостоянияГруженыйПорожнийСтрокиУслуг(СтрокаТЧ);
				КонецЕсли;
				//Евросиб Шевченко А.В. US 86665 TA 120749 19.10.2025
			//Евросиб Шевченко А.В. US 110215 TA 120129 06.10.2025
				
			ИначеЕсли ИмяПоля = "ОсобыйТемпературныйРежим" Тогда
				
				Если НовоеЗначение = Ложь Тогда
					СтрокаТЧ.ОсобыйТемпературныйРежимЗначение = "";
				КонецЕсли;
				ИзменилисьЗначенияПоляОсобыйТемпературныйРежим = Истина;
				
			ИначеЕсли ИмяПоля = "ОпасныйСпецГруз" Тогда
				//Евросиб Шевченко А.В. US 110216 TA 112376 07.08.2025
				УстановитьПризнакИзмененияГруза(СтрокаТЧ); 
				СтрокаТЧ.ОпасныйСпецГруз = НовоеЗначение;
				//Евросиб Шевченко А.В. US 110216 TA 112376 07.08.2025
				ОбработатьИзменениеПризнакаОпасныйГруз(СтрокаТЧ);							
				ИзменилисьЗначенияПоляОпасныйГруз = Истина;
				
			ИначеЕсли ИмяПоля = "НормаЗагрузкиКТК" Тогда
				
				УстановитьЗначениеПоляСостояниеГруженыйПорожний(СтрокаТЧ);
				ОбработатьИзменениеСостоянияГруженыйПорожнийСтрокиУслуг(СтрокаТЧ); //Евросиб Шевченко А.В. US 110216 TA 112376 07.08.2025
				
			ИначеЕсли ИмяПоля = "Нормативы" Тогда
				
				Если НовоеЗначение = Ложь Тогда
					ОбработатьИзменениеПризнакаНормативыВСтроке(СтрокаТЧ)
				КонецЕсли;
				ИзменилисьЗначенияПоляНормативы = Истина;
				
			ИначеЕсли ИмяПоля = "ТребуетсяДетализацияКомплекснойСтавки" Тогда
				
				ОбработатьИзменениеПризнакаДетализацииКомплекснойСтавки(СтрокаТЧ);
				
			ИначеЕсли ИмяПоля = "СпособВводаУчетныхЕдиниц" Тогда
				
				ОбработатьИзменениеСпособаВводаУчетныхЕдиницВСтрокеУслуг(СтрокаТЧ);
				
			ИначеЕсли ИмяПоля = "СвободныйПериодХраненияПриОтправке"
					Или ИмяПоля = "СвободныйПериодХраненияПриПриеме"
					Или ИмяПоля = "СвободныйПериодХраненияУслугиДепо"
					Или ИмяПоля = "СвободныйПериодХранения"
					Или ИмяПоля = "СвободныйПериодХраненияВаг"
					Или ИмяПоля = "СвободныйПериодХраненияКТК" Тогда
					
				ОбработатьИзменениеПериодаХраненияВСтроке(СтрокаТЧ, Ложь);	
			//Евросиб Шевченко А.В. US 110215 TA 128335 12.03.2026	
			ИначеЕсли ИмяПоля = "Коносамент" Тогда
				Если Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Фрахт ИЛИ Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.ТЭО Тогда	
					КоносаментПриИзмененииСервер(СтрокаТЧ.ПолучитьИдентификатор());
				КонецЕсли;
			//Евросиб Шевченко А.В. US 110215 TA 128335 12.03.2026	
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
				
				ЗаполнитьЗначенияСвойств(СтрокаТЧ, ДанныеЗаполнения);
								
				Если ДанныеЗаполнения.Свойство("ПроверкаСтавок") Тогда
					ИзменилисьРезультатыПроверкиСтавок = Истина;
					КлючНормативнойСтавкиПустаяСсылка = Справочники.КлючиАналитикиСтрокПротокола.ПустаяСсылка();
					СтрокиКритериев = Объект.КритерииУслуг.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", СтрокаТЧ.ИдентификаторСтрокиУслуг));
					Для Каждого Стр Из СтрокиКритериев Цикл
						Стр.КлючНормативнойСтавки = КлючНормативнойСтавкиПустаяСсылка;
					КонецЦикла;
				КонецЕсли;
				
			КонецЕсли;
			
			ОбработанныеСтроки.Добавить(СтрокаТЧ);
			
		КонецЕсли;
		
	КонецЦикла;

	Если ИмяПоля = "Нормативы" Тогда
		//УстановитьВидимостьГруппыПоЗначениюПоля(Объект.Услуги, Элементы.УслугиГруппаНормативыПараметры, ИмяПоля);
		УстановитьВидимостьГруппПоНормативам();
	ИначеЕсли ИмяПоля = "ОпасныйСпецГруз" Тогда
		УстановитьВидимостьГруппыПоЗначениюПоля(Объект.Услуги, Элементы.УслугиГруппаОпасностьГруза, ИмяПоля);
	ИначеЕсли ИмяПоля = "ОсобыйТемпературныйРежим" Тогда
		УстановитьВидимостьГруппыПоЗначениюПоля(Объект.Услуги, Элементы.УслугиОсобыйТемпературныйРежимЗначение, ИмяПоля);
	КонецЕсли;
	
	ОбновитьДинамическиеПоляТаблицыУслуг(ОбработанныеСтроки, Ложь);
	
	ПроверитьИУстановитьПризнакТиповой();
	
	Если ИзменилисьРезультатыПроверкиСтавок Тогда
		ОбновитьГруппуПротоколовНормативныхСтавок();
	КонецЕсли;

КонецПроцедуры

