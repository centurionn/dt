	ТекстДляПоиска = СокрЛП(Текст);
	Если СтрДлина(ТекстДляПоиска) > 2 Тогда
		СтандартнаяОбработка = Ложь;
		ДанныеВыбора = ПолучитьЭлементыЕТСНГпоЧастиКода(ТекстДляПоиска);
	КонецЕсли;
	
