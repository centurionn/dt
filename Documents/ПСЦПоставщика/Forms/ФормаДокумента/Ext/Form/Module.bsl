&НаСервере
Процедура ПолучитьПортыИЖДСтанции(СтрокиУслуг = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
	|	Услуги.ПунктОтправления КАК ПунктОтправления,
	|	Услуги.ПунктНазначения КАК ПунктНазначения	
	|ПОМЕСТИТЬ Услуги
	|ИЗ
	|	&Услуги КАК Услуги
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ГоризонтальныеСвязиЛокаций.Терминал КАК Локация,
	|	ГоризонтальныеСвязиЛокаций.ЖДСтанция КАК ПортЖДСтанция
	|ИЗ
	|	РегистрСведений.ГоризонтальныеСвязиЛокаций КАК ГоризонтальныеСвязиЛокаций
	|ГДЕ
	|	ГоризонтальныеСвязиЛокаций.ЖДСтанция В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ Услуги.ПунктОтправления КАК Пункт ИЗ Услуги КАК Услуги ОБЪЕДИНИТЬ ВЫБРАТЬ Услуги.ПунктНазначения ИЗ Услуги КАК Услуги)
	|	И ГоризонтальныеСвязиЛокаций.Терминал <> ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка)
	|	И ГоризонтальныеСвязиЛокаций.ЖДСтанция <> ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ГоризонтальныеСвязиЛокаций.Терминал,
	|	ГоризонтальныеСвязиЛокаций.Порт
	|ИЗ
	|	РегистрСведений.ГоризонтальныеСвязиЛокаций КАК ГоризонтальныеСвязиЛокаций
	|ГДЕ
	|	ГоризонтальныеСвязиЛокаций.Порт В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ Услуги.ПунктОтправления КАК Пункт ИЗ Услуги КАК Услуги ОБЪЕДИНИТЬ ВЫБРАТЬ Услуги.ПунктНазначения ИЗ Услуги КАК Услуги)
	|	И ГоризонтальныеСвязиЛокаций.Порт <> ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка)
	|	И ГоризонтальныеСвязиЛокаций.Терминал <> ЗНАЧЕНИЕ(Справочник.Локации.ПустаяСсылка)";
	
	Если СтрокиУслуг <> Неопределено Тогда
		//Евросиб Шевченко А.В. US 110216 TA 112376 07.08.2025
		СтрокиУслуг = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СтрокиУслуг);
		ТаблицаУслуг = Объект.Услуги.Выгрузить(СтрокиУслуг, "ПунктОтправления, ПунктНазначения");
		Услуги = СтрокиУслуг;
	Иначе
		//Евросиб Шевченко А.В. US 110216 TA 112376 07.08.2025
		ТаблицаУслуг = Объект.Услуги.Выгрузить(, "ПунктОтправления, ПунктНазначения");
		Услуги = Объект.Услуги;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Услуги", ТаблицаУслуг);
	
	ТерминалыПортыЖДСтанции = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаУслуги Из Услуги Цикл
		
		СтрокаУслуги.ТерминалОтправления = Справочники.Локации.ПустаяСсылка();
		СтрокаУслуги.ТерминалНазначения = Справочники.Локации.ПустаяСсылка();
		//Евросиб Шевченко А.В. US 86665 TA 120749 19.10.2025
		Если Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.ТЭО Тогда
			Если ЗначениеЗаполнено(СтрокаУслуги.ПунктОтправления) Тогда
				Если ТипЗнч(СтрокаУслуги.ПунктОтправления) = Тип("СправочникСсылка.Локации") Тогда
					Если СтрокаУслуги.ПунктОтправления.Тип = Справочники.ТипыЛокаций.Порт ИЛИ СтрокаУслуги.ПунктОтправления.Тип = Справочники.ТипыЛокаций.СтанцияЖД Тогда
						Терминал = ТерминалыПортыЖДСтанции.Скопировать(Новый Структура("ПортЖДСтанция", СтрокаУслуги.ПунктОтправления), "Локация");
						Терминал = Терминал.ВыгрузитьКолонку("Локация");
						Если Терминал.Количество() Тогда
							СтрокаУслуги.ТерминалОтправления = Терминал[0];
							
						КонецЕсли;
					КонецЕсли;	
				КонецЕсли;
				
			КонецЕсли;
