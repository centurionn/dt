&НаКлиенте
Процедура ПроверитьНеобходимостьИзмененийСозданныхРелизов(Отказ, ПараметрыЗаписи)
	
	// Евросиб US 89887 TA 89889 Рыбьяков К.А. 21.11.2024 ((
	Если ЭтаФорма.Модифицированность И Не ПараметрыЗаписи.Свойство("ВопросУжеБылЗадан") Тогда
		РелизыКИзменению = ОбщегоНазначенияВызовСервера.НайтиСозданныеНаОснованииРелизы(Объект);
		Если РелизыКИзменению.Количество() > 0 Тогда
			НаименованияРелизов = СтрСоединить(РелизыКИзменению, "," + Символы.ПС);
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить(КодВозвратаДиалога.Да, "Изменить");
			Кнопки.Добавить(КодВозвратаДиалога.Нет, "Отменить изменения");
			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтотОбъект, ПараметрыЗаписи);
			ТекстВопроса = СтрШаблон(НСтр("ru = 'На основании данного протокола уже созданы релизы собственника.
									|Внесенные изменения приведут к изменениям в релизах.
									|%1'"), НаименованияРелизов);
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки);
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 21.11.2024 ))
	
