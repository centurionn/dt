Процедура ЗаполнитьРелизыСобственника(ДокументОснование, СозданиеНового = Ложь)
	
	// Евросиб US 89887 TA 89889 Рыбьяков К.А. 21.11.2024 ((
	Если ОбщегоНазначенияВызовСервера.ЕстьРелизСобственника(ДокументОснование) Тогда
		ТекстСообщения = НСтр("ru = 'На основании документа уже созданы релизы.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	Иначе
		Документы.РелизСобственника.ЗаполнитьРелизСобственникаНаОснованииПСЦПоставщика(ДокументОснование, СозданиеНового);
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 21.11.2024 ))
	
