	КоносаментПриИзмененииСервер(ТекСтрока);
	//Евросиб Шевченко А.В. US 110215 TA 128335 12.03.2026
	Если Объект.ВидУслугПоставщика = ПредопределенноеЗначение("Справочник.ВидыУслугПоставщиков.Фрахт") ИЛИ Объект.ВидУслугПоставщика = ПредопределенноеЗначение("Справочник.ВидыУслугПоставщиков.ТЭО") Тогда
		ТекДанныеУслуги = Объект.Услуги.НайтиПоИдентификатору(ТекСтрока);
		УстановитьВидимостьДоступностьЭлементовДетализацииПоУчетнымЕдиницам(ТекДанныеУслуги);
	КонецЕсли;
	//Евросиб Шевченко А.В. US 110215 TA 128335 12.03.2026
	Если ЗаполнятьВниз Тогда
		ВыполнитьЗаполнениеВниз(Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура КоносаментПриИзмененииСервер(ТекСтрока)
	
	 ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ТекСтрока);
	 
	 ТекДанные.Судно = Справочники.ТС.ПустаяСсылка();
	 ТекДанные.РейсМоре = Справочники.РейсыМоре.ПустаяСсылка();
	 
	 //Евросиб Шевченко А.В. US 110215 TA 128335 12.03.2026
	 ВыборкаКоносамент = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекДанные.Коносамент,"МорскойРейс, Судно, СтанцияОтправления, СтанцияНазначения, Коносаменты, МестоПолученияГруза, МестоПоставкиГруза");
	 
	 ТекДанные.Судно = ВыборкаКоносамент.Судно;
	 ТекДанные.РейсМоре = ВыборкаКоносамент.МорскойРейс;
	 
	 Если Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Фрахт ИЛИ Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.ТЭО Тогда
		 
		 ТекДанные.ПунктОтправления = ВыборкаКоносамент.СтанцияОтправления;
		 ТекДанные.ПунктНазначения = ВыборкаКоносамент.СтанцияНазначения;
		 
		 ТекДанные.ТерминалОтправления = ВыборкаКоносамент.МестоПолученияГруза;
		 ТекДанные.ТерминалНазначения = ВыборкаКоносамент.МестоПоставкиГруза;
		 
		 Если Не ЗначениеЗаполнено(ТекДанные.ПунктОтправления) Тогда
			 ЛокацияПустаяСсылка = Справочники.Локации.ПустаяСсылка();
			 ТекДанные.ПунктОтправленияГород = ЛокацияПустаяСсылка;
			 ТекДанные.ПунктОтправленияСтрана = ЛокацияПустаяСсылка;
		 КонецЕсли;
		 
		 Если Не ЗначениеЗаполнено(ТекДанные.ПунктНазначения) Тогда
			 ЛокацияПустаяСсылка = Справочники.Локации.ПустаяСсылка();
			 ТекДанные.ПунктНазначенияГород = ЛокацияПустаяСсылка;
			 ТекДанные.ПунктНазначенияСтрана = ЛокацияПустаяСсылка;
		 КонецЕсли;
		 
		 Если ЗначениеЗаполнено(ТекДанные.Коносамент) Тогда
			 СписокКТК = ВыборкаКоносамент.Коносаменты.Выгрузить().ВыгрузитьКолонку("НомерКТК");
		 Иначе
			 СписокКТК = Новый Массив;
		 КонецЕсли;
		 
		 ТекДанные.СпособВводаУчетныхЕдиниц = Перечисления.СпособыВводаУчетныхЕдиниц.Построчно;
		 
		 СоздатьСтрокиТаблицыПоУчетнымЕдиницам(ТекДанные.ПолучитьИдентификатор(), СписокКТК, Истина);	
		 ОбработатьИзменениеПунктаОтправленияВСтроке(ТекДанные);
		 ОбработатьИзменениеПунктаНазначенияВСтроке(ТекДанные);
		 ОбновитьДинамическиеПоляТаблицыУслугПоСтроке(ТекДанные);
		 
	 КонецЕсли; 
	 
	 //Евросиб Шевченко А.В. US 110215 TA 128335 12.03.2026
	 
КонецПроцедуры	

