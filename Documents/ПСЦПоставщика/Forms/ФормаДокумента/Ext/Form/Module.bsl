&НаСервере
Процедура ДоговорПриИзмененииСервер()
	
	Документы.ПСЦПоставщика.ЗаполнитьРеквизитыИзДоговора(Объект, Объект.Договор);
	
	ЗаполнитьСписокВыбораВалютыОплаты();
	
	СНПКонтейнеровШтраф = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "СНПКонтейнеровШтраф");
	
	ЗаполнитьСтавкиНДС(); //Евросиб Шевченко А.В. BUG 131579 TA 132300 17.03.2026
	
	ЗаполнитьСтавкуНДСВСрокахУслугСНПКонтейнеров();
	ПроверитьИУстановитьПризнакТиповой();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтавкуНДСВСрокахУслугСНПКонтейнеров()
	
	СНПКонтейнеров = Справочники.Номенклатура.СНПКонтейнеров;
	СтрокиСНПКонтейнеров = Объект.Услуги.НайтиСтроки(Новый Структура("Номенклатура", СНПКонтейнеров));
	Если ЗначениеЗаполнено(СтрокиСНПКонтейнеров) Тогда
		БезНДС = Перечисления.СтавкиНДС.БезНДС;
		Для Каждого СтрокаТЧ Из СтрокиСНПКонтейнеров Цикл
			Если СНПКонтейнеровШтраф Тогда
				СтрокаТЧ.СтавкаНДС = БезНДС;
			Иначе
				СтрокаТЧ.СтавкаНДС = Объект.СтавкаНДС;
			КонецЕсли;
			ПересчитатьСтоимостьСУчетомСтавкиНДС(СтрокаТЧ);
		КонецЦикла;		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	ДоговорПриИзмененииСервер(); 
	
	//Евросиб Коханенко Н.А. 27.03.2025 (( #102319
	УстановитьВидимостьКомандПечати();
	//Евросиб Коханенко Н.А. 27.03.2025 )) #102319 

