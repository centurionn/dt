&НаКлиенте
Процедура ОбработатьНачалоВыбораЛокации(Элемент, ИмяПоля, СтандартнаяОбработка)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	
	Если ТекДанные[ИмяПоля] = Неопределено Тогда
		
		ИдентификаторТекСтроки = ТекДанные.ПолучитьИдентификатор();
		
		СписокТипов = новый СписокЗначений;
		
		ДоступныеТипы = Элемент.ОграничениеТипа.Типы();
		Если ЗначениеЗаполнено(ДоступныеТипы) Тогда
			СписокТипов.ЗагрузитьЗначения(ДоступныеТипы);
		Иначе
			СписокТипов.Добавить(Тип("СправочникСсылка.Локации"));
			СписокТипов.Добавить(Тип("СправочникСсылка.Мультилокации"));
		КонецЕсли;
	
		Если СписокТипов.Количество() > 1 Тогда
			
			СтандартнаяОбработка = Ложь;
			
			ДопПараметры = Новый Структура("ИдентификаторТекСтроки, ИмяПоля", ИдентификаторТекСтроки, ИмяПоля);
			ОповещениеОВыборе = Новый ОписаниеОповещения("ОбработатьВыборТипаПоляЛокация", ЭтаФорма, ДопПараметры);
			
			СписокТипов.ПоказатьВыборЭлемента(ОповещениеОВыборе, "Выбор типа данных");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборТипаПоляЛокация(ВыбранныйТип, ДопПараметры) Экспорт
	
	Если ВыбранныйТип <> Неопределено Тогда		
		ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ДопПараметры.ИдентификаторТекСтроки);
		Если ВыбранныйТип.Значение = Тип("СправочникСсылка.Мультилокации") Тогда
			ТекДанные[ДопПараметры.ИмяПоля] = ПредопределенноеЗначение("Справочник.Мультилокации.ПустаяСсылка");
		Иначе
			ТекДанные[ДопПараметры.ИмяПоля] = ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
		КонецЕсли;		
	КонецЕсли;
	
