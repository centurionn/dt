&НаСервере
Процедура ДобавитьСтрокиТаблицыКритерииУслуг(СтрокаТЧ, ДанныеЗаполненияСтроки, СписочныеПоля, ИндексПоля, ПоследнийИндекс, ЗаполненныеСтроки)
	
	Если ИндексПоля > ПоследнийИндекс Тогда
		ЗаполнитьСтрокуТаблицыКритерииУслуг(ДанныеЗаполненияСтроки, ЗаполненныеСтроки);
	Иначе
		СтруктураПоля = СписочныеПоля[ИндексПоля];
		ИмяСписочногоПоля = СтруктураПоля.ИмяСписочногоПоля;
		ИмяПоляКритерия = СтруктураПоля.ИмяПоляКритерия;
		Если ЗначениеЗаполнено(СтрокаТЧ[ИмяСписочногоПоля]) Тогда			
			Для Каждого ЭлементСписка Из СтрокаТЧ[ИмяСписочногоПоля] Цикл
				ЗначениеЭлемента = ЭлементСписка.Значение;
				ДанныеЗаполненияСтроки.Вставить(ИмяПоляКритерия, ЗначениеЭлемента);
				ДобавитьСтрокиТаблицыКритерииУслуг(СтрокаТЧ, ДанныеЗаполненияСтроки, СписочныеПоля, ИндексПоля + 1, ПоследнийИндекс, ЗаполненныеСтроки);			
			КонецЦикла;
		Иначе
			ДанныеЗаполненияСтроки.Вставить(ИмяПоляКритерия, СтруктураПоля.ПустоеЗначение);
			ДобавитьСтрокиТаблицыКритерииУслуг(СтрокаТЧ, ДанныеЗаполненияСтроки, СписочныеПоля, ИндексПоля + 1, ПоследнийИндекс, ЗаполненныеСтроки);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокуТаблицыКритерииУслуг(ДанныеЗаполненияСтроки, ЗаполненныеСтроки)
	
	НайденныеСтроки = Объект.КритерииУслуг.НайтиСтроки(ДанныеЗаполненияСтроки);
	Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
		ЗаполненныеСтроки.Добавить(НайденныеСтроки[0].ПолучитьИдентификатор());
	Иначе
		НоваяСтрока = Объект.КритерииУслуг.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеЗаполненияСтроки);
		ЗаполненныеСтроки.Добавить(НоваяСтрока.ПолучитьИдентификатор());
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЗначенияРеквизитовНоменклатурыУслуг()
	
	ТаблицаНоменклатуры = Объект.Услуги.Выгрузить(, "Номенклатура");
	ТаблицаНоменклатуры.Свернуть("Номенклатура");
	МассивНоменклатуры = ТаблицаНоменклатуры.ВыгрузитьКолонку("Номенклатура");
	СтавкиНДС = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивНоменклатуры, "СтавкаНДСПоставщика, ЕдиницаИзмерения");
	
	Возврат СтавкиНДС;
		
КонецФункции

