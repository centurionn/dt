&НаКлиенте
Процедура ЗаблокироватьПоляФормы(Блокировать = Истина);
	
	Элементы.ГруппаШапка.ТолькоПросмотр = Истина;
	Элементы.ГруппаПараметрыПротокола.ТолькоПросмотр = Истина;
	Элементы.ГруппаДополнительно.ТолькоПросмотр = Истина;
	Элементы.Группа1.Доступность = Ложь; //галки "Заполнять нормативы" и "Заполнять вниз"
		
	МассивДоступныхЭлементов = Новый Массив;
	//колонки ТЧ Услуги 
	МассивДоступныхЭлементов.Добавить("УслугиНаименованиеНоменклатурыПоставщика");
	МассивДоступныхЭлементов.Добавить("УслугиЕдиницаИзмерения"); 
	МассивДоступныхЭлементов.Добавить("УслугиГруппаОпасныйГруз"); //Опасный/Спец.груз, Стандарт опасности груза, Класс опасности груза 
	МассивДоступныхЭлементов.Добавить("УслугиКомментарий");
	//Требуется детализация комплексной ставки (таблица с детализацией тоже доступна для редактирования
	МассивДоступныхЭлементов.Добавить("УслугиДетализацияКомплекснойСтавки");
	МассивДоступныхЭлементов.Добавить("ГруппаВкладкаДетализацияКомплекснойСтавки");
	//Номера КТК (таблица с детализацией тоже доступна для редактирования)
	МассивДоступныхЭлементов.Добавить("УслугиДетализацияПоНомерамКТКВагонов");
	МассивДоступныхЭлементов.Добавить("ГруппаВкладкаДетализацияПоУчетнымЕдиницам");
	//Ввод КТК

	Для Каждого Элемент Из Элементы.Услуги.ПодчиненныеЭлементы Цикл
		Если МассивДоступныхЭлементов.Найти(Элемент.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли; 
		//Элемент.Доступность = Ложь; 
		Элемент.ТолькоПросмотр = Истина; 
		
	КонецЦикла;

КонецПроцедуры //Евросиб Коханенко Н.А. 28.04.2025 )) #102319

&НаКлиенте
Процедура ДетализацияКомплекснойСтавкиПриИзменении(Элемент)
	
	ТекДанныеУслуги = Элементы.Услуги.ТекущиеДанные;
	РассчитатьСуммуПоСтрокамДетализацииКомплекснойСтавки(ТекДанныеУслуги);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьДанныеПоКонтейнерамВагонам(Команда)
	
	Элементы.УслугиПоказыватьДанныеПоКонтейнерамВагонам.Пометка = Не Элементы.УслугиПоказыватьДанныеПоКонтейнерамВагонам.Пометка;
	Элементы.УслугиГруппаДанныеПоКонтейнерамВагонам.Видимость = Элементы.УслугиПоказыватьДанныеПоКонтейнерамВагонам.Пометка;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиСостоянияГруженыйПорожнийПриИзменении(Элемент)
	
	ТекСтрока = Элементы.Услуги.ТекущаяСтрока;
	УслугиСостоянияГруженыйПорожнийПриИзмененииСервер(ТекСтрока);
	
	Если ЗаполнятьВниз Тогда
		ВыполнитьЗаполнениеВниз(Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УслугиСостоянияГруженыйПорожнийПриИзмененииСервер(ТекСтрока)
	
	ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ТекСтрока);
	ОбработатьИзменениеСостоянияГруженыйПорожнийСтрокиУслуг(ТекДанные);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменениеСостоянияГруженыйПорожнийСтрокиУслуг(ТекДанные)
	
	ТекДанные.СостоянияГруженыйПорожнийСтрокой = СтрСоединить(ТекДанные.СостоянияГруженыйПорожний.ВыгрузитьЗначения(), "; ");
	
	СостояниеГруженый = Перечисления.СостоянияКТК.Груженый;
	СостояниеПорожний = Перечисления.СостоянияКТК.Порожний;
	
	ДляГруженых = Ложь;
	ДляПорожних = Ложь;
	
	Для Каждого Стр Из ТекДанные.СостоянияГруженыйПорожний Цикл
		Если Стр.Значение = СостояниеГруженый Тогда
			ДляГруженых = Истина;
		ИначеЕсли Стр.Значение = СостояниеПорожний Тогда
			ДляПорожних = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ТекДанные.ДляГруженых = ДляГруженых;
	ТекДанные.ДляПорожних = ДляПорожних;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиСостоянияГруженыйПорожнийСтрокойНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Модифицированность = Истина;
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	ТекСтрока = Элементы.Услуги.ТекущаяСтрока;
	
	СписокСостояний = Новый СписокЗначений;
	ЭлементСписка = СписокСостояний.Добавить(ПредопределенноеЗначение("Перечисление.СостоянияКТК.Груженый"));
	Если ТекДанные.ДляГруженых Тогда
		ЭлементСписка.Пометка = Истина;
	КонецЕсли;
	
	ЭлементСписка = СписокСостояний.Добавить(ПредопределенноеЗначение("Перечисление.СостоянияКТК.Порожний"));
	Если ТекДанные.ДляПорожних Тогда
		ЭлементСписка.Пометка = Истина;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;	
	ПараметрыФормы.Вставить("ТекущийСписок", СписокСостояний);
	ПараметрыФормы.Вставить("ПоказыватьПометку", Истина);
	ПараметрыФормы.Вставить("ИзменятьСоставСтрок", Ложь);
	
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ИдентификаторСтроки", ТекСтрока);
	
	ОповещениеОЗакрытииФормыСписка = Новый ОписаниеОповещения("ПриЗакрытииФормыРедактированияСпискаСостоянийГруженыйПорожний", ЭтаФорма, ПараметрыОповещения);	
	ОткрытьФорму("ОбщаяФорма.ФормаРедактированияСпискаЗначений", ПараметрыФормы, Этаформа,,,, ОповещениеОЗакрытииФормыСписка, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыРедактированияСпискаСостоянийГруженыйПорожний(СписокСостояний, ДополнительныеПараметры) Экспорт
	
	Если СписокСостояний <> Неопределено Тогда
		
		ТекСтрока = ДополнительныеПараметры.ИдентификаторСтроки;
		ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ТекСтрока);
		ТекДанные.СостоянияГруженыйПорожний.Очистить();		
		
		Для Каждого ЭлементСписка Из СписокСостояний Цикл
			Если ЭлементСписка.Пометка Тогда
				ТекДанные.СостоянияГруженыйПорожний.Добавить(ЭлементСписка.Значение);
			КонецЕсли;
		КонецЦикла;
		
		УслугиСостоянияГруженыйПорожнийПриИзмененииСервер(ТекСтрока);
	
		Если ЗаполнятьВниз Тогда
			ВыполнитьЗаполнениеВниз();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиСостоянияГруженыйПорожнийСтрокойОчистка(Элемент, СтандартнаяОбработка)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	ТекСтрока = Элементы.Услуги.ТекущаяСтрока;
	
	ТекДанные.СостоянияГруженыйПорожний.Очистить();
	
	УслугиСостоянияГруженыйПорожнийПриИзмененииСервер(ТекСтрока);
	
	Если ЗаполнятьВниз Тогда
		ВыполнитьЗаполнениеВниз(Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПодобратьПеревалки() //Евросиб Шевченко А.В. US 110216 TA 112376 07.08.2025
	
	ТаблицаДляОпределенияПеревалкиПоПриему = Объект.Услуги.Выгрузить(,"ИдентификаторСтрокиУслуг,ПеревалкаПоПриемуАвто,ПеревалкаПоПриемуМоре,ПеревалкаПоПриемуСклад,ПеревалкаПоПриемуЖД");
	ТаблицаДляОпределенияПеревалкиПоОтправлению = Объект.Услуги.Выгрузить(,"ИдентификаторСтрокиУслуг,ПеревалкаПоОтправлениюАвто,ПеревалкаПоОтправлениюМоре,ПеревалкаПоОтправлениюСклад,ПеревалкаПоОтправлениюЖД");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВТУслуги.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
		|	ВТУслуги.ПеревалкаПоПриемуАвто КАК ПеревалкаПоПриемуАвто,
		|	ВТУслуги.ПеревалкаПоПриемуМоре КАК ПеревалкаПоПриемуМоре,
		|	ВТУслуги.ПеревалкаПоПриемуСклад КАК ПеревалкаПоПриемуСклад,
		|	ВТУслуги.ПеревалкаПоПриемуЖД КАК ПеревалкаПоПриемуЖД
		|ПОМЕСТИТЬ ВТ_Услуги
		|ИЗ
		|	&ВТУслуги КАК ВТУслуги
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВидыПеревалкиЭтапыПеревалки.Ссылка КАК Ссылка,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ВидыПеревалкиЭтапыПеревалки.НомерСтроки = 1
		|				ТОГДА ВидыПеревалкиЭтапыПеревалки.ТипЭтапа
		|			ИНАЧЕ ЗНАЧЕНИЕ(ПЕРЕЧИСЛЕНИЕ.ТипыЭтаповПеревалки.ПустаяСсылка)
		|		КОНЕЦ) КАК ПеревалкаПоПриемуАвто,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ВидыПеревалкиЭтапыПеревалки.НомерСтроки = 2
		|				ТОГДА ВидыПеревалкиЭтапыПеревалки.ТипЭтапа
		|			ИНАЧЕ ЗНАЧЕНИЕ(ПЕРЕЧИСЛЕНИЕ.ТипыЭтаповПеревалки.ПустаяСсылка)
		|		КОНЕЦ) КАК ПеревалкаПоПриемуМоре,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ВидыПеревалкиЭтапыПеревалки.НомерСтроки = 3
		|				ТОГДА ВидыПеревалкиЭтапыПеревалки.ТипЭтапа
		|			ИНАЧЕ ЗНАЧЕНИЕ(ПЕРЕЧИСЛЕНИЕ.ТипыЭтаповПеревалки.ПустаяСсылка)
		|		КОНЕЦ) КАК ПеревалкаПоПриемуСклад,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ВидыПеревалкиЭтапыПеревалки.НомерСтроки = 4
		|				ТОГДА ВидыПеревалкиЭтапыПеревалки.ТипЭтапа
		|			ИНАЧЕ ЗНАЧЕНИЕ(ПЕРЕЧИСЛЕНИЕ.ТипыЭтаповПеревалки.ПустаяСсылка)
		|		КОНЕЦ) КАК ПеревалкаПоПриемуЖД
		|ПОМЕСТИТЬ ВТ_Перевалки
		|ИЗ
		|	Справочник.ВидыПеревалки.ЭтапыПеревалки КАК ВидыПеревалкиЭтапыПеревалки
		|
		|СГРУППИРОВАТЬ ПО
		|	ВидыПеревалкиЭтапыПеревалки.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Услуги.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
		|	ВТ_Перевалки.Ссылка КАК Перевалка,
		|	ВТ_Услуги.ПеревалкаПоПриемуАвто КАК ПеревалкаПоПриемуАвто,
		|	ВТ_Услуги.ПеревалкаПоПриемуМоре КАК ПеревалкаПоПриемуМоре,
		|	ВТ_Услуги.ПеревалкаПоПриемуСклад КАК ПеревалкаПоПриемуСклад,
		|	ВТ_Услуги.ПеревалкаПоПриемуЖД КАК ПеревалкаПоПриемуЖД
		|ИЗ
		|	ВТ_Услуги КАК ВТ_Услуги
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Перевалки КАК ВТ_Перевалки
		|		ПО ВТ_Услуги.ПеревалкаПоПриемуАвто = ВТ_Перевалки.ПеревалкаПоПриемуАвто
		|			И ВТ_Услуги.ПеревалкаПоПриемуМоре = ВТ_Перевалки.ПеревалкаПоПриемуМоре
		|			И ВТ_Услуги.ПеревалкаПоПриемуСклад = ВТ_Перевалки.ПеревалкаПоПриемуСклад
		|			И ВТ_Услуги.ПеревалкаПоПриемуЖД = ВТ_Перевалки.ПеревалкаПоПриемуЖД";
	Запрос.УстановитьПараметр("ВТУслуги",ТаблицаДляОпределенияПеревалкиПоПриему);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Перевалка) Тогда
			сПоиска = Новый Структура("ИдентификаторСтрокиУслуг",ВыборкаДетальныеЗаписи.ИдентификаторСтрокиУслуг);
			НайденныеСтроки = Объект.Услуги.НайтиСтроки(сПоиска);
			Для Каждого нСтрока Из НайденныеСтроки Цикл
				нСтрока.ПеревалкаПоПриему = ВыборкаДетальныеЗаписи.Перевалка;
			КонецЦикла;
		Иначе
			Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПеревалкаПоПриемуАвто) ИЛИ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПеревалкаПоПриемуМоре) ИЛИ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПеревалкаПоПриемуСклад) ИЛИ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПеревалкаПоПриемуЖД) Тогда
				эПеревалка = Справочники.ВидыПеревалки.СоздатьЭлемент();
				НовСтрока = эПеревалка.ЭтапыПеревалки.Добавить();
				НовСтрока.ТипЭтапа = ВыборкаДетальныеЗаписи.ПеревалкаПоПриемуАвто;
				НовСтрока = эПеревалка.ЭтапыПеревалки.Добавить();
				НовСтрока.ТипЭтапа = ВыборкаДетальныеЗаписи.ПеревалкаПоПриемуМоре;
				НовСтрока = эПеревалка.ЭтапыПеревалки.Добавить();
				НовСтрока.ТипЭтапа = ВыборкаДетальныеЗаписи.ПеревалкаПоПриемуСклад;
				НовСтрока = эПеревалка.ЭтапыПеревалки.Добавить();
				НовСтрока.ТипЭтапа = ВыборкаДетальныеЗаписи.ПеревалкаПоПриемуЖД;
				эПеревалка.Наименование = Строка(ВыборкаДетальныеЗаписи.ПеревалкаПоПриемуАвто) + ";" + Строка(ВыборкаДетальныеЗаписи.ПеревалкаПоПриемуМоре) + ";" + Строка(ВыборкаДетальныеЗаписи.ПеревалкаПоПриемуСклад) + "; " + Строка(ВыборкаДетальныеЗаписи.ПеревалкаПоПриемуЖД); 
				эПеревалка.Записать();
				сПоиска = Новый Структура("ИдентификаторСтрокиУслуг",ВыборкаДетальныеЗаписи.ИдентификаторСтрокиУслуг);
				НайденныеСтроки = Объект.Услуги.НайтиСтроки(сПоиска);
				Для Каждого нСтрока Из НайденныеСтроки Цикл
					нСтрока.ПеревалкаПоПриему = эПеревалка.Ссылка;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВТУслуги.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
		|	ВТУслуги.ПеревалкаПоОтправлениюАвто КАК ПеревалкаПоОтправлениюАвто,
		|	ВТУслуги.ПеревалкаПоОтправлениюМоре КАК ПеревалкаПоОтправлениюМоре,
		|	ВТУслуги.ПеревалкаПоОтправлениюСклад КАК ПеревалкаПоОтправлениюСклад,
		|	ВТУслуги.ПеревалкаПоОтправлениюЖД КАК ПеревалкаПоОтправлениюЖД
		|ПОМЕСТИТЬ ВТ_Услуги
		|ИЗ
		|	&ВТУслуги КАК ВТУслуги
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВидыПеревалкиЭтапыПеревалки.Ссылка КАК Ссылка,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ВидыПеревалкиЭтапыПеревалки.НомерСтроки = 1
		|				ТОГДА ВидыПеревалкиЭтапыПеревалки.ТипЭтапа
		|			ИНАЧЕ ЗНАЧЕНИЕ(ПЕРЕЧИСЛЕНИЕ.ТипыЭтаповПеревалки.ПустаяСсылка)
		|		КОНЕЦ) КАК ПеревалкаПоОтправлениюАвто,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ВидыПеревалкиЭтапыПеревалки.НомерСтроки = 2
		|				ТОГДА ВидыПеревалкиЭтапыПеревалки.ТипЭтапа
		|			ИНАЧЕ ЗНАЧЕНИЕ(ПЕРЕЧИСЛЕНИЕ.ТипыЭтаповПеревалки.ПустаяСсылка)
		|		КОНЕЦ) КАК ПеревалкаПоОтправлениюМоре,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ВидыПеревалкиЭтапыПеревалки.НомерСтроки = 3
		|				ТОГДА ВидыПеревалкиЭтапыПеревалки.ТипЭтапа
		|			ИНАЧЕ ЗНАЧЕНИЕ(ПЕРЕЧИСЛЕНИЕ.ТипыЭтаповПеревалки.ПустаяСсылка)
		|		КОНЕЦ) КАК ПеревалкаПоОтправлениюСклад,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ВидыПеревалкиЭтапыПеревалки.НомерСтроки = 4
		|				ТОГДА ВидыПеревалкиЭтапыПеревалки.ТипЭтапа
		|			ИНАЧЕ ЗНАЧЕНИЕ(ПЕРЕЧИСЛЕНИЕ.ТипыЭтаповПеревалки.ПустаяСсылка)
		|		КОНЕЦ) КАК ПеревалкаПоОтправлениюЖД
		|ПОМЕСТИТЬ ВТ_Перевалки
		|ИЗ
		|	Справочник.ВидыПеревалки.ЭтапыПеревалки КАК ВидыПеревалкиЭтапыПеревалки
		|
		|СГРУППИРОВАТЬ ПО
		|	ВидыПеревалкиЭтапыПеревалки.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Услуги.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
		|	ВТ_Перевалки.Ссылка КАК Перевалка,
		|	ВТ_Услуги.ПеревалкаПоОтправлениюАвто КАК ПеревалкаПоОтправлениюАвто,
		|	ВТ_Услуги.ПеревалкаПоОтправлениюМоре КАК ПеревалкаПоОтправлениюМоре,
		|	ВТ_Услуги.ПеревалкаПоОтправлениюСклад КАК ПеревалкаПоОтправлениюСклад,
		|	ВТ_Услуги.ПеревалкаПоОтправлениюЖД КАК ПеревалкаПоОтправлениюЖД
		|ИЗ
		|	ВТ_Услуги КАК ВТ_Услуги
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Перевалки КАК ВТ_Перевалки
		|		ПО ВТ_Услуги.ПеревалкаПоОтправлениюАвто = ВТ_Перевалки.ПеревалкаПоОтправлениюАвто
		|			И ВТ_Услуги.ПеревалкаПоОтправлениюМоре = ВТ_Перевалки.ПеревалкаПоОтправлениюМоре
		|			И ВТ_Услуги.ПеревалкаПоОтправлениюСклад = ВТ_Перевалки.ПеревалкаПоОтправлениюСклад
		|			И ВТ_Услуги.ПеревалкаПоОтправлениюЖД = ВТ_Перевалки.ПеревалкаПоОтправлениюЖД";
	Запрос.УстановитьПараметр("ВТУслуги",ТаблицаДляОпределенияПеревалкиПоОтправлению);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Перевалка) Тогда
			сПоиска = Новый Структура("ИдентификаторСтрокиУслуг",ВыборкаДетальныеЗаписи.ИдентификаторСтрокиУслуг);
			НайденныеСтроки = Объект.Услуги.НайтиСтроки(сПоиска);
			Для Каждого нСтрока Из НайденныеСтроки Цикл
				нСтрока.ПеревалкаПоОтправлению = ВыборкаДетальныеЗаписи.Перевалка;
			КонецЦикла;
		Иначе
			Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПеревалкаПоОтправлениюАвто) ИЛИ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПеревалкаПоОтправлениюМоре) ИЛИ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПеревалкаПоОтправлениюСклад) ИЛИ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПеревалкаПоОтправлениюЖД) Тогда
				эПеревалка = Справочники.ВидыПеревалки.СоздатьЭлемент();
				НовСтрока = эПеревалка.ЭтапыПеревалки.Добавить();
				НовСтрока.ТипЭтапа = ВыборкаДетальныеЗаписи.ПеревалкаПоОтправлениюАвто;
				НовСтрока = эПеревалка.ЭтапыПеревалки.Добавить();
				НовСтрока.ТипЭтапа = ВыборкаДетальныеЗаписи.ПеревалкаПоОтправлениюМоре;
				НовСтрока = эПеревалка.ЭтапыПеревалки.Добавить();
				НовСтрока.ТипЭтапа = ВыборкаДетальныеЗаписи.ПеревалкаПоОтправлениюСклад;
				НовСтрока = эПеревалка.ЭтапыПеревалки.Добавить();
				НовСтрока.ТипЭтапа = ВыборкаДетальныеЗаписи.ПеревалкаПоОтправлениюЖД;
				эПеревалка.Наименование = Строка(ВыборкаДетальныеЗаписи.ПеревалкаПоОтправлениюАвто) + ";" + Строка(ВыборкаДетальныеЗаписи.ПеревалкаПоОтправлениюМоре) + ";" + Строка(ВыборкаДетальныеЗаписи.ПеревалкаПоОтправлениюСклад) + "; " + Строка(ВыборкаДетальныеЗаписи.ПеревалкаПоОтправлениюЖД); 
				эПеревалка.Записать();
				сПоиска = Новый Структура("ИдентификаторСтрокиУслуг",ВыборкаДетальныеЗаписи.ИдентификаторСтрокиУслуг);
				НайденныеСтроки = Объект.Услуги.НайтиСтроки(сПоиска);
				Для Каждого нСтрока Из НайденныеСтроки Цикл
					нСтрока.ПеревалкаПоОтправлению = эПеревалка.Ссылка;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры	

