&НаКлиенте
Процедура ПодписантКонтрагентаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДанныеВыбора = ПолучитьСписокПодписантовКонтрагента(Объект.Контрагент, Объект.ДатаПСЦ);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокПодписантовКонтрагента(Контрагент, Период)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеПодписантовКонтрагентов.Период КАК Период,
		|	ДанныеПодписантовКонтрагентов.Контрагент КАК Контрагент,
		|	ДанныеПодписантовКонтрагентов.ОкончаниеДействия КАК ОкончаниеДействия,
		|	ДанныеПодписантовКонтрагентов.Должность КАК Должность,
		|	ДанныеПодписантовКонтрагентов.ДолжностьАнгл КАК ДолжностьАнгл,
		|	ДанныеПодписантовКонтрагентов.ДолжностьВРодительномПадеже КАК ДолжностьВРодительномПадеже,
		|	ДанныеПодписантовКонтрагентов.Подписант КАК Подписант,
		|	ДанныеПодписантовКонтрагентов.Фамилия КАК Фамилия,
		|	ДанныеПодписантовКонтрагентов.Имя КАК Имя,
		|	ДанныеПодписантовКонтрагентов.Отчество КАК Отчество,
		|	ДанныеПодписантовКонтрагентов.ФИОВРодительномПадеже КАК ФИОВРодительномПадеже,
		|	ДанныеПодписантовКонтрагентов.Доверенность КАК Доверенность,
		|	ДанныеПодписантовКонтрагентов.ГлавныйБухгалтер КАК ГлавныйБухгалтер,
		|	ДанныеПодписантовКонтрагентов.СканДоверенности КАК СканДоверенности,
		|	ДанныеПодписантовКонтрагентов.Подписант.Наименование КАК ПодписантНаименование
		|ИЗ
		|	РегистрСведений.ДанныеПодписантовКонтрагентов КАК ДанныеПодписантовКонтрагентов
		|ГДЕ
		|	ДанныеПодписантовКонтрагентов.Контрагент = &Контрагент
		|	И ДанныеПодписантовКонтрагентов.Период <= &Период
		|	И ВЫБОР
		|			КОГДА ДанныеПодписантовКонтрагентов.ОкончаниеДействия = &ПустаяДата
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ДанныеПодписантовКонтрагентов.ОкончаниеДействия > &Период
		|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	Если ЗначениеЗаполнено(Период) Тогда
		ПериодДействияДоверенности = Период;
	Иначе
		ПериодДействияДоверенности = ТекущаяДата();
	КонецЕсли;
	Запрос.УстановитьПараметр("Период", ПериодДействияДоверенности);
	
	ПустаяДата = '00010101';
	Запрос.УстановитьПараметр("ПустаяДата", ПустаяДата);
	
	СписокПодписантов = Новый СписокЗначений;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДанныеПодписанта = Новый Структура("Период,Контрагент,ОкончаниеДействия,Подписант,Доверенность,СканДоверенности");
		ЗаполнитьЗначенияСвойств(ДанныеПодписанта, Выборка);
		Представление = СтрШаблон("%1; %2", Выборка.ПодписантНаименование, Выборка.Доверенность);
		СписокПодписантов.Добавить(ДанныеПодписанта, Представление);
	КонецЦикла;
	
	Возврат СписокПодписантов;
	
КонецФункции

&НаКлиенте
Процедура ПодписантКонтрагентаОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ВыбранноеЗначение <> Неопределено Тогда
		ЗаполнитьДанныеПодписантаКонтрагента(ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДанныеПодписантаКонтрагента(ДанныеПодписанта)
	
	Объект.ПодписантКонтрагента = ДанныеПодписанта.Подписант;
	Объект.ДоверенностьНаПодписантаКонтрагента = ДанныеПодписанта.Доверенность;
	Объект.НачалоДействияДоверенностиНаПодписанта = ДанныеПодписанта.Период;
	Объект.ОкончаниеДействияДоверенностиНаПодписанта = ДанныеПодписанта.ОкончаниеДействия;
	Объект.СканДоверенностиНаПодписантаКонтрагента = ДанныеПодписанта.СканДоверенности;
	
	ЗаполнитьПолеСрокДействияДоверенностиНаПодписантаКонтрагента();
	
КонецПроцедуры

&Наклиенте
Процедура ЗаполнитьПолеСрокДействияДоверенностиНаПодписантаКонтрагента()
	
	Если ЗначениеЗаполнено(Объект.НачалоДействияДоверенностиНаПодписанта) Тогда
		СтрокаНачалоДействия = СтрШаблон("от %1 ", Формат(Объект.НачалоДействияДоверенностиНаПодписанта, "ДФ=dd.MM.yyyy"));
	Иначе
		СтрокаНачалоДействия = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ОкончаниеДействияДоверенностиНаПодписанта) Тогда
		СтрокаОкончаниеДействия = СтрШаблон("до %1", Формат(Объект.ОкончаниеДействияДоверенностиНаПодписанта, "ДФ=dd.MM.yyyy"));
	Иначе
		СтрокаОкончаниеДействия = "";
	КонецЕсли;
	
	СрокДействияДоверенностиНаПодписантаКонтрагента = СтрокаНачалоДействия + СтрокаОкончаниеДействия;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписантКонтрагентаОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура("Отбор", Новый Структура("Контрагент", Объект.Контрагент));
	//ПараметрыФормы.Вставить("Ключ", ПолучитьКлючЗаписиПодписантаКонтрагента(Новый Структура("Контрагент, Период", Объект.Контрагент, Объект.НачалоДействияДоверенностиНаПодписанта)));
	ОткрытьФорму("РегистрСведений.ДанныеПодписантовКонтрагентов.ФормаСписка", ПараметрыФормы, ЭтаФорма, ЭтаФорма.УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.Независимый);
	
	//ПараметрыФормы = Новый Структура("Ключ", ПолучитьКлючЗаписиПодписантаКонтрагента(Новый Структура("Контрагент, Период", Объект.Контрагент, Объект.НачалоДействияДоверенностиНаПодписанта)));
	//ОткрытьФорму("РегистрСведений.ДанныеПодписантовКонтрагентов.ФормаЗаписи", ПараметрыФормы, ЭтаФорма, ЭтаФорма.УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
