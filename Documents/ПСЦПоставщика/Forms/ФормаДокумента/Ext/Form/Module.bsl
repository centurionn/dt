&НаСервере
Процедура ПересчитатьСтоимостьСУчетомСтавкиНДС(СтрокаУслуг)
	
	Если СтрокаУслуг.СтавкаПрогрессивная Тогда
		ПересчитатьСтоимостьПоШкалеСУчетомСтавкиНДС(СтрокаУслуг, "СтоимостьБезНДС");	
	Иначе
		ЗначениеСтавкиНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСтавкуНДС(СтрокаУслуг.СтавкаНДС);		
		Если ЗначениеЗаполнено(СтрокаУслуг.СтоимостьБезНДС) Тогда
			СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСуммуНДС(СтрокаУслуг.СтоимостьБезНДС, ЗначениеСтавкиНДС, Истина, Ложь);
			СтрокаУслуг.СтоимостьСНДС = СтрокаУслуг.СтоимостьБезНДС + СуммаНДС;
		ИначеЕсли ЗначениеЗаполнено(СтрокаУслуг.СтоимостьСНДС) Тогда
			СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСуммуНДС(СтрокаУслуг.СтоимостьСНДС, ЗначениеСтавкиНДС, Истина, Истина);
			СтрокаУслуг.СтоимостьБезНДС = СтрокаУслуг.СтоимостьСНДС - СуммаНДС;
		КонецЕсли;
		//Евросиб Шевченко А.В. US 125530 TA 125727 15.12.2025
		Если ЗначениеЗаполнено(СтрокаУслуг.СтавкаЗаПСВСутБезНДС) Тогда
			СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСуммуНДС(СтрокаУслуг.СтавкаЗаПСВСутБезНДС, ЗначениеСтавкиНДС, Истина, Ложь);
			СтрокаУслуг.СтавкаЗаПСВСутСНДС = СтрокаУслуг.СтавкаЗаПСВСутБезНДС + СуммаНДС;
		ИначеЕсли ЗначениеЗаполнено(СтрокаУслуг.СтавкаЗаПСВСутСНДС) Тогда
			СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСуммуНДС(СтрокаУслуг.СтавкаЗаПСВСутСНДС, ЗначениеСтавкиНДС, Истина, Истина);
			СтрокаУслуг.СтавкаЗаПСВСутБезНДС = СтрокаУслуг.СтавкаЗаПСВСутСНДС - СуммаНДС;
		КонецЕсли;
		//Евросиб Шевченко А.В. US 125530 TA 125727 15.12.2025
	КонецЕсли;
	
КонецПроцедуры

