&НаКлиенте
Процедура УслугиСтанцииПогранпереходовНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	
	Если ТекДанные.СтанцииПогранПереходов = Неопределено Тогда
		
		ИдентификаторТекСтроки = ТекДанные.ПолучитьИдентификатор();
		
		СписокТипов = новый СписокЗначений;
		
		ДоступныеТипы = Элементы.УслугиСтанцииПогранПереходов.ОграничениеТипа.Типы();
		Если ЗначениеЗаполнено(ДоступныеТипы) Тогда
			СписокТипов.ЗагрузитьЗначения(ДоступныеТипы);
		Иначе
			СписокТипов.Добавить(Тип("СправочникСсылка.Локации"));
			СписокТипов.Добавить(Тип("СправочникСсылка.Мультилокации"));
		КонецЕсли;
	
		Если СписокТипов.Количество() > 1 Тогда
			
			СтандартнаяОбработка = Ложь;
			
			ДопПараметры = Новый Структура("ИдентификаторТекСтроки, ИмяПоля", ИдентификаторТекСтроки, "СтанцииПогранПереходов");
			ОповещениеОВыборе = Новый ОписаниеОповещения("ОбработкаВыбораТипаПоляЛокации", ЭтаФорма, ДопПараметры);
			
			СписокТипов.ПоказатьВыборЭлемента(ОповещениеОВыборе, "Выбор типа данных");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

