Перем ИдентификаторКопируемойСтрокиУслуг;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	СНПКонтейнеровШтраф = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "СНПКонтейнеровШтраф");
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		//Евросиб Каблов 19.02.2025 ( #101080
		ЗаполнитьСтавкуНДСВСрокахУслугСНПКонтейнеров();
		//Евросиб Каблов 19.02.2025 )
	КонецЕсли;
	
	//Евросиб Коханенко Н.А. 29.04.2025 (( #102319 
	//ОбновитьБлокировкуЭлементов();
	//Евросиб Коханенко Н.А. 29.04.2025 )) #102319 
	
	Если НЕ Пользователи.РолиДоступны("ПолныеПрава",, Ложь) Тогда
		РазрешитьРедактированиеСостояния = Пользователи.РолиДоступны("dc_РазрешитьРедактированиеСостоянияПСЦПоставщика",, Ложь);
		РегистрыСведений.СостоянияДокументов.УстановитьДоступностьТаблицыСостояния(Элементы.ГруппаСостояния, "Состояния", "СостоянияИсполнитель", РазрешитьРедактированиеСостояния);
	КонецЕсли;
	
	ОбновитьПанельТекущегоПользователя();
	ОбновитьПанельСостояний();
	
	//Евросиб Коханенко Н.А. 29.04.2025 (( #102319 
	ОбновитьБлокировкуЭлементов();
	//Евросиб Коханенко Н.А. 29.04.2025 )) #102319 
	
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	
	Элементы.ГруппаВкладкаДетализацияКомплекснойСтавки.Видимость = Ложь;
	Элементы.ГруппаВкладкаДетализацияПоУчетнымЕдиницам.Видимость = Ложь;
	Элементы.СписокУчетныхЕдиницУчетнаяЕдиницаСсылка.Заголовок = "Учетная единица";
	
	Если ПараметрыВидаУслуг = Неопределено Тогда
		НастроитьКолонкиТаблицыУслугПоВидуУслугПоставщика();
		ОбновитьДинамическиеПоляТаблицыУслуг(, Истина);
		ОбновитьГруппуПротоколовНормативныхСтавок();
		УстановитьВидимостьГруппПоНормативам();
		УстановитьВидимостьГруппыПоЗначениюПоля(Объект.Услуги, Элементы.УслугиГруппаОпасностьГруза, "ОпасныйСпецГруз");
		УстановитьВидимостьГруппыПоЗначениюПоля(Объект.Услуги, Элементы.УслугиОсобыйТемпературныйРежимЗначение, "ОсобыйТемпературныйРежим");
		ЗаполнитьСписокВыбораВалютыОплаты();
		УстановитьДоступностьПризнакаТиповой();
	КонецЕсли;
	
	ЗаполнятьНормативы = ПараметрыВидаУслуг.ЗаполнятьНормативы;
	
	УстановитьЗаголовокГруппыСторонаОрганизации();
	
	Элементы.ОкончаниеДействия.АвтоОтметкаНезаполненного = Не Объект.ДействуетДоСогласованияНовыхУсловий;
	
	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Элементы.РуководительКонтрагента.СписокВыбора.ЗагрузитьЗначения(ПолучитьВсехРуководителейКонтрагента(Объект.Контрагент));
	КонецЕсли;
	
	Если Объект.КатегорияУслуг = ПредопределенноеЗначение("Справочник.КатегорииУслуг.ПерваяПоследняяМиля") Тогда
		Элементы.МестоОказанияУслуг.Видимость = Истина;
	Иначе
		Элементы.МестоОказанияУслуг.Видимость = Ложь;
	КонецЕсли;
	
	//ДоговорТиповой = ПолучитьЗначениеРеквизитТиповойДоговор(Объект.Договор);
	//Элементы.Типовой.Доступность = ДоговорТиповой;
	Элементы.МакетПечатнойФормыПротокола.Видимость = Объект.Типовой;	
	УстановитьВидимостьДобавленияРуководителя();
	Элементы.ДоверенностьЗаРуководителя.ТолькоПросмотр = Не Объект.ДоверенностьУказываетсяВручную;
	
	Если Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Контейнеры Тогда
		Элементы.ВидПеревозки.Видимость = Истина;
		//Евросиб Коханенко Н.А. 09.06.2025 (( #109338 
		Элементы.ФорматПротокола.Доступность = Ложь;
		Объект.ФорматПротокола = Неопределено; 
		//Евросиб Коханенко Н.А. 09.06.2025 )) #109338 
	Иначе
		Элементы.ВидПеревозки.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.СтавкаНДС.ТолькоПросмотр = ЗначениеЗаполнено(Объект.ВидПеревозки);
	
	//Евросиб Коханенко Н.А. 27.03.2025 (( #102319
	УстановитьВидимостьКомандПечати();
	//Евросиб Коханенко Н.А. 27.03.2025 )) #102319 
	
	УстановитьВидимостьКлиентЕвросиба(); //Евросиб Шевченко А.В. US 112958 TA 112963 01.07.2025
	
	ЭтоПолноправныйПользователь = РольДоступна("ПолныеПрава");
	
	//Евросиб Шевченко А.В. BUG 131579 TA 132300 17.03.2026
	Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		Если Объект.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20") Тогда
			Объект.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22");
			СоответствиеРеквизитовНоменклатуры = ПолучитьЗначенияРеквизитовНоменклатурыУслуг();
			Для Каждого СтрокаТЧ Из Объект.Услуги Цикл
				РеквизитыНоменклатуры = СоответствиеРеквизитовНоменклатуры.Получить(СтрокаТЧ.Номенклатура);
				Если ЗначениеЗаполнено(РеквизитыНоменклатуры) Тогда
					СтавкаНДСПоставщика = РеквизитыНоменклатуры.СтавкаНДСПоставщика;
				Иначе
					СтавкаНДСПоставщика = Неопределено;
				КонецЕсли;
				Если СтрокаТЧ.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20") Тогда
					СтрокаТЧ.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.ПустаяСсылка");   
				КонецЕсли;
				ЗаполнитьСтавкуНДСВСтрокеУслуг(СтрокаТЧ, СтавкаНДСПоставщика);
				ПересчитатьСтоимостьСУчетомСтавкиНДС(СтрокаТЧ);
			КонецЦикла;	
		КонецЕсли;	
		ЗаполнитьСтавкиНДС();
	КонецЕсли;	
	//Евросиб Шевченко А.В. BUG 131579 TA 132300 17.03.2026
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьДобавленияРуководителя()
	
	КонтрагентРезидент = Ложь;
	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		СтранаРегистрации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Контрагент, "СтранаРегистрации");
		Если СтранаРегистрации = Справочники.СтраныМира.Россия Тогда
			КонтрагентРезидент = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Элементы.ДобавитьРуководителяКонтрагента.Видимость = Не КонтрагентРезидент;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗначениеРеквизитТиповойДоговор(Договор)
	
	Если ЗначениеЗаполнено(Договор) Тогда
		ДоговорТиповой = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "Типовой");
	Иначе
		ДоговорТиповой = Ложь;
	КонецЕсли;
	
	Возврат ДоговорТиповой;
	
КонецФункции

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, ТекущийОбъект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	СНПКонтейнеровШтраф = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "СНПКонтейнеровШтраф");
	
	НастроитьКолонкиТаблицыУслугПоВидуУслугПоставщика();
	ОбновитьДинамическиеПоляТаблицыУслуг(, Истина);
	ОбновитьГруппуПротоколовНормативныхСтавок();
	УстановитьВидимостьГруппПоНормативам();
	УстановитьВидимостьГруппыПоЗначениюПоля(Объект.Услуги, Элементы.УслугиГруппаОпасностьГруза, "ОпасныйСпецГруз");
	УстановитьВидимостьГруппыПоЗначениюПоля(Объект.Услуги, Элементы.УслугиОсобыйТемпературныйРежимЗначение, "ОсобыйТемпературныйРежим");
	ЗаполнитьСписокВыбораВалютыОплаты();	
	УстановитьДоступностьПризнакаТиповой();
	
	Элементы.СсылкаНаПротоколВДО.Видимость = ЗначениеЗаполнено(Объект.СсылкаНаВнутреннийДокументДО);  
	Если ПроверкаГруппыДоступа("Менеджер сопровождения") и ЗначениеЗаполнено(Объект.СсылкаНаВнутреннийДокументДО) Тогда
		Элементы.ПередатьПСЦВДО.Видимость = Истина;	
	КонецЕсли;
	
	Если Объект.КатегорияУслуг = ПредопределенноеЗначение("Справочник.КатегорииУслуг.ПерваяПоследняяМиля") Тогда
		Элементы.МестоОказанияУслуг.Видимость = Истина;
	Иначе
		Элементы.МестоОказанияУслуг.Видимость = Ложь;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды	
	
	Элементы.ДатаПереводаВСтатусПодписан.Доступность = Объект.ПодписанСДвухСторон;
	
	ЗаполнитьПолеСрокДействияДоверенностиНаПодписантаКонтрагента();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ТребуетсяПеречитатьУказанныйДокумент" И Параметр = Объект.Ссылка Тогда
		ЭтаФорма.Прочитать();
		ОбновитьПанельТекущегоПользователя();
		ОбновитьПанельСостояний();
	ИначеЕсли ИмяСобытия = "СозданРуководительКонтрагента" Тогда
		Объект.РуководительКонтрагента = Параметр;
		Элементы.РуководительКонтрагента.СписокВыбора.ЗагрузитьЗначения(ПолучитьВсехРуководителейКонтрагента(Объект.Контрагент));
	ИначеЕсли ИмяСобытия = "СозданПодписантКонтрагента" Тогда
		ЗаполнитьДанныеПодписантаКонтрагента(Параметр);
		Модифицированность = Истина;
	//Евросиб Коханенко Н.А. 28.03.2025 (( #102319 
	ИначеЕсли ИмяСобытия = "СписокПрисоединенныхФайловПСЦПоставщикаИзменен" 
		И Параметр.ВладелецФайлов = Объект.Ссылка Тогда
    	//произошло сохранение ПФ ПСЦ Поставшика в PDF формате и сохранение в Присоединенных файлах 
		//п.1.3 - блокируем все поля кроме разрешенных из списка
		ОбновитьБлокировкуЭлементов();
		//ЗаблокироватьПоляФормы();
	//Евросиб Коханенко Н.А. 28.03.2025 )) #102319
	//Евросиб Шевченко А.В. US 110215 TA 122847 10.11.2025
	ИначеЕсли ИмяСобытия = "Запись_Файл" Тогда
		
		ТекущийИсполнитель_Статус = "";
		ТекущийИсполнитель_Состояние = "";
		ТекущийИсполнитель_Исполнитель = "";
		ТекущийИсполнитель_Наблюдатель = "";
	
		ЭтаФорма.Прочитать();
		ОбновитьПанельСостояний();
		ОбновитьПанельТекущегоПользователя();
		
		ПроверитьЗадачуПроверкаСогласования();
		
	//Евросиб Шевченко А.В. US 110215 TA 122847 10.11.2025	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьЗадачуПроверкаСогласования() //Евросиб Шевченко А.В. US 110215 TA 122847 10.11.2025
	
	СтрокаСостояния = Объект.Состояния.НайтиСтроки(Новый Структура("Состояние", Справочники.Состояния.ПроверкаСогласованияОтправкаПодкреплениеПодписанногоПСЦ));
	Если СтрокаСостояния.Количество() <> 0 Тогда
		НС = СтрокаСостояния[0];
	Иначе
		НС = Объект.Состояния.Добавить();	
	КонецЕсли;
	
	Если НС.Статус = Перечисления.СтатусыЭтапов.Выполнен Тогда
		
		Если НЕ ЕстьСканКопияВПрисоедененныхФайлах(Объект.Ссылка) Тогда
			НС.Исполнитель = Объект.Автор;
			Если Объект.Состояния.Количество() Тогда
				НС.Наблюдатель = Объект.Автор;
			КонецЕсли;
			НС.Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
			НС.Состояние = Справочники.Состояния.ПроверкаСогласованияОтправкаПодкреплениеПодписанногоПСЦ; 
			НС.НачалоРаботы = ТекущаяДата();
			ЭтотОбъект.Записать();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	// Евросиб US 89887 TA 89889 Рыбьяков К.А. 21.11.2024 ((
	Если ОбщегоНазначенияВызовСервера.ЕстьРелизСобственника(Объект.Ссылка) И НЕ Объект.Типовой Тогда
		Текст = НСтр("ru = 'На основании протокола созданы релизы собственника, нельзя изменить тип протокола.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(Текст,,,, Отказ);
		ЭтаФорма.Прочитать();
	Иначе
		ПроверитьНеобходимостьИзмененийСозданныхРелизов(Отказ, ПараметрыЗаписи);
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 21.11.2024 ))
	
	ПередЗаписьюСервер();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	//Евросиб Трундуков СА # 119893 22.09.2025 Проверка перенесена в модуль объекта
	//Если ЗначениеЗаполнено(ТекущийОбъект.НомерПСЦ) Тогда
	//	НомерПСЦУникален = Документы.ПСЦПоставщика.ПроверитьУникальностьНомераПСЦ(ТекущийОбъект);
	//	Если Не НомерПСЦУникален Тогда
	//		ОбщегоНазначения.СообщитьПользователю("Уже есть проведенный ПСЦ поставщика с таким Номером ПСЦ!",, "НомерПСЦ", "Объект", Отказ);
	//	КонецЕсли;
	//КонецЕсли;
	
	// если документ НЕ типовой, то, если изменился статус состояния (перешел в "Выполнено"), то проверить, что есть прикрепленные файлы.
	// если файлов нет, то запретить сохранение со статусом "Выполнено".
	// проверяем текущее состояние. если оно предшествует состоянию с флагом Согласование, то проверяем смену статуса.
	Для ШагЦикла = 0 По Объект.Состояния.Количество()-1 Цикл
		ТекСтрока = Объект.Состояния[ШагЦикла];
		Если ШагЦикла < Объект.Состояния.Количество()-1 Тогда
			СледСтрока = Объект.Состояния[ШагЦикла+1];
		Иначе 
			СледСтрока = Неопределено;
		КонецЕсли;
		
		Если ТекСтрока.Состояние = Объект.ТекущееСостояние И ТекСтрока.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Выполнен") Тогда
			Если СледСтрока <> неопределено И ЭтоСогласование(СледСтрока.Состояние) Тогда
				Если Не Объект.Типовой И НЕ ПроверкаНаПрикрепленные(Объект.Ссылка) Тогда
					ОбщегоНазначения.СообщитьПользователю("Протокол является нетиповым! Прикрепите файлы! Невозможна установка статуса ""Выполнено"" для состояния """ + ТекСтрока.Состояние + """",,,, Отказ);
				КонецЕсли;
			Иначе
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	СогласованиеСервер.ОбработатьОтменуСогласованияДокументаПередЗаписью(ТекущийОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	//ОбновитьБлокировкуЭлементов();
	
	ОбновитьПанельТекущегоПользователя();
	ОбновитьПанельСостояний();
	
	//ОбновитьПредставлениеУчетныхЕдиницСтрокУслуг();
	ОбновитьДинамическиеПоляТаблицыУслуг(, Истина);
	ОбновитьГруппуПротоколовНормативныхСтавок();
	
	Элементы.СсылкаНаПротоколВДО.Видимость = ЗначениеЗаполнено(Объект.СсылкаНаВнутреннийДокументДО);  
	Если ПроверкаГруппыДоступа("Менеджер сопровождения") и ЗначениеЗаполнено(Объект.СсылкаНаВнутреннийДокументДО) Тогда
		Элементы.ПередатьПСЦВДО.Видимость = Истина;	
	КонецЕсли;
	
	Элементы.ДатаПереводаВСтатусПодписан.Доступность = Объект.ПодписанСДвухСторон;
	
	// Евросиб US 89887 TA 89889 Рыбьяков К.А. 18.11.2024 ((
	Документы.РелизСобственника.ЗаполнитьРелизСобственникаНаОснованииПСЦПоставщика(Объект.Ссылка, ?(ПараметрыЗаписи.Свойство("ВопросУжеБылЗадан"), Истина, Ложь));
	// Евросиб Рыбьяков К.А. 18.11.2024 ))
	
	//Евросиб Шевченко А.В. US 112958 TA 112962 07.07.2025
	УстановитьВидимостьКомандПечати();
	//Евросиб Шевченко А.В. US 112958 TA 112962 07.07.2025
	
	//Евросиб Ситников К.А. 09.07.2025 Task 113813
	ОбновитьБлокировкуЭлементов();
	//Евросиб Ситников К.А. 09.07.2025 Task 113813
	
КонецПроцедуры

#КонецОбласти

