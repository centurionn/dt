					СтрокаУслуги.ТипоразмерВагона = ТипоразмерыВагонов[0];
				Иначе
					СтрокаУслуги.ТипоразмерВагона = ТипоразмерыТСПустаяСсылка;
				КонецЕсли;
				
				ВидыОтправок = ТаблицаКритериевПоСтрокеУслуги.ВыгрузитьКолонку("ВидОтправки");
				ВидыОтправок = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ВидыОтправок);
				ОбщегоНазначенияКлиентСервер.УдалитьВсеВхожденияЗначенияИзМассива(ВидыОтправок, ВидОтправкиПустаяСсылка);
				СтрокаУслуги.ВидыОтправок.ЗагрузитьЗначения(ВидыОтправок);
				СтрокаУслуги.ВидыОтправокСтрокой = СтрСоединить(ВидыОтправок, "; ");
				
				СостоянияГруженыйПорожний = Новый Массив;
				Если СтрокаУслуги.ДляГруженых Тогда
					СостоянияГруженыйПорожний.Добавить(СостояниеГруженый);
				КонецЕсли;				
				Если СтрокаУслуги.ДляПорожних Тогда
					СостоянияГруженыйПорожний.Добавить(СостояниеПорожний);
				КонецЕсли;
				СтрокаУслуги.СостоянияГруженыйПорожний.ЗагрузитьЗначения(СостоянияГруженыйПорожний);
				СтрокаУслуги.СостоянияГруженыйПорожнийСтрокой = СтрСоединить(СостоянияГруженыйПорожний, "; ");
				
				////Евросиб Шевченко А.В. US 123730 TA 125768 15.12.2025
				//ДорогиОтправления = ТаблицаКритериевПоСтрокеУслуги.ВыгрузитьКолонку("ДорогаОтправления");
				//ДорогиОтправления = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ДорогиОтправления);
				//ОбщегоНазначенияКлиентСервер.УдалитьВсеВхожденияЗначенияИзМассива(ДорогиОтправления, Справочники.ЖелезныеДороги.ПустаяСсылка());
				//СтрокаУслуги.ДорогиОтправления.ЗагрузитьЗначения(ДорогиОтправления);
				//СтрокаУслуги.ДорогаОтправления = СтрСоединить(ДорогиОтправления, "; ");
				//
				//ЖелезныеДороги = ТаблицаКритериевПоСтрокеУслуги.ВыгрузитьКолонку("ЖелезнаяДорога");
				//ЖелезныеДороги = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ЖелезныеДороги);
				//ОбщегоНазначенияКлиентСервер.УдалитьВсеВхожденияЗначенияИзМассива(ЖелезныеДороги, Справочники.ЖелезныеДороги.ПустаяСсылка());
				//ОбщегоНазначенияКлиентСервер.УдалитьВсеВхожденияЗначенияИзМассива(ЖелезныеДороги, Справочники.СтраныМира.ПустаяСсылка());
				//СтрокаУслуги.ЖелезныеДороги.ЗагрузитьЗначения(ЖелезныеДороги);
				//СтрокаУслуги.ДорогаОтправления = СтрСоединить(ЖелезныеДороги, "; ");
				//
				//ДорогиНазначения = ТаблицаКритериевПоСтрокеУслуги.ВыгрузитьКолонку("ДорогаНазначения");
				//ДорогиНазначения = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ДорогиНазначения);
				//ОбщегоНазначенияКлиентСервер.УдалитьВсеВхожденияЗначенияИзМассива(ДорогиНазначения, Справочники.ЖелезныеДороги.ПустаяСсылка());
				//СтрокаУслуги.ДорогиНазначения.ЗагрузитьЗначения(ДорогиНазначения);
				//СтрокаУслуги.ЖелезнаяДорога = СтрСоединить(ДорогиНазначения, "; ");
				////Евросиб Шевченко А.В. US 123730 TA 125768 15.12.2025
				
			КонецЕсли;
			
			Для Каждого Стр Из ТаблицаКритериевПоСтрокеУслуги Цикл
				Если ЗначениеЗаполнено(Стр.КлючНормативнойСтавки) Тогда
					
					Если ЗначениеЗаполнено(Стр.ПредставлениеТипоразмераКТК) Тогда
						ПредставлениеЭлемента = СтрШаблон("НС для %1 (Протокол:%2)", Стр.ПредставлениеТипоразмераКТК, Стр.НомерПротоколаНС);						
					Иначе
						ПредставлениеЭлемента = СтрШаблон("НС (Протокол:%2)", Стр.НомерПротоколаНС);
					КонецЕсли;
					
					СтрокаУслуги.КлючиНормативныхСтавок.Добавить(Стр.КлючНормативнойСтавки, ПредставлениеЭлемента);
					ПредставленияНормативныхСтавок.Добавить(ПредставлениеЭлемента);
					
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
		Для Каждого ЭлементСписка Из СтрокаУслуги.КлючиНеподошедшихНормативныхСтавок Цикл
			ПредставленияНормативныхСтавок.Добавить(ЭлементСписка.Представление);
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ПредставленияНормативныхСтавок) Тогда
			СтрокаУслуги.КлючиНормативныхСтавокСтрокой = СтрСоединить(ПредставленияНормативныхСтавок, "; ");
		Иначе
			СтрокаУслуги.КлючиНормативныхСтавокСтрокой = "";
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьГруппуПротоколовНормативныхСтавок()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Услуги.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	Услуги.ПроверкаСтавок КАК ПроверкаСтавок
	|ПОМЕСТИТЬ Услуги
	|ИЗ
	|	&Услуги КАК Услуги
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КритерииУслуг.НомерСтроки КАК НомерСтроки,
	|	КритерииУслуг.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	КритерииУслуг.Критерий КАК Критерий,
	|	КритерииУслуг.ТипоразмерКТК КАК ТипоразмерКТК,
	|	КритерииУслуг.КлючНормативнойСтавки КАК КлючНормативнойСтавки
	|ПОМЕСТИТЬ КритерииУслуг
	|ИЗ
	|	&КритерииУслуг КАК КритерииУслуг
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КритерииУслуг.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	КритерииУслуг.Критерий КАК Критерий,
	|	КритерииУслуг.ТипоразмерКТК КАК ТипоразмерКТК,
	|	КритерииУслуг.КлючНормативнойСтавки КАК КлючНормативнойСтавки,
	|	ПротоколСНормативнымиСтавкамиНаУслугиПоставщиковКритерииУслуг.Ссылка КАК ПротоколНормативныхСтавок,
	|	ПротоколСНормативнымиСтавкамиНаУслугиПоставщиковКритерииУслуг.Ссылка.Представление КАК ПредставлениеПротоколаНормативныхСтавок,
	|	Услуги.ПроверкаСтавок КАК ПроверкаСтавок
	|ИЗ
	|	Услуги КАК Услуги
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КритерииУслуг КАК КритерииУслуг
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПротоколСНормативнымиСтавкамиНаУслугиПоставщиков.КритерииУслуг КАК ПротоколСНормативнымиСтавкамиНаУслугиПоставщиковКритерииУслуг
	|			ПО КритерииУслуг.КлючНормативнойСтавки = ПротоколСНормативнымиСтавкамиНаУслугиПоставщиковКритерииУслуг.КлючАналитикиСтрокиПротокола
	|				И (КритерииУслуг.КлючНормативнойСтавки <> &КлючНормативнойСтавкиПустаяСсылка)
	|		ПО Услуги.ИдентификаторСтрокиУслуг = КритерииУслуг.ИдентификаторСтрокиУслуг";
	
	ТаблицаУслуг = Объект.Услуги.Выгрузить(Новый Структура("ПроверкаСтавок", Перечисления.РезультатыПроверки.Пройдена), "ИдентификаторСтрокиУслуг, ПроверкаСтавок");	
	Запрос.УстановитьПараметр("Услуги", ТаблицаУслуг);
	
	ТаблицаКритериевУслуг = Объект.КритерииУслуг.Выгрузить();
	Запрос.УстановитьПараметр("КритерииУслуг", ТаблицаКритериевУслуг);
	
	Запрос.УстановитьПараметр("КлючНормативнойСтавкиПустаяСсылка", Справочники.КлючиАналитикиСтрокПротокола.ПустаяСсылка());
	
	ТаблицаКритериевУслуг = Запрос.Выполнить().Выгрузить();
	
	//Сначала получаем массив удаляемых элементов, а потом удаляем их. После удаления непосредственным обходом Подчиненных элементов, оставались подчиненные элементы
	УдаляемыеЭлементы = Новый Массив;
	Для Каждого ЭлементСсылкаНаПротоколНормативныхСтавок Из Элементы.ГруппаПротоколыНормативныхСтавок.ПодчиненныеЭлементы Цикл
		УдаляемыеЭлементы.Добавить(ЭлементСсылкаНаПротоколНормативныхСтавок);
	КонецЦикла;	
	Для Каждого УдаляемыйЭлемент Из УдаляемыеЭлементы Цикл
		Элементы.Удалить(УдаляемыйЭлемент);
	КонецЦикла;
	
	ТаблицаКритериевУслуг.Свернуть("ПротоколНормативныхСтавок, ПредставлениеПротоколаНормативныхСтавок");
	Для Каждого Стр Из ТаблицаКритериевУслуг Цикл
		Если ЗначениеЗаполнено(Стр.ПротоколНормативныхСтавок) Тогда
			ГУИД = Строка(Стр.ПротоколНормативныхСтавок.УникальныйИдентификатор());
			ИмяЭлемента = "СсылкаНаПротокол" + СтрЗаменить(ГУИД, "-", "_");
			ЭлементСсылкаНаПротоколНормативныхСтавок = Элементы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), Элементы.ГруппаПротоколыНормативныхСтавок);
			ЭлементСсылкаНаПротоколНормативныхСтавок.Вид = ВидДекорацииФормы.Надпись;
			ЭлементСсылкаНаПротоколНормативныхСтавок.АвтоМаксимальнаяШирина = Ложь;
			ЭлементСсылкаНаПротоколНормативныхСтавок.Заголовок = Новый ФорматированнаяСтрока(Стр.ПредставлениеПротоколаНормативныхСтавок,,,, ПолучитьНавигационнуюСсылку(Стр.ПротоколНормативныхСтавок));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДинамическиеПоляТаблицыУслугПоСтроке(ТекДанные, ОбновитьСписочныеПоля = Ложь)
	
	СтрокиУслуг = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТекДанные);
	ОбновитьДинамическиеПоляТаблицыУслуг(СтрокиУслуг, ОбновитьСписочныеПоля);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПредставлениеУчетныхЕдиницСтрокиУслуг(СтрокаТЧ, ОбновитьСписокУчетныхЕдиниц = Истина)
	
	ПараметрыПоиска = Новый Структура("ИдентификаторСтрокиУслуг", СтрокаТЧ.ИдентификаторСтрокиУслуг);
	СтрокиУчетныхЕдиниц = Объект.УчетныеЕдиницы.НайтиСтроки(ПараметрыПоиска);
	ТаблицаУчетныхЕдиницыПоУслуге = Объект.УчетныеЕдиницы.Выгрузить(СтрокиУчетныхЕдиниц, "УчетнаяЕдиница");
	
	Если ОбновитьСписокУчетныхЕдиниц Тогда
		СтрокиСписка = СписокУчетныхЕдиниц.НайтиСтроки(ПараметрыПоиска);
		Для Каждого Стр Из СтрокиСписка Цикл
			СписокУчетныхЕдиниц.Удалить(Стр);
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТаблицаУчетныхЕдиницыПоУслуге) Тогда
		
		УчетныеЕдиницы = ТаблицаУчетныхЕдиницыПоУслуге.ВыгрузитьКолонку("УчетнаяЕдиница");
		СтрокаСписокУчетныхЕдиниц = СтрСоединить(УчетныеЕдиницы, ",");
		СтрокаТЧ.КонтейнерыВагоны = СтрокаСписокУчетныхЕдиниц;
		ТипЗначения = ТипЗнч(УчетныеЕдиницы[0]);
		Если ТипЗначения = Тип("СправочникСсылка.ТС") Тогда
			СтрокаТЧ.ТипУчетныхЕдиниц = "СправочникСсылка.ТС";
		ИначеЕсли ТипЗначения = Тип("СправочникСсылка.ТЕ") Тогда
			СтрокаТЧ.ТипУчетныхЕдиниц = "СправочникСсылка.ТЕ";
		Иначе
			СтрокаТЧ.ТипУчетныхЕдиниц = "";
		КонецЕсли;
		
		Если ОбновитьСписокУчетныхЕдиниц Тогда
			Если СтрокаТЧ.СпособВводаУчетныхЕдиниц = Перечисления.СпособыВводаУчетныхЕдиниц.Построчно Тогда
				Для Каждого Стр Из СтрокиУчетныхЕдиниц Цикл
					НоваяСтрока = СписокУчетныхЕдиниц.Добавить();
					НоваяСтрока.ИдентификаторСтрокиУслуг = СтрокаТЧ.ИдентификаторСтрокиУслуг;
					НоваяСтрока.ИдентификаторСтрокиТаблицыУчЕдиниц = Стр.ПолучитьИдентификатор();
					НоваяСтрока.УчетнаяЕдиницаСсылка = Стр.УчетнаяЕдиница;
					НоваяСтрока.УчетнаяЕдиница = Стр.УчетнаяЕдиница;
				КонецЦикла;
			ИначеЕсли СтрокаТЧ.СпособВводаУчетныхЕдиниц = Перечисления.СпособыВводаУчетныхЕдиниц.Списком Тогда
				НоваяСтрока = СписокУчетныхЕдиниц.Добавить();
				НоваяСтрока.ИдентификаторСтрокиУслуг = СтрокаТЧ.ИдентификаторСтрокиУслуг;
				НоваяСтрока.ИдентификаторСтрокиТаблицыУчЕдиниц = -1;
				НоваяСтрока.УчетнаяЕдиница = СтрокаСписокУчетныхЕдиниц;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		СтрокаТЧ.КонтейнерыВагоны = "";
		СтрокаТЧ.ТипУчетныхЕдиниц = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыВидаУслуг.ТипУчетныхЕдиницДетализации) Тогда
		СтрокаТЧ.ТипУчетныхЕдиниц = ПараметрыВидаУслуг.ТипУчетныхЕдиницДетализации;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТЧ.ТипУчетныхЕдиниц) Тогда		
		Элементы.СписокУчетныхЕдиницУчетнаяЕдиницаСсылка.ОграничениеТипа = Новый ОписаниеТипов(СтрокаТЧ.ТипУчетныхЕдиниц);
	Иначе
		Элементы.СписокУчетныхЕдиницУчетнаяЕдиницаСсылка.ОграничениеТипа = Новый ОписаниеТипов();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокГруппыСторонаОрганизации()
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		Элементы.ГруппаСторонаОрганизации.Заголовок = СтрШаблон("Сторона %1", ПолучитьНаименованиеГоловнойОрганизации(Объект.Организация));
	Иначе
		Элементы.ГруппаСторонаОрганизации.Заголовок = "Сторона организации";
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьНаименованиеГоловнойОрганизации(Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(Организации.ГоловнаяОрганизация.Наименование, Организации.Наименование) КАК Наименование
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.Ссылка = &Организация";
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		НаименованиеОрганизации = Выборка.Наименование;
	Иначе
		НаименованиеОрганизации = "";
	КонецЕсли;
	
	Возврат НаименованиеОрганизации;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПроверкаГруппыДоступа(НаименованиеГруппыДоступа)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПрофилиГруппДоступа.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_Профиль
		|ИЗ
		|	Справочник.ПрофилиГруппДоступа КАК ПрофилиГруппДоступа
		|ГДЕ
		|	ПрофилиГруппДоступа.Наименование = &Наименование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ГруппыДоступа.Ссылка КАК Ссылка1,
		|	ГруппыДоступаПользователи.Пользователь КАК Пользователь
		|ИЗ
		|	ВТ_Профиль КАК ВТ_Профиль
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа КАК ГруппыДоступа
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
		|			ПО ГруппыДоступа.Ссылка = ГруппыДоступаПользователи.Ссылка
		|		ПО (ГруппыДоступа.Профиль = ВТ_Профиль.Ссылка)
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(ГруппыДоступаПользователи.Пользователь) <> ЗНАЧЕНИЕ(Справочник.ГруппыПользователей)
		|	И НЕ ГруппыДоступаПользователи.Пользователь ЕСТЬ NULL
		|	И ГруппыДоступаПользователи.Пользователь = &Пользователь
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ГруппыДоступа.Ссылка,
		|	ГруппыПользователейСостав.Пользователь
		|ИЗ
		|	ВТ_Профиль КАК ВТ_Профиль
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа КАК ГруппыДоступа
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
		|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыПользователей.Состав КАК ГруппыПользователейСостав
		|				ПО ГруппыДоступаПользователи.Пользователь = ГруппыПользователейСостав.Ссылка
		|			ПО ГруппыДоступа.Ссылка = ГруппыДоступаПользователи.Ссылка
		|		ПО (ГруппыДоступа.Профиль = ВТ_Профиль.Ссылка)
		|ГДЕ
		|	НЕ ГруппыПользователейСостав.Пользователь ЕСТЬ NULL
		|	И ГруппыПользователейСостав.Пользователь = &Пользователь
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_Профиль";
	
	Запрос.УстановитьПараметр("Наименование", НаименованиеГруппыДоступа);
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если не РезультатЗапроса.Пустой() Тогда
		Возврат Истина;
	КонецЕсли;	
	
	Возврат Ложь;
	
