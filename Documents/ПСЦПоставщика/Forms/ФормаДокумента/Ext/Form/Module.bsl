&НаСервере
Функция ПолучитьТипКонтейнера(ИмяТипаКонтейнера) 
	
	Результат = неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТипоразмерыТЕ.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ТипоразмерыТЕ КАК ТипоразмерыТЕ
	               |ГДЕ
	               |	ТипоразмерыТЕ.Наименование ПОДОБНО &Наименование";
	Запрос.УстановитьПараметр("Наименование", ИмяТипаКонтейнера);
