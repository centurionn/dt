Функция ПолучитьЭлементыГНГпоЧастиКода(Текст)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	э_ГНГ.Ссылка КАК Ссылка,
	|	э_ГНГ.КодГНГСтрокой КАК Код,
	|	э_ГНГ.Наименование КАК Наименование
	|ИЗ
	|	Справочник.э_ГНГ КАК э_ГНГ
	|ГДЕ
	|	э_ГНГ.КодГНГСтрокой ПОДОБНО &Текст
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код";
	Запрос.УстановитьПараметр("Текст", "%" + Текст + "%");
	
	СписокЭлементов = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокЭлементов.Добавить(Выборка.Ссылка, СтрШаблон("%1 (%2)", Выборка.Наименование, Выборка.Код));
	КонецЦикла;
	
	Возврат СписокЭлементов;
	
КонецФункции


