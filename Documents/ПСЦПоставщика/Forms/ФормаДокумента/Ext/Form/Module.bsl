&НаКлиенте
Процедура УслугиТипоразмерКТК_ВагонаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	Если Не ЗначениеЗаполнено(ТекДанные.ТипоразмерКТК_Вагона) Тогда
		Если ТекДанные.ЕдиницаИзмерения = ПредопределенноеЗначение("Справочник.КлассификаторЕдиницИзмерения.вагон") Тогда
			ТекДанные.ТипоразмерКТК_Вагона = ПредопределенноеЗначение("Справочник.ТипоразмерыТС.ПустаяСсылка");
		ИначеЕсли ТекДанные.ЕдиницаИзмерения = ПредопределенноеЗначение("Справочник.КлассификаторЕдиницИзмерения.ктк") Тогда
			ТекДанные.ТипоразмерКТК_Вагона = ПредопределенноеЗначение("Справочник.ТипоразмерыТЕ.ПустаяСсылка");
		Иначе
			ТекДанные.ТипоразмерКТК_Вагона = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(ТекДанные.ТипоразмерКТК_Вагона);
	Если ТипЗначения = Тип("СправочникСсылка.ТипоразмерыТС") Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФорму("Справочник.ТипоразмерыТС.ФормаВыбора",, Элемент,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.ТипоразмерыТЕ") Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФорму("Справочник.ТипоразмерыТЕ.ФормаВыбора",, Элемент,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

