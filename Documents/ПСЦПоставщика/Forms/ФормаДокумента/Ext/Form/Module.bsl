&НаКлиенте
Процедура УслугиКодТНВЭДАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	ТекстДляПоиска = СокрЛП(Текст);
	Если СтрДлина(ТекстДляПоиска) > 2 Тогда
		СтандартнаяОбработка = Ложь;
		ДанныеВыбора = ПолучитьЭлементыТНВЭДпоЧастиКода(ТекстДляПоиска);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЭлементыТНВЭДпоЧастиКода(Текст)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГрузыПоТНВЭД.Ссылка КАК Ссылка,
	|	ГрузыПоТНВЭД.ТНВЭД КАК Код,
	|	ГрузыПоТНВЭД.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ГрузыПоТНВЭД КАК ГрузыПоТНВЭД
	|ГДЕ
	|	ГрузыПоТНВЭД.ТНВЭД ПОДОБНО &Текст
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код";
	Запрос.УстановитьПараметр("Текст", "%" + Текст + "%");
	
	СписокЭлементов = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокЭлементов.Добавить(Выборка.Ссылка, СтрШаблон("%1 (%2)", Выборка.Наименование, Выборка.Код));
	КонецЦикла;
	
	Возврат СписокЭлементов;
	
КонецФункции

