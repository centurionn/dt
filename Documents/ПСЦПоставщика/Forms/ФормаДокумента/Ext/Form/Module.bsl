		//Евросиб Шевченко А.В. US 86665 TA 120749 19.10.2025	
			//Евросиб Шевченко А.В. US 110215 TA 120129 06.10.2025	
			Если СтрокаТЧ.БылиИзмененияГруза Тогда
				Если ЗначениеЗаполнено(СтрокаТЧ.ВесГруза) Тогда
					СтрокаТЧ.СостоянияГруженыйПорожний.Очистить();
					СтрокаТЧ.СостоянияГруженыйПорожний.Добавить(СостояниеГруженый);
				ИначеЕсли ЗначениеЗаполнено(СтрокаТЧ.ГрузЕТСНГ) Тогда
					СтрокаТЧ.СостоянияГруженыйПорожний.Очистить();
					СтрокаТЧ.СостоянияГруженыйПорожний.Добавить(СостояниеГруженый);
				ИначеЕсли ЗначениеЗаполнено(СтрокаТЧ.ГрузГНГ) Тогда
					СтрокаТЧ.СостоянияГруженыйПорожний.Очистить();
					СтрокаТЧ.СостоянияГруженыйПорожний.Добавить(СостояниеГруженый);
				ИначеЕсли ЗначениеЗаполнено(СтрокаТЧ.ЕТСНГ) Тогда
					СтрокаТЧ.СостоянияГруженыйПорожний.Очистить();
					СтрокаТЧ.СостоянияГруженыйПорожний.Добавить(СостояниеГруженый);
				ИначеЕсли ЗначениеЗаполнено(СтрокаТЧ.ГНГ) И НЕ СтрокаТЧ.ГНГ = "0" Тогда
					СтрокаТЧ.СостоянияГруженыйПорожний.Очистить();
					СтрокаТЧ.СостоянияГруженыйПорожний.Добавить(СостояниеГруженый);
				//Евросиб Шевченко А.В. US 110215 TA 120129 06.10.2025	
				ИначеЕсли ЗначениеЗаполнено(СтрокаТЧ.КодТНВЭД) Тогда
					СтрокаТЧ.СостоянияГруженыйПорожний.Очистить();
					СтрокаТЧ.СостоянияГруженыйПорожний.Добавить(СостояниеГруженый);
				ИначеЕсли ЗначениеЗаполнено(СтрокаТЧ.ГрузТНВЭД) Тогда
					СтрокаТЧ.СостоянияГруженыйПорожний.Очистить();
					СтрокаТЧ.СостоянияГруженыйПорожний.Добавить(СостояниеГруженый);	
				//Евросиб Шевченко А.В. US 110215 TA 120129 06.10.2025	
				ИначеЕсли СтрокаТЧ.ОпасныйСпецГруз Тогда
					СтрокаТЧ.СостоянияГруженыйПорожний.Очистить();
					СтрокаТЧ.СостоянияГруженыйПорожний.Добавить(СостояниеГруженый);
				Иначе
					СтрокаТЧ.СостоянияГруженыйПорожний.Очистить();
					СтрокаТЧ.СостоянияГруженыйПорожний.Добавить(СостояниеПорожний);
					//Евросиб Шевченко А.В. US 86665 TA 120749 19.10.2025
					Если Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Фрахт ИЛИ Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.ТЭО Тогда
						СтрокаТЧ.СостоянияГруженыйПорожний.Очистить();
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
		//Евросиб Шевченко А.В. US 110216 TA 112376 07.08.2025
		
		//	
		//	ПоляТаблицыУслуг = ПараметрыВидаУслуг.ПоляТаблицыУслуг;
		//	ОписаниеПоляГруженыйПорожний = ПоляТаблицыУслуг.Получить("СостояниеГруженыйПорожний");
