&НаСервере
Процедура ОбновитьБлокировкуЭлементов()
	
	КонтрольДоступностиДокументов_сервер.ОбработатьБлокировкуЭлементовФормы(Объект.Ссылка, Элементы, Объект);
	//Евросиб Шевченко А.В. US 86665 TA 120749 19.10.2025
	Если Объект.ВидУслугПоставщика <> Справочники.ВидыУслугПоставщиков.ТЭО Тогда
		УстановитьДоступностьГруппыНормативы();
	КонецЕсли;
	//Евросиб Шевченко А.В. US 86665 TA 120749 19.10.2025
	//Евросиб Коханенко Н.А. 29.04.2025 (( #102319
	Если ЗначениеЗаполнено(Объект.Ссылка) 
		И ЗначениеЗаполнено(Элементы.ПредупреждениеРедактирования.Заголовок) Тогда
		Элементы.ГруппаИнформацияОДокументе.Видимость = Истина;
	КонецЕсли;
	//Евросиб Коханенко Н.А. 29.04.2025 )) #102319 
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьГруппыНормативы() Экспорт
	
	ДоступностьИзмененияНормативов = РольДоступна("ПолныеПрава");
	СтрокиВводПСЦ = Объект.Состояния.НайтиСтроки(Новый Структура("Состояние", Справочники.Состояния.ВводПСЦ));
	Если ЗначениеЗаполнено(СтрокиВводПСЦ) Тогда
		ИсполнительВводаПСЦ = СтрокиВводПСЦ[0].Исполнитель;
		Если ИсполнительВводаПСЦ = Пользователи.ТекущийПользователь() Тогда
			ДоступностьИзмененияНормативов = Истина;
		КонецЕсли;
	Иначе
		Если Объект.Автор = Пользователи.ТекущийПользователь() Тогда
			ДоступностьИзмененияНормативов = Истина;
		КонецЕсли;
	КонецЕсли;
		
	Элементы.УслугиГруппаНормативы.Доступность = Элементы.УслугиНоменклатура.Доступность;
	Элементы.УслугиГруппаНормативы.ТолькоПросмотр = Не ДоступностьИзмененияНормативов;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПараметрыМаршрутизацииНаСервере(Знач Объект)
	Возврат Документы.ПСЦПоставщика.ПолучитьПараметрыМаршрутизации(Объект);
КонецФункции

&НаСервере
Процедура СоздатьКарточкуПСЦвДОНаСервере()  
	
	ДанныеДляОтправки = ЕСОбменСервер.ПодготовитьТаблицуПСЦдляОтправкиДО(Объект.Ссылка);
	ЕСОбменСервер.СоздатьКарточкуПСЦвДО(ДанныеДляОтправки);  
	
	Если СтрНайти(ДанныеДляОтправки[0].Сообщение, "ОК") <> 0 Тогда 
		Объект.СсылкаНаВнутреннийДокументДО = ДанныеДляОтправки[0].Ссылка_В_ДО; 
		ЭтаФорма.Записать();
	КонецЕсли;	
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПоместитьОписаниеПолейВоВременноеХранилище(ВидУслугПоставщика, Адрес)
	
	НастройкаВидаУслуг = Справочники.ВидыУслугПоставщиков.ПолучитьНастройкиВидаУслуг(ВидУслугПоставщика, "ПСЦПоставщика.Услуги");
	ТаблицаПолей = НастройкаВидаУслуг.ПоляТаблицыУслуг;
	
	АдресХранилища = ПоместитьВоВременноеХранилище(ТаблицаПолей, Адрес);
	
	Возврат АдресХранилища;
		
КонецФункции

&НаСервере
Процедура НастроитьКолонкиТаблицыУслугПоВидуУслугПоставщика()
		
	НастройкиВидаУслуг = Справочники.ВидыУслугПоставщиков.ПолучитьНастройкиВидаУслуг(Объект.ВидУслугПоставщика, "ПСЦПоставщика.Услуги");	
	//АдресНастроекВидаУслуг = ПоместитьВоВременноеХранилище(НастройкиВидаУслуг, УникальныйИдентификатор);
	
	Если ЗначениеЗаполнено(АдресКэшаНастроекПолейПоУмолчанию) Тогда
		НастройкиПолейПоУмолчанию = ПолучитьИзВременногоХранилища(АдресКэшаНастроекПолейПоУмолчанию);
	Иначе
		НастройкиПолейПоУмолчанию = Новый Соответствие;
	КонецЕсли;
	
	ПоляТаблицыУслуг = НастройкиВидаУслуг.ПоляТаблицыУслуг;
	ДопУсловия       = НастройкиВидаУслуг.ДопУсловия;
	ДопУсловияОтборов.Очистить();
	Для Каждого Условие Из ДопУсловия Цикл
		НовСтрока = ДопУсловияОтборов.Добавить();
		НовСтрока.Имя = Условие.Имя;
		НовСтрока.Настройка = Условие.Условие.Получить();
	КонецЦикла;	
	
	ПараметрыВидаУслуг = Новый Структура;
	ПараметрыВидаУслуг.Вставить("ВалютаПоУмолчанию", НастройкиВидаУслуг.ВалютаПоУмолчанию);
	ПараметрыВидаУслуг.Вставить("ТипУчетныхЕдиницДетализации", НастройкиВидаУслуг.ТипУчетныхЕдиницДетализации);
	ПараметрыВидаУслуг.Вставить("ИспользоватьЗаполнениеНормативов", НастройкиВидаУслуг.ИспользоватьЗаполнениеНормативов);
	
	Если НастройкиВидаУслуг.ИспользоватьЗаполнениеНормативов = Неопределено Тогда
		НастройкиВидаУслуг.ИспользоватьЗаполнениеНормативов = Ложь;
	КонецЕсли;
	
	Если НастройкиВидаУслуг.ИспользоватьЗаполнениеНормативов Тогда
		ПараметрыВидаУслуг.Вставить("ЗаполнятьНормативы", НастройкиВидаУслуг.ЗаполнятьНормативы);
	Иначе
		ПараметрыВидаУслуг.Вставить("ЗаполнятьНормативы", Ложь);
	КонецЕсли;
	ПараметрыВидаУслуг.Вставить("СуммаВключаетНДС", НастройкиВидаУслуг.СуммаВключаетНДС);
	
	СписокИменКолонок = Новый Массив;
	Для Каждого Колонка Из ПоляТаблицыУслуг.Колонки Цикл
		СписокИменКолонок.Добавить(Колонка.Имя);		
	КонецЦикла;
	ИменаКолонок = СтрСоединить(СписокИменКолонок, ",");
	
	ОписанияПолейТаблицыУслуг = Новый Соответствие;
	ЗначенияПолейПоУмолчанию = Новый Соответствие;
	Для Каждого СтрокаТаблицыПолей Из ПоляТаблицыУслуг Цикл
		ОписаниеПоля = Новый Структура(ИменаКолонок);
		ЗаполнитьЗначенияСвойств(ОписаниеПоля, СтрокаТаблицыПолей);
		ОписанияПолейТаблицыУслуг.Вставить(СтрокаТаблицыПолей.Имя, ОписаниеПоля);
		Если СтрокаТаблицыПолей.ЗначениеПоУмолчанию <> Неопределено Тогда
			ЗначенияПолейПоУмолчанию.Вставить(СтрокаТаблицыПолей.Имя, СтрокаТаблицыПолей.ЗначениеПоУмолчанию);
		КонецЕсли;
	КонецЦикла;
	ПараметрыВидаУслуг.Вставить("ПоляТаблицыУслуг", ОписанияПолейТаблицыУслуг);
	ПараметрыВидаУслуг.Вставить("ЗначенияПолейПоУмолчанию", ЗначенияПолейПоУмолчанию);
	
	Элементы.ЗаполнятьНормативы.Видимость = НастройкиВидаУслуг.ИспользоватьЗаполнениеНормативов;
	Элементы.УслугиЗаполнитьНормативы.Видимость = НастройкиВидаУслуг.ИспользоватьЗаполнениеНормативов;
	
	ТипГруппаФормы = Тип("ГруппаФормы");
	ТабличноеПолеУслуги = Элементы.Услуги;
	
	ЭлементыИсключения = Новый Массив;
	ЭлементыИсключения.Добавить("УслугиГруппаСтоимостьСНДС");
	ЭлементыИсключения.Добавить("УслугиГруппаСтоимостьБезНДС");
	ЭлементыИсключения.Добавить("УслугиНомерСтроки");
	УстановитьВидимостьЭлементовГруппы(ТабличноеПолеУслуги, Ложь, ЭлементыИсключения);
		
	Элементы.УслугиПоказыватьНормативы.Доступность = Ложь;
	Элементы.УслугиПоказыватьОпасныйГруз.Доступность = Ложь;
	Элементы.УслугиПоказыватьОсобыйТемпературныйРежим.Доступность = Ложь;
	Элементы.УслугиПоказыватьДанныеПоКонтейнерамВагонам.Доступность = Ложь;
	
	Элементы.УслугиПоказыватьДанныеЛинии.Доступность = Ложь;
	Элементы.УслугиПоказыватьУсловияПеревозки.Доступность = Ложь;
	
	ГруппыПолей = Новый Соответствие;
	ГруппыПолей.Вставить("", Элементы.Услуги);
	Для Каждого ОписаниеПоля Из ПоляТаблицыУслуг Цикл
		
		ГруппаЭлементовРодитель = ГруппыПолей.Получить(ОписаниеПоля.Родитель);
		Если ОписаниеПоля.ЭтоГруппаЭлементов Тогда
			ГруппаЭлементов = Элементы.Найти("Услуги" + ОписаниеПоля.Имя);
			Если ГруппаЭлементов = Неопределено Тогда
				ГруппаЭлементов = Элементы.Добавить("Услуги" + ОписаниеПоля.Имя, Тип("ГруппаФормы"), ГруппаЭлементовРодитель);
			Иначе
				Элементы.Переместить(ГруппаЭлементов, ГруппаЭлементовРодитель);
			КонецЕсли;
			ГруппаЭлементов.Видимость = ОписаниеПоля.Выводить;
			ГруппаЭлементов.Заголовок = ОписаниеПоля.Представление;
			ГруппаЭлементов.ОтображатьВШапке = ОписаниеПоля.ОтображатьВШапке;
			ГруппаЭлементов.Группировка = ГруппировкаКолонок[ОписаниеПоля.Группировка];
			ГруппыПолей.Вставить(ОписаниеПоля.Имя, ГруппаЭлементов);
			
			Если ОписаниеПоля.Имя = "ГруппаДанныеПоКонтейнерамВагонам" Тогда
				Если ОписаниеПоля.Выводить Тогда
					ГруппаДанныеПоКонтейнерамВагонам = Элементы.УслугиГруппаДанныеПоКонтейнерамВагонам;
					ГруппаДанныеПоКонтейнерамВагонам.Видимость = Элементы.УслугиПоказыватьДанныеПоКонтейнерамВагонам.Пометка;
					Элементы.УслугиПоказыватьДанныеПоКонтейнерамВагонам.Доступность = Истина;				
				КонецЕсли;
			КонецЕсли;
			
			Продолжить;
		Иначе
			Элемент = Элементы.Найти("Услуги" + ОписаниеПоля.Имя);
			//Элемент = ТабличноеПолеУслуги.ПодчиненныеЭлементы.Найти("Услуги" + ОписаниеПоля.Имя);
		КонецЕсли;
	
		Если Элемент <> Неопределено Тогда
			
			Если ОписаниеПоля.Имя = "Нормативы" Тогда
				Если ОписаниеПоля.Выводить Тогда
					УслугиГруппаНормативы = Элементы.УслугиГруппаНормативы;
					УслугиГруппаНормативы.Видимость = Элементы.УслугиПоказыватьНормативы.Пометка;
					Элементы.УслугиПоказыватьНормативы.Доступность = Истина;				
				КонецЕсли;
			//Евросиб Шевченко А.В. US 86665 TA 120749 19.10.2025
			ИначеЕсли Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.ТЭО И ОписаниеПоля.Имя = "НормаПользования" Тогда 
				Если ОписаниеПоля.Выводить Тогда
					УслугиГруппаНормативы = Элементы.УслугиГруппаНормативы;
					УслугиГруппаНормативы.Видимость = Элементы.УслугиПоказыватьНормативы.Пометка;
					Элементы.УслугиПоказыватьНормативы.Доступность = Истина;				
				КонецЕсли;
			//Евросиб Шевченко А.В. US 86665 TA 120749 19.10.2025
			ИначеЕсли ОписаниеПоля.Имя = "ОсобыйТемпературныйРежим" Тогда
				Если ОписаниеПоля.Выводить Тогда
					УслугиГруппаОсобыйТемпературныйРежим = Элементы.УслугиГруппаОсобыйТемпературныйРежим;
					УслугиГруппаОсобыйТемпературныйРежим.Видимость = Элементы.УслугиПоказыватьОсобыйТемпературныйРежим.Пометка;
					Элементы.УслугиПоказыватьОсобыйТемпературныйРежим.Доступность = Истина;
				КонецЕсли;
			ИначеЕсли ОписаниеПоля.Имя = "ОпасныйСпецГруз" Тогда
				Если ОписаниеПоля.Выводить Тогда
					УслугиГруппаОпасныйГруз = Элементы.УслугиГруппаОпасныйГруз;
					УслугиГруппаОпасныйГруз.Видимость = Элементы.УслугиПоказыватьОпасныйГруз.Пометка;
					Элементы.УслугиПоказыватьОпасныйГруз.Доступность = Истина;				
				КонецЕсли;
			//Евросиб Шевченко А.В. US 86665 TA 120749 19.10.2025
			ИначеЕсли Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.ТЭО И ОписаниеПоля.Имя = "Линия" Тогда
				Если ОписаниеПоля.Выводить Тогда
					УслугиГруппаДанныеЛинии = Элементы.УслугиГруппаДанныеЛинии;
					УслугиГруппаДанныеЛинии.Видимость = Элементы.УслугиПоказыватьДанныеЛинии.Пометка;
					Элементы.УслугиПоказыватьДанныеЛинии.Доступность = Истина;				
				КонецЕсли;
			//Евросиб Шевченко А.В. US 86665 TA 120749 19.10.2025	
			ИначеЕсли Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.ТЭО И ОписаниеПоля.Имя = "УсловияИнкотермс" Тогда
				Если ОписаниеПоля.Выводить Тогда
					ГруппаУсловияПеревозкиОсновная = Элементы.УслугиГруппаУсловияПеревозкиОсновная;
					ГруппаУсловияПеревозкиОсновная.Видимость = Элементы.УслугиПоказыватьУсловияПеревозки.Пометка;
					Элементы.УслугиПоказыватьУсловияПеревозки.Доступность = Истина;				
				КонецЕсли;	
			КонецЕсли;
			//Евросиб Шевченко А.В. US 86665 TA 120749 19.10.2025
			Если ОписаниеПоля.Имя = "СтоимостьСНДС" Тогда
				//Поле включено в группу, поэтому перемещается и устанавливается видимость всей группы
				УслугиГруппаСтоимостьСНДС = Элементы.УслугиГруппаСтоимостьСНДС;
				Элементы.Переместить(УслугиГруппаСтоимостьСНДС, ГруппаЭлементовРодитель);
				УслугиГруппаСтоимостьСНДС.Заголовок = ОписаниеПоля.Представление;
				Если ОписаниеПоля.Выводить Тогда
					УслугиГруппаСтоимостьСНДС.Видимость = Истина;					
				КонецЕсли;
			ИначеЕсли ОписаниеПоля.Имя = "СтоимостьБезНДС" Тогда
				//Поле включено в группу, поэтому перемещается и устанавливается видимость всей группы
				УслугиГруппаСтоимостьБезНДС = Элементы.УслугиГруппаСтоимостьБезНДС;
				Элементы.Переместить(УслугиГруппаСтоимостьБезНДС, ГруппаЭлементовРодитель);
				УслугиГруппаСтоимостьБезНДС.Заголовок = ОписаниеПоля.Представление;
				Если ОписаниеПоля.Выводить Тогда
					УслугиГруппаСтоимостьБезНДС.Видимость = Истина;					
				КонецЕсли;	
			Иначе
				Элементы.Переместить(Элемент, ГруппаЭлементовРодитель);
			КонецЕсли;
			
			Элемент.Заголовок = ОписаниеПоля.Представление;
			Элемент.Видимость = ОписаниеПоля.Выводить;
			Элемент.ТолькоПросмотр = ОписаниеПоля.ТолькоПросмотр;
			
			Если Элемент.Вид = ВидПоляФормы.ПолеВвода Тогда
				
				Если ЗначениеЗаполнено(ОписаниеПоля.СписокВыбора) Тогда
					
					НастройкаПоля = НастройкиПолейПоУмолчанию.Получить(Элемент.Имя);
					Если НастройкаПоля = Неопределено Тогда
						НастройкиПолейПоУмолчанию.Вставить(Элемент.Имя, Новый Структура("СписокВыбора,ИсторияВыбораПриВводе,РедактированиеТекста,КнопкаВыбора,КнопкаСоздания",
								Элемент.СписокВыбора.ВыгрузитьЗначения(),
								Элемент.ИсторияВыбораПриВводе,
								Элемент.РедактированиеТекста,
								Элемент.КнопкаВыбора,
								Элемент.КнопкаСоздания));
					КонецЕсли;
					
					//Элемент.СписокВыбора.ЗагрузитьЗначения(ОписаниеПоля.СписокВыбора.ВыгрузитьЗначения());
					Элемент.ИсторияВыбораПриВводе = ИсторияВыбораПриВводе.НеИспользовать;
					//Элемент.РедактированиеТекста = Ложь;
					//Элемент.КнопкаВыбора = Ложь;
					//Элемент.КнопкаСоздания = Ложь;
				Иначе
					
					НастройкаПоля = НастройкиПолейПоУмолчанию.Получить(Элемент.Имя);
					Если НастройкаПоля <> Неопределено Тогда
						Элемент.СписокВыбора.ЗагрузитьЗначения(НастройкаПоля.СписокВыбора);
						Элемент.ИсторияВыбораПриВводе = НастройкаПоля.ИсторияВыбораПриВводе;
						//Элемент.РедактированиеТекста = НастройкаПоля.РедактированиеТекста;
						//Элемент.КнопкаВыбора = НастройкаПоля.КнопкаВыбора;
						//Элемент.КнопкаСоздания = НастройкаПоля.КнопкаСоздания;
					КонецЕсли;
					
				КонецЕсли;
					
				Если ЗначениеЗаполнено(ОписаниеПоля.ОграничениеТипа) Тогда
					СтрокаТипы = СтрСоединить(ОписаниеПоля.ОграничениеТипа, ",");
					Элемент.ОграничениеТипа = Новый ОписаниеТипов(СтрокаТипы);
				Иначе
					Элемент.ОграничениеТипа = Новый ОписаниеТипов;
				КонецЕсли;
				
				ПараметрыВыбораПоля = Новый Массив;
				Если ЗначениеЗаполнено(ОписаниеПоля.ПараметрыВыбора) Тогда
					Для Каждого ПараметрВыбора Из ОписаниеПоля.ПараметрыВыбора Цикл
						НовыйПараметр = Новый ПараметрВыбора(ПараметрВыбора.ИмяПараметра, ПараметрВыбора.ЗначениеПараметра);
						ПараметрыВыбораПоля.Добавить(НовыйПараметр);
					КонецЦикла;
				КонецЕсли;
				Элемент.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораПоля);
				
				Если ОписаниеПоля.Обязательное Тогда
					Элемент.АвтоОтметкаНезаполненного = Истина;
				Иначе
					Элемент.АвтоОтметкаНезаполненного = Ложь;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;		
		
	КонецЦикла;
	
	Элементы.УслугиПоказыватьНормативы.Пометка = Элементы.УслугиПоказыватьНормативы.Доступность;
	Элементы.УслугиПоказыватьОпасныйГруз.Пометка = Элементы.УслугиПоказыватьОпасныйГруз.Доступность;
	Элементы.УслугиПоказыватьДанныеЛинии.Пометка = Элементы.УслугиПоказыватьДанныеЛинии.Доступность;
	Элементы.УслугиПоказыватьУсловияПеревозки.Пометка = Элементы.УслугиПоказыватьУсловияПеревозки.Доступность;
	Элементы.УслугиПоказыватьОсобыйТемпературныйРежим.Пометка = Элементы.УслугиПоказыватьОсобыйТемпературныйРежим.Доступность;
	Элементы.УслугиПоказыватьДанныеПоКонтейнерамВагонам.Пометка = Элементы.УслугиПоказыватьДанныеПоКонтейнерамВагонам.Доступность;
	
	Элементы.УслугиГруппаНормативы.Видимость = Элементы.УслугиПоказыватьНормативы.Пометка;
	Элементы.УслугиГруппаОпасныйГруз.Видимость = Элементы.УслугиПоказыватьОпасныйГруз.Пометка;
	Элементы.УслугиГруппаДанныеЛинии.Видимость = Элементы.УслугиПоказыватьДанныеЛинии.Пометка;
	Элементы.УслугиГруппаУсловияПеревозкиОсновная.Видимость = Элементы.УслугиПоказыватьУсловияПеревозки.Пометка;
	Элементы.УслугиГруппаОсобыйТемпературныйРежим.Видимость = Элементы.УслугиПоказыватьОсобыйТемпературныйРежим.Пометка;
	Элементы.УслугиГруппаДанныеПоКонтейнерамВагонам.Видимость = Элементы.УслугиПоказыватьДанныеПоКонтейнерамВагонам.Пометка;
	
	ПолеСпособВводаУчетныхЕдиниц = ПоляТаблицыУслуг.Найти("СпособВводаУчетныхЕдиниц");
	ПолеКонтейнерыВагоны = ПоляТаблицыУслуг.Найти("КонтейнерыВагоны");

	Если ПолеСпособВводаУчетныхЕдиниц <> Неопределено Тогда
		Если ПараметрыВидаУслуг.ТипУчетныхЕдиницДетализации = "" Тогда
			Элементы.УслугиВставитьСписокВагоновИзExcel.Видимость = Истина;
			Элементы.УслугиВставитьСписокКТКИзExcel.Видимость = Истина;
			Элементы.УслугиДетализацияПоНомерамКТКВагонов.Доступность = Истина;
		ИначеЕсли ПараметрыВидаУслуг.ТипУчетныхЕдиницДетализации = "СправочникСсылка.ТЕ" Тогда
			Элементы.УслугиВставитьСписокВагоновИзExcel.Видимость = Ложь;
			Элементы.УслугиВставитьСписокКТКИзExcel.Видимость = Истина;
			Элементы.УслугиДетализацияПоНомерамКТКВагонов.Доступность = Истина;
		ИначеЕсли ПараметрыВидаУслуг.ТипУчетныхЕдиницДетализации = "СправочникСсылка.ТС" Тогда
			Элементы.УслугиВставитьСписокВагоновИзExcel.Видимость = Истина;
			Элементы.УслугиВставитьСписокКТКИзExcel.Видимость = Ложь;
			Элементы.УслугиДетализацияПоНомерамКТКВагонов.Доступность = Истина;
		КонецЕсли;
	Иначе
		Элементы.УслугиВставитьСписокВагоновИзExcel.Видимость = Ложь;
		Элементы.УслугиВставитьСписокКТКИзExcel.Видимость = Ложь;
		Элементы.УслугиДетализацияПоНомерамКТКВагонов.Доступность = Ложь;			
	КонецЕсли;
	
	Элементы.УслугиНомерСтроки.ФиксацияВТаблице = ФиксацияВТаблице.Лево;
	Элементы.УслугиНаименованиеНоменклатурыПоставщика.ФиксацияВТаблице = ФиксацияВТаблице.Лево;
	Элементы.УслугиНоменклатураПоставщика.ФиксацияВТаблице = ФиксацияВТаблице.Лево;
	Элементы.УслугиНоменклатура.ФиксацияВТаблице = ФиксацияВТаблице.Лево;
	
	Если ЗначениеЗаполнено(АдресКэшаНастроекПолейПоУмолчанию) Тогда
		АдресКэшаНастроекПолейПоУмолчанию = ПоместитьВоВременноеХранилище(НастройкиПолейПоУмолчанию, АдресКэшаНастроекПолейПоУмолчанию);
	Иначе
		АдресКэшаНастроекПолейПоУмолчанию = ПоместитьВоВременноеХранилище(НастройкиПолейПоУмолчанию, Новый УникальныйИдентификатор);
	КонецЕсли;
	
	
	РеквизитыФормы = ЭтаФорма.ПолучитьРеквизиты("Объект.Услуги");
	МассивУдаляемых = Новый Массив;
	Для Каждого РеквизитФормы Из РеквизитыФормы Цикл
		ИмяРеквизита = РеквизитФормы.Имя;	
		Если ДинамическиСозданныеПоляТаблицыУслуги.НайтиПоЗначению(ИмяРеквизита) <> Неопределено Тогда
			МассивУдаляемых.Добавить("Объект.Услуги." + ИмяРеквизита);
		КонецЕсли;
	КонецЦикла;
	ЭтаФорма.ИзменитьРеквизиты( , МассивУдаляемых);
	
	ДинамическиСозданныеПоляТаблицыУслуги.Очистить();
	
	МассивРеквизитов = Новый Массив;
	Для каждого Условие Из ДопУсловияОтборов Цикл
		НовыйРеквизит = Новый РеквизитФормы(Условие.Имя + "Обязательное", Новый ОписаниеТипов("Булево"), "Объект.Услуги", Условие.Имя + "Обязательное");
		МассивРеквизитов.Добавить(НовыйРеквизит);
		ДинамическиСозданныеПоляТаблицыУслуги.Добавить(Условие.Имя + "Обязательное");
		
		ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
		ЭлементОтбора = ЭлементУсловногоОформления .Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Услуги."+ Условие.Имя + "Обязательное");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 		
		ЭлементОтбора.ПравоеЗначение = Истина;
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора1 = ЭлементУсловногоОформления .Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора1.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Услуги."+ Условие.Имя);
		ЭлементОтбора1.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено; 		
		ЭлементОтбора1.Использование = Истина;
		ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного",Истина);
		ПолеОформления = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
		ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("Услуги" + Условие.Имя);
		ПолеОформления.Использование = Истина;
		
		
		ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
		ЭлементОтбора = ЭлементУсловногоОформления .Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Услуги." + Условие.Имя + "Обязательное");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 		
		ЭлементОтбора.ПравоеЗначение = Ложь;
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора1 = ЭлементУсловногоОформления .Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора1.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Услуги."+ Условие.Имя);
		ЭлементОтбора1.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено; 		
		ЭлементОтбора1.Использование = Истина;
		ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного",Ложь);
		ПолеОформления = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
		ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("Услуги" + Условие.Имя);
		ПолеОформления.Использование = Истина;
		
	КонецЦикла;	
	ЭтаФорма.ИзменитьРеквизиты(МассивРеквизитов);	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовГруппы(ГруппаЭлементов, Видимость, Исключения)
	
	ТипГруппаФормы = Тип("ГруппаФормы");
	
	Для Каждого Элемент Из ГруппаЭлементов.ПодчиненныеЭлементы Цикл
		
		Если Исключения.Найти(Элемент.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(Элемент) = ТипГруппаФормы Тогда
			УстановитьВидимостьЭлементовГруппы(Элемент, Видимость, Исключения);
		КонецЕсли;
		
		Элемент.Видимость = Видимость;
		
	КонецЦикла;
	
КонецПроцедуры

