&НаКлиенте
Процедура УслугиКонтейнерыНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	
	ТипУчетныхЕдиниц = ТекДанные.ТипУчетныхЕдиниц;
	УчетныеЕдиницы = Новый Массив;
	СтрокиУчетныхЕдиниц = Объект.УчетныеЕдиницы.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", ТекДанные.ИдентификаторСтрокиУслуг));
	Для Каждого СтрокаУчетнойЕдиницы Из СтрокиУчетныхЕдиниц Цикл
		УчетныеЕдиницы.Добавить(СтрокаУчетнойЕдиницы.УчетнаяЕдиница);
	КонецЦикла;
	
	ДопПараметры = Новый Структура("ИдентификаторСтрокиУслуг, ИдентификаторСтроки, Удалять", ТекДанные.ИдентификаторСтрокиУслуг, ТекДанные.ПолучитьИдентификатор(), Истина);
	ОповещениеОВыборе = Новый ОписаниеОповещения("ОбработкаВыбораУчетныхЕдиниц", ЭтаФорма, ДопПараметры);
	
	Если ТекДанные.СпособВводаУчетныхЕдиниц = ПредопределенноеЗначение("Перечисление.СпособыВводаУчетныхЕдиниц.Списком") Тогда
		
		Если ТипУчетныхЕдиниц = "СправочникСсылка.ТЕ" Тогда
			ПараметрыФормы = Новый Структура("ТЕ, СоставТЕ", Истина, УчетныеЕдиницы);
		ИначеЕсли ТипУчетныхЕдиниц = "СправочникСсылка.ТС" Тогда
			ПараметрыФормы = Новый Структура("ТС, СоставТС", Истина, УчетныеЕдиницы);
		КонецЕсли;			
		
		ОткрытьФорму("ОбщаяФорма.ОкноРедактированияСоставаУчетныхЕдиниц", ПараметрыФормы, ЭтаФорма, ЭтаФорма.УникальныйИдентификатор,,, ОповещениеОВыборе, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ИначеЕсли ТекДанные.СпособВводаУчетныхЕдиниц = ПредопределенноеЗначение("Перечисление.СпособыВводаУчетныхЕдиниц.Построчно") Тогда
		
		ПараметрыФормы = Новый Структура;
		Если ЗначениеЗаполнено(УчетныеЕдиницы) Тогда
			ПараметрыФормы.Вставить("Ключ", УчетныеЕдиницы[0]);
		КонецЕсли;
		
		Если ТипУчетныхЕдиниц = "СправочникСсылка.ТЕ" Тогда
			ОткрытьФорму("Справочник.ТЕ.ФормаВыбора", ПараметрыФормы, ЭтаФорма,,,, ОповещениеОВыборе, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		ИначеЕсли ТипУчетныхЕдиниц = "СправочникСсылка.ТС" Тогда
			ОткрытьФорму("Справочник.ТС.ФормаВыбора", ПараметрыФормы, ЭтаФорма,,,, ОповещениеОВыборе, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура УслугиВагоныНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
