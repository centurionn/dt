&НаСервере
Процедура УстановитьЗначениеПоляСостояниеГруженыйПорожний(СтрокаТЧ)
	
	СостояниеГруженый = ПредопределенноеЗначение("Перечисление.СостоянияКТК.Груженый");
	СостояниеПорожний = ПредопределенноеЗначение("Перечисление.СостоянияКТК.Порожний");
		
	Если СтрокаТЧ.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.АвтоперевозкаГруженыйКонтейнер") Тогда
		СтрокаТЧ.СостоянияГруженыйПорожний.Очистить();
		СтрокаТЧ.СостоянияГруженыйПорожний.Добавить(СостояниеГруженый);
	ИначеЕсли СтрокаТЧ.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.АвтоперевозкаПорожнийКонтейнер") Тогда
		СтрокаТЧ.СостоянияГруженыйПорожний.Очистить();
		СтрокаТЧ.СостоянияГруженыйПорожний.Добавить(СостояниеПорожний);
	ИначеЕсли СтрокаТЧ.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.ХранениеТерминалГруженыйКонтейнер") Тогда
		СтрокаТЧ.СостоянияГруженыйПорожний.Очистить();
		СтрокаТЧ.СостоянияГруженыйПорожний.Добавить(СостояниеГруженый);
	ИначеЕсли СтрокаТЧ.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.ХранениеТерминалПорожнийКонтейнер") Тогда
		СтрокаТЧ.СостоянияГруженыйПорожний.Очистить();
		СтрокаТЧ.СостоянияГруженыйПорожний.Добавить(СостояниеПорожний);
		//Евросиб Шевченко А.В. US 110216 TA 112376 07.08.2025	
	ИначеЕсли СтрокаТЧ.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.СНХранениеГруженогоКонтейнера") И Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Порты Тогда
		СтрокаТЧ.СостоянияГруженыйПорожний.Очистить();
		СтрокаТЧ.СостоянияГруженыйПорожний.Добавить(СостояниеГруженый);
	ИначеЕсли СтрокаТЧ.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.СНХранениеПорожнегоКонтейнера") И Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Порты Тогда
		СтрокаТЧ.СостоянияГруженыйПорожний.Очистить();
		СтрокаТЧ.СостоянияГруженыйПорожний.Добавить(СостояниеПорожний);	
	ИначеЕсли СтрокаТЧ.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.ХранениеПортГруженыйКонтейнер") И Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Порты Тогда
		СтрокаТЧ.СостоянияГруженыйПорожний.Очистить();
		СтрокаТЧ.СостоянияГруженыйПорожний.Добавить(СостояниеГруженый);
	ИначеЕсли СтрокаТЧ.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.ХранениеПортПорожнийКонтейнер") И Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Порты Тогда
		СтрокаТЧ.СостоянияГруженыйПорожний.Очистить();
		СтрокаТЧ.СостоянияГруженыйПорожний.Добавить(СостояниеПорожний);	
		//Евросиб Шевченко А.В. US 110216 TA 112376 07.08.2025	
	Иначе
		//Евросиб Шевченко А.В. US 110216 TA 112376 07.08.2025
		//Евросиб Шевченко А.В. US 110215 TA 120129 06.10.2025
		//Евросиб Шевченко А.В. US 86665 TA 120749 19.10.2025
