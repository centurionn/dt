Процедура ПересчетСтавкиПСвСутки(ТекСтрока,Имя) //Евросиб Шевченко А.В. US 125530 TA 125727 15.12.2025
	
	ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ТекСтрока);
	
	ЗначениеСтавкиНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСтавкуНДС(ТекДанные.СтавкаНДС);
	
	Если Имя = "СтоимостьСНДС" Тогда
		Если ЗначениеЗаполнено(ТекДанные.СтоимостьСНДС) И ЗначениеЗаполнено(ТекДанные.НормаПользования) Тогда
			ТекДанные.СтавкаЗаПСВСутСНДС = ТекДанные.СтоимостьСНДС / ТекДанные.НормаПользования;
		КонецЕсли;
		
		СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСуммуНДС(ТекДанные.СтавкаЗаПСВСутСНДС, ЗначениеСтавкиНДС, Истина, Истина);
		ТекДанные.СтавкаЗаПСВСутБезНДС = ТекДанные.СтавкаЗаПСВСутСНДС - СуммаНДС;
		
	КонецЕсли;	
	
	Если Имя = "СтоимостьБезНДС" Тогда
		Если ЗначениеЗаполнено(ТекДанные.СтоимостьБезНДС) И ЗначениеЗаполнено(ТекДанные.НормаПользования) Тогда
			ТекДанные.СтавкаЗаПСВСутБезНДС = ТекДанные.СтоимостьБезНДС / ТекДанные.НормаПользования
		КонецЕсли;
		
		СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСуммуНДС(ТекДанные.СтавкаЗаПСВСутБезНДС, ЗначениеСтавкиНДС, Истина, Ложь);
		ТекДанные.СтавкаЗаПСВСутСНДС = ТекДанные.СтавкаЗаПСВСутБезНДС + СуммаНДС;
		
	КонецЕсли;
	
	Если Имя = "НормаПользования" Тогда
		Если ЗначениеЗаполнено(ТекДанные.СтоимостьСНДС) И ЗначениеЗаполнено(ТекДанные.НормаПользования) Тогда
			ТекДанные.СтавкаЗаПСВСутСНДС = ТекДанные.СтоимостьСНДС / ТекДанные.НормаПользования;	
			СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСуммуНДС(ТекДанные.СтавкаЗаПСВСутСНДС, ЗначениеСтавкиНДС, Истина, Истина);
			ТекДанные.СтавкаЗаПСВСутБезНДС = ТекДанные.СтавкаЗаПСВСутСНДС - СуммаНДС;
		ИначеЕсли ЗначениеЗаполнено(ТекДанные.СтоимостьБезНДС) И ЗначениеЗаполнено(ТекДанные.НормаПользования) Тогда
			ТекДанные.СтавкаЗаПСВСутБезНДС = ТекДанные.СтоимостьБезНДС / ТекДанные.НормаПользования;		
			СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСуммуНДС(ТекДанные.СтавкаЗаПСВСутБезНДС, ЗначениеСтавкиНДС, Истина, Ложь);
			ТекДанные.СтавкаЗаПСВСутСНДС = ТекДанные.СтавкаЗаПСВСутБезНДС + СуммаНДС;	
		КонецЕсли;
		
	КонецЕсли;	
	
