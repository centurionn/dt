Процедура ОбработкаВыбораУчетныхЕдиниц(УчетныеЕдиницы, ДополнительныеПараметры) Экспорт
	
	Если УчетныеЕдиницы <> Неопределено Тогда
		Удалять = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеПараметры, "Удалять", Ложь);
		СоздатьСтрокиТаблицыПоУчетнымЕдиницам(ДополнительныеПараметры.ИдентификаторСтроки, УчетныеЕдиницы, Удалять);
		ТекДанныеУслуги = Объект.Услуги.НайтиПоИдентификатору(ДополнительныеПараметры.ИдентификаторСтроки);
		УстановитьВидимостьДоступностьЭлементовДетализацииПоУчетнымЕдиницам(ТекДанныеУслуги);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьСтрокиТаблицыПоУчетнымЕдиницам(ИдентификаторСтроки, ВыбранныеУчетныеЕдиницы, Удалять = Ложь)
	
	Модифицированность = Истина;
	
	ТекДанныеУслуги = Объект.Услуги.НайтиПоИдентификатору(ИдентификаторСтроки);	
	Если ТипЗнч(ВыбранныеУчетныеЕдиницы) = Тип("Массив") Тогда
		УчетныеЕдиницы = ВыбранныеУчетныеЕдиницы;
	Иначе
		УчетныеЕдиницы = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВыбранныеУчетныеЕдиницы);
	КонецЕсли;
	
	СтрокиКУдалению = Новый Массив;
	СтрокиУчетныхЕдиниц = Объект.УчетныеЕдиницы.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", ТекДанныеУслуги.ИдентификаторСтрокиУслуг));
	Для Каждого СтрокаУчетнойЕдиницы Из СтрокиУчетныхЕдиниц Цикл
		//Объект.УчетныеЕдиницы.Удалить(СтрокаУчетнойЕдиницы);
		ИндексНайденнойУчетнойЕдиницы = УчетныеЕдиницы.Найти(СтрокаУчетнойЕдиницы.УчетнаяЕдиница);
		Если ИндексНайденнойУчетнойЕдиницы = Неопределено Тогда
			Если Удалять Тогда
				СтрокиКУдалению.Добавить(СтрокаУчетнойЕдиницы);
			КонецЕсли;
		Иначе
			УчетныеЕдиницы.Удалить(ИндексНайденнойУчетнойЕдиницы);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Стр Из СтрокиКУдалению Цикл
		Объект.УчетныеЕдиницы.Удалить(Стр);
	КонецЦикла;
	
	Для Каждого УчетнаяЕдиница Из УчетныеЕдиницы Цикл
		Если ЗначениеЗаполнено(УчетнаяЕдиница) Тогда
			СтрокаУчетнойЕдиницы = Объект.УчетныеЕдиницы.Добавить();
			СтрокаУчетнойЕдиницы.ИдентификаторСтрокиУслуг = ТекДанныеУслуги.ИдентификаторСтрокиУслуг;
			СтрокаУчетнойЕдиницы.УчетнаяЕдиница = УчетнаяЕдиница;
		КонецЕсли;
	КонецЦикла;			
	ОбновитьПредставлениеУчетныхЕдиницСтрокиУслуг(ТекДанныеУслуги);
		
КонецПроцедуры

