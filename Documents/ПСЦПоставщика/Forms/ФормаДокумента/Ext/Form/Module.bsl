Процедура РассчитатьСуммуПоСтрокамДетализацииКомплекснойСтавки(ТекДанныеУслуги)
	
	СуммаПоСтрокам = 0;
	
	Если ТекДанныеУслуги <> Неопределено Тогда
		СтрокиДетализации = Объект.ДетализацияКомплекснойСтавки.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", ТекДанныеУслуги.ИдентификаторСтрокиУслуг));
		Для Каждого СтрокаДетализации Из СтрокиДетализации Цикл
			СуммаПоСтрокам = СуммаПоСтрокам + СтрокаДетализации.ПроцентОтСтавки;
		КонецЦикла;
	КонецЕсли;
	
	Элементы.ДетализацияКомплекснойСтавкиПроцентОтСтавки.ТекстПодвала = СтрШаблон("Итого (%%): %1", Формат(СуммаПоСтрокам, "ЧДЦ=3; ЧН=0,000"));
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиАдресСкладаПогрузкиВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	
	ТипАдрес = Тип("СправочникСсылка.АдресаВНаселенныхПунктах");
	ТипМультиадрес = Тип("СправочникСсылка.Мультиадреса");
	
	Если ТекДанные.АдресСкладаПогрузкиВыгрузки = Неопределено Тогда
		
		ИдентификаторТекСтроки = ТекДанные.ПолучитьИдентификатор();
		
		СписокТипов = новый СписокЗначений;
		
		ДоступныеТипы = Элементы.УслугиАдресСкладаПогрузкиВыгрузки.ОграничениеТипа.Типы();
		Если ЗначениеЗаполнено(ДоступныеТипы) Тогда
			СписокТипов.ЗагрузитьЗначения(ДоступныеТипы);
		Иначе
			СписокТипов.Добавить(ТипАдрес);
			СписокТипов.Добавить(ТипМультиадрес);
		КонецЕсли;
	
		Если СписокТипов.Количество() > 1 Тогда
			
			СтандартнаяОбработка = Ложь;
			
			ДопПараметры = Новый Структура("ИдентификаторТекСтроки", ИдентификаторТекСтроки);
			ОповещениеОВыборе = Новый ОписаниеОповещения("УслугиАдресСкладаПогрузкиВыгрузкиОбработкаВыбораТипа", ЭтаФорма, ДопПараметры);
			
			СписокТипов.ПоказатьВыборЭлемента(ОповещениеОВыборе, "Выбор типа данных");
			
		ИначеЕсли СписокТипов.Количество() = 1 Тогда
			
			Если СписокТипов[0].Значение = ТипМультиадрес Тогда
				ТекДанные.АдресСкладаПогрузкиВыгрузки = ПредопределенноеЗначение("Справочник.Мультиадреса.ПустаяСсылка");
			ИначеЕсли СписокТипов[0].Значение = ТипАдрес Тогда
				ТекДанные.АдресСкладаПогрузкиВыгрузки = ПредопределенноеЗначение("Справочник.АдресаВНаселенныхПунктах.ПустаяСсылка");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(ТекДанные.АдресСкладаПогрузкиВыгрузки) = ТипАдрес Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
		ПараметрыФормы.Вставить("ПоказыватьВыборАдреса", Истина);
		
		ТипыЛокацийМассив = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПредопределенноеЗначение("Справочник.ТипыЛокаций.АдресВНаселенномПункте"));	
		ПараметрыОтбора = Новый Структура("Тип", ТипыЛокацийМассив);
		ПараметрыФормы.Вставить("Отбор", ПараметрыОтбора);
		
		ОткрытьФорму("Справочник.Локации.ФормаВыбора", ПараметрыФормы, Элемент, ЭтаФорма.УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиАдресСкладаПогрузкиВыгрузкиОбработкаВыбораТипа(ВыбранныйТип, ДопПараметры) Экспорт
	
	Если ВыбранныйТип <> Неопределено Тогда
		
		ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ДопПараметры.ИдентификаторТекСтроки);
		Если ВыбранныйТип.Значение = Тип("СправочникСсылка.Мультиадреса") Тогда
			ТекДанные.АдресСкладаПогрузкиВыгрузки = ПредопределенноеЗначение("Справочник.Мультиадреса.ПустаяСсылка");
		Иначе
			ТекДанные.АдресСкладаПогрузкиВыгрузки = ПредопределенноеЗначение("Справочник.АдресаВНаселенныхПунктах.ПустаяСсылка");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

