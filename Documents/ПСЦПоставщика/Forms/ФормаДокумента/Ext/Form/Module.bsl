КонецПроцедуры


&НаКлиенте
Процедура СписокУчетныхЕдиницПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	ТекДанныеУслуги = Элементы.Услуги.ТекущиеДанные;
	
	Если ТекДанныеУслуги <> Неопределено Тогда
		Если ТекДанныеУслуги.СпособВводаУчетныхЕдиниц = ПредопределенноеЗначение("Перечисление.СпособыВводаУчетныхЕдиниц.Списком") Тогда
			//Для ввода списка доступна одна строка
			СтрокиСписка = СписокУчетныхЕдиниц.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", ТекДанныеУслуги.ИдентификаторСтрокиУслуг));
			Если ЗначениеЗаполнено(СтрокиСписка) Тогда
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокУчетныхЕдиницПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		ТекДанныеУслуги = Элементы.Услуги.ТекущиеДанные;
		
		ТекДанные = Элементы.СписокУчетныхЕдиниц.ТекущиеДанные;
		ТекДанные.ИдентификаторСтрокиТаблицыУчЕдиниц = -1;
		
		ТекДанные.ИдентификаторСтрокиУслуг = ТекДанныеУслуги.ИдентификаторСтрокиУслуг;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДетализацияКомплекснойСтавкиПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ТекДанные = Элементы.ДетализацияКомплекснойСтавки.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		Если Не ЗначениеЗаполнено(ТекДанные.НоменклатураПоставщика) И Не ЗначениеЗаполнено(ТекДанные.Номенклатура) И Не ЗначениеЗаполнено(ТекДанные.ПроцентОтСтавки) Тогда
			Объект.ДетализацияКомплекснойСтавки.Удалить(ТекДанные);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиПередУдалением(Элемент, Отказ)
	
	ВыделенныеСтроки = Элементы.Услуги.ВыделенныеСтроки;
	УслугиПередУдалениемСервер(ВыделенныеСтроки);
	
КонецПроцедуры

&НаСервере
Процедура УслугиПередУдалениемСервер(ВыделенныеСтроки)
	
	Для Каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
		
		ДанныеСтрокиУслуг = Объект.Услуги.НайтиПоИдентификатору(ИдентификаторСтроки);		
		СтруктураПоиска = Новый Структура("ИдентификаторСтрокиУслуг", ДанныеСтрокиУслуг.ИдентификаторСтрокиУслуг);
		
		УдаляемыеСтроки = Объект.КритерииУслуг.НайтиСтроки(СтруктураПоиска);
		Для Каждого Стр из УдаляемыеСтроки Цикл
			Объект.КритерииУслуг.Удалить(Стр);
		КонецЦикла;
		
		УдаляемыеСтроки = Объект.ДетализацияКомплекснойСтавки.НайтиСтроки(СтруктураПоиска);
		Для Каждого Стр Из УдаляемыеСтроки Цикл
			Объект.ДетализацияКомплекснойСтавки.Удалить(Стр);
		КонецЦикла;
	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТиповойПриИзменении(Элемент)
	
	Элементы.МакетПечатнойФормыПротокола.Видимость = Объект.Типовой;
	ЗаполнитьНаименованияПодписей();
	
	//Евросиб Коханенко Н.А. 27.03.2025 (( #102319
	УстановитьВидимостьКомандПечати();
	//Евросиб Коханенко Н.А. 27.03.2025 )) #102319 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаименованияПодписей()
	
	Если Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Контейнеры И Объект.Типовой Тогда
		Объект.НаименованиеПодписиКонтрагента = Справочники.НаименованияПодписей.Исполнитель;
		Объект.НаименованиеПодписи = Справочники.НаименованияПодписей.Клиент;
	Иначе
		РеквизитыДоговора = Справочники.ДоговорыКонтрагентов.ПолучитьЗначенияРеквизитовДоговораПоУмолчанию(Объект.Договор);
		Объект.НаименованиеПодписиКонтрагента = РеквизитыДоговора.НаименованиеСтороны;
		Объект.НаименованиеПодписи = РеквизитыДоговора.НаименованиеCтороныЕвросиб;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиОсобыйТемпературныйРежимПриИзменении(Элемент)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	ОбработатьИзмененияПризнакаОсобыйТемпературныйРежим(ТекДанные);
	
	Если ЗаполнятьВниз Тогда
		ВыполнитьЗаполнениеВниз(Элемент);
	Иначе
		УстановитьВидимостьГруппыПоЗначениюПоля(Объект.Услуги, Элементы.УслугиОсобыйТемпературныйРежимЗначение, "ОсобыйТемпературныйРежим");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбработатьИзмененияПризнакаОсобыйТемпературныйРежим(СтрокаТЧ)
	
	Если Не СтрокаТЧ.ОсобыйТемпературныйРежим Тогда
		СтрокаТЧ.ОсобыйТемпературныйРежимЗначение = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДоверенностьУказываетсяВручнуюПриИзменении(Элемент)
	
	Если Объект.ДоверенностьУказываетсяВручную Тогда
		Элементы.ДоверенностьЗаРуководителя.ТолькоПросмотр = Ложь;
	Иначе
		Элементы.ДоверенностьЗаРуководителя.ТолькоПросмотр = Истина;
		ЗаполнитьДоверенностьЗаРуководителя();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДоверенностьЗаРуководителя()
	
	Если Не Объект.ДоверенностьУказываетсяВручную Тогда
		ДатаДоверенности = ?(ЗначениеЗаполнено(Объект.ДатаПСЦ), Объект.ДатаПСЦ, ТекущаяДата());
		Объект.ДоверенностьЗаРуководителя = Документы.ПСЦПоставщика.ПолучитьДоверенностьДиректораПоПроизводству(ДатаДоверенности);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиПунктОтправленияНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	
	Если ТекДанные.ПунктОтправления = Неопределено Тогда
		
		ИдентификаторТекСтроки = ТекДанные.ПолучитьИдентификатор();
		
		СписокТипов = новый СписокЗначений;
		
		ДоступныеТипы = Элементы.УслугиПунктОтправления.ОграничениеТипа.Типы();
		Если ЗначениеЗаполнено(ДоступныеТипы) Тогда
			СписокТипов.ЗагрузитьЗначения(ДоступныеТипы);
		Иначе
			СписокТипов.Добавить(Тип("СправочникСсылка.Локации"));
			СписокТипов.Добавить(Тип("СправочникСсылка.Мультилокации"));
		КонецЕсли;
	
		Если СписокТипов.Количество() > 1 Тогда
			
			СтандартнаяОбработка = Ложь;
			
			ДопПараметры = Новый Структура("ИдентификаторТекСтроки", ИдентификаторТекСтроки);
			ОповещениеОВыборе = Новый ОписаниеОповещения("УслугиПунктОтправленияОбработкаВыбораТипа", ЭтаФорма, ДопПараметры);
			
			СписокТипов.ПоказатьВыборЭлемента(ОповещениеОВыборе, "Выбор типа данных");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиПунктОтправленияОбработкаВыбораТипа(ВыбранныйТип, ДопПараметры) Экспорт
	
	Если ВыбранныйТип <> Неопределено Тогда
		
		ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ДопПараметры.ИдентификаторТекСтроки);
		Если ВыбранныйТип.Значение = Тип("СправочникСсылка.Мультилокации") Тогда
			ТекДанные.ПунктОтправления = ПредопределенноеЗначение("Справочник.Мультилокации.ПустаяСсылка");
		Иначе
			ТекДанные.ПунктОтправления = ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиПунктОтправленияОчистка(Элемент, СтандартнаяОбработка)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;		
	ТекДанные.ПунктОтправления = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиПунктНазначенияНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	
	Если ТекДанные.ПунктНазначения = Неопределено Тогда
		
		ИдентификаторТекСтроки = ТекДанные.ПолучитьИдентификатор();
		
		СписокТипов = новый СписокЗначений;
		
		ДоступныеТипы = Элементы.УслугиПунктОтправления.ОграничениеТипа.Типы();
		Если ЗначениеЗаполнено(ДоступныеТипы) Тогда
			СписокТипов.ЗагрузитьЗначения(ДоступныеТипы);
		Иначе
			СписокТипов.Добавить(Тип("СправочникСсылка.Локации"));
			СписокТипов.Добавить(Тип("СправочникСсылка.Мультилокации"));
		КонецЕсли;
	
		Если СписокТипов.Количество() > 1 Тогда
			
			СтандартнаяОбработка = Ложь;
			
			ДопПараметры = Новый Структура("ИдентификаторТекСтроки, ИмяПоля", ИдентификаторТекСтроки, "ПунктНазначения");
			ОповещениеОВыборе = Новый ОписаниеОповещения("ОбработкаВыбораТипаПоляЛокации", ЭтаФорма, ДопПараметры);
			
			СписокТипов.ПоказатьВыборЭлемента(ОповещениеОВыборе, "Выбор типа данных");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораТипаПоляЛокации(ВыбранныйТип, ДопПараметры) Экспорт
	
	Если ВыбранныйТип <> Неопределено Тогда
		
		ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ДопПараметры.ИдентификаторТекСтроки);
		ИмяПоля = ДопПараметры.ИмяПоля;
		Если ВыбранныйТип.Значение = Тип("СправочникСсылка.Мультилокации") Тогда
			ТекДанные[ИмяПоля] = ПредопределенноеЗначение("Справочник.Мультилокации.ПустаяСсылка");
		Иначе
			ТекДанные[ИмяПоля] = ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиПунктНазначенияОчистка(Элемент, СтандартнаяОбработка)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;		
	ТекДанные.ПунктНазначения = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиНормативыПриИзменении(Элемент)
	
	ТекСтрока = Элементы.Услуги.ТекущаяСтрока;
	УслугиНормативыПриИзмененииСервер(ТекСтрока);
	
	Если ЗаполнятьВниз Тогда
		ВыполнитьЗаполнениеВниз(Элемент);
	Иначе
		УстановитьВидимостьГруппПоНормативам();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УслугиНормативыПриИзмененииСервер(ТекСтрока)
	
	ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ТекСтрока);
	ОбработатьИзменениеПризнакаНормативыВСтроке(ТекДанные);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменениеПризнакаНормативыВСтроке(ТекСтрока)
	//Евросиб Шевченко А.В. US 86665 TA 120749 19.10.2025
	Если Не ТекСтрока.Нормативы И НЕ Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.ТЭО Тогда
		ТекСтрока.НормаЗагрузкиКТК = Неопределено;
		ТекСтрока.НормаПользования = Неопределено;
		ТекСтрока.НормативНахожденияНаПогрузке = Неопределено;
		ТекСтрока.НормативНахожденияНаВыгрузке = Неопределено;
		ТекСтрока.НормаВремениНаПогрузкуВыгрузку = Неопределено;
		ТекСтрока.СвободныйПериодХраненияПриОтправке = 0;
		ТекСтрока.СвободныйПериодХраненияПриПриеме = 0;
		ТекСтрока.СвободныйПериодХраненияУслугиДепо = 0;
		
		//УстановитьЗначениеПоляСостояниеГруженыйПорожний(ТекСтрока);
		ОбработатьИзменениеПериодаХраненияВСтроке(ТекСтрока, Ложь);
		
	КонецЕсли;
	//Евросиб Шевченко А.В. US 86665 TA 120749 19.10.2025
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьГруппыПоЗначениюПоля(Услуги, Группа, ИмяПоля)
	
	НайденныеСтроки = Услуги.НайтиСтроки(Новый Структура(ИмяПоля, Истина));
	Если НайденныеСтроки.Количество() > 0 Тогда
		Группа.Видимость = Истина;
	Иначе
		Группа.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьГруппПоНормативам()
	
	НайденныеСтроки = Объект.Услуги.НайтиСтроки(Новый Структура("Нормативы", Истина));
	Если НайденныеСтроки.Количество() > 0 Тогда
		Элементы.УслугиГруппаНормативыПараметры.Видимость = Истина;
		Элементы.УслугиГруппаСвободныйПериодХранения.Видимость = Истина;
	Иначе
		Элементы.УслугиГруппаНормативыПараметры.Видимость = Ложь;
		Элементы.УслугиГруппаСвободныйПериодХранения.Видимость = Ложь;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиНормаВремениНаПогрузкуВыгрузкуПриИзменении(Элемент)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	ОбработатьИзменениеНормыВремениНаПогрузкуВыгрузку(ТекДанные);
	
	Если ЗаполнятьВниз Тогда
		ВыполнитьЗаполнениеВниз(Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбработатьИзменениеНормыВремениНаПогрузкуВыгрузку(ТекДанные)
	
	Строки = СтрРазделить(ТекДанные.НормаВремениНаПогрузкуВыгрузку, ":");
	Часов = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Строки[0]);
	Если Строки.Количество() > 1 Тогда
		Минут = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Строки[1]);
	Иначе
		Минут = 0;
	КонецЕсли;
	ТекДанные.НормаВремениНаПогрузкуВыгрузку = ПолучитьЧасыМинутыНормыВремениСтрокой(Часов, Минут);
	
	Строки = СтрРазделить(ТекДанные.НормаВремениНаПогрузкуВыгрузку, ":");
	Часов = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Строки[0]);	
	Если Строки.Количество() > 1 Тогда
		Минут = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Строки[1]);
	Иначе
		Минут = 0;
	КонецЕсли;
			
	ДробнаяЧасть = Окр(Минут / 60, 2);	
	НормативЧисло = Часов + ДробнаяЧасть;
	
	ТекДанные.НормативНахожденияНаПогрузке = НормативЧисло;
	ТекДанные.НормативНахожденияНаВыгрузке = НормативЧисло;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьЧасыМинутыНормыВремениСтрокой(Часов, Минут)
	
	Если Часов > 0 Или Минут > 0 Тогда
		
		Если Часов < 100 Тогда
			ЧасыСтрокой = Формат(Часов, "ЧЦ=2; ЧН=00; ЧВН=");
		Иначе
			ЧасыСтрокой = 100;
		КонецЕсли;
		
		Пока СтрДлина(ЧасыСтрокой) < 3 Цикл
			ЧасыСтрокой = " " + ЧасыСтрокой;
		КонецЦикла;
		
		Если Минут = 0 Или Минут = 30 Тогда
			МинутыСтрокой = Формат(Минут, "ЧЦ=2; ЧН=00; ЧВН=");
		Иначе
			МинутыСтрокой = "30";
		КонецЕсли;
		
		ЧасыМинутыСтрокой = СтрШаблон("%1:%2", ЧасыСтрокой, МинутыСтрокой);
		
	Иначе
		
		ЧасыМинутыСтрокой = "";
		
	КонецЕсли;
	
	Возврат ЧасыМинутыСтрокой;
		
КонецФункции

&НаКлиенте
Процедура УслугиНормаВремениНаПогрузкуВыгрузкуРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	СтрокаУслуги = Элементы.Услуги.ТекущиеДанные;
	НовоеЗначение = СтрокаУслуги.НормативНахожденияНаПогрузке + 0.5 * Направление;
	
	Если НовоеЗначение >= 0 И НовоеЗначение < 101 Тогда
		СтрокаУслуги.НормативНахожденияНаПогрузке = НовоеЗначение;
		СтрокаУслуги.НормативНахожденияНаВыгрузке = НовоеЗначение;
		Часов = Цел(СтрокаУслуги.НормативНахожденияНаПогрузке);
		Минут = СтрокаУслуги.НормативНахожденияНаПогрузке - Часов;
		ЧасыМинутыСтрокой = ПолучитьЧасыМинутыНормыВремениСтрокой(Часов, Минут);
		СтрокаУслуги.НормаВремениНаПогрузкуВыгрузку = ЧасыМинутыСтрокой;
	КонецЕсли;
	
	Если ЗаполнятьВниз Тогда
		ВыполнитьЗаполнениеВниз(Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиНаименованиеНоменклатурыПоставщикаПриИзменении(Элемент)
	
	Если ЗаполнятьВниз Тогда
