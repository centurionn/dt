			Терминал = ТерминалыПортыЖДСтанции.Скопировать(Новый Структура("ПортЖДСтанция", Пункт), "Локация");
			Терминал = Терминал.ВыгрузитьКолонку("Локация");
			Если Терминал.Количество() Тогда
				Возврат Терминал[0];
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	
	Если ТипЗнч(Пункт) = Тип("СправочникСсылка.Локации") Тогда
		Если Пункт.Тип = Справочники.ТипыЛокаций.Порт ИЛИ Пункт.Тип = Справочники.ТипыЛокаций.СтанцияЖД Тогда
			Терминал = ТерминалыПортыЖДСтанции.Скопировать(Новый Структура("ПортЖДСтанция", Пункт), "Локация");
