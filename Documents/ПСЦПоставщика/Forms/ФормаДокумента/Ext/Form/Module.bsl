Функция ПолучитьСписокКласовОпасности()
	
	мКлассы = Новый Массив;

	мКлассы.Добавить(Перечисления.КлассОпасностиГруза.Первый);
    мКлассы.Добавить(Перечисления.КлассОпасностиГруза.Второй);
	мКлассы.Добавить(Перечисления.КлассОпасностиГруза.Третий);
	мКлассы.Добавить(Перечисления.КлассОпасностиГруза.Четвертый);
	мКлассы.Добавить(Перечисления.КлассОпасностиГруза.Пятый);
	мКлассы.Добавить(Перечисления.КлассОпасностиГруза.Шестой);
