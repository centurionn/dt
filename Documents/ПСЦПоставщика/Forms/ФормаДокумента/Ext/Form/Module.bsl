&НаСервереБезКонтекста
Функция ПолучитьКлючЗаписиРуководителяКонтрагента(Контрагент, Руководитель, Период)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеРуководителяКонтрагентовСрезПоследних.Период КАК Период,
	|	ДанныеРуководителяКонтрагентовСрезПоследних.Контрагент КАК Контрагент
	|ИЗ
	|	РегистрСведений.ДанныеРуководителяКонтрагентов.СрезПоследних(
	|			&Период,
	|			Контрагент = &Контрагент
	|				И Руководитель = &Руководитель) КАК ДанныеРуководителяКонтрагентовСрезПоследних";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Руководитель", Руководитель);
	Запрос.УстановитьПараметр("Период", Период);
		
	Выборка = Запрос.Выполнить().Выбрать();	
	Если Выборка.Следующий() Тогда
		СтруктураКлюча = Новый Структура("Период, Контрагент");
		ЗаполнитьЗначенияСвойств(СтруктураКлюча, Выборка);
		КлючЗаписи = РегистрыСведений.ДанныеРуководителяКонтрагентов.СоздатьКлючЗаписи(СтруктураКлюча);
	Иначе
		КлючЗаписи = Неопределено;
	КонецЕсли;
	
	Возврат КлючЗаписи;
	
КонецФункции

