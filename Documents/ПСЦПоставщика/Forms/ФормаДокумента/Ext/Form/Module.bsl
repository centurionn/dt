&НаКлиенте
Процедура УслугиГрузТНВЭДПриИзменении(Элемент)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	ТекСтрока = Элементы.Услуги.ТекущаяСтрока;
	Если ЗначениеЗаполнено(ТекДанные.ГрузТНВЭД) Тогда
		ТекДанные.КодТНВЭД = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(ТекДанные.ГрузТНВЭД, "ТНВЭД");
	Иначе
		ТекДанные.КодТНВЭД = "";
	КонецЕсли;
	
	Если ЗаполнятьВниз Тогда
		ВыполнитьЗаполнениеВниз(Элемент);
	КонецЕсли;
	
	УслугиГрузТНВЭДПриИзмененииСервер(ТекСтрока);
	
КонецПроцедуры

&НаСервере
Процедура УслугиГрузТНВЭДПриИзмененииСервер(ТекСтрока)
	ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ТекСтрока);
	УстановитьПризнакИзмененияГруза(ТекДанные);
	УстановитьЗначениеПоляСостояниеГруженыйПорожний(ТекДанные);
КонецПроцедуры	

&НаКлиенте
Процедура УслугиКодТНВЭДПриИзменении(Элемент)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	ТекСтрока = Элементы.Услуги.ТекущаяСтрока;
	Если ЗначениеЗаполнено(ТекДанные.КодТНВЭД) Тогда
		Груз = НайтиГрузТНВЭД(ТекДанные.КодТНВЭД);
		Если ЗначениеЗаполнено(Груз) Тогда
			ТекДанные.ГрузТНВЭД = Груз;
		КонецЕсли;	
	Иначе
		ТекДанные.ГрузТНВЭД = ПредопределенноеЗначение("Справочник.ГрузыПоТНВЭД.ПустаяСсылка");	
	КонецЕсли;
	
	Если ЗаполнятьВниз Тогда
		ВыполнитьЗаполнениеВниз(Элемент);
	КонецЕсли;
	
	УслугиГрузТНВЭДПриИзмененииСервер(ТекСтрока);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиГрузТНВЭД(КодТНВЭД)
	
	Груз = Справочники.ГрузыПоТНВЭД.НайтиПоРеквизиту("ТНВЭД", КодТНВЭД);
	Возврат Груз;
	
КонецФункции


&НаКлиенте
Процедура СканДоверенностиНаПодписантаКонтрагентаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;	
	ПараметрыФормы.Вставить("ВладелецФайла", Объект.РуководительКонтрагента);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	
	ОткрытьФорму("Обработка.РаботаСФайлами.Форма.ПрисоединенныеФайлы", ПараметрыФормы, Элемент,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВсехРуководителейКонтрагента(Контрагент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ДанныеРуководителяКонтрагентов.Руководитель КАК Руководитель
	               |ИЗ
	               |	РегистрСведений.ДанныеРуководителяКонтрагентов КАК ДанныеРуководителяКонтрагентов
	               |ГДЕ
	               |	ДанныеРуководителяКонтрагентов.Контрагент = &Контрагент
	               |	И НЕ ДанныеРуководителяКонтрагентов.Руководитель.ПометкаУдаления";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Руководитель");
	
КонецФункции

&НаКлиенте
Процедура УслугиПунктОтправленияПриИзменении(Элемент)
	
	ТекСтрока = Элементы.Услуги.ТекущаяСтрока;
	УслугиПунктОтправленияПриИзмененииСервер(ТекСтрока);
	
	Если ЗаполнятьВниз Тогда
		ВыполнитьЗаполнениеВниз(Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УслугиПунктОтправленияПриИзмененииСервер(ТекСтрока)
	
	ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ТекСтрока);	
	ОбработатьИзменениеПунктаОтправленияВСтроке(ТекДанные);
	
	Если Не ЗначениеЗаполнено(ТекДанные.ПунктОтправления) Тогда
		ЛокацияПустаяСсылка = Справочники.Локации.ПустаяСсылка();
		ТекДанные.ПунктОтправленияГород = ЛокацияПустаяСсылка;
		ТекДанные.ПунктОтправленияСтрана = ЛокацияПустаяСсылка;
	КонецЕсли;
	
	ОбновитьДинамическиеПоляТаблицыУслугПоСтроке(ТекДанные);
	//Евросиб Шевченко А.В. US 86665 TA 120749 19.10.2025
	Если Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.ТЭО Тогда
		ПолучитьПортыИЖДСтанции(ТекДанные);
	КонецЕсли;	
	//Евросиб Шевченко А.В. US 86665 TA 120749 19.10.2025
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменениеПунктаОтправленияВСтроке(ТекДанные)
	
	ДанныеЛокации = Новый Структура;
	ПоляТаблицыУслуг = ПараметрыВидаУслуг.ПоляТаблицыУслуг;				
	
	Если ЗначениеЗаполнено(ТекДанные.ПунктОтправления) Тогда
		
		ОписаниеПоля = ПоляТаблицыУслуг.Получить("АдресТерминалаВыдачиПостановкиКТК");	
		Если ОписаниеПоля <> Неопределено Тогда
			ДанныеЛокации.Вставить("Адрес");
		КонецЕсли;
		
		ОписаниеПоляГород = ПоляТаблицыУслуг.Получить("ПунктОтправленияГород");
		Если ОписаниеПоляГород <> Неопределено Тогда
			ДанныеЛокации.Вставить("Город");
		КонецЕсли;
		
		ОписаниеПоляСтрана = ПоляТаблицыУслуг.Получить("ПунктОтправленияСтрана");
		Если ОписаниеПоляСтрана <> Неопределено Тогда
			ДанныеЛокации.Вставить("Страна");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеЛокации) Тогда
			
			ПолучитьДопДанныеЛокации(ТекДанные.ПунктОтправления, ДанныеЛокации);
			Если ДанныеЛокации.Свойство("Адрес") Тогда
				ТекДанные.АдресТерминалаВыдачиПостановкиКТК = ДанныеЛокации.Адрес;
			КонецЕсли;		
			Если ДанныеЛокации.Свойство("Город") Тогда
				ТекДанные.ПунктОтправленияГород = ДанныеЛокации.Город;
			КонецЕсли;
			Если ДанныеЛокации.Свойство("Страна") Тогда
				ТекДанные.ПунктОтправленияСтрана = ДанныеЛокации.Страна;
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		ТекДанные.АдресТерминалаВыдачиПостановкиКТК = Неопределено;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьДопДанныеЛокации(Локация, ДанныеЛокации) 

	Если ЗначениеЗаполнено(Локация) Тогда
		
		Если ТипЗнч(Локация) = Тип("СправочникСсылка.Локации") Тогда
			
			Если ДанныеЛокации.Свойство("Адрес") Тогда
				ДанныеЛокации.Адрес = ОбщегоНазначенияВызовСервера.ЗначениеРеквизитаОбъекта(Локация, "Адрес");
			КонецЕсли;		
			Если ДанныеЛокации.Свойство("Город") Тогда
				ДанныеЛокации.Город = ПолучитьЛокациюВышестоящегоУровня(Локация, Перечисления.ТипыИерархииЛокации.НаселенныйПункт);
			КонецЕсли;
			Если ДанныеЛокации.Свойство("Страна") Тогда
				ДанныеЛокации.Страна = ПолучитьЛокациюВышестоящегоУровня(Локация, Перечисления.ТипыИерархииЛокации.Страна);
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(Локация) = Тип("СправочникСсылка.Мультилокации") Тогда
			
			Если ДанныеЛокации.Свойство("Город") Тогда				
				Города = ПолучитьЛокацииВышестоящегоУровняПоМультилокации(Локация, Перечисления.ТипыИерархииЛокации.НаселенныйПункт);
				Если Города.Количество() = 1 Тогда
					ДанныеЛокации.Город = Города[0];
				Иначе
					ДанныеЛокации.Город = Справочники.Локации.ПустаяСсылка();
				КонецЕсли;
			КонецЕсли;
			
			Если ДанныеЛокации.Свойство("Страна") Тогда
				Страны = ПолучитьЛокацииВышестоящегоУровняПоМультилокации(Локация, Перечисления.ТипыИерархииЛокации.Страна);
				Если Страны.Количество() = 1 Тогда
					ДанныеЛокации.Страна = Страны[0];
				Иначе
					ДанныеЛокации.Страна = Справочники.Локации.ПустаяСсылка();
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиПунктОтправленияГородПриИзменении(Элемент)
	
	ТекСтрока = Элементы.Услуги.ТекущаяСтрока;
	УслугиПунктОтправленияГородПриИзмененииСервер(ТекСтрока);
	
	Если ЗаполнятьВниз Тогда
		ВыполнитьЗаполнениеВниз(Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УслугиПунктОтправленияГородПриИзмененииСервер(ТекСтрока)
	
	ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ТекСтрока);
	ОбработатьИзменениеГородаОтправленияВСтроке(ТекДанные);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменениеГородаОтправленияВСтроке(ТекДанные)

	Если ЗначениеЗаполнено(ТекДанные.ПунктОтправленияГород) Тогда
		ПоляТаблицыУслуг = ПараметрыВидаУслуг.ПоляТаблицыУслуг;				
		ОписаниеПоля = ПоляТаблицыУслуг.Получить("ПунктОтправленияСтрана");	
		Если ОписаниеПоля <> Неопределено Тогда
			Если ТипЗнч(ТекДанные.ПунктОтправленияГород) = Тип("СправочникСсылка.Локации") Тогда				
				//ТекДанные.ПунктОтправленияСтрана = ОбщегоНазначенияВызовСервера.ЗначениеРеквизитаОбъекта(ТекДанные.ПунктОтправленияГород, "Страна");
				ТекДанные.ПунктОтправленияСтрана = ПолучитьЛокациюВышестоящегоУровня(ТекДанные.ПунктОтправленияГород, Перечисления.ТипыИерархииЛокации.Страна); 
			ИначеЕсли ТипЗнч(ТекДанные.ПунктОтправленияГород) = Тип("СправочникСсылка.Мультилокации") Тогда
				//ТаблицаЛокаций = ПолучитьЛокацииПоМультилокации(ТекДанные.ПунктОтправленияГород);
				//Страны = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ТаблицаЛокаций.ВыгрузитьКолонку("Страна"));
				Страны = ПолучитьЛокацииВышестоящегоУровняПоМультилокации(ТекДанные.ПунктОтправленияГород, Перечисления.ТипыИерархииЛокации.Страна);
				Если Страны.Количество() = 1 Тогда
					ТекДанные.ПунктОтправленияСтрана = Страны[0];
				Иначе
					ТекДанные.ПунктОтправленияСтрана = Справочники.Локации.ПустаяСсылка();
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Иначе
		ТекДанные.ПунктОтправленияСтрана = Справочники.Локации.ПустаяСсылка();
	КонецЕсли;
	ТекДанные.ПунктОтправления = Справочники.Локации.ПустаяСсылка();
	ОбновитьДинамическиеПоляТаблицыУслугПоСтроке(ТекДанные);
		
КонецПроцедуры

&НаСервере
Функция ПолучитьЛокациюВышестоящегоУровня(Локация, ТипИерархии)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИерархияЛокаций.ЛокацияВышестоящегоУровня КАК ЛокацияВышестоящегоУровня
	|ИЗ
	|	РегистрСведений.ИерархияЛокаций КАК ИерархияЛокаций
	|ГДЕ
	|	ИерархияЛокаций.Локация = &Локация
	|	И ИерархияЛокаций.ТипИерархии = &ТипИерархии";
	Запрос.УстановитьПараметр("Локация", Локация);
	Запрос.УстановитьПараметр("ТипИерархии", ТипИерархии);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЛокацияВышестоящегоУровня = Выборка.ЛокацияВышестоящегоУровня;
	Иначе
		ЛокацияВышестоящегоУровня = Справочники.Локации.ПустаяСсылка();
	КонецЕсли;
	
	Возврат ЛокацияВышестоящегоУровня;
	
КонецФункции

&НаСервере
Функция ПолучитьЛокацииВышестоящегоУровняПоМультилокации(Мультилокация, ТипИерархии)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИерархияЛокаций.ЛокацияВышестоящегоУровня КАК ЛокацияВышестоящегоУровня
	|ИЗ
	|	Справочник.Мультилокации.Локации КАК МультилокацииЛокации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИерархияЛокаций КАК ИерархияЛокаций
	|		ПО МультилокацииЛокации.Локация = ИерархияЛокаций.Локация
	|			И (ИерархияЛокаций.ТипИерархии = &ТипИерархии)
	|ГДЕ
	|	МультилокацииЛокации.Ссылка = &Мультилокация";
	Запрос.УстановитьПараметр("Мультилокация", Мультилокация);
	Запрос.УстановитьПараметр("ТипИерархии", ТипИерархии);
	
	ТаблицаЛокаций = Запрос.Выполнить().Выгрузить();
	ЛокацииВышестоящегоУровня = ТаблицаЛокаций.ВыгрузитьКолонку("ЛокацияВышестоящегоУровня");
	
	Возврат ЛокацииВышестоящегоУровня;
	
КонецФункции

&НаКлиенте
Процедура УслугиПунктНазначенияПриИзменении(Элемент)
	
	ТекСтрока = Элементы.Услуги.ТекущаяСтрока;
	УслугиПунктНазначенияПриИзмененииСервер(ТекСтрока);
	
	Если ЗаполнятьВниз Тогда
		ВыполнитьЗаполнениеВниз(Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УслугиПунктНазначенияПриИзмененииСервер(ТекСтрока)
	
	ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ТекСтрока);
	ОбработатьИзменениеПунктаНазначенияВСтроке(ТекДанные);
	
	Если Не ЗначениеЗаполнено(ТекДанные.ПунктНазначения) Тогда
		ЛокацияПустаяСсылка =Справочники.Локации.ПустаяСсылка();
		ТекДанные.ПунктНазначенияГород = ЛокацияПустаяСсылка;
		ТекДанные.ПунктНазначенияСтрана = ЛокацияПустаяСсылка;
	КонецЕсли;
	
	ОбновитьДинамическиеПоляТаблицыУслугПоСтроке(ТекДанные);
	//Евросиб Шевченко А.В. US 86665 TA 120749 19.10.2025
	Если Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.ТЭО Тогда
		ПолучитьПортыИЖДСтанции(ТекДанные);
	КонецЕсли;
	//Евросиб Шевченко А.В. US 86665 TA 120749 19.10.2025
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменениеПунктаНазначенияВСтроке(ТекДанные)
	
	ДанныеЛокации = Новый Структура;
	ПоляТаблицыУслуг = ПараметрыВидаУслуг.ПоляТаблицыУслуг;				
	
	Если ЗначениеЗаполнено(ТекДанные.ПунктНазначения) Тогда
		
		ОписаниеПоля = ПоляТаблицыУслуг.Получить("АдресТерминалаСдачиКТК");	
		Если ОписаниеПоля <> Неопределено Тогда
			ДанныеЛокации.Вставить("Адрес");
		КонецЕсли;
		
		ОписаниеПоляГород = ПоляТаблицыУслуг.Получить("ПунктНазначенияГород");
		Если ОписаниеПоляГород <> Неопределено Тогда
			ДанныеЛокации.Вставить("Город");
		КонецЕсли;
		
		ОписаниеПоляСтрана = ПоляТаблицыУслуг.Получить("ПунктНазначенияСтрана");
		Если ОписаниеПоляСтрана <> Неопределено Тогда
			ДанныеЛокации.Вставить("Страна");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеЛокации) Тогда
			
			ПолучитьДопДанныеЛокации(ТекДанные.ПунктНазначения, ДанныеЛокации);
			Если ДанныеЛокации.Свойство("Адрес") Тогда
				ТекДанные.АдресТерминалаСдачиКТК = ДанныеЛокации.Адрес;
			КонецЕсли;		
			Если ДанныеЛокации.Свойство("Город") Тогда
				ТекДанные.ПунктНазначенияГород = ДанныеЛокации.Город;
			КонецЕсли;
			Если ДанныеЛокации.Свойство("Страна") Тогда
				ТекДанные.ПунктНазначенияСтрана = ДанныеЛокации.Страна;
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		ТекДанные.АдресТерминалаСдачиКТК = Неопределено;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиПунктНазначенияГородПриИзменении(Элемент)
	
	ТекСтрока = Элементы.Услуги.ТекущаяСтрока;
	УслугиПунктНазначенияГородПриИзмененииСервер(ТекСтрока);
	
	Если ЗаполнятьВниз Тогда
		ВыполнитьЗаполнениеВниз(Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УслугиПунктНазначенияГородПриИзмененииСервер(ТекСтрока)
	
	ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ТекСтрока);
	ОбработатьИзменениеГородаНазначенияВСтроке(ТекДанные);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменениеГородаНазначенияВСтроке(ТекДанные)
	
	ЛокацияПустаяСсылка = Справочники.Локации.ПустаяСсылка();
	Если ЗначениеЗаполнено(ТекДанные.ПунктНазначенияГород) Тогда
		ПоляТаблицыУслуг = ПараметрыВидаУслуг.ПоляТаблицыУслуг;				
		ОписаниеПоля = ПоляТаблицыУслуг.Получить("ПунктНазначенияСтрана");	
		Если ОписаниеПоля <> Неопределено  Тогда
			Если ТипЗнч(ТекДанные.ПунктНазначенияГород) = Тип("СправочникСсылка.Локации") Тогда				
				ТекДанные.ПунктНазначенияСтрана = ПолучитьЛокациюВышестоящегоУровня(ТекДанные.ПунктНазначенияГород, Перечисления.ТипыИерархииЛокации.Страна);
			ИначеЕсли ТипЗнч(ТекДанные.ПунктНазначенияГород) = Тип("СправочникСсылка.Мультилокации") Тогда				
				Страны = ПолучитьЛокацииВышестоящегоУровняПоМультилокации(ТекДанные.ПунктНазначенияГород, Перечисления.ТипыИерархииЛокации.Страна); 
				Если Страны.Количество() = 1 Тогда
					ТекДанные.ПунктНазначенияСтрана = Страны[0];
				Иначе
					ТекДанные.ПунктНазначенияСтрана = ЛокацияПустаяСсылка;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Иначе
		ТекДанные.ПунктНазначенияСтрана = ЛокацияПустаяСсылка;
	КонецЕсли;
	ТекДанные.ПунктНазначения = ЛокацияПустаяСсылка;
	ОбновитьДинамическиеПоляТаблицыУслугПоСтроке(ТекДанные);
		
КонецПроцедуры

&НаСервере
Функция УдалитьПолучитьЛокацииВышестоящегоУровняПоМультилокации(Мультилокация)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МультилокацииЛокации.Локация.ЛокацияВышестоящегоУровня КАК ЛокацияВышестоящегоУровня,
	|	МультилокацииЛокации.Локация.Страна КАК Страна
	|ИЗ
	|	Справочник.Мультилокации.Локации КАК МультилокацииЛокации
	|ГДЕ
	|	МультилокацииЛокации.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Мультилокация);
	
	Возврат Запрос.Выполнить().Выгрузить();	
				
КонецФункции

&НаСервере
Функция ПолучитьЛокацииПоМультилокации(Мультилокация)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МультилокацииЛокации.Локация КАК Локация,
	|	МультилокацииЛокации.Локация.Страна КАК Страна
	|ИЗ
	|	Справочник.Мультилокации.Локации КАК МультилокацииЛокации
	|ГДЕ
	|	МультилокацииЛокации.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Мультилокация);
	
	Возврат Запрос.Выполнить().Выгрузить();	
				
КонецФункции

&НаКлиенте
Процедура СписокУчетныхЕдиницУчетнаяЕдиницаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ТекСтрокаУслуг = Элементы.Услуги.ТекущаяСтрока;
	
	ТекДанныеУслуг = Элементы.Услуги.ТекущиеДанные;	
	ИдентификаторТекСтроки = ТекДанныеУслуг.ПолучитьИдентификатор();
	
	ТекДанные = Элементы.СписокУчетныхЕдиниц.ТекущиеДанные;
	
	ДопПараметры = Новый Структура("ИдентификаторТекСтроки", ИдентификаторТекСтроки);
	ДопПараметры.Вставить("ТекущаяУчетнаяЕдиница", ТекДанные.УчетнаяЕдиницаСсылка);
	
	Если ЗначениеЗаполнено(ПараметрыВидаУслуг.ТипУчетныхЕдиницДетализации) Тогда
		СписокУчетныхЕдиницУчетныеЕдиницыНачалоВыбораПродолжение(ПараметрыВидаУслуг.ТипУчетныхЕдиницДетализации, ДопПараметры);
	ИначеЕсли ЗначениеЗаполнено(ТекДанныеУслуг.ТипУчетныхЕдиниц) Тогда
		СписокУчетныхЕдиницУчетныеЕдиницыНачалоВыбораПродолжение(ТекДанныеУслуг.ТипУчетныхЕдиниц, ДопПараметры);	
	Иначе
		СписокТипов = новый СписокЗначений;
		СписокТипов.Добавить("СправочникСсылка.ТС", "Вагон");
		СписокТипов.Добавить("СправочникСсылка.ТЕ", "Контейнер");
		ОповещениеОВыборе = Новый ОписаниеОповещения("СписокУчетныхЕдиницУчетныеЕдиницыНачалоВыбораПродолжение", ЭтаФорма, ДопПараметры);
		СписокТипов.ПоказатьВыборЭлемента(ОповещениеОВыборе, "Выбор типа данных");
	КонецЕсли;		
		
КонецПроцедуры

&НаКлиенте
Процедура СписокУчетныхЕдиницУчетныеЕдиницыНачалоВыбораПродолжение(ВыбранныйТип, ДопПараметры) Экспорт
	
	Если ВыбранныйТип <> Неопределено Тогда
		
		Если ТипЗнч(ВыбранныйТип) = Тип("ЭлементСпискаЗначений") Тогда
			ТипУчетныхЕдиниц = ВыбранныйТип.Значение;
		Иначе
			ТипУчетныхЕдиниц = ВыбранныйТип;
		КонецЕсли;
		
		ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ДопПараметры.ИдентификаторТекСтроки);
		
		Если ТекДанные.СпособВводаУчетныхЕдиниц = ПредопределенноеЗначение("Перечисление.СпособыВводаУчетныхЕдиниц.Списком") Тогда
			
			УчетныеЕдиницы = Новый Массив;
			СтрокиУчетныхЕдиниц = Объект.УчетныеЕдиницы.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", ТекДанные.ИдентификаторСтрокиУслуг));
			Для Каждого СтрокаУчетнойЕдиницы Из СтрокиУчетныхЕдиниц Цикл
				УчетныеЕдиницы.Добавить(СтрокаУчетнойЕдиницы.УчетнаяЕдиница);
			КонецЦикла;
			
			Если ТипУчетныхЕдиниц = "СправочникСсылка.ТЕ" Тогда
				ПараметрыФормы = Новый Структура("ТЕ, СоставТЕ", Истина, УчетныеЕдиницы);
			ИначеЕсли ТипУчетныхЕдиниц = "СправочникСсылка.ТС" Тогда
				ПараметрыФормы = Новый Структура("ТС, СоставТС", Истина, УчетныеЕдиницы);
			КонецЕсли;
				
			ДопПараметры = Новый Структура("ИдентификаторСтрокиУслуг, ИдентификаторСтроки, Удалять", ТекДанные.ИдентификаторСтрокиУслуг, ДопПараметры.ИдентификаторТекСтроки, Истина);
			ОповещениеОВыборе = Новый ОписаниеОповещения("ОбработкаВыбораУчетныхЕдиниц", ЭтаФорма, ДопПараметры);
			ОткрытьФорму("ОбщаяФорма.ОкноРедактированияСоставаУчетныхЕдиниц", ПараметрыФормы,, ЭтаФорма.УникальныйИдентификатор,,, ОповещениеОВыборе, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		ИначеЕсли ТекДанные.СпособВводаУчетныхЕдиниц = ПредопределенноеЗначение("Перечисление.СпособыВводаУчетныхЕдиниц.Построчно") Тогда
			
			ПараметрыФормы = Новый Структура;
			Если ЗначениеЗаполнено(ДопПараметры.ТекущаяУчетнаяЕдиница) Тогда
				ПараметрыФормы.Вставить("Ключ", ДопПараметры.ТекущаяУчетнаяЕдиница);
			КонецЕсли;
			
			ДопПараметрыОповещения = Новый Структура("ИдентификаторСтрокиУслуг, ИдентификаторСтроки", ТекДанные.ИдентификаторСтрокиУслуг, ДопПараметры.ИдентификаторТекСтроки);
			ДопПараметрыОповещения.Вставить("ТекущаяУчетнаяЕдиница", ДопПараметры.ТекущаяУчетнаяЕдиница);
			ОповещениеОВыборе = Новый ОписаниеОповещения("ОбработкаВыбораУчетнойЕдиницы", ЭтаФорма, ДопПараметрыОповещения);
			
			Если ТипУчетныхЕдиниц = "СправочникСсылка.ТЕ" Тогда
				ОткрытьФорму("Справочник.ТЕ.ФормаВыбора", ПараметрыФормы, ЭтаФорма,,,, ОповещениеОВыборе, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			ИначеЕсли ТипУчетныхЕдиниц = "СправочникСсылка.ТС" Тогда
				ОткрытьФорму("Справочник.ТС.ФормаВыбора", ПараметрыФормы, ЭтаФорма,,,, ОповещениеОВыборе, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораУчетнойЕдиницы(УчетнаяЕдиница, ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(УчетнаяЕдиница) Тогда
		НайденныеСтроки = Объект.УчетныеЕдиницы.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг, УчетнаяЕдиница", ДопПараметры.ИдентификаторСтрокиУслуг, ДопПараметры.ТекущаяУчетнаяЕдиница));
		Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
			НайденныеСтроки[0].УчетнаяЕдиница = УчетнаяЕдиница;
		Иначе
			НоваяСтрока = Объект.УчетныеЕдиницы.Добавить();
			НоваяСтрока.ИдентификаторСтрокиУслуг = ДопПараметры.ИдентификаторСтрокиУслуг;
			НоваяСтрока.УчетнаяЕдиница = УчетнаяЕдиница;
		КонецЕсли;
		
		ТекДанныеУслуги = Объект.Услуги.НайтиПоИдентификатору(ДопПараметры.ИдентификаторСтроки);
		ОбновитьПредставлениеУчетныхЕдиницСтрокиУслуг(ТекДанныеУслуги, Ложь);		
		УстановитьВидимостьДоступностьЭлементовДетализацииПоУчетнымЕдиницам(ТекДанныеУслуги);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокУчетныхЕдиницПередУдалением(Элемент, Отказ)
	
	ТекСтрокаУслуг = Элементы.Услуги.ТекущаяСтрока;
	ВыделенныеСтрокиУчетныхЕдиниц = Элементы.СписокУчетныхЕдиниц.ВыделенныеСтроки;
	СписокУчетныхЕдиницПередУдалениемСервер(ТекСтрокаУслуг, ВыделенныеСтрокиУчетныхЕдиниц);
	
КонецПроцедуры

&НаСервере
Процедура СписокУчетныхЕдиницПередУдалениемСервер(ТекСтрокаУслуг, ВыделенныеСтрокиУчетныхЕдиниц)
	
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтрокиУчетныхЕдиниц Цикл
		СтрокаСписка = СписокУчетныхЕдиниц.НайтиПоИдентификатору(ВыделеннаяСтрока);	
		УдалитьСтрокуТаблицыУчетныхЕдиниц(СтрокаСписка.ИдентификаторСтрокиТаблицыУчЕдиниц, СтрокаСписка.ИдентификаторСтрокиУслуг);
	КонецЦикла;
	
	ТекДанныеУслуг = Объект.Услуги.НайтиПоИдентификатору(ТекСтрокаУслуг);
	ОбновитьПредставлениеУчетныхЕдиницСтрокиУслуг(ТекДанныеУслуг, Ложь);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокуТаблицыУчетныхЕдиниц(ИдентификаторСтрокиТаблицыУчЕдиниц = Неопределено, ИдентификаторСтрокиУслуг)
	
	Если ИдентификаторСтрокиТаблицыУчЕдиниц <> Неопределено И ИдентификаторСтрокиТаблицыУчЕдиниц >= 0 Тогда
		СтрокаУчетнойЕдиницы = Объект.УчетныеЕдиницы.НайтиПоИдентификатору(ИдентификаторСтрокиТаблицыУчЕдиниц);
		Если СтрокаУчетнойЕдиницы <> Неопределено Тогда
			Объект.УчетныеЕдиницы.Удалить(СтрокаУчетнойЕдиницы);
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(ИдентификаторСтрокиУслуг) Тогда
		СтрокиУчетныхЕдиниц = Объект.УчетныеЕдиницы.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", ИдентификаторСтрокиУслуг));
		Для Каждого СтрокаУчетнойЕдиницы Из СтрокиУчетныхЕдиниц Цикл
			Объект.УчетныеЕдиницы.Удалить(СтрокаУчетнойЕдиницы);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокУчетныхЕдиницПриИзменении(Элемент)
	
	//ТекСтрока = Элементы.Услуги.ТекущаяСтрока;
	//Если ТекСтрока <> Неопределено Тогда
	//	ОбновитьПредставлениеУчетныхЕдиницСтрокиУслуг(ТекСтрока);
	//КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокУчетныхЕдиницПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ТекДанныеУслуг = Элементы.Услуги.ТекущиеДанные;
	ТекСтрокаУслуг = Элементы.Услуги.ТекущаяСтрока;
	Если ТекСтрокаУслуг <> Неопределено Тогда
		ТекСтрокаУчетныхЕдиниц = Элементы.СписокУчетныхЕдиниц.ТекущаяСтрока;
		Если ТекСтрокаУчетныхЕдиниц <> Неопределено Тогда
			СписокУчетныхЕдиницПриОкончанииРедактированияСервер(ТекСтрокаУслуг, ТекСтрокаУчетныхЕдиниц);
		КонецЕсли;
		УстановитьВидимостьДоступностьЭлементовДетализацииПоУчетнымЕдиницам(ТекДанныеУслуг);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СписокУчетныхЕдиницПриОкончанииРедактированияСервер(ТекСтрокаУслуг, ТекСтрокаУчетныхЕдиниц)
	
	ТекДанныеУслуги = Объект.Услуги.НайтиПоИдентификатору(ТекСтрокаУслуг);
	ТекДанные = СписокУчетныхЕдиниц.НайтиПоИдентификатору(ТекСтрокаУчетныхЕдиниц);
	Если Не ЗначениеЗаполнено(ТекДанные.УчетнаяЕдиницаСсылка) И Не ЗначениеЗаполнено(ТекДанные.УчетнаяЕдиница) Тогда
		Если ТекДанныеУслуги.СпособВводаУчетныхЕдиниц = ПредопределенноеЗначение("Перечисление.СпособыВводаУчетныхЕдиниц.Построчно") Тогда
			УдалитьСтрокуТаблицыУчетныхЕдиниц(ТекДанные.ИдентификаторСтрокиТаблицыУчЕдиниц, -1);
		ИначеЕсли ТекДанныеУслуги.СпособВводаУчетныхЕдиниц = ПредопределенноеЗначение("Перечисление.СпособыВводаУчетныхЕдиниц.Списком") Тогда
			УдалитьСтрокуТаблицыУчетныхЕдиниц(ТекДанные.ИдентификаторСтрокиТаблицыУчЕдиниц, ТекДанные.ИдентификаторСтрокиУслуг);
		КонецЕсли;
		СписокУчетныхЕдиниц.Удалить(ТекДанные);
		ОбновитьПредставлениеУчетныхЕдиницСтрокиУслуг(ТекДанныеУслуги, Ложь);
	КонецЕсли;		
	
КонецПроцедуры

&НаКлиенте
Процедура СписокУчетныхЕдиницУчетнаяЕдиницаСсылкаПриИзменении(Элемент)
	
	ТекДанныеУслуги = Элементы.Услуги.ТекущиеДанные;
	ТекСтрокаУслуг = Элементы.Услуги.ТекущаяСтрока;
	ТекСтрокаУчетныхЕдиниц = Элементы.СписокУчетныхЕдиниц.ТекущаяСтрока;
	
	СписокУчетныхЕдиницУчетнаяЕдиницаСсылкаПриИзмененииСервер(ТекСтрокаУслуг, ТекСтрокаУчетныхЕдиниц);
	
	УстановитьВидимостьДоступностьЭлементовДетализацииПоУчетнымЕдиницам(ТекДанныеУслуги);
	
КонецПроцедуры

&НаСервере
Процедура СписокУчетныхЕдиницУчетнаяЕдиницаСсылкаПриИзмененииСервер(ТекСтрокаУслуг, ТекСтрокаУчетныхЕдиниц)
	
	ТекДанныеУслуги = Объект.Услуги.НайтиПоИдентификатору(ТекСтрокаУслуг);
	ТекДанные = СписокУчетныхЕдиниц.НайтиПоИдентификатору(ТекСтрокаУчетныхЕдиниц);
	
	Если ЗначениеЗаполнено(ТекДанные.УчетнаяЕдиницаСсылка) Тогда
		
		СтрокаУчетнойЕдиницы = Объект.УчетныеЕдиницы.НайтиПоИдентификатору(ТекДанные.ИдентификаторСтрокиТаблицыУчЕдиниц);
		Если СтрокаУчетнойЕдиницы <> Неопределено Тогда
			СтрокаУчетнойЕдиницы.УчетнаяЕдиница = ТекДанные.УчетнаяЕдиницаСсылка;
		Иначе
			НоваяСтрока = Объект.УчетныеЕдиницы.Добавить();
			НоваяСтрока.ИдентификаторСтрокиУслуг = ТекДанныеУслуги.ИдентификаторСтрокиУслуг;
			НоваяСтрока.УчетнаяЕдиница = ТекДанные.УчетнаяЕдиницаСсылка;
			ТекДанные.ИдентификаторСтрокиТаблицыУчЕдиниц = НоваяСтрока.ПолучитьИдентификатор();
		КонецЕсли;
		
		ОбновитьПредставлениеУчетныхЕдиницСтрокиУслуг(ТекДанныеУслуги, Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

