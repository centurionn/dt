&НаСервереБезКонтекста
Функция ПолучитьЭлементыЕТСНГпоЧастиКода(Текст)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	э_ЕТСНГ.Ссылка КАК Ссылка,
	|	э_ЕТСНГ.Код КАК Код,
	|	э_ЕТСНГ.Наименование КАК Наименование
	|ИЗ
	|	Справочник.э_ЕТСНГ КАК э_ЕТСНГ
	|ГДЕ
	|	э_ЕТСНГ.Код ПОДОБНО &Текст
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код";
	Запрос.УстановитьПараметр("Текст", "%" + Текст + "%");
	
	СписокЭлементов = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокЭлементов.Добавить(Выборка.Ссылка, СтрШаблон("%1 (%2)", Выборка.Наименование, Выборка.Код));
	КонецЦикла;
	
	Возврат СписокЭлементов;
	
КонецФункции

