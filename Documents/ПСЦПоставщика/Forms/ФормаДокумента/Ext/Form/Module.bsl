&НаКлиенте
Процедура ОткрытьФормуВнесенияСтавокИзExcel(ВариантФормы)
	
	АдресТаблицыОписанияРеквизитов = ПоместитьОписаниеПолейВоВременноеХранилище(Объект.ВидУслугПоставщика, Новый УникальныйИдентификатор); 
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресТаблицыОписанияРеквизитов", АдресТаблицыОписанияРеквизитов);
	ПараметрыФормы.Вставить("ВариантФормы", ВариантФормы);
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("АдресТаблицыОписанияРеквизитов", АдресТаблицыОписанияРеквизитов);
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПриЗакрытииФормыЗагрузкиИзExcel", ЭтаФорма, ДопПараметры);
	
	ОткрытьФорму("Документ.ПСЦПоставщика.Форма.ФормаЗагрузкиИзExcel", ПараметрыФормы, ЭтаФорма,,,, ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыЗагрузкиИзExcel(АдресТаблицы, ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(АдресТаблицы) Тогда
		ЗагрузитьПрочитаннуюТаблицу(АдресТаблицы);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПрочитаннуюТаблицу(АдресТаблицы)
	
	Таблица = ПолучитьИзВременногоХранилища(АдресТаблицы);
	УдалитьИзВременногоХранилища(АдресТаблицы);
	
	Если ЗначениеЗаполнено(ПараметрыВидаУслуг.ВалютаПоУмолчанию) Тогда
		ВалютаПоУмолчанию = ПараметрыВидаУслуг.ВалютаПоУмолчанию;
	Иначе
		ВалютаПоУмолчанию = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "ВалютаВзаиморасчетов");
	КонецЕсли;
	
	ПроверятьНормуЗагрузкиКТК = Ложь;
	Если Таблица.Колонки.Найти("НормаЗагрузкиКТК") <> Неопределено Тогда		
		ПроверятьНормуЗагрузкиКТК = Истина;
		СоответствиеВесовТипоразмерам = ПолучитьСоответствиеВесовТипоразмерам();		
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("КонтейнерыВагоны") <> Неопределено И Таблица.Колонки.Найти("КонтейнерыВагоныСписок") <> Неопределено Тогда
		ПроверятьКонтейнерыВагоны = Истина;
	Иначе
		ПроверятьКонтейнерыВагоны = Ложь;
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("ТипоразмерыКТК") <> Неопределено И Таблица.Колонки.Найти("ТипоразмерыКТКСписок") <> Неопределено Тогда
		ЗагружатьТипоразмерыКТК = Истина;
	Иначе
		ЗагружатьТипоразмерыКТК = Ложь;
	КонецЕсли;
	//Евросиб Шевченко А.В. US 124811 TA 129059 13.03.2026
	Если Таблица.Колонки.Найти("КлассыОпасности") <> Неопределено И Таблица.Колонки.Найти("КлассыОпасностиСписок") <> Неопределено Тогда
		ЗагружатьКлассыОпасности = Истина;
	Иначе
		ЗагружатьКлассыОпасности = Ложь;
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("КлассОпасностиСтрокой") <> Неопределено И Таблица.Колонки.Найти("КлассыОпасностиСписок") <> Неопределено Тогда
		ЗагружатьКлассыОпасности = Истина;
	Иначе
		ЗагружатьКлассыОпасности = Ложь;
	КонецЕсли;	
	//Евросиб Шевченко А.В. US 124811 TA 129059 13.03.2026
	Если Таблица.Колонки.Найти("ТипоразмерыКТКСтрокой") <> Неопределено И Таблица.Колонки.Найти("ТипоразмерыКТКСписок") <> Неопределено Тогда
		ЗагружатьТипоразмерыКТКСтрокой = Истина;
	Иначе
		ЗагружатьТипоразмерыКТКСтрокой = Ложь;
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("ТипоразмерыВагоновСписок") <> Неопределено Тогда
		ЗагружатьТипоразмерыВагоновСписок = Истина;
	Иначе
		ЗагружатьТипоразмерыВагоновСписок = Ложь;
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("ВидыОтправокСписок") <> Неопределено Тогда
		ЗагружатьВидыОтправок = Истина;
	Иначе
		ЗагружатьВидыОтправок = Ложь;
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("ПериодПредоставления") <> Неопределено Тогда
		ЗагружатьПериодПредоставления = Истина;
	Иначе
		ЗагружатьПериодПредоставления = Ложь;
	КонецЕсли;
	//Евросиб Шевченко А.В. US 86665 TA 120749 19.10.2025
	Если Таблица.Колонки.Найти("СостоянияГруженыйПорожнийСтрокой") <> Неопределено Тогда
		ЗагружатьГруженыйПорожнийСтрокой = Истина;
	Иначе
		ЗагружатьГруженыйПорожнийСтрокой = Ложь;
	КонецЕсли;
	//Евросиб Шевченко А.В. US 86665 TA 120749 19.10.2025
	СписокИсключаемыхИзЗаполненияПолей = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		ОписаниеПоля = ПараметрыВидаУслуг.ПоляТаблицыУслуг.Получить(Колонка.Имя);
		Если ОписаниеПоля <> Неопределено И ОписаниеПоля.ТолькоПросмотр Тогда
			СписокИсключаемыхИзЗаполненияПолей.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	ИсключаемыеИзЗаполненияПоля = СтрСоединить(СписокИсключаемыхИзЗаполненияПолей, ",");
	
	Для Каждого Стр Из Таблица Цикл
		
		ТекДанные = Объект.Услуги.Добавить();
		ИдентификаторСтроки = ТекДанные.ПолучитьИдентификатор();
		ЗаполнитьЗначенияСвойств(ТекДанные, Стр,, ИсключаемыеИзЗаполненияПоля);
		ТекДанные.ИдентификаторСтрокиУслуг = Строка(Новый УникальныйИдентификатор);
		
		Для Каждого Элемент Из ПараметрыВидаУслуг.ЗначенияПолейПоУмолчанию Цикл
			Если Не ЗначениеЗаполнено(ТекДанные[Элемент.Ключ]) Тогда
				ТекДанные[Элемент.Ключ] = Элемент.Значение;
			КонецЕсли;
		КонецЦикла;
		//Евросиб Шевченко А.В. US 86665 TA 120749 19.10.2025
		Если ЗагружатьГруженыйПорожнийСтрокой И ЗначениеЗаполнено(Стр.СостоянияГруженыйПорожнийСтрокой) Тогда
			ТекДанные.СостоянияГруженыйПорожний.ЗагрузитьЗначения(Стр.СостоянияГруженыйПорожний.ВыгрузитьЗначения());
			ОбработатьИзменениеСостоянияГруженыйПорожнийСтрокиУслуг(ТекДанные);
		КонецЕсли;
		//Евросиб Шевченко А.В. US 86665 TA 120749 19.10.2025
		Если ЗагружатьТипоразмерыКТКСтрокой И ЗначениеЗаполнено(Стр.ТипоразмерыКТКСписок) Тогда
			ТекДанные.ТипоразмерыКТК.ЗагрузитьЗначения(Стр.ТипоразмерыКТКСписок.ВыгрузитьЗначения());
			ОбработатьИзмененияТипоразмеровКТКСтрокиУслуг(ТекДанные);
		КонецЕсли;
		
		Если ЗагружатьТипоразмерыКТК И ЗначениеЗаполнено(Стр.ТипоразмерыКТКСписок) Тогда
			ТекДанные.ТипоразмерыКТК.ЗагрузитьЗначения(Стр.ТипоразмерыКТКСписок.ВыгрузитьЗначения());
			ОбработатьИзмененияТипоразмеровКТКСтрокиУслуг(ТекДанные);
		КонецЕсли;
		//Евросиб Шевченко А.В. US 124811 TA 129059 13.03.2026
		Если ЗагружатьКлассыОпасности И ЗначениеЗаполнено(Стр.КлассыОпасностиСписок) Тогда
			ТекДанные.КлассыОпасности.ЗагрузитьЗначения(Стр.КлассыОпасностиСписок.ВыгрузитьЗначения());
			ОбработатьИзмененияКлассыОпасностиСтрокиУслуг(ТекДанные);
		КонецЕсли;
		//Евросиб Шевченко А.В. US 124811 TA 129059 13.03.2026
		Если ЗагружатьТипоразмерыВагоновСписок И ЗначениеЗаполнено(Стр.ТипоразмерыВагоновСписок) Тогда
			ТекДанные.ТипоразмерыВагонов.ЗагрузитьЗначения(Стр.ТипоразмерыВагоновСписок.ВыгрузитьЗначения());
			ОбработатьИзменениеТипоразмеровВагоновСтрокиУслуг(ТекДанные);
		КонецЕсли;
		
		Если ЗагружатьВидыОтправок И ЗначениеЗаполнено(Стр.ВидыОтправокСписок) Тогда
			ТекДанные.ВидыОтправок.ЗагрузитьЗначения(Стр.ВидыОтправокСписок.ВыгрузитьЗначения());
			ОбработатьИзменениеВидовОтправокСтрокиУслуг(ТекДанные);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекДанные.НоменклатураПоставщика) Тогда
			УслугиНоменклатураПоставщикаПриИзмененииСервер(ТекДанные);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекДанные.Номенклатура) Тогда
			ОбработатьИзменениеНоменклатурыВСтроке(ТекДанные);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТекДанные.СтавкаНДС) Тогда
				
			Если ЗначениеЗаполнено(ТекДанные.Номенклатура) Тогда
				СтавкаНДСПоставщика = ОбщегоНазначенияВызовСервера.ЗначениеРеквизитаОбъекта(ТекДанные.Номенклатура, "СтавкаНДСПоставщика");
				Если ЗначениеЗаполнено(СтавкаНДСПоставщика) Тогда
					ТекДанные.СтавкаНДС = СтавкаНДСПоставщика;
				КонецЕсли;
			КонецЕсли;
			
		    Если Не ЗначениеЗаполнено(ТекДанные.СтавкаНДС) Тогда
				ТекДанные.СтавкаНДС = Объект.СтавкаНДС;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекДанные.ТипоразмерКТК_Вагона) Тогда
			ОбработатьИзменениеТипоразмераКТК_Вагона(ТекДанные);
		КонецЕсли;
		
		Если ПроверятьКонтейнерыВагоны И ЗначениеЗаполнено(Стр.КонтейнерыВагоныСписок) Тогда
			СоздатьСтрокиТаблицыПоУчетнымЕдиницам(ИдентификаторСтроки, Стр.КонтейнерыВагоныСписок.ВыгрузитьЗначения());
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТекДанные.Валюта) Тогда
			ТекДанные.Валюта = ВалютаПоУмолчанию;
		КонецЕсли;
		
		Если ТекДанные.СтавкаПрогрессивная Тогда
			ОбработатьИзменениеПризнакаСтавкаПрогрессивнаяВСтроке(ТекДанные);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекДанные.НормаВремениНаПогрузкуВыгрузку) Тогда
			ОбработатьИзменениеНормыВремениНаПогрузкуВыгрузку(ТекДанные);
		КонецЕсли;
		
		Если ПроверятьНормуЗагрузкиКТК И ЗначениеЗаполнено(ТекДанные.НормаЗагрузкиКТК) Тогда
			
			ЗначениеНайдено = Ложь;
			Если ЗначениеЗаполнено(ТекДанные.ТипоразмерыКТК) Тогда				
				Для Каждого ТипоразмерКТК Из ТекДанные.ТипоразмерыКТК Цикл
					Веса = СоответствиеВесовТипоразмерам.Получить(ТипоразмерКТК.Значение);
					Если ЗначениеЗаполнено(Веса) И Веса.Найти(ТекДанные.НормаЗагрузкиКТК) <> Неопределено Тогда
						ЗначениеНайдено = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;							
			КонецЕсли;
			
			Если Не ЗначениеНайдено Тогда
				ТекДанные.НормаЗагрузкиКТК = Справочники.ВесаПоТипоразмерам.ПустаяСсылка();
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекДанные.СвободныйПериодХраненияПриОтправке)
				Или ЗначениеЗаполнено(ТекДанные.СвободныйПериодХраненияПриПриеме)
				Или ЗначениеЗаполнено(ТекДанные.СвободныйПериодХраненияУслугиДепо)
				Или ЗначениеЗаполнено(ТекДанные.СвободныйПериодХранения)
				Или ЗначениеЗаполнено(ТекДанные.СвободныйПериодХраненияВаг)
				Или ЗначениеЗаполнено(ТекДанные.СвободныйПериодХраненияКТК) Тогда
				
			ОбработатьИзменениеПериодаХраненияВСтроке(ТекДанные, Ложь);
		КонецЕсли;
		
		ПересчитатьСтоимостьСУчетомСтавкиНДС(ТекДанные);		
		ОбработатьИзменениеПризнакаОпасныйГруз(ТекДанные);		
		ОбработатьИзмененияПризнакаОсобыйТемпературныйРежим(ТекДанные);		
		
		ОбработатьИзменениеПризнакаНормативыВСтроке(ТекДанные);
		Если ЗагружатьПериодПредоставления Тогда			
			ТекДанные.НормаПользования = Стр.ПериодПредоставления;			
		КонецЕсли;		
		
		Если ЗначениеЗаполнено(ТекДанные.ПунктОтправления) Тогда
			ОбработатьИзменениеПунктаОтправленияВСтроке(ТекДанные);
		ИначеЕсли ЗначениеЗаполнено(ТекДанные.ПунктОтправленияГород) Тогда
			ОбработатьИзменениеГородаОтправленияВСтроке(ТекДанные);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекДанные.ПунктНазначения) Тогда
			ОбработатьИзменениеПунктаНазначенияВСтроке(ТекДанные);
		ИначеЕсли ЗначениеЗаполнено(ТекДанные.ПунктНазначенияГород) Тогда
			ОбработатьИзменениеГородаНазначенияВСтроке(ТекДанные);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекДанные.ГрузЕТСНГ) Тогда
			ТекДанные.ЕТСНГ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекДанные.ГрузЕТСНГ, "Код");
		ИначеЕсли ЗначениеЗаполнено(ТекДанные.ЕТСНГ) Тогда
			ТекДанные.ГрузЕТСНГ = ПолучитьГрузЕТСНГ(ТекДанные.ЕТСНГ);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекДанные.ГрузГНГ) Тогда
			ТекДанные.ГНГ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекДанные.ГрузГНГ, "Код");
		ИначеЕсли ЗначениеЗаполнено(ТекДанные.ГНГ) Тогда
			ТекДанные.ГрузГНГ = ПолучитьГрузГНГ(ТекДанные.ГНГ);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекДанные.Груз) Тогда
			ЗаполнитьКодыПоГрузу(ТекДанные);
		
			//РеквизитыГруза = ПолучитьГрузПоРеквизиту("ЕТСНГ", ТекДанные.ЕТСНГ);
			//ТекДанные.Груз = РеквизитыГруза.Груз;
			//ТекДанные.ГНГ = РеквизитыГруза.ГНГ;
		
			//РеквизитыГруза = ПолучитьГрузПоРеквизиту("ГНГ", ТекДанные.ГНГ);
			//ТекДанные.Груз = РеквизитыГруза.Груз;
			//ТекДанные.ГНГ = РеквизитыГруза.ГНГ;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекДанные.ГрузТНВЭД) Тогда
			ТекДанные.КодТНВЭД = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекДанные.ГрузТНВЭД, "ТНВЭД");
		ИначеЕсли ЗначениеЗаполнено(ТекДанные.КодТНВЭД) Тогда
			ГрузТНВЭД = НайтиГрузТНВЭД(ТекДанные.КодТНВЭД);
			Если ЗначениеЗаполнено(ГрузТНВЭД) Тогда
				ТекДанные.ГрузТНВЭД = ГрузТНВЭД;
			КонецЕсли;
		КонецЕсли;
		
		УстановитьЗначениеПоляСостояниеГруженыйПорожний(ТекДанные);
		
		Если ЗначениеЗаполнено(ТекДанные.ЛокацияОказанияУслуги) Тогда
			ОбработатьИзменениеЛокацииОказанияУслугиВСтрокеУслуг(ТекДанные);
		КонецЕсли;
		
	КонецЦикла;
	
	ОбновитьДинамическиеПоляТаблицыУслуг();	
	УстановитьВидимостьГруппПоНормативам();
	УстановитьВидимостьГруппыПоЗначениюПоля(Объект.Услуги, Элементы.УслугиГруппаОпасностьГруза, "ОпасныйСпецГруз");
	УстановитьВидимостьГруппыПоЗначениюПоля(Объект.Услуги, Элементы.УслугиОсобыйТемпературныйРежимЗначение, "ОсобыйТемпературныйРежим");
	
	ПроверитьИУстановитьПризнакТиповой();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСоответствиеВесовТипоразмерам()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТипоразмерыТЕВеса.Ссылка КАК ТипоразмерКТК,
	|	ТипоразмерыТЕВеса.Вес КАК Вес
	|ИЗ
	|	Справочник.ТипоразмерыТЕ.Веса КАК ТипоразмерыТЕВеса
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТипоразмерКТК,
	|	Вес";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СоответствиеВесовТипоразмерам = Новый Соответствие;
	Пока Выборка.СледующийПоЗначениюПоля("ТипоразмерКТК") Цикл
		Веса = Новый Массив;
		Пока Выборка.СледующийПоЗначениюПоля("Вес") Цикл
			Веса.Добавить(Выборка.Вес);
		КонецЦикла;
		СоответствиеВесовТипоразмерам.Вставить(Выборка.ТипоразмерКТК, Веса);
	КонецЦикла;
	
	Возврат СоответствиеВесовТипоразмерам;
	
