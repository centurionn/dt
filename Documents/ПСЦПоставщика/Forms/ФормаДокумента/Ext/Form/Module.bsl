// Функция обновляет панель состояний документа для графического отражения его движения по состояниям
&НаСервере
Процедура ОбновитьПанельСостояний()

	МаршрутизацияСервер.ОбновитьПанельСостояний(ЭтотОбъект);
	
	КолСостоянийЗавершено = 0;
	
	Для каждого Стр из Объект.Ссылка.Состояния Цикл //Гудкова добавила ссылку
		
		Если Стр.Статус = Перечисления.СтатусыЭтапов.Выполнен Тогда
		
			КолСостоянийЗавершено = КолСостоянийЗавершено + 1;
		
		КонецЕсли;
		
	КонецЦикла;
	
	КоличествоСостоянийВсего = Объект.Ссылка.Состояния.Количество();	
	Если ЗначениеЗаполнено(Объект.Ссылка) И КолСостоянийЗавершено = КоличествоСостоянийВсего И КоличествоСостоянийВсего <> 0 Тогда
		Элементы.ГруппаИнформацияОДокументе.Видимость = Истина;
		
		Элементы.ПредупреждениеРедактирования.Заголовок = "Документ полностью отработан. Запись заблокирована";
	Иначе	
		Элементы.ГруппаИнформацияОДокументе.Видимость = Ложь;
	КонецЕсли;
	
    Элементы.СсылкаНаПротоколВДО.Видимость = ЗначениеЗаполнено(Объект.СсылкаНаВнутреннийДокументДО);

КонецПроцедуры

&НаКлиенте
Процедура ТекущийИсполнитель_СтатусПриИзменении(Элемент)
	//Евросиб Шевченко А.В. US 110215 TA 122847 10.11.2025
	Если ТекущийИсполнитель_Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Выполнен") И ТекущийИсполнитель_Состояние = ПредопределенноеЗначение("Справочник.Состояния.ПроверкаСогласованияОтправкаПодкреплениеПодписанногоПСЦ") И НЕ ЕстьСканКопияВПрисоедененныхФайлах(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(,"Невозможно закрыть задачу маршрута, т.к. в присоединенных файлах нет скан-копии подписанного с двух сторон Протокола.");
		ТекущийИсполнитель_Статус = Неопределено;
		Возврат;
	КонецЕсли;
	//Евросиб Шевченко А.В. US 110215 TA 122847 10.11.2025
	// обновляем информацию по состоянию 
	МаршрутизацияКлиент.ТекущийИсполнитель_СтатусПриИзменении(Объект, ТекущийИсполнитель_Состояние, ТекущийИсполнитель_Статус, ТекущийИсполнитель_Исполнитель, ТекущийИсполнитель_Наблюдатель);
	
	ОбновитьПанельСостояний();
	
КонецПроцедуры

