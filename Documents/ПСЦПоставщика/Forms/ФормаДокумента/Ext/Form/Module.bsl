&НаКлиенте
Процедура УслугиСпособВводаУчетныхЕдиницПриИзменении(Элемент)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	ТекСтрока = Элементы.Услуги.ТекущаяСтрока;
	
	УслугиСпособВводаУчетныхЕдиницПриИзмененииСервер(ТекСтрока);	
	УстановитьВидимостьДоступностьЭлементовДетализацииПоУчетнымЕдиницам(ТекДанные);	
	
	Если ЗаполнятьВниз Тогда
		ВыполнитьЗаполнениеВниз(Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УслугиСпособВводаУчетныхЕдиницПриИзмененииСервер(ТекСтрока)
	
	ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ТекСтрока);
	ОбработатьИзменениеСпособаВводаУчетныхЕдиницВСтрокеУслуг(ТекДанные);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменениеСпособаВводаУчетныхЕдиницВСтрокеУслуг(ТекДанные)
	
	Если ТекДанные.СпособВводаУчетныхЕдиниц = Перечисления.СпособыВводаУчетныхЕдиниц.НеТребуется
			Или ТекДанные.СпособВводаУчетныхЕдиниц = Перечисления.СпособыВводаУчетныхЕдиниц.ПустаяСсылка() Тогда
		УдалитьСтрокуТаблицыУчетныхЕдиниц(, ТекДанные.ИдентификаторСтрокиУслуг);		
	КонецЕсли;
	
	ОбновитьПредставлениеУчетныхЕдиницСтрокиУслуг(ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиТребуетсяДетализацияКомплекснойСтавкиПриИзменении(Элемент)
	
	ТекДанныеУслуги = Элементы.Услуги.ТекущиеДанные;
	УстановитьВидимостьДоступностьЭлементовДетализацииКомплекснойСтавки(ТекДанныеУслуги);
	
	ТекСтрока = Элементы.Услуги.ТекущаяСтрока;
	УслугиТребуетсяДетализацияКомплекснойСтавкиПриИзмененииСервер(ТекСтрока);
	
	РассчитатьСуммуПоСтрокамДетализацииКомплекснойСтавки(ТекДанныеУслуги);
	
	Если ЗаполнятьВниз Тогда
		ВыполнитьЗаполнениеВниз(Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УслугиТребуетсяДетализацияКомплекснойСтавкиПриИзмененииСервер(ТекСтрока)
	
	ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ТекСтрока);
	ОбработатьИзменениеПризнакаДетализацииКомплекснойСтавки(ТекДанные);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменениеПризнакаДетализацииКомплекснойСтавки(СтрокаТЧ)
	
	ИдентификаторСтрокиУслуг = СтрокаТЧ.ИдентификаторСтрокиУслуг;
	СтрокиДетализации = Объект.ДетализацияКомплекснойСтавки.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", ИдентификаторСтрокиУслуг));
	
	Если СтрокаТЧ.ТребуетсяДетализацияКомплекснойСтавки Тогда
		Если Не ЗначениеЗаполнено(СтрокиДетализации) Тогда
			НоваяСтрока = Объект.ДетализацияКомплекснойСтавки.Добавить();
			НоваяСтрока.ИдентификаторСтрокиУслуг = ИдентификаторСтрокиУслуг;
			НоваяСтрока.Номенклатура = СтрокаТЧ.Номенклатура;			
		КонецЕсли;
	Иначе
		Для Каждого СтрокаДетализации Из СтрокиДетализации Цикл
			Объект.ДетализацияКомплекснойСтавки.Удалить(СтрокаДетализации);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиПунктОтправленияНазначенияПриИзменении(Элемент)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	ТекДанные.ПунктОтправления = ТекДанные.ПунктОтправленияНазначения;
	ТекДанные.ПунктНазначения = ТекДанные.ПунктОтправленияНазначения;
	
	УслугиПунктОтправленияНазначенияПриИзмененииСервер(ТекДанные.ПолучитьИдентификатор());
	
	Если ЗаполнятьВниз Тогда
		ВыполнитьЗаполнениеВниз(Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УслугиПунктОтправленияНазначенияПриИзмененииСервер(ТекСтрока)
	
	УслугиПунктОтправленияПриИзмененииСервер(ТекСтрока);
	УслугиПунктНазначенияПриИзмененииСервер(ТекСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиПунктОтправленияНазначенияНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	
	ЛокацииПоТерминалу = ПолучитьЛокацииПоТерминалуКонтрагенту(Объект.Контрагент);
	Если ЗначениеЗаполнено(ЛокацииПоТерминалу) Тогда
		ПараметрыФормы.Вставить("Локации", ЛокацииПоТерминалу);
	КонецЕсли;
	
	ОткрытьФорму("Справочник.Мультилокации.ФормаВыбора", ПараметрыФормы, Элемент,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЛокацииПоТерминалуКонтрагенту(Контрагент)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Локации.Контрагент КАК Контрагент,
	|	Локации.Ссылка КАК Ссылка,
	|	ГоризонтальныеСвязиЛокаций.ЖДСтанция КАК ЖДСтанция,
	|	ГоризонтальныеСвязиЛокаций.Порт КАК Порт
	|ИЗ
	|	Справочник.Локации КАК Локации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГоризонтальныеСвязиЛокаций КАК ГоризонтальныеСвязиЛокаций
	|		ПО Локации.Ссылка = ГоризонтальныеСвязиЛокаций.Терминал
	|ГДЕ
	|	Локации.Контрагент = &Контрагент";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);	
	ВыборкаЛокаций = Запрос.Выполнить().Выбрать();
	
	Локации = Новый Массив;
	Пока ВыборкаЛокаций.Следующий() Цикл
		Если ЗначениеЗаполнено(ВыборкаЛокаций.ЖДСтанция) Тогда
			Если Локации.Найти(ВыборкаЛокаций.ЖДСтанция) = Неопределено Тогда
				Локации.Добавить(ВыборкаЛокаций.ЖДСтанция);
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(ВыборкаЛокаций.Порт) Тогда
			Если Локации.Найти(ВыборкаЛокаций.Порт) = Неопределено Тогда
				Локации.Добавить(ВыборкаЛокаций.Порт);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Локации;
	
КонецФункции

&НаКлиенте
Процедура УслугиСтоимостьСНДСПрогрессивнаяНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда		
		УслугиСтоимостьПрогрессивнаяНачалоВыбора("СтоимостьСНДС", ТекДанные);		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиСтоимостьБезНДСПрогрессивнаяНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда		
		УслугиСтоимостьПрогрессивнаяНачалоВыбора("СтоимостьБезНДС", ТекДанные);		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиСтоимостьПрогрессивнаяНачалоВыбора(ИмяПоляСтоимость, ТекДанные)
	
	Модифицированность = Истина;
	
	ШкалаСтавок = Новый Массив;
	Для каждого Стр из Объект.ШкалаСтавок Цикл
		Если Стр.ИдентификаторСтрокиУслуг = ТекДанные.ИдентификаторСтрокиУслуг Тогда
			ШкалаСтавок.Добавить(Новый Структура("От, До, Стоимость", Стр.От, Стр.До, Стр[ИмяПоляСтоимость]));
		КонецЕсли;
	КонецЦикла;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ИдентификаторСтрокиУслуг", ТекДанные.ИдентификаторСтрокиУслуг);
	ДопПараметры.Вставить("ИдентификаторСтроки", ТекДанные.ПолучитьИдентификатор());
	ДопПараметры.Вставить("ИмяПоляСтоимость", ИмяПоляСтоимость);
	ОповещениеОВводеПрогрессивнойСтавки = Новый ОписаниеОповещения("ОбработкаВводаПрогрессивнойСтавки", ЭтаФорма, ДопПараметры);
	ОткрытьФорму("Документ.ПСЦПоставщика.Форма.ФормаПрогрессивнойШкалы", Новый Структура("ШкалаСтавок", ШкалаСтавок),, ЭтаФорма.УникальныйИдентификатор,,, ОповещениеОВводеПрогрессивнойСтавки, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВводаПрогрессивнойСтавки(ШкалаСтавок, ДопПараметры) Экспорт
	
	Если ШкалаСтавок <> Неопределено Тогда
		ИдентификаторСтроки = ДопПараметры.ИдентификаторСтроки;
		ОбработкаВводаПрогрессивнойСтавкиСервер(ШкалаСтавок, ИдентификаторСтроки, ДопПараметры.ИмяПоляСтоимость);		
		Если ЗаполнятьВниз Тогда
			ВыполнитьЗаполнениеВниз(Неопределено);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВводаПрогрессивнойСтавкиСервер(ШкалаСтавок, ИдентификаторСтроки, ИмяПоляСтоимость)
	
	СтрокаУслуги = Объект.Услуги.НайтиПоИдентификатору(ИдентификаторСтроки);	
	ОбработкаВводаПрогрессивнойСтавкиПоСтрокеУслуг(ШкалаСтавок, СтрокаУслуги, ИмяПоляСтоимость);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВводаПрогрессивнойСтавкиПоСтрокеУслуг(ШкалаСтавок, СтрокаУслуги, ИмяПоляСтоимость)
	
	НайдСтроки = Объект.ШкалаСтавок.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", СтрокаУслуги.ИдентификаторСтрокиУслуг));
	Для Каждого Стр Из НайдСтроки Цикл
		Объект.ШкалаСтавок.Удалить(Стр);
	КонецЦикла;	
	
	СтрокиШкалы = Новый Массив;
	Для каждого Стр из ШкалаСтавок Цикл
			
		СтрокаШкалы = Объект.ШкалаСтавок.Добавить();
		СтрокаШкалы.ИдентификаторСтрокиУслуг = СтрокаУслуги.ИдентификаторСтрокиУслуг;
		СтрокаШкалы.От = Стр.От;
		СтрокаШкалы.До = Стр.До;
		СтрокаШкалы[ИмяПоляСтоимость] = Стр.Стоимость;
				
		СтрокиШкалы.Добавить(СтрокаШкалы);
		
	КонецЦикла;
	
	ПересчитатьСтоимостьПоШкалеСУчетомСтавкиНДС(СтрокаУслуги, ИмяПоляСтоимость, СтрокиШкалы);	
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСтоимостьПоШкалеСУчетомСтавкиНДС(СтрокаУслуги, ИмяПоляСтоимость, ШкалаСтавок = Неопределено)
	
	Если ШкалаСтавок = Неопределено Тогда
		ШкалаСтавок = Объект.ШкалаСтавок.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", СтрокаУслуги.ИдентификаторСтрокиУслуг));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ШкалаСтавок) Тогда		
		
		ЗначениеСтавкиНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСтавкуНДС(СтрокаУслуги.СтавкаНДС);
		СтоимостьСтрокиУслугЗаполнена = Ложь;
		
		Для Каждого СтрокаШкалы Из ШкалаСтавок Цикл
			
			Если ИмяПоляСтоимость = "СтоимостьСНДС" Тогда
				СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСуммуНДС(СтрокаШкалы.СтоимостьСНДС, ЗначениеСтавкиНДС, Истина, Истина);
				СтрокаШкалы.СтоимостьБезНДС = СтрокаШкалы.СтоимостьСНДС - СуммаНДС;			
			Иначе			
				СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСуммуНДС(СтрокаШкалы.СтоимостьБезНДС, ЗначениеСтавкиНДС, Истина, Ложь);
				СтрокаШкалы.СтоимостьСНДС = СтрокаШкалы.СтоимостьБезНДС + СуммаНДС;			
			КонецЕсли;
			
			//Стоимость в строке услуг заполняется первой значимой суммой шкалы
			Если Не СтоимостьСтрокиУслугЗаполнена 
					И (ЗначениеЗаполнено(СтрокаШкалы.СтоимостьСНДС) Или ЗначениеЗаполнено(СтрокаШкалы.СтоимостьБезНДС)) Тогда
				СтрокаУслуги.СтоимостьСНДС = СтрокаШкалы.СтоимостьСНДС;
				СтрокаУслуги.СтоимостьБезНДС = СтрокаШкалы.СтоимостьБезНДС;
				СтоимостьСтрокиУслугЗаполнена = Истина;
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЕсли;
	
	УстановитьТекстСтавки(СтрокаУслуги, ШкалаСтавок);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТекстСтавки(СтрокаУслуги, СтрокиШкалы = Неопределено)
	
	Если СтрокиШкалы = Неопределено Тогда
		СтрокиШкалы = Объект.ШкалаСтавок.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", СтрокаУслуги.ИдентификаторСтрокиУслуг));
	КонецЕсли;
	
	ТекстСтавкиСНДС = "";
	ТекстСтавкиБезНДС = "";
	Для каждого Стр из СтрокиШкалы Цикл
		
		Если Стр.СтоимостьСНДС <> 0 Или Стр.СтоимостьБезНДС <> 0 Тогда
			
			ТекстСтоимостьСНДС = Формат(Стр.СтоимостьСНДС, "ЧДЦ=2; ЧН=0,00");
			ТекстСтоимостьБезНДС = Формат(Стр.СтоимостьБезНДС, "ЧДЦ=2; ЧН=0,00");
			
			Если Стр.От = 0 И Стр.До = 0 Тогда
				ТекстСтавкиСНДС = ТекстСтоимостьСНДС;
				ТекстСтавкиБезНДС = ТекстСтоимостьБезНДС;
			ИначеЕсли Стр.От = 0 И Стр.До <> 0 Тогда
				ТекстСтавкиСНДС = "От 0 до " + Стр.До + " - " + ТекстСтоимостьСНДС + Символы.ПС;
				ТекстСтавкиБезНДС = "От 0 до " + Стр.До + " - " + ТекстСтоимостьБезНДС + Символы.ПС;
			ИначеЕсли Стр.От <> 0 И Стр.До <> 0 Тогда
				ТекстСтавкиСНДС = ТекстСтавкиСНДС + "С " + Стр.От + " до " + Стр.До + " - " + ТекстСтоимостьСНДС + Символы.ПС;
				ТекстСтавкиБезНДС = ТекстСтавкиБезНДС + "С " + Стр.От + " до " + Стр.До + " - " + ТекстСтоимостьБезНДС + Символы.ПС;
			ИначеЕсли Стр.От <> 0 И Стр.До = 0 Тогда
				ТекстСТавкиСНДС = ТекстСтавкиСНДС + "С " + Стр.От + " и далее - " + ТекстСтоимостьСНДС;
				ТекстСТавкиБезНДС = ТекстСтавкиБезНДС + "С " + Стр.От + " и далее - " + ТекстСтоимостьБезНДС;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтрокаУслуги.СтоимостьСНДСПрогрессивная = ТекстСтавкиСНДС;
	СтрокаУслуги.СтоимостьБезНДСПрогрессивная = ТекстСтавкиБезНДС;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиСтавкаПрогрессивнаяПриИзменении(Элемент)
	
	ТекСтрока = Элементы.Услуги.ТекущаяСтрока;
	УслугиСтавкаПрогрессивнаяПриИзмененииСервер(ТекСтрока);
	
	Если ЗаполнятьВниз Тогда
		ВыполнитьЗаполнениеВниз(Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УслугиСтавкаПрогрессивнаяПриИзмененииСервер(ИдентификаторСтроки)
	
	СтрокаУслуги = Объект.Услуги.НайтиПоИдентификатору(ИдентификаторСтроки);
	ОбработатьИзменениеПризнакаСтавкаПрогрессивнаяВСтроке(СтрокаУслуги);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменениеПризнакаСтавкаПрогрессивнаяВСтроке(СтрокаУслуги)
	
	СформироватьШкалуПрогрессивнойСтавки(СтрокаУслуги, Истина);
	
КонецПроцедуры

&НаСервере
Процедура СформироватьШкалуПрогрессивнойСтавки(СтрокаУслуги, ИзмененПризнакПрогрессивнойСтавки)
	
	НайдСтроки = Объект.ШкалаСтавок.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", СтрокаУслуги.ИдентификаторСтрокиУслуг));
	
	Если ИзмененПризнакПрогрессивнойСтавки Тогда
		Для Каждого Стр Из НайдСтроки Цикл
			Объект.ШкалаСтавок.Удалить(Стр);
		КонецЦикла;
	КонецЕсли;

	НоваяШкала = Новый Массив;
	
	Если СтрокаУслуги.СтавкаПрогрессивная Тогда
	
		Если ЗначениеЗаполнено(СтрокаУслуги.СтоимостьБезНДС) Тогда
			ИмяПоляСтоимость = "СтоимостьБезНДС";
		Иначе
			ИмяПоляСтоимость = "СтоимостьСНДС";
		КонецЕсли;
		
		ПоляШкалы = СтрШаблон("От,До,%1", ИмяПоляСтоимость);
		
		НижнийПорогШкалы = 0;
		Если ЗначениеЗаполнено(СтрокаУслуги.СвободныйПериодХраненияПриОтправке) Тогда
			НижнийПорогШкалы = СтрокаУслуги.СвободныйПериодХраненияПриОтправке;
		ИначеЕсли ЗначениеЗаполнено(СтрокаУслуги.СвободныйПериодХраненияПриПриеме) Тогда
			НижнийПорогШкалы = СтрокаУслуги.СвободныйПериодХраненияПриПриеме;
		ИначеЕсли ЗначениеЗаполнено(СтрокаУслуги.СвободныйПериодХраненияУслугиДепо) Тогда
			НижнийПорогШкалы = СтрокаУслуги.СвободныйПериодХраненияУслугиДепо;
		ИначеЕсли ЗначениеЗаполнено(СтрокаУслуги.СвободныйПериодХранения) Тогда
			НижнийПорогШкалы = СтрокаУслуги.СвободныйПериодХранения;
		КонецЕсли;
		//Евросиб Шевченко А.В. US 110215 TA 120129 06.10.2025
		//Евросиб Шевченко А.В. US 86665 TA 120749 19.10.2025
		Если Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.ТЭО Тогда
			Если ЗначениеЗаполнено(СтрокаУслуги.СвободныйПериодХраненияВаг) И НЕ ЗначениеЗаполнено(СтрокаУслуги.СвободныйПериодХраненияКТК) Тогда
				НижнийПорогШкалы= СтрокаУслуги.СвободныйПериодХраненияВаг;
			ИначеЕсли ЗначениеЗаполнено(СтрокаУслуги.СвободныйПериодХраненияВаг) И ЗначениеЗаполнено(СтрокаУслуги.СвободныйПериодХраненияКТК) Тогда
				НижнийПорогШкалы = СтрокаУслуги.СвободныйПериодХраненияКТК;
			ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаУслуги.СвободныйПериодХраненияВаг) И ЗначениеЗаполнено(СтрокаУслуги.СвободныйПериодХраненияКТК) Тогда
				НижнийПорогШкалы = СтрокаУслуги.СвободныйПериодХраненияКТК;
			КонецЕсли;
		КонецЕсли;
		//Евросиб Шевченко А.В. US 86665 TA 120749 19.10.2025
		//Евросиб Шевченко А.В. US 110215 TA 120129 06.10.2025
		Если ИзмененПризнакПрогрессивнойСтавки Тогда
			
			Если НижнийПорогШкалы > 0 Тогда
				
				СтрокаШкалы = Объект.ШкалаСтавок.Добавить();
				СтрокаШкалы.ИдентификаторСтрокиУслуг = СтрокаУслуги.ИдентификаторСтрокиУслуг;
				СтрокаШкалы.От = 0;
				СтрокаШкалы.До = НижнийПорогШкалы;
				СтрокаШкалы[ИмяПоляСтоимость] = 0;
				
				СтрокиШкалы = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СтрокаШкалы);
				
				ТекущийУровеньШкалы = НижнийПорогШкалы + 1;
				
				СтрокаШкалы = Объект.ШкалаСтавок.Добавить();
				СтрокаШкалы.ИдентификаторСтрокиУслуг = СтрокаУслуги.ИдентификаторСтрокиУслуг;
				СтрокаШкалы.От = ТекущийУровеньШкалы;
				СтрокаШкалы.До = 0;
				СтрокаШкалы[ИмяПоляСтоимость] = СтрокаУслуги[ИмяПоляСтоимость];
			
				СтрокиШкалы.Добавить(СтрокаШкалы);
				
			Иначе
				
				СтрокаШкалы = Объект.ШкалаСтавок.Добавить();
				СтрокаШкалы.ИдентификаторСтрокиУслуг = СтрокаУслуги.ИдентификаторСтрокиУслуг;
				СтрокаШкалы.От = 0;
				СтрокаШкалы.До = 0;
				СтрокаШкалы[ИмяПоляСтоимость] = СтрокаУслуги[ИмяПоляСтоимость];
				
				СтрокиШкалы = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СтрокаШкалы);
				
			КонецЕсли;
			
		Иначе
			
			КоличествоСтрокШкалы = НайдСтроки.Количество();
			
			Если НижнийПорогШкалы > 0 Тогда				
				СтрокаШкалы = Новый Структура(ПоляШкалы); 
				СтрокаШкалы.От = 0;
				СтрокаШкалы.До = НижнийПорогШкалы;
				СтрокаШкалы[ИмяПоляСтоимость] = 0;
				НоваяШкала.Добавить(СтрокаШкалы);				
				ТекущийУровеньШкалы = НижнийПорогШкалы + 1;				
			Иначе
				ТекущийУровеньШкалы = 0;
			КонецЕсли;
				
			Если КоличествоСтрокШкалы > 0 Тогда
				
				Для Каждого Стр Из НайдСтроки Цикл
					Если Стр[ИмяПоляСтоимость] <> 0 Тогда
						
						СтрокаШкалы = Новый Структура(ПоляШкалы);
						ЗаполнитьЗначенияСвойств(СтрокаШкалы, Стр, ПоляШкалы);
						СтрокаШкалы.От = ТекущийУровеньШкалы;
						НоваяШкала.Добавить(СтрокаШкалы);
						
						Если СтрокаШкалы.До > СтрокаШкалы.От Тогда
							ТекущийУровеньШкалы = СтрокаШкалы.До + 1;
						Иначе
							Прервать;
						КонецЕсли;
						
					КонецЕсли;
				КонецЦикла;
				
			Иначе
				
				СтрокаШкалы = Новый Структура(ПоляШкалы);					
				СтрокаШкалы.От = ТекущийУровеньШкалы;
				СтрокаШкалы.До = 0;
				СтрокаШкалы[ИмяПоляСтоимость] = СтрокаУслуги[ИмяПоляСтоимость];
				НоваяШкала.Добавить(СтрокаШкалы);
				
			КонецЕсли;
			
			Для Каждого Стр Из НайдСтроки Цикл
				Объект.ШкалаСтавок.Удалить(Стр);
			КонецЦикла;
			
			Для Каждого Стр Из НоваяШкала Цикл
				НоваяСтрока = Объект.ШкалаСтавок.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр, ПоляШкалы);
				НоваяСтрока.ИдентификаторСтрокиУслуг = СтрокаУслуги.ИдентификаторСтрокиУслуг;
			КонецЦикла;
				
		КонецЕсли;
		
		ПересчитатьСтоимостьПоШкалеСУчетомСтавкиНДС(СтрокаУслуги, ИмяПоляСтоимость, СтрокиШкалы);
		
	Иначе
		
		СтрокаУслуги.СтоимостьСНДСПрогрессивная = "";
		СтрокаУслуги.СтоимостьБезНДСПрогрессивная = "";
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиВесГрузаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекДанные.ТипоразмерКТК_Вагона) И ТипЗнч(ТекДанные.ТипоразмерКТК_Вагона) = Тип("СправочникСсылка.ТипоразмерыТЕ") Тогда
		ДоступныеЗначения = ПолучитьВесаПоТипоразмеруТЕ(ТекДанные.ТипоразмерКТК_Вагона);
		ДанныеВыбора = Новый СписокЗначений;
		ДанныеВыбора.ЗагрузитьЗначения(ДоступныеЗначения);
	Иначе
	КонецЕсли;
	
	//Евросиб Шевченко А.В. US 110216 TA 112376 07.08.2025
	//Евросиб Шевченко А.В. US 110215 TA 120129 06.10.2025
	Если Объект.ВидУслугПоставщика = ПредопределенноеЗначение("Справочник.ВидыУслугПоставщиков.Порты") ИЛИ Объект.ВидУслугПоставщика = ПредопределенноеЗначение("Справочник.ВидыУслугПоставщиков.Фрахт")  ИЛИ Объект.ВидУслугПоставщика = ПредопределенноеЗначение("Справочник.ВидыУслугПоставщиков.ТЭО") Тогда
	//Евросиб Шевченко А.В. US 110215 TA 120129 06.10.2025	
		Если ТекДанные.ТипоразмерыКТК.Количество() Тогда
			ДоступныеЗначения = ПолучитьВесаПоТипоразмеруТЕ(ТекДанные.ТипоразмерыКТК);
			ДанныеВыбора = Новый СписокЗначений;
			ДанныеВыбора.ЗагрузитьЗначения(ДоступныеЗначения);
		КонецЕсли;
	КонецЕсли;	
	//Евросиб Шевченко А.В. US 110216 TA 112376 07.08.2025
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВесаПоТипоразмеруТЕ(ТипоразмерТЕ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТипоразмерыТЕВеса.Вес КАК Вес,
		|	ТипоразмерыТЕВеса.Вес.Вес КАК ВесВеса
		|ИЗ
		|	Справочник.ТипоразмерыТЕ.Веса КАК ТипоразмерыТЕВеса
		|ГДЕ
		|	ТипоразмерыТЕВеса.Ссылка В(&ТипоразмерТЕ)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВесВеса";
	
	Запрос.УстановитьПараметр("ТипоразмерТЕ", ТипоразмерТЕ);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Вес");
	
КонецФункции


