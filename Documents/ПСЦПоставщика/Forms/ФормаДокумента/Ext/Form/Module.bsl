	КритерииУслугПоставщиковПустаяСсылка = Справочники.КритерииУслугПоставщиков.ПустаяСсылка();
	ТипоразмерыТЕПустаяСсылка = Справочники.ТипоразмерыТЕ.ПустаяСсылка();
	ТипоразмерыТСПустаяСсылка = Справочники.ТипоразмерыТС.ПустаяСсылка();
	ВидОтправкиПустаяСсылка = Перечисления.ВидыОтправок.ПустаяСсылка();
	КлючНормативнойСтавкиПустаяСсылка = Справочники.КлючиАналитикиСтрокПротокола.ПустаяСсылка();
	
	СостояниеГруженый = Перечисления.СостоянияКТК.Груженый;
	СостояниеПорожний = Перечисления.СостоянияКТК.Порожний;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
