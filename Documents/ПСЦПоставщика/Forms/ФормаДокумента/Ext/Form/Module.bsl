&НаСервере
Процедура ЗаполнитьСписокВыбораВалютыОплаты()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДоговорыКонтрагентов1.ВалютаВзаиморасчетов КАК Валюта
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов.ДоговорыОплаты КАК ДоговорыКонтрагентовДоговорыОплаты
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов1
	|			ПО ДоговорыКонтрагентовДоговорыОплаты.Договор = ДоговорыКонтрагентов1.Ссылка
	|		ПО ДоговорыКонтрагентов.Ссылка = ДоговорыКонтрагентовДоговорыОплаты.Ссылка
	|ГДЕ
	|	ДоговорыКонтрагентов.Ссылка = &Договор
	|	И ДоговорыКонтрагентов.МультивалютныйДоговор";
	
	Запрос.УстановитьПараметр("Договор", Объект.Договор);
	
	Валюты = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Валюта");
	
	ЭлементВалютаОплаты = Элементы.ВалютаОплаты;
	ПараметрыВыбораВалюты = Новый Массив;
	ПараметрыВыбораВалюты.Добавить(Новый ПараметрВыбора("Отбор.ОсновнаяВалюта", Справочники.Валюты.ПустаяСсылка()));
	Если ЗначениеЗаполнено(Валюты) Тогда
		ПараметрыВыбораВалюты.Добавить(Новый ПараметрВыбора("Отбор.Ссылка", Новый ФиксированныйМассив(Валюты)));
	КонецЕсли;
	ЭлементВалютаОплаты.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораВалюты);
	
КонецПроцедуры

&НаКлиенте
Процедура ДействуетДоСогласованияНовыхУсловийПриИзменении(Элемент)
	
	Элементы.ОкончаниеДействия.АвтоОтметкаНезаполненного = Не Объект.ДействуетДоСогласованияНовыхУсловий;
	Если Не Элементы.ОкончаниеДействия.АвтоОтметкаНезаполненного Тогда
		Элементы.ОкончаниеДействия.ОтметкаНезаполненного = Ложь;
	КонецЕсли;
	
	Если Объект.ДействуетДоСогласованияНовыхУсловий И ЗначениеЗаполнено(Объект.ОкончаниеДействия) Тогда
		ПустаяДата = '00010101';
		Объект.ОкончаниеДействия = ПустаяДата;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьРуководителяКонтрагента(Команда)
	
	ОткрытьФорму("РегистрСведений.ДанныеРуководителяКонтрагентов.ФормаЗаписи", Новый Структура("ВызывающаяФорма, Контрагент", ЭтаФорма.УникальныйИдентификатор, Объект.Контрагент),,ЭтаФорма.УникальныйИдентификатор,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПодписантаКонтрагента(Команда)
	
	ПараметрыФормы = Новый Структура("ВызывающаяФорма, Контрагент", ЭтаФорма.УникальныйИдентификатор, Объект.Контрагент);
	ОткрытьФорму("РегистрСведений.ДанныеПодписантовКонтрагентов.ФормаЗаписи", ПараметрыФормы, ЭтаФорма, ЭтаФорма.УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаменитьИсполнителя(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) тогда
		ПоказатьПредупреждение(, "Сначала необходимо сохранить Протокол");
		Возврат;
	КонецЕсли;
	
	ИсходныйПользователь = неопределено;
	Для каждого Стр из Объект.Состояния Цикл
		Если Стр.Состояние = ПредопределенноеЗначение("Справочник.Состояния.ПроверкаРезультатовСогласования") Тогда ИсходныйПользователь = Стр.Исполнитель; КонецЕсли;
	КонецЦикла;
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораЗаменыСогласующего", ЭтаФорма);
	
	ОткрытьФорму("Документ.ПСЦ.Форма.ФормаЗаменыИсполнителяВПротоколе", Новый Структура("ИсходныйПользователь", ИсходныйПользователь),,ЭтаФорма.УникальныйИдентификатор,,, ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораЗаменыСогласующего(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = неопределено Тогда Возврат; КонецЕсли;
	
	ИсхП = П1.ИсходныйПользователь;
	КонП = П1.КонечныйПользователь;
	
	ЗаменятьИсполнителя = П1.ЗаменятьИсполнителя;
	ЗаменятьНаблюдателя = П1.ЗаменятьНаблюдателя;
	
	ЗаменяемыеСтатусы = П1.ЗаменяемыеСтатусы;
	
	Для каждого Стр из Объект.Состояния Цикл
		
		Если ЗаменяемыеСтатусы.Найти(Стр.Статус) <> неопределено Тогда
			Если Стр.Исполнитель = ИсхП И ЗаменятьИсполнителя Тогда Стр.Исполнитель = КонП; КонецЕсли;
			Если Стр.Наблюдатель = ИсхП И ЗаменятьНаблюдателя Тогда Стр.Наблюдатель = КонП; КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ТакжеЗаменитьВКарточкеСогласования(П1, Объект.Ссылка);
	
	ОбновитьПанельСостояний();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ТакжеЗаменитьВКарточкеСогласования(П1, Ссылка)
	
	ТекПроцессСогл = ПечатьБухгалтерскихДокументов.ПроверитьНаличиеПроцесса(Ссылка);
	Если НЕ ЗначениеЗаполнено(ТекПроцессСогл) Тогда Возврат; КонецЕсли;
	
	ПроцессО = ТекПроцессСогл.ПолучитьОбъект();
	
	ИсхП = П1.ИсходныйПользователь;
	КонП = П1.КонечныйПользователь;
	
	ЗаменятьИсполнителя = П1.ЗаменятьИсполнителя;
	ЗаменятьНаблюдателя = П1.ЗаменятьНаблюдателя;
	
	ЗаменяемыеСтатусы = П1.ЗаменяемыеСтатусы;
	
	Для каждого Стр из ПроцессО.Состояния Цикл
		
		Если ЗаменяемыеСтатусы.Найти(Стр.Статус) <> неопределено Тогда
			Если Стр.Исполнитель = ИсхП И ЗаменятьИсполнителя Тогда Стр.Исполнитель = КонП; КонецЕсли;
			Если Стр.Наблюдатель = ИсхП И ЗаменятьНаблюдателя Тогда Стр.Наблюдатель = КонП; КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ПроцессО.Записать();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьНаСогласование(Команда)
	
	Если ЭтаФорма.Модифицированность Тогда 
		Записать(); 
	КонецЕсли;
		  
	ЕстьСогласованиеВСтатусеОтличнымОтПланируется = Ложь;
	
	ДанныеЕсть = Ложь;
	Для Каждого Стр Из объект.Состояния Цикл
		Если ЭтоСогласование(Стр.Состояние) Тогда
			ДанныеЕсть = Истина;
	
			Если Стр.Статус <> ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Новый") Тогда
				ЕстьСогласованиеВСтатусеОтличнымОтПланируется = Истина;
			КонецЕсли;
	
		КонецЕсли;
	КонецЦикла;
	Если ДанныеЕсть = Ложь Тогда
		Сообщить("В таблице Состояния нет ни одного согласования!");
		Возврат;
	КонецЕсли;
    
	Если Не ЕстьСогласованиеВСтатусеОтличнымОтПланируется Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("ПСЦ не передан на согласование, необходимо выполнить предшествующие этапы");
		Возврат;
	КонецЕсли;
	
	Если Не Объект.Типовой И НЕ ПроверкаНаПрикрепленные(Объект.Ссылка) Тогда
		Сообщить("Протокол является нетиповым! Прикрепите файлы!");
		Возврат;
	КонецЕсли;

	ОповещениеОСогласовании = Новый ОписаниеОповещения("ОбработкаСогласования", ЭтаФорма);
	
	ТекПроцессСогл = ПечатьБухгалтерскихДокументов.ПроверитьНаличиеПроцесса(Объект.Ссылка);
	Если ТекПроцессСогл = ПредопределенноеЗначение("Справочник.ПроцессСогласования.ПустаяСсылка") Тогда
		ПараметрыФормы = Новый Структура("ДокументСогласования", Объект.Ссылка);
		ЗначенияЗаполнения = Новый Структура("ДокументСогласования", Объект.Ссылка);
		ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	Иначе
		ПараметрыФормы = Новый Структура("Ключ", ТекПроцессСогл);
	КонецЕсли;
	
	ОткрытьФорму("Справочник.ПроцессСогласования.ФормаОбъекта", ПараметрыФормы,ЭтаФорма, ЭтаФорма.УникальныйИдентификатор,,,ОповещениеОСогласовании, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаСогласования(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	ЭтаФорма.ОбновитьОтображениеДанных();
	ОбновитьБлокировкуЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтозватьСогласование(Команда)

	// Евросиб US 89887 TA 89889 Рыбьяков К.А. 18.11.2024 ((
	ЕстьСозданныеНаОснованииРелизы = ОбщегоНазначенияВызовСервера.НаОснованииДокументаСозданыРелизы(Объект.Ссылка);
	Если ЕстьСозданныеНаОснованииРелизы Тогда
		ТекстСообщения = НСтр("ru = 'К ПСЦ есть Релиз собственника, требуется отменить его проведение.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 18.11.2024 ))
	
	ОпОп = Новый ОписаниеОповещения("ОтменаСогласования", ЭтаФорма);
	ПоказатьВопрос(ОпОп, "Протокол будет возвращен на этап ввода, а информация о результатах согласования стерта. Продолжить?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменаСогласования(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;  
	
	ПараметрыЗапроса = ПолучитьПараметрыМаршрутизацииНаСервере(Объект);
	РезультатЗапроса = МаршрутизацияСервер.МаршрутизироватьПСЦ(ПараметрыЗапроса, объект.Дата); 
	
	Для Каждого Стр Из РезультатЗапроса Цикл  
		Если Не ЗначениеЗаполнено(Стр.Исполнитель) Тогда
			Продолжить;
		КонецЕсли;
		Отбор = Новый Структура("Состояние", Стр.Состояние);
		НайденныеСтроки = Объект.Состояния.НайтиСтроки(Отбор);
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл 
			НайденнаяСтрока.Исполнитель = Стр.Исполнитель;
		КонецЦикла;
	КонецЦикла;
	
	Оповещение = Новый ОписаниеОповещения("ОтменаСогласованияПродолжение", ЭтаФорма);	
	ОткрытьФорму("ОбщаяФорма.ОтзывСогласования",, ЭтаФорма,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтрокиСогласования()
	
	ПоляСтрокиСогласования = "Состояние, Исполнитель, Наблюдатель, НомерСтроки, Статус";
	ОтзываемыеСогласования = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Состояния.НомерСтроки КАК НомерСтроки,
	|	Состояния.Состояние КАК Состояние,
	|	Состояния.Исполнитель КАК Исполнитель,
	|	Состояния.Наблюдатель КАК Наблюдатель,
	|	Состояния.Статус КАК Статус
	|ПОМЕСТИТЬ Состояния
	|ИЗ
	|	&Состояния КАК Состояния
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Состояния.НомерСтроки КАК НомерСтроки,
	|	Состояния.Состояние КАК Состояние,
	|	Состояния.Исполнитель КАК Исполнитель,
	|	Состояния.Наблюдатель КАК Наблюдатель,
	|	Состояния.Статус КАК Статус
	|ИЗ
	|	Состояния КАК Состояния
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Состояния КАК Состояния1
	|		ПО Состояния.Состояние = Состояния1.Ссылка
	|ГДЕ
	|	Состояния1.Согласование
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Запрос.УстановитьПараметр("Состояния", Объект.Состояния.Выгрузить());
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл		
		Согласование = Новый Структура(ПоляСтрокиСогласования);
		ЗаполнитьЗначенияСвойств(Согласование, Выборка);
		ОтзываемыеСогласования.Добавить(Согласование);
	КонецЦикла;
	
	Возврат ОтзываемыеСогласования;
	
КонецФункции

&НаКлиенте
Процедура ОтменаСогласованияПродолжение(Комментарий, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Комментарий) Тогда		
		Возврат;
	КонецЕсли;  
	
	ПараметрыЗапроса = ПолучитьПараметрыМаршрутизацииНаСервере(Объект);
	РезультатЗапроса = МаршрутизацияСервер.МаршрутизироватьПСЦПоставщика(ПараметрыЗапроса, объект.Дата); 
	
	Для Каждого Стр Из РезультатЗапроса Цикл  
		
		Если Не ЗначениеЗаполнено(Стр.Исполнитель) Тогда
			Продолжить;
		КонецЕсли;
		
		Отбор = Новый Структура("Состояние", Стр.Состояние);
		НайденныеСтроки = Объект.Состояния.НайтиСтроки(Отбор);
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл 
			НайденнаяСтрока.Исполнитель = Стр.Исполнитель;
		КонецЦикла;
		
	КонецЦикла;
	
	ВозвращаемыеЗадачи = Новый Массив;
	Если Объект.Состояния.Количество() > 0 Тогда
		СтрСостояния = Объект.Состояния[0];
		СтрСостояния.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.ВРаботе");
		СтрСостояния.ВыполнениеЗафиксировано = Ложь;
		ВозвращаемыеЗадачи.Добавить(СтрСостояния.Состояние);
	КонецЕсли;
	
	Для Сч = 1 По Объект.Состояния.Количество()-1 Цикл
		
		Объект.Состояния[Сч].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Новый");
		Если ЗначениеЗаполнено(Объект.Состояния[Сч].СтатусСогласования) Тогда
			Объект.Состояния[Сч].СтатусСогласования = ПредопределенноеЗначение("Перечисление.СтатусыСогласования.Планируется");
			//Объект.Состояния[Сч].Комментарий = Комментарий;
			Объект.Состояния[Сч].АвтоматическоеСогласование = Ложь;
		КонецЕсли;
		
		Объект.Состояния[Сч].ВыполнениеЗафиксировано = Ложь;
		ВозвращаемыеЗадачи.Добавить(Объект.Состояния[Сч].Состояние);
		
	КонецЦикла;
	
	Объект.ДатаСогласования=Дата(1,1,1);	
	Объект.ПодписанСДвухСторон = Ложь;
	
	ПараметрыОтменыСогласования = Новый Структура;
	ПараметрыОтменыСогласования.Вставить("ВозвращаемыеЗадачи", ВозвращаемыеЗадачи);
	ПараметрыОтменыСогласования.Вставить("Комментарий", Комментарий);	
	ЗаписатьОтменуСогласования(ПараметрыОтменыСогласования);
	
	ОбновитьПанельТекущегоПользователя();
	ОбновитьПанельСостояний();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьОтменуСогласования(ПараметрыОтменыСогласования)
	
	УстановитьПривилегированныйРежим(Истина);
	
	//Евросиб Каблов 08.01.2025 ( #97984
	ТекДата = ТекущаяДата();
	ТекПользователь = Пользователи.ТекущийПользователь();
	ДанныеПроцессаСогласования = СогласованиеСервер.ПолучитьПроцессСогласованияОбъекта(Объект.Ссылка);	
	//Евросиб Каблов 08.01.2025 )
	
    НачатьТранзакцию();
	
	ПараметрыЗаписи = Новый Структура("РежимЗаписи, ИзмененыТолькоРазрешенныеПоля", РежимЗаписиДокумента.ОтменаПроведения, Истина);
	ПараметрыЗаписи.Вставить("ВозвращаемыеЗадачи", ПараметрыОтменыСогласования.ВозвращаемыеЗадачи);
	
	Записать(ПараметрыЗаписи);
	
	//Евросиб Каблов 08.01.2025 ( #97984
	МЗ = РегистрыСведений.Рецензирование.СоздатьМенеджерЗаписи();
	МЗ.ЦиклСогласования = ДанныеПроцессаСогласования.ШагЦикла;
	МЗ.РецензОбъект = Объект.Ссылка;
	МЗ.Рецензент = ТекПользователь;
	МЗ.ТаймШтамп = ТекДата;
	МЗ.Комментарии = ПараметрыОтменыСогласования.Комментарий;
	МЗ.Действие = Перечисления.СтатусыЭтапов.Отозван;
	//МЗ.СтатусОбъекта = ДанныеПроцессаСогласования.СтатусДокумента;
	МЗ.СтатусОбъекта = Перечисления.СтатусыСогласования.Планируется;
	Если ТекПользователь = Объект.Автор Тогда
		МЗ.РольИсполнителя = "Автор  документа";
	Иначе
		
		Для Каждого Стр Из Объект.ПримененныйМаршрут.Состояния Цикл
			Если ТипЗнч(Стр.Исполнитель) = Тип("СправочникСсылка.ГруппыПользователей") Тогда
				МассивИсполнителей = Пользователи_sd_сервер.ПолучитьПользователейГруппы(Стр.Исполнитель, ТекДата, Истина);
				Если МассивИсполнителей.Найти(ТекПользователь) <> Неопределено Тогда
					МЗ.РольИсполнителя = Стр.Исполнитель; 
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если Не ЗначениеЗаполнено(МЗ.РольИсполнителя) Тогда
			ГруппыПользователя = Пользователи_sd_сервер.ПолучитьСписокМоихГрупп(ТекПользователь, Ложь);
			Для Каждого ГруппаПользователя Из ГруппыПользователя Цикл
				Если ТипЗнч(ГруппаПользователя) = Тип("СправочникСсылка.ГруппыПользователей") И ГруппаПользователя <> Справочники.ГруппыПользователей.ВсеПользователи Тогда
					МЗ.РольИсполнителя = ГруппаПользователя;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	МЗ.Записать(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Файлы.Ссылка КАК Ссылка,
	|	Файлы.Наименование КАК Наименование,
	|	Файлы.Расширение КАК Расширение,
	|	Файлы.ФайлХранилище КАК ФайлХранилище,
	|	Файлы.ПутьКФайлу КАК ПутьКФайлу
	|ИЗ
	|	Справочник.Файлы КАК Файлы
	|ГДЕ
	|	Файлы.ВладелецФайла = &ВладелецФайла
	|	И НЕ Файлы.ПометкаУдаления
	|	И Файлы.Наименование ПОДОБНО &Наименование";
	Запрос.УстановитьПараметр("ВладелецФайла", Объект.Ссылка);
	Запрос.УстановитьПараметр("Наименование", "%Лист согласования%");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ФайлОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ФайлОбъект.УстановитьПометкуУдаления(Истина);
	КонецЦикла;
	//Евросиб Каблов 08.01.2025 )
	
	ЗафиксироватьТранзакцию();
	//Евросиб Шевченко А.В. US 131501 TA 131502 18.03.2026
	ПараметрыЗаписи = Новый Структура("РежимЗаписи, ИзмененыТолькоРазрешенныеПоля", РежимЗаписиДокумента.Запись, Истина);	
	Записать(ПараметрыЗаписи);
	//Евросиб Шевченко А.В. US 131501 TA 131502 18.03.2026
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура Рецензирование(Команда)
	
	ПараметрыФормы = Новый Структура("РецензОбъект", Объект.Ссылка);
	ОткрытьФорму("ОбщаяФорма.РецензированиеПриСогласовании", ПараметрыФормы,, ЭтаФорма.УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ЛистСогласования(Команда)
	
	ТабДок = МаршрутизацияСервер.ПолучитьТабдокЛистаСогласования(Объект.Ссылка);
	ТабДок.Показать();
	
КонецПроцедуры

&НаКлиенте
Процедура СтавкаНДСПриИзменении(Элемент)
	
	ЗаполнитьСтавкуНДСВСтрокаУслугСервер();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтавкуНДСВСтрокаУслугСервер()
	
	СоответствиеРеквизитовНоменклатуры = ПолучитьЗначенияРеквизитовНоменклатурыУслуг();
	СтавкаНДСПустаяСсылка = Перечисления.СтавкиНДС.ПустаяСсылка();
	
	Для Каждого СтрокаТЧ Из Объект.Услуги Цикл
		
		СтрокаТЧ.СтавкаНДС = СтавкаНДСПустаяСсылка;
		РеквизитыНоменклатуры = СоответствиеРеквизитовНоменклатуры.Получить(СтрокаТЧ.Номенклатура);
		Если ЗначениеЗаполнено(РеквизитыНоменклатуры) И ЗначениеЗаполнено(РеквизитыНоменклатуры.СтавкаНДСПоставщика) Тогда
			СтавкаНДСПоставщика = РеквизитыНоменклатуры.СтавкаНДСПоставщика;
		Иначе
			СтавкаНДСПоставщика = Неопределено;
		КонецЕсли;
		ЗаполнитьСтавкуНДСВСтрокеУслуг(СтрокаТЧ, СтавкаНДСПоставщика);
		
		ПересчитатьСтоимостьСУчетомСтавкиНДС(СтрокаТЧ);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыУслуги

&НаКлиенте
Процедура УслугиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		ТекДанные = Элементы.Услуги.ТекущиеДанные;
		ТекДанные.ИдентификаторСтрокиУслуг = Строка(Новый УникальныйИдентификатор);
		
		Если Копирование Тогда
			
			ТекДанные.Критерий = Неопределено;
			ТекДанные.Критерии.Очистить();
			
			Если ЗначениеЗаполнено(ИдентификаторКопируемойСтрокиУслуг) Тогда
				
				КопируемаяДетализация = Объект.ДетализацияКомплекснойСтавки.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", ИдентификаторКопируемойСтрокиУслуг));
				Для Каждого Стр Из КопируемаяДетализация Цикл
					НовСтр = Объект.ДетализацияКомплекснойСтавки.Добавить();
					ЗаполнитьЗначенияСвойств(НовСтр, Стр,, "ИдентификаторСтрокиУслуг");
					НовСтр.ИдентификаторСтрокиУслуг = ТекДанные.ИдентификаторСтрокиУслуг;
				КонецЦикла;
				
				КопируемаяДетализация = Объект.ШкалаСтавок.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", ИдентификаторКопируемойСтрокиУслуг));
				Для Каждого Стр Из КопируемаяДетализация Цикл
					НовСтр = Объект.ШкалаСтавок.Добавить();
					ЗаполнитьЗначенияСвойств(НовСтр, Стр,, "ИдентификаторСтрокиУслуг");
					НовСтр.ИдентификаторСтрокиУслуг = ТекДанные.ИдентификаторСтрокиУслуг;
				КонецЦикла;
				
				КопируемаяДетализация = Объект.УчетныеЕдиницы.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", ИдентификаторКопируемойСтрокиУслуг));
				Для Каждого Стр Из КопируемаяДетализация Цикл
					НовСтр = Объект.УчетныеЕдиницы.Добавить();
					ЗаполнитьЗначенияСвойств(НовСтр, Стр,, "ИдентификаторСтрокиУслуг");
					НовСтр.ИдентификаторСтрокиУслуг = ТекДанные.ИдентификаторСтрокиУслуг;
				КонецЦикла;
				
			КонецЕсли;
			
		Иначе
		
			Если Не ЗначениеЗаполнено(ТекДанные.СтавкаНДС) Тогда
				
				Если ЗначениеЗаполнено(ТекДанные.Номенклатура) Тогда
					СтавкаНДСПоставщика = ОбщегоНазначенияВызовСервера.ЗначениеРеквизитаОбъекта(ТекДанные.Номенклатура, "СтавкаНДСПоставщика");
					Если ЗначениеЗаполнено(СтавкаНДСПоставщика) Тогда
						ТекДанные.СтавкаНДС = СтавкаНДСПоставщика;
					КонецЕсли;
				КонецЕсли;
				
			    Если Не ЗначениеЗаполнено(ТекДанные.СтавкаНДС) Тогда
					ТекДанные.СтавкаНДС = Объект.СтавкаНДС;
				КонецЕсли;
				
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ТекДанные.Валюта) Тогда
				Если ЗначениеЗаполнено(ПараметрыВидаУслуг.ВалютаПоУмолчанию) Тогда
					ТекДанные.Валюта = ПараметрыВидаУслуг.ВалютаПоУмолчанию;
				Иначе
					ТекДанные.Валюта = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(Объект.Договор, "ВалютаВзаиморасчетов");
				КонецЕсли;
			КонецЕсли;
			
			ОписаниеПоля = ПараметрыВидаУслуг.ПоляТаблицыУслуг.Получить("ВариантОпределенияДатыКурсаВалют");
			Если ОписаниеПоля <> Неопределено И Не ЗначениеЗаполнено(ТекДанные.ВариантОпределенияДатыКурсаВалют) Тогда
				ТекДанные.ВариантОпределенияДатыКурсаВалют = Объект.ВариантОпределенияДатыКурсаВалют;
			КонецЕсли;
			
			Для Каждого Элемент Из ПараметрыВидаУслуг.ЗначенияПолейПоУмолчанию Цикл
				ТекДанные[Элемент.Ключ] = Элемент.Значение;
			КонецЦикла;
			
			//Приоритет локаций при выборе. Возможность выбора мультилокаций после очисти поля.
			ЛокацияПустаяСсылка = ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
			ТекДанные.ПунктОтправления = ЛокацияПустаяСсылка;
			ТекДанные.ПунктНазначения = ЛокацияПустаяСсылка;
			ТекДанные.СтанцииПогранпереходов = ЛокацияПустаяСсылка;
			ТекДанные.ПунктОтправленияГород = ЛокацияПустаяСсылка;
			ТекДанные.ПунктНазначенияГород = ЛокацияПустаяСсылка;
			ТекДанные.ПунктОтправленияСтрана = ЛокацияПустаяСсылка;
			Текданные.ПунктНазначенияСтрана = ЛокацияПустаяСсылка;
			Текданные.ЛокацияОказанияУслуги = ЛокацияПустаяСсылка; //Евросиб Шевченко А.В. US 110216 TA 112376 07.08.2025
			АдресПустаяСсылка = ПредопределенноеЗначение("Справочник.АдресаВНаселенныхПунктах.ПустаяСсылка");
			ТекДанные.АдресСкладаПогрузкиВыгрузки = АдресПустаяСсылка;
			
		КонецЕсли;
		
		ТекДанные.ПроверкаСтавок = ПредопределенноеЗначение("Перечисление.РезультатыПроверки.НеОсуществлялась");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("Подключаемый_ОбработатьАктивизациюСтрокиУслуг", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбработатьАктивизациюСтрокиУслуг() Экспорт
	
	ТекДанныеУслуги = Элементы.Услуги.ТекущиеДанные;
	
	Если ТекДанныеУслуги <> Неопределено Тогда
		ИдентификаторСтрокиУслуг = ТекДанныеУслуги.ИдентификаторСтрокиУслуг;
		
		Если ЗначениеЗаполнено(ПараметрыВидаУслуг.ТипУчетныхЕдиницДетализации) Тогда
			Элементы.СписокУчетныхЕдиницУчетнаяЕдиницаСсылка.ОграничениеТипа = Новый ОписаниеТипов(ПараметрыВидаУслуг.ТипУчетныхЕдиницДетализации);
		ИначеЕсли ТекДанныеУслуги.ТипУчетныхЕдиниц = "СправочникСсылка.ТЕ" Тогда
			Элементы.СписокУчетныхЕдиницУчетнаяЕдиницаСсылка.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.ТЕ");
		ИначеЕсли ТекДанныеУслуги.ТипУчетныхЕдиниц = "СправочникСсылка.ТС" Тогда
			Элементы.СписокУчетныхЕдиницУчетнаяЕдиницаСсылка.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.ТС");
		Иначе
			Элементы.СписокУчетныхЕдиницУчетнаяЕдиницаСсылка.ОграничениеТипа = Новый ОписаниеТипов();
		КонецЕсли;
	
	Иначе
		ИдентификаторСтрокиУслуг = -1;
	КонецЕсли;
	СтруктураОтбора = Новый Структура("ИдентификаторСтрокиУслуг", ИдентификаторСтрокиУслуг);
	
	Элементы.ДетализацияКомплекснойСтавки.ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураОтбора);
	Элементы.УчетныеЕдиницы.ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураОтбора);
	Элементы.СписокУчетныхЕдиниц.ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураОтбора);
	
	УстановитьВидимостьДоступностьЭлементовДетализацииПоУчетнымЕдиницам(ТекДанныеУслуги);
	УстановитьВидимостьДоступностьЭлементовДетализацииКомплекснойСтавки(ТекДанныеУслуги);
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	
	Если Поле = Элементы.УслугиКритерии Или Поле = Элементы.УслугиКритерииСтрокой Тогда
		
		СтандартнаяОбработка = Ложь;
		
		СписокКритериев = Новый СписокЗначений;
		Для Каждого ЭлементСписка Из ТекДанные.Критерии Цикл
			СписокКритериев.Добавить(ЭлементСписка.Значение,,, БиблиотекаКартинок.ПолеВводаОткрыть);
		КонецЦикла;
		
		ОповещениеОВыборе = Новый ОписаниеОповещения("ОбработкаВыбораКритерия", ЭтаФорма);
		ПоказатьВыборИзСписка(ОповещениеОВыборе, СписокКритериев, Элемент);
		
	ИначеЕсли Поле = Элементы.УслугиКлючиНормативныхСтавок Или Поле = Элементы.УслугиКлючиНормативныхСтавокСтрокой Тогда
		
		СтандартнаяОбработка = Ложь;
		
		СписокКлючейНормативныхСтавок = Новый СписокЗначений;
		Для Каждого ЭлементСписка Из ТекДанные.КлючиНормативныхСтавок Цикл
			СписокКлючейНормативныхСтавок.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление,, БиблиотекаКартинок.ПолеВводаОткрыть);
		КонецЦикла;
		
		Для Каждого ЭлементСписка Из ТекДанные.КлючиНеподошедшихНормативныхСтавок Цикл
			СписокКлючейНормативныхСтавок.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление,, БиблиотекаКартинок.ПолеВводаОткрыть);
		КонецЦикла;
		
		ОповещениеОВыборе = Новый ОписаниеОповещения("ОбработкаВыбораКлючаНормативнойСтавки", ЭтаФорма);
		ПоказатьВыборИзСписка(ОповещениеОВыборе, СписокКлючейНормативныхСтавок, Элемент);
		
	ИначеЕсли Поле = Элементы.УслугиПунктОтправления Тогда
		
		Если Элементы.УслугиПунктОтправления.ТолькоПросмотр Тогда
			СтандартнаяОбработка = Ложь;
			Если ЗначениеЗаполнено(ТекДанные.ПунктОтправления) Тогда
				ПоказатьЗначение(, ТекДанные.ПунктОтправления);
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Поле = Элементы.УслугиПунктОтправленияГород Тогда
		
		Если Элементы.УслугиПунктОтправленияГород.ТолькоПросмотр Тогда
			СтандартнаяОбработка = Ложь;
			Если ЗначениеЗаполнено(ТекДанные.ПунктОтправленияГород) Тогда
				ПоказатьЗначение(, ТекДанные.ПунктОтправленияГород);
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Поле = Элементы.УслугиПунктОтправленияСтрана Тогда
		
		Если Элементы.УслугиПунктОтправленияСтрана.ТолькоПросмотр Тогда
			СтандартнаяОбработка = Ложь;
			Если ЗначениеЗаполнено(ТекДанные.ПунктОтправленияСтрана) Тогда
				ПоказатьЗначение(, ТекДанные.ПунктОтправленияСтрана);
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Поле = Элементы.УслугиПунктНазначения Тогда
		
		Если Элементы.УслугиПунктНазначения.ТолькоПросмотр Тогда
			СтандартнаяОбработка = Ложь;
			Если ЗначениеЗаполнено(ТекДанные.ПунктНазначения) Тогда
				ПоказатьЗначение(, ТекДанные.ПунктНазначения);
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Поле = Элементы.УслугиПунктНазначенияГород Тогда
		
		Если Элементы.УслугиПунктНазначенияГород.ТолькоПросмотр Тогда
			СтандартнаяОбработка = Ложь;
			Если ЗначениеЗаполнено(ТекДанные.ПунктНазначенияГород) Тогда
				ПоказатьЗначение(, ТекДанные.ПунктНазначенияГород);
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Поле = Элементы.УслугиПунктНазначенияСтрана Тогда
		
		Если Элементы.УслугиПунктНазначенияСтрана.ТолькоПросмотр Тогда
			СтандартнаяОбработка = Ложь;
			Если ЗначениеЗаполнено(ТекДанные.ПунктНазначенияСтрана) Тогда
				ПоказатьЗначение(, ТекДанные.ПунктНазначенияСтрана);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьДоступностьЭлементовДетализацииПоУчетнымЕдиницам(ТекДанныеУслуги)
	
	Если ТекДанныеУслуги <> Неопределено Тогда 
		
		Если ТекДанныеУслуги.СпособВводаУчетныхЕдиниц = ПредопределенноеЗначение("Перечисление.СпособыВводаУчетныхЕдиниц.Построчно") Тогда
			
			Элементы.СписокУчетныхЕдиницУчетнаяЕдиницаСсылка.Видимость = Истина;
			Элементы.СписокУчетныхЕдиницУчетнаяЕдиница.Видимость = Ложь;
			ДоступностьВставкиУчетныхЕдиниц = Истина;
			
		ИначеЕсли ТекДанныеУслуги.СпособВводаУчетныхЕдиниц = ПредопределенноеЗначение("Перечисление.СпособыВводаУчетныхЕдиниц.Списком") Тогда
			Элементы.СписокУчетныхЕдиницУчетнаяЕдиницаСсылка.Видимость = Ложь;
			Элементы.СписокУчетныхЕдиницУчетнаяЕдиница.Видимость = Истина;
			ДоступностьВставкиУчетныхЕдиниц = Истина;
		Иначе
			Элементы.СписокУчетныхЕдиницУчетнаяЕдиницаСсылка.Видимость = Истина;
			Элементы.СписокУчетныхЕдиницУчетнаяЕдиница.Видимость = Ложь;
			ДоступностьВставкиУчетныхЕдиниц = Ложь;
		КонецЕсли;
		
		ДоступенВводКонтейнеров = Ложь;
		ДоступенВводВагонов = Ложь;
		Если ЗначениеЗаполнено(ПараметрыВидаУслуг.ТипУчетныхЕдиницДетализации) Тогда
			Если СтрНайти(ПараметрыВидаУслуг.ТипУчетныхЕдиницДетализации, "СправочникСсылка.ТЕ") Тогда
				ДоступенВводКонтейнеров = Истина;			
			КонецЕсли;
			Если СтрНайти(ПараметрыВидаУслуг.ТипУчетныхЕдиницДетализации, "СправочникСсылка.ТС") Тогда
				ДоступенВводВагонов = Истина;			
			КонецЕсли;
		ИначеЕсли ТекДанныеУслуги.ТипУчетныхЕдиниц = "СправочникСсылка.ТЕ" Тогда
			ДоступенВводКонтейнеров = Истина;
		ИначеЕсли ТекДанныеУслуги.ТипУчетныхЕдиниц = "СправочникСсылка.ТС" Тогда
			ДоступенВводВагонов = Истина;
		Иначе
			ДоступенВводКонтейнеров = Истина;
			ДоступенВводВагонов = Истина;
		КонецЕсли;
		
	Иначе
		
		ДоступностьВставкиУчетныхЕдиниц = Ложь;
		
	КонецЕсли;
	
	Элементы.СписокУчетныхЕдиниц.Доступность = ДоступностьВставкиУчетныхЕдиниц;
	Элементы.УслугиВставитьСписокВагоновИзExcel.Доступность = ДоступностьВставкиУчетныхЕдиниц И ДоступенВводВагонов;
	Элементы.УслугиВставитьСписокКТКИзExcel.Доступность = ДоступностьВставкиУчетныхЕдиниц И ДоступенВводКонтейнеров;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьДоступностьЭлементовДетализацииКомплекснойСтавки(ТекДанныеУслуги)
	
	Если ТекДанныеУслуги <> Неопределено Тогда 
		ДоступностьДетализацииКомплекснойСтавки = ТекДанныеУслуги.ТребуетсяДетализацияКомплекснойСтавки;
	Иначе
		ДоступностьДетализацииКомплекснойСтавки = Ложь;
	КонецЕсли;
	
	Элементы.ДетализацияКомплекснойСтавки.Доступность = ДоступностьДетализацииКомплекснойСтавки;
	
	РассчитатьСуммуПоСтрокамДетализацииКомплекснойСтавки(ТекДанныеУслуги);
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиНоменклатураПоставщикаПриИзменении(Элемент)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекДанные.НоменклатураПоставщика) Тогда		
		УслугиНоменклатураПоставщикаПриИзмененииСервер(ТекДанные.ПолучитьИдентификатор());				
	КонецЕсли;
	
	Если ЗаполнятьВниз Тогда
		ВыполнитьЗаполнениеВниз(Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УслугиНоменклатураПоставщикаПриИзмененииСервер(ТекСтрока)
	
	ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ТекСтрока);
	
	ДанныеНоменклатурыПоставщика = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекДанные.НоменклатураПоставщика, "Номенклатура, Наименование");
	Если ЗначениеЗаполнено(ДанныеНоменклатурыПоставщика.Номенклатура) Тогда
		ТекДанные.Номенклатура = ДанныеНоменклатурыПоставщика.Номенклатура;
		ОбработатьИзменениеНоменклатурыВСтроке(ТекДанные);
		ПроверитьИУстановитьПризнакТиповой();
	КонецЕсли;
	
	ТекДанные.НаименованиеНоменклатурыПоставщика = ДанныеНоменклатурыПоставщика.Наименование;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиНоменклатураПриИзменении(Элемент)
	
	ТекСтрока = Элементы.Услуги.ТекущаяСтрока;
	УслугиНоменклатураПриИзмененииСервер(ТекСтрока);
	
	Если ЗаполнятьВниз Тогда
		ВыполнитьЗаполнениеВниз(Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УслугиНоменклатураПриИзмененииСервер(ТекСтрока)
	
	ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ТекСтрока);
	ОбработатьИзменениеНоменклатурыВСтроке(ТекДанные);
	ЗначенияПолей = ОпредилитьОбязательностьЗаполненияПолейПоДопУсловиям(ТекДанные); //Евросиб Шевченко А.В. US 83101 TA 122833 07.11.2025
	Для Каждого ОбязательноеПоле Из ЗначенияПолей Цикл
		ТекДанные[ОбязательноеПоле.ИмяРек] = ОбязательноеПоле.Значение;
	КонецЦикла;
	ПроверитьИУстановитьПризнакТиповой();
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьИУстановитьПризнакТиповой()
	
	ТолькоПросмотрТипаПротокола = Ложь;
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Договор, "ФормаПротокола, Типовой");
	Если ЗначениеЗаполнено(РеквизитыДоговора.ФормаПротокола) Тогда
		ТолькоПросмотрТипаПротокола = Истина;
		Если РеквизитыДоговора.ФормаПротокола = Перечисления.ФормыДокументов.Типовая Тогда
			Объект.Типовой = Истина;
		Иначе
			Объект.Типовой = Ложь;
		КонецЕсли;
	Иначе
		ВидУслугФормаПротокола = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ВидУслугПоставщика, "ФормаПротокола");
		Если ВидУслугФормаПротокола = Перечисления.ФормыДокументов.Нетиповая Тогда
			Объект.Типовой = Ложь;
		ИначеЕсли ВидУслугФормаПротокола = Перечисления.ФормыДокументов.Типовая Тогда
			Объект.Типовой = Истина;
		Иначе
			Объект.Типовой = РеквизитыДоговора.Типовой;
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Контейнеры Тогда
		
		НоменклатураТиповогоПротокола = Новый Соответствие;
		НоменклатураТиповогоПротокола.Вставить(Справочники.Номенклатура.ПредоставлениеКТК, 1);
		НоменклатураТиповогоПротокола.Вставить(Справочники.Номенклатура.СНПКонтейнеров, 1);
		
		ТаблицаНоменклатуры = Объект.Услуги.Выгрузить(, "Номенклатура");
		ТаблицаНоменклатуры.Свернуть("Номенклатура");
		ДоступенТиповойПротокол = Истина;
		Для Каждого Стр Из ТаблицаНоменклатуры Цикл
			Если ЗначениеЗаполнено(Стр.Номенклатура) И НоменклатураТиповогоПротокола.Получить(Стр.Номенклатура) = Неопределено Тогда
				ДоступенТиповойПротокол = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не ДоступенТиповойПротокол Тогда
			ТолькоПросмотрТипаПротокола = Истина;
			Объект.Типовой = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.Типовой.ТолькоПросмотр = ТолькоПросмотрТипаПротокола;
	
	Элементы.МакетПечатнойФормыПротокола.Видимость = Объект.Типовой;	
	Если Не Объект.Типовой Тогда
		Объект.МакетПечатнойФормыПротокола = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьПризнакаТиповой()
	
	ТолькоПросмотрТипаПротокола = Ложь;
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Договор, "ФормаПротокола, Типовой");
	Если ЗначениеЗаполнено(РеквизитыДоговора.ФормаПротокола) Тогда
		ТолькоПросмотрТипаПротокола = Истина;		
	КонецЕсли;
	
	Если Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Контейнеры Тогда
		
		НоменклатураТиповогоПротокола = Новый Соответствие;
		НоменклатураТиповогоПротокола.Вставить(Справочники.Номенклатура.ПредоставлениеКТК, 1);
		НоменклатураТиповогоПротокола.Вставить(Справочники.Номенклатура.СНПКонтейнеров, 1);
		
		ТаблицаНоменклатуры = Объект.Услуги.Выгрузить(, "Номенклатура");
		ТаблицаНоменклатуры.Свернуть("Номенклатура");
		ДоступенТиповойПротокол = Истина;
		Для Каждого Стр Из ТаблицаНоменклатуры Цикл
			Если ЗначениеЗаполнено(Стр.Номенклатура) И НоменклатураТиповогоПротокола.Получить(Стр.Номенклатура) = Неопределено Тогда
				ДоступенТиповойПротокол = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не ДоступенТиповойПротокол Тогда
			ТолькоПросмотрТипаПротокола = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.Типовой.ТолькоПросмотр = ТолькоПросмотрТипаПротокола;
		
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменениеНоменклатурыВСтроке(ТекДанные)
	
	ЭлементыТабличногоПоляУслуги = Элементы.Услуги.ПодчиненныеЭлементы;
	ЭлементУслугиНоменклатураПоставщика = ЭлементыТабличногоПоляУслуги.Найти("УслугиНоменклатураПоставщика");
	Если ЭлементУслугиНоменклатураПоставщика <> Неопределено Тогда
		Номенклатура = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекДанные.НоменклатураПоставщика, "Номенклатура");
		Если ЗначениеЗаполнено(Номенклатура) И Номенклатура <> ТекДанные.Номенклатура Тогда
			НоменклатураПоставщика = НайтиНоменклатуруПоставщика(ТекДанные.НаименованиеНоменклатурыПоставщика, ТекДанные.Номенклатура);
			ТекДанные.НоменклатураПоставщика = НоменклатураПоставщика;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекДанные.Номенклатура) Тогда
		
		СНПКонтейнеров = ПредопределенноеЗначение("Справочник.Номенклатура.СНПКонтейнеров");
		ЗначенияРеквизитовНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекДанные.Номенклатура, "СтавкаНДСПоставщика, ЕдиницаИзмерения");
		
		ЗаполнитьСтавкуНДСВСтрокеУслуг(ТекДанные, ЗначенияРеквизитовНоменклатуры.СтавкаНДСПоставщика);
		ПересчитатьСтоимостьСУчетомСтавкиНДС(ТекДанные);
		
		Если ЗначениеЗаполнено(ЗначенияРеквизитовНоменклатуры.ЕдиницаИзмерения) Тогда
			ТекДанные.ЕдиницаИзмерения = ЗначенияРеквизитовНоменклатуры.ЕдиницаИзмерения;
		КонецЕсли;
		
		ОписаниеПоляВидСобственности = ПараметрыВидаУслуг.ПоляТаблицыУслуг.Получить("ВидСобственности");
		Если ОписаниеПоляВидСобственности <> Неопределено Тогда
			Если ТекДанные.Номенклатура = Справочники.Номенклатура.АрендаКонтейнеров Тогда
				ТекДанные.ВидСобственности = Перечисления.ВариантыСобственности.АрендаДлительная;
			КонецЕсли;
		КонецЕсли;
		
		УстановитьЗначениеПоляСостояниеГруженыйПорожний(ТекДанные);
		
	КонецЕсли;
	
	УдалитьПризнакиПроверкиСтавкиПоСтрокеУслуг(ТекДанные);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтавкуНДСВСтрокеУслуг(СтрокаТЧ, НоменклатураСтавкаНДСПоставщика = Неопределено)
	
	Если СНПКонтейнеровШтраф И СтрокаТЧ.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.СНПКонтейнеров") Тогда
		СтрокаТЧ.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
	//ИначеЕсли СтрокаТЧ.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.СНПКонтейнеров") Тогда
	//	СтрокаТЧ.СтавкаНДС = Объект.СтавкаНДС;
	//Евросиб Шевченко А.В. US 114885 TA 114911 22.07.2025
	ИначеЕсли СтрокаТЧ.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.ШтрафыПрочие") И Объект.ВидУслугПоставщика = Справочники.ВидыУслугПоставщиков.Контейнеры Тогда
		СтрокаТЧ.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
	//Евросиб Шевченко А.В. US 114885 TA 114911 22.07.2025	
	ИначеЕсли ЗначениеЗаполнено(Объект.ВидПеревозки) Тогда
		СтрокаТЧ.СтавкаНДС = Объект.СтавкаНДС;
	ИначеЕсли Не ЗначениеЗаполнено(СтрокаТЧ.СтавкаНДС) Тогда
		Если ЗначениеЗаполнено(НоменклатураСтавкаНДСПоставщика) Тогда
			СтрокаТЧ.СтавкаНДС = НоменклатураСтавкаНДСПоставщика;		
		Иначе
			СтрокаТЧ.СтавкаНДС = Объект.СтавкаНДС;
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура УслугиСтоимостьСНДСПриИзменении(Элемент)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	
	ЗначениеСтавкиНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСтавкуНДС(ТекДанные.СтавкаНДС);	
	СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСуммуНДС(ТекДанные.СтоимостьСНДС, ЗначениеСтавкиНДС, Истина, Истина);
	ТекДанные.СтоимостьБезНДС = ТекДанные.СтоимостьСНДС - СуммаНДС;
	
	УслугиСтоимостьСНДСПриИзмененииСервер(Элементы.Услуги.ТекущаяСтрока);
	
	ПересчетСтавкиПСвСутки(Элементы.Услуги.ТекущаяСтрока,"СтоимостьСНДС"); //Евросиб Шевченко А.В. US 125530 TA 125727 15.12.2025
	
	Если ЗаполнятьВниз Тогда
		ВыполнитьЗаполнениеВниз(Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиСтавкаЗаПСВСутСНДСПриИзменении(Элемент) //Евросиб Шевченко А.В. US 125530 TA 125727 15.12.2025
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	
	ЗначениеСтавкиНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСтавкуНДС(ТекДанные.СтавкаНДС);	
	СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиентСервер.ПолучитьСуммуНДС(ТекДанные.СтавкаЗаПСВСутСНДС, ЗначениеСтавкиНДС, Истина, Истина);
	ТекДанные.СтавкаЗаПСВСутБезНДС = ТекДанные.СтавкаЗаПСВСутСНДС - СуммаНДС;
	
	УслугиСтавкаЗаПСВСутСНДСПриИзмененииСервер(Элементы.Услуги.ТекущаяСтрока);
	
	Если ЗаполнятьВниз Тогда
		ВыполнитьЗаполнениеВниз(Элемент);
	КонецЕсли;
	
КонецПроцедуры

