&НаКлиенте
Процедура ВыборДелегирования(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	Для Сч = 0 По Объект.Состояния.Количество()-1 Цикл
		
		Если Объект.Состояния[Сч].Состояние = ТекущийИсполнитель_Состояние Тогда
			ЗапомнилиСвязь = Объект.Состояния[Сч].ПредыдущиеЭтапы;
			Объект.Состояния[Сч].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Новый");
			НСтр = Объект.Состояния.Вставить(Сч);
			НСтр.Состояние = ПредопределенноеЗначение("Справочник.Состояния.ДелегированноеСогласование");
			НСтр.Исполнитель = Параметр1;
			НСтр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение");
			НСтр.ПредыдущиеЭтапы = ЗапомнилиСвязь;
			
			НомерНовойСтроки = НСтр.НомерСтроки;
			Для Сч2 = Сч+1 По Объект.Состояния.Количество()-1 Цикл
				Объект.Состояния[Сч2].ПредыдущиеЭтапы = ПлюсОдин(Объект.Состояния[Сч2].ПредыдущиеЭтапы, НомерНовойСтроки);
			КонецЦикла;
			
			ОбновитьПанельСостояний();
			Прервать;
		КонецЕсли;
		
		
		//Если Объект.Состояния[Сч].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение") ИЛИ Объект.Состояния[Сч].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.ВРаботе") Тогда
		//	Объект.Состояния[Сч].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Новый");
		//	НСтр = Объект.Состояния.Вставить(Сч);
		//	НСтр.Состояние = ПредопределенноеЗначение("Справочник.Состояния.ДелегированноеСогласование");
		//	НСтр.Исполнитель = Параметр1;
		//	НСтр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение");
		//	ОбновитьПанельСостояний();
		//КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПлюсОдин(ПредыдущиеЭтапы, НомерНовойСтроки)
	
	НоваяСтрокаБэкапов = СтрЗаменить(ПредыдущиеЭтапы, " ", "");
	МассивЧИсле = СтрРазделить(НоваяСтрокаБэкапов, ",", Ложь);
	Для Сыч = 1 по МассивЧИсле.Количество()-1  Цикл
		Попытка
			ТекЧисло = Число(МассивЧИсле[Сыч]);
		Исключение
		КонецПопытки;
		Если ТекЧисло >= НомерНовойСтроки тогда
			МассивЧИсле[Сыч] = Строка(ТекЧисло + 1);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(МассивЧИсле, ",");
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиНоменклатуруПоставщика(Наименование, Номенклатура)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НоменклатураПоставщиков.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.НоменклатураПоставщиков КАК НоменклатураПоставщиков
	|ГДЕ
	|	НоменклатураПоставщиков.Наименование = &Наименование
	|	И НоменклатураПоставщиков.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		НоменклатураПоставщика = Выборка.Ссылка;
	Иначе
		НоменклатураПоставщика = Справочники.НоменклатураПоставщиков.ПустаяСсылка();
	КонецЕсли;
	
	Возврат НоменклатураПоставщика;
	
КонецФункции

