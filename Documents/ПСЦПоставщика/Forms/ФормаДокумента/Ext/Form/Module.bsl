&НаСервере
Процедура ОбработатьИзменениеТипоразмераКТК_Вагона(ТекДанные)
	
	ТипВыбранногоЗначения = ТипЗнч(ТекДанные.ТипоразмерКТК_Вагона);
	Если ТипВыбранногоЗначения = Тип("СправочникСсылка.ТипоразмерыТС") Тогда
		ТекДанные.ТипоразмерВагона = ТекДанные.ТипоразмерКТК_Вагона;
		ТекДанные.ТипоразмерКТК = Неопределено;
	ИначеЕсли ТипВыбранногоЗначения = Тип("СправочникСсылка.ТипоразмерыТЕ") Тогда
		ТекДанные.ТипоразмерВагона = Неопределено;
		ТекДанные.ТипоразмерКТК = ТекДанные.ТипоразмерКТК_Вагона;
	Иначе
		ТекДанные.ТипоразмерВагона = Неопределено;
		ТекДанные.ТипоразмерКТК = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьСоответствиеНормеЗагрузкиКТКТипоразмеру(ТекДанные)
	
	Если ЗначениеЗаполнено(ТекДанные.НормаЗагрузкиКТК) Тогда
		
		СоответствиеВесовТипоразмерам = ПолучитьСоответствиеВесовТипоразмерам();
		ЗначениеНайдено = Ложь;
		Если ЗначениеЗаполнено(ТекДанные.ТипоразмерыКТК) Тогда				
			Для Каждого ТипоразмерКТК Из ТекДанные.ТипоразмерыКТК Цикл
				Веса = СоответствиеВесовТипоразмерам.Получить(ТипоразмерКТК.Значение);
				Если ЗначениеЗаполнено(Веса) И Веса.Найти(ТекДанные.НормаЗагрузкиКТК) <> Неопределено Тогда
					ЗначениеНайдено = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;							
		КонецЕсли;
		
		Если Не ЗначениеНайдено Тогда
			ТекДанные.НормаЗагрузкиКТК = Справочники.ВесаПоТипоразмерам.ПустаяСсылка();
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

