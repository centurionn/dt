&НаСервереБезКонтекста
Функция ЕстьОшибкиВСтрокахПСЦ(ДокументОбъект, Отказ = Ложь)
	
	ПредоставлениеКонтейнеров = Справочники.Номенклатура.ПредоставлениеКТК;
	
	НайденныеСтроки = ДокументОбъект.Услуги.НайтиСтроки(Новый Структура("Номенклатура", ПредоставлениеКонтейнеров));
	Если НайденныеСтроки.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'В табличной части отсутствует номенклатура ""Предоставление контейнера"".'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
	КонецЕсли;
	
	СтрокиСОшибками = Новый Массив;
	Для Каждого СтрокаУслуг Из ДокументОбъект.Услуги Цикл
		Если СтрокаУслуг.Номенклатура <> ПредоставлениеКонтейнеров Тогда
			Продолжить;
		КонецЕсли;
		Отбор = Новый Структура;
		Отбор.Вставить("ИдентификаторСтрокиУслуг", СтрокаУслуг.ИдентификаторСтрокиУслуг);
		НайденныеУчетныеЕдиницы = ДокументОбъект.УчетныеЕдиницы.НайтиСтроки(Отбор);
		Для Каждого СтрокаУчетныхЕдиниц Из НайденныеУчетныеЕдиницы Цикл
			Отбор = Новый Структура;
			Отбор.Вставить("ИдентификаторСтрокиУслуг", СтрокаУчетныхЕдиниц.ИдентификаторСтрокиУслуг);
			Отбор.Вставить("ТипоразмерКТК", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаУчетныхЕдиниц.УчетнаяЕдиница, "ТипТЕ"));
			НайденныеТипоразмеры = ДокументОбъект.КритерииУслуг.НайтиСтроки(Отбор);
			Если НайденныеТипоразмеры.Количество() = 0 Тогда
				СтрокиСОшибками.Добавить("№" + СтрокаУслуг.НомерСтроки);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	СтрокиСОшибками = ОбщегоНазначенияКлиентСервер.СвернутьМассив(СтрокиСОшибками);
	Документы.РелизСобственника.СортироватьМассив(СтрокиСОшибками);
	
	Если СтрокиСОшибками.Количество() > 0 Тогда
		НомераСтрок = СтрСоединить(СтрокиСОшибками, ", ");
		Текст = СтрШаблон(НСтр("ru = 'Невозможно создать релиз собственника, т.к. отличаются типоразмеры КТК по строке %1 с данными КТК в детализации'"), 
			НомераСтрок);
		ОбщегоНазначения.СообщитьПользователю(Текст,,,, Отказ);
	КонецЕсли;
	
	СтрокиСОшибками.Очистить();
	Для Каждого СтрокаУслуг Из ДокументОбъект.Услуги Цикл
		Если СтрокаУслуг.Номенклатура <> ПредоставлениеКонтейнеров Тогда
			Продолжить;
		КонецЕсли;
		ТипоразмерыСтроки = СтрокаУслуг.ТипоразмерыКТК;
		Если ТипоразмерыСтроки.Количество() > 1 Тогда
			СтрокиСОшибками.Добавить("№" + СтрокаУслуг.НомерСтроки);
		КонецЕсли;
		//Отбор = Новый Структура;
		//Отбор.Вставить("ИдентификаторСтрокиУслуг", СтрокаУслуг.ИдентификаторСтрокиУслуг);
		//НайденныеТипоразмеры = ДокументОбъект.КритерииУслуг.НайтиСтроки(Отбор);
		//Если НайденныеТипоразмеры.Количество() > 1 Тогда
		//	СтрокиСОшибками.Добавить("№" + СтрокаУслуг.НомерСтроки);
		//КонецЕсли;
	КонецЦикла;
	
	СтрокиСОшибками = ОбщегоНазначенияКлиентСервер.СвернутьМассив(СтрокиСОшибками);
	Документы.РелизСобственника.СортироватьМассив(СтрокиСОшибками);
	
	Если СтрокиСОшибками.Количество() > 0 Тогда
		НомераСтрок = СтрСоединить(СтрокиСОшибками, ", ");
		Текст = СтрШаблон(НСтр("ru = 'Невозможно создать релиз собственника, указаны разные типоразмеры по строке %1'"), 
			НомераСтрок);
		ОбщегоНазначения.СообщитьПользователю(Текст,,,, Отказ);
	КонецЕсли;

	СтрокиСОшибками.Очистить();
	Для Каждого СтрокаУслуг Из ДокументОбъект.Услуги Цикл
		Если СтрокаУслуг.Номенклатура <> ПредоставлениеКонтейнеров Тогда
			Продолжить;
		КонецЕсли;
		КоличествоКТКВДетализации = ДокументОбъект.УчетныеЕдиницы.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", СтрокаУслуг.ИдентификаторСтрокиУслуг));
		Если СтрокаУслуг.Количество < КоличествоКТКВДетализации.Количество() Тогда
			СтрокиСОшибками.Добавить("№" + СтрокаУслуг.НомерСтроки);
		КонецЕсли;
	КонецЦикла;
	
	СтрокиСОшибками = ОбщегоНазначенияКлиентСервер.СвернутьМассив(СтрокиСОшибками);
	Документы.РелизСобственника.СортироватьМассив(СтрокиСОшибками);
	
	Если СтрокиСОшибками.Количество() > 0 Тогда
		НомераСтрок = СтрСоединить(СтрокиСОшибками, ", ");
		Текст = СтрШаблон(НСтр("ru = 'Невозможно создать релиз собственника, количество учетных единиц в детализации по строке %1 больше чем указано в строке'"), 
			НомераСтрок);
		ОбщегоНазначения.СообщитьПользователю(Текст,,,, Отказ);
	КонецЕсли;
	
	СтрокиСОшибками.Очистить();
	Для Каждого СтрокаУслуг Из ДокументОбъект.Услуги Цикл
		Если СтрокаУслуг.Номенклатура <> ПредоставлениеКонтейнеров Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаУслуг.Количество = 0 Тогда
			СтрокиСОшибками.Добавить("№" + СтрокаУслуг.НомерСтроки);
		КонецЕсли;
	КонецЦикла;
	
	СтрокиСОшибками = ОбщегоНазначенияКлиентСервер.СвернутьМассив(СтрокиСОшибками);
	Документы.РелизСобственника.СортироватьМассив(СтрокиСОшибками);
	
	Если СтрокиСОшибками.Количество() > 0 Тогда
		НомераСтрок = СтрСоединить(СтрокиСОшибками, ", ");
		Текст = СтрШаблон(НСтр("ru = 'Невозможно создать релиз собственника, т.к. количество КТК по строке %1 = 0'"), 
			НомераСтрок);
		ОбщегоНазначения.СообщитьПользователю(Текст,,,, Отказ);
	КонецЕсли;
	
	Для Каждого СтрокаУслуг Из ДокументОбъект.Услуги Цикл
		Если СтрокаУслуг.Номенклатура <> ПредоставлениеКонтейнеров Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаУслуг.ВидСобственности = Перечисления.ВариантыСобственности.СпотДоплатный Тогда
			Текст = НСтр("ru = 'Для создания Релиза собственника необходимо исключить из ПСЦ Поставщика КТК с видом собственности «Спот доплатный». Такие КТК оформляются через ПСЦ клиента.'");
			ОбщегоНазначения.СообщитьПользователю(Текст,,,, Отказ);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаУслуг Из ДокументОбъект.Услуги Цикл
		Если СтрокаУслуг.Номенклатура <> ПредоставлениеКонтейнеров Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаУслуг.ВидСобственности = Перечисления.ВариантыСобственности.Собственный Тогда
			Текст = НСтр("ru = 'Для создания Релиза собственника необходимо исключить из ПСЦ Поставщика КТК с видом собственности «Собственный».'");
			ОбщегоНазначения.СообщитьПользователю(Текст,,,, Отказ);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	СтрокиСОшибками.Очистить();
	Для Каждого СтрокаУслуг Из ДокументОбъект.Услуги Цикл
		Если СтрокаУслуг.Номенклатура <> ПредоставлениеКонтейнеров Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(СтрокаУслуг.ПунктОтправления) = Тип("СправочникСсылка.Мультилокации") Тогда
			КоличествоЛокаций = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаУслуг.ПунктОтправления, "Локации").Выбрать().Количество();
			Если КоличествоЛокаций > 1 Тогда
				СтрокиСОшибками.Добавить("№" + СтрокаУслуг.НомерСтроки);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Если ТипЗнч(СтрокаУслуг.ПунктОтправленияГород) = Тип("СправочникСсылка.Мультилокации") Тогда
			КоличествоЛокаций = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаУслуг.ПунктОтправленияГород, "Локации").Выбрать().Количество();
			Если КоличествоЛокаций > 1 Тогда
				СтрокиСОшибками.Добавить("№" + СтрокаУслуг.НомерСтроки);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Если ТипЗнч(СтрокаУслуг.ПунктОтправленияСтрана) = Тип("СправочникСсылка.Мультилокации") Тогда
			КоличествоЛокаций = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаУслуг.ПунктОтправленияСтрана, "Локации").Выбрать().Количество();
			Если КоличествоЛокаций > 1 Тогда
				СтрокиСОшибками.Добавить("№" + СтрокаУслуг.НомерСтроки);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	СтрокиСОшибками = ОбщегоНазначенияКлиентСервер.СвернутьМассив(СтрокиСОшибками);
	Документы.РелизСобственника.СортироватьМассив(СтрокиСОшибками);
	
	Если СтрокиСОшибками.Количество() > 0 Тогда
		НомераСтрок = СтрСоединить(СтрокиСОшибками, ", ");
		Текст = СтрШаблон(НСтр("ru = 'Невозможно создать релиз собственника, т.к. по строке %1 в локациях выдачи стоит мультилокация, разделите строку по количеству мультилокаций'"), 
			НомераСтрок);
		ОбщегоНазначения.СообщитьПользователю(Текст,,,, Отказ);
	КонецЕсли;
	
	Возврат Отказ;
	
КонецФункции

