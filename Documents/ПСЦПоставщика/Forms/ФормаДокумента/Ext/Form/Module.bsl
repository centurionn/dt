&НаСервере
Процедура СоздатьСтрокиКритериевУслуг()
	
	Документы.ПСЦПоставщика.СоздатьСтрокиКритериевУслуг(Объект);
	
КонецПроцедуры	

&НаКлиенте
Процедура НачалоДействияПриИзменении(Элемент)
	
	СброситьРезультатыСверкиСтавок();
	
КонецПроцедуры

&НаСервере
Процедура СброситьРезультатыСверкиСтавок()
	
	ПроверкаНеОсуществлялась = ПредопределенноеЗначение("Перечисление.РезультатыПроверки.НеОсуществлялась");
	КлючНормативнойСтавкиПустаяСсылка = ПредопределенноеЗначение("Справочник.КлючиАналитикиСтрокПротокола.ПустаяСсылка");
	
	Для Каждого Стр Из Объект.Услуги Цикл
		Стр.ПроверкаСтавок = ПроверкаНеОсуществлялась;
	КонецЦикла;
	
	Для Каждого Стр Из Объект.КритерииУслуг Цикл
		Стр.КлючНормативнойСтавки = КлючНормативнойСтавкиПустаяСсылка;
	КонецЦикла;
	
	ОбновитьГруппуПротоколовНормативныхСтавок();
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиТипоразмерыКТКСтрокойНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Модифицированность = Истина;
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	ТекСтрока = Элементы.Услуги.ТекущаяСтрока;
	//Евросиб Шевченко А.В. US 125530 TA 131571 12.03.2026
	ОписаниеПоля = ПараметрыВидаУслуг.ПоляТаблицыУслуг.Получить("ТипоразмерыКТКСтрокой");
	Если ОписаниеПоля <> Неопределено И ЗначениеЗаполнено(ОписаниеПоля.СписокВыбора) Тогда
		Типоразмеры = ОписаниеПоля.СписокВыбора.ВыгрузитьЗначения();
		СписокТипоразмеров = Новый СписокЗначений;
		СписокТипоразмеров.ЗагрузитьЗначения(Типоразмеры);
	Иначе
		Типоразмеры = ПолучитьТипоразмерыКТК();
		СписокТипоразмеров = Новый СписокЗначений;
		СписокТипоразмеров.ЗагрузитьЗначения(Типоразмеры);
	КонецЕсли;
	//Евросиб Шевченко А.В. US 125530 TA 131571 12.03.2026
	Для Каждого ЭлементСписка Из СписокТипоразмеров Цикл
		ВыбранныйЭлемент = ТекДанные.ТипоразмерыКТК.НайтиПоЗначению(ЭлементСписка.Значение);
		Если ВыбранныйЭлемент <> Неопределено Тогда
			ЭлементСписка.Пометка = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;	
	ПараметрыФормы.Вставить("ТекущийСписок", СписокТипоразмеров);
	ПараметрыФормы.Вставить("ПоказыватьПометку", Истина);
	ПараметрыФормы.Вставить("ИзменятьСоставСтрок", Ложь);
	ПараметрыФормы.Вставить("ТипоразмерДругое", ПредопределенноеЗначение("Справочник.ТипоразмерыТЕ.Другое")); //Евросиб Шевченко А.В. US 125530 TA 131571 12.03.2026
	
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ИдентификаторСтроки", ТекСтрока);
	
	ОповещениеОЗакрытииФормыСписка = Новый ОписаниеОповещения("ПриЗакрытииФормыРедактированияСпискаТипоразмеровКТК", ЭтаФорма, ПараметрыОповещения);	
	ОткрытьФорму("ОбщаяФорма.ФормаРедактированияСпискаЗначений", ПараметрыФормы, Этаформа,,,, ОповещениеОЗакрытииФормыСписка, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыРедактированияСпискаТипоразмеровКТК(СписокТипоразмеров, ДополнительныеПараметры) Экспорт
	
	Если СписокТипоразмеров <> Неопределено Тогда
		
		ТекСтрока = ДополнительныеПараметры.ИдентификаторСтроки;
		ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ТекСтрока);
		ТекДанные.ТипоразмерыКТК.Очистить();		
		
		Для Каждого ЭлементСписка Из СписокТипоразмеров Цикл
			Если ЭлементСписка.Пометка Тогда
				ТекДанные.ТипоразмерыКТК.Добавить(ЭлементСписка.Значение);
			КонецЕсли;
		КонецЦикла;
		
		Типоразмеры = ТекДанные.ТипоразмерыКТК.ВыгрузитьЗначения();
		
		УслугиТипоразмерыКТКПриИзмененииСервер(ТекСтрока);
		
		
		
		Если ЗаполнятьВниз Тогда
			ВыполнитьЗаполнениеВниз();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТипоразмерыКТК()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТипоразмерыТЕ.Ссылка КАК Ссылка,
		|	ТипоразмерыТЕ.Код КАК Код
		|ИЗ
		|	Справочник.ТипоразмерыТЕ КАК ТипоразмерыТЕ
		|ГДЕ
		|	НЕ ТипоразмерыТЕ.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Код";
	
	ТаблицаТипоразмеров = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаТипоразмеров.ВыгрузитьКолонку("Ссылка");
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТипоразмерыВагонов()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТипоразмерыТС.Ссылка КАК Ссылка,
	|	ТипоразмерыТС.Код КАК Код
	|ИЗ
	|	Справочник.ТипоразмерыТС КАК ТипоразмерыТС
	|ГДЕ
	|	НЕ ТипоразмерыТС.ПометкаУдаления
	|	И ТипоразмерыТС.Родитель = &ТипоразмерТСПустаяСсылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код";
	
	Запрос.УстановитьПараметр("ТипоразмерТСПустаяСсылка", Справочники.ТипоразмерыТС.ПустаяСсылка());
	ТаблицаТипоразмеров = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаТипоразмеров.ВыгрузитьКолонку("Ссылка");
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьВидыОтправок()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыОтправок.Ссылка КАК Ссылка,
		|	ВидыОтправок.Порядок КАК Порядок
		|ИЗ
		|	Перечисление.ВидыОтправок КАК ВидыОтправок
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок";
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Возврат Таблица.ВыгрузитьКолонку("Ссылка");
	
КонецФункции

&НаКлиенте
Процедура УслугиТипоразмерыКТКСтрокойОчистка(Элемент, СтандартнаяОбработка)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	ТекСтрока = Элементы.Услуги.ТекущаяСтрока;
	
	ТекДанные.ТипоразмерыКТК.Очистить();
	
	УслугиТипоразмерыКТКПриИзмененииСервер(ТекСтрока);
	
	Если ЗаполнятьВниз Тогда
		ВыполнитьЗаполнениеВниз(Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиКритерииСтрокойНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	СписокКритериев = Новый СписокЗначений;
	Для Каждого ЭлементСписка Из ТекДанные.Критерии Цикл
		СписокКритериев.Добавить(ЭлементСписка.Значение,,, БиблиотекаКартинок.ПолеВводаОткрыть);
	КонецЦикла;
	
	ОповещениеОВыборе = Новый ОписаниеОповещения("ОбработкаВыбораКритерия", ЭтаФорма);
	ПоказатьВыборИзСписка(ОповещениеОВыборе, СписокКритериев, Элемент);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьПризнакиПроверкиСтавкиПоСтрокеУслуг(ТекДанные)
	
	ТекДанные.ПроверкаСтавок = ПредопределенноеЗначение("Перечисление.РезультатыПроверки.НеОсуществлялась");
	
	КлючНормативнойСтавкиПустаяСсылка = Справочники.КлючиАналитикиСтрокПротокола.ПустаяСсылка();
	СтрокиКритериев = Объект.КритерииУслуг.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", ТекДанные.ИдентификаторСтрокиУслуг));
	Для Каждого Стр Из СтрокиКритериев Цикл
		Стр.КлючНормативнойСтавки = КлючНормативнойСтавкиПустаяСсылка;
	КонецЦикла;
	
	ОбновитьГруппуПротоколовНормативныхСтавок();
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиПослеУдаления(Элемент)
	
	УслугиПослеУдаленияСервер();
	
КонецПроцедуры

&НаСервере
Процедура УслугиПослеУдаленияСервер()
	
	УстановитьВидимостьГруппПоНормативам();
	УстановитьВидимостьГруппыПоЗначениюПоля(Объект.Услуги, Элементы.УслугиГруппаОпасностьГруза, "ОпасныйСпецГруз");
	УстановитьВидимостьГруппыПоЗначениюПоля(Объект.Услуги, Элементы.УслугиОсобыйТемпературныйРежимЗначение, "ОсобыйТемпературныйРежим");
	ПроверитьИУстановитьПризнакТиповой();	
	ОбновитьГруппуПротоколовНормативныхСтавок();
	
КонецПроцедуры

&НаКлиенте
Процедура ОкончаниеДействияПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ОкончаниеДействия) Тогда
		Объект.ДействуетДоСогласованияНовыхУсловий = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНормативыСервер()
	
	ТаблицаУслугИТипоразмеров = Объект.Услуги.Выгрузить(Новый Массив, "ИдентификаторСтрокиУслуг, Номенклатура, ТипоразмерВагона, Нормативы, НормаЗагрузкиКТК, НормаВремениНаПогрузкуВыгрузку, НормаПользования, НормативНахожденияНаПогрузке, НормативНахожденияНаВыгрузке");
	ТаблицаУслугИТипоразмеров.Колонки.Добавить("ТипоразмерКТК", Новый ОписаниеТипов("СправочникСсылка.ТипоразмерыТЕ"));
	
	Для Каждого СтрУслуг Из Объект.Услуги Цикл
		СтрокиКритериев = Объект.КритерииУслуг.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", СтрУслуг.ИдентификаторСтрокиУслуг));
		Для Каждого СтрКритериев Из СтрокиКритериев Цикл
			НСтр = ТаблицаУслугИТипоразмеров.Добавить();
			ЗаполнитьЗначенияСвойств(НСтр, СтрУслуг);
			ЗаполнитьЗначенияСвойств(НСтр, СтрКритериев);
		КонецЦикла;
	КонецЦикла;
	
	АвтоперевозкаГруженыйКонтейнер = Справочники.Номенклатура.АвтоперевозкаГруженыйКонтейнер;
	ПревышениеНормыЗагрузкиКонтейнера = Справочники.Номенклатура.ПревышениеНормыЗагрузкиКонтейнера;
	СНПАвтотранспорта = Справочники.Номенклатура.СНПавтотранспорта;
	
	ПредоставлениеПС = Справочники.Номенклатура.ПредоставлениеПлатформ;
	СНПВагонов = Справочники.Номенклатура.СНПвагонов;
	СНПВагоновПогрузкаВыгрузка = Справочники.Номенклатура.СНПвагоновПогрузкаВыгрузка;
	
	СоответствиеВесовТипоразмерам = ПолучитьСоответствиеВесовТипоразмерам();
	
	Для Каждого Стр Из ТаблицаУслугИТипоразмеров Цикл
		
		Если Стр.Номенклатура = АвтоперевозкаГруженыйКонтейнер Тогда
			
			НайденныеСтроки = ТаблицаУслугИТипоразмеров.НайтиСтроки(Новый Структура("Номенклатура, ТипоразмерКТК, Нормативы", ПревышениеНормыЗагрузкиКонтейнера, Стр.ТипоразмерКТК, Истина));
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				
				Если ЗначениеЗаполнено(НайденнаяСтрока.НормаЗагрузкиКТК) Тогда
					Веса = СоответствиеВесовТипоразмерам.Получить(Стр.ТипоразмерКТК);
					Если ЗначениеЗаполнено(Веса) И Веса.Найти(НайденнаяСтрока.НормаЗагрузкиКТК) <> Неопределено Тогда
						СтрокиУслуг = Объект.Услуги.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", Стр.ИдентификаторСтрокиУслуг));
						Если ЗначениеЗаполнено(СтрокиУслуг) Тогда
							СтрокиУслуг[0].Нормативы = Истина;
							СтрокиУслуг[0].НормаЗагрузкиКТК = НайденнаяСтрока.НормаЗагрузкиКТК;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
			
			НайденныеСтроки = ТаблицаУслугИТипоразмеров.НайтиСтроки(Новый Структура("Номенклатура, ТипоразмерКТК, Нормативы", СНПАвтотранспорта, Стр.ТипоразмерКТК, Истина));
			Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
				СтрокиУслуг = Объект.Услуги.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", Стр.ИдентификаторСтрокиУслуг));
				Если ЗначениеЗаполнено(СтрокиУслуг) Тогда
					СтрокиУслуг[0].Нормативы = Истина;
					СтрокиУслуг[0].НормаВремениНаПогрузкуВыгрузку = НайденныеСтроки[0].НормаВремениНаПогрузкуВыгрузку;
					СтрокиУслуг[0].НормативНахожденияНаПогрузке = НайденныеСтроки[0].НормативНахожденияНаПогрузке;
					СтрокиУслуг[0].НормативНахожденияНаВыгрузке = НайденныеСтроки[0].НормативНахожденияНаВыгрузке;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Стр.Номенклатура = ПредоставлениеПС Тогда
			
			НайденныеСтроки = ТаблицаУслугИТипоразмеров.НайтиСтроки(Новый Структура("Номенклатура, ТипоразмерВагона, Нормативы", СНПВагонов, Стр.ТипоразмерВагона, Истина));
			Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
				СтрокиУслуг = Объект.Услуги.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", Стр.ИдентификаторСтрокиУслуг));
				Если ЗначениеЗаполнено(СтрокиУслуг) Тогда
					СтрокиУслуг[0].Нормативы = Истина;
					СтрокиУслуг[0].НормаПользования = НайденныеСтроки[0].НормаПользования;
					СтрокиУслуг[0].НормативНахожденияНаПогрузке = НайденныеСтроки[0].НормативНахожденияНаПогрузке;
					СтрокиУслуг[0].НормативНахожденияНаВыгрузке = НайденныеСтроки[0].НормативНахожденияНаВыгрузке;
				КонецЕсли;
			Иначе
				НайденныеСтроки = ТаблицаУслугИТипоразмеров.НайтиСтроки(Новый Структура("Номенклатура, ТипоразмерВагона, Нормативы", СНПВагоновПогрузкаВыгрузка, Стр.ТипоразмерВагона, Истина));
				Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
					СтрокиУслуг = Объект.Услуги.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", Стр.ИдентификаторСтрокиУслуг));
					Если ЗначениеЗаполнено(СтрокиУслуг) Тогда
						СтрокиУслуг[0].Нормативы = Истина;
						СтрокиУслуг[0].НормаПользования = НайденныеСтроки[0].НормаПользования;
						СтрокиУслуг[0].НормативНахожденияНаПогрузке = НайденныеСтроки[0].НормативНахожденияНаПогрузке;
						СтрокиУслуг[0].НормативНахожденияНаВыгрузке = НайденныеСтроки[0].НормативНахожденияНаВыгрузке;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНормативыНаСервере()
	
	СоздатьСтрокиКритериевУслуг();
	ЗаполнитьНормативыСервер();
	
КонецПроцедуры

