&НаКлиенте
Процедура ПриЗакрытииФормыРедактированияСпискаКлассаОпасности(СписокТипоразмеров, ДополнительныеПараметры) Экспорт
	
	Если СписокТипоразмеров <> Неопределено Тогда
		
		ТекСтрока = ДополнительныеПараметры.ИдентификаторСтроки;
		ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ТекСтрока);
		ТекДанные.КлассыОпасности.Очистить();		
		
		Для Каждого ЭлементСписка Из СписокТипоразмеров Цикл
			Если ЭлементСписка.Пометка Тогда
				ТекДанные.КлассыОпасности.Добавить(ЭлементСписка.Значение);
			КонецЕсли;
		КонецЦикла;
		
		КлассыОпасности = ТекДанные.КлассыОпасности.ВыгрузитьЗначения();
		
		УслугиКлассыОпасностиПриИзмененииСервер(ТекСтрока);
			
		Если ЗаполнятьВниз Тогда
			ВыполнитьЗаполнениеВниз();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УслугиКлассыОпасностиПриИзмененииСервер(ТекСтрока)
	
	ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ТекСтрока);
	ЗначенияПолей = ОпредилитьОбязательностьЗаполненияПолейПоДопУсловиям(ТекДанные);
	Для Каждого ОбязательноеПоле Из ЗначенияПолей Цикл
		ТекДанные[ОбязательноеПоле.ИмяРек] = ОбязательноеПоле.Значение;
	КонецЦикла;
	ОбработатьИзмененияКлассыОпасностиСтрокиУслуг(ТекДанные);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзмененияКлассыОпасностиСтрокиУслуг(ТекДанные)
	
	ТекДанные.КлассОпасностиСтрокой = СтрСоединить(ТекДанные.КлассыОпасности.ВыгрузитьЗначения(), "; ");
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиКлассОпасностиСтрокойОчистка(Элемент, СтандартнаяОбработка)
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	ТекСтрока = Элементы.Услуги.ТекущаяСтрока;
	
	ТекДанные.КлассыОпасности.Очистить();
	
	УслугиКлассыОпасностиПриИзмененииСервер(ТекСтрока);
	
	Если ЗаполнятьВниз Тогда
		ВыполнитьЗаполнениеВниз(Элемент);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура НайтиЗаписатьМультизначения()
	
	ЗаписатьКлассыОпасности();
	
КонецПроцедуры	

&НаСервере
Процедура ЗаписатьКлассыОпасности()
				
	ТаблицаКлассов = Новый ТаблицаЗначений;
	ТаблицаКлассов.Колонки.Добавить("ИдентификаторСтрокиУслуг",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36)));
	ТаблицаКлассов.Колонки.Добавить("Класс",Новый ОписаниеТипов("ПеречислениеСсылка.КлассОпасностиГруза"));
	
	Для Каждого Стр Из Объект.Услуги Цикл
		Для Каждого КлассОпс Из Стр.КлассыОпасности Цикл
			НовСтрока = ТаблицаКлассов.Добавить();
			НовСтрока.ИдентификаторСтрокиУслуг = Стр.ИдентификаторСтрокиУслуг;
			НовСтрока.Класс = КлассОпс.Значение;                           
		КонецЦикла;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Детализация.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	Детализация.Класс КАК Класс
	|ПОМЕСТИТЬ Детализация
	|ИЗ
	|	&Детализация КАК Детализация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Детализация.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	КОЛИЧЕСТВО(*) КАК КоличествоСтрокДетализации
	|ПОМЕСТИТЬ Услуги
	|ИЗ
	|	Детализация КАК Детализация
	|
	|СГРУППИРОВАТЬ ПО
	|	Детализация.ИдентификаторСтрокиУслуг
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Детализация.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	МультизначенияСписок.Ссылка КАК Ссылка,
	|	МультизначенияСписок.Значение КАК Класс,
	|	1 КАК КоличествоСтрок
	|ПОМЕСТИТЬ НайденныеДетализации2
	|ИЗ
	|	Детализация КАК Детализация
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Мультизначения.Список КАК МультизначенияСписок
	|		ПО Детализация.Класс = МультизначенияСписок.Значение
	|			И (МультизначенияСписок.Ссылка.Метаданные = &Метаданные)
	|
	|СГРУППИРОВАТЬ ПО
	|	Детализация.ИдентификаторСтрокиУслуг,
	|	МультизначенияСписок.Ссылка,
	|	МультизначенияСписок.Значение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НайденныеДетализации2.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	НайденныеДетализации2.Ссылка КАК Ссылка,
	|	СУММА(НайденныеДетализации2.КоличествоСтрок) КАК КоличествоСтрок
	|ПОМЕСТИТЬ НайденныеДетализации
	|ИЗ
	|	НайденныеДетализации2 КАК НайденныеДетализации2
	|
	|СГРУППИРОВАТЬ ПО
	|	НайденныеДетализации2.ИдентификаторСтрокиУслуг,
	|	НайденныеДетализации2.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Услуги.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
	|	МАКСИМУМ(Мультизначения.Ссылка) КАК Ссылка
	|ИЗ
	|	Услуги КАК Услуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ НайденныеДетализации КАК НайденныеДетализации
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Мультизначения КАК Мультизначения
	|			ПО НайденныеДетализации.Ссылка = Мультизначения.Ссылка
	|				И НайденныеДетализации.КоличествоСтрок = Мультизначения.КоличествоСтрокСписока
	|				И (Мультизначения.Метаданные = &Метаданные)
	|		ПО Услуги.ИдентификаторСтрокиУслуг = НайденныеДетализации.ИдентификаторСтрокиУслуг
	|			И Услуги.КоличествоСтрокДетализации = НайденныеДетализации.КоличествоСтрок
	|
	|СГРУППИРОВАТЬ ПО
	|	Услуги.ИдентификаторСтрокиУслуг";
	
	Запрос.УстановитьПараметр("Метаданные", "ПеречислениеСсылка.КлассОпасностиГруза");	
	Запрос.УстановитьПараметр("Детализация", ТаблицаКлассов);	
	ТаблицаКлассов = Запрос.Выполнить().Выгрузить();
	
	НовыеКлассы = Новый Массив;
	
	Для Каждого Стр Из Объект.Услуги Цикл
		
		КлассОпасности = ТаблицаКлассов.Найти(Стр.ИдентификаторСтрокиУслуг, "ИдентификаторСтрокиУслуг");
		Если КлассОпасности <> Неопределено Тогда
			Если ЗначениеЗаполнено(КлассОпасности.Ссылка) Тогда
				
				Стр.МультизначениеКлассыОпасности = КлассОпасности.Ссылка;
				
			Иначе
				
				КоличествоСтрок = Стр.КлассыОпасности.Количество();
				
				НайденныеКлассы = Неопределено;
				Для Каждого НовыйКласс Из НовыеКлассы Цикл					
					Если НовыйКласс.КоличествоСтрокСписока = КоличествоСтрок Тогда
						ВсеСтрокиНайдены = Истина;
						Для Каждого СтрКласс Из Стр.КлассыОпасности Цикл
							НайденныеСтроки = НовыйКласс.Список.НайтиСтроки(Новый Структура("Значение", СтрКласс.Значение));
							Если Не ЗначениеЗаполнено(НайденныеСтроки) Тогда
								ВсеСтрокиНайдены = Ложь;
								Прервать;
							КонецЕсли;
						КонецЦикла;
						Если ВсеСтрокиНайдены Тогда
							НайденныеКлассы = НовыйКласс;
							Прервать;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				
				Если НайденныеКлассы <> Неопределено Тогда
					Стр.МультизначениеКлассыОпасности = НайденныеКлассы.Ссылка;
				Иначе
					
					НовыйСпр = Справочники.Мультизначения.СоздатьЭлемент();
					НовыйСпр.Метаданные = "ПеречислениеСсылка.КлассОпасностиГруза";
					Для Каждого КлассОпс Из Стр.КлассыОпасности Цикл
						НовСтрока = НовыйСпр.Список.Добавить();
						НовСтрока.Значение = КлассОпс.Значение;                           
					КонецЦикла;
					НовыйСпр.Записать();
					НовыеКлассы.Добавить(НовыйСпр);
					Стр.МультизначениеКлассыОпасности = НовыйСпр.Ссылка;					
				КонецЕсли;
				
			КонецЕсли;
		Иначе
			Стр.МультизначениеКлассыОпасности = Справочники.Мультизначения.ПустаяСсылка();
		КонецЕсли;		
		
	КонецЦикла;
	
	
КонецПроцедуры	

//Евросиб Шевченко А.В. US 124811 TA 129059 13.03.2026 

&НаСервере
Процедура ЗаполнитьСтавкиНДС() //Евросиб Шевченко А.В. BUG 131579 TA 132300 17.03.2026
	
	СтранаРегистрации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Контрагент, "СтранаРегистрации");
	Если Объект.ВидПеревозки = ПредопределенноеЗначение("Справочник.ВидыПеревозок.Внутрироссийская") Тогда
		Если СтранаРегистрации = ПредопределенноеЗначение("Справочник.СтраныМира.Россия") Тогда
			//Евросиб СубботинВ #125845 09.12.2025 Начало 
			//Объект.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20");
			Если Объект.НачалоДействия < Дата(2026,01,01) Тогда 
				Объект.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20");
				
				Если Объект.НачалоДействия = Дата(1,1,1) Тогда
					Объект.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22");
				КонецЕсли;
				
			Иначе
				Объект.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22");
			КонецЕсли;
			//Евросиб СубботинВ #125845 09.12.2025 Конец
		Иначе
			Объект.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС");
		КонецЕсли;
	ИначеЕсли Объект.ВидПеревозки = ПредопределенноеЗначение("Справочник.ВидыПеревозок.Международная") Тогда
		Если СтранаРегистрации = ПредопределенноеЗначение("Справочник.СтраныМира.Россия") Тогда
			Объект.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС0");
		Иначе
			Объект.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС");
		КонецЕсли;
	ИначеЕсли Объект.ВидПеревозки = ПредопределенноеЗначение("Справочник.ВидыПеревозок.ВнеТерриторииРФ") Тогда
		Объект.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС");
	Иначе
		Элементы.СтавкаНДС.ТолькоПросмотр = Ложь;
		Возврат;
	КонецЕсли; 
	//Евросиб Коханенко Н.А. 29.05.2025 )) #109338 
	
	СоответствиеРеквизитовНоменклатуры = ПолучитьЗначенияРеквизитовНоменклатурыУслуг();
	Для Каждого СтрокаТЧ Из Объект.Услуги Цикл
		РеквизитыНоменклатуры = СоответствиеРеквизитовНоменклатуры.Получить(СтрокаТЧ.Номенклатура);
		Если ЗначениеЗаполнено(РеквизитыНоменклатуры) Тогда
			СтавкаНДСПоставщика = РеквизитыНоменклатуры.СтавкаНДСПоставщика;
		Иначе
			СтавкаНДСПоставщика = Неопределено;
		КонецЕсли;
		ЗаполнитьСтавкуНДСВСтрокеУслуг(СтрокаТЧ, СтавкаНДСПоставщика);
		ПересчитатьСтоимостьСУчетомСтавкиНДС(СтрокаТЧ);
	КонецЦикла;
	
	Элементы.СтавкаНДС.ТолькоПросмотр = Истина;
	
КонецПроцедуры	

