						НомерКТК = СокрЛП(ПрочитанныеЗначения[ИндексСтроки]);						
						Если ЗначениеЗаполнено(НомерКТК) Тогда
							НСтр = ТаблицаПрочитанныхЗначений.Добавить();
							НСтр.ИндексСтроки = ИндексСтроки;
							НСтр.Префикс = Лев(ВРег(НомерКТК), 4);
							НСтр.Номер = Сред(НомерКТК, 5, 6);
						КонецЕсли;
						
					КонецЦикла;
					
					КоличествоПрочитанныхЗначений = ТаблицаПрочитанныхЗначений.Количество();
					
					Запрос = Новый Запрос;
					Запрос.УстановитьПараметр("ТаблицаПрочитанныхЗначений", ТаблицаПрочитанныхЗначений);
					
					Запрос.Текст =
					"ВЫБРАТЬ
					|	ТаблицаПрочитанныхЗначений.ИндексСтроки КАК ИндексСтроки,
					|	ТаблицаПрочитанныхЗначений.Префикс КАК Префикс,
					|	ТаблицаПрочитанныхЗначений.Номер КАК Номер
					|ПОМЕСТИТЬ ВТ
					|ИЗ
					|	&ТаблицаПрочитанныхЗначений КАК ТаблицаПрочитанныхЗначений
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	ВТ.ИндексСтроки КАК ИндексСтроки,
					|	ТЕ.Ссылка КАК Ссылка,
