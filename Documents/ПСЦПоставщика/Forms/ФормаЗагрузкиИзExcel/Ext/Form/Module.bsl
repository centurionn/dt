										ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Справочник.Локации", ОписаниеТипа.ПолноеИмяТипа);								
																		
										УсловияЗапроса = Новый Массив;
										УсловияЗапроса.Добавить("ТаблицаСправочника.Наименование ПОДОБНО &Наименование");
										ШаблонУсловия = "ТаблицаСправочника.%1 = &%1";
										
										Если ОписаниеТипа.Иерархический И ОписаниеТипа.ВидИерархии = ИерархияГруппИЭлементов Тогда
											Если Поле.ВыборГруппИЭлементов = ИспользованиеГруппИЭлементов.Элементы Тогда
												УсловияЗапроса.Добавить("НЕ ТаблицаСправочника.ЭтоГруппа");
											ИначеЕсли Поле.ВыборГруппИЭлементов = ИспользованиеГруппИЭлементов.Группы Тогда
												УсловияЗапроса.Добавить("ТаблицаСправочника.ЭтоГруппа");
											КонецЕсли;
										КонецЕсли;
										
										Для Каждого Параметр Из Поле.ПараметрыВыбора Цикл
											
											ИмяПараметра = СтрЗаменить(Параметр.ИмяПараметра, "Отбор.", "");
											Если ОписаниеТипа.ДоступныеПоля.Получить(ИмяПараметра) = Неопределено Тогда
												Продолжить;
											КонецЕсли;
											ЗначениеПараметра = Параметр.ЗначениеПараметра;
											
											Если ТипЗнч(ЗначениеПараметра) = ТипФиксированныйМассив Тогда
												УсловияЗапроса.Добавить(СтрШаблон("ТаблицаСправочника.%1 В (&%1)", ИмяПараметра));
											Иначе
												УсловияЗапроса.Добавить(СтрШаблон("ТаблицаСправочника.%1 = &%1", ИмяПараметра));
											КонецЕсли;
											
											Запрос.УстановитьПараметр(ИмяПараметра, ЗначениеПараметра);
											
										КонецЦикла;
										
										ТекстУсловийЗапроса = СтрСоединить(УсловияЗапроса, Символы.ПС + "И ");
										ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаСправочника.Наименование ПОДОБНО &Наименование", ТекстУсловийЗапроса);
									
									КонецЕсли;
								
									Для Каждого ПолеПоиска Из ОписаниеТипа.ПоляПоиска Цикл
										
										ТипПоляПоиска = ОписаниеТипа.ДоступныеПоля.Получить(ПолеПоиска);
										Если ТипПоляПоиска = Неопределено Тогда
											Продолжить;
										КонецЕсли;
										
										Если ТипПоляПоиска.СодержитТип(ТипСтрока) Тогда
										
											Если ПолеПоиска = "Наименование" Тогда
												Запрос.Текст = ТекстЗапроса;
												Запрос.УстановитьПараметр(ПолеПоиска,  "%" + ПрочитанноеЗначение + "%");
											ИначеЕсли ТипПоляПоиска.КвалификаторыСтроки.Длина = 0 Тогда
												Условие = СтрШаблон("ТаблицаСправочника.%1 ПОДОБНО &%1", ПолеПоиска);
												Запрос.Текст = СтрЗаменить(ТекстЗапроса, "ТаблицаСправочника.Наименование ПОДОБНО &Наименование", Условие);
												Запрос.УстановитьПараметр(ПолеПоиска, "%" + ПрочитанноеЗначение + "%");
											Иначе
												Условие = СтрШаблон("ТаблицаСправочника.%1 = &%1", ПолеПоиска);
												Запрос.Текст = СтрЗаменить(ТекстЗапроса, "ТаблицаСправочника.Наименование ПОДОБНО &Наименование", Условие);
												Запрос.УстановитьПараметр(ПолеПоиска, ПрочитанноеЗначение);
											КонецЕсли;									
											
											Выборка = Запрос.Выполнить().Выбрать();
											Если Выборка.Следующий() Тогда
												Значение = Выборка.Ссылка;
											КонецЕсли;
										
										КонецЕсли;
										
										Если ЗначениеЗаполнено(Значение) Тогда
											Прервать;
										КонецЕсли;
										
									КонецЦикла;
									
								Иначе
									
									Для Каждого ПолеПоиска Из ОписаниеТипа.ПоляПоиска Цикл								
										
										Если ОписаниеТипа.ДоступныеПоля.Получить(ПолеПоиска) = Неопределено Тогда
											Продолжить;
										КонецЕсли;
										
										Если ПолеПоиска = "Наименование" Тогда									
											Значение = ОписаниеТипа.МенеджерОбъекта.НайтиПоНаименованию(ПрочитанноеЗначение);									
										ИначеЕсли ПолеПоиска = "Код" Тогда
											Значение = ОписаниеТипа.МенеджерОбъекта.НайтиПоКоду(ПрочитанноеЗначение);
										Иначе
											Значение = ОписаниеТипа.МенеджерОбъекта.НайтиПоРеквизиту(ПолеПоиска, ПрочитанноеЗначение);
										КонецЕсли;
										
										Если ЗначениеЗаполнено(Значение) Тогда
											Прервать;
										КонецЕсли;
										
									КонецЦикла;
									
								КонецЕсли;
								
							ИначеЕсли ОписаниеТипа.КлассОМ = "Перечисление" Тогда
								
								Если ОписаниеТипа.ПолноеИмяТипа = "Перечисление.СтавкиНДС" Тогда
									Если СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ПрочитанноеЗначение,, Истина) Тогда
										Значение = Справочники.СтавкиНДС.ПолучитьСтавкуНДСпоСтроковомуЗначению(ПрочитанноеЗначение);
									КонецЕсли;
								КонецЕсли;
								
								Если Не ЗначениеЗаполнено(Значение) Тогда
									Для Каждого ЗначениеПеречисления Из ОписаниеТипа.МенеджерОбъекта Цикл
										Если НРег(ПрочитанноеЗначение) = НРег(Строка(ЗначениеПеречисления)) Тогда
											Значение = ЗначениеПеречисления;
											Прервать;
										КонецЕсли;
									КонецЦикла;
								КонецЕсли;
								
							КонецЕсли;
							
						ИначеЕсли ОписаниеТипа.ПолноеИмяТипа = "Дата" Тогда
							Значение = СтроковыеФункцииКлиентСервер.СтрокаВДату(ПрочитанноеЗначение);
						ИначеЕсли ОписаниеТипа.ПолноеИмяТипа = "Число" Тогда
							Значение = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ПрочитанноеЗначение);
						Иначе
							Значение = ПрочитанноеЗначение;
						КонецЕсли;
						
						Если ЗначениеЗаполнено(Значение) Тогда
							Прервать;
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Значение) Тогда
					ДанныеСтроки.Вставить(Поле.Имя, Значение);
					ТабДок.Область(ИмяОбласти).ЦветФона = WebЦвета.Белый;
				Иначе
					ТабДок.Область(ИмяОбласти).ЦветФона = WebЦвета.Розовый;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЕстьЗначение Тогда
			
			НоваяСтрока = ПрочитанныеДанные.Добавить();
			
			НомерСтрокиПрочитанныхДанных = НомерСтрокиПрочитанныхДанных + 1;
			НоваяСтрока.НомерСтроки = НомерСтрокиПрочитанныхДанных;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеСтроки);
			
			СписокЭлементов = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеСтроки, "ТипоразмерыКТКСписок");
			Если ЗначениеЗаполнено(СписокЭлементов) Тогда
				НоваяСтрока.ТипоразмерыКТКСписок.ЗагрузитьЗначения(СписокЭлементов);
			КонецЕсли;
			//Евросиб Шевченко А.В. US 124811 TA 129059 13.03.2026
			СписокЭлементов = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеСтроки, "КлассыОпасностиСписок");
			Если ЗначениеЗаполнено(СписокЭлементов) Тогда
				НоваяСтрока.КлассыОпасностиСписок.ЗагрузитьЗначения(СписокЭлементов);
			КонецЕсли;
			//Евросиб Шевченко А.В. US 124811 TA 129059 13.03.2026
			СписокЭлементов = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеСтроки, "ТипоразмерыВагоновСписок");
			Если ЗначениеЗаполнено(СписокЭлементов) Тогда
				НоваяСтрока.ТипоразмерыВагоновСписок.ЗагрузитьЗначения(СписокЭлементов);
			КонецЕсли;
			
			СписокЭлементов = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеСтроки, "КонтейнерыВагоныСписок");
			Если ЗначениеЗаполнено(СписокЭлементов) Тогда
				НоваяСтрока.КонтейнерыВагоныСписок.ЗагрузитьЗначения(СписокЭлементов);
			КонецЕсли;
			
			СписокЭлементов = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеСтроки, "ВидыОтправокСписок");
			Если ЗначениеЗаполнено(СписокЭлементов) Тогда
				НоваяСтрока.ВидыОтправокСписок.ЗагрузитьЗначения(СписокЭлементов);
			КонецЕсли;
			
			// Евросиб US 98207 TA 105661 Рыбьяков К.А. 02.04.2025 ((
			СписокЭлементов = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеСтроки, "ПродуктыСписок");
			Если ЗначениеЗаполнено(СписокЭлементов) Тогда
				НоваяСтрока.ПродуктыСписок.ЗагрузитьЗначения(СписокЭлементов);
			КонецЕсли;
			// Евросиб Рыбьяков К.А. 02.04.2025 ))
			
		КонецЕсли;

		НомерСтроки = НомерСтроки + 1;
		ПредставлениеНомераСтроки = Формат(НомерСтроки, "ЧГ=0");
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьРазделитель(Текст)
	
	Если СтрНайти(Текст, ";") > 0 Тогда
		Разделитель = ";";
	ИначеЕсли СтрНайти(Текст, ",") > 0 Тогда
		Разделитель = ",";
	ИначеЕсли СтрНайти(Текст, Символы.ПС) > 0 Тогда
		Разделитель = Символы.ПС;
	Иначе
		Разделитель = ";";
	КонецЕсли;
	
	Возврат Разделитель;
					
КонецФункции

&НаСервере
Процедура ПриЗакрытииНаСервере()
	
	УдалитьИзВременногоХранилища(АдресТаблицыОписанияРеквизитов);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	ПриЗакрытииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Перенести(Команда)
	
	Адрес = ПоместитьВоВременноеХранилищеПрочитаннуюТаблицу();
	Закрыть(Адрес);
	
КонецПроцедуры

&НаСервере
Функция ПоместитьВоВременноеХранилищеПрочитаннуюТаблицу()
	
	ПрочитаннаяТаблица = ПрочитанныеДанные.Выгрузить();
	Адрес = ПоместитьВоВременноеХранилище(ПрочитаннаяТаблица, Новый УникальныйИдентификатор);
	Возврат Адрес;
	
КонецФункции

&НаКлиенте
Процедура ТабДокПриИзмененииСодержимогоОбласти(Элемент, Область)
	
	НомерСтроки = 0;
	Для ИндексСтроки = НомерПервойСчитываемойСтроки По ТабДок.ВысотаТаблицы Цикл
		НомерСтроки = НомерСтроки + 1;
		ПредставлениеНомераСтроки = Формат(ИндексСтроки, "ЧГ=0");
		ИмяОбласти = СтрШаблон("R%1C1", ПредставлениеНомераСтроки);
		ТабДок.Область(ИмяОбласти).Текст = НомерСтроки;
	КонецЦикла;
	
КонецПроцедуры
