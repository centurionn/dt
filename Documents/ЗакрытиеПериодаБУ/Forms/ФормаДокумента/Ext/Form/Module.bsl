#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПредставлениеПериодаБлокировки = Формат(Объект.ПериодБлокировки, "ДФ='ММММ гггг'");
	ЗакрытиеНЗПДоИзменения = Объект.ЗакрытиеНЗППредыдущихПериодов;
		
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры

//Евросиб Коханенко Н.А. #61705 09.12.2022 (
&НаКлиенте
Процедура ОткрытьОкноСИнструкциями(Форма, Команда)
	ИнструкцииКлиент.ОткрытьОкноСИнструкциями(ЭтаФорма, Команда);
КонецПроцедуры  
//Евросиб Коханенко Н.А. #61705 09.12.2022 )


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	НастроитьОтображениеКоличестваДокументов();
	ОбновитьОтображениеТекстаНадписи();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПериодБлокировкиРегулирование(Элемент, Направление, СтандартнаяОбработка)
	Объект.ПериодБлокировки = НачалоМесяца(ДобавитьМесяц(Объект.ПериодБлокировки, Направление));	
	ПредставлениеПериодаБлокировки = Формат(Объект.ПериодБлокировки, "ДФ='ММММ гггг'");

	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытиеНЗППредыдущихПериодовПриИзменении(Элемент)
	
	СнимаетсяПризнак = ЗакрытиеНЗПДоИзменения = Истина
		И Объект.ЗакрытиеНЗППредыдущихПериодов = Ложь;
		
	Если Объект.НЗППредыдущихПериодов.Количество() > 0
			И СнимаетсяПризнак Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаЗакрытиеНЗППредыдущихПериодов", ЭтотОбъект, Параметры);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Список НЗП предыдущих периодов будет очищен.
                                     	|Снять данный признак?'"), Режим, 0);
	Иначе
		ОбновитьОтображениеТекстаНадписи();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НЗППредыдущихПериодовОшибка1Очистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура КомментарийНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияКомментария(Элемент.ТекстРедактирования, ЭтотОбъект, "Объект.Комментарий", НСтр("ru = 'Комментарий'"));
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормы

&НаКлиенте
Процедура НЗППредыдущихПериодовПриИзменении(Элемент)
	НастроитьОтображениеКоличестваДокументов();
	ОбновитьОтображениеТекстаНадписи();
КонецПроцедуры

&НаКлиенте
Процедура НЗППредыдущихПериодовПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.НЗППредыдущихПериодов.ТекущиеДанные;
	
	Элементы.ГруппаТекстОшибки.Заголовок = "Нет ошибок создания акцептов";
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Если НЕ ПустаяСтрока(ТекущиеДанные.Ошибка) Тогда
		Элементы.ГруппаТекстОшибки.Заголовок = "Подробный текст ошибки";	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура НЗППредыдущихПериодовОшибкаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПослеПросмотраОшибки", ЭтаФорма);
	ПоказатьВводСтроки(ОповещениеОЗакрытии, Элемент.ТекстРедактирования, "Описание ошибки",, Истина);
КонецПроцедуры

&НаКлиенте
Процедура НЗППредыдущихПериодовОшибкаОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьНЗП(Команда)	
	
	Если Объект.НЗППредыдущихПериодов.Количество() > 0 Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаЗаполнениеНЗП", ЭтотОбъект, Параметры);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Список НЗП предыдущих периодов будет перезаполнен.
                                         |Продолжить?'"), Режим, 0);		
	Иначе
		ВыполнитьЗаполнениеНЗП();
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура СоздатьАктуальныеАкцепты(Команда)
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаСоздатьАкцепты", ЭтотОбъект, Параметры);
	ПоказатьВопрос(Оповещение, "Акцепты будут заполнены данными по РТУ. Продолжить?", Режим, 0);		
	
КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды

&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
    ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат)
    ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Объект, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
    ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры

// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПослеЗакрытияВопросаЗакрытиеНЗППредыдущихПериодов(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		Объект.НЗППредыдущихПериодов.Очистить();                     
		//ЗакрытиеНЗПДоИзменения = Объект.ЗакрытиеНЗППредыдущихПериодов;
		
		НастроитьОтображениеКоличестваДокументов();
		ОбновитьОтображениеТекстаНадписи();
        Возврат;
    КонецЕсли;

    Объект.ЗакрытиеНЗППредыдущихПериодов = Истина;
	//ЗакрытиеНЗПДоИзменения = Объект.ЗакрытиеНЗППредыдущихПериодов;
    ОбновитьОтображениеТекстаНадписи();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаЗаполнениеНЗП(Результат, Параметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

    ВыполнитьЗаполнениеНЗП();

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаСоздатьАкцепты(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
    КонецЕсли;
	
	Объект.АкцептыДозаполнены = Ложь;
	
    РезультатВыполнения = ВыполнитьСозданиеАкцептов();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ТекстСообщения = "Выполняется заполнение акцептов.
										|Это может занять продолжительное время.";
	ОповещениеОЗавершении = Новый ОписаниеОповещения("СозданиеАкцептовЗавершение", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗаполнениеНЗП()
    ЗаполнитьНЗПНаСервере();
	НастроитьОтображениеКоличестваДокументов();
	ОбновитьОтображениеТекстаНадписи();
КонецПроцедуры

