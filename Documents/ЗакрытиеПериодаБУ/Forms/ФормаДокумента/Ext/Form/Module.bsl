&НаСервере
Функция ВыполнитьСозданиеАкцептов()
	
	Если РезультатВыполнения <> Неопределено
		И ЗначениеЗаполнено(РезультатВыполнения.ИдентификаторЗадания) Тогда
		ДлительныеОперации.ОтменитьВыполнениеЗадания(РезультатВыполнения.ИдентификаторЗадания);
	КонецЕсли;
		
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение = 0; // запускать сразу
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Создание актуальных акцептов при закрытии периода БУ'");
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	РезультатВыполнения = ДлительныеОперации.ВыполнитьВФоне("Документы.ЗакрытиеПериодаБУ.СоздатьАтуальныеАкцепты",
		Объект.НЗППредыдущихПериодов.Выгрузить(), ПараметрыВыполнения);
	
	Если РезультатВыполнения.Статус = "Ошибка" Тогда
		ВызватьИсключение РезультатВыполнения.КраткоеПредставлениеОшибки;
	КонецЕсли;
	
	Возврат РезультатВыполнения;
	
КонецФункции

&НаКлиенте
Процедура СозданиеАкцептовЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ЗагрузитьПодготовленныеДанные();
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		ВызватьИсключение Результат.КраткоеПредставлениеОшибки;
	КонецЕсли;
	
	ОбновитьОтображениеТекстаНадписи();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПодготовленныеДанные()
	Результат = ПолучитьИзВременногоХранилища(РезультатВыполнения.АдресРезультата);
	
	ТаблицаНЗП = Результат.ТаблицаНЗП;
	Объект.НЗППредыдущихПериодов.Загрузить(ТаблицаНЗП);
	Объект.АкцептыДозаполнены = Истина;	
КонецПроцедуры	

&НаКлиенте
Процедура ОбновитьОтображениеТекстаНадписи()
	
	ЗакрытиеНЗПДоИзменения = Объект.ЗакрытиеНЗППредыдущихПериодов;
	
	Элементы.НадписьАкцептыСозданы.Видимость = Объект.ЗакрытиеНЗППредыдущихПериодов
											И Объект.НЗППредыдущихПериодов.Количество() > 0;
	
	Если Объект.АкцептыДозаполнены Тогда
		Элементы.НадписьАкцептыСозданы.Заголовок = "По ПТУ, которые указаны в документе, созданы актуальные акцепты";
		Элементы.НадписьАкцептыСозданы.ЦветТекста = Новый Цвет(0, 150, 70);
	Иначе
		Элементы.НадписьАкцептыСозданы.Заголовок = "По ПТУ, которые указаны в документе, необходимо обновить акцепты (кнопка ""Создать актуальные акцепты"")";
		Элементы.НадписьАкцептыСозданы.ЦветТекста = Новый Цвет(255, 0, 0);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти