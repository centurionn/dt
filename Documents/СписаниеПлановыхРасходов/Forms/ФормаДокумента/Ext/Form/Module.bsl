	УстановитьВидимостьСуммУУ();        
	Элементы.ГруппаШапка.ТолькоПросмотр = Объект.Проведен;
	Элементы.ГруппаВариантыЗаполнения.ТолькоПросмотр = Объект.Проведен;
	Элементы.ПериодВозникновенияОстатков.ТолькоПросмотр = Объект.Проведен;
КонецПроцедуры                  

