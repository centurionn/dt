&НаКлиенте
Процедура ПериодСписанияРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	Если Объект.РасходыКСписанию.Количество() > 0 Тогда          
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВопросаОчиститьТаблицуСписанияПериодСписания", ЭтотОбъект, Направление);
		ПоказатьВопрос(ОписаниеОповещения, "При изменении периода списания табличная часть будет очищена. Продолжить?",РежимДиалогаВопрос.ДаНет, 60);
	Иначе
		СтандартнаяОбработка = Ложь;
		Объект.ПериодСписания = НачалоМесяца(ДобавитьМесяц(Объект.ПериодСписания, Направление));
		ПериодСписания = Формат(Объект.ПериодСписания, "ДФ='ММММ гггг'");
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект); 
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	ПериодВозникновенияОстатков.ДатаНачала = Объект.НачалоПериодаВозникновенияОстатков;
	ПериодВозникновенияОстатков.ДатаОкончания = Объект.ОкончаниеПериодаВозникновенияОстатков;
	ПериодСписания = Формат(Объект.ПериодСписания, "ДФ='ММММ гггг'");
	ПересчитатьИтоговыеСуммыНаСервере();


	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	// СтандартныеПодсистемы.ПодключаемыеКоманды 
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект); 
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

