	Движения.ЗакрытыеПериоды.Очистить();

	Движения.ФиксацияИзмененияПлановыхРасходовВО.Записывать = Истина;
	Движения.ФиксацияИзмененияПлановыхРасходовВО.Очистить();
	//Евросиб Каблов 09.06.2021 ( 29035
	Если ВключитьРассылку Тогда
		//Евросиб Каблов 09.04.2025 ( #105407
		//ЗакрытиеПериодаСервер.ОтправитьСообщениеОЗакрытииПериода(Ссылка);
		ЗакрытиеПериодаСервер.ОтправитьСообщениеОЗакрытииПериода(Ссылка, Ложь, "ВО");
		//Евросиб Каблов 09.04.2025 )
	КонецЕсли;
	//Евросиб Каблов 09.06.2021 )
	// регистр ЗакрытыеПериоды
	Если ЗакрытиеПериодаВО Тогда
		Движения.ЗакрытыеПериоды.Записывать = Истина;
		Движение = Движения.ЗакрытыеПериоды.Добавить();
		Движение.Период = ПериодБлокировки;
		Движение.Организация = Организация;
