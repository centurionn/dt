	Автор = Пользователи.ТекущийПользователь();
	Создано = ТекущаяДата();
	Редактор = неопределено;
	Изменено = неопределено;
	Состояния.Очистить();
	//Евросиб Каблов 09.06.2021 ( 29035
	ВключитьРассылку = Истина;
	//Евросиб Каблов 09.06.2021 )
	
