&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ДопСвойстваОбъекта.Очистить();
	ОбновитьПанельТекущегоПользователя();
	ОбновитьПанельСостояний();
	
	ДвиженияЗаПериод.Параметры.УстановитьЗначениеПараметра("Документ", Объект.Ссылка);
	
