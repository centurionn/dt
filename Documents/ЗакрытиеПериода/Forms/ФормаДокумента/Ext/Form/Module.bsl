// +++ БЛОК НОВОЙ МАРШРУТИЗАЦИИ

&НаКлиенте
Функция ПроверитьУказатьОтветственных(РезультатЗапроса, СобытиеПередЗаписью)
	
	ДопСвойстваОбъекта.Очистить();
	ЧтоНужноУказатьВручную = Новый Массив;
	Для каждого Стр из  РезультатЗапроса Цикл
		Исполнитель = Стр.Исполнитель;
		Если НЕ Стр.ТребуетсяУказатьИсполнителя И НЕ ЗначениеЗаполнено(Исполнитель) Тогда Исполнитель = Объект.Автор; КонецЕсли;
		Наблюдатель = Стр.Наблюдатель;
		Если НЕ Стр.ТребуетсяУказатьНаблюдателя И НЕ ЗначениеЗаполнено(Наблюдатель) Тогда Наблюдатель = Объект.Автор; КонецЕсли;
		
		Если Стр.ТребуетсяУказатьИсполнителя ИЛИ Стр.ТребуетсяУказатьНаблюдателя Тогда 
			ЧтоНужноУказатьВручную.Добавить(Новый Структура("Состояние, Исполнитель, Наблюдатель", Стр.Состояние, Исполнитель, Наблюдатель)); 
		КонецЕсли;
	КонецЦикла;
	Если ЧтоНужноУказатьВручную.Количество() > 0 Тогда
		ОпОп = Новый ОписаниеОповещения("ОбработкаУказанияОтветственных", ЭтаФорма, Новый Структура("РезультатЗапроса, СобытиеПередЗаписью", РезультатЗапроса, СобытиеПередЗаписью));
		ПараметрыОтбора = Новый СТруктура;
		ПараметрыОтбора.Вставить("ВыбраннаяМаршрутизация", ЧтоНужноУказатьВручную);
		ОткрытьФорму("Справочник.Маршрутизация.Форма.ФормаЗаполненияСостояний",ПараметрыОтбора,, ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		Если НЕ СобытиеПередЗаписью Тогда ПовторнаяМаршрутизация_сервер(РезультатЗапроса); КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаУказанияОтветственных(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = неопределено Тогда Возврат; КонецЕсли;
	ДопСвойстваОбъекта.ЗагрузитьЗначения(П1);
	Если П2.СобытиеПередЗаписью Тогда
		Записать();
	Иначе
		ПовторнаяМаршрутизация_сервер(П2.РезультатЗапроса);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПовторнаяМаршрутизация_сервер(РезультатЗапроса)
	
	ЭтотОбъектЪ = РеквизитФормыВЗначение("Объект");
	МаршрутизацияСервер.ПрименитьМаршрут(ЭтотОбъектЪ, РезультатЗапроса, Объект.Автор, ДопСвойстваОбъекта);
	ЗначениеВРеквизитФормы(ЭтотОбъектЪ, "Объект");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьРегламентныеОперации(Команда)
	
	Объект.ДвиженияПериода.Очистить();
	
	ЗапуститьРегламентныеОперацииСервер();
	
КонецПроцедуры

&НаСервере
Процедура ЗапуститьРегламентныеОперацииСервер()

	НЗ = РегистрыСведений.ТЧ_Движения_ЗакрытиеПериода.СоздатьНаборЗаписей();
	НЗ.Отбор.Документ.Установить(Объект.Ссылка);
	НЗ.Прочитать();
	
	ДвиженияПериода = НЗ.Выгрузить();
	ДвиженияПериода.Свернуть("Контрагент");
	
	Для каждого Стр из Объект.РеглОперации Цикл
		
		Если НЕ Стр.Выполнена И Стр.КодОперации = "01" Тогда
			СписокАктивныхТекДок = Новый Массив;
			Для каждого Стр8 из ДвиженияПериода Цикл
				СписокАктивныхТекДок.Добавить(Стр8.Контрагент);
			КонецЦикла;
			Стр.РезультатВыполнения = СнятьСМониторингаНеактивныхКонтрагентов(СписокАктивныхТекДок, Объект.ПериодБлокировки, Объект.Ссылка);
			Стр.ДатаВыполнения = текущаядата();
			Стр.Выполнена = Истина;
		КонецЕсли;

		Если НЕ Стр.Выполнена И Стр.КодОперации = "02" Тогда
			СписокАктивныхТекДок = Новый Массив;
			Для каждого Стр8 из ДвиженияПериода Цикл
				СписокАктивныхТекДок.Добавить(Стр8.Контрагент);
			КонецЦикла;
			Стр.РезультатВыполнения = ПостановкаНаМониторинг(СписокАктивныхТекДок);
			Стр.ДатаВыполнения = текущаядата();
			Стр.Выполнена = Истина;
		КонецЕсли;
		
		Если НЕ Стр.Выполнена И Стр.КодОперации = "03" Тогда
			Стр.РезультатВыполнения = ОбновлениеИндексаСпаркПоКонтрагентамНаМониторинге();
			Стр.ДатаВыполнения = текущаядата();
			Стр.Выполнена = Истина;
		КонецЕсли;
			
		//Если НЕ Стр.Выполнена И Стр.КодОперации = "04" Тогда
		//	Стр.РезультатВыполнения = ОтнесениеВСтопЛистПокупателейСЗадолженностью();
		//	Стр.ДатаВыполнения = текущаядата();
		//	Стр.Выполнена = Истина;
		//КонецЕсли;
		
		//Евросиб Каблов 26.02.2020 ( Ticket#0182095
		Если НЕ Стр.Выполнена И Стр.КодОперации = "05" Тогда
			ПериодРасчета = ДобавитьМесяц(Объект.ПериодБлокировки, 1);
			КонтрагентыДоговоры_сервер.РассчитатьПлановуюКатегориюКонтрагентов(ПериодРасчета);
			Стр.ДатаВыполнения = текущаядата();
			Стр.Выполнена = Истина;
		КонецЕсли;
		//Евросиб Каблов 26.02.2020 )
			
	КонецЦикла;

КонецПроцедуры
 

// Блок описания регламентных операций периода выполненных объемов

&НаСервереБезКонтекста
Функция ОтнесениеВСтопЛистПокупателейСЗадолженностью()
	
	СрокДляБана = Константы.СрокЗадолженностиДляОтнесенияПокупателяВСтопЛист.Получить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.Контрагент КАК Контрагент,
	               |	РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.Договор КАК Договор,
	               |	РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.СчетПокупателю КАК СчетПокупателю,
	               |	РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.НеразнесеннаяСуммаОстаток КАК НеразнесеннаяСуммаОстаток,
	               |	РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.СчетПокупателю.ДоговорКонтрагента.СрокОплаты КАК СрокОплаты,
	               |	РАЗНОСТЬДАТ(РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.СчетПокупателю.ДатаДокумента, &ТекущаяДата, ДЕНЬ) КАК ПрошлоВремени,
	               |	ВЫБОР
	               |		КОГДА РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.СчетПокупателю.ДоговорКонтрагента.СрокОплаты > РАЗНОСТЬДАТ(РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.СчетПокупателю.ДатаДокумента, &ТекущаяДата, ДЕНЬ)
	               |			ТОГДА 0
	               |		ИНАЧЕ РАЗНОСТЬДАТ(РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.СчетПокупателю.ДатаДокумента, &ТекущаяДата, ДЕНЬ) - РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.СчетПокупателю.ДоговорКонтрагента.СрокОплаты
	               |	КОНЕЦ КАК ПросрочкаПлатежа,
	               |	СтопЛистКонтрагентовСрезПоследних.ВСтопЛисте КАК ВСтопЛисте,
	               |	РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.Договор.Номер КАК НомерДоговора
	               |ИЗ
	               |	РегистрНакопления.РазнесениеСчетовПокупателейПоВходящимПлатежам.Остатки КАК РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтопЛистКонтрагентов.СрезПоследних КАК СтопЛистКонтрагентовСрезПоследних
	               |		ПО РазнесениеСчетовПокупателейПоВходящимПлатежамОстатки.Контрагент = СтопЛистКонтрагентовСрезПоследних.Контрагент";
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Ответ = Запрос.Выполнить().Выбрать();
	МассивЗаблокированныхКлиентов = Новый Массив;
	СписокПричин = "";
	КоличествоКонтрагентов = 0;
	СписокКонтрагентов = "";
	Пока Ответ.Следующий() Цикл
		Если МассивЗаблокированныхКлиентов.Найти(Ответ.Контрагент) = неопределено И Ответ.ПросрочкаПлатежа > 0 И Ответ.ВСтопЛисте <> Истина Тогда
			
			Причина = "Просрочка оплаты на сумму " + Ответ.НеразнесеннаяСуммаОстаток + " по договору " + Ответ.НомерДоговора + " на дней " + Ответ.ПросрочкаПлатежа;
			
			МЗ = РегистрыСведений.СтопЛистКонтрагентов.СоздатьМенеджерЗаписи();
			МЗ.ВСтопЛисте = Истина;
			МЗ.Комментарий = "Отнесено автоматически при закрытии периода выполненных объемов " + ТекущаяДата() + " " + Причина;
			МЗ.Пользователь = Пользователи.ТекущийПользователь();
			МЗ.Период = ТекущаяДата();
			МЗ.Контрагент = Ответ.Контрагент;
			МЗ.Записать(Истина);
			
			КоличествоКонтрагентов = КоличествоКонтрагентов + 1;
			СписокКонтрагентов = СписокКонтрагентов + ", " + Ответ.Контрагент;
			СписокПричин = СписокПричин + ", " + Причина;
			МассивЗаблокированныхКлиентов.Добавить(Ответ.Контрагент);
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат "Заблокировано: " + КоличествоКонтрагентов + " список: " + СписокКонтрагентов + " причины: " + СписокПричин;
	
КонецФункции

&НаСервереБезКонтекста
Функция СнятьСМониторингаНеактивныхКонтрагентов(ТекАктивные, Период, Ссылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Контрагенты.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Контрагенты КАК Контрагенты
	               |ГДЕ
	               |	НЕ Контрагенты.ПометкаУдаления
	               |	И НЕ Контрагенты.ЭтоГруппа
	               |	И Контрагенты.СПАРК_Мониторинг
	               |	И НЕ Контрагенты.Ссылка В (&АктивныеСейчас)
	               |	И НЕ Контрагенты.Ссылка В
	               |				(ВЫБРАТЬ
	               |					ЗакрытиеПериодаДвиженияПериода.Контрагент КАК Контрагент
	               |				ИЗ
	               |					ТЧ_Движения_ЗакрытиеПериода КАК ЗакрытиеПериодаДвиженияПериода
	               |				ГДЕ
	               |					ЗакрытиеПериодаДвиженияПериода.Документ.Проведен
	               |					И ЗакрытиеПериодаДвиженияПериода.Документ.ПериодБлокировки МЕЖДУ &Период1 И &Период2
	               |					И ЗакрытиеПериодаДвиженияПериода.Документ = &ТекДок
	               |				СГРУППИРОВАТЬ ПО
	               |					ЗакрытиеПериодаДвиженияПериода.Контрагент)";
	Запрос.УстановитьПараметр("АктивныеСейчас", ТекАктивные);
	Запрос.УстановитьПараметр("ТекДок", Ссылка);
	//Евросиб Каблов М.Б. 29.10.2019 (
	//Запрос.УстановитьПараметр("Период1", Период - Константы.СрокМесяцевСнятияКонтрагентовСМониторинга.Получить()*31*24*3600);
	СрокМесяцевСнятияСМониторинга = Константы.СрокМесяцевСнятияКонтрагентовСМониторинга.Получить();
	Запрос.УстановитьПараметр("Период1", ДобавитьМесяц(Период, -СрокМесяцевСнятияСМониторинга));
	//Евросиб Каблов М.Б. 29.10.2019 )
	Запрос.УстановитьПараметр("Период2", Период);	
	Ответ = Запрос.Выполнить().Выбрать();
	КоличествоСнятых = 0;
	СтрокаСписка = "";
	Пока Ответ.Следующий() Цикл
		КоличествоСнятых = КоличествоСнятых + 1;
		ОО = Ответ.Ссылка.ПолучитьОбъект();
		ОО.СПАРК_Мониторинг = Ложь;
		ОО.Записать();
		СтрокаСписка = СтрокаСписка + ", " + Ответ.Ссылка;
	КонецЦикла;
	
	Возврат "Снято с мониторинга: " + КоличествоСнятых + " " + СтрокаСписка;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПостановкаНаМониторинг(ТекАктивные)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Контрагенты.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Контрагенты КАК Контрагенты
	               |ГДЕ
	               |	НЕ Контрагенты.ПометкаУдаления
	               |	И НЕ Контрагенты.ЭтоГруппа
	               |	И НЕ Контрагенты.СПАРК_Мониторинг
	               |	И Контрагенты.Ссылка В(&АктивныеСейчас)
	               |	И Контрагенты.СтранаРегистрации = &СтранаРегистрацииРоссия";
	Запрос.УстановитьПараметр("АктивныеСейчас", ТекАктивные);
	Запрос.УстановитьПараметр("СтранаРегистрацииРоссия", Справочники.СтраныМира.Россия);
	Ответ = Запрос.Выполнить().Выбрать();
	КоличествоСнятых = 0;
	СтрокаСписка = "";
	Пока Ответ.Следующий() Цикл
		КоличествоСнятых = КоличествоСнятых + 1;
		ОО = Ответ.Ссылка.ПолучитьОбъект();
		ОО.СПАРК_Мониторинг = Истина;
		ОО.Записать();
		СтрокаСписка = СтрокаСписка + ", " + Ответ.Ссылка;
	КонецЦикла;
	
	Возврат "Поставлено на мониторинг: " + КоличествоСнятых + " " + СтрокаСписка;
	
КонецФункции

&НаСервереБезКонтекста
Функция ОбновлениеИндексаСпаркПоКонтрагентамНаМониторинге()
	
	КоличествоУспешных = 0;
	КоличествоНеуспешных = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Контрагенты.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Контрагенты КАК Контрагенты
	               |ГДЕ
	               |	НЕ Контрагенты.ПометкаУдаления
	               |	И НЕ Контрагенты.ЭтоГруппа
	               |	И Контрагенты.СПАРК_Мониторинг";
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		Результат = СПАРКЗапросыСервер.ОбновитьКонтрагентаСПАРК(Ответ.Ссылка);
		Если Результат = Истина ТОгда
			КоличествоУспешных = КоличествоУспешных + 1;
		Иначе
			КоличествоНеуспешных = КоличествоНеуспешных + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "Успешно: " + КоличествоУспешных + ", не успешно: " + КоличествоНеуспешных;
	
КонецФункции

&НаКлиенте
Процедура ПериодБлокировкиРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Объект.ПериодБлокировки = НачалоМесяца(ДобавитьМесяц(Объект.ПериодБлокировки, Направление));
	Модифицированность = Истина;
	
	ПериодБлокировки = Формат(Объект.ПериодБлокировки, "ДФ='ММММ гггг'");
	
