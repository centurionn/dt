	Элементы.ВключитьРассылку.ТолькоПросмотр = Не РольДоступна("ПолныеПрава");
	//Евросиб Каблов 09.06.2021 ) 
	

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры

