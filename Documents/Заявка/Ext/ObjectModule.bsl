	ТабЧастьСоставУслуги = СоставУслуги.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТабЧастьСоставУслуги.ПринадлежностьТЕ КАК ПринадлежностьТЕ,
		|	ТабЧастьСоставУслуги.РазмерКТК КАК РазмерКТК,
		|	ТабЧастьСоставУслуги.Калькуляция КАК Калькуляция
		|ПОМЕСТИТЬ ДанныеДляПроверки
		|ИЗ
		|	&ТабЧастьСоставУслуги КАК ТабЧастьСоставУслуги
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ КалькуляцииСЗаполненнойСтавкой20
		|ИЗ
		|	Документ.Калькуляция.ММ_КалькуляцияМультимодальнойЦепочки КАК КалькуляцияММ_КалькуляцияМультимодальнойЦепочки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДанныеДляПроверки КАК ЗаявкаСоставУслуги
		|		ПО (ЗаявкаСоставУслуги.Калькуляция = КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка)
		|			И (КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Цена20 > 0)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ КалькуляцииСЗаполненнойСтавкой40
		|ИЗ
		|	Документ.Калькуляция.ММ_КалькуляцияМультимодальнойЦепочки КАК КалькуляцияММ_КалькуляцияМультимодальнойЦепочки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДанныеДляПроверки КАК ЗаявкаСоставУслуги
		|		ПО (ЗаявкаСоставУслуги.Калькуляция = КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка)
		|			И (КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Цена40 > 0)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗаявкаСоставУслуги.Калькуляция КАК Калькуляция,
		|	ДокКалькуляция.ММ_ИтогоСтавка20 КАК ММ_ИтогоСтавка20,
		|	ДокКалькуляция.ММ_ИтогоСтавка КАК ММ_ИтогоСтавка,
		|	ДокКалькуляция.Номер КАК Номер
		|ИЗ
		|	ДанныеДляПроверки КАК ЗаявкаСоставУслуги
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Калькуляция КАК ДокКалькуляция
		|			ЛЕВОЕ СОЕДИНЕНИЕ КалькуляцииСЗаполненнойСтавкой20 КАК КалькуляцииСЗаполненнойСтавкой20
		|			ПО (КалькуляцииСЗаполненнойСтавкой20.Ссылка = ДокКалькуляция.Ссылка)
		|			ЛЕВОЕ СОЕДИНЕНИЕ КалькуляцииСЗаполненнойСтавкой40 КАК КалькуляцииСЗаполненнойСтавкой40
		|			ПО (КалькуляцииСЗаполненнойСтавкой40.Ссылка = ДокКалькуляция.Ссылка)
		|		ПО ЗаявкаСоставУслуги.Калькуляция = ДокКалькуляция.Ссылка
		|ГДЕ
		|	ДокКалькуляция.ТипКалькуляции <> ЗНАЧЕНИЕ(Перечисление.ТипыКалькуляций.ПредоставлениеПСБезТарифаГруженого)
		|	И ДокКалькуляция.ТипКалькуляции <> ЗНАЧЕНИЕ(Перечисление.ТипыКалькуляций.ПредоставлениеПССТарифом)
		|	И (ЗаявкаСоставУслуги.ПринадлежностьТЕ = ЗНАЧЕНИЕ(Перечисление.ПринадлежностьТЕ.КТКлиента)
		|				И НЕ ДокКалькуляция.веб_ДляКТККлиента
		|			ИЛИ ЗаявкаСоставУслуги.ПринадлежностьТЕ = ЗНАЧЕНИЕ(Перечисление.ПринадлежностьТЕ.КТЕвросиба)
		|				И НЕ ДокКалькуляция.веб_ДляКТКЕвросиб)
		|			ИЛИ ЗаявкаСоставУслуги.РазмерКТК = ЗНАЧЕНИЕ(Справочник.РазмерыКТК.К20)
		|				И КалькуляцииСЗаполненнойСтавкой20.Ссылка ЕСТЬ NULL
		|				И ДокКалькуляция.ММ_ИтогоСтавка20 = 0
		|			ИЛИ (ЗаявкаСоставУслуги.РазмерКТК = ЗНАЧЕНИЕ(Справочник.РазмерыКТК.К40)
		|				ИЛИ ЗаявкаСоставУслуги.РазмерКТК = ЗНАЧЕНИЕ(Справочник.РазмерыКТК.К45))
		|				И КалькуляцииСЗаполненнойСтавкой40.Ссылка ЕСТЬ NULL
		|				И ДокКалькуляция.ММ_ИтогоСтавка = 0
		|	 		
		|";
	
	Запрос.УстановитьПараметр("ТабЧастьСоставУслуги", ТабЧастьСоставУслуги);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Результат = Ложь;
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ТекстСообщения = СтрШаблон("В калькуляции %1 в разделе 1.3 не определена ставка для указанного размера и принадлежности КТК.", Выборка.Номер);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Результат = Истина;
	КонецЦикла; 
	
	Возврат Результат;

КонецФункции //Евросиб Коханенко Н.А. 10.06.2025 )) #93365

//Евросиб Коханенко Н.А. 12.02.2026 (( #93365
Функция СформироватьТекстСообщенияОНесоответствииЗначенийРеквизитов(ДокументСравнения, НомерДокументаСравнения, МассивРеквизитов)

	КоличествоРеквизитовБольшеОдного = МассивРеквизитов.Количество() > 1; 
	КоличествоРеквизитовРавноДва = МассивРеквизитов.Количество() = 2;
	ТекстСообщения = СтрШаблон("В %1 № %2 пол%3 %4 не совпада%5т с аналогичным%6 пол%3м%6 в заявке. Необходимо внести изменения.", 
	ДокументСравнения,
	ПрефиксацияОбъектовКлиентСервер.УдалитьЛидирующиеНулиИзНомераОбъекта(НомерДокументаСравнения),
		?(КоличествоРеквизитовБольшеОдного, "я", "е"),
		СтрСоединить(МассивРеквизитов, ?(КоличествоРеквизитовРавноДва, " и ", ", ")),
		?(КоличествоРеквизитовБольшеОдного, "ю", "е"),
		?(КоличествоРеквизитовБольшеОдного, "и", ""));
	Возврат ТекстСообщения;
	
КонецФункции 

