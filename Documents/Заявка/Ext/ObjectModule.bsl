Процедура ОчиститьАвтоперевозку()
	// Евросиб Фролов (06.12.2021 TASK№ №42618, РелизКлиента
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЗаявкаСписокЗапросНаКТК.Автоперевозка КАК Автоперевозка,
	|	ЗаявкаСписокЗапросНаКТК.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ втЗапросНаКТК
	|ИЗ
	|	&СписокЗапросНаКТК КАК ЗаявкаСписокЗапросНаКТК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	втЗапросНаКТК.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	втЗапросНаКТК КАК втЗапросНаКТК
	|ГДЕ
	|	втЗапросНаКТК.Автоперевозка <> &Автоперевозка";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("СписокЗапросНаКТК", 		СписокЗапросНаКТК.Выгрузить());
	Запрос.УстановитьПараметр("Автоперевозка", 			Перечисления.ВариантыАвтоперевозки.СиламиКлиента);
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		
		МассивУдаляемыхИдентификаторов = Результат.Выгрузить().ВыгрузитьКолонку("ИдентификаторСтроки");
		
		// Транспортные средства
		Индекс = ТранспортныеСредства.Количество() - 1;
		Пока Индекс >= 0 Цикл
			Если МассивУдаляемыхИдентификаторов.Найти(ТранспортныеСредства[Индекс].ИдентификаторСтрокиЗапроса) <> Неопределено Тогда
				ТранспортныеСредства.Удалить(Индекс);
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
		
	КонецЕсли;	
	
	// Евросиб Фролов)
КонецПроцедуры	

Функция ПроверитьЗаполнениАвтоперевозки(РежимЗаписи, Отказ, ДополнительныеСвойства)        
	
	// ДИТ BUG 79844 Сержантова А.С. Начало: 16.01.2024
	Если ДополнительныеСвойства.Свойство("ДанныеДляОбновленияКлючейАналитики") Тогда
		ДанныеДляОбновленияКлючейАналитики = ДополнительныеСвойства.ДанныеДляОбновленияКлючейАналитики;  
		МассивСтрокТС = Новый Массив;
		МассивСтрокЗапроса = Новый Массив; 
		Для каждого СтрДанныхКлюча Из ДанныеДляОбновленияКлючейАналитики Цикл 
			ДанныеКлючаПоСтроке = СтрДанныхКлюча.ДанныеКлюча;
			Если (СтрДанныхКлюча.ИсточникКлюча = "ТранспортныеСредства" 
				и ДанныеКлючаПоСтроке.СтруктураТЧМилиПерваяМиляКлючаАналитики.ВариантАвтоперевозки = Перечисления.ВариантыАвтоперевозки.СиламиКлиента) 
				Тогда
				РеквизитыДляПроверки = ДанныеКлючаПоСтроке.СтруктураТЧМилиПерваяМиляКлючаАналитики; 
			ИначеЕсли (СтрДанныхКлюча.ИсточникКлюча = "ТранспортныеСредстваПоследняяМиля"
				и ДанныеКлючаПоСтроке.СтруктураТЧМилиПоследняяМиляКлючаАналитики.ВариантАвтоперевозки = Перечисления.ВариантыАвтоперевозки.СиламиКлиента)
				Тогда 
				РеквизитыДляПроверки = ДанныеКлючаПоСтроке.СтруктураТЧМилиПоследняяМиляКлючаАналитики;            	
			КонецЕсли;
			Если РеквизитыДляПроверки <> Неопределено и  
				(РеквизитыДляПроверки.ФИОВодителя = "" и РеквизитыДляПроверки.РегНомерТС <> ""
				ИЛИ РеквизитыДляПроверки.ФИОВодителя <> "" и РеквизитыДляПроверки.РегНомерТС = ""
				ИЛИ (РеквизитыДляПроверки.Автоперевозчик = "" ИЛИ РеквизитыДляПроверки.Автоперевозчик = Неопределено
					ИЛИ РеквизитыДляПроверки.Автоперевозчик = Справочники.Контрагенты.ПустаяСсылка()) 
					и РеквизитыДляПроверки.ФИОВодителя = "" и РеквизитыДляПроверки.РегНомерТС = "") Тогда   
                    МассивСтрокТС.Добавить(СтрДанныхКлюча.НомерСтроки);
					// ДИТ US 78243 ТА 80825 Сержантова А.С. Начало: 19.02.2024
					Если МассивСтрокЗапроса.Найти(РеквизитыДляПроверки.НомерСтрокиЗапроса) = Неопределено Тогда
						МассивСтрокЗапроса.Добавить(РеквизитыДляПроверки.НомерСтрокиЗапроса);
					КонецЕсли;
					// ДИТ US 78243 ТА 80825 Сержантова А.С. Конец: 19.02.2024
			КонецЕсли;
		КонецЦикла;  
		
		Если МассивСтрокЗапроса.Количество() Тогда
			ТекстОшибки = СтрШаблон("В строке %1 запроса на КТК содержатся неполные данные по автоперевозке в строке %2 вложенной таблицы",
									СтрСоединить(МассивСтрокЗапроса, ","),СтрСоединить(МассивСтрокТС,","));
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект,,,Отказ);
		КонецЕсли;   
	Иначе
	// ДИТ BUG 79844 Сержантова А.С. Конец: 16.01.2024
	
	// Евросиб Фролов (06.12.2021 TASK№ №42618, РелизКлиента
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("СписокЗапроса", 			СписокЗапросНаКТК.Выгрузить());
	Запрос.УстановитьПараметр("ТранспортныеСредства", 	ТранспортныеСредства.Выгрузить());
	Запрос.УстановитьПараметр("Автоперевозка", 			Перечисления.ВариантыАвтоперевозки.СиламиКлиента);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаявкаСписокЗапросНаКТК.НомерСтроки КАК НомерСтроки,
	|	ЗаявкаСписокЗапросНаКТК.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ЗаявкаСписокЗапросНаКТК.Автоперевозка КАК Автоперевозка,
	|	ЗаявкаСписокЗапросНаКТК.КоличествоКТК КАК КоличествоКТК
	|ПОМЕСТИТЬ втЗапрос
	|ИЗ
	|	&СписокЗапроса КАК ЗаявкаСписокЗапросНаКТК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023
	//|ВЫБРАТЬ
	//|	ТранспортныеСредства.НомерСтроки КАК НомерСтроки,
	//|	ТранспортныеСредства.ФИОВодителя КАК ФИОВодителя,
	//|	ТранспортныеСредства.РегНомерТС КАК РегНомерТС,
	//|	ТранспортныеСредства.Автоперевозчик КАК Автоперевозчик,
	//|	ТранспортныеСредства.ИдентификаторСтрокиЗапроса КАК ИдентификаторСтрокиЗапроса,
	//|ПОМЕСТИТЬ втТранспортныеСредства
	//|ИЗ
	//|	&ТранспортныеСредства КАК ТранспортныеСредства";
	|ВЫБРАТЬ
	|	ТранспортныеСредства.ИдентификаторСтрокиЗапроса КАК ИдентификаторСтрокиЗапроса,
	|	ТранспортныеСредства.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
	|	ТранспортныеСредства.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ втТранспортныеСредства1
	|ИЗ
	|	&ТранспортныеСредства КАК ТранспортныеСредства
	|;
	|ВЫБРАТЬ
	|	втТранспортныеСредства1.НомерСтроки КАК НомерСтроки,
	|	КлючиАналитикиПеревозкиМили.ФИОВодителя КАК ФИОВодителя,
	|	КлючиАналитикиПеревозкиМили.РегНомерТС КАК РегНомерТС,
	|	КлючиАналитикиПеревозкиМили.Автоперевозчик КАК Автоперевозчик,
	|	втТранспортныеСредства1.ИдентификаторСтрокиЗапроса КАК ИдентификаторСтрокиЗапроса,
	|	втТранспортныеСредства1.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки
	|ПОМЕСТИТЬ втТранспортныеСредства
	|ИЗ
	|	втТранспортныеСредства1 КАК втТранспортныеСредства1
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозкиМили
	|				ПО втТранспортныеСредства1.КлючАналитикиПеревозки = КлючиАналитикиПеревозкиМили.Ссылка
	|				И (КлючиАналитикиПеревозкиМили.ЭтапПеревозки = ЗНАЧЕНИЕ(Перечисление.ЭтапыПеревозки.ПерваяМиля))";
	//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023
	Запрос.Выполнить();
	
	// Проверяем, что заполнены поля "ФИО водителя" и "ТС"
	Запрос.Текст =
	//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -начало
	//"ВЫБРАТЬ
	//|	втЗапрос.НомерСтроки КАК КТКНомерСтроки,
	//|	втТранспортныеСредства.НомерСтроки КАК НомерСтроки,
	//|	втТранспортныеСредства.ФИОВодителя КАК ФИОВодителя,
	//|	втТранспортныеСредства.РегНомерТС КАК РегНомерТС
	//|ИЗ
	//|	втЗапрос КАК втЗапрос
	//|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втТранспортныеСредства КАК втТранспортныеСредства
	//|		ПО втЗапрос.ИдентификаторСтроки = втТранспортныеСредства.ИдентификаторСтрокиЗапроса
	//|ГДЕ
	//|	(втТранспортныеСредства.ФИОВодителя = """"
	//|				И втТранспортныеСредства.РегНомерТС <> """"
	//|			ИЛИ втТранспортныеСредства.ФИОВодителя <> """"
	//|				И втТранспортныеСредства.РегНомерТС = """"
	//|			ИЛИ ((втТранспортныеСредства.Автоперевозчик = НЕОПРЕДЕЛЕНО
	//|				ИЛИ втТранспортныеСредства.Автоперевозчик = """"
	//|				ИЛИ втТранспортныеСредства.Автоперевозчик = &ПустойКонтрагент)
	//|					И втТранспортныеСредства.ФИОВодителя = """"
	//|					И втТранспортныеСредства.РегНомерТС = """")
	//|				И втЗапрос.Автоперевозка = &Автоперевозка)
	//|ИТОГИ ПО
	//|	КТКНомерСтроки";
	
	"ВЫБРАТЬ
	|	втЗапрос.НомерСтроки КАК КТКНомерСтроки,
	|	втТранспортныеСредства.НомерСтроки КАК НомерСтроки,
	|	КлючиАналитикиПеревозкиМили.ФИОВодителя КАК ФИОВодителя,
	|	КлючиАналитикиПеревозкиМили.РегНомерТС КАК РегНомерТС
	|ИЗ
	|	втЗапрос КАК втЗапрос
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втТранспортныеСредства КАК втТранспортныеСредства
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозкиМили
	|				ПО втТранспортныеСредства.КлючАналитикиПеревозки = КлючиАналитикиПеревозкиМили.Ссылка
	|				И (КлючиАналитикиПеревозкиМили.ЭтапПеревозки = ЗНАЧЕНИЕ(Перечисление.ЭтапыПеревозки.ПерваяМиля))
	|		ПО втЗапрос.ИдентификаторСтроки = втТранспортныеСредства.ИдентификаторСтрокиЗапроса
	|ГДЕ
	|	(КлючиАналитикиПеревозкиМили.ФИОВодителя = """"
	|				И КлючиАналитикиПеревозкиМили.РегНомерТС <> """"
	|			ИЛИ КлючиАналитикиПеревозкиМили.ФИОВодителя <> """"
	|				И КлючиАналитикиПеревозкиМили.РегНомерТС = """"
	|			ИЛИ ((КлючиАналитикиПеревозкиМили.Автоперевозчик = НЕОПРЕДЕЛЕНО
	|				ИЛИ КлючиАналитикиПеревозкиМили.Автоперевозчик = """"
	|				ИЛИ КлючиАналитикиПеревозкиМили.Автоперевозчик = &ПустойКонтрагент)
	|					И КлючиАналитикиПеревозкиМили.ФИОВодителя = """"
	|					И КлючиАналитикиПеревозкиМили.РегНомерТС = """")
	|				И втЗапрос.Автоперевозка = &Автоперевозка)
	|ИТОГИ ПО
	|	КТКНомерСтроки";
	//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -конец
	Запрос.УстановитьПараметр("ПустойКонтрагент", 			Справочники.Контрагенты.ПустаяСсылка());
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаКТКНомерСтроки = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	//ДИТ Шевченко А.В. 59945 05.10.22 -начало
	Пока ВыборкаКТКНомерСтроки.Следующий() Цикл
	
		ВыборкаДетальныеЗаписи = ВыборкаКТКНомерСтроки.Выбрать();
	    МассивСтрокТС = Новый Массив;
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			МассивСтрокТС.Добавить(ВыборкаДетальныеЗаписи.НомерСтроки);	
		КонецЦикла;
		
		ОбщегоНазначения.СообщитьПользователю( СтрШаблон("В строке %1 запроса на КТК содержатся неполные данные по автоперевозке в строке %2 вложенной таблицы",ВыборкаКТКНомерСтроки.КТКНомерСтроки,СтрСоединить(МассивСтрокТС,","))
												,
												ЭтотОбъект,
												,
												,
												Отказ);
		
	КонецЦикла;	
	//ДИТ Шевченко А.В. 59945 05.10.22 -конец    
	
