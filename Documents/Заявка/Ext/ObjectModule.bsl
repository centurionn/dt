Процедура ДвиженияПодсветкаФормДокументов(Отказ, РежимПроведения);
	
	ЭтоНовый = Ложь;
	ДополнительныеСвойства.Свойство("ЭтоНовый", ЭтоНовый);
	Если ЭтоНовый = Истина Тогда
		Возврат;
	КонецЕсли;	
	
	Если Не ЗапросНаКТК Тогда
		Возврат;
	КонецЕсли;	

	Если ДополнительныеСвойства.ОчищатьЗаписиРегистраПодсветки = Истина Тогда
		НаборЗаписей = РегистрыСведений.ПодсветкаФормДокументов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Ссылка);
		НаборЗаписей.Записать();	
		Возврат;
	КонецЕсли;	
	
	ПодсвечиваниеПолейОбъектов.ВыполнитьДвиженияПодсветкаФормДокументов(Ссылка, ЭтотОбъект, ДополнительныеСвойства, Движения, Отказ, РежимПроведения);
	
КонецПроцедуры
