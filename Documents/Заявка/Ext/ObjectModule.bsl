		|		ПО ДокЗаявка.Ссылка = СибурРазмещенныеЗаявки.Заявка
		|ГДЕ
		|	ДокЗаявка.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();	
	
	Если Выборка.Следующий() Тогда
		Если СтатусЗаявкиСибур <> Выборка.СтатусЗаявкиСибур Или ПричинаОтклоненияЗаявки <> Выборка.ПричинаОтклоненияЗаявки Тогда
			
			ЗаписьСтатуса = РегистрыСведений.СибурСтатусыЗаявок.СоздатьМенеджерЗаписи();
			ЗаписьСтатуса.Период = ТекущаяДатаСеанса();
			ЗаписьСтатуса.Заявка = Ссылка;
			ЗаписьСтатуса.СтатусЗаявки = СтатусЗаявкиСибур;
			ЗаписьСтатуса.ПричинаОтклоненияЗаявки = ПричинаОтклоненияЗаявки;			
			ЗаписьСтатуса.Записать();
			
			Если ЗначениеЗаполнено(Выборка.ЗаявкаНаОтправкуГруженых) Тогда
				ДокОбъект = Выборка.ЗаявкаНаОтправкуГруженых.ПолучитьОбъект();
				ДокОбъект.СтатусЗаявкиСибур = СтатусЗаявкиСибур;
				ДокОбъект.ПричинаОтклоненияЗаявки = ПричинаОтклоненияЗаявки;
				ДокОбъект.Записать();
			КонецЕсли;
		
		КонецЕсли;		
	КонецЕсли;
	
КонецПроцедуры

