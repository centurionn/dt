//Евросиб(ДИТ), Беляев СЮ, BUG 93345 / TA 96388, 25-11-2024, начало
Функция КонтейнерыСОткрытымЦиклом()
	
	МассивКонтейнеров = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаявкаСоставУслуги.НомерСтроки КАК НомерСтроки,
	|	ЗаявкаСоставУслуги.НомерКТК КАК НомерКТК
	|ПОМЕСТИТЬ ВТ_СоставУслуги
	|ИЗ
	|	&СоставУслуги КАК ЗаявкаСоставУслуги
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	стоки_ТекущиеДанныеСрезПоследних.КТК КАК КТК,
	|	стоки_ТекущиеДанныеСрезПоследних.тек_ВЭксплуатации КАК тек_ВЭксплуатации
	|ПОМЕСТИТЬ ВТ_СтокиТекущиеДанные
	|ИЗ
	|	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних(, КТК В (&СписокКТК)) КАК стоки_ТекущиеДанныеСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаявкаСоставУслуги.НомерКТК КАК НомерКТК,
	|	ЗаявкаСоставУслуги.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	ВТ_СоставУслуги КАК ЗаявкаСоставУслуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтокиТекущиеДанные КАК ВТ_СтокиТекущиеДанные
	|		ПО ЗаявкаСоставУслуги.НомерКТК = ВТ_СтокиТекущиеДанные.КТК
	|ГДЕ
	|	ЕСТЬNULL(ВТ_СтокиТекущиеДанные.тек_ВЭксплуатации, ЛОЖЬ)";
	
	Запрос.УстановитьПараметр("СоставУслуги", СоставУслуги.Выгрузить());
	Запрос.УстановитьПараметр("СписокКТК", СоставУслуги.ВыгрузитьКолонку("НомерКТК"));
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		МассивКонтейнеров = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("НомерКТК");
	КонецЕсли;
	
	Возврат МассивКонтейнеров;
	
КонецФункции
