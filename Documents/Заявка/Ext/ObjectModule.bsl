Процедура ПроверитьКлючевыеРеквизитыЗаказаНаАвтопревозку(Ссылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		//Евросиб Коханенко Н.А. 20.03.2025 (( #104519 
		|	ЗапросНаАвтоперевозку.Ссылка КАК ЗапросСсылка,
		//Евросиб Коханенко Н.А. 20.03.2025 )) #104519 
		|	ЗапросНаАвтоперевозку.ЭтапПеревозки КАК ЭтапПеревозки
		|ИЗ
		|	Документ.ЗапросНаАвтоперевозку КАК ЗапросНаАвтоперевозку
		|ГДЕ
		|	ЗапросНаАвтоперевозку.Заявка = &Заявка
		|	И НЕ ЗапросНаАвтоперевозку.ПометкаУдаления
		|
		|СГРУППИРОВАТЬ ПО
		//Евросиб Коханенко Н.А. 20.03.2025 (( #104519 
		|	ЗапросНаАвтоперевозку.Ссылка,
		//Евросиб Коханенко Н.А. 20.03.2025 )) #104519 
		|	ЗапросНаАвтоперевозку.ЭтапПеревозки
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЭтапПеревозки УБЫВ";
	
