			Если ЭтапПеревозкиП = Перечисления.ЭтапыПеревозки.СредняяМиля Тогда
				ПланыОбмена.ВыгрузкаДанных.ЗарегистрироватьИзмененияПоДокументу(ВыборкаДетальныеЗаписи.ЗапросСсылка, Перечисления.УзлыОбмена.ТЛ);
			Иначе
				МассивДляШаблона.Добавить(?(ЭтапПеревозкиП = Перечисления.ЭтапыПеревозки.ПерваяМиля,"первая миля","последняя миля"));
			КонецЕсли;
			//Евросиб Коханенко Н.А. 20.03.2025 )) #104519 
			КонецЕсли;		
	КонецЦикла;	
    
	Если МассивДляШаблона.Количество() > 0 Тогда 
		// ДИТ US 78243 ТА 78267 Сержантова А.С. Начало: 19.12.2023
		// Было:
		//ОбщегоНазначения.СообщитьПользователю(СтрШаблон("В документ Заявка были внесены изменения после формирования запроса на автоперевозку. Необходимо обновить данные в запросе на автоперевозку (%1)",СтрСоединить(МассивДляШаблона," и ")));
		//Стало:         
		ТекстШаблона = "По данной заявке уже создан запрос на автоперевозку (%1) и необходимо обновить в нем информацию по кнопке ""Обновить из заявки"", после чего отправить обновленные данные в ТЛ";
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон(ТекстШаблона,СтрСоединить(МассивДляШаблона," и ")));
		// ДИТ US 78243 ТА 78267 Сержантова А.С. Конец: 19.12.2023
	КонецЕсли;	
	
КонецПроцедуры	

Функция СравинитьКлючевыеПоляПоМиле(ЭтапПеревозкиП)
	
	ЕстьИзменения = Ложь;
	
	МассивКолонокСверкиЗапросыКТК = Новый Массив;
	МассивКолонокСверкиУслуг      = Новый Массив;
	
	МассивКолонокСверкиЗапросыКТК.Добавить("ИдентификаторСтроки");
	МассивКолонокСверкиЗапросыКТК.Добавить("КоличествоКТК");
	МассивКолонокСверкиЗапросыКТК.Добавить("ТипКТК");
	МассивКолонокСверкиЗапросыКТК.Добавить("ЛокацияВыдачи");	
	
	МассивКолонокСверкиУслуг.Добавить("НомерКТК");
	МассивКолонокСверкиУслуг.Добавить("ТипКТК");
	// ДИТ US 62421 TA 64346 Евсенкин М.А. Начало: 13.02.2023
	// Было:
	//МассивКолонокСверкиУслуг.Добавить("Груз"); 	
	// ДИТ US 62421 TA 64346 Евсенкин М.А. Конец: 13.02.2023
	МассивКолонокСверкиУслуг.Добавить("ВесГрузаНетто");
	МассивКолонокСверкиУслуг.Добавить("КоличествоМест");
	МассивКолонокСверкиУслуг.Добавить("ГУИДСтроки");
	МассивКолонокСверкиУслуг.Добавить("Релиз");
	МассивКолонокСверкиУслуг.Добавить("ВидСобственности");
	МассивКолонокСверкиУслуг.Добавить("ПринадлежностьТЕ");
	МассивКолонокСверкиУслуг.Добавить("ГУИДСтроки");
	
	Если ЭтапПеревозкиП = Перечисления.ЭтапыПеревозки.ПерваяМиля Тогда
		ИмяКолонкиОтбораЗапросы = "Автоперевозка";
		ИмяКолонкиОтбораУслуги  = "ПерваяМиля";
		
		СтруктураОтбораЗапросы = Новый Структура;
		СтруктураОтбораЗапросы.Вставить(ИмяКолонкиОтбораЗапросы,Перечисления.ВариантыАвтоперевозки.СиламиЕвросиб);
		СтруктураОтбораУслуги  = Новый Структура;
		СтруктураОтбораУслуги.Вставить(ИмяКолонкиОтбораУслуги,Перечисления.ВариантыАвтоперевозки.СиламиЕвросиб);		
	Иначе
		ИмяКолонкиОтбораЗапросы = "ПоследняяМиля";
		ИмяКолонкиОтбораУслуги  = "ПоследняяМиля";
		
		СтруктураОтбораЗапросы = Новый Структура;
		СтруктураОтбораЗапросы.Вставить(ИмяКолонкиОтбораЗапросы,Перечисления.ВариантыАвтоперевозки.СиламиЕвросиб);
		СтруктураОтбораУслуги  = Новый Структура;
		СтруктураОтбораУслуги.Вставить(ИмяКолонкиОтбораУслуги,Перечисления.ВариантыАвтоперевозки.СиламиЕвросиб);
	КонецЕсли;	
	
	ТзЗапросовКТКТек   = СписокЗапросНаКТК.Выгрузить(СтруктураОтбораЗапросы,СтрСоединить(МассивКолонокСверкиЗапросыКТК,","));
	ТзУслугКТКТек      = СоставУслуги.Выгрузить(СтруктураОтбораУслуги,СтрСоединить(МассивКолонокСверкиУслуг,","));
	
	ОтветТаблицы       = ПолучитьЗапросыИУслуги(Ссылка,ЭтапПеревозкиП);
	
	ТзЗапросовКТКДоИзм = ОтветТаблицы.ТаблицаЗапросыКТК;
	ТзУслугКТКДоИзм    = ОтветТаблицы.ТаблциУслуги;
	
	Если ТзЗапросовКТКТек.Количество()  <> ТзЗапросовКТКДоИзм.Количество() Тогда
		ЕстьИзменения = Истина;
	КонецЕсли;
	Если ТзУслугКТКТек.Количество()  <> ТзУслугКТКДоИзм.Количество() Тогда
		ЕстьИзменения = Истина;
	КонецЕсли;
	
	Для Каждого СтрокаТзТек Из ТзЗапросовКТКТек Цикл
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("ИдентификаторСтроки",СтрокаТзТек.ИдентификаторСтроки);	
		НайденныеСтроки = ТзЗапросовКТКДоИзм.НайтиСтроки(СтруктураОтбора);
		Если НайденныеСтроки = Неопределено Тогда
			ЕстьИзменения = Истина;	
		КонецЕсли;
		Для Каждого СтрокаДоИзм Из НайденныеСтроки Цикл
			Для Каждого КолонкаЗнч Из ТзЗапросовКТКТек.Колонки Цикл
				Если СтрокаТзТек[КолонкаЗнч.Имя] <> СтрокаДоИзм[КолонкаЗнч.Имя] Тогда
					ЕстьИзменения = Истина;	
				КонецЕсли;
			КонецЦикла;	
		КонецЦикла;	
	КонецЦикла;
	
	Для Каждого СтрокаТзТек Из ТзУслугКТКТек Цикл
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("ГУИДСтроки",СтрокаТзТек.ГУИДСтроки);	
		НайденныеСтроки = ТзУслугКТКДоИзм.НайтиСтроки(СтруктураОтбора);
		Если НайденныеСтроки = Неопределено Тогда
			ЕстьИзменения = Истина;	
		КонецЕсли;
		Для Каждого СтрокаДоИзм Из НайденныеСтроки Цикл
			Для Каждого КолонкаЗнч Из ТзУслугКТКТек.Колонки Цикл
				Если СтрокаТзТек[КолонкаЗнч.Имя] <> СтрокаДоИзм[КолонкаЗнч.Имя] Тогда
					ЕстьИзменения = Истина;	
				КонецЕсли;
			КонецЦикла;	
		КонецЦикла;	
	КонецЦикла;
	
	Возврат ЕстьИзменения;
	
КонецФункции

Функция ПолучитьЗапросыИУслуги(Ссылка,ЭтапПервозкиП)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаявкаСписокЗапросНаКТК.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	ЗаявкаСписокЗапросНаКТК.КоличествоКТК КАК КоличествоКТК,
		|	ЗаявкаСписокЗапросНаКТК.ТипКТК КАК ТипКТК,
		|	ЗаявкаСписокЗапросНаКТК.ЛокацияВыдачи КАК ЛокацияВыдачи
		|ИЗ
		|	Документ.Заявка.СписокЗапросНаКТК КАК ЗаявкаСписокЗапросНаКТК
		|ГДЕ
		|	ЗаявкаСписокЗапросНаКТК.Ссылка = &Ссылка
		|	И &МиляЗапросыКТК = ЗНАЧЕНИЕ(Перечисление.ВариантыАвтоперевозки.СиламиЕвросиб)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаявкаСоставУслуги.НомерКТК КАК НомерКТК,
		|	ЗаявкаСоставУслуги.ТипКТК КАК ТипКТК,
		// ДИТ US 62421 TA 64346 Евсенкин М.А. Начало: 06.02.2023
		// Было:
		//|	ЗаявкаСоставУслуги.Груз КАК Груз, 
		//Стало:
		|	ЗаявкаСоставУслуги.КлючАналитикиПеревозки.Груз КАК Груз,
		// ДИТ US 62421 TA 64346 Евсенкин М.А. Конец: 06.02.2023
		|	ЗаявкаСоставУслуги.ВесГрузаНетто КАК ВесГрузаНетто,
		|	ЗаявкаСоставУслуги.КоличествоМест КАК КоличествоМест,
		|	ЗаявкаСоставУслуги.ГУИДСтроки КАК ГУИДСтроки,
		|	ЗаявкаСоставУслуги.Релиз КАК Релиз,
		|	ЗаявкаСоставУслуги.ВидСобственности КАК ВидСобственности,
		|	ЗаявкаСоставУслуги.ПринадлежностьТЕ КАК ПринадлежностьТЕ
		|ИЗ
		|	Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
		|ГДЕ
		|	ЗаявкаСоставУслуги.Ссылка = &Ссылка
		|	И &МиляУслуги = ЗНАЧЕНИЕ(Перечисление.ВариантыАвтоперевозки.СиламиЕвросиб)";
	
	Если ЭтапПервозкиП = Перечисления.ЭтапыПеревозки.ПерваяМиля Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&МиляЗапросыКТК","ЗаявкаСписокЗапросНаКТК.Автоперевозка");
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&МиляУслуги","ЗаявкаСоставУслуги.ПерваяМиля");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&МиляЗапросыКТК","ЗаявкаСписокЗапросНаКТК.ПоследняяМиля");
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&МиляУслуги","ЗаявкаСоставУслуги.ПоследняяМиля");
	КонецЕсли;
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	СтруктураОтвет = Новый Структура();
	
	СтруктураОтвет.Вставить("ТаблицаЗапросыКТК",РезультатЗапроса[0].Выгрузить());
	СтруктураОтвет.Вставить("ТаблциУслуги",РезультатЗапроса[1].Выгрузить());
	
	Возврат СтруктураОтвет;
	
КонецФункции	

Процедура ПроверитьВозможностьОтменыПоЗаказамНаАвтоперевозку(Отказ) 
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗапросНаАвтоперевозку.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗапросНаАвтоперевозку КАК ЗапросНаАвтоперевозку
		|ГДЕ
		|	ЗапросНаАвтоперевозку.Заявка = &Заявка
		|	И ЗапросНаАвтоперевозку.Проведен";
	
	Запрос.УстановитьПараметр("Заявка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Удаление и отмена проведения заявки №%1 от %2 невозможны. На основе заявки сформированы ""Заказы на автоперевозку""",Номер,Дата),,,,Отказ);
		Прервать;
	КонецЦикла;	
	
КонецПроцедуры	

Процедура ВыполнитьПроверкиПриЗапросеНаКТК(РежимЗаписи, Отказ, ДополнительныеСвойства) 
	// Евросиб Фролов (16.11.2021 TASK№ №41969		
	Для Каждого ТекущаяСтрока Из СписокЗапросНаКТК Цикл
		
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.ДействиеРелизаНачало) Тогда
			ОбщегоНазначения.СообщитьПользователю(
												"Не указано начало действия релиза",
												ЭтотОбъект,
												ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СписокЗапросНаКТК", ТекущаяСтрока.НомерСтроки, "ДействиеРелизаНачало"),
												,
												Отказ);
		КонецЕсли;
											
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.ДействиеРелизаОкончание) Тогда
			ОбщегоНазначения.СообщитьПользователю(
												"Не указано окончание действия релиза",
												ЭтотОбъект,
												ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СписокЗапросНаКТК", ТекущаяСтрока.НомерСтроки, "ДействиеРелизаОкончание"),
												,
												Отказ);
		КонецЕсли;
											
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.ЛокацияВыдачи) Тогда
			ОбщегоНазначения.СообщитьПользователю(
												"Не указана локация выдачи",
												ЭтотОбъект,
												ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СписокЗапросНаКТК", ТекущаяСтрока.НомерСтроки, "ЛокацияВыдачи"),
												,
												Отказ);
		КонецЕсли;
											
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.ЛокацияСдачи) Тогда
			ОбщегоНазначения.СообщитьПользователю(
												"Не указана локация сдачи",
												ЭтотОбъект,
												ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СписокЗапросНаКТК", ТекущаяСтрока.НомерСтроки, "ЛокацияСдачи"),
												,
												Отказ);
		КонецЕсли;
											
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.СрокИспользованияКТК) Тогда
			ОбщегоНазначения.СообщитьПользователю(
												"Не указан срок использования КТК",
												ЭтотОбъект,
												ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СписокЗапросНаКТК", ТекущаяСтрока.НомерСтроки, "СрокИспользованияКТК"),
												,
												Отказ);
		КонецЕсли;
				
	КонецЦикла;	
	// Евросиб Фролов)
	
	ПроверитьЗаполнениАвтоперевозки(РежимЗаписи, Отказ, ДополнительныеСвойства); // Евросиб Фролов (06.12.2021 TASK№ №42618, РелизКлиента // ДИТ Сержантова А.С. 16.01.2024 BUG 79844
КонецПроцедуры

