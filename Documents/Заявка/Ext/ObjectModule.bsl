Процедура ПроверитьВозможностьОтменыПроведенияДокумента(Отказ)
	
	УстановитьПривилегированныйРежим(Истина);
	СписокРодительскихОбъектов = КонтрольДоступностиДокументов_сервер.ПолучитьСписокРодительскихОбъектов(ЭтотОбъект);
	
	ВыборкаПодчиненныхДокументов = КонтрольДоступностиДокументов_сервер.ПолучитьВыборкуПодчиненныхДокументов(ЭтотОбъект.Ссылка);
	Если ВыборкаПодчиненныхДокументов = Неопределено Тогда
		Возврат;
	КонецЕсли;	

	ВыводитьЗаголовок = Истина;
	Пока ВыборкаПодчиненныхДокументов.Следующий() Цикл
		
		Если СписокРодительскихОбъектов.НайтиПоЗначению(ВыборкаПодчиненныхДокументов.Ссылка) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		Если ВыводитьЗаголовок Тогда
			НомерЗаявки = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Номер);
			ДатаЗаявки = Формат(Дата, "ДЛФ=DD");
			ОбщегоНазначения.СообщитьПользователю(
												СтрШаблон("Удаление и отмена проведения заявки №%1 от %2 невозможны. На основе заявки сформированы следующие документы:", НомерЗаявки, ДатаЗаявки),
												ЭтотОбъект,
												,
												,
												Отказ);
			ВыводитьЗаголовок = Ложь;
		КонецЕсли;	
		
		Если ВыборкаПодчиненныхДокументов.СуммаДокумента <> Null Тогда
			ПредставлениеОбъекта = ВыборкаПодчиненныхДокументов.Представление + " " + НСтр("ru='на сумму'") + " " + Формат(ВыборкаПодчиненныхДокументов.СуммаДокумента, "ЧДЦ=2; ЧН=0") + " " + ВыборкаПодчиненныхДокументов.Валюта;
		Иначе
			ПредставлениеОбъекта = ВыборкаПодчиненныхДокументов.Представление;
		КонецЕсли;
		ОбщегоНазначения.СообщитьПользователю(
												ПредставлениеОбъекта,
												ВыборкаПодчиненныхДокументов.Ссылка,
												,
												,
												Отказ);		
													
	КонецЦикла;
		
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры
