// ДИТ US 81881 ТА 83581 Сержантова А.С. 08.04.2024 
//Если изменились рейсы, то обновляем данные в запросах на авто (Терминал выдачи и Дата и время подачи КТК)
Процедура ПроверитьЗапросНаАвтоСоздатьЗадачуНаОбновление()

	// проверяем есть ли не помеченные на удаление запросы на авто, в которых есть строки из данной заявки    
	КлючиВЗаявке = СоставУслуги.ВыгрузитьКолонку("КлючАналитикиПеревозки");  
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(КлючиВЗаявке, ТранспортныеСредства.ВыгрузитьКолонку("КлючАналитикиПеревозки"));  
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(КлючиВЗаявке, ТранспортныеСредстваПоследняяМиля.ВыгрузитьКолонку("КлючАналитикиПеревозки"));
	
	Запрос = Новый Запрос;
	// Евросиб(ДИТ) BUG 87051 Сержантова А.С. Начало: 20.06.2024
	// Было:
	//Запрос.Текст = 
		//"ВЫБРАТЬ РАЗЛИЧНЫЕ
		//|	ЗапросНаАвтоперевозкуКонтейнеры.Ссылка КАК ЗапросНаАвто
		//|ИЗ
		//|	Документ.ЗапросНаАвтоперевозку.Контейнеры КАК ЗапросНаАвтоперевозкуКонтейнеры
		//|ГДЕ
		//|	НЕ ЗапросНаАвтоперевозкуКонтейнеры.Ссылка.ПометкаУдаления
		//|	И ЗапросНаАвтоперевозкуКонтейнеры.КлючАналитикиПеревозки В(&КлючиВЗаявке)";
	//Стало:
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗапросНаАвтоперевозкуКонтейнеры.Ссылка КАК ЗапросНаАвто
		|ИЗ
		|	Документ.ЗапросНаАвтоперевозку.Контейнеры КАК ЗапросНаАвтоперевозкуКонтейнеры
		|ГДЕ
		|	НЕ ЗапросНаАвтоперевозкуКонтейнеры.Ссылка.ПометкаУдаления
		|	И ЗапросНаАвтоперевозкуКонтейнеры.КлючАналитикиПеревозки В(&КлючиВЗаявке)
		|	И ЗапросНаАвтоперевозкуКонтейнеры.Ссылка.Заявка = &Заявка
		|	И ЗапросНаАвтоперевозкуКонтейнеры.КлючАналитикиПеревозки <> ЗНАЧЕНИЕ(Справочник.КлючиАналитикиПеревозки.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Заявка", Ссылка);
	// Евросиб(ДИТ) BUG 87051 Сержантова А.С. Конец: 20.06.2024
	Запрос.УстановитьПараметр("КлючиВЗаявке", КлючиВЗаявке);
	
	Результат = Запрос.Выполнить();
	Если не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();  
		СостояниеДляЗадачиОбновления = Справочники.Состояния.НеобходимоОбновитьДанные;
		Пока Выборка.Следующий() Цикл
			ОбъектЗапросаНаАвто = Выборка.ЗапросНаАвто.ПолучитьОбъект();
			ЗадачаОбновленияДобавлена = Ложь;
			Для каждого СтрСостояния Из ОбъектЗапросаНаАвто.Состояния Цикл
				Если СтрСостояния.Состояние = СостояниеДляЗадачиОбновления Тогда
					СтрСостояния.Статус = Перечисления.СтатусыЭтапов.ВРаботе;
					СтрСостояния.НачалоРаботы = ТекущаяДата(); 
					ЗадачаОбновленияДобавлена = Истина;
				КонецЕсли;
			КонецЦикла;  
			Если не ЗадачаОбновленияДобавлена Тогда
				//Применить к запросу на авто маршрут
				ПараметрыЗапроса = Новый Соответствие;
				РезультатЗапроса = МаршрутизацияСервер.МаршрутизироватьЗапросНаАвто(ПараметрыЗапроса, ОбъектЗапросаНаАвто.Дата);
				Если РезультатЗапроса.Количество() > 0 Тогда
					Если РезультатЗапроса.Количество() > 0 Тогда
						МаршрутизацияСервер.ПрименитьМаршрут(ОбъектЗапросаНаАвто, РезультатЗапроса, ОбъектЗапросаНаАвто.Автор, Новый СписокЗначений); 
					КонецЕсли;
				КонецЕсли;	
			КонецЕсли;
			ОбъектЗапросаНаАвто.Записать();
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры  

// ДИТ US 81881 ТА 83581 Сержантова А.С. 09.04.2024 
Процедура УдалитьИзМассиваАвтомобильныеРейсы(МассивРейсов)
	
	Счетчик = МассивРейсов.Количество() - 1;
	Пока Счетчик >= 0 Цикл
		Если ТипЗнч(МассивРейсов[Счетчик]) <> Тип("СправочникСсылка.РейсыЖД")
			и ТипЗнч(МассивРейсов[Счетчик]) <> Тип("СправочникСсылка.РейсыМоре") Тогда
		    МассивРейсов.Удалить(Счетчик);
		КонецЕсли;	
	    Счетчик = Счетчик - 1;
	КонецЦикла;

КонецПроцедуры

