	ЛокацияПустаяСсылка = ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
	
	Для Каждого ТекущаяСтрокаСписокЗапросНаКТК Из СписокЗапросНаКТК Цикл 
		
		Сообщение = "В строке %1 табличной части ""Запрос на КТК"" очищен реквизит ""%2"". "
				  + "Запрещено копировать локации с типом: ""Сток"", ""Терминал"", ""Порт"", ""Станция ЖД"", ""Улица""!";
		
		Если Документы.Заявка.НеобходимоОчиститьЛокацию(ТекущаяСтрокаСписокЗапросНаКТК.ЛокацияВыдачи) Тогда //ДИТ Гаузер А.В. BUG 51648 TA 56121 16.08.2022
			
			ТекущаяСтрокаСписокЗапросНаКТК.ЛокацияВыдачи = ЛокацияПустаяСсылка;
			
			СообщениеПользователю = СтрШаблон(Сообщение, ТекущаяСтрокаСписокЗапросНаКТК.НомерСтроки, "Локация выдачи"); 
			ОбщегоНазначения.СообщитьПользователю(СообщениеПользователю, ЭтотОбъект, "Объект.СписокЗапросНаКТК["+(ТекущаяСтрокаСписокЗапросНаКТК.НомерСтроки-1)+"].ЛокацияВыдачи", ТекущаяСтрокаСписокЗапросНаКТК.ЛокацияВыдачи); 
			
		КонецЕсли;
		
		Если Документы.Заявка.НеобходимоОчиститьЛокацию(ТекущаяСтрокаСписокЗапросНаКТК.ЛокацияСдачи) Тогда //ДИТ Гаузер А.В. BUG 51648 TA 56121 16.08.2022

			ТекущаяСтрокаСписокЗапросНаКТК.ЛокацияСдачи = ЛокацияПустаяСсылка;

			СообщениеПользователю = СтрШаблон(Сообщение,ТекущаяСтрокаСписокЗапросНаКТК.НомерСтроки, "Локация сдачи"); 
			ОбщегоНазначения.СообщитьПользователю(СообщениеПользователю, ЭтотОбъект, "Объект.СписокЗапросНаКТК["+(ТекущаяСтрокаСписокЗапросНаКТК.НомерСтроки-1)+"].ЛокацияСдачи", ТекущаяСтрокаСписокЗапросНаКТК.ЛокацияСдачи); 

		КонецЕсли; 
		
		//Субботин 77659 12.01.2024 Начало
		ТекущаяСтрокаСписокЗапросНаКТК.СписокКТК = Неопределено;
		ТекущаяСтрокаСписокЗапросНаКТК.ИдентификаторСтроки = Новый УникальныйИдентификатор;   
		//Субботин 77659 12.01.2024 Конец  
	КонецЦикла;	
	//--ДИТ Гаузер А.В. BUG 51648 TA 51649 15.07.2022
	
	СоставУслуги.Очистить(); //ДИТ Шевченко А.В. US 62482 ТА 72785 21.07.2023 
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ИспользоватьАРМКТК = Константы.ИспользоватьАРМКТК.Получить();
	//ДИТ Шевченко А.В. US 62360 ТА 73535 09.08.2023
	//Движения.ПродажиПродуктов.Записывать = Истина;
	//Для каждого Стр из ПереченьРейсов Цикл
	//	Движение 				= Движения.ПродажиПродуктов.ДобавитьПриход();
	//	Движение.ЗанятоСлотов 	= КоличествоКТК20 + КоличествоКТК40*2;
	//	Движение.Отправка 		= Стр.Рейс.ДатаОтправления;
	//	Движение.Период  		= Дата;
	//	Движение.Продукт 		= Стр.Продукт;
	//	Движение.Регистратор 	= Ссылка;
	//	Движение.Организация 	= Организация;
	//КонецЦикла;
	//ДИТ Шевченко А.В. US 62360 ТА 73535 09.08.2023
	// если контейнер изменился, то надо старый контейнер убрать из документа АктПостановкиСнятияСУчета

	Если ИспользоватьАРМКТК = Ложь Тогда
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	АктПостановкиСнятияСУчета.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.АктПостановкиСнятияСУчета КАК АктПостановкиСнятияСУчета
	               |ГДЕ
	               |	АктПостановкиСнятияСУчета.ДокументОснование = &ДокументОснование
	               |	И НЕ АктПостановкиСнятияСУчета.ПометкаУдаления";

	Запрос.УстановитьПараметр("ДокументОснование",Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		// создать новый акт
		ТекАкт = Документы.АктПостановкиСнятияСУчета.СоздатьДокумент();
		ТекАкт.ДокументОснование = Ссылка;
		ТекАкт.Организация = ПСЦ.Организация;
		ТекАкт.ЦФО = ПСЦ.ЦФО;
		ТекАкт.Подразделение = ПСЦ.Подразделение;
		ТекАкт.Автор = Пользователи.ТекущийПользователь(); //Гудкова тикет 0208907  ПСЦ.Автор;
		ТекАкт.Дата = ТекущаяДата();
	Иначе
		// исправить существующий
		Выборка = РезультатЗапроса.Выбрать();
	
		Если Выборка.Следующий() Тогда
			ТекАкт = Выборка.Ссылка.ПолучитьОбъект();
			ТекАкт.РегистрацияНовыхКонтейнеров.Очистить();
		КонецЕсли;
	КонецЕсли;
	
	Для каждого Стр из СоставУслуги Цикл     // SIV 09-09-20 добавил для клиентских КТК также постановку на учет, иначе по таким ктк не создаются паспорта, что не очень хорошо
		Если Стр.ПринадлежностьТЕ = Перечисления.ПринадлежностьТЕ.КТКлиента И ЗначениеЗаполнено(Стр.НомерКТК) Тогда
			НовСтр = ТекАкт.РегистрацияНовыхКонтейнеров.Добавить();
			НовСтр.НомерКонтейнера = Стр.НомерКТК.Наименование;
			НовСтр.ТипКонтейнера = Стр.ТипКТК;
			НовСтр.Владелец = Стр.ВладелецКТК;
			НовСтр.ДатаВводаВЭксплуатацию = Дата;
			//НовСтр.СрокПользованияДней = Стр.НормативноеИспользованиеИзСтока;
			НовСтр.ВидСобственности = Стр.ВидСобственности;
			// ДИТ 65580 Давудов М.А. Начало: 23.02.2023
			//Было:
			//Если Стр.ПринадлежностьТЕ = Перечисления.ПринадлежностьТЕ.КТКлиента Тогда НовСтр.ВидСобственности = Перечисления.ВариантыСобственности.Прочее; КонецЕсли;
			//Стало:
			Если Стр.ПринадлежностьТЕ = Перечисления.ПринадлежностьТЕ.КТКлиента Тогда
				НовСтр.ВидСобственности = Перечисления.ВариантыСобственности.Клиентский;
			КонецЕсли;
			// ДИТ 65580 Давудов М.А. Конец: 23.02.2023
			НовСтр.ЛокацияВыдачи = Стр.ПунктОтправления;
			НовСтр.ЛокацияВозврата = Стр.ПунктНазначения;
			НовСтр.ПСЦ = ПСЦ;
			НовСтр.КонтейнерСсылка = Стр.НомерКТК;
		КонецЕсли;
	КонецЦикла;			
	
	Если 
		ЗначениеЗаполнено(ТекАкт.Ссылка) ИЛИ 
		ТекАкт.РегистрацияНовыхВагонов.Количество() > 0 ИЛИ 
		ТекАкт.СнятиеСУчетаВагона.Количество() > 0 ИЛИ 
		ТекАкт.РегистрацияНовыхКонтейнеров.Количество() > 0 ИЛИ 
		ТекАкт.СнятиеСУчетаКонтейнеров.Количество() > 0  
	Тогда
		ТекАкт.Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;
	
	КонецЕсли;
	
	// в РС СрокиИспользованияКонтейнеров добавить информацию для текущего контейнера по клиенту
	//Для каждого Стр из СоставУслуги Цикл
	//	Если ИспользоватьАРМКТК И ЗначениеЗаполнено(Стр.ДатаВыдачи) И ЗначениеЗаполнено(Стр.ДатаПриемаВПользованиеПередПоставщиком) И ЗначениеЗаполнено(Стр.НомерКТК) Тогда
	//		
	//		СоответствиеПараметры = Новый Соответствие;
	//		СоответствиеПараметры.Вставить("Клиент", Контрагент);
	//		СоответствиеПараметры.Вставить("Договор", Договор);
	//		СоответствиеПараметры.Вставить("ВыдачаКлиенту", Стр.ДатаВыдачи);
	//		СоответствиеПараметры.Вставить("ПолучениеКонтейнера", Стр.ДатаПриемаВПользованиеПередПоставщиком);
	//		СоответствиеПараметры.Вставить("НормативВозвратаОтКлиента", Стр.НормативноеИспользование);
	//		УправлениеКТКВСтокахСервер.ДобавитьЗаписьИспользованияКонтейнера(Дата, Стр.НомерКТК, СоответствиеПараметры, Ложь);
	//		
	//	КонецЕсли;
	//КонецЦикла;			
	
	// Контейнеры в отправках
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	*
	               |ИЗ
	               |	РегистрСведений.КонтейнерыВОтправке КАК КонтейнерыВОтправке
	               |ГДЕ
	               |	КонтейнерыВОтправке.ЗаявкаРегистратор = &ЗаявкаРегистратор";
	Запрос.УстановитьПараметр("ЗаявкаРегистратор", Ссылка);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		МЗ = РегистрыСведений.КонтейнерыВОтправке.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МЗ, Ответ);
		МЗ.Удалить();
	КонецЦикла;
	
	Для каждого Рейс из ПереченьРейсов Цикл
		Если ТипЗнч(Рейс.Рейс) <> Тип("СправочникСсылка.РейсыЖД") Тогда Продолжить; КонецЕсли;
		Для каждого КТК из СоставУслуги Цикл
			Если НЕ ЗначениеЗаполнено(КТК.НомерКТК) ИЛИ ЗначениеЗаполнено(КТК.ПеренесенВЗаявку) Тогда Продолжить; КонецЕсли;
			
			МЗ = РегистрыСведений.КонтейнерыВОтправке.СоздатьМенеджерЗаписи();
			МЗ.ЗаявкаРегистратор = Ссылка;
			МЗ.Отправка = Рейс.Рейс;
			МЗ.Контейнер = КТК.НомерКТК;
			МЗ.Период = Дата;
			МЗ.Регистратор = Ссылка;
			МЗ.Записать(Истина);
			
		КонецЦикла;
	КонецЦикла;
	
	////////////////////////////////////////////////////////////////////////////////////////////////////////////
	////////////////////////////////*********************** *************************///////////////////////////
	////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// регистр КонтейнерыВСтоках Расход.
   // очистка старых движений регистра. это нужно для отмены расходных движений по б/н контейнерам, если они стали номерными.
   // если КТК стал номерным, то кол-во б/н увеличится на этот б/н КТК
    Движения.КонтейнерыВСтоках.Очистить();
    Движения.КонтейнерыВСтоках.Записывать = Истина;
    Движения.Записать();
	
	Движения.ПланируемыеКДоступностиКТК.Записывать = Истина;
	
	ДатаОтправленияРейса = неопределено;
	ДатаПрибытияРейса = неопределено;
	Для каждого Стр3 из ПереченьРейсов Цикл
		Если ТипЗнч(Стр3.Рейс) = Тип("СправочникСсылка.РейсыЖД") Тогда
			ДатаОтправленияРейса = Стр3.Рейс.ДатаОтправления;
			ДатаПрибытияРейса = Стр3.Рейс.ДатаПрибытия;
		КонецЕсли;
	КонецЦикла;
	
	НаборКолонокИзЗаявки = АРМ_Сервер.ПолучитьНаборКолонокКоторыеЗаполняютсяИзЗаявки();
	
	МассивУникальныхРелизов = Новый Массив;
	//ДИТ, Беляев СЮ, BUG 72360, 24-07-2023, начало
	МассивРелизовКлиента = Новый Массив;
	//ДИТ, Беляев СЮ, BUG 72360, 24-07-2023, конец
	//Евросиб(ДИТ), Беляев СЮ, BUG 93345 / TA 96388, 25-11-2024, начало
	МассивКонтейнеровБезЗаписиВТекущиеДанные = КонтейнерыСОткрытымЦиклом();
	//Евросиб(ДИТ), Беляев СЮ, BUG 93345 / TA 96388, 25-11-2024, конец
	Для Каждого Стр Из СоставУслуги Цикл
		
		Если Стр.ПринадлежностьТЕ = Перечисления.ПринадлежностьТЕ.КТКлиента Тогда
			// ДИТ 65580 Давудов М.А. Начало: 23.02.2023
			//Было:
			//Стр.ВидСобственности = Перечисления.ВариантыСобственности.Прочее;
			//Стало:
			Стр.ВидСобственности = Перечисления.ВариантыСобственности.Клиентский;
			// ДИТ 65580 Давудов М.А. Конец: 23.02.2023
		КонецЕсли;
		
		Если Стр.План И ЗначениеЗаполнено(Дата) Тогда
			
				СоотвЗаполнения = Новый Соответствие;
				
				Если НаборКолонокИзЗаявки.Найти("ВидСобственности") <> неопределено И ЗначениеЗаполнено(Стр.ВидСобственности) Тогда
					СоотвЗаполнения.Вставить("тек_ВидСобственности", Стр.ВидСобственности);
				КонецЕсли;
				
				//ДИТ Шевченко А.В. 60130 21.11.22 -начало
				//Евросиб Каблов 16.08.2022 ( US41519
				Если Стр.КлиентскийКТК Тогда
					СоотвЗаполнения.Вставить("КлиентскийКТКизЗаявки", Истина);
					СоотвЗаполнения.Вставить("тек_Договор", Договор);
				КонецЕсли;
				Если Стр.ПринадлежностьТЕ = Перечисления.ПринадлежностьТЕ.КТКлиента Тогда
					СоотвЗаполнения.Вставить("КлиентскийКТКизЗаявки", Истина);
					СоотвЗаполнения.Вставить("тек_Собственник", Стр.ВладелецКТК);
				КонецЕсли;
				//Если ТекущаяДата() > (Отправка-86400) Тогда	
				Если ЗначениеЗаполнено(Отправка) Тогда	
					СоотвЗаполнения.Вставить("тек_НаСлежении", Истина);
					Если ЗначениеЗаполнено(Стр.НомерКТК) Тогда
						Запись = РегистрыСведений.КонтейнерыНаСлежении.СоздатьМенеджерЗаписи();
						Запись.Контейнер = Стр.НомерКТК;
						ЧасовВСутках = 86400;
						Запись.Период = НачалоДня(Отправка-ЧасовВСутках);
						Запись.НаСлежении = Истина;
						Запись.Записать();
					КонецЕсли;
				КонецЕсли;	
				//Евросиб Каблов 16.08.2022 )
				//ДИТ Шевченко А.В. 60130 21.11.22 -конец
				
				//Если НаборКолонокИзЗаявки.Найти("ВладелецКТК") <> неопределено И ЗначениеЗаполнено(Стр.ВладелецКТК) Тогда
				//	СоотвЗаполнения.Вставить("тек_Собственник", Стр.ВладелецКТК);
				//КонецЕсли;
				
				СоотвЗаполнения.Вставить("тек_Сток", Справочники.Локации.ПустаяСсылка());
				СоотвЗаполнения.Вставить("тек_Статус", Перечисления.СтатусыКТК.ВДвижении);
				СоотвЗаполнения.Вставить("ИсточникЗаписи", "Заявка " + Номер);
				
				Если НаборКолонокИзЗаявки.Найти("СтокСдачиПорожнего") <> неопределено И ЗначениеЗаполнено(Стр.СтокСдачиПорожнего) Тогда
					СоотвЗаполнения.Вставить("тек_СтокСдачи", Стр.СтокСдачиПорожнего);
				КонецЕсли;
				
				// ДИТ US 62421 TA 64346 Евсенкин М.А. Начало: 03.02.2023
				// Было:
				//Если НаборКолонокИзЗаявки.Найти("ИнструкцииПоСдачеПорожнего") <> неопределено И ЗначениеЗаполнено(Стр.ИнструкцииПоСдачеПорожнего) Тогда
				//	СоотвЗаполнения.Вставить("тек_ИнструкцияПоСдаче", Стр.ИнструкцииПоСдачеПорожнего);
				//КонецЕсли; 
				//Стало:
				ИнструкцииПоСдачеПорожнего = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Стр.КлючАналитикиПеревозки,"ИнструкцияПоСдаче");
				Если НаборКолонокИзЗаявки.Найти("ИнструкцииПоСдачеПорожнего") <> неопределено И ЗначениеЗаполнено(ИнструкцииПоСдачеПорожнего) Тогда	 
					СоотвЗаполнения.Вставить("тек_ИнструкцияПоСдаче", ИнструкцииПоСдачеПорожнего);
				КонецЕсли;
				// ДИТ US 62421 TA 64346 Евсенкин М.А. Конец: 03.02.2023
				
				//Если ЗначениеЗаполнено(Стр.ДатаВзятия) Тогда
				//	СоотвЗаполнения.Вставить("тек_ДатаВзятияИзСтока", Стр.ДатаВзятия);
				//КонецЕсли;
				//Если ЗначениеЗаполнено(Стр.ДатаПриемаВПользованиеПередПоставщиком) Тогда
				//	СоотвЗаполнения.Вставить("тек_ДатаПриемаВПользование", Стр.ДатаПриемаВПользованиеПередПоставщиком);
				//КонецЕсли;
				//Если ЗначениеЗаполнено(Стр.НормативноеИспользованиеИзСтока) Тогда
				//	СоотвЗаполнения.Вставить("тек_СрокВозврата", Стр.НормативноеИспользованиеИзСтока);
				//КонецЕсли;
				
				//Евросиб Каблов 10.11.2022 ( 52045
				//РегистрыСведений.стоки_ТекущиеДанные.ДобавитьЗапись(Стр.НомерКТК, СоотвЗаполнения, Дата);

				//Евросиб Коханенко Н.А. #63323 02.02.2023 )) 
                //РегистрыСведений.стоки_ТекущиеДанные.ДобавитьЗапись(Стр.НомерКТК, СоотвЗаполнения, Дата,, Не ДополнительныеСвойства.Свойство("ОтключитьВыводСообщений"));
				//Евросиб(ДИТ), Беляев СЮ, BUG 93345 / TA 96388, 25-11-2024, начало
