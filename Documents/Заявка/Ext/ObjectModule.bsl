Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Автор 			 = Пользователи.ТекущийПользователь();
	Контрагент  	 = Автор.АссоциированныйКонтрагент;
	ЦФО 			 = Автор.ЦФО;
	Создано 		 = ТекущаяДата();
	Организация 	 = Константы.ОсновнаяОрганизация.Получить();
	Маршрутизировать = Константы.МаршрутизироватьЗаявку.Получить();
	Подразделение    = Автор.Подразделение;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПСЦ") Тогда
		// Заполнение шапки
		Договор 			  = ДанныеЗаполнения.Договор;
		Контрагент 		      = ДанныеЗаполнения.Контрагент;
		Организация 		  = ДанныеЗаполнения.Организация;
		ОтветственныйМенеджер = ДанныеЗаполнения.ОтветственныйМенеджер;
		Подразделение 		  = ДанныеЗаполнения.Подразделение;
		ПСЦ 				  = ДанныеЗаполнения.Ссылка;
		ЦФО 				  = ДанныеЗаполнения.ЦФО;
		Грузоотправитель 	  = Документы.Заявка.ПолучитьГрузоотправителяПоПСЦ(ПСЦ);
		//Евросиб Коханенко Н.А. 06.07.2023 (( #72162
		Если КонтрагентыДоговоры_Сервер.КонтрагентЯвляетсяДирекциейКонтейнерныхПеревозок(Контрагент) 
			ИЛИ ДанныеЗаполнения.ТипКалькуляции = Перечисления.ТипыКалькуляций.Субсидии ИЛИ ДанныеЗаполнения.ТипКалькуляции = Перечисления.ТипыКалькуляций.Премии Тогда  // ДИТ US 59973 ТА 76151 Сержантова А.С. 16.10.2023 //ДИТ Шевченко А.В. US 103646 TA 103658 10.03.2025
			ВидПеревозки 	  = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПСЦ, "ВидПеревозки");	
		КонецЕсли;
		//Евросиб Коханенко Н.А. 06.07.2023 )) #72162 
// ++ Евросиб Дудоров С.В. US 57543 30.01.2023  
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РефСцеп") Тогда

        ОтветственныйМенеджер = ДанныеЗаполнения.Автор;
		ЦФО 				  = ДанныеЗаполнения.ЦФО;
		Организация 		  = ДанныеЗаполнения.Организация;
		Подразделение 		  = ДанныеЗаполнения.Подразделение;
		
		Отправка			  = ДанныеЗаполнения.ПланируемоеОтправление;	
		Прибытие			  = ДанныеЗаполнения.ПланируемоеПрибытие;	
		ДокументОснование     = ДанныеЗаполнения.Ссылка;
		ВидПеревозки		  = Справочники.ВидыПеревозок.Внутрироссийская;
		
	КонецЕсли;
// -- Евросиб Дудоров С.В. US 57543 30.01.2023  
	#Если ВебКлиент Тогда
		Если Значениезаполнено(Пользователи.ТекущийПользователь().АссоциированныйКонтрагент) Тогда
			ИсточникЗаявки = Перечисления.ИсточникЗаявок.ВебСайт;
		КонецЕсли;
	#КонецЕсли
	
КонецПроцедуры

