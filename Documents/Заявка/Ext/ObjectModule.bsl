Функция ПолучитьРезультатПроверкиНаОшибкиЗаполненияКалькуляций()
	Результат = Ложь;
	ТабЧастьСоставУслуги = СоставУслуги.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТабЧастьСоставУслуги.НомерСтроки КАК НомерСтроки,
		|	ТабЧастьСоставУслуги.НомерКТК КАК НомерКТК,
		|	ТабЧастьСоставУслуги.ПСЦ КАК ПСЦ,
		|	ТабЧастьСоставУслуги.Калькуляция КАК Калькуляция
		|ПОМЕСТИТЬ ДанныеДляПроверки
		|ИЗ
		|	&ТабЧастьСоставУслуги КАК ТабЧастьСоставУслуги
		|ГДЕ
		|	ТабЧастьСоставУслуги.ПСЦ <> ЗНАЧЕНИЕ(Документ.ПСЦ.ПустаяСсылка)
		|	И ТабЧастьСоставУслуги.Калькуляция <> ЗНАЧЕНИЕ(Документ.Калькуляция.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеДляПроверки.НомерСтроки КАК НомерСтроки,
		|	ДанныеДляПроверки.НомерКТК КАК НомерКТК,
		|	ДанныеДляПроверки.ПСЦ КАК ПСЦ,
		|	ДанныеДляПроверки.Калькуляция КАК Калькуляция,
		|	ДокументПСЦ.Договор КАК Договор
		|ИЗ
		|	ДанныеДляПроверки КАК ДанныеДляПроверки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПСЦ КАК ДокументПСЦ
		|		ПО ДанныеДляПроверки.ПСЦ = ДокументПСЦ.Ссылка
		|ГДЕ
		|	ДокументПСЦ.Договор <> &Договор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДанныеДляПроверки.НомерСтроки КАК НомерСтроки,
		|	ДанныеДляПроверки.НомерКТК КАК НомерКТК,
		|	ДанныеДляПроверки.ПСЦ КАК ПСЦ,
		|	ДанныеДляПроверки.Калькуляция КАК Калькуляция
		|ИЗ
		|	ДанныеДляПроверки КАК ДанныеДляПроверки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПСЦ.Калькуляции КАК ПСЦКалькуляции
		|		ПО ДанныеДляПроверки.Калькуляция = ПСЦКалькуляции.Калькуляция
		|			И ДанныеДляПроверки.ПСЦ = ПСЦКалькуляции.Ссылка
		|ГДЕ
		|	ПСЦКалькуляции.Калькуляция ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("ТабЧастьСоставУслуги", ТабЧастьСоставУслуги);
	Запрос.УстановитьПараметр("Договор", Договор);
	МассивРезультатов = Запрос.ВыполнитьПакет();
	ВыборкаОшибкиПоДоговорам = МассивРезультатов[1].Выбрать();	
	Пока ВыборкаОшибкиПоДоговорам.Следующий() Цикл
		Результат = Истина;
		Сообщить(СтрШаблон("Ошибка указания ПСЦ в строке %1. Договор в Протоколе не совпадает с договором в заявке.",ВыборкаОшибкиПоДоговорам.НомерСтроки));
	КонецЦикла;
	ВыборкаОшибкиПоКалькуляциям = МассивРезультатов[2].Выбрать();	
	Пока ВыборкаОшибкиПоКалькуляциям.Следующий() Цикл
		Результат = Истина;
		Сообщить(СтрШаблон("Ошибка указания Калькуляции в строке %1. В протоколе <%2> нет калькуляции <%3>.",
							ВыборкаОшибкиПоКалькуляциям.НомерСтроки,
							ВыборкаОшибкиПоКалькуляциям.ПСЦ,
							ВыборкаОшибкиПоКалькуляциям.Калькуляция));	
	КонецЦикла;

	Возврат Результат;
КонецФункции 
