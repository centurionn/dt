    УправлениеПечатью.ДобавитьУсловиеВидимостиКоманды(КомандаПечати, 
	                                                  "ЗапросНаКТК", 
	                                                  Истина,
	                                                  ВидСравнения.Равно);
КонецПроцедуры
												  
// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов  - Массив    - ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы (выходной параметр).
//  ОбъектыПечати         - СписокЗначений  - значение - ссылка на объект;
//                                            представление - имя области в которой был выведен объект (выходной
//                                                            параметр);
//  ПараметрыВывода       - Структура       - дополнительные параметры сформированных табличных документов (выходной
//                                            параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	// Запрос на КТК
	НужноПечататьМакет = УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ЗапросНаКТК");
	
	Если НужноПечататьМакет Тогда
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
        										КоллекцияПечатныхФорм,
       											"ЗапросНаКТК",
        										"Запрос на КТК",
        										ПечатьЗапросаНаКТК(МассивОбъектов, ОбъектыПечати),
        										,
        										"Документ.Заявка.ПФ_MXL_ЗапросНаКТК");
																						
	КонецЕсли;										
	
КонецПроцедуры

// Функция возвращает табличный документ запроса на КТК
//
// Параметры:
//  МассивОбъектов - Массив - объекты, по которым требуется сформировать печатную форму;
//  ОбъектыПечати  - СписокЗначений - разметка табличных документов по печатаемым объектам:
//   * Значение      - ЛюбаяСсылка - печатаемый объект;
//   * Представление - Строка - имя области, соответствующее объекту.
// 
// Возвращаемое значение:
//  ТабличныйДокумент - печатная форма.
//
Функция ПечатьЗапросаНаКТК(МассивОбъектов, ОбъектыПечати) Экспорт
    
	// Создаем табличный документ и устанавливаем имя параметров печати.
    ТабличныйДокумент = Новый ТабличныйДокумент;
    ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ЗапросНаКТК";
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.Заявка.ПФ_MXL_ЗапросНаКТК");
	
	// Получаем запросом необходимые данные.
    Запрос = Новый Запрос();
    Запрос.Текст =
    "ВЫБРАТЬ
    |	Заявка.Ссылка КАК Ссылка,
    |	Заявка.Номер КАК Номер,
    |	Заявка.Дата КАК Дата,
    |	Заявка.Контрагент КАК Контрагент
    |ИЗ
    |	Документ.Заявка КАК Заявка
    |ГДЕ
    |	Заявка.Ссылка В(&МассивОбъектов)";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Шапка = Запрос.Выполнить().Выбрать();
	
	ПервыйДокумент = Истина;
	
	Пока Шапка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
            // Все документы нужно выводить на разных страницах.
            ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
        КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		// Запомним номер строки, с которой начали выводить текущий документ.
        НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
        
		/////////////////////////////////////////////////////////////
		ТаблицаЗапросов = ПолучитьТаблицуЗапросовНаКТК(Шапка.Ссылка);
		
		// Номера заявок для печати их в основании
		НомерЗаявки = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Шапка.Номер);
		
		ДанныеПечати = Новый Структура;
        ДанныеПечати.Вставить("НомерЗаявки", НомерЗаявки);
		ДанныеПечати.Вставить("ДатаЗаявки",  Шапка.Дата);
		ДанныеПечати.Вставить("Контрагент",  Шапка.Контрагент);
														
		МассивОбластейМакета = Новый Массив;
		
		МассивОбластейМакета.Добавить("Заголовок");
		МассивОбластейМакета.Добавить("Строка");
								
		Для Каждого ИмяОбласти Из МассивОбластейМакета Цикл
			
			ОбластьМакета = Макет.ПолучитьОбласть(ИмяОбласти);
			
			Если ИмяОбласти <> "Строка" Тогда
				ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ДанныеПечати);
				ТабличныйДокумент.Вывести(ОбластьМакета);
			Иначе
				//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -Начало
				//ТабличныеЧастиЗапроса = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Шапка.Ссылка, "ТранспортныеСредства");
				//ТабличныеЧастиЗапросаПоследняяМиля = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Шапка.Ссылка, "ТранспортныеСредстваПоследняяМиля");
				//ТранспортныеСредства = ТабличныеЧастиЗапроса.ТранспортныеСредства.Выгрузить();	
				//ТранспортныеСредстваПоследняяМиля = ТабличныеЧастиЗапросаПоследняяМиля.ТранспортныеСредстваПоследняяМиля.Выгрузить();		
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	ЗаявкаТранспортныеСредства.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
				|	ЗаявкаТранспортныеСредства.ИдентификаторСтрокиЗапроса КАК ИдентификаторСтрокиЗапроса,
				|	КлючиАналитикиПеревозкиМили.ФИОВодителя КАК ФИОВодителя,
				|	КлючиАналитикиПеревозкиМили.ПаспортныеДанные КАК ПаспортныеДанные,
				|	КлючиАналитикиПеревозкиМили.РегНомерТС КАК РегНомерТС,
				|	КлючиАналитикиПеревозкиМили.Автоперевозчик КАК Автоперевозчик,
				|	КлючиАналитикиПеревозкиМили.ИНН КАК ИНН,
				|	КлючиАналитикиПеревозкиМили.КПП КАК КПП,
				|	ЗаявкаТранспортныеСредства.Ссылка КАК Ссылка
				|ИЗ
				|	Документ.Заявка.ТранспортныеСредства КАК ЗаявкаТранспортныеСредства
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозкиМили
				|		ПО ЗаявкаТранспортныеСредства.КлючАналитикиПеревозки = КлючиАналитикиПеревозкиМили.Ссылка
				|			И (КлючиАналитикиПеревозкиМили.ЭтапПеревозки = ЗНАЧЕНИЕ(Перечисление.ЭтапыПеревозки.ПерваяМиля))
				|ГДЕ
				|	ЗаявкаТранспортныеСредства.Ссылка = &Ссылка
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ЗаявкаТранспортныеСредстваПоследняяМиля.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
				|	КлючиАналитикиПеревозкиМили.Ссылка.Контейнер КАК Контейнер,
				|	КлючиАналитикиПеревозкиМили.ФИОВодителя КАК ФИОВодителя,
				|	КлючиАналитикиПеревозкиМили.ПаспортныеДанные КАК ПаспортныеДанные,
				|	КлючиАналитикиПеревозкиМили.РегНомерТС КАК РегНомерТС,
				|	КлючиАналитикиПеревозкиМили.Автоперевозчик КАК Автоперевозчик,
				|	КлючиАналитикиПеревозкиМили.ИНН КАК ИНН,
				|	КлючиАналитикиПеревозкиМили.КПП КАК КПП,
				|	ЗаявкаТранспортныеСредстваПоследняяМиля.Ссылка КАК Ссылка
				|ИЗ
				|	Документ.Заявка.ТранспортныеСредстваПоследняяМиля КАК ЗаявкаТранспортныеСредстваПоследняяМиля
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозкиМили
				|		ПО ЗаявкаТранспортныеСредстваПоследняяМиля.КлючАналитикиПеревозки = КлючиАналитикиПеревозкиМили.Ссылка
				|			И (КлючиАналитикиПеревозкиМили.ЭтапПеревозки = ЗНАЧЕНИЕ(Перечисление.ЭтапыПеревозки.ПоследняяМиля))
				|ГДЕ
				|	ЗаявкаТранспортныеСредстваПоследняяМиля.Ссылка = &Ссылка";
				
				Запрос.УстановитьПараметр("Ссылка", Шапка.Ссылка);
				
				РезультатЗапроса = Запрос.ВыполнитьПакет();
				ТранспортныеСредства = РезультатЗапроса[0].Выгрузить();
				ТранспортныеСредстваПоследняяМиля = РезультатЗапроса[1].Выгрузить();
				//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -конец
				Для Каждого СтрокаТаблицы Из ТаблицаЗапросов Цикл
					// Шапка
					ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
					ОбластьШапка.Параметры.Заполнить(СтрокаТаблицы);
					ТабличныйДокумент.Вывести(ОбластьШапка);
					
					ОбластьМакета.Параметры.Заполнить(СтрокаТаблицы);
					ТабличныйДокумент.Вывести(ОбластьМакета);
					
					//ДИТ Шевченко А.В. TASK 51973 01.06.2022 -Начало
					Если СтрокаТаблицы.Автоперевозка = Перечисления.ВариантыАвтоперевозки.СиламиКлиента
						ИЛИ СтрокаТаблицы.ПоследняяМиля = Перечисления.ВариантыАвтоперевозки.СиламиКлиента Тогда
						ОбластьЗаголовокАвтоперевозки = Макет.ПолучитьОбласть("ЗаголовокАвтоперевозки");
						ОбластьЗаголовокАвтоперевозки.Параметры.НомерСтроки = СтрокаТаблицы.НомерСтроки;
						ТабличныйДокумент.Вывести(ОбластьЗаголовокАвтоперевозки);
					КонецЕсли;
					//ДИТ Шевченко А.В. TASK 51973 01.06.2022 -Конец
					
					Если СтрокаТаблицы.Автоперевозка = Перечисления.ВариантыАвтоперевозки.СиламиКлиента Тогда
						ПараметрыОтбора = Новый Структура("ИдентификаторСтрокиЗапроса", СтрокаТаблицы.ИдентификаторСтроки);
						ТранспортныеСредстваЗапроса = ТранспортныеСредства.Скопировать(ПараметрыОтбора);
												
						ВывестиСведенияОбАвтоперевозке(ТабличныйДокумент, Макет, ТранспортныеСредстваЗапроса, СтрокаТаблицы.НомерСтроки,"Данные по автоперевозке на первой миле");
					Иначе
						// Данные по автоперевозке берем из релиза клиента.
						Если ЗначениеЗаполнено(СтрокаТаблицы.РелизКлиента) Тогда
							//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -начало
							//РеквизитыРелизаКлиента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТаблицы.РелизКлиента, "ТранспортныеСредства");
							//ТранспортныеСредстваЗапроса = РеквизитыРелизаКлиента.ТранспортныеСредства.Выгрузить();
							ТранспортныеСредстваЗапроса = ЗаполнитьТранспортныеСредстваСиламиЕвросиб(Шапка.Ссылка).Скопировать(Новый Структура("ЭтапПеревозки",Перечисления.ЭтапыПеревозки.ПерваяМиля));
							//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -конец
							ВывестиСведенияОбАвтоперевозке(ТабличныйДокумент, Макет, ТранспортныеСредстваЗапроса, СтрокаТаблицы.НомерСтроки,"Данные по автоперевозке на первой миле");
						КонецЕсли;
					КонецЕсли;
					//ДИТ Шевченко А.В. TASK 51973 01.06.2022 -Начало
					Если СтрокаТаблицы.ПоследняяМиля = Перечисления.ВариантыАвтоперевозки.СиламиКлиента Тогда
						ПараметрыОтбора = Новый Структура("ИдентификаторСтрокиЗапроса", СтрокаТаблицы.ИдентификаторСтроки);
						ТранспортныеСредстваЗапроса = ТранспортныеСредстваПоследняяМиля.Скопировать(ПараметрыОтбора);
												
						ВывестиСведенияОбАвтоперевозке(ТабличныйДокумент, Макет, ТранспортныеСредстваЗапроса, СтрокаТаблицы.НомерСтроки,"Данные по автоперевозке на последней миле");
					Иначе
						// Данные по автоперевозке берем из релиза клиента.
						Если ЗначениеЗаполнено(СтрокаТаблицы.РелизКлиента) Тогда
							//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -начало
							//РеквизитыРелизаКлиента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТаблицы.РелизКлиента, "ТранспортныеСредстваПоследняяМиля");
							//ТранспортныеСредстваЗапроса = РеквизитыРелизаКлиента.ТранспортныеСредстваПоследняяМиля.Выгрузить();	
							ТранспортныеСредстваЗапроса = ЗаполнитьТранспортныеСредстваСиламиЕвросиб(Шапка.Ссылка).Скопировать(Новый Структура("ЭтапПеревозки",Перечисления.ЭтапыПеревозки.ПоследняяМиля));
							//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -конец
							ВывестиСведенияОбАвтоперевозке(ТабличныйДокумент, Макет, ТранспортныеСредстваЗапроса, СтрокаТаблицы.НомерСтроки,"Данные по автоперевозке на последней миле");
						КонецЕсли;
					КонецЕсли;
					//ДИТ Шевченко А.В. TASK 51973 01.06.2022 -Конец
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
			
        // В табличном документе необходимо задать имя области, в которую был 
        // выведен объект. Нужно для возможности печати комплектов документов.
        УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Шапка.Ссылка);
		
    КонецЦикла;
	
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Процедура ВывестиСведенияОбАвтоперевозке(ТабличныйДокумент, Макет, ТранспортныеСредства, НомерСтроки,ТекстМиля)	
	
	//ДИТ Шевченко А.В. 59945 06.10.2022 -Начало
	КоличествоВодителей = ТранспортныеСредства.Количество();
	
	ЕстьСведенияОВодителях = КоличествоВодителей > 0;
	ЕстьКонтейнер = Ложь;
	Если ЕстьСведенияОВодителях Тогда
		Если ТипЗнч(ТранспортныеСредства[0].Ссылка) = Тип("ДокументСсылка.Заявка") Тогда
			ЕстьКонтейнер          = ТранспортныеСредства.Колонки.Найти("Контейнер") <> Неопределено;
		КонецЕсли;
	КонецЕсли;
	 
	Если ЕстьСведенияОВодителях = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ОбластьЗаголовокЗаголовокШапкиАвтоперевозки = Макет.ПолучитьОбласть("ЗаголовокШапкиАвтоперевозки");
	ОбластьЗаголовокЗаголовокШапкиАвтоперевозки.Параметры.ТекстМиля = ТекстМиля;
	ТабличныйДокумент.Вывести(ОбластьЗаголовокЗаголовокШапкиАвтоперевозки);
	
	ОбластьШапкаВодителейНомерСтроки = Макет.ПолучитьОбласть("ШапкаАвтоперевозки|ВодительНомерСтроки");
	ОбластьШапкаВодителейКонтейнер   = Макет.ПолучитьОбласть("ШапкаАвтоперевозки|ВодительКонтейнер");
	ОбластьШапкаВодителей 			 = Макет.ПолучитьОбласть("ШапкаАвтоперевозки|Водитель");
		
	ОбластьСтрокаВодителейНомерСтроки = Макет.ПолучитьОбласть("СтрокаАвтоперевозки|ВодительНомерСтроки");
	ОбластьСтрокаВодителейКонтейнер   = Макет.ПолучитьОбласть("СтрокаАвтоперевозки|ВодительКонтейнер");
	ОбластьСтрокаВодителей            = Макет.ПолучитьОбласть("СтрокаАвтоперевозки|Водитель");
	
	Если ЕстьСведенияОВодителях Тогда
		ТабличныйДокумент.Вывести(ОбластьШапкаВодителейНомерСтроки);
		Если ЕстьКонтейнер Тогда
			ТабличныйДокумент.Присоединить(ОбластьШапкаВодителейКонтейнер);
		КонецЕсли;	
		ТабличныйДокумент.Присоединить(ОбластьШапкаВодителей);
	КонецЕсли;
	 
	МаксимальныйИндекс = КоличествоВодителей - 1;
	
	Для Индекс = 0 По МаксимальныйИндекс Цикл
		
		Если ЕстьСведенияОВодителях Тогда
			Если Индекс < КоличествоВодителей Тогда 
				СтрокаВодителя = ТранспортныеСредства[Индекс];
				ОбластьСтрокаВодителей.Параметры.Заполнить(СтрокаВодителя);
				ОбластьСтрокаВодителейКонтейнер.Параметры.Заполнить(СтрокаВодителя);
				ОбластьСтрокаВодителейНомерСтроки.Параметры.НомПП = Индекс + 1;
			Иначе
				// Очистим область
				ОбластьСтрокаВодителейНомерСтроки = Макет.ПолучитьОбласть("СтрокаАвтоперевозкиПустая|ВодительНомерСтроки");
				ОбластьСтрокаВодителейКонтейнер   = Макет.ПолучитьОбласть("СтрокаАвтоперевозкиПустая|ВодительКонтейнер");
				ОбластьСтрокаВодителей 			  = Макет.ПолучитьОбласть("СтрокаАвтоперевозкиПустая|Водитель");
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(ОбластьСтрокаВодителейНомерСтроки);
			Если ЕстьКонтейнер Тогда
				ТабличныйДокумент.Присоединить(ОбластьСтрокаВодителейКонтейнер);
			КонецЕсли;
			ТабличныйДокумент.Присоединить(ОбластьСтрокаВодителей);
		КонецЕсли;
				
	КонецЦикла;	
	//ДИТ Шевченко А.В. 59945 06.10.2022 -Конец
КонецПроцедуры	

Функция ПолучитьТаблицуЗапросовНаКТК(Заявка)

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЗаявкаСписокЗапросНаКТК.НомерСтроки КАК НомерСтроки,
	|	ЗаявкаСписокЗапросНаКТК.КоличествоКТК КАК КоличествоКТК,
	|	ЗаявкаСписокЗапросНаКТК.ТипКТК КАК ТипКТК,
	|	ЗаявкаСписокЗапросНаКТК.ДействиеРелизаНачало КАК ДействиеРелизаДатаНачала,
	|	ЗаявкаСписокЗапросНаКТК.ДействиеРелизаОкончание КАК ДействиеРелизаДатаОкончания,
	|	ЗаявкаСписокЗапросНаКТК.ЛокацияВыдачи КАК ЛокацияВыдачи,
	|	ЗаявкаСписокЗапросНаКТК.ЛокацияСдачи КАК ЛокацияСдачи,
	|	ЗаявкаСписокЗапросНаКТК.СрокИспользованияКТК КАК СрокИспользованияКТК,
	|	ЗаявкаСписокЗапросНаКТК.Автоперевозка КАК Автоперевозка,
	|	ЗаявкаСписокЗапросНаКТК.ПоследняяМиля КАК ПоследняяМиля,
	|	РелизыКлиентовЗапросовНаКТК.РелизКлиента.НомерРелиза КАК НомерРелиза,
	|	ЗаявкаСписокЗапросНаКТК.КомментарийКРелизу КАК КомментарийКРелизу,
	|	РелизыКлиентовЗапросовНаКТК.РелизКлиента.ТерминалВыдачи КАК ТерминалВыдачи,
	|	РелизыКлиентовЗапросовНаКТК.РелизКлиента.СтокВыдачи КАК СтокВыдачи,
	|	РелизыКлиентовЗапросовНаКТК.РелизКлиента КАК РелизКлиента,
	|	ЗаявкаСписокЗапросНаКТК.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	Документ.Заявка.СписокЗапросНаКТК КАК ЗаявкаСписокЗапросНаКТК
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РелизыКлиентовЗапросовНаКТК КАК РелизыКлиентовЗапросовНаКТК
	|		ПО ЗаявкаСписокЗапросНаКТК.Ссылка = РелизыКлиентовЗапросовНаКТК.Заявка
	|			И ЗаявкаСписокЗапросНаКТК.ИдентификаторСтроки = РелизыКлиентовЗапросовНаКТК.ИдентификаторСтрокиЗаявки
	|ГДЕ
	|	ЗаявкаСписокЗапросНаКТК.Ссылка = &Заявка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Заявка", Заявка);
	
	ТаблицаЗапросов = Запрос.Выполнить().Выгрузить();
	
	// Добавим в таблицу запросов сведения по инструкциям по сдаче
	ТаблицаЗапросов.Колонки.Добавить("ИнструкцияПоСдаче");
	ТаблицаЗапросов.Колонки.Добавить("ДействиеРелизаНачало");
	ТаблицаЗапросов.Колонки.Добавить("ДействиеРелизаОкончание");
	
	МассивРелизов = ТаблицаЗапросов.ВыгрузитьКолонку("РелизКлиента");
	ИнструкцииРелизов = ТекстИнструкцииРелизаКлиента(МассивРелизов);
	
	Для Каждого ТекущаяСтрока Из ТаблицаЗапросов Цикл
		ТекущаяСтрока.ИнструкцияПоСдаче = ИнструкцииРелизов.Получить(ТекущаяСтрока.РелизКлиента);
		ТекущаяСтрока.ДействиеРелизаНачало = Формат(ТекущаяСтрока.ДействиеРелизаДатаНачала, "ДЛФ=D");
		ТекущаяСтрока.ДействиеРелизаОкончание = Формат(ТекущаяСтрока.ДействиеРелизаДатаОкончания, "ДЛФ=D");
	КонецЦикла;	
	
	Возврат ТаблицаЗапросов;
	
КонецФункции

Функция ТекстИнструкцииРелизаКлиента(МассивРелизовКлиентов) Экспорт
	
	// Нужно проверить, что по всем непустым строкам в контейнерах релиза клиента одинаковые значения в колонке "Инструкция по сдаче".
	// Если все одинаковые, то возвращаем текст инстркции. Если есть отличия, то возвращаем текст о том, что инструкции различны.	
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РелизКлиентаКонтейнеры.Ссылка КАК РелизКлиента,
	// ДИТ US 62421 TA 64346 Евсенкин М.А. Начало: 02.02.2023
	// Было:
	//РелизКлиентаКонтейнеры.ИнструкцияПоСдаче КАК ИнструкцияПоСдаче
	//Стало:
	|	РелизКлиентаКонтейнеры.КлючАналитикиПеревозки.ИнструкцияПоСдаче КАК ИнструкцияПоСдаче
	// ДИТ US 62421 TA 64346 Евсенкин М.А. Конец: 02.02.2023
	|ПОМЕСТИТЬ втИнструкцииРелизов
	|ИЗ
	|	Документ.РелизКлиента.Контейнеры КАК РелизКлиентаКонтейнеры
	|ГДЕ
	|	РелизКлиентаКонтейнеры.Ссылка В(&РелизыКлиентов)
	// ДИТ US 62421 TA 64346 Евсенкин М.А. Начало: 02.02.2023
	// Было:
	//И РелизКлиентаКонтейнеры.ИнструкцияПоСдаче <> ""
	//Стало:
	|	И РелизКлиентаКонтейнеры.КлючАналитикиПеревозки.ИнструкцияПоСдаче <> """"
	// ДИТ US 62421 TA 64346 Евсенкин М.А. Конец: 02.02.2023
	|;
	|
	////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втИнструкцииРелизов.РелизКлиента КАК РелизКлиента,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ втИнструкцииРелизов.ИнструкцияПоСдаче) КАК КоличествоИнструкций
	|ПОМЕСТИТЬ втКоличествоИнструкций
	|ИЗ
	|	втИнструкцииРелизов КАК втИнструкцииРелизов
	|
	|СГРУППИРОВАТЬ ПО
	|	втИнструкцииРелизов.РелизКлиента
	|;
	|
	////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	втИнструкцииРелизов.РелизКлиента КАК РелизКлиента,
	|	ВЫБОР
	|		КОГДА втКоличествоИнструкций.КоличествоИнструкций = 0
	|			ТОГДА """"
	|		КОГДА втКоличествоИнструкций.КоличествоИнструкций = 1
	|			ТОГДА втИнструкцииРелизов.ИнструкцияПоСдаче
	|		ИНАЧЕ &ТекстИнструкции
	|	КОНЕЦ КАК ИнструкцияПоСдаче
	|ИЗ
	|	втИнструкцииРелизов КАК втИнструкцииРелизов
	|		ЛЕВОЕ СОЕДИНЕНИЕ втКоличествоИнструкций КАК втКоличествоИнструкций
	|		ПО втИнструкцииРелизов.РелизКлиента = втКоличествоИнструкций.РелизКлиента";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("РелизыКлиентов", МассивРелизовКлиентов);
	Запрос.УстановитьПараметр("ТекстИнструкции", "Инструкции различаются. Необходимо запросить уточнение у сотрудника отдела подряда");
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	ИнструкцииРелизов = Новый Соответствие;
	Для Каждого ТекущийРелиз Из МассивРелизовКлиентов Цикл
		Инструкция = "";
		СтрокаИнструкции = Результат.Найти(ТекущийРелиз, "РелизКлиента");
		Если СтрокаИнструкции <> Неопределено Тогда
			Инструкция = СтрокаИнструкции.ИнструкцияПоСдаче;
		КонецЕсли;	
		ИнструкцииРелизов.Вставить(ТекущийРелиз, Инструкция);
	КонецЦикла;	
	
	Возврат ИнструкцииРелизов;
КонецФункции	
