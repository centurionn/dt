// Евросиб Фролов (2.03.2022 Task №44768
Процедура ОбновитьВнутреннийСтатусЗапроса(Документ, Проведен, ТекущееСостояние, ТекущийСтатус) Экспорт
	
	Если Проведен = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущееСостояние = Справочники.Состояния.ВводЗапросаНаКТК
		И ТекущийСтатус = Перечисления.СтатусыЭтапов.Выполнен Тогда
		Документ.ВнутреннийСтатусЗапроса = Перечисления.ВнутренниеСтатусыЗапросовНаКТК.НеВзятВРаботу;
	ИначеЕсли ТекущееСостояние = Справочники.Состояния.БронированиеКТК
		И ТекущийСтатус = Перечисления.СтатусыЭтапов.Выполнен Тогда
		Документ.ВнутреннийСтатусЗапроса = Перечисления.ВнутренниеСтатусыЗапросовНаКТК.ВзятВРаботу;
	ИначеЕсли ТекущееСостояние = Справочники.Состояния.БронированиеКТК
		И ТекущийСтатус = Перечисления.СтатусыЭтапов.Отклонен Тогда
		Документ.ВнутреннийСтатусЗапроса = Перечисления.ВнутренниеСтатусыЗапросовНаКТК.Отработан;
		ВернутьМаршрутКВводуЗапроса(Документ);
	ИначеЕсли ТекущееСостояние = Справочники.Состояния.РелизНаВыдачуКТККлиенту
		И (ТекущийСтатус = Перечисления.СтатусыЭтапов.Отклонен ИЛИ ТекущийСтатус = Перечисления.СтатусыЭтапов.Выполнен) Тогда
		Документ.ВнутреннийСтатусЗапроса = Перечисления.ВнутренниеСтатусыЗапросовНаКТК.Отработан;
		Если ТекущийСтатус = Перечисления.СтатусыЭтапов.Отклонен Тогда
			ВернутьМаршрутКВводуЗапроса(Документ);
		КонецЕсли;	
	КонецЕсли;
				
КонецПроцедуры

Процедура ВернутьМаршрутКВводуЗапроса(Документ)	
	СостояниеВводЗапросаНаКТК = Справочники.Состояния.ВводЗапросаНаКТК;
	
	СтрокиСостояния = Документ.Состояния.НайтиСтроки(Новый Структура("Состояние", СостояниеВводЗапросаНаКТК));
	
	Если СтрокиСостояния.Количество() > 0 Тогда
		НайденнаяСтрока = СтрокиСостояния[0];
		НайденнаяСтрока.Статус = Перечисления.СтатусыЭтапов.ВРаботе;
	КонецЕсли;
КонецПроцедуры
