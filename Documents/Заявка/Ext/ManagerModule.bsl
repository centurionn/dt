Функция ЕстьРелизКлиента(Контейнер, Заявка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДокументРелизКлиента.Ссылка КАК РелизКлиента
	|ИЗ
	|	Документ.РелизКлиента КАК ДокументРелизКлиента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РелизКлиента.Контейнеры КАК РелизКлиентаКонтейнеры
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки КАК КлючиАналитикиПеревозки
	|			ПО (РелизКлиентаКонтейнеры.КлючАналитикиПеревозки = КлючиАналитикиПеревозки.Ссылка)
	|		ПО (ДокументРелизКлиента.Ссылка = РелизКлиентаКонтейнеры.Ссылка)
	|ГДЕ
	|	ДокументРелизКлиента.Заявка = &Заявка
	|	И ДокументРелизКлиента.Проведен
	|	И ВЫБОР КОГДА КлючиАналитикиПеревозки.Контейнер = &Контейнер
	|		ТОГДА 
	|			ИСТИНА
	|		ИНАЧЕ 
	|			ЛОЖЬ
	|	КОНЕЦ";
	
	Запрос.УстановитьПараметр("Заявка", Заявка);
	Запрос.УстановитьПараметр("Контейнер", Контейнер);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();
	
