	ТребуетсяМаршрутизацияДляОбъекта = 	// ДИТ US 76975 TA 76977 Сержантова А.С. Начало: 15.11.2023 
										//перемаршрутизируем, если ранее примененный маршрут был удален
										//(ЗначениеЗаполнено(Объект.Ссылка.ПСЦ) И НЕ ЗначениеЗаполнено(Объект.ПСЦ)) 
										//ИЛИ (НЕ ЗначениеЗаполнено(Объект.Ссылка.ПСЦ) И ЗначениеЗаполнено(Объект.ПСЦ)) 
										(ЗначениеЗаполнено(Объект.ПримененныйМаршрут) и ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ПримененныйМаршрут, "ПометкаУдаления"))
										// ДИТ US 76975 TA 76977 Сержантова А.С. Конец: 15.11.2023
										ИЛИ Документы.Заявка.ИзменилсяСоставЗапроса(Объект) // Евросиб Фролов (06.12.2021 TASK№ №42618, РелизКлиента
										ИЛИ Документы.Заявка.ИзменилисьВодителиИПеревозчики(Объект,Перечисления.ЭтапыПеревозки.ПерваяМиля); //ДИТ Шевченко А.В. 53562 18.10.2022 
	Возврат ТребуетсяМаршрутизацияДляОбъекта;                                                        
