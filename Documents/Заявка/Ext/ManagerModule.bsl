Функция ИзменитьЗаявкуПоРефСцепу(ЗаявкаОБъект, РефСцепИсходный) Экспорт   
	
	НеобходимаЗаписьОбъекта = Ложь;
	
	Если ЗаявкаОБъект.ДокументОснование <> РефСцепИсходный Тогда
		ЗаявкаОБъект.ДокументОснование = РефСцепИсходный;
		СинхронизироватьДанныеСРефСцепом(ЗаявкаОБъект);		
		НеобходимаЗаписьОбъекта = Истина;
	КонецЕсли;	
	
	ДобавитьКонтейнерыПодбора(ЗаявкаОБъект, РефСцепИсходный, НеобходимаЗаписьОбъекта);	

	Возврат НеобходимаЗаписьОбъекта;
	
КонецФункции
Процедура СинхронизироватьДанныеСРефСцепом(ЗаявкаОБъект)    
	
	ДанныеИзРефСцепа = РефСцепСервер.ПолучитьДанныеЗаполненияЗаявкиНаОснованииРефСцепаПоКлючам
		(ЗаявкаОБъект.ДокументОснование, ЗаявкаОБъект.СоставУслуги.Выгрузить().ВыгрузитьКолонку("КлючАналитикиПеревозки"));
		
	ДанныеПоКонтейнерам 	 = ДанныеИзРефСцепа.ДанныеПоКонтейнерам;
	Шапка               	 = ДанныеИзРефСцепа.Шапка;
	ДанныеКлиента			 = ДанныеИзРефСцепа.ДанныеКлиента;
	
	ЕстьИзменения = Ложь;

	Пока Шапка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Шапка.ПланируемоеОтправление) Тогда
			Продолжить;
		КонецЕсли;	
		Для каждого СтрУслуг из ЗаявкаОБъект.СоставУслуги Цикл
			ЗаполнитьЗначенияСвойств(СтрУслуг, Шапка);
		КонецЦикла;	
		Если Шапка.ПланируемоеОтправление <> ЗаявкаОБъект.Отправка Тогда
			ЗаявкаОБъект.Отправка = Шапка.ПланируемоеОтправление;
			ЕстьИзменения   = истина;
		КонецЕсли;	
		Если Шапка.ПланируемоеПрибытие <> ЗаявкаОБъект.Прибытие Тогда
			ЗаявкаОБъект.Прибытие = Шапка.ПланируемоеПрибытие;
			ЕстьИзменения   = истина;
		КонецЕсли;	
		Если ЗаявкаОБъект.ПереченьРейсов.Количество()>0 ТОгда
			Если ЗаявкаОБъект.ПереченьРейсов[0].Рейс <> Шапка.Рейс Тогда
				ЗаявкаОБъект.ПереченьРейсов[0].Рейс 	 =  Шапка.Рейс;
				ЗаявкаОБъект.ПереченьРейсов[0].Продукт =  Шапка.Продукт;
				ЕстьИзменения = истина;
				Если не ЗначениеЗаполнено(ЗаявкаОБъект.ПереченьРейсов[0].Рейс) Тогда
					ЗаявкаОБъект.ПереченьРейсов.Очистить();
				КонецЕсли;	
			КонецЕсли;
		Иначе
			Если ЗначениеЗаполнено(Шапка.Рейс) Тогда
				НоваяСтрока = ЗаявкаОБъект.ПереченьРейсов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Шапка,"Рейс, Продукт");
				ЕстьИзменения = истина;
			КонецЕсли;	
		КонецЕсли;

		тзСоставУслуги = ЗаявкаОБъект.СоставУслуги.Выгрузить();
		Пока ДанныеПоКонтейнерам.Следующий() Цикл
			мСоставаУслуг = ЗаявкаОБъект.СоставУслуги.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки", ДанныеПоКонтейнерам.КлючАналитикиПеревозки));
			Для каждого СтрокаУслуги Из мСоставаУслуг Цикл
				ЗаполнитьЗначенияСвойств(СтрокаУслуги, ДанныеПоКонтейнерам);
				СтрокаУслуги.НомерКТК = ДанныеПоКонтейнерам.Контейнер;
				//ЗаполнитьСвязанныеПоляПринадлежностьТЕ(СтрокаУслуги);
			КонецЦикла;	
		КонецЦикла;
	КонецЦикла; 
			
КонецПроцедуры	
// Сначала заполняются заявки в строках ТЧ Контейнеры реф.сцепа при подборе. Потом все заявки становятся в очередь на отложенное
// изменение. Затем реф сцеп ставится на изменение по заявке и поля "заявки подбора" очищаются.
Процедура ДобавитьКонтейнерыПодбора(ЗаявкаОБъект, РефСцепИсходный, НеобходимаЗаписьОбъекта)

	ДанныеИзРефСцепа = РефСцепСервер.ПолучитьДанныеЗаполненияКонтейнеровЗаявкиПодбора
		(РефСцепИсходный, ЗаявкаОБъект.Ссылка);
		
	Пока ДанныеИзРефСцепа.Следующий() Цикл
		//НеобходимаЗаписьОбъекта = Истина;
		СтрокиПодобранныхКонтейнеровВЗаявке = ЗаявкаОБъект.СоставУслуги.НайтиСтроки(
			Новый Структура("НомерКТК", ДанныеИзРефСцепа.Контейнер));
		Если СтрокиПодобранныхКонтейнеровВЗаявке.Количество()>0 Тогда	
			Для каждого стр из СтрокиПодобранныхКонтейнеровВЗаявке Цикл
				Если стр.КлючАналитикиПеревозки <> ДанныеИзРефСцепа.КлючАналитикиПеревозки Тогда 
					НеобходимаЗаписьОбъекта = Истина;
					
					ЗаполнитьЗначенияСвойств(Стр, ДанныеИзРефСцепа);	
				
                КонецЕсли;
			КонецЦикла;
		Иначе	
			
			НеобходимаЗаписьОбъекта = Истина;
			
			НоваяСтрока = ЗаявкаОБъект.СоставУслуги.Добавить(); 

			ЗаполнитьЗначенияСвойств(НоваяСтрока, ЗаявкаОБъект.СоставУслуги[0], "ПСЦ");
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеИзРефСцепа);
			
			Если НЕ ЗначениеЗаполнено(НоваяСтрока.ПСЦ) Тогда 
				НоваяСтрока.ПСЦ = ЗаявкаОБъект.ПСЦ; 
			КонецЕсли;
			
		КонецЕсли;	
	КонецЦикла;
	
	Если НеобходимаЗаписьОбъекта Тогда
		ОтложенноеИзменениеСервер.ПоставитьРефСцепВОчередьИзменения(РефСцепИсходный, ЗаявкаОБъект.Ссылка);
	КонецЕсли;	
			
КонецПроцедуры

Функция МассивУдаляемыхКТКИзЗаявкиПоРефСцепу(ЗаявкаОБъект, РефСцепИсходный) Экспорт
	// 
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РефСцепВагоныРефСцепа.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	РефСцепВагоныРефСцепа.Контейнер КАК Контейнер,
		|	РефСцепВагоныРефСцепа.ПеренесенВРефСцеп КАК ПеренесенВРефСцеп
		|ПОМЕСТИТЬ вт_ИсходныйРефСцеп
		|ИЗ
		|	Документ.РефСцеп.ВагоныРефСцепа КАК РефСцепВагоныРефСцепа
		|ГДЕ
		|	РефСцепВагоныРефСцепа.Ссылка = &РефСцепИсходный
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РефСцепКонтейнеры.КлючАналитикиПеревозки,
		|	РефСцепКонтейнеры.Контейнер,
		|	РефСцепКонтейнеры.ПеренесенВРефСцеп
		|ИЗ
		|	Документ.РефСцеп.Контейнеры КАК РефСцепКонтейнеры
		|ГДЕ
