Процедура ПоискЧерезАРМКТКТекущиеДанные(Результат, Контейнер, Локация, КонецПользования, ДатаСдачи, Заявка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	стоки_ТекущиеДанные.тек_Релиз КАК РелизСобственника,
	|	стоки_ТекущиеДанные.тек_ДатаПриемаВПользование КАК ДатаПриемаВПользование,
	|	стоки_ТекущиеДанные.тек_СрокВозврата КАК СрокВозврата,
	|	стоки_ТекущиеДанные.тек_ДатаСдачиВСток КАК ДатаВозвратаСобственнику,
	|	ДОБАВИТЬКДАТЕ(стоки_ТекущиеДанные.тек_ДатаПриемаВПользование, ДЕНЬ, стоки_ТекущиеДанные.тек_СрокВозврата) КАК РасчетнаяДатаСдачи,
	|	ВЫБОР
	|		КОГДА &ДатаСдачи МЕЖДУ стоки_ТекущиеДанные.тек_ДатаПриемаВПользование И ДОБАВИТЬКДАТЕ(стоки_ТекущиеДанные.тек_ДатаПриемаВПользование, ДЕНЬ, стоки_ТекущиеДанные.тек_СрокВозврата)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ДатаСдачиВходитВПериод,
	|	ДокументРелизСобственника.ДоплатныеКТК КАК Доплатный,
	|	РелизСобственникаНоминации.КлючАналитики КАК КлючАналитики,
	|	РелизСобственникаНоминации.ГУИДСтроки КАК ГУИДСтроки,
	|	ВЫБОР
	|		КОГДА стоки_ТекущиеДанные.тек_ДатаПриемаВПользование > &ДатаСдачи
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК СвежийРелиз,
	|	ЗаявкаСоставУслуги.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки
	|ИЗ
	|	РегистрСведений.стоки_ТекущиеДанные КАК стоки_ТекущиеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РелизСобственника КАК ДокументРелизСобственника
	|		ПО (стоки_ТекущиеДанные.тек_Релиз = ДокументРелизСобственника.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	|		ПО (ДокументРелизСобственника.Ссылка = РелизСобственникаНоминации.Ссылка)
	|		И РелизСобственникаНоминации.Контейнер = стоки_ТекущиеДанные.КТК
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Мультилокации.Локации КАК МультилокацииЛокации
	|		ПО (ДокументРелизСобственника.ВозможныеСтокиСдачи = МультилокацииЛокации.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
	|		ПО ЗаявкаСоставУслуги.Ссылка = &Заявка
	|			И ЗаявкаСоставУслуги.НомерКТК = &Контейнер
	|
	|ГДЕ
	|	стоки_ТекущиеДанные.тек_Релиз.Проведен
	|	И стоки_ТекущиеДанные.тек_ДатаПриемаВПользование <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|	И стоки_ТекущиеДанные.тек_ДатаСдачиВСток = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|	И стоки_ТекущиеДанные.КТК = &Контейнер
	|	И ВЫБОР
	|		КОГДА МультилокацииЛокации.Локация = &Локация
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	СвежийРелиз УБЫВ";
	
	Запрос.УстановитьПараметр("Контейнер", Контейнер);
	Запрос.УстановитьПараметр("Локация", Локация);
	Запрос.УстановитьПараметр("ДатаСдачи", ДатаСдачи);
	Запрос.УстановитьПараметр("Заявка", Заявка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Результат.Локация = Локация;
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();

	Пока Выборка.Следующий() Цикл
		
		Если Выборка.СвежийРелиз Тогда
			Результат.Локация = Локация;
			Возврат;
		КонецЕсли;
		
		Если Выборка.ДатаСдачиВходитВПериод Тогда
			Данные = Новый Структура;
			Данные.Вставить("Локация", Локация);
			Данные.Вставить("РелизСобственника", Выборка.РелизСобственника);
			Данные.Вставить("КлючАналитикиСтрокиРелиза", Выборка.КлючАналитики);
			Данные.Вставить("ДатаСдачи", ДатаСдачи);
			Данные.Вставить("ГУИДСтроки", Выборка.ГУИДСтроки);
			Данные.Вставить("КлючАналитикиПеревозки", Выборка.КлючАналитикиПеревозки);
			Результат.ДанныеДобавленияВРелизСобственника.Добавить(Данные);
			Результат.Локация = Локация;
		ИначеЕсли ДатаСдачи > Выборка.РасчетнаяДатаСдачи
			И Выборка.ДатаПриемаВПользование > ДатаСдачи Тогда 
			Данные = Новый Структура;
			Данные.Вставить("Локация", Локация);
			Данные.Вставить("РелизСобственника", Выборка.РелизСобственника);
			Данные.Вставить("КлючАналитикиСтрокиРелиза", Выборка.КлючАналитики);
			Данные.Вставить("ДатаСдачи", ДатаСдачи);
			Данные.Вставить("ГУИДСтроки", Выборка.ГУИДСтроки);
			Данные.Вставить("КлючАналитикиПеревозки", Выборка.КлючАналитикиПеревозки);
			Результат.ДанныеДобавленияВРелизСобственника.Добавить(Данные);
			Результат.Локация = Локация;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьДанныеВКлючАналитикиСтрокиРелизаСобственника(ДанныеДобавленияВРелизСобственника) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Для Каждого Данные Из ДанныеДобавленияВРелизСобственника Цикл
		Если Не ЗначениеЗаполнено(Данные.КлючАналитикиСтрокиРелиза) Тогда
			НовыйКлюч = Справочники.КлючиАналитикиНоминацийРелиза.СоздатьЭлемент();
			НовыйКлюч.Наименование = Новый УникальныйИдентификатор;
			НовыйКлюч.ДатаВозвратаКлиентом = Данные.ДатаСдачи;
			НовыйКлюч.СтокВыдачи = Данные.Локация;
			НовыйКлюч.КлючАналитикиПеревозки = Данные.КлючАналитикиПеревозки;
			НовыйКлюч.Записать();
			
			РелизСобственникаСсылка = Данные.РелизСобственника;
			РелизСобственникаОбъект = РелизСобственникаСсылка.ПолучитьОбъект();
			Номинации = РелизСобственникаОбъект.Номинации;
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("ГУИДСтроки", Данные.ГУИДСтроки);
			НайденныеСтроки = Номинации.НайтиСтроки(ПараметрыОтбора);
			Для Каждого Строка Из НайденныеСтроки Цикл
				Строка.КлючАналитики = НовыйКлюч.Ссылка;
			КонецЦикла;
			РелизСобственникаОбъект.Записать();
		Иначе
			КлючСсылка = Данные.КлючАналитикиСтрокиРелиза;
			КлючОбъект = КлючСсылка.ПолучитьОбъект();
			КлючОбъект.ДатаВозвратаКлиентом = Данные.ДатаСдачи;
			КлючОбъект.СтокВыдачи = Данные.Локация;
			КлючОбъект.КлючАналитикиПеревозки = Данные.КлючАналитикиПеревозки;
			КлючОбъект.Записать();
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры
