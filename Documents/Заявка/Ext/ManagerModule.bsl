Функция ПолучитьКткДляРаспределенияВЗапросНаКТК (ТЧУслуги, СписокКТК = Неопределено, СписокИсключенийКТК = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Заявка_услуг.ТипКТК КАК ТипКТК,
		|	Заявка_услуг.ПерваяМиля КАК ПерваяМиля,
		|	Заявка_услуг.ПоследняяМиля КАК ПоследняяМиля,
		|	Заявка_услуг.НомерКТК КАК НомерКТК,
		|	Заявка_услуг.ПринадлежностьТЕ КАК ПринадлежностьТЕ,
		|	Заявка_услуг.Релиз КАК Релиз,
		|	Заявка_услуг.ПеренесенВЗаявку КАК ПеренесенВЗаявку
		|ПОМЕСТИТЬ ВТ_ЗаявкаТЧ_услуги
		|ИЗ
		|	&Заявка_услуги КАК Заявка_услуг
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ЗаявкаТЧ_услуги.ТипКТК КАК ТипКТК,
		|	ВТ_ЗаявкаТЧ_услуги.ПерваяМиля КАК ПерваяМиля,
		|	ВТ_ЗаявкаТЧ_услуги.ПоследняяМиля КАК ПоследняяМиля,
		|	ВТ_ЗаявкаТЧ_услуги.НомерКТК КАК НомерКТК
		|ИЗ
		|	ВТ_ЗаявкаТЧ_услуги КАК ВТ_ЗаявкаТЧ_услуги
		|ГДЕ
		|	ВТ_ЗаявкаТЧ_услуги.ПринадлежностьТЕ = &ПринадлежностьТЕ
		|	И (ВТ_ЗаявкаТЧ_услуги.Релиз = НЕОПРЕДЕЛЕНО ИЛИ ВТ_ЗаявкаТЧ_услуги.Релиз = ЗНАЧЕНИЕ(Документ.РелизКлиента.ПустаяСсылка))
		|	И ВТ_ЗаявкаТЧ_услуги.НомерКТК <> ЗНАЧЕНИЕ(Справочник.Те.ПустаяСсылка)
		|	И ВТ_ЗаявкаТЧ_услуги.ПеренесенВЗаявку = ЗНАЧЕНИЕ(Документ.Заявка.ПустаяСсылка)
		|ИТОГИ ПО
		|	ТипКТК,
		|	ПерваяМиля,
		|	ПоследняяМиля,
		|	НомерКТК";
	
	Запрос.УстановитьПараметр("Заявка_услуги", ТЧУслуги);
	Запрос.УстановитьПараметр("ПринадлежностьТЕ", Перечисления.ПринадлежностьТЕ.КТЕвросиба);
	
	Если СписокКТК <> Неопределено тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И (ВТ_ЗаявкаТЧ_услуги.Релиз = НЕОПРЕДЕЛЕНО ИЛИ ВТ_ЗаявкаТЧ_услуги.Релиз = ЗНАЧЕНИЕ(Документ.РелизКлиента.ПустаяСсылка))",
		"И (ВТ_ЗаявкаТЧ_услуги.Релиз = НЕОПРЕДЕЛЕНО ИЛИ ВТ_ЗаявкаТЧ_услуги.Релиз = ЗНАЧЕНИЕ(Документ.РелизКлиента.ПустаяСсылка)) И ВТ_ЗаявкаТЧ_услуги.НомерКТК В (&СписокКТК)");
		Запрос.УстановитьПараметр("СписокКТК", СписокКТК);	
	КонецЕсли;
	
	Возврат Запрос.Выполнить();
