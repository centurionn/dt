Функция ПолучитьКонтакты(Ссылка) экспорт
	
	Результат = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗапросЪ.КонтактноеЛицо КАК ПользовательЗаявитель,
	               |	ЗапросЪ.ОтветственныйМенеджер КАК ОтветственныйМенеджер,
	               |	ЗапросЪ.Контрагент КАК КонтрагентЗаявитель
	               |ИЗ
	               |	Документ.Запрос КАК ЗапросЪ
	               |ГДЕ
	               |	ЗапросЪ.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат.Добавить(Ответ.ПользовательЗаявитель);
		Результат.Добавить(Ответ.ОтветственныйМенеджер);
		Результат.Добавить(Ответ.КонтрагентЗаявитель);
	КонецЕсли;

	Возврат результат;
	
КонецФункции

Функция ЗагрузитьEXCELЗаявка(ЭлементСправочникаФайлы) Экспорт
	
	Результат = Новый Структура("Успешно, ДокументСсылка", Истина, Новый Массив);
	
	ОписаниеФайла = РаботаСФайлами.ДанныеФайла(ЭлементСправочникаФайлы);
	ДДФайла = РаботаСФайлами.ДвоичныеДанныеФайла(ЭлементСправочникаФайлы);
	
	ИВФ = ПолучитьИмяВременногоФайла(ОписаниеФайла.Расширение);
	ДДФайла.Записать(ИВФ);
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Прочитать(ИВФ, СпособЧтенияЗначенийТабличногоДокумента.Текст);
	
	ИменаЛистов = Новый Массив;	
	Для каждого Стр из ТабДок.Области Цикл
		
		ИменаЛистов.Добавить(Стр.Имя);
		
	КонецЦикла;
	
	НачатьТранзакцию();
	
	Для каждого ЛистИмя из ИменаЛистов Цикл
		
		Лист = ТабДок.ПолучитьОбласть(ЛистИмя);
		
		КодФормы = Лист.Область("R2C2").Текст;
		
		Если КодФормы <> "FDC-002" Тогда Продолжить; КонецЕсли;
		
		Попытка
			
			ШапкаКонтрагент = Лист.Область("R5C3").Текст;
			ШапкаКонтрагентИНН = Лист.Область("R6C2").Текст;
			ШапкаКонтрагентКПП = Лист.Область("R6C4").Текст;
			ШапкаДоговорНомер = Лист.Область("R7C3").Текст;
			ШапкаДоговорДата = Лист.Область("R7C6").Текст;
			ШапкаПСЦНомер = Лист.Область("R8C3").Текст;
			ШапкаПСЦДата = Лист.Область("R8C6").Текст;
			
			ШапкаФИОМенеджера = Лист.Область("R5C11").Текст;
			ШапкаТелефон = Лист.Область("R6C11").Текст;
			ШапкаРезТелефон = Лист.Область("R7C11").Текст;
			ШапкаПочта = Лист.Область("R8C11").Текст;
			
			ШапкаОтправление = Лист.Область("R10C3").Текст;
			ШапкаПрибытие = Лист.Область("R10C6").Текст;
			
			ШапкаВнешнийНомер = Лист.Область("R9C3").Текст;;
			ШапкаВнешняяДата = Лист.Область("R9C6").Текст;;
			
			ШапкаКомментарий = Лист.Область("R73C3").Текст;
			
			СоставУслуг = Новый Массив;
			Для Сч = 14 По 71 Цикл
				НомерКТК = Лист.Область("R"+Сч+"C1").Текст;
				ТипКТК = Лист.Область("R"+Сч+"C2").Текст;
				
				Пломбы = Лист.Область("R"+Сч+"C3").Текст;
				ФИОВодителя = Лист.Область("R"+Сч+"C4").Текст;
				НомерАвто = Лист.Область("R"+Сч+"C5").Текст;
				ПунктОтправления = Лист.Область("R"+Сч+"C6").Текст;
				СтанцияОтправления = Лист.Область("R"+Сч+"C7").Текст;
				СтанцияНазначения = Лист.Область("R"+Сч+"C8").Текст;
				ПунктНазначения = Лист.Область("R"+Сч+"C9").Текст;
				
				Грузополучатель = Лист.Область("R"+Сч+"C10").Текст;
				НаименованиеГруза = Лист.Область("R"+Сч+"C11").Текст;
				КодГруза = Лист.Область("R"+Сч+"C12").Текст;
				ВесНетто = Лист.Область("R"+Сч+"C13").Текст;
				КолвоМест = Лист.Область("R"+Сч+"C14").Текст;
				Терминалка = Лист.Область("R"+Сч+"C15").Текст;
				ОсОтметки = Лист.Область("R"+Сч+"C16").Текст;
				ИнструкцияПоСдаче = Лист.Область("R"+Сч+"C17").Текст;
				
				Если ЗначениеЗаполнено(НомерКТК) ИЛИ ЗначениеЗаполнено(ТипКТК) Тогда
					
					СоставУслуг.Добавить(Новый Структура(
					"НомерКТК,ТипКТК,Пломбы,ФИОВодителя,НомерАвто,ПунктОтправления,СтанцияОтправления,СтанцияНазначения,ПунктНазначения,Грузополучатель,НаименованиеГруза,КодГруза,ВесНетто,КолвоМест,Терминалка,ОсОтметки,ИнструкцияПоСдаче",
					НомерКТК,ТипКТК,Пломбы,ФИОВодителя,НомерАвто,ПунктОтправления,СтанцияОтправления,СтанцияНазначения,ПунктНазначения,Грузополучатель,НаименованиеГруза,КодГруза,ВесНетто,КолвоМест,Терминалка,ОсОтметки,ИнструкцияПоСдаче
					));				
					
				КонецЕсли
				
			КонецЦикла;
			
		Исключение
			Результат.Успешно = Ложь;
			Прервать;
		КонецПопытки;
		
		////////////////////////////
		
		Контрагент = ОбработкаВходящейКорреспонденции.ЗагрузкаДанных_ПолучитьКонтрагента(ШапкаКонтрагентИНН, ШапкаКонтрагентКПП, "", ШапкаКонтрагент);
		Договор = ОбработкаВходящейКорреспонденции.ЗагрузкаДанных_ПолучитьДоговор(ШапкаДоговорНомер, ОбработкаВходящейКорреспонденции.ЗагрузкаДанных_ОбработатьДату(ШапкаДоговорДата));
		ПСЦ = ОбработкаВходящейКорреспонденции.ЗагрузкаДанных_ПолучитьПСЦ(ШапкаПСЦНомер, ОбработкаВходящейКорреспонденции.ЗагрузкаДанных_ОбработатьДату(ШапкаПСЦДата), Договор);
		КонтакноеЛицо = ОбработкаВходящейКорреспонденции.ЗагрузкаДанных_ПолучитьКонтакноеЛицо(ШапкаФИОМенеджера);
		Отправка = ОбработкаВходящейКорреспонденции.ЗагрузкаДанных_ОбработатьДату(ШапкаОтправление);
		Прибытие = ОбработкаВходящейКорреспонденции.ЗагрузкаДанных_ОбработатьДату(ШапкаПрибытие);
		Комментарий = ШапкаКомментарий;
		ВнешняяДата = ОбработкаВходящейКорреспонденции.ЗагрузкаДанных_ОбработатьДату(ШапкаВнешняяДата);
		
		Если ЗначениеЗаполнено(Контрагент) Тогда
			
			НДок = Документы.Заявка.СоздатьДокумент();
			Ндок.Заполнить(неопределено);
			НДок.Дата = ТекущаяДата();
			НДок.Комментарий = Комментарий;
			Ндок.Контрагент = Контрагент;
			Ндок.Договор = Договор;
			НДок.ПСЦ = ПСЦ;
			Ндок.КонтактноеЛицо = КонтакноеЛицо;
			Ндок.Отправка = Отправка;
			Ндок.Прибытие = Прибытие;
			Ндок.ВнешнийНомер = ШапкаВнешнийНомер;
			Ндок.ВнешняяДата = ВнешняяДата;
			
			Для каждого Стр из СоставУслуг Цикл
				НСтр = НДок.СоставУслуги.Добавить();
				НСтр.ТипКТК = ОбработкаВходящейКорреспонденции.ЗагрузкаДанных_ТипТЕ(Стр.ТипКТК);
				НСтр.НомерКТК = ОбработкаВходящейКорреспонденции.ЗагрузкаДанных_ПолучитьКТК(Стр.НомерКТК, НСтр.ТипКТК);
				НСтр.Пломбы = Стр.Пломбы;
				НСтр.ФИОВодителя = Стр.ФИОВодителя;
				НСтр.НомерАвто = Стр.НомерАвто;
				НСтр.ПунктОтправления = ОбработкаВходящейКорреспонденции.ЗагрузкаДанных_НайтиЛокацию_Слитно(Стр.ПунктОтправления);
				НСтр.СтанцияОтправления = ОбработкаВходящейКорреспонденции.ЗагрузкаДанных_НайтиЛокацию_Слитно(Стр.СтанцияОтправления);
				НСтр.СтанцияНазначения = ОбработкаВходящейКорреспонденции.ЗагрузкаДанных_НайтиЛокацию_Слитно(Стр.СтанцияНазначения);
				НСтр.ПунктНазначения = ОбработкаВходящейКорреспонденции.ЗагрузкаДанных_НайтиЛокацию_Слитно(Стр.ПунктНазначения);
				НСтр.Груз = ОбработкаВходящейКорреспонденции.ЗагрузкаДанных_НайтиГруз(""+Стр.КодГруза+"; "+Стр.НаименованиеГруза);
				
				НСТр.Грузополучатель =  ОбработкаВходящейКорреспонденции.ЗагрузкаДанных_НайтиГрузоотправителяПолучателя(Стр.Грузополучатель);
				
				НСтр.КодГруза = Стр.КодГруза;
				Попытка
					НСтр.ВесГрузаНетто = Число(СтрЗаменить(Стр.ВесНетто, ".", ","));
				Исключение
				КонецПопытки;
				Попытка
					НСтр.КоличествоМест = Число(Стр.КолвоМест);
				Исключение
				КонецПопытки;
				НСтр.ТерминальныеУслугиПоПрибытию = (Стр.Терминалка = "1");
				НСтр.ОсобыеОтметки = Стр.ОсОтметки;
				НСтр.ИнструкцииПоСдачеПорожнего = Стр.ИнструкцияПоСдаче;
			КонецЦикла;
			
			Попытка
				Ндок.Записать(РежимЗаписиДокумента.Запись);
				Ндок.Записать(РежимЗаписиДокумента.Проведение);
				Результат.ДокументСсылка.Добавить(НДок.Ссылка);
			Исключение
				Результат.Успешно = Ложь;
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Результат.Успешно Тогда
		ЗафиксироватьТранзакцию();
	Иначе
		ОтменитьТранзакцию();
	КонецЕсли;
	
	УдалитьФайлы(ИВФ);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьГрузоотправителяПоПСЦ(ПСЦ) Экспорт
	
	Результат = неопределено;
	
	Если НЕ ЗначениеЗаполнено(ПСЦ) Тогда Возврат Результат; КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	МАКСИМУМ(ПОДСТРОКА(ПСЦКалькуляции.Калькуляция.ДокументОснование.Грузоотправитель.НаименованиеПолное, 1, 1000)) КАК Грузоотправитель
	               |ИЗ
	               |	Документ.ПСЦ.Калькуляции КАК ПСЦКалькуляции
	               |ГДЕ
	               |	ПСЦКалькуляции.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ПСЦ);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		
		Результат = Ответ.Грузоотправитель;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

