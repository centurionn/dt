
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("ПодходящиеРейсы") Тогда
		СписокПодходящихРейсов = Параметры.ПодходящиеРейсы;
		Элементы.ПодходящиеРейсы.Видимость = Истина;
		ПодходящиеРейсы = Истина;
	Иначе
		Элементы.ПодходящиеРейсы.Видимость = Ложь;
		ПодходящиеРейсы = Ложь;
	КонецЕсли;
	
	Если Параметры.Свойство("Договор") Тогда
		Список.Параметры.УстановитьЗначениеПараметра("ФильтрДоговор", Истина);
		Список.Параметры.УстановитьЗначениеПараметра("Договор", Параметры.Договор);
	Иначе
		Список.Параметры.УстановитьЗначениеПараметра("ФильтрДоговор", Ложь);
		Список.Параметры.УстановитьЗначениеПараметра("Договор", неопределено);
	КонецЕсли;  
	
	// ДИТ US 79847 ТА 80505 Сержантова А.С. Начало: 15.05.2024
	Если Параметры.Свойство("ТолькоПроведенные") Тогда
	    Список.Параметры.УстановитьЗначениеПараметра("ФильтрТолькоПроведенные", Истина);
	Иначе	
	    Список.Параметры.УстановитьЗначениеПараметра("ФильтрТолькоПроведенные", Ложь);
	КонецЕсли;
	// ДИТ US 79847 ТА 80505 Сержантова А.С. Конец: 15.05.2024
	
	//Евросиб Коханенко Н.А. 23.06.2025 (( #103831 
	Если НЕ РольДоступна("ПолныеПрава") Тогда
	    Список.Параметры.УстановитьЗначениеПараметра("ФильтрТолькоБезПризнакаЛКК", Истина);
	Иначе	
	    Список.Параметры.УстановитьЗначениеПараметра("ФильтрТолькоБезПризнакаЛКК", Ложь);
	КонецЕсли;
	//Евросиб Коханенко Н.А. 23.06.2025 )) #103831

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
	
	// ++ Евросиб Дудоров С.В. US 57543 30.01.2023  
	Если Параметры.Свойство("ЭтоДобавлениеКТКРефСцепаВЗаявку") Тогда
		ЭтоДобавлениеКТКРефСцепаВЗаявку = Истина;
	Иначе
		ЭтоДобавлениеКТКРефСцепаВЗаявку = Ложь;
	КонецЕсли;	
	// -- Евросиб Дудоров С.В. US 57543 30.01.2023  
			
КонецПроцедуры

