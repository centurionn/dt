&НаКлиенте
Процедура ПодходящиеРейсыПриИзменении(Элемент)
	
	ОтборПоРейсам();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	//Евросиб Каблов 11.05.2023 ( 67617 
	ЭлементыОтбора = Список.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы;
	ПолеПометкаУдаления = Новый ПолеКомпоновкиДанных("ПометкаУдаления");
	ЕстьОтборПометкаУдаления = Ложь;
	Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл
		Если ЭлементОтбора.ЛевоеЗначение = ПолеПометкаУдаления И ЭлементОтбора.Использование Тогда
			ЕстьОтборПометкаУдаления = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьОтборПометкаУдаления Тогда
		Для Каждого ЭлементНастроек Из Список.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
			Если ТипЗнч(ЭлементНастроек) = Тип("ОтборКомпоновкиДанных") Тогда				
				Для Каждого ЭлементОтбора Из ЭлементНастроек.Элементы Цикл
					Если ЭлементОтбора.ЛевоеЗначение = ПолеПометкаУдаления И ЭлементОтбора.Использование Тогда
						ЭлементОтбора.Использование = Ложь;
					КонецЕсли;
				КонецЦикла;				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	//Евросиб Каблов 11.05.2023 )
	
	ОтборПоРейсам();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПоРейсам()
	Если ПодходящиеРейсы Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,"Ссылка", СписокПодходящихРейсов,ВидСравненияКомпоновкиДанных.ВСписке);
		
	Иначе
	// ++ Евросиб Дудоров С.В. US 57543 30.01.2023  
		Если не ЭтоДобавлениеКТКРефСцепаВЗаявку Тогда
			ОбщегоНазначенияКлиентСервер. УдалитьЭлементыГруппыОтбораДинамическогоСписка(Список,"Ссылка")
		КонецЕсли;	
		//ОбщегоНазначенияКлиентСервер. УдалитьЭлементыГруппыОтбораДинамическогоСписка(Список,"Ссылка")
	// -- Евросиб Дудоров С.В. US 57543 30.01.2023  
	КонецЕсли;
КонецПроцедуры