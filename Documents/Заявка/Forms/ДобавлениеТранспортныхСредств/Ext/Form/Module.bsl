#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПрочитатьДанные(Команда)
	
	РаспознанныеДанные.Очистить();
	
	НомерСтроки = 2;
	ПредставлениеНомераСтроки = Формат(НомерСтроки, "ЧГ=0");	
	
	ПрочитаннаяСтрока = Excel.Область("R" + ПредставлениеНомераСтроки + "C1").Текст
						+ Excel.Область("R" + ПредставлениеНомераСтроки + "C2").Текст;
	
	Пока ПрочитаннаяСтрока <> "" Цикл
		
		НоваяСтрока = РаспознанныеДанные.Добавить();
		НоваяСтрока.ФИОВодителя 		= СокрЛП(Excel.Область("R" + ПредставлениеНомераСтроки + "C1").Текст);
		НоваяСтрока.РегНомерТС 			= СокрЛП(Excel.Область("R" + ПредставлениеНомераСтроки + "C2").Текст);		
		НоваяСтрока.ПаспортныеДанные 	= СокрЛП(Excel.Область("R" + ПредставлениеНомераСтроки + "C3").Текст); // Евросиб Фролов (16.02.2022 Task №44768		
		//ДИТ Шевченко А.В. 58552 05.10.2022 -начало
		АвтоперевозчикСтрока 			= СокрЛП(Excel.Область("R" + ПредставлениеНомераСтроки + "C4").Текст);
		НоваяСтрока.ИНН 				= СокрЛП(Excel.Область("R" + ПредставлениеНомераСтроки + "C5").Текст);
		НоваяСтрока.КПП 				= СокрЛП(Excel.Область("R" + ПредставлениеНомераСтроки + "C6").Текст);
		//ДИТ Шевченко А.В. 58552 05.10.2022 -конец
		
		Если ПроверитьДопустимыеСимволы(НоваяСтрока.ФИОВодителя) = Ложь Тогда
			НоваяСтрока.Ошибки = НоваяСтрока.Ошибки
							+ ?(ПустаяСтрока(НоваяСтрока.Ошибки), "", ", ")
							+ "ФИО водителя содержит недопустимые символы";
			ЕстьОшибки = Истина;				
		КонецЕсли;	
		
		Если ПроверитьДопустимыеСимволы(НоваяСтрока.РегНомерТС) = Ложь Тогда
			НоваяСтрока.Ошибки = НоваяСтрока.Ошибки
							+ ?(ПустаяСтрока(НоваяСтрока.Ошибки), "", ", ")
							+ "Рег. № ТС содержит недопустимые символы";
			ЕстьОшибки = Истина;				
		КонецЕсли;
		
		//ДИТ Шевченко А.В. 58552 05.10.2022 -начало
		ТекстСообщИНН = "";
		ИННСоответствует = Ложь;
		КППСоответствует = Ложь;
		ТекстСообщКПП = "";
		Если ЗначениеЗаполнено(НоваяСтрока.ИНН) Тогда
			ЭтоЮрЛицо = СтрДлина(НоваяСтрока.ИНН) = 10;
			ИННСоответствует = РегламентированныеДанныеКлиентСервер.ИННСоответствуетТребованиям(НоваяСтрока.ИНН,ЭтоЮрЛицо,ТекстСообщИНН);		
			Если  НЕ ИННСоответствует Тогда
				НоваяСтрока.Ошибки = НоваяСтрока.Ошибки
				+ ?(ПустаяСтрока(НоваяСтрока.Ошибки), "", ", ")
				+ ТекстСообщИНН;
				ЕстьОшибки = Истина;				
			КонецЕсли;
		КонецЕсли;
		//ДИТ Шевченко А.В. 58552 05.10.2022 -конец
		
		//ДИТ Шевченко А.В. 58552 05.10.2022 -начало
		ТекстСообщ = "";
		Если ЗначениеЗаполнено(НоваяСтрока.КПП) Тогда 
			КППСоответствует = РегламентированныеДанныеКлиентСервер.КППСоответствуетТребованиям(НоваяСтрока.КПП,ТекстСообщКПП);
			Если НЕ КППСоответствует Тогда
				НоваяСтрока.Ошибки = НоваяСтрока.Ошибки
				+ ?(ПустаяСтрока(НоваяСтрока.Ошибки), "", ", ")
				+ ТекстСообщКПП;
				ЕстьОшибки = Истина;	
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(АвтоперевозчикСтрока) Тогда
			НоваяСтрока.Автоперевозчик = АвтоперевозчикСтрока;
		КонецЕсли;	
		
		Если ИННСоответствует И КППСоответствует Тогда 
			АвтоперевозчикСсылка = НайтиКонтргентаПоИНН_КПП(НоваяСтрока.ИНН,НоваяСтрока.КПП);
			Если ЗначениеЗаполнено(АвтоперевозчикСсылка) Тогда
				НоваяСтрока.Автоперевозчик = АвтоперевозчикСсылка;
			КонецЕсли;
		КонецЕсли;	
		
		//ДИТ Шевченко А.В. 58552 05.10.2022 -конец
		
		Если ПустаяСтрока(НоваяСтрока.ФИОВодителя)
			ИЛИ ПустаяСтрока(НоваяСтрока.РегНомерТС) Тогда
			НоваяСтрока.Ошибки = НоваяСтрока.Ошибки
							+ ?(ПустаяСтрока(НоваяСтрока.Ошибки), "", ", ")
							+ "неполные данные";
			ЕстьОшибки = Истина;				
		КонецЕсли;	
		//ДИТ Шевченко А.В. 58552 05.10.2022 -начало
		//Если РаспознанныеДанные.Количество() > КоличествоСтрок Тогда
		//	НоваяСтрока.Ошибки = НоваяСтрока.Ошибки
		//					+ ?(ПустаяСтрока(НоваяСтрока.Ошибки), "", ", ")
		//					+ "превышение макс. кол-ва";
		//	ЕстьОшибки = Истина;				
		//КонецЕсли;	
		//ДИТ Шевченко А.В. 58552 05.10.2022 -конец
		НомерСтроки = НомерСтроки + 1;
		ПредставлениеНомераСтроки = Формат(НомерСтроки, "ЧГ=0");
		ПрочитаннаяСтрока = Excel.Область("R" + ПредставлениеНомераСтроки + "C1").Текст
							+ Excel.Область("R" + ПредставлениеНомераСтроки + "C2").Текст;
		
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура Перенести(Команда)
	
	Если ЕстьОшибки Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, "Перенос данных будет проведен только по строкам,
										|не имеющим ошибок. Продолжить?", Режим, 0);
	Иначе
		ВыполнитьПеренос();
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция НайтиКонтргентаПоИНН_КПП(ИНН,КПП)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ИНН = &ИНН
		|	И Контрагенты.КПП = &КПП";
	
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("КПП", КПП);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Возврат Справочники.Контрагенты.ПустаяСсылка();
	
КонецФункции

&НаКлиенте
Функция ПроверитьДопустимыеСимволы(СтрокаПроверки)
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("1234567890");
	МассивСтрок.Добавить("qwertyuiopasdfghjklzxcvbnm");
	МассивСтрок.Добавить("абвгдеёжзийклмнопрстуфхцчшщыьъэюя");
	МассивСтрок.Добавить(" .-");
	
	СтрокаДопустимыхСимволов = СтрСоединить(МассивСтрок);
	СтрокаДопустимыхСимволов = ВРег(СтрокаДопустимыхСимволов);
	
	Для НомерСимвола = 1 по СтрДлина(СтрокаПроверки) Цикл
		Если Найти(СтрокаДопустимыхСимволов, ВРег(Сред(СтрокаПроверки, НомерСимвола, 1))) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции		

&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

    ВыполнитьПеренос();

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПеренос()

	Результат = Новый Массив;
	Для каждого СтрокаДанных из РаспознанныеДанные Цикл
		
		Если НЕ ПустаяСтрока(СтрокаДанных.Ошибки) Тогда
			Продолжить;
		КонецЕсли;
		//ДИТ Шевченко А.В. 58552 05.10.2022 -начало
		СтруктураСведений = Новый Структура("ФИОВодителя, РегНомерТС, ПаспортныеДанные,Автоперевозчик,ИНН,КПП"); // Евросиб Фролов (16.02.2022 Task №44768, добавлено "ПаспортныеДанные"
		//ДИТ Шевченко А.В. 58552 05.10.2022 -конец
		ЗаполнитьЗначенияСвойств(СтруктураСведений, СтрокаДанных);
		Результат.Добавить(СтруктураСведений);
	КонецЦикла;
	
	Закрыть(Новый Структура("Результат, ИдентификаторСтроки", Результат, ИдентификаторСтроки));
	
КонецПроцедуры

#КонецОбласти