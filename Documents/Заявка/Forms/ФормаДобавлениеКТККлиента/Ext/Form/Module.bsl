
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Вагоны") Тогда
		РежимРаботы = "Вагоны";
	ИначеЕсли Параметры.Свойство("КТК") Тогда
		РежимРаботы = "КТК";
//Евросиб Гудкова( 09.09.2020 Ticket№ 0204605
		ТД.Область("R1C1").Текст = "Номер КТК";
//Евросиб Гудкова( 04.01.2020 
	ИначеЕсли Параметры.Свойство("Накладные") Тогда
		РежимРаботы = "Накладные";
		ВозвращатьСтроки = Истина;
// Евросиб Гудкова) 			
	КонецЕсли;
	Если Параметры.Свойство("ПередаватьИсходныеНомера") Тогда
		ВозвращатьСтроки = Истина;
	КонецЕсли;
//Евросиб Гудкова( 09.09.2020 Ticket№ 0204605
	Сч = 2;
	Если Параметры.Свойство("Контрагент") Тогда
		ОбластьКонтрагент = "C" + Сч;
		ТД.Область("R1" + ОбластьКонтрагент).Текст = "Контрагент";
		ТД.Область("R1" + ОбластьКонтрагент).ШиринаКолонки = 50;
    	ЕстьКонтрагент = Истина;
		Сч = Сч + 1;
		Элементы.ВозвращатьСтроки.Видимость = Ложь;
	КонецЕсли;
// Евросиб Гудкова) 	
	Если Параметры.Свойство("РазмерКТК") Тогда
		ПоказыватьРазмерКТК = Параметры.РазмерКТК;
//Евросиб Гудкова( 17.09.2020 Ticket№ 0204605
		ОбластьРазмерКТК = "C" + Сч;
		ТД.Область("R1" + ОбластьРазмерКТК).Текст = "Размер КТК";
		ТД.Область("R1" + ОбластьРазмерКТК).ШиринаКолонки = 10;
		Сч = Сч + 1;
// Евросиб Гудкова) 		
	КонецЕсли;

	Если Параметры.Свойство("ПоказыватьДатуВзятия") Тогда
		ОбластьДатаВзятия = "C" + Сч;
		ДопСекция = ТД.ПолучитьОбласть("R1" + ОбластьДатаВзятия);//Гудкова "R1C3");
		ТД.Область("R1" + ОбластьДатаВзятия).Текст = "Дата взятия";
		ТД.Область("R1" + ОбластьДатаВзятия).ШиринаКолонки = 20;
    	//ТД.Присоединить(ДопСекция, 1, ТД.ВысотаТаблицы, ТД.ШиринаТаблицы);
		ПоказыватьДатуВзятия = Истина;
		Сч = Сч + 1;
	КонецЕсли;
	
	Если Параметры.Свойство("ПрибытиеНаТерминалОтпр") Тогда
		ОбластьПрибытиеНаТерминалОтпр = "C" + Сч;
		ТД.Область("R1" + ОбластьПрибытиеНаТерминалОтпр).Текст = "Дата приема в пользование";
		ТД.Область("R1" + ОбластьПрибытиеНаТерминалОтпр).ШиринаКолонки = 25;
    	ПоказатьПрибытиеНаТерминалОтпр = Истина;
		Сч = Сч + 1;
	КонецЕсли;
	
	Если Параметры.Свойство("ДатаДоставкиГруза") Тогда
		ОбластьДатаДоставкиГруза = "C" + Сч;
		ТД.Область("R1" + ОбластьДатаДоставкиГруза).Текст = "Дата доставки груза";
		ТД.Область("R1" + ОбластьДатаДоставкиГруза).ШиринаКолонки = 25;
    	ПоказатьДатаДоставкиГруза = Истина;
		Сч = Сч + 1;
	КонецЕсли; 
	
	Если Параметры.Свойство("ДатаПриемаВСток") Тогда
		ОбластьДатаПриемаВСток = "C" + Сч;
		ТД.Область("R1" + ОбластьДатаПриемаВСток).Текст = "Дата приема в сток";
		ТД.Область("R1" + ОбластьДатаПриемаВСток).ШиринаКолонки = 20;
    	ЕстьДатаПриемаВСток = Истина;
		Сч = Сч + 1;
	КонецЕсли; 
	
	Если Параметры.Свойство("НомерТС") Тогда
		ОбластьНомерТС = "C" + Сч;
		ТД.Область("R1" + ОбластьНомерТС).Текст = "Номер ТС";
		ТД.Область("R1" + ОбластьНомерТС).ШиринаКолонки = 15;
    	ЕстьНомерТС = Истина;
		Сч = Сч + 1;
	КонецЕсли; 
	
	Если Параметры.Свойство("ВодительТС") Тогда
		ОбластьВодительТС = "C" + Сч;
		ТД.Область("R1" + ОбластьВодительТС).Текст = "Водитель";
		ТД.Область("R1" + ОбластьВодительТС).ШиринаКолонки = 100;
    	ЕстьВодительТС = Истина;
		Сч = Сч + 1;
	КонецЕсли; 
// Евросиб Гудкова) 	
	Если Параметры.Свойство("Автовставка") Тогда
		Автовставка = Истина;
	Иначе
		Автовставка = Ложь;
	КонецЕсли;
	
	Если Параметры.Свойство("ФорматДаты") Тогда
		ФорматДаты = Параметры.ФорматДаты;
	КонецЕсли;
	//++ Зубов US 33131 TA 38910 29.10.2021
	Если Параметры.Свойство("ВозвращатьСтрокиНедоступно") Тогда
		ВозвращатьСтрокиНедоступно = Параметры.ВозвращатьСтрокиНедоступно;
	КонецЕсли;
	//-- Зубов US 33131 TA 38910 29.10.2021
	//++ Зубов Ticket#0250132 15.11.2021
	Если Параметры.Свойство("СоздаватьКТК") Тогда
		СоздаватьКТК = Параметры.СоздаватьКТК;
	Иначе
		СоздаватьКТК = Ложь;
	КонецЕсли;
	//-- Зубов Ticket#0250132 15.11.2021
	
	//++ Зубов US 45162 TA 45703 21.01.2022
	Если Параметры.Свойство("ПериодДействияРелиза") Тогда
		ПериодДействияРелиза = Параметры.ПериодДействияРелиза;
	Иначе
		ПериодДействияРелиза = Неопределено;
	КонецЕсли;
	//-- Зубов US 45162 TA 45703 21.01.2022
	
	РефрижераторныйКТК = Ложь;
	

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры

//Евросиб Коханенко Н.А. #61705 09.12.2022 (
&НаКлиенте
Процедура ОткрытьОкноСИнструкциями(Форма, Команда)
	ИнструкцииКлиент.ОткрытьОкноСИнструкциями(ЭтаФорма, Команда);
КонецПроцедуры  
//Евросиб Коханенко Н.А. #61705 09.12.2022 )


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.Декорация5.Видимость = ?(РежимРаботы = "КТК",Истина,Ложь);
	Элементы.Декорация6.Видимость = ?(РежимРаботы = "КТК",Истина,Ложь);
	Элементы.РезультатДатаВзятия.Видимость = ?(ПоказыватьДатуВзятия,Истина,Ложь);
	Элементы.РезультатДатаДоставкиГруза.Видимость = ?(ПоказатьДатаДоставкиГруза,Истина,Ложь);
	Элементы.РезультатВремяПрибытияНаТерминал.Видимость = ?(ПоказатьПрибытиеНаТерминалОтпр,Истина,Ложь);
	Элементы.ФорматДаты.Видимость = ?(ПоказыватьДатуВзятия ИЛИ ПоказатьДатаДоставкиГруза,Истина,Ложь);
	Элементы.РезультатДатаПриемаВСток.Видимость = ?(ЕстьДатаПриемаВСток,Истина,Ложь);
	Элементы.РезультатКонтрагент.Видимость = ?(ЕстьКонтрагент,Истина,Ложь);
	Элементы.РезультатСтрокаКонтрагент.Видимость = ?(ЕстьКонтрагент,Истина,Ложь);
	Элементы.РезультатВодительТС.Видимость = ?(ЕстьВодительТС,Истина,Ложь);
	Элементы.РезультатНомерТС.Видимость = ?(ЕстьНомерТС,Истина,Ложь);
	//++ Зубов US 33131 TA 38910 29.10.2021
	Элементы.ВозвращатьСтроки.ТолькоПросмотр = ?(ВозвращатьСтрокиНедоступно,Истина,Ложь);
	//-- Зубов US 33131 TA 38910 29.10.2021
	Если Автовставка Тогда
		// необходимо установить обработчик ожидания для работы механизма копирования/вставки через WScript.Shell
		// в противном случае, скрипт не успевает вставить данные в форму, а 1С уже проверяет их наличие
		ПодключитьОбработчикОжидания("ПроверкаСодержимогоЯчейки", 0.1, Истина);
		
		wsh=Новый COMОбъект("WScript.Shell");    
		ЭтаФорма.ТекущийЭлемент = Элементы.ТД;
		Элементы.ТД.ТекущаяОбласть = ЭтаФорма.ТД.Область("R2C1");
		wsh.SendKeys("^v");
		wsh.SendKeys("^м");
    КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьДанные(Команда)
	
	ПроверкаСодержимогоЯчейки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаСодержимогоЯчейки() 
	
	Сч = 2;
	Результат.Очистить();
	
	ПрочСтрока = ТД.Область("R"+Формат(Сч, "ЧГ=0")+"C1").Текст;
	
	// блок для проверки копирования/вставки
	Если ПрочСтрока = "" Тогда
		Возврат;
	КонецЕсли;
	ОтключитьОбработчикОжидания("ПроверкаСодержимогоЯчейки");
	///////////////////////
	
	Пока ПрочСтрока <> "" Цикл
		
//Евросиб Гудкова( 17.09.2020 Ticket№ 0204605
//было		СтрокаРазмерКТК = ТД.Область("R"+Сч+"C2").Текст;
		СтрокаРазмерКТК = СокрЛП(ТД.Область("R"+Формат(Сч, "ЧГ=0")+ОбластьРазмерКТК).Текст);
// Евросиб Гудкова) 			
		Если ПоказыватьДатуВзятия Тогда
			СтрокаДата = СокрЛП(ТД.Область("R"+Формат(Сч, "ЧГ=0")+ОбластьДатаВзятия).Текст);
		КонецЕсли;
		Если ПоказатьПрибытиеНаТерминалОтпр Тогда
			СтрДатаПрибытия = СокрЛП(ТД.Область("R"+Формат(Сч, "ЧГ=0")+ОбластьПрибытиеНаТерминалОтпр).Текст);
		КонецЕсли;
		Если ПоказатьДатаДоставкиГруза Тогда
			СтрДатаДоставкиГруза = СокрЛП(ТД.Область("R"+Формат(Сч, "ЧГ=0")+ОбластьДатаДоставкиГруза).Текст);
		КонецЕсли;
		НСтр = Результат.Добавить();
		НСтр.ПрочитаннаяСтрока = ПрочСтрока;
		Если РежимРаботы = "Вагоны" Тогда
			НСтр.ПрочитаннаяСсылка = Грузы_сервер.НайтиВагон(ПрочСтрока);
		КонецЕсли;
//Евросиб Гудкова( 04.01.2020 
		Если Режимработы = "Накладные" Тогда
			НСтр.ПрочитаннаяСсылка = НайтиНакладную(ПрочСтрока);
		КонецЕсли;
// Евросиб Гудкова) 			
		Если РежимРаботы = "КТК" Тогда
			НСтр.РазмерКТКСтрока = СокрЛП(СтрокаРазмерКТК);
			//ДИТ Шевченко А.В. 60130 23.11.2022 -начало
			//НСтр.РазмерКТК = ?(РефрижераторныйКТК, ПолучитьТипоразмерРефрижераторныйКТК(СокрЛП(СтрокаРазмерКТК)),ПолучитьТипоразмерКТК(СокрЛП(СтрокаРазмерКТК)));
			НСтр.РазмерКТК = РаботаСКонтейнерамиСервер.НайтиТипПоРазмеру(СокрЛП(СтрокаРазмерКТК),РефрижераторныйКТК,ПрочСтрока);
			//ДИТ Шевченко А.В. 60130 23.11.2022 -конец
			НСтр.ВычисленноеКонтрольноеЧисло = РаботаСКонтейнерамиСервер.ПолучитьКонтрольноеЧисло(Лев(ПрочСтрока,4), Сред(ПрочСтрока,5,6));
			НСтр.КонтрольноеЧислоПользователя = Прав(ПрочСтрока,1);
			Если ПоказыватьДатуВзятия Тогда
				//++ Зубов US 33131 TA 43877 16.12.2021
				//НСтр.ПрочитаннаяСсылка = НайтиКТК(ПрочСтрока);
				НСтр.ПрочитаннаяСсылка = НайтиКТК(ПрочСтрока,НСтр.РазмерКТК);
				
				// ++ ДИТ Поморцева Т.П. Задача 45162 01.02.2022.				
				Если СоздаватьКТК И НЕ ЗначениеЗаполнено(НСтр.ПрочитаннаяСсылка) Тогда					
					Если ЗначениеЗаполнено(НСтр.РазмерКТК) Тогда
						НСтр.ПрочитаннаяСсылка = РаботаСКонтейнерамиСервер.СоздатьКТК(ПрочСтрока, НСтр.РазмерКТК);
					Иначе
						Сообщить("Не определен размер КТК для контейнера "+ПрочСтрока+". Контейнер не будет создан.");
					КонецЕсли;
				КонецЕсли;
				// -- ДИТ Поморцева Т.П. Задача 45162 01.02.2022.
				
				НСтр.РазмерКТК = ВыбратьНужныйРазмерКТК(НСтр.РазмерКТК,НСтр.ПрочитаннаяСсылка);
				//-- Зубов US 33131 TA 43877 16.12.2021
				
				//++ Зубов US 45162 TA 45703 21.01.2022
				НСтр.ДатаВзятия = ПреобразованиеВДату(СтрокаДата);
				Если (НСтр.ДатаВзятия < ПериодДействияРелиза.ДатаНачала ИЛИ НСтр.ДатаВзятия > ПериодДействияРелиза.ДатаОкончания) И НЕ НСтр.ДатаВзятия = Дата("00010101") Тогда			
					Сообщить("По КТК "+НСтр.ПрочитаннаяСсылка+" дата взятия "+НСтр.ДатаВзятия+" не будет перенесена в документ, так как она не входит в период действия релиза "+ПериодДействияРелиза);
					НСтр.ДатаВзятия = Дата("00010101");
				КонецЕсли;
				//++ Зубов US 45162 TA 45703 21.01.2022
			Иначе
				//++ Зубов Ticket#0250132 15.11.2021
				//++ Зубов US 33131 TA 43877 16.12.2021
				//НСтр.ПрочитаннаяСсылка = НайтиКТК(ПрочСтрока); 
				
				НСтр.ПрочитаннаяСсылка = НайтиКТК(ПрочСтрока,НСтр.РазмерКТК);
				
				// ++ ДИТ Поморцева Т.П. Задача 45162 01.02.2022. Условие было после заполнения НСтр.РазмерКТК =, перенесено,  так как тогда РазмерКТК не заполнялся
				Если СоздаватьКТК И НЕ ЗначениеЗаполнено(НСтр.ПрочитаннаяСсылка) Тогда
					
					Если ЗначениеЗаполнено(НСтр.РазмерКТК) Тогда
						НСтр.ПрочитаннаяСсылка = РаботаСКонтейнерамиСервер.СоздатьКТК(ПрочСтрока, НСтр.РазмерКТК);
					Иначе
						Сообщить("Не определен размер КТК для контейнера "+ПрочСтрока+". Контейнер не будет создан.");
						//НСтр.ПрочитаннаяСсылка = НайтиКТК(ПрочСтрока);
					КонецЕсли;
					
					НСтр.РазмерКТК = ВыбратьНужныйРазмерКТК(НСтр.РазмерКТК,НСтр.ПрочитаннаяСсылка);
					//-- Зубов US 33131 TA 43877 16.12.2021				
					
					//Иначе
					//Евросиб Каблов 15.10.2021 ( Task 39043
					//НСтр.ПрочитаннаяСсылка = РаботаСКонтейнерамиСервер.СоздатьКТК(ПрочСтрока, НСтр.РазмерКТК);
					//НСтр.ПрочитаннаяСсылка = НайтиКТК(ПрочСтрока);
					//Евросиб Каблов 15.10.2021 )
				КонецЕсли;
								
				//Пункт 6.2 
				Если ЗначениеЗаполнено(НСтр.ПрочитаннаяСсылка) И ВЭксплуатации(НСтр.ПрочитаннаяСсылка) Тогда					
					Результат.Удалить(НСтр);
					НомерТекущейСтроки = Сч-1;
					Сообщить("Контейнер в строке " + Строка(НомерТекущейСтроки) + " имеется в АРМ КТК с открытым циклом пользования");
					Сч = Сч + 1;
					ПрочСтрока = ТД.Область("R"+Формат(Сч, "ЧГ=0")+"C1").Текст;
  					Продолжить;
				КонецЕсли;
				
				//Пункт 6.6
				Если ЭтоРефрижераторныйКТК(Лев(ПрочСтрока,4)) Тогда
					НомерТекущейСтроки = Сч-1;					
					Сообщить("Возможно, контейнер  " + Строка(ПрочСтрока) + " (строка " + Строка(НомерТекущейСтроки) + ") является рефрижераторным. Если это так, установите признак «Рефрижераторный КТК» в окне вставки контейнеров из буфера обмена при добавлении этого КТК в заявку.».");		
				КонецЕсли;
				
				//Пункт 6.7
				Если Не ЗначениеЗаполнено(НСтр.РазмерКТК) Тогда
					Сообщить("Не определен размер КТК для контейнера "+ПрочСтрока+". Контейнер не будет добавлен.");
				КонецЕсли;
				
				
				//Пункт 7.2
				МассивКорректныхТипоразмеров = Новый Массив;
				МассивКорректныхТипоразмеров.Добавить("20RF");
				МассивКорректныхТипоразмеров.Добавить("40RFH");
				МассивКорректныхТипоразмеров.Добавить("45RFH");
				Если РефрижераторныйКТК И СтрДлина(НСтр.РазмерКТКСтрока) > 2 И МассивКорректныхТипоразмеров.Найти(НСтр.РазмерКТКСтрока) = Неопределено Тогда
					НСтр.РазмерКТК = ПолучитьПустуюСсылкуТипоразмерыТЕ();
					НомерТекущейСтроки = Сч-1;					
					Сообщить("Указанный в строке  " + Строка(НомерТекущейСтроки) + " тип не соответствует типу рефрижераторного контейнера. Измените/удалите тип в поле «Размер КТК» либо снимите признак «Рефрижераторный КТК».");		
				КонецЕсли;
				
				//Пункт 6.8
				Если ЗначениеЗаполнено(НСтр.ПрочитаннаяСсылка) И ЗначениеЗаполнено(НСтр.РазмерКТК) Тогда					
					ТипТЕИзКарточкиКонтейнера = ПолучитьТипТЕ(НСтр.ПрочитаннаяСсылка);
					Если ТипТЕИзКарточкиКонтейнера <> Неопределено Тогда
						НСтр.РазмерКТК = ТипТЕИзКарточкиКонтейнера.СсылкаТипТЕ;
						ВведенРазмер = СтрДлина(СтрокаРазмерКТК) = 2;
						ВведенТипоРаземер = СтрДлина(СтрокаРазмерКТК) > 2;					
						Если (ВведенРазмер И СтрокаРазмерКТК <> ТипТЕИзКарточкиКонтейнера.Размер)  ИЛИ (ВведенТипоРаземер И СтрокаРазмерКТК <> ТипТЕИзКарточкиКонтейнера.ТипТЕ) Тогда
							НомерТекущейСтроки = Сч-1;
							Сообщить("Введенные данные о типоразмере контейнера в строке " + Строка(НомерТекущейСтроки) + " не соответствуют имеющимся в карточке контейнера. В область прочитанных данных внесен типоразмер из карточки контейнера.");					
						КонецЕсли;						
					КонецЕсли;					
				КонецЕсли;
										
				//-- Зубов Ticket#0250132 15.11.2021
			КонецЕсли;
			Если ПоказатьПрибытиеНаТерминалОтпр Тогда
				НСтр.ВремяПрибытияНаТерминал = ПреобразованиеВДату(СтрДатаПрибытия);
			КонецЕсли;
			Если ПоказатьДатаДоставкиГруза Тогда
				НСтр.ДатаДоставкиГруза = ПреобразованиеВДату(СтрДатаДоставкиГруза);
			КонецЕсли; 
//Евросиб Гудкова( 09.09.2020 Ticket№ 0204605
			Если ЕстьВодительТС Тогда
				НСтр.ВодительТС = СокрЛП(ТД.Область("R"+Формат(Сч, "ЧГ=0")+ОбластьВодительТС).Текст);
			КонецЕсли;
			Если ЕстьДатаПриемаВСток Тогда
				НСтр.ДатаПриемаВСток = ПреобразованиеВДату(ТД.Область("R"+Формат(Сч, "ЧГ=0")+ОбластьДатаПриемаВСток).Текст);
			КонецЕсли;
			Если ЕстьКонтрагент Тогда
				СтрКонтрагент = СокрЛП(ТД.Область("R"+Формат(Сч, "ЧГ=0")+ОбластьКонтрагент).Текст);
				Нстр.Контрагент = ПолучитьКонтрагентаПоСинониму(СтрКонтрагент);
				Нстр.СтрокаКонтрагент = СтрКонтрагент;
			КонецЕсли;
			Если ЕстьНомерТС Тогда
				НСтр.НомерТС = СокрЛП(ТД.Область("R"+Формат(Сч, "ЧГ=0")+ОбластьНомерТС).Текст);
			КонецЕсли;
// Евросиб Гудкова)
		КонецЕсли;
		
		Сч = Сч + 1;
		ПрочСтрока = ТД.Область("R"+Формат(Сч, "ЧГ=0")+"C1").Текст;
	КонецЦикла;
	
	// после распознавания, если стоит флаг "Автовставка", вызвать процедуру переноса значений в документ
	Если Автовставка Тогда
		ПеренестиВДокументКлиент();
	КонецЕсли;
	
КонецПроцедуры


