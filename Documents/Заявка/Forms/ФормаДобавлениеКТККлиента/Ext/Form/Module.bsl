&НаСервереБезКонтекста
Функция ВЭксплуатации(СсылкаНаКонтейнер)

	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	стоки_ТекущиеДанныеСрезПоследних.тек_ВЭксплуатации КАК тек_ВЭксплуатации,
		|	стоки_ТекущиеДанныеСрезПоследних.тек_Статус КАК тек_Статус,
		|	стоки_ТекущиеДанныеСрезПоследних.тек_ВидСобственности КАК тек_ВидСобственности,
		|	стоки_ТекущиеДанныеСрезПоследних.тек_НаСлежении КАК тек_НаСлежении,
		|	стоки_ТекущиеДанныеСрезПоследних.Инвентаризация КАК Инвентаризация
		|ИЗ
		|	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних(, КТК = &КТК) КАК стоки_ТекущиеДанныеСрезПоследних";
	
	Запрос.УстановитьПараметр("КТК", СсылкаНаКонтейнер);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Результат = ВыборкаДетальныеЗаписи.тек_ВЭксплуатации; 	
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТипТЕ(ПрочитаннаяСсылка)
	
	Результат = Новый Структура;	
	Если ЗначениеЗаполнено(ПрочитаннаяСсылка.ТипТЕ) Тогда
		Результат.Вставить("СсылкаТипТЕ", ПрочитаннаяСсылка.ТипТЕ);
		Результат.Вставить("Размер", Лев(ПрочитаннаяСсылка.ТипТЕ.Наименование,2)); 
		Результат.Вставить("ТипТЕ", ПрочитаннаяСсылка.ТипТЕ.Наименование);
		Возврат Результат; 
	Иначе
		Возврат Неопределено; 	
	КонецЕсли;
	
КонецФункции 

&НаСервереБезКонтекста
Функция ПолучитьТипоразмерРефрижераторныйКТК(РазмерКТКСтрока) 
	
	Рез = Справочники.ТипоразмерыТЕ.ПустаяСсылка();
	
	Если РазмерКТКСтрока = "20" Или РазмерКТКСтрока = "40" Или РазмерКТКСтрока = "45" Тогда		
		НаименованиеДляПоиска = РазмерКТКСтрока; 	
		Если РазмерКТКСтрока = "20" Тогда 			
			НаименованиеДляПоиска = НаименованиеДляПоиска + "RF";
		ИначеЕсли РазмерКТКСтрока = "40" Или РазмерКТКСтрока = "45" Тогда
			НаименованиеДляПоиска = НаименованиеДляПоиска + "RFH";
		КонецЕсли;	
		Рез = Справочники.ТипоразмерыТЕ.НайтиПоНаименованию(СтроковыеФункцииКлиентСервер.УдалитьПрочиеСимволыИзСтроки(НаименованиеДляПоиска), Истина);
	Иначе //Евросиб Гудкова( 09.09.2020 Ticket№ 0204605
		Рез = Справочники.ТипоразмерыТЕ.НайтиПоНаименованию(СтроковыеФункцииКлиентСервер.УдалитьПрочиеСимволыИзСтроки(РазмерКТКСтрока), Истина);
	КонецЕсли; 
	
	Возврат Рез;
	
КонецФункции

