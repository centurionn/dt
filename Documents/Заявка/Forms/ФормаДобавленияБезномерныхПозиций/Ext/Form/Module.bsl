&НаКлиенте
Процедура ПриОткрытии(Отказ) 
	//ДИТ Беляев СЮ, Ticket#0263826, 10-03-2022 начало
	Если ЭтаФорма.ВладелецФормы = Неопределено Тогда
		Возврат;
	КонецЕсли;                              
	//ДИТ Беляев СЮ, Ticket#0263826, 10-03-2022 конец
	Если ЭтаФорма.ВладелецФормы.ИмяФормы = "Документ.РелизСобственника.Форма.ФормаДокумента" Тогда
		Элементы.КомандаПерезаполнить.Видимость = Ложь;
		Элементы.КомандаДобавить.Заголовок = "Дополнить указанным количеством";
		Элементы.ТипДобавляемыхКТК.Заголовок = "Типоразмер добавляемых КТК"; 
		Элементы.ТипДобавляемыхКТК.АвтоОтметкаНезаполненного = Истина;
	КонецЕсли;
КонецПроцедуры
//-- Зубов US 33131 TA 43877 16.12.2021