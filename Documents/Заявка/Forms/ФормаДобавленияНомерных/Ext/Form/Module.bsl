Функция ПроверитьФорматВВеденныхДанных(СтруктураДляРезультатаИПроверки,сч)
	
	Нарушение = Ложь;
	НаименованиеПолейСНарушениями = Новый Массив;
	
	
	Если ЗначениеЗаполнено(СтруктураДляРезультатаИПроверки.КоличествоМест) Тогда
		Попытка
			Знч = Число(СтруктураДляРезультатаИПроверки.КоличествоМест);
			Если НЕ СтруктураДляРезультатаИПроверки.КоличествоМест = Формат(Знч,"ЧЦ=10; ЧДЦ=0; ЧГ=0") Тогда
				Нарушение = Истина;
				НаименованиеПолейСНарушениями.Добавить("Количество мест");
			КонецЕсли;	
		Исключение
			Нарушение = Истина;
			НаименованиеПолейСНарушениями.Добавить("Количество мест");			
		КонецПопытки;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураДляРезультатаИПроверки.НормативноеИспользование) Тогда
		Попытка
			Знч = Число(СтруктураДляРезультатаИПроверки.НормативноеИспользование);
			Если НЕ СтруктураДляРезультатаИПроверки.НормативноеИспользование = Формат(Знч,"ЧЦ=3; ЧДЦ=0; ЧГ=0") Тогда
				Нарушение = Истина;
				НаименованиеПолейСНарушениями.Добавить("Норма исп., дней");
			КонецЕсли;	
		Исключение
			Нарушение = Истина;
			НаименованиеПолейСНарушениями.Добавить("Норма исп., дней");
		КонецПопытки;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураДляРезультатаИПроверки.ВесГрузаНетто) Тогда
		Попытка
			Знч = Число(СтруктураДляРезультатаИПроверки.ВесГрузаНетто);			
			Если Знч > 9999999.999 Тогда
				Нарушение = Истина;
				НаименованиеПолейСНарушениями.Добавить("Вес груза нетто, кг");
			КонецЕсли;	
			Если Знч < 0 Тогда
				Нарушение = Истина;
				НаименованиеПолейСНарушениями.Добавить("Вес груза нетто, кг");
			КонецЕсли;		
		Исключение
			Нарушение = Истина;
			НаименованиеПолейСНарушениями.Добавить("Вес груза нетто, кг");
		КонецПопытки;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураДляРезультатаИПроверки.НомерАвто) Тогда	
		Если СтрДлина(СтруктураДляРезультатаИПроверки.НомерАвто) > 20 Тогда
			Нарушение = Истина;
			НаименованиеПолейСНарушениями.Добавить("Номер авто на погрузке");
	    КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураДляРезультатаИПроверки.ФИОВодителя) Тогда	
		Если СтрДлина(СтруктураДляРезультатаИПроверки.ФИОВодителя) > 150 Тогда
			Нарушение = Истина;
			НаименованиеПолейСНарушениями.Добавить("ФИО водителя на погрузке");
		КонецЕсли;
		Если НЕ СтроковыеФункцииКлиентСерверРФ.ТолькоКириллицаВСтроке(СтруктураДляРезультатаИПроверки.ФИОВодителя,," .") Тогда
			Нарушение = Истина;
			НаименованиеПолейСНарушениями.Добавить("ФИО водителя на погрузке");
		КонецЕсли;	
	КонецЕсли;
	
	Для Каждого ЗнчМс Из НаименованиеПолейСНарушениями Цикл
		Сообщить("Несоответствие формата введенных данных в поле "+ЗнчМс+" в строке " + сч);
	КонецЦикла;
	
	Возврат Нарушение;
	
КонецФункции	

