&НаСервере
Процедура ЭТРАН_Найти_Сервер()
	
	МассивАналоговОтправления = Локации_сервер.ПолучитьАналогиИСтанцииБлижеЧемУказано(СтанцияОтправления, -1);
	МассивАналоговОтправления.Добавить(СтанцияОтправления);
	МассивАналоговНазначения = Новый Массив;
	Если ЗначениеЗаполнено(СтанцияНазначения) Тогда
		МассивАналоговНазначения = Локации_сервер.ПолучитьАналогиИСтанцииБлижеЧемУказано(СтанцияНазначения, -1);
		МассивАналоговНазначения.Добавить(СтанцияНазначения);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	э_НакладнаяКонтейнеры.НомерКонтейнера КАК НомерКонтейнера,
	               |	э_НакладнаяКонтейнеры.Ссылка КАК Накладная,
	               |	э_НакладнаяКонтейнеры.Ссылка.ЗаявкаГУ12 КАК ЗаявкаГУ12,
	               |	э_НакладнаяКонтейнеры.Ссылка.СтанцияОтправленияКод КАК СтанцияОтправленияКод,
	               |	э_НакладнаяКонтейнеры.Ссылка.СтанцияНазначенияКод КАК СтанцияНазначенияКод,
	               |	э_НакладнаяКонтейнеры.Ссылка.ДатаИВремяРаскредитованияГруза КАК ДатаРаскредитации,
	               |	э_НакладнаяКонтейнеры.Ссылка.ДатаИВремяПрибытияГруза КАК ДатаПрибытия,
	               |	э_НакладнаяКонтейнеры.Ссылка.ДатаИВремяОтправленияГруза КАК ДатаОтправления,
	               |	э_НакладнаяКонтейнеры.Ссылка.НакладнаяНомер КАК НакладнаяНомер,
	               |	э_НакладнаяКонтейнеры.Ссылка.ИсточникНакладной КАК ИсточникНакладной,
	               |	э_НакладнаяВагоны.НомерВагона КАК Вагон,
	               |	э_НакладнаяКонтейнеры.Ссылка.ТекущееСостояниеНакладной КАК ТекущееСостояниеНакладной,
	               |	ТЕ.Ссылка КАК КТК,
	               |	ЛокОтправления.Ссылка КАК СтанцияОтправления,
	               |	ЛокПрибытия.Ссылка КАК СтанцияНазначения
	               |ИЗ
	               |	Документ.э_Накладная.Контейнеры КАК э_НакладнаяКонтейнеры
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.э_Накладная.Вагоны КАК э_НакладнаяВагоны
	               |		ПО э_НакладнаяКонтейнеры.Ссылка = э_НакладнаяВагоны.Ссылка
	               |			И (э_НакладнаяКонтейнеры.НомерВагонаДляКонтейнерногоПоезда = э_НакладнаяВагоны.ПорядковыйНомерВагонаВОтправке
	               |				ИЛИ э_НакладнаяКонтейнеры.НомерВагонаДляКонтейнерногоПоезда = 0)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТЕ КАК ТЕ
	               |		ПО э_НакладнаяКонтейнеры.НомерКонтейнера = ТЕ.Наименование
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Локации КАК ЛокОтправления
	               |		ПО э_НакладнаяКонтейнеры.Ссылка.СтанцияОтправленияКод = ЛокОтправления.КодЖДСтанции
	               |			И (НЕ ЛокОтправления.ПометкаУдаления)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Локации КАК ЛокПрибытия
	               |		ПО э_НакладнаяКонтейнеры.Ссылка.СтанцияНазначенияКод = ЛокПрибытия.КодЖДСтанции
	               |			И (НЕ ЛокПрибытия.ПометкаУдаления)
	               |ГДЕ
	               |	НЕ э_НакладнаяКонтейнеры.Ссылка.ПометкаУдаления
	               |	И ЛокОтправления.Ссылка В(&СписокЛокацийОтправления)
	               |	И (ЛокПрибытия.Ссылка В (&СписокЛокацийПрибытия)
	               |			ИЛИ &СписокЛокацийПрибытияПуст)
	               |	И э_НакладнаяКонтейнеры.Ссылка.ДатаИВремяПринятияГрузаКПеревозке МЕЖДУ &Дата1 И &Дата2
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	э_НакладнаяКонтейнеры.Ссылка.Дата";
	
	Запрос.УстановитьПараметр("Дата1", ЭТРАН_НачалоПериода);
	Запрос.УстановитьПараметр("Дата2", ЭТРАН_КонецПериода);
	Запрос.УстановитьПараметр("СписокЛокацийОтправления", МассивАналоговОтправления);
	Запрос.УстановитьПараметр("СписокЛокацийПрибытия", МассивАналоговНазначения);
	Запрос.УстановитьПараметр("СписокЛокацийПрибытияПуст", НЕ ЗначениеЗаполнено(СтанцияНазначения));
	
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		НСтр = ТаблицаЭТРАН.Добавить();
		ЗаполнитьЗначенияСвойств(НСтр, Ответ);
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ExcelПрямыеКлиентыПриИзмененииСодержимогоОбласти(Элемент, Область)
	ЧислаМ = Новый Массив;
	Для Сч = 0 По 9 Цикл ЧислаМ.Добавить(Строка(Сч)); КонецЦикла;
	
	СохраненныйБелый = ExcelПрямыеКлиенты.Область("R3C50").ЦветФона;
	
	Для Сч = 3 По ExcelПрямыеКлиенты.ВысотаТаблицы Цикл
		ПрочСтрока = ExcelПрямыеКлиенты.Область("R"+Формат(Сч, "ЧГ=0")+"C1").Текст;
		КонтрольныйЗнак = Неопределено;
		Если СтрДлина(ПрочСтрока) = 11 Тогда
			КонтрольныйЗнак = РаботаСКонтейнерамиСервер.ПолучитьКонтрольноеЧисло(Лев(ПрочСтрока,4), Сред(ПрочСтрока,5,6));
		КонецЕсли;
		Если ЗначениеЗаполнено(ПрочСтрока) И (СтрДлина(ПрочСтрока) <> 11 //////   \/ добавил вот это 
			ИЛИ КонтрольныйЗнак = "Неверно" ИЛИ ЧислаМ.Найти(Прав(ПрочСтрока,1)) = неопределено  
			ИЛИ (СтрДлина(ПрочСтрока) = 11 И НЕ Число(Прав(ПрочСтрока,1)) = КонтрольныйЗнак)) Тогда
			ExcelПрямыеКлиенты.Область("R"+Формат(Сч, "ЧГ=0")+"C1").ЦветФона = WebЦвета.Розовый;
		Иначе
			ExcelПрямыеКлиенты.Область("R"+Формат(Сч, "ЧГ=0")+"C1").ЦветФона = СохраненныйБелый;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТипТЕ(ПрочитаннаяСсылка)
	
	Результат = Новый Структура;	
	Если ЗначениеЗаполнено(ПрочитаннаяСсылка.ТипТЕ) Тогда
		Результат.Вставить("СсылкаТипТЕ", ПрочитаннаяСсылка.ТипТЕ);
		Результат.Вставить("СсылкаРазмер", ПрочитаннаяСсылка.ТипТЕ.РазмерКТК);
		Результат.Вставить("Размер", Лев(ПрочитаннаяСсылка.ТипТЕ.Наименование,2)); 
		Результат.Вставить("ТипТЕ", ПрочитаннаяСсылка.ТипТЕ.Наименование);
		Возврат Результат; 
	Иначе
		Возврат Неопределено; 	
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьРефрижераторныеТипыТЕ()	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТипоразмерыТЕ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ТипоразмерыТЕ КАК ТипоразмерыТЕ
		|ГДЕ
		|	ТипоразмерыТЕ.Рефрижераторный
		|	И НЕ ТипоразмерыТЕ.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");	
КонецФункции

