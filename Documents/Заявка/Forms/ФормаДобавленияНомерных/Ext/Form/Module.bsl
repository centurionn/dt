	Иначе    
		РезультатПроверки.Вставить("ПоведениеПриЗаполнении", 4);
		ОбработкаВопросаЗакрытия(КодВозвратаДиалога.Да, РезультатПроверки);
	КонецЕсли;
	
КонецПроцедуры  

// ДИТ US 76619 ТА 76735 Сержантова А.С. 08.11.2023 - перенесено из команды ПроверитьИПеренести 
&НаКлиенте
Функция ПроверитьРасширенныйСписокПередПереносом(Отказ, ПоведениеПриЗаполнении)
	
	Ответ = Новый Структура("Результат, НомераСтрокСНарушениемФормата");
	
	МассивРефрижераторныехТиповТЕ = ПолучитьРефрижераторныеТипыТЕ();
	
	Результат = Новый Массив;
	
	НомераСтрокЗаполненРазмерПустойКонтейнер	= Новый Массив;
	НомераСтрокНеСоответствуетТипоразмер 		= Новый Массив;
	НомераСтрокПустойТипВТЕИИсточнике 			= Новый Массив;
	НомераСтрокСНарушениемФормата 				= Новый Массив;
	
	Сч = 3;
	ПрочСтрока = ПолучитьЗначениеПоВсейСтроке(Сч);
	
	Если ПрочСтрока = "" Тогда
		Отказ = Истина;
		Возврат Ответ;
	КонецЕсли;
	
	Пока ПрочСтрока <> "" Цикл
		
		ВесьСписокОшибок = "";
		
		НомерКТК 			= ExcelПрямыеКлиенты.Область("R"+Сч+"C1").Текст;
		НомерРелиза 		= ExcelПрямыеКлиенты.Область("R"+Сч+"C2").Текст;
		ДатаПодачиМашины 	= ExcelПрямыеКлиенты.Область("R"+Сч+"C3").Текст;
		НормаПользования 	= ExcelПрямыеКлиенты.Область("R"+Сч+"C4").Текст;
		Размер 				= ExcelПрямыеКлиенты.Область("R"+Сч+"C5").Текст;
		Пломбы 				= ExcelПрямыеКлиенты.Область("R"+Сч+"C6").Текст;
		ФИОВодителя 		= ExcelПрямыеКлиенты.Область("R"+Сч+"C7").Текст;
		НомерАвто 			= ExcelПрямыеКлиенты.Область("R"+Сч+"C8").Текст;
		СтанцияОтпр 		= ExcelПрямыеКлиенты.Область("R"+Сч+"C9").Текст;
		ПунктНазн 			= ExcelПрямыеКлиенты.Область("R"+Сч+"C10").Текст;
		СтанцияНазн 		= ExcelПрямыеКлиенты.Область("R"+Сч+"C11").Текст;
		ЕТСНГ 				= ExcelПрямыеКлиенты.Область("R"+Сч+"C12").Текст;
		Груз 				= ?(ЗначениеЗаполнено(ЕТСНГ), ПолучитьГрузПоЕТСНГ(ЕТСНГ), неопределено);
		Грузополучатель 	= ExcelПрямыеКлиенты.Область("R"+Сч+"C13").Текст;
		КоличествоМест 		= ExcelПрямыеКлиенты.Область("R"+Сч+"C14").Текст;
		ВесГруза 			= ExcelПрямыеКлиенты.Область("R"+Сч+"C15").Текст;
		ОсобыеОтметки 		= ExcelПрямыеКлиенты.Область("R"+Сч+"C16").Текст;
		Инструкция 			= ExcelПрямыеКлиенты.Область("R"+Сч+"C17").Текст;
		НомерРеестра 		= ExcelПрямыеКлиенты.Область("R"+Сч+"C18").Текст;
		
		Груженый = Истина;
		УсловияПеревозкиНазначение = ПредопределенноеЗначение("Перечисление.УсловияПеревозкиКТК.CY");
		УсловияПеревозки = ПредопределенноеЗначение("Перечисление.УсловияПеревозкиКТК.CY");	
		
		Если НЕ ЗначениеЗаполнено(НомерКТК) И ЗначениеЗаполнено(Размер) Тогда
			НомерТекущейСтроки = Сч-2;
			НомераСтрокЗаполненРазмерПустойКонтейнер.Добавить(НомерТекущейСтроки);
			Отказ = Истина;
		КонецЕсли;
		
		НомерКТКСсылка = РаботаСКонтейнерамиСервер.НайтиКТК(НомерКТК);
		
		Если НЕ ЗначениеЗаполнено(НомерКТКСсылка) Тогда
			НомерКТКСсылка = ПредопределенноеЗначение("Справочник.ТЕ.ПустаяСсылка");
		КонецЕсли;	
		
		ТипКТК = РаботаСКонтейнерамиСервер.ПолучитьТипИРазмер(НомерКТКСсылка);
		
		Если НЕ ЗначениеЗаполнено(ТипКТК.Тип) Тогда
			НайтиТипТЕПоНаименованию(Размер,ТипКТК);
		КонецЕсли;
		
		ПустойКонтейнерИЛИТипТЕ = (НомерКТКСсылка = ПредопределенноеЗначение("Справочник.ТЕ.ПустаяСсылка") ИЛИ ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(НомерКТКСсылка,"ТипТЕ") = ПредопределенноеЗначение("Справочник.ТипоразмерыТЕ.ПустаяСсылка"));
		
		Если РефрижераторныйКТК И ПустойКонтейнерИЛИТипТЕ И СтрДлина(Размер) > 2 И МассивРефрижераторныехТиповТЕ.Найти(ТипКТК.Тип) = Неопределено Тогда
			Размер = ПредопределенноеЗначение("Справочник.ТипоразмерыТЕ.ПустаяСсылка");
			НомерТекущейСтроки = Сч-2;					
			Сообщить("Указанный в строке " + СокрЛП(НомерТекущейСтроки) + " тип не соответствует типу рефрижераторного контейнера. Измените/удалите тип в поле «Размер КТК» либо снимите признак «Рефрижераторный КТК».");		
			Отказ = Истина;
		КонецЕсли;
		
		Если НЕ РефрижераторныйКТК И ПустойКонтейнерИЛИТипТЕ И ЭтоРефрижераторныйКТК(Лев(НомерКТК,4)) Тогда
			НомерТекущейСтроки = Сч-2;					
			Сообщить("Возможно, контейнер " + СокрЛП(НомерКТК) + " в строке " + СокрЛП(НомерТекущейСтроки) + " является рефрижераторным. Если это так, установите признак «Рефрижераторный КТК» при добавлении этого КТК в заявку.");		
			Отказ = Истина;	
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТипКТК.Тип) И ЗначениеЗаполнено(Размер) Тогда
			ТипКТК = РаботаСКонтейнерамиСервер.НайтиТипПоРазмеру(Размер,РефрижераторныйКТК,НомерКТК);	
		КонецЕсли;	
		
		Если НЕ ЗначениеЗаполнено(ТипКТК.Тип) И ЗначениеЗаполнено(НомерКТК) Тогда
			Отказ = Истина;
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(ТипКТК.Тип) И НЕ ЗначениеЗаполнено(НомерКТКСсылка) И ЗначениеЗаполнено(НомерКТК) И НЕ Отказ Тогда
			ЧислаМ = Новый Массив;
			Для ИндМ = 0 По 9 Цикл 
				ЧислаМ.Добавить(Строка(ИндМ)); 
			КонецЦикла;
			КонтрольныйЗнак = РаботаСКонтейнерамиСервер.ПолучитьКонтрольноеЧисло(Лев(НомерКТК,4), Сред(НомерКТК,5,6));	
			Если СтрДлина(НомерКТК) <> 11 
				ИЛИ КонтрольныйЗнак = "Неверно" ИЛИ ЧислаМ.Найти(Прав(НомерКТК,1)) = неопределено  
				ИЛИ (СтрДлина(НомерКТК) = 11 И НЕ Число(Прав(НомерКТК,1)) = КонтрольныйЗнак) Тогда
				
				Если НомерКТКСсылка = ПредопределенноеЗначение("Справочник.ТЕ.ПустаяСсылка") И ЗначениеЗаполнено(НомерКТК) Тогда
					Сообщить(НомерКТК + "Не удалось распознать номер КТК! Исправьте номер КТК в источнике");
					Отказ = Истина;
				КонецЕсли;
				
			Иначе
				НомерКТКСсылка = РаботаСКонтейнерамиСервер.СоздатьКТК(ВРег(НомерКТК), ТипКТК.Тип);	
			КонецЕсли;
		КонецЕсли;
		
		
		
		Если (ЗначениеЗаполнено(НомерКТКСсылка) ИЛИ ЗначениеЗаполнено(НомерКТК)) И НЕ ЗначениеЗаполнено(ТипКТК.Тип) И НЕ ЗначениеЗаполнено(Размер) Тогда
			НомерТекущейСтроки = Сч-2;
			НомераСтрокПустойТипВТЕИИсточнике.Добавить(НомерТекущейСтроки);
			Отказ = Истина;
		КонецЕсли;
		
		ДатаВ1С_ПодачаМашины = ЗагрузкаВнешнихИсточников_сервер.ПреобразоватьДатуВ1С(ДатаПодачиМашины, 5);
		ДатаВ1С = Дата(1,1,1);
		Если ЗначениеЗаполнено(ДатаВ1С_ПодачаМашины) Тогда
			ДатаВ1С = ДатаВ1С_ПодачаМашины - 24*3600;
		КонецЕсли;
		
		СтанцияОтпрСсылка = Локации_сервер.ПолучитьЛокациюПоНечеткомуПоиску(СтанцияОтпр);		
		ПунктНазнСсылка = Локации_сервер.ПолучитьЛокациюПоНечеткомуПоиску(ПунктНазн, Истина);
		СтанцияНазнСсылка = Локации_сервер.ПолучитьЛокациюПоНечеткомуПоиску(СтанцияНазн);
		ГрузополучательСсылка = КонтрагентыДоговоры_сервер.НайтиКонтрагентаПоНечеткомуУсловию(Грузополучатель);
		Если НЕ ЗначениеЗаполнено(ГрузополучательСсылка) Тогда
			ВесьСписокОшибок = ВесьСписокОшибок + "Контрагент не найден: " + Грузополучатель + Символы.ПС;
		КонецЕсли;
		
		Если НЕ РефрижераторныйКТК И ЗначениеЗаполнено(НомерКТКСсылка) И ЗначениеЗаполнено(ТипКТК.Тип) Тогда					
			ТипТЕИзКарточкиКонтейнера = РаботаСКонтейнерамиСервер.ПолучитьТипТЕ(НомерКТКСсылка);
			Если ТипТЕИзКарточкиКонтейнера <> Неопределено Тогда
				ТипКТК.Тип = ТипТЕИзКарточкиКонтейнера.ТипТЕ;
				ТипКТК.Размер = ТипТЕИзКарточкиКонтейнера.Размер; 
				ВведенРазмер = СтрДлина(Размер) = 2;
				ВведенТипоРаземер = СтрДлина(Размер) > 2;					
				Если (ВведенРазмер И Число(Размер) <> ТипТЕИзКарточкиКонтейнера.РазмерКТКЧисло)  ИЛИ (ВведенТипоРаземер И Размер <> ТипТЕИзКарточкиКонтейнера.ТипТЕНаименование) Тогда
					НомерТекущейСтроки = Сч-2;
					НомераСтрокНеСоответствуетТипоразмер.Добавить(НомерТекущейСтроки);					
				КонецЕсли;						
			КонецЕсли;					
		КонецЕсли;
		
		Если РефрижераторныйКТК И ЗначениеЗаполнено(НомерКТКСсылка) И ЗначениеЗаполнено(ТипКТК.Тип) Тогда				
			ТипТЕИзКТК = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(НомерКТКСсылка,"ТипТЕ");	
			Если ТипТЕИзКТК <> ПредопределенноеЗначение("Справочник.ТипоразмерыТЕ.ПустаяСсылка") Тогда
				Если НЕ ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(ТипТЕИзКТК,"Рефрижераторный") Тогда
					НомерТекущейСтроки = Сч-2;
					НомераСтрокНеСоответствуетТипоразмер.Добавить(НомерТекущейСтроки);			
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
		
		//ДИТ Шевченко А.В. 60130 15.11.22 //Убрал из структуры принадлежность КТК, добавил ВесНетто
		СтруктураДляРезультатаИПроверки = Новый Структура("НомерКТК,ТипКТК,Пломбы,ФИОВодителя,СтанцияОтправления,СтанцияНазначения,ПунктНазначения,Грузополучатель,КоличествоМест,ОсобыеОтметки,ИнструкцииПоСдачеПорожнего,ДатаПодачиАвтоПодПогрузку,РазмерКТК,НормативноеИспользование,УсловияПеревозки,УсловияПеревозкиНазначение,Груженый,НомерАвто,КодГруза,Груз,ДатаПодачиАвтоПодПогрузку,РеестрКлиента,НомерРелиза,ВесГрузаНетто",
		НомерКТКСсылка, ТипКТК.Тип, Пломбы, ФИОВодителя, СтанцияОтпрСсылка, СтанцияНазнСсылка, ПунктНазнСсылка, ГрузополучательСсылка, КоличествоМест, ОсобыеОтметки, Инструкция, ДатаВ1С, ТипКТК.Размер, НормаПользования, УсловияПеревозки, УсловияПеревозкиНазначение, Груженый, НомерАвто, ЕТСНГ, Груз, ДатаВ1С_ПодачаМашины, НомерРеестра, НомерРелиза, ВесГруза);
			
		Нарушение = ПроверитьФорматВВеденныхДанных(СтруктураДляРезультатаИПроверки,Сч-2);
		Если НЕ Нарушение Тогда
			Результат.Добавить(СтруктураДляРезультатаИПроверки);
		Иначе
			НомераСтрокСНарушениемФормата.Добавить(Сч-2);
		КонецЕсли;	
	
		Сч = Сч + 1;
		ПрочСтрока = ПолучитьЗначениеПоВсейСтроке(Сч);
	КонецЦикла;
	
	Если НомераСтрокЗаполненРазмерПустойКонтейнер.Количество() > 0 Тогда
		Сообщить(СтрШаблон("Не заполнен номер контейнера для указанного размера КТК в строке %1",СтрСоединить(НомераСтрокЗаполненРазмерПустойКонтейнер,",")));	
	КонецЕсли;
	
	Если НомераСтрокПустойТипВТЕИИсточнике.Количество() > 0 Тогда
		Сообщить(СтрШаблон("Не заполнен размер контейнера в строке %1",СтрСоединить(НомераСтрокПустойТипВТЕИИсточнике,",")));
	КонецЕсли;	
	
	Если Отказ Тогда
		Возврат Ответ;
	КонецЕсли;
	
	Если НомераСтрокНеСоответствуетТипоразмер.Количество() > 0 Тогда
		Структура = Новый Структура("Отказ,НомераСтрокСНарушениемФормата,Результат,ПоведениеПриЗаполнении",Отказ,НомераСтрокСНарушениемФормата,Результат, ПоведениеПриЗаполнении);
		ОпОп = Новый ОписаниеОповещения("ОбработкаВопросаЗакрытияНеСоответствуетТипоразмер", ЭтаФорма, Структура);
		Если НЕ РефрижераторныйКТК Тогда
			СообщениеВопроса = СтрШаблон("Введенные данные о типоразмере контейнера в строке %1 не соответствуют имеющимся в карточке контейнера. Будет перенесен типоразмер из карточки КТК.",СтрСоединить(НомераСтрокНеСоответствуетТипоразмер,","));
		Иначе
			СообщениеВопроса = СтрШаблон("Установленный признак Рефрижераторный КТК не соответствует типоразмеру из карточки КТК в строке %1. Будет перенесен типоразмер из карточки КТК.",СтрСоединить(НомераСтрокНеСоответствуетТипоразмер,","));
		КонецЕсли;
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить(КодВозвратаДиалога.Да,"Продолжить");
		СписокКнопок.Добавить(КодВозвратаДиалога.Нет,"Отмена");
		ПоказатьВопрос(ОпОп, СообщениеВопроса,СписокКнопок);   
		Отказ = Истина;
		Возврат Ответ;
	КонецЕсли; 
	
	Ответ.Результат = Результат;
	Ответ.НомераСтрокСНарушениемФормата = НомераСтрокСНарушениемФормата;
	
	Возврат Ответ;

КонецФункции 

