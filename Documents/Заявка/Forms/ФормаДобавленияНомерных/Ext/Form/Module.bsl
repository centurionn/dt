&НаКлиенте
Процедура КомандаДобавить(Команда)
	
	Если ПроверкаДанных() Тогда ВыполнитьЗакрытие(0); КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверкаДанных()
	
	Результат = Истина;
	ТаблицаОбработанных.Очистить();
	
	Сч = 2;
	ПрочСтрока = ТаблицаEXCEL.Область("R"+Сч+"C1").Текст;
	Пока ПрочСтрока <> "" Цикл
		
		НСтр = ТаблицаОбработанных.Добавить();
		НСтр.НомерКТК = ТаблицаEXCEL.Область("R"+Сч+"C1").Текст;
		НСтр.Размер = ТаблицаEXCEL.Область("R"+Сч+"C2").Текст;
		НСтр.ИсоТип = ТаблицаEXCEL.Область("R"+Сч+"C3").Текст;
		
		Сч = Сч + 1;
		ПрочСтрока = ТаблицаEXCEL.Область("R"+Сч+"C1").Текст;
	КонецЦикла;
	
	ВсеВПорядке = Истина;
	Для каждого Стр из ТаблицаОбработанных Цикл
		
		Если РаботаСКонтейнерамиСервер.НайтиКТК(Стр.НомерКТК) = неопределено И НЕ ЗначениеЗаполнено(Стр.Размер) И НЕ ЗначениеЗаполнено(Стр.ИсоТип) Тогда
			Сообщить("Для контейнера " + Стр.номерКТК + " не указан тип и не найдена запись в программе. Требуется указать тип или размер!");
			ВсеВПорядке = ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Сч = 2;
	ПрочСтрока = ТаблицаEXCEL1.Область("R"+Сч+"C1").Текст;
	Пока ПрочСтрока <> "" Цикл
		
		НСтр = ТаблицаОбработанных.Добавить();
		НСтр.НомерВагона = ТаблицаEXCEL1.Область("R"+Сч+"C1").Текст;
		
		Сч = Сч + 1;
		ПрочСтрока = ТаблицаEXCEL1.Область("R"+Сч+"C1").Текст;
	КонецЦикла;

	Возврат ВсеВПорядке;
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьЗакрытие(Поведение)
	
	СтруктураКТК = Новый Массив;
	
	Для каждого Стр из ТаблицаОбработанных Цикл
		СтруктураКТК.Добавить(Новый Структура("КТК, Тип, Размер, НомерВагона", Стр.НомерКТК, Стр.ИсоТип, Стр.Размер, Стр.НомерВагона));
	КонецЦикла;
	
	Закрыть(Новый Структура("СтруктураКТК, Поведение", СтруктураКТК, Поведение));
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПерезаполнить(Команда)
	
	Если ПроверкаДанных() Тогда ВыполнитьЗакрытие(1); КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ЭтоВагоны") Тогда
		Элементы.Группа5.ТекущаяСтраница = Элементы.Группа7; 
		// ДИТ US 76619 ТА 76735 Сержантова А.С. Начало: 16.11.2023
		Элементы.ЗаполнитьПустыеСтроки.Видимость = Ложь;  
		Элементы.ЗаполнитьПустыеСтрокиРасширенный.Видимость = Ложь;  
		Элементы.КомандаДобавитьИДополнить.КнопкаПоУмолчанию = Истина;
		// ДИТ US 76619 ТА 76735 Сержантова А.С. Конец: 16.11.2023
	КонецЕсли;
	

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры
