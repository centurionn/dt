	РаботаЧерезАРМКТК = Константы.ИспользоватьАРМКТК.Получить();
	
	// + Состояния
	ФонТекущегоСостояния = ЦветаСтиля.ФонТекущегоСостояния;
	ФонВыполненногоСостояния = ЦветаСтиля.ФонВыполненногоСостояния;
	ФонБудущегоСостояния = ЦветаСтиля.ФонБудущегоСостояния;
