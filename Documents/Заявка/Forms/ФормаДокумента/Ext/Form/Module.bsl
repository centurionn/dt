&НаСервереБезКонтекста
Функция КонтейнерЗаявкиВключенВСделку(Заявка, Контейнер, ИдентификаторСтрокиЗаявки)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СделкаСвязьУчетныхЕдиниц.Ссылка КАК Сделка,
	|	СделкаСвязьУчетныхЕдиниц.Ссылка.Представление КАК СделкаПредставление
	|ИЗ
	|	Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|		ПО ЗаявкаСоставУслуги.Ссылка = СделкаСвязьУчетныхЕдиниц.Заявка
	|			И ЗаявкаСоставУслуги.НомерКТК = СделкаСвязьУчетныхЕдиниц.Контейнер
	|ГДЕ
	|	ЗаявкаСоставУслуги.Ссылка = &Заявка
	|	И ЗаявкаСоставУслуги.НомерКТК = &Контейнер
	|	И ЗаявкаСоставУслуги.ГУИДСтроки = &ИдентификаторСтрокиЗаявки
	|	И НЕ СделкаСвязьУчетныхЕдиниц.Ссылка.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Контейнер", Контейнер);
	Запрос.УстановитьПараметр("Заявка", Заявка);
	Запрос.УстановитьПараметр("ИдентификаторСтрокиЗаявки", ИдентификаторСтрокиЗаявки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();
	
КонецФункции

