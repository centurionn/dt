Функция ПолучитьСпискиКонтейнеров()
	
	СтруктураПоиска = Новый Структура("ПринадлежностьТЕ, Релиз, ПеренесенВЗаявку", Перечисления.ПринадлежностьТЕ.КТЕвросиба, Неопределено, Документы.Заявка.ПустаяСсылка());
	СписокКТКДляПроверкиРаспределенияНеопределено = Объект.СоставУслуги.Выгрузить(СтруктураПоиска,"НомерКТК");
	
	СтруктураПоиска = Новый Структура("ПринадлежностьТЕ, Релиз, ПеренесенВЗаявку", Перечисления.ПринадлежностьТЕ.КТЕвросиба, Документы.РелизКлиента.ПустаяСсылка(), Документы.Заявка.ПустаяСсылка());
	СписокКТКДляПроверкиРаспределенияПустаяСсылка = Объект.СоставУслуги.Выгрузить(СтруктураПоиска,"НомерКТК"); 	

	
	МассивКткУслуг = Новый Массив;
	Для Каждого СтрокаМассива Из СписокКТКДляПроверкиРаспределенияНеопределено Цикл
		Если ЗначениеЗаполнено(СтрокаМассива.НомерКТК) Тогда
			МассивКткУслуг.Добавить(СтрокаМассива.НомерКТК);
		КонецЕсли;
	КонецЦикла; 	
	Для Каждого СтрокаМассива Из СписокКТКДляПроверкиРаспределенияПустаяСсылка Цикл
		Если ЗначениеЗаполнено(СтрокаМассива.НомерКТК) Тогда
			МассивКткУслуг.Добавить(СтрокаМассива.НомерКТК);
		КонецЕсли;
	КонецЦикла;
		
	КонтейнерыИзЗапроса = Объект.СписокЗапросНаКТК.Выгрузить(,"СписокКТК");	
	МассивКонтейнеров = Новый Массив;
	Для Каждого СтрокаКТК Из КонтейнерыИзЗапроса Цикл
		МассивТЕ = СтрРазделить(ОбщегоНазначенияВызовСервера.ПривестиСтрокуУчетныхЕдиницКТребуемомуФормату(СтрокаКТК.СписокКТК), ";", Ложь);
		Для Каждого Стр из МассивТЕ Цикл
			Если ТипЗнч(Стр) = Тип("Строка") Тогда
				МассивКонтейнеров.Добавить(РаботаСКонтейнерамиСервер.НайтиКТК(Стр)); 
			Иначе
				МассивКонтейнеров.Добавить(Стр);
			КонецЕсли;			
		КонецЦикла
	КонецЦикла;
	
	Возврат Новый Структура("КткУслуг, КткИзЗапросаНаКТК", МассивКткУслуг, МассивКонтейнеров) 
	
КонецФункции

&НаКлиенте
Процедура ОбработкаОтветаПользователя(ОтветПользователя = Неопределено, ДопПараметры = Неопределено)Экспорт 
	
	Если ОтветПользователя = Неопределено Тогда Возврат; КонецЕсли;
	
	НераспределенныеКТК = ДопПараметры.НераспределенныеКТК;
	
	Если ОтветПользователя = КодВозвратаДиалога.Таймаут Тогда 
		ОбщегоНазначенияКлиент.СообщитьПользователю("Вариант распределения ктк не был выбран.");				
	ИначеЕсли ОтветПользователя = КодВозвратаДиалога.Нет Тогда
		МассивыКТК = ПолучитьСпискиКонтейнеров();
		ФормированиеСтрокЗапросаКТК(НераспределенныеКТК, Ложь);
		ОбщегоНазначенияКлиент.СообщитьПользователю("Нераспределенные ктк были разнесены в новые строки запроса на ктк автоматически. Проверьте заполнение обязательных реквизитов.");
		ЭтаФорма.Модифицированность = Истина;
	ИначеЕсли ОтветПользователя = КодВозвратаДиалога.Да Тогда
		МассивыКТК = ПолучитьСпискиКонтейнеров();
		ФормированиеСтрокЗапросаКТК(НераспределенныеКТК, Истина);
		ОбщегоНазначенияКлиент.СообщитьПользователю("Нераспределенные ктк были добавлены в существующие строки запроса на ктк автоматически. Проверьте заполнение обязательных реквизитов.");
		ЭтаФорма.Модифицированность = Истина;
	ИначеЕсли ОтветПользователя = КодВозвратаДиалога.Отмена Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Действие отменено. Контейнеры не были распределены по запросам на ктк.");				
	КонецЕсли;	
		
КонецПроцедуры	

&НаКлиенте
Процедура ОбработкаОтветаПользователяПоЗаполнениюЗапроса(ОтветПользователя = Неопределено, ДопПараметры = Неопределено) Экспорт
	
	Если ОтветПользователя = Неопределено Тогда Возврат; КонецЕсли; 
	Если ОтветПользователя = КодВозвратаДиалога.ОК Тогда 
		Объект.СписокЗапросНаКТК.Очистить();
		ФормированиеСтрокЗапросаКТК();
	ИначеЕсли ОтветПользователя = КодВозвратаДиалога.Отмена Тогда
		Объект.ЗапросНаКТК = Не Объект.ЗапросНаКТК;
			НастроитьВидимостьВкладкиЗапросНаКТК();
		    НастроитьВидимостьКомандЗаполнения(); 
	КонецЕсли;	
		
КонецПроцедуры	
