	ВидыСобственностиСобственногоКТК.ЗагрузитьЗначения(АРМ_Сервер.ПолучитьВидСобственностиПоПринадлежности(Перечисления.ПринадлежностьТЕ.КТЕвросиба));
	ВидыСобственностиКлиентскогоКТК.ЗагрузитьЗначения(АРМ_Сервер.ПолучитьВидСобственностиПоПринадлежности(Перечисления.ПринадлежностьТЕ.КТКлиента));
	
	РазрешитьВыборПроизвольнойКалькуляции = РазрешитьВыборПроизвольнойКалькуляции_функция(Объект.ВидПеревозки);
	ОбновитьОтображениеКолонокТЧ();
	ОбновитьСВВиТДТ_Сервер();
	
	//Евросиб Каблов 01.07.2021 ( Ticket#0228545
	ЗаполнитьНомераПоездовКлиентов();
	//Евросиб Каблов 01.07.2021 )
	
	// Евросиб Фролов (16.11.2021 TASK№ №41969
	// Список полей ТЧ "Список запрос на КТК", которые запрещено менять
	// пользователям с ролью "(dc) Работа с заявками".
	УправлениеФормой();
	// Евросиб Фролов)
	
	// Евросиб Фролов (28.04.2022 Task №50233
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	// Евросиб Фролов)
	
	//ДИТ Шевченко А.В. TASK 51973 14.06.2022 -Начало
