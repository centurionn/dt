		//Евросиб Каблов 01.07.2021 ( Ticket#0228545
		//Евросиб Каблов 27.01.2026 ( #126739
		//НСТР.НомерПоездаКлиента = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(НСТР.Рейс, "НомерПоездаКлиента");
		//Евросиб Каблов 27.01.2026 ) #126739
		//Евросиб Каблов 01.07.2021 )
		
		//ДИТ Шевченко А.В. 57147 28.12.2022 -начало
		//Евросиб Каблов 27.01.2026 ( #126739
		//Если ТипЗнч(Параметр1) = Тип("СправочникСсылка.РейсыЖД") И Объект.Контрагент = ПолучитьКонтрагентаСибур() Тогда
		//	РейсОтменен = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(Параметр1,"РейсОтменен");
		//	Если НЕ РейсОтменен Тогда
		Если ТипЗнч(Параметр1) = Тип("СправочникСсылка.РейсыЖД") Тогда
			РеквизитыРейса = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(НСТР.Рейс, "НомерПоездаКлиента,РейсОтменен,ПричинаОтмены_DX");
			РейсОтменен = РеквизитыРейса.РейсОтменен;
			НСТР.РейсОтменен = РейсОтменен;
			НСТР.ПричинаОтмены = РеквизитыРейса.ПричинаОтмены_DX;
			Если РейсОтменен Тогда
				НСТР.ТекстРейсОтменен = "Рейс отменен!";
				ВывестиСообщениеПоОтмененномуРейсу(НСТР);
			Иначе
				НСТР.ТекстРейсОтменен = "";
				Если Объект.Контрагент = ПолучитьКонтрагентаСибур() Тогда
