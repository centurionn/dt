&НаСервере
Процедура ПроверитьПлановыеЛокацииНаНаличиеВКалькуляции()
	// Евросиб US 99390 TA 108801 Рыбьяков К.А. 21.06.2025 ((
	МассивКалькуляций = Новый Массив;
	
	Для Каждого Строка Из Объект.СоставУслуги Цикл
		Если ЗначениеЗаполнено(Строка.Калькуляция) Тогда
			МассивКалькуляций.Добавить(Строка.Калькуляция);
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КалькуляцияСписокСтанцийНазначения.Станция КАК Станция,
	               |	КалькуляцияСписокСтанцийНазначения.Ссылка КАК Калькуляция
	               |ИЗ
	               |	Документ.Калькуляция.СписокСтанцийНазначения КАК КалькуляцияСписокСтанцийНазначения
	               |ГДЕ
	               |	КалькуляцияСписокСтанцийНазначения.Ссылка В(&Калькуляция)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ДокументКалькуляция.Ссылка.Суша_ПунктНазначения,
	               |	ДокументКалькуляция.Ссылка
	               |ИЗ
	               |	Документ.Калькуляция КАК ДокументКалькуляция
	               |ГДЕ
	               |	ДокументКалькуляция.Ссылка В(&Калькуляция)";
	
	Запрос.УстановитьПараметр("Калькуляция", МассивКалькуляций);
	
	Выгрузка = Запрос.Выполнить().Выгрузить();
	
	МассивСтрок = Новый Массив;
	
	Для Каждого Строка Из Объект.СоставУслуги Цикл
		Если ЗначениеЗаполнено(Строка.Калькуляция) 
				И ЗначениеЗаполнено(Строка.ПлановаяЛокацияСдачиКТК) 
				И Не ЗначениеЗаполнено(Строка.ПеренесенВЗаявку) Тогда
			Отбор = Новый Структура();
			Отбор.Вставить("Калькуляция", Строка.Калькуляция);
			Отбор.Вставить("Станция", Строка.ПлановаяЛокацияСдачиКТК);
			НайденныеСтроки = Выгрузка.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() = 0 Тогда
				МассивСтрок.Добавить(Строка.НомерСтроки);
				Строка.НеСовпадаетПлановаяЛокация = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	НомераСтрок = СтрСоединить(МассивСтрок, ", ");
	Если МассивСтрок.Количество() > 0 Тогда
		Текст = НСтр("ru = 'В строке " + НомераСтрок + ", калькуляции не соответствуют плановым локациям сдачи КТК. Необходимо или заменить калькуляцию или исправить план.локац.сдачи. Для подбора Калькуляции воспользуйтесь кнопкой ""Подобрать калькуляцию.""'");
		ОбщегоНазначения.СообщитьПользователю(Текст);
	КонецЕсли;
	// Евросиб Рыбьяков К.А. 21.06.2025 ))
КонецПроцедуры

