&НаКлиенте
Процедура УстановитьСтанциюДату(ТекСтр)
	Если ТекСтр.Автоперевозка = ПредопределенноеЗначение("Перечисление.ВариантыАвтоперевозки.НеТребуется") Тогда
		ТекСтр.СтанцияНазначенияПоЖД = СтанцияИзРейса;
		ТекСтр.ДатаОтправленияПоЖДПлан = ДатаОтправленияИзРейса; 
	Иначе 
		ТекСтр.СтанцияНазначенияПоЖД = ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
		ТекСтр.ДатаОтправленияПоЖДПлан = Дата(1,1,1);
	КонецЕсли;	
КонецПроцедуры	
// ДИТ US 58592 TA 60724 Евсенкин М.А. Конец: 29.12.2022

// ДИТ US 58592 TA 60724 Евсенкин М.А. Начало: 29.12.2022
&НаКлиенте
Процедура СтанцияДата()
	Если Объект.ПереченьРейсов.Количество() > 0 Тогда 
		мРейс = Объект.ПереченьРейсов[0].Рейс;
		Если ТипЗнч(мРейс) = Тип("СправочникСсылка.РейсыЖД") Тогда 
			СтруктураРеквизитов = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(мРейс,"ПунктНазначения,ДатаОтправления");
			СтанцияИзРейса = СтруктураРеквизитов.ПунктНазначения;
			ДатаОтправленияИзРейса = СтруктураРеквизитов.ДатаОтправления; 
		КонецЕсли; 
	Иначе 
		СтанцияИзРейса = ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
		ДатаОтправленияИзРейса = Дата(1,1,1); 
	КонецЕсли;  
КонецПроцедуры	
