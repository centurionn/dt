// Процедура - Открыть форму нового заказа на автоперевозку
//
// Параметры:
//  ПерваяМиля	 - Булево - Если Истина первая миля, если Ложь последняя миля
//
&НаКлиенте
Процедура ОткрытьФормуНовогоЗаказаНаАвтоперевозку(ЭтапПеревозкиП)
	
	// ДИТ US 78243 ТА 80825 Сержантова А.С. Начало: 08.02.2024 
	//для первой мили проверяем есть ли строки, которые имеют значение "Силами Евросиб" в способе автоперевозки 
	//И имеют принадлежность = "КТК Евросиб" И имеют не заполненное поле "Релиз" ссылкой на документ релиз клиента
	Если ЭтапПеревозкиП = ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПерваяМиля") Тогда
		НомераСтрокБезРелиза = ОпределитьСтрокиПоУсловиюПустогоРелиза(); 
		Если НомераСтрокБезРелиза.Количество() > 0 Тогда
			ПараметрыВопроса = Новый Структура("ЭтапПеревозки",ЭтапПеревозкиП);
		    Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОСоставеСтрокВЗаявкеНаАвто", ЭтотОбъект, ПараметрыВопроса);
			Если НомераСтрокБезРелиза.Количество() = 1 Тогда
				ТекстВопроса = СтрШаблон("Строка №%1 в заявке не связана с релизом клиента.
				|Продолжить перенос таких строк в запрос на автоперевозку?", НомераСтрокБезРелиза[0]);
			Иначе
			    ТекстВопроса = СтрШаблон("Строки №%1 в заявке не связаны с релизом клиента.
				|Продолжить перенос таких строк в запрос на автоперевозку?", СтрСоединить(НомераСтрокБезРелиза, ", "));
			КонецЕсли;                        
			КнопкиОтветов = Новый СписокЗначений;
			КнопкиОтветов.Добавить(КодВозвратаДиалога.Да, "Продолжить");
			КнопкиОтветов.Добавить(КодВозвратаДиалога.Отмена, "Отмена");
			ПоказатьВопрос(Оповещение, ТекстВопроса, КнопкиОтветов, 0); 
		Иначе
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("СоздатьНаОснованииЗаявки",Объект.Ссылка);
			ПараметрыФормы.Вставить("ЭтапПеревозки",ЭтапПеревозкиП);
			ПараметрыФормы.Вставить("ПростойАлгоритмЗаполнения", Ложь);
			ОткрытьФорму("Документ.ЗапросНаАвтоперевозку.Форма.ФормаДокумента",ПараметрыФормы,ЭтаФорма);
		КонецЕсли;
	Иначе
	// ДИТ US 78243 ТА 80825 Сержантова А.С. Конец: 08.02.2024
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("СоздатьНаОснованииЗаявки",Объект.Ссылка);
		ПараметрыФормы.Вставить("ЭтапПеревозки",ЭтапПеревозкиП);
		// ДИТ US 78243 ТА 80825 Сержантова А.С. Начало: 08.02.2024
		// Было:
		////ДИТ Шевченко А.В. 57808 22.09.2022 -начало
		//ПараметрыФормы.Вставить("ПростойАлгоритмЗаполнения",ЭтапПеревозкиП = ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПоследняяМиля") и НЕ ЗначениеЗаполнено(ЗапросПерваяМиля));
		////ДИТ Шевченко А.В. 57808 22.09.2022 -конец  
		//Стало:
		ПараметрыФормы.Вставить("ПростойАлгоритмЗаполнения",ЭтапПеревозкиП = ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПоследняяМиля"));
		// ДИТ US 78243 ТА 80825 Сержантова А.С. Конец: 08.02.2024
		ОткрытьФорму("Документ.ЗапросНаАвтоперевозку.Форма.ФормаДокумента",ПараметрыФормы,ЭтаФорма);    
	// ДИТ US 78243 ТА 80825 Сержантова А.С. Начало: 08.02.2024
	КонецЕсли; 
	// ДИТ US 78243 ТА 80825 Сержантова А.С. Конец: 08.02.2024
	
КонецПроцедуры	  

// ДИТ US 78243 ТА 80825 Сержантова А.С. 08.02.2024
&НаСервере
Функция ОпределитьСтрокиПоУсловиюПустогоРелиза()
	
	Результат = Новый Массив;
	ТаблицаДляПроверки = Объект.СоставУслуги.Выгрузить(,"НомерСтроки, ПерваяМиля, ПринадлежностьТЕ, Релиз");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СоставУслуги.НомерСтроки КАК НомерСтроки,
		|	СоставУслуги.ПерваяМиля КАК ПерваяМиля,
		|	СоставУслуги.ПринадлежностьТЕ КАК ПринадлежностьТЕ,
		|	СоставУслуги.Релиз КАК Релиз
		|ПОМЕСТИТЬ ВТ_ИсходныеДанные
		|ИЗ
		|	&СоставУслуги КАК СоставУслуги
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ различные
		|	ВТ_ИсходныеДанные.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	ВТ_ИсходныеДанные КАК ВТ_ИсходныеДанные
		|ГДЕ
		|	ВТ_ИсходныеДанные.ПерваяМиля = ЗНАЧЕНИЕ(Перечисление.ВариантыАвтоперевозки.СиламиЕвросиб)
		|	И ВТ_ИсходныеДанные.ПринадлежностьТЕ = ЗНАЧЕНИЕ(Перечисление.ПринадлежностьТЕ.КТЕвросиба)
		|	И ВТ_ИсходныеДанные.Релиз В (ЗНАЧЕНИЕ(Документ.РелизКлиента.ПустаяСсылка), ЗНАЧЕНИЕ(Документ.РелизСобственника.ПустаяСсылка), Неопределено)";
	Запрос.УстановитьПараметр("СоставУслуги", ТаблицаДляПроверки); 
	РезультатЗапроса = Запрос.Выполнить();
	Если не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Выборка.НомерСтроки);			
		КонецЦикла;
	КонецЕсли;   
	
	Возврат Результат;

КонецФункции

