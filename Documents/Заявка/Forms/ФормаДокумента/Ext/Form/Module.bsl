// ДИТ US 76619 ТА 76735 Сержантова А.С. 07.11.2023  
&НаКлиенте
Асинх Процедура ЗаполнитьПустыеСтрокиНомерамиКТКИзБуфера(МассивИдентификаторов, ДанныеВставки)   
	
	ИменаЗаполненныхПолей = "";
	ДанныеИзКалькуляции = Неопределено;	 
	КоличествоВставляемыхКТК = ДанныеВставки.Количество();
	
	Если ДанныеВставки[0].Количество() > 5 Тогда //Расширенный список
		СвязатьКТКСоСтоками(, Ложь);
	Иначе     
		
		Рез = ПолучитьКалькуляциюИУслугуПоУмолчанию(Объект.ПСЦ);
		Если Рез.Количество() = 1 Тогда
			КалькуляцияПоУмолчанию = Рез[0].Калькуляция;  
		Иначе
			КалькуляцияПоУмолчанию = Неопределено;
		КонецЕсли;

		Если КалькуляцияПоУмолчанию <> Неопределено Тогда 
			ИменаПолейИзКалькуляции = Новый Массив;
			ИменаПолейИзКалькуляции = СтрРазделить("УсловияПеревозки,УсловияПеревозкиНазначение,ПунктОтправления,СтанцияОтправления,ПунктНазначения,СтанцияНазначения", ",");
			ДанныеИзКалькуляции = ПолучитьДанныеКалькуляции(КалькуляцияПоУмолчанию);
			ЗаполненныеПоля = Новый Массив;
			Для Каждого ИмяПоля из ИменаПолейИзКалькуляции Цикл
				ЗначениеПоля = Неопределено;
				Если ДанныеИзКалькуляции.Свойство(ИмяПоля, ЗначениеПоля) И ЗначениеЗаполнено(ЗначениеПоля) Тогда 
					ЗаполненныеПоля.Добавить(ИмяПоля); 
				КонецЕсли; 
			КонецЦикла;
			ИменаЗаполненныхПолей = СтрСоединить(ЗаполненныеПоля, ",");
		КонецЕсли;  
	КонецЕсли;   
	
	МассивИдентификаторовДляСортировки = Новый СписокЗначений;
	МассивИдентификаторовДляСортировки.ЗагрузитьЗначения(МассивИдентификаторов);
	МассивИдентификаторовДляСортировки.СортироватьПоЗначению(НаправлениеСортировки.Возр);  
	МассивИдентификаторов = МассивИдентификаторовДляСортировки.ВыгрузитьЗначения();

    НомерСтроки = 0;  
	ОтветПользователя_Перезаполнить = Неопределено;
	Для каждого ИдентификаторСтроки Из МассивИдентификаторов Цикл 
		Если КоличествоВставляемыхКТК = НомерСтроки Тогда // больше нет контейнеров для вставки
			Прервать;
		КонецЕсли; 
		
		СтрокаУслуги = Объект.СоставУслуги.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если ЗначениеЗаполнено(СтрокаУслуги.НомерКТК) Тогда
			//не задавали вопрос
			Если ОтветПользователя_Перезаполнить = Неопределено Тогда
				// здесь надо спросить у пользователя перезаполнить или пропустить?  
				КнопкиВопроса = Новый СписокЗначений();
				КнопкиВопроса.Добавить(КодВозвратаДиалога.Нет, "Пропустить");
				КнопкиВопроса.Добавить(КодВозвратаДиалога.Да, "Перезаполнить");  
				КнопкиВопроса.Добавить(КодВозвратаДиалога.ОК, "Перезаполнить все" + Символы.ПС + "выделенные строки");
				КнопкиВопроса.Добавить(КодВозвратаДиалога.Отмена, "Отмена");
				ТекстВопроса = СтрШаблон("Поле ""Номер КТК"" заполнено в строке № %1." +
							Символы.ПС+ "Перезаполнить номер контейнера в указанной строке" +
							Символы.ПС+ "или пропустить её?",
				ИдентификаторСтроки + 1);    
				Обещание = Ждать ВопросАсинх(ТекстВопроса, КнопкиВопроса,,,"В строке уже заполнен КТК"); 
				Если Обещание = КодВозвратаДиалога.Нет Тогда      //Пропускаем одну строку
					Продолжить;
				ИначеЕсли Обещание = КодВозвратаДиалога.Да Тогда  //Перезаполнить одну строку
					СтрокаВставки = ДанныеВставки[НомерСтроки];
					ЗаполнитьСтрокуДаннымиВставкиИзБуфера(ИдентификаторСтроки, СтрокаВставки, КалькуляцияПоУмолчанию, ДанныеИзКалькуляции, ИменаЗаполненныхПолей); 
					НомерСтроки = НомерСтроки + 1; 
					Продолжить;
				ИначеЕсли Обещание = КодВозвратаДиалога.Отмена Тогда //Прерываем последующее исполнение	
					Прервать;  
				ИначеЕсли Обещание = КодВозвратаДиалога.ОК Тогда  //Перезаполнить все выделенные строки
					СтрокаВставки = ДанныеВставки[НомерСтроки];
					ЗаполнитьСтрокуДаннымиВставкиИзБуфера(ИдентификаторСтроки, СтрокаВставки, КалькуляцияПоУмолчанию, ДанныеИзКалькуляции, ИменаЗаполненныхПолей);
					НомерСтроки = НомерСтроки + 1;  
					ОтветПользователя_Перезаполнить = КодВозвратаДиалога.ОК;
					Продолжить;
				КонецЕсли; 
			//вопрос был задан ранее	
			Иначе
				Если ОтветПользователя_Перезаполнить = КодВозвратаДиалога.ОК Тогда
					СтрокаВставки = ДанныеВставки[НомерСтроки];
					ЗаполнитьСтрокуДаннымиВставкиИзБуфера(ИдентификаторСтроки, СтрокаВставки, КалькуляцияПоУмолчанию, ДанныеИзКалькуляции, ИменаЗаполненныхПолей); 
					НомерСтроки = НомерСтроки + 1; 
					Продолжить;
	            КонецЕсли;
			КонецЕсли;
		Иначе	
			СтрокаВставки = ДанныеВставки[НомерСтроки];	
			ЗаполнитьСтрокуДаннымиВставкиИзБуфера(ИдентификаторСтроки, СтрокаВставки, КалькуляцияПоУмолчанию, ДанныеИзКалькуляции, ИменаЗаполненныхПолей); 
			НомерСтроки = НомерСтроки + 1;
		КонецЕсли;
	КонецЦикла;
	
	// ДИТ US 76935 ТА 78649 Сержантова А.С. Начало: 26.12.2023
	//ОбновитьДанныеКлючаНаФорме();  
	// ДИТ US 76935 ТА 78649 Сержантова А.С. Конец: 26.12.2023
	Для Каждого Стр Из Объект.СоставУслуги Цикл 
		Стр.ВерсияКлюча = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(Стр.КлючАналитикиПеревозки,"ВерсияДанных");
	КонецЦикла;	  
	ВидимостьКолонокПринадлежности(); 
	
	ОповеститьОбИзменении(Тип("СправочникСсылка.КлючиАналитикиПеревозки")); 
	
КонецПроцедуры  

// ДИТ US 76619 ТА 76735 Сержантова А.С. 07.11.2023 
&НаКлиенте
Процедура ЗаполнитьСтрокуДаннымиВставкиИзБуфера(ИдентификаторСтроки, СтрокаВставки, КалькуляцияПоУмолчанию, ДанныеИзКалькуляции, ИменаЗаполненныхПолей) 
	
	СтрокаУслуги = Объект.СоставУслуги.НайтиПоИдентификатору(ИдентификаторСтроки);     
	
	Если СтрокаВставки.Количество() > 5 Тогда
	    // расширенный список  
		СписокПереносимыхПолей = Новый массив;
		Для каждого СвойствоВставки из СтрокаВставки Цикл
			Если ЗначениеЗаполнено(СвойствоВставки.Значение) И СвойствоВставки.Ключ <> "НомерРелиза" Тогда
				СписокПереносимыхПолей.Добавить(СвойствоВставки.Ключ);
			КонецЕсли;
		КонецЦикла;
		ЗаполнитьЗначенияСвойств(СтрокаУслуги, СтрокаВставки, СтрСоединить(СписокПереносимыхПолей, ","));
	Иначе
		// Простой список
		Тип = неопределено;
		Если ЗначениеЗаполнено(СтрокаВставки.Тип) Тогда
			Тип = НайтиТип(СтрокаВставки.Тип);
		ИначеЕсли ЗначениеЗаполнено(СтрокаВставки.Размер) Тогда
			Рез = РаботаСКонтейнерамиСервер.НайтиТипПоРазмеру(СтрокаВставки.Размер);
			Тип = Рез.Тип;
		КонецЕсли;    
		
		Если КалькуляцияПоУмолчанию <> Неопределено Тогда 
			Если ЗначениеЗаполнено(Объект.ПСЦ) Тогда 
				СтрокаУслуги.ПСЦ = Объект.ПСЦ;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(СтрокаУслуги, ДанныеИзКалькуляции, ИменаЗаполненныхПолей);
		КонецЕсли;
		
		СтрокаУслуги.НомерКТК = СоздатьКТК(СтрокаВставки.КТК, Тип);
		РезПоТипам = РаботаСКонтейнерамиСервер.ПолучитьТипИРазмер(СтрокаУслуги.НомерКТК);
		СтрокаУслуги.РазмерКТК = РезПоТипам.Размер;
		СтрокаУслуги.ТипКТК = РезПоТипам.Тип;  
		СтрокаУслуги.Услуга = УслугаПоУмолчанию;   
		Если не ЗначениеЗаполнено(СтрокаУслуги.Калькуляция) Тогда
			СтрокаУслуги.Калькуляция = КалькуляцияПоУмолчанию;
		КонецЕсли;
	КонецЕсли;
	
	НайтиКлючАналитикиПеревозкиКлиент(СтрокаУслуги); 
	// ДИТ US 76659 ТА 77825 Сержантова А.С. Начало: 26.02.2024
	// Было:
	//ЗаполнитьСвязанныеПоляПринадлежностьТЕ(ИдентификаторСтроки);
	// Стало:
	ЗаполнитьСобственностьПриВыбореКонтейнера(ИдентификаторСтроки);
	// ДИТ US 76659 ТА 77825 Сержантова А.С. Конец: 26.02.2024  
	
