    ПоказатьВопрос(ОпОп,"В Документе есть не разнесенные по запросам на ктк контейнеры из услуг.
									|Выберите способ разнесения", СписокКнопок, 20, КодВозвратаДиалога.Да,, КодВозвратаДиалога.Отмена);
	
