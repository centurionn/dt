&НаКлиенте
Процедура ТранспортныеСредстваПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	// Евросиб Фролов (06.12.2021 TASK№ №42618, РелизКлиента
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо записать документ");
		Возврат;
	КонецЕсли;	
	
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	Если НоваяСтрока Тогда
		ТекущиеДанныеЗапроса = Элементы.СписокЗапросНаКТК.ТекущиеДанные;
		ТекущаяСтрока.ИдентификаторСтрокиЗапроса = ТекущиеДанныеЗапроса.ИдентификаторСтроки;
		//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -Начало
		//ТекущаяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		Если ЗначениеЗаполнено(ТекущиеДанныеЗапроса.РелизКлиента) Тогда
			МассивКлючей = Новый Массив;
			Для Каждого Стр Из Объект.ТранспортныеСредства Цикл
				МассивКлючей.Добавить(Стр.КлючАналитикиПеревозки);
			КонецЦикла;	
			СтруктураОтвет = ПолучитьКлючиИзРелизаКлиента(ТекущиеДанныеЗапроса.РелизКлиента,МассивКлючей,ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПерваяМиля"));
			
			Если СтруктураОтвет.ПустойКлюч Тогда
				Ответ = СоздатьКлючАналитики(Объект.Ссылка);
				ТекущаяСтрока.ВерсияКлюча = Ответ.ВерсияДанных;
				ТекущаяСтрока.КлючАналитикиПеревозки = Ответ.КлючАналитикиПеревозки;
			Иначе
				ЗаполнитьЗначенияСвойств(ТекущаяСтрока,СтруктураОтвет.КлючРелиза[0]);
			КонецЕсли;	
		Иначе
			// ДИТ US 78243 ТА 80591 Сержантова А.С. Начало: 07.02.2024 - если в ТЧ по последней миле уже есть строки с ключом, то берем их, если их не использовали ранее
			// Было:
			//Ответ = СоздатьКлючАналитики(Объект.Ссылка);
			//ТекущаяСтрока.ВерсияКлюча = Ответ.ВерсияДанных;
			//ТекущаяСтрока.КлючАналитикиПеревозки = Ответ.КлючАналитикиПеревозки;  
			////Стало:
			Если Объект.ТранспортныеСредстваПоследняяМиля.Количество() 
                // ДИТ BUG 82599 ТА 82600 Сержантова А.С. Начало: 21.03.2024
				или Объект.СоставУслуги.Количество() Тогда 
				//КлючИзПоследнейМили = Неопределено;   - переименовала "КлючИзПоследнейМили" на "КлючДляПодбора"
				КлючДляПодбора = Неопределено;
				// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Конец: 21.03.2024 
				СтрокиПоследнейМилиДляПодбора = Объект.ТранспортныеСредстваПоследняяМиля.НайтиСтроки(
													Новый Структура("ИдентификаторСтрокиЗапроса", ТекущаяСтрока.ИдентификаторСтрокиЗапроса));
				Для каждого СтрокаПоследнейМили Из СтрокиПоследнейМилиДляПодбора Цикл   
					СтруктураПоиска = Новый Структура("КлючАналитикиПеревозки, ИдентификаторСтрокиЗапроса", 
										СтрокаПоследнейМили.КлючАналитикиПеревозки, СтрокаПоследнейМили.ИдентификаторСтрокиЗапроса);
					СтрокиПоКлючуВПервойМиле = Объект.ТранспортныеСредства.НайтиСтроки(СтруктураПоиска);
					Если СтрокиПоКлючуВПервойМиле.Количество() = 0 Тогда
						КлючДляПодбора = СтрокаПоследнейМили.КлючАналитикиПеревозки;    
						ТекущаяСтрока.ВерсияКлюча = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(КлючДляПодбора, "ВерсияДанных"); 
						ТекущаяСтрока.КлючАналитикиПеревозки = КлючДляПодбора;
						Прервать;
					КонецЕсли;	
				КонецЦикла; 
				// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Начало: 21.03.2024 - Если не подобрали из последней мили, попробуем найти из услуг 
				Если КлючДляПодбора = Неопределено Тогда
					СписокКонтейнеров = ПолучитьСписокКткИзЗапросаКТКПоПереданнойСтроке(ТекущиеДанныеЗапроса.НомерСтроки); 
					КлючиИзСоставаУслуг = ПолучитьКлючиАналитикиПоКонтейнерамИзУслуг(СписокКонтейнеров);    
					Для каждого КлючСоставаУслуг Из КлючиИзСоставаУслуг Цикл   
						СтруктураПоиска = Новый Структура("КлючАналитикиПеревозки, ИдентификаторСтрокиЗапроса", 
						КлючСоставаУслуг, ТекущаяСтрока.ИдентификаторСтрокиЗапроса);
						СтрокиПоКлючуВПервойМиле = Объект.ТранспортныеСредства.НайтиСтроки(СтруктураПоиска);
						Если СтрокиПоКлючуВПервойМиле.Количество() = 0 Тогда
							КлючДляПодбора = КлючСоставаУслуг;    
							ТекущаяСтрока.ВерсияКлюча = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(КлючДляПодбора, "ВерсияДанных"); 
							ТекущаяСтрока.КлючАналитикиПеревозки = КлючДляПодбора;
							Прервать;
						КонецЕсли;	
					КонецЦикла;
				КонецЕсли;
				// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Конец: 21.03.2024
				Если КлючДляПодбора = Неопределено Тогда
					Ответ = СоздатьКлючАналитики(Объект.Ссылка);  
					ТекущаяСтрока.ВерсияКлюча = Ответ.ВерсияДанных;
					ТекущаяСтрока.КлючАналитикиПеревозки = Ответ.КлючАналитикиПеревозки;
				КонецЕсли;
			Иначе	
				Ответ = СоздатьКлючАналитики(Объект.Ссылка);
				ТекущаяСтрока.ВерсияКлюча = Ответ.ВерсияДанных;
				ТекущаяСтрока.КлючАналитикиПеревозки = Ответ.КлючАналитикиПеревозки;
			КонецЕсли;
			//// ДИТ US 78243 ТА 80591 Сержантова А.С. Конец: 07.02.2024
		КонецЕсли;
		//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -конец    
		// ДИТ BUG 79844 ТА 79845 Сержантова А.С. Начало: 25.01.2024
		СтрУслуг = Объект.СоставУслуги.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки", ТекущаяСтрока.КлючАналитикиПеревозки)); 
		Если СтрУслуг.Количество() > 0 Тогда
			СтрУслуг[0].ФИОВодителя = ТекущаяСтрока.ФИОВодителя;
			СтрУслуг[0].НомерАвто = ТекущаяСтрока.РегНомерТС;
			СтрУслуг[0].АвтоперевозчикПерваяМиля = ТекущаяСтрока.Автоперевозчик;
		КонецЕсли;
		// ДИТ BUG 79844 ТА 79845 Сержантова А.С. Конец: 25.01.2024
	КонецЕсли;	
	// Евросиб Фролов)
КонецПроцедуры

&НаКлиенте
Процедура ТранспортныеСредстваПоследняяМиляПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	//ДИТ Шевченко А.В. TASK 51973 01.06.2022 -Начало
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо записать документ");
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	Если НоваяСтрока Тогда
		ТекущиеДанныеЗапроса = Элементы.СписокЗапросНаКТК.ТекущиеДанные;
		ТекущаяСтрока.ИдентификаторСтрокиЗапроса = ТекущиеДанныеЗапроса.ИдентификаторСтроки;
		//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -Начало
		//ТекущаяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		Если ЗначениеЗаполнено(ТекущиеДанныеЗапроса.РелизКлиента) Тогда
			МассивКлючей = Новый Массив;
			Для Каждого Стр Из Объект.ТранспортныеСредстваПоследняяМиля Цикл
				МассивКлючей.Добавить(Стр.КлючАналитикиПеревозки);
			КонецЦикла;	
			СтруктураОтвет = ПолучитьКлючиИзРелизаКлиента(ТекущиеДанныеЗапроса.РелизКлиента,МассивКлючей,ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПоследняяМиля"));
			
			Если СтруктураОтвет.ПустойКлюч Тогда
				Ответ = СоздатьКлючАналитики(Объект.Ссылка);
				ТекущаяСтрока.ВерсияКлюча = Ответ.ВерсияДанных;
				ТекущаяСтрока.КлючАналитикиПеревозки = Ответ.КлючАналитикиПеревозки;
			Иначе
				ЗаполнитьЗначенияСвойств(ТекущаяСтрока,СтруктураОтвет.КлючРелиза[0]);
			КонецЕсли;	
		Иначе
			// ДИТ US 78243 ТА 80591 Сержантова А.С. Начало: 07.02.2024 - если в ТЧ по первой миле уже есть строки с ключом, то берем их, если их не использовали ранее
			// Было:
			//Ответ = СоздатьКлючАналитики(Объект.Ссылка);
			//ТекущаяСтрока.ВерсияКлюча = Ответ.ВерсияДанных;
			//ТекущаяСтрока.КлючАналитикиПеревозки = Ответ.КлючАналитикиПеревозки; 
			// Стало:
			Если Объект.ТранспортныеСредства.Количество() 
				// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Начало: 21.03.2024
				или Объект.СоставУслуги.Количество() Тогда 
				//КлючИзПервойМили = Неопределено;   - переименовала "КлючИзПервойМили" на "КлючДляПодбора"
				КлючДляПодбора = Неопределено;
				// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Конец: 21.03.2024 
				СтрокиПервойМилиДляПодбора = Объект.ТранспортныеСредства.НайтиСтроки(
													Новый Структура("ИдентификаторСтрокиЗапроса", ТекущаяСтрока.ИдентификаторСтрокиЗапроса));
				Для каждого СтрокаПервойМили Из СтрокиПервойМилиДляПодбора Цикл   
					СтруктураПоиска = Новый Структура("КлючАналитикиПеревозки, ИдентификаторСтрокиЗапроса",
										СтрокаПервойМили.КлючАналитикиПеревозки, СтрокаПервойМили.ИдентификаторСтрокиЗапроса);
					СтрокиПоКлючуВПоследнейМиле = Объект.ТранспортныеСредстваПоследняяМиля.НайтиСтроки(СтруктураПоиска);
					Если СтрокиПоКлючуВПоследнейМиле.Количество() = 0 Тогда
						КлючДляПодбора = СтрокаПервойМили.КлючАналитикиПеревозки;    
						// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Начало: 21.03.2024
						//ТекущаяСтрока.ВерсияКлюча = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(КлючДляПодбора, "ВерсияДанных"); 
						РеквизитыКлюча = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(КлючДляПодбора, "ВерсияДанных, Контейнер");
						ТекущаяСтрока.ВерсияКлюча = РеквизитыКлюча.ВерсияДанных; 
						ТекущаяСтрока.Контейнер = РеквизитыКлюча.Контейнер;
						// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Конец: 21.03.2024 
						ТекущаяСтрока.КлючАналитикиПеревозки = КлючДляПодбора;
						Прервать;
					КонецЕсли;	
				КонецЦикла;  
				// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Начало: 21.03.2024 - Если не подобрали из первой мили, попробуем найти из услуг
				Если КлючДляПодбора = Неопределено Тогда
					СписокКонтейнеров = ПолучитьСписокКткИзЗапросаКТКПоПереданнойСтроке(ТекущиеДанныеЗапроса.НомерСтроки); 
					КлючиИзСоставаУслуг = ПолучитьКлючиАналитикиПоКонтейнерамИзУслуг(СписокКонтейнеров);    
					Для каждого КлючСоставаУслуг Из КлючиИзСоставаУслуг Цикл   
						СтруктураПоиска = Новый Структура("КлючАналитикиПеревозки, ИдентификаторСтрокиЗапроса", 
						КлючСоставаУслуг, ТекущаяСтрока.ИдентификаторСтрокиЗапроса);
						СтрокиПоКлючуВПоследнейМиле = Объект.ТранспортныеСредстваПоследняяМиля.НайтиСтроки(СтруктураПоиска);
						Если СтрокиПоКлючуВПоследнейМиле.Количество() = 0 Тогда
							КлючДляПодбора = КлючСоставаУслуг;    
							РеквизитыКлюча = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(КлючДляПодбора, "ВерсияДанных, Контейнер");
							ТекущаяСтрока.ВерсияКлюча = РеквизитыКлюча.ВерсияДанных; 
							ТекущаяСтрока.Контейнер = РеквизитыКлюча.Контейнер;
							ТекущаяСтрока.КлючАналитикиПеревозки = КлючДляПодбора;
							Прервать;
						КонецЕсли;	
					КонецЦикла;
				КонецЕсли;
				// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Конец: 21.03.2024
				Если КлючДляПодбора = Неопределено Тогда
					Ответ = СоздатьКлючАналитики(Объект.Ссылка);  
					ТекущаяСтрока.ВерсияКлюча = Ответ.ВерсияДанных;
					ТекущаяСтрока.КлючАналитикиПеревозки = Ответ.КлючАналитикиПеревозки;
				КонецЕсли;
			Иначе	
				Ответ = СоздатьКлючАналитики(Объект.Ссылка);
				ТекущаяСтрока.ВерсияКлюча = Ответ.ВерсияДанных;
				ТекущаяСтрока.КлючАналитикиПеревозки = Ответ.КлючАналитикиПеревозки;
			КонецЕсли;
			// ДИТ US 78243 ТА 80591 Сержантова А.С. Конец: 07.02.2024
		КонецЕсли;
		//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -конец   
		// ДИТ BUG 79844 ТА 79845 Сержантова А.С. Начало: 25.01.2024
		СтрУслуг = Объект.СоставУслуги.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки", ТекущаяСтрока.КлючАналитикиПеревозки)); 
		Если СтрУслуг.Количество() > 0 Тогда
			СтрУслуг[0].ФИОВодителяВыгрузка = ТекущаяСтрока.ФИОВодителя;
			СтрУслуг[0].НомерАвтоВыгрузка = ТекущаяСтрока.РегНомерТС;
            СтрУслуг[0].АвтоПеревозчик = ТекущаяСтрока.Автоперевозчик;
		КонецЕсли;
		// ДИТ BUG 79844 ТА 79845 Сержантова А.С. Конец: 25.01.2024
	КонецЕсли;
	//ДИТ Шевченко А.В. TASK 51973 01.06.2022 -Конец
КонецПроцедуры

