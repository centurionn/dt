&НаКлиенте
Процедура ОчиститьКопируемыеПоля(ПоляТаблицы)
	// Евросиб Фролов (16.11.2021 TASK№ №41969
	
	СписокКопируемыхПолей = 
	"СписокЗапросНаКТККоличествоКТК,
	|СписокЗапросНаКТКТипКТК,
	|СписокЗапросНаКТКДействиеРелизаНачало,
	|СписокЗапросНаКТКДействиеРелизаОкончание,
	|СписокЗапросНаКТКЛокацияВыдачи,
	|СписокЗапросНаКТККомментарийКЛокацииВыдачи,
	|СписокЗапросНаКТКЛокацияСдачи,
	|СписокЗапросНаКТККомментарийКЛокацииСдачи,
	|СписокЗапросНаКТКСрокИспользованияКТК,
	|СписокЗапросНаКТККомментарийКСрокуИспользованияКТК,
	|СписокЗапросНаКТКСтавка,
	|СписокЗапросНаКТККомментарийКСтавке,
	// Евросиб Фролов (06.12.2021 TASK№ №42618, РелизКлиента
	|СписокЗапросНаКТКВалютаПоДоговору,
	|СписокЗапросНаКТКСНП";
	// Евросиб Фролов)
	
	ТекущиеДанные = Элементы.СписокЗапросНаКТК.ТекущиеДанные;
	
	//ПоляТаблицы = Элементы.СписокЗапросНаКТК.ПодчиненныеЭлементы;
	Для Каждого ТекущееПоле Из ПоляТаблицы Цикл			
		
		Если ТекущееПоле.Имя = "СписокЗапросНаКТКНомерСтроки" Тогда
			Продолжить;
		КонецЕсли;	
		
		Если ТипЗнч(ТекущееПоле) = Тип("ПолеФормы") Тогда
			
			Если СтрНайти(СписокКопируемыхПолей, ТекущееПоле.Имя) = 0 Тогда
				Если СтрНачинаетсяС(ТекущееПоле.Имя, "СписокЗапросНаКТКРелизКлиента")
					И ТекущееПоле.Имя <> "СписокЗапросНаКТКРелизКлиента" Тогда
					// Подчиненный реквизит из релиза клиента
					Продолжить;
				КонецЕсли;	
				// В поле, которое не должно копироваться, установим значение по умолчанию того типа, который у поля.
				ТекущиеДанные[СтрЗаменить(ТекущееПоле.Имя, "СписокЗапросНаКТК", "")] = Элементы[ТекущееПоле.Имя].ОграничениеТипа.ПривестиЗначение();
			КонецЕсли;
		Иначе
			ОчиститьКопируемыеПоля(ТекущееПоле.ПодчиненныеЭлементы);
		КонецЕсли;
					
	КонецЦикла;
	
	// Евросиб Фролов)

КонецПроцедуры	

