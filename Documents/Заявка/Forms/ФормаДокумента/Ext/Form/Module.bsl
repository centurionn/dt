&НаКлиенте
Процедура ТранспортныеСредстваПоследняяМиляПриИзменении(Элемент)
	//ДИТ Шевченко А.В. 58552 05.10.2022 -начало
	ТекД = Элементы.ТранспортныеСредстваПоследняяМиля.ТекущиеДанные;
	
	//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -Начало
	Если ТекД = Неопределено ИЛИ ТекД.КлючАналитикиПеревозки = ПредопределенноеЗначение("Справочник.КлючиАналитикиПеревозки.ПустаяСсылка") Тогда
		Возврат;
	КонецЕсли;
	СтруктураДляКлюча = Новый Структура("ФИОВодителя,РегНомерТС,ПаспортныеДанные,Автоперевозчик,ИНН,КПП,КлючАналитикиПеревозки,Контейнер");
	ЗаполнитьЗначенияСвойств(СтруктураДляКлюча,ТекД);  
	// ДИТ BUG 79844 ТА 79845 Сержантова А.С. Начало: 18.01.2024
	Если ЗначениеЗаполнено(ТекД.Автоперевозчик) и ТипЗнч(ТекД.Автоперевозчик) = Тип("СправочникСсылка.Контрагенты") Тогда   
		ЗначенияРекв = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(ТекД.Автоперевозчик, "ИНН, КПП");
		ТекД.ИНН = ЗначенияРекв.ИНН; 
		ТекД.КПП = ЗначенияРекв.КПП; 
	Иначе
		Элементы.ТранспортныеСредстваПоследняяМиляИНН.Доступность = Истина;
		Элементы.ТранспортныеСредстваПоследняяМиляКПП.Доступность = Истина;
	КонецЕсли;
	// ДИТ BUG 79844 ТА 79845 Сержантова А.С. Конец: 18.01.2024
	// ДИТ US 76935 ТА 78649 Сержантова А.С. Начало: 27.12.2023
	//ДобавитьЗначениеРеквизитаВКлючПоВодителяАвтоперевозчикам(СтруктураДляКлюча,ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПоследняяМиля"),ТекД.ВерсияДанных);
	// ДИТ US 76935 ТА 78649 Сержантова А.С. Конец: 27.12.2023
	//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -Конец
	
	Если ЗаполнятьВниз Тогда
		ИмяТЧ = Элемент.Имя;
		ИмяПоля = Сред(Элемент.ТекущийЭлемент.Имя, СтрДлина(ИмяТЧ)+1);
		
		НовоеЗначение = ТекД[ИмяПоля];  
		
		// ДИТ US 78243 ТА 80825 Сержантова А.С. Начало: 19.02.2024
		Если ИмяПоля = "Автоперевозчик" Тогда     
			Если ТипЗнч(НовоеЗначение) = Тип("СправочникСсылка.Контрагенты") и ЗначениеЗаполнено(НовоеЗначение) Тогда
				РеквизитыАвтоперевозчика = ОбщегоНазначенияВызовСервера.ЗначенияРеквизитовОбъекта(НовоеЗначение, "ИНН, КПП", Ложь);
			Иначе
				РеквизитыАвтоперевозчика = Новый Структура("ИНН, КПП", "", "");
			КонецЕсли;
		КонецЕсли;
		// ДИТ US 78243 ТА 80825 Сержантова А.С. Конец: 19.02.2024
		
		СтрокаПройдена = Ложь;		
		Для Сч = 0 По Объект[ИмяТЧ].Количество() - 1 Цикл
			РезПроверки = Элементы.ТранспортныеСредстваПоследняяМиля.ПроверитьСтроку(Объект[ИмяТЧ][Сч].ПолучитьИдентификатор());
			
			СтрокаПройдена = СтрокаПройдена ИЛИ Элементы.ТранспортныеСредстваПоследняяМиля.ТекущаяСтрока = Объект[ИмяТЧ][Сч].ПолучитьИдентификатор();
			
			Если РезПроверки = Истина И СтрокаПройдена = Истина Тогда
				
				Объект[ИмяТЧ][Сч][ИмяПоля] = НовоеЗначение;
				
				// ДИТ US 78243 ТА 80825 Сержантова А.С. Начало: 19.02.2024
				Если ИмяПоля = "Автоперевозчик" Тогда
					Объект[ИмяТЧ][Сч]["ИНН"] = РеквизитыАвтоперевозчика.ИНН;
					Объект[ИмяТЧ][Сч]["КПП"] = РеквизитыАвтоперевозчика.КПП;
				КонецЕсли;
				// ДИТ US 78243 ТА 80825 Сержантова А.С. Конец: 19.02.2024
				
			КонецЕсли; 
			
		КонецЦикла;
		
	КонецЕсли; 
	//ДИТ Шевченко А.В. 58552 05.10.2022 -конец   
	
	// ДИТ BUG 79844 ТА 79845 Сержантова А.С. Начало: 24.01.2024
	ЗаполнитьТранспортныеСредстваВУслугах(ТекД, ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПоследняяМиля"));
	// ДИТ BUG 79844 ТА 79845 Сержантова А.С. Конец: 24.01.2024
КонецПроцедуры
// ДИТ US 58592 TA 60724 Евсенкин М.А. Конец: 29.12.2022

