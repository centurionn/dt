&НаСервереБезКонтекста
Функция ПроверитьКонтрагентаКоносамент(Контрагент)
	
	Коносамент = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ФормированиеФинДокументов.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ФормированиеФинДокументов КАК ФормированиеФинДокументов
	               |ГДЕ
	               |	ФормированиеФинДокументов.Контрагент = &Контрагент
	               |	И (ФормированиеФинДокументов.Коносамент
	               |	ИЛИ ФормированиеФинДокументов.ОдинКоносаментОдинДокумент)";
	Запрос.УстановитьПараметр("Контрагент",Контрагент);
	РЗ = Запрос.Выполнить();
	Если НЕ РЗ.Пустой() Тогда
		Коносамент = Истина;
	КонецЕсли;
	
	Возврат Коносамент;
	
