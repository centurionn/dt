				//Стало
				// поменял текст сообщения
				ОбщегоНазначения.СообщитьПользователю(СтрШаблон("У выбранной калькуляции %1 от %2 в разделе 2.2 не заполнена таблица ставок по фрахту для соответствующего размера и принадлежности КТК: %3.", ЗнчКалк.Номер, ЗнчКалк.Дата, СтрСоединить(КТКБезСобственности,",")),,,,Отказ);
				//Евросиб СубботинВ #91170 07.10.2024 Конец	
				КонецЕсли;
				
			КонецЦикла;
			Если КалькуляцииБезРазделов.Количество() Тогда
				Взаимодействия.УдалитьПовторяющиесяЭлементыМассива(КалькуляцииБезРазделов); //ДИТ, Беляев СЮ, BUG 78827/TA 78829, 26-12-2023, добавлено
				Для Каждого ЗнчМ Из КалькуляцииБезРазделов Цикл
					ОбщегоНазначения.СообщитьПользователю(СтрШаблон("В Калькуляции %1 от %2 не заполнена ставка",ЗнчКалк.Номер,ЗнчКалк.Дата),,,,Отказ);
				КонецЦикла;
			КонецЕсли;	
		КонецЕсли;
		
		//Если МассивКонтейнеровБезРазмера.Количество() Тогда //ДИТ, Беляев СЮ, BUG 78827/TA 78829, 26-12-2023, перенесено ниже
		//	ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Не заполнены размеры у КТК № %1",СтрСоединить(МассивКонтейнеровБезРазмера,",")),,,,Отказ);	
		//КонецЕсли;	
		
		//ДИТ, Беляев СЮ, US 80592/TA 80634, 04-03-2024, начало
		Если МассивКонтейнеровБезРазмера.Количество() Тогда
			Взаимодействия.УдалитьПовторяющиесяЭлементыМассива(МассивКонтейнеровБезРазмера);
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Не заполнены размеры у КТК № %1",СтрСоединить(МассивКонтейнеровБезРазмера,",")),,,,Отказ);	
		КонецЕсли;
		//ДИТ, Беляев СЮ, US 80592/TA 80634, 04-03-2024, конец
	КонецЕсли;
	
	////ДИТ, Беляев СЮ, BUG 78827/TA 78829, 26-12-2023, начало
	//Если МассивКонтейнеровБезРазмера.Количество() Тогда
