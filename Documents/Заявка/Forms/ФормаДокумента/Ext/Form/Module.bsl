				СтрокаУ.ПерваяМиля = ТекущийОбъект.СписокЗапросНаКТК[0].Автоперевозка; 
				СтрокаУ.ПоследняяМиля = ТекущийОбъект.СписокЗапросНаКТК[0].ПоследняяМиля;
				Если ТекущийОбъект.ПСЦ.Калькуляции.Количество() = 1 Тогда 
