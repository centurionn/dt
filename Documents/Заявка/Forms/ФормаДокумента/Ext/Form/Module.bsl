			, Истина
			, Параметры.МассивКонтейнеров
			, Параметры.Свойство("ДГК"));
	ИначеЕсли Параметры.Свойство("ЭтоДобавлениеВЗаявкуИзРефСцепа") Тогда
		ЗаполнитьКонтейнерыИзРефСцепа(Параметры.Основание
			, Ложь
			, Параметры.МассивКонтейнеров
