Процедура ПолучитьДанныеИзБазы()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаявкаСостояния.Ссылка КАК Ссылка,
	               |	ЗаявкаСостояния.НомерСтроки КАК НомерСтроки,
	               |	ЗаявкаСостояния.Состояние КАК Состояние,
	               |	ЗаявкаСостояния.Исполнитель КАК Исполнитель,
	               |	ЗаявкаСостояния.Наблюдатель КАК Наблюдатель,
	               |	ЗаявкаСостояния.Статус КАК Статус,
	               |	ЗаявкаСостояния.НачалоРаботы КАК НачалоРаботы,
	               |	ЗаявкаСостояния.ЗавершениеРаботы КАК ЗавершениеРаботы,
	               |	ЗаявкаСостояния.ПричинаОтказа КАК ПричинаОтказа,
	               |	ЗаявкаСостояния.СтатусСогласования КАК СтатусСогласования,
	               |	ЗаявкаСостояния.ПредыдущиеЭтапы КАК ПредыдущиеЭтапы,
	               |	ЗаявкаСостояния.НормативИсполненияСМоментаСоздания КАК НормативИсполненияСМоментаСоздания
	               |ИЗ
	               |	Документ.Заявка.Состояния КАК ЗаявкаСостояния
	               |ГДЕ
	               |	ЗаявкаСостояния.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",Объект.Ссылка);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Объект.Состояния.Загрузить(ТЗ);
	
