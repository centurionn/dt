&НаКлиенте
Процедура СоставУслугиДатаВыдачиПриИзменении(Элемент)
	ТекущиеДанные = Элементы.СоставУслуги.ТекущиеДанные;
	СтруктураТЧМили = Новый Структура;
	СтруктураТЧМили.Вставить("ДатаВыдачиКТКСТерминала",ТекущиеДанные.ДатаВыдачи);
	Структура = ПолучитьСтруктуруДляЗаписиКлюча();
	ЗаполнитьЗначенияСвойств(Структура,ТекущиеДанные);
	ДобавитьЗначениеРеквизитаМилиВКлюч(Структура,ТекущиеДанные.ДатаВыдачи,"ДатаВыдачиКТКСТерминала",ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПерваяМиля"),СтруктураТЧМили);
КонецПроцедуры

&НаСервере
Процедура ДобавитьЗначениеРеквизитаМилиВКлюч(ТекСтр,ЗначениеПоля,ИмяПоля,ЭтапПеревозки = Неопределено,СтруктураПолейТЧМили = Неопределено) //ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23
	
	Если ТекСтр.ВерсияКлюча <> ТекСтр.КлючАналитикиПеревозки.ВерсияДанных Тогда
		ОбновитьДанныеКлючаАналитикиПеревозки(ТекСтр);
		ОбщегоНазначения.СообщитьПользователю("Версия ключа аналитики перевозки устарела, подгружены актуальные данные по строке.");	
	КонецЕсли;
	
	СтруктураКлюча  = Справочники.КлючиАналитикиПеревозки.СтруктураКлючаАналитикиПеревозки();	
	СтруктураКлюча.Вставить("КлючАналитики",ТекСтр.КлючАналитикиПеревозки);
	
	Если ЭтапПеревозки = Неопределено Тогда
		СтруктураКлюча.Вставить(ИмяПоля,ЗначениеПоля);
		// ДИТ US 76935 ТА 78649 Сержантова А.С. Начало: 27.12.2023
		//ТекСтр.ВерсияКлюча = Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлюча).ВерсияДанных; 
		// ДИТ US 76935 ТА 78649 Сержантова А.С. Конец: 27.12.2023
	КонецЕсли;
	
	Если ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПерваяМиля Тогда
		ЗаполнитьЗначенияСвойств(СтруктураКлюча.СтруктураТЧМилиПерваяМиляКлючаАналитики,СтруктураПолейТЧМили);
		// ДИТ US 76935 ТА 78649 Сержантова А.С. Начало: 27.12.2023
		//ТекСтр.ВерсияКлюча = Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлюча).ВерсияДанных; 
		// ДИТ US 76935 ТА 78649 Сержантова А.С. Конец: 27.12.2023
	КонецЕсли;
	
	Если ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПоследняяМиля Тогда
		ЗаполнитьЗначенияСвойств(СтруктураКлюча.СтруктураТЧМилиПоследняяМиляКлючаАналитики,СтруктураПолейТЧМили); 
		// ДИТ US 76935 ТА 78649 Сержантова А.С. Начало: 27.12.2023
		//ТекСтр.ВерсияКлюча = Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлюча).ВерсияДанных;   
		// ДИТ US 76935 ТА 78649 Сержантова А.С. Конец: 27.12.2023
	КонецЕсли;	
	
КонецПроцедуры 

