&НаКлиенте
Процедура СоставУслугиГрузПриИзменении(Элемент)
			
	ТекД = Элементы.СоставУслуги.ТекущиеДанные;
	Если ТекД <> неопределено Тогда   
		
		// ДИТ US 78234 ТА 78241 Сержантова А.С. Начало: 12.12.2023
		ТекСтрока = Объект.СоставУслуги.НайтиПоИдентификатору(Элементы.СоставУслуги.ТекущаяСтрока);
		// ДИТ US 78234 ТА 78241 Сержантова А.С. Конец: 12.12.2023
		
		ТекД.КодГруза = ПолучитьЕТСНГГруза(ТекД.Груз);
		
		Если ЗаполнятьПоПервойСтроке Тогда
			ИмяТЧ = "СоставУслуги";
			ИмяПоля = "КодГруза";
			
			//Если МассивРазрешенныхПолей.Найти(ИмяПоля) = неопределено Тогда Возврат; КонецЕсли;
			Для Сч = 1 По Объект[ИмяТЧ].Количество() - 1 Цикл
				Объект[ИмяТЧ][Сч][ИмяПоля] = Объект[ИмяТЧ][0][ИмяПоля];
			КонецЦикла;
		КонецЕсли;
		
		//ДИТ Шевченко А.В. TASK 51973 01.06.2022 -Начало
		//ОбновитьВидимостьДетализацияПоГрузу();  // ДИТ US 62421 TA 64346 Евсенкин М.А. Начало: 06.03.2023

		Если ТекД.Груз <> ПредопределенноеЗначение("Справочник.Грузы.СборнаяКонтейнернаяОтправка") Тогда
			// ДИТ US 62421 TA 64346 Евсенкин М.А. Начало: 13.02.2023
			// Было:
			//Объект.ДетализацияПоГрузу.Очистить();	  
			//Стало:
			Найдено = ДетализацияПоГрузу.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки",ТекД.КлючАналитикиПеревозки));
			Для Каждого СтрНайдено Из Найдено Цикл 
				ДетализацияПоГрузу.Удалить(ДетализацияПоГрузу.Индекс(СтрНайдено));
			КонецЦикла;   
		// ДИТ US 78234 ТА 78241 Сержантова А.С. Начало: 12.12.2023   
		Иначе
			Найдено = ДетализацияПоГрузу.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки",ТекД.КлючАналитикиПеревозки));
			КоличествоМест = 0;
			ВесГруза = 0;
			Для Каждого СтрНайдено Из Найдено Цикл 
				КоличествоМест = КоличествоМест + СтрНайдено.КоличествоМест;
				ВесГруза = ВесГруза + СтрНайдено.ВесГруза;
			КонецЦикла;	 
			ТекСтрока.ВесГрузаНетто = ВесГруза;
			ТекСтрока.КоличествоМест = КоличествоМест;  
		// ДИТ US 78234 ТА 78241 Сержантова А.С. Конец: 12.12.2023
		КонецЕсли;     
	
		// ДИТ US 78234 ТА 78241 Сержантова А.С. Начало: 12.12.2023   
		НаименованиеГруза = ВРег(ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(ТекД.Груз, "Наименование"));
		Если СтрНайти(НаименованиеГруза, "КОНТЕЙНЕРЫ УНИВЕРСАЛЬНЫЕ ПОРОЖНИЕ") <> 0 
			или не ЗначениеЗаполнено(ТекД.Груз) Тогда
			ТекСтрока.Груженый = Ложь;	
		Иначе	
		    ТекСтрока.Груженый = Истина;
		КонецЕсли;
		// ДИТ US 78234 ТА 78241 Сержантова А.С. Конец: 12.12.2023

		мТекущиеДанные = Элементы.СоставУслуги.ТекущиеДанные;
		НайтиКлючАналитикиПеревозкиКлиент(мТекущиеДанные);
		
		Если Элементы.ДетализацияПоГрузу.Видимость 
			И (ЗначениеЗаполнено(мТекущиеДанные.ПеренесенВЗаявку) 
			Или Не мТекущиеДанные.Груз = ПредопределенноеЗначение("Справочник.Грузы.СборнаяКонтейнернаяОтправка")) Тогда 
			Элементы.ДетализацияПоГрузу.ТолькоПросмотр = Истина;
		Иначе 
			Элементы.ДетализацияПоГрузу.ТолькоПросмотр = Ложь;	
		КонецЕсли;
		// ДИТ US 62421 TA 64346 Евсенкин М.А. Конец: 13.02.2023
		//ДИТ Шевченко А.В. TASK 51973 01.06.2022 -Конец
		
	КонецЕсли;

КонецПроцедуры

