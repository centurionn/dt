&НаКлиенте
Процедура СписокЗапросНаКТКПриИзменении(Элемент)
	// Евросиб Фролов (16.11.2021 TASK№ №41969
	
	ТекД = Элементы.СписокЗапросНаКТК.ТекущиеДанные;
	
	Если ЗаполнятьПоПервойСтроке Тогда
		ИмяТЧ = Элемент.Имя;
		ИмяПоля = Сред(Элемент.ТекущийЭлемент.Имя, СтрДлина(ИмяТЧ)+1);
		
		НовоеЗначение = ТекД[ИмяПоля];
		
		Для Сч = 0 По Объект[ИмяТЧ].Количество() - 1 Цикл
			РезПроверки = Элементы.СписокЗапросНаКТК.ПроверитьСтроку(Объект[ИмяТЧ][Сч].ПолучитьИдентификатор());
			Если РезПроверки = Истина Тогда
				
				//Объект[ИмяТЧ][Сч][ИмяПоля] = НовоеЗначение; 
				//Субботин В.А. 58332 08.06.23  Начало
				Если Сч=0 тогда 
					продолжить;
				КонецЕсли;
				Элементы.СписокЗапросНаКТК.ТекущаяСтрока = Объект[ИмяТЧ][Сч].ПолучитьИдентификатор();
				Объект[ИмяТЧ][Сч][ИмяПоля] = НовоеЗначение;
				Попытка
					Выполнить(""+Элемент.ТекущийЭлемент.Имя + "ПриИзменении"+"(Объект[ИмяТЧ][Сч])");
				Исключение 
				//Субботин В.А. 58332 08.06.23  Конец 
				КонецПопытки
				
			КонецЕсли; 
			
		КонецЦикла;
		//Субботин В.А. 58332 08.06.23  Начало
		Элементы.СписокЗапросНаКТК.ТекущаяСтрока = Объект[ИмяТЧ][0].ПолучитьИдентификатор();
		текД = Элементы.СписокЗапросНаКТК.ТекущиеДанные;
		//Субботин В.А. 58332 08.06.23  Конец
	КонецЕсли;
	
	Если ЗаполнятьВниз Тогда
		//Субботин 77659 24.11.2023 Начало  падала ошибка если строка была последней
		Если текД <> Неопределено Тогда
		//Субботин 77659 24.11.2023 Конец	
			ИмяТЧ = Элемент.Имя;
			ИмяПоля = Сред(Элемент.ТекущийЭлемент.Имя, СтрДлина(ИмяТЧ)+1);
			
			НовоеЗначение = ТекД[ИмяПоля];
			
			СтрокаПройдена = Ложь;		
			Для Сч = 0 По Объект[ИмяТЧ].Количество() - 1 Цикл
				РезПроверки = Элементы.СписокЗапросНаКТК.ПроверитьСтроку(Объект[ИмяТЧ][Сч].ПолучитьИдентификатор());
				
				СтрокаПройдена = СтрокаПройдена ИЛИ Элементы.СписокЗапросНаКТК.ТекущаяСтрока = Объект[ИмяТЧ][Сч].ПолучитьИдентификатор();
				
				Если РезПроверки = Истина И СтрокаПройдена = Истина Тогда
					
					Объект[ИмяТЧ][Сч][ИмяПоля] = НовоеЗначение;
					
				КонецЕсли; 
				
			КонецЦикла;
	//Субботин 77659 24.11.2023 Начало
		КонецЕсли;
	//Субботин 77659 24.11.2023 конец	
	КонецЕсли;	

	// Евросиб Фролов (06.12.2021 TASK№ №42618, РелизКлиента
	//Субботин 77659 26.12.2023 начало добавил проверку на неопределено. иначе при удалении посл. строки была ошибка
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	Если не Элемент.ТекущиеДанные = Неопределено тогда 
		//Субботин 77659  26.12.2023 конец
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.ИдентификаторСтроки) Тогда
			ТекущаяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
	КонецЕсли;
	// Евросиб Фролов)
	
	//++ДИТ Гаузер А.В. BUG 51648 TA 56121 16.08.2022
	ЛокацияПустаяСсылка = ПредопределенноеЗначение("Справочник.Локации.ПустаяСсылка");
