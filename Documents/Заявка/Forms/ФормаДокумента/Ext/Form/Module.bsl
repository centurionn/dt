&НаКлиенте
Процедура ВставкаДатыПрибытияНаТерминал(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = неопределено Тогда Возврат; КонецЕсли;
	
	Для Сч = 0 по П1.КТК.Количество() - 1 Цикл
		
		КТКНайден = Ложь;
		Для каждого Стр из Объект.СоставУслуги Цикл
			Если Строка(Стр.НомерКТК) = П1.КТК[Сч] Тогда КТКНайден = Истина; Стр.ВремяПрибытияНаТерминал = П1.ДатыКТК[Сч]; КонецЕсли;
		КонецЦикла;
		Если НЕ КТКНайден Тогда
			
			Сообщить("Данные по контейнеру " + П1.КТК[Сч] + " не удалось записать в документ. Контейнер не найден.");
			
		КонецЕсли;
		
	КонецЦикла;
	
	
КонецПроцедуры

&НаКлиенте
Процедура СоставУслугиКалькуляцияПриИзменении(Элемент)
	
	ТекД = Элементы.СоставУслуги.ТекущиеДанные;
	Если ТекД = неопределено Тогда Возврат; КонецЕсли;
	
	//Евросиб Коханенко Н.А. 25.07.2023 (( #72829
	ДобавлениеНевозможно = ПроверитьНаВозможностьВыбораКалькуляцииПоРезультатамСогласования(Объект.Ссылка, ТекД.Калькуляция);
	Если ДобавлениеНевозможно Тогда
		ТекД.Калькуляция = Неопределено;
		Возврат;
	КонецЕсли;
	//Евросиб Коханенко Н.А. 25.07.2023 )) #72829 
	
	Результат = ПолучитьДанныеКалькуляции(ТекД.Калькуляция);
	
	//Евросиб Каблов 31.10.2020 ( Ticket#0212382
	//ЗаполнитьЗначенияСвойств(ТекД, Результат);
	ЗаполненныеПоля = Новый Массив;			
	Если ЗначениеЗаполнено(ТекД.СтанцияОтправления) Тогда
		ЗаполненныеПоля.Добавить("СтанцияОтправления");
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекД.СтанцияНазначения) Тогда
		ЗаполненныеПоля.Добавить("СтанцияНазначения");
	КонецЕсли;
	ИменаЗаполненныхПолей = СтрСоединить(ЗаполненныеПоля, ",");
	ЗаполнитьЗначенияСвойств(ТекД, Результат,, ИменаЗаполненныхПолей);
	//Евросиб Каблов 31.10.2020 )
	
	Если ЗаполнятьПоПервойСтроке Тогда 
		Для Сч = 1 по Объект.СоставУслуги.Количество()-1 Цикл
			
			//Евросиб Каблов 31.10.2020 ( Ticket#0212382
			//ЗаполнитьЗначенияСвойств(Объект.СоставУслуги[Сч], Результат);
			СтрокаТЧ = Объект.СоставУслуги[Сч];
			ЗаполненныеПоля = Новый Массив;			
			Если ЗначениеЗаполнено(СтрокаТЧ.СтанцияОтправления) Тогда
				ЗаполненныеПоля.Добавить("СтанцияОтправления");
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаТЧ.СтанцияНазначения) Тогда
				ЗаполненныеПоля.Добавить("СтанцияНазначения");
			КонецЕсли;
			ИменаЗаполненныхПолей = СтрСоединить(ЗаполненныеПоля, ",");
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, Результат,, ИменаЗаполненныхПолей);
			//Евросиб Каблов 31.10.2020 )
		КонецЦикла;
	КонецЕсли;
	
	//Евросиб(ДИТ), Беляев СЮ, US 90649 / TA 93760, 02-11-2024, начало
	Если НЕ ЗначениеЗаполнено(ГруппаДКС) Тогда
		ГруппаДКС = Результат.ГруппаДКС;
	КонецЕсли;
	//Евросиб(ДИТ), Беляев СЮ, US 90649 / TA 93760, 02-11-2024, конец
	
КонецПроцедуры

