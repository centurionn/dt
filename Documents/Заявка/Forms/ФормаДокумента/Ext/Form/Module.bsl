&НаСервереБезКонтекста
Функция ЗапрещеноНезаполненноеЗначениеГруппыДКС(ПроверяемаяДата, МассивКалькуляций)
	
	ЕстьЗапретПоДате = Справочники.ГруппыДКС.ЗапрещеноНезаполненноеЗначениеГруппыДКС(ПроверяемаяДата);
	
	Если НЕ ЕстьЗапретПоДате Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипыКалькуляцийБезКонтроля = Новый Массив;
	ТипыКалькуляцийБезКонтроля.Добавить(Перечисления.ТипыКалькуляций.МежсервисныеРасходы);
	ТипыКалькуляцийБезКонтроля.Добавить(Перечисления.ТипыКалькуляций.МежсервисныеРасходыРеф);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Калькуляция.Ссылка КАК Калькуляция
		|ИЗ
		|	Документ.Калькуляция КАК Калькуляция
		|ГДЕ
		|	Калькуляция.Ссылка В(&МассивКалькуляций)
		|	И НЕ Калькуляция.ТипКалькуляции В (&ТипыКалькуляцийБезКонтроля)";
	
	Запрос.УстановитьПараметр("МассивКалькуляций", МассивКалькуляций);
	Запрос.УстановитьПараметр("ТипыКалькуляцийБезКонтроля", ТипыКалькуляцийБезКонтроля);
	
	РезультатЗапроса = Запрос.Выполнить();
	ЕстьЗапретПоТипуКалькуляции = НЕ РезультатЗапроса.Пустой();
	
	Возврат ЕстьЗапретПоТипуКалькуляции;
	
КонецФункции
