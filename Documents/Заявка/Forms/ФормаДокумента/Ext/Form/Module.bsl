// ДИТ US 60810 TA 66664 Евсенкин М.А. Начало: 21.03.2023
&НаСервере
Процедура ПроверкаКодКонтрагентаСибур(НеЗаполненКодКонтрагентаСибур)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЗ.ВладелецКТК КАК ВладелецКТК,
		|	ТЗ.Грузополучатель КАК Грузополучатель
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.ВладелецКТК КАК ВладелецКТК
		|ПОМЕСТИТЬ ВКТК
		|ИЗ
		|	ВТ КАК ВТ
		|ГДЕ
		|	НЕ ВТ.ВладелецКТК = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ.ВладелецКТК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Грузополучатель КАК Грузополучатель
		|ПОМЕСТИТЬ ГП
		|ИЗ
		|	ВТ КАК ВТ
		|ГДЕ
		|	НЕ ВТ.Грузополучатель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ.Грузополучатель
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВКТК.ВладелецКТК КАК Контрагент
		|ПОМЕСТИТЬ ВТ_Итог
		|ИЗ
		|	ВКТК КАК ВКТК
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ГП.Грузополучатель
		|ИЗ
		|	ГП КАК ГП
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_Итог.Контрагент КАК Контрагент,
		|	ВЫБОР
		|		КОГДА ПротоколОбменов.УИДИсточника ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК УИДИсточникаСуществует
		|ИЗ
		|	ВТ_Итог КАК ВТ_Итог
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
		|		ПО ВТ_Итог.Контрагент = ПротоколОбменов.Объект
		|			И (ПротоколОбменов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных))
		|			И (ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.Сибур))";
	
	ТЗ = Объект.СоставУслуги.Выгрузить(,"ВладелецКТК,Грузополучатель");
	Если Не Объект.ПунктПеревалки = Справочники.Контрагенты.ПустаяСсылка() Тогда 
		НоваяСтрока = ТЗ.Добавить();
		НоваяСтрока.ВладелецКТК = Объект.ПунктПеревалки;
	КонецЕсли; 
	
	Если Не Объект.Грузополучатель = Справочники.Контрагенты.ПустаяСсылка() Тогда 
		НоваяСтрока = ТЗ.Добавить();
		НоваяСтрока.ВладелецКТК = Объект.Грузополучатель;
	КонецЕсли;    
	
	//ТЗ.Свернуть("ВладелецКТК");

	Запрос.УстановитьПараметр("ТЗ", ТЗ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если Не ВыборкаДетальныеЗаписи.УИДИсточникаСуществует Тогда  
			НеЗаполненКодКонтрагентаСибур.Добавить(ВыборкаДетальныеЗаписи.Контрагент);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

//БИТ Белинский Д.А. 11.04.2023 -начало  TASK 66201
&НаСервере
Процедура УстановитьДоступностьПолейПоследнейМили()
	
	Если Объект.Контрагент = ДирекцияКонтейнерныхПеревозок() Тогда
		Если ЗначениеЗаполнено(Объект.ПСЦ) И ЭтоМежсервисныеРасходы(Объект.ПСЦ.ТипКалькуляции) Тогда

			ЕстьРейсАвто = Ложь;
			ЕстьДругиеРейсы = Ложь;
			Для Каждого СтрокаРейсы Из Объект.ПереченьРейсов Цикл
				Если ТипЗнч(СтрокаРейсы.Рейс) = Тип("СправочникСсылка.РейсыАвто") Тогда
					ЕстьРейсАвто = Истина;
				Иначе
					ЕстьДругиеРейсы = Истина;
				КонецЕсли;
			КонецЦикла;
			
			Если ЕстьРейсАвто и НЕ ЕстьДругиеРейсы Тогда 
				Элементы.СоставУслугиПоследняяМиля.Доступность = Ложь;
				Элементы.СписокЗапросНаКТКПоследняяМиля.Доступность = Ложь;
			Иначе
				Элементы.СоставУслугиПоследняяМиля.Доступность = Истина;
				Элементы.СписокЗапросНаКТКПоследняяМиля.Доступность = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
