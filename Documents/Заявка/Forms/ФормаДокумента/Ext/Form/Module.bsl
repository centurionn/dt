&НаСервере
Процедура НастроитьДоступностьПолейЗапросаНаКТК(ПоляТаблицы)
	// Евросиб Фролов (16.11.2021 TASK№ №41969
	
	СписокПолейЗапрещенныхОРК = "СписокЗапросНаКТККомментарийКРелизу,
								|СписокЗапросНаКТКРелизКлиента,
								//|СписокЗапросНаКТКТерминалВыдачи, // Евросиб Фролов (06.12.2021 TASK№ №42618, РелизКлиента
								|СписокЗапросНаКТКФИОВодителяПерваяМиля,
								|СписокЗапросНаКТКНомерТСПерваяМиля,
								|СписокЗапросНаКТКАвтоперевозчикПерваяМиля,
								|СписокЗапросНаКТККомментарийПерваяМиля,
								|СписокЗапросНаКТКФИОВодителяПоследняяМиля,
								|СписокЗапросНаКТКНомерТСПоследняяМиля,
								|СписокЗапросНаКТКАвтоперевозчикПоследняяМиля,
								|СписокЗапросНаКТККомментарийПоследняяМиля";
	
	// Проставим всем полям только просмотр (кроме администраторов и пользователей с ролью "dc_РаботаСЗаявками").
	ДоступнаРольРаботаСЗаявками = Пользователи.РолиДоступны("dc_РаботаСЗаявками");
	ДоступенТолькоПросмотр 		= НЕ ДоступнаРольРаботаСЗаявками;
	ЭтоПолноправныйПользователь = Пользователи.ЭтоПолноправныйПользователь();
	
	Для Каждого ТекущееПоле Из ПоляТаблицы Цикл
		Если ТипЗнч(ТекущееПоле) = Тип("ПолеФормы") Тогда
			ТекущееПоле.ТолькоПросмотр = ДоступенТолькоПросмотр;
			
			Если СтрНайти(СписокПолейЗапрещенныхОРК, ТекущееПоле.Имя) > 0
				И НЕ ЭтоПолноправныйПользователь Тогда
				ТекущееПоле.ТолькоПросмотр = Истина;	
			КонецЕсли;		
			
		ИначеЕсли ТипЗнч(ТекущееПоле) = Тип("ГруппаФормы") Тогда
			НастроитьДоступностьПолейЗапросаНаКТК(ТекущееПоле.ПодчиненныеЭлементы);
		КонецЕсли;	
	КонецЦикла;
	//ДИТ Шевченко А.В. TASK 51973 01.06.2022 -Начало //ЭлементУдален
	//Элементы.СписокЗапросНаКТКДанныеПоАвтоперевозке.ТолькоПросмотр = Истина; // Евросиб Фролов (16.02.2022 Task №44768
	//ДИТ Шевченко А.В. TASK 51973 01.06.2022 -Конец
	
	// Данные поля обновляются из релизов и не поделажт редактированию никому.
	Элементы.СписокЗапросНаКТКРелизКлиентаСтокВыдачи.ТолькоПросмотр 			 = Истина;
	Элементы.СписокЗапросНаКТКРелизКлиентаВыданоКТКПоРелизу.ТолькоПросмотр 		 = Истина;
	Элементы.СписокЗапросНаКТКРелизКлиентаОсталосьКВыдачеПоРелизу.ТолькоПросмотр = Истина;
	
	// Пользователям с ролью "dc_УчетВагоновКТК" разрешить редактирование
	// только следующих полей: "Комментарий к релизу", "Номер релиза собственника", "Номер релиза клиента", "Количество КТК".
	// Кроме того, нужно разрешить редактирование полей по автоперевозке силами Евросиб.
	ДоступнаРольУчетВагоновКТК = Пользователи.РолиДоступны("dc_УчетВагоновКТК");
	
	Если ДоступнаРольУчетВагоновКТК Тогда
		Элементы.СписокЗапросНаКТККомментарийКРелизу.ТолькоПросмотр = Ложь;
		Элементы.СписокЗапросНаКТКРелизКлиента.ТолькоПросмотр 		= Ложь;
		//Элементы.СписокЗапросНаКТКТерминалВыдачи.ТолькоПросмотр 	= Ложь; // Евросиб Фролов (06.12.2021 TASK№ №42618, РелизКлиента
		Элементы.СписокЗапросНаКТККоличествоКТК.ТолькоПросмотр 		= Ложь;
		
		Для Каждого ПодчиненныйЭлемент Из Элементы.СписокЗапросНаКТКГруппаАвтоперевозкаПоОтправлению.ПодчиненныеЭлементы Цикл
			ПодчиненныйЭлемент.ТолькоПросмотр = Ложь;
		КонецЦикла;
		
		Для Каждого ПодчиненныйЭлемент Из Элементы.СписокЗапросНаКТКГруппаАвтоперевозкаПоПрибытию.ПодчиненныеЭлементы Цикл
			ПодчиненныйЭлемент.ТолькоПросмотр = Ложь;
		КонецЦикла;
	КонецЕсли;	
	
	// Евросиб Фролов)
КонецПроцедуры	

&НаСервере
Процедура ОбновитьИтоги()
	// Евросиб Фролов (16.11.2021 TASK№ №41969	
	Если Не Объект.ЗапросНаКТК Тогда
		Возврат;
	КонецЕсли;

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЗаявкаЗапросНаКТК.ТипКТК КАК ТипКТК,
	|	ЗаявкаЗапросНаКТК.КоличествоКТК КАК КоличествоКТК
	|ПОМЕСТИТЬ втТаблицаЗапросов
	|ИЗ
	|	&СписокЗапросНаКТК КАК ЗаявкаЗапросНаКТК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ВЫБОР
	|		КОГДА втТаблицаЗапросов.ТипКТК.РазмерКТК = ЗНАЧЕНИЕ(Справочник.РазмерыКТК.К20)
	|			ТОГДА втТаблицаЗапросов.КоличествоКТК
	|		ИНАЧЕ 0
	|	КОНЕЦ) КАК Размер20,
	|	СУММА(ВЫБОР
	|		КОГДА втТаблицаЗапросов.ТипКТК.РазмерКТК <> ЗНАЧЕНИЕ(Справочник.РазмерыКТК.К20)
	|			ТОГДА втТаблицаЗапросов.КоличествоКТК
	|		ИНАЧЕ 0
	|	КОНЕЦ) КАК Размер40
	|ИЗ
	|	втТаблицаЗапросов КАК втТаблицаЗапросов";

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("СписокЗапросНаКТК", Объект.СписокЗапросНаКТК.Выгрузить());
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда	
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
	
		ИтогиВсегоКТК20Фт = Выборка.Размер20;
		ИтогиВсегоКТК40Фт = Выборка.Размер40;
	КонецЕсли;	
	// Евросиб Фролов)
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТранспортныеСредстваИПеревозчиковСтроки(ИдентификаторСтроки,ТЧТранспортныеСредства)

	СтруктураДляПоиска = Новый Структура("ИдентификаторСтрокиЗапроса", ИдентификаторСтроки);
	
	//ДИТ Шевченко А.В. TASK 51973 01.06.2022 -Начало
	// Удаляем транспортные средства
	МассивСтрокДляУдаления = Объект[ТЧТранспортныеСредства].НайтиСтроки(СтруктураДляПоиска);
	
	Для Каждого УдаляемаяСтрока Из МассивСтрокДляУдаления Цикл
		Объект[ТЧТранспортныеСредства].Удалить(УдаляемаяСтрока);		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблицыЗапросНаКТК()
		
	// Евросиб Фролов (16.11.2021 TASK№ №41969
	Если НЕ Объект.ЗапросНаКТК Тогда
		Возврат;
	КонецЕсли;	
	
	// Евросиб Фролов (06.12.2021 TASK№ №42618, РелизКлиента
	ИдентификаторыСтрок = Объект.СписокЗапросНаКТК.Выгрузить().ВыгрузитьКолонку("ИдентификаторСтроки");
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	РелизыКлиентовЗапросовНаКТК.РелизКлиента КАК РелизКлиента,
	|	РелизыКлиентовЗапросовНаКТК.ИдентификаторСтрокиЗаявки КАК ИдентификаторСтрокиЗаявки
	|ИЗ
	|	РегистрСведений.РелизыКлиентовЗапросовНаКТК КАК РелизыКлиентовЗапросовНаКТК
	|ГДЕ
	|	РелизыКлиентовЗапросовНаКТК.Заявка = &Заявка
	|	И РелизыКлиентовЗапросовНаКТК.ИдентификаторСтрокиЗаявки В(&МассивИдетификаторов)";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Заявка", Объект.Ссылка);
	Запрос.УстановитьПараметр("МассивИдетификаторов", ИдентификаторыСтрок);
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаРелизов = РезультатЗапроса.Выгрузить();
	
	// Евросиб Фролов (28.04.2022 Task №50233
	МассивРелизов = Новый Массив;
	// Евросиб Фролов)
	
	Для Каждого СтрокаТаблицы Из Объект.СписокЗапросНаКТК Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.ИдентификаторСтроки) Тогда
			
			СтрокаРелиза = ТаблицаРелизов.Найти(СтрокаТаблицы.ИдентификаторСтроки, "ИдентификаторСтрокиЗаявки");
			
			Если СтрокаРелиза <> Неопределено Тогда
				СтрокаТаблицы.РелизКлиента = СтрокаРелиза.РелизКлиента;
				
				// Евросиб Фролов (28.04.2022 Task №50233
				МассивРелизов.Добавить(СтрокаТаблицы.РелизКлиента);
				// Евросиб Фролов)
			КонецЕсли;	
		КонецЕсли;
		
		// Евросиб Фролов (16.02.2022 Task №44768
		//ДИТ Шевченко А.В. TASK 51973 01.06.2022 -Начало //ЭлементУдален
		//Если СтрокаТаблицы.Автоперевозка = ПредопределенноеЗначение("Перечисление.ВариантыАвтоперевозки.СиламиЕвросиб") Тогда
		//	СтрокаТаблицы.ДанныеПоАвтоперевозке = "Заполняется сотрудником ОРП";
		//ИначеЕсли СтрокаТаблицы.Автоперевозка = ПредопределенноеЗначение("Перечисление.ВариантыАвтоперевозки.СиламиКлиента") Тогда
		//	СтрокаТаблицы.ДанныеПоАвтоперевозке = "Заполняется сотрудником ОРК во вложенной таблице ниже"; // Евросиб Фролов (16.02.2022 Task №44768
		//Иначе
		//	СтрокаТаблицы.ДанныеПоАвтоперевозке = "";
		//КонецЕсли;
		//ДИТ Шевченко А.В. TASK 51973 01.06.2022 -Начало //ЭлементКонец
		// Евросиб Фролов)
		
	КонецЦикла;
	// Евросиб Фролов)
	
	// Евросиб Фролов (28.04.2022 Task №50233
	ИнструкцииРелизов = Документы.Заявка.ТекстИнструкцииРелизаКлиента(МассивРелизов);
	Для Каждого СтрокаТаблицы Из Объект.СписокЗапросНаКТК Цикл
		СтрокаТаблицы.ИнструкцияПоСдаче = ИнструкцииРелизов.Получить(СтрокаТаблицы.РелизКлиента);
	КонецЦикла;	
	// Евросиб Фролов)
КонецПроцедуры

