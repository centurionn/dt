//позволяет получить список ктк по контейнерам по строкам кроме переданной
Функция ПолучитьСписокКткИзЗапросаКТКПоОстальнымСтрокам(НомерТекущейСтроки) 
	
	Контейнеры = Объект.СписокЗапросНаКТК.Выгрузить(,"СписокКТК, НомерСтроки");
	МассивКонтейнеров = Новый Массив;
	Для Каждого СтрокаКТК Из Контейнеры Цикл
		Если СтрокаКТК.НомерСтроки = НомерТекущейСтроки тогда
			Продолжить;
		Иначе	
			МассивТЕ = СтрРазделить(ОбщегоНазначенияВызовСервера.ПривестиСтрокуУчетныхЕдиницКТребуемомуФормату(СтрокаКТК.СписокКТК), ";", Ложь);
			Для Каждого Стр из МассивТЕ Цикл
				Если ТипЗнч(Стр) = Тип("Строка") Тогда
					МассивКонтейнеров.Добавить(РаботаСКонтейнерамиСервер.НайтиКТК(Стр)); 
				Иначе
					МассивКонтейнеров.Добавить(Стр);
				КонецЕсли;			
			КонецЦикла
		КонецЕсли;
	КонецЦикла;
	Возврат МассивКонтейнеров
	
