// ДИТ BUG 79844 ТА 79845 Сержантова А.С. 24.01.2024 
&НаКлиенте
Процедура ЗаполнитьДанныеТаблицАвтоперевозки(ДанныеСтрокиУслуг, ДобавлятьСтрокиВТС = Ложь)  
	
	СтруктураОтбора = Новый Структура("КлючАналитикиПеревозки", ДанныеСтрокиУслуг.КлючАналитикиПеревозки);
	СтрокиПервойМили = Объект.ТранспортныеСредства.НайтиСтроки(СтруктураОтбора);
	СтрокиПоследнейМили = Объект.ТранспортныеСредстваПоследняяМиля.НайтиСтроки(СтруктураОтбора);  
	
	СтрокиЗапроса = Объект.СписокЗапросНаКТК.НайтиСтроки(Новый Структура("РелизКлиента", ДанныеСтрокиУслуг.Релиз)); 
	ИдентификаторСтрокиЗапроса = Неопределено;
	Если СтрокиЗапроса.Количество() > 0 Тогда
		ИдентификаторСтрокиЗапроса = СтрокиЗапроса[0].ИдентификаторСтроки;	
	КонецЕсли;
	
	Если СтрокиПервойМили.Количество() Тогда 
		Для каждого СтрокаПервойМили Из СтрокиПервойМили Цикл
			СтрокаПервойМили.ФИОВодителя = ДанныеСтрокиУслуг.ФИОВодителя; 		
			СтрокаПервойМили.РегНомерТС = ДанныеСтрокиУслуг.НомерАвто; 		
			СтрокаПервойМили.Автоперевозчик = ДанныеСтрокиУслуг.АвтоперевозчикПерваяМиля; 	
			Если ТипЗнч(СтрокаПервойМили.Автоперевозчик) = Тип("СправочникСсылка.Контрагенты") Тогда
				ЗначенияРеквизитовКонтрагента = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(СтрокаПервойМили.Автоперевозчик, "ИНН, КПП");
				СтрокаПервойМили.ИНН = ЗначенияРеквизитовКонтрагента.ИНН; 
				СтрокаПервойМили.КПП = ЗначенияРеквизитовКонтрагента.КПП;
			// ДИТ US 78243 ТА 80825 Сержантова А.С. Начало: 20.02.2024
			//Иначе
			//	СтрокаПервойМили.ИНН = "";
			//	СтрокаПервойМили.КПП = ""; 
			// ДИТ US 78243 ТА 80825 Сержантова А.С. Конец: 20.02.2024
			КонецЕсли;
		КонецЦикла;  
	ИначеЕсли ДобавлятьСтрокиВТС и ИдентификаторСтрокиЗапроса <> Неопределено 
		и ДанныеСтрокиУслуг.ПерваяМиля = ПредопределенноеЗначение("Перечисление.ВариантыАвтоперевозки.СиламиКлиента") 
		// ДИТ US 78243 ТА 80591 Сержантова А.С. Начало: 07.02.2024
		и (ЗначениеЗаполнено(ДанныеСтрокиУслуг.АвтоперевозчикПерваяМиля) или ЗначениеЗаполнено(ДанныеСтрокиУслуг.НомерАвто) 
		или ЗначениеЗаполнено(ДанныеСтрокиУслуг.ФИОВодителя)) Тогда
		// ДИТ US 78243 ТА 80591 Сержантова А.С. Конец: 07.02.2024
		НС = Объект.ТранспортныеСредства.Добавить();   
		НС.КлючАналитикиПеревозки = ДанныеСтрокиУслуг.КлючАналитикиПеревозки;
		НС.ФИОВодителя = ДанныеСтрокиУслуг.ФИОВодителя; 		
		НС.РегНомерТС = ДанныеСтрокиУслуг.НомерАвто; 	
		НС.ИдентификаторСтрокиЗапроса = ИдентификаторСтрокиЗапроса;
		НС.Автоперевозчик = ДанныеСтрокиУслуг.АвтоперевозчикПерваяМиля; 
		Если ТипЗнч(НС.Автоперевозчик) = Тип("СправочникСсылка.Контрагенты") Тогда
			ЗначенияРеквизитовКонтрагента = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(НС.Автоперевозчик, "ИНН, КПП");
			НС.ИНН = ЗначенияРеквизитовКонтрагента.ИНН; 
			НС.КПП = ЗначенияРеквизитовКонтрагента.КПП;
		Иначе
			НС.ИНН = "";
			НС.КПП = "";
		КонецЕсли;
	КонецЕсли;
	
	Если СтрокиПоследнейМили.Количество() Тогда 
		Для каждого СтрокаПоследнейМили Из СтрокиПоследнейМили Цикл
			СтрокаПоследнейМили.ФИОВодителя = ДанныеСтрокиУслуг.ФИОВодителяВыгрузка; 		
			СтрокаПоследнейМили.РегНомерТС = ДанныеСтрокиУслуг.НомерАвтоВыгрузка; 		
			СтрокаПоследнейМили.Автоперевозчик = ДанныеСтрокиУслуг.АвтоПеревозчик; 	
			Если ТипЗнч(СтрокаПоследнейМили.Автоперевозчик) = Тип("СправочникСсылка.Контрагенты") Тогда
				ЗначенияРеквизитовКонтрагента = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(СтрокаПоследнейМили.Автоперевозчик, "ИНН, КПП");
				СтрокаПоследнейМили.ИНН = ЗначенияРеквизитовКонтрагента.ИНН; 
				СтрокаПоследнейМили.КПП = ЗначенияРеквизитовКонтрагента.КПП;   
			// ДИТ US 78243 ТА 80825 Сержантова А.С. Начало: 20.02.2024
			//Иначе
			//	СтрокаПоследнейМили.ИНН = "";
			//	СтрокаПоследнейМили.КПП = ""; 
			// ДИТ US 78243 ТА 80825 Сержантова А.С. Конец: 20.02.2024
			КонецЕсли;
		КонецЦикла;   
	ИначеЕсли ДобавлятьСтрокиВТС и ИдентификаторСтрокиЗапроса <> Неопределено 
		и ДанныеСтрокиУслуг.ПоследняяМиля = ПредопределенноеЗначение("Перечисление.ВариантыАвтоперевозки.СиламиКлиента") 
		// ДИТ US 78243 ТА 80591 Сержантова А.С. Начало: 07.02.2024
		и (ЗначениеЗаполнено(ДанныеСтрокиУслуг.Автоперевозчик) или ЗначениеЗаполнено(ДанныеСтрокиУслуг.НомерАвтоВыгрузка) 
		или ЗначениеЗаполнено(ДанныеСтрокиУслуг.ФИОВодителяВыгрузка)) Тогда
		// ДИТ US 78243 ТА 80591 Сержантова А.С. Конец: 07.02.2024
		НС = Объект.ТранспортныеСредстваПоследняяМиля.Добавить();   
		НС.КлючАналитикиПеревозки = ДанныеСтрокиУслуг.КлючАналитикиПеревозки;
		НС.ФИОВодителя = ДанныеСтрокиУслуг.ФИОВодителяВыгрузка; 		
		НС.РегНомерТС = ДанныеСтрокиУслуг.НомерАвтоВыгрузка; 
		НС.ИдентификаторСтрокиЗапроса = ИдентификаторСтрокиЗапроса;
		НС.Автоперевозчик = ДанныеСтрокиУслуг.АвтоПеревозчик; 	
		Если ТипЗнч(НС.Автоперевозчик) = Тип("СправочникСсылка.Контрагенты") Тогда
			ЗначенияРеквизитовКонтрагента = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(НС.Автоперевозчик, "ИНН, КПП");
			НС.ИНН = ЗначенияРеквизитовКонтрагента.ИНН; 
			НС.КПП = ЗначенияРеквизитовКонтрагента.КПП;   
		Иначе
			НС.ИНН = "";
			НС.КПП = "";
		КонецЕсли;
	КонецЕсли;
	
	// ДИТ US 78243 ТА 80825 Сержантова А.С. Начало: 19.02.2024
	СтруктураОтбора.Вставить("ЭтапПеревозки", ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПерваяМиля"));
	СтруктураОтбора.Вставить("КлючАналитикиПеревозки", ДанныеСтрокиУслуг.КлючАналитикиПеревозки);	
	// ДИТ US 78243 ТА 80825 Сержантова А.С. Конец: 19.02.2024
	СтрокиСиламиЕвросиб = ТранспортныеСредстваСиламиЕвросиб.НайтиСтроки(СтруктураОтбора);
	
	Если СтрокиСиламиЕвросиб.Количество() Тогда 
		Для каждого СтрокаМили Из СтрокиСиламиЕвросиб Цикл  
			СтрокаМили.ФИОВодителя = ДанныеСтрокиУслуг.ФИОВодителя; 		
			СтрокаМили.РегНомерТС = ДанныеСтрокиУслуг.НомерАвто; 		
			СтрокаМили.Автоперевозчик = ДанныеСтрокиУслуг.АвтоперевозчикПерваяМиля; 	
			Если ТипЗнч(СтрокаМили.Автоперевозчик) = Тип("СправочникСсылка.Контрагенты") Тогда
				ЗначенияРеквизитовКонтрагента = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(СтрокаМили.Автоперевозчик, "ИНН, КПП");
				СтрокаМили.ИНН = ЗначенияРеквизитовКонтрагента.ИНН; 
				СтрокаМили.КПП = ЗначенияРеквизитовКонтрагента.КПП;
			// ДИТ US 78243 ТА 80825 Сержантова А.С. Начало: 20.02.2024
			//Иначе
			//	СтрокаМили.ИНН = "";
			//	СтрокаМили.КПП = "";
			// ДИТ US 78243 ТА 80825 Сержантова А.С. Конец: 20.02.2024
			КонецЕсли;
		КонецЦикла; 
	Иначе  
		СтрокиЗапроса = Объект.СписокЗапросНаКТК.НайтиСтроки(Новый Структура("РелизКлиента", ДанныеСтрокиУслуг.Релиз));
		Если СтрокиЗапроса.Количество() > 0 и ЗначениеЗаполнено(СтрокиЗапроса[0].ИдентификаторСтроки) Тогда 
			
			Если ДанныеСтрокиУслуг.ПерваяМиля = ПредопределенноеЗначение("Перечисление.ВариантыАвтоперевозки.СиламиКлиента") Тогда
				СтрокаПервойМили = ТранспортныеСредстваСиламиЕвросиб.Добавить();  
				СтрокаПервойМили.ЭтапПеревозки = ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПерваяМиля"); 
				СтрокаПервойМили.КлючАналитикиПеревозки = ДанныеСтрокиУслуг.КлючАналитикиПеревозки; 
				СтрокаПервойМили.ИдентификаторСтрокиЗапроса = СтрокиЗапроса[0].ИдентификаторСтроки;
				СтрокаПервойМили.ФИОВодителя = ДанныеСтрокиУслуг.ФИОВодителя; 		
				СтрокаПервойМили.РегНомерТС = ДанныеСтрокиУслуг.НомерАвто; 		
				СтрокаПервойМили.Автоперевозчик = ДанныеСтрокиУслуг.АвтоперевозчикПерваяМиля; 	
				Если ТипЗнч(СтрокаПервойМили.Автоперевозчик) = Тип("СправочникСсылка.Контрагенты") Тогда
					ЗначенияРеквизитовКонтрагента = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(СтрокаПервойМили.Автоперевозчик, "ИНН, КПП");
					СтрокаПервойМили.ИНН = ЗначенияРеквизитовКонтрагента.ИНН; 
					СтрокаПервойМили.КПП = ЗначенияРеквизитовКонтрагента.КПП;
				Иначе
					СтрокаПервойМили.ИНН = "";
					СтрокаПервойМили.КПП = "";
				КонецЕсли; 
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;   
	
	СтруктураОтбора.ЭтапПеревозки = ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПоследняяМиля");
	СтрокиСиламиЕвросиб = ТранспортныеСредстваСиламиЕвросиб.НайтиСтроки(СтруктураОтбора);
	
	Если СтрокиСиламиЕвросиб.Количество() Тогда 
		Для каждого СтрокаМили Из СтрокиСиламиЕвросиб Цикл  
			СтрокаМили.ФИОВодителя = ДанныеСтрокиУслуг.ФИОВодителяВыгрузка; 		
			СтрокаМили.РегНомерТС = ДанныеСтрокиУслуг.НомерАвтоВыгрузка; 		
			СтрокаМили.Автоперевозчик = ДанныеСтрокиУслуг.АвтоПеревозчик; 	
			Если ТипЗнч(СтрокаМили.Автоперевозчик) = Тип("СправочникСсылка.Контрагенты") Тогда
				ЗначенияРеквизитовКонтрагента = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(СтрокаМили.Автоперевозчик, "ИНН, КПП");
				СтрокаМили.ИНН = ЗначенияРеквизитовКонтрагента.ИНН; 
				СтрокаМили.КПП = ЗначенияРеквизитовКонтрагента.КПП;   
			// ДИТ US 78243 ТА 80825 Сержантова А.С. Начало: 20.02.2024
			//Иначе
			//	СтрокаМили.ИНН = "";
			//	СтрокаМили.КПП = ""; 
			// ДИТ US 78243 ТА 80825 Сержантова А.С. Конец: 20.02.2024
			КонецЕсли;
		КонецЦикла; 
	Иначе  
		СтрокиЗапроса = Объект.СписокЗапросНаКТК.НайтиСтроки(Новый Структура("РелизКлиента", ДанныеСтрокиУслуг.Релиз));
		Если СтрокиЗапроса.Количество() > 0 и ЗначениеЗаполнено(СтрокиЗапроса[0].ИдентификаторСтроки) Тогда 
			Если ДанныеСтрокиУслуг.ПоследняяМиля = ПредопределенноеЗначение("Перечисление.ВариантыАвтоперевозки.СиламиКлиента") Тогда
				СтрокаПоследнейМили = ТранспортныеСредстваСиламиЕвросиб.Добавить();  
				СтрокаПоследнейМили.ЭтапПеревозки = ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПоследняяМиля"); 
				СтрокаПоследнейМили.КлючАналитикиПеревозки = ДанныеСтрокиУслуг.КлючАналитикиПеревозки; 
				СтрокаПоследнейМили.ИдентификаторСтрокиЗапроса = СтрокиЗапроса[0].ИдентификаторСтроки;
				СтрокаПоследнейМили.ФИОВодителя = ДанныеСтрокиУслуг.ФИОВодителяВыгрузка; 		
				СтрокаПоследнейМили.РегНомерТС = ДанныеСтрокиУслуг.НомерАвтоВыгрузка; 		
				СтрокаПоследнейМили.Автоперевозчик = ДанныеСтрокиУслуг.АвтоПеревозчик; 	
				Если ТипЗнч(СтрокаПоследнейМили.Автоперевозчик) = Тип("СправочникСсылка.Контрагенты") Тогда
					ЗначенияРеквизитовКонтрагента = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(СтрокаПоследнейМили.Автоперевозчик, "ИНН, КПП");
					СтрокаПоследнейМили.ИНН = ЗначенияРеквизитовКонтрагента.ИНН; 
					СтрокаПоследнейМили.КПП = ЗначенияРеквизитовКонтрагента.КПП;
				Иначе
					СтрокаПоследнейМили.ИНН = "";
					СтрокаПоследнейМили.КПП = "";
				КонецЕсли; 
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;   
	
	УстановитьОтборТранспортныхСредств();
	
КонецПроцедуры

