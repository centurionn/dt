		Если НайденныеСтроки.Количество() > 0
			И ЗначениеЗаполнено(Параметр.Релиз) Тогда
			ЭтаФорма.Прочитать(); //ДИТ Шевченко А.В. BUG 75526 TA 75527 02.10.23 -Начало
			СтрокаДанных = НайденныеСтроки[0];
			СтрокаДанных.РелизКлиента = Параметр.Релиз;
			//ДИТ Шевченко А.В. US 62482 ТА 68277 17.04.2023 -Начало
			МассивСтруктур = Параметр.МассивКлючей;
			Для Каждого ЗнчМ Из МассивСтруктур Цикл
				СтруктураПоиска = Новый Структура("КлючАналитикиПеревозки",ЗнчМ.Ключ);
				НайденныеСтроки = Объект.СоставУслуги.НайтиСтроки(СтруктураПоиска);
				Если НайденныеСтроки.Количество() = 0 Тогда
					НовСтрока = Объект.СоставУслуги.Добавить();
					НовСтрока.КлючАналитикиПеревозки = ЗнчМ.Ключ;
					НовСтрока.ПринадлежностьТЕ = ПредопределенноеЗначение("Перечисление.ПринадлежностьТЕ.КТЕвросиба");
					НовСтрока.Релиз = Параметр.Релиз;
					//ДИТ Шевченко А.В. BUG 75898 TA 75908 10.10.2023
					// ДИТ 89973 Давудов М.А. Начало: 21.08.2024
					//ок(
					//НовСтрока.СобственностьПеревозимогоКТК = ПредопределенноеЗначение("Перечисление.СобственностьПеревозимогоКонтейнера.COC");
					//ок)
					НовСтрока.УдалитьСобственностьПеревозимогоКТК = ПредопределенноеЗначение("Перечисление.УдалитьСобственностьПеревозимогоКонтейнера.COC");
					// ДИТ 89973 Давудов М.А. Конец: 21.08.2024
					НовСтрока.ПерваяМиля = Параметр.Автоперевозка;
					НовСтрока.ПоследняяМиля = Параметр.АвтоперевозкаПоследняяМиля;
					//ДИТ Шевченко А.В. BUG 75898 TA 75908 10.10.2023  
					// ДИТ BUG 76435 Сержантова А.С. Начало: 23.11.2023
					НовСтрока.НормативноеИспользование = Параметр.НормативноеИспользование;
					// ДИТ BUG 76435 Сержантова А.С. Конец: 23.11.2023
					НовСтрока.ИдентификаторСтрокиРелизаКлиента = ЗнчМ.ИдентификаторСтроки;
					НовСтрока.ГУИДСтроки = Строка(Новый УникальныйИдентификатор());
