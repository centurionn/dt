&НаСервереБезКонтекста
Функция ПолучитьКлючиИзРелизаКлиента(РелизКлиента,МассивКлючей,ЭтапПеревозки)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РелизКлиентаКонтейнеры.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
		|	КлючиАналитикиПеревозкиМили.ФИОВодителя КАК ФИОВодителя,
		|	КлючиАналитикиПеревозкиМили.ПаспортныеДанные КАК ПаспортныеДанные,
		|	КлючиАналитикиПеревозкиМили.РегНомерТС КАК РегНомерТС,
		|	КлючиАналитикиПеревозкиМили.Автоперевозчик КАК Автоперевозчик,
		|	КлючиАналитикиПеревозкиМили.ИНН КАК ИНН,
		|	КлючиАналитикиПеревозкиМили.КПП КАК КПП,
		|	КлючиАналитикиПеревозкиМили.Ссылка.Контейнер КАК Контейнер,
		|	КлючиАналитикиПеревозкиМили.Ссылка.ВерсияДанных КАК ВерсияКлюча
		|ИЗ
		|	Документ.РелизКлиента.Контейнеры КАК РелизКлиентаКонтейнеры
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки КАК КлючиАналитикиПеревозки
		|		ПО РелизКлиентаКонтейнеры.КлючАналитикиПеревозки = КлючиАналитикиПеревозки.Ссылка
		|			И (КлючиАналитикиПеревозки.Ссылка В (&МассивКлючей))
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиПеревозки.Мили КАК КлючиАналитикиПеревозкиМили
		|		ПО РелизКлиентаКонтейнеры.КлючАналитикиПеревозки = КлючиАналитикиПеревозкиМили.Ссылка
		|			И (КлючиАналитикиПеревозкиМили.ЭтапПеревозки = &ЭтапПеревозки)
		|ГДЕ
		|	РелизКлиентаКонтейнеры.Ссылка = &Ссылка
		|	И КлючиАналитикиПеревозки.Ссылка ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Ссылка", РелизКлиента);
	Запрос.УстановитьПараметр("ЭтапПеревозки", ЭтапПеревозки);
	Запрос.УстановитьПараметр("МассивКлючей", МассивКлючей);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	СтруктураОтвет = Новый Структура;
	СтруктураОтвет.Вставить("ПустойКлюч",Истина);
	МассивСтруктура = новый Массив;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтруктураОтвет.Вставить("ПустойКлюч",Ложь);
		МассивСтруктура.Добавить(Новый Структура("ФИОВодителя,ПаспортныеДанные,РегНомерТС,Автоперевозчик,ИНН,КПП,Контейнер,КлючАналитикиПеревозки,ВерсияКлюча"
																,ВыборкаДетальныеЗаписи.ФИОВодителя
																,ВыборкаДетальныеЗаписи.ПаспортныеДанные
																,ВыборкаДетальныеЗаписи.РегНомерТС
																,ВыборкаДетальныеЗаписи.Автоперевозчик
																,ВыборкаДетальныеЗаписи.ИНН
																,ВыборкаДетальныеЗаписи.КПП
																,ВыборкаДетальныеЗаписи.Контейнер
																,ВыборкаДетальныеЗаписи.КлючАналитикиПеревозки
																,ВыборкаДетальныеЗаписи.ВерсияКлюча)); 
		
	КонецЦикла;
		СтруктураОтвет.Вставить("КлючРелиза",МассивСтруктура);
	Возврат СтруктураОтвет;
КонецФункции	

&НаСервере
Процедура ЗаполнитьДобавленныеКолонки()	//ДИТ Шевченко А.В. US 62482 ТА 71463 21.06.2023
	ТабличнаяЧасть 			= Объект.СоставУслуги.Выгрузить();
	МассивКонтейнеров 		= Новый Массив;
	Для Каждого СтрокаТЧ из ТабличнаяЧасть Цикл
		Если ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.КлючАналитикиПеревозки,"Контейнер")) Тогда
			МассивКонтейнеров.Добавить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.КлючАналитикиПеревозки,"Контейнер"));
		КонецЕсли;	
	КонецЦикла;	
	ДанныеКТК 	= Документы.РелизКлиента.ПолучитьИнструкции(МассивКонтейнеров);
	Для Каждого ТекущаяСтрока Из Объект.СоставУслуги Цикл
		Если ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущаяСтрока.КлючАналитикиПеревозки,"Контейнер")) Тогда
			//ДИТ Шевченко А.В. 28.09.2023 Ticket#0325760 +
			Если НЕ ТекущаяСтрока.ПринадлежностьТЕ = Перечисления.ПринадлежностьТЕ.КТКлиента Тогда
				ДанныеТекущегоКТК = ДанныеКТК.Получить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущаяСтрока.КлючАналитикиПеревозки,"Контейнер"));
				Если ДанныеТекущегоКТК <> Неопределено Тогда
					ТекущаяСтрока.ВладелецКТК = ДанныеТекущегоКТК.СобственникКТК;
					ТекущаяСтрока.ВидСобственности = ДанныеТекущегоКТК.ВидСобственности;
					//ТекущаяСтрока.ПринадлежностьТЕ = АРМ_Сервер.ОпределитьПринадлежностьПоВидуСобственности(ДанныеТекущегоКТК.ВидСобственности);
				Иначе
					ТекущаяСтрока.ВладелецКТК 		= Справочники.Контрагенты.ПустаяСсылка();
					ТекущаяСтрока.ВидСобственности	= ПредопределенноеЗначение("Перечисление.ВариантыСобственности.ПустаяСсылка");
				КонецЕсли;
			КонецЕсли;
			//ДИТ Шевченко А.В. 28.09.2023 Ticket#0325760 -
		КонецЕсли;	
	КонецЦикла; 	
КонецПроцедуры

