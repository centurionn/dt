&НаСервереБезКонтекста
Функция КлиентИзСписка(Клиент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ФормированиеФинДокументов.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ФормированиеФинДокументов КАК ФормированиеФинДокументов
	               |ГДЕ
	               |	ФормированиеФинДокументов.Контрагент = &Контрагент";
	Запрос.УстановитьПараметр("Контрагент",Клиент);
	Если НЕ Запрос.Выполнить().Пустой() Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции
	
&НаКлиенте
Процедура СоставУслугиТипКТКПриИзменении(Элемент)
	
	ИдентификаторСтроки = Элементы.СоставУслуги.ТекущаяСтрока;
	Если ИдентификаторСтроки <> Неопределено Тогда
		СоставУслугиНомерКТКПриИзмененииСервер(ИдентификаторСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере 
Процедура СоставУслугиНомерКТКПриИзмененииСервер(ИдентификаторСтроки)
	
	ТекДанные = Объект.СоставУслуги.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	ЗначениеРеквизитаОбъекта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекДанные.ТипКТК, "РазмерКТК");
	Если ЗначениеЗаполнено(ЗначениеРеквизитаОбъекта) Тогда
		ТекДанные.РазмерКТК = ЗначениеРеквизитаОбъекта;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставУслугиНомерКТКПриИзменении(Элемент)
	
	ТекД = Элементы.СоставУслуги.ТекущиеДанные;  
	
	// ДИТ BUG 81219 ТА 81220 Сержантова А.С. Начало: 16.02.2024
	Если ТипЗнч(Элемент) = Тип("ДанныеФормыЭлементКоллекции") Тогда
		ТекД = Элемент;
	КонецЕсли;
	// ДИТ BUG 81219 ТА 81220 Сержантова А.С. Конец: 16.02.2024
	
	Если ТекД <> неопределено Тогда
		
		ТипКТК = ПолучитьТипКТК(ТекД.НомерКТК);
		ЗаполнитьЗначенияСвойств(ТекД, ТипКТК);
		
		ОбновитьСВВиТДТ_Клиент(ТекД.НомерКТК);
		// ДИТ US 62421 TA 64346 Евсенкин М.А. Начало: 03.02.2023
		НайтиКлючАналитикиПеревозкиКлиент(ТекД);
		// ДИТ US 62421 TA 64346 Евсенкин М.А. Конец: 03.02.2023
		
		// ДИТ US 76659 ТА 77825 Сержантова А.С. Начало: 26.02.2024
		// Было:
		//// ДИТ 65580 Давудов М.А. Начало: 23.02.2023
		//ЗаполнитьСвязанныеПоляПринадлежностьТЕ(ТекД.ПолучитьИдентификатор());
		//// ДИТ 65580 Давудов М.А. Конец: 23.02.2023 
		//Стало:
		ЗаполнитьСобственностьПриВыбореКонтейнера(ТекД.ПолучитьИдентификатор());
		// ДИТ US 76659 ТА 77825 Сержантова А.С. Конец: 26.02.2024
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТипКТК(КТК)
	
	Результат = Новый Структура("ТипКТК, РазмерКТК");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТЕ.ТипТЕ КАК ТипТЕ,
	               |	ТЕ.ТипТЕ.РазмерКТК КАК РазмерКТК
	               |ИЗ
	               |	Справочник.ТЕ КАК ТЕ
	               |ГДЕ
	               |	ТЕ.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", КТК);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.ТипКТК = Выборка.ТипТЕ;
		Результат.РазмерКТК = Выборка.РазмерКТК;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура СоставУслугиРазмерКТКПриИзменении(Элемент)
	
	ИдентификаторСтроки = Элементы.СоставУслуги.ТекущаяСтрока;
	Если ИдентификаторСтроки <> Неопределено Тогда
		
		ТекДанные = Элементы.СоставУслуги.ТекущиеДанные;
		Если НЕ ЗначениеЗаполнено(ТекДанные.РазмерКТК) Тогда
			ТекДанные.НомерКТК = ПредопределенноеЗначение("Справочник.ТЕ.ПустаяСсылка");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ЗаполнятьСтрокиПоПервойСтроке(Команда)
	
	ЗаполнятьПоПервойСтроке = НЕ ЗаполнятьПоПервойСтроке;
	Элементы.СоставУслугиЗаполнятьСтрокиПоПервойСтроке.ЦветФона = ?(ЗаполнятьПоПервойСтроке, ЦветКнопки_Выделенный, ЦветКнопки_Исходный);
	
КонецПроцедуры


