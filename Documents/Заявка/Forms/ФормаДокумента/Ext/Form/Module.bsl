			СтруктураКлючаАналитикиПеревозки.Заявка = Объект.Ссылка; 
			// ДИТ BUG 79844 Сержантова А.С. Начало: 16.01.2024
			СтруктураКлючаАналитикиПеревозки.КлючАналитики = СтрокаТЧ.КлючАналитикиПеревозки; 
			// ДИТ BUG 79844 Сержантова А.С. Конец: 16.01.2024
			
			МилиКлючаПервая = Новый Структура;
			МилиКлючаПервая.Вставить("ФИОВодителя", СтрокаТЧ.ФИОВодителя);
			МилиКлючаПервая.Вставить("РегНомерТС", СтрокаТЧ.РегНомерТС); 
			МилиКлючаПервая.Вставить("Автоперевозчик", СтрокаТЧ.Автоперевозчик);
			МилиКлючаПервая.Вставить("ПаспортныеДанные", СтрокаТЧ.ПаспортныеДанные);
			МилиКлючаПервая.Вставить("ИНН", СтрокаТЧ.ИНН);
			МилиКлючаПервая.Вставить("КПП", СтрокаТЧ.КПП); 
			ЗаполнитьЗначенияСвойств(СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиПерваяМиляКлючаАналитики, МилиКлючаПервая); 
			
			// ДИТ US 78243 ТА 80825 Сержантова А.С. Начало: 20.02.2024 
			//если ключа нет в услугах и нет в таблице по последней миле, то очищаем данные по последней миле
			СтрокиВПоследнейМиле = Объект.ТранспортныеСредстваПоследняяМиля.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки", СтрокаТЧ.КлючАналитикиПеревозки));
			Если СтрокиВПоследнейМиле.Количество() = 0 Тогда 
				МилиКлючаПоследняя = Новый Структура("ФИОВодителя, РегНомерТС, Автоперевозчик, ПаспортныеДанные, ИНН, КПП","","","","","","");
				ЗаполнитьЗначенияСвойств(СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиПоследняяМиляКлючаАналитики, МилиКлючаПоследняя);
			КонецЕсли;
			// ДИТ US 78243 ТА 80825 Сержантова А.С. Конец: 20.02.2024

			// ДИТ BUG 79844 Сержантова А.С. Начало: 16.01.2024  
			СтрокаЗапроса = Объект.СписокЗапросНаКТК.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаТЧ.ИдентификаторСтрокиЗапроса));   
			ВариантАвтоперевозки = Перечисления.ВариантыАвтоперевозки.НеТребуется;
			Если СтрокаЗапроса.Количество() = 1 Тогда
				ВариантАвтоперевозки = СтрокаЗапроса[0].Автоперевозка;
				НомерСтрокиЗапроса = СтрокаЗапроса[0].НомерСтроки; 
			КонецЕсли;
			СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиПерваяМиляКлючаАналитики.Вставить("ВариантАвтоперевозки", ВариантАвтоперевозки); 
			СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиПерваяМиляКлючаАналитики.Вставить("НомерСтрокиЗапроса", НомерСтрокиЗапроса);
			// ДИТ BUG 79844 Сержантова А.С. Конец: 16.01.2024
			
			НС = ДанныеОбновленияКлючейАналитики.Добавить(); 
			НС.НомерСтроки 				= СтрокаТЧ.НомерСтроки;
			НС.КлючАналитикиПеревозки 	= СтрокаТЧ.КлючАналитикиПеревозки;  
			НС.ДанныеКлюча 				= СтруктураКлючаАналитикиПеревозки;
			НС.ИсточникКлюча 			= "ТранспортныеСредства";
		КонецЕсли;
	КонецЦикла;
	
	Для каждого СтрокаТЧ Из Объект.ТранспортныеСредстваПоследняяМиля Цикл  
		СтрокиВУслугах = Объект.СоставУслуги.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки", СтрокаТЧ.КлючАналитикиПеревозки));
		Если СтрокиВУслугах.Количество() = 0 Тогда   
			
			СтруктураКлючаАналитикиПеревозки = Справочники.КлючиАналитикиПеревозки.СтруктураКлючаАналитикиПеревозки(); 
			СтруктураКлючаАналитикиПеревозки.Заявка = Объект.Ссылка;    
			// ДИТ BUG 79844 Сержантова А.С. Начало: 16.01.2024
			СтруктураКлючаАналитикиПеревозки.КлючАналитики = СтрокаТЧ.КлючАналитикиПеревозки; 
			СтруктураКлючаАналитикиПеревозки.Контейнер = СтрокаТЧ.Контейнер;    
			// ДИТ BUG 79844 Сержантова А.С. Конец: 16.01.2024
			
			МилиКлючаПервая = Новый Структура;
			МилиКлючаПервая.Вставить("ФИОВодителя", СтрокаТЧ.ФИОВодителя);
			МилиКлючаПервая.Вставить("РегНомерТС", СтрокаТЧ.РегНомерТС); 
			МилиКлючаПервая.Вставить("Автоперевозчик", СтрокаТЧ.Автоперевозчик);
			МилиКлючаПервая.Вставить("ПаспортныеДанные", СтрокаТЧ.ПаспортныеДанные);
			МилиКлючаПервая.Вставить("ИНН", СтрокаТЧ.ИНН);
			МилиКлючаПервая.Вставить("КПП", СтрокаТЧ.КПП); 
			ЗаполнитьЗначенияСвойств(СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиПоследняяМиляКлючаАналитики, МилиКлючаПервая);
			
			// ДИТ US 78243 ТА 80825 Сержантова А.С. Начало: 20.02.2024 
			//если ключа нет в услугах и нет в таблице по первой миле, то очищаем данные по первой миле
			СтрокиВПервойМиле = Объект.ТранспортныеСредства.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки", СтрокаТЧ.КлючАналитикиПеревозки));
			Если СтрокиВПервойМиле.Количество() = 0 Тогда 
				МилиКлючаПервая = Новый Структура("ФИОВодителя, РегНомерТС, Автоперевозчик, ПаспортныеДанные, ИНН, КПП","","","","","","");
				ЗаполнитьЗначенияСвойств(СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиПерваяМиляКлючаАналитики, МилиКлючаПервая);
			КонецЕсли;
			// ДИТ US 78243 ТА 80825 Сержантова А.С. Конец: 20.02.2024
			
			// ДИТ BUG 79844 Сержантова А.С. Начало: 16.01.2024
			СтрокаЗапроса = Объект.СписокЗапросНаКТК.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаТЧ.ИдентификаторСтрокиЗапроса));   
			ВариантАвтоперевозки = Перечисления.ВариантыАвтоперевозки.НеТребуется;
			Если СтрокаЗапроса.Количество() = 1 Тогда
				ВариантАвтоперевозки = СтрокаЗапроса[0].ПоследняяМиля; 
				НомерСтрокиЗапроса = СтрокаЗапроса[0].НомерСтроки;
			КонецЕсли;
			СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиПоследняяМиляКлючаАналитики.Вставить("ВариантАвтоперевозки", ВариантАвтоперевозки);	
			СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиПоследняяМиляКлючаАналитики.Вставить("НомерСтрокиЗапроса", НомерСтрокиЗапроса);
			// ДИТ BUG 79844 Сержантова А.С. Конец: 16.01.2024
			
			НС = ДанныеОбновленияКлючейАналитики.Добавить(); 
			НС.НомерСтроки 				= СтрокаТЧ.НомерСтроки;
			НС.КлючАналитикиПеревозки 	= СтрокаТЧ.КлючАналитикиПеревозки;  
			НС.ДанныеКлюча 				= СтруктураКлючаАналитикиПеревозки;
			НС.ИсточникКлюча 			= "ТранспортныеСредстваПоследняяМиля";
		КонецЕсли;
	КонецЦикла;
	
	Возврат ДанныеОбновленияКлючейАналитики;
	
КонецФункции  

// ДИТ US 76935 ТА 78649 Сержантова А.С. 26.12.2023 
//Если на вкладке Состав услуг данные не заполнены, возьмем со вкладки Запрос на КТК
&НаСервере
Процедура ЗаполнитьСтруктуруМилиКлючаИзЗапросаНаКТК(КлючАналитикиПеревозки, СтруктураКлюча, ТЧИсточникЗаполнения)

	Если ТЧИсточникЗаполнения.Количество() = 0 или не Объект.ЗапросНаКТК Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура("КлючАналитикиПеревозки", КлючАналитикиПеревозки);
	ДанныеТранспортныхСредствПоКлючу = ТЧИсточникЗаполнения.НайтиСтроки(Отбор);
	Если ДанныеТранспортныхСредствПоКлючу.Количество() > 0 Тогда
		Для каждого РеквизитКлюча Из СтруктураКлюча Цикл
			ИмяРеквизита = РеквизитКлюча.Ключ; 
			Если не ЗначениеЗаполнено(РеквизитКлюча.Значение) 
				и ТЧИсточникЗаполнения[0].Свойство(ИмяРеквизита) Тогда
				СтруктураКлюча[ИмяРеквизита] = ДанныеТранспортныхСредствПоКлючу[0][ИмяРеквизита]; 
			КонецЕсли;
		КонецЦикла;  
		// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Начало: 25.03.2024
		СтруктураКлюча.Вставить("ПаспортныеДанные", ДанныеТранспортныхСредствПоКлючу[0].ПаспортныеДанные);
		// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Конец: 25.03.2024
	КонецЕсли;
		
КонецПроцедуры 

