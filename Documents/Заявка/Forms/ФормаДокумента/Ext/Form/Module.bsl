&НаСервере
Процедура ОбработатьВыборКонтейнеровИзАРМНакладныеСервер(АдресТаблицы)
	
	ВыбранныеНакладные = ПолучитьИзВременногоХранилища(АдресТаблицы);
	УдалитьИзВременногоХранилища(АдресТаблицы);
		
	Для Каждого Стр Из ВыбранныеНакладные Цикл
		
		Если Стр.ГрузоотправительСсылка <> Объект.Грузоотправитель Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиПоКонтейнеру = Объект.СоставУслуги.НайтиСтроки(Новый Структура("НомерКТК", Стр.КонтейнерСсылка));
		Если СтрокиПоКонтейнеру.Количество() > 0 Тогда
			ТекстСообщения = СтрШаблон("Контейнер %1 уже выбран в строке №%2!", Стр.КонтейнерСсылка, СтрокиПоКонтейнеру[0].НомерСтроки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Продолжить;
		КонецЕсли;
		
		СтрокиБезКонтейнера = Объект.СоставУслуги.НайтиСтроки(Новый Структура("НомерКТК, Грузополучатель", Справочники.ТЕ.ПустаяСсылка(), Стр.ГрузополучательСсылка));
		Если СтрокиБезКонтейнера.Количество() > 0 Тогда
			СтрокаЗаявки = СтрокиБезКонтейнера[0];
			СтрокаЗаявки.НомерКТК = Стр.КонтейнерСсылка;
			СтрокаЗаявки.ТипКТК = Стр.ТипКонтейнера;
			СтрокаЗаявки.РазмерКТК = Стр.РазмерКонтейнера;
			// ДИТ US 76659 ТА 77825 Сержантова А.С. Начало: 20.02.2024 
			// Было:
			//СтрокаЗаявки.ВидСобственности = Стр.ПризнакСобственности;
			//Если ЗначениеЗаполнено(СтрокаЗаявки.ВидСобственности) Тогда
			//	СтрокаЗаявки.ПринадлежностьТЕ = ПредопределенноеЗначение("Перечисление.ПринадлежностьТЕ.КТЕвросиба");
			//Иначе
			//	СтрокаЗаявки.ПринадлежностьТЕ = ПредопределенноеЗначение("Перечисление.ПринадлежностьТЕ.КТКлиента");
			//КонецЕсли;
			//// ДИТ 65580 Давудов М.А. Начало: 23.02.2023
			//ЗаполнитьСвязанныеПоляПринадлежностьТЕ(СтрокаЗаявки);
			//// ДИТ 65580 Давудов М.А. Конец: 23.02.2023  
			ЗаполнитьСобственностьПриВыбореКонтейнера(СтрокаЗаявки.ПолучитьИдентификатор());
			// ДИТ US 76659 ТА 77825 Сержантова А.С. Конец: 20.02.2024  
			
			// ДИТ US 81881 ТА 81882 Сержантова А.С. Начало: 28.03.2024
			ЗаполнитьВСтрокеГрузыИзНакладной(СтрокаЗаявки, Стр.Документ); 
			// ДИТ US 81881 ТА 81882 Сержантова А.С. Конец: 28.03.2024
		Иначе
			ТекстСообщения = СтрШаблон("Контейнер %3 не добавлен, т.к. не найдена строка, где Номер КТК не заполнен, Грузополучатель: %1 и размер КТК: %2!", Стр.ГрузополучательСсылка, Стр.РазмерКонтейнера, Стр.КонтейнерСсылка);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
						
	КонецЦикла;	 
	
	// ДИТ US 81881 ТА 81882 Сержантова А.С. Начало: 16.04.2024
	ЭтаФорма.Модифицированность = Истина;
	ЭтаФорма.МодифицированностьФлаг = Истина;
	// ДИТ US 81881 ТА 81882 Сержантова А.С. Конец: 16.04.2024
	
КонецПроцедуры  

// ДИТ US 81881 ТА 81882 Сержантова А.С. 01.04.2024  
&НаСервере
Процедура ЗаполнитьВСтрокеГрузыИзНакладной(СтрокаУслуг, НакладнаяЖД, ТекстСообщенияПользователю = "")

	ТЧГрузы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НакладнаяЖД, "ГрузыЖД"); 
	ДетализацияГрузаСтроки = ДетализацияПоГрузу.Выгрузить();  
	ДетализацияГрузаСтроки.Очистить();
	ДетализацияГрузаСтроки.Колонки.Добавить("КодГруза"); 
	ДетализацияГрузаСтроки.Колонки.Добавить("Груженый"); 
	ДетализацияГрузаСтроки.Колонки.Добавить("ВесГрузаНетто");
	ВыборкаГрузов = ТЧГрузы.Выбрать(); 
	МассивГрузов = Новый Массив;
	Пока ВыборкаГрузов.Следующий() Цикл    
		МассивГрузов.Добавить(ВыборкаГрузов.ЕТСНГ);
	КонецЦикла;   
	ВыборкаГрузов.Сбросить();
	
	СоответствиеГрузаДК = РегистрыСведений.Связь_ЭТРАН_DC_Сопоставление.ПолучитьСопоставлениеЭтранДатакор(МассивГрузов);  
	Пока ВыборкаГрузов.Следующий() Цикл
		Груз = СоответствиеГрузаДК.Получить(ВыборкаГрузов.ЕТСНГ);   
		Если не ЗначениеЗаполнено(Груз) Тогда
			Продолжить;
		КонецЕсли;   
		НС = ДетализацияГрузаСтроки.Добавить();  
		НС.Груженый = Истина;
		НС.Груз = Груз;
		НС.КодГруза = ВыборкаГрузов.КодЕТСНГ;
		НС.КоличествоМест = ВыборкаГрузов.КоличествоМест; 
		НС.ВесГруза = ВыборкаГрузов.МассаГруза; 
		НС.ВесГрузаНетто = ВыборкаГрузов.МассаГруза;
		//НС.РодУпаковки = ВыборкаГрузов.ВидУпаковки; 
		НС.КлючАналитикиПеревозки = СтрокаУслуг.КлючАналитикиПеревозки;
	КонецЦикла;
	
	Если ДетализацияГрузаСтроки.Количество() > 0 Тогда  
		
		СтрокиДетализации = ДетализацияПоГрузу.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки", СтрокаУслуг.КлючАналитикиПеревозки));
			
		Если ДетализацияГрузаСтроки.Количество() = 1 Тогда
			
			СтрокаЗаполняемыхПолей = "Груженый";
			Если Не ЗначениеЗаполнено(СтрокаУслуг.ВесГрузаНетто) Тогда
				СтрокаЗаполняемыхПолей = СтрокаЗаполняемыхПолей + ",ВесГрузаНетто";
			КонецЕсли;
			Если Не ЗначениеЗаполнено(СтрокаУслуг.Груз) Тогда
				СтрокаЗаполняемыхПолей = СтрокаЗаполняемыхПолей + ",Груз,КодГруза";
			КонецЕсли;   
			Если Не ЗначениеЗаполнено(СтрокаУслуг.КоличествоМест) Тогда
				СтрокаЗаполняемыхПолей = СтрокаЗаполняемыхПолей + ",КоличествоМест";
			КонецЕсли;    
			Если СтрокаЗаполняемыхПолей <> "Груженый" Тогда
				Для каждого СтрДетализации Из СтрокиДетализации Цикл
					ДетализацияПоГрузу.Удалить(СтрДетализации);
				КонецЦикла;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(СтрокаУслуг, ДетализацияГрузаСтроки[0], СтрокаЗаполняемыхПолей); 
			ТекстСообщенияПользователю = ТекстСообщенияПользователю + " Дозаполнены параметры груза.";   
		Иначе 
			Если Не ЗначениеЗаполнено(СтрокаУслуг.Груз) и Не ЗначениеЗаполнено(СтрокаУслуг.КоличествоМест)
				и Не ЗначениеЗаполнено(СтрокаУслуг.ВесГрузаНетто) Тогда
				Для каждого СтрДетализации Из СтрокиДетализации Цикл
					ДетализацияПоГрузу.Удалить(СтрДетализации);
				КонецЦикла;
				СтрокаУслуг.Груз = Справочники.Грузы.СборнаяКонтейнернаяОтправка;
				СтрокаУслуг.ВесГрузаНетто = ДетализацияГрузаСтроки.Итог("ВесГруза");
				СтрокаУслуг.КоличествоМест = ДетализацияГрузаСтроки.Итог("КоличествоМест");
				Для каждого СтрГруза Из ДетализацияГрузаСтроки Цикл
					СтрДетализации = ДетализацияПоГрузу.Добавить();
					ЗаполнитьЗначенияСвойств(СтрДетализации, СтрГруза); 
				КонецЦикла;	  
				ТекстСообщенияПользователю = ТекстСообщенияПользователю + " Заполнены параметры груза в таблице детализация по грузу.";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставУслугиПСЦПриИзменении(Элемент)
	
	ТекД = Элементы.СоставУслуги.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекД.ПСЦ) Тогда
		ПСЦПриИзменении(неопределено, ТекД.ПСЦ);
	//Евросиб Коханенко Н.А. 24.02.2025 (( #101467
	Иначе
		ТекД.Калькуляция = Неопределено;	
	//Евросиб Коханенко Н.А. 24.02.2025 )) #101467
	КонецЕсли;
	
КонецПроцедуры

