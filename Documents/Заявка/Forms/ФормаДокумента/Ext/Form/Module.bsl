&НаСервереБезКонтекста
Функция ПолучитьВесКТКИзКоносамента(Коносамент, НомерКТК)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ТранспортныйДокументКоносаменты.ВесНетто КАК ВесНетто
		|ИЗ
		|	Документ.ТранспортныйДокумент.Коносаменты КАК ТранспортныйДокументКоносаменты
		|ГДЕ
		|	ТранспортныйДокументКоносаменты.Ссылка = &Коносамент
		|	И ТранспортныйДокументКоносаменты.НомерКТК = &НомерКТК";
	
	Запрос.УстановитьПараметр("Коносамент", Коносамент);
	Запрос.УстановитьПараметр("НомерКТК", НомерКТК);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
	    Результат = Выборка.ВесНетто;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
    Возврат Результат;
КонецФункции //Евросиб Коханенко Н.А. 06.03.2025 )) #103978

