Процедура ОбработкаВыбораРейса(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	Если Объект.ПереченьРейсов.НайтиСтроки(Новый Структура("Рейс", Параметр1)).Количество() = 0 Тогда
		НСТР = Объект.ПереченьРейсов.Добавить();
		НСТР.Рейс = Параметр1;
		НСТР.Продукт = ПолучитьРодителя(Параметр1); 
		//БИТ Белинский Д.А. 11.04.2023 -начало
			УстановитьДоступностьПолейПоследнейМили();
