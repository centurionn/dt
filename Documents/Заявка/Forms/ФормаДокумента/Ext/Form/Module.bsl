	ИначеЕсли ВыборкаМили.ЭтапПеревозки = ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПоследняяМиля") Тогда
	//Евросиб Коханенко Н.А. 23.01.2025 )) #91409 
