&НаКлиенте
Процедура ОбработкаДобавленияБезномерныхПозиций(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если параметр1 = Неопределено тогда возврат; КонецЕсли;
	
	//Если параметр1.Поведение = 1 Тогда Объект.СоставУслуги.Очистить(); КонецЕсли;
	//ДИТ, Беляев СЮ, BUG 80907/ TA 80909, 09-02-2024, начало
	Если Параметр1.Поведение = 1 Тогда
		УдалитьСтрокиНеВключенныеВСделку();
	КонецЕсли;
	//ДИТ, Беляев СЮ, BUG 80907/ TA 80909, 09-02-2024, конец
	
	Для Сч = 1 По параметр1.Количество Цикл
		НСтр = Объект.СоставУслуги.Добавить();
		НСтр.РазмерКТК = параметр1.Размер;
		НСтр.ТипКТК = параметр1.Тип;
		НСтр.Услуга = УслугаПоУмолчанию;
		НСтр.Калькуляция = КалькуляцияПоУмолчанию;
		НСтр.ТипВагона = Параметр1.ТипВагонов;
		НСтр.ГУИДСтроки = Строка(Новый УникальныйИдентификатор()); 
		// ДИТ US 62421 TA 64346 Евсенкин М.А. Начало: 20.02.2023
		НайтиКлючАналитикиПеревозкиКлиент(нСтр);
		// ДИТ US 62421 TA 64346 Евсенкин М.А. Конец: 20.02.2023
	КонецЦикла;
	
КонецПроцедуры
//Субботин 77659 25.01.2024 Конец


//ДИТ, Беляев СЮ, BUG 80907/ TA 80909, 09-02-2024, начало
&НаКлиенте
Процедура УдалитьСтрокиНеВключенныеВСделку()
	МассивГУИД = Новый Массив;
	Для каждого СтрокаСоставУслуги из Объект.СоставУслуги Цикл
		МассивГУИД.Добавить(СтрокаСоставУслуги.ГУИДСтроки);
	КонецЦикла;
	
	СтруктураРезультатПроверки = СтрокиВключенныеВСделки(Объект.Ссылка, МассивГУИД);
	МассивГУИДСтрокВключенныхВСделку = СтруктураРезультатПроверки.ГУИДыСтрокЗаявки;
	МассивУдаляемыхСтрок = Новый Массив;
	Для каждого СтрокаСоставУслуги из Объект.СоставУслуги Цикл
		Если МассивГУИДСтрокВключенныхВСделку.Найти(СтрокаСоставУслуги.ГУИДСтроки) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		МассивУдаляемыхСтрок.Добавить(СтрокаСоставУслуги);
	КонецЦикла;
	
	Для каждого СтрокаСоставУслуги Из МассивУдаляемыхСтрок Цикл
		Объект.СоставУслуги.Удалить(СтрокаСоставУслуги);
	КонецЦикла;
	
	Если МассивГУИД.Количество() <> МассивУдаляемыхСтрок.Количество() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалены строки включенные в Сделку");
	КонецЕсли;
	
КонецПроцедуры
//ДИТ, Беляев СЮ, BUG 80907/ TA 80909, 09-02-2024, конец

&НаКлиенте
Процедура ДобавитьИзEXCEL(Команда)
	
