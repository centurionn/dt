&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	СибурКонтрагент = Константы.СибурКонтрагент.Получить();
	Если Объект.Контрагент = СибурКонтрагент Тогда
		
		//ЭтоЗаявкаНаПорожний = Истина;
		//ДанныеПоЗаявкеСибур = ПолучитьДанныеПоЗаявкеСибур();	
		//Если ДанныеПоЗаявкеСибур.Следующий() Тогда
		//	Если ДанныеПоЗаявкеСибур.Заявка <> Объект.Ссылка Тогда
		//		ЭтоЗаявкаНаПорожний = Ложь;
		//	КонецЕсли;
		//КонецЕсли;
		
		Если ЗначениеЗаполнено(СибурСвязаннаяЗаявка) Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Заявка.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.Заявка КАК Заявка
			|ГДЕ
			|	Заявка.Ссылка = &Ссылка
			|	И (Заявка.Грузополучатель <> &Грузополучатель
			|			ИЛИ Заявка.ПортОтправления <> &ПортОтправления
			|			ИЛИ Заявка.ПунктПеревалки <> &ПунктПеревалки
			|			ИЛИ Заявка.ПритерминальнаяСтанция <> &ПритерминальнаяСтанция
			|			ИЛИ Заявка.СтанцияОтправленияГруженого <> &СтанцияОтправленияГруженого
			|			ИЛИ Заявка.СтанцияНазначенияГруженого <> &СтанцияНазначенияГруженого)";
			
			Если Объект.ГруженыйРейс Тогда
				Запрос.Текст = Запрос.Текст +
				"
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	ЗаявкаСоставУслуги.Ссылка
				|ИЗ
				|	Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
				|ГДЕ
				|	ЗаявкаСоставУслуги.Ссылка = &Ссылка
				|	И (ЗаявкаСоставУслуги.СтанцияОтправления <> &ПритерминальнаяСтанция
				|	ИЛИ ЗаявкаСоставУслуги.СтанцияНазначения <> &СтанцияОтправленияГруженого)";
			Иначе				
				Запрос.Текст = Запрос.Текст +
				"
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	ЗаявкаСоставУслуги.Ссылка
				|ИЗ
				|	Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
				|ГДЕ
				|	ЗаявкаСоставУслуги.Ссылка = &Ссылка
				|	И (ЗаявкаСоставУслуги.Грузополучатель <> &Грузополучатель
				|	ИЛИ ЗаявкаСоставУслуги.СтанцияОтправления <> &СтанцияОтправленияГруженого
				|	ИЛИ ЗаявкаСоставУслуги.СтанцияНазначения <> &СтанцияНазначенияГруженого)";
			КонецЕсли;
			
			Запрос.УстановитьПараметр("Грузополучатель", Объект.Грузополучатель);
			Запрос.УстановитьПараметр("Ссылка", СибурСвязаннаяЗаявка);
			Запрос.УстановитьПараметр("ПортОтправления", Объект.ПортОтправления);
			Запрос.УстановитьПараметр("ПунктПеревалки", Объект.ПунктПеревалки);
			Запрос.УстановитьПараметр("ПритерминальнаяСтанция", Объект.ПритерминальнаяСтанция);
			Запрос.УстановитьПараметр("СтанцияОтправленияГруженого", Объект.СтанцияОтправленияГруженого);
			Запрос.УстановитьПараметр("СтанцияНазначенияГруженого", Объект.СтанцияНазначенияГруженого);
			РезультатЗапроса = Запрос.Выполнить();
			
			Если Не РезультатЗапроса.Пустой() Тогда
				СвязаннаяЗаявкаОбъект = СибурСвязаннаяЗаявка.ПолучитьОбъект();
				СвязаннаяЗаявкаОбъект.Грузополучатель = Объект.Грузополучатель;
				СвязаннаяЗаявкаОбъект.ПортОтправления = Объект.ПортОтправления;
				СвязаннаяЗаявкаОбъект.ПунктПеревалки = Объект.ПунктПеревалки;
				СвязаннаяЗаявкаОбъект.ПритерминальнаяСтанция = Объект.ПритерминальнаяСтанция;
				СвязаннаяЗаявкаОбъект.СтанцияОтправленияГруженого = Объект.СтанцияОтправленияГруженого;
				СвязаннаяЗаявкаОбъект.СтанцияНазначенияГруженого = Объект.СтанцияНазначенияГруженого;
				Если Объект.ГруженыйРейс Тогда
					Для Каждого СтрокаТЧ Из СвязаннаяЗаявкаОбъект.СоставУслуги Цикл
						СтрокаТЧ.СтанцияОтправления = Объект.ПритерминальнаяСтанция;
						СтрокаТЧ.СтанцияНазначения = Объект.СтанцияОтправленияГруженого;
					КонецЦикла;
				Иначе
					Для Каждого СтрокаТЧ Из СвязаннаяЗаявкаОбъект.СоставУслуги Цикл
						СтрокаТЧ.Грузополучатель = Объект.Грузополучатель;
						СтрокаТЧ.СтанцияОтправления = Объект.СтанцияОтправленияГруженого;
						СтрокаТЧ.СтанцияНазначения = Объект.СтанцияНазначенияГруженого;
					КонецЦикла;
				КонецЕсли;
				Если СвязаннаяЗаявкаОбъект.Проведен Тогда
					РежимЗаписи = РежимЗаписиДокумента.Проведение;
				Иначе
					РежимЗаписи = РежимЗаписиДокумента.Запись;
				КонецЕсли;
				СвязаннаяЗаявкаОбъект.Записать(РежимЗаписи);
			КонецЕсли;
			
		КонецЕсли;
			
		Запись = РегистрыСведений.СибурРазмещенныеЗаявки.СоздатьМенеджерЗаписи();
		// ДИТ US 60810 TA 66664 Евсенкин М.А. Начало: 07.04.2023
		Для Каждого Стр Из Объект.НомераЛотов Цикл 		
			Запись.НомерЛота = Стр.НомерЛота;
			// ДИТ US 60810 TA 66664 Евсенкин М.А. Конец: 07.04.2023
			Если Объект.ГруженыйРейс Тогда
				Запись.Заявка = СибурСвязаннаяЗаявка;
				Запись.Прочитать();
				Запись.Заявка = СибурСвязаннаяЗаявка;
				Запись.ЗаявкаНаОтправкуГруженых = Объект.Ссылка;
			Иначе
				Запись.Заявка = Объект.Ссылка;
				Запись.Прочитать();
				Запись.Заявка = Объект.Ссылка;
				Запись.ЗаявкаНаОтправкуГруженых = СибурСвязаннаяЗаявка;			
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Запись.Заявка) Тогда
				//Запись.RFQ_ID = СибурRFQ_ID;
				//Запись.EXT_RFQ_ID = СибурEXT_RFQ_ID;
				//Запись.ПлановаяДатаОтправленияПорожнего = СибурПлановаяДатаОтправленияПорожнего;
				Запись.ДатаКрайнегоСрокаОтветаЭкспедитора = СибурДатаКрайнегоСрокаОтветаЭкспедитора;
				Запись.ВидЗакупкиКод = СибурВидЗакупкиКод;
				Запись.ВидЗакупкиНаименование = СибурВидЗакупкиНаименование;
				Запись.ВидОтправкиКод = СибурВидОтправкиКод;
				Запись.ВидОтправкиНаименование = СибурВидОтправкиНаименование;
				//Запись.НомерДоговора = СибурНомерДоговора;
				//Запись.НеобходимаяДатаПодачиПорожнегоСостава = СибурНеобходимаяДатаПодачиПорожнегоСостава;
				//Запись.ПлановаяДатаОтгрузкиГруженогоСостава = СибурПлановаяДатаОтгрузкиГруженогоСостава;
				//Запись.КодСтанцииОтправкиГруженого = СибурКодСтанцииОтправкиГруженого;
				Запись.НазваниеСтанцииОтправкиГруженого = СибурНазваниеСтанцииОтправкиГруженого;
				Запись.МаршрутСледованияГруженогоПоезда = СибурМаршрутСледованияГруженогоПоезда;
				//Запись.КодСтанцииНазначенияГруженого = СибурКодСтанцииНазначенияГруженого;
				//Запись.НазваниеСтанцииНазначенияГруженого = СибурНазваниеСтанцииНазначенияГруженого;
				Запись.ОбщееКоличествоЗапрашиваемыхКонтейнеров = СибурОбщееКоличествоЗапрашиваемыхКонтейнеров;
				Запись.ЕдиницаИзмеренияКоличестваКонтейнеров = СибурЕдиницаИзмеренияКоличестваКонтейнеров;
				Запись.КодТипаКонтейнеров = СибурКодТипаКонтейнеров;
				Запись.ВесПродукции = СибурВесПродукции;
				Запись.ЕдиницаИзмеренияВесаПродукции = СибурЕдиницаИзмеренияВесаПродукции;
				Запись.Комментарий = СибурКомментарий;
				Запись.ИмяМенеджера = СибурИмяМенеджера;
				Запись.КонтактныйТелефонМенеджера = СибурКонтактныйТелефонМенеджера;
				Запись.АдресЭлектроннойПочтыМенеджера = СибурАдресЭлектроннойПочтыМенеджера;
				//ДИТ Шевченко А.В. US 57149 TA 66232 20.03.2023 -начало
				Запись.ЭкспедиторВПорту = СибурЭкспедиторВПорту;
				//ДИТ Шевченко А.В. US 57149 TA 66232 20.03.2023 -конец
				Запись.Записать();
			КонецЕсли;
			// ДИТ US 60810 TA 66664 Евсенкин М.А. Начало: 07.04.2023
		КонецЦикла;
		// ДИТ US 60810 TA 66664 Евсенкин М.А. Конец: 07.04.2023
	КонецЕсли;
	
	// Евросиб Фролов (06.12.2021 TASK№ №42618, РелизКлиента
	МассивРелизов = Объект.СписокЗапросНаКТК.Выгрузить().ВыгрузитьКолонку("РелизКлиента");
	НомерЗаявокВРелизах = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивРелизов, "Заявка");
	Для Каждого ТекущаяСтрока Из Объект.СписокЗапросНаКТК Цикл
		
		Если ЗначениеЗаполнено(ТекущаяСтрока.РелизКлиента) Тогда
			НомерЗаявкиВРелизе = НомерЗаявокВРелизах.Получить(ТекущаяСтрока.РелизКлиента);
			Если Не ЗначениеЗаполнено(НомерЗаявкиВРелизе) Тогда
