&НаСервереБезКонтекста
Функция НайтиТип(ТипСтрока) 
	
	Результат = Справочники.ТипоразмерыТЕ.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТипоразмерыТЕ.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ТипоразмерыТЕ КАК ТипоразмерыТЕ
	               |ГДЕ
	               |	(ТипоразмерыТЕ.Наименование = &ТипСтрока
	               |			ИЛИ ТипоразмерыТЕ.КодISO = &ТипСтрока)
	               |	И НЕ ТипоразмерыТЕ.ПометкаУдаления";
	Запрос.УстановитьПараметр("ТипСтрока", ТипСтрока);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	Иначе
		Сообщить("Не найден типоразмер для кода " + ТипСтрока);
	КонецЕсли;
	
	Возврат Результат;
	
