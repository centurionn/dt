					ОбщегоНазначения.СообщитьПользователю(СтрШаблон("В Калькуляции %1 от %2 не заполнена ставка",ЗнчКалк.Номер,ЗнчКалк.Дата),,,,Отказ);
				КонецЕсли;
				
				Если ВагоныБезСтавки.Количество() Тогда
					Взаимодействия.УдалитьПовторяющиесяЭлементыМассива(ВагоныБезСтавки); //ДИТ, Беляев СЮ, BUG 78827/TA 78829, 26-12-2023, добавлено
					ОбщегоНазначения.СообщитьПользователю(СтрШаблон("В Калькуляции %1 от %2 не заполнена ставка",ЗнчКалк.Номер,ЗнчКалк.Дата),,,,Отказ);
				КонецЕсли;
				
				Если КТКБезСобственности.Количество() Тогда
					Взаимодействия.УдалитьПовторяющиесяЭлементыМассива(КТКБезСобственности); //ДИТ, Беляев СЮ, BUG 78827/TA 78829, 26-12-2023, добавлено
