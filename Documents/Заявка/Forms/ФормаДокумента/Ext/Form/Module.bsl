&НаКлиенте
Процедура СоставУслугиДатаПодачиАвтоПодВыгрузкуПриИзменении(Элемент)
	ТекущиеДанные = Элементы.СоставУслуги.ТекущиеДанные;
	//ДИТ, Беляев СЮ, US 64448/ TA 78671, 12-12-2023, начало
	Если ТекущиеДанные <> неопределено Тогда
		Если ТекущиеДанные.ДатаПодачиАвтоПодВыгрузку > КонецДня(ТекущаяДата()) Тогда
			ТекущиеДанные.ДатаПодачиАвтоПодВыгрузку = Дата(1,1,1);
			ОбщегоНазначенияКлиент.СообщитьПользователю("Дата доставка груза не может быть больше текущей даты!",,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СоставУслуги", ТекущиеДанные.НомерСтроки, "ДатаПодачиАвтоПодВыгрузку"),"Объект")
		КонецЕсли;
	КонецЕсли;
	//ДИТ, Беляев СЮ, US 64448/ TA 78671, 12-12-2023, коне
	СтруктураТЧМили = Новый Структура;
	СтруктураТЧМили.Вставить("ДатаВыездаКТКСоСклада",ТекущиеДанные.ДатаПодачиАвтоПодВыгрузку);
	Структура = ПолучитьСтруктуруДляЗаписиКлюча();
	ЗаполнитьЗначенияСвойств(Структура,ТекущиеДанные);
	ДобавитьЗначениеРеквизитаМилиВКлюч(Структура,ТекущиеДанные.ДатаПодачиАвтоПодВыгрузку,"ДатаВыездаКТКСоСклада",ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПоследняяМиля"),СтруктураТЧМили);
КонецПроцедуры 
