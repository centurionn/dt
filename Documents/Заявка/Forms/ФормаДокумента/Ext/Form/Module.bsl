		Если РаботаСЗаявкамиВызовСервера.Проверка_ДатаВозвратаИзПервойМили(Стр.НомерКТК, Объект.Ссылка) Тогда
		Иначе	
			Стр.ДатаВозвратаКлиентом 	= ВыборкаМили.ДатаСдачиКТКНаТерминал;
		КонецЕсли;
		// Евросиб(ДИТ) BUG 95213 ТА 95214 Сержантова А.С. Конец: 17.12.2024
		Стр.ДатаПодачиАвтоПодВыгрузку 	= ВыборкаМили.ДатаВыездаКТКСоСклада;
		Если ЗначениеЗаполнено(ВыборкаМили.ДатаВыездаКТКСоСклада) Тогда
			Стр.АдресВыгрузки 				= ВыборкаМили.АдресКлиента;
		КонецЕсли;
		Стр.ФИОВодителяВыгрузка         = ВыборкаМили.ФИОВодителя;
		Стр.НомерАвтоВыгрузка 			= ВыборкаМили.РегНомерТС;
		Стр.АвтоПеревозчик              = ВыборкаМили.Автоперевозчик;
