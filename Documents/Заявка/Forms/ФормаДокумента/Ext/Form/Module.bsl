	//Евросиб Коханенко Н.А. 28.12.2024 )) #97950 
	
	//Евросиб(ДИТ), Беляев СЮ, US 104177 / TA 105665, 25-03-2025, начало
	ДоступныПолныеПрава = РольДоступна("ПолныеПрава");
	Элементы.СоставУслугиГруппаСтатуса.Доступность = ДоступныПолныеПрава;
