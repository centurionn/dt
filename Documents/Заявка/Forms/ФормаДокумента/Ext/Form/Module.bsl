&НаКлиенте
Процедура УдалениеПодтверждено(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;
	
	УдаляемыеСтроки = Новый Массив;
	
	Для каждого Стр из Элементы.СоставУслуги.ВыделенныеСтроки Цикл
		
		УдаляемыеСтроки.Добавить(Объект.СоставУслуги.НайтиПоИдентификатору(Стр));
		
	КонецЦикла;
	
	Для каждого Стр2 из УдаляемыеСтроки Цикл
		//Субботин 77659 05.12.2023 Начало
		УбратьКТКИзЗапросаКТК(Стр2, Истина);	
		//Субботин 77659 05.12.2023 Конец
		
		//Евросиб Коханенко Н.А. 30.07.2024 (( #88606
		//добавим в массив, чтобы при записи очистить поле Заявка в шапке ключа аналитики
		КлючиАналитикиУдаленныхСтрок.Добавить(Стр2.КлючАналитикиПеревозки); 
		//Евросиб Коханенко Н.А. 30.07.2024 )) #88606

		Объект.СоставУслуги.Удалить(Стр2);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НайтиКоносаменты(Команда)
	
	КТКДляПоиска = Новый Массив;
	Для каждого Стр из Объект.СоставУслуги Цикл
		
		Если ЗначениеЗаполнено(Стр.НомерКТК) И НЕ ЗначениеЗаполнено(Стр.Коносамент) Тогда
			КТКДляПоиска.Добавить(Стр.НомерКТК);
		КонецЕсли;
		
	КонецЦикла;
	
	Соответствие_КТК_Коносамент = ПолучитьСоответствиеПоКоносаментам(КТКДляПоиска);
	
	Для каждого Стр из Объект.СоставУслуги Цикл
		
		Если ЗначениеЗаполнено(Стр.НомерКТК) И НЕ ЗначениеЗаполнено(Стр.Коносамент) Тогда
			
			Стр.Коносамент = Соответствие_КТК_Коносамент[Стр.НомерКТК];
			
		КонецЕсли;
		
	КонецЦикла;
	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСоответствиеПоКоносаментам(КТКДляПоиска)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТранспортныйДокументКоносаменты.НомерКТК КАК НомерКТК,
	               |	ТранспортныйДокументКоносаменты.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ТранспортныйДокумент.Коносаменты КАК ТранспортныйДокументКоносаменты
	               |ГДЕ
	               |	НЕ ТранспортныйДокументКоносаменты.Ссылка.ПометкаУдаления
	               |	И ТранспортныйДокументКоносаменты.НомерКТК В(&КТКДляПоиска)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ТранспортныйДокументКоносаменты.Ссылка.Дата УБЫВ";
	Запрос.УстановитьПараметр("КТКДляПоиска", КТКДляПоиска);
	РЕЗТЧ = Запрос.Выполнить().Выгрузить();
	
	Результат = Новый Соответствие;
	
	Для каждого Стр из КТКДляПоиска Цикл
		
		Для каждого СтрТЧ из РЕЗТЧ Цикл
			
			Если Стр = СтрТЧ.НомерКТК Тогда Результат.Вставить(Стр, СтрТЧ.Ссылка); Прервать; КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ВыбратьГрузДляВыбранныхСтрок(Команда)
	
	Если Объект.ОтправляемыеГрузы.Количество() > 0 Тогда
		
		СписокГрузов = Новый СписокЗначений;
		Для Каждого СтрокаТЧ Из Объект.ОтправляемыеГрузы Цикл
			Если СписокГрузов.НайтиПоЗначению(СтрокаТЧ.Груз) = Неопределено Тогда
				СписокГрузов.Добавить(СтрокаТЧ.Груз);				
			КонецЕсли;
		КонецЦикла;
				
		ДополнительныеПараметры = Новый Структура;
		ВыделенныеСтроки = Элементы.СоставУслуги.ВыделенныеСтроки;
		ДополнительныеПараметры.Вставить("ВыделенныеСтроки", ВыделенныеСтроки);
		
		ОповещениеОВыборе = Новый ОписаниеОповещения("ОбработатьВыборГруза", ЭтаФорма, ДополнительныеПараметры);
		СписокГрузов.ПоказатьВыборЭлемента(ОповещениеОВыборе, "Выберите груз");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборГруза(ВыбранныйГруз, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйГруз <> Неопределено Тогда
		Груз = ВыбранныйГруз.Значение;
		КодЕТСНГ = ЗначениеРеквизитаОбъекта(Груз, "ЕТСНГ");		
		ВыделенныеСтроки = ДополнительныеПараметры.ВыделенныеСтроки;
		Для Каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
			СтрокаТЧ = Объект.СоставУслуги.НайтиПоИдентификатору(ИдентификаторСтроки);
			СтрокаТЧ.Груз = Груз;
			СтрокаТЧ.КодГруза = КодЕТСНГ;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

