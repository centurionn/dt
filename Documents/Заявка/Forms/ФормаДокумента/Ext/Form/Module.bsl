Функция ПолучитьСтанциюНазначенияИДатуОтправления(ИмяТаблицы,ИдентификаторСтроки);
	// ДИТ US 58592 TA 60724 Евсенкин М.А. Начало: 13.12.2022
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ИдентификаторСтроки", ИдентификаторСтроки);
	ТаблицаОбъекта = Объект[ИмяТаблицы].Выгрузить(ПараметрыОтбора);
