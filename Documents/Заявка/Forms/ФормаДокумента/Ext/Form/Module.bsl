&НаКлиенте
Процедура СоставУслугиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Элементы.СоставУслуги.ТекущийЭлемент.Имя = "СоставУслугиНомерКТК" Тогда
		//Евросиб Каблов 24.01.2022 ( Task 45889
		//ПоказатьЗначение(, Элементы.СоставУслуги.ТекущиеДанные.НомерКТК);
		ТолькоПросмотрКТК = Ложь;
		ТекД = Элементы.СоставУслуги.ТекущиеДанные;	
		Если ТекД <> неопределено И ЗначениеЗаполнено(ТекД.НомерКТК) И ЗначениеЗаполнено(Объект.Ссылка) Тогда		
			КонтейнерВключенВСделку = КонтейнерЗаявкиВключенВСделку(Объект.Ссылка, ТекД.НомерКТК, ТекД.ГУИДСтроки);
			Если  КонтейнерВключенВСделку Тогда
				ТолькоПросмотрКТК = Истина;						
			КонецЕсли;		
		КонецЕсли;
		
		Элементы.СоставУслугиНомерКТК.ТолькоПросмотр = ТолькоПросмотрКТК;
		Если ТолькоПросмотрКТК Тогда
			ПоказатьЗначение(, Элементы.СоставУслуги.ТекущиеДанные.НомерКТК);
			СтандартнаяОбработка = Ложь;
		КонецЕсли;
		//Евросиб Каблов 24.01.2022 )
	//Евросиб Каблов 31.10.2022 ( 52066
	ИначеЕсли Элементы.СоставУслуги.ТекущийЭлемент.Имя = "СоставУслугиПеренесенВЗаявку" Тогда
		ТекД = Элементы.СоставУслуги.ТекущиеДанные;
		Если ТекД <> Неопределено И ЗначениеЗаполнено(ТекД.ПеренесенВЗаявку) Тогда
			ПоказатьЗначение(, ТекД.ПеренесенВЗаявку);
		КонецЕсли;
	//Евросиб Каблов 31.10.2022 )
	//ДИТ, Беляев СЮ, Ticket#0341163, 08-02-2024, начало
	ИначеЕсли Элементы.СоставУслуги.ТекущийЭлемент.Имя = "СоставУслугиРелиз" Тогда
		ТекД = Элементы.СоставУслуги.ТекущиеДанные;
		Если ТекД <> Неопределено И ЗначениеЗаполнено(ТекД.ИдентификаторСтрокиРелизаКлиента) И ЗначениеЗаполнено( ТекД.Релиз ) Тогда
			ПоказатьЗначение(, ТекД.Релиз);	
		КонецЕсли;
	//ДИТ, Беляев СЮ, Ticket#0341163, 08-02-2024, конец 
	//Евросиб Коханенко Н.А. 23.04.2025 (( #78722 
	ИначеЕсли Элементы.СоставУслуги.ТекущийЭлемент.Имя = "СоставУслугиОфисПродаж" Тогда
		Если ЕстьСвязаннаяРТУ <> "" Тогда
			СтандартнаяОбработка = Ложь;
			ТекД = Элементы.СоставУслуги.ТекущиеДанные;
			ОбщегоНазначенияКлиент.СообщитьПользователю("Обязательное поле ""Офис продаж"" не может быть изменено в связи с наличием связанной с заявкой РТУ: " + ЕстьСвязаннаяРТУ,,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СоставУслуги", ТекД.НомерСтроки, "ОфисПродаж"), "Объект")
		КонецЕсли;
	//Евросиб Коханенко Н.А. 23.04.2025 )) #78722 
	КонецЕсли;
	
КонецПроцедуры

