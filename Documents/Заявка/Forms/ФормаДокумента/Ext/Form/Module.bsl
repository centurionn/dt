&НаКлиенте
Процедура УдалитьСтрокиПодчиненныхТаблицы(ИмяТабличнойЧасти)
	// Евросиб Фролов (06.12.2021 TASK№ №42618, РелизКлиента
	МассивУдаляемыхСтрок = Новый Массив;
	
	Для Каждого ТекСтрока Из Объект[ИмяТабличнойЧасти] Цикл
		
		ИдентификаторСтрокиЗапроса = ТекСтрока.ИдентификаторСтрокиЗапроса;
		
		НайденныеСтроки = Объект.СписокЗапросНаКТК.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтрокиЗапроса));
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			Если МассивУдаляемыхСтрок.Найти(ИдентификаторСтрокиЗапроса) = Неопределено Тогда
				МассивУдаляемыхСтрок.Добавить(ИдентификаторСтрокиЗапроса);
			КонецЕсли;		
		КонецЕсли;	
		
	КонецЦикла;	
	
	Для Каждого УдаляемаяСтрока Из МассивУдаляемыхСтрок Цикл
		
		Индекс = Объект[ИмяТабличнойЧасти].Количество() - 1;
		Пока Индекс >= 0 Цикл
			Если Объект[ИмяТабличнойЧасти][Индекс].ИдентификаторСтрокиЗапроса = УдаляемаяСтрока Тогда
				Объект[ИмяТабличнойЧасти].Удалить(Индекс);
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
		
	КонецЦикла;
	// Евросиб Фролов)	
КонецПроцедуры	

&НаКлиенте
Процедура РезультатЧтенияТранспортныхСредств(ДанныеДляЗагрузки, ДополнительныеПараметры) Экспорт
	// Евросиб Фролов (06.12.2021 TASK№ №42618, РелизКлиента
	Если ДанныеДляЗагрузки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -Начало
	Если ДополнительныеПараметры.Миля = "ТранспортныеСредстваПоследняяМиля" Тогда
		ЭтапПеревозки = "ПоследняяМиля";
	Иначе	
		ЭтапПеревозки = "ПерваяМиля";
	КонецЕсли;	
	//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -Конец
	ИдентификаторСтроки = ДанныеДляЗагрузки.ИдентификаторСтроки;
	//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -Начало
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ИдентификаторСтроки",ИдентификаторСтроки);
	МассивСтрок = Объект.СписокЗапросНаКТК.НайтиСтроки(СтруктураОтбора);
	СтруктураОтвет = Неопределено;
	МассивКлючей = Новый Массив;
	Если ЗначениеЗаполнено(МассивСтрок[0].РелизКлиента) Тогда
		Для Каждого Стр Из Объект.ТранспортныеСредства Цикл
			МассивКлючей.Добавить(Стр.КлючАналитикиПеревозки);
		КонецЦикла;	
		СтруктураОтвет = ПолучитьКлючиИзРелизаКлиента(МассивСтрок[0].РелизКлиента,МассивКлючей,ПредопределенноеЗначение(СтрШаблон("Перечисление.ЭтапыПеревозки.%1",ЭтапПеревозки)));	
	// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Начало: 21.03.2024 - пробуем искать ключи аналитики в составе услуг по номеру КТК
	Иначе
		СписокКонтейнеров = ПолучитьСписокКткИзЗапросаКТКПоПереданнойСтроке(МассивСтрок[0].НомерСтроки); 
		КлючиИзСоставаУслуг = ПолучитьКлючиАналитикиПоКонтейнерамИзУслуг(СписокКонтейнеров);    
		//Если по строке запроса на КТК уже добавлены строки, уберем эти ключи из вариантов подбора
		СтруктураПоискаПоМиле = Новый Структура("ИдентификаторСтрокиЗапроса", МассивСтрок[0].ИдентификаторСтроки);  
		СтрокиПоМиле = Объект[ДополнительныеПараметры.Миля].НайтиСтроки(СтруктураПоискаПоМиле);
		Для каждого СтрокаЭтапаПеревозки Из СтрокиПоМиле Цикл    
			ИндексЗначения = КлючиИзСоставаУслуг.Найти(СтрокаЭтапаПеревозки.КлючАналитикиПеревозки); 
			Если ЗначениеЗаполнено(СтрокаЭтапаПеревозки.КлючАналитикиПеревозки)
				и ИндексЗначения <> Неопределено Тогда
			    КлючиИзСоставаУслуг.Удалить(ИндексЗначения);
			КонецЕсли;	
		КонецЦикла;
	// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Конец: 21.03.2024	
	КонецЕсли;
	//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -Конец
	МассивСведений = ДанныеДляЗагрузки.Результат;
	инд = 0;
	Для Каждого ТекущаяЗапись Из МассивСведений Цикл
		НоваяСтрока = Объект[ДополнительныеПараметры.Миля].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяЗапись);
		НоваяСтрока.ИдентификаторСтрокиЗапроса = ИдентификаторСтроки;
		//НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -Начало
		СтруктураДляКлюча = Новый Структура("ФИОВодителя,РегНомерТС,ПаспортныеДанные,Автоперевозчик,ИНН,КПП,КлючАналитикиПеревозки,Заявка,Контейнер");
		ЗаполнитьЗначенияСвойств(СтруктураДляКлюча,ТекущаяЗапись);
		СтруктураДляКлюча.Заявка = Объект.Ссылка;
		Если СтруктураОтвет <> Неопределено Тогда
			Если СтруктураОтвет.ПустойКлюч Тогда				
				ДобавитьЗначениеРеквизитаВКлючПоВодителяАвтоперевозчикам(СтруктураДляКлюча,ПредопределенноеЗначение(СтрШаблон("Перечисление.ЭтапыПеревозки.%1",ЭтапПеревозки)),НоваяСтрока.ВерсияКлюча);
				НоваяСтрока.КлючАналитикиПеревозки = СтруктураДляКлюча.КлючАналитикиПеревозки;
			Иначе
				Если инд < СтруктураОтвет.КлючРелиза.Количество() Тогда
					СтруктураДляКлюча.КлючАналитикиПеревозки = СтруктураОтвет.КлючРелиза[инд].КлючАналитикиПеревозки;
				КонецЕсли;
				ДобавитьЗначениеРеквизитаВКлючПоВодителяАвтоперевозчикам(СтруктураДляКлюча,ПредопределенноеЗначение(СтрШаблон("Перечисление.ЭтапыПеревозки.%1",ЭтапПеревозки)),НоваяСтрока.ВерсияКлюча);
				НоваяСтрока.КлючАналитикиПеревозки = СтруктураДляКлюча.КлючАналитикиПеревозки;
				инд = инд + 1;
			КонецЕсли;	
		Иначе  
			// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Начало: 21.03.2024
			Если инд < КлючиИзСоставаУслуг.Количество() Тогда
			    СтруктураДляКлюча.КлючАналитикиПеревозки = КлючиИзСоставаУслуг[инд];
				ДобавитьЗначениеРеквизитаВКлючПоВодителяАвтоперевозчикам(СтруктураДляКлюча,ПредопределенноеЗначение(СтрШаблон("Перечисление.ЭтапыПеревозки.%1",ЭтапПеревозки)),НоваяСтрока.ВерсияКлюча);
				НоваяСтрока.КлючАналитикиПеревозки = СтруктураДляКлюча.КлючАналитикиПеревозки; 
				инд = инд + 1;
			Иначе
			// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Конец: 21.03.2024
				ДобавитьЗначениеРеквизитаВКлючПоВодителяАвтоперевозчикам(СтруктураДляКлюча,ПредопределенноеЗначение(СтрШаблон("Перечисление.ЭтапыПеревозки.%1",ЭтапПеревозки)),НоваяСтрока.ВерсияКлюча);
				НоваяСтрока.КлючАналитикиПеревозки = СтруктураДляКлюча.КлючАналитикиПеревозки;  
			// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Начало: 21.03.2024 
			КонецЕсли;
			// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Конец: 21.03.2024
		КонецЕсли;    
		// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Начало: 26.03.2024
		Если ЭтапПеревозки = "ПоследняяМиля" и ЗначениеЗаполнено(СтруктураДляКлюча.КлючАналитикиПеревозки) Тогда
			КонтейнерВКлюче = ОбщегоНазначенияВызовСервера.ЗначениеРеквизитаОбъекта(СтруктураДляКлюча.КлючАналитикиПеревозки, "Контейнер");
			НоваяСтрока.Контейнер = КонтейнерВКлюче;
		КонецЕсли;
		// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Конец: 26.03.2024
		//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -Конец
	КонецЦикла;	
	УстановитьОтборТранспортныхСредств();
	// Евросиб Фролов )
КонецПроцедуры  

// ДИТ BUG 82599 ТА 82600 Сержантова А.С. 21.03.2024
&НаСервере
Функция ПолучитьКлючиАналитикиПоКонтейнерамИзУслуг(СписокКонтейнеров)

	КлючиИзУслуг = Новый Массив;
	Для каждого СтрокаУслуги Из Объект.СоставУслуги Цикл
		Если СписокКонтейнеров.Найти(СтрокаУслуги.НомерКТК) <> Неопределено 
			и ЗначениеЗаполнено(СтрокаУслуги.КлючАналитикиПеревозки) Тогда
		    КлючиИзУслуг.Добавить(СтрокаУслуги.КлючАналитикиПеревозки);
		КонецЕсли;
	КонецЦикла; 
	
	Возврат КлючиИзУслуг;

КонецФункции 

&НаСервере
Процедура НастроитьВидимостьВкладкиЗапросНаКТК()
	// Евросиб Фролов (16.11.2021 TASK№ №41969
	Элементы.ГруппаСписокЗапросНаКТК.Видимость 				= Объект.ЗапросНаКТК;
    //Элементы.СоставУслугиЗаполнитьИзЗапросаНаКТК.Видимость 	= Объект.ЗапросНаКТК; //ДИТ Шевченко А.В. BUG 75898 TA 75908 10.10.2023
	
	// ДИТ US 59973 ТА 68125 Сержантова А.С. Начало: 28.07.2023
	Если ЭтоЗаявкаПоСубсидии(Объект.ПСЦ) Тогда
		Элементы.ЗапросНаКТК.Видимость = Ложь;
		Элементы.ГруппаСписокЗапросНаКТК.Видимость = Ложь;
	КонецЕсли;
	// ДИТ US 59973 ТА 68125 Сержантова А.С. Конец: 28.07.2023
	
