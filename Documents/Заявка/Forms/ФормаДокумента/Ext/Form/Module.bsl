Процедура СоставУслугиКоличествоМестПриИзменении(Элемент)
	мТекущиеДанные = Элементы.СоставУслуги.ТекущиеДанные;
	НайтиКлючАналитикиПеревозкиКлиент(мТекущиеДанные);	
КонецПроцедуры

// ДИТ US 76935 ТА 78649 Сержантова А.С. 26.12.2023  
&НаСервере
Функция ЗаполнитьДанныеДляОбновленияКлючейАналитикиПеревозки() 
	
	ДанныеОбновленияКлючейАналитики = Новый ТаблицаЗначений;   
	ДанныеОбновленияКлючейАналитики.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	ДанныеОбновленияКлючейАналитики.Колонки.Добавить("КлючАналитикиПеревозки", Новый ОписаниеТипов("СправочникСсылка.КлючиАналитикиПеревозки"));  
	ДанныеОбновленияКлючейАналитики.Колонки.Добавить("Контейнер", Новый ОписаниеТипов("СправочникСсылка.ТЕ"));
	ДанныеОбновленияКлючейАналитики.Колонки.Добавить("ДанныеКлюча");   
	ДанныеОбновленияКлючейАналитики.Колонки.Добавить("Груз"); 
	ДанныеОбновленияКлючейАналитики.Колонки.Добавить("ИсточникКлюча");
	
	Для каждого СтрокаТЧ Из Объект.СоставУслуги Цикл
		СтруктураКлючаАналитикиПеревозки = Справочники.КлючиАналитикиПеревозки.СтруктураКлючаАналитикиПеревозки(); 
		
		СтруктураКлючаАналитикиПеревозки.КлючАналитики = СтрокаТЧ.КлючАналитикиПеревозки; 
		СтруктураКлючаАналитикиПеревозки.Контейнер = СтрокаТЧ.НомерКТК;
		// ДИТ BUG 79844 ТА 79845 Сержантова А.С. Начало: 22.01.2024 
		СтрокиВАвтоперевозке = Объект.ТранспортныеСредстваПоследняяМиля.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки", СтрокаТЧ.КлючАналитикиПеревозки));
		Если не ЗначениеЗаполнено(СтруктураКлючаАналитикиПеревозки.Контейнер) и СтрокиВАвтоперевозке.Количество() > 0 Тогда
			СтруктураКлючаАналитикиПеревозки.Контейнер = СтрокиВАвтоперевозке[0].Контейнер;		
		КонецЕсли; 
		// ДИТ BUG 79844 ТА 79845 Сержантова А.С. Конец: 22.01.2024
		СтруктураКлючаАналитикиПеревозки.Заявка = Объект.Ссылка;
		СтруктураКлючаАналитикиПеревозки.Груз = СтрокаТЧ.Груз; 
		СтруктураКлючаАналитикиПеревозки.ИнструкцияПоСдаче = СтрокаТЧ.ИнструкцииПоСдачеПорожнего;  
		// ДИТ US 78234 ТА 78241 Сержантова А.С. Начало: 12.12.2023
		СтруктураКлючаАналитикиПеревозки.КоличествоМест = СтрокаТЧ.КоличествоМест; 
		СтруктураКлючаАналитикиПеревозки.ВесГруза = СтрокаТЧ.ВесГрузаНетто;
		// ДИТ US 78234 ТА 78241 Сержантова А.С. Конец: 12.12.2023
		
		мДетализацияПоГрузу = РеквизитФормыВЗначение("ДетализацияПоГрузу",Тип("ТаблицаЗначений"));
		ТЗДетализацияПоГрузу = мДетализацияПоГрузу.СкопироватьКолонки();
		МассивСтрок = ДетализацияПоГрузу.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки",СтрокаТЧ.КлючАналитикиПеревозки));
		Для Каждого СтрМассивСтрок Из МассивСтрок Цикл
			ЗаполнитьЗначенияСвойств(ТЗДетализацияПоГрузу.Добавить(),СтрМассивСтрок);
		КонецЦикла;
		
		СтруктураКлючаАналитикиПеревозки.ИзменятьТЧДетализацияПоГрузу = Истина;
		СтруктураКлючаАналитикиПеревозки.ТЧДетализацияПоГрузу = ТЗДетализацияПоГрузу;

		МилиКлючаПервая = Новый Структура;
		МилиКлючаПервая.Вставить("ДатаВыдачиКТКСТерминала", СтрокаТЧ.ДатаВыдачи);
		//МилиКлючаПервая.Вставить("ДатаСдачиКТКНаТерминал", СтрокаТЧ.ДатаВозвратаКлиентом); 
		МилиКлючаПервая.Вставить("ДатаВыездаКТКСоСклада", СтрокаТЧ.ДатаПодачиАвтоПодПогрузку);
		МилиКлючаПервая.Вставить("ФИОВодителя", СтрокаТЧ.ФИОВодителя);
		МилиКлючаПервая.Вставить("РегНомерТС", СтрокаТЧ.НомерАвто); 
		МилиКлючаПервая.Вставить("Автоперевозчик", СтрокаТЧ.АвтоперевозчикПерваяМиля);
		// ДИТ BUG 79844 ТА 79845 Сержантова А.С. Начало: 25.01.2024 US 79379 ТА 80813
		//МилиКлючаПервая.Вставить("ПаспортныеДанные", "");
		// ДИТ BUG 79844 ТА 79845 Сержантова А.С. Конец: 25.01.2024
		Если ЗначениеЗаполнено(СтрокаТЧ.АвтоперевозчикПерваяМиля) 
			и ТипЗнч(СтрокаТЧ.АвтоперевозчикПерваяМиля) = Тип("СправочникСсылка.Контрагенты") Тогда
			МилиКлючаПервая.Вставить("ИНН",ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.АвтоперевозчикПерваяМиля,"ИНН"));
			МилиКлючаПервая.Вставить("КПП",ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.АвтоперевозчикПерваяМиля,"КПП"));  
		// ДИТ BUG 79844 ТА 79845 Сержантова А.С. Начало: 25.01.2024
		Иначе
			МилиКлючаПервая.Вставить("ИНН", "");
			МилиКлючаПервая.Вставить("КПП", "");
		// ДИТ BUG 79844 ТА 79845 Сержантова А.С. Конец: 25.01.2024	
		КонецЕсли;   
		ЗаполнитьСтруктуруМилиКлючаИзЗапросаНаКТК(СтрокаТЧ.КлючАналитикиПеревозки, МилиКлючаПервая, Объект.ТранспортныеСредства);
		
		МилиКлючаПоследняя = Новый Структура;
		// Евросиб(ДИТ) BUG 95213 ТА 95214 Сержантова А.С. Начало: 19.12.2024 
		//МилиКлючаПоследняя.Вставить("ДатаСдачиКТКНаТерминал", СтрокаТЧ.ДатаВозвратаКлиентом);
		Если не РаботаСЗаявкамиВызовСервера.Проверка_ДатаВозвратаИзПервойМили(СтруктураКлючаАналитикиПеревозки.Контейнер, Объект.Ссылка) Тогда
			МилиКлючаПоследняя.Вставить("ДатаСдачиКТКНаТерминал", СтрокаТЧ.ДатаВозвратаКлиентом);
		КонецЕсли;
		// Евросиб(ДИТ) BUG 95213 ТА 95214 Сержантова А.С. Конец: 19.12.2024 
		// ДИТ Ticket#0339024 Сержантова А.С. Начало: 22.01.2024
		МилиКлючаПоследняя.Вставить("ДатаВыездаКТКСоСклада", СтрокаТЧ.ДатаПодачиАвтоПодВыгрузку); 
		// ДИТ Ticket#0339024 Сержантова А.С. Конец: 22.01.2024
		МилиКлючаПоследняя.Вставить("ФИОВодителя", СтрокаТЧ.ФИОВодителяВыгрузка);
		МилиКлючаПоследняя.Вставить("РегНомерТС", СтрокаТЧ.НомерАвтоВыгрузка); 
		МилиКлючаПоследняя.Вставить("Автоперевозчик", СтрокаТЧ.АвтоПеревозчик); 
		// ДИТ BUG 79844 ТА 79845 Сержантова А.С. Начало: 25.01.2024 US 79379 ТА 80813
		//МилиКлючаПоследняя.Вставить("ПаспортныеДанные", "");
		// ДИТ BUG 79844 ТА 79845 Сержантова А.С. Конец: 25.01.2024
		Если ЗначениеЗаполнено(СтрокаТЧ.АвтоПеревозчик) 
			и ТипЗнч(СтрокаТЧ.АвтоПеревозчик) = Тип("СправочникСсылка.Контрагенты")Тогда
			МилиКлючаПоследняя.Вставить("ИНН",ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.АвтоПеревозчик,"ИНН"));
			МилиКлючаПоследняя.Вставить("КПП",ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.АвтоПеревозчик,"КПП"));
		// ДИТ BUG 79844 ТА 79845 Сержантова А.С. Начало: 25.01.2024
		Иначе
			МилиКлючаПоследняя.Вставить("ИНН", "");
			МилиКлючаПоследняя.Вставить("КПП", "");
		// ДИТ BUG 79844 ТА 79845 Сержантова А.С. Конец: 25.01.2024
		КонецЕсли;    
		ЗаполнитьСтруктуруМилиКлючаИзЗапросаНаКТК(СтрокаТЧ.КлючАналитикиПеревозки, МилиКлючаПоследняя, Объект.ТранспортныеСредстваПоследняяМиля);
		
		ЗаполнитьЗначенияСвойств(СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиПерваяМиляКлючаАналитики, МилиКлючаПервая);
		ЗаполнитьЗначенияСвойств(СтруктураКлючаАналитикиПеревозки.СтруктураТЧМилиПоследняяМиляКлючаАналитики, МилиКлючаПоследняя);  
		
		НС = ДанныеОбновленияКлючейАналитики.Добавить(); 
		НС.НомерСтроки 				= СтрокаТЧ.НомерСтроки;
