	КонецЕсли;	
		
	//Если НЕ ТекущийИсполнитель_Состояние = Справочники.Состояния.ВводЗаявкиВыборРейса Тогда 
	//	Возврат ПроверитьДанныеПоПоследнейМиле
	//КонецЕсли;   
	
	//Если Не РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
	//	Возврат ПроверитьДанныеПоПоследнейМиле;
	//КонецЕсли;
	
	Если Объект.ПереченьРейсов.Количество() = 0 Тогда
		Возврат ПроверитьДанныеПоПоследнейМиле;
	КонецЕсли;

	Если Не Объект.Контрагент = Константы.КонтрагентДирекцияКонтейнерныхПеревозок.Получить() Тогда
		Возврат ПроверитьДанныеПоПоследнейМиле;
	КонецЕсли;
	
	
	Если РаботаСЗаявкамиВызовСервера.ЭтоЗаявкаНаАвтоРейс(Объект) Тогда   
		ПроверитьДанныеПоПоследнейМиле = Истина;
	КонецЕсли;
	
	Возврат ПроверитьДанныеПоПоследнейМиле; 
	
КонецФункции	
	
&НаСервере
Функция ПолучитьДанныеПоПоследнейМиле()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗапросНаАвтоперевозку.Ссылка КАК ЗапросНаАвтоперевозку,
		|	ЗапросНаАвтоперевозкуКонтейнеры.СтатусЗапросаНаАвтоперевозку КАК СтатусЗапросаНаАвтоперевозку,
		|	ЗапросНаАвтоперевозкуКонтейнеры.СтатусЗаказаНаТС КАК СтатусЗаказаНаТС,
		|	ЗапросНаАвтоперевозкуКонтейнеры.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	Документ.ЗапросНаАвтоперевозку КАК ЗапросНаАвтоперевозку
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗапросНаАвтоперевозку.Контейнеры КАК ЗапросНаАвтоперевозкуКонтейнеры
		|		ПО (ЗапросНаАвтоперевозкуКонтейнеры.Ссылка = ЗапросНаАвтоперевозку.Ссылка)
		|ГДЕ
		|	ЗапросНаАвтоперевозку.Проведен = ИСТИНА
		|	И ЗапросНаАвтоперевозку.Заявка = &Заявка
		|	И ЗапросНаАвтоперевозку.ЭтапПеревозки = &ЭтапПеревозки";
	
 	Запрос.УстановитьПараметр("Заявка", Объект.Ссылка);
  	Запрос.УстановитьПараметр("ЭтапПеревозки", Перечисления.ЭтапыПеревозки.ПоследняяМиля);

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ДанныеПоПоследнейМили = Новый Структура("ЗапросНаАвтоперевозку, ОтправленТЛ, ПринятТЛ, НомерСтроки");
	ДанныеПоПоследнейМили.ОтправленТЛ = Ложь;
	ДанныеПоПоследнейМили.ПринятТЛ = Ложь;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ДанныеПоПоследнейМили.ЗапросНаАвтоперевозку = ВыборкаДетальныеЗаписи.ЗапросНаАвтоперевозку;
		
		Если ВыборкаДетальныеЗаписи.СтатусЗапросаНаАвтоперевозку = Перечисления.СтатусЗапросаНаПеревозку.Отправлен Тогда
			ДанныеПоПоследнейМили.ОтправленТЛ = Истина;
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.СтатусЗаказаНаТС = Перечисления.СтатусЗаказаНаТс.ВыданВРейс
			Или ВыборкаДетальныеЗаписи.СтатусЗаказаНаТС = Перечисления.СтатусЗаказаНаТс.Закрыт Тогда
			ДанныеПоПоследнейМили.ПринятТЛ = Истина;
			ДанныеПоПоследнейМили.НомерСтроки = ВыборкаДетальныеЗаписи.НомерСтроки;
		КонецЕсли;

	КонецЦикла; 
	
	Возврат ДанныеПоПоследнейМили
	
КонецФункции 

&НаСервере
Процедура ПометитьНаУдалениеЗапросНаАвтоПеревозку(ЗапросНаАвтоперевозку, ПередатьДанныеВТЛ = Ложь)
	
	ДокументОбъект = ЗапросНаАвтоперевозку.ПолучитьОбъект();
	
	СтрокиКвыгрузке = Новый ТаблицаЗначений;
	СтрокиКвыгрузке.Колонки.Добавить("ИдентификаторСтрокиТабличнойЧасти");
	СтрокиКвыгрузке.Колонки.Добавить("ИдентификаторСтрокиТЧ");
	
	Для каждого Строка Из ДокументОбъект.Контейнеры Цикл
		Стр = СтрокиКВыгрузке.Добавить();
		Строка.СтатусЗапросаНаАвтоперевозку = Перечисления.СтатусЗапросаНаПеревозку.Отменен;
		ЗаполнитьЗначенияСвойств(Стр, Строка);
	КонецЦикла;
    ДокументОбъект.Записать();
	
	ПараметрыВыгрузки = Новый Структура("СсылкаЗапросНаАвтоперевозку, СтрокиКВыгрузке", ЗапросНаАвтоперевозку, СтрокиКВыгрузке);
	ЕСОбменСервер.ПередатьЗапросыНаАвтоВТЛ(ПараметрыВыгрузки);	

	ДокументОбъект.УстановитьПометкуУдаления(Истина);

	ЗапросПоследняяМиля = Неопределено;	
	ТекстСообщения =  "Удален запрос на автоперевозку на последнюю милю %1"; 			
	ТекстСообщения = СтрШаблон(ТекстСообщения, ЗапросНаАвтоперевозку);
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьСтрокиПоследнейМили()
	
	ТекстНомераСтрок = "";
	Для Каждого СтрокаУслуги Из Объект.СоставУслуги Цикл
		Если ЗначениеЗаполнено(СтрокаУслуги.ПоследняяМиля) Тогда
			СтрокаУслуги.ПоследняяМиля = Неопределено; 
			ТекстНомераСтрок = ТекстНомераСтрок + СтрокаУслуги.НомерСтроки + ";";
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ТекстНомераСтрок) Тогда	
		ТекстСообщения =  "Очищены значения полей Кем осуществляется автоперевозка (последняя миля) в строках %1 на закладке %2"; 			
		ТекстСообщения = СтрШаблон(ТекстСообщения, ТекстНомераСтрок, "услуги");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	ТекстНомераСтрок = "";
	Для Каждого СтрокаУслуги Из Объект.СписокЗапросНаКТК Цикл
		Если ЗначениеЗаполнено(СтрокаУслуги.ПоследняяМиля) Тогда
			СтрокаУслуги.ПоследняяМиля = Неопределено; 
			ТекстНомераСтрок = ТекстНомераСтрок + СтрокаУслуги.НомерСтроки + ";";
		КонецЕсли;
	КонецЦикла;
		
	Если ЗначениеЗаполнено(ТекстНомераСтрок) Тогда	
		ТекстСообщения =  "Очищены значения полей Кем осуществляется автоперевозка (последняя миля) в строках %1 на закладке %2"; 			
		ТекстСообщения = СтрШаблон(ТекстСообщения, ТекстНомераСтрок, "Запрос на КТК");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;

КонецПроцедуры 
