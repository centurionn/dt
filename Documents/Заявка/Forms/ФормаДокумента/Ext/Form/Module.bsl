	ИначеЕсли не Параметры.Ключ.Пустая()
		и (ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.РефСцеп")) Тогда
		СинхронизироватьДанныеСРефСцепом();	
	КонецЕсли;		
	// -- Евросиб Дудоров С.В. US 57543 30.01.2023  
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ТранспортныеСредстваСиламиЕвросиб.Загрузить(Документы.Заявка.ЗаполнитьТранспортныеСредстваСиламиЕвросиб(Объект.Ссылка)); //ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023
	КонецЕсли;
	
	//БИТ Белинский Д.А. 11.04.2023 -начало
		УстановитьДоступностьПолейПоследнейМили();
	//БИТ Белинский Д.А. 11.04.2023 -конец 
	
	// ДИТ US 79379 ТА 80813 Сержантова А.С. Начало: 19.03.2024
	ЗаполнитьИменаБлокируемыхПолейКлюча();
	// ДИТ US 79379 ТА 80813 Сержантова А.С. Конец: 19.03.2024
	
	//БИТ Белинский Д.А. 20.06.2023 -начало
	УстановитьВидимостьПолейПоКонтрагенту();
	//БИТ Белинский Д.А. 20.06.2023 -конец  
	//Евросиб - АСуслов 06.09.2023 10:30:16 #74149
	//(
	Элементы.СоставУслугиСвязатьКТКСоСтоками.Видимость = Ложь;
	//)
	//Евросиб - АСуслов 06.09.2023 10:30:24 #74149
	
	//Евросиб Коханенко Н.А. 02.09.2024 (( #90198 
	УстановитьДоступностьПолейПоЗаявкеИзЛК();
	//Евросиб Коханенко Н.А. 02.09.2024 )) #90198 
	
	// Евросиб(ДИТ) BUG 92539 ТА 97789 Сержантова А.С. Начало: 10.12.2024
	СкрытьКолонкиСНаименованиемУдалить();
	// Евросиб(ДИТ) BUG 92539 ТА 97789 Сержантова А.С. Конец: 10.12.2024
	
	//Евросиб(ДИТ), Беляев СЮ, US 90649 / TA 93760, 02-11-2024, начало
	ГруппаДКС = РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ПолучитьГруппуДКСпоДокументу(Объект.Ссылка);
	Если НЕ ЗначениеЗаполнено(ГруппаДКС) Тогда
		//Евросиб(ДИТ), Беляев СЮ, US 95609 / TA 95939, 21-11-2024, начало
		МассивКалькуляций = Объект.СоставУслуги.Выгрузить().ВыгрузитьКолонку("Калькуляция");
		//Евросиб(ДИТ), Беляев СЮ, US 95609 / TA 95939, 21-11-2024, конец
		Элементы.ГруппаДКС.ОтметкаНезаполненного = ЗапрещеноНезаполненноеЗначениеГруппыДКС(Объект.Дата, МассивКалькуляций);
	КонецЕсли;
	//Евросиб(ДИТ), Беляев СЮ, US 90649 / TA 93760, 02-11-2024, конец
	
	//Евросиб(ДИТ), Беляев СЮ, US 93144 / TA 95492, 29-11-2024, начало
	ВидЗадолженности = ПолучитьВидЗадолженности(Объект.Ссылка);
	//Евросиб(ДИТ), Беляев СЮ, US 93144 / TA 95492, 29-11-2024, конец 
	
	//ДИТ Шевченко А.В. 17.01.2024 US 91366 TA 93137 -начало
	ТранзитДляКлиента = РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ПолучитьТранзитДляКлиентапоДокументу(Объект.Ссылка);
