&НаКлиенте
Процедура ВыполнитьСозданиеРелизаКлиента()
    // Евросиб Фролов (06.12.2021 TASK№ №42618, РелизКлиента
	ТекущиеДанные = Элементы.СписокЗапросНаКТК.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Укажите строку, по данным которой
								|необходимо создать релиз клиента.");
		Возврат;
	КонецЕсли;
	
	//ДИТ Шевченко А.В. 59986 12.12.2022 -Начало	
	ДоговорДействует = Истина;
		
	Если ЗначениеЗаполнено(Объект.Договор) И ЗначениеЗаполнено(Объект.Отправка) и НЕ ЗначениеЗаполнено(Объект.Прибытие) Тогда
		ДоговорДействует = ПроверитьПериодДействияДоговора(Объект.Договор,Объект.Отправка,Дата(1,1,1),Истина);
	ИначеЕсли ЗначениеЗаполнено(Объект.Договор) И НЕ ЗначениеЗаполнено(Объект.Отправка) и ЗначениеЗаполнено(Объект.Прибытие) Тогда
		ДоговорДействует = ПроверитьПериодДействияДоговора(Объект.Договор,Объект.Прибытие,Дата(1,1,1),Истина);
	ИначеЕсли ЗначениеЗаполнено(Объект.Договор) И ЗначениеЗаполнено(Объект.Отправка) И ЗначениеЗаполнено(Объект.Прибытие) Тогда
		ДоговорДействует = ПроверитьПериодДействияДоговора(Объект.Договор,Объект.Отправка,Объект.Прибытие);
	ИначеЕсли ЗначениеЗаполнено(Объект.Договор) И НЕ ЗначениеЗаполнено(Объект.Отправка) И НЕ ЗначениеЗаполнено(Объект.Прибытие) Тогда
		ДоговорДействует = ПроверитьПериодДействияДоговора(Объект.Договор,Объект.Дата,Дата(1,1,1),Истина);	
	КонецЕсли;
	
	Если НЕ ДоговорДействует Тогда
		Автопролонгация = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(Объект.Договор,"Автопролонгация");
		Если Автопролонгация Тогда
			СообщениеТекст = "Документ не может быть создан. Договор не продлен на текущий год, необходимо продлить договор через отдел делопроизводства";
			ДобавитЗадачуНаПролонгациюДоговора(Объект.Договор); //ДИТ Шевченко А.В. 65173 09.02.2023
		Иначе
			СообщениеТекст = "Документ не может быть создан. Срок действия договора истек, необходимо оформить ДС на продления срока действия договора";
		КонецЕсли;
		ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеТекст,,,,);
		Возврат;
	КонецЕсли;				
    //ДИТ Шевченко А.В. 59986 12.12.2022 -Конец
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("Заявка", 					Объект.Ссылка);
	ДанныеЗаполнения.Вставить("ОбщееКоличествоКТКВРелизе", 	ТекущиеДанные.КоличествоКТК);
	ДанныеЗаполнения.Вставить("ТипоразмерКТК", 				ТекущиеДанные.ТипКТК);
	ДанныеЗаполнения.Вставить("ЛокацияВыдачи", 				ТекущиеДанные.ЛокацияВыдачи);
	ДанныеЗаполнения.Вставить("ЛокацияСдачи", 				ТекущиеДанные.ЛокацияСдачи);
	ДанныеЗаполнения.Вставить("ДействиеРелизаНачало", 		ТекущиеДанные.ДействиеРелизаНачало);
	ДанныеЗаполнения.Вставить("ДействиеРелизаОкончание", 	ТекущиеДанные.ДействиеРелизаОкончание);
	ДанныеЗаполнения.Вставить("Автоперевозка", 				ТекущиеДанные.Автоперевозка);
	//ДИТ Шевченко А.В. 59364 06.03.2023 -начало
	ДанныеЗаполнения.Вставить("АвтоперевозкаПоследняяМиля", ТекущиеДанные.ПоследняяМиля); 
	//ДИТ Шевченко А.В. 59364 06.03.2023 -конец
	ДанныеЗаполнения.Вставить("СрокИспользованияКТК", 		ТекущиеДанные.СрокИспользованияКТК);
	ДанныеЗаполнения.Вставить("Ставка", 					ТекущиеДанные.Ставка);
	ДанныеЗаполнения.Вставить("СНП", 						ТекущиеДанные.СНП);
	ДанныеЗаполнения.Вставить("Валюта", 					ТекущиеДанные.ВалютаПоДоговору);
	//ДИТ Шевченко А.В. US 62421 TA 64347 21.02.2023 -начало
	ДанныеЗаполнения.Вставить("ИдентификаторСтроки",		ТекущиеДанные.ИдентификаторСтроки);
	//ДИТ Шевченко А.В. US 62421 TA 64347 21.02.2023 -конец
	ДанныеЗаполнения.Вставить("ТранспортныеСредства", 		ПолучитьТаблицуДляПереноса("ТранспортныеСредства", ТекущиеДанные.ИдентификаторСтроки));
	//ДИТ Шевченко А.В. 59364 13.03.2023 -начало
	ДанныеЗаполнения.Вставить("ТранспортныеСредстваПоследняяМиля", 		ПолучитьТаблицуДляПереноса("ТранспортныеСредстваПоследняяМиля", ТекущиеДанные.ИдентификаторСтроки));
	//ДИТ Шевченко А.В. 59364 13.03.2023 -конец
	// ДИТ US 58592 TA 60724 Евсенкин М.А. Начало: 13.12.2022
	мСтруктураСтанцияДата = ПолучитьСтанциюНазначенияИДатуОтправления("СписокЗапросНаКТК", ТекущиеДанные.ИдентификаторСтроки);	
	ДанныеЗаполнения.Вставить("ДатаОтправленияПоЖДПлан",	мСтруктураСтанцияДата.ДатаОтправленияПоЖДПлан);
	ДанныеЗаполнения.Вставить("СтанцияНазначенияПоЖД",		мСтруктураСтанцияДата.СтанцияНазначенияПоЖД);
	// ДИТ US 58592 TA 60724 Евсенкин М.А. Конец: 13.12.2022
	
	//Субботин 77659 15.12.2023 Начало 
	МассивКтк = Новый Массив();
	МассивТЕ = СтрРазделить(ОбщегоНазначенияВызовСервера.ПривестиСтрокуУчетныхЕдиницКТребуемомуФормату(ТекущиеДанные.СписокКТК), ";", Ложь);
	Для Каждого ЭлемМассива Из МассивТЕ Цикл
		Если ТипЗнч(ЭлемМассива) = Тип("Строка") Тогда
			МассивКтк.Добавить(РаботаСКонтейнерамиСервер.НайтиКТК(ЭлемМассива)); 
		Иначе
			МассивКтк.Добавить(ЭлемМассива);
		КонецЕсли;
	КонецЦикла;	
	ДанныеЗаполнения.Вставить("МассивКТК", 					МассивКтк); 
	
	КлючиКТК = Новый Соответствие;
	Для Каждого СтрокаКТК Из МассивКтк Цикл 
		ПараметрыПоиска = Новый Структура("НомерКТК",СтрокаКТК);
		РезПоиска = Объект.СоставУслуги.НайтиСтроки(ПараметрыПоиска);
		Если РезПоиска.Количество()<> 0 Тогда 
			Для Каждого СтрокаРезультата Из РезПоиска Цикл
				КлючиКТК.Вставить(СтрокаРезультата.НомерКТК, СтрокаРезультата.КлючАналитикиПеревозки);
			КонецЦикла; 
		КонецЕсли;
	КонецЦикла;		
			
	ДанныеЗаполнения.Вставить("СоответствиеКлючейАналитики", КлючиКТК);	
	//Субботин 77659 15.12.2023 Конец
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", 		 ДанныеЗаполнения);
	ПараметрыФормы.Вставить("ИдентификаторСтрокиЗаявки", ТекущиеДанные.ИдентификаторСтроки);
	ПараметрыФормы.Вставить("СозданиеРелизаИзЗаявки", 	 Истина);
		
	ОткрытьФорму("Документ.РелизКлиента.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); //ДИТ Шевченко А.В. US 62482 ТА 68277 17.04.2023 
	// Евросиб Фролов)
КонецПроцедуры	

&НаСервереБезКонтекста
Процедура ДобавитЗадачуНаПролонгациюДоговора(Договор) //ДИТ Шевченко А.В. 65173 09.02.2023
	
	ДоговорОбъект = Договор.ПолучитьОбъект();
	СтруктураПоиска = Новый Структура();
	СтруктураПоиска.Вставить("Состояние",Справочники.Состояния.НеобходимаПролонгацияДоговора);
	МассивСтрок = ДоговорОбъект.Состояния.НайтиСтроки(СтруктураПоиска);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Договор",				Договор);
	СтруктураПараметров.Вставить("ЦФО",					Справочники.ЦентрыФинансовойОтветственности.ОсновнойЦФО);
	СтруктураПараметров.Вставить("ТипОтветственного",	Перечисления.ТипыОтветственных.ОтветственныйЗаСопровождение);  
	мОтветственныйЗаСопровождение = Справочники.ДоговорыКонтрагентов.ПолучитьОтветственного(СтруктураПараметров);
	Если ЗначениеЗаполнено(мОтветственныйЗаСопровождение) Тогда
		Если МассивСтрок.Количество() = 0 Тогда
			НСтр = ДоговорОбъект.Состояния.Добавить();
			НСтр.Состояние = Справочники.Состояния.НеобходимаПролонгацияДоговора;
			НСтр.Исполнитель = мОтветственныйЗаСопровождение;
			НСтр.Наблюдатель = мОтветственныйЗаСопровождение;
			НСтр.Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
			НСтр.НормативИсполненияСМоментаСоздания = 2;
		Иначе
			Если МассивСтрок[0].Статус = Перечисления.СтатусыЭтапов.Выполнен Тогда
				МассивСтрок[0].Исполнитель = мОтветственныйЗаСопровождение;
				МассивСтрок[0].Наблюдатель = мОтветственныйЗаСопровождение;
				МассивСтрок[0].Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
				МассивСтрок[0].НормативИсполненияСМоментаСоздания = 2;
			КонецЕсли;
		КонецЕсли;
		
		Попытка
			УстановитьПривилегированныйРежим(Истина);
			ДоговорОбъект.Записать();
			УстановитьПривилегированныйРежим(Ложь);
		Исключение
			ЗаписьЖурналаРегистрации("Данные.Изменение",УровеньЖурналаРегистрации.Ошибка,,ДоговорОбъект.Ссылка,"Ошибка записи договора. Создание задачи на пролонгацию договора");
			ВызватьИсключение;
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры	

