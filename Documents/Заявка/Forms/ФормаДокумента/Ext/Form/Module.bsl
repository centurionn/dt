&НаКлиенте
Процедура ЗаполнитьКонтейнерыИзАРМНакладные(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Отправка) Тогда
		ПоказатьПредупреждение(, "Не указана Дата отправки!");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Грузоотправитель) Тогда
		ПоказатьПредупреждение(, "Не указан Грузоотправитель!");
		Возврат;
	КонецЕсли;
	
	СтрокиБезКонтейнеров = Объект.СоставУслуги.НайтиСтроки(Новый Структура("НомерКТК", ПредопределенноеЗначение("Справочник.ТЕ.ПустаяСсылка")));
	МаксимальноеКоличествоВыбранныхСтрок = СтрокиБезКонтейнеров.Количество();
	Если МаксимальноеКоличествоВыбранныхСтрок = 0 Тогда
		ПоказатьПредупреждение(, "Нет строк без контейнеров!");
		Возврат;
	КонецЕсли;    
	
	// ДИТ US 81881 ТА 81882 Сержантова А.С. Начало: 28.03.2024 
	СтрокиБезКлюча = Объект.СоставУслуги.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки", ПредопределенноеЗначение("Справочник.КлючиАналитикиПеревозки.ПустаяСсылка")));
	Если СтрокиБезКлюча.Количество() > 0 Тогда
		ПоказатьПредупреждение(, "Необходимо сначала записать заявку!");
		Возврат;
	КонецЕсли; 
	// ДИТ US 81881 ТА 81882 Сержантова А.С. Конец: 28.03.2024
	
	Грузополучатели = Новый Массив;
	СтанцииОтправления = Новый Массив;
	СтанцииНазначения = Новый Массив;
	Для Каждого СтрокаБезКонтейнера Из СтрокиБезКонтейнеров Цикл
		Если ЗначениеЗаполнено(СтрокаБезКонтейнера.Грузополучатель) И Грузополучатели.Найти(СтрокаБезКонтейнера.Грузополучатель) = Неопределено Тогда
			Грузополучатели.Добавить(СтрокаБезКонтейнера.Грузополучатель);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаБезКонтейнера.СтанцияОтправления) И СтанцииОтправления.Найти(СтрокаБезКонтейнера.СтанцияОтправления) = Неопределено Тогда
			СтанцииОтправления.Добавить(СтрокаБезКонтейнера.СтанцияОтправления);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаБезКонтейнера.СтанцияНазначения) И СтанцииНазначения.Найти(СтрокаБезКонтейнера.СтанцияНазначения) = Неопределено Тогда
			СтанцииНазначения.Добавить(СтрокаБезКонтейнера.СтанцияНазначения);
		КонецЕсли;
	КонецЦикла;
	
	Грузополучатель = Неопределено;
	Если Грузополучатели.Количество() > 0  Тогда
		Грузополучатель = Грузополучатели[0];
	Иначе
		ПоказатьПредупреждение(, "Не указан Грузополучатель!");
		Возврат;
	КонецЕсли;
	
	Если СтанцииОтправления.Количество() = 1 Тогда
		СтанцияОтправления = СтанцииОтправления[0];
	Иначе
		СтанцияОтправления = Неопределено;
	КонецЕсли;
	
	Если СтанцииНазначения.Количество() = 1 Тогда
		СтанцияНазначения = СтанцииНазначения[0];
	Иначе
		СтанцияНазначения = Неопределено;
	КонецЕсли;
	
	ПараметрыФормыПодбораНакладных = Новый Структура;
	ПараметрыФормыПодбораНакладных.Вставить("ПодборВДокумент", Истина);
	ПараметрыФормыПодбораНакладных.Вставить("ДатаНачала", НачалоДня(Объект.Отправка));
	ПараметрыФормыПодбораНакладных.Вставить("ДатаОкончания", КонецДня(Объект.Отправка));
	ПараметрыФормыПодбораНакладных.Вставить("Грузоотправитель", Объект.Грузоотправитель);
	ПараметрыФормыПодбораНакладных.Вставить("Грузополучатель", Грузополучатель);
	ПараметрыФормыПодбораНакладных.Вставить("СтанцияОтправления", СтанцияОтправления);
	ПараметрыФормыПодбораНакладных.Вставить("СтанцияНазначения", СтанцияНазначения);
	Если ЗначениеЗаполнено(СтанцияНазначения) И ЗначениеЗаполнено(СтанцияОтправления) Тогда
		ПараметрыФормыПодбораНакладных.Вставить("ВыполнитьПоискПриОткрытии", Истина);
	КонецЕсли;
	ПараметрыФормыПодбораНакладных.Вставить("МаксимальноеКоличествоВыбранныхСтрок", МаксимальноеКоличествоВыбранныхСтрок);	
	
	ОповещениеОПодбореКонтейнеров = Новый ОписаниеОповещения("ОбработатьВыборКонтейнеровИзАРМНакладные", ЭтаФорма);
	//ДИТ Шевченко А.В. 16.09.2022 55882 -начало
	ОткрытьФорму("Обработка.АРМНакладные.Форма", ПараметрыФормыПодбораНакладных, ЭтаФорма,,,, ОповещениеОПодбореКонтейнеров, РежимОткрытияОкнаФормы.Независимый);
	//ДИТ Шевченко А.В. 16.09.2022 55882 -конец
КонецПроцедуры

