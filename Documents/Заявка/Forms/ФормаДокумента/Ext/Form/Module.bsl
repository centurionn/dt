// ДИТ US 79379 ТА 80813 Сержантова А.С. 07.03.2024 
&НаКлиенте
Функция ПолеКлючаНедоступноДляИзменения(СтрокаТаблицы, ИмяПоля)

	Структура = Новый Структура("ТаблицаБлокировкиПолейКлючаАналитики", Неопределено);
    
    ЗаполнитьЗначенияСвойств(Структура, ЭтаФорма);
    
	Если Структура["ТаблицаБлокировкиПолейКлючаАналитики"] <> Неопределено Тогда
		СтруктураПоиска = Новый Структура("КлючАналитикиПеревозки", СтрокаТаблицы.КлючАналитикиПеревозки); 
		СтрокиЗаблокированные = ЭтаФорма.ТаблицаБлокировкиПолейКлючаАналитики.НайтиСтроки(СтруктураПоиска);
		Для каждого СтрокаКлюча Из СтрокиЗаблокированные Цикл
			НаименованияПолей = СтрРазделить(СтрокаКлюча.НаименованиеПоля, ","); 
			Если НаименованияПолей.Найти(ИмяПоля) <> Неопределено Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла; 
		// если в строке по миле установлен вариант автоперевозки "Не требуется", то все поля по этой миле не доступны для редактирования 
		ПоляПервойМили = СтрРазделить("ФИОВодителя,НомерАвто,АдресПогрузки,ДатаПодачиАвтоПодПогрузку,АвтоперевозчикПерваяМиля", ",");
		ПоляПоследнейМили = СтрРазделить("ФИОВодителяВыгрузка,НомерАвтоВыгрузка,АдресВыгрузки,ДатаПодачиАвтоПодВыгрузку,АвтоПеревозчик", ",");
		Если (ПоляПервойМили.Найти(ИмяПоля) <> Неопределено 
			и СтрокаТаблицы.ПерваяМиля = ПредопределенноеЗначение("Перечисление.ВариантыАвтоперевозки.НеТребуется"))
			или (ПоляПоследнейМили.Найти(ИмяПоля) <> Неопределено 
			и СтрокаТаблицы.ПоследняяМиля = ПредопределенноеЗначение("Перечисление.ВариантыАвтоперевозки.НеТребуется")) Тогда
		    Возврат Истина;
		КонецЕсли;
	КонецЕсли;  
	
	Возврат Ложь;

КонецФункции 

// ДИТ US 79379 ТА 80813 Сержантова А.С. 07.03.2024
&НаСервере
Процедура ЗаполнитьИменаБлокируемыхПолейКлюча()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПравилаБлокировкиПолейКлючаПеревозки.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_ПравилоБлокировки
		|ИЗ
		|	Справочник.ПравилаБлокировкиПолейКлючаПеревозки КАК ПравилаБлокировкиПолейКлючаПеревозки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных
		|		ПО ПравилаБлокировкиПолейКлючаПеревозки.ВидОбъекта.ПолноеИмя = ИдентификаторыОбъектовМетаданных.ПолноеИмя
		|ГДЕ
		|	ПравилаБлокировкиПолейКлючаПеревозки.ФормаОбъекта = &ФормаОбъекта
		|	И НЕ ПравилаБлокировкиПолейКлючаПеревозки.ПометкаУдаления
		|	И ТИПЗНАЧЕНИЯ(ИдентификаторыОбъектовМетаданных.ЗначениеПустойСсылки) = &ТипЗначенияОбъекта
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПравилаБлокировкиПолейКлючаПеревозкиПравила.РеквизитФормы КАК РеквизитФормы
		|ИЗ
		|	ВТ_ПравилоБлокировки КАК ВТ_ПравилоБлокировки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПравилаБлокировкиПолейКлючаПеревозки.Правила КАК ПравилаБлокировкиПолейКлючаПеревозкиПравила
		|		ПО ВТ_ПравилоБлокировки.Ссылка = ПравилаБлокировкиПолейКлючаПеревозкиПравила.Ссылка";
	
	Запрос.УстановитьПараметр("ТипЗначенияОбъекта", Тип("ДокументСсылка.Заявка")); 
	ЧастиИмени = СтрРазделить(ИмяФормы, ".");
	Запрос.УстановитьПараметр("ФормаОбъекта", ЧастиИмени[ЧастиИмени.Количество() - 1]);
	
	РезультатЗапроса = Запрос.Выполнить();  
	МассивБлокируемыхПолей = Новый Массив;
	Если не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			МассивБлокируемыхПолей.Добавить(Выборка.РеквизитФормы);
		КонецЦикла;
	КонецЕсли;
	
	ЭтаФорма.БлокируемыеПоляКлючаАналитикиПеревозки.ЗагрузитьЗначения(МассивБлокируемыхПолей);
	
КонецПроцедуры

