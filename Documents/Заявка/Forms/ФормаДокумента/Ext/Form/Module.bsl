&НаСервере
Процедура ЗаполнитьСсылкаНаЗапросыАвтоперевозки()
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗапросНаАвтоперевозку.ЭтапПеревозки КАК ЭтапПеревозки,
		|	ЗапросНаАвтоперевозку.Ссылка КАК ЗапросНаАвтоперевозку
		|ИЗ
		|	Документ.ЗапросНаАвтоперевозку КАК ЗапросНаАвтоперевозку
		|ГДЕ
		|	ЗапросНаАвтоперевозку.Заявка = &Заявка
		|	И НЕ ЗапросНаАвтоперевозку.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗапросНаАвтоперевозку.Дата";
	
	Запрос.УстановитьПараметр("Заявка", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ЗапросПерваяМиля 	= Документы.ЗапросНаАвтоперевозку.ПустаяСсылка();
	//Евросиб Коханенко Н.А. 07.08.2024 (( #87840 
	ЗапросСредняяМиля 	= Документы.ЗапросНаАвтоперевозку.ПустаяСсылка();
	//Евросиб Коханенко Н.А. 07.08.2024 )) #87840 
	ЗапросПоследняяМиля = Документы.ЗапросНаАвтоперевозку.ПустаяСсылка();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПерваяМиля Тогда
			ЗапросПерваяМиля 	= ВыборкаДетальныеЗаписи.ЗапросНаАвтоперевозку;
		//Евросиб Коханенко Н.А. 07.08.2024 (( #87840 
		ИначеЕсли ВыборкаДетальныеЗаписи.ЭтапПеревозки = Перечисления.ЭтапыПеревозки.СредняяМиля Тогда
			ЗапросСредняяМиля 	= ВыборкаДетальныеЗаписи.ЗапросНаАвтоперевозку;
		//Евросиб Коханенко Н.А. 07.08.2024 )) #87840 
		Иначе
			ЗапросПоследняяМиля = ВыборкаДетальныеЗаписи.ЗапросНаАвтоперевозку;
		КонецЕсли	
	КонецЦикла;	
	
КонецПроцедуры	

