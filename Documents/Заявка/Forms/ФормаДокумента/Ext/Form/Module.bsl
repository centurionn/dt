Процедура ПСЦПриИзменении(Элемент, ДействующийПСЦ = неопределено)

	// ДИТ ТА 112604 Дедуник Д.О. Начало: 24.07.2025
	ТранзитДляКлиента = ПолучитьТранзитДляКлиентаПокументаОснования();
	// ДИТ ТА 112604 Дедуник Д.О. Конец: 24.07.2025
	
	Если (НЕ ЗначениеЗаполнено(Объект.ПСЦ) и ДействующийПСЦ = неопределено) ИЛИ НЕ ПравоРедактирования тогда возврат; КонецЕсли;
	
	Если ДействующийПСЦ = неопределено Тогда ДействующийПСЦ = Объект.ПСЦ; КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Грузоотправитель) Тогда
		Объект.Грузоотправитель = ГрузоотправительПоПСЦ(ДействующийПСЦ);
	КонецЕсли;
	
	//Евросиб Коханенко Н.А. 03.07.2023 (( #72162 
	ЗаполнитьПолеВидПеревозкиЗначениемПоУмолчанию();
	//Евросиб Коханенко Н.А. 03.07.2023 )) #72162 
	
	Рез = ПолучитьКалькуляциюИУслугуПоУмолчанию(ДействующийПСЦ);
	Если Рез.Количество() = 1 Тогда
		КалькуляцияПоУмолчанию = Рез[0].Калькуляция;
		УслугаПоУмолчанию = Рез[0].Услуга;
	Иначе
		КалькуляцияПоУмолчанию = неопределено;
		УслугаПоУмолчанию = неопределено;
	КонецЕсли;
	
	//Евросиб Коханенко Н.А. 25.02.2025 (( #101467 
	//Элементы.СоставУслугиКалькуляция.СписокВыбора.Очистить();
	//Для каждого Стр из Рез Цикл
	//	Элементы.СоставУслугиКалькуляция.СписокВыбора.Добавить(Стр.Калькуляция);
	//КонецЦикла;  
	//Евросиб Коханенко Н.А. 25.02.2025 )) #101467 
	
	// ДИТ US 59973 ТА 68125 Сержантова А.С. Начало: 28.07.2023
	Если ЭтоЗаявкаПоСубсидии(Объект.ПСЦ) Тогда
		УслугаПоУмолчанию = ПредопределенноеЗначение("Справочник.Номенклатура.Премия");
		Элементы.ГруппаСписокЗапросНаКТК.Видимость = Ложь;
	КонецЕсли;
	// ДИТ US 59973 ТА 68125 Сержантова А.С. Конец: 28.07.2023
	
КонецПроцедуры 

