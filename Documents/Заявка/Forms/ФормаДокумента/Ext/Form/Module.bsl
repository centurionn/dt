&НаСервереБезКонтекста
Функция ПолучитьЕдинственныйДоговорКонтрагентаНаСервере(Контрагент)
	КонтрагентДирекцииЕвросиба = Константы.КонтрагентДирекцияКонтейнерныхПеревозок.Получить();
	Если Контрагент = КонтрагентДирекцииЕвросиба Тогда
	    Возврат КонтрагентыДоговоры_Сервер.ПолучитьЕдинственныйДоговорКонтрагента(Контрагент);
	КонецЕсли;	
    Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
КонецФункции

&НаКлиенте
Процедура КонтрагентНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0362212, 20-08-2024, начало
	Если НЕ РазрешеноИзменитьКонтрагента() Тогда
		СтандартнаяОбработка = Ложь;	
		Возврат;
	КонецЕсли;
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0362212, 20-08-2024, конец
	
	СтандартнаяОбработка = Ложь;
	Настройки = Новый НастройкиКомпоновкиДанных;
	
	ГруппаОтбора = Настройки.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИЛИ;

	//далее добавляем первое условие отбора
	ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	//ЭлементОтбора.Родитель = ГруппаОтбора;
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТипКонтрагента_Клиент");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.ПравоеЗначение = Истина;

	//далее добавляем второе условие отбора. У нас вид соединения: или 1 условие или 2 условие
	ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	//ЭлементОтбора.Родитель = ГруппаОтбора;
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДляСлужебныхЗаявок");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.ПравоеЗначение = Истина;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ФиксированныеНастройки", Настройки);
	
	ДополнительныеПараметры = Новый Структура();
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ДобавитьКонтрагентаПриВыбореЗавершение"
		, ЭтаФорма, ДополнительныеПараметры);
	
	ОткрытьФорму("Справочник.Контрагенты.ФормаВыбора", ПараметрыФормы,
		, ЭтаФорма.УникальныйИдентификатор, ,
		, ОписаниеОповещения
		, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКонтрагентаПриВыбореЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если ТипЗнч(Результат) = Тип("СправочникСсылка.Контрагенты") Тогда
		Объект.Контрагент = Результат;
		КонтрагентПриИзменении(Элементы.Контрагент);
	КонецЕсли;	
КонецПроцедуры
