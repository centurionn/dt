// ДИТ US 78234 ТА 78241 Сержантова А.С. 12.12.2023
&НаКлиенте
Процедура СоставУслугиПриАктивизацииЯчейки(Элемент)
	ТекДанные = Элементы.СоставУслуги.ТекущиеДанные;    
	
	// Если груз в строке Сборная контейнерная отправка, то вес и кол-во мест заполняем из ТЧ детализация по грузу,
	//в строках услуг заполнение не доступно. 
	Если ТекДанные <> Неопределено Тогда
		Если ТекДанные.Груз <> ПредопределенноеЗначение("Справочник.Грузы.СборнаяКонтейнернаяОтправка") Тогда
			Элементы.СоставУслугиВесГрузаНетто.Доступность = Истина;
			Элементы.СоставУслугиКоличествоМест.Доступность = Истина;
		Иначе
			Элементы.СоставУслугиВесГрузаНетто.Доступность = Ложь;
			Элементы.СоставУслугиКоличествоМест.Доступность = Ложь;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

