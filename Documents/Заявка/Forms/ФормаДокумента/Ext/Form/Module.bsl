	ЕстьПравоРедактированияКалькуляцийИПлановыхЛокаций = ЕстьПравоРедактированияКалькуляцийИПлановыхЛокаций();
	Элементы.СоставУслугиПодобратьКалькуляцию.Видимость = ЕстьПравоРедактированияКалькуляцийИПлановыхЛокаций;
	Элементы.СоставУслугиЗагрузитьПлановыеЛокацииСдачиКТК.Видимость = ЕстьПравоРедактированияКалькуляцийИПлановыхЛокаций;
	// Евросиб Рыбьяков К.А. 01.07.2025 ))
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТранзитДляКлиентаПокументаОснования() //ДИТ Шевченко А.В. 17.01.2024 US 91366 TA 93137
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(Объект.ПСЦ) Тогда
		ПСЦ = Объект.ПСЦ;		
		Результат = РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ПолучитьТранзитДляКлиентаПоДокументу(ПСЦ);				
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

//Евросиб(ДИТ), Беляев СЮ, US 93144 / TA 95492, 29-11-2024, начало
