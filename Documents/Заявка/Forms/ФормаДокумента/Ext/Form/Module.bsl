&НаСервереБезКонтекста
Функция НайтиКТК(Знач НомерКТК) 
	
	Результат = Неопределено;
	Если НомерКТК = "" Тогда Возврат Результат; КонецЕсли;
	НомерКТК = СтрЗаменить(НомерКТК, " ", "");
	НомерКТК = СтрЗаменить(НомерКТК, Символы.ПС, "");
	НомерКТК = СтрЗаменить(НомерКТК, Символы.Таб, "");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ТЕ.Ссылка КАК Ссылка,
	               |	ТЕ.ПометкаУдаления КАК ПометкаУдаления
	               |ИЗ
	               |	Справочник.ТЕ КАК ТЕ
	               |ГДЕ
	               |	ТЕ.Префикс = &Префикс
	               |	И ТЕ.Номер = &Номер
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ТЕ.ПометкаУдаления";
	Запрос.УстановитьПараметр("Префикс", Лев(ВРег(НомерКТК), 4));
	Запрос.УстановитьПараметр("Номер", Сред(НомерКТК, 5, 6));
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.Ссылка;
	КонецЕсли;
	
	Если Результат <> Неопределено И Результат.ПометкаУдаления = Истина Тогда
		РезОбъект = Результат.ПолучитьОбъект();
		РезОбъект.ПометкаУдаления = Ложь;
		РезОбъект.Записать();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПодборКТКСток(Команда)
	
	ТекД = Элементы.СоставУслуги.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Сообщить("Выберите строку, по которой будет осуществляться подбор");
		Возврат;
	КонецЕсли;
	
	// надо что-то добавить, чтобы строка-источник дублировалась (данные по номенклатуре и проч переносились)
	Если НЕ ЗначениеЗаполнено(ТекД.ПунктОтправления) ИЛИ
		НЕ ЗначениеЗаполнено(ТекД.ПунктНазначения) ИЛИ
		НЕ ЗначениеЗаполнено(ТекД.ТипКТК) Тогда
		Сообщить("Для подбора контейнеров должны быть заполнены пункт отправления, пункт назначения и тип контейнера");
		Возврат;
	КонецЕсли;
	
	// запоминаем ГУИД строки для того, чтобы после подбора удалить ее по этому ГУИД. Иначе будет задвоение строки
	// Для строк, которые не являются подобранными из стока, галочка ПЛАН не стоит. 
	Если НЕ ТекД.План Тогда
		ТекГУИД = ТекД.ПолучитьИдентификатор();
	Иначе
		ТекГУИД = "П" + Строка(ТекД.ПолучитьИдентификатор());
	КонецЕсли;
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Контрагент",ТекД.ВладелецКТК);
	ПараметрыОтбора.Вставить("Сток",ТекД.ПунктОтправления);
	ПараметрыОтбора.Вставить("Направление",ТекД.ПунктНазначения);
	ПараметрыОтбора.Вставить("ТипКонтейнера",ТекД.ТипКТК);
	ПараметрыОтбора.Вставить("СрокВозврата",Объект.Прибытие);
	ПараметрыОтбора.Вставить("ГУИД",ТекГУИД);
	ПараметрыОтбора.Вставить("Заявка",Объект.Ссылка);
	ПараметрыОтбора.Вставить("ДатаЗаявки",ЭтаФорма.Объект.Дата);
	
	КТКВХранилище = ПоместитьКТКВХранилище(ТекГУИД);
	
	ПараметрыОтбора.Вставить("КТКВХранилище", КТКВХранилище);

	КоличествоТребуемыхКТК = Объект.СоставУслуги.Количество()-Объект.СоставУслуги.НайтиСтроки(Новый Структура("ПринадлежностьТЕ", ПредопределенноеЗначение("Перечисление.ПринадлежностьТЕ.КТКлиента"))).Количество();
	ПараметрыОтбора.Вставить("КоличествоТребуемыхКТК", КоличествоТребуемыхКТК);
	
	ОткрытьФорму("Документ.СтокКонтейнеров.Форма.ФормаПодбораКТИзСтоков", ПараметрыОтбора, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Функция ПоместитьКТКВХранилище(ТекГУИД)
	
	ПараметрыОтбора = Новый Структура;
	//ПараметрыОтбора.Вставить("План",Истина);
	//// использовать именно конструкцию "ЭтаФорма.Объект.СоставУслуги", т.к. это позволяет получить данные незаписанного объекта.
	//// передаем в форму выбора только те строки, которые ранее были выбраны из стока.
	НайденныеСтроки = ЭтаФорма.Объект.СоставУслуги.НайтиСтроки(ПараметрыОтбора);

	// Если подбор б/н контейнеров, то добавить в таблицу хранилища строку с ГУИД, чтобы потом ее заменить на новую
	//Если НЕ ТекГУИД = Неопределено Тогда
	//	ТекСтр = ЭтаФорма.Объект.СоставУслуги.НайтиПоИдентификатору(ТекГУИД);
	//	НайденныеСтроки.Добавить(ТекСтр);
	//КонецЕсли;
	НаборРеквизитов = "НомерКТК,ПунктОтправления,СтанцияОтправления,ПунктНазначения,СтанцияНазначения,ВладелецКТК,ТипКТК,ДатаВыдачи,ДатаПриемаВСток,ВремяПрибытияНаТерминал,ГУИДСтроки,ИнструкцииПоСдачеПорожнего";
	
	ТаблицаКТК = ЭтаФорма.Объект.СоставУслуги.Выгрузить(НайденныеСтроки, НаборРеквизитов);
	
	ТаблицаКТК.Колонки.Добавить("КонтейнерНаЗамену",Новый ОписаниеТипов("СправочникСсылка.ТЕ"));
		
	Возврат ПоместитьВоВременноеХранилище(ТаблицаКТК, УникальныйИдентификатор);
	
КонецФункции

&НаКлиенте
Процедура ОбработатьПодбор(ТекГУИД) Экспорт
	
	ПолучитьКТКИзХранилища(КТКВХранилище,ТекГУИД);
	
	ВидимостьКолонокПринадлежности();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьЗамену() Экспорт
	
	ПолучитьЗаменуИзХранилища(КТКВХранилище);
КонецПроцедуры

&НаСервереБезКОнтекста
Функция ПолучитьВидСобственностиКТК(КТК)
	
	Результат = Перечисления.ВариантыСобственности.Спот;
	
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ
	              |	ПризнакСобственностиКонтейнераСрезПоследних.ПризнакСобственности КАК ПризнакСобственности
	              |ИЗ
	              |	РегистрСведений.ПризнакСобственностиКонтейнера.СрезПоследних(, Контейнер = &КТК) КАК ПризнакСобственностиКонтейнераСрезПоследних";
	Запрос.УстановитьПараметр("КТК", КТК);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		Результат = Ответ.ПризнакСобственности;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПолучитьКТКИзХранилища(КТКВХранилище,ГУИДСтроки)
	
	РезультатПодбора = ПолучитьИзВременногоХранилища(КТКВХранилище);
	
	// если данные вносятся как замена нестоковых КТК на стоковые, то ТекГУИД = Замена.
	// если данные вносятся как новые данные и не замещают имеющиеся данные, то ГУИД будет заполнен.
	// если данные вносятся как новые но при этом не нужно удалять строку-родитель, то ГУИД не заполнен
	Если ГУИДСтроки = "Замена" Тогда
		Для Каждого Строка Из РезультатПодбора Цикл
			ПараметрыОтбора = Новый Структура;
			//НомерКТК,ПунктОтправления,СтанцияОтправления,ПунктНазначения,СтанцияНазначения,ВладелецКТК,ТипКТК
			////////ПараметрыОтбора.Вставить("План",Ложь);
			//ПараметрыОтбора.Вставить("НомерКТК",Строка.НомерКТК);
			//ПараметрыОтбора.Вставить("ПунктОтправления",Строка.ПунктОтправления); // SIV 05-02-20 пока так
			//ПараметрыОтбора.Вставить("ПунктНазначения",Строка.ПунктНазначения); // SIV 05-02-20 пока так
			//ПараметрыОтбора.Вставить("ВладелецКТК",Строка.ВладелецКТК);
			//ПараметрыОтбора.Вставить("ТипКТК",Строка.ТипКТК); // SIV 25-08-20 А ТЕПЕРЬ ТАК!!!!
			ПараметрыОтбора.Вставить("НомерКТК",Справочники.ТЕ.ПустаяСсылка());
			НайденныеСтроки = ЭтаФорма.Объект.СоставУслуги.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество()>0 Тогда
				ЗаполнитьЗначенияСвойств(НайденныеСтроки[0], Строка);
				НайденныеСтроки[0].План = Истина;
				НайденныеСтроки[0].ПринадлежностьТЕ = Перечисления.ПринадлежностьТЕ.КТЕвросиба;
				// ДИТ 65580 Давудов М.А. Начало: 23.02.2023
				//Было:
				//НайденныеСтроки[0].ВидСобственности = ПолучитьВидСобственностиКТК(Строка.НомерКТК);
				//Стало:
				ЗаполнитьСвязанныеПоляПринадлежностьТЕ(НайденныеСтроки[0]);
				// ДИТ 65580 Давудов М.А. Конец: 23.02.2023
				НайденныеСтроки[0].ДатаПостановкиВРезерв = ТекущаяДата();
				НайденныеСтроки[0].СтокВыдачи = Строка.ПунктОтправления;
				
				Если Строка.ПунктНазначения.Тип = Справочники.ТипыЛокаций.Сток Тогда
					НайденныеСтроки[0].СтокСдачиПорожнего = Строка.ПунктНазначения;
				Иначе
					СтокНазначения = Локации_сервер.ВычислитьСтокПодхода(Строка.ПунктНазначения);
					Если ЗначениеЗаполнено(СтокНазначения) Тогда
						НайденныеСтроки[0].СтокСдачиПорожнего = СтокНазначения;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
	Иначе
		// если это плановая строка, то в начале ее ГУИДа стоит буква "П"
		Если СтрНачинаетсяС(ГУИДСтроки,"П") Тогда
			ГУИДСтроки2 = СтрЗаменить(ГУИДСтроки,"П","");
		Иначе
			ГУИДСтроки2 = ГУИДСтроки;
		КонецЕсли;
		// находим родительскую строку
		ТекСтр = ЭтаФорма.Объект.СоставУслуги.НайтиПоИдентификатору(ГУИДСтроки2);
		
		Для Каждого Строка Из РезультатПодбора Цикл
			НовСтр = Объект.СоставУслуги.Добавить();
			// Сначала заполняем каждую строку по родительской, а потом заменяем поля, которые были выбраны в стоке
			ЗаполнитьЗначенияСвойств(НовСтр,ТекСтр);
			ЗаполнитьЗначенияСвойств(НовСтр,Строка,"НомерКТК,ПунктОтправления,СтанцияОтправления,ДатаПриемаВСток,ПунктНазначения,СтанцияНазначения,ВладелецКТК,ТипКТК,ДатаВыдачи,ВремяПрибытияНаТерминал,ИнструкцииПоСдачеПорожнего");
			НовСтр.ПринадлежностьТЕ = Перечисления.ПринадлежностьТЕ.КТЕвросиба;
			// ДИТ 65580 Давудов М.А. Начало: 23.02.2023
			//Было:
			//НовСтр.ВидСобственности = Перечисления.ВариантыСобственности.Спот;
			//Стало:
			ЗаполнитьСвязанныеПоляПринадлежностьТЕ(НовСтр);
			// ДИТ 65580 Давудов М.А. Конец: 23.02.2023
			НовСтр.План = Истина;
			НовСтр.ДатаПостановкиВРезерв = ТекущаяДата();
			ЗначениеРеквизитаОбъекта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НовСтр.ТипКТК, "РазмерКТК");
			Если ЗначениеЗаполнено(ЗначениеРеквизитаОбъекта) Тогда
				НовСтр.РазмерКТК = ЗначениеРеквизитаОбъекта;
			КонецЕсли;
		КонецЦикла;
		// удаляем родительскую строку только если это не плановая строка
		Если НЕ СтрНачинаетсяС(ГУИДСтроки,"П") Тогда
			ЭтаФорма.Объект.СоставУслуги.Удалить(ТекСтр);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПолучитьЗаменуИзХранилища(КТКВХранилище)
	
	РезультатПодбора = ПолучитьИзВременногоХранилища(КТКВХранилище);
	Для Каждого Строка Из РезультатПодбора Цикл
		ПараметрыОтбора = Новый Структура;
		// отбирать по номеру контейнера нужно только в том случае, если заполнено "КонтейнерНаЗамену" ИЛИ "НомерКТК".
		// т.к. в форме замены могут очистить номер контейнера
		Если ЗначениеЗаполнено(Строка.КонтейнерНаЗамену) ИЛИ ЗначениеЗаполнено(Строка.НомерКТК) Тогда
			ПараметрыОтбора.Вставить("НомерКТК",Строка.НомерКТК);
		КонецЕсли;
		ПараметрыОтбора.Вставить("ПунктОтправления",Строка.ПунктОтправления);
		ПараметрыОтбора.Вставить("ПунктНазначения",Строка.ПунктНазначения);
		ПараметрыОтбора.Вставить("ВладелецКТК",Строка.ВладелецКТК);
		ПараметрыОтбора.Вставить("ТипКТК",Строка.ТипКТК);
		НайденныеСтроки = ЭтаФорма.Объект.СоставУслуги.НайтиСтроки(ПараметрыОтбора);
		// если номер контейнера введен впервые, то сделать отбор по таблице без номера ктк
		Если НайденныеСтроки.Количество()=0 Тогда
			ПараметрыОтбора.Удалить("НомерКТК");
			НайденныеСтроки2 = ЭтаФорма.Объект.СоставУслуги.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки2.Количество()>0 Тогда
				НайденныеСтроки2[0].НомерКТК = Строка.НомерКТК;
				//НайденныеСтроки2[0].ДатаВыдачи = Строка.ДатаВзятияИзСтока;
				//НайденныеСтроки2[0].НормативноеИспользованиеИзСтока = Строка.СрокВозврата;
				НайденныеСтроки2[0].ИнструкцииПоСдачеПорожнего = Строка.ИнструкцииПоСдачеПорожнего;
			КонецЕсли;
		Иначе
			Если ЗначениеЗаполнено(Строка.КонтейнерНаЗамену) ИЛИ ЗначениеЗаполнено(Строка.НомерКТК) Тогда
				// если контейнер на замену и номер ктк равны, то значит, ктк удалили, нужно очистить значения
				Если Строка.КонтейнерНаЗамену = Строка.НомерКТК Тогда
					НайденныеСтроки[0].НомерКТК = Справочники.ТЕ.ПустаяСсылка();
					//НайденныеСтроки[0].ДатаВыдачи = "";
					//НайденныеСтроки[0].НормативноеИспользованиеИзСтока = 0;
					//НайденныеСтроки[0].ВладелецКТК = Справочники.Контрагенты.ПустаяСсылка();
					//НайденныеСтроки[0].ДатаВзятия = "";
					//НайденныеСтроки[0].НормативноеИспользование = 0;
				Иначе
					НайденныеСтроки[0].НомерКТК = ?(ЗначениеЗаполнено(Строка.КонтейнерНаЗамену),Строка.КонтейнерНаЗамену,Строка.НомерКТК);
					//НайденныеСтроки[0].ДатаВыдачи = Строка.ДатаВзятияИзСтока;
					//НайденныеСтроки[0].НормативноеИспользованиеИзСтока = Строка.СрокВозврата;
					НайденныеСтроки[0].ИнструкцииПоСдачеПорожнего = Строка.ИнструкцииПоСдачеПорожнего;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПослеПодбораКонтейнера(ВыбЗнач, Параметры) Экспорт
    Если ВыбЗнач<>Неопределено Тогда
        ДобавитьСтрокиСоставУслуги(ВыбЗнач);		
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокиСоставУслуги(ВыбЗнач)
	
	Для Каждого Стр Из ВыбЗнач Цикл
		НовСтр = Объект.СоставУслуги.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,Стр);
		НовСтр.ПринадлежностьТЕ = Перечисления.ПринадлежностьТЕ.КТЕвросиба;
		// ДИТ 65580 Давудов М.А. Начало: 23.02.2023
		ЗаполнитьСвязанныеПоляПринадлежностьТЕ(НовСтр);
		// ДИТ 65580 Давудов М.А. Конец: 23.02.2023
		НовСтр.ГУИДСтроки = Строка(Новый УникальныйИдентификатор());
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаменаНаНомерные(Команда)
	
	ТекД = Элементы.СоставУслуги.ТекущиеДанные;
	Если ТекД = Неопределено Тогда
		Сообщить("Выберите строку, по которой будет осуществляться замена");
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекД.ПунктОтправления) ИЛИ
		НЕ ЗначениеЗаполнено(ТекД.ПунктНазначения) ИЛИ
		НЕ ЗначениеЗаполнено(ТекД.ТипКТК) Тогда
		Сообщить("Для замены контейнеров должны быть заполнены пункт отправления, пункт назначения и тип контейнера");
		Возврат;
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Контрагент",ТекД.ВладелецКТК);
	ПараметрыОтбора.Вставить("Сток",ТекД.ПунктОтправления);
	ПараметрыОтбора.Вставить("Направление",ТекД.ПунктНазначения);
	ПараметрыОтбора.Вставить("ТипКонтейнера",ТекД.ТипКТК);
	
	КТКВХранилище = ПоместитьКТКВХранилище(Неопределено);
	ПараметрыОтбора.Вставить("КТКВХранилище", КТКВХранилище);

	ОткрытьФорму("Документ.СтокКонтейнеров.Форма.ФормаЗаменыВСтоках", ПараметрыОтбора, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

