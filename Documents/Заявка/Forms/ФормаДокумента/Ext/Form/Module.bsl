// ДИТ US 62421 TA 64346 Евсенкин М.А. Начало: 06.02.2023
Процедура ОбновитьДанныеКлючаНаФорме() 
	МассивКлючей = Новый Массив;
	Для Каждого Стр Из Объект.СоставУслуги Цикл
		Если ЗначениеЗаполнено(Стр.КлючАналитикиПеревозки) Тогда 
			мМассив = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Стр.КлючАналитикиПеревозки);
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивКлючей, мМассив, Истина); 
		КонецЕсли;
	КонецЦикла;	
	// ДИТ US 78234 ТА 78241 Сержантова А.С. Начало: 13.12.2023
	// Было:
	//Соответствие = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивКлючей,"Контейнер,Груз,ИнструкцияПоСдаче,Мили"); //ДИТ Шевченко А.В. US 62482 ТА 68277 17.04.2023 
	//Стало:
	// Евросиб(ДИТ) US 85028 ТА 87358 Сержантова А.С. 28.06.2024 + ДетализацияПоГрузу
	Соответствие = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивКлючей,"Контейнер,Груз,КоличествоМест,ВесГруза,ИнструкцияПоСдаче,Мили, ВерсияДанных, ДетализацияПоГрузу"); // + ВерсияДанных ДИТ US 76935 ТА 78649 Сержантова А.С. 27.12.2023
	// ДИТ US 78234 ТА 78241 Сержантова А.С. Конец: 13.12.2023
	Для Каждого Стр Из Объект.СоставУслуги Цикл 
		Структура = Соответствие.Получить(Стр.КлючАналитикиПеревозки);
		Если Структура <> Неопределено Тогда
			//ДИТ Шевченко А.В. US 62421 TA 70104 15.05.2023 +
			Стр.НомерКТК  = Структура.Контейнер; 
			// ДИТ BUG 81219 ТА 81220 Сержантова А.С. Начало: 15.02.2024
			// Было:
			//Стр.ТипКТК 	  = Стр.НомерКТК.ТипТЕ;
			//Стр.РазмерКТК = Стр.ТипКТК.РазмерКТК;  
			//Стало: 
			Если ЗначениеЗаполнено(Стр.НомерКТК) Тогда
				Стр.ТипКТК 	  = Стр.НомерКТК.ТипТЕ;
				Стр.РазмерКТК = Стр.ТипКТК.РазмерКТК;
			КонецЕсли;
			// ДИТ BUG 81219 ТА 81220 Сержантова А.С. Конец: 15.02.2024
			//ДИТ Шевченко А.В. US 62421 TA 70104 15.05.2023 ++
			Стр.Груз = Структура.Груз;    
			// Евросиб(ДИТ) US 85028 ТА 87358 Сержантова А.С. Начало: 28.06.2024
			Стр.КодГруза = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Структура.Груз,"ЕТСНГ"); 
			СтрокиДетализации = ДетализацияПоГрузу.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки", Стр.КлючАналитикиПеревозки));
			Для каждого СтрДетализацииГруза Из СтрокиДетализации Цикл
				ДетализацияПоГрузу.Удалить(СтрДетализацииГруза);	
			КонецЦикла;
			ВыборкаДетализацияНовая = Структура.ДетализацияПоГрузу.Выбрать();
			Пока ВыборкаДетализацияНовая.Следующий() Цикл
				НС = ДетализацияПоГрузу.Добавить();	 
				ЗаполнитьЗначенияСвойств(НС, ВыборкаДетализацияНовая);  
				НС.КлючАналитикиПеревозки = Стр.КлючАналитикиПеревозки;
			КонецЦикла;
			// Евросиб(ДИТ) US 85028 ТА 87358 Сержантова А.С. Конец: 28.06.2024
			Стр.ИнструкцииПоСдачеПорожнего = Структура.ИнструкцияПоСдаче; 
			// ДИТ US 78234 ТА 78241 Сержантова А.С. Начало: 13.12.2023 - оставим для сохранения данных из заявки, если в ключе пусто
			//Если (ЗначениеЗаполнено(Стр.ВесГрузаНетто) и не ЗначениеЗаполнено(Структура.ВесГруза)) 
			//	или (ЗначениеЗаполнено(Стр.КоличествоМест) и не ЗначениеЗаполнено(Структура.КоличествоМест)) Тогда  
			//	СтруктураКлюча = ПолучитьСтруктуруДляЗаписиКлюча();    
			//	СтруктураКлюча.ВесГруза = Стр.ВесГрузаНетто;
			//	ЗаполнитьЗначенияСвойств(СтруктураКлюча,Стр);
			//    НайтиКлючАналитикиПеревозки(СтруктураКлюча);
			//Иначе	
				Стр.ВесГрузаНетто = Структура.ВесГруза;
				Стр.КоличествоМест = Структура.КоличествоМест;
			//КонецЕсли;
			// ДИТ US 78234 ТА 78241 Сержантова А.С. Конец: 13.12.2023 
			// ДИТ US 76935 ТА 78649 Сержантова А.С. Начало: 27.12.2023
			Стр.ВерсияКлюча = Структура.ВерсияДанных;
			// ДИТ US 76935 ТА 78649 Сержантова А.С. Конец: 27.12.2023
			//ДИТ Шевченко А.В. US 62482 ТА 68277 17.04.2023 - начало
			ВыборкаМили = Структура.Мили.Выбрать();
			Пока ВыборкаМили.Следующий() Цикл
				ЗаполнитьСтрокуУслугиПоЭтапуПеревозки(Стр,ВыборкаМили);
			КонецЦикла;	
			//ДИТ Шевченко А.В. US 62482 ТА 68277 17.04.2023 - конец  
			// ДИТ US 76659 ТА 76890 Сержантова А.С. Начало: 31.10.2023
			ЗаполнитьСвязанныеПоляПринадлежностьТЕ(Стр);
			// ДИТ US 76659 ТА 76890 Сержантова А.С. Конец: 31.10.2023
		КонецЕсли;
	КонецЦикла;	
	
	//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -Начало
	ЗаполнитьТаблицуВодителиПеревозчикиПоКлючамАналитики(,Перечисления.ЭтапыПеревозки.ПерваяМиля);
	ЗаполнитьТаблицуВодителиПеревозчикиПоКлючамАналитики(,Перечисления.ЭтапыПеревозки.ПоследняяМиля);
	//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -Конец
	
