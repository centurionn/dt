		НСТР.Пользователь = ПользователиКлиент.ТекущийПользователь();
		// Евросиб(ДИТ) US 88359 ТА 88360 Сержантова А.С. Конец: 25.07.2024
		
		//++#ДИТ Коробов. А.П. Ticket#0259275 от 07.02.2021
