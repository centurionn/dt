	ОперативныеЗадачи.Параметры.УстановитьЗначениеПараметра("ДокументОснование",Объект.Ссылка);
	
	//Евросиб Каблов 12.05.2020 (
	ЗаполнитьВкладкуСИБУР();
	УстановитьВидимостьВкладкиСибур();
