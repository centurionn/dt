&НаСервереБезКонтекста
Функция СтрокиВключенныеВСделки(Заявка, МассивГУИД)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	СделкаСвязьУчетныхЕдиниц.Ссылка КАК Сделка,
	               |	СделкаСвязьУчетныхЕдиниц.ГУИДСтрокиЗаявки КАК ГУИДСтрокиЗаявки
	               |ПОМЕСТИТЬ ВТ
	               |ИЗ
	               |	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	               |ГДЕ
	               |	СделкаСвязьУчетныхЕдиниц.Заявка = &Заявка
	               |	И СделкаСвязьУчетныхЕдиниц.ГУИДСтрокиЗаявки В(&МассивГУИД)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВТ.Сделка КАК Сделка
	               |ИЗ
	               |	ВТ КАК ВТ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВТ.ГУИДСтрокиЗаявки КАК ГУИДСтрокиЗаявки
	               |ИЗ
	               |	ВТ КАК ВТ";
	Запрос.УстановитьПараметр("Заявка", Заявка);
	Запрос.УстановитьПараметр("МассивГУИД", МассивГУИД);
	РезультатЗапросаПакет = Запрос.ВыполнитьПакет();
	МассивСделок = РезультатЗапросаПакет[1].Выгрузить().ВыгрузитьКолонку("Сделка");
	МассивГУИД = РезультатЗапросаПакет[2].Выгрузить().ВыгрузитьКолонку("ГУИДСтрокиЗаявки");
	СтруктураРезультат = Новый Структура;
	СтруктураРезультат.Вставить("ЕстьСтрокиВключенныеВСделки",	МассивСделок.Количество() <> 0);
	СтруктураРезультат.Вставить("Сделки",						МассивСделок);
	СтруктураРезультат.Вставить("ГУИДыСтрокЗаявки",				МассивГУИД);
	
	Возврат СтруктураРезультат;
	
КонецФункции
