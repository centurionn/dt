					//Субботин 77659 20.12.2023 Начало //добавил иначе	
				Иначе
					Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
						НайденнаяСтрока.Релиз = Параметр.Релиз; 
						Если НЕ ЗначениеЗаполнено(НайденнаяСтрока.ИдентификаторСтрокиРелизаКлиента) тогда
							НайденнаяСтрока.ИдентификаторСтрокиРелизаКлиента =  ЗнчМ.ИдентификаторСтроки;
