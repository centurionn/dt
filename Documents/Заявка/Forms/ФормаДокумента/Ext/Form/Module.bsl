			|Провести заявку?", Режим, 0);
		Иначе
			Если Не Отказ Тогда
				ОткрытьФормуНовогоЗаказаНаАвтоперевозку(ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПерваяМиля"));
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
