&НаСервере
Процедура ЗаполнитьСобственностьПриВыбореКонтейнера(ИндексСтроки = Неопределено)
	
	Если ИндексСтроки <> Неопределено Тогда
		КонтейнерыВСтроках = Новый Массив; 
		ДанныеСтроки = Объект.СоставУслуги.НайтиПоИдентификатору(ИндексСтроки);
		КонтейнерыВСтроках.Добавить(ДанныеСтроки.НомерКТК);
	Иначе
		КонтейнерыВСтроках = Объект.СоставУслуги.Выгрузить(,"НомерКТК").ВыгрузитьКолонку("НомерКТК");
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контейнеры", КонтейнерыВСтроках);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЕ.Ссылка КАК КТК
	|ПОМЕСТИТЬ ВТ_Контенеры
	|ИЗ
	|	Справочник.ТЕ КАК ТЕ
	|ГДЕ
	|	ТЕ.Ссылка В(&Контейнеры)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	стоки_ТекущиеДанныеСрезПоследних.тек_ВидСобственности КАК ВидСобственности,
	|	стоки_ТекущиеДанныеСрезПоследних.тек_Собственник КАК Собственник,
	|	ЕСТЬNULL(стоки_ТекущиеДанныеСрезПоследних.тек_ВЭксплуатации, ЛОЖЬ) КАК ВЭксплуатации,
	|	ВТ_Контенеры.КТК КАК КТК
	|ИЗ
	|	ВТ_Контенеры КАК ВТ_Контенеры
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.стоки_ТекущиеДанные.СрезПоследних(, КТК В (&Контейнеры)) КАК стоки_ТекущиеДанныеСрезПоследних
	|		ПО ВТ_Контенеры.КТК = стоки_ТекущиеДанныеСрезПоследних.КТК";
	
	ДанныеПоКТК = Запрос.Выполнить().Выбрать();
	Пока ДанныеПоКТК.Следующий() Цикл
		СтрокиПоКТК = Объект.СоставУслуги.НайтиСтроки(Новый Структура("НомерКТК", ДанныеПоКТК.КТК)); 
		Для каждого СтрокаУслуг Из СтрокиПоКТК Цикл  
			// для строк по релизу клиента оставляем принадлежность "как есть"
			Если ЗначениеЗаполнено(СтрокаУслуг.Релиз) Тогда
			    СтрокаУслуг.ВидСобственности = ДанныеПоКТК.ВидСобственности;
				СтрокаУслуг.ВладелецКТК = ДанныеПоКТК.Собственник;
			Иначе
				Если ДанныеПоКТК.ВЭксплуатации Тогда
					//Если ДанныеПоКТК.ВидСобственности = Перечисления.ПринадлежностьТЕ.КТКлиента Тогда
					//Евросиб(ДИТ), Беляев СЮ, BUG 93345 / TA 96388, 25-11-2024, начало
					Если ДанныеПоКТК.ВидСобственности = Перечисления.ВариантыСобственности.Клиентский Тогда
					//Евросиб(ДИТ), Беляев СЮ, BUG 93345 / TA 96388, 25-11-2024, конец
						СтрокаУслуг.ПринадлежностьТЕ = Перечисления.ПринадлежностьТЕ.КТКлиента;
						// ДИТ 89973 Давудов М.А. Начало: 21.08.2024
						//ок(
						//СтрокаУслуг.СобственностьПеревозимогоКТК = Перечисления.СобственностьПеревозимогоКонтейнера.SOC;
						//ок)
						СтрокаУслуг.УдалитьСобственностьПеревозимогоКТК = Перечисления.УдалитьСобственностьПеревозимогоКонтейнера.SOC;
						// ДИТ 89973 Давудов М.А. Конец: 21.08.2024
						СтрокаУслуг.ВидСобственности = Перечисления.ВариантыСобственности.Клиентский;
						СтрокаУслуг.ВладелецКТК = Объект.Контрагент;
					Иначе
						СтрокаУслуг.ПринадлежностьТЕ = Перечисления.ПринадлежностьТЕ.КТЕвросиба;
						// ДИТ 89973 Давудов М.А. Начало: 21.08.2024
						//ок(
						//СтрокаУслуг.СобственностьПеревозимогоКТК = Перечисления.СобственностьПеревозимогоКонтейнера.COC; 
						//ок)
						СтрокаУслуг.УдалитьСобственностьПеревозимогоКТК = Перечисления.УдалитьСобственностьПеревозимогоКонтейнера.COC;
						// ДИТ 89973 Давудов М.А. Конец: 21.08.2024
						СтрокаУслуг.ВидСобственности = ДанныеПоКТК.ВидСобственности;
						СтрокаУслуг.ВладелецКТК = ДанныеПоКТК.Собственник;
					КонецЕсли;
				Иначе  
					// ДИТ 89973 Давудов М.А. Начало: 21.08.2024
					//ок(
					//СтрокаУслуг.СобственностьПеревозимогоКТК = Перечисления.СобственностьПеревозимогоКонтейнера.ПустаяСсылка();
					//ок)
					СтрокаУслуг.УдалитьСобственностьПеревозимогоКТК = Перечисления.УдалитьСобственностьПеревозимогоКонтейнера.ПустаяСсылка();
					// ДИТ 89973 Давудов М.А. Конец: 21.08.2024
					СтрокаУслуг.ПринадлежностьТЕ = Перечисления.ПринадлежностьТЕ.ПустаяСсылка();
					СтрокаУслуг.ВидСобственности = Перечисления.ВариантыСобственности.ПустаяСсылка();
					СтрокаУслуг.ВладелецКТК = Справочники.Контрагенты.ПустаяСсылка();
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

