Процедура ЗаполнитьТаблицуВодителиПеревозчикиПоКлючамАналитики(Ключ = Неопределено,ЭтапПеревозки = Неопределено)
	Если Ключ <> Неопределено Тогда
		ОтборС = Новый Структура("КлючАналитикиПеревозки",Ключ);
	Иначе
		ОтборС = Неопределено;
	КонецЕсли;
	Если ЭтапПеревозки = Перечисления.ЭтапыПеревозки.ПерваяМиля Тогда
		
		МассивКлючей = Объект.ТранспортныеСредства.Выгрузить(ОтборС,"КлючАналитикиПеревозки").ВыгрузитьКолонку("КлючАналитикиПеревозки");	
		ТзМили = Справочники.КлючиАналитикиПеревозки.КлючиАналитикиЗначенияПолейПоЭтапуПеревозки(МассивКлючей,Перечисления.ЭтапыПеревозки.ПерваяМиля);
		Если Ключ <> Неопределено Тогда
			МСтроки = Объект.ТранспортныеСредства.НайтиСтроки(ОтборС);
		Иначе
			МСтроки = Объект.ТранспортныеСредства;
		КонецЕсли;
		Для Каждого МСтрока Из МСтроки Цикл
			СтруктураОтбора = новый Структура("КлючАналитикиПеревозки",МСтрока.КлючАналитикиПеревозки);
			ТЗМилиСтрока = ТЗМили.НайтиСтроки(СтруктураОтбора);
			Если ТЗМилиСтрока.Количество() Тогда
				ЗаполнитьЗначенияСвойств(МСтрока,ТЗМилиСтрока[0]);
			КонецЕсли;
		КонецЦикла;
	Иначе
		МассивКлючей = Объект.ТранспортныеСредстваПоследняяМиля.Выгрузить(ОтборС,"КлючАналитикиПеревозки").ВыгрузитьКолонку("КлючАналитикиПеревозки");
		ТзМили = Справочники.КлючиАналитикиПеревозки.КлючиАналитикиЗначенияПолейПоЭтапуПеревозки(МассивКлючей,Перечисления.ЭтапыПеревозки.ПоследняяМиля);
		Если Ключ <> Неопределено Тогда
			МСтроки = Объект.ТранспортныеСредстваПоследняяМиля.НайтиСтроки(ОтборС);
		Иначе
			МСтроки = Объект.ТранспортныеСредстваПоследняяМиля;
		КонецЕсли;
		Для Каждого МСтрока Из МСтроки Цикл
			СтруктураОтбора = новый Структура("КлючАналитикиПеревозки",МСтрока.КлючАналитикиПеревозки);
			ТЗМилиСтрока = ТЗМили.НайтиСтроки(СтруктураОтбора);
			Если ТЗМилиСтрока.Количество() Тогда
				ЗаполнитьЗначенияСвойств(МСтрока,ТЗМилиСтрока[0]);
				// ДИТ BUG 79844 ТА 79845 Сержантова А.С. Начало: 22.01.2024 
				МСтрока.Контейнер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(МСтрока.КлючАналитикиПеревозки, "Контейнер");
				// ДИТ BUG 79844 ТА 79845 Сержантова А.С. Конец: 22.01.2024
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры
