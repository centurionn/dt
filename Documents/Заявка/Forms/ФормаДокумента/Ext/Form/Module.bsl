//Евросиб Коханенко Н.А. 11.02.2025 (( #78722 
&НаСервере
Функция ПолучитьОфисПродаж(ГруппаДКС, Контрагент, Калькуляция, КТК, ТипКТК)
	
	//пп.10 ФТ: значение доп.аналитики Контрагента имеет приоритетное значение
	ОфисПродажКонтрагента = РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ПолучитьАналитикуДокумента(Контрагент,
		ПланыВидовХарактеристик.ДополнительныеАналитикиДокументов.ОфисПродаж);
	Если ЗначениеЗаполнено(ОфисПродажКонтрагента) Тогда
		Возврат ОфисПродажКонтрагента;	
	КонецЕсли;
	
	//пп.14
	Если ЗначениеЗаполнено(ТипКТК)
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТипКТК, "Рефрижераторный") Тогда
		Возврат ПредопределенноеЗначение("Справочник.ОфисыПродаж.Рефы"); 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Калькуляция) Тогда
		ДанныеКалькуляции = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Калькуляция, "ТипКалькуляции, ОтнестиРасходыНаСобственныеЗатраты, ОтнестиРасходыНаСебестоимостьКлиента");
		
		ПроверяемыеТипыКалькуляций = Новый СписокЗначений;
		ТипМежсервисныеРасходы = ПредопределенноеЗначение("Перечисление.ТипыКалькуляций.МежсервисныеРасходы");
		ТипМежсервисныеРасходыРеф = ПредопределенноеЗначение("Перечисление.ТипыКалькуляций.МежсервисныеРасходыРеф");
		ПроверяемыеТипыКалькуляций.Добавить(ТипМежсервисныеРасходы);
		ПроверяемыеТипыКалькуляций.Добавить(ТипМежсервисныеРасходыРеф);
		ОфисПродажРасходыДКП = ПредопределенноеЗначение("Справочник.ОфисыПродаж.РасходыДКП"); 
		Если ПроверяемыеТипыКалькуляций.НайтиПоЗначению(ДанныеКалькуляции.ТипКалькуляции) <> Неопределено Тогда
			//пп.11 ФТ: если тип калькуляции Межсервисные расходы, и признак НаСобственныеЗатраты, то Офис продаж - РасходыДКП
			Если ДанныеКалькуляции.ОтнестиРасходыНаСобственныеЗатраты Тогда
				Возврат ОфисПродажРасходыДКП;
			КонецЕсли;
			//пп.11 ФТ: если же признак НаСебестоимостьКлиента, то или как в аналогичной заявке, или РасходыДКП
			Если ДанныеКалькуляции.ОтнестиРасходыНаСебестоимостьКлиента Тогда
				ОфисПродажВАналогичнойЗаявке = ИщемОфисПродажДляКТКВСвязаннойЧерезСделкуЗаявкеПоСовпадениюКТК(Объект.Ссылка, КТК);
				Если ЗначениеЗаполнено(ОфисПродажВАналогичнойЗаявке) Тогда
					Возврат ОфисПродажВАналогичнойЗаявке;
				Иначе
					Возврат ОфисПродажРасходыДКП;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		//пп.9 ФТ: если калькуляция из уканных типов, то ищем вторую заявку в сделке с этим КТК, и по ней определяем Офис Продаж
		ПроверяемыеТипыКалькуляций.Очистить();
		ТипДоплатныеКТК = ПредопределенноеЗначение("Перечисление.ТипыКалькуляций.Доплатные");
		ТипСубсидии = ПредопределенноеЗначение("Перечисление.ТипыКалькуляций.Субсидии");
		//ДИТ Шевченко А.В. US 103646 TA 103658 10.03.2025
		ТипПремии = ПредопределенноеЗначение("Перечисление.ТипыКалькуляций.Премии");
		//ДИТ Шевченко А.В. US 103646 TA 103658 10.03.2025
		ПроверяемыеТипыКалькуляций.Добавить(ТипДоплатныеКТК);
		ПроверяемыеТипыКалькуляций.Добавить(ТипСубсидии);
		ПроверяемыеТипыКалькуляций.Добавить(ТипПремии); //ДИТ Шевченко А.В. US 103646 TA 103658 10.03.2025 
		
		Если ПроверяемыеТипыКалькуляций.НайтиПоЗначению(ДанныеКалькуляции.ТипКалькуляции) <> Неопределено Тогда
			ОфисПродажВАналогичнойЗаявке = ИщемОфисПродажДляКТКВСвязаннойЧерезСделкуЗаявкеПоСовпадениюКТК(Объект.Ссылка, КТК);
			Если ЗначениеЗаполнено(ОфисПродажВАналогичнойЗаявке) Тогда
				Возврат ОфисПродажВАналогичнойЗаявке;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Результат = Неопределено; 

	СоответсвиеГруппаДКСОфисПродаж = Новый Соответствие;
	ОфисЦентральный = ПредопределенноеЗначение("Справочник.ОфисыПродаж.Центральный");
	//Евросиб Коханенко Н.А. 28.08.2025 (( #117237 
	//СоответсвиеГруппаДКСОфисПродаж.Вставить(ПредопределенноеЗначение("Справочник.ГруппыДКС.ММ"), ОфисЦентральный);
	//Евросиб Коханенко Н.А. 28.08.2025 )) #117237 
	СоответсвиеГруппаДКСОфисПродаж.Вставить(ПредопределенноеЗначение("Справочник.ГруппыДКС.ВРП"), ОфисЦентральный);
	СоответсвиеГруппаДКСОфисПродаж.Вставить(ПредопределенноеЗначение("Справочник.ГруппыДКС.Сухопут"), ОфисЦентральный);
	СоответсвиеГруппаДКСОфисПродаж.Вставить(ПредопределенноеЗначение("Справочник.ГруппыДКС.Море"), ОфисЦентральный);
	СоответсвиеГруппаДКСОфисПродаж.Вставить(ПредопределенноеЗначение("Справочник.ГруппыДКС.ДМС"), ОфисЦентральный);
	СоответсвиеГруппаДКСОфисПродаж.Вставить(ПредопределенноеЗначение("Справочник.ГруппыДКС.ВЭД"), ОфисЦентральный);
	СоответсвиеГруппаДКСОфисПродаж.Вставить(ПредопределенноеЗначение("Справочник.ГруппыДКС.Аренда"), ОфисЦентральный);
	
	ОфисДальнийВосток = ПредопределенноеЗначение("Справочник.ОфисыПродаж.ДальнийВосток");
	СоответсвиеГруппаДКСОфисПродаж.Вставить(ПредопределенноеЗначение("Справочник.ГруппыДКС.ДВ"), ОфисДальнийВосток);
	//Евросиб Коханенко Н.А. 28.08.2025 (( #117237 
	СоответсвиеГруппаДКСОфисПродаж.Вставить(ПредопределенноеЗначение("Справочник.ГруппыДКС.ММ"), ОфисДальнийВосток);
	//Евросиб Коханенко Н.А. 28.08.2025 )) #117237 
	
	ОфисНовосибирск = ПредопределенноеЗначение("Справочник.ОфисыПродаж.Новосибирск");
	СоответсвиеГруппаДКСОфисПродаж.Вставить(ПредопределенноеЗначение("Справочник.ГруппыДКС.НСК"), ОфисНовосибирск);
	
	ОфисРефы = ПредопределенноеЗначение("Справочник.ОфисыПродаж.Рефы");
	СоответсвиеГруппаДКСОфисПродаж.Вставить(ПредопределенноеЗначение("Справочник.ГруппыДКС.Рефы"), ОфисРефы);
	
	ОфисКазахстан = ПредопределенноеЗначение("Справочник.ОфисыПродаж.Казахстан");
	СоответсвиеГруппаДКСОфисПродаж.Вставить(ПредопределенноеЗначение("Справочник.ГруппыДКС.ЕКЗХ"), ОфисКазахстан);
	
	Результат = СоответсвиеГруппаДКСОфисПродаж.Получить(ГруппаДКС);
	
	Возврат Результат; 
	
КонецФункции //Евросиб Коханенко Н.А. 11.02.2025 )) #78722

