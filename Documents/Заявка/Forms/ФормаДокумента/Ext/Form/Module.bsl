&НаКлиенте
Процедура ОбработкаДобавленияНомерныхПозиций(ДанныеДляЗагрузки = неопределено, ДополнительныеПараметры = неопределено) Экспорт  
	
	// ДИТ US 76619 ТА 76735 Сержантова А.С. Начало: 20.11.2023
	Если ДанныеДляЗагрузки = Неопределено или ДанныеДляЗагрузки.СтруктураКТК.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;   
	// ДИТ US 76619 ТА 76735 Сержантова А.С. Конец: 20.11.2023
	
	Если ДанныеДляЗагрузки = Неопределено тогда возврат; КонецЕсли;
	
	//Если ДанныеДляЗагрузки.Поведение = 1 Тогда Объект.СоставУслуги.Очистить(); КонецЕсли;
	//ДИТ, Беляев СЮ, BUG 80907/ TA 80909, 09-02-2024, начало
	Если ДанныеДляЗагрузки.Поведение = 1 Тогда
		УдалитьСтрокиНеВключенныеВСделку();
	КонецЕсли;
	//ДИТ, Беляев СЮ, BUG 80907/ TA 80909, 09-02-2024, конец
	
	Если ДанныеДляЗагрузки.Поведение = 3 Тогда 
		
		СвязатьКТКСоСтоками(, Ложь);
		
		Для каждого Стр из ДанныеДляЗагрузки.СтруктураКТК Цикл
			
			НСтр = Объект.СоставУслуги.Добавить();
			СписокПереносимыхПолей = Новый массив;
			Для каждого Стр22 из Стр Цикл
				Если ЗначениеЗаполнено(Стр22.Значение) И Стр22.Ключ <> "НомерРелиза" Тогда
					СписокПереносимыхПолей.Добавить(Стр22.Ключ);
				КонецЕсли;
			КонецЦикла;
			ЗаполнитьЗначенияСвойств(НСтр, Стр, СтрСоединить(СписокПереносимыхПолей, ","));
			НСтр.Услуга = УслугаПоУмолчанию;
			НСтр.Калькуляция = КалькуляцияПоУмолчанию;
			НСтр.ГУИДСтроки = Строка(Новый УникальныйИдентификатор());
			//НСтр.ДатаПостановкиВРезерв = НСтр.ДатаВзятия-1;
			//НСтр.ДатаПриемаВПользованиеПередПоставщиком = НСтр.ДатаВыдачи;
			
			// ДИТ US 62421 TA 64346 Евсенкин М.А. Начало: 03.02.2023
			НайтиКлючАналитикиПеревозкиКлиент(НСтр);
			// ДИТ US 62421 TA 64346 Евсенкин М.А. Конец: 03.02.2023
			
			// ДИТ US 76659 ТА 77825 Сержантова А.С. Начало: 26.02.2024
			ЗаполнитьСобственностьПриВыбореКонтейнера(НСтр.ПолучитьИдентификатор());
			// ДИТ US 76659 ТА 77825 Сержантова А.С. Конец: 26.02.2024
		КонецЦикла;
		
		ВидимостьКолонокПринадлежности();
		
		Возврат;
	// ДИТ US 76619 ТА 76735 Сержантова А.С. Начало: 07.11.2023
	// Заполнение пустых строк введеными номерами КТК
	ИначеЕсли ДанныеДляЗагрузки.Поведение = 4 Тогда  
	
		//Сначала посчитаем сколько строк нужно заполнить, если нет выделенных строк или всего одна выделенная   
		МассивИдентификаторов = Новый Массив;  
		КоличествоВыделенныхСтрок = Элементы.СоставУслуги.ВыделенныеСтроки.Количество();  
		КоличествоВставляемыхКТК = ДанныеДляЗагрузки.СтруктураКТК.Количество();
		Если КоличествоВыделенныхСтрок <= 1 Тогда
			НачальныйНомерЗаполнения = 0;	
			Если КоличествоВыделенныхСтрок = 1 Тогда
				НачальныйНомерЗаполнения = Элементы.СоставУслуги.ВыделенныеСтроки[0];
			КонецЕсли;  
			Пока НачальныйНомерЗаполнения <= (Объект.СоставУслуги.Количество() - 1) Цикл  
				МассивИдентификаторов.Добавить(НачальныйНомерЗаполнения);
				НачальныйНомерЗаполнения = НачальныйНомерЗаполнения + 1;	
			КонецЦикла;
		КонецЕсли;
		КоличествоСтрокЕслиНеВыделены = МассивИдентификаторов.Количество();    
		СтрокиКЗаполнению = ?(МассивИдентификаторов.Количество() = 0, Элементы.СоставУслуги.ВыделенныеСтроки, МассивИдентификаторов);
		
		//Если ввели больше строк КТК, чем выделено или чем есть в документе, то предупреждаем, что перенесем не все 
		Если (КоличествоВыделенныхСтрок > 1 
			и КоличествоВыделенныхСтрок < КоличествоВставляемыхКТК)
			или (КоличествоСтрокЕслиНеВыделены > 0 и КоличествоСтрокЕслиНеВыделены < КоличествоВставляемыхКТК) Тогда
			НеПеренесемКоличество = ?(КоличествоСтрокЕслиНеВыделены = 0,
									КоличествоВставляемыхКТК - КоличествоВыделенныхСтрок,
									КоличествоВставляемыхКТК - КоличествоСтрокЕслиНеВыделены);  
			ПараметрыПереноса = Новый Структура("СтрокиКЗаполнению, ДанныеБуфера"); 
			ПараметрыПереноса.СтрокиКЗаполнению = СтрокиКЗаполнению;
			ПараметрыПереноса.ДанныеБуфера = ДанныеДляЗагрузки.СтруктураКТК;
			ОповещениеПослеВопроса = Новый ОписаниеОповещения("ПослеВопросаОПереносе_ЗаполнениеПустыхСтрокКТК", ЭтаФорма, ПараметрыПереноса); 	
			ТекстВопроса = СтрШаблон("Количество выделенных в документе строк для вставки меньше количества добавленных из буфера обмена контейнеров, 
			| %1 последних по списку контейнеров не будут перенесены в табличную часть документа.", НеПеренесемКоличество); 
			ПоказатьВопрос(ОповещениеПослеВопроса, ТекстВопроса,РежимДиалогаВопрос.ОКОтмена);  
			Возврат;
		КонецЕсли;
		
		ЗаполнитьПустыеСтрокиНомерамиКТКИзБуфера(СтрокиКЗаполнению, ДанныеДляЗагрузки.СтруктураКТК);
		
		ОбновитьСВВиТДТ_Клиент();
		Возврат;
