&НаКлиенте
Процедура ТранспортныеСредстваПриИзменении(Элемент)
	//ДИТ Шевченко А.В. 58552 05.10.2022 -начало
	ТекД = Элементы.ТранспортныеСредства.ТекущиеДанные; 
	
	//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -Начало
	Если ТекД = Неопределено ИЛИ ТекД.КлючАналитикиПеревозки = ПредопределенноеЗначение("Справочник.КлючиАналитикиПеревозки.ПустаяСсылка") Тогда
		Возврат;
	КонецЕсли;	
	СтруктураДляКлюча = Новый Структура("ФИОВодителя,РегНомерТС,ПаспортныеДанные,Автоперевозчик,ИНН,КПП,КлючАналитикиПеревозки");
	ЗаполнитьЗначенияСвойств(СтруктураДляКлюча,ТекД);   
	// ДИТ BUG 79844 ТА 79845 Сержантова А.С. Начало: 18.01.2024
	Если ЗначениеЗаполнено(ТекД.Автоперевозчик) и ТипЗнч(ТекД.Автоперевозчик) = Тип("СправочникСсылка.Контрагенты") Тогда   
		ЗначенияРекв = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(ТекД.Автоперевозчик, "ИНН, КПП");
		ТекД.ИНН = ЗначенияРекв.ИНН; 
		ТекД.КПП = ЗначенияРекв.КПП; 
	Иначе
		Элементы.ТранспортныеСредстваИНН.Доступность = Истина;
		Элементы.ТранспортныеСредстваКПП.Доступность = Истина;
	КонецЕсли;
	// ДИТ BUG 79844 ТА 79845 Сержантова А.С. Конец: 18.01.2024
	// ДИТ US 76935 ТА 78649 Сержантова А.С. Начало: 27.12.2023
	//ДобавитьЗначениеРеквизитаВКлючПоВодителяАвтоперевозчикам(СтруктураДляКлюча,ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПерваяМиля"),ТекД.ВерсияКлюча);
	// ДИТ US 76935 ТА 78649 Сержантова А.С. Конец: 27.12.2023
	//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -Конец
	
	Если ЗаполнятьВниз Тогда
		ИмяТЧ = Элемент.Имя;
		ИмяПоля = Сред(Элемент.ТекущийЭлемент.Имя, СтрДлина(ИмяТЧ)+1);
		
		НовоеЗначение = ТекД[ИмяПоля];
		
		// ДИТ US 78243 ТА 80825 Сержантова А.С. Начало: 19.02.2024
		Если ИмяПоля = "Автоперевозчик" Тогда     
			Если ТипЗнч(НовоеЗначение) = Тип("СправочникСсылка.Контрагенты") и ЗначениеЗаполнено(НовоеЗначение) Тогда
				РеквизитыАвтоперевозчика = ОбщегоНазначенияВызовСервера.ЗначенияРеквизитовОбъекта(НовоеЗначение, "ИНН, КПП", Ложь);
			Иначе
				РеквизитыАвтоперевозчика = Новый Структура("ИНН, КПП", "", "");
			КонецЕсли;
		КонецЕсли;
		// ДИТ US 78243 ТА 80825 Сержантова А.С. Конец: 19.02.2024
		
		СтрокаПройдена = Ложь;		
		Для Сч = 0 По Объект[ИмяТЧ].Количество() - 1 Цикл
			РезПроверки = Элементы.ТранспортныеСредства.ПроверитьСтроку(Объект[ИмяТЧ][Сч].ПолучитьИдентификатор());
			
			СтрокаПройдена = СтрокаПройдена ИЛИ Элементы.ТранспортныеСредства.ТекущаяСтрока = Объект[ИмяТЧ][Сч].ПолучитьИдентификатор();
			
			Если РезПроверки = Истина И СтрокаПройдена = Истина Тогда
				
				Объект[ИмяТЧ][Сч][ИмяПоля] = НовоеЗначение; 
				
				// ДИТ US 78243 ТА 80825 Сержантова А.С. Начало: 19.02.2024
				Если ИмяПоля = "Автоперевозчик" Тогда
					Объект[ИмяТЧ][Сч]["ИНН"] = РеквизитыАвтоперевозчика.ИНН;
					Объект[ИмяТЧ][Сч]["КПП"] = РеквизитыАвтоперевозчика.КПП;
				КонецЕсли;
				// ДИТ US 78243 ТА 80825 Сержантова А.С. Конец: 19.02.2024
				
			КонецЕсли; 
			
		КонецЦикла;
		
	КонецЕсли;
	//ДИТ Шевченко А.В. 58552 05.10.2022 -конец     
	
	// ДИТ BUG 79844 ТА 79845 Сержантова А.С. Начало: 24.01.2024
	ЗаполнитьТранспортныеСредстваВУслугах(ТекД, ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПерваяМиля"));
	// ДИТ BUG 79844 ТА 79845 Сержантова А.С. Конец: 24.01.2024
КонецПроцедуры       

// ДИТ BUG 79844 ТА 79845 Сержантова А.С. 24.01.2024
&НаКлиенте
Процедура ЗаполнитьТранспортныеСредстваВУслугах(ТекущиеДанные, ЭтапПеревозки)

	СтрокиВУслугах = Объект.СоставУслуги.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки", ТекущиеДанные.КлючАналитикиПеревозки));	
	Если СтрокиВУслугах.Количество() > 0 Тогда
		Если ЭтапПеревозки = ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПерваяМиля") Тогда
			СтрокиВУслугах[0].ФИОВодителя = ТекущиеДанные.ФИОВодителя;
			СтрокиВУслугах[0].НомерАвто = ТекущиеДанные.РегНомерТС;
			СтрокиВУслугах[0].АвтоперевозчикПерваяМиля = ТекущиеДанные.Автоперевозчик;
		//Евросиб Коханенко Н.А. 23.01.2025 (( #91409 
		//Иначе
		ИначеЕсли ЭтапПеревозки = ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПоследняяМиля") Тогда
		//Евросиб Коханенко Н.А. 23.01.2025 )) #91409 
			СтрокиВУслугах[0].НомерКТК = ТекущиеДанные.Контейнер;
			СтрокиВУслугах[0].ФИОВодителяВыгрузка = ТекущиеДанные.ФИОВодителя;
			СтрокиВУслугах[0].НомерАвтоВыгрузка = ТекущиеДанные.РегНомерТС;
			СтрокиВУслугах[0].АвтоПеревозчик = ТекущиеДанные.Автоперевозчик;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

