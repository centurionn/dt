&НаСервереБезКонтекста
Функция СоздатьКлючАналитики(Заявка) //ДИТ Шевченко А.В. US 62421 TA 64347 24.01.23
	
	СтруктураКлюча  = Справочники.КлючиАналитикиПеревозки.СтруктураКлючаАналитикиПеревозки(); 
	СтруктураКлюча.Вставить("Заявка",Заявка);
	Возврат Справочники.КлючиАналитикиПеревозки.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлюча);
		
