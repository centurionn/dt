&НаКлиенте
Процедура ВыполнитьПроверкиСибур() //ДИТ Шевченко А.В. 57147 28.12.2022
	
	СтруктураОшибокУслуги = ОбработатьТЧУслугиПроверкаСибур();
	
	ЕстьОшибки = Ложь;
	
	Если СтруктураОшибокУслуги.НеЗаполненНомерКТКНомераСтрок.Количество() > 0 Тогда
		ТекстСообщения = "В строке %1 вкладки «Услуги» не заполнен номер КТК";
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(ТекстСообщения,СтрСоединить(СтруктураОшибокУслуги.НеЗаполненНомерКТКНомераСтрок,",")),,,,ЕстьОшибки);
	КонецЕсли;
	
	Если СтруктураОшибокУслуги.НеЗаполненВладелецКТКНомераСтрок.Количество() > 0 Тогда
		ТекстСообщения = "В строке %1 вкладки «Услуги» не заполнен владелец КТК";
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(ТекстСообщения,СтрСоединить(СтруктураОшибокУслуги.НеЗаполненВладелецКТКНомераСтрок,",")),,,,ЕстьОшибки);
	КонецЕсли;
	
	Если СтруктураОшибокУслуги.НерезидентыБезВнешнегоКода.Количество() > 0 Тогда
		ТекстСообщения = "Необходимо в Бит Финансе для нерезидента %1 заполнить «Внешний код нерезидента»";
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(ТекстСообщения,СтрСоединить(СтруктураОшибокУслуги.НерезидентыБезВнешнегоКода,",")),,,,ЕстьОшибки);
	КонецЕсли;
	
	Если СтруктураОшибокУслуги.РезидентыБезКодаПоОКПО.Количество() > 0 Тогда
		ТекстСообщения = "Необходимо в Бит Финансе для резидента %1 заполнить «Код по ОКПО»";
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(ТекстСообщения,СтрСоединить(СтруктураОшибокУслуги.РезидентыБезКодаПоОКПО,",")),,,,ЕстьОшибки);
	КонецЕсли;
	
	// ДИТ US 60810 TA 66664 Евсенкин М.А. Начало: 22.03.2023
	Если СтруктураОшибокУслуги.НеЗаполненКодКонтрагентаСибур.Количество() Тогда 
		ТекстСообщения = "Необходимо для контрагентов %1 заполнить «КодКонтрагентаСибур»";
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(ТекстСообщения,СтрСоединить(СтруктураОшибокУслуги.НеЗаполненКодКонтрагентаСибур,",")),,,,ЕстьОшибки);
	КонецЕсли;	
	// ДИТ US 60810 TA 66664 Евсенкин М.А. Конец: 22.03.2023
	
	СтруктураОшибокДислокацииКонтейнеров = ПолучитьВагоныПоДислокацииКонтейнеров(Объект.СоставУслуги);
	
	Если СтруктураОшибокДислокацииКонтейнеров.МассивКТКБезВагонов.Количество() > 0 Тогда
		ТекстСообщения = "Для КТК %1 не найдены номера вагонов по Дислокации контейнеров.  Необходимо проверить правильность заполнения номеров КТК в заявке и обратиться в ТП для проверки Дислокации контейнеров";
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(ТекстСообщения,СтрСоединить(СтруктураОшибокДислокацииКонтейнеров.МассивКТКБезВагонов,",")),,,,ЕстьОшибки);
	КонецЕсли;
	
	Если СтруктураОшибокДислокацииКонтейнеров.МассивВыгоновБезСобственника.Количество() > 0 Тогда
		ТекстСообщения = "Необходимо в ИРС заполнить собственника вагона для вагонов %1";
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(ТекстСообщения,СтрСоединить(СтруктураОшибокДислокацииКонтейнеров.МассивВыгоновБезСобственника,",")),,,,ЕстьОшибки);
	КонецЕсли;
	
	Если СтруктураОшибокДислокацииКонтейнеров.МассивСобственниковБезОКПО.Количество() > 0 Тогда
		ТекстСообщения = "В ИРС необходимо заполнить ОКПО собственников вагонов %1 в справочнике «Собственники/Арендаторы вагонов».";
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(ТекстСообщения,СтрСоединить(СтруктураОшибокДислокацииКонтейнеров.МассивСобственниковБезОКПО,",")),,,,ЕстьОшибки);
	КонецЕсли;
	
	Если НЕ ЕстьОшибки Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Все обязательные реквизиты в заявке заполнены");
	КонецЕсли;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВагоныПоДислокацииКонтейнеров(Знач СоставУслуги) //ДИТ Шевченко А.В. 57147 28.12.2022

	СписокКонтейнеров 			 = СоставУслуги.Выгрузить(,"НомерКТК");
	ТЗ 				  			 = СоставУслуги.Выгрузить(,"НомерКТК,СтанцияНазначения,СтанцияОтправления");
	МассивКТКБезВагонов 		 = Новый Массив;
	МассивВыгоновБезСобственника = Новый Массив;
	МассивСобственниковБезОКПО 	 = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЗ.НомерКТК КАК НомерКТК,
		|	ТЗ.СтанцияНазначения КАК СтанцияНазначения,
		|	ТЗ.СтанцияОтправления КАК СтанцияОтправления
		|ПОМЕСТИТЬ ВТ_ТЧУслуги
		|ИЗ
		|	&ТЗ КАК ТЗ
		|ГДЕ
		|	ТЗ.НомерКТК <> ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТЧУслуги.НомерКТК КАК НомерКТК,
		|	АналогиСтанцииПогрузкиКонтейнера.Аналог КАК АналогиСтанцииПогрузкиКонтейнера
		|ПОМЕСТИТЬ ВТ_ТЧУслугиИАналогиСтанцийПогрузки
		|ИЗ
		|	ВТ_ТЧУслуги КАК ВТ_ТЧУслуги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналогиЛокаций КАК АналогиСтанцииПогрузкиКонтейнера
		|		ПО ВТ_ТЧУслуги.СтанцияОтправления = АналогиСтанцииПогрузкиКонтейнера.Локация
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ВТ_ТЧУслуги.НомерКТК,
		|	ВТ_ТЧУслуги.СтанцияОтправления
		|ИЗ
		|	ВТ_ТЧУслуги КАК ВТ_ТЧУслуги
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТЧУслуги.НомерКТК КАК НомерКТК,
		|	АналогиСтанцииНазначения.Аналог КАК АналогиСтанцииНазначения
		|ПОМЕСТИТЬ ВТ_ТЧУслугиИАналогиСтанцийНазначения
		|ИЗ
		|	ВТ_ТЧУслуги КАК ВТ_ТЧУслуги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналогиЛокаций КАК АналогиСтанцииНазначения
		|		ПО ВТ_ТЧУслуги.СтанцияНазначения = АналогиСтанцииНазначения.Локация
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ВТ_ТЧУслуги.НомерКТК,
		|	ВТ_ТЧУслуги.СтанцияНазначения
		|ИЗ
		|	ВТ_ТЧУслуги КАК ВТ_ТЧУслуги
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТЧУслугиИАналогиСтанцийПогрузки.НомерКТК КАК НомерКТК,
		|	ВТ_ТЧУслугиИАналогиСтанцийПогрузки.АналогиСтанцииПогрузкиКонтейнера КАК АналогиСтанцииПогрузкиКонтейнера,
		|	ВТ_ТЧУслугиИАналогиСтанцийНазначения.АналогиСтанцииНазначения КАК АналогиСтанцииНазначения
		|ПОМЕСТИТЬ ВТ_УслугиИтог
		|ИЗ
		|	ВТ_ТЧУслугиИАналогиСтанцийПогрузки КАК ВТ_ТЧУслугиИАналогиСтанцийПогрузки
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТЧУслугиИАналогиСтанцийНазначения КАК ВТ_ТЧУслугиИАналогиСтанцийНазначения
		|		ПО ВТ_ТЧУслугиИАналогиСтанцийПогрузки.НомерКТК = ВТ_ТЧУслугиИАналогиСтанцийНазначения.НомерКТК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДислокацияКонтейнеровСрезПоследних.Контейнер КАК Контейнер,
		|	ДислокацияКонтейнеровСрезПоследних.СтанцияПогрузкиКонтейнера КАК СтанцияПогрузкиКонтейнера,
		|	ДислокацияКонтейнеровСрезПоследних.СтанцияНазначения КАК СтанцияНазначения,
		|	ДислокацияКонтейнеровСрезПоследних.Вагон КАК Вагон
		|ПОМЕСТИТЬ ВТ_СрезДислокацииКонтейнеров
		|ИЗ
		|	РегистрСведений.ДислокацияКонтейнеров.СрезПоследних(
		|			&Период,
		|			Контейнер В (&СписокКонтейнеров)
		|				И НЕ Вагон = ЗНАЧЕНИЕ(Справочник.ТС.ПустаяСсылка)) КАК ДислокацияКонтейнеровСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СрезДислокацииКонтейнеров.Контейнер КАК Контейнер,
		|	АналогиСтанцииПогрузкиКонтейнера.Аналог КАК СтанцияПогрузкиКонтейнера,
		|	ВТ_СрезДислокацииКонтейнеров.Вагон КАК Вагон
		|ПОМЕСТИТЬ ВТ_СрезДислокацииКонтейнеровСтанцииПогрузки
		|ИЗ
		|	ВТ_СрезДислокацииКонтейнеров КАК ВТ_СрезДислокацииКонтейнеров
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналогиЛокаций КАК АналогиСтанцииПогрузкиКонтейнера
		|		ПО ВТ_СрезДислокацииКонтейнеров.СтанцияПогрузкиКонтейнера = АналогиСтанцииПогрузкиКонтейнера.Локация
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ВТ_СрезДислокацииКонтейнеров.Контейнер,
		|	ВТ_СрезДислокацииКонтейнеров.СтанцияПогрузкиКонтейнера,
		|	ВТ_СрезДислокацииКонтейнеров.Вагон
		|ИЗ
		|	ВТ_СрезДислокацииКонтейнеров КАК ВТ_СрезДислокацииКонтейнеров
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СрезДислокацииКонтейнеров.Контейнер КАК Контейнер,
		|	АналогиСтанцииПогрузкиКонтейнера.Аналог КАК СтанцияНазначения,
		|	ВТ_СрезДислокацииКонтейнеров.Вагон КАК Вагон
		|ПОМЕСТИТЬ ВТ_СрезДислокацииКонтейнеровСтанцииНазначения
		|ИЗ
		|	ВТ_СрезДислокацииКонтейнеров КАК ВТ_СрезДислокацииКонтейнеров
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналогиЛокаций КАК АналогиСтанцииПогрузкиКонтейнера
		|		ПО ВТ_СрезДислокацииКонтейнеров.СтанцияНазначения = АналогиСтанцииПогрузкиКонтейнера.Локация
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ВТ_СрезДислокацииКонтейнеров.Контейнер,
		|	ВТ_СрезДислокацииКонтейнеров.СтанцияНазначения,
		|	ВТ_СрезДислокацииКонтейнеров.Вагон
		|ИЗ
		|	ВТ_СрезДислокацииКонтейнеров КАК ВТ_СрезДислокацииКонтейнеров
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_СрезДислокацииКонтейнеровСтанцииПогрузки.Контейнер КАК Контейнер,
		|	ЕСТЬNULL(ВТ_СрезДислокацииКонтейнеровСтанцииПогрузки.Вагон, ЗНАЧЕНИЕ(Справочник.ТС.ПустаяСсылка)) КАК Вагон,
		|	ВТ_СрезДислокацииКонтейнеровСтанцииПогрузки.СтанцияПогрузкиКонтейнера КАК СтанцияПогрузкиКонтейнера,
		|	ВТ_СрезДислокацииКонтейнеровСтанцииНазначения.СтанцияНазначения КАК СтанцияНазначения
		|ПОМЕСТИТЬ ВТ_СрезДислокацииКонтейнеровИтог
		|ИЗ
		|	ВТ_СрезДислокацииКонтейнеровСтанцииПогрузки КАК ВТ_СрезДислокацииКонтейнеровСтанцииПогрузки
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СрезДислокацииКонтейнеровСтанцииНазначения КАК ВТ_СрезДислокацииКонтейнеровСтанцииНазначения
		|		ПО ВТ_СрезДислокацииКонтейнеровСтанцииПогрузки.Контейнер = ВТ_СрезДислокацииКонтейнеровСтанцииНазначения.Контейнер
		|			И ВТ_СрезДислокацииКонтейнеровСтанцииПогрузки.Вагон = ВТ_СрезДислокацииКонтейнеровСтанцииНазначения.Вагон
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_УслугиИтог.НомерКТК КАК НомерКТК,
		|	МАКСИМУМ(ЕСТЬNULL(ВТ_СрезДислокацииКонтейнеровИтог.Вагон, ЗНАЧЕНИЕ(Справочник.ТС.ПустаяСсылка))) КАК Вагон
		|ПОМЕСТИТЬ ВТ_КонтейнерВагон
		|ИЗ
		|	ВТ_УслугиИтог КАК ВТ_УслугиИтог
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СрезДислокацииКонтейнеровИтог КАК ВТ_СрезДислокацииКонтейнеровИтог
		|		ПО ВТ_УслугиИтог.АналогиСтанцииПогрузкиКонтейнера = ВТ_СрезДислокацииКонтейнеровИтог.СтанцияПогрузкиКонтейнера
		|			И ВТ_УслугиИтог.АналогиСтанцииНазначения = ВТ_СрезДислокацииКонтейнеровИтог.СтанцияНазначения
		|			И ВТ_УслугиИтог.НомерКТК = ВТ_СрезДислокацииКонтейнеровИтог.Контейнер
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_УслугиИтог.НомерКТК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_КонтейнерВагон.НомерКТК КАК НомерКТК,
		|	ВТ_КонтейнерВагон.Вагон КАК Вагон,
		|	ЕСТЬNULL(ПаспортаВагоновСрезПоследних.Собственник, ЗНАЧЕНИЕ(Справочник.э_СобственникиАрендаторыВагонов.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.э_СобственникиАрендаторыВагонов.ПустаяСсылка) КАК СобственникЗаполнен,
		|	ЕСТЬNULL(ПаспортаВагоновСрезПоследних.Собственник.ОКПО, """") <> """" КАК ОКПОЗаполнен,
		|	ЕСТЬNULL(ПаспортаВагоновСрезПоследних.Собственник, ЗНАЧЕНИЕ(Справочник.э_СобственникиАрендаторыВагонов.ПустаяСсылка)) КАК Собственник
		|ИЗ
		|	ВТ_КонтейнерВагон КАК ВТ_КонтейнерВагон
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПаспортаВагонов.СрезПоследних КАК ПаспортаВагоновСрезПоследних
		|		ПО ВТ_КонтейнерВагон.Вагон = ПаспортаВагоновСрезПоследних.Вагон";
	
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	Запрос.УстановитьПараметр("СписокКонтейнеров", СписокКонтейнеров);
	Запрос.УстановитьПараметр("ТЗ",ТЗ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	МассивКТКБезВагонов 		 = Новый Массив;
	МассивВыгоновБезСобственника = Новый Массив;
	МассивСобственниковБезОКПО 	 = Новый Массив;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Вагон) Тогда
			Если НЕ ВыборкаДетальныеЗаписи.СобственникЗаполнен Тогда
				Если МассивВыгоновБезСобственника.Найти(ВыборкаДетальныеЗаписи.Вагон) = Неопределено Тогда
					МассивВыгоновБезСобственника.Добавить(ВыборкаДетальныеЗаписи.Вагон);
				КонецЕсли;
			ИначеЕсли ВыборкаДетальныеЗаписи.СобственникЗаполнен И НЕ ВыборкаДетальныеЗаписи.ОКПОЗаполнен Тогда
				Если МассивСобственниковБезОКПО.Найти(ВыборкаДетальныеЗаписи.Собственник) = Неопределено Тогда
					МассивСобственниковБезОКПО.Добавить(ВыборкаДетальныеЗаписи.Собственник);
				КонецЕсли;
			КонецЕсли;	
		Иначе
			МассивКТКБезВагонов.Добавить(ВыборкаДетальныеЗаписи.НомерКТК);	
		КонецЕсли;	
	КонецЦикла;
	
	СтруктураОтвет = Новый Структура("МассивКТКБезВагонов,МассивВыгоновБезСобственника,МассивСобственниковБезОКПО",МассивКТКБезВагонов,МассивВыгоновБезСобственника,МассивСобственниковБезОКПО);
	
	Возврат СтруктураОтвет;
	
КонецФункции	

&НаКлиенте
Функция ОбработатьТЧУслугиПроверкаСибур() //ДИТ Шевченко А.В. 57147 28.12.2022
	
	НеЗаполненНомерКТКНомераСтрок 	 		 = Новый Массив;
	НеЗаполненВладелецКТКНомераСтрок 		 = Новый Массив;
	НерезидентыБезВнешнегоКода 	 			 = Новый Массив;
	РезидентыБезКодаПоОКПО 	 	 			 = Новый Массив;
	МассивВладелцевКТК				         = Новый Массив;
	// ДИТ US 60810 TA 66664 Евсенкин М.А. Начало: 21.03.2023
	НеЗаполненКодКонтрагентаСибур			 = Новый Массив;
	ПроверкаКодКонтрагентаСибур(НеЗаполненКодКонтрагентаСибур);
	// ДИТ US 60810 TA 66664 Евсенкин М.А. Конец: 21.03.2023
	
	
	Для Каждого СтрокаТЧ Из Объект.СоставУслуги Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.НомерКТК) Тогда
			НеЗаполненНомерКТКНомераСтрок.Добавить(СтрокаТЧ.НомерСтроки);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.ВладелецКТК) Тогда
			НеЗаполненВладелецКТКНомераСтрок.Добавить(СтрокаТЧ.НомерСтроки);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТЧ.ВладелецКТК) Тогда
			МассивВладелцевКТК.Добавить(СтрокаТЧ.ВладелецКТК);
		КонецЕсли	
	КонецЦикла;	
	
	Если МассивВладелцевКТК.Количество() > 0 Тогда
		ПолучитьРезидентовИНеРезидентовБезКодов(МассивВладелцевКТК,НерезидентыБезВнешнегоКода,РезидентыБезКодаПоОКПО);
	КонецЕсли;	
	
	СтруктураОтвет = Новый Структура;
	СтруктураОтвет.Вставить("НеЗаполненНомерКТКНомераСтрок"			,НеЗаполненНомерКТКНомераСтрок);
	СтруктураОтвет.Вставить("НеЗаполненВладелецКТКНомераСтрок"		,НеЗаполненВладелецКТКНомераСтрок);
	СтруктураОтвет.Вставить("НерезидентыБезВнешнегоКода" 			,НерезидентыБезВнешнегоКода);
	СтруктураОтвет.Вставить("РезидентыБезКодаПоОКПО"				,РезидентыБезКодаПоОКПО);
	// ДИТ US 60810 TA 66664 Евсенкин М.А. Начало: 22.03.2023
	СтруктураОтвет.Вставить("НеЗаполненКодКонтрагентаСибур"			,НеЗаполненКодКонтрагентаСибур);
	// ДИТ US 60810 TA 66664 Евсенкин М.А. Конец: 22.03.2023
	
	Возврат СтруктураОтвет; 
	
КонецФункции	

&НаСервереБезКонтекста
Процедура ПолучитьРезидентовИНеРезидентовБезКодов(МассивВладелцевКТК,НерезидентыБезВнешнегоКода,РезидентыБезКодаПоОКПО) //ДИТ Шевченко А.В. 57147 28.12.2022
	
	РезидентыБезКодов 	= Новый Массив;
	НеРезидентыБезКодов = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Контрагенты.Ссылка КАК Контрагент
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	НЕ Контрагенты.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
		|	И Контрагенты.ВнешнийКодНерезидента = """"
		|	И Контрагенты.Ссылка В (&МассивВладелцевКТК)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Контрагенты.Ссылка КАК Контрагент
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
		|	И Контрагенты.КодПоОКПО = """"
		|	И Контрагенты.Ссылка В (&МассивВладелцевКТК)";
	
	Запрос.УстановитьПараметр("МассивВладелцевКТК",МассивВладелцевКТК);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаНеРезиденты = РезультатЗапроса[0].Выбрать();
	ВыборкаРезиденты = РезультатЗапроса[1].Выбрать();
	
	Пока ВыборкаНеРезиденты.Следующий() Цикл
		НерезидентыБезВнешнегоКода.Добавить(ВыборкаНеРезиденты.Контрагент);
	КонецЦикла;
	
	Пока ВыборкаРезиденты.Следующий() Цикл
		РезидентыБезКодаПоОКПО.Добавить(ВыборкаРезиденты.Контрагент);
	КонецЦикла;
	
КонецПроцедуры	

