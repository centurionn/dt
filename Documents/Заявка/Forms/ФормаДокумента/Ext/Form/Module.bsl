		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.э_Накладная.Контейнеры КАК э_НакладнаяКонтейнеры
		|			ПО СтоимостьПоЖДНакладным.Контейнер.Наименование = э_НакладнаяКонтейнеры.НомерКонтейнера
		|				И (э_НакладнаяКонтейнеры.Ссылка = СтоимостьПоЖДНакладным.ТранспортныйДокумент.НакладнаяЭТРАН)
		|			ЛЕВОЕ СОЕДИНЕНИЕ ДанныеСделок КАК ДанныеСделок
		|			ПО СтоимостьПоЖДНакладным.ТранспортныйДокумент = ДанныеСделок.ТД
		|				И (ДанныеСделок.ПустойКТК
		|					ИЛИ ДанныеСделок.Контейнер = СтоимостьПоЖДНакладным.Контейнер)
		|				И (ДанныеСделок.ПустойВагон
		|					ИЛИ ДанныеСделок.Вагон = СтоимостьПоЖДНакладным.Вагон)
		|		ПО э_Накладная.ТД = СтоимостьПоЖДНакладным.ТранспортныйДокумент
		|			И (СтоимостьПоЖДНакладным.КонтейнерНаименование = ВТ_ТЧВагоныКонтейнеры.НомерКонтейнера)
		|			И (СтоимостьПоЖДНакладным.ВагонНаименование = ВТ_ТЧВагоныКонтейнеры.НомерВагона)
		|ГДЕ
		|	ВТ_ТЧВагоныКонтейнеры.НомерКонтейнера В(&СписокКТК)
		|	И ДанныеСделок.Сделка ЕСТЬ NULL
		|ИТОГИ ПО
		|	НомерКТК";  
	ЗаполнитьПараметрыЗапросаКНакладным(Запрос, ПараметрыНакладных);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если не РезультатЗапроса.Пустой() Тогда      
		СтруктураПоискаСтроки = Новый Структура("НомерКТК");
		Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
		МассивЗаполненных = Новый Массив;
		Пока Выборка.Следующий() Цикл  
			ЗаполнитьЗначенияСвойств(СтруктураПоискаСтроки,Выборка);
			СтрокиУслуг = Объект.СоставУслуги.НайтиСтроки(СтруктураПоискаСтроки); 
			ВыборкаНакладная = Выборка.Выбрать();
			Если ВыборкаНакладная.Следующий() Тогда 
				МассивЗаполненных.Добавить(ВыборкаНакладная.СтрокаНомерКТК);
				Для каждого Стр Из СтрокиУслуг Цикл
					ЗаполнитьВСтрокеГрузыИзНакладной(Стр, ВыборкаНакладная.Документ);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла; 
		ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивЗаполненных);  
		Если МассивЗаполненных.Количество() Тогда
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон("Обновлены данные по грузу и весу груза в строках контейнеров %1", СтрСоединить(МассивЗаполненных, ",")));
			ЭтаФорма.Модифицированность = Истина;		
		КонецЕсли;
	Иначе
		ОбщегоНазначения.СообщитьПользователю("Не удалось подобрать накладные для КТК из услуг");
	КонецЕсли;
		
КонецПроцедуры   

// ДИТ US 81881 ТА 83581 Сержантова А.С. 08.04.2024  
&НаСервере
Процедура ЗаполнитьПараметрыЗапросаКНакладным(Запрос, ПараметрыНакладных)

	Запрос.УстановитьПараметр("ДатаКон", ПараметрыНакладных.ДатаОкончания);
	Запрос.УстановитьПараметр("ДатаНач", ПараметрыНакладных.ДатаНачала);       
	
	//Станция отправления, станция назначения     
	СтанцияНазначения = Новый Массив;
	СтанцияОтправления = Новый Массив;
	
	Если ПараметрыНакладных.СтанцияОтправления <> Неопределено или ПараметрыНакладных.СтанцияНазначения <> Неопределено Тогда
		ЗапросСтанция = Новый Запрос;
		ЗапросСтанция.Текст =
		"ВЫБРАТЬ
		|	э_Станции.Ссылка КАК Станция
		|ИЗ
		|	Справочник.Локации КАК Локации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.э_Станции КАК э_Станции
		|		ПО (ПОДСТРОКА(Локации.КодЖДСтанции, 1, 5) = ПОДСТРОКА(э_Станции.Код, 1, 5))
		|ГДЕ
		|	Локации.Ссылка = &ЛокацияОтправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	э_Станции.Ссылка КАК Станция
		|ИЗ
		|	Справочник.Локации КАК Локации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.э_Станции КАК э_Станции
		|		ПО (ПОДСТРОКА(Локации.КодЖДСтанции, 1, 5) = ПОДСТРОКА(э_Станции.Код, 1, 5))
		|ГДЕ
		|	Локации.Ссылка = &ЛокацияНазначения";
		ЗапросСтанция.УстановитьПараметр("ЛокацияОтправления", ПараметрыНакладных.СтанцияОтправления);  
		ЗапросСтанция.УстановитьПараметр("ЛокацияНазначения", ПараметрыНакладных.СтанцияНазначения); 
		ПакетРезультатов = ЗапросСтанция.ВыполнитьПакет();
		РезСтанцияОтправления = ПакетРезультатов[0].Выбрать();
		РезСтанцияНазначения = ПакетРезультатов[1].Выбрать();
		
		Если РезСтанцияОтправления.Следующий() Тогда
			СтанцияОтправления.Добавить(РезСтанцияОтправления.Станция);
		КонецЕсли;
		
		Если РезСтанцияНазначения.Следующий() Тогда
			СтанцияНазначения.Добавить(РезСтанцияНазначения.Станция);
		КонецЕсли;
			
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НетОтбораСтанцииНазначения",Не ЗначениеЗаполнено(СтанцияНазначения));	   
	Запрос.УстановитьПараметр("ОтборыСтанцияНазначения",СтанцияНазначения);
	
	Запрос.УстановитьПараметр("НетОтбораСтанцииОтправления",Не ЗначениеЗаполнено(СтанцияОтправления));	   
	Запрос.УстановитьПараметр("ОтборыСтанцияОтправления",СтанцияОтправления);
	
	//Список наименований КТК
	СписокКТК = Объект.СоставУслуги.Выгрузить(,"НомерКТК").ВыгрузитьКолонку("НомерКТК"); 
	СписокКТКСоответствие = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(СписокКТК,"Наименование");
	СписокКТК.Очистить();
	Для каждого СтрокаСоответствия Из СписокКТКСоответствие Цикл
		СписокКТК.Добавить(СтрокаСоответствия.Значение.Наименование);	
	КонецЦикла;
	Запрос.УстановитьПараметр("СписокКТК", СписокКТК);	

КонецПроцедуры

// ДИТ US 81881 ТА 83581 Сержантова А.С. 08.04.2024
&НаКлиенте
Процедура ЗаполнитьНаОснованииЖДН(Команда)   
	
	// Евросиб(ДИТ) US 82176 ТА 86287 Сержантова А.С. Начало: 10.06.2024
	// Груз и вес заполняем из Сделки. Старый алгоритм поиска сохранен по просьбе Ольги Савченковой
	ЗаполнитьГрузИВесПоДаннымСделки();
	Возврат;
	// Евросиб(ДИТ) US 82176 ТА 86287 Сержантова А.С. Конец: 10.06.2024
	
	Если Не ЗначениеЗаполнено(Объект.Отправка) Тогда
		ПоказатьПредупреждение(, "Не указана Дата отправки!");
		Возврат;
	КонецЕсли;
	
	СтрокиБезКонтейнеров = Объект.СоставУслуги.НайтиСтроки(Новый Структура("НомерКТК", ПредопределенноеЗначение("Справочник.ТЕ.ПустаяСсылка")));
	МаксимальноеКоличествоВыбранныхСтрок = Объект.СоставУслуги.Количество() - СтрокиБезКонтейнеров.Количество();
	Если МаксимальноеКоличествоВыбранныхСтрок = 0 Тогда
		ПоказатьПредупреждение(, "Нет строк с заполненными контейнерами!");
		Возврат;
	КонецЕсли;          
	СтруктураПоиска = Новый Структура("КлючАналитикиПеревозки, НомерКТК", 
			ПредопределенноеЗначение("Справочник.КлючиАналитикиПеревозки.ПустаяСсылка"),
			ПредопределенноеЗначение("Справочник.ТЕ.ПустаяСсылка"));
	СтрокиБезКлюча = Объект.СоставУслуги.НайтиСтроки(СтруктураПоиска);
	Если СтрокиБезКлюча.Количество() > 0 Тогда
		ПоказатьПредупреждение(, "Необходимо сначала записать заявку!");
		Возврат;
	КонецЕсли; 
	
	СтанцииОтправления = Новый Массив;
	СтанцииНазначения = Новый Массив;

	Для Каждого СтрокаУслуг Из Объект.СоставУслуги Цикл
		Если ЗначениеЗаполнено(СтрокаУслуг.СтанцияОтправления) И СтанцииОтправления.Найти(СтрокаУслуг.СтанцияОтправления) = Неопределено Тогда
			СтанцииОтправления.Добавить(СтрокаУслуг.СтанцияОтправления);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаУслуг.СтанцияНазначения) И СтанцииНазначения.Найти(СтрокаУслуг.СтанцияНазначения) = Неопределено Тогда
			СтанцииНазначения.Добавить(СтрокаУслуг.СтанцияНазначения);
		КонецЕсли;
	КонецЦикла;
	
	Если СтанцииОтправления.Количество() = 1 Тогда
		СтанцияОтправления = СтанцииОтправления[0];
	Иначе
		СтанцияОтправления = Неопределено;
	КонецЕсли;
	
	Если СтанцииНазначения.Количество() = 1 Тогда
		СтанцияНазначения = СтанцииНазначения[0];
	Иначе
		СтанцияНазначения = Неопределено;
	КонецЕсли;
	
	ПараметрыНакладных = Новый Структура;
	ПараметрыНакладных.Вставить("ДатаНачала", НачалоДня(Объект.Отправка));
	ПараметрыНакладных.Вставить("ДатаОкончания", КонецДня(Объект.Отправка));
	ПараметрыНакладных.Вставить("СтанцияОтправления", СтанцияОтправления);
	ПараметрыНакладных.Вставить("СтанцияНазначения", СтанцияНазначения);
	
	ЗаполнитьНаОснованииЖДННаСервере(ПараметрыНакладных);
КонецПроцедуры   

// Евросиб(ДИТ) US 82176 ТА 86287 Сержантова А.С. 10.06.2024
&НаСервере
Процедура ЗаполнитьГрузИВесПоДаннымСделки()

	РезультатПоискаГрузаВЗаявке = ПолучитьДанныеВесаИГрузаИзСделки();
	МассивЗаполненных = Новый Массив;
	Для каждого СтрокаУслуги Из Объект.СоставУслуги Цикл
		Если ЗначениеЗаполнено(СтрокаУслуги.НомерКТК) 
			и РезультатПоискаГрузаВЗаявке.Получить(СтрокаУслуги.НомерКТК) <> Неопределено Тогда 
			
			Если СтрокаУслуги.Груз <> РезультатПоискаГрузаВЗаявке[СтрокаУслуги.НомерКТК].Груз
				или СтрокаУслуги.ВесГрузаНетто <> РезультатПоискаГрузаВЗаявке[СтрокаУслуги.НомерКТК].ВесГрузаНетто 
				или РезультатПоискаГрузаВЗаявке[СтрокаУслуги.НомерКТК].СоставГруза <> Неопределено Тогда 
				
				СтрокиДетализации = ДетализацияПоГрузу.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки", СтрокаУслуги.КлючАналитикиПеревозки));
				Для каждого СтрДетализации Из СтрокиДетализации Цикл
					ДетализацияПоГрузу.Удалить(СтрДетализации);	
				КонецЦикла;
				
				ГрузИВесИзЖДН = РезультатПоискаГрузаВЗаявке[СтрокаУслуги.НомерКТК]; 
				Если ГрузИВесИзЖДН.СоставГруза <> Неопределено Тогда
					Для каждого СтрСоставаГруза Из ГрузИВесИзЖДН.СоставГруза Цикл
						НС = ДетализацияПоГрузу.Добавить();
						ЗаполнитьЗначенияСвойств(НС, СтрСоставаГруза);
						НС.КлючАналитикиПеревозки = СтрокаУслуги.КлючАналитикиПеревозки;
					КонецЦикла;      
				КонецЕсли;
				ЗаполнитьЗначенияСвойств(СтрокаУслуги, ГрузИВесИзЖДН); 
				МассивЗаполненных.Добавить(СтрокаУслуги.НомерСтроки);
			КонецЕсли;  
		КонецЕсли;
	КонецЦикла;          
	Если МассивЗаполненных.Количество() Тогда
		ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон("Обновлены данные по грузу и весу груза в строках контейнеров %1", СтрСоединить(МассивЗаполненных, ",")));
		ЭтаФорма.Модифицированность = Истина;		
	КонецЕсли;
	
КонецПроцедуры

// Евросиб(ДИТ) US 82176 ТА 86287 Сержантова А.С. 10.06.2024 
&НаСервере
Функция ПолучитьДанныеВесаИГрузаИзСделки()  
	
	Результат = Новый Соответствие;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	&Ссылка КАК Ссылка,
	               |	ТЕ.Ссылка КАК НомерКТК
	               |ПОМЕСТИТЬ ВТ_ДанныеЗаявки
	               |ИЗ
	               |	Справочник.ТЕ КАК ТЕ
	               |ГДЕ
	               |	ТЕ.Ссылка В(&СписокКТК)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	СделкаСвязьУчетныхЕдиниц.Контейнер КАК Контейнер,
	               |	ВЫБОР
	               |		КОГДА СделкаСвязьУчетныхЕдиниц.ВидТранспортногоСообщения = ЗНАЧЕНИЕ(Перечисление.ВидыТранспортныхСообщений.ЖД)
	               |			ТОГДА 1
	               |		ИНАЧЕ 2
	               |	КОНЕЦ КАК Приоритет,
	               |	СделкаСвязьУчетныхЕдиниц.ЖДН КАК ЖДН
	               |ПОМЕСТИТЬ ВТ_ЖДНСделки
	               |ИЗ
	               |	ВТ_ДанныеЗаявки КАК ВТ_ДанныеЗаявки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Грузы КАК Грузы
	               |			ПО СделкаСвязьУчетныхЕдиниц.Груз = Грузы.Ссылка
	               |		ПО ВТ_ДанныеЗаявки.Ссылка = СделкаСвязьУчетныхЕдиниц.Заявка
	               |			И ВТ_ДанныеЗаявки.НомерКТК = СделкаСвязьУчетныхЕдиниц.Контейнер
	               |ГДЕ
	               |	СделкаСвязьУчетныхЕдиниц.Ссылка.Проведен
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ЖДНСделки.Контейнер КАК Контейнер,
	               |	ВТ_ЖДНСделки.Приоритет КАК Приоритет,
	               |	э_Накладная.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ ВТ_НакаладныеИзСделки
	               |ИЗ
	               |	ВТ_ЖДНСделки КАК ВТ_ЖДНСделки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.э_Накладная КАК э_Накладная
	               |			ПО ТранспортныйДокумент.НакладнаяЭТРАН = э_Накладная.Ссылка
	               |		ПО ВТ_ЖДНСделки.ЖДН = ТранспортныйДокумент.Ссылка
	               |			И (э_Накладная.Проведен)
	               |			И (э_Накладная.ТекущееСостояниеНакладнойДействующийСтатус)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_НакаладныеИзСделки.Контейнер КАК Контейнер,
	               |	ВТ_НакаладныеИзСделки.Приоритет КАК Приоритет,
	               |	ЕСТЬNULL(э_НакладнаяГрузыЖД.МассаГруза, 0) КАК ВесГрузаНетто,
	               |	Связь_ЭТРАН_DC_Сопоставление.СпрДатакор КАК Груз,
	               |	ЕСТЬNULL(э_НакладнаяГрузыЖД.КодЕТСНГ, """") КАК КодГруза,
	               |	ЕСТЬNULL(э_НакладнаяГрузыЖД.КоличествоМест, 0) КАК КоличествоМест
	               |ИЗ
	               |	ВТ_НакаладныеИзСделки КАК ВТ_НакаладныеИзСделки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.э_Накладная.ГрузыЖД КАК э_НакладнаяГрузыЖД
	               |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Связь_ЭТРАН_DC_Сопоставление КАК Связь_ЭТРАН_DC_Сопоставление
	               |			ПО э_НакладнаяГрузыЖД.ЕТСНГ = Связь_ЭТРАН_DC_Сопоставление.СпрЭтрана
	               |		ПО ВТ_НакаладныеИзСделки.Ссылка = э_НакладнаяГрузыЖД.Ссылка
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Приоритет
	               |ИТОГИ
	               |	СУММА(ВесГрузаНетто),
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Груз),
	               |	СУММА(КоличествоМест)
	               |ПО
	               |	Контейнер,
	               |	Приоритет";
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.УстановитьПараметр("СписокКТК", Объект.СоставУслуги.Выгрузить(,"НомерКТК")); 
	ВыборкаКТК = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	КодЕТСНГСборнойОтправки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Справочники.Грузы.СборнаяКонтейнернаяОтправка, "ЕТСНГ");
	Пока ВыборкаКТК.Следующий() Цикл 
		СтруктураГруз = Новый Структура("Груз, КодГруза, ВесГрузаНетто, КоличествоМест, Груженый, СоставГруза");
	    ВыборкаПриоритет = ВыборкаКТК.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Если ВыборкаПриоритет.Следующий() Тогда  
			Если ВыборкаПриоритет.ВесГрузаНетто = 0 и ВыборкаПриоритет.КоличествоМест = 0 и ВыборкаПриоритет.Груз = 0 Тогда
				Продолжить;
			КонецЕсли;
			Если ВыборкаПриоритет.Груз > 1 Тогда
			    СтруктураГруз.Груз = Справочники.Грузы.СборнаяКонтейнернаяОтправка; 
				СтруктураГруз.КодГруза = КодЕТСНГСборнойОтправки;  
				СтруктураГруз.ВесГрузаНетто = ВыборкаПриоритет.ВесГрузаНетто; 
				СтруктураГруз.КоличествоМест = ВыборкаПриоритет.КоличествоМест;
				СтруктураГруз.Груженый = Истина;
				ВыборкаГруз = ВыборкаПриоритет.Выбрать(); 
				МассивСоставаГруза = Новый Массив;
				Пока ВыборкаГруз.Следующий() Цикл       
					СтрокаСоставаГруза = Новый Структура("Груз, ВесГруза, КоличествоМест");
					СтрокаСоставаГруза.Груз = ВыборкаГруз.Груз;
