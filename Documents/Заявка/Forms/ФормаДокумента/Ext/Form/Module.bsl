&НаКлиенте
Процедура ОбновитьКаскадныйФильтр()
	
	ТекД = Элементы.СоставУслуги.ТекущиеДанные;
	
	Если ТекД <> неопределено Тогда
		
		Элементы.СоставУслугиВидСобственности.СписокВыбора.Очистить();
		Если ТекД.ПринадлежностьТЕ = ПредопределенноеЗначение("Перечисление.ПринадлежностьТЕ.КТКлиента") Тогда
			Элементы.СоставУслугиВидСобственности.СписокВыбора.ЗагрузитьЗначения(ВидыСобственностиКлиентскогоКТК.ВыгрузитьЗначения());
		ИначеЕсли ТекД.ПринадлежностьТЕ = ПредопределенноеЗначение("Перечисление.ПринадлежностьТЕ.КТЕвросиба") Тогда
			Элементы.СоставУслугиВидСобственности.СписокВыбора.ЗагрузитьЗначения(ВидыСобственностиСобственногоКТК.ВыгрузитьЗначения());
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СвязатьСАРМКТК_ИнтеллектуальноеПрисвоение(ИмяКолонки, КТК, ЗначениеЗаявки, ЗначениеАРМ)
	
	Если ИмяКолонки = "ВидСобственности" Тогда
		
		Если ЗначениеЗаполнено(ЗначениеЗаявки) И ЗначениеЗаполнено(ЗначениеАРМ) И ЗначениеЗаявки <> ЗначениеАРМ Тогда
			Сообщить("№ " + КТК + " несоответствует виду собственности в АРМ: " + ЗначениеАРМ, СтатусСообщения.ОченьВажное);
		КонецЕсли;
		
	КонецЕсли;
	
	Если МассивКолонокЗаполняемыхВЗаявке.НайтиПоЗначению(ИмяКолонки) <> неопределено Тогда
		// Вариант - пользователь должен указывать это в заявке.
		
		Если НЕ ЗначениеЗаполнено(ЗначениеЗаявки) Тогда
			ЗначениеЗаявки = ЗначениеАРМ;
		КонецЕсли;
		
	ИначеЕсли МассивКолонокЗаполняемыхВАРМ.НайтиПоЗначению(ИмяКолонки) <> неопределено Тогда
		// Вариант - сведения должны заполняться из АРМ.
		
		Если ЗначениеЗаполнено(ЗначениеАРМ) Тогда
			ЗначениеЗаявки = ЗначениеАРМ;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПритерминальнаяСтанцияПриИзменении(Элемент)
	
	Если Не Объект.ГруженыйРейс Тогда
		Если ЗначениеЗаполнено(Объект.ПритерминальнаяСтанция) Тогда
			Для Каждого СтрокаТЧ Из Объект.СоставУслуги Цикл
				СтрокаТЧ.СтанцияОтправления = Объект.ПритерминальнаяСтанция;			
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура ГрузополучательПриИзменении(Элемент)
	
	ОбновитьКонтактнуюИнформациюГрузополучателя();
	
	Если ЗначениеЗаполнено(Объект.Грузополучатель) Тогда
		Для Каждого СтрокаТЧ Из Объект.СоставУслуги Цикл
			СтрокаТЧ.Грузополучатель = Объект.Грузополучатель;
		КонецЦикла;
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура СтанцияОтправленияГруженогоПриИзменении(Элемент)
	
	Если Объект.ГруженыйРейс Тогда
		Если ЗначениеЗаполнено(Объект.СтанцияОтправленияГруженого) Тогда
			Для Каждого СтрокаТЧ Из Объект.СоставУслуги Цикл
				СтрокаТЧ.СтанцияОтправления = Объект.СтанцияОтправленияГруженого;
			КонецЦикла;
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(Объект.СтанцияОтправленияГруженого) Тогда
			Для Каждого СтрокаТЧ Из Объект.СоставУслуги Цикл
				СтрокаТЧ.СтанцияНазначения = Объект.СтанцияОтправленияГруженого;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура СтанцияНазначенияГруженогоПриИзменении(Элемент)
	
	Если Объект.ГруженыйРейс Тогда
		Если ЗначениеЗаполнено(Объект.СтанцияНазначенияГруженого) Тогда
			Для Каждого СтрокаТЧ Из Объект.СоставУслуги Цикл
				СтрокаТЧ.СтанцияНазначения = Объект.СтанцияНазначенияГруженого;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставУслугиКалькуляцияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	//Евросиб Коханенко Н.А. 24.02.2025 (( #101467 
	ТекДанные = Элементы.СоставУслуги.ТекущиеДанные;
	ТекПСЦ = ТекДанные.ПСЦ;
	Если Не ЗначениеЗаполнено(ТекПСЦ) Тогда
		Элементы.СоставУслугиКалькуляция.СписокВыбора.Очистить();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо внести ПСЦ перед добавлением калькуляции.",,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СоставУслуги", ТекДанные.НомерСтроки, "ПСЦ"), "Объект");	
		Возврат;
	Иначе
		Рез = ПолучитьКалькуляциюИУслугуПоУмолчанию(ТекПСЦ);
