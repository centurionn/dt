// ДИТ US 81881 ТА 83581 Сержантова А.С. 08.04.2024
&НаСервере
Процедура ЗаполнитьНаОснованииЖДННаСервере(ПараметрыНакладных)
	
	//Упрощенный запрос из АРМ Накладные
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Организации.Ссылка КАК Ссылка,
		|	Организации.ОКПО КАК ОКПО
		|ПОМЕСТИТЬ ДанныеОрганизаций
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	НЕ Организации.ПометкаУдаления
		|	И НЕ Организации.ОбособленноеПодразделение
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	э_Накладная.Ссылка КАК Накладная,
		|	ТранспортныйДокумент.Ссылка КАК ТД,
		|	НЕ АктуальныеЖДН.ЖДН ЕСТЬ NULL КАК НакладнаяРаспределена
		|ПОМЕСТИТЬ СписокНакладных
		|ИЗ
		|	Документ.э_Накладная КАК э_Накладная
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.АктуальныеЖДН КАК АктуальныеЖДН
		|			ПО (АктуальныеЖДН.ЖДН = ТранспортныйДокумент.Ссылка)
		|				И (АктуальныеЖДН.Регистратор ССЫЛКА Документ.Сделка)
		|		ПО э_Накладная.Ссылка = ТранспортныйДокумент.НакладнаяЭТРАН
		|			И (э_Накладная.ДатаИВремяОтправленияГруза МЕЖДУ &ДатаНач И &ДатаКон)
		|			И (э_Накладная.Проведен)
		|			И (э_Накладная.ТекущееСостояниеНакладнойДействующийСтатус)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.э_Накладная.Контейнеры КАК э_НакладнаяКонтейнеры
		|		ПО э_Накладная.Ссылка = э_НакладнаяКонтейнеры.Ссылка
		|			И (э_НакладнаяКонтейнеры.НомерКонтейнера В (&СписокКТК))
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.э_Накладная.СпециальныеОтметки КАК э_НакладнаяСпециальныеОтметки
		|		ПО э_Накладная.Ссылка = э_НакладнаяСпециальныеОтметки.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.э_Накладная.ГрузыЖД КАК э_НакладнаяГрузыЖД
		|		ПО э_Накладная.Ссылка = э_НакладнаяГрузыЖД.Ссылка
		|ГДЕ
		|	НЕ э_НакладнаяКонтейнеры.Ссылка ЕСТЬ NULL
		|	И (&НетОтбораСтанцииОтправления
		|			ИЛИ э_Накладная.СтанцияОтправления В (&ОтборыСтанцияОтправления))
		|	И (&НетОтбораСтанцииНазначения
		|			ИЛИ э_Накладная.СтанцияНазначения В (&ОтборыСтанцияНазначения))
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	э_Накладная.Ссылка,
		|	ТранспортныйДокумент.Ссылка,
		|	НЕ АктуальныеЖДН.ЖДН ЕСТЬ NULL
		|ИЗ
		|	Документ.э_Накладная КАК э_Накладная
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.АктуальныеЖДН КАК АктуальныеЖДН
		|			ПО (АктуальныеЖДН.ЖДН = ТранспортныйДокумент.Ссылка)
		|				И (АктуальныеЖДН.Регистратор ССЫЛКА Документ.Сделка)
		|		ПО э_Накладная.Ссылка = ТранспортныйДокумент.НакладнаяЭТРАН
		|			И (э_Накладная.ДатаИВремяОтправленияГруза МЕЖДУ &ДатаНач И &ДатаКон)
		|			И (э_Накладная.Проведен)
		|			И (э_Накладная.ТекущееСостояниеНакладнойДействующийСтатус)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.э_Накладная.Контейнеры КАК э_НакладнаяКонтейнеры
		|		ПО э_Накладная.Ссылка = э_НакладнаяКонтейнеры.Ссылка
		|			И (э_НакладнаяКонтейнеры.НомерКонтейнера В (&СписокКТК))
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.э_Накладная.СпециальныеОтметки КАК э_НакладнаяСпециальныеОтметки
		|		ПО э_Накладная.Ссылка = э_НакладнаяСпециальныеОтметки.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.э_Накладная.ГрузыЖД КАК э_НакладнаяГрузыЖД
		|		ПО э_Накладная.Ссылка = э_НакладнаяГрузыЖД.Ссылка
		|ГДЕ
		|	НЕ э_НакладнаяКонтейнеры.Ссылка ЕСТЬ NULL
		|	И (&НетОтбораСтанцииОтправления
		|			ИЛИ э_Накладная.СтанцияОтправления В (&ОтборыСтанцияОтправления))
		|	И (&НетОтбораСтанцииНазначения
		|			ИЛИ э_Накладная.СтанцияНазначения В (&ОтборыСтанцияНазначения))
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Накладная,
		|	ТД
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СписокНакладных.ТД КАК ТД,
		|	СписокНакладных.Накладная КАК Накладная,
		|	СделкаСвязьУчетныхЕдиниц.Ссылка КАК Сделка,
		|	СделкаСвязьУчетныхЕдиниц.Контейнер КАК Контейнер,
		|	СделкаСвязьУчетныхЕдиниц.Вагон КАК Вагон,
		|	ЛОЖЬ КАК ПустойКТК,
		|	ЛОЖЬ КАК ПустойВагон
		|ПОМЕСТИТЬ ДанныеСделок
		|ИЗ
		|	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СписокНакладных КАК СписокНакладных
		|		ПО (СписокНакладных.ТД = СделкаСвязьУчетныхЕдиниц.ЖДН)
		|			И (СделкаСвязьУчетныхЕдиниц.Ссылка.Проведен)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьДоходовИРасходов КАК СделкаСвязьДоходовИРасходов
		|		ПО (СделкаСвязьДоходовИРасходов.СвязьУчетныхЕдиниц = СделкаСвязьУчетныхЕдиниц.ГУИД)
		|			И (СделкаСвязьДоходовИРасходов.Услуга = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.РасшифровкаУслугПоТС КАК РеализацияТоваровУслугРасшифровкаУслугПоТС
		|		ПО (РеализацияТоваровУслугРасшифровкаУслугПоТС.СтрокаСвязьУчетныхЕдиниц = СделкаСвязьУчетныхЕдиниц.ГУИД)
		|			И (РеализацияТоваровУслугРасшифровкаУслугПоТС.Ссылка.Контрагент = СделкаСвязьУчетныхЕдиниц.Клиент)
		|			И (РеализацияТоваровУслугРасшифровкаУслугПоТС.Ссылка.ДоговорКонтрагента = СделкаСвязьУчетныхЕдиниц.Договор)
		|			И (РеализацияТоваровУслугРасшифровкаУслугПоТС.Ссылка.Проведен)
		|
		|СГРУППИРОВАТЬ ПО
		|	СделкаСвязьУчетныхЕдиниц.Вагон,
		|	СделкаСвязьУчетныхЕдиниц.Контейнер,
		|	СделкаСвязьУчетныхЕдиниц.Ссылка,
		|	СписокНакладных.Накладная,
		|	СписокНакладных.ТД
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СписокНакладных.ТД,
		|	СписокНакладных.Накладная,
		|	СделкаСвязьУчетныхЕдиниц.Ссылка,
		|	СделкаСвязьУчетныхЕдиниц.Контейнер,
		|	СделкаСвязьУчетныхЕдиниц.Вагон,
		|	ЛОЖЬ,
		|	ЛОЖЬ
		|ИЗ
		|	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СписокНакладных КАК СписокНакладных
		|		ПО (СписокНакладных.ТД = СделкаСвязьУчетныхЕдиниц.ЖДН)
		|			И (СделкаСвязьУчетныхЕдиниц.Ссылка.Проведен)
		|			И (СделкаСвязьУчетныхЕдиниц.Доплата_Клиент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.РасшифровкаУслугПоТС КАК РеализацияТоваровУслугРасшифровкаУслугПоТС
		|		ПО (РеализацияТоваровУслугРасшифровкаУслугПоТС.СтрокаСвязьУчетныхЕдиниц = СделкаСвязьУчетныхЕдиниц.ГУИД)
		|			И (РеализацияТоваровУслугРасшифровкаУслугПоТС.Ссылка.Контрагент = СделкаСвязьУчетныхЕдиниц.Доплата_Клиент)
		|			И (РеализацияТоваровУслугРасшифровкаУслугПоТС.Ссылка.ДоговорКонтрагента = СделкаСвязьУчетныхЕдиниц.Доплата_Договор)
