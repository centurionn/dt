&НаКлиенте
Процедура ВставитьВодителейИзExcelКлиент(Миля)
	
	// Евросиб Фролов (06.12.2021 TASK№ №42618, РелизКлиента
	
	ТекущиеДанне = Элементы.СписокЗапросНаКТК.ТекущиеДанные;
	
	Если ТекущиеДанне = Неопределено Тогда
		ПоказатьПредупреждение(, "Укажите строку запроса, для которой необходимо загрузить сведения о ТС");
		Возврат;
	КонецЕсли;	
	
	Если ТекущиеДанне.КоличествоКТК = 0 Тогда
		ПоказатьПредупреждение(, "Укажите количество КТК");
		Возврат;
	КонецЕсли;	
	
	ТранспортныеСредстваСтроки = Объект[Миля].НайтиСтроки(Новый Структура("ИдентификаторСтрокиЗапроса", ТекущиеДанне.ИдентификаторСтроки));
	ДоступноеКоличество = ТекущиеДанне.КоличествоКТК - ТранспортныеСредстваСтроки.Количество();
    //ДИТ Шевченко А.В. 58552 05.10.2022 -начало
	//Если ДоступноеКоличество <= 0 Тогда
	//	ПоказатьПредупреждение(, "Для указанной строки запроса уже заполнено
	//							|необходимо количество транспортных средств.");
	//	Возврат;
	//КонецЕсли;	
	//ДИТ Шевченко А.В. 58552 05.10.2022 -конец
	ПараметрыЧтения = Новый Структура;
	ПараметрыЧтения.Вставить("КоличествоСтрок", ДоступноеКоличество);
	ПараметрыЧтения.Вставить("ИдентификаторСтроки", ТекущиеДанне.ИдентификаторСтроки);
	
	ОповещениеЧтениеТранспортныхСредств = Новый ОписаниеОповещения("РезультатЧтенияТранспортныхСредств", ЭтаФорма,Новый Структура("Миля",Миля));
	ОткрытьФорму("Документ.Заявка.Форма.ДобавлениеТранспортныхСредств", ПараметрыЧтения,ЭтаФорма, ЭтаФорма.УникальныйИдентификатор,,,ОповещениеЧтениеТранспортныхСредств, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
    // Евросиб Фролов)	
	
КонецПроцедуры	

&НаКлиенте
Процедура ЗапросНаАвтоперевозку(Команда)
	
	Отказ = Ложь;
	
	Если ЗначениеЗаполнено(ЗапросПерваяМиля) Тогда
		ПараметрыФ = Новый Структура;
		ПараметрыФ.Вставить("Ключ",ЗапросПерваяМиля);
		ОткрытьФорму("Документ.ЗапросНаАвтоперевозку.Форма.ФормаДокумента",ПараметрыФ,ЭтаФорма);
	Иначе
		//Создание нового	
		
		НетВариантов = ПроверитьНаличиеВариантовАвтоперевозкиЕвросибом("Автоперевозка","ПерваяМиля");
		Если НетВариантов Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Создание запроса на автоперевозку невозможно по причине отсутствия в заявке данных для заполнения",,,,Отказ)
		КонецЕсли;
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;	
	
		Если Объект.Ссылка.Пустая()
			ИЛИ НЕ Объект.Ссылка.Пустая() И Модифицированность = Истина ИЛИ НЕ Объект.Проведен Тогда
			Режим = РежимДиалогаВопрос.ДаНет;
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОПроведениЗаявки", ЭтотОбъект, Новый Структура("ЭтапПеревозки",ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПерваяМиля")));
