	Структура = Новый Структура("ДатаОтправленияПоЖДПлан,СтанцияНазначенияПоЖД");
	Если МассивСтрок.Количество() > 0 Тогда 
		ЗаполнитьЗначенияСвойств(Структура,МассивСтрок[0]);
	КонецЕсли;	
	Возврат Структура;
	// ДИТ US 58592 TA 60724 Евсенкин М.А. Конец: 13.12.2022
КонецФункции


