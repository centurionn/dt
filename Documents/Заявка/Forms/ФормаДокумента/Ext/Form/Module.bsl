// ++ Евросиб Дудоров С.В. US 57543 30.01.2023 
Процедура СинхронизироватьДанныеСРефСцепом()    
	
	ДанныеИзРефСцепа = РефСцепСервер.ПолучитьДанныеЗаполненияЗаявкиНаОснованииРефСцепаПоКлючам
		(Объект.ДокументОснование, Объект.СоставУслуги.Выгрузить().ВыгрузитьКолонку("КлючАналитикиПеревозки"));
		
	ДанныеПоКонтейнерам = ДанныеИзРефСцепа.ДанныеПоКонтейнерам;
	Шапка               = ДанныеИзРефСцепа.Шапка;
	ДанныеКлиента	    = ДанныеИзРефСцепа.ДанныеКлиента;
	
	ЕстьИзменения = Ложь;

	Пока Шапка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Шапка.ПланируемоеОтправление) Тогда
			Продолжить;
		КонецЕсли;	
		Для каждого СтрУслуг из Объект.СоставУслуги Цикл
			ЗаполнитьЗначенияСвойств(СтрУслуг, Шапка);
		КонецЦикла;	
		Если Шапка.ПланируемоеОтправление <> Объект.Отправка Тогда
			Объект.Отправка = Шапка.ПланируемоеОтправление;
			ЕстьИзменения   = истина;
		КонецЕсли;	
		Если Шапка.ПланируемоеПрибытие <> Объект.Прибытие Тогда
			Объект.Прибытие = Шапка.ПланируемоеПрибытие;
			ЕстьИзменения   = истина;
		КонецЕсли;	
		Если Объект.ПереченьРейсов.Количество()>0 ТОгда
			Если Объект.ПереченьРейсов[0].Рейс <> Шапка.Рейс Тогда
				Объект.ПереченьРейсов[0].Рейс 	 =  Шапка.Рейс;
				Объект.ПереченьРейсов[0].Продукт =  Шапка.Продукт;
				ЕстьИзменения = истина;
				Если не ЗначениеЗаполнено(Объект.ПереченьРейсов[0].Рейс) Тогда
					Объект.ПереченьРейсов.Очистить();
				КонецЕсли;	
			КонецЕсли;
		Иначе
			Если ЗначениеЗаполнено(Шапка.Рейс) Тогда
				НоваяСтрока = Объект.ПереченьРейсов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Шапка,"Рейс, Продукт");
				ЕстьИзменения = истина;
			КонецЕсли;	
		КонецЕсли;

		тзСоставУслуги = Объект.СоставУслуги.Выгрузить();
		Пока ДанныеПоКонтейнерам.Следующий() Цикл
			Если ДанныеПоКонтейнерам.КлючАналитикиПеревозки 
				= Справочники.КлючиАналитикиПеревозки.ПустаяСсылка() Тогда Продолжить; КонецЕсли;
			мСоставаУслуг = Объект.СоставУслуги.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки", ДанныеПоКонтейнерам.КлючАналитикиПеревозки));
			Для каждого СтрокаУслуги Из мСоставаУслуг Цикл
				ЗаполнитьЗначенияСвойств(СтрокаУслуги, ДанныеПоКонтейнерам);
				СтрокаУслуги.НомерКТК = ДанныеПоКонтейнерам.Контейнер;
				
				СтруктураКлючаАналитикиПеревозки 			   = Справочники.КлючиАналитикиПеревозки.СтруктураКлючаАналитикиПеревозки();
				СтруктураКлючаАналитикиПеревозки.Заявка 	   = ОБъект.Ссылка;
				СтруктураКлючаАналитикиПеревозки.Контейнер 	   = СтрокаУслуги.НомерКТК;
				СтруктураКлючаАналитикиПеревозки.КлючАналитики = СтрокаУслуги.КлючАналитикиПеревозки;
				КлючАналитикиПеревозки 						   = Справочники.КлючиАналитикиПеревозки
					.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлючаАналитикиПеревозки);
				СтрокаУслуги.КлючАналитикиПеревозки 			   = КлючАналитикиПеревозки.КлючАналитикиПеревозки;
				
				//ЗаполнитьСвязанныеПоляПринадлежностьТЕ(СтрокаУслуги);
			КонецЦикла;	
		КонецЦикла;
	КонецЦикла; 
	
		
	Если ЕстьИзменения Тогда
		ОбщегоНазначения.СообщитьПользователю("Есть изменение данных по документу основанию реф.сцеп");
	КонецЕсли;	
			
КонецПроцедуры	

Процедура ЗаполнитьКонтейнерыИзРефСцепа(Основание
				, ЭтоСозданиеЗаявкиИзРефСцепа
				, МассивКонтейнеров
				, ДГК);	

	ДанныеИзРефСцепа = РефСцепСервер.ПолучитьДанныеЗаполненияЗаявкиНаОснованииРефСцепа
		(Основание, МассивКонтейнеров);
	ДанныеПоКонтейнерам 	 = ДанныеИзРефСцепа.ДанныеПоКонтейнерам;
	Шапка               	 = ДанныеИзРефСцепа.Шапка;
	ДанныеКлиента			 = ДанныеИзРефСцепа.ДанныеКлиента;  
	// Евросиб(ДИТ) US 85028 ТА 87358 Сержантова А.С. Начало: 01.07.2024
	ДанныеДетализацииПоГрузу = ДанныеИзРефСцепа.ДетализацияПоГрузу;
	// Евросиб(ДИТ) US 85028 ТА 87358 Сержантова А.С. Конец: 01.07.2024
	
	// Контейнеры
	Пока ДанныеПоКонтейнерам.Следующий() Цикл
		Если ДанныеПоКонтейнерам.КлючАналитикиПеревозки 
			= Справочники.КлючиАналитикиПеревозки.ПустаяСсылка() Тогда Продолжить; КонецЕсли;
		НоваяСтрока     	   		    = Объект.СоставУслуги.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеПоКонтейнерам);
		НоваяСтрока.НомерКТК 		    = ДанныеПоКонтейнерам.Контейнер;
		НоваяСтрока.ГУИДСтроки	 	    = Строка(Новый УникальныйИдентификатор()); 
		
		// Евросиб(ДИТ) US 85028 ТА 87358 Сержантова А.С. Начало: 01.07.2024 
		СтруктураПоискаДетализации = Новый Структура("КлючАналитикиПеревозки", ДанныеПоКонтейнерам.КлючАналитикиПеревозки); 
		Пока ДанныеДетализацииПоГрузу.НайтиСледующий(СтруктураПоискаДетализации) Цикл
			НСДетализации = ДетализацияПоГрузу.Добавить();
			ЗаполнитьЗначенияСвойств(НСДетализации, ДанныеДетализацииПоГрузу);
		КонецЦикла;
		// Евросиб(ДИТ) US 85028 ТА 87358 Сержантова А.С. Конец: 01.07.2024
		
		//ЗаполнитьСвязанныеПоляПринадлежностьТЕ(НоваяСтрока);
		
		//СтруктураКлючаАналитикиПеревозки 			   = Справочники.КлючиАналитикиПеревозки.СтруктураКлючаАналитикиПеревозки();
		//СтруктураКлючаАналитикиПеревозки.Заявка 	   = ОБъект.Ссылка;
		//СтруктураКлючаАналитикиПеревозки.Контейнер 	   = НоваяСтрока.НомерКТК;
		//СтруктураКлючаАналитикиПеревозки.КлючАналитики = НоваяСтрока.КлючАналитикиПеревозки;
		//КлючАналитикиПеревозки 						   = Справочники.КлючиАналитикиПеревозки
		//	.НайтиСоздатьКлючАналитикиПеревозки(СтруктураКлючаАналитикиПеревозки);
		//НоваяСтрока.КлючАналитикиПеревозки 			   = КлючАналитикиПеревозки.КлючАналитикиПеревозки;
		
	//Субботин 77659 02.02.2024 Начало
		ЭтаФорма.Модифицированность = Истина;
	//Субботин 77659 02.02.2024 Конец
	
	КонецЦикла;
	Пока Шапка.Следующий() Цикл
		Для каждого СтрУслуг из Объект.СоставУслуги Цикл
			ЗаполнитьЗначенияСвойств(СтрУслуг, Шапка);
		КонецЦикла;	
		Если ЭтоСозданиеЗаявкиИзРефСцепа Тогда
			Если ЗначениеЗаполнено(Шапка.Рейс) Тогда
				НоваяСтрока 	 	= Объект.ПереченьРейсов.Добавить();
				НоваяСтрока.Рейс 	= Шапка.Рейс;
				НоваяСтрока.Продукт = Шапка.Продукт;
				Прервать;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	
	// Клиент
	Если ЭтоСозданиеЗаявкиИзРефСцепа Тогда
		Если ДГК Тогда
			Объект.Контрагент =  Константы.КонтрагентДирекцияКонтейнерныхПеревозок.Получить();
			Объект.Договор	  =  КонтрагентыДоговоры_Сервер.ПолучитьЕдинственныйДоговорКонтрагента(Объект.Контрагент);
		Иначе	
			Пока ДанныеКлиента.Следующий() Цикл
				Объект.Контрагент = ДанныеКлиента.Клиент;
				Прервать;	
			КонецЦикла;	
        КонецЕсли;
	КонецЕсли; 
		
КонецПроцедуры
