		СтруктураСведений.Вставить("СрокИспользованияКТК", 	ТекущийЗапрос.СрокИспользованияКТК);
		СтруктураСведений.Вставить("ЛокацияВыдачи", 		ТекущийЗапрос.ЛокацияВыдачи);
		СтруктураСведений.Вставить("ЛокацияСдачи", 			ТекущийЗапрос.ЛокацияСдачи);
		
		СоответствиеКоличестваСтрока.Вставить(ТекущийЗапрос.РелизКлиента, СтруктураСведений);
	КонецЦикла;	
	
	ВыборкаРелизКлиента = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаРелизКлиента.Следующий() Цикл
		
		//Выборка = РезультатЗапроса.Выбрать();
		Выборка = ВыборкаРелизКлиента.Выбрать();
		
		ДопустимоеКоличествоСтрок 	= 0;
		НормативноеИспользование 	= 0;
		ПунктОтправления 			= Справочники.Локации.ПустаяСсылка();
		ПунктНазначения 			= Справочники.Локации.ПустаяСсылка();
		
		ЗапросПоРелизу = СоответствиеКоличестваСтрока.Получить(ВыборкаРелизКлиента.Релиз);
		Если ЗапросПоРелизу <> Неопределено Тогда
			ДопустимоеКоличествоСтрок 	= ЗапросПоРелизу.КоличествоКТК;
			НормативноеИспользование 	= ЗапросПоРелизу.СрокИспользованияКТК;
			ПунктОтправления 			= ЗапросПоРелизу.ЛокацияВыдачи;
			ПунктНазначения 			= ЗапросПоРелизу.ЛокацияСдачи; 
		КонецЕсли;	
		
		// Вычтем из допустимого количества строк количество ранее добавленных строк релиза клиента текущей заявки
		Если РежимЗаполнения = "Дозаполнить" Тогда
			Пока Выборка.Следующий() Цикл
				Если Объект.СоставУслуги.НайтиСтроки(Новый Структура("ИдентификаторСтрокиРелизаКлиента", Выборка.ИдентификаторСтрокиРелизаКлиента)).Количество() > 0 Тогда
					ДопустимоеКоличествоСтрок = ДопустимоеКоличествоСтрок - 1;
				КонецЕсли;	
			КонецЦикла;
			
			Выборка.Сбросить();
			
			Если ДопустимоеКоличествоСтрок <= 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;	
		
		ДобавленноеКоличествоСтрок = 0;
		// Евросиб Фролов)
		
		Пока Выборка.Следующий() Цикл
			
			// Евросиб Фролов (06.12.2021 TASK№ №42618, РелизКлиента
			
			// Если нажата кнопка "Дозаполнить...", то не дбавляем ранее добавленные строки
			Если РежимЗаполнения = "Дозаполнить"
				И Объект.СоставУслуги.НайтиСтроки(Новый Структура("ИдентификаторСтрокиРелизаКлиента", Выборка.ИдентификаторСтрокиРелизаКлиента)).Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если ДобавленноеКоличествоСтрок >= ДопустимоеКоличествоСтрок Тогда
				Прервать;
			КонецЕсли;	
			ДобавленноеКоличествоСтрок = ДобавленноеКоличествоСтрок + 1;
			
			// Евросиб Фролов)
			
			СтрокаУслуги = Объект.СоставУслуги.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаУслуги, Выборка);
			
			СтрокаУслуги.НормативноеИспользование 	= НормативноеИспользование;
			СтрокаУслуги.ПунктОтправления 			= ПунктОтправления;
			СтрокаУслуги.ПунктНазначения            = ПунктНазначения;
			
			// ДИТ US 62421 TA 64346 Евсенкин М.А. Начало: 03.02.2023
			СтрокаУслуги.КлючАналитикиПеревозки = НайтиКлючАналитикиПеревозки(СтрокаУслуги).КлючАналитикиПеревозки; 
			// ДИТ US 62421 TA 64346 Евсенкин М.А. Конец: 03.02.2023			
			
			//Если СтрокиЗапроса.Количество() > 0 Тогда
			//	СтрокаУслуги.НормативноеИспользование 	= СтрокиЗапроса[0].СрокИспользованияКТК;
			//	СтрокаУслуги.ПунктОтправления 			= СтрокиЗапроса[0].ЛокацияВыдачи;
			//	СтрокаУслуги.ПунктНазначения 			= СтрокиЗапроса[0].ЛокацияСдачи;
			//КонецЕсли;	
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Евросиб Фролов)
КонецПроцедуры

&НаСервере
Процедура УправлениеФормой()
	// Евросиб Фролов (16.11.2021 TASK №41969 
	//Евросиб СубботинВ #125504 03.12.2025 Начало 
	//ДоступнаРольРаботаСЗаявками = Пользователи.РолиДоступны("dc_РаботаСЗаявками");
	ДоступнаРольРаботаСЗаявками = Пользователи.РолиДоступны("dc_РаботаСЗаявками, dc_ПолныйПросмотрЗаявки");
	//Евросиб СубботинВ #125504 03.12.2025 Конец
	// Если пользователю недоступна роль "Работа с заявками", то редактировать всю форму нельзя
	// (разрешено редактировать только несколько полей в ТЧ "Список запрос на КТК".
	Элементы.ГруппаШапка.ТолькоПросмотр 		= НЕ ДоступнаРольРаботаСЗаявками;
	Элементы.ГруппаУслуги.Видимость 			= ДоступнаРольРаботаСЗаявками;
	Элементы.ГруппаРейсы.Видимость 				= ДоступнаРольРаботаСЗаявками;
	Элементы.ГруппаСостояния.Видимость 			= ДоступнаРольРаботаСЗаявками;
	Элементы.ГруппаДополнительно.Видимость 		= ДоступнаРольРаботаСЗаявками;
	Элементы.ГруппаОтладка.Видимость 			= ДоступнаРольРаботаСЗаявками;
	Элементы.ГруппаОперативныеЗадачи.Видимость 	= ДоступнаРольРаботаСЗаявками;
	Элементы.ГруппаСибур.Видимость 				= Элементы.ГруппаСибур.Видимость И ДоступнаРольРаботаСЗаявками;
	Элементы.ГруппаЛичныеЦели.Видимость 		= ДоступнаРольРаботаСЗаявками;
	
	//Евросиб СубботинВ #125504 03.12.2025 Начало 
	Если РольДоступна("dc_ПолныйПросмотрЗаявки") Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
	КонецЕсли;
	//Евросиб СубботинВ #125504 03.12.2025 Конец

	
	// Евросиб Фролов (06.12.2021 TASK№ №42618, РелизКлиента
	Элементы.СписокЗапросНаКТКСоздатьРелизКлиента.Доступность = Пользователи.РолиДоступны("dc_УчетВагоновКТК");
	
	НастроитьДоступностьПолейЗапросаНаКТК(Элементы.СписокЗапросНаКТК.ПодчиненныеЭлементы);
	// Евросиб Фролов)
	
	// Евросиб Фролов (28.04.2022 Task №50233
	// Колонки с идентификаторами строк отображаем только администратору.
	ПользовательСПолнымиПравами = Пользователи.ЭтоПолноправныйПользователь();
    Элементы.СписокЗапросНаКТКИдентификаторСтроки.Видимость = ПользовательСПолнымиПравами;
	//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -Начало
	//Элементы.ТранспортныеСредстваИдентификаторСтроки.Видимость = ПользовательСПолнымиПравами;
	Элементы.ТранспортныеСредстваКлючАналитикиПеревозки.Видимость = ПользовательСПолнымиПравами;	
	//Элементы.СписокЗапросНаКТКРелизКлиентаТранспортныеСредстваИдентификаторСтроки.Видимость = ПользовательСПолнымиПравами;
	Элементы.ТранспортныеСредстваПоследняяМиляКлючАналитикиПеревозки.Видимость = ПользовательСПолнымиПравами;
	//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -Конец
	// Евросиб Фролов)
	
	//Евросиб - Дубская 14.06.2022 #52244  
	ДанныеПодключения = ?(ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована, 
							Справочники.НастройкиПрограммы.Озон_тестовый, Справочники.НастройкиПрограммы.Озон); 
    Элементы.ДанныеОзон.Видимость = Объект.Контрагент = ДанныеПодключения.Контрагент;  
	//Евросиб - Дубская 14.06.2022 #52244
	
	//Евросиб Коханенко Н.А. 24.01.2025 (( #98939
	Если Объект.ВидПеревозки = Справочники.ВидыПеревозок.ИмпортМоре Тогда 
		Элементы.АвтозагрузкаРейсовИзДХ.Видимость = Истина;
		ПризнакАвтозагрузкиРейсов = РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ПолучитьАналитикуДокумента(Объект.Ссылка,
			ПланыВидовХарактеристик.ДополнительныеАналитикиДокументов.АвтозагрузкаРейсовИзДХ);
		Если ПризнакАвтозагрузкиРейсов <> Неопределено Тогда
			АвтозагрузкаРейсовИзДХ = ПризнакАвтозагрузкиРейсов;
		Иначе
			АвтозагрузкаРейсовИзДХ = Ложь;
		КонецЕсли; 
	Иначе
		Элементы.АвтозагрузкаРейсовИзДХ.Видимость = Ложь;
	КонецЕсли;
	//Евросиб Коханенко Н.А. 24.01.2025 )) #98939
КонецПроцедуры

