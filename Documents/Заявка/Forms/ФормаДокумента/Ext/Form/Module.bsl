&НаСервере
Процедура УстановитьВидимостьПолейПоКонтрагенту() 
	
	ВидимостьЭлементов = Истина;
	
	Если Объект.Контрагент = Константы.КонтрагентДирекцияКонтейнерныхПеревозок.Получить() Тогда
    	ВидимостьЭлементов = Ложь;
	КонецЕсли;
		
	Элементы.СписокЗапросНаКТККомментарийКСрокуИспользованияКТК.Видимость = ВидимостьЭлементов;
	Элементы.СписокЗапросНаКТКВалютаПоДоговору.Видимость = ВидимостьЭлементов;
	Элементы.СписокЗапросНаКТКГруппаСтавка.Видимость = ВидимостьЭлементов;
	Элементы.СписокЗапросНаКТККомментарийКСтавке.Видимость = ВидимостьЭлементов; 
	
	//Евросиб Коханенко Н.А. 04.07.2023 (( #72162
