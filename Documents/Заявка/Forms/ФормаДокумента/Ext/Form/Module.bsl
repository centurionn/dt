// позволяет получить список ктк в строке запроса на ктк содержащей переданный КТК
Функция ПолучитьСоставСтрокиЗапросаПоКТК(НомерКТК) 
	
	СтрокиЗапросаКТК = Объект.СписокЗапросНаКТК.Выгрузить();	
	
	Для Каждого СтрокаЗапроса Из СтрокиЗапросаКТК Цикл
		МассивКтк = Новый Массив();
		МассивТЕ = СтрРазделить(ОбщегоНазначенияВызовСервера.ПривестиСтрокуУчетныхЕдиницКТребуемомуФормату(СтрокаЗапроса.СписокКТК), ";", Ложь);
		
		Для Каждого ЭлемМассива Из МассивТЕ Цикл
			Если ТипЗнч(ЭлемМассива) = Тип("Строка") Тогда
				МассивКтк.Добавить(РаботаСКонтейнерамиСервер.НайтиКТК(ЭлемМассива)); 
			Иначе
				МассивКтк.Добавить(ЭлемМассива);
			КонецЕсли;
		КонецЦикла;	
		
		КолвоКТКвСтрокеЗапроса = МассивТЕ.Количество(); 
		РезПоиска = МассивКтк.Найти(НомерКТК);
		Если РезПоиска <> Неопределено Тогда 
			Возврат Новый Структура("КТК, ПерваяМиля, ПоследняяМиля, ИдентификаторСтроки, КолвоКТК, МассивКТК, РелизКлиента",
			НомерКТК, СтрокаЗапроса.Автоперевозка, СтрокаЗапроса.ПоследняяМиля, СтрокаЗапроса.ИдентификаторСтроки, КолвоКТКвСтрокеЗапроса, МассивКтк, СтрокаЗапроса.РелизКлиента);	
		КонецЕсли;
	КонецЦикла;
	
    Возврат Неопределено

КонецФункции	

&НаКлиенте
Процедура ИзменениеСтрокЗапросаКТК(ОтветПользователя = Неопределено, ДопПараметры = Неопределено) Экспорт
	
	Если ОтветПользователя <> КодВозвратаДиалога.Да Тогда 
		ТекДанные = Элементы.СоставУслуги.ТекущиеДанные;
		
		Если ДопПараметры.ПерваяМиля <> Неопределено Тогда 
			 ТекДанные.ПерваяМиля = ДопПараметры.СтароеЗначение.ПерваяМиля;
		ИначеЕсли ДопПараметры.ПоследняяМиля <> Неопределено Тогда 
			 ТекДанные.ПоследняяМиля = ДопПараметры.СтароеЗначение.ПоследняяМиля;
		 КонецЕсли;
		 Возврат		
	КонецЕсли;
	
	Если ДопПараметры.ПерваяМиля <> Неопределено тогда 
		СтруктураПоискаВЗапросе =  Новый Структура("ИдентификаторСтроки", ДопПараметры.ГуидСтроки);
		НайденныеСтроки = Объект.СписокЗапросНаКТК.НайтиСтроки(СтруктураПоискаВЗапросе);
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			НайденнаяСтрока.Автоперевозка = ДопПараметры.ВыбранноеЗначение;
		КонецЦикла;	
		Для Каждого КТК Из ДопПараметры.МассивКТК Цикл 
			СтруктураПоискаВУслугах =  Новый Структура("НомерКТК", КТК);
			НайденныеСтроки = Объект.СоставУслуги.НайтиСтроки(СтруктураПоискаВУслугах);
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				НайденнаяСтрока.ПерваяМиля = ДопПараметры.ВыбранноеЗначение;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Если ДопПараметры.ПоследняяМиля <> Неопределено тогда 
		СтруктураПоискаВЗапросе =  Новый Структура("ИдентификаторСтроки", ДопПараметры.ГуидСтроки);
		НайденныеСтроки = Объект.СписокЗапросНаКТК.НайтиСтроки(СтруктураПоискаВЗапросе);
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			НайденнаяСтрока.ПоследняяМиля = ДопПараметры.ВыбранноеЗначение;
		КонецЦикла;	
		Для Каждого КТК Из ДопПараметры.МассивКТК Цикл 
			СтруктураПоискаВУслугах =  Новый Структура("НомерКТК", КТК);
			НайденныеСтроки = Объект.СоставУслуги.НайтиСтроки(СтруктураПоискаВУслугах);
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				НайденнаяСтрока.ПоследняяМиля = ДопПараметры.ВыбранноеЗначение;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура УбратьКТКИзЗапросаКТК(ТекСтрока, Удаление = Ложь)
	
	Если Объект.ЗапросНаКТК Тогда
		ИзменяемыйКТК = ТекСтрока.НомерКТК;
		Если ТекСтрока.ПринадлежностьТЕ <> ПредопределенноеЗначение("Перечисление.ПринадлежностьТЕ.КТЕвросиба") Или Удаление Тогда
			ДанныеПоЗапросу = ПолучитьСоставСтрокиЗапросаПоКТК(ИзменяемыйКТК);
			Если НЕ ДанныеПоЗапросу = Неопределено Тогда
				Если НЕ ЗначениеЗаполнено(ДанныеПоЗапросу.РелизКлиента) Тогда
					ГуидСтрокиЗапроса = ДанныеПоЗапросу.ИдентификаторСтроки; 
					ДанныеПоЗапросу.МассивКТК.Удалить(ДанныеПоЗапросу.МассивКТК.Найти(ИзменяемыйКТК));
					СтруктураПоиска = Новый Структура("ИдентификаторСтроки", ГуидСтрокиЗапроса);
					МеняемаяСтрокаЗапроса = Объект.СписокЗапросНаКТК.НайтиСтроки(СтруктураПоиска);
					Для Каждого СтрокаЗапроса из МеняемаяСтрокаЗапроса Цикл
						ЭТС = ""; // Элементы текущей строки
						Для Каждого Стр из ДанныеПоЗапросу.МассивКТК Цикл
							ЭТС = ЭТС + ?(ЭТС = "", "", ";") + Строка(Стр);
						КонецЦикла;				
						СтрокаЗапроса.СписокКТК = ЭТС;
						СтрокаЗапроса.КоличествоКТК = ДанныеПоЗапросу.МассивКТК.Количество(); 
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Функция ОбработкаПроверкиРаспределенияКТК()
	
	Если Объект.ЗапросНаКТК Тогда 
	МассивыКТК = ПолучитьСпискиКонтейнеров();		
		НераспределенныеКТК = ОбщегоНазначенияКлиентСервер.РазностьМассивов(МассивыКТК.КткУслуг, МассивыКТК.КткИзЗапросаНаКТК);
		Если НераспределенныеКТК.Количество() <> 0 тогда
			Возврат	НераспределенныеКТК			
		КонецЕсли;	
	КонецЕсли;
	Возврат Неопределено
	
КонецФункции

&НаКлиенте
Функция ЗадатьВопросПользователю(РезультатПроверки)
	
	СписокКнопок = Новый СписокЗначений;
    СписокКнопок.Добавить(КодВозвратаДиалога.Да, "Разнести автоматически");
    СписокКнопок.Добавить(КодВозвратаДиалога.Нет, "Создать новые запросы на ктк");
