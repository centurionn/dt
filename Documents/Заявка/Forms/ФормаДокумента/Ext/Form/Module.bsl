&НаКлиенте
Процедура Делегировать(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ВыборДелегирования", ЭтаФорма);
	ОткрытьФорму("Справочник.Пользователи.Форма.ФормаВыбора",,,ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборДелегирования(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	Для Сч = 0 По Объект.Состояния.Количество()-1 Цикл
		Если Объект.Состояния[Сч].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение") ИЛИ Объект.Состояния[Сч].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.ВРаботе") Тогда
			Объект.Состояния[Сч].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Новый");
			НСтр = Объект.Состояния.Вставить(Сч);
			НСтр.Состояние = ПредопределенноеЗначение("Справочник.Состояния.ДелегированноеСогласование");
			НСтр.Исполнитель = Параметр1;
			НСтр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение");
			ОбновитьПанельСостояний();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Рецензирование(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаРецензирования", ЭтаФорма);
	ПараметрыФормы = Новый Структура("РецензОбъект", Объект.Ссылка);
	ОткрытьФорму("ОбщаяФорма.РецензированиеПриСогласовании", ПараметрыФормы,,ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаРецензирования(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура СостоянияСтатусСогласованияПриИзменении(Элемент)
	
	ТекД = Элементы.Состояния.ТекущиеДанные;
	Если ТекД <> неопределено Тогда
		ТекД.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Выполнен");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЛистСогласования(Команда)
	
	ТабДок = МаршрутизацияСервер.ПолучитьТабдокЛистаСогласования(Объект.Ссылка);
	ТабДок.Показать();
	
КонецПроцедуры

&НаКлиенте
Процедура СоставУслугиПринадлежностьТЕПриИзменении(Элемент)
	
	// ДИТ US 76659 ТА 77825 Сержантова А.С. Начало: 26.02.2024
	// Было:
	//ТекД = Элементы.СоставУслуги.ТекущиеДанные; 
	//Стало:
	Если ТипЗнч(Элемент) = Тип("ДанныеФормыЭлементКоллекции") Тогда
	    ТекД = Элемент; 
	Иначе
	    ТекД = Элементы.СоставУслуги.ТекущиеДанные;
	КонецЕсли;
	// ДИТ US 76659 ТА 77825 Сержантова А.С. Конец: 26.02.2024
	
	Текд.ВидСобственности = "";
	//Текд.ДатаВзятия = "";
	Если ТекД.ПринадлежностьТЕ = ПредопределенноеЗначение("Перечисление.ПринадлежностьТЕ.КТКлиента") Тогда
		Текд.НормативноеИспользование = "";
	КонецЕсли;
	
	//ДИТ Шевченко А.В. 60130 23.11.2022 -начало
	Если ТекД.ПринадлежностьТЕ = ПредопределенноеЗначение("Перечисление.ПринадлежностьТЕ.КТКлиента") Тогда
		ТекД.ВладелецКТК = Объект.Контрагент;
	ИначеЕсли
		ТекД.ПринадлежностьТЕ = ПредопределенноеЗначение("Перечисление.ПринадлежностьТЕ.КТЕвросиба") Тогда
		ТекД.ВладелецКТК = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
	КонецЕсли;
	//ДИТ Шевченко А.В. 60130 23.11.2022 -конец
	
	// ДИТ 65580 Давудов М.А. Начало: 23.02.2023
	ЗаполнитьСвязанныеПоляПринадлежностьТЕ(ТекД.ПолучитьИдентификатор());
	// ДИТ 65580 Давудов М.А. Конец: 23.02.2023
	
	ОбновитьКаскадныйФильтр();
	
	ВидимостьКолонокПринадлежности(); 
	
	//Субботин 77659 05.12.2023 Начало
	УбратьКТКИзЗапросаКТК(Объект.СоставУслуги.НайтиПоИдентификатору(Элементы.СоставУслуги.ТекущаяСтрока));	
	//Субботин 77659 05.12.2023 Конец
	
КонецПроцедуры

// ДИТ 65580 Давудов М.А. Начало: 23.02.2023
&НаСервере
Процедура ЗаполнитьСвязанныеПоляПринадлежностьТЕ(Знач ДанныеСтроки)
	
	Если ТипЗнч(ДанныеСтроки) <> Тип("Массив") Тогда
		МассивСтрок = Новый Массив;
		МассивСтрок.Добавить(ДанныеСтроки);
	Иначе
		МассивСтрок = ДанныеСтроки;
	КонецЕсли;
	
	Для Каждого ЭлементМассива Из МассивСтрок Цикл
		
		Если ТипЗнч(ЭлементМассива) = Тип("Число") Тогда
			СтрокаТЧ = Объект.СоставУслуги.НайтиПоИдентификатору(ЭлементМассива);
		Иначе
			СтрокаТЧ = ЭлементМассива;
		КонецЕсли;
		
		Если СтрокаТЧ.ПринадлежностьТЕ = Перечисления.ПринадлежностьТЕ.КТКлиента Тогда
			// ДИТ 89973 Давудов М.А. Начало: 21.08.2024
			//ок(
