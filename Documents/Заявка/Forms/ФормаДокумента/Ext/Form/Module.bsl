&НаКлиенте
Процедура ОбработкаВыбораУчЕдиницы(Параметр1 = Неопределено, Параметр2 = Неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	НеобходимПеренос = Ложь;
	
	СписокАктуальныхКТК = Параметр1.СтрокиКонтейнеров;
	Если Параметр1.Свойство("ПереносимыеКТК") тогда
		НеобходимПеренос = Истина;
		СписокКТКДляПереноса =  Параметр1.ПереносимыеКТК;
	КонецЕсли;
		
	Если Параметр2.Свойство("ТЕ") Тогда
		ТекДанные = Элементы.СписокЗапросНаКТК.ТекущиеДанные;
		// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Начало: 21.03.2024
		ОчиститьСвязьСоСтрокойЗапросаВСоставеУслуг(ТекДанные.ИдентификаторСтроки);
		// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Конец: 21.03.2024
		ЭТС = ""; 
		ЭтоПервый = Истина;
		Для Каждого Стр из СписокАктуальныхКТК Цикл
			ЭТС = ЭТС + ?(ЭТС = "", "", ";") + Строка(Стр.УчетнаяЕдиница);
			Если ЭтоПервый тогда 
				ЭтоПервый = Ложь;
				ТекДанные.ТипКТК = Стр.ТипКТК;
				ТекДанные.Автоперевозка = Стр.ПерваяМиля;
				ТекДанные.ПоследняяМиля = Стр.ПоследняяМиля;
			КонецЕсли;
			СтруктураПоиска = Новый Структура("НомерКТК", Стр.УчетнаяЕдиница);
			СтрокиДляЗаполненияРелиза = Объект.СоставУслуги.НайтиСтроки(СтруктураПоиска);
			Для Каждого СтрокаДляЗаполненияРелиза Из СтрокиДляЗаполненияРелиза Цикл 
				Если СтрокаДляЗаполненияРелиза.Релиз <> ТекДанные.РелизКлиента Тогда
					СтрокаДляЗаполненияРелиза.Релиз = ТекДанные.РелизКлиента;
				КонецЕсли;
		КонецЦикла;
		КонецЦикла;
		ТекДанные.СписокКТК = ЭТС;
		ТекДанные.КоличествоКТК = СписокАктуальныхКТК.Количество();
		Если Не ЗначениеЗаполнено(ТекДанные.ИдентификаторСтроки) Тогда
			ТекДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
		// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Начало: 21.03.2024  
		МассивКТКПоСтроке = ПолучитьСписокКткИзЗапросаКТКПоПереданнойСтроке(ТекДанные.НомерСтроки);
		УказатьВСтрокахУслугГУИДСтрокиЗапросаНаКТК(ТекДанные.ИдентификаторСтроки,МассивКТКПоСтроке);
		// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Конец: 21.03.2024
	КонецЕсли;
 
	Если НеобходимПеренос и СписокКТКДляПереноса.Количество()> 0 Тогда
		Для Каждого ПереносимыйКтк Из СписокКТКДляПереноса Цикл
			СтруктураПоиска = Новый Структура("НомерКТК", ПереносимыйКтк);
			СтрокиДляОчистикиРелиза = Объект.СоставУслуги.НайтиСтроки(СтруктураПоиска);
			Для Каждого СтрокаДляОчистки Из СтрокиДляОчистикиРелиза Цикл
				СтрокаДляОчистки.Релиз = Неопределено;
			КонецЦикла; 
		КонецЦикла;	
		ФормированиеСтрокЗапросаКТК(СписокКТКДляПереноса);
	КонецЕсли;	
	
КонецПроцедуры 

&НаКлиенте
Процедура СоставУслугиПоследняяМиляОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если Объект.ЗапросНаКТК Тогда
		СтандартнаяОбработка = Ложь;
		ТекДанные = Элементы.СоставУслуги.ТекущиеДанные;
		ПроверитьИзменениеВариантаАвтоперевозки(, Истина, ВыбранноеЗначение, ТекДанные, СтандартнаяОбработка)
	КонецЕсли;
КонецПроцедуры 

&НаКлиенте
Процедура ПроверитьИзменениеВариантаАвтоперевозки(ПерваяМиля = Неопределено, ПоследняяМиля  = Неопределено, ВыбранноеЗначение, ТекущиеДанные, СтандартнаяОбработка)
	
	ДанныеПоКТКИзЗапроса = ПолучитьСоставСтрокиЗапросаПоКТК(ТекущиеДанные.НомерКТК);	
	Если ДанныеПоКТКИзЗапроса <> Неопределено Тогда 
		
		Если ВыбранноеЗначение <> ?(ПерваяМиля <> Неопределено, ДанныеПоКТКИзЗапроса.ПерваяМиля, ДанныеПоКТКИзЗапроса.ПоследняяМиля)
			и ДанныеПоКТКИзЗапроса.КолвоКТК > 1 Тогда
			ОписаниеОповещения = Новый ОписаниеОповещения("ИзменениеСтрокЗапросаКТК", ЭтаФорма, Новый Структура("ПерваяМиля, ПоследняяМиля, СтароеЗначение, ВыбранноеЗначение, МассивКТК, ГуидСтроки",
			ПерваяМиля, ПоследняяМиля,ТекущиеДанные, ВыбранноеЗначение, ДанныеПоКТКИзЗапроса.МассивКТК, ДанныеПоКТКИзЗапроса.ИдентификаторСтроки));
			
			ПоказатьВопрос(ОписаниеОповещения, "Значение перевозки по данной строке уже было перенесено в Запрос на КТК и сгруппировано с другими строками из Услуг. Хотите изменить все связанные строки?"
			, РежимДиалогаВопрос.ДаНет); 
		КонецЕсли;
	Иначе 
		СтандартнаяОбработка = Истина;
	КонецЕсли;
	
 КонецПроцедуры

 &НаКлиенте
Процедура СоставУслугиПерваяМиляОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если Объект.ЗапросНаКТК Тогда
		СтандартнаяОбработка = Ложь;
		ТекДанные = Элементы.СоставУслуги.ТекущиеДанные;
		ПроверитьИзменениеВариантаАвтоперевозки(Истина,,ВыбранноеЗначение, ТекДанные, СтандартнаяОбработка);
	КонецЕсли;
КонецПроцедуры 

//Функции по работе с контейнерами
&НаСервере
Процедура ФормированиеСтрокЗапросаКТК(СписокКТК = Неопределено, ДополнитьСтроки = Ложь) 

	РезультатЗапроса = Документы.Заявка.ПолучитьКткДляРаспределенияВЗапросНаКТК(Объект.СоставУслуги.Выгрузить(), СписокКТК);

	ВыборкаТипКТК = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"ТипКТК");	
	Пока ВыборкаТипКТК.Следующий() Цикл 
		ВыборкаПерваяМиля =  ВыборкаТипКТК.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"ПерваяМиля");
		Пока ВыборкаПерваяМиля.Следующий() Цикл
			ВыборкаПоследняяМиля =  ВыборкаПерваяМиля.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"ПоследняяМиля");
			Пока ВыборкаПоследняяМиля.Следующий() Цикл
				ВыборкаКтк = ВыборкаПоследняяМиля.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"НомерКТК");
				ПереченьКТК = Новый Массив;
				Пока ВыборкаКтк.Следующий() Цикл
					Если ЗначениеЗаполнено(ВыборкаКтк.НомерКТК) тогда
						ПереченьКТК.Добавить(ВыборкаКтк.НомерКТК);
					КонецЕсли;
				КонецЦикла;
				Если ДополнитьСтроки Тогда
					СтруктураПоискаНужнойСтроки = Новый Структура("ТипКТК,Автоперевозка,ПоследняяМиля",
					ВыборкаТипКТК.ТипКТК,ВыборкаПерваяМиля.ПерваяМиля,ВыборкаПоследняяМиля.ПоследняяМиля);
					ПодходящиеСтроки = Объект.СписокЗапросНаКТК.НайтиСтроки(СтруктураПоискаНужнойСтроки);
					Если ПодходящиеСтроки.Количество() >0 Тогда
						Для Каждого ПодходящаяСтрока Из ПодходящиеСтроки Цикл
							ПодходящаяСтрока.СписокКТК = ПодходящаяСтрока.СписокКТК + ";" + СтрСоединить(ПереченьКТК,";");		
							ПодходящаяСтрока.КоличествоКТК = ПодходящаяСтрока.КоличествоКТК + ПереченьКТК.Количество();
						КонецЦикла;
						// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Начало: 21.03.2024
						УказатьВСтрокахУслугГУИДСтрокиЗапросаНаКТК(ПодходящаяСтрока[0].ИдентификаторСтроки,ПереченьКТК);
						// ДИТ BUG 82599 ТА 82600 Сержантова А.С. Конец: 21.03.2024
					Иначе
						ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Подходящей строки для добавления контенейров с признаками: Тип КТК:  %1, Первая Миля: %2, Последняя Миля: %3 не найдено, был добавлен новый запрос на ктк",
							 ВыборкаТипКТК.ТипКТК,
							 ?(ЗначениеЗаполнено(ВыборкаПоследняяМиля.ПерваяМиля),ВыборкаПоследняяМиля.ПерваяМиля,"(Не указан)"),
							 ?(ЗначениеЗаполнено(ВыборкаПоследняяМиля.ПоследняяМиля),ВыборкаПоследняяМиля.ПоследняяМиля,"(Не указан)")));				
						СтрокаЗапросаКтк = Объект.СписокЗапросНаКТК.Добавить();
						СтрокаЗапросаКтк.СписокКТК = СтрСоединить(ПереченьКТК,";");
						СтрокаЗапросаКтк.КоличествоКТК = ПереченьКТК.Количество();
						СтрокаЗапросаКтк.ТипКТК = ВыборкаТипКТК.ТипКТК;
						СтрокаЗапросаКтк.Автоперевозка = ВыборкаПерваяМиля.ПерваяМиля;
						СтрокаЗапросаКтк.ПоследняяМиля = ВыборкаПоследняяМиля.ПоследняяМиля;			
						Если Не ЗначениеЗаполнено(СтрокаЗапросаКтк.ИдентификаторСтроки) Тогда
							СтрокаЗапросаКтк.ИдентификаторСтроки = Новый УникальныйИдентификатор;
