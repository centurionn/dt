&НаСервереБезКонтекста
Функция ПолучитьМассивКлючейСПустымКонтейнером(МассивКлючей) //ДИТ Шевченко А.В. BUG 75898 TA 75908 10.10.2023
	
	МассивОтвет = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КлючиАналитикиПеревозки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КлючиАналитикиПеревозки КАК КлючиАналитикиПеревозки
		|ГДЕ
		|	КлючиАналитикиПеревозки.Ссылка В(&МассивКлючей)
		|	И КлючиАналитикиПеревозки.Контейнер = ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("МассивКлючей", МассивКлючей);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МассивОтвет.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
	КонецЦикла;	
	
	Возврат МассивОтвет;
	
