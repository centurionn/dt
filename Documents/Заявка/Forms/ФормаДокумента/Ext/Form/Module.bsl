		МассивКТК.Добавить(Стр.НомерКТК);
	КонецЦикла;
	
	РезСобиранияСВВиТДТ = СобратьДанныеСВВиТДТ(МассивКТК);
	
	Для каждого Стр из Объект.СоставУслуги Цикл
		Если НЕ ЗначениеЗаполнено(Стр.НомерКТК) ИЛИ (ТолькоВыбранныйКТК <> неопределено И Стр.НомерКТК <> ТолькоВыбранныйКТК) Тогда Продолжить; КонецЕсли;
		РезСопост = РезСобиранияСВВиТДТ.Получить(Стр.НомерКТК);
		Если РезСопост <> неопределено Тогда
			ЗаполнитьЗначенияСвойств(Стр, РезСопост);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СобратьДанныеСВВиТДТ(СписокКТК)
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	стоки_ТекущиеДанныеСрезПоследних.КТК КАК КТК,
	               |	стоки_ТекущиеДанныеСрезПоследних.тек_СВВ КАК тек_СВВ,
	               |	стоки_ТекущиеДанныеСрезПоследних.тек_КомментарийСВВ КАК тек_КомментарийСВВ,
	               |	стоки_ТекущиеДанныеСрезПоследних.тек_НомерТДТ КАК тек_НомерТДТ
	               |ИЗ
	               |	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних(, КТК В (&СписокКТК)) КАК стоки_ТекущиеДанныеСрезПоследних";
	Запрос.УстановитьПараметр("СписокКТК", СписокКТК);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		Результат.Вставить(Ответ.КТК, Новый Структура("СВВ, КомментарийСВВ, НомерТДТ", Ответ.тек_СВВ, Ответ.тек_КомментарийСВВ, Ответ.тек_НомерТДТ));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции


&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ТребуетсяПеречитатьУказанныйДокумент" И Параметр = Объект.Ссылка Тогда
		ЭтаФорма.Прочитать();
