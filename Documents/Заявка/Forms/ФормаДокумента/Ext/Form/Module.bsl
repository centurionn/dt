&НаКлиенте
Процедура ОбработкаДобавленияНомерныхВагонов(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если параметр1 = Неопределено тогда возврат; КонецЕсли;
	
	//Если параметр1.Поведение = 1 Тогда Объект.СоставУслуги.Очистить(); КонецЕсли;
	//ДИТ, Беляев СЮ, BUG 80907/ TA 80909, 09-02-2024, начало
	Если параметр1.Поведение = 1 Тогда
		УдалитьСтрокиНеВключенныеВСделку();
	КонецЕсли;
	//ДИТ, Беляев СЮ, BUG 80907/ TA 80909, 09-02-2024, конец
	
	Для каждого Стр из параметр1.СтруктураКТК Цикл
		
		НСтр = Объект.СоставУслуги.Добавить();
		НСтр.Услуга = УслугаПоУмолчанию;
		НСтр.Калькуляция = КалькуляцияПоУмолчанию;
		НайдВагонИМодель = ПолучитьВагонИМодель(Стр.НомерВагона);
		НСтр.ТипВагона = НайдВагонИМодель.ТипВагона;
		НСтр.Вагон = НайдВагонИМодель.Вагон;
		НСтр.ГУИДСтроки = Строка(Новый УникальныйИдентификатор());
		// ДИТ US 62421 TA 64346 Евсенкин М.А. Начало: 03.02.2023
		НайтиКлючАналитикиПеревозкиКлиент(НСтр);
		// ДИТ US 62421 TA 64346 Евсенкин М.А. Конец: 03.02.2023
		
	КонецЦикла;
	
КонецПроцедуры

&наСервереБезКонтекста
Функция ПолучитьВагонИМодель(НомерВагона)
	
	Результат = Новый Структура("ТипВагона,Вагон");
	
	Ссылка = Справочники.тс.НайтиПоНаименованию(НомерВагона);
	Результат.Вагон = Ссылка;
	Результат.ТипВагона = Ссылка.ТипТС;
	
	Возврат Результат;
	
КонецФункции


