	ОткрытьФорму("ОбщаяФорма.ВставкаИзБуфераОбмена", Новый Структура("КТК, РазмерКТК, ПоказыватьДатуВзятия, ПередаватьИсходныеНомера, ФорматДаты", Истина, Истина, Истина, Истина, 2), ЭтаФорма.УникальныйИдентификатор,,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
