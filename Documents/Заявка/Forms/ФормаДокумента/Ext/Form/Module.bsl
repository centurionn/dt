&НаКлиенте
Процедура НастроитьОтображениеАвтоперевозки()
	// Евросиб Фролов (28.04.2022 Task №50233
	// Если в строке запроса в поле "Автоперевозка" (заголовок "Кем осуществляется автоперевозка")
	// указано "Силами Евросиб", то скрывать табличные части автоперевозки и на их месте отображать
	// динамические списки с данными из релиза клиента.
	
	ТекущиеДанные = Элементы.СписокЗапросНаКТК.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	АвтоперевозкаСиламиЕвросиб = ТекущиеДанные.Автоперевозка = ПредопределенноеЗначение("Перечисление.ВариантыАвтоперевозки.СиламиЕвросиб");
	
	Элементы.ТранспортныеСредства.Видимость = Не АвтоперевозкаСиламиЕвросиб;
	
	Элементы.СписокЗапросНаКТКРелизКлиентаТранспортныеСредства.Видимость = АвтоперевозкаСиламиЕвросиб;

	Если АвтоперевозкаСиламиЕвросиб Тогда
		Если ЗаполненаАвтоперевозкаРелизаКлиента(ТекущиеДанные.РелизКлиента,ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПерваяМиля")) Тогда			
			Элементы.ГруппаАвтоперевозка.Видимость = Истина;					
			Элементы.ГруппаТранспортныеСредства.Заголовок = "Водители и транспортные средства (из релиза)";
		Иначе
			Элементы.ГруппаАвтоперевозка.Видимость = Ложь;
		КонецЕсли;
	Иначе	
		Элементы.ГруппаАвтоперевозка.Видимость = Истина;
		
		Элементы.ГруппаТранспортныеСредства.Заголовок = "Водители и транспортные средства";
	КонецЕсли;
	
	//ДИТ Шевченко А.В. TASK 51973 02.06.2022 -Начало
	
	АвтоперевозкаПоследняяМиляСиламиЕвросиб = ТекущиеДанные.ПоследняяМиля = ПредопределенноеЗначение("Перечисление.ВариантыАвтоперевозки.СиламиЕвросиб");
	
	Элементы.ТранспортныеСредстваПоследняяМиля.Видимость = Не АвтоперевозкаПоследняяМиляСиламиЕвросиб;
	Элементы.СписокЗапросНаКТКРелизКлиентаТранспортныеСредстваПоследняяМиля.Видимость = АвтоперевозкаПоследняяМиляСиламиЕвросиб;
	Если АвтоперевозкаПоследняяМиляСиламиЕвросиб Тогда
		Если ЗаполненаАвтоперевозкаРелизаКлиента(ТекущиеДанные.РелизКлиента,ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПоследняяМиля")) Тогда			
			Элементы.ГруппаАвтоперевозкаПоследняяМиля.Видимость = Истина;		
			
			Элементы.ГруппаТранспортныеСредстваПоследняяМиля.Заголовок = "Водители и транспортные средства (из релиза)";
		Иначе
			Элементы.ГруппаАвтоперевозкаПоследняяМиля.Видимость = Ложь;
		КонецЕсли;
	Иначе	
		Элементы.ГруппаАвтоперевозкаПоследняяМиля.Видимость = Истина;
		
		Элементы.ГруппаТранспортныеСредстваПоследняяМиля.Заголовок = "Водители и транспортные средства";
	КонецЕсли;
	
	//ДИТ Шевченко А.В. TASK 51973 20.06.2022 -Начало
	Если ТекущиеДанные.Автоперевозка = ПредопределенноеЗначение("Перечисление.ВариантыАвтоперевозки.НеТребуется") 
		ИЛИ НЕ ЗначениеЗаполнено(ТекущиеДанные.Автоперевозка) Тогда
			Элементы.ГруппаАвтоперевозка.Видимость = Ложь;;
	КонецЕсли;
	Если ТекущиеДанные.ПоследняяМиля = ПредопределенноеЗначение("Перечисление.ВариантыАвтоперевозки.НеТребуется") 
		ИЛИ НЕ ЗначениеЗаполнено(ТекущиеДанные.ПоследняяМиля) Тогда
			Элементы.ГруппаАвтоперевозкаПоследняяМиля.Видимость = Ложь;;
	КонецЕсли;	
	//ДИТ Шевченко А.В. TASK 51973 20.06.2022 -Конец
	
	Если Элементы.ГруппаАвтоперевозка.Видимость Тогда
		ЭтаФорма.ПодключитьОбработчикОжидания("УстановитьЗаголовокГруппыАвтоперевозка",1,Ложь);
	Иначе
		ЭтаФорма.ОтключитьОбработчикОжидания("УстановитьЗаголовокГруппыАвтоперевозка");
	КонецЕсли;
	
	Если Элементы.ГруппаАвтоперевозкаПоследняяМиля.Видимость Тогда
		ЭтаФорма.ПодключитьОбработчикОжидания("УстановитьЗаголовокГруппыАвтоперевозкаПоследняяМиля",1,Ложь);
	Иначе
		ЭтаФорма.ОтключитьОбработчикОжидания("УстановитьЗаголовокГруппыАвтоперевозкаПоследняяМиля");	
	КонецЕсли;
	//ДИТ Шевченко А.В. TASK 51973 02.06.2022 -Конец
	// Евросиб Фролов)
КонецПроцедуры	

