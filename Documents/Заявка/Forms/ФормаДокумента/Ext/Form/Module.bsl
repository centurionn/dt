&НаКлиенте
Процедура ОбновитьДанныеВОбщейСтроке()

	ТекДан = Элементы.СоставУслуги.ТекущиеДанные;
	
	Если ТекДан = Неопределено Тогда
	
		Возврат;
	
	КонецЕсли; 

	
	// ДИТ US 62421 TA 64346 Евсенкин М.А. Начало: 20.02.2023
	// Было:  
	//ГУИД = ТекДан.ГУИДСтроки;
	//ИскМасСтр = Объект.ДетализацияПоГрузу.НайтиСтроки(Новый Структура("ГУИДСтроки", ГУИД) );
	//Стало:
	ИскМасСтр = ДетализацияПоГрузу.НайтиСтроки(Новый Структура("КлючАналитикиПеревозки", ТекДан.КлючАналитикиПеревозки) );
	// ДИТ US 62421 TA 64346 Евсенкин М.А. Конец: 20.02.2023
	ВсегоКол = 0; ВсегоВес = 0;
	Для каждого ТекСтрИск Из ИскМасСтр Цикл
	
		Если Не ЗначениеЗаполнено(ТекДан.Груз) Тогда
		
			ТекДан.Груз = ТекСтрИск.Груз;
		
		КонецЕсли; 
		
		Если Не ЗначениеЗаполнено(ТекДан.РодУпаковки) Тогда
		
			ТекДан.РодУпаковки = ТекСтрИск.РодУпаковки;
		
		КонецЕсли; 
		
		ВсегоКол = ВсегоКол + ТекСтрИск.КоличествоМест;
		ВсегоВес = ВсегоВес + ТекСтрИск.ВесГруза;
		
	КонецЦикла; 
	
	Если ВсегоКол <> 0 Тогда
	
		ТекДан.КоличествоМест = ВсегоКол;
	
	КонецЕсли; 
	
	Если ВсегоВес <> 0 Тогда
	
		ТекДан.ВесГрузаНетто = ВсегоВес;
	
	КонецЕсли;
	
КонецПроцедуры

