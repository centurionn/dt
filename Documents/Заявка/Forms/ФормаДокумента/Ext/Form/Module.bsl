&НаКлиенте
Процедура УстановитьОтборТранспортныхСредств()
	// Евросиб Фролов (06.12.2021 TASK№ №42618, РелизКлиента
	ТекущиеДанные = Элементы.СписокЗапросНаКТК.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	//!!!!!!!!! Если обновлять надписи, то не срабатывает событие "При начале редактирования"
	//ДИТ Шевченко А.В. TASK 51973 02.06.2022 -Начало
	//ПодключитьОбработчикОжидания("ОбновитьНадписьТранспортныхСредств", 0.01, Истина);
	//ПодключитьОбработчикОжидания("ОбновитьНадписьПеревозчиков", 0.01, Истина);
	УстановитьЗаголовокГруппыАвтоперевозка();
	УстановитьЗаголовокГруппыАвтоперевозкаПоследняяМиля();
	//ДИТ Шевченко А.В. TASK 51973 02.06.2022 -Конец
	//// В заголовке транспортных средств укажем количество строк
	//ОбновитьНадписьТранспортныхСредств(ТекущиеДанные);
	//
	//// В заголовке перевозчиков укажем количество строк
	//ОбновитьНадписьПеревозчиков(); 
	
	Если ТекущиеДанные.Автоперевозка <> ПредопределенноеЗначение("Перечисление.ВариантыАвтоперевозки.СиламиКлиента") Тогда
		Элементы.ТранспортныеСредства.Доступность = Ложь;
	Иначе
		Элементы.ТранспортныеСредства.Доступность = Истина;
	КонецЕсли;	
	
	ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтрокиЗапроса", ТекущиеДанные.ИдентификаторСтроки);
	Элементы.ТранспортныеСредства.ОтборСтрок = ОтборСтрок;
	
	Если ТекущиеДанные.ПоследняяМиля <> ПредопределенноеЗначение("Перечисление.ВариантыАвтоперевозки.СиламиКлиента") Тогда
		Элементы.ТранспортныеСредстваПоследняяМиля.Доступность = Ложь;
	Иначе
		Элементы.ТранспортныеСредстваПоследняяМиля.Доступность = Истина;
	КонецЕсли;
	
	ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтрокиЗапроса", ТекущиеДанные.ИдентификаторСтроки);
	Элементы.ТранспортныеСредстваПоследняяМиля.ОтборСтрок = ОтборСтрок;
	
	//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -Начало
	ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтрокиЗапроса,ЭтапПеревозки", ТекущиеДанные.ИдентификаторСтроки,ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПерваяМиля"));
	Элементы.СписокЗапросНаКТКРелизКлиентаТранспортныеСредства.ОтборСтрок = ОтборСтрок;
	ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтрокиЗапроса,ЭтапПеревозки", ТекущиеДанные.ИдентификаторСтроки,ПредопределенноеЗначение("Перечисление.ЭтапыПеревозки.ПоследняяМиля"));
	Элементы.СписокЗапросНаКТКРелизКлиентаТранспортныеСредстваПоследняяМиля.ОтборСтрок = ОтборСтрок;
	//ДИТ Шевченко А.В. US 62421 TA 68371 11.04.2023 -Конец
	
	// Обновим доступность кнопки "Дозаполнить" для таб. части "Состав услуг"
	КоличествоДобавленныхСтрокПоРелизу = Объект.СоставУслуги.НайтиСтроки(Новый Структура("ИдентификаторСтрокиРелизаКлиента", ТекущиеДанные.ИдентификаторСтроки)).Количество();
	Если КоличествоДобавленныхСтрокПоРелизу >= ТекущиеДанные.КоличествоКТК Тогда
		Элементы.СоставУслугиДозаполнитьИзЗапросаНаКТК.Доступность = Ложь;
	КонецЕсли;	
	
	// Евросиб Фролов)
	ПодключитьОбработчикОжидания("НастроитьОтображениеАвтоперевозки", 0.01, Истина); // Евросиб Фролов, 28.04.2022 Task №50233
КонецПроцедуры		

