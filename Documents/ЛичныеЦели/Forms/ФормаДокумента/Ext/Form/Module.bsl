&НаКлиенте
Процедура ЗначенияОграниченийПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	ТекД = Элементы.ОграниченияЛичнойЦели.ТекущиеДанные;
	Если ТекД <> неопределено Тогда
		НСтр = Объект.ЗначенияОграничений.Добавить();
		НСтр.Ограничение = ТекД.Ограничение;
	КонецЕсли;
	ОграниченияЛичнойЦелиПриАктивизацииСтроки(неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрольныйПоказательПриИзменении(Элемент)
	ЗаполнитьВыборОграниченийПоЦели();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЗаполнитьВыборОграниченийПоЦели();
	ОбновитьПоказатели(неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПоказатели(Команда)
	
	СтруктураФильтров = Новый Массив;
	Для каждого Стр из Объект.ОграниченияЛичнойЦели Цикл
		
		ЭлСтруктуры = Новый Структура("Ограничение, СписокОтборов", Стр.Ограничение, Новый Массив());
		НайдСтроки = Объект.ЗначенияОграничений.НайтиСтроки(Новый Структура("Ограничение", Стр.Ограничение));
		Для каждого Стр2 из НайдСтроки Цикл
			ЭлСтруктуры.СПисокОтборов.Добавить(Стр2.ЗначениеОтбора);
		КонецЦикла;
		СтруктураФильтров.Добавить(ЭлСтруктуры);
		
	КонецЦикла;
	
	ТЧДетализации.Очистить();
	
	П1 = ЛичныеЦелиСервер.ПолучитьЗначениеПоказателя(Объект.Организация, Объект.КонтрольныйПоказатель, СтруктураФильтров, Объект.НачалоРаботы, Объект.НачалоРаботы, Объект.Ссылка);
	Если ТипЗнч(П1) = Тип("Структура") Тогда
		ЗначениеПоказателяНаНачало = П1.Результат;
	Иначе
		ЗначениеПоказателяНаНачало = П1;
	КонецЕсли;
	
	П2 = ЛичныеЦелиСервер.ПолучитьЗначениеПоказателя(Объект.Организация, Объект.КонтрольныйПоказатель, СтруктураФильтров, Объект.НачалоРаботы, Объект.СрокДостижения, Объект.Ссылка);
	Если ТипЗнч(П2) = Тип("Структура") Тогда
		ЗначениеПоказателяНаКонец = П2.Результат;
		Для каждого Стр из П2.Детализация Цикл
			ЗаполнитьЗначенияСвойств(ТЧДетализации.Добавить() , Стр);
		КонецЦикла;
	Иначе
		ЗначениеПоказателяНаКонец = П2;
	КонецЕсли;
	
	П3 = ЛичныеЦелиСервер.ПолучитьЗначениеПоказателя(Объект.Организация, Объект.КонтрольныйПоказатель, СтруктураФильтров, Объект.НачалоРаботы, ТекущаяДата(), Объект.Ссылка);
	Если ТипЗнч(П3) = Тип("Структура") Тогда
		ЗначениеПоказателяНаСегодня = П3.Результат;
	Иначе
		ЗначениеПоказателяНаСегодня = П3;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчет(Команда)
	
	ОткрытьФорму("Отчет."+Объект.ОтчетДляПроверки+".Форма",,,ЭтаФорма.УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура Детализация(Команда)
	
	МассивПараметров = Новый Массив;
	Для каждого Стр из ТЧДетализации Цикл
		МассивПараметров.Добавить(Новый Структура("Детализация, ЧисловойПоказатель", Стр.Детализация, Стр.ЧисловойПоказатель));
	КонецЦикла;
	ОткрытьФорму("Документ.ЛичныеЦели.Форма.ФормаДетализации", Новый Структура("Детализация", МассивПараметров));
	
КонецПроцедуры

