&НаКлиенте
Процедура Делегировать(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ВыборДелегирования", ЭтаФорма);
	ОткрытьФорму("Справочник.Пользователи.Форма.ФормаВыбора",,,ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборДелегирования(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	Для Сч = 0 По Объект.Состояния.Количество()-1 Цикл
		Если Объект.Состояния[Сч].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение") ИЛИ Объект.Состояния[Сч].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.ВРаботе") Тогда
			Объект.Состояния[Сч].Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Новый");
			НСтр = Объект.Состояния.Вставить(Сч);
			НСтр.Состояние = ПредопределенноеЗначение("Справочник.Состояния.ДелегированноеСогласование");
			НСтр.Исполнитель = Параметр1;
			НСтр.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.НаВыполнение");
			ОбновитьПанельСостояний();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Рецензирование(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаРецензирования", ЭтаФорма);
	ПараметрыФормы = Новый Структура("РецензОбъект", Объект.Ссылка);
	ОткрытьФорму("ОбщаяФорма.РецензированиеПриСогласовании", ПараметрыФормы,,ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаРецензирования(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура СостоянияСтатусСогласованияПриИзменении(Элемент)
	
	ТекД = Элементы.Состояния.ТекущиеДанные;
	Если ТекД <> неопределено Тогда
		ТекД.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Выполнен");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЛистСогласования(Команда)
	
	ТабДок = МаршрутизацияСервер.ПолучитьТабдокЛистаСогласования(Объект.Ссылка);
	ТабДок.Показать();
	
КонецПроцедуры

&НаКлиенте
Процедура ЛичныеЦелиЦельПриИзменении(Элемент)
	
	ТекД = Элементы.ЛичныеЦели.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекД.Цель) Тогда
		ПоказателиЦели = ПолучитьПоказателиЦели(ТекД.Цель);
		ЗаполнитьЗначенияСвойств(ТекД, ПоказателиЦели);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПоказателиЦели(Цель)
	
	Возврат Новый Структура("ЦелевойПоказатель, СпособДостижения", Цель.Норматив, Цель.СпособДостижения);
	
КонецФункции

// +++ БЛОК НОВОЙ МАРШРУТИЗАЦИИ

&НаКлиенте
Функция ПроверитьУказатьОтветственных(РезультатЗапроса, СобытиеПередЗаписью)
	
	ДопСвойстваОбъекта.Очистить();
	ЧтоНужноУказатьВручную = Новый Массив;
	Для каждого Стр из  РезультатЗапроса Цикл
		Исполнитель = Стр.Исполнитель;
		Если НЕ Стр.ТребуетсяУказатьИсполнителя И НЕ ЗначениеЗаполнено(Исполнитель) Тогда Исполнитель = Объект.Автор; КонецЕсли;
		Наблюдатель = Стр.Наблюдатель;
		Если НЕ Стр.ТребуетсяУказатьНаблюдателя И НЕ ЗначениеЗаполнено(Наблюдатель) Тогда Наблюдатель = Объект.Автор; КонецЕсли;
		
		Если Стр.ТребуетсяУказатьИсполнителя ИЛИ Стр.ТребуетсяУказатьНаблюдателя Тогда 
			ЧтоНужноУказатьВручную.Добавить(Новый Структура("Состояние, Исполнитель, Наблюдатель", Стр.Состояние, Исполнитель, Наблюдатель)); 
		КонецЕсли;
	КонецЦикла;
	Если ЧтоНужноУказатьВручную.Количество() > 0 Тогда
		ОпОп = Новый ОписаниеОповещения("ОбработкаУказанияОтветственных", ЭтаФорма, Новый Структура("РезультатЗапроса, СобытиеПередЗаписью", РезультатЗапроса, СобытиеПередЗаписью));
		ПараметрыОтбора = Новый СТруктура;
		ПараметрыОтбора.Вставить("ВыбраннаяМаршрутизация", ЧтоНужноУказатьВручную);
		ОткрытьФорму("Справочник.Маршрутизация.Форма.ФормаЗаполненияСостояний",ПараметрыОтбора,, ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		Если НЕ СобытиеПередЗаписью Тогда ПовторнаяМаршрутизация_сервер(РезультатЗапроса); КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаУказанияОтветственных(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = неопределено Тогда Возврат; КонецЕсли;
	ДопСвойстваОбъекта.ЗагрузитьЗначения(П1);
	Если П2.СобытиеПередЗаписью Тогда
		Записать();
	Иначе
		ПовторнаяМаршрутизация_сервер(П2.РезультатЗапроса);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПовторнаяМаршрутизация_сервер(РезультатЗапроса)
	
	ЭтотОбъектЪ = РеквизитФормыВЗначение("Объект");
	МаршрутизацияСервер.ПрименитьМаршрут(ЭтотОбъектЪ, РезультатЗапроса, Объект.Автор, ДопСвойстваОбъекта);
	ЗначениеВРеквизитФормы(ЭтотОбъектЪ, "Объект");
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ДопСвойстваОбъекта", ДопСвойстваОбъекта);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ДляДанногоОбъектаТребуетсяПеремаршрутизация = ЛОЖЬ;
	Если Объект.Маршрутизировать И ДопСвойстваОбъекта.Количество() = 0 И ДляДанногоОбъектаТребуетсяПеремаршрутизация Тогда
		
		ПараметрыЗапроса = Новый Соответствие;
		ПараметрыЗапроса.Вставить("Организация", Объект.Организация);
		ПараметрыЗапроса.Вставить("СубъектЛичнойЦели", Объект.Сотрудник);
		
		РезультатЗапроса = МаршрутизацияСервер.МаршрутизироватьЛичныеЦели(ПараметрыЗапроса, Объект.Дата);
		Если РезультатЗапроса.Количество() > 0 Тогда
			Отказ = ПроверитьУказатьОтветственных(РезультатЗапроса, Истина);
		КонецЕсли;
		
	КонецЕсли;

	
КонецПроцедуры

&НаКлиенте
Процедура ОграниченияЛичнойЦелиПриАктивизацииСтроки(Элемент)
	
	ТекД = Элементы.ОграниченияЛичнойЦели.ТекущиеДанные;
	Если ТекД <> неопределено Тогда
		Элементы.ЗначенияОграничений.ОтборСтрок = Новый ФиксированнаяСтруктура("Ограничение", ТекД.Ограничение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВыборОграниченийПоЦели()
	
	СВ = Элементы.ОграниченияЛичнойЦелиОграничение.СписокВыбора;
	СВ.Очистить();
	
	Если Объект.КонтрольныйПоказатель = ПредопределенноеЗначение("Перечисление.ЛичныеЦели_СписокКонтрольныхПоказателей.ДебиторкаКоличествоКонтрагентовСПДЗ") Тогда
		
		СВ.Добавить(ПредопределенноеЗначение("Перечисление.ЛичныеЦели_СписокОграничений.ТолькоКонтрагентыВСписке"));
		
	ИначеЕсли Объект.КонтрольныйПоказатель = ПредопределенноеЗначение("Перечисление.ЛичныеЦели_СписокКонтрольныхПоказателей.ДебиторкаОбщаяСуммаПДЗ") Тогда
		
		СВ.Добавить(ПредопределенноеЗначение("Перечисление.ЛичныеЦели_СписокОграничений.ТолькоКонтрагентыВСписке"));
		
	ИначеЕсли Объект.КонтрольныйПоказатель = ПредопределенноеЗначение("Перечисление.ЛичныеЦели_СписокКонтрольныхПоказателей.ДоговорыКоличествоНовыхДоговоров") Тогда
		
		СВ.Добавить(ПредопределенноеЗначение("Перечисление.ЛичныеЦели_СписокОграничений.ТолькоСРегиономДействияДоговораВСписке"));		
		СВ.Добавить(ПредопределенноеЗначение("Перечисление.ЛичныеЦели_СписокОграничений.ТолькоСВидомДоговораВСписке"));		
		СВ.Добавить(ПредопределенноеЗначение("Перечисление.ЛичныеЦели_СписокОграничений.ТолькоСКатегориейДоговораВСписке"));
		
	ИначеЕсли Объект.КонтрольныйПоказатель = ПредопределенноеЗначение("Перечисление.ЛичныеЦели_СписокКонтрольныхПоказателей.ДоговорыКоличествоНовыхПСЦ") Тогда
		
		СВ.Добавить(ПредопределенноеЗначение("Перечисление.ЛичныеЦели_СписокОграничений.ТолькоКонтрагентыВСписке"));		
		СВ.Добавить(ПредопределенноеЗначение("Перечисление.ЛичныеЦели_СписокОграничений.ТолькоСВидомДоговораВСписке"));		
		СВ.Добавить(ПредопределенноеЗначение("Перечисление.ЛичныеЦели_СписокОграничений.ТолькоСКатегориейДоговораВСписке"));		
		СВ.Добавить(ПредопределенноеЗначение("Перечисление.ЛичныеЦели_СписокОграничений.ТолькоСРегиономДействияДоговораВСписке"));		
		
	ИначеЕсли Объект.КонтрольныйПоказатель = ПредопределенноеЗначение("Перечисление.ЛичныеЦели_СписокКонтрольныхПоказателей.ДоговорыКоличествоНовыхТарифовВСистеме") Тогда
		
		СВ.Добавить(ПредопределенноеЗначение("Перечисление.ЛичныеЦели_СписокОграничений.ТолькоКонтрагентыВСписке"));		
