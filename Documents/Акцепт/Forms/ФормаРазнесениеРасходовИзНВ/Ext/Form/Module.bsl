&НаКлиенте
Процедура УслугиИзПТУПриАктивизацииСтроки(Элемент)
	
	РезультатПоиска.Очистить();
	
	ТекДан = Элементы.УслугиИзПТУ.ТекущиеДанные;
	
	//ОтборСтрок = Новый Структура("ИдентификаторСтрокиПоступления", ТекДан.ГУИДПТУ) ;
	//Элементы.ДетализацияАкцепта.ОтборСтрок = Новый ФиксированнаяСтруктура(ОтборСтрок);
	Если ТекДан <> Неопределено Тогда
		
		ДетализацияАкцепта.Параметры.УстановитьЗначениеПараметра("УИДПоступления", ТекДан.ГУИДПТУ);
		ДетализацияАкцепта.Параметры.УстановитьЗначениеПараметра("УИДПоступленияЗап", Истина);
		ДетализацияАкцепта.Параметры.УстановитьЗначениеПараметра("Сделка", ТекДан.Сделка);
	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнитьАкцепт(Команда)
	
	Отказ = Ложь; опОтказа = "";
	ПерезаполнитьАкцептСервер(Отказ, опОтказа);
	
	Если Отказ И опОтказа <> "" Тогда
	
		Сообщить( опОтказа );
	
	КонецЕсли; 
	
	Если Не Отказ Тогда
	
		АкцептАктуализирован = Истина;
	
	КонецЕсли; 
	
КонецПроцедуры

// взято из процедуры процедуры модульОбъекта Акцепт "ЗаполнитьУслуги"
&НаСервере
Процедура ПерезаполнитьАкцептСервер(Отказ, опОтказа)

	ОбАкцепт = Акцепт.ПолучитьОбъект();
	
	ТЧ_ДоОбр = ОбАкцепт.Услуги.Выгрузить(); 
	ТЗСтрокиДляУдаления = УслугиИзПТУ.Выгрузить(,"ТекУИДСтроки"); // ДИТ Поморцева Т.П. Задача 34197 18.02.22.
	
	ОбАкцепт.Услуги.Очистить();
	
	// ДИТ Шевченко А.В. Задача 54792 21.07.22. начало
	МассивГУИДОВПерезаполеныхСтрокПТУ = Новый Массив; 
	// ДИТ Шевченко А.В. Задача 54792 21.07.22. конец
	
	Для каждого Выборка Из УслугиИзПТУ Цикл	
		
		Если Выборка.ВыполненПоискЗатрат И НЕ Выборка.УспехРазнесения Тогда
			
			// ДИТ Шевченко А.В. Задача 54792 21.07.22. начало
			МассивГУИДОВПерезаполеныхСтрокПТУ.Добавить(Выборка.ГУИДПТУ);
			// ДИТ Шевченко А.В. Задача 54792 21.07.22. конец
			
			МассивТС = СтрРазделить(Выборка.СписокТС, ";", Ложь);
			МассивТЕ = СтрРазделить(Выборка.СписокТЕ, ";", Ложь);
			
			НомерНакладной = СокрЛП(Выборка.СписокТД);
