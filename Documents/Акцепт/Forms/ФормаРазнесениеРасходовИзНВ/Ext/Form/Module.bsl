		КонецЕсли;
		// ДИТ Поморцева Т.П. Задача 34197 18.02.22.		
		
		НовСтр = УслугиИзПТУ.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, Стр);
		//Евросиб - АСуслов 13.09.2021 10:08:54 #34198
