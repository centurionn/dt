	//ТЗ = Поступление.Услуги.Выгрузить();
	ТЗ = Акцепт.Услуги.Выгрузить(Новый Структура("ПолностьюРазнесено", Ложь));
	//)
	//Евросиб - АСуслов 13.09.2021 10:08:20 #34198
	
	Для каждого Стр Из ТЗ Цикл
		
