&НаСервере
Процедура ЗаписатьДанныеВСделкуИАкцептСервер(Сделка, АдресТаблицы)
	
	НачатьТранзакцию();
	
	//Заполнение и запись Сделки
	СделкаОбъект = Сделка.ПолучитьОбъект();
	ТаблицаДанных = ПолучитьИзВременногоХранилища(АдресТаблицы);
	
	РаботаСоСделкамиСервер.ДобавитьСтрокиРасходовВСделку(СделкаОбъект, ТаблицаДанных);
	СделкаОбъект.ДополнительныеСвойства.Вставить("ЗаписьИзАкцепта");
	// ДИТ Поморцва Т.П. Задача 243097 16.09.21. начало
	//СделкаОбъект.Записать();
	УстановитьПривилегированныйРежим(Истина);
	СделкаОбъект.Записать();
	РаботаСоСделкамиСервер.СформироватьДвиженияРазнесенияЗатратПТУ(СделкаОбъект);
	СделкаОбъект.Движения.РазнесениеЗатратПТУ.Записать();
	УстановитьПривилегированныйРежим(Ложь);
	// ДИТ Поморцва Т.П. Задача 243097 16.09.21. конец
	
	АкцептОбъект = Акцепт.ПолучитьОбъект();
	//Заполнение и запись ацепта
	Для каждого Стр из ТаблицаДанных Цикл
		
		//Евросиб Каблов 13.09.2022 ( 57446
		//Стр2 = АкцептОбъект.Услуги[Стр.ИсходныйНомерСтроки-1];
		Стр2 = АкцептОбъект.Услуги.Найти(СТр.ИдентификаторСтрокиАкцепта, "ГУИД");
		Если Стр2 = Неопределено Тогда
			ВызватьИсключение "Не удалось добавить расходы в сделку! Акцепт был изменен другим пользователем.";
		КонецЕсли;
		//Евросиб Каблов 13.09.2022 )
			
		Стр2.ИдентификаторСтрокиРасходовВСделке = Стр.ГУИДРасходов;
		Стр2.Сделка = Сделка;
		Стр2.ПолностьюРазнесено = ЗначениеЗаполнено(Сделка);
		Если ЗначениеЗаполнено(Сделка) Тогда
			Стр2.ПривязалПользователь = ПользователиКлиентСервер.ТекущийПользователь();
		Иначе
			Стр2.ПривязалПользователь = Неопределено;
		КонецЕсли;
		
		Стр2.Сумма = Стр2.ПоступлениеСумма;
		Стр2.СуммаНДС = Стр2.ПоступлениеСуммаНДС;
			
	КонецЦикла;
	
	ДополнитьДанные_Сервер(АкцептОбъект, Истина);
	
	АкцептОбъект.СуммаАкцепта = АкцептОбъект.Услуги.Итог("Сумма");
	АкцептОбъект.СуммаНДСАкцепта = АкцептОбъект.Услуги.Итог("СуммаНДС");
	
	Попытка
		АкцептОбъект.Записать(РежимЗаписиДокумента.Проведение);
		ЗафиксироватьТранзакцию();
		Сообщить("Данные сделки " + СделкаОбъект.Ссылка + " и акцепта обновлены!");
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение "Не удалось добавить данные в сделку!";
	КонецПопытки;
	
КонецПроцедуры

