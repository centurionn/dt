		НовСтр.ГУИДПТУ = Стр.ИдентификаторСтрокиПоступления;
		НовСтр.Количество = Стр.ПоступлениеКоличество;
		СтрокаПТУ = Поступление.Услуги.Найти(Стр.ИдентификаторСтрокиПоступления, "ГУИДПТУ");
		//НовСтр.СписокТД = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Стр.ТранспортныйДокумент, "НомерТранспортногоДокумента");
		//НовСтр.СписокТЕ = Стр.Контейнер;
		//НовСтр.СписокТС = Стр.Вагон;
		НовСтр.СписокТД = СтрокаПТУ.СписокТД;
		НовСтр.СписокТЕ = СтрокаПТУ.СписокТЕ;
		НовСтр.СписокТС = СтрокаПТУ.СписокТС;
		НовСтр.Цена = Стр.ПоступлениеЦена;
		НовСтр.Сумма = Стр.ПоступлениеСумма;
		НовСтр.СтавкаНДС = Стр.ПоступлениеСтавкаНДС;
		НовСтр.СуммаНДС = Стр.ПоступлениеСуммаНДС;
		НовСтр.Всего = Стр.ПоступлениеСумма + ?(СуммаВключаетНДС,0,Стр.ПоступлениеСуммаНДС);
		
		//НовСтр.ТекУИДСтроки = Строка(Новый УникальныйИдентификатор);
		НовСтр.ТекУИДСтроки = Стр.ГУИД;
		//)
