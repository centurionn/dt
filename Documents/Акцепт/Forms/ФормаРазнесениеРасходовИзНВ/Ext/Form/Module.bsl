&НаСервереБезКонтекста
Функция ПолучитьСтрДанные(ТЗ, Сделка, ПолеГруппировки)

	РезСтр = "";
	
	ИСК_Мас = ТЗ.НайтиСтроки(Новый Структура("Ссылка", Сделка) );

	Для каждого СтрМас Из ИСК_Мас Цикл
	
		Если РезСтр = "" Тогда
		
			РезСтр = Строка(СтрМас[ПолеГруппировки]);
		
		Иначе
		
			РезСтр = РезСтр+","+Строка(СтрМас[ПолеГруппировки]);
		
		КонецЕсли; 
	
	КонецЦикла; 
	
	Возврат РезСтр;
	
КонецФункции // ()

