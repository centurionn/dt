&НаКлиенте
Процедура УслугиИзПТУСделкаПриИзменении(Элемент)
	
	ТекДан = Элементы.УслугиИзПТУ.ТекущиеДанные;
	
	ДанСделки = ПолучитьДанныеСделки(ТекДан.Сделка);
	
	ЗаполнитьЗначенияСвойств(ТекДан, ДанСделки);
	
	ТекДан.ВыполненПоискЗатрат = Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеСделки(Сделка)
	
	Рез = Новый Структура("Сделка, СписокТС, СписокТЕ, СписокТД");
	
	Запрос = Новый Запрос;
	Запрос.Текст = ЗП_ПоискСделок1();
	
	Запрос.УстановитьПараметр("Ссылка", Сделка);
	Запрос.УстановитьПараметр("НомерЗап", Ложь);
	Запрос.УстановитьПараметр("Номер", "");
	Запрос.УстановитьПараметр("ДатаН", "");
	
	Резы = Запрос.ВыполнитьПакет();
	
	Выборка = Резы[2].Выбрать();
	ТЗ_КТ = Резы[3].Выгрузить();
	ТЗ_ТС = Резы[4].Выгрузить();
	ТЗ_ЖДН= Резы[5].Выгрузить();
	
	Пока Выборка.Следующий() Цикл
		
		Стр_КТ = ПолучитьСтрДанные(ТЗ_КТ, Сделка, "Контейнер");
		Стр_ТС = ПолучитьСтрДанные(ТЗ_ТС, Сделка, "Вагон"); 
		Стр_ЖДН= ПолучитьСтрДанные(ТЗ_ЖДН, Сделка, "НомерЖДН"); 
		
		Рез.Сделка = Сделка;
		Рез.СписокТС = Стр_ТС;
		Рез.СписокТЕ = Стр_КТ;
		Рез.СписокТД = Стр_ЖДН;
		
	КонецЦикла;

	Возврат Рез;
	
КонецФункции

 