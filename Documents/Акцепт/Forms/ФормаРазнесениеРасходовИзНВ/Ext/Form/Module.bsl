&НаКлиенте
Процедура ОбъектУслугиПриАктивизацииСтроки(Элемент)
	
	ТекДан = Элементы.ОбъектУслуги.ТекущиеДанные;
	
	ОтборСтрок = Новый Структура("НомерСтрокиУслуг", ТекДан.НомерСтроки);
	
	Элементы.ДетализацияПоиска.ОтборСтрок = Новый ФиксированнаяСтруктура(ОтборСтрок);
	
КонецПроцедуры

&НаКлиенте
Процедура РазделитьСтроки(Команда)
	
	ТекДан = Элементы.УслугиИзПТУ.ТекущиеДанные;
	
	Если ТекДан = Неопределено Тогда
	
		Сообщить("Не выбрана строка!");
		Возврат;
	
	КонецЕсли; 
	
	ДопПарам = Новый Структура("ИД_Строки", ТекДан.ПолучитьИдентификатор());
	
	ОпОп = Новый ОписаниеОповещения("РазделитьСтроки_ПослеДополнения", ЭтаФорма, ДопПарам);
	Парам = Новый Структура("СписокТД, Номенклатура, СписокТС, СписокТЕ, Всего, БудНомерСделки, ДатаКП, СтанцияОтправления, СтанцияНазначения" ) ;
	ЗаполнитьЗначенияСвойств(Парам, ТекДан);
	ОткрытьФорму("Документ.Акцепт.Форма.ФормаРазнесенияНВ_РазделениеСтрок", Парам, ЭтаФорма, , , ,ОпОп); 
	
КонецПроцедуры

&НаКлиенте
Процедура РазделитьСтроки_ПослеДополнения(РезультатРаботы, ДопПараметры) Экспорт

	Если РезультатРаботы = Неопределено Тогда
	
		Возврат;
	
	КонецЕсли; 

	ТекСтрДоРазделения = УслугиИзПТУ.НайтиПоИдентификатору(ДопПараметры.ИД_Строки);
	
	КолСтрокВМассиве = РезультатРаботы.Количество();
	
	ОпЧисла = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));
	ОпДата = Новый ОписаниеТипов("Дата", ,, Новый КвалификаторыДаты(ЧастиДаты.Дата) );
	
	Если КолСтрокВМассиве = 1 Тогда
	    // Дополняем текущую строку
		ТекЗагрСтр = РезультатРаботы[0];
		
		ДополнитьСтроку(ТекСтрДоРазделения, ТекЗагрСтр, ОпЧисла, ОпДата);
		
	Иначе
		
		НакоплСумм = Новый Структура("Цена, Сумма, СуммаНДС, Всего", 0, 0, 0, 0);
		СтарСумм = Новый Структура("Цена, Сумма, СуммаНДС, Всего");
		ЗаполнитьЗначенияСвойств(СтарСумм, ТекСтрДоРазделения);
		// Выполняем деление:
		СдвигПоКолСтрок = 1;
		Для каждого ТекЗагрСтр Из РезультатРаботы Цикл
		
			НовСтр = УслугиИзПТУ.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, ТекСтрДоРазделения);
			// ДИТ Поморцева Т.П. Задача 34197 06.04.2022. начало
			//НовСтр.ТекУИДСтроки = Строка(Новый УникальныйИдентификатор);
			НовСтр.ТекУИДСтроки = ?(ЗначениеЗаполнено(ТекЗагрСтр.Кол6),Строка(Новый УникальныйИдентификатор),ТекСтрДоРазделения.ТекУИДСтроки);
			// ДИТ Поморцева Т.П. Задача 34197 06.04.2022. конец
			ПереданноеВсего = 0;
			ДополнитьСтроку(НовСтр, ТекЗагрСтр, ОпЧисла, ОпДата, ПереданноеВсего);
			
			Если ПереданноеВсего = 0 Тогда
				
				НовСтр.Цена = НовСтр.Цена / РезультатРаботы.Количество();
				НовСтр.Сумма = НовСтр.Сумма / РезультатРаботы.Количество();
				НовСтр.СуммаНДС = НовСтр.СуммаНДС / РезультатРаботы.Количество();
				НовСтр.Всего = НовСтр.Сумма + НовСтр.СуммаНДС;
				
			КонецЕсли; 
			
			НакоплСумм.Цена = НакоплСумм.Цена + НовСтр.Цена; 
			НакоплСумм.Сумма = НакоплСумм.Сумма + НовСтр.Сумма; 
			НакоплСумм.СуммаНДС = НакоплСумм.СуммаНДС + НовСтр.СуммаНДС;
			НакоплСумм.Всего = НакоплСумм.Всего + НовСтр.Всего;
			
			// Сдвиг:
			НовИД = НовСтр.ПолучитьИдентификатор();
			СтарИД = ДопПараметры.ИД_Строки;
			                      
			УслугиИзПТУ.Сдвинуть( НовИД, -(НовИД-СтарИД)+СдвигПоКолСтрок );
			СдвигПоКолСтрок = СдвигПоКолСтрок + 1;
			
		КонецЦикла; 
		
		// Сравним, суммы (до разделения и после), если есть разница создаем новую строку:
		Если (СтарСумм.Цена - НакоплСумм.Цена) <> 0
			ИЛИ (СтарСумм.Сумма - НакоплСумм.Сумма) <> 0
			ИЛИ (СтарСумм.СуммаНДС - НакоплСумм.СуммаНДС) <> 0
			ИЛИ (СтарСумм.Всего - НакоплСумм.Всего <> 0) Тогда
		
			НовСтр = УслугиИзПТУ.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, ТекСтрДоРазделения);
			НовСтр.ТекУИДСтроки = Строка(Новый УникальныйИдентификатор);
			
			НовСтр.Цена = (СтарСумм.Цена - НакоплСумм.Цена);
			НовСтр.Сумма = (СтарСумм.Сумма - НакоплСумм.Сумма);
			НовСтр.СуммаНДС = (СтарСумм.СуммаНДС - НакоплСумм.СуммаНДС);
			НовСтр.Всего = (СтарСумм.Всего - НакоплСумм.Всего);
			// Подставляем параметрдля переноса остатка в акцепт
			// Иначе данная строка будет пропущена
			НовСтр.ВыполненПоискЗатрат = Истина;
			
			// Сдвиг:
			НовИД = НовСтр.ПолучитьИдентификатор();
			СтарИД = ДопПараметры.ИД_Строки;
			                      
			УслугиИзПТУ.Сдвинуть( НовИД, -(НовИД-СтарИД)+СдвигПоКолСтрок );
		
		КонецЕсли; 
		
		// Удалить строку, которая до разделения:
		УслугиИзПТУ.Удалить( ТекСтрДоРазделения );
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнитьСтроку(ТекСтр, ТекЗагрСтр, ОпЧисла, ОпДата, ПереданноеВсего=0)
	
	Если ТекЗагрСтр.Кол1 <> "" Тогда
		
		ТекСтр.СписокТД = ТекЗагрСтр.Кол1;
		
	КонецЕсли; 
	
	Если ТекЗагрСтр.Кол2 <> "" Тогда
		// Номенклатуру не трогаем
		
		
	КонецЕсли; 
	
	Если ТекЗагрСтр.Кол3 <> "" Тогда
		
		ТекСтр.СписокТС = ТекЗагрСтр.Кол3;
		
	КонецЕсли;
	
	Если ТекЗагрСтр.Кол4 <> "" Тогда
		// кт
		ТекСтр.СписокТЕ = ТекЗагрСтр.Кол4;
		
	КонецЕсли;
	
	Если ТекЗагрСтр.Кол5 <> "" Тогда
		//сум
		НовВсего = ОпЧисла.ПривестиЗначение(ТекЗагрСтр.Кол5);
		Если НовВсего <> 0 Тогда
			
			ПереданноеВсего = НовВсего;
			
			ТекСтр.Всего = НовВсего;
			//++ Зубов А.С., 0235390, 01.07.2021
			//ТекСтр.СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(ТекСтр.Всего, БухгалтерскийУчетОбщиеПроцедурыКлиент.ПолучитьСтавкуНДС(ТекСтр.СтавкаНДС), УчитыватьНДС, СуммаВключаетНДС);
			ТекСтр.СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСуммуНДС(ТекСтр.Всего, БухгалтерскийУчетОбщиеПроцедурыКлиент.ПолучитьСтавкуНДС(ТекСтр.СтавкаНДС), УчитыватьНДС, Истина);
			//-- Зубов А.С., 0235390, 01.07.202
			Если СуммаВключаетНДС Тогда
				
				ТекСтр.Сумма = ТекСтр.Всего;
				
			Иначе
				
				ТекСтр.Сумма = ТекСтр.Всего - ТекСтр.СуммаНДС;
				
			КонецЕсли; 
			
			ТекСтр.Цена = ТекСтр.Сумма / ?(ТекСтр.Количество=0, 1, ТекСтр.Количество);
			
		КонецЕсли; 
		
	КонецЕсли;
	
	Если ТекЗагрСтр.Кол6 <> "" Тогда
		// буд Сделка
		ТекСтр.БудНомерСделки = ТекЗагрСтр.Кол6;
		
	КонецЕсли;
	
	Если ТекЗагрСтр.Кол7 <> "" Тогда
		// дата отпр КП
		ТекСтр.ДатаКП = ПолучитьДатуИзТекста(ТекЗагрСтр.Кол7, ОпДата);
		
	КонецЕсли;
	
	Если ТекЗагрСтр.Кол8 <> "" Тогда
		// Станц. отпр
		НовСт = Локации_сервер.ПолучитьЛокациюПоНечеткомуПоиску(ТекЗагрСтр.Кол8, Истина);
		
		Если НовСт <> ТекСтр.СтанцияОтправления И ЗначениеЗаполнено(НовСт) Тогда
			
			ТекСтр.СтанцияОтправления = НовСт;
			
		КонецЕсли; 
		
	КонецЕсли;
	
	Если ТекЗагрСтр.Кол9 <> "" Тогда
		// Станц. отпр
		НовСт = Локации_сервер.ПолучитьЛокациюПоНечеткомуПоиску(ТекЗагрСтр.Кол9, Истина);
		
		Если НовСт <> ТекСтр.СтанцияНазначения И ЗначениеЗаполнено(НовСт) Тогда
			
			ТекСтр.СтанцияНазначения = НовСт;
			
		КонецЕсли; 
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПолучитьДатуИзТекста(Текст, ОпДата)

	Рез1 = СтрЗаменить(Текст, ".", Символы.ПС);
	Рез2 = СтрЗаменить(Рез1, "/", Символы.ПС);
	Рез3 = СтрЗаменить(Рез2, "\", Символы.ПС);
	Рез4 = СтрЗаменить(Рез3, ",", Символы.ПС);
	Рез5 = СтрЗаменить(Рез4, "-", Символы.ПС);

	Если СтрЧислоСтрок(Рез5) < 3 Тогда
	
		ТекДата = Дата(1,1,1);
	
	Иначе
		
		Д = СокрЛП(СтрПолучитьСтроку(Рез5, 1));
		М = СокрЛП(СтрПолучитьСтроку(Рез5, 2));
		Г = СокрЛП(СтрПолучитьСтроку(Рез5, 3));
		              
		ТекДата = ОпДата.ПривестиЗначение(""+Г+М+Д+"000000");
	
	КонецЕсли; 
	
	Возврат ТекДата;
	
КонецФункции

