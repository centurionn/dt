	УчитыватьНДС = Поступление.УчитыватьНДС;
	СуммаВключаетНДС = Поступление.СуммаВключаетНДС;
	
	Если Не ЗначениеЗаполнено(Поступление) Тогда
	
		Отказ = Истина;
		Возврат;
	
	КонецЕсли; 
	
