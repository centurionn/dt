&НаСервере
Процедура ВыполнитьПоискСделокНаСервере(БудНомерСделки, УИДСтрокиДетализации, ДатаКП, СтОтпр, СтНазн)
	
	Если ЗначениеЗаполнено(БудНомерСделки) Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = ЗП_ПоискСделок1();
		
		Запрос.УстановитьПараметр("Ссылка", "");
		Запрос.УстановитьПараметр("НомерЗап", Истина);
		Запрос.УстановитьПараметр("Номер", "%" + БудНомерСделки);
		Запрос.УстановитьПараметр("ДатаН", НачалоГода(Поступление.Дата));
		//Запрос.Выполнить().Выгрузить(); // Запрос.ВыполнитьПакетСПромежуточнымиДанными()[0].Выгрузить();
		Резы = Запрос.ВыполнитьПакет();
		Выборка = Резы[2].Выбрать();
		ТЗ_КТ = Резы[3].Выгрузить();
		ТЗ_ТС = Резы[4].Выгрузить();
		ТЗ_ЖДН= Резы[5].Выгрузить();
		
		Пока Выборка.Следующий() Цикл
			
			Сделка = Выборка.Ссылка;
			
			Стр_КТ = ПолучитьСтрДанные(ТЗ_КТ, Сделка, "Контейнер");
			Стр_ТС = ПолучитьСтрДанные(ТЗ_ТС, Сделка, "Вагон"); 
			Стр_ЖДН= ПолучитьСтрДанные(ТЗ_ЖДН, Сделка, "НомерЖДН"); 
			
			НовСтр = РезультатПоиска.Добавить();
			НовСтр.НомерСделки			= Выборка.НомерСделки;
			НовСтр.ДатаОтправленияКП	= Выборка.ДатаОтправленияКП;
			НовСтр.СтанцияОтправления	= Выборка.СтанцияОтправления;
			НовСтр.СтанцияНазначения	= Выборка.СтанцияНазначения;
			НовСтр.Накладная			= Стр_ЖДН;
			НовСтр.Вагон				= Стр_ТС;
			НовСтр.Контейнер			= Стр_КТ;
			НовСтр.УИДСтрокиДетализации = УИДСтрокиДетализации;
			НовСтр.Сделка				= Сделка;
		
		КонецЦикла;
	
	ИначеЕсли ЗначениеЗаполнено(ДатаКП) Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = ЗП_ПоискСделок2();
		
		Запрос.УстановитьПараметр("ДатаН", НачалоГода(Поступление.Дата));
		
		Запрос.УстановитьПараметр("ДатаОтправленияКП_1", ДатаКП-(ДиапазонПоиска*24*3600) );
		Запрос.УстановитьПараметр("ДатаОтправленияКП_2", ДатаКП+(ДиапазонПоиска*24*3600) );
		Запрос.УстановитьПараметр("ИспОтпр", ЗначениеЗаполнено(СтОтпр) );
		Запрос.УстановитьПараметр("СтанцияОтправления", СтОтпр);
		Запрос.УстановитьПараметр("ИспНазн", ЗначениеЗаполнено(СтНазн) );
		Запрос.УстановитьПараметр("СтанцияНазначения", СтНазн);
		
		//Запрос.Выполнить().Выгрузить(); // Запрос.ВыполнитьПакетСПромежуточнымиДанными()[0].Выгрузить();
		Резы = Запрос.ВыполнитьПакет();
		Выборка = Резы[2].Выбрать();
		ТЗ_КТ = Резы[3].Выгрузить();
		ТЗ_ТС = Резы[4].Выгрузить();
		ТЗ_ЖДН= Резы[5].Выгрузить();
		
		Пока Выборка.Следующий() Цикл
			
			Сделка = Выборка.Ссылка;
			
			Стр_КТ = ПолучитьСтрДанные(ТЗ_КТ, Сделка, "Контейнер");
			Стр_ТС = ПолучитьСтрДанные(ТЗ_ТС, Сделка, "Вагон"); 
			Стр_ЖДН= ПолучитьСтрДанные(ТЗ_ЖДН, Сделка, "НомерЖДН"); 
			
			НовСтр = РезультатПоиска.Добавить();
			НовСтр.НомерСделки			= Выборка.НомерСделки;
			НовСтр.ДатаОтправленияКП	= Выборка.ДатаОтправленияКП;
			НовСтр.СтанцияОтправления	= Выборка.СтанцияОтправления;
			НовСтр.СтанцияНазначения	= Выборка.СтанцияНазначения;
			НовСтр.Накладная			= Стр_ЖДН;
			НовСтр.Вагон				= Стр_ТС;
			НовСтр.Контейнер			= Стр_КТ;
			НовСтр.УИДСтрокиДетализации = УИДСтрокиДетализации;
			НовСтр.Сделка				= Сделка;
		
		КонецЦикла;
		
	Иначе
		
		Сообщить("Не заданы критерии поиска (номер сделки/дата отправления КП)!");
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗП_ПоискСделок1()

	Текст = "ВЫБРАТЬ ПЕРВЫЕ 20
	        |	Сделка.Ссылка КАК Ссылка,
	        |	Сделка.Номер КАК НомерСделки,
	        |	СделкаРейсы.Рейс КАК Рейс,
	        |	СделкаРейсы.Рейс.ДатаОтправления КАК ДатаОтправленияКП,
	        |	СделкаРейсы.Рейс.ПунктОтправления КАК СтанцияОтправления,
	        |	СделкаРейсы.Рейс.ПунктНазначения КАК СтанцияНазначения
	        |ПОМЕСТИТЬ Сделки
	        |ИЗ
	        |	Документ.Сделка.Рейсы КАК СделкаРейсы
	        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделка
	        |		ПО СделкаРейсы.Ссылка = Сделка.Ссылка
	        |ГДЕ
	        |	(НЕ &НомерЗап И Сделка.Ссылка = &Ссылка) ИЛИ (&НомерЗап И Сделка.Номер ПОДОБНО &Номер
	        |	И Сделка.Дата >= &ДатаН)
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	Сделки.Ссылка КАК Ссылка,
	        |	СделкаСвязьУчетныхЕдиниц.Контейнер КАК Контейнер,
	        |	СделкаСвязьУчетныхЕдиниц.Вагон КАК Вагон,
	        |	СделкаСвязьУчетныхЕдиниц.НомерЖДН КАК НомерЖДН
	        |ПОМЕСТИТЬ УчЕдСделок
	        |ИЗ
	        |	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Сделки КАК Сделки
	        |		ПО СделкаСвязьУчетныхЕдиниц.Ссылка = Сделки.Ссылка
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	Сделки.Ссылка КАК Ссылка,
	        |	Сделки.НомерСделки КАК НомерСделки,
	        |	Сделки.Рейс КАК Рейс,
	        |	Сделки.ДатаОтправленияКП КАК ДатаОтправленияКП,
	        |	Сделки.СтанцияОтправления КАК СтанцияОтправления,
	        |	Сделки.СтанцияНазначения КАК СтанцияНазначения
	        |ИЗ
	        |	Сделки КАК Сделки
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	УчЕдСделок.Ссылка КАК Ссылка,
	        |	УчЕдСделок.Контейнер КАК Контейнер
	        |ИЗ
	        |	УчЕдСделок КАК УчЕдСделок
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	УчЕдСделок.Ссылка,
	        |	УчЕдСделок.Контейнер
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	УчЕдСделок.Ссылка КАК Ссылка,
	        |	УчЕдСделок.Вагон КАК Вагон
	        |ИЗ
	        |	УчЕдСделок КАК УчЕдСделок
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	УчЕдСделок.Ссылка,
	        |	УчЕдСделок.Вагон
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	УчЕдСделок.Ссылка КАК Ссылка,
	        |	УчЕдСделок.НомерЖДН КАК НомерЖДН
	        |ИЗ
	        |	УчЕдСделок КАК УчЕдСделок
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	УчЕдСделок.Ссылка,
