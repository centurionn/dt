&НаСервере
Процедура ПроверитьРазнесение(ДополнениеИнфоСделки=Ложь)

	Для каждого Стр Из Акцепт.Услуги Цикл
	
		Если ЗначениеЗаполнено(Стр.ИдентификаторСтрокиРасходовВСделке)
			И ЗначениеЗаполнено(Стр.Сделка) Тогда
		
			ИскМас = УслугиИзПТУ.НайтиСтроки(Новый Структура("ГУИДПТУ", Стр.ИдентификаторСтрокиПоступления) );
			
			Если ИскМас.Количество() > 0  Тогда
				
				/// сначала проверим, что ВСЕ связанные с Стр ПТУ Услуги разнесены:
				
				ИскМасСтрАкц = Акцепт.Услуги.Выгрузить(Новый Структура("ИдентификаторСтрокиПоступления", Стр.ИдентификаторСтрокиПоступления) );
				
				ВсеРазнесены = Истина;
				Для каждого СтрУслАкц Из ИскМасСтрАкц Цикл
				
					Если Не ЗначениеЗаполнено(СтрУслАкц.ИдентификаторСтрокиРасходовВСделке)
						ИЛИ НЕ ЗначениеЗаполнено(Стр.Сделка) Тогда
					
						ВсеРазнесены = Ложь;
					
					КонецЕсли; 
				
				КонецЦикла; 
				
				Если ВсеРазнесены Тогда
					
					Если ДополнениеИнфоСделки Тогда
						
						ИскМас[0].Сделка = Стр.Сделка;
						ИскМас[0].БудНомерСделки = Стр.Сделка.Номер;
					
					КонецЕсли; 
					
					ИскМас[0].ВыполненПоискЗатрат = Истина;
					ИскМас[0].УспехРазнесения = Истина;
					ИскМас[0].СпособРазнесения = "Полностью разнесено!";
					
				Иначе
					
					ИскМас[0].СпособРазнесения = "Частично разнесено!";
					
				КонецЕсли;
			
			КонецЕсли; 
		
		КонецЕсли; 
	
	КонецЦикла;

КонецПроцедуры
 

