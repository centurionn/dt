&НаКлиенте
Процедура ВнестиИзменения(Команда)
	
	Если Табдок.ВысотаТаблицы = 1 Тогда
	
		ЭтаФорма.Закрыть();
		Возврат
	
	КонецЕсли; 
	 
	Мас = Новый Массив;
	
	Для СчСтр = 2 По Табдок.ВысотаТаблицы Цикл
		
		ДанСтр = Новый Структура;
		
		ДанВСтрокеЕсть = Ложь;
		
		Для СчКол = 1 По Табдок.ШиринаТаблицы Цикл
			
			ТекДан = СокрЛП(Табдок.Область(СчСтр, СчКол).Текст);
			
			Если ТекДан <> "" Тогда
			
				ДанВСтрокеЕсть = Истина;
			
			КонецЕсли; 
			
			ДанСтр.Вставить("Кол"+СчКол, ТекДан);
		
		КонецЦикла; 
		
		Если ДанВСтрокеЕсть Тогда
		
			Мас.Добавить(ДанСтр);
		
		КонецЕсли; 
		
	КонецЦикла; 
	
	ЭтаФорма.Закрыть(Мас);
	
КонецПроцедуры

