
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("СписокТД") Тогда
	
		Табдок.Область(2, 1).Текст = Параметры.СписокТД;
	
	КонецЕсли; 
	
	Если Параметры.Свойство("Номенклатура") Тогда
	
		Табдок.Область(2, 2).Текст = Параметры.Номенклатура;
	
	КонецЕсли; 
	
	Если Параметры.Свойство("СписокТС") Тогда
	
		Табдок.Область(2, 3).Текст = Параметры.СписокТС;
	
	КонецЕсли; 
	
	Если Параметры.Свойство("СписокТЕ") Тогда
	
		Табдок.Область(2, 4).Текст = Параметры.СписокТЕ;
	
	КонецЕсли; 
	
	Если Параметры.Свойство("СписокТЕ") Тогда
	
		Табдок.Область(2, 4).Текст = Параметры.СписокТЕ;
	
	КонецЕсли; 
	
	Если Параметры.Свойство("Всего") Тогда
	
		Табдок.Область(2, 5).Текст = Параметры.Всего;
	
	КонецЕсли;
	
	Если Параметры.Свойство("БудНомерСделки") Тогда
	
		Табдок.Область(2, 6).Текст = Параметры.БудНомерСделки;
	
	КонецЕсли;
	
	Если Параметры.Свойство("ДатаКП") Тогда
	
		Табдок.Область(2, 7).Текст = Параметры.ДатаКП;
	
	КонецЕсли;
	
	Если Параметры.Свойство("СтанцияОтправления") Тогда
	
		Табдок.Область(2, 8).Текст = Параметры.СтанцияОтправления;
	
	КонецЕсли;
	
	Если Параметры.Свойство("СтанцияНазначения") Тогда
	
		Табдок.Область(2, 9).Текст = Параметры.СтанцияНазначения;
	
	КонецЕсли;
	

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры

