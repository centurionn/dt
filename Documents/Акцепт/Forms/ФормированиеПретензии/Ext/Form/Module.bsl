&НаКлиенте
Процедура ВыделитьПретензионнуюСоставляющую(Команда)
	
	//Евросиб Каблов 11.06.2021 ( Ticket#0229012
	//Если НЕ ЗначениеЗаполнено(КоличествоПретензии) ИЛИ НЕ ЗначениеЗаполнено(ПретензионнаяСумма) ИЛИ НЕ ЗначениеЗаполнено(ПричинаПретензии) Тогда
	Если НЕ ЗначениеЗаполнено(ПретензионнаяСумма) ИЛИ НЕ ЗначениеЗаполнено(ПричинаПретензии) Тогда
	//Евросиб Каблов 11.06.2021 )
		ПоказатьПредупреждение(, "Необходимо заполнить помеченные красной линией поля!");
		Возврат;
	КонецЕсли;
	
	Закрыть(Новый Структура("ПризнанноеКоличество, ПризнаннаяСумма, ПретензионноеКоличество, ПретензионнаяСумма, ПричинаПретензии", ПризнаваемоеКоличество, ПризнаваемаяСумма, КоличествоПретензии, ПретензионнаяСумма, ПричинаПретензии));
	
КонецПроцедуры

&НаКлиенте
Процедура ПризнаваемоеКоличествоПриИзменении(Элемент)
	
	//Евросиб Каблов 11.06.2021 ( Ticket#0229012
	//ПризнаваемаяСумма = ИсходнаяСумма / ИсходноеКоличество * ПризнаваемоеКоличество;
	//КоличествоПретензии = ИсходноеКоличество - ПризнаваемоеКоличество;
	//ПретензионнаяСумма = ИсходнаяСумма - ПризнаваемаяСумма;
	Если ПризнаваемоеКоличество = 1 Тогда
		ПризнаваемаяСумма = ИсходнаяСумма;
		КоличествоПретензии = 0;
		ПретензионнаяСумма = 0;
	КонецЕсли;
	//Евросиб Каблов 11.06.2021 )
	
КонецПроцедуры

&НаКлиенте
Процедура ПризнаваемаяСуммаПриИзменении(Элемент)
	
	//Евросиб Каблов 11.06.2021 ( Ticket#0229012
	Если ПризнаваемаяСумма > ИсходнаяСумма Тогда
		ПризнаваемаяСумма = ИсходнаяСумма;
	КонецЕсли;	
	//Евросиб Каблов 11.06.2021 )
	
	ПретензионнаяСумма = ИсходнаяСумма - ПризнаваемаяСумма;
	
	//Евросиб Каблов 11.06.2021 ( Ticket#0229012
	Если ЗначениеЗаполнено(ПризнаваемаяСумма) Тогда
		КоличествоПретензии = 0;
		ПризнаваемоеКоличество = 1;
	Иначе
		КоличествоПретензии = 1;
		ПризнаваемоеКоличество = 0;
	КонецЕсли;
	//Евросиб Каблов 11.06.2021 )
	
КонецПроцедуры

&НаКлиенте
Процедура КоличествоПретензииПриИзменении(Элемент)
	
	//Евросиб Каблов 11.06.2021 ( Ticket#0229012
	//ПретензионнаяСумма = ИсходнаяСумма / ИсходноеКоличество * КоличествоПретензии;
	//ПризнаваемоеКоличество = ИсходноеКоличество - КоличествоПретензии;
	//ПризнаваемаяСумма = ИсходнаяСумма - ПретензионнаяСумма;
	Если КоличествоПретензии = 1 Тогда
		ПретензионнаяСумма = ИсходнаяСумма;
		ПризнаваемоеКоличество = 0;
		ПризнаваемаяСумма = 0;
	КонецЕсли;
	//Евросиб Каблов 11.06.2021 ) 
	
КонецПроцедуры

&НаКлиенте
Процедура ПретензионнаяСуммаПриИзменении(Элемент)
	
	//Евросиб Каблов 11.06.2021 ( Ticket#0229012
	Если ПретензионнаяСумма > ИсходнаяСумма Тогда
		ПретензионнаяСумма = ИсходнаяСумма;
	КонецЕсли;	
	//Евросиб Каблов 11.06.2021 )
	
	ПризнаваемаяСумма = ИсходнаяСумма - ПретензионнаяСумма;
	
	//Евросиб Каблов 11.06.2021 ( Ticket#0229012
	Если ЗначениеЗаполнено(ПризнаваемаяСумма) Тогда
		КоличествоПретензии = 0;
		ПризнаваемоеКоличество = 1;
	Иначе
		КоличествоПретензии = 1;
		ПризнаваемоеКоличество = 0;
	КонецЕсли;
	//Евросиб Каблов 11.06.2021 )
	
КонецПроцедуры

