Функция ПреобразоватьНДСВРИТМ(СтавкаНДС, НДСВключенВСтоимость)
	
	РезультатТаблица = Новый ТаблицаЗначений;
	РезультатТаблица.Колонки.Добавить("СтавкаНДС", Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	РезультатТаблица.Колонки.Добавить("НДСВключен", Новый ОписаниеТипов("Булево"));
	РезультатТаблица.Колонки.Добавить("Формулировка", Новый ОписаниеТипов("Строка"));
	
	НСтр = РезультатТаблица.Добавить(); НСтр.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС; НСтр.НДСВключен = Истина; НСтр.Формулировка 	= "Без НДС";
	НСтр = РезультатТаблица.Добавить(); НСтр.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС; НСтр.НДСВключен = Ложь; НСтр.Формулировка 		= "Без НДС";
	
