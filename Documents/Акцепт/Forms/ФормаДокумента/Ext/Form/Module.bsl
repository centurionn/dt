&НаКлиенте
Процедура н_ДобавитьДоходыИРасходыДопУслугой(Команда)
	
	МассивВыделенныхСтрок = СобратьМассивВыделенныхСтрок();
	Если МассивВыделенныхСтрок.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Выделите строки для переноса и повторите попытку!");
		Возврат;
	КонецЕсли;
	ОпОп = Новый ОписаниеОповещения("ОбработкаДобавленияВСделку", ЭтаФорма, Новый Структура("ВариантРазнесения", ПредопределенноеЗначение("Перечисление.ВариантыРазнесенияЗатрат.ДоходыИРасходыДополнительнойУслугой")));
	ОткрытьФорму("Документ.Сделка.Форма.ФормаДобавленияРасходовВСделку", Новый Структура("ДоходыРасходыОтдельнойУслугой, СписокСтрок", Истина, МассивВыделенныхСтрок),,ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура н_ДобавитьРасходыПоПеревозкеКлиента(Команда)
	
	МассивВыделенныхСтрок = СобратьМассивВыделенныхСтрок();
	Если МассивВыделенныхСтрок.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Выделите строки для переноса и повторите попытку!");
		Возврат;
	КонецЕсли;   
	// ДИТ US 72035 ТА 72037 Сержантова А.С. Начало: 14.07.2023 
	СтрокиБезВагонаКонтейнера = Новый Массив;
	Для каждого ВыделеннаяСтрока Из МассивВыделенныхСтрок Цикл
		Если не ЗначениеЗаполнено(ВыделеннаяСтрока.Вагон) 
			и не ЗначениеЗаполнено(ВыделеннаяСтрока.КТК) Тогда
		    СтрокиБезВагонаКонтейнера.Добавить(ВыделеннаяСтрока.НомерСтроки);
		КонецЕсли;
	КонецЦикла;
	Если СтрокиБезВагонаКонтейнера.Количество() Тогда
		ТекстСообщения = СтрШаблон("В %1 №%2 не указан контейнер или вагон. Введите детализацию и повторите попытку.", 
		                ?(СтрокиБезВагонаКонтейнера.Количество()=1, "строке", "строках"),
						СтрСоединить(СтрокиБезВагонаКонтейнера, ", "));
		ПоказатьПредупреждение(,ТекстСообщения, , "Не заполнены вагоны/контейнеры");
		Возврат;
	КонецЕсли;
	// ДИТ US 72035 ТА 72037 Сержантова А.С. Конец: 14.07.2023
	ОпОп = Новый ОписаниеОповещения("ОбработкаДобавленияВСделку", ЭтаФорма, Новый Структура("ВариантРазнесения", ПредопределенноеЗначение("Перечисление.ВариантыРазнесенияЗатрат.РасходыПоПеревозкеКлиента")));

	ОткрытьФорму("Документ.Сделка.Форма.ФормаДобавленияРасходовВСделку", Новый Структура("РасходыПоПеревозкеКлиента, СписокСтрок", Истина, МассивВыделенныхСтрок),,ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	//Евросиб(ДИТ), Беляев СЮ, BUG 102612 / TA 114549, 17-07-2025, начало
	Если Объект.Услуги.Количество() > 500 Тогда
		ВремяИсключенияВМинутах = 60;
		ВключитьБлокировкуОчередиОтложенногоИзмененияНаСервере( Объект.Ссылка, ВремяИсключенияВМинутах );
		ОбновлениеТаймераИсключенияОчередиОтложенногоИзменения();
	КонецЕсли;
	//Евросиб(ДИТ), Беляев СЮ, BUG 102612 / TA 114549, 17-07-2025, конец
	
КонецПроцедуры

