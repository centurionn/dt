&НаСервере
Функция ПолучитьДоходыСделки(ОткрытыйПериодВО)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УслугиАкцепта.ГУИД КАК ГУИД,
		|	УслугиАкцепта.Сделка КАК Сделка,
		|	УслугиАкцепта.ИдентификаторСтрокиРасходовВСделке КАК ИдентификаторСтрокиРасходовВСделке
		|ПОМЕСТИТЬ ВТУслугиАкцепта
		|ИЗ
		|	&УслугиАкцепта КАК УслугиАкцепта
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТУслугиАкцепта.ГУИД КАК ГУИДАкцепта,
		|	СделкаСвязьДоходовИРасходов.Доходы КАК Доходы,
		|	СделкаСвязьДоходовИРасходов.Расходы КАК Расходы
		|ИЗ
		|	ВТУслугиАкцепта КАК ВТУслугиАкцепта
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьДоходовИРасходов КАК СделкаСвязьДоходовИРасходов
		|		ПО ВТУслугиАкцепта.Сделка = СделкаСвязьДоходовИРасходов.Ссылка
		|			И ВТУслугиАкцепта.ИдентификаторСтрокиРасходовВСделке = СделкаСвязьДоходовИРасходов.Расходы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.Доходы КАК СделкаДоходы
		|		ПО (СделкаСвязьДоходовИРасходов.Ссылка = СделкаДоходы.Ссылка)
		|			И (СделкаСвязьДоходовИРасходов.Доходы = СделкаДоходы.ГУИД)
		|			И (СделкаДоходы.УчДокумент ССЫЛКА Документ.ОтчетКомитентуОПродажах)";
		//|			И (ВЫРАЗИТЬ(СделкаДоходы.УчДокумент КАК Документ.ОтчетКомитентуОПродажах).ПериодВО < &ОткрытыйПериодВО)"; //Евросиб(ДИТ), Беляев СЮ, US 113662 / TA 115172, 01-08-2025, закомментировал (для открытого периода тоже надо)
		
	Запрос.УстановитьПараметр("УслугиАкцепта", Объект.Услуги.Выгрузить(,"ГУИД,Сделка,ИдентификаторСтрокиРасходовВСделке"));
	Запрос.УстановитьПараметр("ОткрытыйПериодВО", ОткрытыйПериодВО);
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
КонецФункции
