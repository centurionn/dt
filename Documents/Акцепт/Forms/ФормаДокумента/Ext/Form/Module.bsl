&НаСервереБезКонтекста
Функция ПолучитьАдресТаблицыНоменклатурыПоступления(Поступление)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПервыеСтрокиПоНоменклатуре.Номенклатура КАК Номенклатура,
		|	ПоступлениеТоваровУслугУслуги.СтавкаНДС КАК СтавкаНДС
		|ИЗ
		|	(ВЫБРАТЬ
		|		МИНИМУМ(ПоступлениеТоваровУслугУслуги.НомерСтроки) КАК НомерСтроки,
		|		ПоступлениеТоваровУслугУслуги.Номенклатура КАК Номенклатура,
		|		ПоступлениеТоваровУслугУслуги.Ссылка КАК Ссылка
		|	ИЗ
		|		Документ.ПоступлениеТоваровУслуг.Услуги КАК ПоступлениеТоваровУслугУслуги
		|	ГДЕ
		|		ПоступлениеТоваровУслугУслуги.Ссылка = &Ссылка
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ПоступлениеТоваровУслугУслуги.Номенклатура,
		|		ПоступлениеТоваровУслугУслуги.Ссылка) КАК ПервыеСтрокиПоНоменклатуре
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.Услуги КАК ПоступлениеТоваровУслугУслуги
		|		ПО ПервыеСтрокиПоНоменклатуре.Ссылка = ПоступлениеТоваровУслугУслуги.Ссылка
		|			И ПервыеСтрокиПоНоменклатуре.Номенклатура = ПоступлениеТоваровУслугУслуги.Номенклатура
		|			И ПервыеСтрокиПоНоменклатуре.НомерСтроки = ПоступлениеТоваровУслугУслуги.НомерСтроки";
	
	Запрос.УстановитьПараметр("Ссылка", Поступление);
	
	ТаблицаНоменклатуры = Запрос.Выполнить().Выгрузить();
	Возврат ПоместитьВоВременноеХранилище(ТаблицаНоменклатуры, Новый УникальныйИдентификатор);	
	
КонецФункции

