	ДоступныеТипыЛокаций = НоменклатураСервер.ПолучитьДоступныеТипыЛокацийПоНоменклатуре(ТекДанные.Номенклатура);
	Если ЗначениеЗаполнено(ДоступныеТипыЛокаций) Тогда
		
		Если ЗначениеЗаполнено(ТекДанные.СтанцияОтправления) Тогда
			Если ДоступныеТипыЛокаций.Найти(ТекДанные.СтанцияОтправления.Тип) = Неопределено Тогда
				ТекДанные.СтанцияОтправления = ЛокацииПустаяСсылка;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекДанные.СтанцияНазначения) Тогда
			Если ДоступныеТипыЛокаций.Найти(ТекДанные.СтанцияНазначения.Тип) = Неопределено Тогда
				ТекДанные.СтанцияНазначения = ЛокацииПустаяСсылка;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

