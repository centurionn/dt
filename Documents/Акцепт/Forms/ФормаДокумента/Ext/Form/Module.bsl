Процедура ПеречитатьПериоды(Команда)

	ПеречитатьПериодыСервер();
	
КонецПроцедуры

&НаСервере
Процедура ПеречитатьПериодыСервер()
	
	ТекущийПериодВО = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериод(Объект.Организация);
	//Евросиб Каблов 09.04.2025 ( #105407
	//ТекущийПериодБУ = Константы.ДатаПериодаЗагрузкиОДВУПП.Получить();
	ТекущийПериодБУ = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериодБУ(Объект.Организация);
	//Евросиб Каблов 09.04.2025 )
	
	РеквизитыСФ = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьРеквизитыСчетФактуры(Объект.Поступление,"СчетФактураПолученный");
	Если РеквизитыСФ <> Неопределено Тогда
		ДатаВСФ = РеквизитыСФ.ДатаВходящегоДокумента;
	Иначе
		ДатаВСФ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Поступление, "ДатаВходящегоДокумента");
	КонецЕсли;
	ТекущийПериодВО = Макс(ТекущийПериодВО, НачалоМесяца(ДатаВСФ));
	ТекущийПериодБУ = Макс(ТекущийПериодБУ, НачалоМесяца(ДатаВСФ));
	
	Если ТекущийПериодБУ <> Объект.ПериодБУ Или ТекущийПериодВО <> Объект.ПериодВО Тогда
		Объект.ПериодБУ = ТекущийПериодБУ;
		Объект.ПериодВО = ТекущийПериодВО;
		ДополнитьДанные_Сервер(Истина);
	КонецЕсли;
	
КонецПроцедуры

