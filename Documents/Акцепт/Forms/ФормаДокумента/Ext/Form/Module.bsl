&НаСервере
Процедура ВернутьВРИТМПретензииНаСервере(НеЗаписан)
	
	Если НеЗаписан Тогда
		АкцептПровелся = Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
		Если Не АкцептПровелся Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести акцепт. Выгрузка строк в РИТМ не выполнена.");
			Возврат;
		КонецЕсли;
	КонецЕсли; 

	Результат = ПретензииИНеакцептыСервер.ПредоставитьДанныеНеакцептовПоПериодуИлиНомеруДокумента(Объект.Номер, неопределено, неопределено, Истина, Объект.Ссылка);
	
	РезультатXML = "<xml>" + Символы.ПС + "<claims>" + Символы.ПС;
	
	Для каждого Стр из Результат Цикл
		
		РезультатXML = РезультатXML + "<claim pmRfCode=""" + Стр.pmRfCode + """ pmtRFC=""" + 
		Стр.pmtRFC + """ pmtObjDate=""" + Стр.pmtObjDate + """ pmtObjSum=""" + 
		Формат(Стр.pmtObjSum, "ЧН=; ЧГ=; ЧРД=.") + """ vSymCode=""" + Стр.vSymCode + """ pmtErrCodes=""" + 
		Стр.pmtErrCodes + """ pmtErrText=""" + Стр.pmtErrText + """ pmtObjFulfilment=""" + 
		Стр.pmtObjFulfilment + """ pmtNotes=""" + Стр.pmtNotes + """ pmtIsActual=""" + ?(Строка(Стр.pmtObjFulfilment) = "На рассмотрении", 1, 0) + """ />";
		
	КонецЦикла;
	
	РезультатXML = РезультатXML + "</claims>" + Символы.ПС + "</xml>";
		
	РЕЗ = ВебСервисы_сервер.ЗапроситьРИТМ("DCLoadClaims", РезультатXML);
	
КонецПроцедуры

