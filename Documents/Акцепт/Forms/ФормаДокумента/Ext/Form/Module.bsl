&НаКлиенте
Процедура ОбработкаВставкиExcel(Список, ДополнительныеПараметры) Экспорт
	
	Если Список <> Неопределено И ДополнительныеПараметры <> неопределено Тогда
		ИмяРеквизитаОтбора = Неопределено;
		Если ДополнительныеПараметры.Свойство("ИмяРеквизитаОтбора", ИмяРеквизитаОтбора) Тогда
			Если ИмяРеквизитаОтбора = "Вагоны" Тогда
				Вагон = СтрСоединить(Список, ";");
				Вагоны.ЗагрузитьЗначения(ПолучитьСписокВагонов(Список));
			ИначеЕсли ИмяРеквизитаОтбора = "Контейнеры" Тогда
				Контейнер = СтрСоединить(Список, ";");
				Контейнеры.ЗагрузитьЗначения(ПолучитьСписокКонтейнеров(Список));
			ИначеЕсли ИмяРеквизитаОтбора = "Накладные" Тогда
				Накладная = СтрСоединить(Список, ";");
				Накладные.ЗагрузитьЗначения(ПолучитьСписокНакладных(Список));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	УстановитьОтборТаблицыУслуг();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокВагонов(Номера)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТС.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ТС КАК ТС
		|ГДЕ
		|	ТС.Наименование В (&Номера)";
	
	Запрос.УстановитьПараметр("Номера", Номера);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСписокКонтейнеров(Наименования)
	
	ТаблицаНомеров = Новый ТаблицаЗначений;
	ТаблицаНомеров.Колонки.Добавить("Префикс", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(4, ДопустимаяДлина.Переменная)));
	ТаблицаНомеров.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(6, ДопустимаяДлина.Переменная)));
	ТаблицаНомеров.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(11, ДопустимаяДлина.Переменная)));
	
	Для каждого Наименование Из Наименования Цикл	
		СтрокаТаблицы = ТаблицаНомеров.Добавить();
		СтрокаТаблицы.Префикс = Лев(ВРег(Наименование), 4);
		СтрокаТаблицы.Номер = Сред(Наименование, 5, 6);
		СтрокаТаблицы.Наименование = Наименование;
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаНомеров.Префикс КАК Префикс,
		|	ТаблицаНомеров.Номер КАК Номер
		|ПОМЕСТИТЬ ВТНомера
		|ИЗ
		|	&ТаблицаНомеров КАК ТаблицаНомеров
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТЕ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ТЕ КАК ТЕ
		|ГДЕ
		|	(ТЕ.Префикс, ТЕ.Номер) В
		|			(ВЫБРАТЬ
		|				ВТНомера.Префикс КАК Префикс,
		|				ВТНомера.Номер КАК Номер
		|			ИЗ
		|				ВТНомера КАК ВТНомера)";
	
	Запрос.УстановитьПараметр("ТаблицаНомеров", ТаблицаНомеров);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСписокНакладных(Номера)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТранспортныйДокумент.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
		|ГДЕ
		|	ТранспортныйДокумент.НомерТранспортногоДокумента В(&Номера)
		|	И ТранспортныйДокумент.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийТранспортныхДокументов.ЖДНакладная)";
	
	Запрос.УстановитьПараметр("Номера", Номера);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

&НаКлиенте
Процедура НакладнаяПриИзменении(Элемент)
	
	Накладная = СокрЛП(Накладная);
	Если ЗначениеЗаполнено(Накладная) Тогда
		Список = СтрРазделить(Накладная, ";", Ложь);
		Накладные.ЗагрузитьЗначения(ПолучитьСписокНакладных(Список));
	Иначе
		Накладные.Очистить();
	КонецЕсли;
	
	УстановитьОтборТаблицыУслуг();
	
