//Евросиб Пирожкова( 30.07.2025 Ticket№0406736 
&НаКлиенте
Процедура ПроверитьВыгрузкуВУПП(Команда)
	
	Отказ = Ложь;
	
	ОчиститьСообщения();
	
	НеЗаписан = ЭтаФорма.Модифицированность или Не Объект.Проведен;
	ОповещениеОтветаВопроса = Новый ОписаниеОповещения("ОбработкаВопросаВыгрузка", ЭтаФорма, НеЗаписан);
	Если НеЗаписан Тогда
		ПоказатьВопрос(ОповещениеОтветаВопроса, "Перед выгрузкой акцепта его необходимо провести. Продолжить?", РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Нет);
	Иначе		
		ОбработкаВопросаВыгрузка(КодВозвратаДиалога.Да, НеЗаписан); 
		ПроверитьВыгрузкуВУППСервер();
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ОбработкаВопросаВыгрузка(Ответ = неопределено, НеЗаписан) Экспорт
	
	Если Не Ответ = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Если НеЗаписан Тогда
		АкцептПровелся = Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
		Если Не АкцептПровелся Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести акцепт.");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ПроверитьВыгрузкуВУППСервер()

	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ПроверитьВыгрузкуВУПП();
	
КонецПроцедуры
