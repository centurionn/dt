Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Для каждого Стр из ТекущийОбъект.Услуги Цикл
		Если Стр.Номенклатура.ТребоватьОбязательногоЗаполненияЛокацийВАкцепте = Истина И (НЕ ЗначениеЗаполнено(Стр.СтанцияОтправления) ИЛИ НЕ ЗначениеЗаполнено(Стр.СтанцияНазначения)) Тогда
			Сообщить("По номенклатуре " + Стр.Номенклатура + " обязательно требуется заполнить пункт отправления и назначения! Акцепт не будет записан!", СтатусСообщения.ОченьВажное);
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	
	//Евросиб Каблов 07.09.2022 ( US49022
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Акцепт.Дата КАК Дата,
	|	Акцепт.Ссылка КАК Ссылка,
	|	Акцепт.Представление КАК Представление,
	|	0 КАК Порядок
	|ИЗ
	|	Документ.Акцепт КАК Акцепт
	|ГДЕ
	|	Акцепт.Поступление = &Поступление
	|	И Акцепт.ПериодВО <= &ПериодВО
	|	И Акцепт.ПериодБУ <= &ПериодБУ
	|	И НЕ(Акцепт.ПериодВО = &ПериодВО
	|				И Акцепт.ПериодБУ = &ПериодБУ)
	|	И Акцепт.Проведен
	|	И Акцепт.Дата >= &Дата
	|	И Акцепт.Ссылка <> &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Акцепт.Дата,
	|	Акцепт.Ссылка,
	|	Акцепт.Представление,
	|	ВЫБОР
	|		КОГДА &ЭтоСторно
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ
	|ИЗ
	|	Документ.Акцепт КАК Акцепт
	|ГДЕ
	|	Акцепт.Поступление = &Поступление
	|	И Акцепт.ПериодВО = &ПериодВО
	|	И Акцепт.ПериодБУ = &ПериодБУ
	|	И Акцепт.Проведен
	|	И ВЫБОР
	|			КОГДА &ЭтоСторно
	|				ТОГДА Акцепт.Дата <= &Дата
	|			ИНАЧЕ Акцепт.Дата >= &Дата
	|		КОНЕЦ
	|	И Акцепт.Ссылка <> &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Акцепт.Дата,
	|	Акцепт.Ссылка,
	|	Акцепт.Представление,
	|	1
	|ИЗ
	|	Документ.Акцепт КАК Акцепт
	|ГДЕ
	|	Акцепт.Поступление = &Поступление
	|	И Акцепт.ПериодВО >= &ПериодВО
	|	И Акцепт.ПериодБУ >= &ПериодБУ
	|	И НЕ(Акцепт.ПериодВО = &ПериодВО
	|				И Акцепт.ПериодБУ = &ПериодБУ)
	|	И Акцепт.Проведен
	|	И Акцепт.Дата <= &Дата
	|	И Акцепт.Ссылка <> &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок";
	
	Запрос.УстановитьПараметр("Поступление", ТекущийОбъект.Поступление);
	Запрос.УстановитьПараметр("Ссылка", ТекущийОбъект.Ссылка);
	Запрос.УстановитьПараметр("ПериодВО", ТекущийОбъект.ПериодВО);
	Запрос.УстановитьПараметр("ПериодБУ", ТекущийОбъект.ПериодБУ);
	Запрос.УстановитьПараметр("Дата", ТекущийОбъект.Дата);
	ЭтоСторно = ?(ЗначениеЗаполнено(ТекущийОбъект.СторнируемыйАкцепт), Истина, Ложь);
	Запрос.УстановитьПараметр("ЭтоСторно", ЭтоСторно); 
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Порядок = 0 Тогда
			ТекстСообщения = СтрШаблон("Дата акцепта должна быть больше даты предыдущего акцепта %1", Выборка.Дата);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		Иначе
			ТекстСообщения = СтрШаблон("Дата акцепта должна быть меньше даты следующего акцепта %1", Выборка.Дата);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		КонецЕсли;
	КонецЦикла;
	//Евросиб Каблов 07.09.2022 )
	
