//Евросиб Каблов 07.09.2022 US49022
&НаКлиенте
Процедура СоздатьЗапросНеурегулированныеРасходы(Команда)
	
	ВыбранныеСтроки = Объект.Услуги.НайтиСтроки(Новый Структура("Выбрать", Истина));
	
	Если ВыбранныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Не выбраны строки для создания запроса!");
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ОтработкаВРИТМ = ПредопределенноеЗначение("Справочник.ПричиныНеурегулированныхРасходов.ОтработкаВРИТМ");
	
	АкцептыВыбранныхСтрок = Новый Массив;
	ИдентификаторыСтрокАкцепта = Новый Массив;
	МассивУслуги = Новый Массив;
	МассивКонтейнеры = Новый Массив;
	МассивВагоны = Новый Массив;

	Для Каждого Стр Из ВыбранныеСтроки Цикл
		
		ИндексСтроки = Формат(Стр.НомерСтроки - 1, "ЧГ=0");
		//Если выбраны строки по нескольким акцептам, то создавать запрос нельзя
		Если ЗначениеЗаполнено(Стр.Сделка) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Нельзя создать запрос причины неурег. расхода по акцептованной строке!",, "Услуги["+ИндексСтроки+"].Выбрать", "Объект", Отказ);
		ИначеЕсли Стр.Неурег = ОтработкаВРИТМ Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Нельзя создать запрос причины неурег. расхода по строке, переданной в РИТМ!",, "Услуги["+ИндексСтроки+"].Выбрать", "Объект", Отказ);
		ИначеЕсли ЗначениеЗаполнено(Стр.ПричинаНеакцепта) Или ЗначениеЗаполнено(Стр.СуммаПретензии) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Нельзя создать запрос причины неурег. расхода по строке с претензией!",, "Услуги["+ИндексСтроки+"].Выбрать", "Объект", Отказ);
		ИначеЕсли ЗначениеЗаполнено(Стр.ГУИДТемы) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("По строке уже создан запрос причины неурег расходов!",, "Услуги["+ИндексСтроки+"].Выбрать", "Объект", Отказ);
		КонецЕсли;
		
		Если Не Отказ Тогда
			ИдентификаторыСтрокАкцепта.Добавить(Стр.ГУИД);
			МассивУслуги.Добавить(Стр.Номенклатура);
			МассивКонтейнеры.Добавить(Новый Структура("Контейнер, НеурегПричинаПользователя", Стр.Контейнер, Стр.НеурегПричинаУказаннаяПользователем));
			МассивВагоны.Добавить(Новый Структура("Вагон, НеурегПричинаПользователя", Стр.Вагон, Стр.НеурегПричинаУказаннаяПользователем));
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не Отказ Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("СоздатьНовыйДиалог", Истина);	
		ПараметрыФормы.Вставить("КонтекстТемы", Объект.Поступление);
		ПараметрыФормы.Вставить("ИдентификаторыСтрокАкцепта", ИдентификаторыСтрокАкцепта);
		
		ТемаДиалога = СформироватьТемуДиалога(МассивУслуги, МассивКонтейнеры, МассивВагоны);
		ПараметрыФормы.Вставить("ТемаНовогоДиалога", ТемаДиалога);
		
		ОткрытьФорму("Обработка.Диалоги.Форма", ПараметрыФормы, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

