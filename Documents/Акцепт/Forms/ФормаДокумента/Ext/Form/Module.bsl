&НаКлиенте
Процедура УстановитьОтборТаблицыУслуг()
	
	ПроверятьВагоны = ЗначениеЗаполнено(Вагон);
	ПроверятьКонтейнеры = ЗначениеЗаполнено(Контейнер);
	ПроверятьНакладные = ЗначениеЗаполнено(Накладная);
	Для каждого Стр из Объект.Услуги Цикл
		
		Если ПроверятьВагоны И Вагоны.НайтиПоЗначению(Стр.Вагон) = Неопределено Тогда
			Стр.ПоказатьВОтборе = Ложь;
			Продолжить;
		КонецЕсли;
		
		Если ПроверятьКонтейнеры И Контейнеры.НайтиПоЗначению(Стр.Контейнер) = Неопределено Тогда
			Стр.ПоказатьВОтборе = Ложь;
			Продолжить;
		КонецЕсли;
		
		Если ПроверятьНакладные И Накладные.НайтиПоЗначению(Стр.ТранспортныйДокумент) = Неопределено Тогда
			Стр.ПоказатьВОтборе = Ложь;
			Продолжить;
		КонецЕсли;
		
		Стр.ПоказатьВОтборе = Истина;
		
	КонецЦикла;
	
	//Евросиб Каблов 04.03.2021 ( Ticket#0224143
	//СтруктураОтбора = Новый Структура("ПоказатьВОтборе", Истина);
	УслугиОтборСтрок = Элементы.Услуги.ОтборСтрок;
	Если УслугиОтборСтрок = Неопределено Тогда
		СтруктураОтбора = Новый Структура;
	Иначе
		СтруктураОтбора = Новый Структура(УслугиОтборСтрок);
	КонецЕсли;
	СтруктураОтбора.Вставить("ПоказатьВОтборе", Истина);
	//Евросиб Каблов 04.03.2021 )
	
	Элементы.Услуги.ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураОтбора);
	
КонецПроцедуры

&НаКлиенте
Процедура РазнестиНакопительнуюВедомость(Команда)
	
	Если ТипЗнч(Объект.Поступление) = Тип("ДокументСсылка.КорректировкаПоступления") Тогда
		
		Сообщить("Документ поступления не соответсвует Поступлению товаров и услуг!");
		Возврат;
	
	КонецЕсли; 
	
	// Проверка на актуальность:
	АктАкцепт = ПолучитьАктАкцепт(Объект.Поступление);
	
	Если АктАкцепт <> Объект.Ссылка Тогда
	
		Сообщить("Акцепт не актуален! Для корректного разнесения откройте актуальный акцепт.");
		Возврат;
	
	КонецЕсли; 
	
	ОпОп = Новый ОписаниеОповещения("РазнестиНакопительнуюВедомость_ПослеРазнесения", ЭтаФорма);
	ОткрытьФорму("Документ.Акцепт.Форма.ФормаРазнесениеРасходовИзНВ", Новый Структура("Поступление, Акцепт", Объект.Поступление, Объект.Ссылка) ); 
	
КонецПроцедуры

