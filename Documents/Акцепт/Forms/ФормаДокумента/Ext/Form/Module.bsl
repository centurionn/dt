Процедура УслугиНеурегПриИзменении(Элемент)
	
	//Евросиб Каблов 16.12.2020 ( Ticket#0211264 
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	Если ТекДанные.Неурег = ПредопределенноеЗначение("Справочник.ПричиныНеурегулированныхРасходов.ОтработкаВРИТМ")
			И ЗначениеЗаполнено(ТекДанные.Сделка) Тогда
		ТекДанные.Неурег = Неопределено;
		ПоказатьПредупреждение(, "Для строки, привязанной к сделке, запрещено выбирать причину неурегулированных расходов Отработка в РИТМ!");
	КонецЕсли;
	//Евросиб Каблов 16.12.2020 )
	
КонецПроцедуры

