&НаКлиенте
Процедура ОбработкаВыбораСделки(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = неопределено Тогда Возврат; КонецЕсли;
	
	РезСделка = ВнестиНакладныеВСделку(П1, П2.СписокВыбранныхСтрок, П2.ВключитьВДоходы, П2.ВключитьВРасходы);
	
	Для каждого РезРаз Из РезСделка.РезультатРазнесения Цикл
		
		НайдСтрока = Объект.Услуги.НайтиСтроки(Новый Структура("НомерСтроки", РезРаз.ИсхНомерСтроки));
		Если НайдСтрока.Количество() > 0 Тогда
			
			НайдСтрока[0].ПолностьюРазнесено = Истина;
			НайдСтрока[0].Сделка = РезРаз.Сделка;
			НайдСтрока[0].ИдентификаторСтрокиРасходовВСделке = РезРаз.ГУИДРасходов;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДополнитьДанные_Сервер(Истина);
	ОбновитьПодсветку();
		
	ОпОп = Новый ОписаниеОповещения("ОбработкаВопросаОткрытияСделки", ЭтаФорма, РезСделка.Сделка);
	ПоказатьВопрос(ОпОп, "Данные внесены в сделку. Открыть ее?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры


