	ТекД = Элементы.Услуги.ТекущиеДанные;
	Если ТекД <> неопределено Тогда
		
		//Евросиб Каблов 11.06.2021 ( Ticket#0229012
		Если ЗначениеЗаполнено(ТекД.Сделка) Тогда
			ПоказатьПредупреждение(, "Выбранная строка привязана к сделке! Сначала отвяжите строку, а затем повторите создание претензии.");
			Возврат;
		КонецЕсли;
		//Евросиб Каблов 11.06.2021 )
		
		//Евросиб Каблов 31.08.2021 ( Ticket#0241956
		Если ТекД.Неурег = ПредопределенноеЗначение("Справочник.ПричиныНеурегулированныхРасходов.ОтработкаВРИТМ") Тогда
			ПоказатьПредупреждение(, "Выбранная строка передана в РИТМ! Сначала верните строку из РИТМа, а затем повторите создание претензии.");
			Возврат;
		КонецЕсли;
		//Евросиб Каблов 31.08.2021 )
		
		ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораПретензии", ЭтаФорма);
		ОткрытьФорму("Документ.Акцепт.Форма.ФормированиеПретензии", Новый Структура("ИсходнаяУслуга,ИсходноеКоличество,ИсходнаяСумма", ТекД.Номенклатура, ТекД.ПоступлениеКоличество, ТекД.ПоступлениеСумма), ЭтаФорма, ЭтаФорма.УникальныйИдентификатор,,,ОпОп,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
