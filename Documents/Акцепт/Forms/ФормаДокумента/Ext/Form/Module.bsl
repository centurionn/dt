&НаСервере
Функция ПолучитьСписокТДпоПТУ()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПоступлениеТоваровУслугУслуги.ГУИДПТУ КАК ИдентификаторСтрокиПоступления,
	|	ПоступлениеТоваровУслугУслуги.СписокТД КАК СписокТД
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Услуги КАК ПоступлениеТоваровУслугУслуги
	|ГДЕ
	|	ПоступлениеТоваровУслугУслуги.Ссылка = &Поступление";
	//Евросиб Каблов 09.02.2023 ( Ticket#0294452
	Если ТипЗнч(Объект.Поступление) = Тип("ДокументСсылка.КорректировкаПоступления") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПоступлениеТоваровУслуг.Услуги", "КорректировкаПоступления.Услуги");
	КонецЕсли;
	//Евросиб Каблов 09.02.2023 )
	Запрос.УстановитьПараметр("Поступление", Объект.Поступление);
	Возврат Запрос.Выполнить().Выгрузить();
	
