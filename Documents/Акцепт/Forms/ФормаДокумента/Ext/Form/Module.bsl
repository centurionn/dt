&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	//Евросиб Каблов 07.09.2022 ( US49022
	ТипСтруктура = Тип("Структура");
	ТипЗначенияПараметра = ТипЗнч(Параметр);
	Если ИмяСобытия = "Диалоги_ОтправкаСообщения" Тогда
		Если ТипЗначенияПараметра = ТипСтруктура Тогда
			Контекст = Неопределено;
			Если Параметр.Свойство("Контекст", Контекст) И Контекст = Объект.Поступление Тогда
				ОбновитьДанныеПоДиалогамНеурегРасходов();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//Евросиб Каблов 07.09.2022 )
	
КонецПроцедуры

