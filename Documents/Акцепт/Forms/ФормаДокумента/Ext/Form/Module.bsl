&НаСервере
Процедура ВыполнитьЗаполнениеПоПервойСтроке(ТекСтрока, ПроверенныеСтроки, ИмяПоля)
	
	ТекДанные = Объект.Услуги.НайтиПоИдентификатору(ТекСтрока);
	НовоеЗначение = ТекДанные[ИмяПоля];
	
	ЛокацииПустаяСсылка = Справочники.Локации.ПустаяСсылка();
	
	ПроверитьТипЛокации = Ложь;
	
	Если ИмяПоля = "СтанцияОтправления" Или ИмяПоля = "СтанцияНазначения" Тогда
		
		Если ЗначениеЗаполнено(НовоеЗначение) Тогда
			ПроверитьТипЛокации = Истина;
			ТипЛокацииНовогоЗначения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НовоеЗначение, "Тип");
			ТаблицаНоменклатуры = Объект.Услуги.Выгрузить(, "Номенклатура");
			ТаблицаНоменклатуры.Свернуть("Номенклатура");
			СписокНоменклатуры = ТаблицаНоменклатуры.ВыгрузитьКолонку("Номенклатура");
			СоответствиеТиповЛокацийНоменклатуре = НоменклатураСервер.ПолучитьСоответствиеДоступныхТиповЛокацийНоменклатуре(СписокНоменклатуры);		
		КонецЕсли;
		
	ИначеЕсли ИмяПоля = "Номенклатура" Тогда
		
		ДоступныеТипыЛокаций = НоменклатураСервер.ПолучитьДоступныеТипыЛокацийПоНоменклатуре(НовоеЗначение);
		
	КонецЕсли;	
	
	Для Каждого ИдентификаторСтроки Из ПроверенныеСтроки Цикл
		
		СтрокаУслуг = Объект.Услуги.НайтиПоИдентификатору(ИдентификаторСтроки);
		
		РезультатПроверки = Истина;		
		Если ПроверитьТипЛокации Тогда
			ДоступныеТипыЛокаций = СоответствиеТиповЛокацийНоменклатуре.Получить(СтрокаУслуг.Номенклатура);
			Если ЗначениеЗаполнено(ДоступныеТипыЛокаций) Тогда
				Если ДоступныеТипыЛокаций.Найти(ТипЛокацииНовогоЗначения) = Неопределено Тогда
					РезультатПроверки = Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если РезультатПроверки Тогда
			
			СтрокаУслуг[ИмяПоля] = НовоеЗначение;
			
			Если ИмяПоля = "Сумма" Тогда
				СтрокаУслуг.СуммаНДС = ТекДанные.СуммаНДС;
			ИначеЕсли ИмяПоля = "ПоступлениеСумма" Тогда
				СтрокаУслуг.ПоступлениеСуммаНДС = ТекДанные.ПоступлениеСуммаНДС;
			ИначеЕсли ИмяПоля = "Номенклатура" Тогда
				
				Если ЗначениеЗаполнено(ДоступныеТипыЛокаций) Тогда
					
					Если ЗначениеЗаполнено(СтрокаУслуг.СтанцияОтправления) Тогда
						Если ДоступныеТипыЛокаций.Найти(СтрокаУслуг.СтанцияОтправления.Тип) = Неопределено Тогда
							СтрокаУслуг.СтанцияОтправления = ЛокацииПустаяСсылка;
						КонецЕсли;
					КонецЕсли;
					
					Если ЗначениеЗаполнено(СтрокаУслуг.СтанцияНазначения) Тогда
						Если ДоступныеТипыЛокаций.Найти(СтрокаУслуг.СтанцияНазначения.Тип) = Неопределено Тогда
							СтрокаУслуг.СтанцияНазначения = ЛокацииПустаяСсылка;
						КонецЕсли;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

