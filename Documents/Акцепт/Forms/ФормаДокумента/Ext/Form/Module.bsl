			//Евросиб - АСуслов 29.08.2022 14:08:24 #56528
			//(
			Если ЗначениеЗаполнено(Стр.Сделка) Тогда //ДИТ, Беляев СЮ, US 84896/ TA 85068, 22-05-2024, добавил условие по результатам тестирования в TASK 84898
				Стр2.ПричинаОтключенияСтрокиВСделке = Неопределено;
			КонецЕсли;
			//)
			//Евросиб - АСуслов 29.08.2022 14:08:26 #56528 
		КонецЦикла;
		
		
