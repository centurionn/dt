	ВыгружаемыеРеквизиты.Добавить("СтанцияНазначения");
	ВыгружаемыеРеквизиты.Добавить("Рейс");
	ВыгружаемыеРеквизиты.Добавить("ДатаОтправленияКП");
	ВыгружаемыеРеквизиты.Добавить("Контейнер");
	ВыгружаемыеРеквизиты.Добавить("ТранспортныйДокумент");
	ВыгружаемыеРеквизиты.Добавить("СписокТД");
	ВыгружаемыеРеквизиты.Добавить("ПоступлениеЦена");
	ВыгружаемыеРеквизиты.Добавить("ПоступлениеСтавкаНДС");
	ВыгружаемыеРеквизиты.Добавить("ПоступлениеСумма");
	ВыгружаемыеРеквизиты.Добавить("ПоступлениеСуммаНДС");
	ВыгружаемыеРеквизиты.Добавить("Неурег");
	ВыгружаемыеРеквизиты.Добавить("НеурегКомментарий");
	ВыгружаемыеРеквизиты.Добавить("НеурегПричинаУказаннаяПользователем");
	ВыгружаемыеРеквизиты.Добавить("ГУИД");
	ВыгружаемыеРеквизиты.Добавить("ИдентификаторСтрокиПоступления");	
	СтрокаВыгружаемыеРеквизиты = СтрСоединить(ВыгружаемыеРеквизиты, ",");
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Сделка", Документы.Сделка.ПустаяСсылка());
	
	ТаблицаАкцепта = Объект.Услуги.Выгрузить(ПараметрыОтбора, СтрокаВыгружаемыеРеквизиты);
	
	ПараметрыОтбора.Очистить();
	ПараметрыОтбора.Вставить("Неурег", Справочники.ПричиныНеурегулированныхРасходов.ОтработкаВРИТМ);
	СтрокиКУдалению = ТаблицаАкцепта.НайтиСтроки(ПараметрыОтбора);
	Для Каждого Стр Из СтрокиКУдалению Цикл
		ТаблицаАкцепта.Удалить(Стр);
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаАкцепта, УникальныйИдентификатор);
	
КонецФункции

