&НаКлиенте
Процедура ОбновитьПодсветку()
	
	Для каждого Стр из Объект.Услуги Цикл
		
		Стр.ПометитьЗеленым = Ложь;
		Стр.ПометитьКрасным = Ложь;
		Стр.ПометитьЗеленым = ЗначениеЗаполнено(Стр.Сделка);		
		Стр.ПометитьКрасным = Sqrt(Pow((Стр.ПоступлениеСумма - Стр.СделкаСумма), 2)) > ПодсвечиватьАкцептКраснымПриРазницеПланФактСуммБолее;		
		
	КонецЦикла;
	
	Элементы.УслугиПоступлениеСумма.ТекстПодвала 		= Формат(Объект.Услуги.Итог("ПоступлениеСумма"), "ЧДЦ=2; ЧН=");
	Элементы.УслугиСделкаСумма.ТекстПодвала 			= Формат(Объект.Услуги.Итог("СделкаСумма"), "ЧДЦ=2; ЧН=");
//Евросиб Гудкова( 17.11.2020 Ticket№ 0214363
	Элементы.УслугиПоступлениеКоличество.ТекстПодвала 	= Формат(Объект.Услуги.Итог("ПоступлениеКоличество"), "ЧДЦ=0; ЧН=");
	Элементы.УслугиПоступлениеСуммаНДС.ТекстПодвала 	= Формат(Объект.Услуги.Итог("ПоступлениеСуммаНДС"), "ЧДЦ=2; ЧН=");
	Элементы.УслугиПодтвержденнаяСумма.ТекстПодвала 	= Формат(Объект.Услуги.Итог("ПодтвержденнаяСумма"), "ЧДЦ=2; ЧН=");
	Элементы.УслугиСуммаПретензии.ТекстПодвала	 		= Формат(Объект.Услуги.Итог("СуммаПретензии"), "ЧДЦ=2; ЧН=");
	Элементы.УслугиСуммаРасходовИзАРМКонтроляСписанийИзРегистра.ТекстПодвала 	= Формат(Объект.Услуги.Итог("СуммаРасходовИзАРМКонтроляСписанийИзРегистра"), "ЧДЦ=2; ЧН=");
	Элементы.УслугиРазницаАРМКСиСуммаИтого.ТекстПодвала 		= Формат(Объект.Услуги.Итог("РазницаАРМКСиСуммаИтого"), "ЧДЦ=2; ЧН=");
	Элементы.УслугиСделкаСуммаНДС.ТекстПодвала 		= Формат(Объект.Услуги.Итог("СделкаСуммаНДС"), "ЧДЦ=2; ЧН=");
	Элементы.УслугиСумма.ТекстПодвала 	= Формат(Объект.Услуги.Итог("Сумма"), "ЧДЦ=2; ЧН=");
	Элементы.УслугиСуммаНДС.ТекстПодвала 		= Формат(Объект.Услуги.Итог("СуммаНДС"), "ЧДЦ=2; ЧН=");
	// Евросиб Гудкова) 	
КонецПроцедуры

