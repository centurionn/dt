&НаСервере
Функция ПолучитьАдресТаблицыДляПроверкиСделокЗаказов()
	
	ТаблицаАкцепта = Объект.Услуги.Выгрузить(, "НомерСтроки, Контейнер, Вагон, ТранспортныйДокумент, ИдентификаторСтрокиПоступления, Сделка");
	Возврат ПоместитьВоВременноеХранилище(ТаблицаАкцепта, УникальныйИдентификатор);
	
КонецФункции

&НаКлиенте
Процедура ОбработкаЗакрытияПроверкиСделокЗаказов(АдресТаблицы, ДополнительныеПараметры) Экспорт

	Если АдресТаблицы <> Неопределено Тогда	
		ОбработкаПроверкиСделокЗаказов(АдресТаблицы);
		Модифицированность = Истина;
	КонецЕсли; 

КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиСделокЗаказов(АдресТаблицы)

	ТаблицаАкцепта = ПолучитьИзВременногоХранилища(АдресТаблицы);
	УдалитьИзВременногоХранилища(АдресТаблицы);
	Для ИндексСтроки = 0 По ТаблицаАкцепта.Количество() - 1 Цикл
		СтрокаТаблицыУслуг = Объект.Услуги[ИндексСтроки];
	    Если ТаблицаАкцепта[ИндексСтроки].Отметка Тогда
		    СтрокаТаблицыУслуг.Неурег = Справочники.ПричиныНеурегулированныхРасходов.ОтработкаВРИТМ;
		ИначеЕсли СтрокаТаблицыУслуг.Неурег = Справочники.ПричиныНеурегулированныхРасходов.ОтработкаВРИТМ Тогда
			СтрокаТаблицыУслуг.Неурег = Неопределено;
		КонецЕсли; 		
	КонецЦикла;	

КонецПроцедуры // ОбработкаПроверкиСделокЗаказов()

&НаКлиенте
Процедура УслугиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	//Евросиб Каблов 07.09.2022 ( US49022
	ДанныеСтроки = Объект.Услуги.НайтиПоИдентификатору(ВыбраннаяСтрока);
	//Евросиб Каблов 07.09.2022 )
	
	Если Объект.Проведен Тогда
		Если Элемент.ТекущийЭлемент.Родитель.Имя = "УслугиГруппаКоличествоЦена"
			ИЛИ Элемент.ТекущийЭлемент.Родитель.Имя = "УслугиГруппаСумма" Тогда
			ПоказатьПредупреждение(,
							"Колонки количество, цена, ставка НДС, сумма НДС и сумма заблокированы для изменения в проведенном документе");
		КонецЕсли; 
	КонецЕсли;
	
	//Евросиб Каблов 28.04.2021 ( Ticket#0230703
	Если Элемент.ТекущийЭлемент.Имя = "УслугиУчДокумент" И (Элемент.ТекущийЭлемент.ТолькоПросмотр ИЛИ ТолькоПросмотр) Тогда
		ПоказатьЗначение(, Элемент.ТекущиеДанные.УчДокумент);
	ИначеЕсли Элемент.ТекущийЭлемент.Имя = "УслугиСделка" И (Элемент.ТекущийЭлемент.ТолькоПросмотр ИЛИ ТолькоПросмотр) Тогда
		ПоказатьЗначение(, Элемент.ТекущиеДанные.Сделка);
	КонецЕсли;
	//Евросиб Каблов 28.04.2021 )
	
	//Евросиб Каблов 07.09.2022 ( US49022
	Если Поле = Элементы.УслугиНеурегЗапрос И ЗначениеЗаполнено(ДанныеСтроки.ГУИДТемы) Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ОткрытьТему", ДанныеСтроки.ГУИДТемы);
		ОткрытьФорму("Обработка.Диалоги.Форма", ПараметрыФормы);
	КонецЕсли;
	//Евросиб Каблов 07.09.2022 )
	
КонецПроцедуры


