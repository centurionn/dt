&НаКлиенте
Процедура УслугиСтатусПричиныПриИзменении(Элемент)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекДанные.ПричинаНеакцепта) И ТекДанные.СтатусПричины <> ПредопределенноеЗначение("Перечисление.СтатусыПричинНеакцепта.Откз") Тогда
		ТекДанные.Сумма = ТекДанные.ПоступлениеСумма;
		ТекДанные.СуммаНДС = ТекДанные.ПоступлениеСуммаНДС;
		ТекДанные.ПолностьюРазнесено = Истина;
		ТекДанные.НоменклатураСделки = ПредопределенноеЗначение("Справочник.Номенклатура.Претензии");
		ТекДанные.СделкаСтавкаНДС = ТекДанные.ПоступлениеСтавкаНДС;
	ИначеЕсли ЗначениеЗаполнено(ТекДанные.ПричинаНеакцепта) И ТекДанные.СтатусПричины = ПредопределенноеЗначение("Перечисление.СтатусыПричинНеакцепта.Откз") Тогда
		Если Не ЗначениеЗаполнено(ТекДанные.Сделка) Тогда
			ТекДанные.Сумма = 0;
			ТекДанные.СуммаНДС = 0;
			ТекДанные.ПолностьюРазнесено = Ложь;
			ТекДанные.НоменклатураСделки = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
			ТекДанные.СделкаСтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.ПустаяСсылка");
		КонецЕсли;
	КонецЕсли;
	
	Объект.СуммаАкцепта = Объект.Услуги.Итог("Сумма");
	Объект.СуммаНДСАкцепта = Объект.Услуги.Итог("СуммаНДС");
	
КонецПроцедуры

