	|	АкцептУслуги.ПоступлениеЦена КАК ПоступлениеЦена,
	|	АкцептУслуги.ПоступлениеСтавкаНДС КАК ПоступлениеСтавкаНДС,
	|	АкцептУслуги.ПоступлениеСумма КАК ПоступлениеСумма,
	|	АкцептУслуги.ПоступлениеСуммаНДС КАК ПоступлениеСуммаНДС,
	|	АкцептУслуги.ИдентификаторСтрокиПоступления КАК ИдентификаторСтрокиПоступления,
	|	АкцептУслуги.ГУИД КАК ГУИД,
	|	АкцептУслуги.УчДокумент КАК УчДокумент,                   
	//Евросиб - АСуслов 07.03.2023 16:54:24 #66486
	//(
	|   АкцептУслуги.Сделка КАК Сделка,
	|   АкцептУслуги.ИдентификаторСтрокиРасходовВСделке,
	//)
	//Евросиб - АСуслов 07.03.2023 16:54:31 #66486
	|	АкцептУслуги.ТранспортныйДокумент КАК ТранспортныйДокумент
	|ПОМЕСТИТЬ втУслуги
	|ИЗ
	|	&Услуги КАК АкцептУслуги
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПТУ.Контейнер КАК Контейнер,
	|	ПТУ.Вагон КАК Вагон,
	|	ПТУ.ИдентификаторСтрокиПоступления КАК ИдентификаторСтрокиПоступления,
	|	ПТУ.Номенклатура КАК Номенклатура,
	|	ПТУ.ПоступлениеСтавкаНДС КАК ПоступлениеСтавкаНДС,
	|	ПТУ.ПоступлениеКоличество КАК ПоступлениеКоличество,
	|	ПТУ.ПоступлениеЦена КАК ПоступлениеЦена,
	|	ПТУ.ПоступлениеСумма КАК ПоступлениеСумма,
	|	ПТУ.ПоступлениеСуммаНДС КАК ПоступлениеСуммаНДС,
	|	ПТУ.СтанцияОтправления КАК СтанцияОтправления,
	|	ПТУ.СтанцияНазначения КАК СтанцияНазначения,
	|	ПТУ.Содержание КАК Содержание,
	|	ПТУ.ТранспортныйДокумент КАК ТранспортныйДокумент,
	|	ПТУ.ВесПоНакладной КАК ВесПоНакладной
	|ПОМЕСТИТЬ втПТУ
	|ИЗ
	|	&ПТУ КАК ПТУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втПТУ.Контейнер КАК Контейнер,
	|	втПТУ.Вагон КАК Вагон,
	|	втПТУ.ИдентификаторСтрокиПоступления КАК ИдентификаторСтрокиПоступления,
	|	втПТУ.Номенклатура КАК Номенклатура,
	|	втПТУ.ПоступлениеСтавкаНДС КАК ПоступлениеСтавкаНДС,
	|	втПТУ.ПоступлениеКоличество КАК ПоступлениеКоличество,
	|	втПТУ.ПоступлениеЦена КАК ПоступлениеЦена,
	|	втПТУ.ПоступлениеСумма КАК ПоступлениеСумма,
	|	втПТУ.ПоступлениеСуммаНДС КАК ПоступлениеСуммаНДС,
	|	втПТУ.СтанцияОтправления КАК СтанцияОтправления,
	|	втПТУ.СтанцияНазначения КАК СтанцияНазначения,
	|	втПТУ.Содержание КАК Содержание,
	|	втПТУ.ТранспортныйДокумент КАК ТранспортныйДокумент,
	|	втПТУ.ВесПоНакладной КАК ВесПоНакладной,
	|	втУслуги.ГУИД КАК ГУИД,                       
	//Евросиб - АСуслов 07.03.2023 16:57:26 #66486
	//(
	|   ЕСТЬNULL(СделкаРасходы.УслугаОтключена, Ложь) КАК УслугаОтключена,
	|   ЕСТЬNULL(СделкаРасходы.ИсточникПоявленияСтрокиЭкономики, Неопределено) КАК ИсточникПоявленияСтрокиЭкономики
	//)
	//Евросиб - АСуслов 07.03.2023 16:57:28 #66486
	|ИЗ
	|	втПТУ КАК втПТУ
	|		ПОЛНОЕ СОЕДИНЕНИЕ втУслуги КАК втУслуги
	|		ПО втПТУ.ИдентификаторСтрокиПоступления = втУслуги.ИдентификаторСтрокиПоступления
	|			И втПТУ.Номенклатура = втУслуги.Номенклатура
	|			И втПТУ.Контейнер = втУслуги.Контейнер
	|			И втПТУ.Вагон = втУслуги.Вагон
	|   	ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.Расходы КАК СделкаРасходы
	|  			ПО втУслуги.Сделка = СделкаРасходы.Ссылка
	|  				И втУслуги.ИдентификаторСтрокиРасходовВСделке = СделкаРасходы.ГУИД
	|ГДЕ
	|	(ЕСТЬNULL(втПТУ.ПоступлениеЦена, 0) <> ЕСТЬNULL(втУслуги.ПоступлениеЦена, 0)
	|			ИЛИ ЕСТЬNULL(втПТУ.ПоступлениеСтавкаНДС, 0) <> ЕСТЬNULL(втУслуги.ПоступлениеСтавкаНДС, 0)
	|			ИЛИ ЕСТЬNULL(втПТУ.ПоступлениеСумма, 0) <> ЕСТЬNULL(втУслуги.ПоступлениеСумма, 0)
	|			ИЛИ ЕСТЬNULL(втПТУ.ПоступлениеСуммаНДС, 0) <> ЕСТЬNULL(втУслуги.ПоступлениеСуммаНДС, 0)
