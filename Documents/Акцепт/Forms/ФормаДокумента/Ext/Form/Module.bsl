Функция ПроверитьДоступностьПТУ(ПТУ)
	
	Результат  = Истина;
	
	Попытка
		ПТУОбъект = ПТУ.ПолучитьОбъект();
		ПТУОбъект.Заблокировать();
		ПТУОбъект.Разблокировать();
	Исключение
		ОО = ОписаниеОшибки();
		Результат = Ложь;
	КонецПопытки;
	
	Возврат Результат;
	
