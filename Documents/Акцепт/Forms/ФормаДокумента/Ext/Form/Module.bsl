&НаСервере
Процедура ОтвязатьВыбранныеСтрокиСервер()
	
	//Евросиб Каблов 02.07.2021 ( Ticket#0234010
	Если ТипЗнч(Объект.Поступление) = Тип("ДокументСсылка.КорректировкаПоступления")
		// ++ ДИТ_Агафонов_task 41390 07.02.2023
		И Не ОпределениеЭтоКорректировкаПоступленияВидОперацииИсправлениеВПервичныхДокументах()
		// -- ДИТ_Агафонов_task 41390 07.02.2023
