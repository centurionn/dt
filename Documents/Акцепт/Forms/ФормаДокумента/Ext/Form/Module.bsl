	"ВЫБРАТЬ
	|	АкцептУслуги.Сделка КАК Сделка,
	|	АкцептУслуги.ИдентификаторСтрокиРасходовВСделке КАК ИдентификаторСтрокиРасходовВСделке,
	|	АкцептУслуги.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ВТ_Услуги
	|ИЗ
	|	Документ.Акцепт.Услуги КАК АкцептУслуги
	|ГДЕ
	|	АкцептУслуги.ПолностьюРазнесено
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Услуги.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	ВТ_Услуги КАК ВТ_Услуги
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.Расходы КАК СделкаРасходы
	|		ПО ВТ_Услуги.ИдентификаторСтрокиРасходовВСделке = СделкаРасходы.ГУИД
	|			И ВТ_Услуги.Сделка = СделкаРасходы.Ссылка
	|			И (СделкаРасходы.ИсточникПоявленияСтрокиЭкономики = ЗНАЧЕНИЕ(Перечисление.ИсточникПоявленияСтрокиЭкономики.ДобавленоИзАкцепта))";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Акцепт.Услуги", "&АкцептУслуги");
	Запрос.УстановитьПараметр("АкцептУслуги", Объект.Услуги.Выгрузить());
	РезультатЗапроса = Запрос.Выполнить();                                
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;  
	ВыборкаРезультата = РезультатЗапроса.Выбрать();
	Пока ВыборкаРезультата.Следующий() Цикл  
		ТекстСообщения = СтрШаблон("В строке %1 указан признак «Разнесено полностью» для расхода сделки, добавленого из акцепта.
		|Снимите признак или отмените разнесение", ВыборкаРезультата.НомерСтроки);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Услуги",ВыборкаРезультата.НомерСтроки,"ПолностьюРазнесено"), "Объект", Отказ);
	КонецЦикла;
	
КонецПроцедуры

Процедура СнятьПризнакРазнесеноПолностьюДляАкцептованныхСтрокНаОднуСрокуСделки(ТекущийОбъект)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АкцептУслуги.Сделка КАК Сделка,
	|	АкцептУслуги.ИдентификаторСтрокиРасходовВСделке КАК ИдентификаторСтрокиРасходовВСделке,
	|	АкцептУслуги.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ВТ_Услуги
	|ИЗ
	|	Документ.Акцепт.Услуги КАК АкцептУслуги
	|ГДЕ
	|	АкцептУслуги.ПолностьюРазнесено
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_Услуги.НомерСтроки) КАК НомерСтроки,
	|	ВТ_Услуги.ИдентификаторСтрокиРасходовВСделке КАК ИдентификаторСтрокиРасходовВСделке
	|ПОМЕСТИТЬ ВТ_ПовторныеРазнесения
	|ИЗ
	|	ВТ_Услуги КАК ВТ_Услуги
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Услуги.ИдентификаторСтрокиРасходовВСделке
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_Услуги.НомерСтроки) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Услуги.НомерСтроки КАК НомерСтроки,
	|	ВТ_Услуги.ИдентификаторСтрокиРасходовВСделке КАК ИдентификаторСтрокиРасходовВСделке
	|ИЗ
	|	ВТ_Услуги КАК ВТ_Услуги
	|ГДЕ
	|	ВТ_Услуги.ИдентификаторСтрокиРасходовВСделке В
	|			(ВЫБРАТЬ
	|				т.ИдентификаторСтрокиРасходовВСделке
	|			ИЗ
	|				ВТ_ПовторныеРазнесения КАК т)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИдентификаторСтрокиРасходовВСделке,
	|	НомерСтроки";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Акцепт.Услуги", "&АкцептУслуги");
	Запрос.УстановитьПараметр("АкцептУслуги", Объект.Услуги.Выгрузить());
	РезультатЗапроса = Запрос.Выполнить(); 
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;  
	ВыборкаРезультата = РезультатЗапроса.Выбрать();
	Пока ВыборкаРезультата.СледующийПоЗначениюПоля("ИдентификаторСтрокиРасходовВСделке") Цикл
		Пока ВыборкаРезультата.СледующийПоЗначениюПоля("НомерСтроки") Цикл
			СтрокаУслуги = ТекущийОбъект.Услуги.Найти(ВыборкаРезультата.НомерСтроки, "НомерСтроки");
			СтрокаУслуги.ПолностьюРазнесено = Ложь;
		КонецЦикла;                              
		//у последней поставим истина
		СтрокаУслуги.ПолностьюРазнесено = Истина;
	КонецЦикла;
	
КонецПроцедуры	
