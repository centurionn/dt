			НайденныеСтроки = Объект.Услуги.НайтиСтроки(Новый Структура("ГУИД", Выборка.ГУИД));
			Если НайденныеСтроки.Количество() > 0 Тогда
				СтрокаУслуги = НайденныеСтроки[0];
				// ++ ДИТ_Агафонов_task 41390
				Если ПропускалиСтроку 
					и (Выборка.ПоступлениеСуммаДельта<>0 или Выборка.ПоступлениеСуммаНДСДельта<>0)
					Тогда
					СтрокаКорректировки = Объект.Услуги.Добавить();	
					ЗаполнитьЗначенияСвойств(СтрокаКорректировки, СтрокаУслуги,"Номенклатура,НоменклатурнаяГруппа,ИдентификаторСтрокиПоступления,Контейнер,Вагон,ТранспортныйДокумент,ПоступлениеСтавкаНДС,СтанцияОтправления,СтанцияНазначения");
				    СтрокаКорректировки.ПоступлениеСумма = Выборка.ПоступлениеСуммаДельта;
				    СтрокаКорректировки.ПоступлениеСуммаНДС = Выборка.ПоступлениеСуммаНДСДельта;
				    СтрокаКорректировки.ПоступлениеЦена = Выборка.ПоступлениеСуммаДельта;
					Продолжить;
				ИначеЕсли ПропускалиСтроку  Тогда	
					ТекстСообщения = СтрШаблон("Строка %1, не была перезаполнена по ставке НДС и транспортному документу, т.к. она зафиксирована или ее невозможно отвязать от сделки (в ней вид расходов Возмещаемые и документ Отчет комитенту)!", ТекУслуга.НомерСтроки);
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				КонецЕсли;	
				Если ЭтоКорректировкаПоступленияВидОперацииИсправлениеВПервичныхДокументах Тогда
					Если (СтрокаУслуги.ПоступлениеСумма + Выборка.ПоступлениеСуммаДельта) = 0 и (СтрокаУслуги.ПоступлениеСуммаНДС + Выборка.ПоступлениеСуммаНДСДельта)=0 Тогда
						Объект.Услуги.Удалить(СтрокаУслуги);
					Иначе	
						ЗаполнитьЗначенияСвойств(СтрокаУслуги, Выборка,,"ПоступлениеСумма,ПоступлениеСуммаНДС,ПоступлениеЦена");
						СтрокаУслуги.ПоступлениеСумма = СтрокаУслуги.ПоступлениеСумма + Выборка.ПоступлениеСуммаДельта;
						СтрокаУслуги.ПоступлениеСуммаНДС = СтрокаУслуги.ПоступлениеСуммаНДС + Выборка.ПоступлениеСуммаНДСДельта;
						СтрокаУслуги.ПоступлениеЦена = СтрокаУслуги.ПоступлениеЦена + Выборка.ПоступлениеЦенаДельта;
					КонецЕсли;
					Продолжить;
				КонецЕсли;
				// -- ДИТ_Агафонов_task 41390
				ЗаполнитьЗначенияСвойств(СтрокаУслуги, Выборка);
			КонецЕсли;
		ИначеЕсли УдаляемыеСтроки.Найти(Выборка.ГУИД) <> Неопределено Тогда
			НайденныеСтроки = Объект.Услуги.НайтиСтроки(Новый Структура("ГУИД", Выборка.ГУИД));   
			// ++ ДИТ_Агафонов_task 41390
			Если ПропускалиСтроку и НайденныеСтроки.Количество() > 0 Тогда
				СтрокаУдаления = Объект.Услуги.Добавить();	
				ЗаполнитьЗначенияСвойств(СтрокаУдаления,НайденныеСтроки[0],"Номенклатура,НоменклатурнаяГруппа,ИдентификаторСтрокиПоступления,Контейнер,Вагон,ТранспортныйДокумент,ПоступлениеСтавкаНДС,СтанцияОтправления,СтанцияНазначения");
			    СтрокаУдаления.ПоступлениеКоличество = Выборка.ПоступлениеКоличество1 * (-1);
			    СтрокаУдаления.ПоступлениеСумма = Выборка.ПоступлениеСумма1 * (-1);
			    СтрокаУдаления.ПоступлениеСуммаНДС = Выборка.ПоступлениеСуммаНДС1 * (-1);
			    СтрокаУдаления.ПоступлениеЦена = Выборка.ПоступлениеЦена1;
				Продолжить;
			КонецЕсли;	
			// -- ДИТ_Агафонов_task 41390
			Если НайденныеСтроки.Количество() > 0 Тогда
				СтрокаУслуги = НайденныеСтроки[0];
				Объект.Услуги.Удалить(СтрокаУслуги);
			КонецЕсли;
		Иначе
			// если строки нет ни в перезаполняемых, ни в удаляемых, то это добавленная в ПТУ строка
			НоваяСтрока = Объект.Услуги.Добавить();
			//Евросиб Каблов 13.09.2022 ( 57446
			НоваяСтрока.ГУИД = Новый УникальныйИдентификатор;
			//Евросиб Каблов 13.09.2022 )
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		КонецЕсли;	
		
	КонецЦикла;	
	
	РежимЗаписиАкцепта = ?(Объект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
	Записать(Новый Структура("РежимЗаписи", РежимЗаписиАкцепта))
	
КонецПроцедуры
