	МассивВыделенныхСтрок = СобратьМассивВыделенныхСтрок();
	Если МассивВыделенныхСтрок.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Выделите строки для переноса и повторите попытку!");
		Возврат;
	КонецЕсли;
	ОпОп = Новый ОписаниеОповещения("ОбработкаДобавленияВСделку", ЭтаФорма, Новый Структура("ВариантРазнесения", ПредопределенноеЗначение("Перечисление.ВариантыРазнесенияЗатрат.СобственныеЗатраты")));
	ПараметрыФормы = Новый Структура("РасходыСобственныеЗатраты, СписокСтрок, ПериодУУ", Истина, МассивВыделенныхСтрок, ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(Объект.Поступление,"ДатаВходящегоДокумента"));
