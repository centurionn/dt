&НаКлиенте
Процедура ЗапроситьАннулированиеОК(Команда)
	
	МассивСтрок = Новый Массив;
	ВыполнитьДействиеАннулированиеОК(Истина);
	
КонецПроцедуры
//Евросиб(ДИТ), Беляев СЮ, US 113662 / TA 115172, 01-08-2025, конец

//Евросиб(ДИТ), Беляев СЮ, US 113662 / TA 115172, 01-08-2025, начало
&НаКлиенте
Процедура ВыполнитьДействиеАннулированиеОК(Действие)
	
	МассивСтрок = Новый Массив;
	МассивСделок = Новый Массив;
	Для каждого Стр из Объект.Услуги.НайтиСтроки(Новый Структура("Выбрать", Истина)) Цикл
		Если НЕ ЗначениеЗаполнено(Стр.Сделка) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Стр.УчДокумент) Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Стр.УчДокумент) <> Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСтрок.Добавить(Новый Структура("Сделка, УчДокумент", Стр.Сделка, Стр.УчДокумент));
		МассивСделок.Добавить(Стр.Сделка);
	КонецЦикла;
	
	Если МассивСтрок.Количество() > 0 Тогда
		ДанныеОбработки = ЗаписатьЗадачиАннулированияОК(МассивСтрок, МассивСделок, Действие);
		СтрокаСделокЗаписано = ?(ДанныеОбработки.МассивСделокЗаписано.Количество() = 0, "", "Записаны сделки: "+СтрСоединить(ДанныеОбработки.МассивСделокЗаписано));
		СтрокаСделокОшибкаЗаписи = ?(ДанныеОбработки.МассивСделокОшибка.Количество() = 0, "", "Не удалось записать сделки: "+СтрСоединить(ДанныеОбработки.МассивСделокОшибка));
		СтрокаСообщения = СтрокаСделокЗаписано + Символы.ПС + СтрокаСделокОшибкаЗаписи;
		ПоказатьПредупреждение(, СтрокаСообщения, 30);
	КонецЕсли;
	
КонецПроцедуры
//Евросиб(ДИТ), Беляев СЮ, US 113662 / TA 115172, 01-08-2025, конец

//Евросиб(ДИТ), Беляев СЮ, US 113662 / TA 115172, 01-08-2025, начало
&НаСервереБезКонтекста
Функция ЗаписатьЗадачиАннулированияОК(МассивСтрок, МассивСделок, Значение)
	
	МассивСделокЗаписано = Новый Массив;
	МассивСделокОшибка = Новый Массив;
	
	Взаимодействия.УдалитьПовторяющиесяЭлементыМассива(МассивСделок);
	
	Для Каждого текСделка Из МассивСделок Цикл
		
		СделкаОбъект = текСделка.ПолучитьОбъект();
		Для Каждого текСтрока Из МассивСтрок Цикл
			Если текСтрока.Сделка <> текСделка Тогда
				Продолжить;
			КонецЕсли;
			ДоходыСделки = СделкаОбъект.Доходы.НайтиСтроки(Новый Структура("УчДокумент", текСтрока.УчДокумент));
			Для Каждого строкаДохода Из ДоходыСделки Цикл
				строкаДохода.ТребуетсяАннулироватьОтчетКомитенту = Значение;
			КонецЦикла;
		КонецЦикла;
		Попытка
			СделкаОбъект.Записать();
			МассивСделокЗаписано.Добавить(СделкаОбъект.Номер);
		Исключение
			МассивСделокОшибка.Добавить(СделкаОбъект.Номер);
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Новый Структура("МассивСделокЗаписано, МассивСделокОшибка", МассивСделокЗаписано, МассивСделокОшибка);
	
КонецФункции
