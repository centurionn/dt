&НаКлиенте
Процедура ОбработкаПричиныНеурегов(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = неопределено Тогда Возврат; КонецЕсли;
	
	Для каждого ТекС из Объект.Услуги Цикл
		
		Если ТекС.Выбрать = ложь Тогда Продолжить; КонецЕсли;
		
		//ТекС = Объект.Услуги.НайтиПоИдентификатору(Стр);
		
		Если ТекС.Неурег = ПредопределенноеЗначение("Справочник.ПричиныНеурегулированныхРасходов.ОтработкаВРИТМ") Тогда Продолжить; КонецЕсли;
		
		//Евросиб Каблов 16.12.2020 ( Ticket#0211264
		Если П1.Причина = ПредопределенноеЗначение("Справочник.ПричиныНеурегулированныхРасходов.ОтработкаВРИТМ") И ЗначениеЗаполнено(ТекС.Сделка) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для строки, привязанной к сделке, запрещено выбирать причину неурегулированных расходов Отработка в РИТМ!", Объект.Ссылка, "Услуги[" + Формат(ТекС.НомерСтроки - 1, "ЧН=0; ЧГ=0") + "].Сделка", Объект);
			Продолжить;
		КонецЕсли;
		//Евросиб Каблов 16.12.2020 )
		
		Если ЗначениеЗаполнено(П1.Причина) Тогда
			ТекС.Неурег = П1.Причина;
			Если ТекС.Неурег = ПредопределенноеЗначение("Справочник.ПричиныНеурегулированныхРасходов.ОтработкаВРИТМ") Тогда
				ТекС.Сумма = 0;
				ТекС.СуммаНДС = 0;
				//Евросиб Каблов 31.08.2021 ( Ticket#0241956
				ТекС.ПричинаНеакцепта = Неопределено;
				ТекС.СтатусПричины = неопределено;
				ТекС.ДатаПретензии = '00010101';
				ТекС.СуммаПретензии = 0;
				ТекС.ПодтвержденнаяСумма = 0;
				ТекС.НоменклатураСделки = Неопределено;
				//Евросиб Каблов 31.08.2021 )	
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(П1.Комментарий) Тогда ТекС.НеурегКомментарий = П1.Комментарий; КонецЕсли;
		
	КонецЦикла;
	
	Объект.СуммаАкцепта = Объект.Услуги.Итог("Сумма");
	Объект.СуммаНДСАкцепта = Объект.Услуги.Итог("СуммаНДС");
	
КонецПроцедуры

