			//Евросиб Каблов 20.01.2021 ( Ticket#0213606
			Если ЗначениеЗаполнено(Стр.Сделка) Тогда
				Если Не ЗначениеЗаполнено(Стр2.ПривязалПользователь)
					И (Стр2.Сделка <> Стр.Сделка
					Или Стр2.ИдентификаторСтрокиРасходовВСделке <> Стр.ИдентификаторСтрокиРасходовВСделке) Тогда
					
					Стр2.ПривязалПользователь = ПользователиКлиент.ТекущийПользователь();
				КонецЕсли;
			Иначе
				Стр2.ПривязалПользователь = Неопределено;
			КонецЕсли;
			//Евросиб Каблов 20.01.2021 )
