&НаКлиенте
Процедура Сторнировать(Команда)
	
	Если Модифицированность Тогда
		ПоказатьПредупреждение(, "Документ был изменен. Сначала необходимо его записать.");
		Возврат;
	КонецЕсли;
	
	ДоступенДляСторно = ДокументДоступенДляСторно(Объект.Ссылка);		
	Если ДоступенДляСторно Тогда
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("СторнируемыйАкцепт", Объект.Ссылка);	
		ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
		ОткрытьФорму("Документ.Акцепт.ФормаОбъекта", ПараметрыФормы, ЭтаФорма);
	Иначе
		ПоказатьПредупреждение(, "Выбранный акцепт не доступен для сторно!");
	КонецЕсли;
	
КонецПроцедуры

