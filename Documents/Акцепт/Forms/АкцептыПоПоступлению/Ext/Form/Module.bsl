#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Поступление", Поступление) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Акцепты, "Поступление", Поступление);
	КонецЕсли;
	
	ОбновитьЗаголовокКнопкиОткрытьАктуальныйАкцепт();
	
	ПодсвечиватьАкцептКраснымПриРазницеПланФактСуммБолее = Константы.ПодсвечиватьАкцептКраснымПриРазницеПланФактСуммБолее.Получить();
	

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры

//Евросиб Коханенко Н.А. #61705 09.12.2022 (
&НаКлиенте
Процедура ОткрытьОкноСИнструкциями(Форма, Команда)
	ИнструкцииКлиент.ОткрытьОкноСИнструкциями(ЭтаФорма, Команда);
КонецПроцедуры  
//Евросиб Коханенко Н.А. #61705 09.12.2022 )


&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ЗаписьАкцепта" Тогда
		ОбработатьЗаписьАкцептаСервер(Параметр);
	КонецЕсли;
	
КонецПроцедуры

