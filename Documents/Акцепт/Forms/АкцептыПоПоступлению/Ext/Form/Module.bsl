#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьАктуальныйАкцепт(Команда)
	
	ПараметрыФормы = Новый Структура;
	
	АктуальныйАкцепт = ПолучитьАктуальныйАкцепт(Поступление);
	Если ЗначениеЗаполнено(АктуальныйАкцепт) Тогда		
		ПараметрыФормы.Вставить("Ключ", АктуальныйАкцепт);
		ПараметрыФормы.Вставить("СнятьПометкуУдаления", Истина);
	Иначе
		ЗначенияЗаполнения = Новый Структура();
		ЗначенияЗаполнения.Вставить("Поступление", Поступление);
		ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	КонецЕсли;
	
//Евросиб Гудкова( 29.11.2021 Ticket№ 42922
    ОценкаПроизводительностиКлиент.ЗамерВремени("АкцептОткрытиеФормы");
// Евросиб Гудкова)
	ОткрытьФорму("Документ.Акцепт.ФормаОбъекта", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура Сторнировать(Команда)
	
	Акцепт = Элементы.Акцепты.ТекущаяСтрока;
	Если Акцепт <> Неопределено Тогда
		
		ДоступенДляСторно = ДокументДоступенДляСторно(Акцепт);		
		Если ДоступенДляСторно Тогда
			ЗначенияЗаполнения = Новый Структура;
			ЗначенияЗаполнения.Вставить("СторнируемыйАкцепт", Акцепт);	
			ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
			ОткрытьФорму("Документ.Акцепт.ФормаОбъекта", ПараметрыФормы, ЭтаФорма);
		Иначе
			ПоказатьПредупреждение(, "Выбранный акцепт не доступен для сторно!");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура АкцептыПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("ОбработатьАктивациюСтроки", 0.2, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьЗаголовокКнопкиОткрытьАктуальныйАкцепт()
	
	АктуальныйАкцепт = ПолучитьАктуальныйАкцепт(Поступление);
	Если ЗначениеЗаполнено(АктуальныйАкцепт) Тогда
		ЗаголовокКнопки = "Открыть актуальный на редактирование";
	Иначе
		ЗаголовокКнопки = "Создать";
	КонецЕсли;
	
	Элементы.ОткрытьАктуальныйАкцепт.Заголовок = ЗаголовокКнопки; 
	//++ Глеков Д.В. Ticket#0247297 27.01.2022 
	Элементы.ОткрытьАктуальныйАкцепт.Доступность = НЕ ПоПоступлениюВведеноИсправление();	
	//-- Глеков Д.В. Ticket#0247297 27.01.2022
	
КонецПроцедуры  

//++ Глеков Д.В. Ticket#0247297 27.01.2022 
&НаСервере
Функция ПоПоступлениюВведеноИсправление()

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК Поле1
	|ИЗ
	|	Документ.КорректировкаПоступления КАК КорректировкаПоступления
	|ГДЕ
	|	КорректировкаПоступления.Проведен = ИСТИНА
	|	И КорректировкаПоступления.ВидОперации = Значение(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки)
	|	И КорректировкаПоступления.ДокументПоступления = &ДокументПоступления
    //++ДИТ Гаузер А.В. US 41390 TA 48051 05.03.2022
	|	И КорректировкаПоступления.ДокументПоступления ССЫЛКА Документ.ПоступлениеТоваровУслуг
	|   И КорректировкаПоступления.Проведен
	//--ДИТ Гаузер А.В. US 41390 TA 48051 05.03.2022
	|";
	Запрос.УстановитьПараметр("ДокументПоступления", Поступление);
	Возврат Не Запрос.Выполнить().Пустой();	

КонецФункции // ПоПоступлениюВведеноИсправление()
//-- Глеков Д.В. Ticket#0247297\ 27.01.2022

