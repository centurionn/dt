&НаКлиенте
Процедура ПересчитатьОтборВыделеннойСтроки()
	
	РТД = Элементы.СопостТЧ.ТекущиеДанные;
	Если РТД = неопределено
		Или Не (СвязыватьПоКТК Или СвязыватьПоВагонам Или СвязыватьПоТранспДокументам Или СвязыватьПоНоменклатуре Или СвязыватьПоПоставщикам Или СвязыватьПоДоговору Или СвязыватьПоПериодуОказанияУслуги) Тогда
		Для Каждого Стр из ТЧ Цикл
			Стр.ПоказатьВОтборе = Ложь;
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	Для каждого Стр из ТЧ Цикл
		
		НадеемсяЧтоСовпадет = Истина; 
		
		//Евросиб - АСуслов 08.09.2022 11:27:39 #56540
		//(
		Если СвязыватьПоПериодуОказанияУслуги И ЗначениеЗаполнено(РТД.НачалоОказанияУслуги) И РТД.НачалоОказанияУслуги < Стр.ДатаОтправления Тогда
			НадеемсяЧтоСовпадет = Ложь;
		КонецЕсли;
		Если СвязыватьПоПериодуОказанияУслуги И ЗначениеЗаполнено(РТД.ОкончаниеОказанияУслуги) И РТД.ОкончаниеОказанияУслуги > Стр.ДатаПрибытия Тогда
			НадеемсяЧтоСовпадет = Ложь;
		КонецЕсли;
		//)
		//Евросиб - АСуслов 08.09.2022 11:28:55 #56540
		
		Если СвязыватьПоКТК И Найти(Стр.СписокКТК, РТД.Контейнер) = 0 Тогда НадеемсяЧтоСовпадет = Ложь; КонецЕсли;
		Если СвязыватьПоВагонам И Найти(Стр.СписокВагонов, РТД.Вагон) = 0 Тогда НадеемсяЧтоСовпадет = Ложь; КонецЕсли;
		Если СвязыватьПоТранспДокументам И Найти(Стр.СписокТД, РТД.НомерТД) = 0 Тогда НадеемсяЧтоСовпадет = Ложь; КонецЕсли;
		Если СвязыватьПоНоменклатуре Тогда
			
			НайдСтрокиКэша = КэшСопоставителяКлиент.НайтиСтроки(Новый Структура("Номенклатура, Вес", РТД.Номенклатура, РТД.ВесПоНакладной));
			
			Если НайдСтрокиКэша.Количество() = 0 Тогда
				
				МассивРазрНоменклатуры = МассивРазрНоменклатуры(РТД.Номенклатура, РТД.ВесПоНакладной);
				НСтр = КэшСопоставителяКлиент.Добавить();
				НСтр.Номенклатура = РТД.Номенклатура;
				НСтр.Вес = РТД.ВесПоНакладной;
				НСтр.СопоставляемаяНоменклатура.ЗагрузитьЗначения(МассивРазрНоменклатуры);
				
			Иначе
				
				МассивРазрНоменклатуры = НайдСтрокиКэша[0].СопоставляемаяНоменклатура.ВыгрузитьЗначения();
				
			КонецЕсли;
			
			Если МассивРазрНоменклатуры.Найти(Стр.Услуга) = неопределено Тогда 
				НадеемсяЧтоСовпадет = Ложь; 
			КонецЕсли;
			
		КонецЕсли;
		Если СвязыватьПоПоставщикам И Стр.Поставщик <> ПоставщикАкцепта Тогда НадеемсяЧтоСовпадет = Ложь; КонецЕсли;
		Если СвязыватьПоДоговору И Стр.Договор <> ДоговорАкцепта Тогда НадеемсяЧтоСовпадет = Ложь; КонецЕсли;
		
		Стр.ПоказатьВОтборе = НадеемсяЧтоСовпадет;
		
	КонецЦикла;
			
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция МассивРазрНоменклатуры(Номенклатура, ВесПоНакладной)
	
	РазрНоменклатура = ПретензииИНеакцептыСервер.НоменклатуруРазрешеноСопоставлятьС(Номенклатура, ВесПоНакладной);
	РазрНоменклатура.Добавить(Номенклатура);
	Возврат РазрНоменклатура;
	
КонецФункции
	
