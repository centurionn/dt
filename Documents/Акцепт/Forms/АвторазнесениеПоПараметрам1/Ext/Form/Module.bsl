Процедура СвязатьБезПроверок(Команда)
	
	ТекЛ = Элементы.СопостТЧ.ТекущиеДанные;
	ТекП = Элементы.ТЧ.ТекущиеДанные;
	
	Если ТекЛ = неопределено ИЛИ ТекП = неопределено Тогда
		ПоказатьПредупреждение(, "Выберите строки для связи!");
		Возврат;
	КонецЕсли;
	
	ТекЛ.ИдентификаторСтрокиРасходовВСделке = ТекП.ГУИДРасходов;
	ТекЛ.Сделка = ТекП.Сделка;
	ТекЛ.ПолностьюРазнесено = Истина;
	ТекЛ.Связать = Ложь;
	
	ТекЛ.сопостНоменклатура = ТекП.Услуга;
	ТекЛ.сопостКТК = ТекП.СписокКТК;
	ТекЛ.сопостВагоны = ТекП.СписокВагонов;
	ТекЛ.сопостТД = ТекП.СписокТД;
	ТекЛ.сопостСумма = ТекП.НеРазнесено;
	ТекЛ.сопостСделка = ТекП.Сделка;
	
	ТекП.Связать = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ТолькоНепривязанные(Команда)
	
	ПоказыватьТолькоНепривязанныеСтроки = Не ПоказыватьТолькоНепривязанныеСтроки;
	УстановитьОтборТаблицыСопоставления();
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборТаблицыСопоставления()
	
	Элементы.СопостТЧТолькоНепривязанные.Пометка = ПоказыватьТолькоНепривязанныеСтроки;
	
	//Евросиб Каблов 04.02.2021 (
	//Если ПоказыватьТолькоНепривязанныеСтроки Тогда
	//	СтруктураОтбора = Новый Структура("ПолностьюРазнесено", Ложь);
	//Иначе
	//	СтруктураОтбора = Новый Структура();
	//КонецЕсли;
	
	ПроверятьВагоны = ЗначениеЗаполнено(Вагон);
	ПроверятьКонтейнеры = ЗначениеЗаполнено(Контейнер);
	ПроверятьНакладные = ЗначениеЗаполнено(Накладная);
	Для каждого Стр из СопостТЧ Цикл
		
		Если ПроверятьВагоны И Вагоны.НайтиПоЗначению(Стр.Вагон) = Неопределено Тогда
			Стр.ПоказатьВОтборе = Ложь;
			Продолжить;
		КонецЕсли;
		
		Если ПроверятьКонтейнеры И Контейнеры.НайтиПоЗначению(Стр.Контейнер) = Неопределено Тогда
			Стр.ПоказатьВОтборе = Ложь;
			Продолжить;
		КонецЕсли;
		
		Если ПроверятьНакладные И Накладные.НайтиПоЗначению(Стр.ТранспортныйДокумент) = Неопределено Тогда
			Стр.ПоказатьВОтборе = Ложь;
			Продолжить;
		КонецЕсли;
		
		Стр.ПоказатьВОтборе = Истина;
		
	КонецЦикла;
	
	Если ПоказыватьТолькоНепривязанныеСтроки Тогда
		СтруктураОтбора = Новый Структура("ПоказатьВОтборе, Сделка", Истина, ПредопределенноеЗначение("Документ.Сделка.ПустаяСсылка"));
	Иначе
		СтруктураОтбора = Новый Структура("ПоказатьВОтборе", Истина);
	КонецЕсли;
	//Евросиб Каблов 04.02.2021 )
	
	Элементы.СопостТЧ.ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураОтбора);
	
КонецПроцедуры

&НаКлиенте
Процедура РазбитьСтрокуНаСоставляющие(Команда)
	
	ТекД = Элементы.СопостТЧ.ТекущиеДанные;
	Если ТекД = неопределено ИЛИ ТекД.НоменклатураИмеетНесколькоСопоставлений <> 0 ИЛИ ЗначениеЗаполнено(ТекД.Сделка) Тогда ПоказатьПредупреждение(, "Сначала необходимо выбрать подходящую строку в таблице слева"); Возврат; КонецЕсли;
	
	СопостНоменклатура = ПретензииИНеакцептыСервер.НоменклатуруРазрешеноСопоставлятьС(ТекД.Номенклатура, ТекД.ВесПоНакладной);
	
	ИндексДляВставки = СопостТЧ.Индекс(ТекД);
	
	Для каждого Ном из СопостНоменклатура Цикл
		
		НСтр = СопостТЧ.Вставить(ИндексДляВставки);
		ЗаполнитьЗначенияСвойств(НСтр, ТекД);
		НСтр.Номенклатура = Ном;
		НСтр.ПоступлениеЦена = НСтр.ПоступлениеЦена/2;
		НСтр.ПоступлениеСумма = НСтр.ПоступлениеСумма/2;
		НСтр.НоменклатураИмеетНесколькоСопоставлений = ?(ПретензииИНеакцептыСервер.НоменклатуруРазрешеноСопоставлятьС(НСтр.Номенклатура, НСтр.ВесПоНакладной).Количество() > 1, 0, 1);
		НСтр.ПолностьюРазнесено = ЗначениеЗаполнено(НСтр.Сделка);
		
	КонецЦикла;
	
	СопостТЧ.Удалить(ТекД);
	
	
КонецПроцедуры

