&НаСервереБезКонтекста
Функция ОтработатьОтборСделокПоГрузу(поискКТК1ВыгрузитьЗначения, поискВагоны1ВыгрузитьЗначения, поискТД1ВыгрузитьЗначения, поискКТК, поискВагоны, поискТД)
	
	Результат = Новый Массив;
	
	Если НЕ поискКТК И НЕ поискВагоны И НЕ поискТД Тогда Возврат Результат; КонецЕсли;
	
	СписокТД2 = Новый Массив;
	Для каждого Стр из поискТД1ВыгрузитьЗначения Цикл СписокТД2.Добавить(Стр.НомерТранспортногоДокумента); КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СделкаСвязьУчетныхЕдиниц.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА &ОтборКТКУстановлен
	               |				ТОГДА СделкаСвязьУчетныхЕдиниц.Контейнер В (&ОтборКТК)
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &ОтборВагонУстановлен
	               |				ТОГДА СделкаСвязьУчетныхЕдиниц.Вагон В (&ОтборВагон)
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &ОтборТДУстановлен
	               |				ТОГДА СделкаСвязьУчетныхЕдиниц.НомерЖДН В (&ОтборТД)
	               |						ИЛИ СделкаСвязьУчетныхЕдиниц.НомерВагоннойЖДН В (&ОтборТД)
	               |						ИЛИ СделкаСвязьУчетныхЕдиниц.НомерПорожнейЖДНКТК В (&ОтборТД)
	               |						ИЛИ СделкаСвязьУчетныхЕдиниц.НомерПорожнейВагоннойЖДН В (&ОтборТД)
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ";
	Запрос.УстановитьПараметр("ОтборКТКУстановлен", поискКТК);
	Запрос.УстановитьПараметр("ОтборКТК", поискКТК1ВыгрузитьЗначения);
	Запрос.УстановитьПараметр("ОтборВагонУстановлен", поискВагоны);
	Запрос.УстановитьПараметр("ОтборВагон", поискВагоны1ВыгрузитьЗначения);
	Запрос.УстановитьПараметр("ОтборТДУстановлен", поискТД);
	Запрос.УстановитьПараметр("ОтборТД", СписокТД2);
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ссылка");
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
  //Евросиб Гудкова( 29.11.2021 Ticket№ 42922
  	УИДЗамера = Параметры.УИДЗамера; 
  // Евросиб Гудкова)
	//ОбновитьПоискНаСервере();
	ПоказыватьТолькоНепривязанныеСтроки = Истина;
	
	поискВагоны1.ЗагрузитьЗначения(Параметры.массивВагонов);
	поискКТК1.ЗагрузитьЗначения(Параметры.массивКТК);
	поискТД1.ЗагрузитьЗначения(Параметры.массивЖДН);
	
	поискНоменклатура1.ЗагрузитьЗначения(Параметры.массивУслуг);
	
	поискПериодОтправления1.ДатаНачала = Параметры.ДатаОтправленияМин;
	поискПериодОтправления1.ДатаОкончания = Параметры.ДатаОтправленияМакс;
	
	поискПериодПрибытия1.ДатаНачала = Параметры.ДатаПрибытияМин;
	поискПериодПрибытия1.ДатаОкончания = Параметры.ДатаПрибытияМакс;
	
	поискСтанцияОтправления1.ЗагрузитьЗначения(Параметры.массивСтОтправления);
	поискСтанцияНазначения1.ЗагрузитьЗначения(Параметры.массивСтНазначения);
	
	поискПоставщик1.ЗагрузитьЗначения(Параметры.массивПоставщиков);
	поискДоговор1.ЗагрузитьЗначения(Параметры.массивДоговоров);
	ПоставщикАкцепта = Параметры.массивПоставщиков[0];
	ДоговорАкцепта = Параметры.массивДоговоров[0];
	
	Для каждого Стр из Параметры.массивСтрок Цикл
		Нстр = СопостТЧ.Добавить();
		НСтр.Связать = Истина;
		ЗаполнитьЗначенияСвойств(НСтр, Стр);
		НСтр.НомерТД = Стр.ТранспортныйДокумент.НомерТранспортногоДокумента;
		//НСтр.ВесПоНакладной = ПретензииИНеакцептыСервер.ПолучитьВесНеттоПоНакладной(НСтр.НомерТД, НСтр.Контейнер);
		НСтр.НоменклатураИмеетНесколькоСопоставлений = ?(ПретензииИНеакцептыСервер.НоменклатуруРазрешеноСопоставлятьС(НСтр.Номенклатура, НСтр.ВесПоНакладной).Количество() > 1, 0, 1);
	КонецЦикла; 
	
	КоличествоСтрокВсего = СопостТЧ.Количество();
	СуммаСтрокВсего = СопостТЧ.Итог("ПоступлениеСумма");
	
	поискВагоны = поискВагоны1.Количество() > 0;
	поискКТК = поискКТК1.Количество() > 0;
	поискТД = поискТД1.Количество() > 0;
	поискНоменклатура = поискНоменклатура1.Количество() > 0;

	СвязыватьПоКТК = поискКТК;
	СвязыватьПоВагонам = поискВагоны;
	СвязыватьПоТранспДокументам = поискТД;
	СвязыватьПоНоменклатуре = поискНоменклатура;   
	//Евросиб - АСуслов 14.10.2022 16:33:14 #
	//(
	СвязыватьПоПериодуОказанияУслуги = ЗначениеЗаполнено(поискПериодОтправления1) ИЛИ ЗначениеЗаполнено(поискПериодПрибытия1);
	//)
	//Евросиб - АСуслов 14.10.2022 16:33:15 #
	
