&НаКлиенте
Процедура СвязатьВыбранные(Команда)
	
	Для каждого Стр1 из СопостТЧ Цикл
		Если НЕ Стр1.Связать Тогда Продолжить; КонецЕсли;
		
		Для каждого Стр2 из ТЧ Цикл
			Если НЕ Стр2.Связать Тогда Продолжить; КонецЕсли;
			
			ОбнаруженОтказ = Ложь;
			Если СвязыватьПоКТК И Найти(Стр2.СписокКТК, Стр1.Контейнер) = 0 Тогда ОбнаруженОтказ = Истина; КонецЕсли;
			Если СвязыватьПоВагонам И Найти(Стр2.СписокВагонов, Стр1.Вагон) = 0 Тогда ОбнаруженОтказ = Истина; КонецЕсли;
			
			Если СвязыватьПоТранспДокументам И Найти(Стр2.СписокТД, Стр1.НомерТД) = 0 Тогда ОбнаруженОтказ = Истина; КонецЕсли;
			
			Если СвязыватьПоНоменклатуре И Стр2.Услуга <> Стр1.Номенклатура Тогда ОбнаруженОтказ = Истина; КонецЕсли;
			
			Если СвязыватьПоПоставщикам И Стр2.Поставщик <> ПоставщикАкцепта Тогда ОбнаруженОтказ = Истина; КонецЕсли;
			Если СвязыватьПоДоговору И Стр2.Договор <> ДоговорАкцепта Тогда ОбнаруженОтказ = Истина; КонецЕсли;
			
			Если НЕ СвязыватьПоКТК И НЕ СвязыватьПоВагонам И НЕ СвязыватьПоТранспДокументам И НЕ СвязыватьПоПоставщикам И НЕ СвязыватьПоДоговору И НЕ СвязыватьПоНоменклатуре Тогда ОбнаруженОтказ = Истина; КонецЕсли;
			
			Если НЕ ОбнаруженОтказ Тогда
				
				Стр1.ИдентификаторСтрокиРасходовВСделке = Стр2.ГУИДРасходов;
				Стр1.Сделка = Стр2.Сделка;
				Стр1.ПолностьюРазнесено = Истина;
				Стр1.Связать = Ложь;
				
				Стр1.сопостНоменклатура = Стр2.Услуга;
				Стр1.сопостКТК = Стр2.СписокКТК;
				Стр1.сопостВагоны = Стр2.СписокВагонов;
				Стр1.сопостТД = Стр2.СписокТД;
				Стр1.сопостСумма = Стр2.НеРазнесено;
				Стр1.сопостСделка = Стр2.Сделка;
				
				Прервать;
				
			КонецЕсли;
			
			
		КонецЦикла;
		
	КонецЦикла;
	
	
КонецПроцедуры

