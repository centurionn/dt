Функция ПолучитьСписокНакладныхСделки(Сделка)
	
	НайдС = СделкаНакладные.НайтиСтроки(Новый Структура("Сделка", Сделка));
	Если НайдС.Количество() > 0 Тогда Возврат НайдС[0].Накладные; КонецЕсли;
	
	//Для каждого Стр из СделкаНакладные Цикл
