	Результат = СтрСоединить(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("НомерЖДН"), ";");
	
	НСтр = СделкаНакладные.Добавить();
	НСтр.Сделка = Сделка;
	НСтр.Накладные = Результат;
	
	Возврат Результат;
	
