	ОткрытьФорму("ОбщаяФорма.ВставкаИзБуфераОбмена", Новый Структура("ПередаватьИсходныеНомера, КТК", Истина, Истина), , ЭтаФорма.УникальныйИдентификатор, ,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
