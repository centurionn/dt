&НаСервере
Функция ПолучитьТекстЗапросаАвторазнесениеПоПараметрам();
	ИспользоватьРегистрРазнесениеРасходовДляРазнесенияАкцептов = ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьРегистрРазнесениеРасходовДляРазнесенияАкцептов");
	Если ИспользоватьРегистрРазнесениеРасходовДляРазнесенияАкцептов Тогда
		Возврат ПолучитьТекстЗапросаАвторазнесениеПоПараметрам_РегистрРазнесениеРасходов();
	Иначе
		Возврат ПолучитьТекстЗапросаАвторазнесениеПоПараметрам_РегистрРазнесениеЗатратПТУ();
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьТекстЗапросаАвторазнесениеПоПараметрам_РегистрРазнесениеЗатратПТУ()
	Возврат "ВЫБРАТЬ
	|	СделкаРасходы.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_СделкиПоОтборам
	|ИЗ
	|	Документ.Сделка.Расходы КАК СделкаРасходы
	|ГДЕ
	|   СделкаРасходы.УслугаОтключена = Ложь И
	|	ВЫБОР
	|			КОГДА &ПоискПоКТК
	|				ТОГДА СделкаРасходы.Контейнер В (&СписокКТК)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ПоискПоВагонам
	|				ТОГДА СделкаРасходы.Вагон В (&СписокВагонов)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ПоискПоТД
	|				ТОГДА СделкаРасходы.ТранспортныйДокумент В (&СписокТД)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РазнесениеЗатратПТУОстатки.Сделка КАК Сделка,
	|	РазнесениеЗатратПТУОстатки.ГУИДРасходов КАК ГУИДРасходов,
	|	РазнесениеЗатратПТУОстатки.ПодлежащаяРазнесениюОстаток КАК НеРазнесено,
	|	СделкаРасходы.Поставщик КАК Поставщик,
	|	СделкаРасходы.Договор КАК Договор,
	|	СделкаРасходы.Услуга КАК Услуга,
	|	СделкаРасходы.Количество КАК Количество,
	|	СделкаРасходы.СуммаИтого КАК СуммаИтого,
	|	СделкаРасходы.СуммаНДС КАК СуммаНДС,
	|	СделкаРасходы.Груз КАК Груз,
	|	СделкаРасходы.Операция КАК Операция,
	//|	СделкаСвязьУчетныхЕдиниц.Контейнер.Наименование КАК СписокКТК,
	//|	СделкаСвязьУчетныхЕдиниц.НомерЖДН КАК СписокТД,
	//|	СделкаСвязьУчетныхЕдиниц.Вагон.Наименование КАК СписокВагонов,
	|	СделкаРасходы.Контейнер.Наименование КАК СписокКТК,
	|	СделкаРасходы.ТранспортныйДокумент.НомерТранспортногоДокумента КАК СписокТД,
	|	СделкаРасходы.Вагон.Наименование КАК СписокВагонов,
	|	СделкаДоходы.УчДокумент КАК ДоходыСделкиУчДокумент,
	|	СрокиРейсыЖД.РейсДатаОтправления КАК ОтправлениеРейса,
	|	СрокиРейсыЖД.РейсДатаПрибытия КАК ПрибытиеРейса,
	|	СделкаРасходы.Валюта КАК Валюта,
	|	СделкаРасходы.ПунктОтправления КАК ПунктОтправления,
	|	СделкаРасходы.ПунктНазначения КАК ПунктНазначения
	|ИЗ
	|	РегистрНакопления.РазнесениеЗатратПТУ.Остатки КАК РазнесениеЗатратПТУОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.Расходы КАК СделкаРасходы
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.Доходы КАК СделкаДоходы
	|			ПО СделкаРасходы.Ссылка = СделкаДоходы.Ссылка
	|				И СделкаРасходы.ГУИД = СделкаДоходы.ГУИД
	//|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	//|			ПО СделкаРасходы.Ссылка = СделкаСвязьУчетныхЕдиниц.Ссылка
	//|				И СделкаРасходы.СтрокаСвязьУчетныхЕдиниц = СделкаСвязьУчетныхЕдиниц.ГУИД
	|		ПО РазнесениеЗатратПТУОстатки.Сделка = СделкаРасходы.Ссылка
	|			И РазнесениеЗатратПТУОстатки.ГУИДРасходов = СделкаРасходы.ГУИД
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			МИНИМУМ(СделкаРейсы.Рейс.ДатаОтправления) КАК РейсДатаОтправления,
	|			МАКСИМУМ(СделкаРейсы.Рейс.ДатаПрибытия) КАК РейсДатаПрибытия,
	|			СделкаРейсы.Ссылка КАК Ссылка
	|		ИЗ
	|			Документ.Сделка.Рейсы КАК СделкаРейсы
	|		ГДЕ
	|			ТИПЗНАЧЕНИЯ(СделкаРейсы.Рейс) = ТИП(Справочник.РейсыЖД)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			СделкаРейсы.Ссылка) КАК СрокиРейсыЖД
	|		ПО РазнесениеЗатратПТУОстатки.Сделка = СрокиРейсыЖД.Ссылка
	|ГДЕ
	|	РазнесениеЗатратПТУОстатки.ПолностьюРазнесеноОстаток <> 0
	|	И ВЫБОР
	|			КОГДА &ПоискПоКТК
	|					ИЛИ &ПоискПоВагонам
	|					ИЛИ &ПоискПоТД
	//|				ТОГДА РазнесениеЗатратПТУОстатки.Сделка В (&СделкиСЭтимиОтборами)
	|				ТОГДА РазнесениеЗатратПТУОстатки.Сделка В (ВЫБРАТЬ т.Ссылка ИЗ ВТ_СделкиПоОтборам Как т)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ОтборПоУслуге
	|				ТОГДА СделкаРасходы.Услуга В (&УслугиОтбор)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ОтборСтОтправления
	|				ТОГДА РазнесениеЗатратПТУОстатки.Сделка.СтанцияОтправления В ИЕРАРХИИ (&СтОтправления)
	|						ИЛИ РазнесениеЗатратПТУОстатки.Сделка.ПогранпереходИзСтраныОтправления В ИЕРАРХИИ (&СтОтправления)
	|						ИЛИ СделкаРасходы.ПунктОтправления В ИЕРАРХИИ (&СтОтправления)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ОтборСтНазначения
	|				ТОГДА РазнесениеЗатратПТУОстатки.Сделка.СтанцияНазначения В ИЕРАРХИИ (&СтНазначения)
	|						ИЛИ РазнесениеЗатратПТУОстатки.Сделка.ПогранпереходВСтрануНазначения В ИЕРАРХИИ (&СтНазначения)
	|						ИЛИ СделкаРасходы.ПунктНазначения В ИЕРАРХИИ (&СтНазначения)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ОтборПоставщик
	|				ТОГДА СделкаРасходы.Поставщик В (&Поставщики)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ОтборДоговор
	|				ТОГДА СделкаРасходы.Договор В (&Договоры)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ОтборПОтправления
	|				ТОГДА СрокиРейсыЖД.РейсДатаОтправления МЕЖДУ &ПО1 И &ПО2
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ОтборППрибытия
	|				ТОГДА СрокиРейсыЖД.РейсДатаПрибытия МЕЖДУ &ПП1 И &ПП2
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И НЕ СделкаРасходы.ВнутренняяСебестоимость
	//Евросиб Каблов 09.07.2021 ( Ticket#0236476
	|	И НЕ СделкаРасходы.Ссылка.Служебная
	//Евросиб Каблов 09.07.2021 )
	// Евросиб US 97856 TA 105372 Рыбьяков К.А. 27.03.2025 ((
	|	И НЕ СделкаРасходы.Услуга.НоменклатураДляКалькуляций";
	// Евросиб Рыбьяков К.А. 27.03.2025 ))
КонецФункции

&НаСервере
Функция ПолучитьТекстЗапросаАвторазнесениеПоПараметрам_РегистрРазнесениеРасходов()
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	РазнесениеРасходовОстатки.Сделка КАК Сделка,
	|	РазнесениеРасходовОстатки.ГУИДРасходов КАК ГУИДРасходов,
	|	СделкаРасходы.Поставщик КАК Поставщик,
	|	СделкаРасходы.Договор КАК Договор,
	|	СделкаРасходы.Услуга КАК Услуга,
	|	СделкаРасходы.Количество КАК Количество,
	|	СделкаРасходы.СуммаИтого КАК СуммаИтого,
	|	СделкаРасходы.СуммаНДС КАК СуммаНДС,
	|	СделкаРасходы.Груз КАК Груз,
	|	СделкаРасходы.Операция КАК Операция,
	|	СделкаРасходы.Контейнер.Наименование КАК СписокКТК,
	|	СделкаРасходы.ТранспортныйДокумент.НомерТранспортногоДокумента КАК СписокТД,
	|	СделкаРасходы.Вагон.Наименование КАК СписокВагонов,
	|	СрокиРейсыЖД.РейсДатаОтправления КАК ОтправлениеРейса,
