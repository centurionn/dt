&НаСервере
Функция ПолучитьТекстЗапросаДиагностикиПривязок();
	
	ИспользоватьРегистрРазнесениеРасходовДляРазнесенияАкцептов = ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьРегистрРазнесениеРасходовДляРазнесенияАкцептов");
	Если ИспользоватьРегистрРазнесениеРасходовДляРазнесенияАкцептов Тогда
		Возврат ПолучитьТекстЗапросаДиагностикиПривязок_РегистрРазнесениеРасходов();
	Иначе
		Возврат ПолучитьТекстЗапросаДиагностикиПривязок_РегистрРазнесениеЗатратПТУ();
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьТекстЗапросаДиагностикиПривязок_РегистрРазнесениеЗатратПТУ()
	Возврат	"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РазнесениеЗатратПТУ.КТК КАК КТК,
		|	РазнесениеЗатратПТУ.ДокументПТУ КАК ПТУ,
		|	РазнесениеЗатратПТУ.Сделка КАК Сделка,
		|	РазнесениеЗатратПТУ.Регистратор КАК Акцепт,
		|	СделкаРасходы.Услуга КАК Услуга,
		|	РейсыСделок.Рейс КАК Рейс
		|ИЗ
		|	РегистрНакопления.РазнесениеЗатратПТУ КАК РазнесениеЗатратПТУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.Расходы КАК СделкаРасходы
		|		ПО РазнесениеЗатратПТУ.Сделка = СделкаРасходы.Ссылка
		|			И РазнесениеЗатратПТУ.ГУИДРасходов = СделкаРасходы.ГУИД
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			СделкаРейсы.Ссылка КАК Ссылка,
		|			МАКСИМУМ(СделкаРейсы.Рейс) КАК Рейс
		|		ИЗ
		|			Документ.Сделка.Рейсы КАК СделкаРейсы
		|		ГДЕ
		|			ТИПЗНАЧЕНИЯ(СделкаРейсы.Рейс) = ТИП(Справочник.РейсыЖД)
		|		
		|		СГРУППИРОВАТЬ ПО
		|			СделкаРейсы.Ссылка) КАК РейсыСделок
		|		ПО РазнесениеЗатратПТУ.Сделка = РейсыСделок.Ссылка
		|ГДЕ
		|	РазнесениеЗатратПТУ.КТК В(&КТК)
		|	И РазнесениеЗатратПТУ.Регистратор.СторнируемыйАкцепт = ЗНАЧЕНИЕ(Документ.Акцепт.ПустаяСсылка)
		|	И НЕ РазнесениеЗатратПТУ.Регистратор В
		|				(ВЫБРАТЬ
		|					Акцепт.СторнируемыйАкцепт КАК СторнируемыйАкцепт
		|				ИЗ
		|					Документ.Акцепт КАК Акцепт)
		|ИТОГИ ПО
		|	КТК";

КонецФункции

&НаСервере
Функция ПолучитьТекстЗапросаДиагностикиПривязок_РегистрРазнесениеРасходов()
	Возврат	
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РазнесениеРасходов.Сделка КАК Сделка,
	|	РазнесениеРасходов.Регистратор КАК Акцепт,
	|	ВЫБОР
	|		КОГДА РазнесениеРасходов.Регистратор.Поступление ССЫЛКА Документ.ПоступлениеТоваровУслуг
	|			ТОГДА РазнесениеРасходов.Регистратор.Поступление
	|		ИНАЧЕ РазнесениеРасходов.Регистратор.Поступление.ИсходныйДокументПоступления
	|	КОНЕЦ КАК ПТУ,
	|	СделкаРасходы.Услуга КАК Услуга,
	|	СделкаРасходы.Контейнер КАК КТК,
	|	РейсыСделок.Рейс КАК Рейс
	|ИЗ
	|	РегистрНакопления.РазнесениеРасходов КАК РазнесениеРасходов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.Расходы КАК СделкаРасходы
	|		ПО РазнесениеРасходов.Сделка = СделкаРасходы.Ссылка
	|			И РазнесениеРасходов.ГУИДРасходов = СделкаРасходы.ГУИД
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			СделкаРейсы.Ссылка КАК Ссылка,
	|			МАКСИМУМ(СделкаРейсы.Рейс) КАК Рейс
	|		ИЗ
	|			Документ.Сделка.Рейсы КАК СделкаРейсы
	|		ГДЕ
	|			ТИПЗНАЧЕНИЯ(СделкаРейсы.Рейс) = ТИП(Справочник.РейсыЖД)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			СделкаРейсы.Ссылка) КАК РейсыСделок
	|		ПО РазнесениеРасходов.Сделка = РейсыСделок.Ссылка
	|ГДЕ
	|	СделкаРасходы.Контейнер В(&КТК)
	|	И РазнесениеРасходов.Регистратор.СторнируемыйАкцепт = ЗНАЧЕНИЕ(Документ.Акцепт.ПустаяСсылка)
	|	И НЕ РазнесениеРасходов.Регистратор В
	|				(ВЫБРАТЬ
	|					Акцепт.СторнируемыйАкцепт КАК СторнируемыйАкцепт
	|				ИЗ
	|					Документ.Акцепт КАК Акцепт)
	|ИТОГИ ПО
	|	КТК";

КонецФункции

