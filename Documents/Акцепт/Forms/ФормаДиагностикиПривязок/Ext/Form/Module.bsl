&НаКлиенте
Процедура ОтвязатьКТКВАкцептеОтСделки(Команда)
	
	ТекД = Элементы.ДЗ.ТекущиеДанные;
	Если ТекД <> неопределено И ЗначениеЗаполнено(ТекД.ПТУ) И ЗначениеЗаполнено(ТекД.КТК) Тогда
		ОтвязатьКТКОтПТУ(ТекД.ПТУ, ТекД.КТК);
	КонецЕсли;
	
