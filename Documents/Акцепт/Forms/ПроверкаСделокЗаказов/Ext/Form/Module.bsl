Процедура СписокПриИзменении(Элемент)
	
	ТекДанные = Элементы.Список.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
	
		ЗаполнитьСтрокуПолногоСписка(ТекДанные);
	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтрокуПолногоСписка(СтрокаСписка, Поля = Неопределено)

	Если Поля = Неопределено Тогда
		ИсключаемыеПоля = "НомерСтроки";
	Иначе
		ИсключаемыеПоля = Неопределено;
	КонецЕсли;
	
	СтрокиПолногоСписка = ПолныйСписок.ПолучитьЭлементы();
	Для каждого СтрокаПолногоСписка Из СтрокиПолногоСписка Цикл
	    Если СтрокаПолногоСписка.НомерСтроки = СтрокаСписка.НомерСтроки Тогда		
			ЗаполнитьЗначенияСвойств(СтрокаПолногоСписка, СтрокаСписка, Поля, ИсключаемыеПоля);		
		КонецЕсли; 	
	КонецЦикла; 

КонецПроцедуры
 

