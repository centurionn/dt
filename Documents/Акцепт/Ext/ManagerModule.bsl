Функция ПолучитьАктуальныйАкцепт(Поступление) Экспорт
	
	Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Поступление, "Организация");
	ПериодВО = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериод(Организация);
	//Евросиб Каблов 09.04.2025 ( #105407
	//ПериодБУ = Константы.ДатаПериодаЗагрузкиОДВУПП.Получить();
	ПериодБУ = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериодБУ(Организация);
	//Евросиб Каблов 09.04.2025 )
	
	//Евросиб Каблов 15.11.2021 ( Ticket#0250039
	//период во и период бу не может быть меньше месяца даты всф
	РеквизитыСФ = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьРеквизитыСчетФактуры(Поступление,"СчетФактураПолученный");
	Если РеквизитыСФ <> Неопределено Тогда
		ДатаВСФ = РеквизитыСФ.ДатаВходящегоДокумента;
	Иначе
		ДатаВСФ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Поступление, "ДатаВходящегоДокумента");
	КонецЕсли;
	ПериодВО = Макс(ПериодВО, НачалоМесяца(ДатаВСФ));
	ПериодБУ = Макс(ПериодБУ, НачалоМесяца(ДатаВСФ));
	//Евросиб Каблов 15.11.2021 )
	
	Возврат Документы.Акцепт.ПолучитьАкцептПоПоступлениюИПериоду(Поступление, ПериодВО, ПериодБУ);
	
