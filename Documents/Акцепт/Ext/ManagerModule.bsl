Функция НайтиСторнирующийАкцепт(СторнируемыйАкцепт) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Акцепт.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.Акцепт КАК Акцепт
	               |ГДЕ
	               |	Акцепт.СторнируемыйАкцепт = &СторнируемыйАкцепт
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Акцепт.ПометкаУдаления УБЫВ,
	               |	Акцепт.Номер УБЫВ";
	Запрос.УстановитьПараметр("СторнируемыйАкцепт", СторнируемыйАкцепт);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции
