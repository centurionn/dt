//Субботин 79474 25.01.2024 начало 
Процедура ЗаполнитьПериодОказанияУслуги(СтрокаАкцепта, Поступление) Экспорт

	//Субботин 82523 18.03.2024 добавил проверку, при заполненых значениях перезаполнение не требуется.
	Если ЗначениеЗаполнено(СтрокаАкцепта.НачалоОказанияУслуги) и ЗначениеЗаполнено(СтрокаАкцепта.ОкончаниеОказанияУслуги) Тогда Возврат КонецЕсли;
	//Субботин 82523 18.03.2024

	ПравилаОпределенияПериодаОказанияУслуги = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаАкцепта.Номенклатура, 
																	"ОграничитьДатуНачалаОказанияУслуги,
																	|ОграничитьДатуОкончанияОказанияУслуги,
																	|КоличествоДнейДоДатыОказанияУслуги,
																	|КоличествоДнейПослеДатыОказанияУслуги,
																	//Субботин 79474 25.01.2024 Начало
																	|ИсточникДатыОказанияУслуги");
																	//Субботин 79474 25.01.2024 Конец
	ДатаАкта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Поступление, "ДатаВходящегоДокумента");
	Если НЕ ЗначениеЗаполнено(ДатаАкта) Тогда
		Возврат;
	КонецЕсли;                               
	ДеньВСекундах = 60*60*24; 
	
	//Субботин 79474 31.01.2024 Начало
	Если ПравилаОпределенияПериодаОказанияУслуги.ИсточникДатыОказанияУслуги = 1   //ЖД Накладная(1)
		Или ПравилаОпределенияПериодаОказанияУслуги.ИсточникДатыОказанияУслуги = 2 Тогда   // или Коносамент(2)
	   	ДатыЖДН = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаАкцепта.ТранспортныйДокумент, "ДатаОтправления, ДатаПрибытия, ДатаОтправленияПлан, ДатаПрибытияПлан");
	КонецЕсли;
	//Субботин 79474 31.01.2024 Конец
	
	//Субботин 79474 25.01.2024 Начало  добавил условия по источникам
	Если ПравилаОпределенияПериодаОказанияУслуги.ИсточникДатыОказанияУслуги = 0 Тогда //Входящая дата документа
	//Субботин 79474 25.01.2024 Конец  добавил условия по источникам
		
		//начало оказания услуги
		Если ПравилаОпределенияПериодаОказанияУслуги.ОграничитьДатуНачалаОказанияУслуги Тогда
			ДатаНачалаОказанияУслуги = ДатаАкта - ПравилаОпределенияПериодаОказанияУслуги.КоличествоДнейДоДатыОказанияУслуги * ДеньВСекундах;
		КонецЕсли;      
		//окончания оказания услуги
		Если ПравилаОпределенияПериодаОказанияУслуги.ОграничитьДатуОкончанияОказанияУслуги Тогда
			ДатаОкончаниеОказанияУслуги = ДатаАкта + ПравилаОпределенияПериодаОказанияУслуги.КоличествоДнейПослеДатыОказанияУслуги * ДеньВСекундах;
		КонецЕсли;
		
		//Субботин 79474 25.01.2024 Начало новые условия	
	ИначеЕсли ПравилаОпределенияПериодаОказанияУслуги.ИсточникДатыОказанияУслуги = 1 //ЖД Накладная(1)
		Или ПравилаОпределенияПериодаОказанияУслуги.ИсточникДатыОказанияУслуги = 2 Тогда // или Коносамент(2)
	
		//начало оказания услуги
		Если ПравилаОпределенияПериодаОказанияУслуги.ОграничитьДатуНачалаОказанияУслуги Тогда
			Если ЗначениеЗаполнено(ДатыЖДН.ДатаОтправления) Тогда
				ДатаНачалаОказанияУслуги = ДатыЖДН.ДатаОтправления - ПравилаОпределенияПериодаОказанияУслуги.КоличествоДнейДоДатыОказанияУслуги * ДеньВСекундах;
			//если коносамент доп проверка плановой даты
			ИначеЕсли ЗначениеЗаполнено(ДатыЖДН.ДатаОтправленияПлан) и ПравилаОпределенияПериодаОказанияУслуги.ИсточникДатыОказанияУслуги = 2 Тогда 
				ДатаНачалаОказанияУслуги = ДатыЖДН.ДатаОтправленияПлан - ПравилаОпределенияПериодаОказанияУслуги.КоличествоДнейДоДатыОказанияУслуги * ДеньВСекундах; 
			КонецЕсли; 
		КонецЕсли;		
		//окончания оказания услуги
		Если ПравилаОпределенияПериодаОказанияУслуги.ОграничитьДатуОкончанияОказанияУслуги Тогда			
			Если ЗначениеЗаполнено(ДатыЖДН.ДатаПрибытия) Тогда
				ДатаОкончаниеОказанияУслуги = ДатыЖДН.ДатаПрибытия + ПравилаОпределенияПериодаОказанияУслуги.КоличествоДнейПослеДатыОказанияУслуги * ДеньВСекундах;
			//Если ЖДН доп проверка Даты отправления 
			ИначеЕсли ЗначениеЗаполнено(ДатыЖДН.ДатаОтправления) и ПравилаОпределенияПериодаОказанияУслуги.ИсточникДатыОказанияУслуги = 1 Тогда
				ДатаОкончаниеОказанияУслуги = ДатыЖДН.ДатаОтправления + ПравилаОпределенияПериодаОказанияУслуги.КоличествоДнейПослеДатыОказанияУслуги * ДеньВСекундах;
			//если коносамент доп проверка плановой даты
			ИначеЕсли ЗначениеЗаполнено(ДатыЖДН.ДатаПрибытияПлан) и ПравилаОпределенияПериодаОказанияУслуги.ИсточникДатыОказанияУслуги = 2 Тогда 
				ДатаОкончаниеОказанияУслуги = ДатыЖДН.ДатаПрибытияПлан + ПравилаОпределенияПериодаОказанияУслуги.КоличествоДнейПослеДатыОказанияУслуги * ДеньВСекундах; 
			КонецЕсли;		
		КонецЕсли;
	КонецЕсли;
	 //Субботин 82523 18.03.2024 баг //Добавил проверки начало
	Если НЕ ЗначениеЗаполнено(СтрокаАкцепта.НачалоОказанияУслуги) Тогда 		
		СтрокаАкцепта.НачалоОказанияУслуги = ДатаНачалаОказанияУслуги;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(СтрокаАкцепта.ОкончаниеОказанияУслуги) Тогда 
		СтрокаАкцепта.ОкончаниеОказанияУслуги = ДатаОкончаниеОказанияУслуги; 
	КонецЕсли;
	//Субботин 82523 18.03.2024 баг //Добавил  проверки конец
	
КонецПроцедуры	
