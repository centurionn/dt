Функция ДокументВыгруженВУПП(Ссылка) Экспорт
	
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПротоколОбменов.УИДИсточника КАК УИДИсточника
	|ИЗ
	|	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	|ГДЕ
	|	ПротоколОбменов.Объект = &Ссылка
	|	И ПротоколОбменов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных)
	|	И ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.УПП)";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = ЗначениеЗаполнено(Выборка.УИДИсточника);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументДоступенДляСторно(Ссылка) Экспорт
	
	Результат = Ложь;
	//Евросиб СубботинВ Подправил баг открытия формы 27.06.2025 Начало
	Если ЗначениеЗаполнено(Ссылка.Поступление) Тогда
		Поступление = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Поступление");
		Акцепт = ПолучитьАкцептДоступныйДляСторно(Поступление);
		
		Если ЗначениеЗаполнено(Акцепт) И Акцепт = Ссылка Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	//Евросиб СубботинВ Подправил баг открытия формы 27.06.2025 Конец	
	
	Возврат Результат;

КонецФункции

Процедура СоздатьСторноПоследнегоАкцептаПоПоступлению(Поступление, ДатаСторно, СторнироватьПоступление = ЛОЖЬ, ДополнительныеСвойства = Неопределено) Экспорт
	
	Акцепт = ПолучитьАкцептДоступныйДляСторно(Поступление);
	
	Если ЗначениеЗаполнено(Акцепт) Тогда
//Евросиб Гудкова( 05.02.2021 Ticket№ 0220495
//		АкцептСторно = Документы.Акцепт.СоздатьДокумент();
		АкцептСторноСсылка = НайтиСторнирующийАкцепт(Акцепт);
		Если ЗначениеЗаполнено(АкцептСторноСсылка) Тогда
			АкцептСторно = АкцептСторноСсылка.ПолучитьОбъект();
			АкцептСторно.ПометкаУдаления = Ложь;
		Иначе
			АкцептСторно = Документы.Акцепт.СоздатьДокумент();
		КонецЕсли; 
// Евросиб Гудкова)
		//Евросиб Каблов 19.02.2021 (
		ПустаяДата = '00010101';
		АкцептСторно.ПериодБУ = ПустаяДата;
		АкцептСторно.ПериодВО = ПустаяДата;
		//Евросиб Каблов 19.02.2021 ) 
		АкцептСторно.Заполнить(Новый Структура("СторнируемыйАкцепт", Акцепт));
		АкцептСторно.Дата = ДатаСторно;               
		Если ТипЗнч(ДополнительныеСвойства) = Тип("Структура") 
			И ДополнительныеСвойства.Свойство("ЗаписьИзСделки") Тогда
			АкцептСторно.ДополнительныеСвойства.Вставить("ЗаписьИзСделки", Истина);
		КонецЕсли;                         
		Если ДополнительныеСвойства <> Неопределено И ДополнительныеСвойства.Свойство("НеДобавлятьСторноВОчередьОтложенногоИзмененияВзаимосвязанныхОбъектов") Тогда
			АкцептСторно.ДополнительныеСвойства.Вставить("НеДобавлятьСторноВОчередьОтложенногоИзмененияВзаимосвязанныхОбъектов", Истина);
		КонецЕсли;
		АкцептСторно.Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;
	
КонецПроцедуры

