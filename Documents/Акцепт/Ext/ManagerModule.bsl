Процедура ЗаполнитьКорректировочныеАкцепты(Поступление) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КорректировкаПоступления.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КорректировкаПоступления КАК КорректировкаПоступления
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Акцепт КАК Акцепт
	|		ПО КорректировкаПоступления.Ссылка = Акцепт.Поступление
	|			И (Акцепт.Проведен)
	|ГДЕ
	|	КорректировкаПоступления.ДокументПоступления = &ДокументПоступления
	|	И КорректировкаПоступления.ВидОперации <> ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки)
	|	И КорректировкаПоступления.Проведен";
	Запрос.УстановитьПараметр("ДокументПоступления", Поступление);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		КорректировкаПоступления = Выборка.Ссылка;
		
		Акцепт = НайтиСоздатьАктуальныйАкцепт(КорректировкаПоступления, Ложь);
		Акцепт.Заполнить(КорректировкаПоступления);
		
		ПредыдущийАкцепт = Документы.Акцепт.ПолучитьДанныеПоследнегоПроведенногоАкцепта(КорректировкаПоступления).АкцептСсылка;
		Если ЗначениеЗаполнено(ПредыдущийАкцепт) Тогда
			АкцептИзменен = Не ОбщегоНазначения.КоллекцииИдентичны(ПредыдущийАкцепт.Услуги.выгрузить(), Акцепт.Услуги.выгрузить(),, "НомерСтроки, ГУИД", Ложь);
		Иначе
			АкцептИзменен = Истина;
		КонецЕсли;
		
		Если АкцептИзменен Тогда
			Акцепт.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

