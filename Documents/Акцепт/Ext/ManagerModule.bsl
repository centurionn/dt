Функция ПолучитьКорректировкуПоступления(Поступление) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КорректировкаПоступления.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КорректировкаПоступления КАК КорректировкаПоступления
	|ГДЕ
	|	КорректировкаПоступления.Проведен = ИСТИНА
	|	И КорректировкаПоступления.ИсходныйДокументПоступления = &ДокументПоступления
	|	И КорректировкаПоступления.ВидОперации = Значение(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки)
	|	И КорректировкаПоступления.ИсходныйДокументПоступления ССЫЛКА Документ.ПоступлениеТоваровУслуг
	|
	|УПОРЯДОЧИТЬ ПО
	|	КорректировкаПоступления.Дата УБЫВ";
	Запрос.УстановитьПараметр("ДокументПоступления", Поступление);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Корректировка = Выборка.Ссылка;
	Иначе
		Корректировка = Документы.КорректировкаПоступления.ПустаяСсылка();
	КонецЕсли;
		
	Возврат Корректировка;

