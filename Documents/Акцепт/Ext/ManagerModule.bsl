Процедура ЗаписатьОшибкуВСтрокуАкцепта(ОбъектСделка, ИсточникиОбработчика, ТекстОшибки) Экспорт
	
	Если ОбъектСделка.ДополнительныеСвойства.Свойство("ДанныеДляЗаполненияСделкиИзАкцепта") Тогда
		
		Для Каждого ИсточникИзменения Из ИсточникиОбработчика Цикл
		
		ОбработанныеСтроки = ОбъектСделка.ДополнительныеСвойства.ДанныеДляЗаполненияСделкиИзАкцепта;
		
			Для Каждого Строка Из ОбработанныеСтроки Цикл
			
				Если СтрНайти(ТекстОшибки, "Конфликт блокировок") > 0 
					//Евросиб - АСуслов 28.10.2024 13:52:15 #93358
					//(
					ИЛИ СтрНайти(ТекстОшибки, "несоответствия версии") > 0 Тогда
					//)
					//Евросиб - АСуслов 28.10.2024 13:52:19 #93358
					МенеджерЗаписи = РегистрыСведений.ДанныеДляДобавленияСтрокАкцептовВСделку.СоздатьМенеджерЗаписи();
					МенеджерЗаписи.ПТУ = Строка.ПТУ;
					МенеджерЗаписи.ГУИД = Строка.ГУИД;
					МенеджерЗаписи.Прочитать();
					Если МенеджерЗаписи.Выбран() Тогда
						МенеджерЗаписи.Обработано = Ложь;
						МенеджерЗаписи.Записать();
					КонецЕсли;
				Иначе
					Поступление = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИсточникИзменения, "Поступление");
					ОтложенноеИзменениеСервер.ПоставитьОбъектВОчередьИзменения(Поступление, ОбъектСделка.Ссылка);
					
					МенеджерЗаписи = РегистрыСведений.ОчередьОтложенногоИзмененияВзаимосвязанныхОбъектов.СоздатьМенеджерЗаписи();
					МенеджерЗаписи.ОбрабатываемыйОбъект = ОбъектСделка.Ссылка;
					МенеджерЗаписи.ИсточникИзменения = ИсточникИзменения;
					МенеджерЗаписи.Прочитать();
					Если МенеджерЗаписи.Выбран() Тогда
						МенеджерЗаписи.Обработано = Истина;
						МенеджерЗаписи.ДатаНачалаОбработки = ТекущаяДата();
						МенеджерЗаписи.ДатаОбработки = ТекущаяДата();
						МенеджерЗаписи.ОшибкаПриОбработке = Истина;
						МенеджерЗаписи.ТекстОшибки = ТекстОшибки;
						МенеджерЗаписи.Записать();
					КонецЕсли;
					
					МенеджерЗаписи = РегистрыСведений.ДанныеДляДобавленияСтрокАкцептовВСделку.СоздатьМенеджерЗаписи();
					МенеджерЗаписи.ПТУ = Строка.ПТУ;
					МенеджерЗаписи.ГУИД = Строка.ГУИД;
					МенеджерЗаписи.Прочитать();
					Если МенеджерЗаписи.Выбран() Тогда
						МенеджерЗаписи.Обработано = Ложь;
						МенеджерЗаписи.ОбработаноСОшибкой = Истина;
						МенеджерЗаписи.ТекстОшибки = ТекстОшибки;
						МенеджерЗаписи.Записать();
					КонецЕсли;	
				КонецЕсли;
			КонецЦикла;
		КонецЦикла; 
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьЗаписьВОчередиНаОбработку(Поступление, ГУИД)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеДляДобавленияСтрокАкцептовВСделку.ГУИД КАК ГУИД
	|ИЗ
	|	РегистрСведений.ДанныеДляДобавленияСтрокАкцептовВСделку КАК ДанныеДляДобавленияСтрокАкцептовВСделку
	|ГДЕ
	|	ДанныеДляДобавленияСтрокАкцептовВСделку.ПТУ = &Поступление
	|	И ДанныеДляДобавленияСтрокАкцептовВСделку.ГУИД = &ГУИД
	|	И ДанныеДляДобавленияСтрокАкцептовВСделку.Обработано = Ложь";
	
	Запрос.УстановитьПараметр("ГУИД", ГУИД);
	Запрос.УстановитьПараметр("Поступление", Поступление);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
		
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.ДанныеДляДобавленияСтрокАкцептовВСделку.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ПТУ = Поступление;
		МенеджерЗаписи.ГУИД = ГУИД;
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Обработано = Истина;
			МенеджерЗаписи.Записать();
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры
