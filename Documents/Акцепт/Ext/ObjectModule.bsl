			ИначеЕсли НоваяСтрока.ПолностьюРазнесено Тогда
				ТекСтрокиАкцептаРаспред.Вставить(0,НоваяСтрока);
				КоличествоРаспред = КоличествоРаспред + НоваяСтрока.ПоступлениеКоличество; 
				СуммаРаспред = СуммаРаспред + НоваяСтрока.ПоступлениеСумма;			
				СуммаНДСРаспред = СуммаНДСРаспред + НоваяСтрока.ПоступлениеСуммаНДС; 
			Иначе	
				ТекСтрокиАкцептаСвободные.Вставить(0,НоваяСтрока);
				КоличествоСвободные = КоличествоСвободные + НоваяСтрока.ПоступлениеКоличество; 
				СуммаСвободные = СуммаСвободные + НоваяСтрока.ПоступлениеСумма;			
				СуммаНДССвободные = СуммаНДССвободные + НоваяСтрока.ПоступлениеСуммаНДС; 
			КонецЕсли;
			
			//Сохраним исподьзованные значения аналитик
			Если ЗначениеЗаполнено(НоваяСтрока.Контейнер) И
				МассивКТК.Найти(НоваяСтрока.Контейнер) = Неопределено
				Тогда
				МассивКТК.Добавить(НоваяСтрока.Контейнер);		
			ИначеЕсли ЗначениеЗаполнено(НоваяСтрока.Вагон) И 
				МассивВагонов.Найти(НоваяСтрока.Вагон) = Неопределено
				Тогда	
				МассивВагонов.Добавить(НоваяСтрока.Вагон);
			ИначеЕсли ЗначениеЗаполнено(НоваяСтрока.ТранспортныйДокумент) И 
				МассивТД.Найти(НоваяСтрока.ТранспортныйДокумент) = Неопределено
				Тогда
				МассивТД.Добавить(НоваяСтрока.ТранспортныйДокумент);	
			КонецЕсли;
			
		КонецЦикла;

		Для каждого СтрокаКорр Из СтрокиПоКорректировкеПервичка Цикл
			//Сохраним исподьзованные значения аналитик
			Если ЗначениеЗаполнено(СтрокаКорр.Контейнер) И
				МассивКТК_Корр.Найти(СтрокаКорр.Контейнер) = Неопределено
				Тогда
				МассивКТК_Корр.Добавить(СтрокаКорр.Контейнер);		
			ИначеЕсли ЗначениеЗаполнено(СтрокаКорр.Вагон) И 
				МассивВагонов_Корр.Найти(СтрокаКорр.Вагон) = Неопределено
				Тогда	
				МассивВагонов_Корр.Добавить(СтрокаКорр.Вагон);
			ИначеЕсли ЗначениеЗаполнено(СтрокаКорр.ТранспортныйДокумент) И 
				МассивТД_Корр.Найти(СтрокаКорр.ТранспортныйДокумент) = Неопределено
				Тогда
				МассивТД_Корр.Добавить(СтрокаКорр.ТранспортныйДокумент);	
			КонецЕсли;
		КонецЦикла;
		
		
		//ДельтаКоличества = СтрокаКорректировки.Количество - СтрокаКорректировки.КоличествоДоИзменения;
		КоличествоПредыдущийАкцепт = (КоличествоСвободные+КоличествоРаспред+КоличествоЗафикс);
		
		//Пред акцепт был нормальный по количеству
		Если КоличествоПредыдущийАкцепт = СтрокаКорректировки.КоличествоДоИзменения Тогда
			ДельтаКоличества = СтрокаКорректировки.Количество - КоличествоПредыдущийАкцепт;
		//Пред акцепт был нормальный по количеству, но были отклонения, например ввели претензию по КТК, это доп строка в акцепте, увеличивает количество	
		ИначеЕсли (МассивКТК.Количество() + МассивВагонов.Количество()) = СтрокаКорректировки.КоличествоДоИзменения  
			Тогда
		    ДельтаКоличества = СтрокаКорректировки.Количество - СтрокаКорректировки.КоличествоДоИзменения;
		//Пред акцепт был НЕ нормальный - не выправляем его по количеству.	
		Иначе	
			ДельтаКоличества = 0;
		КонецЕсли;
		
		Если ДельтаКоличества > 0 
			//Это важно, так как если количество поступления не совпадает с количеством в предыдущем акцепте, то и не пытаемся это исправить
			и КоличествоПредыдущийАкцепт = СтрокаКорректировки.КоличествоДоИзменения 
			Тогда                                            
			ДельтаКоличестваДляДобавления = ДельтаКоличества; 
			//Сначала пытаемся добавлять строки на основе таблицы, которая была бы без акцепта
			Для каждого СтрокаКорПервичка Из СтрокиПоКорректировкеПервичка Цикл
				
				//Проверяем, что строка не была использована в акцепте по схожей аналитике
				ИндексПоиска = Неопределено;
				Если ЗначениеЗаполнено(СтрокаКорПервичка.Контейнер) Тогда
					ИндексПоиска = МассивКТК.Найти(СтрокаКорПервичка.Контейнер);		
				ИначеЕсли ЗначениеЗаполнено(СтрокаКорПервичка.Вагон) Тогда	
					ИндексПоиска = МассивВагонов.Найти(СтрокаКорПервичка.Вагон);
				ИначеЕсли ЗначениеЗаполнено(СтрокаКорПервичка.ТранспортныйДокумент) Тогда
					ИндексПоиска = МассивТД.Найти(СтрокаКорПервичка.ТранспортныйДокумент);	
				КонецЕсли;
				
				Если ИндексПоиска = неопределено Тогда
					НоваяСтрока = ВремТаблицаУслуг.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКорПервичка);
					ТекСтрокиАкцептаСвободные.Добавить(НоваяСтрока);
					КоличествоСвободные = КоличествоСвободные + НоваяСтрока.ПоступлениеКоличество; 
					СуммаСвободные = СуммаСвободные + НоваяСтрока.ПоступлениеСумма;			
					СуммаНДССвободные = СуммаНДССвободные + НоваяСтрока.ПоступлениеСуммаНДС; 
					ДельтаКоличестваДляДобавления = ДельтаКоличестваДляДобавления - 1;
				КонецЕсли;
				
				Если ДельтаКоличестваДляДобавления = 0 Тогда
					Прервать;	
				КонецЕсли;
			КонецЦикла; 
			//Все по последней строке будет максимально пустая аналитика
			Пока ДельтаКоличестваДляДобавления>0 Цикл
				НоваяСтрока = ВремТаблицаУслуг.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКорПервичка);
				ТекСтрокиАкцептаСвободные.Добавить(НоваяСтрока);
				КоличествоСвободные = КоличествоСвободные + НоваяСтрока.ПоступлениеКоличество; 
				СуммаСвободные = СуммаСвободные + НоваяСтрока.ПоступлениеСумма;			
				СуммаНДССвободные = СуммаНДССвободные + НоваяСтрока.ПоступлениеСуммаНДС;			
				ДельтаКоличестваДляДобавления = ДельтаКоличестваДляДобавления - 1;
			КонецЦикла;	
		ИначеЕсли ДельтаКоличества < 0 Тогда
			ДельтаКоличестваДляУдаления = ДельтаКоличества*(-1);
			Для каждого СтрокаАкцептаНаУдаление Из ТекСтрокиАкцептаСвободные Цикл
				Если ДельтаКоличестваДляУдаления = 0 Тогда
					Прервать;
				КонецЕсли;

				//Проверяем, что строки нет в акцепте прототипе по корр по схожей аналитике, тогда можно удалять
				ИндексПоиска = Неопределено;
				Если ЗначениеЗаполнено(СтрокаАкцептаНаУдаление.Контейнер) Тогда
					ИндексПоиска = МассивКТК_Корр.Найти(СтрокаАкцептаНаУдаление.Контейнер);		
				ИначеЕсли ЗначениеЗаполнено(СтрокаАкцептаНаУдаление.Вагон) Тогда	
					ИндексПоиска = МассивВагонов_Корр.Найти(СтрокаАкцептаНаУдаление.Вагон);
				//ИначеЕсли ЗначениеЗаполнено(СтрокаКорПервичка.ТранспортныйДокумент) Тогда
				//	ИндексПоиска = МассивТД.Найти(СтрокаКорПервичка.ТранспортныйДокумент);	
				Иначе
					//"Пустая аналитика можно удалять";
				КонецЕсли;
				Если Не ИндексПоиска = неопределено Тогда
					Продолжить;		
				КонецЕсли;
				
				Если СтрокаАкцептаНаУдаление.ПоступлениеКоличество>ДельтаКоличестваДляУдаления Тогда
					КоличестваДляУдаленияТекстрока = ДельтаКоличестваДляУдаления;	
				Иначе
					КоличестваДляУдаленияТекстрока = СтрокаАкцептаНаУдаление.ПоступлениеКоличество;	
				КонецЕсли;
				СуммаДляУдаленияТекстрока = Окр(СтрокаАкцептаНаУдаление.ПоступлениеСумма/СтрокаАкцептаНаУдаление.ПоступлениеКоличество*КоличестваДляУдаленияТекстрока,2);
				СуммаНДСДляУдаленияТекстрока = Окр(СтрокаАкцептаНаУдаление.ПоступлениеСуммаНДС/СтрокаАкцептаНаУдаление.ПоступлениеКоличество*КоличестваДляУдаленияТекстрока,2);
				
				СтрокаАкцептаНаУдаление.ПоступлениеКоличество = СтрокаАкцептаНаУдаление.ПоступлениеКоличество - КоличестваДляУдаленияТекстрока;		
				СтрокаАкцептаНаУдаление.ПоступлениеСумма = СтрокаАкцептаНаУдаление.ПоступлениеСумма - СуммаДляУдаленияТекстрока;
				СтрокаАкцептаНаУдаление.ПоступлениеСуммаНДС = СтрокаАкцептаНаУдаление.ПоступлениеСуммаНДС - СуммаНДСДляУдаленияТекстрока;
				ДельтаКоличестваДляУдаления = ДельтаКоличестваДляУдаления - КоличестваДляУдаленияТекстрока;
				
				// ++ ДИТ_Агафонов_task 41390 09.03.2023
				Если ЗначениеЗаполнено(СтрокаАкцептаНаУдаление.Сумма) Тогда
					СтрокаАкцептаНаУдаление.Сумма = СтрокаАкцептаНаУдаление.ПоступлениеСумма;	
					СтрокаАкцептаНаУдаление.СуммаНДС = СтрокаАкцептаНаУдаление.ПоступлениеСуммаНДС;	
				КонецЕсли;
				// -- ДИТ_Агафонов_task 41390 09.03.2023
				
				КоличествоСвободные = КоличествоСвободные - КоличестваДляУдаленияТекстрока; 
				СуммаСвободные = СуммаСвободные - СуммаДляУдаленияТекстрока;			
				СуммаНДССвободные = СуммаНДССвободные - СуммаНДСДляУдаленияТекстрока;
			КонецЦикла;
			Для каждого СтрокаАкцептаНаУдаление Из ТекСтрокиАкцептаРаспред Цикл
				Если ДельтаКоличестваДляУдаления = 0 Тогда
					Прервать;
				КонецЕсли;

				//Проверяем, что строки нет в акцепте прототипе по корр по схожей аналитике, тогда можно удалять
				ИндексПоиска = Неопределено;
				Если ЗначениеЗаполнено(СтрокаАкцептаНаУдаление.Контейнер) Тогда
					ИндексПоиска = МассивКТК_Корр.Найти(СтрокаАкцептаНаУдаление.Контейнер);		
				ИначеЕсли ЗначениеЗаполнено(СтрокаАкцептаНаУдаление.Вагон) Тогда	
					ИндексПоиска = МассивВагонов_Корр.Найти(СтрокаАкцептаНаУдаление.Вагон);
				//ИначеЕсли ЗначениеЗаполнено(СтрокаКорПервичка.ТранспортныйДокумент) Тогда
				//	ИндексПоиска = МассивТД.Найти(СтрокаКорПервичка.ТранспортныйДокумент);	
				Иначе
					//"Пустая аналитика можно удалять";
				КонецЕсли;
				Если Не ИндексПоиска = неопределено Тогда
					Продолжить;		
				КонецЕсли;

				Если СтрокаАкцептаНаУдаление.ПоступлениеКоличество>ДельтаКоличестваДляУдаления Тогда
					КоличестваДляУдаленияТекстрока = ДельтаКоличестваДляУдаления;	
				Иначе
					КоличестваДляУдаленияТекстрока = СтрокаАкцептаНаУдаление.ПоступлениеКоличество;	
				КонецЕсли;
				СуммаДляУдаленияТекстрока = Окр(СтрокаАкцептаНаУдаление.ПоступлениеСумма/СтрокаАкцептаНаУдаление.ПоступлениеКоличество*КоличестваДляУдаленияТекстрока,2);
				СуммаНДСДляУдаленияТекстрока = Окр(СтрокаАкцептаНаУдаление.ПоступлениеСуммаНДС/СтрокаАкцептаНаУдаление.ПоступлениеКоличество*КоличестваДляУдаленияТекстрока,2);
				
				СтрокаАкцептаНаУдаление.ПоступлениеКоличество = СтрокаАкцептаНаУдаление.ПоступлениеКоличество - КоличестваДляУдаленияТекстрока;		
				СтрокаАкцептаНаУдаление.ПоступлениеСумма = СтрокаАкцептаНаУдаление.ПоступлениеСумма - СуммаДляУдаленияТекстрока;
				СтрокаАкцептаНаУдаление.ПоступлениеСуммаНДС = СтрокаАкцептаНаУдаление.ПоступлениеСуммаНДС - СуммаНДСДляУдаленияТекстрока;
				ДельтаКоличестваДляУдаления = ДельтаКоличестваДляУдаления - КоличестваДляУдаленияТекстрока;
				
				// ++ ДИТ_Агафонов_task 41390 09.03.2023
				Если ЗначениеЗаполнено(СтрокаАкцептаНаУдаление.Сумма) Тогда
					СтрокаАкцептаНаУдаление.Сумма = СтрокаАкцептаНаУдаление.ПоступлениеСумма;	
					СтрокаАкцептаНаУдаление.СуммаНДС = СтрокаАкцептаНаУдаление.ПоступлениеСуммаНДС;	
				КонецЕсли;
				// -- ДИТ_Агафонов_task 41390 09.03.2023

				КоличествоРаспред = КоличествоРаспред - КоличестваДляУдаленияТекстрока; 
				СуммаРаспред = СуммаРаспред - СуммаДляУдаленияТекстрока;
				СуммаНДСРаспред = СуммаНДСРаспред - СуммаНДСДляУдаленияТекстрока;
			КонецЦикла;
			//Если кончились строки, а дельта осталась, то не беда - нужная строка с минусом добавится на этапе отработки дельты суммы.
			
			// ++ ДИТ_Агафонов_task 41390 08.03.2023
			//Доп который все меняет - так теперь требуется не работать с одной строкой
			//Пытаемся сторнировать строки фиксированные
			Для каждого СтрокаАкцептаНаУдаление Из ТекСтрокиАкцептаЗафикс Цикл
				Если ДельтаКоличестваДляУдаления = 0 Тогда
					Прервать;
				КонецЕсли;
				Если СтрокаАкцептаНаУдаление.ПоступлениеКоличество>ДельтаКоличестваДляУдаления Тогда
					КоличестваДляУдаленияТекстрока = ДельтаКоличестваДляУдаления;	
				Иначе
					КоличестваДляУдаленияТекстрока = СтрокаАкцептаНаУдаление.ПоступлениеКоличество;	
				КонецЕсли;
				СуммаДляУдаленияТекстрока = Окр(СтрокаАкцептаНаУдаление.ПоступлениеСумма/СтрокаАкцептаНаУдаление.ПоступлениеКоличество*КоличестваДляУдаленияТекстрока,2);
				СуммаНДСДляУдаленияТекстрока = Окр(СтрокаАкцептаНаУдаление.ПоступлениеСуммаНДС/СтрокаАкцептаНаУдаление.ПоступлениеКоличество*КоличестваДляУдаленияТекстрока,2);
				НоваяСтрока = ВремТаблицаУслуг.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаАкцептаНаУдаление,"Номенклатура,НоменклатурнаяГруппа,ИдентификаторСтрокиПоступления,Контейнер,Вагон,ТранспортныйДокумент,ПоступлениеСтавкаНДС,СтанцияОтправления,СтанцияНазначения");
				НоваяСтрока.ПоступлениеКоличество = КоличестваДляУдаленияТекстрока * (-1);
				НоваяСтрока.ПоступлениеСумма = СуммаДляУдаленияТекстрока * (-1);
				НоваяСтрока.ПоступлениеСуммаНДС = СуммаНДСДляУдаленияТекстрока * (-1);
				СуммаЗафикс = СуммаЗафикс + НоваяСтрока.ПоступлениеСумма;
				СуммаНДСЗафикс = СуммаНДСЗафикс + НоваяСтрока.ПоступлениеСуммаНДС;
				КоличествоЗафикс = КоличествоЗафикс + НоваяСтрока.ПоступлениеКоличество;
				ТекСтрокиАкцептаЗафиксСторнированные.Добавить(СтрокаАкцептаНаУдаление);
			КонецЦикла;
			// -- ДИТ_Агафонов_task 41390 08.03.2023
		КонецЕсли;
		
		ДельтаСуммы = СтрокаКорректировки.Всего - (СуммаСвободные+СуммаРаспред+СуммаЗафикс);
		ДельтаСуммыНДС = СтрокаКорректировки.СуммаНДС - (СуммаНДССвободные+СуммаНДСРаспред+СуммаНДСЗафикс);
		ДельтаЦены = СтрокаКорректировки.Цена - СтрокаКорректировки.ЦенаДоИзменения;
		
		Если ДельтаСуммы <> 0 или ДельтаСуммыНДС<>0 Тогда
			КоличествоДляРаспределения = КоличествоРаспред + КоличествоСвободные;
			// ++ ДИТ_Агафонов_task 41390 08.03.2023
			//Доп который все меняет - так теперь требуется не работать с одной строкой
			КоличествоДляРаспределения = КоличествоДляРаспределения + КоличествоЗафикс;
			// -- ДИТ_Агафонов_task 41390 08.03.2023
			Если КоличествоДляРаспределения=0 Тогда
				КоличествоДляРаспределения = 1;
