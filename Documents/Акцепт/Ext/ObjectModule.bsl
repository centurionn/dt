	//Евросиб - АСуслов 24.03.2021 19:23:30 #НЗП
	//(
	ИменаРеквизитов = "Номенклатура,НоменклатурнаяГруппа,ПоступлениеСтавкаНДС,ПоступлениеСуммаНДС,ПоступлениеСумма,Сумма,СуммаНДС,ВидРасходов,СуммаПретензии,ВидЗатрат";
	//)
	//Евросиб - АСуслов 24.03.2021 19:23:33 #НЗП
	
	Реквизиты = СтрРазделить(ИменаРеквизитов, ",", Ложь);
	
	ПоляЗапроса = Новый Массив;
	Для Каждого Реквизит Из Реквизиты Цикл
		ПоляЗапроса.Добавить(СтрШаблон("Таблица.%1 КАК %1", Реквизит));
	КонецЦикла;
	ТекстЗапросаПоля = СтрСоединить(ПоляЗапроса, "," + Символы.ПС + Символы.Таб);	
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Таблица.ИдентификаторСтрокиПоступления КАК ИдентификаторСтрокиПоступления,
	|	//Проверяемые поля
	|ИЗ
	|	Документ.Акцепт.Услуги КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка = &Ссылка";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//Проверяемые поля", ТекстЗапросаПоля);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);	
	ТаблицаУслуги = Запрос.Выполнить().Выгрузить();	
	
	Для Каждого СтрокаТЧ Из Услуги Цикл
		НайденныеСтроки = ТаблицаУслуги.НайтиСтроки(Новый Структура("ИдентификаторСтрокиПоступления", СтрокаТЧ.ИдентификаторСтрокиПоступления));
		Если НайденныеСтроки.Количество() > 0 Тогда
			Для Каждого СтрокаТЗ Из НайденныеСтроки Цикл
				Для Каждого Реквизит Из Реквизиты Цикл
					Если СтрокаТЧ[Реквизит] <> СтрокаТЗ[Реквизит] Тогда
						Возврат Истина;
					КонецЕсли;					
				КонецЦикла;
				ТаблицаУслуги.Удалить(СтрокаТЗ);
			КонецЦикла;
		Иначе
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ТаблицаУслуги.Количество() > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;

