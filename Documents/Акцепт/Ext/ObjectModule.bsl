Функция ПолучитьПоступлениеПоКорр(Поступление)

	Если ТипЗнч(Поступление.ДокументПоступления) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
	
		Возврат Поступление.ДокументПоступления;
	
	Иначе
	
		ПоступлРез = ПолучитьПоступлениеПоКорр(Поступление.ДокументПоступления);
		
		Возврат ПоступлРез;
		
	КонецЕсли; 

КонецФункции // ПолучитьПоступлениеПоКорр(Поступление)

Функция ОпределитьПериодВО(ТЗ_Переносы, ГУИД, ТекущийПериодВО)

	ИскМас_Перенос = ТЗ_Переносы.НайтиСтроки(Новый Структура("ГУИДСтроки", ГУИД) );
	Если ИскМас_Перенос.Количество() > 0 Тогда
		НовПериод = ИскМас_Перенос[0].НовыйПериодВО;
		ЗакрытиеПериодов = ИскМас_Перенос[0].ДокументЗакрытия;
	Иначе
		НовПериод = Неопределено;
		ЗакрытиеПериодов = Неопределено;
	КонецЕсли; 
	
	НовПериодВО = ?(НовПериод=Неопределено, НачалоМесяца(ТекущийПериодВО), НачалоМесяца(НовПериод) );

	РезДан = Новый Структура("НовПериодВО, ЗакрытиеПериодов", НовПериодВО, ЗакрытиеПериодов) ;
	
	Возврат РезДан; 
	
КонецФункции // ОпределитьПериодВО(ТЗ_Переносы, ГУИД, ТекущийПериодВО)

