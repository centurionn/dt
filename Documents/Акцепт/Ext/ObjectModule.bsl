	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//Проверяемые поля", ТекстЗапросаПоля);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Для Каждого Реквизит Из Реквизиты Цикл
			Если Выборка[Реквизит] <> ЭтотОбъект[Реквизит] Тогда
				Возврат Истина;
			КонецЕсли;					
		КонецЦикла;
