Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	ТекДата = ТекущаяДатаСеанса();
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ТекДата;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг")
			Или ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.КорректировкаПоступления") Тогда
		
		Поступление = ДанныеЗаполнения;
		ЗаполнитьПоПоступлению();
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Акцепт") Тогда
		
		СторнируемыйАкцепт = ДанныеЗаполнения;
		ЗаполнитьПоСторнируемомуАкцепту();
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
		
		Если ЗначениеЗаполнено(СторнируемыйАкцепт) Тогда
			ЗаполнитьПоСторнируемомуАкцепту();
		ИначеЕсли ЗначениеЗаполнено(Поступление) Тогда
			ЗаполнитьПоПоступлению();
		КонецЕсли;
		
	ИначеЕсли ДанныеЗаполнения = Неопределено Тогда
		
		//Евросиб СубботинВ Подправил баг открытия формы 27.06.2025 Начало
        ВызватьИсключение("Создание акцепта возможно только из документа основания");
		//Евросиб СубботинВ Подправил баг открытия формы 27.06.2025 Конец
		
		Организация = Константы.ОсновнаяОрганизация.Получить();
				
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПериодВО) Тогда
		ПериодВО = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериод(Организация);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПериодБУ) Тогда
		//Евросиб Каблов 09.04.2025 ( #105407
		//ПериодБУ = Константы.ДатаПериодаЗагрузкиОДВУПП.Получить();
		ПериодБУ = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериодБУ(Организация);
		//Евросиб Каблов 09.04.2025 ( #105407
	КонецЕсли;
	//период во и период бу не может быть меньше месяца даты всф
	РеквизитыСФ = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьРеквизитыСчетФактуры(Поступление,"СчетФактураПолученный");
	Если РеквизитыСФ <> Неопределено Тогда
		ДатаВСФ = РеквизитыСФ.ДатаВходящегоДокумента;
	Иначе
		ДатаВСФ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Поступление, "ДатаВходящегоДокумента");
	КонецЕсли;
	ПериодВО = Макс(ПериодВО, НачалоМесяца(ДатаВСФ));
	ПериодБУ = Макс(ПериодБУ, НачалоМесяца(ДатаВСФ));
	
	//Евросиб Каблов 03.09.2021 ( Ticket#0241814
	ПериодАкцепта = Мин(ПериодВО, ПериодБУ);
	ПретензииИНеакцептыСервер.ДополнитьСтрокиАкцептовДаннымиСделки(ЭтотОбъект, Истина, ПериодАкцепта);
	//Евросиб Каблов 03.09.2021 )
	
	//Евросиб - АСуслов 02.11.2021 11:39:44 #
	//(
	Если ЭтоНовый() Тогда
		Автор = Пользователи.ТекущийПользователь();
		Создано = ТекДата;
	КонецЕсли;
	//)
	//Евросиб - АСуслов 02.11.2021 11:39:46 #
	
	//заполним гуид у строк услуг
	Для каждого СтрокаУслуга Из Услуги Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаУслуга.ГУИД) Тогда
			СтрокаУслуга.ГУИД = Строка(Новый УникальныйИдентификатор);
		КонецЕсли; 
		//Евросиб(ДИТ) Антонова А.С. BUG 109383 ТА 110541 Начало 11.06.2025
		//// ДИТ US 71603 ТА 72312 Сержантова А.С. Начало: 20.07.2023
		//Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаУслуга.Номенклатура, "КатегорияРасходов") = Справочники.КатегорииРасходов.НайтиПоКоду("РасхЧстП") Тогда
		//	СтрокаУслуга.РасходыЗаСчетЧП = Истина;
		//Иначе
		//	СтрокаУслуга.РасходыЗаСчетЧП = Ложь;
		//КонецЕсли;
		//// ДИТ US 71603 ТА 72312 Сержантова А.С. Конец: 20.07.2023 
		Если СтрокаУслуга.РасходыЗаСчетЧП <> Истина 
			и ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаУслуга.Номенклатура, "КатегорияРасходов") = Справочники.КатегорииРасходов.НайтиПоКоду("РасхЧстП") Тогда
			СтрокаУслуга.РасходыЗаСчетЧП = Истина;
		КонецЕсли;
		//Евросиб(ДИТ) Антонова А.С. BUG 109383 ТА 110541 Конец 11.06.2025
	КонецЦикла;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
//Евросиб Гудкова( 29.11.2021 Ticket№ 42922
	РежимЗаписиАкцепта = РежимЗаписи;
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Или РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		ДатаНачалаЗамера = ОценкаПроизводительности.НачатьЗамерВремени();
	КонецЕсли;
// Евросиб Гудкова)	

	// SIV 19-02-21 Если в акцепте заполнена сделка, но не заполнена номенклатура или номенлкатурная группа, то это ошибка. акцепт идет в отказ записи
	Если НЕ ПометкаУдаления Тогда
		Для каждого Стр из Услуги Цикл
			Если ЗначениеЗаполнено(Стр.Сделка) И (НЕ ЗначениеЗаполнено(Стр.НоменклатураСделки) ИЛИ НЕ ЗначениеЗаполнено(Стр.НоменклатурнаяГруппа)) Тогда
				СообщениеОшибки = "Для строки " + Стр.НомерСтроки + " КТК " + Стр.Контейнер + " вагон " + Стр.Вагон + " не заполнена " + ?(ЗначениеЗаполнено(Стр.НоменклатураСделки), "номенклатурная группа", "номенклатура сделки") + "! Акцепт " + Номер;
				Отказ = Истина;
				ЗаписьЖурналаРегистрации("Ошибка записи акцепта", УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.Акцепт, Ссылка, СообщениеОшибки);
				ВызватьИсключение СообщениеОшибки;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// ++ ДИТ_Агафонов_task 41390
	Если не ДополнительныеСвойства.Свойство("ЗаписьИзАкцептаКорректировки") и не РольДоступна("ПолныеПрава") Тогда
		Корректировка = Документы.КорректировкаПоступления.ПолучитьКорректировкуПоОснованию(Поступление);
		Если ЗначениеЗаполнено(Корректировка) Тогда
			Отказ = Истина;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("Для документа поступления введен документ исправления %1. Все корректировки необходимо вводить на основании документа-исправления»",Корректировка)
			,,,,Отказ);
		КонецЕсли;	
	КонецЕсли;
	
	ЗафиксироватьСтроки();
	СообщениеПопыткаИзмененияФиксированнойСтроки = "";
	МассивЗафиксированныхСтрок = Услуги.НайтиСтроки(Новый Структура("ЗафиксироватьСтрокуДляКорректировок",Истина));
	Если Не МассивЗафиксированныхСтрок.Количество() = 0 и не ЭтоНовый() Тогда
		СписокГУИД = Новый СписокЗначений;
		Для каждого Стр Из МассивЗафиксированныхСтрок Цикл
			СписокГУИД.Добавить(Стр.ГУИД);		
		КонецЦикла;	
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	АкцептУслуги.*
		|ИЗ
		|	Документ.Акцепт.Услуги КАК АкцептУслуги
		|ГДЕ
		|	АкцептУслуги.Ссылка = &Ссылка
		|	И АкцептУслуги.ГУИД В(&СписокГУИД)";
		Запрос.УстановитьПараметр("СписокГУИД", СписокГУИД);
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		УслугиСсылка = Запрос.Выполнить().Выгрузить();
		СписокПроверяемыхРеквизитов = Новый СписокЗначений;
		СписокПроверяемыхРеквизитов.Добавить("Номенклатура", "Номенклатура");
		//СписокПроверяемыхРеквизитов.Добавить("Количество", "ПЛАН кол-во");  закоментировано для теста по 66855 по просьбе Яковлева Ивана 03.05.2023.
		СписокПроверяемыхРеквизитов.Добавить("ПоступлениеКоличество", "ФАКТ кол-во");
		СписокПроверяемыхРеквизитов.Добавить("ПоступлениеЦена", "ФАКТ цена");
		СписокПроверяемыхРеквизитов.Добавить("ПоступлениеСумма", "ФАКТ сумма");
		СписокПроверяемыхРеквизитов.Добавить("ПоступлениеСтавкаНДС", "ФАКТ ставка НДС");
		СписокПроверяемыхРеквизитов.Добавить("ПоступлениеСуммаНДС", "ФАКТ сумма НДС");

		Для каждого Стр из МассивЗафиксированныхСтрок Цикл
        	СтрСсылка = УслугиСсылка.Найти(Стр.ГУИД, "ГУИД");
			Если СтрСсылка = Неопределено Тогда
				Продолжить;	
			КонецЕсли;
			Для каждого ПроверяемыйРеквизит Из СписокПроверяемыхРеквизитов Цикл
				Если Стр[ПроверяемыйРеквизит.Значение]<>СтрСсылка[ПроверяемыйРеквизит.Значение] Тогда
					Если Стр.ТипФиксацииДляКорректировки = 1 Тогда
						ТекСообщениеОбОшибке = "Строка <НомерсСтроки>. Нельзя менять реквизит <пользовательское представление реквизита>, т.к  по строке ведется претензионная работа";	
					ИначеЕсли Стр.ТипФиксацииДляКорректировки = 2 Тогда
						ТекСообщениеОбОшибке = "Строка <НомерсСтроки>. Нельзя менять реквизит <пользовательское представление реквизита>, т.к. в строке указана Неурег.причина – Отработка в РИТМ";	
					ИначеЕсли Стр.ТипФиксацииДляКорректировки = 3 Тогда
						ТекСообщениеОбОшибке = "Строка <НомерсСтроки>. Нельзя менять реквизит <пользовательское представление реквизита>, т.к. строка привязана к возмещаемым доходам и расходам по сделке. Отвяжите строку от сделки для возможности изменения";	
					ИначеЕсли Стр.ТипФиксацииДляКорректировки = 4 Тогда // ДИТ US 47112 TA 67863 Евсенкин М.А. 06.04.2023 (было 3)
						ТекСообщениеОбОшибке = "Строка <НомерсСтроки>. Нельзя менять реквизит <пользовательское представление реквизита>, т.к. строка добавлена в сделку как доходы и расходы доп.услугой.. Отвяжите строку от сделки для возможности изменения.";	
					Иначе
						ТекСообщениеОбОшибке = "Строка <НомерсСтроки>. Нельзя менять реквизит <пользовательское представление реквизита>, т.к. строка зафиксирована";	
					КонецЕсли;
					ТекСообщениеОбОшибке = СтрЗаменить(ТекСообщениеОбОшибке,"<пользовательское представление реквизита>",ПроверяемыйРеквизит.Представление);	
					ТекСообщениеОбОшибке = СтрЗаменить(ТекСообщениеОбОшибке,"<НомерсСтроки>",Стр.НомерСтроки);	
					СообщениеПопыткаИзмененияФиксированнойСтроки = СообщениеПопыткаИзмененияФиксированнойСтроки + ?(ЗначениеЗаполнено(СообщениеПопыткаИзмененияФиксированнойСтроки),Символы.ПС,"") + ТекСообщениеОбОшибке;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Если ЗначениеЗаполнено(СообщениеПопыткаИзмененияФиксированнойСтроки) Тогда
			Отказ = Истина;
			ЗаписьЖурналаРегистрации("Ошибка записи акцепта", УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.Акцепт, Ссылка, СообщениеПопыткаИзмененияФиксированнойСтроки);
			ВызватьИсключение СообщениеПопыткаИзмененияФиксированнойСтроки;
		КонецЕсли;
	КонецЕсли;
	// -- ДИТ_Агафонов_task 41390

	//заполним гуид у строк услуг
	Для каждого СтрокаУслуга Из Услуги Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаУслуга.ГУИД) Тогда
			СтрокаУслуга.ГУИД = Строка(Новый УникальныйИдентификатор);
		КонецЕсли; 
	КонецЦикла; 
	
	//Евросиб Каблов 28.01.2021 (
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Или РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		
		ТекПериодВО = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериод(Организация);
		//Евросиб Каблов 09.04.2025 ( #105407
		//ТекПериодБУ = Константы.ДатаПериодаЗагрузкиОДВУПП.Получить();
		ТекПериодБУ = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериодБУ(Организация);
		//Евросиб Каблов 09.04.2025 ( #105407
	
		Если ПериодВО < ТекПериодВО Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Акцепт находится в расчитанном периоде ВО! Проведение и отмена проведения запрещены.",,,, Отказ);
		КонецЕсли;
		
		Если ПериодБУ < ТекПериодБУ Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Акцепт находится в расчитанном периоде БУ! Проведение и отмена проведения запрещены.",,,, Отказ);
		КонецЕсли;
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	//Евросиб Каблов 28.01.2021 )
	
	//Евросиб Каблов 27.10.2021 ( 40020
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		РеквизитыСФ = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьРеквизитыСчетФактуры(Поступление,"СчетФактураПолученный");
		Если РеквизитыСФ <> Неопределено Тогда
			ДатаВСФ = РеквизитыСФ.ДатаВходящегоДокумента;
		Иначе
			ДатаВСФ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Поступление, "ДатаВходящегоДокумента");
		КонецЕсли;
		
		НачалоМесяцаДатыВСФ = НачалоМесяца(ДатаВСФ);
		ПериодИзменился = Ложь;
		Если ПериодВО < НачалоМесяцаДатыВСФ Тогда
			ПериодВО = НачалоМесяцаДатыВСФ;
			ПериодИзменился = Истина;
		КонецЕсли;
		Если ПериодБУ < НачалоМесяцаДатыВСФ Тогда
			ПериодБУ = НачалоМесяцаДатыВСФ;
			ПериодИзменился = Истина;
		КонецЕсли;

		Если ПериодИзменился Тогда
			ПериодАкцепта = Мин(ПериодВО, ПериодБУ);
			ПретензииИНеакцептыСервер.ДополнитьСтрокиАкцептовДаннымиСделки(ЭтотОбъект, Истина, ПериодАкцепта);
		КонецЕсли;
	КонецЕсли;
	//Евросиб Каблов 27.10.2021 )
	
	//Евросиб Каблов 15.02.2021 ( Перенес из процедуры Обработка проведения
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение И Не ЗначениеЗаполнено(СторнируемыйАкцепт) Тогда
		ДополнительныеСвойства.Вставить("НеДобавлятьСторноВОчередьОтложенногоИзмененияВзаимосвязанныхОбъектов", Истина);
		Документы.Акцепт.СоздатьСторноПоследнегоАкцептаПоПоступлению(Поступление, Дата - 1, , ДополнительныеСвойства);
		//++ Глеков Д.В. Ticket#0247297 27.01.2022  
		//Если ТипЗнч(Поступление) = Тип("ДокументСсылка.КорректировкаПоступления") Тогда
		//
		//	РеквизитыПоступления = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Поступление, "ВидОперации, ДокументПоступления");
		//	Если РеквизитыПоступления.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки Тогда
		//	
		//		Документы.Акцепт.СоздатьСторноПоследнегоАкцептаПоПоступлению(РеквизитыПоступления.ДокументПоступления, Дата - 1, ИСТИНА);
		//	
		//	КонецЕсли;
		//
		//КонецЕсли;
	КонецЕсли;
	//Евросиб Каблов 15.02.2021 )
	
	//Евросиб Каблов 04.03.2021 ( Ticket#0224203
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения И ЗначениеЗаполнено(СторнируемыйАкцепт) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Акцепт.Ссылка КАК Ссылка,
		|	Акцепт.Представление КАК Представление
		|ИЗ
