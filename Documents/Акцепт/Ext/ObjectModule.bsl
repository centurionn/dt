#Область ПрограммныйИнтерфейс

Функция ПолучитьЛокацииПоУслугеИКТК(ПТУ, Услуга, КТК)
	
	Результат = Новый Структура("СтанцияОтправления, СтанцияНазначения", неопределено, неопределено);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПоступлениеТоваровУслугУслуги.СтанцияОтправления КАК СтанцияОтправления,
	               |	ПоступлениеТоваровУслугУслуги.СтанцияНазначения КАК СтанцияНазначения
	               |ИЗ
	               |	Документ.ПоступлениеТоваровУслуг.Услуги КАК ПоступлениеТоваровУслугУслуги
	               |ГДЕ
	               |	ПоступлениеТоваровУслугУслуги.Ссылка = &Ссылка
	               |	И ПоступлениеТоваровУслугУслуги.Номенклатура = &Номенклатура
	               |	И ПоступлениеТоваровУслугУслуги.СписокТЕ ПОДОБНО ""%"" + &КТК + ""%""";
	Запрос.УстановитьПараметр("Ссылка", ПТУ);
	Запрос.УстановитьПараметр("Номенклатура", Услуга);
	Запрос.УстановитьПараметр("КТК", Строка(КТК));
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Евросиб Фролов (27.01.2022 Ticket№ 44918, добавил параметр "ТаблицаУслугПТУ"
Процедура ЗаполнитьУслуги(РежимЗаполнения = "ПоПТУ", ТаблицаУслугПТУ = Неопределено) Экспорт
	
	//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 113659, 03-07-2025, начало
	ДанныеОКорректировках = Услуги.Выгрузить(,"ИдентификаторСтрокиРасходовВСделке, ИдентификаторСтрокиДоходовВСделкеКорректируемый");
	//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 113659, 03-07-2025, конец
	
	Если ТаблицаУслугПТУ = Неопределено Тогда // Евросиб Фролов (27.01.2022 Ticket№ 44918: если передана таблица услуг по ПТУ, то не очищаем, т.к. будет перезаполнение
		Услуги.Очистить();
	КонецЕсли;
	
	//Получение последнего акцепта по поступлению
	ПоследнийАкцепт = Неопределено;
	Если Не РежимЗаполнения = "ПоПТУ" Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	Акцепт.Ссылка КАК Ссылка
		               |ИЗ
		               |	Документ.Акцепт КАК Акцепт
		               |ГДЕ
		               |	Акцепт.Дата В
		               |			(ВЫБРАТЬ
		               |				МАКСИМУМ(Акцепт.Дата) КАК ДатаПоследнегоАкцепта
		               |			ИЗ
		               |				Документ.Акцепт КАК Акцепт
		               |			ГДЕ
		               |				Акцепт.Поступление = &Поступление
		               |				И Акцепт.Дата < &Дата
		               |				И Акцепт.Ссылка <> &Ссылка
		               |				И НЕ Акцепт.ПометкаУдаления
//Евросиб Гудкова( 19.04.2021 Ticket№ 0229910
		               |				И Акцепт.Проведен
// Евросиб Гудкова) 					   
					   |				И Акцепт.СторнируемыйАкцепт = ЗНАЧЕНИЕ(Документ.Акцепт.ПустаяСсылка))
		               |	И Акцепт.Поступление = &Поступление
		               |	И НЕ Акцепт.ПометкаУдаления
		               |	И Акцепт.СторнируемыйАкцепт = ЗНАЧЕНИЕ(Документ.Акцепт.ПустаяСсылка)";
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Запрос.УстановитьПараметр("Дата", Дата);
		Запрос.УстановитьПараметр("Поступление", Поступление);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ПоследнийАкцепт = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;  
	
	// ++ ДИТ_Агафонов_task 41390
	Если ТипЗнч(Поступление) = Тип("ДокументСсылка.КорректировкаПоступления")
		и Поступление.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки Тогда
		ЭтоКоррПервички	= Истина;	
	Иначе	
		ЭтоКоррПервички	= Ложь;	
	КонецЕсли;
	// -- ДИТ_Агафонов_task 41390
	
	//Евросиб Каблов 02.08.2021 ( Ticket#0238366
	Если ЗначениеЗаполнено(ПоследнийАкцепт) Тогда
		
		//Если в последнем акцепте есть строки с идентификаторами, которых нет в ПТУ, то новый акцепт нужно заполнить по ПТУ
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	АкцептУслуги.ИдентификаторСтрокиПоступления КАК ИдентификаторСтрокиПоступления,
		|	АкцептУслуги.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	Документ.Акцепт.Услуги КАК АкцептУслуги
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.Услуги КАК ПоступлениеТоваровУслугУслуги
		|		ПО АкцептУслуги.ИдентификаторСтрокиПоступления = ПоступлениеТоваровУслугУслуги.ГУИДПТУ
		|			И АкцептУслуги.Ссылка.Поступление = ПоступлениеТоваровУслугУслуги.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|		ПО АкцептУслуги.Ссылка.Поступление = ПоступлениеТоваровУслуг.Ссылка
		|ГДЕ
		|	АкцептУслуги.Ссылка = &Ссылка
		//Евросиб Каблов 05.09.2024 ( Ticket#0358430
		|	И АкцептУслуги.Неурег <> ЗНАЧЕНИЕ(Справочник.ПричиныНеурегулированныхРасходов.ОтработкаВРИТМ)
		//Евросиб Каблов 05.09.2024 )
		|	И ПоступлениеТоваровУслугУслуги.НомерСтроки ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	АкцептУслуги.ИдентификаторСтрокиПоступления,
		|	АкцептУслуги.НомерСтроки
		|ИЗ
		|	Документ.Акцепт.Услуги КАК АкцептУслуги
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КорректировкаПоступления.Услуги КАК КорректировкаПоступленияУслуги
		|		ПО АкцептУслуги.ИдентификаторСтрокиПоступления = КорректировкаПоступленияУслуги.ГУИДПТУ
		|			И АкцептУслуги.Ссылка.Поступление = КорректировкаПоступленияУслуги.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаПоступления КАК КорректировкаПоступления
		|		ПО АкцептУслуги.Ссылка.Поступление = КорректировкаПоступления.Ссылка
		|ГДЕ
		|	АкцептУслуги.Ссылка = &Ссылка
		//Евросиб Каблов 05.09.2024 ( Ticket#0358430
		|	И АкцептУслуги.Неурег <> ЗНАЧЕНИЕ(Справочник.ПричиныНеурегулированныхРасходов.ОтработкаВРИТМ)
		//Евросиб Каблов 05.09.2024 )
		|	И КорректировкаПоступленияУслуги.НомерСтроки ЕСТЬ NULL";
		
		Запрос.УстановитьПараметр("Ссылка", ПоследнийАкцепт);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если Не РезультатЗапроса.Пустой() Тогда
			ПоследнийАкцепт = Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	//Евросиб Каблов 02.08.2021 )
	
	//Заполнение ТЧ услуги
	Если ЗначениеЗаполнено(ПоследнийАкцепт) Тогда
		
		//Евросиб Каблов 08.02.2022 ( Ticket#0258430
		Если ТипЗнч(Поступление) = Тип("ДокументСсылка.КорректировкаПоступления") 
			// ++ ДИТ_Агафонов_task 41390
			//при корректировке первички повторяем логику с ПТУ, так как возможно нужно отвязывать строки - а это через кнопку Заполнить по ПТУ на форме
			и не ЭтоКоррПервички
			// -- ДИТ_Агафонов_task 41390 12.01.2023 
			Тогда  
			//Евросиб СубботинВ #120974 17.11.2025 Начало 
			//ЗаполнитьАкцептКоррПТУ(Ложь, ПоследнийАкцепт);
			ЗаполнятьПоПТУ = (РежимЗаполнения = "ПоПТУ");
			ЗаполнитьАкцептКоррПТУ(ЗаполнятьПоПТУ, ПоследнийАкцепт);
			//Евросиб СубботинВ #120974 17.11.2025 Конец
		Иначе
			Услуги.Загрузить(ПоследнийАкцепт.Услуги.Выгрузить());
		КонецЕсли;
		//Евросиб Каблов 08.02.2022 )


	ИначеЕсли ТипЗнч(Поступление) = Тип("ДокументСсылка.КорректировкаПоступления") 
		// ++ ДИТ_Агафонов_task 41390
		и не ЭтоКоррПервички	
		// -- ДИТ_Агафонов_task 41390
		Тогда  
		
		//Евросиб Каблов 08.02.2022 ( Ticket#0258430 Перенес все в процедуру ЗаполнитьАкцептКоррПТУ 
		ЗаполнятьПоПТУ = (РежимЗаполнения = "ПоПТУ");
		ЗаполнитьАкцептКоррПТУ(ЗаполнятьПоПТУ, ПоследнийАкцепт);
		//Евросиб Каблов 08.02.2022 )
		
	ИначеЕсли ТипЗнч(Поступление) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") 
		// ++ ДИТ_Агафонов_task 41390
		Или ЭтоКоррПервички	
		// -- ДИТ_Агафонов_task 41390
		Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ПоступлениеТоваровУслугУслуги.НомерСтроки КАК НомерСтроки,
		|	ПоступлениеТоваровУслугУслуги.ГУИДПТУ КАК ИдентификаторСтрокиПоступления,
		|	ПоступлениеТоваровУслугУслуги.Номенклатура КАК Номенклатура,
		|	ПоступлениеТоваровУслугУслуги.СтавкаНДС КАК ПоступлениеСтавкаНДС,
		|	ПоступлениеТоваровУслугУслуги.СписокТС КАК СписокТС,
		|	ПоступлениеТоваровУслугУслуги.СписокТЕ КАК СписокТЕ,
		|	ПоступлениеТоваровУслугУслуги.Количество КАК ПоступлениеКоличество,
		|	ПоступлениеТоваровУслугУслуги.Цена КАК ПоступлениеЦена,
//Евросиб Гудкова( 05.11.2020 Ticket№ 0212465
//		|	ПоступлениеТоваровУслугУслуги.Сумма КАК ПоступлениеСумма,
		|	ПоступлениеТоваровУслугУслуги.Всего КАК ПоступлениеСумма,
// Евросиб Гудкова) 		
		|	ПоступлениеТоваровУслугУслуги.СуммаНДС КАК ПоступлениеСуммаНДС,
		|	ПоступлениеТоваровУслугУслуги.СписокТД КАК СписокТД,
		//Евросиб Каблов 07.12.2021 ( TASK 43510
		|	ПоступлениеТоваровУслугУслуги.ИДТД КАК ИДТД,
		|	ПоступлениеТоваровУслугУслуги.Ссылка.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
		//Евросиб Каблов 07.12.2021 )
		|	ПоступлениеТоваровУслугУслуги.СтанцияОтправления КАК СтанцияОтправления,
		|	ПоступлениеТоваровУслугУслуги.СтанцияНазначения КАК СтанцияНазначения,
		|	ПоступлениеТоваровУслугУслуги.Содержание КАК Содержание
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг.Услуги КАК ПоступлениеТоваровУслугУслуги
		|ГДЕ
		|	ПоступлениеТоваровУслугУслуги.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПоступлениеТоваровУслугУслуги.НомерСтроки"; 
		
		// ++ ДИТ_Агафонов_task 41390 21.11.2022
		Если ЭтоКоррПервички Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст,"Документ.ПоступлениеТоваровУслуг.Услуги","Документ.КорректировкаПоступления.Услуги");
		КонецЕсли;
		// -- ДИТ_Агафонов_task 41390 21.11.2022		
		Запрос.УстановитьПараметр("Ссылка", Поступление);	
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			//ДИТ, Беляев СЮ, Ticket#0270884, 12-05-2022, начало
			МассивТС = СтрРазделить(ОбщегоНазначенияВызовСервера.ПривестиСтрокуУчетныхЕдиницКТребуемомуФормату(Выборка.СписокТС), ";", Ложь);
			МассивТЕ = СтрРазделить(ОбщегоНазначенияВызовСервера.ПривестиСтрокуУчетныхЕдиницКТребуемомуФормату(Выборка.СписокТЕ), ";", Ложь);
			МассивТД = СтрРазделить(ОбщегоНазначенияВызовСервера.ПривестиСтрокуУчетныхЕдиницКТребуемомуФормату(Выборка.СписокТД), ";", Ложь);  
			//ДИТ, Беляев СЮ, Ticket#0270884, 12-05-2022, конец 
			
			////Евросиб - АСуслов 11.12.2021 15:06:29 #
			////(
			//ТранспортныйДокумент = ТранспортныеДокументы_сервер.НайтиТранспортныйДокумент(НомерНакладной, Выборка.ДатаВходящегоДокумента, Перечисления.ВидыОперацийТранспортныхДокументов.ЖДНакладная, Выборка.ИДТД);
			////)
			////Евросиб - АСуслов 11.12.2021 15:06:30 #
			
			КоличествоКонтейнеров = МассивТЕ.Количество();
			КоличествоВагонов = МассивТС.Количество();
			//ДИТ, Беляев СЮ, Ticket#0270884, 12-05-2022, начало
			КоличествоТранспортныхДокументов = МассивТД.Количество();
			//ДИТ, Беляев СЮ, Ticket#0270884, 12-05-2022, конец
			
			КоличествоСтрок = Выборка.ПоступлениеКоличество;
			
			Если КоличествоСтрок = 0 Тогда
				ТекстСообщения = СтрШаблон("В строке поступления №%1 в поле значение поля Количество равно нулю! Эта строка не попала в Акцепт.", Выборка.НомерСтроки);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Продолжить;
			КонецЕсли;
			
			Если КоличествоКонтейнеров > КоличествоСтрок Тогда
				МассивЛишнихТЕ = Новый Массив;
				Для ИндексТЕ = КоличествоСтрок По КоличествоКонтейнеров - 1 Цикл
					МассивЛишнихТЕ.Добавить(МассивТЕ.Получить(ИндексТЕ));
				КонецЦикла;
				ЛишниеТЕ = СтрСоединить(МассивЛишнихТЕ, "; ");
				ТекстСообщения = СтрШаблон("В строке поступления №%1 количество указанных контейнеров превышает значение поля Количество!
											|Контейнеры, которые не попали в Акцепт: %2", Выборка.НомерСтроки, ЛишниеТЕ);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			КонецЕсли;
			
			Если КоличествоВагонов > КоличествоСтрок Тогда
				МассивЛишнихТС = Новый Массив;
				Для ИндексТС = КоличествоСтрок По КоличествоВагонов - 1 Цикл
					МассивЛишнихТС.Добавить(МассивТС.Получить(ИндексТС));
				КонецЦикла;
				ЛишниеТС = СтрСоединить(МассивЛишнихТС, "; ");
				ТекстСообщения = СтрШаблон("В строке поступления №%1 количество указанных вагонов превышает значение поля Количество!
											|Вагоны, которые не попали в Акцепт: %2", Выборка.НомерСтроки, ЛишниеТС);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			КонецЕсли; 
			
			//ДИТ, Беляев СЮ, Ticket#0270884, 12-05-2022, начало
			Если КоличествоТранспортныхДокументов > КоличествоСтрок Тогда
				МассивЛишнихТД = Новый Массив;
				Для ИндексТД = КоличествоСтрок По КоличествоТранспортныхДокументов - 1 Цикл
					МассивЛишнихТД.Добавить(МассивТД.Получить(ИндексТД));
				КонецЦикла;
				ЛишниеТД = СтрСоединить(МассивЛишнихТД, "; ");
				ТекстСообщения = СтрШаблон("В строке поступления №%1 количество указанных Трансп. документов превышает значение поля Количество!
											|Документы, которые не попали в Акцепт: %2", Выборка.НомерСтроки, ЛишниеТД);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			КонецЕсли;   
