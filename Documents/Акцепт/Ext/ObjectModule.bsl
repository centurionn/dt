Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	//Евросиб Каблов 28.02.2022 ( Ticket#0261988
	//Если НЕ Поступление.Проведен Тогда
	Если ЗначениеЗаполнено(СторнируемыйАкцепт) Тогда
		СторнируемыйАкцептПроведен = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СторнируемыйАкцепт, "Проведен");
		Если Не СторнируемыйАкцептПроведен Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сторнируемый акцепт не проведен!",,,, Отказ);
			Возврат;
		КонецЕсли;
	ИначеЕсли НЕ Поступление.Проведен Тогда
	//Евросиб Каблов 28.02.2022 )
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("%1 не проведено", Поступление));
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	//Евросиб Каблов 18.06.2024 ( Ticket#0298095
	ПроверитьСообщитьНеобходимостьОтправитьСтрокиВРитм();
	//Евросиб Каблов 18.06.2024 )
	
	Если ЗначениеЗаполнено(СторнируемыйАкцепт) Тогда		
		СоздатьДвиженияСторно();
	Иначе
		СоздатьДвиженияАкцепта(Отказ);
	КонецЕсли;
	
	ТекущийСтатусРазнесения = Документы.Акцепт.ПолучитьДанныеПоследнегоПроведенногоАкцепта(Поступление).СтатусРазнесения;
	ПретензииИНеакцептыСервер.ЗаписьДанныхОчередиАвторазнесения(Поступление, Истина, ТекущийСтатусРазнесения);
	
	//Евросиб Каблов 22.11.2024 ( Ticket#0367681 Перенес вызов сюда, чтобы выполнялся и для сторно и после записи АктуальныеАкцепты
	// Евросиб BUG 93193 TA 93194 Рыбьяков К.А. 23.10.2024 ((
	Документы.Акцепт.ОбновитьСтатусРазнесенияАкцепта(ЭтотОбъект);
	// Евросиб Рыбьяков К.А. 23.10.2024 ))
	//Евросиб Каблов 22.11.2024 )

	//Евросиб Каблов 29.07.2025 ( #111324
	//Если НЕ ДополнительныеСвойства.Свойство("ЗаписьИзСделки") Тогда
	Если Не ДополнительныеСвойства.Свойство("ЗаписьИзСделки")
				И Не ЗначениеЗаполнено(СторнируемыйАкцепт) Тогда
	//Евросиб Каблов 29.07.2025 )
		Документы.Акцепт.ЗаполнитьКорректировочныеАкцепты(Поступление);
	КонецЕсли; 
	
КонецПроцедуры

