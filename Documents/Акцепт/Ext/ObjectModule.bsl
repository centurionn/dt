							СтрокаАкцепта = СтрокиАкцепта[ИндексСтроки];
							
							Если ЗаполнятьПропорционально Тогда
								
								СуммаПоНовойСтроке = СуммыПропорциональноАкцепту[ИндексСтроки];
								
								СуммаАкцептаПоПТУ = СуммыАкцептаПоПТУ[ИндексСтроки];
								Если СуммаПоНовойСтроке < -СуммаАкцептаПоПТУ Тогда
									СуммаПоНовойСтроке = -СуммаАкцептаПоПТУ;
								КонецЕсли;
								
								Если ЗначениеЗаполнено(СуммыНДСПропорциональноАкцепту) Тогда
									
									СуммаНДСПоНовойСтроке = СуммыНДСПропорциональноАкцепту[ИндексСтроки];
									
									СуммаНДСАкцептаПоПТУ = СуммыНДСАкцептаПоПТУ[ИндексСтроки];
									Если СуммаНДСПоНовойСтроке < -СуммаНДСАкцептаПоПТУ Тогда
										СуммаНДСПоНовойСтроке = -СуммаНДСАкцептаПоПТУ;
									КонецЕсли;
									
								Иначе
									
									СуммаНДСПоНовойСтроке = 0;
									
								КонецЕсли;
								
							КонецЕсли;
						//Евросиб Каблов 18.06.2024 )
							
							Если ЗаполнятьРасходамиПривязаннымиПользователем Тогда
								
								СтруктураПоискаПривязанных = Новый Структура;
								ЗаполнитьЗначенияСвойств(СтруктураПоискаПривязанных, СтруктураПоиска);
								СтруктураПоискаПривязанных.Вставить("Контейнер");
								СтруктураПоискаПривязанных.Вставить("Вагон");
								СтруктураПоискаПривязанных.Вставить("Сделка");
								СтруктураПоискаПривязанных.Вставить("ИдентификаторСтрокиРасходовВСделке");
								СтруктураПоискаПривязанных.Вставить("СтрокаОбработана", Ложь);
								
								ЗаполнитьЗначенияСвойств(СтруктураПоискаПривязанных, СтрокаАкцепта, "Контейнер, Вагон, Сделка, ИдентификаторСтрокиРасходовВСделке");
								
								СтрокиТекущегоАкцепта = ТаблицаУслугАкцепта.НайтиСтроки(СтруктураПоискаПривязанных);
								Если СтрокиТекущегоАкцепта.Количество() > 0 Тогда
									НоваяСтрока = СтрокиТекущегоАкцепта[0];
									НоваяСтрока.ПолностьюРазнесено = Ложь;
								Иначе
									НоваяСтрока = ТаблицаУслугАкцепта.Добавить();
									НоваяСтрока.НомерСтроки = НомерДобавляемойСтроки;
									НомерДобавляемойСтроки = НомерДобавляемойСтроки + 1;
								КонецЕсли;
								НоваяСтрока.СтрокаОбработана = Истина;
							Иначе
								НоваяСтрока = Услуги.Добавить();
							КонецЕсли;
						
							ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаСтрокКоррПТУ);
							ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаАкцепта,, ИсключаемыеПоляПриЗаполненииИзАкцепта);
							//Если ЗначениеЗаполнено(ТранспортныйДокумент) Тогда
							//	НоваяСтрока.ТранспортныйДокумент = ТранспортныйДокумент;
							//КонецЕсли;  
							
							НоваяСтрока.ПоступлениеКоличество 	= 1;
							НоваяСтрока.ПоступлениеСумма 		= СуммаПоНовойСтроке;
							НоваяСтрока.ПоступлениеСуммаНДС 	= СуммаНДСПоНовойСтроке;
							НоваяСтрока.ПоступлениеЦена 		= СуммаПоНовойСтроке;
							
							Если ЗначениеЗаполнено(СтрокаАкцепта.Сделка) Тогда			
								НоваяСтрока.Сумма = НоваяСтрока.ПоступлениеСумма;
								НоваяСтрока.СуммаНДС = НоваяСтрока.ПоступлениеСуммаНДС;
							Иначе
								НоваяСтрока.Сумма = 0;
								НоваяСтрока.СуммаНДС = 0;
							КонецЕсли;
							
							ОстатокРаспределяемойСуммы = ОстатокРаспределяемойСуммы - СуммаПоНовойСтроке;
							ОстатокРаспределяемойСуммыНДС = ОстатокРаспределяемойСуммыНДС - СуммаНДСПоНовойСтроке;
							
							ДобавленаСтрока = Истина;
							
						КонецЦикла;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если ОстатокРаспределяемойСуммы <> 0 Или ОстатокРаспределяемойСуммыНДС <> 0 Тогда
				
				Если Не ДобавленаСтрока Тогда
					
					Если ЗаполнятьРасходамиПривязаннымиПользователем Тогда
						СтруктураПоиска.Вставить("СтрокаОбработана", Ложь);
						СтрокиТекущегоАкцепта = ТаблицаУслугАкцепта.НайтиСтроки(СтруктураПоиска);
						Если СтрокиТекущегоАкцепта.Количество() > 0 Тогда
							НоваяСтрока = СтрокиТекущегоАкцепта[0];
							НоваяСтрока.ПолностьюРазнесено = Ложь;
							НоваяСтрока.ПоступлениеСумма = 0;
							НоваяСтрока.ПоступлениеСуммаНДС = 0;
							НоваяСтрока.ПоступлениеЦена = 0;
						Иначе
							НоваяСтрока = ТаблицаУслугАкцепта.Добавить();
							НоваяСтрока.НомерСтроки = НомерДобавляемойСтроки;
							НомерДобавляемойСтроки = НомерДобавляемойСтроки + 1;
						КонецЕсли;
						НоваяСтрока.СтрокаОбработана = Истина;
					Иначе
						НоваяСтрока = Услуги.Добавить();
					КонецЕсли;
						
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаСтрокКоррПТУ,, "ПоступлениеСумма, ПоступлениеСуммаНДС, ПоступлениеЦена"); 
					НоваяСтрока.Контейнер = Контейнер;
					НоваяСтрока.Вагон = Вагон;
					//НоваяСтрока.ТранспортныйДокумент = ТранспортныйДокумент;
					НоваяСтрока.ПоступлениеКоличество = 1;
				КонецЕсли;					
				
				НоваяСтрока.ПоступлениеСумма 		= НоваяСтрока.ПоступлениеСумма + ОстатокРаспределяемойСуммы;
				НоваяСтрока.ПоступлениеСуммаНДС 	= НоваяСтрока.ПоступлениеСуммаНДС + ОстатокРаспределяемойСуммыНДС;
				НоваяСтрока.ПоступлениеЦена 		= НоваяСтрока.ПоступлениеЦена + ОстатокРаспределяемойСуммы;
				
				Если ЗначениеЗаполнено(НоваяСтрока.Сделка) Тогда			
					НоваяСтрока.Сумма = НоваяСтрока.ПоступлениеСумма;
					НоваяСтрока.СуммаНДС = НоваяСтрока.ПоступлениеСуммаНДС;
				Иначе
					НоваяСтрока.Сумма = 0;
					НоваяСтрока.СуммаНДС = 0;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ОстатокСуммыПоСтрокеПТУ <> 0 Или ОстатокСуммыНДСПоСтрокеПТУ <> 0 Тогда
			
			Если НоваяСтрока = Неопределено Тогда				
				Если ЗаполнятьРасходамиПривязаннымиПользователем Тогда
					
					СтруктураПоиска.Очистить();
					СтруктураПоиска.Вставить("ИдентификаторСтрокиПоступления", ВыборкаСтрокКоррПТУ.ИдентификаторСтрокиПоступления);
					СтруктураПоиска.Вставить("СтрокаОбработана", Ложь);
					
					СтрокиТекущегоАкцепта = ТаблицаУслугАкцепта.НайтиСтроки(СтруктураПоиска);
					Если СтрокиТекущегоАкцепта.Количество() > 0 Тогда
						НоваяСтрока = СтрокиТекущегоАкцепта[0];
						НоваяСтрока.ПолностьюРазнесено = Ложь;
						НоваяСтрока.ПоступлениеСумма = 0;
						НоваяСтрока.ПоступлениеСуммаНДС = 0;
						НоваяСтрока.ПоступлениеЦена = 0;
					Иначе
						НоваяСтрока = ТаблицаУслугАкцепта.Добавить();
						НоваяСтрока.НомерСтроки = НомерДобавляемойСтроки;
						НомерДобавляемойСтроки = НомерДобавляемойСтроки + 1;
					КонецЕсли;
					НоваяСтрока.СтрокаОбработана = Истина;
				Иначе
					НоваяСтрока = Услуги.Добавить();
				КонецЕсли;				
			КонецЕсли;
			
			НоваяСтрока.ПоступлениеСумма 		= НоваяСтрока.ПоступлениеСумма + ОстатокСуммыПоСтрокеПТУ;
			НоваяСтрока.ПоступлениеСуммаНДС 	= НоваяСтрока.ПоступлениеСуммаНДС + ОстатокСуммыНДСПоСтрокеПТУ;
			НоваяСтрока.ПоступлениеЦена 		= НоваяСтрока.ПоступлениеСумма;
			
			Если ЗначениеЗаполнено(НоваяСтрока.Сделка) Тогда			
				НоваяСтрока.Сумма = НоваяСтрока.ПоступлениеСумма;
				НоваяСтрока.СуммаНДС = НоваяСтрока.ПоступлениеСуммаНДС;
			Иначе
				НоваяСтрока.Сумма = 0;
				НоваяСтрока.СуммаНДС = 0;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗаполнятьРасходамиПривязаннымиПользователем Тогда
		ТаблицаДляЗагрузки = ТаблицаУслугАкцепта.Скопировать(Новый Структура("СтрокаОбработана", Истина));		
		ТранспортныеДокументы_сервер.ЗаполнитьТранспортныеДокументы(Новый Структура("Режим, АкцептУслуги, Поступление", "ОдиночныйДокумент", ТаблицаДляЗагрузки, Поступление));		
		ТаблицаДляЗагрузки.Сортировать("НомерСтроки");
		Услуги.Загрузить(ТаблицаДляЗагрузки);
	Иначе
		ВремТаблицаУслуг = Услуги.Выгрузить();
		ТранспортныеДокументы_сервер.ЗаполнитьТранспортныеДокументы(Новый Структура("Режим, АкцептУслуги, Поступление", "ОдиночныйДокумент", ВремТаблицаУслуг, Поступление));
		Услуги.Загрузить(ВремТаблицаУслуг);
	КонецЕсли;
		
КонецПроцедуры

