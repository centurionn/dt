Процедура СформироватьЗадачиПоИзменениямСчета()
	
	Если Не ЭтоНовый() Тогда
		
		Изменения = ПолучитьИзмененияСчетаДляФормированияЗадач();
		
		Если Изменения.Количество() > 0 Тогда
			
			ПустаяДата = '00010101';
			ТекДата = ТекущаяДата();
			
			//Задача для менеджера по работе с клиентами, который внес изменения в счет
			СостояниеИзмененСчетПроверитьСоответствиеИнформацииВСделке = Справочники.Состояния.ИзмененСчетПроверитьСоответствиеИнформацииВСделке;
			ТекПользователь = Пользователи.ТекущийПользователь();
			
			ТаблицаСделок = ДокументыОснования.Выгрузить(, "Сделка");
			ТаблицаСделок.Свернуть("Сделка");
			
			Для Каждого СтрТаблицыСделок Из ТаблицаСделок Цикл
				
				Если Не ЗначениеЗаполнено(СтрТаблицыСделок.Сделка) Тогда
					Продолжить;
				КонецЕсли;
				
				СделкаОбъект = СтрТаблицыСделок.Сделка.ПолучитьОбъект();
				
				СтрокаСостояния = СделкаОбъект.Состояния.Найти(СостояниеИзмененСчетПроверитьСоответствиеИнформацииВСделке, "Состояние");
				Если СтрокаСостояния = Неопределено Тогда
					СтрокаСостояния = СделкаОбъект.Состояния.Добавить();
					СтрокаСостояния.Состояние = СостояниеИзмененСчетПроверитьСоответствиеИнформацииВСделке;
				КонецЕсли;
				
				СтрокаСостояния.Исполнитель = ТекПользователь;
				СтрокаСостояния.Наблюдатель = ТекПользователь;
				
				СтрокаСостояния.Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
				СтрокаСостояния.НачалоРаботы = ТекДата;
				
				// ДИТ Ticket#0317593 Сержантова А.С. Начало: 25.07.2023
				СделкаОбъект.ОбменДанными.Загрузка = Истина;
				// ДИТ Ticket#0317593 Сержантова А.С. Конец: 25.07.2023
				СделкаОбъект.Записать();
				
			КонецЦикла;
			
			//Задача для сотрудника, ответственного за учет.
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("Ссылка", Ссылка);
			Запрос.Текст =
			"ВЫБРАТЬ РАЗЛИЧНЫЕ  
			//Евросиб СубботинВ #84453 02.07.2024 Начало // счета покупателей
		//	|	СчетаПокупателей.Сделка КАК Сделка,
		    //Евросиб СубботинВ #84453 02.07.2024 Конец 
			|	СчетаПокупателей.Регистратор КАК Реализация,
			|	СчетаПокупателей.Регистратор.ПериодВО КАК ПериодВО
			|ИЗ
			|	РегистрНакопления.СчетаПокупателей КАК СчетаПокупателей
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации КАК Аннулирование
			|		ПО СчетаПокупателей.Регистратор = Аннулирование.ДокументРеализации
			|			И (Аннулирование.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование))
			|			И (Аннулирование.Проведен)
			|ГДЕ
			|	СчетаПокупателей.СчетПокупателю = &Ссылка
			|	И СчетаПокупателей.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
			|	И СчетаПокупателей.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
			|	И Аннулирование.Ссылка ЕСТЬ NULL";		
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Количество() > 0 Тогда
				
				ОтветственныйЗаУчет = КонтрагентыДоговоры_сервер.ПолучитьОтветственногоПоДоговору(ДоговорКонтрагента, ЦФО);
				Если ЗначениеЗаполнено(ОтветственныйЗаУчет) Тогда
				
					Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Организация");
					//Евросиб Каблов 09.04.2025 ( #105407
					//ТекПериодВО = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериод(Организация);
					ТекПериодВО = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериодДоходов(Организация);
					//Евросиб Каблов 09.04.2025 )
					
					СпрСостояния = Справочники.Состояния;
					
					ИмяСостоянияОтработатьИзменениеСчетаОтменитьРТУ = "ОтработатьИзменениеСчетаОтменитьРТУ";
					ИмяСостоянияОтработатьИзменениеСчетаСоздатьСЗнаИзменениеДокументов = "ОтработатьИзменениеСчетаСоздатьСЗнаИзменениеДокументов";
					
					//СостояниеОтработатьИзменениеСчетаОтменитьРТУ = СпрСостояния[ОтработатьИзменениеСчетаОтменитьРТУ];
					//СостояниеОтработатьИзменениеСчетаСоздатьСЗнаИзменениеДокументов = СпрСостояния.ОтработатьИзменениеСчетаСоздатьСЗнаИзменениеДокументов;
					
					ЕстьРТУвЗакрытомПериоде = Ложь;
					Пока Выборка.Следующий() Цикл
						Если Выборка.ПериодВО < ТекПериодВО Тогда
							ЕстьРТУвЗакрытомПериоде = Истина;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					
					СтрокиКЗавершению = Новый Массив;
					СвободноеСостояниеОтработатьИзменениеСчетаОтменитьРТУ = Неопределено;
					СвободноеСостояниеОтработатьИзменениеСчетаСоздатьСЗнаИзменениеДокументов = Неопределено;
					
					Для Сч = 1 По 10 Цикл
						
						СчСтрокой = Формат(Сч, "ЧГ=0");
						
						Состояние = СпрСостояния[ИмяСостоянияОтработатьИзменениеСчетаОтменитьРТУ + СчСтрокой];
						
						НайденнаяСтрока = Состояния.Найти(Состояние, "Состояние");
						Если НайденнаяСтрока <> Неопределено Тогда
							Если НайденнаяСтрока.Статус <> Перечисления.СтатусыЭтапов.Выполнен
									И НайденнаяСтрока.Статус <> Перечисления.СтатусыЭтапов.Отклонен Тогда
								СтрокиКЗавершению.Добавить(НайденнаяСтрока);
							КонецЕсли;
						ИначеЕсли СвободноеСостояниеОтработатьИзменениеСчетаОтменитьРТУ = Неопределено Тогда
							СвободноеСостояниеОтработатьИзменениеСчетаОтменитьРТУ = Состояние;
						КонецЕсли;
						
						Состояние = СпрСостояния[ИмяСостоянияОтработатьИзменениеСчетаСоздатьСЗнаИзменениеДокументов + СчСтрокой];
						
						НайденнаяСтрока = Состояния.Найти(Состояние, "Состояние");
						Если НайденнаяСтрока <> Неопределено Тогда
							Если НайденнаяСтрока.Статус <> Перечисления.СтатусыЭтапов.Выполнен
									И НайденнаяСтрока.Статус <> Перечисления.СтатусыЭтапов.Отклонен Тогда
								СтрокиКЗавершению.Добавить(НайденнаяСтрока);
							КонецЕсли;
						ИначеЕсли СвободноеСостояниеОтработатьИзменениеСчетаСоздатьСЗнаИзменениеДокументов = Неопределено Тогда
							СвободноеСостояниеОтработатьИзменениеСчетаСоздатьСЗнаИзменениеДокументов = Состояние;
						КонецЕсли;
						
					КонецЦикла;
					
					КомментарииПрошлыхЗадач = Новый Массив;
					Для Каждого СтрокаСостояния Из СтрокиКЗавершению Цикл
						Если ЗначениеЗаполнено(СтрокаСостояния.Комментарий) Тогда
							КомментарииПрошлыхЗадач.Добавить(СтрокаСостояния.Комментарий);
						КонецЕсли;
						СтрокаСостояния.Статус = Перечисления.СтатусыЭтапов.Выполнен;
					КонецЦикла;
					
					Если ЕстьРТУвЗакрытомПериоде Тогда
						Если ЗначениеЗаполнено(СвободноеСостояниеОтработатьИзменениеСчетаОтменитьРТУ) Тогда
							НовоеСостояние = СвободноеСостояниеОтработатьИзменениеСчетаОтменитьРТУ;
						Иначе
							НовоеСостояние = СпрСостояния[ИмяСостоянияОтработатьИзменениеСчетаОтменитьРТУ + "1"];
						КонецЕсли;
					Иначе
						Если ЗначениеЗаполнено(СвободноеСостояниеОтработатьИзменениеСчетаСоздатьСЗнаИзменениеДокументов) Тогда
							НовоеСостояние = СвободноеСостояниеОтработатьИзменениеСчетаСоздатьСЗнаИзменениеДокументов;
						Иначе
							НовоеСостояние = СпрСостояния[ИмяСостоянияОтработатьИзменениеСчетаСоздатьСЗнаИзменениеДокументов + "1"];
						КонецЕсли;
					КонецЕсли;
					
					СтрокаКомментарииПрошлыхЗадач = СтрСоединить(КомментарииПрошлыхЗадач, "; ");
					Инд = Изменения.Количество() - 1;
					Пока Инд >= 0 Цикл
						ТекСтрока = Изменения[Инд];
						Если СтрНайти(СтрокаКомментарииПрошлыхЗадач, ТекСтрока) > 0 Тогда
							Изменения.Удалить(Инд);
						КонецЕсли;
						Инд = Инд - 1;
					КонецЦикла;
					
					СтрокаСостояния = Состояния.Найти(НовоеСостояние, "Состояние");
					Если СтрокаСостояния = Неопределено Тогда
						СтрокаСостояния = Состояния.Добавить();
						СтрокаСостояния.Состояние = НовоеСостояние;
					КонецЕсли;
					
					СтрокаСостояния.Исполнитель = ОтветственныйЗаУчет;
					СтрокаСостояния.Наблюдатель = ОтветственныйЗаУчет;
					
					СтрокаСостояния.Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
					СтрокаСостояния.НачалоРаботы = ТекДата;
					СтрокаСостояния.ЗавершениеРаботы = ПустаяДата; 
					
					СтрокаСостояния.Комментарий = СтрокаКомментарииПрошлыхЗадач + ?(ЗначениеЗаполнено(СтрокаКомментарииПрошлыхЗадач), "; ", "") + СтрСоединить(Изменения, "; ");
				
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

//Евросиб Каблов 25.07.2022 Ticket#0239076
Функция ПолучитьИзмененияСчетаДляФормированияЗадач()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СчетНаОплатуПокупателю.Контрагент КАК Контрагент,
	|	СчетНаОплатуПокупателю.ДоговорКонтрагента КАК ДоговорКонтрагента
	|ИЗ
	|	Документ.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю
	|ГДЕ
	|	СчетНаОплатуПокупателю.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетНаОплатуПокупателюТовары.Идентификатор КАК Идентификатор,
	|	СчетНаОплатуПокупателюТовары.НомерСтроки КАК НомерСтроки,
	|	СчетНаОплатуПокупателюТовары.Номенклатура КАК Номенклатура,
	|	СчетНаОплатуПокупателюТовары.Содержание КАК Содержание,
	|	СчетНаОплатуПокупателюТовары.Количество КАК Количество,
	|	СчетНаОплатуПокупателюТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	СчетНаОплатуПокупателюТовары.Цена КАК Цена,
	|	СчетНаОплатуПокупателюТовары.СтавкаНДС КАК СтавкаНДС,
	|	СчетНаОплатуПокупателюТовары.СуммаНДС КАК СуммаНДС,
	|	СчетНаОплатуПокупателюТовары.Сумма КАК Сумма,
	|	СчетНаОплатуПокупателюТовары.Калькуляция КАК Калькуляция
	|ИЗ
	|	Документ.СчетНаОплатуПокупателю.Товары КАК СчетНаОплатуПокупателюТовары
	|ГДЕ
	|	СчетНаОплатуПокупателюТовары.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	Изменения = Новый Массив;
	
	РеквизитыСчета = РезультатыЗапроса[0].Выбрать();
	Если РеквизитыСчета.Следующий() Тогда
		
		Если РеквизитыСчета.Контрагент <> Контрагент Тогда					
			ТекстИзменения = СтрШаблон("Изменен контрагент: был %1, стал %2", РеквизитыСчета.Контрагент, Контрагент);
			Изменения.Добавить(ТекстИзменения);
		КонецЕсли;
		
		Если РеквизитыСчета.ДоговорКонтрагента <> ДоговорКонтрагента Тогда
			ТекстИзменения = СтрШаблон("Изменен договор: был %1, стал %2", РеквизитыСчета.Контрагент, Контрагент);
			Изменения.Добавить(ТекстИзменения);
		КонецЕсли;
		
	КонецЕсли;
	
	ИсхТаблицаТовары = РезультатыЗапроса[1].Выгрузить();
	ТекТаблицаТовары = Товары.Выгрузить();
	
	ПараметрыПоиска = Новый Структура("Идентификатор");
	
	СписокПолейСравнения = Новый СписокЗначений;
	СписокПолейСравнения.Добавить("Номенклатура", "Номенклатура");
	СписокПолейСравнения.Добавить("Содержание", "СодержаниеУслуги");
	СписокПолейСравнения.Добавить("Количество", "Количество");
	СписокПолейСравнения.Добавить("ЕдиницаИзмерения", "Единица измерения");
	СписокПолейСравнения.Добавить("Цена", "Цена");
	СписокПолейСравнения.Добавить("СтавкаНДС", "Ставка НДС");
	СписокПолейСравнения.Добавить("СуммаНДС", "Сумма НДС");
	СписокПолейСравнения.Добавить("Сумма", "Сумма");
	СписокПолейСравнения.Добавить("Калькуляция", "Калькуляция");
	
	Для Каждого СтрТовары Из ИсхТаблицаТовары Цикл
		
		ЗаполнитьЗначенияСвойств(ПараметрыПоиска, СтрТовары);
		
		СтрокиТекТаблицыТовары = ТекТаблицаТовары.НайтиСтроки(ПараметрыПоиска);
		КоличествоСтрокТекТаблицыТовары = СтрокиТекТаблицыТовары.Количество();
		
		Если КоличествоСтрокТекТаблицыТовары > 0 Тогда
			
			ИзмененияПоСтроке = Новый Массив;
			Для Каждого СтрТЧТовары Из СтрокиТекТаблицыТовары Цикл					
					
				Для Каждого Поле Из СписокПолейСравнения Цикл
					ИмяПоля = Поле.Значение;
					ИсходноеЗначение = СтрТовары[ИмяПоля];
					НовоеЗначение = СтрТЧТовары[ИмяПоля];
					Если ИсходноеЗначение <> НовоеЗначение Тогда
						Если ИмяПоля = "Содержание" Тогда
							ТекстИзменения = "Содержание услуги";
						Иначе
							ТекстИзменения = СтрШаблон("%1: было %2, стало %3", Поле.Представление, ИсходноеЗначение, НовоеЗначение);
						КонецЕсли;
						ИзмененияПоСтроке.Добавить(ТекстИзменения);
					КонецЕсли;				
				КонецЦикла;
				
				ТекТаблицаТовары.Удалить(СтрТЧТовары);
				
			КонецЦикла;
			
			Если ИзмененияПоСтроке.Количество() > 0 Тогда
				ТекстИзмененийПоСтроке = СтрСоединить(ИзмененияПоСтроке, "; ");
				ТекстИзменения = СтрШаблон("Изменена строка №%1 %2, %3", СтрТовары.НомерСтроки, СтрТовары.Номенклатура, ТекстИзмененийПоСтроке);
				Изменения.Добавить(ТекстИзменения);
			КонецЕсли;
			
		Иначе
			
			ТекстИзменения = СтрШаблон("Удалена строка №%1 %2", СтрТовары.НомерСтроки, СтрТовары.Номенклатура);
			Изменения.Добавить(ТекстИзменения);
			
		КонецЕсли;
	
	КонецЦикла;
	
	Для Каждого СтрТовары Из ТекТаблицаТовары Цикл
		ТекстИзменения = СтрШаблон("Добавлена строка №%1 %2", СтрТовары.Номерстроки, СтрТовары.Номенклатура);
		Изменения.Добавить(ТекстИзменения);
	КонецЦикла;
	
	Возврат Изменения;
		
КонецФункции

