	|	СчетНаОплатуПокупателюТовары.Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

//Евросиб Каблов 31.08.2023 #68187
Функция ПолучитьТаблицуДляДвиженийСчетаПокупателейПоУчетнымЕдиницам()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СчетНаОплатуПокупателюТовары.Ссылка.Организация КАК Организация,
	|	СчетНаОплатуПокупателюТовары.Ссылка.Контрагент КАК Контрагент,
	|	СчетНаОплатуПокупателюТовары.Ссылка.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	СчетНаОплатуПокупателюТовары.Номенклатура КАК Номенклатура,
	|	СчетНаОплатуПокупателюТовары.Сумма КАК Сумма,
	|	СчетНаОплатуПокупателюТовары.Ссылка.Дата КАК Период,
	|	СчетНаОплатуПокупателюТовары.Ссылка КАК СчетПокупателю,
	|	СчетНаОплатуПокупателюТовары.Идентификатор КАК Идентификатор,
	|	СчетНаОплатуПокупателюТовары.Количество КАК Количество
	|ПОМЕСТИТЬ Товары
	|ИЗ
	|	Документ.СчетНаОплатуПокупателю.Товары КАК СчетНаОплатуПокупателюТовары
	|ГДЕ
	|	СчетНаОплатуПокупателюТовары.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Организация КАК Организация,
	|	Товары.Контрагент КАК Контрагент,
	|	Товары.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Сумма КАК Сумма,
	|	Товары.Период КАК Период,
	|	Товары.СчетПокупателю КАК СчетПокупателю,
	|	Товары.Идентификатор КАК Идентификатор,
	|	СчетНаОплатуПокупателюУчетныеЕдиницы.УчетнаяЕдиница КАК Контейнер,
	|	Товары.Количество КАК Количество
	|ИЗ
	|	Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетНаОплатуПокупателю.УчетныеЕдиницы КАК СчетНаОплатуПокупателюУчетныеЕдиницы
	|		ПО Товары.СчетПокупателю = СчетНаОплатуПокупателюУчетныеЕдиницы.Ссылка
	|			И Товары.Идентификатор = СчетНаОплатуПокупателюУчетныеЕдиницы.ИдентификаторСтрокиУслуг
	|			И (СчетНаОплатуПокупателюУчетныеЕдиницы.УчетнаяЕдиница ССЫЛКА Справочник.ТЕ)";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

Процедура ПриЗаписи(Отказ)
	
	// Субботин 79718 17.01.2024 Начало
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("МассивПоступленийДляОтвязки") Тогда
		//И ЭтотОбъект.ДополнительныеСвойства.РежимЗаписи <> РежимЗаписиДокумента.Проведение  
		Документы.СчетНаОплатуПокупателю.ОтвязатьПоступления(ЭтотОбъект.ДополнительныеСвойства.МассивПоступленийДляОтвязки, Ссылка);
	КонецЕсли;
	// Субботин 79718 17.01.2024 Конец 
	
//Евросиб Гудкова( 30.10.2020 
	Если ОбменДанными.Загрузка = Истина Тогда
		Возврат;
	КонецЕсли; 	
// Евросиб Гудкова) 	

	//Евросиб(ДИТ), Беляев СЮ, US 93144 / TA 95492, 29-11-2024, начало
	ДокументЗаявкаОснование = Неопределено;
	//Евросиб(ДИТ), Беляев СЮ, US 93144 / TA 95492, 29-11-2024, начало
	
	Для каждого Стр из ДокументыОснования Цикл
		
		Если ЗначениеЗаполнено(Стр.Коносамент) Тогда
			
			КСОбъект = Стр.Коносамент.ПолучитьОбъект();
			НайдСтроки = КСОбъект.Состояния.НайтиСтроки(Новый Структура("Состояние", Справочники.Состояния.СозданиеАвансовогоСчетаПоКоносаменту));
			Для каждого Стр2 из НайдСтроки Цикл
				Стр2.Статус = Перечисления.СтатусыЭтапов.Выполнен;
			КонецЦикла;
			//КСОбъект.Записать();
			//Евросиб(ДИТ), Беляев СЮ, Ticket#0365672, 09-09-2024, начало
			УстановитьПривилегированныйРежим(Истина);
			КСОбъект.Записать();
			УстановитьПривилегированныйРежим(Ложь);
			//Евросиб(ДИТ), Беляев СЮ, Ticket#0365672, 09-09-2024, конец
			
		КонецЕсли;
		
		//Евросиб(ДИТ), Беляев СЮ, US 93144 / TA 95492, 29-11-2024, начало
		Если ЗначениеЗаполнено(Стр.Документ) И ТипЗнч(Стр.Документ) = Тип("ДокументСсылка.Заявка") Тогда
			ДокументЗаявкаОснование = Стр.Документ;
		КонецЕсли;
		//Евросиб(ДИТ), Беляев СЮ, US 93144 / TA 95492, 29-11-2024, конец
		
	КонецЦикла;
	
	//Евросиб Каблов 07.06.2023 ( 68187
	Запрос = Новый Запрос;	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РасчетСНП.Ссылка КАК РасчетСНП,
	|	РасчетСНП.КлючАналитикиПеревозки КАК КлючАналитикиПеревозки,
	|	РасчетСНП.ГУИДСтрокиПротокола КАК ГУИДСтрокиПротокола,
	|	РасчетСНП.Счет КАК Счет
	|ИЗ
	|	Документ.РасчетСНП КАК РасчетСНП
	|ГДЕ
	|	РасчетСНП.Счет = &Счет
	|	И РасчетСНП.СчетПроведен <> &СчетПроведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасчетСНП.Ссылка КАК РасчетСНП,
	|	РасчетСНП.ГУИДСтрокиДохода КАК ГУИДСтрокиДохода
	|ИЗ
	|	Документ.РасчетСНП КАК РасчетСНП
	|ГДЕ
	|	РасчетСНП.ГУИДСтрокиДохода В(&СтрокиДоходовСделки)";	
	Запрос.УстановитьПараметр("Счет", Ссылка);
	Запрос.УстановитьПараметр("СчетПроведен", Проведен);
	
	СтрокиДоходовСделки = Товары.ВыгрузитьКолонку("СтрокаДоходовСделки");	
	ИндексПоследнего = СтрокиДоходовСделки.Количество() - 1;
	Для Сч = 0 По ИндексПоследнего Цикл
		Индекс = ИндексПоследнего - Сч;
		Если СтрокиДоходовСделки[Индекс] = "" Тогда
			СтрокиДоходовСделки.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;
	Запрос.УстановитьПараметр("СтрокиДоходовСделки", СтрокиДоходовСделки);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
		
	Выборка = РезультатыЗапроса[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		РасчетСНП = Выборка.РасчетСНП.ПолучитьОбъект();
		РасчетСНП.СчетПроведен = Проведен;
		РасчетСНП.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;

	Если Проведен Тогда
		Выборка = РезультатыЗапроса[1].Выбрать();
		Пока Выборка.Следующий() Цикл
			РасчетСНП = Выборка.РасчетСНП.ПолучитьОбъект();
			РасчетСНП.ЗакрывающийСчет = Ссылка;
			РасчетСНП.Записать(РежимЗаписиДокумента.Проведение);
		КонецЦикла;
	КонецЕсли;
	//Евросиб Каблов 07.06.2023 )
	// Евросиб US 91362 TA 104075 Рыбьяков К.А. 16.04.2025 ((
	ДобавитьСчетВРасчетДопРасходов();
	// Евросиб Рыбьяков К.А. 16.04.2025 ))
	
	// SIV 01.02.21 Запись события создания счета в историю по контейнерам
	КлючевыеСобытияСделкиСервер.ОбработатьЗаписьСчетаПокупателю(ЭтотОбъект);
	
	//Евросиб(ДИТ), Беляев СЮ, US 90649 / TA 93760, 02-11-2024, начало
	Если ДополнительныеСвойства.Свойство("ГруппаДКС") Тогда
		РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ЗаписатьГруппуДКСпоДокументу(Ссылка, ДополнительныеСвойства.ГруппаДКС);
	КонецЕсли;
	//Евросиб(ДИТ), Беляев СЮ, US 90649 / TA 93760, 02-11-2024, конец
	
	//ДИТ Шевченко А.В. 17.01.2024 US 91366 TA 93137 -начало
	Если ДополнительныеСвойства.Свойство("ТранзитДляКлиента") Тогда
		РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ЗаписатьТранзитДляКлиентапоДокументу(Ссылка, ДополнительныеСвойства.ТранзитДляКлиента);
	КонецЕсли;
	//ДИТ Шевченко А.В. 17.01.2024 US 91366 TA 93137 -конец
	
	//Евросиб(ДИТ), Беляев СЮ, US 93144 / TA 95492, 29-11-2024, начало

	//ДИТ Шевченко А.В. US 103646 TA 103658 06.03.2025
	Если ДокументЗаявкаОснование <> Неопределено Тогда
		ВидЗадолженностиЗаявки = РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ПолучитьВидЗадолженностиПоДокументу(ДокументЗаявкаОснование);
		РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ЗаписатьВидЗадолженностиПоДокументу(ДокументЗаявкаОснование, ВидЗадолженностиЗаявки);		
	КонецЕсли;
	//ДИТ Шевченко А.В. US 103646 TA 103658 06.03.2025
	
	//Евросиб(ДИТ), Беляев СЮ, US 93144 / TA 95492, 29-11-2024, конец
	
	//Евросиб(ДИТ), Беляев СЮ, US 98449 / TA 98451, 20-12-2024, начало
	ЗаписатьСчет_в_РТУ();
	//Евросиб(ДИТ), Беляев СЮ, US 98449 / TA 98451, 20-12-2024, конец
	
КонецПроцедуры

