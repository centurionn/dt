Функция СодержаниеУслугиПоРелизу(ДанныеЗаполнения, СтрокаТоваров, НайденныйКлиент, ТабличнаяЧасть)
		
	//Евросиб(ДИТ), Беляев СЮ, BUG 78672 / TA 91087, 02-09-2024, начало (всегда будут правила, функция не экспортная и вызов только из одного места)
	ФормироватьСтрокиДокументовНаКаждыйКонтейнерОтдельно = Ложь;
	РазделятьДокументыНаКаждыйКонтейнерОтдельно = Ложь;
	Таблица = Новый ТаблицаЗначений;
	Если НайденныйКлиент <> Неопределено Тогда
		ФормироватьСтрокиДокументовНаКаждыйКонтейнерОтдельно = НайденныйКлиент.ФормироватьСтрокиДокументовНаКаждыйКонтейнерОтдельно;
		РазделятьДокументыНаКаждыйКонтейнерОтдельно = НайденныйКлиент.РазделятьДокументыНаКаждыйКонтейнерОтдельно; 
		
		РезультатЗапроса_ОписаниеУслугиСчет = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НайденныйКлиент.Документ, "ОписаниеУслугиСчет");
		ТаблицаОписаниеУслугиСчет = РезультатЗапроса_ОписаниеУслугиСчет.Выгрузить();
		ПараметрыОтбора = Новый Структура("Использование", Истина);
		Таблица = ТаблицаОписаниеУслугиСчет.Скопировать(ПараметрыОтбора);
	КонецЕсли;
	//Евросиб(ДИТ), Беляев СЮ, BUG 78672 / TA 91087, 02-09-2024, конец

	СодержаниеУслуги = "";
	
	СтанцияОтправления = Справочники.Локации.ПустаяСсылка();
	СтанцияНазначения = Справочники.Локации.ПустаяСсылка();
	
	КТКМассив = Новый Массив;
	Если НЕ ФормироватьСтрокиДокументовНаКаждыйКонтейнерОтдельно 
		И НЕ РазделятьДокументыНаКаждыйКонтейнерОтдельно Тогда
		Для Каждого Строка Из ТабличнаяЧасть Цикл
			Если Строка.РазмерКТК = СтрокаТоваров.РазмерКТК И Строка.СтавкаНДС = СтрокаТоваров.СтавкаНДС Тогда
				Если ЗначениеЗаполнено(Строка.НомерКТК) И КТКМассив.Найти(Строка.НомерКТК) = Неопределено Тогда 
					КТКМассив.Добавить(Строка.НомерКТК);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Если ЗначениеЗаполнено(СтрокаТоваров.НомерКТК) Тогда
			КТКМассив.Добавить(СтрокаТоваров.НомерКТК);
		КонецЕсли;
	КонецЕсли; 
	
	КТКСписок = СтрСоединить(КТКМассив,"; ");
	
	Для Каждого КТК Из КТКМассив Цикл
		нСтрокаУЕ = УчетныеЕдиницы.Добавить();
		нСтрокаУЕ.ИдентификаторСтрокиУслуг = СтрокаТоваров.Идентификатор;
		нСтрокаУЕ.УчетнаяЕдиница = КТК;
	КонецЦикла;
	
	//Если НайденныйКлиентЭтоПравило = Ложь И НайденныйКлиент.Пустой() Тогда
	//Евросиб(ДИТ), Беляев СЮ, BUG 78672 / TA 91087, 02-09-2024, начало
	Если НайденныйКлиент = Неопределено Тогда
	//Евросиб(ДИТ), Беляев СЮ, BUG 78672 / TA 91087, 02-09-2024, конец
		СодержаниеУслуги = СтрокаТоваров.Номенклатура.НаименованиеПолное 
								+ ?(ЗначениеЗаполнено(СтанцияОтправления) 
								И ЗначениеЗаполнено(СтанцияНазначения), " по направлению " 
								+ СтанцияОтправления + " - " + СтанцияНазначения, "");
		
		ТипЗаказа = Справочники.ТипыЗаказов.КонтейнерныйПоезд;
		
		Если КТКСписок <> Неопределено Тогда
			СодержаниеУслуги = СодержаниеУслуги + Символы.ПС + "Список контейнеров: " + КТКСписок;
		КонецЕсли;

	//ИначеЕсли НайденныйКлиентЭтоПравило Или НЕ НайденныйКлиент.Пустой() Тогда
	//Евросиб(ДИТ), Беляев СЮ, BUG 78672 / TA 91087, 02-09-2024, начало
	Иначе
	//Евросиб(ДИТ), Беляев СЮ, BUG 78672 / TA 91087, 02-09-2024, конец
		
		Для Каждого Строка Из Таблица Цикл
			ТекстСодержание = "";
			Если Строка.НазваниеРеквизита = "НомерКТК" Тогда
				Если КТКСписок <> Неопределено Тогда
					ТекстСодержание = КТКСписок;
				КонецЕсли;
			КонецЕсли;
			Если Строка.НазваниеРеквизита = "Номенклатура" Тогда
				ТекстСодержание = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТоваров.Номенклатура, "НаименованиеПолное");
			КонецЕсли; 
			
			СодержаниеУслуги = СодержаниеУслуги + Символы.ПС + Строка.ТекстовоеОписание + " " + ТекстСодержание;
			
		КонецЦикла;
		СодержаниеУслуги = СокрЛП(СодержаниеУслуги);
		
	КонецЕсли;
	
	Возврат СодержаниеУслуги;
	
КонецФункции
// Евросиб Рыбьяков К.А. 20.08.2024 ))

// Евросиб US 87923 TA 104654 Рыбьяков К.А. 12.03.2025 ((
Процедура ЗаполнитьТабличнуюЧастьНаОснованииАкцепта(ДокументОснование)
	
	ЗапросДанныеАкцепта = Новый Запрос;
	ЗапросДанныеАкцепта.Текст = "ВЫБРАТЬ
	|	АктуальныеАкцептыСрезПоследних.Акцепт КАК Акцепт
	|ПОМЕСТИТЬ ВТ_АктуальныйАкцепт
	|ИЗ
	|	РегистрСведений.АктуальныеАкцепты.СрезПоследних(, Поступление = &Поступление) КАК АктуальныеАкцептыСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоступлениеТоваровУслугУслуги.ГУИДПТУ КАК ИдентификаторСтрокиПТУ
	|ПОМЕСТИТЬ ВТ_СтрокиПоступления
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Услуги КАК ПоступлениеТоваровУслугУслуги
	|ГДЕ
	|	ПоступлениеТоваровУслугУслуги.Ссылка = &Поступление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СтрокиПоступления.ИдентификаторСтрокиПТУ КАК ИдентификаторСтрокиПоступления,
	|	АкцептУслуги.Номенклатура КАК Номенклатура,
	|	АкцептУслуги.Содержание КАК Содержание,
	|	СУММА(АкцептУслуги.ПоступлениеКоличество) КАК Количество,
	|	АкцептУслуги.СтанцияОтправления КАК ПунктОтправления,
	|	АкцептУслуги.СтанцияНазначения КАК ПунктНазначения,
	|	СУММА(АкцептУслуги.ПоступлениеСумма) КАК Сумма,
	|	СУММА(АкцептУслуги.ПоступлениеСумма) КАК ЦенаВВалюте,
	|	АкцептУслуги.ПоступлениеЦена КАК Цена,
	|	АкцептУслуги.ПоступлениеСтавкаНДС КАК СтавкаНДС,
	|	СУММА(АкцептУслуги.СуммаНДС) КАК СуммаНДС,
	|	АкцептУслуги.Контейнер.ТипТЕ КАК ТипКТК
	|ИЗ
	|	ВТ_АктуальныйАкцепт КАК ВТ_АктуальныйАкцепт
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Акцепт.Услуги КАК АкцептУслуги
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтрокиПоступления КАК ВТ_СтрокиПоступления
	|			ПО (ВТ_СтрокиПоступления.ИдентификаторСтрокиПТУ = АкцептУслуги.ИдентификаторСтрокиПоступления)
	|		ПО ВТ_АктуальныйАкцепт.Акцепт = АкцептУслуги.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_АктуальныйАкцепт.Акцепт,
	|	АкцептУслуги.Номенклатура,
	|	АкцептУслуги.Содержание,
	|	АкцептУслуги.СтанцияОтправления,
	|	АкцептУслуги.СтанцияНазначения,
	|	АкцептУслуги.ПоступлениеСтавкаНДС,
	|	АкцептУслуги.ПоступлениеЦена,
	|	ВТ_СтрокиПоступления.ИдентификаторСтрокиПТУ,
	|	АкцептУслуги.Контейнер.ТипТЕ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	АкцептУслуги.Контейнер КАК Контейнер,
	|	АкцептУслуги.ИдентификаторСтрокиПоступления КАК ИдентификаторСтрокиПоступления,
	|	АкцептУслуги.Контейнер.ТипТЕ КАК ТипКТК,
	|	АкцептУслуги.Контейнер.ТипТЕ.РазмерКТК КАК РазмерКТК
	|ИЗ
	|	ВТ_АктуальныйАкцепт КАК ВТ_АктуальныйАкцепт
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Акцепт.Услуги КАК АкцептУслуги
	|		ПО ВТ_АктуальныйАкцепт.Акцепт = АкцептУслуги.Ссылка";
	
