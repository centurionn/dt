
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка = Истина Тогда
		Возврат;
	КонецЕсли; 	
	
	//Шевченко А.В. US 117858 TA 115011 05.09.2025 - пока в разработке уберу что бы не мешал тестам
	Если НЕ Документы.СчетНаОплатуПокупателю.ЭтоСчетИзРИТМ(ЭтотОбъект.Ссылка) Тогда //Евросиб Шевченко А.В. US 121605 TA 121622 14.10.2025
		Если Контрагент.СтранаРегистрации <> Справочники.СтраныМира.Россия И Документы.СчетНаОплатуПокупателю.ПроверитьНоменклатуруДляУдаленияСчета(Товары.ВыгрузитьКолонку("Номенклатура")) Тогда
			
			Если ЗначениеЗаполнено(Ссылка) Тогда
				Если ДополнительныеСвойства.Свойство("ГруппаДКС") Тогда	
					
					сПоиска = Новый Структура("Состояние",ПредопределенноеЗначение("Справочник.Состояния.ТребуетсяПометкаНаУдалениеСчета"));
					НайденныеСтроки = Состояния.НайтиСтроки(сПоиска);
					
					Если НайденныеСтроки.Количество() Тогда
						СформироватьЗаново = Истина;
						Для Каждого НайдСтрока Из НайденныеСтроки Цикл
							Если НайдСтрока.Статус = Перечисления.СтатусыЭтапов.Выполнен ИЛИ НайдСтрока.Статус = Перечисления.СтатусыЭтапов.Отклонен ИЛИ НайдСтрока.Статус = Перечисления.СтатусыЭтапов.Отозван Тогда
								СформироватьЗаново = Ложь;
							КонецЕсли;	
						КонецЦикла;	
						
						Если ДополнительныеСвойства.ГруппаДКС <> РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ПолучитьГруппуДКСпоДокументу(Ссылка) И СформироватьЗаново Тогда
							МаршрутизацияСервер.СформироватьЗадачуПометкаНаУдалениеСчета(ЭтотОбъект,ДополнительныеСвойства.ГруппаДКС);	
						КонецЕсли;	
					КонецЕсли;	
					
				КонецЕсли;	
			КонецЕсли;
			
			Если Ссылка.РазрешитьУдаление И НЕ СогласоватьУдаление И НЕ Ссылка.ПометкаУдаления Тогда
				Если РежимЗаписи = РежимЗаписиДокумента.Проведение ИЛИ РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
					
					мУдалемыеСтроки = Новый Массив;
					
					СтрокаСостояния = Состояния.НайтиСтроки(Новый Структура("Состояние,Статус", Справочники.Состояния.ТребуетсяПометкаНаУдалениеСчета, Перечисления.СтатусыЭтапов.Выполнен));
					Если СтрокаСостояния.Количество() <> 0 Тогда
						Для Каждого СтрокаС Из СтрокаСостояния Цикл
							мУдалемыеСтроки.Добавить(СтрокаС);
						КонецЦикла;	
					КонецЕсли;
					СтрокаСостояния = Состояния.НайтиСтроки(Новый Структура("Состояние,Статус", Справочники.Состояния.УдалениеСчета, Перечисления.СтатусыЭтапов.Выполнен));
					Если СтрокаСостояния.Количество() <> 0 Тогда
						Для Каждого СтрокаС Из СтрокаСостояния Цикл
							мУдалемыеСтроки.Добавить(СтрокаС);
						КонецЦикла;	
					КонецЕсли;
					Для Каждого УдлСтрока Из мУдалемыеСтроки Цикл
						Состояния.Удалить(УдлСтрока);
					КонецЦикла;
					
					РазрешитьУдаление = Ложь;
					
				КонецЕсли;				
			КонецЕсли;
			
			Если Ссылка.РазрешитьУдаление И НЕ РазрешитьУдаление И СогласоватьУдаление И НЕ Ссылка.ПометкаУдаления Тогда
				Если РежимЗаписи = РежимЗаписиДокумента.Проведение ИЛИ РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
					СтрокаСостояния = Состояния.НайтиСтроки(Новый Структура("Состояние,Статус", Справочники.Состояния.ТребуетсяПометкаНаУдалениеСчета, Перечисления.СтатусыЭтапов.Выполнен));
					Если СтрокаСостояния.Количество() <> 0 Тогда
						СтрокаСостояния[0].Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;				

			
			Если НЕ РазрешитьУдаление Тогда
				Если Ссылка.ПометкаУдаления <> ПометкаУдаления Тогда
					Если ПометкаУдаления Тогда
						Отказ = Ссылка.ПометкаУдаления <> ПометкаУдаления;
					КонецЕсли;	
				КонецЕсли;
				
				Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
					Отказ = Истина;
				КонецЕсли;
				
				Если Отказ Тогда
					ОбщегоНазначения.СообщитьПользователю("Удаление, отмена проведения счета запрещены. Согласуйте действие и повторите попытку");
				КонецЕсли;	
				
			КонецЕсли;
			
			Если РазрешитьУдаление Тогда
				
				СтрокаСостояния = Состояния.НайтиСтроки(Новый Структура("Состояние,Статус", Справочники.Состояния.УдалениеСчета, Перечисления.СтатусыЭтапов.ВРаботе));
				Если СтрокаСостояния.Количество() <> 0 Тогда
					Если РазрешитьУдаление И (РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения ИЛИ ПометкаУдаления) Тогда
						мЗадачи = Новый Массив;
						мЗадачи.Добавить(Справочники.Состояния.УдалениеСчета);
						МаршрутизацияСервер.ОтметитьВыполнениеЗадач(ЭтотОбъект, мЗадачи);
						ЭтотОбъект.СогласоватьУдаление = Ложь;
					КонецЕсли;		
				КонецЕсли;
				
				СтрокаСостояния = Состояния.НайтиСтроки(Новый Структура("Состояние,Статус", Справочники.Состояния.УдалениеСчета, Перечисления.СтатусыЭтапов.НаВыполнение));
				Если СтрокаСостояния.Количество() <> 0 Тогда
					Если РазрешитьУдаление И (РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения ИЛИ ПометкаУдаления) Тогда
						мЗадачи = Новый Массив;
						мЗадачи.Добавить(Справочники.Состояния.УдалениеСчета);
						МаршрутизацияСервер.ОтметитьВыполнениеЗадач(ЭтотОбъект, мЗадачи);
						ЭтотОбъект.СогласоватьУдаление = Ложь;
					КонецЕсли;		
				КонецЕсли;
				
				СтрокаСостояния = Состояния.НайтиСтроки(Новый Структура("Состояние,Статус", Справочники.Состояния.УдалениеСчета, Перечисления.СтатусыЭтапов.Выполнен));
				Если СтрокаСостояния.Количество() <> 0 Тогда
					Если РазрешитьУдаление И (РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения ИЛИ ПометкаУдаления) Тогда
						ЭтотОбъект.СогласоватьУдаление = Ложь;
					КонецЕсли;		
				КонецЕсли;
				
			КонецЕсли;	
			
		КонецЕсли;
	КонецЕсли;
	//Шевченко А.В. US 117858 TA 115011 05.09.2025
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		//БанковскийСчетОрганизацииЪ = ОбщегоНазначенияВызовСервера.РасчетныйСчетПоДоговору(ДоговорКонтрагента, Дата, ВалютаДокумента);
		//Если ЗначениеЗаполнено(БанковскийСчетОрганизацииЪ) Тогда	
		//	БанковскийСчетОрганизации = БанковскийСчетОрганизацииЪ;
		//КонецЕсли;	
		
		//ДИТ, Беляев СЮ, TA48059, 12-04-2022, начало	 
		Если НЕ ЗначениеЗаполнено(БанковскийСчетОрганизации) Тогда
			БанковскийСчетОрганизации = ОбщегоНазначенияВызовСервера.РасчетныйСчетПоДоговору(ДоговорКонтрагента, Дата);
		КонецЕсли; 
		//ДИТ, Беляев СЮ, TA48059, 12-04-2022, конец
	КонецЕсли;
	
	// Субботин 79718 17.01.2024 Начало // проверяем привязаны ли поступления 
	ПроверитьСвязанныеПоступления(ЭтотОбъект, Отказ, РежимЗаписи);
	Если Отказ Тогда
		Возврат
	КонецЕсли;	
	// Субботин 79718 17.01.2024 Конец   
	
	// SIV 10-10-2020 Исправление суммы документа, там как-то криво считается
	ИтогоВсегоНДС = ?(Товары.Количество()>0, Товары.Итог("СуммаНДС"),0);//+?(Объект.Услуги.Количество()>0,Объект.Услуги.Итог("СуммаНДС"),0);
	СуммаДокумента = ?(Товары.Количество()>0, Товары.Итог("Сумма"),0)+?(СуммаВключаетНДС,0,ИтогоВсегоНДС);//+ ?(Объект.Услуги.Количество()>0,Объект.Услуги.Итог("Сумма"),0);
	// - SIV
	
	Редактор = Пользователи.ТекущийПользователь();
	Изменено = ТекущаяДата();
// Евросиб Литвинов 04.05.2021 #33707(
 	Если НЕ ЗначениеЗаполнено(ДатаДокумента) Тогда
		ДатаДокумента = Дата;
	КонецЕсли;
// Евросиб Литвинов 04.05.2021 #33707)
	Если Не БезДоверенностей Тогда
//Евросиб Гудкова( 15.02.2021 Ticket№ 0223421
//		СтруктураПодписантовПоДоверенности = БухгалтерскийУчетОбщиеПроцедурыСервер.НайтиДействующиеДоверенностиНаПодпись(Дата,"Счет на оплату покупателю", ЦФО);
		СтруктураПодписантовПоДоверенности = БухгалтерскийУчетОбщиеПроцедурыСервер.НайтиДействующиеДоверенностиНаПодпись(ДатаДокумента,"Счет на оплату покупателю", ЦФО);
// Евросиб Гудкова) 		
		
		ДоверенностьЗаРуководителя = СтруктураПодписантовПоДоверенности.ДоверенностьЗаРуководителя;
		ДоверенностьЗаГлБухгалтера = СтруктураПодписантовПоДоверенности.ДоверенностьЗаГБ;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Номер)  Тогда
		УстановитьНовыйНомер();
	КонецЕсли;
	
	//Евросиб Коханенко Н.А. 15.03.2024 (( #82079 
	Если Не ЗначениеЗаполнено(ПервоначальныйНомер)  Тогда
		ПервоначальныйНомер = Номер;
	КонецЕсли;
	//Евросиб Коханенко Н.А. 15.03.2024 )) #82079 
	
	//Евросиб Каблов 15.07.2020 (
	//НомерДляПечати = ?(НомерДляПечати = "" или НомерДляПечати = "/Н" или НомерДляПечати = "/Р",Номер + ?(Контрагент.СтранаРегистрации = Справочники.СтраныМира.Россия,"/Р","/Н"),НомерДляПечати);
	//Евросиб Шевченко А.В. US 114791 TA 115034 25.07.2025
	Если НЕ ЭтотОбъект.ДополнительныеСвойства.Свойство("ЗагрузкаИзРитм") И НЕ Документы.СчетНаОплатуПокупателю.ЭтоСчетИзРИТМ(ЭтотОбъект.Ссылка) Тогда
		//ДИТ, Беляев СЮ, Ticket#0306636 / BUG 68999, 05-06-2023, начало (заполним подразделение перед тем как его использовать, ранее вызов был ниже в процедуре)
		ЗаполнитьОбязательныеПоля();
		//ДИТ, Беляев СЮ, Ticket#0306636 / BUG 68999, 05-06-2023, конец
		ДлинаИндекса = 0;
		Если ЗначениеЗаполнено(ПодразделениеОрганизации) Тогда
			ЦифровойИндексПодразделения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПодразделениеОрганизации, "ЦифровойИндексОбособленногоПодразделения");
			Если ЗначениеЗаполнено(ЦифровойИндексПодразделения) Тогда
				//Евросиб - АСуслов 12.09.2022 13:58:36 #
				//(
				//ЦифровойИндексПодразделения = "/" + Строка(ЦифровойИндексПодразделения);
				ЦифровойИндексПодразделения = Строка(ЦифровойИндексПодразделения);
				//)
				//Евросиб - АСуслов 12.09.2022 13:58:36 #
				ДлинаИндекса = СтрДлина(ЦифровойИндексПодразделения);
			Иначе
				ЦифровойИндексПодразделения = "";
			КонецЕсли;
		Иначе		
			ЦифровойИндексПодразделения = "";
		КонецЕсли;
		//Евросиб - АСуслов 12.09.2022 13:58:10 #
		//(
		//разделитель не будем сравнивать
		//ИндексВНомереДляПечати = Сред(НомерДляПечати,СтрНайти(НомерДляПечати, ЦифровойИндексПодразделения), ДлинаИндекса);
		ИндексВНомереДляПечати = Прав(НомерДляПечати, ДлинаИндекса);
		//)
		//Евросиб - АСуслов 12.09.2022 13:58:10 #
		//Евросиб Каблов 02.09.2025 ( #111016
		НайденИндексВНомере = Ложь;
		Если ИндексВНомереДляПечати = ЦифровойИндексПодразделения Тогда
			НайденИндексВНомере = Истина;
		Иначе
			СтрокаПоиска = СтрШаблон("/%1/", ЦифровойИндексПодразделения);
			Если СтрНайти(НомерДляПечати, СтрокаПоиска) > 0 Тогда
				НайденИндексВНомере = Истина;
			КонецЕсли;
		КонецЕсли;
		//Евросиб Каблов 02.09.2025 ) #111016
		Если НомерДляПечати = "" 
			Или НомерДляПечати = "/Н" 
			Или НомерДляПечати = "/Р"
			//Евросиб Каблов 02.09.2025 ( #111016
			//Или ИндексВНомереДляПечати <> ЦифровойИндексПодразделения Тогда
			Или Не НайденИндексВНомере Тогда
			//Евросиб Каблов 02.09.2025 ) #111016
			Если ДополнительныеСвойства.Свойство("НомерДокументаАванса") Тогда
				НомерДляПечати = ДополнительныеСвойства.НомерДокументаАванса;
			Иначе
				//Евросиб - АСуслов 12.09.2022 13:59:54 #
				//(
				//НомерДляПечати = Номер + ?(Контрагент.СтранаРегистрации = Справочники.СтраныМира.Россия,"/Р","/Н") + ЦифровойИндексПодразделения;	
				НомерДляПечати = СтрШаблон("%1/%2/%3",
				Номер,
				?(Справочники.Контрагенты.КонтрагентНерезидент(Контрагент),"Н","Р"),
				ЦифровойИндексПодразделения);	
				//)
				//Евросиб - АСуслов 12.09.2022 13:59:54 #
			КонецЕсли; 
			//Евросиб - АСуслов 09.09.2022 11:12:50 #56897
			//(
			Если ЗначениеЗаполнено(ПравилоФормирования) Тогда
				РазделительЭлементовНомераДляПечати = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПравилоФормирования, "РазделительЭлементовНомераДляПечати");
				Если ЗначениеЗаполнено(РазделительЭлементовНомераДляПечати) Тогда
					НомерДляПечати = СтрЗаменить(НомерДляПечати, "/", РазделительЭлементовНомераДляПечати)
				КонецЕсли;
			КонецЕсли;
			//)
			//Евросиб - АСуслов 09.09.2022 11:13:57 #56897
		КонецЕсли;  
		//Евросиб Каблов 15.07.2020 )
	КонецЕсли;
	//Евросиб Шевченко А.В. US 114791 TA 115034 25.07.2025
	// SIV 18-12-19 При перезаписи документа не должна меняться дата просто так
	//Если НЕ РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
	//	ДатаДокумента = ФормированиеДатДокументов.УстановкаДатыДокумента(ЭтотОбъект,ДоговорКонтрагента.ПравилоФормированияДатыУслуги);
	//КонецЕсли;
	// + Состояния
	
	// проверяем корректность перечня состояний в ТЧ Состояния
	Для Сч = 0 По Состояния.Количество() - 2 Цикл
		ТекСостояние = Состояния[Сч].Состояние;
		Для ТекСч = Сч + 1 По Состояния.Количество() - 1 Цикл
			Если Состояния[ТекСч].Состояние = ТекСостояние Тогда
				Сообщить("Ошибка: одно состояние может встречаться в документе только один раз!");
				Отказ = Истина;
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// для состояний отражаем логику движения статусов
	//Для Сч = 0 По Состояния.Количество() - 2 Цикл
	//	Если Состояния[Сч].Статус = Перечисления.СтатусыЭтапов.Выполнен И Состояния[Сч+1].Статус = Перечисления.СтатусыЭтапов.Новый Тогда
	//		Состояния[Сч+1].Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
	//		Если НЕ ЗначениеЗаполнено(Состояния[Сч+1].Исполнитель) Тогда
	//			Состояния[Сч+1].Исполнитель = Пользователи.ТекущийПользователь();
	//		КонецЕсли;
	//	КонецЕсли;
	//КонецЦикла;
	
	//++ Зубов 35844 05.08.2021
	////Стаценко Параллельное согласование
	//Для каждого СтрТЧ из Состояния Цикл
	//	Если Не ЗначениеЗаполнено(СтрТЧ.ПредыдущиеЭтапы) и СтрТЧ.Статус = Перечисления.СтатусыЭтапов.Новый Тогда
	//		СтрТЧ.Статус = Перечисления.СтатусыЭтапов.НаВыполнение;
