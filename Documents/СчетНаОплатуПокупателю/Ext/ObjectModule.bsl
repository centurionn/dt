Процедура ОбработкаУдаленияПроведения(Отказ)
	  	
	Документы.СчетНаОплатуПокупателю.ПроверитьНаличиеПроведенныхРеализаций(Ссылка,Отказ);
	
	//Евросиб Шевченко А.В. US 121985 TA 122270 19.11.2025
	СтрокаСостояния = Состояния.НайтиСтроки(Новый Структура("Состояние,Статус", Справочники.Состояния.УдалениеСчета, Перечисления.СтатусыЭтапов.ВРаботе));
	Если СтрокаСостояния.Количество() <> 0 Тогда
		Если РазрешитьУдаление И (НЕ Проведен ИЛИ ПометкаУдаления) Тогда
			мЗадачи = Новый Массив;
			мЗадачи.Добавить(Справочники.Состояния.УдалениеСчета);
			МаршрутизацияСервер.ОтметитьВыполнениеЗадач(ЭтотОбъект, мЗадачи);
			СогласоватьУдаление = Ложь;
		КонецЕсли;		
	КонецЕсли;	
	//Евросиб Шевченко А.В. US 121985 TA 122270 19.11.2025
	
КонецПроцедуры
