		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДанныеАкцепта);
		НоваяСтрока.ИсходнаяВалюта = ДокументОснование.ВалютаДокумента;
		НоваяСтрока.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ктк;
		НоваяСтрока.Идентификатор = Новый УникальныйИдентификатор;
		НоваяСтрока.РазмерКТК = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыборкаДанныеАкцепта.ТипКТК, "РазмерКТК");
		
		Отбор = Новый Структура;
		Отбор.Вставить("ИдентификаторСтрокиПоступления", ВыборкаДанныеАкцепта.ИдентификаторСтрокиПоступления);
		Отбор.Вставить("РазмерКТК", НоваяСтрока.РазмерКТК);
		НайденныеКонтейнеры = ВыгрузкаКонтейнеры.НайтиСтроки(Отбор);
		Для Каждого СтрокаСКТК Из НайденныеКонтейнеры Цикл
			НоваяСтрокаСКТК = УчетныеЕдиницы.Добавить();
			НоваяСтрокаСКТК.УчетнаяЕдиница = СтрокаСКТК.Контейнер;
			НоваяСтрокаСКТК.ИдентификаторСтрокиУслуг = НоваяСтрока.Идентификатор;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры
