Процедура ЗаполнитьДокументыОснованияИУчетныеЕдиницы()
	Для каждого СтрокаТовар Из Товары Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТовар.Идентификатор) Тогда
			СтрокаТовар.Идентификатор = Новый УникальныйИдентификатор;
		КонецЕсли;
	КонецЦикла;
	Если ДокументыОснования.Количество() = 0 Тогда

		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СчетНаОплатуПокупателюТовары.Идентификатор КАК Идентификатор,
		|	СчетНаОплатуПокупателюТовары.СтрокаДоходовСделки КАК СтрокаДоходовСделки
		|ПОМЕСТИТЬ ВТ_Товары
		|ИЗ
		|	Документ.СчетНаОплатуПокупателю.Товары КАК СчетНаОплатуПокупателюТовары
		|ГДЕ
		|	НЕ СчетНаОплатуПокупателюТовары.СтрокаДоходовСделки = """"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СделкаСвязьУчетныхЕдиниц.Заявка КАК Документ,
		|	СделкаСвязьУчетныхЕдиниц.Ссылка КАК Сделка,
		|	СделкаСвязьУчетныхЕдиниц.Контейнер КАК Контейнер,
		|	СделкаСвязьУчетныхЕдиниц.Вагон КАК Вагон,
		|	ВТ_Товары.Идентификатор КАК ИдентификаторСтрокиУслуг
		|ПОМЕСТИТЬ ВТ_СоставПоезда
		|ИЗ
		|	ВТ_Товары КАК ВТ_Товары
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьДоходовИРасходов КАК СделкаСвязьДоходовИРасходов
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
		|			ПО СделкаСвязьДоходовИРасходов.СвязьУчетныхЕдиниц = СделкаСвязьУчетныхЕдиниц.ГУИД
		|				И СделкаСвязьДоходовИРасходов.Ссылка = СделкаСвязьУчетныхЕдиниц.Ссылка
		|		ПО ВТ_Товары.СтрокаДоходовСделки = СделкаСвязьДоходовИРасходов.Доходы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_СоставПоезда.Документ КАК Документ,
		|	ВТ_СоставПоезда.Сделка КАК Сделка
		|ИЗ
		|	ВТ_СоставПоезда КАК ВТ_СоставПоезда
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_СоставПоезда.ИдентификаторСтрокиУслуг КАК ИдентификаторСтрокиУслуг,
		|	ВТ_СоставПоезда.Контейнер КАК УчетнаяЕдиница
		|ИЗ
		|	ВТ_СоставПоезда КАК ВТ_СоставПоезда
		|ГДЕ
		|	НЕ ВТ_СоставПоезда.Контейнер = ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_СоставПоезда.ИдентификаторСтрокиУслуг,
		|	ВТ_СоставПоезда.Вагон
		|ИЗ
		|	ВТ_СоставПоезда КАК ВТ_СоставПоезда
		|ГДЕ
		|	НЕ ВТ_СоставПоезда.Вагон = ЗНАЧЕНИЕ(Справочник.ТС.ПустаяСсылка)";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.СчетНаОплатуПокупателю.Товары", "&Товары");
		Запрос.УстановитьПараметр("Товары", Товары.Выгрузить());
		Запрос.УстановитьПараметр("Доходы", Товары.ВыгрузитьКолонку("СтрокаДоходовСделки"));
		Пакеты = Запрос.ВыполнитьПакет();              
		КоличествоПакетов = Пакеты.Количество();
		ДокументыОснования.Загрузить(Пакеты[КоличествоПакетов-2].Выгрузить());
		УчетныеЕдиницы.Загрузить(Пакеты[КоличествоПакетов-1].Выгрузить());
		
		//Евросиб(ДИТ), Беляев СЮ, US 90649 / TA 95187, 20-11-2024, начало
		Если ДокументыОснования.Количество()>0 Тогда
			ГруппаДКС_Основания = Неопределено;
			ТранзитДляКлиента_Основания = Неопределено; //ДИТ Шевченко А.В. 17.01.2024 US 91366 TA 93137 
			ДокументПервойСтроки = ДокументыОснования[0].Документ;
			Если ТипЗнч(ДокументПервойСтроки) = Тип("ДокументСсылка.Заявка") Тогда
				ГруппаДКС_Основания = РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ПолучитьГруппуДКСпоДокументу(ДокументПервойСтроки);
				
				//ДИТ Шевченко А.В. 17.01.2024 US 91366 TA 93137 -начало
				ТранзитДляКлиента_Основания = РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ПолучитьТранзитДляКлиентаПоДокументу(ДокументПервойСтроки);
				//ДИТ Шевченко А.В. 17.01.2024 US 91366 TA 93137 -конец
				
			ИначеЕсли ТипЗнч(ДокументПервойСтроки) = Тип("ДокументСсылка.РелизСобственника") Тогда
				ГруппаДКС_Основания = Справочники.ГруппыДКС.ДМС;
			КонецЕсли;
			Если ГруппаДКС_Основания <> Неопределено Тогда
				ДополнительныеСвойства.Вставить("ГруппаДКС", ГруппаДКС_Основания);
			КонецЕсли;
			//ДИТ Шевченко А.В. 17.01.2024 US 91366 TA 93137 -начало
			Если ТранзитДляКлиента_Основания <> Неопределено Тогда
				ДополнительныеСвойства.Вставить("ТранзитДляКлиента", ТранзитДляКлиента_Основания);
			КонецЕсли;
			//ДИТ Шевченко А.В. 17.01.2024 US 91366 TA 93137 -конец
		КонецЕсли;
		//Евросиб(ДИТ), Беляев СЮ, US 90649 / TA 95187, 20-11-2024, конец
	КонецЕсли;
	УчетныеЕдиницы.Свернуть("УчетнаяЕдиница, ИдентификаторСтрокиУслуг");
КонецПроцедуры

