//Евросиб(ДИТ), Беляев СЮ, US 98449 / TA 98451, 20-12-2024, начало
Процедура ЗаписатьСчет_в_РТУ()
	
	НоменклатураПервойСтроки = Неопределено;
	Если ЭтотОбъект.Товары.Количество() > 0 Тогда
		 НоменклатураПервойСтроки= ЭтотОбъект.Товары[0].Номенклатура;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДокументыОснования.Документ КАК Документ,
		|	ДокументыОснования.Сделка КАК Сделка,
		|	ДокументыОснования.УдалитьОтнесеннаяНаДокументСуммаСНДС КАК УдалитьОтнесеннаяНаДокументСуммаСНДС
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ДокументыОснования КАК ДокументыОснования
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Документ КАК РТУ,
		|	ВТ.Сделка КАК Сделка,
		|	ВТ.УдалитьОтнесеннаяНаДокументСуммаСНДС КАК УдалитьОтнесеннаяНаДокументСуммаСНДС
		|ИЗ
		|	ВТ КАК ВТ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.СчетаНаОплатуПокупателям КАК РеализацияТоваровУслугСчетаНаОплатуПокупателям
		|		ПО ВТ.Документ = РеализацияТоваровУслугСчетаНаОплатуПокупателям.Ссылка
		|			И (РеализацияТоваровУслугСчетаНаОплатуПокупателям.СчетПокупателю = &Ссылка)
		|ГДЕ
		|	ВТ.Документ ССЫЛКА Документ.РеализацияТоваровУслуг
		|	И РеализацияТоваровУслугСчетаНаОплатуПокупателям.Ссылка ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("ДокументыОснования", ЭтотОбъект.ДокументыОснования.Выгрузить());
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		РТУОбъект = ВыборкаДетальныеЗаписи.РТУ.ПолучитьОбъект();
		НоваяСтрокаСчетаНаОплатуПокупателям = РТУОбъект.СчетаНаОплатуПокупателям.Добавить();
		НоваяСтрокаСчетаНаОплатуПокупателям.СчетПокупателю = Ссылка;
		НоваяСтрокаСчетаНаОплатуПокупателям.Номенклатура = НоменклатураПервойСтроки;
		//Евросиб Каблов 28.11.2025 ( #111016
		//НоваяСтрокаСчетаНаОплатуПокупателям.Сделка = ВыборкаДетальныеЗаписи.Сделка;
		//Евросиб Каблов 28.11.2025 ) #111016
		НоваяСтрокаСчетаНаОплатуПокупателям.Сумма = ВыборкаДетальныеЗаписи.УдалитьОтнесеннаяНаДокументСуммаСНДС;
		
		РежимЗаписи = РежимЗаписиДокумента.Запись;
		Если РТУОбъект.Проведен Тогда
			РежимЗаписи = РежимЗаписиДокумента.Проведение;
		КонецЕсли;
		
		Попытка
			РТУОбъект.Записать(РежимЗаписи);
		Исключение
			ОбщегоНазначения.СообщитьПользователю(""+ОписаниеОшибки());
		КонецПопытки;
		
	КонецЦикла;
	
	
КонецПроцедуры

