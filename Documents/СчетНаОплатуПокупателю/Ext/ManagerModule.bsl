Функция ПолучитьТаблицуСведенийСчетаНаОплату(ДокументСчетНаОплату) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаСведений = ПечатьБухгалтерскихДокументов.ПолучитьОписаниеСчетаНаОплату();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документ", ДокументСчетНаОплату);
	
	Запрос.Текст = ПолучитьТекстЗапросаДляФормированияТаблицыСведенийСчетаНаОплату();
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	//Евросиб(ДИТ) Антонова А.С. US 103646 ТА 105495 25.03.2025 Сдвиг нумерации. Было 1, 2
	Выборка = РезультатЗапроса[РезультатЗапроса.Количество() - 3].Выбрать();
	СтрокиДокументов = РезультатЗапроса[РезультатЗапроса.Количество() - 2].Выгрузить();
	СтрокиДокументов.Индексы.Добавить("Документ");
	//Евросиб Каблов 02.06.2022 ( Task 45436
	УчетныеЕдиницы = РезультатЗапроса[РезультатЗапроса.Количество() - 1].Выгрузить();
	УчетныеЕдиницы.Индексы.Добавить("Документ");
	//Евросиб Каблов 02.06.2022 )
	
	
	Пока Выборка.Следующий() Цикл
		
		СведенияОДокументе = ТаблицаСведений.Добавить();
		ЗаполнитьЗначенияСвойств(СведенияОДокументе, Выборка);
		//Евросиб - АСуслов 13.09.2022 11:18:26 #
		//(
		ФакторингСервер.ЗаполнитьПараметрыФакторинга(СведенияОДокументе);
		//)
		//Евросиб - АСуслов 13.09.2022 11:18:26 #     
		
		//ДИТ Шевченко А.В. US 103646 TA 103658 06.03.2025
		ЗаполнитьПСЦДляОснования(СведенияОДокументе.Документ,Ложь,СведенияОДокументе.ПСЦДляОснования);
		//ДИТ Шевченко А.В. US 103646 TA 103658 06.03.2025
		
		СведенияОДокументе.ЗаРуководителяНаОснованииНаименование = Выборка.ЗаРуководителяНаОсновании;
		СведенияОДокументе.ЗаГлавногоБухгалтераНаОснованииНаименование = Выборка.ЗаГлавногоБухгалтераНаОсновании;
		СведенияОДокументе.ЗаРуководителяНаОсновании = Выборка.ДоверенностьЗаРуководителя;
		СведенияОДокументе.ЗаГлавногоБухгалтераНаОсновании = Выборка.ДоверенностьЗаГлБухгалтера;
		
		ТаблицаДокумента = ПечатьБухгалтерскихДокументов.ПолучитьОписаниеТаблицыСчетаНаОплату();
		
		Отбор = Новый Структура("Документ", Выборка.Документ);
		СтрокиДокумента = СтрокиДокументов.НайтиСтроки(Отбор);
		
		Для Каждого Строка Из СтрокиДокумента Цикл
			
			СтрокаТаблицыДокумента = ТаблицаДокумента.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицыДокумента, Строка);
			СтрокаТаблицыДокумента.НоменклатураНаименование  = ?(ЗначениеЗаполнено(Строка.Содержание),Строка.Содержание,Строка.Номенклатура.НаименованиеПолное);
		КонецЦикла;
		
		СведенияОДокументе.ТаблицаДокумента = ТаблицаДокумента;
		
		//Евросиб Каблов 02.06.2022 ( Task 45436
		ТаблицаУчетныхЕдиниц = УчетныеЕдиницы.СкопироватьКолонки();
		СтрокиДокумента = УчетныеЕдиницы.НайтиСтроки(Отбор);
		
		Для Каждого Строка Из СтрокиДокумента Цикл
			СтрокаТаблицыДокумента = ТаблицаУчетныхЕдиниц.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицыДокумента, Строка);
		КонецЦикла;
		
		СведенияОДокументе.ТаблицаУчетныхЕдиниц = ТаблицаУчетныхЕдиниц;
		//Евросиб Каблов 02.06.2022 )
		
		//ПорядокЗаполнения = Новый Структура("ЗаполнятьРуководителя, ЗаполнятьГлавногоБухгалтера");
		////ПечатьТорговыхДокументов.ЗаполнитьДанныеОтветственныхЛиц(СведенияОДокументе, ПорядокЗаполнения);
		//
		//Если НЕ ЗначениеЗаполнено(СведенияОДокументе.РуководительДолжностьНаименование) Тогда
		//	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СведенияОДокументе.Получатель, "ЮридическоеФизическоеЛицо")
		//		= Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо Тогда
		//		СведенияОДокументе.РуководительДолжностьНаименование = "Индивидуальный предприниматель";
		//	КонецЕсли;
		//КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаСведений;
	
КонецФункции    

Процедура ЗаполнитьПСЦДляОснования(Документ,Англ = Ложь,ПСЦДляОснования) //ДИТ Шевченко А.В. US 103646 TA 103658 06.03.2025
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СчетНаОплатуПокупателюДокументыОснования.Документ КАК Документ,
		|	ЗаявкаСоставУслуги.ПСЦ КАК ПСЦ,
		|	ЗаявкаСоставУслуги.Ссылка.ПСЦ.НомерПСЦ КАК ПСЦНомерПСЦ,
		|	ЗаявкаСоставУслуги.Ссылка.ПСЦ.ДатаПСЦ КАК ПСЦДатаПСЦ
		|ИЗ
		|	Документ.СчетНаОплатуПокупателю.ДокументыОснования КАК СчетНаОплатуПокупателюДокументыОснования
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
		|		ПО СчетНаОплатуПокупателюДокументыОснования.Документ = ЗаявкаСоставУслуги.Ссылка
		|ГДЕ
		|	СчетНаОплатуПокупателюДокументыОснования.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Документ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	МассивПСЦ = Новый Массив;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если Англ Тогда
			МассивПСЦ.Добавить("Appendix " + (ВыборкаДетальныеЗаписи.ПСЦНомерПСЦ) +" dated "+ (Формат(ВыборкаДетальныеЗаписи.ПСЦДатаПСЦ,"ДФ=dd.MM.yyyy")));
		Иначе	
			МассивПСЦ.Добавить(ВыборкаДетальныеЗаписи.ПСЦ);
		КонецЕсли;
	КонецЦикла;
	
	ПСЦДляОснования = СтрСоединить(МассивПСЦ,",");
	
КонецПроцедуры	

