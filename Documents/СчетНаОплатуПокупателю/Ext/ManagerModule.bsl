				"CREDIT NOTE " + 
				Док.НомерДляПечати + 
				" date " + 
				Формат(Док.ДатаДокумента, "ДФ=dd.MM.yyyy") +
				" "; 
			РеквизитыОснований = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Док.СчетНаОплатуCreditNote, "НомерДляПечати, ДатаДокумента");
			ОбластьШапка.Параметры.НомерСчета = РеквизитыОснований.НомерДляПечати;
			ОбластьШапка.Параметры.ДатаСчета = Формат(РеквизитыОснований.ДатаДокумента, "ДФ=dd.MM.yyyy");
		КонецЕсли;
		//ДИТ Давудов М.А. Task32744 03.07.2021 Конец
//Евросиб ( Литвинов 21.01.2021 #30025
		//ОбластьШапка.Параметры.НаименованиеОрганизацииАнгл = Док.Организация.НаименованиеПолноеАнгл;
		//ДИТ Шевченко А.В. US 103646 TA 103658 06.03.2025
