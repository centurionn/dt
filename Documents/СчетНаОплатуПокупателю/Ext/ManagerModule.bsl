			ОбластьПодписи.Параметры.ФИОРуководительАнгл 	= НашРуководитель.ФИОАнгл;
			ОбластьПодписи.Параметры.ФИОБухгалтерАнгл 		= СтруктураГлБух.ФИОАнгл;
			ОбластьПодписи.Параметры.ДоверенностьБухАнгл 	= СтруктураГлБух.ОснованиеАнгл;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗаполнятьНаименованияПоВалюте Тогда
		ОбластьПодписи.Параметры.ФИОРуководительКит 	= НашРуководитель.ФИОВал;
		Если СтарыйФормат Тогда
			ОбластьПодписи.Параметры.ФИОБухгалтерКит 		= СтруктураГлБух.ФИОВал;
			ОбластьПодписи.Параметры.ДоверенностьБухКит		= СтруктураГлБух.ОснованиеВал;
		КонецЕсли;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(Док.ДоверенностьЗаРуководителя.ФайлФаксимиль) Тогда
		ДанныеКартинкиПодпись = РаботаСФайлами.ДанныеФайла(Док.ДоверенностьЗаРуководителя.ФайлФаксимиль);
		ДвоичныеДанныеПодпись = ПолучитьИзВременногоХранилища(ДанныеКартинкиПодпись.СсылкаНаДвоичныеДанныеФайла);
		Если ЗначениеЗаполнено(ДвоичныеДанныеПодпись) Тогда
			Если СтарыйФормат Тогда
				ОбластьПодписи.Рисунки.ПодписьРуководителя.Картинка = Новый Картинка(ДвоичныеДанныеПодпись);
			Иначе
				ОбластьПодписи.Рисунки.ПодписьРуководителя1.Картинка = Новый Картинка(ДвоичныеДанныеПодпись);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(Док.ДоверенностьЗаРуководителя.ФайлПечать) тогда
		ДанныеКартинкиПечать = РаботаСФайлами.ДанныеФайла(Док.ДоверенностьЗаРуководителя.ФайлПечать);
		ДвоичныеДанныеПечать = ПолучитьИзВременногоХранилища(ДанныеКартинкиПечать.СсылкаНаДвоичныеДанныеФайла);
		Если ЗначениеЗаполнено(ДвоичныеДанныеПечать) Тогда
			Если СтарыйФормат Тогда
				ОбластьПодписи.Рисунки.Печать.Картинка = Новый Картинка(ДвоичныеДанныеПечать);
			Иначе
				ОбластьПодписи.Рисунки.Печать1.Картинка = Новый Картинка(ДвоичныеДанныеПечать);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли; 
	Если ЗначениеЗаполнено(СтруктураГлБух.Факсимиль) Тогда
		ДанныеКартинкиПодпись = РаботаСФайлами.ДанныеФайла(СтруктураГлБух.Факсимиль);
		ДвоичныеДанныеПодпись = ПолучитьИзВременногоХранилища(ДанныеКартинкиПодпись.СсылкаНаДвоичныеДанныеФайла);
		Если ЗначениеЗаполнено(ДвоичныеДанныеПодпись) Тогда
			Если СтарыйФормат Тогда
				ОбластьПодписи.Рисунки.ПодписьБухгалтера.Картинка = Новый Картинка(ДвоичныеДанныеПодпись);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//ДИТ Шевченко А.В. US 103646 TA 103658 06.03.2025
	
	//Евросиб(ДИТ) Антонова А.С. US 103645 ТА 105974 Начало 31.03.2025
	Если не Результат.ПроверитьВывод(ОбластьПодписи) Тогда
		Результат.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	//Евросиб(ДИТ) Антонова А.С. US 103645 ТА 105974 Конец 31.03.2025
	
	Результат.Вывести(ОбластьПодписи); 
	
	//Евросиб(ДИТ) Антонова А.С. US 103645 ТА 107208 Начало 14.04.2025
	Результат.НижнийКолонтитул.ТекстСправа = "Страница [&НомерСтраницы] из [&СтраницВсего]";
    Результат.НижнийКолонтитул.Выводить = Истина;         
	
	НомерСчета = Док.НомерДляПечати;   
	ДатаСоставления = Формат(Док.ДатаДокумента,"ДФ=d.MM.yyyy");
	Если ФорматРасчета = Перечисления.ФорматПротокола.ПротоколОдноязычныйКомпл Тогда
		ТекстКолонтитулаСверху = СтрШаблон("Расчет %1 %2 от %3/ %3 %4",
									"премии", НомерСчета, ДатаСоставления, "酬金的结算"); 
	ИначеЕсли ФорматРасчета = Перечисления.ФорматПротокола.ПротоколОдноязычныйУниверсальный Тогда
		ТекстКолонтитулаСверху = СтрШаблон("Расчет %1 %2 от %3",
									"премии", НомерСчета, ДатаСоставления);
	Иначе  
		ПремииАнгл = "bonus calculation";
		ТекстКолонтитулаСверху = СтрШаблон("Расчет %1 %2 от %3/ %4 %2 of %3",
									"премии", НомерСчета, ДатаСоставления, "bonus calculation");
	КонецЕсли;
	Результат.ВерхнийКолонтитул.ТекстСлева = ТекстКолонтитулаСверху;
    Результат.ВерхнийКолонтитул.Выводить = Истина;
	//Евросиб(ДИТ) Антонова А.С. US 103645 ТА 107208 Конец 14.04.2025
	
	///////////////////// ПРИКРЕПЛЕНИЕ ВЛОЖЕННОГО ФАЙЛА /////////////////////
	СтруктураВозврата.ПФ = Результат;   
	
	ИмяФайлаПФ = "Расчет премии по счету №" + СтрЗаменить(Док.Номер, "/", "-") + ?(ЗаполнятьАнглийскиеНаименования, " (двуязычный англ)", "")
						+ ?(ФорматРасчета = Перечисления.ФорматПротокола.ПротоколОдноязычныйКомпл, " (двуязычный китайский)", ""); 
	ИмяФайла = КаталогВременныхФайлов() + ИмяФайлаПФ + ".DOCX";

	Результат.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.DOCX); 
	ПрисоединенныйФайл = РаботаСФайлами.ДобавитьФайлСДиска(Док.Ссылка, ИмяФайла);  
	
	Попытка
		УдалитьФайлы(КаталогВременныхФайлов(), ИмяФайлаПФ + ".DOCX");
	Исключение
	КонецПопытки;

	СтруктураВозврата.Результат = Истина;
	
	Возврат СтруктураВозврата;

КонецФункции  

