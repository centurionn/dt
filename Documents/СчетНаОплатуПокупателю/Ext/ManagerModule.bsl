//Евросиб Каблов 15.10.2025 #111016
Функция ПолучитьСвязанныеДокументы(Счет, УзелОбмена = Неопределено) Экспорт
	
	ДопПакет = "";
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПоступлениеНаРасчетныйСчетРазнесениеНаСчетаПокупателям.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПоступлениеНаРасчетныйСчет.РазнесениеНаСчетаПокупателям КАК ПоступлениеНаРасчетныйСчетРазнесениеНаСчетаПокупателям
	|ГДЕ
	|	ПоступлениеНаРасчетныйСчетРазнесениеНаСчетаПокупателям.Ссылка.Проведен
	|	И ПоступлениеНаРасчетныйСчетРазнесениеНаСчетаПокупателям.СчетПокупателю = &Счет
	|;
	|/////////////////////////////////////////////////////////////
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КорректировкаДолгаРасшифровкаДебиторскойЗадолженности.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КорректировкаДолга.РасшифровкаДебиторскойЗадолженности КАК КорректировкаДолгаРасшифровкаДебиторскойЗадолженности
	|ГДЕ
	|	КорректировкаДолгаРасшифровкаДебиторскойЗадолженности.ДокументРасшифровки = &Счет
	|	И КорректировкаДолгаРасшифровкаДебиторскойЗадолженности.Ссылка.Проведен
	|";
		
	Если НЕ УзелОбмена  = Неопределено Тогда		
		Запрос.Текст = Запрос.Текст + 
		"
		|;
		|/////////////////////////////////////////////////////////////
		|";
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	ПротоколОбменов.Объект КАК Объект
		|ИЗ
		|	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
		|ГДЕ
		|	ПротоколОбменов.Объект = &Счет
		|	И ПротоколОбменов.УзелОбмена = &УзелОбмена";
		
		Запрос.УстановитьПараметр("УзелОбмена",УзелОбмена);// Перечисления.УзлыОбмена.РИТМ);
	КонецЕсли;
	Запрос.УстановитьПараметр("Счет", Счет);
	
	Результаты = Запрос.ВыполнитьПакет();
	
	ПоступленияНаРС = Результаты[0].Выгрузить().ВыгрузитьКолонку("Ссылка");
	КорректировкиДолга = Результаты[1].Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ЕстьЗаписьВПротоколеОбменов = Ложь;
	Если Результаты.Количество() > 2 Тогда
		ЕстьЗаписьВПротоколеОбменов = Не Результаты[2].Пустой();
	КонецЕсли;
		
		
	СвязанныеДокументы = Новый Структура;
	СвязанныеДокументы.Вставить("ПоступленияНаРасчетныйСчет", ПоступленияНаРС);
	СвязанныеДокументы.Вставить("КорректировкиДолга", КорректировкиДолга);
	СвязанныеДокументы.Вставить("ЕстьЗаписьВПротоколеОбменов", ЕстьЗаписьВПротоколеОбменов);
	
	Возврат СвязанныеДокументы;
	
КонецФункции

