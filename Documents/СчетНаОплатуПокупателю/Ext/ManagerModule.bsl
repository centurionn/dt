Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода,Знач СтруктураПодписантов = Неопределено) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетЗаказ") Тогда
		Если ПараметрыПечати.Свойство("ФормированиеИзДиадок") Тогда
			СтруктураПодписантов = Новый Структура("БезФаксимиле", Истина);
		КонецЕсли; 
		СформироватьПечатнуюФорму(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, "СчетЗаказ", "Счет покупателю", ОбъектыПечати, ПараметрыВывода,СтруктураПодписантов);		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетНаОплатуАнгл") Тогда
		//Евросиб Каблов 03.09.2020 (
		//Для каждого ЭлМассива из МассивОбъектов Цикл		
		//Евросиб Каблов 03.09.2020 )
		
		//Евросиб Каблов 28.03.2022 ( Ticket#0266241
		//УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "СчетНаОплатуАнгл", "INVOICE", НапечататьСчетНаОплатуАнгл(МассивОбъектов, ОбъектыПечати),,"Документы.СчетНаОплатуПокупателю.ПФ_MXL_СчетИнЯз");
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "СчетНаОплатуАнгл", "INVOICE", НапечататьСчетНаОплатуАнгл(МассивОбъектов, ОбъектыПечати, СтруктураПодписантов),,"Документы.СчетНаОплатуПокупателю.ПФ_MXL_СчетИнЯз");
		//Евросиб Каблов 28.03.2022 )
		
		//Евросиб Каблов 03.09.2020 (
		//КонецЦикла;
		//Евросиб Каблов 03.09.2020 )		
	//Евросиб(ДИТ), Беляев СЮ, US 85562/TA 85564, 13-06-2024, начало	
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СчетНаОплатуАнглВРублях") Тогда
		ТабличныйДокумент = НапечататьСчетНаОплатуАнгл(МассивОбъектов, ОбъектыПечати, СтруктураПодписантов, "СчетНаОплатуАнглВРублях");
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "СчетНаОплатуАнглВРублях", "INVOICE", ТабличныйДокумент,,"Документы.СчетНаОплатуПокупателю.ПФ_MXL_СчетИнЯз");
	//Евросиб(ДИТ), Беляев СЮ, US 85562/TA 85564, 13-06-2024, конец
	КонецЕсли;
	
КонецПроцедуры

