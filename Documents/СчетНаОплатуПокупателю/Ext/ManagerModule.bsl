																					РеквизитыБанкаДополнительные.Код,
															   						РеквизитыБанка.СВИФТБИК);
			
			//ОбластьШапка.Параметры.Банк + СтрШаблон(", BIC %1, cor.acc %2", РеквизитыБанкаДополнительные.Код, РеквизитыБанкаДополнительные.КоррСчет);
