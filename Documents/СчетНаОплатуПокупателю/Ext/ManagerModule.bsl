&НаСервере
Процедура ОтвязатьПоступления(МассивПоступлений, Счет) Экспорт
	
	Для каждого Поступление из МассивПоступлений Цикл 
		ОбПоступление = Поступление.ПолучитьОбъект();			
		СтруктураПоиска = Новый Структура("СчетПокупателю", Счет);
		НайденныеСтроки = ОбПоступление.РазнесениеНаСчетаПокупателям.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() >0 тогда
			ОбПоступление.ВыполненаПопыткаРазнесения = Ложь;
			Для Каждого Строка из НайденныеСтроки Цикл
				ОбПоступление.РазнесениеНаСчетаПокупателям.Удалить(Строка);
			КонецЦикла;
		КонецЕсли;
		ОбПоступление.Записать(РежимЗаписиДокумента.Проведение); 
	КонецЦикла;
	ОбщегоНазначения.СообщитьПользователю("Поступления на расчетный счет отвязаны.");
	
КонецПроцедуры     
	

