Функция ПолучитьТекстОснования(Объект) Экспорт
	ШаблонТекстОснования = "%НомерДоговора% от %ДатаДоговора%";
	Если ЗначениеЗаполнено(Объект.ПравилоФормирования) Тогда
		ШаблонТекстОснованияИзПравила = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ПравилоФормирования, "ШаблонТекстаОснованияВСчете");
		Если ЗначениеЗаполнено(ШаблонТекстОснованияИзПравила) Тогда
			ШаблонТекстОснования = ШаблонТекстОснованияИзПравила;
		КонецЕсли;
	КонецЕсли;
	РеквизитыДляПолучения = Новый Массив;
	Если СтрНайти(ШаблонТекстОснования, "%НомерДоговора%") Тогда
		РеквизитыДляПолучения.Добавить("Номер");
	КонецЕсли;
	Если СтрНайти(ШаблонТекстОснования, "%ДатаДоговора%") Тогда
		РеквизитыДляПолучения.Добавить("Дата");
	КонецЕсли;                                         
	Если ЗначениеЗаполнено(РеквизитыДляПолучения) Тогда
		РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ДоговорКонтрагента, РеквизитыДляПолучения);
	КонецЕсли;         
	Если РеквизитыДляПолучения.Найти("Номер") <> Неопределено Тогда
		ШаблонТекстОснования = СтрЗаменить(ШаблонТекстОснования, "%НомерДоговора%", РеквизитыДоговора.Номер);
	КонецЕсли;
	Если РеквизитыДляПолучения.Найти("Дата") <> Неопределено Тогда
		ШаблонТекстОснования = СтрЗаменить(ШаблонТекстОснования, "%ДатаДоговора%", Формат(РеквизитыДоговора.Дата, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	Возврат ШаблонТекстОснования;
КонецФункции
