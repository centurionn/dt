															   РеквизитыБанка.СВИФТБИК,
															   КоррСчет);
// Евросиб Гудкова) 		

		//Евросиб(ДИТ), Беляев СЮ, US 85562/TA 85564, 13-06-2024, начало
		Если ИдентификаторКомандыПечати = "СчетНаОплатуАнглВРублях" Тогда
