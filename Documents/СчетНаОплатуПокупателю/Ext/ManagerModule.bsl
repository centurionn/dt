Функция ПолучитьОписаниеДляСодержанияПремии(ДокументЗаявкаОснование, Калькуляция, Английский = Ложь) Экспорт
	
	Ответ = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПРЕДСТАВЛЕНИЕ(ЗаявкаСоставУслуги.ПСЦ) КАК ПСЦ,
		|	ПРЕДСТАВЛЕНИЕ(ЗаявкаСоставУслуги.Калькуляция.Суша_ПунктОтправления) КАК КалькуляцияСуша_ПунктОтправления,
		|	ПРЕДСТАВЛЕНИЕ(ЗаявкаСоставУслуги.Калькуляция.Суша_ПунктНазначения) КАК КалькуляцияСуша_ПунктНазначения,
		|	ВЫРАЗИТЬ(ЗаявкаСоставУслуги.Калькуляция.Суша_ПунктОтправления КАК Справочник.Локации).НаименованиеАнгл КАК ПунктОтправленияАнгл,
		|	ВЫРАЗИТЬ(ЗаявкаСоставУслуги.Калькуляция.Суша_ПунктНазначения КАК Справочник.Локации).НаименованиеАнгл КАК ПунктНазначенияАнгл
		|ИЗ
		|	Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
		|ГДЕ
		|	ЗаявкаСоставУслуги.Ссылка = &Ссылка
		|	И ЗаявкаСоставУслуги.Калькуляция = &Калькуляция";

	Запрос.УстановитьПараметр("Ссылка", ДокументЗаявкаОснование);
	Запрос.УстановитьПараметр("Калькуляция", Калькуляция);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Если Английский Тогда
			//Premium for carriage within China according to the PAP ………….. on the route …………..
			МаршрутСтрока = ?(ЗначениеЗаполнено(Выборка.КалькуляцияСуша_ПунктОтправления) И ЗначениеЗаполнено(Выборка.КалькуляцияСуша_ПунктНазначения), 
									" on the route " + Выборка.ПунктОтправленияАнгл + " - " + Выборка.ПунктНазначенияАнгл, "");
			Ответ = " to the PAP " + Выборка.ПСЦ + МаршрутСтрока;
		Иначе
			МаршрутСтрока = ?(ЗначениеЗаполнено(Выборка.КалькуляцияСуша_ПунктОтправления) И ЗначениеЗаполнено(Выборка.КалькуляцияСуша_ПунктНазначения), 
									" по маршруту " + Выборка.КалькуляцияСуша_ПунктОтправления + " - " + Выборка.КалькуляцияСуша_ПунктНазначения, "");
			Ответ = " согласно " + Выборка.ПСЦ + МаршрутСтрока;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции
//Евросиб(ДИТ), Беляев СЮ, BUG 109491 / TA 111190, 02-06-2025, конец

//Евросиб(ДИТ), Беляев СЮ, BUG 109491 / TA 111190, 02-06-2025, начало
Функция ПолучитьЗаявкуСчета(СчетСсылка)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СчетНаОплатуПокупателюДокументыОснования.Документ КАК Документ
		|ИЗ
		|	Документ.СчетНаОплатуПокупателю.ДокументыОснования КАК СчетНаОплатуПокупателюДокументыОснования
		|ГДЕ
		|	СчетНаОплатуПокупателюДокументыОснования.Ссылка = &СчетСсылка
		|	И СчетНаОплатуПокупателюДокументыОснования.Документ ССЫЛКА Документ.Заявка";
	
	Запрос.УстановитьПараметр("СчетСсылка", СчетСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		Результат = ВыборкаДетальныеЗаписи.Документ
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
//Евросиб(ДИТ), Беляев СЮ, BUG 109491 / TA 111190, 02-06-2025, конец

