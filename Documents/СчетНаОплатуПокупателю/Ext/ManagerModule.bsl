			|			ТОГДА ИСТИНА
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ КАК ЭтоСчетПоПремиямСубсидиям
			|ИЗ
			|	Документ.СчетНаОплатуПокупателю.ДокументыОснования КАК СчетНаОплатуПокупателюДокументыОснования
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Заявка КАК Заявка
			|		ПО СчетНаОплатуПокупателюДокументыОснования.Документ = Заявка.Ссылка
			|ГДЕ
			|	СчетНаОплатуПокупателюДокументыОснования.Ссылка = &Ссылка";
			Запрос.УстановитьПараметр("Ссылка", Док.Ссылка);	
			РезультатЗапроса = Запрос.Выполнить();
			
			Выборка = РезультатЗапроса.Выбрать();
			
			Выборка.Следующий();
			ЭтоСчетПоПремииСубсидии = Выборка.ЭтоСчетПоПремиямСубсидиям;
		КонецЕсли;
		СтарыйФормат = (Док.Выставлен И НачалоДня(Док.Создано) <= ДатаВнедренияНовыхФорматов) или не ЭтоСчетПоПремииСубсидии;//НачалоДня(ТекущаяДата());
