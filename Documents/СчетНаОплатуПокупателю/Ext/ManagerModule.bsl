Функция ПолучитьXMLСчетаДМ(СчетНаОплату) Экспорт
	
	РезультатыЗапроса = ПолучитьСтруктуруЗначенийДляВыгрузкиСчетаДМ(СчетНаОплату);
	КоличествоРезультатов = РезультатыЗапроса.Количество();
	ШапкаСчета = РезультатыЗапроса[КоличествоРезультатов - 2].Выбрать();
	МассивОшибок = Новый Массив;
	ЕстьОшибки = Ложь;

	ЕстьДанныеШапки = ШапкаСчета.Следующий();
	Если НЕ ЕстьДанныеШапки Тогда
		МассивОшибок.Добавить("Не удалось сформировать шапку документа при формировании XML счета");
		ЕстьОшибки = Истина;
		СтруктураРезультата = Новый Структура("ЕстьОшибки, МассивОшибок, АдресХранилища", ЕстьОшибки, МассивОшибок, Неопределено);
		Возврат СтруктураРезультата;
	КонецЕсли;
	НаименованиеДляRAIL_ALL = Константы.НаименованиеДляRail_ALL.Получить();
	
	ТаблицаТоварыСчета = РезультатыЗапроса[КоличествоРезультатов - 1].Выгрузить();
	
	Запись = Новый ЗаписьXML();
	ИмяВременногоФайлаXML = ПолучитьИмяВременногоФайла("xml");
	Запись.ОткрытьФайл(ИмяВременногоФайлаXML);
	ПакетСчетаДМ = ФабрикаXDTO.Пакеты.Получить("urn:sap_bill_foreign");
	СвойствоСчет = ПакетСчетаДМ.КорневыеСвойства.Получить("СчетНаОплату"); 
	ОбъектСчет = ФабрикаXDTO.Создать(СвойствоСчет.Тип);
	ОбъектСчет.НомерСчета = ШапкаСчета.НомерДляПечати;
	ОбъектСчет.ДатаСчета = ШапкаСчета.ДатаДокумента;  
	//орг
	ОбъектСчетОрганизация = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("urn:sap_bill_foreign","УчастникТип"));
	НаименованияНаДату = Справочники.Организации.НаименованияНаДату(ШапкаСчета.Организация, ШапкаСчета.ДатаДокумента);
	ОбъектСчетОрганизация.ИНН = ШапкаСчета.ОрганизацияИНН;
	//ОбъектСчетОрганизация.КПП = ШапкаСчета.ОрганизацияКПП;
	ОбъектСчетОрганизация.КПП = НаименованияНаДату.КПП;
	ОбъектСчетОрганизация.НаимОрг = ШапкаСчета.ОрганизацияНаименование;
	ОбъектСчет.Поставщик = ОбъектСчетОрганизация;
	//контрагент
	ОбъектСчетКонтрагент = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("urn:sap_bill_foreign","УчастникТип"));
	ОбъектСчетКонтрагент.ИНН = ШапкаСчета.КонтрагентИНН;
	ОбъектСчетКонтрагент.КПП = ШапкаСчета.КонтрагентКПП;
	ОбъектСчетКонтрагент.НаимОрг = ШапкаСчета.КонтрагентНаименование;
	ОбъектСчет.Получатель = ОбъектСчетКонтрагент;
	//договор
	ОбъектСчетДоговор = ФабрикаXDTO.Создать(ОбъектСчет.Свойства().Получить("Договор").Тип);
	ОбъектСчетДоговор.НомерДоговора = ШапкаСчета.ДоговорКонтрагентаНомер;
	ОбъектСчетДоговор.ДатаДоговора = ШапкаСчета.ДоговорКонтрагентаДата;
	ОбъектСчет.Договор = ОбъектСчетДоговор;
	//валюта
	ОбъектСчетВалюта = ФабрикаXDTO.Создать(ОбъектСчет.Свойства().Получить("Валюта").Тип);
	ОбъектСчетВалюта.КодОКВ = ШапкаСчета.ВалютаДокументаКод;
	ОбъектСчетВалюта.НаимОКВ = ШапкаСчета.ВалютаДокументаНаименование;
	ОбъектСчет.Валюта = ОбъектСчетВалюта;
	//код лота                                     
	Если Не ЗначениеЗаполнено(ШапкаСчета.УчетнаяЕдиница) Тогда
		МассивОшибок.Добавить("Не заполнена учетная единица на вкладке «Учетные единицы»");
		ЕстьОшибки = Истина;
	Иначе
		ОбъектСчет.КодЛота = ШапкаСчета.УчетнаяЕдиница;
	КонецЕсли;
	//табличная часть счета
	ОбъектСчетТабличнаяЧасть = ФабрикаXDTO.Создать(ОбъектСчет.Свойства().Получить("ТаблСчета").Тип);
	Для каждого СтрокаТоварыСчета Из ТаблицаТоварыСчета Цикл
		
		ОбъектСчетТабличнаяЧастьСтрока = ФабрикаXDTO.Создать(ОбъектСчетТабличнаяЧасть.Строка.ВладеющееСвойство.Тип);
		Если НЕ ЗначениеЗаполнено(СтрокаТоварыСчета.ПунктОтправления) Тогда
			МассивОшибок.Добавить(СтрШаблон("В строке %1 не заполнен пункт отправления", СтрокаТоварыСчета.Поз));
			ЕстьОшибки = Истина;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаТоварыСчета.ПунктНазначения) Тогда
			МассивОшибок.Добавить(СтрШаблон("В строке %1 не заполнен пункт назначения", СтрокаТоварыСчета.Поз));
			ЕстьОшибки = Истина;
		КонецЕсли;
		Если СтрокаТоварыСчета.КодУслуги = "" Тогда
			МассивОшибок.Добавить(СтрШаблон("Не настроено соответствие номенклатуры ДК: «%1» коду ДМ", СтрокаТоварыСчета.Номенклатура));
			ЕстьОшибки = Истина;
		КонецЕсли;
		Если СтрокаТоварыСчета.НаименованиеУслуги = "" Тогда
			МассивОшибок.Добавить(СтрШаблон("Не настроено соответствие номенклатуры ДК: «%1» наименованию ДМ", СтрокаТоварыСчета.Номенклатура));
			ЕстьОшибки = Истина;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТоварыСчета.ПунктОтправления) И СтрокаТоварыСчета.КодТочкиОтпр = "" Тогда
			МассивОшибок.Добавить(СтрШаблон("Не настроено соответствие локации ДК: «%1» локации ДМ", СтрокаТоварыСчета.ПунктОтправления));
			ЕстьОшибки = Истина;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТоварыСчета.ПунктНазначения) И СтрокаТоварыСчета.КодТочкиПолуч = "" Тогда
			МассивОшибок.Добавить(СтрШаблон("Не настроено соответствие локации ДК: «%1» локации ДМ", СтрокаТоварыСчета.ПунктНазначения));
			ЕстьОшибки = Истина;
		КонецЕсли;
		ОбъектСчетТабличнаяЧастьСтрока.Поз = СтрокаТоварыСчета.Поз;
		Если СтрокаТоварыСчета.КодУслуги = "RAIL" И СтрокаТоварыСчета.ЕстьRAIL_ALL Тогда
			ОбъектСчетТабличнаяЧастьСтрока.КодУслуги = "RAIL_ALL";
			Если НЕ ЗначениеЗаполнено(НаименованиеДляRAIL_ALL) Тогда
				МассивОшибок.Добавить("Не настроено наименование для RAIL_ALL");
				ЕстьОшибки = Истина;
            КонецЕсли;
			ОбъектСчетТабличнаяЧастьСтрока.Наименование = НаименованиеДляRAIL_ALL;
		Иначе	
			ОбъектСчетТабличнаяЧастьСтрока.КодУслуги = СтрокаТоварыСчета.КодУслуги;
			ОбъектСчетТабличнаяЧастьСтрока.Наименование = СтрокаТоварыСчета.НаименованиеУслуги;
		КонецЕсли;
		ОбъектСчетТабличнаяЧастьСтрока.КодТочкиОтпр = СтрокаТоварыСчета.КодТочкиОтпр;
		ОбъектСчетТабличнаяЧастьСтрока.КодТочкиПолуч = СтрокаТоварыСчета.КодТочкиПолуч;
		ОбъектСчетТабличнаяЧастьСтрока.ЦенаБезНДС = СтрокаТоварыСчета.ЦенаБезНДС;
		ОбъектСчетТабличнаяЧастьСтрока.Количество = СтрокаТоварыСчета.Количество; 
		Если СтрокаТоварыСчета.СтавкаНДС = Неопределено Тогда
			//Евросиб СубботинВ #125845 09.12.2025 Начало
			//МассивОшибок.Добавить(СтрШаблон("В строке %1 указана некорректная ставка НДС. Доступные варианты %2.", СтрокаТоварыСчета.Поз, "0%, 10%, 20%, Без НДС"));
			МассивОшибок.Добавить(СтрШаблон("В строке %1 указана некорректная ставка НДС. Доступные варианты %2.", СтрокаТоварыСчета.Поз, "0%, 10%, 20%, 22%, Без НДС"));
            //Евросиб СубботинВ #125845 09.12.2025 Конец
			ЕстьОшибки = Истина;
		Иначе
			ОбъектСчетТабличнаяЧастьСтрока.СтавкаНДС = СтрокаТоварыСчета.СтавкаНДС;
		КонецЕсли;
		ОбъектСчетТабличнаяЧастьСтрока.СуммаБезНДС = СтрокаТоварыСчета.СуммаБезНДС;
		ОбъектСчетТабличнаяЧастьСтрока.СуммаНДС = СтрокаТоварыСчета.СуммаНДС;
		ОбъектСчетТабличнаяЧастьСтрока.СуммаСНДС = СтрокаТоварыСчета.СуммаСНДС;
		ОбъектСчетТабличнаяЧасть.Строка.Добавить(ОбъектСчетТабличнаяЧастьСтрока);
		
	КонецЦикла;
	ОбъектСчет.ТаблСчета = ОбъектСчетТабличнаяЧасть;
	
	Если ЕстьОшибки = Ложь Тогда
		ОбъектСчет.Проверить();
	КонецЕсли;
	ФабрикаXDTO.ЗаписатьXML(Запись, ОбъектСчет, "СчетНаОплату", "urn:sap_bill_foreign");
	Запись.Закрыть();
	Файл = Новый ДвоичныеДанные(ИмяВременногоФайлаXML);
	АдресХранилища = ПоместитьВоВременноеХранилище(Файл);
	МассивОшибок = Взаимодействия.УдалитьПовторяющиесяЭлементыМассива(МассивОшибок);
	СтруктураРезультата = Новый Структура("ЕстьОшибки, МассивОшибок, АдресХранилища", ЕстьОшибки, МассивОшибок, АдресХранилища);
	Возврат СтруктураРезультата;
		
КонецФункции

