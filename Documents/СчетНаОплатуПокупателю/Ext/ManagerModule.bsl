Функция ПолучитьОписаниеДляСодержанияКитай(ДокументЗаявкаОснование)
	
	Ответ = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗаявкаСоставУслуги.ПСЦ КАК ПСЦ,
		|	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.ПунктОтправления КАК ПунктОтправления,
		|	КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.ПунктНазначения КАК ПунктНазначения,
		|	ЗаявкаСоставУслуги.ПСЦ.ДатаПСЦ КАК ПСЦДатаПСЦ,
		|	ЗаявкаСоставУслуги.ПСЦ.НомерПСЦ КАК ПСЦНомерПСЦ
		|ИЗ
		|	Документ.Заявка.СоставУслуги КАК ЗаявкаСоставУслуги
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Калькуляция.ММ_КалькуляцияМультимодальнойЦепочки КАК КалькуляцияММ_КалькуляцияМультимодальнойЦепочки
		|		ПО ЗаявкаСоставУслуги.Калькуляция = КалькуляцияММ_КалькуляцияМультимодальнойЦепочки.Ссылка
		|ГДЕ
		|	ЗаявкаСоставУслуги.Ссылка = &Ссылка
		|ИТОГИ ПО
		|	ПСЦ";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументЗаявкаОснование);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаПСЦ = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	МассивПСЦ = Новый Массив;
	
	Текст = "";
	
	Пока ВыборкаПСЦ.Следующий() Цикл
		
		Текст = "根据  " + Строка(Год(ВыборкаПСЦ.ПСЦДатаПСЦ)) + " 年 " +  Строка(Месяц(ВыборкаПСЦ.ПСЦДатаПСЦ)) + " 月 " + Строка(День(ВыборкаПСЦ.ПСЦДатаПСЦ)) + " 日第 " + "中国境内运费返还";
	
		ВыборкаДетальныеЗаписи = ВыборкаПСЦ.Выбрать();
		
		МассивМаршрутов = Новый Массив;
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПунктОтправления) и ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПунктНазначения) Тогда
			
				МассивМаршрутов.Добавить(" 路线 " +Строка(ВыборкаДетальныеЗаписи.ПунктОтправления.НаименованиеКИТ) + " - " + Строка(ВыборкаДетальныеЗаписи.ПунктНазначения.НаименованиеКИТ));
			
			КонецЕсли;
				
		КонецЦикла;
		
		Текст = Текст + " " + СтрСоединить(МассивМаршрутов,",");
		
		МассивПСЦ.Добавить(Текст);
		
	КонецЦикла;	
	
	Если МассивПСЦ.Количество() Тогда
		Ответ = СтрСоединить(МассивПСЦ,";");                         
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции
