			КоррСчет = ",c/bank:" + РеквизитыКоррБанка.МеждународноеНаименование + ",SWIFT:" + РеквизитыКоррБанка.СВИФТБИК;
		КонецЕсли; 
		ОбластьШапка.Параметры.НомерСчетаОрганизации = РеквизитыСчета.НомерСчета;
