		// ДИТ 56017 Давудов М.А. Начало: 13.07.2023
		//ок(
		//Если ЗначениеЗаполнено(Док.Организация.ФайлЛоготип) Тогда
		//	ДанныеКартинкиЛоготип = РаботаСФайлами.ДанныеФайла(Док.Организация.ФайлЛоготип);
