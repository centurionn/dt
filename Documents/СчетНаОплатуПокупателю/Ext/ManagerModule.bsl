&НаСервере
Функция ПроверитьИзмененияКлючевыхРеквизитов(Объект) Экспорт

	ИзмененияКлюченвыхРеквизитов = 
	Объект.Контрагент <> Объект.Ссылка.Контрагент
	или Объект.ДоговорКонтрагента <> Объект.Ссылка.ДоговорКонтрагента	
	или Объект.Товары.Итог("Сумма") <>  Объект.Ссылка.Товары.Итог("Сумма")
	или	Объект.Товары.Итог("СуммаНДС") <>  Объект.Ссылка.Товары.Итог("СуммаНДС");	 
	
	// ДИТ US 57674 ТА 79279 Сержантова А.С. Начало: 27.03.2024 - если есть задача на удаление счета, то считаем, что было изменение ключевых реквизитов
	ЗадачаПоУдалению = Объект.Состояния.НайтиСтроки(Новый Структура("Состояние", Справочники.Состояния.УдалениеСчета));
	Если ЗадачаПоУдалению.Количество() и ЗадачаПоУдалению[0].Статус <> Перечисления.СтатусыЭтапов.Выполнен Тогда
		ИзмененияКлюченвыхРеквизитов = Истина;	
	КонецЕсли;
	// ДИТ US 57674 ТА 79279 Сержантова А.С. Конец: 27.03.2024
	
	//Евросиб Каблов 15.10.2025 ( #111016
	//Возврат ИзмененияКлюченвыхРеквизитов
	
	Если ИзмененияКлюченвыхРеквизитов Тогда
		ИзмененияКлючевыхРеквизитовДляКД = Истина;
	Иначе
		ТаблицаТоварыТекущая = Объект.Товары.Выгрузить(, "Номенклатура, Сумма, СуммаНДС");
		ТаблицаТоварыПредыдущая = Объект.Ссылка.Товары.Выгрузить(, "Номенклатура, Сумма, СуммаНДС");	
		ИзмененияКлючевыхРеквизитовДляКД = Не ОбщегоНазначения.КоллекцииИдентичны(ТаблицаТоварыПредыдущая, ТаблицаТоварыТекущая);
	КонецЕсли;
	
	РезультатПроверки = Новый Структура;
	РезультатПроверки.Вставить("ИзмененыКлючевыеРеквизитыДляПоступленияНаРасчетныйСчет", ИзмененияКлюченвыхРеквизитов);
	РезультатПроверки.Вставить("ИзмененыКлючевыеРеквизитыДляКорректировкиДолга", ИзмененияКлючевыхРеквизитовДляКД);
	
	Возврат РезультатПроверки;
	//Евросиб Каблов 15.10.2025 ) #111016
	
КонецФункции

