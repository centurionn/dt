&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("ОтборПоКонтрагенту") Тогда
		Список.Параметры.УстановитьЗначениеПараметра("ОтборПоКонтрагенту", Истина);
		Список.Параметры.УстановитьЗначениеПараметра("Контрагент", Параметры.ОтборПоКонтрагенту);
	Иначе
		Список.Параметры.УстановитьЗначениеПараметра("ОтборПоКонтрагенту", Ложь);
		Список.Параметры.УстановитьЗначениеПараметра("Контрагент", неопределено);
	КонецЕсли; 
	
	//Евросиб СубботинВ #126100 26.12.2025 Начало // Убрал проверку
	// Шейко О.Е. 27.10.2020 Ограничить отображение документов датой платежа:
	//Если Параметры.Свойство("ДатаПлатежки") Тогда 		
	//	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ДатаДокумента", Параметры.ДатаПлатежки, ВидСравненияКомпоновкиДанных.МеньшеИлиРавно,, Истина, , "ДатаДокумента");		
	//КонецЕсли;
	//Евросиб СубботинВ #126100 26.12.2025 Конец
	
	//ДИТ, Беляев СЮ, BUG48279, 05-04-2022, начало
	КонтрольДоступностиДокументов_сервер.ОбработатьБлокировкуЭлементовФормыСписка(Элементы);
	//ДИТ, Беляев СЮ, BUG48279, 05-04-2022, конец

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )	
		
	//Субботин 79718 /15.01.2024 Начало
	Если Параметры.Свойство("КонтрольОстатка") Тогда
		Список.Параметры.УстановитьЗначениеПараметра("КонтрольОстатка", Истина);
		Элементы.НеразнесеннаяСуммаОстаток.Видимость = Истина;
	Иначе
		Список.Параметры.УстановитьЗначениеПараметра("КонтрольОстатка", Ложь);
	КонецЕсли;	
	//Субботин 79718 /15.01.2024 конец 	
КонецПроцедуры

