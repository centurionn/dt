&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	ВыделенныеСтр = Элементы.Список.ВыделенныеСтроки;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		
		МассивДокументов = СозданиеТаблицыДокументов(ВыделенныеСтр,ВыбранноеЗначение);
		
	Иначе
		МассивДокументов = СозданиеТаблицыДокументов(ВыделенныеСтр,Неопределено);
		
	КонецЕсли;
	
	ПараметрКоманды = Новый Массив;
	Для Каждого Элем Из ВыделенныеСтр Цикл
		ПараметрКоманды.Добавить(Элем);
	КонецЦикла;
		
	ПечатьКомплектаДокументов.НапечататьКомплект(МассивДокументов,ПараметрКоманды);

КонецПроцедуры


&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	Попытка //++ Зубов 0243138 14.09.2021 Добавили попытку из-за непонятного исчезновения Ставки НДС 
		Запрос=Новый Запрос;
		Запрос.Текст= "ВЫБРАТЬ
		              |	СчетНаОплатуПокупателюТовары.СтавкаНДС КАК СтавкаНДС,
		              |	СчетНаОплатуПокупателюТовары.Ссылка КАК Ссылка
		              |ИЗ
		              |	Документ.СчетНаОплатуПокупателю.Товары КАК СчетНаОплатуПокупателюТовары
		              |ГДЕ
		              |	СчетНаОплатуПокупателюТовары.Ссылка В(&Ссылка)
		              |
		              |ОБЪЕДИНИТЬ ВСЕ
		              |
		              |ВЫБРАТЬ
		              |	СчетНаОплатуПокупателюУслуги.СтавкаНДС,
		              |	СчетНаОплатуПокупателюУслуги.Ссылка
		              |ИЗ
		              |	Документ.СчетНаОплатуПокупателю.Услуги КАК СчетНаОплатуПокупателюУслуги
		              |ГДЕ
		              |	СчетНаОплатуПокупателюУслуги.Ссылка В(&Ссылка)" ;
		Запрос.УстановитьПараметр("Ссылка",Строки.ПолучитьКлючи());
		Результат=Запрос.Выполнить().Выгрузить();
		СтавкаНДС="";
		Для каждого Строка из Результат Цикл
			СтавкаНДС=Строка.СтавкаНДС;
			СтрокаСписка= Строки[Строка.Ссылка];
			СтрокаСписка.Данные.СтавкаНДС=СтавкаНДС;
		КонецЦикла;
	Исключение
	КонецПопытки; //-- Зубов 0243138 14.09.2021 Добавили попытку из-за непонятного исчезновения Ставки НДС

КонецПроцедуры


