&НаСервере
Функция ВыгрузитьXMLНаСервере()
	СтруктураРезультат = Документы.СчетНаОплатуПокупателю.ПолучитьXMLСчетаДМ(Объект.Ссылка);
	Если СтруктураРезультат.ЕстьОшибки Тогда
		Для каждого ТекстОшибки Из СтруктураРезультат.МассивОшибок Цикл
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		КонецЦикла;
	КонецЕсли;
    Возврат СтруктураРезультат;
КонецФункции

&НаКлиенте
Процедура ВыгрузитьXML(Команда)
	СтруктураРезультат = ВыгрузитьXMLНаСервере();
	Если СтруктураРезультат.ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;
	АдресХранилища = СтруктураРезультат.АдресХранилища;
	Если ЭтоАдресВременногоХранилища(АдресХранилища) Тогда
		ПараметрыДиалога = Новый ПараметрыДиалогаПолученияФайлов;
		ПараметрыДиалога.Заголовок = НСтр("ru = 'Выберите путь для сохранения файла'; en = 'Select the path to save the file'");
		
		НачатьПолучениеФайлаССервера(АдресХранилища, СтрШаблон("Счет %1.xml", СтрЗаменить(Объект.НомерДляПечати,"/","_")), ПараметрыДиалога);
	КонецЕсли;
КонецПроцедуры 

