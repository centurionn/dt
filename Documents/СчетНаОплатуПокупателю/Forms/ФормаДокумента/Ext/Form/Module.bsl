&НаСервере
Функция ПолучитьГруппуДКСдокументаОснования()
	Результат = Неопределено;
	
	Если Объект.ДокументыОснования.Количество()>0 Тогда
		ДокументПервойСтроки = Объект.ДокументыОснования[0].Документ;
		Если ТипЗнч(ДокументПервойСтроки) = Тип("ДокументСсылка.Заявка") Тогда
			Результат = РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ПолучитьГруппуДКСпоДокументу(ДокументПервойСтроки);
		ИначеЕсли ТипЗнч(ДокументПервойСтроки) = Тип("ДокументСсылка.РелизСобственника") Тогда
			Результат = Справочники.ГруппыДКС.ДМС;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции
