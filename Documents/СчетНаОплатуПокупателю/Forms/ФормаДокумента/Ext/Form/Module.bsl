					Отказ = истина;
					Возврат 
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;	
		//Евросиб Каблов 15.10.2025 ) #111016
		
	КонецЕсли;
	// Субботин 79718 17.01.2024 Конец 
		
		
