&НаСервере
Функция ВыполнитьПроверкуГруппыДКППользователя()
	
	ГруппаП = Справочники.ГруппыПользователей.ПустаяСсылка();
	
	Если ГруппаДКС = Справочники.ГруппыДКС.ДМС Тогда
		ГруппаП = Справочники.ГруппыПользователей.ДКПДМС;
	ИначеЕсли ГруппаДКС = Справочники.ГруппыДКС.ДПРК Тогда	
		ГруппаП = Справочники.ГруппыПользователей.ДКПДПРК;
	Иначе
		ГруппаП = Справочники.ГруппыПользователей.ДКПДКС;
	КонецЕсли;
	
	Возврат Пользователи_sd_сервер.ГруппаВключаетПользователя(ГруппаП,Пользователи.ТекущийПользователь());
	
КонецФункции	

