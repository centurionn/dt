&НаСервере
Процедура ЗаполнитьДинамическиеПоляТаблицыТовары()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РасчетСНП.НомерКТК КАК НомерКТК,
	|	РасчетСНП.Услуга КАК Услуга
	|ИЗ
	|	Документ.РасчетСНП КАК РасчетСНП
	|ГДЕ
	|	РасчетСНП.Счет = &Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПСЦ.Ссылка КАК Ссылка,
	|	ПСЦ.РазрешенПересчетСтавкиУслугиВСчетНДС22 КАК РазрешенПересчетСтавкиУслугиВСчетНДС22
	|ИЗ
	|	Документ.ПСЦ КАК ПСЦ
	|ГДЕ
	|	ПСЦ.Ссылка В(&Протоколы)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Калькуляция.Ссылка КАК Ссылка,
	|	Калькуляция.СтавкаНДС КАК СтавкаНДС
	|ИЗ
	|	Документ.Калькуляция КАК Калькуляция
	|ГДЕ
	|	Калькуляция.Ссылка В(&Калькуляции)";
	
	Запрос.УстановитьПараметр("Счет", Объект.Ссылка);		
		
	ТаблицаДанныхТЧ = Объект.Товары.Выгрузить(, "ПСЦ, Калькуляция");
	Запрос.УстановитьПараметр("Протоколы", ТаблицаДанныхТЧ.ВыгрузитьКолонку("ПСЦ"));
	Запрос.УстановитьПараметр("Калькуляции", ТаблицаДанныхТЧ.ВыгрузитьКолонку("Калькуляция"));
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	ТаблицаКТК_СНП = РезультатыЗапроса[0].Выгрузить();
	ТаблицаКТК_СНП.Индексы.Добавить("НомерКТК, Услуга");
	ТаблицаПротоколов = РезультатыЗапроса[1].Выгрузить();
	ТаблицаПротоколов.Индексы.Добавить("Ссылка");
	ТаблицаКалькуляций = РезультатыЗапроса[2].Выгрузить();
	ТаблицаКалькуляций.Индексы.Добавить("Ссылка");
	
	ТипКонтейнер = Тип("СправочникСсылка.ТЕ");
	
	Для Каждого СтрТоваров Из Объект.Товары Цикл
		
		СтрокиУчетныхЕдиниц = Объект.УчетныеЕдиницы.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", СтрТоваров.Идентификатор));
		Для Каждого СтрУчетныхЕдиниц Из СтрокиУчетныхЕдиниц Цикл
			Если ТипЗнч(СтрУчетныхЕдиниц.УчетнаяЕдиница) = ТипКонтейнер И ЗначениеЗаполнено(СтрУчетныхЕдиниц.УчетнаяЕдиница) Тогда
				НайденныеСтрокиСНП = ТаблицаКТК_СНП.НайтиСтроки(Новый Структура("НомерКТК, Услуга", СтрУчетныхЕдиниц.УчетнаяЕдиница, СтрТоваров.Номенклатура));
				Если ЗначениеЗаполнено(НайденныеСтрокиСНП) Тогда
					СтрТоваров.ЗапрещеноИзменение = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		НайденнаяСтрока = ТаблицаПротоколов.Найти(СтрТоваров.ПСЦ, "Ссылка");
		Если НайденнаяСтрока <> Неопределено Тогда
			СтрТоваров.РазрешенПересчетСтавкиУслугиВСчетНДС22 = НайденнаяСтрока.РазрешенПересчетСтавкиУслугиВСчетНДС22;
		Иначе
			СтрТоваров.РазрешенПересчетСтавкиУслугиВСчетНДС22 = Ложь;
		КонецЕсли;
		НайденнаяСтрока = ТаблицаКалькуляций.Найти(СтрТоваров.Калькуляция, "Ссылка");
		Если НайденнаяСтрока <> Неопределено Тогда
			СтрТоваров.СтавкаНДСвКалькуляции = НайденнаяСтрока.СтавкаНДС;
		Иначе
			СтрТоваров.СтавкаНДСвКалькуляции = Неопределено;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

