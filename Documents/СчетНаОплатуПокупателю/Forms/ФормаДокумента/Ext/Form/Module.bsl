		//			Возврат 
		//		КонецЕсли;
		//	КонецЕсли;
		//КонецЕсли;
		
		ВыполняетсяОтменаПроведения = (ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения);
		ИзмененияКлючевыхРеквизитов = ПроверитьИзмененияКлючевыхРеквизитов();
		Если ВыполняетсяОтменаПроведения
			Или ИзмененияКлючевыхРеквизитов.ИзмененыКлючевыеРеквизитыДляПоступленияНаРасчетныйСчет
			Или ИзмененияКлючевыхРеквизитов.ИзмененыКлючевыеРеквизитыДляКорректировкиДолга Тогда
			
			СвязанныеДокументы = ПолучитьСвязанныеДокументы();
			
			Если ВыполняетсяОтменаПроведения Тогда
				ТекстСообщения = СтрШаблон("Отмена проведения %1 невозможна. Привязаны следующие документы:", Объект.Ссылка);
			Иначе
				ТекстСообщения = СтрШаблон("Редактирование %1 невозможно. Привязаны следующие документы:", Объект.Ссылка);
			КонецЕсли;
			
			ПроверитьКорректировкиДолга = ВыполняетсяОтменаПроведения Или ИзмененияКлючевыхРеквизитов.ИзмененыКлючевыеРеквизитыДляКорректировкиДолга; 
			Если ПроверитьКорректировкиДолга И ЗначениеЗаполнено(СвязанныеДокументы.КорректировкиДолга) Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения ,,,, Отказ);
				Для Каждого ПривязанныйДок Из СвязанныеДокументы.КорректировкиДолга Цикл
