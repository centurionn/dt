&НаКлиенте
Процедура ДокументыОснованияДокументОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)       
	//ДИТ Шевченко А.В. 59985 12.12.2022 -начало
	Если ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.Заявка") Тогда
		СтруктураРек = ОбщегоНазначенияКлиент.ЗначенияРеквизитовОбъекта(ВыбранноеЗначение,"Договор,Отправка,Прибытие,Дата");
		Если ЗначениеЗаполнено(СтруктураРек.Договор) И ЗначениеЗаполнено(СтруктураРек.Отправка) и НЕ ЗначениеЗаполнено(СтруктураРек.Прибытие) Тогда
			ДоговорДействует = ПроверитьПериодДействияДоговора(СтруктураРек.Договор,СтруктураРек.Отправка,Дата(1,1,1),Истина);
		ИначеЕсли ЗначениеЗаполнено(СтруктураРек.Договор) И НЕ ЗначениеЗаполнено(СтруктураРек.Отправка) и ЗначениеЗаполнено(СтруктураРек.Прибытие) Тогда
			ДоговорДействует = ПроверитьПериодДействияДоговора(СтруктураРек.Договор,СтруктураРек.Прибытие,Дата(1,1,1),Истина);
		ИначеЕсли ЗначениеЗаполнено(СтруктураРек.Договор) И ЗначениеЗаполнено(СтруктураРек.Отправка) и ЗначениеЗаполнено(СтруктураРек.Прибытие) Тогда
			ДоговорДействует = ПроверитьПериодДействияДоговора(СтруктураРек.Договор,СтруктураРек.Отправка,СтруктураРек.Прибытие);	
		ИначеЕсли ЗначениеЗаполнено(СтруктураРек.Договор) И НЕ ЗначениеЗаполнено(СтруктураРек.Отправка) и НЕ ЗначениеЗаполнено(СтруктураРек.Прибытие) Тогда
			ДоговорДействует = ПроверитьПериодДействияДоговора(СтруктураРек.Договор,СтруктураРек.Дата,Дата(1,1,1),Истина);
		КонецЕсли;
		Если НЕ ДоговорДействует Тогда
			Автопролонгация = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(СтруктураРек.Договор,"Автопролонгация");
			Если Автопролонгация Тогда
				СообщениеТекст = "Заявка не добавлена. Договор в заявке не продлен на текущий год, необходимо продлить договор через отдел делопроизводства";
			Иначе
				СообщениеТекст = "Заявка не добавлена. Срок действия договора в заявке истек, необходимо оформить ДС на продления срока действия договора";
			КонецЕсли;
			ВызватьИсключение СообщениеТекст;
		КонецЕсли; 
		// ДИТ US 59973 ТА 71434 Сержантова А.С. Начало: 31.07.2023
		ПроверитьСубсидиюВЗаявке();
		// ДИТ US 59973 ТА 71434 Сержантова А.С. Конец: 31.07.2023
	КонецЕсли;
	//ДИТ Шевченко А.В. 59985 12.12.2022 -конец
КонецПроцедуры

