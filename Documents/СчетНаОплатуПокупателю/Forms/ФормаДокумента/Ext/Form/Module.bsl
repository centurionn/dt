&НаСервере
Функция ПроверитьНеобходимостьМаршрутизации()

	ДляДанногоОбъектаТребуетсяПеремаршрутизация = 
	НЕ ЗначениеЗаполнено(Объект.Ссылка) ИЛИ 
	Объект.Ссылка.Организация <> Объект.Организация ИЛИ 
	Объект.Ссылка.Контрагент <> Объект.Контрагент ИЛИ
	Объект.Ссылка.ДоговорКонтрагента <> Объект.ДоговорКонтрагента ИЛИ Объект.Состояния.Количество() = 0;
	
	Возврат ДляДанногоОбъектаТребуетсяПеремаршрутизация;
	
КонецФункции

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ДопСвойстваОбъекта", ДопСвойстваОбъекта);
	// Субботин 79718 17.01.2024 начало
	Если ПараметрыЗаписи.Свойство("ВопросЗадан") Тогда		
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ВопросЗадан", Истина);
	КонецЕсли;
	Если ПараметрыЗаписи.Свойство("МассивПоступленийДляОтвязки") Тогда		
		ТекущийОбъект.ДополнительныеСвойства.Вставить("МассивПоступленийДляОтвязки", ПараметрыЗаписи.МассивПоступленийДляОтвязки);
	КонецЕсли;
	// Субботин 79718 17.01.2024 Конец
	
	//Если Параметры.СохранитьДанныеСостояний Тогда
	//	ТЗ = Объект.Состояния.Выгрузить();
	//	ТекущийОбъект.ДополнительныеСвойства.Вставить("Состояния", ТЗ);
	//	Параметры.СохранитьДанныеСостояний = Ложь;
	//КонецЕсли;
	//++ Коробов Task 43981 28.12.2021
	Отказ = Документы.СчетНаОплатуПокупателю.НеЗаполненыОбязательныеПоля(ПараметрыЗаписи.РежимЗаписи, Объект);
	//-- Коробов Task 43981 28.12.2021
	
	//Евросиб(ДИТ), Беляев СЮ, US 90649 / TA 93760, 02-11-2024, начало
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ГруппаДКС", ГруппаДКС);
	//Евросиб(ДИТ), Беляев СЮ, US 90649 / TA 93760, 02-11-2024, конец
	
	//Евросиб Шевченко А.В. US 115011 TA 117858 18.09.2025
	Если ТекущийОбъект.РазрешитьУдаление Тогда
		мЗадачи = Новый Массив;
		мЗадачи.Добавить(Справочники.Состояния.ТребуетсяПометкаНаУдалениеСчета);
		МаршрутизацияСервер.ОтметитьВыполнениеЗадач(ТекущийОбъект, мЗадачи);
	КонецЕсли;
	//Евросиб Шевченко А.В. US 115011 TA 117858 18.09.2025	
КонецПроцедуры

