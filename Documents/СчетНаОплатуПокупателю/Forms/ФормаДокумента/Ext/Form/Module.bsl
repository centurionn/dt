	МассивПодстрок = СтрРазделить(Содержание, Документы.СчетНаОплатуПокупателю.СтрокаРазделителейУчетныхЕдиницВСодержанииУслуи());
	//Евросиб(ДИТ), Беляев СЮ, US 109628 / TA 112362, 18-06-2025, конец
	ЕстьКТК = Ложь;
	ЕстьВагон = Ложь;
	Для каждого Подстрока Из МассивПодстрок Цикл                       
		Если СтрДлина(Подстрока) >= 10  Тогда
			Если РаботаСКонтейнерамиСервер.КорректнаяМаска(Лев(Подстрока,4), Сред(Подстрока, 5, 6)) Тогда
				ЕстьКТК = Истина;
			КонецЕсли;
		ИначеЕсли СтрДлина(Подстрока) = 8 И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Подстрока) Тогда
			ЕстьВагон = Истина;
		КонецЕсли;
	КонецЦикла;  
	
	Если ЕстьВагон или ЕстьКТК Тогда   // в содержании уже есть вагоны или ктк
		Возврат МассивКТК;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СделкаСвязьУчетныхЕдиниц.Контейнер КАК Контейнер
	|ИЗ
	|	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	|ГДЕ
	|	СделкаСвязьУчетныхЕдиниц.Ссылка В(&Сделки)";
	
	Запрос.УстановитьПараметр("Сделки", Объект.ДокументыОснования.Выгрузить().ВыгрузитьКолонку("Сделка"));
	
	РезультатЗапроса = Запрос.Выполнить(); 
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат МассивКТК;
	КонецЕсли;    
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл  
		МассивКТК.Добавить(Выборка.Контейнер);		
	КонецЦикла;
	
	Возврат МассивКТК;	

КонецФункции 
	
&НаКЛиенте
Процедура ОбработатьИзменениеОписания(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = неопределено Тогда Возврат; КонецЕсли;
	
	текДанные = Элементы.Товары1.ТекущиеДанные;
	Если ЗначениеЗаполнено(текДанные.Идентификатор) Тогда
		СтруктураДанных = Новый Структура("Содержание, Идентификатор, Количество, ЕдиницаИзмерения");
		ЗаполнитьЗначенияСвойств(СтруктураДанных, текДанные);
		СтруктураДанных.Содержание = П1;
		СтруктураРезультата = ИзменитьСписокУчетныхЕдиниц(СтруктураДанных); 
	Иначе
		//считаем что данные корректны и ничего не проверяем
		СтруктураРезультата = Новый Структура("ДанныеКорректны", Истина);
	КонецЕсли;
	Если СтруктураРезультата.ДанныеКорректны = Ложь Тогда 
		СтруктураРезультата.Вставить("ТекстСодержания", П1);
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВопросаКорректноеСодержания", ЭтотОбъект, СтруктураРезультата);
		ПоказатьВопрос(ОписаниеОповещения, СтруктураРезультата.ТекстВопроса, РежимДиалогаВопрос.ДаНет, 60);
	Иначе
		Элементы.товары1.ТекущиеДанные.Содержание = П1;
	КонецЕсли;

	
КонецПроцедуры

