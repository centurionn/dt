
&НаКлиенте
Процедура УчитыватьНДСНажатие(Элемент)
	ОбъектА = ЭтотОбъект.Объект;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("УчитыватьНДС", ОбъектА.УчитыватьНДС);
	ПараметрыФормы.Вставить("СуммаВключаетНДС", ОбъектА.СуммаВключаетНДС);
	ОткрытьФорму("ОбщаяФорма.УчетНДСВДокументах",ПараметрыФормы,ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура КурсВалютыНажатие(Элемент)
	ОбъектА = ЭтотОбъект.Объект;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВалютаДокумента", ОбъектА.ВалютаДокумента);
	ПараметрыФормы.Вставить("КурсВзаиморасчетов", ОбъектА.КурсВзаиморасчетов);
	ПараметрыФормы.Вставить("КратностьВзаиморасчетов", ОбъектА.КратностьВзаиморасчетов);
	ПараметрыФормы.Вставить("ДатаДокумента", ОбъектА.ДатаКурса);

	Для каждого Стр из Объект.Товары Цикл
		
		Если ЗначениеЗаполнено(Стр.ИсходнаяВалюта) И Стр.ИсходнаяВалюта <> ПредопределенноеЗначение("Справочник.Валюты.Рубль") Тогда
			ПараметрыФормы.Вставить("АльтернативнаяВалютаДокумента", Стр.ИсходнаяВалюта);
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	ОткрытьФорму("ОбщаяФорма.КурсВалютыВДокументах",ПараметрыФормы,ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура РеквизитыПродавцаИПокупателяНажатие(Элемент)
	
	ОбъектА = ЭтотОбъект.Объект;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Грузоотправитель", ОбъектА.Грузоотправитель);
	ПараметрыФормы.Вставить("Грузополучатель", ОбъектА.Грузополучатель);
	ПараметрыФормы.Вставить("ГлавныйБухгалтер", ОбъектА.ГлавныйБухгалтер);
	ПараметрыФормы.Вставить("Руководитель", ОбъектА.Руководитель);
	ПараметрыФормы.Вставить("АдресДоставки", ОбъектА.АдресДоставки);
	ПараметрыФормы.Вставить("ЗаРуководителяНаОсновании", ОбъектА.ЗаРуководителяНаОсновании);
	ПараметрыФормы.Вставить("ЗаГлавногоБухгалтераНаОсновании", ОбъектА.ЗаГлавногоБухгалтераНаОсновании);
	ПараметрыФормы.Вставить("ДоверенностьЗаРуководителя", ОбъектА.ДоверенностьЗаРуководителя);
	ПараметрыФормы.Вставить("ДоверенностьЗаГлБухгалтера", ОбъектА.ДоверенностьЗаГлБухгалтера);
	ПараметрыФормы.Вставить("БезДоверенностей", ОбъектА.БезДоверенностей);

	ОткрытьФорму("Документ.СчетНаОплатуПокупателю.Форма.ФормаРеквизитыПродавцаИПокупателя",ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Документ.СчетНаОплатуПокупателю.Форма.ФормаРеквизитыПродавцаИПокупателя" Тогда
		ОбработкаВыбораРеквизитыПродавцаИПокупателя(ЭтаФорма,ВыбранноеЗначение,ИсточникВыбора);
	ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.УчетНДСВДокументах" Тогда
		ОбработкаВыбораУчетНДС(ЭтаФорма,ВыбранноеЗначение,ИсточникВыбора);
	ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.КурсВалютыВДокументах" Тогда
		ОбработкаВыбораКурсыВалют(ЭтаФорма,ВыбранноеЗначение,ИсточникВыбора);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораРеквизитыПродавцаИПокупателя(Форма, ВыбранноеЗначение, ИсточникВыбора)
	ЗаполнитьЗначенияСвойств(Объект, ВыбранноеЗначение);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораУчетНДС(Форма, ВыбранноеЗначение, ИсточникВыбора)
	
	//Евросиб Каблов 20.01.2026 ( #127936
	СтавкаНДС20 = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20");
	СтавкаНДС22 = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22");	
	//Евросиб Каблов 20.01.2026 ) #127936
	
	ЗаполнитьЗначенияСвойств(Объект, ВыбранноеЗначение);
	Для каждого Стр из Объект.Товары Цикл
		
		//Евросиб Каблов 20.01.2026 ( #127936
		Если Не (Объект.СуммаВключаетНДС И Стр.СтавкаНДСвКалькуляции = СтавкаНДС20 И Стр.СтавкаНДС = СтавкаНДС22) Тогда
			Если Стр.ПересчитатьСтавкуУслугиВСчетНДС22 Тогда
				Стр.ПересчитатьСтавкуУслугиВСчетНДС22 = Ложь;
				СуммаНДС20 = Окр(БухгалтерскийУчетОбщиеПроцедурыКлиент.ПолучитьСуммуНДС(Стр.Цена, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(СтавкаНДС20), Истина, Истина), 2);
				ЦенаБезНДС20 = Стр.Цена - СуммаНДС20;
				СуммаНДС22 = Окр(БухгалтерскийУчетОбщиеПроцедурыКлиент.ПолучитьСуммуНДС(ЦенаБезНДС20, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Стр.СтавкаНДС), Истина, Ложь), 2);
				Стр.Цена = ЦенаБезНДС20 + СуммаНДС22;
				Стр.ЦенаВВалюте = РаботаСКурсамиВалют.ПересчитатьВВалюту(Стр.Цена, Объект.ВалютаДокумента, Стр.ИсходнаяВалюта, Объект.ДатаКурса,, Истина);
			КонецЕсли;
		КонецЕсли;
		Стр.СтавкаНДСДоРедактирования = Стр.СтавкаНДС;
		//Евросиб Каблов 20.01.2026 ) #127936
	
		БухгалтерскийУчетОбщиеПроцедурыКлиент.ПересчитатьСуммыНДС(Стр,Объект.УчитыватьНДС,Объект.СуммаВключаетНДС);
		БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(Стр,Объект.СуммаВключаетНДС);
		//ДИТ Давудов М.А. Task32744 03.07.2021 Начало
		Стр.ЦенаCreditNote = Стр.Цена * (-1);
		Стр.СуммаCreditNote = Стр.Сумма * (-1);
		Стр.СуммаНДСCreditNote = Стр.СуммаНДС * (-1);
		Стр.ВсегоCreditNote = Стр.Всего * (-1);
		//ДИТ Давудов М.А. Task32744 03.07.2021 Конец
	КонецЦикла;
	
	//Для каждого Стр из Объект.Услуги Цикл
	//	БухгалтерскийУчетОбщиеПроцедурыКлиент.ПересчитатьСуммыНДС(Стр,Объект.УчитыватьНДС,Объект.СуммаВключаетНДС);
	//	БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(Стр,Объект.СуммаВключаетНДС);
	//КонецЦикла;
	РассчитатьСуммыВсегоПоДокументу();
//Евросиб Гудкова( 07.10.2020 Ticket№ 0209291
	Объект.СуммаДокумента = ИтогоВсего;
// Евросиб Гудкова) 	
	УстановитьВидимостьКолонокНДС();
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммыВсегоПоДокументу()
	
	ИтогоВсегоНДС = ?(Объект.Товары.Количество()>0, Объект.Товары.Итог("СуммаНДС"),0);//+?(Объект.Услуги.Количество()>0,Объект.Услуги.Итог("СуммаНДС"),0);
	ИтогоВсего = ?(Объект.Товары.Количество()>0, Объект.Товары.Итог("Сумма"),0)+?(Объект.СуммаВключаетНДС,0,ИтогоВсегоНДС);//+ ?(Объект.Услуги.Количество()>0,Объект.Услуги.Итог("Сумма"),0);
//Евросиб Гудкова( 07.10.2020 Ticket№ 0209291 не работает. ахаха
	//Если ДоступноРедактирование() Тогда
	//	Объект.СуммаДокумента = ИтогоВсего;
	//КонецЕсли;
// Евросиб Гудкова) 	

КонецПроцедуры

