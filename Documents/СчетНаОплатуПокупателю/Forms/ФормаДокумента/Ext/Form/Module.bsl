&НаСервереБезКонтекста
Функция ПолучитьЗначениеОкругленияКурсаИзПравил( ПравилоФормирования )
	Возврат Справочники.ФормированиеФинДокументов.ПолучитьЗначениеОкругленияКурсаИзПравил( ПравилоФормирования );
КонецФункции

&НаКлиенте
Процедура ОбработкаВыбораКурсыВалют(Форма, ВыбранноеЗначение, ИсточникВыбора)
	
	СтараяВалюта = Объект.ВалютаДокумента;
	СтарыйКурс = Объект.КурсВзаиморасчетов;
	СтараяКратность = Объект.КратностьВзаиморасчетов;
	
	Объект.ВалютаДокумента 				= ВыбранноеЗначение.ВалютаДокумента;
	Объект.КратностьВзаиморасчетов 		= ВыбранноеЗначение.КратностьВзаиморасчетов;
	Объект.КурсВзаиморасчетов 			= ВыбранноеЗначение.КурсВзаиморасчетов;
	Объект.ДатаКурса 					= ВыбранноеЗначение.ДатаДокумента;
	
	//ДИТ, Беляев СЮ, BUG 76518 / TA 76823, 03-11-2023, начало
	ОкруглениеКурса = ПолучитьЗначениеОкругленияКурсаИзПравил(Объект.ПравилоФормирования);
	//ДИТ, Беляев СЮ, BUG 76518 / TA 76823, 03-11-2023, конец
	
	Для каждого Стр из Объект.Товары Цикл
		
		//Стр.Цена = Валюта_сервер.ПересчитатьПоКурсу(Стр.ЦенаВВалюте, Стр.ИсходнаяВалюта, Объект.ВалютаДокумента, Объект.ДатаКурса);
		//ДИТ, Беляев СЮ, BUG 76518 / TA 76823, 03-11-2023, начало
		Стр.Цена = Валюта_сервер.ПересчитатьПоКурсу(Стр.ЦенаВВалюте, Стр.ИсходнаяВалюта, Объект.ВалютаДокумента, Объект.ДатаКурса, ОкруглениеКурса);
		//ДИТ, Беляев СЮ, BUG 76518 / TA 76823, 03-11-2023, конец
		КурсНаДату = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Стр.ИсходнаяВалюта, Объект.ДатаКурса);
		Товары1КоличествоПриИзменении(неопределено, Стр);
		
		// SIV 14-10-2020 Изменение курса в описании услуги при выборе соответствующей опции в меню
		НайденнаяПозицияКурсаВалюты = СтрНайти(Стр.Содержание, "(Курс");
		Если НайденнаяПозицияКурсаВалюты = 0 Тогда
			//Сообщить("Не удалось поменять курс валюты в строке описания услуги. Требуется отредактировать вручную.");
		Иначе
			Стр.Содержание = СтрЗаменить(Стр.Содержание, Сред(Стр.Содержание, НайденнаяПозицияКурсаВалюты+18, 7), КурсНаДату.Курс);
		КонецЕсли;
		
	КонецЦикла;
	
	Если СтараяВалюта <> Объект.ВалютаДокумента или СтарыйКурс <> Объект.КурсВзаиморасчетов Тогда
		СтруктураТекущая = Новый Структура;
		СтруктураТекущая.Вставить("Валюта",СтараяВалюта);
		СтруктураТекущая.Вставить("Курс",СтарыйКурс);
		СтруктураТекущая.Вставить("Кратность",СтараяКратность);
		СтруктураНовая = Новый Структура;
		СтруктураНовая.Вставить("Валюта",Объект.ВалютаДокумента);
		СтруктураНовая.Вставить("Курс",Объект.КурсВзаиморасчетов);
		СтруктураНовая.Вставить("Кратность",Объект.КратностьВзаиморасчетов);
		
		ПересчитатьСуммыДокументаПоВалютеВзаиморасчетов(СтруктураТекущая,СтруктураНовая);
		Для каждого Стр из Объект.Товары Цикл
			БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(Стр,Объект.СуммаВключаетНДС);
			//ДИТ Давудов М.А. Task32744 03.07.2021 Начало
			Стр.ЦенаCreditNote = Стр.Цена * (-1);
			Стр.СуммаCreditNote = Стр.Сумма * (-1);
			Стр.СуммаНДСCreditNote = Стр.СуммаНДС * (-1);
			Стр.ВсегоCreditNote = Стр.Всего * (-1);
			//ДИТ Давудов М.А. Task32744 03.07.2021 Конец

		КонецЦикла;
		РассчитатьСуммыВсегоПоДокументу();
//Евросиб Гудкова( 07.10.2020 Ticket№ 0209291
		Объект.СуммаДокумента = ИтогоВсего;
// Евросиб Гудкова) 	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Товары1КоличествоПриИзменении(Элемент, СтрТЧ = неопределено)
	
	Если СтрТЧ = неопределено Тогда
		СтрТЧ = Элементы.Товары1.ТекущиеДанные;
	КонецЕсли;
	
	БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуСтрокиТабличнойЧасти(СтрТЧ);
	БухгалтерскийУчетОбщиеПроцедурыКлиент.ПересчитатьСуммыНДС(СтрТЧ,Объект.УчитыватьНДС,Объект.СуммаВключаетНДС);
	БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(СтрТЧ,Объект.СуммаВключаетНДС);
	РассчитатьСуммыВсегоПоДокументу();
//Евросиб Гудкова( 07.10.2020 Ticket№ 0209291
	Объект.СуммаДокумента = ИтогоВсего;
// Евросиб Гудкова) 

	//ДИТ Давудов М.А. Task32744 03.07.2021 Начало
	СтрТЧ.ЦенаCreditNote = СтрТЧ.Цена * (-1);
	СтрТЧ.СуммаCreditNote = СтрТЧ.Сумма * (-1);
	СтрТЧ.СуммаНДСCreditNote = СтрТЧ.СуммаНДС * (-1);
	СтрТЧ.ВсегоCreditNote = СтрТЧ.Всего * (-1);
	//ДИТ Давудов М.А. Task32744 03.07.2021 Конец

КонецПроцедуры

&НаКлиенте
Процедура Товары1ЦенаПриИзменении(Элемент)
	СтрТабЧасти = Элементы.Товары1.ТекущиеДанные;
	
	БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуСтрокиТабличнойЧасти(СтрТабЧасти);
	БухгалтерскийУчетОбщиеПроцедурыКлиент.ПересчитатьСуммыНДС(СтрТабЧасти,Объект.УчитыватьНДС,Объект.СуммаВключаетНДС);	
	БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(СтрТабЧасти,Объект.СуммаВключаетНДС);
	РассчитатьСуммыВсегоПоДокументу();
//Евросиб Гудкова( 07.10.2020 Ticket№ 0209291
	Объект.СуммаДокумента = ИтогоВсего;
// Евросиб Гудкова) 

	//ДИТ Давудов М.А. Task32744 03.07.2021 Начало
	СтрТабЧасти.ЦенаCreditNote = СтрТабЧасти.Цена * (-1);
	СтрТабЧасти.СуммаCreditNote = СтрТабЧасти.Сумма * (-1);
	СтрТабЧасти.СуммаНДСCreditNote = СтрТабЧасти.СуммаНДС * (-1);
	СтрТабЧасти.ВсегоCreditNote = СтрТабЧасти.Всего * (-1);
	//ДИТ Давудов М.А. Task32744 03.07.2021 Конец
	
	//Евросиб Каблов 20.01.2026 ( #127936
	СтрТабЧасти.ЦенаВВалюте = РаботаСКурсамиВалют.ПересчитатьВВалюту(СтрТабЧасти.Цена, Объект.ВалютаДокумента, СтрТабЧасти.ИсходнаяВалюта, Объект.ДатаКурса,, Истина);
	//Евросиб Каблов 20.01.2026 ) #127936

КонецПроцедуры

&НаКлиенте
Процедура Товары1СтавкаНДСПриИзменении(Элемент)
	СтрТЧ = Элементы.Товары1.ТекущиеДанные;
	
	//Евросиб Каблов 20.01.2026 ( #127936
	СтавкаНДС20 = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20");
	СтавкаНДС22 = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22");
	
	Если Объект.СуммаВключаетНДС И СтрТЧ.СтавкаНДСДоРедактирования = СтавкаНДС20 И СтрТЧ.СтавкаНДС = СтавкаНДС22 Тогда
		
		СтрТЧ.ПересчитатьСтавкуУслугиВСчетНДС22 = СтрТЧ.РазрешенПересчетСтавкиУслугиВСчетНДС22;				
		
		Если Не СтрТЧ.ПересчитатьСтавкуУслугиВСчетНДС22 Тогда			
			СуммаНДС20 = Окр(БухгалтерскийУчетОбщиеПроцедурыКлиент.ПолучитьСуммуНДС(СтрТЧ.Цена, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(СтавкаНДС20), Истина, Объект.СуммаВключаетНДС), 2);
			ЦенаБезНДС20 = СтрТЧ.Цена - СуммаНДС20;
			СуммаНДС22 = Окр(БухгалтерскийУчетОбщиеПроцедурыКлиент.ПолучитьСуммуНДС(ЦенаБезНДС20, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(СтрТЧ.СтавкаНДС), Истина, Ложь), 2);
			СтрТЧ.Цена = ЦенаБезНДС20 + СуммаНДС22;
			СтрТЧ.ЦенаВВалюте = РаботаСКурсамиВалют.ПересчитатьВВалюту(СтрТЧ.Цена, Объект.ВалютаДокумента, СтрТЧ.ИсходнаяВалюта, Объект.ДатаКурса,, Истина);
		КонецЕсли;
		
	Иначе
		
		Если Объект.СуммаВключаетНДС И СтрТЧ.СтавкаНДС = СтавкаНДС20 И СтрТЧ.СтавкаНДСДоРедактирования = СтавкаНДС22 Тогда
			Если Не СтрТЧ.ПересчитатьСтавкуУслугиВСчетНДС22 Тогда
				СуммаНДС22 = Окр(БухгалтерскийУчетОбщиеПроцедурыКлиент.ПолучитьСуммуНДС(СтрТЧ.Цена, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(СтавкаНДС22), Истина, Объект.СуммаВключаетНДС), 2);
				ЦенаБезНДС22 = СтрТЧ.Цена - СуммаНДС22;
				СуммаНДС20 = Окр(БухгалтерскийУчетОбщиеПроцедурыКлиент.ПолучитьСуммуНДС(ЦенаБезНДС22, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(СтавкаНДС20), Истина, Ложь), 2);
				СтрТЧ.Цена = ЦенаБезНДС22 + СуммаНДС20;
				СтрТЧ.ЦенаВВалюте = РаботаСКурсамиВалют.ПересчитатьВВалюту(СтрТЧ.Цена, Объект.ВалютаДокумента, СтрТЧ.ИсходнаяВалюта, Объект.ДатаКурса,, Истина);
			КонецЕсли;
		КонецЕсли;
		
		СтрТЧ.ПересчитатьСтавкуУслугиВСчетНДС22 = Ложь;		
	КонецЕсли;
	СтрТЧ.СтавкаНДСДоРедактирования = СтрТЧ.СтавкаНДС;
	//Евросиб Каблов 20.01.2026 ) #127936
	
	БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуСтрокиТабличнойЧасти(СтрТЧ);
	СуммаНДС = БухгалтерскийУчетОбщиеПроцедурыКлиент.ПолучитьСуммуНДС(СтрТЧ.Сумма, БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(СТрТЧ.СтавкаНДС), Объект.УчитыватьНДС, Объект.СуммаВключаетНДС);
	СтрТч.СуммаНДС = СуммаНДС;
	БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(СтрТЧ,Объект.СуммаВключаетНДС);
	РассчитатьСуммыВсегоПоДокументу();
//Евросиб Гудкова( 07.10.2020 Ticket№ 0209291
	Объект.СуммаДокумента = ИтогоВсего;
// Евросиб Гудкова) 

	//ДИТ Давудов М.А. Task32744 03.07.2021 Начало
	СтрТЧ.СуммаНДСCreditNote = СтрТЧ.СуммаНДС * (-1);
	СтрТЧ.ВсегоCreditNote = СтрТЧ.Всего * (-1);
	//ДИТ Давудов М.А. Task32744 03.07.2021 Конец    

КонецПроцедуры

