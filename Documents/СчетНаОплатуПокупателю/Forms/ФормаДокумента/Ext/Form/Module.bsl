&НаСервере
Процедура ОбработатьБлокировкуДокумента()
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ДанныеОБлокировке = КонтрольДоступностиДокументов_сервер.ПолучитьДанныеОБлокировке(Объект.Ссылка);
		ТолькоПросмотр = ДанныеОБлокировке.Заблокирован;		
		Элементы.ПредупреждениеРедактирования.Видимость = ДанныеОБлокировке.Заблокирован;
		Элементы.ПредупреждениеРедактирования.Заголовок = ДанныеОБлокировке.ОписаниеБлокировки;
	Иначе
		Элементы.ПредупреждениеРедактирования.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьСчета(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) ИЛИ НЕ ЗначениеЗаполнено(Объект.Контрагент) ИЛИ ЭтаФорма.Модифицированность ИЛИ НЕ Объект.Проведен Тогда
		
		Сообщить("Перед печатью нужно провести счет!");
		Возврат;
		
	КонецЕсли;
	
	ОписаниеКоманды_Идентификатор = "СчетЗаказ";
	
	//Если НЕ КонтрагентыДоговоры_сервер.КонтрагентРезидент(Объект.Контрагент) Тогда
	Если ПолучитьРеквизитыНаСервере(Объект.ДоговорКонтрагента, "ВыставлятьСчетНаАнглийскомЯзыке").ВыставлятьСчетНаАнглийскомЯзыке = Истина Тогда
		ОписаниеКоманды_Идентификатор = "СчетНаОплатуАнгл";
	КонецЕсли;		
	
	ОписаниеКоманды_ОбъектыПечати = Новый Массив; ОписаниеКоманды_ОбъектыПечати.Добавить(Объект.Ссылка);
	
	УправлениеПечатьюКлиент.ВыполнитьКомандуПечати("Документ.СчетНаОплатуПокупателю", ОписаниеКоманды_Идентификатор, ОписаниеКоманды_ОбъектыПечати,
		ЭтаФорма, неопределено);
	
КонецПроцедуры

