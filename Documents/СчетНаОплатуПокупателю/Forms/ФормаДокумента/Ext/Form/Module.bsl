&НаСервере
Процедура ПроверитьСубсидиюВЗаявке()  
	
	МассивЗаявок = Объект.ДокументыОснования.Выгрузить().ВыгрузитьКолонку("Документ");

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Протокол.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Заявка КАК Заявка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПСЦ КАК Протокол
		|		ПО Заявка.ПСЦ = Протокол.Ссылка
		|ГДЕ
		//ДИТ Шевченко А.В. US 103646 TA 103658 10.03.2025
		//|	Протокол.ТипКалькуляции = ЗНАЧЕНИЕ(Перечисление.ТипыКалькуляций.Субсидии)
		|	Протокол.ТипКалькуляции В(&ТипыКалькуляций)
		//ДИТ Шевченко А.В. US 103646 TA 103658 10.03.2025
		|	И Заявка.Ссылка В(&ДокументыОснования)";
	//ДИТ Шевченко А.В. US 103646 TA 103658 10.03.2025
	ТипыКалькуляций = Новый Массив;
	ТипыКалькуляций.Добавить(Перечисления.ТипыКалькуляций.Субсидии);
	ТипыКалькуляций.Добавить(Перечисления.ТипыКалькуляций.Премии);
	Запрос.УстановитьПараметр("ТипыКалькуляций", ТипыКалькуляций);
	//ДИТ Шевченко А.В. US 103646 TA 103658 10.03.2025
	Запрос.УстановитьПараметр("ДокументыОснования", МассивЗаявок);
	
	Результат = Запрос.Выполнить();
	Если не Результат.Пустой() Тогда
		Элементы.ФормаПечатьРасчета.Видимость = Истина;
	Иначе
		Элементы.ФормаПечатьРасчета.Видимость = Ложь;	
	КонецЕсли; 
	
КонецПроцедуры 

