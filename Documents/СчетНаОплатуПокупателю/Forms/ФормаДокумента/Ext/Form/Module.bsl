&НаСервере
Процедура СогласоватьУдалениеНаСервере()
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Отказ = Ложь;
		Документы.СчетНаОплатуПокупателю.ПроверитьНаличиеПроведенныхРеализаций(Объект.Ссылка,Отказ);
		Документы.СчетНаОплатуПокупателю.ПроверитьНаличиеПроведенныхКорРту(Объект.Ссылка,Отказ); //Евросиб Шевченко А.В. US 112687 TA 120184 22.10.2025
		Если Отказ Тогда
			Возврат;
		КонецЕсли;	
		
		МаршрутизацияСервер.СформироватьЗадачуПометкаНаУдалениеСчета(Объект);
		
		об = РеквизитФормыВЗначение("Объект");
		об.ОбменДанными.Загрузка = Истина;
		об.СогласоватьУдаление = Истина;
		об.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ДоступностьКнопкиСогласованияНаУдаление()
	
	
	Если Документы.СчетНаОплатуПокупателю.ЭтоСчетИзРИТМ(Объект.Ссылка) Тогда
		Элементы.ФормаСогласоватьУдаление.Доступность = Ложь;
		Возврат;
	КонецЕсли;	
	
	НоменклатурДляПроверки = Новый Массив;
	
	Для Каждого Стр Из Объект.Товары Цикл
		НоменклатурДляПроверки.Добавить(Стр.Номенклатура);	
	КонецЦикла;	
	
	Если НЕ Документы.СчетНаОплатуПокупателю.ПроверитьНоменклатуруДляУдаленияСчета(НоменклатурДляПроверки) Тогда
		Элементы.ФормаСогласоватьУдаление.Доступность = Ложь;
		Возврат;
	КонецЕсли;	
	
	Элементы.ФормаСогласоватьУдаление.Доступность = Истина;
	
	Если Объект.Контрагент.СтранаРегистрации = Справочники.СтраныМира.Россия Тогда
		Элементы.ФормаСогласоватьУдаление.Доступность = Ложь;
		Возврат;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Элементы.ФормаСогласоватьУдаление.Доступность = Ложь;
		Возврат;
	КонецЕсли;	
	
	СтрокаСостояния = Объект.Состояния.НайтиСтроки(Новый Структура("Состояние", Справочники.Состояния.ТребуетсяПометкаНаУдалениеСчета));
	Если СтрокаСостояния.Количество() <> 0 Тогда
		НС = СтрокаСостояния[0];
		Если НС.Статус = Перечисления.СтатусыЭтапов.ВРаботе Тогда
			Элементы.ФормаСогласоватьУдаление.Доступность = Ложь;
			Возврат;
		КонецЕсли;	
	КонецЕсли;
	
	Если Объект.РазрешитьУдаление Тогда
		Элементы.ФормаСогласоватьУдаление.Доступность = Ложь;
		Возврат;
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Процедура ДоступностьРазрешитьУдаление()
	
	сПоиска = Новый Структура("Состояние",ПредопределенноеЗначение("Справочник.Состояния.ТребуетсяПометкаНаУдалениеСчета"));
	НайденныеСтроки = Объект.Состояния.НайтиСтроки(сПоиска);
	
	ЕстьЗадачаПользолвателя = НайденныеСтроки.Количество();
	
	Элементы.РазрешитьУдаление.Доступность = (Пользователи.РолиДоступны("dc_СогласованиеУдаленияСчетаПокупателю") И ЕстьЗадачаПользолвателя И НЕ Объект.Ссылка.ПометкаУдаления) ИЛИ Пользователи.РолиДоступны("ПолныеПрава");
	
КонецПроцедуры	

&НаКлиенте
Процедура СогласоватьУдаление(Команда)
	СогласоватьУдалениеНаСервере();
	Оповестить("ВыполненоУдалениеСчета");
	ОповеститьОбИзменении(Объект.Ссылка);
КонецПроцедуры

&НаСервере
Процедура РазрешитьУдалениеПриИзмененииНаСервере()
	
	Если Не РольДоступна("ПолныеПрава") Тогда //Евросиб Шевченко А.В. US 121605 TA 121622 14.10.2025
		Если НЕ ВыполнитьПроверкуГруппыДКППользователя() Тогда
			Объект.РазрешитьУдаление = НЕ Объект.РазрешитьУдаление;
		КонецЕсли;
	КонецЕсли;
	
	ДоступностьКнопкиСогласованияНаУдаление();	
КонецПроцедуры

