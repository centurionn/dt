&НаКлиенте
Процедура ПослеВопросаКорректноеСодержания(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Элементы.товары1.ТекущиеДанные.Содержание = ДополнительныеПараметры.ТекстСодержания;
		СтрокиКУдалению = Новый Массив;
		Для каждого СтрокаУЕ Из Объект.УчетныеЕдиницы Цикл
			Если СтрокаУЕ.ИдентификаторСтрокиУслуг = ДополнительныеПараметры.ИдентификаторСтрокиУслуг Тогда
				СтрокиКУдалению.Добавить(СтрокаУЕ);
			КонецЕсли;
		КонецЦикла;	                               
		Для каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
			Объект.УчетныеЕдиницы.Удалить(СтрокаКУдалению);
		КонецЦикла;                                        
		Для каждого УЕ Из ДополнительныеПараметры.СписокУЕ Цикл
			нСтрокаУЕ = Объект.УчетныеЕдиницы.Добавить();
			нСтрокаУЕ.ИдентификаторСтрокиУслуг = ДополнительныеПараметры.ИдентификаторСтрокиУслуг;
			нСтрокаУЕ.УчетнаяЕдиница = УЕ;
		КонецЦикла;
		Модифицированность = Истина;
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция ИзменитьСписокУчетныхЕдиниц(Данные)
	
	Содержание = Данные.Содержание;
	//МассивПодстрок = СтрРазделить(Содержание, "; ,:"+Символы.ПС);
	//Евросиб(ДИТ), Беляев СЮ, US 109628 / TA 112362, 18-06-2025, начало
	МассивПодстрок = СтрРазделить(Содержание, Документы.СчетНаОплатуПокупателю.СтрокаРазделителейУчетныхЕдиницВСодержанииУслуи());
	//Евросиб(ДИТ), Беляев СЮ, US 109628 / TA 112362, 18-06-2025, конец
	МассивКТК = Новый Массив;
	МассивВагонов = Новый Массив;
	Для каждого Подстрока Из МассивПодстрок Цикл                       
		Если СтрДлина(Подстрока) >= 10  Тогда
			Если РаботаСКонтейнерамиСервер.КорректнаяМаска(Лев(Подстрока,4), Сред(Подстрока, 5, 6)) Тогда
				КТК = РаботаСКонтейнерамиСервер.НайтиКТК(Подстрока, ЛОЖЬ);
				Если ЗначениеЗаполнено(КТК) Тогда
					МассивКТК.Добавить(КТК);	
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли СтрДлина(Подстрока) = 8 И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Подстрока) Тогда
			Вагон = Справочники.ТС.НайтиПоНаименованию(Подстрока, Истина);
			Если ЗначениеЗаполнено(Вагон) Тогда
				МассивВагонов.Добавить(Вагон);	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	ТаблицаПривязанныхУЕ = Объект.УчетныеЕдиницы.Выгрузить(Новый Структура("ИдентификаторСтрокиУслуг", Данные.Идентификатор));
	ТаблицаПривязанныхУЕ.Колонки.Добавить("ТипУЕ", Новый ОписаниеТипов("Строка"));
	Для каждого СтрокаУЕ Из ТаблицаПривязанныхУЕ Цикл
		Если ТипЗнч(СтрокаУЕ.УчетнаяЕдиница) = Тип("СправочникСсылка.ТС") Тогда
			СтрокаУЕ.ТипУЕ = "ТС";
		Иначе
			СтрокаУЕ.ТипУЕ = "ТЕ";
		КонецЕсли;
	КонецЦикла;                                              
	ТаблицаПривязанныхКТК = ТаблицаПривязанныхУЕ.Скопировать(Новый Структура("ТипУЕ", "ТЕ"));
	ТаблицаПривязанныхВагонов = ТаблицаПривязанныхУЕ.Скопировать(Новый Структура("ТипУЕ", "ТС"));
	МассивПривязанныхКТК = ТаблицаПривязанныхКТК.ВыгрузитьКолонку("УчетнаяЕдиница");
	МассивПривязанныхВагонов = ТаблицаПривязанныхВагонов.ВыгрузитьКолонку("УчетнаяЕдиница");
	ИзмененийНетКТК = ОбщегоНазначения.КоллекцииИдентичны(МассивПривязанныхКТК, МассивКТК);
	ИзмененийНетВагон = ОбщегоНазначения.КоллекцииИдентичны(МассивПривязанныхВагонов, МассивВагонов);
	СтрокиКУдалению = Новый Массив;
	Если ИзмененийНетКТК = Ложь ИЛИ ИзмененийНетВагон = Ложь Тогда
		//если есть изменения, но при этом количество совпадает, то будем считать, что пользователь делает всё правильно
		Если Данные.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ктк 
			И Данные.Количество = МассивКТК.Количество() Тогда
			Для каждого СтрокаПривязанныйУЕ Из ТаблицаПривязанныхКТК Цикл 
				Для каждого СтрокаУЕ Из Объект.УчетныеЕдиницы Цикл
					Если СтрокаУЕ.УчетнаяЕдиница = СтрокаПривязанныйУЕ.УчетнаяЕдиница Тогда
						СтрокиКУдалению.Добавить(СтрокаУЕ);
					КонецЕсли;
				КонецЦикла;
			КонецЦикла; 
			Для каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
				Объект.УчетныеЕдиницы.Удалить(СтрокаКУдалению);
			КонецЦикла;
			Для каждого КТК Из МассивКТК Цикл
				нСтрокаУЕ = Объект.УчетныеЕдиницы.Добавить();
				нСтрокаУЕ.ИдентификаторСтрокиУслуг = Данные.Идентификатор;
				нСтрокаУЕ.УчетнаяЕдиница = КТК;
			КонецЦикла;
		ИначеЕсли Данные.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ктк Тогда
			СтруктураРезультата = Новый Структура();   
			СтруктураРезультата.Вставить("ДанныеКорректны", Ложь);
			СтруктураРезультата.Вставить("ТекстВопроса", СтрШаблон("Количество КТК в тексте содержания (%1) отличается от количества КТК по этой строке (%2). 
			|Возможно текст содержания некорректен.
			|Принять изменения?",МассивКТК.Количество(), Данные.Количество));
			СтруктураРезультата.Вставить("СписокУЕ", МассивКТК);
			СтруктураРезультата.Вставить("ИдентификаторСтрокиУслуг", Данные.Идентификатор);
			Возврат СтруктураРезультата;
		ИначеЕсли Данные.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.вагон 
			И Данные.Количество = МассивВагонов.Количество() Тогда
			Для каждого СтрокаПривязанныйУЕ Из ТаблицаПривязанныхВагонов Цикл
				Для каждого СтрокаУЕ Из Объект.УчетныеЕдиницы Цикл
					Если СтрокаУЕ.УчетнаяЕдиница = СтрокаПривязанныйУЕ.УчетнаяЕдиница Тогда
						СтрокиКУдалению.Добавить(СтрокаУЕ);
					КонецЕсли;
				КонецЦикла;
			КонецЦикла; 
			Для каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
				Объект.УчетныеЕдиницы.Удалить(СтрокаКУдалению);
			КонецЦикла;
			Для каждого Вагон Из МассивВагонов Цикл
				нСтрокаУЕ = Объект.УчетныеЕдиницы.Добавить();
				нСтрокаУЕ.ИдентификаторСтрокиУслуг = Данные.Идентификатор;
				нСтрокаУЕ.УчетнаяЕдиница = Вагон;
			КонецЦикла;
		ИначеЕсли Данные.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.вагон Тогда
			СтруктураРезультата = Новый Структура();   
			СтруктураРезультата.Вставить("ДанныеКорректны", Ложь);
			СтруктураРезультата.Вставить("ТекстВопроса", СтрШаблон("Количество вагонов в тексте содержания (%1) отличается от количества вагонов по этой строке (%2). 
			|Возможно текст содержания некорректен.
			|Принять изменения?",МассивВагонов.Количество(), Данные.Количество));
			СтруктураРезультата.Вставить("СписокУЕ", МассивВагонов);
			СтруктураРезультата.Вставить("ИдентификаторСтрокиУслуг", Данные.Идентификатор);
			Возврат СтруктураРезультата;
		Иначе
			//Объект.УчетныеЕдиницы.Очистить();
			//Евросиб(ДИТ), Беляев СЮ, Ticket#0367227, 01-10-2024, начало
			СвязанныеСтроки =  Объект.УчетныеЕдиницы.НайтиСтроки(Новый Структура("ИдентификаторСтрокиУслуг", Данные.Идентификатор));
			Для Каждого СтрокаКУдалению Из СвязанныеСтроки Цикл
				Объект.УчетныеЕдиницы.Удалить(СтрокаКУдалению);
			КонецЦикла;
			//Евросиб(ДИТ), Беляев СЮ, Ticket#0367227, 01-10-2024, конец
			Для каждого КТК Из МассивКТК Цикл
				нСтрокаУЕ = Объект.УчетныеЕдиницы.Добавить();
				нСтрокаУЕ.ИдентификаторСтрокиУслуг = Данные.Идентификатор;
				нСтрокаУЕ.УчетнаяЕдиница = КТК;
			КонецЦикла;
  			Для каждого Вагон Из МассивВагонов Цикл
				нСтрокаУЕ = Объект.УчетныеЕдиницы.Добавить();
				нСтрокаУЕ.ИдентификаторСтрокиУслуг = Данные.Идентификатор;
				нСтрокаУЕ.УчетнаяЕдиница = Вагон;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли; 
	Возврат Новый Структура("ДанныеКорректны", Истина);
	
КонецФункции

