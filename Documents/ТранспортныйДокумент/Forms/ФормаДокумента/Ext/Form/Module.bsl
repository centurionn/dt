&НаКлиенте
Процедура ОбработкаВставкиExcel(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	Для каждого Стр из Параметр1 Цикл
		
		Если ТипЗнч(Стр) = Тип("СправочникСсылка.ТЕ") Тогда
			
			НСтр = Объект.Коносаменты.Добавить();
			НСтр.НомерКТК = Стр;
			ТипИРазмер = РаботаСКонтейнерамиСервер.ПолучитьТипИРазмер(Стр);
			//НСтр.РазмерКТК = ТипИРазмер.Размер;
			НСтр.ТипКТК = ТипИРазмер.Тип;
			
		ИначеЕсли ТипЗнч(Стр) = Тип("Строка") Тогда
			
			КТК = РаботаСКонтейнерамиСервер.СоздатьКТК(Стр, неопределено);
			НСтр = Объект.Коносаменты.Добавить();
			НСтр.НомерКТК = КТК;
			
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

