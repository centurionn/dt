Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	НайдСтрокаСостояния = неопределено;
	
	Для каждого Стр из Объект.Состояния Цикл
		Если Стр.Состояние = ПредопределенноеЗначение("Справочник.Состояния.СозданиеАвансовогоСчетаПоКоносаменту") Тогда
			НайдСтрокаСостояния = Стр;
		КонецЕсли;
	КонецЦикла;
	
	Если Объект.ГотовКВыставлению = Ложь И НайдСтрокаСостояния <> неопределено Тогда
		//НайдСтрокаСостояния.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Новый");
		//ДИТ, Беляев СЮ, Ticket#0286346, 21-09-2022, начало
		Объект.Состояния.Удалить(НайдСтрокаСостояния);
		//ДИТ, Беляев СЮ, Ticket#0286346, 21-09-2022, конец
		
		//НайдСтрокаСостояния.ПримечаниеЗадачаИсполнителю = Ложь;
	ИначеЕсли Объект.ГотовКВыставлению = Истина Тогда
		
		Если НайдСтрокаСостояния = неопределено Тогда
			
			НайдСтрокаСостояния = Объект.Состояния.Добавить();
			НайдСтрокаСостояния.Состояние = ПредопределенноеЗначение("Справочник.Состояния.СозданиеАвансовогоСчетаПоКоносаменту");
			
		КонецЕсли;
		
		Если НайдСтрокаСостояния.Статус <> ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Выполнен") И 
			НайдСтрокаСостояния.Статус <> ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.Отклонен") Тогда
			НайдСтрокаСостояния.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЭтапов.ВРаботе");
			НайдСтрокаСостояния.НачалоРаботы = ТекущаяДата();
			НайдСтрокаСостояния.Исполнитель = ОтветственныйМенеджер;
		КонецЕсли;
		//НайдСтрокаСостояния.ПримечаниеЗадачаИсполнителю = Истина;
		НайдСтрокаСостояния.Комментарий = "Создать авансовый счет по к/с " + Объект.НомерТранспортногоДокумента;
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	КонтрагентСибур = ПолучитьКонтрагентаСибур();
	Если Объект.Контрагент = КонтрагентСибур Тогда
		ЗаписатьДанныеСибур();
	КонецЕсли;
	
