&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	ОкнаПриложения = ПолучитьОкна();
	Для каждого ОкноПриложения Из ОкнаПриложения Цикл
		// Анализ заголовка окна
		Если ЗначениеЗаполнено(Объект.Букинг) Тогда
			Если Найти(ОкноПриложения.Заголовок, Объект.Букинг) > 0 Тогда
				// Получение формы
				Если ОкноПриложения.Содержимое.Количество()>0 Тогда
					НайденнаяФорма = ОкноПриложения.Содержимое[0];
					
					НайденнаяФорма.ЗаполнитьРеквизитКоносамент();
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
