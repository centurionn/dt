&НаСервереБезКонтекста
Функция ПолучитьДанныеПоМорскойДислокацииКонтейнеров(Контейнеры)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДислокацияКонтейнеровМореСрезПоследних.Контейнер КАК Контейнер,
		|	ДислокацияКонтейнеровМореСрезПоследних.Период КАК Период,
		|	ДислокацияКонтейнеровМореСрезПоследних.Порт КАК Порт,
		|	ДислокацияКонтейнеровМореСрезПоследних.Событие КАК Событие
		|ИЗ
		|	РегистрСведений.ДислокацияКонтейнеровМоре.СрезПоследних(, Контейнер В (&Контейнеры)) КАК ДислокацияКонтейнеровМореСрезПоследних";	
	Запрос.УстановитьПараметр("Контейнеры", Контейнеры);	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Дислокации = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Дислокации.Вставить(Выборка.Контейнер, Новый Структура("ДатаПоследнейОперации, ПоследняяОперация, МестоПоследнейОперации", Выборка.Период, Выборка.Событие, Выборка.Порт));
	КонецЦикла;
	
	Возврат Дислокации;
	
КонецФункции

