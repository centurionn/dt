&НаСервере
Процедура ЗаписатьДанныеСибур()
	
	Запись = РегистрыСведений.СибурРазмещенныеКоносаменты.СоздатьМенеджерЗаписи();
	Запись.ТранспортныйДокумент = Объект.Ссылка;	
	Запись.Прочитать();
	
	Если Не Запись.Выбран() Тогда		
		Запись.ТранспортныйДокумент = Объект.Ссылка;
	КонецЕсли; 
	
	Запись.ДатаОтправкиИнструкции = СибурДатаОтправкиИнструкции;
	Запись.КоличествоВыпускаемыхКоносаментов = СибурКоличествоВыпускаемыхКоносаментов;
	Запись.КоличествоКопийКоносаментов = СибурКоличествоКопийКоносаментов;
	Запись.ДатаСогласования = СибурДатаСогласования;
	Запись.ДатаОформленияОригинала = СибурДатаОформленияОригинала;
	Запись.ОтветственныйМенеджер = СибурОтветственныйМенеджер;
	
	Запись.НаименованиеГрузоотправителя = СибурНаименованиеГрузоотправителя;
	Запись.НаименованиеГрузополучателя = СибурНаименованиеГрузополучателя;
	Запись.РегНомерГрузополучателя = СибурРегНомерГрузополучателя;
	Запись.ЭлектроннаяПочтаГрузополучателя = СибурЭлектроннаяПочтаГрузополучателя;
	Запись.ТелефонГрузополучателя = СибурТелефонГрузополучателя;
	Запись.АдресГрузополучателя = СибурАдресГрузополучателя;
	
	Запись.УведомлениеНаименование = СибурУведомлениеНаименование;
	Запись.УведомлениеРегистрационныйНомер = СибурУведомлениеРегистрационныйНомер;
	Запись.УведомлениеАдрес = СибурУведомлениеАдрес;
	Запись.УведомлениеТелефон = СибурУведомлениеТелефон;
	Запись.УведомлениеЭлектроннаяПочта = СибурУведомлениеЭлектроннаяПочта;
	
	Запись.Описание = СибурОписание;	
	
	Запись.Записать();
	
КонецПроцедуры

