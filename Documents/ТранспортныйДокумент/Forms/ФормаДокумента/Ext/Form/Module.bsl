&НаСервереБезКонтекста
Функция ПолучитьДанныеСделки(ОбъектСсылка)
	
	Результат = Новый Структура("Сделка, ОтветственныйМенеджер");
	
	Запрос = Новый Запрос;
	// ДИТ US 51951 TA 61497 Евсенкин М.А. Начало: 29.11.2022
	// Было:
	//Запрос.Текст = "ВЫБРАТЬ
	//               |	СделкаСвязьУчетныхЕдиниц.Ссылка КАК Сделка,
	//               |	СделкаСвязьУчетныхЕдиниц.Договор.ОтветственныйЗаУчет КАК ОтветственныйМенеджер
	//               |ИЗ
	//               |	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	//               |ГДЕ
	//               |	СделкаСвязьУчетныхЕдиниц.Коносамент = &Коносамент
	//               |	И НЕ СделкаСвязьУчетныхЕдиниц.Ссылка.ПометкаУдаления"; 
	//Стало:
	Запрос.Текст = "ВЫБРАТЬ
	               |	СделкаСвязьУчетныхЕдиниц.Ссылка КАК Сделка,
	               |	Ответственные.Ответственный КАК ОтветственныйМенеджер
	               |ИЗ
	               |	Документ.Сделка.СвязьУчетныхЕдиниц КАК СделкаСвязьУчетныхЕдиниц
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов.Ответственные КАК Ответственные
	               |		ПО СделкаСвязьУчетныхЕдиниц.Договор = Ответственные.Ссылка
	               |			И (Ответственные.ТипОтветственного = ЗНАЧЕНИЕ(Перечисление.ТипыОтветственных.ОтветственныйЗаУчет))
	               |			И (Ответственные.ЦФО = ЗНАЧЕНИЕ(Справочник.ЦентрыФинансовойОтветственности.ОсновнойЦФО))
	               |ГДЕ
	               |	СделкаСвязьУчетныхЕдиниц.Коносамент = &Коносамент
	               |	И НЕ СделкаСвязьУчетныхЕдиниц.Ссылка.ПометкаУдаления
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СделкаСвязьУчетныхЕдиниц.Ссылка,
	               |	Ответственные.Ответственный";
	// ДИТ US 51951 TA 61497 Евсенкин М.А. Конец: 29.11.2022
	
	Запрос.УстановитьПараметр("Коносамент", ОбъектСсылка);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		
		Результат.Сделка = Ответ.Сделка;
		Результат.ОтветственныйМенеджер = Ответ.ОтветственныйМенеджер;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

