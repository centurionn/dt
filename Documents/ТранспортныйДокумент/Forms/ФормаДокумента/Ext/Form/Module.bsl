
&НаКлиенте
Процедура ЗапроситьДанныеПоКТКВMAERSK(Команда)
	ТЧ.Очистить();
	ЗапроситьДанныеПоКТКВMAERSKНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗапроситьДанныеПоКТКВMAERSKНаСервере()
	
	Результат = ЗагрузкаВнешнихИсточников_сервер.MAERSK_CONT_OR_BILL(Объект.НомерТранспортногоДокумента);
	ЧТДЖ = Новый ЧтениеJSON();
	ЧТДЖ.УстановитьСтроку(Результат);
	РЕЗ = ПрочитатьJSON(ЧТДЖ);
	Для каждого стр из РЕЗ.containers Цикл
		
		НСтр = ТЧ.Добавить();
		//НСтр.ПунктОтправленияКод = РЕЗ.origin.geo_site;
		//НСтр.ПунктОтправления = ЗагрузкаВнешнихИсточников_сервер.ПолучитьЛокациюПоИдентификаторуMAERSK(НСтр.ПунктОтправленияКод);
		//НСтр.ПунктНазначенияКод = РЕЗ.destination.geo_site;
		//НСтр.ПунктНазначения = ЗагрузкаВнешнихИсточников_сервер.ПолучитьЛокациюПоИдентификаторуMAERSK(НСтр.ПунктНазначенияКод);
		//НСтр.НомерКТК = стр.container_num;
		//НСтр.ТипКТК = стр.container_type;
		//НСтр.РазмерКТК = стр.container_size;
		//НСтр.ISO = стр.iso_code;
		//НСтр.ОжидаемаяДоставка = ЗагрузкаВнешнихИсточников_сервер.ПреобразоватьДатуВ1С(стр.eta_final_delivery, 2);
		//НСтр.Статус = стр.status;
		//НСтр.ПоследняяОперация = стр.latest.activity;
		//НСтр.ДатаПоследнейОперации = ЗагрузкаВнешнихИсточников_сервер.ПреобразоватьДатуВ1С(стр.latest.actual_time, 2);
		//НСтр.МестоПоследнейОперацииКод = стр.latest.geo_site;
		//НСтр.МестоПоследнейОперации = ЗагрузкаВнешнихИсточников_сервер.ПолучитьЛокациюПоИдентификаторуMAERSK(стр.latest.geo_site);
		
		Если НЕ ЗначениеЗаполнено(НСтр.МестоПоследнейОперации) Тогда
			НЭлемент = Справочники.Локации.СоздатьЭлемент();
			НЭлемент.ИдентификаторMAERSK = НСтр.МестоПоследнейОперацииКод;
			НЭлемент.Наименование = стр.latest.city;
			НЭлемент.НаименованиеАнгл = НЭлемент.Наименование;
			НЭлемент.Родитель = Справочники.Локации.Загруженные;
			НЭлемент.Страна = Справочники.СтраныМира.НайтиПоРеквизиту("КодАльфа2", стр.latest.country_code);
			НЭлемент.Записать();
			НСтр.МестоПоследнейОперации = НЭлемент.Ссылка;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НСтр.ПунктОтправления) Тогда
			НЭлемент = Справочники.Локации.СоздатьЭлемент();
			НЭлемент.ИдентификаторMAERSK = НСтр.ПунктОтправленияКод;
			НЭлемент.Наименование = РЕЗ.origin.terminal;
			НЭлемент.НаименованиеАнгл = НЭлемент.Наименование;
			НЭлемент.Родитель = Справочники.Локации.Загруженные;
			НЭлемент.Страна = Справочники.СтраныМира.НайтиПоРеквизиту("КодАльфа2", РЕЗ.origin.country_code);
			НЭлемент.Записать();
			НСтр.ПунктОтправления = НЭлемент.Ссылка;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НСтр.ПунктНазначения) Тогда
			НЭлемент = Справочники.Локации.СоздатьЭлемент();
			НЭлемент.ИдентификаторMAERSK = НСтр.ПунктНазначенияКод;
			НЭлемент.Наименование = РЕЗ.destination.terminal;
			НЭлемент.НаименованиеАнгл = НЭлемент.Наименование;
			НЭлемент.Родитель = Справочники.Локации.Загруженные;
			НЭлемент.Страна = Справочники.СтраныМира.НайтиПоРеквизиту("КодАльфа2", РЕЗ.destination.country_code);
			НЭлемент.Записать();
			НСтр.ПунктНазначения = НЭлемент.Ссылка;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьЗакладок()
	
	Элементы.ГруппаЖДН.Видимость = Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийТранспортныхДокументов.ЖДНакладная");
	Элементы.ГруппаТН.Видимость = Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийТранспортныхДокументов.ТранспортнаяНакладная");
	ЭтоКоносамент = Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийТранспортныхДокументов.Коносамент");
	Элементы.ГруппаКС.Видимость = ЭтоКоносамент;
	Элементы.ГруппаКоносамент.Видимость = ЭтоКоносамент;
//Евросиб Гудкова( 02.07.2020 
	Элементы.ГруппаМоре.Видимость = ЭтоКоносамент;
//Евросиб Гудкова( 12.08.2020 Ticket№ 0202630
	КонтрагентПриИзменении(Неопределено);	
// Евросиб Гудкова)   

	// Евросиб(ДИТ) BUG 93771 ТА 93793 Сержантова А.С. Начало: 31.10.2024     
	Элементы.ГруппаДанныеМорскогоРейса.Видимость = ЭтоКоносамент;
	Элементы.ГруппаДанныеМорскогоРейса.ТолькоПросмотр = ЭтоКоносамент и ЗначениеЗаполнено(Объект.МорскойРейс);
	Элементы.МорскаяЛиния.ТолькоПросмотр = ЭтоКоносамент и ЗначениеЗаполнено(Объект.МорскойРейс); 
	Элементы.Группа7.Видимость = не ЭтоКоносамент; //группа с датой отправления/прибытия 
	Элементы.Группа11.Видимость = не ЭтоКоносамент; //группа с плановой датой отправления/прибытия
	Элементы.Группа6.Видимость = не ЭтоКоносамент; //группа с пункт отправления/пункт назначения 
	// Евросиб(ДИТ) BUG 93771 ТА 93793 Сержантова А.С. Конец: 31.10.2024  
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0375647 , 14-11-2024, начало
	//Элементы.ГруппаДанныеМорскогоРейса.Заголовок = "По данным Морского рейса"; 
	Если ЗначениеЗаполнено(Объект.МорскойРейс) Тогда
		Элементы.ГруппаДанныеМорскогоРейса.Заголовок = "По данным Морского рейса";
	Иначе
	    Элементы.ГруппаДанныеМорскогоРейса.Заголовок = "По данным коносамента";
	КонецЕсли;
	Элементы.ГруппаДанныеМорскогоРейса.ОтображатьЗаголовок = Истина;
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0375647 , 14-11-2024, конец
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьВидимостьЗакладок();
	Если Объект.ГотовКВыставлению Тогда
		ГотовКВыставлениюПриИзменении(неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	ОбновитьВидимостьЗакладок();
	//++ Зубов 03.08.2021 35854
	ОбновитьВидимостьСибур();
	//-- Зубов 03.08.2021 35854
КонецПроцедуры

&НаСервере
Процедура НакладнаяЭТРАНПриИзмененииНаСервере()
	
	Если Объект.НомерТранспортногоДокумента <> Объект.НакладнаяЭТРАН.Номер Тогда
	    ОбъектТД = ДанныеФормыВЗначение(Объект, Тип("ДокументОбъект.ТранспортныйДокумент"));
    	ОбъектТД.Заполнить(Объект.НакладнаяЭТРАН);
		ЗначениеВДанныеФормы(ОбъектТД, Объект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НакладнаяЭТРАНПриИзменении(Элемент)
	НакладнаяЭТРАНПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект); 
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// Обновляем панель текущего пользователя и панель состояний
	ОбновитьПанельТекущегоПользователя();
	ОбновитьПанельСостояний();
	// - Состояния
		
	ЦветКнопки_Исходный = Элементы.КоносаментыЗаполнятьПоПервойСтроке.ЦветФона;
	ЦветКнопки_Выделенный = WebЦвета.Розовый;
	
	//Евросиб Каблов 08.07.2020 (
	//Если Объект.Контрагент = ПолучитьКонтрагентаСибур() Тогда
	//	Элементы.СтатусЗаявкиСибур.Видимость = Истина;
	//Иначе
	//	Элементы.СтатусЗаявкиСибур.Видимость = Ложь;
	//КонецЕсли;
	
	МассивКонтейнеров = Новый Массив;
	Для Каждого СтрокаТЧ Из Объект.Коносаменты Цикл
		Если ЗначениеЗаполнено(СтрокаТЧ.НомерКТК) Тогда
			МассивКонтейнеров.Добавить(СтрокаТЧ.НомерКТК);
		КонецЕсли;
	КонецЦикла;
	
	Дислокации = ПолучитьДанныеПоМорскойДислокацииКонтейнеров(МассивКонтейнеров);
	Для Каждого СтрокаТЧ Из Объект.Коносаменты Цикл
		Дислокация = Дислокации.Получить(СтрокаТЧ.НомерКТК);
		Если Дислокация <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, Дислокация);
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЗаполнитьРеквизитыРазмещенногоКоносаментаСибур();
	КонецЕсли;
	//Евросиб Каблов 08.07.2020 )
	
	//++ Зубов 03.08.2021 35854
	ОбновитьВидимостьСибур();
	
	Если ЗначениеЗаполнено(Объект.Букинг) Тогда
		Если НЕ ЗначениеЗаполнено(Объект.Букинг.НомерБукинга) Тогда
			Сообщить("Коносамент не может быть создан, так как не указан «Номер букинга»");
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	//-- Зубов 03.08.2021 35854

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
	
	//Субботин 75158 13.10.2023 начало
	ИсточникиФормированияОбъекта = РегистрыСведений.ПротоколОбменов.ПолучитьУзлыОбменаОбъектаПротоколаОбмена(Объект.Ссылка, Перечисления.ДействияПриОбмене.ЗагрузкаДанных);
	Если ИсточникиФормированияОбъекта <> Неопределено Тогда
		КонтрольДоступностиДокументов_сервер.ОбработатьБлокировкуЭлементовФормы(Объект.Ссылка, Элементы);
		Если не РольДоступна("ПолныеПрава") Тогда
			Элементы.ПредупреждениеРедактирования.Видимость = Истина; 
			Элементы.ПредупреждениеРедактирования.Заголовок = "Документ частично заблокирован, поскольку был загружен из внешней системы. Редактирование документа ограничено!";
			//Субботин 80722 07.02.2024 начало
			УслОформление = Этаформа.УсловноеОформление.Элементы.Добавить();
			УслОформление.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",Истина);
			ЭлементУсловия = УслОформление.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементУсловия.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ДетализацияПоГрузу.СтрокаЗагруженаИзСтороннейСистемы");
			ЭлементУсловия.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
			ЭлементУсловия.ПравоеЗначение = Истина;
			ОформляемоеПоле = УслОформление.Поля.Элементы.Добавить();
    		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ДетализацияПоГрузу");			
			Элементы.Коносаменты.КоманднаяПанель.ПодчиненныеЭлементы.КоносаментыДетализацияПоГрузу.Доступность = Истина;
			//Субботин 80722 07.02.2024 Конец
		КонецЕсли;	
	КонецЕсли;
	//Субботин 75158 13.10.2023 Конец  
	
КонецПроцедуры
//Евросиб Коханенко Н.А. #61705 09.12.2022 )

