	ЗаполнятьПоПервойСтроке = НЕ ЗаполнятьПоПервойСтроке;
	Элементы.КоносаментыЗаполнятьПоПервойСтроке.ЦветФона = ?(ЗаполнятьПоПервойСтроке, ЦветКнопки_Выделенный, ЦветКнопки_Исходный);
	
КонецПроцедуры

&НаКлиенте
Процедура КоносаментыПриИзменении(Элемент)
	
	Если ЗаполнятьПоПервойСтроке Тогда
		ИмяТЧ = Элемент.Имя;
		ИмяПоля = Сред(Элемент.ТекущийЭлемент.Имя, СтрДлина(ИмяТЧ)+1);
		
		Для Сч = 1 По Объект[ИмяТЧ].Количество() - 1 Цикл
			Объект[ИмяТЧ][Сч][ИмяПоля] = Объект[ИмяТЧ][0][ИмяПоля];
		КонецЦикла;
	КонецЕсли;
	
	//Евросиб Каблов 08.07.2020 (
	Если Элемент.ТекущийЭлемент.Имя = "КоносаментыНомерКТК" Тогда
		
		МассивКонтейнеров = Новый Массив;
		Для Каждого СтрокаТЧ Из Объект.Коносаменты Цикл
			Если ЗначениеЗаполнено(СтрокаТЧ.НомерКТК) Тогда
				МассивКонтейнеров.Добавить(СтрокаТЧ.НомерКТК);
			КонецЕсли;
		КонецЦикла;
		
		Дислокации = ПолучитьДанныеПоМорскойДислокацииКонтейнеров(МассивКонтейнеров);
		Для Каждого СтрокаТЧ Из Объект.Коносаменты Цикл
			Дислокация = Дислокации.Получить(СтрокаТЧ.НомерКТК);
			Если Дислокация <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(СтрокаТЧ, Дислокация);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	//Евросиб Каблов 08.07.2020 )
	
КонецПроцедуры

