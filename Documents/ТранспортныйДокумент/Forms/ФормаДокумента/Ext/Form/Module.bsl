&НаСервере
Процедура ОбновитьВидимостьСибур()
	Если Объект.ВидОперации = Перечисления.ВидыОперацийТранспортныхДокументов.Коносамент И Объект.Контрагент = Константы.СибурКонтрагент.Получить() Тогда
		Элементы.СибурОписание.Заголовок = "Описание груза";
		Элементы.ГруппаСибур.Видимость = Истина;
	Иначе
		Элементы.СибурОписание.Заголовок = "Описание";
		Элементы.ГруппаСибур.Видимость = Ложь;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСводно()
	Объект.СводноОГрузополучателе = ?(СибурНаименованиеГрузополучателя="","",СибурНаименованиеГрузополучателя + Символы.ПС) + ?(СибурРегНомерГрузополучателя="","",СибурРегНомерГрузополучателя + Символы.ПС) + ?(СибурАдресГрузополучателя="","",СибурАдресГрузополучателя + Символы.ПС) + ?(СибурТелефонГрузополучателя="","",СибурТелефонГрузополучателя + Символы.ПС) + СибурЭлектроннаяПочтаГрузополучателя; 
	Объект.СводноОбУведомлении = ?(СибурУведомлениеНаименование="","",СибурУведомлениеНаименование + Символы.ПС) + ?(СибурУведомлениеРегистрационныйНомер="","",СибурУведомлениеРегистрационныйНомер + Символы.ПС) + ?(СибурУведомлениеАдрес="","",СибурУведомлениеАдрес + Символы.ПС) + ?(СибурУведомлениеТелефон="","",СибурУведомлениеТелефон + Символы.ПС) + СибурУведомлениеЭлектроннаяПочта;
КонецПроцедуры
