&НаКлиенте
Процедура ПовторнаяМаршрутизация(Команда)
	
	Если Объект.Маршрутизировать Тогда
		ПараметрыЗапроса = Новый Соответствие;
		ПараметрыЗапроса.Вставить("Организация", Объект.Организация);
		ПараметрыЗапроса.Вставить("Контрагент", Объект.Контрагент);
		ПараметрыЗапроса.Вставить("Договор", Объект.ДоговорКонтрагента);
		РезультатЗапроса = МаршрутизацияСервер.МаршрутизироватьТД(ПараметрыЗапроса, Объект.Дата);
		Если РезультатЗапроса.Количество() > 0 Тогда
			Объект.ПримененныйМаршрут = РезультатЗапроса[0].Ссылка;
			Объект.Состояния.Очистить();
			Для каждого Стр из РезультатЗапроса Цикл
				ЗаполнитьЗначенияСвойств(Объект.Состояния.Добавить(), Стр);
			КонецЦикла;
		Иначе
			Сообщить("Для документа не найден подходящий маршрут. Изменения не внесены!");
		КонецЕсли;
		
		ОбновитьПанельСостояний();
	КонецЕсли;
	
КонецПроцедуры

