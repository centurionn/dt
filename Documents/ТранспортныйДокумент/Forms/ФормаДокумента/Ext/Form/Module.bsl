&НаКлиенте
Процедура КоносаментыПриАктивизацииСтроки(Элемент) 
	
	Если Элементы.Коносаменты.ТекущиеДанные <> Неопределено Тогда
		
		ОбновитьВидимостьДетализацияПоГрузу();
		СтруктураПоиска = Новый Структура ("СтрокаКоносаментаГУИД", Элементы.Коносаменты.ТекущиеДанные.ГУИДСтроки);
		
		Если Объект.ДетализацияПоГрузу.НайтиСтроки(СтруктураПоиска).Количество() > 0 тогда
			Элементы.КоносаментыДетализацияПоГрузу.ЦветФона = Новый Цвет(9, 255, 144);
		Иначе 
			Элементы.КоносаментыДетализацияПоГрузу.ЦветФона = Новый Цвет(255, 255, 255);
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры 

&НаКлиенте
Процедура КоносаментыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		Элемент.ТекущиеДанные.ГУИДСтроки = Новый УникальныйИдентификатор();
		ОбновитьВидимостьДетализацияПоГрузу();
	КонецЕсли;

КонецПроцедуры

