Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Поля = Новый Массив;
	Поля.Добавить("ВидОперации");
	Поля.Добавить("НомерТранспортногоДокумента");
	Поля.Добавить("ДатаТранспортногоДокумента");
	Поля.Добавить("Номер");
	Поля.Добавить("Дата");
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Представление = "" + Данные.ВидОперации + " " + Данные.НомерТранспортногоДокумента + " от " + Формат(Данные.ДатаТранспортногоДокумента, "ДФ=dd.MM.yy") + " (ТД " + Данные.Номер + " от " + Данные.Дата + ")";
	
КонецПроцедуры

//Евросиб(ДИТ), Беляев СЮ, US 104074 / TA 104682, 11-03-2025, начало
Функция НайтиДублирующийДокумент(Ссылка, НомерТранспортногоДокумента, ТолькоИзDX = Ложь) Экспорт
	
	СтруктураРезультат = Новый Структура;
	СтруктураРезультат.Вставить("ЕстьДубль", Ложь);
	СтруктураРезультат.Вставить("Ссылка", Документы.ТранспортныйДокумент.ПустаяСсылка());
	СтруктураРезультат.Вставить("УИДИсточника", "");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТранспортныйДокумент.Ссылка КАК Ссылка,
	|	ПротоколОбменов.УИДИсточника КАК УИДИсточника
	|ИЗ
	|	Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	|		ПО ТранспортныйДокумент.Ссылка = ПротоколОбменов.Объект
	|			И (ПротоколОбменов.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
	|			И (ПротоколОбменов.УзелОбмена = ЗНАЧЕНИЕ(Перечисление.УзлыОбмена.DX))
	|ГДЕ
	|	СОКРЛП(ТранспортныйДокумент.НомерТранспортногоДокумента) = &НомерТранспортногоДокумента
	|	И ТранспортныйДокумент.Ссылка <> &Ссылка
	|	И НЕ ПротоколОбменов.Объект ЕСТЬ NULL";
	
	Если НЕ ТолькоИзDX Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "НЕ ПротоколОбменов.Объект ЕСТЬ NULL", "Истина");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("НомерТранспортногоДокумента", СокрЛП(НомерТранспортногоДокумента));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	СтруктураРезультат.ЕстьДубль = НЕ РезультатЗапроса.Пустой();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		СтруктураРезультат.Ссылка = ВыборкаДетальныеЗаписи.Ссылка;
		СтруктураРезультат.УИДИсточника = ВыборкаДетальныеЗаписи.УИДИсточника;
	КонецЕсли;
	
	Возврат СтруктураРезультат;
	
КонецФункции
//Евросиб(ДИТ), Беляев СЮ, US 104074 / TA 104682, 11-03-2025, конец