		Движения.УчетныеЕдиницыТранспортныхДокументов.Загрузить(Запрос.Выполнить().Выгрузить()); 
		
		
		Если ЗначениеЗаполнено(НакладнаяЭТРАН) Тогда
			НакладнаяИД = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НакладнаяЭТРАН, "НакладнаяИД");
			Если ЗначениеЗаполнено(НакладнаяИД) Тогда
				Движения.ИдентификаторыТранспортныхДокументов.Записывать = Истина;
				Запись = Движения.ИдентификаторыТранспортныхДокументов.Добавить();
				Запись.ТранспортныйДокумент = Ссылка;
				Запись.ИдентификаторНакладнойЭтран = Формат(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НакладнаяЭТРАН, "НакладнаяИД"),"ЧГ=");
			КонецЕсли;
		КонецЕсли; 
	КонецЕсли; 
	Движения.ДанныеТранспортныхДокументов.Записывать = Истина;
	Запись = Движения.ДанныеТранспортныхДокументов.Добавить();
	Запись.ТранспортныйДокумент = Ссылка;
	Запись.ДатаОтправления				= ДатаОтправления;
	Запись.ДатаПрибытия 				= ДатаПрибытия;
	Запись.ДатаРаскредитации 			= ДатаРаскредитации;
	Запись.НомерТранспортногоДокумента 	= НомерТранспортногоДокумента;
	Запись.ВидОперации 					= ВидОперации;
	НомерТДТолькоЦифры 			   = СтроковыеФункцииКлиентСервер.УдалитьПрочиеСимволыИзСтроки(НомерТранспортногоДокумента, Истина, Ложь, Ложь);
	НомерТДТолькоЦифрыБезЛидНулей  = СтроковыеФункцииКлиентСервер.УдалитьПовторяющиесяСимволы(НомерТДТолькоЦифры, "0");
	Запись.НомерДляПоиска				= НомерТДТолькоЦифрыБезЛидНулей;
	
КонецПроцедуры

Функция ПолучитьСопоставлениеЭтранДатакор(МассивЗначенийЭтран)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Связь_ЭТРАН_DC_Сопоставление.СпрЭтрана КАК СпрЭтрана,
	|	Связь_ЭТРАН_DC_Сопоставление.СпрДатакор КАК СпрДатакор
	|ИЗ
	|	РегистрСведений.Связь_ЭТРАН_DC_Сопоставление КАК Связь_ЭТРАН_DC_Сопоставление
	|ГДЕ
	|	Связь_ЭТРАН_DC_Сопоставление.СпрЭтрана В(&СпрЭтрана)";
	Запрос.УстановитьПараметр("СпрЭтрана", МассивЗначенийЭтран);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	РезультатСоответствие = Новый Соответствие;
	Для каждого ЗначениеЭтран Из МассивЗначенийЭтран Цикл
		РезультатСоответствие.Вставить(ЗначениеЭтран);	
	КонецЦикла;
	Пока Выборка.Следующий() Цикл
		РезультатСоответствие.Вставить(Выборка.СпрЭтрана, Выборка.СпрДатакор);
	КонецЦикла;                                                               
	Возврат РезультатСоответствие;
	
КонецФункции

