	//					НомСтр = Число(Эл);
	//					СтрЭтапа = Состояния.Найти(НомСтр,"НомерСтроки");
	//					Если СтрЭтапа <> Неопределено Тогда
	//						Если СтрЭтапа.Статус <> Перечисления.СтатусыЭтапов.Выполнен Тогда
	//							ВозможноВыполнение = Ложь;
	//						КонецЕсли;
	//					КонецЕсли;
	//				Исключение
	//					Сообщить("Некорректное указание этапа состояние. Возможен только ввод цифр.");
	//				КонецПопытки
	//			КонецЦикла;
	//		КонецЕсли;
	//		Если ВозможноВыполнение Тогда
	//			СтрТЧ.Статус =  Перечисления.СтатусыЭтапов.НаВыполнение;
	//		КонецЕсли;
	//	КонецЕсли;
	//	
	//КонецЦикла;
	////Стаценко
	МаршрутизацияСервер.ПараллельноеСогласование(Состояния);
	//-- Зубов 35844 04.08.2021
	// если исполнитель пустой, то проставляем тек пользователя
	Для каждого Стр из Состояния Цикл
		Если НЕ ЗначениеЗаполнено(Стр.Исполнитель) И НЕ Стр.ТребуетсяУказатьИсполнителя Тогда 
			Стр.Исполнитель = Пользователи.ТекущийПользователь(); 
		//ИначеЕсли НЕ ЗначениеЗаполнено(Стр.Исполнитель) И Стр.ТребуетсяУказатьИсполнителя Тогда 
		//	Сообщить("Требуется указать исполнителя");
		//	Отказ = Истина;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Стр.Наблюдатель) И НЕ Стр.ТребуетсяУказатьНаблюдателя Тогда 
			Стр.Наблюдатель = Пользователи.ТекущийПользователь(); 
