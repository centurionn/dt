Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Если ЗначениеЗаполнено(НакладнаяЭТРАН) Тогда
		
		//ДИТ Шевченко А.В. 14.11.2022 59054 //Добавил Вид сборов в запрос
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТранспортныйДокументУчетныеЕдиницы.Ссылка.Дата КАК Период,
		|	ТранспортныйДокументУчетныеЕдиницы.Ссылка КАК ТранспортныйДокумент,
		|	ТранспортныйДокументУчетныеЕдиницы.Контейнер КАК Контейнер,
		|	ТранспортныйДокументУчетныеЕдиницы.Вагон КАК Вагон,
		|	ТранспортныйДокументУчетныеЕдиницы.СтавкаНДС КАК СтавкаНДС,
		|	ТранспортныйДокументУчетныеЕдиницы.СуммаБезНДС КАК СуммаБезНДС,
		|	ТранспортныйДокументУчетныеЕдиницы.СуммаНДС КАК СуммаНДС,
		|	ТранспортныйДокументУчетныеЕдиницы.ВидСборов КАК ВидСборов
		|ИЗ
		|	Документ.ТранспортныйДокумент.УчетныеЕдиницы КАК ТранспортныйДокументУчетныеЕдиницы
		|ГДЕ
		|	ТранспортныйДокументУчетныеЕдиницы.Ссылка = &Ссылка
		|	И НЕ(ТранспортныйДокументУчетныеЕдиницы.Контейнер = ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)
		|				И ТранспортныйДокументУчетныеЕдиницы.Вагон = ЗНАЧЕНИЕ(Справочник.ТС.ПустаяСсылка))";
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Движения.СтоимостьПоЖДНакладным.Записывать = Истина;
		Движения.СтоимостьПоЖДНакладным.Загрузить(Запрос.Выполнить().Выгрузить());
		
