		РеквизитыЗаполнения 		= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения, Реквизиты);
		Контрагент 					= ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьЗначениеКонстанты("КонтрагентДляЖДН");
		ВидОперации 				= Перечисления.ВидыОперацийТранспортныхДокументов.ЖДНакладная;
		ДатаПрибытия 				= РеквизитыЗаполнения.ДатаИВремяПрибытияГруза;
		ДатаРаскредитации 			= РеквизитыЗаполнения.ДатаИВремяРаскредитованияГруза;
		ДатаОтправления 			= РеквизитыЗаполнения.ДатаИВремяОтправленияГруза; 
		Дата 						= РеквизитыЗаполнения.Дата;
		НомерТранспортногоДокумента = РеквизитыЗаполнения.Номер;
		ДатаТранспортногоДокумента 	= РеквизитыЗаполнения.Дата;
		МассивСоответствий = Новый Массив;
		МассивСоответствий.Добавить(РеквизитыЗаполнения.СтанцияОтправления);
		МассивСоответствий.Добавить(РеквизитыЗаполнения.СтанцияНазначения);
		СоответствиеЭтранДатакор 	= ПолучитьСопоставлениеЭтранДатакор(МассивСоответствий);
