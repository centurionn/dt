		КонецЕсли;
		Если Стр.ПримечаниеЗадачаИсполнителю Тогда
			// если текст примечания изменился, то создать новое сообщение. если остался прежним, то не менять
			// т.к. состояние уникально, ищем по нему
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Состояние",Стр.Состояние);
			НайденнаяСтр = Ссылка.Состояния.НайтиСтроки(ПараметрыОтбора);
			Если НайденнаяСтр.Количество()>0 Тогда
				Если НЕ НайденнаяСтр[0].Комментарий = Стр.Комментарий Тогда
					
					// +Шейко ОЕ [Ticket#0204385] Личные сообщения пользователям
					ДатаСообщения = ТекущаяДата();
					АвторСообщения = Пользователи.ТекущийПользователь();
					ТекстСообщения = Стр.Комментарий;
					ГУИДСообщения = Новый УникальныйИдентификатор();
					
					ГУИДТемы = Новый УникальныйИдентификатор;
					
					РассылкаПоЛичнымЦелям.СформироватьЛичноеСообщение(ГУИДТемы, , Ссылка, ДатаСообщения, АвторСообщения, ТекстСообщения, , ГУИДСообщения, Стр.Исполнитель);
					// -Шейко ОЕ [Ticket#0204385] Личные сообщения пользователям
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	// определяем текущее состояние. для нас это первое состояние не в "выполнено"
	//Для каждого Состояние из Состояния Цикл
	//	Если Состояние.Статус <> Перечисления.СтатусыЭтапов.Выполнен Тогда
	//		ТекущееСостояние = Состояние.Состояние;
	//		Прервать;
	//	КонецЕсли;
	//КонецЦикла;
	
	МаршрутизацияСервер.ПостобработкаТЧСостояний(ЭтотОбъект, пользователи.ТекущийПользователь());
	
	// - Состояния
	Если Не ЭтоНовый() Тогда
		ЗаполнитьСсылкиВагоновИКонтейнеровПоНомерам(); //ДИТ Шевченко А.В. 59059 19.12.2022
	КонецЕсли;
	
	Если Не ЭтоНовый() Тогда
		ПолучитьСделкиДляАктуализации(); //ДИТ Шевченко А.В. 69796 23.01.2023
	КонецЕсли;
	
	//Субботин 80722 07.02.2024 начало 
	Для Каждого СтрокаКоносамента из Коносаменты Цикл
		Если Не ЗначениеЗаполнено(СтрокаКоносамента.ГУИДСтроки) Тогда
			 СтрокаКоносамента.ГУИДСтроки = Новый УникальныйИдентификатор();
		КонецЕсли;	 
	КонецЦикла;
	//Субботин 80722 07.02.2024 Конец 
	
	//Евросиб Коханенко Н.А. 19.03.2025 (( #104519 
	//КлючевыеПоляДляЗапросаНаАвтоперевозкуИзменены = ПроверитьИзменениеКлючевыхПолейДляЗапросаНаАвтоперевозку(); //Евросиб(ДИТ), Беляев СЮ, Ticket#0394405, 10-04-2025, закомментировал, перенес выше
	//Евросиб Коханенко Н.А. 19.03.2025 )) #104519 
	
	//Евросиб Шевченко А.В. US 110215 TA 128335 17.03.2026
	Если ВидОперации = Перечисления.ВидыОперацийТранспортныхДокументов.Коносамент Тогда
		
		ПоставитьВОчередь = НЕ ОбщегоНазначения.КоллекцииИдентичны(Ссылка.Коносаменты.Выгрузить(), Коносаменты.Выгрузить(), "НомерКТК",,Истина)
							ИЛИ Ссылка.МестоПолученияГруза <> МестоПолученияГруза ИЛИ Ссылка.МестоПоставкиГруза <> МестоПоставкиГруза
							ИЛИ Ссылка.СтанцияОтправления <> СтанцияОтправления ИЛИ Ссылка.СтанцияНазначения <> СтанцияНазначения;
		
		Если ПоставитьВОчередь Тогда
			ОтложенноеИзменениеСервер.ПоставитьСвязанныеОбъектыВОчередьИзменения(Ссылка);		
		КонецЕсли;	
	КонецЕсли;	
	//Евросиб Шевченко А.В. US 110215 TA 128335 17.03.2026
	
КонецПроцедуры

Процедура ЗаполнитьСсылкиВагоновИКонтейнеровПоНомерам() //ДИТ Шевченко А.В. 59059 19.12.2022
	
	ТЗКонтейнеры = УчетныеЕдиницы.Выгрузить(,"НомерСтроки,НомерКонтейнера");
	ТЗВагоны 	 = УчетныеЕдиницы.Выгрузить(,"НомерСтроки,НомерВагона");
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЗКонтейнеры.НомерСтроки КАК НомерСтроки,
		|	ТЗКонтейнеры.НомерКонтейнера КАК НомерКонтейнера
		|ПОМЕСТИТЬ ВТ_Контейнеры
		|ИЗ
		|	&ТЗКонтейнеры КАК ТЗКонтейнеры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТЗВагоны.НомерСтроки КАК НомерСтроки,
		|	ТЗВагоны.НомерВагона КАК НомерВагона
		|ПОМЕСТИТЬ ВТ_Вагоны
		|ИЗ
		|	&ТЗВагоны КАК ТЗВагоны
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТС.Ссылка КАК Ссылка,
		|	ТС.Наименование КАК Наименование,
		|	ЕСТЬNULL(ТипТССсылка.Вагон, ЛОЖЬ) КАК ТипТСВагон
		|ПОМЕСТИТЬ ВТ_ВагоныСсылки
		|ИЗ
		|	ВТ_Вагоны КАК ВТ_Вагоны
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТС КАК ТС
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТипоразмерыТС КАК ТипТССсылка
		|			ПО (ТипТССсылка.Ссылка = ТС.ТипТС)
		|		ПО (ТС.Наименование = ВТ_Вагоны.НомерВагона)
		|			И (НЕ ТС.ПометкаУдаления)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ВагоныСсылки.Наименование КАК Наименование,
		|	МАКСИМУМ(ВТ_ВагоныСсылки.ТипТСВагон) КАК ТипТСВагон
		|ПОМЕСТИТЬ ВТ_ВагоныПоТипу
		|ИЗ
		|	ВТ_ВагоныСсылки КАК ВТ_ВагоныСсылки
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ВагоныСсылки.Наименование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(ВТ_ВагоныСсылки.Ссылка) КАК Ссылка,
		|	ВТ_ВагоныСсылки.Наименование КАК Наименование
		|ПОМЕСТИТЬ ВТ_ВагоныИтог
		|ИЗ
		|	ВТ_ВагоныПоТипу КАК ВТ_ВагоныПоТипу
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВагоныСсылки КАК ВТ_ВагоныСсылки
		|		ПО (ВТ_ВагоныСсылки.Наименование = ВТ_ВагоныПоТипу.Наименование)
		|			И ВТ_ВагоныПоТипу.ТипТСВагон = ВТ_ВагоныСсылки.ТипТСВагон
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ВагоныСсылки.Наименование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Контейнеры.НомерСтроки КАК НомерСтроки,
		|	ЕСТЬNULL(ТЕ.Ссылка, ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка)) КАК Контейнер,
		|	ЗНАЧЕНИЕ(Справочник.ТС.ПустаяСсылка) КАК Вагон
		|ПОМЕСТИТЬ ВТ_Итог
		|ИЗ
		|	ВТ_Контейнеры КАК ВТ_Контейнеры
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТЕ КАК ТЕ
		|		ПО ВТ_Контейнеры.НомерКонтейнера = ТЕ.Наименование
		|			И (НЕ ТЕ.ПометкаУдаления)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ВТ_Вагоны.НомерСтроки,
		|	ЗНАЧЕНИЕ(Справочник.ТЕ.ПустаяСсылка),
		|	ЕСТЬNULL(ТС.Ссылка, ЗНАЧЕНИЕ(Справочник.ТС.ПустаяСсылка))
		|ИЗ
		|	ВТ_Вагоны КАК ВТ_Вагоны
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВагоныИтог КАК ТС
		|		ПО ВТ_Вагоны.НомерВагона = ТС.Наименование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Итог.НомерСтроки КАК НомерСтроки,
		|	МАКСИМУМ(ВТ_Итог.Контейнер) КАК Контейнер,
		|	МАКСИМУМ(ВТ_Итог.Вагон) КАК Вагон
		|ИЗ
		|	ВТ_Итог КАК ВТ_Итог
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Итог.НомерСтроки";
	
	Запрос.УстановитьПараметр("ТЗКонтейнеры",ТЗКонтейнеры);
	Запрос.УстановитьПараметр("ТЗВагоны",ТЗВагоны);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НомерСтроки = ВыборкаДетальныеЗаписи.НомерСтроки;
		УчетныеЕдиницы[НомерСтроки-1].Контейнер = ВыборкаДетальныеЗаписи.Контейнер;
		УчетныеЕдиницы[НомерСтроки-1].Вагон 	= ВыборкаДетальныеЗаписи.Вагон;
	КонецЦикла;
	
КонецПроцедуры	

Процедура ПолучитьСделкиДляАктуализации()

	//ТзДоИзм = Ссылка.УчетныеЕдиницы.Выгрузить(,"Контейнер,Вагон"); 
	//Евросиб(ДИТ), Беляев СЮ, BUG 101605 / TA 102596, 22-05-2025, начало
	ЗаписанныеРеквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка,"УчетныеЕдиницы,ДатаРаскредитации,ДатаОтправления,ДатаПрибытия,ДатаОтправления,ДатаТранспортногоДокумента");
	ТзДоИзм = ЗаписанныеРеквизиты.УчетныеЕдиницы.Выгрузить().Скопировать(,"Контейнер,Вагон");
	//Евросиб(ДИТ), Беляев СЮ, BUG 101605 / TA 102596, 22-05-2025, конец
	ТЗПосле = УчетныеЕдиницы.Выгрузить(,"Контейнер,Вагон");
	
	ФлагНаличияИзменений = НЕ ОбщегоНазначения.КоллекцииИдентичны(ТзДоИзм, ТЗПосле,,, Истина);
	
	//Евросиб(ДИТ), Беляев СЮ, US 90567 / TA 91259, 09-09-2024, начало
	ЗаполниласьДатаРаскредитации_Прибытия = Ложь;
	Если ВидОперации = Перечисления.ВидыОперацийТранспортныхДокументов.ЖДНакладная Тогда
		//ЗаполниласьДатаРаскредитации_Прибытия = НЕ ЗначениеЗаполнено(Ссылка.ДатаРаскредитации) И ЗначениеЗаполнено(ДатаРаскредитации);
		//Евросиб(ДИТ), Беляев СЮ, BUG 101605 / TA 102596, 22-05-2025, начало
		ЗаполниласьДатаРаскредитации_Прибытия = ПроверитьЗаполнениеРеквизитов(ЗаписанныеРеквизиты, "ДатаРаскредитации,ДатаОтправления");
		//Евросиб(ДИТ), Беляев СЮ, BUG 101605 / TA 102596, 22-05-2025, конец
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийТранспортныхДокументов.Коносамент Тогда
		//ЗаполниласьДатаРаскредитации_Прибытия = НЕ ЗначениеЗаполнено(Ссылка.ДатаПрибытия) И ЗначениеЗаполнено(ДатаПрибытия);
		//Евросиб(ДИТ), Беляев СЮ, BUG 101605 / TA 102596, 22-05-2025, начало
		ЗаполниласьДатаРаскредитации_Прибытия = ПроверитьЗаполнениеРеквизитов(ЗаписанныеРеквизиты, "ДатаПрибытия,ДатаОтправления,ДатаТранспортногоДокумента");
		//Евросиб(ДИТ), Беляев СЮ, BUG 101605 / TA 102596, 22-05-2025, конец
	КонецЕсли;
	
	ФлагНаличияИзменений = ФлагНаличияИзменений ИЛИ ЗаполниласьДатаРаскредитации_Прибытия;
	//Евросиб(ДИТ), Беляев СЮ, US 90567 / TA 91259, 09-09-2024, конец
	
	//Если НЕ ПолучитьСделки Тогда
	//	Для Каждого СтрокаДоИзм Из Ссылка.УчетныеЕдиницы Цикл
	//		СтрокаТек = УчетныеЕдиницы[СтрокаДоИзм.НомерСтроки-1];
	//		ПолучитьСделки = СтрокаДоИзм.Контейнер <> СтрокаТек.Контейнер И СтрокаДоИзм.Вагон <> СтрокаТек.Вагон;
	//		Если ПолучитьСделки Тогда
	//			Прервать;
	//		КонецЕсли;	
	//	КонецЦикла;	
	//КонецЕсли;	
	
	Если ФлагНаличияИзменений Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	АктуальныеЖДН.Регистратор КАК Сделка
		|ИЗ
		|	РегистрНакопления.АктуальныеЖДН КАК АктуальныеЖДН
		|ГДЕ
		|	АктуальныеЖДН.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|	И АктуальныеЖДН.ЖДН = &ЖДН";
		
		Запрос.УстановитьПараметр("ЖДН",Ссылка);
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ОтложенноеИзменениеСервер.ПоставитьСделкуВОчередьИзменения(ВыборкаДетальныеЗаписи.Сделка,Ссылка);
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры	

//Евросиб(ДИТ), Беляев СЮ, BUG 101605 / TA 102596, 22-05-2025, начало
Функция ПроверитьЗаполнениеРеквизитов(ЗаписанныеРеквизиты, СписокРеквизитов)
	
	Результат = Ложь;
	МассивРеквизитов = СтрРазделить(СписокРеквизитов, ",");
	
	Для Каждого Реквизит Из МассивРеквизитов  Цикл
		Если НЕ ЗначениеЗаполнено(ЗаписанныеРеквизиты[Реквизит]) И ЗначениеЗаполнено(ЭтотОбъект[Реквизит]) Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции
