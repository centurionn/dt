		//Если ВыборкаСтанцияНазначения.Следующий() Тогда
		//	СтанцияНазначения = ВыборкаСтанцияНазначения.СпрДатакор;
		//КонецЕсли; 
		//Если ВыборкаСтанцияОтправления.Следующий() Тогда
		//	СтанцияОтправления = ВыборкаСтанцияОтправления.СпрДатакор;
		//КонецЕсли;                               
		НакладнаяЭТРАН 				= ДанныеЗаполнения.Ссылка;                                     
