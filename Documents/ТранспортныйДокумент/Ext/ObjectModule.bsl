		   И ЗначениеЗаполнено(ДополнительныеСвойства.СтанцияНазначения) Тогда
			СтанцияНазначения = ДополнительныеСвойства.СтанцияНазначения;
		Иначе
			//ок(
		СтанцияНазначения 			= СоответствиеЭтранДатакор.Получить(РеквизитыЗаполнения.СтанцияНазначения);
			//ок)
		КонецЕсли;
		//ДИТ Давудов М.А. US 64009 12.01.2024 Конец
		 
		ЗаполнитьУчетныеЕдиницы(ДанныеЗаполнения);
		
		//++ Зубов 03.08.2021 35854
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Букинг") Тогда
		ВидОперации = Перечисления.ВидыОперацийТранспортныхДокументов.Коносамент;
		Дата = ДанныеЗаполнения.Дата;
		Букинг = ДанныеЗаполнения.Ссылка;
		//++ Зубов 0228547 20.09.2021
		//Контрагент = Константы.СибурКонтрагент.Получить();
		Контрагент = ДанныеЗаполнения.Контрагент;
		//-- Зубов 0228547 20.09.2021
		СтанцияОтправления = ДанныеЗаполнения.ПортОтправления;
		СтанцияНазначения = ДанныеЗаполнения.ПортНазначения;
		МорскойРейс = ДанныеЗаполнения.Рейс;
		Судно = ДанныеЗаполнения.Рейс.Судно;
		МорскаяЛиния = ДанныеЗаполнения.Линия;
		НомерТранспортногоДокумента = ДанныеЗаполнения.НомерБукинга;
		НомерБукинга = ДанныеЗаполнения.НомерБукинга;
		ДатаОтправленияПлан = ДанныеЗаполнения.ДатаОтправленияПоРасписанию;
		ДатаПрибытияПлан = ДанныеЗаполнения.ДатаПрибытияПоРасписанию;
		//-- Зубов 03.08.2021 35854
	КонецЕсли; 
	// Евросиб Гудкова)
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0394405, 10-04-2025, начало
	КлючевыеПоляДляЗапросаНаАвтоперевозкуИзменены = ПроверитьИзменениеКлючевыхПолейДляЗапросаНаАвтоперевозку();
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0394405, 10-04-2025, конец
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;	
	//ДИТ Шевченко А.В. US 96893 TA 98138 15.01.2025
	Если ВидОперации = Перечисления.ВидыОперацийТранспортныхДокументов.Коносамент Тогда
		//Если ЗначениеЗаполнено(НомерТранспортногоДокумента) Тогда	
		//Евросиб(ДИТ), Беляев СЮ, Ticket#0386415, 10-02-2025, начало
		//1) проверка обязательна для нового документа
		//2) проверка обязательна при смене номера транспортного документа
		//3) проверка не нужна, если документ уже записан и номер не поменялся - чтобы работали старые дубли, которые уже используются в документах
		ПроверятьДубли = Ложь;
		Если ЗначениеЗаполнено(НомерТранспортногоДокумента) Тогда
			ИзменилсяНомерТранспортногоДокумента = СокрЛП(НомерТранспортногоДокумента) <> СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "НомерТранспортногоДокумента"));
			ПроверятьДубли = ЭтоНовый() Или ИзменилсяНомерТранспортногоДокумента;
		КонецЕсли;
		Если ПроверятьДубли Тогда
		//Евросиб(ДИТ), Беляев СЮ, Ticket#0386415, 10-02-2025, конец
			//Запрос = Новый Запрос;
			//Запрос.Текст = 
			//"ВЫБРАТЬ
			//|	ТранспортныйДокумент.Ссылка КАК Ссылка
			//|ИЗ
			//|	Документ.ТранспортныйДокумент КАК ТранспортныйДокумент
			//|ГДЕ
			//|	СОКРЛП(ТранспортныйДокумент.НомерТранспортногоДокумента) = &НомерТранспортногоДокумента
			//|	И ТранспортныйДокумент.Ссылка <> &Ссылка";
			//Запрос.УстановитьПараметр("Ссылка", Ссылка);
			//Запрос.УстановитьПараметр("НомерТранспортногоДокумента", СокрЛП(НомерТранспортногоДокумента));
			//
			//РезультатЗапроса = Запрос.Выполнить();
			//
			//ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			//
			//Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			//	Сообщить("Коносамент с таким номером уже существует");
			//	Отказ = Истина;
			//	Прервать;
			//КонецЦикла;	
			
			//Евросиб(ДИТ), Беляев СЮ, US 104074 / TA 104682, 11-03-2025, начало
			РезультатПроверки = Документы.ТранспортныйДокумент.НайтиДублирующийДокумент(Ссылка, НомерТранспортногоДокумента);
			Если РезультатПроверки.ЕстьДубль Тогда
				ОбщегоНазначения.СообщитьПользователю("Коносамент с таким номером уже существует");
				Отказ = Истина;
			КонецЕсли;
			//Евросиб(ДИТ), Беляев СЮ, US 104074 / TA 104682, 11-03-2025, конец
		КонецЕсли;	
	КонецЕсли;	
	//ДИТ Шевченко А.В. US 96893 TA 98138 15.01.2025
	
	//Субботин 75158 13.10.2023 начало
	Если ПометкаУдаления = Истина И НЕ РольДоступна("ПолныеПрава") Тогда
		ИсточникиФормированияОбъекта = РегистрыСведений.ПротоколОбменов.ПолучитьУзлыОбменаОбъектаПротоколаОбмена(Ссылка, Перечисления.ДействияПриОбмене.ЗагрузкаДанных);
		Если ИсточникиФормированияОбъекта <> Неопределено Тогда 
			Если ИсточникиФормированияОбъекта.Найти(Перечисления.УзлыОбмена.DX, "УзелОбмена") <> Неопределено Тогда
				ОбщегоНазначения.СообщитьПользователю("Удаление документа загруженного из DX запрещено");
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//Субботин 75158 13.10.2023 Конец 
	
