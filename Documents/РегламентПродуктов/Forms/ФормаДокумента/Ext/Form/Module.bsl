
&НаКлиенте
Процедура ДобавитьПродукты(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораПродуктов", ЭтаФорма);
	//ДИТ Шевченко А.В. US 62360 ТА 72965 26.07.2023
	//ОткрытьФорму("Справочник.Продукты.ФормаВыбора", Новый Структура("МножественныйВыбор", Истина),, ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ОткрытьФорму("Справочник.СервисыУчетноеНаправление.ФормаВыбора", Новый Структура("МножественныйВыбор", Истина),, ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
    //ДИТ Шевченко А.В. US 62360 ТА 72965 26.07.2023
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораПродуктов(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	ОбработкаВыбора_сервер(Параметр1);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбора_сервер(Параметр1)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Продукты.Ссылка КАК Продукт,
	               |	Продукты.КонтейнерныйПоезд КАК КП,
	               |	Продукты.СвободныхМест КАК СвободныхМест,
	               |	Продукты.ДатаНачалаУслуги КАК ДатаНачала,
	               |	Продукты.ДатаОкончанияУслуги КАК ДатаОкончания,
	               |	Продукты.НачалоМаршрута КАК НачалоМаршрута,
	               |	Продукты.ОкончаниеМаршрута КАК ОкончаниеМаршрута
	               |ИЗ
				   //ДИТ Шевченко А.В. US 62360 ТА 72965 26.07.2023
	               //|	Справочник.Продукты КАК Продукты
				   |	Справочник.СервисыУчетноеНаправление КАК Продукты
				   //ДИТ Шевченко А.В. US 62360 ТА 72965 26.07.2023
	               |ГДЕ
	               |	Продукты.Ссылка В(&Ссылка)";
	Запрос.УстановитьПараметр("Ссылка", Параметр1);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		НСтр = Объект.Продукты.Добавить();
		НСтр.Действует = Истина;
		ЗаполнитьЗначенияСвойств(НСтр, Ответ);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродуктыПродуктПриИзменении(Элемент)
	
	ТекД = Элементы.Продукты.ТекущиеДанные;
	
	Если ТекД <> неопределено И ЗначениеЗаполнено(ТекД.Продукт) Тогда
		ТСтр = Отправки_сервер.ПолучитьСтруктуруПараметровСервиса(ТекД.Продукт);
		ТекД.КП = ТСтр.КП;
		ТекД.СвободныхМест = ТСтр.КоличествоТЕУ;
		ТекД.ДатаНачала = ТСтр.ДатаОтправления;
		ТекД.ДатаОкончания = ТСтр.ДатаПрибытия;
		ТекД.НачалоМаршрута = ТСтр.ПунктОтправления;
		ТекД.ОкончаниеМаршрута = ТСтр.ПунктНазначения;
		ТекД.Действует = Истина;
	КонецЕсли;
	
КонецПроцедуры

