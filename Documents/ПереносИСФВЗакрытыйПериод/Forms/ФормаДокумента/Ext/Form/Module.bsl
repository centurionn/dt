&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтаФорма);
	Элементы.ГруппаДокументыДляПереноса.ТолькоПросмотр = Объект.Проведен; 
	Элементы.ГруппаДокументыДляПодбора.Видимость = НЕ Объект.Проведен;
	
	//Евросиб Каблов 09.04.2025 ( #105407
	//ПериодВОДляОтбора = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериод(Объект.Организация);
	ПериодВОДляОтбора = КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериодДоходов(Объект.Организация);
	//Евросиб Каблов 09.04.2025 )
	ОтборДокументовРТУ.Параметры.УстановитьЗначениеПараметра("ПериодВО", ПериодВОДляОтбора);
	ОтборДокументовОК.Параметры.УстановитьЗначениеПараметра("ПериодВО", ПериодВОДляОтбора);
	ОтборДокументовКРТУ.Параметры.УстановитьЗначениеПараметра("ПериодВО", ПериодВОДляОтбора);
	УстановитьОтборДокументовНаСервере(); 

	//Евросиб Коханенко Н.А. #61705 09.12.2022 (
	ИнструкцииСервер.ДобавитьКнопкуИнструкции(ЭтаФорма);
	//Евросиб Коханенко Н.А. #61705 09.12.2022 )
КонецПроцедуры

