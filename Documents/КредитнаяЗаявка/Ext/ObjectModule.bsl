
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Автор = Пользователи.ТекущийПользователь();
	Создано = ТекущаяДата();
	Организация = Константы.ОсновнаяОрганизация.Получить();
	СтатусДокумента = Перечисления.СтатусыСогласования.Планируется;
	Подразделение = Автор.Подразделение;
	ЦФО = Автор.ЦФО;
	Маршрутизировать = Константы.МаршрутизироватьКредитнуюЗаявку.Получить();
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
		// Заполнение шапки
		ВалютаДоговора = ДанныеЗаполнения.ВалютаВзаиморасчетов;
		Контрагент = ДанныеЗаполнения.Владелец;
		КатегорияДоговора = ДанныеЗаполнения.КатегорияДоговора;
		ЭДО = ?(ДанныеЗаполнения.КодСпособаВыставления = 1,Ложь,Истина);
		Организация = ДанныеЗаполнения.Организация;
		МенеджерПоДоговору = ДанныеЗаполнения.ОтветственныйЗаДоговор.ФизическоеЛицо;
		ОтсрочкаПоДоговору_План = ДанныеЗаполнения.СрокОплаты;
		ДоговорКонтрагента = ДанныеЗаполнения.Ссылка;
		ПениПоДоговору = ДанныеЗаполнения.Пени;
		ПениПланируемые = ПениПоДоговору;
		Дата = ТекущаяДата();
		ДатаНачала = ТекущаяДата();
		ИндексыСпарк = ПолучитьСПАРКИндексы();
		Если ИндексыСпарк <> Неопределено Тогда
			СводныйИндекс = ИндексыСпарк.Сводный;
			ИндексИДО 	  = ИндексыСпарк.ИДО;
			ИндексИФР     = ИндексыСпарк.ИФР;
		    ИндексИПД     = ИндексыСпарк.ИПД;
		КонецЕсли;
		ЗаполнитьПоДаннымИзБазы();
		ИтогоСредняяПДЗ = ДанныеЗаПериод.Итог("МаксимальнаяПЗД")/6;
		ВспомТЧ = ДанныеЗаПериод.Выгрузить(,"МаксимальнаяПЗД");
		ВспомТЧ.Сортировать("МаксимальнаяПЗД Убыв");
		МаксимальнаяПДЗ = ВспомТЧ[0].МаксимальнаяПЗД;
		СреднемесячнаяВыручка = ДанныеЗаПериод.Итог("Выручка")/6;
		СреднемесячнаяВыручкаПланируемая = СреднемесячнаяВыручка;
		ЛимитДЗ_План = СреднемесячнаяВыручкаПланируемая * ОтсрочкаПоДоговору_План/30;
		ЛимитДЗ_Факт = ЛимитДЗ_План;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСПАРКИндексы()
	СтруктураРезультата = Новый Структура;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СПАРКИндексыРисковСрезПоследних.СводныйИндикаторРиска КАК СводныйИндикаторРиска,
	               |	СПАРКИндексыРисковСрезПоследних.ИндексДолжнойОсмотрительности КАК ИндексДолжнойОсмотрительности,
	               |	СПАРКИндексыРисковСрезПоследних.ИндексФинансовогоРиска КАК ИндексФинансовогоРиска,
	               |	СПАРКИндексыРисковСрезПоследних.ИндексПлатежнойДисциплины КАК ИндексПлатежнойДисциплины
	               |ИЗ
	               |	РегистрСведений.СПАРКИндексыРисков.СрезПоследних(&Период, Контрагент = &Контрагент) КАК СПАРКИндексыРисковСрезПоследних";
	Запрос.УстановитьПараметр("Период",Дата);
	Запрос.УстановитьПараметр("Контрагент",Контрагент);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		СтруктураРезультата.Вставить("Сводный",Результат.СводныйИндикаторРиска);
		СтруктураРезультата.Вставить("ИДО",Результат.ИндексДолжнойОсмотрительности);
		СтруктураРезультата.Вставить("ИФР",Результат.ИндексФинансовогоРиска);
		СтруктураРезультата.Вставить("ИПД",Результат.ИндексПлатежнойДисциплины);
		Возврат СтруктураРезультата;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Процедура ЗаполнитьПоДаннымИзБазы()
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", ДобавитьМесяц(НачалоМесяца(Дата), -6));
	Запрос.УстановитьПараметр("КонецПериода",НачалоМесяца(Дата)-84600);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Договор",ДоговорКонтрагента);
	Запрос.УстановитьПараметр("Организация",Организация);

	Запрос.Текст = "ВЫБРАТЬ
	                      |	ВзаиморасчетыСПокупателямиОбороты.Период КАК Период,
	                      |	ВзаиморасчетыСПокупателямиОбороты.СуммаСНДСРасход КАК Выручка
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчетыСПокупателями.Обороты(&НачалоПериода, &КонецПериода, Месяц, ) КАК ВзаиморасчетыСПокупателямиОбороты
	                      |ГДЕ
	                      |	ВзаиморасчетыСПокупателямиОбороты.Контрагент = &Контрагент
	                      |	И ВзаиморасчетыСПокупателямиОбороты.Договор = &Договор
	                      |	И ВзаиморасчетыСПокупателямиОбороты.Организация = &Организация
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Период
	                      |ИТОГИ
	                      |	СУММА(Выручка)
	                      |ПО
	                      |	Период ПЕРИОДАМИ(МЕСЯЦ, &НачалоПериода, &КонецПериода)";
	ВыручкаПоПериоду = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"Период","ВСЕ");
	Пока ВыручкаПоПериоду.Следующий() Цикл
		НовСтр = ДанныеЗаПериод.Добавить();
		НовСтр.Месяц = ВыручкаПоПериоду.Период;
		НовСтр.Выручка = ВыручкаПоПериоду.Выручка;
	КонецЦикла;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	РазнесениеСчетовПокупателейПоВходящимПлатежамОбороты.СчетПокупателю КАК СчетПокупателю,
	               |	РазнесениеСчетовПокупателейПоВходящимПлатежамОбороты.Контрагент КАК Контрагент,
	               |	РазнесениеСчетовПокупателейПоВходящимПлатежамОбороты.Договор КАК Договор,
	               |	РазнесениеСчетовПокупателейПоВходящимПлатежамОбороты.СчетПокупателю.Дата КАК ДатаСчета
	               |ПОМЕСТИТЬ ОплаченныеСчетаЗАПериод
	               |ИЗ
	               |	РегистрНакопления.РазнесениеСчетовПокупателейПоВходящимПлатежам.Обороты(&НачалоПериода, &КонецПериода, , ) КАК РазнесениеСчетовПокупателейПоВходящимПлатежамОбороты
	               |ГДЕ
	               |	РазнесениеСчетовПокупателейПоВходящимПлатежамОбороты.НеразнесеннаяСуммаПриход - РазнесениеСчетовПокупателейПоВходящимПлатежамОбороты.НеразнесеннаяСуммаРасход = 0
	               |	И РазнесениеСчетовПокупателейПоВходящимПлатежамОбороты.СчетПокупателю.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И РазнесениеСчетовПокупателейПоВходящимПлатежамОбороты.Контрагент = &Контрагент
	               |	И РазнесениеСчетовПокупателейПоВходящимПлатежамОбороты.Договор = &Договор
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОплаченныеСчетаЗАПериод.ДатаСчета КАК ДатаСчета,
	               |	ЕСТЬNULL(ВЫБОР
	               |			КОГДА РАЗНОСТЬДАТ(ОплаченныеСчетаЗАПериод.ДатаСчета, РазнесениеСчетовПокупателейПоВходящимПлатежам.Период, ДЕНЬ) - ОплаченныеСчетаЗАПериод.Договор.СрокОплаты < 0
	               |				ТОГДА 0
	               |			ИНАЧЕ РАЗНОСТЬДАТ(ОплаченныеСчетаЗАПериод.ДатаСчета, РазнесениеСчетовПокупателейПоВходящимПлатежам.Период, ДЕНЬ) - ОплаченныеСчетаЗАПериод.Договор.СрокОплаты
	               |		КОНЕЦ, 0) КАК ДнейПросрочки,
	               |	РазнесениеСчетовПокупателейПоВходящимПлатежам.ВидДвижения КАК ВидДвижения,
	               |	РазнесениеСчетовПокупателейПоВходящимПлатежам.Контрагент КАК Контрагент,
	               |	РазнесениеСчетовПокупателейПоВходящимПлатежам.Договор КАК Договор,
	               |	РазнесениеСчетовПокупателейПоВходящимПлатежам.СчетПокупателю КАК СчетПокупателю,
	               |	ЕСТЬNULL(ВЫБОР
	               |			КОГДА ВЫБОР
	               |					КОГДА РАЗНОСТЬДАТ(ОплаченныеСчетаЗАПериод.ДатаСчета, РазнесениеСчетовПокупателейПоВходящимПлатежам.Период, ДЕНЬ) - ОплаченныеСчетаЗАПериод.Договор.СрокОплаты < 0
	               |						ТОГДА 0
	               |					ИНАЧЕ РАЗНОСТЬДАТ(ОплаченныеСчетаЗАПериод.ДатаСчета, РазнесениеСчетовПокупателейПоВходящимПлатежам.Период, ДЕНЬ) - ОплаченныеСчетаЗАПериод.Договор.СрокОплаты
	               |				КОНЕЦ > 0
	               |				ТОГДА РазнесениеСчетовПокупателейПоВходящимПлатежам.НеразнесеннаяСумма
	               |			ИНАЧЕ 0
	               |		КОНЕЦ, 0) КАК СуммаПДЗ
	               |ИЗ
	               |	ОплаченныеСчетаЗАПериод КАК ОплаченныеСчетаЗАПериод
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.РазнесениеСчетовПокупателейПоВходящимПлатежам КАК РазнесениеСчетовПокупателейПоВходящимПлатежам
	               |		ПО ОплаченныеСчетаЗАПериод.СчетПокупателю = РазнесениеСчетовПокупателейПоВходящимПлатежам.СчетПокупателю
	               |ГДЕ
	               |	РазнесениеСчетовПокупателейПоВходящимПлатежам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаСчета
	               |ИТОГИ
	               |	СУММА(ДнейПросрочки) / КОЛИЧЕСТВО(ДнейПросрочки) КАК ДнейПросрочки,
	               |	СУММА(СуммаПДЗ)
	               |ПО
	               |	ДатаСчета ПЕРИОДАМИ(МЕСЯЦ, &НачалоПериода, &КонецПериода)";
	ПДЗ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"ДатаСчета","ВСЕ");
	Пока ПДЗ.Следующий() Цикл
		Стр = ДанныеЗаПериод.Найти(НачалоМесяца(ПДЗ.ДатаСчета),"Месяц");
		Если Стр <> Неопределено Тогда
			Стр.СреднееКоличествоДнейПросрочки = Стр.СреднееКоличествоДнейПросрочки + ?(ПДЗ.ДнейПросрочки = null, 0,ПДЗ.ДнейПросрочки);
			Стр.МаксимальнаяПЗД = Стр.МаксимальнаяПЗД + ?(ПДЗ.СуммаПДЗ= null, 0,ПДЗ.СуммаПДЗ);
		КонецЕсли;
	КонецЦикла;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтрибуцияСделокОбороты.Период КАК Период,
	               |	ЕСТЬNULL(КонтрибуцияСделокОбороты.СебестоимостьОборот, 0) КАК Себестоимость
	               |ИЗ
	               |	РегистрНакопления.КонтрибуцияСделок.Обороты(&НачалоПериода, &КонецПериода, Месяц, ) КАК КонтрибуцияСделокОбороты
	               |ГДЕ
	               |	КонтрибуцияСделокОбороты.Сделка.Доходы.Клиент = &Контрагент
	               |	И КонтрибуцияСделокОбороты.Сделка.Доходы.Договор = &Договор
	               |	И КонтрибуцияСделокОбороты.Сделка.Организация = &Организация
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период
	               |ИТОГИ
	               |	СУММА(Себестоимость)
	               |ПО
	               |	Период ПЕРИОДАМИ(МЕСЯЦ, &НачалоПериода, &КонецПериода)";
	 Себестоимость = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"Период","ВСЕ");
	 Пока Себестоимость.Следующий() Цикл
		Стр = ДанныеЗаПериод.Найти(НачалоМесяца(Себестоимость.Период),"Месяц");
		Если Стр <> Неопределено Тогда
			Стр.СебистоимостьИВР = Стр.СебистоимостьИВР + ?(Себестоимость.Себестоимость= null, 0,Себестоимость.Себестоимость);
			Стр.Контрибуция = Стр.Выручка - Стр.СебистоимостьИВР;
		КонецЕсли;

	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КатегорииКонтрагентовСрезПоследних.Категория КАК Категория
	               |ИЗ
	               |	РегистрСведений.КатегорииКонтрагентов.СрезПоследних(&Период, Контрагент = &Контрагент) КАК КатегорииКонтрагентовСрезПоследних
	               |ГДЕ
	               |	КатегорииКонтрагентовСрезПоследних.ПлановаяФактическая = &Плановая";
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Плановая", Перечисления.ПланФакт.Факт);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		КатегорияПоКомпании = Ответ.Категория;
	КонецЕсли;
	
	
КонецПроцедуры

