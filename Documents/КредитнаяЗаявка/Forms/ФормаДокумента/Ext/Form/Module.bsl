КонецПроцедуры

&НаКлиенте
Процедура УстановитьЦветовоеОформление()
	ЦветЗеленый = Новый Цвет(0,255,0);
	ЦветЖелтый = Новый Цвет(255,255,0);
	ЦветКрасный = Новый Цвет(255,0,0);
	Если Объект.ИндексИДО >=1 и Объект.ИндексИДО <= 40 Тогда
		Элементы.ИндексИДО.ЦветФона = ЦветЗеленый;
	ИначеЕсли Объект.ИндексИДО > 40 и Объект.ИндексИДО <= 70 Тогда
		Элементы.ИндексИДО.ЦветФона = ЦветЖелтый;
	ИначеЕсли Объект.ИндексИДО > 70 и Объект.ИндексИДО <= 99 Тогда
		Элементы.ИндексИДО.ЦветФона = ЦветКрасный;
	КонецЕсли;
	Если Объект.ИндексИПД >=80 и Объект.ИндексИПД <= 100 Тогда
		Элементы.ИндексИПД.ЦветФона = ЦветЗеленый;
	ИначеЕсли Объект.ИндексИПД >= 50 и Объект.ИндексИПД <= 79 Тогда
		Элементы.ИндексИПД.ЦветФона = ЦветЖелтый;
	ИначеЕсли Объект.ИндексИПД >= 0 и Объект.ИндексИПД <= 49 Тогда
		Элементы.ИндексИПД.ЦветФона = ЦветКрасный;
	КонецЕсли;
	Если Объект.ИндексИФР >=1 и Объект.ИндексИФР <= 14 Тогда
		Элементы.ИндексИФР.ЦветФона = ЦветЗеленый;
	ИначеЕсли Объект.ИндексИФР >= 15 и Объект.ИндексИФР <= 85 Тогда
		Элементы.ИндексИФР.ЦветФона = ЦветЖелтый;
	ИначеЕсли Объект.ИндексИФР >= 86 и Объект.ИндексИФР <= 99 Тогда
		Элементы.ИндексИФР.ЦветФона = ЦветКрасный;
	КонецЕсли;
	
	Если Объект.ЛимитДЗ_Факт <= Объект.ЛимитДЗ_План Тогда
		Элементы.ЛимитДЗ_Факт.ЦветФона = ЦветЗеленый;
	Иначе
		Элементы.ЛимитДЗ_Факт.ЦветФона = ЦветКрасный;
	КонецЕсли;
КонецПроцедуры

