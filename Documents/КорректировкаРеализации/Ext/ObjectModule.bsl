	// если исполнитель пустой, то проставляем тек пользователя
	Для каждого Стр из Состояния Цикл
		Если Стр.ПримечаниеЗадачаИсполнителю Тогда
			// если текст примечания изменился, то создать новое сообщение. если остался прежним, то не менять
			// т.к. состояние уникально, ищем по нему
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Состояние",Стр.Состояние);
			НайденнаяСтр = Ссылка.Состояния.НайтиСтроки(ПараметрыОтбора);
			Если НайденнаяСтр.Количество()>0 Тогда
				Если НЕ НайденнаяСтр[0].Комментарий = Стр.Комментарий Тогда
										
					// +Шейко ОЕ [Ticket#0204385] Личные сообщения пользователям
					ДатаСообщения = ТекущаяДата();
					АвторСообщения = Пользователи.ТекущийПользователь();
					ТекстСообщения = Стр.Комментарий;
					ГУИДСообщения = Новый УникальныйИдентификатор();
					
					ГУИДТемы = Новый УникальныйИдентификатор;
					
					РассылкаПоЛичнымЦелям.СформироватьЛичноеСообщение(ГУИДТемы, , Ссылка, ДатаСообщения, АвторСообщения, ТекстСообщения, , ГУИДСообщения, Стр.Исполнитель);
					// -Шейко ОЕ [Ticket#0204385] Личные сообщения пользователям
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// определяем текущее состояние. для нас это первое состояние не в "выполнено"
	//Для каждого Состояние из Состояния Цикл
	//	Если Состояние.Статус <> Перечисления.СтатусыЭтапов.Выполнен Тогда
	//		ТекущееСостояние = Состояние.Состояние;
	//		Прервать;
	//	КонецЕсли;
	//КонецЦикла;
		
	// - Состояния
	
	// SIV + 15-03-21 Информирование об аннулировании документов
	
	Если ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование И НЕ ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована И НЕ АвторИсходногоДокументаПроинформирован Тогда
		
		// первичная проверка на то, что мы вообще можем что-то отправить
		УчетнаяЗаписьПоУмолчанию = РаботаСПочтовымиСообщениями.ПроверитьСистемнаяУчетнаяЗаписьДоступна();
		
		Если УчетнаяЗаписьПоУмолчанию Тогда 
			
			АдресДублированияУведомлений = Константы.АдресДублированияОповещенийОЗадачах.Получить();
			СистемнаяУчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
			
			Тема = "DATACore: Аннулирован документ " + ИсходныйДокументРеализации;
			//++ Зубов, Ticket#0235758, 29.06.2021
			//ТекстСообщения = "Информируем об аннулировании документа " + ИсходныйДокументРеализации + " пользователем " + Пользователи.ТекущийПользователь() + " в " + Создано;
			ТекстСообщения = "Информируем об аннулировании документа " + ИсходныйДокументРеализации + ", для контрагента "+Контрагент+" по договору №"+ДоговорКонтрагента.Номер + " пользователем " + Пользователи.ТекущийПользователь() + " в " + Создано;
			//-- Зубов, Ticket#0235758, 29.06.2021
			ПолучателиПисьма = Новый Массив;
			
			ПараметрыОтправкиПисьма = новый Структура;
			ПараметрыОтправкиПисьма.Вставить("ТипТекста", "HTML");
			
			Если ЗначениеЗаполнено(АдресДублированияУведомлений) Тогда
				Для каждого Адрес из СтрРазделить(АдресДублированияУведомлений, ";", Ложь) Цикл
					ПолучателиПисьма.Добавить(Новый Структура("Представление, Адрес", "Адрес отслеживания", Адрес));
				КонецЦикла;
			КонецЕсли;
			
			//ДИТ Шевченко А.В. Bug 102505 TA 102509 11.02.2025
			АвторДляПолученияАдреса = ИсходныйДокументРеализации.Автор;
			
			Если ЗначениеЗаполнено(ИсходныйДокументРеализации.Автор) Тогда
				Если ИсходныйДокументРеализации.Автор.Недействителен Тогда
					АвторДляПолученияАдреса = ПолучитьНепосредственногоРуководителя(ИсходныйДокументРеализации.Автор);
				КонецЕсли;	
			КонецЕсли;	
			//ДИТ Шевченко А.В. Bug 102505 TA 102509 11.02.2025
			
			//EMAIL = Пользователи_sd_сервер.ПолучитьEMAILПользователя(Пользователи_sd_сервер.ПодобратьЗамещение(ИсходныйДокументРеализации.Автор, ТекущаяДата())); //ДИТ Шевченко А.В. Bug 102505 TA 102509 11.02.2025
			EMAIL = Пользователи_sd_сервер.ПолучитьEMAILПользователя(Пользователи_sd_сервер.ПодобратьЗамещение(АвторДляПолученияАдреса, ТекущаяДата()));
			Если ЗначениеЗаполнено(EMAIL) Тогда
				ПолучателиПисьма.Добавить(Новый Структура("Представление, Адрес", Строка(ИсходныйДокументРеализации.Автор), EMAIL));
			КонецЕсли;
			
			ПараметрыОтправкиПисьма.Вставить("Тема", Тема);
			ПараметрыОтправкиПисьма.Вставить("Тело", ТекстСообщения);
			
			ПараметрыОтправкиПисьма.Вставить("Кому", ПолучателиПисьма);
			
			РЕЗУЛЬТАТ = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(СистемнаяУчетнаяЗапись, ПараметрыОтправкиПисьма);
			
			Если РЕЗУЛЬТАТ <> неопределено Тогда
				АвторИсходногоДокументаПроинформирован = Истина;
			КонецЕсли;
			
