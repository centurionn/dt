Процедура ПровестиПоИсторииКорректировокРеализации()
	ИсторияКоррРеализации = Движения.ИсторияКорректировокРеализаций;
	Движения.ИсторияКорректировокРеализаций.Очистить();
	//Евросиб Каблов 22.07.2025 ( #114890 Записываем сразу. Нужно для формирования движений Фактические доходы
	//ИсторияКоррРеализации.Записывать = Истина;
	//Евросиб Каблов 22.07.2025 )
	
	ПервичныйДокумент = ИсправляемыйДокументРеализации;
	Продолжать = Истина;
	Пока Продолжать Цикл
		Если ТипЗнч(ПервичныйДокумент)=Тип("ДокументСсылка.РеализацияТоваровУслуг") ИЛИ ТипЗнч(ПервичныйДокумент)=Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
			Продолжать = Ложь;
		ИначеЕсли ПервичныйДокумент.ВидОперации=Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение Тогда
			Продолжать = Ложь;
		Иначе
			ПервичныйДокумент = ПервичныйДокумент.ИсправляемыйДокументРеализации;
		КонецЕсли;
	КонецЦикла;
	ИспрДокумент = ИсправляемыйДокументРеализации;
	Продолжать = Истина;
	МассивДокументовДвижений = Новый Массив;
	Пока Продолжать Цикл		
		МассивДокументовДвижений.Добавить(ИспрДокумент);
		//Евросиб Каблов 15.12.2022 ( 62714
		//Если ТипЗнч(ИспрДокумент)=Тип("ДокументСсылка.РеализацияТоваровУслуг") ИЛИ ТипЗнч(ПервичныйДокумент)=Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
		Если ТипЗнч(ИспрДокумент)=Тип("ДокументСсылка.РеализацияТоваровУслуг") Или ТипЗнч(ИспрДокумент)=Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
		//Евросиб Каблов 15.12.2022 )
			Продолжать = Ложь;
		ИначеЕсли ИспрДокумент.ВидОперации=Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение Тогда
			Продолжать = Ложь;
		Иначе
			ИспрДокумент = ИспрДокумент.ИсправляемыйДокументРеализации;
		КонецЕсли;
	КонецЦикла;
	ДокументовВОчереди = МассивДокументовДвижений.Количество();
	Пока НЕ ДокументовВОчереди = 0 Цикл
		Движение = ИсторияКоррРеализации.Добавить();
		Движение.Период = Дата;
		
		Движение.Активность = Истина;
		Движение.ВидОперации = ВидОперации;
		Движение.ПервичныйДокумент = ПервичныйДокумент;
		Движение.КорректируемыйДокумент = МассивДокументовДвижений[ДокументовВОчереди-1];
		
		ДокументовВОчереди = ДокументовВОчереди-1;
	КонецЦикла;
	
	//Евросиб Каблов 22.07.2025 ( #114890 Записываем сразу. Нужно для формирования движений Фактические доходы
	ИсторияКоррРеализации.Записать();
	//Евросиб Каблов 22.07.2025 )
	
КонецПроцедуры
