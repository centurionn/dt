Функция НайтиКорректировкуНаПТУ(ОтчетКомитенту)

	Док = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОтчетКомитентуОПродажахПоставщики.Ссылка КАК Ссылка,
	               |	ОтчетКомитентуОПродажахПоставщики.Партия КАК Партия
	               |ПОМЕСТИТЬ ВсеПартии
	               |ИЗ
	               |	Документ.ОтчетКомитентуОПродажах.Поставщики КАК ОтчетКомитентуОПродажахПоставщики
	               |ГДЕ
	               |	ОтчетКомитентуОПродажахПоставщики.Ссылка = &ОтчетКомитенту
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОтчетКомитентуОПродажахПоставщики.Ссылка,
	               |	ОтчетКомитентуОПродажахПоставщики.Партия
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВсеПартии.Ссылка КАК Ссылка,
	               |	ВсеПартии.Партия КАК ПТУ,
	               |	КорректировкаПоступления.Ссылка КАК ДокКоррПТУ,
	               |	КорректировкаПоступления.ДатаИсправленияИсходногоДокумента КАК ДатаИсправленияИсходногоДокумента,
	               |	КорректировкаПоступления.Дата КАК Дата
	               |ИЗ
	               |	ВсеПартии КАК ВсеПартии
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаПоступления КАК КорректировкаПоступления
	               |		ПО ВсеПартии.Партия = КорректировкаПоступления.ДокументПоступления
	               |			И (НЕ КорректировкаПоступления.ПометкаУдаления)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаИсправленияИсходногоДокумента УБЫВ";
	
	Запрос.УстановитьПараметр("ОтчетКомитенту", ОтчетКомитенту);
	//Запрос.Выполнить().Выгрузить(); // Запрос.ВыполнитьПакетСПромежуточнымиДанными()[0].Выгрузить();
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
	
		Док = Выборка.ДокКоррПТУ; 
	
	КонецЕсли;  
	
	Возврат Док;

КонецФункции // НайтиКорректировкуНаПТУ()

