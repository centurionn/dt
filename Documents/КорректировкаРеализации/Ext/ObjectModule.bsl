Функция НайтиКорректировкуОтПоставщика(СчетФактура,ОтчетКомитенту)
	СтрОтчета = ОтчетКомитенту.Поставщики.НАйти(СчетФактура,"СчетФактура");
	Если СтрОтчета <> Неопределено тогда
		Партия = СтрОтчета.Партия;
		
	Иначе
		Сообщить("Не найден документ от поставщика к указанной счет-фактуре в отчете комитенту!");
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	КорректировкаПоступления.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Документ.КорректировкаПоступления КАК КорректировкаПоступления
	                      |ГДЕ
	                      |	КорректировкаПоступления.ДокументПоступления = &ДокументПоступления");	
	Запрос.УстановитьПараметр("ДокументПоступления", Партия);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДокКорр = Выборка.Ссылка;
	Иначе
		ДокКорр = Неопределено;
	КонецЕсли;
	
	Возврат ДокКорр;
КонецФункции


Функция НайтиСтаршийНомерСчетФактуры()
	НомерСФ = "";
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	МАКСИМУМ(СчетФактураВыданный.Номер) КАК Номер
	                      |ПОМЕСТИТЬ МаксНомерСФАкта
	                      |ИЗ
	                      |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	                      |ГДЕ
	                      |	ГОД(СчетФактураВыданный.Дата) = &ТекущийГод
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	МАКСИМУМ(КорректировкаРеализации.Номер)
	                      |ИЗ
	                      |	Документ.КорректировкаРеализации КАК КорректировкаРеализации
	                      |ГДЕ
	                      |	ГОД(КорректировкаРеализации.Дата) = &ТекущийГод
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	МАКСИМУМ(МаксНомерСФАкта.Номер) КАК Номер
	                      |ИЗ
	                      |	МаксНомерСФАкта КАК МаксНомерСФАкта");
	Запрос.УстановитьПараметр("ТекущийГод",Год(Дата));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НомерСФ = Выборка.Номер;
	КонецЦикла;
	Возврат НомерСФ;
	
	
КонецФункции

Функция ПреобразоватьНомерВСтроку(СлНомер)
	СтрокаНомера = Строка(СлНомер);
	Пока СтрДлина(СтрокаНомера)< 9 Цикл
		СтрокаНомера = "0"+СтрокаНомера;
	КонецЦикла;
	
	Возврат СтрокаНомера;
КонецФункции

