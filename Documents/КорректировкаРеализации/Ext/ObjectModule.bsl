Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда	
		Возврат;	
	КонецЕсли;
	
	//Евросиб Каблов 28.07.2020 ( При установке признака Выставлен, не нужно записывать Счет-фактуру
	ЗапретитьЗаписыватьСчетФактуру = Неопределено;
	Если Не ДополнительныеСвойства.Свойство("ЗапретитьЗаписыватьСчетФактуру", ЗапретитьЗаписыватьСчетФактуру) Тогда
		ЗапретитьЗаписыватьСчетФактуру = Ложь;
	КонецЕсли;
	
	Если Не ЗапретитьЗаписыватьСчетФактуру Тогда
	//Евросиб Каблов 28.07.2020 )
		Счетфактура = БухгалтерскийУчетОбщиеПроцедурыСервер.НайтиПодчиненныйСчетФактуру(ЭтотОбъект.Ссылка,"СчетФактураВыданный");
		Если СчетФактура<>Неопределено Тогда
			ОбСчФ = СчетФактура.ПолучитьОбъект();
			//Евросиб Каблов 28.07.2020 ( 
			Если ОбСчф.Выставлен Тогда
				СнятьПризнакВыставленУСчетаФактуры = Неопределено;
				Если ДополнительныеСвойства.Свойство("СнятьПризнакВыставленУСчетаФактуры", СнятьПризнакВыставленУСчетаФактуры) И СнятьПризнакВыставленУСчетаФактуры Тогда
					ОбСчф.Выставлен = Ложь;
					ОбСчф.ДатаВыставления = '00010101';
				КонецЕсли;
			КонецЕсли;
			//Евросиб Каблов 28.07.2020 )
			БухгалтерскийУчетОбщиеПроцедурыСервер.ЗаполнитьРеквизитыСчФПоОснованию(ЭтотОбъект.Ссылка,ОбСчФ);
			ОбСчФ.Записать();
		КонецЕсли;
	//Евросиб Каблов 28.07.2020 (
	КонецЕсли;
	//Евросиб Каблов 28.07.2020 )
	
	КорректировкиРТУСервер.УстановитьРазрешениеВводаКорректировок(ИсходныйДокументРеализации, Ложь, Ложь, Ложь);   
	
	// ДИТ US 57674 ТА 79279 Сержантова А.С. Начало: 27.03.2024
	Если не Отказ и Проведен и ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование Тогда
		МаршрутизацияСервер.СформироватьЗадачуУдаленияСчета(ДокументРеализации);
	КонецЕсли;
	// ДИТ US 57674 ТА 79279 Сержантова А.С. Конец: 27.03.2024
	
	
	//Евросиб(ДИТ), Беляев СЮ, US 93144 / TA 95492, 29-11-2024, начало
	ВидЗадолженностиРеализации = РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ПолучитьВидЗадолженностиПоДокументу(ИсходныйДокументРеализации);
	РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ЗаписатьВидЗадолженностиПоДокументу(ЭтотОбъект.Ссылка, ВидЗадолженностиРеализации);
	//Евросиб(ДИТ), Беляев СЮ, US 93144 / TA 95492, 29-11-2024, конец
	
	//ДИТ Шевченко А.В. 17.01.2024 US 91366 TA 93137 -начало
	Если ДополнительныеСвойства.Свойство("ТранзитДляКлиента") Тогда
		РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ЗаписатьТранзитДляКлиентапоДокументу(Ссылка, ДополнительныеСвойства.ТранзитДляКлиента);
	КонецЕсли;
	//ДИТ Шевченко А.В. 17.01.2024 US 91366 TA 93137 -конец
	
КонецПроцедуры

