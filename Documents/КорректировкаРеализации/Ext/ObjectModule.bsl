Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Автор 	= Пользователи.ТекущийПользователь();
	ЦФО 	= Автор.ЦФО;
	Создано = ТекущаяДата();
	
	Организация 	= Константы.ОсновнаяОрганизация.Получить();
	ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
	Маршрутизировать= Константы.МаршрутизироватьКорректировкуРеализации.Получить();
	//Евросиб Каблов 09.04.2025 ( #105407
	//ПериодВО 		= КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериод(Организация);
	ПериодВО 		= КонтрольДоступностиДокументов_сервер.ПолучитьОткрытыйПериодДоходов(Организация);
	//Евросиб Каблов 09.04.2025 )
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		// Заполнение шапки
		Организация 			= ДанныеЗаполнения.Организация;
		ПодразделениеОрганизации= ДанныеЗаполнения.ПодразделениеОрганизации;
		ВалютаДокумента 		= ДанныеЗаполнения.ВалютаДокумента;
		КратностьВзаиморасчетов = ДанныеЗаполнения.КратностьВзаиморасчетов;
		КурсВзаиморасчетов 		= ДанныеЗаполнения.КурсВзаиморасчетов;
		Контрагент 				= ДанныеЗаполнения.Контрагент;
		ДоговорКонтрагента 		= ДанныеЗаполнения.ДоговорКонтрагента;
		Грузоотправитель 		= ДанныеЗаполнения.Грузоотправитель;
		Грузополучатель 		= ДанныеЗаполнения.Грузополучатель;
		АдресДоставки 			= ДанныеЗаполнения.АдресДоставки;
		БанковскийСчетОрганизации = ДанныеЗаполнения.БанковскийСчетОрганизации;
		//ДИТ, Беляев СЮ, BUG 57827, 26-04-2023, начало
		ДатаКурса				= ДанныеЗаполнения.ДатаКурса;
		//ДИТ, Беляев СЮ, BUG 57827, 26-04-2023, коенц
		
		ВидОперации 					= Перечисления.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки;
		ИсправляемыйДокументРеализации 	= ДанныеЗаполнения.Ссылка;
		ИсходныйДокументРеализации 		= ДанныеЗаполнения.Ссылка;
		ДокументРеализации 				= ДанныеЗаполнения.Ссылка;
		
		Руководитель 					= ДанныеЗаполнения.Руководитель;
		ГлавныйБухгалтер 				= ДанныеЗаполнения.ГлавныйБухгалтер;
		ЗаРуководителяНаОсновании 		= ДанныеЗаполнения.ЗаРуководителяНаОсновании;
		ЗаГлавногоБухгалтераНаОсновании = ДанныеЗаполнения.ЗаГлавногоБухгалтераНаОсновании;
		
		УчитыватьНДС 			= ДанныеЗаполнения.УчитыватьНДС;
		СуммаВключаетНДС 		= ДанныеЗаполнения.СуммаВключаетНДС;
		СуммаДокумента 			= ДанныеЗаполнения.СуммаДокумента;
		СуммаНДСДокумента 		= ДанныеЗаполнения.Товары.Итог("СуммаНДС") + ДанныеЗаполнения.Услуги.Итог("СуммаНДС");
		
		Ответственный 			= ДанныеЗаполнения.Ответственный;
		Комментарий 			= ДанныеЗаполнения.Комментарий;
		
		Сделка 		= ДанныеЗаполнения.Услуги[0].Сделка;
		
		ПоставщикВУ = ДанныеЗаполнения.ПоставщикВУ;
		ПокупательВУ= ДанныеЗаполнения.ПокупательВУ;
		//ДоверенностьЗаРуководителя = ДанныеЗаполнения.ДоверенностьЗаРуководителя;
		//ДоверенностьЗаГлБухгалтера = ДанныеЗаполнения.ДоверенностьЗаГлБухгалтера;
		Для Каждого ТекСтрокаТовары Из ДанныеЗаполнения.Товары Цикл
			НоваяСтрока = Товары.Добавить();
			НоваяСтрока.КоличествоДоИзменения = ТекСтрокаТовары.Количество;
			НоваяСтрока.Количество = ТекСтрокаТовары.Количество;
			НоваяСтрока.Номенклатура = ТекСтрокаТовары.Номенклатура;
			НоваяСтрока.СуммаДоИзменения = ТекСтрокаТовары.Сумма;
			НоваяСтрока.Сумма = ТекСтрокаТовары.Сумма;
			НоваяСтрока.СуммаНДСДоИзменения = ТекСтрокаТовары.СуммаНДС;
			НоваяСтрока.СуммаНДС = ТекСтрокаТовары.СуммаНДС;
			НоваяСтрока.ЦенаДоИзменения = ТекСтрокаТовары.Цена;
			НоваяСтрока.Цена = ТекСтрокаТовары.Цена;
			НоваяСтрока.СтавкаНДСДоИзменения = ТекСтрокаТовары.СтавкаНДС;
			НоваяСтрока.СтавкаНДС = ТекСтрокаТовары.СтавкаНДС;
		КонецЦикла;
		Для Каждого ТекСтрокаУслуги Из ДанныеЗаполнения.Услуги Цикл
			НоваяСтрока = Услуги.Добавить(); 
			//Субботин исправление бага 130097 26.02.2026 Начало
            ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрокаУслуги);
			//ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрокаУслуги,, "СуммаБезНалога, СуммаНДСРуб, ВсегоСНДС");
			//Субботин исправление бага 130097 26.02.2026
			
			НоваяСтрока.КоличествоДоИзменения = ТекСтрокаУслуги.Количество;
			//НоваяСтрока.Количество = ТекСтрокаУслуги.Количество;
			//НоваяСтрока.Номенклатура = ТекСтрокаУслуги.Номенклатура;
			НоваяСтрока.СодержаниеДоИзменения = ТекСтрокаУслуги.Содержание;
			//НоваяСтрока.Содержание = ТекСтрокаУслуги.Содержание;
			НоваяСтрока.СуммаДоИзменения = ТекСтрокаУслуги.Сумма;
			//НоваяСтрока.Сумма = ТекСтрокаУслуги.Сумма;
			НоваяСтрока.СуммаНДСДоИзменения = ТекСтрокаУслуги.СуммаНДС;
			//НоваяСтрока.СуммаНДС = ТекСтрокаУслуги.СуммаНДС;
			НоваяСтрока.ЦенаДоИзменения = ТекСтрокаУслуги.Цена;
			//НоваяСтрока.Цена = ТекСтрокаУслуги.Цена;
			НоваяСтрока.СтавкаНДСДоИзменения = ТекСтрокаУслуги.СтавкаНДС;			
			//НоваяСтрока.СтавкаНДС = ТекСтрокаУслуги.СтавкаНДС;
			//НоваяСтрока.СтрокаДоходовСделки = ТекСтрокаУслуги.СтрокаДоходовСделки;
			НоваяСтрока.ЕстьВДокументеРеализации = Истина;
			//Евросиб Каблов 07.11.2022 ( 54532
			НоваяСтрока.ВидЗадолженности = ТекСтрокаУслуги.ВидЗадолженности;
			//Евросиб Каблов 07.11.2022 )
			//Евросиб Каблов 14.05.2021 ( Ticket#0230505
			НоваяСтрока.Всего = ?(СуммаВключаетНДС, НоваяСтрока.Сумма, НоваяСтрока.Сумма + НоваяСтрока.СуммаНДС);
			НоваяСтрока.ВсегоДоИзменения = ?(СуммаВключаетНДС, НоваяСтрока.СуммаДоИзменения, НоваяСтрока.СуммаДоИзменения + НоваяСтрока.СуммаНДСДоИзменения);			
			//Евросиб Каблов 14.05.2021 ) 
			// Субботин TASK 72390 24.07.2023 Начало 
			НоваяСтрока.СуммаБезНалогаДоКорректировки 	= ТекСтрокаУслуги.СуммаБезНалога;
			НоваяСтрока.СтавкаНДСРубДоКорректировки 	= ТекСтрокаУслуги.СтавкаНДСРуб;
			НоваяСтрока.СуммаНДСРубДоКорректировки 		= ТекСтрокаУслуги.СуммаНДСРуб;
			НоваяСтрока.ВсегоСНДСДоКорректировки 		= ТекСтрокаУслуги.ВсегоСНДС;
			// Субботин TASK 72390 24.07.2023  Конец
			////Субботин исправление бага 130097 26.02.2026 Начало
			//НоваяСтрока.СуммаБезНалога = Валюта_сервер.ПересчитатьПоКурсу(НоваяСтрока.Сумма, ВалютаДокумента, РегВалюта, ДатаКурса);
			//НоваяСтрока.СуммаНДСРуб =  Валюта_сервер.ПересчитатьПоКурсу(НоваяСтрока.СуммаНДС, ВалютаДокумента, РегВалюта, ДатаКурса);
			//НоваяСтрока.ВсегоСНДС =    Валюта_сервер.ПересчитатьПоКурсу(НоваяСтрока.Всего, ВалютаДокумента, РегВалюта, ДатаКурса);
			////Субботин исправление бага 130097 26.02.2026

		КонецЦикла;
		Для Каждого ТекСтрокаУслуги Из ДанныеЗаполнения.АгентскиеУслуги Цикл
			НоваяСтрока = АгентскиеУслуги.Добавить();
			НоваяСтрока.КоличествоДоИзменения = ТекСтрокаУслуги.Количество;
			НоваяСтрока.Количество = ТекСтрокаУслуги.Количество;
			НоваяСтрока.Номенклатура = ТекСтрокаУслуги.Номенклатура;
			НоваяСтрока.СодержаниеДоИзменения = ТекСтрокаУслуги.Содержание;
			НоваяСтрока.Содержание = ТекСтрокаУслуги.Содержание;
			НоваяСтрока.СуммаДоИзменения = ТекСтрокаУслуги.Сумма;
			НоваяСтрока.Сумма = ТекСтрокаУслуги.Сумма;
			НоваяСтрока.СуммаНДСДоИзменения = ТекСтрокаУслуги.СуммаНДС;
			НоваяСтрока.СуммаНДС = ТекСтрокаУслуги.СуммаНДС;
			НоваяСтрока.ЦенаДоИзменения = ТекСтрокаУслуги.Цена;
			НоваяСтрока.Цена = ТекСтрокаУслуги.Цена;
			НоваяСтрока.СтавкаНДСДоИзменения = ТекСтрокаУслуги.СтавкаНДС;
			НоваяСтрока.СтавкаНДС = ТекСтрокаУслуги.СтавкаНДС;
			НоваяСтрока.Контрагент = ТекСтрокаУслуги.КОнтрагент;
			НоваяСтрока.ДоговорКонтрагента = ТекСтрокаУслуги.ДоговорКонтрагента;
			НоваяСтрока.ЕстьВДокументеРеализации = Истина;
		КонецЦикла;

		Для каждого ТекСтрокаУслуги Из ДанныеЗаполнения.РасшифровкаУслугПоТС Цикл
		
			НовСтр = РасшифровкаУслугПоТС.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, ТекСтрокаУслуги);
			НовСтр.ЦенаДоИзменения 					= ТекСтрокаУслуги.Цена;
			НовСтр.СуммаДоИзменения 				= ТекСтрокаУслуги.Сумма;
			НовСтр.СтавкаНДСДоИзменения 			= ТекСтрокаУслуги.СтавкаНДС;
			НовСтр.СуммаНДСДоИзменения 				= ТекСтрокаУслуги.СуммаНДС;
			НовСтр.СтрокаДоходовСделкиДоИзменения	= ТекСтрокаУслуги.СтрокаДоходовСделки;
		
		КонецЦикла; 
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		Организация 			= ДанныеЗаполнения.Организация;
		ПодразделениеОрганизации= ДанныеЗаполнения.ПодразделениеОрганизации;
		ВалютаДокумента 		= ДанныеЗаполнения.ВалютаДокумента;
		КратностьВзаиморасчетов = ДанныеЗаполнения.КратностьВзаиморасчетов;
		КурсВзаиморасчетов 		= ДанныеЗаполнения.КурсВзаиморасчетов;
		Контрагент 				= ДанныеЗаполнения.Контрагент;
		ДоговорКонтрагента 		= ДанныеЗаполнения.ДоговорКонтрагента;
		Грузоотправитель 		= ДанныеЗаполнения.Грузоотправитель;
		Грузополучатель 		= ДанныеЗаполнения.Грузополучатель;
		АдресДоставки 			= ДанныеЗаполнения.АдресДоставки;
		БанковскийСчетОрганизации = ДанныеЗаполнения.БанковскийСчетОрганизации;
		//ДИТ, Беляев СЮ, BUG 57827, 26-04-2023, начало
		ДатаКурса				= ДанныеЗаполнения.ДатаКурса;
		//ДИТ, Беляев СЮ, BUG 57827, 26-04-2023, коенц
		
		ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение;
		ИсправляемыйДокументРеализации = ДанныеЗаполнения.Ссылка;
		ИсходныйДокументРеализации = ДанныеЗаполнения.ИсходныйДокументРеализации;
		ДокументРеализации = ДанныеЗаполнения.Ссылка;
		
		Руководитель = ДанныеЗаполнения.Руководитель;
		ГлавныйБухгалтер = ДанныеЗаполнения.ГлавныйБухгалтер;
		ЗаРуководителяНаОсновании = ДанныеЗаполнения.ЗаРуководителяНаОсновании;
		ЗаГлавногоБухгалтераНаОсновании = ДанныеЗаполнения.ЗаГлавногоБухгалтераНаОсновании;
		
		УчитыватьНДС 		= ДанныеЗаполнения.УчитыватьНДС;
		СуммаВключаетНДС 	= ДанныеЗаполнения.СуммаВключаетНДС;
		СуммаДокумента 		= ДанныеЗаполнения.СуммаДокумента;
		СуммаНДСДокумента 	= ДанныеЗаполнения.Товары.Итог("СуммаНДС") + ДанныеЗаполнения.Услуги.Итог("СуммаНДС");
		
		Ответственный = ДанныеЗаполнения.Ответственный;
		
		Комментарий = ДанныеЗаполнения.Комментарий;
		
		ПоставщикВУ = ДанныеЗаполнения.ПоставщикВУ;
		ПокупательВУ = ДанныеЗаполнения.ПокупательВУ;		
		Сделка 		= ДанныеЗаполнения.Сделка; //ДИТ Шевченко А.В. 58535 22.10.2022
		Для Каждого ТекСтрокаТовары Из ДанныеЗаполнения.Товары Цикл
			НоваяСтрока = Товары.Добавить();
			НоваяСтрока.КоличествоДоИзменения = ТекСтрокаТовары.Количество;
			НоваяСтрока.КоличествоДоКорректировки = ТекСтрокаТовары.КоличествоДоИзменения;
			НоваяСтрока.Количество = ТекСтрокаТовары.Количество;
			НоваяСтрока.Номенклатура = ТекСтрокаТовары.Номенклатура;
			НоваяСтрока.СуммаДоИзменения = ТекСтрокаТовары.Сумма;
			НоваяСтрока.СуммаДоКорректировки = ТекСтрокаТовары.СуммаДоИзменения;
			НоваяСтрока.Сумма = ТекСтрокаТовары.Сумма;
			НоваяСтрока.СуммаНДСДоИзменения = ТекСтрокаТовары.СуммаНДС;
			НоваяСтрока.СуммаНДСДоКорректировки = ТекСтрокаТовары.СуммаНДСДоИзменения;
			НоваяСтрока.СуммаНДС = ТекСтрокаТовары.СуммаНДС;
			НоваяСтрока.ЦенаДоИзменения = ТекСтрокаТовары.Цена;
			НоваяСтрока.ЦенаДоКорректировки = ТекСтрокаТовары.ЦенаДоИзменения;
			НоваяСтрока.Цена = ТекСтрокаТовары.Цена;
			НоваяСтрока.СтавкаНДСДоИзменения = ТекСтрокаТовары.СтавкаНДС;
			НоваяСтрока.СтавкаНДС = ТекСтрокаТовары.СтавкаНДС;
		КонецЦикла;
		Для Каждого ТекСтрокаУслуги Из ДанныеЗаполнения.Услуги Цикл
			НоваяСтрока = Услуги.Добавить();
			НоваяСтрока.КоличествоДоИзменения = ТекСтрокаУслуги.Количество;
			НоваяСтрока.КоличествоДоКорректировки = ТекСтрокаУслуги.КоличествоДоИзменения;
			НоваяСтрока.Количество = ТекСтрокаУслуги.Количество;
			НоваяСтрока.Номенклатура = ТекСтрокаУслуги.Номенклатура;
			НоваяСтрока.СодержаниеДоИзменения = ТекСтрокаУслуги.Содержание;
			НоваяСтрока.Содержание = ТекСтрокаУслуги.Содержание;
			НоваяСтрока.СуммаДоИзменения = ТекСтрокаУслуги.Сумма;
			//Евросиб Каблов 27.08.2025 ( #114890
			//НоваяСтрока.СуммаДоКорректировки = ТекСтрокаУслуги.СуммаДоИзменения;
			НоваяСтрока.СуммаДоКорректировки = ТекСтрокаУслуги.Сумма;
			//Евросиб Каблов 27.08.2025 ) #114890
			НоваяСтрока.Сумма = ТекСтрокаУслуги.Сумма;
			НоваяСтрока.СуммаНДСДоИзменения = ТекСтрокаУслуги.СуммаНДС;
			//Евросиб Каблов 27.08.2025 ( #114890
			//НоваяСтрока.СуммаНДСДоКорректировки = ТекСтрокаУслуги.СуммаНДСДоИзменения;
			НоваяСтрока.СуммаНДСДоКорректировки = ТекСтрокаУслуги.СуммаНДС;
