Функция ПечатьПФ_Аннулирование(МасДокументов, ПараметрыПечати, КоллекцияПечатныхФорм, ИмяМакета, СинонимМакета, ОбъектыПечати, ПараметрыВывод) Экспорт //Евросиб Литвинов 26.05.21 #34980
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ЭкземпляровНаСтранице = 1;
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.КорректировкаРеализации.ПФ_MXL_ПисьмоОбАннулировании");
	
	ОблШапка = Макет.ПолучитьОбласть("ОбластьШапка");
	//Евросиб Максимова 02062021 #0233061	
	//ОблДанные= Макет.ПолучитьОбласть("ОбластьДанные");
	//Евросиб Максимова 02062021 #0233061
	ОблПодвал= Макет.ПолучитьОбласть("ОбластьПодвал");
	ОблОснование= Макет.ПолучитьОбласть("ОбластьОснование");
			
	Для каждого Документ из МасДокументов Цикл
		//Евросиб Максимова 02062021 #0233061
		Если ТипЗнч(Документ.ИсправляемыйДокументРеализации)=Тип("ДокументСсылка.КорректировкаРеализации") Тогда
			Если 
			Документ.ИсправляемыйДокументРеализации.ВидОперации=Перечисления.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки 
			Тогда	
			ОблДанные= Макет.ПолучитьОбласть("ОбластьДанные2");
			КорРТУ=Ложь;
		    Иначе
		    ОблДанные= Макет.ПолучитьОбласть("ОбластьДанные1");
			КорРТУ=Истина;			
		    КонецЕсли;
		Иначе
			ОблДанные= Макет.ПолучитьОбласть("ОбластьДанные");
		КонецЕсли;
		//Евросиб Максимова 02062021 #0233061

		// 1.
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ОблШапка.Параметры.КонтрагентНаименование = Документ.Контрагент.НаименованиеПолное;
		ТабличныйДокумент.Вывести(ОблШапка);
		
		// 2.
		//Евросиб Максимова 02062021 #0233061
		Если ТипЗнч(Документ.ИсправляемыйДокументРеализации)=Тип("ДокументСсылка.КорректировкаРеализации") Тогда		
		АннулированнаяСчФ = Новый Структура("Ссылка, НомерСчетФактуры, ДатаСчетФактуры, НомерСчетФактуры1, ДатаСчетФактуры1,НомерДоговора, ДатаДоговора, ДоговорКонтрагента, СуммаСчетФактуры, Валюта") ;
		Иначе	
		АннулированнаяСчФ = Новый Структура("Ссылка, НомерСчетФактуры, ДатаСчетФактуры, НомерДоговора, ДатаДоговора, ДоговорКонтрагента, СуммаСчетФактуры, Валюта") ;
		КонецЕсли;
		//Евросиб Максимова 02062021 #0233061
		
		Если Документ.ЭтоИзменениеВознаграждения Тогда
		
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	СчетФактураВыданный.Ссылка КАК Ссылка,
			|	СчетФактураВыданный.НомерДляПечати КАК НомерСчетФактуры,
			|	СчетФактураВыданный.ДатаДокумента КАК ДатаСчетФактуры,
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(&ИспДокРеализация) = ТИП(Документ.РеализацияТоваровУслуг)
			|			ТОГДА СчетФактураВыданный.ДоговорКонтрагента.Номер
			|		КОГДА ТИПЗНАЧЕНИЯ(&ИспДокРеализация) = ТИП(Документ.ОтчетКомитентуОПродажах)
			|			ТОГДА СчетФактураВыданный.ДоговорКонтрагента.Номер
			|		КОГДА ТИПЗНАЧЕНИЯ(&ИспДокРеализация) = ТИП(Документ.КорректировкаРеализации)
			|			ТОГДА СчетФактураВыданный.ДоговорКонтрагента.Номер
			|		ИНАЧЕ """"
			|	КОНЕЦ КАК НомерДоговора,
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(&ИспДокРеализация) = ТИП(Документ.РеализацияТоваровУслуг)
			|			ТОГДА СчетФактураВыданный.ДоговорКонтрагента.Дата
			|		КОГДА ТИПЗНАЧЕНИЯ(&ИспДокРеализация) = ТИП(Документ.ОтчетКомитентуОПродажах)
			|			ТОГДА СчетФактураВыданный.ДоговорКонтрагента.Дата
			|		КОГДА ТИПЗНАЧЕНИЯ(&ИспДокРеализация) = ТИП(Документ.КорректировкаРеализации)
			|			ТОГДА СчетФактураВыданный.ДоговорКонтрагента.Дата
			|		ИНАЧЕ """"
			|	КОНЕЦ КАК ДатаДоговора,
			|	СчетФактураВыданный.ДоговорКонтрагента КАК ДоговорКонтрагента,
			|	СчетФактураВыданный.ДоговорКомитента КАК ДоговорКомитента,
			|	СчетФактураВыданный.СуммаДокумента КАК СуммаСчетФактуры,
			|	СчетФактураВыданный.ВалютаДокумента.СокращенноеНаименование КАК Валюта
			|ИЗ
			|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
			|ГДЕ
			|	СчетФактураВыданный.ДокументОснование = &ИспДокРеализация
			|	И СчетФактураВыданный.Проведен";        
			
