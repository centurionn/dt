Функция ПолучитьТаблицуСведенийОтчетаАгента(Документ) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТаблицаСведений = ПечатьБухгалтерскихДокументов.ПолучитьОписаниеДокументаОтчетАгента();
	ТекстЗапроса = ТекстЗапроса_КорректировкаКОтчетуКомитента();
	
	Запрос = Новый Запрос();
	Запрос.Текст = ТекстЗапроса;	
	//<< Евросиб - Витвицкий 10.06.2019
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Документ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "ДокументОснование");			
	КонецЕсли; 
	//>> Евросиб - Витвицкий 10.06.2019	
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0395034, 22-04-2025, начало
	НеВыводитьНулевыеСуммы = Ложь;
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0395034, 22-04-2025, конец
	Если Документ.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки Тогда
	
		ПолучитьИзменения = Ложь;
		//Евросиб(ДИТ), Беляев СЮ, Ticket#0395034, 22-04-2025, начало
		НеВыводитьНулевыеСуммы = Истина;
		//Евросиб(ДИТ), Беляев СЮ, Ticket#0395034, 22-04-2025, конец
	
	ИначеЕсли Документ.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение Тогда
	
		//ДИТ Давудов М.А. US 58785 29.01.2024 Начало
		//Было:
		//ПолучитьИзменения = Истина;
		//Стало:
		ПолучитьИзменения = Ложь;
		//ДИТ Давудов М.А. US 58785 29.01.2024 Конец
	
	КонецЕсли; 
	Запрос.УстановитьПараметр("ПолучитьИзменения", ПолучитьИзменения);
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("ДатаДок",  Документ.Дата);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	Выборка = РезультатЗапроса[0].Выбрать();
	СтрокиДокумента = РезультатЗапроса[1].Выгрузить();
	СтрокиРасшифровки = РезультатЗапроса[2].Выгрузить();
	
	Пока Выборка.Следующий() Цикл
		
		СведенияОДокументе = ТаблицаСведений.Добавить();
		ЗаполнитьЗначенияСвойств(СведенияОДокументе,Выборка);
		
		//Евросиб(ДИТ), Беляев СЮ, US 92763 / TA 98182, 19-12-2024, начало
		Страхование = Ложь;
		//Евросиб(ДИТ), Беляев СЮ, US 92763 / TA 98182, 19-12-2024, конец
		
		ТаблицаДокумента = ПечатьБухгалтерскихДокументов.ПолучитьОписаниеТаблицыОтчетаАгентаОЗакупках();
		ТаблицаРасшифровки = ПечатьБухгалтерскихДокументов.ПолучитьОписаниеТаблицыРасшифровкиОтчетаАгентаОЗакупках();
		Для каждого Строка из СтрокиДокумента Цикл
			//Евросиб(ДИТ), Беляев СЮ, Ticket#0395034, 22-04-2025, начало
			Если НеВыводитьНулевыеСуммы И Строка.Сумма = 0 Тогда
				Продолжить;
			КонецЕсли;
			//Евросиб(ДИТ), Беляев СЮ, Ticket#0395034, 22-04-2025, конец
			СтрокаТаблицыДокумента = ТаблицаДокумента.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицыДокумента,Строка);
			СФПодрядчика = Строка.НомерСФПодрядчика + " от " + Формат(Строка.ДатаСФПодрядчика,"ДФ=dd.MM.yyyy");
			СтрокаТаблицыДокумента.СФПодрядчика = СФПодрядчика;
			СуммаБезНДС = Строка.Сумма - ?(Выборка.СуммаВключаетНДС,Строка.СуммаНДС,0);
			СуммаСНДС = Строка.Сумма + ?(Выборка.СуммаВключаетНДС,0,Строка.СуммаНДС);
			СтрокаТаблицыДокумента.СуммаБезНДС = СуммаБезНДС;
			СтрокаТаблицыДокумента.НДС = Строка.СуммаНДС;
			СтрокаТаблицыДокумента.СуммаСНДС = СуммаСНДС;
			//ДИТ Давудов М.А. US 58785 29.01.2024 Начало
			СуммаБезНДСДоИзменения = Строка.СуммаДоИзменения - ?(Выборка.СуммаВключаетНДС, Строка.СуммаНДСДоИзменения, 0);
			СуммаСНДСДоИзменения = Строка.СуммаДоИзменения + ?(Выборка.СуммаВключаетНДС, 0, Строка.СуммаНДСДоИзменения);
			СтрокаТаблицыДокумента.СуммаБезНДСДоИзменения = СуммаБезНДСДоИзменения;
			СтрокаТаблицыДокумента.НДСДоИзменения = Строка.СуммаНДСДоИзменения;
			СтрокаТаблицыДокумента.СуммаСНДСДоИзменения = СуммаСНДСДоИзменения;
			//ДИТ Давудов М.А. US 58785 29.01.2024 Конец
			//Евросиб(ДИТ), Беляев СЮ, US 92763 / TA 98182, 19-12-2024, начало
			Страхование = Страхование ИЛИ Строка.Страхование;
			//Евросиб(ДИТ), Беляев СЮ, US 92763 / TA 98182, 19-12-2024, конец
		КонецЦикла;
		
		Для каждого Строка из СтрокиРасшифровки Цикл
			СтрокаРасшифровки = ТаблицаРасшифровки.Добавить();
			//Евросиб Коханенко Н.А. 18.05.2023 (( #70233
			СуммаБезНДС = Строка.Сумма - ?(Выборка.СуммаВключаетНДС,Строка.СуммаНДС,0);
			СуммаСНДС = Строка.Сумма + ?(Выборка.СуммаВключаетНДС,0,Строка.СуммаНДС);
			СтрокаРасшифровки.СуммаБезНДС = СуммаБезНДС;
			СтрокаРасшифровки.НДС = Строка.СуммаНДС;
			СтрокаРасшифровки.СуммаСНДС = СуммаСНДС;
			//Евросиб Коханенко Н.А. 18.05.2023 )) #70233 
			ЗаполнитьЗначенияСвойств(СтрокаРасшифровки,Строка);
			//ДИТ Давудов М.А. US 58785 29.01.2024 Начало
			СуммаБезНДСДоИзменения = Строка.СуммаДоИзменения - ?(Выборка.СуммаВключаетНДС, Строка.СуммаНДСДоИзменения, 0);
			СуммаСНДСДоИзменения = Строка.СуммаДоИзменения + ?(Выборка.СуммаВключаетНДС, 0, Строка.СуммаНДСДоИзменения);
			СтрокаРасшифровки.СуммаБезНДСДоИзменения = СуммаБезНДСДоИзменения;
			СтрокаРасшифровки.НДСДоИзменения = Строка.СуммаНДСДоИзменения;
			СтрокаРасшифровки.СуммаСНДСДоИзменения = СуммаСНДСДоИзменения;
			//ДИТ Давудов М.А. US 58785 29.01.2024 Конец
		КонецЦикла;
		
		СведенияОДокументе.ТаблицаДокумента =  ТаблицаДокумента;
		СведенияОДокументе.ТаблицаРасшифровки = ТаблицаРасшифровки;
		//Евросиб(ДИТ), Беляев СЮ, US 92763 / TA 98182, 19-12-2024, начало
		СведенияОДокументе.Страхование = Страхование;
		//Евросиб(ДИТ), Беляев СЮ, US 92763 / TA 98182, 19-12-2024, конец
	КонецЦикла;
	
	Возврат ТаблицаСведений;
	
КонецФункции

Функция ТекстЗапроса_КорректировкаКОтчетуКомитента()

	ТекстЗапроса = "ВЫБРАТЬ
	               |	КорректировкаРеализации.Ссылка КАК Документ,
	               |	КорректировкаРеализации.НомерДляПечати КАК НомерДокумента,
	               |	КорректировкаРеализации.ДатаДокумента КАК ДатаДокумента,
	               |	КорректировкаРеализации.ВалютаДокумента КАК Валюта,
	               |	КорректировкаРеализации.ВалютаДокумента.Код КАК ВалютаКод,
	               |	КорректировкаРеализации.ВалютаДокумента.Наименование КАК ВалютаНаименование,
	               |	КорректировкаРеализации.КурсВзаиморасчетов КАК КурсВзаиморасчетов,
	               |	КорректировкаРеализации.КратностьВзаиморасчетов КАК КратностьВзаиморасчетов,
	               |	КорректировкаРеализации.СуммаВключаетНДС КАК СуммаВключаетНДС,
	               |	ВЫБОР
	               |		КОГДА КорректировкаРеализации.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	               |			ТОГДА КорректировкаРеализации.Организация
	               |		ИНАЧЕ КорректировкаРеализации.Организация.ГоловнаяОрганизация
	               |	КОНЕЦ КАК Организация,
	               |	КорректировкаРеализации.Контрагент КАК Комитент,
	               |	КорректировкаРеализации.ДоговорКонтрагента КАК ДоговорКомитента,
	               |	КорректировкаРеализации.ДоговорКонтрагента.Номер КАК НомерДоговора,
	               |	КорректировкаРеализации.ДоговорКонтрагента.Дата КАК ДатаДоговора,
	               |	ВЫБОР
	               |		КОГДА КорректировкаРеализации.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	               |			ТОГДА КорректировкаРеализации.Организация.НаименованиеСокращенное
	               |		ИНАЧЕ КорректировкаРеализации.Организация.ГоловнаяОрганизация.НаименованиеСокращенное
	               |	КОНЕЦ КАК КраткоеНаименованиеОрг,
	               |	ВЫБОР
	               |		КОГДА КорректировкаРеализации.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	               |			ТОГДА КорректировкаРеализации.Организация.НаименованиеПолное
	               |		ИНАЧЕ КорректировкаРеализации.Организация.ГоловнаяОрганизация.НаименованиеПолное
	               |	КОНЕЦ КАК ПолноеНаименованиеОрг,
	               |	КорректировкаРеализации.Организация.Руководитель КАК РуководительОрг,
	               //ДИТ Давудов М.А. US 58785 29.01.2024 Начало
	               |	КорректировкаРеализации.Контрагент.НаименованиеПолное КАК ПолноеНаименованиеКонтрагента,
	               |	КорректировкаРеализации.ПодразделениеОрганизации.Город КАК ПодразделениеГород,
	               |	КорректировкаРеализации.ИсходныйДокументРеализации.ПравилоФормирования КАК ПравилоФормирования,
	               //ДИТ Давудов М.А. US 58785 29.01.2024 Конец
	               |	ДанныеРуководителяКонтрагентовСрезПоследних.Руководитель КАК РуководительКонтр,
	               |	КорректировкаРеализации.ДоверенностьЗаРуководителя КАК ДоверенностьЗаРуководителя,
	               |	КорректировкаРеализации.ДоверенностьЗаГлБухгалтера КАК ДоверенностьЗаГлБухгалтера,
	               |	ВЫРАЗИТЬ(КорректировкаРеализации.ИсходныйДокументРеализации КАК Документ.ОтчетКомитентуОПродажах).ДатаНачалоПериода КАК ДатаНачала,
	               |	ВЫРАЗИТЬ(КорректировкаРеализации.ИсходныйДокументРеализации КАК Документ.ОтчетКомитентуОПродажах).ДатаОкончанияПериода КАК ДатаОкончания
