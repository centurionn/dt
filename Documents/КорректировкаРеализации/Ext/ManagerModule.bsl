//Функция ПолучитьТаблицуСведенийАктаОбОказанииУслуг(Документ)
//Евросиб(ДИТ), Беляев СЮ, Ticket#0395339, 29-04-2025, установлен Экспорт
Функция ПолучитьТаблицуСведенийАктаОбОказанииУслуг(Документ) Экспорт
	
	ТаблицаСведений = ПечатьБухгалтерскихДокументов.ПолучитьОписаниеАктаОбОказанииУслуг();
	ТаблицаСведений.Колонки.Добавить("ИсправляемыйДокументРеализации");
	ТаблицаСведений.Колонки.Добавить("ИсходныйДокументРеализации");
	
	Если Документ.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки Тогда
		
		ПолучитьИзменения = Ложь;
		
	ИначеЕсли Документ.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение Тогда
		
		//ДИТ Давудов М.А. US 58785 29.01.2024 Начало
		//Было:
		//ПолучитьИзменения = Истина;
		//Стало:
		ПолучитьИзменения = Ложь;
		//ДИТ Давудов М.А. US 58785 29.01.2024 Конец
		
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.Текст = ПолучитьТекстЗапросаДляФормированияТаблицыСведенийАктаОбОказанииУслуг();
	Запрос.УстановитьПараметр("ПолучитьИзменения", ПолучитьИзменения);
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("ДатаСреза",Документ.Дата);	
	//Евросиб(ДИТ), Беляев СЮ, US 113788 / TA 113796, 04-07-2025, начало
	Запрос.УстановитьПараметр("УслугаФрахта", Константы.УслугаФрахтаДляКалькуляции.Получить());
	//Евросиб(ДИТ), Беляев СЮ, US 113788 / TA 113796, 04-07-2025, конец
	РезультатыЗапроса = Запрос.ВыполнитьПакет();

	Выборка = РезультатыЗапроса[0].Выбрать();
	СтрокиДокументов = РезультатыЗапроса[1].Выгрузить();
	СТрокиРасшифровки = РезультатыЗапроса[2].Выгрузить();
	ВалютаРегУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Пока Выборка.Следующий() Цикл
		
		СведенияОДокументе = ТаблицаСведений.Добавить();
		ЗаполнитьЗначенияСвойств(СведенияОДокументе, Выборка); 
		//Евросиб - АСуслов 13.09.2022 11:17:34 #
		//(
		ФакторингСервер.ЗаполнитьПараметрыФакторинга(СведенияОДокументе);
		//)
		//Евросиб - АСуслов 13.09.2022 11:17:34 #
		ТаблицаДокумента = ПечатьБухгалтерскихДокументов.ПолучитьОписаниеТаблицыАктаОбОказанииУслуг();
		ТаблицаРасшифровки = ПечатьБухгалтерскихДокументов.ПолучитьОписаниеТаблицыРасшифровки();

		Для Каждого Строка Из СтрокиДокументов Цикл
			СтрокаТаблицыДокумента = ТаблицаДокумента.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицыДокумента, Строка);
		КонецЦикла;
	    СведенияОДокументе.ТаблицаДокумента = ТаблицаДокумента;
		
		Для каждого Строка из СТрокиРасшифровки Цикл
			СтрТаблицы = ТаблицаРасшифровки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрТаблицы, Строка);
		КонецЦикла;
		СведенияОДокументе.ТаблицаРасшифровки =  ТаблицаРасшифровки;
		
	КонецЦикла;
	
	Возврат ТаблицаСведений;
		
КонецФункции

Функция ПолучитьТекстЗапросаДляФормированияТаблицыСведенийАктаОбОказанииУслуг()
	
	ТекстЗапроса = "ВЫБРАТЬ
					//Евросиб Литвинов ( 30.12.21 #44592 Ticket#0254477 #44587
					|	РеализацияТоваровУслуг.ДатаСоставления КАК ДатаСоставления,
					//Евросиб Литвинов) 	
	               |	РеализацияТоваровУслуг.Ссылка КАК Документ,
	               |	РеализацияТоваровУслуг.Дата КАК ДатаДляПолученияСведений,
	               |	РеализацияТоваровУслуг.НомерДляПечати КАК НомерДокумента,
	               |	РеализацияТоваровУслуг.ДатаДокумента КАК ДатаДокумента,
	               |	РеализацияТоваровУслуг.ДокументРеализации КАК ДокументОснование,
	               |	РеализацияТоваровУслуг.Грузоотправитель КАК Поставщик,
	               |	РеализацияТоваровУслуг.Контрагент КАК Контрагент,
