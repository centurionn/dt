			ПФ 		= Неопределено;
			ПФ_СФ	= Неопределено;
			ВидСчФ  = "";
			
			Если ТекДок.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование Тогда
				
				ОписаниеРасположенияПФ = "Документ.КорректировкаРеализации.ПФ_MXL_ПисьмоОбАннулировании";
				
				ИмяМакета = "ПисьмоОбАннулировании";
				СинонимМакета = "Письмо об аннулировании";
				
				МасДоков = Новый Массив;
				МасДоков.Добавить(ТекДок);
				
				ПФ = ПечатьПФ_Аннулирование(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, 
				ИмяМакета, СинонимМакета, ОбъектыПечати, ПараметрыВывода);
				
			ИначеЕсли ТипЗнч(ТекДок.ИсходныйДокументРеализации) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
			
				Если ТекДок.ЭтоИзменениеВознаграждения Тогда
					
