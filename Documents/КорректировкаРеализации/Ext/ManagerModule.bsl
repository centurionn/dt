			Строка.РазницаБезНДСУменьшение = ?(Строка.СтоимостьБезНДСДоИзменения - Строка.СтоимостьБезНДСПослеИзменения >0,Строка.СтоимостьБезНДСДоИзменения - Строка.СтоимостьБезНДСПослеИзменения,0);
