
#Область СтандартныеПроцедуры


Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Поля = Новый Массив;
	Поля.Добавить("НомерДляПечати");
	Поля.Добавить("Номер");
	Поля.Добавить("Дата");
	Поля.Добавить("ДатаДокумента");
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Номер = ?(ЗначениеЗаполнено(Данные.НомерДляПечати), Данные.НомерДляПечати, Данные.Номер);
	Дата = ?(ЗначениеЗаполнено(Данные.ДатаДокумента), Данные.ДатаДокумента, Данные.Дата);
	
	Представление = "Корректировка реализации " + Номер + " от " + Формат(Дата, "ДФ='dd.MM.yy ЧЧ:мм'");
	
КонецПроцедуры

