&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Объект.Комментарий = "Отказ" Тогда Отказ = Истина; конецЕсли;
	Если ТипЗнч(Объект.ДокументРеализации) = Тип("ДокументСсылка.РеализацияТоваровУслуг") или  ТипЗнч(Объект.ДокументРеализации) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") или  ТипЗнч(Объект.ДокументРеализации) = Тип("ДокументСсылка.СчетФактураВыданный")Тогда
		Элементы.Товары1КоличествоДоКорректировки.Видимость = Ложь;
		Элементы.Товары1СуммаДоКорректировки.Видимость = Ложь;
		Элементы.Товары1СуммаНДСДоКорректировки.Видимость = Ложь;
		Элементы.Товары1ЦенаДоКорректировки.Видимость = Ложь;
		Элементы.Товары1ВсегоДоКорректировки.Видимость = Ложь;
		//ДИТ Шевченко А.В. 18.08.2022 56137 -начало
		Элементы.Товары1СтавкаНДСДоКорректировки.Видимость = Ложь;
		//ДИТ Шевченко А.В. 18.08.2022 56137 -конец
		
		Элементы.Услуги1КоличествоДоКорректировки.Видимость = Ложь;
		Элементы.Услуги1СуммаДоКорректировки.Видимость = Ложь;
		Элементы.Услуги1СуммаНДСДоКорректировки.Видимость = Ложь;
		Элементы.Услуги1ЦенаДоКорректировки.Видимость = Ложь;
		Элементы.Услуги1ВсегоДоКорректировки.Видимость = Ложь;
		//ДИТ Шевченко А.В. 18.08.2022 56137 -начало
		Элементы.Услуги1СтавкаНДСДоКорректировки.Видимость = Ложь;
		//ДИТ Шевченко А.В. 18.08.2022 56137 -конец
		
		Элементы.АгентскиеУслуги1КоличествоДоКорректировки.Видимость = Ложь;
		Элементы.АгентскиеУслуги1СуммаДоКорректировки.Видимость = Ложь;
		Элементы.АгентскиеУслуги1СуммаНДСДоКорректировки.Видимость = Ложь;
		Элементы.АгентскиеУслуги1ЦенаДоКорректировки.Видимость = Ложь;
		Элементы.АгентскиеУслуги1ВсегоДоКорректировки.Видимость = Ложь;

	КонецЕсли;
	
	Если Объект.Товары.Количество() = 0 Тогда
		Элементы.Товары.Видимость = Ложь;
	Иначе
		Для каждого Стр из Объект.Товары Цикл
			БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(Стр,Объект.СуммаВключаетНДС);
		КонецЦикла;
		РассчитатьСуммыВсегоДоИзменения("Товары");
	КонецЕсли;
	//Евросиб Каблов 21.01.2021 ( Ticket#0219062 Ошибка при открытии документа на чтение
	//Если Объект.Услуги.Количество() = 0 Тогда
	//	Элементы.Услуги.Видимость = Ложь;
	//Иначе
	//	Для Каждого Стр из Объект.Услуги Цикл
	//		БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(Стр,Объект.СуммаВключаетНДС);
	//	КонецЦикла;
	//	РассчитатьСуммыВсегоДоИзменения("Услуги");
	//КонецЕсли;
	//Евросиб Каблов 21.01.2021 )
		Если Объект.АгентскиеУслуги.Количество() = 0 Тогда
		Элементы.АгентскиеУслуги.Видимость = Ложь;
	Иначе
		Для Каждого Стр из Объект.АгентскиеУслуги Цикл
			БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(Стр,Объект.СуммаВключаетНДС);
		КонецЦикла;
		РассчитатьСуммыВсегоДоИзменения("АгентскиеУслуги");
	КонецЕсли;

	Элементы.Валюта.Заголовок = Объект.ВалютаДокумента;
	РеквизитыСФ = БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьРеквизитыСчетФактуры(Объект,"СчетФактураВыданный");
	Если РеквизитыСФ <> Неопределено Тогда
		Элементы.СчФНадпись.Заголовок = БухгалтерскийУчетОбщиеПроцедурыКлиент.ЗаполнитьНадписьСчФ(РеквизитыСФ);
	КонецЕсли;

	Элементы.ОснованиеТекст.Видимость = (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование"));
	
	УстановитьВидимостьКолонокНДС();
	//Евросиб Каблов 14.07.2020 ( Проверку доступности по периоду перенёс в процедуру КонтрольДоступностиДокументов_сервер.ПолучитьДанныеОБлокировке. Вызывается ПриСозданииНаСервере
	//Если Не ТолькоПросмотр Тогда	
	//	ЭтаФорма.ТолькоПросмотр = ПроверкаДоступнотиПоПериоду();
	//КонецЕсли;
	//Элементы.ОбновитьОткрытыйПериод.Доступность = НЕ ПроверкаДоступнотиПоПериоду();
	//Евросиб Каблов 14.07.2020 )

//Евросиб Литвинов ( 12.11.2021 #42060 #0248963
    УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
//Евросиб Литвинов ) 12.11.2021 #42060 #0248963	
	
КонецПроцедуры

&НаСервере
Функция ПроверкаДоступнотиПоПериоду()
	Возврат КонтрольДоступностиДокументов_сервер.ДатаПопадаетВЗакрытыйПериодВыполненныхОбъемов(Объект.ПериодВО,Объект.Организация);
