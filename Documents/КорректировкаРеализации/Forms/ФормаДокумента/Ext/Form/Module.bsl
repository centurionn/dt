	обещание = ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет,60,КодВозвратаДиалога.Нет);
	Результат = Ждать обещание;	
	Если Результат = КодВозвратаДиалога.Да Тогда
		новСтрока = Объект.СчетаНаОплатуПокупателям.Добавить();
		новСтрока.СчетПокупателю = СтрокаСчета.Счет;
		новСтрока.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
		новСтрока.Сумма = 0;
		новСтрока.НомерДляПечати = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(СтрокаСчета.Счет,"НомерДляПечати");
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда 
		Возврат;
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗадатьВопросПроверкиНаПроверкуСуммАсинх(ТекстВопроса,СтрокаСчета, УжеРазнесен)

	обещание = ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет,60,КодВозвратаДиалога.Нет);
	Результат = Ждать обещание;	
	Если Результат = КодВозвратаДиалога.Да Тогда
		новСтрока = Объект.СчетаНаОплатуПокупателям.Добавить();
		новСтрока.СчетПокупателю = СтрокаСчета.Счет;
		новСтрока.Номенклатура = СтрокаСчета.Номенклатура;
		Если УжеРазнесен Тогда
			новСтрока.Сумма = СтрокаСчета.НепривязаннаяСумма;
		КонецЕсли;
		новСтрока.НомерДляПечати = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(СтрокаСчета.Счет,"НомерДляПечати");
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда 
		Возврат;
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

