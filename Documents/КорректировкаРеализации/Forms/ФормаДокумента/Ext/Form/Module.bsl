	ТранзитДляКлиента = РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ПолучитьТранзитДляКлиентаПоДокументу(Объект.Ссылка);
	Если НЕ ЗначениеЗаполнено(ТранзитДляКлиента) Тогда
		ТранзитДляКлиента = ПолучитьТранзитДляКлиентаПокументаОснования();
	КонецЕсли;
	//ДИТ Шевченко А.В. 17.01.2024 US 91366 TA 93137 -конец
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТранзитДляКлиентаПокументаОснования() //ДИТ Шевченко А.В. 17.01.2024 US 91366 TA 93137
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(Объект.ДокументРеализации) Тогда
		ДокументРеализации = Объект.ДокументРеализации;		
		Результат = РегистрыСведений.ЗначенияДополнительныхАналитикДокументов.ПолучитьТранзитДляКлиентаПоДокументу(ДокументРеализации);				
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

