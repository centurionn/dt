&НаСервере
Процедура СнятьПризнакВыгруженНаСервере()
	
	//Проверка доступности по Периоду ВО
	ДокументВЗакрытомПериоде = КонтрольДоступностиДокументов_сервер.ПроверкаДоступностиПоПериоду(Объект.Ссылка);
	Если ДокументВЗакрытомПериоде Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Редактирование документа запрещено, так как он в закрытом периоде!");
		Возврат;
	КонецЕсли;
	
	//Проверка доступности по наличию привязанных оплат
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоступлениеНаРасчетныйСчетДокументыОплаты.Ссылка КАК Ссылка,
	|	СУММА(ПоступлениеНаРасчетныйСчетДокументыОплаты.СуммаОплаты) КАК СуммаОплаты
	|ИЗ
	|	Документ.ПоступлениеНаРасчетныйСчет.ДокументыОплаты КАК ПоступлениеНаРасчетныйСчетДокументыОплаты
	|ГДЕ
	|	ПоступлениеНаРасчетныйСчетДокументыОплаты.ДокументРеализации = &ДокументРеализации
	//Евросиб Каблов 18.11.2021 (
	|	И ПоступлениеНаРасчетныйСчетДокументыОплаты.Ссылка.Проведен
	//Евросиб Каблов 18.11.2021 )
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеНаРасчетныйСчетДокументыОплаты.Ссылка
	|
	|ИМЕЮЩИЕ
	|	СУММА(ПоступлениеНаРасчетныйСчетДокументыОплаты.СуммаОплаты) <> 0";
	Запрос.УстановитьПараметр("ДокументРеализации", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() > 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запрещено редактирование документа из-за наличия привязанных оплат.");		
		Возврат;
	КонецЕсли;
	
	//Удаление признака выгрузки
	ЗаписьПротоколаОбмена = РегистрыСведений.ПротоколОбменов.СоздатьМенеджерЗаписи();
	ЗаписьПротоколаОбмена.УзелОбмена = Перечисления.УзлыОбмена.УПП;
	ЗаписьПротоколаОбмена.Объект = Объект.Ссылка;
	ЗаписьПротоколаОбмена.ДействиеПриОбмене = Перечисления.ДействияПриОбмене.ВыгрузкаДанных;
	ЗаписьПротоколаОбмена.Удалить();
	
	//Обновление информации о блокировке документа
	
	КонтрольДоступностиДокументов_сервер.ОбработатьБлокировкуЭлементовФормы(Объект.Ссылка, Элементы);
	
