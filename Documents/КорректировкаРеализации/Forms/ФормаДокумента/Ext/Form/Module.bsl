&НаКлиенте
Процедура РеквизитыПродавцаИПокупателяНажатие(Элемент)
	ОбъектА = ЭтотОбъект.Объект;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Грузоотправитель", ОбъектА.Грузоотправитель);
	ПараметрыФормы.Вставить("Грузополучатель", ОбъектА.Грузополучатель);
	ПараметрыФормы.Вставить("ГлавныйБухгалтер", ОбъектА.ГлавныйБухгалтер);
	ПараметрыФормы.Вставить("Руководитель", ОбъектА.Руководитель);
	ПараметрыФормы.Вставить("АдресДоставки", ОбъектА.АдресДоставки);
	ПараметрыФормы.Вставить("ЗаРуководителяНаОсновании", ОбъектА.ЗаРуководителяНаОсновании);
	ПараметрыФормы.Вставить("ЗаГлавногоБухгалтераНаОсновании", ОбъектА.ЗаГлавногоБухгалтераНаОсновании);
	
	ПараметрыФормы.Вставить("ДоверенностьЗаГлБухгалтера", ОбъектА.ДоверенностьЗаГлБухгалтера);
	ПараметрыФормы.Вставить("ДоверенностьЗаРуководителя", ОбъектА.ДоверенностьЗаРуководителя);
	ПараметрыФормы.Вставить("БезДоверенностей", ОбъектА.БезДоверенностей);
	ОткрытьФорму("Документ.КорректировкаРеализации.Форма.ФормаРеквизитыПродавцаИПокупателя",ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ИсточникВыбора.ИмяФормы = "Документ.КорректировкаРеализации.Форма.ФормаРеквизитыПродавцаИПокупателя" Тогда
		ОбработкаВыбораРеквизитыПродавцаИПокупателя(ЭтаФорма,ВыбранноеЗначение,ИсточникВыбора);
	КонецЕсли;
	
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.УчетНДСВДокументах" Тогда
		ОбработкаВыбораУчетНДС(ЭтаФорма,ВыбранноеЗначение,ИсточникВыбора);
	ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.КурсВалютыВДокументах" Тогда
		ОбработкаВыбораКурсыВалют(ЭтаФорма,ВыбранноеЗначение,ИсточникВыбора);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораУчетНДС(Форма, ВыбранноеЗначение, ИсточникВыбора)
	ЗаполнитьЗначенияСвойств(Объект, ВыбранноеЗначение);
	Для каждого Стр из Объект.Товары Цикл
		БухгалтерскийУчетОбщиеПроцедурыКлиент.ПересчитатьСуммыНДС(Стр,Объект.УчитыватьНДС,Объект.СуммаВключаетНДС);
		БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(Стр,Объект.СуммаВключаетНДС);
		
	КонецЦикла;
	
	Для каждого Стр из Объект.Услуги Цикл
		БухгалтерскийУчетОбщиеПроцедурыКлиент.ПересчитатьСуммыНДС(Стр,Объект.УчитыватьНДС,Объект.СуммаВключаетНДС);
		БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(Стр,Объект.СуммаВключаетНДС);

	КонецЦикла;
	Для каждого Стр из Объект.АгентскиеУслуги Цикл
		БухгалтерскийУчетОбщиеПроцедурыКлиент.ПересчитатьСуммыНДС(Стр,Объект.УчитыватьНДС,Объект.СуммаВключаетНДС);
		БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(Стр,Объект.СуммаВключаетНДС);

	КонецЦикла;

	РассчитатьСуммыВсегоПоДокументу();
	УстановитьВидимостьКолонокНДС();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораКурсыВалют(Форма, ВыбранноеЗначение, ИсточникВыбора)
	
	СтараяВалюта = Объект.ВалютаДокумента;
	СтарыйКурс = Объект.КурсВзаиморасчетов;
	СтараяКратность = Объект.КратностьВзаиморасчетов;
	
	Объект.ВалютаДокумента = ВыбранноеЗначение.ВалютаДокумента;
	Объект.КратностьВзаиморасчетов = ВыбранноеЗначение.КратностьВзаиморасчетов;
	Объект.КурсВзаиморасчетов = ВыбранноеЗначение.КурсВзаиморасчетов;
	//ДИТ, Беляев СЮ, BUG 57827, 26-04-2023, начало
	Объект.ДатаКурса = ВыбранноеЗначение.ДатаДокумента;
	//ДИТ, Беляев СЮ, BUG 57827, 26-04-2023, конец
	
	Если СтараяВалюта <> Объект.ВалютаДокумента или СтарыйКурс <> Объект.КурсВзаиморасчетов Тогда
		
		СтруктураТекущая = Новый Структура;
		СтруктураТекущая.Вставить("Валюта",СтараяВалюта);
		СтруктураТекущая.Вставить("Курс",СтарыйКурс);
		СтруктураТекущая.Вставить("Кратность",СтараяКратность);
		СтруктураНовая = Новый Структура;
		СтруктураНовая.Вставить("Валюта",Объект.ВалютаДокумента);
		СтруктураНовая.Вставить("Курс",Объект.КурсВзаиморасчетов);
		СтруктураНовая.Вставить("Кратность",Объект.КратностьВзаиморасчетов);
		
		ПересчитатьСуммыДокументаПоВалютеВзаиморасчетов(СтруктураТекущая, СтруктураНовая);
		
		РассчитатьСуммыВсегоПоДокументу();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСуммыДокументаПоВалютеВзаиморасчетов(СтруктураТекущая,СтруктураНовая)
	
	//Евросиб Каблов 09.04.2021 ( Ticket#0228336
	РеализацияСуммаВключаетНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ДокументРеализации, "СуммаВключаетНДС");
	//Евросиб Каблов 09.04.2021 )
	
	Для каждого Стр из Объект.Услуги Цикл
		
		// Вычисление предварительных всего:
		Всего = Стр.Сумма +?(Объект.СуммаВключаетНДС, 0, Стр.СуммаНДС);
		Всего = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Всего, СтруктураТекущая, СтруктураНовая);
		
		//Евросиб Каблов 09.04.2021 ( Ticket#0228336
		//ВсегоДоКорректировки= Стр.СуммаДоКорректировки +?(Объект.СуммаВключаетНДС,0,Стр.СуммаНДСДоКорректировки);
		ВсегоДоКорректировки = Стр.СуммаДоКорректировки +?(РеализацияСуммаВключаетНДС, 0, Стр.СуммаНДСДоКорректировки);
		//Евросиб Каблов 09.04.2021 )
		ВсегоДоКорректировки= РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(ВсегоДоКорректировки, СтруктураТекущая, СтруктураНовая);
		
		//Евросиб Каблов 09.04.2021 ( Ticket#0228336
		//ВсегоДоИзменения 	= Стр.СуммаДоИзменения +?(Объект.СуммаВключаетНДС,0,Стр.СуммаНДСДоИзменения);
		ВсегоДоИзменения 	= Стр.СуммаДоИзменения + ?(РеализацияСуммаВключаетНДС, 0, Стр.СуммаНДСДоИзменения);
		//Евросиб Каблов 09.04.2021 )
		ВсегоДоИзменения 	= РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(ВсегоДоИзменения, СтруктураТекущая, СтруктураНовая);
		
		// Вычисление составных сумм
		Стр.Сумма 	= ?(Объект.СуммаВключаетНДС, Всего, Всего/(1+(БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Стр.СтавкаНДС)/100)));
		Стр.СуммаНДС= ?(Объект.СуммаВключаетНДС, Всего * БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Стр.СтавкаНДС)/100, Всего - Стр.Сумма);
		Стр.Цена 	= Стр.Сумма/Стр.Количество;
		
		//Евросиб Каблов 09.04.2021 ( Ticket#0228336
		//Стр.СуммаДоКорректировки 	= ?(Объект.СуммаВключаетНДС, ВсегоДоКорректировки, ВсегоДоКорректировки/(1+(БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Стр.СтавкаНДС)/100)));
		//Стр.СуммаНДСДоКорректировки = ?(Объект.СуммаВключаетНДС,  ВсегоДоКорректировки*БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Стр.СтавкаНДС)/100, ВсегоДоКорректировки - Стр.СуммаДоКорректировки);
		Стр.СуммаДоКорректировки 	= ?(РеализацияСуммаВключаетНДС, ВсегоДоКорректировки, ВсегоДоКорректировки/(1+(БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Стр.СтавкаНДС)/100)));
		Стр.СуммаНДСДоКорректировки = ?(РеализацияСуммаВключаетНДС,  ВсегоДоКорректировки*БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Стр.СтавкаНДС)/100, ВсегоДоКорректировки - Стр.СуммаДоКорректировки);
		//Евросиб Каблов 09.04.2021 )
		Стр.ЦенаДоКорректировки 	= Стр.СуммаДоКорректировки / Стр.КоличествоДоКорректировки;
		
		//Евросиб Каблов 09.04.2021 ( Ticket#0228336
		//Стр.СуммаДоИзменения 	= ?(Объект.СуммаВключаетНДС, ВсегоДоИзменения, ВсегоДоИзменения / (1+(БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Стр.СтавкаНДС)/100)));
		//Стр.СуммаНДСДоИзменения = ?(Объект.СуммаВключаетНДС, ВсегоДоИзменения*БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Стр.СтавкаНДС)/100, ВсегоДоИзменения - Стр.СуммаДоИзменения);
		Стр.СуммаДоИзменения 	= ?(РеализацияСуммаВключаетНДС, ВсегоДоИзменения, ВсегоДоИзменения / (1+(БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Стр.СтавкаНДС)/100)));
		Стр.СуммаНДСДоИзменения = ?(РеализацияСуммаВключаетНДС, ВсегоДоИзменения*БухгалтерскийУчетОбщиеПроцедурыСервер.ПолучитьСтавкуНДС(Стр.СтавкаНДС)/100, ВсегоДоИзменения - Стр.СуммаДоИзменения);
		//Евросиб Каблов 09.04.2021 )
		Стр.ЦенаДоИзменения 	= Стр.СуммаДоИзменения / Стр.КоличествоДоИзменения;
		
		// Вычисление ВСЕГО:
		Стр.Всего 				= Стр.Сумма + ?(Объект.СуммаВключаетНДС, 0, Стр.СуммаНДС);
		//Евросиб Каблов 09.04.2021 ( Ticket#0228336
		Стр.ВсегоДоКорректировки= Стр.СуммаДоКорректировки + ?(РеализацияСуммаВключаетНДС, 0, Стр.СуммаНДСДоКорректировки);
		Стр.ВсегоДоИзменения 	= Стр.СуммаДоИзменения + ?(РеализацияСуммаВключаетНДС, 0, Стр.СуммаНДСДоИзменения);
		//Евросиб Каблов 09.04.2021 )
		
	КонецЦикла;
	
