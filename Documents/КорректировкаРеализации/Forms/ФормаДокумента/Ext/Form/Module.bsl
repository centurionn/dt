
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//Евросиб Каблов 11.07.2020 ( TASK 23506
	//Элементы.ПредупреждениеРедактирования.Видимость = КонтрольДоступностиДокументов_сервер.ДокументЗаблокирован(Объект.Ссылка);
	//Элементы.ПредупреждениеРедактирования.Заголовок = КонтрольДоступностиДокументов_сервер.ПолучитьОписаниеБлокировки();
	Если Не РольДоступна("ПолныеПрава") Тогда
		Элементы.ГруппаВыставлен.ТолькоПросмотр = Истина;
	КонецЕсли;
	//Евросиб Каблов 31.05.2021 ( Ticket#0223764
	//ОбработатьБлокировкуДокумента();
	КонтрольДоступностиДокументов_сервер.ОбработатьБлокировкуЭлементовФормы(Объект.Ссылка, Элементы);
	//Евросиб Каблов 31.05.2021 )
	//Евросиб Каблов 11.07.2020 )
	
