&НаКлиенте
Процедура РассчитатьСуммыВсегоДоИзменения(ТЧ)
	//Евросиб Каблов 09.04.2021 ( Ticket#0228336
	РеализацияСуммаВключаетНДС = ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта(Объект.ДокументРеализации, "СуммаВключаетНДС");
	//Евросиб Каблов 09.04.2021 )
	Для Каждого СтрТЧ из Объект[ТЧ] Цикл
		//Евросиб Каблов 09.04.2021 ( Ticket#0228336
		//СтрТЧ.ВсегоДоКорректировки = СтрТЧ.СуммаДоКорректировки + ?(Объект.СуммаВключаетНДС,0,СтрТЧ.СуммаНДСДоКорректировки);		
		СтрТЧ.ВсегоДоКорректировки = СтрТЧ.СуммаДоКорректировки + ?(РеализацияСуммаВключаетНДС, 0, СтрТЧ.СуммаНДСДоКорректировки);
		//Евросиб Каблов 09.04.2021 ) 
		СтрТЧ.ВсегоДоИзменения = СтрТЧ.СуммаДоИзменения + ?(Объект.СуммаВключаетНДС,0,СтрТЧ.СуммаНДСДоИзменения);		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Товары1КоличествоПриИзменении(Элемент)
	
	СтрТЧ = Элементы.Товары1.ТекущиеДанные;
	БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуСтрокиТабличнойЧасти(СтрТЧ);
	БухгалтерскийУчетОбщиеПроцедурыКлиент.ПересчитатьСуммыНДС(СтрТЧ,Объект.УчитыватьНДС,Объект.СуммаВключаетНДС);
	БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(СтрТЧ,Объект.СуммаВключаетНДС);
	РассчитатьСуммыВсегоПоДокументу();

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммыВсегоПоДокументу()
	ИтогоНДС = ?(Объект.Товары.Количество()>0, Объект.Товары.Итог("СуммаНДС"),0)+?(Объект.Услуги.Количество()>0,Объект.Услуги.Итог("СуммаНДС"),0)+?(Объект.АгентскиеУслуги.Количество()>0,Объект.АгентскиеУслуги.Итог("СуммаНДС"),0);
	ИтогоВсего = ?(Объект.Товары.Количество()>0, Объект.Товары.Итог("Сумма"),0)+ ?(Объект.Услуги.Количество()>0,Объект.Услуги.Итог("Сумма"),0)+ ?(Объект.АгентскиеУслуги.Количество()>0,Объект.АгентскиеУслуги.Итог("Сумма"),0)+?(Объект.СуммаВключаетНДС,0,ИтогоНДС);
	Попытка
		Объект.СуммаДокумента = ИтогоВсего;
		Объект.СуммаНДСДокумента = ИтогоНДС;
	Исключение
		// недостаточно прав для обновления полей
		ОпОш = ОписаниеОшибки();
		ыва = 1;
	КонецПопытки;
	Элементы.Валюта.Заголовок = Объект.ВалютаДокумента;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ДопСвойстваОбъекта.Очистить();
	Для каждого СтрТЧ из Объект.Товары Цикл
		БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(СтрТЧ,Объект.СуммаВключаетНДС);
	КонецЦикла;
	Для каждого СтрТЧ из Объект.Услуги Цикл
		БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(СтрТЧ,Объект.СуммаВключаетНДС);
	КонецЦикла;
		Для каждого СтрТЧ из Объект.АгентскиеУслуги Цикл
		БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(СтрТЧ,Объект.СуммаВключаетНДС);
	КонецЦикла;

	
	Если Объект.Товары.Количество()>0 Тогда 
		РассчитатьСуммыВсегоДоИзменения("Товары");
	КонецЕсли;
	
	//Евросиб Каблов 20.02.2021 ( Ticket#0224071
	//Если Объект.Услуги.Количество()>0 Тогда
	//	РассчитатьСуммыВсегоДоИзменения("Услуги");
	//КонецЕсли;
	//Евросиб Каблов 20.02.2021 )
	Если Объект.АгентскиеУслуги.Количество()>0 Тогда
		РассчитатьСуммыВсегоДоИзменения("АгентскиеУслуги");
	КонецЕсли;
	

	//РассчитатьСуммыВсегоПоДокументу(); // SIV 13-04-21 Почему пересчет записываемых полей идет ПОСЛЕ ЗАПИСИ?
	
	//Евросиб Максимова  03032021 №0225081 	
	// ПерезаполнитьНомерДляПечати(); SIV 05-03-21 Заполнять номер документа ПОСЛЕ ЗАПИСИ не очень корректно
    //Евросиб Максимова  03032021 №0225081 	

КонецПроцедуры

&НаКлиенте
Процедура Товары1ЦенаПриИзменении(Элемент)
	СтрТабЧасти = Элементы.Товары1.ТекущиеДанные;
	
	БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуСтрокиТабличнойЧасти(СтрТабЧасти);
	БухгалтерскийУчетОбщиеПроцедурыКлиент.ПересчитатьСуммыНДС(СтрТабЧасти,Объект.УчитыватьНДС,Объект.СуммаВключаетНДС);	
	БухгалтерскийУчетОбщиеПроцедурыКлиент.РассчитатьСуммуВсегоПоСтроке(СтрТабЧасти,Объект.СуммаВключаетНДС);
	РассчитатьСуммыВсегоПоДокументу();

КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеАннулирования()
	
	СделкиБезАннулирования.Очистить();
	
	Если ЗначениеЗаполнено(Объект.ИсходныйДокументРеализации) И Объект.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.Аннулирование И Объект.ЭтоИзменениеВознаграждения = Ложь Тогда
		
        //Евросиб - АСуслов 22.02.2024 9:50:18 #81376
		//(
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СделкаДоходы.Ссылка КАК Сделка
		|ИЗ
		|	Документ.Сделка.Доходы КАК СделкаДоходы
