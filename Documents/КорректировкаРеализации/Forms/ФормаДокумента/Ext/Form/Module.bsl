Функция ПолучитьСтруктурИзТЗ(хСтрокиСчетов)
	СтрокиСчетов = ПолучитьИзВременногоХранилища(хСтрокиСчетов);
	Ответ = Новый Массив;
	Для Каждого СтрокаТЗ Из СтрокиСчетов Цикл
		сСтрока = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(СтрокаТЗ);
		Если сСтрока.Счет.ДокументыОснования.Количество() Тогда
			сСтрока.Вставить("Сделка",сСтрока.Счет.ДокументыОснования[0].Сделка);
		КонецЕсли;
		
		Ответ.Добавить(сСтрока);
	КонецЦикла; 
	
	Возврат Ответ;
	
