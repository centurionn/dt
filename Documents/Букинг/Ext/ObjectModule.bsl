	Создано = ТекущаяДата();
	Редактор = неопределено;
	Изменено = неопределено;
	Состояния.Очистить();

	//++ Зубов 0228547 15.09.2021
	НомерБукинга = "";
	ИДБукинга = "";
	//-- Зубов 0228547 15.09.2021
КонецПроцедуры
