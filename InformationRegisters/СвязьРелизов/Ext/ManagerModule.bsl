	НоваяЗапись.РелизСобственника 	= РелизСобственника;
	НоваяЗапись.ГУИДСтроки 			= ГУИДСтроки;
 	НоваяЗапись.ГУИД_СтрокиРелизКлиента	= ГУИД_СтрокиРелизКлиента;
 	НоваяЗапись.Контейнер 			= Контейнер;
    НоваяЗапись.РелизКлиента 		= РелизКлиента;
	// ++ ДИТ_Агафонов_task 56709 14.09.2022
	НоваяЗапись.БылУстановленКТКизРелизаКлиента	= БылУстановленКТКизРелизаКлиента;
	// -- ДИТ_Агафонов_task 56709 14.09.2022
	Набор.Записать();
	
КонецПроцедуры

