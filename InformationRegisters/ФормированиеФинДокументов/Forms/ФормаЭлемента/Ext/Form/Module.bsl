
&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	Объект.Наименование = Объект.Контрагент;
КонецПроцедуры

&НаКлиенте
Процедура ОписаниеУслугиПриИзменении(Элемент)
	
	ОбновитьВсеТаблицы();
	ВидимостьСтраниц();
	
	ПримерСчФ = "";
	Для Каждого Стр Из  Объект.ОписаниеУслугиСчФ Цикл
		Если Стр.Использование Тогда
			ПримерСчФ = ПримерСчФ + Стр.ТекстовоеОписание + " [" + Стр.НазваниеРеквизита + "] ";
		КонецЕсли;
	КонецЦикла;
	Элементы.ПримерДляСчФ.Заголовок = ПримерСчФ;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ВидимостьСтраниц();
	

КонецПроцедуры

&НаКлиенте
Процедура ОдинаковыйФорматПриИзменении(Элемент)
	ОбновитьВсеТаблицы();
	ВидимостьСтраниц();
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьСтраниц()
	
	Элементы.Группа3.ОтображатьЗаголовок = НЕ Объект.ОдинаковыйФормат; 
	Элементы.Группа4.Видимость = НЕ Объект.ОдинаковыйФормат;
	Элементы.Группа5.Видимость = НЕ Объект.ОдинаковыйФормат;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВсеТаблицы()
	
	Если Объект.ОдинаковыйФормат Тогда
		Объект.ОписаниеУслугиСчет.Очистить();
		Объект.ОписаниеУслугиАкт.Очистить();
		Для Каждого Стр Из Объект.ОписаниеУслугиСчФ Цикл
			НовСтр1 = Объект.ОписаниеУслугиСчет.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр1,Стр);
			НовСтр2 = Объект.ОписаниеУслугиАкт.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр2,Стр);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

