
Процедура ПередЗаписью(Отказ, Замещение)
	
	Для каждого Стр из ЭтотОбъект Цикл
		
		Если НЕ ЗначениеЗаполнено(Стр.Контрагент) Тогда
			
			Стр.Контрагент = ПредыдущийЗаполненныйКонтрагент(Стр.Контейнер, Стр.Период);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПредыдущийЗаполненныйКонтрагент(Контейнер, Период)
	
	Результат = неопределено;
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СтатусыКТК.Контрагент КАК Контрагент
	               |ИЗ
	               |	РегистрСведений.СтатусыКТК КАК СтатусыКТК
	               |ГДЕ
	               |	СтатусыКТК.Контейнер = &Контейнер
	               |	И СтатусыКТК.Период < &Период
	               |	И СтатусыКТК.Контрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СтатусыКТК.Период УБЫВ";
	Запрос.УстановитьПараметр("Контейнер", Контейнер);
	Запрос.УстановитьПараметр("Период", Период);
	Ответ = запрос.Выполнить().Выбрать();
	Если ответ.Следующий() Тогда
		Результат = Ответ.Контрагент;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
