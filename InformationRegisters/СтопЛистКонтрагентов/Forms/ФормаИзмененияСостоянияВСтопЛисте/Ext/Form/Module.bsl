
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗначениеПараметра = Неопределено;
	
	Если Параметры.Свойство("Контрагент", ЗначениеПараметра) Тогда
		Контрагент = ЗначениеПараметра;
	КонецЕсли;
	
	Если Параметры.Свойство("ВСтопЛисте", ЗначениеПараметра) Тогда
		ВСтопЛисте = ЗначениеПараметра;
	КонецЕсли;
	
	Если Параметры.Свойство("Период", ЗначениеПараметра) Тогда
		Период = ЗначениеПараметра;
	Иначе
		Период = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если Параметры.Свойство("Пользователь", ЗначениеПараметра) Тогда
		Пользователь = ЗначениеПараметра;
	Иначе
		Пользователь = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	Если ВСтопЛисте Тогда		
		Элементы.ФормаЗаписать.Заголовок = "Поставить в стоп-лист";
	Иначе
		Элементы.ФормаЗаписать.Заголовок = "Вывести из стоп-листа";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Записать(Команда)
	
	ЗаписатьВРегистр();
	Оповестить("ЗаписьВСтопЛисте", Контрагент);
	ОповеститьОбИзменении(Тип("СправочникСсылка.Контрагенты"));
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаписатьВРегистр()
	
	Запись = РегистрыСведений.СтопЛистКонтрагентов.СоздатьМенеджерЗаписи();
	Запись.Период = Период;
	Запись.Пользователь = Пользователь;
	Запись.Контрагент = Контрагент;
	Запись.ВСтопЛисте = ВСтопЛисте;
	Запись.ДатаОграниченияАвтоматическогоИзмененияСостояния = ДатаОграниченияАвтоматическогоИзмененияСостояния;
	Запись.Комментарий = Комментарий;
	Запись.Записать();
	
КонецПроцедуры

#КонецОбласти
