
Функция ДатаОтработкиДокументаБухгалтерией(Состояния) Экспорт 
	
	ГруппаБухгалтерия = Справочники.ГруппыПользователей.НайтиПоНаименованию("Бухгалтерия", Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ГруппыПользователей.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Группы
	|ИЗ
	|	Справочник.ГруппыПользователей КАК ГруппыПользователей
	|ГДЕ
	|	ГруппыПользователей.Родитель В ИЕРАРХИИ (&Группа)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ГруппыПользователейСостав.Пользователь КАК Пользователь
	|ИЗ
	|	Справочник.ГруппыПользователей.Состав КАК ГруппыПользователейСостав
	|ГДЕ
	|	ГруппыПользователейСостав.Ссылка В
	|									(ВЫБРАТЬ
	|									  	ВТ_Группы.Ссылка
	|									 ИЗ
	|									  	ВТ_Группы КАК ВТ_Группы)";

	Запрос.УстановитьПараметр("Группа", ГруппаБухгалтерия);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = Дата(1,1,1);
	
	Если Не РезультатЗапроса.Пустой() Тогда
	
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Исполнитель", Выборка.Пользователь);
			ПараметрыОтбора.Вставить("Статус", Перечисления.СтатусыЭтапов.Выполнен);

			Строки = Состояния.НайтиСтроки(ПараметрыОтбора);  		
			Если Строки.Количество() > 0 Тогда
				Для Каждого Строка Из Строки Цикл
					
					Если Результат < Строка.ЗавершениеРаботы Тогда
						Результат = Строка.ЗавершениеРаботы;
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли	
		КонецЦикла;
	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
