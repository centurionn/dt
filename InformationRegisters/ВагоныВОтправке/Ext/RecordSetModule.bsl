
Процедура ПередЗаписью(Отказ, Замещение)
	
	Для Каждого ТекСтрока из ЭтотОбъект Цикл
		// нужно в справочнике ТС снять у вагона флаг "Резервный"
		НайденныйВагон = Справочники.ТС.НайтиПоКоду(ТекСтрока.Вагон.Код);
		Если НайденныйВагон.РезервноеТС Тогда
			ПолучОб = НайденныйВагон.ПолучитьОбъект();
			ПолучОб.РезервноеТС = Ложь;
			Получоб.Записать();
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры