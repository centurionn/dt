
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ТребуетсяОбновитьОтправку" Тогда
		Элементы.Список.Обновить();
		
		ТекД = Элементы.Список.ТекущиеДанные;
		Если ТекД <> неопределено Тогда
			ЗаписатьДанныеФактОтправки(Элементы.Список.ТекущиеДанные.Отправка);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьДанныеФактОтправки(Отправка)
	
	Если НЕ ПоЭтойОтправкеНетФактРейса(Отправка) Тогда Возврат; КонецЕсли;
	
	МассивВагонов = Новый Массив;
	
	МассивВагонов = Отправки_сервер.ПолучитьВагоныВОтправке(Отправка);
	
	ПодходящийРейс = Слежение_сервер.ПолучитьДанныеПредполагаемогоРейса(Отправка.ПунктОтправления, Отправка.ПунктНазначения, Отправка.ДатаОтправления, МассивВагонов);
	
	Если ПодходящийРейс.Вагон <> неопределено Тогда
		
		МЗ = РегистрыСведений.ОтметкаФактНачалаРейсов.СоздатьМенеджерЗаписи();
		МЗ.ЗарегистрированоПоВагону = ПодходящийРейс.Вагон;
		МЗ.ИндексПоезда = ПодходящийРейс.ИндексПоезда;
		МЗ.РейсЖД = Отправка;
		МЗ.ФактическоеНачало = ПодходящийРейс.Период;
		МЗ.Записать(Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПоЭтойОтправкеНетФактРейса(Отправка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОтметкаФактНачалаРейсов.ИндексПоезда КАК ИндексПоезда
	               |ИЗ
	               |	РегистрСведений.ОтметкаФактНачалаРейсов КАК ОтметкаФактНачалаРейсов
	               |ГДЕ
	               |	ОтметкаФактНачалаРейсов.РейсЖД = &РейсЖД";
	Запрос.УстановитьПараметр("РейсЖД", Отправка);
	Возврат Запрос.Выполнить().Пустой();
	
КонецФункции

