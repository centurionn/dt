Процедура ОтчетПоОстаткамКонтейнеров(Команда)
	
	ОткрытьФорму("Отчет.ОстаткиКонтейнеров.Форма");
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьИзБуфераОбмена(Команда)
	
	ОткрытьФорму("РегистрСведений.ВагоныВОтправке.Форма.ФормаРедактированияСпискаВагоновОтправки", Новый Структура("Отправка", Список.Отбор.Элементы[0].ПравоеЗначение));
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборВагонов(Команда)
	
	ПараметрыФормы = Новый Структура("Отправка", Список.Отбор.Элементы[0].ПравоеЗначение);
	ОткрытьФорму("Обработка.ПомощникВыбораВагонов.Форма", ПараметрыФормы,,ЭтаФорма.УникальныйИдентификатор,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Список.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", ТекущаяДата());
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьВагоныВСвязанныеОтправки(Команда)
	
	Отправка = Список.Отбор.Элементы[0].ПравоеЗначение;
	ЗаписатьВагоныВСвязанныеОтправки_сервер(Отправка);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаписатьВагоныВСвязанныеОтправки_сервер(Отправка)
	
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ
	              |	ВагоныВОтправке.Вагон КАК Вагон
	              |ИЗ
	              |	РегистрСведений.ВагоныВОтправке КАК ВагоныВОтправке
	              |ГДЕ
	              |	ВагоныВОтправке.Отправка = &Отправка";
	Запрос.УстановитьПараметр("Отправка", Отправка);
	Ответ = Запрос.Выполнить().Выбрать();
	
	СписокВагонов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Вагон");
	СледОтправки = Отправки_сервер.ПолучитьМассивДочернихОтправок(Отправка);
	Для каждого Стр из СледОтправки Цикл
		
		Отправки_сервер.ПривязатьВагоныКОтправке(Стр, СписокВагонов);
		
	КонецЦикла;
	
	Сообщить("Вагоны добавлены в " + СледОтправки.Количество() + " отправок");
	
КонецФункции

&НаКлиенте
Процедура ПоказатьСледующиеОтправки(Команда)
	
	Отправка = Список.Отбор.Элементы[0].ПравоеЗначение;
	МассивОтправок = Отправки_сервер.ПолучитьМассивДочернихОтправок(отправка);
	СписокОтправок = Новый СписокЗначений;
	СписокОтправок.ЗагрузитьЗначения(МассивОтправок);
	ОткрытьОтправки = Новый ОписаниеОповещения("ОткрытьОтправки", ЭтаФорма);
	СписокОтправок.ПоказатьОтметкуЭлементов(ОткрытьОтправки, "Указанные отправки связаны с текущей");
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтправки(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	Для каждого Стр из параметр1 Цикл
		Если Стр.Пометка Тогда ПоказатьЗначение(неопределено, Стр.Значение); КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
