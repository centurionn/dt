
//ДИТ Поморцева Т.П. Задача 34586 13.07.21.
Процедура СоздатьДвиженияДокументаРеализацияТоваровУслуг(РТУСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ  
	//Евросиб СубботинВ #84453 02.07.2024 Начало // убрал соединение и сделал вывод сделки из ТЧ
	
	//|	РеализацияТоваровУслугРасшифровкаУслугПоТС.ЖДН КАК ЖДН,
	//|	РеализацияТоваровУслугРасшифровкаУслугПоТС.ВидПеревозки КАК ВидПеревозки,
	//|	ВЫРАЗИТЬ(РеализацияТоваровУслугРасшифровкаУслугПоТС.Вагон.Наименование КАК СТРОКА(1000)) КАК Вагон,
	//|	ВЫРАЗИТЬ(РеализацияТоваровУслугРасшифровкаУслугПоТС.Контейнер.Наименование КАК СТРОКА(1000)) КАК Контейнер,
	//|	РеализацияТоваровУслуг.Ссылка КАК Ссылка,
	//|	РеализацияТоваровУслуг.Сделка КАК Сделка	
	//|ПОМЕСТИТЬ РасшифровкаУслуг
	//|ИЗ
	//|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	//|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.РасшифровкаУслугПоТС КАК РеализацияТоваровУслугРасшифровкаУслугПоТС
	//|		ПО РеализацияТоваровУслуг.Ссылка = РеализацияТоваровУслугРасшифровкаУслугПоТС.Ссылка
	//|ГДЕ
	//|	РеализацияТоваровУслуг.Ссылка = &ссылкаРТУ
	//|	И РеализацияТоваровУслугРасшифровкаУслугПоТС.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС0)
	//|; 
	|	РеализацияТоваровУслугРасшифровкаУслугПоТС.ЖДН КАК ЖДН,
	|	РеализацияТоваровУслугРасшифровкаУслугПоТС.ВидПеревозки КАК ВидПеревозки,
	|	ВЫРАЗИТЬ(РеализацияТоваровУслугРасшифровкаУслугПоТС.Вагон.Наименование КАК СТРОКА(1000)) КАК Вагон,
	|	ВЫРАЗИТЬ(РеализацияТоваровУслугРасшифровкаУслугПоТС.Контейнер.Наименование КАК СТРОКА(1000)) КАК Контейнер,
	|	РеализацияТоваровУслугРасшифровкаУслугПоТС.Ссылка КАК Ссылка,
	// Евросиб US 82073 TA 114490 Рыбьяков К.А. 24.07.2025 ((
	//|	РеализацияТоваровУслугРасшифровкаУслугПоТС.УдалитьСделка КАК Сделка
	|	РеализацияТоваровУслугРасшифровкаУслугПоТС.КлючАналитикиСоставаПоезда.Сделка КАК Сделка
	// Евросиб Рыбьяков К.А. 24.07.2025 ))
	|ПОМЕСТИТЬ РасшифровкаУслуг
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.РасшифровкаУслугПоТС КАК РеализацияТоваровУслугРасшифровкаУслугПоТС
	|ГДЕ
	|	РеализацияТоваровУслугРасшифровкаУслугПоТС.Ссылка = &ссылкаРТУ
	|	И РеализацияТоваровУслугРасшифровкаУслугПоТС.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС0)
	|;
	//Евросиб СубботинВ #84453 02.07.2024 Конец
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СделкаРасходы.УчДокумент.Контрагент КАК Контрагент,
	|	СделкаРасходы.Ссылка КАК Ссылка,
	|	СделкаРасходы.ГУИД КАК ГУИД,
	|	СделкаРасходы.УчДокумент КАК Приход
	|ПОМЕСТИТЬ Расходы
	|ИЗ
	|	Документ.Сделка.Расходы КАК СделкаРасходы
	|ГДЕ
	//Евросиб СубботинВ #84453 02.07.2024 Начало
	|	СделкаРасходы.Ссылка в (&ссылкиСделок)
//	|	СделкаРасходы.Ссылка = &ссылкаСделка
	//Евросиб СубботинВ #84453 02.07.2024 Конец
	
	|	И СделкаРасходы.УчДокумент <> ЗНАЧЕНИЕ(Документ.ПоступлениеТоваровУслуг.ПустаяСсылка)
	|	И СделкаРасходы.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПараметрыПримененияСтавкиНДС0СрезПоследних.ДокументыНеПредоставляются КАК ДокументыНеПредоставляются,
	|	ПараметрыПримененияСтавкиНДС0СрезПоследних.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	Расходы.Приход КАК Приход
	|ПОМЕСТИТЬ ПравоНаНДС0_ИзДоговора
	|ИЗ
	|	Расходы КАК Расходы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыПримененияСтавкиНДС0.СрезПоследних КАК ПараметрыПримененияСтавкиНДС0СрезПоследних
	|			ПО ПоступлениеТоваровУслуг.ДоговорКонтрагента = ПараметрыПримененияСтавкиНДС0СрезПоследних.ДоговорКонтрагента
	|		ПО Расходы.Приход = ПоступлениеТоваровУслуг.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СделкаДоходыКТК.КТК КАК КТК,
	|	СделкаДоходыКТК.ГУИД КАК ГУИД,
	|	СделкаДоходыКТК.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ДоходыКТК
	|ИЗ
	|	Документ.Сделка.ДоходыКТК КАК СделкаДоходыКТК
	|ГДЕ
	//Евросиб СубботинВ #84453 02.07.2024 Начало
	|	СделкаДоходыКТК.Ссылка в (&ссылкиСделок)
//	|	СделкаДоходыКТК.Ссылка = &ссылкаСделка
	//Евросиб СубботинВ #84453 02.07.2024 Конец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СделкаДоходыВагоны.Ссылка КАК Ссылка,
	|	СделкаДоходыВагоны.ГУИД КАК ГУИД,
	|	СделкаДоходыВагоны.Вагон КАК Вагон
	|ПОМЕСТИТЬ ДоходыВагоны
	|ИЗ
	|	Документ.Сделка.ДоходыВагоны КАК СделкаДоходыВагоны
	|ГДЕ
	//Евросиб СубботинВ #84453 02.07.2024 Начало
	|	СделкаДоходыВагоны.Ссылка в (&ссылкиСделок)
//	|	СделкаДоходыВагоны.Ссылка = &ссылкаСделка
	//Евросиб СубботинВ #84453 02.07.2024 Конец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ДоходыКТК.КТК КАК СТРОКА(1000)) КАК КТК,
	|	ВЫРАЗИТЬ(ДоходыВагоны.Вагон КАК СТРОКА(1000)) КАК Вагон,
	|	Расходы.Контрагент КАК Контрагент,
	|	Расходы.Ссылка КАК Ссылка,
	|	ПравоНаНДС0_ИзДоговора.ДокументыНеПредоставляются КАК ДокументыНеПредоставляются
	|ПОМЕСТИТЬ ВагонКонтейнерКонтрагент
	|ИЗ
	|	Расходы КАК Расходы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДоходыКТК КАК ДоходыКТК
	|		ПО Расходы.ГУИД = ДоходыКТК.ГУИД
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДоходыВагоны КАК ДоходыВагоны
	|		ПО Расходы.ГУИД = ДоходыВагоны.ГУИД
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПравоНаНДС0_ИзДоговора КАК ПравоНаНДС0_ИзДоговора
	|		ПО Расходы.Приход = ПравоНаНДС0_ИзДоговора.Приход
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВагонКонтейнерКонтрагент.Контрагент КАК Подрядчик,
	|	РасшифровкаУслуг.ЖДН КАК ЖДН,
	|	РасшифровкаУслуг.ВидПеревозки КАК ВидПеревозки
	|ИЗ
	|	РасшифровкаУслуг КАК РасшифровкаУслуг
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВагонКонтейнерКонтрагент КАК ВагонКонтейнерКонтрагент
	|		ПО (ВагонКонтейнерКонтрагент.КТК ПОДОБНО ""%"" + РасшифровкаУслуг.Контейнер + ""%"")
	|			И (ВагонКонтейнерКонтрагент.Вагон ПОДОБНО ""%"" + РасшифровкаУслуг.Вагон + ""%"")
	|ГДЕ
	|	НЕ ВагонКонтейнерКонтрагент.ДокументыНеПредоставляются";
	
	Запрос.УстановитьПараметр("ссылкаРТУ",РТУСсылка);
	//Евросиб СубботинВ #84453 02.07.2024 Начало
	ТаблСделок = РТУСсылка.Услуги.Выгрузить(,"Сделка");
	ТаблСделок.Свернуть("Сделка");
	Запрос.УстановитьПараметр("ссылкиСделок",ТаблСделок );
//	Запрос.УстановитьПараметр("ссылкаСделка",РТУСсылка.Сделка);
	//Евросиб СубботинВ #84453 02.07.2024 Конец

	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	
	Пока РезультатЗапроса.Следующий() Цикл
		//Для Каждого Строка Из ТЧРасшифровкаУслугПоТС Цикл
		Если РезультатЗапроса.ЖДН <> Документы.ТранспортныйДокумент.ПустаяСсылка() И 
			РезультатЗапроса.Подрядчик <> Null Тогда//И Строка.СтавкаНДС = Перечисления.СтавкиНДС.НДС0 Тогда
			ЗаписьРегистра = РегистрыСведений.КонтрольПолученияДокументовНДС0.СоздатьМенеджерЗаписи();
			ЗаписьРегистра.ЖДН = РезультатЗапроса.ЖДН;
			ЗаписьРегистра.Подрядчик = РезультатЗапроса.Подрядчик;
			ЗаписьРегистра.Прочитать();
			Если ЗаписьРегистра.Выбран() Тогда
				Если НЕ ЗначениеЗаполнено(ЗаписьРегистра.ВидПеревозки) Тогда
					ЗаписьРегистра.ВидПеревозки = РезультатЗапроса.ВидПеревозки;
					ЗаписьРегистра.Записать();
				КонецЕсли;
			Иначе
				ЗаписьРегистра.ЖДН = РезультатЗапроса.ЖДН;
				ЗаписьРегистра.Подрядчик = РезультатЗапроса.Подрядчик;
				ЗаписьРегистра.ВидПеревозки = РезультатЗапроса.ВидПеревозки;
				ЗаписьРегистра.Записать();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла; 	
		
КонецПроцедуры

Процедура УдалениеДвиженияДокументаРеализацияТоваровУслуг(ТЧРасшифровкаУслугПоТС) Экспорт
	
	Для Каждого Строка Из ТЧРасшифровкаУслугПоТС Цикл
		
		Набор = РегистрыСведений.КонтрольПолученияДокументовНДС0.СоздатьНаборЗаписей();
		Набор.Отбор.ЖДН.Установить(Строка.ЖДН, Истина);
		Набор.Прочитать();	
		Для Каждого ЗаписьРегистра Из Набор Цикл
			Набор.Удалить(ЗаписьРегистра);
		КонецЦикла;
		Набор.Записать();

	КонецЦикла;

КонецПроцедуры