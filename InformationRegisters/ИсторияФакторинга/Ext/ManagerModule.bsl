Функция ПолучитьДанныеПоФакторингу(Ссылка) Экспорт
	
	//Евросиб - АСуслов 13.09.2022 11:22:13 #
	//(
	Результат = Новый Структура("Факторинг, ДополнительнаяИнформацияФакторинг, ДоговорКонтрагента", Ложь, "");
	//)
	//Евросиб - АСуслов 13.09.2022 11:22:14 #
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЕСТЬNULL(ИсторияФакторинга.ДоговорКомпанииФактор.ДополнительнаяИнформацияФакторинг, """") КАК ДополнительнаяИнформацияФакторинг,
	|	ВЫБОР
	|		КОГДА ИсторияФакторинга.ДоговорКомпанииФактор ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Факторинг,
	|	ТаблицаДокумента.ДоговорКонтрагента КАК ДоговорКонтрагента
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК ТаблицаДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияФакторинга КАК ИсторияФакторинга
	|		ПО ТаблицаДокумента.ДоговорКонтрагента = ИсторияФакторинга.Договор
	|			И ТаблицаДокумента.ДатаДокумента >= ИсторияФакторинга.НачалоФакторинга
	|			И (ИсторияФакторинга.НачалоФакторинга <> ДАТАВРЕМЯ(1, 1, 1))
	|			И (ИсторияФакторинга.ОкончаниеФакторинга = ДАТАВРЕМЯ(1, 1, 1)
	|				ИЛИ ТаблицаДокумента.ДатаДокумента <= ИсторияФакторинга.ОкончаниеФакторинга)
	|ГДЕ
	|	ТаблицаДокумента.Ссылка = &Ссылка";
	
	ИмяОбъекта = Ссылка.Метаданные().Имя;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "РеализацияТоваровУслуг", ИмяОбъекта);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


