&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ЭтоПовторныйСтатусНаСервере(Запись.Договор, Запись.Статус, Запись.Период) Тогда
		Отказ = Истина;
		ПоказатьПредупреждение(, "Статус не изменился! Создавать новую запись с прежним статусом не разрешается");
	КонецЕсли;
	
КонецПроцедуры

//ДИТ Пак И.Т. Task34349 13.05.2021
&НаСервереБезКонтекста
Функция ЭтоПовторныйСтатусНаСервере(Договор, Статус, Период)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИсторияСтатусовПДЗСрезПоследних.Период КАК Период
	|ИЗ
	|	РегистрСведений.ИсторияСтатусовПДЗ.СрезПоследних(&Период, Договор = &Договор) КАК ИсторияСтатусовПДЗСрезПоследних
	|ГДЕ
	|	ИсторияСтатусовПДЗСрезПоследних.Статус = &Статус";
	
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("Статус", Статус);
	Запрос.УстановитьПараметр("Период", Период);
	
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Период < Период;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции
