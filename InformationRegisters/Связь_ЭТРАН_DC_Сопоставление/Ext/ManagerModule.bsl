// ДИТ US 81881 ТА 81882 Сержантова А.С. 01.04.2024
Функция ПолучитьСопоставлениеЭтранДатакор(Знач МассивЗначенийЭтран) Экспорт
	
	Если ТипЗнч(МассивЗначенийЭтран) <> Тип("Массив") Тогда
		МассивЗнч = Новый Массив;
		МассивЗнч.Добавить(МассивЗначенийЭтран);
		МассивЗначенийЭтран = МассивЗнч; 
	КонецЕсли;   
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Связь_ЭТРАН_DC_Сопоставление.СпрЭтрана КАК СпрЭтрана,
	|	Связь_ЭТРАН_DC_Сопоставление.СпрДатакор КАК СпрДатакор
	|ИЗ
	|	РегистрСведений.Связь_ЭТРАН_DC_Сопоставление КАК Связь_ЭТРАН_DC_Сопоставление
	|ГДЕ
	|	Связь_ЭТРАН_DC_Сопоставление.СпрЭтрана В(&СпрЭтрана)";
	Запрос.УстановитьПараметр("СпрЭтрана", МассивЗначенийЭтран);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	РезультатСоответствие = Новый Соответствие;
	Для каждого ЗначениеЭтран Из МассивЗначенийЭтран Цикл
		РезультатСоответствие.Вставить(ЗначениеЭтран);	
	КонецЦикла;
	Пока Выборка.Следующий() Цикл
		РезультатСоответствие.Вставить(Выборка.СпрЭтрана, Выборка.СпрДатакор);
	КонецЦикла;                                                               
	Возврат РезультатСоответствие;
	
КонецФункции
