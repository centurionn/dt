Процедура УвеличитьНумератор(Дата, Ресурс) Экспорт

	Запись = РегистрыСведений.Нумераторы.СоздатьМенеджерЗаписи();
	Запись.Период = НачалоГода(Дата);
	Запись.Прочитать();
	Если Не Запись.Выбран() Тогда
		Запись.Период = НачалоГода(Дата);
		Запись[Ресурс] = 1;	
	Иначе
		Запись.Период = НачалоГода(Дата);
		Запись[Ресурс] = Запись[Ресурс]+1;	
	КонецЕсли; 
	Запись.Записать();
	
КонецПроцедуры
 