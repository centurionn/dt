
Функция ПолучитьКонтрагентовРезидентовПоРуководителю(Физлицо) Экспорт
	
	СписокКонтрагентов = Новый Массив;
	Если Не ЗначениеЗаполнено(Физлицо) Тогда
		Возврат СписокКонтрагентов;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеРуководителяКонтрагентов.Контрагент КАК Контрагент,
	|	ДанныеРуководителяКонтрагентов.Контрагент.Наименование КАК КонтрагентНаименование
	|ИЗ
	|	РегистрСведений.ДанныеРуководителяКонтрагентов КАК ДанныеРуководителяКонтрагентов
	|ГДЕ
	|	ДанныеРуководителяКонтрагентов.Руководитель = &Руководитель
	|	И ДанныеРуководителяКонтрагентов.Контрагент.СтранаРегистрации = &СтранаРоссия";
	Запрос.УстановитьПараметр("Руководитель", Физлицо);
	Запрос.УстановитьПараметр("СтранаРоссия", Справочники.СтраныМира.Россия);
		
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокКонтрагентов.Добавить(Новый Структура("Контрагент, КонтрагентНаименование", Выборка.Контрагент, Выборка.КонтрагентНаименование));
	КонецЦикла;
	
	Возврат СписокКонтрагентов;
		
КонецФункции
	