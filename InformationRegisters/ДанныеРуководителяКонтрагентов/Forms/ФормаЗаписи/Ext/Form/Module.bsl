
&НаКлиенте
Процедура РуководительПриИзменении(Элемент)
	
	Запись.Период = Запись.Период + 1;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//Евросиб Каблов 29.10.2024 ( #67092
	ЭтоНоваяЗапись = Параметры.Ключ.Пустой();
	КонтрагентРезидент = ПолучитьПризнакКонтрагентРезидент(Запись.Контрагент);
	Если КонтрагентРезидент
		//Евросиб Коханенко Н.А. 27.11.2024 (( #95833 
		И НЕ РольДоступна("ПолныеПрава")
		//Евросиб Коханенко Н.А. 27.11.2024 )) #95833 
 	Тогда
		ТолькоПросмотр = Истина;
	КонецЕсли;
	//Евросиб Каблов 29.10.2024 )
	
	Если параметры.Свойство("ВызывающаяФорма") Тогда
		Запись.Контрагент = Параметры.Контрагент;
		Запись.Период = ТекущаяДата()-365*24*3600;
		ВызывающаяФорма = Параметры.ВызывающаяФорма;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Если ЗначениеЗаполнено(ВызывающаяФорма) Тогда
		Оповестить("СозданРуководительКонтрагента", Запись.Руководитель, ВызывающаяФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	Запись.ОкончаниеДействия = ДобавитьМесяц(Запись.Период, 12);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Форс = Ложь и НЕ ЗначениеЗаполнено(Запись.СканДоверенности) Тогда
		Отказ = Истина;
		ОпОп = Новый ОписаниеОповещения("ОбработкаВопросаДоверки", ЭтаФорма);
		ПоказатьВопрос(ОпОп, "Не указан скан доверенности. Рекомендуется указать его. Все равно продолжить?", РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВопросаДоверки(П1 = неопределено, П2 = неопределено) Экспорт
	
	Если П1 = КодВозвратаДиалога.Да Тогда
		Форс = Истина;
		Записать();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПризнакКонтрагентРезидент(Контрагент)
	
	КонтрагентРезидент = Ложь;
	// Евросиб US 120527 TA 120528 Рыбьяков К.А. 09.10.2025 ((
	Если ЗначениеЗаполнено(Контрагент) И ТипЗнч(Контрагент) <> Тип("СправочникСсылка.Организации") Тогда
	//Если ЗначениеЗаполнено(Контрагент) Тогда
	// Евросиб Рыбьяков К.А. 09.10.2025 ))
		КонтрагентРезидент = Не Справочники.Контрагенты.КонтрагентНерезидент(Контрагент);
	КонецЕсли;
	
	Возврат КонтрагентРезидент;
	
КонецФункции

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	КонтрагентРезидент = ПолучитьПризнакКонтрагентРезидент(Запись.Контрагент);
	Если КонтрагентРезидент Тогда
		ПоказатьПредупреждение(, "Добавление и изменения данных руководителя контрагента резидента недоступно!");
		Запись.Контрагент = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если КонтрагентРезидент Тогда
		Если ЭтоНоваяЗапись Тогда
			Отказ = Истина;
			ПоказатьПредупреждение(, "Добавление и изменения данных руководителя контрагента резидента недоступно!");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


