Процедура ЗафиксироватьМассивСтатусов(МассивСтрокСтатусов, ОбъектСсылка) Экспорт
	
	НаборСтатусов = РегистрыСведений.СтатусыОбъектов.СоздатьНаборЗаписей();
	НаборСтатусов.Отбор.Объект.Установить(ОбъектСсылка);
	НаборСтатусов.Прочитать();
	Если НаборСтатусов.Количество()>0 Тогда
		ТекущийЦикл	= НаборСтатусов[НаборСтатусов.Количество()-1].ЦиклРаботыСДокументом;
	Иначе
		ТекущийЦикл = 1; 
	КонецЕсли;
	Для Каждого СтрокаСтатуса из МассивСтрокСтатусов Цикл		
		СтатусУжеЗаписан = Ложь;
		Для Каждого СтрокаСтатусаНабора из НаборСтатусов Цикл 
			Если СтрокаСтатуса.Период = СтрокаСтатусаНабора.Период и СтрокаСтатуса.Статус = СтрокаСтатусаНабора.Статус Тогда 
				СтатусУжеЗаписан = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла; 
		
		Если НЕ СтатусУжеЗаписан Тогда
			//Если НомерСтроки = 1 и НаборСтатусов.Количество()>0 Тогда
			//	СтатусПредыдущий = НаборСтатусов[НаборСтатусов.Количество()-1].Статус;
			//ИначеЕсли НЕ НомерСтроки = 1 Тогда 
			//	СтатусПредыдущий = ПредыдущийСтатусДляЗаполнения;
			//КонецЕсли;
			Если НаборСтатусов.Количество()>0 Тогда
				СтатусПредыдущий = НаборСтатусов[НаборСтатусов.Количество()-1].Статус;
			Иначе 
				СтатусПредыдущий = Неопределено;
			КонецЕсли;
			
			НС = НаборСтатусов.Добавить();
			ЗаполнитьЗначенияСвойств(НС, СтрокаСтатуса);
			НС.СтатусПредыдущий = СтатусПредыдущий;
			
			Если СтатусПредыдущий = Справочники.СтатусыДокументов.ОтклоненаВУПП
				или СтатусПредыдущий = Справочники.СтатусыДокументов.ЗаявкаОплачена Тогда				
				ТекущийЦикл = ТекущийЦикл +1
			КонецЕсли; 
			
			НС.ЦиклРаботыСДокументом = ТекущийЦикл;
			
			Если СтрокаСтатуса.НеобходимоИзменениеПризнакаАктивности Тогда
				Документы.РеестрПлатежей.ИзменитьПризнакАктивностиЗаявкиВРеестрах(ОбъектСсылка, СтрокаСтатуса.Признак);
			КонецЕсли;			
		КонецЕсли;	
	КонецЦикла;
	Попытка
		НаборСтатусов.Записать();
	Исключение
		   ЗаписьЖурналаРегистрации("Формирование записей по " + ОбъектСсылка , УровеньЖурналаРегистрации.Ошибка,,,ОписаниеОшибки());
	КонецПопытки
	
КонецПроцедуры
