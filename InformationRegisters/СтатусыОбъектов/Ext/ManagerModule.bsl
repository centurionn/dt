	Если ПериодЗаписи = Неопределено Тогда
		 ПериодЗаписи = ТекущаяДата();
	КонецЕсли;	 
	НС.Период = ПериодЗаписи;
	//Евросиб СубботинВ #111466 04.07.2025 Конец
	
