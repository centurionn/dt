Функция ПолучитьПоследнееЗначениеСтатуса(ОбъектСсылка) Экспорт
	
	//Евросиб СубботинВ #128538 23.01.2026 Начало
	//Ответ = Новый Структура("Период,Объект,Статус,Пользователь,ЦиклРаботыСДокументом,Комментарий");
	Ответ = Новый Структура("Период, Объект, Статус, Пользователь, ЦиклРаботыСДокументом, Комментарий, СтатусПредыдущий");
	//Евросиб СубботинВ #128538 23.01.2026 Конец
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтатусыОбъектовСрезПоследних.Период КАК Период,
		|	СтатусыОбъектовСрезПоследних.Объект КАК Объект,
		|	СтатусыОбъектовСрезПоследних.Статус КАК Статус,
		|	СтатусыОбъектовСрезПоследних.Пользователь КАК Пользователь,
		|	СтатусыОбъектовСрезПоследних.ЦиклРаботыСДокументом КАК ЦиклРаботыСДокументом,
		//Евросиб СубботинВ #128538 23.01.2026 Начало
		|	СтатусыОбъектовСрезПоследних.СтатусПредыдущий КАК СтатусПредыдущий,
		//Евросиб СубботинВ # 12853823.01.2026 Конец
		|	СтатусыОбъектовСрезПоследних.Комментарий КАК Комментарий
		|ИЗ
		|	РегистрСведений.СтатусыОбъектов.СрезПоследних(, Объект = &Объект) КАК СтатусыОбъектовСрезПоследних";
	
	Запрос.УстановитьПараметр("Объект", ОбъектСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() тогда
	 	ЗаполнитьЗначенияСвойств(Ответ,ВыборкаДетальныеЗаписи);	
	КонецЕсли;
	
	Возврат Ответ;

КонецФункции	

