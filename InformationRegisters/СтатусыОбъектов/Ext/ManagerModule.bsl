		ПоследняяЗапись = НаборСтатусов[НаборСтатусов.Количество()-1];
		ПоследнийСтатус = ПоследняяЗапись.Статус;
	Иначе
		ПоследняяЗапись = Неопределено;
		ПоследнийСтатус = Неопределено;
	КонецЕсли;
	
	Если НЕ ПоследняяЗапись = Неопределено
		и ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.ЗаявкаНаОплату")
		и НовыйСтатус = Справочники.СтатусыДокументов.ЗаявкаОплачена Тогда
		Если ПоследнийСтатус = Справочники.СтатусыДокументов.ЗаявкаОплачена Тогда
			ПоследняяЗапись.ЦиклРаботыСДокументом = ПоследняяЗапись.ЦиклРаботыСДокументом +1;
			НаборСтатусов.Записать();
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	//Евросиб СубботинВ #128538 23.01.2026 Конец
	
	НС = НаборСтатусов.Добавить(); 
	НС.Объект 		= ОбъектСсылка;
	НС.Статус 		= НовыйСтатус;
	НС.Пользователь	= ?(ИсточникУстановки = Неопределено, Пользователи.ТекущийПользователь(), ИсточникУстановки);
	
	//Евросиб СубботинВ #128538 23.01.2026 Начло

	НС.СтатусПредыдущий = ?(ЗначениеЗаполнено(ПоследнийСтатус), ПоследнийСтатус, Неопределено);
	//Евросиб СубботинВ #128538 23.01.2026 Конец

