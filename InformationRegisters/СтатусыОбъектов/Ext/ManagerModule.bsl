		//		ТекущийЦикл = Запись.ЦиклРаботыСДокументом +1;
		//	Иначе
		//		ТекущийЦикл = Запись.ЦиклРаботыСДокументом; 
		//	КонецЕсли;  
		Если НЕ ПоследняяЗапись = Неопределено Тогда
			Если ПоследнийСтатус = Справочники.СтатусыДокументов.ОтклоненаВУПП или ПоследнийСтатус = Справочники.СтатусыДокументов.ЗаявкаОплачена Тогда
				ТекущийЦикл = ПоследняяЗапись.ЦиклРаботыСДокументом +1;
			Иначе
				ТекущийЦикл = ПоследняяЗапись.ЦиклРаботыСДокументом; 
			КонецЕсли;		
		//Евросиб СубботинВ #128538 23.01.2026 Конец

		КонецЕсли; 
	КонецЕсли;	
	НС.ЦиклРаботыСДокументом = ТекущийЦикл;
	НС.Комментарий = Комментарий; 
	//Евросиб СубботинВ #89527 30.10.2024 Конец
	
	//Евросиб СубботинВ #111466 04.07.2025 Начало
