
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверка на новую запись
	Если Не ЗначениеЗаполнено(Запись.ИсходныйКлючЗаписи.Договор) Тогда
		Если ЗначениеЗаполнено(Запись.Договор) Тогда
			УчаствуетВРассылкеПДЗ = 
				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.Договор, "УчаствуетВРассылкеПДЗ");
				
			Если Не УчаствуетВРассылкеПДЗ Тогда
				ТекстИсключения = 
					НСтр("ru = 'В карточке договора ""%1"" не установлен признак ""Участвует в рассылке ПДЗ""'");
				ТекстИсключения = 
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстИсключения, Запись.Договор);
				ВызватьИсключение(ТекстИсключения);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	УстановитьДоступностьЭлементов();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура ОтключенаРассылкаПДЗПриИзменении(Элемент)
	
	Если Не Запись.ОтключенаРассылкаПДЗ Тогда
		Запись.ПричинаОтключенияРассылки = "";
	КонецЕсли;
	
	УстановитьДоступностьЭлементов();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьДоступностьЭлементов()
	
	Элементы.ПричинаОтключенияРассылки.ТолькоПросмотр = Не Запись.ОтключенаРассылкаПДЗ;
	
КонецПроцедуры

#КонецОбласти