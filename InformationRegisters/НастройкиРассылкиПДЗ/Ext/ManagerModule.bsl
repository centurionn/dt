
Функция ПолучателиДоговораПоДаннымРегистра() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СписокПолучателей = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НастройкиРассылкиПДЗ.Договор КАК Договор
	|ИЗ
	|	РегистрСведений.НастройкиРассылкиПДЗ КАК НастройкиРассылкиПДЗ
	|ГДЕ
	|	НастройкиРассылкиПДЗ.Договор.УчаствуетВРассылкеПДЗ";
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			СписокПолучателей.Вставить(Выборка.Договор);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат СписокПолучателей;
	
КонецФункции

