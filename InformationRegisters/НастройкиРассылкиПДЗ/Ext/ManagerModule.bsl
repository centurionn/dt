	ТаблицаКопии = РезультатПакет[3].Выгрузить();
	
	Если ТаблицаПолучателей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Получатели = "";
	
	Для Каждого СтрокаТЗ Из ТаблицаПолучателей Цикл
		Получатели = Получатели + ?(ЗначениеЗаполнено(Получатели), "; ", "") + СтрокаТЗ.ЭлектроннаяПочта;
	КонецЦикла;
	
	ПараметрыПисьма.Вставить("Кому", Получатели);
	
	Получатели = "";
	
	Для Каждого СтрокаТЗ Из ТаблицаКопии Цикл
		Получатели = Получатели + ?(ЗначениеЗаполнено(Получатели), "; ", "") + СтрокаТЗ.ЭлектроннаяПочта;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Получатели) Тогда
		ПараметрыПисьма.Вставить("Копии", Получатели);
	КонецЕсли;
	
КонецПроцедуры