
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ДанныеЗаполнения = Неопределено Тогда
		ДанныеЗаполнения = Новый Структура;
	КонецЕсли;
	
	ДанныеЗаполнения.Вставить("ДатаКомментария", ТекущаяДата());
	ДанныеЗаполнения.Вставить("АвторКомментария", Пользователи.ТекущийПользователь());
	
КонецПроцедуры

