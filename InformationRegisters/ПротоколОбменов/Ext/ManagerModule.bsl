Функция ЗафиксироватьИнформациюОЗагрузке(СтруктураПоиска, СтруктураДанных, ТекстСообщения = "", ТолькоОбновить = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);	
	НаборЗаписей = РегистрыСведений.ПротоколОбменов.СоздатьНаборЗаписей();
	Для каждого Строка Из СтруктураПоиска Цикл
		НаборЗаписей.Отбор[Строка.Ключ].Установить(Строка.Значение);
	КонецЦикла;
	НаборЗаписей.Прочитать();
	Сообщение = Новый СообщениеПользователю();
	Если НаборЗаписей.Количество() = 0 Тогда
		Если ТолькоОбновить Тогда
			Возврат Сообщение;
		КонецЕсли; 
		НоваяЗапись = НаборЗаписей.Добавить();
		Сообщение.Текст = ТекстСообщения;
	Иначе
		НоваяЗапись = НаборЗаписей[0];
		Если НоваяЗапись.УИДИсточника <> СтруктураДанных.УИДИсточника Тогда    
			// ДИТ US 76919 ТА 76920 Сержантова А.С. Начало: 21.11.2023 - данные сообщения не выводим для пользователя
			// Сообщение.Текст = "УИДы разные. Обновлено. Было: " + НоваяЗапись.УИДИсточника + " стало: " + СтруктураДанных.УИДИсточника;
			Сообщение.Текст = "Обновлено. " + ТекстСообщения; 	
			// ДИТ US 76919 ТА 76920 Сержантова А.С. Конец: 21.11.2023
		Иначе   
			Сообщение.Текст = "Обновлено. " + ТекстСообщения;   
		КонецЕсли; 
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(НоваяЗапись, СтруктураПоиска);
	ЗаполнитьЗначенияСвойств(НоваяЗапись, СтруктураДанных);

	Если ТолькоОбновить = Ложь Тогда //Евросиб Гудкова( 15.12.2020 Ticket№ 0216909
//Евросиб Гудкова( 21.02.2022 Ticket№0224955
//		НоваяЗапись.ДатаОбмена = ТекущаяДата();
		ДатаОбмена = Неопределено;
		СтруктураДанных.Свойство("ДатаОбмена", ДатаОбмена);
		НоваяЗапись.ДатаОбмена = ?(ЗначениеЗаполнено(ДатаОбмена), ДатаОбмена, ТекущаяДата());
// Евросиб Гудкова)
	КонецЕсли;// Евросиб Гудкова) 

	НаборЗаписей.Записать();
	УстановитьПривилегированныйРежим(Ложь);	
	Возврат Сообщение;
	
КонецФункции

Функция ПроверитьВыгрузку(Ссылка, УзелОбмена, ДействиеПриОбмене) Экспорт
	
	// Евросиб(ДИТ) US 73033 ТА 87495 Сержантова А.С. 12.07.2024  + СтатусБУ,ДатаОплатыБУ 
	СтруктураОтвета = Новый Структура("Ссылка, ДатаОбмена, Ответственный, ПроведенВБУ, НомерДатаВБУ, СтатусБУ, ДатаОплатыБУ");
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПротоколОбменов.Ответственный КАК Ответственный,
	               |	ПротоколОбменов.ДатаОбмена КАК ДатаОбмена,
	               |	ПротоколОбменов.Объект КАК Ссылка,
	               |	ПротоколОбменов.ПроведенВБУ КАК ПроведенВБУ,  
				   // Евросиб(ДИТ) US 73033 ТА 87495 Сержантова А.С. Начало: 12.07.2024
				   |	ПротоколОбменов.Статус КАК СтатусБУ,  
				   |	ПротоколОбменов.ДатаОплаты КАК ДатаОплатыБУ,
				   // Евросиб(ДИТ) US 73033 ТА 87495 Сержантова А.С. Конец: 12.07.2024
	               |	ПротоколОбменов.НомерДатаВБУ КАК НомерДатаВБУ
	               |ИЗ
	               |	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	               |ГДЕ
	               |	ПротоколОбменов.ДействиеПриОбмене = &ДействиеПриОбмене
	               |	И ПротоколОбменов.УзелОбмена = &УзелОбмена
	               |	И ПротоколОбменов.Объект = &Объект";
	Запрос.УстановитьПараметр("Объект", Ссылка);
	Запрос.УстановитьПараметр("УзелОбмена", УзелОбмена);
	Запрос.УстановитьПараметр("ДействиеПриОбмене", ДействиеПриОбмене);
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		ЗаполнитьЗначенияСвойств(СтруктураОтвета, Выборка);
	КонецЕсли;
	Возврат СтруктураОтвета;
	
КонецФункции

Функция СсылкаПоУИД(УИДИсточника, ДействиеПриОбмене, УзелОбмена, СписокТипов = Неопределено, НУИНУ = 0) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПротоколОбменов.Объект КАК Объект
	|ИЗ
	|	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	|ГДЕ
	|	ПротоколОбменов.УИДИсточника = &УИДИсточника
	|	И ПротоколОбменов.ДействиеПриОбмене = &ДействиеПриОбмене
	|	И ПротоколОбменов.НУИНУ = &НУИНУ
	|	И ПротоколОбменов.УзелОбмена = &УзелОбмена";
	
	Запрос.УстановитьПараметр("УИДИсточника", 	   УИДИсточника);
	Запрос.УстановитьПараметр("УзелОбмена", 	   УзелОбмена);
	Запрос.УстановитьПараметр("ДействиеПриОбмене", ДействиеПриОбмене);
	Запрос.УстановитьПараметр("НУИНУ", НУИНУ);
	Если ЗначениеЗаполнено(СписокТипов) Тогда
		Запрос.Текст = Запрос.Текст + "
	|	И ТИПЗНАЧЕНИЯ(ПротоколОбменов.Объект) В (&СписокТипов)";
		 Запрос.УстановитьПараметр("СписокТипов",  СписокТипов);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Ссылка = Выборка.Объект;	
	Иначе
		Ссылка = Неопределено;
	КонецЕсли;	
	Возврат Ссылка;
КонецФункции

Функция ПолучитьЗначенияЗаписей(ДействияПриОбмене, УзелОбмена, Объект, НУИНУ = 0) Экспорт
	
	//Евросиб СубботинВ #111466 09.06.2025 Начало
	//СтруктураВозврата = Новый Структура("УИДИсточника, ДопИнфо1");
	СтруктураВозврата = Новый Структура("УИДИсточника, ДопИнфо1, ДатаПланируемойОплаты");
	//Евросиб СубботинВ #111466 09.06.2025 Конец
	КодДетскийМир = "";
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПротоколОбменов.УИДИсточника КАК УИДИсточника,
	|	ПротоколОбменов.ДопИнфо1 КАК ДопИнфо1
	//Евросиб СубботинВ #111466 09.06.2025 Начало
    |	, ПротоколОбменов.ДатаПланируемойОплаты КАК ДатаПланируемойОплаты
	//Евросиб СубботинВ #111466 09.06.2025 Конец
	|ИЗ
	|	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	|ГДЕ
	|	ПротоколОбменов.ДействиеПриОбмене = &ДействиеПриОбмене
	|	И ПротоколОбменов.УзелОбмена = &УзелОбмена
	|	И ПротоколОбменов.Объект = &Объект
	|	И ПротоколОбменов.НУИНУ = &НУИНУ";
//Евросиб СубботинВ #88804 12.08.2024 Начал //закоментил, т.к получается что передавать действие нет смысла
  //Запрос.УстановитьПараметр("ДействиеПриОбмене", Перечисления.ДействияПриОбмене.ВыгрузкаДанных); 
	Запрос.УстановитьПараметр("ДействиеПриОбмене", ДействияПриОбмене);
	//закоментил, т.к получается что передавать действие нет смысла
	//Запрос.УстановитьПараметр("УзелОбмена", Перечисления.УзлыОбмена.ДМ);
	Запрос.УстановитьПараметр("УзелОбмена", УзелОбмена);
	//Евросиб СубботинВ #88804 12.08.2024 Конец

	Запрос.УстановитьПараметр("Объект", Объект);
	Запрос.УстановитьПараметр("НУИНУ", 0);
	РезультатЗапроса = Запрос.Выполнить(); 
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ЗаполнитьЗначенияСвойств(СтруктураВозврата, Выборка);
	КонецЕсли;                               
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ЗаписатьУИДИсточника(УИДИсточника, ДействияПриОбмене, УзелОбмена, Объект, НУИНУ = 0, ДопИнфо1 = "") Экспорт

	мз = РегистрыСведений.ПротоколОбменов.СоздатьМенеджерЗаписи();
	мз.ДействиеПриОбмене = ДействияПриОбмене;
	мз.УзелОбмена = УзелОбмена;
	мз.Объект = Объект;
	мз.НУИНУ = НУИНУ;
	мз.УИДИсточника = УИДИсточника; 
	мз.ДопИнфо1 = ДопИнфо1;
	мз.Записать();
	
КонецФункции

