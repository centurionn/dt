Функция ПолучитьУзлыОбменаОбъектаПротоколаОбмена (СсылкаНаОбъект, ДействиеПриОбмене)  экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПротоколОбменов.УзелОбмена КАК УзелОбмена
	|ИЗ
	|	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	|ГДЕ
	|	ПротоколОбменов.Объект = &Объект
	|	И ПротоколОбменов.ДействиеПриОбмене = &ДействиеПриОбмене";
	
	Запрос.УстановитьПараметр("Объект", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ДействиеПриОбмене", ДействиеПриОбмене );
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() тогда
		Возврат Неопределено
	Иначе
		Возврат РезультатЗапроса.Выгрузить();
	КонецЕсли;
		
КонецФункции

Процедура УдалитьНеподтвержденныеОбъекты(УзелОбмена, ДействиеПриОбмене, СписокТипов) Экспорт
	
	//Евросиб(ДИТ), Беляев СЮ, US 88935/TA 88948, 24-07-2024, начало
	ВсеДокументы = Документы.ТипВсеСсылки();
	//Евросиб(ДИТ), Беляев СЮ, US 88935/TA 88948, 24-07-2024, конец
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|ПротоколОбменов.Объект КАК Объект
	|ИЗ
	|	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
	|ГДЕ
	|	ПротоколОбменов.ДействиеПриОбмене = &ДействиеПриОбмене
	|	И ПротоколОбменов.УзелОбмена = &УзелОбмена
	|	И ПротоколОбменов.ЗагрузкаПодтверждена = ЛОЖЬ
	|	И ТИПЗНАЧЕНИЯ(ПротоколОбменов.Объект) В (&СписокТипов)
	//Евросиб(ДИТ), Беляев СЮ, US 88935/TA 88948, 24-07-2024, начало
	|	И НЕ ПротоколОбменов.Объект.ПометкаУдаления
	//Евросиб(ДИТ), Беляев СЮ, US 88935/TA 88948, 24-07-2024, конец
	|";
	
	Запрос.УстановитьПараметр("УзелОбмена", УзелОбмена);
	Запрос.УстановитьПараметр("ДействиеПриОбмене", ДействиеПриОбмене);
	Запрос.УстановитьПараметр("СписокТипов",  СписокТипов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка			
			//Если не Выборка.Объект.ПометкаУдаления тогда //Евросиб(ДИТ), Беляев СЮ, US 88935/TA 88948, 24-07-2024, закомменировал условие, перенёс его в запрос
				Объект = Выборка.Объект.ПолучитьОбъект();
				//Объект.ПометкаУдаления = Истина;
				//Объект.Записать();
				//Евросиб(ДИТ), Беляев СЮ, US 88935/TA 88948, 24-07-2024, начало
				Если ВсеДокументы.СодержитТип(ТипЗнч(Выборка.Объект)) И Объект.Проведен Тогда
					Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				КонецЕсли;
				Объект.УстановитьПометкуУдаления(Истина);
				//Евросиб(ДИТ), Беляев СЮ, US 88935/TA 88948, 24-07-2024, конец
			//КонецЕсли;
			
		Исключение
		КонецПопытки;
	КонецЦикла;	

КонецПроцедуры
