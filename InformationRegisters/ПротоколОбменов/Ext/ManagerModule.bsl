Функция ДатаВыгрузкиОбъекта(УзелОбмена, ДействиеПриОбмене, Объект) Экспорт  
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПротоколОбменов.ДатаОбмена КАК ДатаОбмена,
		|	ПротоколОбменов.Объект КАК Объект
		|ИЗ
		|	РегистрСведений.ПротоколОбменов КАК ПротоколОбменов
		|ГДЕ
		|	ПротоколОбменов.ДействиеПриОбмене = &ДействиеПриОбмене
		|	И ПротоколОбменов.УзелОбмена = &УзелОбмена
		|	И ПротоколОбменов.Объект = &Объект";
	
	Запрос.УстановитьПараметр("ДействиеПриОбмене", ДействиеПриОбмене);
	Запрос.УстановитьПараметр("Объект", Объект);
	Запрос.УстановитьПараметр("УзелОбмена", УзелОбмена);
	
	РезультатЗапроса = Запрос.Выполнить();
	ДатаВыгрузки = Дата("00010101");
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ДатаВыгрузки = Выборка.ДатаОбмена;
	КонецЕсли;                               
	Возврат ДатаВыгрузки;	

КонецФункции