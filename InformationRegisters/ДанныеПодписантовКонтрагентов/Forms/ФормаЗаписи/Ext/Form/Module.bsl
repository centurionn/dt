
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ВызывающаяФорма") Тогда
		Запись.Контрагент = Параметры.Контрагент;
		Запись.Период = ТекущаяДата()-365*24*3600;
		ВызывающаяФорма = Параметры.ВызывающаяФорма;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Если ЗначениеЗаполнено(ВызывающаяФорма) Тогда
		//Евросиб Коханенко Н.А. 07.08.2025 (( #112773 
		Оповестить("СозданПодписантКонтрагента", 
					Новый Структура("Подписант, Доверенность, Период,  ОкончаниеДействия, СканДоверенности", 
						Запись.Подписант, Запись.Доверенность, Запись.Период, Запись.ОкончаниеДействия, Запись.СканДоверенности), 
					ВызывающаяФорма);
		//Евросиб Коханенко Н.А. 07.08.2025 )) #112773 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	Запись.ОкончаниеДействия = ДобавитьМесяц(Запись.Период, 12);
	
КонецПроцедуры

&НаКлиенте
Процедура ДолжностьПриИзменении(Элемент)
	Запись.ДолжностьВРодительномПадеже = ПолучитьВРодительномПадеже(Запись.Должность); 
КонецПроцедуры      

&НаСервере
Функция ПолучитьВРодительномПадеже(СтрокаИсточник)
	Результат = ПолучитьСклоненияСтроки(СтрокаИсточник,, "ПД=Родительный");
	Возврат ?(Результат.Количество() > 0, Результат[0], "");
КонецФункции

&НаКлиенте
Процедура ФамилияПриИзменении(Элемент)
	Запись.ФИОВРодительномПадеже = ПолучитьВРодительномПадеже(Запись.Фамилия+" "+Запись.Имя+" "+Запись.Отчество); 
КонецПроцедуры

&НаКлиенте
Процедура ИмяПриИзменении(Элемент)
	Запись.ФИОВРодительномПадеже = ПолучитьВРодительномПадеже(Запись.Фамилия+" "+Запись.Имя+" "+Запись.Отчество); 
КонецПроцедуры

&НаКлиенте
Процедура ОтчествоПриИзменении(Элемент)
	Запись.ФИОВРодительномПадеже = ПолучитьВРодительномПадеже(Запись.Фамилия+" "+Запись.Имя+" "+Запись.Отчество); 
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.Контрагент, "СтранаРегистрации") = ПредопределенноеЗначение("Справочник.СтраныМира.Россия") Тогда
		Если НЕ ЗначениеЗаполнено(Запись.Должность) Тогда
			ОбщегоНазначения.СообщитьПользователю("Поле ""Должность"" не заполнено",, "Должность", Запись, Отказ); 
		КонецЕсли;
	Иначе
		Если НЕ ЗначениеЗаполнено(Запись.ДолжностьАнгл) Тогда
			ОбщегоНазначения.СообщитьПользователю("Поле ""Должность англ"" не заполнено",, "ДолжностьАнгл", Запись, Отказ); 
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПодписантПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Запись.Подписант) Тогда
		ФИОПодписанта =  ПолучитьФИОФизическогоЛица(Запись.Подписант);
		Запись.Фамилия = ФИОПодписанта.Фамилия; 
		Запись.Имя = ФИОПодписанта.Имя; 
		Запись.Отчество = ФИОПодписанта.Отчество;
		Запись.ФИОВРодительномПадеже = ПолучитьВРодительномПадеже(Запись.Фамилия+" "+Запись.Имя+" "+Запись.Отчество); 
	Иначе
		Запись.Фамилия = ""; 
		Запись.Имя = ""; 
		Запись.Отчество = "";
		Запись.ФИОВРодительномПадеже = ""; 
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьФИОФизическогоЛица(СсылкаНаФизЛицо)
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаФизЛицо, "Фамилия, Имя, Отчество"); 
КонецФункции


