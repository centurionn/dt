
// Евросиб US83437 TA83438 Рыбьяков К.А. 30.05.2024 ((
Функция ДанныеДляЗаполненияСделкиИзАкцепта(СделкаСсылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	//Запрос.Текст = 
	//"ВЫБРАТЬ
	//|	*
	//|ИЗ
	//|	РегистрСведений.АктуальныеПривязкиАкцептовВСделки КАК АктуальныеПривязкиАкцептовВСделки
	//|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеДляДобавленияСтрокАкцептовВСделку КАК ДанныеДляДобавленияСтрокАкцептовВСделку
	//|		ПО АктуальныеПривязкиАкцептовВСделки.ИдентификаторСтрокиАкцепта = ДанныеДляДобавленияСтрокАкцептовВСделку.ГУИД
	//|ГДЕ
	//|	АктуальныеПривязкиАкцептовВСделки.Сделка = &Сделка
	//|	И ДанныеДляДобавленияСтрокАкцептовВСделку.Обработано = ЛОЖЬ";
	//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 113659, 03-07-2025, начало
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АктуальныеПривязкиАкцептовВСделки.*,
	|	ДанныеДляДобавленияСтрокАкцептовВСделку.*,
	|	ДокументКорректировкаПоступления.ВидОперации КАК ВидОперацииКорректировки
	|ИЗ
	|	РегистрСведений.АктуальныеПривязкиАкцептовВСделки КАК АктуальныеПривязкиАкцептовВСделки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеДляДобавленияСтрокАкцептовВСделку КАК ДанныеДляДобавленияСтрокАкцептовВСделку
	|		ПО АктуальныеПривязкиАкцептовВСделки.ИдентификаторСтрокиАкцепта = ДанныеДляДобавленияСтрокАкцептовВСделку.ГУИД
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КорректировкаПоступления КАК ДокументКорректировкаПоступления
	|		ПО АктуальныеПривязкиАкцептовВСделки.Поступление = ДокументКорректировкаПоступления.Ссылка
	|ГДЕ
	|	АктуальныеПривязкиАкцептовВСделки.Сделка = &Сделка
	|	И ДанныеДляДобавленияСтрокАкцептовВСделку.Обработано = ЛОЖЬ";
	//Евросиб(ДИТ), Беляев СЮ, US 113658 / TA 113659, 03-07-2025, конец
	
	Запрос.УстановитьПараметр("Сделка", СделкаСсылка); 

	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выгрузка = РезультатЗапроса.Выгрузить();
		
		СтрокиЗаполненияСделки = Новый Массив;
	
		ОписаниеТипа = Новый ОписаниеТипов("СписокЗначений");
		Выгрузка.Колонки.Добавить("СписокКТК", ОписаниеТипа); 
		Выгрузка.Колонки.Добавить("СписокВагонов", ОписаниеТипа); 
		Выгрузка.Колонки.Добавить("СписокТД", ОписаниеТипа); 
		
 		Для Каждого Строка Из Выгрузка Цикл
			
			СписокКТК = Новый СписокЗначений;
			Если ЗначениеЗаполнено(Строка.Контейнер) Тогда
				СписокКТК.Добавить(Строка.Контейнер);
			КонецЕсли;
			Строка.СписокКТК = СписокКТК;
			
			СписокВагонов = Новый СписокЗначений;
			Если ЗначениеЗаполнено(Строка.Вагон) Тогда
				СписокВагонов.Добавить(Строка.Вагон);
			КонецЕсли;
			Строка.СписокВагонов = СписокВагонов;
			
			СписокТД = Новый СписокЗначений;
			Если ЗначениеЗаполнено(Строка.ТранспортныйДокумент) Тогда
				СписокТД.Добавить(Строка.ТранспортныйДокумент);
			КонецЕсли;
			Строка.СписокТД = СписокТД;
			
			СтрокиЗаполненияСделки.Добавить(Строка);	
			
		КонецЦикла;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Новый Структура("ОбрабатываемыеСтроки", СтрокиЗаполненияСделки);
	
КонецФункции
// Евросиб Рыбьяков К.А. 30.05.2024 ))

