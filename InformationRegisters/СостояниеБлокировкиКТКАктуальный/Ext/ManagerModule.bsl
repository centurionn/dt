Процедура СформироватьЗаписьАктуального(СтрокаНабора) Экспорт
	Если Не ЭтоМаксДата(СтрокаНабора) Тогда
		//Сообщить("Возврат");
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.СостояниеБлокировкиКТКАктуальный.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи,СтрокаНабора);
	//Сообщить("Формируем актуальный");
	МенеджерЗаписи.Записать();
КонецПроцедуры

Функция ЭтоМаксДата(СтрокаНабора)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МАКСИМУМ(СостояниеБлокировкиКТКСрезПоследних.ДатаПереноса) КАК ДатаПереноса
		|ИЗ
		|	РегистрСведений.СостояниеБлокировкиКТК.СрезПоследних(, КТК = &КТК) КАК СостояниеБлокировкиКТКСрезПоследних
		|
		|ИМЕЮЩИЕ
		|	МАКСИМУМ(СостояниеБлокировкиКТКСрезПоследних.ДатаПереноса) <= &ДатаПереноса";
	
	Запрос.УстановитьПараметр("ДатаПереноса", СтрокаНабора.ДатаПереноса);
	Запрос.УстановитьПараметр("КТК", СтрокаНабора.КТК);
	
	РезультатЗапроса = Запрос.Выполнить();
	//Сообщить(Не РезультатЗапроса.Пустой());
	Возврат Не РезультатЗапроса.Пустой();
КонецФункции