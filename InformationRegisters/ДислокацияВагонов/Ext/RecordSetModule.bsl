
Процедура ПередЗаписью(Отказ, Замещение)
	Если ОбменДанными.Загрузка = Истина Тогда
		Возврат;
	КонецЕсли; 
	
	Для Каждого ТекСтрока из ЭтотОбъект Цикл
		
		// если получили операцию, по которой необходимо информировать пользователя, 
		// занести данные в РС РассылкаПоОперациям
		Если ТекСтрока.ОперацияСВагоном.ИнформироватьПользователей Тогда
			МенеджерЗаписи = РегистрыСведений.РассылкаПоОперациям.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Вагон = ТекСтрока.Вагон;
			МенеджерЗаписи.Операция = ТекСтрока.ОперацияСВагоном;
			МенеджерЗаписи.Период = ТекСтрока.Период;
			МенеджерЗаписи.Записать();
		КонецЕсли;		
		
		// если вагон отцеплен, создать для него операцию
		Если ТекСтрока.ОперацияСВагоном.БросаниеВагона = ИСТИНА Тогда
			// 1. Выбираем вагон в отправке
			// 2. Ищем отправку в сделке, у которой последняя дата либо пустая, либо больше текущей
			// 3. по РС ТехнологическаяСхема находим нужную технологическую схему для найденной сделки
			// 4. в ТЧ справочника ТехнологическаяСхема находим операции ЖДОтправка. Если нашли, то взять ее ГУИД,
			// чтобы указать как родительский. Если не нашли, то при создании новой операции установить Родитель1 пустым (корень)
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	ВагоныВОтправке.Отправка КАК Отправка,
			               |	ВагоныВОтправке.Вагон КАК Вагон
			               |ПОМЕСТИТЬ ВагонОтправка
			               |ИЗ
			               |	РегистрСведений.ВагоныВОтправке КАК ВагоныВОтправке
			               |ГДЕ
			               |	ВагоныВОтправке.Вагон = &Вагон
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	СделкаРейсы.Ссылка КАК Сделка,
			               |	СделкаРейсы.Рейс КАК Рейс,
			               |	ВагонОтправка.Вагон КАК Вагон
			               |ПОМЕСТИТЬ СделкиСОтправками
			               |ИЗ
			               |	Документ.Сделка.Рейсы КАК СделкаРейсы
			               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВагонОтправка КАК ВагонОтправка
			               |		ПО СделкаРейсы.Рейс = ВагонОтправка.Отправка
			               |ГДЕ
			               |	(СделкаРейсы.Ссылка.ПоследняяОперация >= &ТекДата
			               |			ИЛИ СделкаРейсы.Ссылка.ПоследняяОперация = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	СделкиСОтправками.Сделка КАК Сделка,
			               |	СделкиСОтправками.Рейс КАК Рейс,
			               |	СделкиСОтправками.Вагон КАК Вагон,
			               |	ТехнологическаяСхема.ТСх КАК ТСх
			               |ПОМЕСТИТЬ ТСхема
			               |ИЗ
			               |	РегистрСведений.ТехнологическаяСхема КАК ТехнологическаяСхема
			               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СделкиСОтправками КАК СделкиСОтправками
			               |		ПО ТехнологическаяСхема.ПредметТСх = СделкиСОтправками.Сделка
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ РАЗЛИЧНЫЕ
			               |	ТехнологическаяСхемаТЧ.Операция КАК Операция,
			               |	ОперацияГрузы.Ссылка КАК ЖДОперация,
			               |	ТехнологическаяСхемаТЧ.Ссылка КАК ТСхСсылка,
			               |	ТехнологическаяСхемаТЧ.ГУИД КАК ГУИД
			               |ИЗ
			               |	Справочник.ТехнологическаяСхема.ТЧ КАК ТехнологическаяСхемаТЧ
			               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Операция.Грузы КАК ОперацияГрузы
			               |		ПО ТехнологическаяСхемаТЧ.Операция = ОперацияГрузы.Ссылка
			               |			И (ОперацияГрузы.ТС В
			               |				(ВЫБРАТЬ
			               |					ВагонОтправка.Вагон
			               |				ИЗ
			               |					ВагонОтправка КАК ВагонОтправка))
			               |			И (ОперацияГрузы.Ссылка.Услуга = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.ЖДОтправка))
			               |ГДЕ
			               |	ТехнологическаяСхемаТЧ.Ссылка В
			               |			(ВЫБРАТЬ
			               |				ТСхема.ТСх
			               |			ИЗ
			               |				ТСхема КАК ТСхема)
			               |
			               |УПОРЯДОЧИТЬ ПО
			               |	ОперацияГрузы.Ссылка УБЫВ";
			Запрос.УстановитьПараметр("Вагон",ТекСтрока.Вагон);
			Запрос.УстановитьПараметр("ТекДата",ТекущаяДата());
			ТЗ = Запрос.Выполнить().Выгрузить();
			Если ТЗ.Количество()>0 Тогда
				// создаем операцию
				НоваяОпер = Документы.Операция.СоздатьДокумент();
				НоваяОпер.Заполнить(неопределено);
				НоваяОпер.Дата = ТекущаяДата();
				НоваяОпер.Автор = Пользователи.ТекущийПользователь();
				НоваяОпер.ЦФО = НоваяОпер.Автор.ЦФО;
				НоваяОпер.Создано = ТекущаяДата();
				НоваяОпер.ТребуетсяМаршрутизироватьВОбходВсехПравил = Истина;
				
				ЗаполнитьЗначенияСвойств(НоваяОпер,ТЗ[0].ЖДОперация,"Услуга,ТипДлительности,Срок,Поставщик,Договор,Валюта,СтавкаНДС,ВключаетНДС,Регламентный,Маршрутизировать,ПланФакт,Подразделение,Сделка,РейсЖД,Организация,"); 
				НоваяОпер.ПунктОтправления = ТекСтрока.СтанцияОперации;
				НоваяОпер.ПунктНазначения = ТекСтрока.СтанцияНазначения;
				РасстояниеМеждуСтн = РегистрыСведений.РасстоянияМеждуЛокациями.ПолучитьРасстояние(ТекСтрока.СтанцияОперации,ТекСтрока.СтанцияНазначения);
				ДатаПрибытия = ТекСтрока.Период+(РасстояниеМеждуСтн/350)*3600*24;
				НоваяОпер.ДатаОтправленияФакт = ТекСтрока.Период;
				НоваяОпер.ДатаНазначения = ДатаПрибытия;
				НовСтр = НоваяОпер.Грузы.Добавить();
				НовСтр.ТСГУИД = Новый УникальныйИдентификатор;
				НовСтр.ТС = ТекСтрока.Вагон;
				НовСтр.ДатаПрибытия = ДатаПрибытия;
				НовСтр.ДатаОтправления = ТекСтрока.Период;
				НовСтр.ТипТС = ТекСтрока.Вагон.ТипТС;
				
				НоваяОпер.Записать(РежимЗаписиДокумента.Проведение);
				СсылкаОпер = НоваяОпер.Ссылка;
				
				// записываем операцию в справочник ТехнологическаяСхема
				ТСх = ТЗ[0].ТСхСсылка;
				Родитель1 = ТЗ[0].ГУИД;
				ПолучОб = ТСх.ПолучитьОбъект();
				НовСтр = ПолучОб.ТЧ.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр, СсылкаОпер);
				НовСтр.ГУИД = Новый УникальныйИдентификатор;
				НовСтр.Родитель1 = Родитель1;
				НовСтр.Операция = СсылкаОпер;
				ПолучОб.Записать();
				
			КонецЕсли;
		КонецЕсли;
		
		
		//////////////////// Иван - 14-11-19 - доп условие, что если разрешена запись сроков перемещения между станциями, то записываем в регистр сведений СрокиПеремещенияМеждуСтанциями ////
		
		Если Константы.СохранятьРасстояниеМеждуСтанциямиПриПолученииДислокации.Получить() = Истина Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	ДислокацияВагонов.Вагон КАК Вагон,
			               |	ДислокацияВагонов.ОперацияСВагоном КАК ОперацияСВагоном,
			               |	ДислокацияВагонов.Период КАК Период,
			               |	ДислокацияВагонов.СтанцияОперации КАК СтанцияОперации
			               |ИЗ
			               |	РегистрСведений.ДислокацияВагонов КАК ДислокацияВагонов
			               |ГДЕ
			               |	ДислокацияВагонов.Вагон = &Вагон
			               |	И ДислокацияВагонов.ИндексПоезда = &ИндексПоезда
			               |	И ДислокацияВагонов.Период <> &Период
			               |	И ДислокацияВагонов.СтанцияОперации <> &СтанцияОперации
			               |	И (ДислокацияВагонов.ОперацияСВагоном.ОтправлениеСоСтанции
			               |			ИЛИ ДислокацияВагонов.ОперацияСВагоном.ПрибытиеНаСтанцию)
			               |
			               |УПОРЯДОЧИТЬ ПО
			               |	ДислокацияВагонов.Период УБЫВ";
			Запрос.УстановитьПараметр("Вагон", ТекСтрока.Вагон);
			Запрос.УстановитьПараметр("ИндексПоезда", ТекСтрока.ИндексПоезда);
			Запрос.УстановитьПараметр("Период", ТекСтрока.Период);
			Запрос.УстановитьПараметр("СтанцияОперации", ТекСтрока.СтанцияОперации);
			Ответ = Запрос.Выполнить().Выбрать();
			Если Ответ.Следующий() Тогда
				
				ВремяВПути = (ТекСтрока.Период - Ответ.Период)/60/60;
				СтОтправления = Ответ.СтанцияОперации;
				СтНазначения = ТекСтрока.СтанцияОперации;
				
				МЗ = РегистрыСведений.СрокиПеремещенияМеждуСтанциями.СоздатьМенеджерЗаписи();
				МЗ.ВремяПеремещенияЧас = ВремяВПути;
				МЗ.Период = текущаядата();
				МЗ.Станция1 = СтОтправления;
				МЗ.Станция2 = СтНазначения;
				МЗ.Записать(Истина);
				
			КонецЕсли;
			
		КонецЕсли;
		
		// заполнение регистра ОперацииДляДвиженияПоСлежению только в том случае, если нашли этот вагон
		
		// интересует вагон с операциями, у которых есть признаки ПОГРУЗКА ИЛИ ((ОтправлениеСоСтанции ИЛИ ПрибытиеНаСтанцию) И Порожний)
		Если ТекСтрока.ОперацияСВагоном.Погрузка ИЛИ 
			((ТекСтрока.ОперацияСВагоном.ОтправлениеСоСтанции ИЛИ
			ТекСтрока.ОперацияСВагоном.ПрибытиеНаСтанцию) И
			ТекСтрока.Груженый = Ложь) Тогда
		
			МассивВидовСлежений = Новый Массив;
			МассивВидовСлежений.Добавить(Перечисления.ВидыДвиженийПоОперациямСлежения.Порожний);
			МассивВидовСлежений.Добавить(Перечисления.ВидыДвиженийПоОперациямСлежения.Погрузка);
			МассивВидовСлежений.Добавить(Перечисления.ВидыДвиженийПоОперациямСлежения.Подсыл);
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	ОперацииДляДвиженияПоСлежению.Регистратор КАК Регистратор,
			               |	ОперацииДляДвиженияПоСлежению.НомерСтроки КАК НомерСтроки,
			               |	ОперацииДляДвиженияПоСлежению.Активность КАК Активность,
			               |	ОперацииДляДвиженияПоСлежению.Операция КАК Операция,
			               |	ОперацииДляДвиженияПоСлежению.ВидДвиженияПоСлежению КАК ВидДвиженияПоСлежению,
			               |	ОперацииДляДвиженияПоСлежению.ДатаНачала КАК ДатаНачала,
			               |	ОперацииДляДвиженияПоСлежению.ДатаОкончания КАК ДатаОкончания,
			               |	ОперацииДляДвиженияПоСлежению.СписокТС КАК СписокТС,
			               |	ОперацииДляДвиженияПоСлежению.СписокТЕ КАК СписокТЕ,
			               |	ОперацииДляДвиженияПоСлежению.ОперацияНачата КАК ОперацияНачата,
			               |	ОперацииДляДвиженияПоСлежению.Вагон КАК Вагон
			               |ИЗ
			               |	РегистрСведений.ОперацииДляДвиженияПоСлежению КАК ОперацииДляДвиженияПоСлежению
			               |ГДЕ
			               |	ОперацииДляДвиженияПоСлежению.Вагон = &Вагон
			               |	И ОперацииДляДвиженияПоСлежению.ВидДвиженияПоСлежению В (&ВидДвиженияПоСлежению)";
			Запрос.УстановитьПараметр("Вагон",ТекСтрока.Вагон);
			Запрос.УстановитьПараметр("ВидДвиженияПоСлежению",МассивВидовСлежений);
			Ответ = Запрос.Выполнить().Выбрать();
			Если Ответ.Следующий() Тогда
				
				НаборЗаписей = РегистрыСведений.ОперацииДляДвиженияПоСлежению.СоздатьНаборЗаписей(); 
				НаборЗаписей.Отбор.Регистратор.Установить(Ответ.Регистратор);
				НаборЗаписей.Прочитать();
					  	
				Для каждого МЗ Из НаборЗаписей Цикл
					Если МЗ.Операция = Ответ.Операция И
						МЗ.ВидДвиженияПоСлежению = Ответ.ВидДвиженияПоСлежению И
						МЗ.Вагон = Ответ.Вагон Тогда
						
						// если это Комплексная услуга по терминaльной обработке (Погрузка), то событие одномоментное
						Если Ответ.ВидДвиженияПоСлежению = Перечисления.ВидыДвиженийПоОперациямСлежения.Погрузка И
							ТекСтрока.ОперацияСВагоном.Погрузка Тогда
							МЗ.ДатаНачала = ТекСтрока.Период;
							МЗ.ДатаОкончания = ТекСтрока.Период;
							МЗ.ИзмененоИзСлежения = Истина;
						КонецЕсли;
						
						// если это "Подсыл порожнего вагона" ИЛИ "Перевозка порожних вагонов под погрузку", 
						// то событие растянуто по времени и необходимо слежение по регистру дислокации
						Если Ответ.ВидДвиженияПоСлежению = Перечисления.ВидыДвиженийПоОперациямСлежения.Порожний ИЛИ
							Ответ.ВидДвиженияПоСлежению = Перечисления.ВидыДвиженийПоОперациямСлежения.Подсыл Тогда
							
							// 1. проверить станцию отправления
							Если ТекСтрока.ОперацияСВагоном.ОтправлениеСоСтанции Тогда
								// получить массив локаций из регистра соответствий станций
								МассивЛокаций = ПОлучитьМассивЛокаций(ТекСтрока.СтанцияОперации);
								// если нашли нужную станцию в массиве локаций (пункт отправления операции совпал с одним из элементов массива),
								// то проставляем дату отправления (начала операции) в РС ОперацииДляДвиженияПоСлежению
								Если НЕ МассивЛокаций.Найти(Ответ.Операция.ПунктОтправления) = Неопределено Тогда
									МЗ.ДатаНачала = ТекСтрока.Период;
									МЗ.ИзмененоИзСлежения = Истина;
								КонецЕсли;
							КонецЕсли;
							
							// 2. проверить станцию назначения
							Если ТекСтрока.ОперацияСВагоном.ПрибытиеНаСтанцию Тогда
								// получить массив локаций из регистра соответствий станций
								МассивЛокаций = ПОлучитьМассивЛокаций(ТекСтрока.СтанцияОперации);
								// если нашли нужную станцию в массиве локаций (пункт назначения операции совпал с одним из элементов массива),
								// то проставляем дату назначения (окончания операции) в РС ОперацииДляДвиженияПоСлежению
								Если НЕ МассивЛокаций.Найти(Ответ.Операция.ПунктНазначения) = Неопределено Тогда
									МЗ.ДатаОкончания = ТекСтрока.Период;
									МЗ.ИзмененоИзСлежения = Истина;
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
					
				НаборЗаписей.Записать();				
	
			КонецЕсли;
		КонецЕсли;
		
//Евросиб Гудкова( 20.09.2020 Ticket№ 0206314 грузим в дислокации
		//// получить из индекса поезда станцию отправления
		//Если ЗначениеЗаполнено(ТекСтрока.ИндексПоезда) Тогда
		//	КодСтанцииОтправления = Сред(ТекСтрока.ИндексПоезда,1,5);
		//	Запрос = Новый Запрос;
		//	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		//	               |	Локации.Ссылка КАК Ссылка
		//	               |ИЗ
		//	               |	Справочник.Локации КАК Локации
		//	               |ГДЕ
		//	               |	ПОДСТРОКА(Локации.КодЖДСтанции, 1, 5) = &КодЖДСтанции";
		//	Запрос.УстановитьПараметр("КодЖДСтанции",КодСтанцииОтправления);
		//	Ответ = Запрос.Выполнить().Выбрать();
		//	Если Ответ.Следующий() Тогда
		//		ТекСтрока.СтанцияОтправления = Ответ.Ссылка;
		//	КонецЕсли;
		//КонецЕсли;
// Евросиб Гудкова) 		
		
		// проверяем, какая станция операции занесена в предыдущей записи. если
		// она совпадает с текущей, то в текущую запись вносим из предыдущей дату прибытия на станцию
		// и в простой на станции вносим дельту от текущего периода и даты прибытия на станцию.
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	МАКСИМУМ(ДислокацияВагоновСрезПоследних.Период) КАК Период,
		               |	ДислокацияВагоновСрезПоследних.Вагон КАК Вагон
		               |ПОМЕСТИТЬ РСПериод
		               |ИЗ
