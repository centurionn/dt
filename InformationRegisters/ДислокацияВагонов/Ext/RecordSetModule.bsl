				// изменить существующую запись
				ТекЗапись = РегистрыСведений.ПовагонныеОтправки.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(ТекЗапись,Выборка);
				ТекЗапись2 = РегистрыСведений.ПовагонныеОтправки.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(ТекЗапись2, Выборка);
				ТекЗапись.Прочитать();
				
				Если НЕ ТекЗапись.Выбран() Тогда
					ЗаполнитьЗначенияСвойств(ТекЗапись, ТекЗапись2);
				КонецЕсли;
				
				ТекЗапись.СобытиеВыводаИзПовагонки = Перечисления.СобытияВыводаИзПовагонки.ПризнакСтанцииПовагонкаВКП;
				ТекЗапись.ВыводИзПовагонки  = ТекСтрока.Период;
				ТекЗапись.СтанцияВывода  = ТекСтрока.СтанцияОперации;
				ТекЗапись.ДатаПрибытияНаСтанциюНазначения = ТекСтрока.Период;
				ТекЗапись.ДатаОкончанияПользования = ТекСтрока.Период;
