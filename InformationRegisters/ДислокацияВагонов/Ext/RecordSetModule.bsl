				ТекЗапись.РегионОтправления = ТекСтрока.СтанцияНазначения;
				ТекЗапись.ДатаОперации = ТекСтрока.Период;
				ТекЗапись.РасстояниеДоНазначения = РегистрыСведений.РасстоянияМеждуЛокациями.ПолучитьРасстояние(ТекСтрока.СтанцияОперации,ТекСтрока.СтанцияНазначения);

				ТекЗапись.Записать();
			КонецЕсли;
			
		КонецЕсли;
		
		// 4. изменить данные по дислокации у планируемых вагонов
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ВагоныЗапланированныеКПовагонке.Вагон КАК Вагон,
		               |	ВагоныЗапланированныеКПовагонке.СтанцияОперации КАК СтанцияОперации,
		               |	ВагоныЗапланированныеКПовагонке.ОперацияСВагоном КАК ОперацияСВагоном,
		               |	ВагоныЗапланированныеКПовагонке.ДатаОперации КАК ДатаОперации,
		               |	ВагоныЗапланированныеКПовагонке.Груженый КАК Груженый,
		               |	ВагоныЗапланированныеКПовагонке.РасстояниеДоНазначения КАК РасстояниеДоНазначения,
		               |	ВагоныЗапланированныеКПовагонке.СобытиеПереводаВПовагонку КАК СобытиеПереводаВПовагонку,
		               |	ВагоныЗапланированныеКПовагонке.Клиент КАК Клиент,
		               |	ВагоныЗапланированныеКПовагонке.Договор КАК Договор,
		               |	ВагоныЗапланированныеКПовагонке.Заявка КАК Заявка,
		               |	ВагоныЗапланированныеКПовагонке.ПСЦ КАК ПСЦ,
		               |	ВагоныЗапланированныеКПовагонке.Комментарий КАК Комментарий,
		               |	ВагоныЗапланированныеКПовагонке.РегионОтправления КАК РегионОтправления,
		               |	ВагоныЗапланированныеКПовагонке.ДатаПомещенияВРежимПовагонки КАК ДатаПомещенияВРежимПовагонки
		               |ИЗ
		               |	РегистрСведений.ВагоныЗапланированныеКПовагонке КАК ВагоныЗапланированныеКПовагонке
		               |ГДЕ
		               |	ВагоныЗапланированныеКПовагонке.Вагон = &Вагон";
		
		Запрос.УстановитьПараметр("Вагон", ТекСтрока.Вагон);
		Ответ = Запрос.Выполнить().Выбрать();
		Если Ответ.Следующий() Тогда
			ТекЗапись = РегистрыСведений.ВагоныЗапланированныеКПовагонке.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(ТекЗапись,Ответ);
			ТекЗапись2 = РегистрыСведений.ВагоныЗапланированныеКПовагонке.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(ТекЗапись2, ТекЗапись);
			
			ТекЗапись.Прочитать();
			Если НЕ ТекЗапись.Выбран() Тогда
				ЗаполнитьЗначенияСвойств(ТекЗапись, ТекЗапись2);
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(ТекЗапись,ТекСтрока,"СтанцияОперации,ОперацияСВагоном,Груженый");
			ТекЗапись.ОперацияСВагоном = ТекСтрока.ОперацияСВагоном;
			ТекЗапись.ДатаОперации = ТекСтрока.Период;
			ТекЗапись.РасстояниеДоНазначения = Локации_сервер.ПолучитьРасстояниеМеждуСтанциями(ТекСтрока.СтанцияОперации,ТекСтрока.СтанцияНазначения);
			
			ТекЗапись.Записать();
			
		КонецЕсли;
				

		
		/////////////////////////////////////////////////////////////////\\\\\\ ПОВАГОНКА
		
		
		
	КонецЦикла;
		
КонецПроцедуры

Функция ПолучитьМассивЛокаций(СтанцияОперации)
	
	МассивЛокаций = новый Массив;
	
	ЗапросЛокаций = Новый Запрос;
	ЗапросЛокаций.Текст = "ВЫБРАТЬ
	                      |	АналогиЛокаций.Локация КАК Локация,
	                      |	АналогиЛокаций.Аналог КАК Аналог
	                      |ИЗ
	                      |	РегистрСведений.АналогиЛокаций КАК АналогиЛокаций
	                      |ГДЕ
	                      |	(АналогиЛокаций.Локация = &Локация
	                      |			ИЛИ АналогиЛокаций.Аналог = &Локация)";
	ЗапросЛокаций.УстановитьПараметр("Локация", СтанцияОперации);
	ОтветЛокаций = ЗапросЛокаций.Выполнить().Выбрать();
	Пока ОтветЛокаций.Следующий() Цикл
		МассивЛокаций.Добавить(ОтветЛокаций.Локация);
		МассивЛокаций.Добавить(ОтветЛокаций.Аналог);
	КонецЦикла;
	МассивЛокаций.Добавить(СтанцияОперации);

	Возврат МассивЛокаций;
	
КонецФункции

Процедура ПриЗаписи(Отказ, Замещение)
	
	// проверяем, есть ли в РС ОперацииДляДвиженияПоСлежению записи, который были изменены из данного регистра.
	// если да, то внести эти изменения в операции. сразу же нельзя вносить, т.к. для получения шапки операции
	// (дата отправления и дата назначения) нужно иметь заполненными все даты операций по вагонам. а т.к. вагоны 
	// из операции могут приходить в разном порядке, чтобы не записывать одну и ту же операцию несколько раз,
	// сгруппируем данные по операции.

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОперацииДляДвиженияПоСлежению.Регистратор КАК Регистратор,
		|	ОперацииДляДвиженияПоСлежению.НомерСтроки КАК НомерСтроки,
		|	ОперацииДляДвиженияПоСлежению.Активность КАК Активность,
		|	ОперацииДляДвиженияПоСлежению.Операция КАК Операция,
		|	ОперацииДляДвиженияПоСлежению.ВидДвиженияПоСлежению КАК ВидДвиженияПоСлежению,
		|	ОперацииДляДвиженияПоСлежению.ДатаНачала КАК ДатаНачала,
		|	ОперацииДляДвиженияПоСлежению.ДатаОкончания КАК ДатаОкончания,
		|	ОперацииДляДвиженияПоСлежению.СписокТС КАК СписокТС,
		|	ОперацииДляДвиженияПоСлежению.СписокТЕ КАК СписокТЕ,
		|	ОперацииДляДвиженияПоСлежению.ОперацияНачата КАК ОперацияНачата,
		|	ОперацииДляДвиженияПоСлежению.Вагон КАК Вагон,
		|	ОперацииДляДвиженияПоСлежению.ИзмененоИзСлежения КАК ИзмененоИзСлежения
		|ИЗ
		|	РегистрСведений.ОперацииДляДвиженияПоСлежению КАК ОперацииДляДвиженияПоСлежению
		|ГДЕ
		|	ОперацииДляДвиженияПоСлежению.ИзмененоИзСлежения
		|ИТОГИ ПО
		|	Операция";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОперация = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаОперация.Следующий() Цикл
	
		ПолучОб = ВыборкаОперация.Операция.ПолучитьОбъект();
		
		ВыборкаДетальныеЗаписи = ВыборкаОперация.Выбрать();
	
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("ТС",ВыборкаДетальныеЗаписи.Вагон);
			НайденныйВаг = ПолучОб.Грузы.НайтиСтроки(ПараметрыОтбора);
			Если НайденныйВаг.Количество()>0 Тогда
				Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ДатаНачала) Тогда
					НайденныйВаг[0].ДатаОтправления = ВыборкаДетальныеЗаписи.ДатаНачала;
				КонецЕсли;
				Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ДатаОкончания) Тогда
					НайденныйВаг[0].ДатаПрибытия = ВыборкаДетальныеЗаписи.ДатаОкончания;
				КонецЕсли;
			КонецЕсли;
			
			// изменить данные РС ОперацииДляДвиженияПоСлежению
			НаборЗаписей = РегистрыСведений.ОперацииДляДвиженияПоСлежению.СоздатьНаборЗаписей(); 
			НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаДетальныеЗаписи.Регистратор);
			НаборЗаписей.Прочитать();
				  	
			Для каждого МЗ Из НаборЗаписей Цикл
				Если МЗ.Операция = ВыборкаДетальныеЗаписи.Операция И
					МЗ.ВидДвиженияПоСлежению = ВыборкаДетальныеЗаписи.ВидДвиженияПоСлежению И
					МЗ.Вагон = ВыборкаДетальныеЗаписи.Вагон Тогда
					
					МЗ.ИзмененоИзСлежения = Ложь;
				КонецЕсли;
			КонецЦикла;
			
			НаборЗаписей.Записать();				
			
		КонецЦикла;
		
		Попытка
			ПолучОб.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
		
	КонецЦикла;
	
	// SIV 30.08.20 (отметка о фактическом начале рейса для табельного расписания)
	Для каждого Стр из ЭтотОбъект Цикл
		
		Если Стр.ОперацияСВагоном.ОтправлениеСоСтанции И НЕ ИндексПоездаЗарегистрирован(Стр.ИндексПоезда) Тогда
			
			ПодходящийРейс = Слежение_сервер.ПолучитьПодходящийРейс(Стр.СтанцияОтправления, Стр.СтанцияНазначения, Стр.Период, СТр.Вагон);
			Если ПодходящийРейс <> неопределено Тогда
				
				МЗ = РегистрыСведений.ОтметкаФактНачалаРейсов.СоздатьМенеджерЗаписи();
				МЗ.ЗарегистрированоПоВагону = Стр.Вагон;
				МЗ.ИндексПоезда = СТр.ИндексПоезда;
				МЗ.РейсЖД = ПодходящийРейс;
				МЗ.ФактическоеНачало = Стр.Период;
				МЗ.Записать(Истина);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	

КонецПроцедуры

Функция ИндексПоездаЗарегистрирован(ИндексПоезда)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОтметкаФактНачалаРейсов.РейсЖД КАК РейсЖД
	               |ИЗ
	               |	РегистрСведений.ОтметкаФактНачалаРейсов КАК ОтметкаФактНачалаРейсов
	               |ГДЕ
	               |	ОтметкаФактНачалаРейсов.ИндексПоезда = &ИндексПоезда";
	Запрос.УстановитьПараметр("ИндексПоезда", ИндексПоезда);
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции





