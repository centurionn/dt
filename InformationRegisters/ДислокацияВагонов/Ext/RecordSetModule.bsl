		//ПрибытиеВНазначение = Локации_сервер.ПолучитьСовпадениеСтанций(ТекСтрока.СтанцияОперации,ТекСтрока.СтанцияНазначения);
		ПрибытиеВНазначение = ТекСтрока.СтанцияОперации = ТекСтрока.СтанцияНазначения;
		ПрибытиеВРегионОтправления = РаботаСПовагоннымиОтправками.ПолучитьРегионОтправления(ТекСтрока.СтанцияОперации,ТекСтрока.Вагон);
