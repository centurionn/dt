Процедура ПередЗаписью(Отказ, Замещение)
	ТекПользователь = Пользователи.АвторизованныйПользователь();
	ТЧНабора = ЭтотОбъект.Выгрузить();
	ТЧНабора.ЗаполнитьЗначения(ТекПользователь, "АвторИзменений");
	ЭтотОбъект.Загрузить(ТЧНабора);
КонецПроцедуры

