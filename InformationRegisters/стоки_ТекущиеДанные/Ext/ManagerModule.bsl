//Евросиб Каблов 10.11.2022 ( 52045
//Процедура ДобавитьЗапись(КТК, НаборИзмененныхПолей, Знач Период = неопределено, ИспПроверкиПривязки=Истина) Экспорт
//Евросиб Коханенко Н.А. #63323 02.02.2023 (( 
//Процедура ДобавитьЗапись(КТК, НаборИзмененныхПолей, Знач Период = неопределено, ИспПроверкиПривязки=Истина, ВыводитьСообщения = Истина) Экспорт
Процедура ДобавитьЗапись(КТК, НаборИзмененныхПолей, Знач Период = неопределено, ИспПроверкиПривязки=Истина, ВыводитьСообщения = Истина, ТипИсточникаЗаписи = Неопределено) Экспорт
//Евросиб Коханенко Н.А. #63323 02.02.2023 )) 
//Процедура ДобавитьЗапись(КТК, НаборИзмененныхПолей, Знач Период = неопределено, ИспПроверкиПривязки=Истина, ВыводитьСообщения = Истина) Экспорт
//Евросиб Каблов 10.11.2022 )	
	Если Период = неопределено Тогда Период = ТекущаяДата(); КонецЕсли;
	
	ДоступноПраво_ИзменениеСобственника = РольДоступна("армктк_ИзменениеСобственникаКТК") ИЛИ РольДоступна("ПолныеПрава");
	ДоступноПраво_ИзменениеСВВ = РольДоступна("армктк_ИзменениеСВВ") ИЛИ РольДоступна("ПолныеПрава");
	ДоступноПраво_ИзменениеВЭксплуатации = РольДоступна("арм_ктк_ИзменениеВЭксплуатации") ИЛИ РольДоступна("ПолныеПрава");
	ДоступноПраво_арм_ктк_РазрешитьИзменениеДатыПриемаИВозврата = РольДоступна("арм_ктк_РазрешитьИзменениеДатыПриемаИВозврата") Или РольДоступна("ПолныеПрава");
	//Евросиб Каблов 15.10.2021 ( TASK 39044
	ДоступноПраво_КонтейнернойГруппы = РольДоступна("арм_ктк_ПраваКонтейнернойГруппы") Или РольДоступна("ПолныеПрава");
	//Евросиб Каблов 15.10.2021 )
	МЗ = РегистрыСведений.стоки_ТекущиеДанные.СоздатьМенеджерЗаписи();
	
	// восстанавливаем данные предыдущией записи
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	*
	|ИЗ
	|	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних(&Период, КТК = &КТК) КАК стоки_ТекущиеДанныеСрезПоследних";
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("КТК", КТК);
	Ответ = Запрос.Выполнить().Выбрать();
	Если Ответ.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(МЗ, Ответ);
	// Евросиб(ДИТ) BUG 99736 ТА 99737 Сержантова А.С. Начало: 22.01.2025
	//если делается первая запись по КТК и нет в изменяемых полях статуса, то ставим статус Свободен
	ИначеЕсли НаборИзмененныхПолей.Получить("тек_Статус") = Неопределено 
		или НаборИзмененныхПолей.Получить("тек_Статус") = Перечисления.СтатусыКТК.ПустаяСсылка() Тогда 
		МЗ.тек_Статус = Перечисления.СтатусыКТК.Свободен;
	// Евросиб(ДИТ) BUG 99736 ТА 99737 Сержантова А.С. Конец: 22.01.2025
	КонецЕсли;
	
	МЗ.Период = Период;
	МЗ.ГУИДЗаписи = Строка(Новый УникальныйИдентификатор);
	МЗ.КТК = КТК;
	Если НЕ ЗначениеЗаполнено(МЗ.ПорядковыйНомерЦиклаАрендыКТК) Тогда 
		МЗ.ПорядковыйНомерЦиклаАрендыКТК = 1; 
	КонецЕсли;  
	// ДИТ US 79304 ТА 79312 Сержантова А.С. Начало: 17.04.2024
	МЗ.тек_Пользователь = Пользователи.ТекущийПользователь();	
	// ДИТ US 79304 ТА 79312 Сержантова А.С. Конец: 17.04.2024
	ИсточникЗаписи = НаборИзмененныхПолей.Получить("ИсточникЗаписи");
	
	//Евросиб Каблов 16.08.2022 ( US41519
	КлиентскийКТКизЗаявки = НаборИзмененныхПолей.Получить("КлиентскийКТКизЗаявки");
	Если КлиентскийКТКизЗаявки = Неопределено Тогда
		КлиентскийКТКизЗаявки = Ложь;
	КонецЕсли;
	//Евросиб Каблов 16.08.2022 )
	
	СписокПолейКоторыеЗапрещеноМенятьИзЗаявкиИАСУТК = Новый Массив;
	//Евросиб Каблов 16.08.2022 ( US41519
	//СписокПолейКоторыеЗапрещеноМенятьИзЗаявкиИАСУТК.Добавить("тек_Собственник");
	//СписокПолейКоторыеЗапрещеноМенятьИзЗаявкиИАСУТК.Добавить("тек_ВидСобственности");
	Если Не КлиентскийКТКизЗаявки Тогда
		СписокПолейКоторыеЗапрещеноМенятьИзЗаявкиИАСУТК.Добавить("тек_Собственник");
		СписокПолейКоторыеЗапрещеноМенятьИзЗаявкиИАСУТК.Добавить("тек_ВидСобственности");
	КонецЕсли;
	//Евросиб Каблов 16.08.2022 )
	СписокПолейКоторыеЗапрещеноМенятьИзЗаявкиИАСУТК.Добавить("тек_СрокВозврата");
	СписокПолейКоторыеЗапрещеноМенятьИзЗаявкиИАСУТК.Добавить("тек_ДатаПриемаВПользование");
	
	ПредполагаемаяДатаПриемаВПользование = неопределено;
	
	//// Шейко О.Е. 05.05.2021 (Изменение дат для формирования Аренды КТК)
	Если ИспПроверкиПривязки Тогда
		
		// Если меняются даты "тек_ДатаПриемаВПользование" и "тек_СрокВозврата", то появляется новый период использования 
		// привязки к старому периоду должны сохраниться в полном объеме
		// Если появляется информация о ремонте, то обновим все привязки, пересекающиеся с с периодом ремонта
		ИзмНачалоРемонта = НаборИзмененныхПолей.Получить("тек_НачалоРемонта");
		ИзмОкончаниеРемонта = НаборИзмененныхПолей.Получить("тек_ОкончаниеРемонта");
		Если ИзмНачалоРемонта <> Неопределено
			ИЛИ ИзмОкончаниеРемонта <> Неопределено Тогда
			
			ПерепривязкаВыйти = Ложь;
			НовЗнНачалоРемонта = ?(ИзмНачалоРемонта = Неопределено, МЗ.тек_НачалоРемонта, ИзмНачалоРемонта);
			НовЗнОкончаниеРемонта = ?(ИзмОкончаниеРемонта = Неопределено, МЗ.тек_ОкончаниеРемонта, ИзмОкончаниеРемонта);
			
			// ДИТ Поморцева Т.П. Задача 38715 16.09.21. начало (временно)
			//Если ЗначениеЗаполнено(МЗ.тек_НачалоРемонта) И МЗ.тек_НачалоРемонта <> НовЗнНачалоРемонта Тогда
			//	
			//	КонРемонта = ?(МЗ.тек_ОкончаниеРемонта = Дата(1,1,1), Дата(2099,01,01), МЗ.тек_ОкончаниеРемонта);
			//	РегистрыСведений.стоки_КлиентскоеОперирование.ПоискПривязокПТУ_и_запускПересчетаАренды(МЗ.тек_НачалоРемонта, КонРемонта);
			//	
			//КонецЕсли;
			//
			//Если ЗначениеЗаполнено(НовЗнНачалоРемонта) И МЗ.тек_НачалоРемонта <> НовЗнНачалоРемонта Тогда
			//
			//	КонРемонта = ?(НовЗнОкончаниеРемонта = Дата(1,1,1), Дата(2099,01,01), НовЗнОкончаниеРемонта);
			//	РегистрыСведений.стоки_КлиентскоеОперирование.ПоискПривязокПТУ_и_запускПересчетаАренды(НовЗнНачалоРемонта, КонРемонта);
			//
			//КонецЕсли; 
			// ДИТ Поморцева Т.П. Задача 38715 16.09.21. конец (временно)
			
		КонецЕсли;
		
	КонецЕсли;
	
	//Евросиб Каблов 15.10.2021 ( TASK 39046
	Если Не ДоступноПраво_КонтейнернойГруппы И ЗначениеЗаполнено(МЗ.Инвентаризация) Тогда
		ЗапретитьРедактированиеСЗаполненнойИнвентаризацией = Истина;
	Иначе
		ЗапретитьРедактированиеСЗаполненнойИнвентаризацией = Ложь;
	КонецЕсли;	
	
	ОбязательныеПоля = Новый СписокЗначений;
	ОбязательныеПоля.Добавить("тек_ДатаПриемаВПользование", "Дата приема в пользование");
	ОбязательныеПоля.Добавить("тек_СрокВозврата", "Срок возврата");
	ОбязательныеПоля.Добавить("тек_ВидСобственности", "Вид собственности");
	ОбязательныеПоля.Добавить("тек_Собственник", "Собственник");
	ОбязательныеПоля.Добавить("комм_Ставка", "Ставка");
	ОбязательныеПоля.Добавить("комм_Валюта", "Валюта");
	ОбязательныеПоля.Добавить("тек_ПунктыОкончСдачи", "Пункты оконч. сдачи");
	//Евросиб Каблов 15.10.2021 ) 
	
	//Евросиб(ДИТ), Беляев СЮ, BUG 95529 / TA 95530, 18-11-2024, начало
	тек_ДатаСдачиВСток_ДО = МЗ.тек_ДатаСдачиВСток;
	//Евросиб(ДИТ), Беляев СЮ, BUG 95529 / TA 95530, 18-11-2024, конец
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0400614, 29-05-2025, начало
	тек_Релиз_ДО = МЗ.тек_Релиз;
	//Евросиб(ДИТ), Беляев СЮ, Ticket#0400614, 29-05-2025, конец
	
	Для каждого Поле из НаборИзмененныхПолей Цикл
		
		ОтказатьсяОтИзменения = Ложь;
		Для каждого Стр8 из СписокПолейКоторыеЗапрещеноМенятьИзЗаявкиИАСУТК Цикл
			Если Поле.Ключ = Стр8 И (СтрНайти(ИсточникЗаписи, "АСУТК") > 0 ИЛИ 
				//Евросиб Коханенко Н.А. #63323 02.02.2023 (( 
				//СтрНайти(ИсточникЗаписи, "Заявка") > 0
				ТипИсточникаЗаписи = Тип("ДокументСсылка.Заявка")
				//Евросиб Коханенко Н.А. #63323 02.02.2023 )) 
				) Тогда ОтказатьсяОтИзменения = Истина; КонецЕсли;
		КонецЦикла;
		//Евросиб Каблов 15.10.2021 ( TASK 39046
		Если Не ОтказатьсяОтИзменения И ЗапретитьРедактированиеСЗаполненнойИнвентаризацией И СписокПолейКоторыеЗапрещеноМенятьИзЗаявкиИАСУТК.Найти(Поле.Ключ) <> Неопределено Тогда
			ОтказатьсяОтИзменения = Истина;
		КонецЕсли;		
		//Евросиб Каблов 15.10.2021 )
		Если ОтказатьсяОтИзменения Тогда Продолжить; КонецЕсли;
		
		Если Поле.Ключ = "тек_Сток" И ЗначениеЗаполнено(МЗ[Поле.Ключ]) И НЕ ЗначениеЗаполнено(Поле.Значение) И НЕ ЗначениеЗаполнено(МЗ.тек_СтокВзятия) И НЕ ЗначениеЗаполнено(МЗ.тек_ГородВзятия) Тогда 
			МЗ.тек_СтокВзятия = МЗ.тек_Сток;
						
			// Евросиб Фролов (06.04.2022 Task №46925
			//МЗ.тек_ГородВзятия = МЗ.тек_Сток.Родитель; было
			РеквизитыСтокаВзятия = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(МЗ.тек_СтокВзятия, "Родитель, Родитель.Тип");
			Город = РеквизитыСтокаВзятия.Родитель;
			ТипГорода = РеквизитыСтокаВзятия.РодительТип;
			//Евросиб - АСуслов 05.05.2023 11:36:30 #67492
			//(
			//Если ТипГорода <> Справочники.ТипыЛокаций.Субъект
			Если ТипГорода <> Справочники.ТипыЛокаций.НаселенныйПункт
			//)
			//Евросиб - АСуслов 05.05.2023 11:36:36 #67492
				И ЗначениеЗаполнено(Город) Тогда
				Город = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Город, "Родитель");
			КонецЕсли;
			МЗ.тек_ГородВзятия = Город;
			// Евросиб Фролов)
		КонецЕсли;
		Если Поле.Ключ = "тек_ДатаПриемаВСток" ИЛИ Поле.Ключ = "тек_ДатаВзятияИзСтока" ИЛИ Поле.Ключ = "тек_ДатаПриемаВПользование" ИЛИ Поле.Ключ = "тек_ДатаСдачиВСток" Тогда
			Если Поле.Значение > ТекущаяДата() Тогда Продолжить; КонецЕсли;
		КонецЕсли;
		
		Если Поле.Ключ = "тек_ДатаВзятияИзСтока" И ЗначениеЗаполнено(Поле.Значение) И НЕ ЗначениеЗаполнено(МЗ.тек_ДатаПриемаВПользование) Тогда
			ПредполагаемаяДатаПриемаВПользование = Поле.Значение;
		КонецЕсли;
		
		Если Поле.Ключ = "тек_ДатаПриемаВПользование" И НЕ ЗначениеЗаполнено(МЗ[Поле.Ключ]) И ЗначениеЗаполнено(Поле.Значение) Тогда
			МЗ.тек_ВЭксплуатации = Истина;
		КонецЕсли;
		
		//Евросиб - АСуслов 12.10.2021 16:52:09 #40131
		//(
		Если Поле.Ключ = "тек_ДатаПриемаВПользование" 
			И ЗначениеЗаполнено(МЗ[Поле.Ключ]) 
			И ЗначениеЗаполнено(Поле.Значение) 
			И МЗ[Поле.Ключ] <> Поле.Значение 
			И НЕ ДоступноПраво_арм_ктк_РазрешитьИзменениеДатыПриемаИВозврата Тогда
		//)
		//Евросиб - АСуслов 12.10.2021 16:52:10 #40131
			
			Сообщить("Нельзя изменить дату приема в пользование для КТК " + МЗ.КТК + " . Изменения вносятся только в карточку КТК.");
			Возврат;
			
		КонецЕсли;

		
		//Евросиб - АСуслов 16.09.2021 12:04:48 #39008
		//(
		//отключаем только в режиме сдачи ктк
		//Если Поле.Ключ = "тек_ДатаСдачиВСток" И НЕ ЗначениеЗаполнено(МЗ[Поле.Ключ]) И ЗначениеЗаполнено(Поле.Значение) Тогда
		//	МЗ.тек_ВЭксплуатации = Ложь;
		//КонецЕсли;
		//)
		//Евросиб - АСуслов 16.09.2021 12:04:50 #39008
		
		Если Поле.Ключ = "тек_НазначенныйРейс" И МЗ[Поле.Ключ] <> Поле.Значение Тогда
			МЗ.тек_СрокАктуальностиРейса = ТекущаяДата() + 14*24*3600;
		КонецЕсли;
		
		//Евросиб Каблов 16.08.2022 ( US41519
		//Если Поле.Ключ = "тек_Собственник" И НЕ ДоступноПраво_ИзменениеСобственника Тогда
		Если Поле.Ключ = "тек_Собственник" И НЕ ДоступноПраво_ИзменениеСобственника И Не КлиентскийКТКизЗаявки Тогда
		//Евросиб Каблов 16.08.2022 )
			Сообщить("Нет права изменения собственника. Заблокировано.");
			Продолжить;
		КонецЕсли;
		
		//Евросиб - АСуслов 12.10.2021 10:53:44 #0244522 40601
		//(
		Если Поле.Ключ = "тек_ВЭксплуатации" И НЕ ДоступноПраво_ИзменениеВЭксплуатации 
			И НЕ ДоступноПраво_арм_ктк_РазрешитьИзменениеДатыПриемаИВозврата Тогда  // Евросиб Фролов (08.11.2021 TASK №41220
			Сообщить("Нет права изменения признака «в эксплуатации». Заблокировано.");
			Продолжить;
		КонецЕсли;
		//)
		//Евросиб - АСуслов 12.10.2021 10:54:08 #0244522 40601
		
		Если (Поле.Ключ = "тек_СВВ" ИЛИ Поле.Ключ = "тек_НомерТДТ" ИЛИ Поле.Ключ = "тек_КомментарийСВВ" ИЛИ Поле.Ключ = "тек_СправкаЦФТО" ИЛИ Поле.Ключ = "тек_РешениеТО") И НЕ ДоступноПраво_ИзменениеСВВ Тогда
			Сообщить("Нет права изменения СВВ. Заблокировано.");
			Продолжить;
		КонецЕсли;
		
		//Евросиб Каблов 15.10.2021 ( TASK 39046
		Если Не ДоступноПраво_КонтейнернойГруппы Тогда 
			ОбязательноеПоле = ОбязательныеПоля.НайтиПоЗначению(Поле.Ключ);
			Если ОбязательноеПоле <> Неопределено Тогда
				Если Не (ОбязательноеПоле.Значение = "тек_ДатаПриемаВПользование" И ДоступноПраво_арм_ктк_РазрешитьИзменениеДатыПриемаИВозврата) 
					И Не (ОбязательноеПоле.Значение = "тек_ВидСобственности" И КлиентскийКТКизЗаявки) Тогда
					// ДИТ #0298336 Евсенкин М.А. Начало: 08.02.2023
					// Было:
					//ТекстСообщения = СтрШаблон("Нет права изменения поля ""%1"". Заблокировано.", ОбязательноеПоле.Представление);
					//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					// ДИТ #0298336 Евсенкин М.А. Конец: 08.02.2023
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;		
		//Евросиб Каблов 15.10.2021 )
		
		МЗ[Поле.Ключ] = Поле.Значение;
	КонецЦикла;
	
	// Евросиб Фролов (24.11.2021 Ticket№ 0248986
	// Беккер: при заполнении поля "Взятие из стока" отключить автоматическое проставление
	// этой же даты в поле "Прием в пользование" если оно не заполнено.
	// Закомментировал
	//Если НЕ ЗначениеЗаполнено(МЗ.тек_ДатаПриемаВПользование) И ПредполагаемаяДатаПриемаВПользование <> неопределено Тогда 		
	//	МЗ.тек_ДатаПриемаВПользование = ПредполагаемаяДатаПриемаВПользование;
	//	МЗ.тек_ВЭксплуатации = Истина;		
	//КонецЕсли;
	// Евросиб Фролов)
	
	// Проверка заполненности строки записи
	МассивПроверяемыхПолей = Новый Массив;
	МассивПроверяемыхПолей.Добавить("тек_ДатаПриемаВПользование");
	МассивПроверяемыхПолей.Добавить("тек_СледНазначения");
	МассивПроверяемыхПолей.Добавить("след_СледующаяЛокация");
