Процедура ИзменитьПериодСтроки(КТК, Период) Экспорт
	// Найдем строку с периодом переданным периодом записи и если она есть - сдвинем ее на 1 сек.
	
	Запись = РегистрыСведений.стоки_ТекущиеДанные.СоздатьМенеджерЗаписи();
	Запись.Период = Период;
	Запись.КТК = КТК;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		Период = Период + 1;
	КонецЕсли;
	
КонецПроцедуры
