//Евросиб(ДИТ), Беляев СЮ, US 93500 / TA 93958, 14-11-2024, начало
// Функция - Получить текущие данные по контейнерам
//
// Параметры:
//  КТК			 - 	Контейнеры - Можно передавать Контейнер или массив Контейнеров
//  ИменаПолей	 - 	Строка - Список имен запрашиваемых полей через запятую
//  Период	 - 	Дата - Дата среза регистра, если не указано, то будет установлена ТекущаяДата()
// 
// Возвращаемое значение:
// Соответствие  - КТК и Структура с данными по запрашиваемым полям
//
Функция ПолучитьТекущиеДанныеПоКонтейнерам(КТК, ИменаПолей, Период = Неопределено) Экспорт
	Результат = Новый Соответствие();
	
	Если Период = Неопределено Тогда
		Период = ТекущаяДата();
	КонецЕсли;
	
	//КТК
	МассивКТК = Новый Массив;
	Если ТипЗнч(КТК) = Тип("Массив") Тогда
		Для Каждого ЭлементМассива Из КТК Цикл
			Если ТипЗнч(ЭлементМассива) = Тип("Структура") Тогда
				МассивКТК.Добавить(ЭлементМассива.КТК);
			Иначе
				МассивКТК.Добавить(ЭлементМассива);
			КонецЕсли;
		КонецЦикла;
	Иначе
		МассивКТК.Добавить(КТК);
	КонецЕсли;
	
	//Имена полей
	МассивИмеПолей = СтрРазделить(ИменаПолей, ",");
	ТекстЗапросаПолей = "";
	СтруктураЗначенийПолей = Новый Структура;
	
	Для Каждого ИмяПоля Из МассивИмеПолей Цикл
		ТекстЗапросаПолей = 
			ТекстЗапросаПолей + ?(ПустаяСтрока(ТекстЗапросаПолей), "", ",") + "
			|	" + ИмяПоля + " КАК " + ИмяПоля;
		СтруктураЗначенийПолей.Вставить(ИмяПоля);
	КонецЦикла;
	
	//Запрос
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	стоки_ТекущиеДанныеСрезПоследних.КТК КАК КТК,
	               |	&ТекстЗапросаПолей
	               |ИЗ
	               |	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних(&Период, КТК В (&МассивКТК)) КАК стоки_ТекущиеДанныеСрезПоследних";
	
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаПолей", ТекстЗапросаПолей);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("МассивКТК", МассивКТК);  
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(СтруктураЗначенийПолей, ВыборкаДетальныеЗаписи);
		Результат.Вставить(ВыборкаДетальныеЗаписи.КТК, СтруктураЗначенийПолей);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции
//Евросиб(ДИТ), Беляев СЮ, US 93500 / TA 93958, 14-11-2024, конец