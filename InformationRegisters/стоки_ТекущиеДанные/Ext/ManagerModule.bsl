Функция ПолучитьТекущиеПериодыПоКонтейнерам( ВходящиеЗначения, ИмяПоля, Период = Неопределено, Релиз = Неопределено) Экспорт
	Результат = Новый Соответствие();
	
	Если Период = Неопределено Тогда
		Период = ТекущаяДата();
	КонецЕсли;
	
	МассивКТК = Новый Массив;
	Если ТипЗнч(ВходящиеЗначения) = Тип("Массив") Тогда
		Для Каждого ЭлементМассива Из ВходящиеЗначения Цикл
			Если ТипЗнч(ЭлементМассива) = Тип("Структура") Тогда
				МассивКТК.Добавить(ЭлементМассива.КТК);
			Иначе
				МассивКТК.Добавить(ЭлементМассива);
			КонецЕсли;
		КонецЦикла;
	Иначе
		МассивКТК.Добавить(ВходящиеЗначения);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	стоки_ТекущиеДанныеСрезПоследних.КТК КАК КТК,
	               |	стоки_ТекущиеДанныеСрезПоследних.тек_ДатаСдачиВСток КАК Дата
	               |ИЗ   
				   // Евросиб(ДИТ) US 85642 ТА 86102 Сержантова А.С. Начало: 14.06.2024
				   // Было:
				   //|	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних(&Период, КТК В (&МассивКТК)) КАК стоки_ТекущиеДанныеСрезПоследних"; 
				   //Стало:
				   |	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних(&Период, КТК В (&МассивКТК) 
				   |				И тек_Релиз = &Релиз) КАК стоки_ТекущиеДанныеСрезПоследних";
				   // Евросиб(ДИТ) US 85642 ТА 86102 Сержантова А.С. Конец: 14.06.2024
	
    Запрос.Текст = СтрЗаменить(ТекстЗапроса, "тек_ДатаСдачиВСток", ИмяПоля);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("МассивКТК", МассивКТК);  
	// Евросиб(ДИТ) US 85642 ТА 86102 Сержантова А.С. Начало: 14.06.2024
	Если Релиз <> Неопределено Тогда
		Запрос.УстановитьПараметр("Релиз", Релиз);
	Иначе	
	    Запрос.Текст = СтрЗаменить(Запрос.Текст, "И тек_Релиз = &Релиз", "");
	КонецЕсли;
	// Евросиб(ДИТ) US 85642 ТА 86102 Сержантова А.С. Конец: 14.06.2024
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Результат.Вставить(ВыборкаДетальныеЗаписи.КТК, ВыборкаДетальныеЗаписи.Дата);
	КонецЦикла;
	Возврат Результат;
КонецФункции
