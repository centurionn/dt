Процедура ЗаписатьОстатокКТККСдаче(РелизСобственника) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(стоки_ТекущиеДанныеСрезПоследних.КТК) КАК ОстатокКТККВозврату,
	|	стоки_ТекущиеДанныеСрезПоследних.тек_Релиз КАК тек_Релиз
	|ИЗ
	|	РегистрСведений.стоки_ТекущиеДанные.СрезПоследних КАК стоки_ТекущиеДанныеСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РелизСобственника.Номинации КАК РелизСобственникаНоминации
	|		ПО (РелизСобственникаНоминации.Контейнер = стоки_ТекущиеДанныеСрезПоследних.КТК)
	|			И (РелизСобственникаНоминации.Ссылка = стоки_ТекущиеДанныеСрезПоследних.тек_Релиз)
	|			И (РелизСобственникаНоминации.ДатаВзятия <> ДАТАВРЕМЯ(1, 1, 1))
	|			И (РелизСобственникаНоминации.Ссылка = &Релиз)
	|ГДЕ
	|	стоки_ТекущиеДанныеСрезПоследних.тек_ДатаСдачиВСток = ДАТАВРЕМЯ(1, 1, 1)
	|
	|СГРУППИРОВАТЬ ПО
	|	стоки_ТекущиеДанныеСрезПоследних.тек_Релиз";
	
	Запрос.УстановитьПараметр("Релиз", РелизСобственника);
	
	//Евросиб Коханенко Н.А. 14.10.2024 (( #91977 
	//Выборка = Запрос.Выполнить().Выбрать();
	//Пока Выборка.Следующий() Цикл
	//	//Записать в РС ДанныеДляРелизаСобственника 
	//	МенеджерЗаписи = РегистрыСведений.ДанныеПоРелизамСобственника.СоздатьМенеджерЗаписи(); 
	//	МенеджерЗаписи.РелизСобственника = РелизСобственника; 
	//	МенеджерЗаписи.Прочитать();
	//	Если НЕ МенеджерЗаписи.Выбран() Тогда
	//		МенеджерЗаписи.РелизСобственника = РелизСобственника; 
	//	КонецЕсли;
	//	МенеджерЗаписи.ОстатокКТККВозврату = Выборка.ОстатокКТККВозврату;
	//	МенеджерЗаписи.Записать();
	//КонецЦикла;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ОстатокКТККВозврату = 0;
	Иначе 
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ОстатокКТККВозврату = Выборка.ОстатокКТККВозврату;
	КонецЕсли; 
	
	МенеджерЗаписи = РегистрыСведений.ДанныеПоРелизамСобственника.СоздатьМенеджерЗаписи(); 
	МенеджерЗаписи.РелизСобственника = РелизСобственника; 
	МенеджерЗаписи.Прочитать();
	Если НЕ МенеджерЗаписи.Выбран() Тогда
		МенеджерЗаписи.РелизСобственника = РелизСобственника; 
	КонецЕсли;
	МенеджерЗаписи.ОстатокКТККВозврату = ОстатокКТККВозврату;
	МенеджерЗаписи.Записать();
	//Евросиб Коханенко Н.А. 14.10.2024 )) #91977 

