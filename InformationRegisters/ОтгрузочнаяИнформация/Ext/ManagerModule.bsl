//Примечание: Процедура используется в модуле документа РТУ, а так же в одноразовой обработке начального заполнения регистра
//
Процедура СоздатьДвиженияДокументаРеализацияТоваровУслуг(ДокументСсылка, НаборЗаписейДокумента = Неопределено) Экспорт
	
	Если НаборЗаписейДокумента = Неопределено Тогда
		Набор = РегистрыСведений.ОтгрузочнаяИнформация.СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(ДокументСсылка);
	Иначе
		Набор = НаборЗаписейДокумента;
		Набор.Очистить();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДокТЧ.Ссылка КАК Регистратор,
	|	ДокТЧ.Ссылка.ДатаДокумента КАК Период,
	|	ИСТИНА КАК Активность,
	|	ДокТЧ.Контейнер КАК Контейнер,
	|	ДокТЧ.Вагон КАК Вагон,
	|	ДокТЧ.ЖДН КАК ЖДН,
	//Евросиб СубботинВ #84453 02.07.2024 Начало
	//	|	ДокТЧ.Ссылка.Сделка КАК Сделка,
	// Евросиб US 82073 TA 114490 Рыбьяков К.А. 31.07.2025 ((
	|	ДокТЧ.КлючАналитикиСоставаПоезда.Сделка КАК Сделка,
	//|	ДокТЧ.Сделка КАК Сделка,
	// Евросиб Рыбьяков К.А. 31.07.2025 ))
	//Евросиб СубботинВ #84453 02.07.2024 Конец
	|	ДокТЧ.ПунктОтправления КАК ПунктОтправления,
	|	ДокТЧ.ПунктНазначения КАК ПунктНазначения,
	|	ДокТЧ.СтавкаНДС КАК СтавкаНДС,
	|	МАКСИМУМ(ДокТЧ.ФактическийВес) КАК ВесГруза
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.РасшифровкаУслугПоТС КАК ДокТЧ
	|ГДЕ
	|	ДокТЧ.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ДокТЧ.Ссылка,
	|	ДокТЧ.ЖДН,
	|	ДокТЧ.Вагон,
	|	ДокТЧ.Контейнер,
	|	ДокТЧ.ПунктОтправления,
	|	ДокТЧ.ПунктНазначения,
	|	ДокТЧ.СтавкаНДС,
	//Евросиб СубботинВ #84453 02.07.2024 Начало
	//|	ДокТЧ.Ссылка.Сделка,
	// Евросиб US 82073 TA 114490 Рыбьяков К.А. 31.07.2025 ((
	|	ДокТЧ.КлючАналитикиСоставаПоезда.Сделка,
	//|	ДокТЧ.Сделка,
	// Евросиб Рыбьяков К.А. 31.07.2025 ))
	//Евросиб СубботинВ #84453 02.07.2024 Конец
	|	ДокТЧ.Ссылка.ДатаДокумента";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	ТаблицаВыгрузка = Запрос.Выполнить().Выгрузить();
	Набор.Загрузить(ТаблицаВыгрузка);
	
	Набор.Записать();
	
КонецПроцедуры

//++ Зубов US 38288 TA 40761 08.12.2021
Процедура СоздатьДвиженияДокументаКорректировкиРеализации(ДокументСсылка, НаборЗаписейДокумента = Неопределено) Экспорт
	
	Если НаборЗаписейДокумента = Неопределено Тогда
		Набор = РегистрыСведений.ОтгрузочнаяИнформация.СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(ДокументСсылка);
	Иначе
		Набор = НаборЗаписейДокумента;
		Набор.Очистить();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КорректировкаРеализацииРасшифровкаУслугПоТС.Ссылка КАК Регистратор,
	|	КорректировкаРеализацииРасшифровкаУслугПоТС.Ссылка.ДатаДокумента КАК Период,
	|	ИСТИНА КАК Активность,
	|	КорректировкаРеализацииРасшифровкаУслугПоТС.Контейнер КАК Контейнер,
	|	КорректировкаРеализацииРасшифровкаУслугПоТС.Вагон КАК Вагон,
	|	КорректировкаРеализацииРасшифровкаУслугПоТС.ЖДН КАК ЖДН,
	|	КорректировкаРеализацииРасшифровкаУслугПоТС.Ссылка.Сделка КАК Сделка,
	|	КорректировкаРеализацииРасшифровкаУслугПоТС.ПунктОтправления КАК ПунктОтправления,
	|	КорректировкаРеализацииРасшифровкаУслугПоТС.ПунктНазначения КАК ПунктНазначения,
	|	МАКСИМУМ(КорректировкаРеализацииРасшифровкаУслугПоТС.ФактическийВес) КАК ВесГруза,
	|	КорректировкаРеализацииУслуги.СтавкаНДС КАК СтавкаНДС
	|ИЗ
	|	Документ.КорректировкаРеализации.РасшифровкаУслугПоТС КАК КорректировкаРеализацииРасшифровкаУслугПоТС
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации.Услуги КАК КорректировкаРеализацииУслуги
	|		ПО КорректировкаРеализацииРасшифровкаУслугПоТС.Ссылка = КорректировкаРеализацииУслуги.Ссылка
	|			И КорректировкаРеализацииРасшифровкаУслугПоТС.СтрокаДоходовСделки = КорректировкаРеализацииУслуги.СтрокаДоходовСделки
	|ГДЕ
	|	КорректировкаРеализацииРасшифровкаУслугПоТС.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	КорректировкаРеализацииРасшифровкаУслугПоТС.Ссылка,
	|	КорректировкаРеализацииРасшифровкаУслугПоТС.ЖДН,
	|	КорректировкаРеализацииРасшифровкаУслугПоТС.Вагон,
	|	КорректировкаРеализацииРасшифровкаУслугПоТС.Контейнер,
	|	КорректировкаРеализацииРасшифровкаУслугПоТС.ПунктОтправления,
	|	КорректировкаРеализацииРасшифровкаУслугПоТС.ПунктНазначения,
	|	КорректировкаРеализацииРасшифровкаУслугПоТС.Ссылка.Сделка,
	|	КорректировкаРеализацииРасшифровкаУслугПоТС.Ссылка.ДатаДокумента,
	|	КорректировкаРеализацииУслуги.СтавкаНДС";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	ТаблицаВыгрузка = Запрос.Выполнить().Выгрузить();
	Набор.Загрузить(ТаблицаВыгрузка);
	
	Набор.Записать();
	
КонецПроцедуры
//-- Зубов US 38288 TA 40761 08.12.2021
