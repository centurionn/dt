Процедура ДобавитьОбъектДляИсключения( ОбрабатываемыйОбъект, ВремяВМинутах) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ОбрабатываемыйОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВремяВМинутах) Тогда
		Возврат;
	КонецЕсли;
	
	ВремяВСекундах = ВремяВМинутах * 60;
	
	УстановитьПривилегированныйРежим(Истина);//Евросиб Трундуков С.А. 123259 05.11.2025
	МенеджерЗаписи = РегистрыСведений.ВременныеИсключенияОчередиОтложенногоИзменения.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ОбрабатываемыйОбъект = ОбрабатываемыйОбъект;
	МенеджерЗаписи.ДатаЗаписи = ТекущаяДата();
	МенеджерЗаписи.Пользователь = Пользователи.ТекущийПользователь();
	МенеджерЗаписи.ДатаЗавершенияИсключения = МенеджерЗаписи.ДатаЗаписи + ВремяВСекундах;
	МенеджерЗаписи.Записать(Истина);
	УстановитьПривилегированныйРежим(Ложь);//Евросиб Трундуков С.А. 123259 05.11.2025
	
КонецПроцедуры

Процедура УбратьОбъектИзИсключения( ОбрабатываемыйОбъект ) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ОбрабатываемыйОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);//Евросиб Трундуков С.А. 123259 05.11.2025
	МенеджерЗаписи = РегистрыСведений.ВременныеИсключенияОчередиОтложенногоИзменения.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ОбрабатываемыйОбъект = ОбрабатываемыйОбъект;
	МенеджерЗаписи.Прочитать();
	
	Если МенеджерЗаписи.Выбран() Тогда
		МенеджерЗаписи.ДатаЗавершенияИсключения = Неопределено;
		МенеджерЗаписи.Записать(Истина);
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);//Евросиб Трундуков С.А. 123259 05.11.2025
	
КонецПроцедуры

Функция ПолучитьСтатусПоОбъекту( ОбрабатываемыйОбъект ) Экспорт
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВременныеИсключенияОчередиОтложенногоИзменения.ДатаЗавершенияИсключения КАК ДатаЗавершенияИсключения
		|ИЗ
		|	РегистрСведений.ВременныеИсключенияОчередиОтложенногоИзменения КАК ВременныеИсключенияОчередиОтложенногоИзменения
		|ГДЕ
		|	ВременныеИсключенияОчередиОтложенногоИзменения.ОбрабатываемыйОбъект = &ОбрабатываемыйОбъект
		|	И ВременныеИсключенияОчередиОтложенногоИзменения.ДатаЗавершенияИсключения > &ТекущаяДата";
	
	Запрос.УстановитьПараметр("ОбрабатываемыйОбъект", ОбрабатываемыйОбъект);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		Результат = "Акцепт исключен из очереди до " + Формат(ВыборкаДетальныеЗаписи.ДатаЗавершенияИсключения, "ДЛФ=T");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции