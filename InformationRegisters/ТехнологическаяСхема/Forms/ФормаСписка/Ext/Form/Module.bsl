&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзмениласьОперация" Тогда
		ОпНайдена = Ложь;
		Для каждого стр из ТЧ Цикл
			Если стр.Операция = Параметр Тогда ОпНайдена = Истина; Прервать; КонецЕсли;
		КонецЦикла;
		Если ОпНайдена Тогда
			Дерево.ПолучитьЭлементы().Очистить();
			ТЧ.Очистить();
			ПостроитьДеревоПоЭлементу();
			ПерестроитьДеревоПоТЧ();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьТСх(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораКалькуляцииДляКопирования", ЭтаФорма);
	ОткрытьФорму("Документ.Калькуляция.ФормаВыбора",,,ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораКалькуляцииДляКопирования(Параметр1 = неопределено, Параметр2 = неопределено) Экспорт
	
	Если Параметр1 = неопределено Тогда Возврат; КонецЕсли;
	
	ПривязатьТСхКТекущемуОбъекту(Параметр1, ПредметТСх);
	
КонецПроцедуры

&НаСервере
Процедура ПривязатьТСхКТекущемуОбъекту(Параметр1, ПредметТСх)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТехнологическаяСхема.ПредметТСх КАК ПредметТСх,
	               |	ТехнологическаяСхема.Вариант КАК Вариант,
	               |	ТехнологическаяСхема.ТСх КАК ТСх
	               |ИЗ
	               |	РегистрСведений.ТехнологическаяСхема КАК ТехнологическаяСхема
	               |ГДЕ
	               |	ТехнологическаяСхема.ПредметТСх = &ПредметТСх";
	Запрос.УстановитьПараметр("ПредметТСх", Параметр1);
	Ответ = Запрос.Выполнить().Выбрать();
	Пока Ответ.Следующий() Цикл
		
		КопияТСх = ПостроительТСх_сервер.СкопироватьТСх(Ответ.ТСх);
		
		МЗ = РегистрыСведений.ТехнологическаяСхема.СоздатьМенеджерЗаписи();
		МЗ.Вариант = Ответ.Вариант+"_"+Прав(КопияТСх.Код, 7);
		МЗ.ПредметТСх = ПредметТСх;
		МЗ.ТСх = КопияТСх;
		МЗ.Записать(Истина);
		
	КонецЦикла;
	
	Элементы.Вариант.СписокВыбора.Очистить();
	МассивТСх = ПостроительТСх_сервер.ПолучитьТСхОбъекта(ПредметТСх);
	Для каждого Стр из МассивТСх Цикл
		СсылкаТСх = Стр.ТСх;
		Вариант = Стр.Вариант;
		Элементы.Вариант.СписокВыбора.Добавить(Стр.Вариант);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьТСхИзПродукта(Команда)
	
	ОпОп = Новый ОписаниеОповещения("ОбработкаВыбораПродуктаДляКопирования", ЭтаФорма);
	//ДИТ Шевченко А.В. US 62360 ТА 72965 26.07.2023
	//ОткрытьФорму("Справочник.Продукты.ФормаВыбора",,,ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ОткрытьФорму("Справочник.СервисыУчетноеНаправление.ФормаВыбора",,,ЭтаФорма.УникальныйИдентификатор,,,ОпОп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	//ДИТ Шевченко А.В. US 62360 ТА 72965 26.07.2023
	
КонецПроцедуры

&НаКлиенте
