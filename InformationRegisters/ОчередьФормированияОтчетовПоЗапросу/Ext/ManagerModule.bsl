//Евросиб(ДИТ), Беляев СЮ, US 84787 / TA 93129, 24-10-2024, начало
Процедура ЗафиксироватьФормированиеОтчета(Токен, НастройкаОтчетаПоЗапросу, СтрокаXML) Экспорт
	
	МенеджерЗаписи = РегистрыСведений.ОчередьФормированияОтчетовПоЗапросу.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Токен = Токен;
	МенеджерЗаписи.НастройкаОтчетаПоЗапросу = НастройкаОтчетаПоЗапросу;
	
	МенеджерЗаписи.Прочитать();
	МенеджерЗаписи.Сформирован = Истина;
	МенеджерЗаписи.ДатаФормирования = ТекущаяДата();

	ВремяХраненияОтчетаВЧасах = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НастройкаОтчетаПоЗапросу, "ВремяХраненияОтчетаВЧасах");
	ВремяХраненияОтчетаВЧасах = ?(ВремяХраненияОтчетаВЧасах = 0, 4, ВремяХраненияОтчетаВЧасах);
	МенеджерЗаписи.ДатаХраненияРезультата = МенеджерЗаписи.ДатаФормирования + ВремяХраненияОтчетаВЧасах * 3600;
	
	МенеджерЗаписи.РезультатФормирования = Новый ХранилищеЗначения(СтрокаXML);
	
	МенеджерЗаписи.Записать();
	
КонецПроцедуры
//Евросиб(ДИТ), Беляев СЮ, US 84787 / TA 93129, 24-10-2024, конец

