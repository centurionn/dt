
Процедура УстановитьДоступностьТаблицыСостояния(Элемент, ИмяЭлементаИсключения, ИмяЭлементаДляРедактирования, РазрешитьРедактированиеСостоянияПТУ) Экспорт 
	 
	Если НЕ (Элемент.Имя = ИмяЭлементаИсключения ИЛИ Элемент.Имя = "ГруппаСостояния") Тогда
		Попытка
			Элемент.ТолькоПросмотр = Истина;
		Исключение
			Элемент.Доступность = Ложь;
		КонецПопытки;
	КонецЕсли;
	 
	ПодчиненныеЭлементы = Неопределено;
	Попытка
		ПодчиненныеЭлементы = Элемент.ПодчиненныеЭлементы;
	Исключение
	КонецПопытки;
	
	Если ЗначениеЗаполнено(ПодчиненныеЭлементы) Тогда 
		Для Каждого ПодчиненныйЭлемент Из ПодчиненныеЭлементы Цикл
			Если ПодчиненныйЭлемент.Имя = ИмяЭлементаДляРедактирования Тогда 
				ПодчиненныйЭлемент.ТолькоПросмотр = НЕ РазрешитьРедактированиеСостоянияПТУ;
			Иначе
				УстановитьДоступностьТаблицыСостояния(ПодчиненныйЭлемент, ИмяЭлементаИсключения, ИмяЭлементаДляРедактирования, РазрешитьРедактированиеСостоянияПТУ);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
 
	КоманднаяПанель = Неопределено;
	Попытка
		КоманднаяПанель = Элемент.КоманднаяПанель;
	Исключение
	КонецПопытки;
	
	Если НЕ КоманднаяПанель = Неопределено Тогда 
		Для Каждого ПодчиненныйЭлемент Из КоманднаяПанель.ПодчиненныеЭлементы Цикл
			УстановитьДоступностьТаблицыСостояния(ПодчиненныйЭлемент, ИмяЭлементаИсключения, ИмяЭлементаДляРедактирования, РазрешитьРедактированиеСостоянияПТУ);
		КонецЦикла;
	КонецЕсли;
 
КонецПроцедуры // ++ ДИТ Сгонник, 21-10-26 №27109
