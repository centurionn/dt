КонецФункции

//ДИТ, Беляев СЮ, BUG 72360 / TA 72948, 31-07-2023, начало
Процедура УдалитьЗаписиПоВыбранномуКТКиРелизу(КТК, РелизКлиентаСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	стоки_КлиентскоеОперирование.Период КАК Период,
		|	стоки_КлиентскоеОперирование.КТК КАК КТК,
		|	стоки_КлиентскоеОперирование.кл_Релиз КАК кл_Релиз
		|ИЗ
		|	РегистрСведений.стоки_КлиентскоеОперирование КАК стоки_КлиентскоеОперирование
		|ГДЕ
		|	стоки_КлиентскоеОперирование.КТК = &КТК
		|	И стоки_КлиентскоеОперирование.кл_Релиз = &кл_Релиз";
	
	Запрос.УстановитьПараметр("кл_Релиз", РелизКлиентаСсылка);
	Запрос.УстановитьПараметр("КТК", КТК);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Запись = РегистрыСведений.стоки_КлиентскоеОперирование.СоздатьМенеджерЗаписи();
		Запись.Период = ВыборкаДетальныеЗаписи.Период;
		Запись.КТК = ВыборкаДетальныеЗаписи.КТК;
		Запись.Удалить();
	КонецЦикла;
	
КонецПроцедуры
