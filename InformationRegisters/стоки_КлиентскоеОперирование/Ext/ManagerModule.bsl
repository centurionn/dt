Функция ПолучитьСрезПоследнихПоКТК(КТК, Период = неопределено) Экспорт
	
	Результат = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	*
	               |ИЗ
	               |	РегистрСведений.стоки_КлиентскоеОперирование.СрезПоследних(&ПериодСреза, КТК = &КТК) КАК стоки_КлиентскоеОперированиеСрезПоследних";
	Запрос.УстановитьПараметр("КТК", КТК);
	Запрос.УстановитьПараметр("ПериодСреза", Период);
	ЗапросВыполнить = Запрос.Выполнить();
	Ответ = ЗапросВыполнить.Выбрать();
	Если Ответ.Следующий() Тогда
		
		Для каждого Колонка из ЗапросВыполнить.Колонки Цикл
			
			Результат.Вставить(Колонка.Имя, Ответ[Колонка.Имя]);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПопытатьсяВписатьДатуОкончанияВЦиклы(КТК, ДатаОкончания) Экспорт
	
	Результат = Ложь;
	
	НЗ = РегистрыСведений.стоки_КлиентскоеОперирование.СоздатьНаборЗаписей();
	НЗ.Отбор.КТК.Установить(КТК);
	НЗ.Прочитать();
	
	НайдДата = Ложь;
	Для каждого Стр из НЗ Цикл
		Если НачалоДня(Стр.кл_ДатаВозврата) = НачалоДня(ДатаОкончания) Тогда
			НайдДата = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если НайдДата = Истина Тогда
		Результат = Истина;
		
	ИначеЕсли НЗ.Количество() = 0 Тогда
		
		ДобавитьЗапись(КТК, Новый Структура("кл_ДатаВозврата", ДатаОкончания), ТекущаяДата(), Ложь, Истина);
		Результат = Истина;
		
	Иначе
				
		НомераОткрытыхЦиклов = Новый Массив;
		Для Сч = 0 По НЗ.Количество()-1 Цикл
			
			Стр87 = НЗ[Сч];
			Если 
				НЕ ЗначениеЗаполнено(Стр87.кл_ДатаВозврата) И 
				(Сч = НЗ.Количество()-1 ИЛИ Стр87.ПорядковыйНомерЦиклаАрендыКТК <> НЗ[Сч+1].ПорядковыйНомерЦиклаАрендыКТК) И 
				Стр87.кл_ДатаВыдачи < ДатаОкончания И 
				НомераОткрытыхЦиклов.Найти(Стр87.ПорядковыйНомерЦиклаАрендыКТК) = неопределено 
			Тогда
				НомераОткрытыхЦиклов.Добавить(Стр87.ПорядковыйНомерЦиклаАрендыКТК);
			КонецЕсли;
			
		КонецЦикла;
		
		//Для Сч = 2 По НЗ.Количество() - 1 Цикл
		//	Если НЗ[Сч].ПорядковыйНомерЦиклаАрендыКТК <> НЗ[Сч-1].ПорядковыйНомерЦиклаАрендыКТК И НЕ ЗначениеЗаполнено(НЗ[Сч-1].кл_ДатаВозврата) И НЗ[Сч-1].кл_ДатаВыдачи < ДатаОкончания Тогда
		//		НомераОткрытыхЦиклов.Добавить(НЗ[Сч-1].ПорядковыйНомерЦиклаАрендыКТК);
		//	КонецЕсли;
		//КонецЦикла;
		
		ПослЗапись = НЗ[НЗ.Количество()-1];
		
		Если НомераОткрытыхЦиклов.Количество() = 0 Тогда
			НомераОткрытыхЦиклов.Добавить(ПослЗапись.ПорядковыйНомерЦиклаАрендыКТК);
		КонецЕсли;
		
		Если НомераОткрытыхЦиклов.Количество() > 1 Тогда
			//ДИТ Шевченко А.В. 65473 07.03.2023 -начало
			//Сообщить("Невозможно определить период клиента, в рамках которого вносится дата возврата! Запись не выполнена!", СтатусСообщения.ОченьВажное);
			//ДИТ Шевченко А.В. 65473 07.03.2023 -конец
		Иначе
			
			ПослСтрокаРабочегоЦикла = неопределено;
			Для каждого Стр из НЗ Цикл
				Если Стр.ПорядковыйНомерЦиклаАрендыКТК = НомераОткрытыхЦиклов[0] Тогда
					ПослСтрокаРабочегоЦикла = Стр;
				КонецЕсли;
			КонецЦикла;
			
			Если ПослСтрокаРабочегоЦикла <> неопределено И НЕ ЗначениеЗаполнено(ПослСтрокаРабочегоЦикла.кл_ДатаВозврата) Тогда
				ПослСтрокаРабочегоЦикла.кл_ДатаВозврата = ДатаОкончания;
				НЗ.Записать(Истина);
				Результат = Истина;
